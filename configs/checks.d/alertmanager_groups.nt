name: alertmanager_groups
fqcn: checkmk.alertmanager_groups
collection: checkmk
short_description: Alertmanager Check
description: Checkmk check 'alertmanager_groups' (service: Alert Rule Group %s), translated to a read-only on-host Starlark check module.
options:
    host:
        type: string
        default: localhost
        description: host (from the check's parameters).
    port:
        type: number
        default: 9090
        description: port (from the check's parameters).
    scheme:
        type: string
        default: http
        description: scheme (from the check's parameters).
    alert_remapping:
        type: string
        description: alert_remapping (from the check's parameters).
    min_amount_rules:
        type: number
        default: 3
        description: min_amount_rules (from the check's parameters).
    no_group_services:
        type: list
        description: no_group_services (from the check's parameters).
writes: False
runtime: starlark
source: translated
kind: check
