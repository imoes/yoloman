        type: string
        default: localhost
        description: host (from the check's parameters).
    port:
        type: number
        default: 9090
        description: port (from the check's parameters).
    alert_remapping:
        type: string
        description: alert_remapping (from the check's parameters).
writes: False
runtime: starlark
source: translated
kind: check
