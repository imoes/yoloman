name: services
fqcn: checkmk.services
collection: checkmk
short_description: Service %s
description: Checkmk check 'services' (service: Service %s), translated to a read-only on-host Starlark check module.
options:
    states:
        type: list
        description: states (from the check's parameters).
    else:
        type: number
        default: 2
        description: else (from the check's parameters).
    additional_servicenames:
        type: list
        description: additional_servicenames (from the check's parameters).
writes: False
runtime: starlark
source: translated
kind: check
