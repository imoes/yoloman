name: dns
fqcn: checkmk.dns
collection: checkmk
short_description: DNS resolution check
description: Resolves a hostname or IP address via DNS and validates the returned records against an optional list of expected answers. Grades CRIT on lookup failure or when expected addresses are absent (all-must-match or any-must-match, configurable), and WARN/CRIT when resolution time exceeds the configured thresholds.
options:
    service_name:
        type: string
        description: Service name shown in monitoring
        required: true
    hostname:
        type: string
        description: Hostname or IP address to resolve
        required: true
    server:
        type: string
        description: DNS server to query (informational — native probe uses the system resolver; specify for documentation or future custom-resolver support)
    rtype:
        type: string
        description: DNS record type to query
        default: A
        enum:
            - A
            - AAAA
            - CNAME
            - MX
            - NS
            - TXT
    expect_all_addresses:
        type: bool
        description: When true all expected_addresses_list entries must appear in the answer; when false at least one must match
        default: true
    expected_addresses_list:
        type: list
        description: Expected DNS answer records; CRIT if the match condition (all/any) is not satisfied
    response_time_warn_s:
        type: number
        description: WARN if resolution time exceeds this threshold (seconds)
    response_time_crit_s:
        type: number
        description: CRIT if resolution time exceeds this threshold (seconds)
    timeout_s:
        type: number
        description: Query timeout in seconds
        default: 10
writes: False
runtime: starlark
source: translated
kind: check
category: Service checks
