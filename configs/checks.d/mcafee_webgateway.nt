name: mcafee_webgateway
fqcn: checkmk.mcafee_webgateway
collection: checkmk
short_description: The McAfee Web Gateway has been rebranded to Skyhigh Secure Web Gateway with its release 12.2.2.
description: Checkmk check 'mcafee_webgateway' (service: Web gateway statistics), translated to a read-only on-host Starlark check module.
options:
    host:
        type: string
        default: localhost
        description: host (from the check's parameters).
    community:
        type: string
        default: public
        description: community (from the check's parameters).
writes: False
runtime: starlark
source: translated
kind: check
