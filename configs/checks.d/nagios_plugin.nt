name: nagios_plugin
short_description: Run any Nagios-compatible plugin / Checkmk local check
description:
  > Generic wrapper for custom checks: runs an existing Nagios plugin (or a
  > Checkmk local check) via its command line and maps the standard result —
  > exit code 0/1/2/3 and the "text | perfdata" stdout — onto the yolo-man
  > verdict (state + metrics). Lets you reuse existing plugins unchanged.
options:
  command:
    type: list
    required: true
    description: The plugin argv, e.g. ["/usr/lib/nagios/plugins/check_load", "-w", "5", "-c", "10"]
writes: false
runtime: starlark
source: custom
kind: check
