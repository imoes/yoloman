name: checkmk_local
short_description: Run a Checkmk local check script (multi-service)
description:
  > Generic wrapper for custom checks in Checkmk local-check format: runs a
  > script whose stdout is one line per service ("status item perfdata
  > details"). Discovery yields one item per line; the check evaluates one
  > item. Lets you reuse existing Checkmk local checks unchanged.
options:
  command:
    type: list
    required: true
    description: The local-check script argv, e.g. ["/usr/lib/check_mk_agent/local/my_check.sh"]
  item:
    type: str
    description: Which discovered service line to evaluate (empty for single-line scripts)
writes: false
runtime: starlark
source: custom
kind: check
