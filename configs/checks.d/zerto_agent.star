    res = ctx.run(["systemctl", "is-active", "zerto"], mutates=False)
    if res.rc != 0:
        # Service not active or not found — this might be an error, but we need to check logs.
        # Since the check expects error details from "Error:" lines, and we don't have them,
        # we'll fall back to UNKNOWN.
