            "msg": "Zerto Agent Status: service not found or inactive",
            "data": {
                "state": "UNKNOWN",
                "metrics": {},
                "details": "Could not determine Zerto agent status"
            }
        }
    
    # Service is active — assume no error.
    return {
        "changed": False,
        "msg": "Agent started without problem",
        "data": {
