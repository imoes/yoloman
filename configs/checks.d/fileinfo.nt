name: fileinfo
fqcn: checkmk.fileinfo
collection: checkmk
category: Storage
short_description: File age and size
description: Monitor a single file's age (mtime) and size on the host, with optional thresholds — read-only on-host Starlark check.
options:
    service_name:
        type: string
        required: true
        description: Name of the resulting service (e.g. "syslog freshness").
    path:
        type: string
        required: true
        description: Absolute path of the file to monitor.
    max_age:
        type: number
        description: WARN when the file's mtime is older than this many seconds.
    max_age_crit:
        type: number
        description: CRIT when the file's mtime is older than this many seconds.
    min_size:
        type: number
        description: WARN when the file is smaller than this many bytes.
    max_size:
        type: number
        description: WARN when the file is larger than this many bytes.
    state_missing:
        type: string
        default: CRIT
        enum:
            - OK
            - WARN
            - CRIT
            - UNKNOWN
        description: Service state to report when the file is missing.
writes: False
runtime: starlark
source: translated
kind: check
