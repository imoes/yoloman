name: apache_status
fqcn: checkmk.apache_status
collection: checkmk
short_description: Apache %s Status
description: Checkmk check 'apache_status' (service: Apache %s Status), translated to a read-only on-host Starlark check module.
options:
    host:
        type: string
        default: localhost
        description: host (from the check's parameters).
    port:
        type: number
        default: 80
        description: port (from the check's parameters).
    path:
        type: string
        default: /server-status
        description: path (from the check's parameters).
    use_ssl:
        type: bool
        default: False
        description: use_ssl (from the check's parameters).
    user:
        type: string
        description: user (from the check's parameters).
    password:
        type: string
        description: password (from the check's parameters).
writes: False
runtime: starlark
source: translated
kind: check
