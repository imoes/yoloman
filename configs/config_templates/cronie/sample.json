{
  "cron_jobs": [
    {
      "minute": "0",
      "hour": "2",
      "day": "*",
      "month": "*",
      "dow": "*",
      "user": "root",
      "command": "/usr/bin/run-parts /etc/cron.daily"
    },
    {
      "minute": "0",
      "hour": "*",
      "day": "*",
      "month": "*",
      "dow": "*",
      "user": "root",
      "command": "/usr/bin/systemctl reload rsyslog 2>/dev/null || true"
    },
    {
      "minute": "30",
      "hour": "3",
      "day": "*",
      "month": "*",
      "dow": "0",
      "user": "backup",
      "command": "/usr/local/bin/backup.sh --full"
    }
  ]
}
