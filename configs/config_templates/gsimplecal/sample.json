{
  "show_calendar": true,
  "show_timezones": true,
  "mark_today": true,
  "show_week_numbers": false,
  "close_on_unfocus": false,
  "close_on_mouseleave": false,
  "external_viewer": "sunbird -showdate \"%Y-%m-%d\"",
  "clock_format": "%a %d %b %H:%M",
  "force_lang": "en_US.utf8",
  "mainwindow_decorated": false,
  "mainwindow_keep_above": true,
  "mainwindow_sticky": false,
  "mainwindow_skip_taskbar": true,
  "mainwindow_resizable": false,
  "mainwindow_position": "none",
  "mainwindow_xoffset": 0,
  "mainwindow_yoffset": 0,
  "clocks": [
    {
      "label": "UTC",
      "tz": ":UTC"
    },
    {
      "label": "Local",
      "tz": ""
    },
    {
      "label": "BST",
      "tz": ":Europe/London"
    },
    {
      "label": "EDT",
      "tz": ":US/Eastern"
    },
    {
      "label": "CDT",
      "tz": ":US/Central"
    }
  ]
}
