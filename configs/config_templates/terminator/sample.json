{
  "dbus_enabled": true,
  "debug": 0,
  "debug_classes": "",
  "debug_methods": "",
  "config_path": "~/.config/terminator/config",
  "default_profile": "default",
  "window_title": "Terminator",
  "icon_name": "utilities-terminal",
  "layouts_dir": "~/.local/share/terminator/layouts",
  "keybindings": {
    "split_h": "Ctrl+Shift+O",
    "split_v": "Ctrl+Shift+E",
    "new_tab": "Ctrl+Shift+T",
    "new_window": "Ctrl+Shift+I",
    "close_terminal": "Ctrl+Shift+W",
    "close_window": "Ctrl+Shift+Q",
    "next_terminal": "Ctrl+Shift+N",
    "previous_terminal": "Ctrl+Shift+P",
    "next_tab": "Ctrl+PageDown",
    "prev_tab": "Ctrl+PageUp",
    "broadcast_all": "Alt+A",
    "broadcast_group": "Alt+G",
    "broadcast_off": "Alt+O",
    "zoom": "Ctrl+Shift+Z",
    "maximize": "Ctrl+Shift+X",
    "fullscreen": "F11",
    "hide_window": "Ctrl+Shift+Alt+A",
    "copy_text": "Ctrl+Shift+C",
    "paste_text": "Ctrl+Shift+V",
    "search": "Ctrl+Shift+F",
    "reset": "Ctrl+Shift+R",
    "clear": "Ctrl+Shift+G",
    "increase_font": "Ctrl+Plus",
    "decrease_font": "Ctrl+Minus",
    "reset_font": "Ctrl+Zero"
  },
  "profiles": [
    {
      "name": "default",
      "color_scheme": "Tango Dark",
      "background_type": "transparent",
      "background_image": "",
      "background_darkness": "0.95",
      "cursor_font": "Monospace 12",
      "bold_is_bright": true,
      "cmd": "system-default",
      "working_dir": "current",
      "show_titlebar": true,
      "show_scrollbar": false,
      "cursor_shape": "block",
      "copy_text": "Ctrl+Shift+C",
      "paste_text": "Ctrl+Shift+V"
    },
    {
      "name": "light",
      "color_scheme": "Tango Light",
      "background_type": "solid",
      "background_image": "",
      "background_darkness": "1.0",
      "cursor_font": "Monospace 10",
      "bold_is_bright": false,
      "cmd": "system-default",
      "working_dir": "current",
      "show_titlebar": true,
      "show_scrollbar": true,
      "cursor_shape": "ibeam",
      "copy_text": "Ctrl+Shift+C",
      "paste_text": "Ctrl+Shift+V"
    }
  ],
  "layouts": {
    "2_cols": {
      "content": "[root]\n  type: Window\n  parent: \"\"\n  [child1]\n    type: Terminal\n    parent: root\n    [child2]\n      type: Terminal\n      parent: root"
    },
    "tabs": {
      "content": "[root]\n  type: Window\n  parent: \"\"\n  [child1]\n    type: Terminal\n    parent: root\n    [child2]\n      type: Terminal\n      parent: root"
    }
  }
}
