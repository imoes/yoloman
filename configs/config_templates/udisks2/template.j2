# /etc/udisks2/udisks2.conf — UDisks2 D-Bus disk management service

[udisks2]
# Comma-separated list of udisks2 add-on modules to activate (e.g. lvm2, btrfs, iscsi); empty = none loaded
modules={% if modules %}{{ modules | join(',') }}{% endif %}

# When to initialise modules: ondemand (on first use) or onstartup (at service launch)
modules_load_preference={{ modules_load_preference }}

[defaults]
# Default encryption format for new LUKS volumes: luks1 (legacy) or luks2 (recommended, stronger)
encryption={{ encryption }}
