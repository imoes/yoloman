# ==============================================================================
# Ganesha NFS Server Configuration Template
# ==============================================================================
# This template generates the primary configuration file for NFS-Ganesha.
# It is self-documenting: every directive is preceded by a comment explaining
# its purpose, sourced from the schema description.
#
# Global Settings
# ==============================================================================

# Verbosity level of logs. Valid values: NONE, MAJ, MIN, EVENT, DEBUG, TRACE
Log_Level = {{ log_level | default('EVENT') }}

# List of NFS protocol versions to enable (e.g., 3, 4, 4.1, 4.2)
Protocols = {{ protocols | default(['4']) | join(', ') }}

# List of network transport protocols (e.g., 'tcp', 'udp', 'rdma')
Transports = {{ transports | default(['tcp']) | join(', ') }}

# Duration (seconds) for the NFSv4 grace period after restart
Grace_Period = {{ grace_period | default(90) }}

# Enable file locking via BSD/POSIX locks (required for NFSv4 locking)
Enable_Locking = {{ enable_locking | default(true) | lower }}

# Enable RPC security (GSSAPI/Kerberos) for authenticated access
Enable_GSS = {{ enable_gss | default(false) | lower }}

# ==============================================================================
# Default Export Settings
# ==============================================================================
# These settings apply to all exports unless overridden per-export below.

[EXPORT_DEFAULT]

# Default settings applied to all exports (override per-export if needed)
# Path: Filesystem access path (exported root)
Path = {{ (export_default | default({'path': '/exports', 'clients': ['*'], 'pseudo': '/export', 'access_async': True, 'squash': 'root', 'fsal_flags': []})).path | default('/exports') }}

# Clients: comma-separated hosts/subnets or 'rw', 'ro' permissions.
# Use * for all clients (not recommended for production).
Clients = {{ (export_default | default({'path': '/exports', 'clients': ['*'], 'pseudo': '/export', 'access_async': True, 'squash': 'root', 'fsal_flags': []})).clients | default(['*']) | join(', ') }}

# Enable pseudo-RPNS (virtual namespace)
Pseudo = {{ (export_default | default({'path': '/exports', 'clients': ['*'], 'pseudo': '/export', 'access_async': True, 'squash': 'root', 'fsal_flags': []})).pseudo | default('/export') }}

# Enable asynchronous operations
Access_Async = {{ (export_default | default({'path': '/exports', 'clients': ['*'], 'pseudo': '/export', 'access_async': True, 'squash': 'root', 'fsal_flags': []})).access_async | default(true) | lower }}

# Squash UIDs/GIDs (none, root, all)
Squash = {{ (export_default | default({'path': '/exports', 'clients': ['*'], 'pseudo': '/export', 'access_async': True, 'squash': 'root', 'fsal_flags': []})).squash | default('root') }}

# Filesystem export flags (e.g., No_Sync, No_Atomic_Write)
FSAL_Flag = {{ (export_default | default({'path': '/exports', 'clients': ['*'], 'pseudo': '/export', 'access_async': True, 'squash': 'root', 'fsal_flags': []})).fsal_flags | default([]) | join(', ') }}

# Optional: export name override (used in RPC and client-visible paths).
# If not set, defaults to export_id.
# Name = {{ (export_default | default({'path': '/exports', 'clients': ['*'], 'pseudo': '/export', 'access_async': True, 'squash': 'root', 'fsal_flags': []})).name | default('') }}

# ==============================================================================
# Individual Export Definitions
# ==============================================================================
# List of exports to configure (minimum 1 required).
# Each export gets its own [EXPORT<id>] section and a nested [EXPORT<id>/FSAL] section.

{% for export in exports | default([]) %}

[EXPORT{{ export.export_id }}]
# Export #{{ export.export_id }}: {{ export.description | default('User-defined export') }}

# Filesystem access path for this specific export
Path = {{ export.path | default('/') }}

# Clients allowed to mount this export
Clients = {{ export.clients | default(['*']) | join(', ') }}

# Override export defaults (optional fields)
{% if export.pseudo is defined %}
# Override pseudo-RPNS path
Pseudo = {{ export.pseudo | default('/') }}
{% endif %}

{% if export.squash is defined %}
# Override squash settings for this export
Squash = {{ export.squash | default('root') }}
{% endif %}

{% if export.fsal_flags is defined %}
# Override filesystem export flags for this export
FSAL_Flag = {{ export.fsal_flags | default([]) | join(', ') }}
{% endif %}

{% if export.access_async is defined %}
# Override asynchronous operations setting
Access_Async = {{ export.access_async | default(true) | lower }}
{% endif %}

[EXPORT{{ export.export_id }}/FSAL]
# Filesystem Abstraction Layer configuration for export #{{ export.export_id }}

# Name of the FSAL module (e.g., VFS, CEPH, LUSTRE)
Name = {{ export.fsal.name | default('VFS') }}

{% if export.fsal.name | default('VFS') == 'VFS' %}
# --- VFS FSAL Specific Options ---

# Filesystem identifier (e.g., device or mount point ID)
{% if export.fsal.fs_id is defined %}
Filesystem = {{ export.fsal.fs_id | default('') }}
{% endif %}

# Root inode ID for the export
{% if export.fsal.root_id is defined %}
Root_Id = {{ export.fsal.root_id | default('') }}
{% endif %}

# Extended attribute name for NFSv4 ACLs
{% if export.fsal.xattr_name is defined %}
Xattr_Name = {{ export.fsal.xattr_name | default('') }}
{% endif %}

{% elif export.fsal.name | default('VFS') == 'CEPH' %}
# --- Ceph FSAL Specific Options ---

# Path to Ceph configuration file
Ceph_Conf = {{ export.fsal.ceph_conf | default('/etc/ceph/ceph.conf') }}

# Ceph user ID for authentication
User_Id = {{ export.fsal.user_id | default('') }}

# Ceph cluster name
{% if export.fsal.cluster is defined %}
Cluster = {{ export.fsal.cluster | default('') }}
{% endif %}

{% elif export.fsal.name | default('VFS') == 'LUSTRE' %}
# --- Lustre FSAL Specific Options ---

# Lustre LNet LPID (Local Partition ID)
Lustre_LNet_LPID = {{ export.fsal.lnet_lpid | default('') }}

{% endif %}

{% endfor %}