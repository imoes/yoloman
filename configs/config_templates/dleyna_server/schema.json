{
  "log_level": {
    "type": "number",
    "default": {
      "0": "none",
      "1": "error",
      "2": "warning",
      "3": "info",
      "4": "debug"
    }
  },
  "max_requests_per_client": {
    "type": "integer",
    "default": {
      "max": 10
    }
  },
  "interface": {
    "type": "string",
    "default": {
      "any": "All interfaces"
    }
  },
  "allowed_devices": {
    "type": "array",
    "default": {}
  },
  "denied_devices": {
    "type": "array",
    "default": {}
  },
  "max_scan_depth": {
    "type": "integer",
    "default": {
      "0": "unlimited"
    }
  },
  "discovery_timeout": {
    "type": "integer",
    "default": {
      "seconds": 10
    }
  },
  "auto_refresh_enabled": {
    "type": "boolean",
    "default": {
      "enabled": true
    }
  },
  "auto_refresh_interval": {
    "type": "integer",
    "default": {
      "seconds": 1800
    }
  },
  "verbose_journal": {
    "type": "boolean",
    "default": {
      "enabled": false
    }
  }
}
