{
 "allowed_devices": {
  "type": "array"
 },
 "auto_refresh_enabled": {
  "default": {
   "enabled": true
  },
  "type": "boolean"
 },
 "auto_refresh_interval": {
  "default": {
   "seconds": 1800
  },
  "type": "integer"
 },
 "denied_devices": {
  "type": "array"
 },
 "discovery_timeout": {
  "default": {
   "seconds": 10
  },
  "type": "integer"
 },
 "interface": {
  "default": {
   "any": "All interfaces"
  },
  "type": "string"
 },
 "log_level": {
  "default": {
   "0": "none",
   "1": "error",
   "2": "warning",
   "3": "info",
   "4": "debug"
  },
  "type": "number"
 },
 "max_requests_per_client": {
  "default": {
   "max": 10
  },
  "type": "integer"
 },
 "max_scan_depth": {
  "default": {
   "0": "unlimited"
  },
  "type": "integer"
 },
 "verbose_journal": {
  "default": {
   "enabled": false
  },
  "type": "boolean"
 }
}
