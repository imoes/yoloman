#
# Regular cron jobs for the iog package
# Self-documented: uses cron_schedule and cron_user variables.
#
# cron_schedule: Cron schedule for the iog job
#   Defines the timing for the iog execution.
#   Default: '0 *  * * *' (every hour)
{{ cron_schedule | default('0 *  * * *') }}	{{ cron_user | default('www-data') }}	[ -x /usr/sbin/iog ] && /usr/sbin/iog