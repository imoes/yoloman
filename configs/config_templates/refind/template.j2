# rEFInd Boot Manager Configuration Template
# Auto-generated by Ansible. Do not edit manually.
# See: https://www.rodsprojects.com/refind/

# timeout: Seconds to wait before automatically booting the default OS.
# Set to 0 for instant boot, -1 for no timeout.
timeout {{ timeout | default(5) }}

# show_advanced: When true, show advanced boot options like kernel parameters, fallback boot, etc.
show_advanced {{ show_advanced | default(true) | lower }}

# sound: Enable UI sound effects (beeps) for navigation.
sound {{ sound | default(false) | lower }}

# scan_for: List of boot types to scan for.
# Common values: C (UEFI OS installers), H (internal hard disks), S (removable drives),
# U (USB/external), M (memory-based), SH (UEFI Shell).
# Note: If enable_legacy_bios is true, 'H' is added automatically.
# If shell_enabled is true, 'SH' is added automatically.
scan_for {{ scan_for | default(['C', 'H', 'S', 'U']) | map('upper') | join(' ') }}

# ignore_uuids: List of volume UUIDs to ignore during scanning (to prevent booting into
# unwanted OSes).
ignore_uuids {
{% for uuid in ignore_uuids | default([]) %}
    {{ uuid }}
{% endfor %}
}

# theme_path: Path (relative to ESP root or absolute) to a theme directory.
# Leave empty to disable theming.
theme_path "{{ theme_path | default('') }}"

# icons: Icon file formats to load (e.g., icns, png) — usually auto-detected by rEFInd,
# but this can override.
icons {{ icons | default(['icns', 'png']) | map('lower') | join(' ') }}

# hide_entries: List of boot entry names, labels, or UUIDs to hide from the menu.
# Supports wildcards and regex-like substrings.
hide_entries {
{% for entry in hide_entries | default([]) %}
    {{ entry }}
{% endfor %}
}

# default_selection: Boot entry to select by default — specify by label, index (e.g., '2'),
# or UUID. Empty means auto-select first visible.
default_selection "{{ default_selection | default('') }}"

# enable_legacy_bios: Enable legacy BIOS compatibility (for hybrid MBR/UEFI setups).
# If true, adds 'H' to ScanFor.
enable_legacy_bios {{ enable_legacy_bios | default(false) | lower }}

# extra_kernel_options: Additional kernel command-line arguments to append to every Linux
# boot entry (e.g., 'splash', 'quiet', 'acpi=force').
extra_kernel_options {{ extra_kernel_options | default([]) | join(' ') }}

# shell_enabled: Enable scanning for UEFI shell (e.g., Shell.efi) in the ESP root or
# subdirs. Adds 'SH' to ScanFor.
shell_enabled {{ shell_enabled | default(false) | lower }}

# secure_boot: Enable UEFI Secure Boot mode. Requires signed binaries and proper signing keys.
secure_boot {{ secure_boot | default(false) | lower }}

# filesystem_drivers: List of UEFI filesystem driver files (e.g., btrfs_x64.efi, zfs_x64.efi)
# to load for non-NTFS/FAT filesystems.
filesystem_drivers {
{% for driver in filesystem_drivers | default([]) %}
    {{ driver }}
{% endfor %}
}

# font_path: Path (relative or absolute) to a UEFI-compatible font (e.g., DejaVuSansB12.pf2).
# Required for custom UI fonts.
font_path "{{ font_path | default('') }}"

# scan_all: Enable scanning for all boot loaders in all ESP subdirectories (including
# non-standard paths).
scan_all {{ scan_all | default(false) | lower }}

# scan_windows: Enable scanning for Microsoft Windows boot loader (Bootmgfw.efi, etc.).
scan_windows {{ scan_windows | default(true) | lower }}

# refind_public_key_file: Filename (including extension) of rEFInd's public key used in
# sbverify examples and MOK enrollment.
refind_public_key_file "{{ refind_public_key_file | default('refind.crt') }}"