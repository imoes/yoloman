  "screen_resolution": "auto",
  "boot_order": [
    "Linux",
    "Windows"
  ],
  "custom_items": [
    {
      "label": "MemTest86",
      "icon": "themes/icons/memtest.png",
      "options": "fs0:\\EFI\\memtest\\memtest64.efi"
    },
    {
