# Chrony daemon options wrapper configuration
# This file passes runtime options to the chrony daemon service.
# It serves as a bridge between the Ansible role variables and the service startup script.

# DAEMON_OPTS: Additional options passed to the chrony daemon at startup.
# These options are appended to the standard service execution command.
# Default: '-F 1' (Foreground mode with fast startup, often used in containers or specific setups).
DAEMON_OPTS="{{ daemon_opts | default('-F 1') }}"