<!-- Define storage pool metadata -->
<pool type="{{ pool.type }}">
  <!-- Unique identifier for this storage pool -->
  <name>{{ pool.name }}</name>
  <!-- Human-readable description of the pool -->
  <description>{{ pool.description | default('') }}</description>
  <!-- Target path for local filesystem pools (e.g., dir, fs) or device path (e.g., disk, iscsi) -->
  <target>
    <!-- Path where this pool is mounted or accessed -->
    <path>{{ pool.target.path }}</path>
    <!-- Optional permissions for the target directory (only applicable for local filesystem pools) -->
    {% if pool.target.permissions %}
    <permissions>
      <mode>{{ pool.target.permissions.mode | default('0755') }}</mode>
      <owner>{{ pool.target.permissions.owner | default('root') }}</owner>
      <group>{{ pool.target.permissions.group | default('root') }}</group>
      <label>{{ pool.target.permissions.label | default('') }}</label>
    </permissions>
    {% endif %}
    <!-- Optional SELinux relabeling control -->
    {% if pool.target.relabel is defined %}
    <relabel>{{ 'yes' if pool.target.relabel else 'no' }}</relabel>
    {% endif %}
  </target>
  <!-- Source configuration — varies by pool type (e.g., device for disk, host for iSCSI/NFS) -->
  <source>
    {% for host in pool.source.hosts | default([]) %}
    <host name="{{ host.name }}"{% if host.port %} port="{{ host.port }}"{% endif %}/>
    {% endfor %}
    <!-- Device path (for disk, lvm, scsi, etc.) -->
    {% if pool.source.device %}
    <device path="{{ pool.source.device.path }}"/>
    {% endif %}
    <!-- Filesystem label (for fs pool type) -->
    {% if pool.source.fs_label %}
    <format type="{{ pool.source.fs_label.format }}"/>
    {% endif %}
    <!-- Volume group name (for lvm pool) -->
    {% if pool.source.vg_name %}
    <name>{{ pool.source.vg_name }}</name>
    {% endif %}
    <!-- IQN for iSCSI pools -->
    {% if pool.source.iqn %}
    <initiator>
      <iqn name="{{ pool.source.iqn }}"/>
    </initiator>
    {% endif %}
    <!-- Target path for iSCSI/NFS -->
    {% if pool.source.target_path %}
    <dir path="{{ pool.source.target_path }}"/>
    {% endif %}
    <!-- Optional authentication (e.g., for iSCSI, Ceph) -->
    {% if pool.source.auth %}
    <auth type="{{ pool.source.auth.type }}" username="{{ pool.source.auth.username }}">
      <secret uuid="{{ pool.source.auth.secret_uuid }}"/>
    </auth>
    {% endif %}
  </source>
  <!-- Optional pool-specific configuration -->
  {% if pool.options %}
  <options>
    {% for key, value in pool.options.items() %}
    <option name="{{ key }}" value="{{ value }}"/>
    {% endfor %}
  </options>
  {% endif %}
  <!-- Capacity and allocation info — may be auto-computed, but can be set explicitly -->
  <capacity>{{ pool.capacity | default(0) }}</capacity>
  <allocation>{{ pool.allocation | default(0) }}</allocation>
  <available>{{ pool.available | default(0) }}</available>
</pool>