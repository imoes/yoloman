{
  "verbose": false,
  "homedir": "/home/user/.gnupg",
  "dirmngr_program": "/usr/bin/dirmngr",
  "crl_checks": true,
  "ocsp": true,
  "auto_issuer_key_retrieve": false,
  "validation_model": "chain",
  "ignore_cert_extension": [
    "2.5.29.3",
    "2.5.29.37"
  ],
  "armor": true,
  "p12_charset": "Latin1",
  "default_key": "user@example.com",
  "recipient": "recipient@example.com",
  "output": "/tmp/output.p7",
  "include_certs": -2,
  "cipher_algo": "AES",
  "digest_algo": "SHA256",
  "pinentry_mode": "loopback",
  "request_origin": "local",
  "compliance": "de-vs",
  "min_rsa_length": 3000,
  "require_compliance": true
}
