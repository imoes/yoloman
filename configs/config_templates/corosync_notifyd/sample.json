{
 "event_handler": [
  {
   "command": "/usr/local/bin/quorum-alert.sh",
   "events": [
    "quorum_change"
   ],
   "name": "alert-on-quorum-loss",
   "timeout": 10,
   "user": "nobody"
  },
  {
   "command": "/usr/local/bin/node-status-updater.sh",
   "events": [
    "node",
    "votingmember"
   ],
   "name": "node-status-updater",
   "timeout": 5
  }
 ],
 "log_file_path": "/var/log/corosync/notifyd.log",
 "log_level": "info",
 "log_timestamp_format": "iso8601",
 "logging_target": "file"
}
