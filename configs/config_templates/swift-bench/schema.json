{
  "auth": {
    "type": "string",
    "default": null,
    "description": "Swift authentication URL."
  },
  "user": {
    "type": "string",
    "default": null,
    "description": "Swift user name in user:key format."
  },
  "key": {
    "type": "string",
    "default": null,
    "description": "Swift user key."
  },
  "auth_version": {
    "type": "string",
    "default": null,
    "description": "Authentication version.",
    "enum": [
      "1.0",
      "3"
    ]
  },
  "log_level": {
    "type": "string",
    "default": null,
    "description": "Logging level."
  },
  "timeout": {
    "type": "number",
    "default": null,
    "description": "Request timeout in seconds."
  },
  "put_concurrency": {
    "type": "number",
    "default": null,
    "description": "Number of concurrent PUT operations."
  },
  "get_concurrency": {
    "type": "number",
    "default": null,
    "description": "Number of concurrent GET operations."
  },
  "del_concurrency": {
    "type": "number",
    "default": null,
    "description": "Number of concurrent DELETE operations."
  },
  "concurrency": {
    "type": "number",
    "default": null,
    "description": "General concurrency setting, overrides individual concurrency settings if set."
  },
  "object_sources": {
    "type": "list",
    "default": null,
    "description": "Space-separated list of files to read for object bodies."
  },
  "lower_object_size": {
    "type": "number",
    "default": null,
    "description": "Lower bound for random object size in bytes."
  },
  "upper_object_size": {
    "type": "number",
    "default": null,
    "description": "Upper bound for random object size in bytes."
  },
  "object_size": {
    "type": "number",
    "default": null,
    "description": "Fixed object size in bytes if lower_object_size equals upper_object_size."
  },
  "num_objects": {
    "type": "number",
    "default": null,
    "description": "Number of objects to create."
  },
  "num_gets": {
    "type": "number",
    "default": null,
    "description": "Number of GET operations to perform."
  },
  "num_containers": {
    "type": "number",
    "default": null,
    "description": "Number of containers to create."
  },
  "container_name": {
    "type": "string",
    "default": null,
    "description": "Base name for created containers. Empty string means randomly chosen UUID."
  },
  "policy_name": {
    "type": "string",
    "default": null,
    "description": "Storage policy name to use."
  },
  "delete": {
    "type": "string",
    "default": null,
    "description": "Whether to benchmark DELETE and cleanup containers.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "use_proxy": {
    "type": "bool",
    "default": true,
    "description": "Whether to use the proxy layer or talk directly to backend servers."
  },
  "url": {
    "type": "string",
    "default": null,
    "description": "Override X-Storage-Url. Required if use_proxy=no."
  },
  "account": {
    "type": "string",
    "default": null,
    "description": "Account name. Required if use_proxy=no."
  },
  "devices": {
    "type": "list",
    "default": null,
    "description": "Space-separated list of device names. Required if use_proxy=no."
  }
}
