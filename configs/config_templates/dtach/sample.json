{
  "sessions": [
    {
      "name": "bash-shell",
      "command": [
        "/bin/bash",
        "--login"
      ],
      "socket_path": "/tmp/dtach-bash",
      "mode": "c",
      "detach_char": "\\",
      "disable_detach": false,
      "redraw_method": "winch",
      "disable_suspend": true
    },
    {
      "name": "emacs-session",
      "command": [
        "/usr/bin/emacs"
      ],
      "socket_path": "/run/user/1000/dtach-emacs",
      "mode": "A",
      "disable_detach": true,
      "redraw_method": "none",
      "disable_suspend": false
    }
  ]
}
