{
  "log_file": "/var/log/rsyncd.log",
  "modules": [
    {
      "name": "backup",
      "comment": "nightly backups",
      "path": "/srv/backup",
      "use_chroot": true,
      "read_only": false,
      "list": false,
      "uid": "backup",
      "gid": "backup",
      "timeout": 300,
      "max_connections": 4,
      "auth_users": "backup",
      "secrets_file": "/etc/rsyncd.secrets",
      "hosts_allow": "10.0.0.0/8",
      "hosts_deny": null
    }
  ]
}
