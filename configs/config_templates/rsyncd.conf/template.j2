# sample rsyncd.conf configuration file

# GLOBAL OPTIONS

{% if motd_file is defined and motd_file is not none and motd_file != '' %}motd file={{ motd_file }}
{% else %}#motd file=/etc/motd
{% endif %}{% if log_file is defined and log_file is not none and log_file != '' %}log file={{ log_file }}
{% else %}#log file=/var/log/rsyncd
{% endif %}# for pid file, do not use /var/run/rsync.pid if
# you are going to run rsync out of the init.d script.
# The init.d script does its own pid file handling,
# so omit the "pid file" line completely in that case.
{% if pid_file is defined and pid_file is not none and pid_file != '' %}pid file={{ pid_file }}
{% else %}# pid file=/var/run/rsyncd.pid
{% endif %}{% if syslog_facility is defined and syslog_facility is not none and syslog_facility != '' %}syslog facility={{ syslog_facility }}
{% else %}#syslog facility=daemon
{% endif %}#socket options=

# MODULE OPTIONS

{% for m in modules | default([]) %}{{ '\n' if not loop.first else '' }}[{{ m.name }}]

	comment = {{ m.comment | default('') }}
	path = {{ m.path }}
	use chroot = {{ 'yes' if m.use_chroot | default(true) | bool else 'no' }}
{% if m.max_connections is defined and m.max_connections is not none and m.max_connections != '' %}	max connections={{ m.max_connections }}
{% else %}#	max connections=10
{% endif %}	lock file = /var/lock/rsyncd
# the default for read only is yes...
	read only = {{ 'yes' if m.read_only | default(true) | bool else 'no' }}
	list = {{ 'yes' if m.list | default(true) | bool else 'no' }}
	uid = {{ m.uid | default('nobody') }}
	gid = {{ m.gid | default('nogroup') }}
#	exclude = 
#	exclude from = 
#	include =
#	include from =
{% if m.auth_users is defined and m.auth_users is not none and m.auth_users != '' %}	auth users = {{ m.auth_users }}
{% else %}#	auth users = 
{% endif %}{% if m.secrets_file is defined and m.secrets_file is not none and m.secrets_file != '' %}	secrets file = {{ m.secrets_file }}
{% else %}#	secrets file = /etc/rsyncd.secrets
{% endif %}	strict modes = yes
{% if m.hosts_allow is defined and m.hosts_allow is not none and m.hosts_allow != '' %}	hosts allow = {{ m.hosts_allow }}
{% else %}#	hosts allow =
{% endif %}{% if m.hosts_deny is defined and m.hosts_deny is not none and m.hosts_deny != '' %}	hosts deny = {{ m.hosts_deny }}
{% else %}#	hosts deny =
{% endif %}	ignore errors = no
	ignore nonreadable = yes
	transfer logging = no
#	log format = %t: host %h (%a) %o %f (%l bytes). Total %b bytes.
	timeout = {{ m.timeout | default(600) }}
	refuse options = checksum dry-run
	dont compress = *.gz *.tgz *.zip *.z *.rpm *.deb *.iso *.bz2 *.tbz
{% endfor %}