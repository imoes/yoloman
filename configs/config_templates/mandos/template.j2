# Directory where configuration files are located.  Default is
# "/{{ configdir }}".
# 
{% if configdir is defined and configdir is not none and (configdir is number or configdir is boolean or configdir | length > 0) %}CONFIGDIR=/{{ configdir }}{% else %}#CONFIGDIR=/etc/mandos{% endif %}

# Additional options that are passed to the Daemon.
DAEMON_ARGS="{{ daemon_args }}"
