{
  "listen_addresses": [
    "127.0.0.1",
    "10.0.0.5"
  ],
  "port": 9161,
  "keys_dir": "/etc/mandos/keys",
  "plugins_dir": "/usr/lib/mandos/plugins",
  "max_clients": 50,
  "log_level": "warning",
  "verbose": false,
  "ssl_enabled": true,
  "ssl_cert_file": "/etc/mandos/mandos.crt",
  "ssl_key_file": "/etc/mandos/mandos.key",
  "ssl_ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "ssl_crl_file": "/etc/mandos/crl.pem",
  "allowed_hosts": [
    "client1.example.com",
    "10.0.0.10"
  ],
  "use_systemd_socket": true,
  "plugins": [
    {
      "name": "debug",
      "description": "Log detailed request/response for debugging",
      "enabled": false,
      "options": {
        "log_path": "/var/log/mandos/debug.log"
      }
    },
    {
      "name": "hook",
      "description": "Run scripts before/after key delivery",
      "enabled": true,
      "options": {
        "pre_hook": "/usr/local/bin/mandos-pre",
        "post_hook": "/usr/local/bin/mandos-post"
      }
    }
  ]
}
