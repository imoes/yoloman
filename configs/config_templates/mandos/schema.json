{
  "configdir": {
    "type": "string",
    "default": "/etc/mandos",
    "description": "Absolute path to the directory where configuration files are located"
  },
  "daemon_args": {
    "type": "string",
    "default": "",
    "description": "Additional command-line arguments passed directly to the Mandos daemon",
    "enum": [
      "--interface",
      "-i",
      "--address",
      "-a",
      "--port",
      "-p",
      "--priority",
      "--servicename",
      "--configdir",
      "--debug",
      "--debuglevel",
      "--no-dbus",
      "--no-ipv6",
      "--no-restore",
      "--statedir",
      "--socket",
      "--foreground",
      "--no-zeroconf",
      "--help",
      "-h",
      "--version",
      "--check"
    ]
  }
}
