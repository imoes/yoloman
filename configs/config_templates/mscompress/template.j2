# mscompress configuration
# This template represents a hypothetical configuration for a service wrapper
# or script that invokes mscompress, as mscompress(1) is a CLI tool with no
# persistent state or native config file.

# Directory containing source files to be compressed by mscompress.
input_dir: {{ input_dir | default('/var/lib/mscompress/incoming') }}

# Directory where compressed files (with .u extension) will be stored.
output_dir: {{ output_dir | default('/var/lib/mscompress/compressed') }}

# The LZ77 compression efficiency level. mscompress typically uses a default,
# but wrappers may expose this. Range is typically 1-9.
compression_level: {{ compression_level | default(5) }}

# If true, enables verbose output from the compression process.
verbose: {{ verbose | default(false) | lower }}