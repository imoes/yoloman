# PowerDNS Authoritative Server Configuration
# Generated by Ansible - Self-Documenting Template
# See schema for field definitions and defaults.

#################################
# local-address
# Local IP address to bind the DNS server to (e.g., '0.0.0.0' for all interfaces).
#################################
local-address={{ local_address | default('127.0.0.1') }}

#################################
# local-port
# UDP/TCP port to listen on for DNS queries.
#################################
local-port={{ local_port | default(53) }}

#################################
# api
# Enable/disable the REST API (including HTTP listener).
#################################
api={{ api | default(False) | lower }}

#################################
# api-key
# Static pre-shared authentication key for access to the REST API.
#################################
api-key={{ api_key | default('') }}

#################################
# distributor-threads
# Default number of Distributor (backend) threads to start.
#################################
distributor-threads={{ threads | default(2) }}

#################################
# log-dns-queries
# If PDNS should log all incoming DNS queries.
#################################
log-dns-queries={{ log_dns_queries | default(False) | lower }}

#################################
# loglevel
# Amount of logging. Higher is more. Do not set below 3.
#################################
loglevel={{ loglevel | default(3) }}

#################################
# resolver
# Use this resolver for ALIAS and the internal stub resolver (upstream recursive resolver).
#################################
resolver={{ recursor | default('') }}

#################################
# max-qps
# Maximum queries per second allowed before throttling starts.
#################################
max-qps={{ max_qps | default(500) }}

#################################
# query-local-address
# Source IP addresses for sending queries.
# Note: Mapped from schema field 'query_local_address_timeout' as per schema constraints,
# though semantically this config key usually expects an IP. The schema provides a timeout value.
# To maintain schema compliance, we use the provided schema variable.
#################################
query-local-address={{ query_local_address_timeout | default(2000) }}

#################################
# dnssec
# DNSSEC validation behavior. 'process' actively validates; 'log-*' only logs results.
#################################
dnssec={{ dnssec | default('off') }}