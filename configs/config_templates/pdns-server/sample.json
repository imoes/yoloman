{
  "local_address": "0.0.0.0",
  "local_port": 53,
  "api": true,
  "api_key": "my-super-secret-api-key-123",
  "recursor": "127.0.0.1:5300",
  "max_qps": 1000,
  "query_local_address_timeout": 3000,
  "threads": 4,
  "loglevel": 4,
  "log_dns_queries": true,
  "dnssec": "process",
  "backends": [
    "gsqlite3"
  ],
  "gsqlite3_database": "/var/lib/powerdns/pdns.sqlite3",
  "gsqlite3_dnssec": true,
  "gsqlite3_pragma_synchronous": "NORMAL",
  "allow_axfr_ips": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "mode": "master",
  "edns_subnet_processing": true,
  "neg_query_cache_ttl": 60,
  "default_soa_name": "ns1.example.com.",
  "default_soa_mail": "admin.example.com.",
  "tcp_fast_open": 3,
  "max_tcp_clients": 50,
  "affinity_mask": "0xf",
  "delayed_answer_timeout": 100,
  "allow_query_localhost": false
}
