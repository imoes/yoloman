# Desktop entry for Privacy Browser
# Specifies the application name and generic category
Name=Privacy Browser

# Executable to launch the application
Exec=privacybrowser

# Icon path for the application
Icon=privacybrowser

# Desktop file base name as specified by the --desktopfile option
# Default: 'privacybrowser'
DesktopFile={{ desktop_file | default('privacybrowser') }}

# Comment describing the application's purpose
Comment=A web browser that respects your privacy

# Categories associated with the application in the menu
Categories=Network;WebBrowser;

# Type of desktop entry
Type=Application

# Terminal execution setting (false for GUI apps)
Terminal=false

# NoDisplay flag to hide from menu if desired
# Default: false
NoDisplay={{ hidden | default(false) }}