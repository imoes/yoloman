# pgCLUU Web Interface Configuration
#
# This template configures the Apache Alias directive to serve the pgCLUU
# web-based PostgreSQL performance monitoring interface.

# The filesystem path to the pgCLUU web interface files.
# @schema pgcluu_document_root
Alias /pgcluu {{ pgcluu_document_root | default('/usr/share/pgcluu') }}

