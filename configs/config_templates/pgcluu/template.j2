# pgCLUU Web Interface Apache Configuration
#
# This file configures Apache to serve the pgCLUU web interface.
#
# NOTE: The application settings (report_dir, mail settings,
# postgres connection) are configured in /etc/pgcluu/pgcluu.conf
# and are not managed by this Apache snippet.
#
# Schema Fields for Reference:
# - pgcluu_document_root: /usr/share/pgcluu
# - report_dir: /var/lib/pgcluu/reports
# - mail_enabled: False
# - mail_to: dba@example.com
# - mail_smtp: localhost
# - mail_from: pgcluu@localhost

# The filesystem path to the pgCLUU web interface files.
# Maps to the pgcluu_document_root schema field.
# @default /usr/share/pgcluu
Alias /pgcluu {{ pgcluu_document_root | default('/usr/share/pgcluu') }}

# Optional: Add permissions to ensure Apache can read the files.
# This block is commonly required for Alias directives.
# @comment If your system uses Apache 2.4+, the Order/Allow/Deny
# @comment directives are deprecated. Use Require all granted.

<Directory {{ pgcluu_document_root | default('/usr/share/pgcluu') }}>
    # Allow Apache to access the directory.
    Require all granted
</Directory>