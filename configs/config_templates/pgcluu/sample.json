{
  "collect_enabled": true,
  "data_dir": "/var/lib/pgcluu/data",
  "report_dir": "/var/lib/pgcluu/reports",
  "retention_days": 30,
  "connstr": "host=primary-db port=5432 dbname=postgres user=pgcluu password=secret",
  "collection_interval": 60,
  "summary_hours": 24,
  "detailed_enabled": true,
  "locks_enabled": true,
  "wal_enabled": false,
  "replication_enabled": true,
  "io_enabled": true,
  "query_text_enabled": false,
  "servers": [
    {
      "name": "replica-1",
      "connstr": "host=replica-1 port=5432 dbname=postgres user=pgcluu password=secret",
      "interval": 300,
      "summary_hours": 168,
      "tags": [
        "replica",
        "backup"
      ]
    },
    {
      "name": "analytics-db",
      "connstr": "host=analytics-db port=5432 dbname=analytics user=pgcluu password=secret",
      "tags": [
        "analytics",
        "readonly"
      ]
    }
  ],
  "log_file": "/var/log/pgcluu/pgcluu.log",
  "log_level": "WARNING",
  "mail_enabled": false,
  "mail_to": "",
  "mail_smtp": "mail.example.com",
  "mail_from": "pgcluu-alerts@example.com",
  "http_enabled": true,
  "http_host": "0.0.0.0",
  "http_port": 8080,
  "http_auth_enabled": true,
  "http_base_url": "/pgcluu",
  "http_gzip_enabled": true,
  "http_ssl_enabled": false,
  "http_ssl_cert": "",
  "http_ssl_key": "",
  "timezone": "America/New_York",
  "auto_report_enabled": true,
  "workers": 4,
  "bloat_enabled": true,
  "index_bloat_enabled": false,
  "extensions_enabled": true,
  "users_enabled": true,
  "size_enabled": true
}
