# slbackup logrotate configuration
# Managed by Ansible. Do not edit manually.

# Log directory for slbackup: {{ slbackup_log_dir | default('/var/log/slbackup') }}

# Main slbackup log rotation
# Log file: {{ slbackup_log_dir | default('/var/log/slbackup') }}/{{ slbackup_log_file | default('slbackup.log') }}
# Rotation policy: monthly, compress, keep last 12 rotated files, skip if missing, skip if empty.
{{ slbackup_log_dir | default('/var/log/slbackup') }}/{{ slbackup_log_file | default('slbackup.log') }} {
	monthly
	missingok
	compress
	notifempty
	rotate {{ slbackup_log_rotate_count | default('12') }}
}

# Run scripts log rotation
# Log file: {{ slbackup_log_dir | default('/var/log/slbackup') }}/{{ slbackup_run_scripts_log_file | default('run_scripts.log') }}
# Rotation policy: monthly, compress, keep last 12 rotated files, skip if missing, skip if empty.
{{ slbackup_log_dir | default('/var/log/slbackup') }}/{{ slbackup_run_scripts_log_file | default('run_scripts.log') }} {
	monthly
	missingok
	compress
	notifempty
	rotate {{ slbackup_run_scripts_log_rotate_count | default('12') }}
}
