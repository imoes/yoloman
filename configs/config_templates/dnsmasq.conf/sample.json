{
  "domain_name": "lan",
  "upstream_servers": [
    "8.8.8.8",
    "1.1.1.1"
  ],
  "listen_interfaces": [
    "eth0"
  ],
  "addn_hosts": "/etc/dnsmasq/addn-hosts",
  "expand_hosts": true,
  "cache_size": 1000,
  "log_level": 1,
  "log_file": "/var/log/dnsmasq.log",
  "dns_port": 53,
  "dhcp_enabled": true,
  "dhcp_networks": [
    {
      "interface": "eth0",
      "start": "192.168.1.100",
      "end": "192.168.1.200",
      "lease_time": "12h"
    }
  ],
  "dhcp_options": [
    {
      "code": "66",
      "value": "tftp.lan"
    },
    {
      "code": "67",
      "value": "pxelinux.0"
    }
  ],
  "dhcp_gateway": "192.168.1.1",
  "dhcp_dns": [
    "192.168.1.1"
  ],
  "static_hosts": [
    {
      "mac": "aa:bb:cc:dd:ee:ff",
      "ip": "192.168.1.10",
      "name": "server1"
    },
    {
      "mac": "11:22:33:44:55:66",
      "name": "printer"
    }
  ],
  "dhcp_port": 67,
  "ignore_hosts": true
}
