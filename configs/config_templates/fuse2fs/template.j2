# /etc/fuse2fs.conf
# Configuration for fuse2fs(1) — FUSE client for ext2/ext3/ext4 file systems
# Each line is a set of options passed directly to fuse2fs via -o
# See fuse2fs(1) and mount.fuse(8) for full details
# NOTE: This file is NOT a native config file; fuse2fs takes options only via -o on command line.
# We interpret this file as a list of options to inject into the command invocation.
#
# Schema:
#   options (list): List of command-line options to pass to fuse2fs via -o;
#                   each item is a full option string (e.g., 'ro', 'errors=panic', 'debug')
#                   as accepted by fuse2fs.

# Iterate over the list of options defined in the 'options' variable.
# Default to an empty list if 'options' is not defined.
{% for opt in options | default([]) %}
# Option: {{ opt }}
{{ opt }}
{% endfor %}