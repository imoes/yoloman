[default]

# The directory where FreeIPA health check reports are stored.
# Schema default: /var/lib/ipa/healthcheck
report_dir = {{ report_dir | default('/var/lib/ipa/healthcheck') }}

# The user running the health checks.
# Schema default: apache
rp_user = {{ rp_user | default('apache') }}

# The group running the health checks.
# Schema default: apache
rp_group = {{ rp_group | default('apache') }}

# The timeout for individual health check functions in seconds.
# Schema default: 30
timeout = {{ timeout | default(30) }}

# Whether to run health checks in debug mode.
# If set to true, additional debug information will be logged.
# Schema default: False
debug = {{ debug | default(False) | lower }}

# The log file path.
# Schema default: /var/log/ipa/healthcheck.log
log_file = {{ log_file | default('/var/log/ipa/healthcheck.log') }}

# The log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Schema default: WARNING
log_level = {{ log_level | default('WARNING') | upper }}