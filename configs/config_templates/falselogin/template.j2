# /etc/falselogin.conf
# Configuration file for the falselogin service.
# This package provides a cosmetic login message and does not expose
# any network service or require external backend connections.

# -----------------------------------------------------------------------------
# Wait Time Configuration
# -----------------------------------------------------------------------------
# The default wait time in seconds, uncommented in config if used.
# This variable controls the timeout before the login prompt disappears
# or the message is displayed.
#
# To activate, uncomment the following line and set the desired value.
# {{ default_wait | default(5) }}

# -----------------------------------------------------------------------------
# System Identification Banner
# -----------------------------------------------------------------------------
# A welcome message displayed upon connection.
#
# Variables used:
# - default_host: The hostname of the system.
# - default_debian_version: The Debian version number (e.g., '12').
# - default_sysname: The system name (e.g., 'Linux', 'GNU/Hurd').
# - default_release: The Debian release codename (e.g., 'bullseye').

Welcome to {{ default_host | default('localhost') }} (Debian {{ default_debian_version | default('12') }} {{ default_sysname | default('Linux') }} {{ default_release | default('bullseye') }})!

# -----------------------------------------------------------------------------
# User Mailbox Notification
# -----------------------------------------------------------------------------
# Displays the number of mail messages in the user's mailbox.
# Default placeholder is '%mail%'.

You have {{ default_mail | default('%mail%') }} messages in your mailbox.

# -----------------------------------------------------------------------------
# Shell Login Denial Message
# -----------------------------------------------------------------------------
# A polite refusal message for shell access attempts.
#
# Variables used:
# - default_user: The username of the current user. Default placeholder is '%user%'.

Sorry {{ default_user | default('%user%') }} our server does not accept shell logins.
So long and thanks for all the fish.
