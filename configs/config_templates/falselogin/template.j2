# /etc/falselogin.conf
# Configuration file for the falselogin service.
# falselogin is a simple daemon that displays a custom welcome message
# instead of starting an interactive shell. This prevents unauthorized
# shell access while allowing users to see system information.

# The hostname of the system displayed in the welcome banner.
# Default: 'localhost'
banner_host={{ host | default('localhost') }}

# The Debian version number included in the system identification string.
# Default: '12'
banner_debian_version={{ debian_version | default('12') }}

# The system name (e.g., Linux, GNU/Hurd) included in the identification string.
# Default: 'Linux'
banner_sysname={{ sysname | default('Linux') }}

# The Debian release codename (e.g., bullseye, bookworm) included in the identification string.
# Default: 'bullseye'
banner_release={{ release | default('bullseye') }}

# The wait time in seconds before the login process exits if the --wait option is not provided.
# This allows users time to read the welcome message.
# Default: 5
wait={{ wait | default(5) }}

# The number of mail messages in the user's mailbox, displayed in the welcome message.
# Default: 0
mail_count={{ mail | default(0) }}

# The username of the current user, displayed in the custom denial message.
# Default: 'user'
current_user={{ user | default('user') }}