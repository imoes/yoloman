{
  "default_wait": {
    "type": "string",
    "default": "5",
    "description": "The default wait time in seconds, uncommented in config if used."
  },
  "default_host": {
    "type": "string",
    "default": "localhost",
    "description": "The hostname of the system."
  },
  "default_debian_version": {
    "type": "string",
    "default": "12",
    "description": "The Debian version number."
  },
  "default_sysname": {
    "type": "string",
    "default": "Linux",
    "description": "The system name (e.g., Linux, GNU/Hurd)."
  },
  "default_release": {
    "type": "string",
    "default": "bullseye",
    "description": "The Debian release codename."
  },
  "default_mail": {
    "type": "string",
    "default": "%mail%",
    "description": "Number of mail messages in the user's mailbox."
  },
  "default_user": {
    "type": "string",
    "default": "%user%",
    "description": "The username of the current user."
  }
}
