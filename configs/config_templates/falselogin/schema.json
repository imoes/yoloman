{
  "host": {
    "type": "string",
    "default": "localhost",
    "description": "The hostname of the system"
  },
  "debian_version": {
    "type": "string",
    "default": "12",
    "description": "The Debian version number"
  },
  "sysname": {
    "type": "string",
    "default": "Linux",
    "description": "The system name (e.g., Linux, GNU/Hurd)"
  },
  "release": {
    "type": "string",
    "default": "bullseye",
    "description": "The Debian release codename"
  },
  "mail": {
    "type": "string",
    "default": "0",
    "description": "Number of mail messages in the user's mailbox"
  },
  "user": {
    "type": "string",
    "default": "user",
    "description": "The username of the current user"
  },
  "wait": {
    "type": "number",
    "default": 5,
    "description": "Default wait time (seconds) if --wait option is not provided"
  }
}
