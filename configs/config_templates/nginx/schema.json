{
  "worker_processes": {
    "type": "number",
    "default": 4,
    "description": "Number of worker processes",
    "enum": [
      "auto"
    ]
  },
  "pid": {
    "type": "string",
    "default": "/run/nginx.pid",
    "description": "Path to nginx PID file"
  },
  "worker_connections": {
    "type": "number",
    "default": 1024,
    "description": "Maximum number of simultaneous connections per worker"
  },
  "upstreams": {
    "type": "list",
    "default": [],
    "description": "List of upstream definitions"
  },
  "server_blocks": {
    "type": "list",
    "default": [],
    "description": "List of server blocks"
  }
}
