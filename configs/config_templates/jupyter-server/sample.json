{
  "config_file": "/etc/jupyter/jupyter_server_config.py",
  "log_level": "DEBUG",
  "ip": "0.0.0.0",
  "port": 8888,
  "port_retries": 0,
  "root_dir": "/home/jupyter/notebooks",
  "allow_root": false,
  "open_browser": false,
  "keyfile": "/etc/ssl/private/server.key",
  "certfile": "/etc/ssl/certs/server.crt",
  "client_ca": "",
  "transport": "tcp",
  "gateway_url": "http://localhost:8889",
  "browser": "firefox",
  "pylab": "disabled",
  "extensions": [
    "jupyterlab",
    "nbgitpuller"
  ],
  "environment_vars": [
    {
      "name": "JUPYTER_ENABLE_LAB",
      "value": "true"
    },
    {
      "name": "JUPYTER_GATEWAY_URL",
      "value": "http://gateway:8888"
    }
  ]
}
