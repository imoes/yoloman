#!/bin/sh
### BEGIN INIT INFO
# Provides:          neutron-services-server
# Required-Start:    $network $local_fs $remote_fs $syslog
# Required-Stop:    $remote_fs
# Should-Start:      mysql postgresql rabbitmq-server keystone openvswitch-switch
# Should-Stop:       mysql postgresql rabbitmq-server keystone openvswitch-switch
# Default-Start:     2 3 4 5
# Default-Stop:     0 1 6
# Short-Description: Neutron services server
# Description:       Provide Neutron services server for {{ (project_name | default('neutron')) }}
### END INIT INFO

# Author: Thomas Goirand <zigo@debian.org>
# The description string for service identification
DESC="OpenStack Neutron Services server ({{ (project_name | default('neutron')) }}-services-server)"
# The project name variable used for naming conventions and paths
PROJECT_NAME={{ project_name | default('neutron') }}
# The service name derived from project name
NAME=${PROJECT_NAME}-services-server

### Maintain the plugin selection so that we can load the corresponding .ini file    ###
### after this, openstack-pkg-tools will add --config-file=/etc/neutron/neutron.conf ###
# Check if the plugin helper script is available
[ -r /usr/share/neutron-common/plugin_guess_func ] || exit 0
# Source the plugin helper functions
. /usr/share/neutron-common/plugin_guess_func

# Ensure the main neutron configuration file exists
if ! [ -r /etc/neutron/neutron.conf ] ; then
	echo "Cloud not read /etc/neutron/neutron.conf: exiting"
	exit 0
fi

# Extract the currently configured core plugin from neutron.conf
CURRENT_PLUGIN=`grep "^[ \t]*core_plugin[ \t]*=[ \t]*[._a-zA-Z0-9]*\$" /etc/neutron/neutron.conf | sed -e 's/^[ \t]*core_plugin[ \t]*=[ \t]*//'`
# If no core_plugin is found, abort as the service cannot run
if [ -z "${CURRENT_PLUGIN}" ] ; then
	echo "No core_plugin= value found: please set it and try again"
	exit 0
fi
# Translate the plugin class name to a plugin configuration name
neutron_core_plugin_to_plugin_name ${CURRENT_PLUGIN}
# Determine the path to the plugin-specific .ini configuration file
neutron_plugin_ini_path ${NEUTRON_PLUGIN_NAME}
# If the plugin is not recognized, abort
if [ -z "${NEUTRON_PLUGIN_CONFIG}" ] ; then
	echo "Plugin not recognized: please edit /etc/init.d/neutron-rpc-server to select the correct .ini file to load for your plugin"
else
	# Set the daemon arguments to include the plugin configuration file
	DAEMON_ARGS="--config-file=${NEUTRON_PLUGIN_CONFIG}"
	# Update the description to indicate which plugin is being used
	DESC="${DESC} with ${NEUTRON_PLUGIN_NAME} plugin"
fi

# Load additional server-side configuration files from the server.conf.d directory
if [ -e /etc/neutron/server.conf.d ] ; then
	DAEMON_ARGS="--config-dir=/etc/neutron/server.conf.d ${DAEMON_ARGS}"
fi

### end of plugin selection ###
# Export the process name for OpenStack Oslo messaging library
export OS_OSLO_MESSAGING_RABBIT__PROCESSNAME=neutron-services-server
#!/bin/sh
# The content after this line comes from openstack-pkg-tools
# and has been automatically added to a .init.in script, which
# contains only the descriptive part for the daemon. Everything
# else is standardized as a single unique script.

# Author: Thomas Goirand <zigo@debian.org>
# Author: Ondřej Nový <novy@ondrej.org>

# PATH should only include /usr/* if it runs after the mountnfs.sh script
PATH=/sbin:/usr/sbin:/bin:/usr/bin

# Optional UWSGI configuration block
# If UWSGI environment variables are set, configure the daemon to use UWSGI
if [ -n "${UWSGI_PORT}" ] && [ -n "${UWSGI_INI_PATH}" ] && [ -n "${UWSGI_INI_APP}" ] ; then
	# If the UWSGI application ini file does not exist, skip UWSGI configuration
	if ! [ -f "${UWSGI_INI_APP}" ] ; then
		exit 0
	fi
	# Look for a private SSL key file
	if [ -d /etc/${PROJECT_NAME}/ssl/private ] ; then
		KEY_FILE=$(find /etc/${PROJECT_NAME}/ssl/private -type f -iname '*.pem' 2>/dev/null | head -n 1)
	fi

	# Look for an SSL certificate file
	# Prefer the standard path if it exists (often used by Puppet)
	if [ -e /usr/local/share/ca-certificates/puppet_openstack.crt ] ; then
		# This is needed for puppet...
		CERT_FILE=/usr/local/share/ca-certificates/puppet_openstack.crt
	else
		# Otherwise, look for a public certificate in the project's SSL directory
		if [ -d /etc/${PROJECT_NAME}/ssl/public ] ; then
			CERT_FILE=$(find /etc/${PROJECT_NAME}/ssl/public -type f -iname '*.crt' 2>/dev/null | head -n 1)
		fi
	fi

	# Determine the specific UWSGI binary path
	# Ubuntu 16.04 (Xenial) has /usr/bin/uwsgi_python3, but newer versions might have specific versions
	for i in 3 35 36 37 38 39 310 311 312 313 314 315 316 317 318 319 ; do
		if [ -x /usr/bin/uwsgi_python${i} ] ; then
			DAEMON=/usr/bin/uwsgi_python${i}
		fi
	done

	# If UWSGI bind configuration directives are provided, parse them from an INI file
	if [ -n "${UWSGI_BIND_CONFIG_FILE}" ] && [ -r "${UWSGI_BIND_CONFIG_FILE}" ] && [ -n "${UWSGI_BIND_CONFIG_SECTION}" ] && [ -n "${UWSGI_BIND_CONFIG_IP_DIRECTIVE}" ] && [ -n "${UWSGI_BIND_CONFIG_PORT_DIRECTIVE}" ] && [ -r /usr/share/openstack-pkg-tools/pkgos_func ] ; then
		. /usr/share/openstack-pkg-tools/pkgos_func
		# Get the bind IP address from the configuration file
		pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_IP_DIRECTIVE}
	        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
			UWSGI_BIND_IP=${RET}
		fi
		# Get the bind port number from the configuration file
		pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_PORT_DIRECTIVE}
	        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
			UWSGI_PORT=${RET}
		fi
		# If worker count is configured, use it; otherwise, calculate based on CPU count
		if [ -n "${UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE}" ] ; then
			pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE}
		        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
				UWSGI_PROCESSES=" --processes ${RET}"
			else
				# If we can't find the directive in the config file,
				# we fallback to the number of thread / 2.
				UWSGI_PROCESSES=" --processes "$$(( $(nproc) / 2 ))
			fi
		fi
		# Special handling for Swift object server which might need multiple ports
		if [ "${UWSGI_BIND_CONFIG_FILE}" = "/etc/swift/object-server.conf" ] ; then
			pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} devices
			if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
				DEVICES_PATH=${RET}
				NUM_DEVICES=$(ls ${DEVICES_PATH} | wc -l)
				COUNT=0
				while [ "${COUNT}" != "${NUM_DEVICES}" ] ; do
					CUR_PORT=$(( ${UWSGI_PORT} + ${COUNT} ))
					BIND_PARAMS="${BIND_PARAMS} --http-socket ${UWSGI_BIND_IP}:${CUR_PORT}"
					COUNT=$(( ${COUNT} + 1 ))
				done
			fi
		fi
	else
		# Default bind IP if not explicitly configured
		UWSGI_BIND_IP=""
	fi

	# Construct the daemon arguments based on SSL and bind settings
	if [ -n "${BIND_PARAMS}" ] ; then
		DAEMON_ARGS="${BIND_PARAMS}${UWSGI_PROCESSES}"
	else
		if [ -n "${KEY_FILE}" ] && [ -n "${CERT_FILE}" ] ; then
			# If SSL key and cert are present, use HTTPS socket
			DAEMON_ARGS="--https-socket ${UWSGI_BIND_IP}:${UWSGI_PORT},${CERT_FILE},${KEY_FILE}${UWSGI_PROCESSES}"
		else
			# Otherwise, use standard HTTP socket
			DAEMON_ARGS="--http-socket ${UWSGI_BIND_IP}:${UWSGI_PORT}${UWSGI_PROCESSES}"
		fi
	fi

	# Append the UWSGI ini file path to daemon arguments
	DAEMON_ARGS="${DAEMON_ARGS} --ini ${UWSGI_INI_PATH}"
	# Disable standard OpenStack config file and logfile arguments as UWSGI handles them
	NO_OPENSTACK_CONFIG_FILE_DAEMON_ARG=yes
	NO_OPENSTACK_LOGFILE_DAEMON_ARG=yes
fi

# Default daemon binary if not overridden by UWSGI configuration
if [ -z "${DAEMON}" ] ; then
	DAEMON=/usr/bin/${NAME}
fi

# Path for the PID file
PIDFILE=/var/run/${PROJECT_NAME}/${NAME}.pid
# Default script name if not provided
if [ -z "${SCRIPTNAME}" ] ; then
	SCRIPTNAME=/etc/init.d/${NAME}
fi
# Default system user for running the service
if [ -z "${SYSTEM_USER}" ] ; then
	SYSTEM_USER=${PROJECT_NAME}
fi
# Default system group for running the service
if [ -z "${SYSTEM_GROUP}" ] ; then
	SYSTEM_GROUP=${PROJECT_NAME}
fi
# If running as non-root, set the user/group for the daemon start
if [ "${SYSTEM_USER}" != "root" ] ; then
	STARTDAEMON_CHUID="--chuid ${SYSTEM_USER}:${SYSTEM_GROUP}"
fi
# Default configuration file path
if [ -z "${CONFIG_FILE}" ] ; then
	CONFIG_FILE=/etc/${PROJECT_NAME}/${PROJECT_NAME}.conf
fi
# Path for the log file
LOGFILE=/var/log/${PROJECT_NAME}/${NAME}.log
# Add config file argument if not using UWSGI mode
if [ -z "${NO_OPENSTACK_CONFIG_FILE_DAEMON_ARG}" ] ; then
	DAEMON_ARGS="--config-file=${CONFIG_FILE} ${DAEMON_ARGS}"
fi

# Exit if the package is not installed (daemon binary not executable)
[ -x $DAEMON ] || exit 0

# If ran as root, create necessary directories (/var/lock, /var/run, /var/cache)
if [ `whoami` = "root" ] ; then
	for i in lock run cache ; do
		mkdir -p /var/$i/${PROJECT_NAME}
		chown ${SYSTEM_USER}:${SYSTEM_GROUP} /var/$i/${PROJECT_NAME}
	done
fi

# Load standard LSB init functions
. /lib/lsb/init-functions

RET=0

# Manage log options: logfile and/or syslog, depending on user's choosing
# Source system-wide OpenStack defaults
[ -r /etc/default/openstack ] && . /etc/default/openstack
# Source service-specific defaults
[ -r /etc/default/$NAME ] && . /etc/default/$NAME
# Enable syslog if configured
[ "x$USE_SYSLOG" = "xyes" ] && DAEMON_ARGS="$DAEMON_ARGS --use-syslog"
# Enable log file if not explicitly disabled and not in UWSGI mode
if [ -z "${NO_OPENSTACK_LOGFILE_DAEMON_ARG}" ] ; then
	[ "x$USE_LOGFILE" != "xno" ] && DAEMON_ARGS="$DAEMON_ARGS --log-file=$LOGFILE"
fi

# Function to start the daemon
do_start() {
	start-stop-daemon \
		--start \
		--quiet \
		--background ${STARTDAEMON_CHUID} \
		--make-pidfile --pidfile ${PIDFILE} \
		--chdir /var/lib/${PROJECT_NAME} \
		--startas $DAEMON \
		--test > /dev/null \
		|| return 1
	# If additional Python arguments are provided, pass them
	if [ -n "${PYARGV}" ] ; then
		start-stop-daemon \
			--start \
			--quiet \
			--background ${STARTDAEMON_CHUID} \
			--make-pidfile --pidfile ${PIDFILE} \
			--chdir /var/lib/${PROJECT_NAME} \
			--startas $DAEMON \
			-- $DAEMON_ARGS --pyargv "${PYARGV}" \
			|| return 2
	else
		start-stop-daemon \
			--start \
			--quiet \
			--background ${STARTDAEMON_CHUID} \
			--make-pidfile --pidfile ${PIDFILE} \
			--chdir /var/lib/${PROJECT_NAME} \
			--startas $DAEMON \
			-- $DAEMON_ARGS \
			|| return 2
	fi
}

# Function to stop the daemon
do_stop() {
	start-stop-daemon \
		--stop \
		--quiet \
		--retry=TERM/30/KILL/5 \
		--pidfile $PIDFILE
	RETVAL=$?
	rm -f $PIDFILE
	return "$RETVAL"
}

# Function for systemd direct execution
do_systemd_start() {
	# Set umask to ensure log files are created with 0644 mode bits
	# Note we can't set 0026 to have files 0640, because that's going
	# to be in use in for example neutron-dhcp-agent, which makes it
	# so it wont't be able to read /var/lib/neutron/external/pids/*.pid.haproxy
	# and then fail hardly. However, 0022 is enough, since the log
	# folders are owned by <project>:adm, so users don't have access
	# to it unless they are on the adm group, which is what we want.
	umask 0022
	if [ -n "${PYARGV}" ] ; then
		exec $DAEMON $DAEMON_ARGS --pyargv "${PYARGV}"
	else
		exec $DAEMON $DAEMON_ARGS
	fi
}

# Main case statement for init script commands
case "$1" in
start)
	log_daemon_msg "Starting $DESC" "$NAME"
	do_start
	case $? in
		0|1) log_end_msg 0 ; RET=$? ;;
		2)   log_end_msg 1 ; RET=$? ;;
	esac
;;
stop)
	log_daemon_msg "Stopping $DESC" "$NAME"
	do_stop
	case $? in
		0|1) log_end_msg 0 ; RET=$? ;;
		2)   log_end_msg 1 ; RET=$? ;;
	esac
;;
status)
	status_of_proc "$DAEMON" "$NAME"
	RET=$?
;;
systemd-start)
	do_systemd_start
;;  
show-args)
	# Print the full command line used for starting the daemon
	if [ -n "${PYARGV}" ] ; then
		echo $DAEMON $DAEMON_ARGS --pyargv \"${PYARGV}\"
	else
		echo $DAEMON $DAEMON_ARGS
	fi
;;
restart|force-reload)
	log_daemon_msg "Restarting $DESC" "$NAME"
	do_stop
	case $? in
		0|1)
			do_start
			case $? in
				0) log_end_msg 0 ; RET=$? ;;
				1) log_end_msg 1 ; RET=$? ;; # Old process is still running
				*) log_end_msg 1 ; RET=$? ;; # Failed to start
			esac
		;;
		*) log_end_msg 1 ; RET=$? ;; # Failed to stop
	esac
;;
*)
	echo "Usage: $SCRIPTNAME {start|stop|status|restart|force-reload|systemd-start}" >&2
	RET=3
;;
esac

exit $RET