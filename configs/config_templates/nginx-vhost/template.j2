{# nginx server block (one site). The whole file is rendered from values —
   never hand-edited. TLS terminates here when tls_enabled. #}
{% for upstream in upstreams %}
upstream {{ upstream.name }} {
{% for server in upstream.servers %}
  server {{ server }};
{% endfor %}
}
{% endfor %}
{% if tls_enabled and redirect_to_https %}
# HTTP -> HTTPS redirect (own server block)
server {
  listen 80;
{% if listen_ipv6 %}
  listen [::]:80;
{% endif %}
  server_name {{ server_name }};
  return 301 https://{{ server_name }}$request_uri;
}
{% endif %}
server {
{% if tls_enabled %}
  listen 443 ssl;
{% if listen_ipv6 %}
  listen [::]:443 ssl;
{% endif %}
{% if http2|default(true) %}
  http2 on;
{% endif %}
  ssl_certificate {{ ssl_certificate }};
  ssl_certificate_key {{ ssl_certificate_key }};
  ssl_protocols {{ ssl_protocols|default('TLSv1.2 TLSv1.3') }};
{% if ssl_ciphers|default('') %}
  ssl_ciphers {{ ssl_ciphers }};
  ssl_prefer_server_ciphers off;
{% endif %}
{% if hsts|default(false) %}
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
{% endif %}
{% else %}
  listen {{ listen_port }};
{% if listen_ipv6 %}
  listen [::]:{{ listen_port }};
{% endif %}
{% endif %}
  server_name {{ server_name }};

  root {{ root }};
  index index.html index.htm;

{% for loc in locations %}
  location {{ loc.path }} {
{% if loc.proxy_pass %}
    proxy_pass {{ loc.proxy_pass }};
{% endif %}
{% if loc.try_files %}
    try_files {{ loc.try_files }};
{% endif %}
{% if loc.extra %}
    {{ loc.extra|indent(4) }}
{% endif %}
  }
{% endfor %}
{% if extra_server_parameters %}
  {{ extra_server_parameters|indent(2) }}
{% endif %}
}
