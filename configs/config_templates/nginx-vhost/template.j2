{# nginx server block (one site). The whole file is rendered from values —
   never hand-edited. TLS terminates here when tls_enabled. #}
{% for upstream in upstreams %}
upstream {{ upstream.name }} {
{% for server in upstream.servers %}
  server {{ server }};
{% endfor %}
}
{% endfor %}
{% if tls_enabled and redirect_to_https %}
# HTTP -> HTTPS redirect (own server block)
server {
  listen 80;
{% if listen_ipv6 %}
  listen [::]:80;
{% endif %}
  server_name {{ server_name }};
  return 301 https://{{ server_name }}$request_uri;
}
{% endif %}
server {
{% if tls_enabled %}
  listen 443 ssl;
{% if listen_ipv6 %}
  listen [::]:443 ssl;
{% endif %}
{% if http2|default(true) %}
  http2 on;
{% endif %}
  ssl_certificate {{ ssl_certificate }};
  ssl_certificate_key {{ ssl_certificate_key }};
  ssl_protocols {{ ssl_protocols|default('TLSv1.2 TLSv1.3') }};
{% if ssl_ciphers|default('') %}
  ssl_ciphers {{ ssl_ciphers }};
  ssl_prefer_server_ciphers off;
{% endif %}
{% if hsts|default(false) %}
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
{% endif %}
{% else %}
  listen {{ listen_port }};
{% if listen_ipv6 %}
  listen [::]:{{ listen_port }};
{% endif %}
{% endif %}
  server_name {{ server_name }};

  root {{ root }};
  index {{ index_files|default('index.html index.htm') }};
{% if directory_browsing|default(false) %}
  autoindex on;
{% endif %}
{% if client_max_body_size|default('') %}
  client_max_body_size {{ client_max_body_size }};
{% endif %}
{% if access_log|default('') %}
  access_log {{ access_log }};
{% endif %}
{% if error_log|default('') %}
  error_log {{ error_log }};
{% endif %}
{% if compression|default(false) %}
  gzip on;
  gzip_vary on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
{% endif %}
{% for e in error_pages|default([]) %}
  error_page {{ e.code }} {{ e.uri }};
{% endfor %}
{% for h in response_headers|default([]) %}
  add_header {{ h.name }} "{{ h.value }}" always;
{% endfor %}

{% for loc in locations %}
  location {{ loc.path }} {
{% if loc.proxy_pass %}
    proxy_pass {{ loc.proxy_pass }};
{% endif %}
{% if loc.try_files %}
    try_files {{ loc.try_files }};
{% endif %}
{% if loc.extra %}
    {{ loc.extra|indent(4) }}
{% endif %}
  }
{% endfor %}
{% if extra_server_parameters %}
  {{ extra_server_parameters|indent(2) }}
{% endif %}
}
