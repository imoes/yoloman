{
  "compression_threads": 4,
  "checksum": 1,
  "ssd_optimization": 1,
  "block_size": 4096,
  "compression_type": "zstd",
  "delayed_alloc": 1,
  "mount_options": [
    "noatime",
    "compress=zstd:1"
  ],
  "scrub_interval_hours": 168,
  "auto_balance": 0,
  "auto_balance_threshold": 80,
  "max_stripes": 0,
  "default_raid_profile": "single",
  "metadata_dup": 0,
  "env_vars": []
}
