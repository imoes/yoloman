# Configuration for mdp (markdown presentation tool)
# This file sets environment variables that control the appearance of
# list markers in MDP presentations. See mdp(1) man page for details.
# These defaults are self-documenting via schema descriptions.

# MDP_LIST_OPEN1: Character used for the bullet point in the first level of unordered lists.
# Default: ' | '
export MDP_LIST_OPEN1={{ list_open_1|default(' | ') }}

# MDP_LIST_OPEN2: Character used for the bullet point in the second level of unordered lists.
# Default: ' | '
export MDP_LIST_OPEN2={{ list_open_2|default(' | ') }}

# MDP_LIST_OPEN3: Character used for the bullet point in the third level of unordered lists.
# Default: ' | '
export MDP_LIST_OPEN3={{ list_open_3|default(' | ') }}

# MDP_LIST_HEAD1: Character used for the list head marker in the first level of unordered lists.
# Default: ' +- '
export MDP_LIST_HEAD1={{ list_head_1|default(' +- ') }}

# MDP_LIST_HEAD2: Character used for the list head marker in the second level of unordered lists.
# Default: ' +- '
export MDP_LIST_HEAD2={{ list_head_2|default(' +- ') }}

# MDP_LIST_HEAD3: Character used for the list head marker in the third level of unordered lists.
# Default: ' +- '
export MDP_LIST_HEAD3={{ list_head_3|default(' +- ') }}