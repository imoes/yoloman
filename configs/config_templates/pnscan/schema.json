{
  "target": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Target IP address or CIDR range to scan."
  },
  "ports": {
    "type": "string",
    "default": "80",
    "description": "Port range or specific port to scan."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output."
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Print internal debugging info."
  },
  "resolve_hostnames": {
    "type": "bool",
    "default": false,
    "description": "Lookup and print hostnames (slows down scan)."
  },
  "shutdown_mode": {
    "type": "bool",
    "default": false,
    "description": "Enable shutdown mode (half-close TCP connection)."
  },
  "line_oriented_output": {
    "type": "bool",
    "default": false,
    "description": "Line oriented output."
  },
  "request_string": {
    "type": "string",
    "default": "",
    "description": "Request string to send."
  },
  "response_string": {
    "type": "string",
    "default": "",
    "description": "Response string to look for."
  },
  "max_response_bytes": {
    "type": "number",
    "default": 0,
    "description": "Max bytes of response to print (0 means no limit)."
  },
  "timeout": {
    "type": "number",
    "default": 1000,
    "description": "Connect/Write/Read timeout in milliseconds."
  },
  "workers": {
    "type": "number",
    "default": 100,
    "description": "Maximum concurrent worker threads."
  }
}
