# ladvd configuration file
# Global settings for the Link Advertisement Daemon.
[global]

# Globally enable/disable ladvd packet transmission.
# If false, ladvd runs but does not send discovery packets.
enabled = {{ enabled | default(true) }}

# List of network interfaces to monitor and send CDP/LLDP announcements on.
# Provide as a YAML list; rendered as a comma-separated string.
interfaces = {{ interfaces | default(['eth0']) | join(', ') }}

# CDP (Cisco Discovery Protocol) options.
# CDP is a proprietary Layer 2 protocol used primarily with Cisco devices.

# Enable CDP packet transmission.
cdp_enabled = {{ cdp_enabled | default(true) }}

# Interval (in seconds) between CDP announcements.
cdp_timer = {{ cdp_timer | default(30) }}

# Holdtime multiplier for CDP.
# Actual holdtime = cdp_timer * cdp_hold_multiplier.
cdp_hold_multiplier = {{ cdp_hold_multiplier | default(4) }}

# MAC address to use as source for CDP packets.
# Leave empty or use '00:00:00:00:00:00' to auto-detect from the interface.
cdp_mac = {{ cdp_mac | default('00:00:00:00:00:00') }}

# LLDP (Link Layer Discovery Protocol) options.
# LLDP is an open standard Layer 2 protocol.

# Enable LLDP packet transmission.
lldp_enabled = {{ lldp_enabled | default(true) }}

# Interval (in seconds) between LLDP announcements.
lldp_timer = {{ lldp_timer | default(30) }}

# Holdtime multiplier for LLDP.
# Actual holdtime = lldp_timer * lldp_hold_multiplier.
lldp_hold_multiplier = {{ lldp_hold_multiplier | default(4) }}

# MAC address to use as source for LLDP packets.
# Leave empty or use '00:00:00:00:00:00' to auto-detect from the interface.
lldp_mac = {{ lldp_mac | default('00:00:00:00:00:00') }}

# VLAN discovery options (IEEE 802.1Q).
# These settings are primarily relevant for Cisco-centric environments using CDP.

# Enable IEEE 802.1Q VLAN discovery via CDP.
vlan_enabled = {{ vlan_enabled | default(false) }}

# Automatically configure trunk VLANs on the switch port when VLAN discovery is enabled.
vlan_auto = {{ vlan_auto | default(false) }}

# Format of the port description field sent in announcements.
# Use 'hostname' to insert the system hostname, or a custom string.
port_desc = {{ port_desc | default('hostname') }}

# Type-of-Service (TOS) byte for outgoing packets.
# Range 0–255. Default 192 (0xC0) sets IP precedence to 6 (Network Control).
tos = {{ tos | default(192) }}

# Logging verbosity level.
# Valid values: debug, info, notice, warning, error, critical.
log_level = {{ log_level | default('info') }}

# Path to write the process PID file.
# Ensures the daemon can be managed correctly by init systems.
pidfile = {{ pidfile | default('/var/run/ladvd.pid') }}

# Override chassis ID sent in announcements.
# Leave empty to auto-generate from the MAC address of the first interface.
chassis_id = {{ chassis_id | default('') }}