# ladvd configuration file
# Enable or disable CDP/LLDP packet transmission
[global]
enabled = {{ enabled }}

# Network interfaces to monitor and announce on
# List of interfaces to process (comma-separated or one per line)
interfaces = {{ interfaces | join(', ') }}

# CDP-specific options
cdp_enabled = {{ cdp_enabled }}
cdp_timer = {{ cdp_timer }}
cdp_hold_multiplier = {{ cdp_hold_multiplier }}
cdp_mac = {{ cdp_mac | default('00:00:00:00:00:00') }}

# LLDP-specific options
lldp_enabled = {{ lldp_enabled }}
lldp_timer = {{ lldp_timer }}
lldp_hold_multiplier = {{ lldp_hold_multiplier }}
lldp_mac = {{ lldp_mac | default('00:00:00:00:00:00') }}

# VLAN discovery (optional)
vlan_enabled = {{ vlan_enabled }}
vlan_auto = {{ vlan_auto }}

# Port description format
port_desc = {{ port_desc }}

# TOS/DSCP for outgoing packets
tos = {{ tos }}

# Logging level: debug, info, notice, warning, error, critical
log_level = {{ log_level }}

# PID file location
pidfile = {{ pidfile }}

# Optional custom chassis ID (default: MAC of first interface)
# chassis_id = {{ chassis_id }}
