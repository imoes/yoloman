# Enable or disable sysstat collection
SAVED_STATISTICS={{ enabled }}

# Interval (in seconds) between data collections
SAVED_INTERVAL={{ collection_interval }}

# Number of days to keep daily activity logs
SAVED_HISTORY={{ history_days }}

# Enable or disable compression of old logs
SAVED_COMPRESS={{ compress_logs }}

# Enable or disable rotation of logs
SAVED_ROTATE={{ rotate_logs }}

# Additional options passed to sar when invoked by the cron job
SAVED_SAR_OPTIONS='{{ sar_options }}'

# List of system activities to collect
{% for activity in activities %}{{ activity }}={{ 'true' if enabled else 'false' }}
{% endfor %}
