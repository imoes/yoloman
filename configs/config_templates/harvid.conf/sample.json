{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "max_connections": 50,
    "ssl_enabled": true,
    "certificate_path": "/etc/harvid/ssl/fullchain.pem",
    "key_path": "/etc/harvid/ssl/privkey.pem"
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/harvid/harvid.log",
    "json": true
  },
  "worker": {
    "threads": 2
  },
  "storage": {
    "segments_path": "/var/cache/harvid/segments"
  },
  "playlist": {
    "hls_enabled": true,
    "hls_segment_duration": 2,
    "hls_playlist_length": 5
  },
  "sources": [
    {
      "url": "rtsp://192.168.1.10:554/stream1",
      "name": "Front Door Cam",
      "type": "camera"
    },
    {
      "url": "file:///media/loops/sample.mp4",
      "name": "Fallback Loop"
    }
  ]
}
