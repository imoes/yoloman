{
  "tomb_path": "/var/lib/tomb/secrets.tomb",
  "tomb_key_path": "/etc/tomb/secrets.tomb.key",
  "tomb_size": 2048,
  "luks_cipher": "aes-xts-plain64",
  "filesystem_type": "ext4",
  "mount_options": "rw,noatime,nodev",
  "use_gpg_key": true,
  "gpg_recipients": [
    "user@example.com",
    "admin@example.com"
  ],
  "kdf_iter_time": 10,
  "kdf_type": "argon2",
  "kdf_mem": 18,
  "privilege_escalation_tool": "pkexec",
  "sphinx_user": "tombuser",
  "sphinx_host": "sphinx.dyne.org",
  "no_color": true,
  "force": false,
  "bind_hooks": [
    {
      "tomb_path": ".gnupg",
      "home_path": ".gnupg"
    },
    {
      "tomb_path": "mail",
      "home_path": "mail"
    }
  ]
}
