# Tomb configuration file
# Generated by Ansible Jinja2 template
# This file controls the behavior of the `tomb` utility for managing encrypted volumes.

# Path to the encrypted tomb storage file.
# This is the actual LUKS container that will be opened/closed.
# Default: /var/lib/tomb/secret.tomb
TOMB_PATH: {{ tomb_path | default('/var/lib/tomb/secret.tomb') }}

# Path to the key file used to open the tomb.
# This file contains either the password or the GPG-encrypted key material.
# Default: /etc/tomb/secret.tomb.key
TOMB_KEY_PATH: {{ tomb_key_path | default('/etc/tomb/secret.tomb.key') }}

# Initial size of the tomb in megabytes (MiB).
# Used by the 'dig' (create) or 'resize' commands to set the container size.
# Default: 128
TOMB_SIZE: {{ tomb_size | default(128) }}

# LUKS encryption cipher specification.
# Supported values include: aes-xts-plain64, aes-cbc-essiv:sha256, serpent-xts-plain64.
# aes-xts-plain64 is recommended for modern drives.
# Default: aes-xts-plain64
LUKS_CIPHER: {{ luks_cipher | default('aes-xts-plain64') }}

# Filesystem type to format the tomb volume with after opening.
# Supported types: ext3, ext4, btrfs, btrfsmixedmode, ext3maxinodes, ext4maxinodes.
# Default: ext4
FILESYSTEM_TYPE: {{ filesystem_type | default('ext4') }}

# Mount options for the opened tomb volume.
# These options are passed to the mount command.
# Default: rw,noatime,nodev
MOUNT_OPTIONS: {{ mount_options | default('rw,noatime,nodev') }}

# Enable GPG asymmetric encryption for the tomb key.
# If true, the tomb key is encrypted with the GPG recipient's public key instead of a plain password.
# Default: false
USE_GPG_KEY: {{ use_gpg_key | default(false) }}

# List of GPG key IDs (user IDs or key fingerprints) for key encryption.
# Only used if use_gpg_key is true. If empty, falls back to symmetric password.
# Format: comma-separated string of key IDs.
# Default: empty list
GPG_RECIPIENTS: {{ gpg_recipients | default([]) | join(',') }}

# KDF (Key Derivation Function) iteration time multiplier.
# Increases security against dictionary attacks by increasing computation time.
# Measured in millions of seconds (approx). Higher is safer but slower.
# Default: 5
KDF_ITER_TIME: {{ kdf_iter_time | default(5) }}

# KDF algorithm type.
# Choices: pbkdf2 (fast, compatible), argon2 (memory-hard, more secure against ASICs).
# Default: pbkdf2
KDF_TYPE: {{ kdf_type | default('pbkdf2') }}

# RAM size for argon2 KDF algorithm (2^k KB).
# Only relevant if kdf_type is 'argon2'. Default 18 means 2^18 KB = 256 MiB.
# Adjust based on available system memory.
# Default: 18
KDF_MEM: {{ kdf_mem | default(18) }}

# Privilege escalation tool to use for root operations.
# Choices: sudo, pkexec, doas, sup, sud.
# Default: sudo
PRIVILEGE_ESCALATION_TOOL: {{ privilege_escalation_tool | default('sudo') }}

# Username for SPHINX PAKE (Password-Authenticated Key Exchange) feature.
# Used for remote key exchange protocols. Empty string disables if not needed.
# Default: ''
SPHINX_USER: {{ sphinx_user | default('') }}

# Host domain for SPHINX PAKE feature.
# Used for remote key exchange protocols. Empty string disables if not needed.
# Default: ''
SPHINX_HOST: {{ sphinx_host | default('') }}

# Suppress colors in console output.
# Useful for logging or non-interactive environments.
# Default: false
NO_COLOR: {{ no_color | default(false) }}

# Force operations, overriding swap checks and other safety warnings.
# Use with caution.
# Default: false
FORCE: {{ force | default(false) }}

# Bind hooks configuration.
# List of maps containing 'tomb_path' and 'home_path' relative strings.
# These paths are bind-mounted from the tomb to the user's home directory upon opening.
# Example hook:
#   tomb_path: 'docs'
#   home_path: 'documents/tomb_docs'
BIND_HOOKS:
{% for hook in bind_hooks | default([]) %}
{{ hook.tomb_path }} {{ hook.home_path }}
{% endfor %}