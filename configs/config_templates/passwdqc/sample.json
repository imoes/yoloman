{
  "enabled": true,
  "min_length": "disabled:14:11:6",
  "max_length": 40,
  "similar": 2,
  "dictionary_path": "/usr/share/dict/words",
  "reject_user_name": true,
  "unique_chars": 6,
  "remember_count": 5,
  "old_passwords_path": "/etc/security/opasswd",
  "allow_blank": false,
  "retry_limit": 1,
  "extra_options": [
    {
      "kw": "enforce_for_root",
      "val": "off"
    },
    {
      "kw": "passminlen",
      "val": "8"
    }
  ]
}
