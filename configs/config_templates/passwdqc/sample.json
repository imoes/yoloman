{
  "enabled": true,
  "min_length": "disabled,24,11,8,7",
  "max_length": 72,
  "min_passphrase_length": 3,
  "min_match_length": 4,
  "similar": "deny",
  "min_random_length": 47,
  "enforce_for": "everyone",
  "retry_limit": 3,
  "wordlist_path": "/usr/share/john/password.lst",
  "denylist_path": "/etc/passwdqc.deny",
  "filter_path": "/opt/passwdqc/hibp.pwq",
  "reject_user_name": true,
  "unique_chars": 0,
  "remember_count": 5,
  "old_passwords_path": "/etc/security/opasswd",
  "allow_blank": false,
  "extra_options": []
}
