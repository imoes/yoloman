# passwdqc main configuration file — see passwdqc.conf(5)
# Enable/disable passwdqc checks (on = enforce, off = audit-only)
enabled={{ enabled }}

# Minimum lengths for different password types
min={{ min_length }}

# Maximum lengths for different password types (0 = unlimited)
max={{ max_length }}

# Require characters from each category (order: upper, lower, digit, other)
# Category requirements are expressed as number of different classes needed
similar={{ similar }}

# Reject words from dictionary (file path or 'none')
dictionary={{ dictionary_path }}

# Reject passwords containing user name or gecos fields
reject_user_name={{ reject_user_name }}

# Require at least this many unique characters in password
unique={{ unique_chars }}

# Number of remembered passwords (for history check, 0 = disabled)
remember={{ remember_count }}

# Path to the hashed password history file
old={{ old_passwords_path }}

# Allow blank passwords (on = allow, off = deny)
allow_blank={{ allow_blank }}

# Retry limit for authentication attempts (0 = no limit)
retry={{ retry_limit }}

# Optional: extra keyword=value pairs for advanced tuning
{% for kw, val in extra_options %}{{ kw }}={{ val }}{% if not loop.last %}
{% endif %}{% endfor %}
