{
  "loglevel": "info",
  "plugin_dir": "/usr/lib/nbdkit/plugins",
  "threads": 8,
  "maxconnections": 128,
  "idle_timeout": 600,
  "plugin_sections": [
    {
      "name": "file",
      "options": {
        "path": "/var/lib/nbdkit/images/disk1.qcow2",
        "readonly": "false"
      }
    },
    {
      "name": "curl",
      "options": {
        "url": "http://storage.example.com/images/disk2.raw",
        "readonly": "true",
        "proxy": "http://proxy.local:3128"
      }
    }
  ]
}
