# The English comment for the application.
Comment={{ comment | default('GTK+ Clipboard Manager') }}

# The icon name for the application.
Icon={{ icon | default('diodon') }}

# Semicolon-separated list of desktop environments where this application should not be shown.
NotShowIn={{ not_show_in | default('KDE;') }}

# The command line to execute to start the application.
Exec={{ exec | default('diodon') }}

# Whether the application should be run in a terminal.
Terminal={{ terminal | default(false) | lower }}

# Semicolon-separated list of categories for the application.
Categories={{ categories | default('GTK;GNOME;Utility;') }}

# Whether to show startup notification.
StartupNotify={{ startup_notify | default(false) | lower }}

# Semicolon-separated list of MIME types the application can handle.
MimeType={{ mime_type | default('x-scheme-handler/clipboard;') }}