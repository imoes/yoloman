# URL to access the JetS3t Gatekeeper servlet implementation.
# This URL is used to authorize and sign requests on behalf of the client.
# Default: http://localhost:8080/gatekeeper-0.8.1/GatekeeperServlet
gatekeeperUrl={{ gatekeeperUrl | default('http://localhost:8080/gatekeeper-0.8.1/GatekeeperServlet') }}

# The named skin implementation/package to use for the UI.
# Commented out by default; uncomment and set to enable a specific skin.
# Default: html
#skin.name={{ skin_name | default('html') }}

# Example of configurable login fields. Login is not required by default.

# Field 0: Welcome Message
# Displays an HTML message to the user upon login.
field.0.name=WelcomeMessage
field.0.prompt=<html>Welcome to <b>Cockpit Lite</b><br><br>Please ensure your Gatekeeper service is configured and running before attempting to log in.</html>
field.0.type=message

# Field 1: Username Input (Optional/Commented out)
# Uncomment these lines to enable the username field in the login form.
# The default value is used if the user leaves the field empty.
#field.1.name=UserName
#field.1.prompt=User Name
#field.1.type=text
#field.1.default={{ login_username_default | default('anonymous') }}

# Field 2: Password Input (Optional/Commented out)
# Uncomment these lines to enable the password field in the login form.
# The default value is used if the user leaves the field empty.
#field.2.name=Password
#field.2.prompt=Password
#field.2.type=password
#field.2.default={{ login_password_default | default('') }}