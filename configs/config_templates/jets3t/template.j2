# URL to access the JetS3t Gatekeeper servlet implementation.
# This servlet will authorize and sign all requests on behalf of Cockpit Lite.
gatekeeperUrl={{ gatekeeperUrl | default('http://localhost:8080/gatekeeper-0.8.1/GatekeeperServlet') }}

# The named skin implementation/package to use.
# Leave empty or commented out if not specified.
{% if skin_name | default('') %}
skin.name={{ skin_name }}
{% else %}
#skin.name=html
{% endif %}

# Example of configurable login fields. Login is not required by default.

# Field 0: Welcome Message
field.0.name=WelcomeMessage
field.0.prompt=<html>Welcome to <b>Cockpit Lite</b><br><br>Please ensure your Gatekeeper service is configured and running before attempting to log in.</html>
field.0.type=message

# Field 1: Username
#field.1.name=UserName
#field.1.prompt=User Name
#field.1.type=text
{% if login_username_default | default('') %}
field.1.default={{ login_username_default }}
{% else %}
#field.1.default=anonymous
{% endif %}

# Field 2: Password
#field.2.name=Password
#field.2.prompt=Password
#field.2.type=password
{% if login_password_default | default('') %}
field.2.default={{ login_password_default }}
{% else %}
#field.2.default=
{% endif %}