{
  "root": true,
  "end_of_line": "lf",
  "charset": "utf-8",
  "trim_trailing_whitespace": true,
  "insert_final_newline": true,
  "sections": [
    {
      "pattern": "*.py",
      "indent_style": "space",
      "indent_size": 4,
      "tab_width": 4,
      "description": "Python files"
    },
    {
      "pattern": "*.{js,ts,jsx,tsx}",
      "indent_style": "space",
      "indent_size": 2,
      "tab_width": 2,
      "description": "JavaScript and TypeScript files"
    },
    {
      "pattern": "*.md",
      "trim_trailing_whitespace": false,
      "indent_style": "space",
      "indent_size": 2,
      "description": "Markdown files (preserve trailing spaces for line breaks)"
    },
    {
      "pattern": "Makefile",
      "indent_style": "tab",
      "description": "Makefiles use tabs"
    },
    {
      "pattern": "lib/**/*.js",
      "indent_style": "space",
      "indent_size": 2,
      "description": "JavaScript files under lib directory"
    },
    {
      "pattern": "{package.json,.travis.yml}",
      "indent_style": "space",
      "indent_size": 2,
      "description": "package.json and .travis.yml files"
    },
    {
      "pattern": "config/*.yml",
      "indent_size": "unset",
      "description": "YAML config files: unset indent_size so editor default is used"
    }
  ]
}
