{
  "identity_cert_path": "/etc/myproxy-server/servercert.pem",
  "identity_key_path": "/etc/myproxy-server/serverkey.pem",
  "cacert_dir": "/etc/grid-security/certificates",
  "ca_cert_path": "/etc/grid-security/certificates/$(HASH).r0",
  "ca_revocation_list_path": "/etc/grid-security/certificates/$(HASH).r0",
  "listen_address": "0.0.0.0",
  "listen_port": 7512,
  "credential_lifetime_hours": 168,
  "renewal_threshold_hours": 24,
  "authorized_users": [
    "*"
  ],
  "authorized_groups": [
    "myproxy-users"
  ],
  "log_level": "info",
  "log_file": "/var/log/myproxy-server.log",
  "require_proxy_cert": true,
  "enforce_renewal": false,
  "working_dir": "/var/lib/myproxy",
  "enable_gridftp": true,
  "gridftp_port": 50000,
  "num_threads": 8,
  "allowed_vos": [
    {
      "name": "lhcb",
      "dn": "/O=Grid/OU=CERN/CN=CERN Grid CA"
    },
    {
      "name": "atlas"
    }
  ],
  "max_credentials_per_user": 100,
  "cleanup_interval_seconds": 7200
}
