{
  "output_dir": "/var/lib/supermin/appliance",
  "packages": [
    "bash",
    "coreutils",
    "util-linux"
  ],
  "packager_config": "/etc/yum.conf",
  "use_installed": false,
  "build_format": "ext2",
  "build_output_dir": "/var/lib/supermin/appliance_output",
  "ext2_size": "2G",
  "kernel_path": "/boot/vmlinuz-5.15.0",
  "modules_path": "/lib/modules/5.15.0",
  "host_files": [
    "/etc/yum.repos.d/*.repo"
  ],
  "exclude_patterns": [
    "/usr/share/doc/*",
    "/usr/share/man/*"
  ],
  "verbose": true
}
