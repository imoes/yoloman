# ==============================================================================
# Supermin appliance build script template
# Generates a bash script to create minimal containers/appliances using supermin.
#
# This template is self-documenting: every configurable variable is annotated
# with its schema description, default value, and runtime behavior.
# ==============================================================================

#!/bin/bash
# Supermin appliance build script generated by Ansible Jinja2
set -e

# -----------------------------------------------------------------------------
# Configuration Variables
# -----------------------------------------------------------------------------

# Output directory for the prepared supermin appliance
# Schema: output_dir (string)
# Default: /tmp/supermin.d
# Description: Base directory where supermin stores its intermediate state (prepares/).
# -----------------------------------------------------------------------------
OUTPUT_DIR="{{ output_dir | default('/tmp/supermin.d') }}"

# List of packages to include in the appliance
# Schema: packages (list of strings)
# Default: []
# Description: RPM/Debian packages to bundle. Dependencies are resolved automatically.
# -----------------------------------------------------------------------------
PACKAGES=(
{% for pkg in packages | default([]) %}
  "{{ pkg }}"
{% endfor %}
)

# Path to the package manager configuration file (e.g., yum.conf or pacman.conf)
# Schema: packager_config (string)
# Default: '' (empty disables)
# Description: If non-empty, passed to supermin via --packager-config.
# -----------------------------------------------------------------------------
PACKAGER_CONFIG="{{ packager_config | default('') }}"

# Whether to use locally installed packages instead of downloading
# Schema: use_installed (boolean)
# Default: False
# Description: If true, adds --use-installed to the prepare command.
# -----------------------------------------------------------------------------
USE_INSTALLED="{{ use_installed | default(false) | lower }}"

# Output format for the built appliance: chroot or ext2
# Schema: build_format (string)
# Default: ext2
# Description: Target format. 'chroot' creates a directory, 'ext2' creates a disk image.
# -----------------------------------------------------------------------------
BUILD_FORMAT="{{ build_format | default('ext2') }}"

# Output directory for the final built appliance
# Schema: build_output_dir (string)
# Default: '' (uses output_dir)
# Description: If empty, the build output goes into OUTPUT_DIR.
# -----------------------------------------------------------------------------
BUILD_OUTPUT_DIR="{{ build_output_dir | default('') }}"

# Size of the ext2 filesystem image (e.g., '4G', '10G')
# Schema: ext2_size (string)
# Default: 4G
# Description: Only applies when build_format is 'ext2'. Passed via --size.
# -----------------------------------------------------------------------------
EXT2_SIZE="{{ ext2_size | default('4G') }}"

# Path to a custom kernel image
# Schema: kernel_path (string)
# Default: '' (auto-select host kernel)
# Description: If non-empty, exported as SUPERMIN_KERNEL environment variable.
# -----------------------------------------------------------------------------
KERNEL_PATH="{{ kernel_path | default('') }}"

# Path to the kernel modules directory
# Schema: modules_path (string)
# Default: '' (auto-select host modules)
# Description: If non-empty, exported as SUPERMIN_MODULES environment variable.
# -----------------------------------------------------------------------------
MODULES_PATH="{{ modules_path | default('') }}"

# List of host file paths to include in the appliance (wildcards allowed)
# Schema: host_files (list of strings)
# Default: []
# Description: Files from the host system to inject into the appliance.
# -----------------------------------------------------------------------------
HOST_FILES=(
{% for hf in host_files | default([]) %}
  "{{ hf }}"
{% endfor %}
)

# List of patterns to exclude from the final appliance
# Schema: exclude_patterns (list of strings)
# Default: []
# Description: Glob patterns to exclude. Written to the exclude list with a leading '-'.
# -----------------------------------------------------------------------------
EXCLUDE_PATTERNS=(
{% for pat in exclude_patterns | default([]) %}
  "{{ pat }}"
{% endfor %}
)

# Enable verbose output (-v)
# Schema: verbose (boolean)
# Default: False
# Description: If true, adds -v flag to the build command for detailed logging.
# -----------------------------------------------------------------------------
VERBOSE="{{ verbose | default(false) | lower }}"

# -----------------------------------------------------------------------------
# Execution Logic
# -----------------------------------------------------------------------------

# Create temporary directory for preparation if not exists
mkdir -p "${OUTPUT_DIR}"

echo "Preparing supermin appliance in ${OUTPUT_DIR}..."

# Construct prepare command
PREPARE_CMD=(supermin --prepare -o "${OUTPUT_DIR}")

# Add custom packager configuration if specified
# Schema: packager_config
{% if packager_config | default('') %}
PREPARE_CMD+=(--packager-config "${PACKAGER_CONFIG}")
{% endif %}

# Use installed packages from local filesystem
# Schema: use_installed
{% if use_installed | default(false) %}
PREPARE_CMD+=(--use-installed)
{% endif %}

# Add packages to prepare command
for pkg in "${PACKAGES[@]}"; do
  PREPARE_CMD+=("${pkg}")
done

# Execute prepare step
"${PREPARE_CMD[@]}"

# Handle host files if specified
# Schema: host_files
{% if host_files | default([]) | length > 0 %}
echo "Adding host files to appliance..."
HOSTFILE_PATH="${OUTPUT_DIR}/custom-hostfiles"
for hf in "${HOST_FILES[@]}"; do
  echo "${hf}" >> "${HOSTFILE_PATH}"
done
{% endif %}

# Handle exclude patterns if specified
# Schema: exclude_patterns
{% if exclude_patterns | default([]) | length > 0 %}
echo "Adding exclude patterns to appliance..."
EXCLUDE_PATH="${OUTPUT_DIR}/custom-excludefiles"
for pat in "${EXCLUDE_PATTERNS[@]}"; do
  echo "-${pat}" >> "${EXCLUDE_PATH}"
done
{% endif %}

echo "Preparing build command for format ${BUILD_FORMAT}..."

# Construct build command
BUILD_CMD=(supermin --build -f "${BUILD_FORMAT}")

# Set output directory for build
# Schema: build_output_dir
# If empty, defaults to the prepared directory (OUTPUT_DIR)
{% if build_output_dir | default('') %}
BUILD_CMD+=(-o "${BUILD_OUTPUT_DIR}")
{% else %}
BUILD_CMD+=(-o "${OUTPUT_DIR}")
{% endif %}

# Add verbose flag if enabled
# Schema: verbose
{% if verbose | default(false) %}
BUILD_CMD+=(-v)
{% endif %}

# Add ext2 size if format is ext2 and size is specified
# Schema: build_format, ext2_size
{% if build_format | default('ext2') == 'ext2' and ext2_size | default('4G') %}
BUILD_CMD+=(--size "${EXT2_SIZE}")
{% endif %}

# Use custom kernel if specified
# Schema: kernel_path
# Exports SUPERMIN_KERNEL for supermin to locate the kernel image.
{% if kernel_path | default('') %}
export SUPERMIN_KERNEL="${KERNEL_PATH}"
{% endif %}

# Use custom modules if specified
# Schema: modules_path
# Exports SUPERMIN_MODULES for supermin to locate the kernel modules.
{% if modules_path | default('') %}
export SUPERMIN_MODULES="${MODULES_PATH}"
{% endif %}

# Execute build step
echo "Building appliance..."
"${BUILD_CMD[@]}" "${OUTPUT_DIR}"

echo "Appliance build complete."