{
  "listen_host": "0.0.0.0",
  "listen_port": 1965,
  "tls_cert_path": "/etc/molly-brown/tls/fullchain.pem",
  "tls_key_path": "/etc/molly-brown/tls/privkey.pem",
  "tls_enabled": true,
  "root_path": "/var/lib/molly-brown/root",
  "mime_types": {
    "gemini": "text/gemini",
    "gmi": "text/gemini",
    "txt": "text/plain",
    "md": "text/markdown",
    "png": "image/png",
    "jpg": "image/jpeg",
    "gif": "image/gif"
  },
  "vhosts": [
    {
      "hostname": "blog.gemini",
      "root": "/var/lib/molly-brown/vhosts/blog"
    },
    {
      "hostname": "docs.gemini",
      "root": "/var/lib/molly-brown/vhosts/docs"
    }
  ],
  "max_goroutines": 512,
  "max_connections": 1024,
  "log_file_path": "/var/log/molly-brown/access.log",
  "log_level": "info",
  "rate_limiting_enabled": true,
  "rate_limit_rps": 10,
  "directory_listing": false
}
