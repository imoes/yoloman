// When Apt's cache is updated (i.e. apt-get update)
// This hook runs after a successful 'apt-get update' to check for new versions.
// It invokes 'apt-show-versions -i' if the binary is available.
APT::Update::Post-Invoke-Success {
    // Execute the version check command.
    // If apt-show-versions is not installed (exit code non-zero), abort silently.
    "test -x /usr/bin/apt-show-versions || exit 0 ; apt-show-versions -i";
};
