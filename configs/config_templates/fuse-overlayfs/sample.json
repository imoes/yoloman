{
  "storage_root": "/home/john/.local/share/containers/storage",
  "storage_runroot": "/run/user/1000/containers",
  "additional_image_stores": [
    "/var/lib/shared/images"
  ],
  "max_layer_count": 128,
  "uidmap_host_id": 100000,
  "uidmap_size": 65536,
  "uidmap_container_offset": 100000,
  "uidmap_host_offset": 165536,
  "uidmap_size_offset": 65536,
  "gidmap_host_id": 100000,
  "gidmap_size": 65536,
  "gidmap_container_offset": 100000,
  "gidmap_host_offset": 165536,
  "gidmap_size_offset": 65536,
  "fuse_overlayfs_enabled": true,
  "log_level": "info",
  "mountopt": "",
  "workers": 4,
  "disable_vfs_fallback": false,
  "imagestore": "",
  "use_mount_program": true,
  "mount_program": "/usr/bin/fuse-overlayfs",
  "mountopt_fuse": [
    "allow_other",
    "uid=1000",
    "gid=1000",
    "max_buf_size=1048576"
  ]
