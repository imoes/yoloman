# Defaults for stun initscript
# sourced by /etc/init.d/stun
# installed at /etc/default/stun by the maintainer scripts

#
# This is a POSIX shell fragment
#

#uncommment the next line to allow the init.d script to start the stun daemon
#START_DAEMON=true

# Additional options that are passed to the Daemon.
# Default value is an empty string, allowing no extra arguments to be passed.
DAEMON_OPTS="{{ DAEMON_OPTS | default('') }}"

# The primary IP address for the STUN server to bind to.
# Default value is an empty string, meaning the server binds to all interfaces (0.0.0.0).
PRIMARY_IP="{{ PRIMARY_IP | default('') }}"

# The secondary IP address for the STUN server to bind to.
# Default value is an empty string, meaning no secondary binding is configured.
SECONDARY_IP="{{ SECONDARY_IP | default('') }}"

# The primary port for the STUN server.
# Default port is 3478, the standard port for STUN/TURN protocols.
PRIMARY_PORT={{ PRIMARY_PORT | default(3478) }}

# The secondary port for the STUN server.
# Default port is 3479, typically used for the secondary listener or fallback.
SECONDARY_PORT={{ SECONDARY_PORT | default(3479) }}

# whom the daemons should run as
# Default user is 'nobody', ensuring the service runs with minimal privileges.
DAEMON_USER="{{ DAEMON_USER | default('nobody') }}"