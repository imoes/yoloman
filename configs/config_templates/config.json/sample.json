{
  "cloudflare_email": "admin@example.com",
  "cloudflare_api_key": "v1.0-abcdef1234567890abcdef1234567890abcdef12",
  "domains": [
    {
      "name": "example.com",
      "records": [
        {
          "name": "@",
          "type": "A",
          "ttl": 1,
          "proxied": true
        },
        {
          "name": "www",
          "type": "A",
          "ttl": 300,
          "proxied": true
        },
        {
          "name": "mail",
          "type": "A",
          "ttl": 3600,
          "proxied": false
        }
      ]
    },
    {
      "name": "subdomain.example.com",
      "records": [
        {
          "name": "@",
          "type": "AAAA",
          "ttl": 120,
          "proxied": false
        }
      ]
    }
  ],
  "update_interval": 600,
  "debug": false
}
