# nullmailer status log template
# This template generates status log lines for nullmailer based on provided schema variables.
# Each variable is provided with its schema default to ensure safe rendering.

# Process ID of the nullmailer instance.
# Defaults to 0 if not specified.
nullmailer[{{ pid | default(0) }}]: Rescanning queue.

# Placeholder for trigger event.
nullmailer[{{ pid | default(0) }}]: Trigger pulled.

# Number of messages in the queue at the time of scanning.
# Defaults to 0 if not specified.
nullmailer[{{ pid | default(0) }}]: Starting delivery, {{ queue_count | default(0) }} message(s) in queue.

# SMTP protocol version or type used for delivery.
# The mail server host being connected to.
# Numeric identifier of the message file being delivered.
# Defaults: protocol='smtp', host='localhost', file_id=0
nullmailer[{{ pid | default(0) }}]: Starting delivery: protocol: {{ protocol | default('smtp') }} host: {{ host | default('localhost') }} file: {{ file_id | default(0) }}

# Placeholder for file sent event.
nullmailer[{{ pid | default(0) }}]: Sent file.

# Number of messages remaining in the queue after delivery completion.
# Defaults to 0 if not specified.
nullmailer[{{ pid | default(0) }}]: Delivery complete, {{ remaining_messages | default(0) }} message(s) remain.

# Placeholder for success indicator.
nullmailer[{{ pid | default(0) }}]: smtp: Succeeded:
