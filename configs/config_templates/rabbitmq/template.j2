## --------------------------------------------------------------------------
## RabbitMQ Configuration File (rabbitmq.conf)
## Generated by Ansible Jinja2 Template — Self-Documenting
## --------------------------------------------------------------------------
## NOTE: This file uses RabbitMQ's native .conf syntax (key = value).
## Variables are sourced from the Ansible inventory/role variables.
## Each variable reference includes its schema default to prevent render failures.
## --------------------------------------------------------------------------

## --------------------------------------------------------------------------
## Networking: AMQP TCP listener
## IP address the AMQP TCP listener binds to. Use 0.0.0.0 for all interfaces
## or a specific IP to restrict access.
## --------------------------------------------------------------------------
listeners.tcp.default = {{ (tcp_interface | default('0.0.0.0')) }}:{{ (tcp_port | default(5672)) }}

## --------------------------------------------------------------------------
## Heartbeat: keepalive interval in seconds
## Heartbeat interval in seconds. Connections idle longer than this are
## considered dead and closed. 0 disables heartbeats.
## --------------------------------------------------------------------------
heartbeat = {{ (heartbeat | default(60)) }}

## --------------------------------------------------------------------------
## Frame max: maximum AMQP frame payload size in bytes
## Increase for large messages; decrease to reduce per-connection memory use.
## --------------------------------------------------------------------------
frame_max = {{ (frame_max | default(131072)) }}

## --------------------------------------------------------------------------
## Channel max: maximum AMQP channels per connection
## Maximum number of AMQP channels per TCP connection. 0 means unlimited —
## always set a bound to prevent runaway clients.
## --------------------------------------------------------------------------
channel_max = {{ (channel_max | default(2047)) }}

## --------------------------------------------------------------------------
## Consumer timeout: unacknowledged delivery limit
## Milliseconds a delivered message may remain unacknowledged before
## RabbitMQ force-closes the consumer channel.
## --------------------------------------------------------------------------
consumer_timeout = {{ (consumer_timeout | default(1800000)) }}

## --------------------------------------------------------------------------
## Default virtual host
## Virtual host created automatically on first broker startup. Acts as the
## default namespace for queues and exchanges.
## --------------------------------------------------------------------------
default_vhost = {{ (default_vhost | default('/')) }}

## --------------------------------------------------------------------------
## Default administrator username
## Administrator username created on first startup. Rename or delete before
## exposing the broker to any network.
## --------------------------------------------------------------------------
default_user = {{ (default_user | default('guest')) }}

## --------------------------------------------------------------------------
## Password for the default administrator account
## Password for the default administrator account. Must be changed for any
## non-local deployment.
## --------------------------------------------------------------------------
default_pass = {{ (default_pass | default('guest')) }}

## --------------------------------------------------------------------------
## Loopback users: localhost-only access restriction
## Usernames that may only connect from localhost (127.0.0.1 or ::1).
## Remove the built-in guest entry after creating a named admin.
## --------------------------------------------------------------------------
{% for user in (loopback_users | default(['guest'])) %}
loopback_users.{{ user }} = true
{% endfor %}

## --------------------------------------------------------------------------
## Memory high watermark: flow control trigger
## Fraction of total RAM (0.0–1.0) at which RabbitMQ begins flow-controlling
## publishers. Lower values leave more headroom for the OS.
## --------------------------------------------------------------------------
vm_memory_high_watermark.relative = {{ (memory_high_watermark | default(0.4)) }}

## --------------------------------------------------------------------------
## Disk free limit: disk space protection
## Minimum free disk space (e.g. 50MB, 2GB) below which all publishers are
## blocked. Prevents the broker from filling the disk.
## --------------------------------------------------------------------------
disk_free_limit.absolute = {{ (disk_free_limit | default('50MB')) }}

## --------------------------------------------------------------------------
## Log directory
## Filesystem path where RabbitMQ writes log files. Must be writable by the
## rabbitmq OS user.
## --------------------------------------------------------------------------
log.dir = {{ (log_dir | default('/var/log/rabbitmq')) }}

## --------------------------------------------------------------------------
## Log level for the main log file
## Verbosity of the main log file. One of: debug, info, warning, error,
## critical, none.
## --------------------------------------------------------------------------
log.file.level = {{ (log_level | default('info')) }}

## --------------------------------------------------------------------------
## Management plugin: HTTP API and Web UI binding address
## IP address the management HTTP API and web UI listens on. Restrict to
## 127.0.0.1 unless the UI must be reached remotely.
## --------------------------------------------------------------------------
management.tcp.ip = {{ (management_bind_address | default('127.0.0.1')) }}

## --------------------------------------------------------------------------
## Management plugin: HTTP API and Web UI port
## TCP port for the RabbitMQ management HTTP API and browser-based UI.
## --------------------------------------------------------------------------
management.tcp.port = {{ (management_port | default(15672)) }}

## --------------------------------------------------------------------------
## TLS/SSL Configuration
## Only active when ssl_enabled is true. Enables an additional TLS listener
## for encrypted AMQP connections alongside (or instead of) the plain TCP
## listener.
## --------------------------------------------------------------------------
{% if ssl_enabled | default(False) | bool %}

## TLS listener: port for encrypted AMQP 0-9-1 connections
listeners.ssl.default = {{ (ssl_port | default(5671)) }}

## TLS CA bundle: PEM file containing trusted CA certificates used to verify
## client certificates.
ssl_options.cacertfile = {{ (ssl_cacertfile | default('/etc/rabbitmq/certs/ca.pem')) }}

## TLS server certificate: PEM file presented to connecting clients to prove
## server identity.
ssl_options.certfile = {{ (ssl_certfile | default('/etc/rabbitmq/certs/cert.pem')) }}

## TLS private key: PEM file for the private key paired with
## ssl_options.certfile.
ssl_options.keyfile = {{ (ssl_keyfile | default('/etc/rabbitmq/certs/key.pem')) }}

## TLS peer verification: verify_peer requires a valid client certificate;
## verify_none accepts any client.
ssl_options.verify = {{ (ssl_verify | default('verify_peer')) }}

## Reject TLS connections from clients that present no certificate
## (meaningful only when verify = verify_peer).
ssl_options.fail_if_no_peer_cert = {{ (ssl_fail_if_no_peer_cert | default(False)) | lower }}
{% endif %}

## --------------------------------------------------------------------------
## Cluster Configuration
## Used for static peer discovery in clustered deployments. Leave empty for
## standalone deployments.
## --------------------------------------------------------------------------
{% if (cluster_nodes | default([])) | length > 0 %}

## Cluster formation backend: classic_config uses a static list of known seed
## nodes for peer discovery.
cluster_formation.peer_discovery_backend = rabbit_peer_discovery_classic_config

## Cluster seed nodes used to bootstrap formation on first startup; list all
## nodes in the cluster by their Erlang node names (e.g. rabbit@hostname).
{% for node in (cluster_nodes | default([])) %}
cluster_formation.classic_config.nodes.{{ loop.index }} = {{ node }}
{% endfor %}
{% endif %}

## --------------------------------------------------------------------------
## MQTT Plugin Configuration
## Enable the MQTT plugin listener to accept MQTT 3.1/3.1.1 client connections
## (requires rabbitmq_mqtt plugin).
## --------------------------------------------------------------------------
{% if mqtt_enabled | default(False) | bool %}

## MQTT plugin: TCP port for MQTT 3.1/3.1.1 client connections
mqtt.listeners.tcp.default = {{ (mqtt_port | default(1883)) }}

## MQTT plugin: virtual host that MQTT clients are mapped to
mqtt.vhost = {{ (default_vhost | default('/')) }}
{% endif %}

## --------------------------------------------------------------------------
## STOMP Plugin Configuration
## Enable the STOMP plugin listener to accept STOMP text-protocol connections
## (requires rabbitmq_stomp plugin).
## --------------------------------------------------------------------------
{% if stomp_enabled | default(False) | bool %}

## STOMP plugin: TCP port for STOMP text-protocol client connections
stomp.listeners.tcp.1 = {{ (stomp_port | default(61613)) }}
{% endif %}