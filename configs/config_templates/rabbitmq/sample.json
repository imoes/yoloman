  "management_bind_address": "0.0.0.0",
  "management_port": 15672,
  "ssl_enabled": true,
  "ssl_port": 5671,
  "ssl_cacertfile": "/etc/rabbitmq/certs/ca.pem",
  "ssl_certfile": "/etc/rabbitmq/certs/rabbit.pem",
  "ssl_keyfile": "/etc/rabbitmq/certs/rabbit.key",
  "ssl_verify": "verify_peer",
  "ssl_fail_if_no_peer_cert": false,
  "cluster_nodes": [
    "rabbit@mq01.example.com",
    "rabbit@mq02.example.com",
    "rabbit@mq03.example.com"
  ],
  "mqtt_enabled": false,
  "mqtt_port": 1883,
  "stomp_enabled": false,
  "stomp_port": 61613
