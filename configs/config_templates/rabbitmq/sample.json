{
  "tcp_interface": "0.0.0.0",
  "tcp_port": 5672,
  "heartbeat": 60,
  "frame_max": 131072,
  "channel_max": 2047,
  "consumer_timeout": 1800000,
  "default_vhost": "/",
  "default_user": "admin",
  "default_pass": "str0ngBr0k3rPass!",
  "loopback_users": [
    "guest"
  ],
  "memory_high_watermark": 0.4,
