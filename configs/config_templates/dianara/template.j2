{# ============================================================================ #}
{# Dianara Client Configuration                                                   #}
{# ============================================================================ #}
{# This file configures the Dianara console client for the Pump.io federated      #}
{# social network. It supports multiple profiles via the `config_profile_name`.    #}
{# Generated by Ansible Jinja2 - DO NOT EDIT MANUALLY                              #}
{# ============================================================================ #}

{# Profile Identifier: Derives the config filename (e.g., 'conf' -> Dianara.conf) #}
{# Variable: config_profile_name (string, default 'conf')                         #}
[{{ config_profile_name | default('conf') | title }}]
# Dianara configuration for profile: {{ config_profile_name | default('conf') }}
# Generated via Jinja2 template

# ============================================================================ #
# General Settings                                                               #}
# ============================================================================

{# Debug Mode: Enable verbose logging (equivalent to --debug flag) #}
{# Variable: debug (boolean, default False)                                      #}
Debug={{ debug | default(false) | lower }}

{# No HTTPS: Force HTTP connections (useful for local testing or insecure proxies) #}
{# Variable: no_https (boolean, default False)                                   #}
NoHTTPS={{ no_https | default(false) | lower }}

{# Ignore SSL Errors: Proceed even if certificates are invalid (INSECURE) #}
{# Variable: ignore_ssl_errors (boolean, default False)                          #}
{# WARNING: Enabling this exposes you to MITM attacks. Only use for troubleshooting. #}
IgnoreSSLErrors={{ ignore_ssl_errors | default(false) | lower }}

{# Public Default: New posts are visible to 'public' by default #}
{# Variable: public_default (boolean, default True)                              #}
PublicDefault={{ public_default | default(true) | lower }}

{# HTTP Proxy: URL for outbound connections (e.g., http://proxy.local:8080) #}
{# Variable: proxy (string, default '')                                          #}
Proxy={{ proxy | default('') }}

# ============================================================================ #
# Server Configuration                                                           #}
# ============================================================================

{# Server URL: Base address of the Pump.io instance #}
{# Variable: server_url (string, default 'https://pump.io')                     #}
Server={{ server_url | default('https://pump.io') }}

{# WebFinger Domain: Domain part of the user's identity (e.g., 'example.com') #}
{# Variable: webfinger_domain (string, default 'pump.io')                       #}
WebfingerDomain={{ webfinger_domain | default('pump.io') }}

{# Username: Local part of the WebFinger ID (e.g., 'johndoe') #}
{# Variable: username (string, default '')                                       #}
Username={{ username | default('') }}

{# Access Token: OAuth or session token for authentication #}
{# Variable: access_token (string, default '')                                   #}
{# SECURITY: This token provides full access to the account. Keep this file secure. #}
AccessToken={{ access_token | default('') }}

# ============================================================================ #
# Appearance Settings                                                            #}
# ============================================================================

{# Posts Per Page: Number of timeline items to load per scroll/load event #}
{# Variable: posts_per_page (integer, default 30)                               #}
PostsPerPage={{ posts_per_page | default(30) }}

{# Auto Update Timelines: Background refresh of feed data #}
{# Variable: auto_update_timelines (boolean, default True)                      #}
AutoUpdateTimelines={{ auto_update_timelines | default(true) | lower }}

# ============================================================================ #
# Notifications                                                                  #}
# ============================================================================

{# Notifications Enabled: Turn on desktop/notification daemon alerts #}
{# Variable: notifications_enabled (boolean, default True)                      #}
NotificationsEnabled={{ notifications_enabled | default(true) | lower }}

{# Meanwhile Notifications: Alert for activities in the 'Meanwhile' feed       #}
{# Variable: meanwhile_notifications (boolean, default True)                    #}
MeanwhileNotifications={{ meanwhile_notifications | default(true) | lower }}

{# Notification Email: Address to receive notification emails (if supported)    #}
{# Variable: notification_email (string, default '')                            #}
NotificationEmail={{ notification_email | default('') }}

{# Filter Keywords: Comma-separated list of keywords to highlight or ignore     #}
{# Variable: filter_keywords (list of strings, default [])                      #}
FilterKeywords={{ filter_keywords | default([]) | join(',') }}

# ============================================================================ #
# Advanced / Metadata                                                            #}
# ============================================================================

{# Config Profile Name: Internal reference to this profile section              #}
{# Variable: config_profile_name (string, default 'conf')                       #}
ConfigProfile={{ config_profile_name | default('conf') }}

