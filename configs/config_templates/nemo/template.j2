# Nemo Configuration Template
# This template generates a GSettings override file for Nemo.
# Based on nemo(1) and GSettings schema org.nemo.preferences

# Override the default behavior for running as root
# Source: nemo(1) NOTE ON THE ROOT USER section
# If true, Nemo will bypass special root-restriction UI changes when run as root.
# Command: gsettings set org.nemo.preferences treat-root-as-normal {{ treat_root_as_normal|default(false) | lower }}
[treat_root_as_normal]
value={{ treat_root_as_normal|default(false) | lower }}
type=bool