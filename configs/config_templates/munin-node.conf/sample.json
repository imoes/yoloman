{
  "log_level": 3,
  "log_file": "/var/log/munin/munin-node.log",
  "pid_file": "/var/run/munin/munin-node.pid",
  "background": 1,
  "setsid": 1,
  "user": "root",
  "group": "root",
  "global_timeout": 600,
  "timeout": 30,
  "ignore_files": [
    "[\\#~]$",
    "DEADJOE$",
    "\\.bak$",
    "%$",
    "\\.dpkg-(tmp|new|old|dist)$",
    "\\.rpm(save|new)$",
    "\\.pod$"
  ],
  "host_name": "node1.example.org",
  "allow": [
    "^127\\.0\\.0\\.1$",
    "^::1$"
  ],
  "cidr_allow": [
    "192.0.2.0/24"
  ],
  "cidr_deny": [],
  "host": "127.0.0.1",
  "port": 4949
}
