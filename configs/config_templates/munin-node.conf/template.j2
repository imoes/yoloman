#
# munin-node configuration (munin-node.conf(5)): one `key value` per line, no sections.
# Written from the shipped file; every default reproduces it. The earlier template invented an INI layout
# ([main], [df], …) and munin-node refused it ("Line is not well formed ([)").
#

log_level {{ log_level | default(4) }}
log_file {{ log_file | default('/var/log/munin/munin-node.log') }}
pid_file {{ pid_file | default('/var/run/munin/munin-node.pid') }}

background {{ background | default(1) }}
setsid {{ setsid | default(1) }}

user {{ user | default('root') }}
group {{ group | default('root') }}

# This is the timeout for the whole transaction (seconds; munin's default is 900).
{% if global_timeout is defined and global_timeout is not none and global_timeout != '' %}global_timeout {{ global_timeout }}
{% else %}# global_timeout 900
{% endif %}
# This is the timeout for each plugin (seconds; munin's default is 60).
{% if timeout is defined and timeout is not none and timeout != '' %}timeout {{ timeout }}
{% else %}# timeout 60
{% endif %}
# Regexps for files to ignore
{% for pattern in ignore_files | default(['[\\#~]$', 'DEADJOE$', '\\.bak$', '%$', '\\.dpkg-(tmp|new|old|dist)$', '\\.rpm(save|new)$', '\\.pod$']) %}ignore_file {{ pattern }}
{% endfor %}
# Set this if the client doesn't report the correct hostname when telnetting to localhost, port 4949
{% if host_name is defined and host_name is not none and host_name != '' %}host_name {{ host_name }}
{% else %}#host_name localhost.localdomain
{% endif %}
# Addresses allowed to connect: regular expressions (Net::Server does not understand CIDR without Net::CIDR).
{% for re in allow | default(['^127\\.0\\.0\\.1$', '^::1$']) %}allow {{ re }}
{% endfor %}
# With the Net::CIDR perl module: a client must match any cidr_allow and no cidr_deny (a netmask is required).
{% for net in cidr_allow | default([]) %}cidr_allow {{ net }}
{% endfor %}{% for net in cidr_deny | default([]) %}cidr_deny {{ net }}
{% endfor %}
# Which address to bind to
host {{ host | default('*') }}

# And which port
port {{ port | default(4949) }}
