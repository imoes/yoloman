{
  "log_level": {
    "type": "number",
    "default": 4,
    "description": "Verbosity of the node's log (0\u20134)."
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/munin/munin-node.log",
    "description": "Log file."
  },
  "pid_file": {
    "type": "string",
    "default": "/var/run/munin/munin-node.pid",
    "description": "PID file."
  },
  "background": {
    "type": "number",
    "default": 1,
    "enum": [
      0,
      1
    ],
    "description": "Detach from the terminal (1) or not (0)."
  },
  "setsid": {
    "type": "number",
    "default": 1,
    "enum": [
      0,
      1
    ],
    "description": "Start a new session (1) or not (0)."
  },
  "user": {
    "type": "string",
    "default": "root",
    "description": "User the node runs as."
  },
  "group": {
    "type": "string",
    "default": "root",
    "description": "Group the node runs as."
  },
  "global_timeout": {
    "type": "number",
    "default": null,
    "description": "Timeout for the whole transaction in seconds (unset: munin's 900)."
  },
  "timeout": {
    "type": "number",
    "default": null,
    "description": "Timeout per plugin in seconds (unset: munin's 60)."
  },
  "ignore_files": {
    "type": "list",
    "default": [
      "[\\#~]$",
      "DEADJOE$",
      "\\.bak$",
      "%$",
      "\\.dpkg-(tmp|new|old|dist)$",
      "\\.rpm(save|new)$",
      "\\.pod$"
    ],
    "description": "Regular expressions of plugin file names to ignore."
  },
  "host_name": {
    "type": "string",
    "default": null,
    "description": "Host name the node reports (unset: the system's)."
  },
  "allow": {
    "type": "list",
    "default": [
      "^127\\.0\\.0\\.1$",
      "^::1$"
    ],
    "description": "Regular expressions of client addresses allowed to connect."
  },
  "cidr_allow": {
    "type": "list",
    "default": [],
    "description": "CIDR networks allowed (needs Net::CIDR), e.g. 192.0.2.0/24."
  },
  "cidr_deny": {
    "type": "list",
    "default": [],
    "description": "CIDR networks denied (needs Net::CIDR), e.g. 192.0.2.42/32."
  },
  "host": {
    "type": "string",
    "default": "*",
    "description": "Address to bind to (* = all)."
  },
  "port": {
    "type": "number",
    "default": 4949,
    "description": "TCP port."
  }
}
