# Deluge daemon configuration file
{
  "allow_remote": {{ allow_remote | default(false) | lower }},
  "copy_config_location": {{ copy_config_location | default(false) | lower }},
  "daemon_port": {{ daemon_port | default(58846) }},
  "dht_bootstrap_node": {% if dht_bootstrap_node %}"{{ dht_bootstrap_node }}"{% else %}null{% endif %},
  "enable_peer_exchange": {{ enable_peer_exchange | default(true) | lower }},
  "listen_interfaces": "{{ listen_interfaces | default('0.0.0.0') }}:{{ listen_port | default(58846) }}",
  "listen_port": {{ listen_port | default(58846) }},
  "log_append": {{ log_append | default(true) | lower }},
  "log_console_level": "{{ log_console_level | default('INFO') }}",
  "log_debug_to_file": {{ log_debug_to_file | default(false) | lower }},
  "log_file_level": "{{ log_file_level | default('INFO') }}",
  "log_filename": {% if log_filename %}"{{ log_filename }}"{% else %}null{% endif %},
  "max_active_downloading": {{ max_active_downloading | default(5) }},
  "max_active_limit": {{ max_active_limit | default(8) }},
  "max_active_seeding": {{ max_active_seeding | default(5) }},
  "max_connections_global": {{ max_connections_global | default(200) }},
  "max_connections_per_second": {{ max_connections_per_second | default(20) }},
  "max_download_speed_per_torrent": {{ max_download_speed_per_torrent | default(-1) }},
  "max_upload_speed_per_torrent": {{ max_upload_speed_per_torrent | default(-1) }},
  "max_upload_speed_global": {{ max_upload_speed_global | default(-1) }},
  "no_atime_to_file": {{ no_atime_to_file | default(false) | lower }},
  "random_port": {{ random_port | default(false) | lower }},
  "save_incomplete_to": {% if save_incomplete_to %}"{{ save_incomplete_to }}"{% else %}null{% endif %},
  "send_user_agent": {{ send_user_agent | default(true) | lower }},
  "share_ratio_limit": {{ share_ratio_limit | default(1.0) }},
  "seed_time_limit": {{ seed_time_limit | default(0) }},
  "seed_time_ratio_limit": {{ seed_time_ratio_limit | default(1.0) }},
  "seed_ranking_mode": "{{ seed_ranking_mode | default('none') }}",
  "seed_ranking_torrents": [{{ seed_ranking_torrents | join(', ') | default('') }}],
  "ssl_certfile": {% if ssl_certfile %}"{{ ssl_certfile }}"{% else %}null{% endif %},
  "ssl_keyfile": {% if ssl_keyfile %}"{{ ssl_keyfile }}"{% else %}null{% endif %},
  "start_daemon": {{ start_daemon | default(true) | lower }},
  "torrentfiles_location": {% if torrentfiles_location %}"{{ torrentfiles_location }}"{% else %}null{% endif %},
  "transfer_data_to_file": {{ transfer_data_to_file | default(false) | lower }},
  "upnp": {{ upnp | default(true) | lower }},
  "user": {% if user %}"{{ user }}"{% else %}null{% endif %},
  "webui_port": {{ webui_port | default(8112) }},
  "webui_ssl_certfile": {% if webui_ssl_certfile %}"{{ webui_ssl_certfile }}"{% else %}null{% endif %},
  "webui_ssl_keyfile": {% if webui_ssl_keyfile %}"{{ webui_ssl_keyfile }}"{% else %}null{% endif %},
  "webui_user": {% if webui_user %}"{{ webui_user }}"{% else %}null{% endif %},
  "webui_password": {% if webui_password %}"{{ webui_password }}"{% else %}null{% endif %}
}