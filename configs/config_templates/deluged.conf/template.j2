# Deluge daemon configuration file
# This template generates the JSON-style configuration for deluged.
# Each field is documented below with its purpose and schema default.

# Allow remote connections to the daemon.
# Default: false
{
  "allow_remote": {{ allow_remote | default(false) | lower }},

  # Port the daemon will listen on.
  # Default: 58846
  "daemon_port": {{ daemon_port | default(58846) }},

  # Set the log level (none, info, warning, error, debug). Default is error.
  # Default: error
  "log_level": "{{ log_level | default('error') }}",

  # Maximum number of torrents allowed to be actively downloading at once.
  # Default: 5
  "max_active_downloading": {{ max_active_downloading | default(5) }},

  # Maximum number of torrents allowed to be actively seeding at once.
  # Default: 5
  "max_active_seeding": {{ max_active_seeding | default(5) }},

  # Maximum download speed (in KB/s). 0 means unlimited.
  # Default: 0
  "max_download_speed": {{ max_download_speed | default(0) }},

  # Maximum upload speed (in KB/s). 0 means unlimited.
  # Default: 0
  "max_upload_speed": {{ max_upload_speed | default(0) }},

  # Maximum total number of connections across all torrents.
  # Default: 200
  "max_connections_global": {{ max_connections_global | default(200) }},

  # Maximum new connections per second.
  # Default: 20
  "max_connections_per_second": {{ max_connections_per_second | default(20) }},

  # Maximum number of active torrents.
  # Default: 8
  "max_active_limit": {{ max_active_limit | default(8) }},

  # Seed ratio limit (default 2.0).
  # Default: 2.0
  "seed_ratio": {{ seed_ratio | default(2.0) }},

  # Seed time limit in minutes (0 means unlimited).
  # Default: 0
  "seed_time": {{ seed_time | default(0) }},

  # Interface daemon will listen for bittorrent connections on.
  # Default: 0.0.0.0:6881
  "listen_interfaces": "{{ listen_interfaces | default('0.0.0.0:6881') }}",

  # Enable port forwarding (UPnP/NAT-PMP).
  # Default: true
  "port_forwarding": {{ port_forwarding | default(true) | lower }},

  # Enable encrypted protocol.
  # Default: false
  "encrypted_protocol": {{ encrypted_protocol | default(false) | lower }},

  # Change to this user on startup (Requires root).
  # This is an OS user, not an application credential.
  # Default: deluge
  "user": "{{ user | default('deluge') }}",

  # Pidfile to store the process id.
  # Default: /run/deluged.pid
  "pidfile": "{{ pidfile | default('/run/deluged.pid') }}",

  # Output to specified logfile instead of stdout.
  # Default: (empty, i.e., stdout)
  "logfile": "{{ logfile | default('') }}"
}