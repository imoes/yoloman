# ============================================================================
# Bip Configuration Template
# ============================================================================
# Bip is a BNC (Bouncer) for IRC, acting as an intermediary between an IRC
# client and the IRC network. This template provides a self-documenting,
# safe-to-reuse configuration based on the provided schema.
# ============================================================================

# --------------------------------------------------------------------------
# Network Binding Configuration
# --------------------------------------------------------------------------

# IPv4 address to bind to (leave empty to bind to all interfaces).
# If left empty, bip binds to 0.0.0.0.
{% set bind_ip_val = bind_ip | default('') %}
{% if bind_ip_val %}
ip = "{{ bind_ip_val }}";
{% else %}
#ip = "0.0.0.0";
{% endif %}
# IPv6 address to bind to (leave empty to disable IPv6).
{% set bind_ipv6_val = bind_ipv6 | default('') %}
{% if bind_ipv6_val %}
#ip6 = "{{ bind_ipv6_val }}";
{% else %}
#ip6 = "::1";
{% endif %}
# --------------------------------------------------------------------------
# Port Configuration
# --------------------------------------------------------------------------

# TCP port for plain-text IRC connections.
{% set port_val = port | default('7778') %}
{% if port_val %}
port = {{ port_val }};
{% else %}
{% if port is defined and port is not none and (port is number or port is boolean or port | length > 0) %}port = {{ port }}
{% else %}#port = 7778;
{% endif %}{% endif %}
# TCP port for SSL/TLS-encrypted IRC connections.
{% set ssl_port_val = ssl_port | default(omit) %}
{% if ssl_port_val is defined and ssl_port_val is not none %}
ssl_port = {{ ssl_port_val }};
{% else %}
{% if ssl_port is defined and ssl_port is not none and (ssl_port is number or ssl_port is boolean or ssl_port | length > 0) %}ssl_port = {{ ssl_port }}
{% else %}#ssl_port = 7779;
{% endif %}{% endif %}
# --------------------------------------------------------------------------
# SSL/TLS Configuration
# --------------------------------------------------------------------------

# Allow plaintext (non-SSL) connections to bip itself (not recommended for production).
# Note: Bip's internal logic often treats this as a boolean flag for enabling/disabling
# client-side SSL requirements or enforcement.
{% set allow_plaintext_val = allow_plaintext | default('') %}
{% if allow_plaintext_val | lower in ['true', 'yes', '1', 'on'] %}
allow_plaintext = true;
{% elif allow_plaintext_val | lower in ['false', 'no', '0', 'off'] %}
allow_plaintext = false;
{% else %}
{% if allow_plaintext is defined and allow_plaintext is not none and (allow_plaintext is number or allow_plaintext is boolean or allow_plaintext | length > 0) %}allow_plaintext = {{ allow_plaintext }}
{% else %}#allow_plaintext = false;
{% endif %}{% endif %}
# Path to SSL certificate file.
{% set ssl_cert_val = ssl_cert | default('') %}
{% if ssl_cert_val %}
client_side_ssl_pem = "{{ ssl_cert_val }}";
{% else %}
#client_side_ssl_pem = "<bipdir>/bip.pem";
{% endif %}
# Path to SSL private key file.
# In Bip, this is often referred to as the DH parameter or key file depending on version,
# but schema maps it to `ssl_key`.
{% set ssl_key_val = ssl_key | default('') %}
{% if ssl_key_val %}
client_side_dh_param = "{{ ssl_key_val }}";
{% else %}
#client_side_dh_param = "<bipdir>/dh.pem";
{% endif %}
# --------------------------------------------------------------------------
# Logging Configuration
# --------------------------------------------------------------------------

# Directory where log files (IRC sessions, errors, etc.) are stored.
{% set log_dir_val = log_dir | default('') %}
{% if log_dir_val %}
log_root = "{{ log_dir_val }}";
{% else %}
#log_root = "<bipdir>/logs";
{% endif %}
# Logging verbosity: 1=error, 5=debug (higher = more verbose).
# 0: only fatal errors
# 1: add others errors
# 2: add warnings
# 3: add info messages
{% set log_level_val = log_level | default('1') %}
{% if log_level_val %}
log_level = {{ log_level_val }};
{% else %}
{% if log_level is defined and log_level is not none and (log_level is number or log_level is boolean or log_level | length > 0) %}log_level = {{ log_level }}
{% else %}#log_level = 1;
{% endif %}{% endif %}
# --------------------------------------------------------------------------
# Process Management
# --------------------------------------------------------------------------

# Path to PID file for process management.
{% set pid_file_val = pid_file | default('') %}
{% if pid_file_val %}
pid_file = "{{ pid_file_val }}";
{% else %}
{% if pid_file is defined and pid_file is not none and (pid_file is number or pid_file is boolean or pid_file | length > 0) %}pid_file = {{ pid_file }}
{% else %}#pid_file = "<bipdir>/bip.pid";
{% endif %}{% endif %}
# --------------------------------------------------------------------------
# User and Network Configuration
# --------------------------------------------------------------------------

# List of IRC users (each with their own credentials, network defaults, and settings).
# Bip uses a YAML-like structure for users. We render each user object as a YAML block.
{% if users is defined and users %}
{% for user in users %}
user {
    name = "{{ user.name | default('user') }}";
    password = "{{ user.password | default('') }}";

    # Network settings for this user
    {% if user.networks is defined and user.networks %}
    {% for network in user.networks %}
    network {
        name = "{{ network.name | default('network') }}";
        server {
            {% if network.server is defined and network.server %}
            host = "{{ network.server.host | default('irc.example.com') }}";
            port = {{ network.server.port | default('6667') }};
            {% else %}
            host = "irc.example.com";
            port = 6667;
            {% endif %}        }
        {% if network.ssl is defined and network.ssl %}
        ssl = {{ network.ssl | lower }};
        {% endif %}        {% if network.channels is defined and network.channels %}
        channels = {{ network.channels | join(' ') }};
        {% endif %}    }
    {% endfor %}
    {% endif %}}
{% endfor %}
{% else %}
# No users defined. Add user blocks as needed.
# user {
#     name = "myuser";
#     password = "mypasswd_hashed";
#     network {
#         name = "oftc";
#         server {
#             host = "irc.oftc.net";
#             port = 6667;
#         }
#     }
# }
{% endif %}