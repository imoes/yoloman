{
  "bind_ip": "127.0.0.1",
  "bind_ipv6": "",
  "port": 6667,
  "ssl_port": 6697,
  "ssl_cert": "/etc/bip/ssl/bip.crt",
  "ssl_key": "/etc/bip/ssl/bip.key",
  "log_dir": "/var/log/bip",
  "log_level": 4,
  "pid_file": "/run/bip/bip.pid",
  "allow_plaintext": false,
  "users": [
    {
      "name": "alice",
      "password": "secret123",
      "realname": "Alice Smith",
      "nicks": [
        "Alice",
        "Alice_"
      ],
      "default_server": "irc.libera.chat",
      "default_port": 6697,
      "default_ssl": true,
      "default_channels": [
        "#bip",
        "#dev"
      ],
      "ssl_verify": true,
      "max_history_lines": 2000,
      "history_persist": true,
      "autoquery": true,
      "flood_protection": true
    },
    {
      "name": "bob",
      "password": "bobspass",
      "nicks": [
        "Bob"
      ],
      "ident": "bob",
      "default_server": "irc.freenode.net",
      "default_port": 6667,
      "default_ssl": false,
      "default_password": "nickservpass",
      "ssl_verify": true,
      "reconnect_delay": 5,
      "autojoin": true,
      "always_away": true,
      "away_message": "At lunch"
    }
  ],
  "network_aliases": [
    {
      "name": "libera",
      "server": "irc.libera.chat",
      "port": 6697,
      "ssl": true
    },
    {
      "name": "freenode",
      "server": "irc.freenode.net",
      "port": 6667,
      "ssl": false
    }
  ]
}
