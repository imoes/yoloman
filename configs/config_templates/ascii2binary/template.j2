# ascii2binary Configuration File
# This file configures the 'ascii2binary' utility.
# It is a flat configuration where each option is a command-line flag.
# Options:
#   -t, --type: Output type and size.
#   -b, --base: Base for integer conversions.
#   -L, --locale: LC_NUMERIC locale to use.

# -t, --type: Output type and size.
# Must be one of: d, f, sc, ss, si, sl, sq, uc, us, ui, ul, uq (per -t/--type flag in manpage).
# Default: uc
-t {{ type | default('uc') }}

# -b, --base: Base for integer conversions.
# Base for integer conversions: 2-36, or b/o/d/h (per -b/--base flag).
# For non-integer types (-t d/f), this flag is ignored.
# Default: d
-b {{ base | default('d') }}

# -L, --locale: LC_NUMERIC locale to use.
# LC_NUMERIC locale to use (per -L/--locale flag).
# Default: C
-L {{ locale | default('C') }}