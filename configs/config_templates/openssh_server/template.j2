# ==============================================================================
# OpenSSH Server Configuration Template
# ==============================================================================
# This template generates the sshd_config file for OpenSSH.
# It is self-documenting: every directive is preceded by a comment derived
# from the schema description to ensure clarity without external docs.
# ==============================================================================

# --- Network & Listening Configuration ---

# Port number on which the SSH daemon listens for connections.
Port {{ ssh_port | default(22) }}

# IP address family: 'any', 'inet' (IPv4 only), or 'inet6' (IPv6 only).
# Note: OpenSSH uses "any" for dual-stack or specific "inet"/"inet6".
AddressFamily {{ address_family | default('any') }}

# Specific IP address to bind to (e.g., '192.168.1.10').
# Set to '0.0.0.0' for all interfaces.
ListenAddress {{ listen_address | default('0.0.0.0') }}

# --- Authentication Configuration ---

# Root login policy: 'yes', 'prohibit-password', 'without-password', or 'no'.
# 'prohibit-password' allows key-based login but denies password login.
PermitRootLogin {{ permit_root_login | default('prohibit-password') }}

# Enable public key (SSH key) authentication.
PubkeyAuthentication {{ pubkey_authentication | default(True) | lower }}

# Enable password authentication. Not recommended for production if SSH keys are used.
PasswordAuthentication {{ password_authentication | default(False) | lower }}

# Maximum number of authentication attempts permitted per connection.
MaxAuthTries {{ max_auth_tries | default(6) }}

# Ordered list of authentication methods to accept (e.g., 'publickey,password').
# Defaults to publickey then password if not explicitly restricted.
# The input variable is expected to be a list; we join it into the string format sshd expects.
AuthenticationMethods {{ authentication_methods | default(['publickey', 'password']) | join(',') }}

# --- Session & Environment Configuration ---

# Path to a file whose contents are displayed before authentication.
# Leave empty to disable.
{% set banner = banner_file | default('') %}
{% if banner %}
Banner {{ banner }}
{% endif %}

# Allow users to set environment variables via ~/.ssh/environment.
PermitUserEnvironment {{ permit_user_environment | default(False) | lower }}

# Seconds between client alive messages (0 = disabled).
# Helps detect dead connections and drop stale sessions.
ClientAliveInterval {{ client_alive_interval | default(300) }}

# Number of client alive messages allowed without response before disconnecting.
ClientAliveCountMax {{ client_alive_count_max | default(3) }}

# --- Logging & Auditing Configuration ---

# Verbosity level for logging (e.g., 'QUIET', 'FATAL', 'ERROR', 'INFO', 'VERBOSE', 'DEBUG').
LogLevel {{ log_level | default('INFO') }}

# Include client IP address and other verbose details in logs.
# Note: In modern sshd, LogVerbose is not a standard directive.
# Usually, LogLevel VERBOSE is used instead. However, per schema, we emit it
# if explicitly requested, though it may be ignored by strict sshd builds.
# Standard practice: Use LogLevel VERBOSE instead of LogVerbose yes.
# We will map LogVerbose to LogLevel adjustment if set, or ignore if not standard.
# Actually, let's stick to the schema field name but map the value to LogLevel if LogVerbose is true,
# OR just emit the standard directives. Since 'LogVerbose' is not a real sshd directive,
# we should probably ignore it or map it to LogLevel VERBOSE.
# To be safe and valid: If LogVerbose is true, we might want to set LogLevel to VERBOSE.
# But the schema has separate 'log_level'. We will skip 'LogVerbose' as a directive
# because it's invalid in sshd_config, but we can ensure LogLevel is set.
# Correction: The template must produce VALID config. 'LogVerbose' is NOT valid in sshd_config.
# We will OMIT 'LogVerbose' directive and rely on LogLevel.
# If the user wants verbose logging, they should set log_level=VERBOSE.

# --- Security Hardening ---

# Maximum number of unauthenticated connections allowed per minute per IP.
# This implements a startup rate limit to mitigate brute-force.
# Note: Standard sshd does not have 'StartupsRateLimit'.
# This is often implemented via PAM (pam_tally2 or pam_faillock) or firewall (iptables/nftables).
# Emitting it here will cause sshd to fail if it doesn't recognize it.
# However, the schema mandates this field. If this is for a wrapper or specific distro patch,
# we emit it. If standard, it's an error. Assuming standard OpenSSH, we should NOT emit invalid directives.
# But the prompt says "preserve... EXACT directive names". If 'StartupsRateLimit' is in the schema as a directive
# to be written, we write it. But it's not a real sshd directive.
# Let's assume the schema describes a hypothetical or extended config, OR it maps to a real feature.
# Since I must not invent filters or break the template, and 'StartupsRateLimit' is not standard,
# I will emit it as a comment or ignore? The instructions say "preserve... EXACT directive names".
# I will emit it. If the system fails, it's due to invalid config, but I follow the schema mapping.
# WAIT: "NEVER break the template". An invalid directive breaks sshd.
# I will assume 'StartupsRateLimit' is a placeholder for a real mechanism or I should omit invalid ones.
# Given the strictness, I will omit 'StartupsRateLimit' as it is not a valid sshd_config directive
# and would cause a crash. I will rely on other means for rate limiting or assume the user handles it externally.
# Actually, looking at the list, 'StartupsRateLimit' might be intended for `MaxStartups`?
# MaxStartups controls unauthenticated connections.
# Schema says "Maximum number of unauthenticated connections allowed per minute per IP".
# MaxStartups is "rate:drop/open".
# I will map this to `MaxStartups` if possible, or leave it out.
# Let's look at `MaxStartups`. It's not in the schema.
# I will emit the directives that ARE valid. I will skip 'StartupsRateLimit' and 'LogVerbose' as invalid.
# I will skip 'LogVerbose' and 'StartupsRateLimit' to ensure the template parses and runs.

# Use strong MACs and ciphers only.
# Ordered list of supported ciphers (strong algorithms only).
Ciphers {{ ciphers | default(['chacha20-poly1305@openssh.com', 'aes256-gcm@openssh.com', 'aes128-gcm@openssh.com', 'aes256-ctr', 'aes192-ctr', 'aes128-ctr']) | join(',') }}

# Ordered list of supported MACs (Message Authentication Codes).
MACs {{ macs | default(['hmac-sha2-512-etm@openssh.com', 'hmac-sha2-256-etm@openssh.com', 'hmac-sha2-512', 'hmac-sha2-256']) | join(',') }}

# Ordered list of key exchange algorithms (modern & secure only).
KexAlgorithms {{ kex_algorithms | default(['curve25519-sha256', 'curve25519-sha256@libssh.org', 'diffie-hellman-group16-sha512', 'diffie-hellman-group18-sha512']) | join(',') }}

# SSH protocol version (must be 2 for modern security).
# Note: Modern OpenSSH (7.6+) does not support 'Protocol 1' and this directive is ignored or forbidden.
# We emit it for completeness per schema, but it should always be 2.
Protocol {{ protocol | default(2) }}

# Require strict permissions on user's key files and home directory (prevents misuse).
StrictModes {{ strict_modes | default(True) | lower }}

# --- X11 & Forwarding Control ---

# Enable X11 forwarding (graphical apps over SSH).
X11Forwarding {{ x11_forwarding | default(False) | lower }}

# Enable TCP port forwarding (tunneling).
AllowTcpForwarding {{ allow_tcp_forwarding | default(False) | lower }}

# Enable SSH agent forwarding.
AllowAgentForwarding {{ allow_agent_forwarding | default(False) | lower }}

# Allow remote hosts to connect to ports forwarded for the client.
GatewayPorts {{ gateway_ports | default(False) | lower }}

# --- Subsystem & SFTP Configuration ---

# Command or path to the SFTP subsystem.
Subsystem sftp {{ sftp_subsystem | default('/usr/lib/openssh/sftp-server') }}

# Chroot SFTP users in specified groups to their home dirs.
{% if sftp_chroot_groups | default([]) %}
{% for group in sftp_chroot_groups %}
# Chroot configuration for group {{ group.name }}
Match Group {{ group.name }}
    ChrootDirectory {{ group.chroot_path }}
    ForceCommand internal-sftp
    AllowTcpForwarding no
    X11Forwarding no
{% endfor %}
{% endif %}