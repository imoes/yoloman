# Zita-mu1 monitoring client configuration
# Generated by Ansible Jinja2 template
# This template provides a structured representation of command-line arguments
# for the zita-mu1 application, which is primarily a CLI tool without a native
# persistent configuration file format.

# Client identifier for Jack session organization.
# Maps to: -name <name>
# The name used to identify this client in Jack connections.
client_name: {{ (client_name | default('zita-mu1')) | string }}

# Target Jack server name to connect to.
# Maps to: -s <server>
# Typically 'system' for the standard Jack2 instance.
jack_server: {{ (jack_server | default('system')) | string }}

# Initial window geometry (widthxheight+x_offset+y_offset).
# Maps to: -g <geometry>
# Controls the starting position and size of the application window.
geometry: {{ (geometry | default('800x600+0+0')) | string }}

# Command execution context note:
# Since zita-mu1 is a CLI-only application, these variables are intended
# to be used by an orchestrator (e.g., a systemd unit or wrapper script)
# to invoke the binary:
# zita-mu1 --name={{ (client_name | default('zita-mu1')) }} --server={{ (jack_server | default('system')) }} --geometry={{ (geometry | default('800x600+0+0')) }}