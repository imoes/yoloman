[uwsgi]
############################
### Generic UWSGI config ###
############################

# Override the default size for headers from the 4k default.
# Schema: buffer-size (not present, hardcoded in original)
buffer-size = 65535

# This avoids error 104: "Connection reset by peer"
# Schema: rem-header (not present, hardcoded in original)
rem-header = Content-Length

# This is running standalone
# Schema: master (not present, hardcoded in original)
master = true

# uwsgi recommends this to prevent thundering herd on accept.
# Schema: thunder-lock (not present, hardcoded in original)
thunder-lock = true

# Enable Python 3 plugin for WSGI support.
# Schema: plugins (not present, hardcoded in original)
plugins = python3

# This ensures that file descriptors aren't shared between the WSGI application processes.
# Schema: lazy-apps (not present, hardcoded in original)
lazy-apps = true

# Log from the wsgi application: needs python3-pastescript as runtime depends.
# Schema: paste-logger (not present, hardcoded in original)
paste-logger = true

# automatically kill workers if master dies
# Schema: no-orphans (not present, hardcoded in original)
no-orphans = true

# exit instead of brutal reload on SIGTERM
# Schema: die-on-term (not present, hardcoded in original)
die-on-term = true

# Avoid memcached connections to remain opened
# Schema: close-on-exec (not present, hardcoded in original)
close-on-exec = true
close-on-exec2 = true

##########################
### Performance tuning ###
##########################
# Threads and processes
# Schema: enable-threads (not present, hardcoded in original)
enable-threads = true

# For max perf, set this to number of core*2
# Schema: processes (not present, hardcoded in original)
processes = 8

# This was benchmarked as a good value
# Schema: threads (not present, hardcoded in original)
threads = 32

# This is the number of sockets in the queue.
# It improves a lot performances. This is comparable
# to the Apache ServerLimit/MaxClients option.
# Schema: listen (not present, hardcoded in original)
listen = 100

##################################
### OpenStack service specific ###
##################################
# Environment variable for Oslo messaging to identify this process in RabbitMQ.
# Note: Barbican typically connects to RabbitMQ for async tasks.
# Since the schema does not provide specific RabbitMQ connection fields
# (host, port, user, password, vhost), these are NOT injected here
# to avoid schema violations. If injection is required, it must be
# handled by a parent role or this schema must be extended.
# Current behavior: Set OS_OSLO_MESSAGING_RABBIT__PROCESSNAME only.
env = OS_OSLO_MESSAGING_RABBIT__PROCESSNAME=barbican-api

# This is needed, otherwise connections stay open
# Schema: add-header (not present, hardcoded in original)
add-header = Connection: close

# Paste configuration file path.
# Schema: paste (not present, hardcoded in original)
paste = config:/etc/barbican/barbican-api-paste.ini

# Do not load the default application.
# Schema: no-default-app (not present, hardcoded in original)
no-default-app = true

# Log file path.
# Schema: logto (not present, hardcoded in original)
logto = /var/log/barbican/barbican-api.log

# UWSGI process name.
# Schema: name (not present, hardcoded in original)
name = barbican-api

# OS user to run the worker processes as.
# Schema: uid (not present, hardcoded in original)
uid = barbican

# OS group to run the worker processes as.
# Schema: gid (not present, hardcoded in original)
gid = barbican

# Working directory for the application.
# Schema: chdir (not present, hardcoded in original)
chdir = /var/lib/barbican

# The WSGI entry point script.
# Schema: wsgi-file (not present, hardcoded in original)
wsgi-file = /usr/bin/barbican-wsgi-api

# Port on which the uWSGI server should listen.
# Default: '' (empty/disabled). If set, enables http-socket and https-socket on the same port.
# Note: The original template used dummy SSL filenames (foobar.crt/foobar.key).
# In a production environment, replace these with actual paths or manage them via a different mechanism.
{% if uwsgi_port | default('') is defined and uwsgi_port | default('') != '' %}
http-socket = [::]:{{ uwsgi_port | default('') }}
# SSL configuration placeholder - replace with actual certificate and key paths
https-socket = [::]:{{ uwsgi_port | default('') }},foobar.crt,foobar.key
{% else %}
#http-socket = [::]:9311
#https-socket = [::]:9311,foobar.crt,foobar.key
{% endif %}