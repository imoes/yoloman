{
  "buffer_size": {
    "type": "number",
    "default": 65535,
    "description": "Size for request headers buffer"
  },
  "processes": {
    "type": "number",
    "default": 8,
    "description": "Number of worker processes"
  },
  "threads": {
    "type": "number",
    "default": 1,
    "description": "Number of threads per worker"
  },
  "listen_queue_size": {
    "type": "number",
    "default": 100,
    "description": "Number of sockets in the listen queue"
  },
  "chmod_socket": {
    "type": "number",
    "default": 666,
    "description": "Permissions for the socket file"
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/glance/glance-api.log",
    "description": "Path to the log file"
  },
  "uwsgi_uid": {
    "type": "string",
    "default": "glance",
    "description": "User ID to run the uwsgi process as"
  },
  "uwsgi_gid": {
    "type": "string",
    "default": "glance",
    "description": "Group ID to run the uwsgi process as"
  },
  "glance_data_dir": {
    "type": "string",
    "default": "/var/lib/glance",
    "description": "Working directory for the glance application"
  }
}
