{
  "global": "",
  "cluster.enabled": true,
  "cluster.seed_nodes": [
    "garage-node1:4001",
    "garage-node2:4001",
    "garage-node3:4001"
  ],
  "cluster.node_name": "garage@node1",
  "cluster.cookie": "supersecretclustercookie123",
  "cluster.rpc_timeout_ms": 10000,
  "cluster.join_retry_interval_sec": 15,
  "listener.host": "0.0.0.0",
  "listener.port": 1883,
  "listener.max_connections": 2000,
  "listener.tls.enabled": true,
  "listener.tls.cert_file": "/etc/garagemq/tls/fullchain.pem",
  "listener.tls.key_file": "/etc/garagemq/tls/privkey.pem",
  "listener.tls.ca_file": "/etc/garagemq/tls/ca.crt",
  "auth.enabled": true,
  "auth.providers": [
    {
      "type": "file",
      "path": "/etc/garagemq/users.yaml"
    }
  ],
  "storage.backend": "leveldb",
  "storage.data_dir": "/var/lib/garagemq/data",
  "storage.max_segment_size_mb": 128,
  "storage.compaction_threshold": 0.8,
  "storage.sync_write": false,
  "log.level": "info",
  "log.format": "json",
  "log.output": "file",
  "log.file_path": "/var/log/garagemq/garagemq.log",
  "log.max_size_mb": 200,
  "log.max_backups": 10,
  "log.compress": true,
  "metrics.enabled": true,
  "metrics.port": 9090,
  "metrics.path": "/metrics",
  "metrics.enable_histograms": true,
  "metrics.histogram_buckets": [
    0.001,
    0.005,
    0.01,
    0.025,
    0.05,
    0.1,
    0.25,
    0.5,
    1.0,
    2.5,
    5.0,
    10.0
  ],
  "limits.max_message_size_kb": 512,
  "limits.max_inflight_messages": 500,
  "limits.queue_depth_warning_threshold": 5000,
  "limits.session_expiry_sec": 7200,
  "defaults.subscription.max_topic_levels": 8,
  "defaults.subscription.max_wildcards_per_topic": 2
}
