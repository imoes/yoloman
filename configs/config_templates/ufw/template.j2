# UFW enabled/disabled toggle
ENABLED={{ ufw_enabled }}

# Default policy for incoming traffic
DEFAULT_INPUT_POLICY="{{ default_input_policy }}"

# Default policy for outgoing traffic
DEFAULT_OUTPUT_POLICY="{{ default_output_policy }}"

# Default policy for routed traffic (forward)
DEFAULT_FORWARD_POLICY="{{ default_forward_policy }}"

# Enable IPv6 support (true/false)
IPv6={{ ipv6_enabled }}

# Log level: off, low, medium, high, full
LOGLEVEL={{ log_level }}

# Port used by ufw for rate limiting logs (if log level != off)
# Note: This is for internal use by ufw's logging system; rarely adjusted
LOGFILE={{ log_file }}

# Maximum log entries per minute (only effective when LOGLEVEL != off)
# Note: This line is not present in stock ufw.conf by default; included here as configurable for hardening
MAX_LOG_SIZE={{ max_log_size }}

# Path to iptables-legacy or iptables-nft (auto-detected by default)
# Only needed if explicit control is required
IPT_SYSCTL={{ ipt_sysctl }}

# Additional options passed to iptables (not recommended unless necessary)
IPT_OPTIONS="{{ ipt_options }}"

# Enable logging of denied packets (on/off; overrides log level for denied packets)
LOG_DENIED={{ log_denied }}

# Allow raw IPv6 packets through (advanced, usually false)
RAW_IPV6={{ raw_ipv6 }}

# Allow UDP fragmentation (advanced, usually false)
ALLOW_UDP_FRAG={{ allow_udp_frag }}