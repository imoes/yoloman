# Pumpa Configuration File
# Generated by Ansible Jinja2 template
# This file configures the Pumpa Qt desktop client for pump.io.

[General]
# The locale code to use for the UI, e.g., 'en_GB', 'es'. Corresponds to -l flag.
Locale={{ locale | default('en_GB') }}

[Network]
# The default server URL for pump.io instances.
# Default to the identi.ca instance mentioned in description if not specified
ServerUrl={{ server_url | default('https://identi.ca') }}

[Accounts]
# List of accounts to log in to.
# Iterates over the 'accounts' list defined in the Ansible variables.
{% for account in (accounts | default([])) %}
[Account_{{ loop.index }}]
# The username for the pump.io account.
Username={{ account.username | default('') }}
# The server URL for this specific account. If empty, uses the global ServerUrl.
# If the account's server is undefined, it falls back to the global ServerUrl.
Server={{ account.server | default(server_url | default('https://identi.ca')) }}
{% endfor %}

[Appearance]
# Enable dark mode (bool: true/false)
# Whether to enable dark mode in the Qt desktop client.
DarkMode={{ dark_mode | default(false) | lower }}

# Font size in points
# The default font size in points for the application UI.
FontSize={{ font_size | default(11) }}