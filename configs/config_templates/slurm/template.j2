# slurm network load monitor configuration
# ==============================================================================
# This template configures the `slurm` utility, a text-mode network load monitor
# (often known as `slurm - the slurm network load monitor`). It is NOT the
# Slurm Workload Manager for HPC clusters.
# ==============================================================================

# Interface to monitor (e.g., eth0, wlan0)
# Default: 'eth0'
interface={{ interface | default('eth0') }}

# Delay between screen updates in seconds. Must be between 1 and 300.
# Default: 1
delay={{ delay | default(1) }}

# Default graph mode: classic, split, or large.
# Default: 'classic'
mode={{ mode | default('classic') }}

# Add hostname to the title bar.
# Default: False
hostname_in_title={{ hostname_in_title | default(false) }}

# Enable TX/RX activity LEDs (if supported by terminal/OS).
# Default: False
led={{ led | default(false) }}

# Select the initial graph view: classic, split, or large.
# Default: 'classic'
graph_style={{ graph_style | default('classic') }}

# Use virtually zero traffic counters instead of values stored in kernel.
# Default: False
zero_counters={{ zero_counters | default(false) }}