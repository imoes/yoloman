# =============================================================================
# OIDC Agent Configuration Template
# =============================================================================
# This template configures the oidc-agent, a daemon that manages OpenID Connect
# tokens and credentials for command-line applications.
#
# The configuration file uses a simple YAML-like syntax.
# =============================================================================

# -----------------------------------------------------------------------------
# IPC Socket Configuration
# -----------------------------------------------------------------------------
# Path to the UNIX-domain socket used for communicating with the agent.
# Supports random substitution with 'XXXXXX' in the path.
# Default: /run/user/1000/oidc-agent.sock
socket_path: {{ socket_path | default('/run/user/1000/oidc-agent.sock') }}

# -----------------------------------------------------------------------------
# Token Request Policies
# -----------------------------------------------------------------------------
# Allow ID tokens to be issued without manual approval by the user.
# If false, the agent will wait for user confirmation (e.g., via a browser or
# interactive prompt) before issuing an ID token.
# Default: false
always_allow_idtoken: {{ always_allow_idtoken | default(false) }}

# Require user confirmation when an application requests an access token
# for any loaded configuration. This adds a layer of security by ensuring
# the user explicitly approves access token issuance.
# Default: false
confirm: {{ confirm | default(false) }}

# Disable the autoload feature.
# When enabled (true), token requests cannot load needed configurations
# automatically; the configuration must be explicitly loaded beforehand.
# This prevents unexpected behavior where a request triggers a login flow
# in the background.
# Default: false
no_autoload: {{ no_autoload | default(false) }}

# Disable automatic re-authentication.
# When enabled (true), if a refresh token expires, the agent will NOT
# automatically re-authenticate the user. This requires manual intervention
# or explicit re-login commands.
# Default: false
no_auto_reauthenticate: {{ no_auto_reauthenticate | default(false) }}

# Disable custom URI scheme redirect.
# When enabled (true), the agent will not use custom URI schemes (like
# `myapp://callback`) for the authorization code flow redirect.
# This is useful if the client application prefers HTTP callbacks.
# Default: false
no_scheme: {{ no_scheme | default(false) }}

# Disable the local webserver.
# When enabled (true), the agent will not start a local webserver for the
# authorization code flow. This forces the use of the custom URI scheme
# (if not disabled via `no_scheme`) or another method for receiving the
# auth code callback.
# Default: false
no_webserver: {{ no_webserver | default(false) }}

# -----------------------------------------------------------------------------
# Security and Timeout Settings
# -----------------------------------------------------------------------------
# Time in seconds to keep encryption passwords in memory.
# 0 or a negative value means the password is kept in memory forever
# (until the agent restarts).
# Default: 0
pw_store_timeout: {{ pw_store_timeout | default(0) }}

# Enable seccomp system call filtering.
# When enabled (true), the agent restricts its available system calls
# to reduce the attack surface in case of exploitation.
# Default: false
seccomp: {{ seccomp | default(false) }}

# Default maximum lifetime for account configurations in seconds.
# 0 means the configuration lives forever (until explicitly removed).
# This applies to newly added accounts.
# Default: 0
lifetime: {{ lifetime | default(0) }}

# Group name allowing other users to access the agent.
# If set, other users belonging to this group can connect to the agent's
# socket. Set to an empty string to disable this feature.
# Default: 'oidc-agent'
with_group: {{ with_group | default('oidc-agent') }}

# -----------------------------------------------------------------------------
# Logging and Execution Mode
# -----------------------------------------------------------------------------
# Run oidc-agent on the console without daemonizing.
# Useful for debugging or running in foreground.
# Default: false
console: {{ console | default(false) }}

# Set the log level to DEBUG.
# Enables verbose logging output, useful for troubleshooting.
# Default: false
debug: {{ debug | default(false) }}

# Additionally print log messages to stderr.
# When enabled, log messages are written to standard error in addition
# to any configured log file or system logger.
# Default: false
log_stderr: {{ log_stderr | default(false) }}