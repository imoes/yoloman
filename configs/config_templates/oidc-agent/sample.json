{
  "socket_path": "/tmp/oidc-agent.sock",
  "always_allow_idtoken": true,
  "confirm": false,
  "no_autoload": false,
  "no_auto_reauthenticate": true,
  "no_scheme": false,
  "no_webserver": true,
  "pw_store_timeout": 3600,
  "seccomp": false,
  "lifetime": 43200,
  "with_group": "oidc-users",
  "console": false,
  "debug": false,
  "log_stderr": true
}
