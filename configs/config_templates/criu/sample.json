{
  "images_dir": "/var/lib/criu",
  "work_dir": "/var/lib/criu",
  "log_file": "/var/log/criu.log",
  "verbosity": 3,
  "display_stats": true,
  "tcp_established": true,
  "tcp_close": false,
  "leave_stopped": false,
  "leave_running": false,
  "external_mnts": [
    {
      "mountpoint": "/data",
      "name": "data_mount"
    },
    {
      "mountpoint": "",
      "name": "auto_mounts"
    }
  ],
  "external_devs": [
    {
      "major": "8",
      "minor": "1",
      "name": "sda1"
    }
  ],
  "external_unix_sockets": [
    {
      "id": "12345"
    }
  ],
  "external_pids": [],
  "external_netns": [],
  "external_tty": {
    "rdev": "136:0",
    "dev": "5:0"
  },
  "external_file": {
    "mnt_id": "42",
    "inode": "98765"
  },
  "action_script": "/usr/local/bin/criu-actions.sh",
  "manage_cgroups": true,
  "cgroup_props": "\"memory\":\\n - \"strategy\": \"merge\"\\n - \"properties\": [\"memory.limit_in_bytes\"]\\n \"cpu\":\\n - \"strategy\": \"replace\"\\n - \"properties\": [\"cpu.cfs_quota_us\"]",
  "cgroup_props_file": "",
  "lazy_pages": false,
  "inherit_fds": [
    {
      "fd": 3,
      "resource": "pipe[5678]"
    }
  ],
  "veth_pair": {
    "in": "eth0",
    "out": "veth0"
  },
  "restore_root": "/mnt/restore-root",
  "lsm_profile": {
    "type": "selinux",
    "name": "container_t"
  },
  "lsm_mount_context": "system_u:object_r:container_file_t:s0:c1,c2",
  "skip_in_flight": true,
  "auto_dedup": false,
  "force_irmap": false,
  "link_remap": true,
  "shell_job": true,
  "cpu_cap": [
    "fpu",
    "ins"
  ],
  "page_server": {
    "address": "127.0.0.1",
    "port": 8080,
    "daemon": false
  },
  "tls": {
    "enabled": true,
    "ca_cert": "/etc/criu/certs/ca.pem",
    "cert": "/etc/criu/certs/server.pem",
    "key": "/etc/criu/certs/server-key.pem"
  },
  "file_validation": "buildid",
  "cgroup_root": "memory:/criu",
  "skip_file_rwx_check": false
}
