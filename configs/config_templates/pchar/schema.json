{
  "mode": {
    "type": "string",
    "default": "pchar",
    "description": "Operational mode: 'pchar' for full path characterization or 'trout' for tiny traceroute.",
    "enum": [
      "pchar",
      "trout"
    ]
  },
  "target": {
    "type": "string",
    "default": "example.com",
    "description": "Target hostname or IP address to measure."
  },
  "max_hops": {
    "type": "number",
    "default": 30,
    "description": "Maximum number of hops to probe (-H)."
  },
  "protocol": {
    "type": "string",
    "default": "ipv4udp",
    "description": "Protocol to use: ipv4udp, ipv4raw, ipv4icmp, ipv4tcp, ipv6icmp, ipv6udp (-p).",
    "enum": [
      "ipv4udp",
      "ipv4raw",
      "ipv4icmp",
      "ipv4tcp",
      "ipv6icmp",
      "ipv6udp"
    ]
  },
  "interface": {
    "type": "string",
    "default": "",
    "description": "Network interface to listen on for pcap (-i)."
  },
  "start_port": {
    "type": "number",
    "default": 32768,
    "description": "Starting UDP port for probes (-P)."
  },
  "max_packet_size": {
    "type": "number",
    "default": 1500,
    "description": "Maximum probe packet size in bytes (-m)."
  },
  "packet_size_increment": {
    "type": "number",
    "default": 32,
    "description": "Increment size for probe packet sizes in bytes (-I)."
  },
  "repetitions": {
    "type": "number",
    "default": 32,
    "description": "Number of repetitions per packet size (-R)."
  },
  "burst_size": {
    "type": "number",
    "default": 0,
    "description": "Burst size for inducing queueing (-b)."
  },
  "gap_seconds": {
    "type": "number",
    "default": 0.25,
    "description": "Mean inter-probe gap in seconds (-g)."
  },
  "gap_distribution": {
    "type": "string",
    "default": "fixed",
    "description": "Gap time distribution: 'fixed' or 'exp' (-G).",
    "enum": [
      "fixed",
      "exp"
    ]
  },
  "analysis_type": {
    "type": "string",
    "default": "lsq",
    "description": "Analysis type: lsq, kendall, lms, lmsint (-a).",
    "enum": [
      "lsq",
      "kendall",
      "lms",
      "lmsint"
    ]
  },
  "timeout_seconds": {
    "type": "number",
    "default": 3,
    "description": "Timeout in seconds for ICMP errors (-t)."
  },
  "start_hop": {
    "type": "number",
    "default": 1,
    "description": "Starting hop number to probe (-s)."
  },
  "tos_value": {
    "type": "number",
    "default": 0,
    "description": "IP Type Of Service value (-T)."
  },
  "custom_source": {
    "type": "string",
    "default": "",
    "description": "Local source address for probes (-l)."
  },
  "output_file": {
    "type": "string",
    "default": "",
    "description": "File to write statistics to (-w). Empty for stdout."
  },
  "input_file": {
    "type": "string",
    "default": "",
    "description": "File to read measurements from (-r). Empty for live."
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Debugging output level (-d)."
  },
  "quiet_mode": {
    "type": "bool",
    "default": false,
    "description": "Suppress standard output (-q)."
  },
  "verbose_mode": {
    "type": "bool",
    "default": false,
    "description": "Print hop/repetition synopsis (-v)."
  },
  "ignore_routing_changes": {
    "type": "bool",
    "default": false,
    "description": "Ignore routing changes/load-balancing (-c)."
  },
  "use_pcap": {
    "type": "bool",
    "default": false,
    "description": "Use pcap library (-C)."
  },
  "snmp_queries": {
    "type": "bool",
    "default": false,
    "description": "Enable SNMP queries at each hop (-S)."
  },
  "no_resolve": {
    "type": "bool",
    "default": false,
    "description": "Do not resolve hostnames (-n)."
  }
}
