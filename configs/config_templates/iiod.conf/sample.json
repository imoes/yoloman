{
  "listen_address": "127.0.0.1",
  "port": 1024,
  "transport": "ip",
  "log_level": "info",
  "enable_tls": true,
  "tls_cert_path": "/etc/iiod/tls/server.crt",
  "tls_key_path": "/etc/iiod/tls/server.key",
  "ca_cert_path": "/etc/iiod/tls/ca.crt",
  "allowed_clients": [
    "192.168.1.50",
    "10.0.0.30"
  ],
  "enable_discovery": true,
  "discovery_name": "iiod-server",
  "backend_options": {
    "timeout_ms": 30000,
    "keepalive": true,
    "keepalive_idle_sec": 60,
    "keepalive_interval_sec": 10,
    "keepalive_count": 3
  }
}
