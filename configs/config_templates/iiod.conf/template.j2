# iiod.conf — Configuration for the Industrial IIO Daemon (iiod)
# This file controls runtime behavior of iiod, including network binding, I/O backend settings, and optional features.
# It supports YAML syntax with Jinja2 templating for dynamic site/instance values.

# listen_address: IP address (e.g., 127.0.0.1, 192.168.1.10, or ::) to bind iiod listening socket.
# Use 0.0.0.0 for all interfaces.
listen_address: {{ (listen_address | default('0.0.0.0')) | string }}

# port: TCP port for remote IIO connections. Ports < 1024 require root; use ≥ 1024 for non-root operation.
port: {{ (port | default(1024)) | int }}

# transport: Communication transport method: 'ip' (network), 'usb' (USB-IO), or 'local' (local IIO devices only).
transport: {{ (transport | default('ip')) | string }}

# log_level: Logging verbosity. One of: debug, info, warning, error. Higher levels suppress less critical logs.
log_level: {{ (log_level | default('info')) | string }}

# enable_tls: Enable TLS encryption for remote connections. Requires valid cert/key paths.
enable_tls: {{ (enable_tls | default(false)) | bool | ternary('true', 'false') }}

# tls_cert_path: Path to PEM-encoded TLS server certificate. Required if TLS is enabled.
tls_cert_path: {{ (tls_cert_path | default('/etc/iiod/tls/server.crt')) | string }}

# tls_key_path: Path to PEM-encoded TLS private key. Required if TLS is enabled.
tls_key_path: {{ (tls_key_path | default('/etc/iiod/tls/server.key')) | string }}

# ca_cert_path: Path to PEM-encoded CA certificate to validate client certs (mutual TLS).
# Leave empty to disable client verification.
ca_cert_path: {{ (ca_cert_path | default('')) | string }}

# allowed_clients: List of allowed client hostnames or IP addresses (exact match only).
# Empty list = allow all.
{% set clients = (allowed_clients | default([])) %}
{% if clients | length > 0 %}
allowed_clients:
{% for client in clients %}
  - {{ client | string }}
{% endfor %}
{% else %}
allowed_clients: []
{% endif %}

# enable_discovery: Enable mDNS/DNS-SD publishing of this IIO daemon so clients can auto-discover it.
enable_discovery: {{ (enable_discovery | default(false)) | bool | ternary('true', 'false') }}

# discovery_name: Custom mDNS name to advertise (e.g., 'my-iio-server'). If omitted, hostname is used.
{% set dname = (discovery_name | default('')) %}
{% if dname | length > 0 %}
discovery_name: {{ dname | string }}
{% endif %}

# backend_options: Key-value options passed directly to the active backend (e.g., timeout_ms, keepalive).
# See backend documentation for supported keys.
{% set bopts = (backend_options | default({})) %}
{% if bopts | length > 0 %}
backend_options:
{% for key, value in bopts | dict2items %}
  {{ key | string }}: {{ value | tojson }}
{% endfor %}
{% else %}
backend_options: {}
{% endif %}