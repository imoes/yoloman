# Netscript Network Configuration System v{{ version }}
# Generated by Netscript Config Manager

# Global network behavior
[global]
  hostname = {{ global_hostname }}
  domain   = {{ global_domain }}
  # Enable or disable IPv6 globally
  ipv6     = {{ global_ipv6 | lower }}
  # Default gateway (empty = no static gateway)
  gateway  = {{ global_gateway | default('') }}

# DNS configuration
[resolver]
  # Primary and secondary DNS servers
{% for dns_server in resolver_dns_servers %}
  nameserver{{ loop.index }} = {{ dns_server }}
{% endfor %}
  # Search domains (space-separated)
  search = {{ resolver_search | join(' ') }}

# Interface definitions
{% for iface in interfaces %}
[interface:{{ iface.name }}]
  # Type: loopback, eth, bond, vlan, bridge, dummy, etc.
  type = {{ iface.type }}
  # Interface address configuration
{% if iface.address_mode == 'static' %}
  address = {{ iface.address }}
  netmask = {{ iface.netmask }}
{% elif iface.address_mode == 'dhcp' %}
  address_mode = dhcp
{% elif iface.address_mode == 'manual' %}
  # manual: no auto-addressing (for bridges, bonds, etc.)
  address_mode = manual
{% endif %}
  # Optional: default gateway for this interface (rarely used)
  gateway  = {{ iface.gateway | default('') }}
  # MTU (0 = system default)
  mtu      = {{ iface.mtu | default(0) }}
  # Enable or disable interface at boot
  up       = {{ iface.up | lower }}
  # Interface description (for documentation)
  comment  = {{ iface.comment | default('') }}
{% if iface.type == 'vlan' %}
  # VLAN-specific
  vlan_id  = {{ iface.vlan_id }}
  vlan_link = {{ iface.vlan_link }}
{% endif %}
{% if iface.type == 'bridge' %}
  # Bridge-specific
  bridge_ports = {{ iface.bridge_ports | join(' ') }}
  bridge_stp   = {{ iface.bridge_stp | lower }}
{% endif %}
{% if iface.type == 'bond' %}
  # Bond-specific
  bond_slaves  = {{ iface.bond_slaves | join(' ') }}
  bond_mode    = {{ iface.bond_mode }}
  bond_miimon  = {{ iface.bond_miimon }}
{% endif %}
{% endfor %}

# Firewall rules (optional: enable/disable and basic mode)
[firewall]
  enabled  = {{ firewall_enabled | lower }}
  # Default policies (accept, drop, reject)
  default_input   = {{ firewall_default_input }}
  default_forward = {{ firewall_default_forward }}
  default_output  = {{ firewall_default_output }}
  # Basic stateful rule set
  enable_conntrack = {{ firewall_enable_conntrack | lower }}

# NAT/Masquerade configuration (list of rules)
{% if nat_rules %}
[nat_rules]
{% for rule in nat_rules %}
  # {{ rule.comment }}
  {{ rule.chain }}_masquerade = {{ rule.src_net }}
{% endfor %}
{% endif %}

# Route table entries (static routes)
{% for route in static_routes %}
[route:{{ loop.index }}]
  # {{ route.comment }}
  to       = {{ route.to }}
  via      = {{ route.via }}
  dev      = {{ route.dev }}
{% endfor %}
