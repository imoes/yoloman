# Configure the installation path for GNU Data Language (GDL).
# This setting ensures the environment variable GDL_PATH points to the correct
# directory where the GDL binaries and data are installed.
# If GDL_PATH is already set in the environment, the script exits early.
if ( $?GDL_PATH ) then
	exit
endif
# Default path for GDL installation if not specified in the role variables.
setenv GDL_PATH {{ gdl_path | default('/usr/share/gnudatalanguage') }}
