# /etc/inetd.conf: Internet Superserver configuration
# Each line describes a service to offer, in the format:
# service_name flags protocol server_type server_program server_args

# TCP/UDP services are listed below.
{% for service in services %}# {{ service.name | replace('_', ' ') }}: {{ service.description or 'No description' }}
{{ service.name }}	{{ service.flags }}	{{ service.protocol }}	{{ service.server_type }}	{{ service.server_program }}	{{ service.server_args | join(' ') }}
{% endfor %}
