    {
      "name": "ftp",
      "flags": "nowait",
      "protocol": "tcp",
      "server_type": "",
      "server_program": "/usr/sbin/in.ftpd",
      "server_args": [
        "-l",
        "-a"
      ],
      "description": "FTP file transfer service"
    },
    {
      "name": "telnet",
      "flags": "nowait",
      "protocol": "tcp",
      "server_type": "",
      "server_program": "/usr/sbin/in.telnetd",
