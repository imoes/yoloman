{
  "cups_user": "root",
  "cups_group": "lp",
  "http_port": 631,
  "https_port": 0,
  "max_clients": 100,
  "max_jobs": 500,
  "max_job_size": 0,
  "timeout": 300,
  "server_root": "/etc/cups",
  "temp_dir": "/var/spool/cups/tmp",
  "web_interface": true,
  "log_level": "warn",
  "log_dir": "/var/log/cups",
  "system_group": "lpadmin",
  "encryption": "IfRequested",
  "default_protocol": "ipp",
  "remote_root": "deny",
  "remote_admin_allow": [
    "127.0.0.1",
    "192.168.1.0/24"
  ],
  "remote_admin_deny": [],
  "server_allow": [
    "127.0.0.1",
    "::1"
  ],
  "server_deny": [],
  "remote_printers_allow": [
    "192.168.1.0/24"
  ],
  "remote_printers_deny": [],
  "auth_helper": "/usr/lib/cups/authhelper",
  "enable_remote_admin": false,
  "enable_remote_printers": true,
  "server_name": "printserver.example.com",
  "server_port": 631,
  "language_file": "/usr/share/cups/language",
  "job_private_access": "owner",
  "job_private_values": "none",
  "printer_private_access": "all",
  "printer_private_values": "none",
  "browsing": true,
  "browse_local_protocols": [
    "dnssd"
  ],
  "browse_remote_protocols": [
    "dnssd"
  ],
  "default_shared": true,
  "page_logic": false,
  "cache_dir": "/var/cache/cups",
  "state_dir": "/var/spool/cups",
  "ppd_path": "/etc/cups/ppd",
  "snmp_support": false
}
