# PHP 8.4 Stomp Extension Configuration
# This directive loads the Stomp extension, enabling PHP applications
# to communicate with STOMP-compatible message brokers (e.g., RabbitMQ).
# See extension_name for the specific extension name to load.

# Load the Stomp extension shared object.
# The filename is constructed by appending the standard OS extension suffix (.so)
# to the extension name defined in the schema.
extension={{ (extension_name | default('stomp')) }}.so