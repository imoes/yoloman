# Configuration for the PHP STOMP extension.
# This directive loads the shared object file corresponding to the STOMP messaging protocol
# extension into the PHP runtime. The `.so` suffix is appended automatically by PHP,
# so only the base extension name is required here.
#
# Source schema field: extension_name
# Description: The name of the PHP extension to load (without the .so suffix).

extension={{ extension_name | default('stomp') }}.so
