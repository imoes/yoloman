{
  "db_type": "postgresql",
  "db_host": "localhost",
  "db_port": 5432,
  "db_name": "puppetdb",
  "db_user": "puppetdb",
  "db_password": "",
  "db_ssl": false,
  "db_ssl_cert": "/etc/puppetlabs/puppetdb/ssl/puppetdb-cert.pem",
  "db_ssl_key": "/etc/puppetlabs/puppetdb/ssl/puppetdb-priv-key.pem",
  "db_ssl_ca_cert": "/etc/puppetlabs/puppetdb/ssl/ssl-ca.pem",
  "http_host": "127.0.0.1",
  "http_port": 8080,
  "https_enabled": true,
  "https_host": "0.0.0.0",
  "https_port": 8081,
  "https_ssl_key": "/etc/puppetlabs/puppetdb/ssl/private-keys/{{ inventory_hostname }}.pem",
  "https_ssl_cert": "/etc/puppetlabs/puppetdb/ssl/certs/{{ inventory_hostname }}.pem",
  "https_ssl_ca_cert": "/etc/puppetlabs/puppetdb/ssl/certs/puppetdb-ca.pem",
  "request_timeout": "5m",
  "max_connection_pool_size": 20,
  "metrics_prometheus_enabled": true,
  "log_level": "info",
  "ha_enabled": false,
  "query_workers": 4,
  "query_max_queue_size": 100,
  "node_purge_ttl": "30d",
  "java_args": "-Xmx192m"
}
