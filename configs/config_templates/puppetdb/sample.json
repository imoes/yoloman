{
  "db_type": "postgresql",
  "db_host": "puppetdb-db.example.com",
  "db_port": 5432,
  "db_name": "puppetdb",
  "db_user": "puppetdb",
  "db_password": "supersecret",
  "db_ssl": true,
  "db_ssl_cert": "/etc/puppetlabs/puppetdb/ssl/client-cert.pem",
  "db_ssl_key": "/etc/puppetlabs/puppetdb/ssl/client-priv-key.pem",
  "db_ssl_ca_cert": "/etc/puppetlabs/puppetdb/ssl/ca.pem",
  "http_host": "127.0.0.1",
  "http_port": 8080,
  "https_enabled": true,
  "https_host": "0.0.0.0",
  "https_port": 8081,
  "https_ssl_key": "/etc/puppetlabs/puppetdb/ssl/private-keys/puppetdb01.example.com.pem",
  "https_ssl_cert": "/etc/puppetlabs/puppetdb/ssl/certs/puppetdb01.example.com.pem",
  "https_ssl_ca_cert": "/etc/puppetlabs/puppetdb/ssl/certs/puppetdb-ca.pem",
  "request_timeout": "5m",
  "max_connection_pool_size": 20,
  "metrics_prometheus_enabled": true,
  "log_level": "info",
  "ha_enabled": false,
  "query_workers": 4,
  "query_max_queue_size": 100,
  "node_purge_ttl": "21d",
  "gc_interval": "30m",
  "fact_purge_ttl": "60d"
}
