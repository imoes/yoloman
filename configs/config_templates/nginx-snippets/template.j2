# =============================================================================
# NGINX Reverse Proxy Snippets
# =============================================================================
# This template provides a standard set of proxy headers and settings for
# configuring NGINX as a reverse proxy or load balancer.
#
# Variables available:
#   - proxy_http_version: (string) The HTTP version to use for proxy connections.
#     Default: 1.1
#   - enable_forwarded_header: (bool) Whether to include the standard "Forwarded"
#     header alongside the legacy X-Forwarded-* headers. Default: true
#
# Note: This snippet assumes NGINX variables ($host, $remote_addr, $scheme,
# $server_port, $proxy_add_x_forwarded_for, $http_upgrade) are available in the
# context where this is included (typically within an `http`, `server`, or `location` block).
# =============================================================================

# -----------------------------------------------------------------------------
# Upstream Identification Headers
# -----------------------------------------------------------------------------
# These headers allow backend applications to identify the original client
# requesting the resource, bypassing the proxy.

# It's common to forward the Host header to the backend so that the application
# knows the hostname requested by the client.
# Variable: proxy_set_header Host
proxy_set_header Host {{ host | default('$host') }};

# It's also common to set X-Real-IP with the $remote_addr of the connection.
# This provides the actual client IP address to the backend.
# Variable: proxy_set_header X-Real-IP
proxy_set_header X-Real-IP {{ remote_addr | default('$remote_addr') }};

# -----------------------------------------------------------------------------
# Standard Proxy Forwarding Headers (X-Forwarded-*)
# -----------------------------------------------------------------------------
# X-Forwarded-{For,Proto,Host,Port} are typically proxied for reverse-proxy
# components to backends that support X-Forwarded-For parsing. These are the
# de-facto standard for conveying client connection info through proxies.

proxy_set_header X-Forwarded-For {{ proxy_add_x_forwarded_for | default('$proxy_add_x_forwarded_for') }};
proxy_set_header X-Forwarded-Proto {{ scheme | default('$scheme') }};
proxy_set_header X-Forwarded-Host {{ host | default('$host') }};
proxy_set_header X-Forwarded-Port {{ server_port | default('$server_port') }};

# -----------------------------------------------------------------------------
# Standard Forwarded Header (RFC 7239)
# -----------------------------------------------------------------------------
# X-Forwarded-For is around AND still supported, but Forwarded is also an option
# It's not natively generated in NGINX, and not all backends support it,
# but it is a standard that is an alternative to X-Forwarded-*.
# Controlled by: enable_forwarded_header (bool, default: true)
{% if enable_forwarded_header is defined and enable_forwarded_header | default(true) %}
proxy_set_header Forwarded "by=hidden;for={{ remote_addr | default('$remote_addr') }};host={{ host | default('$host') }};proto={{ scheme | default('$scheme') }}";
{% endif %}

# -----------------------------------------------------------------------------
# WebSocket and HTTP/1.1 Upgrade Support
# -----------------------------------------------------------------------------
# Upgrade, Connection, and HTTP/1.1 are usually for websockets, which are becoming
# quite common. HTTP/1.1 is required for keep-alive connections to upstreams.

proxy_set_header Upgrade {{ http_upgrade | default('$http_upgrade') }};

# Note: $req_connection is defined in conf.d/http-upgrade_req-connection_map.conf
# If that map file is not used, this often defaults to 'upgrade' or 'close' based
# on the Upgrade header presence.
proxy_set_header Connection {{ req_connection | default('$req_connection') }};

# Set the HTTP version for the connection to the upstream.
# 1.1 enables keep-alive and chunked transfer encoding support.
# Variable: proxy_http_version
proxy_http_version {{ proxy_http_version | default('1.1') }};
