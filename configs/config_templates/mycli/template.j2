# mycli configuration file
# See mycli(1) for documentation.

[mycli]

# Host address of the MySQL/MariaDB database.
# This is the hostname or IP address where the database server is listening.
host = {{ host | default('localhost') }}

# Port number to use for connection. Honors $MYSQL_TCP_PORT.
# Standard MySQL/MariaDB port is 3306.
port = {{ port | default(3306) }}

# User name to connect to the database.
# This is the MySQL user account used for authentication.
user = {{ user | default('root') }}

# The socket file to use for connection. If empty, TCP/IP is used.
# Useful for local connections via Unix domain sockets.
socket = {{ socket | default('') }}

# Password to connect to the database.
# Note: For security, consider using login-path or .my.cnf with restricted permissions (600)
password = {{ password | default('') }}

# Database to use. If empty, mycli starts without a default database.
# This is the initial schema selected upon connection.
database = {{ database | default('') }}

# Prompt format string.
# Supports variables like \t (time), \u (user), \h (host), \d (database).
prompt = {{ prompt | default('\\t \\u@\\h:\\d> ') }}

# Filename to log every query and its results to.
# Leave empty to disable query logging.
logfile = {{ logfile | default('') }}

# Suffix for reading config group.
# Allows loading specific configuration groups from my.cnf/defaults-file.
defaults_group_suffix = {{ defaults_group_suffix | default('') }}

# Path to a specific defaults file. Empty for standard locations.
# Overrides standard search paths for configuration files.
defaults_file = {{ defaults_file | default('') }}

# Login path to read credentials from the MySQL login file.
# Uses the mysql_config_editor login path for secure credential management.
login_path = {{ login_path | default('') }}