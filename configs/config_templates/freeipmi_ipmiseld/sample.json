{
  "bind_address": "0.0.0.0",
  "port": 9230,
  "user": "_ipmiseld",
  "group": "_ipmiseld",
  "device_interface": "/dev/ipmi0",
  "log_level": "INFO",
  "log_file": "/var/log/freeipmi/ipmiseld.log",
  "debug_mode": false,
  "ipmi_timeout": 10,
  "ipmi_max_retries": 5,
  "local_only": false,
  "auth_enable": true,
  "session_timeout": 600,
  "snmp_trap_enable": true,
  "snmp_trap_destinations": [
    {
      "host": "192.168.1.50",
      "port": 162,
      "community": "private"
    },
    {
      "host": "10.0.0.100",
      "port": 162,
      "community": "monitoring"
    }
  ],
  "syslog_enable": true,
  "pid_file": "/run/freeipmi/ipmiseld.pid",
  "preload_sdr": true,
  "use_secure_auth": true,
  "extra_options": "-I lanplus"
}
