{
  "LOGGING_COLOR": {
    "type": "number",
    "default": 1,
    "description": "Enable colored output in logs"
  },
  "LOGGING_PRINT_CATEGORY_HEX": {
    "type": "number",
    "default": 0,
    "description": "Print category as hex"
  },
  "LOGGING_PRINT_CATEGORY": {
    "type": "number",
    "default": 1,
    "description": "Print category name"
  },
  "LOGGING_TIMESTAMP": {
    "type": "number",
    "default": 0,
    "description": "Print timestamps in logs"
  },
  "LOGGING_PRINT_LEVEL": {
    "type": "number",
    "default": 1,
    "description": "Print log level"
  },
  "GTP_STATE_DIR": {
    "type": "string",
    "default": "/var/lib/osmocom/osmo-sgsn",
    "description": "Directory for GTP state files"
  },
  "GTP_LOCAL_IP": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Local IP address for GTP endpoint"
  },
  "GGSN_0_REMOTE_IP": {
    "type": "string",
    "default": "127.0.0.2",
    "description": "Remote IP address of GGSN 0"
  },
  "GGSN_0_GTP_VERSION": {
    "type": "number",
    "default": 1,
    "description": "GTP version for GGSN 0"
  },
  "GGSN_0_ECHO_INTERVAL": {
    "type": "number",
    "default": 60,
    "description": "Echo interval for GGSN 0 in seconds"
  },
  "AUTHENTICATION_REQUIRED": {
    "type": "string",
    "default": "required",
    "description": "Whether authentication is required"
  },
  "AUTH_POLICY": {
    "type": "string",
    "default": "remote",
    "description": "Authentication policy (e.g., remote, internal)",
    "enum": [
      "remote",
      "local"
    ],
    "enum_open": true
  },
  "GSUP_REMOTE_IP": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Remote IP address for GSUP (HSS/HLR)"
  },
  "GSUP_REMOTE_PORT": {
    "type": "number",
    "default": 4222,
    "description": "Remote port for GSUP"
  },
  "TIMER_TNS_BLOCK": {
    "type": "number",
    "default": 3,
    "description": "TNS block timer value"
  },
  "TIMER_TNS_BLOCK_RETRIES": {
    "type": "number",
    "default": 3,
    "description": "TNS block retries"
  },
  "TIMER_TNS_RESET": {
    "type": "number",
    "default": 3,
    "description": "TNS reset timer value"
  },
  "TIMER_TNS_RESET_RETRIES": {
    "type": "number",
    "default": 3,
    "description": "TNS reset retries"
  },
  "TIMER_TNS_TEST": {
    "type": "number",
    "default": 30,
    "description": "TNS test timer value"
  },
  "TIMER_TNS_ALIVE": {
    "type": "number",
    "default": 3,
    "description": "TNS alive timer value"
  },
  "TIMER_TNS_ALIVE_RETRIES": {
    "type": "number",
    "default": 10,
    "description": "TNS alive retries"
  },
  "NS_LISTEN_IP": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address to listen on for NS (Network Service)"
  },
  "NS_LISTEN_PORT": {
    "type": "number",
    "default": 23000,
    "description": "Port to listen on for NS"
  }
}
