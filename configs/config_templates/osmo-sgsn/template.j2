!
! Osmocom SGSN configuration
! This template configures the Osmocom SGSN (Serving GPRS Support Node).
! All variables are sourced from the role defaults or group/host vars.
!

! Logging configuration
! --------------------
log stderr

! Enable colored output in logs.
! Default: 1 (enabled)
logging color {{ LOGGING_COLOR | default(1) }}

! Print category as hex instead of text.
! Default: 0 (disabled)
logging print category-hex {{ LOGGING_PRINT_CATEGORY_HEX | default(0) }}

! Print category name in logs.
! Default: 1 (enabled)
logging print category {{ LOGGING_PRINT_CATEGORY | default(1) }}

! Print timestamps in logs.
! Default: 0 (disabled)
logging timestamp {{ LOGGING_TIMESTAMP | default(0) }}

! Print file basename (last component of source file) in logs.
logging print file basename last

! Print log level in logs.
! Default: 1 (enabled)
logging print level {{ LOGGING_PRINT_LEVEL | default(1) }}

! Line configuration
! ------------------
line vty
 ! Disable login for VTY access (often managed by ansible or external auth).
 no login
!

! SGSN global configuration
! -------------------------
sgsn

 ! Directory for GTP state files to allow recovery after restart.
 ! Default: /var/lib/osmocom/osmo-sgsn
 gtp state-dir {{ GTP_STATE_DIR | default('/var/lib/osmocom/osmo-sgsn') }}

 ! Local IP address for the GTP endpoint.
 ! Default: 127.0.0.1
 gtp local-ip {{ GTP_LOCAL_IP | default('127.0.0.1') }}

 ! Configuration for GGSN 0 (Gateway GPRS Support Node).
 ! Remote IP address of GGSN 0.
 ! Default: 127.0.0.2
 ggsn 0 remote-ip {{ GGSN_0_REMOTE_IP | default('127.0.0.2') }}

 ! GTP version for GGSN 0 (1 for GTPv1, 2 for GTPv2).
 ! Default: 1
 ggsn 0 gtp-version {{ GGSN_0_GTP_VERSION | default(1) }}

 ! Echo interval for GGSN 0 in seconds (keepalive).
 ! Default: 60
 ggsn 0 echo-interval {{ GGSN_0_ECHO_INTERVAL | default(60) }}

 ! Authentication requirement: 'required' or 'optional'.
 ! Default: required
 authentication {{ AUTHENTICATION_REQUIRED | default('required') }}

 ! Authentication policy: 'remote' (via HSS/GSUP) or 'internal'.
 ! Default: remote
 auth-policy {{ AUTH_POLICY | default('remote') }}

 ! GSUP (GTP7-based User Plane) remote IP for HSS/HLR connection.
 ! Default: 127.0.0.1
 gsup remote-ip {{ GSUP_REMOTE_IP | default('127.0.0.1') }}

 ! Remote port for GSUP connection to HSS/HLR.
 ! Default: 4222
 gsup remote-port {{ GSUP_REMOTE_PORT | default(4222) }}
!

! Network Service (NS) configuration
! -----------------------------------
ns

 ! TNS block timer value (seconds).
 ! Default: 3
 timer tns-block {{ TIMER_TNS_BLOCK | default(3) }}

 ! TNS block retries.
 ! Default: 3
 timer tns-block-retries {{ TIMER_TNS_BLOCK_RETRIES | default(3) }}

 ! TNS reset timer value (seconds).
 ! Default: 3
 timer tns-reset {{ TIMER_TNS_RESET | default(3) }}

 ! TNS reset retries.
 ! Default: 3
 timer tns-reset-retries {{ TIMER_TNS_RESET_RETRIES | default(3) }}

 ! TNS test timer value (seconds).
 ! Default: 30
 timer tns-test {{ TIMER_TNS_TEST | default(30) }}

 ! TNS alive timer value (seconds).
 ! Default: 3
 timer tns-alive {{ TIMER_TNS_ALIVE | default(3) }}

 ! TNS alive retries.
 ! Default: 10
 timer tns-alive-retries {{ TIMER_TNS_ALIVE_RETRIES | default(10) }}

 ! Bind UDP listener settings.
 bind udp local
  ! IP address to listen on for NS.
  ! Default: 127.0.0.1
  listen {{ NS_LISTEN_IP | default('127.0.0.1') }} {{ NS_LISTEN_PORT | default(23000) }}
  
  ! Accept IP Access mode connections.
  accept-ipaccess
!

! BSSGP (BSS GPRS Protocol) configuration
! ----------------------------------------
bssgp
!
