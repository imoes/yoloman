{
  "firebird_root_dir": "/usr/firebird",
  "tcpip_port": 3050,
  "max_connections": 200,
  "cached_pages": 4096,
  "security_database": "/etc/firebird/3.0/security2.fdb",
  "remote_access": true,
  "default_database_path": "/var/lib/firebird/data",
  "connection_timeout": 300,
  "thread_pool_size": 2,
  "lock_file_prefix": "/tmp/firebird.lock",
  "log_path": "/var/log/firebird",
  "log_max_size": 50,
  "query_logging": "none",
  "auth_server": [
    "Srp",
    "Legacy_Auth"
  ],
  "auth_client": [
    "Srp",
    "Legacy_Auth"
  ],
  "allow_user_creation": false,
  "allow_shadow_creation": true,
  "database_encryption": "none",
  "gc_max_threads": 2,
  "temp_directory": "/tmp/firebird",
  "sql_dialect": 3,
  "auto_cleanup": true,
  "lock_timeout": 30,
  "use_shared_memory": true,
  "read_ahead_pages": 32,
  "reverse_dns_lookup": false,
  "listen_addresses": [
    "127.0.0.1",
    "::1"
  ],
  "default_isolation": "SNAPSHOT",
  "default_transaction_access_mode": "READ WRITE",
  "max_transaction_count": 256,
  "aliases_file": "/etc/firebird/aliases.conf",
  "allow_config_overrides": true,
  "database_trace": false,
  "io_worker_threads": 1,
  "worker_timeout": 300,
  "remote_gstat_enabled": false,
  "remote_sql_enabled": false,
  "external_function_path": "/usr/firebird/UDF",
  "external_table_path": "/var/lib/firebird/external",
  "message_length": 8192,
  "full_text_search_enabled": false,
  "plugins": [
    {
      "name": "Srp",
      "library": "fb_srp",
      "enabled": true,
      "description": "Secure remote password authentication (modern, recommended)"
    },
    {
      "name": "Legacy_Auth",
      "library": "fb_legacy_auth",
      "enabled": true,
      "description": "Legacy authentication for older clients"
    }
  ],
  "sysdba_password": "",
  "connection_log": "none",
  "cache_encryption_key": false,
  "max_prepared_statements": 200,
  "plan_logging": false,
  "auto_reconnect_enabled": false,
  "reconnect_timeout": 10,
  "reconnect_max_retries": 3,
  "ssl_enabled": false,
  "ssl_cert_file": "/etc/firebird/ssl/server.crt",
  "ssl_key_file": "/etc/firebird/ssl/server.key",
  "ssl_ca_file": "/etc/firebird/ssl/ca.crt",
  "ssl_versions": [
    "TLSv1.2",
    "TLSv1.3"
  ],
  "ssl_verify_certs": false,
  "fips_enabled": false,
  "role_mapping_file": "/etc/firebird/role_mapping.conf",
  "max_fetch_buffer_size": 1000,
  "stats_enabled": false,
  "stats_log_path": "/var/log/firebird/stats.log",
  "shadow_auto_create": true,
  "shadow_max_count": 10,
  "shadow_directory": "/var/lib/firebird/shadows",
  "backup_logging": true,
  "idle_gc_enabled": true,
  "idle_gc_interval": 300,
  "use_huge_pages": false,
  "huge_page_size": 0,
  "config_reload_file": "/var/run/firebird/reload.conf"
}
