[sssd]
services = {{ (services | default(['nss', 'pam'])) | join(', ') }}
config_file_version = 2
{% if domains is defined and domains is not none and (domains is number or domains is boolean or domains | length > 0) %}domains = {% for d in domains %}{{ d.name }}{{ ', ' if not loop.last else '' }}{% endfor %}
{% endif %}{% for d in domains | default([]) %}
[domain/{{ d.name }}]
id_provider = {{ d.id_provider }}
{% if d.auth_provider is defined and d.auth_provider %}auth_provider = {{ d.auth_provider }}
{% endif %}{% for o in d.options | default([]) %}{{ o.key }} = {{ o.value }}
{% endfor %}{% endfor %}