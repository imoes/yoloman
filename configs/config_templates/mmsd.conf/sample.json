{
  "service": {
    "name": "mmsd",
    "runtime_dir": "/run/mmsd",
    "max_connections": 150,
    "worker_count": 6,
    "host": "127.0.0.1",
    "port": 5555,
    "ssl_enabled": true,
    "ssl_cert_chain": "/etc/ssl/certs/mmsd.crt",
    "ssl_key": "/etc/ssl/private/mmsd.key",
    "allowed_origins": [
      "https://mms.example.com",
      "https://web.example.com"
    ],
    "log_level": "INFO",
    "log_file": "/var/log/mmsd/mmsd.log",
    "verbose": false,
    "backend_timeout": 45,
    "max_retries": 5,
    "health_endpoint_enabled": true,
    "health_endpoint_path": "/healthz"
  }
}
