# /etc/crypttab: mappings for encrypted block devices (LUKS)
# Format: <name> <device> <keyfile> <options>
# See `man crypttab` for details.
{% for entry in crypttab_entries %}
{{ entry.name }} {{ entry.device }} {% if entry.keyfile %}{{ entry.keyfile }}{% else %}-{% endif %} {{ entry.options | join(', ') }}{% endfor %}