{
  "version": "3.35",
  "conf_d_dir": "/etc/syslog-ng/conf.d/",
  "flush_lines": "0",
  "time_reopen": "10",
  "log_fifo_size": "1000",
  "chain_hostnames": "off",
  "use_dns": "no",
  "use_fqdn": "no",
  "create_dirs": "no",
  "keep_hostname": "yes",
  "path_dev_console": "/dev/console",
  "path_var_log_messages": "/var/log/messages",
  "path_var_log_secure": "/var/log/secure",
  "path_var_log_maillog": "/var/log/maillog",
  "mail_flush_lines": "10",
  "path_var_log_spooler": "/var/log/spooler",
  "path_var_log_boot_log": "/var/log/boot.log",
  "path_var_log_cron": "/var/log/cron",
  "path_var_log_kern": "/var/log/kern",
  "include_conf_d_glob": "/etc/syslog-ng/conf.d/*.conf"
}
