{
  "log_file": "/var/log/ironic-inspector/inspector.log",
  "log_dir": "/var/log/ironic-inspector",
  "log_level": "INFO",
  "debug": false,
  "api_host": "0.0.0.0",
  "api_port": 5050,
  "tls_enabled": false,
  "api_cert_file": "",
  "api_cert_key_file": "",
  "api_ca_cert_file": "",
  "keystone_auth_url": "http://keystone:5000/v3",
  "keystone_project_name": "service",
  "keystone_username": "ironic-inspector",
  "keystone_password": "IRONIC_INSPECTOR_PASS",
  "keystone_region_name": "RegionOne",
  "keystone_auth_type": "password",
  "keystone_service_token": "",
  "db_connection": "postgresql://ironic_inspector:INSPECTOR_DB_PASS@db/ironic_inspector",
  "db_max_retries": 20,
  "db_retry_interval": 3,
  "ironic_auth_url": "http://ironic-api:6385/v1",
  "ironic_project_name": "service",
  "ironic_username": "ironic",
  "ironic_password": "IRONIC_PASS",
  "ironic_region_name": "RegionOne",
  "ironic_auth_type": "password",
  "ironic_service_token": "",
  "ironic_insecure": false,
  "ironic_cafile": "/etc/ironic-inspector/ssl/ca.crt",
  "dhcp_provider": "neutron",
  "neutron_url": "http://neutron:9696",
  "neutron_project_id": "service",
  "neutron_username": "neutron",
  "neutron_password": "NEUTRON_PASS",
  "neutron_auth_url": "http://keystone:5000/v3",
  "neutron_region_name": "RegionOne",
  "neutron_auth_type": "password",
  "allow_overwrite": false,
  "extra_hooks": [
    "deploy_steps",
    "collect_logs"
  ],
  "ports_to_open": [
    "67",
    "68",
    "69",
    "4011"
  ],
  "node_cleanup": true,
  "cleanup_delay": 120,
  "power_off": true,
  "power_off_timeout": 300,
  "event_notifications": true,
  "metrics_notifications": false,
  "notification_level": "INFO",
  "ssl_enabled": false,
  "ssl_cert_file": "/etc/ironic-inspector/ssl/ironic-inspector.crt",
  "ssl_key_file": "/etc/ironic-inspector/ssl/ironic-inspector.key",
  "ssl_ca_file": "/etc/ironic-inspector/ssl/ca.crt",
  "store_data": true,
  "data_dir": "/var/lib/ironic-inspector/data",
  "hooks_enabled": true,
  "power_on_timeout": 300,
  "ipmi_timeout": 30,
  "node_present_timeout": 120,
  "discovery_timeout": 3600
}
