# Main configuration file for OpenStack Ironic Inspector
# (hardware introspection/discovery service for Ironic)
# Generated via Jinja2 template — do not edit directly

[DEFAULT]
# Path to the log file for the Inspector service.
log_file = {{ log_file | default('/var/log/ironic-inspector/inspector.log') }}
# Directory where log files are stored.
log_dir = {{ log_dir | default('/var/log/ironic-inspector') }}
# Logging level: debug, info, warning, error, or critical.
log_level = {{ log_level | default('INFO') }}
# Enable debug mode for verbose logging.
debug = {{ debug | default(False) | lower }}

# API service configuration
[api]
# IP address or hostname to bind the Inspector API server.
host = {{ api_host | default('0.0.0.0') }}
# Port number for the Inspector API server.
port = {{ api_port | default(5050) }}
# Enable TLS encryption for the Inspector API.
tls_enabled = {{ tls_enabled | default(False) | lower }}
# Path to the TLS certificate file for the Inspector API (if TLS enabled).
api_cert_file = {{ api_cert_file | default('') }}
# Path to the TLS private key file for the Inspector API.
api_key_file = {{ api_cert_key_file | default('') }}
# Path to the CA certificate for validating client TLS certificates.
api_ca_cert_file = {{ api_ca_cert_file | default('') }}

# Authentication configuration (Keystone endpoint)
[keystone]
# Keystone authentication endpoint URL (e.g., http://keystone:5000/v3).
auth_url = {{ keystone_auth_url | default('http://keystone:5000/v3') }}
# OpenStack project (tenant) name for the Inspector service account.
project_name = {{ keystone_project_name | default('service') }}
# Service account username for authenticating to Keystone.
username = {{ keystone_username | default('ironic-inspector') }}
# Password for the service account. Must be set to a secure value.
password = {{ keystone_password | default('') }}
# OpenStack region name where services are deployed (optional).
region_name = {{ keystone_region_name | default('') }}
# Authentication type: 'password' or 'token' (rarely used for service accounts).
auth_type = {{ keystone_auth_type | default('password') }}
# Shared secret token used for service-to-service authentication (only if auth_type='token').
service_token = {{ keystone_service_token | default('') }}

# Database configuration (used for storing introspection data)
[database]
# SQLAlchemy database connection string (e.g., postgresql://user:pass@db/inspector).
connection = {{ db_connection | default('sqlite:///var/lib/ironic-inspector/inspector.db') }}
# Maximum number of retries to reconnect to the database on startup.
max_retries = {{ db_max_retries | default(20) }}
# Interval (seconds) between database connection retries.
retry_interval = {{ db_retry_interval | default(3) }}

# Ironic client configuration (to interact with Ironic API)
[ironic]
# Ironic API endpoint URL.
auth_url = {{ ironic_auth_url | default('http://ironic-api:6385/v1') }}
# Project name used to authenticate to Ironic.
project_name = {{ ironic_project_name | default('service') }}
# Username for the Ironic service account.
username = {{ ironic_username | default('ironic') }}
# Password for the Ironic service account.
password = {{ ironic_password | default('') }}
# Region name for Ironic (optional).
region_name = {{ ironic_region_name | default('') }}
# Ironic auth type (usually 'password').
auth_type = {{ ironic_auth_type | default('password') }}
# Service token used for token-based auth to Ironic (optional).
service_token = {{ ironic_service_token | default('') }}
# Disable SSL certificate verification when connecting to Ironic (not recommended in production).
insecure = {{ ironic_insecure | default(False) | lower }}
# CA certificate file to verify Ironic server certs (if insecure=false).
cafile = {{ ironic_cafile | default('') }}

# PXE and DHCP configuration (for network boot)
[dhcp]
# DHCP provider: 'neutron' or 'none' (to disable DHCP provisioning).
dhcp_provider = {{ dhcp_provider | default('neutron') }}
# Neutron API endpoint URL (used if dhcp_provider=neutron).
neutron_url = {{ neutron_url | default('http://neutron:9696') }}
# Project (tenant) ID for Neutron operations (e.g., port management).
neutron_project_id = {{ neutron_project_id | default('') }}
# Username for Neutron service account.
neutron_username = {{ neutron_username | default('neutron') }}
# Password for Neutron service account.
neutron_password = {{ neutron_password | default('') }}
# Keystone auth URL used by the Inspector for Neutron auth.
neutron_auth_url = {{ neutron_auth_url | default('http://keystone:5000/v3') }}
# Region name for Neutron (optional).
neutron_region_name = {{ neutron_region_name | default('') }}
# Neutron auth type: 'password' or 'token'.
neutron_auth_type = {{ neutron_auth_type | default('password') }}
# Allow overwriting existing PXE boot files for nodes.
allow_overwrite = {{ allow_overwrite | default(False) | lower }}

# Discovery configuration
[processing]
# List of extra Python module paths for processing hooks (e.g., custom introspection logic).
extra_hooks = {{ extra_hooks | default(['deploy_steps', 'ramdisk_logs', 'collect_logs']) | join(', ') }}
# Comma-separated list of UDP/TCP ports to open in security groups (e.g., for PXE/DHCP).
ports_to_open = {{ ports_to_open | default(['67', '68', '69', '4011']) | join(', ') }}
# Automatically clean up nodes in 'inspect' state after a timeout.
node_cleanup = {{ node_cleanup | default(True) | lower }}
# Time (seconds) before cleaning up nodes left in 'inspect' state.
cleanup_delay = {{ cleanup_delay | default(120) }}
# Power off nodes after successful introspection.
power_off = {{ power_off | default(True) | lower }}
# Maximum time (seconds) to wait for node to power off.
power_off_timeout = {{ power_off_timeout | default(300) }}
# Send Nova events on introspection completion (for scheduling integration).
event_notifications = {{ event_notifications | default(False) | lower }}
# Send Ceilometer metrics (deprecated in favor of Telemetry).
metrics_notifications = {{ metrics_notifications | default(False) | lower }}
# Minimum level for sending notifications: 'INFO', 'WARNING', or 'ERROR'.
notification_level = {{ notification_level | default('INFO') }}

# TLS/SSL configuration for internal services (e.g., ironic client TLS)
[ssl]
# Enable TLS for internal services (e.g., ironic client TLS).
enabled = {{ ssl_enabled | default(False) | lower }}
# Path to server certificate for TLS.
cert_file = {{ ssl_cert_file | default('/etc/ironic-inspector/ssl/ironic-inspector.crt') }}
# Path to private key for TLS.
key_file = {{ ssl_key_file | default('/etc/ironic-inspector/ssl/ironic-inspector.key') }}
# Path to CA certificate for TLS verification.
ca_file = {{ ssl_ca_file | default('/etc/ironic-inspector/ssl/ca.crt') }}

# Reporting configuration
[report]
# Store raw introspection data for debugging and analysis.
store_data = {{ store_data | default(True) | lower }}
# Directory for storing introspection data files.
data_dir = {{ data_dir | default('/var/lib/ironic-inspector/data') }}

# Hooks configuration (for custom introspection logic)
[dispatch]
# Enable hook-based processing pipeline during introspection.
enabled = {{ hooks_enabled | default(True) | lower }}

# Time configuration (e.g., timeouts)
[timeouts]
# Timeout (seconds) for powering on a node before giving up.
power_on_timeout = {{ power_on_timeout | default(300) }}
# Timeout (seconds) for IPMI commands (e.g., PXE boot wait).
ipmi_timeout = {{ ipmi_timeout | default(30) }}
# Timeout (seconds) for a node to appear in Ironic after being registered.
node_present_timeout = {{ node_present_timeout | default(120) }}
# Maximum time (seconds) allowed for the entire introspection process.
discovery_timeout = {{ discovery_timeout | default(3600) }}