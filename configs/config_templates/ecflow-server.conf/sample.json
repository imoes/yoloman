{
  "host": "0.0.0.0",
  "port": 31415,
  "data_dir": "/var/lib/ecflow-server",
  "log_level": "INFO",
  "log_file": "/var/log/ecflow-server/ecflow-server.log",
  "log_max_size_mb": 100,
  "log_keep_count": 5,
  "num_workers": 4,
  "http_timeout": 30,
  "enable_https": true,
  "tls_cert_file": "/etc/ssl/certs/ecflow-server.crt",
  "tls_key_file": "/etc/ssl/private/ecflow-server.key",
  "auth_enabled": true,
  "auth_password_file": "/etc/ecflow-server/passwd",
  "auth_token_expiry": 86400,
  "allowed_clients": [
    {
      "network": "10.0.0.0/8",
      "desc": "Internal corporate network"
    },
    {
      "network": "192.168.1.0/24",
      "desc": "Workflow admin workstations"
    }
  ],
  "restart_on_config_change": false,
  "heartbeat_interval": 30,
  "debug_endpoints": false,
  "smtp_enabled": true,
  "smtp_host": "smtp.example.com",
  "smtp_port": 587,
  "smtp_from_addr": "ecflow@example.com",
  "smtp_use_tls": true,
  "smtp_username": "ecflow-alerts",
  "admin_emails": [
    "admin@example.com",
    "ops@example.com"
  ],
  "failover": true,
  "failover_peer_host": "ecflow-backup.example.com",
  "failover_peer_port": 31415
}
