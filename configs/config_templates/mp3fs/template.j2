# mp3fs configuration generated by Ansible (Jinja2)
# mp3fs is a FUSE filesystem that presents FLAC/Ogg Vorbis files as MP3.
# This template generates the command-line invocation arguments for systemd or shell scripts.
# Each field is documented with its schema description for self-explanatory configuration.

# Source directory containing FLAC/OGG files
# Corresponds to IN_DIR argument
source_dir: {{ source_dir | default('/var/lib/mp3fs/source') }}

# Mount point directory for the virtual MP3 filesystem
# Corresponds to OUT_DIR argument
mount_point: {{ mount_point | default('/var/lib/mp3fs/mp3') }}

# Bitrate for MP3 encoding (e.g., 128, 192, 320)
# Corresponds to -b or --obitrate
bitrate: {{ bitrate | default(128) }}

# LAME quality setting (0-9, where 0 is best/slowest)
# Corresponds to --quality or --oquality
quality: {{ quality | default(5) }}

# Use Variable Bit Rate encoding
# Corresponds to --vbr or -ovbr
vbr_enabled: {{ vbr_enabled | default(true) }}

# ReplayGain mode (0: Ignore, 1: Album prefer, 2: Track prefer)
# Corresponds to --gainmode or --ogainmode
gain_mode: {{ gain_mode | default(1) }}

# Reference loudness for ReplayGain in dB
# Corresponds to --gainref or --ogainref
gain_ref_db: {{ gain_ref_db | default(89) }}

# Cache size for stat entries (positive integer)
# Corresponds to --statcachesize or --ostatcachesizes
stat_cache_size: {{ stat_cache_size | default(1000) }}

# Log file path
# Corresponds to --logfile
log_file: {{ log_file | default('/var/log/mp3fs.log') }}

# Enable logging to stderr
# Corresponds to --log-stderr
log_stderr: {{ log_stderr | default(false) }}

# Enable logging to syslog
# Corresponds to --log-syslog
log_syslog: {{ log_syslog | default(false) }}

# Maximum log level (ERROR, INFO, DEBUG)
# Corresponds to --log-maxlevel
log_max_level: {{ log_max_level | default('INFO') }}

# Run in foreground (useful for debugging or direct execution)
# Corresponds to -f
foreground: {{ foreground | default(false) }}

# Single-threaded operation
# Corresponds to -s
single_threaded: {{ single_threaded | default(false) }}

# Enable debug output (implies foreground)
# Corresponds to -d or -odebug
debug: {{ debug | default(false) }}

# Command to execute
exec: mp3fs

# Build arguments
# This block constructs the actual command-line arguments for mp3fs based on the settings above.
args: >-
  {% if debug | default(false) %}-d {% endif %}
  {% if foreground | default(false) %}-f {% endif %}
  {% if single_threaded | default(false) %}-s {% endif %}
  {% if vbr_enabled | default(true) %}--vbr {% endif %}
  -b {{ bitrate | default(128) }}
  --quality {{ quality | default(5) }}
  --gainmode {{ gain_mode | default(1) }}
  {% if gain_ref_db | default(89) != 89 %}--gainref {{ gain_ref_db | default(89) }} {% endif %}
  --statcachesize {{ stat_cache_size | default(1000) }}
  {% if log_file | default('/var/log/mp3fs.log') %}--logfile {{ log_file | default('/var/log/mp3fs.log') }} {% endif %}
  {% if log_stderr | default(false) %}--log-stderr {% endif %}
  {% if log_syslog | default(false) %}--log-syslog {% endif %}
  --log-maxlevel {{ log_max_level | default('INFO') }}
  {{ source_dir | default('/var/lib/mp3fs/source') }} {{ mount_point | default('/var/lib/mp3fs/mp3') }}