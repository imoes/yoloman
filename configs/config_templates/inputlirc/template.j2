# =============================================================================
# inputlirc configuration template
# =============================================================================
# This configuration file controls the behavior of the inputlirc daemon.
# It specifies which input event devices to monitor and any additional
# command-line arguments to pass to the daemon process.
#
# Managed by Ansible. Do not edit manually; changes will be overwritten.
# =============================================================================

# -----------------------------------------------------------------------------
# List of input event device paths (e.g., `/dev/input/event0`) to monitor for
# IR events. Leave empty to auto-detect devices.
# -----------------------------------------------------------------------------
# If the list is empty or not provided, inputlirc will attempt to
# automatically detect available IR input devices.
EVENTS={{ (events | default(['/dev/input/event*'])) | join(' ') }}

# -----------------------------------------------------------------------------
# Additional command-line options to pass to the `inputlirc` daemon
# (e.g., `--debug --dry-run`).
# -----------------------------------------------------------------------------
# These options are appended directly to the daemon's startup command.
# Common options include debugging flags, dry-run modes, or specific
# protocol definitions. Leave empty for default behavior.
OPTIONS={{ options | default('') }}