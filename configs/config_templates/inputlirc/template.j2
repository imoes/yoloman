# /etc/default/inputlirc — Configuration for the inputlirc daemon
# Zeroconf LIRC daemon using Linux input event devices (e.g., /dev/input/eventX)
# Enables automatic mapping of remote controls via evdev events.

# Comma-separated list of input event device paths to monitor
# Leave empty to auto-detect and use all devices with LIRC capabilities
INPUT_DEVICES="{{ input_devices | join(',') }}"

# Driver to use for input-to-LIRC mapping (typically 'uinput' for zeroconf)
DRIVER="{{ driver }}"

# LIRC device node path (must be writable by the inputlirc user)
LIRC_DEVICE="{{ lirc_device }}"

# Optional: Additional options passed directly to inputlirc(8) on startup
# Example: --debug, --dry-run, --disable-udev
OPTIONS="{{ options | default('') }}"

# User/group under which inputlirc runs (usually 'inputlirc' or 'root')
USER="{{ user }}"
GROUP="{{ group }}"

# Enable/disable automatic reload of configuration on device changes (true/false)
AUTO_RELOAD={{ auto_reload | lower }}
