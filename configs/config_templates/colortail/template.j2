# colortail configuration template
# This template generates the configuration file for `colortail`,
# a tool that tails log files and applies color highlighting based on regex patterns.
# Each section defines a COLOR rule: a color name and a set of regex patterns
# to match against log lines.

# Color for date matching regex blocks.
COLOR {{ color_date | default('magenta') }}
{
# matches the date
^(... ..).*$
}

# Color for time matching regex blocks.
COLOR {{ color_time | default('cyan') }}
{
# matches the time
^... .. (..:..:..).*$
}

# Color for hostname matching regex blocks.
COLOR {{ color_hostname | default('green') }}
{
# matches the hostname
^... .. ..:..:.. ([^ ]+).*$
}

# Color for program name matching regex blocks.
COLOR {{ color_program | default('yellow') }}
{
# matches the "program" that wrote to syslog
^... .. ..:..:.. [^ ]+ ([^ ]+)
}

# Color for IP address matching regex blocks.
COLOR {{ color_ip | default('brightyellow') }}
{
# matches all ip adresses
^.*([0-9]{3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*$
^.*([0-9]{2}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*$
^.*([0-9]{1}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*$
# matches two ip adresses in one line
^.*([0-9]{3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*([0-9]{3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*$
^.*([0-9]{2}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*([0-9]{2}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*$
^.*([0-9]{1}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*([0-9]{1}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}).*$
}

# Color for root/DENY matching regex blocks.
COLOR {{ color_deny_root | default('brightred') }}
{
# matches the word root
^.*(root).*$
# matches DENY
^.*(ppp-in DENY ppp0).*$
^.*(eth-in DENY eth0).*$
}

# Color for program output matching regex blocks.
COLOR {{ color_program_output | default('brightblue') }}
{
# matches the output from the "program"
^... .. ..:..:.. [^ ]+ [^ ]+ (.*)
}