{
  "job_store": "file:./toil-jobstore",
  "batch_system": "slurm",
  "clean": "onSuccess",
  "default_memory": "4G",
  "default_cores": 2,
  "default_disk": "10G",
  "retry_count": 2,
  "log_level": "DEBUG",
  "log_file": "/var/log/toil/run.log",
  "write_logs": "/var/log/toil/jobs",
  "work_dir": "/scratch/toil-work",
  "enable_stats": true,
  "restart": false,
  "max_jobs": 100,
  "max_memory": "64G",
  "max_cores": "32G",
  "max_disk": "500G",
  "config_file": ""
}
