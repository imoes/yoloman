# Toil Configuration File
# Auto-generated by Ansible.
# This file configures the Toil workflow engine.
# For more details, see: http://toil.readthedocs.io/

[TOIL]

# The job store location. Can be a local path (file:./store), AWS S3 (aws:region:bucket),
# or Google Cloud Storage (gce:project:bucket).
jobStore = {{ job_store | default('file:./jobstore') }}

# The batch system to run jobs on. Supported systems include single_machine, slurm,
# kubernetes, lsf, torque, htcondor, grid_engine, and mesos.
batchSystem = {{ batch_system | default('single_machine') }}

# Determines deletion of the jobStore upon completion. Choices: 'always', 'onError',
# 'never', or 'onSuccess'.
clean = {{ clean | default('onSuccess') }}

# The default memory requirement for jobs that do not specify an explicit value.
# Standard suffixes like K, M, G are supported.
defaultMemory = {{ default_memory | default('2G') }}

# The default number of CPU cores for jobs. Fractions of a core are supported on some batch systems.
defaultCores = {{ default_cores | default(1) }}

# The default disk space requirement for jobs that do not specify an explicit value.
defaultDisk = {{ default_disk | default('2G') }}

# Number of times to retry a failing job before giving up.
retryCount = {{ retry_count | default(1) }}

# The logging level. Choices: OFF, ERROR, WARNING, INFO, DEBUG, TRACE.
logLevel = {{ log_level | default('INFO') }}

# Path to a file to write the main logging output to. Empty string disables file logging.
logFile = {{ log_file | default('') }}

# Directory to write worker logs into. Empty string disables per-job log files.
writeLogs = {{ write_logs | default('') }}

# Absolute path to directory where temporary files are placed. Empty string uses system default.
workDir = {{ work_dir | default('') }}

# If true, records statistics about the workflow for later analysis with toil stats.
stats = {{ enable_stats | default(False) | ternary('true', 'false') }}

# If true, attempts to restart an existing workflow from the specified job store.
restart = {{ restart | default(False) | ternary('true', 'false') }}

# Maximum number of jobs to submit to the scheduler at once. 0 means unlimited.
maxJobs = {{ max_jobs | default(0) }}

# Maximum amount of memory to request from the batch system. 0 means unlimited.
maxMemory = {{ max_memory | default('0G') }}

# Maximum number of CPU cores to request. 0 means unlimited. Standard suffixes like G, Mi apply.
maxCores = {{ max_cores | default('0G') }}

# Maximum amount of disk space to request. 0 means unlimited.
maxDisk = {{ max_disk | default('0G') }}

# Path to an external Toil configuration YAML file. Empty string uses defaults.
config = {{ config_file | default('') }}