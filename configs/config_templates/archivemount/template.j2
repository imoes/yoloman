# archivemount configuration template
# This template generates the command-line invocation for archivemount to
# mount an archive file as a FUSE filesystem.
# It is intentionally minimal because archivemount is a CLI tool, not a daemon
# with a complex configuration file.

# archivemount command invocation
# -o : Passes a comma-separated list of FUSE/archivemount-specific options.
#      Each option in the 'options' list is joined here.
# archive_path : The absolute or relative path to the archive file to mount.
# mount_point : The directory where the archive will be mounted.
archivemount -o {{ options | default([]) | join(',') }} {{ archive_path | default('tar') }} {{ mount_point | default('') }}