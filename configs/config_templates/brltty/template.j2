# to the speech driver.
# Colon-separated driver:parameters string for speech driver (e.g., en:Voice=en).
# (can be specified more than once)
# (can be overridden with the --speech-parameters= [-S] option)
{% if speech_driver_params | default('') | trim != '' %}
speech-parameters {{ speech_driver_params | default('') }}
{% endif %}

