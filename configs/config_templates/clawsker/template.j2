# ==============================================================================
# Claws Mail Configuration Tool (Clawsker)
# ==============================================================================
# This file documents the configuration options for Clawsker, a tool to
# securely edit Claws Mail configuration files.
#
# Generated by Ansible Jinja2 template.
# ==============================================================================

{% if config_dir | default('') != '' %}
# Alternate Claws Mail configuration directory.
# Equivalent to the -a/--alternate-config-dir command-line option.
# Sets the path where Claws Mail stores its configuration files.
-a {{ config_dir | default('') }}
{% endif %}

{% if clawsrc | default('') != '' %}
# Explicit Claws Mail resource configuration filename.
# Equivalent to the -c/--clawsrc command-line option.
# Overrides the default location of the clawsrc file.
-c {{ clawsrc | default('') }}
{% endif %}

{% if use_claws_version | default('') != '' %}
# Target Claws Mail version for compatibility checks.
# Equivalent to the -u/--use-claws-version command-line option.
# Format: dot-separated integers (e.g., '3.17.8').
-u {{ use_claws_version | default('') }}
{% endif %}

{% if ignore_versions | default(False) | bool %}
# Disable version checks.
# Equivalent to the -i/--ignore-versions command-line option.
# Prevents Clawsker from verifying the Claws Mail version against the target.
-i
{% endif %}

{% if hide_disabled_keys | default(False) | bool %}
# Hide unassigned hotkeys in the UI.
# Equivalent to the -k/--hide-disabled-keys command-line option.
# Makes hotkeys that are not currently assigned invisible until selected.
-k
{% endif %}

{% if read_only | default(False) | bool %}
# Run in read-only mode.
# Equivalent to the -r/--read-only command-line option.
# Disables saving any changes to the configuration file.
-r
{% endif %}

{% if small_screen | default(False) | bool %}
# Force UI adjustments for small screens.
# Equivalent to the -s/--small-screen command-line option.
# Optimizes the interface layout for smaller display resolutions.
-s
{% endif %}

{% if verbose | default(False) | bool %}
# Enable verbose output.
# Equivalent to the -b/--verbose command-line option.
# Prints detailed status and debug information to stdout.
-b
{% endif %}