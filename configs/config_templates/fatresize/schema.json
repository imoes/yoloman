{
  "device": {
    "type": "string",
    "default": "",
    "description": "Device path (e.g., /dev/sdb1) to resize or query."
  },
  "size": {
    "type": "string",
    "default": "",
    "description": "Target size with unit suffix (e.g., 2G, 512M, max) or empty for info-only mode."
  },
  "info": {
    "type": "bool",
    "default": false,
    "description": "Show volume information only (no resizing)."
  },
  "progress": {
    "type": "bool",
    "default": false,
    "description": "Show resize progress."
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Suppress output messages (except errors)."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output."
  }
}
