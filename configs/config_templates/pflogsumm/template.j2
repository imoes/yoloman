# /etc/default/pflogsumm — Configuration for the pflogsumm cron job
# This file is sourced by the cron entry to configure pflogsumm behavior.
# pflogsumm analyzes Postfix mail logs and emails a summary report.

# Enable or disable the pflogsumm cron job.
# When set to false, the cron job will not run the summary.
# Schema default: True
ENABLED={{ enabled | default(True) | lower }}

# Primary Postfix log file to analyze.
# Common paths: /var/log/mail.log or /var/log/maillog depending on the distro.
# Schema default: /var/log/mail.log
LOG_FILE={{ log_file | default('/var/log/mail.log') }}

# List of extra log files to include (e.g., rotated logs).
# These are joined into a space-separated string for the command line.
# Schema default: []
EXTRA_LOGS={{ extra_logs | default([]) | join(' ') }}

# Email address that receives the log summary report.
# Schema default: postmaster@example.com
MAIL_TO={{ mail_to | default('postmaster@example.com') }}

# Email sender address.
# Leave empty to use the system default (usually 'postfix').
# Schema default: ''
MAIL_FROM={{ mail_from | default('') }}

# Prefix for the email subject line.
# Example: '[pflogsumm]'
# Schema default: 'Postfix Log Summary'
MAIL_SUBJECT_PREFIX='{{ mail_subject_prefix | default('Postfix Log Summary') }}'

# Number of days of logs to summarize.
# Set to 0 to summarize all available logs (ignores rotation limits).
# Schema default: 1
DAYS={{ days | default(1) }}

# Include verbose details in the summary.
# When true, includes per-host statistics and more granular data.
# Schema default: False
VERBOSE={{ verbose | default(False) | lower }}

# Include detailed sender/recipient lists in the summary.
# Note: This can produce very large output for busy mail servers.
# Schema default: False
DETAILED={{ detailed | default(False) | lower }}

# Time zone offset in minutes (e.g., +60 for UTC+1).
# Leave empty to use the system's configured time zone.
# Schema default: ''
TZ_OFFSET='{{ tz_offset | default('') }}'

# Full path to the pflogsumm executable.
# Schema default: /usr/sbin/pflogsumm
PFLOGSUMM_BIN='{{ pflogsumm_bin | default('/usr/sbin/pflogsumm') }}'

# Additional command-line arguments passed to pflogsumm.
# Example: '--bounce=10 --no_dkim'
# Schema default: ''
PFLOGSUMM_ARGS='{{ pflogsumm_args | default('') }}'