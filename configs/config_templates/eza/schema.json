{
  "display_options": {
    "type": "object",
    "default": null,
    "description": "Map of display options to enable/disable flags"
  },
  "display_options.grid": {
    "type": "bool",
    "default": true,
    "description": "Display entries as a grid (default)"
  },
  "display_options.oneline": {
    "type": "bool",
    "default": false,
    "description": "Display one entry per line"
  },
  "display_options.long": {
    "type": "bool",
    "default": false,
    "description": "Display extended file metadata as a table"
  },
  "display_options.recurse": {
    "type": "bool",
    "default": false,
    "description": "Recurse into directories"
  },
  "display_options.tree": {
    "type": "bool",
    "default": false,
    "description": "Recurse into directories as a tree"
  },
  "display_options.follow_symlinks": {
    "type": "bool",
    "default": false,
    "description": "Drill down into symbolic links that point to directories"
  },
  "display_options.dereference": {
    "type": "bool",
    "default": false,
    "description": "Dereference symbolic links when displaying information"
  },
  "display_options.across": {
    "type": "bool",
    "default": false,
    "description": "Sort the grid across, rather than downwards"
  },
  "display_options.color": {
    "type": "string",
    "default": "automatic",
    "description": "When to use terminal colours: 'always', 'automatic', or 'never'",
    "enum": [
      "always",
      "automatic",
      "never"
    ]
  },
  "display_options.color_scale": {
    "type": "bool",
    "default": false,
    "description": "Highlight levels of field distinctly (size/age)"
  },
  "display_options.color_scale_mode": {
    "type": "string",
    "default": "gradient",
    "description": "Use gradient or fixed colors in color-scale",
    "enum": [
      "fixed",
      "gradient"
    ]
  },
  "display_options.icons": {
    "type": "string",
    "default": "automatic",
    "description": "When to display icons: 'always', 'automatic', or 'never'",
    "enum": [
      "always",
      "automatic",
      "never"
    ]
  },
  "display_options.no_quotes": {
    "type": "bool",
    "default": false,
    "description": "Don't quote file names with spaces"
  },
  "display_options.hyperlink": {
    "type": "bool",
    "default": false,
    "description": "Display entries as hyperlinks"
  },
  "display_options.width": {
    "type": "number",
    "default": null,
    "description": "Set screen width in columns"
  },
  "filtering_options": {
    "type": "object",
    "default": null,
    "description": "Map of filtering/sorting options"
  },
  "filtering_options.all": {
    "type": "bool",
    "default": false,
    "description": "Show hidden and dot files"
  },
  "filtering_options.almost_all": {
    "type": "bool",
    "default": false,
    "description": "Equivalent to --all"
  },
  "filtering_options.list_dirs": {
    "type": "bool",
    "default": false,
    "description": "List directories as regular files"
  },
  "filtering_options.level": {
    "type": "number",
    "default": null,
    "description": "Limit the depth of recursion"
  },
  "filtering_options.reverse": {
    "type": "bool",
    "default": false,
    "description": "Reverse the sort order"
  },
  "filtering_options.sort": {
    "type": "string",
    "default": "name",
    "description": "Field to sort by: 'name', 'size', 'modified', etc.",
    "enum": [
      "name",
      "Name",
      "extension",
      "Extension",
      "size",
      "modified",
      "date",
      "time",
      "newest",
      "changed",
      "accessed",
      "created",
      "inode",
      "type",
      "none",
      "age",
      "oldest"
    ]
  },
  "filtering_options.ignore_glob": {
    "type": "list",
    "default": [],
    "description": "Glob patterns (pipe-separated) of files to ignore"
  },
  "filtering_options.git_ignore": {
    "type": "bool",
    "default": false,
    "description": "Do not list files ignored by Git"
  },
  "filtering_options.group_directories_first": {
    "type": "bool",
    "default": false,
    "description": "List directories before other files"
  },
  "filtering_options.group_directories_last": {
    "type": "bool",
    "default": false,
    "description": "List directories after other files"
  },
  "filtering_options.only_dirs": {
    "type": "bool",
    "default": false,
    "description": "List only directories"
  },
  "filtering_options.only_files": {
    "type": "bool",
    "default": false,
    "description": "List only files"
  },
  "filtering_options.show_symlinks": {
    "type": "bool",
    "default": false,
    "description": "Explicitly show symbolic links"
  },
  "filtering_options.no_symlinks": {
    "type": "bool",
    "default": false,
    "description": "Do not show symbolic links"
  },
  "long_options": {
    "type": "object",
    "default": null,
    "description": "Map of long view (--long) options"
  },
  "long_options.binary": {
    "type": "bool",
    "default": false,
    "description": "List file sizes with binary prefixes"
  },
  "long_options.bytes": {
    "type": "bool",
    "default": false,
    "description": "List file sizes in bytes"
  },
  "long_options.changed": {
    "type": "bool",
    "default": false,
    "description": "Use the changed timestamp field"
  },
  "long_options.group": {
    "type": "bool",
    "default": false,
    "description": "List each file's group"
  },
  "long_options.smart_group": {
    "type": "bool",
    "default": false,
    "description": "Only show group if different from owner"
  },
  "long_options.header": {
    "type": "bool",
    "default": false,
    "description": "Add a header row to each column"
  },
  "long_options.links": {
    "type": "bool",
    "default": false,
    "description": "List each file's number of hard links"
  },
  "long_options.inode": {
    "type": "bool",
    "default": false,
    "description": "List each file's inode number"
  },
  "long_options.modified": {
    "type": "bool",
    "default": false,
    "description": "Use the modified timestamp field"
  },
  "long_options.mounts": {
    "type": "bool",
    "default": false,
    "description": "Show mount details (Linux/Mac only)"
  },
  "long_options.numeric": {
    "type": "bool",
    "default": false,
    "description": "List numeric user and group IDs"
  },
  "long_options.flags": {
    "type": "bool",
    "default": false,
    "description": "List file flags/attributes"
  },
  "long_options.blocksize": {
    "type": "bool",
    "default": false,
    "description": "List allocated filesystem block size"
  },
  "long_options.time": {
    "type": "string",
    "default": "modified",
    "description": "Timestamp field to list: 'modified', 'changed', 'accessed', 'created'",
    "enum": [
      "modified",
      "changed",
      "accessed",
      "created"
    ]
  },
  "long_options.time_style": {
    "type": "string",
    "default": "default",
    "description": "Format style for timestamps: 'default', 'iso', 'long-iso', 'full-iso', 'relative', or custom",
    "enum": [
      "default",
      "iso",
      "long-iso",
      "full-iso",
      "relative"
    ]
  },
  "long_options.total_size": {
    "type": "bool",
    "default": false,
    "description": "Show recursive directory size"
  },
  "long_options.accessed": {
    "type": "bool",
    "default": false,
    "description": "Use the accessed timestamp field"
  },
  "long_options.created": {
    "type": "bool",
    "default": false,
    "description": "Use the created timestamp field"
  },
  "long_options.no_permissions": {
    "type": "bool",
    "default": false,
    "description": "Suppress permissions field"
  },
  "long_options.octal_permissions": {
    "type": "bool",
    "default": false,
    "description": "List permissions in octal format"
  },
  "long_options.no_filesize": {
    "type": "bool",
    "default": false,
    "description": "Suppress file size field"
  },
  "long_options.no_user": {
    "type": "bool",
    "default": false,
    "description": "Suppress user field"
  },
  "long_options.no_time": {
    "type": "bool",
    "default": false,
    "description": "Suppress time field"
  },
  "long_options.stdin": {
    "type": "bool",
    "default": false,
    "description": "Pipe directories from stdin"
  },
  "long_options.extended": {
    "type": "bool",
    "default": false,
    "description": "List extended attributes"
  },
  "long_options.context": {
    "type": "bool",
    "default": false,
    "description": "List security context"
  },
  "long_options.git": {
    "type": "bool",
    "default": false,
    "description": "List Git status (if built with git support)"
  },
  "long_options.git_repos": {
    "type": "bool",
    "default": false,
    "description": "List Git repo status"
  },
  "long_options.git_repos_no_status": {
    "type": "bool",
    "default": false,
    "description": "List repo presence only, no status"
  },
  "long_options.no_git": {
    "type": "bool",
    "default": false,
    "description": "Suppress all Git output"
  },
  "classify": {
    "type": "string",
    "default": "automatic",
    "description": "When to display file kind indicators: 'always', 'automatic', or 'never'",
    "enum": [
      "always",
      "automatic",
      "never"
    ]
  },
  "git_repos_no_status_override": {
    "type": "bool",
    "default": false,
    "description": "Override to force --git-repos-no-status when used with --git-repos"
  }
}
