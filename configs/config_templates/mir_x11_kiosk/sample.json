{
  "enabled": true,
  "display_number": 0,
  "app_command": "/usr/bin/chromium-browser",
  "app_args": [
    "--kiosk",
    "--no-sandbox",
    "--disable-dev-shm-usage",
    "https://example.com"
  ],
  "work_dir": "/home/mir-kiosk",
  "user": "mir-kiosk",
  "group": "mir-kiosk",
  "env_vars": [
    {
      "name": "DISPLAY",
      "value": ":0"
    },
    {
      "name": "XAUTHORITY",
      "value": "/run/mir-x11-kiosk/.Xauthority"
    }
  ],
  "auto_restart": true,
  "restart_delay": 5,
  "log_level": "warn",
  "log_file": "/var/log/mir-x11-kiosk/kiosk.log",
  "start_timeout": 45,
  "wayland_display": "/run/mir_socket",
  "x11_window_class": "mir-kiosk",
  "x11_window_title": "Kiosk \u2013 Example Corp",
  "cursor_policy": "hidden",
  "input_devices": [],
  "input_policy": "none",
  "input_filters": [],
  "rotation": 0,
  "scaling": 1.0,
  "multi_display": false,
  "display_order": [],
  "fallback_display": "HDMI-A-1",
  "vsync_wait": "auto",
  "surface_buffer_count": 3,
  "hw_accel": true,
  "gpu_device": "/dev/dri/card0"
}
