[Desktop Entry]
# Type of this entry; must be 'Application' for executable launchers
Type=Application

# Display name for the indicator
Name=Ayatana Indicator Sound

# Path to the executable to launch; defaults to the standard ayatana-indicator-sound-service location
Exec={{ (exec_path | default('/usr/libexec/ayatana-indicator-sound/ayatana-indicator-sound-service')) }}

# Desktop environments where this entry should be visible; semicolon-separated list
OnlyShowIn={{ (only_show_in | default('MATE;XFCE;')) }}

# If true, hide this entry from menus and applications lists
NoDisplay={{ (no_display | default(True)) | lower }}

# If true, send a startup notification when the application is launched
StartupNotify={{ (startup_notify | default(False)) | lower }}

# If true, the application should be run in a terminal window
Terminal={{ (terminal | default(False)) | lower }}