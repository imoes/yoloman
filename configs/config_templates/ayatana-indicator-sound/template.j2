# Ayatana Indicator Sound - Desktop Entry Configuration
# This template generates a .desktop file for the ayatana-indicator-sound service.
# It controls the visibility, execution path, and startup behavior of the sound indicator applet.

[Desktop Entry]

# Type of entry; must be Application for standard desktop entries.
Type=Application

# Name displayed in menus and application launchers.
Name=Ayatana Indicator Sound

# Path to the executable that runs the sound indicator service.
# Defaults to the system-installed service binary if not overridden.
Exec={{ exec_path | default('/usr/libexec/ayatana-indicator-sound/ayatana-indicator-sound-service') }}

# Desktop environments where this application should appear.
# Uses the desktop-namespace format (e.g., GNOME;KDE;MATE;XFCE;).
# Defaults to MATE and XFCE sessions.
OnlyShowIn={{ only_show_in | default('MATE;XFCE;') }}

# If true, the desktop entry is hidden from menus and application lists.
# Useful for background services that do not need direct user invocation.
NoDisplay={{ no_display | default('true') }}

# If true, sends a startup notification to the window manager when launched.
# Helps with UI feedback during application initialization.
StartupNotify={{ startup_notify | default('false') }}

# If true, the application is launched inside a terminal window.
# Typically false for GUI indicator applications.
Terminal={{ terminal | default('false') }}
