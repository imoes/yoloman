# -----------------------------------------------------------------------------
# VTE Profile Configuration for Red Hat Systems
#
# This script configures the terminal title bar for VT100/VT220 compatible
# terminal emulators (VTE) running under tcsh/csh. It enables the display of
# the current working directory and an optional hostname suffix in the title bar.
# -----------------------------------------------------------------------------

# Exit if the environment is not suitable:
# - Not an interactive shell (no $prompt)
# - Not tcsh (no $tcsh)
# - No terminal set (no $TERM)
# - No VTE version detected (no $VTE_VERSION)
if ( ! $?prompt | ! $?tcsh | ! $?TERM | ! $?VTE_VERSION ) exit

# Configure the title bar behavior based on the terminal type.
switch($TERM)
  # Match all xterm-compatible terminals (xterm, screen, tmux, etc.)
  case xterm*:
    # The 'precmd' alias runs before each command prompt is displayed.
    # It sets the terminal title using OSC 7 (Current Directory) and updates
    # the standard title bar.
    # Optional hostname suffix to append to the file:// URL in the terminal title bar.
    # Leave empty to use the default $HOST expansion.
    alias precmd 'echo -n "\e]7;file://$HOST{{ VTE_URL_HOSTNAME | default('') }}"; /usr/libexec/vte-urlencode-cwd; echo -n "\e\\"'
  endsw
