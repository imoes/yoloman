# Tzdiff configuration
# Displays timezone differences with localtime.
# This file is generated by Ansible from schema fields.
# Do not edit manually.

# Number of hours of timezone differences to display.
# Range 1-24. Corresponds to the `-n count` option.
# Default: 10
hours: {{ (tzdiff | default({})).hours | default(10) | int }}

# Output format string compatible with date(1).
# Corresponds to the `-f format` option.
# Example: '%Y-%m-%d %H:%M'
format: '{{ (tzdiff | default({})).format | default("%Y-%m-%d %H:%M") }}'

# List of timezone identifiers (e.g., 'Asia/Tokyo', 'Europe/London') to compare.
# If empty, the tool lists all available zones.
# Corresponds to the positional `timezone` arguments.
timezones:
{%- set tz_list = (tzdiff | default({})).timezones | default([]) %}
{%- if tz_list | length > 0 %}
{%- for tz in tz_list %}  - {{ tz }}
{%- endfor %}
{%- else %}
  # No specific timezones listed; tzdiff will list all available zones.
{%- endif %}

# Start time for the display window.
# Supports flexible formats like 'YYYY-mm-ddTHH:MM' or 'now'.
# Corresponds to the `-t start` option.
start_time: '{{ (tzdiff | default({})).start_time | default("now") }}'

# If true, display full timezone name (region/city) instead of abbreviation.
# Corresponds to the `-l` option.
# Default: false
full_names: {{ (tzdiff | default({})).full_names | default(false) | bool | lower }}

# If true, round down displayed times to the nearest hour.
# Corresponds to the `-0` option.
# Default: false
round_to_hour: {{ (tzdiff | default({})).round_to_hour | default(false) | bool | lower }}

# If true, use scripting mode with TAB separators for machine readability.
# Corresponds to the `-H` option.
# Default: false
scripting_mode: {{ (tzdiff | default({})).scripting_mode | default(false) | bool | lower }}

# If true, do not display the local timezone column.
# Corresponds to the `-N` option.
# Default: false
no_local: {{ (tzdiff | default({})).no_local | default(false) | bool | lower }}