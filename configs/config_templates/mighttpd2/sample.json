{
  "bind_address": "0.0.0.0",
  "port": 8080,
  "max_connections": 4096,
  "worker_count": 4,
  "request_header_timeout": 30,
  "request_body_timeout": 120,
  "response_timeout": 60,
  "max_request_body_size": 52428800,
  "compression_enabled": true,
  "tls_enabled": true,
  "tls_certificate_path": "/etc/mighttpd2/tls/fullchain.pem",
  "tls_key_path": "/etc/mighttpd2/tls/privkey.pem",
  "access_log_path": "/var/log/mighttpd2/access.log",
  "error_log_path": "/var/log/mighttpd2/error.log",
  "log_level": "info",
  "mime_types_path": "/etc/mighttpd2/mime.types",
  "virtual_hosts": [
    {
      "name": "example.com",
      "document_root": "/var/www/example",
      "index_files": [
        "index.html",
        "index.php"
      ],
      "enable_directory_listing": false
    },
    {
      "name": "api.example.com",
      "document_root": "/var/www/api",
      "index_files": [],
      "enable_directory_listing": false
    }
  ],
  "static_cache_time": 600,
  "http2_enabled": true,
  "shutdown_timeout": 15,
  "x_frame_options_enabled": true,
  "x_content_type_options_enabled": true,
  "custom_headers": [
    {
      "name": "X-Frame-Options",
      "value": "DENY"
    },
    {
      "name": "X-XSS-Protection",
      "value": "1; mode=block"
    }
  ]
}
