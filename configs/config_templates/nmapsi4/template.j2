[nmapsi4]
# nmapsi4 is a Qt4/KDE frontend for nmap and does not have a dedicated persistent configuration file on disk.
# It stores user preferences in the KDE/Qt configuration database (kconfig).
# This template represents the logical configuration structure that would be passed to the application
# or stored in kdeglobals if explicit file-based config were supported.

# Absolute path to the nmap executable binary.
nmap_path={{ nmap_path | default('/usr/bin/nmap') }}

# The default profile preset for scans (ping, default, aggressive, vuln, etc.).
default_scan_type={{ default_scan_type | default('default') }}

# If true, enable verbose logging and debug output in the UI.
verbose_output={{ verbose_output | default(false) | lower }}

# A list of hostnames or IP addresses to scan by default.
# This list is joined with spaces for the command line arguments.
hosts={{ hosts | default(['localhost']) | join(' ') }}

# A list of additional command-line flags to append to the nmap invocation (e.g., '-sU', '-p 80').
# Use empty list for none. This list is joined with spaces.
extra_options={{ extra_options | default([]) | join(' ') }}

# A single host or CIDR block populated in the quick-scan target field.
quick_target={{ quick_target | default('127.0.0.1') }}

# If true, automatically update the results view when new packets are received.
auto_refresh={{ auto_refresh | default(false) | lower }}