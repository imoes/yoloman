{
  "J2F_BASEDIR": {
    "type": "string",
    "default": "/var/lib/json2file-go",
    "description": "Base directory for json2file-go data"
  },
  "J2F_BIND": {
    "type": "string",
    "default": "",
    "description": "Bind address for the service"
  },
  "J2F_CERTFILE": {
    "type": "string",
    "default": "",
    "description": "Path to SSL certificate file"
  },
  "J2F_DEBUG": {
    "type": "bool",
    "default": false,
    "description": "Enable debug mode"
  },
  "J2F_DIRLIST": {
    "type": "string",
    "default": "",
    "description": "Semicolon-separated list of dir:token mappings"
  },
  "J2F_HOST": {
    "type": "string",
    "default": "localhost",
    "description": "Hostname for the service"
  },
  "J2F_KEYFILE": {
    "type": "string",
    "default": "",
    "description": "Path to SSL key file"
  },
  "J2F_PORT": {
    "type": "number",
    "default": 8080,
    "description": "Port for the service"
  },
  "J2F_SOCKET": {
    "type": "string",
    "default": "",
    "description": "Unix socket path for the service"
  },
  "J2F_SIGNATURE_HEADERS": {
    "type": "string",
    "default": "X-Hub-Signature",
    "description": "Comma-separated list of HTTP headers containing signature hashes"
  },
  "J2F_TOKEN_FIELDS": {
    "type": "string",
    "default": "",
    "description": "Comma-separated list of JSON field names containing authorization tokens"
  },
  "J2F_TOKEN_HEADERS": {
    "type": "string",
    "default": "",
    "description": "Comma-separated list of HTTP header names containing authorization tokens"
  },
  "J2F_URL_PREFIX": {
    "type": "string",
    "default": "",
    "description": "URL prefix for the service"
  }
}
