{
  "server_user": "backupd",
  "server_group": "backupd",
  "root_path": "/backup/rdiff/prod",
  "server_port": 8730,
  "server_bind_address": "192.168.10.5",
  "enable_ssl": true,
  "ssl_cert_path": "/etc/ssl/rdiff/prod.crt",
  "ssl_key_path": "/etc/ssl/rdiff/prod.key",
  "ssl_ca_cert_path": "/etc/ssl/rdiff/ca.crt",
  "allowed_hosts": [
    "192.168.10.0/24",
    "10.0.0.42"
  ],
  "max_connections": 10,
  "compression": 3,
  "log_level": "warning",
  "log_file": "/var/log/rdiff-backup/prod.log",
  "retention_days": 60,
  "paranoia_mode": true,
  "preserve_xattrs": true,
  "preserve_acls": true,
  "exclude_patterns": [
    "**/.cache",
    "**/tmp",
    "**/*~",
    "/proc/*",
    "/sys/*",
    "/dev/*"
  ],
  "include_patterns": [
    "/etc/**",
    "/var/www/**",
    "/home/**"
  ],
  "windows_compatibility": false,
  "allow_client_restore": false,
  "user_mapping": [
    {
      "remote_user": "root",
      "local_user": "backupd"
    }
  ],
  "group_mapping": [
    {
      "remote_group": "root",
      "local_group": "backupd"
    }
  ],
  "unix_socket": "/run/rdiff-backup/prod.sock",
  "require_auth": true,
  "auth_realm": "prod-backup-realm",
  "trusted_groups": [
    "backup-admins",
    "ops"
  ],
  "log_client_ips": true
}
