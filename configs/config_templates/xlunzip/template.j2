# ==============================================================================
# xlunzip Configuration Template
# ==============================================================================
# This template configures buffer sizes and verbosity settings for xlunzip
# decompression operations. xlunzip is a lossless decompression utility based
# on LZFSE.
# ==============================================================================

# ------------------------------------------------------------------------------
# insize: Pre-allocate and fill input buffer size.
# Accepts integers or strings with multipliers (e.g., '16k', '16KiB', '16384').
# This controls how much memory is pre-allocated for reading input data.
# Larger values may improve performance for large streams but increase memory usage.
# ------------------------------------------------------------------------------
insize = {{ insize | default('16384') }}

# ------------------------------------------------------------------------------
# outsize: Pre-allocate output buffer size.
# Accepts integers or strings with multipliers (e.g., '512m', '512MiB', '536870912').
# This controls how much memory is pre-allocated for writing decompressed data.
# Larger values may improve performance for large streams but increase memory usage.
# ------------------------------------------------------------------------------
outsize = {{ outsize | default('536870912') }}

# ------------------------------------------------------------------------------
# nofill: Disable input buffer fill function.
# If true, do not pass a fill function for reading input.
# Requires insize to be set explicitly to a non-zero value.
# Use this when providing pre-loaded or static input buffers.
# ------------------------------------------------------------------------------
nofill = {{ nofill | default(false) }}

# ------------------------------------------------------------------------------
# noflush: Disable output buffer flush function.
# If true, do not pass a flush function for writing output.
# Requires outsize to be set explicitly to a non-zero value.
# Use this when providing a static output buffer to be filled.
# ------------------------------------------------------------------------------
noflush = {{ noflush | default(false) }}

# ------------------------------------------------------------------------------
# verbose: Enable verbose logging.
# If true, outputs progress and status information to stderr.
# Useful for debugging or monitoring long-running decompression tasks.
# ------------------------------------------------------------------------------
verbose = {{ verbose | default(false) }}

# ------------------------------------------------------------------------------
# quiet: Suppress all messages.
# If true, suppresses all output including errors (unless fatal).
# Useful for scripting where output should be minimal.
# Note: verbose and quiet are typically mutually exclusive in usage.
# ------------------------------------------------------------------------------
quiet = {{ quiet | default(false) }}