{
  "masakari_api_host": "10.0.0.10",
  "masakari_api_port": 8080,
  "auth_url": "http://10.0.0.10:5000/v3",
  "project_name": "services",
  "service_user": "masakari",
  "service_password": "masakari_secret_pass",
  "user_domain_name": "Default",
  "project_domain_name": "Default",
  "region_name": "RegionOne",
  "transport_url": "rabbit://guest:secretrabbit@10.0.0.10:5672//",
  "monitor_interval": 15,
  "failure_detection_timeout": 90,
  "recovery_retry_interval": 60,
  "max_recovery_attempts": 5,
  "auto_recovery": true,
  "notification_driver": "masakari.notifiers.api_notifier.ApiNotifier",
  "notification_endpoints": [
    {
      "name": "slack-webhook",
      "type": "webhook",
      "address": "https://hooks.slack.com/services/XXX/YYY/ZZZ"
    },
    {
      "name": "ops-email",
      "type": "mailto",
      "address": "ops@example.com"
    }
  ],
  "segment_uuids": [
    "d7a4e8e6-9f1b-4a7c-8e3d-1f2c3b4a5d6e"
  ],
  "rpc_use_ssl": false,
  "cafile": "/etc/ssl/certs/ca-certificates.crt",
  "certfile": "",
  "keyfile": "",
  "tls_insecure": false,
  "host_name": "",
  "health_check_enabled": true,
  "health_check_interval": 30,
  "health_check_uri": "http://0.0.0.0:5673/healthcheck"
}
