{
  "profile_name": "WeeklyServerBackup",
  "source_dir": "/var/www/html",
  "dest_dir": "/backup/www",
  "mode": "sync",
  "log_level": 2,
  "exclude_patterns": [
    "*.log",
    "cache/*",
    "*.swp"
  ],
  "dry_run": false,
  "skip_critical": false,
  "silent": true,
  "console_mode": true,
  "no_questions": true
}
