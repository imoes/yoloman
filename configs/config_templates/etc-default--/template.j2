{# Configuration overrides for system services loaded via /etc/default/ #}
{# /etc/default/ files are sourced as shell scripts by systemd or init scripts #}
{# They use simple KEY=value syntax, no quotes needed unless values contain spaces/special chars #}
{# Variables here are *not* service-specific config files, but environment overrides for services #}

{# Common environment variables for services #}
{# e.g., enabling/disabling services, setting LC_ALL, umask, etc. #}
{% if enable_amd64_microcode is defined %}AMD64_MICROCODE_LOAD=yes{% else %}AMD64_MICROCODE_LOAD=no{% endif %}
{% if enable_intel_microcode is defined %}INTEL_MICROCODE_LOAD=yes{% else %}INTEL_MICROCODE_LOAD=no{% endif %}

{# Anacron #}
{% if anacron_enabled is defined %}RUN_ANACRON=yes{% else %}RUN_ANACRON=no{% endif %}

{# Apport (crash reporting) #}
{% if apport_enabled is defined %}ENABLED={{ apport_enabled | string | lower }}{% endif %}

{# BlueZ (Bluetooth) #}
{% if bluez_hciattach_enabled is defined %}HCIAUTOATTACH={{ bluez_hciattach_enabled | string | lower }}{% endif %}

{# Chrony (NTP) #}
{% if chrony_daemon_options is defined %}DAEMON_OPTS="{{ chrony_daemon_options }}"{% endif %}

{# Cron #}
{% if cron_enabled is defined %}CRON_ENABLED={{ cron_enabled | string | lower }}{% endif %}

{# D-Bus #}
{% if dbus_session_bus_enabled is defined %}DBUS_SESSION_BUS_ADDRESS="{{ dbus_session_bus_address }}"{% endif %}

{# Docker #}
{% if docker_options is defined %}DOCKER_OPTS="{{ docker_options }}"{% endif %}

{# FreeIPA client #}
{% if freeipa_client_enabled is defined %}SUDO_ENABLE={{ freeipa_client_enabled | string | lower }}{% endif %}

{# im-config (input method) #}
{% if im_config_session_enabled is defined %}SESSION_MANAGED={{ im_config_session_enabled | string | lower }}{% endif %}

{# Kernel oops reporting #}
{% if kerneloops_enabled is defined %}ENABLED={{ kerneloops_enabled | string | lower }}{% endif %}

{# Networkd dispatcher #}
{% if networkd_dispatcher_enabled is defined %}RUN_NETWORKD_DISPATCHER={{ networkd_dispatcher_enabled | string | lower }}{% endif %}

{# Numlockx (Num Lock on boot) #}
{% if numlock_enabled is defined %}NUMLOCK=on{% else %}NUMLOCK=off{% endif %}

{# OpenSSH server #}
{% if ssh_enabled is defined %}SSHD_ENABLE={{ ssh_enabled | string | lower }}{% endif %}
{% if sshd_options is defined %}SSHD_OPTS="{{ sshd_options }}"{% endif %}

{# OpenVPN #}
{% if openvpn_enabled is defined %}AUTO_START={{ openvpn_enabled | string | lower }}{% endif %}

{# passwd (PAM password policies) #}
{% if passwd_quality_enabled is defined %}PASSWD_ENFORCE={{ passwd_quality_enabled | string | lower }}{% endif %}

{# rsync daemon #}
{% if rsync_daemon_enabled is defined %}RSYNC_ENABLE={{ rsync_daemon_enabled | string | lower }}{% endif %}

{# SANE (scanner access) #}
{% if sane_daemon_enabled is defined %}DAEMON_ENABLE={{ sane_daemon_enabled | string | lower }}{% endif %}

{# smartmontools #}
{% if smartd_enabled is defined %}start_smartd={{ smartd_enabled | string | lower }}{% endif %}

{# SSSD #}
{% if sssd_enabled is defined %}SSSD_ENABLE={{ sssd_enabled | string | lower }}{% endif %}

{# UFW (Uncomplicated Firewall) #}
{% if ufw_enabled is defined %}ENABLED={{ ufw_enabled | string | lower }}{% endif %}

{# xrdp (RDP server) #}
{% if xrdp_enabled is defined %}ENABLED={{ xrdp_enabled | string | lower }}{% endif %}
