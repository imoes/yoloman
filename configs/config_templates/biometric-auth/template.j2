<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE busconfig PUBLIC
 "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
	<!--
	  Policy allowing the root user to claim (own) the D-Bus service name.
	  Schema: dbus_service_name
	  Description: The D-Bus service name that the biometric authentication daemon owns and listens on.
	-->
	<policy user="root">
		<allow own="{{ dbus_service_name | default('org.ukui.Biometric') }}"/>
	</policy>

	<!--
	  Default policy for all other messages not matching specific rules above.
	  Defines what the general public can send to our service.
	-->
	<policy context="default">
		<!--
		  Allow sending messages to the main service destination.
		  Schema: dbus_service_name
		  Description: The D-Bus service name that the biometric authentication daemon owns and listens on.
		-->
		<allow send_destination="{{ dbus_service_name | default('org.ukui.Biometric') }}"/>

		<!--
		  Allow introspection of the service.
		  Schema: dbus_service_name
		  Description: The D-Bus service name that the biometric authentication daemon owns and listens on.
		-->
		<allow send_destination="{{ dbus_service_name | default('org.ukui.Biometric') }}"
			send_interface="org.freedesktop.DBus.Introspectable"/>

		<!--
		  Allow reading properties of the service objects.
		  Schema: dbus_service_name
		  Description: The D-Bus service name that the biometric authentication daemon owns and listens on.
		-->
		<allow send_destination="{{ dbus_service_name | default('org.ukui.Biometric') }}"
			send_interface="org.freedesktop.DBus.Properties"/>
	</policy>
</busconfig>
