{
  "time_format": "%H:%M:%S",
  "date_format": "%d/%b/%Y",
  "datetime_format": "%d/%b/%Y:%H:%M:%S %z",
  "color_scheme": 3,
  "config_dialog": false,
  "hl_header": true,
  "json_pretty_print": false,
  "no_color": false,
  "no_column_names": false,
  "no_csv_summary": false,
  "no_progress": false,
  "no_tab_scroll": false,
  "tz": "Europe/Berlin",
  "with_mouse": false,
  "max_items": 366,
  "addr": "0.0.0.0",
  "daemonize": false,
  "origin": "http://example.org",
  "port": 7890,
  "pid_file": "/var/run/goaccess.pid",
  "real_time_html": true,
  "ssl_cert": "/path/ssl/domain.crt",
  "ssl_key": "/path/ssl/domain.key",
  "ws_url": "goaccess.io",
  "fifo_in": "/tmp/wspipein.fifo",
  "fifo_out": "/tmp/wspipeout.fifo",
  "log_file": "/var/log/apache2/access.log",
  "debug_file": "debug.log",
  "no_global_config": false,
  "agent_list": false,
  "with_output_resolver": false,
  "http_method": "yes",
  "http_protocol": "yes",
  "no_query_string": false,
  "no_term_resolver": false,
  "444_as_404": false,
  "4xx_to_unique_count": false,
  "anonymize_ip": false,
  "all_static_files": false,
  "double_decode": false,
  "ignore_crawlers": false,
  "crawlers_only": false,
  "unknowns_as_crawlers": false,
  "keep_last": 7,
  "num_tests": 10,
  "process_and_exit": false,
  "real_os": true,
  "static_file_css": ".css",
  "static_file_js": ".js",
  "static_file_jpg": ".jpg",
  "static_file_png": ".png",
  "static_file_gif": ".gif",
  "static_file_ico": ".ico",
  "static_file_jpeg": ".jpeg",
  "static_file_pdf": ".pdf",
  "static_file_csv": ".csv",
  "static_file_mpeg": ".mpeg",
  "static_file_mpg": ".mpg",
  "static_file_swf": ".swf",
  "static_file_woff": ".woff",
  "static_file_woff2": ".woff2",
  "static_file_xls": ".xls",
  "static_file_xlsx": ".xlsx",
  "static_file_doc": ".doc",
  "static_file_docx": ".docx",
  "static_file_ppt": ".ppt",
  "static_file_pptx": ".pptx",
  "static_file_txt": ".txt",
  "static_file_zip": ".zip",
  "static_file_ogg": ".ogg",
  "static_file_mp3": ".mp3",
  "static_file_mp4": ".mp4",
  "static_file_exe": ".exe",
  "static_file_iso": ".iso",
  "static_file_gz": ".gz",
  "static_file_rar": ".rar",
  "static_file_svg": ".svg",
  "static_file_bmp": ".bmp",
  "static_file_tar": ".tar",
  "static_file_tgz": ".tgz",
  "static_file_tiff": ".tiff",
  "static_file_tif": ".tif",
  "static_file_ttf": ".ttf",
  "static_file_flv": ".flv",
  "static_file_dmg": ".dmg",
  "static_file_xz": ".xz",
  "static_file_zst": ".zst",
  "std_geoip": false,
  "geoip_database": "/usr/local/share/GeoIP/GeoLiteCity.dat",
  "db_path": "/tmp",
  "persist": true,
  "restore": true
}
