{
  "time_format": {
    "type": "string",
    "default": "%H:%M:%S",
    "description": "Time format string for log parsing."
  },
  "date_format": {
    "type": "string",
    "default": "%d/%b/%Y",
    "description": "Date format string for log parsing."
  },
  "datetime_format": {
    "type": "string",
    "default": "",
    "description": "Combined date and time format string."
  },
  "color_scheme": {
    "type": "string",
    "default": "",
    "description": "Color scheme number (1: Monochrome, 2: Green, 3: Monokai)."
  },
  "config_dialog": {
    "type": "string",
    "default": "false",
    "description": "Prompt log/date configuration window on program start."
  },
  "hl_header": {
    "type": "string",
    "default": "true",
    "description": "Color highlight active panel."
  },
  "json_pretty_print": {
    "type": "string",
    "default": "false",
    "description": "Format JSON output using tabs and newlines."
  },
  "no_color": {
    "type": "string",
    "default": "false",
    "description": "Turn off colored output."
  },
  "no_column_names": {
    "type": "string",
    "default": "false",
    "description": "Disable column names in terminal output."
  },
  "no_csv_summary": {
    "type": "string",
    "default": "false",
    "description": "Disable summary metrics on CSV output."
  },
  "no_progress": {
    "type": "string",
    "default": "false",
    "description": "Disable progress metrics."
  },
  "no_tab_scroll": {
    "type": "string",
    "default": "false",
    "description": "Disable scrolling through panels on TAB."
  },
  "tz": {
    "type": "string",
    "default": "",
    "description": "Timezone for report date/time data."
  },
  "with_mouse": {
    "type": "string",
    "default": "false",
    "description": "Enable mouse support on main dashboard."
  },
  "max_items": {
    "type": "string",
    "default": "",
    "description": "Maximum number of items to show per panel."
  },
  "addr": {
    "type": "string",
    "default": "",
    "description": "IP address to bind server to."
  },
  "daemonize": {
    "type": "string",
    "default": "",
    "description": "Run GoAccess as daemon."
  },
  "origin": {
    "type": "string",
    "default": "",
    "description": "Origin header for WebSocket handshake."
  },
  "port": {
    "type": "string",
    "default": "",
    "description": "Port for WebSocket server."
  },
  "pid_file": {
    "type": "string",
    "default": "",
    "description": "Path to write PID file."
  },
  "real_time_html": {
    "type": "string",
    "default": "",
    "description": "Enable real-time HTML output."
  },
  "ssl_cert": {
    "type": "string",
    "default": "",
    "description": "Path to TLS/SSL certificate."
  },
  "ssl_key": {
    "type": "string",
    "default": "",
    "description": "Path to TLS/SSL private key."
  },
  "ws_url": {
    "type": "string",
    "default": "",
    "description": "WebSocket URL."
  },
  "fifo_in": {
    "type": "string",
    "default": "",
    "description": "Path to read named pipe (FIFO)."
  },
  "fifo_out": {
    "type": "string",
    "default": "",
    "description": "Path to write named pipe (FIFO)."
  },
  "log_file": {
    "type": "string",
    "default": "",
    "description": "Path to the input log file."
  },
  "debug_file": {
    "type": "string",
    "default": "",
    "description": "Path to debug log file."
  },
  "no_global_config": {
    "type": "string",
    "default": "",
    "description": "Do not load the global configuration file."
  },
  "agent_list": {
    "type": "string",
    "default": "false",
    "description": "Enable a list of user-agents by host."
  },
  "with_output_resolver": {
    "type": "string",
    "default": "false",
    "description": "Enable IP resolver on HTML|JSON|CSV output."
  },
  "http_method": {
    "type": "string",
    "default": "yes",
    "description": "Include HTTP request method.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "http_protocol": {
    "type": "string",
    "default": "yes",
    "description": "Include HTTP request protocol.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "no_query_string": {
    "type": "string",
    "default": "false",
    "description": "Ignore request's query string."
  },
  "no_term_resolver": {
    "type": "string",
    "default": "false",
    "description": "Disable IP resolver on terminal output."
  },
  "444_as_404": {
    "type": "bool",
    "default": false,
    "description": "Treat non-standard status code 444 as 404."
  },
  "4xx_to_unique_count": {
    "type": "bool",
    "default": false,
    "description": "Add 4xx client errors to the unique visitors count."
  },
  "anonymize_ip": {
    "type": "string",
    "default": "",
    "description": "IP address anonymization."
  },
  "all_static_files": {
    "type": "string",
    "default": "false",
    "description": "Include static files with query string in static files panel."
  },
  "double_decode": {
    "type": "string",
    "default": "false",
    "description": "Decode double-encoded values."
  },
  "ignore_crawlers": {
    "type": "string",
    "default": "false",
    "description": "Ignore crawlers from being counted."
  },
  "crawlers_only": {
    "type": "string",
    "default": "false",
    "description": "Parse and display crawlers only."
  },
  "unknowns_as_crawlers": {
    "type": "string",
    "default": "false",
    "description": "Unknown browsers and OS are considered as crawlers."
  },
  "keep_last": {
    "type": "number",
    "default": 7,
    "description": "Keep the last specified number of days in storage."
  },
  "num_tests": {
    "type": "string",
    "default": "",
    "description": "Number of lines from the access log to test."
  },
  "process_and_exit": {
    "type": "string",
    "default": "",
    "description": "Parse log and exit without outputting data."
  },
  "real_os": {
    "type": "string",
    "default": "true",
    "description": "Display real OS names."
  },
