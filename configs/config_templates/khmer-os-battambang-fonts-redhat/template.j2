<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Font configuration for Khmer OS Battambang on Red Hat systems -->
<fontconfig>
  <!-- Define generic font aliases to point to the specific font family -->
  <alias>
    <!-- The name of the font family to be configured. -->
    <family>{{ font_family | default('Khmer OS Battambang') }}</family>
    <!-- The default generic font family to alias or match against. -->
    <default>
      <family>{{ default_family | default('monospace') }}</family>
    </default>
  </alias>
  
  <!-- Locale-specific font overrides for Khmer text rendering -->
  <match>
    <!-- Test if the current locale language matches the configured code -->
    <test name="lang" compare="contains">
      <!-- The locale code (e.g., 'km' for Khmer) to trigger specific font overrides. -->
      <string>{{ locale_code | default('km') }}</string>
    </test>
    
    <!-- Test if the target font family matches the default family -->
    <test name="family">
      <string>{{ default_family | default('monospace') }}</string>
    </test>
    
    <!-- If matched, prepend the specific Khmer font to the list -->
    <edit name="family" mode="prepend">
      <!-- The name of the font family to be configured. -->
      <string>{{ font_family | default('Khmer OS Battambang') }}</string>
    </edit>
  </match>
</fontconfig>
