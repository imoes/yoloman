{
  "bind_list": [
    {
      "address": "0.0.0.0",
      "port": "443"
    },
    {
      "address": "::",
      "port": "443"
    }
  ],
  "backend_list": [
    {
      "host": "127.0.0.1",
      "port": 8080
    },
    {
      "host": "127.0.0.1",
      "port": 8081
    }
  ],
  "default_cert": "/etc/hitch/certs/myapp.example.com.pem",
  "tls_versions": [
    "TLSv1.2",
    "TLSv1.3"
  ],
  "tls_prefer_server_ciphers": true,
  "tls_cipher_suite": "",
  "ocsp_dir": "/etc/hitch/ocsp",
  "workers": 4,
  "loglevel": "notice",
  "run_as_user": "hitch",
  "run_as_group": "hitch",
  "pidfile_path": "/run/hitch/hitch.pid",
  "keepalive_timeout": 120,
  "ssl_session_cache_enabled": true,
  "ssl_session_cache_size": "10000",
  "health_check_enabled": true,
  "health_check_interval": 15,
  "health_check_timeout": 5,
  "health_check_expected_status": [
    200,
    204
  ],
  "rate_limit_enabled": false,
  "rate_limit_connections_per_second": 1000,
  "rate_limit_burst": 2000,
  "http2_enabled": true,
  "http2_max_concurrent_streams": 128,
  "frontend_connection_limit": 5000
}
