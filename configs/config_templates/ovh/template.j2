# Fence agent configuration for OVH public cloud
# Authentication credentials for the OVH API
application_key: {{ ovh_application_key }}
application_secret: {{ ovh_application_secret }}
consumer_key: {{ ovh_consumer_key }}

# Endpoint region (e.g., 'ovh-eu', 'ovh-us', 'kimsuky', etc.)
endpoint: {{ ovh_endpoint }}

# Optional: Timeout for API calls (seconds)
{% if ovh_timeout is defined and ovh_timeout is not none %}
timeout: {{ ovh_timeout }}
{% endif %}

# Optional: Use internal IP for fencing (default: false)
{% if ovh_use_internal_ip is defined and ovh_use_internal_ip is not none %}
use_internal_ip: {{ 'yes' if ovh_use_internal_ip else 'no' }}
{% endif %}

# Optional: IPMI interface type (e.g., 'lanplus')
{% if ovh_ipmi_interface is defined and ovh_ipmi_interface is not none %}
ipmi_interface: {{ ovh_ipmi_interface }}
{% endif %}

# Optional: Retry attempts and delay between retries (seconds)
{% if ovh_retries is defined and ovh_retries is not none %}
retries: {{ ovh_retries }}
{% endif %}
{% if ovh_retry_max_delay is defined and ovh_retry_max_delay is not none %}
retry_max_delay: {{ ovh_retry_max_delay }}
{% endif %}
