{
  "server": "example.com",
  "port": 443,
  "ssl": true,
  "ssl_ciphers": "HIGH:!aNULL:!MD5",
  "ssl_no_reuse": true,
  "method": "GET",
  "uri": "/",
  "num_conns": 100,
  "rate": 10,
  "timeout": 5,
  "think_timeout": 2,
  "burst_length": 5,
  "num_calls": 10,
  "http_version": "1.1",
  "server_name": "www.example.com",
  "no_host_hdr": false,
  "hog": true,
  "verbose": true,
  "failure_status": 504,
  "max_connections": 0,
  "max_piped_calls": 0,
  "session_cookie": false,
  "retry_on_failure": false,
  "close_with_reset": false,
  "debug": 0,
  "send_buffer": 0,
  "recv_buffer": 0,
  "wlog": "",
  "wsess": "",
  "wsesslog": "",
  "wset": "",
  "period": "0",
  "print_reply": "",
  "print_request": "",
  "add_headers": [
    "Referer: https://example.com",
    "Auth: secret"
  ],
  "client": ""
}
