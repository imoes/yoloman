{
  "wikiname_default_value": {
    "type": "string",
    "default": "blog",
    "description": "The default name for the wiki/blog."
  },
  "rcs_default_value": {
    "type": "string",
    "default": "git",
    "description": "The default revision control system to use."
  },
  "admin_default_value": {
    "type": "string",
    "default": "${ENV{USER}}",
    "description": "The default admin user or openid."
  },
  "domain_default_value": {
    "type": "string",
    "default": "",
    "description": "The default domain name of the web server."
  },
  "example_default_value": {
    "type": "string",
    "default": "blog",
    "description": "The example configuration type."
  },
  "comments_pagespec_default_value": {
    "type": "string",
    "default": "posts/* and !*/Discussion",
    "description": "Pagespec for comments."
  },
  "blogspam_pagespec_default_value": {
    "type": "string",
    "default": "postcomment(*)",
    "description": "Pagespec for blogspam protection."
  },
  "archive_pagespec_default_value": {
    "type": "string",
    "default": "page(posts/*) and !*/Discussion",
    "description": "Pagespec for archive pages."
  },
  "locked_pages_default_value": {
    "type": "string",
    "default": "* and !postcomment(*)",
    "description": "Pagespec for locked pages."
  },
  "tagbase_default_value": {
    "type": "string",
    "default": "tags",
    "description": "The base directory for tags."
  }
}
