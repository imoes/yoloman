{
  "loop_on_disconnect": {
    "type": "number",
    "default": 1,
    "description": "Set to 0 to shutdown when the link is disconnected, 1 to keep running."
  },
  "storage_path": {
    "type": "string",
    "default": "/var/lib/umtp",
    "description": "Path to the shared storage folder for MTP."
  },
  "manufacturer_string": {
    "type": "string",
    "default": "Viveris Technologies",
    "description": "USB manufacturer string."
  },
  "product_string": {
    "type": "string",
    "default": "Viveris Technologies",
    "description": "USB product string."
  },
  "serial_number": {
    "type": "string",
    "default": "01234567",
    "description": "USB serial number string."
  },
  "firmware_version": {
    "type": "string",
    "default": "Rev A",
    "description": "MTP firmware version string."
  },
  "interface_string": {
    "type": "string",
    "default": "MTP",
    "description": "USB interface string."
  },
  "usb_vendor_id": {
    "type": "number",
    "default": 4971,
    "description": "USB Vendor ID in decimal (0x1D6B)."
  },
  "usb_product_id": {
    "type": "number",
    "default": 256,
    "description": "USB Product ID in decimal (0x0100)."
  },
  "usb_class": {
    "type": "number",
    "default": 6,
    "description": "USB class code (0x6 for Image)."
  },
  "usb_subclass": {
    "type": "number",
    "default": 1,
    "description": "USB subclass code (0x1 for Still Imaging)."
  },
  "usb_protocol": {
    "type": "number",
    "default": 1,
    "description": "USB protocol code (0x1)."
  },
  "usb_dev_version": {
    "type": "number",
    "default": 12296,
    "description": "USB device version in decimal (0x3008)."
  },
  "usb_functionfs_mode": {
    "type": "number",
    "default": 1,
    "description": "Enable FunctionFS mode (0x1) or GadgetFS (0x0)."
  },
  "usb_dev_path": {
    "type": "string",
    "default": "/dev/ffs-mtp/ep0",
    "description": "USB device endpoint 0 path.",
    "enum": [
      "/dev/ffs-mtp/ep0",
      "/dev/gadget/atmel_usba_udc"
    ]
  },
  "usb_epin_path": {
    "type": "string",
    "default": "/dev/ffs-mtp/ep1",
    "description": "USB endpoint IN path.",
    "enum": [
      "/dev/ffs-mtp/ep1",
      "/dev/gadget/ep1",
      "/dev/gadget/ep1in"
    ]
  },
  "usb_epout_path": {
    "type": "string",
    "default": "/dev/ffs-mtp/ep2",
    "description": "USB endpoint OUT path.",
    "enum": [
      "/dev/ffs-mtp/ep2",
      "/dev/gadget/ep2",
      "/dev/gadget/ep2out"
    ]
  },
  "usb_epint_path": {
    "type": "string",
    "default": "/dev/ffs-mtp/ep3",
    "description": "USB endpoint interrupt path.",
    "enum": [
      "/dev/ffs-mtp/ep3",
      "/dev/gadget/ep3",
      "/dev/gadget/ep3in"
    ]
  },
  "usb_max_packet_size": {
    "type": "number",
    "default": 512,
    "description": "Max USB packet size in decimal (0x200)."
  }
}
