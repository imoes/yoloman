{
  "log_level": "warning",
  "policy_store": "/etc/selinux/targeted/policy",
  "local_store": "/etc/selinux/targeted/active",
  "use_dbm": true,
  "max_cache_size": 1048576,
  "fragment_dirs": [
    "/etc/selinux/semanage.d",
    "/etc/selinux/local.d"
  ],
  "boolean_defaults": [
    {
      "name": "httpd_can_network_connect",
      "value": "off"
    },
    {
      "name": "ssh_port_t",
      "value": "on"
    }
  ]
}
