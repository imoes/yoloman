{
  "verbose": true,
  "logdir": "/var/log/dsniff",
  "logfile_maxsize": 52428800,
  "logfile_rotate": 10,
  "services": [
    "http",
    "smtp",
    "ftp",
    "telnet",
    "imap"
  ],
  "interfaces": [
    {
      "name": "eth0",
      "enabled": true
    },
    {
      "name": "wlan0",
      "enabled": false
    }
  ],
  "custom_ports": {
    "http": 8080,
    "ftp": 2121
  }
}
