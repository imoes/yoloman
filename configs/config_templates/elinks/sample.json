{
  "always_load_config": false,
  "anonymous": false,
  "auto_submit": false,
  "bind_address": "",
  "bind_address_ipv6": "",
  "local_port": 0,
  "localhost": false,
  "use_libevent": true,
  "document_colors_use_document_colors": 2,
  "default_mime_type": "text/html",
  "proxies": [
    {
      "type": "http",
      "url": "http://proxy.example.com:3128"
    },
    {
      "type": "https",
      "url": "http://proxy.example.com:3128"
    },
    {
      "type": "ftp",
      "url": ""
    }
  ],
  "no_proxy": "localhost,127.0.0.0/8,::1",
  "cookie_accept": true,
  "ssl_check_cert": true,
  "search_engines": [
    {
      "name": "DuckDuckGo",
      "url": "https://duckduckgo.com/?q=%s"
    },
    {
      "name": "Google",
      "url": "https://www.google.com/search?q=%s"
    }
  ],
  "default_search_engine": "DuckDuckGo",
  "connection_timeout": 45,
  "enable_ecmascript": true,
  "verbose_level": 0
}
