{
  "path": {
    "type": "string",
    "default": "/home",
    "description": "Default search path (command-line: --path=PATH)"
  },
  "sort_column": {
    "type": "string",
    "default": "name",
    "description": "Default column to sort by: name|size|path|date|type (command-line: --sort=SORT)",
    "enum": [
      "name",
      "size",
      "path",
      "date",
      "type"
    ]
  },
  "large_icons": {
    "type": "bool",
    "default": false,
    "description": "Use large icons (command-line: --large-icons)"
  },
  "hidden": {
    "type": "bool",
    "default": false,
    "description": "Include hidden files (command-line: --hidden)"
  },
  "fulltext": {
    "type": "bool",
    "default": false,
    "description": "Perform fulltext search (command-line: --fulltext)"
  },
  "exact": {
    "type": "bool",
    "default": false,
    "description": "Perform exact match (command-line: --exact)"
  },
  "iso_time": {
    "type": "bool",
    "default": false,
    "description": "Display time in ISO format (command-line: --iso-time)"
  },
  "thumbnails": {
    "type": "bool",
    "default": false,
    "description": "Use thumbnails (command-line: --thumbnails)"
  },
  "start": {
    "type": "bool",
    "default": false,
    "description": "Start search immediately when app is displayed (command-line: --start)"
  }
}
