# HyFetch Configuration File
# Auto-generated from hyfetch(1) documentation
#
# This template configures HyFetch, a Python-based system information tool that
# generates ASCII-based system info dumps (similar to neofetch). It uses a
# standard INI-style configuration file.

[general]

# --backend selects the fetch backend to use for gathering system info.
# Supported backends include 'neofetch', 'fastfetch', 'qwqfetch', or 'hyfetch' (core).
# If unset, defaults to 'neofetch'.
backend = {{ backend|default('neofetch') }}

# --mode sets the color mode for the output.
# Valid values are '8bit' (limited palette) or 'rgb' (full color).
# If unset, defaults to 'rgb'.
mode = {{ mode|default('rgb') }}

# --preset applies a specific color theme or pride flag coloration.
# Common presets include 'rainbow', 'transgender', 'nonbinary', 'classic', etc.
# If unset, defaults to 'rainbow'.
preset = {{ preset|default('rainbow') }}

# --c-scale multiplies the lightness of colors by a float factor.
# Values typically range around 1.0.
# If unset, defaults to 1.0.
c_scale = {{ c_scale|default(1.0) }}

# --c-set-l sets the lightness value directly on a scale of 0-100.
# This overrides automatic lightness calculations.
# If unset, defaults to 50.
c_set_l = {{ c_set_l|default(50) }}

# --c-overlay enables experimental overlay color adjusting.
# If true, uses an overlay method instead of standard HSL lightness adjustment.
# If unset, defaults to false.
c_overlay = {{ c_overlay|default(false) }}

# --ascii-file specifies a custom file path for ASCII art.
# The file should contain valid ASCII art compatible with the selected backend.
# If unset, defaults to the Debian ASCII art provided by the package.
ascii_file = {{ ascii_file|default('/usr/share/hyfetch/ascii/debian.ascii') }}

[display]

