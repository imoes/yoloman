# Some display options are handled internally or via CLI flags not persisted in this
# standard config structure (e.g., --distro for testing, --debug for verbosity).
# The keys below ensure consistency with the [general] section if the parser
# expects them or if the backend reads them explicitly.

# Backend selection key (redundant with [general] but included for completeness
# if the underlying Python config object flattens sections).
backend = {{ backend|default('neofetch') }}

# Color mode key (redundant with [general]).
mode = {{ mode|default('rgb') }}

# Preset name key (redundant with [general]).
preset = {{ preset|default('rainbow') }}

# Lightness scale multiplier key.
c_scale = {{ c_scale|default(1.0) }}

# Lightness value key.
c_set_l = {{ c_set_l|default(50) }}

# Overlay flag key.
c_overlay = {{ c_overlay|default(false) }}

# ASCII file path key.
ascii_file = {{ ascii_file|default('/usr/share/hyfetch/ascii/debian.ascii') }}

