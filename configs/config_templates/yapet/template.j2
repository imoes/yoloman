# yapet per-user configuration file

# strict_mode: If true, yapet checks password files for having the same owner as the user running yapet
# and verifies that the file mode is strictly 0600.
# Default: True
{% set strict_mode = strict_mode | default(true) %}
{% if strict_mode %}
# Strict mode is enabled: files must be owned by the user and have mode 0600.
strict_mode = true
{% else %}
# Strict mode is disabled: yapet will load files regardless of ownership or mode.
strict_mode = false
{% endif %}

# screen_lock_timeout: The timeout in seconds until the screen is locked.
# Minimum allowed value is 10.
# Default: 600
{% set screen_lock_timeout = screen_lock_timeout | default(600) %}
screen_lock_timeout = {{ screen_lock_timeout }}