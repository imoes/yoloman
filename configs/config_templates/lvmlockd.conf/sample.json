{
  "enabled": true,
  "lockdir": "/run/lock/lvm",
  "max_lockspaces": 64,
  "worker_threads": 2,
  "log_level": 3,
  "pid_file": "/run/lvmlockd.pid",
  "lockspaces": [
    {
      "name": "vg_cluster_data",
      "lock_type": "sanlock",
      "path": "/dev/sdb",
      "offset": 0,
      "auto_create": true
    },
    {
      "name": "vg_cluster_vms",
      "lock_type": "dlm",
      "cluster_name": "my_cluster",
      "auto_create": true
    }
  ],
  "pacemaker_enabled": true,
  "pacemaker_socket_path": "/var/run/pacemaker/pacemaker-socket"
}
