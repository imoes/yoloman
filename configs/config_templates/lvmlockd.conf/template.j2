# lvmlockd.conf - LVM lock daemon configuration
# This file controls the behavior of lvmlockd, the distributed lock manager for LVM.
# It uses an INI-style format; Jinja2 variables are substituted in as needed.

[global]
# Enable or disable the lvmlockd daemon on system startup.
enabled = {{ (enabled | default(false)) | lower }}

# Path to the lock directory used for lockspace coordination files.
lockdir = {{ lockdir | default('/run/lock/lvm') }}

# Maximum number of lockspaces the daemon will manage.
max_lockspaces = {{ max_lockspaces | default(128) }}

[daemon]
# Number of worker threads to handle lock operations.
worker_threads = {{ worker_threads | default(4) }}

# Logging verbosity: 0 (error), 1 (warning), 2 (info), 3 (debug).
log_level = {{ log_level | default(2) }}

# Path to the PID file for the lvmlockd daemon.
pid_file = {{ pid_file | default('/run/lvmlockd.pid') }}

[lockspaces]
# List of lockspaces to configure. Each defines a lockspace (e.g., for clustered LVM volumes).
# Each entry defines a lockspace section [name] with specific parameters.
{% for ls in (lockspaces | default([])) %}
[{{ ls.name | default('unnamed') }}]
# Lockspace type: 'dlm' (Distributed Lock Manager) or 'sanlock'
lock_type = {{ ls.lock_type | default('dlm') }}

# For 'sanlock', specify the path to the metadata disk or file and offset.
{% if ls.lock_type | default('dlm') == 'sanlock' %}
path = {{ ls.path | default('') }}
offset = {{ ls.offset | default(0) }}
{% else %}
# For 'dlm', cluster name and optionally domain. If empty, the daemon may auto-discover.
cluster_name = {{ ls.cluster_name | default('') }}
{% endif %}

# Auto-create lockspace on daemon start.
auto_create = {{ ls.auto_create | default(true) | lower }}
{% endfor %}

[pacemaker]
# Integration with Pacemaker (optional).
# Enable Pacemaker coordination.
enabled = {{ (pacemaker_enabled | default(false)) | lower }}

# Unix socket path to communicate with Pacemaker's resource manager.
socket_path = {{ pacemaker_socket_path | default('/var/run/pacemaker/pacemaker-socket') }}