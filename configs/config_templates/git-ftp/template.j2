# git-ftp configuration file (generated by Ansible)
# Stores deployment settings for git-ftp to push local Git branches to remote FTP servers.
# Format is similar to Git's native config (key-value pairs).

# --- Global Defaults ---
# Configuration that applies to all deployments unless overridden by a specific scope.
{% if scopes is defined and scopes | length > 0 %}
{% for scope in scopes %}
{% if loop.first and scope.name == "default" %}
# Global defaults (scope: 'default')
# These settings apply if no specific scope overrides them.
{% for key, value in scope.config.items() %}
git-ftp.{{ key }} = {{ value | tojson }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# --- Scoped Configurations ---
# Environment-specific settings (e.g., 'production', 'staging', 'dev').
# Overrides global defaults for specific deployment targets.
{% if scopes is defined and scopes | length > 0 %}
{% for scope in scopes %}
{% if scope.name != "default" %}
# Scoped configuration: {{ scope.name }}
{% for key, value in scope.config.items() %}
git-ftp.{{ scope.name }}.{{ key }} = {{ value | tojson }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}