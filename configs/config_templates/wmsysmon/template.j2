# Configuration for wmsysmon (Windowmaker System Monitor Dock-app)
# See wmsysmon(1) for details.

# Display name where wmsysmon will appear.
# Syntax: -display <displayname>
# Default: localhost:0.0
display: {{ display | default('localhost:0.0') }}

# Position for wmsysmon using X11 geometry specification.
# Syntax: -geometry +Xpos+Ypos
# Default: +0+0 (top-left corner, no offset)
geometry: {{ geometry | default('+0+0') }}

# Update rate for wmsysmon in milliseconds.
# Controls how frequently the monitor refreshes data.
# Syntax: -r <updateRate>
# Default: 1000 (once per second)
update_rate: {{ update_rate | default(1000) }}

# Enable blinky lights for interrupts visualization.
# When true, visual indicators blink on hardware interrupts.
# Syntax: -l (flag present if true, absent if false)
# Default: false
{% if blinky_lights | default(false) | bool %}-l
{% endif %}