{
  "language": "en",
  "data_directory": "~/.local/share/mnemosyne",
  "database_file": "mnemosyne.db",
  "auto_backup": true,
  "backup_interval_days": 14,
  "card_font_size": 16,
  "theme": "dark",
  "daily_new_card_limit": 10,
  "daily_review_limit": 100,
  "allowed_extensions": [
    ".jpg",
    ".png",
    ".mp3"
  ],
  "max_media_size": 5242880
}
