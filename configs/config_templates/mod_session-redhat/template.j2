# LoadModule directives for mod_session and related Apache modules.
# These directives instruct Apache to load the specified shared object files.

# Name of the session core module.
{% set name = session_module_name | default('session_module') %}
# File path to the session core module.
{% set path = session_module_path | default('modules/mod_session.so') %}
LoadModule {{ name }} {{ path }}

# Name of the session cookie module.
{% set name = session_cookie_module_name | default('session_cookie_module') %}
# File path to the session cookie module.
{% set path = session_cookie_module_path | default('modules/mod_session_cookie.so') %}
LoadModule {{ name }} {{ path }}

# Name of the session DBD (Database) module.
{% set name = session_dbd_module_name | default('session_dbd_module') %}
# File path to the session DBD module.
{% set path = session_dbd_module_path | default('modules/mod_session_dbd.so') %}
LoadModule {{ name }} {{ path }}

# Name of the authentication form module.
{% set name = auth_form_module_name | default('auth_form_module') %}
# File path to the authentication form module.
{% set path = auth_form_module_path | default('modules/mod_auth_form.so') %}
LoadModule {{ name }} {{ path }}
