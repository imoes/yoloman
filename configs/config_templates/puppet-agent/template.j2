# Defaults for puppet - sourced by /etc/init.d/puppet
# This file provides default startup options for the Puppet agent daemon.
# It is sourced by the SysV init script at /etc/init.d/puppet.

# Additional options passed to the Puppet daemon at startup.
# These are concatenated to the default command line arguments.
DAEMON_OPTS="{{ (daemon_opts | default('')) | string | trim }}"