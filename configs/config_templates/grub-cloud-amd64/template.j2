# GRUB Cloud AMD64 Configuration Template
#
# This file configures the GRand Unified Bootloader (GRUB) for cloud-based AMD64 systems.
# Changes to this file must be propagated to /boot/grub/grub.cfg by running 'update-grub'.
# For detailed documentation, consult the manual: info -f grub -n 'Simple configuration'

# ==============================================================================
# Default Boot Entry
# ==============================================================================
# Description: Sets the default menu entry to boot. Can be a menu index (0-based),
# a title string, or a saved entry.
#
# Schema Field: GRUB_DEFAULT
# Default: '0'
GRUB_DEFAULT={{ GRUB_DEFAULT | default('0') }}

# ==============================================================================
# Boot Timeout
# ==============================================================================
# Description: Number of seconds GRUB waits for user input before automatically
# booting the default entry.
#
# Schema Field: GRUB_TIMEOUT
# Default: '5'
GRUB_TIMEOUT={{ GRUB_TIMEOUT | default('5') }}

# ==============================================================================
# Distributor Identification
# ==============================================================================
# Note: This variable is often required for GRUB scripts and menu generation.
# It is typically auto-detected; no schema override provided here.
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`

# ==============================================================================
# Default Kernel Command Line Parameters
# ==============================================================================
# Description: Additional arguments passed to the kernel for the default boot entry.
# For cloud images, this is often empty or contains minimal console parameters,
# as most kernel tuning is handled in GRUB_CMDLINE_LINUX.
#
# Schema Field: GRUB_CMDLINE_LINUX_DEFAULT
# Default: '""'
GRUB_CMDLINE_LINUX_DEFAULT={{ GRUB_CMDLINE_LINUX_DEFAULT | default('""') }}

# ==============================================================================
# General Kernel Command Line Parameters
# ==============================================================================
# Description: Arguments passed to the kernel for ALL boots.
# Common in cloud environments to ensure serial console access for metadata/automation tools
# and to prevent screen blanking which can hang some cloud init processes.
#
# Schema Field: GRUB_CMDLINE_LINUX
# Default: '"console=tty0 console=ttyS0,115200 earlyprintk=ttyS0,115200 consoleblank=0"'
GRUB_CMDLINE_LINUX={{ GRUB_CMDLINE_LINUX | default('"console=tty0 console=ttyS0,115200 earlyprintk=ttyS0,115200 consoleblank=0"') }}

# ==============================================================================
# Terminal Output Configuration
# ==============================================================================
# Description: Specifies the output terminals for the GRUB menu.
# 'gfxterm' enables graphical menu (if supported), 'serial' allows access via serial console.
#
# Schema Field: GRUB_TERMINAL_OUTPUT
# Default: '"gfxterm serial"'
GRUB_TERMINAL_OUTPUT={{ GRUB_TERMINAL_OUTPUT | default('"gfxterm serial"') }}

# ==============================================================================
# Serial Port Configuration
# ==============================================================================
# Description: Configures the serial port settings for GRUB's serial console output.
# Essential for headless/cloud instances accessed via SSH-over-serial or console.
#
# Schema Field: GRUB_SERIAL_COMMAND
# Default: '"serial --speed=115200"'
GRUB_SERIAL_COMMAND={{ GRUB_SERIAL_COMMAND | default('"serial --speed=115200"') }}
