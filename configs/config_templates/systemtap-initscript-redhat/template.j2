# SystemTap Initscript Configuration
# This file configures the SystemTap service behavior on Red Hat systems.
# Each variable overrides the default behavior of the systemtap service scripts.

# Path to the directory containing SystemTap scripts.
# If unset, the system defaults to /etc/systemtap/script.d
# SCRIPT_PATH={{ SCRIPT_PATH | default('/etc/systemtap/script.d') }}

# Path to the directory containing SystemTap configuration files.
# If unset, the system defaults to /etc/systemtap/conf.d
# CONFIG_PATH={{ CONFIG_PATH | default('/etc/systemtap/conf.d') }}

# Path to the SystemTap cache directory.
# If unset, the system defaults to /var/cache/systemtap
# CACHE_PATH={{ CACHE_PATH | default('/var/cache/systemtap') }}

# Path to the SystemTap runtime state directory.
# If unset, the system defaults to /var/run/systemtap
# STAT_PATH={{ STAT_PATH | default('/var/run/systemtap') }}

# Temporary directory for SystemTap operations.
# If unset, the system defaults to /tmp
# TEMP_PATH={{ TEMP_PATH | default('/tmp') }}

# Path to the SystemTap log file.
# If unset, the system defaults to /var/log/systemtap.log
# LOG_FILE={{ LOG_FILE | default('/var/log/systemtap.log') }}

# Fail if any script fails to run successfully.
# Accepted values: yes, no. Default is 'yes'.
# PASSALL={{ PASSALL | default('yes') }}

# Always follow script dependencies.
# Accepted values: yes, no. Default is 'no'.
# RECURSIVE={{ RECURSIVE | default('no') }}

# Automatically recompile scripts if caches are old or missing.
# Accepted values: yes, no. Default is 'yes'.
# AUTOCOMPILE={{ AUTOCOMPILE | default('yes') }}

# List of scripts to start by default. If omitted, all scripts are started.
# If unset, all scripts found in SCRIPT_PATH are started.
# DEFAULT_START={{ DEFAULT_START | default('') }}

# Log boot-time staprun stderr to the script's log file.
# Accepted values: yes, no. Default is 'no'.
# LOG_BOOT_ERR={{ LOG_BOOT_ERR | default('no') }}
