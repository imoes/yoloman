# ==============================================================================
# Regolith Power Daemon Configuration
# ==============================================================================
#
# This file configures regolith-powerd behavior via gsettings.
# The daemon itself does not read this file directly at runtime;
# this template is a canonical representation of the gsettings schema
# that regolith-powerd manages.
#
# This configuration is generated by Ansible. Do not edit manually.
# ==============================================================================

# [org/regolith/regolith-powerd]

# Enable the power settings daemon.
# Default: True
# Description: Enable or disable the regolith-powerd service.
{% if (enable_daemon | default(True)) | bool %}
enabled = true
{% else %}
enabled = false
{% endif %}

# Lock screen timeout in seconds. 0 disables.
# Default: 300
# Description: Time in seconds before the screen is locked.
lock-screen-timeout = {{ (lock_screen_timeout | default(300)) | int }}

# Suspend timeout in seconds. 0 disables.
# Default: 600
# Description: Time in seconds of inactivity before the system suspends.
suspend-timeout = {{ (suspend_timeout | default(600)) | int }}

# Hibernation timeout in seconds. 0 disables.
# Default: 0
# Description: Time in seconds of inactivity before the system hibernates. Set to 0 to disable.
hibernate-timeout = {{ (hibernate_timeout | default(0)) | int }}

# List of inhibition reasons to block via systemd-inhibit.
# Default: ['handle-power-key', 'handle-lid-switch']
# Description: List of systemd-inhibit reasons to block, allowing Sway/swayidle to manage power events instead of logind directly.
# Valid reasons: 'idle-sleep', 'handle-power-key', 'handle-lid-switch', 'handle-lid-switch-docked', 'sleep-button', 'power-button', 'reboot-button', 'halt-button', 'lg-lid-switch'.
# The daemon blocks these to allow Sway/swayidle to handle them.
{% for reason in (inhibition_reasons | default(['handle-power-key', 'handle-lid-switch'])) %}
inhibition-reasons = {{ reason }}
{% endfor %}

# Idle action to perform when idle-timeout is reached.
# Default: 'lock'
# Description: Action to take when idle timeout is reached. Options: lock, suspend, hibernate, blank.
idle-action = '{{ (idle_action | default('lock')) | string }}'

# Time in seconds of inactivity before idle-action is triggered. 0 disables.
# Default: 120
# Description: Time in seconds of inactivity before the idle_action is triggered.
idle-timeout = {{ (idle_timeout | default(120)) | int }}