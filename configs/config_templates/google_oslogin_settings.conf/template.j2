[global]
# Enable or disable OS Login globally
use_oslogin = {{ use_oslogin | lower }}

# TTL (in seconds) for SSH public key cache
ssh_public_key_cache_ttl = {{ ssh_public_key_cache_ttl }}

# Enable or disable SSH key sync from Google metadata
ssh_public_key_sync = {{ ssh_public_key_sync | lower }}

# Enable or disable sudo access via OS Login
sudoers_file = {{ sudoers_file }}

# Enable or disable authorized keys file generation
authorized_keys_file = {{ authorized_keys_file }}

[sshd_config]
# Enable or disable OS Login integration with SSH daemon
oslogin_enabled = {{ sshd_oslogin_enabled | lower }}

# Key types to accept from metadata (comma-separated list)
key_types = {{ sshd_key_types | join(', ') }}

[cache]
# Cache directory for OS Login metadata
CacheDir = {{ cache_dir }}

# Enable or disable caching
UseCache = {{ cache_use_cache | lower }}

# Time-to-live for cached metadata in seconds
CacheExpiration = {{ cache_expiration }}

# Enable or disable GPG verification of cache
GPGVerify = {{ cache_gpg_verify | lower }}

# Number of retries when fetching metadata
MetadataRetries = {{ metadata_retries }}

# Timeout in seconds for metadata fetch
MetadataTimeout = {{ metadata_timeout }}

# Comma-separated list of metadata server hostnames (used in fallback)
MetadataServers = {{ metadata_servers | join(', ') }}

[logging]
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LogLevel = {{ log_level }}

# Path to log file (empty string disables file logging)
LogFile = {{ log_file | default('') }}
