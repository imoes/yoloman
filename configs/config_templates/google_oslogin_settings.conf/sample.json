{
  "use_oslogin": true,
  "ssh_public_key_cache_ttl": 86400,
  "ssh_public_key_sync": true,
  "sudoers_file": "/etc/sudoers.d/oslogin",
  "authorized_keys_file": "/etc/oslogin/authorized_keys",
  "sshd_oslogin_enabled": true,
  "sshd_key_types": [
    "ecdsa-sha2-nistp256",
    "ecdsa-sha2-nistp384",
    "ecdsa-sha2-nistp521",
    "ssh-ed25519",
    "ssh-rsa"
  ],
  "cache_dir": "/var/cache/oslogin",
  "cache_use_cache": true,
  "cache_expiration": 300,
  "cache_gpg_verify": true,
  "metadata_retries": 3,
  "metadata_timeout": 10,
  "metadata_servers": [
    "metadata.google.internal"
  ],
  "log_level": "INFO",
  "log_file": "/var/log/oslogin.log"
}
