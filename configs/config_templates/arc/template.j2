# /etc/arc.conf - Configuration file for arc archive utility
#
# This file is managed by Ansible. Do not edit manually.
# One command per line. Each line starts with a command switch
# (a/m/u/f/d/x/e/r/p/l/v/t/c) followed by optional flags
# (b/i/s/w/n/o/q), optionally ending with a gpassword switch.
# Example: a b s myarchive.tar *.c
# See arc(1) man page for details.

{% for cmd in commands | default([]) %}{{ cmd }}
{% endfor %}