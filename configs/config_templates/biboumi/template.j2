# This is an example configuration for the biboumi component.
# It only contains the default values.
# You need to, at least, set the values for hostname and password, if you
# want biboumi to be able to start

hostname={{ hostname | default('') }}
password={{ password | default('') }}
xmpp_server_ip={{ xmpp_server_ip | default('127.0.0.1') }}
port={{ port | default(5347) }}
admin={{ admin | default('') }}
realname_customization={{ (realname_customization | default(True)) | bool | string | lower }}
realname_from_jid={{ (realname_from_jid | default(False)) | bool | string | lower }}
log_file={{ log_file | default('') }}
ca_file={{ ca_file | default('') }}
outgoing_bind={{ outgoing_bind | default('') }}
log_level={{ log_level | default(1) }}
