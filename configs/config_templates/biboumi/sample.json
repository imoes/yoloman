{
  "hostname": "biboumi.example.org",
  "port": 5347,
  "database_path": "/var/lib/biboumi/biboumi.db",
  "tls_cert": "/etc/biboumi/tls/cert.pem",
  "tls_key": "/etc/biboumi/tls/key.pem",
  "use_tls": true,
  "starttls": true,
  "max_connections_per_user": 3,
  "max_channels_per_server": 15,
  "idle_timeout": 1800,
  "admin_jid": "admin@example.org",
  "log_file": "/var/log/biboumi/biboumi.log",
  "log_level": "WARNING",
  "irc_servers": [
    {
      "hostname": "irc.libera.chat",
      "port": 6697,
      "password": "",
      "use_tls": true,
      "autojoin": true,
      "channels": [
        {
          "name": "#libera-guests",
          "modes": "nt"
        },
        {
          "name": "#biboumi-irc",
          "modes": "n"
        }
      ]
    },
    {
      "hostname": "irc.oftc.net",
      "port": 6697,
      "password": "",
      "use_tls": true,
      "autojoin": false,
      "channels": []
    }
  ]
}
