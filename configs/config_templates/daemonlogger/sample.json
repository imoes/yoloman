{
  "start_enabled": true,
  "daemon_user": "daemonlogger",
  "daemon_group": "daemonlogger",
  "interface": "eth0",
  "tap_interface": "",
  "log_dir": "/var/log/daemonlogger",
  "log_prefix": "capture",
  "snaplen": 1514,
  "rollover_size": 134217728,
  "rollover_time": 3600,
  "max_files": 48,
  "pid_file": "/var/run/daemonlogger/daemonlogger.pid",
  "verbose": false,
  "bpf_rules": [
    {
      "expr": "not port 22",
      "description": "Exclude SSH management traffic to reduce log volume"
    },
    {
      "expr": "not host 10.0.0.1",
      "description": "Exclude monitoring gateway heartbeats"
    }
  ],
  "extra_args": ""
}
