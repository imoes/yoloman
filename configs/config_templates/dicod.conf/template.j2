# DICOD Configuration File
# Managed by Ansible. Do not edit manually.
# See schema fields for descriptions and defaults.

capability (mime,xversion);
timing yes;

# Path to the PID file for the dicod daemon.
pidfile {{ pid_file | default('/var/run/dicod/dicod.pid') }};

# Directory where Dico modules are located.
module-load-path ("{{ module_load_path | default('/usr/lib/dico') }}");

# Enable handling of databases in dict.org format:
load-module dictorg {
	command "dictorg sort trim-ws dbdir=/usr/share/dictd";
}

# dicodconfig automatically generates the database sections for dictorg
# formatted dictionaries, the following line makes use of this facility:
{% if dictorg_db_list | default('') %}
# Using user-specified database list path:
include {{ dictorg_db_list | default('') }}
{% else %}
# Using default database list path:
#include </var/lib/dicod/dictorg-db.list>
{% endif %}

