{
  "bind_address": "127.0.0.1",
  "bind_port": 8090,
  "max_connections": 100,
  "storage_path": "/var/lib/dicod",
  "compact_enabled": true,
  "log_level": "info",
  "log_file": "/var/log/dicod/dicod.log",
  "worker_count": 4,
  "worker_queue_size": 1000,
  "allowed_clients": [
    "127.0.0.1/32"
  ],
  "tls_enabled": false,
  "tls_cert_file": "/etc/dicod/tls.crt",
  "tls_key_file": "/etc/dicod/tls.key",
  "rate_limits": [],
  "metrics_enabled": false,
  "metrics_port": 9090,
  "pid_file": "/var/run/dicod/dicod.pid",
  "module_load_path": "/usr/lib/dico",
  "dictorg_db_list": "/var/lib/dicod/dictorg-db.list",
  "max_children": 18
}
