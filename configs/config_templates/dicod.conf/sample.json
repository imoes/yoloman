{
  "bind_address": "0.0.0.0",
  "bind_port": 8090,
  "max_connections": 200,
  "storage_path": "/var/lib/dicod",
  "compact_enabled": true,
  "log_level": "warn",
  "log_file": "/var/log/dicod/dicod.log",
  "worker_count": 8,
  "worker_queue_size": 2000,
  "allowed_clients": [
    "127.0.0.1/32",
    "10.0.0.0/8"
  ],
  "tls_enabled": true,
  "tls_cert_file": "/etc/dicod/tls/fullchain.pem",
  "tls_key_file": "/etc/dicod/tls/privkey.pem",
  "rate_limits": [
    {
      "ip": "192.168.1.0/24",
      "requests_per_minute": 100
    },
    {
      "ip": "203.0.113.5",
      "requests_per_minute": 10
    }
  ],
  "metrics_enabled": true,
  "metrics_port": 9090
}
