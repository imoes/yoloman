{
  "hostname": "webserver",
  "boot": true,
  "ephemeral": false,
  "private_users": "pick",
  "user": "",
  "working_directory": "",
  "environment_vars": [
    {
      "name": "TZ",
      "value": "Europe/Berlin"
    },
    {
      "name": "LANG",
      "value": "en_US.UTF-8"
    }
  ],
  "capabilities": [],
  "drop_capabilities": [
    "CAP_NET_RAW",
    "CAP_SYS_ADMIN"
  ],
  "no_new_privileges": true,
  "limit_nofile": 65536,
  "limit_nproc": 8192,
  "read_only": false,
  "volatile": "state",
  "bind_mounts": [
    {
      "host": "/srv/webserver/data",
      "container": "/var/www/html"
    },
    {
      "host": "/etc/ssl/certs",
      "container": "/etc/ssl/certs"
    }
  ],
  "bind_read_only_mounts": [
    {
      "host": "/etc/resolv.conf",
      "container": "/etc/resolv.conf"
    }
  ],
  "tmpfs_mounts": [
    "/tmp",
    "/run"
  ],
  "network_private": true,
  "virtual_ethernet": true,
  "bridge": "br0",
  "network_zone": "",
  "port_forwards": [
    {
      "protocol": "tcp",
      "host_port": 8080,
      "container_port": 80
    },
    {
      "protocol": "tcp",
      "host_port": 8443,
      "container_port": 443
    }
  ],
  "macvlan_interfaces": []
}
