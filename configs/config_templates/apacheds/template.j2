# =========================================================================
# ApacheDS (Apache Directory Server) Configuration
# =========================================================================
# This file configures the core directory service, partitions, interceptors,
# authenticators, password policies, and transport servers (LDAP, LDAPS, Kerberos, HTTP).
# It is an LDIF-style configuration structure expected by ApacheDS.
# =========================================================================

# --- Version and Root Configuration ---
version: 1
dn: ou=config
ou: config
objectclass: top
objectclass: organizationalUnit

# --- Directory Service Core Settings ---
# These settings control the global behavior of the directory server instance.
dn: ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-directoryService
ads-directoryserviceid: default
# Replica ID for the directory service.
ads-dsreplicaid: {{ ads_ds_replica_id | default('1') }}
# Synchronization period in milliseconds.
ads-dssyncperiodmillis: {{ ads_ds_sync_period_millis | default('15000') }}
# Whether passwords are hidden in logs/attributes.
ads-dsPasswordHidden: {{ ads_ds_password_hidden | default('FALSE') }}
# Allow anonymous access to the directory.
ads-dsallowanonymousaccess: {{ ads_ds_allow_anonymous_access | default('TRUE') }}
# Enable access control interceptors.
ads-dsaccesscontrolenabled: {{ ads_ds_access_control_enabled | default('FALSE') }}
# Enable denormalization of operational attributes.
ads-dsdenormalizeopattrsenabled: {{ ads_ds_denormalize_op_attrsenabled | default(False) }}
# Enable the directory service itself.
ads-enabled: {{ ads_enabled | default(True) }}

# --- Change Log Configuration ---
# Tracks changes to the directory for replication or auditing.
dn: ads-changeLogId=defaultChangeLog,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-changeLog
ads-changeLogId: defaultChangeLog
# Expose the change log to external consumers.
ads-changeLogExposed: {{ ads_changelog_exposed | default('FALSE') }}
# Enable the change log functionality.
ads-enabled: {{ ads_changelog_enabled | default(False) }}

# --- Journal Configuration ---
# Persistent journal for transactional integrity.
dn: ads-journalId=defaultJournal,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-journal
ads-journalId: defaultJournal
# Name of the journal file.
ads-journalFileName: {{ ads_journal_file_name | default('Journal.txt') }}
# Working directory for the journal.
ads-journalWorkingDir: {{ ads_journal_working_dir | default('/') }}
# Number of journal rotations to keep.
ads-journalRotation: {{ ads_journal_rotation | default('2') }}
# Enable the journal functionality.
ads-enabled: {{ ads_journal_enabled | default(False) }}

# --- Interceptors Section ---
# Interceptors process requests/responses. They are ordered by `ads-interceptororder`.
dn: ou=interceptors,ads-directoryServiceId=default,ou=config
ou: interceptors
objectclass: organizationalUnit
objectclass: top

# Normalization Interceptor (Order 1)
# Normalizes RDN attributes (e.g., case folding).
dn: ads-interceptorId=normalizationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-interceptororder: 1
ads-interceptorclassname: org.apache.directory.server.core.normalization.NormalizationInterceptor
ads-interceptorid: normalizationInterceptor
# Enable the normalization interceptor.
ads-enabled: {{ ads_interceptor_normalization_enabled | default(True) }}

# Authentication Interceptor (Order 2)
# Handles bind/unbind operations and delegates to authenticators.
dn: ads-interceptorId=authenticationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
objectclass: ads-authenticationInterceptor
ads-interceptororder: 2
ads-interceptorclassname: org.apache.directory.server.core.authn.AuthenticationInterceptor
ads-interceptorid: authenticationInterceptor
# Enable the authentication interceptor.
ads-enabled: {{ ads_interceptor_authentication_enabled | default(True) }}

# --- Authenticators Section ---
# Configured under the authentication interceptor.
dn: ou=authenticators,ads-interceptorId=authenticationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
ou: authenticators
objectclass: top
objectclass: organizationalUnit

# Anonymous Authenticator
# Allows anonymous binds.
dn: ads-authenticatorid=anonymousauthenticator,ou=authenticators,ads-interceptorId=authenticationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
ads-authenticatorid: anonymousauthenticator
objectclass: top
objectclass: ads-base
objectClass: ads-authenticator
objectClass: ads-authenticatorImpl
ads-authenticatorClass: org.apache.directory.server.core.authn.AnonymousAuthenticator
# Base DN for anonymous authenticator.
ads-baseDn: {{ ads_anonymous_auth_base_dn | default('') }}
# Enable the anonymous authenticator.
ads-enabled: {{ ads_anonymous_auth_enabled | default(True) }}

# Simple Authenticator
# Handles simple username/password binds.
dn: ads-authenticatorid=simpleauthenticator,ou=authenticators,ads-interceptorId=authenticationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
ads-authenticatorid: simpleauthenticator
objectclass: top
objectclass: ads-base
objectClass: ads-authenticator
objectClass: ads-authenticatorImpl
ads-authenticatorClass: org.apache.directory.server.core.authn.SimpleAuthenticator
# Base DN for simple authenticator.
ads-baseDn: {{ ads_simple_auth_base_dn | default('') }}
# Enable the simple authenticator.
ads-enabled: {{ ads_simple_auth_enabled | default(True) }}

# Strong Authenticator
# Handles certificate-based or other strong authentication.
dn: ads-authenticatorid=strongauthenticator,ou=authenticators,ads-interceptorId=authenticationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
ads-authenticatorid: strongauthenticator
objectclass: top
objectclass: ads-base
objectClass: ads-authenticator
objectClass: ads-authenticatorImpl
ads-authenticatorClass: org.apache.directory.server.core.authn.StrongAuthenticator
# Base DN for strong authenticator.
ads-baseDn: {{ ads_strong_auth_base_dn | default('') }}
# Enable the strong authenticator.
ads-enabled: {{ ads_strong_auth_enabled | default(True) }}

# Delegating Authenticator
# Delegates authentication to another server.
dn: ads-authenticatorid=delegatingauthenticator,ou=authenticators,ads-interceptorId=authenticationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
ads-authenticatorid: delegatingauthenticator
objectclass: top
objectclass: ads-base
objectClass: ads-authenticator
objectClass: ads-authenticatorImpl
ads-authenticatorClass: org.apache.directory.server.core.authn.DelegatingAuthenticator
# Base DN for delegating authenticator.
ads-baseDn: {{ ads_delegating_auth_base_dn | default('') }}
# Enable the delegating authenticator.
ads-enabled: {{ ads_delegating_auth_enabled | default(False) }}

# --- Password Policies Section ---
# Password policies are applied to users in the directory.
dn: ou=passwordPolicies,ads-interceptorId=authenticationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectClass: organizationalUnit
objectClass: top
ou: passwordPolicies

# Default Password Policy
dn: ads-pwdId=default,ou=passwordPolicies,ads-interceptorId=authenticationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectClass: top
objectClass: ads-base
objectClass: ads-passwordPolicy
ads-pwdId: default
# Safe modify for passwords (prevents bypassing password change logic).
ads-pwdSafeModify: {{ ads_pwd_safe_modify | default('FALSE') }}
# Maximum password age in seconds (0 = no limit).
ads-pwdMaxAge: {{ ads_pwd_max_age | default('0') }}
# Failure count interval in seconds (window for lockout check).
ads-pwdFailureCountInterval: {{ ads_pwd_failure_count_interval | default('30') }}
# Attribute holding the password.
ads-pwdAttribute: {{ ads_pwd_attribute | default('userPassword') }}
# Maximum password failures before lockout.
ads-pwdMaxFailure: {{ ads_pwd_max_failure | default('5') }}
# Enable password lockout.
ads-pwdLockout: {{ ads_pwd_lockout | default('TRUE') }}
# Password must change on next login.
ads-pwdMustChange: {{ ads_pwd_must_change | default('FALSE') }}
# Lockout duration in seconds (0 = permanent).
ads-pwdLockoutDuration: {{ ads_pwd_lockout_duration | default('0') }}
# Minimum password length.
ads-pwdMinLength: {{ ads_pwd_min_length | default('5') }}
# Number of previous passwords to remember.
ads-pwdInHistory: {{ ads_pwd_in_history | default('5') }}
# Warning time before expiration in seconds.
ads-pwdExpireWarning: {{ ads_pwd_expire_warning | default('600') }}
# Minimum password age in seconds.
ads-pwdMinAge: {{ ads_pwd_min_age | default('0') }}
# Allow users to change their password.
ads-pwdAllowUserChange: {{ ads_pwd_allow_user_change | default('TRUE') }}
# Grace authentication limit (number of uses of expired password).
ads-pwdGraceAuthNLimit: {{ ads_pwd_grace_auth_n_limit | default('5') }}
# Password quality check level.
ads-pwdCheckQuality: {{ ads_pwd_check_quality | default('1') }}
# Maximum password length (0 = no limit).
ads-pwdMaxLength: {{ ads_pwd_max_length | default('0') }}
# Grace period expiration in seconds.
ads-pwdGraceExpire: {{ ads_pwd_grace_expire | default('0') }}
# Minimum delay for password attempts (brute force protection).
ads-pwdMinDelay: {{ ads_pwd_min_delay | default('0') }}
# Maximum delay for password attempts.
ads-pwdMaxDelay: {{ ads_pwd_max_delay | default('0') }}
# Maximum idle time before lockout.
ads-pwdMaxIdle: {{ ads_pwd_max_idle | default('0') }}
# Validator class for passwords.
ads-pwdValidator: {{ ads_pwd_validator | default('org.apache.directory.server.core.api.authn.ppolicy.DefaultPasswordValidator') }}
# Enable password policies.
ads-enabled: {{ ads_pwd_enabled | default(True) }}

# --- Interceptors (Continued) ---

# Referral Interceptor (Order 3)
# Handles referral responses.
dn: ads-interceptorId=referralInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-interceptororder: 3
ads-interceptorclassname: org.apache.directory.server.core.referral.ReferralInterceptor
ads-interceptorid: referralInterceptor
# Enable the referral interceptor.
ads-enabled: {{ ads_interceptor_referral_enabled | default(True) }}

# ACI Authorization Interceptor (Order 4)
# Access Control Item authorization.
dn: ads-interceptorId=aciAuthorizationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-interceptororder: 4
ads-interceptorclassname: org.apache.directory.server.core.authz.AciAuthorizationInterceptor
ads-interceptorid: aciAuthorizationInterceptor
# Enable the ACI authorization interceptor.
ads-enabled: {{ ads_interceptor_aci_authz_enabled | default(True) }}

# Default Authorization Interceptor (Order 5)
# Default authorization if no ACIs match.
dn: ads-interceptorId=defaultAuthorizationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-interceptororder: 5
ads-interceptorclassname: org.apache.directory.server.core.authz.DefaultAuthorizationInterceptor
ads-interceptorid: defaultAuthorizationInterceptor
# Enable the default authorization interceptor.
ads-enabled: {{ ads_interceptor_default_authz_enabled | default(True) }}

# Administrative Point Interceptor (Order 6)
# Restricts operations on administrative entries.
dn: ads-interceptorId=administrativePointInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-interceptororder: 6
ads-interceptorclassname: org.apache.directory.server.core.admin.AdministrativePointInterceptor
ads-interceptorid: administrativePointInterceptor
# Enable the administrative point interceptor.
ads-enabled: {{ ads_interceptor_admin_point_enabled | default(True) }}

# Exception Interceptor (Order 7)
# Converts exceptions to LDAP result codes.
dn: ads-interceptorId=exceptionInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-interceptororder: 7
ads-interceptorclassname: org.apache.directory.server.core.exception.ExceptionInterceptor
ads-interceptorid: exceptionInterceptor
# Enable the exception interceptor.
ads-enabled: {{ ads_interceptor_exception_enabled | default(True) }}

# Key Derivation Interceptor (Order 8)
# Used for Kerberos key derivation.
dn: ads-interceptorId=keyDerivationInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-enabled: {{ ads_interceptor_key_derivation_enabled | default(False) }}
ads-interceptororder: 8
ads-interceptorclassname: org.apache.directory.server.core.kerberos.KeyDerivationInterceptor
ads-interceptorid: keyDerivationInterceptor

# Password Hashing Interceptor (Order 9)
# Handles password hashing algorithms.
dn: ads-interceptorId=passwordHashingInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
objectclass: ads-hashInterceptor
ads-enabled: {{ ads_interceptor_password_hashing_enabled | default(True) }}
ads-interceptororder: 9
ads-interceptorclassname: org.apache.directory.server.core.hash.ConfigurableHashingInterceptor
ads-interceptorid: passwordHashingInterceptor
# Hash algorithm for passwords (e.g., SSHA, SHA).
ads-hashAlgorithm: {{ ads_hash_algorithm | default('SSHA') }}
# LDAP OID for the hash attribute.
ads-hashAttribute: {{ ads_hash_attribute | default('2.5.4.35') }}

# Schema Interceptor (Order 10)
# Enforces schema rules.
dn: ads-interceptorId=schemaInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-interceptororder: 10
ads-interceptorclassname: org.apache.directory.server.core.schema.SchemaInterceptor
ads-interceptorid: schemaInterceptor
# Enable the schema interceptor.
ads-enabled: {{ ads_interceptor_schema_enabled | default(True) }}

# Operational Attribute Interceptor (Order 11)
# Manages operational attributes like createTime.
dn: ads-interceptorId=operationalAttributeInterceptor,ou=interceptors,ads-directoryServiceId=default,ou=config
objectclass: top
objectclass: ads-base
objectclass: ads-interceptor
ads-interceptororder: 11
ads-interceptorclassname: org.apache.directory.server.core.operational.OperationalAttributeInterceptor
ads-interceptorid: operationalAttributeInterceptor
# Enable the operational attribute interceptor.
ads-enabled: {{ ads_interceptor_op_attr_enabled | default(True) }}

# Collective Attribute Interceptor (Order 12)
# Manages collective attributes (shared across partitions).
