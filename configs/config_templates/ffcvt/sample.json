{
  "encoding_preset": "slow",
  "output_format": "mkv",
  "crf": 20,
  "audio_bitrate": "192k",
  "audio_sample_rate": 44100,
  "audio_channels": 2,
  "video_codec": "libx264",
  "audio_codec": "aac",
  "metadata_options": [
    "title=Holidays 2025",
    "artist=John Doe"
  ],
  "exclude_patterns": [
    "*.bak",
    "*_raw*"
  ],
  "output_dir": "/srv/media/encoded",
  "overwrite": true,
  "dry_run": false,
  "verbose": true
}
