# ffcvt configuration file
# This file is generated by Ansible from ffcvt schema fields.
# All variables use explicit defaults to prevent rendering errors
# when optional fields are omitted by the role consumer.

# Encoding preset (ffmpeg -preset).
# Valid values: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow.
FFCVT_PRESET: {{ encoding_preset | default('medium') }}

# Output container format (e.g., mp4, webm, mkv).
FFCVT_FORMAT: {{ output_format | default('mp4') }}

# Quality preset (deprecated in newer versions; prefer CRF).
FFCVT_QUALITY: {{ quality_level | default('high') }}

# Constant Rate Factor (0-51); lower = higher quality, 23 is default for libx264.
FFCVT_CRF: {{ crf | default(23) }}

# Alias for encoding_preset (ffmpeg -preset).
FFCVT_PRESET_SPEED: {{ preset_speed | default('medium') }}

# Audio bitrate (e.g., 128k, 192k, 320k).
FFCVT_ABR: {{ audio_bitrate | default('128k') }}

# Audio sample rate in Hz (e.g., 44100, 48000).
FFCVT_ASAMPLE_RATE: {{ audio_sample_rate | default(48000) }}

# Number of audio channels (e.g., 1 for mono, 2 for stereo).
FFCVT_ACHANNELS: {{ audio_channels | default(2) }}

# Video codec (e.g., libx264, libx265, libvpx-vp9).
FFCVT_VCODEC: {{ video_codec | default('libx264') }}

# Audio codec (e.g., aac, libopus, libmp3lame).
FFCVT_ACODEC: {{ audio_codec | default('aac') }}

# Metadata key=value pairs assigned as FFCVT_META_1, FFCVT_META_2, etc.
{% for opt in metadata_options | default([]) %}
FFCVT_META_{{ loop.index }}: {{ opt }}
{% endfor %}

# List of shell-style glob patterns (e.g., ['*.tmp', '*_orig*']) to skip during batch conversion.
FFCVT_EXCLUDE: {{ exclude_patterns | default([]) | join(',') }}

# Base output directory for converted files (if empty, use same dir as source).
FFCVT_OUTDIR: {{ output_dir | default('') }}

# Overwrite output file if it exists. true = -y, false = -n.
FFCVT_OVERWRITE: {{ overwrite | default(False) | string | lower }}

# Print command without executing (for dry-run).
FFCVT_DRYRUN: {{ dry_run | default(False) | string | lower }}

# Enable verbose logging.
FFCVT_VERBOSE: {{ verbose | default(False) | string | lower }}