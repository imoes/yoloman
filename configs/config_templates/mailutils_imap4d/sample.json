{
  "debug_level": 1,
  "max_connections": 200,
  "max_connections_per_ip": 20,
  "idle_timeout": 900,
  "auth_timeout": 120,
  "starttls_enabled": true,
  "tls_cert_file": "/etc/ssl/certs/mail.example.com.crt",
  "tls_key_file": "/etc/ssl/private/mail.example.com.key",
  "tls_min_protocol": "1.2",
  "tls_ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "ssl_enabled": false,
  "listen_addresses": [
    {
      "address": "0.0.0.0",
      "port": 143,
      "ssl": false
    },
    {
      "address": "[::]",
      "port": 143,
      "ssl": false
    },
    {
      "address": "0.0.0.0",
      "port": 993,
      "ssl": true
    },
    {
      "address": "[::]",
      "port": 993,
      "ssl": true
    }
  ],
  "auth_mechs": [
    "PLAIN",
    "LOGIN",
    "CRAM-MD5"
  ],
  "maildir_enabled": true,
  "mailbase": "/var/mail/virtual",
  "mailspool": "/var/mail/virtual",
  "enable_quota": true,
  "enable_sieve": true,
  "sieve_dir": "~/.mailutils/sieve",
  "sieve_global_dir": "/etc/mailutils/sieve",
  "enable_acl": true,
  "log_facility": "daemon",
  "log_level": 3,
  "log_file": "/var/log/mailutils-imap4d.log",
  "pam_service": "mailutils",
  "chroot_dir": "/var/empty",
  "run_user": "mail",
  "run_group": "mail"
}
