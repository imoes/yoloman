## GNU Mailutils IMAP4 daemon configuration
## Generated by mailutils_imap4d service

## Global options
{
  ## Enable debugging output (0 = none, 1 = minimal, 2 = verbose)
  debug: {{ debug_level }};

  ## Maximum number of simultaneous connections
  max-connections: {{ max_connections }};

  ## Maximum number of connections per IP address
  max-connections-per-ip: {{ max_connections_per_ip }};

  ## Timeout for idle connections (seconds)
  idle-timeout: {{ idle_timeout }};

  ## Timeout for authentication (seconds)
  auth-timeout: {{ auth_timeout }};

  ## Enable STARTTLS support
  starttls: {{ starttls_enabled | lower }};

  ## Path to TLS certificate chain (PEM format)
  tls-cert-file: {{ tls_cert_file }};

  ## Path to TLS private key file
  tls-key-file: {{ tls_key_file }};

  ## Minimum TLS protocol version (e.g., "1.2", "1.3")
  tls-min-protocol: "{{ tls_min_protocol }}";

  ## TLS cipher list (OpenSSL-style cipher strings)
  tls-ciphers: "{{ tls_ciphers }}";

  ## Enable SSL/TLS on standard IMAPS port (993)
  ssl: {{ ssl_enabled | lower }};

  ## Listen address(es) and port(s)
  {% for addr in listen_addresses %}
  # Listen on {{ addr.address }}:{{ addr.port }}{% if addr.ssl %} (SSL/TLS){{ "" }}{% endif %}
  address: "{{ addr.address }}";
  port: {{ addr.port }};
  {% if addr.ssl %}
  ssl: yes;
  {% else %}
  ssl: no;
  {% endif %}
  {% endfor %}

  ## Authentication mechanism(s) to offer to clients
  {% for mech in auth_mechs %}
  # Use {{ mech }} authentication mechanism
  authMech: "{{ mech }}";
  {% endfor %}

  ## Mailbox format and path configuration
  maildir: {{ maildir_enabled | lower }};
  mailbase: "{{ mailbase }}";
  mailspool: "{{ mailspool }}";

  ## Enable/Disable IMAP4rev1 features
  {% if enable_quota %}
  quota: yes;
  {% else %}
  quota: no;
  {% endif %}

  {% if enable_sieve %}
  sieve: yes;
  sieve_dir: "{{ sieve_dir }}";
  sieve_global_dir: "{{ sieve_global_dir }}";
  {% else %}
  sieve: no;
  sieve_global_dir: "";
  sieve_dir: "";
  {% endif %}

  ## Enable/Disable ACL support
  {% if enable_acl %}
  acl: yes;
  {% else %}
  acl: no;
  {% endif %}

  ## Logging configuration
  log_facility: {{ log_facility }};
  {% if log_level > 0 %}
  log_level: {{ log_level }};
  {% endif %}
  log_file: "{{ log_file }}";

  ## PAM service name for authentication (if using PAM)
  pam_service: "{{ pam_service }}";

  ## Optional: chroot directory (empty string = no chroot)
  chroot: "{{ chroot_dir }}";

  ## Optional: run as user/group
  user: "{{ run_user }}";
  group: "{{ run_group }}";
}
