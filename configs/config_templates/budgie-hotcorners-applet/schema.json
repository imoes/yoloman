{
  "exec_path": {
    "type": "string",
    "default": "/usr/libexec/budgie-hotcorners/budgie-hotcorners",
    "description": "Path to the budgie-hotcorners executable"
  },
  "gsettings_schema": {
    "type": "string",
    "default": "org.ubuntubudgie.budgie-extras.HotCorners",
    "description": "GSettings schema path for the autostart condition"
  },
  "gsettings_key": {
    "type": "string",
    "default": "active",
    "description": "GSettings key name used in the autostart condition"
  },
  "auto_restart_mate": {
    "type": "bool",
    "default": true,
    "description": "Enable auto-restart for MATE session"
  },
  "auto_restart_gnome": {
    "type": "bool",
    "default": true,
    "description": "Enable auto-restart for GNOME session"
  }
}
