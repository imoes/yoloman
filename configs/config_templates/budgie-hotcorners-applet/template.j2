# ==============================================================================
# Budgie Hotcorners Autostart Desktop Entry
# ==============================================================================
# This template generates a .desktop file to automatically launch the
# budgie-hotcorners background process on Budgie desktop environments.
#
# Schema References:
#   - exec_path: Path to the budgie-hotcorners executable
#   - gsettings_schema: GSettings schema path for the autostart condition
#   - gsettings_key: GSettings key name used in the autostart condition
#   - auto_restart_mate: Enable auto-restart for MATE session
#   - auto_restart_gnome: Enable auto-restart for GNOME session
# ==============================================================================

[Desktop Entry]

# Type of desktop entry. Must be "Application".
Type=Application

# Display name of the application (English default).
Name=Budgie Hotcorners

# Localized display names.
Name[ca]=Cantons actius del Budgie
Name[en_GB]=Budgie Hotcorners
Name[fi]=Budgie Hotcorners
Name[it]=Budgie Hotcorners
Name[pl]=Budgie Hotcorners
Name[pt_BR]=Cantos ativos Budgie
Name[pt_PT]=Cantos ativos Budgie

# Description of the application's function (English default).
Comment=Kick starts the budgie-hotcorners process

# Localized descriptions.
Comment[ca]=Kick inicia el procés dels cantons actius del Budgie
Comment[en_GB]=Kick starts the budgie-hotcorners process
Comment[fi]=Potku käynnistää budgie-hotcorners-prosessi
Comment[it]=Avvia il processo budgie-hotcorners
Comment[pt_BR]=Inicia o processo de cantos ativos Budgie
Comment[pt_PT]=Inicia o processo de cantos ativos-budgie

# Executable path. Uses the schema default '/usr/libexec/budgie-hotcorners/budgie-hotcorners'.
Exec={{ exec_path | default('/usr/libexec/budgie-hotcorners/budgie-hotcorners') }}

# Do not display in application menus.
NoDisplay=true

# Autostart Condition: The application starts only when the specified GSettings key is active.
# Schema: {{ gsettings_schema | default('org.ubuntubudgie.budgie-extras.HotCorners') }}
# Key: {{ gsettings_key | default('active') }}
AutostartCondition=GSettings {{ gsettings_schema | default('org.ubuntubudgie.budgie-extras.HotCorners') }} {{ gsettings_key | default('active') }}

# MATE Session Auto-Restart Setting:
# Enabled by default. If set to true, the MATE session manager will restart the process if it crashes.
X-MATE-AutoRestart={{ auto_restart_mate | default(true) }}

# GNOME Session Auto-Restart Setting:
# Enabled by default. If set to true, the GNOME session manager will restart the process if it crashes.
X-GNOME-AutoRestart={{ auto_restart_gnome | default(true) }}
