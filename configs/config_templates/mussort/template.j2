# Mussort configuration file
#
# This template configures 'mussort', a CLI tool for sorting music files
# (MP3, OGG, FLAC) into directory structures based on ID3 tags.
# Settings are exposed as key-value pairs to be consumed by wrapper scripts
# or systemd service ExecStart directives.
#
# Global Principle: Self-documenting. Every directive is preceded by its
# schema description and the corresponding CLI flag.

# Source directory to scan for MP3, OGG, and FLAC files.
# Corresponds to the positional argument 'dir1' in SYNOPSIS.
# Default: /var/lib/mussort/music
SOURCE_DIR={{ source_dir | default('/var/lib/mussort/music') }}

# Enable --compilation mode to sort compilations as ALBUM/FILENAME.
# Corresponds to: -c, --compilation
# Default: false
COMPILATION={{ compilation | default(false) | lower }}

# Enable --keepdupes to keep both duplicates, naming the last one with a suffix.
# Corresponds to: -k, --keepdupes
# Default: true
KEEP_DUPES={{ keepdupes | default(true) | lower }}

# Enable --largest to remove the smallest file when duplicates are found.
# Corresponds to: -l, --largest
# Default: false
LARGEST={{ largest | default(false) | lower }}

# Enable --noremove to ignore the last duplicate file found.
# Corresponds to: -n, --noremove
# Default: false
NO_REMOVE={{ noremove | default(false) | lower }}

# Enable --insensitive for case-insensitive directory name searches.
# Corresponds to: -i, --insensitive
# Cannot be combined with --consistent.
# Default: false
CASE_INSENSITIVE={{ case_insensitive | default(false) | lower }}

# Enable --consistent for consistent, case-normalized directory names.
# Corresponds to: -s, --consistent
# Cannot be combined with --insensitive.
# Default: false
CONSISTENT={{ consistent | default(false) | lower }}

# Enable --allowspecial to keep special characters in names.
# Corresponds to: -a, --allowspecial
# Default: false
ALLOW_SPECIAL={{ allowspecial | default(false) | lower }}

# Enable --silentskip to suppress messages about skipped files.
# Corresponds to: --silentskip
# Default: false
SILENT_SKIP={{ silentskip | default(false) | lower }}

# Verbosity level. 0: normal, 1: verbose, 2: very verbose.
# Corresponds to: -v
# Default: 0
VERBOSITY={{ verbosity | default(0) }}

# Enable --quiet to suppress all status messages.
# Corresponds to: --quiet
# Default: false
QUIET={{ quiet | default(false) | lower }}

# Enable --dry-run to preview actions without making changes.
# Corresponds to: --dry-run
# Default: false
DRY_RUN={{ dry_run | default(false) | lower }}

# Enable --no-cache to disable file information caching.
# Corresponds to: --no-cache
# Default: false
NO_CACHE={{ no_cache | default(false) | lower }}

# Enable --refresh-cache to write new info to cache without reading old.
# Corresponds to: --refresh-cache
# Default: false
REFRESH_CACHE={{ refresh_cache | default(false) | lower }}

# Enable --cleancache to remove dangling and expired cache entries.
# Corresponds to: --cleancache
# Default: false
CLEAN_CACHE={{ clean_cache | default(false) | lower }}

# Enable --cleantree to remove empty directories in the tree.
# Corresponds to: --cleantree
# Default: false
CLEAN_TREE={{ clean_tree | default(false) | lower }}