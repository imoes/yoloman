{
  "origin": {
    "type": "string",
    "default": "example.com",
    "description": "Zone origin/domain name (without trailing dot)"
  },
  "ttl": {
    "type": "number",
    "default": 86400,
    "description": "Default TTL for records in the zone"
  },
  "serial": {
    "type": "number",
    "default": 2025040501,
    "description": "SOA serial number (typically YYYYMMDDnn)"
  },
  "refresh": {
    "type": "number",
    "default": 3600,
    "description": "SOA refresh interval (seconds)"
  },
  "retry": {
    "type": "number",
    "default": 900,
    "description": "SOA retry interval (seconds)"
  },
  "expire": {
    "type": "number",
    "default": 604800,
    "description": "SOA expire time (seconds)"
  },
  "minimum": {
    "type": "number",
    "default": 86400,
    "description": "SOA negative caching TTL (seconds)"
  },
  "primary_ns": {
    "type": "string",
    "default": "ns1",
    "description": "Primary name server (host only; domain will be appended)"
  },
  "admin_email": {
    "type": "string",
    "default": "admin",
    "description": "Admin email (host only; domain will be appended, '.' replaced with '_' for '@')"
  },
  "name_servers": {
    "type": "list",
    "default": [
      "ns1"
    ],
    "description": "List of authoritative name servers (hostnames, without dots)",
    "items": {
      "type": "string",
      "default": "ns1",
      "description": "Name server hostname"
    }
  },
  "records": {
    "type": "list",
    "default": [],
    "description": "List of DNS records",
    "items": {
      "type": "object",
      "default": {},
      "description": "Single DNS record",
      "fields": {
        "name": {
          "type": "string",
          "default": "",
          "description": "Record name (e.g. 'www' or '@', empty string treated as '@')"
        },
        "type": {
          "type": "string",
          "enum": [
            "A",
            "AAAA",
            "CNAME",
            "MX",
            "TXT",
            "NS",
            "PTR",
            "SRV"
          ],
          "default": "A",
          "description": "Record type"
        },
        "value": {
          "type": "string",
          "default": "192.0.2.1",
          "description": "Record value (IP for A/AAAA, target for CNAME/NS/MX/SRV, text for TXT)"
        },
        "ttl": {
          "type": "number",
          "default": null,
          "description": "Optional per-record TTL. If omitted, uses zone default TTL"
        }
      }
    }
  }
}
