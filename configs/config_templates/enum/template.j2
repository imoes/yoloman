# enum(1) configuration — enumerated value generator
#
# This file contains a list of `enum(1)` command strings. Each entry is a
# complete invocation of the enum utility, which generates a sequence of
# enumerated values.
#
# Syntax per line: [OPTIONS] LEFT .. COUNTx STEP .. RIGHT
#   - LEFT: Starting value of the sequence.
#   - COUNT: Number of items to generate.
#   - STEP: Increment value for each subsequent item.
#   - RIGHT: Alternative to COUNT/STEP, specifying the ending value directly.
#
# See the enum(1) manual page for full syntax details and examples.

{# List of enum command lines (complete invocations) to execute or serialize. Each entry must be a valid enum(1) command string as per the manp #}
{% for cmd in commands | default([]) %}
# Command: {{ cmd }}
{{ cmd }}
{% endfor %}