# Configuration for claws-mail-newmail-plugin
# This file controls the logging behavior of the claws-mail-newmail-plugin.
# It defines where new mail notifications are logged and which message
# headers/attributes are included in those logs.

# Log file path where new mail header summaries are written.
# If left empty, the plugin derives a default path using the username.
log_file = "{{ log_file | default('/home/' ~ (username | default('') | trim) ~ '/Mail/NewLog') }}"

# User login name, used to derive default log file path (e.g., /home/username/Mail/NewLog).
# Must be a valid Unix username.
username = "{{ username | default('') }}"

# Message headers to include in the log (fixed set per plugin docs)
headers = [
  "Date",
  "Subject",
  "From",
  "To",
  "Cc"
]

# Additional message attributes to log (fixed set per plugin docs)
attributes = [
  "Size",
  "Path",
  "Message",
  "Folder"
]