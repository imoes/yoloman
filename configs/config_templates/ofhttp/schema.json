{
  "uris": {
    "type": "list",
    "default": [],
    "description": "List of URIs to download or request."
  },
  "headers": {
    "type": "list",
    "default": [],
    "description": "List of HTTP headers to send. Each item is an object with 'key' and 'value'. Only 'key' and 'value' fields are allowed in items."
  },
  "insecure": {
    "type": "bool",
    "default": false,
    "description": "Ignore TLS errors and allow insecure redirects."
  },
  "ignore_status": {
    "type": "bool",
    "default": false,
    "description": "Ignore HTTP status code."
  },
  "output": {
    "type": "string",
    "default": "",
    "description": "Output file name (- for stdout)."
  },
  "continue_download": {
    "type": "bool",
    "default": false,
    "description": "Continue download of existing file."
  },
  "force": {
    "type": "bool",
    "default": false,
    "description": "Force overwrite existing file."
  },
  "method": {
    "type": "string",
    "default": "",
    "description": "HTTP method (e.g. GET, POST, HEAD).",
    "enum": [
      "POST",
      "HEAD",
      "OPTIONS"
    ]
  },
  "body_file": {
    "type": "string",
    "default": "",
    "description": "File to send as body (- for stdin)."
  },
  "body_stdin": {
    "type": "bool",
    "default": false,
    "description": "Use stdin as body source."
  },
  "proxy": {
    "type": "string",
    "default": "",
    "description": "SOCKS5 proxy address (e.g. 127.0.0.1:9050)."
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Quiet mode (no output, except errors)."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Verbose mode (print headers)."
  }
}
