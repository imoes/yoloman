{
  "server": {
    "host": "127.0.0.1",
    "port": 8080
  },
  "state_dir": "/var/lib/debusine",
  "tmp_dir": "/var/tmp/debusine",
  "database": {
    "backend": "postgres",
    "uri": "postgresql://debusine:secret@db.example.com/debusine_prod"
  },
  "workers": {
    "count": 3,
    "queues": [
      {
        "name": "default",
        "count": 5
      },
      {
        "name": "priority",
        "count": 2
      }
    ]
  },
  "auth": {
    "enabled": true,
    "secret_key": "supersecretkeywith32chars+and+numbers+12345",
    "token_expiry": 43200
  },
  "cors": {
    "enabled": true,
    "allowed_origins": [
      "https://web.debusine.example.com",
      "https://ci.debusine.example.com"
    ]
  },
  "notifications": {
    "enabled": true,
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "use_tls": true,
      "from_address": "debusine-notifs@example.com",
      "user": "debusine-notifs"
    }
  },
  "limits": {
    "max_upload_size": 2147483648,
    "max_concurrent_jobs": 20,
    "max_workers_total": 30
  },
  "logging": {
    "level": "warning",
    "path": "/var/log/debusine/server.log"
  },
  "debug": false
}
