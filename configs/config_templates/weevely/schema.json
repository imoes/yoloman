{
  "target_url": {
    "type": "string",
    "default": "http://example.com/shell.php",
    "description": "Target URL for the web shell"
  },
  "password": {
    "type": "string",
    "default": "secretpassword",
    "description": "Password for authentication with the target"
  },
  "session_path": {
    "type": "string",
    "default": "/home/user/.weevely/sessions",
    "description": "Path to store session files"
  },
  "agent_path": {
    "type": "string",
    "default": "/home/user/.weevely/agents",
    "description": "Path to store generated agents"
  },
  "modules": {
    "type": "list",
    "default": [
      ":audit_filesystem",
      ":shell_sh"
    ],
    "description": "List of modules to enable by default"
  },
  "proxy": {
    "type": "string",
    "default": "",
    "description": "Proxy settings for HTTP/HTTPS traffic"
  },
  "user_agent": {
    "type": "string",
    "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "description": "User-Agent string for HTTP requests"
  },
  "timeout": {
    "type": "number",
    "default": 10,
    "description": "Timeout in seconds for HTTP requests"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output"
  }
}
