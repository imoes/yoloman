# =============================================================================
# cc1541 Disk Image Creation Configuration
# =============================================================================
# This template generates command-line arguments for the cc1541 utility,
# used to create and manipulate Commodore 1541 disk images (D64, D71, D81).
# The output consists of single-letter flags followed by optional arguments,
# one per line, mimicking the command-line interface.
# =============================================================================

# -----------------------------------------------------------------------------
# Disk Creation Options (Global Image Properties)
# -----------------------------------------------------------------------------

# -n diskname: Set the disk name.
# Description: Disk name (default: 'cc1541')
# Output format: "n <name>"
{% set _diskname = diskname | default('cc1541') %}
{% if _diskname is defined and _diskname != 'cc1541' or (diskname is not defined and diskname is undefined) %}
# -n diskname (default: cc1541)
n {{ _diskname }}
{% endif %}

# -i diskid: Set the Disk ID in hexadecimal.
# Description: Disk ID in hex (default: '00 2a')
# Output format: "i <id>"
{% set _diskid = diskid | default('00 2a') %}
# Note: We always emit if defined, or use default if strictly needed, 
# but usually CLI defaults apply if omitted. Here we follow the schema:
# if provided, use it. If not, cc1541 uses its own default.
# However, to make it self-documenting and explicit:
{% if diskid is not undefined %}
# -i id (default: 00 2a)
i {{ _diskid }}
{% endif %}

# -4: Use SPEED DOS BAM on tracks 35-40.
# Description: Use SPEED DOS BAM on tracks 35-40 (default: False)
# Output format: "4"
{% if speed_dos | default(False) %}
# -4 use tracks 35-40 with SPEED DOS BAM
4
{% endif %}

# -5: Use DOLPHIN DOS BAM on tracks 35-40.
# Description: Use DOLPHIN DOS BAM on tracks 35-40 (default: False)
# Output format: "5"
{% if dolphin_dos | default(False) %}
# -5 use tracks 35-40 with DOLPHIN DOS BAM
5
{% endif %}

# -d track: Maintain a shadow directory on a specific track.
# Description: Track number for shadow directory (0 = disabled)
# Output format: "d <track>"
{% set _shadow_dir = shadow_dir | default(0) %}
{% if _shadow_dir != 0 %}
# -d track maintain shadow directory
d {{ _shadow_dir }}
{% endif %}

# -g filename: Write output in G64 format.
# Description: Filename for G64 output (empty = none)
# Output format: "g <filename>"
{% set _g64_output = g64_output | default('') %}
{% if _g64_output %}
# -g filename write G64 output file
g {{ _g64_output }}
{% endif %}

# -H message: Set a hidden BAM message.
# Description: Hidden BAM message (up to 85 chars for D64, 20 for SPEED DOS)
# Output format: "H <message>"
{% set _hidden_bam = hidden_bam | default('') %}
{% if _hidden_bam %}
# -H message hidden BAM message
H {{ _hidden_bam | replace('\n', ' ') }}
{% endif %}

# -V: Do not modify image unless it is a valid CBM DOS format.
# Description: Only modify image if it is valid CBM DOS format (default: False)
# Output format: "V"
{% if no_modification_without_valid_cbm | default(False) %}
# -V do not modify unless valid CBM DOS format
V
{% endif %}

# -M numchars: Maximum filename length for hash computation.
# Description: Hash computation maximum filename length, this must match loader option FILENAME_MAXLENGTH in Krill’s loader. Default is 16.
# Output format: "M <length>"
{% set _hash_max_length = hash_max_length | default(16) %}
{% if _hash_max_length != 16 %}
# -M numchars hash computation maximum filename length
M {{ _hash_max_length }}
{% endif %}

# -m: Ignore filename hash collisions.
# Description: Ignore filename hash collisions, without this switch a collision results in an error. (default: False)
# Output format: "m"
{% if ignore_hash_collisions | default(False) %}
# -m ignore filename hash collisions
m
{% endif %}

# -----------------------------------------------------------------------------
# File Writing Options
# -----------------------------------------------------------------------------
# The following sections iterate over the 'files' list.
# Each entry in 'files' corresponds to a group of operations for a single
# file or directory entry being written to the disk image.
# Arguments are emitted in the order they would appear on the command line.

{% set _files = files | default([]) %}
{% for file_entry in _files %}
# =============================================================================
# File Entry Block
# =============================================================================
# This block generates flags for a single file entry defined in 'files'.

# -w localname: Write a local filesystem file to the disk image.
# Description: Local filesystem path to write (for -w/-W)
# Output format: "w <path>"
{% set _localname = file_entry.localname | default('') %}
{% if _localname %}
# -w localname write local file
w {{ _localname }}
{% endif %}

# -f filename: Set the filename on the disk image.
# Description: Filename on disk image; prefix with '#' for PETSCII codes (e.g. '#a0,8,1')
# Output format: "f <name>"
{% set _filename = file_entry.filename | default('') %}
{% if _filename %}
# -f filename set filename (prefix '#' for PETSCII)
f {{ _filename }}
{% endif %}

# -T filetype: Set the file type.
# Description: Filetype: PRG, SEQ, USR, REL, DEL, or decimal number 0-255
# Output format: "T <type>"
{% set _filetype = file_entry.filetype | default('PRG') %}
{% if _filetype != 'PRG' %}
# -T filetype set filetype (PRG, SEQ, USR, REL, DEL, or number)
T {{ _filetype }}
{% endif %}

# -P: Set the write-protect flag for this file.
# Description: Set write protect flag for this file (default: False)
# Output format: "P"
{% if file_entry.write_protect | default(False) %}
# -P set write protect flag
P
{% endif %}

# -O: Set the open flag for this file.
# Description: Set open flag for this file (default: False)
# Output format: "O"
{% if file_entry.open_flag | default(False) %}
# -O set open flag
O
{% endif %}

# -B numblocks: Set file size in blocks.
# Description: File size in blocks (not for Transwarp files)
# Output format: "B <blocks>"
{% set _numblocks = file_entry.numblocks | default(0) %}
{% if _numblocks %}
# -B numblocks set file size in blocks
B {{ _numblocks }}
{% endif %}

# -L: Add a directory entry without writing file data.
# Description: Add directory entry only (track and sector = 0)
# Output format: "L"
{% if file_entry.loop_only | default(False) %}
# -L add dir entry without writing file
L
{% endif %}

# -N: Force creation of a new directory entry.
# Description: Force creation of new directory entry (even if exists)
# Output format: "N"
{% if file_entry.force_new | default(False) %}
# -N force new directory entry
N
{% endif %}

# -o: Do not overwrite if file with same name exists.
# Description: Do not overwrite if file with same name exists (default: False)
# Output format: "o"
{% if file_entry.no_overwrite | default(False) %}
# -o do not overwrite existing file
o
{% endif %}

# -c: Cluster-optimized storage (D71 only).
# Description: Cluster-optimize (D71 only)
# Output format: "c"
{% if file_entry.cluster_optimized | default(False) %}
# -c cluster-optimized (D71 only)
c
{% endif %}

# -----------------------------------------------------------------------------
# Track/Sector Control Options
# -----------------------------------------------------------------------------

# -s interleave: File-specific sector interleave.
# Description: File-specific sector interleave; defaults to global -S if 0
# Output format: "s <interleave>"
{% set _sector_interleave = file_entry.sector_interleave | default(0) %}
{% if _sector_interleave %}
# -s next file sector interleave
s {{ _sector_interleave }}
{% endif %}

# -e: Start next file on an empty track.
# Description: Start next file on an empty track (default: False)
# Output format: "e"
{% if file_entry.empty_track_start | default(False) %}
# -e start next file on empty track
e
{% endif %}

# -E: Try to fit file on a single track.
# Description: Try to fit file on a single track (default: False)
# Output format: "E"
{% if file_entry.single_track | default(False) %}
# -E try to fit file on single track
E
{% endif %}

# -r min_track: Restrict blocks to a specific track or higher.
# Description: Restrict blocks to track or higher
# Output format: "r <track>"
{% set _min_track = file_entry.min_track | default(0) %}
{% if _min_track %}
# -r restrict to track or higher
r {{ _min_track }}
{% endif %}

# -b start_sector: Set the beginning sector for the file.
# Description: Set beginning sector (not for D81/Transwarp)
# Output format: "b <sector>"
{% set _start_sector = file_entry.start_sector | default(0) %}
{% if _start_sector %}
# -b set beginning sector
b {{ _start_sector }}
{% endif %}

# -F first_sector_new_track: First sector on new track for the next file.
# Description: First sector on new track for next file; negative = aligned + interleave - |value|
# Output format: "F <sector>"
{% set _first_sector_new_track = file_entry.first_sector_new_track | default(0) %}
{% if _first_sector_new_track %}
# -F next file first sector on new track
F {{ _first_sector_new_track }}
{% endif %}

# -t: Use directory track to store files.
# Description: Use directory track to store files (default: False)
# Output format: "t"
{% if file_entry.use_dir_track | default(False) %}
# -t use directory track to store files
t
{% endif %}

# -u free_dir_blocks: Directory blocks to leave free when using -t.
# Description: Directory blocks to leave free when using -t
# Output format: "u <blocks>"
{% set _free_dir_blocks = file_entry.free_dir_blocks | default(2) %}
{% if _free_dir_blocks %}
# -u dir blocks to leave free when using -t
u {{ _free_dir_blocks }}
{% endif %}

# -x: Do not split files over directory track hole.
# Description: Do not split files over directory track hole (default: False)
# Output format: "x"
{% if file_entry.no_split | default(False) %}
# -x don't split over directory track hole
x
{% endif %}

# -----------------------------------------------------------------------------
# Fastloader/Transwarp Options
# -----------------------------------------------------------------------------

# -W localname: Write in Transwarp format (implies -W localname).
# Description: Write in Transwarp format (implies -W localname)
# Output format: "W <path>"
{% if file_entry.transwarp_format | default(False) %}
# -W write as Transwarp format
W {{ _localname }}
{% endif %}

# -A allocation: Transwarp allocation strategy.
# Description: Transwarp allocation strategy: 0 = command order, 1 = save space
# Output format: "A <strategy>"
{% set _transwarp_allocation = file_entry.transwarp_allocation | default(1) %}
{% if file_entry.transwarp_format | default(False) %}
# -A allocation strategy for Transwarp files (0 or 1)
A {{ _transwarp_allocation }}
{% endif %}

# -K key: Encryption key for Transwarp files.
# Description: Encryption key for Transwarp (up to 29 chars)
# Output format: "K <key>"
{% set _transwarp_key = file_entry.transwarp_key | default('') %}
{% if file_entry.transwarp_format | default(False) and _transwarp_key %}
# -K encryption key for Transwarp files
K {{ _transwarp_key }}
{% endif %}

{% endfor %}

# -----------------------------------------------------------------------------
# Miscellaneous Global Options
# -----------------------------------------------------------------------------

# -v: Enable verbose output.
# Description: Enable verbose output (default: False)
# Output format: "v"
{% if verbose | default(False) %}
# -v be verbose
v
{% endif %}

# -q: Enable quiet output.
# Description: Enable quiet output (default: False)
# Output format: "q"
{% if quiet | default(False) %}
# -q be quiet
q
{% endif %}

# -U mapping: PETSCII-to-Unicode mapping.
# Description: PETSCII-to-Unicode mapping (0=ASCII, 1=upper, 2=lower)
# Output format: "U <mapping>"
{% set _unicode_mapping = unicode_mapping | default(0) %}
{% if _unicode_mapping %}
# -U mapping PETSCII to Unicode mapping
U {{ _unicode_mapping }}
{% endif %}

# -R level: Restore level for deleted/formatted files.
# Description: Restore level for deleted/formatted files (-1 = disabled, 0-5 = levels)
# Output format: "R <level>"
{% set _restore_level = restore_level | default(-1) %}
{% if _restore_level != -1 %}
# -R level try to restore files
R {{ _restore_level }}
{% endif %}

# -S interleave: Default sector interleave (D64/D71 only).
# Description: Default sector interleave (D64/D71 only, not for D81)
# Output format: "S <interleave>"
{% set _sector_interleave_global = sector_interleave | default(10) %}
{% if _sector_interleave_global != 10 %}
# -S default sector interleave
S {{ _sector_interleave_global }}
{% endif %}