# =============================================================================
# sexpp Configuration Template
# =============================================================================
# This template configures `sexpp`, a utility to read, parse, and print S-expressions.
# Each directive is self-documented below. Ensure all variables are provided via
# the Ansible inventory or group_vars, otherwise the schema default (shown in comments)
# is applied.
# =============================================================================

# -----------------------------------------------------------------------------
# input_file: Path to input file. Defaults to /dev/stdin if not specified.
# Man page option: -i filename
# -----------------------------------------------------------------------------
input_file: "{{ input_file | default('/dev/stdin') }}"

# -----------------------------------------------------------------------------
# output_file: Path to output file. Defaults to /dev/stdout if not specified.
# Man page option: -o filename
# -----------------------------------------------------------------------------
output_file: "{{ output_file | default('/dev/stdout') }}"

# -----------------------------------------------------------------------------
# prompt_mode: Enable -p: Prompt user for console input.
# Man page option: -p
# -----------------------------------------------------------------------------
prompt_mode: {{ prompt_mode | default(false) }}

# -----------------------------------------------------------------------------
# single_string_mode: Enable -s: Treat input as a single string instead of parsing S-expressions.
# Man page option: -s
# -----------------------------------------------------------------------------
single_string_mode: {{ single_string_mode | default(false) }}

# -----------------------------------------------------------------------------
# output_advanced: Enable -a: Write output in advanced transport format.
# Man page option: -a
# -----------------------------------------------------------------------------
output_advanced: {{ output_advanced | default(false) }}

# -----------------------------------------------------------------------------
# output_base64: Enable -b: Write output in base-64 format.
# Man page option: -b
# -----------------------------------------------------------------------------
output_base64: {{ output_base64 | default(false) }}

# -----------------------------------------------------------------------------
# output_canonical: Enable -c: Write output in canonical format.
# Man page option: -c
# -----------------------------------------------------------------------------
output_canonical: {{ output_canonical | default(true) }}

# -----------------------------------------------------------------------------
# no_linefeeds: Enable -l: Suppress linefeeds after output.
# Man page option: -l
# -----------------------------------------------------------------------------
no_linefeeds: {{ no_linefeeds | default(false) }}

# -----------------------------------------------------------------------------
# line_width: Set line width (-w). 0 implies no constraint.
# Man page option: -w width (Default: 75)
# -----------------------------------------------------------------------------
line_width: {{ line_width | default(75) }}

# -----------------------------------------------------------------------------
# loop_mode: Enable -x: Execute main loop repeatedly until end of file.
# Man page option: -x
# -----------------------------------------------------------------------------
loop_mode: {{ loop_mode | default(false) }}