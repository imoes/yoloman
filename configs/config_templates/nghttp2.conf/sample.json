{
 "backends": [
  "127.0.0.1:8080",
  "127.0.0.1:8081"
 ],
 "connect_timeout": 5000,
 "daemon": false,
 "daemon_group": "nghttp2",
 "daemon_pid_file": "/run/nghttp2/nghttp2.pid",
 "daemon_user": "nghttp2",
 "fallback": true,
 "fronted": {
  "access_log": "",
  "access_log_format": "",
  "access_log_path": "",
  "alpn": "",
  "ciphers": "",
  "client_max_concurrent_streams": "",
  "error_log": "",
  "error_log_path": "",
  "hpkp": "",
  "hsts": "",
  "hsts_include_subdomains": "",
  "hsts_preload": "",
  "http1_upgrade": "",
  "listen": "",
  "log_level": "",
  "max_request_header_size": "",
  "ocsp_responder_cert": "",
  "ocsp_stapling": "",
  "port": "",
  "proxy_protocol": "",
  "request_header_buffer_size": "",
  "server_cert": "",
  "server_private_key": "",
  "tls": "",
  "tls_min_version": ""
 },
 "fronted.access_log": true,
 "fronted.access_log_format": "",
 "fronted.access_log_path": "/var/log/nghttp2/access.log",
 "fronted.alpn": true,
 "fronted.ciphers": "ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
 "fronted.client_max_concurrent_streams": 128,
 "fronted.error_log": true,
 "fronted.error_log_path": "/var/log/nghttp2/error.log",
 "fronted.hpkp": false,
 "fronted.hsts": 31536000,
 "fronted.hsts_include_subdomains": true,
 "fronted.hsts_preload": false,
 "fronted.http1_upgrade": true,
 "fronted.listen": "0.0.0.0",
 "fronted.log_level": "INFO",
 "fronted.max_request_header_size": 65536,
 "fronted.ocsp_responder_cert": "",
 "fronted.ocsp_stapling": false,
 "fronted.port": 8443,
 "fronted.proxy_protocol": false,
 "fronted.request_header_buffer_size": 8192,
 "fronted.server_cert": "/etc/nghttp2/tls/server.crt",
 "fronted.server_private_key": "/etc/nghttp2/tls/server.key",
 "fronted.tls": true,
 "fronted.tls_min_version": "1.2",
 "idle_timeout": 30000,
 "max_concurrent_streams": 128,
 "mutual_tls": false,
 "retry_count": 3,
 "retry_interval": 500,
 "retry_on_failure": true,
 "retry_on_status": "502,503,504",
 "server_push": false,
 "strict_frame_size": true,
 "tls": false,
 "tls_ca_cert": "",
 "tls_client_cert": "",
 "tls_client_key": "",
 "tls_verify_hostname": true,
 "workers": 2
}
