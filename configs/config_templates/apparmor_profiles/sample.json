{
  "docker_bin_path": "/usr/bin/docker",
  "docker_config_paths": [
    "/etc/docker/**",
    "/etc/ssl/certs/docker/**"
  ],
  "docker_state_paths": [
    "/var/lib/docker/**"
  ],
  "docker_socket_path": "/run/docker.sock",
  "seccomp_profiles": [
    "/etc/docker/seccomp-profile.json",
    "/usr/share/docker/seccomp-default.json"
  ],
  "allow_dangerous_caps": [
    "setuid",
    "setgid",
    "sys_admin",
    "sys_ptrace",
    "net_admin",
    "net_raw"
  ],
  "deny_rules": [
    "deny /proc/*/mem w,",
    "deny /proc/*/kmem w,"
  ],
  "mount_rules_enabled": true,
  "ptrace_enabled": true
}
