{
  "mapcache_cache_disk_base": {
    "type": "string",
    "default": "/tmp",
    "description": "Base directory for disk cache storage."
  },
  "mapcache_cache_sqlite_dbfile_pattern": {
    "type": "string",
    "default": "/tmp/{tileset}-{z}-{grid}.db",
    "description": "Path pattern for SQLite database files."
  },
  "mapcache_source_vmap0_format": {
    "type": "string",
    "default": "image/png",
    "description": "Output format for the VMAP0 WMS source."
  },
  "mapcache_source_vmap0_layers": {
    "type": "string",
    "default": "basic",
    "description": "Layers to request from the VMAP0 WMS source."
  },
  "mapcache_source_vmap0_url": {
    "type": "string",
    "default": "http://vmap0.tiles.osgeo.org/wms/vmap0",
    "description": "URL of the VMAP0 WMS source."
  },
  "mapcache_tileset_t1_format": {
    "type": "string",
    "default": "PNG",
    "description": "Tile format for tileset t1.",
    "enum": [
      "PNG",
      "JPEG",
      "KML"
    ]
  },
  "mapcache_tileset_t1_metatile": {
    "type": "string",
    "default": "5 5",
    "description": "Metatile dimensions (x y) for tileset t1."
  },
  "mapcache_tileset_t1_metabuffer": {
    "type": "number",
    "default": 10,
    "description": "Metabuffer size for tileset t1."
  },
  "mapcache_tileset_t1_expires": {
    "type": "number",
    "default": 3600,
    "description": "Cache expiry time in seconds for tileset t1."
  },
  "mapcache_tileset_t1_dimension_dim1_connection": {
    "type": "string",
    "default": "host=localhost user=mapcache password=mapcache dbname=mapcache port=5433",
    "description": "Database connection string for t1 dimension dim1."
  },
  "mapcache_tileset_t2_format": {
    "type": "string",
    "default": "PNG",
    "description": "Tile format for tileset t2.",
    "enum": [
      "PNG",
      "JPEG",
      "KML"
    ]
  },
  "mapcache_tileset_t2_metatile": {
    "type": "string",
    "default": "5 5",
    "description": "Metatile dimensions (x y) for tileset t2."
  },
  "mapcache_tileset_t2_metabuffer": {
    "type": "number",
    "default": 10,
    "description": "Metabuffer size for tileset t2."
  },
  "mapcache_tileset_t2_expires": {
    "type": "number",
    "default": 3600,
    "description": "Cache expiry time in seconds for tileset t2."
  },
  "mapcache_tileset_t2_store_assemblies": {
    "type": "string",
    "default": "false",
    "description": "Whether to store assemblies for tileset t2."
  },
  "mapcache_tileset_t2_assembly_type": {
    "type": "string",
    "default": "stack",
    "description": "Assembly type for tileset t2."
  },
  "mapcache_tileset_t2_dimension_dim1_connection": {
    "type": "string",
    "default": "host=localhost user=mapcache password=mapcache dbname=mapcache port=5433",
    "description": "Database connection string for t2 dimension dim1."
  },
  "mapcache_default_format": {
    "type": "string",
    "default": "JPEG",
    "description": "Default tile format if not specified in tileset.",
    "enum": [
      "PNG",
      "JPEG",
      "KML"
    ]
  },
  "mapcache_service_wms_enabled": {
    "type": "string",
    "default": "true",
    "description": "Enable WMS service."
  },
  "mapcache_service_wms_full_wms": {
    "type": "string",
    "default": "assemble",
    "description": "Full WMS assembly mode.",
    "enum": [
      "assemble",
      "on"
    ]
  },
  "mapcache_service_wms_resample_mode": {
    "type": "string",
    "default": "bilinear",
    "description": "Resampling mode for WMS."
  },
  "mapcache_service_wms_format": {
    "type": "string",
    "default": "JPEG",
    "description": "Format for WMS service.",
    "enum": [
      "PNG",
      "JPEG",
      "KML"
    ]
  },
  "mapcache_service_wms_maxsize": {
    "type": "number",
    "default": 4096,
    "description": "Maximum image size for WMS."
  },
  "mapcache_service_wmts_enabled": {
    "type": "string",
    "default": "true",
    "description": "Enable WMTS service."
  },
  "mapcache_service_tms_enabled": {
    "type": "string",
    "default": "true",
    "description": "Enable TMS service."
  },
  "mapcache_service_kml_enabled": {
    "type": "string",
    "default": "true",
    "description": "Enable KML service."
  },
  "mapcache_service_gmaps_enabled": {
    "type": "string",
    "default": "true",
    "description": "Enable GMaps service."
  },
  "mapcache_service_ve_enabled": {
    "type": "string",
    "default": "true",
    "description": "Enable Virtual Earth service."
  },
  "mapcache_service_mapguide_enabled": {
    "type": "string",
    "default": "true",
    "description": "Enable MapGuide service."
  },
  "mapcache_service_demo_enabled": {
    "type": "string",
    "default": "true",
    "description": "Enable Demo service."
  },
  "mapcache_errors": {
    "type": "string",
    "default": "report",
    "description": "Error reporting mode."
  },
  "mapcache_locker_disk_directory": {
    "type": "string",
    "default": "/tmp",
    "description": "Directory for disk-based locking."
  },
  "mapcache_locker_disk_timeout": {
    "type": "number",
    "default": 300,
    "description": "Lock timeout in seconds."
  },
  "mapcache_log_level": {
    "type": "string",
    "default": "debug",
    "description": "Logging level."
  }
}
