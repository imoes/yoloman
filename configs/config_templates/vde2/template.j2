#!/bin/sh

# =============================================================================
# VDE2 Network Interface Control Script
# Generated by Ansible Jinja2 template for vde2 package
# This script manages the lifecycle of vde_switch and slirpvde processes
# associated with network interfaces.
# =============================================================================

# Path to the vde_switch binary
# Schema field: vde_switch_path
# Default: /usr/bin/vde_switch
# Description: Directory where vde2 stores its runtime files (PIDs, control sockets)
VDE_SWITCH={{ vde_switch_path | default('/usr/bin/vde_switch') }}

# Path to the slirpvde binary
# Schema field: slirpvde_path
# Default: /usr/bin/slirpvde
# Description: Path to the slirpvde binary
SLIRPVDE={{ slirpvde_path | default('/usr/bin/slirpvde') }}

# Directory where vde2 stores its runtime files (PIDs, control sockets)
# Schema field: vde_run_dir
# Default: /var/run/vde2
# Description: Path to the vde_run_dir variable
# Note: $IFACE is expected to be provided by the environment/caller
if [ -z "$IF_VDE2_SWITCH" -a -z "$IF_VDE2_PLUG" -a -z "$IF_VDE2_SLIRP" ]; then
  exit 0
fi

# PID file for the VDE plug instance
# Used to manage the stop lifecycle of the plug component
PIDFILE="{{ vde_run_dir | default('/var/run/vde2') }}/$IFACE-plug.pid"
# Control socket file for the VDE switch instance
# Used to communicate with the running switch daemon
CTLFILE="{{ vde_run_dir | default('/var/run/vde2') }}/$IFACE.ctl"

if [ -f $PIDFILE ]; then
    start-stop-daemon --stop --quiet --pidfile $PIDFILE
    rm -f $PIDFILE
fi

# PID file for the slirpvde instance
PIDFILE="{{ vde_run_dir | default('/var/run/vde2') }}/$IFACE-slirp.pid"

if [ -f $PIDFILE ]; then
    start-stop-daemon --stop --quiet --pidfile $PIDFILE \
        --oknodo --exec $SLIRPVDE
    rm -f $PIDFILE
fi

# PID file and Control directory for the main VDE switch instance
PIDFILE="{{ vde_run_dir | default('/var/run/vde2') }}/$IFACE.pid"
CTLDIR="{{ vde_run_dir | default('/var/run/vde2') }}/$IFACE.ctl"

if [ -f $PIDFILE ]; then
    start-stop-daemon --stop --quiet --pidfile $PIDFILE \
        --oknodo --exec $VDE_SWITCH
    rm -f $PIDFILE

    # set the tap interface to non-persistant, see #568363
    vde_tunctl -b -d $IFACE 1>/dev/null
fi

rm -rf $CTLDIR
rm -f $CTLDIR.*