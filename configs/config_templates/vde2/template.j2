# ==============================================================================
# VDE2 (Virtual Distributed Ethernet) Configuration
# ==============================================================================
# This template configures VDE2 utilities: vde_switch and slirpvde.
# VDE2 provides a virtual network switch and a user-space PPP-to-VDE bridge.
#
# Schema Fields Referenced:
#   - vde_switch_path: Path to the vde_switch binary
#   - slirpvde_path:   Path to the slirpvde binary
#   - vde_run_dir:     Directory for runtime files (PIDs, control sockets)
# ==============================================================================

# ------------------------------------------------------------------------------
# VDE Switch Configuration
# ------------------------------------------------------------------------------

# Path to the vde_switch binary executable.
# Schema Field: vde_switch_path
vde_switch_path = {{ vde_switch_path | default('/usr/bin/vde_switch') }}

# ------------------------------------------------------------------------------
# SLIRPVDE Configuration
# ------------------------------------------------------------------------------

# Path to the slirpvde binary executable.
# slirpvde bridges a PPP connection to a VDE switch, allowing legacy PPP
# clients to communicate over the virtual network.
# Schema Field: slirpvde_path
slirpvde_path = {{ slirpvde_path | default('/usr/bin/slirpvde') }}

# ------------------------------------------------------------------------------
# Runtime & State Management
# ------------------------------------------------------------------------------

# Directory where vde2 stores its runtime files.
# This includes the PID file for vde_switch and the control socket used by
# management tools (e.g., vde_switch -s) to control the daemon.
# Ensure this directory exists and is writable by the user running vde_switch.
# Schema Field: vde_run_dir
vde_run_dir = {{ vde_run_dir | default('/var/run/vde2') }}
