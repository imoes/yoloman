{
  "vde_switch_path": {
    "type": "string",
    "default": "/usr/bin/vde_switch",
    "description": "Path to the vde_switch binary"
  },
  "slirpvde_path": {
    "type": "string",
    "default": "/usr/bin/slirpvde",
    "description": "Path to the slirpvde binary"
  },
  "vde_run_dir": {
    "type": "string",
    "default": "/var/run/vde2",
    "description": "Directory where vde2 stores its runtime files (PIDs, control sockets)"
  }
}
