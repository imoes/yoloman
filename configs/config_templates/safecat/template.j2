# safecat configuration template
# safecat is a simple file synchronization tool that uses hard links.
# It writes data to a temporary directory and then atomically links
# the completed files to the destination directory.

# The temporary directory for writing data before linking to the destination.
# Default: /var/lib/safecat/tmp
safecat {{ safecat_tempdir | default('/var/lib/safecat/tmp') }} {{ safecat_destdir | default('/var/lib/safecat/new') }}

# The destination directory where complete files are linked into.
# Default: /var/lib/safecat/new