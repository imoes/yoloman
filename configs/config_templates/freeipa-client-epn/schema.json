{
  "smtp_server": {
    "type": "string",
    "default": "localhost",
    "description": "SMTP server hostname or IP address"
  },
  "smtp_port": {
    "type": "number",
    "default": 25,
    "description": "SMTP server port"
  },
  "smtp_timeout": {
    "type": "number",
    "default": 60,
    "description": "SMTP response timeout in seconds"
  },
  "smtp_security": {
    "type": "string",
    "default": "none",
    "description": "SMTP security type: none, starttls, or ssl",
    "enum": [
      "none",
      "starttls",
      "ssl"
    ]
  },
  "smtp_admin": {
    "type": "string",
    "default": "root@localhost",
    "description": "From email address for bounces"
  },
  "smtp_delay": {
    "type": "number",
    "default": 0,
    "description": "Delay between emails in milliseconds"
  },
  "notify_ttls": {
    "type": "string",
    "default": "28, 14, 7, 3, 1",
    "description": "Comma-separated list of days before expiration to notify"
  },
  "msg_charset": {
    "type": "string",
    "default": "utf8",
    "description": "Message character set"
  },
  "msg_subtype": {
    "type": "string",
    "default": "plain",
    "description": "Message MIME sub-content type",
    "enum": [
      "plain",
      "html",
      "related",
      "encrypted"
    ]
  }
}
