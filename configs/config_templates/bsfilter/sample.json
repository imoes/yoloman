{
  "homedir": "/var/lib/bsfilter",
  "db": "gdbm",
  "jtokenizer": "mecab",
  "method": "rf",
  "max_line": 1000,
  "auto_update": true,
  "disable_degeneration": true,
  "refer_header": [
    "X-Spam-Status"
  ],
  "mark_spam_subject": "[SPAM] ",
  "header_prefix": "X-Bayesian",
  "insert_flag": true,
  "insert_probability": true,
  "insert_revision": false,
  "max_mail": 15000,
  "min_mail": 12000,
  "mbox": false,
  "imap_settings": [
    {
      "imap_server": "imap.example.com",
      "imap_port": 993,
      "imap_auth": "cram-md5",
      "imap_user": "user@example.com",
      "imap_password": "secret",
      "imap_folder_clean": "Inbox/Clean",
      "imap_folder_spam": "Inbox/Spam",
      "ssl": true,
      "imap_fetch_unseen": true,
      "imap_reset_seen_flag": true
    }
  ],
  "pop_settings": [
    {
      "pop_server": "pop.example.com",
      "pop_port": 110,
      "pop_proxy_port": 10110,
      "pop_user": "user@example.com",
      "pop_max_size": 100000,
      "ssl": false
    }
  ]
}
