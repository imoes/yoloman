# chase(1) configuration file.
# One file path per line; chase resolves symlinks and follows the chain for each.
# Lines starting with '#' are comments and ignored by chase(1).
# Use '--from-file <path>' to pass this configuration file to chase.
#
# The list of paths is provided via the Ansible variable 'file_paths' (list of strings).
# If the variable is undefined or empty, the file remains empty (chase receives no paths).

{% for path in file_paths | default([]) %}
# {{ path | quote }}
{% endfor %}