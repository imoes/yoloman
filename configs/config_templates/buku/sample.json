{
  "db_path": "/var/lib/buku/bookmarks.db",
  "proxy": "http://proxy.internal:3128/",
  "browser": "firefox",
  "editor": "vim -f",
  "colors": "oKlxm",
  "threads": 8,
  "auto_import": true,
  "import_tags_from_folders": true,
  "default_import_tags": [
    "imported",
    "auto"
  ],
  "immutable_by_default": false,
  "tag_delimiter": ",",
  "default_output_format": "color",
  "default_count": 20,
  "prompt_keys_disabled": false,
  "disable_color": false,
  "open_in_background": false,
  "offline_by_default": false,
  "suggest_tags": true,
  "tag_redirect_pattern": "http {}",
  "error_tag_pattern": "http {}",
  "del_error_codes": "404,410,500",
  "url_redirect": true,
  "export_on_changes": false,
  "export_format": "xbel",
  "import_format": "detect",
  "firefox_profile": "default-release",
  "encryption_passes": 64000,
  "encryption_enabled": false,
  "nostdin": false,
  "debug": false
}
