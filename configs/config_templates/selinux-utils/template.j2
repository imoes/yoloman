# SELinux configuration file
# This file controls the state of SELinux on the system.
# SETTING: Default SELinux mode (enforcing, permissive, or disabled)
SELINUX={{ selinux_mode }}

# SETTING: Type of SELinux policy to load
SELINUXTYPE={{ selinux_policy_type }}

# SETTING: Enable SELinux boot-time enforcement (yes/no)
# Note: On some systems, this is deprecated and ignored; use `setenforce` or kernel parameter `selinux=1 enforcing=1`
BOOTLOADER={{ selinux_bootloader_enforce }}
