{
  "checksum": {
    "type": "number",
    "default": 1,
    "description": "Checksum algorithm: 0 for none, 1 for CRC32 (default)"
  },
  "file_metadata_compression": {
    "type": "number",
    "default": 0,
    "description": "Compression for file metadata: 0=None (default), 1=Deflate, 2=Heatshrink_11_4, 3=Heatshrink_12_4"
  },
  "print_metadata_compression": {
    "type": "number",
    "default": 0,
    "description": "Compression for print metadata: 0=None (default), 1=Deflate, 2=Heatshrink_11_4, 3=Heatshrink_12_4"
  },
  "printer_metadata_compression": {
    "type": "number",
    "default": 0,
    "description": "Compression for printer metadata: 0=None (default), 1=Deflate, 2=Heatshrink_11_4, 3=Heatshrink_12_4"
  },
  "slicer_metadata_compression": {
    "type": "number",
    "default": 0,
    "description": "Compression for slicer metadata: 0=None (default), 1=Deflate, 2=Heatshrink_11_4, 3=Heatshrink_12_4"
  },
  "gcode_compression": {
    "type": "number",
    "default": 0,
    "description": "Compression for G-code: 0=None (default), 1=Deflate, 2=Heatshrink_11_4, 3=Heatshrink_12_4"
  },
  "gcode_encoding": {
    "type": "number",
    "default": 0,
    "description": "Encoding for G-code: 0=None (default), 1=MeatPack, 2=MeatPackComments"
  },
  "metadata_encoding": {
    "type": "number",
    "default": 0,
    "description": "Encoding for metadata: 0=INI (default)"
  },
  "input_file": {
    "type": "string",
    "default": "",
    "description": "Input file path. If omitted or empty, bgcode reads from stdin."
  }
}
