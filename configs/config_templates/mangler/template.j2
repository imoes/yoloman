# ==============================================================================
# Mangler Ventrilo Client Configuration
# ==============================================================================
# This template configures a client for the Ventrilo 3.x voice chat protocol.
# It establishes connection parameters and authentication credentials.
#
# Schema Fields:
#   server_host_port (str): Hostname and port of the Ventrilo server (e.g. 'ventrilo.example.com:3784').
#   username (str): Username for authentication.
#   password (str): Password for the specified username.
# ==============================================================================

# [connection]
# Hostname and port of the Ventrilo 3.x server to connect to.
# Format: hostname:port
# Example: ventrilo.example.com:3784
server_host_port: {{ server_host_port | default('localhost:3784') }}

# [authentication]
# Username to use for authentication on the server.
# This user account must exist on the target Ventrilo server.
username: {{ username | default('user') }}

# [credentials]
# Password for the specified username.
# Leave empty to connect as a guest (if allowed by server config).
password: {{ password | default('') }}