#!/bin/sh
#
# netplug - policy agent for netplugd
#
# This script is managed by Ansible. Do not edit manually.
# It serves as the default handler script for netplugd, invoked when
# interface link state changes occur (plug/unplug/probe).
#
# Copyright 2003 Key Research, Inc.
# Licensed under GNU GPL v2.

# Path to standard utilities for the netplugd environment
# The netplugd daemon may not inherit a full PATH from the login shell.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# --- Arguments provided by netplugd ---
# $1: The interface name (e.g., eth0)
# $2: The action type (in, out, probe)
dev="$1"
action="$2"

# --- Configuration Defaults from Schema ---
# These variables are not used in the logic below but represent the
# global configuration context for netplugd. The actual script logic
# here is hardcoded to use standard tools (ifup/ifdown/ip).
# If you need to use `default_script` or `script_timeout`, you must
# invoke netplugd with the appropriate command-line flags or configure
# the daemon globally, as this specific policy script is a simple
# case-statement dispatcher.
#
# default_script: "{{ default_script | default('') }}"
# link_stable_delay: "{{ link_stable_delay | default(2) }}"
# script_timeout: "{{ script_timeout | default(30) }}"
# interfaces: "{{ interfaces | default([]) }}"

case "$action" in
in)
    # Action: Interface plugged in (link established)
    # Try to bring the interface up using the system's ifup command.
    if [ -x /sbin/ifup ]; then
        # Use exec to replace the shell process with ifup
        exec /sbin/ifup "$dev"
    else
        echo "Please teach me how to plug in an interface!" 1>&2
        exit 1
    fi
    ;;
out)
    # Action: Interface unplugged (link lost)
    # Try to bring the interface down using the system's ifdown command.
    if [ -x /sbin/ifdown ]; then
        # Note: Some systems may require flushing addresses (ip addr flush)
        # after ifdown, but this is often handled by ifdown itself or network managers.
        exec /sbin/ifdown "$dev"
    else
        echo "Please teach me how to unplug an interface!" 1>&2
        exit 1
    fi
    ;;
probe)
    # Action: Probe requested
    # Force the interface up to check link state or initialize it.
    exec ip link set "$dev" up >/dev/null 2>&1
    ;;
*)
    # Action: Unknown/Invalid
    echo "I have been called with a funny action of '${action}'!" 1>&2
    exit 1
    ;;
esac
