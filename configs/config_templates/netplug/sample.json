{
  "interfaces": [
    {
      "name": "eth0",
      "up_script": "/etc/netplug/scripts/ifup-eth0",
      "down_script": "/etc/netplug/scripts/ifdown-eth0"
    },
    {
      "name": "wlan0"
    }
  ],
  "default_script": "/etc/netplug/scripts/default-link-change.sh",
  "link_stable_delay": 3,
  "script_timeout": 20
}
