# ==============================================================================
# nextepc-pgw Configuration Template
# ==============================================================================
# This template generates the configuration file for the NextEPC Packet Gateway (PGW).
# It manages logging, FreeDiameter integration, GTP interfaces, UE address pools,
# and DNS resolvers.
# ==============================================================================

logger:
    # Path to the PGW log file.
    file: {{ pgw_log_file | default('/var/log/nextepc/pgw.log') }}
    # Trace flags for debugging specific subsystems.
    # 1 = enable trace, 0 = disable.
    trace: 
        app: 1
        diameter: 1
        gtpv2: 1
        gtp: 1

parameter:

pgw:
    # Path to the FreeDiameter configuration file for the PGW.
    freeDiameter: {{ pgw_freeDiameter_conf_path | default('/etc/nextepc/freeDiameter/pgw.conf') }}
    
    gtpc:
      # GTP-C (Control Plane) Interface Configuration
      addr:
        # IPv4 address for GTP-C interface.
        - {{ pgw_gtpc_addr_ipv4 | default('127.0.0.3') }}
        # IPv6 address for GTP-C interface.
        - {{ pgw_gtpc_addr_ipv6 | default('::1') }}
    
    gtpu:
      # GTP-U (User Plane) Interface Configuration
      - addr: {{ pgw_gtpu_addr_ipv4 | default('127.0.0.3') }}
      - addr: {{ pgw_gtpu_addr_ipv6 | default('::1') }}
    
    ue_pool:
      # UE (User Equipment) Address Pool Configuration
      # Defines the IP ranges assigned to mobile devices.
      - addr: {{ pgw_ue_pool_ipv4_cidr | default('45.45.0.1/16') }}
      - addr: {{ pgw_ue_pool_ipv6_cidr | default('cafe::1/64') }}
    
    dns:
      # DNS Resolvers for the PGW
      # List of DNS servers used for resolving external domain names.
      - {{ pgw_dns_primary_ipv4 | default('8.8.8.8') }}
      - {{ pgw_dns_secondary_ipv4 | default('8.8.4.4') }}
      - {{ pgw_dns_primary_ipv6 | default('2001:4860:4860::8888') }}
      - {{ pgw_dns_secondary_ipv6 | default('2001:4860:4860::8844') }}
