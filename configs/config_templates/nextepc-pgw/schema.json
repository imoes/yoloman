{
  "pgw_log_file": {
    "type": "string",
    "default": "/var/log/nextepc/pgw.log",
    "description": "Path to the PGW log file."
  },
  "pgw_freeDiameter_conf_path": {
    "type": "string",
    "default": "/etc/nextepc/freeDiameter/pgw.conf",
    "description": "Path to the FreeDiameter configuration file for PGW."
  },
  "pgw_gtpc_addr_ipv4": {
    "type": "string",
    "default": "127.0.0.3",
    "description": "IPv4 address for GTP-C interface."
  },
  "pgw_gtpc_addr_ipv6": {
    "type": "string",
    "default": "::1",
    "description": "IPv6 address for GTP-C interface."
  },
  "pgw_gtpu_addr_ipv4": {
    "type": "string",
    "default": "127.0.0.3",
    "description": "IPv4 address for GTP-U interface."
  },
  "pgw_gtpu_addr_ipv6": {
    "type": "string",
    "default": "::1",
    "description": "IPv6 address for GTP-U interface."
  },
  "pgw_ue_pool_ipv4_cidr": {
    "type": "string",
    "default": "45.45.0.1/16",
    "description": "IPv4 UE (User Equipment) address pool in CIDR notation."
  },
  "pgw_ue_pool_ipv6_cidr": {
    "type": "string",
    "default": "cafe::1/64",
    "description": "IPv6 UE (User Equipment) address pool in CIDR notation."
  },
  "pgw_dns_primary_ipv4": {
    "type": "string",
    "default": "8.8.8.8",
    "description": "Primary DNS server IPv4 address."
  },
  "pgw_dns_secondary_ipv4": {
    "type": "string",
    "default": "8.8.4.4",
    "description": "Secondary DNS server IPv4 address."
  },
  "pgw_dns_primary_ipv6": {
    "type": "string",
    "default": "2001:4860:4860::8888",
    "description": "Primary DNS server IPv6 address."
  },
  "pgw_dns_secondary_ipv6": {
    "type": "string",
    "default": "2001:4860:4860::8844",
    "description": "Secondary DNS server IPv6 address."
  }
}
