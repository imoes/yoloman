# Membernator CLI Configuration
# Executed by init script or wrapper. All settings are parameters for the membernator binary.

{% raw %}membernator \{% endraw %}
    {# Path to the CSV database containing membership records. #}
    --database {{ (database_path | default('/etc/membernator/members.csv')) | string }} \
    {# Column name in the CSV database for the member ID. #}
    --id_col {{ (id_col | default('ID')) | string }} \
    {# Column name in the CSV database for the member name. #}
    --name_col {{ (name_col | default('NAME')) | string }} \
    {# Delay in seconds between scans. #}
    --time {{ (scan_delay | default(2.5)) | string }} \
    {# Window width in pixels. Use 0 for fullscreen. #}
    --width {{ (width | default(800)) | string }} \
    {# Window height in pixels. Use 0 for fullscreen. #}
    --height {{ (height | default(480)) | string }} \
    {# Path to the logfile for scan results. #}
    --logfile {{ (logfile_path | default('/var/log/membernator/log.csv')) | string }}