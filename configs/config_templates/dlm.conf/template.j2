# DLM (Distributed Lock Manager) configuration file
# Controls kernel device-mapper lock manager behavior for cluster coordination.
# This template is self-documenting: every directive is preceded by its
# schema description and safe defaults are enforced via Jinja2 defaults().

[dlm]

# Enable verbose debugging output for internal DLM operations.
# Type: boolean
# Default: False
auto_debug={{ auto_debug | default(false) | lower }}

# Verbosity level for logging: 0 = silent, 1 = basic info, 2 = verbose, 3 = debug.
# Type: integer
# Default: 1
log_level={{ log_level | default(1) }}

# Directory where DLM lockspace state files are stored.
# Type: string
# Default: '/run/lock/dlm'
lockspace_dir={{ lockspace_dir | default('/run/lock/dlm') }}

# Maximum time in seconds to wait for a lock acquisition before considering it failed.
# Type: integer
# Default: 30
lock_timeout={{ lock_timeout | default(30) }}

# Whether to use netlink socket for kernel communication: 'yes', 'no', or 'auto' (recommended).
# Type: string
# Default: 'auto'
netlink_socket={{ netlink_socket | default('auto') }}

# Optional: list of additional lockspaces to manage.
# Defined by the 'lockspaces' schema field (list of dicts).
{% for ls in lockspaces | default([]) %}
[lockspace:{{ ls.name | default('unnamed') }}]

# Enable reclaim of abandoned locks in this lockspace.
# Type: boolean
# Default: True
reclaim_strict={{ ls.reclaim_strict | default(true) | lower }}

# Number of threads to use for this lockspace.
# Type: integer
# Default: 1
threads={{ ls.threads | default(1) }}
{% endfor %}