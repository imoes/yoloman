{
 "case_insensitive": true,
 "event_filter": [
  "created",
  "modified",
  "removed",
  "renamed"
 ],
 "exclude_patterns": [
  "\\.tmp$",
  ".*\\.git/.*"
 ],
 "extended_regex": true,
 "follow_links": false,
 "include_patterns": [],
 "latency": 1.0,
 "monitor": "inotify",
 "recursive": true,
 "utc_timestamp": true,
 "watch_paths": [
  "/etc/myapp/config",
  "/var/lib/myapp/data"
 ]
}
