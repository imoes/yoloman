{
  "latency": 1.0,
  "utc_timestamp": true,
  "event_filter": [
    "created",
    "modified",
    "removed",
    "renamed"
  ],
  "include_patterns": [],
  "exclude_patterns": [
    "\\.tmp$",
    ".*\\.git/.*"
  ],
  "case_insensitive": true,
  "extended_regex": true,
  "monitor": "inotify",
  "recursive": true,
  "follow_links": false,
  "watch_paths": [
    "/etc/myapp/config",
    "/var/lib/myapp/data"
  ]
}
