{# dares configuration file #}
[dares]

# CD/DVD image file or device path (required)
image = {{ image | default('') }}

# Directory where rescued files will be stored (required)
store_path = {{ store_path | default('') }}

{% if h2i_file | default('') | length > 0 %}
# Optional H2i file path for heavily damaged media (H2cdimage format)
h2i_file = {{ h2i_file | default('') }}
{% endif %}

# Store all found files without prompting user interaction
auto_accept = {{ auto_accept | default(false) | ternary('true', 'false') }}

# Use MIME types instead of file descriptions for identification
use_mime = {{ use_mime | default(false) | ternary('true', 'false') }}

# Path to the log file; defaults to 'dares.log'
log_file = {{ log_file | default('dares.log') }}