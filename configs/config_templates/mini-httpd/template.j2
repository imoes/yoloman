# ==============================================================================
# mini-httpd Service Configuration Template
# ==============================================================================
# This template generates the daemon options for the mini-httpd init script.
# It references the main configuration file path where all server directives
# (listen port, document root, logging, etc.) are defined.
# ==============================================================================

# Additional options passed to the Daemon.
# The -C flag specifies the path to the main mini-httpd configuration file.
# Default: /etc/mini-httpd.conf
DAEMON_OPTS="-C {{ config_file_path | default('/etc/mini-httpd.conf') }}"