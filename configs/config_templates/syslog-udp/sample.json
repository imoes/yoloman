{
  "udp_port": 514,
  "udp_address": "0.0.0.0",
  "tcp_enabled": false,
  "tcp_port": 514,
  "tcp_address": "0.0.0.0",
  "log_rules": [
    {
      "selector": "*.info",
      "action": "-/var/log/syslog"
    },
    {
      "selector": "authpriv.*",
      "action": "/var/log/auth.log"
    },
    {
      "selector": "mail.*",
      "action": "-/var/log/mail.log"
    },
    {
      "selector": "cron.*",
      "action": "/var/log/cron.log"
    },
    {
      "selector": "*.=error;*..=warn",
      "action": "/var/log/warnings.log"
    },
    {
      "selector": "local0.*",
      "action": "/var/log/local0.log"
    },
    {
      "selector": "*",
      "action": "/var/log/messages"
    }
  ]
}
