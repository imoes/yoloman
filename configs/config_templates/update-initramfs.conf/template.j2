# Enable or disable automatic update of initramfs on kernel package upgrades
# Valid values: yes, no
UPDATE=yes

# Enable or disable backup of existing initramfs before overwriting
# Valid values: yes, no
BACKUP=1

# Comma-separated list of initramfs generation hooks to enable (overrides defaults)
# Set to empty string to use default hooks only
#HOOKS=""

# List of modules to include in initramfs (in addition to auto-detected modules)
# Each module listed here will be forced into the initramfs
#MODULES=""

# Compression type for the initramfs (e.g., gzip, lzma, zstd, xz)
# If empty, the system default compression is used
COMPRESS=gzip

# Directory where initramfs files are stored
# Usually /boot
BOOTDIR=/boot

# Comma-separated list of architectures to generate initramfs for
# Set to empty string to build for current architecture only
#ARCH=""

# Enable verbose output (set to 1 for verbose, 0 for quiet)
#VERBOSE=0