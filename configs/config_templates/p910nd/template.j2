# Enable debug logging
DEBUG={{ debug }}

# Listen on the specified port (0 for auto-assign)
PORT={{ port }}

# Bind to this host (empty string binds to all interfaces)
HOST="{{ host }}"

# Printer device path (e.g., /dev/usb/lp0 or /dev/lp0)
PRINTER="{{ printer }}"

# Use bidirectional mode (true/false); enables status reporting back to client
BIDIR={{ bidir }}

# Set idle timeout in seconds (0 = no timeout)
IDLE_TIMEOUT={{ idle_timeout }}

# Timeout for printer initialization in seconds
INIT_TIMEOUT={{ init_timeout }}

# Enable keepalive on TCP sockets
KEEPALIVE={{ keepalive }}

# Maximum number of simultaneous connections
MAX_CONNECTIONS={{ max_connections }}

# Comma-separated list of allowed client IPs (empty = allow all)
{% if allowed_clients %}
ALLOW="{{ allowed_clients | join(',') }}"
{% else %}
ALLOW=""
{% endif %}

# Comma-separated list of denied client IPs
{% if denied_clients %}
DENY="{{ denied_clients | join(',') }}"
{% else %}
DENY=""
{% endif %}

# Optional: append extra command-line arguments
EXTRA_ARGS="{{ extra_args }}"
