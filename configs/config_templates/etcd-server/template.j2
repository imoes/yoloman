# =============================================================================
# etcd(1) daemon configuration
# =============================================================================
# This template configures the etcd member identity.
# See "/usr/share/doc/etcd-server/op-guide/configuration.md.gz" for full options.
#
# To override any option at runtime, use the environment block in the systemd unit
# (e.g. Environment="ETCD_NAME={{ etcd_name | default('default') }}").
# =============================================================================

# Name of this etcd member (maps to --name)
# Default: 'default'
etcd_name={{ etcd_name | default('default') }}