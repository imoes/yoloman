# =============================================================================
# QStat Configuration Template
# =============================================================================
# This file configures qstat (Quick Status) to query various game servers.
# Each 'gametype' block defines a protocol handler for a specific game or master
# server list. Fields like 'name', 'template var', and 'default port' are
# populated from Ansible variables defined in the role's defaults/main.yml.
#
# Reference: http://www.qstat.org
# =============================================================================

# -----------------------------------------------------------------------------
# Soldier of Fortune 2 (SOF2)
# -----------------------------------------------------------------------------
# gametype SOF2S: Defines the protocol for querying SOF2 game servers.
gametype SOF2S new extend Q3S
    # name: Human-readable name for this game type.
    name = Soldier of Fortune 2
    # default port: The UDP port SOF2 servers listen on for status queries.
    default port = {{ qstat_sof2s_port | default(20100) }}
    # template var: Internal variable name used by qstat for this game.
    template var = SOLDIEROFFORTUNE2
    # game rule: The rule key used to identify the game in status packets.
    game rule = gametype
end

# -----------------------------------------------------------------------------
# SOF2 Master Server
# -----------------------------------------------------------------------------
# gametype SOF2M: Defines the protocol for querying the SOF2 public master list.
gametype SOF2M new extend Q3M
    # name: Human-readable name for this master server type.
    name = SOF2 Master
    # default port: The UDP port the SOF2 Master server listens on.
    default port = {{ qstat_sof2m_port | default(20110) }}
    # template var: Internal variable name for this master server type.
    template var = SOF2MASTER
    # master protocol: The version of the master server protocol to use (2004 for SOF2 1.02).
    master protocol = 2004
    # master query: The query type sent to the master server (SOF2FULL).
    master query = SOF2FULL
    # master for gametype: The underlying game type this master serves (sof2s).
    master for gametype = sof2s
end

# -----------------------------------------------------------------------------
# SOF2 Master Server (Legacy 1.0)
# -----------------------------------------------------------------------------
# gametype SOF2M1.0: Legacy master server definition for SOF2 1.0.
gametype SOF2M1.0 new extend SOF2M
    # name: Human-readable name for this legacy master server type.
    name = SOF2 Master (1.0)
    # master protocol: The legacy protocol version (2002).
    master protocol = 2002
end

