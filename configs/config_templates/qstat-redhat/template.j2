# -----------------------------------------------------------------------------
# Medal of Honor: Allied Assault (Quake 3 Protocol)
# -----------------------------------------------------------------------------
# gametype MAQS: Defines the protocol for MOHAA using the Quake 3 status protocol.
# Note: The Q3 protocol response is limited compared to Gamespy.
gametype MAQS new extend Q3S
    # name: Human-readable name for this game type.
    name = Medal of Honor: Allied Assault (Q)
    # default port: The UDP port MOHAA (Q3) servers listen on.
    default port = {{ qstat_maqs_port | default(12300) }}
    # template var: Internal variable name for this game type.
    template var = MOHALLIEDASSAULT
    # game rule: The rule key used to identify the game in status packets.
    game rule = gametype
    # status packet: The raw packet bytes for the 'getinfo' query.
    status packet = \xff\xff\xff\xff\x02getinfo\n
    # status2 packet: The raw packet bytes for the 'getstatus' query.
    status2 packet = \xff\xff\xff\xff\x02getstatus\n
end

