# -----------------------------------------------------------------------------
# gametype Q3RALLYS: Defines the protocol for Q3 Rally game servers.
gametype Q3RALLYS new extend Q3S
    # name: Human-readable name for this game type.
    name = Q3 Rally
    # template var: Internal variable name for this game type.
    template var = Q3RALLY
    # game rule: The rule key used to identify the game in status packets.
    game rule = gamename
end

# gametype Q3RALLYM: Defines the protocol for the Q3 Rally public master list.
gametype Q3RALLYM new extend Q3M
    # name: Human-readable name for this master server type.
    name = Q3 Rally Master
    # template var: Internal variable name for this master server type.
    template var = Q3RALLYMASTER
    # default port: The UDP port the Q3 Rally Master server listens on.
    default port = {{ qstat_q3rallym_port | default(27950) }}
    # master packet: The raw packet bytes for the master query.
    master packet = \377\377\377\377getservers Q3Rally %s %s
    # master protocol: The version of the master server protocol to use.
    master protocol = 71
    # master query: The query type sent to the master server.
    master query = empty full
    # master for gametype: The underlying game type this master serves (Q3RALLYS).
    master for gametype = Q3RALLYS
end

