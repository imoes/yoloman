{
  "ldap": {
    "url": "ldaps://ldap.example.com:636",
    "bind_dn": "cn=ldap2dns,ou=Services,dc=example,dc=com",
    "bind_password": "s3cr3t",
    "base_dn": "ou=DNS,dc=example,dc=com",
    "zone_filter": "(objectClass=dnsZone)",
    "record_filter": "(objectClass=dnsRecord)"
  },
  "refresh": {
    "interval": 600
  },
  "backend": {
    "type": "powerdns",
    "powerdns": {
      "url": "http://localhost:8081/api/v1",
      "api_key": "pdns-api-key-abc123",
      "ttl": 3600
    }
  },
  "defaults": {
    "ttl": 7200,
    "soa": {
      "primary": "ns1.example.com",
      "email": "hostmaster.example.com",
      "refresh": 3600,
      "retry": 600,
      "expire": 604800,
      "minimum": 86400
    }
  },
  "zone_naming": {
    "format": "in-addr.arpa",
    "separator": ".",
    "reverse_zone_suffix": ".in-addr.arpa"
  },
  "log": {
    "level": "INFO",
    "file": "/var/log/ldap2dns/ldap2dns.log"
  },
  "dry_run": false
}
