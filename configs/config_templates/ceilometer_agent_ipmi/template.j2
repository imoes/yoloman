[DEFAULT]
# Logging configuration
log_dir = {{ logging.log_dir }}
log_file = {{ logging.log_file }}

# Debug mode
debug = {{ debug }}

# Verbose output
verbose = {{ verbose }}

[DEFAULT]
# Transport URL for sending notifications to the message bus
transport_url = {{ messaging.transport_url }}

[DEFAULT]
# Authentication for the messaging system
transport_url = {{ messaging.transport_url }}

[DEFAULT]
# Credential and endpoint configuration for connecting to the OpenStack services
os_password = {{ keystone_auth.password }}
os_username = {{ keystone_auth.username }}
os_project_name = {{ keystone_auth.project_name }}
os_user_domain_name = {{ keystone_auth.user_domain_name }}
os_project_domain_name = {{ keystone_auth.project_domain_name }}
os_auth_url = {{ keystone_auth.auth_url }}

[DEFAULT]
# IPMI-specific configuration
ipmi_driver = {{ ipmi.driver }}

[DEFAULT]
# IPMI polling interval in seconds
ipmi_polling_interval = {{ ipmi.polling_interval }}

[DEFAULT]
# Maximum number of IPMI BMCs to poll in parallel
ipmi_max_concurrent_polls = {{ ipmi.max_concurrent_polls }}

[DEFAULT]
# List of IPMI BMCs to poll
{% for bmc in ipmi.bmcs %}
# {{ bmc.name }}
bmc_address_{{ loop.index }} = {{ bmc.address }}
bmc_username_{{ loop.index }} = {{ bmc.username }}
bmc_password_{{ loop.index }} = {{ bmc.password }}
{% if bmc.interface %}
bmc_interface_{{ loop.index }} = {{ bmc.interface }}
{% endif %}
{% endfor %}

[DEFAULT]
# Metrics to collect from each BMC
{% for metric in ipmi.metrics %}
# Enable {{ metric.name }} metric
metric_{{ loop.index }} = {{ metric.name }}
{% if metric.interval is defined %}
metric_{{ loop.index }}_interval = {{ metric.interval }}
{% endif %}
{% endfor %}

[DEFAULT]
# Compute node hostname mapping (optional, for identification inceilometer)
{% for hostname in ipmi.hostnames %}
# Mapping for host {{ hostname.name }}
hostname_mapping_{{ loop.index }} = {{ hostname.ipmi_address }}:{{ hostname.compute_hostname }}
{% endfor %}

[DEFAULT]
# Notification routing and fanout settings
notification_driver = {{ notification.driver }}
{% for topic in notification.topics %}
notification_topics = {{ topic }}
{% endfor %}

[DEFAULT]
# Pipeline configuration (if used)
pipeline_cfg_file = {{ pipeline.config_file }}

[DEFAULT]
# Event notifications
event_definitions_file = {{ events.definitions_file }}

[DEFAULT]
# Source of metrics (e.g., 'ipmi', 'gnocchi')
metric_source = {{ metric_source }}

[DEFAULT]
# Retry configuration for IPMI polling
ipmi_retry_attempts = {{ ipmi.retry_attempts }}
ipmi_retry_delay = {{ ipmi.retry_delay }}

[DEFAULT]
# Timeout for IPMI commands (in seconds)
ipmi_timeout = {{ ipmi.timeout }}

[DEFAULT]
# SSL/TLS verification for keystone
os_cacert = {{ keystone_auth.cacert }}
os_insecure = {{ keystone_auth.insecure }}

[DEFAULT]
# Disable SSL hostname verification (for self-signed certs)
os_ssl_verify = {{ keystone_auth.ssl_verify }}

[DEFAULT]
# Logging format
log_format = {{ logging.format }}
