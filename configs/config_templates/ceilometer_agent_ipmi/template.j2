# Ceilometer IPMI Agent Configuration
# This file is managed by Ansible. Do not edit manually.

[DEFAULT]
# Directory where log files are stored.
log_dir = {{ (logging | default({})).log_dir | default('/var/log/ceilometer') }}

# Name of the main log file.
log_file = {{ (logging | default({})).log_file | default('ceilometer-agent-ipmi.log') }}

# Enable debug-level logging for verbose troubleshooting.
debug = {{ debug | default(false) | lower }}

# Enable verbose logging (more detailed than INFO).
verbose = {{ verbose | default(true) | lower }}

# RabbitMQ or other message bus transport URL for event/metric transport.
transport_url = {{ (messaging | default({})).transport_url | default('rabbit://openstack:openstack@controller:5672/') }}

# Notification driver: 'message' (default), 'log', or 'noop'.
notification_driver = {{ (notification | default({})).driver | default('message') }}

# Path to the event definitions file for Ceilometer events.
event_definitions_file = {{ (events | default({})).definitions_file | default('/etc/ceilometer/event_definitions.yaml') }}

# Notification topics to publish Ceilometer messages to.
notification_topics = {{ (notification | default({})).topics | default(['ceilometer', 'notifications']) | join(',') }}

# Keystone user password for authentication to OpenStack services.
[keystone_authtoken]
password = {{ (keystone_auth | default({})).password | default('') }}

# Keystone username used by the Ceilometer IPMI agent.
username = {{ (keystone_auth | default({})).username | default('ceilometer') }}

# Keystone project (tenant) name for the Ceilometer service account.
project_name = {{ (keystone_auth | default({})).project_name | default('service') }}

# Keystone domain name for the user.
user_domain_name = {{ (keystone_auth | default({})).user_domain_name | default('Default') }}

# Keystone domain name for the project.
project_domain_name = {{ (keystone_auth | default({})).project_domain_name | default('Default') }}

# Keystone identity service endpoint URL.
auth_url = {{ (keystone_auth | default({})).auth_url | default('http://controller:5000/v3') }}

# Path to CA certificate bundle for SSL verification (optional).
cacert = {{ (keystone_auth | default({})).cacert | default('') }}

# Disable SSL certificate verification (not recommended in production).
insecure = {{ (keystone_auth | default({})).insecure | default(false) | lower }}

# Enable SSL/TLS verification for Keystone connections.
ssl_verify = {{ (keystone_auth | default({})).ssl_verify | default(true) | lower }}

# IPMI driver library to use (e.g., pyghmi.ipmi, freeipmi).
[ipmi]
driver = {{ (ipmi | default({})).driver | default('pyghmi.ipmi') }}

# Interval (in seconds) between IPMI polling cycles.
polling_interval = {{ (ipmi | default({})).polling_interval | default(600) }}

# Maximum number of BMCs that can be polled simultaneously.
max_concurrent_polls = {{ (ipmi | default({})).max_concurrent_polls | default(10) }}

# Number of retry attempts for failed IPMI commands.
retry_attempts = {{ (ipmi | default({})).retry_attempts | default(3) }}

# Delay (in seconds) between IPMI retry attempts.
retry_delay = {{ (ipmi | default({})).retry_delay | default(5) }}

# Timeout (in seconds) for each IPMI command.
timeout = {{ (ipmi | default({})).timeout | default(10) }}

# List of IPMI Baseboard Management Controllers (BMCs) to monitor.
{#
  Generates INI key-value pairs for each BMC:
  bmcs.<index>.ip = <ip>
  bmcs.<index>.username = <username>
  bmcs.<index>.password = <password>
  bmcs.<index>.privilege = <privilege>
#}
{% for bmc in (ipmi | default({})).bmcs | default([]) | list %}
bmcs.{{ loop.index0 }}.ip = {{ bmc.ip | default('') }}
bmcs.{{ loop.index0 }}.username = {{ bmc.username | default('') }}
bmcs.{{ loop.index0 }}.password = {{ bmc.password | default('') }}
bmcs.{{ loop.index0 }}.privilege = {{ bmc.privilege | default('operator') }}
{% endfor %}

# List of IPMI metrics to collect (e.g., power, temperature, fan, voltage).
# Format: name1,name2,...
metrics = {{ (ipmi | default({})).metrics | default([{'name': 'power'}, {'name': 'temperature'}, {'name': 'fan'}]) | map(attribute='name') | join(',') }}

# Optional mapping between BMC IP addresses and OpenStack compute node hostnames.
{#
  Generates INI key-value pairs for hostname mapping:
  hostnames.<ip> = <hostname>
#}
{% for entry in (ipmi | default({})).hostnames | default([]) | list %}
hostnames.{{ entry.ip | default('') }} = {{ entry.hostname | default('') }}
{% endfor %}

# Source of metric data. For this agent, must be 'ipmi'.
metric_source = {{ metric_source | default('ipmi') }}