# flatlatex configuration for command-line invocation
# This file documents the default behavior of flatlatex(1) via CLI arguments

# Enable combining characters processing.
# If false, disallows combining characters (equivalent to -C)
# Default: true
{% if allow_combining | default(true) %}
{% else %}-C
{% endif %}

# Enable zero-width characters processing.
# If false, disallows zero-width characters (equivalent to -Z)
# Default: true
{% if allow_zero_width | default(true) %}
{% else %}-Z
{% endif %}

# Path to the input file containing LaTeX strings; if omitted or set to 'stdin', reads from standard input
# Default: stdin
{{ input_file | default('stdin') }}