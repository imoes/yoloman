{
  "ovn_nb_connection": "tcp:192.168.1.10:6641",
  "ovn_sb_connection": "tcp:192.168.1.10:6642",
  "ovn_timeout": 120,
  "enable_l3": true,
  "enable_qos": true,
  "enable_metadata": true,
  "metadata_network": "b5d4a8e3-9f2c-4d7a-8e1f-3a2b1c0d9e8f",
  "metadata_proxy_user_namespace": "neutron",
  "chassis_type": "geneve",
  "l3_scheduler_workers": 2,
  "metadata_workers": 3,
  "l3_ha": true,
  "max_l3_ha_router_versions": 5,
  "enable_ipv6": true,
  "enable_multicast": true,
  "enable_qos_burst": true,
  "enable_ovn_monitor": true,
  "ovn_connection_inactivity_probe": 90,
  "ovn_nb_ssl_key": "",
  "ovn_nb_ssl_cert": "",
  "ovn_nb_ssl_cacert": "",
  "ovn_sb_ssl_key": "",
  "ovn_sb_ssl_cert": "",
  "ovn_sb_ssl_cacert": "",
  "bridge_mappings": [
    {
      "physical_network": "physnet1",
      "bridge": "br-ex"
    },
    {
      "physical_network": "physnet2",
      "bridge": "br-vlan"
    }
  ],
  "vni_ranges": [
    "1000:2000",
    "3000:4000"
  ],
  "ovn_dns_servers": [
    "8.8.8.8",
    "1.1.1.1"
  ],
  "gateway_chassis": [
    {
      "name": "compute-1",
      "priority": 100
    },
    {
      "name": "compute-2",
      "priority": 90
    }
  ],
  "enable_chassis_as_gw": true,
  "interconn_host": "ovn-remote.example.com",
  "interconn_nb_port": 6641,
  "interconn_sb_port": 6642,
  "nat_external_ip_pool": "203.0.113.0/24",
  "log_file": "/var/log/neutron/ovn-agent.log",
  "log_level": "INFO"
}
