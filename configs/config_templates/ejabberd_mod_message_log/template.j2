# Enable ejabberd_mod_message_log module
{{ '# ' if not enabled else '' }}modules:
{{ '# ' if not enabled else '' }}  ejabberd_mod_message_log: {{ 'mod_message_log' | to_json }}

# Path to the message log file
{{ '# ' if not enabled else '' }}logpath: {{ logpath | to_json }}

# Maximum number of days to keep log entries (0 = keep forever)
{{ '# ' if not enabled else '' }}max_days: {{ max_days }}

# Log format: 'text' or 'json'
{{ '# ' if not enabled else '' }}format: {{ format | to_json }}

# List of domains to log messages for (empty list = all domains)
{{ '# ' if not enabled else '' }}domains:
{% for domain in domains %}  - {{ domain | to_json }}
{% endfor %}