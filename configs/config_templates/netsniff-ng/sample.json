{
  "input_dev": "eth0",
  "output_dest": "/var/log/netsniff/capture.pcap",
  "bpf_filter": "tcp port 80",
  "silent": true,
  "bind_cpu": 0,
  "rotation_interval": "100MiB",
  "file_prefix": "eth0-",
  "pcap_type": "0xa1b2c3d4",
  "no_promisc": false,
  "use_sg": true,
  "use_mmap": false,
  "fanout_group": 0,
  "fanout_type": "",
  "fanout_opts": "",
  "kernel_pull": 10,
  "drop_user": "nsm",
  "drop_group": "nsm",
  "max_packets": 0,
  "jumbo_support": false,
  "rfraw": false,
  "geoip_update": false,
  "cooked": false,
  "verbose": false,
  "hex_dump": false,
  "ascii_dump": false,
  "randomize_order": false,
  "notouch_irq": true,
  "prio_high": false,
  "no_hwtimestamp": false,
  "no_sock_mem": false
}
