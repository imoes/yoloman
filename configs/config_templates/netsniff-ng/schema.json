{
  "input_dev": {
    "type": "string",
    "default": "eth0",
    "description": "Input network device, pcap file, or stdin (-)."
  },
  "output_dest": {
    "type": "string",
    "default": "capture.pcap",
    "description": "Output network device, pcap file, or directory for rotation."
  },
  "bpf_filter": {
    "type": "string",
    "default": "",
    "description": "BPF filter expression (tcpdump syntax) or path to compiled filter."
  },
  "silent": {
    "type": "bool",
    "default": true,
    "description": "Suppress packet dissector output to terminal."
  },
  "bind_cpu": {
    "type": "number",
    "default": 0,
    "description": "CPU core ID to pin the process and NIC IRQ to."
  },
  "rotation_interval": {
    "type": "string",
    "default": "",
    "description": "Rotation interval for pcap files (e.g., 100MiB, 120sec)."
  },
  "file_prefix": {
    "type": "string",
    "default": "dump-",
    "description": "Prefix for rotated pcap filenames."
  },
  "pcap_type": {
    "type": "string",
    "default": "",
    "description": "PCAP magic number/type (e.g., 0xa1b2c3d4)."
  },
  "no_promisc": {
    "type": "bool",
    "default": false,
    "description": "Disable promiscuous mode on input interface."
  },
  "use_sg": {
    "type": "bool",
    "default": true,
    "description": "Use scatter-gather I/O for pcap writing."
  },
  "use_mmap": {
    "type": "bool",
    "default": false,
    "description": "Use mmap I/O for pcap writing."
  },
  "fanout_group": {
    "type": "number",
    "default": 0,
    "description": "Fanout group ID for load balancing."
  },
  "fanout_type": {
    "type": "string",
    "default": "lb",
    "description": "Fanout type: hash, lb, cpu, rnd, roll, qm.",
    "enum": [
      "hash",
      "lb",
      "cpu",
      "rnd",
      "roll",
      "qm"
    ]
  },
  "fanout_opts": {
    "type": "string",
    "default": "",
    "description": "Fanout options: defrag, roll.",
    "enum": [
      "defrag",
      "roll"
    ]
  },
  "kernel_pull": {
    "type": "number",
    "default": 10,
    "description": "Kernel pull interval in microseconds."
  },
  "drop_user": {
    "type": "string",
    "default": "",
    "description": "User to drop privileges to after ring setup."
  },
  "drop_group": {
    "type": "string",
    "default": "",
    "description": "Group to drop privileges to after ring setup."
  },
  "max_packets": {
    "type": "number",
    "default": 0,
    "description": "Max packets to process before exit (0 for infinite)."
  },
  "jumbo_support": {
    "type": "bool",
    "default": false,
    "description": "Enable jumbo frame support."
  },
  "rfraw": {
    "type": "bool",
    "default": false,
    "description": "Enable RFRAW mode for wireless monitor capture."
  },
  "geoip_update": {
    "type": "bool",
    "default": false,
    "description": "Enable GeoIP database updates."
  },
  "cooked": {
    "type": "bool",
    "default": false,
    "description": "Use cooked header for packets."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Verbose startup output."
  },
  "hex_dump": {
    "type": "bool",
    "default": false,
    "description": "Hex dump output."
  },
  "ascii_dump": {
    "type": "bool",
    "default": false,
    "description": "ASCII only dump."
  },
  "randomize_order": {
    "type": "bool",
    "default": false,
    "description": "Randomize packet order in output."
  },
  "notouch_irq": {
    "type": "bool",
    "default": false,
    "description": "Do not touch IRQ CPU affinity."
  },
  "prio_high": {
    "type": "bool",
    "default": false,
    "description": "Set high priority process."
  },
  "no_hwtimestamp": {
    "type": "bool",
    "default": false,
    "description": "Disable hardware timestamps."
  },
  "no_sock_mem": {
    "type": "bool",
    "default": false,
    "description": "Do not modify socket buffer sizes."
  }
}
