{
  "name": {
    "type": "string",
    "default": "irc.example.net",
    "description": "The DNS name of your IRC server."
  },
  "description": {
    "type": "string",
    "default": "My Local IRC Server",
    "description": "A human-readable description of the server."
  },
  "server": {
    "type": "object",
    "default": {
      "name": "irc.example.net",
      "description": "My Local IRC Server",
      "id": "00A"
    },
    "fields": {
      "name": {
        "type": "string",
        "default": "irc.example.net",
        "description": "Server's fully qualified domain name (must be unique in network)."
      },
      "description": {
        "type": "string",
        "default": "My Local IRC Server",
        "description": "Short human-readable description."
      },
      "id": {
        "type": "string",
        "default": "00A",
        "description": "Unique 3-character numeric/hex server ID (e.g., 001, 00A)."
      }
    }
  },
  "opers": {
    "type": "list",
    "default": [
      {
        "name": "admin",
        "password": "*",
        "mask": "admin@*",
        "flags": [
          "O",
          "C",
          "k",
          "K",
          "z",
          "Z",
          "c",
          "q",
          "Q",
          "r",
          "R",
          "s",
          "S",
          "w",
          "W",
          "x",
          "X",
          "d",
          "D",
          "n",
          "N",
          "l",
          "L",
          "p",
          "P",
          "h",
          "H",
          "o",
          "O",
          "b",
          "B",
          "v",
          "V",
          "j",
          "J",
          "e",
          "E",
          "a",
          "A",
          "g",
          "G",
          "f",
          "F"
        ]
      }
    ],
    "items": {
      "name": {
        "type": "string",
        "default": "admin",
        "description": "Oper name (e.g., admin)."
      },
      "password": {
        "type": "string",
        "default": "*",
        "description": "Password hash (use * to require encrypted pass via TLS or SASL; otherwise set hash like $6$...)."
      },
      "mask": {
        "type": "string",
        "default": "admin@*",
        "description": "IP/host mask for allowed oper logins."
      },
      "flags": {
        "type": "list",
        "default": [
          "O",
          "C",
          "k",
          "K",
          "z",
          "Z",
          "c",
          "q",
          "Q",
          "r",
          "R",
          "s",
          "S",
          "w",
          "W",
          "x",
          "X",
          "d",
          "D",
          "n",
          "N",
          "l",
          "L",
          "p",
          "P",
          "h",
          "H",
          "o",
          "O",
          "b",
          "B",
          "v",
          "V",
          "j",
          "J",
          "e",
          "E",
          "a",
          "A",
          "g",
          "G",
          "f",
          "F"
        ],
        "description": "List of oper privileges (letters: O=global op, C=create channels, etc.)"
      }
    }
  },
  "tls": {
    "type": "object",
    "default": {
      "bind": {
        "address": "0.0.0.0",
        "port": 6697,
        "type": "clients",
        "ssl": true
      }
    },
    "fields": {
      "bind": {
        "type": "object",
        "default": {
          "address": "0.0.0.0",
          "port": 6697,
          "type": "clients",
          "ssl": true
        },
        "fields": {
          "address": {
            "type": "string",
            "default": "0.0.0.0",
            "description": "IP address to bind (0.0.0.0 = all)."
          },
          "port": {
            "type": "number",
            "default": 6697,
            "description": "Port for TLS client connections (typically 6697)."
          },
          "type": {
            "type": "string",
            "default": "clients",
            "description": "Type of connection ('clients', 'servers')."
          },
          "ssl": {
            "type": "bool",
            "default": true,
            "description": "Enable TLS encryption for this bind."
          }
        }
      },
      "cert": {
        "type": "string",
        "default": "/etc/inspircd/ssl/server.crt",
        "description": "Path to server SSL certificate (PEM format)."
      },
      "key": {
        "type": "string",
        "default": "/etc/inspircd/ssl/server.key",
        "description": "Path to server SSL private key (PEM format)."
      }
    }
  },
  "modules": {
    "type": "list",
    "default": [
      "m_ircv3_cap.pl",
      "m_ircv3_nick.servmsg.pl",
      "m_ssl_gnutls.so"
    ],
    "description": "List of InspIRCd modules to load (include both core and optional modules)."
  },
  "options": {
    "type": "object",
    "default": {
      "serverstring": "InspIRCd-3",
      "clientstring": "InspIRCd-3",
      "maxclients": 512
    },
    "fields": {
      "serverstring": {
        "type": "string",
        "default": "InspIRCd-3",
        "description": "Server string sent to clients (e.g., version)."
      },
      "clientstring": {
        "type": "string",
        "default": "InspIRCd-3",
        "description": "Client string sent to servers in link handshake."
      },
      "maxclients": {
        "type": "number",
        "default": 512,
        "description": "Maximum number of client connections allowed (including servers)."
      },
      "vhost": {
        "type": "string",
        "default": "127.0.0.1",
        "description": "Default virtual host for users if none assigned via vhost modules."
      }
    }
  },
  "connect": {
    "type": "object",
    "default": {
      "allow": "*",
      "mask": "*",
      "class": "default"
    },
    "fields": {
      "allow": {
        "type": "string",
        "default": "*",
        "description": "Connection rule type: 'allow' or 'deny'."
      },
      "mask": {
        "type": "string",
        "default": "*",
        "description": "IP/hostmask to apply rule to (supports wildcards)."
      },
      "reserved": {
        "type": "string",
        "default": "0",
        "description": "Number of reserved slots (for opers/servers) per IP; 0 disables reservation."
      },
      "class": {
        "type": "string",
        "default": "default",
        "description": "Name of <class> to apply to matching connections."
      }
    }
  },
  "classes": {
    "type": "list",
    "default": [
      {
        "name": "default",
        "pingtime": "120",
        "sendq": "200000",
        "recvq": "30000",
        "maxperip": "10",
        "burst": "5"
      }
    ],
    "items": {
      "name": {
        "type": "string",
        "default": "default",
        "description": "Class name (referenced in <connect>)."
      },
      "pingtime": {
        "type": "string",
        "default": "120",
        "description": "Timeout (seconds) before ping is sent to client."
      },
      "sendq": {
        "type": "string",
        "default": "200000",
        "description": "Maximum output buffer size (bytes) per client."
      },
      "recvq": {
        "type": "string",
        "default": "30000",
        "description": "Maximum input buffer size (bytes) per client."
      },
      "maxperip": {
        "type": "string",
        "default": "10",
        "description": "Max concurrent client connections per IP."
      },
      "burst": {
        "type": "string",
        "default": "5",
        "description": "Max burst size (messages/sec) allowed before throttling."
      }
    }
  },
  "listens": {
    "type": "list",
    "default": [
      {
        "address": "0.0.0.0",
        "port": 6667,
        "type": "clients",
        "ssl": false
      }
    ],
    "items": {
      "address": {
        "type": "string",
        "default": "0.0.0.0",
        "description": "IP address to bind (0.0.0.0 = all)."
      },
      "port": {
        "type": "number",
        "default": 6667,
        "description": "Port for client connections (non-TLS typically 6667)."
      },
      "type": {
        "type": "string",
        "default": "clients",
        "description": "Type of connection ('clients', 'servers')."
      },
      "ssl": {
        "type": "bool",
        "default": false,
        "description": "Enable TLS for this port."
      },
      "options": {
        "type": "list",
        "default": [],
        "description": "Additional options like 'sslonly', 'noportcheck', etc."
      }
    }
  },
  "channelmodes": {
    "type": "list",
    "default": [
      "+nt",
      "+m",
      "+i",
      "+k",
      "+l",
      "+o",
      "+v",
      "+b",
      "+e",
      "+I"
    ],
    "description": "List of default channel mode letters (in order of priority)."
  },
  "usermodes": {
    "type": "list",
    "default": [
      "+i",
      "+w",
      "+s",
      "+o",
      "+O",
      "+r",
      "+x",
      "+a"
    ],
    "description": "List of default user mode letters."
  },
  "log": {
    "type": "object",
    "default": {
      "type": "all",
      "filename": "/var/log/inspircd/inspircd.log",
      "level": "debug",
      "maxsize": "10M"
    },
    "fields": {
      "type": {
        "type": "string",
        "default": "all",
        "description": "Log type filter: 'all', 'errors', 'warnings', 'info', 'debug', etc."
      },
      "filename": {
        "type": "string",
        "default": "/var/log/inspircd/inspircd.log",
        "description": "Path to log file."
      },
      "level": {
        "type": "string",
        "default": "debug",
        "description": "Minimum log level to capture."
      },
      "maxsize": {
        "type": "string",
        "default": "10M",
        "description": "Maximum log file size before rotation (e.g., 10M, 100K)."
      }
    }
  }
}
