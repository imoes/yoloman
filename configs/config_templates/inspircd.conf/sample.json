{
  "name": "irc.example.net",
  "description": "Example IRC Server",
  "server": {
    "name": "irc.example.net",
    "description": "Example IRC Server",
    "id": "001"
  },
  "opers": [
    {
      "name": "admin",
      "password": "$6$rounds=65536$example$QmZ3sKf...",
      "mask": "admin@example.com",
      "flags": [
        "O",
        "C",
        "k",
        "K",
        "z",
        "Z"
      ]
    }
  ],
  "tls": {
    "bind": {
      "address": "0.0.0.0",
      "port": 6697,
      "type": "clients",
      "ssl": true
    },
    "cert": "/etc/inspircd/ssl/server.crt",
    "key": "/etc/inspircd/ssl/server.key"
  },
  "modules": [
    "m_ircv3_cap.pl",
    "m_ircv3_nick.servmsg.pl",
    "m_ssl_gnutls.so",
    "m_crypt.so",
    "m_webirc.so"
  ],
  "options": {
    "serverstring": "InspIRCd-3",
    "clientstring": "InspIRCd-3",
    "maxclients": 256,
    "vhost": "192.168.1.1"
  },
  "connect": {
    "allow": "*",
    "mask": "*",
    "reserved": "5",
    "class": "default"
  },
  "classes": [
    {
      "name": "default",
      "pingtime": "120",
      "sendq": "200000",
      "recvq": "30000",
      "maxperip": "5",
      "burst": "3"
    }
  ],
  "listens": [
    {
      "address": "0.0.0.0",
      "port": 6667,
      "type": "clients",
      "ssl": false
    },
    {
      "address": "0.0.0.0",
      "port": 6697,
      "type": "clients",
      "ssl": true,
      "options": [
        "sslonly"
      ]
    }
  ],
  "channelmodes": [
    "+nt",
    "+m",
    "+i",
    "+k",
    "+l",
    "+o",
    "+v",
    "+b",
    "+e",
    "+I"
  ],
  "usermodes": [
    "+i",
    "+w",
    "+s",
    "+o",
    "+O",
    "+r",
    "+x",
    "+a"
  ],
  "log": {
    "type": "all",
    "filename": "/var/log/inspircd/inspircd.log",
    "level": "info",
    "maxsize": "5M"
  }
}
