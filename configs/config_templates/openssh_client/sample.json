{
  "strict_host_key_checking": "ask",
  "log_level": "INFO",
  "default_port": 22,
  "connect_timeout": 10,
  "password_authentication": "no",
  "forward_agent": true,
  "forward_x11": false,
  "tcp_keep_alive": true,
  "identity_files": [
    "~/.ssh/id_ed25519"
  ],
  "preferred_authentications": "publickey",
  "gssapi_authentication": false,
  "compression": true,
  "control_master": "auto",
  "control_path": "~/.ssh/sockets/%r@%h-%p",
  "control_persist": 600,
  "exit_on_forward_failure": true,
  "address_family": "any",
  "request_tty": "auto",
  "pubkey_authentication": true,
  "server_alive_interval": 30,
  "server_alive_count_max": 3,
  "extra_hosts": [
    {
      "name": "bastion",
      "hostname": "bastion.example.com",
      "user": "admin",
      "port": 2222,
      "forward_agent": true
    },
    {
      "name": "dev-*",
      "hostname": "dev.%h.internal",
      "user": "devuser",
      "forward_x11": true
    }
  ]
}
