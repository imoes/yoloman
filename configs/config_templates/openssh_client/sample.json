{
 "address_family": "any",
 "compression": true,
 "connect_timeout": 10,
 "control_master": "auto",
 "control_path": "~/.ssh/sockets/%r@%h-%p",
 "control_persist": 600,
 "default_port": 22,
 "exit_on_forward_failure": true,
 "extra_hosts": [
  {
   "forward_agent": true,
   "hostname": "bastion.example.com",
   "name": "bastion",
   "port": 2222,
   "user": "admin"
  },
  {
   "forward_x11": true,
   "hostname": "dev.%h.internal",
   "name": "dev-*",
   "user": "devuser"
  }
 ],
 "forward_agent": true,
 "forward_x11": false,
 "gssapi_authentication": false,
 "identity_files": [
  "~/.ssh/id_ed25519"
 ],
 "log_level": "INFO",
 "password_authentication": "no",
 "preferred_authentications": "publickey",
 "pubkey_authentication": true,
 "request_tty": "auto",
 "server_alive_count_max": 3,
 "server_alive_interval": 30,
 "strict_host_key_checking": "ask",
 "tcp_keep_alive": true
}
