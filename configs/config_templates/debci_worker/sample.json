{
  "api_base_url": "https://debci.debian.net",
  "worker_name": "debci-worker-amd64-01",
  "jobs": 3,
  "work_dir": "/var/lib/debci",
  "min_free_space": 10240,
  "cpu_mask": "0x7",
  "cross_build": true,
  "supported_architectures": [
    "amd64",
    "i386",
    "arm64"
  ],
  "extra_repos": [
    {
      "description": "Debian unstable (for testing latest packages)",
      "uri": "http://deb.debian.org/debian",
      "suite": "unstable",
      "components": "main contrib non-free",
      "architectures": []
    },
    {
      "description": "Debian backports (amd64 only)",
      "uri": "http://deb.debian.org/debian",
      "suite": "bullseye-backports",
      "components": "main",
      "architectures": [
        "amd64"
      ]
    }
  ],
  "api_ca_cert": "/etc/ssl/certs/ca-certificates.crt",
  "setup_timeout": 2400,
  "build_timeout": 10800,
  "debug": false
}
