# ============================================================================
# fwbuilder Configuration
# ============================================================================
# This template generates the command-line options passed to the fwbuilder
# application. fwbuilder is a firewall builder tool used to configure
# firewalls (iptables, ipfw, etc.) via a GUI or CLI.
#
# The 'options' list contains individual command-line flags or arguments.
# Each item in the list will be rendered on its own line.
# ============================================================================

{% if options | default([]) | length > 0 %}
# --- fwbuilder command-line options ---
{% for opt in options %}
{{ opt }}
{% endfor %}
{% else %}
# No command-line options specified.
{% endif %}