# brltty-x11 configuration template
# This package represents the X11 configuration component for BRLTTY (Braille display driver for Linux).
# BRLTTY provides screen reader access to the Linux console and X11 environments.
# The x11 component specifically handles configuration for X11-based access.
#
# Note: brltty-x11 typically does not have a separate configuration file in modern distributions.
# Configuration is often handled via the main brltty.conf or udev rules.
# This template provides a skeleton for any potential future configuration needs
# or for environments where explicit X11-specific settings are required.

# Main configuration file for brltty x11 component
# If no specific x11 config file is needed, this can remain as a placeholder
# or be used for global brltty settings that affect x11 interaction.

[global]
# Enable or disable brltty service globally
# Default: false
enabled = {{ brltty_enabled | default(false) | lower }}

# Log level for brltty
# Options: debug, info, warn, error
# Default: warn
log_level = {{ brltty_log_level | default("warn") }}

# X11 specific settings
# If brltty-x11 has specific configuration requirements, they can be added here.
# Currently, brltty relies on standard X11 accessibility protocols.

[brltty]
# Path to the brltty binary
# Default: /usr/bin/brltty
binary_path = {{ brltty_binary_path | default("/usr/bin/brltty") }}

# Configuration directory for brltty
# Default: /etc/brltty
config_dir = {{ brltty_config_dir | default("/etc/brltty") }}

# Braille device type to use
# If not specified, brltty will auto-detect
# Default: empty (auto-detect)
device_type = {{ brltty_device_type | default("") }}

# Braille display port
# Default: empty (auto-detect)
device_port = {{ brltty_device_port | default("") }}

# Braille baud rate
# Default: 0 (auto-detect)
device_baud = {{ brltty_device_baud | default(0) }}

# Use D-Bus for brltty communication
# Default: true
use_dbus = {{ brltty_use_dbus | default(true) | lower }}

# D-Bus service name for brltty
# Default: org.brltty.service
dbus_service = {{ brltty_dbus_service | default("org.brltty.service") }}

# X11 display server
# The X11 display to connect to (e.g., :0, :1)
# Default: :0
x_display = {{ brltty_x_display | default(":0") }}

# Enable X11 braille support
# Default: true
x11_enabled = {{ brltty_x11_enabled | default(true) | lower }}

# Braille table to use for X11
# Default: en-gui-brail.ctb
braille_table = {{ brltty_braille_table | default("en-gui-brail.ctb") }}

# Allow brltty to run as a different user
# Default: empty (run as current user)
run_as_user = {{ brltty_run_as_user | default("") }}

# Allow brltty to run as a different group
# Default: empty (run as current group)
run_as_group = {{ brltty_run_as_group | default("") }}

# Socket path for brltty daemon
# Default: empty (use system default)
socket_path = {{ brltty_socket_path | default("") }}

# PID file location
# Default: /run/brltty/brltty.pid
pid_file = {{ brltty_pid_file | default("/run/brltty/brltty.pid") }}

# Log file location
# Default: /var/log/brltty/brltty.log
log_file = {{ brltty_log_file | default("/var/log/brltty/brltty.log") }}

# Enable verbose logging
# Default: false
verbose = {{ brltty_verbose | default(false) | lower }}

# Timeout for device detection in seconds
# Default: 10
device_timeout = {{ brltty_device_timeout | default(10) }}

# Retry count for device connections
# Default: 3
device_retries = {{ brltty_device_retries | default(3) }}

# Delay between retry attempts in seconds
# Default: 2
retry_delay = {{ brltty_retry_delay | default(2) }}

# Maximum number of simultaneous braille devices
# Default: 1
max_devices = {{ brltty_max_devices | default(1) }}

# Enable keyboard shortcuts for brltty
# Default: true
enable_shortcuts = {{ brltty_enable_shortcuts | default(true) | lower }}

# Keyboard shortcut prefix key
# Default: Super
shortcut_prefix = {{ brltty_shortcut_prefix | default("Super") }}

