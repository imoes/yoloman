[# iocost.conf — udev rule to configure I/O cost (blkcg) weights per device]
[# This file is parsed by systemd-udev during boot to set per-device I/O cost model parameters]
[# It is NOT a runtime-tunable config; changes require re-running udevadm control --reload-rules]

[io_cost]
# Enable or disable the I/O cost model globally (default: 1 = enabled)
{% if io_cost_enabled is defined %}enabled = {{ io_cost_enabled | bool | lower }}{% else %}enabled = 1{% endif %}

# Base weight for I/O cost model (default: 1000)
{% if io_cost_weight is defined %}weight = {{ io_cost_weight }}{% else %}weight = 1000{% endif %}

# List of per-device overrides (each item: device path + optional weight)
{% for device in io_cost_devices %}# Device: {{ device.device_path }}
{% if device.weight is defined %}device_weight.{{ loop.index }} = {{ device.device_path }} {{ device.weight }}
{% else %}device_weight.{{ loop.index }} = {{ device.device_path }}
{% endif %}{% endfor %}

# Optional: I/O cost algorithm (currently only 'linear' is supported)
{% if io_cost_algorithm is defined %}algorithm = {{ io_cost_algorithm }}{% else %}algorithm = linear{% endif %}
