{
  "base_dir": "/home/user/.cryfs/encrypted",
  "mount_point": "/home/user/mount/decrypted",
  "foreground": true,
  "no_update_check": true,
  "config_file": "/etc/cryfs/myvault.config",
  "allow_filesystem_upgrade": false,
  "allow_integrity_violations": false,
  "allow_replaced_filesystem": false,
  "missing_block_is_integrity_violation": false,
  "unmount_idle": 30,
  "blocksize": 65536,
  "cipher": "chacha20-poly1305",
  "fuse_options": [
    "allow_root",
    "user_allow_other"
  ],
  "logfile": "/var/log/cryfs.log"
}
