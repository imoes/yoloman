{
  "log_ims": {
    "type": "number",
    "default": 1,
    "description": "Log instant messages"
  },
  "log_format": {
    "type": "string",
    "default": "html",
    "description": "Format for logging conversations",
    "enum": [
      "html",
      "xml"
    ]
  },
  "placement_number": {
    "type": "number",
    "default": 4,
    "description": "Window placement number for GTK plugins"
  },
  "placement_number_separate": {
    "type": "number",
    "default": 0,
    "description": "Separate window placement number settings"
  },
  "type_im": {
    "type": "number",
    "default": 1,
    "description": "Notify for instant messages"
  },
  "type_chat": {
    "type": "number",
    "default": 1,
    "description": "Notify for chat messages"
  },
  "type_chat_nick": {
    "type": "number",
    "default": 1,
    "description": "Notify for chat nick changes"
  },
  "type_focused": {
    "type": "number",
    "default": 0,
    "description": "Notify when window is focused"
  },
  "method_string": {
    "type": "number",
    "default": 0,
    "description": "Use string method for notifications"
  },
  "title_string": {
    "type": "string",
    "default": "(*)",
    "description": "Title string for notifications"
  },
  "method_urgent": {
    "type": "number",
    "default": 1,
    "description": "Use urgent method for notifications"
  },
  "method_count": {
    "type": "number",
    "default": 1,
    "description": "Use count method for notifications"
  },
  "method_count_xprop": {
    "type": "number",
    "default": 0,
    "description": "Use XProp for notification count"
  },
  "method_raise": {
    "type": "number",
    "default": 0,
    "description": "Raise window on notification"
  },
  "notify_focus": {
    "type": "number",
    "default": 1,
    "description": "Enable focus notification"
  },
  "notify_click": {
    "type": "number",
    "default": 1,
    "description": "Enable click notification"
  },
  "notify_type": {
    "type": "number",
    "default": 1,
    "description": "Enable type notification"
  },
  "notify_send": {
    "type": "number",
    "default": 1,
    "description": "Enable send notification"
  },
  "notify_switch": {
    "type": "number",
    "default": 1,
    "description": "Enable switch notification"
  },
  "browser_place": {
    "type": "number",
    "default": 0,
    "description": "Browser place setting"
  },
  "browser_command": {
    "type": "string",
    "default": "",
    "description": "Command for external browser"
  },
  "browser_binary": {
    "type": "string",
    "default": "xdg-open",
    "description": "Binary for opening links"
  },
  "show_buddy_icons": {
    "type": "number",
    "default": 0,
    "description": "Show buddy icons in buddy list"
  }
}
