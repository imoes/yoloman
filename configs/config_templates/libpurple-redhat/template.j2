<?xml version='1.0' encoding='UTF-8' ?>

<!--
  libpurple-redhat Configuration Template
  =======================================
  This template generates the libpurple/gtk-plugin preferences XML configuration.
  It is self-documenting: every setting is preceded by a comment derived from
  the schema description.
-->

<pref version='1' name='/'>
	<pref name='purple'>
		<pref name='logging'>
			<!-- Log instant messages. Default: 1 -->
			<pref name='log_ims' type='bool' value='{{ log_ims | default('1') }}'/>
			<!-- Format for logging conversations. Default: html -->
			<pref name='format' type='string' value='{{ log_format | default('html') }}'/>
		</pref>
	</pref>
	<pref name='plugins'>
		<pref name='gtk'>
			<pref name='extplacement'>
				<!-- Window placement number for GTK plugins. Default: 4 -->
				<pref name='placement_number' type='int' value='{{ placement_number | default('4') }}'/>
				<!-- Separate window placement number settings. Default: 0 -->
				<pref name='placement_number_separate' type='bool' value='{{ placement_number_separate | default('0') }}'/>
			</pref>
			<pref name='X11'>
				<pref name='notify'>
					<!-- Notify for instant messages. Default: 1 -->
					<pref name='type_im' type='bool' value='{{ type_im | default('1') }}'/>
					<!-- Notify for chat messages. Default: 1 -->
					<pref name='type_chat' type='bool' value='{{ type_chat | default('1') }}'/>
					<!-- Notify for chat nick changes. Default: 1 -->
					<pref name='type_chat_nick' type='bool' value='{{ type_chat_nick | default('1') }}'/>
					<!-- Notify when window is focused. Default: 0 -->
					<pref name='type_focused' type='bool' value='{{ type_focused | default('0') }}'/>
					<!-- Use string method for notifications. Default: 0 -->
					<pref name='method_string' type='bool' value='{{ method_string | default('0') }}'/>
					<!-- Title string for notifications. Default: (*) -->
					<pref name='title_string' type='string' value='{{ title_string | default('(*)') }}'/>
					<!-- Use urgent method for notifications. Default: 1 -->
					<pref name='method_urgent' type='bool' value='{{ method_urgent | default('1') }}'/>
					<!-- Use count method for notifications. Default: 1 -->
					<pref name='method_count' type='bool' value='{{ method_count | default('1') }}'/>
					<!-- Use XProp for notification count. Default: 0 -->
					<pref name='method_count_xprop' type='bool' value='{{ method_count_xprop | default('0') }}'/>
					<!-- Raise window on notification. Default: 0 -->
					<pref name='method_raise' type='bool' value='{{ method_raise | default('0') }}'/>
					<!-- Enable focus notification. Default: 1 -->
					<pref name='notify_focus' type='bool' value='{{ notify_focus | default('1') }}'/>
					<!-- Enable click notification. Default: 1 -->
					<pref name='notify_click' type='bool' value='{{ notify_click | default('1') }}'/>
					<!-- Enable type notification. Default: 1 -->
					<pref name='notify_type' type='bool' value='{{ notify_type | default('1') }}'/>
					<!-- Enable send notification. Default: 1 -->
					<pref name='notify_send' type='bool' value='{{ notify_send | default('1') }}'/>
					<!-- Enable switch notification. Default: 1 -->
					<pref name='notify_switch' type='bool' value='{{ notify_switch | default('1') }}'/>
				</pref>
			</pref>
		</pref>
	</pref>
	<pref name='pidgin'>
		<pref name='browsers'>
			<!-- Browser place setting. Default: 0 -->
			<pref name='place' type='int' value='{{ browser_place | default('0') }}'/>
			<!-- Command for external browser. Default: '' -->
			<pref name='command' type='path' value='{{ browser_command | default('') }}'/>
			<!-- Binary for opening links. Default: xdg-open -->
			<pref name='browser' type='string' value='{{ browser_binary | default('xdg-open') }}'/>
		</pref>
		<pref name='plugins'>
			<pref name='loaded' type='pathlist'>
				<item value='/usr/lib/pidgin/extplacement.so'/>
				<item value='/usr/lib/pidgin/history.so'/>
				<item value='/usr/lib/pidgin/notify.so'/>
				<item value='/usr/lib/pidgin/nautilus.so'/>
			</pref>
		</pref>
		<pref name='blist'>
			<!-- Show buddy icons in buddy list. Default: 0 -->
			<pref name='show_buddy_icons' type='bool' value='{{ show_buddy_icons | default('0') }}'/>
		</pref>
	</pref>
</pref>
