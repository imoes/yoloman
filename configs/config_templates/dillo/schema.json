{
  "geometry": {
    "type": "string",
    "default": "650x545+0+20",
    "description": "Initial browser window geometry (width x height + x_offset + y_offset)"
  },
  "load_images": {
    "type": "string",
    "default": "YES",
    "description": "Load images initially (YES/NO)",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "load_background_images": {
    "type": "string",
    "default": "NO",
    "description": "Load background images initially (YES/NO)",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "load_stylesheets": {
    "type": "string",
    "default": "YES",
    "description": "Load CSS stylesheets initially (YES/NO)",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "parse_embedded_css": {
    "type": "string",
    "default": "YES",
    "description": "Parse embedded CSS initially (YES/NO)",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "buffered_drawing": {
    "type": "number",
    "default": 1,
    "description": "Buffered drawing scheme: 0=none, 1=light, 2=full"
  },
  "save_dir": {
    "type": "string",
    "default": "/tmp",
    "description": "Default directory for download/save operations"
  },
  "font_serif": {
    "type": "string",
    "default": "DejaVu Serif",
    "description": "Default serif font"
  },
  "font_sans_serif": {
    "type": "string",
    "default": "DejaVu Sans",
    "description": "Default sans-serif font"
  },
  "font_cursive": {
    "type": "string",
    "default": "URW Chancery L",
    "description": "Default cursive font"
  },
  "font_fantasy": {
    "type": "string",
    "default": "DejaVu Sans",
    "description": "Default fantasy font"
  },
  "font_monospace": {
    "type": "string",
    "default": "DejaVu Sans Mono",
    "description": "Default monospace font"
  },
  "font_factor": {
    "type": "number",
    "default": 1.0,
    "description": "Font size scaling factor"
  },
  "font_max_size": {
    "type": "number",
    "default": 100,
    "description": "Maximum font size in pixels"
  },
  "font_min_size": {
    "type": "number",
    "default": 6,
    "description": "Minimum font size in pixels"
  },
  "show_tooltip": {
    "type": "string",
    "default": "YES",
    "description": "Show tooltips for HTML title attributes (YES/NO)",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "limit_text_width": {
    "type": "string",
    "default": "NO",
    "description": "Limit word wrap width to viewport width (YES/NO)",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "penalty_hyphen": {
    "type": "number",
    "default": 1,
    "description": "Penalty for hyphenation points without preceding hyphen"
  },
  "penalty_hyphen_2": {
    "type": "number",
    "default": 8,
    "description": "Penalty for hyphenation points after preceding hyphen"
  },
  "penalty_em_dash_right": {
    "type": "number",
    "default": 1,
    "description": "Penalty for break right of em-dash (no surrounding spaces)"
  },
  "penalty_em_dash_right_2": {
    "type": "number",
    "default": 8,
    "description": "Penalty for break right of em-dash after preceding em-dash"
  },
  "penalty_em_dash_left": {
    "type": "number",
    "default": 8,
    "description": "Penalty for break left of em-dash"
  },
  "stretchability_factor": {
    "type": "number",
    "default": 1,
    "description": "Factor for stretchability of non-justified lines"
  },
  "w3c_plus_heuristics": {
    "type": "string",
    "default": "YES",
    "description": "Use heuristics for better rendering over strict validation (YES/NO)",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "start_page": {
    "type": "string",
    "default": "about:splash",
    "description": "Start page URL"
  },
  "home": {
    "type": "string",
    "default": "http://www.dillo.org/",
    "description": "Home location URL"
  },
  "http_language": {
    "type": "string",
    "default": "",
    "description": "HTTP Accept-Language header value (e.g., 'en-US')"
  },
  "http_max_conns": {
    "type": "number",
    "default": 6,
    "description": "Maximum number of simultaneous TCP connections to a single server or proxy"
  },
  "ui_main_bg_color": {
    "type": "string",
    "default": "#c6c6c6",
    "description": "UI main background color (Hex or named)"
  },
  "ui_text_bg_color": {
    "type": "string",
    "default": "#bfdabf",
    "description": "UI text background color (Hex or named)"
  },
  "ui_selection_color": {
    "type": "string",
    "default": "#191970",
    "description": "UI selection color (Hex or named)"
  },
  "ui_button_highlight_color": {
    "type": "string",
    "default": "#a9a9a9",
    "description": "UI button highlight color (Hex or named)"
  },
  "ui_tab_active_bg_color": {
    "type": "string",
    "default": "#87aca7",
    "description": "UI active tab background color (Hex or named)"
  },
  "ui_tab_active_fg_color": {
    "type": "string",
    "default": "black",
    "description": "UI active tab foreground color (Hex or named)"
  },
  "ui_tab_bg_color": {
    "type": "string",
    "default": "#b7beb7",
    "description": "UI inactive tab background color (Hex or named)"
  },
  "panel_size": {
    "type": "string",
    "default": "medium",
    "description": "Size of dillo panel: tiny, small, medium",
    "enum": [
      "tiny",
      "small",
      "medium"
    ]
  }
}
