# MediaConch GUI Configuration Template
# This file configures the MediaConch Graphical User Interface.
# It is managed by Ansible and should not be edited manually.

[General]
# Language for the GUI interface (e.g., en, fr, de).
# Defaults to English if not specified.
Language={{ language | default('en') }}

[Policy]
# Path to the default XSL policy file used for conformance checking.
# This file defines the rules against which media files are validated.
# Defaults to the system-wide MediaConch policy if not specified.
DefaultPolicyPath={{ default_policy_path | default('/usr/share/mediaconch/policy/MediaConchPolicy.xsl') }}

[Display]
# Path to the XSL display transformation file used for rendering reports.
# This file determines how the results of the policy checks are presented to the user.
# Defaults to the system-wide MediaConch display template if not specified.
DefaultDisplayPath={{ default_display_path | default('/usr/share/mediaconch/display/MediaConchDisplay.xsl') }}

[Output]
# Default output format for MediaConch reports.
# Valid values: text, xml, maxml, html.
# Defaults to plain text if not specified.
DefaultOutputFormat={{ default_output_format | default('text') }}

# List of report types to generate.
# Valid values: implementation, policy, mediainfo, mediatrace.
# Multiple types can be specified as a comma-separated list.
# Defaults to 'implementation,policy' if not specified.
ReportTypes={{ report_types | default(['implementation', 'policy']) | join(',') }}