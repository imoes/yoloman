# NTPd-RS Configuration Template
# This template configures the ntpd-rs daemon using a TOML-like structure.
# It provides time synchronization capabilities.

[observability]
# Log level: trace, debug, info, warn, error
# Controls the verbosity of the daemon's logging output.
log-level = "{{ log_level | default('info') }}"

# Path to the observation socket for retrieving statistical information
# about the daemon while it is running. Use `ntp-ctl` or
# prometheus based `ntp-metrics-exporter` binaries to read from this socket.
# This socket allows external tools to monitor the state of the NTP service.
observation-path = "{{ observation_path | default('/var/run/ntpd-rs/observe') }}"

## The sources section allows configuring sources. You may configure multiple
## of these blocks to add more sources to your configuration.
## Our default configuration spawns a pool of sources (by default this attempts
## to discover 4 distinct sources).
[[source]]
# Source mode: pool or server.
# - pool: Discovers multiple sources (requires `count` and `address` being a pool name).
# - server: Connects to a single specific source (requires `address` being an IP/hostname).
# Determines how the daemon interacts with the time sources defined below.
mode = "{{ source_mode | default('pool') }}"

# Address or hostname of the NTP source/pool.
# If source_mode is 'pool', this is typically a pool domain (e.g., pool.ntp.org).
# If source_mode is 'server', this is the specific IP or hostname of the NTP server.
# This is the primary NTP server or pool domain to synchronize against.
address = "{{ source_address | default('ntpd-rs.pool.ntp.org') }}"

# Number of sources to discover when in pool mode.
# Only relevant if mode is 'pool'.
# Specifies how many distinct servers to attempt to find within the configured pool.
count = {{ source_count | default(4) }}

## If you have an NTS server, you can configure a source that connects using NTS
## by adding a configuration such as the one below
#[[source]]
#mode = "nts"
# NTS service from NETNOD: https://www.netnod.se/nts/network-time-security
#address = "nts.netnod.se"

## A source in server mode will only create a single source in contrast to the
## multiple sources of a pool. This is the recommended source mode if you only
## have an IP address for the source.
#[[source]]
#mode = "server"
#address = "ntpd-rs.pool.ntp.org"

## If you want to provide time to other machines, the configuration below
## enables serving time on port 123 of all network interfaces.
#[[server]]
#listen = "[::]:123"

## Below are configured various thresholds beyond which ntpd-rs will not
## change the system clock. CHANGE THESE TO MATCH YOUR SECURITY NEEDS!
[synchronization]
# Maximum step size (in seconds) of a single step during normal operation.
# If the time difference exceeds this, ntpd-rs will step the clock.
# Prevents large clock jumps during normal operation if the deviation is within this threshold.
single-step-panic-threshold = {{ single_step_panic_threshold | default(1800) }}

# On startup a larger jump may occur, this sets limits for that initial jump.
# forward="inf" allows unlimited forward jumps.
# backward limits how far back the clock can be set to correct drift.
# Configures the maximum backward step allowed during the initial startup phase.
startup-step-panic-threshold = { forward="inf", backward = {{ startup_step_backward_threshold | default(86400) }} }

# If, during the lifetime of the ntp-daemon the combined time of time jumps
# exceeds this value, then the NTP daemon will stop, this is disabled by default
#accumulated-threshold = 1800
# If the number of sources agreeing on the time is below this, the daemon may stop.
#minimum-agreeing-sources = 3
