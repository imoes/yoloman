{
  "variables": [
    "ROOT = $HOME/pwget_downloads",
    "UPDATE = $ROOT/updates"
  ],
  "tags": [
    {
      "tag1": {
        "tag_name": "linux-updates",
        "levels": [
          {
            "tag": "tag1",
            "name": "linux-updates",
            "print": "Checking for Linux updates...",
            "entries": [
              {
                "http://www.example.com/dir/package-1.0.tar.gz": [
                  "lcd: $UPDATE",
                  "new:",
                  "overwrite:"
                ]
              }
            ]
          },
          {
            "tag": "tag2",
            "name": "specific-package",
            "print": "Downloading specific package with login",
            "entries": [
              {
                "ftp://ftp.example.com/dir/file-2.0.tar.gz": [
                  "login:anonymous",
                  "pass: user@example.com",
                  "save: file-2.0.tar.gz",
                  "x:"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "tag1": {
        "tag_name": "emacs-elisp",
        "levels": [
          {
            "tag": "tag1",
            "name": "emacs-elisp",
            "print": "Downloading Emacs ELISP files",
            "entries": [
              {
                "http://www.emacswiki.org/elisp/index.html": [
                  "pregexp: \\.el$",
                  "cnv:text",
                  "save: elisp_page.txt"
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
