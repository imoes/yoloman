#
################################################################################
# GoFax Schema Definition for OpenLDAP (cn=config)
# This file defines custom attribute types and object classes for the goFax
# application within the LDAP directory.
#
# Schema Element: Top-level Entry
# Defines the DN for this schema definition block.
# Variable: gosa_schema_cn - The common name (cn) for the gofax schema entry.
# Default: 'gofax'
################################################################################
dn: cn={{ gosa_schema_cn | default('gofax') }},cn=schema,cn=config
objectClass: olcSchemaConfig
# Schema Common Name: Must match the entry's CN for consistency.
cn: {{ gosa_schema_cn | default('gofax') }}

#
################################################################################
# Schema Element: goFaxDeliveryMode
# Attribute Type: goFaxDeliveryMode
# Description: goFax delivery mode is defined here.
# OID: 1.3.6.1.4.1.10098.1.1.7.1
################################################################################
olcAttributeTypes: (
  1.3.6.1.4.1.10098.1.1.7.1
  NAME 'goFaxDeliveryMode'
  DESC 'goFax delivery mode is defined here'
  EQUALITY caseExactIA5Match
  SUBSTR caseExactIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE
  )

#
################################################################################
# Schema Element: goFaxPrinter
# Attribute Type: goFaxPrinter
# Description: defines which printer is used to print a fax.
# OID: 1.3.6.1.4.1.10098.1.1.7.2
################################################################################
olcAttributeTypes: (
  1.3.6.1.4.1.10098.1.1.7.2
  NAME 'goFaxPrinter'
  DESC 'defines which printer is used to print a fax'
  EQUALITY caseExactIA5Match
  SUBSTR caseExactIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE
  )

#
################################################################################
# Schema Element: goFaxDivertNumber
# Attribute Type: goFaxDivertNumber
# Description: for fax diversion services.
# OID: 1.3.6.1.4.1.10098.1.1.7.3
################################################################################
olcAttributeTypes: (
  1.3.6.1.4.1.10098.1.1.7.3
  NAME 'goFaxDivertNumber'
  DESC 'for fax diversion services'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.22
  SINGLE-VALUE
  )

#
################################################################################
# Schema Element: goFaxLanguage
# Attribute Type: goFaxLanguage
# Description: preferred language for the users goFax entry.
# OID: 1.3.6.1.4.1.10098.1.1.7.4
################################################################################
olcAttributeTypes: (
  1.3.6.1.4.1.10098.1.1.7.4
  NAME 'goFaxLanguage'
  DESC 'preferred language for the users goFax entry'
  EQUALITY caseExactIA5Match
  SUBSTR caseExactIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE
  )

#
################################################################################
# Schema Element: goFaxFormat
# Attribute Type: goFaxFormat
# Description: defines the fileformat for mailattachments.
# OID: 1.3.6.1.4.1.10098.1.1.7.5
################################################################################
olcAttributeTypes: (
  1.3.6.1.4.1.10098.1.1.7.5
  NAME 'goFaxFormat'
  DESC 'defines the fileformat for mailattachments'
  EQUALITY caseExactIA5Match
  SUBSTR caseExactIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE
  )

#
################################################################################
# Schema Element: goFaxRBlocklist
# Attribute Type: goFaxRBlocklist
