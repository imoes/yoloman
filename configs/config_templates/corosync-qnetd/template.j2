# ============================================================================
# Corosync Qdevice Network Daemon (corosync-qnetd) Init Script Configuration
# ============================================================================
#
# This template configures the `corosync-qnetd` service. It handles command-line
# options and the runtime user context.
#
# Self-documenting: Every variable reference includes its schema default to
# ensure safe rendering even if the variable is undefined in the playbook.
# ============================================================================

# ----------------------------------------------------------------------------
# COROSYNC_QNETD_OPTIONS
# ----------------------------------------------------------------------------
# Description: Options passed to the corosync-qnetd command.
# Default:     '' (empty string, meaning no extra options are passed)
# Note:        See "man corosync-qnetd" for a detailed description of valid options.
# Rendered:    COROSYNC_QNETD_OPTIONS="<value>"
# ----------------------------------------------------------------------------
COROSYNC_QNETD_OPTIONS="{{ COROSYNC_QNETD_OPTIONS | default('') }}"

# ----------------------------------------------------------------------------
# COROSYNC_QNETD_RUNAS
# ----------------------------------------------------------------------------
# Description: User under which the qnetd daemon should be running.
# Default:     '' (empty string, meaning the default user determined by the
#              init system or the user executing the script)
# Note:
#   - If empty, the daemon runs as the user who executes the init script.
#   - Ensure correct ownership of directories:
#       /etc/corosync/qnetd
#       /var/run/corosync-qnetd
#   - This setting has NO EFFECT if the systemd unit file is used.
#     To change the user in systemd, modify the unit file directly
#     (e.g., User= corosync in the [Service] section).
# Rendered:    COROSYNC_QNETD_RUNAS="<value>"
# ----------------------------------------------------------------------------
COROSYNC_QNETD_RUNAS="{{ COROSYNC_QNETD_RUNAS | default('') }}"