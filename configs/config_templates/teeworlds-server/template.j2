# Teeworlds Server Configuration
#
# This file is auto-generated by Ansible. Do not edit manually.
# For detailed documentation on these settings, visit:
# https://www.teeworlds.com/?page=docs&wiki=server_settings

# ============================================================
# SERVER IDENTITY
# ============================================================

# The name displayed in the server browser.
sv_name {{ sv_name | default('Teeworlds powered by Debian') }}

# ============================================================
# NETWORK SETTINGS
# ============================================================

# Server port for player connections.
# Default is 8303 (UDP), but this setting overrides it if defined.
{% if sv_port is defined %}sv_port {{ sv_port }}
{% else %}# sv_port 8303
{% endif %}

# The IP address to bind the server to.
# Leave commented to bind to all available interfaces.
{% if sv_bindaddr is defined %}sv_bindaddr {{ sv_bindaddr }}
{% else %}# sv_bindaddr 0.0.0.0
{% endif %}

# Port to connect to the master server for server listing.
# 0 means use the default port or logic.
sv_external_port {{ sv_external_port | default('0') }}

# ============================================================
# PLAYER LIMITS
# ============================================================

# Maximum number of allowed players.
sv_max_clients {{ sv_max_clients | default('16') }}

# Maximum number of allowed players per IP address.
sv_max_clients_per_ip {{ sv_max_clients_per_ip | default('4') }}

# Set to 1 for LAN server mode (high bandwidth optimization).
sv_high_bandwidth {{ sv_high_bandwidth | default('0') }}

# Register with the master server. Set to 1 to enable.
sv_register {{ sv_register | default('1') }}

# ============================================================
# SECURITY & ACCESS
# ============================================================

# Password for remote console (RCON) access.
# It is strongly recommended to set a secure password.
{% if sv_rcon_password is defined %}sv_rcon_password {{ sv_rcon_password }}
{% else %}# sv_rcon_password change_me
{% endif %}

# Server password required for players to join.
# If not set (commented out), anyone can join.
{% if password is defined %}password "{{ password }}"
{% else %}# password ""
{% endif %}

# Maximum number of RCON password retries before ban.
sv_rcon_max_tries {{ sv_rcon_max_tries | default('3') }}

# RCON password ban time in minutes.
sv_rcon_ban_time {{ sv_rcon_ban_time | default('60') }}

# ============================================================
# GAMEPLAY SETTINGS
# ============================================================

# Console output verbosity level.
console_output_level {{ console_output_level | default('0') }}

# Warmup time in seconds.
sv_warmup {{ sv_warmup | default('10') }}

# Message of the day displayed to players.
sv_motd {{ sv_motd | default('Welcome - and have fun!') }}

# Number of spectator slots available.
sv_spectator_slots {{ sv_spectator_slots | default('2') }}

# Activate spam protection.
sv_spamprotection {{ sv_spamprotection | default('1') }}

# Activate vote kick functionality.
sv_vote_kick {{ sv_vote_kick | default('1') }}

# Ban time in minutes after a successful vote kick.
sv_vote_kick_bantime {{ sv_vote_kick_bantime | default('60') }}

# Minimum number of players required to trigger a vote kick.
sv_vote_kick_min {{ sv_vote_kick_min | default('4') }}

# Action for inactive players:
# 0 = move to spectator, 1 = move to free spectator slot, 2 = kick.
sv_inactivekick {{ sv_inactivekick | default('0') }}

# Time in minutes a player is allowed to be inactive before being kicked/moved.
sv_inactivekick_time {{ sv_inactivekick_time | default('3') }}

# Time in minutes after which teams are auto-balanced if uneven.
sv_teambalance_time {{ sv_teambalance_time | default('1') }}

# ============================================================
# LOGGING & EXTENSIONS
# ============================================================

# Path to the server log file.
# If commented out, logging may be disabled or go to stderr depending on launch args.
{% if logfile is defined %}logfile {{ logfile }}
{% else %}# logfile /var/log/teeworlds/server.log
{% endif %}

# Path to the included default configuration file.
exec {{ exec_path | default('/etc/teeworlds/server.cfg') }}
