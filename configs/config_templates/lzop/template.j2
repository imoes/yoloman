# Default options for lzop, applied via the LZOP environment variable.
# These options are interpreted first and can be overwritten by explicit command line parameters.

# Compression level: -1 (--fast) to -9 (--best). Default is -3.
# Higher levels compress better but slower; -3 is a good balance.
LZOP={{ (lzop | default({})).compression_level | default('-3') }}{{ (lzop | default({})).verbose_flag | default('') }}{{ (lzop | default({})).name_flag | default('--name') }}{{ (lzop | default({})).checksum_flag | default('--crc32') }}