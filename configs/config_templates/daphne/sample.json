{
  "bind_address": "0.0.0.0:8000",
  "workers": 2,
  "connection_timeout": 120,
  "max_connections": 2000,
  "log_level": "info",
  "application": "myproject.asgi:application",
  "http_max_header_size": 16384,
  "websocket_ping_interval": 30,
  "websocket_ping_timeout": 10,
  "ssl": {
    "keyfile": "/etc/ssl/private/daphne.key",
    "certfile": "/etc/ssl/certs/daphne.crt",
    "ca_certs": "/etc/ssl/certs/ca-chain.crt"
  },
  "access_log": "/var/log/daphne/access.log",
  "error_log": "/var/log/daphne/error.log",
  "extra_args": "--proxy-headers",
  "server_name": "Daphne/3.0.2",
  "allowed_hosts": [
    "example.com",
    "*.internal.example.com",
    "localhost"
  ]
}
