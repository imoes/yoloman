# Load the ejabberd_mod_cron module
{{ 'modules:' | comment }}
modules:
{{ '  # Execute scheduled tasks via cron-style expressions' | comment }}
  mod_cron:
{{ '    # List of cron jobs to schedule' | comment }}
    cron_jobs:
{% for job in cron_jobs %}
{{ '    - # ' + job.description | comment }}
{{ '      ' + job.name | comment }}
      - name: "{{ job.name }}"
        schedule: "{{ job.schedule }}"
        command: "{{ job.command }}"
{% if job.args is defined and job.args | length > 0 %}
{{ '      # Arguments passed to the command' | comment }}
        args: {{ job.args | to_json }}
{% endif %}
{% if job.enabled is defined %}
{{ '      # Whether this job is active' | comment }}
        enabled: {{ job.enabled | lower }}
{% endif %}
{% endfor %}
