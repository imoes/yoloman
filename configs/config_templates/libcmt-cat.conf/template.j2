# Configuration file for intel-cmt-cat (libcmt-cat) service
# Manages monitoring of Intel Cache Monitoring Technology (CMT) and Cache Allocation Technology (CAT).

# Enable or disable monitoring of cache and memory bandwidth.
# If set to false, the service will not collect performance metrics.
monitor: {{ monitor | default(true) }}

# Path to the RDT (Resource Director Technology) device interface.
# This is the sysfs path where the kernel exposes CMT/CAT capabilities.
device_path: "{{ device_path | default('/dev/rdt') }}"

# Maximum number of Cache Monitoring (CLOS) groups the system supports.
# CLOS IDs are used to identify different monitoring contexts.
max_clos: {{ max_clos | default(4) }}

# List of monitoring groups (CLOS) and the PIDs to monitor within them.
# Each group is defined by a clos_id and a list of process IDs.
monitors:
{% for m in monitors | default([]) %}# Monitoring group CLOS {{ m.clos_id }}: processes {{ m.processes | default([]) | join(', ') }}
- clos_id: {{ m.clos_id | default(0) }}
  processes:
{% for pid in m.processes | default([]) %}    - {{ pid }}
{% endfor %}{% endfor %}

# Interval (in milliseconds) at which monitoring data is sampled.
poll_interval_ms: {{ poll_interval_ms | default(1000) }}

# Enable or disable collection of detailed per-level cache metrics (L1, L2, L3).
# When true, finer-grained cache usage statistics are gathered.
detailed_cache_mon: {{ detailed_cache_mon | default(false) }}

# File path where monitoring logs and reports will be written.
# Ensure the directory exists and is writable by the service user.
log_file: "{{ log_file | default('/var/log/libcmt-cat/monitor.log') }}"