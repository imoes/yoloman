# Number of processes for the FastCGI server
# Defines how many worker processes the LemonLDAP::NG FastCGI server should spawn.
NPROC = {{ NPROC | default(7) }}

# Unix socket path for the FastCGI server
# The path to the Unix domain socket where the FastCGI server will listen.
# Ensure the parent directory exists and is accessible by the web server.
SOCKET={{ SOCKET | default('/run/llng-fastcgi-server/llng-fastcgi.sock') }}

# Path to the PID file for the FastCGI server
# Location of the file where the server writes its process ID.
PID={{ PID | default('/run/llng-fastcgi-server/llng-fastcgi-server.pid') }}

# User to run the FastCGI server process as
# The system user account under which the server processes will run.
USER={{ USER | default('www-data') }}

# Group to run the FastCGI server process as
# The system group associated with the server processes.
GROUP={{ GROUP | default('www-data') }}

# Custom functions file
# Optional: Path to a Perl module file containing custom LemonLDAP::NG functions.
# Uncomment and set to enable custom Perl logic in the application.
# CUSTOM_FUNCTIONS_FILE=/var/lib/lemonldap-ng/myfile.pm

# SERVER_SOURCE
# Identifies the web server reverse-proxying to this FastCGI backend.
# Default: nginx
# Alternatives: apache, traefik, lighttpd, etc.
# Note: This field is not a network address (host/port) but a configuration identifier for the upstream web server type.
# Therefore, this service does not require a network connection via the standard 'host' or 'port' capability roles.
# SERVER_SOURCE = {{ SERVER_SOURCE | default('nginx') }}