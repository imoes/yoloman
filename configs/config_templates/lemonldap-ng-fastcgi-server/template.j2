# ============================================================================
# LemonLDAP::NG FastCGI Server Configuration
# ============================================================================
# This file configures the standalone FastCGI server for LemonLDAP::NG.
# It controls process management, socket location, privileges, and PID tracking.
# ============================================================================

# --- Process Management ---
# Number of processes for the FastCGI server.
# Defaults to an empty value (systemd or wrapper usually handles this, 
# or it falls back to a default behavior).
# If a value is not provided, this directive is commented out with the 
# recommended default of 7.
{% if NPROC | default('') %}
NPROC = {{ NPROC }}
{% else %}
# NPROC = 7
{% endif %}

# --- Network/Socket Configuration ---
# Unix socket path for the FastCGI server.
# This is the endpoint Nginx/Apache will connect to.
# Ensure the directory /run/llng-fastcgi-server/ exists and is writable 
# by the configured USER/GROUP.
SOCKET={{ SOCKET | default('/run/llng-fastcgi-server/llng-fastcgi.sock') }}

# --- PID File ---
# Path to the PID file for the FastCGI server.
# Used by systemd or init scripts to track the running instance.
PID={{ PID | default('/run/llng-fastcgi-server/llng-fastcgi-server.pid') }}

# --- Privileges ---
# User to run the FastCGI server process as.
# Running as a non-root user is a security best practice.
USER={{ USER | default('www-data') }}

# Group to run the FastCGI server process as.
GROUP={{ GROUP | default('www-data') }}

# --- Advanced/Optional Configuration ---
# Custom functions file
# Path to a Perl module file containing custom LemonLDAP::NG functions.
# Uncomment and set if you have custom Perl handlers.
# CUSTOM_FUNCTIONS_FILE=/var/lib/lemonldap-ng/myfile.pm

# --- Backend Server Source ---
# SERVER_SOURCE
#
# Default: nginx
# Alternative: traefik
#
# This directive indicates the web server/proxy backend LemonLDAP::NG
# is primarily integrated with. It may influence internal routing 
# or logging behavior.
# SERVER_SOURCE = nginx
