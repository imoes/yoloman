{
  "basket.name": {
    "type": "string",
    "default": "noosphere",
    "description": "Name of the primary basket"
  },
  "basket.ip_addr": {
    "type": "string",
    "default": "128.112.35.133",
    "description": "IP address of the basket"
  },
  "protocol.samples_per_record": {
    "type": "number",
    "default": 10,
    "description": "Samples per record (1-10, recommended 5-10)"
  },
  "protocol.seconds_per_record": {
    "type": "number",
    "default": 10,
    "description": "Seconds per record (1-3000)"
  },
  "protocol.records_per_packet": {
    "type": "number",
    "default": 30,
    "description": "Records per packet (1-60)"
  },
  "protocol.bits_per_sample": {
    "type": "number",
    "default": 200,
    "description": "Bits per sample (32-255)"
  },
  "hardware.type": {
    "type": "string",
    "default": "ORION",
    "description": "Hardware device type (e.g., PEAR, ORION)",
    "enum": [
      "ORION",
      "PEAR",
      "PSEUDO"
    ],
    "enum_open": true
  },
  "hardware.port": {
    "type": "number",
    "default": 0,
    "description": "Serial port number (e.g., 0 for /dev/ttyS0)"
  },
  "hardware.baud": {
    "type": "number",
    "default": 9600,
    "description": "Baud rate for serial port"
  },
  "conntype": {
    "type": "string",
    "default": "PERM",
    "description": "Connection type (PERM or DND)",
    "enum": [
      "PERM",
      "DND"
    ]
  },
  "connival": {
    "type": "number",
    "default": 1,
    "description": "Connection interval in minutes"
  }
}
