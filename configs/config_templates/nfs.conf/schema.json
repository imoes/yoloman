{
  "pipefs_directory": {
    "type": "string",
    "default": "/run/rpc_pipefs",
    "description": "Kernel rpc_pipefs mount point (rarely changed)."
  },
  "nfsd_threads": {
    "type": "number",
    "default": 8,
    "description": "Number of kernel nfsd threads — RPC request concurrency. Raise on busy servers (e.g. 16/32)."
  },
  "nfsd_vers3": {
    "type": "string",
    "default": "y",
    "enum": ["y", "n"],
    "description": "Serve NFSv3."
  },
  "nfsd_vers4": {
    "type": "string",
    "default": "y",
    "enum": ["y", "n"],
    "description": "Serve NFSv4."
  },
  "nfsd_vers4_1": {
    "type": "string",
    "default": "y",
    "enum": ["y", "n"],
    "description": "Serve NFSv4.1."
  },
  "nfsd_vers4_2": {
    "type": "string",
    "default": "y",
    "enum": ["y", "n"],
    "description": "Serve NFSv4.2."
  },
  "nfsd_tcp": {
    "type": "string",
    "default": "y",
    "enum": ["y", "n"],
    "description": "Accept NFS over TCP."
  },
  "nfsd_udp": {
    "type": "string",
    "default": "n",
    "enum": ["y", "n"],
    "description": "Accept NFS over UDP (off by default; NFSv4 is TCP-only)."
  },
  "nfsd_port": {
    "type": "number",
    "default": 2049,
    "description": "nfsd listen port (2049 is the standard)."
  },
  "mountd_port": {
    "type": "number",
    "default": 0,
    "description": "Fixed mountd port (0 = dynamic). Pin it to open a firewall for NFSv3."
  },
  "statd_port": {
    "type": "number",
    "default": 0,
    "description": "Fixed statd (NSM) port (0 = dynamic). Pin it for NFSv3 firewalling."
  }
}
