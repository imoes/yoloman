# Corosync Qdevice daemon configuration template
# This file configures the corosync-qdevice service, which provides a
# quorum device for Pacemaker/Corosync clusters. The quorum device
# acts as a tie-breaker to prevent split-brain scenarios.

# ---------------------------------------------------------------------------
# Global options for the corosync-qdevice command
# ---------------------------------------------------------------------------
# Description: Options passed to the corosync-qdevice command at startup.
# Examples:
#   - 'foreground' : keep the daemon in the foreground (useful for systemd
#                    Type=notify or when debugging).
#   - 'log_level=debug' : enable verbose logging.
# Default: 'foreground'
COROSYNC_QDEVICE_OPTIONS="{{ COROSYNC_QDEVICE_OPTIONS | default('foreground') }}"