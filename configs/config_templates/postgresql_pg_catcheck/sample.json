{
  "bin_dir": "/usr/lib/postgresql/17/bin",
  "host": "localhost",
  "port": 5432,
  "database": "template1",
  "username": "postgres",
  "auth_method": "scram-sha-256",
  "password_file": "/etc/postgresql/pg_catcheck.pass",
  "connect_timeout": 10,
  "check_names": [
    "catalog",
    "index",
    "sequence"
  ],
  "verbose": true,
  "dry_run": false,
  "skip_types": [
    "toast",
    "partition"
  ],
  "max_errors": 50,
  "tolerant": false,
  "check_options": [
    {
      "check_name": "index",
      "description": "Verifies btree/GiST index entries match table data.",
      "enabled": true
    },
    {
      "check_name": "sequence",
      "description": "Ensures sequence metadata consistency with their usage in tables.",
      "enabled": true
    }
  ],
  "legacy_mode": false
}
