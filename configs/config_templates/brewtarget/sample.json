{
  "config_dir": "/etc/brewtarget",
  "data_dir": "/usr/share/brewtarget",
  "lang": "en_US",
  "database_host": "localhost",
  "database_port": 5432,
  "database_name": "brewtarget_db",
  "database_user": "brewtarget",
  "database_pass": "secret_pass",
  "log_level": "warning",
  "log_file": "/var/log/brewtarget/brewtarget.log",
  "font_scale": 1.25,
  "units": "imperial",
  "default_recipe_dir": "/home/brewer/Brewtarget/Recipes",
  "backup_enabled": true,
  "backup_interval_days": 3,
  "backup_retention_days": 60,
  "backups": [
    "/backup/brewtarget",
    "/mnt/external/brewtarget"
  ],
  "style_database_path": "/usr/share/brewtarget/styles.xml",
  "ingredient_database_path": "/usr/share/brewtarget/ingredients.xml"
}
