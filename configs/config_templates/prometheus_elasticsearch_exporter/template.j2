# Configuration for the Prometheus Elasticsearch exporter
# Path to the Elasticsearch cluster (e.g., http://localhost:9200)
ES_URI={{ es_uri }}

# Comma-separated list of Elasticsearch nodes (optional; if empty, ES_URI is used)
{% if es_nodes %}ES_NODES={{ es_nodes | join(',') }}{% endif %}

# Elasticsearch username for basic auth (optional)
{% if es_username %}ES_USERNAME={{ es_username }}{% endif %}

# Elasticsearch password for basic auth (optional)
{% if es_password %}ES_PASSWORD={{ es_password }}{% endif %}

# Enable TLS/SSL (true/false)
ES_TLS={{ es_tls }}

# Path to CA certificate for TLS verification (optional)
{% if es_ca_cert %}ES_CA_CERT={{ es_ca_cert }}{% endif %}

# Skip TLS certificate verification (⚠️ insecure; for dev/test only)
ES_TLS_SKIP_VERIFY={{ es_tls_skip_verify }}

# Path to client certificate for mutual TLS (optional)
{% if es_client_cert %}ES_CLIENT_CERT={{ es_client_cert }}{% endif %}

# Path to client private key for mutual TLS (optional)
{% if es_client_key %}ES_CLIENT_KEY={{ es_client_key }}{% endif %}

# Enable collection of cluster health metrics
CLUSTER_HEALTH={{ cluster_health }}

# Enable collection of indices stats
INDICES_STATS={{ indices_stats }}

# Enable collection of node stats
NODES_STATS={{ nodes_stats }}

# Enable collection of shards stats (⚠️ expensive on large clusters)
SHARDS_STATS={{ shards_stats }}

# Enable collection of snapshot/backup metrics
SNAPSHOTS={{ snapshots }}

# Enable collection of circuit breaker stats
CIRCUIT_BREAKERS={{ circuit_breakers }}

# Enable collection of thread pool stats
THREAD_POOLS={{ thread_pools }}

# Enable collection of index template stats
INDEX_TEMPLATES={{ index_templates }}

# Enable collection of ingest pipeline stats
INGEST_PIPELINES={{ ingest_pipelines }}

# Enable collection of feature stats (e.g., machine learning)
FEATURES={{ features }}

# List of additional labels to attach to all metrics (format: key=value)
{% if extra_labels %}EXTRA_LABELS={{ extra_labels | join(',') }}{% endif %}

# Timeout for HTTP requests to Elasticsearch (seconds)
HTTP_TIMEOUT={{ http_timeout }}

# Port to listen on for the exporter (default: 9114)
LISTEN_PORT={{ listen_port }}

# Host to bind to (default: 0.0.0.0)
LISTEN_HOST={{ listen_host }}

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL={{ log_level }}

# Enable/disable metric filtering (experimental)
METRIC_FILTERING={{ metric_filtering }}

# Comma-separated list of regex patterns for metric filtering (if enabled)
{% if metric_filters %}METRIC_FILTERS={{ metric_filters | join(',') }}{% endif %}

# Comma-separated list of index patterns to exclude from indices stats
{% if exclude_indices %}EXCLUDE_INDICES={{ exclude_indices | join(',') }}{% endif %}

# Comma-separated list of node roles to exclude (e.g., "data", "master")
{% if exclude_node_roles %}EXCLUDE_NODE_ROLES={{ exclude_node_roles | join(',') }}{% endif %}

# Enable/disable collection of ILM (Index Lifecycle Management) policies
ILM={{ ilm }}

# Enable/disable collection of data stream stats
DATA_STREAMS={{ data_streams }}
