# OpenStack Nova Fence Agent configuration
# Authentication and connection parameters for OpenStack Nova fencing
[openstack]
# OpenStack cloud identity API version
auth_version = {{ auth_version }}

# OpenStack region name
region_name = {{ region_name }}

# Identity endpoint URL (keystone)
auth_url = {{ auth_url }}

# Project/tenant name for authentication
project_name = {{ project_name }}

# Project/tenant ID (optional; use if known and stable)
{% if project_id %}project_id = {{ project_id }}{% endif %}

# Username for service account
username = {{ username }}

# Password for service account
password = {{ password }}

# Domain name (for Keystone v3+) — leave blank if using v2.0
{% if domain_name %}domain_name = {{ domain_name }}{% endif %}

# Optional: Use trust-scoped auth if domain scoped
{% if trust_id %}trust_id = {{ trust_id }}{% endif %}

# Use insecure HTTPS (skip certificate validation)
insecure = {{ insecure }}

# CA certificate bundle path (if not using system CA)
{% if ca_file %}ca_file = {{ ca_file }}{% endif %}

# List of server IDs to fence (populated by cluster manager at runtime, but documented here)
# servers = {{ servers | join(', ') }}

# Optional: Custom API endpoint for Nova (if using non-default service endpoint)
{% if nova_endpoint %}nova_endpoint = {{ nova_endpoint }}{% endif %}

# Timeout (seconds) for each API call
retry_timeout = {{ retry_timeout }}

# Number of retries before failing
retry_count = {{ retry_count }}

# Wait time (seconds) between retries
retry_max_delay = {{ retry_max_delay }}
