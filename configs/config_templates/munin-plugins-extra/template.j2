# Munin plugin monitoring for the DHCP daemon (ISC dhcpd).
# Reads statistics from the DHCP server configuration and lease file.
# See: /usr/share/doc/munin-plugins-extra/dhcpd3/README or man munin-plugin-dhcpd3

[dhcpd3]
# Path to the DHCP server configuration file
# The plugin parses this to determine if the server is running and its basic settings.
env.configfile {{ dhcpd_config_path | default('/etc/dhcp/dhcpd.conf') }}

# Path to the DHCP lease file
# The plugin parses this to count active and expired leases.
env.leasefile {{ dhcpd_lease_path | default('/var/lib/dhcp/dhcpd.leases') }}