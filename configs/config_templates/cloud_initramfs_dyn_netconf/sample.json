{
  "prereq": "udev",
  "run_interfaces_dir": "/run/network/interfaces.d",
  "dhcp_timeout": 300,
  "interface_metric": 100,
  "dhcp4": true,
  "dhcp6": false,
  "fallback_interface": "",
  "dhcp4_options": [
    {
      "key": "hostname",
      "value": "$(hostname -s)",
      "description": "Send the short hostname to the DHCP server for dynamic DNS registration"
    }
  ]
}
