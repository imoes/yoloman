{
 "auth_realm": "Company Ticket System",
 "auth_type": "ldap",
 "cors_enabled": true,
 "cors_origin": "https://confluence.internal.example.com",
 "environment_vars": {
  "RT_LOG_LEVEL": "info",
  "RT_NOSUID": "1"
 },
 "extra_directives": [
  "ProxyPass /rt/ http://127.0.0.1:8080/ retry=0",
  "ProxyPassReverse /rt/ http://127.0.0.1:8080/",
  "RequestHeader set X-Forwarded-Proto \"https\""
 ],
 "fastcgi_max_processes": 8,
 "htpasswd_file": "",
 "ldap_bind_dn": "CN=rt-ldap,OU=Service Accounts,DC=internal,DC=example,DC=com",
 "ldap_bind_password": "REDACTED",
 "ldap_url": "ldap://ldap.internal.example.com/OU=Users,DC=internal,DC=example,DC=com?sAMAccountName?sub?(objectClass=user)",
 "perl5lib": "/usr/local/lib/request-tracker5/lib:/usr/share/request-tracker5/lib",
 "rt_home": "/usr/share/request-tracker5",
 "rt_lib": "/usr/share/request-tracker5/lib/RT",
 "server_name": "rt.internal.example.com",
 "ssl_redirect_host": "https://rt.internal.example.com",
 "use_ssl": true,
 "web_path": "rt"
}
