# OpenStack Designate Configuration
# This file configures the Designate DNS-as-a-Service components:
# Central API, Worker, Producer, mDNS, and API gateway.
# It uses INI-style sections and key-value pairs.

[DEFAULT]
# Enable debug mode for verbose logging (not recommended for production)
# debug = {{ debug | default(false) | lower }}

# Logging level for the service (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# log_level = {{ log_level | default('INFO') | upper }}

# Path to the log file. Leave empty to log to stdout only
# log_file = {{ log_file | default('') }}

# IP address to bind the central API server
# bind_host = {{ bind_host | default('0.0.0.0') }}

# Port number for the central API server
# api_port = {{ api_port | default(9001) }}

# Number of worker processes for the central service
# workers = {{ workers | default(1) }}

# Maximum number of tasks that can be processed concurrently by the task manager
# task_manager_max_concurrent_tasks = {{ task_manager_max_concurrent_tasks | default(10) }}

# DNS backend driver. Common values: 'designate-mdns', 'dnsdist', 'nsd', 'bind9'
# backend_driver = {{ backend_driver | default('designate-mdns') }}

# Hostname or IP address of the Redis server used for coordination
# redis_host = {{ redis_host | default('localhost') }}

# Port of the Redis server
# redis_port = {{ redis_port | default(6379) }}

# Default TTL (Time To Live) for new DNS zones and records (seconds)
# default_ttl = {{ default_ttl | default(3600) }}

# Default SOA serial number format: YYYYMMDDnn
# default_serial = {{ default_serial | default(1) }}

# Database connection string (replace username/password/DB with production values)
# connection = {{ db_connection | default('mysql+pymysql://designate:password@localhost/designate') }}

# Authentication strategy for the API. Common: 'keystone', 'none'
# auth_strategy = {{ auth_strategy | default('keystone') }}

# List of CIDR blocks allowed to perform AXFR requests (comma-separated in config)
# allowed_axfr_cidrs = {{ allowed_axfr_cidrs | default(['127.0.0.1/32']) | join(', ') }}

# List of allowed origins for CORS (comma-separated in config)
# cors_allowed_origins = {{ cors_allowed_origins | default([]) | join(', ') }}

# List of RabbitMQ/Kafka topics to consume notifications from
# notification_topics = {{ notification_topics | default(['notifications']) | join(', ') }}

# Database backend connection
[storage:sqlalchemy]
# Database connection string (use placeholder for secrets)
# connection = {{ db_connection | default('mysql+pymysql://designate:password@localhost/designate') }}

[service:central]
# Enable the designate-central service
# enabled = {{ central_enabled | default(true) | lower }}

# Maximum number of DNS records allowed per zone
# max_records_per_zone = {{ max_records_per_zone | default(1000) }}

# Maximum number of DNS zones allowed per tenant
# max_zones_per_tenant = {{ max_zones_per_tenant | default(100) }}

# Regular expression for validating zone names
# zone_name_regex = {{ zone_name_regex | default('^(([a-zA-Z0-9_\\-]*\\.)+[a-zA-Z]{2,})$') }}

[pool_manager_cache]
# Enable caching for pool manager data
# enabled = {{ pool_manager_cache_enabled | default(true) | lower }}

# TTL for pool manager cache entries (seconds)
# ttl = {{ pool_manager_cache_ttl | default(60) }}

[service:worker]
# Enable the worker service
# enabled = {{ worker_enabled | default(true) | lower }}

# Number of worker threads for the worker service
# workers = {{ worker_threads | default(1) }}

[service:producer]
# Enable the producer service
# enabled = {{ producer_enabled | default(true) | lower }}

[service:mdns]
# Enable the mDNS service
# enabled = {{ mdns_enabled | default(true) | lower }}

# IP address to bind the mDNS service
# bind_host = {{ mdns_bind_host | default('0.0.0.0') }}

# Port for the mDNS service
# bind_port = {{ mdns_bind_port | default(5354) }}

# List of CIDR blocks allowed to perform AXFR requests (comma-separated in config)
# allowed_axfr_cidrs = {{ allowed_axfr_cidrs | default(['127.0.0.1/32']) | join(', ') }}

[service:api]
# Enable the designate-api service
# enabled = {{ api_enabled | default(true) | lower }}

# IP address to bind the API server
# bind_host = {{ bind_host | default('0.0.0.0') }}

# Port number for the central API server
# bind_port = {{ api_port | default(9001) }}

# Number of worker processes for the API service
# workers = {{ api_workers | default(1) }}

# Public base URI for the API (used for self-referential links)
# api_base_uri = {{ api_base_uri | default('http://localhost:9001/v2') }}

# Authentication strategy for the API. Common: 'keystone', 'none'
# auth_strategy = {{ auth_strategy | default('keystone') }}

# Enable Cross-Origin Resource Sharing (CORS)
# enable_cors = {{ cors_enabled | default(false) | lower }}

# List of allowed origins for CORS (comma-separated in config)
# cors_allowed_origin = {{ cors_allowed_origins | default([]) | join(', ') }}

{% if endpoint_templates is defined and endpoint_templates | length > 0 %}
[service:api:endpoint_templates]
# Endpoint templates for DNS API endpoints (used by Keystone federation)
{% for ep in endpoint_templates %}
# Endpoint template for service: {{ ep.service_name }}
# service_name = {{ ep.service_name }}
# endpoint_template = {{ ep.endpoint_template }}
{% endfor %}
{% endif %}

{% if pool_servers is defined and pool_servers | length > 0 %}
# Pool servers configuration
{% for server in pool_servers %}
# Server {{ loop.index }}: {{ server.hostname if server.hostname is defined else 'unknown' }}
# nameserver = {{ server.nameserver }}
# host = {{ server.host }}
# port = {{ server.port }}
# pool_id = {{ server.pool_id }}
{% endfor %}
{% endif %}

[notifications]
# Notification driver to use (e.g., 'designate', 'nova', 'neutron')
# driver = {{ notification_driver | default('designate') }}

# Topics to listen on (comma-separated)
# topics = {{ notification_topics | default(['notifications']) | join(', ') }}

[service:worker:resolver]
# IP address of the resolver to use for health checks
# resolver_ip = {{ resolver_ip | default('127.0.0.1') }}

# Port the resolver listens on
# resolver_port = {{ resolver_port | default(53) }}

# Timeout in seconds for resolver queries
# resolver_timeout = {{ resolver_timeout | default(10) }}

{% if pools is defined and pools | length > 0 %}
# DNS pool configuration (e.g., for multi-backend support)
{% for pool in pools %}
# Pool: {{ pool.name if pool.name is defined else pool.id }}
# id = {{ pool.id }}
# name = {{ pool.name }}
# description = {{ pool.description }}
{% if pool.ns_records is defined %}
# ns_records = {{ pool.ns_records | map(attribute='hostname') | join(', ') }}
{% endif %}
{% if pool.nameservers is defined %}
# nameservers = {{ pool.nameservers | map(attribute='hostname') | join(', ') }}
{% endif %}
{% endfor %}
{% endif %}

{% if zones is defined and zones | length > 0 %}
# Zone-specific defaults (reference only)
{% for zone in zones %}
# Zone: {{ zone.name }}
# default_ttl = {{ zone.default_ttl }}
# retry_refresh = {{ zone.retry_refresh }}
# minimum = {{ zone.minimum }}
# refresh = {{ zone.refresh }}
# retry = {{ zone.retry }}
# expire = {{ zone.expire }}
# negative_ttl = {{ zone.negative_ttl }}
{% endfor %}
{% endif %}