{
  "interface": "socket",
  "tpm_version": "2.0",
  "daemonize": true,
  "tpmstate_dir": "/var/lib/swtpm/tpm2",
  "tpmstate_dir_mode": "0750",
  "log_file": "/var/log/swtpm/swtpm.log",
  "log_level": 1,
  "log_prefix": "swtpm: ",
  "log_truncate": false,
  "socket_port": 2321,
  "server_config": "type=tcp,bindaddr=127.0.0.1,disconnect",
  "ctrl_config": "type=unixio,path=/run/swtpm/swtpm-tpm0,mode=0770",
  "chardev_path": "/dev/tpm0",
  "vtpm_proxy": false,
  "cuse_name": "swtpm0",
  "cuse_maj": 10,
  "cuse_min": 226,
  "pid_file": "/run/swtpm/swtpm-tpm0.pid",
  "runas": "swtpm",
  "seccomp_action": "kill",
  "flags": "not-need-init,startup-clear",
  "locality": "reject-locality-4"
}
