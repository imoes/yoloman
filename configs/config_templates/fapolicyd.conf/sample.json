{
  "debug_enabled": false,
  "log_file_path": "/var/log/fapolicyd.log",
  "log_file_max": 5,
  "log_file_size": 10240,
  "watched_dirs": [
    "/bin",
    "/sbin",
    "/usr/bin",
    "/usr/sbin",
    "/usr/local/bin",
    "/usr/local/sbin",
    "/opt"
  ],
  "rule_allow_logging": true,
  "rule_deny_logging": true,
  "rule_enforce": true,
  "trust_default_trust": true,
  "trust_paths": [
    "/bin",
    "/sbin",
    "/usr/bin",
    "/usr/sbin",
    "/usr/local/bin",
    "/usr/local/sbin",
    "/lib",
    "/lib64",
    "/usr/lib",
    "/usr/lib64"
  ],
  "kernel_block_unsigned_modules": true,
  "network_log_connections": true,
  "network_block_outbound": false,
  "resources_max_fds": 65535,
  "resources_max_watches": 524288,
  "server_workers": 0,
  "server_foreground": false,
  "server_pid_file": "/run/fapolicyd.pid",
  "backend_use_audit": true,
  "order_rule_files": [
    "fapolicyd.rules"
  ],
  "included_files": []
}
