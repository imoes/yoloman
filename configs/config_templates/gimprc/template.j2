(default-image
  (width {{ default_image.width }})
  (height {{ default_image.height }})
  (unit {{ default_image.unit }})
  (xresolution {{ default_image.xresolution }})
  (yresolution {{ default_image.yresolution }})
  (resolution-unit {{ default_image.resolution_unit }})
  (image-type {{ default_image.image_type }})
  (precision {{ default_image.precision }})
  (color-managed {{ 'yes' if default_image.color_managed else 'no' }})
