{
  "temp_path": "/tmp",
  "swap_path": "/tmp/gimp-swap",
  "swap_compression": "medium",
  "num_processors": 4,
  "tile_cache_size": "2G",
  "use_opencl": true,
  "interpolation_type": "cubic",
  "default_threshold": 15,
  "plug_in_path": [
    "~/.local/share/gimp/2.0/plug-ins",
    "/usr/lib/gimp/2.0/plug-ins"
  ],
  "module_path": [
    "~/.local/share/gimp/2.0/modules",
    "/usr/lib/gimp/2.0/modules"
  ],
  "interpreter_path": [
    "~/.local/share/gimp/2.0/interpreters",
    "/usr/lib/gimp/2.0/interpreters"
  ],
  "environ_path": [
    "~/.local/share/gimp/2.0/environ",
    "/usr/lib/gimp/2.0/environ"
  ],
  "brush_path": [
    "~/.local/share/gimp/2.0/brushes",
    "/usr/share/gimp/2.0/brushes"
  ],
  "brush_path_writable": [
    "~/.local/share/gimp/2.0/brushes"
  ],
  "dynamics_path": [
    "~/.local/share/gimp/2.0/dynamics",
    "/usr/share/gimp/2.0/dynamics"
  ],
  "dynamics_path_writable": [
    "~/.local/share/gimp/2.0/dynamics"
  ],
  "mypaint_brush_path": [
    "/usr/share/mypaint-data/1.0/brushes",
    "~/.mypaint/brushes"
  ],
  "mypaint_brush_path_writable": [
    "~/.mypaint/brushes"
  ],
  "pattern_path": [
    "~/.local/share/gimp/2.0/patterns",
    "/usr/share/gimp/2.0/patterns"
  ],
  "pattern_path_writable": [
    "~/.local/share/gimp/2.0/patterns"
  ],
  "palette_path": [
    "~/.local/share/gimp/2.0/palettes",
    "/usr/share/gimp/2.0/palettes"
  ],
  "palette_path_writable": [
    "~/.local/share/gimp/2.0/palettes"
  ],
  "gradient_path": [
    "~/.local/share/gimp/2.0/gradients",
    "/usr/share/gimp/2.0/gradients"
  ],
  "gradient_path_writable": [
    "~/.local/share/gimp/2.0/gradients"
  ],
  "tool_preset_path": [
    "~/.local/share/gimp/2.0/tool-presets",
    "/usr/share/gimp/2.0/tool-presets"
  ],
  "tool_preset_path_writable": [
    "~/.local/share/gimp/2.0/tool-presets"
  ],
  "font_path": [
    "~/.local/share/gimp/2.0/fonts",
    "/usr/share/fonts"
  ],
  "default_brush": "2. Hardness 050",
  "default_dynamics": "Dynamics Off",
  "default_mypaint_brush": "Fixme",
  "default_pattern": "Pine",
  "default_palette": "Default",
  "default_gradient": "FG to BG (RGB)",
  "default_tool_preset": "Current Options",
  "default_font": "Sans-serif",
  "global_brush": false,
  "global_dynamics": false,
  "global_pattern": false,
  "global_palette": false,
  "global_gradient": false,
  "global_font": false,
  "default_image": {
    "width": 1920,
    "height": 1080,
    "unit": "pixels",
    "xresolution": 300,
    "yresolution": 300,
    "resolution_unit": "inches",
    "image_type": "rgb",
    "precision": "u8-gamma",
    "color_managed": true,
    "color_profile": null,
    "fill_type": "background",
    "comment": "Created with GIMP"
  },
  "default_grid": {
    "style": "solid",
    "fgcolor": [
      0,
      0,
      0,
      1
    ],
    "bgcolor": [
      1,
      1,
      1,
      1
    ],
    "xspacing": 10,
    "yspacing": 10,
    "spacing_unit": "inches",
    "xoffset": 0,
    "yoffset": 0,
    "offset_unit": "inches"
  },
  "undo_levels": 50,
  "undo_size": "1G",
  "undo_preview_size": "medium",
  "plug_in_history_size": 15,
  "pluginrc_path": "~/.config/GIMP/2.10/pluginrc",
  "layer_previews": true,
  "group_layer_previews": true,
  "layer_preview_size": "medium",
  "thumbnail_size": "normal",
  "thumbnail_filesize_limit": "8M",
  "color_management": {
    "mode": "display",
    "display_profile_from_gdk": false,
    "display_rendering_intent": "relative-colorimetric",
    "display_use_black_point_compensation": true,
    "display_optimize": true,
    "simulation_rendering_intent": "perceptual",
    "simulation_use_black_point_compensation": false,
    "simulation_optimize": true,
    "simulation_gamut_check": false,
    "out_of_gamut_color": [
      1,
      0,
      1
    ],
    "show_rgb_u8": false,
    "show_hsv": false,
    "display_module": "CdisplayLcms"
  },
  "save_document_history": true,
  "quick_mask_color": [
    1,
    0,
    0,
    0.5
  ],
  "import_promote_float": false,
  "import_promote_dither": true,
  "import_add_alpha": false,
  "import_raw_plug_in": "",
  "export_file_type": "png",
  "export_color_profile": true,
  "export_metadata_exif": true,
  "export_metadata_xmp": true,
  "export_metadata_iptc": true,
  "debug_policy": "fatal",
  "check_updates": true,
  "transparency_size": "medium-checks",
  "transparency_type": "gray-checks",
  "snap_distance": 8,
  "marching_ants_speed": 200,
  "resize_windows_on_zoom": false,
  "resize_windows_on_resize": false,
  "default_show_all": true,
  "default_dot_for_dot": false,
  "initial_zoom_to_fit": true,
  "cursor_mode": "tool-crosshair",
  "cursor_updating": true,
  "show_brush_outline": true,
  "snap_brush_outline": false,
  "show_paint_tool_cursor": true,
  "image_title_format": "%D*%f-%p.%i (%t, %o, %L) %wx%h"
}