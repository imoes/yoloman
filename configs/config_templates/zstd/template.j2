#!/usr/bin/env bash
# ==============================================================================
# zstd compression script configuration
# Generated by Ansible Jinja2 engine
#
# This script configures the zstd command-line tool to compress files or directories
# based on the provided schema fields. It is self-documenting: every option is
# commented with its source description and corresponding zstd flag.
# ==============================================================================

# --compression-level=LEVEL: Compression level from 1 to 19. Higher levels increase
# ratio but decrease speed. Maps to -# option.
zstd --compression-level={{ compression_level | default(3) }} \
# --threads=N: Number of worker threads. 0 attempts to detect physical CPU cores.
# Maps to -T# option.
-T {{ threads | default(1) }} \
# --content-size or --checksum: Add integrity check (XXH64) to the compressed frame.
# Maps to -C flag. Enabled if true.
{% if integrity_check | default(true) %}
-C \
{% endif %}
# --rm: Keep source file after successful compression.
# Maps to -k flag. Enabled if true.
{% if keep_source | default(true) %}
-k \
{% endif %}
# --output-dir-flat=DIR: Directory to store resulting files. If empty, defaults
# to source directory.
# If the variable is empty, this line is omitted to let zstd use the default.
{% if output_dir | default('') %}
--output-dir-flat {{ output_dir | default('') }} \
{% endif %}
# --recursive: Operate recursively on directories if input is a directory.
# Maps to -r flag. Enabled if true.
{% if recursive | default(false) %}
-r \
{% endif %}
# -- List of files or directories to compress.
# Iterates over the 'files' list from the schema.
{% for file in files | default([]) %}
{{ file }} \
{% endfor %}