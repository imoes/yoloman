{
  "sock_paths": [
    "/run/gssproxy.sock"
  ],
  "debug_level": 1,
  "use_socket_activation": true,
  "ccache_timeout": 600,
  "ecosystem_enabled": true,
  "mechanisms": [
    {
      "name": "krb5",
      "oid": "1.2.840.113554.1.2.2",
      "keytab": "/etc/krb5.keytab",
      "ccache": "FILE:/run/gssproxy.d/krb5_ccache",
      "allowed_enctypes": [
        "aes256-cts-hmac-sha1-96",
        "aes128-cts-hmac-sha1-96"
      ],
      "server_principal": "host/server.example.com@EXAMPLE.COM",
      "credentials_cache": "FILE:/run/gssproxy.d/krb5_ccache"
    }
  ],
  "emulated_principals": [
    {
      "principal": "nfs@LEGACY.REALM",
      "target": "nfs@EXAMPLE.COM"
    }
  ],
  "trusted_principals": [
    "root@EXAMPLE.COM",
    "nfs@EXAMPLE.COM"
  ],
  "trusted_dirs": [
    "/etc/gssproxy",
    "/var/lib/gssproxy"
  ]
}
