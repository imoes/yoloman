{
  "name": "web-vm-01",
  "uuid": "123e4567-e89b-12d3-a456-426614174000",
  "domain_type": "kvm",
  "memory_unit": "MiB",
  "memory_size": 4096,
  "vcpu_count": 2,
  "vcpu_placement": "static",
  "boot_options": {
    "architecture": "x86_64",
    "machine": "pc-q35-8.2",
    "machine_type": "hvm",
    "bootdevs": [
      "hd",
      "cdrom",
      "network"
    ]
  },
  "features": {
    "acpi": true,
    "apic": true,
    "pae": false
  },
  "cpu": {
    "mode": "host-model",
    "check": "partial",
    "model": {
      "name": "Haswell",
      "fallback": "allow"
    },
    "topology": {
      "sockets": 1,
      "cores": 2,
      "threads": 1
    }
  },
  "clock": {
    "offset": "utc",
    "timer": [
      {
        "name": "tsc",
        "present": "yes"
      },
      {
        "name": "kvmclock",
        "present": "yes"
      },
      {
        "name": "rtc",
        "present": "yes",
        "mode": "wall"
      }
    ]
  },
  "lifecycle": {
    "on_poweroff": "destroy",
    "on_reboot": "restart",
    "on_crash": "restart"
  },
  "graphics": {
    "type": "spice",
    "port": "-1",
    "autoport": "yes",
    "listen": "0.0.0.0",
    "websocket": "6080",
    "image_compression": "auto_lz",
    "jpeg_compression": "auto",
    "zlib_compression": "auto"
  },
  "video": {
    "model": "qxl",
    "vram": 65536,
    "heads": 1
  },
  "nics": [
    {
      "type": "network",
      "source": "default",
      "model": "virtio"
    }
  ],
  "disks": [
    {
      "type": "file",
      "device": "disk",
      "driver_type": "qcow2",
      "cache_mode": "writeback",
      "discard": "unmap",
      "source": {
        "file": "/var/lib/libvirt/images/web-vm-01.qcow2"
      },
      "target": {
        "dev": "vda",
        "bus": "virtio"
      }
    }
  ],
  "rng": {
    "model": "virtio",
    "backend": {
      "model": "random",
      "source": "/dev/urandom"
    }
  },
  "metadata": "<custom:info xmlns:custom='http://example.com/meta'>\n  <owner>ops-team</owner>\n  <project>production-web</project>\n</custom:info>"
}
