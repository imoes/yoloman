{
  "time_format": "%H:%M:%S",
  "date_format": "%d/%b/%Y",
  "time_zone": "UTC",
  "daemon_mode": false,
  "output_html": true,
  "ssl_cert": "/etc/ssl/certs/goaccess.crt",
  "ssl_key": "/etc/ssl/private/goaccess.key",
  "log_file": "/var/log/nginx/access.log",
  "ignore_search_engine": false,
  "geoip_database": "",
  "output_json": false
}
