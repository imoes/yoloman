{
  "output_html": true,
  "output_json": false,
  "output_csv": false,
  "output_tsv": false,
  "daemon_mode": true,
  "use_syslog": false,
  "time_zone": "UTC",
  "log_format": "%h %^[%d:%^] \"%r\" %s %b \"%R\" \"%u\"",
  "log_file": "/var/log/nginx/access.log",
  "html_output_path": "/var/www/goaccess/index.html",
  "json_output_path": "",
  "csv_output_path": "",
  "tsv_output_path": "",
  "ws_server": "127.0.0.1:7890",
  "ws_ssl": false,
  "ssl_cert": "",
  "ssl_key": "",
  "geoip_database": "/usr/share/GeoIP/GeoLite2-Country.mmdb",
  "real_time_refresh": 10,
  "ignore_referer_list": [
    "internal.example.com",
    "cdn.example.com"
  ],
  "ignore_search_engine": true,
  "ignore_static_extensions": [
    "png",
    "jpg",
    "gif",
    "css",
    "js",
    "ico",
    "woff"
  ],
  "date_format": "%d/%b/%Y",
  "time_format": "%H:%M:%S",
  "http_methods": "GET,POST",
  "http_status_codes": [
    "200",
    "301",
    "302",
    "404"
  ],
  "color_scheme": true,
  "html_terminal": true,
  "mouse_support": false,
  "top_lines": 20,
  "report_title": "Nginx Analytics",
  "virtual_host": true,
  "skip_log_regex_list": [
    "/health",
    "/status"
  ],
  "ignore_ips": [
    "127.0.0.1",
    "::1",
    "10.0.0.0/8"
  ],
  "real_ip": true,
  "custom_404_page": "",
  "hide_requests": false,
  "log_level": 1,
  "debug_log": ""
}
