<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE NXKeystroke>
<!--
  X2Go Agent Keystroke Configuration
  ==================================
  This template defines the keybindings for the X2Go agent.
  Each entry corresponds to a specific action (e.g., close session, switch screens).
  The modifiers (Control, AltMeta, Shift) are boolean flags (1 or 0),
  and 'key' is the physical key or symbolic name (e.g., 'Left', 'BackSpace').
-->
<keystrokes>
  {# -------------------------------------------------------------------------- #}
  {# Action: Close the current X2Go session                                       #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="close_session"
             Control="{{ keystroke_close_session_control | default('1') }}"
             AltMeta="{{ keystroke_close_session_altmeta | default('1') }}"
             key="{{ keystroke_close_session_key | default('t') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Switch between all open X2Go screens                                 #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="switch_all_screens"
             Control="{{ keystroke_switch_all_screens_control | default('1') }}"
             AltMeta="{{ keystroke_switch_all_screens_altmeta | default('1') }}"
             key="{{ keystroke_switch_all_screens_key | default('f') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Minimize the current window                                          #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="minimize"
             Control="{{ keystroke_minimize_control | default('1') }}"
             AltMeta="{{ keystroke_minimize_altmeta | default('1') }}"
             key="{{ keystroke_minimize_key | default('m') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Resize the current window                                            #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="resize"
             Control="{{ keystroke_resize_control | default('1') }}"
             AltMeta="{{ keystroke_resize_altmeta | default('1') }}"
             key="{{ keystroke_resize_key | default('r') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Defer/Postpone an action                                             #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="defer"
             Control="{{ keystroke_defer_control | default('1') }}"
             AltMeta="{{ keystroke_defer_altmeta | default('1') }}"
             key="{{ keystroke_defer_key | default('e') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Ignore the next input event                                          #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="ignore"
             Control="{{ keystroke_ignore_control | default('1') }}"
             AltMeta="{{ keystroke_ignore_altmeta | default('1') }}"
             key="{{ keystroke_ignore_key | default('BackSpace') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Force synchronization of the display                                 #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="force_synchronization"
             Control="{{ keystroke_force_synchronization_control | default('1') }}"
             AltMeta="{{ keystroke_force_synchronization_altmeta | default('1') }}"
             key="{{ keystroke_force_synchronization_key | default('j') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Debug the tree structure of windows                                  #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="debug_tree"
             Control="{{ keystroke_debug_tree_control | default('1') }}"
             AltMeta="{{ keystroke_debug_tree_altmeta | default('1') }}"
             key="{{ keystroke_debug_tree_key | default('q') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Show regions on the screen                                           #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="regions_on_screen"
             Control="{{ keystroke_regions_on_screen_control | default('1') }}"
             AltMeta="{{ keystroke_regions_on_screen_altmeta | default('1') }}"
             key="{{ keystroke_regions_on_screen_key | default('a') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Test input device functionality                                      #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="test_input"
             Control="{{ keystroke_test_input_control | default('1') }}"
             AltMeta="{{ keystroke_test_input_altmeta | default('1') }}"
             key="{{ keystroke_test_input_key | default('x') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Deactivate input devices grab (release mouse/keyboard capture)       #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="deactivate_input_devices_grab"
             Control="{{ keystroke_deactivate_input_devices_grab_control | default('1') }}"
             AltMeta="{{ keystroke_deactivate_input_devices_grab_altmeta | default('1') }}"
             key="{{ keystroke_deactivate_input_devices_grab_key | default('y') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Toggle fullscreen mode                                               #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="fullscreen"
             Control="{{ keystroke_fullscreen_control | default('1') }}"
             Shift="{{ keystroke_fullscreen_shift | default('1') }}"
             AltMeta="{{ keystroke_fullscreen_altmeta | default('1') }}"
             key="{{ keystroke_fullscreen_key | default('f') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Move the viewport to the left                                        #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="viewport_move_left"
             Control="{{ keystroke_viewport_move_left_control | default('1') }}"
             Shift="{{ keystroke_viewport_move_left_shift | default('1') }}"
             AltMeta="{{ keystroke_viewport_move_left_altmeta | default('1') }}"
             key="{{ keystroke_viewport_move_left_key | default('Left') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Move the viewport upwards                                            #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="viewport_move_up"
             Control="{{ keystroke_viewport_move_up_control | default('1') }}"
             AltMeta="{{ keystroke_viewport_move_up_altmeta | default('1') }}"
             key="{{ keystroke_viewport_move_up_key | default('Up') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Move the viewport to the right                                       #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="viewport_move_right"
             Control="{{ keystroke_viewport_move_right_control | default('1') }}"
             AltMeta="{{ keystroke_viewport_move_right_altmeta | default('1') }}"
             key="{{ keystroke_viewport_move_right_key | default('Right') }}" />

  {# -------------------------------------------------------------------------- #}
  {# Action: Move the viewport downwards                                          #}
  {# -------------------------------------------------------------------------- #}
  <keystroke action="viewport_move_down"
             Control="{{ keystroke_viewport_move_down_control | default('1') }}"
             AltMeta="{{ keystroke_viewport_move_down_altmeta | default('1') }}"
             key="{{ keystroke_viewport_move_down_key | default('Down') }}" />
</keystrokes>
