{
  "global_enabled": true,
  "log_level": "info",
  "log_dir": "/var/log/ovn",
  "pid_file": "/run/ovn/ovn-ic.pid",
  "sb_db_connection": "unix:///var/run/ovn/ovnsb_db.sock",
  "sb_connection_timeout": 15,
  "sb_connection_retry_interval": 5,
  "nb_db_connection": "unix:///var/run/ovn/ovnnb_db.sock",
  "nb_connection_timeout": 15,
  "nb_connection_retry_interval": 5,
  "ic_enabled": true,
  "region_id": "region-east",
  "chassis_id": "chassis-east-01",
  "external_ids": {
    "ovn-ic-chassis-hostname": "compute-node-1.example.com",
    "provider": "aws",
    "zone": "us-east-1a"
  },
  "interconnection_peers": [
    {
      "name": "peer-west",
      "region_name": "region-west",
      "connection": "tcp:10.10.20.1:6641",
      "bidirectional": true
    },
    {
      "name": "peer-eu",
      "region_name": "region-eu",
      "connection": "tcp:10.20.30.2:6641",
      "bidirectional": false
    }
  ]
}
