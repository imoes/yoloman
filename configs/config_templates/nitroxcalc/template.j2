# ==============================================================================
# Nitroxcalc Configuration File
# ==============================================================================
# This file configures the Nitroxcalc diving calculator application.
# It sets default parameters for nitrox gas mixes, depth limits, and output formatting.
# All variables are sourced from Ansible inventory/vars with safe fallbacks.
# ==============================================================================

# ------------------------------------------------------------------------------
# Default Oxygen Percentage
# ------------------------------------------------------------------------------
# Description: Default oxygen percentage for nitrox mixes (e.g., 32 for Nitrox 32).
# Range: Typically between 21 (air) and 40+ (rich nitrox), depending on safety limits.
# Default: 32
default_o2_pct {{ default_o2_pct | default(32) }}

# ------------------------------------------------------------------------------
# Default Nitrogen Percentage
# ------------------------------------------------------------------------------
# Description: Default nitrogen percentage, usually complementary to oxygen.
# Note: Nitroxcalc calculates this dynamically, but allows an explicit default for display presets.
# Default: 68
default_n2_pct {{ default_n2_pct | default(68) }}

# ------------------------------------------------------------------------------
# Default Maximum Operating Depth (MOD)
# ------------------------------------------------------------------------------
# Description: Default Maximum Operating Depth in meters.
# Note: This is the depth limit based on partial oxygen pressure limits.
# Default: 30
default_mod_meters {{ default_mod_meters | default(30) }}

# ------------------------------------------------------------------------------
# Output Format
# ------------------------------------------------------------------------------
# Description: Preferred output format for calculations.
# Valid values: 'text', 'json', 'html'.
# Default: 'text'
output_format "{{ output_format | default('text') }}"