{
  # UUID of the backup device to use for snapshots.
  "backup_device_uuid": "{{ backup_device_uuid | default('') }}",

  # UUID of the parent device for Btrfs send/receive operations.
  "parent_device_uuid": "{{ parent_device_uuid | default('') }}",

  # Whether to run the first-time setup wizard.
  "do_first_run": "{{ do_first_run | default(true) | lower }}",

  # Enable Btrfs snapshot mode.
  "btrfs_mode": "{{ btrfs_mode | default(false) | lower }}",

  # Include /home in Btrfs snapshots.
  "include_btrfs_home": "{{ include_btrfs_home | default(false) | lower }}",

  # Stop cron emails during snapshot creation.
  "stop_cron_emails": "{{ stop_cron_emails | default(true) | lower }}",

  # Schedule monthly snapshots.
  "schedule_monthly": "{{ schedule_monthly | default(false) | lower }}",

  # Schedule weekly snapshots.
  "schedule_weekly": "{{ schedule_weekly | default(false) | lower }}",

  # Schedule daily snapshots.
  "schedule_daily": "{{ schedule_daily | default(false) | lower }}",

  # Schedule hourly snapshots.
  "schedule_hourly": "{{ schedule_hourly | default(false) | lower }}",

  # Schedule snapshots on boot.
  "schedule_boot": "{{ schedule_boot | default(false) | lower }}",

  # Number of monthly snapshots to keep.
  "count_monthly": "{{ count_monthly | default(2) }}",

  # Number of weekly snapshots to keep.
  "count_weekly": "{{ count_weekly | default(3) }}",

  # Number of daily snapshots to keep.
  "count_daily": "{{ count_daily | default(5) }}",

  # Number of hourly snapshots to keep.
  "count_hourly": "{{ count_hourly | default(6) }}",

  # Number of boot snapshots to keep.
  "count_boot": "{{ count_boot | default(5) }}",

  # Maximum size of a single snapshot in MB. 0 means unlimited.
  "snapshot_size": "{{ snapshot_size | default(0) }}",

  # Maximum number of snapshots to keep. 0 means unlimited.
  "snapshot_count": "{{ snapshot_count | default(0) }}",

  # List of paths or patterns to exclude from snapshots.
  "exclude": {{ exclude | default([]) | tojson }},

  # List of application names to exclude from snapshots.
  "exclude-apps": {{ exclude_apps | default([]) | tojson }}
}
