{
  "main": {
    "port": 6522,
    "max_connections": 8,
    "verbose": true,
    "pidfile": "/var/run/mactelnetd.pid",
    "tls_private_key": "/etc/mactelnet/tls/key.pem",
    "tls_certificate": "/etc/mactelnet/tls/cert.pem",
    "allowed_macs": [
      "00:11:22:33:44:55",
      "aa:bb:cc:dd:ee:ff"
    ],
    "session_timeout": 600,
    "root_dir": "/data/telnet"
  },
  "users": [
    {
      "name": "admin",
      "password": "secret123",
      "gid": 100
    },
    {
      "name": "guest",
      "password": "guestpass"
    }
  ]
}
