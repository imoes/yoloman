{
  "host_name": "magnum-conductor-1",
  "conductor_workers": 2,
  "bind_host": "192.168.10.50",
  "bind_port": 9511,
  "ca_file": "/etc/magnum/ssl/magnum-ca.crt",
  "cert_file": "/etc/magnum/ssl/magnum.crt",
  "key_file": "/etc/magnum/ssl/private/magnum.key",
  "enable_tls": true,
  "database_connection": "mysql+pymysql://magnum_db_user:secretpass123@db.example.com/magnum_db",
  "keystone_auth_url": "https://keystone.prod.example.com:5000/v3",
  "keystone_admin_domain_name": "Default",
  "keystone_admin_user": "magnum",
  "keystone_admin_password": "magnum_secret_password",
  "keystone_admin_project_name": "service",
  "keystone_region_name": "RegionOne",
  "cert_manager": "barbican",
  "temp_dir": "/var/lib/magnum/temp",
  "cluster_template_defaults": [
    {
      "name": "coe",
      "value": "kubernetes"
    },
    {
      "name": "image_id",
      "value": "fedora-atomic-38-latest"
    },
    {
      "name": "flavor_id",
      "value": "c1.small"
    },
    {
      "name": "master_flavor_id",
      "value": "c1.medium"
    },
    {
      "name": "network_driver",
      "value": "calico"
    },
    {
      "name": "container_runtime",
      "value": "containerd"
    }
  ],
  "docker_storage_driver": [
    "overlay2"
  ],
  "default_docker_storage_driver": "overlay2",
  "transport_url": "rabbit://magnum:mqpass123@rabbitmq.prod.example.com:5672/",
  "trustee_domain_id": "default",
  "trustee_domain_admin": "magnum_trustee_admin",
  "trustee_domain_admin_password": "trustee_admin_secret",
  "keystone_endpoint_type": "internal",
  "ca_valid_time": 7300,
  "cert_valid_time": 365,
  "renew_time": 45,
  "cluster_create_timeout": 90,
  "enable_barbican": true
}
