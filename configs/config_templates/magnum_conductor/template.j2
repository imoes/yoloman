[DEFAULT]
# The name of this node (conductor node) in the cluster.
#host_name = {{ host_name }}

# Number of workers for the conductor service.
#conductor_workers = {{ conductor_workers }}

# Listen address for the conductor API.
#bind_host = {{ bind_host }}

# Port on which the conductor listens.
#bind_port = {{ bind_port }}

# Path to the CA certificate file for TLS.
#ca_file = {{ ca_file }}

# Path to the server certificate file for TLS.
#cert_file = {{ cert_file }}

# Path to the private key file for TLS.
#key_file = {{ key_file }}

# Enable TLS for the conductor API.
#enabled = {{ enable_tls | lower }}

[database]
# Connection string for the backend database.
#connection = {{ database_connection }}

[keystone]
# Auth URL for Keystone (v3 endpoint).
#auth_url = {{ keystone_auth_url }}

# Domain name for Keystone admin user.
#admin_domain_name = {{ keystone_admin_domain_name }}

# Admin username for Keystone.
#admin_user = {{ keystone_admin_user }}

# Admin password for Keystone.
#admin_password = {{ keystone_admin_password }}

# Admin project name for Keystone.
#admin_project_name = {{ keystone_admin_project_name }}

# Region name for Keystone.
#region_name = {{ keystone_region_name }}

[magnum]
# Path to the directory containing certificates used by Magnum.
#cert_manager = {{ cert_manager }}

# Path to the directory for temporary certificates.
#temp_dir = {{ temp_dir }}

# Cluster template defaults.
{% for template_default in cluster_template_defaults %}
# Default {{ template_default.name }} for new cluster templates.
#default_{{ template_default.name | replace(' ', '_') | lower }} = {{ template_default.value }}
{% endfor %}

# Supported Docker storage drivers.
#docker_storage_driver = {{ docker_storage_driver | join(', ') }}

# Default Docker storage driver.
#default_docker_storage_driver = {{ default_docker_storage_driver }}

[oslo_messaging]
# RPC backend for Magnum conductor.
#transport_url = {{ transport_url }}

[trust]
# Trustee domain ID for delegated access.
#trustee_domain_id = {{ trustee_domain_id }}

# Trustee user name for delegated access.
#trustee_domain_admin = {{ trustee_domain_admin }}

# Trustee password for delegated access.
#trustee_domain_admin_password = {{ trustee_domain_admin_password }}

[clients_keystone]
# Endpoint type for Keystone client.
#endpoint_type = {{ keystone_endpoint_type }}

[certificates]
# CA certificate validity in days.
#ca_valid_time = {{ ca_valid_time }}

# Certificate validity in days.
#cert_valid_time = {{ cert_valid_time }}

# Certificate renew time in days.
#renew_time = {{ renew_time }}

[cluster]
# Default timeout for cluster operations in seconds.
#cluster_create_timeout = {{ cluster_create_timeout }}

[barbican]
# Enable use of Barbican for secret storage.
#enabled = {{ enable_barbican | lower }}
