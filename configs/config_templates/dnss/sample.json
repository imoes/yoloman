{
  "listen_address": "127.0.0.1",
  "listen_port": 53,
  "upstream_resolvers": [
    {
      "name": "Cloudflare",
      "url": "https://cloudflare-dns.com/dns-query",
      "bootstrap": "1.1.1.1",
      "timeout": 8,
      "prefer_ipv6": false
    },
    {
      "name": "Google",
      "url": "https://dns.google/dns-query",
      "bootstrap": "8.8.8.8",
      "timeout": 10,
      "prefer_ipv6": true
    }
  ],
  "logging": {
    "enabled": true,
    "path": "/var/log/dnss/queries.log",
    "format": "json",
    "max_age_days": 7,
    "max_size_mb": 100
  },
  "rate_limit": {
    "enabled": true,
    "requests_per_minute": 60,
    "burst_size": 15,
    "whitelist": [
      "127.0.0.1",
      "::1",
      "192.168.0.0/16"
    ]
  },
  "cache": {
    "enabled": true,
    "size_mb": 128,
    "min_ttl": 60,
    "max_ttl": 86400
  },
  "security": {
    "block_malicious": true,
    "block_list_urls": [
      "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts",
      "https://raw.githubusercontent.com/MajkiIT/polish-ads-filter/master/polish-adblock-dns.txt"
    ],
    "dnssec": true,
    "edns_client_subnet": false
  },
  "tcp_idle_timeout": 90
}
