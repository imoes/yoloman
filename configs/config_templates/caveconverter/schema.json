{
  "input_file": {
    "type": "string",
    "default": "",
    "description": "Path to the input survey data file (e.g., 'cave.svx', 'survey.dat', 'export.txt', 'model.dxf')"
  },
  "output_file": {
    "type": "string",
    "default": "",
    "description": "Path to the output file (e.g., 'output.text', 'output.svx')"
  },
  "input_format": {
    "type": "string",
    "default": "s",
    "description": "Format code for input: 's' (Survex), 'c' (Compass), 'p' (PocketTopo text), 'd' (DXF)",
    "enum": [
      "c",
      "d",
      "p",
      "s"
    ]
  },
  "output_format": {
    "type": "string",
    "default": "t",
    "description": "Format code for output: 't' (Toporobot), 's' (Survex)",
    "enum": [
      "t",
      "s"
    ]
  },
  "lrud": {
    "type": "bool",
    "default": false,
    "description": "If true, generate LRUD (left/right/up/down) passage dimensions from splay legs"
  },
  "encoding": {
    "type": "string",
    "default": "UTF-8",
    "description": "Character encoding of input/output files (e.g., 'UTF-8', 'ISO-8859-1')",
    "enum": [
      "UTF-8",
      "UTF8"
    ],
    "enum_open": true
  }
}
