{
  "db_uri": {
    "type": "string",
    "default": "mongodb://localhost/nextepc",
    "description": "MongoDB connection URI for the HSS database."
  },
  "logger_file": {
    "type": "string",
    "default": "/var/log/nextepc/hss.log",
    "description": "Path to the HSS log file."
  },
  "logger_trace_app": {
    "type": "number",
    "default": 1,
    "description": "Enable/Disable application tracing (1=enabled, 0=disabled)."
  },
  "logger_trace_diameter": {
    "type": "number",
    "default": 1,
    "description": "Enable/Disable Diameter protocol tracing (1=enabled, 0=disabled)."
  },
  "hss_freeDiameter": {
    "type": "string",
    "default": "/etc/nextepc/freeDiameter/hss.conf",
    "description": "Path to the freeDiameter configuration file for HSS."
  }
}
