# NextEPC HSS Configuration Template
# This file configures the Home Subscriber Server (HSS) component of NextEPC.
# It defines database connectivity, logging behavior, and Diameter protocol integration.

# === Database Configuration ===
# MongoDB connection URI for the HSS database.
# This URI contains the host, port, database name, and potentially authentication details.
# Format: mongodb://[username:password@]host1[:port1][,...hostN[:portN]][/[database][?options]]
db_uri: {{ db_uri | default('mongodb://localhost/nextepc') }}

# === Logger Configuration ===
logger:
    # Path to the HSS log file.
    file: {{ logger_file | default('/var/log/nextepc/hss.log') }}
    
    # Trace settings for debugging and monitoring.
    trace: 
        # Enable/Disable application tracing.
        # 1 = enabled, 0 = disabled.
        app: {{ logger_trace_app | default('1') }}
        
        # Enable/Disable Diameter protocol tracing.
        # 1 = enabled, 0 = disabled.
        diameter: {{ logger_trace_diameter | default('1') }}

# === Parameter Block ===
# Placeholder for general parameters. Currently empty in the base schema.
parameter:

# === HSS Specific Configuration ===
hss:
    # Path to the freeDiameter configuration file for HSS.
    # This file handles the Diameter protocol stack configuration (PEERs, AVPs, etc.).
    freeDiameter: {{ hss_freeDiameter | default('/etc/nextepc/freeDiameter/hss.conf') }}
