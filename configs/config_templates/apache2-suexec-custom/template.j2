# apache2-suexec-custom configuration
# ====================================
# This file configures Apache's suexec-custom binary.
# It must contain exactly two lines (comments ignored):
# 1. The document root allowed for CGI scripts.
# 2. The user directory suffix for per-user CGI scripts.
# See the `suexec` man page for security details.

# SUEXEC_DOCROOT: Document root for suexec-allowed CGI scripts.
# All CGI scripts must reside under this directory (or its subdirectories)
# to be executed by suexec.
{{ SUEXEC_DOCROOT | default('/var/www') }}

# SUEXEC_USERDIR_SUFFIX: User directory suffix for suexec-allowed user CGI scripts.
# Defines the path suffix appended to a username's home directory to find
# their user-specific CGI scripts (e.g., /home/user/public_html/cgi-bin).
{{ SUEXEC_USERDIR_SUFFIX | default('public_html/cgi-bin') }}