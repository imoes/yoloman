# ==============================================================================
# apache2-suexec-custom configuration
# ==============================================================================
# This file is used exclusively by the `apache2-suexec-custom` package to define
# the allowed directories for CGI scripts executed under suexec.
#
# Format:
#   Line 1: Document root for suexec-allowed CGI scripts
#   Line 2: User directory suffix for suexec-allowed user CGI scripts
#
# If a line is commented out (prefixed with #), suexec will refuse the
# corresponding type of request.

# SUEXEC_DOCROOT: Document root for suexec-allowed CGI scripts.
# Default: /var/www
# This defines the base directory under which CGI scripts are allowed to run.
# Scripts outside this root will be denied by suexec.
/var/www

# SUEXEC_USERDIR_SUFFIX: User directory suffix for suexec-allowed user CGI scripts.
# Default: public_html/cgi-bin
# This defines the path suffix appended to a user's home directory (e.g., /home/user)
# to locate allowed CGI scripts (e.g., /home/user/public_html/cgi-bin).
/public_html/cgi-bin
