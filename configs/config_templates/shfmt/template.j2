# ============================================================================
# shfmt Configuration Template
# ============================================================================
# This file configures shfmt, the shell formatter.
# It is self-documenting: every option is described by the schema metadata.
# ============================================================================

# Language dialect: auto, bash, posix, mksh, bats
# Description: Specifies the shell dialect that shfmt should assume when parsing/formatting.
# Default: 'auto'
language-dialect: {{ language_dialect | default('auto') }}

# Indentation style: 0 for tabs, number for spaces
# Description: Sets the indentation size. Use 0 for tab indentation, or a positive integer for spaces.
# Default: 4
indent-size: {{ indent_size | default(4) }}

# Place binary operators on the next line
# Description: Whether binary ops like && and | start a new line instead of continuing on the current line.
# Default: False
binary-next-line: {{ binary_next_line | default(False) | lower }}

# Indent case clauses inside switch statements
# Description: Whether switch cases are indented relative to the case/switch statement.
# Default: False
case-indent: {{ case_indent | default(False) | lower }}

# Add space after redirection operators (>, <, >>)
# Description: Whether redirect operators are followed by a space for readability.
# Default: False
space-redirects: {{ space_redirects | default(False) | lower }}

# Preserve column alignment paddings
# Description: Whether to keep column alignment paddings found in the original source.
# Default: False
keep-padding: {{ keep_padding | default(False) | lower }}

# Place function opening braces on a new line
# Description: Whether function opening braces are placed on a separate line (k&r style vs same line).
# Default: False
func-next-line: {{ func_next_line | default(False) | lower }}

# List of directory patterns to ignore (relative to project root)
# Description: List of shell glob patterns or directory names to ignore during processing.
# Default: []
ignored-paths:
{% for path in (ignored_paths | default([])) %}
- {{ path }}
{% endfor %}