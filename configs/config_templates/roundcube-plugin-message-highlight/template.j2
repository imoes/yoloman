// Configuration for the Roundcube "message highlight" plugin.
// This plugin highlights messages in the message list based on subject or content rules.
// Refer to /usr/share/roundcube/plugins/message_highlight/config.inc.php-dist for the full list of options.

// Array of highlight rules. Each rule defines conditions (subject, from, to, etc.) and CSS classes/styles to apply.
// The variable is expected to be a list of associative arrays (maps).
// Example structure:
// $config['message_highlight_rules'] = [
//   ['subject' => 'urgent', 'css_class' => 'urgent-row', 'priority' => 1],
// ];
// Default is an empty array: no rules defined.
$config['message_highlight_rules'] = {{ config_message_highlight_rules | default([]) | tojson }};

