{
  "service_owners": [
    {
      "name": "root"
    }
  ],
  "allowed_groups": [
    {
      "name": "wheel"
    },
    {
      "name": "admin"
    }
  ],
  "service_exec": "/usr/libexec/oddjobd",
  "service_args": [
    "-f",
    "--foreground"
  ],
  "nice_level": 5,
  "max_jobs": 50,
  "max_jobs_per_user": 5,
  "job_timeout": 300,
  "enable_syslog": true,
  "log_level": 1,
  "helper_dir": "/usr/libexec/oddjob"
}
