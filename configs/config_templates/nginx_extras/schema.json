{
  "worker_processes": {
    "type": "string",
    "default": "auto",
    "description": "Number of worker processes (e.g., 'auto' to match CPU cores)."
  },
  "pid_file": {
    "type": "string",
    "default": "/run/nginx.pid",
    "description": "Path to the Nginx PID file."
  },
  "error_log": {
    "type": "object",
    "default": {
      "path": "/var/log/nginx/error.log",
      "level": "warn"
    },
    "items": {
      "path": {
        "type": "string",
        "default": "/var/log/nginx/error.log",
        "description": "Path to the error log file."
      },
      "level": {
        "type": "string",
        "default": "warn",
        "enum": [
          "debug",
          "info",
          "notice",
          "warn",
          "error",
          "crit",
          "alert",
          "emerg"
        ],
        "description": "Minimum log level. Lower levels include more detail."
      }
    },
    "description": "Global error logging configuration."
  },
  "events": {
    "type": "object",
    "default": {
      "worker_connections": 1024,
      "use": "epoll",
      "multi_accept": false
    },
    "items": {
      "worker_connections": {
        "type": "integer",
        "default": 1024,
        "minimum": 1,
        "description": "Max number of simultaneous connections per worker process."
      },
      "use": {
        "type": "string",
        "default": "epoll",
        "enum": [
          "select",
          "poll",
          "/dev/poll",
          "epoll",
          "kqueue",
          "eventport"
        ],
        "description": "Event notification method to use (platform-dependent)."
      },
      "multi_accept": {
        "type": "boolean",
        "default": false,
        "description": "If enabled, workers accept all new connections at once instead of one at a time."
      }
    },
    "description": "Low-level I/O handling and connection settings."
  },
  "include_paths": {
    "type": "object",
    "default": {
      "mime_types": "/etc/nginx/mime.types",
      "conf.d": "/etc/nginx/conf.d",
      "sites": "/etc/nginx/sites-enabled"
    },
    "items": {
      "mime_types": {
        "type": "string",
        "default": "/etc/nginx/mime.types",
        "description": "Path to MIME types definition file."
      },
      "conf.d": {
        "type": "string",
        "default": "/etc/nginx/conf.d",
        "description": "Directory to include additional server-wide configuration fragments."
      },
      "sites": {
        "type": "string",
        "default": "/etc/nginx/sites-enabled",
        "description": "Directory to include virtual host/server block files."
      }
    },
    "description": "Standard filesystem paths for included configuration fragments."
  },
  "default_type": {
    "type": "string",
    "default": "application/octet-stream",
    "description": "Default MIME type for responses when type cannot be determined."
  },
  "access_log": {
    "type": "object",
    "default": {
      "path": "/var/log/nginx/access.log"
    },
    "items": {
      "path": {
        "type": "string",
        "default": "/var/log/nginx/access.log",
        "description": "Path to global access log file."
      }
    },
    "description": "Global access log path."
  },
  "log_formats": {
    "type": "list",
    "default": [],
    "items": {
      "type": "object",
      "items": {
        "name": {
          "type": "string",
          "default": "combined",
          "description": "Name of the log format (used in access_log directives)."
        },
        "format": {
          "type": "string",
          "default": "$remote_addr - $remote_user [$time_local] \"$request\" $status $body_bytes_sent \"$http_referer\" \"$http_user_agent\"",
          "description": "Custom log format string using Nginx variables. Escape newlines and quotes."
        }
      }
    },
    "description": "List of custom log format definitions (e.g., for structured logging)."
  },
  "sendfile": {
    "type": "boolean",
    "default": true,
    "description": "Use kernel sendfile() for static file transfers (improves performance)."
  },
  "tcp_nopush": {
    "type": "boolean",
    "default": true,
    "description": "Enable TCP_NOPUSH (Linux) to coalesce packets before sending."
  },
  "tcp_nodelay": {
    "type": "boolean",
    "default": true,
    "description": "Disable Nagle's algorithm for low-latency streaming (e.g., WebSocket)."
  },
  "keepalive_timeout": {
    "type": "integer",
    "default": 65,
    "minimum": 0,
    "description": "Duration (in seconds) to keep idle client connections open."
  },
  "client_max_body_size": {
    "type": "string",
    "default": "1m",
    "description": "Maximum allowed size of client request body (e.g., '1m', '10m')."
  },
  "gzip": {
    "type": "object",
    "default": {
      "enabled": false,
      "types": [
        "text/plain",
        "text/css",
        "application/json",
        "application/javascript"
      ],
      "comp_level": 6,
      "min_length": 100
    },
    "items": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable Gzip compression for responses."
      },
      "types": {
        "type": "list",
        "default": [
          "text/plain",
          "text/css",
          "application/json",
          "application/javascript"
        ],
        "items": {
          "type": "string"
        },
        "description": "MIME types to compress (wildcards like 'text/*' accepted)."
      },
      "comp_level": {
        "type": "integer",
        "default": 6,
        "minimum": 1,
        "maximum": 9,
        "description": "Compression level (1 = fastest/least, 9 = slowest/most)."
      },
      "min_length": {
        "type": "integer",
        "default": 100,
        "minimum": 0,
        "description": "Minimum response size (in bytes) to compress."
      }
    },
    "description": "HTTP Gzip compression settings."
  },
  "server_tokens": {
    "type": "boolean",
    "default": false,
    "description": "If true, hide Nginx version in response headers (security hardening)."
  },
  "upstreams": {
    "type": "list",
    "default": [],
    "items": {
      "type": "object",
      "items": {
        "name": {
          "type": "string",
          "default": "backend",
          "description": "Name of the upstream group (used in proxy_pass)."
        },
        "balance_method": {
          "type": "string",
          "default": "round_robin",
          "enum": [
            "round_robin",
            "least_conn",
            "ip_hash",
            "hash"
          ],
          "description": "Load balancing method. For 'hash', include a key (e.g., '$request_uri')."
        },
        "servers": {
          "type": "list",
          "items": {
            "type": "object",
            "items": {
              "address": {
                "type": "string",
                "description": "Backend host IP or hostname."
              },
              "port": {
                "type": "integer",
                "default": 80,
                "minimum": 1,
                "maximum": 65535,
                "description": "Backend port."
              },
              "weight": {
                "type": "integer",
                "default": 1,
                "minimum": 1,
                "description": "Server weight (for weighted load balancing)."
              }
            },
            "description": "Backend server address, port, and optional weight."
          },
          "description": "List of backend servers in this upstream group."
        },
        "keepalive": {
          "type": "integer",
          "default": 32,
          "minimum": 0,
          "description": "Number of idle keepalive connections to upstream (for HTTP/1.1)."
        }
      }
    },
    "description": "Upstream (backend) server groups for load balancing."
  },
  "servers": {
    "type": "list",
    "default": [],
    "items": {
      "type": "object",
      "items": {
        "listen": {
          "type": "list",
          "default": [
            "80"
          ],
          "items": {
            "type": "string"
          },
          "description": "Listen directives (e.g., '80', '[::]:80', '443 ssl')."
        },
        "server_name": {
          "type": "list",
          "default": [
            "localhost"
          ],
          "items": {
            "type": "string"
          },
          "description": "Server name(s) or regex patterns (e.g., ['example.com', '*.example.com'])."
        },
        "root": {
          "type": "string",
          "default": "/var/www/html",
          "description": "Document root directory for static content."
        },
        "index": {
          "type": "list",
          "default": [
            "index.html"
          ],
          "items": {
            "type": "string"
          },
          "description": "Index files to try (in order)."
        },
        "ssl": {
          "type": "object",
          "default": null,
          "items": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable SSL/TLS for this server block."
            },
            "cert_path": {
              "type": "string",
              "description": "Path to SSL certificate file (PEM format)."
            },
            "key_path": {
              "type": "string",
              "description": "Path to SSL private key file (PEM format)."
            },
            "protocols": {
              "type": "list",
              "default": [
                "TLSv1.2",
                "TLSv1.3"
              ],
              "items": {
                "type": "string"
              },
              "description": "Allowed TLS protocols."
            },
            "ciphers": {
              "type": "string",
              "default": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
              "description": "SSL cipher suites (colon-separated)."
            }
          },
          "description": "SSL/TLS configuration (required if 'listen' includes '443 ssl')."
        },
        "location_blocks": {
          "type": "list",
          "default": [],
          "items": {
            "type": "object",
            "items": {
              "path": {
                "type": "string",
                "default": "/",
                "description": "Location path prefix (e.g., '/api', '~*\\.php$')."
              },
              "root": {
                "type": "string",
                "default": null,
                "description": "Override root for this location (e.g., for subdirectories)."
              },
              "try_files": {
                "type": "list",
                "default": [],
                "items": {
                  "type": "string"
                },
                "description": "Fallback chain for file resolution (e.g., ['$uri', '$uri/', '=404'])."
              },
              "proxy_pass": {
                "type": "string",
                "default": null,
                "description": "Upstream or backend URL (e.g., 'http://backend', 'http://127.0.0.1:8080')."
              },
              "fastcgi_pass": {
                "type": "string",
                "default": null,
                "description": "FastCGI backend (e.g., 'unix:/run/php/php-fpm.sock')."
              },
              "rewrite": {
                "type": "string",
                "default": null,
                "description": "Regex rewrite rule (e.g., '^/old/(.*)$ /new/$1 permanent')."
              },
              "rewrite_flags": {
                "type": "list",
                "default": [],
                "items": {
                  "type": "string"
                },
                "description": "Rewrite flags (e.g., ['permanent'], ['last'], ['redirect'])."
              },
              "auth_basic": {
                "type": "string",
                "default": null,
                "description": "Basic auth realm string (e.g., 'Restricted')."
              },
              "auth_basic_user_file": {
                "type": "string",
                "default": null,
                "description": "Path to htpasswd file for basic auth."
              },
              "add_header": {
                "type": "list",
                "default": [],
                "items": {
                  "type": "object",
                  "items": {
                    "name": {
                      "type": "string",
                      "description": "Header name (e.g., 'X-Frame-Options')."
                    },
                    "value": {
                      "type": "string",
                      "description": "Header value (e.g., 'SAMEORIGIN')."
                    }
                  }
                },
                "description": "Custom headers to add to responses."
              },
              "return": {
                "type": "object",
                "default": null,
                "items": {
                  "code": {
                    "type": "integer",
                    "default": 301,
                    "description": "HTTP status code (e.g., 301, 404)."
                  },
                  "body": {
                    "type": "string",
                    "default": "",
                    "description": "Optional response body (e.g., 'Redirecting...')."
                  }
                },
                "description": "Return a static response (redirect or error)."
              },
              "limit_req": {
                "type": "object",
                "default": null,
                "items": {
                  "zone": {
                    "type": "string",
                    "description": "Name of the limit_req zone (defined in nginx.conf via limit_req_zone)."
                  },
                  "burst": {
                    "type": "integer",
                    "default": 10,
                    "description": "Burst size (max requests allowed temporarily)."
                  },
                  "nodelay": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, reject bursted requests instead of queuing."
                  }
                },
                "description": "Rate limiting configuration."
              },
              "limit_rate": {
                "type": "string",
                "default": null,
                "description": "Per-connection bandwidth limit (e.g., '100k', '1m')."
              },
              "add_trailer": {
                "type": "list",
                "default": [],
                "items": {
                  "type": "object",
                  "items": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "description": "HTTP trailer headers to add (for chunked responses)."
                }
              }
            }
          },
          "description": "List of location block configurations (URL paths and their behavior)."
        },
        "access_log": {
          "type": "string",
          "default": null,
          "description": "Per-server access log path (overrides global)."
        },
        "error_log": {
          "type": "string",
          "default": null,
          "description": "Per-server error log path (overrides global)."
        }
      }
    },
    "description": "Virtual hosts (server blocks) defining how Nginx handles different domains/paths."
  }
}
