# Core service settings
[service:producer]
# The host/IP to bind the internal RPC service to
host = {{ host }}
# The port to listen on for internal RPC communication
port = {{ port }}

# Worker and concurrency settings
# Maximum number of RPC workers to spawn
workers = {{ workers }}
# Number of threads for processing tasks
thread_pool_size = {{ thread_pool_size }}

# Messaging (RabbitMQ) transport configuration
# URI of the message bus (e.g., rabbit://user:pass@host:5672//)
transport_url = {{ transport_url }}

# Database connection configuration
# SQLAlchemy connection string for the designate database
[database]
connection = {{ database_connection }}

# Central RPC endpoint for communication with designate-central
[rpc_transport]
# Endpoint URL for designate-central (e.g., http://127.0.0.1:9001)
central_endpoint = {{ central_endpoint }}

# Zone management and task processing
[producer]
# Time to wait between polling for new tasks (in seconds)
periodic_interval = {{ periodic_interval }}
# Maximum number of tasks to process in a single run
max_tasks_per_run = {{ max_tasks_per_run }}
# Enable processing of zone transfers (true/false)
enable_zone_transfer_requests = {{ enable_zone_transfer_requests | lower }}
# Enable processing of recordset updates (true/false)
enable_recordset_updates = {{ enable_recordset_updates | lower }}

# Logging configuration
[log]
# Path to log file (empty string for stderr only)
file = {{ log_file }}
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
level = {{ log_level }}
