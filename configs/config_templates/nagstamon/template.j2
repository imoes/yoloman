# Nagstamon Configuration File
# Generated by Ansible Jinja2 engine
# DO NOT EDIT MANUALLY
# This file configures Nagstamon, a monitoring viewer for the system tray.
# It supports multiple backends (Nagios, Icinga, Checkmk, etc.).
# The structure mirrors the application's internal config format.

[general]
# The type of monitoring backend (nagios, icinga, op5, centreon, checkmk, etc.)
type={{ backend_type | default('nagios') }}

# The base URL of the monitoring server web interface.
# Computed from host/port/path if individual fields are preferred, otherwise uses this full URL.
url={{ server_url | default('https://monitoring.example.com/nagios') }}

# Username used to authenticate with the monitoring server.
username={{ username | default('admin') }}

# Password used to authenticate with the monitoring server.
# In production, ensure this is handled securely; Nagstamon may encrypt this in the final file.
password={{ password | default('changeme') }}

# Time in seconds between status checks.
update_interval={{ check_interval | default(60) }}

# Whether to enable desktop/system notifications for status changes.
notifications={{ notifications_enabled | default(true) | lower }}

# Name of the icon theme to use for the system tray icon.
icon_theme={{ icon_theme | default('nagstamon') }}

# Language code for the user interface.
lang={{ language | default('en') }}

# Whether to check for new versions of Nagstamon automatically.
check_for_updates={{ check_updates | default(true) | lower }}

[{{ monitor_name | default('production') }}]
# Unique name/identifier for this specific monitoring instance configuration.
# This section header matches the monitor_name value.
name={{ monitor_name | default('production') }}

# Human-readable name displayed in the application.
display_name={{ display_name | default('Production Monitoring') }}

# Backend specific type (must match [general].type if overriding).
backend={{ backend_type | default('nagios') }}

# Hostname or IP address of the monitoring server.
server={{ server_host | default('monitoring.example.com') }}

# Network port of the monitoring server.
port={{ server_port | default(443) }}

# Base path for the monitoring server's CGI or API interface.
base_url={{ base_url | default('/nagios/cgi-bin') }}

# Authentication method used by the backend (cgi, xmlrpc, api, etc.).
auth={{ auth_method | default('cgi') }}