{
  "enabled": true,
  "exclude_patterns": [
    "^$",
    "^\\s*$",
    "^.*\\[notice\\].*$",
    "^.*\\[debug\\].*$",
    ".*systemd.*Started.*$",
    ".*systemd.*Stopped.*$",
    ".*systemd.*Started.*$",
    ".*systemd.*Stopping.*$"
  ],
  "include_patterns": [
    "^.*\\[error\\].*$",
    "^.*\\[warning\\].*$",
    "^.*\\[crit\\].*$",
    "^.*\\[alert\\].*$",
    "^.*\\[emergency\\].*$",
    "^.*\\(fail\\).*$",
    "^.*\\(denied\\).*$",
    "^.*kernel.*BUG:.*$",
    "^.*kernel.*Oops.*$"
  ],
  "sort_output": true,
  "sample_limit": 5,
  "report_email": [
    "admin@example.com",
    "ops@example.com"
  ],
  "report_subject_prefix": "[logcheck-daily] ",
  "verbose": false
}
