{
  "machine_id": "xrdp",
  "log_file": "/var/log/xrdp.log",
  "log_level": "INFO",
  "security_layer": "negotiate",
  "certificate": "",
  "key_file": "",
  "ssl_protocols": "TLSv1.2,TLSv1.3",
  "allow_tls13": true,
  "listen_address": "0.0.0.0",
  "listen_port": 3389,
  "max_bpp": 32,
  "new_cursors": true,
  "fips_mode": false,
  "idle_max_time": 0,
  "disconnect_idle": false,
  "reuse_sessions": false,
  "xserver_startup_delay": 10,
  "font_path": "/usr/share/fonts/TTF",
  "bitmap_cache": true,
  "bitmap_compression": true,
  "persistent_bitmap": true,
  "audio_redirection": false,
  "smartcard_redirection": false,
  "clipboard": "both",
  "drive_redirection": false,
  "printer_redirection": false,
  "serial_redirection": false
}
