{
  "machine_id": "xrdp-prod-01",
  "log_file": "/var/log/xrdp.log",
  "log_level": "warn",
  "security_layer": "tls",
  "certificate": "/etc/xrdp/cert.pem",
  "key_file": "/etc/xrdp/key.pem",
  "ssl_protocols": "TLSv1.2,TLSv1.3",
  "allow_tls13": true,
  "listen_address": "0.0.0.0",
  "listen_port": 3389,
  "max_bpp": 24,
  "new_cursors": true,
  "fips_mode": false,
  "idle_max_time": 3600,
  "disconnect_idle": true,
  "reuse_sessions": true,
  "xserver_startup_delay": 5,
  "font_path": "/usr/share/fonts/TTF",
  "bitmap_cache": true,
  "bitmap_compression": true,
  "persistent_bitmap": true,
  "audio_redirection": true,
  "smartcard_redirection": false,
  "clipboard": "both",
  "drive_redirection": true,
  "printer_redirection": false,
  "serial_redirection": false,
  "parallel_redirection": false,
  "usb_redirection": false,
  "gdi_rendering": true,
  "xserver_custom_parameters": "-depth 24 -geometry 1920x1080 -noreset",
  "session_types": [
    {
      "name": "Xvnc",
      "lib": "libvnc.so",
      "username": "ask",
      "password": "ask",
      "ip": "127.0.0.1",
      "port": -1
    },
    {
      "name": "Xorg",
      "lib": "libxup.so",
      "username": "ask",
      "password": "ask",
      "ip": "127.0.0.1",
      "port": -1
    }
  ],
  "allowed_users": [
    "alice",
    "bob",
    "service-account"
  ],
  "denied_users": null,
  "allowed_groups": [
    "rdp-users"
  ],
  "denied_groups": null
}
