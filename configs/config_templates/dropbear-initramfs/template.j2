#
# ==============================================================================
# dropbear-initramfs Configuration
# ==============================================================================
# This file configures the dropbear SSH server running inside the initramfs.
# Changes require running `update-initramfs -u` to take effect.
#
# Variable assignment follows shell semantics.
# ==============================================================================

# ------------------------------------------------------------------------------
# Command line options to pass to dropbear(8).
# Use this to specify additional arguments for the dropbear binary (e.g., -p for port, -r for host key).
# Default: No options (uses dropbear defaults).
# ------------------------------------------------------------------------------
{% if DROPBEAR_OPTIONS is defined and DROPBEAR_OPTIONS is not none and (DROPBEAR_OPTIONS is number or DROPBEAR_OPTIONS is boolean or DROPBEAR_OPTIONS | length > 0) %}DROPBEAR_OPTIONS={{ DROPBEAR_OPTIONS | default('') }}{% else %}#DROPBEAR_OPTIONS=""{% endif %}

# ------------------------------------------------------------------------------
# Network interface pattern to bring down after initramfs tasks complete.
# Interfaces matching this glob pattern are shut down before the root filesystem is mounted.
# Use 'none' to keep all interfaces up (preserves routing/addresses).
# Default: '*' (brings down all interfaces except the primary one used for init).
# ------------------------------------------------------------------------------
{% if IFDOWN is defined and IFDOWN is not none and (IFDOWN is number or IFDOWN is boolean or IFDOWN | length > 0) %}IFDOWN={{ IFDOWN | default('*') }}{% else %}#IFDOWN="*"{% endif %}

# ------------------------------------------------------------------------------
# Maximum seconds to wait for network/dropbear setup at init-bottom.
# If the timeout expires before the network/dropbear are ready or a user inputs credentials,
# dropbear is terminated and the system may pivot to init(1) early.
# Increase this if remote unlocking takes longer than expected.
# Default: 60 seconds.
# ------------------------------------------------------------------------------
{% if DROPBEAR_SHUTDOWN_TIMEOUT is defined and DROPBEAR_SHUTDOWN_TIMEOUT is not none and (DROPBEAR_SHUTDOWN_TIMEOUT is number or DROPBEAR_SHUTDOWN_TIMEOUT is boolean or DROPBEAR_SHUTDOWN_TIMEOUT | length > 0) %}DROPBEAR_SHUTDOWN_TIMEOUT={{ DROPBEAR_SHUTDOWN_TIMEOUT | default('60') }}{% else %}#DROPBEAR_SHUTDOWN_TIMEOUT=60{% endif %}
