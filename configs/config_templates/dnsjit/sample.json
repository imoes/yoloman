{
  "script_header_comment": "-- dnsjit config for DNS ID logging (example)",
  "dnsjit_version_check": true,
  "version_major": 1,
  "version_minor": 5,
  "input_module": "pcapthread",
  "input_module_options": [
    [
      "only_queries",
      "true"
    ],
    [
      "threads",
      "4"
    ]
  ],
  "filter_module": "lua",
  "parse_dns": true,
  "output_statement": "print('Query ID:', dns.id)",
  "input_file": "queries.pcap",
  "only_queries": false,
  "only_responses": false
}
