#!/bin/bash
# Wrapper script for hoz file splitter/paster operations
# This script manages file operations (splitting or merging) using the hoz utility.

# Path to the input file to be split or merged.
# For 'cut' operation, this is the source file. For 'paste' operation,
# this variable is less critical for the command logic but retained for context.
INPUT_FILE="{{ input_file | default('/var/lib/hoz/data.iso') }}"

# Directory where pieces are stored (for cut) or where the merged file is written (for paste).
OUTPUT_DIR="{{ output_dir | default('/var/lib/hoz/output') }}"

# Size of each piece when cutting, e.g., 10M, 500K.
# Only used when operation is 'cut'.
CUT_SIZE="{{ cut_size | default('10M') }}"

# Operation to perform: 'cut' to split, 'paste' to merge.
{% if operation | default('cut') == "cut" %}
# Split the input file into pieces of specified size
hoz -c -c {{ cut_size | default('10M') }} -o {{ output_dir | default('/var/lib/hoz/output') }} {{ input_file | default('/var/lib/hoz/data.iso') }}
{% elif operation | default('cut') == "paste" %}
# Merge pieces back into the original file in the output directory
hoz -p -o {{ output_dir | default('/var/lib/hoz/output') }} {{ input_file | default('/var/lib/hoz/data.iso') }}
{% else %}
# Error: Invalid operation specified. Expected 'cut' or 'paste'.
echo "Error: operation '{{ operation | default('cut') }}' is not supported. Use 'cut' or 'paste'."
exit 1
{% endif %}