# =============================================================================
# Claws Mail PDF Viewer Plugin Configuration
# =============================================================================
# This template generates a metadata/configuration fragment for the Claws Mail
# 'pdf_viewer' plugin.
#
# IMPORTANT: Claws Mail plugins are primarily activated and configured via the
# GUI (Plugins -> Available Plugins). This file serves to document the plugin's
# metadata, dependencies, and any system administrator notes.
#
# Variables expected from Ansible inventory/vars:
#   - notes: Optional free-text notes for sysadmins (e.g., paths, deployment instructions).

[claws-mail-pdf-viewer]
# Plugin filename (as installed by package)
# This is a fixed value provided by the package, not user-configurable.
filename = pdf_viewer.so

# Description (from man page)
# Provides the functionality to display PDF and PostScript® attachments within Claws Mail.
description = Display PDF and PostScript® attachments

# Dependencies (from SEE ALSO and DESCRIPTION)
# The man page states PDF rendering uses poppler and PostScript requires gs.
# These are runtime dependencies, not configurable directives in a static file,
# but this template records them for context and dependency checking.
dependencies = poppler, ghostscript

# Optional free-text notes for sysadmins
# Use this field to document local deployment instructions, known issues,
# or specific paths relevant to your environment.
# Example: notes = "Verify poppler-utils is installed on the client"
{% if notes is defined and notes %}
# Sysadmin Notes: {{ notes | default('') }}
{% else %}
# Sysadmin Notes: (none)
{% endif %}