[DEFAULT]
# Base directory for Magnum data and logs
#logdir = /var/log/magnum
#logdir = {{ logdir }}

# Directory for state and temporary files
#state_path = /var/lib/magnum
#state_path = {{ state_path }}

# API listen address
#bind_host = 0.0.0.0
#bind_host = {{ bind_host }}

# API listen port
#api_paste_config = /etc/magnum/api-paste.ini
#api_paste_config = {{ api_paste_config }}

# Number of API workers
#workers = 1
#workers = {{ api_workers }}

# Enable secure (HTTPS) API endpoint
#enable_ssl_api = False
#enable_ssl_api = {{ enable_ssl_api | lower }}

# Path to SSL certificate file (required if enable_ssl_api=True)
#ssl_cert_file = /etc/ssl/certs/magnum.crt
#ssl_cert_file = {{ ssl_cert_file }}

# Path to SSL private key file (required if enable_ssl_api=True)
#ssl_key_file = /etc/ssl/private/magnum.key
#ssl_key_file = {{ ssl_key_file }}

[database]
# Connection string for Magnum database
#connection = mysql+pymysql://magnum:DB_PASS@controller/magnum
#connection = {{ db_connection }}

[keystone]
# Authentication URL for Keystone
#auth_url = http://controller:5000
#auth_url = {{ keystone_auth_url }}

# Service region for Keystone
#region_name = RegionOne
#region_name = {{ keystone_region_name }}

# Project domain name
#project_domain_name = Default
#project_domain_name = {{ keystone_project_domain_name }}

# Project name
#project_name = service
#project_name = {{ keystone_project_name }}

# User domain name
#user_domain_name = Default
#user_domain_name = {{ keystone_user_domain_name }}

# Magnum service username
#username = magnum
#username = {{ keystone_service_user }}

# Magnum service user password
#password = SERVICE_PASS
#password = {{ keystone_service_password }}

[trust]
# Enable trust mechanism for cluster operations
#enabled = True
#enabled = {{ trust_enabled | lower }}

# Trustee domain ID (if using trustee/delegated trust)
#trustee_domain_id = {{ trustee_domain_id }}

# Trustee domain admin user
#trustee_domain_admin = {{ trustee_domain_admin }}

# Trustee domain admin password
#trustee_domain_admin_password = {{ trustee_domain_admin_password }}

[cluster]
# Default Docker storage driver
#default_docker_volume_size = 20
#default_docker_volume_size = {{ default_docker_volume_size }}

# Default number of nodes for new clusters
#default_node_count = 1
#default_node_count = {{ default_node_count }}

# List of enabled cluster templates
#enabled_cluster_templates = kubernetes,swarm,mesos
#enabled_cluster_templates = {{ enabled_cluster_templates | join(',') }}

# Default cluster template
#default_cluster_template = kubernetes
#default_cluster_template = {{ default_cluster_template }}

# Timeout for cluster operations (seconds)
#cluster_create_timeout = 120
#cluster_create_timeout = {{ cluster_create_timeout }}

[api]
# Enable v1 API endpoints
#enable_v1_api = True
#enable_v1_api = {{ enable_v1_api | lower }}

# Enable v2 API endpoints
#enable_v2_api = True
#enable_v2_api = {{ enable_v2_api | lower }}

[certificates]
# Certificate driver class
#cert_manager_type = keystonemiddleware
#cert_manager_type = {{ cert_manager_type }}

# Path to CA certificate for signing cluster certificates
#ca_cert = /etc/magnum/ssl/ca.crt
#ca_cert = {{ ca_cert }}

# Path to CA private key for signing cluster certificates
#ca_key = /etc/magnum/ssl/ca.key
#ca_key = {{ ca_key }}

# TTL for cluster certificates (days)
#cluster_cert_ttl = 8760
#cluster_cert_ttl = {{ cluster_cert_ttl }}

# Enable PKI-based certificate generation
#pki_enabled = False
#pki_enabled = {{ pki_enabled | lower }}

# PKI certificate storage path
#pki_file_path = /etc/magnum/ssl/pki
#pki_file_path = {{ pki_file_path }}

[conductor]
# Number of conductor workers
#workers = 1
#workers = {{ conductor_workers }}

# Maximum number of nodes in a cluster
#max_cluster_nodes = 100
#max_cluster_nodes = {{ max_cluster_nodes }}

# Timeout for conductor operations (seconds)
#timeout = 600
#timeout = {{ conductor_timeout }}

[coe]
# Kubernetes-specific configuration
[kubernetes]
# Enable Horizontal Pod Autoscaler
#enable_hpa = False
#enable_hpa = {{ k8s_enable_hpa | lower }}

# Enable DNS in cluster
#enable_dns = True
#enable_dns = {{ k8s_enable_dns | lower }}

# Enable pod security policy
#enable_pod_security_policy = False
#enable_pod_security_policy = {{ k8s_enable_pod_security_policy | lower }}

# List of allowed insecure registries
#insecure_registries = 192.168.1.0/24
#insecure_registries = {{ k8s_insecure_registries | join(',') }}

# Registry mirror URL
#registry_mirror = {{ k8s_registry_mirror }}

# Docker storage driver
#docker_storage_driver = overlay2
#docker_storage_driver = {{ k8s_docker_storage_driver }}
