{
 "backend": "auto",
 "banaction": "iptables-multiport",
 "banaction_allports": "iptables-allports",
 "bantime": "1h",
 "chain": "INPUT",
 "default_port": "ssh",
 "destemail": "admin@example.com",
 "findtime": "10m",
 "ignoreip": [
  "127.0.0.1/8",
  "::1",
  "192.168.1.0/24"
 ],
 "jails": [
  {
   "action": "iptables-multiport[name=SSHD, port=ssh, protocol=tcp]",
   "bantime": 600,
   "description": "Secure Shell daemon jail",
   "enabled": true,
   "filter": "sshd",
   "findtime": 600,
   "logpath": [
    "/var/log/auth.log",
    "/var/log/secure"
   ],
   "maxretry": 5,
   "name": "sshd",
   "port": "ssh"
  },
  {
   "description": "DDoS protection for SSH (optional)",
   "enabled": false,
   "filter": "sshd-ddos",
   "logpath": [
    "/var/log/auth.log"
   ],
   "maxretry": 3,
   "name": "sshd-ddos",
   "port": "ssh"
  },
  {
   "bantime": 3600,
   "description": "Postfix mail server protection",
   "enabled": true,
   "filter": "postfix",
   "logpath": [
    "/var/log/mail.log"
   ],
   "maxretry": 5,
   "name": "postfix",
   "port": "smtp,ssmtp"
  }
 ],
 "loglevel": 2,
 "logtarget": "/var/log/fail2ban.log",
 "maxretry": 5,
 "mta": "sendmail",
 "protocol": "tcp",
 "sender": "fail2ban@example.com",
 "sendername": "Fail2Ban",
 "syslogfacility": "daemon",
 "unbanaction": "iptables-delchain",
 "use_dns": false
}
