# GlusterFS management daemon configuration
# This file configures glusterd, the cluster management daemon.
# It is typically auto-generated by GlusterFS tools, but manual tweaks are possible.

option transport.socket.bind-address {{ bind_address }}
option transport.socket.listen-port {{ listen_port }}
option transport.socket.nodelay {{ 'on' if nodelay else 'off' }}
option transport.socket.keepalive {{ 'on' if keepalive else 'off' }}
option transport.socket.keepalive-interval {{ keepalive_interval }}
option transport.socket.keepalive-timeout {{ keepalive_timeout }}
option transport.socket.linger {{ 'on' if linger else 'off' }}
option transport.socket.rmem {{ rmem }}
option transport.socket.wmem {{ wmem }}

# RPC and management service tuning
option rpc-auth.auth.allow {{ auth_allow | join(', ') }}
option rpc-auth.auth.reject {{ auth_reject | join(', ') }}
option rpc-auth.basic.auth-password-file {{ auth_password_file }}
option rpc-auth.ldap.bind-dn {{ ldap_bind_dn }}
option rpc-auth.ldap.bind-password {{ ldap_bind_password }}
option rpc-auth.ldap.server {{ ldap_server }}
option rpc-auth.ldap.search-base-dn {{ ldap_search_base_dn }}
option rpc-auth.ldap.search-filter {{ ldap_search_filter }}
option rpc-auth.ldap.cert-file {{ ldap_cert_file }}
option rpc-auth.ldap.use-starttls {{ 'on' if ldap_use_starttls else 'off' }}

# Logging
option logging.log-file {{ log_file }}
option logging.log-level {{ log_level }}
option logging.log-format {{ log_format }}

# Volume management
option glusterd.volfile-format {{ volfile_format }}
option glusterd.volume-root {{ volume_root }}

# Peers and clustering
option peer-statistics {{ 'on' if peer_statistics else 'off' }}
option rpc.client-port {{ client_port }}
option rpc.server-port {{ server_port }}
option rpc.num-threads {{ num_threads }}
option rpc.auth.insecure-access {{ 'on' if insecure_access else 'off' }}
option server.allow-insecure {{ 'on' if server_allow_insecure else 'off' }}
option mgmt.ssl {{ 'on' if mgmt_ssl else 'off' }}
option mgmt.ssl-cipher-list {{ mgmt_ssl_cipher_list }}

# Optional: peer hostnames (auto-discovered via /var/lib/glusterd/peers/)
# But if static peer definitions are needed (e.g., for initial bootstrap):
{% for peer in peers %}
option peers.{{ loop.index }}.hostname {{ peer.hostname }}
{% if peer.uuid %}option peers.{{ loop.index }}.uuid {{ peer.uuid }}{% endif %}
{% endfor %}
