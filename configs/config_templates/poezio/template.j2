# ==============================================================================
# Poezio Configuration File
#
# Self-documenting template for Ansible role deployment.
# See poezio.cfg(7) for full documentation of the configuration format.
#
# This file is generated by Ansible using Jinja2. All variables use explicit
# defaults to ensure safe, idempotent rendering even if variables are undefined.
# ==============================================================================

[core]
# Path to the directory where poezio stores data (roster, history, etc.)
# Schema: data_path (string)
data_path = {{ data_path | default('~/.config/poezio/data') }}

# Path to the directory where poezio stores configuration files
# Schema: config_dir (string)
config_dir = {{ config_dir | default('~/.config/poezio') }}

# Enable or disable automatic update checks on startup
# Schema: check_updates (boolean)
check_updates = {{ check_updates | default(true) }}

# Terminal type string to ensure correct 256-color support
# Schema: term (string)
term = {{ term | default('xterm-256color') }}

[logging]
# Path to a file for debug logging.
# An empty string disables file logging (logs go to stderr or are suppressed).
# Schema: debug_file (string)
debug_file = {{ debug_file | default('') }}

[ui]
# Whether to display the roster (contact list) tab by default
# Schema: show_roster (boolean)
show_roster = {{ show_roster | default(true) }}

# Whether to display offline contacts in the roster view
# Schema: show_offline (boolean)
show_offline = {{ show_offline | default(true) }}

# Name of the UI theme to apply (e.g., 'default', 'dark', 'light')
# Schema: theme (string)
theme = {{ theme | default('default') }}

# Whether to show the status bar at the bottom of the window
# Schema: show_status_bar (boolean)
show_status_bar = {{ show_status_bar | default(true) }}

[accounts]
# List of XMPP accounts to configure automatically on login.
# Each account generates a dedicated section [account:ID].
# Schema: accounts (list of objects)
# NOTE: 'accounts' defaults to an empty list [] to prevent rendering errors if undefined.
{% for account in (accounts | default([])) %}
[account:{{ account.id | default('') }}]
# The JID (Jabber ID) for this XMPP account (e.g., user@example.com)
jid = {{ account.jid | default('') }}

# The password for this account.
# Security note: For better security, consider using a keyring or agent instead of plain text.
password = {{ account.password | default('') }}

# The resource name for this client instance (used to distinguish devices)
resource = {{ account.resource | default('poezio') }}

# Auto-join these MUCs (Multi-User Chats) upon login.
# Comma-separated list of room JIDs.
# If autojoin is not a list, it is converted to one or treated as a single item.
autojoin = {{ (account.autojoin | default([])) | join(',') }}

# Priority of the session (0-255). Higher priority is preferred for incoming messages.
priority = {{ account.priority | default(0) }}

# Presence status message displayed to contacts
status_message = {{ account.status_message | default('') }}

# Presence status type: available, busy, away, xa, offline
status_type = {{ account.status_type | default('available') }}

{% endfor %}