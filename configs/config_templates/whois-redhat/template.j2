# whois-redhat: WHOIS client configuration for Red Hat systems
# This template manages the configuration for the `whois` command package.
# It typically contains root server list paths or client-side timeouts.

# Path to the list of root WHOIS servers
# Default: /usr/share/whois/rwhois.conf
# This file is often provided by the whois package itself.
# If a custom list is needed, specify it here.
whois_root_servers_file = {{ whois_root_servers_file | default('/usr/share/whois/rwhois.conf') }}

# Timeout for WHOIS queries in seconds
# Default: 10
# Prevents hanging on unresponsive servers.
whois_timeout = {{ whois_timeout | default(10) }}

# Verbose mode: if true, show detailed query info
# Default: false
whois_verbose = {{ whois_verbose | default(false) }}

# Follow redirects/aliases in WHOIS responses
# Default: true
whois_follow = {{ whois_follow | default(true) }}

# Number of retries on connection failure
# Default: 3
whois_retries = {{ whois_retries | default(3) }}
