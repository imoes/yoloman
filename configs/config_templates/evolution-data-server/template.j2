# ============================================================================
# Evolution Data Server: Alarm Notify Desktop Entry
# ============================================================================
# This template generates a .desktop file for the evolution-alarm-notify service.
# It is a system-level application entry used by GNOME/KDE desktop environments
# to launch the notification daemon for Evolution Calendar/Tasks reminders.
#
# Self-documenting: Every field is commented with its source description
# and any Jinja2 variable usage includes a safe default.
# ============================================================================

[Desktop Entry]
# Type of the desktop entry file (must be Application for executables)
Type=Application

# ============================================================================
# Localized Names
# ============================================================================
# These are static localization strings from the original package.
# They describe what the application does in various languages.
Name[cs]=Připomínky událostí a úkolů
Name[da]=Påmindelser for begivenheder og opgaver
Name[en_GB]=Events and Tasks Reminders
Name[eu]=Gertaeren eta zereginen oroigarriak
Name[fr]=Rappels des évènements et des tâches
Name[fur]=Events e pro memoria di ativitâts
Name[hu]=Események és feladatok emlékeztetői
Name[id]=Pengingat Acara dan Tugas
Name[lt]=Įvykių ir užduočių priminėjai
Name[lv]=Notikumu ir užduočių atgādinājumi
Name[pl]=Przypomnienia o wydarzeniach i zadaniach
Name[pt_BR]=Eventos e lembretes de tarefas
Name[ru]=Напоминания о событиях и задачах
Name[sl]=Opomniki za dogodke in opravila
Name[sr]=Подсетници за догађаје и задатке
Name[sv]=Evenemangs- и uppgiftspåminnelser
Name[tr]=Etkinlik ve Görev Anımsatıcılar
Name[uk]=Нагадування про події та завдання
Name[zh_CN]=事件和任务提醒
# Default name (English)
Name=Events and Tasks Reminders

# ============================================================================
# Localized Comments
# ============================================================================
# Static localization strings describing the purpose of the application.
Comment[cs]=Upozornění na události a úkoly
Comment[da]=Påmindelser for begivenheder og opgaver
Comment[en_GB]=Event and task notifications
Comment[eu]=Gertaeren eta zereginen jakinarazpenak
Comment[fr]=Notifications d’évènement et de tâche
Comment[hu]=Esemény- és feladatértesítések
Comment[id]=Pemberitahuan acara dan tugas
Comment[lt]=Įvykio ir užduoties pranešimai
Comment[lv]=Notikumu ir užduočių paziņumi
Comment[pl]=Powiadomenia o wydarzeniach i zadaniach
Comment[pt_BR]=Evento i notifikacje zadań
Comment[ru]=Уведомления о событиях и задачах
Comment[sl]=Obvestila o dogodkih in opravilih
Comment[sr]=Обавештења за догађаје и задатке
Comment[sv]=Evenemangs- och uppgiftsaviseringar
Comment[tr]=Olay ve görev bildirimleri
Comment[uk]=Сповіщення про події та завдання
Comment[zh_CN]=事件和任务通知
# Default comment (English)
Comment=Event and task notifications

# Icon identifier for the application (standard GNOME icon theme name)
Icon=org.gnome.Evolution-alarm-notify

# ============================================================================
# Executable Path
# ============================================================================
# Full path to the evolution-alarm-notify executable.
# Uses the 'exec_path' variable from the schema.
# Default: /usr/libexec/evolution-data-server/evolution-alarm-notify
Exec={{ exec_path | default('/usr/libexec/evolution-data-server/evolution-alarm-notify') }}

# Run in a terminal window? (False for system daemons/services)
Terminal=false

# Categories (Empty by default in original, can be extended if needed)
# Note: Specific categories like 'GNOME;System;' could be added via variables,
# but we preserve the empty state or leave it for role-specific customization.
Categories=

# Hide from application menus? (True for system utilities)
NoDisplay=true

# Priority hint for Meego/HarmonyOS environments
X-Meego-Priority=Low

# Flag to indicate usage of GNOME's notification framework
X-GNOME-UsesNotifications=true