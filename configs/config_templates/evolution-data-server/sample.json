{
  "extensions_directory": "/usr/lib/evolution-data-server/",
  "enable_calendar": true,
  "enable_addressbook": true,
  "enable_tasks": true,
  "enable_memo": true,
  "enable_mail": false,
  "enable_offline": false,
  "max_connections_per_client": 25,
  "idle_connection_timeout": 600,
  "cache_path": "/var/cache/evolution-data-server/cache.sqlite",
  "log_level": 1,
  "extensions": [
    "caldav",
    "carddav",
    "evolution-alarm-notify"
  ],
  "sources": [
    {
      "name": "Local Calendar",
      "type": "local",
      "uri": "file:///home/jane/.local/share/evolution/calendar/system",
      "display_name": "Local Calendar"
    },
    {
      "name": "Work CalDAV",
      "type": "caldav",
      "uri": "https://caldav.example.com/user/jane",
      "caldav_url": "https://caldav.example.com/",
      "auth_method": "oauth2",
      "username": "jane@example.com",
      "display_name": "Work Calendar (OAuth2)",
      "oauth2_client_id": "edc-client-123",
      "oauth2_token_uri": "https://accounts.example.com/oauth2/token"
    },
    {
      "name": "Personal CardDAV",
      "type": "carddav",
      "uri": "https://carddav.example.com/vcards/jane/",
      "carddav_url": "https://carddav.example.com/",
      "auth_method": "basic",
      "username": "jane@example.com",
      "display_name": "Personal Contacts",
      "ssl_trust_file": "/etc/ssl/certs/ca-certificates.crt"
    }
  ]
}
