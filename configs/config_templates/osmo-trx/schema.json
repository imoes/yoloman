{
  "logging_filter_all": {
    "type": "number",
    "default": 1,
    "description": "Whether to enable the 'all' filter in logging."
  },
  "logging_color": {
    "type": "number",
    "default": 1,
    "description": "Whether to enable color output in logs."
  },
  "logging_print_category_hex": {
    "type": "number",
    "default": 0,
    "description": "Whether to print category as hex."
  },
  "logging_print_category": {
    "type": "number",
    "default": 1,
    "description": "Whether to print category name."
  },
  "logging_timestamp": {
    "type": "number",
    "default": 0,
    "description": "Whether to print timestamps."
  },
  "logging_print_level": {
    "type": "number",
    "default": 1,
    "description": "Whether to print log level."
  },
  "logging_level_set_all": {
    "type": "string",
    "default": "notice",
    "description": "The default log level for all categories."
  },
  "cpu_sched_policy_rr": {
    "type": "number",
    "default": 18,
    "description": "The round-robin time slice for CPU scheduling."
  },
  "trx_bind_ip": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address to bind the TRX interface to."
  },
  "trx_remote_ip": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Remote IP address for the TRX interface."
  },
  "trx_egprs": {
    "type": "string",
    "default": "disable",
    "description": "Whether EGPRS is enabled or disabled."
  },
  "trx_tx_sps": {
    "type": "number",
    "default": 4,
    "description": "Samples per symbol for TX."
  },
  "trx_rx_sps": {
    "type": "number",
    "default": 4,
    "description": "Samples per symbol for RX."
  },
  "trx_chan": {
    "type": "number",
    "default": 0,
    "description": "Channel number for the TRX."
  },
  "trx_tx_path": {
    "type": "string",
    "default": "BAND1",
    "description": "TX RF path configuration."
  },
  "trx_rx_path": {
    "type": "string",
    "default": "LNAW",
    "description": "RX RF path configuration."
  }
}
