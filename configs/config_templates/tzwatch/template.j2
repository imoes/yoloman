# Tzwatch configuration file
# This file manages the time zones to display and the display format for the tzwatch utility.

# --- Time Zones Section ---
# List of time zones in TZ variable format (e.g., America/New_York).
# Each zone appears on its own line in the config file.
# Default zones: America/New_York, Europe/London, Asia/Tokyo
{% for zone in zones | default(['America/New_York', 'Europe/London', 'Asia/Tokyo'], true) %}
{{ zone }}
{% endfor %}

# --- Display Format Section ---
# Time display format string compatible with the date command.
# Uses standard date(1) format specifiers (e.g., %A for full weekday name).
# Default format: '%A %Y-%m-%d %H:%M:%S %Z'
FORMAT={{ format | default('%A %Y-%m-%d %H:%M:%S %Z', true) }}