{
  "services": [
    {
      "name": "ftp",
      "socket_type": "stream",
      "protocol": "tcp",
      "wait": "nowait",
      "user": "root",
      "group": "root",
      "server_path": "/usr/sbin/in.ftpd",
      "args": [
        "/usr/local/etc/ftpd",
        "-l"
      ]
    },
    {
      "name": "telnet",
      "socket_type": "stream",
      "protocol": "tcp",
      "wait": "nowait",
      "user": "root",
      "group": "",
      "server_path": "/usr/sbin/in.telnetd",
      "args": []
    },
    {
      "name": "finger",
      "socket_type": "stream",
      "protocol": "tcp",
      "wait": "nowait",
      "user": "nobody",
      "group": "",
      "server_path": "/usr/sbin/in.fingerd",
      "args": []
    }
  ]
}
