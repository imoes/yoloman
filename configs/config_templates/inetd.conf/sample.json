{
 "host_prefix": "",
 "services": [
  {
   "args": [
    "/usr/local/etc/ftpd",
    "-l"
   ],
   "group": "root",
   "name": "ftp",
   "protocol": "tcp",
   "server_path": "/usr/sbin/in.ftpd",
   "socket_type": "stream",
   "user": "root",
   "wait": "nowait"
  },
  {
   "args": [],
   "group": "",
   "name": "telnet",
   "protocol": "tcp",
   "server_path": "/usr/sbin/in.telnetd",
   "socket_type": "stream",
   "user": "root",
   "wait": "nowait"
  },
  {
   "args": [],
   "group": "",
   "name": "finger",
   "protocol": "tcp",
   "server_path": "/usr/sbin/in.fingerd",
   "socket_type": "stream",
   "user": "nobody",
   "wait": "nowait"
  }
 ]
}
