{
  "debug": 2,
  "run_as_root": false,
  "user": "cache",
  "group": "cache",
  "pidfile": "/run/cachefilesd.pid",
  "cache_dir": "/var/cache/fscache",
  "extra_dirs": [
    "/mnt/ssd-cache",
    "/mnt/hdd-cache"
  ],
  "cache_lower": "1G",
  "cache_upper": "20G",
  "scan_interval": 5,
  "tag": "node1-fscache"
}
