{
  "bind_address": "0.0.0.0",
  "port": 5000,
  "debug": false,
  "model_cache_dir": "/var/cache/berrynet/models",
  "database_path": "/var/lib/berrynet/dashboard.db",
  "max_concurrent_inferences": 4,
  "inference_timeout": 30,
  "use_https": false,
  "cert_file": "/etc/ssl/berrynet/dashboard.crt",
  "key_file": "/etc/ssl/berrynet/dashboard.key",
  "log_level": "INFO",
  "log_file": "/var/log/berrynet/dashboard.log",
  "auth_backend": "basic",
  "ldap_uri": "",
  "ldap_bind_dn": "",
  "ldap_password": "",
  "ldap_search_base": "",
  "ldap_search_filter": "",
  "ldap_user_group": "",
  "oauth2_provider_url": "",
  "oauth2_client_id": "",
  "oauth2_client_secret": "",
  "oauth2_redirect_uri": "",
  "models": [
    {
      "name": "yolov5s",
      "path": "/models/yolov5s.onnx",
      "labels": "/models/coco_labels.txt",
      "input_size": [
        640,
        640,
        3
      ]
    },
    {
      "name": "face_detector",
      "path": "/models/face_detector.onnx",
      "input_size": [
        320,
        320,
        3
      ]
    }
  ],
  "default_device": "cpu",
  "devices": [
    {
      "device_id": "cpu_1",
      "type": "cpu",
      "label": "Main CPU"
    }
  ],
  "rate_limit_rpm": 60,
  "cors_origins": [
    "https://dashboard.example.com"
  ],
  "session_timeout": 3600,
  "audit_logging": false,
  "audit_log_file": "/var/log/berrynet/audit.log",
  "frontend_dir": "/usr/share/berrynet/dashboard/static"
}
