{
  "DAEMON": {
    "type": "string",
    "default": "/usr/sbin/dibbler-server",
    "description": "Path to the dibbler-server executable"
  },
  "NAME": {
    "type": "string",
    "default": "dibbler-server",
    "description": "Service name (matches init script filename)"
  },
  "DESC": {
    "type": "string",
    "default": "DHCPv6 server",
    "description": "Service description"
  },
  "DAEMON_OPTS": {
    "type": "string",
    "default": "run",
    "description": "Options passed to the dibbler-server daemon",
    "enum": [
      "run",
      "start",
      "stop",
      "status",
      "install",
      "uninstall"
    ]
  }
}
