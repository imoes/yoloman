{# cmatrix configuration template #}
{# NOTE: cmatrix does not read configuration files. All options must be passed as command-line arguments. #}
{# This template generates the argument string to be used in the Ansible command or shell module. #}

{# cli_args: List of command-line arguments to pass to cmatrix. Each item is a bare string argument (e.g., ['-a', '-u', '2', '-C', 'red']). Order matters #}
{% set args = (cli_args | default([], true)) %}
{%- if args | length > 0 -%}
    {{ args | join(' ') }}
{%- endif %}