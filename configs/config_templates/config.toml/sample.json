{
  "sandbox_image": "k8s.gcr.io/pause:3.9",
  "max_container_log_line_size": 16384,
  "systemd_cgroup": true,
  "enable_streaming": true,
  "streaming_server_address": "0.0.0.0",
  "streaming_server_port": "10010",
  "enable_tls_streaming": false,
  "stream_server_tls_cert": "",
  "stream_server_tls_key": "",
  "stream_server_tls_ca": "",
  "snapshotter": "overlayfs",
  "default_runtime_name": "runc",
  "runtimes": [
    {
      "name": "runc",
      "runtime_type": "io.containerd.runc.v2",
      "options": {
        "SystemdCgroup": "true"
      }
    },
    {
      "name": "crun",
      "runtime_type": "io.containerd.crun.v1",
      "runtime_engine": "/usr/bin/crun",
      "privileged_without_host_devices": false
    }
  ],
  "registry_mirrors": [
    {
      "namespace": "docker.io",
      "endpoints": [
        "https://docker.mirror.example.com"
      ]
    },
    {
      "namespace": "k8s.gcr.io",
      "endpoints": [
        "https://gcr.mirror.example.com"
      ]
    }
  ],
  "registry_config_path": "/etc/containerd/certs",
  "registry_configs": [
    {
      "hostname": "myregistry.internal",
      "auth_username": "deploy",
      "auth_password": "secret123"
    }
  ],
  "enable_image_decryption": false,
  "tls_cert_file": "",
  "tls_key_file": "",
  "discard_unpacked_layers": true,
  "debug_level": "info",
  "metrics_address": "127.0.0.1:1338",
  "plugins_opt_path": "/opt/containerd"
}
