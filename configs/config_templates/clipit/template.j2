# ==============================================================================
# Desktop Entry File for ClipIt Clipboard Manager
# ==============================================================================
# This template generates a standard .desktop file for the ClipIt application.
# It configures the application name, command execution, visibility in specific
# desktop environments, and autostart behavior.
#
# Schema Variables Used:
# - exec_command: Command to execute the ClipIt clipboard manager
# - terminal: Whether to run in a terminal window
# - only_show_in: Desktop environments in which this entry should be shown
# - autostart_enabled: Whether ClipIt should start automatically on desktop session launch
# ==============================================================================

[Desktop Entry]

# Application Name (English)
Name=ClipIt

