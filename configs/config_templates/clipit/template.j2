# Icon file name for the application
Icon=clipit-trayicon

# Exec: Command to execute the ClipIt clipboard manager
# Schema: exec_command (default='clipit')
Exec={{ exec_command | default('clipit') }}

# Terminal: Whether to run in a terminal window
# Schema: terminal (default=False)
# Values expected: true or false (boolean)
Terminal={{ terminal | default(false) | bool }}

# Type: Entry type, must be Application for desktop launchers
Type=Application

# OnlyShowIn: Desktop environments in which this entry should be shown
# Schema: only_show_in (default='GNOME;XFCE;LXDE;Unity;')
# Format: Semicolon-separated list of desktop environment tokens
OnlyShowIn={{ only_show_in | default('GNOME;XFCE;LXDE;Unity;') }}

# X-GNOME-Autostart-enabled: Whether ClipIt should start automatically on desktop session launch
# Schema: autostart_enabled (default=True)
# Values expected: true or false (boolean)
X-GNOME-Autostart-enabled={{ autostart_enabled | default(true) | bool }}