# harvid configuration file — HTTP server for Ardour video streaming
# See https://github.com/ardour/harvid for documentation

[server]
# Host interface to bind to (0.0.0.0 for all interfaces)
host = {{ host }}

# TCP port for HTTP connections
port = {{ port }}

# Maximum number of simultaneous client connections
max_connections = {{ max_connections }}

# Timeout (in seconds) for idle connections
timeout = {{ timeout }}

# Enable or disable gzip compression for responses
compression = {{ compression }}

[paths]
# Base directory where video files are served from
root = {{ root }}

# Optional subdirectory under `root` to serve as default index
index_dir = {{ index_dir }}

# Path to optional index template file (if absent, directory listing is auto-generated)
index_template = {{ index_template }}

[logging]
# Path to log file (use '-' for stderr)
file = {{ log_file }}

# Log level: debug, info, warn, error, fatal
level = {{ log_level }}

# Enable or disable access logging
access_log = {{ access_log }}

{% for service in services %}
[service:{{ service.name }}]
# Description: {{ service.description | default('No description') }}
enabled = {{ service.enabled }}

# Root path for this service (relative or absolute)
root = {{ service.root }}

# Optional mount point (e.g., `/videos`, defaults to `/` if omitted)
{% if service.mount %}mount = {{ service.mount }}{% else %}# mount = (unset, uses default root path){% endif %}
{% endfor %}

[security]
# Optional: Enable basic auth (requires username/password file)
enable_basic_auth = {{ enable_basic_auth }}

# Path to password file in htpasswd format (md5, bcrypt supported)
password_file = {{ password_file }}
