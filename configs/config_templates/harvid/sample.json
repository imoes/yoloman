{
  "host": "0.0.0.0",
  "port": 8080,
  "max_connections": 50,
  "timeout": 60,
  "compression": true,
  "root": "/var/lib/harvid/videos",
  "index_dir": "latest",
  "index_template": "",
  "log_file": "/var/log/harvid/harvid.log",
  "log_level": "warn",
  "access_log": false,
  "services": [
    {
      "name": "archive",
      "enabled": true,
      "root": "/archive",
      "mount": "/archive",
      "description": "Archived sessions and backups"
    },
    {
      "name": "projects",
      "enabled": true,
      "root": "/projects",
      "description": "Active project files"
    }
  ],
  "enable_basic_auth": false,
  "password_file": "/etc/harvid/htpasswd"
}
