## Path: Network/Proxy
## /etc/sysconfig/proxy — package-manager + system proxy (SUSE/openSUSE).
## Managed by Bossman. zypper and the system honour these when PROXY_ENABLED="yes".
# Enable the proxy settings below ("yes"/"no").
PROXY_ENABLED="{{ proxy_enabled | default('yes') }}"
# HTTP proxy URL (e.g. http://proxy.example.com:80).
HTTP_PROXY="{{ http_proxy | default('') }}"
# HTTPS proxy URL.
HTTPS_PROXY="{{ https_proxy | default('') }}"
# Comma-separated hosts/domains that bypass the proxy.
NO_PROXY="{{ no_proxy | default('localhost, 127.0.0.1') }}"
