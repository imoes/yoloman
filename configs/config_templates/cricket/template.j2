# Cricket configuration file — generated from template
# General system settings
[global]
# Path to store collected data (RRD files, logs)
vardir = {{ values.global.vardir }}

# Path to store HTML web interface files
htmldir = {{ values.global.htmldir }}

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
loglevel = {{ values.global.loglevel }}

# Number of worker processes for data collection
workers = {{ values.global.workers }}

# Timeout (seconds) for individual data collection attempts
collect_timeout = {{ values.global.collect_timeout }}

# Enable HTTPS for the web interface (requires ssl_cert and ssl_key)
use_https = {% if values.global.use_https %}true{% else %}false{% endif %}

# SSL certificate path (only used if use_https = true)
ssl_cert = {{ values.global.ssl_cert }}

# SSL private key path (only used if use_https = true)
ssl_key = {{ values.global.ssl_key }}

# Listen address for the web interface
web_listen_addr = {{ values.global.web_listen_addr }}

# Listen port for the web interface
web_listen_port = {{ values.global.web_listen_port }}

# Authentication backend: file, ldap, none
auth_backend = {{ values.global.auth_backend }}

# Path to file-based user database (used only if auth_backend = file)
auth_file = {{ values.global.auth_file }}

# LDAP server URI (used only if auth_backend = ldap)
ldap_server = {{ values.global.ldap_server }}

# LDAP bind DN template (%%s replaced with username)
ldap_bind_dn = {{ values.global.ldap_bind_dn }}

# LDAP user search base
ldap_search_base = {{ values.global.ldap_search_base }}

# LDAP user filter (%%s replaced with username)
ldap_user_filter = {{ values.global.ldap_user_filter }}

# LDAP group filter (%%s replaced with username)
ldap_group_filter = {{ values.global.ldap_group_filter }}

# Default timezone for reports and UI
timezone = {{ values.global.timezone }}

# Data source definitions
# Each entry defines how to collect metrics from a host or service
[targets]
{% for target in values.targets %}
# Target: {{ target.name }} — {{ target.description | default('No description') }}
[{{ target.name }}]
host = {{ target.host }}
community = {{ target.community | default('') }}
# SNMP version: 1, 2c, 3 (if using SNMP)
version = {{ target.version | default('2c') }}
# Protocol: snmp, http, exec, file, or custom plugin name
protocol = {{ target.protocol }}
# Path to plugin (if protocol = exec or http plugin)
plugin = {{ target.plugin | default('') }}
# Interval (seconds) between collections
interval = {{ target.interval }}
# Timeout (seconds) for each collection attempt
timeout = {{ target.timeout | default('30') }}
# Max retries before marking collection failed
retries = {{ target.retries | default('2') }}
# RRD step (seconds) — must be multiple of interval
rrd_step = {{ target.rrd_step | default(target.interval) }}
# List of metrics to collect for this target
{% for metric in target.metrics %}
metric_{{ loop.index }}_name = {{ metric.name }}
metric_{{ loop.index }}_oid = {{ metric.oid | default('') }}
metric_{{ loop.index }}_type = {{ metric.type }}
metric_{{ loop.index }}_description = {{ metric.description | default('') }}
metric_{{ loop.index }}_scale = {{ metric.scale | default('1') }}
metric_{{ loop.index }}_offset = {{ metric.offset | default('0') }}
metric_{{ loop.index }}_warning = {{ metric.warning | default('') }}
metric_{{ loop.index }}_critical = {{ metric.critical | default('') }}
{% endfor %}
{% endfor %}

# Report definitions
[reports]
# Default report: traffic summary per target
[traffic_summary]
title = Traffic Summary
type = stack
targets = {% for t in values.reports.traffic_summary.targets | default([]) %}{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}
metrics = traffic_in, traffic_out
period = week

# Additional custom reports (extend as needed)
{% for name, cfg in values.reports.custom.items() %}
[{{ name }}]
title = {{ cfg.title | default(name) }}
type = {{ cfg.type | default('stack') }}
targets = {% for t in cfg.targets | default([]) %}{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}
metrics = {% for m in cfg.metrics | default([]) %}{{ m }}{% if not loop.last %}, {% endif %}{% endfor %}
period = {{ cfg.period | default('week') }}
{% endfor %}

# Graph layout and appearance
[graph]
width = {{ values.graph.width }}
height = {{ values.graph.height }}
font = {{ values.graph.font }}
font_size = {{ values.graph.font_size }}
bg_color = {{ values.graph.bg_color }}
grid_color = {{ values.graph.grid_color }}
legend_position = {{ values.graph.legend_position }}
