{
  "global": {
    "vardir": "/var/lib/cricket",
    "htmldir": "/var/www/cricket",
    "loglevel": "INFO",
    "workers": 4,
    "collect_timeout": 15,
    "use_https": true,
    "ssl_cert": "/etc/ssl/certs/cricket.crt",
    "ssl_key": "/etc/ssl/private/cricket.key",
    "web_listen_addr": "0.0.0.0",
    "web_listen_port": 8080,
    "auth_backend": "file",
    "auth_file": "/etc/cricket/passwd",
    "ldap_server": "",
    "ldap_bind_dn": "",
    "ldap_search_base": "",
    "ldap_user_filter": "",
    "ldap_group_filter": "",
    "timezone": "America/New_York"
  },
  "targets": [
    {
      "name": "core-router-1",
      "description": "Main internet border router",
      "host": "10.0.0.1",
      "community": "public_ro",
      "version": "2c",
      "protocol": "snmp",
      "plugin": "",
      "interval": 300,
      "timeout": 20,
      "retries": 2,
      "rrd_step": 300,
      "metrics": [
        {
          "name": "if_octets",
          "oid": "1.3.6.1.2.1.2.2.1.10,1.3.6.1.2.1.2.2.1.16",
          "type": "COUNTER",
          "description": "Interface traffic (in/out octets)",
          "scale": 8,
          "offset": 0,
          "warning": ">800M",
          "critical": ">900M"
        },
        {
          "name": "cpu_util",
          "oid": "1.3.6.1.4.1.9.9.109.1.1.1.1.8",
          "type": "GAUGE",
          "description": "Router CPU utilization",
          "scale": 1,
          "offset": 0,
          "warning": ">70",
          "critical": ">90"
        }
      ]
    },
    {
      "name": "app-server-1",
      "description": "Primary application server",
      "host": "10.0.0.10",
      "community": "public_ro",
      "version": "2c",
      "protocol": "exec",
      "plugin": "/usr/lib/cricket/plugins/app-metrics.sh",
      "interval": 60,
      "timeout": 10,
      "retries": 1,
      "rrd_step": 60,
      "metrics": [
        {
          "name": "load",
          "type": "GAUGE",
          "description": "1-minute system load",
          "scale": 1,
          "offset": 0
        },
        {
          "name": "mem_util",
          "type": "GAUGE",
          "description": "Memory utilization %",
          "scale": 1,
          "offset": 0,
          "warning": ">80",
          "critical": ">95"
        }
      ]
    }
  ],
  "reports": {
    "traffic_summary": {
      "targets": [
        "core-router-1"
      ]
    },
    "custom": [
      {
        "name": "app_health",
        "title": "Application Health",
        "type": "line",
        "targets": [
          "app-server-1"
        ],
        "metrics": [
          "load",
          "mem_util"
        ],
        "period": "day"
      }
    ]
  },
  "graph": {
    "width": 800,
    "height": 200,
    "font": "DejaVu Sans",
    "font_size": 10,
    "bg_color": "#f8f8f8",
    "grid_color": "#cccccc",
    "legend_position": "bottom"
  }
}
