# =============================================================================
# OsmoBTS Configuration Template
# =============================================================================
# This template generates the main OsmoBTS configuration file (e.g., osmo-bts-trx.conf).
# It defines physical layers, BTS parameters, transceiver settings, and network
# connectivity to OsmoTRX and the OML (Operation and Maintenance Link).
# =============================================================================

# --- Physical Layer Configuration ---
# Defines the primary physical layer instance.

# phy_id: Physical layer ID.
# Default: 0
phy {{ phy_id | default('0') }}

# phy_instance: Physical layer instance ID.
# Default: 0
 instance {{ phy_instance | default('0') }}

#   osmotrx_rx_gain: OsmoTRX RX gain level.
#   Default: 1
#   This value sets the receive gain for the transceiver connected to this PHY.
  osmotrx rx-gain {{ osmotrx_rx_gain | default('1') }}

# osmotrx_ip_local: Local IP address for OsmoTRX communication.
# Default: 127.0.0.1
# This is the local endpoint for the socket connection to OsmoTRX.
 osmotrx ip local {{ osmotrx_ip_local | default('127.0.0.1') }}

# osmotrx_ip_remote: Remote IP address for OsmoTRX communication.
# Default: 127.0.0.1
# This specifies the remote endpoint where OsmoTRX is listening.
 osmotrx ip remote {{ osmotrx_ip_remote | default('127.0.0.1') }}

# --- BTS Configuration ---
# Defines the Base Transceiver Station parameters.

# bts_id: Base Transceiver Station ID.
# Default: 0
# This identifier is used in network signaling to distinguish this BTS.
bts {{ bts_id | default('0') }}

# bts_band: Frequency band for the BTS.
# Default: 1800
# Specifies the frequency band of operation (e.g., 900 for E-GSM, 1800 for E-GSM1800).
 band {{ bts_band | default('1800') }}

# ipa unit-id: IPA (IP Abis) Unit ID configuration.
# The Unit ID typically consists of a base value (often derived from band or static) and a suffix.
# ipa_unit_id_suffix: Suffix for the IPA unit ID. Usually matches trx ID or 0.
# Default suffix: 0
 ipa unit-id {{ bts_band | default('1800') }} {{ ipa_unit_id_suffix | default('0') }}

# oml_remote_ip: Remote IP address for OML (Operation and Maintenance Link) connection.
# Default: 127.0.0.1
# The OML connects the BTS to the BSC (Base Station Controller) or similar network management entity.
 oml remote-ip {{ oml_remote_ip | default('127.0.0.1') }}

# --- Transceiver Configuration ---
# Defines the specific transceiver hardware/logic unit.

# trx_id: Transceiver ID.
# Default: 0
trx {{ trx_id | default('0') }}

#   phy: PHY instance associated with this transceiver.
#   Links the transceiver to a specific physical layer instance.
#   phy_id: Physical layer ID (reused here for binding).
#   trx_phy_instance: PHY instance associated with this transceiver.
#   Default: 0
  phy {{ phy_id | default('0') }} instance {{ trx_phy_instance | default('0') }}
