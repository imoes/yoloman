# SpamOracle configuration file
# Generated for {{ service_name | default('spamoracle') }}
# This is the main configuration file for the SpamOracle spam filtering engine.

# Name of the service or package being configured.
service_name: {{ service_name | default('spamoracle') }}

# Database file path.
# Path to the binary database file. Can end in .gz for automatic compression.
DatabaseFile: {{ database_file | default('~/.spamoracle.db') }}

# Threshold for classifying a message as spam.
# Score >= spam_threshold and >= min_words results in 'yes'.
spam_threshold: {{ spam_threshold | default(0.8) }}

# Threshold for classifying a message as good.
# Score <= good_threshold and >= min_words results in 'no'.
good_threshold: {{ good_threshold | default(0.2) }}

# Minimum number of interesting words required for classification.
# If fewer words are found, result is 'unknown'.
min_words: {{ min_words | default(5) }}