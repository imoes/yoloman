{
  "instance_id": {
    "type": "string",
    "description": "Instance identifier (used as index in array-like variable names)"
  },
  "name": {
    "type": "string",
    "default": "default",
    "description": "Short name printed on start/stop"
  },
  "user": {
    "type": "string",
    "default": "buildbot",
    "description": "User to run master as"
  },
  "basedir": {
    "type": "string",
    "default": "/var/lib/buildbot/masters/default",
    "description": "Absolute path to master's basedir"
  },
  "options": {
    "type": "string",
    "default": "",
    "description": "Buildbot options"
  },
  "prefixcmd": {
    "type": "string",
    "default": "",
    "description": "Prefix command, e.g. nice, linux32, dchroot"
  },
  "master_enabled": {
    "type": "string",
    "default": "0",
    "description": "Enable (1/true/yes) or disable (0/false/no) the buildbot master instance",
    "enum": [
      "0",
      "1",
      "false",
      "true",
      "no",
      "yes"
    ]
  }
}
