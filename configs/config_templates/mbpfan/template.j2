#! /bin/sh
### BEGIN INIT INFO
# Provides:          mbpfan
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: mbpfan initscript
# Description:       Start the mbpfan daemon
### END INIT INFO

DESC="Start the mbpfan daemon"
NAME=mbpfan
PATH=/sbin:/usr/sbin:/bin:/usr/bin
DAEMON=/usr/sbin/$NAME
PIDFILE=/var/run/$NAME.pid
SCRIPTNAME=/etc/init.d/$NAME

# Path to the log file. Use 'syslog' to log to system journal instead.
DAEMON_ARGS="--log {{ log_file | default('/var/log/mbpfan.log') }}"

# Minimum fan speed as RPM (e.g., '2000') or 'auto' to let mbpfan infer.
DAEMON_ARGS="${DAEMON_ARGS} --min_fan {{ min_fan_speed | default('2000') }}"

# Maximum fan speed as RPM (e.g., '6200') or 'max' to allow full speed.
DAEMON_ARGS="${DAEMON_ARGS} --max_fan {{ max_fan_speed | default('6200') }}"

# Temperature (°C) at which fans switch to low speed.
DAEMON_ARGS="${DAEMON_ARGS} --low_temp {{ low_temp_threshold | default(55) }}"

# Temperature (°C) at which fans switch to medium speed.
DAEMON_ARGS="${DAEMON_ARGS} --medium_temp {{ medium_temp_threshold | default(65) }}"

# Temperature (°C) at which fans switch to high speed.
DAEMON_ARGS="${DAEMON_ARGS} --high_temp {{ high_temp_threshold | default(75) }}"

# Interval in seconds between temperature checks.
DAEMON_ARGS="${DAEMON_ARGS} --poll {{ poll_interval | default(2) }}"

# Whether users can manually set fan speeds via sysfs (e.g., /sys/class/hwmon/hwmon0/fan1_input).
DAEMON_ARGS="${DAEMON_ARGS} --manual {{ allow_manual_override | default(false) | ternary('true', 'false') }}"

# Fan control method: 'auto' (recommended), 'smc' (Apple System Management Controller), or legacy methods if supported.
DAEMON_ARGS="${DAEMON_ARGS} --fan_method {{ fan_method | default('auto') }}"

# Proportional gain for PID fan control (used if PID is enabled via compiled-in or kernel support).
DAEMON_ARGS="${DAEMON_ARGS} --kp {{ kp | default(2.0) }}"

# Integral gain for PID fan control.
DAEMON_ARGS="${DAEMON_ARGS} --ki {{ ki | default(0.05) }}"

# Derivative gain for PID fan control.
DAEMON_ARGS="${DAEMON_ARGS} --kd {{ kd | default(0.5) }}"

# Maximum integral term to prevent wind-up in PID control.
DAEMON_ARGS="${DAEMON_ARGS} --integral_max {{ integral_max | default(1000) }}"

# List of thermal zone or hwmon paths to ignore when computing average temperature.
{% if exclude_paths | default([]) | length > 0 %}
DAEMON_ARGS="${DAEMON_ARGS} --exclude {% for path in exclude_paths | default([]) %}{{ path }} {% endfor %}"
{% endif %}

# Override list of temperature sensor paths (leave empty to auto-detect).
{% if temp_sources | default([]) | length > 0 %}
DAEMON_ARGS="${DAEMON_ARGS} --sources {% for source in temp_sources | default([]) %}{{ source }} {% endfor %}"
{% endif %}

# Whether mbpfan is enabled and should manage fans.
# Note: This template generates the daemon arguments; enabling the service itself is typically handled
# by the service manager (systemd/upstart) or this init script's start logic.
# If this script is meant to be a no-op when disabled, wrap the execution here:
# {% if enabled | default(true) | bool %}
# exec start-stop-daemon ...
# {% else %}
# echo "mbpfan is disabled."
# {% endif %}