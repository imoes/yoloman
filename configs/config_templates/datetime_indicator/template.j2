# Configuration for Lomiri DateTime Indicator
# Enables/disables the indicator applet
enabled={{ enabled }}

# Path to custom clock format string (uses strftime syntax)
# Leave empty to use default system clock format
clock_format={{ clock_format | default('') | tojson }}

# Enable or disable the 24-hour clock
clock_use_24h={{ clock_use_24h }}

# Show seconds in clock (if supported by format)
clock_show_seconds={{ clock_show_seconds }}

# Show date below clock
clock_show_date={{ clock_show_date }}

# Show calendar popup on click
calendar_enabled={{ calendar_enabled }}

# Show events from default calendar app
calendar_show_events={{ calendar_show_events }}

# Number of upcoming events to show in popup
calendar_max_events={{ calendar_max_events }}

# Timezone display mode: "local", "home", "both"
clock_timezone_mode={{ clock_timezone_mode }}

# Home timezone (ISO 3166-1 alpha-2 country code or IANA timezone name)
clock_home_timezone={{ clock_home_timezone | tojson }}

# Format for date in calendar (strftime syntax)
calendar_date_format={{ calendar_date_format | tojson }}

# Format for time in calendar (strftime syntax)
calendar_time_format={{ calendar_time_format | tojson }}

# List of custom event sources to show (e.g., local calendar files)
# Each entry: { "type": "file"|"webcal", "name": "", "url_or_path": "" }
{% for source in event_sources %}
event_source_{{ loop.index0 }}_type={{ source.type | tojson }}
event_source_{{ loop.index0 }}_name={{ source.name | tojson }}
event_source_{{ loop.index0 }}_url_or_path={{ source.url_or_path | tojson }}
{% endfor %}

# Show weather in calendar (requires weather-indicator backend)
calendar_show_weather={{ calendar_show_weather }}

# Weather location ID (e.g., OpenWeatherMap city ID)
weather_location_id={{ weather_location_id | default('') | tojson }}

# Units for weather: "metric", "imperial"
weather_units={{ weather_units }}
