{
  "extra_attrs": [],
  "creation_date": "2026-06-28T08:15:32Z",
  "modification_date": "2026-06-28T08:15:32Z",
  "version": "14.10",
  "config_version": "14.10",
  "sync_mode": "update",
  "update_strategy": "byTimestamp",
  "timestamp_preservation": true,
  "folder_pairs": [
    {
      "left": "/home/user/Pictures",
      "right": "/mnt/backup/Pictures",
      "ignore_patterns": [
        "*.tmp",
        "Thumbs.db"
      ],
      "file_filter": [
        "*.jpg",
        "*.jpeg",
        "*.png",
        "*.heic"
      ]
    },
    {
      "left": "/var/www/html",
      "right": "/backup/www",
      "file_filter": [
        "*.html",
        "*.css",
        "*.js",
        "*.php"
      ]
    }
  ],
  "comparison_method": "size",
  "binary_comparison": false,
  "on_conflict": "keepBoth",
  "on_error": "continue",
  "deletion_behavior": "left",
  "move_detection": true,
  "log_level": "detailed",
  "log_file": "/var/log/freefilesync/sync.log",
  "max_parallel_files": 8,
  "max_parallel_ops": 12,
  "email_recipients": [
    "admin@example.com"
  ]
}
