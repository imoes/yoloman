{
  "talk_enabled": true,
  "ntalk_enabled": true,
  "talk_user": "root",
  "talkd_path": "/usr/sbin/in.talkd",
  "extra_services": [
    {
      "name": "time",
      "socket_type": "stream",
      "protocol": "tcp",
      "wait": "nowait",
      "user": "root",
      "server_path": "/usr/sbin/in.timed",
      "server_args": "in.timed",
      "description": "Time server (RFC 868) \u2014 returns current time as a 32-bit Unix timestamp.",
      "enabled": false
    }
  ]
}
