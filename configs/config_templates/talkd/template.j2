# /etc/inetd.conf -- Internet superserver configuration
# Managed by configuration template. Edit values, not this file directly.
#
# Format: service  socket_type  protocol  wait[.max]  user[.group]  server_path  server_args
# Disable a service by setting enabled=false — the entry is commented out.

# talk: Original BSD talk protocol, UDP port 517.
# Provides a real-time two-way split-screen chat between users on different hosts.
{% if talk_enabled %}
talk    dgram   udp     wait    {{ talk_user }}    {{ talkd_path }}    in.talkd
{% else %}
#talk   dgram   udp     wait    {{ talk_user }}    {{ talkd_path }}    in.talkd
{% endif %}

# ntalk: New talk protocol, UDP port 518.
# Preferred by modern clients; supports ringing notifications and an improved UI.
{% if ntalk_enabled %}
ntalk   dgram   udp     wait    {{ talk_user }}    {{ talkd_path }}    in.talkd
{% else %}
#ntalk  dgram   udp     wait    {{ talk_user }}    {{ talkd_path }}    in.talkd
{% endif %}
{% if extra_services %}

# Additional inetd-managed services on this host.
{% for svc in extra_services %}
# {{ svc.description }}
{% if svc.enabled %}
{{ svc.name }}    {{ svc.socket_type }}    {{ svc.protocol }}    {{ svc.wait }}    {{ svc.user }}    {{ svc.server_path }}    {{ svc.server_args }}
{% else %}
#{{ svc.name }}    {{ svc.socket_type }}    {{ svc.protocol }}    {{ svc.wait }}    {{ svc.user }}    {{ svc.server_path }}    {{ svc.server_args }}
{% endif %}
{% endfor %}
{% endif %}
