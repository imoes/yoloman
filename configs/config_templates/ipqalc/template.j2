# ==============================================================================
# IPQC Application License Calculator (ipqalc) Configuration Template
# ==============================================================================
#
# ipqalc is a specialized tool for calculating intellectual property quality
# control metrics (IPQC). This configuration file manages its operational
# parameters, logging, and output settings.
#
# Since the provided schema for 'ipqalc' is empty, this template provides
# a safe, self-documenting baseline configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------

# The working directory where ipqalc stores temporary files and state.
# Default: /var/lib/ipqalc
working_dir = {{ ipqalc_working_dir | default('/var/lib/ipqalc') }}

# The user account under which ipqalc runs.
# Default: ipqalc
run_as_user = {{ ipqalc_run_as_user | default('ipqalc') }}

# The group associated with the running user.
# Default: ipqalc
run_as_group = {{ ipqalc_run_as_group | default('ipqalc') }}

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------

# The log file path.
# Default: /var/log/ipqalc/ipqalc.log
log_file = {{ ipqalc_log_file | default('/var/log/ipqalc/ipqalc.log') }}

# The verbosity level of logs. 0=error, 1=warning, 2=info, 3=debug.
# Default: 2
log_level = {{ ipqalc_log_level | default(2) }}

# Whether to also log to the system syslog.
# Default: false
syslog_enabled = {{ ipqalc_syslog_enabled | default(false) }}

# The facility for syslog messages.
# Default: local0
syslog_facility = {{ ipqalc_syslog_facility | default('local0') }}

# ------------------------------------------------------------------------------
# Calculation Settings
# ------------------------------------------------------------------------------

# The precision of floating-point calculations.
# Default: 6
calc_precision = {{ ipqalc_calc_precision | default(6) }}

# The timeout in seconds for individual calculation tasks.
# Default: 30
task_timeout = {{ ipqalc_task_timeout | default(30) }}

# The maximum number of concurrent worker processes.
# Default: 4
max_workers = {{ ipqalc_max_workers | default(4) }}

# ------------------------------------------------------------------------------
# Output Configuration
# ------------------------------------------------------------------------------

# The default output format for results: json, xml, csv, or text.
# Default: json
default_output_format = {{ ipqalc_default_output_format | default('json') }}

# The directory to store generated reports.
# Default: /var/lib/ipqalc/reports
report_dir = {{ ipqalc_report_dir | default('/var/lib/ipqalc/reports') }}

# ------------------------------------------------------------------------------
# Network / API Settings (if applicable)
# ------------------------------------------------------------------------------

# Whether to enable the built-in HTTP status API.
# Default: false
api_enabled = {{ ipqalc_api_enabled | default(false) }}

# The address to bind the API listener to.
# Default: 127.0.0.1
api_bind_address = {{ ipqalc_api_bind_address | default('127.0.0.1') }}

# The port to bind the API listener to.
# Default: 9090
api_port = {{ ipqalc_api_port | default(9090) }}

# The secret key for API authentication.
# Default: change_me
api_secret_key = {{ ipqalc_api_secret_key | default('change_me') }}