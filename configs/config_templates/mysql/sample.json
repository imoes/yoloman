{
  "mysqld_bind_address": "0.0.0.0",
  "mysqld_port": 3306,
  "mysqld_basedir": "/usr",
  "mysqld_datadir": "/var/lib/mysql",
  "mysqld_thread_cache_size": 16,
  "mysqld_max_connections": 300,
  "mysqld_wait_timeout": 600,
  "mysqld_max_allowed_packet": "128M",
  "mysqld_innodb_buffer_pool_size": "2G",
  "mysqld_innodb_log_file_size": "256M",
  "mysqld_innodb_flush_method": "O_DIRECT",
  "mysqld_query_cache_type": "",
  "mysqld_query_cache_size": "",
  "mysqld_character_set_server": "utf8mb4",
  "mysqld_collation_server": "utf8mb4_unicode_ci",
  "mysqld_ssl_enabled": true,
  "mysqld_ssl_ca": "/etc/mysql/ssl/ca.pem",
  "mysqld_ssl_cert": "/etc/mysql/ssl/server-cert.pem",
  "mysqld_ssl_key": "/etc/mysql/ssl/server-key.pem",
  "mysqld_slow_query_log_enabled": true,
  "mysqld_slow_query_log_file": "/var/log/mysql/slow.log",
  "mysqld_long_query_time": 1,
  "mysqld_binlog_enabled": true,
  "mysqld_binlog_path": "/var/log/mysql/binlog",
  "mysqld_binlog_format": "ROW",
  "mysqld_expire_logs_days": 14,
  "mysqld_server_id": 101,
  "mysqld_replicate_do_db": [
    "app_prod"
  ],
  "mysqld_replicate_ignore_db": [
    "test",
    "mysql"
  ],
  "mysqld_custom_vars": {
    "tmp_table_size": "256M",
    "join_buffer_size": "128K"
  },
  "client_port": 3306,
  "client_character_set": "utf8mb4"
}
