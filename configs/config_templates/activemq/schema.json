{
  "broker_name": {
    "type": "string",
    "default": "localhost",
    "description": "Logical name of the ActiveMQ broker."
  },
  "data_directory": {
    "type": "string",
    "default": "/var/lib/activemq/data",
    "description": "Directory for persistent message storage (used with kahaDB)."
  },
  "use_jmx": {
    "type": "bool",
    "default": true,
    "description": "Enable JMX monitoring and management."
  },
  "management_context_create_connector": {
    "type": "bool",
    "default": false,
    "description": "Whether to create an RMI connector for JMX (requires authentication)."
  },
  "management_context_connector_port": {
    "type": "number",
    "default": 1099,
    "description": "Port for JMX RMI connector (used when createConnector is true)."
  },
  "use_shutdown_hook": {
    "type": "bool",
    "default": true,
    "description": "Enable graceful shutdown on SIGTERM."
  },
  "persistence_adapter_type": {
    "type": "string",
    "default": "kahaDB",
    "description": "Persistence backend: 'kahaDB' (file-based), or 'memory' (non-persistent)."
  },
  "kahadb_directory": {
    "type": "string",
    "default": "/var/lib/activemq/kahadb",
    "description": "Directory for kahaDB data files."
  },
  "kahadb_journal_max_file_length": {
    "type": "number",
    "default": 33554432,
    "description": "Maximum size (bytes) of each journal log file."
  },
  "kahadb_index_cache_size": {
    "type": "number",
    "default": 10000,
    "description": "Number of index entries cached in memory."
  },
  "transport_connectors": {
    "type": "list",
    "default": [
      {
        "name": "openwire",
        "uri": "tcp://0.0.0.0:61616?wireFormat.maxInactivityDuration=30000"
      }
    ],
    "description": "List of transport connector endpoints for client connections.",
    "items": {
      "type": "object",
      "fields": {
        "name": {
          "type": "string",
          "description": "Transport connector name (e.g., 'openwire', 'stomp')"
        },
        "uri": {
          "type": "string",
          "description": "Connection URI (e.g., 'tcp://host:port')"
        },
        "discovery_uri": {
          "type": "string",
          "optional": true,
          "description": "Discovery URI for network announce (e.g., 'multicast://default')"
        },
        "enabled": {
          "type": "bool",
          "optional": true,
          "description": "Whether this connector is active (default: true)."
        }
      }
    }
  },
  "network_connectors": {
    "type": "list",
    "default": [],
    "description": "List of network connectors for bridging to other brokers.",
    "items": {
      "type": "object",
      "fields": {
        "name": {
          "type": "string",
          "description": "Network connector name"
        },
        "uri": {
          "type": "string",
          "description": "Remote broker URI (e.g., 'static://(tcp://remote:61616)')"
        },
        "dynamically_include": {
          "type": "bool",
          "optional": true,
          "description": "Include dynamically discovered destinations"
        },
        "static_include": {
          "type": "bool",
          "optional": true,
          "description": "Include statically configured destinations"
        },
        "prefetch_size": {
          "type": "number",
          "optional": true,
          "description": "Message prefetch size for consumers"
        },
        "max_network_hops": {
          "type": "number",
          "optional": true,
          "description": "Maximum number of network hops for forwarded messages"
        }
      }
    }
  },
  "system_usage": {
    "type": "object",
    "default": {
      "memory_limit": "1024mb",
      "store_limit": "100gb",
      "store_name": "store",
      "temp_limit": "100gb"
    },
    "description": "System resource usage limits.",
    "fields": {
      "memory_limit": {
        "type": "string",
        "description": "Max memory allowed (e.g., '1024mb', '512mb')"
      },
      "store_limit": {
        "type": "string",
        "description": "Max persistent storage (e.g., '100gb')"
      },
      "store_name": {
        "type": "string",
        "description": "Name of the store usage region"
      },
      "temp_limit": {
        "type": "string",
        "description": "Max temp directory usage (e.g., '50gb')"
      }
    }
  },
  "destination_policies": {
    "type": "list",
    "default": [
      {
        "destination": ">",
        "memory_limit": "100mb",
        "prefetch_size": 1000,
        "gcInactiveDestinations": true,
        "inactiveTimoutBeforeGC": 300000
      }
    ],
    "description": "Per-destination behavior policies (applies to queues or topics).",
    "items": {
      "type": "object",
      "fields": {
        "destination": {
          "type": "string",
          "description": "Destination pattern (e.g., '>', 'MyQueue.*')"
        },
        "memory_limit": {
          "type": "string",
          "optional": true,
          "description": "Max memory per destination (e.g., '50mb')"
        },
        "prefetch_size": {
          "type": "number",
          "optional": true,
          "description": "Max messages prefetched per consumer"
        },
        "expireMessagesPeriod": {
          "type": "number",
          "optional": true,
          "description": "Interval (ms) to check for expired messages"
        },
        "gcInactiveDestinations": {
          "type": "bool",
          "optional": true,
          "description": "Enable garbage collection of idle destinations"
        },
        "inactiveTimoutBeforeGC": {
          "type": "number",
          "optional": true,
          "description": "Time (ms) before inactive destination is GC'd"
        }
      }
    }
  },
  "enable_auth": {
    "type": "bool",
    "default": false,
    "description": "Enable basic authentication and authorization (ACLs)."
  },
  "auth_users": {
    "type": "list",
    "default": [],
    "description": "Users allowed to connect (if auth enabled).",
    "items": {
      "type": "object",
      "fields": {
        "username": {
          "type": "string",
          "description": "Username"
        },
        "password": {
          "type": "string",
          "description": "Password (plaintext \u2014 use only in trusted environments)"
        },
        "groups": {
          "type": "list",
          "description": "Comma-separated list of groups (e.g., ['admins', 'users'])"
        }
      }
    }
  },
  "auth_acls": {
    "type": "list",
    "default": [],
    "description": "Access control rules (if auth enabled).",
    "items": {
      "type": "object",
      "fields": {
        "destination": {
          "type": "string",
          "description": "Destination pattern (e.g., '>', 'MY.>') "
        },
        "operation": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "admin",
            "*"
          ],
          "description": "Operation type: 'read', 'write', 'admin', or '*' (all)"
        },
        "groups": {
          "type": "list",
          "description": "List of allowed groups for this ACL"
        }
      }
    }
  },
  "enable_jetty_console": {
    "type": "bool",
    "default": false,
    "description": "Enable embedded Jetty web console (requires activemq-web module)."
  }
}
