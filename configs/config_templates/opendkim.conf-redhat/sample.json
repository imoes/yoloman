{
  "canonicalization": "relaxed/relaxed",
  "key_file": "/etc/opendkim/keys/default.private",
  "log_why": "yes",
  "minimum_key_bits": "1024",
  "mode": "v",
  "oversign_headers": "From",
  "pid_file": "/run/opendkim/opendkim.pid",
  "selector": "default",
  "send_reports": "yes",
  "software_header": "yes",
  "syslog": "yes",
  "syslog_success": "yes",
  "umask": "002",
  "user_id": "opendkim:opendkim"
}
