# PAM configuration file — controls authentication and session behavior for services
# Each line defines a rule for a service, control flag, module type, and module arguments
{% for service in services %}
# Service: {{ service.name }}
# Type: {{ service.type }} — {{ 'Authentication' if service.type == 'auth' else 'Account management' if service.type == 'account' else 'Session management' if service.type == 'session' else 'Password management' }}
{{ service.name }}	{{ service.control_flag }}	{{ service.module_type }}	{{ service.module_path }}{% if service.module_args %}	{{ service.module_args | join(' ') }}{% endif %}
{% endfor %}