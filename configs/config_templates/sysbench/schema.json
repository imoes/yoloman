{
  "threads": {
    "type": "number",
    "default": 4,
    "description": "Number of threads to use."
  },
  "events": {
    "type": "number",
    "default": 0,
    "description": "Limit for total number of events (0 for unlimited)."
  },
  "time_limit": {
    "type": "number",
    "default": 10,
    "description": "Limit for total execution time in seconds."
  },
  "forced_shutdown": {
    "type": "string",
    "default": "off",
    "description": "Seconds to wait after --time limit before forcing shutdown, or 'off'."
  },
  "thread_stack_size": {
    "type": "string",
    "default": "32K",
    "description": "Size of stack per thread (e.g., 64K, 32K)."
  },
  "rate_limit": {
    "type": "number",
    "default": 0,
    "description": "Average transactions rate. 0 for unlimited."
  },
  "report_interval": {
    "type": "number",
    "default": 0,
    "description": "Interval in seconds for intermediate statistics reports (0 to disable)."
  },
  "report_checkpoints": {
    "type": "list",
    "default": [],
    "description": "List of time points in seconds for full statistics dumps."
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Print more debugging info."
  },
  "validate": {
    "type": "bool",
    "default": false,
    "description": "Perform validation checks where possible."
  },
  "verbosity": {
    "type": "number",
    "default": 3,
    "description": "Verbosity level (0-5)."
  },
  "percentile": {
    "type": "number",
    "default": 95,
    "description": "Percentile for latency statistics (1-100, 0 to disable)."
  },
  "histogram": {
    "type": "bool",
    "default": false,
    "description": "Print latency histogram in report."
  },
  "rand_type": {
    "type": "string",
    "default": "special",
    "description": "Random numbers distribution {uniform,gaussian,pareto}.",
    "enum": [
      "uniform",
      "gaussian",
      "pareto",
      "special"
    ]
  },
  "rand_seed": {
    "type": "number",
    "default": 0,
    "description": "Seed for random number generator (0 to use current time)."
  },
  "db_driver": {
    "type": "string",
    "default": "mysql",
    "description": "Database driver to use ('mysql' or 'pgsql').",
    "enum": [
      "mysql",
      "pgsql"
    ]
  },
  "db_ps_mode": {
    "type": "string",
    "default": "auto",
    "description": "Prepared statements usage mode {auto, disable}.",
    "enum": [
      "auto",
      "disable"
    ]
  },
  "mysql_host": {
    "type": "list",
    "default": [
      "localhost"
    ],
    "description": "MySQL server host(s). List of strings."
  },
  "mysql_port": {
    "type": "number",
    "default": 3306,
    "description": "MySQL server port."
  },
  "mysql_socket": {
    "type": "string",
    "default": "",
    "description": "MySQL socket path (empty string to omit)."
  },
  "mysql_user": {
    "type": "string",
    "default": "sbtest",
    "description": "MySQL user."
  },
  "mysql_password": {
    "type": "string",
    "default": "",
    "description": "MySQL password (empty string to omit)."
  },
  "mysql_db": {
    "type": "string",
    "default": "sbtest",
    "description": "MySQL database name."
  },
  "mysql_ssl": {
    "type": "bool",
    "default": false,
    "description": "Use SSL connections if available."
  },
  "mysql_ssl_cipher": {
    "type": "string",
    "default": "",
    "description": "Specific cipher for SSL connections (empty string to omit)."
  },
  "mysql_compression": {
    "type": "bool",
    "default": false,
    "description": "Use compression if available."
  },
  "mysql_ignore_errors": {
    "type": "list",
    "default": [
      "1213",
      "1020",
      "1205"
    ],
    "description": "List of error codes to ignore."
  },
  "pgsql_host": {
    "type": "string",
    "default": "localhost",
    "description": "PostgreSQL server host."
  },
  "pgsql_port": {
    "type": "number",
    "default": 5432,
    "description": "PostgreSQL server port."
  },
  "pgsql_user": {
    "type": "string",
    "default": "sbtest",
    "description": "PostgreSQL user."
  },
  "pgsql_password": {
    "type": "string",
    "default": "",
    "description": "PostgreSQL password (empty string to omit)."
  },
  "pgsql_db": {
    "type": "string",
    "default": "sbtest",
    "description": "PostgreSQL database name."
  },
  "test_type": {
    "type": "string",
    "default": "cpu",
    "description": "The type of test to configure {fileio, cpu, memory, threads, mutex}.",
    "enum": [
      "fileio",
      "cpu",
      "memory",
      "threads",
      "mutex"
    ]
  },
  "file_num": {
    "type": "number",
    "default": 128,
    "description": "Number of files to create for FileIO test."
  },
  "file_block_size": {
    "type": "number",
    "default": 16384,
    "description": "Block size for FileIO operations."
  },
  "file_total_size": {
    "type": "string",
    "default": "2G",
    "description": "Total size of files to create for FileIO test."
  },
  "file_test_mode": {
    "type": "string",
    "default": "rndrw",
    "description": "FileIO test mode {seqwr, seqrewr, seqrd, rndrd, rndwr, rndrw}.",
    "enum": [
      "seqwr",
      "seqrewr",
      "seqrd",
      "rndrd",
      "rndwr",
      "rndrw"
    ]
  },
  "file_io_mode": {
    "type": "string",
    "default": "sync",
    "description": "File operations mode {sync, async, mmap}.",
    "enum": [
      "sync",
      "async",
      "mmap"
    ]
  },
  "file_async_backlog": {
    "type": "number",
    "default": 128,
    "description": "Number of asynchronous operations to queue per thread."
  },
  "file_extra_flags": {
    "type": "list",
    "default": [],
    "description": "List of additional flags {sync, dsync, direct}."
  },
  "file_fsync_freq": {
    "type": "number",
    "default": 100,
    "description": "Fsync frequency (0 to disable fsync)."
  },
  "file_fsync_all": {
    "type": "bool",
    "default": false,
    "description": "Fsync after each write operation."
  },
  "file_fsync_end": {
    "type": "bool",
    "default": true,
    "description": "Fsync at the end of test."
  },
  "file_fsync_mode": {
    "type": "string",
    "default": "fsync",
    "description": "Synchronization method {fsync, fdatasync}.",
    "enum": [
      "fsync",
      "fdatasync"
    ]
  },
  "file_merged_requests": {
    "type": "number",
    "default": 0,
    "description": "Merge at most this number of IO requests (0 to disable)."
  },
  "file_rw_ratio": {
    "type": "number",
    "default": 1.5,
    "description": "Reads/writes ratio for combined test."
  },
  "cpu_max_prime": {
    "type": "number",
    "default": 10000,
    "description": "Upper limit for primes generator in CPU test."
  },
  "memory_block_size": {
    "type": "string",
    "default": "1K",
    "description": "Size of memory block for test."
  },
  "memory_total_size": {
    "type": "string",
    "default": "100G",
    "description": "Total size of data to transfer in memory test."
  },
  "memory_scope": {
    "type": "string",
    "default": "global",
    "description": "Memory access scope {global, local}.",
    "enum": [
      "global",
      "local"
    ]
  },
  "memory_hugetlb": {
    "type": "bool",
    "default": false,
    "description": "Allocate memory from HugeTLB pool."
  },
  "memory_oper": {
    "type": "string",
    "default": "write",
    "description": "Type of memory operations {read, write, none}.",
    "enum": [
      "read",
      "write",
      "none"
    ]
  },
  "memory_access_mode": {
    "type": "string",
    "default": "seq",
    "description": "Memory access mode {seq, rnd}.",
    "enum": [
      "seq",
      "rnd"
    ]
  },
  "thread_yields": {
    "type": "number",
    "default": 1000,
    "description": "Number of yields to do per request in threads test."
  },
  "thread_locks": {
    "type": "number",
    "default": 8,
    "description": "Number of locks per thread in threads test."
  },
  "mutex_num": {
    "type": "number",
    "default": 4096,
    "description": "Total size of mutex array in mutex test."
  },
  "mutex_locks": {
    "type": "number",
    "default": 50000,
    "description": "Number of mutex locks to do per thread in mutex test."
  },
  "mutex_loops": {
    "type": "number",
    "default": 10000,
    "description": "Number of empty loops to do outside mutex lock in mutex test."
  }
}
