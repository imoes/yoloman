# LUKSMeta configuration for managing metadata in LUKSv1 headers.
# LUKSMeta allows storing arbitrary metadata (e.g., boot scripts) inside unused sectors
# of a LUKSv1 header. This file controls which device to operate on and which slots to use.

# The block device path where LUKSv1 metadata is stored.
# Defaults to /dev/sda2 if not specified.
device: {{ device | default('/dev/sda2') }}

# List of metadata slots to manage or verify.
# Each entry defines a slot number and UUID associated with specific metadata.
# Slots are processed in order during initialization or verification.
slots:
{% for slot in slots | default([]) %}
# Slot {{ slot.number }}: Stores metadata identified by UUID {{ slot.uuid }}
- number: {{ slot.number }}
  uuid: {{ slot.uuid }}
{% endfor %}

# If true, enables the -f/--force flag.
# This suppresses interactive prompts for dangerous operations like init, nuke, or wipe.
# Useful for unattended automation scripts.
force: {{ force | default(false) | bool | ternary('true', 'false') }}