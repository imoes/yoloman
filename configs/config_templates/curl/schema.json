{
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output for debugging"
  },
  "silent": {
    "type": "bool",
    "default": false,
    "description": "Suppress progress meter (silent mode)"
  },
  "show_error": {
    "type": "bool",
    "default": false,
    "description": "Show error messages even in silent mode"
  },
  "connection_timeout": {
    "type": "number",
    "default": 30,
    "description": "Maximum time in seconds for connection phase"
  },
  "max_time": {
    "type": "number",
    "default": 0,
    "description": "Maximum time in seconds for entire transfer (0 = unlimited)"
  },
  "follow_redirects": {
    "type": "bool",
    "default": true,
    "description": "Follow HTTP redirects (3xx responses)"
  },
  "max_redirects": {
    "type": "number",
    "default": 5,
    "description": "Maximum number of redirects to follow"
  },
  "use_netrc": {
    "type": "bool",
    "default": false,
    "description": "Use ~/.netrc for credentials"
  },
  "netrc_file": {
    "type": "string",
    "default": "",
    "description": "Path to netrc file (alternative to default location)"
  },
  "insecure": {
    "type": "bool",
    "default": false,
    "description": "Skip TLS certificate verification (insecure)"
  },
  "ca_bundle": {
    "type": "string",
    "default": "",
    "description": "Path to CA certificate bundle file (PEM format)"
  },
  "ca_path": {
    "type": "string",
    "default": "",
    "description": "Path to CA certificate directory (PEM format)"
  },
  "client_cert": {
    "type": "string",
    "default": "",
    "description": "Path to client certificate file"
  },
  "client_cert_passphrase": {
    "type": "string",
    "default": "",
    "description": "Passphrase for client certificate"
  },
  "client_key": {
    "type": "string",
    "default": "",
    "description": "Path to client private key file"
  },
  "client_key_passphrase": {
    "type": "string",
    "default": "",
    "description": "Passphrase for client private key"
  },
  "use_compression": {
    "type": "bool",
    "default": true,
    "description": "Request compressed responses"
  },
  "http2": {
    "type": "bool",
    "default": true,
    "description": "Enable HTTP/2 support"
  },
  "proxy": {
    "type": "string",
    "default": "",
    "description": "HTTP or SOCKS proxy address"
  },
  "proxy_user": {
    "type": "string",
    "default": "",
    "description": "Username:password for proxy authentication"
  },
  "proxy_type": {
    "type": "string",
    "default": "http",
    "description": "Proxy type (socks5, socks5h, socks4, socks4a, etc.)",
    "enum": [
      "socks4",
      "socks4a",
      "socks5",
      "socks5h",
      "http"
    ]
  },
  "no_proxy": {
    "type": "list",
    "default": [],
    "description": "Comma-separated list of hosts to exclude from proxy"
  },
  "dns_servers": {
    "type": "list",
    "default": [],
    "description": "List of DNS server IP addresses"
  },
  "dns_interface": {
    "type": "string",
    "default": "",
    "description": "Network interface for DNS requests"
  },
  "user_agent": {
    "type": "string",
    "default": "",
    "description": "Custom User-Agent header string"
  },
  "custom_headers": {
    "type": "list",
    "default": [],
    "description": "List of custom HTTP headers to add"
  },
  "cookie_jar": {
    "type": "string",
    "default": "",
    "description": "File to save cookies to"
  },
  "cookie_file": {
    "type": "string",
    "default": "",
    "description": "File to read cookies from"
  },
  "output_file": {
    "type": "string",
    "default": "",
    "description": "Output file for single URL download"
  },
  "use_remote_name": {
    "type": "bool",
    "default": false,
    "description": "Save using remote filename"
  },
  "output_dir": {
    "type": "string",
    "default": "",
    "description": "Output directory for remote-name operations"
  },
  "create_dirs": {
    "type": "bool",
    "default": false,
    "description": "Create output directories as needed"
  },
  "resume": {
    "type": "bool",
    "default": false,
    "description": "Resume partial download"
  },
  "rate_limit": {
    "type": "string",
    "default": "",
    "description": "Rate limit (e.g., '5/s' or '10/m')"
  },
  "speed_limit": {
    "type": "number",
    "default": 0,
    "description": "Abort if transfer speed drops below this (bytes/sec)"
  },
  "speed_time": {
    "type": "number",
    "default": 30,
    "description": "Time period for speed limit check (seconds)"
  },
  "retry": {
    "type": "number",
    "default": 0,
    "description": "Number of retries on transient errors"
  },
  "retry_delay": {
    "type": "number",
    "default": 1,
    "description": "Initial delay between retries (seconds)"
  },
  "retry_max_time": {
    "type": "number",
    "default": 0,
    "description": "Maximum time allowed for all retries (0 = unlimited)"
  },
  "ipv4_only": {
    "type": "bool",
    "default": false,
    "description": "Use IPv4 only for name resolution"
  },
  "ipv6_only": {
    "type": "bool",
    "default": false,
    "description": "Use IPv6 only for name resolution"
  },
  "tls_min_version": {
    "type": "string",
    "default": "1.0",
    "description": "Minimum TLS version (1.0, 1.1, 1.2, 1.3)",
    "enum": [
      "1.0",
      "1.1",
      "1.2",
      "1.3"
    ]
  },
  "tls_max_version": {
    "type": "string",
    "default": "1.3",
    "description": "Maximum TLS version (1.0, 1.1, 1.2, 1.3)",
    "enum": [
      "1.0",
      "1.1",
      "1.2",
      "1.3"
    ]
  },
  "disable_alpn": {
    "type": "bool",
    "default": false,
    "description": "Disable ALPN TLS extension (for HTTP/2 debugging)"
  },
  "hsts_file": {
    "type": "string",
    "default": "",
    "description": "HSTS cache file path"
  },
  "progress_bar": {
    "type": "bool",
    "default": false,
    "description": "Display progress as simple bar"
  },
  "disable_progress": {
    "type": "bool",
    "default": false,
    "description": "Disable progress meter output"
  },
  "auth_method": {
    "type": "string",
    "default": "any",
    "description": "Authentication method (basic, digest, ntlm, negotiate)",
    "enum": [
      "basic",
      "digest",
      "ntlm",
      "negotiate",
      "any"
    ]
  },
  "user": {
    "type": "string",
    "default": "",
    "description": "Username:password for server authentication"
  },
  "proxy_insecure": {
    "type": "bool",
    "default": false,
    "description": "Skip TLS verification for HTTPS proxy"
  },
  "proxy_auth_method": {
    "type": "string",
    "default": "any",
    "description": "Proxy authentication method (basic, digest)",
    "enum": [
      "basic",
      "digest",
      "ntlm",
      "negotiate",
      "any"
    ]
  },
  "curl_version": {
    "type": "string",
    "default": "unknown",
    "description": "Version string for default User-Agent"
  }
}
