{
  "verbose": false,
  "silent": true,
  "show_error": true,
  "connection_timeout": 10,
  "max_time": 60,
  "follow_redirects": true,
  "max_redirects": 3,
  "use_netrc": false,
  "insecure": false,
  "ca_bundle": "/etc/ssl/certs/ca-certificates.crt",
  "use_compression": true,
  "http2": true,
  "proxy": "http://proxy.example.com:8080",
  "proxy_user": "user:pass",
  "proxy_type": "socks5",
  "no_proxy": [
    "localhost",
    "127.0.0.1",
    ".internal.example.com"
  ],
  "dns_servers": [
    "8.8.8.8",
    "8.8.4.4"
  ],
  "dns_interface": "eth0",
  "user_agent": "ExampleApp/1.0 curl/8.21.0",
  "custom_headers": [
    "X-Request-ID: {{request_id}}",
    "Accept-Encoding: gzip"
  ],
  "cookie_jar": "/var/cache/curl/cookies.txt",
  "cookie_file": "/var/cache/curl/cookies.txt",
  "use_remote_name": true,
  "output_dir": "/tmp/curl",
  "create_dirs": true,
  "resume": true,
  "rate_limit": "10/m",
  "speed_limit": 1000,
  "speed_time": 15,
  "retry": 3,
  "retry_delay": 2,
  "retry_max_time": 60,
  "ipv4_only": false,
  "tls_min_version": "1.2",
  "tls_max_version": "1.3",
  "disable_alpn": false,
  "hsts_file": "/var/cache/curl/hsts.txt",
  "progress_bar": false,
  "disable_progress": false,
  "auth_method": "digest",
  "user": "user:password",
  "curl_version": "8.21.0"
}
