[main]

# Enable automatic refresh of repository metadata before zypper operations
auto_refresh={{ zypper_auto_refresh | default(true) | lower }}

# Enable GPG signature verification for repository metadata and packages
gpg_check={{ zypper_gpg_check | default(true) | lower }}

# Default solver focus mode: Job, Installed, or Update
solver_focus={{ zypper_solver_focus | default('Job') }}

# If true, the solver ignores recommended packages (onlyRequires). If false, it installs recommended packages as well
solver_onlyRequires={{ zypper_solver_only_requires | default(false) | lower }}

# Delay in seconds before automatic metadata refresh is triggered again
repo_refresh_delay={{ zypper_repo_refresh_delay | default(300) }}

[distroverpkg]

# The package name used to derive $releasever for repository URL substitution
distroverpkg={{ zypper_distroverpkg | default('suse-release') }}

[main]

# Directory for storing raw repository metadata
cachedir=/var/cache/zypp/raw

# Directory for storing pre-parsed metadata (solv files)
solvdir=/var/cache/zypp/solv

# Directory for storing downloaded RPM packages
pkgcachdir=/var/cache/zypp/packages

# Log file location
logfile=/var/log/zypper.log