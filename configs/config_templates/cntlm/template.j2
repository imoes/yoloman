#
# Cntlm Authentication Proxy Configuration
#
# NOTE: all values are parsed literally, do NOT escape spaces,
# do not quote. Use 0600 perms if you use plaintext password.
#

# Windows domain account username for NTLM authentication (without domain prefix)
Username {{ username | default('testuser') }}

# Windows domain name — use the NetBIOS short name (e.g. CORP) or FQDN
Domain {{ domain | default('corp-uk') }}

# Plaintext password — only use if you understand risks, prefer hash variants below
# WARNING: Storing passwords in plaintext is insecure. Use PassNTLMv2 instead.
Password {{ plaintext_password | default('password') }}

# NTLMv2 password hash — generate with: cntlm -H -u user@DOMAIN -d DOMAIN
# This is the preferred method for storing credentials securely in the config.
PassNTLMv2 {{ pass_ntlmv2 | default('D5826E9C665C37C80B53397D5C07BBCB') }}

# LM password hash — only required when Auth includes LM; generate with cntlm -H
# Usually not needed for modern environments.
PassLM {{ pass_lm | default('1AD35398BE6565DDB5C4EF70C0593492') }}

# NT password hash — only required when Auth includes NT; generate with cntlm -H
# Usually not needed for modern environments.
PassNT {{ pass_nt | default('77B9081511704EE852F94227CF48A793') }}

# NetBIOS hostname cntlm sends to parent proxies; auto-guessed if omitted
# Useful if proxies require a specific workstation name for Kerberos/NTLM challenges.
Workstation {{ workstation | default('netbios_hostname') }}

# One or more upstream corporate NTLM proxy endpoints; tried in order for failover
# Each line defines a proxy server to authenticate against.
{% for proxy in (proxies | default(['10.0.0.41:8080', '10.0.0.42:8080'])) %}Proxy {{ proxy }}
{% endfor %}

# Hosts, IPs, and wildcard patterns to connect to directly, bypassing the proxy
# Useful for local services or internal domains that do not require NTLM auth.
NoProxy {{ no_proxy | default(['localhost', '127.0.0.*', '10.*', '192.168.*']) | join(', ') }}

# Local TCP port cntlm listens on; point applications at 127.0.0.1:<listen_port>
Listen {{ listen_port | default(3128) }}

# Enable to allow access from other computers (Gateway mode)
# If false (default), cntlm binds to localhost only.
{% if gateway | default(false) %}Gateway yes
{% else %}Gateway no
{% endif %}

# NTLM authentication method: NTLMv2 (recommended), NTLM, NTLM2SR, LM, NT, or space-separated combination
# Controls which hash types cntlm uses when communicating with upstream proxies.
Auth {{ auth | default('NTLMv2') }}

# NTLM protocol flags bitmask — leave at default unless the upstream proxy requires specific flags
# Common flags include 0x06820000 for standard NTLMv2 setups.
Flags {{ flags | default('0x06820000') }}

# Useful in Gateway mode to allow/restrict certain IPs
# Specify individual IPs or subnets one rule per line.
# Rules are evaluated in order: Allow then Deny.
{% for rule in (allow_rules | default(['127.0.0.1'])) %}Allow {{ rule }}
{% endfor %}
{% for rule in (deny_rules | default(['0/0'])) %}Deny {{ rule }}
{% endfor %}

# GFI WebMonitor-handling plugin parameters, disabled by default
# ISAScannerSize {{ isa_scanner_size | default(1024) }}
# ISAScannerAgent Wget/
# ISAScannerAgent APT-HTTP/
# ISAScannerAgent Yum/

# Enable a SOCKS5 proxy listener in addition to the HTTP proxy
# If enabled, cntlm will listen on socks5_port for SOCKS5 connections.
{% if socks5_enabled | default(false) %}
# TCP port for the SOCKS5 listener (only active when socks5_enabled is true)
SOCKS5Proxy {{ socks5_port | default(8010) }}

# Optional SOCKS5 client username; leave empty to allow unauthenticated SOCKS5 access
# Format: username:password
SOCKS5User {{ socks5_user | default('dave:password') }}
{% endif %}

# TCP port-forwarding tunnels routed through the corporate proxy (useful for non-HTTP protocols)
# Format: local_port:remote_host:remote_port
{% for tunnel in (tunnels | default(['11443:remote.com:443'])) %}Tunnel {{ tunnel }}
{% endfor %}