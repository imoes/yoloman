# Directory containing additional Slurm plugin stack configuration files.
# Files matching *.conf in this directory are included to allow modular
# configuration of Slurm plugins (e.g., accounting, job submission, etc.).
#
# Variable: plugstack_conf_d_dir
# Schema default: '/etc/slurm/plugstack.conf.d'
#
# This directive tells the Slurm controller/daemon to load configuration
# snippets from the specified directory. Ensure the directory exists and
# contains properly named .conf files.

include {{ plugstack_conf_d_dir | default('/etc/slurm/plugstack.conf.d') }}/*.conf
