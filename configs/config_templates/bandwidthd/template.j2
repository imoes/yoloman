# Document root directory for the built-in HTTP server of bandwidthd.
# Default: /var/lib/bandwidthd/htdocs
<Directory {{ htdocs_dir | default('/var/lib/bandwidthd/htdocs') }}>
    Options +FollowSymLinks
    Require all granted
</Directory>

# Alias the /bandwidthd URL path to the document root directory.
Alias /bandwidthd {{ htdocs_dir | default('/var/lib/bandwidthd/htdocs') }}/