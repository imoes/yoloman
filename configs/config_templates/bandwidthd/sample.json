{
  "graph_span_days": 30,
  "retention_days": 180,
  "subnet_graph_enabled": true,
  "httpd_enabled": true,
  "httpd_port": 8080,
  "httpd_listen": "0.0.0.0",
  "https_enabled": false,
  "https_port": 443,
  "max_peers": 512,
  "max_subnets": 16,
  "interfaces": [
    {
      "name": "eth0"
    },
    {
      "name": "eth1"
    }
  ],
  "cidr_aggregation_enabled": true,
  "quiet_mode": true,
  "output_filename_prefix": "bw",
  "update_interval_seconds": 15,
  "max_graph_bandwidth_kbps": 100000,
  "min_graph_bandwidth_kbps": 10,
  "log_packet_rates": false,
  "max_bytes_before_reset": 10000000000,
  "track_udp": true,
  "track_icmp": true,
  "track_other_protocols": false
}
