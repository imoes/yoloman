# ptpmon configuration — main config file for the PTP monitor daemon
# Restart required after changes

[global]
# Log level: 0=quiet, 1=error, 2=warn, 3=info, 4=debug
log_level = {{ global.log_level | default(3) }}
# Log file path (use '-' for stdout)
log_file = {{ global.log_file | default('-') }}
# PID file path
pid_file = {{ global.pid_file | default('/run/ptpmon.pid') }}
# Interface to monitor (optional; if empty, all PTP interfaces are monitored)
interface = {{ global.interface | default('') }}
# Domain number to monitor
# (default: -1 means all domains; set to 0 for default domain)
domain_number = {{ global.domain_number | default(-1) }}

[alarm]
# Enablealarms
enabled = {{ alarm.enabled | default(true) }}
# Thresholds (in ns) for time error
warn_threshold = {{ alarm.warn_threshold | default(1000) }}
warn_threshold_rms = {{ alarm.warn_threshold_rms | default(100) }}
# Alarm threshold (in ns) for critical time error
error_threshold = {{ alarm.error_threshold | default(10000) }}
error_threshold_rms = {{ alarm.error_threshold_rms | default(1000) }}
# Maximum duration (in seconds) of alarm before triggering escalation
hold_time = {{ alarm.hold_time | default(5) }}

[notifications]
# Enable systemd-notify compatible readiness
ready_notify = {{ notifications.ready_notify | default(false) }}
# List of notification handlers
handlers = [
{% for handler in notifications.handlers %}
  {"type": "{{ handler.type }}", "endpoint": "{{ handler.endpoint }}", "timeout": {{ handler.timeout }}, "retries": {{ handler.retries }}, "retry_delay": {{ handler.retry_delay }} }{% if not loop.last %},{% endif %}
{% endfor %}
]

[health]
# Enable health checks (expose status via /proc or systemd health mechanism)
enabled = {{ health.enabled | default(true) }}
# Health check interval (in seconds)
interval = {{ health.interval | default(5) }}
# Maximum allowed gap (in seconds) without update before marking unhealthy
timeout = {{ health.timeout | default(10) }}

[sinks]
# Optional: PTP sink endpoints to monitor (for external sync verification)
# Each entry is a list of IP:port or hostname:port strings
{% if sinks.enabled | default(false) %}
enabled = true
{% for sink in sinks.endpoints %}
# Sink: {{ sink.host }} (port {{ sink.port }})
sink_{{ loop.index }} = "{{ sink.host }}:{{ sink.port }}"
{% endfor %}
{% else %}
enabled = false
{% endif %}
