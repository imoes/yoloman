# =============================================================================
# inetutils-traceroute configuration template
# =============================================================================
# This template generates the configuration file for inetutils-traceroute.
# It controls probe behavior such as port, TTL limits, timeouts, and protocol
# selection (UDP vs ICMP).
# =============================================================================

# The destination port used for UDP traceroute probes.
# Corresponds to the --port command-line option.
# Type: Integer
# Default: 33434
port={{ port | default(33434) }}

# The maximum number of hops (TTL) to attempt before stopping.
# Corresponds to the --max-hop command-line option.
# Type: Integer
# Default: 64
max_hops={{ max_hops | default(64) }}

# The number of probe packets to send per hop to check for reachability.
# Corresponds to the --tries command-line option.
# Type: Integer
# Default: 3
tries={{ tries | default(3) }}

# The timeout in seconds to wait for a response from each hop.
# Corresponds to the --wait command-line option.
# Type: Integer
# Default: 3
wait_timeout={{ wait_timeout | default(3) }}

# If true, use ICMP ECHO as the probe method instead of the default UDP.
# Corresponds to the --icmp command-line option.
# Type: Boolean
# Default: False
use_icmp={{ icmp | default(False) | lower }}

# Set the initial hop distance (TTL) for the first probe packet.
# Corresponds to the --first-hop command-line option.
# Type: Integer
# Default: 1
first_hop={{ first_hop | default(1) }}

# If true, resolve IP addresses to hostnames in the output.
# Corresponds to the --resolve-hostnames command-line option.
# Type: Boolean
# Default: True
resolve_hostnames={{ resolve_hostnames | default(True) | lower }}

# Set the Type of Service (TOS) class for packets.
# Corresponds to the --tos command-line option.
# Type: String
# Default: 'default'
tos={{ tos | default('default') }}