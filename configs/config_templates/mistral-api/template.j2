[uwsgi]
############################
### Generic UWSGI config ###
############################

# Override the default size for headers from the 4k default.
buffer-size = 65535

# This avoids error 104: "Connection reset by peer"
rem-header = Content-Length

# This is running standalone
master = true

# uwsgi recommends this to prevent thundering herd on accept.
thunder-lock = true

plugins = python3

# This ensures that file descriptors aren't shared between the WSGI application processes.
lazy-apps = true

# Log from the wsgi application: needs python3-pastescript as runtime depends.
paste-logger = true

# automatically kill workers if master dies
no-orphans = true

# exit instead of brutal reload on SIGTERM
die-on-term = true

# Avoid memcached connections to remain opened
close-on-exec = true
close-on-exec2 = true

##########################
### Performance tuning ###
##########################
# Threads and processes
enable-threads = true

# Default: 8
processes = {{ processes | default(8) }}

# This was benchmarked as a good value
# Default: 32
threads = {{ threads | default(32) }}

# This is the number of sockets in the queue.
# It improves a lot performances. This is comparable
# to the Apache ServerLimit/MaxClients option.
# Default: 100
listen = {{ listen | default(100) }}

##################################
### OpenStack service specific ###
##################################
# Environment variable passed to the application process to identify itself in messaging queues
env = OS_OSLO_MESSAGING_RABBIT__PROCESSNAME=mistral-api

# This is needed, otherwise connections stay open
add-header = Connection: close

# Important stuff...
paste = config:/etc/mistral/api-paste.ini

# This is the standard port for the WSGI application, listening on all available IPs
logto = /var/log/mistral/mistral-api.log
name = mistral-api
uid = {{ uid | default('mistral') }}
gid = {{ gid | default('mistral') }}
chdir = /var/lib/mistral
wsgi-file = /usr/bin/mistral-wsgi-api

# This is controlled by the init script using the --http-socket
# or using the --https thing. https will be activated if a file
# /etc/mistral/ssl/private/*.pem is found. In both case, port {{ UWSGI_PORT | default('9292') }}
# on all IPs will be used.
# The pattern to search for the private key file is:
# find /etc/mistral/ssl/private -type f -iname '*.pem' | head -n 1
# and for the certificate:
# find /etc/mistral/ssl/private -type f -iname '*.crt' | head -n 1
# just drop files there and restart the daemon, and you will have
# SSL up and running.

# HTTP socket configuration
# Listen on IPv6 any address on the configured port
# The port is controlled by UWSGI_PORT variable.
{% if UWSGI_PORT is defined and UWSGI_PORT is not none and (UWSGI_PORT is number or UWSGI_PORT is boolean or UWSGI_PORT | length > 0) %}http-socket = [::]:{{ UWSGI_PORT | default('9292') }}{% else %}#http-socket = [::]:8989{% endif %}

# HTTPS socket configuration
# Listen on IPv6 any address with dummy certificate paths (must be replaced by actual certs in production)
# Note: The original template contained a syntax error in the HTTPS socket directive (foobar.crt,foobar.key without proper formatting).
# This template preserves the structure but documents the fields.
# In a production environment, you would likely inject the cert/key paths via variables.
# For now, we keep the static defaults but mark them as such.
{% if UWSGI_PORT is defined and UWSGI_PORT is not none and (UWSGI_PORT is number or UWSGI_PORT is boolean or UWSGI_PORT | length > 0) %}https-socket = [::]:{{ UWSGI_PORT | default('9292') }},foobar.crt,foobar.key{% else %}#https-socket = [::]:8989,foobar.crt,foobar.key{% endif %}
