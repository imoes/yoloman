#!/bin/sh
# =============================================================================
# fwlogwatch daily cron job template
# =============================================================================
# This script is generated by Ansible to configure the fwlogwatch service.
# fwlogwatch processes firewall logs (typically iptables) and generates reports.
#
# Variables used from Ansible variables (with schema defaults):
#   - CRON_EMAIL: Email address to send reports to. Use 'none' to disable.
#   - CRON_PARAMS: Additional command-line parameters passed to fwlogwatch.
# =============================================================================

# Exit on any error
set -e

# Verbose debugging if requested by environment
test $DEBIAN_SCRIPT_DEBUG && set -v -x

# Path to the fwlogwatch binary
FWLOGWATCH=/usr/sbin/fwlogwatch

# Path to the fwlogwatch configuration file
CONFIG=/etc/default/fwlogwatch

# Default header for the email body
EXTRA_HEADER="Content-Type: text/plain"

# Check if the binary exists and is executable
test -x $FWLOGWATCH || exit 0

# Check if the configuration file exists and is readable
test -r $CONFIG || exit 0

# Source configuration generated from debconf's values
. $CONFIG

# --- Configuration Variables ---

# Email address to send the fwlogwatch report to.
# Set to 'none' to disable email delivery.
# Default: '' (empty string, usually implies 'none' or system default depending on setup)
# Source: CRON_EMAIL
CRON_EMAIL="{{ CRON_EMAIL | default('') }}"

# Additional command-line parameters passed to fwlogwatch when invoked by cron.
# Default: '' (empty string)
# Source: CRON_PARAMS
CRON_PARAMS="{{ CRON_PARAMS | default('') }}"

# --- Logic ---

# If email delivery is disabled, exit early
if [ "$CRON_EMAIL" = "none" ]; then
  exit 0
fi

# Execute fwlogwatch with optional parameters
# CRON_PARAMS is expanded here to allow extra flags
OUTPUT=`$FWLOGWATCH $CRON_PARAMS`

# If there are no valid time entries in the logs, there's nothing to report
(echo "$OUTPUT" | grep -q 'No valid time entries found') \
  && exit 0

# --- Mail results ---

# Create a temporary file for the email content
TMPFILE=`mktemp /tmp/fwlogwatch.XXXXXXXXXX`

# Set the recipient
echo "To: $CRON_EMAIL" >> $TMPFILE

# Set the subject line
echo "Subject: fwlogwatch daily news" >> $TMPFILE

# Determine if the output is HTML and set Content-Type accordingly
# If the output contains </html>, treat it as HTML
(echo "$OUTPUT" | grep -q '</html>') \
  && echo "Content-Type: text/html" >> $TMPFILE

# Add a blank line to separate headers from body
echo >> $TMPFILE

# Append the report output to the email body
echo "$OUTPUT" >> $TMPFILE

# Send the email using the system sendmail
# -F sets the envelope sender name to the current user
/usr/lib/sendmail -F `id -nu` "$CRON_EMAIL" < $TMPFILE

# Clean up the temporary file
rm -f $TMPFILE

