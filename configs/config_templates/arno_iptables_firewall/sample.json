{
  "verbose": true,
  "log_drops": true,
  "log_refused": true,
  "log_facility": "local0",
  "nat_enabled": true,
  "internal_hosts": [
    "192.168.1.0/24",
    "192.168.2.0/24"
  ],
  "external_interface": "eth0",
  "dmz_enabled": true,
  "dmz_hosts": [
    "10.0.1.0/24"
  ],
  "dmz_interface": "eth1",
  "adsl_enabled": false,
  "pppoe_interface": "ppp0",
  "syn_flood_protect": true,
  "icmp_ping_rate_limit": 2,
  "inbound_services": [
    "ssh",
    "http",
    "https",
    "smtp"
  ],
  "allow_inbound_ssh": false,
  "ssh_only_from_internal": true,
  "forward_dmz": true,
  "forward_internal": false,
  "log_forward": true,
  "custom_rules": [
    "-A INPUT -i lo -j ACCEPT",
    "-A FORWARD -j DROP"
  ],
  "ipv6_enabled": false,
  "stateful": true,
  "randomize_outbound_ports": true,
  "allow_dns_inbound": false
}
