# Configuration for the NetworkManager (NM) backend plugin for StrongSwan (`charon-nm`).
# This section is specific to the charon-nm plugin. Settings from the global `charon` section
# are NOT inherited; they must be repeated here if needed.
#
# Self-documentation: Each directive below includes its schema description as a comment.
# Variables use `| default(...)` to ensure safe rendering even if the variable is undefined
# in the Ansible host facts or inventory.

charon-nm {

    # Interface on which virtual IP addresses are installed. Note that NM also
    # installs the virtual IPs on the XFRM interface.
    # Schema: install_virtual_ip_on (string or interface name, optional)
{% if install_virtual_ip_on is defined and install_virtual_ip_on is not none and install_virtual_ip_on | length > 0 %}
    install_virtual_ip_on = {{ install_virtual_ip_on }}
{% else %}
    # install_virtual_ip_on = <not set - default determined by NetworkManager>
{% endif %}

    # MTU for XFRM interfaces created by the NM plugin.
    # Schema: mtu (integer, optional)
{% if mtu is defined and mtu is not none %}
    mtu = {{ mtu }}
{% else %}
    # mtu = <not set - default determined by NetworkManager/XFRM>
{% endif %}

    # Source port when sending packets to port 500 (IKE). Defaults to an ephemeral port.
    # May be set to 500 if firewall rules require a static port.
    # Schema: port (integer, optional)
{% if port is defined and port is not none %}
    port = {{ port }}
{% else %}
    # port = <not set - ephemeral port used by default>
{% endif %}

    # Source port when sending packets to port 4500 or a custom server port (NAT-T).
    # Defaults to an ephemeral port. May be set to e.g. 4500 if firewall rules
    # require a static port.
    # Schema: port_nat_t (integer, optional)
{% if port_nat_t is defined and port_nat_t is not none %}
    port_nat_t = {{ port_nat_t }}
{% else %}
    # port_nat_t = <not set - ephemeral port used by default>
{% endif %}

    # Base to use for calculating exponential back off, see IKEv2 RETRANSMISSION in
    # strongswan.conf(5). Default retransmission settings for charon-nm are
    # deliberately lower to fail and possibly reestablish SAs more quickly.
    # Schema: retransmit_base (float, optional)
{% if retransmit_base is defined and retransmit_base is not none %}
    retransmit_base = {{ retransmit_base }}
{% else %}
    # retransmit_base = <not set - default strongSwan value used>
{% endif %}

    # Timeout in seconds before sending first retransmit.
    # Schema: retransmit_timeout (float, optional)
{% if retransmit_timeout is defined and retransmit_timeout is not none %}
    retransmit_timeout = {{ retransmit_timeout }}
{% else %}
    # retransmit_timeout = <not set - default strongSwan value used>
{% endif %}

    # Number of times to retransmit a packet before giving up.
    # Schema: retransmit_tries (integer, optional)
{% if retransmit_tries is defined and retransmit_tries is not none %}
    retransmit_tries = {{ retransmit_tries }}
{% else %}
    # retransmit_tries = <not set - default strongSwan value used>
{% endif %}

    # Table where routes via XFRM interface are installed. Should be different
    # than the table used for the regular IKE daemon due to the mark.
    # Schema: routing_table (integer, optional)
{% if routing_table is defined and routing_table is not none %}
    routing_table = {{ routing_table }}
{% else %}
    # routing_table = <not set - default routing table used>
{% endif %}

    # Priority of the routing table. Higher than the default priority used for
    # the regular IKE daemon.
    # Schema: routing_table_prio (integer, optional)
{% if routing_table_prio is defined and routing_table_prio is not none %}
    routing_table_prio = {{ routing_table_prio }}
{% else %}
    # routing_table_prio = <not set - default priority used>
{% endif %}

    plugins {

        kernel-netlink {

            # Make packets with this mark ignore the routing table. Must be the
            # same mark set in charon-nm.plugins.socket-default.fwmark.
            # Note: This is a comment in the template because the actual fwmark
            # is often derived from the routing_table. If you need a specific
            # fwmark, uncomment and set it below.
            # fwmark = 0x{{ (routing_table | default(210)) }}

        }

        socket-default {

            # Mark applied to IKE and ESP packets to ignore the routing table
            # and avoid routing loops when using XFRM interfaces.
            # Note: This is a comment in the template. If your setup requires
            # an explicit fwmark here, uncomment and set it below.
            # fwmark = 0x{{ (routing_table | default(210)) }}

        }

    }

    syslog {

        daemon {

            # Default logging level for syslog daemon facility.
            # Schema: syslog_daemon_level (integer, optional)
{% if syslog_daemon_level is defined and syslog_daemon_level is not none %}
            default = {{ syslog_daemon_level }}
{% else %}
            # default = <not set - default syslog level used>
{% endif %}

        }

    }

}
