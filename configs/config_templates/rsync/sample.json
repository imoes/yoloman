{
  "max_connections": 10,
  "log_file": "/var/log/rsyncd.log",
  "syslog_facility": "daemon",
  "modules": {
    "backup": {
      "path": "/data/backups",
      "comment": "Centralized backup storage",
      "read_only": true,
      "write_only": false,
      "list": true,
      "users": [
        "backupuser"
      ],
      "file_permissions": "preserve",
      "use_chroot": true,
      "timeout": 600,
      "max_size": 107374182400,
      "exclude": [
        "*.tmp",
        "cache/*"
      ],
      "include": [
        "critical/"
      ],
      "secrets_file": "/etc/rsyncd.secrets",
      "auth_realm": "Backup Realm",
      "hide_dot_files": true
    },
    "uploads": {
      "path": "/data/uploads",
      "comment": "User upload directory (read/write, no listing)",
      "read_only": false,
      "write_only": true,
      "list": false,
      "users": [
        "webapp",
        "deploy"
      ],
      "file_permissions": "ignore",
      "owner": "www-data",
      "use_chroot": true,
      "transfer_rate": 5000,
      "include": [
        "*.jpg",
        "*.png"
      ],
      "exclude": [
        "*.log",
        "tmp/"
      ]
    }
  }
}
