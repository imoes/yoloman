# Configuration file for ccze
#
# This file configures the color scheme used by ccze, a modular logcolorizer.
# It defines colors for specific log message elements (dates, IPs, HTTP codes, etc.)
# and CSS styles for HTML output.
#
# Available 'pre' attributes: bold, underline, underscore, blink, reverse
# Available colors: black, red, green, yellow, blue, magenta, cyan, white
# Available bgcolors: on_black, on_red, on_green, on_yellow, on_blue, on_magenta, on_cyan, on_white

# --- Element Colors ---
# These directives map log message components to terminal colors/styles.

# Color/style for dates and times
date            {{ ccze_color_date | default('bold cyan') }}

# Color/style for host names and IP numbers
host            {{ ccze_color_host | default('bold blue') }}

# Color/style for sender process
process         {{ ccze_color_process | default('green') }}

# Color/style for PIDs (Process IDs)
pid             {{ ccze_color_pid | default('bold white') }}

# Color/style for brackets around PIDs
pid-sqbr        {{ ccze_color_pid_sqbr | default('bold green') }}

# Default color (not colorised)
default         {{ ccze_color_default | default('cyan') }}

# Color/style for e-mail addresses
email           {{ ccze_color_email | default('bold green') }}

# Color/style for subject lines (procmail)
subject         {{ ccze_color_subject | default('magenta') }}

# Color/style for directory names
dir             {{ ccze_color_dir | default('bold cyan') }}

# Color/style for file names
file            {{ ccze_color_file | default('bold cyan') }}

# Color/style for sizes
size            {{ ccze_color_size | default('bold white') }}

# Color/style for usernames
user            {{ ccze_color_user | default('bold yellow') }}

# Color/style for HTTP status codes (200, 404, etc)
httpcodes       {{ ccze_color_httpcodes | default('bold white') }}

# Color/style for transfer sizes
getsize         {{ ccze_color_getsize | default('magenta') }}

# Color/style for HTTP GET requests
get             {{ ccze_color_get | default('green') }}

# Color/style for HTTP POST requests
post            {{ ccze_color_post | default('bold green') }}

# Color/style for HTTP HEAD requests
head            {{ ccze_color_head | default('green') }}

# Color/style for HTTP PUT requests
put             {{ ccze_color_put | default('bold green') }}

# Color/style for HTTP CONNECT requests
connect         {{ ccze_color_connect | default('green') }}

# Color/style for HTTP TRACE requests
trace           {{ ccze_color_trace | default('green') }}

# Color/style for unknown messages
unknown         {{ ccze_color_unknown | default('cyan') }}

# Color/style for transfer times
gettime         {{ ccze_color_gettime | default('bold magenta') }}

# Color/style for URIs (http://, ftp://, etc)
uri             {{ ccze_color_uri | default('bold green') }}

# Color/style for remote user (proxy/http)
ident           {{ ccze_color_ident | default('bold white') }}

# Color/style for content type (http/proxy)
ctype           {{ ccze_color_ctype | default('white') }}

# Color/style for error messages
error           {{ ccze_color_error | default('bold red') }}

# Color/style for proxy MISS
miss            {{ ccze_color_miss | default('red') }}

# Color/style for proxy HIT
hit             {{ ccze_color_hit | default('bold yellow') }}

# Color/style for proxy DENIED
deny            {{ ccze_color_deny | default('bold red') }}

# Color/style for proxy REFRESH
refresh         {{ ccze_color_refresh | default('bold white') }}

# Color/style for proxy SWAPFAIL
swapfail        {{ ccze_color_swapfail | default('bold white') }}

# Color/style for debug messages
debug           {{ ccze_color_debug | default('white') }}

# Color/style for warnings
warning         {{ ccze_color_warning | default('red') }}

# Color/style for proxy DIRECT
direct          {{ ccze_color_direct | default('bold white') }}

# Color/style for proxy PARENT
parent          {{ ccze_color_parent | default('bold yellow') }}

# Color/style for proxy swap number
swapnum         {{ ccze_color_swapnum | default('blue on_white') }}

# Color/style for proxy CREATE
create          {{ ccze_color_create | default('bold white') }}

# Color/style for proxy SWAPIN
swapin          {{ ccze_color_swapin | default('bold white') }}

# Color/style for proxy SWAPOUT
swapout         {{ ccze_color_swapout | default('bold white') }}

# Color/style for proxy RELEASE
release         {{ ccze_color_release | default('bold white') }}

# Color/style for MAC addresses
mac             {{ ccze_color_mac | default('bold white') }}

# Color/style for version numbers
version         {{ ccze_color_version | default('bold white') }}

# Color/style for memory addresses
address         {{ ccze_color_address | default('bold white') }}

# Color/style for numbers
numbers         {{ ccze_color_numbers | default('white') }}

# Color/style for signal names
signal          {{ ccze_color_signal | default('bold yellow') }}

# Color/style for services
service         {{ ccze_color_service | default('bold magenta') }}

# Color/style for protocols
prot            {{ ccze_color_prot | default('magenta') }}

# Color/style for "Bad words"
bad             {{ ccze_color_bad | default('bold yellow') }}

# Color/style for "Good words"
good            {{ ccze_color_good | default('bold green') }}

# Color/style for "System words"
system          {{ ccze_color_system | default('bold cyan') }}

# Color/style for incoming mail (exim)
incoming        {{ ccze_color_incoming | default('bold white') }}

# Color/style for outgoing mail (exim)
outgoing        {{ ccze_color_outgoing | default('white') }}

# Color/style for unique ID (exim)
uniqn           {{ ccze_color_uniqn | default('bold white') }}

# Color/style for 'last message repeated N times'
repeat          {{ ccze_color_repeat | default('white') }}

# Color/style for RFC822 Field
field           {{ ccze_color_field | default('green') }}

# Color/style for chain names (ulogd)
chain           {{ ccze_color_chain | default('cyan') }}

# Color/style for percentages
percentage      {{ ccze_color_percentage | default('bold yellow') }}

# Color/style for FTP codes
ftpcodes        {{ ccze_color_ftpcodes | default('cyan') }}

# Color/style for various keywords (like PHP in php.log, etc)
keyword         {{ ccze_color_keyword | default('bold yellow') }}

# Color/style for package status (dpkg)
pkgstatus       {{ ccze_color_pkgstatus | default('green') }}

# Color/style for package name (dpkg)
pkg             {{ ccze_color_pkg | default('bold red') }}

# --- CSS Colors for HTML Output ---
# These directives map standard CSS color names to specific hex or named colors
# used when ccze generates HTML log views.

# CSS color for black
cssblack        {{ ccze_css_black | default('black') }}

# CSS color for bold black
cssboldblack    {{ ccze_css_boldblack | default('black') }}

# CSS color for red
cssred          {{ ccze_css_red | default('darkred') }}

# CSS color for bold red
cssboldred      {{ ccze_css_boldred | default('red') }}

# CSS color for green
cssgreen        {{ ccze_css_green | default('#00C000') }}

# CSS color for bold green
cssboldgreen    {{ ccze_css_boldgreen | default('lime') }}

# CSS color for yellow
cssyellow       {{ ccze_css_yellow | default('brown') }}

# CSS color for bold yellow
cssboldyellow   {{ ccze_css_boldyellow | default('yellow') }}

# CSS color for blue
cssblue         {{ ccze_css_blue | default('blue') }}

# CSS color for bold blue
cssboldblue     {{ ccze_css_boldblue | default('slateblue') }}

# CSS color for cyan
csscyan         {{ ccze_css_cyan | default('darkcyan') }}

# CSS color for bold cyan
cssboldcyan     {{ ccze_css_boldcyan | default('cyan') }}

# CSS color for magenta
cssmagenta      {{ ccze_css_magenta | default('darkmagenta') }}

# CSS color for bold magenta
cssboldmagenta  {{ ccze_css_boldmagenta | default('magenta') }}

# CSS color for white
csswhite        {{ ccze_css_white | default('grey') }}

# CSS color for bold white
cssboldwhite    {{ ccze_css_boldwhite | default('white') }}

# CSS color for body background
cssbody         {{ ccze_css_body | default('#404040') }}