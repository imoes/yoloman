{
  "interface": "wlan0",
  "upstream": "eth0",
  "gateway": "192.168.42.1",
  "subnet": "192.168.42.0/24",
  "start_ip": "192.168.42.10",
  "end_ip": "192.168.42.200",
  "dns_servers": [
    "gateway"
  ],
  "redirect_port": 3000,
  "control_port": 3001,
  "backend_url": "http://127.0.0.1:3790/",
  "backend_timeout": 10,
  "max_clients": 150,
  "log_syslog": true,
  "log_level": 2,
  "log_file": "/var/log/opennds/opennds.log",
  "use_wpa_psk": true,
  "wpa_psk_passphrase": "MyHotspot2025!",
  "use_https": false,
  "ssl_cert": "/etc/opennds/ssl/cert.pem",
  "ssl_key": "/etc/opennds/ssl/key.pem",
  "pages": [
    {
      "name": "login",
      "description": "Main login page",
      "path": "/opt/opennds/htdocs/login.html"
    },
    {
      "name": "welcome",
      "description": "Welcome page after login",
      "path": "/opt/opennds/htdocs/welcome.html"
    },
    {
      "name": "error",
      "description": "Error page (e.g., auth failure)",
      "path": "/opt/opennds/htdocs/error.html"
    }
  ],
  "static_hosts": [
    {
      "ip": "192.168.42.1",
      "hostname": "gateway",
      "aliases": [
        "router",
        "dns"
      ]
    }
  ],
  "rate_limiting": {
    "clients": [
      {
        "mac": "aa:bb:cc:dd:ee:ff",
        "up": 512,
        "down": 2048
      }
    ]
  },
  "use_mac_allowlist": true,
  "mac_allowlist": [
    "aa:bb:cc:dd:ee:ff",
    "11:22:33:44:55:66"
  ],
  "session_timeout": 120,
  "use_bandwidth_accounting": true,
  "accounting_file": "/var/log/opennds/accounting.log"
}
