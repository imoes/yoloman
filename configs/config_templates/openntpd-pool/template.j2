# OpenNTPD Configuration Template
# Auto-generated by Ansible role. Do not edit manually.

# List of NTP server hostnames or IPs to synchronize with.
# Use public pools or your own infrastructure.
# Default: ['0.pool.ntp.org', '1.pool.ntp.org', '2.pool.ntp.org', '3.pool.ntp.org']
{% for server in (ntp_servers | default(['0.pool.ntp.org', '1.pool.ntp.org', '2.pool.ntp.org', '3.pool.ntp.org'])) %}
server {{ server }}
{% endfor %}

# Listen on all interfaces for incoming NTP requests (unless restricted below).
# This directive allows this system to act as an NTP server for other clients.
listen on *

# Restrict NTP clients to specific subnets.
# List of IP subnets (e.g., '127.0.0.1', '192.168.1.0/24') allowed to query this NTP server.
# Leave empty to allow all clients (not recommended for production).
# Default: [] (allow all)
{% if (restrict_subnets | default([])) | length > 0 %}
{% for subnet in restrict_subnets %}
restrict {{ subnet }}
{% endfor %}
{% else %}
# No restrictions defined. All clients are allowed to query this NTP server.
# For security, consider defining specific subnets in `restrict_subnets`.
{% endif %}

# Enable leap second handling using the IANA leap-seconds file.
# Whether to enable leap second handling using the IANA leap-seconds file.
# Default: true
{% if handle_leap_seconds | default(true) %}
leapfile /etc/ntp.leap-seconds
{% endif %}

# Logging verbosity level (0–4; 3 is typical for production).
# Logging verbosity: 0 (none) to 4 (debug). Value 3 is recommended for production to capture warnings and errors.
# Default: 3
log-level {{ log_level | default(3) }}

# Maximum allowed time offset (seconds) before rejecting remote clock.
# Maximum absolute time offset (in seconds) allowed before OpenNTPD refuses to sync (prevents large time jumps).
# Set higher for unstable networks.
# Default: 300.0
max-offset {{ max_offset | default(300.0) }}