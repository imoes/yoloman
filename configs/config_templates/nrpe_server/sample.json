{
  "nrpe_server_address": "10.0.0.10",
  "nrpe_server_port": 5666,
  "nrpe_ssl_enabled": true,
  "nrpe_ssl_cipher_list": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "nrpe_ssl_port": 5667,
  "nrpe_connection_timeout": 60,
  "nrpe_request_timeout": 60,
  "nrpe_debug": false,
  "nrpe_log_file": "/var/log/nagios/nrpe.log",
  "nrpe_pid_file": "/var/run/nagios/nrpe.pid",
  "nrpe_allowed_hosts": [
    "10.0.0.1",
    "10.0.0.2",
    "192.168.1.0/24"
  ],
  "nrpe_commands": [
    {
      "name": "check_disk",
      "executable": "/usr/lib/nagios/plugins/check_disk",
      "arguments": [
        "-w",
        "20%",
        "-c",
        "10%",
        "-p",
        "/"
      ]
    },
    {
      "name": "check_load",
      "executable": "/usr/lib/nagios/plugins/check_load",
      "arguments": [
        "-w",
        "1.5,1.0,0.5",
        "-c",
        "2.5,2.0,1.5"
      ]
    },
    {
      "name": "check_users",
      "executable": "/usr/lib/nagios/plugins/check_users",
      "arguments": [
        "-w",
        "5",
        "-c",
        "10"
      ]
    }
  ],
  "nrpe_include_dir": "/etc/nagios/nrpe.d/",
  "nrpe_escape_command_arguments": true,
  "nrpe_log_level": 2,
  "nrpe_bind_address": "",
  "nrpe_ipv4_only": true,
  "nrpe_ssl_cert_file": "/etc/ssl/certs/nrpe_cert.pem",
  "nrpe_ssl_key_file": "/etc/ssl/private/nrpe_key.pem",
  "nrpe_ssl_ca_cert_file": "/etc/ssl/ca/nagios-ca.crt",
  "nrpe_ssl_verify_peer": 2
}
