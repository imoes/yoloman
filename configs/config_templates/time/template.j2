# pam_time configuration file
# Manages access control rules for PAM modules that support time-based restrictions.
# See time.conf(5) for syntax details.
# Format per line: services;ttys;users;times

{% for rule in rules | default([]) %}
# List of access rules for pam_time.
# Each item defines services, terminals, users, and time restrictions.
# See TIME.CONF(5) for syntax details
{{ rule.services | default('ALL') }};{{ rule.ttys | default('ALL') }};{{ rule.users | default('ALL') }};{{ rule.times | default('ALL') }}
{% endfor %}