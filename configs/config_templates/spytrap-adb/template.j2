# Spytrap-ADB Configuration
# Managed by Ansible Jinja2 engine
# This configuration file controls the behavior of the Spytrap-ADB tool.

# Verbosity level for logs.
# 0 is silent, higher values increase detail.
# Maps to repeated -v flags in the underlying tool.
verbosity: {{ verbosity | default(0) }}

# ADB Server startup strategy.
# auto: Start the server only if it is not already running.
# always: Ensure the server is started and running, regardless of current state.
# never: Do not attempt to manage the ADB server lifecycle.
# Corresponds to the --start-adb-server command line argument.
start_adb_server: "{{ start_adb_server | default('auto') }}"