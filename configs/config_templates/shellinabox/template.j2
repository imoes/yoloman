# shellinabox configuration file
# Generated by Ansible Jinja2 template.
# See the schema descriptions for field meanings.

# shellinabox_daemon_start: Whether shellinaboxd should start automatically (1 for yes, 0 for no).
SHELLINABOX_DAEMON_START={{ shellinabox_daemon_start | default(1) }}

# shellinabox_port: TCP port that shellinaboxd's webserver listens on.
SHELLINABOX_PORT={{ shellinabox_port | default(4200) }}

# shellinabox_args: Optional arguments for shellinaboxd, e.g. extra service definitions.
# Beeps are disabled because of reports of the VLC plugin crashing Firefox on Linux/x86_64.
SHELLINABOX_ARGS="{{ shellinabox_args | default('--no-beep') }}"