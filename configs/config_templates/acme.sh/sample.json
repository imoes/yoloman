{
 "cert_home": "/etc/acme.sh/certs",
 "config_home": "/etc/acme.sh/config",
 "domains": [
  {
   "account_email": "admin@example.com",
   "auto_upgrade": false,
   "ca_file": "/etc/ssl/certs/lets-encrypt-r3.crt",
   "cert_file": "/etc/ssl/certs/example.com.crt",
   "challenge_method": "http",
   "days": 60,
   "debug": 1,
   "fullchain_file": "/etc/ssl/certs/example.com.fullchain.crt",
   "key_file": "/etc/ssl/private/example.com.key",
   "log": "/var/log/acme.sh/example.com.log",
   "name": "example.com",
   "notify_hook": "mail",
   "notify_level": 1,
   "notify_mode": 1,
   "ocsp": true,
   "preferred_chain": "ISRG Root X1",
   "reloadcmd": "systemctl reload nginx",
   "server": "https://acme.zerossl.com/v2/DV90",
   "webroot": "/var/www/example.com/html"
  },
  {
   "challenge_method": "dns",
   "deploy_hook": "deploy_nginx",
   "dns_manual": true,
   "ecc": true,
   "force": true,
   "keylength": "ec-384",
   "name": "example.org",
   "no_cron": true,
   "no_profile": true,
   "post_hook": "/usr/local/bin/restore-dns.sh",
   "pre_hook": "/usr/local/bin/backup-dns.sh",
   "staging": false
  },
  {
   "account_key": "/etc/acme.sh/keys/account.key",
   "account_keylength": "4096",
   "challenge_method": "dns",
   "dns_hook": "dns_cloudflare",
   "dnssleep": 120,
   "eab_hmac_key": "aGVsbG8gd29ybGQ=",
   "eab_kid": "123456-abcdef",
   "name": "*.sub.example.net",
   "valid_from": "2025-01-01T00:00:00Z",
   "valid_to": "2027-01-01T00:00:00Z"
  }
 ]
}
