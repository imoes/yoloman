# vsmartcard-vpcd configuration
#
# This file configures the Virtual Smartcard PCD (Personal Computer Card) daemon.
# It defines the identity of the virtual reader and the backend library used for communication.

# The friendly name displayed for this virtual PCD device in the PC/SC middleware.
# @see friendlyname
FRIENDLYNAME "{{ friendlyname | default('Virtual PCD') }}"

# The device identifier path and channel ID for the virtual card reader.
# Typically specifies the interface path (e.g., /dev/null) and a unique hex channel ID.
# @see devicename
DEVICENAME   {{ devicename | default('/dev/null:0x8C7B') }}

# The path to the IFD (Interface Device) handler shared library for the virtual card driver.
# This library implements the PC/SC reader interface for the virtual device.
# @see libpath
LIBPATH      {{ libpath | default('/usr/lib/pcsc/drivers/serial/libifdvpcd.so') }}

# The hex channel ID associated with the virtual card reader.
# Used by the PC/SC middleware to uniquely identify this virtual slot.
# @see channelid
CHANNELID    {{ channelid | default('0x8C7B') }}
