# =============================================================================
# vsmartcard-vpcd Configuration Template
# =============================================================================
# This file configures the Virtual PCD (PC/SC Card Daemon) service.
# It defines the virtual smart card reader presented to the PC/SC middleware.
# =============================================================================

# The friendly name displayed for this virtual PCD device in the PC/SC middleware.
# Schema Field: friendlyname
FRIENDLYNAME "{{ friendlyname | default('Virtual PCD') }}"

# The device identifier path and channel ID for the virtual card reader.
# Schema Field: devicename
DEVICENAME   "{{ devicename | default('/dev/null:0x8C7B') }}"

# The path to the IFD handler shared library for the virtual card driver.
# Schema Field: libpath
LIBPATH      "{{ libpath | default('/usr/lib/pcsc/drivers/serial/libifdvpcd.so') }}"

# The hex channel ID associated with the virtual card reader.
# Schema Field: channelid
CHANNELID    "{{ channelid | default('0x8C7B') }}"