{
  "bindirs": [
    "/usr/local/bin",
    "/opt/bin"
  ],
  "libdirs": [
    "/usr/local/lib",
    "/opt/lib"
  ],
  "mandirs": [
    "/usr/local/man",
    "/opt/man"
  ],
  "path": "/usr/local/bin:/usr/bin:/bin",
  "tmpdir": "/var/tmp/binstats",
  "logfile": "/var/log/binstats/report.txt",
  "skip_debian": true,
  "debug": false
}
