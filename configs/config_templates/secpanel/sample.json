{
  "title": "My SecPanel",
  "ssh_executable": "ssh",
  "scp_executable": "scp",
  "default_port": 22,
  "use_agent": true,
  "key_directory": "/home/user/.ssh",
  "default_user": "admin",
  "theme": "clam",
  "profiles": [
    {
      "name": "Production Server",
      "host": "192.168.1.100",
      "port": 22,
      "user": "root",
      "auth": "key",
      "key_file": "/home/user/.ssh/id_rsa_prod"
    },
    {
      "name": "Staging",
      "host": "staging.example.com",
      "port": 2222,
      "auth": "password",
      "key_file": ""
    }
  ]
}
