# /etc/default/isc-dhcp-relay — configuration for the ISC DHCP relay daemon (dhcrelay)
# Space-separated list of DHCP server addresses to which requests will be forwarded
SERVERS="{{ servers | join(' ') }}"

# Interface(s) on which dhcrelay listens for DHCP requests (space-separated)
# Use '-' to listen on all interfaces (not recommended for security)
INTERFACES="{{ interfaces | join(' ') }}"

# Additional options passed directly to dhcrelay(8)
# Common options: -d (debug), -f (run in foreground), -i (insert DHCP relay option 82), -n (no UDP checksums)
# See dhcrelay(8) man page for full list
OPTIONS="{{ options | join(' ') }}"
