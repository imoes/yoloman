# Configuration for packeth - Ethernet packet generator
# See man packeth(1) and /usr/share/doc/packeth/README.gz

# Destination MAC address in colon-separated hex notation.
dst_mac = {{ (values | default({})).dst_mac | default('ff:ff:ff:ff:ff:ff') }}

# Source MAC address in colon-separated hex notation.
src_mac = {{ (values | default({})).src_mac | default('00:00:00:00:00:00') }}

# EtherType value in hex notation (e.g., 0x0800 for IPv4, 0x0806 for ARP).
ethertype = {{ (values | default({})).ethertype | default('0x0800') }}

# The network interface name to bind to for sending packets.
interface = {{ (values | default({})).interface | default('eth0') }}

# Number of packets to generate and send.
packet_count = {{ (values | default({})).packet_count | default(1) }}

# Length of the payload data in bytes.
payload_length = {{ (values | default({})).payload_length | default(46) }}

# Delay in seconds between sending each packet.
delay = {{ (values | default({})).delay | default(0) }}

# Enable verbose mode to print packet details to stdout.
verbose = {{ (values | default({})).verbose | default(false) }}