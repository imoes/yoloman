{
  "shared_preload_libraries": "pglogical",
  "max_workers": 4,
  "max_slots": 10,
  "sync_structure_timeout": 300,
  "synchronous": false,
  "log_level": "INFO",
  "verbose": false,
  "apply_interval": 1000,
  "conflict_resolution": "none",
  "conflict_resolver": "",
  "replicated_tables": [
    {
      "schema": "public",
      "name": "users",
      "description": "User accounts"
    },
    {
      "schema": "public",
      "name": "orders",
      "description": "Order history"
    }
  ],
  "replication_sets": [
    {
      "name": "default",
      "description": "Core application tables",
      "tables": [
        {
          "schema": "public",
          "name": "users"
        },
        {
          "schema": "public",
          "name": "orders"
        }
      ]
    }
  ],
  "log_remote_commands": false,
  "log_apply_stats": true,
  "debug_logging": false,
  "extra_params": {}
}
