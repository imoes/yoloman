# =============================================================================
# PostgreSQL pglogical extension configuration
#
# This template configures the pglogical extension for logical replication
# between PostgreSQL instances. It manages shared library loading, worker
# process counts, replication slots, logging, conflict resolution, and
# replication set definitions (publisher and subscriber sides).
#
# NOTE: Changes to 'shared_preload_libraries' require a PostgreSQL restart.
# =============================================================================

# Comma-separated list of shared libraries to preload (must include 'pglogical').
# PostgreSQL requires restart to change this.
shared_preload_libraries = '{{ (shared_preload_libraries | default("pglogical")) }}'

# Maximum number of pglogical worker processes (publisher/subscriber workers).
# Increase for higher replication throughput.
pglogical.max_workers = {{ max_workers | default(4) }}

# Maximum number of replication slots pglogical may create (per node).
# Must be >= number of active subscriptions.
pglogical.max_slots = {{ max_slots | default(10) }}

# Timeout (in seconds) for schema synchronization during initial subscription setup.
# Increase for large databases.
pglogical.synchronize_structure_timeout = {{ sync_structure_timeout | default(300) }}

# Whether to use synchronous replication for subscriber commit acknowledgment.
# Reduces latency but may increase failure risk.
pglogical.synchronous = {{ synchronous | default(false) | lower }}

# Logging level for pglogical operations.
# Use 'DEBUG' only for troubleshooting.
pglogical.log_level = '{{ log_level | default("INFO") | upper }}'

# Enable verbose per-operation logging (e.g., row-level replication events).
# Increases log volume significantly.
pglogical.verbose = {{ verbose | default(false) | lower }}

# Minimum time (in milliseconds) between apply cycles.
# Lower values reduce replication lag but increase CPU usage.
pglogical.apply_interval = {{ apply_interval | default(1000) }}

# Conflict resolution strategy for updatable subscriptions.
# Options: 'none', 'apply_first', 'remote_first', 'log'.
pglogical.conflict_resolution = '{{ conflict_resolution | default("none") }}'

# Name of a custom conflict resolver function (e.g., 'pglogical.conflict_log_and_exit').
# Leave blank unless using custom logic.
pglogical.conflict_resolver = '{{ conflict_resolver | default("") }}'

# Subscription-side: list of tables to replicate (for subscriber configuration).
# Each entry must specify schema and table name.
{% if replicated_tables | default([]) | length > 0 %}
# Configured replicated tables (subscriber side):
{% for table in replicated_tables | default([]) %}
# Table '{{ table.schema | default("") }}.{{ table.name | default("") }}'
pglogical.replication_set_table = {{ table.schema | default("") }}.{{ table.name | default("") }}
{% endfor %}
{% else %}
# No tables explicitly configured for replication on this node.
{% endif %}

# Publisher-side: list of replication sets and their tables.
# Each set groups tables for selective replication.
{% if replication_sets | default([{'name': 'default', 'description': 'Default replication set', 'tables': []}]) | length > 0 %}
{% for rs in replication_sets | default([{'name': 'default', 'description': 'Default replication set', 'tables': []}]) %}
# Replication set '{{ rs.name | default("default") }}' — {{ rs.description | default("no description") }}
pglogical.replication_set = {{ rs.name | default("default") }}
{% for tbl in rs.tables | default([]) %}
pglogical.replication_set_table = {{ tbl.schema | default("") }}.{{ tbl.name | default("") }}
{% endfor %}
{% endfor %}
{% endif %}

# Log remote SQL commands executed by pglogical.
# Useful for auditing but increases log volume.
pglogical.log_remote_commands = {{ log_remote_commands | default(false) | lower }}

# Log periodic apply statistics (e.g., latency, rows applied).
# Helps monitor replication health.
pglogical.log_apply_stats = {{ log_apply_stats | default(false) | lower }}

# Enable pglogical-specific debug logging.
# (Equivalent to log_level_debug in older/pglogical-specific contexts).
pglogical.log_level_debug = {{ debug_logging | default(false) | lower }}

# Optional: custom connection strings or other extra parameters for external services.
# These are written verbatim into the config.
{% if extra_params | default([]) | length > 0 %}
# Additional custom parameters:
{% for item in extra_params | default([]) | dict2items %}
{{ item.key }} = {{ item.value }}
{% endfor %}
{% endif %}