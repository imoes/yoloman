# PostgreSQL pglogical extension configuration
# Enables logical replication between PostgreSQL instances

# Enable pglogical extension on the database
shared_preload_libraries = '{{ shared_preload_libraries }}'

# Logical replication worker count (0 = auto, recommended: 2–8 depending on load)
pglogical.max_workers = {{ max_workers }}

# Maximum number of concurrent replication connections
pglogical.max_slots = {{ max_slots }}

# Synchronization timeout in seconds for initial table synchronization
pglogical.synchronize_structure_timeout = {{ sync_structure_timeout }}

# Enable synchronous replication (true/false) — use only in high-availability setups
pglogical.synchronous = {{ synchronous }}

# Logging level: DEBUG, INFO (default), NOTICE, WARNING, ERROR, LOG, FATAL
pglogical.log_level = '{{ log_level }}'

# Enable verbose logging of replication events (useful for debugging)
pglogical.verbose = {{ verbose }}

# Timeout for replication apply process in seconds
pglogical.apply_interval = {{ apply_interval }}

# Enable conflict resolution for updatable subscriptions (requires pglogical_conflict_resolver)
pglogical.conflict_resolution = '{{ conflict_resolution }}'

# Path to custom conflict resolver function (e.g., 'pglogical.conflict_log_and_exit')
pglogical.conflict_resolver = '{{ conflict_resolver }}'

# Subscription-side: list of tables to replicate (must match publication names)
# Use empty list for no tables or if acting as publisher-only
{% for table in replicated_tables %}# Table '{{ table.schema }}.{{ table.name }}' — {{ table.description or 'no description' }}
{% endfor %}

# Publisher-side: list of replication sets and their tables
{% for rs in replication_sets %}# Replication set '{{ rs.name }}' — {{ rs.description or 'no description' }}
pglogical.replication_set = {{ rs.name }}
{% for tbl in rs.tables %}pglogical.replication_set_table = {{ tbl.schema }}.{{ tbl.name }}
{% endfor %}
{% endfor %}

# Network and security settings
pglogical.log_remote_commands = {{ log_remote_commands }}
pglogical.log_apply_stats = {{ log_apply_stats }}
pglogical.log_level_debug = {{ debug_logging }}

# Optional: custom connection strings for external services (e.g., backup WAL receiver)
# Not required for standard pglogical use
{% if extra_params %}# Additional custom parameters
{% for key, value in extra_params.items() %}{{ key }} = {{ value }}
{% endfor %}
{% endif %}