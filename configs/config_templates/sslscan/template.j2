{# SSLScan Configuration Template #}
{# This template generates the command-line arguments for the sslscan utility. #}

{# Flags section #}
{# List of sslscan command-line flags (e.g., --verbose, --show-certificate, --no-colour). #}
{# Each item corresponds to a boolean or flag-style option. #}
{# If empty, no additional flags are passed. #}
{% for flag in (flags | default([])) %}
  {{ flag }}
{% endfor %}

{# Targets section #}
{# List of target hosts to scan. Can include ports (e.g., host:port). #}
{# If empty, sslscan expects targets to be provided differently or will run interactively/with errors. #}
{% for target in (targets | default([])) %}
  {{ target }}
{% endfor %}