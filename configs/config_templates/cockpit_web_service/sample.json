{
  "webservice_origins": [
    "https://cockpit.example.com"
  ],
  "webservice_protocol_header": "X-Forwarded-Proto",
  "webservice_login_title": "Example Corp \u2014 Server Management",
  "webservice_compression": true,
  "webservice_max_startups": 10,
  "webservice_allow_multihost": false,
  "webservice_client_cert_auth": false,
  "session_idle_timeout": 15,
  "session_banner": "/etc/cockpit/issue.txt",
  "log_fatal_channels": [
    "stderr"
  ]
}
