<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
{#
  KF5 KXMLGui Definition File
  ===========================
  This file defines the structure of the application's graphical user interface (GUI),
  specifically the menu bar, tool bar, and status bar. It follows the KDE XMLGUI schema.
  
  Schema Version: Defined by the 'version' attribute.
  Translation Domain: Defined by the 'translationDomain' attribute.
#}

{# gui: Root element for the GUI definition. #}
<gui
  {# name: Internal identifier for this GUI definition. #}
  name="standard_containers"
  {# version: GUI definition schema version. Defaults to '23' if not specified. #}
  version="{{ version | default('23') }}"
  {# translationDomain: Domain for translation files (PO files). Defaults to 'kxmlgui5' if not specified. #}
  translationDomain="{{ translationDomain | default('kxmlgui5') }}"
>
  <MenuBar>
    {#
      MenuBar: The top-level menu container.
      Menus are added as child elements.
    #}

    {# file: The "File" menu. #}
    <Menu name="file">
      <text>&amp;File</text>
      
      {# file_new: Create a new file. #}
      <Action name="file_new"/>
      
      {# new_merge: Merge point for plugins adding new-file actions. #}
      <MergeLocal name="new_merge"/>
      
      {# file_open: Open an existing file. #}
      <Action name="file_open"/>
      
      {# file_open_recent: Open a recently accessed file. #}
      <Action name="file_open_recent"/>
      
      {# open_merge: Merge point for plugins adding open-file actions. #}
      <MergeLocal name="open_merge"/>
      
      <Separator/>
      
      {# file_save: Save the current file. #}
      <Action name="file_save"/>
      
      {# file_save_as: Save the current file with a new name. #}
      <Action name="file_save_as"/>
      
      {# file_save_all: Save all open documents. #}
      <Action name="file_save_all"/>
      
      {# save_merge: Merge point for plugins adding save-file actions. #}
      <MergeLocal name="save_merge"/>
      
      {# file_revert: Revert the current file to the last saved state. #}
      <Action name="file_revert"/>
      
      {# file_revert_all: Revert all open documents. #}
      <Action name="file_revert_all"/>
      
      {# revert_merge: Merge point for plugins adding revert-file actions. #}
      <MergeLocal name="revert_merge"/>
      
      <Separator/>
      
      {# file_print: Print the current document. #}
      <Action name="file_print"/>
      
      {# file_print_preview: Show a print preview. #}
      <Action name="file_print_preview"/>
      
      {# print_merge: Merge point for plugins adding print actions. #}
      <MergeLocal name="print_merge"/>
      
      {# file_mail: Send the current document via email. #}
      <Action name="file_mail"/>
      
      {# mail_merge: Merge point for plugins adding mail actions. #}
      <MergeLocal name="mail_merge"/>
      
      {# General merge point for other file-related actions. #}
      <MergeLocal/>
      
      <Separator/>
      
      {# file_close: Close the current document. #}
      <Action name="file_close"/>
      
      {# file_close_all: Close all open documents. #}
      <Action name="file_close_all"/>
      
      {# close_merge: Merge point for plugins adding close actions. #}
      <MergeLocal name="close_merge"/>
      
      <Separator/>
      
      {# file_quit: Quit the application. #}
      <Action name="file_quit"/>
    </Menu>

    {# game: The "Game" menu. #}
    <Menu name="game">
      <text>&amp;Game</text>
      
      {# game_new: Start a new game. #}
      <Action name="game_new"/>
      
      {# game_load: Load a saved game. #}
      <Action name="game_load"/>
      
      {# game_load_recent: Load a recently played game. #}
      <Action name="game_load_recent"/>
      
      {# game_restart: Restart the current game. #}
      <Action name="game_restart"/>
      
      {# new_merge: Merge point for plugins adding new-game actions. #}
      <MergeLocal name="new_merge"/>
      
      <Separator/>
      
      {# game_save: Save the current game. #}
      <Action name="game_save"/>
      
      {# game_save_as: Save the current game with a new name. #}
      <Action name="game_save_as"/>
      
      {# save_merge: Merge point for plugins adding save-game actions. #}
      <MergeLocal name="save_merge"/>
      
      <Separator/>
      
      {# game_end: End the current game (forfeit/quit). #}
      <Action name="game_end"/>
      
      {# end_merge: Merge point for plugins adding end-game actions. #}
      <MergeLocal name="end_merge"/>
      
      <Separator/>
      
      {# game_pause: Pause the game. #}
      <Action name="game_pause"/>
      
      {# game_highscores: View high scores. #}
      <Action name="game_highscores"/>
      
      {# game_clear_highscores: Clear the high scores. #}
      <Action name="game_clear_highscores"/>
      
      {# game_statistics: View game statistics. #}
      <Action name="game_statistics"/>
      
      {# game_clear_statistics: Clear the statistics. #}
      <Action name="game_clear_statistics"/>
      
      {# game_print: Print game state/report. #}
      <Action name="game_print"/>
      
      {# game_print_preview: Print preview for game report. #}
      <Action name="game_print_preview"/>
      
      {# misc_merge: Merge point for miscellaneous game actions. #}
      <MergeLocal name="misc_merge"/>
      
      <Separator/>
      
      {# General merge point for game actions. #}
      <MergeLocal/>
      
      <Separator/>
      
      {# game_quit: Quit the game. #}
      <Action name="game_quit"/>
    </Menu>

    {# edit: The "Edit" menu. #}
    <Menu name="edit">
      <text>&amp;Edit</text>
      
      {# edit_undo: Undo the last action. #}
      <Action name="edit_undo"/>
      
      {# edit_redo: Redo the last undone action. #}
      <Action name="edit_redo"/>
      
      {# edit_undo_merge: Merge point for undo/redo actions from plugins. #}
      <MergeLocal name="edit_undo_merge"/>
      
      <Separator/>
      
      {# edit_cut: Cut the selected text/element. #}
      <Action name="edit_cut"/>
      
      {# edit_copy: Copy the selected text/element. #}
      <Action name="edit_copy"/>
      
      {# edit_paste: Paste from clipboard. #}
      <Action name="edit_paste"/>
      
      {# edit_paste_merge: Merge point for paste-related actions. #}
      <MergeLocal name="edit_paste_merge"/>
      
      {# edit_clear: Clear the current selection or content. #}
      <Action name="edit_clear"/>
      
      <Separator/>
      
      {# edit_select_all: Select all content. #}
      <Action name="edit_select_all"/>
      
      {# edit_deselect: Deselect all content. #}
      <Action name="edit_deselect"/>
      
      {# edit_select_merge: Merge point for selection actions. #}
      <MergeLocal name="edit_select_merge"/>
      
      <Separator/>
      
      {# edit_find: Find text/element. #}
      <Action name="edit_find"/>
      
      {# edit_find_next: Find the next occurrence. #}
      <Action name="edit_find_next"/>
      
      {# edit_find_prev: Find the previous occurrence. #}
      <Action name="edit_find_prev"/>
      
      {# edit_replace: Find and replace text/element. #}
      <Action name="edit_replace"/>
      
      {# edit_find_merge: Merge point for find/replace actions. #}
      <MergeLocal name="edit_find_merge"/>
      
      <Separator/>
      
      {# General merge point for edit actions. #}
      <MergeLocal/>
    </Menu>

    {# move: The "Move" menu. #}
    <Menu name="move">
      <text context="@title:menu Game move">&amp;Move</text>
      
      {# move_repeat: Repeat the last move. #}
      <Action name="move_repeat"/>
      
      {# move_undo: Undo the last move. #}
      <Action name="move_undo"/>
      
      {# move_redo: Redo the last undone move. #}
      <Action name="move_redo"/>
      
      {# move_undo_merge: Merge point for move undo/redo actions. #}
      <MergeLocal name="move_undo_merge"/>
      
      <Separator/>
      
      {# move_roll: Roll the dice. #}
      <Action name="move_roll"/>
      
      {# move_end_turn: End the current turn. #}
      <Action name="move_end_turn"/>
      
      {# move_turn_merge: Merge point for turn-related actions. #}
      <MergeLocal name="move_turn_merge"/>
      
      <Separator/>
      
      {# move_hint: Show a hint for the next move. #}
      <Action name="move_hint"/>
      
      {# move_demo: Demonstrate a sequence of moves. #}
      <Action name="move_demo"/>
      
      {# move_solve: Solve the current position. #}
      <Action name="move_solve"/>
      
      {# move_solve_merge: Merge point for solve/demo actions. #}
      <MergeLocal name="move_solve_merge"/>
      
      <Separator/>
      
      {# General merge point for move actions. #}
      <MergeLocal/>
    </Menu>

    {# Merge point before the View menu. #}
    <MergeLocal name="before_view"/>

    {# view: The "View" menu. #}
    <Menu name="view">
      <text>&amp;View</text>
      
      {# view_actual_size: Set view to 100% scale. #}
      <Action name="view_actual_size"/>
      
      {# view_fit_to_page: Fit the document to the page size. #}
      <Action name="view_fit_to_page"/>
      
      {# view_fit_to_width: Fit the document to the window width. #}
      <Action name="view_fit_to_width"/>
      
      {# view_fit_to_height: Fit the document to the window height. #}
      <Action name="view_fit_to_height"/>
      
      <Separator/>
      
      {# view_zoom_merge: Merge point for zoom-related actions. #}
      <MergeLocal name="view_zoom_merge"/>
      
      {# view_zoom_in: Zoom in. #}
      <Action name="view_zoom_in"/>
      
      {# view_zoom_out: Zoom out. #}
      <Action name="view_zoom_out"/>
      
      {# view_zoom: Zoom to a specific percentage. #}
      <Action name="view_zoom"/>
      
      <Separator/>
      
      {# view_redisplay: Redraw/refresh the view. #}
      <Action name="view_redisplay"/>
      
      {# view_redisplay_merge: Merge point for refresh actions. #}
      <MergeLocal name="view_redisplay_merge"/>
      
      <Separator/>
      
      {# General merge point for view actions. #}
      <MergeLocal/>
      
      <Separator/>
      
      {# fullscreen: Toggle fullscreen mode. #}
      <Action name="fullscreen"/>
      
      {# fullscreen_merge: Merge point for fullscreen actions. #}
      <MergeLocal name="fullscreen_merge"/>
    </Menu>

    {# Merge point before the Go menu. #}
    <MergeLocal name="before_go"/>

    {# go: The "Go" menu. #}
    <Menu name="go">
      <text>&amp;Go</text>
      
      {# go_up: Go up one level (e.g., in a tree or folder hierarchy). #}
      <Action name="go_up"/>
      
      {# go_back: Go back in history. #}
      <Action name="go_back"/>
      
      {# go_forward: Go forward in history. #}
      <Action name="go_forward"/>
      
      {# go_home: Go to the home/main view. #}
      <Action name="go_home"/>
      
      <Separator/>
      
      {# go_previous: Go to the previous item/page. #}
      <Action name="go_previous"/>
      
      {# go_next: Go to the next item/page. #}
      <Action name="go_next"/>
      
      {# go_goto_page: Jump to a specific page number. #}
      <Action name="go_goto_page"/>
      
      {# go_goto_line: Jump to a specific line number. #}
      <Action name="go_goto_line"/>
      
      {# go_goto: Go to a specific location/destination. #}
      <Action name="go_goto"/>
      
      <Separator/>
      
      {# go_first: Go to the first item/page. #}
      <Action name="go_first"/>
      
      {# go_last: Go to the last item/page. #}
      <Action name="go_last"/>
      
      <Separator/>
      
      {# go_document_back: Go back in document history. #}
      <Action name="go_document_back"/>
      
      {# go_document_forward: Go forward in document history. #}
      <Action name="go_document_forward"/>
      
      <Separator/>
      
      {# General merge point for navigation actions. #}
      <MergeLocal/>
    </Menu>

    {# General merge point. #}
    <MergeLocal/>

    {# bookmarks: The "Bookmarks" menu. #}
    <Menu name="bookmarks">
      <text>&amp;Bookmarks</text>
      
      {# bookmark_add: Add a bookmark for the current location. #}
      <Action name="bookmark_add"/>
      
      {# bookmark_edit: Edit the current bookmark. #}
      <Action name="bookmark_edit"/>
      
      <Separator/>
      
      {# General merge point for bookmark actions. #}
      <MergeLocal/>
    </Menu>

    {# tools: The "Tools" menu. #}
    <Menu name="tools">
      <text>&amp;Tools</text>
      
      {# tools_spelling: Open the spell checker. #}
      <Action name="tools_spelling"/>
      
      {# General merge point for tools actions. #}
      <MergeLocal/>
    </Menu>

    {# settings: The "Settings" menu. #}
    <Menu name="settings">
      <text>&amp;Settings</text>
      
      {# General merge point for settings actions. #}
      <MergeLocal/>
      
      <Separator/>
      
      {# options_show_menubar: Toggle the visibility of the menu bar. #}
      <Action name="options_show_menubar"/>
      
      {# options_show_toolbar: Toggle the visibility of the toolbar. #}
      <Action name="options_show_toolbar"/>
      
      {# StandardToolBarMenuHandler: Menu handler for customizing toolbars. #}
      <Merge name="StandardToolBarMenuHandler" />
      
      {# KMDIViewActions: Actions for MDI (Multiple Document Interface) window management. #}
      <Merge name="KMDIViewActions"/>
      
      {# show_toolbar_merge: Merge point for toolbar visibility actions. #}
      <MergeLocal name="show_toolbar_merge"/>
      
      {# options_show_statusbar: Toggle the visibility of the status bar. #}
      <Action name="options_show_statusbar"/>
      
      {# show_merge: Merge point for view-related options. #}
      <MergeLocal name="show_merge"/>
      
      <Separator/>
      
      {# options_save_options: Save the current configuration settings. #}
      <Action name="options_save_options"/>
      
      {# options_choose_game_type: Choose the type of game to play. #}
      <Action name="options_choose_game_type"/>
      
      {# options_game_difficulty: Set the game difficulty level. #}
      <Action name="options_game_difficulty"/>
      
      {# save_merge: Merge point for settings save actions. #}
      <MergeLocal name="save_merge"/>
      
      <Separator/>
      
      {# switch_application_language: Switch the application language. #}
      <Action name="switch_application_language"/>
      
      {# options_configure_keybinding: Configure keyboard shortcuts. #}
      <Action name="options_configure_keybinding"/>
      
      {# options_configure_toolbars: Configure toolbars. #}
      <Action name="options_configure_toolbars"/>
      
      {# options_configure_notifications: Configure notification settings. #}
      <Action name="options_configure_notifications"/>
      
      {# options_configure_carddecks: Configure card decks (for card games). #}
      <Action name="options_configure_carddecks"/>
      
      {# options_configure_highscores: Configure high score settings. #}
      <Action name="options_configure_highscores"/>
      
      {# configure_merge: Merge point for configuration actions. #}
      <MergeLocal name="configure_merge"/>
      
      {# options_configure: Open the main configuration dialog. #}
      <Action name="options_configure"/>
    </Menu>

    {# Merge point after settings menu. #}
    <MergeLocal name="settings_merge"/>

    <Separator/>

    {# help: The "Help" menu. #}
    <Menu name="help">
      <text>&amp;Help</text>
      
      {# help_contents: Display the user manual or help contents. #}
      <Action name="help_contents"/>
      
      {# help_whats_this: Show "What's This" help for the focused element. #}
      <Action name="help_whats_this"/>
      
      {# open_kcommand_bar: Open the command bar (KRunner integration). #}
      <Action name="open_kcommand_bar"/>
      
      {# help_whats_this_merge: Merge point for help actions. #}
      <MergeLocal name="help_whats_this_merge"/>
      
      <Separator/>
      
      {# General merge point for help actions. #}
      <MergeLocal/>
      
      <Separator/>
      
      {# help_show_tip: Show a random application tip. #}
      <Action name="help_show_tip"/>
      
      <Separator/>
      
      {# help_report_bug: Open the bug reporting tool. #}
      <Action name="help_report_bug"/>
      
      <Separator/>
      
      {# help_donate: Link to donation page. #}
      <Action name="help_donate"/>
      
      <Separator/>
      
      {# about_merge: Merge point for about actions. #}
      <MergeLocal name="about_merge"/>
      
      {# help_about_app: Show the application's about dialog. #}
      <Action name="help_about_app"/>
      
      {# help_about_kde: Show the KDE Frameworks/Qt about dialog. #}
      <Action name="help_about_kde"/>
    </Menu>

  </MenuBar>

  {# ToolBar: The main toolbar. #}
  <ToolBar name="mainToolBar">
    <text>Main Toolbar</text>
    
    {# file_new: New file button. #}
    <Action name="file_new"/>
    
    {# file_open: Open file button. #}
    <Action name="file_open"/>
    
    {# file_save: Save file button. #}
    <Action name="file_save"/>
    
    {# file_print: Print button. #}
    <Action name="file_print"/>
    
    {# file_print_preview: Print preview button. #}
    <Action name="file_print_preview"/>
    
    {# file_mail: Mail button. #}
    <Action name="file_mail"/>
    
    <Separator/>
    
    {# edit_undo: Undo button. #}
    <Action name="edit_undo"/>
    
    {# edit_redo: Redo button. #}
    <Action name="edit_redo"/>
    
    {# edit_cut: Cut button. #}
    <Action name="edit_cut"/>
    
    {# edit_copy: Copy button. #}
    <Action name="edit_copy"/>
    
    {# edit_paste: Paste button. #}
    <Action name="edit_paste"/>
    
    <Separator/>
    
    {# edit_find: Find button. #}
    <Action name="edit_find"/>
    
    {# view_zoom: Zoom button. #}
    <Action name="view_zoom"/>
    
    <Separator/>
    
    {# go_previous: Previous button. #}
    <Action name="go_previous"/>
    
    {# go_next: Next button. #}
    <Action name="go_next"/>
    
    {# go_home: Home button. #}
    <Action name="go_home"/>
    
    <Separator/>
    
    {# General merge point for toolbar actions. #}
    <MergeLocal/>
    
    {# help: Help button. #}
    <Action name="help"/>
  </ToolBar>

  {# StatusBar: The status bar at the bottom of the window. #}
  <StatusBar/>

</gui>
