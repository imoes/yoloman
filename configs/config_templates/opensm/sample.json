{
  "log_verbose": false,
  "log_level": 2,
  "log_file": "/var/log/opensm.log",
  "auto_restart": true,
  "max_retries": 3,
  "retry_delay": 10,
  "primary_port_guid": "0",
  "priority": 1,
  "default_priority": 15,
  "sm_mode": "master",
  "split_mode": false,
  "num_threads": 4,
  "max_mads": 256,
  "mad_timeout": 2000,
  "qos": false,
  "sl2vl": true,
  "gid_table": true,
  "pkey_table": true,
  "cmgd": false,
  "excluded_ports": [
    "0x2c9000100000001"
  ],
  "included_ports": [],
  "include_ports_only": false,
  "database_file": "/var/lib/opensm/opensm.db",
  "database_persist": true,
  "database_sync_interval": 300,
  "optimize_lid_allocation": true,
  "optimize_guid_allocation": true,
  "sam_extensions": false,
  "isert": false,
  "ipoib": true,
  "ipoib_mtu": 65520,
  "ipoib_ipv6": true,
  "ipoib_ipv6_mtu": 65520,
  "ipoib_gid_index": true,
  "ipoib_interfaces": [
    "ib0",
    "ib1"
  ],
  "multicast_forward": true,
  "multicast_forward_policy": "limited",
  "max_mcast_groups": 16384,
  "trap_forward": true,
  "trap_destinations": [
    "192.168.1.10:162",
    "192.168.1.11:162"
  ],
  "event_notification": false,
  "event_handler": "/usr/local/bin/opensm-event-handler.sh",
  "snmp": false,
  "snmp_community": "public",
  "snmp_port": 10161
}
