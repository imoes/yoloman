{
  "hostname": "living-room-renderer",
  "rest_api_port": 8080,
  "dbus_port": 0,
  "max_transcoding_sessions": 3,
  "enable_discovery": true,
  "media_profiles": [
    {
      "name": "audio-flac",
      "encoder": [
        "ffmpeg",
        "-i",
        "%i",
        "-acodec",
        "flac",
        "-compression_level",
        "5",
        "-f",
        "flac",
        "%o"
      ],
      "mime_type": "audio/flac",
      "enabled": true,
      "max_resolution": ""
    },
    {
      "name": "video-h265",
      "encoder": [
        "ffmpeg",
        "-i",
        "%i",
        "-c:v",
        "libx265",
        "-preset",
        "medium",
        "-crf",
        "24",
        "-c:a",
        "aac",
        "-b:a",
        "192k",
        "-f",
        "mp4",
        "%o"
      ],
      "mime_type": "video/hevc",
      "enabled": false,
      "max_resolution": "3840x2160"
    }
  ],
  "log_level": 3,
  "dbus_service_file": "/etc/dbus-1/system.d/dleyna-renderer-custom.conf",
  "enable_glib": true
}
