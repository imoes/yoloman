{
  "user": "opendmarc",
  "socket_path": "local:/var/spool/postfix/opendmarc/opendmarc.sock",
  "pid_file": "/var/run/opendmarc/opendmarc.pid",
  "syslog": "info",
  "debug": false,
  "trusted_authserv_ids": [
    "opendmarc"
  ],
  "internal_hosts": [
    "127.0.0.1",
    "::1",
    "10.0.0.0/8"
  ],
  "ignore_hosts": [
    "mail.example.com",
    "192.168.1.0/24"
  ],
  "whitelist_file": "/etc/opendmarc/whitelist.txt",
  "failure_reports": true,
  "failure_reports_sent_by": "opendmarc-reports@example.com",
  "reports_directory": "/var/log/opendmarc/reports",
  "report_interval": 86400,
  "report_bounce": "opendmarc-bounce@example.com",
  "report_rate_interval": 86400,
  "ststls": false,
  "sts_file": "/etc/opendmarc/sts.txt",
  "timeout": 30,
  "signature_key_file": "/etc/opendmarc/dkim.key",
  "signature_key_selector": "opendmarc",
  "strip_attachment": true,
  "report_min_quorum": 25,
  "failure_types": [
    "fail"
  ],
  "use_ipv6": true,
  "log_why": true,
  "ignore_authenticated_clients": true,
  "reject_failures": false,
  "add_received_spf": true,
  "arf_template": "/etc/opendmarc/arf.txt",
  "max_workers": 4,
  "max_report_size": 10485760,
  "smtp_host": "localhost",
  "smtp_port": 25,
  "smtp_timeout": 60,
  "smtp_use_tls": false,
  "smtp_verify_tls": true,
  "smtp_username": "",
  "smtp_password": "",
  "domain_settings": [
    {
      "domain": "example.com",
      "authserv_id": "opendmarc",
      "failure_reports": false,
      "ignore_hosts": [],
      "whitelist_file": ""
    },
    {
      "domain": "sub.example.com",
      "failure_reports": true,
      "ignore_hosts": [
        "192.168.1.1"
      ],
      "whitelist_file": "/etc/opendmarc/whitelist-sub.txt"
    }
  ]
}
