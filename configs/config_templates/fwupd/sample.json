{
  "enabled": true,
  "staging_dir": "/var/lib/fwupd/staging",
  "cache_dir": "/var/cache/fwupd",
  "log_dir": "/var/log/fwupd",
  "firmware_dir": "",
  "firmware_channels": [
    {
      "name": "stable",
      "remote": "https://fwupd.org/lvfs/firmware.xml.gz"
    },
    {
      "name": "testing",
      "remote": "https://fwupd.org/lvfs/firmware-testing.xml.gz"
    },
    {
      "name": "unstable",
      "remote": "https://fwupd.org/lvfs/firmware-unstable.xml.gz"
    }
  ],
  "show_version_in_gui": true,
  "firmware_verification": true,
  "min_power": 20,
  "min_time": 0,
  "max_attempts": 3,
  "retry_delay": 15,
  "automatic_background_updates": true,
  "suppress_power_screen": true,
  "ignored_device_flags": [
    "require-ac"
  ],
  "ignored_device_gids": [
    "usb:046d:c077"
  ],
  "debug_logging": false,
  "log_level": 2,
  "local_metadata_signing": false,
  "local_metadata_key": "",
  "lvfs_testing": false,
  "max_firmware_size": 536870912,
  "device_reenumerate": true,
  "offline_updates": false,
  "offline_update_lock_file": "/run/fwupd/offline-update.lock"
}
