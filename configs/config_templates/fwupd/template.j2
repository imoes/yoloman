# fwupd configuration file (fwupd.conf)
#
# This template is self-documenting. Each directive is preceded by a comment
# describing its purpose, derived from the schema definition.
# Variables use the |default() filter to ensure safe rendering even if the
# variable is undefined in the Ansible host context.

# Whether the fwupd daemon should start automatically.
Enabled={{ enabled | default(True) }}

# Directory where firmware images are staged before installation.
StagingDir={{ staging_dir | default('/var/lib/fwupd/staging') }}

# Directory for cached firmware metadata and checksums.
CacheDir={{ cache_dir | default('/var/cache/fwupd') }}

# Directory for daemon and plugin logs.
LogDir={{ log_dir | default('/var/log/fwupd') }}

# Optional local directory to serve firmware files from (leave blank to use
# remote repos like LVFS). If blank, fwupd will not load any local firmware
# directory.
FirmwareDir={{ firmware_dir | default('') }}

# Configure firmware update channels. Each channel maps to a remote metadata
# feed. The loop iterates over the list of channel dictionaries defined in
# the schema.
{% for channel in firmware_channels | default([{'name': 'stable', 'remote': 'https://fwupd.org/lvfs/firmware.xml.gz'}, {'name': 'testing', 'remote': 'https://fwupd.org/lvfs/firmware-testing.xml.gz'}, {'name': 'unstable', 'remote': 'https://fwupd.org/lvfs/firmware-unstable.xml.gz'}]) %}
# Firmware release channel: {{ channel.name }}
{% if channel.name == 'stable' %}RemoteStable={{ channel.remote }}
{% elif channel.name == 'testing' %}RemoteTesting={{ channel.remote }}
{% elif channel.name == 'unstable' %}RemoteUnstable={{ channel.remote }}
{% endif %}
{% endfor %}

# Whether firmware versions should appear in GUI update notifications.
ShowVersionInGUI={{ show_version_in_gui | default(True) }}

# Require verified firmware signatures. Enabling is strongly recommended for
# security to prevent installation of tampered or malicious firmware.
{% if firmware_verification | default(True) %}FirmwareVerification=true
{% else %}FirmwareVerification=false
{% endif %}

# Minimum battery percentage (0–100) required to proceed with firmware updates.
# Set to 0 to disable this check.
MinPower={{ min_power | default(10) }}

# Minimum time remaining on battery (seconds) before updates are allowed.
# Set to 0 to disable this check.
MinTime={{ min_time | default(0) }}

# Maximum number of retry attempts for a failed firmware update.
MaxAttempts={{ max_attempts | default(3) }}

# Seconds to wait before retrying a failed update.
RetryDelay={{ retry_delay | default(10) }}

# Enable automatic background update checks and installations (when system is
# idle).
{% if automatic_background_updates | default(True) %}AutomaticBackgroundUpdates=true
{% else %}AutomaticBackgroundUpdates=false
{% endif %}

# Suppress power-saving features (e.g., screen blanking) during long-running
# firmware updates to prevent sleep/hibernation during critical flashes.
{% if suppress_power_screen | default(True) %}SuppressPowerScreen=true
{% else %}SuppressPowerScreen=false
{% endif %}

# List of device flags to ignore (useful for known-bad firmware scenarios).
{% for flag in ignored_device_flags | default([]) %}
IgnoreDeviceFlags={{ flag }}
{% endfor %}

# List of hardware device IDs to completely skip during updates.
{% for gId in ignored_device_gids | default([]) %}
IgnoreDevice={{ gId }}
{% endfor %}

# Enable verbose debug logging (for troubleshooting only). Should not be
# enabled in production environments.
{% if debug_logging | default(False) %}Debug=true
{% else %}Debug=false
{% endif %}

# Verbosity level: 0=error, 1=warning, 2=info, 3=debug.
LogLevel={{ log_level | default(2) }}

# Use local signing keys for firmware metadata (advanced; not needed for
# LVFS). Only enable if managing custom firmware repositories.
{% if local_metadata_signing | default(False) %}LocalMetadataSigning=true
{% else %}LocalMetadataSigning=false
{% endif %}

# Path to private signing key (required if local_metadata_signing=true).
LocalMetadataKey={{ local_metadata_key | default('') }}

# Enable testing firmware from LVFS (Linux Vendor Firmware Service). Usually
# disabled in production.
{% if lvfs_testing | default(False) %}LVFSTesting=true
{% else %}LVFSTesting=false
{% endif %}

# Maximum firmware file size (bytes) allowed for download. 0 = no limit.
# Recommend ≤1073741824 (1 GiB) to prevent abuse or accidental large downloads.
MaxFirmwareSize={{ max_firmware_size | default(0) }}

# Re-enumerate device (trigger USB/HID reprobe) after firmware update if
# needed.
{% if device_reenumerate | default(True) %}DeviceReenumerate=true
{% else %}DeviceReenumerate=false
{% endif %}

# Enable offline update mode (for OEM imaging, pre-installation in initramfs).
{% if offline_updates | default(False) %}OfflineUpdates=true
{% else %}OfflineUpdates=false
{% endif %}

# Lock file path used to prevent concurrent offline update attempts.
OfflineUpdateLockFile={{ offline_update_lock_file | default('/run/fwupd/offline-update.lock') }}