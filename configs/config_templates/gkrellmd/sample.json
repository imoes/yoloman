{
  "bind_address": "0.0.0.0",
  "bind_port": 1912,
  "ssl_enabled": true,
  "ssl_cert_file": "/etc/gkrellmd/ssl/server.crt",
  "ssl_key_file": "/etc/gkrellmd/ssl/server.key",
  "log_level": 1,
  "log_file": "/var/log/gkrellmd.log",
  "data_refresh_ms": 2000,
  "max_clients": 5,
  "auth_enabled": true,
  "users": [
    {
      "name": "admin",
      "password": "secret123",
      "permissions": [
        "read",
        "control"
      ]
    },
    {
      "name": "viewer",
      "password": "viewpass",
      "permissions": [
        "read"
      ]
    }
  ],
  "snmp_enabled": true,
  "snmp_community": "public",
  "snmp_hosts": [
    {
      "hostname": "192.168.1.50",
      "community": "public",
      "version": "2c"
    },
    {
      "hostname": "printer.local",
      "version": "1"
    }
  ],
  "ups_enabled": true,
  "ups_type": "nut",
  "ups_host": "localhost",
  "ups_port": 3493,
  "ups_name": "myups",
  "mysql_enabled": true,
  "mysql_host": "localhost",
  "mysql_port": 3306,
  "mysql_user": "gkrellm",
  "mysql_password": "mysqlpass",
  "mysql_database": "",
  "pg_enabled": true,
  "pg_host": "localhost",
  "pg_port": 5432,
  "pg_user": "gkrellm",
  "pg_password": "pgpass",
  "pg_database": "postgres",
  "apache_enabled": false,
  "apache_status_url": "http://localhost/server-status?auto",
  "ntp_enabled": true,
  "ntp_server": "0.pool.ntp.org",
  "monitor_disks": true,
  "monitor_processes": true,
  "monitor_process_list": [
    {
      "name": "nginx",
      "cmdline": "nginx"
    },
    {
      "name": "sshd",
      "cmdline": "sshd"
    }
  ]
}
