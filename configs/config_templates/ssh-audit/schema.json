{
  "target_host": {
    "type": "string",
    "default": "localhost",
    "description": "The SSH server hostname or IP address to audit"
  },
  "audit_type": {
    "type": "string",
    "default": "server",
    "description": "The type of audit: 'server', 'client', or 'lookup'",
    "enum": [
      "server",
      "client"
    ]
  },
  "output_format": {
    "type": "string",
    "default": "text",
    "description": "Output format: 'text' or 'json'"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug output"
  },
  "no_colors": {
    "type": "bool",
    "default": false,
    "description": "Disable color output"
  },
  "level": {
    "type": "string",
    "default": "info",
    "description": "Minimum output level: 'info', 'warn', or 'fail'",
    "enum": [
      "info",
      "warn",
      "fail"
    ]
  },
  "port": {
    "type": "number",
    "default": 22,
    "description": "The TCP port to connect to or listen on"
  },
  "timeout": {
    "type": "number",
    "default": 5,
    "description": "Connection timeout in seconds"
  },
  "skip_rate_test": {
    "type": "bool",
    "default": false,
    "description": "Skip the connection rate test"
  },
  "threads": {
    "type": "number",
    "default": 32,
    "description": "Number of threads for scanning multiple targets"
  },
  "policy": {
    "type": "string",
    "default": "",
    "description": "Policy name or path to custom policy file"
  },
  "targets_file": {
    "type": "string",
    "default": "",
    "description": "Path to file containing list of target hosts"
  },
  "gex_test": {
    "type": "string",
    "default": "",
    "description": "Diffie-Hellman Group Exchange modulus size test parameters"
  },
  "dheat": {
    "type": "string",
    "default": "",
    "description": "DHEat DoS attack parameters"
  },
  "conn_rate_test": {
    "type": "string",
    "default": "",
    "description": "Connection rate test parameters"
  },
  "lookup_algorithms": {
    "type": "string",
    "default": "",
    "description": "Comma-separated list of algorithms to look up"
  },
  "ssh_version": {
    "type": "string",
    "default": "2",
    "description": "SSH protocol version to use: '1' or '2'",
    "enum": [
      "1",
      "2"
    ]
  },
  "ip_version": {
    "type": "string",
    "default": "4",
    "description": "IP version to prioritize: '4' for IPv4 or '6' for IPv6",
    "enum": [
      "4",
      "6"
    ]
  },
  "make_policy": {
    "type": "string",
    "default": "",
    "description": "Filename to create a policy based on the target server"
  }
}
