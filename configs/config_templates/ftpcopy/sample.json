{
  "jobs": [
    {
      "host": "ftp.example.com:21",
      "remote_dir": "/pub/archive",
      "local_dir": "/var/mirror/archive",
      "options": [
        "--user=myuser",
        "--pass=mypassword",
        "--exclude='*.tmp'",
        "--max-days=7",
        "--max-deletes=100",
        "--timeout=60"
      ]
    }
  ]
}
