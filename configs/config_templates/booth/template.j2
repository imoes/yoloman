# Booth Cluster Fence Agent Configuration
# This file configures the behavior of the 'booth' service, which is part of
# the Corosync/Pacemaker fence-agent ecosystem used for high-availability fencing.
#
# See also: booth(8), corosync(8)

# run_arbitrator: default='no' desc="Whether to start the booth arbitrator at boot. Valid values are 'yes' or 'no'.\n      enum: ['no', 'yes']"
RUN_ARBITRATOR={{ run_arbitrator | default('no') }}