# fence_kdump configuration file
# This file is generated by Ansible. It configures the fence_kdump agent, which enables
# cluster nodes to fence each other by triggering a kdump crash dump on the target node.
# The fencing mechanism relies on the target node having the 'fence_kdump' service enabled
# and reachable via the specified transport (typically IPMI or serial).
#
# The 'nodes' list defines the fencing targets. Each entry in 'nodes' corresponds to a
# cluster peer that this node can fence.
#
# Schema: nodes (list of dicts, default: [])
#   - Each dict in the list represents a remote node.
#   - 'name': Optional identifier for the node.
#   - 'ip': The IP address or hostname of the remote node.
#   - 'port': Port number for the transport (e.g., IPMI port).
#   - 'login': Username for authentication.
#   - 'password': Password for authentication (must be handled securely in practice).
#   - 'ipmi_*': Various IPMI-specific parameters.

{# Iterate over the list of nodes, defaulting to an empty list if undefined #}
{% for node in (nodes | default([])) %}
# -----------------------------------------------------------------------------
# Fencing Target Node Definition
# -----------------------------------------------------------------------------
# Description: Configuration block for a specific cluster node that will be fenced.
# Note: At least 'ip' (ipaddr) should be provided for each node to ensure connectivity.

# Optional: Human-readable name of the node
# Schema: node.name (string, optional)
# Description: A label for this node, used for identification in logs and output.
{% set _node = node | default({}) %}
{% if _node.name is defined and _node.name %}
name={{ _node.name }}
{% endif %}

# Required/Optional: IP address or hostname of the target node
# Schema: node.ip (string, required for connectivity)
# Description: The network address (IPv4/IPv6) or DNS hostname where the fence agent
# will attempt to trigger the kdump on the remote host.
{% if _node.ip is defined and _node.ip %}
ipaddr={{ _node.ip }}
{% endif %}

# Optional: Port number for the fence agent connection
# Schema: node.port (integer, optional)
# Description: The port number to use when connecting to the fencing service.
# For IPMI, this defaults to 623 but can be overridden here.
{% if _node.port is defined and _node.port %}
port={{ _node.port }}
{% endif %}

# Optional: Login username for authentication
# Schema: node.login (string, optional)
# Description: The username used to authenticate with the target node's fence mechanism.
{% if _node.login is defined and _node.login %}
login={{ _node.login }}
{% endif %}

# Optional: Password for authentication
# Schema: node.password (string, optional)
# Description: The password used to authenticate. In production, consider using
# credentials files or environment variables instead of plain text.
{% if _node.password is defined and _node.password %}
passwd={{ _node.password }}
{% endif %}

# Optional: IPMI LAN interface to use
# Schema: node.ipmi_lan_interface (string, optional)
# Description: Specifies the LAN interface (e.g., 'lanplus', 'lan') for IPMI communication.
{% if _node.ipmi_lan_interface is defined and _node.ipmi_lan_interface %}
lan_interface={{ _node.ipmi_lan_interface }}
{% endif %}

# Optional: IPMI authentication type
# Schema: node.ipmi_auth_type (string, optional)
# Description: The IPMI authentication algorithm (e.g., 'MD5', 'SHA', 'NONE').
{% if _node.ipmi_auth_type is defined and _node.ipmi_auth_type %}
auth_type={{ _node.ipmi_auth_type }}
{% endif %}

# Optional: IPMI privilege level
# Schema: node.ipmi_priv_level (string, optional)
# Description: The privilege level required for IPMI access (e.g., 'CALLBACK', 'USER', 'ADMIN', 'OPERATOR').
{% if _node.ipmi_priv_level is defined and _node.ipmi_priv_level %}
priv_level={{ _node.ipmi_priv_level }}
{% endif %}

# Optional: IPMI cipher suite
# Schema: node.ipmi_cipher_suite (integer, optional)
# Description: The IPMI cipher suite ID to use for encryption (e.g., 3 for RMCP+ cipher suite 3).
{% if _node.ipmi_cipher_suite is defined and _node.ipmi_cipher_suite %}
cipher_suite={{ _node.ipmi_cipher_suite }}
{% endif %}

# Optional: Use legacy IPMI keys
# Schema: node.ipmi_use_legacy_keys (boolean, optional)
# Description: If true, forces the use of legacy IPMI keys instead of the standard password hashing.
{% if _node.ipmi_use_legacy_keys is defined %}
{% if _node.ipmi_use_legacy_keys is true %}
use_legacy_keys=1
{% elif _node.ipmi_use_legacy_keys is false %}
use_legacy_keys=0
{% endif %}
{% endif %}

# Optional: Timeout for fencing operations
# Schema: node.timeout (integer, optional)
# Description: The maximum time in seconds to wait for the fencing action to complete.
{% if _node.timeout is defined and _node.timeout %}
timeout={{ _node.timeout }}
{% endif %}

# Optional: Number of retries
# Schema: node.retries (integer, optional)
# Description: The number of times to retry the fencing operation if it fails.
{% if _node.retries is defined and _node.retries %}
retries={{ _node.retries }}
{% endif %}

# Optional: Delay before fencing
# Schema: node.delay (integer, optional)
# Description: A delay in seconds before initiating the fencing action.
{% if _node.delay is defined and _node.delay %}
delay={{ _node.delay }}
{% endif %}

# Optional: Enable debug mode
# Schema: node.debug (boolean, optional)
# Description: If true, enables verbose debug output for troubleshooting fencing issues.
{% if _node.debug is defined and _node.debug is true %}
debug=1
{% endif %}

# End of configuration for node {{ _node.name | default('unknown') }}
{% if not loop.last %}

{% endif %}
{% endfor %}

{% if (nodes | default([]) | length) == 0 %}
# No nodes configured. The fence_kdump agent will not fence any peers.
# To configure fencing, add entries to the 'nodes' list in the Ansible variables.
{% endif %}