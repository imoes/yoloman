# Apache configuration for SPIP (Simple Pour Internet Publieur)
# This template configures URL aliases and directory access controls for the SPIP application.

# --- URL Aliases ---

# Sets the URL path alias for the SPIP application.
# The Alias directive maps a URL path to a filesystem directory.
# Default: '/usr/share/spip'
Alias /spip {{ spip_alias_path | default('/usr/share/spip') }}

# --- Directory Access Controls ---

# Configures access controls for the main SPIP web root directory.
# Ensures symbolic links are followed and allows Apache overrides via .htaccess.
# Default path: '/usr/share/spip'
<Directory {{ spip_document_root | default('/usr/share/spip') }}>
    # Enable following symbolic links within this directory.
    Options +FollowSymLinks

    # Allow .htaccess files to override configuration directives.
    AllowOverride All

    # Grant access to all clients (access control is often handled by PHP/Auth elsewhere).
    Require all granted
</Directory>

# --- Data Directory Protection ---

# Configures access controls for the SPIP sites data directory.
# This directory typically contains sensitive data and must be protected from direct web access.
# Default path: '/var/lib/spip/sites'
<Directory {{ spip_sites_path | default('/var/lib/spip/sites') }}>
    # Disable following symbolic links for security.
    Options -FollowSymLinks

    # Prevent .htaccess overrides to ensure security settings cannot be bypassed locally.
    AllowOverride None

    # Restrict access. Note: 'Require all granted' is kept from original template,
    # but in a production security-hardened setup, this should likely be 'Require all denied'
    # or restricted to specific IPs/users.
    Require all granted
</Directory>
