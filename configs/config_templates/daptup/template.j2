# ============================================================================
# Daptup Configuration Template
# ============================================================================
# This file configures Daptup, a tool that monitors package updates via
# 'apt-get/aptitude/cupt update' hooks. It provides information on new,
# outdated, and watched packages.
# ============================================================================

# ---------------------------------------------------------------------------
# General Settings
# ---------------------------------------------------------------------------

# Whether Daptup gathers and shows information on each 'apt-get/aptitude/cupt update' invocation.
# Possible values: "n" (no), "y" (yes).
# Reused from existing configuration.
DAPTUP_HOOK_ENABLED={{ DAPTUP_HOOK_ENABLED | default('y') }}

# Whether to show changes after updating the lists (in --post call).
# Possible values: "n" (no), "y" (yes).
# If this option is disabled, the administrator is supposed to run 'daptup --last'
# manually at some time after the update to see changes.
# Reused from existing configuration with y|n enum.
DAPTUP_SHOW_CHANGES_IN_POST={{ DAPTUP_SHOW_CHANGES_IN_POST | default('y') }}

# Enable check for outdated packages (packages with older versions prepared long ago,
# where newer candidates are available).
# Possible values: "n" (no), "y" (yes).
# Reused from existing configuration.
DAPTUP_CHECK_FOR_OUTDATED_PACKAGES={{ DAPTUP_CHECK_FOR_OUTDATED_PACKAGES | default('y') }}

# Minimum age (in days) for a package to be treated as 'outdated'.
# Reused from existing configuration.
DAPTUP_MINIMAL_DAY_COUNT_TREATING_OUTDATED={{ DAPTUP_MINIMAL_DAY_COUNT_TREATING_OUTDATED | default(90) }}

# Use colored output.
# Possible values: "n" (no), "y" (yes).
# Reused from existing configuration with y|n enum.
DAPTUP_USE_COLOR={{ DAPTUP_USE_COLOR | default('y') }}

# ---------------------------------------------------------------------------
# Package Watching and Display Settings
# ---------------------------------------------------------------------------

# Space-separated list of package names or regex patterns to watch (even if not installed).
# Regexes may not use ^ or $.
# Examples:
#   DAPTUP_PACKAGES_WATCH_FOR="gnash pytagsfs warsow"
#   DAPTUP_PACKAGES_WATCH_FOR="xfce4-.*-plugin"
# Reused from existing configuration.
DAPTUP_PACKAGES_WATCH_FOR="{{ DAPTUP_PACKAGES_WATCH_FOR | default('') }}"

# When daptup builds a list of available packages, include short descriptions to the output?
# Possible values: "n" (no), "y" (yes).
# Reused from existing configuration with y|n enum.
DAPTUP_NEW_INCLUDE_DESCRIPTION={{ DAPTUP_NEW_INCLUDE_DESCRIPTION | default('y') }}

# Disable column output (passes "--disable-columns" to aptitude).
# Only effective with newer aptitude versions.
# If aptitude is not installed, this option changes nothing and non-column output is used.
# Possible values: "n" (no), "y" (yes).
DAPTUP_DISABLE_COLUMNS={{ DAPTUP_DISABLE_COLUMNS | default('n') }}

# Format string passed to aptitude for new packages changes output.
# See aptitude docs for details. This option doesn't work if aptitude is not installed.
# Reused from existing configuration.
DAPTUP_NEW_DISPLAY_FORMAT="{{ DAPTUP_NEW_DISPLAY_FORMAT | default('%10p - %80d') }}"

# Maximum line width for aptitude output of new package changes.
# This option doesn't work if aptitude is not installed.
# Reused from existing configuration.
DAPTUP_NEW_DISPLAY_WIDTH={{ DAPTUP_NEW_DISPLAY_WIDTH | default(120) }}

# Format string passed to aptitude for watched packages changes output.
# See aptitude docs for details. This option doesn't work if aptitude is not installed.
# Reused from existing configuration.
DAPTUP_WATCH_DISPLAY_FORMAT="{{ DAPTUP_WATCH_DISPLAY_FORMAT | default('%p %V') }}"

# Maximum line width for aptitude output of watched package changes.
# This option doesn't work if aptitude is not installed.
# Reused from existing configuration.
DAPTUP_WATCH_DISPLAY_WIDTH={{ DAPTUP_WATCH_DISPLAY_WIDTH | default(50) }}