{
  "pid_file": "/run/booth/booth.pid",
  "log_file": "/var/log/booth/booth.log",
  "log_level": 2,
  "auth_timeout": 5,
  "ticket_timeout": 10,
  "auth": {
    "type": "file",
    "file_path": "/etc/booth/booth-secret"
  },
  "tickets": [
    {
      "name": "vip-frontend",
      "sites": [
        "10.0.1.10",
        "10.0.1.20",
        "10.0.1.30"
      ],
      "priority": 150,
      "revoke_timeout": 45
    },
    {
      "name": "db-primary",
      "sites": [
        "10.0.2.10",
        "10.0.2.20"
      ],
      "priority": 200,
      "revoke_timeout": 60
    }
  ],
  "server": {
    "enabled": true,
    "port": 9929,
    "peers": [
      "booth-node2.example.com",
      "booth-node3.example.com"
    ]
  }
}
