{
  "log_level": 2,
  "max_lines": 150,
  "html_status": true,
  "html_output": "/var/www/dhcp-status.html",
  "json_output": "/var/www/dhcp-status.json",
  "json_status": true,
  "csv_output": "/var/log/dhcpd-pools/daily.csv",
  "csv_status": true,
  "tz_offset": "-0500",
  "hostname": "dhcp.example.com",
  "listen_iface": "eth0",
  "listen_port": 9090,
  "update_interval": 30,
  "snmp_enable": true,
  "snmp_community": "secret-ro",
  "subnets": [
    {
      "name": "main-office",
      "network": "10.0.1.0/24",
      "start": "10.0.1.10",
      "end": "10.0.1.200",
      "lease_time": 43200,
      "enabled": true,
      "comment": "Office LAN, 24h lease"
    },
    {
      "name": "guest-wifi",
      "network": "10.0.2.0/24",
      "netmask": "255.255.255.0",
      "start": "10.0.2.100",
      "end": "10.0.2.150",
      "lease_time": 3600,
      "enabled": true,
      "comment": "Guest network, 1h lease"
    },
    {
      "name": "iot-devices",
      "network": "172.16.3.0/24",
      "start": "172.16.3.10",
      "end": "172.16.3.99",
      "lease_time": 604800,
      "enabled": false,
      "comment": "IOT VLAN \u2014 disabled pending config"
    }
  ]
}
