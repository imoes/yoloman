# /etc/pmount.allow
# pmount will allow users to additionally mount all devices that are
# listed here.

# This file is managed by Ansible. Do not edit manually.

# List of devices (by path, UUID, or LABEL) that pmount is permitted to mount.
# Each line should contain a single device identifier.
# Comments starting with '#' are ignored.
# Blank lines are ignored.

# Example entries:
#   /dev/sdb1
#   UUID=1234-5678
#   LABEL=MyUSBDrive

# Default: If this file is empty or does not exist, pmount uses the system
# defaults (usually allowing mount for removable media).
# To allow all users to mount any device (INSECURE), you might use:
# /dev/sd[a-z][0-9]
# /dev/loop[0-9]*
# However, it is recommended to be explicit and list specific devices or use
# udev rules for better security and flexibility.

# No specific fields are defined in the schema for pmount-redhat,
# so this template provides the base structure for the allowlist.
# If you have a list of allowed devices, define it in your playbook
# as a variable (e.g., pmount_allowed_devices) and use it like this:
#
# {% if pmount_allowed_devices is defined %}
# {% for device in pmount_allowed_devices %}
# {{ device }}
# {% endfor %}
# {% endif %}

# Since no schema fields were provided, we leave this empty with documentation.
# You can extend this template in your Ansible role by injecting variables
# if you choose to manage the content dynamically.
