# BZFlag server configuration file — main server settings
# Do not edit directly; use the configuration management interface

# Enable or disable the server
{{ enabled | string | lower }}

# Server name ( displayed in server list )
{{ server_name }}

# Admin email (for player reports and inquiries)
{{ admin_email }}

# Publicly advertised hostname or IP (must be reachable by players)
{{ public_host }}

# Port used for game traffic (UDP)
{{ udp_port }}

# Port used for HTTP status queries (TCP)
{{ http_port }}

# Maximum number of players allowed
{{ max_players }}

# Timeout (in seconds) before idle players are kicked
{{ idle_timeout }}

# Flag respawn time (in seconds)
{{ flag_respawn_time }}

# Game duration (in seconds); 0 = infinite
{{ game_duration }}

# Enable or disable password protection
{{ password_protected | string | lower }}
{% if password_protected %}
# Password required to connect (if enabled)
{{ game_password }}
{% endif %}

# Enable or disable team balancing
{{ team_balance | string | lower }}

# Default team rotation mode: 'none', 'random', 'fair'
{{ team_rotation }}

# Allowed game flags (comma-separated list; empty = all)
{% if allowed_flags | length > 0 %}
{{ allowed_flags | join(', ') }}
{% else %}
# (none — all flags enabled)
{% endif %}

# Disallowed game flags (comma-separated list)
{% if disallowed_flags | length > 0 %}
{{ disallowed_flags | join(', ') }}
{% else %}
# (none)
{% endif %}

# List of admin usernames (one per line)
{% if admins | length > 0 %}
{% for admin in admins %}{{ admin }}
{% endfor %}
{% else %}
# (none)
{% endif %}

# List of banned players (IP or username per line)
{% if bans | length > 0 %}
{% for ban in bans %}{{ ban }}
{% endfor %}
{% else %}
# (none)
{% endif %}

# List of allowed player networks (CIDR notation, one per line)
# Use '0.0.0.0/0' to allow all
{% if allowed_networks | length > 0 %}
{% for network in allowed_networks %}{{ network }}
{% endfor %}
{% else %}
0.0.0.0/0
{% endif %}

# Log level: 0 = silent, 1 = minimal, 2 = normal, 3 = verbose, 4 = debug
{{ log_level }}

# Log file path (relative to /var/log/bzflag/ or absolute)
{{ log_file }}

# Map rotation (list of map filenames)
{% for map in map_rotation %}{{ map }}
{% endfor %}

# Enable or disable HTTP stats endpoint
{{ http_stats | string | lower }}

# HTTP stats refresh interval (in seconds)
{{ http_stats_interval }}

# Enable or disable replay recording
{{ replay_enabled | string | lower }}

# Directory for replay files
{{ replay_directory }}

# Replay retention policy (in days)
{{ replay_retention_days }}

# Enable or disable ground vehicle physics (optional tweak)
{{ ground_vehicle_physics | string | lower }}

# Enable or disable wall jumping
{{ wall_jump | string | lower }}
