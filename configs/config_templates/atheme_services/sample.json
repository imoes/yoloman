{
  "services_name": "Atheme",
  "services_description": "Libera Services",
  "services_umask": "022",
  "max_connections": 512,
  "max_connections_per_ip": 8,
  "strict_dns": true,
  "dnsbl_check": false,
  "user_throttle": true,
  "modules_path": "/usr/lib/atheme",
  "required_modules": [
    {
      "name": "nickserv",
      "description": "Nickname registration"
    },
    {
      "name": "chanserv",
      "description": "Channel registration"
    },
    {
      "name": "operserv",
      "description": "Operator tools"
    },
    {
      "name": "memoserv",
      "description": "User memos"
    },
    {
      "name": "global",
      "description": "Global messages"
    },
    {
      "name": "helpserv",
      "description": "Help system"
    },
    {
      "name": "ns_ident",
      "description": "Ident-basedNickServ auth"
    }
  ],
  "db_engine": "postgres",
  "db_pg_host": "localhost",
  "db_pg_port": 5432,
  "db_pg_dbname": "atheme_prod",
  "db_pg_user": "atheme",
  "db_pg_password": "",
  "db_pg_use_ssl": true,
  "networks": [
    {
      "name": "Libera",
      "description": "Main network",
      "netname": "LIBERA",
      "sid": "A01",
      "nicksize": 30,
      "chansize": 30,
      "upstream": {
        "name": "irc.libera.chat",
        "host": "127.0.0.1",
        "port": 6697,
        "ssl": true,
        "ssl_verify": true,
        "password": "",
        "bind_ip": "192.168.1.10"
      },
      "usermask_pattern": "*!*@%h",
      "channel_default_flags": "+nst",
      "flags": {
        "noguest": false,
        "sslonly": true,
        "operspy": true,
        "enforce": true
      }
    }
  ],
  "operators": [
    {
      "name": "NetAdmin",
      "password_hash": "$6$rounds=656000$...",
      "type": "global",
      "admin": true,
      "swhois": "NetAdmin - Atheme Services Root",
      "can_rehash": true,
      "can_sethost": true,
      "can_setident": true,
      "can_setvhost": true,
      "can_admin_chans": true,
      "can_set_global_message": true,
      "can_view_logs": true
    },
    {
      "name": "NetOp",
      "password_hash": "$6$rounds=656000$...",
      "type": "local",
      "admin": false,
      "swhois": "NetOp - Libera Network Operator",
      "can_rehash": false,
      "can_sethost": false,
      "can_setident": false,
      "can_setvhost": true,
      "can_admin_chans": false,
      "can_set_global_message": true,
      "can_view_logs": false
    }
  ],
  "auth_backend": "none",
  "log_dir": "/var/log/atheme",
  "log_prefix": "atheme-",
  "log_extension": "log",
  "log_level": "NOTICE",
  "log_maxsize": 52428800,
  "log_rotate": true,
  "log_rotate_count": 14,
  "log_rotate_interval": 86400,
  "dns_servers": [
    "1.1.1.1",
    "9.9.9.9"
  ],
  "dns_timeout": 3,
  "dns_retries": 2,
  "enable_http": false
}
