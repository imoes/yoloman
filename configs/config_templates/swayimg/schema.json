{
  "scale": {
    "type": "string",
    "default": "optimal",
    "description": "Default image scale mode (optimal, width, height, fit, fill, real)",
    "enum": [
      "optimal",
      "width",
      "height",
      "fit",
      "fill",
      "real"
    ]
  },
  "order": {
    "type": "string",
    "default": "alpha",
    "description": "Order of the image list (none, alpha, reverse, random)",
    "enum": [
      "none",
      "alpha",
      "reverse",
      "random"
    ]
  },
  "start_gallery": {
    "type": "bool",
    "default": false,
    "description": "Start in gallery mode"
  },
  "recursive": {
    "type": "bool",
    "default": false,
    "description": "Read directories recursively"
  },
  "start_slideshow": {
    "type": "bool",
    "default": false,
    "description": "Start in slideshow mode"
  },
  "start_fullscreen": {
    "type": "bool",
    "default": false,
    "description": "Start in full screen mode"
  },
  "position": {
    "type": "string",
    "default": "parent",
    "description": "Initial position of the window (parent, or X,Y)"
  },
  "size": {
    "type": "string",
    "default": "parent",
    "description": "Initial size of the window (parent, image, or WIDTH,HEIGHT)"
  },
  "window_class": {
    "type": "string",
    "default": "swayimg",
    "description": "Constant window class/app_id"
  },
  "list_all": {
    "type": "bool",
    "default": true,
    "description": "List all images in the same directory as the image being loaded"
  },
  "color_space": {
    "type": "string",
    "default": "srgb",
    "description": "Color space for image decoding (srgb, display-p3, linear-srgb)"
  },
  "hw_accel": {
    "type": "bool",
    "default": true,
    "description": "Enable hardware acceleration"
  }
}
