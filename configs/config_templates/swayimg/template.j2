[swayimg]
# Default image scale mode (optimal, width, height, fit, fill, real)
scale = {{ scale | default('optimal') }}

# Order of the image list (none, alpha, reverse, random)
order = {{ order | default('alpha') }}

# Start in gallery mode (boolean)
start_gallery = {{ start_gallery | default(false) | lower }}

# Read directories recursively (boolean)
recursive = {{ recursive | default(false) | lower }}

# Start in slideshow mode (boolean)
start_slideshow = {{ start_slideshow | default(false) | lower }}

# Start in full screen mode (boolean)
start_fullscreen = {{ start_fullscreen | default(false) | lower }}

# Initial position of the window (parent, or X,Y)
position = {{ position | default('parent') }}

# Initial size of the window (parent, image, or WIDTH,HEIGHT)
size = {{ size | default('parent') }}

# Constant window class/app_id
window_class = {{ window_class | default('swayimg') }}

# List all images in the same directory as the image being loaded (boolean)
list_all = {{ list_all | default(true) | lower }}

# Color space for image decoding (srgb, display-p3, linear-srgb)
color_space = {{ color_space | default('srgb') }}

# Enable hardware acceleration (boolean)
hw_accel = {{ hw_accel | default(true) | lower }}