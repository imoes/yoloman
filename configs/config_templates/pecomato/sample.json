{
  "log_level": 2,
  "target_dir": "/tmp/pecomato_extract",
  "create_backups": true,
  "fix_inconsistencies": true,
  "extract_ext": ".iptc",
  "append_extract_ext": false,
  "dump_wrap_width": 80,
  "include_exps": [
    "IPTC.3:0-100",
    "IPTC.0x0219"
  ],
  "exclude_exps": [],
  "edit_exps": [
    "IPTC.0x0035=text:My Artist"
  ],
  "check_compliance": true,
  "test_mode": false,
  "extract_type": "iptc"
}
