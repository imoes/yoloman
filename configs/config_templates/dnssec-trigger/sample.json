{
  "validation": true,
  "unbound_conf": "/etc/unbound/unbound.conf",
  "bind_conf": "",
  "trust_anchor_files": [
    "/etc/dnssec-trigger/root-ksk-2017.sha256",
    "/etc/dnssec-trigger/root-ksk-2019.sha256"
  ],
  "auto_update": true,
  "hooks": [
    {
      "description": "Log trust anchor rotation to systemd journal",
      "path": "/usr/local/bin/log-rotation.sh"
    }
  ],
  "verbose": false,
  "refresh_interval": 43200,
  "modules": []
}
