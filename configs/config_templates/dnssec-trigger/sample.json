{
  "verbosity": "1",
  "pidfile": "/run/dnssec-triggerd.pid",
  "logfile": "/var/log/dnssec-trigger.log",
  "use_syslog": "yes",
  "chroot": "",
  "unbound_control": "/usr/sbin/unbound-control",
  "resolvconf": "/etc/resolv.conf",
  "domain": "",
  "search": "",
  "login_command": "sensible-browser",
  "login_location": "http://www.nlnetlabs.nl/projects/dnssec-trigger",
  "noaction": "no",
  "port": 8955,
  "server_key_file": "/etc/dnssec-trigger/dnssec_trigger_server.key",
  "server_cert_file": "/etc/dnssec-trigger/dnssec_trigger_server.pem",
  "control_key_file": "/etc/dnssec-trigger/dnssec_trigger_control.key",
  "control_cert_file": "/etc/dnssec-trigger/dnssec_trigger_control.pem",
  "check_updates": "no",
  "use_vpn_forwarders": "no",
  "use_private_addresses": "yes",
  "add_wifi_provided_zones": "no"
}
