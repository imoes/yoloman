# /usr/share/doc/lighttpd/ssl.txt
# -*- conflicts: mbedtls, gnutls, nss, wolfssl -*-

# Enable the OpenSSL module for lighttpd to handle HTTPS connections.
server.modules += ( "mod_openssl" )

# ssl.* variables in the global scope are inherited by $SERVER["socket"] blocks
# that enable SSL, allowing centralized certificate configuration.

# Path to the SSL PEM file containing the combined certificate and private key.
# The file must be readable by the lighttpd process user.
ssl.pemfile = "{{ (ssl | default({})).pemfile | default('/etc/lighttpd/server.pem') }}"

# Configure the SSL listener socket.
# This block enables SSL for connections arriving on the specified host and port.
$SERVER["socket"] == "{{ (ssl | default({})).host | default('0.0.0.0') }}:{{ (ssl | default({})).port | default(443) }}" {
    # Enable SSL encryption for this socket.
    ssl.engine  = "enable"
}

# Include IPv6 configuration if available.
# This shell script typically sets up an equivalent IPv6 listener if the system supports it.
include_shell "/usr/share/lighttpd/use-ipv6.pl 443"
