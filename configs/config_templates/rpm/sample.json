{
  "macros": [
    {
      "name": "_rpmfilename",
      "value": "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}.rpm"
    }
  ],
  "httpproxy": "proxy.example.com",
  "httpport": 3128,
  "dbpath": "/var/lib/rpm",
  "root": "/",
  "query_format": "%{NAME} %{VERSION}\\n",
  "include_docs": true,
  "exclude_docs": false
}
