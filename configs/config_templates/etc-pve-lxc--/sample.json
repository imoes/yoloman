{
  "name": "web-01",
  "ctid": 101,
  "rootfs": {
    "path": "/var/lib/lxc/101/rootfs",
    "options": [
      "rw",
      "relatime"
    ]
  },
  "network": {
    "interfaces": [
      {
        "type": "veth",
        "link": "vmbr0",
        "flags": "up",
        "ip": [
          "192.168.1.101/24"
        ],
        "gateway": "192.168.1.1"
      }
    ]
  },
  "memory": "512M",
  "cpu_cores": 2,
  "cpu_weight": 150,
  "mounts": [
    {
      "source": "/srv/data/web",
      "dest": "/data",
      "options": [
        "rbind",
        "rw"
      ]
    },
    {
      "source": "/etc/localtime",
      "dest": "/etc/localtime",
      "options": [
        "rbind",
        "ro"
      ]
    }
  ],
  "limits": {
    "memory_low": "256M",
    "pids_max": 256
  },
  "privileged": false,
  "start_auto": true,
  "start_delay": 10,
  "start_order": 1,
  "log_level": "INFO",
  "log_file": "/var/log/lxc/lxc-web-01.log"
}
