!* Application resources to control visibility of specific system metrics.
!* Each boolean enables (True) or disables (False) a display section.

! Enable display of the title bar.
*.showTitle:		{{ showTitle | default(True) }}

! Enable display of Load Average.
*.showLoadAvg:		{{ showLoadAvg | default(True) }}

! Enable display of Load.
*.showLoad:		{{ showLoad | default(True) }}

! Enable display of Memory.
*.showMem:		{{ showMem | default(True) }}

! Enable display of Swap.
*.showSwap:		{{ showSwap | default(True) }}

! Enable SMP Kernel display mode.
*.smpKernel:		{{ smpKernel | default(True) }}

!* Define fonts for the application interface.

! Default font for the application.
*.font:			{{ font | default('-adobe-courier-*-*-*-*-*-*-*-*-m-*-*-*') }}

! Font for the title bar.
*.title.font:		{{ title_font | default('-adobe-courier-*-*-*-*-*-140-*-*-m-*-*-*') }}

!* Display refresh and bar styling parameters.

! Update interval for all values in milliseconds.
*bar.update:		{{ bar_update | default(200) }}

!* Load Average Bar Colors

! Foreground color for load average bar segment 1.
*loadavg*bar.foreground:	{{ loadavg_bar_foreground | default('grey70') }}

! Foreground color for load average bar segment 2.
*loadavg*bar.foreground1:	{{ loadavg_bar_foreground1 | default('grey60') }}

! Foreground color for load average bar segment 3.
*loadavg*bar.foreground2:	{{ loadavg_bar_foreground2 | default('grey50') }}

! Foreground color for load average bar segment 4.
*loadavg*bar.foreground3:	{{ loadavg_bar_foreground3 | default('grey40') }}

! Foreground color for load average bar segment 5.
*loadavg*bar.foreground4:	{{ loadavg_bar_foreground4 | default('grey30') }}

! Foreground color for load average bar segment 6.
*loadavg*bar.foreground5:	{{ loadavg_bar_foreground5 | default('grey20') }}

! Foreground color for load average bar segment 7.
*loadavg*bar.foreground6:	{{ loadavg_bar_foreground6 | default('grey10') }}

! Foreground color for load average bar segment 8.
*loadavg*bar.foreground7:	{{ loadavg_bar_foreground7 | default('black') }}

! Gap between load average bar segments in pixels.
*loadavg*bar.segmentGap:	{{ loadavg_bar_segmentGap | default(1) }}

!* Idle/Load Gauge Colors

! Foreground color for load gauge bar segment 1.
*load*bar.foreground:	{{ load_bar_foreground | default('grey70') }}

! Foreground color for load gauge bar segment 2.
*load*bar.foreground1:	{{ load_bar_foreground1 | default('grey50') }}

! Foreground color for load gauge bar segment 3.
*load*bar.foreground2:	{{ load_bar_foreground2 | default('grey30') }}

!* Memory Gauge Colors

! Foreground color for memory gauge bar segment 1.
*mem*bar.foreground:	{{ mem_bar_foreground | default('grey70') }}

! Foreground color for memory gauge bar segment 2.
*mem*bar.foreground1:	{{ mem_bar_foreground1 | default('grey50') }}

!* Swap Gauge Colors

! Foreground color for swap gauge bar segment 1.
*swap*bar.foreground:	{{ swap_bar_foreground | default('grey70') }}

! Foreground color for swap gauge bar segment 2.
*swap*bar.foreground1:	{{ swap_bar_foreground1 | default('grey50') }}

! Foreground color for swap gauge bar segment 3.
*swap*bar.foreground2:	{{ swap_bar_foreground2 | default('grey30') }}

!* General Window and Background Styling

! Background color of the main window.
*.background:		{{ background | default('grey80') }}

! Background color of the BarGauge.
*.BarGauge.background:	{{ bar_gauge_background | default('white') }}

! Space in pixels between two adjacent segments in a bar.
*bar.segmentGap:	{{ bar_segmentGap | default(1) }}

! Border width of the gauge windows.
*.BarGauge.borderWidth:	{{ bar_gauge_border_width | default(1) }}

! Border width of the main window.
*.borderWidth:		{{ border_width | default(0) }}

!* Text Labels and Dimensions

! Text label for the title bar.
*.title.label:		{{ title_label | default('Linux Kernel Info') }}

! Width of the title bar in pixels.
*.title.width:		{{ title_width | default(205) }}

! Label for the Load Average section.
*.loadavg.name.label:	{{ loadavg_name_label | default('LoadAvg:') }}

! Label for the Load section.
*.load.name.label:	{{ load_name_label | default('Load:   ') }}

! Label for the Memory section.
*.mem.name.label:	{{ mem_name_label | default('Memory: ') }}

! Label for the Swap section.
*.swap.name.label:	{{ swap_name_label | default('Swap:    ') }}