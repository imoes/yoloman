# Base protocols to enable
protocols = {{ protocols | join(' ') }}

# Listen on specified interfaces (empty = all)
listen = {% if listen | length %}{{ listen | join(', ') }}{% else %}*, ::{% endif %}

# Mail location — %u = username, %d = domain
mail_location = {{ mail_location }}

# Namespace configuration (default public namespace)
namespace inbox {
  inbox = yes
  mailbox Drafts {
    auto = subscribe
    special_use = \Drafts
  }
  mailbox Sent {
    auto = subscribe
    special_use = \Sent
  }
  mailbox Trash {
    auto = subscribe
    special_use = \Trash
  }
  mailbox Junk {
    auto = subscribe
    special_use = \Junk
  }
}

# Logging configuration
log_path = {{ log_path }}
info_log_path = {{ info_log_path }}

# SSL/TLS configuration
ssl = {{ ssl }}
ssl_cert = {{ ssl_cert }}
ssl_key = {{ ssl_key }}
{% if ssl_min_protocol %}
ssl_min_protocol = {{ ssl_min_protocol }}
{% endif %}
{% if ssl_prefer_server_ciphers %}
ssl_prefer_server_ciphers = {{ ssl_prefer_server_ciphers | lower }}
{% endif %}

# Disable plaintext auth unless SSL/TLS is active
disable_plaintext_auth = {{ disable_plaintext_auth | lower }}

# Authentication configuration
auth_mechanisms = {{ auth_mechanisms | join(' ') }}

passdb {
  driver = ldap
  # LDAP passdb arguments
  args = {{ passdb_args | to_json }}
}

userdb {
  driver = ldap
  # LDAP userdb arguments
  args = {{ userdb_args | to_json }}
}

# LDAP-specific defaults — override per-passdb/userdb if needed
ldap {
  host = {{ ldap.host | join(',') }}
  uris = {{ ldap.uris | join(' ') }}
  dn = {{ ldap.dn }}
  dnpass = {{ ldap.dnpass }}
  auth_bind = {{ ldap.auth_bind | lower }}
  base = {{ ldap.base }}
  scope = {{ ldap.scope }}
  user_filter = {{ ldap.user_filter }}
  pass_filter = {{ ldap.pass_filter }}
  default_pass_scheme = {{ ldap.default_pass_scheme }}
  user_attrs = {{ ldap.user_attrs | to_json }}
  user_global_uid = {{ ldap.user_global_uid }}
}

# Service configuration for IMAP/POP3/LMTP
service imap-login {
  inet_listener imap {
    port = {{ services.imap.port }}
  }
  {% if services.imap.ssl_port %}
  inet_listener imaps {
    port = {{ services.imap.ssl_port }}
    ssl = yes
  }
  {% endif %}
}

{% if 'pop3' in protocols %}
service pop3-login {
  inet_listener pop3 {
    port = {{ services.pop3.port }}
  }
  {% if services.pop3.ssl_port %}
  inet_listener pop3s {
    port = {{ services.pop3.ssl_port }}
    ssl = yes
  }
  {% endif %}
}
{% endif %}

service lmtp {
  unix_listener lmtp {
    mode = {{ services.lmtp.mode }}
    user = {{ services.lmtp.user }}
    group = {{ services.lmtp.group }}
  }
}

{% if 'lda' in protocols %}
service lda {
  unix_listener auth-userdb {
    mode = {{ services.lda_auth.mode }}
    user = {{ services.lda_auth.user }}
    group = {{ services.lda_auth.group }}
  }
}
{% endif %}

# Authentication service — shared by passdb/userdb and LMTP/DAV
service auth {
  unix_listener auth-userdb {
    mode = {{ services.auth_userdb.mode }}
    user = {{ services.auth_userdb.user }}
    group = {{ services.auth_userdb.group }}
  }
  unix_listener auth-client {
    mode = {{ services.auth_client.mode }}
    user = {{ services.auth_client.user }}
  }
}

# Security limits
mail_max_userip_connections = {{ mail_max_userip_connections }}
mail_max_userip_disconnects = {{ mail_max_userip_disconnects }}

# Process limits
{% if auth_worker_max %}
auth_worker_max = {{ auth_worker_max }}
{% endif %}

# Mail plugins
mail_plugins = {{ mail_plugins | join(' ') }}

# ACL and quota plugins if enabled
{% if 'acl' in mail_plugins %}
plugin {
  acl = vfile
}
{% endif %}
{% if 'quota' in mail_plugins %}
plugin {
  quota = maildir:User quota
  quota_rule = *:storage={{ quota_default_limit }}M
  quota_grace = 10%%
  quota_status_success = DUNNO
}
{% endif %}
