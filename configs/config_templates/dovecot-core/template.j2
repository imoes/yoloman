# =============================================================================
# Dovecot Core Defaults Configuration
# File: /etc/default/dovecot
#
# This file controls environment variables passed to the Dovecot init script.
# It is self-documenting based on the provided schema.
# =============================================================================

# -----------------------------------------------------------------------------
# allow_coredumps: Set to '1' to allow Dovecot daemons to produce core dumps
#                  (disabled by default).
# Type: string (representing an integer 0 or 1)
# Default: '0'
# -----------------------------------------------------------------------------
#ALLOW_COREDUMPS={{ allow_coredumps | default('0') }}