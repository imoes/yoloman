{
  "protocols": [
    "imap",
    "pop3",
    "lmtp"
  ],
  "listen": [],
  "mail_location": "maildir:~/Maildir",
  "log_path": "/var/log/dovecot.log",
  "info_log_path": "/var/log/dovecot-info.log",
  "ssl": "required",
  "ssl_cert": "/etc/letsencrypt/live/mail.example.com/fullchain.pem",
  "ssl_key": "/etc/letsencrypt/live/mail.example.com/privkey.pem",
  "ssl_min_protocol": "TLSv1.2",
  "ssl_prefer_server_ciphers": true,
  "disable_plaintext_auth": true,
  "auth_mechanisms": [
    "plain",
    "login",
    "cram-md5"
  ],
  "passdb_args": {
    "scheme": "sha512-crypt",
    "ldap_uri": "ldap://ldap.example.com",
    "ldap_base": "ou=people,dc=example,dc=com",
    "ldap_version": 3,
    "ldap_auth_bind": "yes",
    "ldap_deref": "never"
  },
  "userdb_args": {
    "ldap_uri": "ldap://ldap.example.com",
    "ldap_base": "ou=people,dc=example,dc=com",
    "ldap_version": 3
  },
  "ldap": {
    "host": [
      "ldap.example.com",
      "ldap-backup.example.com"
    ],
    "uris": [
      "ldap://ldap.example.com",
      "ldap://ldap-backup.example.com"
    ],
    "dn": "cn=proxyuser,dc=example,dc=com",
    "dnpass": "supersecret",
    "auth_bind": true,
    "base": "ou=people,dc=example,dc=com",
    "scope": "subtree",
    "user_filter": "(&(objectClass=posixAccount)(uid=%u))",
    "pass_filter": "(&(objectClass=posixAccount)(uid=%u))",
    "default_pass_scheme": "SHA512-CRYPT",
    "user_attrs": [
      "{homeDirectory} = home",
      "{mailHomeDirectory} = mail",
      "{uidNumber} = uid",
      "{gidNumber} = gid"
    ],
    "user_global_uid": "%u"
  },
  "services": {
    "imap": {
      "port": 143,
      "ssl_port": 993
    },
    "pop3": {
      "port": 110,
      "ssl_port": 995
    },
    "lmtp": {
      "mode": "0666",
      "user": "dovecot",
      "group": "dovecot"
    },
    "lda_auth": {
      "mode": "0660",
      "user": "dovecot",
      "group": "dovecot"
    },
    "auth_userdb": {
      "mode": "0666",
      "user": "dovecot",
      "group": "dovecot"
    },
    "auth_client": {
      "mode": "0666",
      "user": "dovecot"
    }
  },
  "mail_max_userip_connections": 15,
  "mail_max_userip_disconnects": 30,
  "auth_worker_max": 4,
  "mail_plugins": [
    "acl",
    "quota",
    "imap_acl"
  ],
  "quota_default_limit": 5120
}
