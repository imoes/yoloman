{
  "cmtab_entries": [
    {
      "label": "home",
      "device": "/dev/sda7",
      "target": "home",
      "cipher": "aes-cbc-essiv:sha256",
      "keyfile": "/etc/cryptmount/home.key",
      "keylength": 256,
      "flags": [
        "bootwait",
        "umount"
      ],
      "options": [
        "utf8",
        "uid=1000",
        "gid=1000"
      ]
    },
    {
      "label": "backup",
      "device": "/home/backup.img",
      "target": "backup",
      "cipher": "twofish-xts-plain64",
      "keyfile": "-",
      "keylength": 256,
      "flags": [
        "noauto"
      ],
      "options": []
    },
    {
      "label": "tmp",
      "device": "/dev/loop0",
      "target": "tmp",
      "cipher": "aes-ecb-plain",
      "keyfile": "none",
      "keylength": 128,
      "flags": [
        "rekey"
      ],
      "options": [
        "noexec",
        "nosuid"
      ]
    }
  ]
}
