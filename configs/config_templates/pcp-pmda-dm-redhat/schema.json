{
  "rule": {
    "type": "string",
    "default": "$rule$",
    "description": "The summary rule name."
  },
  "threshold": {
    "type": "number",
    "default": 95,
    "description": "The threshold of dmthin pool fullness expressed as a percentage."
  },
  "action_expand": {
    "type": "string",
    "default": "%v%used [%i]@%h",
    "description": "The action expansion format string."
  },
  "email_expand": {
    "type": "string",
    "default": "host: %h pool: %i data utilization: %v%",
    "description": "The email expansion format string."
  },
  "delta": {
    "type": "string",
    "default": "10 mins",
    "description": "Sample interval between evaluations of this rule."
  }
}
