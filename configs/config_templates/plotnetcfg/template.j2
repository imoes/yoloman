# ============================================================================
# plotnetcfg - Network Configuration Diagram Generator
# ============================================================================
# This template generates configuration for plotnetcfg, a tool that creates
# visual diagrams of network configurations (e.g., Open vSwitch topologies).
# Self-documenting: every directive is described below.
# ============================================================================

# format: Output format for the network diagram.
# Supported formats typically include: dot, json, svg, pdf, png, ps, etc.
# Use `plotnetcfg --list-formats` on the target system to see available options.
# Default: dot (Graphviz DOT format)
format = {{ format | default('dot') }}

# ovs_db: Path to the UNIX domain socket used to communicate with the
# Open vSwitch (OVS) database server (ovsdb-server).
# This is only relevant if the network contains Open vSwitch bridges/ports.
# If no OVS interfaces are detected, this setting is ignored.
# Default: /var/run/openvswitch/db.sock
ovs_db = {{ ovs_db | default('/var/run/openvswitch/db.sock') }}