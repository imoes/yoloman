[DEFAULT]

# Seconds between periodic task runs (integer value)
# The Neutron TAAS OVS agent uses this interval to schedule periodic tasks.
{% if taas_agent_periodic_interval is defined and taas_agent_periodic_interval is not none and (taas_agent_periodic_interval is number or taas_agent_periodic_interval is boolean or taas_agent_periodic_interval | length > 0) %}taas_agent_periodic_interval = {{ taas_agent_periodic_interval | default('taas_agent_periodic_interval') }}{% else %}#taas_agent_periodic_interval = 5{% endif %}

# The project name used for variable substitution (e.g., neutron, nova, cinder).
# Must match the package prefix.
project_name = {{ project_name | default('neutron') }}
