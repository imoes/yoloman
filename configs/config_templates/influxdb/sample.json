  "http_max_write_timeout": "10s",
  "http_max_header_size": 1048576,
  "storage_cache_max_memory_size": 262144000,
  "storage_cache_memory_warn_percent": 80,
  "storage_tsm_full_compaction_enabled": true,
  "storage_tsm_optimize_on_shutdown": false,
  "storage_tsm_wal_enabled": true,
  "storage_tsm_wal_sync_enabled": true,
  "coordinator_write_timeout_max": "10s",
  "coordinator_max_concurrent_queries": 0,
  "coordinator_query_timeout": "0s",
  "coordinator_log_queries_after": "0s",
  "coordinator_max_select_point": 0,
  "coordinator_max_select_series": 0,
  "coordinator_max_select_buckets": 0,
  "cq_enabled": true,
  "cq_check_interval": "10s",
  "cq_log_enabled": true,
  "cq_compute_queries_within": "1h",
  "cq_compute_runs_per_interval": 0,
  "tls_min_version": "TLS1.2",
  "graphite_enabled": true,
  "graphite_bind_address": "0.0.0.0:2003",
  "graphite_port": 2003,
  "graphite_database": "graphite",
  "graphite_retention": "autogen",
  "graphite_protocol": "tcp",
  "graphite_batch_size": 1000,
  "graphite_batch_pending": 5000,
  "graphite_batch_timeout": "1s",
  "graphite_tls_enabled": false,
  "graphite_tls_cert": "",
  "graphite_tls_key": "",
  "graphite_tls_ca": "",
  "graphite_templates": [
    "host.app.env.measurement",
    "app.env.measurement.field"
  ],
  "collectd_enabled": false,
  "collectd_bind_address": "127.0.0.1:25826",
  "collectd_port": 25826,
  "collectd_database": "collectd",
  "collectd_retention_policy": "autogen",
  "collectd_batch_size": 1000,
  "collectd_batch_pending": 5000,
  "collectd_batch_timeout": "1s",
  "collectd_tls_enabled": false,
  "collectd_tls_cert": "",
  "collectd_tls_key": "",
  "collectd_tls_ca": "",
  "collectd_typesdb": "/usr/share/collectd/types.db",
  "opentsdb_enabled": false,
  "opentsdb_bind_address": "127.0.0.1:4242",
  "opentsdb_port": 4242,
  "opentsdb_database": "opentsdb",
  "opentsdb_retention_policy": "autogen",
  "opentsdb_batch_size": 1000,
  "opentsdb_batch_pending": 5000,
  "opentsdb_batch_timeout": "1s",
  "opentsdb_tls_enabled": false,
  "opentsdb_tls_cert": "",
  "opentsdb_tls_key": "",
  "opentsdb_tls_ca": "",
  "udp_enabled": false,
  "udp_bind_address": "127.0.0.1:8089",
  "udp_port": 8089,
  "udp_database": "udp",
  "udp_retention_policy": "autogen",
  "udp_batch_size": 1000,
  "udp_batch_pending": 5000,
  "udp_batch_timeout": "1s"
