{
  "meta_dir": "/var/lib/influxdb/meta",
  "data_dir": "/var/lib/influxdb/data",
  "hints_dir": "/var/lib/influxdb/hints",
  "http_bind_address": "0.0.0.0:8086",
  "http_port": 8086,
  "http_enabled": true,
  "https_enabled": false,
  "https_cert_file": "",
  "https_key_file": "",
  "log_level": "info",
  "log_path": "/var/log/influxdb/influxd.log",
  "trace_logging_enabled": false,
  "logging_level": "info",
  "logging_format": "logfmt",
  "monitoring_enabled": false,
  "monitoring_bind_address": "127.0.0.1:8088",
  "monitoring_port": 8088,
  "retention_default": "autogen",
  "retention_duration": "0s",
  "retention_replication_factor": 1,
  "retention_check_enabled": true,
  "retention_check_interval": "30m",
  "shard_precreation_enabled": true,
  "shard_precreation_check_interval": "10m",
  "shard_precreation_advance_period": "1h",
  "admin_enabled": false,
  "admin_bind_address": "127.0.0.1:8083",
  "admin_port": 8083,
  "http_auth_enabled": false,
  "http_log_enabled": true,
  "http_max_row_limit": 10000,
  "http_max_concurrent_write_limit": 0,
