# [global] section — global configuration for InfluxDB
[global]
  # Path where metadata is stored
  {{"# " if not meta_dir_commented else ""}}meta-dir = "{{ meta_dir }}"
  # Path where WAL data is stored
  {{"# " if not data_dir_commented else ""}}data-dir = "{{ data_dir }}"
  # Path to the hints database (HRT) files
  {{"# " if not hints_dir_commented else ""}}hints-dir = "{{ hints_dir }}"
  # HTTP bind address for the API
  {{"# " if not http_bind_address_commented else ""}}http-bind-address = "{{ http_bind_address }}"
  # Port for HTTP API
  {{"# " if not http_port_commented else ""}}http-port = {{ http_port }}
  # Enable or disable the HTTP API
  {{"# " if not http_enabled_commented else ""}}http-enabled = {{ http_enabled }}
  # TLS configuration for HTTPS (optional — comment out if not using TLS)
  {{"# " if not https_enabled_commented else ""}}https-enabled = {{ https_enabled }}
  {{"# " if not https_cert_file_commented else ""}}https-cert-file = "{{ https_cert_file }}"
  {{"# " if not https_key_file_commented else ""}}https-key-file = "{{ https_key_file }}"
  # Log level: debug, info, warn, error
  {{"# " if not log_level_commented else ""}}log-level = "{{ log_level }}"
  # Path to log file (empty string = stdout)
  {{"# " if not log_path_commented else ""}}log-path = "{{ log_path }}"
  # Trace logging (for debugging)
  {{"# " if not trace_logging_enabled_commented else ""}}trace-logging-enabled = {{ trace_logging_enabled }}

# [logging] section — advanced logging controls (InfluxDB 2.x style; preserved for compatibility)
[logging]
  {{"# " if not logging_level_commented else ""}}level = "{{ logging_level }}"
  {{"# " if not logging_format_commented else ""}}format = "{{ logging_format }}"

# [monitoring] section — internal monitoring (for InfluxDB OSS)
[monitoring]
  {{"# " if not monitoring_enabled_commented else ""}}enabled = {{ monitoring_enabled }}
  {{"# " if not monitoring_bind_address_commented else ""}}bind-address = "{{ monitoring_bind_address }}"
  {{"# " if not monitoring_port_commented else ""}}port = {{ monitoring_port }}

# [retention] section — retention policy defaults
[retention]
  {{"# " if not retention_check_enabled_commented else ""}}check-enabled = {{ retention_check_enabled }}
  {{"# " if not retention_check_interval_commented else ""}}check-interval = "{{ retention_check_interval }}"
  {{"# " if not retention_default_commented else ""}}default = "{{ retention_default }}"
  {{"# " if not retention_duration_commented else ""}}duration = "{{ retention_duration }}"
  {{"# " if not retention_replication_factor_commented else ""}}replication-factor = {{ retention_replication_factor }}

# [shard-precreation] section — auto-create shards ahead of time
[shard-precreation]
  {{"# " if not shard_precreation_enabled_commented else ""}}enabled = {{ shard_precreation_enabled }}
  {{"# " if not shard_precreation_check_interval_commented else ""}}check-interval = "{{ shard_precreation_check_interval }}"
  {{"# " if not shard_precreation_advance_period_commented else ""}}advance-period = "{{ shard_precreation_advance_period }}"

# [admin] section — legacy admin UI (deprecated in 2.x, may be omitted)
[admin]
  {{"# " if not admin_enabled_commented else ""}}enabled = {{ admin_enabled }}
  {{"# " if not admin_bind_address_commented else ""}}bind-address = "{{ admin_bind_address }}"
  {{"# " if not admin_port_commented else ""}}port = {{ admin_port }}

# [http] section — HTTP server tuning
[http]
  {{"# " if not http_bind_address_commented else ""}}bind-address = "{{ http_bind_address }}"
  {{"# " if not http_port_commented else ""}}port = {{ http_port }}
  {{"# " if not http_auth_enabled_commented else ""}}auth-enabled = {{ http_auth_enabled }}
  {{"# " if not http_log_enabled_commented else ""}}log-enabled = {{ http_log_enabled }}
  {{"# " if not http_max_row_limit_commented else ""}}max-row-limit = {{ http_max_row_limit }}
  {{"# " if not http_max_concurrent_write_limit_commented else ""}}max-concurrent-write-limit = {{ http_max_concurrent_write_limit }}
  {{"# " if not http_max_body_size_commented else ""}}max-body-size = {{ http_max_body_size }}
  {{"# " if not http_max_write_timeout_commented else ""}}max-write-timeout = "{{ http_max_write_timeout }}"
  {{"# " if not http_max_header_size_commented else ""}}max-header-size = {{ http_max_header_size }}

# [storage] section — storage engine settings (TSM1 engine)
[storage]
  {{"# " if not storage_cache_max_memory_size_commented else ""}}cache-max-memory-size = {{ storage_cache_max_memory_size }}
  {{"# " if not storage_cache_memory_warn_percent_commented else ""}}cache-memory-warn-percent = {{ storage_cache_memory_warn_percent }}
  {{"# " if not storage_tsm_full_compaction_enabled_commented else ""}}tsm-full-compaction-enabled = {{ storage_tsm_full_compaction_enabled }}
  {{"# " if not storage_tsm_optimize_on_shutdown_commented else ""}}tsm-optimize-on-shutdown = {{ storage_tsm_optimize_on_shutdown }}
  {{"# " if not storage_tsm_wal_enabled_commented else ""}}tsm-wal-enabled = {{ storage_tsm_wal_enabled }}
  {{"# " if not storage_tsm_wal_sync_enabled_commented else ""}}tsm-wal-sync-enabled = {{ storage_tsm_wal_sync_enabled }}

# [coordinator] section — query coordination and resource management
[coordinator]
  {{"# " if not coordinator_write_timeout_max_commented else ""}}write-timeout = "{{ coordinator_write_timeout_max }}"
  {{"# " if not coordinator_max_concurrent_queries_commented else ""}}max-concurrent-queries = {{ coordinator_max_concurrent_queries }}
  {{"# " if not coordinator_query_timeout_commented else ""}}query-timeout = "{{ coordinator_query_timeout }}"
  {{"# " if not coordinator_log_queries_after_commented else ""}}log-queries-after = "{{ coordinator_log_queries_after }}"
  {{"# " if not coordinator_max_select_point_commented else ""}}max-select-point = {{ coordinator_max_select_point }}
  {{"# " if not coordinator_max_select_series_commented else ""}}max-select-series = {{ coordinator_max_select_series }}
  {{"# " if not coordinator_max_select_buckets_commented else ""}}max-select-buckets = {{ coordinator_max_select_buckets }}

# [continuous_queries] section — CQ engine settings
[continuous_queries]
  {{"# " if not cq_enabled_commented else ""}}enabled = {{ cq_enabled }}
  {{"# " if not cq_check_interval_commented else ""}}check-interval = "{{ cq_check_interval }}"
  {{"# " if not cq_log_enabled_commented else ""}}log-enabled = {{ cq_log_enabled }}
  {{"# " if not cq_compute_queries_within_commented else ""}}compute-no-older-than = "{{ cq_compute_queries_within }}"
  {{"# " if not cq_compute_runs_per_interval_commented else ""}}compute-runs-per-interval = {{ cq_compute_runs_per_interval }}

# [tls] section — global TLS (optional, only if HTTPS/TLS used globally)
[tls]
  {{"# " if not tls_min_version_commented else ""}}min-version = "{{ tls_min_version }}"

# [graphite] section — Graphite input protocol (optional)
[graphite]
  {{"# " if not graphite_enabled_commented else ""}}enabled = {{ graphite_enabled }}
  {{"# " if not graphite_bind_address_commented else ""}}bind-address = "{{ graphite_bind_address }}"
  {{"# " if not graphite_port_commented else ""}}port = {{ graphite_port }}
  {{"# " if not graphite_database_commented else ""}}database = "{{ graphite_database }}"
  {{"# " if not graphite_retention_commented else ""}}retention-policy = "{{ graphite_retention }}"
  {{"# " if not graphite_protocol_commented else ""}}protocol = "{{ graphite_protocol }}"
  {{"# " if not graphite_batch-size_commented else ""}}batch-size = {{ graphite_batch_size }}
  {{"# " if not graphite_batch-pending_commented else ""}}batch-pending = {{ graphite_batch_pending }}
  {{"# " if not graphite_batch-timeout_commented else ""}}batch-timeout = "{{ graphite_batch_timeout }}"
  {{"# " if not graphite_tls_enabled_commented else ""}}tls-enabled = {{ graphite_tls_enabled }}
  {{"# " if not graphite_tls_cert_commented else ""}}tls-cert = "{{ graphite_tls_cert }}"
  {{"# " if not graphite_tls_key_commented else ""}}tls-key = "{{ graphite_tls_key }}"
  {{"# " if not graphite_tls_ca_commented else ""}}tls-ca = "{{ graphite_tls_ca }}"
  # Optional per-template config (supporting multiple templates)
  {{"# " if not graphite_templates_commented else ""}}templates = [
    {% for template in graphite_templates %}
      "{{ template }}"{% if not loop.last %},{% endif %}
    {% endfor %}
  ]

# [collectd] section — Collectd input protocol (optional)
[collectd]
  {{"# " if not collectd_enabled_commented else ""}}enabled = {{ collectd_enabled }}
  {{"# " if not collectd_bind_address_commented else ""}}bind-address = "{{ collectd_bind_address }}"
  {{"# " if not collectd_port_commented else ""}}port = {{ collectd_port }}
  {{"# " if not collectd_database_commented else ""}}database = "{{ collectd_database }}"
  {{"# " if not collectd_retention_policy_commented else ""}}retention-policy = "{{ collectd_retention_policy }}"
  {{"# " if not collectd_batch_size_commented else ""}}batch-size = {{ collectd_batch_size }}
  {{"# " if not collectd_batch_pending_commented else ""}}batch-pending = {{ collectd_batch_pending }}
  {{"# " if not collectd_batch_timeout_commented else ""}}batch-timeout = "{{ collectd_batch_timeout }}"
  {{"# " if not collectd_tls_enabled_commented else ""}}tls-enabled = {{ collectd_tls_enabled }}
  {{"# " if not collectd_tls_cert_commented else ""}}tls-cert = "{{ collectd_tls_cert }}"
  {{"# " if not collectd_tls_key_commented else ""}}tls-key = "{{ collectd_tls_key }}"
  {{"# " if not collectd_tls_ca_commented else ""}}tls-ca = "{{ collectd_tls_ca }}"
  {{"# " if not collectd_typesdb_commented else ""}}typesdb = "{{ collectd_typesdb }}"

# [opentsdb] section — OpenTSDB input protocol (optional)
[opentsdb]
  {{"# " if not opentsdb_enabled_commented else ""}}enabled = {{ opentsdb_enabled }}
  {{"# " if not opentsdb_bind_address_commented else ""}}bind-address = "{{ opentsdb_bind_address }}"
  {{"# " if not opentsdb_port_commented else ""}}port = {{ opentsdb_port }}
  {{"# " if not opentsdb_database_commented else ""}}database = "{{ opentsdb_database }}"
  {{"# " if not opentsdb_retention_policy_commented else ""}}retention-policy = "{{ opentsdb_retention_policy }}"
  {{"# " if not opentsdb_batch_size_commented else ""}}batch-size = {{ opentsdb_batch_size }}
  {{"# " if not opentsdb_batch_pending_commented else ""}}batch-pending = {{ opentsdb_batch_pending }}
  {{"# " if not opentsdb_batch_timeout_commented else ""}}batch-timeout = "{{ opentsdb_batch_timeout }}"
  {{"# " if not opentsdb_tls_enabled_commented else ""}}tls-enabled = {{ opentsdb_tls_enabled }}
  {{"# " if not opentsdb_tls_cert_commented else ""}}tls-cert = "{{ opentsdb_tls_cert }}"
  {{"# " if not opentsdb_tls_key_commented else ""}}tls-key = "{{ opentsdb_tls_key }}"
  {{"# " if not opentsdb_tls_ca_commented else ""}}tls-ca = "{{ opentsdb_tls_ca }}"

# [udp] section — UDP input protocol (optional)
[udp]
  {{"# " if not udp_enabled_commented else ""}}enabled = {{ udp_enabled }}
  {{"# " if not udp_bind_address_commented else ""}}bind-address = "{{ udp_bind_address }}"
  {{"# " if not udp_port_commented else ""}}port = {{ udp_port }}
  {{"# " if not udp_database_commented else ""}}database = "{{ udp_database }}"
  {{"# " if not udp_retention_policy_commented else ""}}retention-policy = "{{ udp_retention_policy }}"
  {{"# " if not udp_batch_size_commented else ""}}batch-size = {{ udp_batch_size }}
  {{"# " if not udp_batch_pending_commented else ""}}batch-pending = {{ udp_batch_pending }}
  {{"# " if not udp_batch_timeout_commented else ""}}batch-timeout = "{{ udp_batch_timeout }}"

# [influxdb] section — deprecated, kept for legacy compatibility
[influxdb]
  # (no active settings in modern OSS)
