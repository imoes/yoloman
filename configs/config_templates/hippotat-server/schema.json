{
  "init_provides": {
    "type": "string",
    "default": "hippotatd",
    "description": "Provides name in LSB header"
  },
  "short_description": {
    "type": "string",
    "default": "hippotatd",
    "description": "Short description in LSB header"
  },
  "description": {
    "type": "string",
    "default": "Asinine IP over HTTP server",
    "description": "Long description in LSB header"
  },
  "daemon_path": {
    "type": "string",
    "default": "/usr/sbin/hippotatd",
    "description": "Full path to hippotatd executable"
  },
  "main_config_path": {
    "type": "string",
    "default": "/etc/hippotat/main.cfg",
    "description": "Path to main configuration file"
  },
  "run_user": {
    "type": "string",
    "default": "_hippotat",
    "description": "User account under which hippotatd runs"
  },
  "run_group": {
    "type": "string",
    "default": "_hippotat",
    "description": "Group for hippotatd process"
  },
  "pidfile_path": {
    "type": "string",
    "default": "/var/run/hippotat/hippotatd.pid",
    "description": "Path to PID file"
  },
  "syslog_facility": {
    "type": "string",
    "default": "daemon",
    "description": "Syslog facility for logging",
    "enum": [
      "daemon",
      "daemon",
      "syslog",
      "user"
    ]
  },
  "check_firewall": {
    "type": "string",
    "default": "true",
    "description": "Whether to check firewall before starting (string 'true' or 'false')",
    "enum": [
      "true",
      "false"
    ]
  },
  "as_user_command": {
    "type": "string",
    "default": "as_user_userv",
    "description": "Command wrapper to run as unprivileged user"
  }
}
