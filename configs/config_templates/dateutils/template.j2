# dateutils configuration template
# dateutils(1) utilities do not read a persistent configuration file.
# This template generates shell aliases to standardize common dateutils command-line usage.

{% if enable_aliases | default(False) %}
# Shell aliases for dateutils commands
# Generated based on the 'aliases' list in the schema.
{% for cmd in aliases | default([]) %}
# {{ cmd.name | default('alias_name') }}: {{ cmd.tool | default('dateutils_tool') }}
# Options: {{ cmd.options | default('') }}
alias {{ cmd.name | default('alias_name') }}='{{ cmd.tool | default('dateutils_tool') }} {{ cmd.options | default('') }}'
{% endfor %}
{% endif %}