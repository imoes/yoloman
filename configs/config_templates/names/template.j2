# Configuration for names random name generator
# Controls how many names are generated per invocation.
# amount: Number of names to generate
amount: {{ (config | default({})).amount | default(1) }}
# Determines if a random number is appended to each generated name.
# number_suffix: Adds a random number to the name(s)
number_suffix: {{ (config | default({})).number_suffix | default(false) | lower }}