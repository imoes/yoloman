{
  "domain": "home.lan",
  "expand_hosts": true,
  "no_resolv": true,
  "no_poll": false,
  "read_ethers": false,
  "enable_tftp": false,
  "interface": "",
  "except_interface": "lo",
  "bind_interfaces": true,
  "bind_dynamic": false,
  "listen_address": "",
  "listen_addresses": [
    "127.0.0.1",
    "192.168.1.1"
  ],
  "no_dhcp_interface": "",
  "dhcp_pools": [
    {
      "name": "LAN_pool",
      "start": "192.168.1.100",
      "end": "192.168.1.200",
      "lease_time": "12h",
      "netmask": "255.255.255.0",
      "dns": [
        "192.168.1.1",
        "1.1.1.1"
      ],
      "gateway": "192.168.1.1",
      "ntp": [
        "192.168.1.1"
      ]
    }
  ],
  "static_leases": [
    {
      "name": "NAS",
      "mac": "aa:bb:cc:dd:ee:f0",
      "ip": "192.168.1.10",
      "hostname": "nas",
      "lease_time": "infinite"
    },
    {
      "name": "Printer",
      "mac": "aa:bb:cc:dd:ee:f1",
      "ip": "192.168.1.20",
      "hostname": "printer"
    }
  ],
  "server": "",
  "servers": [
    "9.9.9.9",
    "149.112.112.112"
  ],
  "dnssec": true,
  "dnssec_check_valid": false,
  "dns_rewrite_rules": [
    {
      "name": "block_tracking",
      "pattern": "doubleclick.net",
      "replace": "127.0.0.1"
    }
  ],
  "log_queries": true,
  "log_dhcp": true,
  "log_facility": "daemon",
  "cache_size": 1000,
  "min_cache_ttl": 60,
  "max_cache_ttl": 86400,
  "tftp_root": "",
  "tftp_no_fail": false,
  "extra_lines": [
    "bogus-priv",
    "local-ttl=60",
    "dhcp-boot=pxelinux.0"
  ]
}
