# ==============================================================================
# dnsmasq Init/Configuration Template
# ==============================================================================
#
# This file configures the dnsmasq service wrapper. It manages:
# 1) Disabling the instance.
# 2) Setting a default DOMAIN_SUFFIX via `dnsdomainname`.
# 3) Selecting an alternative configuration file via DNSMASQ_OPTS.
# 4) Specifying the configuration directory to scan for additional *.conf files.
# 5) Inhibiting resolvconf's control over upstream nameservers.
# 6) Excluding the loopback interface from being advertised by resolvconf.
#
# All shell variables set here are honored by the init script.
# ==============================================================================

# --------------------------------------------------------------------------
# Function 1: Disable the dnsmasq service.
# --------------------------------------------------------------------------
# To completely disable starting this dnsmasq instance, uncomment the line below.
# For systemd: systemctl disable dnsmasq
# For SYSV init: update-rc.d dnsmasq disable
# ENABLED=true

# --------------------------------------------------------------------------
# Function 2: Set the domain suffix.
# --------------------------------------------------------------------------
# Sets the default domain suffix by running `dnsdomainname`.
# Uncomment and modify if a specific suffix is required.
# DOMAIN_SUFFIX=`dnsdomainname`

# --------------------------------------------------------------------------
# Function 3: Alternative configuration file.
# --------------------------------------------------------------------------
# Selects an alternative configuration file instead of the default one.
# By default, dnsmasq reads /etc/dnsmasq.conf.
# DNSMASQ_OPTS="--conf-file=/etc/dnsmasq.alt"

# --------------------------------------------------------------------------
# Directory search for additional dnsmasq configuration files.
# --------------------------------------------------------------------------
# Directory searched for additional dnsmasq configuration files.
# dnsmasq will read all .conf files in this directory, excluding those ending
# in .dpkg-dist, .dpkg-old, or .dpkg-new (to avoid pulling in backups).
# Default: /etc/dnsmasq.d
config_dir={{ config_dir | default('/etc/dnsmasq.d') }},.dpkg-dist,.dpkg-old,.dpkg-new

# --------------------------------------------------------------------------
# Inhibit resolvconf control over upstream nameservers.
# --------------------------------------------------------------------------
# If the resolvconf package is installed, dnsmasq will use its output
# rather than the contents of /etc/resolv.conf to find upstream
# nameservers. Uncommenting this line inhibits this behaviour.
# Note that including a "resolv-file=<filename>" line in
# /etc/dnsmasq.conf is not enough to override resolvconf if it is
# installed: the line below must be uncommented.
# IGNORE_RESOLVCONF=yes

# --------------------------------------------------------------------------
# Exclude loopback interface from resolvconf advertisement.
# --------------------------------------------------------------------------
# If the resolvconf package is installed, dnsmasq will tell resolvconf
# to use dnsmasq under 127.0.0.1 as the system's default resolver.
# Uncommenting this line inhibits this behaviour.
# DNSMASQ_EXCEPT="lo"