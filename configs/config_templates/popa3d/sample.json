{
  "loglevel": 1,
  "spooldir": "/var/spool/mail",
  "daemon_user": "popper",
  "daemon_group": "mail",
  "max_connections": 50,
  "idle_timeout": 300,
  "tls_enabled": true,
  "tls_certfile": "/etc/ssl/certs/pop3.crt",
  "tls_keyfile": "/etc/ssl/private/pop3.key",
  "allowed_hosts": [],
  "denied_hosts": [],
  "debug": false,
  "chroot_enabled": true,
  "chroot_dir": "/var/chroot/popper",
  "top_enabled": true,
  "uidl_enabled": true,
  "sasl_enabled": false,
  "sasl_db_path": "/etc/sasldb2",
  "log_failed": true,
  "max_failed_attempts": 5,
  "lockout_duration": 600,
  "maildir_format": false,
  "quota_enabled": false,
  "quota_dir": "/var/spool/quota"
}
