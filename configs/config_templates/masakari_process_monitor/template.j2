[DEFAULT]
# The log directory for Masakari
log_dir = {{ log_dir }}

# The log file to use
log_file = {{ log_file }}

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
log_level = {{ log_level }}

# RPC backend to use (typically 'messagingv2')
transport_url = {{ transport_url }}

# Path to the process monitor configuration file (if externalized)
# process_monitor_config_file = {{ process_monitor_config_file }}

[process_monitor]
# Whether process monitoring is enabled
enabled = {{ enabled }}

# Interval (in seconds) between process checks
check_interval = {{ check_interval }}

# Number of consecutive failures before triggering recovery action
failure_threshold = {{ failure_threshold }}

# Action to take when a process failure is detected: restart, reboot_host, failover_host
recovery_method = {{ recovery_method }}

# Hostname or IP of the local node (if not auto-detected)
host_name = {{ host_name }}

# Whether to restart the failed process automatically (used with recovery_method=restart)
enable_auto_recovery = {{ enable_auto_recovery }}

# List of monitored processes with their specific settings
{% for proc in monitored_processes %}
[{{ proc.name }}]
# Enable monitoring for this process
enabled = {{ proc.enabled | default(true) }}

# Command pattern to match (regular expression or exact command)
command_pattern = {{ proc.command_pattern }}

# PID file path (optional, if process writes one)
pid_file = {{ proc.pid_file | default('') }}

# Action override per-process (inherit from global recovery_method if not set)
recovery_method = {{ proc.recovery_method | default(recovery_method) }}

# Failure threshold override per-process
failure_threshold = {{ proc.failure_threshold | default(failure_threshold) }}

{% endfor %}
