{
  "diskdef_name": {
    "type": "string",
    "description": "Name of the disk definition"
  },
  "seclen": {
    "type": "number",
    "default": 128,
    "description": "Sector length in bytes"
  },
  "tracks": {
    "type": "number",
    "default": 77,
    "description": "Number of tracks"
  },
  "sectrk": {
    "type": "number",
    "default": 26,
    "description": "Sectors per track"
  },
  "blocksize": {
    "type": "number",
    "default": 1024,
    "description": "Block size in bytes"
  },
  "maxdir": {
    "type": "number",
    "default": 64,
    "description": "Maximum number of directory entries"
  },
  "skew": {
    "type": "number",
    "default": 6,
    "description": "Sector skew (0 means no skew, or use skewtab)"
  },
  "skewtab": {
    "type": "string",
    "description": "Comma-separated skew table values (e.g., \"0,6,12,3,9,15,14,5,11,2,8,7,13,4,10,1\")"
  },
  "boottrk": {
    "type": "number",
    "default": 2,
    "description": "Boot track number"
  },
  "os": {
    "type": "string",
    "default": "2.2",
    "description": "Operating system identifier (e.g., \"2.2\", \"3\", \"p2dos\", \"zsys\")",
    "enum": [
      "2",
      "2.2",
      "3",
      "p2dos",
      "zsys"
    ]
  },
  "libdsk:format": {
    "type": "string",
    "description": "libdsk format override (if present)"
  },
  "dirblks": {
    "type": "number",
    "description": "Number of directory blocks"
  },
  "logicalextents": {
    "type": "number",
    "description": "Logical extents setting (0 or 1)"
  },
  "offset": {
    "type": "string",
    "description": "Partition offset (e.g., \"1000trk\", \"256KB\", \"8M\", etc.)"
  },
  "sides": {
    "type": "string",
    "description": "Sides ordering directive (e.g., \"alt\", \"outout\", etc.)",
    "enum": [
      "alt",
      "outout",
      "outback"
    ],
    "default": "alt"
  },
  "datarate": {
    "type": "string",
    "description": "Data rate (e.g., \"DD\")",
    "enum": [
      "SD",
      "DD",
      "HD",
      "ED"
    ],
    "default": "DD"
  },
  "fm": {
    "type": "string",
    "description": "FM/MFM format indicator (e.g., \"YES\" or omitted for MFM)",
    "enum": [
      "YES",
      "NO"
    ],
    "default": "NO"
  }
}
