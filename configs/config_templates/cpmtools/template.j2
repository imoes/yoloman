diskdef {{ diskdef_name }}
  seclen {{ seclen }}
  tracks {{ tracks }}
  sectrk {{ sectrk }}
  blocksize {{ blocksize }}
  maxdir {{ maxdir }}
{% if skewtab is defined %}
  skewtab {{ skewtab }}
{% else %}
  skew {{ skew }}
{% endif %}
  boottrk {{ boottrk }}
{% if libdsk_format is defined %}
  libdsk:format {{ libdsk_format }}
{% endif %}
{% if dirblks is defined %}
  dirblks {{ dirblks }}
{% endif %}
{% if logicalextents is defined %}
  logicalextents {{ logicalextents }}
{% endif %}
{% if offset is defined %}
  offset {{ offset }}
{% endif %}
{% if sides is defined %}
  sides {{ sides }}
{% endif %}
{% if datarate is defined %}
  datarate {{ datarate }}
{% endif %}
{% if fm is defined %}
  fm {{ fm }}
{% endif %}
  os {{ os }}
end

{% for diskdef in diskdefs %}
diskdef {{ diskdef.name }}
  seclen {{ diskdef.seclen }}
  tracks {{ diskdef.tracks }}
  sectrk {{ diskdef.sectrk }}
  blocksize {{ diskdef.blocksize }}
  maxdir {{ diskdef.maxdir }}
{% if diskdef.skewtab is defined %}
  skewtab {{ diskdef.skewtab }}
{% else %}
  skew {{ diskdef.skew }}
{% endif %}
  boottrk {{ diskdef.boottrk }}
{% if diskdef.libdsk_format is defined %}
  libdsk:format {{ diskdef.libdsk_format }}
{% endif %}
{% if diskdef.dirblks is defined %}
  dirblks {{ diskdef.dirblks }}
{% endif %}
{% if diskdef.logicalextents is defined %}
  logicalextents {{ diskdef.logicalextents }}
{% endif %}
{% if diskdef.offset is defined %}
  offset {{ diskdef.offset }}
{% endif %}
{% if diskdef.sides is defined %}
  sides {{ diskdef.sides }}
{% endif %}
{% if diskdef.datarate is defined %}
  datarate {{ diskdef.datarate }}
{% endif %}
{% if diskdef.fm is defined %}
  fm {{ diskdef.fm }}
{% endif %}
  os {{ diskdef.os }}
end
{% endfor %}