# ==============================================================================
# ipv6pref Configuration
#
# This file configures the default preference for IPv6 address selection on the
# local system. It determines whether the system prefers stable public IPv6
# addresses (v6pub) or temporary privacy addresses (v6tmp) for outgoing connections.
# ==============================================================================

# Preferred address type for outgoing connections: "public" or "temporary".
# - 'public': Corresponds to v6pub (stable public address). The system prefers
#   the configured, stable IPv6 address.
# - 'temporary': Corresponds v6tmp (privacy extension). The system prefers
#   temporary, privacy-focused IPv6 addresses generated via RFC 4941.
PREFERRED_ADDRESS_TYPE: {{ preferred_address_type | default('public') }}