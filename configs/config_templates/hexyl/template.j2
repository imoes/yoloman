{# Configuration file for hexyl, a command-line hex viewer #}
{# This template generates a key-value configuration for hexyl #}

{# length: Only read N bytes from the input; accepts decimal/binary units (e.g., '64', '4KiB') #}
{% if length is defined -%}
length = {{ length | default('') }}
{% endif -%}

{# skip: Skip the first N bytes of the input; accepts decimal/binary units (e.g., '1024', '1MiB') #}
{% if skip is defined -%}
skip = {{ skip | default('') }}
{% endif -%}

{# display_offset: Add N bytes to the displayed file position; accepts decimal/binary units (e.g., '0x10', '1k') #}
{% if display_offset is defined -%}
display_offset = {{ display_offset | default('') }}
{% endif -%}

{# block_size: Sets the size of the `block` unit to SIZE (used in unit parsing) #}
{% if block_size is defined -%}
block_size = {{ block_size | default(1024) }}
{% endif -%}

{# color: When to use colors: 'always', 'auto', or 'never' #}
{% if color is defined -%}
color = {{ color | default('always') }}
{% endif -%}

{# border: Border style: 'unicode', 'ascii', or 'none' #}
{% if border is defined -%}
border = {{ border | default('unicode') }}
{% endif -%}

{# no_squeezing: If true, disables line-squeezing (displays all input lines) #}
{% if no_squeezing is defined and no_squeezing | default(False) | bool -%}
no_squeezing = true
{% endif -%}