{
  "description": "Encrypted tar archive creation using multi-key-v3 and GPG agent",
  "bin_path": "/usr/bin/aespipe",
  "mode_args": "-e -O 0",
  "encryption_type": "AES256",
  "gpg_key_file": "/etc/aespipe/keys/backup.gpg",
  "passphrase_source": "-A /run/user/1000/gnupg/S.gpg-agent",
  "gpg_home": "/home/backup/.gnupg",
  "quiet_mode": true,
  "verbose": true,
  "wait_seconds": 30,
  "passphrase_file": "",
  "passphrase_fd": 0
}
