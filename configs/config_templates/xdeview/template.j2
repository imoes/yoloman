# xdeview configuration file (Tcl syntax)
# Generated by Ansible Jinja2 engine. Self-documented: every directive
# is preceded by the schema description and the variable name it maps to.

# ---------------------------------------------------------------------------
# option_fast (bool)
# Schema: If set to 1, use fast scanning mode.
# ---------------------------------------------------------------------------
# Set fast scanning mode (OptionFast)
# 1 = use fast scanning mode
set OptionFast {{ option_fast | default(False) | ternary(1, 0) }}

# ---------------------------------------------------------------------------
# option_bracket (bool)
# Schema: If set to 1, use the alternate bracket policy.
# ---------------------------------------------------------------------------
# Set alternate bracket policy for part numbers (OptionBracket)
# 1 = prioritize numbers in [] over ()
set OptionBracket {{ option_bracket | default(False) | ternary(1, 0) }}

# ---------------------------------------------------------------------------
# option_overwrite (bool)
# Schema: If set to 1, assume it's Ok to overwrite files without asking.
# ---------------------------------------------------------------------------
# Allow overwriting existing files without asking (OptionOverwrite)
# 1 = auto-overwrite
set OptionOverwrite {{ option_overwrite | default(False) | ternary(1, 0) }}

# ---------------------------------------------------------------------------
# option_desperate (bool)
# Schema: If set to 1, switch into desperate mode.
# ---------------------------------------------------------------------------
# Enable desperate mode for incomplete files (OptionDesperate)
# 1 = enable desperate mode
set OptionDesperate {{ option_desperate | default(False) | ternary(1, 0) }}

# ---------------------------------------------------------------------------
# option_verbose (bool)
# Schema: If set to 1, print progress messages.
# ---------------------------------------------------------------------------
# Print verbose progress messages (OptionVerbose)
# 1 = enable verbose mode
set OptionVerbose {{ option_verbose | default(False) | ternary(1, 0) }}

# ---------------------------------------------------------------------------
# save_file_path (string)
# Schema: Default Save Path for decoded files.
# ---------------------------------------------------------------------------
# Default save path for decoded files (SaveFilePath)
set SaveFilePath {{ save_file_path | default('/tmp') }}

# ---------------------------------------------------------------------------
# encode_max_lines (int)
# Schema: Maximum number of lines per file for encoding. 0 for unlimited.
# ---------------------------------------------------------------------------
# Maximum number of lines per file for encoding (EncodeMaxLines)
# 0 = unlimited
set EncodeMaxLines {{ encode_max_lines | default(0) }}

# ---------------------------------------------------------------------------
# encode_encoding (int)
# Schema: Default encoding to use. 0 for UUencoding, 1 for XXencoding, 2 for Base64.
# ---------------------------------------------------------------------------
# Default encoding method for encoding (EncodeEncoding)
# 0 = UUencoding, 1 = XXencoding, 2 = Base64
set EncodeEncoding {{ encode_encoding | default(2) }}

# ---------------------------------------------------------------------------
# nntp_server (string)
# Schema: NNTP server address.
# ---------------------------------------------------------------------------
# NNTP server address for posting (NNTPServer)
set NNTPServer {{ nntp_server | default('') }}