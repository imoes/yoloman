# ============================================================================
# Razercfg - Razer Device Configuration File
# ============================================================================
# This template generates the configuration file for the razercfg daemon,
# which manages Razer peripheral device profiles, polling rates, resolutions,
# and LED lighting effects.
#
# Each section corresponds to a specific device family (e.g., DeathAdder, Naga).
# Sections are matched against connected devices using wildcard patterns.
#
# SELF-DOCUMENTATION: Every configuration directive is preceded by a comment
# explaining its purpose, allowed values, and the schema field that controls it.
# ============================================================================

###############################################################################
# Initial mouse configuration                                                 
# Each section item is applied in-order. So there might be multiple           
# items of one type (for example "led").                                      
###############################################################################


# -------------------------------------------------------------------------
# Razer DeathAdder Chroma mouse configuration
# Matches devices named "DeathAdder Chroma"
# -------------------------------------------------------------------------
[Mouse:DeathAdder Chroma:*:*]
	# Global default for whether mouse configs are disabled
	# Schema field: default_mouse_disabled (default: false)
	disabled={{ default_mouse_disabled | default('false') }}

	# Configure first profile
	# Resolution: 800, 1800, 3500, 5600, 10000
	# Schema field: default_mouse_resolution_1 (default: 1800)
	res=1:{{ default_mouse_resolution_1 | default(1800) }}

	# Frequency: 125, 500, 1000 (Hz)
	# Schema field: default_mouse_polling_rate_1 (default: 1000)
	freq=1:{{ default_mouse_polling_rate_1 | default(1000) }}

	# Initial profile selection
	profile=1

	# Configure LEDs
	led=1:GlowingLogo:on
	led=1:Scrollwheel:on
	mode=1:Scrollwheel:static

	# Default hex color for scrollwheel LED on DeathAdder Chroma
	# Schema field: default_mouse_led_scrollwheel_color (default: 0000FF)
	color=1:Scrollwheel:{{ default_mouse_led_scrollwheel_color | default('0000FF') }}

# -------------------------------------------------------------------------
# Razer DeathAdder (standard) mouse configuration
# Matches devices named "DeathAdder" (excluding Chroma variants if matched above)
# -------------------------------------------------------------------------
[Mouse:DeathAdder*:*:*]
	# Global default for whether mouse configs are disabled
	# Schema field: default_mouse_disabled (default: false)
	disabled={{ default_mouse_disabled | default('false') }}

	# Configure first profile
	# Resolution: 450, 900, 1800, (3500)
	# Schema field: default_mouse_resolution_1_da (default: 900)
	res=1:{{ default_mouse_resolution_1_da | default(900) }}

	# Frequency: 125, 500, 1000 (Hz)
	# Schema field: default_mouse_polling_rate_1 (default: 1000)
	freq=1:{{ default_mouse_polling_rate_1 | default(1000) }}

	# Initial profile selection
	profile=1

	# Configure LEDs
	led=1:GlowingLogo:on
	led=1:Scrollwheel:on

