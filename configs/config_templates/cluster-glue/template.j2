# =============================================================================
# Cluster-GLUE Logging Daemon Configuration
# =============================================================================
# This template configures the logging daemon (logd) part of the cluster-glue
# package. It controls where logs are written, how they are formatted, and
# IPC queue settings between parent and child processes.
# =============================================================================

# --- Logging Destination: Debug File ---
# Description: Path to the debug log file.
# Default: '' (Empty string; if empty, uses fallback or disabled depending on build,
#          but standard fallback is /var/log/ha-debug)
# Note: If this variable is empty/undefined, the directive is commented out.
{% if debugfile is defined and debugfile is string and debugfile | length > 0 %}
{% if debugfile is defined and debugfile is not none and (debugfile is number or debugfile is boolean or debugfile | length > 0) %}debugfile {{ debugfile }}{% else %}#debugfile /var/log/ha-debug{% endif %}
{% else %}
#debugfile /var/log/ha-debug
{% endif %}

# --- Logging Destination: Main Log File ---
# Description: Path to the main log file.
# Default: '' (Empty string; standard fallback is /var/log/ha-log)
# Note: If this variable is empty/undefined, the directive is commented out.
{% if logfile is defined and logfile is string and logfile | length > 0 %}
{% if logfile is defined and logfile is not none and (logfile is number or logfile is boolean or logfile | length > 0) %}logfile	{{ logfile }}{% else %}#logfile	/var/log/ha-log{% endif %}
{% else %}
#logfile	/var/log/ha-log
{% endif %}

# --- Logging Destination: File Permissions ---
# Description: Octal file permissions for log files.
# Default: '' (Empty string; standard fallback is 0640)
# Note: If this variable is empty/undefined, the directive is commented out.
{% if logmode is defined and logmode is string and logmode | length > 0 %}
{% if logmode is defined and logmode is not none and (logmode is number or logmode is boolean or logmode | length > 0) %}logmode	{{ logmode }}{% else %}#logmode	0640{% endif %}
{% else %}
#logmode	0640
{% endif %}

# --- Logging Destination: Syslog Facility ---
# Description: Syslog facility to use (e.g., daemon, local0).
#              Set to 'none' to disable syslog logging entirely.
# Default: 'daemon'
# Note: If this variable is empty/undefined, the directive is commented out (defaulting to daemon in code).
{% if logfacility is defined and logfacility is string and logfacility | length > 0 %}
{% if logfacility is defined and logfacility is not none and (logfacility is number or logfacility is boolean or logfacility | length > 0) %}logfacility	{{ logfacility }}{% else %}#logfacility	daemon{% endif %}
{% else %}
#logfacility	daemon
{% endif %}

# --- Logging Format: Entity Name ---
# Description: Entity name shown at start of messages for log files.
# Default: '' (Empty string; standard fallback is "logd")
# Note: If this variable is empty/undefined, the directive is commented out.
{% if entity is defined and entity is string and entity | length > 0 %}
{% if entity is defined and entity is not none and (entity is number or entity is boolean or entity | length > 0) %}entity {{ entity }}{% else %}#entity logd{% endif %}
{% else %}
#entity logd
{% endif %}

# --- Logging Format: Syslog Prefix ---
# Description: Prefix added to syslog messages for filtering.
#              Empty or undefined means disabled (uses default internal naming).
#              Useful for safe blacklisting or easier filtering alongside logfacility.
# Default: '' (Empty string; standard fallback is "linux-ha" or similar, here commented as disabled)
# Note: If this variable is empty/undefined, the directive is commented out.
{% if syslogprefix is defined and syslogprefix is string and syslogprefix | length > 0 %}
{% if syslogprefix is defined and syslogprefix is not none and (syslogprefix is number or syslogprefix is boolean or syslogprefix | length > 0) %}syslogprefix {{ syslogprefix }}{% else %}#syslogprefix linux-ha{% endif %}
{% else %}
#syslogprefix linux-ha
{% endif %}

# --- IPC Registration: Apphbd ---
# Description: Whether to register with apphbd (heartbeat daemon).
#              Accepts 'yes' or 'no'.
# Default: '' (Empty string; standard fallback is 'no')
# Note: If this variable is empty/undefined, the directive is commented out.
{% if useapphbd is defined and useapphbd is string and useapphbd | length > 0 %}
{% if useapphbd is defined and useapphbd is not none and (useapphbd is number or useapphbd is boolean or useapphbd | length > 0) %}useapphbd {{ useapphbd }}{% else %}#useapphbd no{% endif %}
{% else %}
#useapphbd no
{% endif %}

# =============================================================================
# IPC Queue Configuration (Parent <-> Child Process)
# =============================================================================
# The logging daemon runs two processes:
# 1. Parent: Reads messages from all client channels.
# 2. Child: Reads from parent via IPC and writes to syslog/disk.
#
# These settings control the kernel-level queue lengths for that IPC channel.

# --- IPC Queue: Send Length (Parent -> Child) ---
# Description: Send queue length from parent to child process.
# Default: '' (Empty string; standard fallback is 256)
# Note: If this variable is empty/undefined, the directive is commented out.
{% if sendqlen is defined and sendqlen is string and sendqlen | length > 0 %}
{% if sendqlen is defined and sendqlen is not none and (sendqlen is number or sendqlen is boolean or sendqlen | length > 0) %}sendqlen {{ sendqlen }}{% else %}#sendqlen 256 {% endif %}
{% else %}
#sendqlen 256
{% endif %}

# --- IPC Queue: Recv Length (Child Process) ---
# Description: Receive queue length in child process.
# Default: '' (Empty string; standard fallback is 256)
# Note: If this variable is empty/undefined, the directive is commented out.
{% if recvqlen is defined and recvqlen is string and recvqlen | length > 0 %}
{% if recvqlen is defined and recvqlen is not none and (recvqlen is number or recvqlen is boolean or recvqlen | length > 0) %}recvqlen {{ recvqlen }}{% else %}#recvqlen 256{% endif %}
{% else %}
#recvqlen 256
{% endif %}