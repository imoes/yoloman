# Configuration file for cluster-glue logging daemon (ha-logd)
# This template is self-documenting: every variable has its schema default
# and the purpose is described above each directive.

# Path to the debug log file.
# Schema default: '/var/log/ha-debug'
debugfile {{ debugfile | default('/var/log/ha-debug') }}

# Path to the main log file where other messages are written.
# Schema default: '/var/log/ha-log'
logfile {{ logfile | default('/var/log/ha-log') }}

# Octal file permissions used when creating the log files.
# Schema default: '0644'
logmode {{ logmode | default('0644') }}

# Syslog facility to use for syslog() or logger calls.
# Set to 'none' to disable syslog logging entirely.
# Schema default: 'daemon'
logfacility {{ logfacility | default('daemon') }}

# Entity name displayed at the beginning of messages generated by the logging
# daemon itself (internal messages).
# Schema default: 'logd'
entity {{ entity | default('logd') }}

# Prefix added to every message passed to syslog (not log files).
# Intended for easier filtering or safe blacklisting. You can filter on
# logfacility and this prefix together.
# Schema default: 'linux-ha'
syslogprefix {{ syslogprefix | default('linux-ha') }}

# Whether to register with the heartbeat daemon (apphbd).
# 'yes' or 'no'.
# Schema default: 'no'
useapphbd {{ useapphbd | default('no') }}

# Cluster-glue uses two processes for logging:
#   1. Parent process: reads messages from all client channels and writes
#      them to the child process via IPC.
#   2. Child process: reads messages from the parent and writes them to
#      syslog/disk.

# Send queue length from the parent process to the child process (IPC buffer).
# Schema default: '256'
sendqlen {{ sendqlen | default('256') }}

# Receive queue length in the child process (IPC buffer).
# Schema default: '256'
recvqlen {{ recvqlen | default('256') }}