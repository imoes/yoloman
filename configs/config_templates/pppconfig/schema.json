{
  "PATH": {
    "type": "string",
    "default": "/sbin:/bin:/usr/sbin:/usr/bin",
    "description": "The PATH environment variable used by the script."
  },
  "pppconfig_path": {
    "type": "string",
    "default": "/usr/sbin/pppconfig",
    "description": "Path to the pppconfig executable."
  },
  "ppp_run_dir": {
    "type": "string",
    "default": "/var/run/pppconfig",
    "description": "Directory for pppconfig runtime files."
  },
  "dns_down_script_path": {
    "type": "string",
    "default": "/etc/ppp/ip-down.d/0dns-down",
    "description": "Path to the dns-down script executed during cleanup."
  }
}
