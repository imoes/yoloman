{
  "address_family": "any",
  "add_keys_to_agent": "yes",
  "batch_mode": false,
  "canonicalize_hostname": "no",
  "ca_signature_algorithms": "ssh-ed25519,ecdsa-sha2-nistp256,rsa-sha2-512,rsa-sha2-256",
  "ciphers": "chacha20-poly1305@openssh.com,aes256-gcm@openssh.com",
  "check_host_ip": true,
  "control_master": "auto",
  "control_path": "%h-%r",
  "control_persist": "10m",
  "fingerprint_hash": "sha256",
  "forward_agent": false,
  "forward_x11": false,
  "gssapi_authentication": false,
  "hash_known_hosts": true,
  "host_key_algorithms": "ssh-ed25519,rsa-sha2-512,rsa-sha2-256",
  "hostname_default": "",
  "identity_files": [
    "~/.ssh/id_ed25519"
  ],
  "kbd_interactive_authentication": true,
  "kex_algorithms": "curve25519-sha256,ecdh-sha2-nistp256,diffie-hellman-group14-sha256",
  "log_level": "INFO",
  "macs": "umac-128-etm@openssh.com,hmac-sha2-256-etm@openssh.com",
  "number_of_password_prompts": 3,
  "password_authentication": false,
  "port": 22,
  "preferred_authentications": "publickey,keyboard-interactive,password",
  "pubkey_authentication": true,
  "server_alive_count_max": 3,
  "server_alive_interval": 60,
  "strict_host_key_checking": "yes",
  "syslog_facility": "USER",
  "tcp_keepalive": true,
  "user": "",
  "host_blocks": [
    {
      "name": "production-*",
      "hostname": "prod.example.com",
      "user": "deploy",
      "port": 22,
      "identity_file": "~/.ssh/id_deploy_ed25519",
      "proxy_jump": "bastion.example.com",
      "strict_host_key_checking": "yes",
      "forward_agent": false,
      "control_master": "auto",
      "control_path": "/tmp/ssh-%r@%h:%p",
      "server_alive_interval": 30,
      "server_alive_count_max": 5
    },
    {
      "name": "development-*",
      "hostname": "dev.example.com",
      "user": "dev",
      "port": 2222,
      "identity_file": "~/.ssh/id_dev_ed25519",
      "forward_agent": true,
      "forward_x11": true,
      "batch_mode": false
    }
  ]
}
