# ==============================================================================
# spc (SuperCat) Configuration Template
# ==============================================================================
# This file configures the default color scheme for the 'spc' terminal application.
# It uses a simple text-based format where the second column defines the color
# expression to be applied to the third column's regex pattern.
#
# Schema Field: spc_default_color
# Default: 'blu'
# Description: The color name or expression to use as the default for spc terminals.
# ==============================================================================

#  HTML COLOR NAME   COL A N T STRING or REGULAR EXPRESSION
#################### ### # # # ################################################################
Black                {{ spc_default_color | default('blu') }}    (.*)