{
  "server_root": "/var/www/html",
  "server_name": "example.com",
  "ssl_enabled": true,
  "cert_directory": "/etc/ssl/certs",
  "listen_port": 443,
  "included_paths": [
    "common.conf"
  ],
  "servers": [
    {
      "name": "example.com",
      "aliases": [
        "www.example.com"
      ]
    },
    {
      "name": "example.org",
      "aliases": [
        "www.example.org",
        "mail.example.org"
      ],
      "root": "/var/www/example.org"
    }
  ]
}
