{
  "backend_type": "mdb",
  "schema_dir": "/etc/ldap/schema",
  "additional_schemas": [
    "core",
    "cosine",
    "inetorgperson",
    "nis"
  ],
  "enable_default_acl": false,
  "acls": [
    "access to attrs=userPassword by dn=\"cn=admin,dc=example,dc=com\" write by self write by * auth",
    "access to * by dn=\"cn=admin,dc=example,dc=com\" write by users read by * none"
  ],
  "pidfile_path": "/var/run/slapd/slapd.pid",
  "argsfile_path": "/var/run/slapd/slapd.args",
  "loglevel": 256,
  "tls_enabled": true,
  "tls_cipher_suite": "HIGH:MEDIUM:!aNULL:!MD5",
  "tls_cert_file": "/etc/ldap/ssl/slapd.crt",
  "tls_cert_key_file": "/etc/ldap/ssl/slapd.key",
  "tls_ca_cert_file": "/etc/ldap/ssl/ca.crt",
  "tls_verify_client": "demand",
  "security_require_tls": true,
  "security_require_ssf": 1,
  "security_require_authc": true,
  "listeners": [
    {
      "scheme": "ldap",
      "host": "127.0.0.1",
      "port": 389
    },
    {
      "scheme": "ldaps",
      "host": null,
      "port": 636
    }
  ],
  "databases": [
    {
      "type": "mdb",
      "suffix": "dc=example,dc=com",
      "rootdn": "cn=admin,dc=example,dc=com",
      "rootpw": "{SSHA}AbCdEfGhIjKlMnOpQrStUvWxYz==",
      "directory": "/var/lib/ldap/example",
      "index": [
        {
          "attr": "objectClass",
          "options": [
            "eq"
          ]
        },
        {
          "attr": "uid",
          "options": [
            "eq",
            "pres"
          ]
        },
        {
          "attr": "mail",
          "options": [
            "eq",
            "sub"
          ]
        }
      ],
      "overlay": [
        {
          "name": "ppolicy",
          "config": {
            "ppolicy_default": "cn=default,ou=policies,dc=example,dc=com",
            "ppolicy_hash_cleartext": "yes"
          }
        }
      ]
    }
  ],
  "rootdn": "",
  "rootpw_hash": "",
  "monitoring_enabled": false
}
