        "203.0.113.45"
      ],
      "prefer_ixfr": true
    },
    {
      "name": "example.net",
      "source": "192.0.2.20:53",
      "allowed_peers": [],
      "prefer_ixfr": false
    }
  ],
  "log_level": "INFO",
  "log_file": "/var/log/pdns-ixfrdist/ixfrdist.log",
  "zone_cache_size": 128,
  "check_interval": 180,
  "stats_enabled": true,
  "stats_bind_address": "127.0.0.1",
  "stats_bind_port": 8084
