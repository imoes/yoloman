# Listen address and port for the IXFR Distributor API and control interface
bind-address: {{ api_bind_address }}
bind-port: {{ api_bind_port }}

# Path to the directory where zone data is stored
zone-dir: {{ zone_dir }}

# Path to the directory where zone journal files are stored
journal-dir: {{ journal_dir }}

# Maximum number of concurrent AXFR/IXFR transfers from a single peer
max-concurrent-transfers: {{ max_concurrent_transfers }}

# Timeout (in seconds) for AXFR/IXFR transfers
transfer-timeout: {{ transfer_timeout }}

# Enable/disable DNSSEC validation of transferred zones
validate-dnssec: {{ validate_dnssec }}

# List of zones to distribute (each with its source and optional access control)
zones:
{% for zone in zones %}
  - name: {{ zone.name }}
    # Source server to AXFR/IXFR from
    source: {{ zone.source }}
    # Optional: list of allowed peer IPs (if omitted, all peers allowed)
{% if zone.allowed_peers is defined and zone.allowed_peers | length > 0 %}    allowed-peers:
{% for peer in zone.allowed_peers %}      - {{ peer }}
{% endfor %}    {% else %}    # (no restrictions — all peers allowed)
{% endif %}    # Optional: enable IXFR fallback (if source supports it); if false, force AXFR
    prefer-ixfr: {{ zone.prefer_ixfr | default(true) }}
{% endfor %}

# Logging configuration
log-level: {{ log_level }}
# Path to log file (or omit for stdout)
{% if log_file is defined and log_file %}log-file: {{ log_file }}
{% endif %}

# Optional: set maximum size of zone data cached in memory (in MiB)
zone-cache-size: {{ zone_cache_size }}

# Optional: interval (in seconds) for checking zone changes via IXFR
check-interval: {{ check_interval }}

# Enable/disable statistics endpoint
stats-enabled: {{ stats_enabled }}
# Stats bind address/port (if different from API)
{% if stats_enabled and (stats_bind_address is defined) %}stats-bind-address: {{ stats_bind_address }}
stats-bind-port: {{ stats_bind_port }}
{% endif %}
