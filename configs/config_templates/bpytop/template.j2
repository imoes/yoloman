# bpytop configuration file
#
# This template generates the ~/.config/bpytop/conf file.
# It is self-documenting: every directive is preceded by a comment
# derived from the Ansible schema description.
# Variables default to their schema defaults if not provided by Ansible.

# Theme name for bpytop UI
{% if theme|default('default') != 'default' %}
THEME = {{ theme|default('default')|tojson }}
{% endif %}

# Update interval in milliseconds
{% if update_ms|default(1000) != 1000 %}
UPDATE_MS = {{ update_ms|default(1000) }}
{% endif %}

# Log level: ERROR, WARNING, INFO, DEBUG
{% if log_level|default('INFO') != 'INFO' %}
LOG_LEVEL = {{ log_level|default('INFO')|tojson }}
{% endif %}

# Path to log file. Empty string disables logging to file.
{% if log_file|default('') != '' %}
LOG_FILE = {{ log_file|default('')|tojson }}
{% endif %}

# Color theme: default, monochrome, solarized, gruvbox, onedark, dracula, nord
{% if color_theme|default('default') != 'default' %}
COLOR_THEME = {{ color_theme|default('default')|tojson }}
{% endif %}

# Process sorting method: pid, name, user, status, cpu_percent, mem_percent, mem, time, ctime
{% if process_sorting|default('cpu_percent') != 'cpu_percent' %}
PROCESS_SORTING = {{ process_sorting|default('cpu_percent')|tojson }}
{% endif %}

# Reverse process sorting order
{% if process_sort_reverse|default(false) %}
PROCESS_SORT_REVERSE = {{ process_sort_reverse|default(false)|bool|lower }}
{% endif %}

# Show threads in process list
{% if process_show_threads|default(false) %}
PROCESS_SHOW_THREADS = {{ process_show_threads|default(false)|bool|lower }}
{% endif %}

# Show process owner column
{% if process_show_owners|default(true) %}
PROCESS_SHOW_OWNERS = {{ process_show_owners|default(true)|bool|lower }}
{% endif %}

# Show processes as a tree
{% if process_tree|default(false) %}
PROCESS_TREE = {{ process_tree|default(false)|bool|lower }}
{% endif %}

# Auto-expand tree branches
{% if process_tree_auto_expand|default(false) %}
PROCESS_TREE_AUTO_EXPAND = {{ process_tree_auto_expand|default(false)|bool|lower }}
{% endif %}

# Tree indentation in spaces
{% if process_tree_indent|default(2) != 2 %}
PROCESS_TREE_INDENT = {{ process_tree_indent|default(2) }}
{% endif %}

# Maximum tree depth (0 = unlimited)
{% if process_tree_depth|default(0) != 0 %}
PROCESS_TREE_DEPTH = {{ process_tree_depth|default(0) }}
{% endif %}

# Initial process filter
{% if process_filter|default('') != '' %}
PROCESS_FILTER = {{ process_filter|default('')|tojson }}
{% endif %}

# Process search case sensitive
{% if process_search_case_sensitive|default(true) %}
PROCESS_SEARCH_CASE_SENSITIVE = {{ process_search_case_sensitive|default(true)|bool|lower }}
{% endif %}

# Smart case search (case-insensitive if only lowercase input)
{% if process_search_smart_case|default(false) %}
PROCESS_SEARCH_SMART_CASE = {{ process_search_smart_case|default(false)|bool|lower }}
{% endif %}

# Show number of matching processes in search
{% if process_search_show_count|default(true) %}
PROCESS_SEARCH_SHOW_COUNT = {{ process_search_show_count|default(true)|bool|lower }}
{% endif %}

# Default signal for kill process (SIGTERM=15, SIGKILL=9, SIGINT=2)
{% if process_kill_signal|default(15) != 15 %}
PROCESS_KILL_SIGNAL = {{ process_kill_signal|default(15) }}
{% endif %}

# Refresh process list on key press
{% if process_refresh_on_key|default(true) %}
PROCESS_REFRESH_ON_KEY = {{ process_refresh_on_key|default(true)|bool|lower }}
{% endif %}

# Refresh network on key press
{% if network_refresh_on_key|default(true) %}
NETWORK_REFRESH_ON_KEY = {{ network_refresh_on_key|default(true)|bool|lower }}
{% endif %}

# Monitor disks
{% if disk_monitor|default(true) %}
DISK_MONITOR = {{ disk_monitor|default(true)|bool|lower }}
{% endif %}

# Show mountpoints in disk view
{% if disk_show_mountpoints|default(false) %}
DISK_SHOW_MOUNTPOINTS = {{ disk_show_mountpoints|default(false)|bool|lower }}
{% endif %}

# Show partitions in disk view
{% if disk_show_partitions|default(true) %}
DISK_SHOW_PARTITIONS = {{ disk_show_partitions|default(true)|bool|lower }}
{% endif %}

# Disk units: B, KB, MB, GB, TB, KiB, MiB, GiB, TiB
{% if disk_units|default('B') != 'B' %}
DISK_UNITS = {{ disk_units|default('B')|tojson }}
{% endif %}

# Monitor network
{% if network_monitor|default(true) %}
NETWORK_MONITOR = {{ network_monitor|default(true)|bool|lower }}
{% endif %}

# Auto-scale network graphs
{% if network_auto_scale|default(true) %}
NETWORK_AUTO_SCALE = {{ network_auto_scale|default(true)|bool|lower }}
{% endif %}

# Network units: B, KB, MB, GB, TB, KiB, MiB, GiB, TiB
{% if network_units|default('B') != 'B' %}
NETWORK_UNITS = {{ network_units|default('B')|tojson }}
{% endif %}

# Show network summary line
{% if network_show_summary|default(false) %}
NETWORK_SHOW_SUMMARY = {{ network_show_summary|default(false)|bool|lower }}
{% endif %}

# Enable mouse support
{% if mouse_support|default(true) %}
MOUSE_SUPPORT = {{ mouse_support|default(true)|bool|lower }}
{% endif %}

# Mouse scroll speed in lines per wheel click
{% if mouse_scroll_speed|default(3) != 3 %}
MOUSE_SCROLL_SPEED = {{ mouse_scroll_speed|default(3) }}
{% endif %}

# Show title bar at top
{% if title_bar|default(true) %}
TITLE_BAR = {{ title_bar|default(true)|bool|lower }}
{% endif %}

# Show time bar at top
{% if time_bar|default(true) %}
TIME_BAR = {{ time_bar|default(true)|bool|lower }}
{% endif %}

# Clock format (strftime format)
{% if clock_format|default('%H:%M:%S') != '%H:%M:%S' %}
CLOCK_FORMAT = {{ clock_format|default('%H:%M:%S')|tojson }}
{% endif %}

# Draw borders around panels
{% if draw_borders|default(true) %}
DRAW_BORDERS = {{ draw_borders|default(true)|bool|lower }}
{% endif %}

# Show battery status
{% if show_battery|default(true) %}
SHOW_BATTERY = {{ show_battery|default(true)|bool|lower }}
{% endif %}

# Battery full character
{% if battery_full_char|default('█') != '█' %}
BATTERY_FULL_CHAR = {{ battery_full_char|default('█')|tojson }}
{% endif %}

# Battery high character
{% if battery_high_char|default('▓') != '▓' %}
BATTERY_HIGH_CHAR = {{ battery_high_char|default('▓')|tojson }}
{% endif %}

# Battery medium character
{% if battery_med_char|default('▒') != '▒' %}
BATTERY_MED_CHAR = {{ battery_med_char|default('▒')|tojson }}
{% endif %}

# Battery low character
{% if battery_low_char|default('░') != '░' %}
BATTERY_LOW_CHAR = {{ battery_low_char|default('░')|tojson }}
{% endif %}

# Battery unplugged character
{% if battery_unplug_char|default('X') != 'X' %}
BATTERY_UNPLUG_CHAR = {{ battery_unplug_char|default('X')|tojson }}
{% endif %}

# Battery warning level (percentage)
{% if battery_warn_level|default(10) != 10 %}
BATTERY_WARN_LEVEL = {{ battery_warn_level|default(10) }}
{% endif %}

# Battery critical level (percentage)
{% if battery_critical_level|default(5) != 5 %}
BATTERY_CRITICAL_LEVEL = {{ battery_critical_level|default(5) }}
{% endif %}

# Update display on scroll
{% if update_on_scroll|default(true) %}
UPDATE_ON_SCROLL = {{ update_on_scroll|default(true)|bool|lower }}
{% endif %}

# Initial sort field for processes (deprecated alias for PROCESS_SORTING)
{% if sort_processes_by|default('cpu_percent') != 'cpu_percent' %}
SORT_PROCESSES_BY = {{ sort_processes_by|default('cpu_percent')|tojson }}
{% endif %}

# Log errors to syslog (deprecated alias for LOG_LEVEL=ERROR)
{% if log_errors|default(false) %}
LOG_ERRORS = {{ log_errors|default(false)|bool|lower }}
{% endif %}

# Custom process monitoring definitions
# Each item in the list must have at least 'name' and 'grep' or 'pid'.
# Optional keys: 'color' (hex string).
{% if custom_processes|default([])|length > 0 %}
# Custom process monitoring
{% for proc in custom_processes %}
CUSTOM_PROCESS_{{ loop.index }} = {{ proc.name|string|tojson }}
{% if proc.grep is defined %}CUSTOM_PROCESS_{{ loop.index }}_GREP = {{ proc.grep|string|tojson }}
{% endif %}{% if proc.pid is defined %}CUSTOM_PROCESS_{{ loop.index }}_PID = {{ proc.pid }}
{% endif %}{% if proc.color is defined %}CUSTOM_PROCESS_{{ loop.index }}_COLOR = {{ proc.color|default('')|string|tojson }}
{% endif %}{% endfor %}
{% endif %}