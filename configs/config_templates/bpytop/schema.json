{
  "theme": {
    "type": "string",
    "default": "default",
    "description": "Theme name for bpytop UI"
  },
  "update_ms": {
    "type": "number",
    "default": 1000,
    "description": "Update interval in milliseconds"
  },
  "log_level": {
    "type": "string",
    "default": "INFO",
    "description": "Log level: ERROR, WARNING, INFO, DEBUG"
  },
  "log_file": {
    "type": "string",
    "default": "",
    "description": "Path to log file. Empty string disables logging to file."
  },
  "color_theme": {
    "type": "string",
    "default": "default",
    "description": "Color theme: default, monochrome, solarized, gruvbox, onedark, dracula, nord"
  },
  "process_sorting": {
    "type": "string",
    "default": "cpu_percent",
    "description": "Process sorting method: pid, name, user, status, cpu_percent, mem_percent, mem, time, ctime"
  },
  "process_sort_reverse": {
    "type": "bool",
    "default": false,
    "description": "Reverse process sorting order"
  },
  "process_show_threads": {
    "type": "bool",
    "default": false,
    "description": "Show threads in process list"
  },
  "process_show_owners": {
    "type": "bool",
    "default": true,
    "description": "Show process owner column"
  },
  "process_tree": {
    "type": "bool",
    "default": false,
    "description": "Show processes as a tree"
  },
  "process_tree_auto_expand": {
    "type": "bool",
    "default": false,
    "description": "Auto-expand tree branches"
  },
  "process_tree_indent": {
    "type": "number",
    "default": 2,
    "description": "Tree indentation in spaces"
  },
  "process_tree_depth": {
    "type": "number",
    "default": 0,
    "description": "Maximum tree depth (0 = unlimited)"
  },
  "process_filter": {
    "type": "string",
    "default": "",
    "description": "Initial process filter"
  },
  "process_search_case_sensitive": {
    "type": "bool",
    "default": true,
    "description": "Process search case sensitive"
  },
  "process_search_smart_case": {
    "type": "bool",
    "default": false,
    "description": "Smart case search (case-insensitive if only lowercase input)"
  },
  "process_search_show_count": {
    "type": "bool",
    "default": true,
    "description": "Show number of matching processes in search"
  },
  "process_kill_signal": {
    "type": "number",
    "default": 15,
    "description": "Default signal for kill process (SIGTERM=15, SIGKILL=9, SIGINT=2)"
  },
  "process_refresh_on_key": {
    "type": "bool",
    "default": true,
    "description": "Refresh process list on key press"
  },
  "process_refresh_on_scroll": {
    "type": "bool",
    "default": true,
    "description": "Refresh process list on scroll"
  },
  "disk_monitor": {
    "type": "bool",
    "default": true,
    "description": "Monitor disks"
  },
  "disk_show_mountpoints": {
    "type": "bool",
    "default": false,
    "description": "Show mountpoints in disk view"
  },
  "disk_show_partitions": {
    "type": "bool",
    "default": true,
    "description": "Show partitions in disk view"
  },
  "disk_units": {
    "type": "string",
    "default": "B",
    "description": "Disk units: B, KB, MB, GB, TB, KiB, MiB, GiB, TiB"
  },
  "network_monitor": {
    "type": "bool",
    "default": true,
    "description": "Monitor network"
  },
  "network_auto_scale": {
    "type": "bool",
    "default": true,
    "description": "Auto-scale network graphs"
  },
  "network_units": {
    "type": "string",
    "default": "B",
    "description": "Network units: B, KB, MB, GB, TB, KiB, MiB, GiB, TiB"
  },
  "network_show_summary": {
    "type": "bool",
    "default": false,
    "description": "Show network summary line"
  },
  "network_refresh_on_key": {
    "type": "bool",
    "default": true,
    "description": "Refresh network on key press"
  },
  "mouse_support": {
    "type": "bool",
    "default": true,
    "description": "Enable mouse support"
  },
  "mouse_scroll_speed": {
    "type": "number",
    "default": 3,
    "description": "Mouse scroll speed in lines per wheel click"
  },
  "title_bar": {
    "type": "bool",
    "default": true,
    "description": "Show title bar at top"
  },
  "time_bar": {
    "type": "bool",
    "default": true,
    "description": "Show time bar at top"
  },
  "clock_format": {
    "type": "string",
    "default": "%H:%M:%S",
    "description": "Clock format (strftime format)"
  },
  "draw_borders": {
    "type": "bool",
    "default": true,
    "description": "Draw borders around panels"
  },
  "show_battery": {
    "type": "bool",
    "default": true,
    "description": "Show battery status"
  },
  "battery_full_char": {
    "type": "string",
    "default": "\u2588",
    "description": "Battery full character"
  },
  "battery_high_char": {
    "type": "string",
    "default": "\u2593",
    "description": "Battery high character"
  },
  "battery_med_char": {
    "type": "string",
    "default": "\u2592",
    "description": "Battery medium character"
  },
  "battery_low_char": {
    "type": "string",
    "default": "\u2591",
    "description": "Battery low character"
  },
  "battery_unplug_char": {
    "type": "string",
    "default": "X",
    "description": "Battery unplugged character"
  },
  "battery_warn_level": {
    "type": "number",
    "default": 10,
    "description": "Battery warning level (percentage)"
  },
  "battery_critical_level": {
    "type": "number",
    "default": 5,
    "description": "Battery critical level (percentage)"
  },
  "update_on_scroll": {
    "type": "bool",
    "default": true,
    "description": "Update display on scroll"
  },
  "sort_processes_by": {
    "type": "string",
    "default": "cpu_percent",
    "description": "Initial sort field for processes (deprecated alias for PROCESS_SORTING)"
  },
  "log_errors": {
    "type": "bool",
    "default": false,
    "description": "Log errors to syslog (deprecated alias for LOG_LEVEL=ERROR)"
  },
  "custom_processes": {
    "type": "list",
    "default": [],
    "description": "List of custom process monitoring definitions. Each dict must have at least 'name' and 'grep' or 'pid'. Optional keys: 'color' (hex string)."
  }
}
