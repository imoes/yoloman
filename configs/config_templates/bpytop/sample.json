{
  "theme": "default",
  "update_ms": 1500,
  "log_level": "WARNING",
  "log_file": "/var/log/bpytop.log",
  "color_theme": "nord",
  "process_sorting": "mem_percent",
  "process_sort_reverse": true,
  "process_show_threads": true,
  "process_show_owners": false,
  "process_tree": true,
  "process_tree_auto_expand": true,
  "process_tree_indent": 4,
  "process_tree_depth": 3,
  "process_filter": "python",
  "process_search_case_sensitive": false,
  "process_search_smart_case": true,
  "process_search_show_count": true,
  "process_kill_signal": 9,
  "disk_units": "GiB",
  "network_units": "MiB",
  "mouse_support": true,
  "mouse_scroll_speed": 5,
  "clock_format": "%Y-%m-%d %H:%M:%S",
  "show_battery": true,
  "battery_warn_level": 15,
  "battery_critical_level": 3,
  "custom_processes": [
    {
      "name": "Systemd",
      "grep": "systemd",
      "color": "#d3869b"
    },
    {
      "name": "Nginx",
      "pid": 1234
    }
  ]
}
