/* Configuration file for UnrealIRCd 6
 *
 * This template is self-documenting. Every variable is sourced from the Ansible
 * schema with safe defaults.
 *
 * Syntax reminder: all lines, except { and } end with an ;
 */

/* This is a comment, all text here is ignored (comment type #1) */
// This is also a comment, this line is ignored (comment type #2)
# This is also a comment, again this line is ignored (comment type #3)

/* UnrealIRCd makes heavy use of modules. Modules allow you to completely
 * customize the featureset you wish to enable in UnrealIRCd.
 * See: https://www.unrealircd.org/docs/Modules
 *
 * By using the include below we instruct the IRCd to read the file
 * 'modules.default.conf' which will load more than 150 modules
 * shipped with UnrealIRCd.
 */
include "modules.default.conf";

/* Now let's include some other files as well:
 * - help/help.conf for our on-IRC /HELPOP system
 * - badwords.conf for channel and user mode +G
 * - operclass.default.conf contains some good operclasses
 * - snomasks.default.conf for system notice masks
 */
include "help/help.conf";
include "badwords.conf";
//include "spamfilter.conf";
include "operclass.default.conf";
include "snomasks.default.conf";

/* Load the default cloaking module (2021 onwards): */
loadmodule "cloak_sha256";
/* Or load the old module from UnrealIRCd 3.2/4/5 instead: */
//loadmodule "cloak_md5";

/* This is the me { } block which basically says who we are.
 * It defines our server name, some information line and an unique "sid".
 */
me {
	/* network_name: The name of the IRC network. */
	name "{{ network_name | default('ExampleNET') }}";
	/* network_info: The information line for the server. */
	info "{{ network_info | default('ExampleNET Server') }}";
	/* server_sid: The unique Server ID (SID) for this server instance. */
	sid "{{ server_sid | default('001') }}";
}

/* The admin { } block defines what users will see if they type /ADMIN. */
admin {
	/* admin_name: Full name of the IRC network administrator. */
	"{{ admin_name | default('Bob Smith') }}";
	/* admin_user: Username of the IRC network administrator. */
	"{{ admin_user | default('bob') }}";
	/* admin_email: Email address of the IRC network administrator. */
	"{{ admin_email | default('email@example.org') }}";
}

/* Clients and servers are put in class { } blocks. */
/* Client class with good defaults */
class clients
{
	/* class_clients_pingfreq: Ping frequency in seconds for client class. */
	pingfreq {{ class_clients_pingfreq | default(90) }};
	/* class_clients_maxclients: Maximum number of clients allowed in the client class. */
	maxclients {{ class_clients_maxclients | default(1000) }};
	/* class_clients_sendq: Send queue size limit for client class. */
	sendq {{ class_clients_sendq | default('200k') }};
	/* class_clients_recvq: Receive queue size limit for client class. */
	recvq {{ class_clients_recvq | default('8000') }};
}

/* Special class for IRCOps with higher limits */
class opers
{
	/* class_operators_pingfreq: Ping frequency in seconds for operator class. */
	pingfreq {{ class_operators_pingfreq | default(90) }};
	/* class_operators_maxclients: Maximum number of operators allowed in the operator class. */
	maxclients {{ class_operators_maxclients | default(50) }};
	/* class_operators_sendq: Send queue size limit for operator class. */
	sendq {{ class_operators_sendq | default('1M') }};
	/* class_operators_recvq: Receive queue size limit for client class. */
	recvq {{ class_operators_recvq | default('8000') }};
}

/* Server class with good defaults */
class servers
{
	/* class_servers_pingfreq: Ping frequency in seconds for server class. */
	pingfreq {{ class_servers_pingfreq | default(60) }};
	/* class_servers_connfreq: Connection frequency in seconds for server class. */
	connfreq {{ class_servers_connfreq | default('15') }}; /* try to connect every 15 seconds */
	/* class_servers_maxclients: Maximum number of servers allowed. */
	maxclients {{ class_servers_maxclients | default('10') }}; /* max servers */
	/* class_servers_sendq: Send queue size limit for server class. */
	sendq {{ class_servers_sendq | default('20M') }};
}

/* Allow blocks define which clients may connect to this server. */
/* Allow everyone in, but only 3 connections per IP */
allow {
	mask *;
	class clients;
	/* allow_maxperip: Maximum connections allowed per IP address. */
	maxperip {{ allow_maxperip | default('3') }};
}

/* Oper blocks define your IRC Operators. */
/* Here is an example oper block for 'bobsmith' */
oper {{ oper_name | default('bobsmith') }} {
	class opers;
	mask *@*;

	/* oper_password: Hashed password for the IRC operator. */
	password "{{ oper_password | default('$argon2id..etc..') }}";

	/* oper_operclass: Operclass assigned to the operator. */
	operclass {{ oper_operclass | default('netadmin') }};
	/* oper_swhois: WHOIS information for the operator. */
	swhois "{{ oper_swhois | default('is a Network Administrator') }}";
	/* oper_vhost: Virtual hostname for the operator. */
	vhost {{ oper_vhost | default('netadmin.example.org') }};
}

/* Listen blocks define the ports where the server should listen on. */
/* Standard IRC port 6667 */
listen {
	ip *;
	/* port_irc: Port for standard IRC connections. */
	port {{ port_irc | default(6667) }};
}

/* Standard IRC SSL/TLS port 6697 */
listen {
	ip *;
	/* port_ssl: Port for SSL/TLS client connections. */
	port {{ port_ssl | default(6697) }};
	options { tls; }
}

/* Special SSL/TLS servers-only port for linking */
listen {
	ip *;
	/* port_link: Port for server linking. */
	port {{ port_link | default('6900') }};
	options { tls; serversonly; }
}

/* U-lines give other servers (even) more power/commands.
 * If you use services you MUST add them here.
 */
//ulines {
//	services.example.org;
//}

/* Here you can add a password for the IRCOp-only /DIE and /RESTART commands. */
drpass {
	/* drpass_restart: Password for the /RESTART command. */
	restart "{{ drpass_restart | default('restart') }}";
	/* drpass_die: Password for the /DIE command. */
	die "{{ drpass_die | default('die') }}";
}

/* The log block defines what should be logged and to what file. */
/* This is a good default, it logs everything except debug stuff and join/part/kick. */
log {
	source {
		all;
		!debug;
		!join.LOCAL_CLIENT_JOIN;
		!join.REMOTE_CLIENT_JOIN;
		!part.LOCAL_CLIENT_PART;
		!part.REMOTE_CLIENT_PART;
		!kick.LOCAL_CLIENT_KICK;
		!kick.REMOTE_CLIENT_KICK;
	}
	destination {
		file "ircd.log" { maxsize {{ log_ircd_maxsize | default('100M') }}; }
	}
}

/* In addition to regular logging, also add a JSON log file. */
log {
	source {
		all;
		!debug;
		!join.LOCAL_CLIENT_JOIN;
		!join.REMOTE_CLIENT_JOIN;
		!part.LOCAL_CLIENT_PART;
		!part.REMOTE_CLIENT_PART;
		!kick.LOCAL_CLIENT_KICK;
		!kick.REMOTE_CLIENT_KICK;
	}
	destination {
		file "ircd.json.log" { maxsize {{ log_json_maxsize | default('250M') }}; type json; }
	}
}

/* With "aliases" you can create an alias like /SOMETHING to send a message to
 * some user or bot.
 */
include "aliases/anope.conf";

