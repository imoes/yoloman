# ==============================================================================
# SiSU PostgreSQL Configuration
# Generated by sisu-postgresql template
# This file configures the SiSU application's connection to a PostgreSQL database
# and specifies local indexing parameters.
# ==============================================================================

# --------------------------------------------------------------------------
# Field: psql_bin
# Description: Path to the PostgreSQL client binary used by SiSU to interact
#              with the database.
# Default: /usr/bin/psql
# --------------------------------------------------------------------------
psql_bin: {{ psql_bin | default('/usr/bin/psql') }}

# --------------------------------------------------------------------------
# Field: pg_database
# Description: Name of the PostgreSQL database where SiSU stores its indexed
#              content.
# Default: sisu
# --------------------------------------------------------------------------
pg_database: {{ pg_database | default('sisu') }}

# --------------------------------------------------------------------------
# Field: pg_user
# Description: PostgreSQL username with permissions to read/write the SiSU
#              database.
# Default: sisu_user
# --------------------------------------------------------------------------
pg_user: {{ pg_user | default('sisu_user') }}

# --------------------------------------------------------------------------
# Field: pg_host
# Description: Hostname or IP address of the PostgreSQL server.
# Default: localhost
# --------------------------------------------------------------------------
pg_host: {{ pg_host | default('localhost') }}

# --------------------------------------------------------------------------
# Field: pg_port
# Description: TCP port number for the PostgreSQL server connection.
# Default: 5432
# --------------------------------------------------------------------------
pg_port: {{ pg_port | default(5432) }}

# --------------------------------------------------------------------------
# Field: sisu_doc_paths
# Description: List of absolute paths to directories containing SiSU source
#              documents to be indexed.
# Default: ['/var/lib/sisu']
# --------------------------------------------------------------------------
sisu_doc_paths:
{% for path in sisu_doc_paths | default(['/var/lib/sisu']) %}
- {{ path }}
{% endfor %}

# --------------------------------------------------------------------------
# Field: enable_granular_index
# Description: Flag to enable paragraph-level indexing for granular search
#              results.
# Default: True
# --------------------------------------------------------------------------
enable_granular_index: {{ enable_granular_index | default(True) }}

# --------------------------------------------------------------------------
# Field: enable_object_citations
# Description: Flag to enable tracking of object citation numbers for document
#              indexing.
# Default: True
# --------------------------------------------------------------------------
enable_object_citations: {{ enable_object_citations | default(True) }}