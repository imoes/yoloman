{
  "listen_ip": "0.0.0.0",
  "listen_port": 80,
  "servers": [
    {
      "host": "10.0.0.10",
      "port": 8080,
      "name": "web-1",
      "protocol": "tcp"
    },
    {
      "host": "10.0.0.11",
      "port": 8080,
      "name": "web-2",
      "protocol": "tcp"
    },
    {
      "host": "10.0.0.12",
      "port": 53,
      "name": "dns-1",
      "protocol": "udp"
    }
  ],
  "method": "leastconn",
  "healthcheck_interval": 15,
  "timeout": 60,
  "max_connections": 1000,
  "transparent": true,
  "log_file": "/var/log/pen/access.log",
  "log_timestamps": true,
  "log_level": 2,
  "outbound_ip": "10.0.1.1",
  "sticky": true
}
