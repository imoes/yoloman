{
  "punctuation": true,
  "delimiters": [
    ".",
    ",",
    ";",
    ":",
    "!",
    "?"
  ],
  "white_space": [
    " ",
    "\t"
  ],
  "start_delete": "[",
  "stop_delete": "]",
  "start_insert": "{",
  "stop_insert": "}",
  "line_numbers": 6,
  "context": 3,
  "match_context": 2,
  "no_deleted": false,
  "no_inserted": false,
  "no_common": false,
  "statistics": true,
  "ignore_case": false,
  "ignore_formatting": true,
  "color_spec": "red,green",
  "printer": false,
  "less_mode": false,
  "paragraph_separator": "--",
  "repeat_markers": true,
  "wdiff_output": false,
  "algorithm": "best",
  "aggregate_changes": false
}
