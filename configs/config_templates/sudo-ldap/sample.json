{
  "timestamp_timeout": 30,
  "pwfeedback": true,
  "admin_groups": [
    "sudo",
    "sysadmin"
  ],
  "permissions": [
    {
      "target": "%developers",
      "hosts": "ALL",
      "runas": "",
      "commands": "/usr/bin/apt-get update, /usr/bin/apt-get upgrade"
    },
    {
      "target": "deployer",
      "hosts": "ALL",
      "runas": "root",
      "commands": "/usr/bin/systemctl restart nginx"
    }
  ]
}
