{
  "hostname": "mx.example.com",
  "max_data_size_mb": 50,
  "port.smtp": 25,
  "submission_port.submission": 587,
  "monitoring_address": "127.0.0.1:1099",
  "mail_delivery_agent_bin": "maildrop",
  "mail_delivery_agent_args": [
    "-f",
    "%from%",
    "-d",
    "%to_user%"
  ],
  "data_dir": "/var/lib/chasquid",
  "suffix_separators": "+",
  "drop_characters": ".",
  "log": "syslog",
  "dovecot_auth": false,
  "dovecot_userdb_path": "",
  "dovecot_client_path": "",
  "haproxy_incoming": false
}
