{
  "output_format": {
    "type": "number",
    "default": 1,
    "description": "Output format (1-3); default: 1"
  },
  "output_file": {
    "type": "string",
    "default": "a.out",
    "description": "Output file name"
  },
  "list_file": {
    "type": "string",
    "default": "",
    "description": "List file name; empty means none generated"
  },
  "all_passes_list_file": {
    "type": "string",
    "default": "",
    "description": "List file containing all passes"
  },
  "verbosity": {
    "type": "number",
    "default": 0,
    "description": "Verboseness level (0-4); default: 0"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug mode"
  },
  "symbol_defs": {
    "type": "list",
    "default": [],
    "description": "List of symbols to define via -D; each entry defines a symbol name and optionally an expression"
  },
  "eqm_defs": {
    "type": "list",
    "default": [],
    "description": "List of symbols to define via -M (EQM); each entry must include an expression"
  },
  "max_passes": {
    "type": "number",
    "default": "",
    "description": "Maximum number of passes (with full checks)"
  },
  "max_passes_relaxed": {
    "type": "number",
    "default": "",
    "description": "Maximum number of passes (with fewer checks)"
  },
  "symbol_table_sort": {
    "type": "number",
    "default": 0,
    "description": "Symbol table sorting mode: 0=alphabetical, 1=address/value"
  },
  "error_format": {
    "type": "number",
    "default": 0,
    "description": "Error format: 0=MS, 1=Dillon, 2=GNU"
  },
  "strict_syntax": {
    "type": "bool",
    "default": false,
    "description": "Enable strict syntax checking"
  },
  "remove_on_error": {
    "type": "bool",
    "default": false,
    "description": "Remove binary output file in case of errors"
  },
  "max_file_size_kb": {
    "type": "number",
    "default": "",
    "description": "Maximum allowed file-size in kB"
  }
}
