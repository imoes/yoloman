# Boot Parameter Server configuration — bootparamd(8)
# Each line maps a client hostname to its boot parameters.
# Format: hostname kernel-image initrd-image root-path bootargs...
{% for entry in entries %}{{ entry.hostname }}	{{ entry.kernel }}	{{ entry.initrd | default('') }}	{{ entry.root_path }}	{{ entry.boot_args | default('') | join(' ') }}
{% endfor %}
