# Path to the SSH askpass helper binary.
# This script sets the environment variable SSH_ASKPASS to the location of the
# graphical password entry helper, which SSH uses when it needs a password
# but is running in a non-interactive environment (e.g., via ssh-agent or scripts).
SSH_ASKPASS={{ ssh_askpass_path | default('/usr/bin/ksshaskpass') }}
export SSH_ASKPASS
