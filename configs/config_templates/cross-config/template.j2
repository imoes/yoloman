. `dirname $ac_site_file`/cross-config.cache
#
# alpha specific configure variables
#
{% if maintainer_email is defined and maintainer_email is not none and (maintainer_email is number or maintainer_email is boolean or maintainer_email | length > 0) %}If you have additions to this file, please tell {{ maintainer_email | default('roman@debian.org') }}
{% else %}# If you have additions to this file, please tell <roman@debian.org>
{% endif %}# so they can be included in the package.
#
# ac_cv_c_bigendian: guessed endianness of the target C compiler (yes = big-endian, no = little-endian)
ac_cv_c_bigendian={{ ac_cv_c_bigendian | default('no') }}
# ac_cv_c_char_unsigned: whether target C compiler treats 'char' as unsigned (yes/no)
ac_cv_c_char_unsigned={{ ac_cv_c_char_unsigned | default('no') }}
