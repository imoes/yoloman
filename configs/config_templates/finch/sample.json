{
  "config_dir": "~/.finch",
  "general": {
    "shadow": false,
    "mouse": true,
    "wm": "/usr/local/lib/gnt/s.so",
    "remember_position": true,
    "small_button": true
  },
  "workspaces": [
    {
      "name": "blist",
      "window_names": [
        "buddylist",
        "debug-window"
      ],
      "window_titles": []
    },
    {
      "name": "IM",
      "window_names": [],
      "window_titles": [
        "conversation-window",
        "Preferences",
        "Pounce"
      ]
    }
  ],
  "colors": {
    "black": "0;0;0",
    "red": "1000;0;0",
    "green": "0;1000;0",
    "blue": "250;250;700",
    "white": "1000;1000;1000",
    "gray": "700;700;700",
    "darkgray": "256;256;256"
  },
  "colorpairs": {
    "normal": "white;black",
    "highlight": "white;blue",
    "highlightd": "black;gray",
    "shadow": "black;darkgray",
    "title": "white;blue",
    "titled": "white;gray",
    "text": "white;blue",
    "disabled": "gray;black",
    "urgent": "green;black"
  },
  "entry_remap": {
    "^[[A": "^[[D",
    "^[[B": "^[[C",
    "a": "bcd",
    "q": ""
  },
  "button_remap": {
    " ": "\\r"
  },
  "widget_bindings": {
    "GntBox": {
      "tab": "focus-next",
      "right": "focus-next",
      "left": "focus-prev"
    },
    "GntEntry": {
      "c-a": "cursor-home",
      "home": "cursor-home",
      "c-e": "cursor-end",
      "end": "cursor-end",
      "backspace": "delete-prev",
      "del": "delete-next",
      "c-d": "delete-next",
      "c-u": "delete-start",
      "c-k": "delete-end",
      "c-b": "cursor-prev",
      "left": "cursor-prev",
      "c-f": "cursor-next",
      "right": "cursor-next",
      "tab": "suggest-show",
      "down": "suggest-next",
      "up": "suggest-prev",
      "page-down": "suggest-next-page",
      "page-up": "suggest-prev-page",
      "c-w": "delete-prev-word",
      "a-b": "cursor-prev-word",
      "a-f": "cursor-next-word",
      "a-d": "delete-next-word",
      "c-v": "clipboard-paste",
      "c-p": "history-prev",
      "c-n": "history-next",
      "c-r": "history-search",
      "c-up": "history-prev",
      "c-down": "history-next"
    },
    "GntTree": {
      "up": "move-up",
      "down": "move-down",
      "c-n": "move-down",
      "c-p": "move-up",
      "pageup": "page-up",
      "pagedown": "page-down",
      "backspace": "move-parent",
      "home": "move-first",
      "end": "move-last",
      "menu": "context-menu"
    },
    "GntWidget": {
      "f11": "context-menu",
      "c-x": "context-menu"
    },
    "GntWindow": {
      "c-o": "show-menu",
      "f10": "show-menu"
    }
  },
  "buddylist_menu": {
    "c-t": "send-im"
  },
  "wm_bindings": {
    "a-n": "window-next",
    "a-p": "window-prev",
    "a-c": "window-close",
    "a-w": "window-list",
    "a-q": "wm-quit",
    "a-l": "refresh-screen",
    "a-s": "workspace-list",
    "a-t": "window-tag",
    "a-T": "place-tagged"
  },
  "wm_specific_bindings": {
    "GntS": {
      "a-b": "toggle-buddylist"
    },
    "Irssi": {
      "a-L": "move-right",
      "a-H": "move-left",
      "a-J": "move-down",
      "a-K": "move-up"
    }
  }
}
