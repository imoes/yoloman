{
  "config_dir": {
    "type": "string",
    "default": "~/.purple",
    "description": "Directory for Finch config files instead of default ~/.purple"
  },
  "general": {
    "type": "object",
    "default": null,
    "description": "General finch settings (nested object for [general] section)"
  },
  "general.shadow": {
    "type": "bool",
    "default": false,
    "description": "Enable shadow effects in window decorations"
  },
  "general.mouse": {
    "type": "bool",
    "default": false,
    "description": "Enable experimental mouse support"
  },
  "general.wm": {
    "type": "string",
    "default": "",
    "description": "Path to custom window manager shared object (e.g., /usr/local/lib/gnt/s.so)"
  },
  "general.remember_position": {
    "type": "bool",
    "default": true,
    "description": "Remember window positions by title on startup"
  },
  "general.small_button": {
    "type": "bool",
    "default": false,
    "description": "Use borderless one-line high buttons"
  },
  "workspaces": {
    "type": "list",
    "default": [],
    "description": "List of workspace definitions. Each workspace defines named windows/titles to group together. [Workspace-N] sections in ~/.gntrc."
  },
  "workspaces.items": {
    "type": "object",
    "default": null,
    "description": "Single workspace definition"
  },
  "workspaces.items.name": {
    "type": "string",
    "default": "",
    "description": "Display name of the workspace"
  },
  "workspaces.items.window_names": {
    "type": "list",
    "default": [],
    "description": "Window names to place in this workspace (semicolon-separated in config)"
  },
  "workspaces.items.window_titles": {
    "type": "list",
    "default": [],
    "description": "Window titles (substrings) to place in this workspace"
  },
  "colors": {
    "type": "object",
    "default": null,
    "description": "Named color definitions (RGB values) under [colors]"
  },
  "colors.items": {
    "type": "string",
    "default": "0;0;0",
    "description": "RGB value string in format 'R;G;B' (0-1000 each)"
  },
  "colorpairs": {
    "type": "object",
    "default": null,
    "description": "Named color pair definitions under [colorpairs]"
  },
  "colorpairs.items": {
    "type": "string",
    "default": "white;black",
    "description": "Color pair string in format 'foreground;background'"
  },
  "entry_remap": {
    "type": "object",
    "default": null,
    "description": "Key remappings for GntEntry widget under [GntEntry::remap]"
  },
  "entry_remap.items": {
    "type": "string",
    "default": "",
    "description": "Target key sequence for remapping"
  },
  "button_remap": {
    "type": "object",
    "default": null,
    "description": "Key remappings for GntButton widget under [GntButton::remap]"
  },
  "button_remap.items": {
    "type": "string",
    "default": "",
    "description": "Target key sequence for remapping"
  },
  "widget_bindings": {
    "type": "object",
    "default": null,
    "description": "Widget-specific key bindings ([widget]::binding sections)"
  },
  "widget_bindings.items": {
    "type": "object",
    "default": null,
    "description": "Bindings for a specific widget"
  },
  "widget_bindings.items.items": {
    "type": "object",
    "default": null,
    "description": "Single key-binding pair"
  },
  "widget_bindings.items.items.keys": {
    "type": "string",
    "default": "",
    "description": "Key sequence (e.g., 'c-a', 'alt-q')"
  },
  "widget_bindings.items.items.actions": {
    "type": "string",
    "default": "focus-next",
    "description": "Action name (e.g., 'cursor-home', 'focus-next')",
    "enum": [
      "focus-next",
      "focus-prev",
      "dropdown",
      "cursor-home",
      "cursor-end",
      "delete-prev",
      "delete-next",
      "delete-start",
      "delete-end",
      "cursor-prev",
      "cursor-next",
      "suggest-show",
      "suggest-next",
      "suggest-prev",
      "suggest-next-page",
      "suggest-prev-page",
      "delete-prev-word",
      "cursor-prev-word",
      "cursor-next-word",
      "delete-next-word",
      "clipboard-paste",
      "history-prev",
      "history-next",
      "history-search",
      "move-up",
      "move-down",
      "page-up",
      "page-down",
      "move-parent",
      "move-first",
      "move-last",
      "context-menu",
      "show-menu"
    ],
    "enum_open": true
  },
  "buddylist_menu": {
    "type": "object",
    "default": null,
    "description": "Buddylist menu action key bindings ([buddylist::menu])"
  },
  "buddylist_menu.items": {
    "type": "string",
    "default": "send-im",
    "description": "Menu action name (e.g., 'send-im', 'join-chat')",
    "enum": [
      "send-im",
      "join-chat",
      "show-empty-groups",
      "show-offline-buddies",
      "sort-status",
      "sort-alpha",
      "sort-log",
      "add-buddy",
      "add-chat",
      "add-group"
    ],
    "enum_open": true
  },
  "wm_bindings": {
    "type": "object",
    "default": null,
    "description": "Window manager action key bindings ([GntWM::binding])"
  },
  "wm_bindings.items": {
    "type": "string",
    "default": "window-next",
    "description": "Window manager action name (e.g., 'window-next', 'wm-quit')",
    "enum": [
      "window-next",
      "window-prev",
      "window-close",
      "window-list",
      "dump-screen",
      "shift-left",
      "shift-right",
      "action-list",
      "start-move",
      "start-resize",
      "wm-quit",
      "refresh-screen",
      "workspace-list",
      "window-tag",
      "place-tagged",
      "toggle-clipboard",
      "help-for-widget",
      "window-scroll-down",
      "window-scroll-up",
      "window-next-urgent",
      "window-prev-urgent",
      "switch-window-n"
    ],
    "enum_open": true
  },
  "wm_specific_bindings": {
    "type": "object",
    "default": null,
    "description": "Window manager-specific key bindings ([WMName::binding] sections)"
  },
  "wm_specific_bindings.items": {
    "type": "object",
    "default": null,
    "description": "Bindings for a specific window manager"
  },
  "wm_specific_bindings.items.items": {
    "type": "object",
    "default": null,
    "description": "Single WM-specific key-binding pair"
  },
  "wm_specific_bindings.items.items.keys": {
    "type": "string",
    "default": "",
    "description": "Key sequence"
  },
  "wm_specific_bindings.items.items.actions": {
    "type": "string",
    "default": "window-next",
    "description": "WM action name",
    "enum": [
      "window-next",
      "window-prev",
      "window-close",
      "window-list",
      "dump-screen",
      "shift-left",
      "shift-right",
      "action-list",
      "start-move",
      "start-resize",
      "wm-quit",
      "refresh-screen",
      "workspace-list",
      "window-tag",
      "place-tagged",
      "toggle-clipboard",
      "help-for-widget",
      "window-scroll-down",
      "window-scroll-up",
      "window-next-urgent",
      "window-prev-urgent",
      "switch-window-n",
      "toggle-buddylist",
      "move-right",
      "move-left",
      "move-down",
      "move-up"
    ]
  }
}
