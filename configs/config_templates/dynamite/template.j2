{# dynamite(1) decompressor configuration #}
{# Self-documenting template: each directive is annotated with its schema description and safe defaults. #}

{# input_file: Path to the PKWARE-compressed input file to decompress. #}
input_file = {{ (input_file | default('input.bin')) | string }}

{# output_file: Path to write the decompressed output data. #}
output_file = {{ (output_file | default('output.bin')) | string }}

{# input_offset: Optional byte offset in input file to start decompression from. #}
{# If provided, it is emitted; otherwise, the tool uses its internal default (0). #}
{% if input_offset is defined %}
input_offset = {{ (input_offset | default(0)) | int }}
{% endif %}