{
  "wml_root_path": "/srv/www/mysite",
  "wml_base_url": "https://www.example.com",
  "wml_include_paths": [
    "/usr/share/wml/include",
    "/srv/www/mysite/includes"
  ],
  "wml_definitions": [
    "TITLE=My Example Site",
    "AUTHOR=Webmaster"
  ],
  "wml_optimization_level": 5,
  "wml_verbose_level": 0,
  "wml_passes": "1-9",
  "wml_tmp_dir": "/var/tmp/wml",
  "wml_safe_mode": false,
  "wml_includefile": "<wml::meta::title>",
  "wml_prolog_filter": "",
  "wml_epilog_filter": "tidy",
  "wml_set_time": true,
  "wml_output_dependencies": false
}
