# Rephrase configuration
#
# This template configures the 'rephrase' utility, a tool for recovering GnuPG
# passphrases and formatting output. All variables use safe defaults derived from
# the Ansible role schema to prevent render failures.

# Whether to run with setuid root privileges to enable mlock() for secure memory handling.
# Setuid root is required for mlock() security
SETUID_ROOT={{ setuid_root | default(True) | ternary('true', 'false') }}

# The GnuPG key ID, fingerprint, or user ID of the key whose passphrase is being recovered
# GnuPG key ID or fingerprint to recover passphrase for
GNUPG_KEY={{ gnupg_key | default('0xDEADBEEF') }}

# The format for outputting recovery results (e.g., text, json)
# Output mode: 'text' for standard output, 'json' for structured data
OUTPUT_FORMAT={{ output_format | default('text') }}

# Enable verbose logging to provide detailed execution information
# Enable verbose logging to stderr
VERBOSE={{ verbose | default(False) | ternary('true', 'false') }}