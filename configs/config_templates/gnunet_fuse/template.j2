# gnunet.conf — GNU GNUNET FUSE client configuration
# This file configures the FUSE filesystem client for GNU GNUNET, enabling secure P2P mounted filesystems.
# GNUNET_HOME sets the base directory for GNUNET data and configuration.
# For this FUSE client, we typically inherit settings from the main GNUNET config.
# The FUSE-specific options are defined under the [fuse] section.

[FUSE]
# Enable or disable the FUSE filesystem client.
ENABLE = {{ enable_fuse|lower }}

# Mount point where the GNUNET FUSE filesystem will be exposed.
MOUNTPOINT = {{ mountpoint }}

# User ID to run the FUSE process as (for security and permission control).
UID = {{ uid }}

# Group ID to run the FUSE process as.
GID = {{ gid }}

# File system access permissions (octal, e.g., 0700). 0755 is common for multi-user access.
PERMISSIONS = {{ permissions }}

# Maximum number of pending I/O operations (concurrent reads/writes).
MAX_PENDING = {{ max_pending }}

# Enable or disable lazy directory listing (improves performance with large directories).
LAZY_LISTING = {{ lazy_listing|lower }}

# Timeout (in seconds) before idle mounts are automatically unmounted.
IDLE_TIMEOUT = {{ idle_timeout }}

# Path to the GNUNET peer identity key file (used to bind this mount to a specific peer identity).
IDENTITY_KEY_FILE = {{ identity_key_file }}

# Optional: Additional mount options passed to libfuse (comma-separated, no spaces).
# Examples: allow_other,allow_root,default_permissions,utime_ok
MOUNT_OPTIONS = {{ mount_options | join(',') }}

# Logging level for FUSE subsystem: ERROR, WARNING, NOTICE, INFO, DEBUG.
LOG_LEVEL = {{ log_level }}
