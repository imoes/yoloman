{
  "log_files": [
    "/var/log/postgresql/postgresql-*.log"
  ],
  "out_dir": "/var/www/reports/pgbadger",
  "output_filename": "latest_report.html",
  "top_queries": 50,
  "query_samples": 5,
  "average_graphs_minutes": 10,
  "histo_average_minutes": 30,
  "log_format": "",
  "log_prefix": "",
  "incremental": true,
  "retention_weeks": 12,
  "jobs_per_file": 4,
  "jobs_parallel": 1,
  "exclude_queries": [
    "^SELECT 1$",
    "^(VACUUM|COMMIT)$"
  ],
  "exclude_databases": [
    "template0",
    "template1"
  ],
  "exclude_users": [
    "monitoring_user"
  ],
  "exclude_clients": [
    "127.0.0.1"
  ],
  "disable_hourly": false,
  "disable_query": false,
  "disable_session": false,
  "disable_connection": false,
  "disable_lock": false,
  "disable_temporary": false,
  "disable_checkpoint": false,
  "disable_autovacuum": false,
  "disable_error": false,
  "anonymize": false,
  "report_title": "Production PostgreSQL Analysis",
  "timezone_offset": "+2",
  "quiet": true,
  "verbose": false
}
