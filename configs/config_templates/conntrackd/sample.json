{
  "log_level": 5,
  "log_file": "/var/log/conntrackd.log",
  "network": {
    "bind_addr": "127.0.0.1",
    "port": 3780,
    "protocol": "IPv4"
  },
  "conntrack": {
    "table_size": 131072,
    "timeout": {
      "established": 432000,
      "close": 10,
      "time_wait": 60
    },
    "flush_on_start": false,
    "sync": {
      "enabled": true,
      "mode": "normal",
      "queue_maxlen": 512,
      "log_sync": true
    }
  },
  "event": {
    "new_command": "/usr/local/bin/conntrack-alert.sh new",
    "destroy_command": "/usr/local/bin/conntrack-alert.sh destroy"
  },
  "helper": {
    "ftp": {
      "enabled": true,
      "port": 21,
      "timeout": 300
    }
  },
  "snmp": {
    "agentx": true
  },
  "ha": {
    "mode": "full",
    "peers": [
      {
        "addr": "10.0.0.2",
        "port": 3780
      }
    ],
    "secret": "conntrackd-secret-2024",
    "interval": 2
  }
}
