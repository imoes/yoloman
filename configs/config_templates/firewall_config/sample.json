{
  "firewall_enabled": true,
  "default_zone": "public",
  "log_denied": "unicast",
  "rich_language_enabled": true,
  "automatic_default_zone_updates": false,
  "services": [
    "ssh",
    "dhcpv6-client"
  ],
  "ports": [
    "80/tcp",
    "443/tcp"
  ],
  "masquerade_enabled": false,
  "icmp_block_inheritance": true,
  "icmp_blocks": [
    "echo-request"
  ],
  "zones": [
    {
      "name": "home",
      "services": [
        "ssh",
        "samba-client",
        "mdns",
        "dhcpv6-client"
      ],
      "ports": [],
      "masquerade": false,
      "icmp_blocks": [],
      "icmp_block_inheritance": true
    },
    {
      "name": "work",
      "services": [
        "ssh",
        "ipp-client"
      ],
      "ports": [
        "5353/udp"
      ],
      "masquerade": false,
      "icmp_blocks": [],
      "icmp_block_inheritance": false
    }
  ],
  "gui_enabled": true,
  "gui_log_path": "/var/log/firewall-config.log",
  "debug_mode": false
}
