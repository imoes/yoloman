{
  "vars": [
    {
      "name": "LANG",
      "default": "en_US.UTF-8"
    },
    {
      "name": "LC_MESSAGES",
      "default": "POSIX"
    },
    {
      "name": "TZ",
      "default": ":/etc/localtime"
    },
    {
      "name": "PATH",
      "default": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "condition": "DEFAULT=/bin:/usr/bin USER=root"
    },
    {
      "name": "MAIL",
      "default": "/var/mail/${USER}",
      "condition": "DEFAULT=/var/mail USER=*"
    }
  ]
}
