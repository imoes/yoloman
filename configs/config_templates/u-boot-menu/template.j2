## /etc/default/u-boot - configuration file for u-boot-update(8)
# This file is managed by Ansible. Do not edit manually.
# It configures the u-boot-update tool which generates bootloader entries.

{% set u_boot_update_val = u_boot_update | default(true) %}
{% if u_boot_update_val %}
# Enable or disable u-boot-update processing.
# Default: true
U_BOOT_UPDATE="{{ u_boot_update_val }}"
{% else %}
# Enable or disable u-boot-update processing.
# Default: true
U_BOOT_UPDATE="false"
{% endif %}

{% set u_boot_alternatives_val = u_boot_alternatives | default('') %}
{% if u_boot_alternatives_val %}
# List of u-boot alternatives to manage.
# Default: ''
U_BOOT_ALTERNATIVES="{{ u_boot_alternatives_val }}"
{% else %}
# List of u-boot alternatives to manage.
# Default: ''
U_BOOT_ALTERNATIVES=""
{% endif %}

{% set u_boot_default_val = u_boot_default | default('') %}
{% if u_boot_default_val %}
# The default u-boot alternative to use.
# Default: ''
U_BOOT_DEFAULT="{{ u_boot_default_val }}"
{% else %}
# The default u-boot alternative to use.
# Default: ''
U_BOOT_DEFAULT=""
{% endif %}

{% set u_boot_prompt_val = u_boot_prompt | default('1') %}
{% if u_boot_prompt_val %}
# Whether to show the boot menu prompt.
# Default: '1'
U_BOOT_PROMPT="{{ u_boot_prompt_val }}"
{% else %}
# Whether to show the boot menu prompt.
# Default: '1'
U_BOOT_PROMPT="1"
{% endif %}

{% set u_boot_entries_val = u_boot_entries | default('') %}
{% if u_boot_entries_val %}
# Which entries to include in the menu.
# Default: ''
U_BOOT_ENTRIES="{{ u_boot_entries_val }}"
{% else %}
# Which entries to include in the menu.
# Default: ''
U_BOOT_ENTRIES=""
{% endif %}

{% set u_boot_menu_label_val = u_boot_menu_label | default('') %}
{% if u_boot_menu_label_val %}
# Label for the main menu entry.
# Default: ''
U_BOOT_MENU_LABEL="{{ u_boot_menu_label_val }}"
{% else %}
# Label for the main menu entry.
# Default: ''
U_BOOT_MENU_LABEL=""
{% endif %}

{% set u_boot_parameters_val = u_boot_parameters | default('') %}
{% if u_boot_parameters_val %}
# Kernel parameters passed to the boot entries.
# Default: ''
U_BOOT_PARAMETERS="{{ u_boot_parameters_val }}"
{% else %}
# Kernel parameters passed to the boot entries.
# Default: ''
U_BOOT_PARAMETERS=""
{% endif %}

{% set u_boot_root_val = u_boot_root | default('') %}
{% if u_boot_root_val %}
# Root device specification for the kernel.
# Default: ''
U_BOOT_ROOT="{{ u_boot_root_val }}"
{% else %}
# Root device specification for the kernel.
# Default: ''
U_BOOT_ROOT=""
{% endif %}

{% set u_boot_timeout_val = u_boot_timeout | default('') %}
{% if u_boot_timeout_val %}
# Timeout in seconds before booting the default entry.
# Default: ''
U_BOOT_TIMEOUT="{{ u_boot_timeout_val }}"
{% else %}
# Timeout in seconds before booting the default entry.
# Default: ''
U_BOOT_TIMEOUT=""
{% endif %}

{% set u_boot_fdt_val = u_boot_fdt | default('') %}
{% if u_boot_fdt_val %}
# Specific Device Tree Blob to use.
# Default: ''
U_BOOT_FDT="{{ u_boot_fdt_val }}"
{% else %}
# Specific Device Tree Blob to use.
# Default: ''
U_BOOT_FDT=""
{% endif %}

{% set u_boot_fdt_dir_val = u_boot_fdt_dir | default('') %}
{% if u_boot_fdt_dir_val %}
# Directory containing kernel images and DTBs.
# Default: ''
U_BOOT_FDT_DIR="{{ u_boot_fdt_dir_val }}"
{% else %}
# Directory containing kernel images and DTBs.
# Default: ''
U_BOOT_FDT_DIR=""
{% endif %}

{% set u_boot_fdt_overlays_val = u_boot_fdt_overlays | default('') %}
{% if u_boot_fdt_overlays_val %}
# Specific FDT overlays to apply.
# Default: ''
U_BOOT_FDT_OVERLAYS="{{ u_boot_fdt_overlays_val }}"
{% else %}
# Specific FDT overlays to apply.
# Default: ''
U_BOOT_FDT_OVERLAYS=""
{% endif %}

{% set u_boot_fdt_overlays_dir_val = u_boot_fdt_overlays_dir | default('') %}
{% if u_boot_fdt_overlays_dir_val %}
# Directory containing device tree overlays.
# Default: ''
U_BOOT_FDT_OVERLAYS_DIR="{{ u_boot_fdt_overlays_dir_val }}"
{% else %}
# Directory containing device tree overlays.
# Default: ''
U_BOOT_FDT_OVERLAYS_DIR=""
{% endif %}

{% set u_boot_sync_dtbs_val = u_boot_sync_dtbs | default(false) %}
{% if u_boot_sync_dtbs_val %}
# Whether to synchronize DTBs automatically.
# Default: false
U_BOOT_SYNC_DTBS="{{ u_boot_sync_dtbs_val }}"
{% else %}
# Whether to synchronize DTBs automatically.
# Default: false
U_BOOT_SYNC_DTBS="false"
{% endif %}