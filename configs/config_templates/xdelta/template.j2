{#
  ============================================================================
  Xdelta Configuration Template
  ============================================================================
  Xdelta is primarily a command-line utility for generating binary deltas.
  This template captures its tunable parameters into a configuration file
  format for automated batch operations or role-based deployment.

  Each directive is self-documenting with its schema description and
  safe default value inline.
  ============================================================================
  #}

{#
  Set the zlib compression level (0-9). Zero indicates no compression,
  nine indicates maximum compression.
  Default: 6
  #}
compression_level = {{ compression_level | default(6) }}

{#
  Quiet mode; suppresses several warning messages.
  Default: false
  #}
quiet = {{ quiet | default(false) | lower }}

{#
  Verbose mode; prints a bit of extra information.
  Default: false
  #}
verbose = {{ verbose | default(false) | lower }}

{#
  No verify; turns off MD5 checksum verification of input and output files.
  Default: false
  #}
noverify = {{ noverify | default(false) | lower }}

{#
  Set an upper bound on the size of an in-memory page cache (e.g., 32M).
  Default: 32M
  #}
maxmem = {{ maxmem | default('32M') }}

{#
  Set the block size for delta computation. Should be a power of 2.
  0 uses default.
  Default: 0
  #}
block_size = {{ block_size | default(0) }}

{#
  Disable automatic decompression of gzipped inputs to prevent
  recompression mismatches.
  Default: false
  #}
pristine = {{ pristine | default(false) | lower }}