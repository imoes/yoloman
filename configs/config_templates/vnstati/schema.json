{
  "iface": {
    "type": "string",
    "default": "eth0",
    "description": "Interface to monitor (e.g., eth0, eth0+eth1)"
  },
  "db_file": {
    "type": "string",
    "default": "/var/lib/vnstat/vnstat.db",
    "description": "Path to the vnStat database file"
  },
  "output_file": {
    "type": "string",
    "default": "/var/www/html/vnstat.png",
    "description": "Output image file path (extension determines format)"
  },
  "graph_type": {
    "type": "string",
    "default": "summary",
    "description": "Primary graph view: summary, hours, fiveminutes, days, months, years, top, 95th",
    "enum": [
      "summary",
      "hours",
      "days",
      "months",
      "years",
      "top",
      "95th"
    ]
  },
  "cache_minutes": {
    "type": "number",
    "default": 0,
    "description": "Cache update interval in minutes (0 for no cache)"
  },
  "entry_limit": {
    "type": "number",
    "default": 0,
    "description": "Max entries for list outputs (0 for all)"
  },
  "rate_unit_mode": {
    "type": "number",
    "default": 0,
    "description": "Rate unit: 0=Bytes, 1=Bits"
  },
  "style_number": {
    "type": "number",
    "default": 0,
    "description": "Style: 0=Bars, 3=Average Rate"
  },
  "transparent_bg": {
    "type": "bool",
    "default": false,
    "description": "Enable transparent background"
  },
  "no_header": {
    "type": "bool",
    "default": false,
    "description": "Remove header"
  },
  "no_edge": {
    "type": "bool",
    "default": false,
    "description": "Remove edges"
  },
  "no_legend": {
    "type": "bool",
    "default": false,
    "description": "Remove legend"
  },
  "font_large": {
    "type": "bool",
    "default": false,
    "description": "Use large fonts"
  },
  "font_small": {
    "type": "bool",
    "default": false,
    "description": "Use small fonts"
