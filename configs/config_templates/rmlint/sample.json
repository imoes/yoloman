{
  "targets": [
    "/var/lib/dpkg/info"
  ],
  "types": "defaults",
  "outputs": [
    "sh:rmlint.sh",
    "json:/tmp/rmlint.json"
  ],
  "configs": [
    "sh:handler=remove"
  ],
  "algorithm": "sha256",
  "verbose": true,
  "progress": true,
  "hardlink_policy": "--hardlinked",
  "symlink_policy": "-@",
  "no_cross_dev": false,
  "hidden_policy": "-R",
  "size_range": "1K",
  "max_depth": "INF",
  "threads": 4,
  "mem_limit": "2G",
  "keep_tagged": false,
  "must_match_tagged": false,
  "rank_by": "pOma",
  "sort_by": "",
  "mtime_window": -1,
  "use_xattr": false,
  "write_unfinished": false,
  "clamp_low": "",
  "clamp_top": "",
  "no_fiemap": false
}
