# NCL (NCAR Command Language) Environment Configuration
# This template generates shell environment variables for the NCAR Graphics suite.
# It is intended for use in user shell profiles (e.g., .bashrc, .profile) or system-wide environment scripts.

# NCARG_ROOT
# Description: The root directory for NCAR Graphics installation.
# Default: /usr
setenv NCARG_ROOT {{ ncarg_root | default('/usr') }}

# NCARG_LIB
# Description: The directory containing NCAR Graphics libraries.
# Default: /usr/lib64/ncarg
setenv NCARG_LIB {{ ncarg_lib | default('/usr/lib64/ncarg') }}

# NCARG_DATABASE
# Description: The directory containing the NCAR Graphics database.
# Default: /usr/lib64/ncarg/database
setenv NCARG_DATABASE {{ ncarg_database | default('/usr/lib64/ncarg/database') }}

# NCARG_FONTCAPS
# Description: The directory containing font capability files.
# Default: /usr/lib64/ncarg/fontcaps
setenv NCARG_FONTCAPS {{ ncarg_fontcaps | default('/usr/lib64/ncarg/fontcaps') }}

# NCARG_GRAPHCAPS
# Description: The directory containing graph capability files.
# Default: /usr/lib64/ncarg/graphcaps
setenv NCARG_GRAPHCAPS {{ ncarg_graphcaps | default('/usr/lib64/ncarg/graphcaps') }}

# NCARG_NCARG
# Description: The directory containing shared NCAR Graphics resources.
# Default: /usr/share/ncarg
setenv NCARG_NCARG {{ ncarg_ncarg | default('/usr/share/ncarg') }}
