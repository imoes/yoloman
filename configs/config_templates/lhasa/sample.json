{
  "archive_format": "lh4",
  "extraction_dest": "/var/lib/lhasa/data",
  "quiet_level": 0,
  "force_overwrite": true,
  "ignore_paths": false,
  "dry_run": false,
  "verbose": true,
  "operations": [
    {
      "command": "x",
      "archive": "/srv/archives/legacy.lzh",
      "files": [
        "*.txt",
        "*.doc"
      ],
      "options": "w=/tmp/extracted"
    },
    {
      "command": "t",
      "archive": "/srv/archives/backup.lzs",
      "files": [],
      "options": "q2"
    },
    {
      "command": "l",
      "archive": "/srv/archives/diagnostic.lh7",
      "files": [],
      "options": "v"
    }
  ]
}
