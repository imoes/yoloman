# Defaults for tntnet initscript
# sourced by /etc/init.d/tntnet
# installed at /etc/default/tntnet by the maintainer scripts

#
# This is a POSIX shell fragment
#

# Additional command-line options passed to the tntnet daemon.
# See tntnet(8) or the documentation for available options.
# Example: '-p 8080'
DAEMON_OPTS="{{ daemon_opts | default('') }}"

# Uncomment to disable checking port 80 availability on startup.
# Set to 'true' to skip the check; leave commented to enforce the check.
# {{ no_port_check | default(False) }}
{% if no_port_check | default(False) | bool %}
NO_PORT_CHECK="{{ no_port_check | default('true') }}"
{% else %}
#NO_PORT_CHECK="true"
{% endif %}