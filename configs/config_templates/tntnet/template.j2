# Defaults for tntnet initscript
# sourced by /etc/init.d/tntnet
# installed at /etc/default/tntnet by the maintainer scripts

#
# This is a POSIX shell fragment
#

# Additional command-line options passed to the tntnet daemon.
# Default: empty string
DAEMON_OPTS="{{ daemon_opts | default('') }}"

# Set to true to disable checking port 80 availability on startup.
# Default: false
# When true, the startup script skips the test for port 80 being free.
{% if no_port_check | default(False) | bool %}
NO_PORT_CHECK="true"
{% else %}
# NO_PORT_CHECK="false"
{% endif %}