# apcupsd-cgi-redhat Configuration Template
# This template generates the CSS styles for the apcupsd CGI interface.
# It is self-documenting: every style rule is preceded by a comment explaining
# the controlling variable and its source from the schema.

# Body styling
body {
    # Text color for the body element. Default: 'black'
    color: {{ body_color | default('black') }};
    # Background color for the body element. Default: 'white'
    background: {{ body_background | default('white') }};
}

div.Center {
    text-align: center;
}

img {
    border-style: none;
}

pre {
    text-align: left;
}

strong {
    # Text color for strong/bold elements. Default: 'red'
    color: {{ strong_color | default('red') }};
}

table.Outer {
    # Text color for the main APCCGI table. Default: 'black'
    color: {{ table_outer_color | default('black') }};
    # Background color for the main APCCGI table. Default: '#60a0a0'
    background: {{ table_outer_background | default('#60a0a0') }};
    empty-cells: show; border: solid {{ table_outer_border_color | default('#60a0a0') }}
}

th.Outer {
    # Text color for table headers in the main table. Default: 'black'
    color: {{ th_outer_color | default('black') }};
    # Background color for table headers in the main table. Default: '#60b0b0'
    background: {{ th_outer_background | default('#60b0b0') }}
}

.Title {
    # Font size for the main title. Default: '18pt'
    font-size: {{ title_font_size | default('18pt') }};
}

.SubTitle {
    # Font size for subtitles. Default: '12pt'
    font-size: {{ subtitle_font_size | default('12pt') }};
}

.Empty {
    # Text color for 'Empty' status cells. Default: 'black'
    color: {{ empty_color | default('black') }};
    # Background color for 'Empty' status cells. Default: 'aqua'
    background: {{ empty_background | default('aqua') }};
}

.Fault {
    # Text color for 'Fault' status cells. Default: 'black'
    color: {{ fault_color | default('black') }};
    # Background color for 'Fault' status cells. Default: 'red'
    background: {{ fault_background | default('red') }};
}

.Label {
    # Text color for label cells. Default: 'black'
    color: {{ label_color | default('black') }};
    # Background color for label cells. Default: 'aqua'
    background: {{ label_background | default('aqua') }};
}

.Normal {
    # Text color for 'Normal' status cells. Default: 'black'
    color: {{ normal_color | default('black') }};
    # Background color for 'Normal' status cells. Default: 'lime'
    background: {{ normal_background | default('lime') }};
}

.Warning {
    # Text color for 'Warning' status cells. Default: 'black'
    color: {{ warning_color | default('black') }};
    # Background color for 'Warning' status cells. Default: 'yellow'
    background: {{ warning_background | default('yellow') }};
}
