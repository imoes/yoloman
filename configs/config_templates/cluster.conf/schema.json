{
  "cluster_name": {
    "type": "string",
    "default": "my-cluster",
    "description": "Unique name for the cluster, used for identification and HA coordination."
  },
  "config_version": {
    "type": "number",
    "default": 1,
    "description": "Version number of the cluster configuration; must be incremented after changes."
  },
  "cman": {
    "type": "object",
    "default": {},
    "description": "CMAN (Cluster Manager) settings for cluster messaging and membership.",
    "items": {
      "transport": {
        "type": "string",
        "default": "udp",
        "description": "RPM transport protocol: 'udp' or 'sctp'."
      },
      "secauth": {
        "type": "string",
        "default": "0",
        "description": "Enable security authentication (0 = off, 1 = on)."
      },
      "totem_version": {
        "type": "string",
        "default": "2",
        "description": "Totem ring version (usually 2)."
      },
      "token": {
        "type": "number",
        "default": 10000,
        "description": "Token timeout in milliseconds before declaring ring failure."
      },
      "consensus_timeout": {
        "type": "number",
        "default": 1000,
        "description": "Time (ms) to wait before consensus is declared lost."
      },
      "two_node": {
        "type": "bool",
        "default": false,
        "description": "Enable special handling for 2-node clusters."
      },
      "token_retransmit": {
        "type": "number",
        "default": 400,
        "description": "Token retransmit timeout (ms)."
      },
      "token_retransmits_before_loss": {
        "type": "number",
        "default": 10,
        "description": "Retransmit attempts before token loss is declared."
      },
      "join": {
        "type": "number",
        "default": 100,
        "description": "Join timeout (ms) for new nodes joining the ring."
      },
      "join_retransmit": {
        "type": "number",
        "default": 50,
        "description": "Join retransmit interval (ms)."
      },
      "max_messages": {
        "type": "number",
        "default": 20,
        "description": "Maximum queued messages in the ring."
      },
      "max_network_delay": {
        "type": "number",
        "default": 50,
        "description": "Maximum network delay (ms) between ring nodes."
      },
      "miss_count": {
        "type": "number",
        "default": 5,
        "description": "Number of missed heartbeats before declaring a node down."
      },
      "rrp_mode": {
        "type": "string",
        "default": "none",
        "description": "Redundant ring protocol mode: 'none', 'active', or 'passive'."
      },
      "rrp_problem_timeout": {
        "type": "number",
        "default": 3000,
        "description": "Time (ms) before declaring redundant ring problematic."
      },
      "rrp_active": {
        "type": "string",
        "default": "",
        "description": "Interface used for redundant ring (e.g., 'eth1')."
      },
      "rrp_transport": {
        "type": "string",
        "default": "udp",
        "description": "Transport for redundant ring (usually 'udp')."
      }
    }
  },
  "nodes": {
    "type": "list",
    "default": [],
    "description": "List of cluster nodes, each with fencing and identity info.",
    "items": {
      "name": {
        "type": "string",
        "default": "",
        "description": "Hostname of the node."
      },
      "id": {
        "type": "number",
        "default": 0,
        "description": "Unique node ID (1-based integer)."
      },
      "fencedevices": {
        "type": "list",
        "default": [],
        "description": "Fencing devices defined for this node.",
        "items": {
          "name": {
            "type": "string",
            "default": "",
            "description": "Name of the fencing device."
          },
          "agent": {
            "type": "string",
            "default": "",
            "description": "Fencing agent (e.g., 'fence_ipmilan', 'fence_xvm')."
          },
          "options": {
            "type": "object",
            "default": {},
            "description": "Agent-specific options (e.g., {'ipaddr': '10.0.0.1', 'login': 'admin'})."
          }
        }
      },
      "fence_methods": {
        "type": "list",
        "default": [],
        "description": "Fencing methods for this node, each referencing one or more devices.",
        "items": {
          "name": {
            "type": "string",
            "default": "",
            "description": "Name of the fence method."
          },
          "devices": {
            "type": "list",
            "default": [],
            "description": "List of device names used by this method."
          }
        }
      }
    }
  },
  "global_fencedevices": {
    "type": "list",
    "default": [],
    "description": "Fencing devices defined globally for the cluster.",
    "items": {
      "name": {
        "type": "string",
        "default": "",
        "description": "Name of the fencing device."
      },
      "agent": {
        "type": "string",
        "default": "",
        "description": "Fencing agent (e.g., 'fence_scsi', 'fence_virsh')."
      },
      "options": {
        "type": "object",
        "default": {},
        "description": "Agent-specific options."
      }
    }
  },
  "rm": {
    "type": "object",
    "default": {},
    "description": "Resource manager (RM) settings \u2014 typically Pacemaker in integrated mode.",
    "items": {
      "pacemaker_startup": {
        "type": "string",
        "default": "0",
        "description": "Enable Pacemaker startup (0 = off, 1 = on)."
      },
      "pacemaker_wait_for_all": {
        "type": "bool",
        "default": true,
        "description": "Wait for all nodes before starting services."
      },
      "shutdown_timeout": {
        "type": "number",
        "default": 300,
        "description": "Timeout (seconds) for graceful shutdown of resources."
      },
      "resources": {
        "type": "list",
        "default": [],
        "description": "Resources to be managed (e.g., IPs, filesystems, services).",
        "items": {
          "type": {
            "type": "string",
            "default": "ocf:heartbeat:IPaddr2",
            "description": "Resource type, usually in agent:provider:typename format."
          },
          "id": {
            "type": "string",
            "default": "",
            "description": "Unique ID for the resource."
          },
          "attrs": {
            "type": "object",
            "default": {},
            "description": "Resource attributes (e.g., {'ip': '10.0.0.10', 'cidr_netmask': '24'})."
          },
          "meta": {
            "type": "object",
            "default": {},
            "description": "Metadata (e.g., {'priority': '100', 'resource-stickiness': '100'})."
          }
        }
      },
      "groups": {
        "type": "list",
        "default": [],
        "description": "Resource groups \u2014 collections of resources started/stopped together.",
        "items": {
          "id": {
            "type": "string",
            "default": "",
            "description": "Group name."
          },
          "preferred_node": {
            "type": "string",
            "default": "",
            "description": "Preferred node for group placement."
          },
          "priority": {
            "type": "number",
            "default": 0,
            "description": "Priority (higher = preferred)."
          },
          "resources": {
            "type": "list",
            "default": [],
            "description": "List of resource IDs in this group."
          }
        }
      },
      "failover_domains": {
        "type": "list",
        "default": [],
        "description": "Failover domains \u2014 defines which nodes can host certain resources.",
        "items": {
          "id": {
            "type": "string",
            "default": "",
            "description": "Domain name."
          },
          "ordered": {
            "type": "bool",
            "default": true,
            "description": "If true, nodes are tried in priority order."
          },
          "restricted": {
            "type": "bool",
            "default": false,
            "description": "If true, only nodes in the domain may host resources."
          },
          "preferred_node": {
            "type": "string",
            "default": "",
            "description": "Preferred node for this domain (used if ordered=true)."
          },
          "nodes": {
            "type": "list",
            "default": [],
            "description": "List of node names in domain (strings or {name,priority} objects).",
            "items": {
              "name": {
                "type": "string",
                "default": "",
                "description": "Node name."
              },
              "priority": {
                "type": "number",
                "default": 0,
                "description": "Priority for this node (lower = higher priority)."
              }
            }
          }
        }
      },
      "dlm_lockspace": {
        "type": "object",
        "default": {},
        "description": "DLM lockspace configuration for GFS2 or similar shared storage.",
        "items": {
          "name": {
            "type": "string",
            "default": "gfs",
            "description": "Lockspace name (must match filesystem name)."
          },
          "plocks": {
            "type": "bool",
            "default": true,
            "description": "Enable plock (posix lock) support."
          },
          "num_plocks": {
            "type": "number",
            "default": 1024,
            "description": "Maximum number of plocks."
          }
        }
      }
    }
  }
}
