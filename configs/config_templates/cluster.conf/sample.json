 "config_version": 25,
 "global_fencedevices": [],
 "nodes": [
  {
   "fence_methods": [
    {
     "devices": [
      "ipmi-node1"
     ],
     "name": "primary"
    }
   ],
   "fencedevices": [
    {
     "agent": "fence_ipmilan",
