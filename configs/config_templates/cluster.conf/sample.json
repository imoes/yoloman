      "login": "admin",
      "password": "secret123"
     }
    }
   ],
   "id": 1,
   "name": "node1.example.com"
  },
  {
   "fence_methods": [
    {
     "devices": [
      "ipmi-node2"
     ],
     "name": "primary"
    }
   ],
   "fencedevices": [
    {
     "agent": "fence_ipmilan",
     "name": "ipmi-node2",
     "options": {
      "auth": "md5",
      "ipaddr": "192.168.1.102",
      "login": "admin",
      "password": "secret456"
     }
    }
   ],
   "id": 2,
   "name": "node2.example.com"
  }
 ],
 "rm": {
  "dlm_lockspace": {
   "name": "gfs",
   "num_plocks": 1024,
   "plocks": true
  },
  "failover_domains": [
   {
    "id": "web-domain",
    "nodes": [
     {
      "name": "node1.example.com",
      "priority": 1
     },
     {
      "name": "node2.example.com",
      "priority": 2
     }
    ],
    "ordered": true,
    "preferred_node": "node1.example.com",
    "restricted": true
   }
  ],
  "groups": [
   {
    "id": "web-group",
    "preferred_node": "node1.example.com",
    "priority": 100,
    "resources": [
     "vip-web",
     "fs-data"
    ]
   }
  ],
  "pacemaker_startup": "1",
  "pacemaker_wait_for_all": true,
  "resources": [
   {
    "attrs": {
     "cidr_netmask": "24",
     "ip": "10.0.0.100",
     "nic": "eth0"
    },
    "id": "vip-web",
    "type": "ocf:heartbeat:IPaddr2"
   },
   {
    "attrs": {
     "device": "/dev/disk/by-uuid/a1b2c3d4",
     "directory": "/data",
     "fstype": "xfs"
    },
    "id": "fs-data",
    "meta": {
     "resource-stickiness": "100"
    },
    "type": "ocf:heartbeat:Filesystem"
   }
  ],
  "shutdown_timeout": 300
 }
