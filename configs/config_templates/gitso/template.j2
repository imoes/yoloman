# Gitso hosts configuration file
#
# This file configures the list of support addresses displayed in the
# "Enter/Select Support Address" dropdown box within the Gitso interface.
# The value must be a comma-separated list of host names and IP addresses.
#
# Example:
#   gitso_hosts: 192.168.1.10, gitso.example.com
gitso_hosts={{ gitso_hosts | default('') }}
