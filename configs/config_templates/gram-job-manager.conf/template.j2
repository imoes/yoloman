# Globus GRAM Job Manager configuration
# This file controls the behavior of the Globus GRAM Job Manager service
# See globus-gram-job-manager(8) and https:// Globus Toolkit documentation for details

# Network interface binding (host or IP); leave empty to bind to all interfaces
Host: {{ host }}

# Port on which the GRAM Job Manager listens for incoming connections
Port: {{ port }}

# Maximum number of concurrent job submission requests
MaxConnections: {{ max_connections }}

# Maximum number of concurrent job operations (e.g., cancel, status)
MaxOperations: {{ max_operations }}

# Path to the GridFTP server used for data staging (if applicable)
GridFTPServer: {{ gridftp_server }}

# Timeout (in seconds) for job submission and status queries
Timeout: {{ timeout }}

# Enable or disable detailed logging for debugging
VerboseLogging: {{ verbose_logging }}

# Directory for job spooling and temporary files
JobSpoolDir: {{ job_spool_dir }}

# Maximum number of job state records to retain in memory
JobStateCacheSize: {{ job_state_cache_size }}

# List of allowed resource managers (e.g., PBS, SLURM, Condor); each entry is a name
AllowedResourceManagers:
{% for rm in allowed_resource_managers %}  - {{ rm }}
{% endfor %}

# Optional: credential renewal configuration (GSS credential renewal via gssproxy)
UseCredentialRenewal: {{ use_credential_renewal }}

# Path to credential renewal service configuration (if enabled)
CredentialRenewalConfig: {{ credential_renewal_config }}

# List of environment variables to pass to all jobs
Environment:
{% for env in environment %}  {{ env.name }}={{ env.value }}
{% endfor %}

# Optional: list of job wrapper scripts to run before/after each job
JobWrappers:
{% for wrapper in job_wrappers %}  {{ wrapper.type }}: {{ wrapper.script }}
{% endfor %}

# Authentication method: 'proxy' (GSI), 'gridmap', or 'x509_proxy'
AuthMethod: {{ auth_method }}

# Path to proxy certificate (used only if AuthMethod = 'x509_proxy')
ProxyPath: {{ proxy_path }}

# Enable or disable job aggregation (batch submission of multiple jobs)
EnableJobAggregation: {{ enable_job_aggregation }}

# Maximum number of jobs per aggregation batch
MaxJobsPerBatch: {{ max_jobs_per_batch }}
