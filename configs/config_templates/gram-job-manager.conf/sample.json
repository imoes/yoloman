{
  "host": "",
  "port": 2119,
  "max_connections": 150,
  "max_operations": 75,
  "gridftp_server": "gridftp.example.org:2811",
  "timeout": 600,
  "verbose_logging": false,
  "job_spool_dir": "/var/lib/globus/gram_job_manager/spool",
  "job_state_cache_size": 5000,
  "allowed_resource_managers": [
    "PBS",
    "SLURM"
  ],
  "use_credential_renewal": true,
  "credential_renewal_config": "/etc/gssproxy/gssproxy.conf",
  "environment": [
    {
      "name": "LD_LIBRARY_PATH",
      "value": "/usr/lib64"
    },
    {
      "name": "PATH",
      "value": "/usr/bin:/bin"
    }
  ],
  "job_wrappers": [
    {
      "type": "pre",
      "script": "/usr/local/bin/job-prepare.sh"
    },
    {
      "type": "post",
      "script": "/usr/local/bin/job-cleanup.sh"
    }
  ],
  "auth_method": "proxy",
  "proxy_path": "",
  "enable_job_aggregation": true,
  "max_jobs_per_batch": 25
}
