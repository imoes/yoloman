# Postfix PCRE lookup table entry for shared library object permissions.
# Format: <pattern>:<type>:<user>:<group>:<permissions>
# This specific line configures the file permissions for the postfix-pcre.so shared library.

# The 'f' type indicates this rule applies to a file.
# 'root' is the user and '-' (empty) is the group, meaning the library runs as root without a specific group restriction.
# {{ permission | default('755') }} is the octal file permission mode.
$shlib_directory/postfix-pcre.so:f:root:-:{{ permission | default('755') }}
