# Mozilla OpenH264 Plugin Configuration
# This file sets the environment variable MOZ_GMP_PATH to point to the OpenH264
# GMP (Gecko Media Plugin) directory required by Mozilla Firefox/Thunderbird.

# Path to the OpenH264 GMP plugin directory.
# Default: /usr/lib64/mozilla/plugins/gmp-gmpopenh264/system-installed
MOZ_GMP_PATH="{{ mozillaopenh264_path | default('/usr/lib64/mozilla/plugins/gmp-gmpopenh264/system-installed') }}"
export MOZ_GMP_PATH
