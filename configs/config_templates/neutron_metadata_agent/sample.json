{
  "metadata_bind_host": "0.0.0.0",
  "metadata_bind_port": 9697,
  "neutron_config_file": "/etc/neutron/neutron.conf",
  "nova_metadata_ini": "/etc/nova/nova.conf",
  "metadata_proxy_shared_secret": "neutron-metadatasecret",
  "enable_metadata_proxy": true,
  "workers": 2,
  "rpc_workers": 1,
  "log_file": "/var/log/neutron/metadata-agent.log",
  "log_dir": "/var/log/neutron",
  "debug": false,
  "verbose": true,
  "log_format": "%(asctime)s %(levelname)8s [%(name)s] %(message)s",
  "log_date_format": "%Y-%m-%d %H:%M:%S",
  "debug_loggers": [
    "neutron.plugins.ml2",
    "neutron.agent.metadata"
  ],
  "metadata_workers": 2,
  "metadata_service_ssl": false,
  "metadata_service_ca_cert": "",
  "metadata_service_cert": "",
  "metadata_service_key": "",
  "metadata_proxy_healthcheck_interval": 60,
  "metadata_proxy_healthcheck_timeout": 10,
  "metadata_proxy_max_retries": 3,
  "metadata_proxy_retry_delay": 2,
  "use_ssl_with_nova": false,
  "nova_metadata_insecure": true,
  "nova_metadata_client_cert": "",
  "nova_metadata_client_key": "",
  "nova_metadata_ca_cert": "",
  "metadata_cache_enabled": true,
  "metadata_cache_memcached_servers": [
    "127.0.0.1:11211"
  ],
  "metadata_cache_ttl": 300,
  "agent_report_interval": 30
}
