<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fontconfig substitution and alias rules for Google Noto Sans Sinhala VF.
  This template configures two distinct behaviors:
  1. Substitution: When an application requests a language-specific match (lang=si)
     against a generic family (sans-serif), insert 'Noto Sans Sinhala' at the front
     of the available font list.
  2. Alias: If a direct request is made for 'Noto Sans Sinhala', redirect it to
     the generic sans-serif family (or vice versa, depending on mode, though here
     it acts as a standard alias definition).
-->
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!--
    Rule: Font Substitution for Sinhala Language
    Matches documents/requests specifying the Sinhala language code.
  -->
  <match>
    <!--
      Test: Check if the target language contains the specified ISO 639 code.
      Default: 'si' (ISO 639-1 code for Sinhala).
    -->
    <test name="lang" compare="contains">
      <string>{{ lang_code | default('si') }}</string>
    </test>

    <!--
      Test: Check if the requested font family is the specified generic fallback.
      Default: 'sans-serif'.
    -->
    <test name="family">
      <string>{{ fallback_family | default('sans-serif') }}</string>
    </test>

    <!--
      Edit: Prepend the specific Noto Sans Sinhala font to the matching list.
      This ensures the correct script font is chosen for the generic family.
      Default: 'Noto Sans Sinhala'.
    -->
    <edit name="family" mode="prepend">
      <string>{{ font_family_name | default('Noto Sans Sinhala') }}</string>
    </edit>

    <!--
      Edit: Toggle font hinting settings for this specific match.
      Hinting improves font rendering at small sizes on LCD screens.
      Default: 'true' (converted from string to boolean).
    -->
    <edit name="fonthashint" mode="append">
      <bool>{{ enable_hinting | default(true) | bool }}</bool>
    </edit>
  </match>

  <!--
    Rule: Font Alias Definition
    Defines an alias between the specific Noto font and the generic family.
    This ensures applications asking for 'sans-serif' can find the Noto font,
    and vice-versa, depending on how the client resolves families.
  -->
  <alias>
    <!--
      The specific font family name being aliased.
      Default: 'Noto Sans Sinhala'.
    -->
    <family>{{ font_family_name | default('Noto Sans Sinhala') }}</family>
    <default>
      <!--
        The generic font family to use as the default/alias target.
        Default: 'sans-serif'.
      -->
      <family>{{ fallback_family | default('sans-serif') }}</family>
    </default>
  </alias>
</fontconfig>
