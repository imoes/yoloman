# System-wide configuration for rlpr client
# Location: {{ config_dir | default('/etc', true) }}/rlprrc
#
# This file controls default behavior for the rlpr printing client.
# Variables are mapped to environment variables and rlpr command-line options.

# Directory containing the system-wide rlprrc file
# Schema: config_dir
# Default: /etc
# Note: This variable determines the directory path where this config resides.
# It is also used in the comment header above to show the full path.
config_dir={{ config_dir | default('/etc', true) }}

# Default printer queue name, optionally followed by @hostname
# Corresponds to PRINTER/LPDEST environment variables
# Schema: printer
# Default: ''
PRINTER={{ printer | default('', true) }}

# Default host to print to if not specified in PRINTER variable
# Corresponds to RLPR_PRINTHOST environment variable
# Schema: printhost
# Default: ''
RLPR_PRINTHOST={{ printhost | default('', true) }}

# Default proxy host to use for privileged port forwarding
# Corresponds to RLPR_PROXYHOST environment variable
# Only required if rlpr is not setuid root and remote lpd requires privileged ports
# Schema: proxyhost
# Default: ''
RLPR_PROXYHOST={{ proxyhost | default('', true) }}

# Number of copies to print by default
# Corresponds to -# / --copies option
# Schema: copies
# Default: 1
RLPR_COPIES={{ copies | default(1, true) }}

# Temporary directory for job control/data files
# Corresponds to TMPDIR environment variable
# Schema: tmpdir
# Default: /tmp
TMPDIR={{ tmpdir | default('/tmp', true) }}

# Inactivity timeout in seconds (-1 for infinite)
# Corresponds to --timeout option
# Schema: timeout
# Default: 3
RLPR_TIMEOUT={{ timeout | default(3, true) }}

# User name displayed on burst pages
# Corresponds to -U / --user option
# Schema: user
# Default: ''
RLPR_USER={{ user | default('', true) }}

# Job name displayed on burst pages
# Corresponds to -J / --job option
# Schema: job
# Default: ''
RLPR_JOB={{ job | default('', true) }}

# Title used in pr(1) headers on burst pages
# Corresponds to -T / --title option
# Schema: title
# Default: ''
RLPR_TITLE={{ title | default('', true) }}

# Class name displayed on burst pages
# Corresponds to -C / --class option
# Schema: class
# Default: ''
RLPR_CLASS={{ class | default('', true) }}

# Indentation width in columns
# Corresponds to -i / --indent option
# Schema: indent
# Default: 8
RLPR_INDENT={{ indent | default(8, true) }}

# Page width for pr(1) formatting
# Corresponds to -w / --width option
# Schema: width
# Default: 72
RLPR_WIDTH={{ width | default(72, true) }}

# OS-specific extension mode (e.g., hpux, none)
# Corresponds to RLPR_EXTENSION environment variable
# Schema: extension
# Default: none
RLPR_EXTENSION={{ extension | default('none', true) }}

# OS-specific extension arguments string
# Corresponds to RLPR_EXTARGS environment variable
# Schema: extargs
# Default: ''
RLPR_EXTARGS={{ extargs | default('', true) }}