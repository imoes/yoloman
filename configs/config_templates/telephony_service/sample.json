{
  "enabled": true,
  "pid_file": "/run/lomiri/telephony-service.pid",
  "user": "telephony",
  "group": "telephony",
  "log_level": 2,
  "log_dir": "/var/log/telephony",
  "syslog": true,
  "dialer_enabled": true,
  "call_limit": 2,
  "outgoing_timeout": 45,
  "max_dial_retries": 3,
  "ril_backend": "qmi",
  "ril_device": "/dev/ttyUSB2",
  "default_apn": "internet",
  "apn_auth_type": "none",
  "apn_username": "",
  "apn_password": "",
  "ussd_enabled": true,
  "sms_enabled": true,
  "sms_store_path": "/var/lib/telephony/sms",
  "max_sms_retain": 500,
  "smsc": "",
  "delivery_reports": true,
  "gnss_enabled": false,
  "gnss_device": "/dev/ttyO1",
  "nmea_rate": 1,
  "gnss_timeout": 30,
  "mobile_data_auto_connect": false,
  "mobile_data_background": true
}
