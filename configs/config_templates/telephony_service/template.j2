# Telephony Service Configuration — Lomiri
# Main configuration file for the telephony service daemon

[service]
# Enable or disable the telephony service
enabled = {{ enabled }}

# Path to the PID file
pid_file = {{ pid_file }}

# User and group to run the service as
user = {{ user }}
group = {{ group }}

# Logging verbosity: 0=error, 1=warn, 2=info, 3=debug
log_level = {{ log_level }}

# Log directory
log_dir = {{ log_dir }}

# Path to the system log (e.g., syslog socket or journal)
syslog = {{ syslog }}

[dialer]
# Enable dialer integration
enabled = {{ dialer_enabled }}

# Maximum concurrent active calls
call_limit = {{ call_limit }}

# Timeout (in seconds) before aborting an outgoing call attempt
outgoing_timeout = {{ outgoing_timeout }}

# Maximum number of retries for dialing
max_dial_retries = {{ max_dial_retries }}

[ril]
# RIL backend type (e.g., 'qmi', 'at', 'uim', 'mock')
backend = {{ ril_backend }}

# Path to the RIL device (e.g., /dev/ttyUSB2)
device = {{ ril_device }}

# APN for default data connection
default_apn = {{ default_apn }}

# APN authentication type: 'none', 'pap', 'chap', 'pap_or_chap'
apn_auth_type = {{ apn_auth_type }}

# APN username and password (leave blank if not needed)
apn_username = {{ apn_username }}
apn_password = {{ apn_password }}

[ussd]
# Enable USSD support
enabled = {{ ussd_enabled }}

[sms]
# Enable SMS handling
enabled = {{ sms_enabled }}

# Storage path for SMS messages
store_path = {{ sms_store_path }}

# Maximum SMS messages to retain
max_sms_retain = {{ max_sms_retain }}

# SMSC number (use default if empty)
smsc = {{ smsc }}

# Delivery report preference: true or false
delivery_reports = {{ delivery_reports }}

[gnss]
# Enable GNSS (GPS) support for call定位
enabled = {{ gnss_enabled }}

# Location of NMEA serial device (e.g., /dev/ttyO1)
device = {{ gnss_device }}

# NMEA update rate in seconds (min: 1, max: 10)
nmea_rate = {{ nmea_rate }}

# Timeout (in seconds) before GNSS times out on fix
timeout = {{ gnss_timeout }}

[mobile_data]
# Auto-connect to default APN on boot
auto_connect = {{ mobile_data_auto_connect }}

# Enable background data usage (e.g., for push notifications)
background_data = {{ mobile_data_background }}
