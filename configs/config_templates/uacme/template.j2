# ==============================================================================
# UACME Configuration File
# ==============================================================================
# This file is generated by Ansible. Do NOT edit manually.
# Schema: uacme package configuration.
# Format: INI-like structure with [identifier N] sections for certificate targets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Global Settings
# ------------------------------------------------------------------------------

# confdir: Configuration directory for keys and certificates.
# Path: confdir
confdir = {{ confdir | default('/etc/ssl/uacme') }}

# ca_url: ACMEv2 server directory object URL.
# If empty, the client selects the URL based on staging_mode.
# Path: canonical_acme_url
canonical_acme_url = {{ ca_url | default('') }}

# staging_mode: Use Let's Encrypt staging URL for testing.
# Path: staging_mode
staging_mode = {{ staging_mode | default(false) | lower }}

# acme_account_email: Email contact for the ACME account.
# Used for account creation and recovery notifications.
# Path: acme_account_email
acme_account_email = {{ acme_account_email | default('admin@example.com') }}

# key_type: Key type for newly generated keys.
# Allowed values: RSA, EC.
# Path: key_type
key_type = {{ key_type | default('RSA') }}

# key_bits: Key bit length.
# For RSA: 2048-8192. For EC: 256 or 384.
# Path: key_bits
key_bits = {{ key_bits | default(2048) }}

# external_account_binding: RFC8555 External Account Binding credentials.
# Format: KEYID:KEY. Leave empty if not required by the CA.
# Path: external_account_binding
external_account_binding = {{ external_account_binding | default('') }}

# days_until_reissue: Do not reissue certificates valid for longer than this many days.
# This sets a safety margin for renewal.
# Path: days_until_reissue
days_until_reissue = {{ days_until_reissue | default(30) }}

# disable_ari: Do not query or use the server's certificate renewal information window.
# Path: disable_ari
disable_ari = {{ disable_ari | default(false) | lower }}

# disable_ocsp: Disable OCSP checking before reissuance.
# Path: disable_ocsp
disable_ocsp = {{ disable_ocsp | default(false) | lower }}

# must_staple: Request certificates with the OCSP Must-Staple extension.
# Path: must_staple
must_staple = {{ must_staple | default(false) | lower }}

# hook_program: Challenge hook program path.
# This script is executed during challenge validation (begin/done/failed).
# Leave empty to disable hooks.
# Path: hook_program
hook_program = {{ hook_program | default('') }}

# ------------------------------------------------------------------------------
# Identifier Definitions
# ------------------------------------------------------------------------------
# identifiers: List of identifiers to issue certificates for.
# Each entry defines a primary name and optional SANs (altnames).
{% set ids = identifiers | default([]) %}
{% for item in ids %}
[identifier {{ loop.index0 }}]
# name: The primary domain name for this certificate.
name = {{ item.name | default('') }}

{% if item.altnames is defined and item.altnames %}
# altnames: Additional Subject Alternative Names (SANs).
# Comma-separated list of domain names.
altnames = {{ item.altnames | join(', ') }}
{% endif %}
{% endfor %}

# ------------------------------------------------------------------------------
# Network Settings
# ------------------------------------------------------------------------------

# dns_servers: Comma separated list of DNS servers.
# Overrides system default DNS servers for ACME DNS challenges.
# Path: dns_servers
dns_servers = {{ dns_servers | default('') }}

# proxy_url: Proxy URL.
# HTTP/HTTPS proxy address for ACME requests.
# Path: proxy_url
proxy_url = {{ proxy_url | default('') }}