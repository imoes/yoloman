# =============================================================================
# HSTR (History Search Tool) Configuration
# =============================================================================
# This template configures the hstr shell function which provides
# interactive history search and suggestions.
#
# The configuration is split into environment variables (HSTR_CONFIG,
# HSTR_PROMPT) written to an export script, and a blacklist file
# (HSTR_BLACKLIST).
# =============================================================================

# --- Environment Variables ---

# HSTR_CONFIG
# Description: Comma-separated list of HSTR_CONFIG options controlling UI and behavior.
# Options include: hicolor, monochromatic, prompt-bottom, help-on-opposite,
# highlight-color, smartcase, fuzzy-matching, etc.
# See: https://hstr.dvorka.net/hstr_manpage.html#ENVIRONMENT_VARIABLES
# Default: ['hicolor', 'regexp-matching']
export HSTR_CONFIG="{{ hstr_config | default(['hicolor', 'regexp-matching']) | join(',') }}"

# HSTR_PROMPT
# Description: The string displayed as the prompt in the hstr suggestion box.
# Defaults to user@host$ in application, but often customized for brevity.
# See: https://hstr.dvorka.net/hstr_manpage.html#ENVIRONMENT_VARIABLES
# Default: '$ '
export HSTR_PROMPT="{{ hstr_prompt | default('$ ') }}"

# --- Blacklist File ---

# HSTR_BLACKLIST
# Description: List of command strings or patterns to blacklist. These commands
# will not be suggested by hstr. Written to ~/.hstr_blacklist.
# Items must be newline-separated in the file.
# See: https://hstr.dvorka.net/hstr_manpage.html#FILES
# Default: []
{% for item in hstr_blacklist | default([]) %}{{ item }}
{% endfor %}