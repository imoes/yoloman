{# cmigemo configuration file #}
{# This template generates the command-line arguments for cmigemo. #}
{# cmigemo is a reverse incremental search tool for Japanese text, #}
{# often used in Emacs/Emacsen or other text editors. #}

{# cli_options: List of command-line options (strings) to pass to cmigemo. #}
{# Each item must be a valid CLI argument as per cmigemo(1). Order matters. #}
{# Defaults to an empty list if not provided. #}
{% for option in cli_options | default([], true) %}
{{ option }}
{% endfor %}