# Synapse configuration file
# This file controls the initial behavior of the Synapse Matrix homeserver.

# startup_mode: If true, Synapse will hide its UI until activated by a global hotkey.
# This is useful for headless installations or when the web client is not needed immediately.
# Accepts boolean values (true/false, yes/no, 1/0).
startup: {{ startup_mode | default(false) | lower }}