{
 "data_dir": "/var/lib/ddupdate",
 "debug": false,
 "enable_ipv6": true,
 "global_options": {
  "default_password": "secure_password_here",
  "default_user": "admin@example.com"
 },
 "hosts": [
  {
   "address_source": "web",
   "address_type": "ipv4",
   "hostname": "www.example.com",
   "plugin": "cloudflare",
   "provider": "cloudflare_main"
  },
  {
   "address_source": "default",
   "address_type": "ipv6",
   "hostname": "api.example.com",
   "provider": "cloudflare_main"
  },
  {
   "address_source": "ifconfig",
   "address_type": "dual",
   "hostname": "test.example.org",
   "provider": "dnsimple_test"
  }
 ],
 "log_file": "/var/log/ddupdate.log",
 "log_level": "info",
 "network_timeout": 30,
 "plugin_dir": "/usr/lib/ddupdate",
 "policy": "first_ok",
 "services": [
  {
   "name": "cloudflare_main",
   "options": {
    "api_key": "secret_cloudflare_api_key",
    "zone": "example.com"
   },
   "plugin": "cloudflare"
  },
  {
   "name": "dnsimple_test",
   "options": {
    "account_id": "98765",
    "api_token": "dnsimple_token_123"
   },
   "plugin": "dnsimple"
  }
 ]
}
