#
# list of accepted/preferred character encodings
#
# Syntax:
#
# charset/encoding      = ? result
#
# Note: charsets and results are lowercase, actions are uppercase
#
# ? indicates the action to take:
# 1: OK, character supported
# A: OK, character supported, Encode::Alias it to result
# X: frequent error, e.g. starting with x-; ask user to replace with result
# ERR: a charset we refuse, per some policy. Reason stated after ERR

#e.g:
# utf-8         = 1
# some-alias    = A perl-Encode-name
# odd-alias     = X good-alias
# bad_charset   = ERR explain reason

{{ utf8_encoding }}                           = 1
{{ utf16_encoding }}                          = 1
{{ utf16be_encoding }}                        = 1
{{ utf16le_encoding }}                        = 1
{{ iso8859_1_encoding }}                      = 1
{{ iso8859_2_encoding }}                      = 1
{{ iso8859_3_encoding }}                      = 1
{{ iso8859_4_encoding }}                      = 1
{{ iso8859_5_encoding }}                      = 1
{{ iso8859_6_encoding }}                      = 1
# implicit bidi, but character encoding is the same
{{ iso8859_6_i_encoding }}                    = A iso-8859-6
{{ iso8859_7_encoding }}                      = 1
{{ iso8859_8_encoding }}                      = 1
# implicit bidi, but character encoding is the same
{{ iso8859_8_i_encoding }}                    = A iso-8859-8
{{ iso8859_9_encoding }}                      = 1
{{ iso8859_10_encoding }}                     = 1
{{ iso8859_11_encoding }}                     = 1
# iso-8859-12 doesn't exist (yet?)
{{ iso8859_13_encoding }}                     = 1
{{ iso8859_14_encoding }}                     = 1
{{ iso8859_15_encoding }}                     = 1
{{ iso8859_16_encoding }}                     = 1
{{ us_ascii_encoding }}                       = 1
{{ iso2022_jp_encoding }}                     = 1
{{ shift_jis_encoding }}                      = 1
{{ euc_jp_encoding }}                         = 1
{{ gb2312_encoding }}                         = 1
{{ big5_encoding }}                           = 1
{{ big5_hkscs_encoding }}                     = 1
{{ iso2022_kr_encoding }}                     = 1
{{ euc_kr_encoding }}                         = 1
{{ gb18030_encoding }}                        = 1
# 0xA0 is U+00A0 in ISO-8859-11 but undefined in tis-620
# other than that the character encodings are equivalent
{{ tis620_encoding }}                         = A iso-8859-11
{{ koi8_r_encoding }}                         = 1
{{ koi8_u_encoding }}                         = 1
{{ iso_ir_111_encoding }}                     = 1
{{ windows_1250_encoding }}                   = 1
{{ windows_1251_encoding }}                   = 1
{{ windows_1252_encoding }}                   = 1
{{ windows_1253_encoding }}                   = 1
{{ windows_1254_encoding }}                   = 1
{{ windows_1255_encoding }}                   = 1
{{ windows_1256_encoding }}                   = 1
{{ windows_1257_encoding }}                   = 1
# windows-1258                  = 1
# Encode::Byte does not know 'macintosh' but MacRoman
{{ macintosh_encoding }}                      = A MacRoman
{{ ks_c_5601_1987_encoding }}                 = 1
# Encode only knows the long hand version of 'ksc_5601'
{{ ksc_5601_encoding }}                       = A KS_C_5601-1987

{{ x_mac_roman_encoding }}                     = X macintosh
{{ x_sjis_encoding }}                          = X shift_jis
{{ iso8859_1_x_encoding }}                     = X iso-8859-1
{{ ascii_x_encoding }}                         = X us-ascii
{{ 8859_1_x_encoding }}                        = X iso-8859-1
# this one is in IANA, but better use only windows-1252
{{ iso8859_1_windows_3_1_x_encoding }}         = X windows-1252
