{
  "local_enable": true,
  "write_enable": true,
  "anon_root": "/srv/ftp",
  "chroot_local_user": true,
  "chroot_list_enable": true,
  "chroot_list_file": "/etc/vsftpd.chroot_list",
  "listen": true,
  "listen_port": 21,
  "listen_ipv6": false,
  "pasv_enable": true,
  "pasv_min_port": 10090,
  "pasv_max_port": 10100,
  "max_clients": 50,
  "max_per_ip": 5,
  "idle_session_timeout": 600,
  "data_connection_timeout": 120,
  "ftpd_banner": "Welcome to secure FTP service.",
  "userlist_enable": true,
  "userlist_file": "/etc/vsftpd.user_list",
  "userlist_deny": true,
  "ssl_enable": true,
  "ssl_certificate": "/etc/ssl/certs/vsftpd.crt",
  "ssl_key": "/etc/ssl/private/vsftpd.key",
  "ssl_ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "ssl_require_ssl": true,
  "ssl_tlsv1": true,
  "ssl_sslv2": false,
  "ssl_sslv3": false,
  "xferlog_enable": true,
  "xferlog_std_format": false,
  "xferlog_file": "/var/log/vsftpd.log",
  "anon_upload_enable": false,
  "anon_mkdir_write_enable": false,
  "anon_other_write_enable": false,
  "anon_world_readable_only": true,
  "local_umask": "022",
  "virtual_use_local_privs": false,
  "anon_umask": "077",
  "file_open_mode": "0644",
  "tcp_wrappers": true,
  "pam_service_name": "vsftpd",
  "hide_ids": false,
  "local_root": "",
  "user_config_dir": "/etc/vsftpd/user_conf",
  "ascii_upload_enable": false,
  "ascii_download_enable": false,
  "syslog_enable": false,
  "connect_timeout": 60
}
