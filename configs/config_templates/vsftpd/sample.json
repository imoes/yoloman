{
  "local_enable": true,
  "write_enable": true,
  "anon_root": "/srv/ftp",
  "chroot_local_user": true,
  "chroot_list_enable": false,
  "chroot_list_file": "/etc/vsftpd.chroot_list",
  "listen": true,
  "listen_port": 21,
  "listen_ipv6": false,
  "pasv_enable": true,
  "pasv_min_port": 10090,
  "pasv_max_port": 10100,
  "max_clients": 0,
  "max_per_ip": 0,
  "idle_session_timeout": 300,
  "data_connection_timeout": 120,
  "ftpd_banner": "Welcome to FTP service.",
  "userlist_enable": true,
  "userlist_file": "/etc/vsftpd.user_list",
  "userlist_deny": true,
  "ssl_enable": false,
  "ssl_certificate": "/etc/ssl/certs/vsftpd.crt",
  "ssl_key": "/etc/ssl/private/vsftpd.key",
  "ssl_ciphers": "HIGH:!aNULL:!MD5",
  "log_file": "/var/log/vsftpd.log"
}
