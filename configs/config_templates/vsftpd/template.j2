# Allow local users to log in
local_enable={{ local_enable }}

# Enable writing (upload, delete, etc.)
write_enable={{ write_enable }}

# Directory where anonymous users are chrooted
anon_root={{ anon_root }}

# Directory where local users are chrooted to their home dir (set to empty to disable)
chroot_local_user={{ chroot_local_user | string | lower }}

# List of users *not* subject to chroot (if chroot_local_user=NO, this is ignored)
chroot_list_enable={{ chroot_list_enable }}
chroot_list_file={{ chroot_list_file }}

# Listen on IPv4 (set to YES if running standalone, NO if managed by inetd/xinetd)
listen={{ listen }}

# Port to listen on
listen_port={{ listen_port }}

# Passive mode ports range (firewall-friendly)
listen_ipv6={{ listen_ipv6 | string | lower }}
pasv_enable={{ pasv_enable }}
pasv_min_port={{ pasv_min_port }}
pasv_max_port={{ pasv_max_port }}

# Maximum number of clients (0 = unlimited)
max_clients={{ max_clients }}

# Maximum connections per IP (0 = unlimited)
max_per_ip={{ max_per_ip }}

# Login session idle timeout (seconds)
idle_session_timeout={{ idle_session_timeout }}

# Data connection timeout (seconds)
data_connection_timeout={{ data_connection_timeout }}

# Banner shown before login
ftpd_banner={{ ftpd_banner }}

# Reject certain user logins (list of usernames, one per line in this file)
userlist_enable={{ userlist_enable }}
userlist_file={{ userlist_file }}

# If YES, deny users listed in userlist_file; if NO, allow only those listed
userlist_deny={{ userlist_deny }}

# Enable TLS/SSL encryption (requires certificate and key)
ssl_enable={{ ssl_enable }}
{% if ssl_enable %}
{% if ssl_certificate %}ssl_cert={{ ssl_certificate }}
{% endif %}
{% if ssl_key %}ssl_key={{ ssl_key }}
{% endif %}
{% if ssl_ciphers %}ssl_ciphers={{ ssl_ciphers }}
{% endif %}
ssl_require_ssl={{ ssl_require_ssl }}
ssl_tlsv1={{ ssl_tlsv1 }}
ssl_sslv2={{ ssl_sslv2 }}
ssl_sslv3={{ ssl_sslv3 }}
{% endif %}

# Log connections and operations (YES/NO)
xferlog_enable={{ xferlog_enable }}
{% if xferlog_enable %}
xferlog_std_format={{ xferlog_std_format }}
xferlog_file={{ xferlog_file }}
{% endif %}

# Allow anonymous login (if YES, anon_root must be set)
anon_upload_enable={{ anon_upload_enable }}
anon_mkdir_write_enable={{ anon_mkdir_write_enable }}
anon_other_write_enable={{ anon_other_write_enable }}
anon_world_readable_only={{ anon_world_readable_only }}

# Local umask for uploaded files
local_umask={{ local_umask }}

# Enable virtual users (requires PAM configuration)
virtual_use_local_privs={{ virtual_use_local_privs }}

# Default umask for anonymous users
anon_umask={{ anon_umask }}

# Directory permissions for newly created files (octal)
file_open_mode={{ file_open_mode }}

# TCP wrappers support (YES/NO)
tcp_wrappers={{ tcp_wrappers }}

# Enable PAM authentication (used for virtual users)
pam_service_name={{ pam_service_name }}

# Hide user IDs in listings (shows 'ftp' instead of real user)
hide_ids={{ hide_ids }}

# Root directory for virtual users (if using virtual users)
local_root={{ local_root }}

# Allow user-specific config files (e.g., /etc/vsftpd/user_conf/<username>)
user_config_dir={{ user_config_dir }}

# Enable ASCII upload/download (if NO, transfers raw binary)
ascii_upload_enable={{ ascii_upload_enable }}
ascii_download_enable={{ ascii_download_enable }}

# Log to syslog instead of file
syslog_enable={{ syslog_enable }}

# Connection rate limit (connections per second)
connect_timeout={{ connect_timeout }}
