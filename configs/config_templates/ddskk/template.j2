;;; 50ddskk.el --- Debian ddskk startup file -*-mode: emacs-lisp;-*-
;;;
;;; Self-documenting configuration template for ddskk (Daijisen SKK).
;;; Generated by Ansible. Do not edit manually.
;;;
;;; Fields mapped from schema:
;;; - ddskk_lispdir_name: Name of the ddskk subdirectory under site-lisp
;;; - ddskk_server_host: Default SKK server host to connect to
;;; - ddskk_cdb_large_jisyo_path: Path to the large SKK CDB dictionary file
;;; - ddskk_tut_file_path: Path to the SKK tutorial file

;;; Code:

(let* ((flavor-name (if (boundp 'debian-emacs-flavor)
                       (symbol-name debian-emacs-flavor)
                     "emacs"))
       ;; ddskk_lispdir_name: Name of the ddskk subdirectory under site-lisp (e.g., 'ddskk')
       ;; The path is constructed by concatenating the flavor-specific site-lisp directory
       ;; with the configured ddskk subdirectory name.
       (lispdir (concat "/usr/share/" flavor-name "/site-lisp/" "{{ ddskk_lispdir_name | default('ddskk') }}")))
  (when (and (featurep 'mule) (file-exists-p (concat lispdir "/skk.elc")))
    (if (fboundp 'debian-pkg-add-load-path-item)
        (debian-pkg-add-load-path-item lispdir)
      (setq load-path (cons lispdir load-path)))
    ;; Load ddskk's skk-autoloads instead of the others.
    (load (concat lispdir "/skk-autoloads.elc") 'noerror 'nomessage)
    (require 'skk-setup)
    (add-hook 'minibuffer-setup-hook
              (function (lambda ()
                          (and (boundp 'skk-henkan-okuri-strictly)
                               skk-henkan-okuri-strictly
                               (not (eq last-command 'skk-purge-jisyo))
                               (put 'skk-henkan-okuri-strictly 'temporary-nil t)
                               (setq skk-henkan-okuri-strictly nil)))))
    (add-hook 'minibuffer-exit-hook
              (function (lambda ()
                          (and (get 'skk-henkan-okuri-strictly 'temporary-nil)
                               (setq skk-henkan-okuri-strictly t)
                               (put 'skk-henkan-okuri-strictly 'temporary-nil nil)))))
    (defalias 'skk-toggle-kana 'skk-toggle-characters)
    
    ;; ddskk_server_host: Default SKK server host to connect to (used as fallback when SKKSERVER env var is not set)
    ;; This variable sets the default SKK server address. It can be overridden at runtime by the
    ;; SKKSERVER environment variable. The value is quoted as a Lisp string literal.
    (setq skk-server-host (or (getenv "SKKSERVER") "{{ ddskk_server_host | default('127.0.0.1') }}"))
    
    ;; ddskk_cdb_large_jisyo_path: Path to the large SKK CDB dictionary file
    ;; If the large dictionary file exists at the specified path, it is set as the large jisyo variable.
    ;; The path is quoted as a Lisp string literal.
    {% if ddskk_cdb_large_jisyo_path is defined %}
    (if (file-exists-p "{{ ddskk_cdb_large_jisyo_path | default('/usr/share/skk/SKK-JISYO.cdb') }}")
        (setq skk-cdb-large-jisyo "{{ ddskk_cdb_large_jisyo_path | default('/usr/share/skk/SKK-JISYO.cdb') }}"))
    {% else %}
    ;; Default behavior: no large jisyo file configured or path is empty/undefined.
    ;; If a default path was intended, uncomment the line below.
    ;;(setq skk-cdb-large-jisyo "/usr/share/skk/SKK-JISYO.cdb")
    {% endif %}
    
    ;; ddskk_tut_file_path: Path to the SKK tutorial file
    ;; Sets the path to the SKK tutorial file. The value is quoted as a Lisp string literal.
    (setq skk-tut-file "{{ ddskk_tut_file_path | default('/usr/share/skk/SKK.tut') }}"))

;;; 50ddskk.el ends here