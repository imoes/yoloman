# /etc/yacpi.conf
# Configuration file for yacpi

# If true, outputs plain text instead of using the ncurses interface.
# Default: false
{% if (display_plain_text | default(false)) %}
display = plain-text
{% else %}
display = ncurses
{% endif %}

# Delay in seconds between updates when in loop mode.
# Default: 1
loop_interval = {{ loop_interval | default(1) }}

# Enable display of battery status information.
# Default: true
{% if (show_battery | default(true)) %}
show_battery = yes
{% else %}
show_battery = no
{% endif %}

# Enable display of AC adapter status information.
# Default: true
{% if (show_ac | default(true)) %}
show_ac = yes
{% else %}
show_ac = no
{% endif %}

# Enable display of fan speed/temperature information.
# Default: true
{% if (show_fan | default(true)) %}
show_fan = yes
{% else %}
show_fan = no
{% endif %}

# Enable display of thermal zone temperature information.
# Default: true
{% if (show_thermal | default(true)) %}
show_thermal = yes
{% else %}
show_thermal = no
{% endif %}

# Enable display of current CPU frequency.
# Default: true
{% if (show_cpu_freq | default(true)) %}
show_cpu_freq = yes
{% else %}
show_cpu_freq = no
{% endif %}

# Enable display of the current CPU scaling governor.
# Default: true
{% if (show_governor | default(true)) %}
show_governor = yes
{% else %}
show_governor = no
{% endif %}

# Display ACPI data that is typically hidden or marked as not found.
# Default: false
{% if (show_not_found | default(false)) %}
show_not_found = yes
{% else %}
show_not_found = no
{% endif %}