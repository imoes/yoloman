; The OQGraph plugin allows MariaDB to use graph-structured tables for traversing relationships.
; This configuration instructs the server to load the specified plugin library at startup.
[mariadb]
; oqgraph_plugin_name: The OQGraph plugin library name to load.
; Default is 'ha_oqgraph.so'.
plugin-load-add={{ oqgraph_plugin_name | default('ha_oqgraph.so') }}
