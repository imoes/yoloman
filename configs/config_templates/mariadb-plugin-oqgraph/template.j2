# MariaDB Plugin Configuration for OQGraph
# This file configures the MariaDB server to load the OQGraph plugin,
# which enables querying graph data structures.

[mariadb]
# oqgraph_plugin_name: The OQGraph plugin library name to load.
# Defaults to 'ha_oqgraph.so' for standard MariaDB installations.
plugin-load-add={{ oqgraph_plugin_name | default('ha_oqgraph.so') }}