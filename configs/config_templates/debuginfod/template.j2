# Base directory for storing debuginfo caches
BASE_CACHE_DIR={{ base_cache_dir }}

# Base directory for temporary files (e.g., during download/upload)
TMP_DIR={{ tmp_dir }}

# HTTP listen address (IPv4 or IPv6, with optional port)
LISTEN={{ listen_address }}:{{ listen_port }}

# Number of worker threads for processing requests
WORKER_COUNT={{ worker_count }}

# Maximum number of concurrently open connections
MAX_CONNECTIONS={{ max_connections }}

# Enable compression of debuginfo files (gzip) on the wire
COMPRESSION={{ compression | string | lower }}

# Enable HTTP/2 support (requires TLS or reverse proxy)
HTTP2={{ http2 | string | lower }}

# Enable HTTPS using the provided certificate and key (if empty, HTTP only)
HTTPS_CERT={{ https_cert_path }}
HTTPS_KEY={{ https_key_path }}

# Root path for API endpoints (e.g., /debuginfo/elf/filehash)
API_ROOT={{ api_root_path }}

# Timeout (seconds) for upstream debuginfo fetch (e.g., from distro repos)
UPSTREAM_TIMEOUT={{ upstream_timeout }}

# Maximum time (seconds) a file can remain in the cache without access
CACHE_MAX_AGE={{ cache_max_age }}

# Minimum free disk space (in bytes); server refuses uploads below this
MIN_FREE_SPACE={{ min_free_space }}

# Maximum total cache size (in bytes); old files are evicted as needed
MAX_CACHE_SIZE={{ max_cache_size }}

# Log level: one of 'debug', 'info', 'notice', 'warning', 'error', 'crit', 'alert', 'emerg'
LOG_LEVEL={{ log_level }}

# Optional upstream repository sources (comma-separated list of base URLs)
UPSTREAM_SOURCES={{ upstream_sources | join(', ') }}

# Enable database indexing for efficient lookups (requires SQLite backend)
ENABLE_DB={{ enable_db | string | lower }}

# Path to SQLite database (used only if ENABLE_DB=true)
DB_PATH={{ db_path }}

# Optional rate-limiting: max requests per IP per minute
RATE_LIMIT_PER_MIN={{ rate_limit_per_min }}

# Allow cross-origin requests from these origins (comma-separated; '*' for all)
CORS_ORIGINS={{ cors_origins | join(', ') }}

# Enable metrics endpoint at /metrics (prometheus format)
METRICS={{ metrics | string | lower }}

# Enable health check endpoint at /healthz
HEALTHZ={{ healthz | string | lower }}
