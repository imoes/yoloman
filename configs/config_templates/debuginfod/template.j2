# ==============================================================================
# Configuration file for debuginfod server
# This file controls the behavior of the debuginfod service, including caching,
# listening addresses, database paths, and operational limits.
# ==============================================================================

# Base directory for storing debuginfo caches ($DEBUGINFOD_CACHE_PATH).
# If empty, the application will determine the default location.
BASE_CACHE_DIR={{ base_cache_dir | default('') }}

# File system to be used for temporary files ($TMPDIR).
TMP_DIR={{ tmp_dir | default('/tmp') }}

# HTTP listen port and address.
# Format: IP:Port. Both IPv4 and IPv6 sockets are opened if possible.
# listen_address defaults to 0.0.0.0 (all interfaces).
# listen_port defaults to 8002.
# Note: We construct the LISTEN directive here using the address and port fields.
LISTEN={{ (listen_address | default('0.0.0.0')) }}:{{ listen_port | default(8002) }}

# Concurrency limit for the scanning queue threads.
# The default is related to the number of processors; minimum is 1.
WORKER_COUNT={{ worker_count | default(1) }}

# Size of the pool of threads serving webapi queries.
# 0 means automatic. Minimum 2 if explicitly specified.
MAX_CONNECTIONS={{ max_connections | default(0) }}

# Rescan time for the file and archive directories in seconds.
CACHE_MAX_AGE={{ cache_max_age | default(300) }}

# Groom time for the index database in seconds.
MAX_CACHE_SIZE={{ max_cache_size | default(86400) }}

# TCP port number on which debuginfod should listen.
# Note: LISTEN directive above also includes this port.
# This field is redundant if LISTEN is used, but kept for schema compliance.
LISTEN_PORT={{ listen_port | default(8002) }}

# Path of the sqlite database used to store the index.
# Default is $HOME/.debuginfod.sqlite.
DB_PATH={{ db_path | default('$HOME/.debuginfod.sqlite') }}

# Limit on the runtime of metadata webapi queries in seconds.
# Set to 0 to disable the limit.
METADATA_MAXTIME={{ metadata_maxtime | default(5) }}

# Cache limit in megabytes for recently extracted files from archives.
FDCACHE_MBS={{ fdcache_mbs | default(0) }}

# Number of other files from an archive to prefetch into the cache.
FDCACHE_PREFETCH={{ fdcache_prefetch | default(0) }}

# Disk space threshold percentage for emergency flushing of the caches.
FDCACHE_MINTMP={{ fdcache_mintmp | default(25) }}

# Limit of X-Forwarded-For hops.
FORWARDED_TTL_LIMIT={{ forwarded_ttl_limit | default(8) }}

# Run a synchronized SQLITE WAL checkpoint operation after every NUM completed
# archive or file scans. Set to 0 to disable.
SCAN_CHECKPOINT={{ scan_checkpoint | default(256) }}

# Verbosity of logging. 0 is default. Increase to add details.
LOG_LEVEL={{ log_level | default(0) }}

# List of URL prefixes for trusted debuginfod instances ($DEBUGINFOD_URLS).
# Renders as a space-separated list of URLs.
# If the list is empty, this directive will output nothing (or an empty string).
UPSTREAM_SOURCES={{ (upstream_sources | default([])) | join(' ') }}

# Set the server to passive mode, where it only services webapi requests.
# Renders as 'true' or 'false'.
PASSIVE={{ passive | default(False) | string | lower }}