{
  "base_cache_dir": "/var/cache/debuginfod",
  "tmp_dir": "/var/tmp/debuginfod",
  "listen_address": "127.0.0.1",
  "listen_port": 8002,
  "worker_count": 4,
  "max_connections": 512,
  "compression": true,
  "http2": false,
  "https_cert_path": "",
  "https_key_path": "",
  "api_root_path": "/debuginfod",
  "upstream_timeout": 45,
  "cache_max_age": 86400,
  "min_free_space": 2147483648,
  "max_cache_size": 53687091200,
  "log_level": "info",
  "upstream_sources": [
    "https://debuginfod.archlinux.org",
    "https://debuginfod.fedoraproject.org"
  ],
  "enable_db": true,
  "db_path": "/var/lib/debuginfod/debuginfod.db",
  "rate_limit_per_min": 30,
  "cors_origins": [
    "https://example.com",
    "https://dev.example.com"
  ],
  "metrics": true,
  "healthz": true
}
