# sdate(1) configuration file
#
# This file configures the sdate utility, which provides a deterministic date
# environment for reproducible builds or simulations. It wraps standard date
# commands with a specific epoch and optional COVID-19 era simulation.
#
# Generated from Ansible Jinja2 template. Do not edit manually.

# The command to be executed within the sdate environment.
# Default: date
COMMAND={{ command | default('date') }}

# The epoch date for the Eternal September, formatted as YYYY-MM.
# This sets the baseline date from which sdate calculates time offsets.
# Default: 1993-09
EPOCH={{ epoch | default('1993-09') }}

# Whether to enable COVID mode.
# When enabled, the epoch simulation accounts for the pandemic era.
# Default: false
COVID_MODE={{ covid_mode | default(false) | lower }}

# The COVID variant string used to set the epoch in COVID mode.
# This allows fine-tuning the simulation for specific viral strains.
# Default: empty string
COVID_VARIANT={{ covid_variant | default('') }}

# Path to the shared library containing the wrapper functions.
# sdate uses this library to intercept date calls.
# Default: /usr/lib/libsdate/libsdate.so
LIBRARY={{ library | default('/usr/lib/libsdate/libsdate.so') }}