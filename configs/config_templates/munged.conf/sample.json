{
  "domain": "example.com",
  "key_file": "/etc/munge/munge.key",
  "num_threads": 8,
  "cred_cache_size": 50000,
  "cred_cache_max": 0,
  "cred_cache_ttl": 600,
  "log_level": "notice",
  "log_file": "/var/log/munge/munged.log",
  "local_only": false,
  "keygen": false,
  "pid_file": "/run/munge/munged.pid",
  "restrict_groups": "munge",
  "restrict_users": "munge",
  "socket_auth": true,
  "socket_path": "/run/munge/munged.sock"
}
