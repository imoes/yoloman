# MUNGE authentication daemon configuration file
# This file is managed by the MUNGE service

# Authentication domain (must match across all nodes in a cluster)
{{ domain }}

# Path to the key file used for HMAC authentication
{{ key_file }}

# Number of worker threads to spawn
{{ num_threads }}

# Maximum number of credentials to cache per process
{{ cred_cache_size }}

# Maximum number of credentials to cache system-wide (0 = unlimited)
{{ cred_cache_max }}

# Timeout (seconds) for credential cache entries
{{ cred_cache_ttl }}

# Log level: DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY
{{ log_level }}

# Path to the log file (use 'syslog' for syslog output)
{{ log_file }}

# Enable or disable local-only mode (bypass network authentication)
{{ local_only }}

# Enable or disable RSA key generation on first start (if key file is missing)
{{ keygen }}

# Path to the PID file
{{ pid_file }}

# Restrict operation to the specified group IDs (comma-separated or space-separated list)
{{ restrict_groups }}

# Restrict operation to the specified user IDs (comma-separated or space-separated list)
{{ restrict_users }}

# Enable or disable socket authentication (use socket for local auth)
{{ socket_auth }}

# Path to the socket file (used for local communication)
{{ socket_path }}
