#!/bin/bash
#
# chkconfig: 2345 20 80
# description: Jool NAT64 service
#
# This script manages the Jool NAT64 service.
# It loads the kernel module and creates/destroys instances using the Jool binary.
#
# NOTE: Modifying this script may require cascading changes to jool_siit,
# as the two are functionally similar.

### BEGIN INIT INFO
# Provides:          jool
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Jool NAT64 service
# Description:       IP/ICMP translation, stateful version.
### END INIT INFO

. /lib/lsb/init-functions

# Define the name of the kernel module and binary.
# Default: jool
module_name={{ module_name | default('jool') }}

# Path to the Jool binary.
jool_bin=/usr/bin/$module_name

# Path to the Jool configuration file.
# Default: /etc/jool/jool.conf
config_file={{ config_file | default('/etc/jool/jool.conf') }}

check_permissions() {
	# Check if the script is running with sufficient privileges.
	# Exit 4 if not root (permission denied).
	if [ $1 -eq -1 ] || [ $1 -eq 1 ]; then
		exit 4 # Not enough privileges
	fi
}

check_workspace() {
	# Verify that the binary and config file exist.
	# Exit 5 if binary is missing.
	if [ ! -f "$jool_bin" ]; then
		exit 5 # Program not installed
	fi
	# Exit 6 if config file is missing.
	if [ ! -f "$config_file" ]; then
		exit 6 # Program not configured
	fi
}

check_result() {
	# Wrapper to check exit status of previous command.
	# Ensures permissions were sufficient.
	check_permissions $1
	# Generic error if previous command failed.
	if [ $1 -ne 0 ]; then
		exit 1 # Generic error
	fi
}

# Computes the current status of the Jool instance.
# Sets the global variable 'status' to "Running", "Dead", or other.
compute_status() {
	# Query the instance status.
	status=$($jool_bin -f "$config_file" instance status 2> /dev/null)
	check_permissions $?
	# Take the first line of output.
	status=$(echo "$status" | head -1)
}

add_module() {
	# Load the Jool kernel module.
	/sbin/modprobe $module_name
	check_result $?
}

add_instance() {
	# Register the Jool instance with the provided configuration.
	$jool_bin file handle "$config_file"
	check_result $?
}

remove_instance() {
	# Remove the Jool instance.
	$jool_bin -f "$config_file" instance remove
	check_result $?
}

# start - start the service
start() {
	check_workspace

	compute_status
	case "$status" in
		Running)
			exit 0
			;;
		Dead)
			add_module
			add_instance
			exit 0
			;;
		*)
			exit 1
			;;
	esac
}

# stop - stop the service
stop() {
	check_workspace

	compute_status
	case "$status" in
		Running)
			remove_instance
			exit 0
			;;
		Dead)
			exit 0
			;;
		*)
			exit 1
			;;
	esac
}

# restart - stop and restart the service if the service is already running,
# otherwise start the service
restart() {
	check_workspace

	compute_status
	case "$status" in
		Running)
			remove_instance
			add_instance
			exit 0
			;;
		Dead)
			add_module
			add_instance
			exit 0
			;;
		*)
			exit 1
			;;
	esac
}

# try-restart - restart the service if the service is already running
try_restart() {
	check_workspace

	compute_status
	case "$status" in
		Running)
			remove_instance
			add_instance
			exit 0
			;;
		Dead)
			exit 0
			;;
		*)
			exit 1
			;;
	esac
}

# reload - cause the configuration of the service to be reloaded without
# actually stopping and restarting the service
#
# force-reload - cause the configuration to be reloaded if the service supports
# this, otherwise restart the service if it is running
reload() {
	check_workspace
	# Reload the module (idempotent in modprobe usually, but ensures state)
	add_module
	# `file handle` on an already existing instance is considered an update/reload.
	add_instance
}

# status - print the current status of the service
status() {
	output=$($jool_bin -f "$config_file" instance status)
	echo "$output"

	status=$(echo "$output" | head -1)
	case "$status" in
		Running)
			exit 0 # Running
			;;
		Dead)
			exit 3 # Not running
			;;
		*)
			exit 4 # Unknown
			;;
	esac
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		restart
		;;
	try-restart)
		try_restart
		;;
	reload | force-reload)
		reload
		;;
	status)
		status
		;;
	*)
		echo "Usage: $0 {start|stop|restart|try-restart|reload|force-reload|status}"
		exit 3 # Unimplemented feature
		;;
esac

exit 0