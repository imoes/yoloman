  "remote_index_address": "",
  "path_mappings": [
    {
      "client": "/home/user/project",
      "server": "/mnt/project"
    }
  ],
  "enable_config": true,
  "log": "info",
  "offset_encoding": "",
  "pch_storage": "disk",
  "malloc_trim": true,
