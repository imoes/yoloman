# Links text-mode browser configuration file
# Per-user config: ~/.links2/links.cfg

# Set user interface language code (e.g., en, de, fr).
- language {{ (values | default({})).language | default('en') }}

# Maximum number of concurrent connections.
- max-connections {{ (values | default({})).max_connections | default(10) }}

# Maximum number of concurrent connections to a given host.
- max-connections-to-host {{ (values | default({})).max_connections_to_host | default(2) }}

# Number of retries for failed requests.
- retries {{ (values | default({})).retries | default(3) }}

# Timeout on receive in seconds.
- receive-timeout {{ (values | default({})).receive_timeout | default(120) }}

# Timeout on non restartable connections in seconds.
- unrestartable-receive-timeout {{ (values | default({})).unrestartable_receive_timeout | default(600) }}

# Timeout for connection when trying multiple addresses or when resuming a keepalive connection.
- timeout-when-trying-multiple-addresses {{ (values | default({})).timeout_when_trying_multiple_addresses | default(3) }}

# Use a specific local IP address or interface name.
- bind-address {{ (values | default({})).bind_address | default('') }}

# Use a specific local IPv6 address or interface name.
- bind-address-ipv6 {{ (values | default({})).bind_address_ipv6 | default('') }}

# Number of formatted document pages cached.
- format-cache-size {{ (values | default({})).format_cache_size | default(5) }}

# Cache memory in bytes.
- memory-cache-size {{ (values | default({})).memory_cache_size | default(1048576) }}

# Cache memory in bytes for images.
- image-cache-size {{ (values | default({})).image_cache_size | default(1048576) }}

# Cache memory in bytes for fonts.
- font-cache-size {{ (values | default({})).font_cache_size | default(2097152) }}

# Always cache everything regardless of server's caching recommendations.
- aggressive-cache {{ (values | default({})).aggressive_cache | default(false) | lower }}

# Address preference: 0 - use system default, 1 - prefer IPv4, 2 - prefer IPv6, 3 - use only IPv4, 4 - use only IPv6.
- address-preference {{ (values | default({})).address_preference | default(0) }}

# Host and port number of the HTTP proxy.
- http-proxy {{ (values | default({})).http_proxy | default('') }}

# Host and port number of the FTP proxy.
- ftp-proxy {{ (values | default({})).ftp_proxy | default('') }}

# Host and port number of the HTTPS proxy.
- https-proxy {{ (values | default({})).https_proxy | default('') }}

# Userid, host and port of Socks4a proxy.
- socks-proxy {{ (values | default({})).socks_proxy | default('') }}

# No proxy for specified domains, comma-separated.
- no-proxy-domains {{ (values | default({})).no_proxy_domains | default('') }}

# Causes that Links won't initiate any non-proxy connection.
- only-proxies {{ (values | default({})).only_proxies | default(false) | lower }}

# SSL certificate validation: 0 - ignore invalid certificate, 1 - warn on invalid certificate, 2 - reject invalid certificate.
- ssl.certificates {{ (values | default({})).ssl_certificates | default(1) }}

# Use built-in certificates instead of system certificates.
- ssl.builtin-certificates {{ (values | default({})).ssl_builtin_certificates | default(false) | lower }}

# Name of the PEM encoded file with the user private key for client certificate authentication.
- ssl.client-cert-key {{ (values | default({})).ssl_client_cert_key | default('') }}

# Name of the PEM encoded file with the user certificate for client certificate authentication.
- ssl.client-cert-crt {{ (values | default({})).ssl_client_cert_crt | default('') }}

# Password for the user private key for client certificate authentication.
- ssl.client-cert-password {{ (values | default({})).ssl_client_cert_password | default('') }}

# Asynchronous DNS resolver on(1)/off(0).
- async-dns {{ (values | default({})).async_dns | default(false) | lower }}

# DNS over HTTPS url.
- dns-over-https {{ (values | default({})).dns_over_https | default('') }}

# Forces using only HTTP/1.0 protocol.
- http-bugs.http10 {{ (values | default({})).http_bugs_http10 | default(false) | lower }}

# Defaults to using list of servers that have broken HTTP/1.1 support.
- http-bugs.allow-blacklist {{ (values | default({})).http_bugs_allow_blacklist | default(true) | lower }}

# Do not send Accept-Charset field of HTTP header.
- http-bugs.bug-no-accept-charset {{ (values | default({})).http_bugs_bug_no_accept_charset | default(false) | lower }}

# Causes that links won't advertise HTTP compression support.
- http-bugs.no-compression {{ (values | default({})).http_bugs_no_compression | default(false) | lower }}

# Retry on internal server errors (50x).
- http-bugs.retry-internal-errors {{ (values | default({})).http_bugs_retry_internal_errors | default(false) | lower }}

# Fake that the browser is Firefox in the HTTP header.
- http.fake-firefox {{ (values | default({})).http_fake_firefox | default(false) | lower }}

# Send "do not track" request in the HTTP header.
- http.do-not-track {{ (values | default({})).http_do_not_track | default(false) | lower }}

# Referer policy: 0 - do not send referer, 1 - send requested URL, 2 - send fake referer, 3 - send real referer, 4 - send real referer only to same server.
- http.referer {{ (values | default({})).http_referer | default(0) }}

# Fake referer value.
- http.fake-referer {{ (values | default({})).http_fake_referer | default('') }}

# Fake user agent value.
- http.fake-user-agent {{ (values | default({})).http_fake_user_agent | default('') }}

# Extra string added to HTTP header.
- http.extra-header {{ (values | default({})).http_extra_header | default('') }}

# Password for anonymous ftp access.
- ftp.anonymous-password {{ (values | default({})).ftp_anonymous_password | default('') }}

# Use ftp PASV command to bypass firewalls.
- ftp.use-passive {{ (values | default({})).ftp_use_passive | default(false) | lower }}

# Use EPRT and EPSV commands instead of PORT and PASV.
- ftp.use-erpt-epsv {{ (values | default({})).ftp_use_erpt_epsv | default(false) | lower }}

# Set IP Type-of-service to high throughput on ftp connections.
- ftp.set-iptos {{ (values | default({})).ftp_set_iptos | default(false) | lower }}

# Allow hyperlinks to SMB protocol.
- smb.allow-hyperlinks-to-smb {{ (values | default({})).smb_allow_hyperlinks_to_smb | default(true) | lower }}

# Size of font in menu. 0 for default.
- menu-font-size {{ (values | default({})).menu_font_size | default(0) }}

# Set menu background color in graphics mode (hex RRGGBB).
- menu-background-color {{ (values | default({})).menu_background_color | default('0x000000') }}

# Set menu foreground color in graphics mode (hex RRGGBB).
- menu-foreground-color {{ (values | default({})).menu_foreground_color | default('0xffffff') }}

# Set color of scroll bar area (hex RRGGBB).
- scroll-bar-area-color {{ (values | default({})).scroll_bar_area_color | default('0x000000') }}

# Set color of scroll bar (hex RRGGBB).
- scroll-bar-bar-color {{ (values | default({})).scroll_bar_bar_color | default('0x888888') }}

# Set color of scroll bar frame (hex RRGGBB).
- scroll-bar-frame-color {{ (values | default({})).scroll_bar_frame_color | default('0xffffff') }}

# File to store bookmarks.
- bookmarks-file {{ (values | default({})).bookmarks_file | default('~/.links2/bookmarks') }}

# Character set of bookmarks file.
- bookmarks-codepage {{ (values | default({})).bookmarks_codepage | default('iso-8859-1') }}

# Save URL history on exit.
- save-url-history {{ (values | default({})).save_url_history | default(true) | lower }}

# Enable cookies.
- enable-cookies {{ (values | default({})).enable_cookies | default(false) | lower }}

# Save cookies on exit.
- save-cookies {{ (values | default({})).save_cookies | default(false) | lower }}

# Maximum cookie age in days. 0 - unlimited.
- max-cookie-age {{ (values | default({})).max_cookie_age | default(365) }}

# Red gamma of display.
- display-red-gamma {{ (values | default({})).display_red_gamma | default(2.2) }}

# Green gamma of display.
- display-green-gamma {{ (values | default({})).display_green_gamma | default(2.2) }}

# Blue gamma of display.
- display-blue-gamma {{ (values | default({})).display_blue_gamma | default(2.2) }}

# Additional gamma.
- user-gamma {{ (values | default({})).user_gamma | default(1) }}

# Display aspect ratio.
- bfu-aspect {{ (values | default({})).bfu_aspect | default(1) }}

# Do letter dithering.
- dither-letters {{ (values | default({})).dither_letters | default(false) | lower }}

# Do image dithering.
- dither-images {{ (values | default({})).dither_images | default(false) | lower }}

# Display optimization: 0 - CRT, 1 - LCD RGB, 2 - LCD BGR.
- display-optimize {{ (values | default({})).display_optimize | default(0) }}

# Gamma correction type: 0 - 8-bit (fast), 1 - 16-bit (slow), 2 - auto detect.
- gamma-correction {{ (values | default({})).gamma_correction | default(2) }}

# Overwrite the screen instead of scrolling it.
- overwrite-instead-of-scroll {{ (values | default({})).overwrite_instead_of_scroll | default(false) | lower }}

# Font file for normal text.
- font {{ (values | default({})).font | default('') }}

# Font file for bold text.
- font-bold {{ (values | default({})).font_bold | default('') }}

# Font file for monospaced text.
- font-monospaced {{ (values | default({})).font_monospaced | default('') }}

# Font file for monospaced bold text.
- font-monospaced-bold {{ (values | default({})).font_monospaced_bold | default('') }}

# Font file for italic text.
- font-italic {{ (values | default({})).font_italic | default('') }}

# Font file for italic bold text.
- font-italic-bold {{ (values | default({})).font_italic_bold | default('') }}

# Font file for monospaced italic text.
- font-monospaced-italic {{ (values | default({})).font_monospaced_italic | default('') }}

# Font file for monospaced italic bold text.
- font-monospaced-italic-bold {{ (values | default({})).font_monospaced_italic_bold | default('') }}

# Use the given codepage when the webpage did not specify its codepage.
- html-assume-codepage {{ (values | default({})).html_assume_codepage | default('iso-8859-1') }}

# Use always character set from html-assume-codepage no matter what server sent.
- html-hard-assume {{ (values | default({})).html_hard_assume | default(false) | lower }}

# Render tables.
- html-tables {{ (values | default({})).html_tables | default(true) | lower }}

# Render frames.
- html-frames {{ (values | default({})).html_frames | default(true) | lower }}

# Break long lines in <pre> sections.
- html-break-long-lines {{ (values | default({})).html_break_long_lines | default(false) | lower }}

# Display links to unnamed images as [IMG].
- html-images {{ (values | default({})).html_images | default(false) | lower }}

# Display filename of an image instead of [IMG].
- html-image-names {{ (values | default({})).html_image_names | default(false) | lower }}

# Display images in graphics mode.
- html-display-images {{ (values | default({})).html_display_images | default(false) | lower }}

# Scale images in graphics mode (percent).
- html-image-scale {{ (values | default({})).html_image_scale | default(100) }}

# Autoscale images displayed in full screen.
- html-bare-image-autoscale {{ (values | default({})).html_bare_image_autoscale | default(false) | lower }}

# Number links in text mode.
- html-numbered-links {{ (values | default({})).html_numbered_links | default(false) | lower }}

# In text mode, walk through table by rows (0) or columns (1).
- html-table-order {{ (values | default({})).html_table_order | default(false) | lower }}

# Process refresh to other page (1), or display link to that page (0).
- html-auto-refresh {{ (values | default({})).html_auto_refresh | default(true) | lower }}

# Allow opening new windows from html.
- html-target-in-new-window {{ (values | default({})).html_target_in_new_window | default(false) | lower }}

# Margin in text mode (number of spaces).
- html-margin {{ (values | default({})).html_margin | default(2) }}

# Size of font on pages in graphics mode.
- html-user-font-size {{ (values | default({})).html_user_font_size | default(12) }}

# Text color in text mode (0-15).
- html-text-color {{ (values | default({})).html_text_color | default(7) }}

# Link color in text mode (0-15).
- html-link-color {{ (values | default({})).html_link_color | default(5) }}

# Background color in text mode (0-7).
- html-background-color {{ (values | default({})).html_background_color | default(0) }}

# Ignore colors specified in html document in text mode.
- html-ignore-document-color {{ (values | default({})).html_ignore_document_color | default(false) | lower }}

# Text color in graphics mode (hex RRGGBB).
- html-g-text-color {{ (values | default({})).html_g_text_color | default('0xffffff') }}

# Link color in graphics mode (hex RRGGBB).
- html-g-link-color {{ (values | default({})).html_g_link_color | default('0x0000ff') }}

# Background color in graphics mode (hex RRGGBB).
- html-g-background-color {{ (values | default({})).html_g_background_color | default('0x000000') }}

# Ignore colors specified in html document in graphics mode.
- html-g-ignore-document-color {{ (values | default({})).html_g_ignore_document_color | default(false) | lower }}

# List of font associations for external viewers. Each item defines an extension and the command to view it.
{% for item in ((values | default({})).font_associations | default([])) %}
# Association for {{ (item.ext | default('')) }}
-font {{ (item.ext | default('')) }} {{ (item.command | default('')) }}
{% endfor %}