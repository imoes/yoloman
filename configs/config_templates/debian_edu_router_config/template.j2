# Debian Edu Router Configuration
# This file is auto-generated by debian-edu-router-config.
# Do not edit manually — use /usr/sbin/debian-edu-router-setup instead.

# Network interfaces to manage (bridge, lan, wan, etc.)
INTERFACES="{{ interfaces | join(' ') }}"

# Primary WAN interface (for internet uplink)
WAN_IF="{{ wan_if }}"

# LAN interface for internal network
LAN_IF="{{ lan_if }}"

# Bridge interface for guest/DMZ (optional)
{% if bridge_if %}
BRIDGE_IF="{{ bridge_if }}"
{% else %}
BRIDGE_IF=""
{% endif %}

# Gateway IP address for LAN (e.g., 10.0.0.1/24)
LAN_IP="{{ lan_ip }}"

# Optional secondary LAN subnet (for multi-VLAN deployments)
{% if secondary_lan_subnets | length > 0 %}
# Secondary LAN subnets (space-separated CIDR notation)
SECONDARY_LAN_SUBNETS="{{ secondary_lan_subnets | join(' ') }}"
{% else %}
SECONDARY_LAN_SUBNETS=""
{% endif %}

# DHCP pool — start and end addresses (LAN)
DHCP_START="{{ dhcp_start }}"
DHCP_END="{{ dhcp_end }}"

# DNS servers to advertise via DHCP
{% if dhcp_dns_servers | length > 0 %}
DHCP_DNS="{{ dhcp_dns_servers | join(' ') }}"
{% else %}
DHCP_DNS=""
{% endif %}

# NTP server for time sync
NTP_SERVER="{{ ntp_server }}"

# Hostname of router (used in DHCP options and local DNS)
ROUTER_HOSTNAME="{{ router_hostname }}"

# Enable/disable IPv6 support on LAN
ENABLE_IPV6={{ enable_ipv6 | lower }}

# IPv6 ULA prefix (e.g., fd42:abcd:1234::/48)
{% if ipv6_ula_prefix %}
IPv6_UULA="{{ ipv6_ula_prefix }}"
{% else %}
IPv6_UULA=""
{% endif %}

# Firewall rules (allow/deny policies)
# Allow SSH from LAN only
ALLOW_SSH_LAN={{ allow_ssh_lan }}

# Allow ICMP (ping) from LAN
ALLOW_ICMP_LAN={{ allow_icmp_lan }}

# Rate limit ICMP to prevent abuse
ICMP_RATE_LIMIT={{ icmp_rate_limit }}

# Web proxy configuration (Squid)
{% if web_proxy_enabled %}
# Enable local web proxy caching
PROXY_PORT={{ web_proxy_port }}
PROXY_CACHE_DIR="{{ web_proxy_cache_dir }}"
PROXY_CACHE_SIZE={{ web_proxy_cache_size }}
PROXY_CACHE_MEM={{ web_proxy_cache_mem }}
{% else %}
PROXY_PORT=""
PROXY_CACHE_DIR=""
PROXY_CACHE_SIZE=""
PROXY_CACHE_MEM=""
{% endif %}

# Content filtering (SquidGuard / DansGuardian)
CONTENT_FILTER={{ content_filter_enabled }}
CONTENT_FILTER_LOG="{{ content_filter_log_dir }}"

# Bandwidth shaping (TC rules)
{% if bandwidth_shaping_enabled %}
# Enable QoS/shaping using tc
QOS_ENABLED={{ bandwidth_shaping_enabled }}
QOS_UP_KBIT={{ bandwidth_up_kbit }}
QOS_DOWN_KBIT={{ bandwidth_down_kbit }}
QOS_SHAPE_CLASSES="{{ bandwidth_shape_classes }}"
{% else %}
QOS_ENABLED=""
QOS_UP_KBIT=""
QOS_DOWN_KBIT=""
QOS_SHAPE_CLASSES=""
{% endif %}

# Logging: rsyslog remote server
{% if rsyslog_remote_server %}
RSYSLOG_REMOTE="{{ rsyslog_remote_server }}"
{% else %}
RSYSLOG_REMOTE=""
{% endif %}

# Fail2Ban settings
FAIL2BAN_ENABLED={{ fail2ban_enabled }}
FAIL2BAN_MAX_RETRY={{ fail2ban_max_retry }}
FAIL2BAN_BAN_TIME={{ fail2ban_ban_time }}
FAIL2BAN_FIND_TIME={{ fail2ban_find_time }}

# Optional: LDAP integration (for user auth in captive portal or proxy)
{% if ldap_enabled %}
LDAP_URI="{{ ldap_uri }}"
LDAP_BASE_DN="{{ ldap_base_dn }}"
LDAP_BIND_DN="{{ ldap_bind_dn }}"
LDAP_BIND_PWD="{{ ldap_bind_pwd }}"
LDAP_USER_FILTER="{{ ldap_user_filter }}"
LDAP_GROUP_FILTER="{{ ldap_group_filter }}"
{% else %}
LDAP_URI=""
LDAP_BASE_DN=""
LDAP_BIND_DN=""
LDAP_BIND_PWD=""
LDAP_USER_FILTER=""
LDAP_GROUP_FILTER=""
{% endif %}

# Captive portal settings
{% if captive_portal_enabled %}
CAPTIVE_PORTAL={{ captive_portal_enabled }}
CAPTIVE_PORTAL_IF="{{ captive_portal_if }}"
CAPTIVE_PORTAL_REDIRECT_URL="{{ captive_portal_redirect_url }}"
{% else %}
CAPTIVE_PORTAL=""
CAPTIVE_PORTAL_IF=""
CAPTIVE_PORTAL_REDIRECT_URL=""
{% endif %}

# Guest network VLAN ID (0 = disabled)
GUEST_VLAN={{ guest_vlan }}

# Guest isolation: block inter-client traffic
GUEST_ISOLATED={{ guest_isolated }}

# Optional: MAC whitelist for LAN access
{% if mac_whitelist_enabled %}
MAC_WHITELIST={{ mac_whitelist_enabled }}
MAC_WHITELIST_FILE="{{ mac_whitelist_file }}"
{% else %}
MAC_WHITELIST=""
MAC_WHITELIST_FILE=""
{% endif %}

# SNMP settings (monitoring)
{% if snmp_enabled %}
SNMP_COMMUNITY="{{ snmp_community }}"
SNMP_LOCATION="{{ snmp_location }}"
{% else %}
SNMP_COMMUNITY=""
SNMP_LOCATION=""
{% endif %}

# Wake-on-LAN relay (multicast relay for LAN-to-WAN WoL)
WOL_RELAY={{ wol_relay_enabled }}
WOL_RELAY_IF="{{ wol_relay_if }}"
WOL_RELAY_GROUP="{{ wol_relay_multicast_group }}"
