# ==============================================================================
# Debian Edu Router Configuration Template
# ==============================================================================
# This file is auto-generated by ansible-role-debian-edu-router.
# Do not edit manually — use /usr/sbin/debian-edu-router-setup or Ansible.
#
# Self-documenting: Every variable reference uses a default() filter to prevent
# render failures. Every directive is preceded by a comment explaining its purpose.
# ==============================================================================

# Network interfaces to manage (bridge, lan, wan, etc.)
# Schema: interfaces (list, default=['eth0', 'eth1', 'br0'])
# Description: List of network interfaces to configure and manage (e.g., primary LAN, WAN, bridge).
INTERFACES="{{ interfaces | default(['eth0', 'eth1', 'br0']) | join(' ') }}"

# Primary WAN interface (for internet uplink)
# Schema: wan_if (string, default='eth0')
# Description: Interface connected to the external/upstream network (WAN).
WAN_IF="{{ wan_if | default('eth0') }}"

# LAN interface for internal network
# Schema: lan_if (string, default='eth1')
# Description: Interface used for the primary internal (LAN) network.
LAN_IF="{{ lan_if | default('eth1') }}"

# Bridge interface for guest/DMZ (optional)
# Schema: bridge_if (string, default='br0')
# Description: Optional bridge interface for guest or DMZ networks.
BRIDGE_IF="{{ bridge_if | default('br0') }}"

# Gateway IP address for LAN (e.g., 10.0.0.1/24)
# Schema: lan_ip (string, default='10.0.0.1/24')
# Description: IPv4 address of the router on the LAN, in CIDR notation.
LAN_IP="{{ lan_ip | default('10.0.0.1/24') }}"

# Optional secondary LAN subnet (for multi-VLAN deployments)
# Schema: secondary_lan_subnets (list, default=[])
# Description: Additional IPv4 subnets (CIDR) served on separate VLANs or interfaces.
{% if secondary_lan_subnets | default([]) | length > 0 %}
# Secondary LAN subnets (space-separated CIDR notation)
SECONDARY_LAN_SUBNETS="{{ secondary_lan_subnets | default([]) | join(' ') }}"
{% else %}
SECONDARY_LAN_SUBNETS=""
{% endif %}

# DHCP pool — start and end addresses (LAN)
# Schema: dhcp_start (string, default='10.0.0.100')
# Description: First IP address in the DHCP lease pool for the LAN.
DHCP_START="{{ dhcp_start | default('10.0.0.100') }}"

# Schema: dhcp_end (string, default='10.0.0.200')
# Description: Last IP address in the DHCP lease pool for the LAN.
DHCP_END="{{ dhcp_end | default('10.0.0.200') }}"

# DNS servers to advertise via DHCP
# Schema: dhcp_dns_servers (list, default=['10.0.0.1'])
# Description: List of DNS servers to advertise via DHCP (typically includes router and upstream).
{% if dhcp_dns_servers | default(['10.0.0.1']) | length > 0 %}
DHCP_DNS="{{ dhcp_dns_servers | default(['10.0.0.1']) | join(' ') }}"
{% else %}
DHCP_DNS=""
{% endif %}

# NTP server for time sync
# Schema: ntp_server (string, default='pool.ntp.org')
# Description: NTP server used by the router and advertised to clients.
NTP_SERVER="{{ ntp_server | default('pool.ntp.org') }}"

# Hostname of router (used in DHCP options and local DNS)
# Schema: router_hostname (string, default='edu-router')
# Description: Hostname assigned to the router (used in DHCP hostname option and local DNS).
ROUTER_HOSTNAME="{{ router_hostname | default('edu-router') }}"

# Enable/disable IPv6 support on LAN
# Schema: enable_ipv6 (boolean, default=True)
# Description: Enable IPv6 addressing and routing on the LAN.
ENABLE_IPV6="{{ enable_ipv6 | default(True) | lower }}"

# IPv6 ULA prefix (e.g., fd42:abcd:1234::/48)
# Schema: ipv6_ula_prefix (string, default='fd42:abcd:1234::/48')
# Description: IPv6 Unique Local Address (ULA) prefix for internal use (non-routable).
IPv6_UULA="{{ ipv6_ula_prefix | default('fd42:abcd:1234::/48') }}"

# Firewall rules (allow/deny policies)
# Allow SSH from LAN only
# Schema: allow_ssh_lan (boolean, default=True)
# Description: Allow SSH access from LAN clients.
ALLOW_SSH_LAN="{{ allow_ssh_lan | default(True) | lower }}"

# Allow ICMP (ping) from LAN
# Schema: allow_icmp_lan (boolean, default=True)
# Description: Allow ICMP echo requests (ping) from LAN.
ALLOW_ICMP_LAN="{{ allow_icmp_lan | default(True) | lower }}"

# Rate limit ICMP to prevent abuse
# Schema: icmp_rate_limit (integer, default=10)
# Description: Maximum ICMP packets per second allowed from a single source (0 = unlimited).
ICMP_RATE_LIMIT="{{ icmp_rate_limit | default(10) }}"

# Web proxy configuration (Squid)
# Enable local web proxy caching
# Schema: web_proxy_enabled (boolean, default=True)
# Description: Enable the local web proxy (Squid) for caching and filtering.
{% if web_proxy_enabled | default(True) %}
# Schema: web_proxy_port (integer, default=3128)
# Description: TCP port on which the web proxy listens.
PROXY_PORT="{{ web_proxy_port | default(3128) }}"

# Schema: web_proxy_cache_dir (string, default='/var/spool/squid3')
# Description: Directory for Squid cache files.
PROXY_CACHE_DIR="{{ web_proxy_cache_dir | default('/var/spool/squid3') }}"

# Schema: web_proxy_cache_size (integer, default=1024)
# Description: Maximum cache size (in MB).
PROXY_CACHE_SIZE="{{ web_proxy_cache_size | default(1024) }}"

# Schema: web_proxy_cache_mem (integer, default=256)
# Description: Memory allocated to cache (in MB).
PROXY_CACHE_MEM="{{ web_proxy_cache_mem | default(256) }}"
{% else %}
PROXY_PORT=""
PROXY_CACHE_DIR=""
PROXY_CACHE_SIZE=""
PROXY_CACHE_MEM=""
{% endif %}

# Content filtering (SquidGuard / DansGuardian)
# Schema: content_filter_enabled (boolean, default=True)
# Description: Enable content filtering (via SquidGuard or similar).
CONTENT_FILTER="{{ content_filter_enabled | default(True) | lower }}"

# Schema: content_filter_log_dir (string, default='/var/log/squidguard')
# Description: Directory to store content filter logs.
CONTENT_FILTER_LOG="{{ content_filter_log_dir | default('/var/log/squidguard') }}"

# Bandwidth shaping (TC rules)
# Schema: bandwidth_shaping_enabled (boolean, default=False)
# Description: Enable traffic shaping/QoS using tc.
{% if bandwidth_shaping_enabled | default(False) %}
# Enable QoS/shaping using tc
QOS_ENABLED="{{ bandwidth_shaping_enabled | default(False) | lower }}"

# Schema: bandwidth_up_kbit (integer, default=10000)
# Description: Upload bandwidth limit (in kbit/s) for shaping rules.
QOS_UP_KBIT="{{ bandwidth_up_kbit | default(10000) }}"

# Schema: bandwidth_down_kbit (integer, default=100000)
# Description: Download bandwidth limit (in kbit/s).
QOS_DOWN_KBIT="{{ bandwidth_down_kbit | default(100000) }}"

# Schema: bandwidth_shape_classes (string, default='lan:1:10000 guest:2:5000')
# Description: Space-separated class definitions for bandwidth classes (format: classid:bandwidth_kbit).
QOS_SHAPE_CLASSES="{{ bandwidth_shape_classes | default('lan:1:10000 guest:2:5000') }}"
{% else %}
QOS_ENABLED=""
QOS_UP_KBIT=""
QOS_DOWN_KBIT=""
QOS_SHAPE_CLASSES=""
{% endif %}

# Logging: rsyslog remote server
# Schema: rsyslog_remote_server (string, default='')
# Description: Remote rsyslog server for centralized logging (e.g., logserver.example.com:514).
{% if rsyslog_remote_server | default('') | trim %}
RSYSLOG_REMOTE="{{ rsyslog_remote_server | default('') }}"
{% else %}
RSYSLOG_REMOTE=""
{% endif %}

# Fail2Ban settings
# Schema: fail2ban_enabled (boolean, default=True)
# Description: Enable the fail2ban intrusion prevention daemon.
FAIL2BAN_ENABLED="{{ fail2ban_enabled | default(True) | lower }}"

# Schema: fail2ban_max_retry (integer, default=5)
# Description: Number of failed attempts before banning an IP.
FAIL2BAN_MAX_RETRY="{{ fail2ban_max_retry | default(5) }}"

# Schema: fail2ban_ban_time (integer, default=600)
# Description: Duration (in seconds) of the ban.
FAIL2BAN_BAN_TIME="{{ fail2ban_ban_time | default(600) }}"

# Schema: fail2ban_find_time (integer, default=600)
# Description: Window (in seconds) in which to count failures.
FAIL2BAN_FIND_TIME="{{ fail2ban_find_time | default(600) }}"

# Optional: LDAP integration (for user auth in captive portal or proxy)
# Schema: ldap_enabled (boolean, default=False)
# Description: Enable LDAP integration (for user/group auth in captive portal, proxy, or ACLs).
{% if ldap_enabled | default(False) %}
# Schema: ldap_uri (string, default='ldap://ldap.edu.local')
# Description: LDAP server URI.
LDAP_URI="{{ ldap_uri | default('ldap://ldap.edu.local') }}"

# Schema: ldap_base_dn (string, default='dc=edu,dc=local')
# Description: Base DN for LDAP searches.
LDAP_BASE_DN="{{ ldap_base_dn | default('dc=edu,dc=local') }}"

# Schema: ldap_bind_dn (string, default='cn=admin,dc=edu,dc=local')
# Description: Bind DN for authenticating to LDAP (optional; leave blank for anonymous bind).
LDAP_BIND_DN="{{ ldap_bind_dn | default('cn=admin,dc=edu,dc=local') }}"

# Schema: ldap_bind_pwd (string, default='')
# Description: Password for the LDAP bind user.
LDAP_BIND_PWD="{{ ldap_bind_pwd | default('') }}"

# Schema: ldap_user_filter (string, default='(objectClass=person)')
# Description: LDAP filter for user lookups.
LDAP_USER_FILTER="{{ ldap_user_filter | default('(objectClass=person)') }}"

# Schema: ldap_group_filter (string, default='(objectClass=groupOfNames)')
# Description: LDAP filter for group lookups.
LDAP_GROUP_FILTER="{{ ldap_group_filter | default('(objectClass=groupOfNames)') }}"
{% else %}
LDAP_URI=""
LDAP_BASE_DN=""
LDAP_BIND_DN=""
LDAP_BIND_PWD=""
LDAP_USER_FILTER=""
LDAP_GROUP_FILTER=""
{% endif %}

# Captive portal settings
# Schema: captive_portal_enabled (boolean, default=False)
# Description: Enable a captive portal (e.g., for guest access).
{% if captive_portal_enabled | default(False) %}
CAPTIVE_PORTAL="{{ captive_portal_enabled | default(False) | lower }}"

# Schema: captive_portal_if (string, default='br0')
# Description: Interface on which the captive portal is enforced.
CAPTIVE_PORTAL_IF="{{ captive_portal_if | default('br0') }}"

# Schema: captive_portal_redirect_url (string, default='http:// captive.edu.local/login')
# Description: URL to redirect users to for authentication.
CAPTIVE_PORTAL_REDIRECT_URL="{{ captive_portal_redirect_url | default('http:// captive.edu.local/login') }}"
{% else %}
CAPTIVE_PORTAL=""
CAPTIVE_PORTAL_IF=""
CAPTIVE_PORTAL_REDIRECT_URL=""
{% endif %}

# Guest network VLAN ID (0 = disabled)
# Schema: guest_vlan (integer, default=0)
# Description: VLAN ID for guest network (0 = disabled).
GUEST_VLAN="{{ guest_vlan | default(0) }}"

# Guest isolation: block inter-client traffic
# Schema: guest_isolated (boolean, default=True)
# Description: Block inter-client communication on guest VLAN.
GUEST_ISOLATED="{{ guest_isolated | default(True) | lower }}"

# Optional: MAC whitelist for LAN access
# Schema: mac_whitelist_enabled (boolean, default=False)
# Description: Only allow clients with MAC addresses listed in the whitelist file.
{% if mac_whitelist_enabled | default(False) %}
MAC_WHITELIST="{{ mac_whitelist_enabled | default(False) | lower }}"

# Schema: mac_whitelist_file (string, default='/etc/debian-edu-router/mac-whitelist.txt')
# Description: Path to file containing allowed MAC addresses (one per line).
MAC_WHITELIST_FILE="{{ mac_whitelist_file | default('/etc/debian-edu-router/mac-whitelist.txt') }}"
{% else %}
MAC_WHITELIST=""
MAC_WHITELIST_FILE=""
{% endif %}

# SNMP settings (monitoring)
# Schema: snmp_enabled (boolean, default=False)
# Description: Enable SNMPv2c read-only access (public community).
{% if snmp_enabled | default(False) %}
# Schema: snmp_community (string, default='public')
# Description: SNMP read community (not recommended for production use without TLS/ACLs).
SNMP_COMMUNITY="{{ snmp_community | default('public') }}"

# Schema: snmp_location (string, default='School Server Room A')
# Description: Physical location of the router for SNMP discovery.
SNMP_LOCATION="{{ snmp_location | default('School Server Room A') }}"
{% else %}
SNMP_COMMUNITY=""
SNMP_LOCATION=""
{% endif %}

# Wake-on-LAN relay (multicast relay for LAN-to-WAN WoL)
# Schema: wol_relay_enabled (boolean, default=False)
# Description: Enable Wake-on-LAN relay to forward WoL packets from WAN to LAN.
WOL_RELAY="{{ wol_relay_enabled | default(False) | lower }}"

# Schema: wol_relay_if (string, default='eth1')
# Description: Interface for LAN-side WoL relay.
WOL_RELAY_IF="{{ wol_relay_if | default('eth1') }}"

# Schema: wol_relay_multicast_group (string, default='255.255.255.255')
# Description: Multicast group (or broadcast) to which WoL packets are relayed.
WOL_RELAY_GROUP="{{ wol_relay_multicast_group | default('255.255.255.255') }}"