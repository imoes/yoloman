{
  "service_name": {
    "type": "string",
    "default": "couriergraph",
    "description": "Name of the service and base for config/pid/RRD paths."
  },
  "mail_log_path": {
    "type": "string",
    "default": "/var/log/mail.log",
    "description": "Path to the mail log file to monitor."
  },
  "description": {
    "type": "string",
    "default": "Courier login Statistics",
    "description": "Human-readable description of the service."
  },
  "daemon_path": {
    "type": "string",
    "default": "/usr/sbin/couriergraph.pl",
    "description": "Absolute path to the daemon executable."
  },
  "pid_dir": {
    "type": "string",
    "default": "/var/run/servergraph",
    "description": "Directory for storing the PID file."
  },
  "pid_file_name": {
    "type": "string",
    "default": "couriergraph.pid",
    "description": "Name of the PID file."
  },
  "rrd_dir": {
    "type": "string",
    "default": "/var/lib/couriergraph",
    "description": "Directory for storing RRD files."
  },
  "rrd_name": {
    "type": "string",
    "default": "couriergraph",
    "description": "Base name for RRD files."
  },
  "daemon_process_name": {
    "type": "string",
    "default": "couriergraph.pl",
    "description": "Process name used by start-stop-daemon for matching."
  }
}
