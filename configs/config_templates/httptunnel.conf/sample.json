{
  "port": 8080,
  "max_connections": 100,
  "tunnel_dir": "/var/lib/httptunnel",
  "forward_files": false,
  "bind_interface": "127.0.0.1",
  "tls_enabled": true,
  "tls_cert_path": "/etc/httptunnel/tls/server.crt",
  "tls_key_path": "/etc/httptunnel/tls/server.key",
  "http_headers": [
    {
      "name": "X-Frame-Options",
      "value": "DENY"
    },
    {
      "name": "X-Content-Type-Options",
      "value": "nosniff"
    },
    {
      "name": "Access-Control-Allow-Origin",
      "value": "*"
    }
  ],
  "rate_limit_enabled": true,
  "upload_rate": 1024000,
  "download_rate": 5120000
}
