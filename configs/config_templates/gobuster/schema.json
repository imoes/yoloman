{
  "mode": {
    "type": "string",
    "default": "dir",
    "description": "Operation mode: one of dir, dns, s3, gcs, vhost, fuzz, tftp",
    "enum": [
      "dir",
      "dns",
      "s3",
      "gcs",
      "vhost",
      "fuzz",
      "tftp"
    ]
  },
  "delay": {
    "type": "string",
    "default": "",
    "description": "Time each thread waits between requests (e.g., '1500ms')"
  },
  "no_color": {
    "type": "bool",
    "default": false,
    "description": "Disable color output"
  },
  "no_error": {
    "type": "bool",
    "default": false,
    "description": "Don\u2019t display errors"
  },
  "no_progress": {
    "type": "bool",
    "default": false,
    "description": "Don\u2019t display progress"
  },
  "output": {
    "type": "string",
    "default": "",
    "description": "Output file path for results"
  },
  "patterns": {
    "type": "list",
    "default": [],
    "description": "File(s) containing replacement patterns (gobuster fuzz mode only)"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Suppress banner and other noise"
  },
  "threads": {
    "type": "number",
    "default": 10,
    "description": "Number of concurrent threads"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Verbose output (errors)"
  },
  "wordlist": {
    "type": "string",
    "default": "",
    "description": "Path to wordlist"
  },
  "url": {
    "type": "string",
    "default": "",
    "description": "Target URL (dir/vhost/fuzz modes)"
  },
  "extensions": {
    "type": "list",
    "default": [],
    "description": "File extensions to append (dir mode)"
  },
  "headers": {
    "type": "list",
    "default": [],
    "description": "HTTP headers to use (dir/vhost modes); each item is a list of two strings: [Header-Name, Value]"
  },
  "cookies": {
    "type": "list",
    "default": [],
    "description": "Cookie strings (dir mode); each item is a cookie string like 'session=abc'"
  },
  "domain": {
    "type": "string",
    "default": "",
    "description": "Target domain (dns mode)"
  },
  "wildcard": {
    "type": "bool",
    "default": false,
    "description": "Enable wildcard detection (dns mode)"
  },
  "servers": {
    "type": "list",
    "default": [],
    "description": "DNS servers to query (dns mode)"
  },
  "region": {
    "type": "string",
    "default": "",
    "description": "AWS region (s3/gcs modes)"
  },
  "list_buckets": {
    "type": "bool",
    "default": false,
    "description": "Attempt to list bucket contents (s3/gcs modes)"
  },
  "pattern_file": {
    "type": "string",
    "default": "",
    "description": "Pattern file for fuzzing (fuzz mode)"
  },
  "server": {
    "type": "string",
    "default": "",
    "description": "TFTP server hostname/IP (tftp mode)"
  }
}
