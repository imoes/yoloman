{
  "mandatory_manpaths": [
    "/usr/local/man",
    "/usr/man"
  ],
  "manpaths": [
    "/usr/share/man",
    "/usr/local/share/man"
  ],
  "setenv_manpath": true,
  "manpath_map": "/usr/bin:/usr/share/man:/usr/local/bin:/usr/local/share/man",
  "locale_manpaths": {
    "C": [
      "/usr/share/man"
    ],
    "en": [
      "/usr/share/man"
    ],
    "fr": [
      "/usr/share/man/fr"
    ]
  },
  "system_man_dirs": [
    "/usr/share/man"
  ]
}
