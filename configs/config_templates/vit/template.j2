# ==============================================================================
# Vit - Taskwarrior Integration Configuration
#
# This configuration file defines runtime behavior for the 'vit' service,
# which acts as a bridge or wrapper for Taskwarrior ('task').
#
# Variables are drawn from the role's defaults or inventory.
# If a variable is undefined, the schema default is used.
# ==============================================================================

# The absolute path to the Taskwarrior data directory.
# This directory contains all task databases (.taskrc, tasks.data, etc.).
# Ensure the user running vit has read/write permissions here.
vit_task_data_dir: {{ vit_task_data_dir|default('~/.task') }}

# Enable audit mode (-audit).
# When true, vit will echo the executed task commands to stderr.
# This is useful for debugging or logging what 'vit' actually does.
vit_audit_enabled: {{ vit_audit_enabled|default(false)|lower }}

# Enable the xterm titlebar update (-titlebar).
# When true, vit updates the terminal title bar with current task context.
# Set to false if running in environments where title changes are undesirable (e.g., some IDEs or non-interactive shells).
vit_titlebar_enabled: {{ vit_titlebar_enabled|default(true)|lower }}