{
  "hostname": "irc.ergo.example",
  "network_name": "ErgoNet",
  "network_description": "Modern, privacy-conscious IRC network.",
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 6697,
      "ssl": {
        "enabled": true,
        "cert_path": "/etc/letsencrypt/live/irc.ergo.example/fullchain.pem",
        "key_path": "/etc/letsencrypt/live/irc.ergo.example/privkey.pem"
      }
    },
    {
      "address": "0.0.0.0",
      "port": 6667,
      "ssl": {
        "enabled": false
      },
      "protocol": "irc"
    }
  ],
  "max_connections_per_ip": 3,
  "max_messages_per_second": 5,
  "ssl_verify": true,
  "sasl_backend": "memory",
  "tls_min_version": "1.2",
  "tls_ciphers": [
    "TLS_AES_256_GCM_SHA384",
    "TLS_CHACHA20_POLY1305_SHA256",
    "TLS_AES_128_GCM_SHA256"
  ],
  "tls_prefer_server_ciphers": true,
  "log_level": "info",
  "log_format": "json",
  "log_file": "/var/log/ergochat/ergochat.log",
  "links": [
    {
      "name": "uplink1",
      "address": "uplink1.ergo.example",
      "port": 6697,
      "password": "supersecretpassword",
      "cert_fp": "sha256:ab:cd:ef:..."
    }
  ],
  "server_description": "Ergo IRC daemon v3.10.1",
  "server_sid": "001",
  "opers": [
    {
      "name": "admin",
      "password_hash": "pbkdf2$sha512$100000$...$...",
      "flags": [
        "admin",
        "globops",
        "kill",
        "restart"
      ],
      "global": true
    }
  ],
  "chanserv_registration_enabled": true,
  "chanserv_default_keep_time": 604800,
  "chanserv_require_email": false,
  "idle_timeout": 900,
  "legacy_protocol_extensions": false
}
