{
  "version": {
    "type": "string",
    "default": "1.0.0rc5",
    "description": "Configuration file version string."
  },
  "theme": {
    "type": "string",
    "default": "default-bubble",
    "description": "UI Theme name."
  },
  "csd": {
    "type": "bool",
    "default": true,
    "description": "Enable Client-Side Decoration."
  },
  "send_on_ctrl_enter": {
    "type": "bool",
    "default": false,
    "description": "Send message on CTRL+Enter."
  },
  "exit_on_close": {
    "type": "bool",
    "default": true,
    "description": "Exit program on main window closed."
  },
  "server_visibility": {
    "type": "bool",
    "default": true,
    "description": "Whether the server buffer is visible."
  },
  "scroll_on_new_message": {
    "type": "bool",
    "default": false,
    "description": "Auto scroll when a new message is received."
  },
  "log_prompt_color": {
    "type": "bool",
    "default": true,
    "description": "Colorful output in log."
  },
  "log_prompt_file": {
    "type": "bool",
    "default": false,
    "description": "Display the filename of the file in log."
  },
  "log_prompt_function": {
    "type": "bool",
    "default": true,
    "description": "Display the function name in log."
  },
  "log_prompt_line": {
    "type": "bool",
    "default": false,
    "description": "Display the line number in log."
  },
  "user_nickname": {
    "type": "string",
    "default": "SrainUser",
    "description": "Default IRC nickname."
  },
  "user_username": {
    "type": "string",
    "default": "Srain",
    "description": "Default IRC username."
  },
  "user_realname": {
    "type": "string",
    "default": "Can you can a can?",
    "description": "Default IRC realname."
  },
  "login_method": {
    "type": "string",
    "default": "none",
    "description": "Login method for IRC services.",
    "enum": [
      "none",
      "nickserv",
      "msg-nickserv",
      "sasl-plain",
      "sasl-ecdsa",
      "sasl-external"
    ]
  },
  "part_message": {
    "type": "string",
    "default": "Leaving.",
    "description": "Default part message."
  },
  "kick_message": {
    "type": "string",
    "default": "Kick.",
    "description": "Default kick message."
  },
  "away_message": {
    "type": "string",
    "default": "Away from keyboard.",
    "description": "Default away message."
  },
  "quit_message": {
    "type": "string",
    "default": "El Psy Congroo.",
    "description": "Default quit message."
  },
  "chat_log": {
    "type": "bool",
    "default": true,
    "description": "Persistent chat log to storage."
  },
  "chat_notify": {
    "type": "bool",
    "default": true,
    "description": "Send notification when mentioned or on ERROR."
  },
  "chat_notify_all": {
    "type": "bool",
    "default": true,
    "description": "Send notification on any PRIVMSG/ACTION/NOTIFY/ERROR."
  },
  "chat_show_topic": {
    "type": "bool",
    "default": true,
    "description": "Show topic."
  },
  "chat_show_avatar": {
    "type": "bool",
    "default": false,
    "description": "Show user avatar."
  },
  "chat_show_user_list": {
    "type": "bool",
    "default": true,
    "description": "Show user list."
  },
  "chat_render_mirc_color": {
    "type": "bool",
    "default": true,
    "description": "Render mirc color."
  },
  "nick_completion_suffix": {
    "type": "string",
    "default": ":",
    "description": "Suffix of completed nick name."
  },
  "chat_preview_url": {
    "type": "bool",
    "default": true,
    "description": "Show previewer for every URL."
  },
  "chat_auto_preview_url": {
    "type": "bool",
    "default": true,
    "description": "Automatically preview supported URL."
  },
  "default_chat_name": {
    "type": "string",
    "default": "#srain",
    "description": "Name of the default chat in chat-list."
  },
  "default_chat_show_topic": {
    "type": "bool",
    "default": true,
    "description": "Show topic for the default chat."
  },
