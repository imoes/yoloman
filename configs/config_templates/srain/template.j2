# ==============================================================================
# Srain IRC Client Configuration
# ==============================================================================
# This file configures the Srain IRC client. It uses a TOML-like format.
# Generated by Ansible. All values are self-documenting via comments derived
# from the schema.
# ==============================================================================

# ------------------------------------------------------------------------------
# Global Application Settings
# ------------------------------------------------------------------------------

# Configuration file version string.
version = "{{ version | default('1.0.0rc5') }}"

# UI Theme name.
theme = "{{ theme | default('default-bubble') }}"

# Enable Client-Side Decoration (CSD).
csd = {{ csd | default(true) }}

# Send message on CTRL+Enter.
send-on-ctrl-enter = {{ send_on_ctrl_enter | default(false) }}

# Exit program on main window closed.
exit-on-close = {{ exit_on_close | default(true) }}

# Servers that are auto connected after startup.
auto-connect = []

# Whether the server buffer is visible.
server-visibility = {{ server_visibility | default(true) }}

# Auto scroll when a new message is received.
scroll-on-new-message = {{ scroll_on_new_message | default(false) }}

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------

log =
{
    # Colorful output in log.
    prompt-color = {{ log_prompt_color | default(true) }}

    # Display the filename of the file in log.
    prompt-file = {{ log_prompt_file | default(false) }}

    # Display the function name in log.
    prompt-function = {{ log_prompt_function | default(true) }}

    # Display the line number in log.
    prompt-line = {{ log_prompt_line | default(false) }}

    # Files with debug log level.
    debug-targets = []

    # Files with information log level.
    info-targets = []

    # Files with warning log level.
    warn-targets = [""]

    # Files with error log level.
    error-targets = []
}

# ------------------------------------------------------------------------------
# Global IRC Server Configuration
# ------------------------------------------------------------------------------

server =
{
    # Chats that are auto joined after server is created.
    auto-join = []

    # Commands that are auto run after server is created.
    auto-run = []

    # User Identity Configuration
    user =
    {
        # Default IRC nickname.
        nickname = "{{ user_nickname | default('SrainUser') }}"

        # Default IRC username.
        username = "{{ user_username | default('Srain') }}"

        # Default IRC realname.
        realname = "{{ user_realname | default('Can you can a can?') }}"

        # Login method for IRC services.
        # Available values: none, nickserv, msg-nickserv, sasl-plain, sasl-ecdsa, sasl-external
        login:
        {
            method = "{{ login_method | default('none') }}"
        }

        # Default part message.
        part-message = "{{ part_message | default('Leaving.') }}"

        # Default kick message.
        kick-message = "{{ kick_message | default('Kick.') }}"

        # Default away message.
        away-message = "{{ away_message | default('Away from keyboard.') }}"

        # Default quit message.
        quit-message = "{{ quit_message | default('El Psy Congroo.') }}"
    }

    # Chat Configuration
    chat =
    {
        # Persistent chat log to storage.
        log = {{ chat_log | default(true) }}

        # Send notification when mentioned or on ERROR.
        notify = {{ chat_notify | default(true) }}

        # Send notification on any PRIVMSG/ACTION/NOTIFY/ERROR.
        notify-all = {{ chat_notify_all | default(true) }}

        # Show topic.
        show-topic = {{ chat_show_topic | default(true) }}

        # Show user avatar.
        show-avatar = {{ chat_show_avatar | default(false) }}

        # Show user list.
        show-user-list = {{ chat_show_user_list | default(true) }}

        # Render mirc color.
        render-mirc-color = {{ chat_render_mirc_color | default(true) }}

        # Suffix of completed nick name (e.g., "nick: msg").
        nick-completion-suffix = "{{ nick_completion_suffix | default(':') }}"

        # Show previewer for every URL.
        preview-url = {{ chat_preview_url | default(true) }}

        # Automatically preview supported URL.
        auto-preview-url = {{ chat_auto_preview_url | default(true) }}

        # Commands that are auto run after chat is created.
        auto-run = []
    }

    # Default Chat Configuration
    # Specified chat configuration, every element in list should have a unique name.
    chat-list =
    (
        {
            # Name of the default chat in chat-list.
            name = "{{ default_chat_name | default('#srain') }}"

            # Show topic for the default chat.
            show-topic = {{ default_chat_show_topic | default(true) }}
        }
    )
}

