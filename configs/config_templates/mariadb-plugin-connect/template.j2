# MariaDB Plugin Configuration: Connect Storage Engine
# This section loads the 'Connect' storage engine, allowing MariaDB to access external data sources
# (like other databases, files, or protocols) as if they were native tables.

[mariadb]
# Plugin to load for the Connect storage engine.
# Default: ha_connect.so
# This tells the MariaDB server to load the specified shared object at startup.
plugin-load-add={{ plugin_load_add | default('ha_connect.so') }}