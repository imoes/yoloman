# MariaDB plugin configuration section.
# This section is specifically for the MariaDB server to load external plugins.
# Reference: https://mariadb.com/kb/en/configuring-mariadb-with-my-cnf/

[mariadb]
# Plugin to load for the Connect storage engine.
# The Connect storage engine allows MariaDB to access data from various external sources
# such as NoSQL databases, ODBC sources, and more.
# Default: ha_connect.so
plugin-load-add={{ plugin_load_add | default('ha_connect.so') }}
