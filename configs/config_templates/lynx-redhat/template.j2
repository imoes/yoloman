# lynx.cfg file.
# The default placement for this file is /etc/lynx.cfg
#
# This file is managed by Ansible. Do not edit directly.
#
# Definition pairs (configuration settings) are of the form
#	VARIABLE:DEFINITION
# NO spaces are allowed around the colon ":" between the pair items.

.h1 Auxiliary Facilities

.h2 STARTFILE
# The default starting URL file path if none is specified on the command line or via WWW_HOME.
STARTFILE:file:{{ STARTFILE | default('/usr/share/doc/HTML/en-US/index.html') }}

.h2 HELPFILE
# The local path to the lynx_help main page, prefixed with file://localhost.
HELPFILE:file://localhost{{ HELPFILE | default('/usr/share/doc/lynx/lynx_help/lynx_help_main.html') }}

.h2 DEFAULT_INDEX_FILE
# The default file retrieved when the user presses the 'I' key.
DEFAULT_INDEX_FILE:{{ DEFAULT_INDEX_FILE | default('http://www.google.com/') }}

.h1 Session support

.h2 SESSION_LIMIT
# Maximum number of searched strings, goto URLs, visited links and history entries saved in session file.
SESSION_LIMIT:{{ SESSION_LIMIT | default('250') }}

.h1 Character Sets

.h2 CHARACTER_SET
# The display character set MIME name.
CHARACTER_SET:{{ CHARACTER_SET | default('utf-8') }}

.h2 LOCALE_CHARSET
# Overrides CHARACTER_SET if true, using the current locale to lookup a MIME name.
LOCALE_CHARSET:{{ LOCALE_CHARSET | default('TRUE') }}

.h1 Internal Behavior

.h2 DEFAULT_CACHE_SIZE
# The number of WWW documents to be cached in memory at one time.
DEFAULT_CACHE_SIZE:{{ DEFAULT_CACHE_SIZE | default('10') }}

.h1 CGI scripts

.h2 TRUSTED_LYNXCGI
# Defines permitted sources and/or paths for lynxcgi links.
TRUSTED_LYNXCGI:{{ TRUSTED_LYNXCGI | default('none') }}
