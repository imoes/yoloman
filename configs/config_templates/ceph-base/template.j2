## Define the user account under which Ceph daemons run.
## This user is granted sudo permissions to collect device health metrics via smartctl and nvme-cli.
# The default Ceph user is typically 'ceph', but can be customized here.
{% set _service_user = service_user | default('ceph') %}

## Allow ceph daemons (which run as user {{ _service_user }}) to collect device health metrics.
## These rules permit the service user to execute specific hardware monitoring commands
## without a password prompt, facilitating automated health checks.
{{ _service_user }} ALL=NOPASSWD: /usr/sbin/smartctl -x --json=o /dev/*
{{ _service_user }} ALL=NOPASSWD: /usr/sbin/nvme * smart-log-add --json /dev/*
