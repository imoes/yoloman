# IPMI LAN fencing agent configuration
[default]
# Communication method: use IPMI over LAN (IPMI 2.0 RMCP)
interface = lan
# IPMI hostname or IP address of the target node (required)
ipaddr = {{ ipaddr }}
# IPMI username for authentication (required)
login = {{ login }}
# IPMI password for authentication (required)
passwd = {{ passwd }}
# IPMI cipher suite (0=raw, 1=md5, 2=des, 3=aes128, 4=aes192, 5=aes256)
# Default is usually 6 (aes256) for modern hardware; set explicitly to avoid fallback
cipher = {{ cipher }}
# Authentication type: 'admin' or 'user' (default: admin)
auth = {{ auth }}
# Use secure password algorithm (try to avoid plaintext if possible)
# Only applies to older IPMI devices; most modern devices ignore this
seclevel = {{ seclevel }}
# Timeout (in seconds) for each IPMI command
timeout = {{ timeout }}
# Retry count for failed commands
retry = {{ retry }}
# Optional: IPMI session key file (for persistent sessions on some implementations)
# Not commonly used; typically omitted
# session_key_file = /var/run/fence_ipmilan_{{ hostname }}.key
# Optional: IPMI domain SID for cluster-specific isolation (advanced)
# Usually omitted unless integrating with Active Directory
# sid = {{ sid }}
# Optional: Use IPv6 instead of IPv4
# Set to 'yes' if target uses IPv6
# ipv6 = {{ ipv6 }}
# Optional: Custom IPMI port (default RMCP port is 623)
# Most deployments leave this at default
# port = {{ port }}
