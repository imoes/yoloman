{
  "chromium_flags": [
    "--no-sandbox",
    "--disable-dev-shm-usage",
    "--disable-features=VizDisplayCompositor",
    "--enable-features=NetworkServiceSandbox",
    "--disable-extensions",
    "--enable-features=StrictOriginIsolation",
    "--disable-blink-features=AutomationControlled",
    "--disable-features=ColorCorrectRendering"
  ],
  "enable_spellcheck": false,
  "enable_webrtc_mute_capture": true,
  "enable_sandbox_debugging": false,
  "enable_sandbox": true,
  "disable_gpu": false,
  "disable_speech_recognition": true,
  "extra_env": {
    "CHROMIUM_WRAPPER_DEBUG": "0"
  }
}
