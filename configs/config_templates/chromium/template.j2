{
  #
  # Distribution settings
  #

  # Whether to import bookmarks from the default file on first run.
  "distribution": {
     "import_bookmarks": {{ distribution_import_bookmarks | default(False) }},
     # Path to the file containing initial bookmarks to import.
     "import_bookmarks_from_file": "{{ distribution_import_bookmarks_from_file | default('/usr/share/chromium/initial_bookmarks.html') }}",
     # Whether to make Chrome the system-wide default browser.
     "make_chrome_default": {{ distribution_make_chrome_default | default(False) }},
     # Whether to make Chrome the default browser for the current user.
     "make_chrome_default_for_user": {{ distribution_make_chrome_default_for_user | default(False) }},
     # Enable verbose logging for distribution-specific operations.
     "verbose_logging": {{ distribution_verbose_logging | default(True) }},
     # Skip the first-run welcome/assistant UI.
     "skip_first_run_ui": {{ distribution_skip_first_run_ui | default(True) }},
     # Create desktop and menu shortcuts for Chromium.
     "create_all_shortcuts": {{ distribution_create_all_shortcuts | default(True) }},
     # Suppress the prompt asking the user to make Chrome the default browser.
     "suppress_first_run_default_browser_prompt": {{ distribution_suppress_first_run_default_browser_prompt | default(True) }}
  },

  #
  # Browser behavior settings
  #

  "browser": {
     # Show the home button in the toolbar.
     "show_home_button": {{ browser_show_home_button | default(True) }},
     # Whether the user has already seen the welcome page.
     "has_seen_welcome_page" : {{ browser_has_seen_welcome_page | default(True) }},
     # Whether to check if Chrome is the default browser.
     "check_default browser" : {{ browser_check_default_browser | default(False) }}
  },

  #
  # Search provider override configuration
  #

  "search_provider_overrides": [{
     # Whether this search provider override is active.
     "enabled": {{ search_provider_overrides_enabled | default(True) }},
     # Character encoding for search queries.
     "encoding": "{{ search_provider_overrides_encoding | default('UTF-8') }}",
     # URL of the search provider's favicon.
     "favicon_url": "{{ search_provider_favicon_url | default('https://duckduckgo.com/favicon.ico') }}",
     # URL used for new tab page by the search provider.
     "new_tab_url": "{{ search_provider_new_tab_url | default('https://duckduckgo.com/chrome_newtab') }}",
     # Internal ID for the search provider override.
     "id": {{ search_provider_overrides_id | default(2) }},
     # Keyword to identify the search provider in Chromium settings.
     "keyword": "{{ search_provider_keyword | default('duckduckgo.com') }}",
     # User-visible name of the search provider.
     "name": "{{ search_provider_name | default('DuckDuckGo') }}",
     # Template URL for search queries, with {searchTerms} placeholder.
     "search_url": "{{ search_provider_search_url | default('https://duckduckgo.com/?q={searchTerms}') }}",
     # Template URL for search suggestions, with {searchTerms} placeholder.
     "suggest_url": "{{ search_provider_suggest_url | default('https://duckduckgo.com/ac/?q={searchTerms}&type=list') }}"
  }],

  # Version number for search provider overrides, incremented when overrides change.
  "search_provider_overrides_version": {{ search_provider_overrides_version | default(1) }},

  #
  # Profile settings
  #

  "profile": {
     "default_content_setting_values": {
        # Default permission for payment handlers (0=ask, 1=allow, 2=block).
        "payment_handler": {{ profile_default_content_setting_values_payment_handler | default(2) }}
     }
  },

  #
  # Bookmark bar settings
  #

  "bookmark_bar": {
     # Show the bookmark bar on all tabs.
     "show_on_all_tabs": {{ bookmark_bar_show_on_all_tabs | default(True) }}
  },

  #
  # Network settings
  #

  "net": {
     # Network prediction options (0=disabled, 1=enabled, 2=enabled with prefetch).
     "network_prediction_options": {{ net_network_prediction_options | default(2) }}
  },

  #
  # Search settings
  #

  "search": {
     # Whether to enable search suggestions.
     "suggest_enabled": {{ search_suggest_enabled | default(False) }}
  },

  #
  # Sign-in settings
  #

  "signin": {
     # Whether sign-in is allowed.
     "allowed": {{ signin_allowed | default(False) }},
     # Whether sign-in is allowed on the next startup.
     "allowed_on_next_startup": {{ signin_allowed_on_next_startup | default(False) }}
  },

  #
  # Autofill settings
  #

  "autofill": {
     # Whether to enable Autofill for profiles.
     "profile_enabled": {{ autofill_profile_enabled | default(False) }},
     # Whether to enable Autofill for credit cards.
     "credit_card_enabled": {{ autofill_credit_card_enabled | default(False) }}
  },

  #
  # Payments settings
  #

  "payments": {
     # Whether the user can make payments.
     "can_make_payment_enabled": {{ payments_can_make_payment_enabled | default(False) }}
  },

  #
  # Safe Browsing settings
  #

  "safebrowsing": {
     # Whether to enable Safe Browsing protection.
     "enabled": {{ safebrowsing_enabled | default(False) }}
  },

  #
  # DNS Prefetching settings
  #

  "dns_prefetching": {
     # Whether to enable DNS prefetching.
     "enabled": {{ dns_prefetching_enabled | default(False) }}
  },

  #
  # Alternate Error Pages settings
  #

  "alternate_error_pages": {
     # Whether to enable alternate error pages.
     "enabled": {{ alternate_error_pages_enabled | default(False) }}
  },

  #
  # Credential Management settings
  #

  # Whether to enable the credential management service.
  "credentials_enable_service": {{ credentials_enable_service | default(False) }},
  # Whether to enable auto-signin.
  "credentials_enable_autosignin": {{ credentials_enable_autosignin | default(False) }},

  #
  # General UI / Store settings
  #

  # Default apps behavior (e.g., noinstall, install).
  "default_apps": "{{ default_apps | default('noinstall') }}",
  # Whether to hide the Chrome Web Store icon.
  "hide_web_store_icon": {{ hide_web_store_icon | default(True) }},
  # Whether the homepage should be the New Tab page.
  "homepage_is_newtabpage": {{ homepage_is_newtabpage | default(True) }},
  # URL for the Chromium homepage.
  "homepage": "{{ homepage_url | default('https://www.debian.org') }}"
}