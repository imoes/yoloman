# /etc/bogofilter.cf
# Bogofilter configuration file
#
# This file controls the behavior of the bogofilter spam filtering engine.
# It uses a simple key=value format. Comments in the file start with '#'.
# Most parameters have sensible defaults, but they can be overridden here.
# See bogofilter(1) and bogofilter.cf.example for detailed documentation.

# =============================================================================
# Database Storage
# =============================================================================

# data_dir
# Directory where wordlist.db and metadata files are stored.
# Overrides the BOGOFILTER_DIR environment variable and the default $HOME/.bogofilter.
data_dir={{ db_dir | default('.bogofilter') }}

# =============================================================================
# Classification Thresholds
# =============================================================================

# spam-cutoff
# Threshold (0.0..1.0) above which messages are marked as SPAM.
# Messages with a calculated probability >= this value are considered spam.
spam-cutoff={{ spam_cutoff | default(0.99) }}

# ham-cutoff
# Threshold (0.0..1.0) below which messages are marked as HAM (non-spam).
# In tristate mode (when ham-cutoff != spam-cutoff), messages with probability
# between ham-cutoff and spam-cutoff are marked as 'unsure'.
ham-cutoff={{ ham_cutoff | default(0.01) }}

# =============================================================================
# Token Statistics & Probability Calculation
# =============================================================================

# robx
# Prior probability (0.0..1.0) assigned to tokens not yet seen in training.
# This prevents a single new token from skewing the classification entirely.
robx={{ robx | default(0.5) }}

# robs
# Weight (0.0..1.0) for robx when computing probabilities for tokens with few
# occurrences. Lower values make the model trust observed data more for rare tokens.
robs={{ robs | default(0.5) }}

# min-dev
# Minimum absolute deviation from 0.5 required for a token's probability to be
# used in classification. Tokens with probabilities too close to 0.5 (ambiguous)
# are ignored if their deviation is less than this value.
min-dev={{ min_dev | default(0.1) }}

# =============================================================================
# Effective Size Factors (ESF) — Redundancy Adjustment
# =============================================================================

# sp-esf
# Spam Effective Size Factor. Used to reduce the influence of redundant/spammy
# tokens in the spam calculation. A value > 1.0 dampens the impact of high-frequency
# spam tokens.
sp-esf={{ sp_esf | default(1.0) }}

# ns-esf
# Non-Spam Effective Size Factor. Similar to sp-esf but applied to ham (legitimate)
# tokens. Helps normalize the contribution of frequent legitimate words.
ns-esf={{ ns_esf | default(1.0) }}

# =============================================================================
# Logging
# =============================================================================

# log_enabled
# If true, enables logging to syslog when the -l option is used at runtime.
# This is useful for debugging classification issues in a production MTA pipeline.
{% if log_enabled is defined %}{% if log_enabled %}log_enabled=yes{% else %}log_enabled=no{% endif %}{% else %}log_enabled=no{% endif %}

# =============================================================================
# Header and Output Formatting
# =============================================================================

# spam-header-name
# The name of the X-Header field used to record the classification result (e.g., X-Bogosity).
# This header is often inserted into the email message by bogofilter or the MTA.
spam-header-name={{ spam_header_name | default('X-Bogosity') }}

# =============================================================================
# Token Parsing Behavior
# =============================================================================

# parse_headers
# If true, tokens found in email headers are extracted and tagged for classification.
# Disable this only for special testing scenarios. Usually, header content is relevant
# to spam detection (e.g., forged From/To lines).
{% if parse_headers is defined %}{% if parse_headers %}parse_headers=yes{% else %}parse_headers=no{% endif %}{% else %}parse_headers=yes{% endif %}

# =============================================================================
# Performance Tuning
# =============================================================================

# cache_size
# Berkeley DB cache size in MiB (1 MiB = 1,048,576 bytes).
# Set to 0 to use the default, which is recommended (typically ~1/3 of the DB file size).
# Increasing this can improve performance for large mailboxes or high-throughput systems.
cache_size={{ cache_size | default(0) }}