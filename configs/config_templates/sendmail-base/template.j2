# Configuration for sendmail-base package

# List of addresses to be delivered locally.
# Default: ['root', 'postmaster', 'user', 'user@mailhub', 'user@mailhub.gadget.com', 'user@gadget.com']
{% for addr in local_delivery_addresses | default(['root', 'postmaster', 'user', 'user@mailhub', 'user@mailhub.gadget.com', 'user@gadget.com']) %}
{{ addr }}
{% endfor %}

# List of addresses to be forwarded with SMTP to firewall.
# Default: ['user@firewall', 'user@firewall.gadget.com']
{% for addr in smtp_forward_to_firewall_addresses | default(['user@firewall', 'user@firewall.gadget.com']) %}
{{ addr }}
{% endfor %}

# List of addresses to be forwarded with SMTP to harker.com.
# Default: ['user@harker.com', 'harker!user']
{% for addr in smtp_forward_to_harker_addresses | default(['user@harker.com', 'harker!user']) %}
{{ addr }}
{% endfor %}