{
  "term_type": "linux",
  "login_shell": "/bin/bash",
  "getty_options": [
    "-8",
    "-o",
    "-p",
    "--keep-baud",
    "115200",
    "38400",
    "9600"
  ],
  "baud_rate": 115200,
  "fast_boot": true,
  "start_delay": 0,
  "extra_tty_names": [
    "tty4",
    "tty5",
    "tty6"
  ],
  "locale": "en_US.UTF-8"
}
