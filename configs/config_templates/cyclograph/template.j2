# CycloGraph configuration file
# Auto-generated by Ansible Jinja2 template.
# Every directive is self-documented with its schema description.
# Defaults are applied inline to ensure safe rendering even when
# variables are undefined in the playbook context.

# Path to input file (cgx, csv, gpx, tcx, sal, crp, or cyclomaniac)
file = {{ file | default('') }}

# Output size in WIDTHxHEIGHT format (e.g. '1920x1080')
size = {{ size | default('') }}

# List available themes and exit (boolean flag)
list = {{ list | default(False) | bool | ternary('true', 'false') }}

# List of output options to enable; valid values: '3d', 'legend', 'olines', 'sinfo'
{% if options | default([]) | length > 0 %}
options = {{ options | default([]) | join(',') }}
{% endif %}

# Theme name to use for rendering
theme = {{ theme | default('3d') }}

# Default file format extension for output (e.g. 'png', 'svg')
extension = {{ extension | default('') }}

# Enable GTK3 graphical user interface (boolean flag)
gtk3 = {{ gtk3 | default(False) | bool | ternary('true', 'false') }}

# Enable Qt graphical user interface (boolean flag)
qt = {{ qt | default(False) | bool | ternary('true', 'false') }}