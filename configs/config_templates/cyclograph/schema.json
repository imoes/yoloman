{
  "file": {
    "type": "string",
    "default": "",
    "description": "Path to input file (cgx, csv, gpx, tcx, sal, crp, or cyclomaniac)"
  },
  "size": {
    "type": "string",
    "default": "",
    "description": "Output size in WIDTHxHEIGHT format (e.g. '1920x1080')"
  },
  "list": {
    "type": "bool",
    "default": false,
    "description": "List available themes and exit"
  },
  "options": {
    "type": "list",
    "default": [],
    "description": "List of output options to enable; valid values: '3d', 'legend', 'olines', 'sinfo'"
  },
  "theme": {
    "type": "string",
    "default": "3d",
    "description": "Theme name to use for rendering",
    "enum": [
      "3d",
      "legend",
      "olines",
      "sinfo"
    ]
  },
  "extension": {
    "type": "string",
    "default": "",
    "description": "Default file format extension for output (e.g. 'png', 'svg')"
  },
  "gtk3": {
    "type": "bool",
    "default": false,
    "description": "Enable GTK3 graphical user interface"
  },
  "qt": {
    "type": "bool",
    "default": false,
    "description": "Enable Qt graphical user interface"
  }
}
