# =============================================================================
# didiwiki (ciwiki) configuration
# =============================================================================
# This template configures the didiwiki wiki engine.
# Self-documenting: every variable usage is accompanied by its schema
# description and a safe default value.

# -----------------------------------------------------------------------------
# enable_daemon: Whether to enable the didiwiki daemon (yes/no)
# run central copy of didiwiki?
# this doesn't affect the systemd unit — use systemctl enable didiwiki and systemctl disable didiwiki
# -----------------------------------------------------------------------------
ENABLE_DAEMON={{ enable_daemon | default('yes') }}

# -----------------------------------------------------------------------------
# listen: IP address on which the didiwiki daemon will listen
# -----------------------------------------------------------------------------
LISTEN={{ listen | default('127.0.0.1') }}

# -----------------------------------------------------------------------------
# home: Default didiwiki home directory
# -----------------------------------------------------------------------------
HOME={{ home | default('/var/lib/didiwiki') }}

# -----------------------------------------------------------------------------
# options: Command-line options for the didiwiki daemon (e.g., --nologin, --sendmail)
# The default is --nologin, like in didiwiki 0.5 — the wiki can be edited anonymously
# Replace this with --sendmail to require registrations (a sendmail is required)
# -----------------------------------------------------------------------------
OPTIONS={{ options | default('--nologin') }}