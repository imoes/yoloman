{
  "enable_daemon": {
    "type": "string",
    "default": "yes",
    "description": "Whether to enable the didiwiki daemon (yes/no)",
    "enum": [
      "yes",
      "no"
    ]
  },
  "listen": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address on which the didiwiki daemon will listen"
  },
  "home": {
    "type": "string",
    "default": "/var/lib/didiwiki",
    "description": "Default didiwiki home directory"
  },
  "options": {
    "type": "string",
    "default": "--nologin",
    "description": "Command-line options for the didiwiki daemon (e.g., --nologin, --sendmail)",
    "enum": [
      "--nologin",
      "--sendmail",
      "--autologin",
      "--debug",
      "--log-less",
      "--unmasked",
      "--home",
      "--listen",
      "--port",
      "--index",
      "--version",
      "--help"
    ]
  }
}
