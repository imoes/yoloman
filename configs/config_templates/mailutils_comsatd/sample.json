{
  "listen_address": "0.0.0.0",
  "listen_port": 16080,
  "max_connections": 50,
  "debug": false,
  "syslog_facility": "daemon",
  "pidfile_path": "/run/mailutils/comsatd.pid",
  "drop_user": "mail",
  "drop_group": "mail",
  "verbose": true,
  "allowed_hosts": [
    "127.0.0.1",
    "192.168.1.0/24"
  ],
  "denied_hosts": [
    "0.0.0.0/0"
  ],
  "ipv6_enabled": true,
  "timeout_seconds": 300,
  "maildir_path": "/var/spool/mail"
}
