{
  "general": {
    "enabled": true,
    "level": 4,
    "path": "/var/log/dlt",
    "max_size": 10485760,
    "max_files": 5,
    "rotate": true,
    "flush": false,
    "rate_limit": 0,
    "hostname": ""
  },
  "ipc": {
    "socket_path": "/var/run/dlt",
    "shm_enabled": true,
    "shm_max_size": 2097152
  },
  "storage": {
    "enabled": true,
    "path": "/var/lib/dlt",
    "compress": true,
    "max_size": 104857600,
    "min_free_space": 52428800
  },
  "mgmt": {
    "enabled": false,
    "port": 31322,
    "tls_enabled": false,
    "cert_file": "/etc/dlt/cert.pem",
    "key_file": "/etc/dlt/key.pem"
  },
  "filters": [
    {
      "ecu": "ECU1",
      "apid": "APP1",
      "ctid": "CT1"
    },
    {
      "ecu": "ECU2",
      "apid": "AP2",
      "ctid": "CTX"
    }
  ],
  "receivers": [
    {
      "host": "192.168.1.100",
      "port": 31322,
      "type": "tcp"
    },
    {
      "host": "10.0.0.5",
      "port": 31322,
      "type": "udp"
    }
  ]
}
