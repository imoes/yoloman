    },
    {
      "hostname": "1.pool.ntp.org",
      "iburst": true
    },
    {
      "hostname": "2.pool.ntp.org",
      "iburst": true
    },
    {
      "hostname": "3.pool.ntp.org",
      "iburst": true
    }
  ],
  "fallback_to_local_clock": false,
  "allow_local_clock": false,
  "log_level": 0,
  "step_first": false,
  "step_first_threshold": 1.0
}
