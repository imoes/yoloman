# /etc/default/openntpd

# Configuration overrides for the OpenNTPD daemon.
# This file is sourced by the init script/service file before launching ntpd.
# Any options specified here will be appended to the default command line.

# Command-line options passed to the ntpd daemon.
# Default: '-f /etc/openntpd/ntpd.conf'
# See man ntpd(8) for available options.
# Example: '-s' forces system time set if offset > 180s.
DAEMON_OPTS="{{ (daemon_opts | default('-f /etc/openntpd/ntpd.conf')) | string }}"