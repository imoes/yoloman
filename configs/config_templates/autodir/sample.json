{
  "basedir": "/home",
  "pidfile": "/var/run/autodir.pid",
  "loglevel": 2,
  "backend": "ldap",
  "ldap_uri": "ldap://ldap.university.edu",
  "ldap_base": "dc=university,dc=edu",
  "ldap_binddn": "cn=autodir,ou=Service Accounts,dc=university,dc=edu",
  "ldap_bindpw": "s3cr3t-p4ss",
  "ldap_user_filter": "(objectClass=eduPerson)",
  "ldap_group_filter": "(objectClass=groupOfNames)",
  "ldap_user_basedn": "ou=People",
  "ldap_group_basedn": "ou=Groups",
  "ldap_attr_uid": "uid",
  "ldap_attr_gid": "gidNumber",
  "ldap_attr_homedir": "homeDirectory",
  "mkdir_template": "mkdir -p %h && chown -R %u:%g %h && chmod 0750 %h",
  "uid_default": 1000,
  "gid_default": 100,
  "mode_dir": "0750",
  "mode_file": "0640",
  "skeleton_dir": "/etc/skel",
  "skeleton_files": [
    ".bashrc",
    ".bash_profile",
    ".profile"
  ],
  "pre_create": "logger -t autodir 'Creating home for %u'",
  "post_create": "logger -t autodir 'Home for %u created'",
  "max_creates_per_sec": 2,
  "max_creates_per_user_per_min": 1,
  "lookup_timeout": 5,
  "create_timeout": 10,
  "reload_on_config_change": true,
  "debug": false
}
