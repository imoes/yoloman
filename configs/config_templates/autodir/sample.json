{
  "run_autohome": "no",
  "run_autogroup": "no",
  "autohome_home": "/home",
  "autogroup_home": "/group",
  "autohome_timeout": 660,
  "autogroup_timeout": 300,
  "autohome_module": "/usr/lib/autodir/autohome.so",
  "autogroup_module": "/usr/lib/autodir/autogroup.so",
