# Configuration file for bacula-tray-monitor
# Self-documenting Jinja2 template enriched for Ansible reuse.
# Every variable reference uses `| default(...)` to match its schema default.
# Directives are preceded by comments derived from the schema descriptions.

# Debug level (0-99); higher values produce more verbose debug output.
# Range: 0 (minimal) to 99 (most verbose). Default is 20.
DebugLevel = {{ debug_level | default(20) }}

# Absolute path to the Bacula Director configuration file.
# This file contains the Director daemon's main configuration,
# including jobs, storage definitions, and pool settings.
DirectorConfig = {{ director_config | default('/etc/bacula/bacula-dir.conf') }}