{
  "vars": [],
  "chains.filter_inet.input": {
    "enabled": true,
    "default_policy": "drop",
    "drop_invalid": true,
    "rules": [
      {
        "action": "accept",
        "comment": "established/related"
      },
      {
        "action": "accept",
        "protocol": "icmp"
      },
      {
        "action": "accept",
        "protocol": "icmpv6"
      },
      {
        "action": "accept",
        "protocol": "tcp",
        "port": 22
      }
    ]
  },
  "chains.filter_inet.forward": {
    "enabled": false,
    "default_policy": "drop",
    "drop_invalid": true,
    "rules": [
      {
        "action": "accept",
        "comment": "established/related"
      },
      {
        "action": "accept",
        "protocol": "icmp"
      },
      {
        "action": "accept",
        "protocol": "icmpv6"
      }
    ]
  },
  "chains.filter_inet.output": {
    "enabled": true,
    "default_policy": "accept",
    "drop_invalid": true,
    "rules": [
      {
        "action": "accept",
        "comment": "established/related"
      }
    ]
  }
}
