{
  "vars": [
    {
      "name": "ssh_port",
      "value": "22",
      "comment": "SSH service port"
    },
    {
      "name": "http_ports",
      "value": "{80, 443}",
      "comment": "HTTP/HTTPS ports"
    }
  ],
  "chains.filter_inet.input": {
    "enabled": true,
    "default_policy": "drop",
    "drop_invalid": true,
    "rules": [
      {
        "action": "accept",
        "comment": "established/related"
      },
      {
        "action": "accept",
        "protocol": "icmp"
      },
      {
        "action": "accept",
        "protocol": "icmpv6"
      },
      {
        "action": "accept",
        "protocol": "tcp",
        "port": 22
      },
      {
        "action": "accept",
        "protocol": "tcp",
        "ports": [
          80,
          443
        ]
      },
      {
        "action": "drop",
        "protocol": "tcp",
        "port": 23,
        "comment": "Block telnet"
      }
    ]
  },
  "chains.filter_inet.forward": {
    "enabled": true,
    "default_policy": "drop",
    "drop_invalid": true,
    "rules": [
      {
        "action": "accept",
        "comment": "established/related"
      },
      {
        "action": "accept",
        "protocol": "icmp"
      },
      {
        "action": "accept",
        "protocol": "icmpv6"
      }
    ]
  },
  "chains.filter_inet.output": {
    "enabled": true,
    "default_policy": "accept",
    "drop_invalid": true,
    "rules": [
      {
        "action": "accept",
        "protocol": "udp",
        "port": 53
      },
      {
        "action": "accept",
        "protocol": "tcp",
        "port": 53
      }
    ]
  },
  "chains.nat_postrouting": [
    {
      "action": "masquerade",
      "ifname": "eth0",
      "comment": "Outbound NAT for LAN"
    }
  ],
  "chains.nat_prerouting": [
    {
      "action": "dnat",
      "protocol": "tcp",
      "port": 8080,
      "to_address": "192.168.1.10",
      "to_port": 80,
      "comment": "Forward external port 8080 \u2192 internal HTTP server"
    }
  ],
  "chains.filter6.enabled": false,
  "chains.filter6.default_policy": "drop",
  "chains.filter6.rules": [],
  "chains.filter6.forward_rules": []
}
