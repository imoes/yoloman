{
  "vars": {
    "type": "list",
    "default": [],
    "description": "List of global defines (e.g., IP ranges, port sets) for reuse across rules.",
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Variable name (e.g., 'internal_net', 'ssh_ports')"
        },
        "value": {
          "type": "string",
          "description": "Value (IP/mask, port number, comma-separated list, etc.)"
        },
        "comment": {
          "type": "string",
          "description": "Optional explanation for the variable",
          "default": ""
        }
      }
    }
  },
  "chains.filter_inet.input": {
    "type": "object",
    "default": {
      "enabled": true,
      "default_policy": "drop",
      "drop_invalid": true
    },
    "description": "IPv4/IPv6 input chain configuration for host-level filtering.",
    "properties": {
      "enabled": {
        "type": "bool",
        "description": "Enable the input chain"
      },
      "default_policy": {
        "type": "string",
        "enum": [
          "accept",
          "drop",
          "reject"
        ],
        "description": "Default policy for unmatched packets"
      },
      "drop_invalid": {
        "type": "bool",
        "description": "Drop packets with invalid connection state"
      },
      "rules": {
        "type": "list",
        "default": [
          {
            "action": "accept",
            "comment": "established/related"
          },
          {
            "action": "accept",
            "protocol": "icmp"
          },
          {
            "action": "accept",
            "protocol": "icmpv6"
          },
          {
            "action": "accept",
            "protocol": "tcp",
            "port": 22
          }
        ],
        "description": "Input chain rules: accept/drop packets by protocol and port.",
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "accept",
                "drop",
                "reject"
              ],
              "description": "Rule action"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "tcp",
                "udp",
                "icmp",
                "icmpv6"
              ],
              "description": "Protocol to match"
            },
            "port": {
              "type": "integer",
              "description": "TCP/UDP destination port"
            },
            "ports": {
              "type": "list",
              "description": "List of ports (for multiple ports, use 'tcp' with ports)",
              "items": {
                "type": "integer"
              }
            },
            "comment": {
              "type": "string",
              "description": "Optional rule description"
            }
          }
        }
      }
    }
  },
  "chains.filter_inet.forward": {
    "type": "object",
    "default": {
      "enabled": false,
      "default_policy": "drop",
      "drop_invalid": true
    },
    "description": "IPv4/IPv6 forward chain for routing/NAT scenarios.",
    "properties": {
      "enabled": {
        "type": "bool",
        "description": "Enable the forward chain (required for routing)"
      },
      "default_policy": {
        "type": "string",
        "enum": [
          "accept",
          "drop",
          "reject"
        ],
        "description": "Default policy"
      },
      "drop_invalid": {
        "type": "bool",
        "description": "Drop invalid packets"
      },
      "rules": {
        "type": "list",
        "default": [
          {
            "action": "accept",
            "comment": "established/related"
          },
          {
            "action": "accept",
            "protocol": "icmp"
          },
          {
            "action": "accept",
            "protocol": "icmpv6"
          }
        ],
        "description": "Forward chain rules (e.g., allow specific forwarded ports)",
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "accept",
                "drop",
                "reject"
              ],
              "description": "Rule action"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "tcp",
                "udp",
                "icmp",
                "icmpv6"
              ],
              "description": "Protocol"
            },
            "port": {
              "type": "integer",
              "description": "TCP/UDP destination port"
            },
            "comment": {
              "type": "string",
              "description": "Rule description"
            }
          }
        }
      }
    }
  },
  "chains.filter_inet.output": {
    "type": "object",
    "default": {
      "enabled": true,
      "default_policy": "accept",
      "drop_invalid": true
    },
    "description": "IPv4/IPv6 output chain (controls local process egress).",
    "properties": {
      "enabled": {
        "type": "bool",
        "description": "Enable the output chain"
      },
      "default_policy": {
        "type": "string",
        "enum": [
          "accept",
          "drop",
          "reject"
        ],
        "description": "Default policy"
      },
      "drop_invalid": {
        "type": "bool",
        "description": "Drop invalid packets"
      },
      "rules": {
        "type": "list",
        "default": [],
        "description": "Output chain rules (rarely needed for basic setups)",
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "accept",
                "drop",
                "reject"
              ],
              "description": "Rule action"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "tcp",
                "udp",
                "icmp",
                "icmpv6"
              ],
              "description": "Protocol"
            },
            "port": {
              "type": "integer",
              "description": "Destination port"
            },
            "comment": {
              "type": "string",
              "description": "Rule description"
            }
          }
        }
      }
    }
  },
  "chains.nat_postrouting": {
    "type": "list",
    "default": [
      {
        "action": "masquerade",
        "ifname": "eth0",
        "comment": "Outbound NAT for LAN"
      }
    ],
    "description": "SNAT/masquerade rules applied after routing (used for Internet sharing).",
    "items": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "masquerade",
            "snat"
          ],
          "description": "NAT action"
        },
        "ifname": {
          "type": "string",
          "description": "Output interface (for masquerade)"
        },
        "src_cidr": {
          "type": "string",
          "description": "Source subnet for SNAT (e.g., '192.168.1.0/24')",
          "default": "0.0.0.0/0"
        },
        "to_address": {
          "type": "string",
          "description": "Translation IP (for SNAT or masquerade fallback)"
        },
        "comment": {
          "type": "string",
          "description": "Rule description"
        }
      }
    }
  },
  "chains.nat_prerouting": {
    "type": "list",
    "default": [],
    "description": "DNAT rules to redirect inbound traffic (e.g., port forwarding).",
    "items": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "dnat"
          ],
          "description": "Rule action (currently only 'dnat' supported)"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp"
          ],
          "description": "Protocol",
          "default": "tcp"
        },
        "port": {
          "type": "integer",
          "description": "Destination port on host"
        },
        "to_address": {
          "type": "string",
          "description": "Internal server IP"
        },
        "to_port": {
          "type": "integer",
          "description": "Port on internal server",
          "default": ""
        },
        "comment": {
          "type": "string",
          "description": "Rule description"
        }
      }
    }
  },
  "chains.filter6.enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable IPv6-only filtering (if IPv6 is in use and needs separate rules)."
  },
  "chains.filter6.default_policy": {
    "type": "string",
    "default": "drop",
    "description": "Default policy for IPv6 input/forward chains."
  },
  "chains.filter6.rules": {
    "type": "list",
    "default": [
      {
        "action": "accept",
        "protocol": "tcp",
        "port": 22
      }
    ],
    "description": "IPv6 input chain rules (similar to filter_inet.input.rules).",
    "items": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "accept",
            "drop",
            "reject"
          ],
          "description": "Rule action"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp"
          ],
          "description": "Protocol"
        },
        "port": {
          "type": "integer",
          "description": "Destination port"
        },
        "comment": {
          "type": "string",
          "description": "Rule description"
        }
      }
    }
  },
  "chains.filter6.forward_rules": {
    "type": "list",
    "default": [],
    "description": "IPv6 forward chain rules.",
    "items": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "accept",
            "drop",
            "reject"
          ],
          "description": "Rule action"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp"
          ],
          "description": "Protocol"
        },
        "port": {
          "type": "integer",
          "description": "Destination port"
        },
        "comment": {
          "type": "string",
          "description": "Rule description"
        }
      }
    }
  }
}
