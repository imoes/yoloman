{# damo configuration file
#
# This template configures DAMON (Data Access Monitoring) via the `damo` utility.
# It covers default monitoring attributes, recording options, monitoring cycles,
# access-based operation schemes, memory reclaim/LRU sort policies, feature flags,
# and diagnostics.
#
# Variable Naming Convention:
#   - Flat keys (e.g. sample_interval) map directly to top-level schema fields.
#   - Nested keys (e.g. reclaim.enabled) map to nested schema objects.
#   - All variables use | default(...) to ensure safe rendering even if undefined.
#}

{# -----------------------------------------------------------
   [global] Section
   Defines the baseline behavior for all DAMON monitoring operations.
   ----------------------------------------------------------- #}
[global]

{# sample_interval: Interval between DAMON sampling in microseconds (DAMON param: sampling_interval)
   Default: 5000 (5ms). #}
sample_interval = {{ (sample_interval | default(5000)) | string }}

{# nr_regions: Maximum number of regions DAMON can monitor simultaneously (DAMON param: nr_regions)
   Default: 100. Increase if monitoring many distinct memory areas. #}
nr_regions = {{ (nr_regions | default(100)) | string }}

{# -----------------------------------------------------------
   [record] Section
   Controls the output behavior of the `damo record` command.
   ----------------------------------------------------------- #}
[record]

{# output: Path to output file for `damo record` (DAMON record param: output path)
   Default: '/tmp/damo-record.raw'. #}
output = {{ (output | default('/tmp/damo-record.raw')) | string }}

{# format: Record output format: 'raw' or 'json' (DAMON record param: format)
   Supported: 'raw', 'json', 'text'. #}
format = {{ (format | default('raw')) | string }}

{# -----------------------------------------------------------
   [monitor] Section
   Controls the cycle behavior of the `damo monitor` command.
   ----------------------------------------------------------- #}
[monitor]

{# repeat: Number of times `damo monitor` repeats the monitoring cycle (DAMON monitor param: repeat)
   Default: 1 (run once). Set higher for continuous monitoring loops. #}
repeat = {{ (repeat | default(1)) | string }}

{# interval: Interval between monitoring cycles in milliseconds for `damo monitor` (DAMON monitor param: interval)
   Default: 100. #}
interval = {{ (interval | default(100)) | string }}

{# -----------------------------------------------------------
   [schemes] Section
   Defines access-based operation schemes for automatic tuning.
   Used by `damo schemes`, `damo tune`, and `damo start`.
   ----------------------------------------------------------- #}
[schemes]

{# schemes: List of operation schemes (used by `damo schemes`, `damo tune`, `damo start`) — each scheme must have a `name` field and optional thresholds
   If empty, no schemes are defined. #}
{%- if (schemes | default([])) %}
schemes = [
{%- for scheme in schemes | default([]) %}
    {
        name = "{{ scheme.name | default('scheme_' + loop.index|string) }}",
        access_rate = {{ scheme.access_rate | default(0.5) | string }},
        age = {{ scheme.age | default(3) | string }},
        min_region = {{ scheme.min_region | default(4096) | string }},
        max_region = {{ scheme.max_region | default(1048576) | string }},
        apply_interval = {{ scheme.apply_interval | default(0) | string }}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
]
{%- else %}
schemes = []
{%- endif %}

{# -----------------------------------------------------------
   [reclaim] Section
   Configures DAMON_RECLAIM parameters (for `damo reclaim`).
   ----------------------------------------------------------- #}
[reclaim]

{# reclaim.enabled: Whether DAMON_RECLAIM is enabled (DAMON reclaim param: enable)
   Default: false. #}
enabled = {{ ((reclaim | default({})).enabled | default(false)) | string }}

{# reclaim.min_age: Minimum age (ms) of unused memory before DAMON_RECLAIM attempts reclaim (DAMON reclaim param: min_age)
   Default: 1000 (1 second). #}
min_age = {{ ((reclaim | default({})).min_age | default(1000)) | string }}

{# reclaim.max_age: Maximum age (ms) before forced reclaim by DAMON_RECLAIM (DAMON reclaim param: max_age)
   Default: 5000 (5 seconds). #}
max_age = {{ ((reclaim | default({})).max_age | default(5000)) | string }}

{# -----------------------------------------------------------
   [lru_sort] Section
   Configures DAMON_LRU_SORT parameters (for `damo lru_sort`).
   ----------------------------------------------------------- #}
[lru_sort]

{# lru_sort.enabled: Whether DAMON_LRU_SORT is enabled (DAMON lru_sort param: enable)
   Default: false. #}
enabled = {{ ((lru_sort | default({})).enabled | default(false)) | string }}

{# lru_sort.min_free_ratio: Minimum free memory ratio (%) to trigger LRU sorting (DAMON lru_sort param: min_free_ratio)
   Default: 5. #}
min_free_ratio = {{ ((lru_sort | default({})).min_free_ratio | default(5)) | string }}

{# -----------------------------------------------------------
   [features] Section
   Kernel DAMON feature detection flags.
   Usually auto-populated by `damo features`, but can be overridden here.
   ----------------------------------------------------------- #}
[features]

{# features.schemes: Whether kernel supports operation schemes (reported by `damo features`)
   Default: true. #}
schemes = {{ ((features | default({})).schemes | default(true)) | string }}

{# features.init_regions: Whether kernel supports initializing regions (reported by `damo features`)
   Default: true. #}
init_regions = {{ ((features | default({})).init_regions | default(true)) | string }}

{# features.target_ids: Whether kernel supports per-target monitoring (reported by `damo features`)
   Default: false. #}
target_ids = {{ ((features | default({})).target_ids | default(false)) | string }}

{# -----------------------------------------------------------
   [diagnose] Section
   Diagnostics configuration for `damo diagnose`.
   ----------------------------------------------------------- #}
[diagnose]

{# diagnose.threshold: Threshold (ms) for detecting stale DAMON context (DAMON diagnose param: threshold)
   Default: 100. #}
threshold = {{ ((diagnose | default({})).threshold | default(100)) | string }}

{# diagnose.max_stale_cycles: Max number of stale cycles before DAMON context is considered malfunctioning (DAMON diagnose param: max_stale_cycles)
   Default: 5. #}
max_stale_cycles = {{ ((diagnose | default({})).max_stale_cycles | default(5)) | string }}