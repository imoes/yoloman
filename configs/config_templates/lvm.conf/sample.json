{
  "global": {
    "locking_type": 1,
    "use_lvmetad": false,
    "use_lvmpolld": true,
    "wait_for_locks": true,
    "prioritise_write_locks": true,
    "allocation_cache_max_mb": 128,
    "metadata_read_only": false
  },
  "devices": {
    "global_filter": [
      "a|^/dev/sd[a-z]$|",
      "a|^/dev/mapper/mpath.*|",
      "r|.*|"
    ],
    "scanning": {
      "scan_lvs": false,
      "md_component_detection": true,
      "md_component_detection_timeout": 30,
      "md_component_check": false,
      "lvmetad_update_delay": 10,
      "lvmlockd_sock": "/run/lvm/lvmlockd.socket",
      "lvmlockd_timeout": 10,
      "lvmlockd_auto_unlock": false
    },
    "write_cache_state": true,
    "sysfs_scan": true,
    "preferential_pvmove": true,
    "missing_disk_list": [],
    "loop_device_dir": "/dev",
    "loop_device_prefix": "loop"
  },
  "log": {
    "verbose": 0,
    "syslog": 1,
    "overwrite": 0,
    "indent": 1,
    "command_names": 0,
    "prefix": "  ",
    "activation": 1,
    "activation_passive": 0,
    "file": {
      "enabled": 1,
      "filename": "/var/log/lvm/lvm.log",
      "level": 0,
      "suffix": ".gz",
      "max_log_size": 10,
      "compress": 1
    },
    "overrides": []
  },
  "activation": {
    "checks": 1,
    "missing_stripe_filler": "error",
    "locking_type": 1,
    "polling_interval": 15,
    "read_only": 0,
    "retry_activation": 0,
    "retry_activation_attempts": 3,
    "activation_mode": "degraded",
    "auto_activation": 1,
    "auto_activation_volume_list": [],
    "reserved_stack": 64,
    "use_lvmetad": false,
    "use_lvmpolld": true,
    "process_priority": -18,
    "mirror_segtype_default": "mirror",
    "raid_stripe_cache": 256,
    "raid_stripe_cache_entries": 0,
    "thin_pool_metadata_require_separate_pvs": false,
    "thin_pool_autoextend_threshold": 80,
    "thin_pool_autoextend_percent": 20,
    "thin_pool_max_usage_threshold": 90,
    "snapshot_autoextend_threshold": 80,
    "snapshot_autoextend_percent": 20,
    "thin_check_executable": "/sbin/thin_check",
    "thin_dump_executable": "/sbin/thin_dump",
    "thin_repair_executable": "/sbin/thin_repair",
    "use_linear_target": true,
    "monitoring": true,
    "thin_check_options": [
      "-q"
    ],
    "thin_dump_options": [],
    "thin_repair_options": []
  },
  "backup": {
    "enabled": true,
    "dir": "/etc/lvm/backup",
    "keep_days": 30,
    "keep_min": 10,
    "archive": true,
    "archive_dir": "/etc/lvm/archive",
    "retain_min": 10,
    "retain_days": 30
  },
  "cache": {
    "dir": "/run/lvm/lvmpool",
    "file_prefix": "lvmpool",
    "scan_dir": "/run/lvm/lvmpool"
  }
}
