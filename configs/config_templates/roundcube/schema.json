{
  "db_host": {
    "type": "string",
    "default": "localhost",
    "description": "Hostname of the MySQL/MariaDB database server"
  },
  "db_port": {
    "type": "number",
    "default": 3306,
    "description": "Port number of the database server"
  },
  "db_user": {
    "type": "string",
    "default": "roundcube",
    "description": "Database username for Roundcube"
  },
  "db_pass": {
    "type": "string",
    "default": "",
    "description": "Password for the database user (will be written to config file in plaintext)"
  },
  "db_name": {
    "type": "string",
    "default": "roundcube",
    "description": "Name of the database to use"
  },
  "imap_host": {
    "type": "string",
    "default": "localhost",
    "description": "Default IMAP server hostname"
  },
  "imap_port": {
    "type": "number",
    "default": 143,
    "description": "Default IMAP server port (143=unencrypted, 993=SSL)"
  },
  "imap_auth_type": {
    "type": "string",
    "default": "login",
    "description": "IMAP authentication method (e.g., 'login', 'cram-md5', 'digest-md5', 'gssapi')"
  },
  "imap_timeout": {
    "type": "number",
    "default": 10,
    "description": "IMAP connection timeout in seconds"
  },
  "smtp_host": {
    "type": "string",
    "default": "localhost",
    "description": "SMTP server hostname"
  },
  "smtp_port": {
    "type": "number",
    "default": 587,
    "description": "SMTP server port (587= Submission, 465=SMTPS)"
  },
  "session_lifetime": {
    "type": "number",
    "default": 480,
    "description": "Session lifetime in minutes before logout"
  },
  "session_domain": {
    "type": "string",
    "default": "",
    "description": "Domain for session cookies (empty = use current hostname)"
  },
  "session_name": {
    "type": "string",
    "default": "roundcubemachine",
    "description": "Session cookie name"
  },
  "des_key": {
    "type": "string",
    "default": "",
    "description": "Encryption key for cookies and stored passwords (minimum 24 chars, base64-safe)"
  },
  "password_charset": {
    "type": "string",
    "default": "UTF-8",
    "description": "Character set used in password-related operations"
  },
  "spellcheck_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable spell checking (requires installed backend)"
  },
  "spellcheck_engine": {
    "type": "string",
    "default": "pspell",
    "description": "Spell check engine: 'pspell' or 'googie'"
  },
  "skin_name": {
    "type": "string",
    "default": "elastic",
    "description": "UI skin name (e.g., 'elastic', 'larry')"
  },
  "default_language": {
    "type": "string",
    "default": "en_US",
    "description": "Default language (ISO 639-1 + ISO 3166-1, e.g., 'de_DE', 'fr_FR')"
  },
  "timezone": {
    "type": "string",
    "default": "UTC",
    "description": "Default timezone for the application (e.g., 'America/New_York')"
  },
  "preview_pane_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable the preview pane (shows message content next to the folder list)"
  },
  "preview_pane_mark_as_read_delay": {
    "type": "number",
    "default": 2,
    "description": "Delay (in seconds) before a message is marked as read in preview pane"
  },
  "draft_autosave_delay": {
    "type": "number",
    "default": 60,
    "description": "Seconds between draft autosaves while composing"
  },
  "max_message_size": {
    "type": "string",
    "default": "10M",
    "description": "Maximum allowed message size (e.g., '5M', '100K')"
  },
  "mime_param_folding": {
    "type": "number",
    "default": 0,
    "description": "MIME header folding: 0=RFC2231 only, 1=RFC2047+RFC2231, 2=RFC2047 only"
  },
  "plugins": {
    "type": "list",
    "default": [
      "archive",
      "zipdownload",
      "password",
      "managesieve",
      "acl",
      "additional_message_headers",
      "enigma"
    ],
    "description": "List of enabled plugins (must match installed plugins)"
  },
  "log_driver": {
    "type": "string",
    "default": "file",
    "description": "Log driver: 'file', 'syslog', 'stderr', or 'null'"
  },
  "log_dir": {
    "type": "string",
    "default": "/var/log/roundcube",
    "description": "Directory for log files (if using 'file' driver)"
  },
  "log_date_format": {
    "type": "string",
    "default": "Y-m-d H:i:s",
    "description": "Date/time format for log entries"
  },
  "syslog_id": {
    "type": "string",
    "default": "roundcube",
    "description": "Syslog identity string (if using 'syslog' driver)"
  },
  "syslog_facility": {
    "type": "number",
    "default": 6,
    "description": "Syslog facility (0=LOG_USER, 6=LOG_MAIL, etc.)"
  },
  "additional_imap_hosts": {
    "type": "list",
    "default": [],
    "description": "List of additional IMAP hosts (for fallback, failover, or domain-based routing). Each host object includes: hostname, port, tls, auth_type (optional), user/pass (optional).",
    "items": {
      "hostname": {
        "type": "string",
        "description": "IMAP server hostname"
      },
      "port": {
        "type": "number",
        "description": "Port (e.g., 993)"
      },
      "tls": {
        "type": "bool",
        "description": "Use TLS encryption"
      },
      "auth_type": {
        "type": "string",
        "description": "Optional auth type override (e.g., 'cram-md5')"
      },
      "user": {
        "type": "string",
        "description": "Optional explicit username"
      },
      "pass": {
        "type": "string",
        "description": "Optional explicit password"
      }
    }
  },
  "ldap_servers": {
    "type": "list",
    "default": [],
    "description": "Public LDAP address book servers. Each server defines host(s), base DN, filters, field mappings.",
    "items": {
      "name": {
        "type": "string",
        "description": "Unique server identifier"
      },
      "host": {
        "type": "list",
        "description": "LDAP hostnames/IPs (array of strings)"
      },
      "port": {
        "type": "number",
        "description": "LDAP port (389 or 636 for LDAPS)"
      },
      "use_tls": {
        "type": "bool",
        "description": "Use StartTLS"
      },
      "bind_dn": {
        "type": "string",
        "description": "DN to bind as (e.g., 'cn=admin,dc=example,dc=com')"
      },
      "bind_pass": {
        "type": "string",
        "description": "Password for bind DN"
      },
      "base_dn": {
        "type": "string",
        "description": "Base DN for searches (e.g., 'ou=People,dc=example,dc=com')"
      },
      "filter": {
        "type": "string",
        "description": "LDAP search filter (e.g., '(objectClass=posixAccount)')"
      },
      "scope": {
        "type": "string",
        "description": "Search scope: 'sub', 'one', or 'base'"
      },
      "charset": {
        "type": "string",
        "description": "Character set for LDAP operations"
      },
      "fields": {
        "type": "object",
        "description": "Mapping of Roundcube fields to LDAP attributes",
        "properties": {
          "name": {
            "type": "string",
            "default": "cn",
            "description": "LDAP attribute for display name"
          },
          "email": {
            "type": "string",
            "default": "mail",
            "description": "LDAP attribute for email address"
          },
          "phone": {
            "type": "string",
            "default": "telephoneNumber",
            "description": "LDAP attribute for phone"
          },
          "title": {
            "type": "string",
            "default": "title",
            "description": "LDAP attribute for job title"
          }
        }
      }
    }
  },
  "krb5_realm": {
    "type": "string",
    "default": "",
    "description": "Kerberos realm name (e.g., 'EXAMPLE.COM') for GSSAPI auth"
  },
  "krb5_principal": {
    "type": "string",
    "default": "",
    "description": "Kerberos principal pattern (e.g., 'imap/%u@EXAMPLE.COM')"
  },
  "identity_limit": {
    "type": "number",
    "default": 5,
    "description": "Maximum number of identities a user can have"
  },
  "remove_identity": {
    "type": "bool",
    "default": false,
    "description": "Allow users to delete their primary identity"
  },
  "archive_mbox": {
    "type": "string",
    "default": "Archive",
    "description": "Name of the IMAP folder used for archiving"
  },
  "trash_mbox": {
    "type": "string",
    "default": "Trash",
    "description": "Name of the IMAP Trash folder"
  },
  "sent_mbox": {
    "type": "string",
    "default": "Sent",
    "description": "Name of the IMAP Sent folder"
  },
  "drafts_mbox": {
    "type": "string",
    "default": "Drafts",
    "description": "Name of the IMAP Drafts folder"
  },
  "search_folders": {
    "type": "list",
    "default": [],
    "description": "User-defined search folders (DNs for IMAP search)",
    "items": {
      "name": {
        "type": "string",
        "description": "Folder name (displayed in UI)"
      },
      "dn": {
        "type": "string",
        "description": "Search folder DN (e.g., 'imap://user@host/INBOX')"
      }
    }
  },
  "imap_acl_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable IMAP ACL support (requires server-side ACL extension)"
  },
  "sieve_script_root": {
    "type": "string",
    "default": "/etc/dovecot/sieve-global",
    "description": "Directory for global Sieve scripts (if managed externally)"
  },
  "sieve_max_scripts": {
    "type": "number",
    "default": 50,
    "description": "Maximum number of user Sieve scripts"
  },
  "shared_folder": {
    "type": "string",
    "default": "shared",
    "description": "Prefix or suffix for shared folders (e.g., 'shared/' or '.shared.'"
  },
  "shared_storage": {
    "type": "string",
    "default": "imap",
    "description": "Backend for shared folders: 'imap' or 'sql'"
  },
  "preferences_storage": {
    "type": "string",
    "default": "sql",
    "description": "User preferences backend: 'sql' or 'ldap'"
  },
  "preferences_storage_readonly": {
    "type": "bool",
    "default": false,
    "description": "Make preferences read-only (admin-controlled only)"
  },
  "skin_include_php": {
    "type": "bool",
    "default": false,
    "description": "Include PHP files in skin directory (use only for trusted skins)"
  },
  "product_name": {
    "type": "string",
    "default": "Roundcube Webmail",
    "description": "Product name shown in UI and headers"
  },
  "support_url": {
    "type": "string",
    "default": "https://roundcube.net",
    "description": "URL for support/help link in UI"
  }
}
