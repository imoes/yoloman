# Pleaser configuration template
#
# This file configures the 'pleaser' service. It is self-documenting:
# every directive is preceded by a comment describing its purpose and source.

# [include_local] section: manages dynamic inclusion of local configuration snippets.
#
# include_local_includedir: Directory to include local .ini configuration files from.
# Default: /etc/please.d
# This allows administrators to drop additional .ini files into the specified directory,
# which pleaser will read at runtime. Ensure the directory exists and has appropriate permissions.
[include_local]
includedir = {{ include_local_includedir | default('/etc/please.d') }}