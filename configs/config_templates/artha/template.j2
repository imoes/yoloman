# artha(1) configuration file — per-user settings for Artha thesaurus
# Generated for production use with Jinja2.
# This file is self-documenting: every directive is preceded by its schema description.

# Global hotkey to trigger word lookup, e.g., 'Ctrl+Alt+Q'; empty string disables hotkey
# Format is typically 'Ctrl+Alt+KEY'.
hotkey={{ hotkey | default('Ctrl+Alt+W') }}

# Initial display mode: 'simple' (flat relatives) or 'detailed' (tree-view for hierarchical relations)
mode={{ mode | default('simple') }}

# Whether to show passive desktop notifications instead of the application window
# Requires libnotify and a notification daemon to be running.
notifications_enabled={{ notifications_enabled | default(false) | bool | lower }}

# Whether to display word familiarity level (polysemy count) next to definitions
show_familiarity={{ show_familiarity | default(true) | bool | lower }}

# Whether to show a status icon in the system tray
show_status_icon={{ show_status_icon | default(true) | bool | lower }}

# Whether to enable spell-based suggestions for misspelled queries (requires libenchant)
suggestions_enabled={{ suggestions_enabled | default(true) | bool | lower }}

# List of custom dictionary file paths (WordNet .index files); empty means default WordNet only
# Multiple paths are comma-separated.
dictionaries={{ dictionaries | default([]) | join(',') }}

# Whether to allow Wildmat-style regex patterns in search (e.g., cro*p, can????r)
regex_search_enabled={{ regex_search_enabled | default(false) | bool | lower }}