{
  "home_dir": "/var/lib/weechat",
  "run_as_daemon": true,
  "log_to_stdout": false,
  "no_connect": false,
  "no_plugin": false,
  "no_script": false,
  "plugins": [
    "irc",
    "python"
  ],
  "run_commands": [
    "/server add irc irc.libera.chat",
    "/connect irc",
    "/set irc.server_default.automatic_connect on"
  ],
  "use_temp_dir": false,
  "run_upgrade": false
}
