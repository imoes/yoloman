{
  "client_log_dir": "/var/log/amanda",
  "lockfile_dir": "/var/run",
  "client_name": "client01.example.com",
  "client_port": "10080",
  "use_tcp_wrappers": true,
  "tcp_wrappers_file": "/etc/hosts.allow",
  "compress": "gzip",
  "max_tps": 0,
  "hold_tape": false,
  "disks": [
    {
      "mount_point": "/",
      "comment": "Root filesystem",
      "trust": "client",
      "auth": "bsdtcp",
      "index": "yes",
      "backup": "find",
      "bump": "skip",
      "bump_days": 7,
      "bump_size": 1024,
      "bump_total_size": 10000,
      "bump_total_days": 365,
      "max_bumps": 3,
      "max_size": 0,
      "max_total_size": 0,
      "max_total_days": 0,
      "priority": "high",
      "taper_algo": "single",
      "taper_max_size": 0,
      "taper_min_size": 0,
      "taper_scan_size": 0,
      "taper_scan_time": 0,
      "taper_switch_size": 0,
      "taper_switch_time": 0,
      "taper_wait_time": 300,
      "taper_write_speed": 0,
      "taper_write_speed_max": 0,
      "taper_write_speed_min": 0,
      "taper_write_speed_target": 0,
      "taper_write_speed_window": 60
    },
    {
      "mount_point": "/home",
      "comment": "User home directories",
      "trust": "client",
      "auth": "bsdtcp",
      "index": "yes",
      "backup": "dump",
      "bump": "skip",
      "bump_days": 3,
      "bump_size": 512,
      "bump_total_size": 5000,
      "bump_total_days": 180,
      "max_bumps": 5,
      "max_size": 0,
      "max_total_size": 0,
      "max_total_days": 0,
      "priority": "medium",
      "taper_algo": "incremental",
      "taper_max_size": 0,
      "taper_min_size": 0,
      "taper_scan_size": 0,
      "taper_scan_time": 0,
      "taper_switch_size": 0,
      "taper_switch_time": 0,
      "taper_wait_time": 300,
      "taper_write_speed": 0,
      "taper_write_speed_max": 0,
      "taper_write_speed_min": 0,
      "taper_write_speed_target": 0,
      "taper_write_speed_window": 60
    }
  ],
  "tapes": [
    {
      "device": "/dev/st0",
      "comment": "Primary backup tape",
      "label": "auto",
      "driver": "auto",
      "block_size": 0,
      "rewind": true,
      "rewind_after": "all",
      "rewind_timeout": 60,
      "skip_blocks": 0,
      "sparse": false,
      "strict_eod": true,
      "tape_label": "AMANDA",
      "tape_size": 800000,
      "tape_type": "LTO",
      "write_protect": "none"
    }
  ],
  "extra_options": [
    "# Allow only local and Amanda server to connect",
    "server \"amanda.example.com\""
  ]
}
