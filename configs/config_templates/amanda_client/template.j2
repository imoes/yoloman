# Amanda client configuration
# This file configures the Amanda client (amdump/amrestore behavior on this host)
# Must be world-readable but not world-writable
# See amanda-client.conf(5) for full details

# Client configuration file: do not edit manually — managed by configuration management

# Base directory for Amanda client logs and temporary files
{% if client_log_dir %}client_log_dir "{{ client_log_dir }}"{% endif %}

# Directory where Amanda stores its lock files
{% if lockfile_dir %}lockfile_dir "{{ lockfile_dir }}"{% endif %}

# Amanda client’s identity on the network — must match the client hostname used by the server
{% if client_name %}client_name "{{ client_name }}"{% endif %}

# Network port the Amanda client listens on (default: 10080)
{% if client_port %}client_port "{{ client_port }}"{% endif %}

# Whether to use TCP wrappers for access control
{% if use_tcp_wrappers %}use_tcp_wrappers "{{ use_tcp_wrappers | lower }}"{% endif %}

# Path to the TCP wrappers access file (typically /etc/hosts.allow)
{% if tcp_wrappers_file %}tcp_wrappers_file "{{ tcp_wrappers_file }}"{% endif %}

# Compression algorithm for backup streams (none|fast|best|gzip|lzo|bzip2)
{% if compress %}compress "{{ compress }}"{% endif %}

# Maximum tape write speed in KB/s (0 = unlimited)
{% if max_tps %}max_tps "{{ max_tps }}"{% endif %}

# Whether to run the amandahold process to hold tapes after backup
{% if hold_tape %}hold_tape "{{ hold_tape | lower }}"{% endif %}

# List of disk definitions (each defines a filesystem to back up)
{% for disk in disks %}disk {{ disk.mount_point }} {
{% if disk.comment %}    comment "{{ disk.comment }}"{% endif %}
    trust {{ disk.trust | lower }}
{% if disk.auth %}    auth "{{ disk.auth }}"{% endif %}
{% if disk.index %}    index "{{ disk.index }}"{% endif %}
{% if disk.backup %}    backup "{{ disk.backup }}"{% endif %}
{% if disk.bump %}    bump "{{ disk.bump }}"{% endif %}
{% if disk.bump_days %}    bump_days "{{ disk.bump_days }}"{% endif %}
{% if disk.bump_size %}    bump_size "{{ disk.bump_size }}"{% endif %}
{% if disk.bump_total_size %}    bump_total_size "{{ disk.bump_total_size }}"{% endif %}
{% if disk.bump_total_days %}    bump_total_days "{{ disk.bump_total_days }}"{% endif %}
{% if disk.max_bumps %}    max_bumps "{{ max_bumps }}"{% endif %}
{% if disk.max_size %}    max_size "{{ disk.max_size }}"{% endif %}
{% if disk.max_total_size %}    max_total_size "{{ disk.max_total_size }}"{% endif %}
{% if disk.max_total_days %}    max_total_days "{{ disk.max_total_days }}"{% endif %}
{% if disk.priority %}    priority "{{ disk.priority }}"{% endif %}
{% if disk.taper_algo %}    taper_algo "{{ taper_algo }}"{% endif %}
{% if disk.taper_max_size %}    taper_max_size "{{ disk.taper_max_size }}"{% endif %}
{% if disk.taper_min_size %}    taper_min_size "{{ disk.taper_min_size }}"{% endif %}
{% if disk.taper_scan_size %}    taper_scan_size "{{ disk.taper_scan_size }}"{% endif %}
{% if disk.taper_scan_time %}    taper_scan_time "{{ disk.taper_scan_time }}"{% endif %}
{% if disk.taper_switch_size %}    taper_switch_size "{{ disk.switch_size }}"{% endif %}
{% if disk.taper_switch_time %}    taper_switch_time "{{ disk.switch_time }}"{% endif %}
{% if disk.taper_wait_time %}    taper_wait_time "{{ disk.wait_time }}"{% endif %}
{% if disk.taper_write_speed %}    taper_write_speed "{{ disk.write_speed }}"{% endif %}
{% if disk.taper_write_speed_max %}    taper_write_speed_max "{{ disk.write_speed_max }}"{% endif %}
{% if disk.taper_write_speed_min %}    taper_write_speed_min "{{ disk.write_speed_min }}"{% endif %}
{% if disk.taper_write_speed_target %}    taper_write_speed_target "{{ disk.write_speed_target }}"{% endif %}
{% if disk.taper_write_speed_window %}    taper_write_speed_window "{{ disk.write_speed_window }}"{% endif %}
{% endfor %}

# List of tape device definitions (for direct-to-disk or local tape use)
{% for tape in tapes %}tape_device {{ tape.device }} {
{% if tape.comment %}    comment "{{ tape.comment }}"{% endif %}
{% if tape.label %}    label "{{ tape.label }}"{% endif %}
{% if tape.driver %}    driver "{{ tape.driver }}"{% endif %}
{% if tape.block_size %}    block_size "{{ tape.block_size }}"{% endif %}
{% if tape.rewind %}    rewind "{{ tape.rewind | lower }}"{% endif %}
{% if tape.rewind_after %}    rewind_after "{{ tape.rewind_after }}"{% endif %}
{% if tape.rewind_timeout %}    rewind_timeout "{{ tape.rewind_timeout }}"{% endif %}
{% if tape.skip_blocks %}    skip_blocks "{{ tape.skip_blocks }}"{% endif %}
{% if tape.sparse %}    sparse "{{ tape.sparse | lower }}"{% endif %}
{% if tape.strict_eod %}    strict_eod "{{ tape.strict_eod | lower }}"{% endif %}
{% if tape.tape_label %}    tape_label "{{ tape.tape_label }}"{% endif %}
{% if tape.tape_size %}    tape_size "{{ tape.tape_size }}"{% endif %}
{% if tape.tape_type %}    tape_type "{{ tape.tape_type }}"{% endif %}
{% if tape.write_protect %}    write_protect "{{ tape.write_protect }}"{% endif %}
{% endfor %}

# Optional: Extra client options
{% if extra_options %}# Additional options
{% for opt in extra_options %}{{ opt }}
{% endfor %}{% endif %}
