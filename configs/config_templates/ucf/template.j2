#
# This file is a POSIX shell snippet, and is sourced by the
# ucf script for configuration.
#

# Debugging information: Set to 1 to enable debugging output.
# Default value is 0 (no debugging information is printed).
DEBUG={{ debug | default('0') }}

# Verbosity: Set to 1 to enable verbose output.
# Default value is 0 (quiet).
VERBOSE={{ verbosity | default('0') }}

# The source directory where historical md5sums are looked for.
# Specifically, the historical md5sums are looked for in the subdirectory ${filename}.md5sum.d/
# Default is '/some/path/'.
conf_source_dir={{ conf_source_dir | default('/some/path/') }}

# Force retaining the old configuration file. Set to YES to enable.
# Default is YES.
conf_force_conffold={{ conf_force_confffold | default('YES') }}

# Force overriding with the new configuration file. Set to YES to enable.
# Default is YES.
# Please note that only one of conf_force_conffold and conf_force_conffnew should be set.
conf_force_conffnew={{ conf_force_conffnew | default('YES') }}