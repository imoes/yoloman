{
  "accounts_dir": "~/.offlineimap/accounts",
  "maxsyncaccounts": 3,
  "ui": "Quiet",
  "showmailstats": false,
  "accounts": [
    {
      "name": "Gmail",
      "remote_host": "imap.gmail.com",
      "remote_port": 993,
      "remote_user": "user@gmail.com",
      "remote_pass_command": "gpg --quiet --for-your-eyes-only --decrypt ~/.authinfo.gpg | grep 'machine imap.gmail.com' | cut -d' ' -f4",
      "remote_ssl": true,
      "ssl_verify": "cert",
      "local_path": "~/Mail/Gmail",
      "autosync": true,
      "expunge": false,
      "syncstatus": true
    },
    {
      "name": "Work",
      "remote_host": "mail.company.com",
      "remote_port": 993,
      "remote_user": "user@company.com",
      "remote_pass": "secret123",
      "remote_ssl": true,
      "ssl_verify": "cert",
      "local_path": "~/Mail/Work",
      "autosync": true,
      "expunge": false,
      "syncstatus": true,
      "maxaccountsyncs": 1
    }
  ]
}
