# Configuration for ngrep network packet analysis
# This template generates a configuration file for ngrep, a network packet analyzer.

# Interface to listen on. If empty or not specified, ngrep selects the default interface.
# Corresponds to: -d dev
# @default ''
dev: {{ dev | default('') }}

# Extended regular expression match pattern (PCRE2).
# Corresponds to: match expression
# @default ''
match_expression: "{{ match_expression | default('') }}"

# BPF (Berkeley Packet Filter) string to select packets (e.g., 'host 1.2.3.4').
# Corresponds to: bpf filter
# @default ''
bpf_filter: "{{ bpf_filter | default('') }}"

# Maximum number of packets to match before exiting. 0 means no limit.
# Corresponds to: -n num
# @default 0
num_packets: {{ num_packets | default(0) }}

# Snap length for the BPF capture (max bytes to capture per packet).
# Corresponds to: -s snaplen
# @default 65536
snaplen: {{ snaplen | default(65536) }}

# Upper limit on the size of packets ngrep will analyze. 0 means no limit.
# Corresponds to: -S limitlen
# @default 0
limitlen: {{ limitlen | default(0) }}

# Output display mode: normal, byline, single, or none.
# Corresponds to: -W
# @default 'normal'
output_mode: "{{ output_mode | default('normal') }}"

# Number of trailing context packets to dump after a match.
# Corresponds to: -A num
# @default 0
trailing_context: {{ trailing_context | default(0) }}

# Input pcap dump file to read from. If specified, ngrep reads this file instead of live capture.
# Corresponds to: -I pcap_dump
# @default ''
input_file: "{{ input_file | default('') }}"

# Output matched packets to a pcap-compatible dump file.
# Corresponds to: -O pcap_dump
# @default ''
output_file: "{{ output_file | default('') }}"

# Alternate character to signify non-printable characters in output.
# Corresponds to: -P char
# @default '.'
non_printable_char: "{{ non_printable_char | default('.') }}"

# Drop privileges after opening the interface. If false, it retains root.
# Corresponds to: -R (drop_privs)
# @default true
drop_privs: {{ drop_privs | default(true) | lower }}