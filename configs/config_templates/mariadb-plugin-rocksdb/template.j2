# mariadb-plugin-rocksdb configuration template
# This template configures MariaDB to load the RocksDB storage engine plugin.
# It is intended for use in roles managing MariaDB server instances.

[mariadb]
# plugin_load_add: The RocksDB storage engine plugin to load.
# Defaults to 'ha_rocksdb.so'. Ensure the plugin file is available in the plugin directory
# specified in the main MariaDB/MySQL configuration.
plugin-load-add = {{ plugin_load_add | default('ha_rocksdb.so') }}
