{
  "input_encoding": "utf-8",
  "output_encoding": "utf-8",
  "input_locale": "pt_BR.UTF-8",
  "output_locale": "en_US.UTF-8",
  "mode": "convert",
  "convert_source": "http://example.com/data.csv",
  "convert_destination": "/var/lib/rows/output/data.csv",
  "join_keys": [
    "customer_id"
  ],
  "join_sources": [
    "/var/lib/rows/input/orders.csv",
    "/var/lib/rows/input/customers.csv"
  ],
  "join_destination": "/var/lib/rows/output/orders_full.csv",
  "sort_key": "created_at",
  "sort_source": "/var/lib/rows/input/data.csv",
  "sort_destination": "/var/lib/rows/output/sorted.csv",
  "sum_sources": [
    "/var/lib/rows/input/q1.csv",
    "/var/lib/rows/input/q2.csv"
  ],
  "sum_destination": "/var/lib/rows/output/h1.csv"
}
