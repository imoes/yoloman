{
  "log_level": "info",
  "log_file": "/var/log/canid/canid.log",
  "pid_file": "/run/canid/canid.pid",
  "worker_count": 2,
  "max_cache_entries": 100000,
  "default_ttl": 3600,
  "interfaces": [
    {
      "name": "eth0",
      "description": "Primary LAN interface",
      "enabled": true
    },
    {
      "name": "wlan0",
      "description": "WiFi interface",
      "enabled": false
    }
  ],
  "upstream_servers": [
    {
      "address": "208.67.222.222",
      "port": 53
    },
    {
      "address": "208.67.220.220",
      "port": 53
    }
  ],
  "storage": {
    "type": "file",
    "path": "/var/lib/canid/cache.db"
  },
  "allow_sources": [
    "10.0.0.0/8",
    "192.168.1.0/24"
  ],
  "enable_ipv6": true,
  "enable_dnssec_validation": true
}
