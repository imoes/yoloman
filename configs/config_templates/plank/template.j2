# Plank configuration template
# Plank is a dock/launcher for Linux. This section controls its core identity and behavior.

# [plank] Section
plank = {
	# impl: The implementation backend for Plank.
	# Default: launchpad
	'impl' : '{{ impl | default("launchpad") }}',

	# project: The project name associated with Plank.
	# Default: plank
	'project' : '{{ project | default("plank") }}',

	# bug_pattern_base: Base URL or pattern for bug reporting. Set to a string URL or None.
	# Default: None
	'bug_pattern_base' : {{ bug_pattern_base | default("None") }},
}