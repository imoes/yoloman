{
  "apt_offline_enabled": true,
  "apt_offline_sig_dir": "/var/lib/apt-offline",
  "apt_offline_cache_dir": "/var/cache/apt/archives",
  "apt_offline_download_dir": "/tmp/apt-offline-downloads",
  "apt_offline_threads": 1,
  "apt_offline_bundles_dir": "/var/lib/apt-offline/bundles",
  "apt_offline_proxies": [
    {
      "host": "proxy.example.com",
      "port": 3128,
      "scheme": "http"
    }
  ],
  "apt_offline_https_auth": {
    "cert_file": "/etc/ssl/client.crt",
    "key_file": "/etc/ssl/client.key"
  },
  "apt_offline_http_basicauth_urls": [
    "user:pass%21%40%23@internal.repo.example.com"
  ],
  "apt_offline_disable_cert_check": false,
  "apt_offline_apt_backend": "apt-get",
  "apt_offline_skip_changelog": true,
  "apt_offline_skip_bug_reports": true,
  "apt_offline_allow_unauthenticated": false,
  "apt_offline_strict_deb_check": false,
  "apt_offline_install_src_path": "/opt/apt-offline/src",
  "apt_offline_sources_list_d_files": [
    {
      "name": "apt-offline-main",
      "content": "deb https://deb.debian.org/debian stable main contrib\n# deb-src https://deb.debian.org/debian stable main contrib\n"
    },
    {
      "name": "apt-offline-security",
      "content": "deb https://deb.debian.org/debian-security stable/updates main contrib\n"
    }
  ]
}
