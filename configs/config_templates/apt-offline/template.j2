# apt-offline configuration
# This file is generated by Ansible. Do NOT edit manually.
# Configuration applies only when apt_offline_enabled is True.

{% if apt_offline_enabled | default(false) %}
# =============================================================================
# Global Settings
# =============================================================================

# Directory where signature files (e.g., *.sig) are stored.
# Default: /var/lib/apt-offline
APT_OFFLINE_SIG_DIR={{ (apt_offline_sig_dir | default('/var/lib/apt-offline')) }}

# Directory to use as cache before downloading packages from the internet.
# Default: /var/cache/apt-offline
APT_OFFLINE_CACHE_DIR={{ (apt_offline_cache_dir | default('/var/cache/apt-offline')) }}

# Directory to download packages when no explicit --download-dir is provided.
# Default: /tmp/apt-offline-downloads
APT_OFFLINE_DOWNLOAD_DIR={{ (apt_offline_download_dir | default('/tmp/apt-offline-downloads')) }}

# Number of threads for concurrent downloads (1 recommended to avoid overload).
# Default: 1
APT_OFFLINE_THREADS={{ (apt_offline_threads | default(1) | int) }}

# Directory where bundle (.zip) files are stored.
# Default: /var/lib/apt-offline/bundles
APT_OFFLINE_BUNDLES_DIR={{ (apt_offline_bundles_dir | default('/var/lib/apt-offline/bundles')) }}

# =============================================================================
# Proxy Configuration
# =============================================================================
# List of proxy configurations to use during get operations.
# Each entry specifies host, optional port, and optional scheme (http/https).
{% for proxy in (apt_offline_proxies | default([])) %}
# Proxy entry {{ loop.index }}
# Host of the proxy server
{% if proxy.host is defined and proxy.host %}
APT_OFFLINE_PROXY_HOST={{ proxy.host }}
{% endif %}

# Port of the proxy server (default 3128 if not specified)
{% if proxy.port is defined and proxy.port %}
APT_OFFLINE_PROXY_PORT={{ proxy.port }}
{% elif proxy.host is defined and proxy.host %}
# No explicit port set, using default
{% endif %}

# Scheme used for proxy connections (default 'http')
{% if proxy.scheme is defined and proxy.scheme %}
APT_OFFLINE_PROXY_SCHEME={{ proxy.scheme }}
{% elif proxy.host is defined and proxy.host %}
# No explicit scheme set, using default
{% endif %}
{% endfor %}

# =============================================================================
# HTTPS Authentication
# =============================================================================
# HTTPS client-authentication credentials. Contains cert_file and key_file paths.
# Only used if both are provided.
{% if apt_offline_https_auth is defined and apt_offline_https_auth is mapping %}
# Client certificate for HTTPS authentication
{% if apt_offline_https_auth.cert_file is defined and apt_offline_https_auth.cert_file %}
APT_OFFLINE_HTTPS_CERT_FILE={{ apt_offline_https_auth.cert_file }}
{% endif %}

# Client private key for HTTPS authentication
{% if apt_offline_https_auth.key_file is defined and apt_offline_https_auth.key_file %}
APT_OFFLINE_HTTPS_KEY_FILE={{ apt_offline_https_auth.key_file }}
{% endif %}
{% endif %}

# =============================================================================
# HTTP Basic Auth URLs
# =============================================================================
# List of URLs with embedded basic auth (e.g., 'user:pass@example.com').
# Encoded per RFC-3986.
{% for url in (apt_offline_http_basicauth_urls | default([])) %}
# URL with embedded basic auth
APT_OFFLINE_HTTP_BASICAUTH={{ url }}
{% endfor %}

# =============================================================================
# Security & Validation Flags
# =============================================================================

# Disable HTTPS certificate verification (not recommended in production).
# Default: False
{% if apt_offline_disable_cert_check | default(false) %}
APT_OFFLINE_DISABLE_CERT_CHECK=true
{% endif %}

# APT backend to use: one of 'apt', 'apt-get', or 'python-apt'.
# Default: apt-get
APT_OFFLINE_APT_BACKEND={{ (apt_offline_apt_backend | default('apt-get')) }}

# Skip display of changelog during install operations.
# Default: False
{% if apt_offline_skip_changelog | default(false) %}
APT_OFFLINE_SKIP_CHANGELOG=true
{% endif %}

# Skip listing of bug reports during install operations.
# Default: False
{% if apt_offline_skip_bug_reports | default(false) %}
APT_OFFLINE_SKIP_BUG_REPORTS=true
{% endif %}

# Skip GPG signature verification during install (highly discouraged).
# Default: False
{% if apt_offline_allow_unauthenticated | default(false) %}
APT_OFFLINE_ALLOW_UNAUTHENTICATED=true
{% endif %}

# Delegate .deb checksum validation to apt (may trigger network checks even when offline).
# Default: False
{% if apt_offline_strict_deb_check | default(false) %}
APT_OFFLINE_STRICT_DEB_CHECK=true
{% endif %}

# Path where source packages should be installed during install operations.
# Default: None
{% if apt_offline_install_src_path is defined and apt_offline_install_src_path %}
APT_OFFLINE_INSTALL_SRC_PATH={{ apt_offline_install_src_path }}
{% endif %}

# =============================================================================
# APT Repository Fragments
# =============================================================================
# List of APT repository fragments for apt-offline setup.
# Required on fresh installs without network.
{% for src in (apt_offline_sources_list_d_files | default([])) %}
# Repository source: {{ src.name if src.name is defined else 'Unnamed' }}
{% if src.content is defined and src.content %}
{{ src.content }}
{% endif %}
{% endfor %}

{% endif %}