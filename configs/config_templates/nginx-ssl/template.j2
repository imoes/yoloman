# Main NGINX worker and event configuration
worker_processes auto;

events {
    worker_connections {{ worker_connections }};
}

http {
    # Basic settings
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout {{ keepalive_timeout }};
    types_hash_max_size {{ types_hash_max_size }};

    # Logging
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types {{ gzip_types | join(', ') }};
    gzip_comp_level {{ gzip_comp_level }};

    # SSL settings
    ssl_protocols {{ ssl_protocols | join(' ') }};
    ssl_prefer_server_ciphers on;
    ssl_ciphers '{{ ssl_ciphers }}';
    ssl_session_cache shared:SSL:{{ ssl_session_cache_size }};
    ssl_session_timeout {{ ssl_session_timeout }}m;

    # Include MIME types
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Load modulated server blocks
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
