{
  "port": 2055,
  "host": "0.0.0.0",
  "base_dir": "/var/cache/nfdump",
  "subdir": "current",
  "retention": 3600,
  "compress_after": 300,
  "compress_program": "gzip",
  "flush_interval": 0,
  "pipe_program": "",
  "user": "nobody",
  "group": "nobody",
  "extended": true,
  "ipv6": true,
  "loglevel": "warning",
  "logfile": "/var/log/nfcapd.log",
  "pidfile": true,
  "accept_versions": [
    5,
    9,
    10
  ],
  "bgp": false,
  "formats": [
    "nfcapd"
  ],
  "ssl": false,
  "ssl_cert": "",
  "ssl_key": "",
  "ssl_ca_cert": "",
  "no_padding": false,
  "idle_timeout": 300,
  "active_timeout": 1800,
  "read_buffer": 8192,
  "max_open_files": 1024,
  "no_dns": true,
  "cpu_affinity": [],
  "nanoseconds": false,
  "sample_infer": true,
  "no_coalesce": false,
  "forward": [
    {
      "host": "10.0.0.5",
      "port": 2055,
      "proto": "udp"
    },
    {
      "host": "192.168.1.10",
      "port": 4739,
      "proto": "tcp"
    }
  ]
}
