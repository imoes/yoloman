[General]
# portable: If true, stores all settings in the executable folder (portable mode). Corresponds to -p command-line option.
Portable={{ portable | default(false) | string | lower }}

# nosplash: If true, disables the splash screen on startup. Corresponds to -s command-line option.
# Note: The ini key 'ShowSplash' is inverted relative to the variable name.
ShowSplash={{ nosplash | default(false) | ternary('false', 'true') }}

# notrayicon: If true, disables the tray icon. Corresponds to -t command-line option.
# Note: The ini key 'ShowTrayIcon' is inverted relative to the variable name.
ShowTrayIcon={{ notrayicon | default(false) | ternary('false', 'true') }}

# language: Application language code (e.g., 'en', 'fr', 'de'). Default: 'en'.
Language={{ language | default('en') }}

# last_script: Path to the last opened script file. Typically auto-populated by Actiona.
LastScript={{ last_script | default('') }}

[Execution]
# noexecutionwindow: If true, hides the execution window by default. Corresponds to -E command-line option.
# Note: The ini key 'ShowExecutionWindow' is inverted relative to the variable name.
ShowExecutionWindow={{ noexecutionwindow | default(false) | ternary('false', 'true') }}

# noconsolewindow: If true, hides the console window by default. Corresponds to -C command-line option.
# Note: The ini key 'ShowConsoleWindow' is inverted relative to the variable name.
ShowConsoleWindow={{ noconsolewindow | default(false) | ternary('false', 'true') }}

# nocodeqt: If true, excludes the Qt library when building standalone executables. Corresponds to -Q command-line option.
# Note: The ini key 'EmbedQt' is inverted relative to the variable name.
EmbedQt={{ nocodeqt | default(false) | ternary('false', 'true') }}