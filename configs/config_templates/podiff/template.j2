# /etc/default/podiff
# Global options for podiff
# Path to the diff utility to use for generating diffs.
DIFF_CMD={{ diff_cmd | default('/usr/bin/diff') }}

# String of options to pass to the diff utility.
DIFF_OPTS={{ diff_opts | default('-u') }}

# If true, fuzzy translations are ignored during comparison.
IGNORE_FUZZY={{ ignore_fuzzy | default(false) | lower }}

# If true, user comments are preserved in the output.
KEEP_COMMENTS={{ keep_comments | default(false) | lower }}

# If true, enables support for the -L option for Git integration.
GIT_L_OPTION={{ git_l_option | default(false) | lower }}

# Maximum width of the output in columns. 0 means no limit.
OUTPUT_WIDTH={{ output_width | default(0) }}