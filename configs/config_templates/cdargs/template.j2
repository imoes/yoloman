{# cdargs bookmarks file #}
{# cdargs uses a simple text file to store directory bookmarks. #}
{# Format per line: [description:]path #}
{# If a description is provided, it is followed by a colon and then the absolute path. #}
{# If no description is given, only the path is written. #}
{# Lines starting with # are treated as comments by cdargs and are ignored. #}
{# The 'bookmarks' variable is expected to be a list of objects, each containing 'path' and optionally 'description'. #}
{% for entry in bookmarks | default([]) %}{# Iterate over the list of bookmarks, defaulting to an empty list if undefined. #}
{% if entry.description | default('') | trim != '' %}{{ entry.description }}:{{ entry.path }}{% else %}{{ entry.path }}{% endif %}{# If the entry has a description, write 'description:path', otherwise just 'path'. #}
{% endfor %}