{
 "dhcp_key_algorithm": {
  "default": "hmac-sha256",
  "description": "Algorithm for DHCP TSIG key",
  "type": "string"
 },
 "dhcp_key_name": {
  "default": "dhcp-updater",
  "description": "TSIG key name used by DHCP server for dynamic DNS updates (must match key defined in DHCP server config)",
  "type": "string"
 },
 "dhcp_key_secret": {
  "default": "",
  "description": "Base64 secret for DHCP TSIG key (generated by 'ddns-confgen -a hmac-sha256')",
  "sensitive": true,
  "type": "string"
 },
 "dlz": {
  "description": "DLZ (Dynamic Loadable Zone) configuration — enables external DHCP systems to update DNS",
  "properties": {
   "backend_module": {
    "default": "postgres",
    "description": "DLZ backend module (e.g., 'postgres', 'mysql', 'ldap', 'file')",
    "type": "string"
   },
   "params": {
    "default": [
     "host=localhost",
     "dbname=dns",
     "user=dns",
     "password=secret"
    ],
    "description": "Backend connection parameters (space-separated key=value)",
    "items": {
     "type": "string"
    },
    "type": "list"
   }
  },
  "type": "object"
 },
 "include_extra": {
  "default": false,
  "description": "Whether to include an extra config fragment (e.g., for modular DNSSEC keys or split views)",
  "type": "bool"
 },
 "include_extra_path": {
  "default": "/etc/bind/named.conf.extra",
  "description": "Path to extra configuration fragment (used if include_extra is true)",
  "type": "string"
 },
 "logging": {
  "description": "Logging configuration: channels and categories",
  "properties": {
   "categories": {
    "default": [
     {
      "channels": [
       "default_channel"
      ],
      "name": "default"
     },
     {
      "channels": [
       "security_channel"
      ],
      "name": "security"
     }
    ],
    "description": "Log categories: map BIND subsystems to channels",
    "items": {
     "properties": {
      "channels": {
       "default": [],
       "description": "Channels to receive this category's logs",
       "items": {
        "type": "string"
       },
       "type": "list"
      },
      "name": {
       "default": "",
       "description": "Log category (e.g., 'security', 'queries', 'network')",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "list"
   },
   "channels": {
    "default": [],
    "description": "Log channels: define destinations and formatting",
    "items": {
     "properties": {
      "file": {
       "default": "",
       "description": "Path to log file (optional)",
       "type": "string"
      },
      "name": {
       "default": "",
       "description": "Channel name",
       "type": "string"
      },
      "print_category": {
       "default": true,
       "description": "Include log category in entries",
       "type": "bool"
      },
      "print_severity": {
       "default": true,
       "description": "Include severity in log entries",
       "type": "bool"
      },
      "print_time": {
       "default": true,
       "description": "Prefix log entries with timestamp",
       "type": "bool"
      },
      "severity": {
       "default": "info",
       "description": "Minimum severity level (e.g., 'info', 'warning', 'error')",
       "type": "string"
      },
      "size": {
       "default": "5m",
       "description": "Max log file size (e.g., '5m', '100M')",
       "type": "string"
      },
      "syslog": {
       "default": "",
       "description": "Syslog facility (e.g., 'daemon', 'local0')",
       "type": "string"
      },
      "versions": {
       "default": 3,
       "description": "Number of rotated log files to keep",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "list"
   }
  },
  "type": "object"
 },
 "options": {
  "description": "Global BIND options (paths, recursion, security, listen addresses)",
  "properties": {
   "allow_query": {
    "default": [
     "any"
    ],
    "description": "List of clients allowed to query this server (e.g., 'localhost', '192.168.1.0/24', 'none')",
    "items": {
     "type": "string"
    },
    "type": "list"
   },
   "allow_recursion": {
    "default": [
     "localhost"
    ],
    "description": "Clients allowed to perform recursive queries",
    "items": {
     "type": "string"
    },
    "type": "list"
   },
   "directory": {
    "default": "/var/cache/bind",
    "description": "Working directory for zone files and temporary files",
    "type": "string"
   },
   "forwarders": {
    "default": [
     "8.8.8.8",
     "1.1.1.1"
    ],
    "description": "Upstream DNS servers for recursive resolution",
    "items": {
     "type": "string"
    },
    "type": "list"
   },
   "listen_addresses": {
    "default": [
     "127.0.0.1"
    ],
    "description": "IPv4 addresses to bind to (e.g., ['192.168.1.1'])",
    "items": {
     "type": "string"
    },
    "type": "list"
   },
   "listen_addresses_v6": {
    "default": [],
    "description": "IPv6 addresses to bind to (e.g., ['::1', '2001:db8::1'])",
    "items": {
     "type": "string"
    },
    "type": "list"
   },
   "max_queries_per_connection": {
    "default": 1000,
    "description": "Maximum number of queries allowed per TCP connection",
    "type": "number"
   },
   "pid_file": {
    "default": "/run/named/named.pid",
    "description": "Path to the PID file",
    "type": "string"
   },
   "port": {
    "default": 53,
    "description": "DNS port to listen on (typically 53)",
    "type": "number"
   },
   "recursion": {
    "default": true,
    "description": "Enable recursive queries (set to false for authoritative-only)",
    "type": "bool"
   },
   "version_string": {
    "default": "hidden",
    "description": "BIND version string returned in version queries (use 'hidden' or a custom string to obfuscate)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "reverse_zones": {
  "default": [],
  "description": "Reverse lookup zones for ARPA (IPv4) or IP6.ARPA (IPv6) — used for DHCP-assigned address DNS entries",
  "items": {
   "properties": {
    "allow_query": {
     "default": [
      "any"
     ],
     "description": "Clients allowed to query reverse zone",
     "items": {
      "type": "string"
     },
     "type": "list"
    },
    "file": {
     "default": "",
     "description": "Zone file path",
     "type": "string"
    },
    "type": {
     "default": "master",
     "description": "Zone type (usually 'master')",
     "type": "string"
    },
    "update_policy": {
     "default": [],
     "description": "PTR update permissions (e.g., 'grant dhcp-update wildcard PTR;')",
     "items": {
      "type": "string"
     },
     "type": "list"
    },
    "zone_name": {
     "default": "",
     "description": "Reverse zone name (e.g., '1.168.192.in-addr.arpa')",
     "type": "string"
    }
   },
   "type": "object"
  },
  "type": "list"
 },
 "tsig": {
  "description": "TSIG key for authenticated dynamic updates (e.g., from DHCP server)",
  "properties": {
   "algorithm": {
    "default": "hmac-sha256",
    "description": "TSIG algorithm (e.g., 'hmac-sha256', 'hmac-sha512')",
    "type": "string"
   },
   "key_name": {
    "default": "dhcp-update",
    "description": "Name of the TSIG key (must match DHCP server configuration)",
    "type": "string"
   },
   "secret": {
    "default": "",
    "description": "Base64-encoded secret (generated by 'ddns-confgen' or 'tsig-keygen')",
    "sensitive": true,
    "type": "string"
   }
  },
  "type": "object"
 },
 "zones": {
  "default": [],
  "description": "Zone definitions — authoritative zones served by this server",
  "items": {
   "properties": {
    "allow_query": {
     "default": [
      "any"
     ],
     "description": "Clients allowed to query this zone (overrides global if set)",
     "items": {
      "type": "string"
     },
     "type": "list"
    },
    "allow_transfer": {
     "default": [],
     "description": "Allowed secondary servers for zone transfers (e.g., ['192.168.1.2'])",
     "items": {
      "type": "string"
     },
     "type": "list"
    },
    "file": {
     "default": "",
     "description": "Path to zone file (relative to 'options.directory')",
     "type": "string"
    },
    "masters": {
     "default": [],
     "description": "Master server IPs for slave zones",
     "items": {
      "type": "string"
     },
     "type": "list"
    },
    "name": {
     "default": "",
     "description": "Zone name (e.g., 'example.com')",
     "type": "string"
    },
    "notify": {
     "default": "yes",
     "description": "Send AXFR notify (yes/no/explicit)",
     "type": "string"
    },
    "type": {
     "default": "master",
     "description": "Zone type: 'master' or 'slave'",
     "type": "string"
    },
    "update_policy": {
     "default": [],
     "description": "TSIG/update permissions (e.g., 'grant dhcp-update subdomain example.com A;')",
     "items": {
      "type": "string"
     },
     "type": "list"
    }
   },
   "type": "object"
  },
  "type": "list"
 }
}
