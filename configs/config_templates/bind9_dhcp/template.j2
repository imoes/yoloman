# Global options that apply to all zones and queries
options {
    directory "{{ options.directory }}";
    pid-file "{{ options.pid_file }}";
    allow-query { {{ options.allow_query | join(', ') }} };

    # DNSSEC validation settings
    dnssec-validation auto;

    # Forwarders for external resolution
    forwarders {
        {{ for forwarder in options.forwarders }}
        {{ forwarder }};
        {{ endfor }}
    };

    # Listen on specific interfaces and ports
    listen-on port {{ options.port }} { {{ for addr in options.listen_addresses }}{{ addr }}; {{ endfor }} };
    listen-on-v6 port {{ options.port }} { {{ for addr6 in options.listen_addresses_v6 }}{{ addr6 }}; {{ endfor }} };

    # Rate limiting and recursion control
    max-queries-per-connection {{ options.max_queries_per_connection }};
    recursion {{ 'yes' if options.recursion else 'no' }};
    allow-recursion { {{ options.allow_recursion | join(', ') }} };

    # Security hardening
    auth-nxdomain no;
    version "{{ options.version_string }}";
};

# Logging configuration
logging {
    {{ for channel in logging.channels }}
    channel {{ channel.name }} {
        {{ if channel.file }}file "{{ channel.file }}" versions {{ channel.versions }} size {{ channel.size }};{{ endif }}
        {{ if channel.syslog }}syslog {{ channel.syslog }};{{ endif }}
        severity {{ channel.severity }};
        print-time {{ 'yes' if channel.print_time else 'no' }};
        print-severity {{ 'yes' if channel.print_severity else 'no' }};
        print-category {{ 'yes' if channel.print_category else 'no' }};
    };
    {{ endfor }}

    {{ for cat in logging.categories }}
    category {{ cat.name }} { {{ cat.channels | join(', ') }} };
    {{ endfor }}
};

# DLZ (Dynamic Loadable Zone) configuration for DHCP integration
# BIND does not natively serve DHCP — DLZ allows dynamic updates from DHCP server
dlz "DHCP Zone" {
    # Use a custom module (e.g., PostgreSQL or MySQL-backed) for DHCP-DNS integration
    # The actual backend is configured externally; BIND only loads the DLZ module
    database "{{ dlz.backend_module }} \"{{ dlz.params | join(' ') }}\"";
};

# Trusted keys for TSIG-based dynamic updates (e.g., from DHCP server)
# Key name must match what DHCP server uses for updates
key "{{ tsig.key_name }}" {
    algorithm {{ tsig.algorithm }};
    secret "{{ tsig.secret }}";
};

# Delegation trust anchors (optional, used for DNSSEC trust anchor management)
# Not required for basic DHCP-DLZ operation

# Zone definitions
# Primary zones served by this server
{{ for zone in zones }}
zone "{{ zone.name }}" {
    type {{ zone.type }};
    file "{{ zone.file }}";
    {{ if zone.update_policy }}update-policy { {{ zone.update_policy | join(', ') }} };{{ endif }}
    {{ if zone.masters }}masters { {{ for m in zone.masters }}{{ m }}; {{ endfor }} };{{ endif }}
    {{ if zone.allow_transfer }}allow-transfer { {{ zone.allow_transfer | join(', ') }} };{{ endif }}
    {{ if zone.notify }}notify {{ zone.notify }};{{ endif }}
    allow-query { {{ zone.allow_query | join(', ') }} };
};
{{ endfor }}

# Reverse lookup zones (automated via pattern or manual)
{{ for reverse in reverse_zones }}
zone "{{ reverse.zone_name }}" {
    type {{ reverse.type }};
    file "{{ reverse.file }}";
    {{ if reverse.update_policy }}update-policy { {{ reverse.update_policy | join(', ') }} };{{ endif }}
    allow-query { {{ reverse.allow_query | join(', ') }} };
};
{{ endfor }}

# Trusted key for dynamic updates (used by DHCP to update A/AAAA/PTR records)
# This key must be trusted by both BIND and the DHCP server (e.g.,ISC DHCP or Kea)
key "{{ dhcp_key_name }}" {
    algorithm {{ dhcp_key_algorithm }};
    secret "{{ dhcp_key_secret }}";
};

# Include extra configuration fragments (for modular management)
{{ if include_extra }}include "{{ include_extra_path }}";{{ endif }}
