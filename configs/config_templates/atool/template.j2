# =============================================================================
# atool configuration template
# =============================================================================
# This is a self-documenting configuration file for `atool`.
# `atool` is a front-end for handling various archive formats transparently.
#
# Each directive below is commented with its schema description and default value.
# Variables are populated from the Ansible inventory/vars with safe defaults.
#
# Format: directive_name value
# See `man atool` for detailed documentation of each option.
# =============================================================================

# Whether to use rar for unpacking by default.
# Default: True
use_rar_for_unpack	{{ use_rar_for_unpack | default(True) | ternary(1, 0) }}

# Whether to use arc for unpacking by default.
# Default: False
{% if use_arc_for_unpack is defined and use_arc_for_unpack is not none and (use_arc_for_unpack is number or use_arc_for_unpack is boolean or use_arc_for_unpack | length > 0) %}use_arc_for_unpack	{{ use_arc_for_unpack | default(False) | ternary(1, 0) }}{% else %}# use_arc_for_unpack	0{% endif %}

# Whether to use arj for unpacking by default.
# Default: False
{% if use_arj_for_unpack is defined and use_arj_for_unpack is not none and (use_arj_for_unpack is number or use_arj_for_unpack is boolean or use_arj_for_unpack | length > 0) %}use_arj_for_unpack	{{ use_arj_for_unpack | default(False) | ternary(1, 0) }}{% else %}# use_arj_for_unpack	0{% endif %}

# Whether to use find -print0 for cpio handling.
# Default: True
{% if use_find_cpio_print0 is defined and use_find_cpio_print0 is not none and (use_find_cpio_print0 is number or use_find_cpio_print0 is boolean or use_find_cpio_print0 | length > 0) %}use_find_cpio_print0	{{ use_find_cpio_print0 | default(True) | ternary(1, 0) }}{% else %}# use_find_cpio_print0	1{% endif %}

# Whether to strip unknown archive extensions.
# Default: False
{% if strip_unknown_ext is defined and strip_unknown_ext is not none and (strip_unknown_ext is number or strip_unknown_ext is boolean or strip_unknown_ext | length > 0) %}strip_unknown_ext	{{ strip_unknown_ext | default(False) | ternary(1, 0) }}{% else %}# strip_unknown_ext	1{% endif %}

# Whether to use jar for unpacking JAR files.
# Default: False
{% if use_jar is defined and use_jar is not none and (use_jar is number or use_jar is boolean or use_jar | length > 0) %}use_jar	{{ use_jar | default(False) | ternary(1, 0) }}{% else %}# use_jar		0{% endif %}

# Whether to use file(1) to detect archive types.
# Default: True
{% if use_file is defined and use_file is not none and (use_file is number or use_file is boolean or use_file | length > 0) %}use_file	{{ use_file | default(True) | ternary(1, 0) }}{% else %}# use_file		1{% endif %}

# Pattern for temporary directory names (passed to mktemp).
# Default: 'Unpack-%04d'
{% if tmpdir_name is defined and tmpdir_name is not none and (tmpdir_name is number or tmpdir_name is boolean or tmpdir_name | length > 0) %}tmpdir_name	{{ tmpdir_name | default('Unpack-%04d') }}{% else %}# tmpdir_name		Unpack-%04d{% endif %}

