# =============================================================================
# atool configuration template
# =============================================================================
# This is a self-documenting configuration file for `atool`.
# `atool` is a front-end for handling various archive formats transparently.
#
# Each directive below is commented with its schema description and default value.
# Variables are populated from the Ansible inventory/vars with safe defaults.
#
# Format: directive_name value
# See `man atool` for detailed documentation of each option.
# =============================================================================

# Whether to use rar for unpacking by default.
# Default: True
use_rar_for_unpack	{{ use_rar_for_unpack | default(True) | ternary(1, 0) }}

# Whether to use arc for unpacking by default.
# Default: False
use_arc_for_unpack	{{ use_arc_for_unpack | default(False) | ternary(1, 0) }}

# Whether to use arj for unpacking by default.
# Default: False
use_arj_for_unpack	{{ use_arj_for_unpack | default(False) | ternary(1, 0) }}

# Whether to use find -print0 for cpio handling.
# Default: True
use_find_cpio_print0	{{ use_find_cpio_print0 | default(True) | ternary(1, 0) }}

# Whether to strip unknown archive extensions.
# Default: False
strip_unknown_ext	{{ strip_unknown_ext | default(False) | ternary(1, 0) }}

# Whether to use jar for unpacking JAR files.
# Default: False
use_jar	{{ use_jar | default(False) | ternary(1, 0) }}

# Whether to use file(1) to detect archive types.
# Default: True
use_file	{{ use_file | default(True) | ternary(1, 0) }}

# Pattern for temporary directory names (passed to mktemp).
# Default: 'Unpack-%04d'
tmpdir_name	{{ tmpdir_name | default('Unpack-%04d') }}

# Path or name of pager command.
# Default: 'pager'
path_pager	{{ path_pager | default('pager') }}

# Path or name of jar command.
# Default: 'jar'
path_jar	{{ path_jar | default('jar') }}

# Path or name of tar command.
# Default: 'tar'
path_tar	{{ path_tar | default('tar') }}

# Path or name of zip command.
# Default: 'zip'
path_zip	{{ path_zip | default('zip') }}

# Path or name of unzip command.
# Default: 'unzip'
path_unzip	{{ path_unzip | default('unzip') }}

# Path or name of gzip command.
# Default: 'gzip'
path_gzip	{{ path_gzip | default('gzip') }}

# Path or name of bzip command.
# Default: 'bzip'
path_bzip	{{ path_bzip | default('bzip') }}

# Path or name of bzip2 command.
# Default: 'bzip2'
path_bzip2	{{ path_bzip2 | default('bzip2') }}

# Path or name of compress command.
# Default: 'compress'
path_compress	{{ path_compress | default('compress') }}

# Path or name of lzop command.
# Default: 'lzop'
path_lzop	{{ path_lzop | default('lzop') }}

# Path or name of rar command.
# Default: 'rar'
path_rar	{{ path_rar | default('rar') }}

# Path or name of unrar command.
# Default: 'unrar'
path_unrar	{{ path_unrar | default('unrar') }}

# Path or name of lha command.
# Default: 'lha'
path_lha	{{ path_lha | default('lha') }}

# Path or name of unace command.
# Default: 'unace'
path_unace	{{ path_unace | default('unace') }}

# Path or name of ar command.
# Default: 'ar'
path_ar	{{ path_ar | default('ar') }}

# Path or name of arj command.
# Default: 'arj'
path_arj	{{ path_arj | default('arj') }}

# Path or name of unarj command.
# Default: 'unarj'
path_unarj	{{ path_unarj | default('unarj') }}

# Path or name of arc command.
# Default: 'arc'
path_arc	{{ path_arc | default('arc') }}

# Path or name of nomarch command.
# Default: 'nomarch'
path_nomarch	{{ path_nomarch | default('nomarch') }}

# Path or name of rpm command.
# Default: 'rpm'
path_rpm	{{ path_rpm | default('rpm') }}

# Path or name of rpm2cpio command.
# Default: 'rpm2cpio'
path_rpm2cpio	{{ path_rpm2cpio | default('rpm2cpio') }}

# Path or name of cpio command.
# Default: 'cpio'
path_cpio	{{ path_cpio | default('cpio') }}

# Path or name of file command.
# Default: 'file'
path_file	{{ path_file | default('file') }}

# Path or name of find command.
# Default: 'find'
path_find	{{ path_find | default('find') }}

# Path or name of xargs command.
# Default: 'xargs'
path_xargs	{{ path_xargs | default('xargs') }}

# Path or name of cat command.
# Default: 'cat'
path_cat	{{ path_cat | default('cat') }}

# Path or name of diff command.
# Default: 'diff'
path_diff	{{ path_diff | default('diff') }}

# Arguments for diff command.
# Default: '-ru'
args_diff	{{ args_diff | default('-ru') }}

# System-wide configuration file path.
# Default: '/etc/atool.conf'
path_syscfg	{{ path_syscfg | default('/etc/atool.conf') }}

# User configuration file name.
# Default: '.atoolrc'
path_usercfg	{{ path_usercfg | default('.atoolrc') }}

# Default verbosity level.
# Default: 1
default_verbosity	{{ default_verbosity | default(1) }}

# Whether to show extracted files.
# Default: True
show_extracted	{{ show_extracted | default(True) | ternary(1, 0) }}

# Whether to keep compressed files after extraction.
# Default: True
keep_compressed	{{ keep_compressed | default(True) | ternary(1, 0) }}

# Whether to decompress to current working directory.
# Default: True
decompress_to_cwd	{{ decompress_to_cwd | default(True) | ternary(1, 0) }}