{
  "active_master_role": {
    "type": "string",
    "default": "writer",
    "description": "The default active master role.",
    "enum": [
      "writer",
      "reader"
    ]
  },
  "cluster_interface": {
    "type": "string",
    "default": "eth0",
    "description": "Network interface used for cluster communication."
  },
  "pid_path": {
    "type": "string",
    "default": "/run/mysql-mmm-agent.pid",
    "description": "Path to the agent PID file."
  },
  "bin_path": {
    "type": "string",
    "default": "/usr/libexec/mysql-mmm/",
    "description": "Path to the mysql-mmm binaries."
  },
  "replication_user": {
    "type": "string",
    "default": "replicant",
    "description": "MySQL user for replication."
  },
  "replication_password": {
    "type": "string",
    "default": "slave",
    "description": "Password for the replication user."
  },
  "agent_user": {
    "type": "string",
    "default": "mmm_agent",
    "description": "MySQL user for the MMM agent."
  },
  "agent_password": {
    "type": "string",
    "default": "RepAgent",
    "description": "Password for the MMM agent user."
  },
  "db1_ip": {
    "type": "string",
    "default": "192.168.100.49",
    "description": "IP address of host db1."
  },
  "db1_mode": {
    "type": "string",
    "default": "master",
    "description": "Mode of host db1.",
    "enum": [
      "master",
      "slave"
    ]
  },
  "db1_peer": {
    "type": "string",
    "default": "db2",
    "description": "Peer host for db1."
  },
  "db2_ip": {
    "type": "string",
    "default": "192.168.100.50",
    "description": "IP address of host db2."
  },
  "db2_mode": {
    "type": "string",
    "default": "master",
    "description": "Mode of host db2.",
    "enum": [
      "master",
      "slave"
    ]
  },
  "db2_peer": {
    "type": "string",
    "default": "db1",
    "description": "Peer host for db2."
  },
  "db3_ip": {
    "type": "string",
    "default": "192.168.100.51",
    "description": "IP address of host db3 (commented out)."
  },
  "db3_mode": {
    "type": "string",
    "default": "slave",
    "description": "Mode of host db3 (commented out).",
    "enum": [
      "master",
      "slave"
    ]
  },
  "writer_hosts": {
    "type": "string",
    "default": "db1, db2",
    "description": "List of hosts assigned to the writer role, comma-separated in config."
  },
  "writer_ips": {
    "type": "list",
    "default": [
      "192.168.100.250"
    ],
    "description": "List of IPs for the writer role, comma-separated in config."
  },
  "writer_mode": {
    "type": "string",
    "default": "exclusive",
    "description": "Mode for the writer role.",
    "enum": [
      "exclusive",
      "all"
    ]
  },
  "reader_hosts": {
    "type": "string",
    "default": "db1, db2",
    "description": "List of hosts assigned to the reader role, comma-separated in config."
  },
  "reader_ips": {
    "type": "list",
    "default": [
      "192.168.100.251",
      "192.168.100.252"
    ],
    "description": "List of IPs for the reader role, comma-separated in config."
  },
  "reader_mode": {
    "type": "string",
    "default": "balanced",
    "description": "Mode for the reader role.",
    "enum": [
      "balanced",
      "random"
    ]
  }
}
