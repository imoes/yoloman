#---------------------------------------------------------------------
# Example configuration for a possible web application.  See the
# full configuration options online.
#
#   https://www.haproxy.org/download/1.8/doc/configuration.txt
#
#---------------------------------------------------------------------

#---------------------------------------------------------------------
# Global settings
#---------------------------------------------------------------------
global
    # to have these messages end up in /var/log/haproxy.log you will
    # need to:
    #
    # 1) configure syslog to accept network log events.  This is done
    #    by adding the '-r' option to the SYSLOGD_OPTIONS in
    #    /etc/sysconfig/syslog
    #
    # 2) configure local2 events to go to the /var/log/haproxy.log
    #   file. A line like the following can be added to
    #   /etc/sysconfig/syslog
    #
    #    local2.*                       /var/log/haproxy.log
    #
    log         {{ haproxy_log_addr }} local2

    chroot      {{ haproxy_chroot }}
    pidfile     {{ haproxy_pidfile }}
    maxconn     {{ maxconn }}
    user        {{ user }}
    group       {{ group }}
    daemon

    # turn on stats unix socket
    stats socket {{ haproxy_stats_socket }}

    # utilize system-wide crypto-policies
{% if tls_enabled %}    ssl-default-bind-options ssl-min-ver {{ ssl_min_version }}
{% endif %}{% if tls_enabled and ssl_ciphers is defined and ssl_ciphers %}    ssl-default-bind-ciphers {{ ssl_ciphers }}
{% else %}    ssl-default-bind-ciphers PROFILE=SYSTEM
{% endif %}    ssl-default-server-ciphers PROFILE=SYSTEM

#---------------------------------------------------------------------
# common defaults that all the 'listen' and 'backend' sections will
# use if not designated in their block
#---------------------------------------------------------------------
defaults
    mode                    {{ mode }}
    log                     {{ log_level }}
    option                  httplog
    option                  dontlognull
    option http-server-close
    option forwardfor       except 127.0.0.0/8
    option                  redispatch
    retries                 {{ haproxy_retries }}
    timeout http-request    {{ haproxy_timeout_http_request }}
    timeout queue           {{ haproxy_timeout_queue }}
    timeout connect         {{ timeout_connect }}
    timeout client          {{ timeout_client }}
    timeout server          {{ timeout_server }}
    timeout http-keep-alive {{ haproxy_timeout_http_keep_alive }}
    timeout check           {{ haproxy_timeout_check }}
    maxconn                 {{ haproxy_maxconn }}

#---------------------------------------------------------------------
# main frontend which proxys to the backends
#---------------------------------------------------------------------
frontend main
    bind *:{{ http_port }}
{% if tls_enabled %}    bind *:{{ https_port }} ssl crt {{ ssl_cert_pem }}
{% if redirect_to_https %}    http-request redirect scheme https code 301 unless { ssl_fc }
{% endif %}{% if hsts %}    http-response set-header Strict-Transport-Security "max-age=63072000; includeSubDomains"
{% endif %}{% endif %}    acl url_static       path_beg       -i /static /images /javascript /stylesheets
    acl url_static       path_end       -i .jpg .gif .png .css .js

    use_backend static          if url_static
    default_backend             {{ backend_name }}

#---------------------------------------------------------------------
# static backend for serving up images, stylesheets and such
#---------------------------------------------------------------------
backend static
    balance     roundrobin
    server      static {{ haproxy_static_server_addr }}:{{ haproxy_static_server_port }} check

#---------------------------------------------------------------------
# round robin balancing between the various backends
#---------------------------------------------------------------------
backend {{ backend_name }}
    balance     {{ balance_algorithm }}
{% if backend_servers is defined and backend_servers is not none and (backend_servers is number or backend_servers is boolean or backend_servers | length > 0) %}{% for server in backend_servers %}    server  {{ server.name }} {{ server.address }}:{{ server.port }}{% if server.check %} check{% endif %}
{% endfor %}{% else %}    server  app1 {{ haproxy_app1_addr }}:{{ haproxy_app1_port }} check
    server  app2 {{ haproxy_app2_addr }}:{{ haproxy_app2_port }} check
    server  app3 {{ haproxy_app3_addr }}:{{ haproxy_app3_port }} check
    server  app4 {{ haproxy_app4_addr }}:{{ haproxy_app4_port }} check
{% endif %}