{
  "haproxy_log_addr": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Syslog server address for HAProxy logs."
  },
  "haproxy_chroot": {
    "type": "string",
    "default": "/var/lib/haproxy",
    "description": "Path to chroot directory for HAProxy."
  },
  "haproxy_pidfile": {
    "type": "string",
    "default": "/var/run/haproxy.pid",
    "description": "Path to the HAProxy PID file."
  },
  "haproxy_global_maxconn": {
    "type": "number",
    "default": 4000,
    "description": "Maximum total number of connections for the global process."
  },
  "haproxy_stats_socket": {
    "type": "string",
    "default": "/var/lib/haproxy/stats",
    "description": "Path to the stats Unix socket."
  },
  "haproxy_retries": {
    "type": "number",
    "default": "3",
    "description": "Number of retries when a server is marked down."
  },
  "haproxy_timeout_http_request": {
    "type": "string",
    "default": "10s",
    "description": "Timeout for the HTTP request phase."
  },
  "haproxy_timeout_queue": {
    "type": "string",
    "default": "1m",
    "description": "Timeout for the queue phase."
  },
  "haproxy_timeout_connect": {
    "type": "string",
    "default": "10s",
    "description": "Timeout for the TCP connection phase."
  },
  "haproxy_timeout_client": {
    "type": "string",
    "default": "1m",
    "description": "Timeout for the client side."
  },
  "haproxy_timeout_server": {
    "type": "string",
    "default": "1m",
    "description": "Timeout for the server side."
  },
  "haproxy_timeout_http_keep_alive": {
    "type": "string",
    "default": "10s",
    "description": "Timeout for the HTTP keep-alive phase."
  },
  "haproxy_timeout_check": {
    "type": "string",
    "default": "10s",
    "description": "Timeout for health checks."
  },
  "haproxy_maxconn": {
    "type": "number",
    "default": "3000",
    "description": "Maximum number of concurrent connections per process in defaults."
  },
  "haproxy_frontend_port": {
    "type": "number",
    "default": "5000",
    "description": "Port to bind the main frontend."
  },
  "haproxy_static_server_addr": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address for the static backend server."
  },
  "haproxy_static_server_port": {
    "type": "number",
    "default": 4331,
    "description": "Port for the static backend server."
  },
  "haproxy_app1_addr": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address for application server 1."
  },
  "haproxy_app1_port": {
    "type": "number",
    "default": 5001,
    "description": "Port for application server 1."
  },
  "haproxy_app2_addr": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address for application server 2."
  },
  "haproxy_app2_port": {
    "type": "number",
    "default": 5002,
    "description": "Port for application server 2."
  },
  "haproxy_app3_addr": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address for application server 3."
  },
  "haproxy_app3_port": {
    "type": "number",
    "default": 5003,
    "description": "Port for application server 3."
  },
  "haproxy_app4_addr": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address for application server 4."
  },
  "haproxy_app4_port": {
    "type": "number",
    "default": 5004,
    "description": "Port for application server 4."
  }
}
