# Defaults for gammu-smsd initscript
# sourced by /etc/init.d/gammu-smsd
# installed at /etc/default/gammu-smsd by the maintainer scripts

#
# This is a POSIX shell fragment
#

# Additional options that are passed to the Daemon.
# Default: empty string (no extra arguments)
DAEMON_OPTS="{{ DAEMON_OPTS | default('') }}"

# System user account under which the gammu-smsd service runs.
# Default: 'gammu' (dedicated user for the SMS daemon)
USER="{{ USER | default('gammu') }}"