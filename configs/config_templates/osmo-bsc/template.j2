! osmo-bsc default configuration
! (assumes STP to run on {{ stp_host | default('127.0.0.1') }} and uses default point codes)
!
! Global logging configuration
log stderr
 logging color 1
 logging print category-hex 0
 logging print category 1
 logging timestamp 0
 logging print file basename last
 logging print level 1

! E1 input interface configuration
e1_input
 e1_line 0 driver ipa

! Network-level parameters for the BSC
network
 ! Mobile Country Code (MCC) for the network.
 network country code {{ network_country_code | default('1') }}
 ! Mobile Network Code (MNC).
 mobile network code {{ mobile_network_code | default('1') }}
 encryption a5 0
 neci 1
 paging any use tch 0
 handover 0
 handover algorithm 1
 handover1 window rxlev averaging 10
 handover1 window rxqual averaging 1
 handover1 window rxlev neighbor averaging 10
 handover1 power budget interval 6
 handover1 power budget hysteresis 3
 handover1 maximum distance 9999

 ! T3212 is in units of 6min, so below we set {{ t3212_units | default('5') }} * 6 = {{ t3212_total_minutes | default('30') }}min
 timer net T3212 {{ t3212_units | default('5') }}

 ! Media Gateway (MGW) connection settings
 mgw 0
  ! Remote IP address of the Media Gateway (MGW).
  remote-ip {{ mgw_remote_ip | default('127.0.0.1') }}
  ! Remote port of the Media Gateway (MGW).
  remote-port {{ mgw_remote_port | default('2427') }}
  ! Local port for the connection to the Media Gateway (MGW).
  local-port {{ mgw_local_port | default('2727') }}

  ! BTS 0 configuration
  bts 0
   type osmo-bts
   band DCS1800
   ! Unique cell identity.
   cell_identity {{ cell_identity | default('6969') }}
   ! Location Area Code (LAC).
   location_area_code {{ location_area_code | default('0x0001') }}
   ! Base Station ID Code (BSIC).
   base_station_id_code {{ base_station_id_code | default('63') }}
   ! Maximum MS transmit power.
   ms max power {{ ms_max_power | default('15') }}
   cell reselection hysteresis 4
   ! Minimum RX level for cell access.
   rxlev access min {{ rxlev_access_min | default('0') }}
   ! Radio link timeout value.
   radio-link-timeout {{ radio_link_timeout | default('32') }}
   channel allocator mode set-all ascending
   ! RACH Tx Integer parameter.
   rach tx integer {{ rach_tx_integer | default('9') }}
   ! RACH Max Transmission parameter.
   rach max transmission {{ rach_max_transmission | default('7') }}
   channel-description attach 1
   channel-description bs-pa-mfrms 5
   channel-description bs-ag-blks-res 1
   early-classmark-sending forbidden
   ! IPA Unit ID for the BTS.
   ipa unit-id {{ ipa_unit_id | default('6969') }} 0
   oml ipa stream-id 255 line 0
   codec-support fr
   gprs mode none

   ! TRX 0 configuration
   trx 0
    rf_locked 0
    ! Absolute Radio Frequency Channel Number.
    arfcn {{ arfcn | default('871') }}
    ! Nominal transmit power in dBm.
    nominal power {{ nominal_power | default('23') }}
    ! to use full TRX power, set max_power_red 0
    ! Maximum Power Reduction value.
    max_power_red {{ max_power_red | default('20') }}
    rsl e1 tei 0
    timeslot 0
     phys_chan_config CCCH+SDCCH4
     hopping enabled 0
    timeslot 1
     phys_chan_config TCH/F
     hopping enabled 0
    timeslot 2
     phys_chan_config TCH/F
     hopping enabled 0
    timeslot 3
     phys_chan_config TCH/F
     hopping enabled 0
    timeslot 4
     phys_chan_config TCH/F
     hopping enabled 0
    timeslot 5
     phys_chan_config TCH/F
     hopping enabled 0
    timeslot 6
     phys_chan_config TCH/F
     hopping enabled 0
    timeslot 7
     phys_chan_config TCH/F
     hopping enabled 0

! MSC 0 configuration
msc 0
 ! Do not allow emergency calls unless you can route
 ! them to the local emergency services
 allow-emergency deny

! BSC specific settings
bsc
 mid-call-timeout 0
