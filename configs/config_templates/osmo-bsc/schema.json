{
  "stp_host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Host/IP of the STP (Signaling Transfer Point)."
  },
  "network_country_code": {
    "type": "string",
    "default": "1",
    "description": "Mobile Country Code (MCC) for the network."
  },
  "mobile_network_code": {
    "type": "string",
    "default": "1",
    "description": "Mobile Network Code (MNC) for the network."
  },
  "t3212_units": {
    "type": "number",
    "default": "5",
    "description": "T3212 timer value in units of 6 minutes."
  },
  "t3212_total_minutes": {
    "type": "number",
    "default": "30",
    "description": "Calculated total duration of T3212 in minutes (units * 6)."
  },
  "mgw_remote_ip": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Remote IP address of the Media Gateway (MGW)."
  },
  "mgw_remote_port": {
    "type": "number",
    "default": 2427,
    "description": "Remote port of the Media Gateway (MGW)."
  },
  "mgw_local_port": {
    "type": "number",
    "default": 2727,
    "description": "Local port for the connection to the Media Gateway (MGW)."
  },
  "cell_identity": {
    "type": "number",
    "default": 6969,
    "description": "Unique cell identity."
  },
  "location_area_code": {
    "type": "string",
    "default": "0x0001",
    "description": "Location Area Code (LAC)."
  },
  "base_station_id_code": {
    "type": "number",
    "default": 63,
    "description": "Base Station ID Code (BSIC)."
  },
  "ms_max_power": {
    "type": "number",
    "default": 15,
    "description": "Maximum MS transmit power."
  },
  "rxlev_access_min": {
    "type": "number",
    "default": 0,
    "description": "Minimum RX level for cell access."
  },
  "radio_link_timeout": {
    "type": "number",
    "default": 32,
    "description": "Radio link timeout value."
  },
  "rach_tx_integer": {
    "type": "number",
    "default": 9,
    "description": "RACH Tx Integer parameter."
  },
  "rach_max_transmission": {
    "type": "number",
    "default": 7,
    "description": "RACH Max Transmission parameter."
  },
  "ipa_unit_id": {
    "type": "number",
    "default": 6969,
    "description": "IPA Unit ID for the BTS."
  },
  "arfcn": {
    "type": "number",
    "default": 871,
    "description": "Absolute Radio Frequency Channel Number."
  },
  "nominal_power": {
    "type": "number",
    "default": 23,
    "description": "Nominal transmit power in dBm."
  },
  "max_power_red": {
    "type": "number",
    "default": 20,
    "description": "Maximum Power Reduction value."
  }
}
