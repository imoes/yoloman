{
  "base_url": "/",
  "template_dir": "/usr/share/ciderwebmail/templates",
  "static_dir": "/usr/share/ciderwebmail/static",
  "log_level": "INFO",
  "log_file": "/var/log/ciderwebmail/ciderwebmail.log",
  "imap": {
    "host": "imap.example.com",
    "port": 993,
    "use_tls": false,
    "use_ssl": true,
    "auth_method": "PLAIN"
  },
  "secret_key": "supersecretkey1234567890abcdef",
  "session_cookie_name": "cider_session",
  "session_cookie_path": "/",
  "session_cookie_domain": "",
  "session_timeout": 3600,
  "secure_cookie": true,
  "inbox_folder": "INBOX",
  "folder_separator": ".",
  "messages_per_page": 30,
  "max_recipients_displayed": 5,
  "hidden_folders": [
    "Drafts",
    "Trash",
    "Junk"
  ],
  "smtp": {
    "host": "smtp.example.com",
    "port": 587,
    "use_tls": true,
    "use_ssl": false,
    "username": "webmail@example.com",
    "password": "smtp-password",
    "helo_hostname": "webmail.example.com"
  },
  "theme": "default",
  "language": "en-US",
  "auto_detect_language": true,
  "plugins": {
    "enabled": [
      "auth_ldap"
    ],
    "configs": [
      {
        "name": "auth_ldap",
        "settings": {
          "ldap_uri": "ldap://ldap.example.com",
          "ldap_base": "dc=example,dc=com",
          "ldap_binddn": "cn=webmail,ou=Service Accounts,dc=example,dc=com",
          "ldap_bindpw": "ldap-bind-password",
          "ldap_userfilter": "(uid={username})",
          "ldap_emailattr": "mail",
          "ldap_nameattr": "cn"
        }
      }
    ]
  }
}
