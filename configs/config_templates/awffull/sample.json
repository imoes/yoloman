{
  "debug": false,
  "log_files": [
    "/var/log/nginx/access.log",
    "/var/log/apache2/other_vhosts_access.log"
  ],
  "url": "https://www.example.com/",
  "output_dir": "/var/www/html/stats",
  "use_gzip": true,
  "timezone": -5,
  "date_format": "%Y-%m-%d",
  "retention": 90,
  "ignore_ips": [
    "127.0.0.1",
    "::1"
  ],
  "exclude_patterns": [
    "*.png",
    "*.gif",
    "*.jpg",
    "*.jpeg",
    "*.css",
    "*.js",
    "/robots.txt",
    "/favicon.ico"
  ],
  "include_patterns": [],
  "users_enabled": false,
  "referrer_enabled": true,
  "keywords_enabled": true,
  "browser_enabled": true,
  "country_enabled": true,
  "geoip_db_path": "/usr/share/GeoIP/GeoIP.dat",
  "top_count": 20,
  "hide_short_urls": 2,
  "hourly_24h": true,
  "skip_status_list": [
    "304",
    "204"
  ],
  "log_format": "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"",
  "report_title": "ACME Corp Web Statistics",
  "feed_enabled": true,
  "summary_enabled": true,
  "secure_enabled": true,
  "custom_css": "/etc/awffull/acme.css",
  "hourly_enabled": true,
  "daily_enabled": true,
  "weekly_enabled": true,
  "monthly_enabled": true,
  "report_max_age": 31,
  "cache_enabled": true,
  "cache_dir": "/var/cache/awffull"
}
