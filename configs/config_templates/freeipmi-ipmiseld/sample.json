{
  "driver_type": "KCS",
  "disable_auto_probe": "DISABLE",
  "driver_address": "0xCA2",
  "driver_device": "/dev/ipmi0",
  "register_spacing": "1",
  "target_channel_number": "0",
  "target_slave_address": "0x20",
  "hostname": "myhost",
  "username": "myusername",
  "password": "mypassword",
  "k_g": "mykey",
  "session_timeout": "20000",
  "retransmission_timeout": "1000",
  "authentication_type": "MD5",
  "cipher_suite_id": "3",
  "privilege_level": "ADMIN",
  "workaround_flags": "",
  "verbose_count": "0",
  "sensor_types": "",
  "exclude_sensor_types": "",
  "system_event_only": "DISABLE",
  "oem_event_only": "DISABLE",
  "event_state_config_file": "/etc/ipmiseld/event.conf",
  "interpret_oem_data": "DISABLE",
  "entity_sensor_names": "DISABLE",
  "non_abbreviated_units": "DISABLE",
  "event_state_filter": "nominal",
  "warning_threshold": "80",
  "clear_threshold": "0",
  "system_event_format": "\"SEL System Event: %s, %I, %E\"",
  "oem_timestamped_event_format": "\"SEL OEM Event: %I, %o\"",
  "oem_non_timestamped_event_format": "\"SEL OEM Event: %I, %o\"",
  "poll_interval": "300",
  "log_facility": "LOG_DAEMON",
  "log_priority": "LOG_ERR",
  "cache_directory": "/var/cache/ipmi",
  "ignore_sdr": "DISABLE",
  "re_download_sdr": "DISABLE",
  "clear_sel": "DISABLE",
  "threadpool_count": "8"
}
