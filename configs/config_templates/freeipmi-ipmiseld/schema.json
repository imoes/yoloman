{
  "driver_type": {
    "type": "string",
    "default": "KCS",
    "description": "IPMI driver type (e.g., KCS, SSIF, BT)"
  },
  "disable_auto_probe": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to disable auto-probing for IPMI devices"
  },
  "driver_address": {
    "type": "string",
    "default": "0xCA2",
    "description": "IPMI driver address"
  },
  "driver_device": {
    "type": "string",
    "default": "/dev/ipmi0",
    "description": "Path to IPMI device file"
  },
  "register_spacing": {
    "type": "string",
    "default": "1",
    "description": "Register spacing for IPMI interface"
  },
  "target_channel_number": {
    "type": "string",
    "default": "0",
    "description": "Target channel number"
  },
  "target_slave_address": {
    "type": "string",
    "default": "0x20",
    "description": "Target slave address (BM/CPU)"
  },
  "hostname": {
    "type": "string",
    "default": "myhost",
    "description": "Remote hostname(s) for LAN connections"
  },
  "username": {
    "type": "string",
    "default": "myusername",
    "description": "Username for remote connection"
  },
  "password": {
    "type": "string",
    "default": "mypassword",
    "description": "Password for remote connection"
  },
  "k_g": {
    "type": "string",
    "default": "mykey",
    "description": "Key for OEM authentication (K_g)"
  },
  "session_timeout": {
    "type": "string",
    "default": "20000",
    "description": "Session timeout in milliseconds"
  },
  "retransmission_timeout": {
    "type": "string",
    "default": "1000",
    "description": "Retransmission timeout in milliseconds"
  },
  "authentication_type": {
    "type": "string",
    "default": "MD5",
    "description": "Authentication type (NONE, MD5, SHA1)",
    "enum": [
      "NONE",
      "MD5",
      "OEM"
    ]
  },
  "cipher_suite_id": {
    "type": "string",
    "default": "3",
    "description": "Cipher suite ID for remote connection"
  },
  "privilege_level": {
    "type": "string",
    "default": "ADMIN",
    "description": "Privilege level (CALLBACK, USER, OPERATOR, ADMIN)"
  },
  "workaround_flags": {
    "type": "string",
    "default": "",
    "description": "Space-separated list of workaround flags"
  },
  "verbose_count": {
    "type": "string",
    "default": "0",
    "description": "Verbosity level (0-3)"
  },
  "sensor_types": {
    "type": "string",
    "default": "",
    "description": "Space-separated list of sensor types to include"
  },
  "exclude_sensor_types": {
    "type": "string",
    "default": "",
    "description": "Space-separated list of sensor types to exclude"
  },
  "system_event_only": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to process only system events"
  },
  "oem_event_only": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to process only OEM events"
  },
  "event_state_config_file": {
    "type": "string",
    "default": "/etc/ipmiseld/event.conf",
    "description": "Path to event state configuration file"
  },
  "interpret_oem_data": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to interpret OEM data"
  },
  "entity_sensor_names": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to use entity sensor names"
  },
  "non_abbreviated_units": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to use non-abbreviated unit names"
  },
  "event_state_filter": {
    "type": "string",
    "default": "nominal",
    "description": "Event state filter (nominal, warning, critical)"
  },
  "warning_threshold": {
    "type": "string",
    "default": "80",
    "description": "Warning threshold percentage"
  },
  "clear_threshold": {
    "type": "string",
    "default": "0",
    "description": "Clear threshold (0 = use default behavior)"
  },
  "system_event_format": {
    "type": "string",
    "default": "\"SEL System Event: %s, %I, %E\"",
    "description": "Format string for system events"
  },
  "oem_timestamped_event_format": {
    "type": "string",
    "default": "\"SEL OEM Event: %I, %o\"",
    "description": "Format string for OEM timestamped events"
  },
  "oem_non_timestamped_event_format": {
    "type": "string",
    "default": "\"SEL OEM Event: %I, %o\"",
    "description": "Format string for OEM non-timestamped events"
  },
  "poll_interval": {
    "type": "string",
    "default": "300",
    "description": "Poll interval in seconds"
  },
  "log_facility": {
    "type": "string",
    "default": "LOG_DAEMON",
    "description": "Syslog facility"
  },
  "log_priority": {
    "type": "string",
    "default": "LOG_ERR",
    "description": "Syslog priority"
  },
  "cache_directory": {
    "type": "string",
    "default": "/var/cache/ipmi",
    "description": "Directory for SDR cache"
  },
  "ignore_sdr": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to ignore SDR repository"
  },
  "re_download_sdr": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to re-download SDR repository"
  },
  "clear_sel": {
    "type": "string",
    "default": "DISABLE",
    "description": "Whether to clear System Event Log on startup"
  },
  "threadpool_count": {
    "type": "string",
    "default": "8",
    "description": "Number of threads in the thread pool"
  }
}
