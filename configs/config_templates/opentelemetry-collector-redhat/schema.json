{
  "receiver_journald_priority": {
    "type": "string",
    "default": "info",
    "description": "Log priority for journald receiver.",
    "enum": [
      "alert",
      "info",
      "debug",
      "trace"
    ]
  },
  "receiver_hostmetrics_root_path": {
    "type": "string",
    "default": "/",
    "description": "Root path for hostmetrics receiver."
  },
  "receiver_hostmetrics_collection_interval": {
    "type": "string",
    "default": "10s",
    "description": "Collection interval for hostmetrics receiver."
  },
  "receiver_hostmetrics_disk_root_path": {
    "type": "string",
    "default": "/",
    "description": "Root path for hostmetrics/disk receiver."
  },
  "receiver_hostmetrics_disk_collection_interval": {
    "type": "string",
    "default": "30s",
    "description": "Collection interval for hostmetrics/disk receiver."
  },
  "processors_resourcedetection_system_detectors": {
    "type": "list",
    "default": [
      "system"
    ],
    "description": "List of detectors for resourcedetection/system processor."
  }
}
