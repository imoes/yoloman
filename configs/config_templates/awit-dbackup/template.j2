[backup]

# Set to '1' to exclude system directories from backup.
# Default is empty (disabled).
#exclude-system={{ backup_exclude_system | default('') }}

# System bases are kernel isolated virtual machines, like chroots.
# The system-dir's are appended to these in the tests for exclusion.

# Root path to exclude system base (kernel isolated VMs).
# Default is '/'
#exclude-system-base={{ backup_exclude_system_base_0 | default('/') }}

# Example vserver path to exclude.
# Default is '/vservers/my-linux-vserver'
#exclude-system-base={{ backup_exclude_system_base_1 | default('/vservers/my-linux-vserver') }}

# Example chroot path to exclude.
# Default is '/chroots/my-chroot'
#exclude-system-base={{ backup_exclude_system_base_2 | default('/chroots/my-chroot') }}

# System dirs not to backup

# System directory to exclude.
# Default is '/sys'
#exclude-system-dir={{ backup_exclude_system_dir_0 | default('/sys') }}

# System directory to exclude.
# Default is '/proc'
#exclude-system-dir={{ backup_exclude_system_dir_1 | default('/proc') }}

# System directory to exclude.
# Default is '/dev'
#exclude-system-dir={{ backup_exclude_system_dir_2 | default('/dev') }}

# System directory to exclude.
# Default is '/tmp'
#exclude-system-dir={{ backup_exclude_system_dir_3 | default('/tmp') }}