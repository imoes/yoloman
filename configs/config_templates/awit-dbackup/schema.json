{
  "backup_exclude_system": {
    "type": "string",
    "default": "",
    "description": "Set to '1' to exclude system directories from backup"
  },
  "backup_exclude_system_base_0": {
    "type": "string",
    "default": "/",
    "description": "Root path to exclude system base (kernel isolated VMs)"
  },
  "backup_exclude_system_base_1": {
    "type": "string",
    "default": "/vservers/my-linux-vserver",
    "description": "Example vserver path to exclude"
  },
  "backup_exclude_system_base_2": {
    "type": "string",
    "default": "/chroots/my-chroot",
    "description": "Example chroot path to exclude"
  },
  "backup_exclude_system_dir_0": {
    "type": "string",
    "default": "/sys",
    "description": "System directory to exclude"
  },
  "backup_exclude_system_dir_1": {
    "type": "string",
    "default": "/proc",
    "description": "System directory to exclude"
  },
  "backup_exclude_system_dir_2": {
    "type": "string",
    "default": "/dev",
    "description": "System directory to exclude"
  },
  "backup_exclude_system_dir_3": {
    "type": "string",
    "default": "/tmp",
    "description": "System directory to exclude"
  }
}
