{
  "default_sender": "noreply@company.com",
  "relay_host": "smtp-relay.company.com",
  "relay_port": 587,
  "relay_auth": true,
  "relay_user": "dma-relay",
  "relay_pass": "REDACTED_SECURE_PASSWORD",
  "allowed_networks": [
    "127.0.0.0/8",
    "10.0.0.0/8"
  ],
  "local_hosts": [
    "localhost",
    "mail.company.com"
  ],
  "max_connections_per_host": 10,
  "max_message_size": 10485760,
  "smtp_timeout": 60,
  "use_tls": true,
  "tls_ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "dns_lookup": true,
  "retry_interval": 600,
  "max_retries": 10,
  "log_level": "notice",
  "log_file": "/var/log/dma.log",
  "queue_dir": "/var/spool/dma",
  "pid_file": "/run/dma/dma.pid",
  "listen": [
    "127.0.0.1:25",
    "10.0.0.5:25"
  ],
  "enable_submission": true,
  "submission_auth": "pam",
  "ldap_uri": "",
  "ldap_bind_dn": "",
  "ldap_bind_pass": "",
  "aliases": [
    {
      "key": "postmaster",
      "value": [
        "root"
      ]
    },
    {
      "key": "abuse",
      "value": [
        "security@company.com"
      ]
    },
    {
      "key": "webmaster",
      "value": [
        "admin@company.com",
        "webmaster@example.org"
      ]
    }
  ],
  "sender_maps": [
    {
      "from": "@oldcompany.com",
      "to": "@company.com"
    }
  ],
  "recipient_maps": [
    {
      "from": "olduser@oldcompany.com",
      "to": "newuser@company.com"
    }
  ]
}
