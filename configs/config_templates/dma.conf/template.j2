# Default sender address (used when no -f or -r is specified)
# Set the email address that appears as the sender for outgoing mail
# {{ default_sender }}

# SMTP relay host for outbound mail (if empty, direct delivery is attempted)
# Hostname or IP of the external SMTP server to relay mail through
# {{ relay_host | default('') }}

# SMTP relay port (used only if relay_host is set)
# Port number for the SMTP relay server
# {{ relay_port | default(587) }}

# Enable authentication to the relay host (true/false)
# Whether to authenticate to the relay server using the credentials below
# {{ relay_auth | default(false) }}

# Username for relay authentication (only if relay_auth is true)
# SMTP relay login username
# {{ relay_user | default('') }}

# Password for relay authentication (only if relay_auth is true)
# SMTP relay login password (store securely!)
# {{ relay_pass | default('') }}

# Local network allowed to submit mail via SMTP (space-separated CIDRs or hostnames)
# Networks or hosts permitted to connect to DMA's SMTP listener without restriction
# {{ allowed_networks | default('127.0.0.0/8') }}

# Local addresses considered local (space-separated hostnames or IPs)
# Hostnames/IPs that are treated as local destinations (no relay for them)
# {{ local_hosts | default('localhost') }}

# Maximum number of simultaneous SMTP connections per destination host
# Concurrency limit to avoid overwhelming remote hosts
# {{ max_connections_per_host | default(5) }}

# Maximum queue size (in bytes) per message (0 = unlimited)
# Upper bound on message size; larger messages are rejected or truncated
# {{ max_message_size | default(0) }}

# Timeout for SMTP transactions (seconds)
# Connection, data, and response timeouts during SMTP operations
# {{ smtp_timeout | default(30) }}

# Enable TLS for outbound connections (true/false)
# Use STARTTLS when connecting to relay host or direct SMTP
# {{ use_tls | default(true) }}

# Path to CA certificate bundle for TLS verification
# Required if use_tls is true and custom CA trust is needed
# {{ tls_ca_file | default('/etc/ssl/certs/ca-certificates.crt') }}

# Enable DNS lookups for MX records (true/false)
# Disable only in air-gapped environments with manual routing
# {{ dns_lookup | default(true) }}

# Retry interval (seconds) for deferred deliveries
# How often DMA attempts redelivery of queued messages
# {{ retry_interval | default(300) }}

# Maximum retries before permanent failure
# After this many failed attempts, the message is bounced
# {{ max_retries | default(5) }}

# Log level: debug, info, notice, warn, err, crit, alert, emerg
# Verbosity of DMA logging
# {{ log_level | default('info') }}

# Path to log file (use '-' for stdout)
# Where DMA writes its logs; use '-' for standard output
# {{ log_file | default('-') }}

# Path to queue directory
# DMA stores undelivered messages here
# {{ queue_dir | default('/var/spool/dma') }}

# Path to PID file
# File to store DMA daemon process ID
# {{ pid_file | default('/run/dma/dma.pid') }}

# Listen address(es) for SMTP input (space-separated IP:port)
# Local addresses/ports where DMA accepts incoming SMTP connections
# {{ listen | default('127.0.0.1:25') }}

# Enable submission port (587) listener (true/false)
# If true, adds a :587 listener for authenticated mail submission
# {{ enable_submission | default(false) }}

# Submission authentication backend (none, passwd, pam, ldap)
# Method to authenticate users submitting mail via port 587
# {{ submission_auth | default('none') }}

# LDAP server URI for submission auth (only if submission_auth=ldap)
# e.g. ldap://ldap.example.com/ou=People,dc=example,dc=com?uid?sub?(objectClass=posixAccount)
# {{ ldap_uri | default('') }}

# LDAP bind DN (only if submission_auth=ldap and anonymous bind not used)
# Bind DN for authenticating to the LDAP server
# {{ ldap_bind_dn | default('') }}

# LDAP bind password (only if submission_auth=ldap)
# Password for LDAP bind DN
# {{ ldap_bind_pass | default('') }}

# List of custom aliases: {{ item.key }} -> {{ item.value | join(', ') }}
# User-defined email aliases in the form 'localpart: target1, target2'
{% for alias in aliases %}# {{ alias.key }}: {{ alias.value | join(', ') }}
{% endfor %}

# List of sender maps (masquerade rules): {{ item.from }} -> {{ item.to }}
# Rewrite sender addresses matching 'from' to 'to'
{% for map in sender_maps %}# {{ map.from }} -> {{ map.to }}
{% endfor %}

# List of recipient maps: {{ item.from }} -> {{ item.to }}
# Rewrite recipient addresses matching 'from' to 'to'
{% for map in recipient_maps %}# {{ map.from }} -> {{ map.to }}
{% endfor %}