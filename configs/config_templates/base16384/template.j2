{# Configuration file for base16384 (a base-converter utility) #}
{# This template generates the command line arguments for base16384. #}

{# options: List of command-line options to pass to base16384. #}
{# Valid values: -e, -d, -t, -n, -c, -C. #}
{# Omitting -e or -d defaults to encoding (-e). #}
{# Renders as space-separated flags, e.g., "-e -n" #}
{% for opt in options | default([]) %}
{{ opt }}{% if not loop.last %} {% endif %}{% endfor %}

{# inputfile: Input file path. Use '-' to read from stdin. #}
{# outputfile: Output file path. Use '-' to write to stdout. #}
{# Renders as the input and output file arguments, separated by a space. #}
{{ inputfile | default('-') }} {{ outputfile | default('-') }}