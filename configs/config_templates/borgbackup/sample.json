{
  "repo_path": "/var/lib/borgbackup/main-repo",
  "ssh_key_path": "/root/.ssh/borg_backup_key",
  "compression": {
    "algorithm": "zstd",
    "level": 3
  },
  "encryption": {
    "mode": "repokey-blake2"
  },
  "archive_name_prefix": "{hostname}-daily-{now:%Y%m%d-%H%M%S}",
  "retention": {
    "keep_within": "7D",
    "keep_daily": 7,
    "keep_weekly": 4,
    "keep_monthly": 12,
    "keep_yearly": 3
  },
  "exclude_patterns": [
    "*.log",
    "*.tmp",
    "*.cache",
    "/tmp/*",
    "/var/tmp/*",
    "/proc/*",
    "/sys/*",
    "/dev/*",
    "/run/*"
  ],
  "backup_paths": [
    "/etc",
    "/root",
    "/home",
    "/var/lib/mysql",
    "/var/www/html"
  ],
  "features": {
    "acl_support": true,
    "xattr_support": true,
    "statx": true
  },
  "log_level": "info",
  "repository_migration": false
}
