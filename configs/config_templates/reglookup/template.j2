# Reglookup Configuration Template
#
# This template defines the invocation parameters for reglookup, a CLI tool used to read
# Windows NT registry hives (SYSTEM, SOFTWARE, etc.) and output them in structured formats.
# It is designed for use within Ansible roles to automate Windows registry forensics or
# configuration auditing from Linux/Unix hosts.

# Path to the Windows NT registry file (e.g., SYSTEM, SOFTWARE) to read.
# Corresponds to the required <registry-file> argument.
registry_file: {{ registry_file | default('/mnt/win/c/WINNT/system32/config/system') }}

# Registry path prefix to filter output. Only keys/values under this path are printed.
# Use '/' for no filter. Corresponds to the -p <prefix-filter> option.
prefix_filter: {{ prefix_filter | default('/') }}

# Registry value type filter. Restricts output to specific registry data types.
# Options: NONE, SZ, EXPAND_SZ, BINARY, DWORD, DWORD_BE, LINK, MULTI_SZ, RSRC_LIST, RSRC_DESC, RSRC_REQ_LIST, QWORD, KEY
# Corresponds to the -t <type-filter> option.
type_filter: {{ type_filter | default('NONE') }}

# If true, prints a header row in the CSV output (equivalent to -h).
# If false, suppresses the header (equivalent to -H).
# Corresponds to the -h / -H options.
declare_column_header: {{ declare_column_header | default(true) }}

# If true, printed values inherit the timestamp of their parent key (equivalent to -i).
# Corresponds to the -i option.
declare_parent_timestamp: {{ declare_parent_timestamp | default(false) }}

# If true, adds columns for security descriptor info: owner, group, sacl, dacl, class (equivalent to -s).
# If false, disables it (equivalent to -S).
# Corresponds to the -s / -S options.
declare_security_descriptor: {{ declare_security_descriptor | default(false) }}

# If true, enables verbose output (equivalent to -v).
# Corresponds to the -v option.
verbose: {{ verbose | default(false) }}

# Command construction for execution.
# Note: reglookup is a CLI tool; this section defines the arguments passed to it.
command_line: reglookup
arguments:
  - --registry-file={{ registry_file | default('/mnt/win/c/WINNT/system32/config/system') }}
  {% if prefix_filter | default('/') != '/' %}
  - --prefix-filter={{ prefix_filter | default('/') }}
  {% endif %}
  {% if type_filter | default('NONE') != 'NONE' %}
  - --type-filter={{ type_filter | default('NONE') }}
  {% endif %}
  {% if not (declare_column_header | default(true) | bool) %}
  - --no-header
  {% endif %}
  {% if (declare_parent_timestamp | default(false) | bool) %}
  - --parent-timestamp
  {% endif %}
  {% if (declare_security_descriptor | default(false) | bool) %}
  - --security-descriptor
  {% endif %}
  {% if (verbose | default(false) | bool) %}
  - --verbose
  {% endif %}