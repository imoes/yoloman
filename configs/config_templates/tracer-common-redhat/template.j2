{# tracer-common-redhat: Configure argcomplete registration for the tracer command. #}
# This block checks if the register-python-argcomplete utility is available and, if so,
# evaluates the command to enable tab-completion for the specified tracer binary.
command -v register-python-argcomplete 2>&1 > /dev/null && eval "$(register-python-argcomplete {{ tracer_binary_name | default('tracer') }})"
