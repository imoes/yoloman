{
  "log": {
    "path": "/var/log/mongodb/mongod.log",
    "append": true,
    "rotate": "rename"
  },
  "storage": {
    "dbPath": "/var/lib/mongodb",
    "journal": {
      "enabled": true
    },
    "directoryPerDB": false,
    "wiredTiger": {
      "engineConfig": {
        "cacheSizeGB": 0
      },
      "collectionConfig": {
        "blockCompressor": "snappy"
      }
    },
    "directoryForIndexFiles": false
  },
  "net": {
    "port": 27017,
    "bindIp": [
      "0.0.0.0",
      "127.0.0.1"
    ],
    "ssl": {
      "mode": "preferSSL",
      "PEMKeyFile": "/etc/ssl/mongodb.pem",
      "CAFile": "/etc/ssl/mongodb-ca.crt",
      "allowConnectionsWithoutCertificates": true
    }
  },
  "security": {
    "authorization": "enabled",
    "keyFile": "/etc/mongodb-keyfile"
  },
  "processManagement": {
    "fork": true
  },
  "replication": {
    "enabled": true,
    "replSetName": "rs0",
    "oplogSizeMB": 2048
  },
  "sharding": {
    "enabled": false,
    "clusterRole": "",
    "configDB": ""
  },
  "audit": {
    "enabled": false,
    "destination": "",
    "format": "",
    "path": ""
  },
  "systemLog": {
    "destination": "file",
    "path": "/var/log/mongodb/mongod.log",
    "logAppend": true,
    "logRotate": "rename"
  }
}
