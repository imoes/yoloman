[default]
# Number of spaces per nesting-level (affects pretty-print formatting); must be ≥ 0
indent = {{ (indent | default(4)) }}

# Whether to sort object keys alphabetically before output
sort = {{ sort | default(false) | ternary('true', 'false') }}

# Whether to produce compact JSON output (removes whitespace)
compact = {{ compact | default(false) | ternary('true', 'false') }}