{
  "modules": [
    "policy",
    "cache",
    "dnssec",
    "stats"
  ],
  "listen_addresses": [
    "127.0.0.1#53",
    "[::1]#53"
  ],
  "dnssec_enabled": true,
  "cache_size_mib": 128,
  "max_concurrent_queries": 200,
  "trust_anchor_file": "/etc/knot-resolver/trust-anchors.d/root-anchors.knssec",
  "forward_to": [
    "9.9.9.9#53",
    "149.112.112.112#53"
  ],
  "log_to_journal": false,
  "log_file_path": "/var/log/knot-resolver/kresd.log",
  "enable_query_log": true,
  "query_log_path": "/var/log/knot-resolver/queries.log",
  "rate_limit_enabled": true,
  "rate_limit_qps": 75,
  "local_data": [
    {
      "name": "internal.example.com",
      "type": "A",
      "rdata": "10.0.0.10"
    },
    {
      "name": "mail.internal.example.com",
      "type": "CNAME",
      "rdata": "internal.example.com"
    }
  ],
  "timeout_sec": 8,
  "retry_count": 3,
  "anchor_auto_update": true,
  "edns_client_subnet_mode": "1",
  "strict_mode": true
}
