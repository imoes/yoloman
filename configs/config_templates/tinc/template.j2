# tinc configuration for VPN '{{ vpn_name }}'
# Enable debugging (0=none, 1=normal, 2=verbose)
Debug = {{ debug_level }}

# Interface type: 'tap' for Ethernet, 'tun' for IP
InterfaceType = "{{ interface_type }}"

# Local network interface to bind to (optional: leave empty for auto-detect)
LocalAddress = {{ local_address | default('', true) | quote }}

# Port to listen on (default 655)
Port = {{ port }}

# Encryption cipher to use (e.g., 'blowfish', 'aes', 'chacha20')
Cipher = "{{ cipher }}"

# Hash algorithm to use (e.g., 'sha256', 'sha512')
Hash = "{{ hash }}"

# Compress traffic using 'none' or 'lzo'
Compress = "{{ compression }}"

# Maximum number of connected peers before rejecting new ones
MaxConnections = {{ max_connections }}

# Heartbeat interval in seconds to keep connections alive
KeepAlive = {{ keepalive_interval }}

# Timeout (seconds) before declaring a peer dead
Timeout = {{ timeout }}

# Enable IPv6 support? (true/false)
IPv6 = {{ ipv6 | lower }}

# List of known subnets this node announces (e.g., 10.0.0.0/24, 2001:db8::/32)
{% for subnet in subnets %}Subnet = {{ subnet }}
{% endfor %}

# Optional: Static host entries (if not using tincd -r to auto-discover)
{% for host in static_hosts %}# Host entry for {{ host.name }}
{% if host.address %}Address = {{ host.address }}
{% endif %}{{ host.config_block | default('') }}
{% endfor %}

# Optional: Pre-shared RSA key for additional security (auto-generated by tinc)
# Uncomment only if manually managing keys (not recommended in most cases)
# RSAKeyFile = /etc/tinc/{{ vpn_name }}/rsa_key.pub
