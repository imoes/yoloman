# Serving Gateway (SGW) configuration for nextepc-sgw
# Auto-generated by Ansible. Do not edit manually.
# This template is self-documenting: every directive is preceded by its schema description.

# --- Global network settings ---
sgw:
  # Network interface name for S1U (user plane) and default S11 control plane.
  interface:
    name: "{{ (sgw | default({})).interface | default({}) | attr('name') | default('eth0') }}"
    address: "{{ (sgw | default({})).interface | default({}) | attr('address') | default('10.0.0.1') }}"
    netmask: "{{ (sgw | default({})).interface | default({}) | attr('netmask') | default('255.255.255.0') }}"

  # Optional separate interface name for S1-C (control plane). If omitted, S1C shares S1U/S11 interface.
{% if (sgw | default({})).s1c is defined and (sgw | default({})).s1c is not none %}
  s1c:
    name: "{{ (sgw | default({})).s1c | default({}) | attr('name') | default('') }}"
    address: "{{ (sgw | default({})).s1c | default({}) | attr('address') | default('') }}"
{% endif %}

  # IP address for SGW S11 interface to MME. Defaults to sgw.interface.address if omitted.
  s11:
    name: "{{ (sgw | default({})).s11 | default({}) | attr('name') | default((sgw | default({})).interface | default({}) | attr('name') | default('eth0')) }}"
    address: "{{ (sgw | default({})).s11 | default({}) | attr('address') | default((sgw | default({})).interface | default({}) | attr('address') | default('10.0.0.1')) }}"

  # SGW's own IP address used in GTP-U headers for S1-U packets.
  gtpu:
    addr: "{{ (sgw | default({})).gtpu | default({}) | attr('addr') | default('10.0.0.1') }}"

  # Fully qualified domain name of this SGW for MME DNS lookup.
  fqdn: "{{ (sgw | default({})).fqdn | default('sgw.epc.mnc001.mcc001.3gppnetwork.org') }}"

  # Method to discover PGW: 'static' (explicit IP) or 'dns' (FQDN lookup).
{% if (sgw | default({})).pgw_selection is defined and (sgw | default({})).pgw_selection is not none and (sgw | default({})).pgw_selection == 'static' %}
  pgw:
    # Static IP address of the PGW (used if pgw_selection='static').
    addr: "{{ (sgw | default({})).pgw | default({}) | attr('addr') | default('10.0.0.20') }}"
{% else %}
  pgw:
    # PGW FQDN for DNS resolution (used if pgw_selection='dns' or omitted).
    fqdn: "{{ (sgw | default({})).pgw | default({}) | attr('fqdn') | default('pgw.epc.mnc001.mcc001.3gppnetwork.org') }}"
{% endif %}

  # Bearer limits & timeouts
  gtpu:
    # Maximum number of active EPS bearers allowed per UE (1–11).
    max_bearers_per_ue: {{ (sgw | default({})).max_bearers_per_ue | default(8) }}

    # GTP-U keepalive interval (seconds) between endpoint probes.
{% if (sgw | default({})).gtpu_timeouts is defined and (sgw | default({})).gtpu_timeouts is not none %}
    keepalive: {{ (sgw | default({})).gtpu_timeouts | default({}) | attr('keepalive') | default(30) }}
    # Timeout (seconds) after which an inactive GTP-U tunnel is deleted.
    no_data_timeout: {{ (sgw | default({})).gtpu_timeouts | default({}) | attr('no_data_timeout') | default(300) }}
{% endif %}

  # Logging configuration
  log:
    # Logging verbosity: 'trace', 'debug', 'info', 'warning', 'error', or 'fatal'.
    level: "{{ (sgw | default({})).log | default({}) | attr('level') | default('info') }}"
    # Optional log file path. If omitted, logs go to stdout.
{% if (sgw | default({})).log | default({}) | attr('file') is defined and (sgw | default({})).log | default({}) | attr('file') is not none and (sgw | default({})).log | default({}) | attr('file') != '' %}
    file: "{{ (sgw | default({})).log | default({}) | attr('file') }}"
{% endif %}

  # Mobility Management Entity (MME) list for load balancing and redundancy.
{% if (sgw | default({})).mme_list is defined and (sgw | default({})).mme_list is not none and ((sgw | default({})).mme_list | length) > 0 %}
  mme_list:
{% for mme in (sgw | default({})).mme_list %}
    - ip: "{{ (mme | default({})) | attr('ip') | default('') }}"
      fqdn: "{{ (mme | default({})) | attr('fqdn') | default('') }}"
{% endfor %}
{% endif %}

  # List of APN configurations. Each entry defines APN name, SMF address, QoS, and optional AMBR.
{% if (sgw | default({})).apns is defined and (sgw | default({})).apns is not none and ((sgw | default({})).apns | length) > 0 %}
  apns:
{% for apn in (sgw | default({})).apns %}
    - apn: "{{ (apn | default({})) | attr('apn') | default('') }}"
      smf:
        addr: "{{ (apn | default({})).smf | default({}) | attr('addr') | default('') }}"
{% if (apn | default({})).smf | default({}) | attr('fqdn') is defined and (apn | default({})).smf | default({}) | attr('fqdn') is not none %}
        fqdn: "{{ (apn | default({})).smf | default({}) | attr('fqdn') }}"
{% endif %}
      qos:
        qci: {{ (apn | default({})).qos | default({}) | attr('qci') | default(0) }}
        arp:
          priority_level: {{ ((apn | default({})).qos | default({})).arp | default({}) | attr('priority_level') | default(0) }}
          pre_emption_vulnerability: {{ (((apn | default({})).qos | default({})).arp | default({})) | attr('pre_emption_vulnerability') | default(false) | lower }}
          pre_emption_capability: {{ (((apn | default({})).qos | default({})).arp | default({})) | attr('pre_emption_capability') | default(false) | lower }}
{% if (apn | default({})).ambr is defined and (apn | default({})).ambr is not none %}
      ambr:
        uplink: {{ (apn | default({})).ambr | default({}) | attr('uplink') | default(0) }}
        downlink: {{ (apn | default({})).ambr | default({}) | attr('downlink') | default(0) }}
{% endif %}
{% endfor %}
{% endif %}

  # Optional: NAT or firewall hints (ignored by SGW but kept for config portability).
{% if (sgw | default({})).nat is defined and (sgw | default({})).nat is not none %}
  nat:
    # Enable NAT on SGW S1-U (rarely needed; typically handled by outer network).
    enabled: {{ ((sgw | default({})).nat | default({})) | attr('enabled') | default(false) | lower }}
{% endif %}