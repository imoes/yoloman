# Zabbix Proxy MySQL - Logrotate Configuration
# This template generates the logrotate configuration for the Zabbix Proxy MySQL backend.
# It handles rotation, compression, and file permissions for the proxy's log file.

# Directory where Zabbix proxy logs are stored
/var/log/{{ log_directory | default('zabbix-proxy') }}/zabbix_proxy.log {
    # Rotate logs weekly
    weekly

    # Number of rotated log files to keep
    # Defaults to 7, ensuring one week of history is preserved.
    rotate {{ log_rotation_count | default('7') }}

    # Compress rotated log files to save disk space
    compress

    # Delay compression of the most recent rotated file until the next rotation cycle.
    # This allows tools like `logrotate` scripts or monitoring agents to read the just-rotated file if needed.
    delaycompress

    # Do not error out if the log file is missing (e.g., if Zabbix proxy is not running or log path changed)
    missingok

    # Do not rotate an empty log file
    notifempty

    # Create new log files with specified permissions and ownership
    # Permissions: 0640 (owner read/write, group read, others none)
    # Owner: zabbix (the service user)
    # Group: zabbix (the service group)
    create {{ log_file_permissions | default('0640') }} {{ log_owner | default('zabbix') }} {{ log_group | default('zabbix') }}

    # Execute the postrotate script for all log files matched by this block as a single script
    sharedscripts
}
