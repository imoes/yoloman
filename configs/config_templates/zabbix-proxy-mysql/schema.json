{
  "log_directory": {
    "type": "string",
    "default": "zabbix-proxy",
    "description": "Directory where Zabbix proxy logs are stored"
  },
  "log_rotation_count": {
    "type": "number",
    "default": 7,
    "description": "Number of rotated log files to keep"
  },
  "log_file_permissions": {
    "type": "string",
    "default": "0640",
    "description": "Permissions for new log files"
  },
  "log_owner": {
    "type": "string",
    "default": "zabbix",
    "description": "Owner of the log files"
  },
  "log_group": {
    "type": "string",
    "default": "zabbix",
    "description": "Group of the log files"
  }
}
