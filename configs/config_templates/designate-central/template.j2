#!/bin/sh
### BEGIN INIT INFO
# Provides:          {{ service_name | default('designate-central') }}
# Required-Start:    $network $local_fs $remote_fs $syslog
# Required-Stop:     $remote_fs
# Should-Start:      postgresql mysql keystone rabbitmq-server ntp
# Should-Stop:       postgresql mysql keystone rabbitmq-server ntp
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Designate API
# Description:       {{ service_description | default('Frontend Designate API server') }}
### END INIT INFO

# Author: Thomas Goirand <zigo@debian.org>

# Short description of the service instance
# Describes the OpenStack Designate DNSaaS central service instance
DESC="OpenStack Designate DNSaaS central ({{ service_name | default('designate-central') }})"

# OpenStack project name used for constructing paths, usernames, and group names
# Used to build consistent directory structures and service identities
PROJECT_NAME={{ project_name | default('designate') }}

# Base name of the daemon/process
# Constructs the standard openstack-{service} naming convention
NAME=${PROJECT_NAME}-central

# Environment variable for Oslo messaging process identification
# Passed to RabbitMQ/Kombu for process tracking in the message queue
export OS_OSLO_MESSAGING_RABBIT__PROCESSNAME={{ service_name | default('designate-central') }}
#!/bin/sh
# The content after this line comes from openstack-pkg-tools
# and has been automatically added to an .init.in script, which
# contains only the descriptive part for the daemon. Everything
# else is standardized as a single unique script.

# Author: Thomas Goirand <zigo@debian.org>
# Author: Ondřej Nový <novy@ondrej.org>

# PATH should only include /usr/* if it runs after the mountnfs.sh script
PATH=/sbin:/usr/sbin:/bin:/usr/bin

# Check if uWSGI mode is enabled and all required uWSGI variables are set
# uWSGI is an optional application server for the Designate API
if [ -n "{{ UWSGI_PORT | default('9001') }}" ] && [ -n "{{ UWSGI_INI_PATH | default('/etc/designate/designate-central.ini') }}" ] && [ -n "{{ UWSGI_INI_APP | default('/etc/designate/designate-central.wsgi') }}" ] ; then
	# Exit gracefully if the uWSGI application entrypoint does not exist
	# Ensures the service doesn't start if the WSGI app is missing
	if ! [ -f "{{ UWSGI_INI_APP | default('/etc/designate/designate-central.wsgi') }}" ] ; then
		exit 0
	fi

	# Search for the SSL private key file if the directory exists
	# Used for HTTPS connections when uWSGI is active
	if [ -d /etc/{{ project_name | default('designate') }}/ssl/private ] ; then
		KEY_FILE=$(find /etc/{{ project_name | default('designate') }}/ssl/private -type f -iname '*.pem' 2>/dev/null | head -n 1)
	fi

	# Determine the SSL certificate file path
	# Checks for Puppet-managed certs first, then standard SSL dirs
	if [ -e /usr/local/share/ca-certificates/puppet_openstack.crt ] ; then
		# This is needed for puppet...
		CERT_FILE=/usr/local/share/ca-certificates/puppet_openstack.crt
	else
		if [ -d /etc/{{ project_name | default('designate') }}/ssl/public ] ; then
			CERT_FILE=$(find /etc/{{ project_name | default('designate') }}/ssl/public -type f -iname '*.crt' 2>/dev/null | head -n 1)
		fi
	fi

	# Detect the specific uWSGI Python binary version available on the system
	# Iterates through common Python 3 versions to find the installed uwsgi binary
	for i in 3 35 36 37 38 39 310 311 312 313 314 315 316 317 318 319 ; do
		if [ -x /usr/bin/uwsgi_python${i} ] ; then
			DAEMON=/usr/bin/uwsgi_python${i}
		fi
	done

	# If bind configuration directives are provided, parse them to determine IP and port
	# Allows dynamic binding configuration via external ini files
	if [ -n "${UWSGI_BIND_CONFIG_FILE}" ] && [ -r "${UWSGI_BIND_CONFIG_FILE}" ] && [ -n "${UWSGI_BIND_CONFIG_SECTION}" ] && [ -n "${UWSGI_BIND_CONFIG_IP_DIRECTIVE}" ] && [ -n "${UWSGI_BIND_CONFIG_PORT_DIRECTIVE}" ] && [ -r /usr/share/openstack-pkg-tools/pkgos_func ] ; then
		. /usr/share/openstack-pkg-tools/pkgos_func
		pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_IP_DIRECTIVE}
	        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
			UWSGI_BIND_IP=${RET}
		fi
		pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_PORT_DIRECTIVE}
	        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
			UWSGI_PORT=${RET}
		fi
		# Determine number of workers based on config or fallback to CPU count heuristic
		if [ -n "${UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE}" ] ; then
			pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE}
		        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
				UWSGI_PROCESSES=" --processes ${RET}
			else
				# If we can't find the directive in the config file,
				# we fallback to the number of thread / 2.
				UWSGI_PROCESSES=" --processes "$(( $(nproc) / 2 ))
			fi
		fi
		# Special handling for Swift object-server to bind multiple ports
		if [ "${UWSGI_BIND_CONFIG_FILE}" = "/etc/swift/object-server.conf" ] ; then
			pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} devices
			if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
				DEVICES_PATH=${RET}
				NUM_DEVICES=$(ls ${DEVICES_PATH} | wc -l)
				COUNT=0
				while [ "${COUNT}" != "${NUM_DEVICES}" ] ; do
					CUR_PORT=$(( ${UWSGI_PORT} + ${COUNT} ))
					BIND_PARAMS="${BIND_PARAMS} --http-socket ${UWSGI_BIND_IP}:${CUR_PORT}"
					COUNT=$(( ${COUNT} + 1 ))
				done
			fi
		fi
	else
		UWSGI_BIND_IP=""
	fi

	# Construct daemon arguments for binding and SSL
	if [ -n "${BIND_PARAMS}" ] ; then
		DAEMON_ARGS="${BIND_PARAMS}${UWSGI_PROCESSES}"
	else
		if [ -n "${KEY_FILE}" ] && [ -n "${CERT_FILE}" ] ; then
			# HTTPS socket configuration with certificate and key
			DAEMON_ARGS="--https-socket ${UWSGI_BIND_IP}:{{ UWSGI_PORT | default('9001') }},${CERT_FILE},${KEY_FILE}${UWSGI_PROCESSES}"
		else
			# HTTP socket configuration
			DAEMON_ARGS="--http-socket ${UWSGI_BIND_IP}:{{ UWSGI_PORT | default('9001') }}${UWSGI_PROCESSES}"
		fi
	fi

	# Append the uWSGI ini file path to arguments
	DAEMON_ARGS="${DAEMON_ARGS} --ini {{ UWSGI_INI_PATH | default('/etc/designate/designate-central.ini') }}"
	NO_OPENSTACK_CONFIG_FILE_DAEMON_ARG=yes
	NO_OPENSTACK_LOGFILE_DAEMON_ARG=yes
fi

# Set default daemon binary if not determined by uWSGI detection
# Falls back to the standard openstack-daemon binary
if [ -z "${DAEMON}" ] ; then
	DAEMON=/usr/bin/${NAME}
fi

# Standard paths for PID, script name, user, group, and config
PIDFILE=/var/run/{{ project_name | default('designate') }}/${NAME}.pid
if [ -z "${SCRIPTNAME}" ] ; then
	SCRIPTNAME=/etc/init.d/${NAME}
fi
if [ -z "{{ SYSTEM_USER | default('designate') }}" ] ; then
	SYSTEM_USER={{ project_name | default('designate') }}
fi
if [ -z "{{ SYSTEM_GROUP | default('designate') }}" ] ; then
	SYSTEM_GROUP={{ project_name | default('designate') }}
fi
if [ "{{ SYSTEM_USER | default('designate') }}" != "root" ] ; then
	STARTDAEMON_CHUID="--chuid {{ SYSTEM_USER | default('designate') }}:{{ SYSTEM_GROUP | default('designate') }}"
fi
if [ -z "{{ CONFIG_FILE | default('/etc/designate/designate.conf') }}" ] ; then
	CONFIG_FILE=/etc/{{ project_name | default('designate') }}/{{ project_name | default('designate') }}.conf
fi
LOGFILE=/var/log/{{ project_name | default('designate') }}/${NAME}.log
if [ -z "${NO_OPENSTACK_CONFIG_FILE_DAEMON_ARG}" ] ; then
	DAEMON_ARGS="--config-file={{ CONFIG_FILE | default('/etc/designate/designate.conf') }} ${DAEMON_ARGS}"
fi

# Exit if the package is not installed (daemon binary missing)
[ -x $DAEMON ] || exit 0

# If ran as root, create /var/lock/X, /var/run/X and /var/cache/X as needed
# Ensures necessary directories exist with correct ownership
if [ `whoami` = "root" ] ; then
	for i in lock run cache ; do
		mkdir -p /var/$i/{{ project_name | default('designate') }}
		chown {{ SYSTEM_USER | default('designate') }}:{{ SYSTEM_GROUP | default('designate') }} /var/$i/{{ project_name | default('designate') }}
	done
fi

# This defines support functions which we use later on
. /lib/lsb/init-functions

RET=0

# Manage log options: logfile and/or syslog, depending on user's choosing
[ -r /etc/default/openstack ] && . /etc/default/openstack
[ -r /etc/default/$NAME ] && . /etc/default/$NAME
[ "x$USE_SYSLOG" = "xyes" ] && DAEMON_ARGS="$DAEMON_ARGS --use-syslog"
if [ -z "${NO_OPENSTACK_LOGFILE_DAEMON_ARG}" ] ; then
	[ "x$USE_LOGFILE" != "xno" ] && DAEMON_ARGS="$DAEMON_ARGS --log-file={{ LOGFILE | default('/var/log/designate/designate-central.log') }}"
fi

do_start() {
	start-stop-daemon \
		--start \
		--quiet \
		--background ${STARTDAEMON_CHUID} \
		--make-pidfile --pidfile {{ PIDFILE | default('/var/run/designate/designate-central.pid') }} \
		--chdir /var/lib/{{ project_name | default('designate') }} \
		--startas $DAEMON \
		--test > /dev/null \
		|| return 1
	if [ -n "${PYARGV}" ] ; then
		start-stop-daemon \
			--start \
			--quiet \
			--background ${STARTDAEMON_CHUID} \
			--make-pidfile --pidfile {{ PIDFILE | default('/var/run/designate/designate-central.pid') }} \
			--chdir /var/lib/{{ project_name | default('designate') }} \
			--startas $DAEMON \
			-- $DAEMON_ARGS --pyargv "${PYARGV}" \
			|| return 2
	else
		start-stop-daemon \
			--start \
			--quiet \
			--background ${STARTDAEMON_CHUID} \
			--make-pidfile --pidfile {{ PIDFILE | default('/var/run/designate/designate-central.pid') }} \
			--chdir /var/lib/{{ project_name | default('designate') }} \
			--startas $DAEMON \
			-- $DAEMON_ARGS \
			|| return 2
	fi
}

do_stop() {
	start-stop-daemon \
		--stop \
		--quiet \
		--retry=TERM/30/KILL/5 \
		--pidfile {{ PIDFILE | default('/var/run/designate/designate-central.pid') }}
	RETVAL=$?
	rm -f {{ PIDFILE | default('/var/run/designate/designate-central.pid') }}
	return "$RETVAL"
}

do_systemd_start() {
	# Set umask to ensure log files are created with 0644 mode bits
	# Note we can't set 0026 to have files 0640, because that's going
	# to be in use in for example neutron-dhcp-agent, which makes it
	# so it wont't be able to read /var/lib/neutron/external/pids/*.pid.haproxy
	# and then fail hardly. However, 0022 is enough, since the log
	# folders are owned by <project>:adm, so users don't have access
	# to it unless they are on the adm group, which is what we want.
	umask 0022
	if [ -n "${PYARGV}" ] ; then
		exec $DAEMON $DAEMON_ARGS --pyargv "${PYARGV}"
	else
		exec $DAEMON $DAEMON_ARGS
	fi
}

case "$1" in
start)
	log_daemon_msg "Starting $DESC" "$NAME"
	do_start
	case $? in
		0|1) log_end_msg 0 ; RET=$? ;;
		2)   log_end_msg 1 ; RET=$? ;;
	esac
;;
stop)
	log_daemon_msg "Stopping $DESC" "$NAME"
	do_stop
	case $? in
		0|1) log_end_msg 0 ; RET=$? ;;
		2)   log_end_msg 1 ; RET=$? ;;
	esac
;;
status)
	status_of_proc "$DAEMON" "$NAME"
	RET=$?
;;
systemd-start)
	do_systemd_start
;;  
show-args)
	if [ -n "${PYARGV}" ] ; then
		echo $DAEMON $DAEMON_ARGS --pyargv \"${PYARGV}\"
	else
		echo $DAEMON $DAEMON_ARGS
	fi
;;
restart|force-reload)
	log_daemon_msg "Restarting $DESC" "$NAME"
	do_stop
	case $? in
		0|1)
			do_start
			case $? in
				0) log_end_msg 0 ; RET=$? ;;
				1) log_end_msg 1 ; RET=$? ;; # Old process is still running
				*) log_end_msg 1 ; RET=$? ;; # Failed to start
			esac
		;;
		*) log_end_msg 1 ; RET=$? ;; # Failed to stop
	esac
;;
*)
	echo "Usage: $SCRIPTNAME {start|stop|status|restart|force-reload|systemd-start}" >&2
	RET=3
;;
esac

exit $RET