[debug]
# Debug log level for general ktls-utils operations.
# Valid values are integers; 0 typically means no debug logging.
loglevel={{ loglevel | default(0) }}

# Debug log level for TLS operations.
# Valid values are integers; 0 typically means no debug logging.
tls={{ tls_debug | default(0) }}

# Debug log level for Netlink operations.
# Valid values are integers; 0 typically means no debug logging.
nl={{ nl_debug | default(0) }}

[authenticate]
# Semicolon-separated list of keyrings to use for authentication.
# If empty, the default system keyring is used or none.
{% if keyrings is defined and keyrings is not none and (keyrings is number or keyrings is boolean or keyrings | length > 0) %}keyrings={{ keyrings | default('') }}{% else %}#keyrings= <keyring>;<keyring>;<keyring>{% endif %}

[authenticate.client]
# Path to the X.509 truststore for client authentication.
# Used to verify server certificates during client-initiated TLS connections.
{% if x509_truststore_client is defined and x509_truststore_client is not none and x509_truststore_client != '' %}x509.truststore={{ x509_truststore_client }}{% else %}#x509.truststore= <pathname>{% endif %}

# Path to the X.509 certificate for client authentication.
# The public certificate presented to the server.
{% if x509_certificate_client is defined and x509_certificate_client is not none and x509_certificate_client != '' %}x509.certificate={{ x509_certificate_client }}{% else %}#x509.certificate= <pathname>{% endif %}

# Path to the private key for client authentication.
# The private key corresponding to the client certificate.
{% if x509_private_key_client is defined and x509_private_key_client is not none and x509_private_key_client != '' %}x509.private_key={{ x509_private_key_client }}{% else %}#x509.private_key= <pathname>{% endif %}

[authenticate.server]
# Path to the X.509 truststore for server authentication.
# Used to verify client certificates during server-initiated TLS connections.
{% if x509_truststore_server is defined and x509_truststore_server is not none and x509_truststore_server != '' %}x509.truststore={{ x509_truststore_server }}{% else %}#x509.truststore= <pathname>{% endif %}

# Path to the X.509 certificate for server authentication.
# The public certificate presented by the server.
{% if x509_certificate_server is defined and x509_certificate_server is not none and x509_certificate_server != '' %}x509.certificate={{ x509_certificate_server }}{% else %}#x509.certificate= <pathname>{% endif %}

# Path to the private key for server authentication.
# The private key corresponding to the server certificate.
{% if x509_private_key_server is defined and x509_private_key_server is not none and x509_private_key_server != '' %}x509.private_key={{ x509_private_key_server }}{% else %}#x509.private_key= <pathname>{% endif %}
