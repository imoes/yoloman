# =============================================================================
# mccs Configuration Template
# =============================================================================
# Multi Criteria CUDF Solver configuration file.
# This template is self-documenting: every directive is preceded by its
# schema description and the corresponding command-line flag.
#
# Variables should be defined in the Ansible inventory or role defaults.
# All variables have safe defaults matching the schema.
# =============================================================================

# -----------------------------------------------------------------------------
# input_file: Path to the CUDF input file. Corresponds to -i.
# -----------------------------------------------------------------------------
input_file: {{ input_file | default('/etc/mccs/problem.cudf') }}

# -----------------------------------------------------------------------------
# output_file: Path to the output solution file. Corresponds to -o.
# -----------------------------------------------------------------------------
output_file: {{ output_file | default('/var/log/mccs/solution.sol') }}

# -----------------------------------------------------------------------------
# verbosity: Verbosity level n. Corresponds to -v n.
# -----------------------------------------------------------------------------
verbosity: {{ verbosity | default(1) }}

# -----------------------------------------------------------------------------
# use_lpsolve: Use lpsolve solver. Corresponds to -lpsolve.
# -----------------------------------------------------------------------------
use_lpsolve: {{ use_lpsolve | default(false) | lower }}

# -----------------------------------------------------------------------------
# lpsolver_script: Path to the LP solver script (CPLEX format).
#                  Corresponds to -lp.
# -----------------------------------------------------------------------------
lpsolver_script: {{ lpsolver_script | default('cbc') }}

# -----------------------------------------------------------------------------
# use_pbsolver: Use pbsolver. Corresponds to -pblib.
# -----------------------------------------------------------------------------
use_pbsolver: {{ use_pbsolver | default(false) | lower }}

# -----------------------------------------------------------------------------
# no_reduce: Do not reduce initial problem. Corresponds to -noreduce.
# -----------------------------------------------------------------------------
no_reduce: {{ no_reduce | default(false) | lower }}

# -----------------------------------------------------------------------------
# only_aggregate: Generate only aggregate constraints.
#                 Corresponds to -only-agregate-constraints.
# -----------------------------------------------------------------------------
only_aggregate: {{ only_aggregate | default(false) | lower }}

# -----------------------------------------------------------------------------
# only_deaggregate: Generate only deaggregate constraints.
#                   Corresponds to -only-desagregate-constraints.
# -----------------------------------------------------------------------------
only_deaggregate: {{ only_deaggregate | default(true) | lower }}

# -----------------------------------------------------------------------------
# all_constraints: Generate all kinds of constraints.
#                  Corresponds to -all-constraints.
# -----------------------------------------------------------------------------
all_constraints: {{ all_constraints | default(false) | lower }}

# -----------------------------------------------------------------------------
# no_solve: Do not solve the problem. Corresponds to -nosolve.
# -----------------------------------------------------------------------------
no_solve: {{ no_solve | default(false) | lower }}

# -----------------------------------------------------------------------------
# full_output: Full solution output. Corresponds to -fo.
# -----------------------------------------------------------------------------
full_output: {{ full_output | default(false) | lower }}

# -----------------------------------------------------------------------------
# criteria: List of optimization criteria strings.
#           Corresponds to -lex..., -lexsemiagregate, etc.
# -----------------------------------------------------------------------------
criteria: {{ criteria | default(['paranoid']) }}