{
  "default_dir": "/var/lib/crm114",
  "mail_dir": "/var/spool/crm114/incoming",
  "word_separator": "\\W+",
  "case_sensitive": false,
  "default_category": "UNKNOWN",
  "require_training": true,
  "max_training_items": 10000,
  "spam_cutoff": 0.9,
  "ham_cutoff": 0.1,
  "max_features": 2500,
  "verbosity": 2,
  "spam_dict_file": "/var/lib/crm114/spam.dict",
  "ham_dict_file": "/var/lib/crm114/ham.dict",
  "preprocess_rules": [
    {
      "pattern": "<[^>]+>",
      "replacement": " "
    },
    {
      "pattern": "https?://[^\\s]+",
      "replacement": " URL "
    }
  ],
  "feature_weights": [
    {
      "name": "free",
      "weight": 2.5
    },
    {
      "name": "viagra",
      "weight": 10.0
    }
  ],
  "classifier_method": "BAYES",
  "min_word_length": 2,
  "max_word_length": 20,
  "tokenization_mode": "EMAIL",
  "max_threads": 4
}
