# CRM114 Mail Classifier Configuration File
# Generated by service template — site-specific values injected below

# General settings
DEFAULTDIR = {{ default_dir }}
MAILDIR = {{ mail_dir }}

# Feature extraction: word separators, case sensitivity, etc.
WORDSEPARATOR = "{{ word_separator }}"
CASESENSITIVE = {{ case_sensitive | lower }}

# Classifier mode: SPAM, HAM, or UNKNOWN; also controls training behavior
DEFAULTCATEGORY = "{{ default_category }}"

# Training control
REQUIRETRAINING = {{ require_training | lower }}
MAXTRAININGITEMS = {{ max_training_items }}

# Bayesian classifier thresholds (adjust for precision/recall tradeoff)
SPAMCUTOFF = {{ spam_cutoff }}
HAMCUTOFF = {{ ham_cutoff }}

# Maximum number of features (tokens) to consider per message
MAXFEATURES = {{ max_features }}

# Log verbosity: 0 (quiet) to 5 (debug)
VERBOSITY = {{ verbosity }}

# Path to the spam/ham dictionary files (used for persistent storage)
SPAMDICTFILE = "{{ spam_dict_file }}"
HAMDICTFILE = "{{ ham_dict_file }}"

# Optional: preprocessing rules (regex-based transformations)
# Each rule: pattern => replacement
{% for rule in preprocess_rules %}
PREPROCESS = /{{ rule.pattern }}/{{ rule.replacement }}/
{% endfor %}

# Optional: feature weighting overrides (advanced)
# Format: FEATUREWEIGHT name = weight
{% for weight in feature_weights %}
FEATUREWEIGHT {{ weight.name }} = {{ weight.weight }}
{% endfor %}

# Optional: classifier method selection (e.g., BAYES, NAIVE, NAIVEBAYES)
{% if classifier_method %}
METHOD = "{{ classifier_method }}"
{% endif %}

# Optional: feature extraction tweaks
{% if min_word_length > 0 %}
MINWORDLENGTH = {{ min_word_length }}
{% endif %}

{% if max_word_length > 0 %}
MAXWORDLENGTH = {{ max_word_length }}
{% endif %}

# Optional: tokenization mode (e.g., for non-English text)
{% if tokenization_mode %}
TOKENIZATIONMODE = "{{ tokenization_mode }}"
{% endif %}

# Optional: performance tuning — thread/worker limits (if compiled with threading support)
{% if max_threads > 0 %}
MAXTHREADS = {{ max_threads }}
{% endif %}
