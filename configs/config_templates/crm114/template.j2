# ==============================================================================
# CRM114 Mail Classifier Configuration
# ==============================================================================
# This file configures the CRM114 text classification engine, typically used
# to filter email spam vs ham.
#
# Self-documenting: every directive is preceded by a comment explaining its
# purpose and source variable. All variables use safe defaults from the schema.
# ==============================================================================

# [General Settings]

# Base directory for CRM114 runtime files (dictionaries, logs).
# Source: default_dir
# Default: /var/lib/crm114
DEFAULTDIR = {{ default_dir | default('/var/lib/crm114') }}

# Directory where incoming mail is staged for classification.
# Source: mail_dir
# Default: /var/spool/crm114
MAILDIR = {{ mail_dir | default('/var/spool/crm114') }}

# [Feature Extraction]

# Regex pattern to split text into tokens (e.g., whitespace, punctuation).
# Source: word_separator
# Default: \s+
# Note: The pattern is quoted because it may contain special characters.
WORDSEPARATOR = "{{ word_separator | default('\\s+') }}"

# Whether tokenization should preserve case. Disable for better generalization.
# Source: case_sensitive
# Default: false
# Converted to lowercase for INI-style boolean representation.
CASESENSITIVE = {{ case_sensitive | default(False) | lower }}

# [Classifier Mode]

# Category assigned to unclassified messages. Typically 'SPAM', 'HAM', or 'UNKNOWN'.
# Source: default_category
# Default: UNKNOWN
DEFAULTCATEGORY = "{{ default_category | default('UNKNOWN') }}"

# [Training Control]

# If true, classify only if sufficient training data exists; otherwise assign default category.
# Source: require_training
# Default: true
# Converted to lowercase for INI-style boolean representation.
REQUIRETRAINING = {{ require_training | default(True) | lower }}

# Maximum number of items (messages) to retain per category in memory/dict.
# Source: max_training_items
# Default: 5000
MAXTRAININGITEMS = {{ max_training_items | default(5000) }}

# [Bayesian Classifier Thresholds]

# Minimum probability (0.0–1.0) to classify a message as SPAM.
# Source: spam_cutoff
# Default: 0.95
SPAMCUTOFF = {{ spam_cutoff | default(0.95) }}

# Maximum probability (0.0–1.0) to classify a message as HAM.
# Messages with probability below this are HAM; above SPAMCUTOFF are SPAM;
# between are UNKNOWN.
# Source: ham_cutoff
# Default: 0.05
HAMCUTOFF = {{ ham_cutoff | default(0.05) }}

# [Feature Limits]

# Upper limit on number of tokens used per message for classification.
# Source: max_features
# Default: 2000
MAXFEATURES = {{ max_features | default(2000) }}

# [Logging]

# Logging verbosity level: 0 (quiet) to 5 (detailed debug).
# Source: verbosity
# Default: 1
VERBOSITY = {{ verbosity | default(1) }}

# [Dictionary Files]

# Path to persistent dictionary storing SPAM-specific token statistics.
# Source: spam_dict_file
# Default: /var/lib/crm114/spam.dict
SPAMDICTFILE = "{{ spam_dict_file | default('/var/lib/crm114/spam.dict') }}"

# Path to persistent dictionary storing HAM-specific token statistics.
# Source: ham_dict_file
# Default: /var/lib/crm114/ham.dict
HAMDICTFILE = "{{ ham_dict_file | default('/var/lib/crm114/ham.dict') }}"

# [Optional: Preprocessing Rules]

# List of regex-based preprocessing rules applied to text before tokenization.
# Each rule is formatted as: PREPROCESS = /pattern/replacement/
# Source: preprocess_rules
{% if preprocess_rules is defined and preprocess_rules | length > 0 %}
{% for rule in preprocess_rules %}
PREPROCESS = /{{ rule.pattern }}/
{% endfor %}
{% endif %}

# [Optional: Feature Weighting]

# List of per-feature weight overrides (e.g., to boost/mute specific tokens).
# Format: FEATUREWEIGHT <name> = <weight>
# Source: feature_weights
{% if feature_weights is defined and feature_weights | length > 0 %}
{% for weight in feature_weights %}
FEATUREWEIGHT {{ weight.name }} = {{ weight.weight }}
{% endfor %}
{% endif %}

# [Optional: Classifier Method]

# Classification algorithm: 'BAYES' (default), 'NAIVE', or 'NAIVEBAYES'.
# Source: classifier_method
# Default: BAYES
{% if classifier_method is defined and classifier_method | length > 0 %}
METHOD = "{{ classifier_method }}"
{% else %}
METHOD = "BAYES"
{% endif %}

# [Optional: Feature Extraction Tweaks]

# Minimum token length to include (0 = no minimum). Reduces noise from very short tokens.
# Source: min_word_length
# Default: 0
{% if min_word_length is defined and min_word_length > 0 %}
MINWORDLENGTH = {{ min_word_length }}
{% endif %}

# Maximum token length to include (0 = no maximum). Cuts off unreasonably long tokens.
# Source: max_word_length
# Default: 0
{% if max_word_length is defined and max_word_length > 0 %}
MAXWORDLENGTH = {{ max_word_length }}
{% endif %}

# [Optional: Tokenization Mode]

# Advanced tokenization strategy: e.g., 'UTF8' (for multilingual), 'EMAIL' (for MIME-aware parsing).
# Leave empty for default.
# Source: tokenization_mode
# Default: (empty)
{% if tokenization_mode is defined and tokenization_mode | length > 0 %}
TOKENIZATIONMODE = "{{ tokenization_mode }}"
{% endif %}

# [Optional: Performance Tuning]

# Maximum concurrent threads for parallel classification (0 = auto-detect or disabled).
# Requires threaded build.
# Source: max_threads
# Default: 0
{% if max_threads is defined and max_threads > 0 %}
MAXTHREADS = {{ max_threads }}
{% endif %}