{
  "fsid": "a0b1c2d3-e4f5-6789-0a1b-2c3d4e5f6789",
  "mon_initial_members": [
    "mon1",
    "mon2",
    "mon3"
  ],
  "mon_host": [
    "10.0.1.10",
    "10.0.1.11",
    "10.0.1.12"
  ],
  "public_network": "10.0.1.0/24",
  "cluster_network": "10.0.2.0/24",
  "auth_cluster_required": "cephx",
  "auth_service_required": "cephx",
  "auth_client_required": "cephx",
  "log_file": "/var/log/ceph/ceph-$name.$pid.log",
  "ms_bind_ipv4": true,
  "ms_bind_ipv6": false,
  "mon_data": "/var/lib/ceph/mon/ceph-$id",
  "mon_clock_drift_allowed": 0.05,
  "mon_clock_drift_warn_backoff": 10,
  "mon_lease": 15,
  "mon_lease_renew_interval": 10,
  "mon_lease_ack_timeout": 20,
  "mon_osd_min_down_reporters": 2,
  "mon_osd_reporter_subtree_level": "host",
  "mon_data_size_hint": 0,
  "additional_services": [
    {
      "name": "mds",
      "options": {
        "mds_max_file_size": "1073741824",
        "mds_cache_memory_limit": "4294967296"
      }
    },
    {
      "name": "mgr",
      "options": {
        "mgr_modules": "dashboard,restful"
      }
    }
  ]
