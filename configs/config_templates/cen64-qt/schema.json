{
  "config_dir": {
    "type": "string",
    "default": "~/.config/cen64-qt",
    "description": "User configuration directory path"
  },
  "rom_dir": {
    "type": "string",
    "default": "~/roms/n64",
    "description": "Directory containing N64 ROM files"
  },
  "video_plugin": {
    "type": "string",
    "default": "/usr/lib/cen64/video.so",
    "description": "Path to the video rendering plugin"
  },
  "audio_plugin": {
    "type": "string",
    "default": "/usr/lib/cen64/audio.so",
    "description": "Path to the audio plugin"
  },
  "input_plugin": {
    "type": "string",
    "default": "/usr/lib/cen64/input.so",
    "description": "Path to the input handling plugin"
  },
  "save_dir": {
    "type": "string",
    "default": "~/.local/share/cen64-qt",
    "description": "Directory for save states and SRAM files"
  },
  "config_version": {
    "type": "number",
    "default": 2,
    "description": "Configuration format version"
  },
  "window_width": {
    "type": "number",
    "default": 800,
    "description": "Initial window width (pixels)"
  },
  "window_height": {
    "type": "number",
    "default": 600,
    "description": "Initial window height (pixels)"
  },
  "fullscreen": {
    "type": "bool",
    "default": false,
    "description": "Start application in fullscreen mode"
  },
  "aspect_ratio": {
    "type": "number",
    "default": 0,
    "description": "Display aspect ratio mode (0: original, 1: stretch, 2: force 4:3, 3: force 16:9)"
  },
  "audio_device": {
    "type": "string",
    "default": "",
    "description": "Audio output device name (empty string for default)"
  },
  "audio_latency": {
    "type": "number",
    "default": 20,
    "description": "Audio buffer latency in milliseconds"
  },
  "audio_volume": {
    "type": "number",
    "default": 80,
    "description": "Initial audio volume (0\u2013100)"
  },
  "input_devices": {
    "type": "list",
    "default": [],
    "description": "List of connected input devices (e.g., gamepads, keyboards). Each device specifies type and optional device ID for mapping purposes."
  },
  "plugins": {
    "type": "list",
    "default": [],
    "description": "Optional list of custom plugin overrides. Each item defines a plugin type and its path."
  }
}
