# stenc configuration script
# Generated by gonja Jinja2 engine

# Generate a 256-bit key file if key file does not exist
{% if not key_file or key_file == "" %}
# Key file path not specified, using default
{% set key_file = "/etc/stenc/tape.key" %}
{% endif %}

# Ensure key directory exists
mkdir -p "{{ key_file | dirname }}"

# Generate key with specified bit length
stenc -g {{ key_length }} -k "{{ key_file }}" {{ key_descriptor | default('') }}

# Set permissions for key file
chmod 600 "{{ key_file }}"

# Configure encryption on the specified tape device
{% if encryption_mode != "off" %}
# Enable encryption on device {{ tape_device }} with mode {{ encryption_mode }}
stenc -f "{{ tape_device }}" -e {{ encryption_mode }} -k "{{ key_file }}" {{ algorithm_index | default('') }} {{ ckod | yesno('--ckod', '', true) }} {{ protect | yesno('--protect', '--unprotect', true) }}
{% else %}
# Disable encryption on device {{ tape_device }}
stenc -f "{{ tape_device }}" -e off
{% endif %}

# Verify encryption status
echo "Verifying encryption status for {{ tape_device }}..."
stenc -f "{{ tape_device }}" --detail
