# ==============================================================================
# micro_httpd Configuration Template
# ==============================================================================
# This template configures the micro_httpd web server.
# It is self-documenting: every setting is preceded by a comment explaining
# its purpose and default value, derived from the service schema.
# ==============================================================================

# Listen address: IP address the server binds to (e.g., 127.0.0.1 for localhost-only, 0.0.0.0 for all interfaces).
# Default: '0.0.0.0'
# Listen port: TCP port to listen on.
# Default: 8080
bind = {{ (listen_address | default('0.0.0.0')) }}:{{ (listen_port | default(8080)) }}

# Maximum number of simultaneous client connections allowed.
# Default: 100
max_connections = {{ (max_connections | default(100)) }}

# Absolute path to the directory served as the web root.
# Default: '/var/www/html'
document_root = {{ (document_root | default('/var/www/html')) }}

# If true, automatically generate directory indexes when no index file is found.
# Default: False
allow_directory_listing = {{ (directory_listing | default(False) | lower) }}

# If true, enable HTTPS using the configured certificate and key.
# Default: False
ssl_enabled = {{ (ssl_enabled | default(False) | lower) }}

{% if (ssl_enabled | default(False)) %}
# ==============================================================================
# SSL/TLS Settings
# ==============================================================================

# Path to the SSL/TLS certificate file (only used if SSL is enabled).
# Default: '/etc/ssl/micro-httpd.crt'
ssl_cert = {{ (ssl_cert_path | default('/etc/ssl/micro-httpd.crt')) }}

# Path to the SSL/TLS private key file (only used if SSL is enabled).
# Default: '/etc/ssl/micro-httpd.key'
ssl_key = {{ (ssl_key_path | default('/etc/ssl/micro-httpd.key')) }}
{% endif %}

# Ordered list of filenames to look for as default index files in a directory.
# Default: ['index.html', 'index.htm']
index_files = {{ ((index_files | default(['index.html', 'index.htm'])) | join(', ')) }}

# Custom MIME type mappings (extension → MIME type).
# Leave empty to use built-in defaults.
# If the variable is provided as a dictionary, each key-value pair becomes a mapping line.
{% set _mime_types = (mime_types | default([])) %}
{% if _mime_types is mapping and (_mime_types | length) > 0 %}
mime_types =
{% for _key, _value in _mime_types | dict2items %}
  {{ _key.key }} = {{ _key.value }}
{% endfor %}
{% elif _mime_types is iterable and (_mime_types | length) > 0 %}
mime_types = {{ _mime_types | tojson }}
{% else %}
mime_types =
{% endif %}

# Path to the access log file.
# Set to empty string '' to disable logging.
# Default: '/var/log/micro-httpd/access.log'
log_file = {{ (log_file | default('/var/log/micro-httpd/access.log')) }}

# System user to drop privileges to after binding to port.
# Use empty string '' to run as root (not recommended).
# Default: 'www-data'
run_as = {{ (run_as_user | default('www-data')) }}

# Maximum seconds to wait for a client request before closing the connection.
# Default: 30
timeout = {{ (timeout_seconds | default(30)) }}