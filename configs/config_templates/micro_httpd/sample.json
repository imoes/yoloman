{
  "listen_address": "0.0.0.0",
  "listen_port": 80,
  "max_connections": 64,
  "document_root": "/srv/http",
  "directory_listing": true,
  "ssl_enabled": false,
  "ssl_cert_path": "",
  "ssl_key_path": "",
  "index_files": [
    "index.html",
    "index.htm"
  ],
  "mime_types": [
    {
      "ext": "html",
      "mimetype": "text/html"
    },
    {
      "ext": "css",
      "mimetype": "text/css"
    },
    {
      "ext": "js",
      "mimetype": "application/javascript"
    },
    {
      "ext": "json",
      "mimetype": "application/json"
    }
  ],
  "log_file": "/var/log/micro-httpd/access.log",
  "run_as_user": "nobody",
  "timeout_seconds": 20
}
