# Globus Gram Audit Configuration
# This file configures the audit logging backend for Globus Grid Resource Access Manager (GRAM).
# It specifies how audit records are stored, typically in a SQLite database.

# The database driver type used by Globus Gram Audit.
# Supported values vary by Globus installation, but 'SQLite' is standard for local audit storage.
# See schema: DRIVER (default='SQLite')
DRIVER:{{ DRIVER | default('SQLite') }}

# Database connection string / path.
# For SQLite drivers, this is the file path to the database file.
# For other drivers (if supported in specific Globus versions), this might contain a DSN or connection URI.
# Default: /var/lib/globus/gram-audit-database
# Ensure the directory /var/lib/globus/ exists and is writable by the globus user.
DATABASE:dbname={{ DATABASE_PATH | default('/var/lib/globus/gram-audit-database') }}

# The username for database authentication (if required).
# If using SQLite, this is often unused or empty, but included for schema completeness.
# See schema: USERNAME (default='')
USERNAME:{{ USERNAME | default('') }}

# The password for database authentication (if required).
# If using SQLite, this is often unused or empty, but included for schema completeness.
# See schema: PASSWORD (default='')
PASSWORD:{{ PASSWORD | default('') }}

# The version identifier for the audit configuration.
# This ensures compatibility between the audit schema and the application logic.
# Default: 1TG
AUDITVERSION:{{ AUDITVERSION | default('1TG') }}
