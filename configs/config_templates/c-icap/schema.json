{
  "c_icap_pid_file": {
    "type": "string",
    "default": "c-icap.pid",
    "description": "PID file name under /var/run/c-icap/"
  },
  "c_icap_commands_socket": {
    "type": "string",
    "default": "c-icap.ctl",
    "description": "Commands socket name under /var/run/c-icap/"
  },
  "c_icap_timeout": {
    "type": "number",
    "default": 300,
    "description": "Connection timeout in seconds"
  },
  "c_icap_max_keepalive_requests": {
    "type": "number",
    "default": 100,
    "description": "Maximum number of requests per keep-alive connection"
  },
  "c_icap_keepalive_timeout": {
    "type": "number",
    "default": 600,
    "description": "Keep-alive timeout in seconds"
  },
  "c_icap_start_servers": {
    "type": "number",
    "default": 3,
    "description": "Initial number of server processes"
  },
  "c_icap_max_servers": {
    "type": "number",
    "default": 10,
    "description": "Maximum allowed number of server processes"
  },
  "c_icap_min_spare_threads": {
    "type": "number",
    "default": 10,
    "description": "Minimum number of spare threads to keep"
  },
  "c_icap_max_spare_threads": {
    "type": "number",
    "default": 20,
    "description": "Maximum number of spare threads to keep"
  },
  "c_icap_threads_per_child": {
    "type": "number",
    "default": 10,
    "description": "Number of threads per child process"
  },
  "c_icap_max_requests_per_child": {
    "type": "number",
    "default": 0,
    "description": "Maximum requests per child process (0 = unlimited)"
  },
  "c_icap_interprocess_shared_mem_scheme": {
    "type": "string",
    "default": "posix",
    "description": "Interprocess shared memory scheme: posix | mmap | sysv",
    "enum": [
      "posix",
      "mmap",
      "sysv"
    ]
  },
  "c_icap_interprocess_locking_scheme": {
    "type": "string",
    "default": "file",
    "description": "Interprocess locking scheme: file | sysv | posix",
    "enum": [
      "file",
      "sysv",
      "posix"
    ]
  },
  "c_icap_port": {
    "type": "string",
    "default": "1344",
    "description": "Port to listen on (optionally with address)"
  },
  "c_icap_user": {
    "type": "string",
    "default": "c-icap",
    "description": "User to run c-icap processes as"
  },
  "c_icap_group": {
    "type": "string",
    "default": "c-icap",
    "description": "Group to run c-icap processes as"
  },
  "c_icap_server_admin": {
    "type": "string",
    "default": "you@your.address",
    "description": "Administrator email address"
  },
  "c_icap_server_name": {
    "type": "string",
    "default": "YourServerName",
    "description": "Server name for logs and info"
  },
  "c_icap_tmp_dir": {
    "type": "string",
    "default": "/tmp",
    "description": "Directory for temporary files"
  },
  "c_icap_max_mem_object": {
    "type": "number",
    "default": 131072,
    "description": "Maximum object size kept in memory (in bytes)"
  },
  "c_icap_debug_level": {
    "type": "number",
    "default": 1,
    "description": "Debug log level (0-10)"
  },
  "c_icap_pipelining": {
    "type": "string",
    "default": "on",
    "description": "Enable pipelining: on | off",
    "enum": [
      "on",
      "off"
    ]
  },
  "c_icap_support_buggy_clients": {
    "type": "string",
    "default": "off",
    "description": "Support buggy clients: on | off",
    "enum": [
      "on",
      "off"
    ]
  },
  "c_icap_fake_allow_204": {
    "type": "string",
    "default": "on",
    "description": "Fake 204 support: on | off",
    "enum": [
      "on",
      "off"
    ]
  },
  "c_icap_modules_dir": {
    "type": "string",
    "default": "/usr/lib/x86_64-linux-gnu/c_icap",
    "description": "Directory for c-icap modules"
  },
  "c_icap_services_dir": {
    "type": "string",
    "default": "/usr/lib/x86_64-linux-gnu/c_icap",
    "description": "Directory for c-icap services"
  },
  "c_icap_template_dir": {
    "type": "string",
    "default": "/usr/share/c_icap/templates/",
    "description": "Directory for templates"
  }
}
