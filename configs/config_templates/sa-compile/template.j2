# Rule2XSBody plugin configuration for Mail::SpamAssassin.
# This plugin compiles the SpamAssassin ruleset to native XS (C) code for
# significant performance improvements. It replaces the slow Perl interpreter
# for rule evaluation with optimized C routines.
#
# Schema field: sa_compile (description: Enable/disable the Rule2XSBody plugin)
loadplugin Mail::SpamAssassin::Plugin::Rule2XSBody