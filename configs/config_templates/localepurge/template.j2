// Localepurge configuration for DPkg
// This file is used by dpkg as a hook to automatically remove unneeded locale files
// after each package installation or upgrade, helping to conserve disk space.

DPkg {
    // Command executed post-invoke by dpkg to run localepurge if needed.
    // Default behavior checks if the command is executable and if the parent process
    // is actually involved in a remove or purge operation to avoid unnecessary runs.
    Post-Invoke {"{{ post_invoke_cmd | default('if [ -x /usr/sbin/localepurge ] && [ $(ps w -p $PPID | grep -E -c \x27(remove|purge)\x27) != 1 ]; then /usr/sbin/localepurge; else exit 0; fi') }}";};
};
