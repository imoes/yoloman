{
  "output_path": "/var/tmp/care-output.bin",
  "concealed_paths": [],
  "revealed_paths": [],
  "volatile_paths": [
    "/dev",
    "/proc",
    "/sys",
    "/run/shm"
  ],
  "volatile_env": [
    "DISPLAY",
    "http_proxy",
    "DBUS_SESSION_BUS_ADDRESS"
  ],
  "max_archivable_size_mb": 512,
  "verbose": 2,
  "ignore_default_config": false
}
