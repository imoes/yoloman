[Globals]
; Path to the lockfile used to ensure only one sesman instance runs
; This should be the same as in systemd unit or startup scripts
LockFilePath = {{ paths.lock_file }}

; Path to session directory where session data and logs are stored
SessionDir = {{ paths.session_dir }}

; Maximum number of concurrent user sessions per user (0 = no limit)
MaxSessions = {{ limits.max_sessions_per_user }}

; Time (in seconds) to wait before killing a session that has been idle too long
IdleTime = {{ limits.idle_timeout }}

; Security: enable secure mode (requires valid certificate for VNC or RDP)
SecureMode = {{ security.secure_mode }}

; Security: check if home directory exists and is accessible before launching session
CheckHomeDirConfig = {{ security.check_home_dir }}

; Logging level: 0=none, 1=error, 2=warn, 3=info, 4=debug, 5=trace
LogLevel = {{ logging.log_level }}

; Log file path (use 'SysLog' to log to system logger)
LogFile = {{ logging.log_file }}

[Security]
; Allow root login? (not recommended for production)
AllowRootLogin = {{ security.allow_root_login }}

; Minimum UID allowed to login (e.g., to exclude system accounts)
MinUID = {{ security.min_uid }}

; Maximum login attempts before temporary lockout (0 = disabled)
LoginAttemptMax = {{ security.login_attempt_max }}

; Lockout duration in seconds after max attempts exceeded (0 = no lockout)
LoginAttemptLockTime = {{ security.login_attempt_lock_time }}

[Logging]
; Enable session logging
EnableSyslog = {{ logging.enable_syslog }}

; Syslog facility to use (e.g., 'daemon', 'local0')
SyslogLevel = {{ logging.syslog_level }}

; Enable detailed logging for X11rdp backend (for debugging)
DebugEnableX11rdp = {{ logging.debug_enable_x11rdp }}

[Chansrv]
; Enable channel server (needed for clipboard, drive redirection, etc.)
EnableChansrv = {{ chansrv.enable }}

; Path to chansrv log file (leave blank to use main log file)
ChansrvLog = {{ chansrv.log_file }}

; Enable logging of channel activity
ChansrvLogEnable = {{ chansrv.enable_log }}

; Max number of simultaneous channels per session
ChansrvMaxChannels = {{ chansrv.max_channels }}

; Redirect sound (PulseAudio) to client
SoundRedirect = {{ chansrv.sound_redirect }}

[Sessions]
; Default shell/command to run when user logs in (e.g., /bin/bash, startxfce4)
DefaultWindowManager = {{ sessions.default_wm }}

; X11 display offset for user sessions (e.g., 5900 -> :0 at 5900)
DisplayBase = {{ sessions.display_base }}

; Enable session resizing support (for RDP clients)
EnableResize = {{ sessions.enable_resize }}

; Maximum desktop width/height (0 = no limit)
MaxWidth = {{ sessions.max_width }}
MaxHeight = {{ sessions.max_height }}

; Reuse existing sessions instead of creating new ones
ReuseSessions = {{ sessions.reuse_sessions }}

; Time (in seconds) to wait before auto-terminating idle sessions (0 = disable)
IdleSessionTime = {{ sessions.idle_session_timeout }}

; Time (in seconds) to wait before terminating sessions after logout (0 = disable)
KillDisconnected = {{ sessions.kill_disconnected_timeout }}

; Whether to terminate all user sessions when they disconnect
Policy = {{ sessions.policy }}

; Allowed session types (comma-separated list: Xvnc, X11rdp, Xorg)
Type = {{ sessions.types }}

; Maximum wait time for a session to start (in seconds)
WaitTime = {{ sessions.wait_time }}

; Default session type for new connections (must be in Type list)
DefaultType = {{ sessions.default_type }}

{% for session in sessions.custom_sessions %}; Custom session type: {{ session.name }}
[{{ session.name }}]
; Command to launch this session type
Command = {{ session.command }}

; Order in which session types appear in login screen (lower = higher priority)
Order = {{ session.order }}

; Show this session type in login menu?
Enable = {{ session.enabled }}
{% endfor %}

[Polkit]
; Enable PolicyKit-based privilege management for session control
EnablePolkit = {{ polkit.enable }}
