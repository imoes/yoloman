{
  "paths.lock_file": "/var/run/xrdp-sesman.pid",
  "paths.session_dir": "/var/run/xrdp",
  "limits.max_sessions_per_user": 2,
  "limits.idle_timeout": 1800,
  "security.secure_mode": true,
  "security.check_home_dir": true,
  "logging.log_level": 3,
  "logging.log_file": "/var/log/xrdp-sesman.log",
  "security.allow_root_login": false,
  "security.min_uid": 1000,
  "security.login_attempt_max": 5,
  "security.login_attempt_lock_time": 300,
  "logging.enable_syslog": false,
  "logging.syslog_level": "info",
  "logging.debug_enable_x11rdp": false,
  "chansrv.enable": true,
  "chansrv.log_file": "",
  "chansrv.enable_log": false,
  "chansrv.max_channels": 16,
  "chansrv.sound_redirect": true,
  "sessions.default_wm": "/usr/bin/startxfce4",
  "sessions.display_base": 5900,
  "sessions.enable_resize": true,
  "sessions.max_width": 0,
  "sessions.max_height": 0,
  "sessions.reuse_sessions": true,
  "sessions.idle_session_timeout": 0,
  "sessions.kill_disconnected_timeout": 60,
  "sessions.policy": "Disconnect",
  "sessions.types": [
    "Xvnc",
    "X11rdp",
    "Xorg"
  ],
  "sessions.wait_time": 15,
  "sessions.default_type": "Xvnc",
  "sessions.custom_sessions": [
    {
      "name": "CustomGNOME",
      "command": "/usr/bin/gnome-session",
      "order": 50,
      "enabled": true
    }
  ],
  "polkit.enable": true
}
