{
  "logfacility": "daemon",
  "logfile": "/var/log/ha-log",
  "keepalive": 2,
  "deadtime": 10,
  "warntime": 5,
  "initdead": 12,
  "interfaces": [
    "eth0",
    "eth1"
  ],
  "nodes": [
    "node1.example.com",
    "node2.example.com"
  ],
  "auto_failback": true,
  "authkey": "/etc/ha.d/authkey",
  "respawn": "/usr/lib/heartbeat/ipfail"
}
