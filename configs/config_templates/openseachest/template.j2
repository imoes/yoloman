# openSeaChest Configuration
# Binary path for openSeaChest_Basics
# Specifies the device node to target by default
# Output format for diagnostic tools (json, text)
# Enable verbose logging for troubleshooting
# Log file path for persistent diagnostics
# Path to the openSeaChest library directory
# Enable auto-update checks for firmware information
# Timeout in seconds for device communication
# Enable color output for terminal readability
BinaryPath: {{ binary_path | default('/usr/bin/openSeaChest_Basics') }}
TargetDevice: {{ target_device | default('/dev/sda') }}
OutputFormat: {{ output_format | default('json') }}
VerboseLogging: {{ verbose_logging | default(False) | lower }}
LogPath: {{ log_path | default('/var/log/openseachest/diagnostics.log') }}
LibPath: {{ lib_path | default('/usr/lib/opensea') }}
CheckUpdates: {{ check_updates | default(False) | lower }}
Timeout: {{ timeout | default(30) }}
ColorOutput: {{ color_output | default(True) | lower }}