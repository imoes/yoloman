# ============================================================================
# OsmoMSC Configuration Template
# ============================================================================
# This template generates the main configuration file for the OsmoMSC (Mobile
# Switching Center) daemon. It controls network identity, encryption settings,
# and connectivity to the Media Gateway (osmo-mgw).

# --- Network Identity Section ---
# Defines the Mobile Network Code (MNC) and Mobile Country Code (MCC) which
# uniquely identify the cellular network. Also sets the short and long names
# broadcast to mobile devices during network selection.
network
    # Mobile Country Code (MCC) for the network.
    # See https://en.wikipedia.org/wiki/Mobile_country_code for 'network country
    # code' (MCC) and 'mobile network code' (MNC)
    # MCC=1 and MNC=1 are for TEST network
    country code {{ network_country_code | default('1') }}

    # Mobile Network Code (MNC) for the network.
    mobile network code {{ mobile_network_code | default('1') }}

    # The short name of the network displayed on mobile devices.
    short name {{ network_short_name | default('OsmoMSC') }}

    # The long name of the network displayed on mobile devices.
    long name {{ network_long_name | default('OsmoMSC') }}

# --- Encryption Settings ---
# Configures the encryption algorithm used for voice/data transmission.
# A5/0 indicates no encryption (plaintext), while A5/1, A5/2, A5/3 are
# various encryption standards.
encryption a5 {{ encryption_a5 | default('0') }}

# --- MSC Connectivity Section ---
# Defines how the MSC connects to the Media Gateway (osmo-mgw).
# The osmo-mgw handles the actual media stream (voice) between the Base Station
# Controller (osmo-bsc) and the MSC.
msc
    # IP address of the remote Media Gateway (osmo-mgw).
    # Set this to the IP address which osmo-mgw is listening to:
    # (osmo-mgw provides the media gateway between osmo-bsc and osmo-msc)
    mgw remote-ip {{ mgw_remote_ip | default('127.0.0.1') }}
