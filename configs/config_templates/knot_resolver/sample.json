{
  "dnssec_enabled": true,
  "worker_count": 0,
  "listen_addrs": [
    {
      "address": "127.0.0.1",
      "port": 53
    },
    {
      "address": "192.168.1.1",
      "port": 53
    }
  ],
  "upstream_servers": [
    "9.9.9.9",
    "2001:4860:4860::8888"
  ],
  "cache_size_mb": 128,
  "cache_ttl_min": 60,
  "cache_ttl_max": 86400,
  "log_level": "notice",
  "root_hints_path": "/etc/knot-resolver/root.hints",
  "stub_zones": [
    {
      "domain": "internal.example.com",
      "forwarders": [
        "10.0.0.10",
        "10.0.0.11"
      ]
    }
  ],
  "policy_zones": [],
  "bind_interfaces": [],
  "ecs_enabled": true,
  "rate_limit_qps": 50,
  "rate_limit_window": 5
}
