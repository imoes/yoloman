# Configuration for cabextract: command-line options as a list of strings
# The 'options' field is a list of bare strings representing flags/arguments
# passed to the cabextract binary at runtime.
{% set opts = options | default([]) | list %}
{% if opts | length > 0 %}
CABEXTRACT_OPTS="{{ opts | join(' ') }}"
{% else %}
# No command-line options specified; cabextract runs with defaults.
CABEXTRACT_OPTS=""
{% endif %}