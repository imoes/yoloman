---
# Hiera ENC Configuration Template
# This file configures the Hiera External Node Classifier (ENC) backend settings.
# It defines which backends are used, where data files are stored, and the
# hierarchy order for variable lookup during Puppet agent catalog compilation.

# :backends: Specifies the list of Hiera backends to use for data lookup.
# The 'yaml' backend is the standard choice for file-based data storage.
:backends:
  - {{ backends_type | default('yaml') }}

# :yaml: Configuration section specific to the YAML backend.
# Controls where Hiera looks for the YAML data files (nodes, global hiera data, etc.).
:yaml:
  # :datadir: The directory path containing the Hiera data files.
  # Defaults to /etc/puppet/hiera-enc/nodes if not specified.
  :datadir: {{ datadir | default('/etc/puppet/hiera-enc/nodes') }}

# :hierarchy: Defines the ordered list of hierarchy levels for variable lookups.
# Hiera searches these levels in order; the first match wins.
:hierarchy:
  # 1. Node-specific data based on the Puppet certificate name (clientcert).
  #    This allows unique configuration per node identified by its certname.
  - "%{clientcert}"
  
  # 2. FQDN-based data.
  #    Matches the fully qualified domain name of the node.
  #    Useful for grouping nodes by domain or subdomain.
  - "%{fqdn}"
  
  # 3. Hostname-based data.
  #    Matches the short hostname of the node.
  #    Useful for legacy systems or non-FQDN environments.
  - "%{hostname}"
  
  # 4. Default fallback.
  #    The final catch-all level for global defaults.
  #    Wrapped in quotes to ensure it is treated as a string literal in the YAML output.
  - {{ default_hierarchy_name | default('"default"') }}
