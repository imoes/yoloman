{
  "general_colors": {
    "type": "string",
    "default": "true",
    "description": "Enable color output for status blocks."
  },
  "general_interval": {
    "type": "number",
    "default": 5,
    "description": "Refresh interval in seconds."
  },
  "general_output_format": {
    "type": "string",
    "default": "i3bar",
    "description": "Output format for the status bar.",
    "enum": [
      "i3bar",
      "dzen2",
      "xmobar",
      "lemonbar",
      "term",
      "none"
    ]
  },
  "general_color_good": {
    "type": "string",
    "default": "#79DB32",
    "description": "Color for 'good' status."
  },
  "general_color_degraded": {
    "type": "string",
    "default": "#E59728",
    "description": "Color for 'degraded' status."
  },
  "general_color_bad": {
    "type": "string",
    "default": "#DB3279",
    "description": "Color for 'bad' status."
  },
  "wireless_format_up": {
    "type": "string",
    "default": "W: (%quality at %essid) %ip",
    "description": "Format string for wireless interface when up."
  },
  "wireless_format_down": {
    "type": "string",
    "default": "W: down",
    "description": "Format string for wireless interface when down."
  },
  "ethernet_format_up": {
    "type": "string",
    "default": "E: %ip (%speed)",
    "description": "Format string for ethernet interface when up."
  },
  "ethernet_format_down": {
    "type": "string",
    "default": "E: down",
    "description": "Format string for ethernet interface when down."
  },
  "battery_format": {
    "type": "string",
    "default": "%status %percentage %remaining",
    "description": "Format string for battery status."
  },
  "disk_format": {
    "type": "string",
    "default": "%avail",
    "description": "Format string for disk usage."
  },
  "load_format": {
    "type": "string",
    "default": "%1min",
    "description": "Format string for system load."
  },
  "memory_format": {
    "type": "string",
    "default": "%used | %available",
    "description": "Format string for memory usage."
  },
  "memory_threshold_degraded": {
    "type": "string",
    "default": "1G",
    "description": "Threshold for memory degraded status."
  },
  "memory_format_degraded": {
    "type": "string",
    "default": "MEMORY < %available",
    "description": "Format string for memory degraded status."
  },
  "tztime_format": {
    "type": "string",
    "default": "%Y-%m-%d %H:%M:%S",
    "description": "Format string for time display."
  }
}
