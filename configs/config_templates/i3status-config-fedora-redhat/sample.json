{
  "general_colors": true,
  "general_interval": 5,
  "general_output_format": "i3bar",
  "general_color_good": "#79DB32",
  "general_color_degraded": "#E59728",
  "general_color_bad": "#DB3279",
  "wireless_format_up": "W: (%quality at %essid) %ip",
  "wireless_format_down": "W: down",
  "ethernet_format_up": "E: %ip (%speed)",
  "ethernet_format_down": "E: down",
  "battery_format": "%status %percentage %remaining",
  "disk_format": "%avail",
  "load_format": "%1min",
  "memory_format": "%used | %available",
  "memory_threshold_degraded": "1G",
  "memory_format_degraded": "MEMORY < %available",
  "tztime_format": "%Y-%m-%d %H:%M:%S"
}
