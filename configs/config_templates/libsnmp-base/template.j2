#
# SNMP configuration file for CUPS.
#
# This template configures the SNMP parameters for the CUPS printer daemon.
# It supports setting the address for SNMP traps/notifications and the
# community string used for SNMP read access.
#

{% raw %}Address {% endraw %}{{ snmp_address | default('@LOCAL') }}
{% raw %}Community {% endraw %}{{ snmp_community | default('public') }}