# =============================================================================
# overlayroot configuration file
# =============================================================================
# This file configures the overlayroot mechanism, which makes the root filesystem
# read-only by default, writing changes to a tmpfs, device, or encrypted volume.
#
# Schema:
#   - overlayroot_cfgdisk: References an external disk/filesystem containing an
#                          overlayroot.conf.
#   - overlayroot:         The main configuration directive (tmpfs, device, crypt,
#                          or disabled).
#
# Note: This file is managed by dpkg. For local customizations, use
# /etc/overlayroot.local.conf. Kernel command line parameters (overlayroot=...)
# will override values set here.
# =============================================================================

# --- External Configuration Disk ---
# If set, overlayroot checks this disk/filesystem for a local 'overlayroot.conf'.
# Examples: "LABEL=OROOTCFG" or "/dev/vdb"
# Security Warning: Ensure no unauthorized filesystems match this label/device,
# as code on them runs as root in initramfs.
#
# Schema field: overlayroot_cfgdisk
# Default: disabled
overlayroot_cfgdisk="{{ overlayroot_cfgdisk | default('disabled') }}"

# --- Main Overlayroot Setting ---
# Defines the backing storage for the overlay filesystem.
# Supported values:
#   - disabled: Turns off overlayroot (default).
#   - tmpfs: Writes changes to a RAM-backed filesystem.
#            Options: swap=1, recurse=0/1, debug=0/1, dir=/overlay, driver=auto
#   - device: Writes changes to a block device.
#            Options: dev=/dev/sdX, timeout=0
#   - crypt: Writes changes to an encrypted block device (dm-crypt).
#            Options: dev=/dev/sdX, mapname=secure, pass=<password>, fstype=ext4, mkfs=1, timeout=0
#
# Schema field: overlayroot
# Default: disabled
overlayroot="{{ overlayroot | default('disabled') }}"
