# Configuration file for clush (Cluster Shell)
# Please see man clush.conf(5)
#
# This template is self-documenting. Every setting includes its schema description as a comment.
# Variables are safe: they use 'default()' to ensure rendering even if the variable is undefined.

[Main]

# Maximum number of parallel connections to hosts.
fanout: {{ fanout | default('64') }}

# Connection timeout in seconds.
connect_timeout: {{ connect_timeout | default('15') }}

# Command execution timeout in seconds. 0 means no timeout.
command_timeout: {{ command_timeout | default('0') }}

# Color output mode: auto, always, or never.
color: {{ color | default('auto') }}

# Maximum number of file descriptors.
fd_max: {{ fd_max | default('8192') }}

# Number of commands stored in history.
history_size: {{ history_size | default('100') }}

# Whether to stop processing commands on non-zero exit code.
maxrc: {{ maxrc | default('no') }}

# Whether to display the number of nodes in results.
node_count: {{ node_count | default('yes') }}

# Verbosity level (0-4).
verbosity: {{ verbosity | default('1') }}

# List of directories to search for configuration files.
confdir: {{ confdir | default('/etc/clustershell/clush.conf.d $CFGDIR/clush.conf.d') }}

# Add always all remote hosts to known_hosts without confirmation
#ssh_user: root
#ssh_path: /usr/bin/ssh
#ssh_options: -oStrictHostKeyChecking=no
