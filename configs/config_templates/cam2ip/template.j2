# cam2ip configuration
# Auto-generated by Ansible from cam2ip schema.
# cam2ip is a simple utility that streams a V4L2 camera as an MJPEG HTTP server.
# See cam2ip(1) for full details.

# bind_address: Bind address. Default format in manpage is ':56000' which implies empty string for address part or just port. The flag is -bind-addr string.
# If left empty, cam2ip binds to all interfaces (0.0.0.0).
# Type: string
bind_address: {{ bind_address | default('') }}

# http_port: Port to bind to. Default 56000. Corresponds to -bind-addr port component.
# Type: integer
http_port: {{ http_port | default(56000) }}

# Authentication
# htpasswd_file: Path to htpasswd file. If empty, auth is disabled. Corresponds to -htpasswd-file.
# Type: string (file path)
{% if htpasswd_file | default('') != '' %}
htpasswd_file: {{ htpasswd_file | default('') }}
{% else %}
# htpasswd_file: Disabled (empty). Auth is off.
{% endif %}

# Video Input Settings
# video_index: Camera index. Corresponds to -index. Default 0.
# Type: integer
video_index: {{ video_index | default(0) }}

# video_width: Frame width. Corresponds to -width. Default 640.
# Type: integer
video_width: {{ video_width | default(640) }}

# video_height: Frame height. Corresponds to -height. Default 480.
# Type: integer
video_height: {{ video_height | default(480) }}

# delay_ms: Delay between frames in milliseconds. Corresponds to -delay. Default 10.
# Type: integer
delay_ms: {{ delay_ms | default(10) }}

# rotate_deg: Rotate image. Valid values: 90, 180, 270. Corresponds to -rotate. Default 0 (no rotation).
# Type: integer
rotate_deg: {{ rotate_deg | default(0) }}

# Output / Display Settings
# timestamp_enabled: Draw timestamp on images. Corresponds to -timestamp flag. Default false (flag is absent).
# Type: boolean
timestamp_enabled: {{ timestamp_enabled | default(False) }}

# Logging / Misc
# log_level: Log level. Not explicitly documented in flags, but standard fallback. Kept as a generic placeholder or removed if strictly adhering to flags.
# Type: string
log_level: {{ log_level | default('info') }}