# ==============================================================================
# Ylva Runtime Configuration Template
# ==============================================================================
# This template generates a shell script (or sourced environment fragment)
# for the Ylva password manager utility.
#
# Variables:
#   config: A dictionary of runtime options.
#     - color: (string) Enable/Disable terminal output colors.
#     - default_username: (string) Default username to use when creating new entries.
#     - gen_password_length: (integer) Length of passwords generated by --gen-password.
#     - show_latest_count: (integer) Number of latest entries to show by default.
#
# If 'config' is undefined or empty, sensible defaults are applied internally
# by Ylva, and no exports are written unless explicitly configured.
# ==============================================================================

{% set cfg = config | default({}, true) %}

# ------------------------------------------------------------------------------
# Terminal Output Colors
# ------------------------------------------------------------------------------
# Controls whether Ylva uses color-coded output in the terminal.
# Set to 'true', 'false', 'yes', 'no', or a specific color scheme string.
# Default: Ylva auto-detects based on terminal capabilities.
{% if cfg.color is defined and cfg.color is not none %}
export YLVA_COLOR="{{ cfg.color | string }}"
{% endif %}

# ------------------------------------------------------------------------------
# Default Username for New Entries
# ------------------------------------------------------------------------------
# Specifies the default username to pre-fill when creating a new entry.
# If omitted, Ylva will prompt the user for a username.
{% if cfg.default_username is defined and cfg.default_username is not none %}
export YLVA_DEFAULT_USERNAME="{{ cfg.default_username | string }}"
{% endif %}

# ------------------------------------------------------------------------------
# Password Generation Command
# ------------------------------------------------------------------------------
# Defines the command to generate a secure random password of a specified length.
# If omitted, Ylva will not define a default generation command.
{% if cfg.gen_password_length is defined and cfg.gen_password_length is not none %}
ylva --gen-password {{ cfg.gen_password_length | int }}
{% endif %}

# ------------------------------------------------------------------------------
# Show Latest Entries Command
# ------------------------------------------------------------------------------
# Defines the command to display the most recently added entries.
# The argument specifies how many entries to list.
# If omitted, Ylva will use its internal default count.
{% if cfg.show_latest_count is defined and cfg.show_latest_count is not none %}
ylva --show-latest {{ cfg.show_latest_count | int }}
{% endif %}

# ------------------------------------------------------------------------------
# Standard Operations
# ------------------------------------------------------------------------------
# These are standard operational commands included by default for convenience.
# They can be overridden by the user in their own environment if needed.

# Add a new password entry to the store.
ylva --add

# List all stored entries along with their passwords.
ylva --show-passwords -A