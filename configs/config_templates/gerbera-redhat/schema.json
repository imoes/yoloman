{
  "ui_enabled": {
    "type": "string",
    "default": "yes",
    "description": "Whether the UI is enabled"
  },
  "accounts_enabled": {
    "type": "string",
    "default": "no",
    "description": "Whether account login is enabled"
  },
  "accounts_session_timeout": {
    "type": "number",
    "default": 30,
    "description": "Session timeout in minutes"
  },
  "server_name": {
    "type": "string",
    "default": "Gerbera",
    "description": "Server display name"
  },
  "server_udn": {
    "type": "string",
    "default": "uuid:ac239fa6-6dfc-4e0e-965b-3af47ecfa263",
    "description": "Server UDN (Unique Device Name)"
  },
  "server_home": {
    "type": "string",
    "default": "/etc/gerbera",
    "description": "Server home directory"
  },
  "server_webroot": {
    "type": "string",
    "default": "/usr/share/gerbera/web",
    "description": "Web root directory"
  },
  "server_alive": {
    "type": "number",
    "default": 1800,
    "description": "SSDP alive advertisement interval in seconds"
  },
  "storage_sqlite3_enabled": {
    "type": "string",
    "default": "yes",
    "description": "Whether SQLite3 storage is enabled"
  },
  "storage_sqlite3_database_file": {
    "type": "string",
    "default": "gerbera.db",
    "description": "SQLite3 database file name"
  },
  "extended_runtime_mark_played_items_enabled": {
    "type": "string",
    "default": "no",
    "description": "Whether to mark played items"
  },
  "extended_runtime_mark_played_items_suppress_cds_updates": {
    "type": "string",
    "default": "yes",
    "description": "Whether to suppress CDS updates for marked items"
  },
  "extended_runtime_mark_played_items_string_mode": {
    "type": "string",
    "default": "*",
    "description": "String mode for marking played items"
  },
  "extended_runtime_mark_played_items_mark_content": {
    "type": "string",
    "default": "video",
    "description": "Content type to mark",
    "enum": [
      "video",
      "audio",
      "image",
      "playlist",
      "object"
    ]
  },
  "import_hidden_files": {
    "type": "string",
    "default": "no",
    "description": "Whether to import hidden files"
  },
  "import_scripting_script_charset": {
    "type": "string",
    "default": "UTF-8",
    "description": "Character set for scripting"
  },
  "import_scripting_common_script": {
    "type": "string",
    "default": "/usr/share/gerbera/js/common.js",
    "description": "Path to common JavaScript script"
  },
  "import_scripting_playlist_script": {
    "type": "string",
    "default": "/usr/share/gerbera/js/playlists.js",
    "description": "Path to playlist JavaScript script"
  },
  "import_scripting_virtual_layout_import_script": {
    "type": "string",
    "default": "/usr/share/gerbera/js/import.js",
    "description": "Path to import JavaScript script"
  },
  "import_mappings_extension_mimetype_ignore_unknown": {
    "type": "string",
    "default": "no",
    "description": "Whether to ignore unknown extensions for mimetype mapping"
  },
  "import_online_content_appletrailers_enabled": {
    "type": "string",
    "default": "no",
    "description": "Whether AppleTrailers online content is enabled"
  },
  "import_online_content_appletrailers_refresh": {
    "type": "number",
    "default": 43200,
    "description": "Refresh interval for AppleTrailers in seconds"
  },
  "import_online_content_appletrailers_update_at_start": {
    "type": "string",
    "default": "no",
    "description": "Whether to update at start for AppleTrailers"
  },
  "import_online_content_appletrailers_resolution": {
    "type": "number",
    "default": 640,
    "description": "Resolution for AppleTrailers"
  },
  "transcoding_enabled": {
    "type": "string",
    "default": "no",
    "description": "Whether transcoding is enabled"
  },
  "transcoding_profiles_oggflac2raw_enabled": {
    "type": "string",
    "default": "no",
    "description": "Whether oggflac2raw profile is enabled"
  },
  "transcoding_profiles_oggflac2raw_mimetype": {
    "type": "string",
    "default": "audio/L16",
    "description": "Mimetype for oggflac2raw profile"
  },
  "transcoding_profiles_oggflac2raw_accept_url": {
    "type": "string",
    "default": "no",
    "description": "Whether oggflac2raw accepts URLs"
  },
  "transcoding_profiles_oggflac2raw_first_resource": {
    "type": "string",
    "default": "yes",
    "description": "Whether oggflac2raw uses first resource"
  },
  "transcoding_profiles_oggflac2raw_accept_ogg_theora": {
    "type": "string",
    "default": "no",
    "description": "Whether oggflac2raw accepts Ogg Theora"
  },
  "transcoding_profiles_oggflac2raw_buffer_size": {
    "type": "number",
    "default": 1048576,
    "description": "Buffer size for oggflac2raw in bytes"
  },
  "transcoding_profiles_oggflac2raw_buffer_chunk_size": {
    "type": "number",
    "default": 131072,
    "description": "Chunk size for oggflac2raw in bytes"
  },
  "transcoding_profiles_oggflac2raw_buffer_fill_size": {
    "type": "number",
    "default": 262144,
    "description": "Fill size for oggflac2raw in bytes"
  },
  "transcoding_profiles_vlcmpeg_enabled": {
    "type": "string",
    "default": "no",
    "description": "Whether vlcmpeg profile is enabled"
  },
  "transcoding_profiles_vlcmpeg_mimetype": {
    "type": "string",
    "default": "video/mpeg",
    "description": "Mimetype for vlcmpeg profile"
  },
  "transcoding_profiles_vlcmpeg_accept_url": {
    "type": "string",
    "default": "yes",
    "description": "Whether vlcmpeg accepts URLs"
  },
  "transcoding_profiles_vlcmpeg_first_resource": {
    "type": "string",
    "default": "yes",
    "description": "Whether vlcmpeg uses first resource"
  },
  "transcoding_profiles_vlcmpeg_accept_ogg_theora": {
    "type": "string",
    "default": "yes",
    "description": "Whether vlcmpeg accepts Ogg Theora"
  },
  "transcoding_profiles_vlcmpeg_buffer_size": {
    "type": "number",
    "default": 14400000,
    "description": "Buffer size for vlcmpeg in bytes"
  },
  "transcoding_profiles_vlcmpeg_buffer_chunk_size": {
    "type": "number",
    "default": 512000,
    "description": "Chunk size for vlcmpeg in bytes"
  },
  "transcoding_profiles_vlcmpeg_buffer_fill_size": {
    "type": "number",
    "default": 120000,
    "description": "Fill size for vlcmpeg in bytes"
  }
}
