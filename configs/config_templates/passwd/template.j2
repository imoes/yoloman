# Default settings for password aging and complexity policies
# Minimum password length (in characters)
MIN_LENGTH = {{ min_length }}

# Maximum password length (in characters); 0 = no limit
MAX_LENGTH = {{ max_length }}

# Minimum number of digit characters required
MIN_DIGITS = {{ min_digits }}

# Minimum number of lowercase characters required
MIN_LOWER = {{ min_lower }}

# Minimum number of uppercase characters required
MIN_UPPER = {{ min_upper }}

# Minimum number of other (non-alphanumeric) characters required
MIN_OTHER = {{ min_other }}

# Maximum number of consecutive identical characters allowed
MAX_CONSECUTIVE = {{ max_consecutive }}

# Minimum number of different character classes required (e.g., upper, lower, digit, special)
MIN_CLASSES = {{ min_classes }}

# Password aging: minimum days between changes
MIN_DAYS = {{ min_days }}

# Password aging: maximum days before expiration
MAX_DAYS = {{ max_days }}

# Password aging: number of days warning before expiration
WARN_DAYS = {{ warn_days }}

# Password aging: number of days after expiration before account is disabled
INACTIVE_DAYS = {{ inactive_days }}

# Enforce password history: number of previous passwords to remember
OLD_PASSWORDS = {{ old_passwords }}

# Require all passwords to be validated against system dictionary
DICTIONARY_CHECK = {{ dictionary_check | lower }}

# Enable strict checking for non-root users
STRICT_NON_ROOT = {{ strict_non_root | lower }}

# List of disallowed words (comma-separated)
DISALLOW_WORDS = {{ disallow_words | join(', ') }}

# Enable PAM-based policy enforcement (on/off)
PAM_ENFORCE = {{ pam_enforce | lower }}
