{
  "min_length": 12,
  "max_length": 128,
  "min_digits": 2,
  "min_lower": 2,
  "min_upper": 2,
  "min_other": 1,
  "max_consecutive": 2,
  "min_classes": 4,
  "min_days": 1,
  "max_days": 90,
  "warn_days": 14,
  "inactive_days": 14,
  "old_passwords": 6,
  "dictionary_check": true,
  "strict_non_root": true,
  "disallow_words": [
    "admin",
    "root",
    "password",
    "user",
    "guest"
  ],
  "pam_enforce": true
}
