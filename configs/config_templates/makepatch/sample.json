{
  "automanifest": "Makefile.MANIFEST",
  "nomanifest": false,
  "manifest": "",
  "oldmanifest": "OLD_MANIFEST",
  "newmanifest": "NEW_MANIFEST",
  "recurse": true,
  "follow": false,
  "diff": "diff -u",
  "patchlevel": "VERSION.H",
  "description": [
    "Patch for version 1.7"
  ],
  "infocmd": "echo \"Patching file %oP to %nP\"",
  "exclude": [
    "*.o",
    "*.bak"
  ],
  "exclude_regex": [
    "\\.git/.*"
  ],
  "exclude_standard": false,
  "exclude_cvs": false,
  "exclude_rcs": false,
  "exclude_sccs": false,
  "ignore_cvs_keywords": false,
  "ignore_rcs_keywords": false,
  "extract": [
    "\\.rar=unrar x -o+"
  ],
  "ident": true,
  "verbose": false,
  "tmpdir": "/var/tmp/makepatch",
  "temp": "/var/tmp/makepatch"
}
