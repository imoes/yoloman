# =============================================================================
# Configuration for makepatch
# =============================================================================

# Default name for the manifest file to look for automatically.
automanifest = {{ automanifest | default('MANIFEST') }}

# Suppress using manifest files.
# If true, the nomanifest directive is emitted.
{% if nomanifest | default(False) %}
nomanifest
{% endif %}

# Name of the manifest file for both old and new source trees.
{% if manifest | default('') %}
manifest = {{ manifest | default('') }}
{% endif %}

# Name of the manifest file for the old source tree.
{% if oldmanifest | default('') %}
oldmanifest = {{ oldmanifest | default('') }}
{% endif %}

# Name of the manifest file for the new source tree.
{% if newmanifest | default('') %}
newmanifest = {{ newmanifest | default('') }}
{% endif %}

# Recurse through directories.
# If true, recurse is enabled; otherwise, norecurse is set.
{% if recurse | default(True) %}
recurse
{% else %}
norecurse
{% endif %}

# Follow symbolic links to directories.
# If true, follow is enabled; otherwise, nofollow is set.
{% if follow | default(False) %}
follow
{% else %}
nofollow
{% endif %}

# Command used to generate differences.
diff = {{ diff | default('diff -c') }}

# Alternate file used in lieu of patchlevel.h.
{% if patchlevel | default('') %}
patchlevel = {{ patchlevel | default('') }}
{% endif %}

# Descriptive text for this patch. Items are strings.
{% for desc in description | default([]) %}
description = {{ desc }}
{% endfor %}

# Command output added before each patch chunk.
# Uses %oP and %nP substitutions.
{% if infocmd | default('') %}
infocmd = {{ infocmd | default('') }}
{% endif %}

# Shell patterns for files to exclude.
# Items are strings representing shell glob patterns.
{% for pattern in exclude | default([]) %}
exclude = {{ pattern }}
{% endfor %}

# Perl regex patterns for files/directories to exclude.
# Items are strings representing regular expressions.
{% for pattern in exclude_regex | default([]) %}
exclude-regex = {{ pattern }}
{% endfor %}

# Exclude standard patterns like ~, .o, .orig, etc.
# If true, exclude-standard is set; otherwise, noexclude-standard.
{% if exclude_standard | default(True) %}
exclude-standard
{% else %}
noexclude-standard
{% endif %}

# Exclude CVS related files and directories.
# If true, exclude-cvs is set; otherwise, noexclude-cvs.
{% if exclude_cvs | default(True) %}
exclude-cvs
{% else %}
noexclude-cvs
{% endif %}

# Exclude RCS related files and directories.
# If true, exclude-rcs is set; otherwise, noexclude-rcs.
{% if exclude_rcs | default(True) %}
exclude-rcs
{% else %}
noexclude-rcs
{% endif %}

# Exclude SCCS related files and directories.
# If true, exclude-sccs is set; otherwise, noexclude-sccs.
{% if exclude_sccs | default(True) %}
exclude-sccs
{% else %}
noexclude-sccs
{% endif %}

# Ignore differences in CVS keyword data.
# If true, ignore-cvs-keywords is set; otherwise, noignore-cvs-keywords.
{% if ignore_cvs_keywords | default(False) %}
ignore-cvs-keywords
{% else %}
noignore-cvs-keywords
{% endif %}

# Ignore RCS related files and directories.
# If true, ignore-rcs-keywords is set; otherwise, noignore-rcs-keywords.
{% if ignore_rcs_keywords | default(False) %}
ignore-rcs-keywords
{% else %}
noignore-rcs-keywords
{% endif %}

# Additional extraction rules for archives in 'pattern=command' format.
# Items are strings.
{% for rule in extract | default([]) %}
extract = {{ rule }}
{% endfor %}

# Report program name and version.
# If true, ident is set; otherwise, noident.
{% if ident | default(False) %}
ident
{% else %}
noident
{% endif %}

# Display activity information to stderr.
# If true, verbose is set; otherwise, quiet.
{% if verbose | default(True) %}
verbose
{% else %}
quiet
{% endif %}

# Area where temporary files are placed.
{% if tmpdir | default('/tmp') %}
TMPDIR = {{ tmpdir | default('/tmp') }}
{% endif %}

# Alternative to TMPDIR.
{% if temp | default('') %}
TEMP = {{ temp | default('') }}
{% endif %}