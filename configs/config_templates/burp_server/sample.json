{
  "bindaddress": "0.0.0.0",
  "port": 4971,
  "storage_dir": "/var/lib/burp",
  "max_connections": 10,
  "allow_delete": false,
  "compression": true,
  "ca_crt": "/etc/burp/CA/cacert.pem",
  "server_crt": "/etc/burp/CA/burpserver.pem",
  "server_key": "/etc/burp/CA/burpserver_key.pem",
  "ca_crl": "/etc/burp/CA/crl.pem",
  "clients": [
    {
      "name": "workstation1",
      "cert_cn": "workstation1.example.com",
      "backup_dir": "clients/workstation1",
      "allowed_ips": [
        "192.168.1.10"
      ]
    },
    {
      "name": "server2",
      "cert_cn": "server2.example.com",
      "backup_dir": "servers/server2",
      "allowed_ips": [
        "10.0.0.2",
        "10.0.0.3"
      ]
    }
  ],
  "allow_clients": [],
  "log_file": "/var/log/burp/burp.log",
  "log_file_level": "1"
}
