{
  "auto_reconnect_delay": 3,
  "auto_rejoin_delay": 10,
  "beep_max": 1,
  "beep_when_away": 0,
  "channel_name_width": 16,
  "connect_timeout": 60,
  "cpu_saver_after": 10,
  "cpu_saver_every": 5,
  "dcc_sliding_window": 4,
  "dcc_store_path": "~",
  "dcc_timeout": 300,
  "display_pc_characters": 4,
  "high_bit_escape": 0,
  "history": 25,
  "lastlog": 512,
  "load_path": "~/.epic:~/.irc:/etc/epic4:/etc/epic4/lice:/usr/local/share/epic4/script:/usr/share/epic4/script:/usr/local/share/epic4/lice:/usr/share/epic4/lice:.",
  "logfile": "IRCLOG",
  "mail": 2,
  "max_recursions": 50,
  "nd_space_max": 80,
  "notify_interval": 90,
  "num_of_whowas": 1,
  "scrollback": 256,
