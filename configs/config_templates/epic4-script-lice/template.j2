# Epic4 LiCe Configuration Template
# This template configures the LiCe (LiCe Is Client for Epic) client settings.
# It is designed to be self-documenting, with every configuration directive
# annotated by its schema description.

# ==============================================================================
# Core Client Behavior & Connection Settings
# ==============================================================================

# Base directive identifying this as a LiCe configuration package.
PACKAGE LiCe

# Automatically split windows for large messages.
# Description: N/A (Fixed value)
SET ALWAYS_SPLIT_BIGGEST OFF

# Automatically assign a new nickname if the current one is taken.
# Description: N/A (Fixed value)
SET AUTO_NEWNICK ON

# Automatically attempt to reconnect to the server upon disconnection.
# Description: N/A (Fixed value)
SET AUTO_RECONNECT ON

# Seconds to wait before attempting to reconnect automatically.
# Default: 3
SET AUTO_RECONNECT_DELAY {{ auto_reconnect_delay | default('3') }}

# Automatically rejoin channels after a disconnect.
# Description: N/A (Fixed value)
SET AUTO_REJOIN ON

# Seconds to wait before automatically rejoining a channel after a disconnect.
# Default: 10
SET AUTO_REJOIN_DELAY {{ auto_rejoin_delay | default('10') }}

# Automatically unmark the user as "Away" when activity resumes.
# Description: N/A (Fixed value)
SET AUTO_UNMARK_AWAY OFF

# Automatically look up user info when they join/leave/part (WHOWAS).
# Description: N/A (Fixed value)
SET AUTO_WHOWAS OFF

# ==============================================================================
# Display & Interface Settings
# ==============================================================================

# Banner text to display.
# Description: N/A (Fixed value)
SET BANNER ##

# Expand banner macros.
# Description: N/A (Fixed value)
SET BANNER_EXPAND OFF

# Enable beeping on events.
# Description: N/A (Fixed value)
SET BEEP ON

# Maximum number of beeps to emit at once.
# Default: 1
SET BEEP_MAX {{ beep_max | default('1') }}

# Beep on messages.
# Description: N/A (Fixed value)
SET BEEP_ON_MSG NONE

# Controls beep behavior when away (0 = off, non-zero = on).
# Default: 0
SET BEEP_WHEN_AWAY {{ beep_when_away | default('0') }}

# Enable blinking video effects.
# Description: N/A (Fixed value)
SET BLINK_VIDEO OFF

# Enable bold video effects.
# Description: N/A (Fixed value)
SET BOLD_VIDEO ON

# Maximum width for channel names in the status bar.
# Default: 16
SET CHANNEL_NAME_WIDTH {{ channel_name_width | default('16') }}

# Clock display status.
# Description: N/A (Fixed value)
SET CLOCK ON

# Display clock in 24-hour format.
# Description: N/A (Fixed value)
SET CLOCK_24HOUR OFF

# Clock format string (empty to use default).
# Description: N/A (Fixed value)
SET -CLOCK_FORMAT

# Enable color support.
# Description: N/A (Fixed value)
SET COLOR ON

# Enable command mode.
# Description: N/A (Fixed value)
SET COMMAND_MODE OFF

# Enable comment hacks.
# Description: N/A (Fixed value)
SET COMMENT_HACK ON

# Timeout in seconds for connecting to a server.
# Default: 60
SET CONNECT_TIMEOUT {{ connect_timeout | default('60') }}

# Continued line handling.
# Description: N/A (Fixed value)
SET CONTINUED_LINE

# CPU saver activation settings.
# Number of seconds of inactivity before CPU saver is enabled.
# Default: 10
SET CPU_SAVER_AFTER {{ cpu_saver_after | default('10') }}

# Frequency in seconds for CPU saver checks.
# Default: 5
SET CPU_SAVER_EVERY {{ cpu_saver_every | default('5') }}

# Window level display.
# Description: N/A (Fixed value)
SET CURRENT_WINDOW_LEVEL ALL

# DCC settings: Long pathnames.
# Description: N/A (Fixed value)
SET DCC_LONG_PATHNAMES OFF

# Number of DCC connections to maintain in sliding window.
# Default: 4
SET DCC_SLIDING_WINDOW {{ dcc_sliding_window | default('4') }}

# Directory to store incoming DCC files.
# Default: ~
SET DCC_STORE_PATH {{ dcc_store_path | default('~') }}

# Timeout in seconds for DCC transfers.
# Default: 300
SET DCC_TIMEOUT {{ dcc_timeout | default('300') }}

# Dispatch unknown commands.
# Description: N/A (Fixed value)
SET DISPATCH_UNKNOWN_COMMANDS OFF

# Display status.
# Description: N/A (Fixed value)
SET DISPLAY ON

# Display ANSI codes.
# Description: N/A (Fixed value)
SET DISPLAY_ANSI ON

# Number of PC character columns to display (for 8-bit chars).
# Default: 4
SET DISPLAY_PC_CHARACTERS {{ display_pc_characters | default('4') }}

# Do not notify immediately.
# Description: N/A (Fixed value)
SET DO_NOTIFY_IMMEDIATELY OFF

# Eight-bit character support.
# Description: N/A (Fixed value)
SET EIGHT_BIT_CHARACTERS ON

# Floating point math.
# Description: N/A (Fixed value)
SET FLOATING_POINT_MATH OFF

# Flood control after count.
# Description: N/A (Fixed value)
SET FLOOD_AFTER 5

# Flood control rate.
# Description: N/A (Fixed value)
SET FLOOD_RATE 3

# Flood control users.
# Description: N/A (Fixed value)
SET FLOOD_USERS 10

# Flood warning.
# Description: N/A (Fixed value)
SET FLOOD_WARNING OFF

# Full status line.
# Description: N/A (Fixed value)
SET FULL_STATUS_LINE ON

# Help pager.
# Description: N/A (Fixed value)
SET HELP_PAGER ON

# Help path.
# Description: N/A (Fixed value)
SET HELP_PATH /usr/share/epic4/lice/help

# Help prompt.
# Description: N/A (Fixed value)
SET HELP_PROMPT ON

# Help window.
# Description: N/A (Fixed value)
SET HELP_WINDOW OFF

# Hide private channels.
# Description: N/A (Fixed value)
SET HIDE_PRIVATE_CHANNELS OFF

# Highlight character style.
# Description: N/A (Fixed value)
SET HIGHLIGHT_CHAR BOLD

# Escape method for high-bit characters (0 = none).
# Default: 0
SET HIGH_BIT_ESCAPE {{ high_bit_escape | default('0') }}

# Maximum number of lines stored in command history.
# Default: 25
SET HISTORY {{ history | default('25') }}

# Hold mode.
# Description: N/A (Fixed value)
SET HOLD_MODE OFF

# Indentation.
# Description: N/A (Fixed value)
SET INDENT ON

# Input prompt style.
# Description: N/A (Fixed value)
SET -INPUT_PROMPT

# Insert mode.
# Description: N/A (Fixed value)
SET INSERT_MODE ON

# Inverse video.
# Description: N/A (Fixed value)
SET INVERSE_VIDEO ON

# Number of lines kept in lastlog buffer.
# Default: 512
SET LASTLOG {{ lastlog | default('512') }}

# Lastlog level.
# Description: N/A (Fixed value)
SET LASTLOG_LEVEL DCC,ALL

# Search path for script/theme files.
# Default: ~/.epic:~/.irc:/etc/epic4:/etc/epic4/lice:/usr/local/share/epic4/script:/usr/share/epic4/script:/usr/local/share/epic4/lice:/usr/share/epic4/lice:.
SET LOAD_PATH {{ load_path | default('~/.epic:~/.irc:/etc/epic4:/etc/epic4/lice:/usr/local/share/epic4/script:/usr/share/epic4/script:/usr/local/share/epic4/lice:/usr/share/epic4/lice:.') }}

# Logging status.
# Description: N/A (Fixed value)
SET LOG OFF

# Default filename for logging.
# Default: IRCLOG
SET LOGFILE {{ logfile | default('IRCLOG') }}

# Mail check interval (in minutes).
# Default: 2
SET MAIL {{ mail | default('2') }}

# Mangle inbound text.
# Description: N/A (Fixed value)
SET MANGLE_INBOUND

# Mangle logfiles options.
# Description: N/A (Fixed value)
SET MANGLE_LOGFILES ANSI,COLOR,REVERSE,UNDERLINE,BOLD,BLINK

# Mangle outbound text.
# Description: N/A (Fixed value)
SET MANGLE_OUTBOUND

# Max reconnects.
# Description: N/A (Fixed value)
SET MAX_RECONNECTs 0

# Maximum recursion depth for scripts.
# Default: 50
SET MAX_RECURSIONS {{ max_recursions | default('50') }}

# Meta states.
# Description: N/A (Fixed value)
#SET META_STATES

# MIRC broken resume.
# Description: N/A (Fixed value)
SET MIRC_BROKEN_RESUME ON

# Mode stripper.
# Description: N/A (Fixed value)
SET MODE_STRIPPER ON

# Maximum number of spaces for ND (non-digit) formatting.
# Default: 80
SET ND_SPACE_MAX {{ nd_space_max | default('80') }}

# Notify handler.
# Description: N/A (Fixed value)
SET NOTIFY_HANDLER NOISY

# Seconds between notify list updates.
# Default: 90
SET NOTIFY_INTERVAL {{ notify_interval | default('90') }}

# Notify on termination.
# Description: N/A (Fixed value)
SET NOTIFY_ON_TERMINATION OFF

# Notify userhost automatic.
# Description: N/A (Fixed value)
SET NOTIFY_USERHOST_AUTOMATIC ON

# No control log.
# Description: N/A (Fixed value)
SET NO_CONTROL_LOG OFF

# No CTCP flood.
# Description: N/A (Fixed value)
SET NO_CTCP_FLOOD ON

# No fail disconnect.
# Description: N/A (Fixed value)
SET NO_FAIL_DISCONNECT OFF

# Number of recent users to keep in WHOWAS cache.
# Default: 1
SET NUM_OF_WHOWAS {{ num_of_whowas | default('1') }}

# Pad character.
# Description: N/A (Fixed value)
#SET PAD_CHAR .

# Quit message format.
# Description: N/A (Fixed value)
SET QUIT_MESSAGE ircII %s -- Accept no limitations

# Script block to set realname from environment variable IRCNAME.
# If IRCNAME is empty or length 0, defaults to 'http://lice.codehack.com'.
DO {
  @ :realname = getenv(IRCNAME)
  SET REALNAME ${strlen($realname)?realname:[http\://lice.codehack.com]}
}

# Reverse status line.
# Description: N/A (Fixed value)
SET REVERSE_STATUS_LINE ON

# Screen options.
# Description: N/A (Fixed value)
SET -SCREEN_OPTIONS

# Number of scrollback lines to keep.
# Default: 256
SET SCROLLBACK {{ scrollback | default('256') }}

# Scrollback buffer ratio for auto-scrolling (%).
# Default: 50
SET SCROLLBACK_RATIO {{ scrollback_ratio | default('50') }}

# Number of lines to scroll per scroll event.
# Default: 1
SET SCROLL_LINES {{ scroll_lines | default('1') }}

# Security level (0 = minimal restrictions).
# Default: 0
SET SECURITY {{ security | default('0') }}

# Default shell for command execution.
# Default: /bin/sh
SET SHELL {{ shell | default('/bin/sh') }}

# Flags passed to the shell for command execution.
# Default: -c
SET SHELL_FLAGS {{ shell_flags | default('-c') }}

# Shell limit.
# Description: N/A (Fixed value)
SET SHELL_LIMIT 0

# Show channel names.
# Description: N/A (Fixed value)
SET SHOW_CHANNEL_NAMES ON

# Show end of messages.
# Description: N/A (Fixed value)
SET SHOW_END_OF_MSGS ON

# Show numerics.
# Description: N/A (Fixed value)
SET SHOW_NUMERICS OFF

# Show status all.
# Description: N/A (Fixed value)
SET SHOW_STATUS_ALL OFF

# Show who hopcount.
# Description: N/A (Fixed value)
SET SHOW_WHO_HOPCOUNT OFF

# Status user settings (most moved to themes/default).
# Description: N/A (Fixed value)
SET -STATUS_USER

# Status User 1.
# Description: N/A (Fixed value)
SET STATUS_USER1 0

# Status User 2.
# Description: N/A (Fixed value)
SET STATUS_USER2 ??

# Status User 3.
# Description: N/A (Fixed value)
SET STATUS_USER3 Idle: ?

# Status User 4.
# Description: N/A (Fixed value)
SET -STATUS_USER4

# Suppress from remote server.
# Description: N/A (Fixed value)
SET SUPPRESS_FROM_REMOTE_SERVER ON

# Suppress server MOTD.
# Description: N/A (Fixed value)
SET SUPPRESS_SERVER_MOTD ON

# Tab key behavior.
# Description: N/A (Fixed value)
SET TAB ON

# Tab max.
# Description: N/A (Fixed value)
SET TAB_MAX 8

# Underline video.
# Description: N/A (Fixed value)
SET UNDERLINE_VIDEO ON

# User information string.
# Description: N/A (Fixed value)
SET USER_INFORMATION LiCe - http://lice.codehack.com

# Verbose CTCP.
# Description: N/A (Fixed value)
SET VERBOSE_CTCP OFF

# Word break.
# Description: N/A (Fixed value)
#SET WORD_BREAK

# XTERM settings.
# Description: N/A (Fixed value)
SET -XTERM

# XTERM options.
# Description: N/A (Fixed value)
SET -XTERM_OPTIONS

# ==============================================================================
# Global Variables and Default Settings
# ==============================================================================

# Main operational parameters.
# Description: OP permission level for main channel.
^ASSIGN main.op 10

# Description: CCH (Channel Control Handler?) parameter for main channel.
^ASSIGN main.cch 15

# Description: AGN (Away/Gone?) parameter for main channel.
^ASSIGN main.agn 5

# Description: Isolate mode parameter for main channel.
^ASSIGN main.isolate 15

# Description: MRM (Message Rate Limit?) parameter for main channel.
^ASSIGN main.mrm 100

# Description: MNM (Minimum?) parameter for main channel.
^ASSIGN main.mnm 3

# Description: MNS (Maximum?) parameter for main channel.
^ASSIGN main.mns 5

# Description: NST (Notify?) parameter for main channel.
^ASSIGN main.nst 5

# Description: CSET (Command Set?) parameter for main channel.
^ASSIGN main.cset BCFOPV

# Description: DSET (Display Set?) parameter for main channel.
^ASSIGN main.dset GSR

# Description: MSET (Mode Set?) parameter for main channel.
^ASSIGN main.mset 1AMNOPUV

# Description: WSET (Window Set?) parameter for main channel.
^ASSIGN main.wset D

# Description: QBUFF (Queue Buffer?) parameter for main channel.
^ASSIGN main.qbuff 200

# Description: SET (General Set?) parameter for main channel.
^ASSAIN main.set ABCFPRTU

# Description: Theme selection.
^ASSIGN main.theme default

# Description: Time format for main channel.
^ASSIGN main.tsfmt %I:%M

# Description: Auto-unban setting.
^ASSIGN main.auto_unban 0

# ==============================================================================
# Nickname Handling Logic
# ==============================================================================

# Script block to handle nickname assignment from environment variables.
# Attempts to get nickname from IRCNICK env var.
# If IRCNICK is set and has length, use it.
# Otherwise, fall back to $N (current/last nickname).
# Also sets main.auto_nick and main.buf to the chosen nickname.
DO {
  @ :tmp = getenv(IRCUMODE)
  @ main.umode = strlen($tmp) ? tmp : [-ws]
  @ :tmp = getenv(IRCNICK)
  IF (strlen($nick)) {
    ^ASSIGN main.auto_nick $tmp
    ^ASSIGN main.buf $tmp
  }{
    ^ASSIGN main.auto_nick $N
    ^ASSIGN main.buf $N
  }
}

# ==============================================================================
# Reason Files
# ==============================================================================

# Reason file for quitting.
@ main.reason_quit = which(quit.reasons)

# Reason file for kicking.
@ main.reason_kick = which(kick.reasons)

# Reason file for going away/back.
@ main.reason_back = which(back.reasons)

# Reason file for being gone.
@ main.reason_gone = which(gone.reasons)

# Reason file for oops/errors.
@ main.reason_oops = which(oops.reasons)

# Reason file for errors.
@ main.reason_error = which(error.reasons)

# Reason file for revenge.
@ main.reason_revenge = which(revenge.reasons)

# ==============================================================================
# DCC Settings
# ==============================================================================

# Maximum active DCC connections.
^ASSIGN main.dcc_active_limit 10

# Send queue size.
^ASSIGN main.dcc_send_queue 50

# Get queue size.
^ASSIGN main.dcc_get_queue 50
