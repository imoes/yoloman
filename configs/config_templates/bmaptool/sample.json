{
  "commands": [
    {
      "type": "copy",
      "image": "image.raw.bz2",
      "dest": "/dev/sdg",
      "bmap": "/var/lib/bmap/image.bmap",
      "bmap_sig": "/var/lib/bmap/image.bmap.asc",
      "fingerprint": "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2",
      "keyring": "/etc/pki/gpgkeys/bmaptool-keyring.gpg",
      "no_sig_verify": false,
      "no_verify": false,
      "psplash_pipe": "/run/psplash/psplash_fifo",
      "removable_device": true
    },
    {
      "type": "create",
      "image": "/srv/images/system.img",
      "output": "/srv/bmaps/system.bmap",
      "no_checksum": false
    }
  ]
}
