{
  "debug": false,
  "debug_log_file": "/tmp/ceni.log",
  "file": "/etc/network/interfaces",
  "iface": "",
  "no_act": false,
  "interfaces": [
    {
      "name": "lo",
      "auto": true,
      "method": "loopback",
      "description": "loopback interface"
    },
    {
      "name": "eth0",
      "auto": true,
      "method": "static",
      "address": "192.168.1.10",
      "netmask": "255.255.255.0",
      "gateway": "192.168.1.1",
      "dns_nameservers": [
        "8.8.8.8",
        "8.8.4.4"
      ],
      "dns_search": [
        "example.com"
      ],
      "description": "primary wired interface"
    },
    {
      "name": "wlan0",
      "auto": true,
      "method": "dhcp",
      "description": "wireless interface using DHCP"
    }
  ]
}
