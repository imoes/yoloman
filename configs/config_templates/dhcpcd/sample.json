{
  "install_routes": true,
  "exclude_interfaces": [
    "lo",
    "docker0"
  ],
  "static_ipv4": [
    {
      "interface": "eth1",
      "ip": "192.168.10.50",
      "prefix": 24,
      "gateway": "192.168.10.1",
      "dns": [
        "8.8.8.8",
        "8.8.4.4"
      ],
      "hostname": "server-lab"
    }
  ],
  "static_ipv6": [
    {
      "interface": "eth1",
      "ip": "2001:db8:1::50",
      "prefixlen": 64,
      "gateway": "2001:db8:1::1",
      "dns": [
        "2001:4860:4860::8888"
      ]
    }
  ],
  "request_options": [
    "ntp_servers",
    "120"
  ],
  "ipv6_ra_mode": "slaac+dhcpv6",
  "slaac_wait_seconds": 3,
  "retry_delay": 20,
  "use_lease_time": true,
  "log_level": "info",
  "hostname": "dhcp-client-node"
}
