{
  "log_level": 3,
  "log_domains": [
    "MM",
    "QMI",
    "MBIM",
    "USB"
  ],
  "probe_delay_ms": 2000,
  "modem_init_timeout_s": 120,
  "max_connections": 50,
  "enable_phone_state_monitoring": false,
  "enable_usb_device_probing": true,
  "enable_at_port_auto_detect": true,
  "enable_firmware_update": true,
  "enable_mm_sms": true,
  "enable_qmi": true,
  "enable_nmea": false,
  "enable_lock_serial_port": true,
  "enable_plugin_modemfirmware": true,
  "plugin_blacklist": [
    "option",
    "sierra"
  ],
  "plugin_whitelist": [],
  "port_blacklist": [
    "ttyACM0:at"
  ],
  "port_whitelist": [],
  "usb_device_blacklist": [
    "12d1:140c",
    "2c7c:0125"
  ],
  "usb_device_whitelist": [
    "2c7c:0195",
    "1199:9071"
  ],
  "plugin_options": [
    {
      "name": "quectel",
      "options": [
        "at_timeout=30000",
        "init_delay=500"
      ]
    },
    {
      "name": "nokia",
      "options": [
        "nmea_rate=5"
      ]
    }
  ]
}
