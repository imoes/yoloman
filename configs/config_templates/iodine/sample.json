{
  "server": {
    "listen_ip": "0.0.0.0",
    "port": 53,
    "domain": "tunnel.example.com",
    "secret": "supersecret2024iodine!",
    "max_tunnels": 50,
    "idle_timeout": 300,
    "compress": true,
    "max_pktsize": 1200,
    "verbose": false,
    "log_level": 2,
    "interface": "eth0",
    "chroot": "/var/chroot/iodine",
    "user": "iodine",
    "group": "iodine",
    "upstream_resolver": "1.1.1.1#53",
    "ttl": 60,
    "allow_ips": [
      "10.0.0.0/8",
      "192.168.1.0/24"
    ],
    "deny_ips": [
      "10.10.10.10"
    ],
    "record_type": "TXT",
    "status_record_type": "A",
    "redirect": "192.168.1.1"
  }
}
