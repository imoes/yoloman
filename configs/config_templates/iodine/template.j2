# iodine server configuration file
# Listen on this IP address (use 0.0.0.0 for all interfaces)
listen = {{ server.listen_ip }}

# Listen on this UDP port for DNS queries (default: 53)
port = {{ server.port }}

# Root domain to serve (must be a domain you control, e.g., tunnel.example.com)
domain = {{ server.domain }}

# Secret shared between client and server for authentication (must be 20 chars minimum for SHA1)
secret = {{ server.secret }}

# Maximum number of concurrent tunnels (clients)
max_tunnels = {{ server.max_tunnels }}

# Maximum tunnel idle time in seconds before eviction
idle_timeout = {{ server.idle_timeout }}

# Enable compression of DNS tunnel payload (true/false)
compress = {{ server.compress | lower }}

# Maximum packet size in bytes (must be ≥ 512 and ≤ 4096; typical: 1024–2048)
max_pktsize = {{ server.max_pktsize }}

# Enable verbose logging (true/false); use syslog for production
verbose = {{ server.verbose | lower }}

# Log level: 0=quiet, 1=errors, 2=info, 3=debug
log_level = {{ server.log_level }}

# Optional: specify the interface to bind DNS packets to (e.g., eth0)
{% if server.interface %}
interface = {{ server.interface }}
{% endif %}

# Optional: chroot directory (e.g., /var/chroot/iodine)
{% if server.chroot %}
chroot = {{ server.chroot }}
{% endif %}

# Optional: drop privileges to this user/group after binding ports
{% if server.user %}
user = {{ server.user }}
{% endif %}
{% if server.group %}
group = {{ server.group }}
{% endif %}

# Optional: forward DNS queries for subdomains to this upstream resolver
# Use format: resolver = <IP> or resolver = <IP>#<port>
{% if server.upstream_resolver %}
resolver = {{ server.upstream_resolver }}
{% endif %}

# Optional: set TTL (seconds) for DNS responses (default: 300)
{% if server.ttl %}
ttl = {{ server.ttl }}
{% endif %}

# Optional: allow only specific IPs (list of CIDRs or IPs)
{% if server.allow_ips %}
{% for ip in server.allow_ips %}
allow = {{ ip }}
{% endfor %}
{% endif %}

# Optional: deny specific IPs (list of CIDRs or IPs)
{% if server.deny_ips %}
{% for ip in server.deny_ips %}
deny = {{ ip }}
{% endfor %}
{% endif %}

# Optional: specify the DNS record type to use for the data channel
# Valid: 'TXT' (default), 'MX', 'SOA'
{% if server.record_type %}
record_type = {{ server.record_type }}
{% endif %}

# Optional: specify the DNS record type to use for status/heartbeat queries
{% if server.status_record_type %}
status_record_type = {{ server.status_record_type }}
{% endif %}

# Optional: redirect all non-tunnel DNS to a fixed response (e.g., for captive portal bypass)
# redirect = <IP>  # returns A record of <IP> for unknown queries
{% if server.redirect %}
redirect = {{ server.redirect }}
{% endif %}
