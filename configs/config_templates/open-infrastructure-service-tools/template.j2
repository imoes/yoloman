{# open-infrastructure-service-tools: Apache mod_autoindex configuration #}

{# Enable mod_autoindex module if not already loaded #}
{# This package manages icon formatting for directory listings #}

<IfModule mod_autoindex.c>
    {# Include default icon set configuration #}
    Include /usr/share/open-infrastructure/apache-icons/default.conf

    {# default_format: Default icon format for auto-generated directory listings (e.g., x-silver, x-gnome, etc.) #}
    {# Uses the provided variable with fallback to 'x-silver' #}
    DefaultIcon /icons/default.{{ default_format | default('x-silver') }}
</IfModule>