# Configuration file for kism3d (802.11 visualizer for s3d)
#
# This template configures the connection to the S3D streaming backend.
# The S3D (Stream for 3D) protocol is a WebSocket-based interface used
# by Kismet to stream 802.11 packet data and visualizations.

# The URL endpoint for the S3D stream provided by the Kismet server.
# Typically a WebSocket URL on localhost.
# Schema default: 'ws://localhost:2501/s3d'
--s3d-url {{ s3d_url | default('ws://localhost:2501/s3d') }}