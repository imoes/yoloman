# ============================================================
# libgenders configuration file
# Generated by Ansible Jinja2 template.
# This file configures the libgenders library used by
# Slurm and other HPC job schedulers to manage node attributes.
# ============================================================

# --- libgenders: Path to the genders file used by the library. ---
# Default: /etc/genders
GENDERS_FILE={{ (genders_file | default('/etc/genders')) | string }}

# --- libgenders: Debug level; set to 1 to enable debug output. ---
# Default: 0
DEBUG={{ debug_level | default(0) }}

# --- libgenders: List of attribute names to pre-index for faster query performance. ---
# Default: [] (empty list)
{% for attr in (index_attrs | default([])) %}INDEX_ATTR={{ attr | string }}
{% endfor %}