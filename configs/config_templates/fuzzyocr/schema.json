{
  "focr_verbose": {
    "type": "number",
    "default": 1,
    "description": "Verbosity level: 0=Errors only, 1=Errors+Warnings, 2=+Info, 3=Full debug"
  },
  "focr_log_pmsinfo": {
    "type": "number",
    "default": 1,
    "description": "Log Message-Id, From, To"
  },
  "focr_log_stderr": {
    "type": "number",
    "default": 1,
    "description": "Send logging output to stderr"
  },
  "focr_logfile": {
    "type": "string",
    "default": "",
    "description": "Logfile path (empty = disabled)"
  },
  "focr_global_wordlist": {
    "type": "string",
    "default": "/etc/spamassassin/FuzzyOcr.words",
    "description": "Path to global wordlist"
  },
  "focr_personal_wordlist": {
    "type": "string",
    "default": "fuzzyocr.words",
    "description": "Relative or absolute path to personal wordlist"
  },
  "focr_no_homedirs": {
    "type": "number",
    "default": 0,
    "description": "Disable personalization (home directory usage)"
  },
  "focr_strip_numbers": {
    "type": "number",
    "default": 1,
    "description": "Strip numbers from wordlists and OCR results"
  },
  "focr_bin_helper": {
    "type": "string",
    "default": "pnmnorm, pnminvert, ppmtopgm",
    "description": "Comma-separated list of helper binaries to load (first line)"
  },
  "focr_bin_helper_2": {
    "type": "string",
    "default": "tesseract",
    "description": "Comma-separated list of helper binaries to load (second line, e.g. tesseract)"
  },
  "focr_path_bin": {
    "type": "string",
    "default": "/usr/local/netpbm/bin:/usr/local/bin:/usr/bin",
    "description": "Search path for helper binaries"
  },
  "focr_preprocessor_file": {
    "type": "string",
    "default": "/etc/spamassassin/FuzzyOcr.preps",
    "description": "Path to preprocessor definitions file"
  },
  "focr_scanset_file": {
    "type": "string",
    "default": "/etc/spamassassin/FuzzyOcr.scansets",
    "description": "Path to scanset definitions file"
  },
  "focr_minimal_scanset": {
    "type": "number",
    "default": 1,
    "description": "Skip remaining scansets after one hits focr_counts_required"
  },
  "focr_autosort_scanset": {
    "type": "number",
    "default": 1,
    "description": "Enable autosorting of scansets by effectiveness"
  },
  "focr_autosort_buffer": {
    "type": "number",
    "default": 10,
    "description": "Max value of effectiveness counter per scanset"
  },
  "focr_timeout": {
    "type": "number",
    "default": 10,
    "description": "Plugin timeout in seconds"
  },
  "focr_global_timeout": {
    "type": "number",
    "default": 0,
    "description": "Use global timeout instead of per-helper"
  },
  "focr_min_height": {
    "type": "number",
    "default": 4,
    "description": "Minimum image height to scan"
  },
  "focr_min_width": {
    "type": "number",
    "default": 4,
    "description": "Minimum image width to scan"
  },
  "focr_max_height": {
    "type": "number",
    "default": 800,
    "description": "Maximum image height to scan"
  },
  "focr_max_width": {
    "type": "number",
    "default": 800,
    "description": "Maximum image width to scan"
  },
  "focr_max_size_gif": {
    "type": "number",
    "default": 80000,
    "description": "Maximum GIF file size in bytes"
  },
  "focr_max_size_jpeg": {
    "type": "number",
    "default": 100000,
    "description": "Maximum JPEG file size in bytes"
  },
  "focr_max_size_png": {
    "type": "number",
    "default": 80000,
    "description": "Maximum PNG file size in bytes"
  },
  "focr_max_size_bmp": {
    "type": "number",
    "default": 500000,
    "description": "Maximum BMP file size in bytes"
  },
  "focr_max_size_tiff": {
    "type": "number",
    "default": 500000,
    "description": "Maximum TIFF file size in bytes"
  },
  "focr_skip_gif": {
    "type": "number",
    "default": 0,
    "description": "Skip GIF files"
  },
  "focr_skip_jpeg": {
    "type": "number",
    "default": 0,
    "description": "Skip JPEG files"
  },
  "focr_skip_png": {
    "type": "number",
    "default": 0,
    "description": "Skip PNG files"
  },
  "focr_skip_bmp": {
    "type": "number",
    "default": 0,
    "description": "Skip BMP files"
  },
  "focr_skip_tiff": {
    "type": "number",
    "default": 0,
    "description": "Skip TIFF files"
  },
  "focr_add_score": {
    "type": "number",
    "default": 0.375,
    "description": "Additional score for every additional match after focr_counts_required matches"
  },
  "focr_twopass_scoring_factor": {
    "type": "number",
    "default": 1.5,
    "description": "Factor for two-pass scoring"
  },
  "focr_wrongctype_score": {
    "type": "number",
    "default": 1.5,
    "description": "Score for wrong content-type"
  },
  "focr_wrongext_score": {
    "type": "number",
    "default": 1.5,
    "description": "Score for wrong file extension"
  },
  "focr_corrupt_score": {
    "type": "number",
    "default": 2.5,
    "description": "Score for corrupted image"
  },
  "focr_corrupt_unfixable_score": {
    "type": "number",
    "default": 5,
    "description": "Score for corrupted unfixable image"
  },
  "focr_autodisable_score": {
    "type": "number",
    "default": 30,
    "description": "Disable OCR if message has more points than this value"
  },
  "focr_autodisable_negative_score": {
    "type": "number",
    "default": -5,
    "description": "Disable OCR if message has less points than this value"
  },
  "focr_enable_image_hashing": {
    "type": "number",
    "default": 0,
    "description": "Enable image hashing: 0=disabled, 1=digest_hash, 2=digest_db, 3=mysql"
  },
  "focr_skip_updates": {
    "type": "number",
    "default": 0,
    "description": "Skip updating hashing database at startup"
  },
  "focr_hashing_learn_scanned": {
    "type": "number",
    "default": 1,
    "description": "Automatically add hashes of spam images to database"
  },
  "focr_score_ham": {
    "type": "number",
    "default": 0,
    "description": "Score images with low word count using formula"
  },
  "focr_digest_db": {
    "type": "string",
    "default": "/etc/spamassassin/FuzzyOcr.hashdb",
    "description": "Path to digest_hash database file"
  },
  "focr_db_hash": {
    "type": "string",
    "default": "/etc/spamassassin/FuzzyOcr.db",
    "description": "Path to SPAM hash database file"
  },
  "focr_db_safe": {
    "type": "string",
    "default": "/etc/spamassassin/FuzzyOcr.safe.db",
    "description": "Path to HAM hash database file"
  },
  "focr_db_max_days": {
    "type": "number",
    "default": 15,
    "description": "Auto-prune: Expire records from hashing databases after these many days"
  },
  "focr_mysql_update_hash": {
    "type": "number",
    "default": 1,
    "description": "Update database table with different data"
  },
  "focr_keep_bad_images": {
    "type": "number",
    "default": 1,
    "description": "Keep intermediate bad images for debugging: 0=cleanup, 1=keep on error, 2=always keep"
  }
}
