{
  "focr_verbose": {
    "type": "string",
    "default": "",
    "description": "Verbosity level: 0=Errors only, 1=Errors+Warnings, 2=+Info, 3=Full debug"
  },
  "focr_log_pmsinfo": {
    "type": "string",
    "default": "",
    "description": "Log Message-Id, From, To"
  },
  "focr_log_stderr": {
    "type": "string",
    "default": "",
    "description": "Send logging output to stderr"
  },
  "focr_logfile": {
    "type": "string",
    "default": "",
    "description": "Logfile path (empty = disabled)"
  },
  "focr_global_wordlist": {
    "type": "string",
    "default": "",
    "description": "Path to global wordlist"
  },
  "focr_personal_wordlist": {
    "type": "string",
    "default": "",
    "description": "Relative or absolute path to personal wordlist"
  },
  "focr_no_homedirs": {
    "type": "string",
    "default": "",
    "description": "Disable personalization (home directory usage)"
  },
  "focr_strip_numbers": {
    "type": "string",
    "default": "",
    "description": "Strip numbers from wordlists and OCR results"
  },
  "focr_bin_helper": {
    "type": "string",
    "default": "pnmnorm, pnminvert, ppmtopgm",
    "description": "Comma-separated list of helper binaries to load (first line)"
  },
  "focr_bin_helper_2": {
    "type": "string",
    "default": "tesseract",
    "description": "Comma-separated list of helper binaries to load (second line, e.g. tesseract)",
    "enum": [
      "pnmnorm",
      "pnminvert",
      "ppmtopgm",
      "gifsicle",
      "giffix",
      "giftext",
      "giftopnm",
      "jpegtopnm",
      "pngtopnm",
      "bmptopnm",
      "tifftopnm",
      "ppmhist",
      "gocr",
      "ocrad",
      "tesseract",
      "pdfinfo",
      "pdftops",
      "pstopnm"
    ]
  },
  "focr_path_bin": {
    "type": "string",
    "default": "",
    "description": "Search path for helper binaries"
  },
  "focr_preprocessor_file": {
    "type": "string",
    "default": "",
    "description": "Path to preprocessor definitions file"
  },
  "focr_scanset_file": {
    "type": "string",
    "default": "",
    "description": "Path to scanset definitions file"
  },
  "focr_minimal_scanset": {
    "type": "string",
    "default": "",
    "description": "Skip remaining scansets after one hits focr_counts_required"
  },
  "focr_autosort_scanset": {
    "type": "string",
    "default": "",
    "description": "Enable autosorting of scansets by effectiveness"
  },
  "focr_autosort_buffer": {
    "type": "string",
    "default": "",
    "description": "Max value of effectiveness counter per scanset"
  },
  "focr_timeout": {
    "type": "string",
    "default": "",
    "description": "Plugin timeout in seconds"
  },
  "focr_global_timeout": {
    "type": "string",
    "default": "",
    "description": "Use global timeout instead of per-helper"
  },
  "focr_min_height": {
    "type": "string",
    "default": "",
    "description": "Minimum image height to scan"
  },
  "focr_min_width": {
    "type": "string",
    "default": "",
    "description": "Minimum image width to scan"
  },
  "focr_max_height": {
    "type": "string",
    "default": "",
    "description": "Maximum image height to scan"
  },
  "focr_max_width": {
    "type": "string",
    "default": "",
    "description": "Maximum image width to scan"
  },
  "focr_max_size_gif": {
    "type": "string",
    "default": "",
    "description": "Maximum GIF file size in bytes"
  },
  "focr_max_size_jpeg": {
    "type": "string",
    "default": "",
    "description": "Maximum JPEG file size in bytes"
  },
  "focr_max_size_png": {
    "type": "string",
    "default": "",
    "description": "Maximum PNG file size in bytes"
  },
  "focr_max_size_bmp": {
    "type": "string",
    "default": "",
    "description": "Maximum BMP file size in bytes"
  },
  "focr_max_size_tiff": {
    "type": "string",
    "default": "",
    "description": "Maximum TIFF file size in bytes"
  },
  "focr_skip_gif": {
    "type": "string",
    "default": "",
    "description": "Skip GIF files"
  },
  "focr_skip_jpeg": {
    "type": "string",
    "default": "",
    "description": "Skip JPEG files"
  },
  "focr_skip_png": {
    "type": "string",
    "default": "",
    "description": "Skip PNG files"
  },
  "focr_skip_bmp": {
    "type": "string",
    "default": "",
    "description": "Skip BMP files"
  },
  "focr_skip_tiff": {
    "type": "string",
    "default": "",
    "description": "Skip TIFF files"
  }
}
