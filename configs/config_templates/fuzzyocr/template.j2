# =================================================================
# The following directives are commented out by default.
# Uncomment and modify them if advanced tuning is required.
# =================================================================

# PDF Scanning
# WARNING: Enabling PDF scanning can lead to false positives.
#focr_scan_pdfs 0
#focr_pdf_maxpages 1

# Detection Thresholds
# Lower values make detection more sensitive.
#focr_threshold 0.20

# Match Counting
# Minimum matches required before scoring.
#focr_counts_required 3

# Unique Matches
# Match each word only once per image.
#focr_unique_matches 1

# Scoring Factors
# Base score for a hit.
#focr_base_score 5
# Additional score per match after focr_counts_required.
#focr_add_score 0.375
# Two-pass scoring factor.
#focr_twopass_scoring_factor 1.5
# Score for wrong content-type.
#focr_wrongctype_score 1.5
# Score for wrong extension.
#focr_wrongext_score 1.5
# Score for corrupted image.
#focr_corrupt_score 2.5
# Score for unfixable corrupted image.
#focr_corrupt_unfixable_score 5

# Auto-Disable Thresholds
# Disable OCR if score is already above this value.
#focr_autodisable_score 30
# Disable OCR if score is below this negative value.
#focr_autodisable_negative_score -5


###
### Image Hashing Options (Optional)
###

# Enable image hashing to speed up detection of known spam images.
# 1 = digest_hash (deprecated)
# 2 = digest_db with import (recommended)
# 3 = MySQL database (experimental)
#focr_enable_image_hashing 0

# Skip updating the hash database at startup.
#focr_skip_updates 0

# Automatically add hashes of detected spam images to the database.
#focr_hashing_learn_scanned 1

# Score images with low word counts using a formula.
#focr_score_ham 0

# Database file paths for hashing (if enabled).
#focr_digest_db /etc/spamassassin/FuzzyOcr.hashdb
#focr_db_hash /etc/spamassassin/FuzzyOcr.db
#focr_db_safe /etc/spamassassin/FuzzyOcr.safe.db

# Auto-prune old records from hash databases (in days).
#focr_db_max_days 35


###
### MySQL Options (For Hashing Type 3)
###

# Database connection details for MySQL-backed hashing.
#focr_mysql_db FuzzyOcr
#focr_mysql_hash Hash
#focr_mysql_safe Safe
#focr_mysql_user fuzzyocr
#focr_mysql_pass fuzzyocr
#focr_mysql_host localhost
#focr_mysql_port 3306
#focr_mysql_socket /tmp/mysql.sock

# Update database table with hash data.
#focr_mysql_update_hash 0


