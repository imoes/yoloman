###
### Helper Applications (Binaries)
###

# Comma-separated list of helper binaries to load (first line of configuration).
# These are typically image processing utilities like NetPBM tools.
# Default: pnmnorm, pnminvert, ppmtopgm
# {{ focr_bin_helper | default('pnmnorm, pnminvert, ppmtopgm') }}
focr_bin_helper {{ focr_bin_helper | default('pnmnorm, pnminvert, ppmtopgm') }}

# Comma-separated list of helper binaries (second line).
# Often used for OCR engines like Tesseract.
# Default: tesseract
# {{ focr_bin_helper_2 | default('tesseract') }}
focr_bin_helper {{ focr_bin_helper_2 | default('tesseract') }}

# Search path for locating helper applications.
# The plugin searches these directories in order for the binaries defined above.
# Default: /usr/local/netpbm/bin:/usr/local/bin:/usr/bin
# {{ focr_path_bin | default('') }}
{% if focr_path_bin is defined and focr_path_bin != '' %}
focr_path_bin {{ focr_path_bin }}
{% else %}
#focr_path_bin /usr/local/netpbm/bin:/usr/local/bin:/usr/bin
{% endif %}


