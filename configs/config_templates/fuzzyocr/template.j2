# FuzzyOcr Plugin Configuration for SpamAssassin
#
# This configuration file controls the behavior of the FuzzyOcr plugin,
# which enables SpamAssassin to detect spam containing images by performing
# Optical Character Recognition (OCR) on attached images.
#
# Directives are prefixed with 'focr_' to avoid conflicts with other SpamAssassin
# directives. Lines beginning with '#' are commented out and represent default
# or disabled values. To enable a setting, uncomment the line and adjust the
# value provided by Ansible variables.

###
### Plugin Loading
###

# Load the FuzzyOcr plugin module.
# The path is handled by the system loader; this directive just enables the plugin.
loadplugin FuzzyOcr

# Begin FuzzyOcr-specific configuration block.
# All directives below must be inside this block.
ifplugin FuzzyOcr

# --- Rules and Scores ---
# These directives define the SpamAssassin rules triggered by FuzzyOcr
# and their associated scoring evaluations.

# Main detection rule: triggers when FuzzyOcr identifies spam text in an image.
body     FUZZY_OCR                   eval:fuzzyocr_check()

# Rule for images with incorrect MIME content-type (e.g., JPEG declared as PNG).
body     FUZZY_OCR_WRONG_CTYPE       eval:dummy_check()

# Rule for corrupted image files that could not be processed.
body     FUZZY_OCR_CORRUPT_IMG       eval:dummy_check()

# Rule for images with file extensions that do not match their content-type.
body     FUZZY_OCR_WRONG_EXTENSION   eval:dummy_check()

# Rule for images with hashes previously identified as spam.
body     FUZZY_OCR_KNOWN_HASH        eval:dummy_check()

# Descriptions for the rules defined above, displayed in spam reports.
describe FUZZY_OCR                   Mail contains an image with common spam text inside
describe FUZZY_OCR_WRONG_CTYPE       Mail contains an image with wrong content-type set
describe FUZZY_OCR_WRONG_EXTENSION   Mail contains an image with wrong file extension
describe FUZZY_OCR_CORRUPT_IMG       Mail contains a corrupted image
describe FUZZY_OCR_KNOWN_HASH        Mail contains an image with known hash

# Priority of the main FuzzyOcr rule. Higher numbers execute later.
priority FUZZY_OCR 900


###
### Logging Options
###

# Verbosity level for logging output.
# 0 = Errors only
# 1 = Errors + Warnings
# 2 = Errors + Warnings + Info
# 3 = Full debug output
# Default: 3 (Full debug) if not specified, though many setups prefer 1 or 2.
# {{ focr_verbose | default('') }}
{% if focr_verbose is defined and focr_verbose != '' %}
focr_verbose {{ focr_verbose }}
{% else %}
#focr_verbose 3
{% endif %}

# Log Message-Id, From, and To addresses for debugging email context.
# Default: 0 (Disabled)
# {{ focr_log_pmsinfo | default('') }}
{% if focr_log_pmsinfo is defined and focr_log_pmsinfo != '' %}
focr_log_pmsinfo {{ focr_log_pmsinfo }}
{% else %}
#focr_log_pmsinfo 0
{% endif %}

# Send logging output to stderr instead of the logfile.
# Useful for systemd journal integration or console debugging.
# Default: 0 (Disabled)
# {{ focr_log_stderr | default('') }}
{% if focr_log_stderr is defined and focr_log_stderr != '' %}
focr_log_stderr {{ focr_log_stderr }}
{% else %}
#focr_log_stderr 0
{% endif %}

# Path to the FuzzyOcr log file.
# Set to empty to disable logging to a file.
# Default: /tmp/FuzzyOcr.log
# {{ focr_logfile | default('') }}
{% if focr_logfile is defined and focr_logfile != '' %}
focr_logfile {{ focr_logfile }}
{% else %}
#focr_logfile /tmp/FuzzyOcr.log
{% endif %}


