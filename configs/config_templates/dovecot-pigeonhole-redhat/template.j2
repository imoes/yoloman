##
## ManageSieve specific settings
##
## This configuration block handles the ManageSieve protocol settings for
## Dovecot Pigeonhole. ManageSieve allows remote script management for
## Sieve mail filtering.

# Uncomment to enable managesieve protocol:
# The 'sieve' keyword enables the Sieve protocol. Other protocols (imap, pop3)
# are configured in the main 10-mail.conf or protocol definitions.
#protocols = $protocols sieve

# Service definitions
# These blocks define how the ManageSieve login service and the protocol
# service itself behave.

#service managesieve-login {
  # Defines the inet listeners for the ManageSieve login process.

  #inet_listener sieve {
    # Port for the ManageSieve login service.
    # Standard port is 4190.
    port = {{ managesieve_login_port | default(4190) }}
  #}

  #inet_listener sieve_deprecated {
    # Deprecated port for backward compatibility with older clients.
    # Usually not needed unless supporting legacy software.
    port = 2000
  #}

  # Number of connections to handle before starting a new process.
  # Typically the only useful values are 0 (unlimited) or 1.
  # 1 is more secure, but 0 is faster.
  # See <doc/wiki/LoginProcess.txt>
  #service_count = 1

  # Number of processes to always keep waiting for more connections.
  # This helps reduce latency for new connections.
  #process_min_avail = 0

  # If you set service_count=0, you probably need to grow this.
  # Limits the virtual memory size of the login process.
  #vsz_limit = 64M
#}

#service managesieve {
  # Max. number of ManageSieve processes (connections).
  # Limits the concurrency of the ManageSieve protocol handler.
{% if managesieve_process_limit | default('') %}  process_limit = {{ managesieve_process_limit }}{% else %}  #process_limit = 1024{% endif %}
#}

# Service configuration
# Settings specific to the 'sieve' protocol execution.

protocol sieve {
  # Maximum ManageSieve command line length in bytes.
  # ManageSieve usually does not involve overly long command lines,
  # so this setting will not normally need adjustment.
  #managesieve_max_line_length = 65536

  # Maximum number of ManageSieve connections allowed for a user from each IP address.
  # This helps prevent a single user/IP from exhausting server resources.
  # NOTE: The username is compared case-sensitively.
{% if managesieve_mail_max_userip_connections | default('') %}  mail_max_userip_connections = {{ managesieve_mail_max_userip_connections }}{% else %}  #mail_max_userip_connections = 10{% endif %}

  # Space separated list of plugins to load (none known to be useful so far).
  # Do NOT try to load IMAP plugins here.
  #mail_plugins =

  # MANAGESIEVE logout format string:
  #  %i - total number of bytes read from client
  #  %o - total number of bytes sent to client
  #  %{put_bytes} - Number of bytes saved using PUTSCRIPT command
  #  %{put_count} - Number of scripts saved using PUTSCRIPT command
  #  %{get_bytes} - Number of bytes read using GETSCRIPT command
  #  %{get_count} - Number of scripts read using GETSCRIPT command
  #  %{check_bytes} - Number of bytes processed using CHECKSCRIPT command
  #  %{check_count} - Number of scripts checked using CHECKSCRIPT command
  #  %{deleted_count} - Number of scripts deleted using DELETESCRIPT command
  #  %{renamed_count} - Number of scripts renamed using RENAMESCRIPT command
  #managesieve_logout_format = bytes=%i/%o

  # To fool ManageSieve clients that are focused on CMU's timesieved you can
  # specify the IMPLEMENTATION capability that Dovecot reports to clients.
  # For example: 'Cyrus timsieved v2.2.13'
  #managesieve_implementation_string = Dovecot Pigeonhole

  # Explicitly specify the SIEVE and NOTIFY capability reported by the server
  # before login. If left unassigned these will be reported dynamically
  # according to what the Sieve interpreter supports by default (after login
  # this may differ depending on the user).
  #managesieve_sieve_capability =
  #managesieve_notify_capability =

  # The maximum number of compile errors that are returned to the client upon
  # script upload or script verification.
  # Prevents log flooding by truncating error reports for buggy scripts.
{% if managesieve_max_compile_errors | default('') %}  managesieve_max_compile_errors = {{ managesieve_max_compile_errors }}{% else %}  #managesieve_max_compile_errors = 5{% endif %}

  # Refer to 90-sieve.conf for script quota configuration and configuration of
  # Sieve execution limits.
}
