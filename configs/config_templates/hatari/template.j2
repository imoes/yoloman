; Hatari configuration file generated by Ansible
; This configuration controls the Atari ST/STE/TT/Falcon emulator "Hatari".
; Every setting is self-documented with its schema description.

[Log]
# Path to the Hatari log file
sLogFileName = {{ log_file | default('/tmp/hatari.log') }}
# Log verbosity: 0=fatal, 1=error, 2=warning, 3=info, 4=trace, 5=debug
nLogLevel = {{ log_level | default(3) }}
# Prompt for confirmation before quitting
bConfirmQuit = {{ confirm_quit | default(True) | ternary('TRUE', 'FALSE') }}

[Screen]
# Start Hatari in full-screen mode
bFullScreen = {{ fullscreen | default(False) | ternary('TRUE', 'FALSE') }}
# Keep the host desktop resolution when switching video modes
bKeepResolution = TRUE
# Monitor type: 0=VGA (colour), 1=TV/RF, 2=Mono greyscale, 3=TT High
nMonitorType = {{ monitor_type | default(0) }}
# Frames to skip per rendered frame (0=none; increase to trade smoothness for emulation speed)
nFrameSkips = {{ frame_skips | default(0) }}
# Throttle emulation speed to match the real Atari
bSlowDownToRealSpeed = TRUE
# Enable extended VDI resolutions; only usable with ST-High mono mode
bUseExtVdiResolutions = {{ vdi_enabled | default(False) | ternary('TRUE', 'FALSE') }}
# VDI resolution width in pixels (used when vdi_enabled is true)
nVdiWidth = {{ vdi_width | default(640) }}
# VDI resolution height in pixels (used when vdi_enabled is true)
nVdiHeight = {{ vdi_height | default(480) }}
# VDI colour depth: 2, 4, or 16 colours
nVdiColors = {{ vdi_colors | default(2) }}
# Lock mouse pointer inside the emulator window
bCaptureMouse = FALSE
# Use SDL hardware-accelerated renderer
bUseSdlRenderer = TRUE
# Maximum emulator window width in pixels
nMaxWidth = {{ max_width | default(832) }}
# Maximum emulator window height in pixels
nMaxHeight = {{ max_height | default(588) }}
# SDL texture scaling filter: 0=nearest-neighbour (sharp pixels), 1=linear, 2=best
nRenderScaleQuality = {{ render_scale_quality | default(0) }}
# Synchronise rendering to the display vertical blank (reduces tearing)
bUseVsync = {{ use_vsync | default(False) | ternary('TRUE', 'FALSE') }}
# Show the status bar with drive and CPU indicators beneath the emulator screen
bShowStatusBar = {{ show_status_bar | default(True) | ternary('TRUE', 'FALSE') }}
# Show disk-activity LED overlay
bShowDriveLed = TRUE
# Crop display output to remove overscan borders
bCrop = FALSE

[Joystick]
# Joystick port configuration; must contain exactly 2 entries (port 0 = Atari joystick port 0, port 1 = port 1)
{% for joy in (joysticks | default([{'mode': 0, 'autofire': False, 'joy_id': 0}, {'mode': 0, 'autofire': False, 'joy_id': 0}])) %}
# Port {{ loop.index0 }} mode: 0=disabled, 1=real joystick, 2=keyboard cursor keys
nJoystickMode{{ loop.index0 }} = {{ joy.mode | default(0) }}
# Enable auto-fire on port {{ loop.index0 }}
bEnableAutoFire{{ loop.index0 }} = {{ joy.autofire | default(False) | ternary('TRUE', 'FALSE') }}
# Host SDL joystick index mapped to port {{ loop.index0 }}
nJoyId{{ loop.index0 }} = {{ joy.joy_id | default(0) }}
{% endfor %}

[Keyboard]
# Suppress host key-repeat events from reaching the emulator
bDisableKeyRepeat = {{ disable_key_repeat | default(False) | ternary('TRUE', 'FALSE') }}
# Keyboard mapping mode: 0=symbolic (character, layout-independent), 1=scancode (physical key position)
nKeymapType = {{ keymap_type | default(0) }}
# Path to a custom keyboard mapping file; leave empty to use the built-in map
szMappingFileName = {{ keymap_file | default('') }}

[Sound]
# Enable YM2149 sound chip emulation and audio output
bEnableSound = {{ sound_enabled | default(True) | ternary('TRUE', 'FALSE') }}
# Lock emulation speed to the audio output rate (prevents buffer underruns; may slow emulation)
bEnableSoundSync = {{ sound_sync | default(False) | ternary('TRUE', 'FALSE') }}
# Audio playback sample rate in Hz (common values: 22050, 44100, 48000)
nPlaybackFreq = {{ sound_freq | default(44100) }}
# SDL audio buffer size in bytes; 0 = let SDL choose automatically
nSdlAudioBufferSize = {{ sound_buffer_size | default(0) }}
# File path for captured YM audio output
szYMCaptureFileName = {{ ym_capture_file | default('/tmp/hatari.ym') }}
# Apply DC-removal high-pass filter to audio output (recommended)
bHighPassFilter = {{ sound_highpass_filter | default(True) | ternary('TRUE', 'FALSE') }}
# Redirect audio output to a file instead of the sound card
bOutputToFile = FALSE

[Memory]
# Base ST/STE RAM in MB: valid values are 1, 2, 4, 8, or 14
nMemorySize = {{ memory_size_mb | default(4) }}
# TT/Falcon fast RAM in MB; 0 = disabled; valid values are multiples of 256 up to 1024
nTTRamSize = {{ tt_ram_size_mb | default(0) }}
# Automatically save a memory snapshot when Hatari exits
bAutoSave = {{ memory_auto_save | default(False) | ternary('TRUE', 'FALSE') }}
# File path used for manually triggered memory snapshots
szMemoryCaptureFileName = {{ memory_snapshot_file | default('/tmp/hatari.sav') }}
# File path for the automatic on-exit memory snapshot
szAutoSaveFileName = {{ memory_autosave_file | default('~/.hatari/auto.sav') }}

[Floppy]
# Auto-insert disk A into drive B when drive B is empty (helps single-sided disk games)
bAutoInsertDiskB = {{ floppy_auto_insert_b | default(True) | ternary('TRUE', 'FALSE') }}
# Skip floppy timing emulation for instant disk access; breaks copy-protected disks
FastFloppy = {{ fast_floppy | default(False) | ternary('TRUE', 'FALSE') }}
# Floppy write-protection: 0=off, 1=always on, 2=auto (follow host file permissions)
nWriteProtection = {{ floppy_write_protection | default(0) }}
# Path to a disk image to insert into drive A at startup; empty = no disk
szDiskAFileName = {{ floppy_a_image | default('') }}
# Path to a disk image to insert into drive B at startup; empty = no disk
szDiskBFileName = {{ floppy_b_image | default('') }}
# Default directory shown in the floppy image file browser
szDiskImageDirectory = {{ floppy_image_dir | default('~/') }}

[HardDisk]
# Expose a host directory as the Atari GEMDOS hard drive (C:)
bUseHardDiskDirectory = {{ use_hdd_directory | default(False) | ternary('TRUE', 'FALSE') }}
# Host path to map as the Atari C: drive (used when use_hdd_directory is true)
szHardDiskDirectory = {{ hdd_directory | default('~/') }}
# GEMDOS directory write-protection: 0=off, 1=on, 2=auto
nHardDiskWriteProtection = {{ hdd_write_protection | default(0) }}
# Attach a raw ACSI hard disk image file
bUseHardDiskImage = {{ use_acsi_image | default(False) | ternary('TRUE', 'FALSE') }}
# Path to the primary ACSI disk image file (used when use_acsi_image is true)
szHardDiskImage = {{ acsi_image_file | default('') }}
# Attach an IDE master hard disk image (Falcon/TT only)
bUseIdeMasterHardDiskImage = {{ use_ide_master | default(False) | ternary('TRUE', 'FALSE') }}
# Path to the IDE master disk image file
szIdeMasterHardDiskImage = {{ ide_master_image | default('') }}
# Attach an IDE slave hard disk image (Falcon/TT only)
bUseIdeSlaveHardDiskImage = {{ use_ide_slave | default(False) | ternary('TRUE', 'FALSE') }}
# Path to the IDE slave disk image file
szIdeSlaveHardDiskImage = {{ ide_slave_image | default('') }}

[Acsi]
# Additional ACSI device slots (up to 8 total); each entry occupies one numbered slot in [Acsi]
{% for disk in (acsi_disks | default([])) %}
# Enable ACSI device slot {{ loop.index0 }}
bUseDevice{{ loop.index0 }} = {{ disk.enabled | default(False) | ternary('TRUE', 'FALSE') }}
# Disk image path for ACSI slot {{ loop.index0 }}
sDeviceFile{{ loop.index0 }} = {{ disk.image_file | default('') }}
{% endfor %}

[Rom]
# Path to the TOS ROM image file (required; use a TOS version appropriate for the configured machine type)
szTosImageFileName = {{ tos_image_path | default('/usr/share/hatari/tos.img') }}
# Path to a cartridge ROM image; empty = no cartridge
szCartridgeImageFileName = {{ cartridge_image_path | default('') }}

[Printer]
# Enable Atari parallel printer port emulation
bEnablePrinting = {{ printer_enabled | default(False) | ternary('TRUE', 'FALSE') }}
# Redirect printer output to a file rather than a real host printer
bPrintToFile = {{ printer_to_file | default(True) | ternary('TRUE', 'FALSE') }}
# File path for captured printer output
szPrintToFileName = {{ printer_output_file | default('/tmp/hatari.prn') }}

[RS232]
# Enable RS-232 serial port emulation
bEnableRS232 = {{ rs232_enabled | default(False) | ternary('TRUE', 'FALSE') }}
# Output device or file path for RS-232 transmitted data
szOutFileName = {{ rs232_out_file | default('/tmp/hatari.rs232.out') }}
# Input device or file path for RS-232 received data
szInFileName = {{ rs232_in_file | default('/tmp/hatari.rs232.in') }}

[Midi]
# Enable MIDI port emulation
bEnableMidi = {{ midi_enabled | default(False) | ternary('TRUE', 'FALSE') }}
# ALSA MIDI device or file path for MIDI input
sMidiInFileName = {{ midi_in_device | default('/dev/snd/midiC1D0') }}
# ALSA MIDI device or file path for MIDI output
sMidiOutFileName = {{ midi_out_device | default('/dev/snd/midiC1D0') }}

[System]
# Atari machine model to emulate: 0=ST, 1=STE, 2=TT030, 3=Falcon030
nMachineType = {{ machine_type | default(1) }}
# CPU model: 0=68000, 1=68010, 2=68020, 3=68030, 4=68040, 5=68060 (must be compatible with machine_type)
nCpuLevel = {{ cpu_level | default(0) }}
# CPU clock frequency in MHz (ST/STE stock=8, TT stock=32, Falcon stock=16)
nCpuFreq = {{ cpu_freq_mhz | default(8) }}
# Enable cycle-accurate CPU emulation for maximum software compatibility (reduces performance)
bCompatibleCpu = {{ compatible_cpu | default(True) | ternary('TRUE', 'FALSE') }}
# FPU model: 0=none, 1=68881, 2=68882, 3=68040 built-in, 4=software FPU
n_FPUType = {{ fpu_type | default(0) }}
# Enable cycle-accurate FPU emulation (recommended when fpu_type > 0)
bCompatibleFpu = {{ compatible_fpu | default(True) | ternary('TRUE', 'FALSE') }}
# Enable Blitter chip emulation (present on STE, TT, Falcon; optional on some early STE revisions)
bBlitter = {{ blitter_enabled | default(False) | ternary('TRUE', 'FALSE') }}
# DSP56001 emulation: 0=none, 1=emulated (Falcon only; required for Falcon audio and DSP software)
nDSPType = {{ dsp_type | default(0) }}
# Patch Timer-D interrupt for faster emulation; may break timing-sensitive demos or software
bPatchTimerD = {{ patch_timer_d | default(True) | ternary('TRUE', 'FALSE') }}
# Skip the TOS POST memory test to reduce startup time
bFastBoot = {{ fast_boot | default(False) | ternary('TRUE', 'FALSE') }}
# Run emulation as fast as the host allows, ignoring real-time speed throttling
bFastForward = {{ fast_forward | default(False) | ternary('TRUE', 'FALSE') }}
# Restrict address bus to 24 bits (required for ST/STE compatibility; disable for TT/Falcon with more than 8 MB RAM)
bAddressSpace24 = {{ address_space_24 | default(True) | ternary('TRUE', 'FALSE') }}

[Paths]
# Base directory for Hatari user data (config, snapshots, captures)
sHatariHome = {{ hatari_home_dir | default('~/.hatari/') }}
# Directory containing Hatari system data files installed by the package
sDataDir = {{ hatari_data_dir | default('/usr/share/hatari/') }}
# User-specific data directory (usually same as sHatariHome)
sUserDataDir = {{ hatari_home_dir | default('~/.hatari/') }}
# Directory for saved disk image files
sSavesDiskDir = {{ saves_dir | default('~/.hatari/') }}
# Directory for audio and video capture output files
sCaptureDir = {{ captures_dir | default('~/.hatari/') }}
# Directory for screenshot files
sScreenShotDir = {{ screenshots_dir | default('~/.hatari/') }}