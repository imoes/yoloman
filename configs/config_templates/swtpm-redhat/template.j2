# swtpm-redhat configuration
# Generated by Ansible Jinja2 template

# Include the main OpenSSL configuration file as the base for cryptographic settings.
.include /etc/ssl/openssl.cnf

[evp_properties]
# Allow SHA-1 signatures for TPM operations.
# Default: yes
rh-allow-sha1-signatures = {{ rh_allow_sha1_signatures | default('yes') }}
