{# ============================================================ #}
{# credential-sheets: LaTeX configuration for generating credential sheets #}
{# This template generates a multi-column LaTeX document where each #}
{# entry (row) displays credential information in a tabular format. #}
{# Placeholders like \VAR-login are replaced with actual row data. #}
{# ============================================================ #}

\documentclass[12pt]{article}

{# Configuration for page margins using the geometry package #}
\usepackage[margin=1cm]{geometry}

{# Package for multi-column layout, controlled by the 'cols' variable #}
\usepackage{multicol}

{# Package for including images (e.g., logos), though not dynamically configured here #}
\usepackage{graphicx}

{# Package for customizing headers and footers #}
\usepackage{fancyhdr}

{# Set the page style to 'fancy' to enable custom headers/footers #}
\pagestyle{fancy}

{# Left Header: Includes a logo image. #}
\lhead{\includegraphics[height=1cm]{header-logo}}

{# Right Header: Includes a footer logo image. #}
\rhead{\includegraphics[height=1cm]{footer-logo}}

{# Center Footer: Static text indicating the generator tool #}
\cfoot{\footnotesize Generated by credential-sheets}

\begin{document}

{# Start the multi-column environment #}
{# 'cols' defines the number of columns per page. Defaults to 2 if not specified. #}
\begin{multicols}{{ cols | default(2) }}

{# Iterate over the list of credential rows defined in 'rows' #}
{# Each 'row' is expected to be a mapping/object containing fields like 'login', 'password', etc. #}
{% for row in rows | default([]) %}

{# Ensure no paragraph indent before the table entry #}
\noindent

{# Begin a tabular environment for the current credential entry #}
{# The column width is calculated to fit within the multicolumn width, minus padding and rules. #}
{# Note: The original template had a fixed division by 1; this preserves that logic. #}
\begin{tabular}{|p{\dimexpr(\linewidth-2\tabcolsep-2\arrayrulewidth)/1\relax}|}
\hline

{# User Login Field #}
{# Displays the value of 'login' from the current row. #}
{# If 'login' is missing from the row, it remains empty. #}
\textbf{User:} \texttt{\VAR-login} \\
\hline

{# Name Fields (First and Last) #}
{# Displays the concatenation of 'firstName' and 'lastName' from the current row. #}
\textbf{Name:} \VAR-firstName\ \VAR-lastName \\
\hline

{# Password Field #}
{# Displays the value of 'password' from the current row in monospace font. #}
\textbf{Password:} \texttt{\VAR-password} \\
\hline

{# Conditional: Form Field #}
{# Only render if the 'form' attribute exists and is not empty/null in the row. #}
{% if row.form %}
\textbf{Form:} \VAR-form \\
\hline
{% endif %}

{# Conditional: Subjects Field #}
{# Only render if the 'subjects' attribute exists and is not empty/null in the row. #}
{% if row.subjects %}
\textbf{Subjects:} \VAR-subjects \\
\hline
{% endif %}

{# Conditional: WiFi ESSID Field #}
{# Only render if the 'essid' attribute exists and is not empty/null in the row. #}
{% if row.essid %}
\textbf{WiFi ESSID:} \texttt{\VAR-essid} \\
\hline
{% endif %}

{# Conditional: Valid Duration Field #}
{# Only render if the 'duration' attribute exists and is not empty/null in the row. #}
{% if row.duration %}
\textbf{Valid:} \VAR-duration \\
\hline
{% endif %}

{# End the tabular environment for this entry #}
\end{tabular}

{# Add vertical space between entries using the baseline skip #}
\vspace{\baselineskip}

{% endfor %}

{# End the multi-column environment #}
\end{multicols}

{# End the LaTeX document #}
\end{document}