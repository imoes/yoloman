# Only the system administrator should modify this file, ordinary users
# should not have to change anything.

[Daemon]

# Default backend(s) to use for PackageKit, as chosen in the configure script.
# Comma-separated list. 'auto' allows automatic selection.
# Example: "apt,dnf" or "auto".
DefaultBackend={{ default_backend | default('auto') }}

# Time in seconds to wait before unlocking the backend after it becomes idle.
# This controls how long the package management system stays locked while unused.
BackendShutdownTimeout={{ backend_shutdown_timeout | default(5) }}

# Time in seconds to wait before shutting down the daemon when idle.
# Set to 0 to disable automatic shutdown.
ShutdownTimeout={{ shutdown_timeout | default(300) }}

# Whether to keep downloaded package files in the cache after installation.
# If true, downloaded .deb/.rpm files are retained; if false, they are deleted.
KeepCache={{ keep_cache | default(false) | lower }}