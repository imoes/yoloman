# Command-not-found handler configuration for PackageKit
# Enables/disables the command-not-found handler
CommandNotFound={{ command_not_found_enabled | string | lower }}

# Path to the command-not-found handler script
CommandNotFoundPath={{ command_not_found_path }}

# Maximum number of concurrent command-not-found lookups
MaxConcurrentLookups={{ max_concurrent_lookups }}

# List of allowed package sources for command-not-found lookups
# (Leave empty to allow all sources)
{% if allowed_sources | length > 0 %}
AllowedSources={{ allowed_sources | join(', ') }}
{% else %}
AllowedSources=
{% endif %}

# Timeout (in seconds) for each command-not-found lookup
LookupTimeout={{ lookup_timeout }}

# Enable verbose logging for command-not-found lookups
Verbose={{ verbose | string | lower }}