# core dump configuration template
# This config controls system-wide core dump behavior via kernel sysctl parameters.

# Controls naming of core dump files: specifies a template for the core dump filename.
# It supports % specifiers (e.g., %p for PID, %e for executable name) and can pipe to a handler.
kernel.core_pattern = {{ core_pattern }}

# If nonzero, appends .PID to core filename when core_pattern lacks %p and the pattern is simple.
# Deprecated in favor of embedding %p directly in core_pattern, but still effective.
kernel.core_uses_pid = {{ core_uses_pid }}

# Controls dumping behavior for privileged/setuid programs:
#   0 = never dump (default for security)
#   1 = dump if process is dumpable (traditional)
#   2 = always dump (suidsafe mode — core_pattern must be absolute or pipe)
kernel.suid_dumpable = {{ suid_dumpable }}

# Limits concurrent pipe-core handlers running in parallel when core_pattern pipes to a program.
# Value >0 caps concurrency; 0 means unlimited concurrency but no waiting (handlers may miss /proc access).
kernel.core_pipe_limit = {{ core_pipe_limit }}

# Controls which memory mappings are included in the core dump (bitmask):
#   bit 0: anonymous private, bit 1: anonymous shared,
#   bit 2: file-backed private, bit 3: file-backed shared,
#   bit 4: ELF headers, bits 5-8: huge/DAX pages.
# Default: 0x33 (bits 0,1,4,5 set unless config omits ELF headers).
# This is a system-wide default (can be overridden per-process via /proc/pid/coredump_filter).
vm.core_dump_filter = {{ core_dump_filter }}

# Optional: If using systemd-coredump, this path shows where dumps are stored.
# Not a sysctl — for documentation only. Typically /var/lib/systemd/coredump/.
# {{ systemd_coredump_dir | default('# Systemd core dumps are stored in: /var/lib/systemd/coredump/') }}
