{
  "sieve_global": false,
  "sieve_global_script": "",
  "sieve_global_script_dir": "/var/lib/dovecot/sieve/global/",
  "sieve_user_script": "file:~/.dovecot.sieve",
  "sieve_user_script_dir": "~/.dovecot.sieve.d/",
  "sieve_before": "/etc/dovecot/sieve/before-spam.sieve",
  "sieve_after": "/etc/dovecot/sieve/after-archive.sieve",
  "sieve_max_script_size": 65536,
  "sieve_max_scripts": 25,
  "sieve_max_personal_scripts": 20,
  "sieve_extensions": [
    "fileinto",
    "reject",
    "envelope",
    "vacation",
    "imapflags",
    "include",
    "variables",
    "date",
    "editheader",
    "copy"
  ],
  "sieve_debug": false,
  "sieve_storage": "maildir",
  "sieve_global_scripts_dir": "",
  "sieve_include": {
    "sieve_trace_dir": "/var/log/dovecot/sieve-trace/",
    "sieve_quota_max_scripts": "15"
  }
}
