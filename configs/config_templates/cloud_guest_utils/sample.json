{
  "datasource_list": [
    "Ec2",
    "OpenStack",
    "NoCloud",
    "None"
  ],
  "growpart_mode": "auto",
  "growpart_devices": [
    "/",
    "/var"
  ],
  "growpart_ignore_disabled": false,
  "resize_rootfs": "noblock",
  "disable_root": true,
  "preserve_hostname": false,
  "manage_etc_hosts": false,
  "default_user": {
    "name": "ubuntu",
    "gecos": "Ubuntu",
    "lock_passwd": true,
    "shell": "/bin/bash",
    "groups": [
      "adm",
      "audio",
      "cdrom",
      "dialout",
      "dip",
      "floppy",
      "netdev",
      "plugdev",
      "sudo",
      "video"
    ],
    "sudo_rules": [
      "ALL=(ALL) NOPASSWD:ALL"
    ]
  },
  "ntp_enabled": true,
  "ntp_servers": [
    "0.de.pool.ntp.org",
    "1.de.pool.ntp.org",
    "2.de.pool.ntp.org"
  ],
  "cloud_config_modules": [
    "growpart",
    "resizefs",
    "set_hostname",
    "update_hostname",
    "users-groups",
    "ssh",
    "ntp"
  ],
  "cloud_final_modules": [
    "scripts-vendor",
    "scripts-per-once",
    "scripts-per-boot",
    "scripts-per-instance",
    "scripts-user",
    "final-message"
  ]
}
