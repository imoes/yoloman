{
  "site_root": {
    "type": "string",
    "default": "/home/user/my_site",
    "description": "The root directory of the Nanoc site"
  },
  "output_dir": {
    "type": "string",
    "default": "public",
    "description": "The directory where the compiled site is placed"
  },
  "env": {
    "type": "string",
    "default": "development",
    "description": "The environment used during compilation"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debugging mode"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output"
  },
  "color": {
    "type": "bool",
    "default": true,
    "description": "Enable color in output"
  },
  "warn": {
    "type": "bool",
    "default": true,
    "description": "Enable warnings"
  },
  "no_color": {
    "type": "bool",
    "default": false,
    "description": "Disable color in output"
  },
  "items": {
    "type": "list",
    "default": [],
    "description": "List of items to compile"
  },
  "plugins": {
    "type": "list",
    "default": [],
    "description": "List of plugins to load"
  }
}
