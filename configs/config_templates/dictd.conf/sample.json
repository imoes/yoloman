{
  "base_dir": "/usr/share/dictd",
  "port": 2628,
  "socket": "/var/run/dictd/dictd.sock",
  "workers": 4,
  "maxconn": 100,
  "log_level": "warn",
  "log_file": "/var/log/dictd.log",
  "indexing": true,
  "client_timeout": 30,
  "default_dict": "web1913",
  "allow": [
    {
      "host": "127.0.0.1"
    },
    {
      "host": "192.168.1",
      "netmask": 24
    }
  ],
  "deny": [
    {
      "host": "10.0.0.1"
    }
  ],
  "verbose_log": false,
  "compression": true,
  "dictionaries": [
    {
      "name": "wn",
      "datafile": "/usr/share/dictd/wn/data",
      "index": "/usr/share/dictd/wn/index",
      "desc": "WordNet\u00ae 3.0"
    },
    {
      "name": "web1913",
      "datafile": "/usr/share/dictd/web1913/data",
      "index": "/usr/share/dictd/web1913/index",
      "desc": "Webster\u2019s Revised Unabridged Dictionary (1913)"
    },
    {
      "name": "jargon",
      "datafile": "/usr/share/dictd/jargon/data",
      "index": "/usr/share/dictd/jargon/index",
      "mime_type": "text/x-jargon"
    }
  ]
}
