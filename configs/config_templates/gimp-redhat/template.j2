# GIMP Controller Configuration
# This template configures GIMP's external controller support (keyboard, mouse wheel, etc.).
# It generates the `controllerrc` file structure expected by GIMP's controller subsystem.

(GimpControllerInfo "Main Mouse Wheel"
    # Enable the main mouse wheel controller.
    # Default: yes
    (enabled {{ gimp_controller_mouse_wheel_enabled | default('yes') }})

    # Enable debug event logging for the main mouse wheel controller.
    # Default: no
    (debug-events {{ gimp_controller_mouse_wheel_debug_events | default('no') }})

    # The controller type for the main mouse wheel.
    # Default: GimpControllerWheel
    (controller "{{ gimp_controller_mouse_wheel_controller | default('GimpControllerWheel') }}")

    (mapping
        # Action mapped to scroll-up-alt.
        # Default: tools-opacity-increase
        (map "scroll-up-alt"                 "{{ gimp_controller_mouse_wheel_map_scroll_up_alt | default('tools-opacity-increase') }}")

        # Action mapped to scroll-down-alt.
        # Default: tools-opacity-decrease
        (map "scroll-down-alt"               "{{ gimp_controller_mouse_wheel_map_scroll_down_alt | default('tools-opacity-decrease') }}")

        # Action mapped to scroll-up-shift-primary.
        # Default: tools-aspect-increase
        (map "scroll-up-shift-primary"       "{{ gimp_controller_mouse_wheel_map_scroll_up_shift_primary | default('tools-aspect-increase') }}")

        # Action mapped to scroll-down-shift-primary.
        # Default: tools-aspect-decrease
        (map "scroll-down-shift-primary"     "{{ gimp_controller_mouse_wheel_map_scroll_down_shift_primary | default('tools-aspect-decrease') }}")

        # Action mapped to scroll-up-shift-alt.
        # Default: tools-angle-increase
        (map "scroll-up-shift-alt"           "{{ gimp_controller_mouse_wheel_map_scroll_up_shift_alt | default('tools-angle-increase') }}")

        # Action mapped to scroll-down-shift-alt.
        # Default: tools-angle-decrease
        (map "scroll-down-shift-alt"         "{{ gimp_controller_mouse_wheel_map_scroll_down_shift_alt | default('tools-angle-decrease') }}")

        # Action mapped to scroll-up-primary-alt.
        # Default: tools-size-increase
        (map "scroll-up-primary-alt"         "{{ gimp_controller_mouse_wheel_map_scroll_up_primary_alt | default('tools-size-increase') }}")

        # Action mapped to scroll-down-primary-alt.
        # Default: tools-size-decrease
        (map "scroll-down-primary-alt"       "{{ gimp_controller_mouse_wheel_map_scroll_down_primary_alt | default('tools-size-decrease') }}")

        # Action mapped to scroll-up-shift-primary-alt.
        # Default: tools-spacing-increase
        (map "scroll-up-shift-primary-alt"   "{{ gimp_controller_mouse_wheel_map_scroll_up_shift_primary_alt | default('tools-spacing-increase') }}")

        # Action mapped to scroll-down-shift-primary-alt.
        # Default: tools-spacing-decrease
        (map "scroll-down-shift-primary-alt" "{{ gimp_controller_mouse_wheel_map_scroll_down_shift_primary_alt | default('tools-spacing-decrease') }}")
    ))

(GimpControllerInfo "Main Keyboard"
    # Enable the main keyboard controller.
    # Default: yes
    (enabled {{ gimp_controller_keyboard_enabled | default('yes') }})

    # Enable debug event logging for the main keyboard controller.
    # Default: no
    (debug-events {{ gimp_controller_keyboard_debug_events | default('no') }})

    # The controller type for the main keyboard.
    # Default: GimpControllerKeyboard
    (controller "{{ gimp_controller_keyboard_controller | default('GimpControllerKeyboard') }}")

    (mapping
        # Action mapped to cursor-up-shift.
        # Default: view-scroll-page-up
        (map "cursor-up-shift"      "{{ gimp_controller_keyboard_map_cursor_up_shift | default('view-scroll-page-up') }}")

        # Action mapped to cursor-down-shift.
        # Default: view-scroll-page-down
        (map "cursor-down-shift"    "{{ gimp_controller_keyboard_map_cursor_down_shift | default('view-scroll-page-down') }}")

        # Action mapped to cursor-left-shift.
        # Default: view-scroll-page-left
        (map "cursor-left-shift"    "{{ gimp_controller_keyboard_map_cursor_left_shift | default('view-scroll-page-left') }}")

        # Action mapped to cursor-right-shift.
        # Default: view-scroll-page-right
        (map "cursor-right-shift"   "{{ gimp_controller_keyboard_map_cursor_right_shift | default('view-scroll-page-right') }}")

        # Action mapped to cursor-up-primary.
        # Default: view-scroll-top-border
        (map "cursor-up-primary"    "{{ gimp_controller_keyboard_map_cursor_up_primary | default('view-scroll-top-border') }}")

        # Action mapped to cursor-down-primary.
        # Default: view-scroll-bottom-border
        (map "cursor-down-primary"  "{{ gimp_controller_keyboard_map_cursor_down_primary | default('view-scroll-bottom-border') }}")

        # Action mapped to cursor-left-primary.
        # Default: view-scroll-left-border
        (map "cursor-left-primary"  "{{ gimp_controller_keyboard_map_cursor_left_primary | default('view-scroll-left-border') }}")

        # Action mapped to cursor-right-primary.
        # Default: view-scroll-right-border
        (map "cursor-right-primary" "{{ gimp_controller_keyboard_map_cursor_right_primary | default('view-scroll-right-border') }}")

        # Action mapped to cursor-up-alt.
        # Default: tools-size-increase-skip
        (map "cursor-up-alt"        "{{ gimp_controller_keyboard_map_cursor_up_alt | default('tools-size-increase-skip') }}")

        # Action mapped to cursor-down-alt.
        # Default: tools-size-decrease-skip
        (map "cursor-down-alt"      "{{ gimp_controller_keyboard_map_cursor_down_alt | default('tools-size-decrease-skip') }}")

        # Action mapped to cursor-left-alt.
        # Default: tools-size-decrease
        (map "cursor-left-alt"      "{{ gimp_controller_keyboard_map_cursor_left_alt | default('tools-size-decrease') }}")

        # Action mapped to cursor-right-alt.
        # Default: tools-size-increase
        (map "cursor-right-alt"     "{{ gimp_controller_keyboard_map_cursor_right_alt | default('tools-size-increase') }}")
    ))

