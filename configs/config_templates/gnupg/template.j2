; GnuPG configuration file for libgnupg-perl (or similar wrapper)
; This template generates a simple key-value configuration file.

; Path to the gpg executable.
; Default: /usr/bin/gpg
gnupg_path = {{ gnupg_path | default('/usr/bin/gpg') }}

; Path to the gpg options file.
; Default: ~/.gnupg/options
options = {{ options | default('~/.gnupg/options') }}

; Path to the GnuPG home directory (contains keyrings, trustdb, etc.).
; Default: ~/.gnupg
homedir = {{ homedir | default('~/.gnupg') }}

; Enable debug tracing to stderr.
; Accepts true or false. Converted to lowercase.
; Default: False
trace = {{ trace | default(False) | lower }}