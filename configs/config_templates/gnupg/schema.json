{
  "gnupg_path": {
    "type": "string",
    "default": "/usr/bin/gpg",
    "description": "Path to the gpg executable"
  },
  "options": {
    "type": "string",
    "default": "~/.gnupg/options",
    "description": "Path to the gpg options file"
  },
  "homedir": {
    "type": "string",
    "default": "~/.gnupg",
    "description": "Path to the GnuPG home directory (contains keyrings, trustdb, etc.)"
  },
  "trace": {
    "type": "bool",
    "default": false,
    "description": "Enable debug tracing to stderr (true/false)"
  }
}
