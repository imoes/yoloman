{
  "ext_ifname": "eth0",
  "enable_natpmp": true,
  "enable_upnp": true,
  "log_level": 2,
  "ssdp_broadcast_interval": 30,
  "friendly_name": "Home Router",
  "model_name": "ACME Home Gateway",
  "model_url": "https://example.com/router",
  "manufacturer": "ACME Electronics",
  "manufacturer_url": "https://example.com",
  "serial_number": "SN123456789",
  "port_mappings": [
    {
      "external_port": 80,
      "internal_ip": "192.168.1.10",
      "internal_port": 80,
      "protocol": "TCP",
      "description": "Web server",
      "enabled": true
    },
    {
      "external_port": 22,
      "internal_ip": "192.168.1.20",
      "internal_port": 22,
      "protocol": "TCP",
      "description": "SSH",
      "enabled": false
    }
  ],
  "port_ranges": [
    {
      "start": 49152,
      "end": 65535,
      "protocol": "TCP",
      "description": "Dynamic TCP services"
    },
    {
      "start": 49152,
      "end": 65535,
      "protocol": "UDP",
      "description": "Dynamic UDP services"
    }
  ],
  "allowed_ips": [
    "192.168.1.0/24"
  ]
}
