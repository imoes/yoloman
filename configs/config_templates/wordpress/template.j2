# ==============================================================================
# WordPress .htaccess Configuration
# ==============================================================================
# This file contains rewrite rules for WordPress permalink structures.
# It is typically placed in the root directory of the WordPress installation.
#
# NOTE: This template is for the .htaccess file used by Apache/WordPress.
# It does NOT contain PHP configuration variables (like DB credentials).
# Those are configured in wp-config.php.
##
## Configuration for a single blog hosted on / (root of the website)
##
# Enable the rewrite engine to handle pretty permalinks.
# RewriteBase / sets the base path for relative rewrites.
# This block is static for standard WordPress installations.
<IfModule mod_rewrite.c>
    # RewriteEngine is a global directive, but often enabled per-directory.
    RewriteEngine On
    # Set the base URL for relative rewrites.
    RewriteBase /

    # If the requested filename is not a real file...
    RewriteCond %{REQUEST_FILENAME} !-f
    # ...or not a real directory...
    RewriteCond %{REQUEST_FILENAME} !-d
    # ...send the request to index.php for WordPress to handle.
    RewriteRule . /index.php [L]
</IfModule>

##
## Configuration for a multi-site wordpress installation using subdomains
##
# Multi-site rewrite rules differ slightly to handle network files and uploads.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If the request is for the main index.php, serve it directly.
    RewriteRule ^index\.php$ - [L]

    ## uploaded files
    # Route requests for files to the multi-site upload handler.
    RewriteRule ^files/(.+) wp-includes/ms-files.php?file=$1 [L]

    ## real files dealt directly
    # If the request is for an existing file...
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    # ...or an existing directory...
    RewriteCond %{REQUEST_FILENAME} -d
    # ...serve it directly and stop processing further rewrites.
    RewriteRule ^ - [L]

    ## other go through index.php
    # All other requests are sent to index.php.
    RewriteRule . index.php [L]
</IfModule>
