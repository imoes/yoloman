{
  "bind_address": "10.0.0.5",
  "port": 3142,
  "log_dir": "/var/log/apt-cacher",
  "cache_dir": "/var/cache/apt-cacher",
  "log_level": 2,
  "log_format": "combined",
  "allow_remote_requests": true,
  "allowed_clients": [
    "10.0.0.0/24",
    "192.168.1.0/24"
  ],
  "allowed_hosts": [],
  "max_threads": 16,
  "min_free_space_mb": 2048,
  "devuan_support": true,
  "ignore_expire": false,
  "max_age_days": 30,
  "remap_debian": "http://ftp.us.debian.org/debian/",
  "remap_ubuntu": "http://archive.ubuntu.com/ubuntu/",
  "remap_backports": "",
  "remap_security": "http://security.debian.org/",
  "compression": true,
  "compression_type": "gzip",
  "upstream_proxy": "",
  "upstream_proxy_auth": "",
  "exclusions": [
    {
      "pattern": "*/pool/debug/*",
      "description": "Skip caching debug symbol packages"
    },
    {
      "pattern": "*/dists/*/main/debian-installer/*",
      "description": "Skip installer images (large & rarely cached)"
    }
  ],
  "repo_overrides": [
    {
      "name": "private",
      "enabled": true,
      "base_url": "http://pkg.internal.repo/private/",
      "suite_map": "stable=bookworm",
      "arch_map": "amd64=amd64"
    }
  ]
}
