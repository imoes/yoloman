# qBittorrent-nox daemon configuration
# This template configures the qBittorrent-nox service.
# It controls whether the process runs as a background daemon
# and defines the port for the Web UI interface.

# ---------------------------------------------------------------------------
# Daemon Mode
# ---------------------------------------------------------------------------
# Enable daemon mode to run qbittorrent-nox in the background.
# When true, the application detaches from the terminal and runs as a
# background service.
#
# Schema default: true
# ---------------------------------------------------------------------------
DAEMON_ENABLED: {{ daemon_enabled | default(true) }}

# ---------------------------------------------------------------------------
# Web UI Port
# ---------------------------------------------------------------------------
# The port number for the Web UI interface.
# This is the port where the web-based management console listens.
# Ensure this port is accessible via your firewall if remote access is required.
#
# Schema default: 8080
# ---------------------------------------------------------------------------
WEBUI_PORT: {{ webui_port | default(8080) }}