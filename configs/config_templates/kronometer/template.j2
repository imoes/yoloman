# {{ app_name | default('kronometer') }} Configuration
# ---------------------------------------------------------------
# This template generates the configuration file for the Kronometer
# stopwatch application. It uses the INI-like format expected by
# the application. Every setting is self-documented with a comment
# derived from the schema description, and every variable is
# safeguarded with a default value to prevent rendering errors.

# General Settings
[General]

# Time format granularity for the stopwatch display (e.g., HH:MM:SS.mmm)
# Schema field: time_format
time_format={{ time_format | default('HH:MM:SS.zzz') }}

# Default font family for stopwatch digits
# Schema field: digit_font
digit_font={{ digit_font | default('Sans Serif') }}

# Default font size for stopwatch digits in points
# Schema field: digit_font_size
digit_font_size={{ digit_font_size | default(48) }}

# Text color for stopwatch digits (HTML hex color)
# Schema field: digit_color
digit_color={{ digit_color | default('#000000') }}

# Background color for the stopwatch widget (HTML hex color)
# Schema field: background_color
background_color={{ background_color | default('#FFFFFF') }}

# Automatically save stopwatch status on application exit
# Schema field: autosave
# Note: Using Jinja native boolean/ternary to ensure valid config output (true/false)
autosave={{ autosave | default(true) | ternary('true', 'false') }}

[Export]

# Default directory for exporting lap times data
# Schema field: export_dir
export_dir={{ export_dir | default('/tmp/kronometer_exports') }}

# Default file format for exporting lap times (json or csv)
# Schema field: default_export_format
default_export_format={{ default_export_format | default('csv') }}