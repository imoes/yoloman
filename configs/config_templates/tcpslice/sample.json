{
  "output_file": "./merged_traffic.pcap",
  "input_files": [
    "/var/log/pcap/capture1.pcap",
    "/var/log/pcap/capture2.pcap"
  ],
  "start_time": "+0",
  "end_time": "+3600",
  "keep_duplicates": true,
  "relative_merge": false,
  "session_types": "tcp,sip",
  "session_expire_seconds": 300,
  "verbosity": 1
}
