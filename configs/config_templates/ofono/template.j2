<!--
  oFono D-Bus System Bus Configuration
  ====================================
  This template generates the D-Bus system bus configuration file for oFono.
  It defines security policies allowing the root user to own and communicate
  with the oFono D-Bus service, while restricting access for other users.

  This configuration is typically placed at /etc/dbus-1/system.d/ofono.conf
  or included by /etc/dbus-1/system.conf.
-->

<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>

  <!--
    Policy for the privileged system user.
    Allows this user to own the oFono service and send messages to it.
    By default, this is 'root'.
  -->
  <policy user="{{ ofono_dbus_root_user | default('root') }}">
    <!-- Allow the user to claim the oFono service name -->
    <allow own="{{ ofono_dbus_service_name | default('org.ofono') }}"/>
    <!-- Allow the user to send messages to the oFono service -->
    <allow send_destination="{{ ofono_dbus_service_name | default('org.ofono') }}"/>
    <!-- Allow interaction with SIM Toolkit agents -->
    <allow send_interface="org.ofono.SimToolkitAgent"/>
    <!-- Allow interaction with Push Notification agents -->
    <allow send_interface="org.ofono.PushNotificationAgent"/>
    <!-- Allow interaction with Smart Messaging agents -->
    <allow send_interface="org.ofono.SmartMessagingAgent"/>
    <!-- Allow interaction with Positioning Request agents -->
    <allow send_interface="org.ofono.PositioningRequestAgent"/>
    <!-- Allow interaction with Handsfree Audio agents -->
    <allow send_interface="org.ofono.HandsfreeAudioAgent"/>
    <!-- Allow interaction with Network Monitor agents -->
    <allow send_interface="org.ofono.NetworkMonitorAgent"/>
    <!-- Allow interaction with Intel LTE Coexistence agents -->
    <allow send_interface="org.ofono.intel.LteCoexistenceAgent"/>
  </policy>

  <!--
    Policy for users at the physical console.
    Allows console users to send messages to the oFono service.
    This enables local graphical applications to interact with oFono.
  -->
  <policy at_console="true">
    <allow send_destination="{{ ofono_dbus_service_name | default('org.ofono') }}"/>
  </policy>

  <!--
    Default policy for all other users/sessions.
    Denies access to the oFono service unless explicitly allowed above.
    This ensures security by restricting D-Bus access to authorized contexts only.
  -->
  <policy context="default">
    <deny send_destination="{{ ofono_dbus_service_name | default('org.ofono') }}"/>
  </policy>

</busconfig>
