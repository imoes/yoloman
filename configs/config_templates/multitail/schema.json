{
  "defaultcscheme": {
    "type": "string",
    "default": "syslog",
    "description": "Selects the default color scheme to use.",
    "enum": [
      "syslog",
      "zarafa",
      "weblogic",
      "goldengate",
      "ssh",
      "powerdns",
      "uucp",
      "logcat",
      "liniptfw",
      "postfix",
      "apache",
      "apache_error",
      "rsstail",
      "acctail",
      "wtmptail",
      "squid",
      "asterisk",
      "sendmail",
      "mailscanner",
      "spamassassin",
      "clamav",
      "samba",
      "audit",
      "exim",
      "httping",
      "netstat",
      "tcpdump",
      "dhcpd",
      "bind",
      "smartd",
      "kerberos"
    ]
  },
  "global_default_nkb": {
    "type": "string",
    "default": "1MB",
    "description": "Default number of kilobytes to buffer globally."
  },
  "check_mail": {
    "type": "number",
    "default": 0,
    "description": "How often to check for mail in seconds. Set to 0 to disable."
  },
  "tab_stop": {
    "type": "number",
    "default": 8,
    "description": "Width of TAB characters in spaces."
  },
  "shell": {
    "type": "string",
    "default": "/bin/sh",
    "description": "Shell to use when invoking programs."
  },
  "umask": {
    "type": "string",
    "default": "0022",
    "description": "Umask used when creating files."
  }
}
