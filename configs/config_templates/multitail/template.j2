# ==========================================================================
# Multitail Configuration Template
# This file configures the multitail log viewer.
# It defines color schemes, default behaviors, and operational parameters.
# Generated by Ansible. Do not edit manually.
# ==========================================================================

# --- Global Defaults & Operational Parameters ---

# defaultcscheme:<name of colorscheme>
# Selects the default color scheme to use.
defaultcscheme:{{ defaultcscheme | default('syslog') }}

# global_default_nkb:<number of kilobytes>
# Default number of kilobytes to buffer globally.
global_default_nkb:{{ global_default_nkb | default('1MB') }}

# check_mail:<seconds>
# How often to check for mail in seconds. Set to 0 to disable.
check_mail:{{ check_mail | default(0) }}

# tab_stop:<number of spaces>
# Width of TAB characters in spaces.
tab_stop:{{ tab_stop | default(8) }}

# shell:<path>
# Shell to use when invoking programs.
shell:{{ shell | default('/bin/sh') }}

# umask:<mask>
# Umask used when creating files.
umask:{{ umask | default('0022') }}

# --- Color Schemes ---

# The following sections define colorschemes (cs_re, colorscheme, etc.).
# These are largely static examples provided by multitail.
# Variable injection is primarily handled via the global parameters above.
# If specific scheme variables are added to the schema in the future,
# they should be injected here using the pattern:
# directive:{{ variable | default('default_value') }}

# default colorschemes:
scheme:uucp:/var/log/uucp/
scheme:zarafa:/var/log/zarafa/
scheme:postfix:/var/log/mail/
scheme:sendmail:/var/log/mail/
scheme:exim:/var/log/mail/
scheme:apache:/var/log/apache/.*access
scheme:apache:/var/log/lighttpd/.*access
scheme:apache_error:/var/log/apache/.*error
scheme:asterisk:/var/log/asterisk/messages
scheme:samba:/var/log/samba/
scheme:squid:/var/log/squid/
scheme:squid:/var/log/squid3/
scheme:openhab:/var/log/openhab2/
scheme:proftpd:xferlog
scheme:syslog,ssh:/var/log/
scheme:vnetbr:bplog.rest
scheme:procmail:procmail.log
scheme:inn:/var/log/news/
scheme:snort:/var/log/snort/alert
scheme:boinc:/var/lib/boinc-client/std...dae.txt
scheme:qmt-send:/var/log/qmail/send/current
scheme:qmt-smtp:/var/log/qmail/smtp/current
scheme:qmt-smtp:/var/log/qmail/submission/current
scheme:qmt-clamd:/var/log/qmail/clamd/current
scheme:qmt-spamassassin:/var/log/qmail/spam/current
scheme:qmt-sophie:/var/log/qmail/sophie/current
scheme:honeypots:/var/log/honeypots/
scheme:f2b:/var/log/fail2ban.log
scheme:kodi:kodi.log
scheme:uwsgi:/var/log/uwsgi
# the following line is to show you that colorscripts can be used the same way as colorschemes
scheme:cscriptexample:/dev/null

# --- End of Template ---