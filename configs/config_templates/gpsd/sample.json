{
  "start_gpsd": true,
  "devices": [
    "/dev/ttyUSB0",
    "/dev/ttyACM1"
  ],
  "serial_options": "4800,8,N,1",
  "gpsd_options": "-n -b",
  "output_format": "json",
  "user": "gpsd",
  "group": "tty",
  "socket": "/var/run/gpsd.sock",
  "pps_enable": true,
  "shm_enable": true,
  "allowed_clients": "chrony,ntp"
}
