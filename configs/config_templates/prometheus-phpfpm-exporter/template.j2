# Command-line arguments passed to the prometheus-php-fpm-exporter process.
# This is the single point of configuration for the exporter's runtime behavior,
# allowing users to specify backend connections (e.g., php-fpm sockets), listen addresses,
# and other server-side options supported by the binary.
# Example: 'php-fpm-sock=/run/php/php8.2-fpm.sock'
ARGS="{{ (prometheus_php_fpm_exporter_args | default('')) }}"