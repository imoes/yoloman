{
  "auto_unique_complete": true,
  "classic_list": false,
  "classic_list_format": "${position}: ${artist} - ${title}",
  "guess_pls": false,
  "history_file": "~/.cache/xmms2/nyxmms2_history",
  "playlist_marker": ">>",
  "prompt": "xmms2> ",
  "server_autostart": true,
  "shell_start_message": true,
  "status_format": "${artist} - ${title} [${duration}]",
  "aliases": [
    {
      "name": "addpls",
      "command": "add -f -P $@"
    },
    {
      "name": "clear",
      "command": "playlist clear"
    },
    {
      "name": "status",
      "command": "current -f $1"
    },
    {
      "name": "ls",
      "command": "list"
    },
    {
      "name": "mute",
      "command": "server volume 0"
    },
    {
      "name": "quit",
      "command": "server shutdown"
    },
    {
      "name": "repeat",
      "command": "seek 0"
    },
    {
      "name": "scap",
      "command": "stop ; playlist clear ; add $@ ; play"
    }
  ]
}
