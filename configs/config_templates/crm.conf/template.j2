# CRM cluster configuration file
# Generated by Ansible from crm.conf template.
# This file configures the High Availability cluster services.
# All nodes in the cluster MUST use the exact same configuration.

# -----------------------------------------------------------------------------
# cluster_name: Name of the cluster; must be identical on all nodes.
# -----------------------------------------------------------------------------
cluster_name: {{ cluster_name | default('mycluster') }}

# -----------------------------------------------------------------------------
# stonith_enabled: Enable STONITH (fencing) for cluster safety; required for production use.
# -----------------------------------------------------------------------------
stonith_enabled: {{ stonith_enabled | default(True) | lower }}

# -----------------------------------------------------------------------------
# resource_stickiness: Resource stickiness value — higher values discourage unnecessary migrations.
# -----------------------------------------------------------------------------
resource_stickiness: {{ resource_stickiness | default(100) }}

# -----------------------------------------------------------------------------
# migration_limit: Maximum number of failed actions before resource is stopped (set to -1 for infinite).
# -----------------------------------------------------------------------------
migration_limit: {{ migration_limit | default(-1) }}

# -----------------------------------------------------------------------------
# remote_timeout: Timeout (seconds) for remote STONITH operations (e.g., fence agents).
# -----------------------------------------------------------------------------
remote_timeout: {{ remote_timeout | default(60) }}

# -----------------------------------------------------------------------------
# logging: Cluster logging configuration.
#   - file: Path to the log file.
#   - level: Logging level (e.g., info, debug, error).
#   - to_logfile: Boolean to enable logging to the file.
#   - to_syslog: Boolean to enable logging to syslog.
# -----------------------------------------------------------------------------
logging:
  file: {{ (logging | default({})).file | default('/var/log/cluster/crm.log') }}
  level: {{ (logging | default({})).level | default('info') }}
  to_logfile: {{ (logging | default({})).to_logfile | default(True) | lower }}
  to_syslog: {{ (logging | default({})).to_syslog | default(True) | lower }}

# -----------------------------------------------------------------------------
# corosync: Corosync network transport settings (required for multicast-based clusters).
#   - bindnetaddr: Network address to bind to.
#   - mcastaddr: Multicast address to use.
#   - mcastport: Multicast port to use.
#   - ttl: Time-to-live for multicast packets.
# -----------------------------------------------------------------------------
corosync:
  bindnetaddr: {{ (corosync | default({})).bindnetaddr | default('192.168.1.0') }}
  mcastaddr: {{ (corosync | default({})).mcastaddr | default('239.192.64.1') }}
  mcastport: {{ (corosync | default({})).mcastport | default('5405') }}
  ttl: {{ (corosync | default({})).ttl | default('1') }}

# -----------------------------------------------------------------------------
# nodes: List of cluster nodes (must include all nodes).
#   Each node entry requires:
#   - name: Unique node name.
#   - id: Numeric node ID.
#   - addr: IP address or hostname of the node.
# -----------------------------------------------------------------------------
{% for node in nodes | default([]) %}node:
  name: {{ node.name }}
  id: {{ node.id }}
  addr: {{ node.addr }}
{% endfor %}

# -----------------------------------------------------------------------------
# resources: Optional list of primitive resources (e.g., IPaddr2, Filesystem, Apache).
#   Each resource entry requires:
#   - type: Resource agent type.
#   - id: Unique identifier for the resource.
#   - description: Optional description.
#   - params: Optional dictionary of parameters for the resource agent.
# -----------------------------------------------------------------------------
{% for res in resources | default([]) %}resources:
  {{ res.type }}::{{ res.id }}:
    description: {{ res.description | default('') }}
    params:
{% for k, v in (res.params | default({})) | dictsort %}      {{ k }}: {{ v }}
{% endfor %}
{% endfor %}

# -----------------------------------------------------------------------------
# resource_groups: Optional list of resource groups (ordered lists of resources to colocate).
#   Each group entry requires:
#   - name: Group name.
#   - resources: List of resource IDs belonging to this group.
# -----------------------------------------------------------------------------
{% for grp in resource_groups | default([]) %}resource_groups:
  {{ grp.name }}:
    resources:
{% for r in grp.resources | default([]) %}      - {{ r }}
{% endfor %}
{% endfor %}

# -----------------------------------------------------------------------------
# colocations: Optional list of colocation constraints (resources that must run together).
#   Each colocation entry requires:
#   - id: Constraint ID.
#   - score: Score for the colocation.
#   - items: List of resources to colocate, with optional role.
#     Each item requires:
#     - resource: Resource ID.
#     - role: Optional role (master/backup).
# -----------------------------------------------------------------------------
{% for col in colocations | default([]) %}colocations:
  {{ col.id }}:
    score: {{ col.score }}
    items:
{% for item in col.items | default([]) %}      - {{ item.resource }}:{{ item.role }}
{% endfor %}
{% endfor %}

# -----------------------------------------------------------------------------
# orderings: Optional list of ordering constraints (resource startup sequence).
#   Each ordering entry requires:
#   - id: Constraint ID.
#   - score: Score for the ordering.
#   - first: The resource that must start first.
#     Requires:
#     - resource: Resource ID.
#     - role: Optional role.
#   - then: The resource that must start after the first.
#     Requires:
#     - resource: Resource ID.
#     - role: Optional role.
# -----------------------------------------------------------------------------
{% for ord in orderings | default([]) %}orderings:
  {{ ord.id }}:
    score: {{ ord.score }}
    first: {{ ord.first.resource }} ({{ ord.first.role }})
    then: {{ ord.then.resource }} ({{ ord.then.role }})
{% endfor %}

# -----------------------------------------------------------------------------
# locations: Optional list of location constraints (preferred nodes for resources).
#   Each location entry requires:
#   - id: Constraint ID.
#   - resource: Resource ID.
#   - node: Node ID where the resource is preferred.
#   - score: Score for the location preference.
# -----------------------------------------------------------------------------
{% for loc in locations | default([]) %}locations:
  {{ loc.id }}:
    resource: {{ loc.resource }}
    node: {{ loc.node }}
    score: {{ loc.score }}
{% endfor %}