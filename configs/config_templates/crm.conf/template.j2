# CRM cluster configuration file
# Generated by crmsh; do not edit directly unless you understand the implications
# Set the cluster name (must be identical on all nodes)
cluster_name: {{ cluster_name }}

# Enable or disable STONITH (fencing); required for production clusters
stonith_enabled: {{ stonith_enabled }}

# Enable or disable resource stickiness (prevents unnecessary migrations)
resource_stickiness: {{ resource_stickiness }}

# Default failure timeout (seconds) for resources
migration_limit: {{ migration_limit }}

# Default remote timeout (seconds) for STONITH operations
remote_timeout: {{ remote_timeout }}

# Logging configuration
logging:
  file: {{ logging.file }}
  level: {{ logging.level }}
  to_logfile: {{ logging.to_logfile }}
  to_syslog: {{ logging.to_syslog }}

# Corosync transport settings
corosync:
  bindnetaddr: {{ corosync.bindnetaddr }}
  mcastaddr: {{ corosync.mcastaddr }}
  mcastport: {{ corosync.mcastport }}
  ttl: {{ corosync.ttl }}

# Node definitions (each node must have a unique name and IP)
{% for node in nodes %}node:
  name: {{ node.name }}
  id: {{ node.id }}
  addr: {{ node.addr }}
{% endfor %}

# Resource definitions (optional; add only if needed)
{% if resources is defined %}resources:
{% for res in resources %}  {{ res.type }}::{{ res.id }}:
    description: {{ res.description | d('') }}
    params:
{% for k, v in res.params.items() | dictsort %}      {{ k }}: {{ v }}
{% endfor %}{% endfor %}
{% endif %}

# Resource group definitions
{% if resource_groups is defined %}resource_groups:
{% for grp in resource_groups %}  {{ grp.name }}:
    resources:
{% for r in grp.resources %}      - {{ r }}
{% endfor %}
{% endfor %}
{% endif %}

# Colocation constraints
{% if colocations is defined %}colocations:
{% for col in colocations %}  {{ col.id }}:
    score: {{ col.score }}
    items:
{% for item in col.items %}      - {{ item.resource }}:{{ item.role }}
{% endfor %}
{% endfor %}
{% endif %}

# Ordering constraints
{% if orderings is defined %}orderings:
{% for ord in orderings %}  {{ ord.id }}:
    score: {{ ord.score }}
    first: {{ ord.first.resource }} ({{ ord.first.role }})
    then: {{ ord.then.resource }} ({{ ord.then.role }})
{% endfor %}
{% endif %}

# Location constraints
{% if locations is defined %}locations:
{% for loc in locations %}  {{ loc.id }}:
    resource: {{ loc.resource }}
    node: {{ loc.node }}
    score: {{ loc.score }}
{% endfor %}
{% endif %}
