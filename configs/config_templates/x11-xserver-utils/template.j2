!
! =============================================================================
! Xvidtune Application Defaults (X Resource Database)
! =============================================================================
! This file configures the xvidtune utility (X11 X server tuning tool).
! It sets border widths, sensitivity flags, and field widths for the
! graphical interface widgets.
!
! Syntax: *resourceName: value
! Reference: https://xorg.freedesktop.org/
! =============================================================================

! Whether the application is installed / active.
! Default: True
*adInstalled: {{ adInstalled | default(True) }}

! Default border width for all top-level widgets.
! Default: 0
*borderWidth: {{ borderWidth | default(0) }}

! Border width for Scrollbar widgets.
! Default: 1
*Scrollbar.borderWidth: {{ scrollbar_border_width | default(1) }}

! Width (thickness) for Scrollbar widgets.
! Default: 250
*Scrollbar.width: {{ scrollbar_width | default(250) }}

! Border width for Command widgets.
! Default: 1
*Command.borderWidth: {{ command_border_width | default(1) }}

! Border width for the Flags text input widget.
! Default: 1
*Flags-text.borderWidth: {{ flags_text_border_width | default(1) }}

! Whether the Flags text field is sensitive (editable).
! If False, the field is read-only.
! Default: False
*Flags-text*sensitive: {{ flags_text_sensitive | default(False) }}

! Border width for the AutoApply toggle widget.
! Default: 1
*AutoApply-toggle.borderWidth: {{ autoapply_toggle_border_width | default(1) }}

! Border width for the InvertVclk toggle widget.
! Default: 1
*InvertVclk-toggle.borderWidth: {{ invertvclk_toggle_border_width | default(1) }}

! Border width for the EarlySc toggle widget.
! Default: 1
*EarlySc-toggle.borderWidth: {{ earlysc_toggle_border_width | default(1) }}

! Border width for the Blank1 text input widget.
! Default: 1
*Blank1-text.borderWidth: {{ blank1_text_border_width | default(1) }}

! Border width for the Blank2 text input widget.
! Default: 1
*Blank2-text.borderWidth: {{ blank2_text_border_width | default(1) }}

! Width of the Blank1 text input field.
! Default: 20
*Blank1-text*width: {{ blank1_text_width | default(20) }}

! Width of the Blank2 text input field.
! Default: 20
*Blank2-text*width: {{ blank2_text_width | default(20) }}

! =============================================================================
! Widget Layout & Connections (Form Geometry)
! =============================================================================
! The following lines define how widgets are arranged relative to each other
! using the Xaw Form geometry manager.
!
! HSync/HTotal/VSync/VTotal Forms and Text fields are interconnected.
! =============================================================================

*HSyncStart-form.fromVert: HDisplay-form
*HSyncEnd-form.fromVert: HSyncStart-form
*HTotal-form.fromVert: HSyncEnd-form
*VSyncStart-form.fromVert: VDisplay-form
*VSyncEnd-form.fromVert: VSyncStart-form
*VTotal-form.fromVert: VSyncEnd-form
*Flags-form.fromVert: HTotal-form
*Buttons-form.fromVert: Flags-form
*Buttons2-form.fromVert: Buttons-form
*Left-button.fromVert: HTotal-scrollbar
*Right-button.fromVert: HTotal-scrollbar
*Narrower-button.fromVert: HTotal-scrollbar
*Wider-button.fromVert: HTotal-scrollbar
*Up-button.fromVert: VTotal-scrollbar
*Down-button.fromVert: VTotal-scrollbar
*Shorter-button.fromVert: VTotal-scrollbar
*Taller-button.fromVert: VTotal-scrollbar

! Horizontal connections for text fields and their labels/scrollbars.
*HDisplay-text.fromHoriz: HDisplay-label
