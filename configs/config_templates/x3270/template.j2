# ==============================================================================
# x3270 User Configuration Template
# ==============================================================================
# This file configures the x3270 terminal emulator for connecting to mainframe
# sessions via TN3270/TN3270E protocols.
#
# Self-documenting: every directive is prefixed with its schema description.
# All variables use | default() to ensure safe rendering with undefined Ansible vars.
# ==============================================================================

# --- General Connection Settings ---

# The default host address to connect to if none is provided on the command line.
DefaultHost={{ default_host | default('localhost') }}

# The default TCP port number for the TN3270 service.
DefaultPort={{ default_port | default(23) }}

# Enable TN3270 Extended Protocol support (RFC 2355).
# TN3270E allows for logical unit (LU) negotiation and extended data stream capabilities.
EnableTN3270E={{ enable_tn3270e | default(true) | lower }}

# --- Display Settings ---

# The X11 font specification to use for rendering the 3270 terminal screen.
# Examples: 'fixed', '7x13', 'x3270-8'.
Font={{ font | default('x3270-8') }}

# --- Connection Priorities ---

# A list of host connection strings to prioritize. Each item is a string in
# the format 'hostname' or 'hostname:port'.
# These hosts are attempted in order before falling back to DefaultHost.
Hosts={{ hosts | default(['mainframe.example.com']) | join(' ') }}