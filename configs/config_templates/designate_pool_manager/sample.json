{
  "pool_default_target": "http://localhost:5358",
  "workers": 2,
  "healthcheck_interval": 30,
  "healthcheck_timeout": 5,
  "healthcheck_max_retries": 3,
  "retry_interval": 2,
  "retry_max_interval": 60,
  "log_level": "INFO",
  "pid_file": "/var/run/designate/pool_manager.pid",
  "rpc_backend": "rabbit",
  "rpc_response_timeout": 60,
  "amqp_url": "amqp://designate:secretpw@192.168.1.10:5672//",
  "ca_cert": "/etc/ssl/certs/ca-certificates.crt",
  "cert_file": "/etc/designate/ssl/client.crt",
  "key_file": "/etc/designate/ssl/client.key",
  "rate_limit": 100,
  "providers": [
    {
      "name": "pdns-primary",
      "type": "powerdns",
      "urls": [
        "http://pdns1.example.com:8080",
        "http://pdns2.example.com:8080"
      ]
    },
    {
      "name": "bind-backup",
      "type": "bind9",
      "urls": [
        "http://bind1.example.com:5358"
      ]
    }
  ]
}
