{
  "prefix": {
    "type": "string",
    "default": "/usr",
    "description": "Installation prefix directory."
  },
  "exec_prefix": {
    "type": "string",
    "default": "/usr",
    "description": "Executable installation prefix directory."
  },
  "datarootdir": {
    "type": "string",
    "default": "/usr/share",
    "description": "Read-only architecture-independent data root."
  },
  "grub_default": {
    "type": "string",
    "default": "0",
    "description": "Default GRUB menu entry index."
  },
  "grub_timeout": {
    "type": "number",
    "default": 5,
    "description": "Timeout for GRUB menu in seconds."
  },
  "grub_gfxmode": {
    "type": "string",
    "default": "auto",
    "description": "GRUB graphics mode resolution."
  }
}
