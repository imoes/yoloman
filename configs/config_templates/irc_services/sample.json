{
 "admin": {
  "email": "ops@example.net",
  "name": "Example Network Ops Team"
 },
 "database": {
  "module": "moddatabase_sqlite3",
  "params": {
   "database": "/var/lib/anope/anope.db"
  }
 },
 "defaults": {
  "user": {
   "max_channels_per_user": 10,
   "max_chans": 50,
   "max_nicks": 1
  }
 },
 "language": "en",
 "modules": {
  "load": [
   "nickserv",
   "chanserv",
   "operserv",
   "memoserv",
   "helpserv",
   "ghostserv"
  ]
 },
 "opers": [
  {
   "host": "*!*@admin.example.net",
   "name": "Admin",
   "nick": "Admin",
   "password": "admin123",
   "user": "admin"
  },
  {
   "host": "*!*@support.example.net",
   "name": "Support",
   "password": "support123",
   "vhost": "support@example.net"
  }
 ],
 "options": {
  "log_snoops": false,
  "send_core_dump": false,
  "send_oper_notice": true,
  "send_operwall": true
 },
 "server": {
  "hostname": "127.0.0.1",
  "name": "services.example.net",
  "password": "SuperSecretLinkPassword",
  "port": 7000,
  "ssl": false
 },
 "servicename": "services.example.net",
 "timeout": {
  "connection_timeout": 30,
  "dead_link_timeout": 120
 }
}
