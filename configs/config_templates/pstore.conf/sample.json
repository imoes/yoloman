{
  "max_msg_size": 65536,
  "compress": true,
  "backend": "yes",
  "compress_algorithm": "zstd",
  "mount_path": "/sys/fs/pstore",
  "max_entries": 50,
  "log_level": 2,
  "keep_keys": [
    "dmesg",
    "pmsg",
    "console"
  ],
  "ignore_keys": [
    "efi",
    "unknown"
  ],
  "subsystems": [
    "dell_rbu"
  ]
}
