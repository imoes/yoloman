[# pstore.conf — systemd’s pstore backend configuration]
[# Controls what gets stored in persistent storage (pstore) after a crash]

[DEFAULT]
# Maximum size (in bytes) of pstore per message; larger messages are truncated
max_msg_size = {{ max_msg_size }}

# Whether to compress entries before storing (true/false)
compress = {{ compress }}

# Backend-specific options; set to 'yes' to enable pstore backend
backend = {{ backend }}

[# Compression-related settings]
# Algorithm used for compression (e.g., 'lz4', 'zstd', 'none')
compress_algorithm = {{ compress_algorithm }}

[# Filesystem mount options]
# Path where pstore is mounted (usually /sys/fs/pstore)
mount_path = {{ mount_path }}

[# Retention policy]
# Maximum number of pstore entries to retain; older entries are purged
max_entries = {{ max_entries }}

[# Logging verbosity (0–3); higher values increase debug output]
log_level = {{ log_level }}

[# Whitelist of crash info keys to preserve (comma-separated list)
# Keys not in this list may be discarded to reduce size]
keep_keys = {{ keep_keys | join(', ') }}

[# Blacklist of crash info keys to ignore (comma-separated list)
# Takes precedence over keep_keys]
ignore_keys = {{ ignore_keys | join(', ') }}

[# Additional pstore subsystems to enable explicitly]
# Each item in this list corresponds to a subsystem (e.g., 'efi', 'dell_rbu')
{% for subsystem in subsystems %}enable_{{ subsystem }} = true
{% endfor %}