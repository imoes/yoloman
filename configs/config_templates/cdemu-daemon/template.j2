[settings]
# Number of virtual devices to register and control
# Schema: num_devices | default: 1 | desc: Number of virtual devices to register and control (manpage: --num-devices)
num-devices={{ num_devices | default(1) }}

# Path to the control device provided by the kernel module
# Schema: ctl_device | default: /dev/vhba_ctl | desc: Path to the control device provided by the kernel module (manpage: --ctl-device)
ctl-device={{ ctl_device | default('/dev/vhba_ctl') }}

# libao audio driver to use for virtual device audio playback
# Schema: audio_driver | default: null | desc: libao audio driver to use for virtual device audio playback (manpage: --audio-driver)
audio-driver={{ audio_driver | default('null') }}

# D-Bus bus type: 'system' or 'session'
# Schema: bus | default: session | desc: D-Bus bus type: 'system' or 'session' (manpage: --bus)
bus={{ bus | default('session') }}

# Path to log file; empty disables logging
# Schema: logfile | default: '' | desc: Path to log file; empty disables logging (manpage: --logfile)
logfile={{ logfile | default('') }}

# CDEmu daemon-level debug mask
# Schema: cdemu_debug_mask | default: 0 | desc: CDEmu daemon-level debug mask (manpage: --default-cdemu-debug-mask)
default-cdemu-debug-mask={{ cdemu_debug_mask | default(0) }}

# libMirage-level debug mask
# Schema: mirage_debug_mask | default: 0 | desc: libMirage-level debug mask (manpage: --default-mirage-debug-mask)
default-mirage-debug-mask={{ mirage_debug_mask | default(0) }}