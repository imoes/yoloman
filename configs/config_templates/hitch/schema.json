{
  "pem": {
    "type": "string",
    "default": "",
    "description": "Path to PEM file containing certificate chain and private key (required at runtime via command-line argument)"
  },
  "tls_protos": {
    "type": "list",
    "default": [
      "TLSv1.2",
      "TLSv1.3"
    ],
    "description": "TLS protocols to enable"
  },
  "ciphers": {
    "type": "string",
    "default": "EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH",
    "description": "Allowed cipher suites"
  },
  "ssl_engine": {
    "type": "string",
    "default": "",
    "description": "OpenSSL engine to use"
  },
  "prefer_server_ciphers": {
    "type": "bool",
    "default": false,
    "description": "Prefer server cipher list order over client preference"
  },
  "client": {
    "type": "bool",
    "default": false,
    "description": "Enable client proxy mode"
  },
  "backend": {
    "type": "string",
    "default": "[127.0.0.1]:8000",
    "description": "Backend endpoint (host:port or UNIX domain socket)"
  },
  "frontends": {
    "type": "list",
    "default": [
      "[*]:8443"
    ],
    "description": "List of frontend listen endpoints; each may optionally include a per-SNI certificate name appended with +CERT in the endpoint string, but here we model them as separate fields for clarity in the template logic (see sample_values for format)."
  },
  "workers": {
    "type": "number",
    "default": 1,
    "description": "Number of worker processes; 'auto' creates one per CPU core"
  },
  "backlog": {
    "type": "number",
    "default": 100,
    "description": "Listen backlog size"
  },
  "keepalive": {
    "type": "number",
    "default": 3600,
    "description": "TCP keepalive on client socket (seconds)"
  },
  "backend_refresh": {
    "type": "number",
    "default": 0,
    "description": "Periodic backend IP refresh (seconds); 0 disables"
  },
  "tcp_fastopen": {
    "type": "bool",
    "default": false,
    "description": "Enable client-side TCP Fast Open"
  },
  "chroot": {
    "type": "string",
    "default": "",
    "description": "Chroot directory"
  },
  "user": {
    "type": "string",
    "default": "",
    "description": "User to drop privileges to"
  },
  "group": {
    "type": "string",
    "default": "",
    "description": "Group to drop privileges to"
  },
  "log_level": {
    "type": "number",
    "default": 1,
    "description": "Log level (0=silent, 1=error, 2=info/debug)"
  },
  "log_filename": {
    "type": "string",
    "default": "",
    "description": "Path to log file (default: stderr/stdout)"
  },
  "syslog": {
    "type": "bool",
    "default": false,
    "description": "Send logs to syslog in addition to stderr/stdout"
  },
  "syslog_facility": {
    "type": "string",
    "default": "daemon",
    "description": "Syslog facility",
    "enum": [
      "user",
      "mail",
      "daemon",
      "syslog",
      "news"
    ]
  },
  "daemon": {
    "type": "bool",
    "default": false,
    "description": "Fork into background as daemon"
  },
  "write_ip": {
    "type": "bool",
    "default": false,
    "description": "Write 1-octet IP family + address to backend before data"
  },
  "write_proxy": {
    "type": "bool",
    "default": false,
    "description": "Write HAProxy PROXY v2 header to backend"
  },
  "write_proxy_v1": {
    "type": "bool",
    "default": false,
    "description": "Write HAProxy PROXY v1 header to backend"
  },
  "proxy_proxy": {
    "type": "bool",
    "default": false,
    "description": "Proxy PROXY header from client to backend"
  },
  "sni_nomatch_abort": {
    "type": "bool",
    "default": false,
    "description": "Abort handshake on unrecognized SNI server name"
  },
  "alpn_protos": {
    "type": "list",
    "default": [],
    "description": "ALPN/NPN protocol list (comma-separated tokens)"
  },
  "ocsp_dir": {
    "type": "string",
    "default": "/var/lib/hitch/",
    "description": "OCSP staple cache directory"
  },
  "backend_connect_timeout": {
    "type": "number",
    "default": 0,
    "description": "Backend connect timeout (seconds); 0 = default"
  },
  "ssl_handshake_timeout": {
    "type": "number",
    "default": 0,
    "description": "TLS handshake timeout (seconds); 0 = default"
  },
  "pidfile": {
    "type": "string",
    "default": "",
    "description": "PID file path"
  }
}
