{
  "pem": "/etc/hitch/certs/server.pem",
  "tls_protos": [
    "TLSv1.2",
    "TLSv1.3"
  ],
  "ciphers": "EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH",
  "ssl_engine": "",
  "prefer_server_ciphers": true,
  "client": false,
  "backend": "[127.0.0.1]:8000",
  "frontends": [
    {
      "endpoint": "[*]:443",
      "cert": "server1"
    },
    {
      "endpoint": "[192.0.2.1]:443",
      "cert": "server2"
    }
  ],
  "workers": 4,
  "backlog": 2048,
  "keepalive": 1800,
  "backend_refresh": 300,
  "tcp_fastopen": true,
  "chroot": "/var/lib/hitch",
  "user": "hitch",
  "group": "hitch",
  "log_level": 2,
  "log_filename": "/var/log/hitch/hitch.log",
  "syslog": true,
  "syslog_facility": "daemon",
  "daemon": true,
  "write_ip": false,
  "write_proxy": true,
  "proxy_proxy": false,
  "sni_nomatch_abort": true,
  "alpn_protos": [
    "h2",
    "http/1.1"
  ],
  "ocsp_dir": "/var/lib/hitch/ocsp",
  "backend_connect_timeout": 5,
  "ssl_handshake_timeout": 30,
  "pidfile": "/run/hitch/hitch.pid"
}
