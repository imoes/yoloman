{
  "horizontal_scale": {
    "type": "number",
    "default": 1.0,
    "description": "Horizontal scale factor for minimap pixels [default: 1.0]"
  },
  "vertical_scale": {
    "type": "number",
    "default": 1.0,
    "description": "Vertical scale factor for minimap pixels [default: 1.0]"
  },
  "padding": {
    "type": "number",
    "default": 0,
    "description": "Padding width (in pixels) around minimap"
  },
  "encoding": {
    "type": "string",
    "default": "utf8-lossy",
    "description": "Input encoding [possible values: utf8-lossy, utf8]",
    "enum": [
      "utf8",
      "utf8-lossy"
    ]
  }
}
