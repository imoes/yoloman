# code-minimap configuration
# Minimal, production-sane config for code-minimap(1)

# Horizontal scaling factor for minimap pixels
horizontal-scale: {{ horizontal_scale | default(1.0) }}

# Vertical scaling factor for minimap pixels
vertical-scale: {{ vertical_scale | default(1.0) }}

# Padding width (in pixels) around minimap
padding: {{ padding | default(0) }}

# Input encoding
encoding: {{ encoding | default('utf8-lossy') }}