; redshift-qt configuration file
; Generated by Ansible Jinja2 engine
;
; This file configures redshift-qt, a GUI frontend for redshift that adjusts
; the screen color temperature based on the time of day to reduce eye strain.
;
; Settings:
;   provider           - The service used to determine location (geoclue2, manual, or internal).
;   transition         - Duration (minutes) of the color temperature ramp-up/down.
;   day_temp           - Color temperature (Kelvin) during daytime.
;   night_temp         - Color temperature (Kelvin) during nighttime.
;   brightness         - Screen brightness factor (0.0 to 1.0).
;   location_lat/lon   - Latitude and Longitude for the 'manual' provider.

[redshift]

; Location provider used by redshift
; Options: geoclue2, manual, internal
; geoclue2 uses the system's Geoclue2 service for automatic location detection.
; manual requires setting location_lat and location_lon below.
; internal uses a static location defined in redshift's built-in data.
provider = {{ provider | default('geoclue2') }}

; Transition duration between day and night temperature
; Format: 'day_to_night:night_to_day' in minutes.
; Example: '2:2' means 2 minutes to transition from day to night, and 2 minutes from night to day.
transition = {{ transition | default('2:2') }}

; Color temperature during daytime
; Measured in Kelvin. Higher values (e.g., 6500K) are cooler/bluer (daylight).
day-temp = {{ day_temp | default('6500') }}

; Color temperature during nighttime
; Measured in Kelvin. Lower values (e.g., 3500K) are warmer/redder (sunset/night).
night-temp = {{ night_temp | default('3500') }}

; Brightness settings
; Value between 0.0 (darkest) and 1.0 (full brightness).
; This adjusts the screen brightness relative to the temperature shift if supported by the backend.
brightness = {{ brightness | default('1.0') }}

; Location parameters (if provider is manual)
; Latitude coordinate for manual location provider.
; Required if provider is set to 'manual'.
location-lat = {{ location_lat | default('40.0') }}

; Longitude coordinate for manual location provider.
; Required if provider is set to 'manual'.
location-lon = {{ location_lon | default('-74.0') }}