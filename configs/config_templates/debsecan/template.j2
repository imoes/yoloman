{# ============================================================= #}
{# Configuration file for debsecan (Debian Security CAnalysis)    #}
{# Shell-style name=value syntax. Each directive is self-documenting#}
{# via the comment above it, which reflects its schema definition. #}
{# ============================================================= #}

# Email address to which reports are sent in --cron mode. May contain
# macros (%s(hostname|fqdn|ip)s).
MAILTO="{{ config_file_mailto | default('') }}"

# Controls whether debsecan does any processing in --cron mode.
REPORT="{{ config_file_report | default(true) | string | lower }}"

# URL from which vulnerability information is fetched. If empty, the
# built-in default is used.
SOURCE="{{ config_file_source | default('') }}"

# Default value for the --suite option (e.g., 'sid', 'bookworm').
SUITE="{{ config_file_suite | default('') }}"

# Subject line of email reports. May contain macros (%s(hostname|fqdn|ip)s).
SUBJECT="{{ config_file_subject | default('') }}"

# If true, disables HTTPS certificate validation (mirrors
# --disable-https-check).
DISABLE_HTTPS_CHECK="{{ config_file_disable_https_check | default(false) | string | lower }}"