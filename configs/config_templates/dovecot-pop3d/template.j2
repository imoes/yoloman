# ==============================================================================
# Dovecot POP3/POP3S Service Configuration
# ==============================================================================
# This template generates the service definition for Dovecot's POP3 and POP3S
# protocols. It exposes two distinct service entries: one for standard POP3
# (unencrypted) and one for POP3S (encrypted via TLS).
#
# Schema Variables:
#   - pop3_port  : Default '110/tcp'. Port configuration for the POP3 service.
#   - pop3s_port : Default '995/tcp'. Port configuration for the POP3S secure service.
# ==============================================================================

[Dovecot POP3]
# Title for the POP3 service entry.
title=Secure mail server (POP3)
# Description explaining the role of this service.
description=Dovecot is a mail server whose major goals are security and extreme
 reliability.
# The port(s) on which this service listens, sourced from the schema.
# Defaults to '110/tcp' if not provided.
ports={{ pop3_port | default('110/tcp') }}

[Dovecot Secure POP3]
# Title for the POP3S (secure) service entry.
title=Secure mail server (POP3S)
# Description explaining the role of this secure service.
description=Dovecot is a mail server whose major goals are security and extreme
 reliability.
# The port(s) on which the secure service listens, sourced from the schema.
# Defaults to '995/tcp' if not provided.
ports={{ pop3s_port | default('995/tcp') }}