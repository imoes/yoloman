# Dovecot POP3 Service Configuration
# This section defines the standard POP3 service settings.
[Dovecot POP3]
# title: Secure mail server (POP3)
# description: Dovecot is a mail server whose major goals are security and extreme
#              reliability.
# ports: The port on which the Dovecot POP3 service listens.
#        Default is '110/tcp' as defined in the schema.
ports={{ pop3_port | default('110/tcp') }}

# Dovecot POP3S Service Configuration
# This section defines the POP3 over SSL/TLS (POP3S) service settings.
[Dovecot Secure POP3]
# title: Secure mail server (POP3S)
# description: Dovecot is a mail server whose major goals are security and extreme
#              reliability.
# ports: The port on which the Dovecot POP3S service listens.
#        Default is '995/tcp' as defined in the schema.
ports={{ pop3s_port | default('995/tcp') }}
