{
  "verbose": false,
  "maxconn": 200,
  "default_user": "nobody",
  "default_group": "nogroup",
  "timeout_dns": 5,
  "timeout_idle": 120,
  "tcp_wrappers": true,
  "ipv6": true,
  "services": [
    {
      "name": "ftp",
      "port": 21,
      "protocol": "tcp",
      "chroot": "/var/ftp",
      "user": "ftp",
      "group": "ftp",
      "log_prefix": "[ftp] ",
      "maxconn": 50,
      "cmd": [
        "/usr/bin/ipsvd-ftp"
      ]
    },
    {
      "name": "smtp",
      "port": 25,
      "protocol": "tcp",
      "user": "mail",
      "group": "mail",
      "log_prefix": "[smtp] ",
      "cmd": [
        "/usr/bin/ipsvd-smtp"
      ]
    },
    {
      "name": "time",
      "port": 37,
      "protocol": "udp",
      "cmd": [
        "/usr/bin/ipsvd-time"
      ]
    }
  ]
}
