;;; 50flim.el --- Debian flim startup file -*-mode: emacs-lisp;-*-
;;
;; Self-documented template for the 'flim' Emacs package configuration.
;; Variables are derived from the Ansible role schema.
;;
;; Variables used:
;;   - package_name: The name of the Debian package.
;;   - default_flavor: The default Emacs flavor (e.g., 'emacs', 'emacs-ng').

(let* ((pkg "{{ package_name | default('flim') }}")
       (flavor-name
        (if (boundp 'debian-emacs-flavor)
            (symbol-name debian-emacs-flavor)
          "{{ default_flavor | default('emacs') }}"))
       ;; Path to the emacsen-common installation script for this package
       (pkg-inst (concat "/usr/lib/emacsen-common/packages/install/" pkg))
       ;; Directory where compiled Emacs Lisp files reside for this flavor
       (elc-dir (concat "/usr/share/" flavor-name "/site-lisp/" pkg)))
  ;; Only proceed if the expected directories/files exist
  (when (and (file-exists-p elc-dir)
	     (file-exists-p pkg-inst))
    (if (fboundp 'debian-pkg-add-load-path-item)
        ;; Modern Debian Emacs integration: register load path via helper function
	(debian-pkg-add-load-path-item elc-dir)
      ;; Fallback for older systems: manually prepend to load-path
      (setq load-path (cons elc-dir load-path)))
    ;; End of configuration block
    ))

;;; 50flim.el ends here
