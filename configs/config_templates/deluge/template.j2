{# Deluge CLI config options #}
{% if config_dir %}# Config directory location
-c {{ config_dir }}
{% endif %}
{% if user_interface %}# UI to launch
{{ user_interface }}{% if user_interface_args %} {{ user_interface_args }}{% endif %}
{% endif %}
{# Logging configuration #}
{% if logfile %}# Output to specified logfile instead of stdout
-l {{ logfile }}
{% endif %}
{% if loglevel %}# Set the log level (default is error): none, info, warning, error, debug
-L {{ loglevel }}
{% endif %}
{% if quiet %}# Sets the log level to none, same as -L none
-q
{% endif %}
{% if logrotate %}# Enable logfile rotation, with optional maximum logfile size, default: 2M
--logrotate{% if logrotate != true %}={{ logrotate }}{% endif %}
{% endif %}
{% if profile %}# Profile with cProfile. Outputs to stdout unless a filename is specified
--profile{% if profile != true %}={{ profile }}{% endif %}
{% endif %}