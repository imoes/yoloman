{
  "debug": false,
  "log_file": "/var/log/gddccontrol/gddccontrol.log",
  "worker_threads": 2,
  "poll_interval": 10,
  "i2c_timeout": 3,
  "i2c_retry_limit": 5,
  "monitors": [
    {
      "name": "primary",
      "i2c_addr": 61,
      "enabled": true,
      "default_brightness": 75,
      "default_contrast": 60,
      "restore_on_start": true,
      "gamma_path": "/etc/gddccontrol/gamma-primary.icm"
    },
    {
      "name": "secondary",
      "i2c_addr": 62,
      "enabled": true,
      "default_brightness": 50,
      "default_contrast": 50,
      "restore_on_start": false,
      "gamma_path": ""
    }
  ],
  "allowed_users": [
    "gddccontrol",
    "admin"
  ],
  "api_port": 8080,
  "api_host": "127.0.0.1"
}
