{
  "inittab": {
    "type": "list",
    "default": [],
    "description": "sysvinit inittab entries; each entry defines an action to perform at boot or in response to signals"
  },
  "inittab.entries": {
    "type": "list",
    "default": [],
    "description": "List of inittab entries; each item is a dict of fields per entry. Not a nested object in schema \u2014 flattened via items key below."
  },
  "inittab.entries[].id": {
    "type": "string",
    "default": "1",
    "description": "Identifier field (e.g., '1', '2', 'ctrlaltdel')",
    "enum": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "respawn",
      "once",
      "boot",
      "boot",
      "respawn",
      "once",
      "boot",
      "respawn",
      "once"
    ]
  },
  "inittab.entries[].runlevels": {
    "type": "string",
    "default": "S",
    "description": "Runlevels (empty string means all)",
    "enum": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "S",
      "s"
    ]
  },
  "inittab.entries[].action": {
    "type": "string",
    "default": "",
    "description": "Action (sysinit, respawn, wait, etc.)",
    "enum": [
      "wait",
      "once",
      "respawn",
      "restart",
      "offset"
    ]
  },
  "inittab.entries[].process": {
    "type": "string",
    "default": "",
    "description": "Command/process to execute"
  },
  "fstab": {
    "type": "list",
    "default": [],
    "description": "Mount table entries"
  },
  "fstab.entries": {
    "type": "list",
    "default": [],
    "description": "List of fstab entries"
  },
  "fstab.entries[].file": {
    "type": "string",
    "default": "",
    "description": "Block device or remote filesystem"
  },
  "fstab.entries[].dir": {
    "type": "string",
    "default": "",
    "description": "Mount point directory"
  },
  "fstab.entries[].type": {
    "type": "string",
    "default": "",
    "description": "Filesystem type (e.g., ext4, tmpfs)",
    "enum": [
      "ext2",
      "vfat",
      "proc",
      "fat",
      "minix",
      "nfs",
      "vfat"
    ]
  },
  "fstab.entries[].options": {
    "type": "list",
    "default": [],
    "description": "Mount options"
  },
  "fstab.entries[].dump": {
    "type": "number",
    "default": 0,
    "description": "Dump frequency (0 or 1)"
  },
  "fstab.entries[].pass": {
    "type": "number",
    "default": 0,
    "description": "Filesystem check order (0=skip, 1=root, 2=others)"
  },
  "network.interfaces": {
    "type": "list",
