{
  "inittab": {
    "entries": [
      {
        "id": "1",
        "runlevels": "",
        "action": "respawn",
        "process": "/sbin/getty 115200 tty1"
      },
      {
        "id": "ctrlaltdel",
        "runlevels": "",
        "action": "ctrlaltdel",
        "process": "/sbin/reboot"
      },
      {
        "id": "shutdown",
        "runlevels": "",
        "action": "shutdown",
        "process": "/bin/umount -a -r"
      }
    ]
  },
  "fstab": {
    "entries": [
      {
        "file": "proc",
        "dir": "/proc",
        "type": "proc",
        "options": [
          "defaults"
        ],
        "dump": 0,
        "pass": 0
      },
      {
        "file": "tmpfs",
        "dir": "/tmp",
        "type": "tmpfs",
        "options": [
          "size=32M",
          "mode=1777"
        ],
        "dump": 0,
        "pass": 0
      }
    ]
  },
  "network": {
    "interfaces": [
      {
        "name": "eth0",
        "method": "static",
        "address": "192.168.1.10",
        "netmask": "255.255.255.0",
        "gateway": "192.168.1.1",
        "post_up": [
          "ip route add default via 192.168.1.1"
        ]
      }
    ]
  },
  "mdev.conf": {
    "entries": [
      {
        "pattern": "sd[a-z]",
        "uid": "0",
        "gid": "0",
        "perm": "0660",
        "action": "@modprobe -a block-major-$major"
      },
      {
        "pattern": "$MODALIAS=usb*",
        "uid": "0",
        "gid": "0",
        "perm": "0660",
        "action": "|/sbin/modprobe $MODALIAS"
      }
    ]
  },
  "hostname": "mydevice",
  "hosts": {
    "entries": [
      {
        "ip": "127.0.0.1",
        "hostname": "localhost"
      },
      {
        "ip": "::1",
        "hostname": "localhost"
      },
      {
        "ip": "192.168.1.10",
        "hostname": "mydevice",
        "aliases": [
          "router"
        ]
      }
    ]
  },
  "resolv.conf": {
    "nameservers": [
      "8.8.8.8",
      "8.8.4.4"
    ],
    "search": [
      "example.com",
      "local"
    ]
  },
  "sysctl.conf": {
    "settings": {
      "net.ipv4.ip_forward": "0",
      "vm.swappiness": "60"
    }
  },
  "nsswitch.conf": {
    "lines": [
      "# nsswitch.conf \u2014 minimal config for glibc",
      "passwd:     files",
      "group:      files",
      "shadow:     files",
      "hosts:      files dns"
    ]
  }
}
