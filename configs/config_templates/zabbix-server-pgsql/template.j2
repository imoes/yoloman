# Zabbix Server Logrotate Configuration
# Managed by Ansible. Do not edit manually.

# Rotate logs weekly to avoid excessive disk usage from frequent rotation.
weekly

# Number of rotated log files to keep.
# Schema: logrotate_rotate_count (default: '7')
rotate {{ logrotate_rotate_count | default('7') }}

# Compress rotated log files to save disk space.
compress

# Delay compression of the most recent rotated file to allow the application to finish writing.
delaycompress

# Do not fail if the log file is missing.
missingok

# Do not rotate the log if it is empty.
notifempty

# Octal permission mode for newly created log files.
# Schema: logrotate_create_mode (default: '0640')
create {{ logrotate_create_mode | default('0640') }}

# Owner of newly created log files.
# Schema: logrotate_create_owner (default: 'zabbix')
{{ logrotate_create_owner | default('zabbix') }}

# Group of newly created log files.
# Schema: logrotate_create_group (default: 'zabbix')
{{ logrotate_create_group | default('zabbix') }}

# Execute the postrotate script once for all rotated logs, rather than once per log file.
sharedscripts
