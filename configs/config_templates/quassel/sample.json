{
  "config_dir": "/var/lib/quassel",
  "log_level": "Info",
  "log_file": "/var/log/quassel/quassel.log",
  "syslog": true,
  "listen_address": "127.0.0.1",
  "listen_port": 4242,
  "require_ssl": true,
  "ssl_cert": "/etc/quassel/ssl/quasselCert.pem",
  "ssl_key": "/etc/quassel/ssl/quasselKey.pem",
  "ident_daemon": true,
  "ident_listen": "127.0.0.1",
  "ident_port": 10113,
  "db_backend": "postgresql",
  "db_pgsql_hostname": "localhost",
  "db_pgsql_port": 5432,
  "db_pgsql_database": "quassel",
  "db_pgsql_username": "quasseluser",
  "db_pgsql_password": "secure_password_here",
  "auth_ldap_hostname": "ldap.example.com",
  "auth_ldap_port": 389,
  "auth_ldap_base_dn": "dc=example,dc=com",
  "auth_ldap_bind_dn": "cn=admin,dc=example,dc=com",
  "auth_ldap_bind_password": "ldap_admin_password",
  "auth_ldap_filter": "(uid=%s)",
  "auth_ldap_uid_attribute": "uid",
  "auth_authenticator": "Ldap"
}
