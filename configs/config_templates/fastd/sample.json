{
  "interface_name": "fastd0",
  "interface_mtu": 1420,
  "listen_addrs": [],
  "port": 1234,
  "peer_discovery_methods": [
    {
      "name": "static"
    },
    {
      "name": "dns",
      "hostname": "peers.example.com"
    },
    {
      "name": "local",
      "port": 1234
    }
  ],
  "use_static_peers": true,
  "peers_file_path": "/etc/fastd/peers.conf",
  "peer_public_key_method": "file",
  "peer_public_key_file": "/etc/fastd/keys/public_keys.conf",
  "uplink_limit": 5000,
  "log_level": "info",
  "peer_method_config": "/etc/fastd/methods.conf",
  "enable_ipv6": false,
  "interface_mac": "",
  "interface_owner": "fastd",
  "interface_group": "fastd",
  "bridge_mode": true
}
