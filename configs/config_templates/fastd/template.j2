# ==============================================================================
# fastd Initialization Script Configuration
# ==============================================================================
#
# This file configures the legacy /etc/init.d/fastd script.
# NOTE: This configuration method is DEPRECATED.
# The recommended approach is to use instanced systemd units (fastd@.service)
# and configure them individually.
#
# This file is intended primarily for setting which fastd instances should
# be started automatically at boot time via the legacy init system.
# ==============================================================================

#
# AUTOSTART: List of VPN instances to automatically start.
#
# Description: Space-separated list of VPN instance names that should be
#              started automatically by the init script during system boot.
#
# Allowed Values:
#   - "all": Start all configured instances.
#   - "none": Do not start any instances automatically.
#   - A space-separated list of specific instance names (e.g., "vpn1 vpn2").
#
# Default: If unset, the default behavior is usually "all", but explicit
#          configuration is preferred. Use 'none' to disable auto-start.
#
AUTOSTART="{{ autostart | default('none') }}"