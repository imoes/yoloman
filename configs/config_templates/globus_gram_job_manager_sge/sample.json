{
  "service_name": "globus-sge-jm",
  "service_description": "Globus GRAM Job Manager for Sun/Oracle Grid Engine",
  "queue": "medium.q",
  "qsub_path": "/opt/sge/bin/lx-amd64/qsub",
  "qstat_path": "/opt/sge/bin/lx-amd64/qstat",
  "qdel_path": "/opt/sge/bin/lx-amd64/qdel",
  "qacct_path": "/opt/sge/bin/lx-amd64/qacct",
  "max_jobs": 500,
  "work_dir": "/var/lib/globus/sge_jobs",
  "notify_enabled": true,
  "notify_email": "grid-support@example.edu",
  "environment_vars": [
    {
      "name": "SGE_CELL",
      "value": "default"
    },
    {
      "name": "LD_LIBRARY_PATH",
      "value": "/opt/sge/lib/lx-amd64"
    }
  ],
  "project": "research-123",
  "resource_limits": [
    {
      "name": "h_vmem",
      "value": "4G"
    },
    {
      "name": "h_rt",
      "value": "06:00:00"
    }
  ],
  "admin_user": "sgoadmin",
  "monitoring_enabled": true,
  "qhost_path": "/opt/sge/bin/lx-amd64/qhost"
}
