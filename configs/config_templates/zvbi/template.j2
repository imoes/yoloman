# zvbi daemon configuration
#
# This file configures the zvbi (Video BSI) VBI capture daemon.
# It is sourced by the init script at /etc/init.d/zvbi.

# Whether to start the zvbi daemon (zvbid) on system startup.
# Valid values are 'yes' or 'no'.
# Default: yes
start_daemon={{ start_daemon | default('yes') }}
