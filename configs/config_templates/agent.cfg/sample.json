{
  "enabled": true,
  "debug_level": 1,
  "log_file": "/var/log/fusioninventory-agent/fusioninventory-agent.log",
  "server_url": "https://inventory.example.com/fusioninventory/",
  "inventory_interval": 1800,
  "timeout": 60,
  "user": "nobody",
  "group": "nogroup",
  "log_size": 20,
  "ssl_enabled": true,
  "ssl_cert_path": "/etc/ssl/fusioninventory/client.crt",
  "ssl_key_path": "/etc/ssl/fusioninventory/client.key",
  "ssl_ca_cert_path": "/etc/ssl/certs/example-ca-bundle.crt",
  "ssl_allow_self_signed": false,
  "extra_tags": [
    "production",
    "linux",
    "web"
  ],
  "plugins": [
    {
      "name": "inventory",
      "enabled": true,
      "config": {}
    },
    {
      "name": "netdiscovery",
      "enabled": true,
      "config": {
        "range": "192.168.1.0/24",
        "snmp_communities": "public",
        "timeout": 5
      }
    },
    {
      "name": "wakeonlan",
      "enabled": false,
      "config": {}
    }
  ],
  "pre_inventory_cmd": "/usr/local/bin/pre-inventory-check.sh",
  "post_inventory_cmd": ""
}
