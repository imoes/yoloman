# input-remapper-autoload.desktop
# This desktop entry configures the input-remapper-daemon service to autoload
# user-defined input device presets on session start.
# It ensures that any shortcuts configured in the presets are immediately active.

[Desktop Entry]
# Standard desktop entry type; must be Application for executable launches.
Type=Application

# Command executed at startup. It first stops any existing remapping instances
# to clear stale bindings, then instructs the daemon to load the current
# preset definitions into the kernel/input subsystem.
Exec=bash -c "input-remapper-control --command stop-all && input-remapper-control --command autoload"

# Display name for the service/shortcut.
Name=input-remapper-autoload

# Path or theme-able name for the application icon.
Icon=input-remapper

# Brief description shown in session autostart managers (e.g., GNOME, KDE).
Comment=Starts injecting all presets that are set to automatically load for the user