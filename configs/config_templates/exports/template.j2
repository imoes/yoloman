# ==============================================================================
# NFS Exports Configuration
# ==============================================================================
# This template generates the /etc/exports file for NFS server.
# It iterates over the 'exports' list provided by the Ansible role.
#
# Each export entry must contain:
#   - path: The absolute path of the directory to export (string)
#   - client: The client access specifier. Can be a hostname, IP address,
#             CIDR network, or '*' for all clients (string)
#   - options: A list of comma-separated NFS export options (list of strings)
#
# Example of an exports entry in the variable:
#   exports:
#     - path: /srv/nfs/share1
#       client: 192.168.1.0/24
#       options: [rw, sync, no_subtree_check]
#
# ==============================================================================

{% for export in exports | default([]) %}
# Export: {{ export.path | default('/') }} for client {{ export.client | default('*') }}
# Options: {{ export.options | default([]) | join(', ') }}
{{ export.path | default('/') }}{{ ' ' }}{{ export.client | default('*') }}({{ export.options | default([]) | join(', ') }})
{% endfor %}