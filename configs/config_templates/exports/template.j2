# Export directories and their access rules for NFS
# Syntax: <path> <client>(<options>)
#   - path: exported directory (absolute)
#   - client: hostname, IP, network (CIDR), or special keywords (e.g., *)
#   - options: comma-separated list of access options (see man exports)
{% for export in exports %}{{ export.path }}{{ ' ' }}{{ export.client }}({{ export.options | join(', ') }})
{% endfor %}