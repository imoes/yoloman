{
  "exports": [
    {
      "path": "/srv/nfs/home",
      "client": "192.168.1.0/24",
      "options": [
        "rw",
        "sync",
        "no_subtree_check",
        "no_root_squash"
      ]
    },
    {
      "path": "/srv/nfs/public",
      "client": "*",
      "options": [
        "ro",
        "sync",
        "no_subtree_check",
        "all_squash",
        "anonuid=65534",
        "anongid=65534"
      ]
    },
    {
      "path": "/srv/nfs/builds",
      "client": "nfs-client.internal.example.com",
      "options": [
        "rw",
        "sync",
        "no_subtree_check",
        "no_root_squash"
      ]
    }
  ]
}
