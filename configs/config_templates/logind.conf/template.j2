# /etc/systemd/logind.conf — systemd login manager configuration
# See man logind.conf(5) for details

[Login]
# Maximum number of seconds to wait for a user session to terminate during shutdown
# Set to 0 to disable timeout
# Default: 10
NAutoVTs={{ n_auto_vts }}

# First and last VT (virtual terminal) numbers to manage
# Default: 1-6
ReserveVT={{ reserve_vts | join(',') }}

# Whether to kill user processes when they log out
# Options: yes, no, on-last-log, force, auto
# Default: yes
KillUserProcesses={{ kill_user_processes }}

# Whether to kill all user processes when the user logs out (legacy alias for KillUserProcesses)
# This option is deprecated; use KillUserProcesses instead
KillOnlyUsers={{ kill_only_users | join(',') }}

# Whether to ignore user processes of the listed users for KillUserProcesses
# Default: root
KillExcludeUsers={{ kill_exclude_users | join(',') }}

# Whether to handle the lid switch (suspend/resume on laptop lid close)
# Options: ignore, poweroff, reboot, halt, kexec, suspend, hibernate, hybrid-sleep, suspend-hybrid, shutdown
# Default: suspend
HandleLidSwitch={{ handle_lid_switch }}

# Whether to handle lid switch when external monitors are connected
# Default: suspend
HandleLidSwitchDocked={{ handle_lid_switch_docked }}

# Whether to handle the power button (shutdown/suspend)
# Default: poweroff
HandlePowerKey={{ handle_power_key }}

# Whether to handle the suspend button
# Default: suspend
HandleSuspendKey={{ handle_suspend_key }}

# Whether to handle the hibernate button
# Default: hibernate
HandleHibernateKey={{ handle_hibernate_key }}

# How long to wait before forcing a user session termination during shutdown
# Default: 10
RemoveIPC={{ remove_ipc }}

# Whether to remove user IPC objects (shared memory, message queues, semaphores) on logout
# Options: yes, no, on-last-log
# Default: yes
RemoveIPC={{ remove_ipc }}

# Maximum number of sessions per user (0 = unlimited)
# Default: 0
UserTasksMax={{ user_tasks_max }}

# Maximum number of processes per user (0 = system default)
# Default: 0
UserTasksMax={{ user_tasks_max }}

# Maximum number of processes per user session (0 = system default)
# Default: 0
SessionTasksMax={{ session_tasks_max }}

# Maximum number of inotify watches per user (0 = system default)
# Default: 0
UserInotifyMax={{ user_inotify_max }}

# Maximum number of audit messages per user (0 = system default)
# Default: 0
UserAuditMsgMax={{ user_audit_msg_max }}

# Maximum number of seccomp actions per user (0 = system default)
# Default: 0
UserSeccompFilterMax={{ user_seccomp_filter_max }}

# Whether to allow users to manage their own linger directory (persisting services)
# Options: yes, no
# Default: no
Linger={{ linger }}

# Default timeout (in seconds) for user linger activation (0 = no timeout)
# Default: 0
LingerTimeout={{ linger_timeout }}

# Default runtime directory size (in bytes) for user sessions (0 = default)
# Default: 0
RuntimeDirectorySize={{ runtime_directory_size }}

# Default runtime directory limit (number of entries) for user sessions (0 = default)
# Default: 0
RuntimeDirectoryInodesMax={{ runtime_directory_inodes_max }}

# Default cache directory size (in bytes) for user sessions (0 = default)
# Default: 0
CacheDirectorySize={{ cache_directory_size }}

# Default cache directory limit (number of entries) for user sessions (0 = default)
# Default: 0
CacheDirectoryInodesMax={{ cache_directory_inodes_max }}

# Default configuration for runtime directory (e.g., /run/user/UID)
# Default: 0755
RuntimeDirectoryMode={{ runtime_directory_mode }}

# Default configuration for cache directory (e.g., /run/user/UID/cache)
# Default: 0700
CacheDirectoryMode={{ cache_directory_mode }}

# Default configuration for config directory (e.g., /run/user/UID/config)
# Default: 0700
ConfigDirectoryMode={{ config_directory_mode }}

# Default timeout (in seconds) before automatic logout of idle sessions
# 0 = disabled
# Default: 0
IdleAction={{ idle_action }}

# Seconds of inactivity before IdleAction is triggered
# Default: 300
IdleActionSec={{ idle_action_sec }}

# Whether to lock the screen when entering idle state
# Options: yes, no
# Default: no
LockPath={{ lock_path }}

# Whether to enable the Wall message when a user logs in/out
# Options: yes, no
# Default: yes
WallMessage={{ wall_message }}

# Default time (in seconds) before automatic logout of idle sessions
# 0 = disabled
# Default: 0
RuntimeDirectorySize={{ runtime_directory_size }}

# Whether to enable session tracking (required for logind features)
# Options: yes, no
# Default: yes
EnableSessionTracking={{ enable_session_tracking }}

# Whether to enable linger mode for newly created users by default
# Options: yes, no
# Default: no
Linger={{ linger }}

# Whether to enable seat tracking
# Options: yes, no
# Default: yes
EnableSeatTracking={{ enable_seat_tracking }}

# Whether to enable multi-seat support
# Options: yes, no
# Default: no
MultiSeat={{ multi_seat }}

# Whether to enable user switching
# Options: yes, no
# Default: yes
UserSwitching={{ user_switching }}

# Whether to enable automatic user login on seat activation
# Options: yes, no
# Default: no
AutomaticLogin={{ automatic_login }}

# Default timeout (in seconds) for automatic login
# Default: 0
AutomaticLoginTimeout={{ automatic_login_timeout }}

# Whether to enable remote login (e.g., SSH) by default
# Options: yes, no
# Default: yes
Remote={{ remote }}

# Whether to enable local login (e.g., console) by default
# Options: yes, no
# Default: yes
Local={{ local }}

# Whether to enable VT switching (e.g., Ctrl+Alt+F1)
# Options: yes, no
# Default: yes
VTSwitch={{ vt_switch }}

# Whether to enable VT activation (e.g., login on VT switch)
# Options: yes, no
# Default: yes
VTActivate={{ vt_activate }}

# Whether to enable session leader detection
# Options: yes, no
# Default: yes
SessionLeader={{ session_leader }}

# Whether to enable session tracking per seat
# Options: yes, no
# Default: yes
SeatTracking={{ seat_tracking }}

# Whether to enable seat management (required for multi-seat)
# Options: yes, no
# Default: no
SeatManagement={{ seat_management }}

# Whether to enable device tracking
