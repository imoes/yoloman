[Login]
{% if n_auto_vts is defined and n_auto_vts is not none and (n_auto_vts is number or n_auto_vts is boolean or n_auto_vts | length > 0) %}NAutoVTs={{ n_auto_vts }}
{% else %}#NAutoVTs=6
{% endif %}{% if reserve_vts is defined and reserve_vts is not none and (reserve_vts is number or reserve_vts is boolean or reserve_vts | length > 0) %}ReserveVT={{ reserve_vts | join(",") | default('') }}
{% else %}#ReserveVT=6
{% endif %}{% if kill_user_processes is defined and kill_user_processes is not none and (kill_user_processes is number or kill_user_processes is boolean or kill_user_processes | length > 0) %}KillUserProcesses={{ kill_user_processes }}
{% else %}#KillUserProcesses=no
{% endif %}{% if kill_only_users is defined and kill_only_users is not none and (kill_only_users is number or kill_only_users is boolean or kill_only_users | length > 0) %}KillOnlyUsers={{ kill_only_users | join(",") | default('') }}
{% else %}#KillOnlyUsers=
{% endif %}{% if kill_exclude_users is defined and kill_exclude_users is not none and (kill_exclude_users is number or kill_exclude_users is boolean or kill_exclude_users | length > 0) %}KillExcludeUsers={{ kill_exclude_users | join(",") | default('') }}
{% else %}#KillExcludeUsers=root
{% endif %}#InhibitDelayMaxSec=5
#UserStopDelaySec=10
#SleepOperation=suspend-then-hibernate suspend
{% if handle_power_key is defined and handle_power_key is not none and (handle_power_key is number or handle_power_key is boolean or handle_power_key | length > 0) %}HandlePowerKey={{ handle_power_key }}
{% else %}#HandlePowerKey=poweroff
{% endif %}#HandlePowerKeyLongPress=ignore
#HandleRebootKey=reboot
#HandleRebootKeyLongPress=poweroff
{% if handle_suspend_key is defined and handle_suspend_key is not none and (handle_suspend_key is number or handle_suspend_key is boolean or handle_suspend_key | length > 0) %}HandleSuspendKey={{ handle_suspend_key }}
{% else %}#HandleSuspendKey=suspend
{% endif %}#HandleSuspendKeyLongPress=hibernate
{% if handle_hibernate_key is defined and handle_hibernate_key is not none and (handle_hibernate_key is number or handle_hibernate_key is boolean or handle_hibernate_key | length > 0) %}HandleHibernateKey={{ handle_hibernate_key }}
{% else %}#HandleHibernateKey=hibernate
{% endif %}#HandleHibernateKeyLongPress=ignore
{% if handle_lid_switch is defined and handle_lid_switch is not none and (handle_lid_switch is number or handle_lid_switch is boolean or handle_lid_switch | length > 0) %}HandleLidSwitch={{ handle_lid_switch }}
{% else %}#HandleLidSwitch=suspend
{% endif %}{% if handle_lid_switch_docked is defined and handle_lid_switch_docked is not none and (handle_lid_switch_docked is number or handle_lid_switch_docked is boolean or handle_lid_switch_docked | length > 0) %}HandleLidSwitchExternalPower={{ handle_lid_switch_docked }}
{% else %}#HandleLidSwitchExternalPower=suspend
{% endif %}#HandleLidSwitchDocked=ignore
#HandleSecureAttentionKey=secure-attention-key
#PowerKeyIgnoreInhibited=no
#SuspendKeyIgnoreInhibited=no
#HibernateKeyIgnoreInhibited=no
#LidSwitchIgnoreInhibited=yes
#RebootKeyIgnoreInhibited=no
#HoldoffTimeoutSec=30s
#IdleAction=ignore
#IdleActionSec=30min
#RuntimeDirectorySize=10%
#RuntimeDirectoryInodesMax=
{% if remove_ipc is defined and remove_ipc is not none and (remove_ipc is number or remove_ipc is boolean or remove_ipc | length > 0) %}RemoveIPC={{ remove_ipc }}
{% else %}#RemoveIPC=yes
{% endif %}#InhibitorsMax=8192
#SessionsMax=8192
#StopIdleSessionSec=infinity
#DesignatedMaintenanceTime=
