{
  "access_log": "/var/log/access.log MyFormat all",
  "auth_method": "basic basic_simple_db",
  "basic_simple_db_users_db": "hash:/usr/local/c-icap/etc/c-icap-users.txt",
  "brotli_max_input_block": "24",
  "brotli_quality": "4",
  "brotli_window_size": "22",
  "client_access": "allow all",
  "fake_allow204": "on",
  "group_source_by_group": "hash:/usr/local/c-icap/etc/c-icap-groups.txt",
  "group_source_by_user": "hash:/usr/local/c-icap/etc/c-icap-user-groups.txt",
  "http_port": "192.168.1.1:1380",
  "inter_process_locking_scheme": "pthread",
  "inter_process_shared_mem_scheme": "posix",
  "ldap_module_connections_pool": "ldap://cn=Directory Manager:Apassword@ldap.chtsanti.net max_connections=10 idle-ttl=30",
  "load_magic_file": "/etc/c-icap/c-icap.magic",
  "memcached_servers": "127.0.0.1",
  "memcached_use_md5_keys": "on",
  "remote_proxy_user_header": "X-Authenticated-User",
  "remote_proxy_user_header_encoded": "on",
  "remote_proxy_users": "off",
  "server_log": "/var/log/cicap-server.log",
  "service": "echo_service srv_echo.so",
  "service_alias": "avscan srv_clamav?allow204=on&sizelimit=off&mode=simple",
  "sys_logger_access": "all",
  "sys_logger_access_priority": "info",
  "sys_logger_facility": "daemon",
  "sys_logger_log_format": "BasicFormat",
  "sys_logger_prefix": "\"C-ICAP:\"",
  "sys_logger_server_priority": "crit",
  "template_cache_size": "20",
  "template_default_language": "en",
  "template_mem_buf_size": "8192",
  "template_reload_time": "360",
  "tls_passphrase": "/use/local/c-icap/scripts/cert-passphrase.sh",
  "zlib_mem_level": "8",
  "zlib_window_size": "15"
}
