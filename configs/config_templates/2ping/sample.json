{
 "allow_ipv4": true,
 "allow_ipv6": false,
 "allowed_networks": [
  "10.0.0.0/16",
  "192.168.0.0/16"
 ],
 "interface": "10.0.0.1",
 "log_file": "/var/log/2ping.log",
 "log_level": "warning",
 "max_rate": 5,
 "port": 402,
 "require_symmetric": true,
 "ssl_cert": "/etc/2ping/ssl/cert.pem",
 "ssl_enabled": true,
 "ssl_key": "/etc/2ping/ssl/key.pem",
 "timeout": 3
}
