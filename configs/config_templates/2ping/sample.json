{
  "interface": "10.0.0.1",
  "port": 402,
  "allow_ipv4": true,
  "allow_ipv6": false,
  "allowed_networks": [
    "10.0.0.0/16",
    "192.168.0.0/16"
  ],
  "log_level": "warning",
  "log_file": "/var/log/2ping.log",
  "ssl_enabled": true,
  "ssl_cert": "/etc/2ping/ssl/cert.pem",
  "ssl_key": "/etc/2ping/ssl/key.pem",
  "max_rate": 5,
  "timeout": 3,
  "require_symmetric": true
}
