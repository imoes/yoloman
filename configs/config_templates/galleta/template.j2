{#
  Galleta Configuration Template
  ------------------------------
  Galleta is a cookie parsing utility. This template generates its configuration file.
  It supports setting a custom field delimiter and specifying the input cookie file.
#}

{#
  delimiter: Field delimiter to use (single character); overrides default TAB.
  Default value is a tab character '\t'.
#}
# Field delimiter (default: tab)
# -t FD
FD: {{ delimiter | default('\t') }}

{#
  cookie_file: Path to the MSIE cookie file to parse.
  This is typically a required positional argument in the application,
  but here it is exposed as a configuration field for the template.
#}
# Input cookie file (required positional argument)
FILE: {{ cookie_file | default('') }}