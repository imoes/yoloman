# systemd service unit for 2vcard
[Unit]
Description=Convert vCards to iCal and vice versa via WebDAV/HTTP
After=network.target

[Service]
Type=simple
# User and group under which 2vcard runs
User={{ service_user }}
Group={{ service_group }}
# Working directory
WorkingDirectory={{ working_dir }}
# Executable path
ExecStart={{ bin_path }} --config {{ config_path }}
# Restart policy
Restart={{ restart_policy }}
RestartSec={{ restart_delay }}
# Resource limits (optional)
{% if memory_limit is defined %}MemoryMax={{ memory_limit }}{% endif %}
{% if cpu_limit is defined %}CPUQuota={{ cpu_limit }}{% endif %}
# Environment variables
{% for key, value in env_vars.items() %}
Environment="{{ key }}={{ value }}"
{% endfor %}
# Security hardening (optional)
{% if no_new_privileges %}NoNewPrivileges=true{% endif %}
{% if protect_system %}ProtectSystem={{ protect_system }}{% endif %}
{% if protect_home %}ProtectHome={{ protect_home }}{% endif %}
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=2vcard

[Install]
WantedBy=multi-user.target