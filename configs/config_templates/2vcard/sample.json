{
  "service_user": "2vcard",
  "service_group": "2vcard",
  "working_dir": "/var/lib/2vcard",
  "bin_path": "/usr/local/bin/2vcard",
  "config_path": "/etc/2vcard/config.yaml",
  "restart_policy": "on-failure",
  "restart_delay": 5,
  "memory_limit": "128M",
  "cpu_limit": "50%",
  "env_vars": {
    "TZ": "UTC",
    "LOG_LEVEL": "info"
  },
  "no_new_privileges": true,
  "protect_system": "strict",
  "protect_home": "read-only"
}
