{
  "service_user": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/default_user"
    },
    "description": "System user under which the service runs (e.g., '2vcard')"
  },
  "service_group": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/default_group"
    },
    "description": "System group for the service (e.g., '2vcard')"
  },
  "working_dir": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/default_working_dir"
    },
    "description": "Working directory for the 2vcard process"
  },
  "bin_path": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/default_bin_path"
    },
    "description": "Absolute path to the 2vcard binary"
  },
  "config_path": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/default_config_path"
    },
    "description": "Absolute path to the 2vcard configuration file"
  },
  "restart_policy": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/default_restart_policy"
    },
    "description": "Restart behavior: 'on-failure', 'always', 'on-abnormal', etc."
  },
  "restart_delay": {
    "type": "number",
    "default": {
      "$ref": "#/$defs/default_restart_delay"
    },
    "description": "Seconds to wait before restarting after failure"
  },
  "memory_limit": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/optional_no_limit"
    },
    "description": "Maximum memory (e.g., '128M', '1G'); omit if not constrained"
  },
  "cpu_limit": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/optional_no_limit"
    },
    "description": "CPU quota percentage (e.g., '50%', '100%'); omit if not constrained"
  },
  "env_vars": {
    "type": "object",
    "default": {
      "$ref": "#/$defs/default_env_vars"
    },
    "description": "Environment variables as key-value pairs"
  },
  "no_new_privileges": {
    "type": "boolean",
    "default": {
      "$ref": "#/$defs/default_no_new_privileges"
    },
    "description": "Prevent privilege escalation"
  },
  "protect_system": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/default_protect_system"
    },
    "description": "Mount protection level: 'strict', 'full', or 'true'; omit for none"
  },
  "protect_home": {
    "type": "string",
    "default": {
      "$ref": "#/$defs/default_protect_home"
    },
    "description": "Protect home directories: 'read-only', 'true', or 'tmpfs'; omit for none"
  }
}
