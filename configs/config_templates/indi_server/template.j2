{# INDI server configuration file - auto-generated by template #}
{# This file defines the INDI server’s device drivers, properties, and server behavior #}
<indi>
{# Server-level configuration: hostname, port, and authentication #}
  <server host="{{ server.host | default('localhost') }}" port="{{ server.port | default(7624) }}" version="{{ server.version | default('1.9') }}" />
{# Enable or disable web control interface #}
  {% if server.webcontrol | default(false) %}
  <webcontrol enabled="true" port="{{ server.webcontrol_port | default(8624) }}" />
  {% else %}
  <webcontrol enabled="false" />
  {% endif %}

{# Define shared options for all drivers (e.g., logging level) #}
  <drivers>
    <option name="LOG_LEVEL" value="{{ drivers.default_log_level | default('LOG_NORMAL') }}" />
    <option name="TIMEOUT" value="{{ drivers.default_timeout | default(3) }}" />
  </drivers>

{# List of enabled drivers (each with optional overrides) #}
  {% for driver in drivers.enabled %}
  <driver name="{{ driver.name }}" enabled="true">
    {% if driver.log_level %}
    <option name="LOG_LEVEL" value="{{ driver.log_level }}" />
    {% endif %}
    {% if driver.timeout %}
    <option name="TIMEOUT" value="{{ driver.timeout }}" />
    {% endif %}
    {# Extra driver-specific options, if any #}
    {% for opt_key, opt_val in driver.options.items() | default([]) %}
    <option name="{{ opt_key }}" value="{{ opt_val }}" />
    {% endfor %}
  </driver>
  {% endfor %}

{# Optional: default device group for unassigned devices #}
  <groups>
    <group name="{{ groups.default_group | default('Default') }}" />
  </groups>
</indi>