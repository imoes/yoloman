{
  "debug_level": 1,
  "debug_module": "TREE",
  "no_curses": true,
  "use_absolute_paths": false,
  "traversable_links": [
    "/usr/local/man",
    "/usr/local/share/man"
  ],
  "tr_keep_targets": true,
  "keep_dirs": [
    "/var/cache"
  ],
  "ignore_patterns": [
    "*.log",
    "*.tmp"
  ],
  "copy_patterns": [
    "*.conf.dist"
  ],
  "stow_dirs": [
    "/etc/stow"
  ],
  "protect_dirs": [
    "/usr/local/bin"
  ],
  "force": false,
  "packages": [
    {
      "name": "myapp",
      "stow_dir": "/etc/stow",
      "target_dir": "/usr/local",
      "verbose": 2,
      "ignore": [
        "README.md"
      ]
    }
  ]
}
