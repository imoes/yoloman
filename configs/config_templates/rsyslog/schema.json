{
  "load_immark": {
    "type": "bool",
    "default": false,
    "description": "Whether to load the immark module."
  },
  "load_imudp": {
    "type": "bool",
    "default": false,
    "description": "Whether to load the imudp module."
  },
  "load_imudp_port": {
    "type": "number",
    "default": 514,
    "description": "Port number for UDP syslog reception."
  },
  "load_imtcp": {
    "type": "bool",
    "default": false,
    "description": "Whether to load the imtcp module."
  },
  "load_imtcp_port": {
    "type": "number",
    "default": 514,
    "description": "Port number for TCP syslog reception."
  },
  "file_owner": {
    "type": "string",
    "default": "syslog",
    "description": "Owner of the log files."
  },
  "file_group": {
    "type": "string",
    "default": "adm",
    "description": "Group of the log files."
  },
  "file_create_mode": {
    "type": "string",
    "default": "0640",
    "description": "Create mode for log files."
  },
  "dir_create_mode": {
    "type": "string",
    "default": "0755",
    "description": "Create mode for log directories."
  },
  "umask": {
    "type": "string",
    "default": "0022",
    "description": "Umask for log files and directories."
  },
  "privdrop_to_user": {
    "type": "string",
    "default": "syslog",
    "description": "User to drop privileges to."
  },
  "privdrop_to_group": {
    "type": "string",
    "default": "syslog",
    "description": "Group to drop privileges to."
  },
  "work_directory": {
    "type": "string",
    "default": "/var/spool/rsyslog",
    "description": "Directory for spool and state files."
  }
}