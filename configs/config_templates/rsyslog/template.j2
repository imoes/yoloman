################
# Global directivess
################

# Global values
# work_directory: Directory for spool and state files.
global(
  workDir="{{ work_directory | default('/var/spool/rsyslog') }}"
)

# Use the new non-linear engine
module(load="builtin:omfile" Template="RSYSLOG_FileFormat")

################
# Modules
################
# Load modules
# imuxsock: provides support for local system logging (e.g. via logger command)
module(load="imuxsock")

# imklog: provides kernel logging support
module(load="imklog" permitnonkernelfacility="on")

# load_immark: Whether to load the immark module.
{% if load_immark | default(False) | bool %}
module(load="immark") # provides periodic heartbeat marker.
{% endif %}

# load_imudp: Whether to load the imudp module.
# load_imudp_port: Port number for UDP syslog reception.
{% if load_imudp | default(False) | bool %}
input(type="imudp" port="{{ load_imudp_port | default(514) }}")
{% endif %}

# load_imtcp: Whether to load the imtcp module.
# load_imtcp_port: Port number for TCP syslog reception.
{% if load_imtcp | default(False) | bool %}
input(type="imtcp" port="{{ load_imtcp_port | default(514) }}")
{% endif %}

################
# Rules
################
# Log all kernel messages to the console.
# Logging much else clutters up the screen.
#kern.*                                                 /dev/console

# Log anything (except mail) of level info or higher.
# Don't log private authentication messages!
*.info;mail.none;authpriv.none;cron.none                /var/log/messages

# The authpriv file has restricted access.
authpriv.*                                              /var/log/secure

# Log all the mail messages in one place.
mail.*                                                  -/var/log/maillog

# Log cron stuff
cron.*                                                  /var/log/cron

# Everybody gets emergency messages
*.emerg                                                 :omusrmsg:*

# Save news errors of level crit and higher in a dedicated file.
uucp,news.crit                                          /var/log/spooler

# Save boot messages also to boot.log
local7.*                                                /var/log/boot.log

