[general]
# Enable or disable the mDNS reflector service
enabled = {{ enabled | lower }}

# Interface(s) to reflect mDNS traffic across (comma-separated list of interface names)
interfaces = {{ interfaces | join(', ') }}

# TTL (seconds) for reflected mDNS records
record_ttl = {{ record_ttl }}

[limits]
# Maximum number of concurrent mDNS queries to reflect
max_queries_per_second = {{ max_queries_per_second }}

# Maximum number of active mDNS reflector entries (hosts, services, etc.)
max_reflected_entries = {{ max_reflected_entries }}

[logging]
# Logging level: debug, info, notice, warning, error, critical
level = {{ log_level }}

# Path to log file (empty string or 'syslog' to use system logger)
log_file = {{ log_file | default('') }}
