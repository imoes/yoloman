# Miredo Teredo server configuration
# This file controls the Teredo relay/server behavior

# Bind address for the Teredo server (IPv4 or IPv6)
{{ bind_address }}

# UDP port to listen on for Teredo traffic
{{ udp_port }}

# Interface to bind to (optional; if empty, auto-detects)
{{ interface | default('') }}

# Client prefix (IPv6) — must be a /32 or /48 block
{{ client_prefix }}

# Teredo server address (IPv4) used for public relays
{{ server_address }}

# Enable or disable logging to syslog
{{ enable_syslog | string | lower }}

# Log level: debug, info, notice, warning, error, critical
{{ log_level }}

# Maximum number of clients allowed
{{ max_clients }}

# Minimum refresh interval (seconds) between client keep-alives
{{ min_refresh }}

# Maximum refresh interval (seconds)
{{ max_refresh }}

# Enable or disable NAT traversal (NAT-PMP/UPnP)
{{ nat_traversal | string | lower }}

# Optional: Relay server list — one per line, format: address:port
{% for relay in relays %}{{ relay.host }}:{{ relay.port }}
{% endfor %}