{
  "machine": {
    "type": "string",
    "default": "48",
    "description": "ZX Spectrum machine type to emulate: 16, 48, 48_ntsc, 128, plus2, plus2a, plus3, 2048, 2068, ts2068, pentagon, pentagon512, pentagon1024, scorpion, se.",
    "enum": [
      "16",
      "48",
      "48_ntsc",
      "128",
      "plus2",
      "plus2a",
      "plus3",
      "2048",
      "2068",
      "ts2068",
      "pentagon",
      "pentagon512",
      "pentagon1024",
      "scorpion",
      "se"
    ]
  },
  "issue2": {
    "type": "bool",
    "default": false,
    "description": "Emulate an issue 2 keyboard (early Spectrum models)."
  },
  "cmos_z80": {
    "type": "bool",
    "default": false,
    "description": "Emulate a CMOS Z80 CPU instead of NMOS."
  },
  "late_timings": {
    "type": "bool",
    "default": false,
    "description": "Emulate screen timings one T-state later than normal (observed on some real machines)."
  },
  "bw_tv": {
    "type": "bool",
    "default": false,
    "description": "Simulate a black and white television instead of colour."
  },
  "sound": {
    "type": "bool",
    "default": true,
    "description": "Enable sound output."
  },
  "sound_freq": {
    "type": "number",
    "default": 44100,
    "description": "Sound sampling frequency in Hz (e.g. 44100, 48000)."
  },
  "speaker_type": {
    "type": "string",
    "default": "TV",
    "description": "Speaker emulation type: TV, Beeper, or Unfiltered.",
    "enum": [
      "TV",
      "Beeper",
      "Unfiltered"
    ]
  },
  "volume_ay": {
    "type": "number",
    "default": 100,
    "description": "Relative volume for AY-3-8912 sound chip (0\u2013100%)."
  },
  "volume_beeper": {
    "type": "number",
    "default": 100,
    "description": "Relative volume for beeper (0\u2013100%)."
  },
  "volume_covox": {
    "type": "number",
    "default": 100,
    "description": "Relative volume for Covox (0\u2013100%); effective only when Covox interface enabled."
  },
  "volume_specdrum": {
    "type": "number",
    "default": 100,
    "description": "Relative volume for SpecDrum (0\u2013100%); effective only when SpecDrum interface enabled."
  },
  "separation": {
    "type": "string",
    "default": "None",
    "description": "AY stereo separation: None (mono), ACB, or ABC.",
    "enum": [
      "None",
      "ACB",
      "ABC"
    ]
  },
  "graphics_filter": {
    "type": "string",
    "default": "normal",
    "description": "Graphics scaling/filter: normal, 2x, 2xsai, 3x, 4x, advmame2x, advmame3x, dotmatrix, half, halfskip, hq2x, hq3x, hq4x, super2xsai, supereagle, timex15x, timex2x, timextv, tv2x, tv3x, tv4x, paltv, paltv2x, paltv3x, paltv4x.",
    "enum": [
      "2x",
      "2xsai",
      "3x",
      "4x",
      "advmame2x",
      "advmame3x",
      "dotmatrix",
      "half",
      "halfskip",
      "hq2x",
      "hq3x",
      "hq4x",
      "normal",
      "super2xsai",
      "supereagle",
      "timex15x",
      "timex2x",
      "timextv",
      "tv2x",
      "tv3x",
      "tv4x",
      "paltv",
      "paltv2x",
      "paltv3x",
      "paltv4x"
    ]
  },
  "speed": {
    "type": "number",
    "default": 100,
    "description": "Emulation speed as a percentage of real Spectrum speed (e.g., 100, 500)."
  },
  "frame_rate": {
    "type": "number",
    "default": 1,
    "description": "Frame rate ratio: Spectrum frames per real frame (e.g. 1 = 50fps, 2 = ~25fps)."
  },
  "pal_tv_use_tv2x_effect": {
    "type": "bool",
    "default": false,
    "description": "Add TV scanlines to PAL-TV scalers."
  },
  "confirm_actions": {
    "type": "bool",
    "default": true,
    "description": "Prompt for confirmation of dangerous actions (e.g., reset)."
  },
  "autosave_settings": {
    "type": "bool",
    "default": false,
    "description": "Automatically save current settings to config on exit."
  },
  "kempston_joystick": {
    "type": "bool",
    "default": false,
    "description": "Emulate Kempston joystick interface."
  },
  "kempston_mouse": {
    "type": "bool",
    "default": false,
    "description": "Emulate Kempston mouse interface."
  },
  "mouse_swap_buttons": {
    "type": "bool",
    "default": false,
    "description": "Swap left/right mouse buttons for Kempston mouse."
  },
  "fuller_box": {
    "type": "bool",
    "default": false,
    "description": "Emulate Fuller Box AY sound/joystick interface."
  },
  "melodik": {
    "type": "bool",
    "default": false,
    "description": "Emulate Melodik AY interface (48K/16K machines only)."
  },
  "interface1": {
    "type": "bool",
    "default": false,
    "description": "Emulate Sinclair Interface 1 (Microdrives, RS-232)."
  },
  "interface2": {
    "type": "bool",
    "default": true,
    "description": "Emulate Sinclair Interface 2 cartridge port."
  },
  "multiface1": {
    "type": "bool",
    "default": false,
    "description": "Emulate Multiface One."
  },
  "multiface128": {
    "type": "bool",
    "default": false,
    "description": "Emulate Multiface 128."
  },
  "multiface3": {
    "type": "bool",
    "default": false,
    "description": "Emulate Multiface 3."
  },
  "stealth_multiface1": {
    "type": "bool",
    "default": false,
    "description": "Enable stealth mode on Multiface One (invisible mode)."
  },
  "emulate_printers": {
    "type": "bool",
    "default": false,
    "description": "Enable general printer emulation (serial/parallel)."
  },
  "zx_printer": {
    "type": "bool",
    "default": false,
    "description": "Emulate ZX Printer (graphics only)."
  },
  "speccyboot": {
    "type": "bool",
    "default": false,
    "description": "Emulate SpeccyBoot Ethernet interface."
  },
  "specdrum": {
    "type": "bool",
    "default": false,
    "description": "Emulate SpecDrum sound interface."
  },
  "spectranet": {
    "type": "bool",
    "default": false,
    "description": "Emulate Spectranet Ethernet interface."
  },
  "spectranet_disable": {
    "type": "bool",
    "default": false,
    "description": "Disable Spectranet automatic page-in jumper (J2)."
  },
  "ttx2000s": {
    "type": "bool",
    "default": false,
    "description": "Emulate TTX2000S teletext adaptor."
  },
  "usource": {
    "type": "bool",
    "default": false,
    "description": "Emulate \u00b5Source interface."
  },
  "covox": {
    "type": "bool",
    "default": false,
    "description": "Emulate Covox digital sound interface (Pentagon/Scorpion)."
  },
  "simple_ide": {
    "type": "bool",
    "default": false,
    "description": "Emulate +3e\u2019s simple 8-bit IDE interface."
  },
  "zxatasp": {
    "type": "bool",
    "default": false,
    "description": "Emulate ZXATASP interface (RAM + IDE)."
  },
  "zxatasp_upload": {
    "type": "bool",
    "default": false,
    "description": "Enable ZXATASP upload jumper."
  },
  "zxatasp_write_protect": {
    "type": "bool",
    "default": false,
    "description": "Set ZXATASP write-protect jumper."
  },
  "zxcf": {
    "type": "bool",
    "default": false,
    "description": "Emulate ZXCF interface (RAM + CF slot)."
  },
  "zxcf_upload": {
    "type": "bool",
    "default": false,
    "description": "Enable ZXCF upload jumper."
  },
  "zxcf_write_protect": {
    "type": "bool",
    "default": false,
    "description": "Set ZXCF write-protect jumper (software-controlled)."
  },
  "zxmmc": {
    "type": "bool",
    "default": false,
    "description": "Emulate ZXMMC interface (CF/MMC)."
  },
  "divide": {
    "type": "bool",
    "default": false,
    "description": "Emulate DivIDE interface."
  },
  "divide_write_protect": {
    "type": "bool",
    "default": false,
    "description": "Set DivIDE write-protect jumper."
  },
  "divmmc": {
    "type": "bool",
    "default": false,
    "description": "Emulate DivMMC interface."
  },
  "divmmc_write_protect": {
    "type": "bool",
    "default": false,
    "description": "Set DivMMC write-protect jumper (EEPROM)."
  },
  "plusd": {
    "type": "bool",
    "default": false,
    "description": "Emulate +D interface."
  },
  "didaktik80": {
    "type": "bool",
    "default": false,
    "description": "Emulate Didaktik 80 disk interface."
  },
  "disciple": {
    "type": "bool",
    "default": false,
    "description": "Emulate DISCiPLE interface."
  },
  "beta128": {
    "type": "bool",
    "default": false,
    "description": "Emulate Beta 128 interface (for 48K/TC2048 machines too)."
  },
  "beta128_48boot": {
    "type": "bool",
    "default": false,
    "description": "Auto-boot TR-DOS when Beta128 enabled on 48K/TC2048."
  },
  "opus": {
    "type": "bool",
    "default": false,
    "description": "Emulate Opus Discovery interface."
  },
  "auto_load": {
    "type": "bool",
    "default": true,
    "description": "Auto-load media on File > Open."
  },
  "detect_loader": {
    "type": "bool",
    "default": true,
    "description": "Auto-detect and start tape loading routines."
  },
  "phantom_typist_mode": {
    "type": "string",
    "default": "Auto",
    "description": "Phantom typist keystroke mode: Auto, Keyword, Keystroke, Menu, Plus2A, Plus3.",
    "enum": [
      "Auto",
      "Keyword",
      "Keystroke",
      "Menu",
      "Plus2A",
      "Plus3"
    ]
  },
  "fastload": {
    "type": "bool",
    "default": true,
    "description": "Speed up tape loading by skipping delays."
  },
  "use_tape_traps": {
    "type": "bool",
    "default": true,
    "description": "Use ROM tape traps for faster loading (disabling may be needed for some TZX)."
  },
  "accelerate_loaders": {
    "type": "bool",
    "default": true,
    "description": "Accelerate tape loaders by short-circuiting loops."
  },
  "use_slt_traps": {
    "type": "bool",
    "default": true,
    "description": "Enable .SLT trap instruction support for multi-load tapes."
  },
  "mdr_cartridge_len": {
    "type": "number",
    "default": 180,
    "description": "Length of new Microdrive cartridge (blocks); clamped to 10\u2013254."
  },
  "mdr_random_len": {
    "type": "bool",
    "default": false,
    "description": "Use random Microdrive cartridge length (~180 blocks)."
  },
  "rzx_autosaves": {
    "type": "bool",
    "default": true,
    "description": "Automatically insert snapshots every 5s into RZX recordings."
  },
  "compress_rzx": {
    "type": "bool",
    "default": true,
    "description": "Compress RZX files using zlib."
  },
  "competition_mode": {
    "type": "bool",
    "default": false,
    "description": "Record RZX in competition mode (no pausing, speed limits)."
  },
  "competition_code": {
    "type": "number",
    "default": 0,
    "description": "Numeric code written to RZX competition mode files."
  },
  "embed_snapshot": {
    "type": "bool",
    "default": true,
    "description": "Embed snapshot at start of RZX recording (when starting from existing snapshot)."
  },
  "movie_compr": {
    "type": "string",
    "default": "Lossless",
    "description": "Movie compression: None, Lossless, or High.",
    "enum": [
      "None",
      "Lossless",
      "High"
    ]
  },
  "movie_stop_after_rzx": {
    "type": "bool",
    "default": true,
    "description": "Stop movie recording when RZX playback/recording ends."
  },
  "disk_try_merge": {
    "type": "string",
    "default": "Never",
    "description": "Merge B-side disk images: Never, With single-sided drives, or Always.",
    "enum": [
      "Never",
      "With single-sided drives",
      "Always"
    ]
  },
  "disk_ask_merge": {
    "type": "bool",
    "default": true,
    "description": "Prompt to confirm B-side disk merge."
  },
  "plus3_detect_speedlock": {
    "type": "bool",
    "default": false,
    "description": "Enable Speedlock detection (requires weak-sector data in image)."
  },
  "joystick_1_device": {
    "type": "string",
    "default": "",
    "description": "Joystick 1 device path (e.g. /dev/input/js0)."
  },
  "joystick_2_device": {
    "type": "string",
    "default": "",
    "description": "Joystick 2 device path (e.g. /dev/input/js1)."
  },
  "joystick_1_output": {
    "type": "number",
    "default": 0,
    "description": "Joystick 1 output type: 0=None, 1=Cursor, 2=Kempston, 3=Sinclair 1, 4=Sinclair 2, 5=Timex 1, 6=Timex 2, 7=Fuller."
  },
  "joystick_2_output": {
    "type": "number",
    "default": 0,
    "description": "Joystick 2 output type (same codes as above)."
  },
  "joystick_keyboard_output": {
    "type": "number",
    "default": 0,
    "description": "Keyboard joystick output type (same codes as above)."
  },
  "keyboard_arrows_shifted": {
    "type": "bool",
    "default": true,
    "description": "Treat arrow keys as shifted (like Spectrum+ keyboard)."
  },
  "roms": {
    "type": "list",
    "description": "Machine ROM overrides (by machine name). Items must specify 'machine' and 'file'."
  },
  "peripheral_roms": {
    "type": "list",
    "description": "Peripheral ROM overrides (by peripheral name). Items must specify 'peripheral' and 'file'."
  },
  "microdrives": {
    "type": "list",
    "description": "Microdrive images for Interface 1. Items must specify 'number' (1\u20138) and 'file'."
  },
  "ide_images": {
    "type": "list",
    "description": "IDE/CF images for various interfaces. Items must specify 'interface' (simple_ide, zxatasp, zxcf, zxmmc, divide, divmmc), 'channel' (master, slave, or 'cf' for zxcf/zxmmc), and 'file'."
  },
  "disk_images": {
    "type": "list",
    "description": "Disk images. Items must specify 'interface' (+3, beta128, plusd, didaktik80, disciple, opus), 'drive' (A, B, 1, etc.), and 'file'."
  },
  "interface2_cart": {
    "type": "string",
    "default": "",
    "description": "Interface 2 ROM cartridge image file."
  },
  "dock": {
    "type": "string",
    "default": "",
    "description": "Timex 2068 dock cartridge image file."
  },
  "teletext_addr_1": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Teletext packet server 1 hostname or IP."
  },
  "teletext_port_1": {
    "type": "number",
    "default": 19761,
    "description": "Teletext packet server 1 port."
  },
  "teletext_addr_2": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Teletext packet server 2 hostname or IP."
  },
  "teletext_port_2": {
    "type": "number",
    "default": 19762,
    "description": "Teletext packet server 2 port."
  },
  "teletext_addr_3": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Teletext packet server 3 hostname or IP."
  },
  "teletext_port_3": {
    "type": "number",
    "default": 19763,
    "description": "Teletext packet server 3 port."
  },
  "teletext_addr_4": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Teletext packet server 4 hostname or IP."
  },
  "teletext_port_4": {
    "type": "number",
    "default": 19764,
    "description": "Teletext packet server 4 port."
  },
  "rzx_file": {
    "type": "string",
    "default": "",
    "description": "RZX file to play or record to."
  },
  "snapshot_file": {
    "type": "string",
    "default": "",
    "description": "Snapshot file to load."
  },
  "tape_file": {
    "type": "string",
    "default": "",
    "description": "Tape file to open (PZX/TAP/TZX)."
  },
  "graphics_file": {
    "type": "string",
    "default": "printout.pbm",
    "description": "ZX Printer graphics output file."
  },
  "textfile": {
    "type": "string",
    "default": "printout.txt",
    "description": "Printer text output file."
  },
  "sound_device": {
    "type": "string",
    "default": "",
    "description": "Sound device string (driver+params, e.g. 'alsa09:dev=hw:1').",
    "enum": [
      "alsa09",
      "alsa",
      "aixs",
      "arts",
      "esd",
      "irix",
      "macosx",
      "nas",
      "oss",
      "sun",
      "au",
      "raw",
      "wav",
      "null",
      "debug"
    ]
  },
  "joystick_keyboard_up": {
    "type": "string",
    "default": "5",
    "description": "Keyboard key for joystick UP (e.g., '5', 'k', 'w')."
  },
  "joystick_keyboard_down": {
    "type": "string",
    "default": "6",
    "description": "Keyboard key for joystick DOWN (e.g., '6', 'j', 's')."
  },
  "joystick_keyboard_left": {
    "type": "string",
    "default": "7",
    "description": "Keyboard key for joystick LEFT (e.g., '7', 'h', 'a')."
  },
  "joystick_keyboard_right": {
    "type": "string",
    "default": "8",
    "description": "Keyboard key for joystick RIGHT (e.g., '8', 'l', 'd')."
  },
  "joystick_keyboard_fire": {
    "type": "string",
    "default": "0",
    "description": "Keyboard key for joystick FIRE (e.g., '0', 'Space')."
  }
}
