# =============================================================================
# NTPsec NTPdate Configuration
# =============================================================================
# This template configures the `ntpdate` utility (from the ntpsec package)
# to synchronize the system clock with NTP servers.
# =============================================================================

# -----------------------------------------------------------------------------
# Source of Server List
# -----------------------------------------------------------------------------
# Description: Set to 'yes' to take the server list from /etc/ntpsec/ntp.conf.
#              If set to 'no' or empty, uses the explicit NTPSERVERS list below.
# Default: 'yes'
# -----------------------------------------------------------------------------
NTPDATE_USE_NTP_CONF={{ ntpdate_use_ntp_conf | default('yes') }}

# -----------------------------------------------------------------------------
# NTP Server List
# -----------------------------------------------------------------------------
# Description: List of NTP servers to use. Multiple servers are separated by spaces.
#              This variable is ignored if NTPDATE_USE_NTP_CONF is set to 'yes'.
# Default: '0.debian.pool.ntp.org 1.debian.pool.ntp.org 2.debian.pool.ntp.org 3.debian.pool.ntp.org'
# -----------------------------------------------------------------------------
NTPSERVERS="{{ ntpdate_servers | default('0.debian.pool.ntp.org 1.debian.pool.ntp.org 2.debian.pool.ntp.org 3.debian.pool.ntp.org') }}"

# -----------------------------------------------------------------------------
# Additional Options
# -----------------------------------------------------------------------------
# Description: Additional options to pass to the ntpdate command (e.g., -u, -b, -s).
# Default: '' (empty)
# -----------------------------------------------------------------------------
NTPOPTIONS="{{ ntpdate_options | default('') }}"

# -----------------------------------------------------------------------------
# DHCP Server Ignoring
# -----------------------------------------------------------------------------
# Description: Set to 'yes' to ignore NTP servers returned by DHCP.
#              This prevents dhcpcd or similar clients from overriding configured NTP settings.
# Default: '' (empty)
# -----------------------------------------------------------------------------
IGNORE_DHCP="{{ ntpdate_ignore_dhcp | default('') }}"
