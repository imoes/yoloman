<?xml version="1.0" encoding="UTF-8"?>
<!--
  Noto Sans Gujarati Font Substitution Configuration
  Generated by Ansible. This file configures Fontconfig to substitute
  the generic 'sans-serif' family with 'Noto Sans Gujarati' for 'gu' (Gujarati) text.
-->
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!--
    Match block: Intercepts font requests for the specified language and generic family.
  -->
  <match>
    <!--
      Test: Check if the requested language contains the ISO language code.
      lang_code: ISO language code to match for font substitution.
      Default: 'gu'
    -->
    <test name="lang" compare="contains">
      <string>{{ lang_code | default('gu') }}</string>
    </test>

    <!--
      Test: Check if the requested font family matches the generic family name.
      font_family_alias: Generic font family name to match.
      Default: 'sans-serif'
    -->
    <test name="family">
      <string>{{ font_family_alias | default('sans-serif') }}</string>
    </test>

    <!--
      Edit: Prepend the specific target font name to the matched list.
      target_font_name: Specific font name to inject into the match.
      Default: 'Noto Sans Gujarati'
    -->
    <edit name="family" mode="prepend">
      <string>{{ target_font_name | default('Noto Sans Gujarati') }}</string>
    </edit>

    <!--
      Edit: Append a boolean to the fonthashint property.
      enable_hinting: Whether to append a boolean false for fonthashint editing.
      Note: Schema default is 'false' (string), which renders as the XML literal 'false'.
      Default: 'false'
    -->
    <edit name="fonthashint" mode="append">
      <bool>{{ enable_hinting | default('false') }}</bool>
    </edit>
  </match>

  <!--
    Alias block: Defines a formal alias so applications requesting the specific font
    are redirected to the generic family (or vice-versa, depending on config order).
  -->
  <alias>
    <!--
      The alias name being defined.
      target_font_name: Specific font name to inject into the match.
      Default: 'Noto Sans Gujarati'
    -->
    <family>{{ target_font_name | default('Noto Sans Gujarati') }}</family>
    <default>
      <!--
        The generic family that this alias resolves to.
        font_family_alias: Generic font family name to match.
        Default: 'sans-serif'
      -->
      <family>{{ font_family_alias | default('sans-serif') }}</family>
    </default>
  </alias>
</fontconfig>
