{
  "default_kchopts": {
    "type": "string",
    "default": "--quiet",
    "description": "Default options passed to keychain if KCHOPTS is not set in .keychainrc",
    "enum": [
      "--quiet",
      "--noask",
      "-q",
      "-Q",
      "-l",
      "-L",
      "-k",
      "--clear",
      "--confhost",
      "--confirm",
      "--absolute",
      "--ignore-missing",
      "--nocolor",
      "--nogui",
      "--noinherit",
      "--nolock",
      "--quick",
      "--eval",
      "--query",
      "--systemd",
      "--gpg2"
    ]
  },
  "default_kchopts_noask": {
    "type": "string",
    "default": "--noask",
    "description": "Flag to add to KCHOPTS if prompt is not set in .keychainrc"
  }
}
