# blanket service configuration
# (Debian trixie, blanket 0.7.0)
# blanket is a sound-mixing application for focus and sleep.
# It does not support a configuration file.
# All settings must be passed via command-line arguments.

# Note: The 'settings' variable is retained for compatibility with deployment
# tooling that may generate wrapper scripts. It is not consumed by blanket itself
# as blanket(1) does not use a configuration file.
{% if settings | default([]) | length > 0 %}
# The following settings list is provided for compatibility purposes only.
# blanket ignores configuration files and relies on command-line arguments.
{% for setting in settings %}
# - {{ setting | string }}
{% endfor %}
{% endif %}