{
  "city": {
    "type": "string",
    "default": "",
    "description": "City name (from hebcal cities database) to set location/timezone; overrides -C"
  },
  "latitude": {
    "type": "string",
    "default": "",
    "description": "Latitude in 'deg,min' format (negative = south)"
  },
  "longitude": {
    "type": "string",
    "default": "",
    "description": "Longitude in 'deg,min' format (negative = east)"
  },
  "timezone": {
    "type": "string",
    "default": "",
    "description": "Timezone identifier (e.g., 'America/New_York'); overrides -z"
  },
  "years": {
    "type": "number",
    "default": 1,
    "description": "Number of years of events to generate (default 1)"
  },
  "language": {
    "type": "string",
    "default": "he",
    "description": "Language code (ISO 639-1); allowed: ashkenazi, ashkenazi_litvish, ashkenazi_poylish, ashkenazi_standard, es, fi, fr, he, hu, pl, ru",
    "enum": [
      "ashkenazi",
      "ashkenazi_litvish",
      "ashkenazi_poylish",
      "ashkenazi_standard",
      "es",
      "fi",
      "fr",
      "he",
      "hu",
      "pl",
      "ru"
    ]
  },
  "candle_lighting_mins": {
    "type": "number",
    "default": 18,
    "description": "Minutes before sundown for candle-lighting time (default 18)"
  },
  "havdalah_mins": {
    "type": "number",
    "default": 42,
    "description": "Minutes after sundown for Havdalah (default 42)"
  },
  "output_format": {
    "type": "string",
    "default": "",
    "description": "Output date format: 'iso8601' (YYYY-MM-DD), 'european' (dd.mm.yyyy), 'tabular' (tab-delimited)"
  },
  "time_format": {
    "type": "string",
    "default": "",
    "description": "Time format: '24h' to enable 24-hour times (e.g., 18:37)"
  },
  "show_holidays": {
    "type": "bool",
    "default": true,
    "description": "Set to false to suppress holidays (-h)"
  },
  "show_hebrew_dates": {
    "type": "string",
    "default": "",
    "description": "When to show Hebrew dates: 'all' (-d), 'with_events' (-D)"
  },
  "show_omer": {
    "type": "bool",
    "default": false,
    "description": "Show Omer count (-o)"
  },
  "show_sedra": {
    "type": "string",
    "default": "",
    "description": "Show weekly Torah portion: 'weekly' (-s), 'every_day' (-S)"
  },
  "show_day_of_week": {
    "type": "bool",
    "default": false,
    "description": "Show day of week (-w)"
  },
  "show_molad": {
    "type": "bool",
    "default": false,
    "description": "Show molad on Shabbat Mevorchim (-M)"
  },
  "show_daf_yomi": {
    "type": "bool",
    "default": false,
    "description": "Show Daf Yomi (-F)"
  },
  "show_zemanim": {
    "type": "bool",
    "default": false,
    "description": "Show zemanim (Alot, Tefilah, Plag, etc.) (-Z)"
  },
  "suppress_rosh_chodesh": {
    "type": "bool",
    "default": false,
    "description": "Suppress Rosh Chodesh entries (-x)"
  },
  "show_weekly_view": {
    "type": "bool",
    "default": false,
    "description": "Weekly view: omer/zeramanim shown once per week (-W)"
  },
  "hebrew_dates_only": {
    "type": "bool",
    "default": false,
    "description": "Treat all input dates as Hebrew dates (-H)"
  },
  "suppress_years_last_two": {
    "type": "bool",
    "default": false,
    "description": "Set to false to show 2-digit year (-y); default true means 4-digit year (no -y)"
  },
  "israeli_sedra": {
    "type": "bool",
    "default": false,
    "description": "Use Israeli sedra scheme with -s/-S (-i)"
  },
  "extra_events_file": {
    "type": "string",
    "default": "",
    "description": "Path to file with user-defined events (format: month day description)"
  },
  "yahrtzeit_file": {
    "type": "string",
    "default": "",
    "description": "Path to file with yahrtzeit dates (format: month day year description)"
  }
}
