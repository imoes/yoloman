{
  "global": {
    "type": "object",
    "default": {},
    "description": "Global process-level settings for hapolicy",
    "properties": {
      "log_socket": {
        "type": "string",
        "default": "/dev/log",
        "description": "Path to the system logging socket"
      },
      "chroot": {
        "type": "string",
        "default": "/var/lib/hapolicy",
        "description": "Chroot directory for security isolation"
      },
      "user": {
        "type": "string",
        "default": "hapolicy",
        "description": "User to drop privileges to after startup"
      },
      "worker": {
        "type": "number",
        "default": 1,
        "description": "Number of worker processes to spawn"
      },
      "maxconn": {
        "type": "number",
        "default": 4096,
        "description": "Maximum number of concurrent connections per process"
      }
    }
  },
  "defaults": {
    "type": "object",
    "default": {},
    "description": "Default settings inherited by all proxy sections unless overridden",
    "properties": {
      "mode": {
        "type": "string",
        "default": "tcp",
        "description": "Proxy mode \u2014 'tcp' for Layer 4, 'http' for Layer 7"
      },
      "opt": {
        "type": "list",
        "default": [
          "tcplog"
        ],
        "description": "Optional behavior flags (e.g., 'tcplog', ' clitcpka' \u2014 will be joined with commas)"
      },
      "timeout_connect": {
        "type": "string",
        "default": "5s",
        "description": "Maximum time to wait for a connection attempt to a server"
      },
      "timeout_client": {
        "type": "string",
        "default": "50s",
        "description": "Maximum inactivity time on the client side"
      },
      "timeout_server": {
        "type": "string",
        "default": "50s",
        "description": "Maximum inactivity time on the server side"
      }
    }
  },
  "proxies": {
    "type": "list",
    "default": [],
    "description": "List of proxy instances to configure",
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique name for this proxy (used as section header, e.g., [HTTP])"
        },
        "description": {
          "type": "string",
          "default": "",
          "description": "Human-readable description (shown in comments)"
        },
        "mode": {
          "type": "string",
          "default": "http",
          "description": "Override defaults mode \u2014 'tcp' or 'http'"
        },
        "bind": {
          "type": "string",
          "default": "*:80",
          "description": "Address and port to listen on (e.g., '0.0.0.0:80', '127.0.0.1:8080')"
        },
        "log": {
          "type": "string",
          "default": "",
          "description": "Custom logging configuration (e.g., 'global', 'local0 info')"
        },
        "opt": {
          "type": "list",
          "default": [],
          "description": "Override defaults.opt \u2014 list of flags (joined with commas)"
        },
        "timeout_connect": {
          "type": "string",
          "default": "",
          "description": "Override defaults.timeout_connect"
        },
        "timeout_client": {
          "type": "string",
          "default": "",
          "description": "Override defaults.timeout_client"
        },
        "timeout_server": {
          "type": "string",
          "default": "",
          "description": "Override defaults.timeout_server"
        },
        "server": {
          "type": "list",
          "default": [],
          "description": "List of backend servers, each as 'name host:port [options]'"
        }
      },
      "required": [
        "name",
        "bind"
      ]
    }
  }
}
