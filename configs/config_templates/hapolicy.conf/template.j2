# ============================================================================
# hapolicy.conf - Generated Configuration Template
# ============================================================================
#
# NOTE: hapolicy is a command-line Perl script for greylisting and does NOT
# read this configuration file for runtime settings. All operational
# parameters are passed via command-line arguments (see hapolicy(1)).
#
# This file exists only as a placeholder to satisfy schema requirements and
# provide documentation on expected parameter structures. It is not parsed
# by the hapolicy binary.
#
# Generated by Ansible. Do not edit manually.
# ============================================================================

[global]
# --- Placeholder Global Settings ---
# These fields represent the schema structure but have no runtime effect on
# the hapolicy binary. They are documented here for reference during
# infrastructure planning.

# The socket path used for logging or IPC.
# Default: '/dev/log'
log_socket: {{ (global | default({})).log_socket | default('/dev/log') }}

# The chroot directory for the hapolicy process.
# Default: '/var/lib/hapolicy'
chroot: {{ (global | default({})).chroot | default('/var/lib/hapolicy') }}

# The OS user account under which the hapolicy process runs.
# Default: 'hapolicy'
user: {{ (global | default({})).user | default('hapolicy') }}

# The number of worker processes to spawn.
# Default: 1
worker: {{ (global | default({})).worker | default(1) }}

# The maximum number of concurrent connections.
# Default: 4096
maxconn: {{ (global | default({})).maxconn | default(4096) }}

# ============================================================================
# IMPORTANT: hapolicy Configuration via Postfix master.cf
# ============================================================================
#
# Since hapolicy does not use this config file for runtime behavior,
# real configuration is achieved by defining a service in /etc/postfix/master.cf.
#
# Example master.cf entry:
#
# 127.0.0.1:10060 inet  n       -       n       -       0      spawn
#   user=nobody argv=/usr/local/bin/hapolicy -l -s GREY1=10.0.0.1:10031:10 -s GREY2=10.0.0.2:10031:10
#
# The -s flag defines greylisting servers. Replace IP:Port:Timeout values
# with your actual hapolicy cluster endpoints.
# ============================================================================