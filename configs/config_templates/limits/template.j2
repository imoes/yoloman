# /etc/security/limits.conf
#
# This file sets the resource limits for the users logged in via PAM.
# It does not affect resource limits of the system services.
#
# Configuration files in /etc/security/limits.d/ (read in alphabetical order)
# override settings here if the domain matches.
#
# Format per line:
#   <domain>  <type>  <item>  <value>
#
# <domain>:
#   - A username, e.g., "alice"
#   - A group name with @ prefix, e.g., "@developers"
#   - "*" for default entry for all users
#   - "%" for maxlogin limit with %group syntax
#   - Note: wildcard/group limits are NOT applied to root.
#     To limit root, use the literal username "root".
#
# <type>:
#   - "soft": Enforces soft limits (用户可以超过直到 hard limit)
#   - "hard": Enforces hard limits (absolute maximum, requires root to change)
#
# <item>:
#   - core: limits the core file size (KB)
#   - data: max data size (KB)
#   - fsize: maximum filesize (KB)
#   - memlock: max locked-in-memory address space (KB)
#   - nofile: max number of open file descriptors
#   - rss: max resident set size (KB)
#   - stack: max stack size (KB)
#   - cpu: max CPU time (MIN)
#   - nproc: max number of processes
#   - as: address space limit (KB)
#   - maxlogins: max number of logins for this user
#   - maxsyslogins: max number of logins on the system
#   - priority: the priority to run user process with
#   - locks: max number of file locks the user can hold
#   - sigpending: max number of pending signals
#   - msgqueue: max memory used by POSIX message queues (bytes)
#   - nice: max nice priority allowed to raise to values: [-20, 19]
#   - rtprio: max realtime priority
#   - chroot: change root to directory (Debian-specific)
#
# The 'limits' variable is expected to be a list of dictionaries,
# where each dictionary contains keys: domain, type, item, value.
# If 'limits' is not defined or empty, no custom limits are applied.

{% for limit in limits | default([]) %}
# Limit for {{ limit.domain | default('unknown_domain') }}
# Type: {{ limit.type | default('unknown_type') }}
# Item: {{ limit.item | default('unknown_item') }}
# Value: {{ limit.value | default('unlimited') }}
{{ limit.domain }}       {{ limit.type }}    {{ limit.item }}         {{ limit.value }}
{% endfor %}
#
# End of file