# PCP GUI Configuration
# This file configures the default charts for Performance Co-Pilot (PCP) GUI replay modes.
# It is sourced by the PCP GUI application to determine which metrics to display.

# Multi-chart replay mode: space-separated list of PCP metrics or charts.
# This mode allows viewing multiple metrics/charts simultaneously during a replay session.
# Default value is typically 'pmchart pmdumptext'.
MULTI="{{ multi_charts | default('pmchart pmdumptext') }}"

# Standard replay mode: space-separated list of PCP metrics or charts.
# This mode is used for single-chart or default replay sessions.
# Default value is typically 'pmchart'.
REPLAY="{{ replay_charts | default('pmchart') }}"