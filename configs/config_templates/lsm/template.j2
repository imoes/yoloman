# Configuration for surfraw lsm (Latvian Public Media search elvi)

# browser: The web browser executable to use when opening surfraw results.
browser={{ (browser | default('sensible-browser')) }}

# escape_url_args: Whether to apply URL escaping to search arguments.
escape_url_args={{ (escape_url_args | default(true)) | lower }}

# quote: Whether to bracket arguments with quotes for exact matching.
quote={{ (quote | default(false)) | lower }}