# ==============================================================================
# alot configuration file
# ------------------------------------------------------------------------------
# This is a INI-style configuration file for `alot`, a terminal-based mail
# user agent built on top of the notmuch search engine.
#
# Structure:
#   [general]
#     - index_path     : Path to the notmuch index database (notmuch database location)
#     - notmuch_config : Path to the notmuch configuration file
#     - logfile        : Path to the log file; set to `/dev/null` to disable logging
#     - loglevel       : Log verbosity level (debug, info, warning, error)
#     - colourmode     : Terminal colour depth (1, 16, or 256)
#     - read_only      : If true, opens the notmuch database in read-only mode
# ==============================================================================

[general]
# Path to notmuch index database; corresponds to `-p`/`--mailindex-path` option.
# Default: ~/.mail
index = {{ index_path | default('~/.mail') }}

# Path to notmuch configuration file; corresponds to `-n`/`--notmuch-config` option.
# Default: ~/.notmuch/config
notmuch_config = {{ notmuch_config | default('~/.notmuch/config') }}

# Path to log file; `/dev/null` disables logging; corresponds to `-l`/`--logfile` option.
# Default: /dev/null
logfile = {{ logfile | default('/dev/null') }}

# Log verbosity: one of debug, info, warning, error; corresponds to `-d`/`--debug-level` option.
# Default: info
loglevel = {{ loglevel | default('info') }}

# Terminal colour depth: one of 1, 16, 256; corresponds to `-C`/`--colour-mode` option.
# Default: 256
colourmode = {{ colourmode | default(256) }}

# Open notmuch database in read-only mode; corresponds to `-r`/`--read-only` option.
# Default: false
read_only = {{ read_only | default(false) | lower }}