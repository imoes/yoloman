{
  "server_host": "0.0.0.0",
  "server_port": 8080,
  "server_base_url": "/bibledit",
  "storage_path": "/var/lib/bibledit-cloud",
  "security_use_https": true,
  "security_ssl_cert": "/etc/ssl/certs/bibledit.crt",
  "security_ssl_key": "/etc/ssl/private/bibledit.key",
  "security_secure_cookies": true,
  "logging_level": "warning",
  "logging_file": "/var/log/bibledit-cloud/bibledit.log",
  "features_enable_registration": false,
  "features_enable_guest_access": true,
  "features_enable_import_export": true,
  "features_enable_multi_language": true
}
