{
  "listen": {
    "type": "list",
    "default": [
      {
        "addr": "127.0.0.1",
        "port": 53
      }
    ],
    "description": "List of addresses and ports to listen on. Each item may include 'addr', 'port', 'protocol' (dns/doh/dot), and optionally 'interface'.",
    "items": {
      "type": "object",
      "fields": {
        "addr": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "IP address or hostname to bind to"
        },
        "port": {
          "type": "number",
          "default": 53,
          "description": "Port number (53 for DNS)"
        },
        "protocol": {
          "type": "string",
          "default": "dns",
          "description": "Protocol: 'dns' (UDP/TCP), 'doh', or 'dot'"
        },
        "interface": {
          "type": "string",
          "default": null,
          "description": "Network interface name (e.g., 'eth0')"
        }
      }
    }
  },
  "workers": {
    "type": "number",
    "default": 0,
    "description": "Number of worker threads. 0 = auto-detect (recommended for most deployments)"
  },
  "identity": {
    "type": "string",
    "default": "",
    "description": "Optional server identity string (visible in DNS version.ID queries if enabled)"
  },
  "log": {
    "type": "object",
    "default": {
      "level": "notice",
      "target": "syslog"
    },
    "description": "Logging configuration",
    "fields": {
      "level": {
        "type": "string",
        "default": "notice",
        "description": "Minimum log level: critical, error, warning, notice, info, debug"
      },
      "target": {
        "type": "string",
        "default": "syslog",
        "description": "Log target: 'stderr', 'syslog', or 'file'"
      },
      "file": {
        "type": "string",
        "default": "/var/log/knot/knot.log",
        "description": "Log file path (only used if target='file')"
      }
    }
  },
  "modules": {
    "type": "list",
    "default": [],
    "description": "List of Knot module names to load (e.g., 'acl', 'control', 'geoip')"
  },
  "zones": {
    "type": "list",
    "default": [],
    "description": "List of DNS zones to serve",
    "items": {
      "type": "object",
      "fields": {
        "domain": {
          "type": "string",
          "default": "",
          "description": "Zone domain name (e.g., 'example.com')"
        },
        "file": {
          "type": "string",
          "default": "",
          "description": "Path to zone file (e.g., '/var/lib/knot/zones/example.com') or 'memory://' for in-memory zones"
        },
        "storage": {
          "type": "string",
          "default": null,
          "description": "Custom storage directory for zone data (defaults to /var/lib/knot/zones/)"
        },
        "acl": {
          "type": "list",
          "default": [],
          "description": "Optional ACL rules referencing named ACL definitions",
          "items": {
            "type": "object",
            "fields": {
              "action": {
                "type": "string",
                "default": "allow",
                "description": "Action: 'allow', 'deny', 'notify', 'transfer', 'update', 'query'"
              },
              "name": {
                "type": "string",
                "default": null,
                "description": "Named ACL ID (if defined globally)"
              },
              "address": {
                "type": "string",
                "default": null,
                "description": "IP address/CIDR (e.g., '192.0.2.0/24')"
              },
              "tsig": {
                "type": "string",
                "default": null,
                "description": "TSIG key name for secure operations"
              }
            }
          }
        }
      }
    }
  },
  "control": {
    "type": "object",
    "default": {
      "listen": "/run/knot/control.sock"
    },
    "description": "Control socket settings for knotc CLI management",
    "fields": {
      "listen": {
        "type": "string",
        "default": "/run/knot/control.sock",
        "description": "Path or address:port for control socket"
      },
      "path": {
        "type": "string",
        "default": null,
        "description": "Legacy alias for 'listen' (path to Unix socket)"
      }
    }
  },
  "remotes": {
    "type": "list",
    "default": [],
    "description": "List of remote servers for AXFR, notify, or DNSSEC KSK-DS rollover",
    "items": {
      "type": "object",
      "fields": {
        "id": {
          "type": "string",
          "default": "",
          "description": "Unique remote identifier"
        },
        "address": {
          "type": "string",
          "default": "",
          "description": "IP address of remote server"
        },
        "key": {
          "type": "string",
          "default": null,
          "description": "TSIG key name for authentication"
        }
      }
    }
  },
  "acl": {
    "type": "list",
    "default": [],
    "description": "Global named ACL definitions (referenced by zones or remotes)",
    "items": {
      "type": "object",
      "fields": {
        "id": {
          "type": "string",
          "default": "",
          "description": "Unique ACL ID"
        },
        "action": {
          "type": "string",
          "default": "allow",
          "description": "Action: 'allow', 'deny', 'notify', 'transfer', 'update', 'query'"
        },
        "address": {
          "type": "string",
          "default": null,
          "description": "IP address or CIDR"
        },
        "tsig": {
          "type": "string",
          "default": null,
          "description": "TSIG key name"
        }
      }
    }
  }
}
