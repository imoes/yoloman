{
  "daemon.bind_address": "0.0.0.0",
  "daemon.port": 7902,
  "paths.pid_file": "/run/lamdaemon/lamdaemon.pid",
  "daemon.log_level": "INFO",
  "paths.log_file": "/var/log/lamdaemon/lamdaemon.log",
  "daemon.ldap_timeout": 30,
  "daemon.ldap_use_tls": true,
  "daemon.ldap_uris": [
    "ldaps://ldap1.example.com:636",
    "ldaps://ldap2.example.com:636"
  ],
  "ldap.basedn": "dc=company,dc=local",
  "ldap.binddn": "cn=lamdaemon,ou=Services,dc=company,dc=local",
  "ldap.bindpw": "********",
  "ldap.schema_version": "2.5",
  "daemon.max_connections": 50,
  "quota.mode": "soft",
  "paths.home_dir_prefix": "/home",
  "users.default_shell": "/bin/bash",
  "users.uid_start": 2000,
  "users.gid_start": 2000,
  "users.user_objectclass": "inetOrgPerson,posixAccount,organizationalPerson",
  "users.group_objectclass": "posixGroup",
  "users.uid_attr": "uid",
  "users.cn_attr": "cn",
  "users.group_cn_attr": "cn",
  "users.group_member_attr": "memberUid",
  "ldap.follow_referrals": false,
  "ldap.tls_cacert": "/etc/ssl/certs/ca-certificates.crt",
  "ldap.sasl_mech": "",
  "daemon.restart_grace_period": 15,
  "quota.scan_enabled": true,
  "quota.scan_interval": 30,
  "quota.excluded_groups": [
    "root",
    "nobody",
    "systemd-journal"
  ]
}
