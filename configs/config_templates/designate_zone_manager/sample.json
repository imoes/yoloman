{
  "log_debug": false,
  "log_file": "/var/log/designate/zone-manager.log",
  "log_max_bytes": 104857600,
  "log_backup_count": 5,
  "log_level": "INFO",
  "bind_host": "0.0.0.0",
  "bind_port": 9001,
  "workers": 2,
  "transport_url": "rabbit://guest:guest@10.0.0.10:5672//",
  "auth_strategy": "keystone",
  "keystone_auth_uri": "http://10.0.0.10:5000/v3",
  "keystone_auth_url": "http://10.0.0.10:5000/v3",
  "keystone_region_name": "RegionOne",
  "keystone_username": "designate",
  "keystone_password": "DESIGNATE_PASSWORD",
  "keystone_project_name": "service",
  "keystone_user_domain_name": "Default",
  "keystone_project_domain_name": "Default",
  "ssl_cert_file": "",
  "ssl_key_file": "",
  "enable_ssl": false,
  "enabled": true,
  "api_base_uri": "/dns/v1",
  "max_zone_name_len": 255,
  "max_recordset_name_len": 255,
  "storage_sql_connection": "mysql+pymysql://designate:DESIGNATE_DB_PWD@10.0.0.10/designate?charset=utf8mb4",
  "storage_sql_connection_recycle_time": 3600,
  "storage_sql_pool_size": 10,
  "storage_sql_pool_max_overflow": 20,
  "zone_file_dir": "/var/lib/designate/zones",
  "zone_file_format": "bind",
  "soa_ttl": 3600,
  "ns_ttl": 86400,
  "soa_email": "hostmaster@openstack.example",
  "soa_refresh": 3600,
  "soa_retry": 900,
  "soa_expire": 604800,
  "default_rrset_ttl": 3600,
  "soa_serial_offset": 0,
  "agent_enabled": true,
  "agent_rpc_queue": "designate",
  "agent_zone_action_queue": "zone_actions",
  "agent_actions_per_cycle": 10,
  "agent_poll_interval": 2,
  "agent_max_queue_length": 10000,
  "agent_rpc_timeout": 60,
  "worker_enabled": false,
  "worker_num_workers": 1,
  "worker_rpc_queue": "designate_worker",
  "api_enabled": false,
  "api_bind_host": "127.0.0.1",
  "api_bind_port": 9010,
  "api_max_request_body_size": 1048576,
  "api_enable_cors": false,
  "api_cors_allowed_origins": [
    "https://openstack.example"
  ],
  "api_enforce_ssl": false,
  "api_secure_proxy_ssl_header": "X-Forwarded-Proto",
  "api_rate_limit": 100,
  "api_rate_limit_burst": 10,
  "api_rpc_timeout": 60,
  "zone_transfer_enabled": true,
  "axfr_secondary_ips": [
    "10.0.1.10",
    "10.0.1.20"
  ],
  "zone_transfer_timeout": 30
}
