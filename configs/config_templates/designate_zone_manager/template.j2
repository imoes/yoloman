# ==============================================================================
# designate_zone_manager configuration template
#
# This template generates the INI-style configuration file for the OpenStack
# Designate Zone Manager service. The Zone Manager is responsible for
# processing zone creation, deletion, and updates, ensuring the underlying
# storage backend is consistent, and coordinating with secondary DNS servers
# via zone transfers.
#
# Self-documenting: every directive is preceded by its schema description.
# Variables use the |default() filter to ensure safe rendering even if the
# variable is undefined in the Ansible context.
# ==============================================================================

[DEFAULT]
# Enable verbose debug logging. (Boolean: true/false)
# Schema: log_debug, default: False
log_debug = {{ log_debug | default(False) | lower }}

# Path to log file. Leave empty to log to stdout.
# Schema: log_file, default: ''
log_file = {{ log_file | default('') }}

# Maximum size (in bytes) of each log file before rotation.
# Schema: log_max_bytes, default: 104857600
log_max_bytes = {{ log_max_bytes | default(104857600) }}

# Number of old log files to retain during rotation.
# Schema: log_backup_count, default: 5
log_backup_count = {{ log_backup_count | default(5) }}

# Minimum logging level (e.g., DEBUG, INFO, WARNING, ERROR).
# Schema: log_level, default: 'INFO'
log_level = {{ log_level | default('INFO') }}

# Network interface to bind the service to.
# Schema: bind_host, default: '0.0.0.0'
bind_host = {{ bind_host | default('0.0.0.0') }}

# Port for the zone manager RPC service to listen on.
# Schema: bind_port, default: 9001
bind_port = {{ bind_port | default(9001) }}

# Number of worker processes for the zone manager service.
# Schema: workers, default: 1
workers = {{ workers | default(1) }}

# Message broker connection URL (e.g., RabbitMQ).
# Schema: transport_url, default: 'rabbit://guest:guest@localhost:5672//'
transport_url = {{ transport_url | default('rabbit://guest:guest@localhost:5672//') }}

# Authentication strategy (e.g., 'keystone', 'noauth').
# Schema: auth_strategy, default: 'keystone'
auth_strategy = {{ auth_strategy | default('keystone') }}

# Keystone identity endpoint URI for authentication.
# Schema: keystone_auth_uri, default: 'http://localhost:5000/v3'
keystone_auth_uri = {{ keystone_auth_uri | default('http://localhost:5000/v3') }}

# Keystone auth URL (used for token validation).
# Schema: keystone_auth_url, default: 'http://localhost:5000/v3'
keystone_auth_url = {{ keystone_auth_url | default('http://localhost:5000/v3') }}

# Keystone region name to use.
# Schema: keystone_region_name, default: 'RegionOne'
keystone_region_name = {{ keystone_region_name | default('RegionOne') }}

# Service username for Keystone authentication.
# Schema: keystone_username, default: 'designate'
keystone_username = {{ keystone_username | default('designate') }}

# Service password for Keystone authentication (required if using keystone auth).
# Schema: keystone_password, default: ''
keystone_password = {{ keystone_password | default('') }}

# Project (tenant) name for the service.
# Schema: keystone_project_name, default: 'service'
keystone_project_name = {{ keystone_project_name | default('service') }}

# Domain name for the service user.
# Schema: keystone_user_domain_name, default: 'Default'
keystone_user_domain_name = {{ keystone_user_domain_name | default('Default') }}

# Domain name for the service project.
# Schema: keystone_project_domain_name, default: 'Default'
keystone_project_domain_name = {{ keystone_project_domain_name | default('Default') }}

# Path to SSL certificate (for TLS).
# Schema: ssl_cert_file, default: ''
ssl_cert_file = {{ ssl_cert_file | default('') }}

# Path to SSL private key (for TLS).
# Schema: ssl_key_file, default: ''
ssl_key_file = {{ ssl_key_file | default('') }}

# Enable SSL/TLS encryption on the service endpoint.
# Schema: enable_ssl, default: False
enable_ssl = {{ enable_ssl | default(False) | lower }}

[service:main]
# Enable the zone manager service.
# Schema: enabled, default: True
enabled = {{ enabled | default(True) | lower }}

# Base URI path for the DNS API.
# Schema: api_base_uri, default: '/dns/v1'
api_base_uri = {{ api_base_uri | default('/dns/v1') }}

# Maximum allowed length for zone names.
# Schema: max_zone_name_len, default: 255
max_zone_name_len = {{ max_zone_name_len | default(255) }}

# Maximum allowed length for recordset names.
# Schema: max_recordset_name_len, default: 255
max_recordset_name_len = {{ max_recordset_name_len | default(255) }}

[storage:sql]
# SQLAlchemy connection string for the backend database.
# Schema: storage_sql_connection, default: 'mysql+pymysql://designate:designate@localhost/designate?charset=utf8mb4'
connection = {{ storage_sql_connection | default('mysql+pymysql://designate:designate@localhost/designate?charset=utf8mb4') }}

# Time (seconds) before recycling database connections.
# Schema: storage_sql_connection_recycle_time, default: 3600
connection_recycle_time = {{ storage_sql_connection_recycle_time | default(3600) }}

# Size of the database connection pool.
# Schema: storage_sql_pool_size, default: 10
pool_size = {{ storage_sql_pool_size | default(10) }}

# Maximum overflow connections beyond pool size.
# Schema: storage_sql_pool_max_overflow, default: 20
pool_max_overflow = {{ storage_sql_pool_max_overflow | default(20) }}

[zone_file]
# Directory to store zone files (for file-based storage backend).
# Schema: zone_file_dir, default: '/var/lib/designate/zones'
dir = {{ zone_file_dir | default('/var/lib/designate/zones') }}

# Format of zone files (e.g., 'bind', 'tinydns').
# Schema: zone_file_format, default: 'bind'
format = {{ zone_file_format | default('bind') }}

# TTL (seconds) for SOA records.
# Schema: soa_ttl, default: 3600
soa_ttl = {{ soa_ttl | default(3600) }}

# TTL (seconds) for NS records.
# Schema: ns_ttl, default: 86400
ns_ttl = {{ ns_ttl | default(86400) }}

# Email address for SOA records (replace @ with zone name).
# Schema: soa_email, default: 'hostmaster@example.com'
soa_email = {{ soa_email | default('hostmaster@example.com') }}

# SOA refresh interval (seconds).
# Schema: soa_refresh, default: 3600
soa_refresh = {{ soa_refresh | default(3600) }}

# SOA retry interval (seconds).
# Schema: soa_retry, default: 900
soa_retry = {{ soa_retry | default(900) }}

# SOA expiration time (seconds).
# Schema: soa_expire, default: 604800
soa_expire = {{ soa_expire | default(604800) }}

# Default TTL for recordsets that do not specify TTL.
# Schema: default_rrset_ttl, default: 3600
default_rrset_ttl = {{ default_rrset_ttl | default(3600) }}

# Offset added to Unix timestamp when generating SOA serial.
# Schema: soa_serial_offset, default: 0
soa_serial_offset = {{ soa_serial_offset | default(0) }}

[agent]
# Enable the zone manager agent to process zone actions (e.g., create, delete).
# Schema: agent_enabled, default: True
enabled = {{ agent_enabled | default(True) | lower }}

# Name of the RPC queue for agent messages.
# Schema: agent_rpc_queue, default: 'designate'
rpc_queue = {{ agent_rpc_queue | default('designate') }}

# Name of the zone action queue.
# Schema: agent_zone_action_queue, default: 'zone_actions'
zone_action_queue = {{ agent_zone_action_queue | default('zone_actions') }}

# Maximum zone actions processed per polling cycle.
# Schema: agent_actions_per_cycle, default: 10
actions_per_cycle = {{ agent_actions_per_cycle | default(10) }}

# Seconds between polling for zone actions.
# Schema: agent_poll_interval, default: 2
poll_interval = {{ agent_poll_interval | default(2) }}

# Maximum number of queued actions before dropping new ones.
# Schema: agent_max_queue_length, default: 10000
max_queue_length = {{ agent_max_queue_length | default(10000) }}

# Timeout (seconds) for RPC calls from the agent.
# Schema: agent_rpc_timeout, default: 60
rpc_timeout = {{ agent_rpc_timeout | default(60) }}

[service:worker]
# Enable dedicated worker mode (rarely needed for zone manager).
# Schema: worker_enabled, default: False
enabled = {{ worker_enabled | default(False) | lower }}

# Number of worker threads in worker mode.
# Schema: worker_num_workers, default: 1
workers = {{ worker_num_workers | default(1) }}

# RPC queue name for worker mode.
# Schema: worker_rpc_queue, default: 'designate_worker'
rpc_queue = {{ worker_rpc_queue | default('designate_worker') }}

[service:api]
# Enable the internal API endpoint (for internal orchestration only; usually disabled).
# Schema: api_enabled, default: False
enabled = {{ api_enabled | default(False) | lower }}

# API bind address (internal only).
# Schema: api_bind_host, default: '127.0.0.1'
bind_host = {{ api_bind_host | default('127.0.0.1') }}

# Port for internal API.
# Schema: api_bind_port, default: 9010
bind_port = {{ api_bind_port | default(9010) }}

# Base URI path for the DNS API.
# Schema: api_base_uri, default: '/dns/v1'
api_base_uri = {{ api_base_uri | default('/dns/v1') }}

# Maximum allowed size (bytes) for API requests.
# Schema: api_max_request_body_size, default: 1048576
max_request_body_size = {{ api_max_request_body_size | default(1048576) }}

# Enable Cross-Origin Resource Sharing (CORS).
# Schema: api_enable_cors, default: False
enable_cors = {{ api_enable_cors | default(False) | lower }}

# List of allowed origins for CORS.
# Schema: api_cors_allowed_origins, default: ['http://localhost:9000']
cors_allowed_origins = {{ api_cors_allowed_origins | default(['http://localhost:9000']) | join(', ') }}

# Enforce SSL termination proxy header for HTTPS detection.
# Schema: api_enforce_ssl, default: False
enforce_ssl = {{ api_enforce_ssl | default(False) | lower }}

# HTTP header used by proxy to indicate protocol (e.g., X-Forwarded-Proto).
# Schema: api_secure_proxy_ssl_header, default: 'X-Forwarded-Proto'
secure_proxy_ssl_header = {{ api_secure_proxy_ssl_header | default('X-Forwarded-Proto') }}

# Maximum requests per second allowed.
# Schema: api_rate_limit, default: 100
rate_limit = {{ api_rate_limit | default(100) }}

# Maximum burst capacity.
# Schema: api_rate_limit_burst, default: 10
rate_limit_burst = {{ api_rate_limit_burst | default(10) }}

# Timeout (seconds) for internal RPC calls.
# Schema: api_rpc_timeout, default: 60
rpc_timeout = {{ api_rpc_timeout | default(60) }}

[service:zone_transfer]
# Enable zone transfers (AXFR/IXFR) to secondary DNS servers.
# Schema: zone_transfer_enabled, default: True
enable_zone_transfer = {{ zone_transfer_enabled | default(True) | lower }}

# List of allowed secondary DNS server IPs for zone transfers.
# Schema: axfr_secondary_ips, default: []
axfr_secondary_ips = {{ axfr_secondary_ips | default([]) | join(', ') }}

# Timeout (seconds) for outgoing zone transfers.
# Schema: zone_transfer_timeout, default: 30
zone_transfer_timeout = {{ zone_transfer_timeout | default(30) }}