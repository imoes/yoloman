# =============================================================================
# lastlog2 configuration template
# =============================================================================
# This file configures the lastlog2 tool, which queries a SQLite database
# to display user login records. It is generated by Ansible.
#
# Reference: lastlog2(8) man page
# Options mapping:
#   -d / --database : path to the SQLite DB
#   -a / --active   : exclude users with no login history
#   -b / --before   : include records older than N days
#   -t / --time     : include records more recent than N days
#   -s / --service  : display PAM service name
#   -u / --users    : specific users to report on
# =============================================================================

# -------------------------------------------------------------------------
# Path to the SQLite database file used by lastlog2.
# Corresponds to -d/--database in lastlog2(8).
# -------------------------------------------------------------------------
database_file: {{ db_path | default('/var/lib/lastlog/lastlog2.db') }}

# -------------------------------------------------------------------------
# Print last login records excluding users who have never logged in.
# Corresponds to -a/--active in lastlog2(8).
# When false (default), users who have never logged in are included.
# -------------------------------------------------------------------------
active: {{ active | default(false) | lower }}

# -------------------------------------------------------------------------
# Print only last login records older than this number of days.
# Corresponds to -b/--before in lastlog2(8).
# Set to null or omit to disable this filter (show all ages).
# -------------------------------------------------------------------------
before_days: {{ before_days | default(None) }}

# -------------------------------------------------------------------------
# Print only last login records more recent than this number of days.
# Corresponds to -t/--time in lastlog2(8).
# Set to null or omit to disable this filter.
# -------------------------------------------------------------------------
time_days: {{ time_days | default(None) }}

# -------------------------------------------------------------------------
# Display PAM service used to login in the last column.
# Corresponds to -s/--service in lastlog2(8).
# When true, the output includes the service name (e.g., sshd, login).
# -------------------------------------------------------------------------
service: {{ service | default(false) | lower }}

# -------------------------------------------------------------------------
# List of specific usernames to print records for.
# Corresponds to -u/--users in lastlog2(8).
# If empty or omitted, lastlog2 reports on all users in the database.
# -------------------------------------------------------------------------
users: {{ users | default([]) | tojson }}