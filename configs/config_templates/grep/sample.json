{
  "grep_options": [
    {
      "name": "-i"
    },
    {
      "name": "-n"
    },
    {
      "name": "-r"
    },
    {
      "name": "-m",
      "value": "10"
    },
    {
      "name": "--color",
      "value": "auto"
    },
    {
      "name": "-v",
      "value": ""
    }
  ],
  "exclude_patterns": [
    "*.log",
    "*.tmp",
    ".git"
  ],
  "exclude_dir_patterns": [
    "node_modules",
    ".cache"
  ],
  "exclude_from_file": "/etc/grep-exclude-patterns.conf"
}
