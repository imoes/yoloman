{
  "host": {
    "type": "string",
    "default": "example.com",
    "description": "Destination host name or IP address"
  },
  "protocol": {
    "type": "string",
    "default": "ipv4",
    "description": "Protocol family: ipv4 or ipv6",
    "enum": [
      "ipv4",
      "ipv6"
    ]
  },
  "method": {
    "type": "string",
    "default": "tcp",
    "description": "Traceroute method: default, icmp, tcp, udp, udplite, dccp, raw",
    "enum": [
      "default",
      "icmp",
      "tcp",
      "tcpconn",
      "udp",
      "udplite",
      "dccp",
      "raw"
    ]
  },
  "method_options": {
    "type": "string",
    "default": "syn",
    "description": "Comma-separated method-specific options passed to -O"
  },
  "fwmark": {
    "type": "number",
    "default": 0,
    "description": "Firewall mark for outgoing packets"
  },
  "source_address": {
    "type": "string",
    "default": "",
    "description": "Source IP address for probes"
  },
  "interface": {
    "type": "string",
    "default": "",
    "description": "Network interface to send packets from"
  },
  "source_port": {
    "type": "number",
    "default": 0,
    "description": "Source port for probes"
  },
  "destination_port": {
    "type": "number",
    "default": 80,
    "description": "Destination port for probes (constant for TCP/UDP)"
  },
  "max_hops": {
    "type": "number",
    "default": 30,
    "description": "Maximum number of hops (max TTL)"
  },
  "first_ttl": {
    "type": "number",
    "default": 1,
    "description": "Initial TTL to start tracing"
  },
  "queries": {
    "type": "number",
    "default": 3,
    "description": "Number of probe packets per hop"
  },
  "simultaneous_queries": {
    "type": "number",
    "default": 16,
    "description": "Number of simultaneous probe packets"
  },
  "wait_time": {
    "type": "string",
    "default": "5.0,3.0,10.0",
    "description": "Waiting time settings in format max[,here,near]"
  },
  "send_wait": {
    "type": "number",
    "default": 0,
    "description": "Minimal time interval between probes in seconds"
  },
  "tos": {
    "type": "number",
    "default": 0,
    "description": "Type of Service (TOS) for IPv4 or Traffic Control for IPv6"
  },
  "flow_label": {
    "type": "number",
    "default": 0,
    "description": "IPv6 Flow Label"
  },
  "packet_length": {
    "type": "number",
    "default": 0,
    "description": "Packet length for probes (0 for default)"
  },
  "gateways": {
    "type": "string",
    "default": "",
    "description": "Comma-separated list of gateways for source routing"
  },
  "show_extensions": {
    "type": "bool",
    "default": false,
    "description": "Show ICMP extensions (rfc4884)"
  },
  "as_path_lookups": {
    "type": "bool",
    "default": false,
    "description": "Perform AS path lookups"
  },
  "dns_resolve": {
    "type": "bool",
    "default": true,
    "description": "Resolve IP addresses to host names"
  },
  "bypass_routing": {
    "type": "bool",
    "default": false,
    "description": "Bypass normal routing tables"
  },
  "no_fragment": {
    "type": "bool",
    "default": false,
    "description": "Do not fragment probe packets"
  },
  "mtu_discovery": {
    "type": "bool",
    "default": false,
    "description": "Discover MTU along the path"
  },
  "show_backward": {
    "type": "bool",
    "default": false,
    "description": "Print backward hops"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable socket level debugging"
  },
  "extra_options": {
    "type": "string",
    "default": "",
    "description": "Additional command-line options"
  }
}
