# Exec= command specifies the absolute path to the authentication agent binary.
Exec={{ POLICYKIT_AUTH_AGENT_EXEC | default('/usr/lib/x86_64-linux-gnu/ukui-polkit/polkit-ukui-authentication-agent-1') }}

# Icon for the application in the desktop menu.
Icon=ukui-polkit

# Terminal=false indicates this is a GUI application that does not need a terminal window.
Terminal=false

# Type specifies the desktop entry type.
Type=Application

# Categories= is intentionally left empty or minimal for system agents.
Categories=

# OnlyShowIn restricts this desktop entry to specific desktop environments.
OnlyShowIn=UKUI;MATE

# Startup notification setting.
X-UKUI-StartupNotify=false

# Auto-restart setting.
X-UKUI-AutoRestart=true

# Autostart phase.
X-UKUI-Autostart-Phase=Application

# NoDisplay=true hides this entry from standard application menus; it runs in the background.
NoDisplay=true

# D-Bus startup type; 'Unique' ensures only one instance runs.
X-DBUS-StartupType=Unique

# MATE-specific autostart phase.
X-MATE-Autostart-Phase=Initialization

# MATE-specific startup notification.
X-MATE-StartupNotify=false

# MATE-specific auto-restart.
X-MATE-AutoRestart=true