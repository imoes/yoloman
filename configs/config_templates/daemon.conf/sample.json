{
  "enable_daemon": true,
  "port": 3632,
  "tempdir": "/tmp/distcc",
  "max_connections": 50,
  "allow_hosts": [
    "127.0.0.1/32",
    "::1/128",
    "192.168.1.0/24",
    "buildhost.example.com"
  ],
  "log_level": 2,
  "log_file": "/var/log/distccd.log",
  "user": "nobody",
  "compression": 1,
  "compile_timeout": 600
}
