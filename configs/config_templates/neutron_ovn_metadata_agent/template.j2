[ovn]
# The OVN Northbound connection string
ovn_nb_connection = {{ ovn_nb_connection }}

# The OVN Southbound connection string
ovn_sb_connection = {{ ovn_sb_connection }}

# The OVN metadata driver
ovn_metadata_driver = {{ ovn_metadata_driver }}

# The number of OVN metadata workers
ovn_metadata_workers = {{ ovn_metadata_workers }}

# The number of OVN metadata threads
ovn_metadata_threads = {{ ovn_metadata_threads }}

# The OVN metadata proxy port
ovn_metadata_proxy_port = {{ ovn_metadata_proxy_port }}

# The OVN metadata proxy user
ovn_metadata_proxy_user = {{ ovn_metadata_proxy_user }}

# The OVN metadata proxy password
ovn_metadata_proxy_password = {{ ovn_metadata_proxy_password }}

# The OVN metadata proxy project name
ovn_metadata_proxy_project_name = {{ ovn_metadata_proxy_project_name }}

# The OVN metadata proxy auth URL
ovn_metadata_proxy_auth_url = {{ ovn_metadata_proxy_auth_url }}

# The OVN metadata proxy auth type
ovn_metadata_proxy_auth_type = {{ ovn_metadata_proxy_auth_type }}

# The OVN metadata proxy region name
ovn_metadata_proxy_region_name = {{ ovn_metadata_proxy_region_name }}

# The OVN metadata proxy interface name
ovn_metadata_proxy_interface_name = {{ ovn_metadata_proxy_interface_name }}

# The OVN metadata proxy network type
ovn_metadata_proxy_network_type = {{ ovn_metadata_proxy_network_type }}

# The OVN metadata proxy MTU
ovn_metadata_proxy_mtu = {{ ovn_metadata_proxy_mtu }}

# The OVN metadata proxy DNS domain
ovn_metadata_proxy_dns_domain = {{ ovn_metadata_proxy_dns_domain }}

# The OVN metadata proxy DNS servers
{% for server in ovn_metadata_proxy_dns_servers %}ovn_metadata_proxy_dns_server = {{ server }}
{% endfor %}

# The OVN metadata proxy hostnames
{% for hostname in ovn_metadata_proxy_hostnames %}ovn_metadata_proxy_hostname = {{ hostname }}
{% endfor %}

# The OVN metadata proxy gateway IPs
{% for ip in ovn_metadata_proxy_gateway_ips %}ovn_metadata_proxy_gateway_ip = {{ ip }}
{% endfor %}

# The OVN metadata proxy IP ranges
{% for iprange in ovn_metadata_proxy_ip_ranges %}ovn_metadata_proxy_ip_range = {{ iprange }}
{% endfor %}

# The OVN metadata proxy security groups
{% for sg in ovn_metadata_proxy_security_groups %}ovn_metadata_proxy_security_group = {{ sg }}
{% endfor %}

# The OVN metadata proxy port security
ovn_metadata_proxy_port_security = {{ ovn_metadata_proxy_port_security }}

# The OVN metadata proxy allowed address pairs
ovn_metadata_proxy_allowed_address_pairs = {{ ovn_metadata_proxy_allowed_address_pairs }}

# The OVN metadata proxy DHCP options
