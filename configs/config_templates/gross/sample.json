  "db_conn_max_lifetime": "2h",
  "dnsbl_enabled": true,
  "dnsbl_timeout": "2s",
  "dnsbl_providers": [],
  "policy_min_delay_sec": 30,
  "policy_max_delay_sec": 3600,
  "policy_accept_after_pass_count": 1,
  "policy_reject_after_fail_count": 3
}
