{
  "listen_addr": "127.0.0.1",
  "listen_port": 2525,
  "worker_count": 4,
  "max_concurrent_connections": 1024,
  "log_level": "info",
  "log_file": "/var/log/gross/gross.log",
  "db_type": "sqlite",
