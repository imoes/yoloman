# Defaults for pgpool initscript
# sourced by /etc/init.d/pgpool

# Syslog facility for pgpool logs (e.g., local0, daemon).
# It must be one of the available syslog facilities.
PGPOOL_SYSLOG_FACILITY={{ syslog_facility | default('local0') }}

# Enable debugging messages in the log.
# Set to 'yes' to enable, otherwise disabled.
PGPOOL_LOG_DEBUG={{ log_debug | default(False) | ternary('yes', 'no') }}