{
  "listen_addresses": "*",
  "port": 54321,
  "socket_directories": "/var/run/pgpool",
  "num_init_children": 32,
  "reserved_connections": 4,
  "connection_cache_size": 16,
  "health_check_period": 10,
  "health_check_timeout": 20,
  "backends": [
    {
      "hostname": "pg1.example.com",
      "port": 5432,
      "weight": 1.0,
      "data_directory": "/var/lib/postgresql/14/main",
      "status": "up"
    },
    {
      "hostname": "pg2.example.com",
      "port": 5432,
      "weight": 1.0,
      "data_directory": "/var/lib/postgresql/14/main",
      "status": "up"
    },
    {
      "hostname": "pg3.example.com",
      "port": 5432,
      "weight": 0.5,
      "data_directory": "/var/lib/postgresql/14/main",
      "status": "up"
    }
  ],
  "enable_pool_hba": true,
  "ssl": false,
  "ssl_cert": "/etc/ssl/certs/pgpool.crt",
  "ssl_key": "/etc/ssl/private/pgpool.key",
  "ssl_ca_cert": "/etc/ssl/certs/ca.crt",
  "ssl_ca_cert_dir": "/etc/ssl/certs",
  "log_destination": "stderr",
  "log_line_prefix": "%t [%p]: [%l-1] user=%u,db=%d,app=%a,client=%h ",
  "log_connections": false,
  "log_hostname": true,
  "log_statement": false,
  "log_per_node_statement": true,
  "log_pooler_errors": true,
  "use_watchdog": false,
  "wd_hostname": "localhost",
  "wd_port": 9000,
  "replication_mode": false,
  "load_balance_mode": true,
  "master_slave_mode": true,
  "master_slave_sub_mode": "stream",
  "slot_name": "pgpool",
  "failover_when_quorum_exists": true,
  "failover_require_consensus": true,
  "health_check_user": "pgpool",
  "health_check_password": "secret_password",
  "ssl_mode": "prefer"
}
