{# ============================================================================= #}
{# stoken configuration file template                                               #}
{# Path: ~/.stokenrc                                                                #}
{# This file stores sensitive RSA SecurID token data. It should be protected        #}
{# with restrictive file permissions (e.g., 0600) as it contains encrypted seeds   #}
{# and authentication credentials.                                                  #}
{# ============================================================================= #}

{# The encrypted token seed data. Typically base64 encoded. Empty if not set.      #}
{# Variable: seed                                                                   #}
seed={{ seed | default('') }}

{# The hash of the password used to encrypt the seed. Empty if the token is         #}
{# stored without a password.                                                       #}
{# Variable: pwdhash                                                                #}
pwdhash={{ pwdhash | default('') }}

{# The Personal Identification Number (PIN) required for the token. Empty if        #}
{# no PIN is used or stored.                                                        #}
{# Variable: pin                                                                    #}
pin={{ pin | default('') }}

{# The device ID (GUID) bound to the token. Used to decrypt class-bound tokens.     #}
{# Variable: devid                                                                  #}
devid={{ devid | default('') }}

{# The expiration date of the token as a Unix timestamp. 0 indicates the token      #}
{# does not expire.                                                                 #}
{# Variable: exp                                                                    #}
exp={{ exp | default(0) }}

{# The format type of the token, such as 'ctf' (compressed token format) or         #}
{# 'sdtid' (XML format).                                                            #}
{# Variable: type                                                                   #}
type={{ type | default('ctf') }}

{# The username associated with the token, often used in sdtid formats. Empty if    #}
{# not specified.                                                                   #}
{# Variable: user                                                                   #}
user={{ user | default('') }}

{# The serial number of the token hardware or software instance. Empty if not       #}
{# specified.                                                                       #}
{# Variable: serial                                                                 #}
serial={{ serial | default('') }}

{# The Message Authentication Code (MAC) checksum used to verify the integrity      #}
{# of the token data. Empty if not specified.                                       #}
{# Variable: mac                                                                    #}
mac={{ mac | default('') }}