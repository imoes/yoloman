# Configuration file for input-remapper-daemon
# Generated by Ansible Jinja2 template. This file is self-documenting:
# each variable reference includes its schema default and description.
#
# Syntax per line:
#   <device_path> <input_type> <input_code> <target_type> <target_code>
#
# Supported input types:
#   EV_KEY  - Standard key events
#   EV_ABS  - Absolute axis events (e.g., joysticks)
#   EV_REL  - Relative axis events (e.g., mice)
#
# Supported target types:
#   EV_KEY  - Map to a standard key
#   EV_ABS  - Map to an absolute axis
#   EV_REL  - Map to a relative axis
#   CLEAR   - Clear pending events for this input
#   IGNORE  - Drop the event entirely
#   SYNC    - Insert a sync barrier
#   NOP     - No operation (passthrough)
#
# Mappings are defined in the 'mappings' variable, which is a list of dictionaries.
# If 'mappings' is not provided or is empty, the configuration will be empty.

# mappings: List of input-to-output mapping rules. Each rule defines how an input event from a device should be transformed.
{% for mapping in mappings | default([]) %}
# Mapping Rule #{{ loop.index }}
# Description: Defines how an input event from a device should be transformed.
# Each rule consists of:
#   1. device_path: The path to the input device file (e.g., /dev/input/event0).
#   2. input_type:  The type of input event to match (e.g., EV_KEY).
#   3. input_code:  The specific code of the input event (e.g., KEY_A).
#   4. target_type: The type of event to generate as output (e.g., EV_KEY).
#   5. target_code: The specific code of the target event (e.g., KEY_B).

# device_path: The path to the input device file.
# input_type: The type of input event to match.
# input_code: The specific code of the input event.
# target_type: The type of event to generate as output.
# target_code: The specific code of the target event.
{{ mapping.get('device_path') | default('/dev/input/event0') }} {{ mapping.get('input_type') | default('EV_KEY') }} {{ mapping.get('input_code') | default('KEY_A') }} {{ mapping.get('target_type') | default('EV_KEY') }} {{ mapping.get('target_code') | default('KEY_B') }}
{% endfor %}
{% if mappings | default([]) | length == 0 %}
# No mappings defined. The daemon will have no remapping rules.
{% endif %}