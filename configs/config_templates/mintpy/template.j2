# MintPy Configuration
# This is the main configuration file for MintPy (Miami InSAR Time-series software in PYthon).
# It controls the default parameters for the `smallbaselineApp.py` routine and other toolbox commands.

# Path to the project directory containing the input data (ISCE/ARIA/etc.)
project.directory: {{ project.directory | default('/path/to/insar/project') }}

# Reference date for the time series analysis (ISO format: YYYY-MM-DD)
reference.date: {{ reference_date | default('2015-10-01') }}

# Reference X coordinate (UTM or Lon) for the reference point
reference.x: {{ reference_x | default(500000) }}

# Reference Y coordinate (UTM or Lat) for the reference point
reference.y: {{ reference_y | default(4500000) }}

# Reference pixel index (row) if not using coordinate-based reference
reference_pixel_index: {{ reference_pixel_index | default(0) }}

# Reference pixel index (column) if not using coordinate-based reference
reference_pixel_column: {{ reference_pixel_column | default(0) }}

# Path to the lookup table (LUT) file for coordinate conversion
lookup.table.file: {{ lookup_table.file | default('geometryRadar.h5') }}

# Path to the network of interferograms file
network.file: {{ network.file | default('inputs/network.txt') }}

# Path to the phase files (interferograms) directory
phase.directory: {{ phase.directory | default('inputs/phase') }}

# Path to the coherence files directory
coherence.directory: {{ coherence.directory | default('inputs/coherence') }}

# Mask file to exclude noisy pixels (e.g., generated by generate_mask.py)
mask.file: {{ mask.file | default('inputs/mask.h5') }}

# Reference date for ionospheric correction (if using iono_tec)
iono.reference.date: {{ iono.reference_date | default('2015-10-01') }}

# List of tropospheric correction methods to apply
# Options: tropo_gacos, tropo_pyaps3, tropo_phase_elevation
tropo.methods: {{ tropo.methods | default(['tropo_gacos']) }}

# List of DEM error correction files
# Each item can be a string (path) or a dict with 'file' and 'type'
tropo.gacos.files: {{ tropo.gacos.files | default([]) }}

# List of weather model files for PyAPS correction
tropo.pyaps.files: {{ tropo.pyaps.files | default([]) }}

# Velocity estimation method
# Options: ts2vel, ts2vel_robust
velocity.method: {{ velocity.method | default('ts2vel') }}

# Maximum number of iterations for time series inversion
inversion.max.iterations: {{ inversion.max_iterations | default(100) }}

# Convergence tolerance for inversion
inversion.tolerance: {{ inversion.tolerance | default(1e-5) }}

# Output directory for results
output.directory: {{ output.directory | default('output') }}

# Whether to plot the coherence matrix during processing
plot.coherence.matrix: {{ plot_coherence_matrix | default(false) | lower }}

# Whether to plot the network of interferograms
plot.network: {{ plot_network | default(false) | lower }}

# Format of the output files
# Options: hdf5, netcdf, geotiff
output.format: {{ output.format | default('hdf5') }}

# List of steps to run in smallbaselineApp
# Options: load_data, ifgram_inversion, timeseries2velocity, etc.
# If empty, all available steps are run.
run.steps: {{ run.steps | default([]) }}
