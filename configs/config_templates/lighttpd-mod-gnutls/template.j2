# /usr/share/doc/lighttpd/ssl.txt
# -*- conflicts: mbedtls, nss, ssl, wolfssl -*-

# Load the GnuTLS module to enable SSL/TLS support.
# Without this, Lighttpd cannot handle HTTPS connections using GnuTLS.
server.modules += ( "mod_gnutls" )

# Path to the SSL PEM certificate and key file.
# This file must contain the server certificate followed by the private key.
# Ensure file permissions are restrictive (e.g., 600) as it contains private keys.
ssl.pemfile = "{{ ssl_pemfile | default('/etc/lighttpd/server.pem') }}"

# Define the SSL/TLS listener socket.
# Binds the SSL-enabled server to a specific IP address and port.
# If 'ssl_bind_address' is '0.0.0.0', it listens on all available interfaces.
# If 'ssl_bind_address' is empty or omitted, Lighttpd uses its default behavior.
$SERVER["socket"] == "{{ ssl_bind_address | default('0.0.0.0') }}:{{ ssl_bind_port | default('443') }}" {
	# Enable SSL engine for this socket block.
	# This inherits global ssl.* settings (like ssl.pemfile) unless overridden.
	ssl.engine  = "enable"
}

# Include an external script to automatically configure IPv6 support.
# This script attempts to enable IPv6 listening for the same port defined above.
# If the system does not support IPv6, this usually fails silently or is ignored.
include_shell "/usr/share/lighttpd/use-ipv6.pl {{ ssl_bind_port | default('443') }}"
