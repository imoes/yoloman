# Nice value for the BackupPC daemon (e.g., 0, 10, 19). Higher means lower priority.
NICE={{ (nice_value | default(0)) | int }}

# IONICE setting for the BackupPC daemon (e.g., 'idle', 'best-effort:6'). Empty string disables IONICE.
{%- if ionice_setting is defined and ionice_setting | trim | length > 0 %}
IONICE={{ ionice_setting }}
{%- else %}
IONICE={{ ionice_setting | default('') }}
{%- endif %}