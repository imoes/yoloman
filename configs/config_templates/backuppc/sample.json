{
  "backup_dir": "/var/lib/backuppc",
  "install_dir": "/usr/share/backuppc",
  "rsyncd_password": "secret_rsync_pass",
  "rsyncd_user": "backuppc",
  "rsync_client_extra_args": "--bwlimit=5000 --compress-level=6",
  "rsync_client_restore_extra_args": "--numeric-ids",
  "xfer_method": "rsync",
  "log_dir": "/var/log/backuppc",
  "cgi_url": "https://backuppc.internal.example.com/backuppc",
  "cgi_bin_dir": "/usr/share/backuppc/cgi-bin",
  "cgi_image_dir": "/usr/share/backuppc/pc",
  "cgi_temp_dir": "/var/lib/backuppc/tmp",
  "admin_users": [
    "backup_admin",
    "ops_lead"
  ],
  "cgi_user_admin_restrict": true,
  "compress_level": 5,
  "full_period": "6.95",
  "incr_period": "0.95",
  "full_age_max": 21,
  "incr_age_max": 7,
  "max_backups": 5,
  "bpcp_d_period": 7,
  "bpcp_d_retention": 14,
  "ping_max_msec": 300,
  "client_timeout": 14400,
  "paranoia": true,
  "global_exclude_patterns": [
    {
      "name": "exclude_logs_tmp",
      "rsync_extra_args": [
        "--exclude=*.log",
        "--exclude=/var/log/*",
        "--exclude=/tmp/*"
      ],
      "rsync_backup_share_name": "/",
      "rsync_restore_extra_args": [
        "--numeric-ids"
      ],
      "rsync_client_restore_extra_args": [
        "--numeric-ids"
      ]
    },
    {
      "name": "exclude_caches",
      "rsync_extra_args": [
        "--exclude=~/Library/Caches",
        "--exclude=.cache"
      ],
      "rsync_backup_share_name": "C$",
      "rsync_restore_extra_args": [],
      "rsync_client_restore_extra_args": []
    }
  ],
  "host_config_dir": "/etc/backuppc/hosts",
  "db_backend": "mysql",
  "db_host": "db.internal.example.com",
  "db_name": "backuppc_meta",
  "db_user": "backuppc_rw",
  "db_pass": "db_secret_pass_123",
  "db_port": 3306,
  "email_from_user": "backuppc-alerts@example.com",
  "email_transport": "smtp",
  "email_smtp_host": "smtp.example.com",
  "email_smtp_port": 587,
  "ssh_args": [
    "-o",
    "StrictHostKeyChecking=no",
    "-o",
    "UserKnownHostsFile=/dev/null",
    "-l",
    "root"
  ],
  "ssh_client_args": [
    "-o",
    "StrictHostKeyChecking=no"
  ],
  "lock_dir": "/var/lib/backuppc/lock",
  "tmp_dir": "/var/lib/backuppc/tmp",
  "queue_dir": "/var/lib/backuppc/queue",
  "queue_max": 30,
  "global_rsync_extra_args": [
    "--exclude=*.tmp",
    "--exclude=*.swap",
    "--exclude=/proc/*"
  ],
  "global_rsync_restore_extra_args": [
    "--numeric-ids"
  ],
  "archive_enabled": true,
  "archive_client_extra_args": "--bwlimit=1000",
  "archive_client_restore_extra_args": "",
  "archive_method": "rsync",
  "archive_paranoia": false
}
