{
  "interfaces": {
    "type": "list",
    "default": null,
    "items": {
      "type": "string"
    },
    "description": "Interfaces Kea listens on for DHCPv4 (e.g. eth0, or eth0/192.0.2.1). Empty keeps the shipped empty list \u2014 Kea then serves no interface."
  },
  "renew_timer": {
    "type": "number",
    "default": 900,
    "description": "renew-timer (T1), seconds."
  },
  "rebind_timer": {
    "type": "number",
    "default": 1800,
    "description": "rebind-timer (T2), seconds."
  },
  "valid_lifetime": {
    "type": "number",
    "default": 3600,
    "description": "valid-lifetime of a lease, seconds."
  },
  "subnet4": {
    "type": "list",
    "required": true,
    "default": null,
    "description": "The IPv4 subnets Kea serves \u2014 a value only the site has. Unset renders the shipped example (192.0.2.0/24), which the wizard refuses to deploy.",
    "items": {
      "type": "object",
      "properties": {
        "subnet": {
          "type": "string",
          "description": "Subnet in CIDR form, e.g. 192.0.2.0/24"
        },
        "pool_start": {
          "type": "string",
          "description": "First address handed out"
        },
        "pool_end": {
          "type": "string",
          "description": "Last address handed out"
        },
        "routers": {
          "type": "string",
          "description": "option routers (comma-separated)"
        },
        "dns_servers": {
          "type": "string",
          "description": "option domain-name-servers (comma-separated)"
        }
      }
    }
  }
}
