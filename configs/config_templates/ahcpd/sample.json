{
  "listen_address": "::",
  "interfaces": [
    "eth0",
    "wlan0"
  ],
  "mode": "server",
  "pool_prefix": "2001:db8:acad::/48",
  "prefix_lifetime": 172800,
  "prefix_preferred_lifetime": 86400,
  "address_ranges": [
    {
      "start": "2001:db8:acad::1",
      "end": "2001:db8:acad::ff",
      "description": "Primary client range"
    },
    {
      "start": "2001:db8:acad::100",
      "end": "2001:db8:acad::1ff",
      "description": "IoT devices"
    }
  ],
  "dns_servers": [
    "2001:db8::1",
    "2001:db8::2"
  ],
  "ntp_servers": [
    "time.google.com",
    "pool.ntp.org"
  ],
  "domain_search": [
    "home.lan",
    "mesh.local"
  ],
  "lease_file": "/var/lib/ahcpd/leases",
  "log_level": "info",
  "ipv4_fallback": "auto"
}
