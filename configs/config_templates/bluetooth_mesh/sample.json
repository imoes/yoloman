{
  "mesh_enabled": true,
  "mesh_state_dir": "/var/lib/bluetooth/mesh",
  "mesh_key_dir": "/etc/bluetooth/mesh-keys",
  "max_mesh_nodes": 20,
  "max_relay_buffer": 128,
  "relay_expiry_time": 120,
  "beacon_interval": 10,
  "gatt_proxy_enabled": true,
  "friend_enabled": false,
  "max_friend_connections": 4,
  "low_power_node_enabled": false,
  "max_low_power_nodes": 2,
  "poll_timeout": 30,
  "friendship_retry_timeout": 5,
  "extra_config": [
    {
      "key": "DebugLevel",
      "value": "0"
    },
    {
      "key": "NetKeyRotateInterval",
      "value": "7200"
    }
  ]
}
