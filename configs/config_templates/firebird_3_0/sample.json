{
  "root_dir": "/opt/firebird",
  "tcpip_port": 3050,
  "tcpip_bind_address": "127.0.0.1",
  "max_connect_count": 50,
  "security_database_path": "/opt/firebird/security2.fdb",
  "default_database_path": "/var/lib/firebird/3.0/data",
  "log_filename": "/var/log/firebird/firebird.log",
  "log_max_size": 100,
  "trace_sql": false,
  "trace_auth": true,
  "trace_filename": "/var/log/firebird/trace.log",
  "default_db_cache_pages": 4096,
  "temp_cache_limit": 16384,
  "transaction_memory_limit": 256,
  "lock_hash_slots": 262144,
  "shadow_path": "/var/lib/firebird/3.0/shadows",
  "remote_access": true,
  "user_password_policy": true,
  "idle_connection_timeout": 1200,
  "worker_threads": 30,
  "query_timeout": 0,
  "max_open_files": 2048,
  "alias_resolution": [
    "/opt/firebird/aliases.conf",
    "/etc/firebird/aliases.conf"
  ]
}
