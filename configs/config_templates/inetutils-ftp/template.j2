# =============================================================================
# inetutils-ftp Client Configuration Template
# =============================================================================
# This template generates the configuration file for the inetutils FTP client.
# It controls interactive behavior, transfer modes, and file handling options.
# All variables use sensible defaults to ensure the template is safe to render
# without explicit variable definitions.
# =============================================================================

# -------------------------------------------------------------------------
# verbose: Enable verbose mode to display FTP server responses and transfer
# statistics. When enabled, detailed protocol exchanges and byte counts
# are shown in the terminal.
# -------------------------------------------------------------------------
verbose={{ verbose|default(true) | lower }}

# -------------------------------------------------------------------------
# passive: Enable passive mode transfer (PASV) for connections behind
# firewalls. In passive mode, the client initiates both the control and
# data connections, which is required when the client is behind a NAT or
# strict firewall that blocks incoming active data connections.
# -------------------------------------------------------------------------
passive={{ passive|default(false) | lower }}

# -------------------------------------------------------------------------
# no_prompt: Turns off interactive prompting during multiple file transfers
# (mget/mput/mdelete). When true, the client will transfer or delete files
# without asking for user confirmation for each file, speeding up batch
# operations.
# -------------------------------------------------------------------------
no_prompt={{ no_prompt|default(false) | lower }}

# -------------------------------------------------------------------------
# no_glob: Disables filename globbing (wildcard expansion) for file transfer
# commands. When true, characters like '*' and '?' are treated as literal
# filenames rather than patterns, preventing accidental matching of unwanted
# files.
# -------------------------------------------------------------------------
no_glob={{ no_glob|default(false) | lower }}

# -------------------------------------------------------------------------
# no_edit: Disables command line editing in the ftp interactive shell. When
# true, the user cannot use arrow keys or history expansion to edit previous
# commands, reverting to a simpler line-by-line input method.
# -------------------------------------------------------------------------
no_edit={{ no_edit|default(false) | lower }}

# -------------------------------------------------------------------------
# no_login: Restrains ftp from attempting auto-login via .netrc upon initial
# connection. When true, the client will always prompt for credentials even
# if a .netrc file exists, adding an extra layer of security for sensitive
# transfers.
# -------------------------------------------------------------------------
no_login={{ no_login|default(false) | lower }}

# -------------------------------------------------------------------------
# default_type: Default file transfer type.
# Options:
#   - ascii: Text mode (default), converts line endings for remote systems.
#   - binary: Image mode, transfers files byte-for-byte without conversion.
#   - image: Alias for binary.
# -------------------------------------------------------------------------
default_type={{ default_type|default("ascii") }}

# -------------------------------------------------------------------------
# cr_stripping: Toggle carriage return stripping during ASCII type file
# retrieval. When true, carriage return characters (CR) are stripped from
# the input stream, ensuring Unix-style line endings. Disable if the remote
# system requires CR preservation (e.g., some mainframes).
# -------------------------------------------------------------------------
cr_stripping={{ cr_stripping|default(true) | lower }}

# -------------------------------------------------------------------------
# remote_umask: Set the default umask on the remote server for uploaded files.
# Value is interpreted as an octal number (e.g., 022). A value of 0 means
# the server's default umask is used or inherited.
# -------------------------------------------------------------------------
remote_umask={{ remote_umask|default(0) }}

# -------------------------------------------------------------------------
# idle_timeout: Set the inactivity timer on the remote server in seconds.
# If the connection is idle for this duration, the server may close it.
# Set to 0 to disable timeout or keep current server settings.
# -------------------------------------------------------------------------
idle_timeout={{ idle_timeout|default(0) }}

# -------------------------------------------------------------------------
# ntrans: Set or unset filename character translation mechanism.
# Format: "inchars,outchars" where characters in 'inchars' are translated
# to corresponding characters in 'outchars'. Useful for handling legacy
# character sets. Leave empty to disable translation.
# -------------------------------------------------------------------------
ntrans={{ ntrans|default("") }}

# -------------------------------------------------------------------------
# nmap: Set or unset filename mapping mechanism.
# Format: "inpattern,outpattern". Allows mapping complex filename patterns.
# Leave empty to disable mapping.
# -------------------------------------------------------------------------
nmap={{ nmap|default("") }}