{
  "interfaces": [
    "eth0",
    "ens160"
  ],
  "port": 2055,
  "tcp_port": 0,
  "base_dir": "/var/cache/nfdump",
  "archive_dir": "archive",
  "retention_days": 30,
  "bpf_filter": "udp port 2055",
  "flush_timeout": 15,
  "rotate_interval": 300,
  "compress": "true",
  "format": "extended",
  "pidfile": "/run/nfcapd.pid",
  "user": "nfdump",
  "group": "nfdump",
  "daemonize": "true",
  "sflow_extended": "false",
  "template_cache": "true",
  "mempool_size": 32,
  "max_open_files": 0,
  "skip_stale": 0,
  "extra_opts": ""
}
