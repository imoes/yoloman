{
  "threads": 4,
  "recursion_level": 2,
  "timeout": 30,
  "user_agent": "MyBot/1.0",
  "check_extern": true,
  "ignore_robots": false,
  "ignore_url": [
    "/admin/",
    "/tmp/"
  ],
  "no_follow_url": [
    "/external-link/"
  ],
  "user": "testuser",
  "output_type": "html",
  "file_outputs": [
    "html",
    "csv"
  ],
  "verbose": true,
  "no_status": false,
  "http_proxy": "http://proxy.example.com:8080",
  "http_user": "proxyuser",
  "http_password": "proxypass",
  "ftp_proxy": null,
  "ftp_user": "anonymous",
  "ftp_password": "anonymous@",
  "cookiefiles": [
    "/etc/linkchecker/cookies.txt"
  ],
  "debug_loggers": [
    "checking"
  ]
}
