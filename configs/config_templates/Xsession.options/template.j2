# /etc/X11/Xsession.options — global X session configuration options
# Each line is a key=value pair; supported keys control X session behavior.
# Options prefixed with 'no-' disable the corresponding feature.
# Lines starting with '#' are comments and ignored.
{% for option in options %}# {{ option.comment | default('') }}
{{ option.key }}{% if option.value is not none %}={{ option.value }}{% endif %}
{% endfor %}