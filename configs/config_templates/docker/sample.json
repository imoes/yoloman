{
 "data_root": "/mnt/docker-data",
 "debug": false,
 "default_address_pool": [
  {
   "base": "10.100.0.0/16",
   "size": 24
  },
  {
   "base": "172.30.0.0/16",
   "size": 24
  }
 ],
 "default_runtime": "runc",
 "default_ulimits": [
  {
   "hard": 262144,
   "name": "nofile",
   "soft": 102400
  },
  {
   "hard": 65536,
   "name": "nproc",
   "soft": 65536
  }
 ],
 "disable_oom_killer": false,
 "dns": [
  "1.1.1.1",
  "10.0.0.10"
 ],
 "dns_opts": [
  "rotate"
 ],
 "dns_search": [
  "cluster.local",
  "svc.cluster.local"
 ],
 "exec_opt_cgroup_driver": "systemd",
 "experimental": false,
 "fixed_cidr": "172.20.0.0/16",
 "fixed_cidr_v6": "fd00:dead:beef::/48",
 "host": [
  "unix:///var/run/docker.sock",
  "tcp://0.0.0.0:2376"
 ],
 "insecure_registries": [
  "registry.internal:5000"
 ],
 "ipv6_enable": true,
 "labels": [
  "node.role=manager",
  "env=production"
 ],
 "live_restore": true,
 "log_driver": "json-file",
 "log_opts": {
  "max-file": "5",
  "max-size": "50m"
 },
 "max_concurrent_downloads": 10,
 "max_concurrent_uploads": 10,
 "max_download_attempts": 10,
 "metrics_addr": "0.0.0.0:9323",
 "metrics_expensive": false,
 "plugins": {},
 "registry_mirrors": [
  "https://docker.mirror.example.com"
 ],
 "runtimes": [
  {
   "args": [
    "--config",
    "/etc/kata-containers/configuration.toml"
   ],
   "name": "kata",
   "path": "/usr/bin/kata-runtime"
  }
 ],
 "storage_driver": "overlay2",
 "userns_mode": "default"
}
