{
  "qgis_project_file": "/srv/qgis/projects/main.qgs",
  "cache_directory": "/var/cache/qgis-server",
  "cache_size_mb": 1024,
  "log_level": "2",
  "parallel_rendering": true,
  "max_threads": 4,
  "auth_database_path": "/etc/qgis/qgis-server/auth.db",
  "extra_env": [
    {
      "var_name": "QGIS_SERVER_PLUGIN_PATH",
      "var_value": "/opt/qgis-plugins:/usr/local/share/qgis/plugins"
    },
    {
      "var_name": "GDAL_CACHEMAX",
      "var_value": "512"
    }
  ]
}
