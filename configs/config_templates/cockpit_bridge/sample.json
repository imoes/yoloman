{
  "origins": [
    "https://cockpit.example.com",
    "https://localhost:9090"
  ],
  "protocol_header": "X-Forwarded-Proto",
  "forwarded_for_header": "X-Forwarded-For",
  "max_startups": 10,
  "login_title": "Example Corp \u2014 Server Management",
  "login_to": true,
  "require_host": false,
  "allow_unencrypted": false,
  "compression": true,
  "client_cert_auth": false,
  "url_root": "",
  "log_fatal": "criticals",
  "idle_timeout": 15,
  "banner_file": "/etc/cockpit/login-banner.txt",
  "max_connections": 16
}
