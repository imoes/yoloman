# Logrotate configuration for iptraf-ng
# This block applies log rotation rules to all log files generated by iptraf-ng.
/var/log/iptraf-ng/*.log {
    # Rotate logs every period (daily/weekly/monthly/etc depending on logrotate config)
    # compress:
    #   Compress log files with gzip to save disk space.
    compress

    # delaycompress:
    #   Postpone compression of the most recent log file until the next rotation cycle.
    #   This ensures that any process still writing to the current log file can do so
    #   without interruption, and the file is only compressed in the subsequent rotation.
    delaycompress

    # missingok:
    #   If the log file is missing (e.g., deleted manually), do not display an error message.
    #   This prevents logrotate from failing if iptraf-ng has not yet created the file.
    missingok

    # notifempty:
    #   Do not rotate the log file if it is empty.
    #   This avoids creating empty compressed archives for periods where no traffic was captured.
    notifempty

    # rotate {{ iptraf_log_rotate_count | default(4) }}:
    #   Keep the specified number of rotated log files before deleting the oldest ones.
    #   Default is 4, meaning 4 archived logs are kept alongside the current one.
    rotate {{ iptraf_log_rotate_count | default(4) }}

    # create 0600 root root:
    #   Create new log files after rotation with the specified permissions, user, and group.
    #   0600: Only the owner (root) has read and write permissions.
    #   root root: Owned by root user and root group.
    create 0600 root root
}
