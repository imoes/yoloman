{
  "project_name": {
    "type": "string",
    "default": "",
    "description": "The name of the project; used to generate full Gruntfile.js skeleton"
  },
  "lint.files": {
    "type": "list",
    "default": [
      "src/**/*.js",
      "test/**/*.js"
    ],
    "description": "List of files to lint (JSHint/JSCS)"
  },
  "qunit.files": {
    "type": "list",
    "default": [
      "test/**/*.html"
    ],
    "description": "List of QUnit test HTML files"
  },
  "concat.src": {
    "type": "list",
    "default": [
      "src/**/*.js"
    ],
    "description": "Source files for concatenation"
  },
  "concat.dest": {
    "type": "string",
    "default": "dist/all.js",
    "description": "Destination file for concatenated output"
  },
  "uglify.src": {
    "type": "string",
    "default": "dist/all.js",
    "description": "Source file for UglifyJS minification"
  },
  "uglify.dest": {
    "type": "string",
    "default": "dist/all.min.js",
    "description": "Destination file for minified output"
  },
  "watch.files": {
    "type": "list",
    "default": [
      "src/**/*.js"
    ],
    "description": "Files to watch for changes"
  },
  "watch.tasks": {
    "type": "list",
    "default": [
      "default"
    ],
    "description": "Tasks to run when watched files change"
  },
  "jshint.files": {
    "type": "list",
    "default": [
      "src/**/*.js"
    ],
    "description": "Files to lint with JSHint"
  },
  "jshint.options.strict": {
    "type": "bool",
    "default": true,
    "description": "Enforce strict mode in JSHint"
  },
  "cssmin.dest": {
    "type": "string",
    "default": "dist/style.min.css",
    "description": "Destination file for minified CSS"
  },
  "cssmin.src": {
    "type": "list",
    "default": [
      "src/**/*.css"
    ],
    "description": "Source CSS files to minify"
  },
  "concurrent.limit": {
    "type": "number",
    "default": 3,
    "description": "Maximum number of concurrent tasks"
  },
  "concurrent.tasks": {
    "type": "list",
    "default": [
      "uglify",
      "cssmin"
    ],
    "description": "List of tasks to run concurrently"
  },
  "sass.src": {
    "type": "string",
    "default": "src/styles/main.scss",
    "description": "Source SCSS file"
  },
  "sass.dest": {
    "type": "string",
    "default": "dist/styles/main.css",
    "description": "Destination compiled CSS file"
  },
  "autoprefixer.src": {
    "type": "string",
    "default": "dist/styles/main.css",
    "description": "Source CSS file for autoprefixing"
  },
  "autoprefixer.dest": {
    "type": "string",
    "default": "dist/styles/main.prefixed.css",
    "description": "Destination CSS file after autoprefixing"
  },
  "imagemin.cwd": {
    "type": "string",
    "default": "src/images/",
    "description": "Source directory for images"
  },
  "imagemin.dest": {
    "type": "string",
    "default": "dist/images/",
    "description": "Destination directory for optimized images"
  },
  "shell.tasks": {
    "type": "object",
    "default": [],
    "description": "Map of shell task names to configurations; each item has 'command' (required) and optional 'options' object"
  },
  "connect.options.port": {
    "type": "number",
    "default": 8000,
    "description": "Port for the development server"
  },
  "connect.options.base": {
    "type": "string",
    "default": ".",
    "description": "Base directory for static files"
  },
  "connect.options.open": {
    "type": "string",
    "default": "http://localhost:8000",
    "description": "URL to open automatically in the browser"
  },
  "connect.options.middleware": {
    "type": "list",
    "default": [],
    "description": "List of static middleware paths"
  },
  "jasmine.src": {
    "type": "list",
    "default": [
      "src/**/*.js"
    ],
    "description": "Source JS files to test"
  },
  "jasmine.options.specs": {
    "type": "list",
    "default": [
      "test/**/*.js"
    ],
    "description": "Spec files for Jasmine tests"
  },
  "eslint.target": {
    "type": "list",
    "default": [
      "src/**/*.js"
    ],
    "description": "Files to lint with ESLint"
  },
  "eslint.options.fix": {
    "type": "bool",
    "default": false,
    "description": "Enable ESLint auto-fix"
  },
  "babel.dist.dest": {
    "type": "string",
    "default": "dist/es5/**/*.js",
    "description": "Destination directory for transpiled ES5 JS"
  },
  "babel.dist.src": {
    "type": "string",
    "default": "src/**/*.js",
    "description": "Source JS files for Babel transpilation"
  },
  "mocha.options.urls": {
    "type": "list",
    "default": [
      "http://localhost:8000/test/index.html"
    ],
    "description": "Test URLs for Mocha"
  },
  "jsonlint.src": {
    "type": "list",
    "default": [
      "**/*.json"
    ],
    "description": "JSON files to lint"
  },
  "yamllint.src": {
    "type": "list",
    "default": [
      "**/*.yml",
      "**/*.yaml"
    ],
    "description": "YAML files to lint"
  },
  "markdownlint.src": {
    "type": "list",
    "default": [
      "**/*.md"
    ],
    "description": "Markdown files to lint"
  },
  "htmlhint.src": {
    "type": "list",
    "default": [
      "**/*.html"
    ],
    "description": "HTML files to lint"
  },
  "copy.files": {
    "type": "list",
    "default": [
      {
        "src": "src/**",
        "dest": "dist/"
      }
    ],
    "description": "Copy task file mappings"
  },
  "clean.dist": {
    "type": "list",
    "default": [
      "dist/"
    ],
    "description": "Directories to clean"
  },
  "banner": {
    "type": "bool",
    "default": true,
    "description": "Include banner comment block"
  },
  "usebanner.files": {
    "type": "list",
    "default": [
      "dist/**/*.js",
      "dist/**/*.css"
    ],
    "description": "Files to which to prepend banner"
  },
  "register_tasks": {
    "type": "object",
    "default": [],
    "description": "Map of registered task names to lists of subtasks"
  },
  "load_plugins": {
    "type": "list",
    "default": [],
    "description": "List of NPM Grunt plugins to load via loadNpmTasks()"
  },
  "extra_js": {
    "type": "list",
    "default": [],
    "description": "Arbitrary JavaScript lines to include in Gruntfile"
  }
}
