{
  "project_name": "my-app",
  "lint.files": [
    "src/**/*.js",
    "test/**/*.js"
  ],
  "qunit.files": [
    "test/**/*.html"
  ],
  "concat.src": [
    "src/**/*.js"
  ],
  "concat.dest": "dist/all.js",
  "uglify.src": "dist/all.js",
  "uglify.dest": "dist/all.min.js",
  "watch.files": [
    "src/**/*.js"
  ],
  "watch.tasks": [
    "default"
  ],
  "jshint.files": [
    "src/**/*.js"
  ],
  "jshint.options.strict": true,
  "cssmin.dest": "dist/style.min.css",
  "cssmin.src": [
    "src/**/*.css"
  ],
  "concurrent.limit": 3,
  "concurrent.tasks": [
    "uglify",
    "cssmin"
  ],
  "sass.src": "src/styles/main.scss",
  "sass.dest": "dist/styles/main.css",
  "autoprefixer.src": "dist/styles/main.css",
  "autoprefixer.dest": "dist/styles/main.prefixed.css",
  "imagemin.cwd": "src/images/",
  "imagemin.dest": "dist/images/",
  "shell.tasks": {
    "build": {
      "command": "npm run build",
      "options": {}
    }
  },
  "connect.options.port": 8000,
  "connect.options.base": ".",
  "connect.options.open": "http://localhost:8000",
  "connect.options.middleware": [],
  "jasmine.src": [
    "src/**/*.js"
  ],
  "jasmine.options.specs": [
    "test/**/*.js"
  ],
  "eslint.target": [
    "src/**/*.js"
  ],
  "eslint.options.fix": false,
  "babel.dist.dest": "dist/es5/**/*.js",
  "babel.dist.src": "src/**/*.js",
  "mocha.options.urls": [
    "http://localhost:8000/test/index.html"
  ],
  "jsonlint.src": [
    "**/*.json"
  ],
  "yamllint.src": [
    "**/*.yml"
  ],
  "markdownlint.src": [
    "**/*.md"
  ],
  "htmlhint.src": [
    "**/*.html"
  ],
  "copy.files": [
    {
      "src": "src/**",
      "dest": "dist/"
    }
  ],
  "clean.dist": [
    "dist/"
  ],
  "banner": true,
  "usebanner.files": [
    "dist/**/*.js",
    "dist/**/*.css"
  ],
  "register_tasks": {
    "default": [
      "lint",
      "test"
    ],
    "build": [
      "concat",
      "uglify",
      "cssmin"
    ]
  },
  "load_plugins": [
    "grunt-contrib-jshint",
    "grunt-contrib-qunit",
    "grunt-contrib-concat",
    "grunt-contrib-uglify",
    "grunt-contrib-watch"
  ],
  "extra_js": []
}
