# Configuration file for hnb (Hierarchical Notebook)
# This file controls the behavior of the hnb terminal application.

# Default database file location
# Specifies the path to the internal database file where notebook data is stored.
set DATABASE {{ (hnb | default({})).database | default('~/.hnb') }}

# Configuration file to load (recursive source)
# Specifies a source file that is read recursively, allowing for modular configuration.
set SOURCE {{ (hnb | default({})).source | default('~/.hnbrc') }}

# User interface mode: 'curses' (default) or 'cli'
# Selects the rendering engine: curses for terminal UI with colors/borders, or simple cli.
set UI {{ (hnb | default({})).ui | default('curses') }}

# Tutorial file to load instead of database
# If this file exists, it is loaded in place of the main database for demonstration purposes.
set TUTORIAL {{ (hnb | default({})).tutorial | default('Tutorial.hnb') }}

# List of default commands to run in non-interactive mode
# Each item in the list is a command string executed sequentially upon startup.
{% for command in (hnb | default({})).commands | default([]) %}
set CMD {{ command }}
{% endfor %}