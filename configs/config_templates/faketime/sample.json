{
  "enabled": true,
  "commands": [
    {
      "description": "Run /usr/bin/myapp with time frozen at midnight 2020-01-01",
      "timestamp": [
        "2020-01-01 00:00:00"
      ],
      "program": "/usr/bin/myapp",
      "args": [
        "--config",
        "/etc/myapp/config"
      ]
    },
    {
      "description": "Run /usr/bin/debugger with time offset of 7 days in the past and speed slowed to 0.2x",
      "timestamp": [
        "-7d",
        "x0,2"
      ],
      "program": "/usr/bin/debugger",
      "args": [
        "-v"
      ],
      "use_advanced_format": true,
      "multithreaded": true,
      "exclude_monotonic": true
    },
    {
      "description": "Override system date helper for compatibility",
      "timestamp": [
        "last Friday 5 pm"
      ],
      "program": "/usr/bin/date",
      "args": [],
      "date_prog": "/usr/bin/gnu-date"
    }
  ]
}
