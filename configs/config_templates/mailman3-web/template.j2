# Base directory for the Mailman3 web interface static files.
# @type string
# @default /var/lib/mailman3/web
Alias /mailman3/favicon.ico {{ (mailman_web_static_dir | default('/var/lib/mailman3/web')) }}/static/postorius/img/favicon.ico
Alias /mailman3/static      {{ (mailman_web_static_dir | default('/var/lib/mailman3/web')) }}/static

# Restrict access to the static content directory, granting access to all
# @type directory_block
<Directory "{{ (mailman_web_static_dir | default('/var/lib/mailman3/web')) }}/static">
	Require all granted
</Directory>

# Configure uWSGI proxy settings if the module is available
# @module mod_proxy_uwsgi
<IfModule mod_proxy_uwsgi.c>
	# Do not proxy static assets (favicon and static files) to the backend; serve them directly via Apache
	ProxyPass /mailman3/favicon.ico !
	ProxyPass /mailman3/static !

	# Proxy all other /mailman3 requests to the Mailman3 Web uWSGI socket
	# @backend uwsgi
	# @socket /run/mailman3-web/uwsgi.sock
	ProxyPass /mailman3 unix:/run/mailman3-web/uwsgi.sock|uwsgi://localhost/
</IfModule>
