# Shishi Client Configuration
# Generated by Ansible Jinja2 — self-documenting via schema defaults.
# Each directive is preceded by its schema description.
# All variables use | default(...) to prevent undefined-variable errors.

# The client name (principal) to request tickets for. Default is login username.
{% if client_name is defined or true %}
client-name={{ (client_name | default('')) | string }}
{% endif %}

# The default Kerberos realm.
{% if realm is defined or true %}
realm={{ (realm | default('')) | string }}
{% endif %}

# List of encryption types to use (e.g., aes256, aes128). If empty, defaults are used by the library.
{% if encryption_types is defined or true %}
encryption-type={{ (encryption_types | default([])) | join(',') }}
{% endif %}

# Service name in ticket to use for authenticating request (TGS). Default is krbtgt/REALM@REALM.
{% if ticket_granter is defined or true %}
ticket-granter={{ (ticket_granter | default('')) | string }}
{% endif %}

# Specify when the ticket should start to be valid. Empty for immediate.
{% if start_time is defined or true %}
starttime={{ (start_time | default('')) | string }}
{% endif %}

# Specify when ticket validity should expire. Empty for default (8 hours).
{% if end_time is defined or true %}
endtime={{ (end_time | default('')) | string }}
{% endif %}

# Specify renewable life of ticket. Implies --renewable. Empty for default (1 week).
{% if renew_till is defined or true %}
renew-till={{ (renew_till | default('')) | string }}
{% endif %}

# Path to file to read tickets from.
{% if ticket_file is defined or true %}
ticket-file={{ (ticket_file | default('')) | string }}
{% endif %}

# Path to file to write tickets to. Empty to write back to source.
{% if ticket_write_file is defined or true %}
ticket-write-file={{ (ticket_write_file | default('')) | string }}
{% endif %}

# The server name (service principal) to request a ticket for. Default is krbtgt/REALM.
{% if server_name is defined or true %}
server-name={{ (server_name | default('')) | string }}
{% endif %}