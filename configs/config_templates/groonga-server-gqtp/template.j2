# =============================================================================
# groonga-server-gqtp Configuration Template
# =============================================================================
# This template configures the Groonga GQTP (Groonga Query Protocol) server.
# GQTP is a high-performance, binary protocol for interacting with Groonga databases.
# =============================================================================

# -----------------------------------------------------------------------------
# System User & Group
# -----------------------------------------------------------------------------
# System user under which groonga-server-gqtp runs.
# Default: _groonga
#USER={{ user | default('_groonga') }}

# System group under which groonga-server-gqtp runs.
# Default: _groonga
#GROUP={{ group | default('_groonga') }}

# -----------------------------------------------------------------------------
# Network Binding
# -----------------------------------------------------------------------------
# IP address to bind to.
# Default: 127.0.0.1
ADDRESS={{ address | default('127.0.0.1') }}

# Port to listen on for GQTP connections.
# Default: 10043
PORT={{ port | default(10043) }}

# -----------------------------------------------------------------------------
# Database & Logging
# -----------------------------------------------------------------------------
# Path to the Groonga database file (directory or file depending on setup).
# Default: /var/lib/groonga/db/db
DATABASE={{ database | default('/var/lib/groonga/db/db') }}

# Path to the main log file for the Groonga server.
# Default: /var/log/groonga/groonga-gqtp.log
LOG_PATH={{ log_path | default('/var/log/groonga/groonga-gqtp.log') }}

# Path to the query log file (records incoming queries).
# Default: /var/log/groonga/query-gqtp.log
QUERY_LOG_PATH={{ query_log_path | default('/var/log/groonga/query-gqtp.log') }}

# -----------------------------------------------------------------------------
# Service Control
# -----------------------------------------------------------------------------
# Set to 'no' to disable the groonga daemon (commented out line would be uncommented if disabled).
# Default: yes
ENABLE={{ enable | default('yes') }}

# -----------------------------------------------------------------------------
# Query Optimization Thresholds
# -----------------------------------------------------------------------------
# Threshold ratio for in_values() to fall back to sequential search.
# If the estimated match ratio exceeds this value, Groonga uses sequential search
# instead of index lookup for performance optimization.
# Default: 0.01
GRN_IN_VALUES_TOO_MANY_INDEX_MATCH_RATIO={{ grn_in_values_too_many_index_match_ratio | default(0.01) }}

# Threshold ratio for between() to fall back to sequential search.
# Similar to in_values(), this controls when to use sequential scan for range queries.
# Default: 0.01
GRN_BETWEEN_TOO_MANY_INDEX_MATCH_RATIO={{ grn_between_too_many_index_match_ratio | default(0.01) }}

# -----------------------------------------------------------------------------
# MeCab Tokenization Features
# -----------------------------------------------------------------------------
# Set to 'yes' to enable chunked tokenize feature (default: no).
# This feature improves tokenization performance for large texts by processing
# them in chunks.
# Default: no
GRN_MECAB_CHUNKED_TOKENIZE_ENABLED={{ grn_mecab_chunked_tokenize_enabled | default('no') }}

# Threshold value for chunk size in chunked tokenize feature.
# Defines the maximum size in bytes for a text chunk before triggering tokenization.
# Default: 8192
GRN_MECAB_CHUNK_SIZE_THRESHOLD={{ grn_mecab_chunk_size_threshold | default(8192) }}