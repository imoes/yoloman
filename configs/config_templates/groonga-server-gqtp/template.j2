# ===========================================================================
# Groonga Server GQTP Configuration Template
# ===========================================================================
# This file configures the groonga-server-gqtp daemon.
#
# For detailed documentation, see:
#   https://groonga.org/docs/server/gqtp.html
#
# Notes on service control:
#   - `ENABLE`: Set to 'yes' to start the service, 'no' to disable it.
#   - `USER`/`GROUP`: Define the system user/group the daemon runs as.
#     If left empty or commented, the service manager (systemd) usually
#     handles this, but explicit defaults are provided below.
# ===========================================================================

# -------------------------------------------------------------------------
# System User/Group Configuration
# -------------------------------------------------------------------------

# System user under which groonga-server-gqtp runs
{% if user is defined and user is not none and (user is number or user is boolean or user | length > 0) %}USER={{ user | default('_groonga') }}{% else %}#USER=_groonga{% endif %}

# System group under which groonga-server-gqtp runs
{% if group is defined and group is not none and (group is number or group is boolean or group | length > 0) %}GROUP={{ group | default('_groonga') }}{% else %}#GROUP=_groonga{% endif %}

# -------------------------------------------------------------------------
# Network Configuration
# -------------------------------------------------------------------------

# IP address to bind to
ADDRESS={{ address | default('127.0.0.1') }}

# Port to listen on
PORT={{ port | default('10043') }}

# -------------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------------

# Path to the Groonga database file
DATABASE={{ database | default('/var/lib/groonga/db/db') }}

# -------------------------------------------------------------------------
# Logging Configuration
# -------------------------------------------------------------------------

# Path to the main log file
LOG_PATH={{ log_path | default('/var/log/groonga/groonga-gqtp.log') }}

# Path to the query log file
QUERY_LOG_PATH={{ query_log_path | default('/var/log/groonga/query-gqtp.log') }}

# -------------------------------------------------------------------------
# Service Control
# -------------------------------------------------------------------------

# Set to 'no' to disable the groonga daemon (commented out line would be
# uncommented if disabled). 'yes' enables the service.
ENABLE={{ enable | default('yes') }}

# -------------------------------------------------------------------------
# Query Optimization Thresholds
# -------------------------------------------------------------------------

# Threshold ratio for in_values() to fall back to sequential search
GRN_IN_VALUES_TOO_MANY_INDEX_MATCH_RATIO={{ grn_in_values_too_many_index_match_ratio | default('0.01') }}

# Threshold ratio for between() to fall back to sequential search
GRN_BETWEEN_TOO_MANY_INDEX_MATCH_RATIO={{ grn_between_too_many_index_match_ratio | default('0.01') }}

# -------------------------------------------------------------------------
# Mecab / Tokenizer Configuration
# -------------------------------------------------------------------------

# Set to 'yes' to enable chunked tokenize feature (default: no)
GRN_MECAB_CHUNKED_TOKENIZE_ENABLED={{ grn_mecab_chunked_tokenize_enabled | default('no') }}

# Threshold value for chunk size in chunked tokenize feature
GRN_MECAB_CHUNK_SIZE_THRESHOLD={{ grn_mecab_chunk_size_threshold | default('8192') }}
