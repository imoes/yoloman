<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!--
      Configuration file for Fontconfig to manage hinting rules for DejaVu LGC Serif fonts.
      This template is self-documenting: every variable is derived from the schema defaults.

      Purpose:
      Disable hinting manually at smaller sizes (< threshold ppem) for the specified family.
      This is based on the Bitstream Vera fonts rule, as DejaVu is derived from Vera.
      Bitstream Vera fonts have GASP entries suggesting hinting be disabled below 8 ppem,
      but FreeType ignores those, preferring data from 'prep' table instructions.
  -->

  <!-- Match any font object in Fontconfig's internal representation -->
  <match target="font">
    <!--
      Test 1: Check if the font family name matches the configured family.
      Variable: family
      Description: The font family name to target for hinting rules.
      Default: 'DejaVu LGC Serif'
    -->
    <test name="family">
      <string>{{ family | default('DejaVu LGC Serif') }}</string>
    </test>

    <!--
      Test 2: Check if the font's pixel size is less than the configured threshold.
      Variable: threshold
      Description: The pixel size threshold below which hinting is disabled.
      Default: '7.5'
    -->
    <test compare="less" name="pixelsize">
      <double>{{ threshold | default('7.5') }}</double>
    </test>

    <!--
      Action: Edit the hinting property of the matched font.
      Variable: enable_hinting
      Description: Whether to enable hinting (true) or disable it (false) for the matched font.
      Default: 'false'
      Note: In Fontconfig XML, <bool> expects lowercase "true" or "false".
    -->
    <edit name="hinting">
      <bool>{{ enable_hinting | default('false') }}</bool>
    </edit>
  </match>
</fontconfig>
