# Configuration for usbguard-notifier
# Generated by Ansible Jinja2 template

# Enable debug mode for verbose logging (corresponds to -d, --debug)
# Default: False
debug: {{ debug | default(False) }}

# Wait until an active IPC connection is established (corresponds to -w, --wait)
# Default: True
wait: {{ wait | default(True) }}

# List of users or groups authorized to listen to USBGuard IPC signals.
# If empty, the system default/running user is assumed. Format: "user" or "@group"
# Corresponds to IPC privilege management via usbguard add-user
# Default: [] (empty list)
allowed_entities:
{% for entity in allowed_entities | default([]) %}
  - {{ entity }}
{% endfor %}