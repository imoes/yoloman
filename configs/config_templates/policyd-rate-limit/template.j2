# policyd-rate-limit configuration template
# Generated by Ansible Jinja2
# This file configures policyd-rate-limit, a Postfix policy daemon for rate limiting email traffic.

# Enable debug mode to output logs to stderr.
debug: {{ debug | default('True') }}

# The user policyd-rate-limit will use to drop privileges.
user: "{{ user | default('policyd-rate-limit') }}"

# The group policyd-rate-limit will use to drop privileges.
group: "{{ group | default('policyd-rate-limit') }}"

# Path where the program will try to write its pid to.
pidfile: "{{ pidfile | default('/var/run/policyd-rate-limit/policyd-rate-limit.pid') }}"

{% if (backend | default(0)) == 1 %}
# The config to connect to a mysql server.
# Note: This section is only used if 'backend' is set to 1.
mysql_config:
    # MySQL connection username.
    user: "{{ mysql_user | default('username') }}"
    # MySQL connection password.
    passwd: "{{ mysql_passwd | default('*****') }}"
    # MySQL database name.
    db: "{{ mysql_db | default('database') }}"
    # MySQL host address.
    host: "{{ mysql_host | default('localhost') }}"
    charset: 'utf8'
{% endif %}

{% if (backend | default(0)) == 0 %}
# The config to connect to a sqlite3 database.
# Note: This section is only used if 'backend' is set to 0.
sqlite_config:
    # Path to the SQLite3 database file.
    database: "{{ sqlite_database | default('/var/lib/policyd-rate-limit/db.sqlite3') }}"
{% endif %}

{% if (backend | default(0)) == 2 %}
# The config to connect to a postgresql server.
# Note: This section is only used if 'backend' is set to 2.
pgsql_config:
    # PostgreSQL database name.
    database: "{{ pgsql_database | default('database') }}"
    # PostgreSQL connection username.
    user: "{{ pgsql_user | default('username') }}"
    # PostgreSQL connection password.
    password: "{{ pgsql_password | default('*****') }}"
    # PostgreSQL host address.
    host: "{{ pgsql_host | default('localhost') }}"
{% endif %}

# Which data backend to use.
# 0 for sqlite3, 1 for mysql, 2 for postgresql.
backend: {{ backend | default(0) }}

# The socket to bind to. Path to a unix socket or [ip, port] list.
# Example for TCP: SOCKET: ["127.0.0.1", 8552]
# Default is a Unix socket path.
SOCKET: "{{ socket_path | default('/var/spool/postfix/ratelimit/policy') }}"

# Permissions on the unix socket (if unix socket used).
socket_permission: {{ socket_permission | default('0666') }}

# A list of couple [number of emails, number of seconds].
# If one of the element of the list is exceeded (more than 'number of emails' on 'number of seconds' for an ip address or an sasl username),
# postfix will return a temporary failure.
limits:
    # First limit: {{ limits_0_count | default(10) }} mails by {{ limits_0_interval | default('minutes') }}
    - [{{ limits_0_count | default(10) }}, {{ limits_0_seconds | default(60) }}]
    # Second limit: {{ limits_1_count | default(150) }} mails by {{ limits_1_interval | default('days') }}
    - [{{ limits_1_count | default(150) }}, {{ limits_1_seconds | default(86400) }}]

# dict of id -> limit list. Used to override limits and use custom limits for a particular id.
# ids are sasl usernames or ip addresses. Use an empty list for no limits for a particular id.
# Example:
# limits_by_id:
#     foo: []
#     192.168.0.254:
#         - [1000, 86400]
#     2a01:240:fe3d:4:219:bbff:fe3c:4f76: []
limits_by_id: {}

# Use custom rate limit for every user, if you have sql backend for your mail server.
# There is a `rate_limit` table which has id -> limits_by_id-like strings for custom limits.
# You should set for your users a rate_limit id to map users <-> rate_limits tables.
# Example SQL:
# sql_limits_by_id: "SELECT `limits` FROM `rate_limits` WHERE `id` IN (SELECT `rate_limit` FROM `virtual_users` WHERE `email`=%s)"
sql_limits_by_id: "{{ sql_limits_by_id | default('') }}"

# Apply limits by SASL usernames.
limit_by_sasl: {{ limit_by_sasl | default('True') }}

# If no sasl username is found, or limit by sasl usernames disabled, apply limits by sender addresses.
limit_by_sender: {{ limit_by_sender | default('False') }}

# If sasl username and sender address not found or disabled, apply limits by ip addresses.
limit_by_ip: {{ limit_by_ip | default('False') }}

# A list of ip networks in cidr notation on which limits are applied.
# An empty list is equal to limit_by_ip: False. Put "0.0.0.0/0" and "::/0" for every ip addresses.
limited_networks: []

# If no limits are reach, which action postfix should do.
# see http://www.postfix.org/access.5.html for a list of actions.
success_action: "{{ success_action | default('dunno') }}"

# If a limit is reach, which action postfix should do.
# see http://www.postfix.org/access.5.html for a list of actions.
fail_action: "{{ fail_action | default('defer_if_permit Rate limit reach, retry later') }}"

# If we are unable to to contect the database backend, which action postfix should do.
# see http://www.postfix.org/access.5.html for a list of actions.
db_error_action: "{{ db_error_action | default('dunno') }}"

# If True, send a report to report_to about users reaching limits each time --clean is called
report: {{ report | default('False') }}

# from who to send emails reports. Must be defined if report: True
report_from: {{ report_from | default('null') }}

# Address to send emails reports to. Must be defined if report: True.
# If can be a single email address:
# report_to: foo@example.com
# or a list of email addresses:
# report_to:
#     - foo@example.com
#     - bar@example.com
report_to: {{ report_to | default('null') }}

# Subject of the report email
report_subject: "{{ report_subject | default('policyd-rate-limit report') }}"

# List of number of seconds from the limits list for which you want to be reported.
report_limits: [{{ report_limits_0 | default('86400') }}]

# Only send a report if some users have reach a reported limit.
# Otherwise, empty reports may be sent.
report_only_if_needed: {{ report_only_if_needed | default('True') }}

# The smtp server to use to send emails [host, port]
smtp_server: ["{{ smtp_host | default('localhost') }}", {{ smtp_port | default(25) }}]

# Should we use starttls (you should set this to True if you use smtp_credentials)
smtp_starttls: {{ smtp_starttls | default('False') }}

# Should we use credentials to connect to smtp_server ? if yes set ["user", "password"], else null
smtp_credentials: {{ smtp_credentials | default('null') }}

# The time in seconds before an unused socket gets closed
delay_to_close: {{ delay_to_close | default('300') }}

# How sent mail are counted:
# * 0 each RCPT TO are counted individualy. This is the how it was done historically.
#   If set to 0, the postfix check_policy_service must be set in smtpd_recipient_restrictions.
#   This is deprecated and should not be used anymore
# * 1 recipient are counted in the DATA stage.
#   The postfix parameter check_policy_service must be defined in smtpd_data_restrictions.
#   This is the new default.
count_mode: {{ count_mode | default('1') }}
