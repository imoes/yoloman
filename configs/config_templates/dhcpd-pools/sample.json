{
  "config_path": "/etc/dhcp/dhcpd.conf",
  "leases_path": "/var/lib/dhcp/dhcpd.leases",
  "format": "t",
  "output_path": "/var/log/dhcpd-pools/report.txt",
  "limit": "77",
  "sort": "p",
  "reverse": true,
  "warning": 75,
  "critical": 80.1,
  "warn_count": 10,
  "crit_count": 2,
  "snet_alarms": true,
  "minsize": 50,
  "perfdata": true,
  "ip_version": "4",
  "all_as_shared": false
}
