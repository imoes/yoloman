# ==============================================================================
# fence_virsh Configuration Template
# ==============================================================================
# This template generates the configuration file for the fence_virsh device agent,
# used by High Availability (HA) clusters (e.g., Red Hat Cluster Suite, Pacemaker/Corosync)
# to fence (power cycle or reset) KVM/libvirt virtual machines.
# ==============================================================================

# Name of the fence device agent.
# Do not change this unless you are using a different agent.
fence = "virsh"

# --------------------------------------------------------------------------
# Connection Target
# --------------------------------------------------------------------------

# Hostname or IP address of the KVM/libvirt hypervisor hosting the VM.
# This is the address where SSH or libvirt commands will be sent.
# Required field.
hostip = "{{ hostip | default('') }}"

# Username used to authenticate to the hypervisor.
# This user must have appropriate privileges to manage VMs (e.g., via SSH or libvirt).
# Required field.
login = "{{ login | default('root') }}"

# --------------------------------------------------------------------------
# Authentication & Credentials
# --------------------------------------------------------------------------

# Password for the login user.
# SECURITY WARNING: Prefer using 'password_file' or 'identity_file' in production.
# Leaving this blank or empty if other methods are used.
# Note: In INI-style configs for fence_virsh, omitting the key entirely is safer than
# setting it to empty, but we provide the key with an empty default to ensure it appears
# if explicitly requested. However, to avoid 'omit' errors when not needed, we use
# a conditional to only write the line if the password is actually set.
{% if password | default('') != '' %}
password = "{{ password }}"
{% endif %}

# Absolute path to a file containing the password.
# Recommended for production environments to avoid plaintext passwords in config files.
# Example: /etc/fence_agents/credentials
# If set, this takes precedence over 'password' if both are provided (though typically one is used).
{% if password_file | default('') != '' %}
password_file = "{{ password_file }}"
{% endif %}

# Path to SSH private key for key-based authentication.
# If set, this overrides password authentication.
# Ensure the corresponding public key is in the hypervisor's authorized_keys.
{% if identity_file | default('') != '' %}
identity_file = "{{ identity_file }}"
{% endif %}

# --------------------------------------------------------------------------
# Target VM Identification
# --------------------------------------------------------------------------

# Name of the VM (guest domain) to fence.
# This must match the domain name defined in libvirt.
# Required for multi-VM setups or when the default naming doesn't apply.
{% if plug | default('') != '' %}
plug = "{{ plug }}"
{% endif %}

# --------------------------------------------------------------------------
# Timing & Retries
# --------------------------------------------------------------------------

# Maximum number of attempts to execute the fence action (e.g., off/on).
# If the action fails, the agent will retry up to this many times.
retry = "{{ retry | default(3) | int }}"

# Maximum total time (in seconds) to wait for a fence action to complete.
# If this timeout is reached, the fence action is considered failed, regardless of retry count.
# Set to 0 to disable timeout checking (rely solely on retry count).
retry_timeout = "{{ retry_timeout | default(0) | int }}"

# Seconds to wait after sending a fence command before checking status or retrying.
# Useful if the hypervisor needs time to process power commands.
action_delay = "{{ action_delay | default(0) | int }}"

# --------------------------------------------------------------------------
# Transport & Libvirt URI
# --------------------------------------------------------------------------

# Use direct libvirt URI instead of SSH transport.
# If true (1), the agent will attempt to connect directly to the libvirt daemon using the 'uri' field.
# If false (0/empty), SSH is used with 'hostip', 'login', etc.
use_uri = "{{ use_uri | default(False) | bool | ternary(1, 0) }}"

# Libvirt connection URI (e.g., 'qemu+ssh://user@host/system').
# Only used if use_uri is enabled.
# Must be a valid URI understood by libvirt.
{% if uri | default('') != '' %}
uri = "{{ uri }}"
{% endif %}

# --------------------------------------------------------------------------
# Extra Options
# --------------------------------------------------------------------------

# Extra options to pass to fence_virsh (comma-separated).
# Avoid unless absolutely necessary. Use explicit parameters above whenever possible.
# Example: 'pcmk_host_list=vm1,vm2'
# If empty, no extra options are passed.
{% if options | default('') != '' %}
options = "{{ options }}"
{% endif %}