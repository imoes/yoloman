{
  "address": {
    "type": "string",
    "default": "localhost",
    "description": "Address to listen on (e.g., localhost, 0.0.0.0)"
  },
  "port": {
    "type": "number",
    "default": 8080,
    "description": "Port to listen on"
  },
  "base_path": {
    "type": "string",
    "default": "/",
    "description": "The URL path where MagicMirror\u00b2 is hosted"
  },
  "ip_whitelist": {
    "type": "string",
    "default": "\"127.0.0.1\", \"::ffff:127.0.0.1\", \"::1\"",
    "description": "List of allowed IP addresses"
  },
  "use_https": {
    "type": "string",
    "default": "false",
    "description": "Support HTTPS or not"
  },
  "https_private_key": {
    "type": "string",
    "default": "",
    "description": "HTTPS private key path"
  },
  "https_certificate": {
    "type": "string",
    "default": "",
    "description": "HTTPS Certificate path"
  },
  "language": {
    "type": "string",
    "default": "en",
    "description": "Language setting",
    "enum": [
      "en",
      "nl",
      "no",
      "id",
      "is",
      "or",
      "be"
    ]
  },
  "locale": {
    "type": "string",
    "default": "en-US",
    "description": "Locale setting"
  },
  "log_level": {
    "type": "string",
    "default": "\"INFO\", \"LOG\", \"WARN\", \"ERROR\"",
    "description": "Log levels"
  },
  "time_format": {
    "type": "number",
    "default": 24,
    "description": "Time format (12 or 24)"
  },
  "units": {
    "type": "string",
    "default": "metric",
    "description": "Units setting"
  },
  "weather_location": {
    "type": "string",
    "default": "New York",
    "description": "Weather location"
  },
  "weather_location_id": {
    "type": "string",
    "default": "5128581",
    "description": "Weather location ID"
  },
  "weather_api_key": {
    "type": "string",
    "default": "YOUR_OPENWEATHER_API_KEY",
    "description": "OpenWeatherMap API key"
  }
}
