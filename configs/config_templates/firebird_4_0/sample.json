{
  "root_directory": "/usr/lib/firebird/4.0",
  "remote_service_port": 3050,
  "remote_bind_address": "",
  "remote_aux_port": 0,
  "max_connections": 200,
  "connection_timeout": 180,
  "dummy_packet_interval": 60,
  "auth_server": [
    "Srp256",
    "Srp"
  ],
  "auth_client": [
    "Srp256",
    "Srp",
    "Legacy_Auth"
  ],
  "user_manager": "Srp",
  "wire_crypt": "Required",
  "security_database": "/var/lib/firebird/4.0/system/security4.fdb",
  "server_mode": "SuperServer",
  "max_parallel_workers": 4,
  "default_db_cache_pages": 4096,
  "file_system_cache_threshold": 65536,
  "file_system_cache_size": 30,
  "temp_cache_limit": 134217728,
  "temp_directories": [
    "/var/tmp/firebird"
  ],
  "max_unflushed_writes": -1,
  "max_unflushed_write_time": -1,
  "gc_policy": "combined",
  "database_access": "Full",
  "external_file_access": "None",
  "udf_access": "None",
  "audit_trace_config_file": "",
  "data_type_compatibility": ""
}
