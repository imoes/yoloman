{
  "bind_addr": "0.0.0.0",
  "port": 8080,
  "worker_count": 4,
  "enable_access_log": true,
  "access_log_path": "/var/log/mighttpd2/access.log",
  "enable_error_log": true,
  "error_log_path": "/var/log/mighttpd2/error.log",
  "document_root": "/var/www/html",
  "directory_index": false,
  "mime_types": [
    {
      "ext": ".webp",
      "type": "image/webp"
    },
    {
      "ext": ".woff2",
      "type": "font/woff2"
    }
  ],
  "connection_timeout": 30,
  "max_body_size": 10485760,
  "ssl": null,
  "auth_realms": [],
  "enable_gzip": true,
  "gzip_level": 6,
  "server_token": "mighttpd2"
}
