{
  "debug": false,
  "log_dir": "/var/log/glance",
  "log_level": "INFO",
  "default_store": "file",
  "filesystem_store_datadir": "/var/lib/glance/images",
  "max_image_size": 10737418240,
  "enabled_import_methods": [
    "web-download",
    "copy-image"
  ],
  "keystone": {
    "auth_type": "password",
    "auth_url": "http://controller:5000/v3",
    "project_domain_name": "Default",
    "user_domain_name": "Default",
    "project_name": "service",
    "username": "glance",
    "password": "glance123",
    "insecure": false
  },
  "paste_deploy": {
    "flavor": "keystone"
  },
  "glance_stores": [
    {
      "name": "file",
      "options": {
        "filesystem_store_datadir": "/var/lib/glance/images"
      }
    }
  ],
  "database": {
    "connection": "mysql+pymysql://glance:glance123@controller/glance",
    "max_pool_size": 10,
    "max_overflow": 20,
    "pool_timeout": 30
  },
  "lock_path": "/var/lib/glance/lock",
  "enable_cors": true,
  "policy_file": "/etc/glance/policy.json"
}
