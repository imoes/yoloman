# LZ4 Environment Configuration
# This template configures environment variables for the LZ4 compression library.
# It is intended to be sourced or exported into the environment of services
# that consume LZ4 functionality.

# l4_clevel: Default compression level. Values 1-12. Higher values trade speed for ratio. Recommended 1 for fast, 9 for high.
# Default: 1
export LZ4_CLEVEL={{ (l4_clevel | default(1)) | int }}

# l4_nbwokers: Default number of threads for compression. 0 means auto-detect from CPU cores. Max 200.
# Note: The schema field is named 'l4_nbwokers' (sic), preserved here for compatibility.
# Default: 0
export LZ4_NBWORKERS={{ (l4_nbwokers | default(0)) | int }}