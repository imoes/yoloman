    "description": "ID of the KSK key template"
  },
  "key_template_zsk_algorithm": {
    "type": "string",
    "default": "SHA256",
    "description": "Algorithm for ZSK key template"
  },
  "key_template_zsk_size": {
    "type": "number",
    "default": 1024,
    "description": "Size for ZSK key template"
  },
  "key_template_zsk_2048_id": {
    "type": "string",
    "default": "zsk-rsa-sha256-2048",
    "description": "ID of the ZSK 2048 key template"
  },
  "key_template_zsk_2048_algorithm": {
    "type": "string",
    "default": "SHA256",
    "description": "Algorithm for ZSK 2048 key template"
  },
  "key_template_zsk_2048_size": {
    "type": "number",
    "default": 2048,
    "description": "Size for ZSK 2048 key template"
  },
  "key_template_ksk_algorithm": {
    "type": "string",
    "default": "SHA256",
    "description": "Algorithm for KSK key template"
  },
  "key_template_ksk_size": {
    "type": "number",
    "default": 1024,
    "description": "Size for KSK key template"
  },
  "key_template_ksk_2048_id": {
    "type": "string",
    "default": "ksk-rsa-sha256-2048",
    "description": "ID of the KSK 2048 key template"
  },
  "key_template_ksk_2048_algorithm": {
    "type": "string",
    "default": "SHA256",
    "description": "Algorithm for KSK 2048 key template"
  },
  "key_template_ksk_2048_size": {
    "type": "number",
    "default": 2048,
    "description": "Size for KSK 2048 key template"
  },
