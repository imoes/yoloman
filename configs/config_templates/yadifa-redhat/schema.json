  "denial_nsec3_fixed_iterations": {
    "type": "number",
    "default": 5,
    "description": "Iterations for fixed NSEC3 denial"
  },
  "denial_nsec3_fixed_optout": {
    "type": "string",
    "default": "off",
    "description": "Optout flag for fixed NSEC3 denial"
  },
