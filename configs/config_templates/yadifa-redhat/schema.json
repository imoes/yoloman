  "denial_nsec3_random_iterations": {
    "type": "number",
    "default": 10,
    "description": "Iterations for random NSEC3 denial"
  },
  "denial_nsec3_random_optout": {
    "type": "string",
    "default": "off",
    "description": "Optout flag for random NSEC3 denial"
