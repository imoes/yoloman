# Ree extraction tool configuration
# Path to the input ROM file containing extensions to be extracted.
input_file: {{ input_file | default('/usr/share/ree/roms/default.rom') }}

# Path where the extracted ROM extension data will be written.
output_file: {{ output_file | default('/tmp/extracted_rom.bin') }}

# Control the amount of output printed to stdout during extraction.
# 0=silent, 1=normal, 2=detailed
verbosity: {{ verbosity | default(1) }}