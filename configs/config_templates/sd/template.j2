# Configuration for sd (string substitution tool)
# This file defines default behavior for sd invocations.

# If true, display changes in a human reviewable format instead of modifying files in-place.
# Corresponds to: -p, --preview
preview: {{ (preview | default(false)) | lower }}

# If true, treat the search pattern and replacement string as literal text, disabling regex interpretation.
# Corresponds to: -F, --fixed-strings
fixed_strings: {{ (fixed_strings | default(false)) | lower }}

# Maximum number of replacements to perform per file. 0 indicates no limit.
# Corresponds to: -n, --max-replacements
max_replacements: {{ max_replacements | default(0) }}

# List of regex flag characters to apply. Valid characters are 'c', 'e', 'i', 'm', 's', 'w'.
# These are joined into a single string passed to the regex engine.
# Corresponds to: -f, --flags
flags: {{ flags | default([]) | join('') }}