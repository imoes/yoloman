{
  "api_password": "admin-secret-123",
  "api_acl": [
    "10.0.0.0/8",
    "192.168.0.0/16",
    "127.0.0.0/8"
  ],
  "backends": [
    {
      "host": "198.51.100.10",
      "port": 53,
      "name": "upstream1",
      "tcp_only": false,
      "weight": 2,
      "max_qps": 5000,
      "pool": "upstream",
      "health_check_name": "health.upstream1.example.net",
      "health_check_interval": 30,
      "max_rtt": 100
    },
    {
      "host": "203.0.113.20",
      "port": 853,
      "name": "dot-upstream",
      "tcp_only": true,
      "weight": 1,
      "max_qps": 10000,
      "pool": "secure"
    }
  ],
  "rate_limits": [
    {
      "subnet": "192.168.0.0/16",
      "qps": 100,
      "action": "throttle"
    },
    {
      "subnet": "10.0.0.0/8",
      "qps": 200,
      "action": "drop"
    }
  ],
  "rules": [
    {
      "type": "action",
      "match": "qtype(DNSQType.TXT) && qname('.example.org')",
      "action": "DropAction()"
    },
    {
      "type": "action",
      "match": "qtype(DNSQType.AAAA)",
      "action": "PoolAction('upstream')"
    }
  ],
  "doh": {
    "enabled": true,
    "address": "0.0.0.0",
    "port": 8443,
    "cert_file": "/etc/dnsdist/certs/dnsdist.crt",
    "key_file": "/etc/dnsdist/certs/dnsdist.key",
    "spdy_size": 16384,
    "idle_timeout": 300,
    "enable_x_forwarded_for": true
  },
  "log_level": "LogWarning",
  "log_dns_queries": true
}
