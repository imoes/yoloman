# dnsdist configuration — main config file
# Load control settings from external variables
# Define upstream DNS servers (backends) for query distribution
# Use weighted round-robin for load balancing across backends
# Enable TCP-only backends only if UDP is not supported
# Set maximum QPS per backend to avoid overload
# Define rules for query routing (ACLs, rate limiting, etc.)
# Configure API access (security & interface)
# Set up logging options

-- Enable the web server for the API
-- setWebserverConfig("127.0.0.1:8083", "{{ api_password }}", "{{ api_acl | join(', ') }}")

-- Define DNS upstream servers
{
{% for backend in backends %}
  -- {{ backend.host }}:{{ backend.port }} {{ '(TCP-only)' if backend.tcp_only else '' }} {{ '(weight=' ~ backend.weight ~ ')' if backend.weight > 1 else '' }}
  addServer({
    name='{{ backend.name }}',
    address='{{ backend.host }}:{{ backend.port }}',
    pool='{{ backend.pool if backend.pool else 'default' }}',
    weight={{ backend.weight or 1 }},
    tcpOnly={{ 'true' if backend.tcp_only else 'false' }},
    maxQPS={{ backend.max_qps or 0 }},
    qps={{ backend.qps_limit or 0 }},
    order={{ backend.order or 1000 }},
    checkName='{{ backend.health_check_name or '' }}',
    downstreamCheckInterval={{ backend.health_check_interval or 0 }},
    maxRTT={{ backend.max_rtt or 0 }},
    pool='{{ backend.pool if backend.pool else 'default' }}'
  }){% if not loop.last %},{% endif %}
{% endfor %}
}

-- Define ACLs for API and recursive queries
{
{% for acl in api_acl %}
  addACL('{{ acl }}')
{% endfor %}
}

-- Rate limiting per client subnet (CIDR -> QPS)
{
{% for rate_limit in rate_limits %}
  addLuaRule('{{ rate_limit.subnet }}', {{ rate_limit.qps }}, '{{ rate_limit.action or 'drop' }}')
{% endfor %}
}

-- Add rules: drop certain queries, redirect others, etc.
{
{% for rule in rules %}
  {% if rule.type == 'action' %}
    addAction(
      {{ rule.match | safe }},
      {{ rule.action | safe }}
    )
  {% elif rule.type == 'rule' %}
    setRules({
      {{ rule.match | safe }}: {{ rule.action | safe }}
    })
  {% endif %}
{% endfor %}
}

-- Enable DNS over HTTPS (DoH) if configured
{% if doh.enabled %}
addDOHLocal('{{ doh.address }}:{{ doh.port }}',
  '{{ doh.cert_file }}',
  '{{ doh.key_file }}',
  {{ doh.spdy_size or 16384 }},
  {{ doh.idle_timeout or 300 }},
  {{ 'true' if doh.enable_x_forwarded_for else 'false' }}
)
{% endif %}

-- Logging configuration
setLogLevel({{ log_level | default('LogError') }})
logDNSMessages({{ 'true' if log_dns_queries else 'false' }})
