{
  "listen_addresses": [
    "127.0.0.1:53",
    "[::1]:53"
  ],
  "max_clients": 256,
  "fallback_resolvers": [
    "9.9.9.9:53",
    "1.1.1.1:53"
  ],
  "disable_ipv6": false,
  "log_level": 1,
  "log_file": "/var/log/dnscrypt-proxy/dnscrypt-proxy.log",
  "use_syslog": false,
  "server_cert": "",
  "server_key": "",
  "cache_file": "/var/lib/dnscrypt-proxy/dnscrypt-proxy.cache",
  "cache_file_min_time": 86400,
  "cache_file_max_time": 604800,
  "disable_insecure_resolver_selection": true,
  "server_names": [
    "cloudflare",
    "nextdns"
  ],
  "resolver_timeout": 5,
  "dnscrypt_connect_timeout": 2,
  "doh_connect_timeout": 4,
  "max_connections_per_query": 3,
  "rate_limit": 100,
  "firewall_rules_file": "/usr/local/bin/dnscrypt-firewall.sh",
  "blocklist": {
    "domains": [
      "doubleclick.net",
      "ads.example.com"
    ],
    "file": "/etc/dnscrypt-proxy/blocklist.txt"
  },
  "whitelist": {
    "domains": [
      "mycompany.internal"
    ],
    "file": "/etc/dnscrypt-proxy/whitelist.txt"
  },
  "ip_filters": {
    "blocked_ranges": [],
    "allowed_ranges": [
      "10.0.0.0/8",
      "192.168.0.0/16"
    ],
    "block_localhost": false
  },
  "per_ip_log_directory": "/var/log/dnscrypt-proxy/ip-logs",
  "per_ip_log_retention_days": 7,
  "stats_per_resolver": true,
  "stats_file": "/var/lib/dnscrypt-proxy/dnscrypt-proxy.stats",
  "stats_max_age": 604800,
  "metrics": {
    "enabled": true,
    "listen_address": "127.0.0.1:9153"
  },
  "post_reload_command": "systemctl restart nftables",
  "pre_reload_command": "cp /etc/dnscrypt-proxy/dnscrypt-proxy.toml /etc/dnscrypt-proxy/dnscrypt-proxy.toml.bak",
  "on_startup": "logger -t dnscrypt 'DNSCrypt proxy started'",
  "on_shutdown": "logger -t dnscrypt 'DNSCrypt proxy stopped'",
  "logrotate_config": "/etc/logrotate.d/dnscrypt-proxy"
}
