<?xml version="1.0" encoding="UTF-8"?>
<!--
  Self-documenting Fontconfig template for Noto Sans Devanagari UI fonts.
  This configuration intercepts requests for Devanagari-script languages
  (Bhojpuri, Maithili, Nepali, Sanskrit, etc.) and injects the specified
  font family into the sans-serif fallback chain.
-->
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!--
    The font family name to use for Devanagari UI rendering.
    Default: 'Noto Sans Devanagari UI'
  -->
  <match>
    <test name="lang" compare="contains">
      <string>bh</string>
    </test>
    <test name="family">
      <string>sans-serif</string>
    </test>
    <edit name="family" mode="prepend">
      <!-- Inject the configured font family name -->
      <string>{{ font_family | default('Noto Sans Devanagari UI') }}</string>
    </edit>
    <edit name="fonthashint" mode="append">
      <!--
        Whether to append 'false' to the fonthashhint setting.
        Default: 'false'
      -->
      <bool>{{ font_hash_hint | default('false') }}</bool>
    </edit>
  </match>
  <match>
    <test name="lang" compare="contains">
      <string>bho</string>
    </test>
    <test name="family">
      <string>sans-serif</string>
    </test>
    <edit name="family" mode="prepend">
      <string>{{ font_family | default('Noto Sans Devanagari UI') }}</string>
    </edit>
    <edit name="fonthashint" mode="append">
      <bool>{{ font_hash_hint | default('false') }}</bool>
    </edit>
  </match>
  <match>
    <test name="lang" compare="contains">
      <string>brx</string>
    </test>
    <test name="family">
