    </test>
    <edit name="family" mode="prepend">
      <string>{{ font_family | default('Noto Sans Devanagari UI') }}</string>
    </edit>
    <edit name="fonthashint" mode="append">
      <bool>{{ font_hash_hint | default('false') }}</bool>
    </edit>
  </match>
  <!--
    Alias block: Ensures that the configured font family is available
    under the standard 'sans-serif' alias if no specific language match
    occurs or for general fallback.
  -->
  <alias>
    <family>{{ font_family | default('Noto Sans Devanagari UI') }}</family>
    <default>
      <family>sans-serif</family>
    </default>
  </alias>
</fontconfig>
