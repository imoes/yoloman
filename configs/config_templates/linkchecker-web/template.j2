{# Apache mod_wsgi configuration for the linkchecker-web service. #}
<IfModule mod_wsgi.c>

  {# The URL path alias for the WSGI script. Maps the URL to the WSGI application entry point. #}
  WSGIScriptAlias {{ web_root_alias | default('/lconlinewsgi') }}/lc.wsgi {{ wsgi_script_path | default('/usr/lib/cgi-bin/lc.wsgi') }}

  {# The URL path alias for the web root directory. Serves static files from the specified directory. #}
  Alias {{ web_root_alias | default('/lconlinewsgi') }} {{ web_root_dir | default('/usr/share/linkchecker/lconline') }}

  {# allow people to read the files #}
  <Directory "{{ web_root_dir | default('/usr/share/linkchecker/lconline') }}">
    Options Indexes MultiViews
    <IfVersion >= 2.3>
      Require local
    </IfVersion>
    <IfVersion < 2.3>
      Order deny,allow
      Deny from all
      Allow from 127.0.0.0/255.0.0.0
{# Before uncommenting the following lines please put IP address
   of your computer in the Allow line #}
      # Allow from {{ custom_allow_host_ip | default('REPLACE-WITH.YOUR-HOST.IP-ADDRESS') }}
{# IPv6 addresses work only with apache2 #}
      Allow from ::1/128
    </IfVersion>
  </Directory>

  <Location "{{ web_root_alias | default('/lconlinewsgi') }}/lc.wsgi">
    <IfVersion >= 2.3>
      Require local
    </IfVersion>
    <IfVersion < 2.3>
      Order deny,allow
      Deny from all
      Allow from 127.0.0.0/255.0.0.0
{# Before uncommenting the following lines please put IP address
   of your computer in the Allow line #}
      # Allow from {{ custom_allow_host_ip | default('REPLACE-WITH.YOUR-HOST.IP-ADDRESS') }}
{# IPv6 addresses work only with apache2 #}
      Allow from ::1/128
    </IfVersion>
  </Location>

</IfModule>
