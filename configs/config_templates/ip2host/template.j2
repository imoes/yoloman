#!/usr/bin/perl -w
# ip2host configuration script generated by Ansible Jinja2 template
# This script is used to run ip2host with the specified parameters.
#
# Self-documenting: every variable is sourced from the Ansible schema with
# safe defaults to prevent render failures when optional fields are absent.

use strict;
use warnings;

# Number of child processes to spawn
my $children = {{ children | default(40) }};

# Seconds to wait on DNS response
my $timeout = {{ timeout | default(20) }};

# Maximum number of log lines to keep in memory
my $buffer = {{ buffer | default(50000) }};

# Number of lines to process before flushing output buffer
my $flush = {{ flush | default(500) }};

# Filename to use as disk cache. Empty string means none.
# Note: defaults to empty string; if not provided, the runtime check below skips it.
my $cache_file = {{ cache_file | default('') }};

# Number of seconds before IPs cached on disk are expired
my $ttl = {{ ttl | default(604800) }};

# Match IPv6 addresses too
my $ipv6 = {{ ipv6 | default(False) | ternary(1, 0) }};

# Perl regular expression to match IP
my $regex = {{ regex | default('') }};

# Build command line arguments
my @args = ();

push @args, "--children=$children" if defined $children && $children ne '';
push @args, "--timeout=$timeout" if defined $timeout && $timeout ne '';
push @args, "--buffer=$buffer" if defined $buffer && $buffer ne '';
push @args, "--flush=$flush" if defined $flush && $flush ne '';

if ($cache_file && $cache_file ne '') {
    push @args, "--cache=$cache_file";
}

push @args, "--ttl=$ttl" if defined $ttl && $ttl ne '';

push @args, "--ipv6" if $ipv6 == 1;

if ($regex && $regex ne '') {
    push @args, "--regex=$regex";
}

# Execute ip2host
exec('/usr/bin/ip2host', @args) or die "Failed to exec ip2host: $!";