{
  "cluster": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "Cluster configuration for distributed Incus deployment.",
    "items": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "Enable cluster mode for this server."
      },
      "server_name": {
        "type": "string",
        "default": "",
        "description": "Unique name for this server in the cluster."
      },
      "server_address": {
        "type": "string",
        "default": "",
        "description": "Network address (host:port) for this server's cluster communication."
      },
      "member_config": {
        "type": "list",
        "default": [],
        "description": "List of per-entity configuration overrides for cluster members.",
        "items": {
          "type": "object",
          "fields": {
            "entity": {
              "type": "string",
              "default": "",
              "description": "Entity type (e.g., 'storage', 'network', 'instance')"
            },
            "key": {
              "type": "string",
              "default": "",
              "description": "Configuration key (e.g., 'source', 'size')"
            },
            "value": {
              "type": "string",
              "default": "",
              "description": "Configuration value for the key"
            }
          }
        }
      }
    }
  },
  "storage_pools": {
    "type": "list",
    "default": [],
    "description": "List of storage pools to configure.",
    "items": {
      "type": "object",
      "fields": {
        "name": {
          "type": "string",
          "default": "default",
          "description": "Name of the storage pool."
        },
        "driver": {
          "type": "string",
          "default": "dir",
          "description": "Storage driver (e.g., 'dir', 'zfs', 'btrfs', 'lvm')"
        },
        "config": {
          "type": "object",
          "default": {},
          "description": "Driver-specific configuration key-value pairs (e.g., 'source' for path or device)."
        }
      }
    }
  },
  "networks": {
    "type": "list",
    "default": [],
    "description": "List of networks to configure.",
    "items": {
      "type": "object",
      "fields": {
        "name": {
          "type": "string",
          "default": "incusbr0",
          "description": "Name of the network."
        },
        "type": {
          "type": "string",
          "default": "bridge",
          "description": "Network type (e.g., 'bridge', 'ovs', 'macvlan')"
        },
        "config": {
          "type": "object",
          "default": {
            "ipv4.address": "auto",
            "ipv6.address": "auto"
          },
          "description": "Network configuration (e.g., bridge settings, routing, DNS)."
        },
        "managed": {
          "type": "bool",
          "default": true,
          "description": "Whether Incus should manage this network (create, delete, configure)."
        }
      }
    }
  },
  "projects": {
    "type": "list",
    "default": [],
    "description": "List of project names to enable. If empty, only the 'default' project exists."
  },
  "auth": {
    "type": "object",
    "default": {
      "method": "tls",
      "trusted_ca": true
    },
    "description": "Authentication configuration.",
    "items": {
      "method": {
        "type": "string",
        "default": "tls",
        "description": "Authentication method: 'tls' (default), 'oidc', 'jwt', or 'none'."
      },
      "trusted_ca": {
        "type": "bool",
        "default": true,
        "description": "Require clients to present certificates signed by a trusted CA."
      }
    }
  },
  "logging": {
    "type": "object",
    "default": {
      "logger": "logger-file",
      "level": "info",
      "format": "json"
    },
    "description": "Server logging configuration.",
    "items": {
      "logger": {
        "type": "string",
        "default": "logger-file",
        "description": "Logging backend: 'logger-file' (default), 'logger-syslog', or 'logger-stdout'."
      },
      "level": {
        "type": "string",
        "default": "info",
        "description": "Minimum log level: 'debug', 'info', 'warn', 'error'."
      },
      "format": {
        "type": "string",
        "default": "json",
        "description": "Log format: 'json' (structured), 'text' (human-readable)."
      }
    }
  },
  "metrics": {
    "type": "object",
    "default": {
      "bind_address": "[::]:8080",
      "cert": "",
      "key": ""
    },
    "description": "Metrics endpoint configuration for Prometheus scraping.",
    "items": {
      "bind_address": {
        "type": "string",
        "default": "[::]:8080",
        "description": "Address and port to bind the metrics server (supports IPv6)."
      },
      "cert": {
        "type": "string",
        "default": "",
        "description": "Path to TLS certificate for metrics endpoint (optional)."
      },
      "key": {
        "type": "string",
        "default": "",
        "description": "Path to TLS private key for metrics endpoint (optional)."
      }
    }
  },
  "security": {
    "type": "object",
    "default": {
      "encryption": {
        "auto": false
      }
    },
    "description": "Global security settings.",
    "items": {
      "encryption": {
        "type": "object",
        "items": {
          "auto": {
            "type": "bool",
            "default": false,
            "description": "Automatically encrypt instance and snapshot storage."
          }
        }
      }
    }
  }
}
