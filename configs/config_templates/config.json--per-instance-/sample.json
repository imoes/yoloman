{
  "cluster": {
    "enabled": false
  },
  "storage_pools": [
    {
      "name": "default",
      "driver": "zfs",
      "config": {
        "source": "incus-zpool",
        "size": "10GiB"
      }
    }
  ],
  "networks": [
    {
      "name": "incusbr0",
      "type": "bridge",
      "config": {
        "ipv4.address": "10.0.8.1/24",
        "ipv4.nat": "true",
        "ipv6.address": "fd42:406d:6163:733a::1/64",
        "ipv6.nat": "true"
      },
      "managed": true
    }
  ],
  "projects": [
    "default"
  ],
  "auth": {
    "method": "tls",
    "trusted_ca": true
  },
  "logging": {
    "logger": "logger-file",
    "level": "info",
    "format": "text"
  },
  "metrics": {
    "bind_address": "[::]:8080",
    "cert": "",
    "key": ""
  },
  "security": {
    "encryption": {
      "auto": false
    }
  }
}
