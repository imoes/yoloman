# The server's cluster-wide configuration (if part of a cluster)
{
  {% if cluster.enabled %}
  "cluster": {
    "enabled": true,
    "server_name": "{{ cluster.server_name }}",
    "server_address": "{{ cluster.server_address }}",
    "member_config": [
      {% for item in cluster.member_config %}
      {
        "entity": "{{ item.entity }}",
        "key": "{{ item.key }}",
        "value": "{{ item.value }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  },
  {% else %}
  "cluster": {
    "enabled": false
  },
  {% endif %}

  # Storage pool configuration
  "storage_pools": [
    {% for pool in storage_pools %}
    {
      "name": "{{ pool.name }}",
      "driver": "{{ pool.driver }}",
      "config": {
        {% for k, v in pool.config.items() %}
        "{{ k }}": "{{ v }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],

  # Network configuration
  "networks": [
    {% for network in networks %}
    {
      "name": "{{ network.name }}",
      "type": "{{ network.type }}",
      "config": {
        {% for k, v in network.config.items() %}
        "{{ k }}": "{{ v }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      },
      "managed": {{ network.managed }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],

  # Project configuration
  "projects": [
    {% for project in projects %}
    "{{ project.name }}"{% if not loop.last %},{% endif %}
    {% endfor %}
  ],

  # Authentication configuration
  "auth": {
    "method": "{{ auth.method }}",
    "trusted_ca": {{ auth.trusted_ca }}
  },

  # Logging configuration
  "logging": {
    "logger": "{{ logging.logger }}",
    "level": "{{ logging.level }}",
    "format": "{{ logging.format }}"
  },

  # Metrics configuration
  "metrics": {
    "bind_address": "{{ metrics.bind_address }}",
    "cert": "{{ metrics.cert }}",
    "key": "{{ metrics.key }}"
  },

  # Security configuration
  "security": {
    "encryption": {
      "auto": {{ security.encryption.auto }}
    }
  }
}
