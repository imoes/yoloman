# Scalpel configuration file
#
# Scalpel is a forensics tool used to carve files from disk images based on
# file signatures (headers and footers). This template configures the file
# types and their maximum carving sizes.
#
# Syntax explanation:
#   wildcard <char>
#     extension <case_sensitive> <max_size> <header> <footer> [REVERSE|NEXT|FORWARD_NEXT]
#
# - 'case_sensitive': 'y' or 'n'
# - 'max_size': Maximum file size in bytes to carve.
# - 'header': Hex string or literal characters to match start of file.
# - 'footer': Hex string or literal characters to match end of file.
# - 'REVERSE': Search backwards from header + size to find last footer.
# - 'NEXT': Carve header and data BEFORE first footer.
# - 'FORWARD_NEXT': Carve header and first footer (default).

# wildcard: The wildcard character used to match any single byte.
# If changed, all occurrences in headers/footers must also be updated.
# Default is '#wildcard  ?'.
{{ wildcard | default('#wildcard  ?') }}

#		 case	size	header			footer
#extension   sensitive
#
#---------------------------------------------------------------------
# GRAPHICS FILES
#---------------------------------------------------------------------

# GIF and JPG files (very common)

# GIF (version 87a)
#		gif	y	{{ gif_max_size | default(5000000) }}		\x47\x49\x46\x38\x37\x61	\x00\x3b
# GIF (version 89a)
#		gif	y	{{ gif_max_size | default(5000000) }}		\x47\x49\x46\x38\x39\x61	\x00\x3b
# JPEG (standard)
#		jpg	y	{{ jpg_max_size | default(5242880) }}		\xff\xd8\xff???Exif		\xff\xd9	REVERSE
# JPEG (JFIF standard)
#		jpg	y	{{ jpg_max_size | default(5242880) }}		\xff\xd8\xff???JFIF		\xff\xd9	REVERSE

# PNG
#		png	y	{{ png_max_size | default(20000000) }}	\x50\x4e\x47?	\xff\xfc\xfd\xfe

# BMP (used by MSWindows)
#       bmp	y	{{ bmp_max_size | default(100000) }}	BM??\x00\x00\x00

# TIFF (Intel byte order)
#		tif	y	{{ tif_max_size | default(200000000) }}	\x49\x49\x2a\x00
# TIFF (Motorola byte order)
#		tif	y	{{ tif_max_size | default(200000000) }}	\x4D\x4D\x00\x2A

