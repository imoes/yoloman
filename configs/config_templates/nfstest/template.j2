# nfstest configuration template
# Generated for nfstest package

# IP or hostname of the NFS server under test.
server = {{ (server is defined) | ternary(server, '') }}

# IP or hostname of the NFS client running the tests.
client = {{ client | default('localhost') }}

# IP or hostname of the destination server for inter-server copy tests.
dst_server = {{ dst_server | default('') }}

# General verbosity level: none, opts, info, debug, all, intbitmask.
verbose = {{ verbose | default('info') }}

# Test verbosity level: group, normal, verbose.
tverbose = {{ tverbose | default('normal') }}

# Mount point directory for NFS tests.
mtpoint = {{ mtpoint | default('/mnt/t') }}

# Data directory for I/O tests.
datadir = {{ datadir | default('/mnt/t/data') }}

# Path to the log file for test output.
log_file = {{ log_file | default('/var/log/nfstest.log') }}

# Comma-separated NFS kernel debug flags (e.g., proc, xdr).
nfs_debug_flags = {{ nfs_debug_flags | default('') }}

# Comma-separated RPC kernel debug flags.
rpc_debug_flags = {{ rpc_debug_flags | default('') }}

# Comma-separated list of tests to run. Prefix with '^' to exclude.
run_tests = {{ run_tests | default('') }}

# Path to file containing known bug messages.
bugmsgs_file = {{ bugmsgs_file | default('') }}

# If true, ignore all bugs defined in bugmsgs_file.
ignore_bugs = {{ ignore_bugs | default(False) }}

# If true, do not remove trace files after execution.
keep_traces = {{ keep_traces | default(False) }}

# If true, create the log file specified by log_file.
create_log = {{ create_log | default(True) }}

# Path to packet capture file (pcap/tcpdump) for analysis tools.
trace_file = {{ trace_file | default('') }}

# File path or handle for nfstest_file analysis.
trace_path = {{ trace_path | default('') }}

# Number of processes for nfstest_io.
io_processes = {{ io_processes | default(1) }}

# Duration in seconds for nfstest_io.
io_runtime = {{ io_runtime | default(3600) }}