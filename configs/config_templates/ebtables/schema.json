{
  "input_rules": {
    "type": "list",
    "default": [],
    "description": "List of INPUT chain rules. Each rule specifies match criteria and target action.",
    "items": {
      "comment": {
        "type": "string",
        "default": "",
        "description": "Human-readable description of the rule (used in comment line)."
      },
      "match": {
        "type": "string",
        "default": "",
        "description": "ebtables match clause (e.g., '-i eth0 --proto IPv4 --ip-src 192.168.1.0/24')"
      },
      "target": {
        "type": "string",
        "default": "ACCEPT",
        "description": "Target action: ACCEPT, DROP, REJECT, or custom chain name."
      }
    }
  },
  "output_rules": {
    "type": "list",
    "default": [],
    "description": "List of OUTPUT chain rules (similar structure to input_rules).",
    "items": {
      "comment": {
        "type": "string",
        "default": "",
        "description": "Human-readable description of the rule."
      },
      "match": {
        "type": "string",
        "default": "",
        "description": "ebtables match clause."
      },
      "target": {
        "type": "string",
        "default": "ACCEPT",
        "description": "Target action."
      }
    }
  },
  "forward_rules": {
    "type": "list",
    "default": [],
    "description": "List of FORWARD chain rules (for traffic bridged through this host).",
    "items": {
      "comment": {
        "type": "string",
        "default": "",
        "description": "Human-readable description of the rule."
      },
      "match": {
        "type": "string",
        "default": "",
        "description": "ebtables match clause."
      },
      "target": {
        "type": "string",
        "default": "ACCEPT",
        "description": "Target action."
      }
    }
  }
}
