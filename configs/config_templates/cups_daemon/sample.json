{
 "browse_protocols": "",
 "cupsd": {
  "AccessLogFile": "/var/log/cups/access_log",
  "AllowFrom": [
   "127.0.0.1",
   "192.168.1.0/24"
  ],
  "BindLocalhostOnly": false,
  "BrowseProtocols": [
   "cups",
   "mdns"
  ],
  "BrowsingEnabled": true,
  "DefaultAuthType": "Basic",
  "DefaultPrinterName": "HP_LaserJet_Pro",
  "JobLog": "/var/log/cups/job_log",
  "KeepFiles": true,
  "ListenAddress": "*",
  "ListenPort": 631,
  "LogFile": "/var/log/cups/error_log",
  "LogLevel": "warn",
  "MaxJobTime": 86400,
  "MaxJobs": 1000,
  "Policies": [
   {
    "AuthInfoRequired": "user",
    "OperationAllow": [],
    "OperationDeny": [
     "Pause-Printer",
     "Resume-Printer"
    ],
    "name": "default"
   },
   {
    "AuthInfoRequired": "user",
    "OperationAllow": [
     "Cancel-Jobs",
     "Validate-Job"
    ],
    "OperationDeny": [],
    "name": "admin"
   },
   {
    "AuthInfoRequired": "user",
    "OperationAllow": [
     "Restart-Server",
     "Shutdown-Server"
    ],
    "OperationDeny": [],
    "name": "system"
   }
  ],
  "PrintcapFile": "/etc/printcap",
  "PrintcapFormat": "bsd",
  "RemoteAdminEnabled": false,
  "RunAsGroup": "lp",
  "RunAsUser": "root",
  "SSLEnabled": true,
  "ServerAlias": "",
  "ServerName": "printserver.example.com",
  "SharePrinters": true,
  "WebInterfaceEnabled": true
 }
}
