# ==============================================================================
# Zabbix Java Gateway Configuration
# This file is sourced by the init script (/etc/init.d/zabbix-java-gateway).
# ==============================================================================

### Option: zabbix.listenIP
# Description: IP address to listen on.
# Default: None (listens on all interfaces)
{# If listen_ip is not defined or empty, omit the variable entirely so the init script uses its default or binds all interfaces #}
{%- if listen_ip is defined and listen_ip is not none and listen_ip | trim | length > 0 %}
{% if listen_ip is defined and listen_ip is not none and (listen_ip is number or listen_ip is boolean or listen_ip | length > 0) %}LISTEN_IP="{{ listen_ip }}"{% else %}# LISTEN_IP="0.0.0.0"{% endif %}
{%- endif %}

### Option: zabbix.listenPort
# Description: Port to listen on.
# Default: 10052
{% if listen_port is defined and listen_port is not none and (listen_port is number or listen_port is boolean or listen_port | length > 0) %}LISTEN_PORT={{ listen_port | default(10052) }}{% else %}# LISTEN_PORT=10052{% endif %}

### Option: zabbix.pidFile
# Description: Name of PID file.
# Default: /run/zabbix/zabbix_java_gateway.pid
# Note: The directory containing this file is specified by run_directory.
PID_FILE="{{ pid_file | default('/run/zabbix/zabbix_java_gateway.pid') }}"

### Option: zabbix.startPollers
# Description: Number of worker threads to start.
# Default: 5
# Range: 1-1000
{% if start_pollers is defined and start_pollers is not none and (start_pollers is number or start_pollers is boolean or start_pollers | length > 0) %}START_POLLERS={{ start_pollers | default(5) }}{% else %}# START_POLLERS=5{% endif %}

### Option: zabbix.timeout
# Description: How long to wait for network operations.
# Default: 3
# Range: 1-30
{% if timeout is defined and timeout is not none and (timeout is number or timeout is boolean or timeout | length > 0) %}TIMEOUT={{ timeout | default(3) }}{% else %}# TIMEOUT=3{% endif %}

### Option: zabbix.propertiesFile
# Description: Name of properties file. Can be used to set additional properties
# in a such way that they are not visible on a command line or to overwrite existing ones.
# Default: None (no extra properties file)
{# If properties_file is not defined or empty, omit the variable entirely #}
{%- if properties_file is defined and properties_file is not none and properties_file | trim | length > 0 %}
{% if properties_file is defined and properties_file is not none and (properties_file is number or properties_file is boolean or properties_file | length > 0) %}PROPERTIES_FILE="{{ properties_file }}"{% else %}# PROPERTIES_FILE={% endif %}
{%- endif %}

### JVM options (passed to /usr/bin/java).
# Description: JVM options passed to /usr/bin/java.
# Default: -Xmx256m
JAVA_OPTIONS="{{ java_options | default('-Xmx256m') }}"

### Run Directory
# Description: The directory where the PID file and runtime data are stored.
# Default: /run/zabbix
# Note: This is primarily used by the init script, but stored here for reference
# if the service needs to create it.
RUN_DIRECTORY="{{ run_directory | default('/run/zabbix') }}"

### Shutdown Retry Policy
# Description: The shutdown retry policy for start-stop-daemon, specifying signal,
# timeout, second signal, and second timeout.
# Default: TERM/30/KILL/5
SHUTDOWN_RETRY="{{ shutdown_retry | default('TERM/30/KILL/5') }}"
