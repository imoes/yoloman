{
  "listen_ip": {
    "type": "string",
    "default": null,
    "description": "IP address to listen on."
  },
  "listen_port": {
    "type": "number",
    "default": null,
    "description": "Port to listen on."
  },
  "pid_file": {
    "type": "string",
    "default": "/run/zabbix/zabbix_java_gateway.pid",
    "description": "Name of PID file."
  },
  "start_pollers": {
    "type": "number",
    "default": null,
    "description": "Number of worker threads to start."
  },
  "timeout": {
    "type": "number",
    "default": null,
    "description": "How long to wait for network operations."
  },
  "properties_file": {
    "type": "string",
    "default": null,
    "description": "Name of properties file."
  },
  "java_options": {
    "type": "string",
    "default": "-Xmx256m",
    "description": "JVM options passed to /usr/bin/java."
  },
  "run_directory": {
    "type": "string",
    "default": "/run/zabbix",
    "description": "The directory where the PID file and runtime data are stored."
  },
  "shutdown_retry": {
    "type": "string",
    "default": "TERM/30/KILL/5",
    "description": "The shutdown retry policy for start-stop-daemon, specifying signal, timeout, second signal, and second timeout."
  }
}
