{
  "base_directory": "/var/lib/evolution-data-server",
  "runtime_directory": "/run/evolution-data-server",
  "bind_address": "127.0.0.1",
  "caldav_port": 8009,
  "carddav_port": 8008,
  "enable_addressbook": true,
  "enable_calendar": true,
  "enable_tasks": true,
  "enable_mail": false,
  "backends": [
    {
      "name": "imap",
      "type": "imap",
      "uri": "imap://mail.example.com:143",
      "user": "%u",
      "ssl": true,
      "starttls": false
    },
    {
      "name": "ldap",
      "type": "ldap",
      "uri": "ldap://ldap.example.com:389",
      "user": "cn=admin,dc=example,dc=com",
      "password": "secret",
      "ssl": false,
      "starttls": true
    }
  ],
  "max_connections": 200,
  "max_cached_connections": 25,
  "query_timeout": 45,
  "log_level": "info",
  "log_file": "/var/log/evolution-data-server.log",
  "require_ssl": true,
  "ssl_cert_file": "/etc/ssl/certs/evolution.crt",
  "ssl_key_file": "/etc/ssl/private/evolution.key",
  "ssl_ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "auth_backends": [
    {
      "name": "pam",
      "module": "pam",
      "method": "plain"
    }
  ]
}
