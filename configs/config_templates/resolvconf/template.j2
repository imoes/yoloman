#
# resolvconf script fragment to make dhclient supply nameserver information.
#
# This script is sourced by dhclient scripts to update /etc/resolv.conf via the
# resolvconf utility. It is NOT a configuration template in the traditional sense,
# but a shell script fragment that must remain compatible with the ISC DHCP client.
#
# The variables injected by dhclient (e.g., new_domain_name_servers, interface)
# are runtime variables. This script maps them to resolvconf commands.
#
# NOTE: The actual /etc/resolv.conf is generated dynamically by resolvconf.
# Do not edit /etc/resolv.conf directly if resolvconf is managing it.
#

if [ -x /usr/sbin/resolvconf ] ; then
	# For safety, first undefine the nasty default make_resolv_conf()
	# to ensure we use our own implementation below.
	make_resolv_conf() { : ; }

	case "$reason" in
	  # BOUND, RENEW, REBIND, REBOOT, TIMEOUT: IPv4 lease acquired/renewed
	  BOUND|RENEW|REBIND|REBOOT|TIMEOUT)
		# Define a resolvconf-compatible m_r_c() function
		# It gets run later (or, in the TIMEOUT case, MAY get run later)
		make_resolv_conf() {
			local R
			local N
			R=""

			# Add domain directive if domain name is available
			if [ "$new_domain_name" ] ; then
				R="${R}domain $new_domain_name
"
			fi

			# Add search directive if search domain is available
			if [ "$new_domain_search" ] ; then
				R="${R}search $new_domain_search
"
			fi

			# Add each IPv4 nameserver
			if [ "$new_domain_name_servers" ] ; then
				for N in $new_domain_name_servers ; do
					R="${R}nameserver $N
"
				done
			fi

			# Submit the generated configuration to resolvconf
			# Interface name defaults to "lo" if empty, but typically set by dhclient
			[ ! "$interface" ] || echo -n "$R" | /usr/sbin/resolvconf -a "${interface}.dhclient"
		}
		;;

	  # BOUND6, RENEW6, REBIND6: IPv6 lease acquired/renewed
	  BOUND6|RENEW6|REBIND6)
		# Define a resolvconf-compatible m_r_c() function
		# It gets run later (or, in the TIMEOUT case, MAY get run later)
		make_resolv_conf() {
			local R
			local N
			local N_LOW
			local ZONE_ID

			R=""

			# Add search directive for IPv6 if available
			if [ "$new_dhcp6_domain_search" ] ; then
				R="${R}search $new_dhcp6_domain_search
"
			fi

			# Add each IPv6 nameserver
			if [ "$new_dhcp6_name_servers" ] ; then
				for N in $new_dhcp6_name_servers ; do
					N_LOW="$(echo "$N" | tr '[:upper:]' '[:lower:]')"

					# If the nameserver has a link-local address (fe80::/10),
					# add a zone ID (interface name) to it to resolve ambiguity.
					if expr "$N_LOW" : ^fe80:: >/dev/null ; then
						ZONE_ID="%$interface"
					else
						ZONE_ID=""
					fi
					R="${R}nameserver $N${ZONE_ID}
"
				done
			fi

			# Submit the generated configuration to resolvconf for IPv6
			[ ! "$interface" ] || echo -n "$R" | /usr/sbin/resolvconf -a "${interface}.ip6.dhclient"
		}
		;;

	  # EXPIRE, FAIL, RELEASE, STOP: IPv4 lease lost or interface down
	  EXPIRE|FAIL|RELEASE|STOP)
		# Delete resolv.conf info for the interface
		# This cleans up the dynamically generated resolv.conf entries
		[ ! "$interface" ] || /usr/sbin/resolvconf -d "${interface}.dhclient"
		;;

	  # EXPIRE6, RELEASE6, STOP6: IPv6 lease lost or interface down
	  EXPIRE6|RELEASE6|STOP6)
		# Delete resolv.conf info for the interface (IPv6)
		[ ! "$interface" ] || /usr/sbin/resolvconf -d "${interface}.ip6.dhclient"
		;;

	esac
fi