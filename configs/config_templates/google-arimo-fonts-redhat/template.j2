<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
    <!--
      This template configures font aliasing within Fontconfig.
      It replaces the 'Arial' font family with the 'Arimo' font family.
    -->

    <!--
      Alias: Map 'Arial' to 'Arimo' (Acceptance).
      When an application requests 'Arial', Fontconfig will accept 'Arimo' as a match.
    -->
    <alias binding="same">
        <family>Arial</family>
        <accept>
            <!-- The name of the Arimo font family alias. Defaults to 'Arimo'. -->
            <family>{{ arimo_family_name | default('Arimo') }}</family>
        </accept>
    </alias>

    <!--
      Alias: Map 'Arimo' to 'Arial' (Default).
      When an application requests 'Arimo', Fontconfig will default to 'Arial' if Arimo is not installed,
      effectively making Arial the fallback for Arimo requests.
    -->
    <alias binding="same">
        <family>{{ arimo_family_name | default('Arimo') }}</family>
        <default>
            <family>Arial</family>
        </default>
    </alias>
</fontconfig>
