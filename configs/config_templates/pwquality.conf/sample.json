{
  "minlen": 12,
  "minlower": 2,
  "minupper": 2,
  "mindigits": 2,
  "minother": 1,
  "maxrepeat": 2,
  "maxclassrepeat": 3,
  "dictcheck": true,
  "dictpath": "/usr/share/dict/cracklib-passwords",
  "usercheck": true,
  "revusercheck": true,
  "similarity": 30,
  "enforce_for_root": true,
  "oldcheck": true,
  "remember": 5,
  "gecoscheck": true,
  "debug": false,
  "strict": true,
  "extra_configs": [
    "/etc/security/pwquality.conf.d/ldap-users.conf",
    "/etc/security/pwquality.conf.d/service-accounts.conf"
  ]
}
