<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- SPDX-License-Identifier: MIT -->
<!--
  Self-documenting Fontconfig aliasing and metadata template for STIX Fonts (Red Hat packaging).
  This file configures fontconfig to:
  1. Prepend STIX family metadata to font names for proper identification.
  2. Set font versions for STIX Two Text and STIX Two Math families.
  3. Provide backward-compatibility aliases from legacy STIX General/Integrals families to the new STIX Two family.
  4. Prefer the STIX family for the generic 'serif' font class.
-->
<fontconfig>
  <!--
    Match Block: STIX Two Text Bold
    Configures metadata for the Bold variant of STIX Two Text.
  -->
  <match target="scan">
    <!-- Test against the full font name for the Bold variant -->
    <test name="fullname">
      <!-- Full name of the STIX Two Text Bold font variant -->
      <string>{{ stix_two_text_bold_fullname | default('STIX Two Text Bold') }}</string>
    </test>
    <!-- Test against the font family name -->
    <test name="family">
      <!-- Family name for STIX Two Text fonts -->
      <string>{{ stix_two_text_family | default('STIX Two Text') }}</string>
    </test>
    <!-- Test against the font style name -->
    <test name="style">
      <!-- Style name for the Bold variant -->
      <string>{{ stix_two_text_bold_style | default('Bold') }}</string>
    </test>
    <!-- Edit: Prepend the primary STIX full name to the existing fullname -->
    <edit name="fullname" mode="prepend">
      <!-- Prepended full name for the Bold variant -->
      <string>{{ stix_bold_fullname | default('STIX Bold') }}</string>
    </edit>
    <!-- Edit: Prepend the primary STIX family name to the existing family name -->
    <edit name="family" mode="prepend">
      <!-- Primary STIX family name used for aliases and prepends -->
      <string>{{ stix_family | default('STIX') }}</string>
    </edit>
    <!-- Edit: Set the font version for STIX Two Text fonts -->
    <edit name="fontversion">
      <int>{{ stix_fontversion_text | default(2) }}</int>
    </edit>
  </match>

  <!--
    Match Block: STIX Two Text Bold Italic
    Configures metadata for the Bold Italic variant of STIX Two Text.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name of the STIX Two Text Bold Italic font variant -->
      <string>{{ stix_two_text_bold_italic_fullname | default('STIX Two Text Bold Italic') }}</string>
    </test>
    <test name="family">
      <string>{{ stix_two_text_family | default('STIX Two Text') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Bold Italic variant -->
      <string>{{ stix_two_text_bold_italic_style | default('Bold Italic') }}</string>
    </test>
    <edit name="fullname" mode="prepend">
      <!-- Prepended full name for the Bold Italic variant -->
      <string>{{ stix_bold_italic_fullname | default('STIX Bold Italic') }}</string>
    </edit>
    <edit name="family" mode="prepend">
      <string>{{ stix_family | default('STIX') }}</string>
    </edit>
    <edit name="fontversion">
      <int>{{ stix_fontversion_text | default(2) }}</int>
    </edit>
  </match>

  <!--
    Match Block: STIX Two Text Italic
    Configures metadata for the Italic variant of STIX Two Text.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name of the STIX Two Text Italic font variant -->
      <string>{{ stix_two_text_italic_fullname | default('STIX Two Text Italic') }}</string>
    </test>
    <test name="family">
      <string>{{ stix_two_text_family | default('STIX Two Text') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Italic variant -->
      <string>{{ stix_two_text_italic_style | default('Italic') }}</string>
    </test>
    <edit name="fullname" mode="prepend">
      <!-- Prepended full name for the Italic variant -->
      <string>{{ stix_italic_fullname | default('STIX Italic') }}</string>
    </edit>
    <edit name="family" mode="prepend">
      <string>{{ stix_family | default('STIX') }}</string>
    </edit>
    <edit name="fontversion">
      <int>{{ stix_fontversion_text | default(2) }}</int>
    </edit>
  </match>

  <!--
    Match Block: STIX Two Text Regular
    Configures metadata for the Regular variant of STIX Two Text.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name of the STIX Two Text Regular font variant -->
      <string>{{ stix_two_text_regular_fullname | default('STIX Two Text') }}</string>
    </test>
    <test name="family">
      <string>{{ stix_two_text_family | default('STIX Two Text') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Regular variant -->
      <string>{{ stix_two_text_regular_style | default('Regular') }}</string>
    </test>
    <edit name="fullname" mode="prepend">
      <!-- Prepended full name for the Regular variant -->
      <string>{{ stix_regular_fullname | default('STIX') }}</string>
    </edit>
    <edit name="family" mode="prepend">
      <string>{{ stix_family | default('STIX') }}</string>
    </edit>
    <edit name="fontversion">
      <int>{{ stix_fontversion_text | default(2) }}</int>
    </edit>
  </match>

  <!--
    Match Block: STIX Two Math
    Configures metadata for the STIX Two Math font.
  -->
  <match target="scan">
    <test name="fullname">
      <string>{{ stix_two_math_family | default('STIX Two Math') }}</string>
    </test>
    <test name="family">
      <string>{{ stix_two_math_family | default('STIX Two Math') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the STIX Two Math font -->
      <string>{{ stix_two_math_style | default('Regular') }}</string>
    </test>
    <edit name="fullname" mode="prepend">
      <string>{{ stix_regular_fullname | default('STIX') }}</string>
    </edit>
    <edit name="family" mode="prepend">
      <string>{{ stix_family | default('STIX') }}</string>
    </edit>
    <edit name="fontversion">
      <!-- Font version for STIX Two Math fonts -->
      <int>{{ stix_fontversion_math | default(1) }}</int>
    </edit>
  </match>

  <!--
    Alias Block: Primary STIX Family Aliasing
    Maps legacy STIX families to the new STIX Two family names.
  -->
  <alias binding="same">
    <family>{{ stix_family | default('STIX') }}</family>
    <accept>
      <family>STIXGeneral</family>
      <family>STIXIntegralsD</family>
      <family>STIXIntegralsSm</family>
      <family>STIXIntegralsUpD</family>
      <family>STIXIntegralsUp</family>
      <family>STIXNonUnicode</family>
      <family>STIXSizeFiveSym</family>
      <family>STIXSizeFourSym</family>
      <family>STIXSizeThreeSym</family>
      <family>STIXSizeTwoSym</family>
      <family>STIXSizeOneSym</family>
      <family>STIXVariants</family>
      <!-- Alias family name for STIX Math in the alias block -->
      <family>{{ stix_math_family | default('STIX Math') }}</family>
      <family>serif</family>
    </accept>
  </alias>

  <!-- Alias: STIXGeneral -> STIX -->
  <alias binding="same">
    <family>STIXGeneral</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXIntegralsD -> STIX -->
  <alias binding="same">
    <family>STIXIntegralsD</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXIntegralsSm -> STIX -->
  <alias binding="same">
    <family>STIXIntegralsSm</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXIntegralsUpD -> STIX -->
  <alias binding="same">
    <family>STIXIntegralsUpD</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXIntegralsUp -> STIX -->
  <alias binding="same">
    <family>STIXIntegralsUp</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXNonUnicode -> STIX -->
  <alias binding="same">
    <family>STIXNonUnicode</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXSizeFiveSym -> STIX -->
  <alias binding="same">
    <family>STIXSizeFiveSym</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXSizeFourSym -> STIX -->
  <alias binding="same">
    <family>STIXSizeFourSym</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXSizeThreeSym -> STIX -->
  <alias binding="same">
    <family>STIXSizeThreeSym</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXSizeTwoSym -> STIX -->
  <alias binding="same">
    <family>STIXSizeTwoSym</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXSizeOneSym -> STIX -->
  <alias binding="same">
    <family>STIXSizeOneSym</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIXVariants -> STIX -->
  <alias binding="same">
    <family>STIXVariants</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!-- Alias: STIX Math -> STIX -->
  <alias binding="same">
    <family>{{ stix_math_family | default('STIX Math') }}</family>
    <accept>
      <family>{{ stix_family | default('STIX') }}</family>
    </accept>
  </alias>

  <!--
    Alias Block: Serif Preference
    Ensures the serif font class prefers the STIX family.
  -->
  <alias>
    <family>serif</family>
    <prefer>
      <family>{{ stix_family | default('STIX') }}</family>
    </prefer>
  </alias>
</fontconfig>
