{
  "protocols": {
    "dnsd": true,
    "cups": false
  },
  "max_wait_time": 60,
  "max_jobs_per_printer": 100,
  "remote_printer_expire": 600,
  "listen_address": "*:631",
  "create_queues": true,
  "default_ppd": "drv:///sample.drv/generic.ppd",
  "auto_install_fonts": true,
  "raw_queues": false,
  "remove_on_disconnect": true,
  "exclude_uris": [
    "ipp://localhost/",
    "dnssd://localhost"
  ],
  "always_include_uris": [],
  "use_tls": true,
  "tls_ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "tls_client_cert": null,
  "tls_client_key": null,
  "debug_logging": false,
  "log_level": 2
}
