{
  "workdir": "/var/cache/botch",
  "architectures": [
    "amd64",
    "arm64",
    "armhf"
  ],
  "archive_root": "/srv/debian-archive",
  "use_stable_testing_only": true,
  "exclude_packages": [
    "linux-*",
    "gcc-*"
  ],
  "max_parallel_downloads": 8,
  "dose_config": "/etc/botch/dose3.conf",
  "include_arch_all_fvs": true,
  "build_order_output": "/var/log/botch/build-order.txt",
  "verbose": true
}
