# Generated by dmg2img config generator
# Do not edit manually; changes will be overwritten.

# Input .dmg file path
# Specifies the source disk image to be converted.
# Required by dmg2img unless the output path implies it.
{% set _cmd = (cmd | default({}, true)) %}
{% set _input_dmg = _cmd.input_dmg | default('', true) | trim %}
{% if _input_dmg %}
-i {{ _input_dmg }}
{% endif %}

# Output .img file path
# Specifies the destination raw disk image file.
# If omitted, dmg2img automatically names the output <input_file>.img.
{% set _output_img = _cmd.output_img | default('', true) | trim %}
{% if _output_img %}
-o {{ _output_img }}
{% endif %}

# Silent operation
# Suppresses progress messages and output to stdout/stderr.
{% if _cmd.silent | default(False, true) %}-s{% endif %}

# Verbose operation
# Enables standard verbose output (more detailed than default).
{% if _cmd.verbose | default(False, true) %}-v{% endif %}

# Extremely verbose operation
# Enables extremely detailed debugging output (logs/trace).
{% if _cmd.extremely_verbose | default(False, true) %}-V{% endif %}

# Debug mode
# Enables internal debugging features and error checks.
{% if _cmd.debug | default(False, true) %}-d{% endif %}

# Summary of all custom parameters
# If the 'cmd' mapping contains additional keys not handled above,
# they are appended here. This loop iterates over any extra
# key-value pairs provided in the 'cmd' object.
{% set _handled_keys = ['input_dmg', 'output_img', 'silent', 'verbose', 'extremely_verbose', 'debug'] %}
{% for item in _cmd | dict2items if item.key not in _handled_keys %}
{% if item.value is defined and item.value is not none %}
-{{ item.key }} {{ item.value | string }}
{% endif %}
{% endfor %}