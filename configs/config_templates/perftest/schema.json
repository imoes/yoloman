{
  "test_type": {
    "type": "string",
    "default": "bw",
    "description": "Type of perftest to run: bw, lat, raw_ethernet_bw, raw_ethernet_lat, etc.",
    "enum": [
      "bw",
      "lat",
      "raw_ethernet_bw",
      "raw_ethernet_lat",
      "raw_ethernet_burst_lat",
      "raw_ethernet_fs_rate",
      "ib_write_bw",
      "ib_read_bw",
      "ib_send_bw",
      "ib_atomic_bw",
      "ib_write_lat",
      "ib_read_lat",
      "ib_send_lat",
      "ib_atomic_lat"
    ]
  },
  "ib_device": {
    "type": "string",
    "default": "",
    "description": "IB device name (e.g., mlx5_0). Empty for auto."
  },
  "ib_port": {
    "type": "number",
    "default": 1,
    "description": "Port number on the IB device."
  },
  "connection_type": {
    "type": "string",
    "default": "RC",
    "description": "Connection type: RC, XRC, UC, UD, DC, SRD.",
    "enum": [
      "RC",
      "XRC",
      "UC",
      "UD",
      "DC",
      "SRD"
    ]
  },
  "server_ip": {
    "type": "string",
    "default": "",
    "description": "Server IP address to connect to."
  },
  "port": {
    "type": "number",
    "default": 18515,
    "description": "Port number for connection."
  },
  "use_rdma_cm": {
    "type": "bool",
    "default": false,
    "description": "Use rdma_cm for connection establishment."
  },
  "message_size": {
    "type": "number",
    "default": 65536,
    "description": "Message size in bytes."
  },
  "iterations": {
    "type": "number",
    "default": 1000,
    "description": "Number of iterations."
  },
  "duration_seconds": {
    "type": "number",
    "default": 0,
    "description": "Test duration in seconds. 0 means use iterations."
  },
  "num_qps": {
    "type": "number",
    "default": 1,
    "description": "Number of Queue Pairs."
  },
  "bidirectional": {
    "type": "bool",
    "default": false,
    "description": "Measure bidirectional bandwidth."
  },
  "report_gbits": {
    "type": "bool",
    "default": false,
    "description": "Report bandwidth in Gbit/sec."
  },
  "report_peak": {
    "type": "bool",
    "default": true,
    "description": "Report peak bandwidth."
  },
  "inline_size": {
    "type": "number",
    "default": 0,
    "description": "Max inline send size."
  },
  "rx_depth": {
    "type": "number",
    "default": 512,
    "description": "Receive queue depth."
  },
  "tx_depth": {
    "type": "number",
    "default": 128,
    "description": "Transmit queue depth."
  },
  "use_srq": {
    "type": "bool",
    "default": false,
    "description": "Use Shared Receive Queue."
  },
  "perform_warm_up": {
    "type": "bool",
    "default": false,
    "description": "Perform warm-up iterations."
  },
  "source_mac": {
    "type": "string",
    "default": "00:00:00:00:00:00",
    "description": "Source MAC address for RawEth."
  },
  "dest_mac": {
    "type": "string",
    "default": "00:00:00:00:00:00",
    "description": "Destination MAC address for RawEth."
  },
  "dest_ip": {
    "type": "string",
    "default": "",
    "description": "Destination IP for RawEth."
  },
  "source_ip": {
    "type": "string",
    "default": "",
    "description": "Source IP for RawEth."
  },
  "dest_port": {
    "type": "number",
    "default": 5001,
    "description": "Destination port for RawEth."
  },
  "source_port": {
    "type": "number",
    "default": 5001,
    "description": "Source port for RawEth."
  },
  "use_tcp": {
    "type": "bool",
    "default": false,
    "description": "Use TCP for RawEth."
  },
  "is_server": {
    "type": "bool",
    "default": false,
    "description": "Run as server in RawEth mode."
  }
}
