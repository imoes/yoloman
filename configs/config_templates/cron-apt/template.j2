# cron-apt: Automated package upgrade scheduler
#
# This file is managed by Ansible. Do not edit manually.
# It generates a crontab entry that triggers the cron-apt tool
# at a configured time of day.

# --- Daily Update Schedule ---
# Description: Hour of the day (0–23) when the daily cron-apt run should execute
# The cron-apt tool checks for available upgrades and downloads them.
# Default: 4
# Format: minute hour day-of-month month day-of-week user command
0 {{ hour | default(4) | int }}	* * * root	test -x /usr/sbin/cron-apt && /usr/sbin/cron-apt