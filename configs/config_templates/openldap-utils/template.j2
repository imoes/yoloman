# Default LDAP server URI(s); space-separated for fallback or load balancing
URI {{ uri | join(' ') }}

# Default LDAP base DN for commands that omit -b
BASE {{ base_dn }}

# Path to certificate authority (CA) certificate(s) for TLS verification
# If empty, system CA store is used
TLS_CACERT {{ cacert_path | default('', true) }}

# Path to client certificate for mutual TLS (optional)
TLS_CERT {{ client_cert | default('', true) }}

# Path to client private key for mutual TLS (optional)
TLS_KEY {{ client_key | default('', true) }}

# TLS protocol version(s) to allow (e.g., '0x0303' for TLS 1.2)
TLS_PROTOCOL_MIN {{ tls_protocol_min | default('', true) }}

# Require certificate verification (on/off); 'demand' = strict, 'allow' = optional
TLS_REQCERT {{ reqcert | default('demand') }}

# Default time limit (seconds) for search operations
TIMELIMIT {{ search_timelimit }}

# Default size limit (entries) for search operations
SIZELIMIT {{ search_sizelimit }}

# Default referral chasing (on/off)
REFERRALS {{ referrals | string | lower }}

# Default bind method (e.g., 'simple', 'sasl')
# Not commonly set globally — usually passed at CLI
# BINDMETHOD {{ bindmethod | default('simple') }}

# Default SASL mechanism (if BINDMETHOD=sasl)
# SASL_MECH {{ sasl_mech | default('', true) }}

# Log level for debugging (0–7; 0 = no debug)
DEBUG {{ debug_level }}

# Network timeout for connection establishment (seconds)
NETWORK_TIMEOUT {{ network_timeout }}

# Enable StartTLS negotiation (on/off)
# STARTTLS {{ starttls | string | lower }}
