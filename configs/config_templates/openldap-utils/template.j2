# ==============================================================================
# OpenLDAP Client Utilities Configuration (/etc/ldap/ldap.conf)
# This template generates a self-documenting, safe configuration for openldap-utils.
# Every directive is commented with its schema description and uses safe defaults.
# ==============================================================================

# LDAP server URIs. Supports multiple space-separated values for redundancy/failover.
# Schema field: uri (list of strings)
# Default: ['ldap://ldap.example.com']
URI {{ uri | default(['ldap://ldap.example.com']) | join(' ') }}

# Default base distinguished name (DN) for LDAP searches and operations.
# Used when no -b option is specified on the command line.
# Schema field: base_dn (string)
# Default: 'dc=example,dc=com'
BASE {{ base_dn | default('dc=example,dc=com') }}

# Path to CA certificate file for TLS verification.
# If empty, the system default CA store is used.
# Schema field: cacert_path (string)
# Default: ''
TLS_CACERT {{ cacert_path | default('') }}

# Path to client certificate file for mutual TLS (optional).
# Leave empty to disable client certificate authentication.
# Schema field: client_cert (string)
# Default: ''
TLS_CERT {{ client_cert | default('') }}

# Path to client private key file for mutual TLS (optional).
# Must match the client_cert if specified.
# Schema field: client_key (string)
# Default: ''
TLS_KEY {{ client_key | default('') }}

# Minimum TLS protocol version to allow (hex string).
# Empty string uses the system default. Example: '0x0303' for TLS 1.2.
# Schema field: tls_protocol_min (string)
# Default: ''
TLS_PROTOCOL_MIN {{ tls_protocol_min | default('') }}

# Server certificate verification policy.
# Options: never, allow, try, demand. 'demand' is strictest.
# Schema field: reqcert (string)
# Default: 'demand'
TLS_REQCERT {{ reqcert | default('demand') }}

# Maximum time in seconds allowed for search operations.
# 0 indicates no limit.
# Schema field: search_timelimit (int)
# Default: 30
TIMELIMIT {{ search_timelimit | default(30) }}

# Maximum number of entries returned by a search operation.
# 0 indicates no limit.
# Schema field: search_sizelimit (int)
# Default: 100
SIZELIMIT {{ search_sizelimit | default(100) }}

# Automatically chase referrals to other LDAP servers.
# 'yes' or 'no'.
# Schema field: referrals (bool)
# Default: True
REFERRALS {{ referrals | default(true) | ternary('yes', 'no') }}

# Debug verbosity level for logging.
# Range: 0-7. 0 = no debug, 7 = maximum detail.
# Schema field: debug_level (int)
# Default: 0
DEBUG {{ debug_level | default(0) }}

# Seconds to wait for a network connection before timing out.
# Schema field: network_timeout (int)
# Default: 10
NETWORK_TIMEOUT {{ network_timeout | default(10) }}