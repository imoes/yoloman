{
  "blacklist_kernel_modules": "true",
  "driver_support": true,
  "device_db_dir": "/usr/share/openrazer/device_db",
  "usb_autosuspend": true,
  "usb_init_timeout": 5,
  "legacy_devices": false,
  "extra_kernel_modules": [
    "razeraccessory",
    "razerchrome"
  ],
  "log_level": 2,
  "log_file": "/var/log/openrazer/daemon.log",
  "chroma_sdk": true,
  "synapse_compat": true,
  "wake_on_usb": false,
  "max_devices": 5,
  "runtime_dir": "/run/openrazer"
}
