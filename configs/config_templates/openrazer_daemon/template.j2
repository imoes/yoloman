# OpenRazer Daemon configuration file
# This file controls the behavior of the openrazer_daemon service

# Path to the kernel module blacklist file (used to prevent conflicts with native drivers)
BLACKLIST_KERNEL_MODULES={{ blacklist_kernel_modules }}

# Enable or disable driver support for Razer devices
DRIVER_SUPPORT={{ driver_support | lower }}

# Path to the device database directory
DEVICE_DB_DIR={{ device_db_dir }}

# Enable or disable USB device power management (USB autosuspend)
USB_AUTOSUSPEND={{ usb_autosuspend | lower }}

# Timeout (in seconds) for USB device initialization
USB_INIT_TIMEOUT={{ usb_init_timeout }}

# Enable or disable support for legacy devices
LEGACY_DEVICES={{ legacy_devices | lower }}

# List of additional kernel modules to explicitly load (optional)
{% if extra_kernel_modules %}
# Additional kernel modules to load
{% for module in extra_kernel_modules %}LOAD_MODULE={{ module }}
{% endfor %}
{% endif %}

# Log level: 0=ERROR, 1=WARN, 2=INFO, 3=DEBUG
LOG_LEVEL={{ log_level }}

# Log file path
LOG_FILE={{ log_file }}

# Enable or disable support for Chroma SDK (Razer Chroma API compatibility)
CHROMA_SDK={{ chroma_sdk | lower }}

# Enable or disable support for Razer Synapse 2/3 protocol compatibility
SYNAPSE_COMPAT={{ synapse_compat | lower }}

# Enable or disable device wake-on-USB support
WAKE_ON_USB={{ wake_on_usb | lower }}

# Maximum number of concurrent device connections
MAX_DEVICES={{ max_devices }}

# Path to the device manager runtime directory
RUNTIME_DIR={{ runtime_dir }}
