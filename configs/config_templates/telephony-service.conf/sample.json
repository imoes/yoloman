{
  "service_version": "1.4.0",
  "logging": {
    "level": "info",
    "file": "/var/log/telephony-service.log",
    "format": "text"
  },
  "network": {
    "bind_address": "0.0.0.0",
    "sip_port": 5060,
    "rtp_port_min": 16384,
    "rtp_port_max": 16484
  },
  "sip": {
    "outbound_proxy": "sip:sip.example.com:5060",
    "user_identity": "1000@example.com",
    "auth": {
      "username": "1000",
      "password": "secret123"
    },
    "tls_enabled": false,
    "ca_cert_path": "/etc/ssl/certs/ca-certificates.crt",
    "client_cert_path": "",
    "client_key_path": ""
  },
  "calling": {
    "max_calls": 5,
    "call_waiting_enabled": true,
    "codecs": [
      "opus",
      "g722",
      "pcma"
    ],
    "audio_buffer_ms": 20,
    "dtmf_mode": "rfc2833"
  },
  "pstn_gateways": [
    {
      "name": "primary_trunk",
      "host": "sip.provider.com",
      "port": 5060,
      "trunk_id": "trunk-001",
      "enabled": true
    }
  ],
  "devices": [
    {
      "id": "alsa:hw:0",
      "type": "alsa",
      "config": {
        "device": "hw:0",
        "channels": "1",
        "sample_rate": "48000"
      }
    },
    {
      "id": "bt_headset",
      "type": "bt",
      "config": {
        "profile": "hfp-hf",
        "auto_connect": "true"
      }
    }
  ],
  "socket_activation": true
}
