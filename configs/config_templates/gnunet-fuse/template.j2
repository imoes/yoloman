# GNUnet FUSE mount configuration
# Absolute path to the directory where the GNUnet-shared filesystem will be mounted.
# Must be an existing directory, writable by the mounting user.
# mountpoint = /mnt/gnunet
{{ mountpoint | default('/mnt/gnunet') }}

# GNUnet file-sharing URI (CHK or LOC) of the directory to mount.
# This is the primary input defining what content is shared/mounted.
# source_uri = <uri>
{% if source_uri | default('') %}
{{ source_uri | default('') }}
{% endif %}

# Optional path to a GNUnet configuration file.
# If empty, the default GNUnet config is used.
# config_file = <path>
{% if config_file | default('') %}
{{ config_file | default('') }}
{% endif %}

# Verbosity of logging: ERROR, WARNING, INFO, or DEBUG.
# loglevel = INFO
# {{ loglevel | default('INFO') }}

# If true, disable FUSE concurrency for debugging (sequential request handling).
# single_threaded = false
# {{ single_threaded | default(false) | string }}