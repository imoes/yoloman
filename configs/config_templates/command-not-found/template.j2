#
# This script will look-up command in the database and suggest
# installation of packages available from the repository
#
# Configuration:
# command_not_found_script_path: Path to the command-not-found executable script
#   (Default: /usr/lib/command-not-found)

if [[ -x {{ command_not_found_script_path | default('/usr/lib/command-not-found') }} ]] ; then
	if (( ! ${+functions[command_not_found_handler]} )) ; then
		function command_not_found_handler {
			[[ -x {{ command_not_found_script_path | default('/usr/lib/command-not-found') }} ]] || return 1
			{{ command_not_found_script_path | default('/usr/lib/command-not-found') }} -- ${1+"$1"} && :
		}
	fi
fi
