# fence_kdump: configuration for fence_kdump fencing agent
# Path to the kdump crash dump directory
path: {{ kdump_path }}
# Timeout (in seconds) for kdump operations
timeout: {{ timeout }}
# Number of retry attempts before failing
retry: {{ retry }}
# Hostname or IP of the target node to fence
target: {{ target }}
# Optional: extra options passed to kdump (e.g., --verbose, --force)
{% if extra_options %}# Extra options for fence_kdump
extra_options: {% for opt in extra_options %}{{ opt }}{% if not loop.last %} {% endif %}{% endfor %}
{% endif %}