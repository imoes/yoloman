# Cedar Backup 3 main configuration file — backup.conf
# This file defines backup sources, destinations, and behavior.
# Each backup set defines a source directory and its associated backup options.
# All paths are absolute unless noted; relative paths are resolved from config dir.

# System-wide settings
system:
  # Directory where cedar_backup3 stores logs
  log_dir: {{ system.log_dir | default('/var/log/cedar-backup3') }}
  # Directory where cedar_backup3 stores state and metadata
  state_dir: {{ system.state_dir | default('/var/lib/cedar-backup3') }}
  # Enable verbose logging (true/false)
  debug: {{ system.debug | default(false) }}

# Backup sets — each set defines what to backup, where to send it, and how often
{% for set in backup_sets %}
backup_set:
  name: {{ set.name | quote }}
  # Source directories to include in this backup set
  sources:
{% for src in set.sources %}
    - {{ src | quote }}
{% endfor %}
  # Destination configuration: either cdvd or s3
  destination:
    type: {{ set.destination.type | quote }}
{% if set.destination.type == 'cdvd' %}
    # Device node for CD/DVD writer (e.g., /dev/sr0)
    device: {{ set.destination.device | quote }}
    # File system type for the media (UDF/ISO9660)
    fs_type: {{ set.destination.fs_type | quote }}
    # Label to apply to the medium (max 32 chars for ISO9660, 128 for UDF)
    label: {{ set.destination.label | quote }}
    # Burn speed (e.g., '4x', '8x' or 'auto')
    speed: {{ set.destination.speed | quote }}
{% elif set.destination.type == 's3' %}
    # AWS S3 bucket name
    bucket: {{ set.destination.bucket | quote }}
    # S3 storage class (STANDARD, REDUCED_REDUNDANCY, etc.)
    storage_class: {{ set.destination.storage_class | quote }}
    # AWS region (e.g., us-east-1, eu-west-1)
    region: {{ set.destination.region | quote }}
{% endif %}
  # Schedule for this backup set (cron-style: minute hour day month weekday)
  schedule:
    # When to run — cron expression
    when: {{ set.schedule.when | quote }}
    # Maximum duration (in minutes) before backup is considered failed
    timeout_minutes: {{ set.schedule.timeout_minutes | default(360) }}
  # Compression options
  compression:
    enabled: {{ set.compression.enabled | default(true) }}
    # Algorithm: gzip, bzip2, or none
    algorithm: {{ set.compression.algorithm | default('gzip') }}
{% endfor %}

# Global behavior overrides (optional)
global_options:
  # Pre-backup command (e.g., sync filesystems)
  pre_backup_cmd: {{ global_options.pre_backup_cmd | default('sync') | quote }}
  # Post-backup command (e.g., eject CD)
  post_backup_cmd: {{ global_options.post_backup_cmd | default('') | quote }}
  # If true, skip media verification (faster, but less safe)
  skip_media_verify: {{ global_options.skip_media_verify | default(false) }}
  # If true, fail the backup if any source is missing
  strict_sources: {{ global_options.strict_sources | default(false) }}
