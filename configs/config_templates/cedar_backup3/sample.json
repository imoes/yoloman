{
 "backup_sets": [
  {
   "compression": {
    "algorithm": "gzip",
    "enabled": true
   },
   "destination": {
    "device": "/dev/sr0",
    "fs_type": "UDF",
    "label": "cedar-backup-etc-home-2023-10-01",
    "speed": "4x",
    "type": "cdvd"
   },
   "name": "etc-home",
   "schedule": {
    "timeout_minutes": 240,
    "when": "0 1 * * 0"
   },
   "sources": [
    "/etc",
    "/home",
    "/root"
   ]
  },
  {
   "compression": {
    "algorithm": "bzip2",
    "enabled": true
   },
   "destination": {
    "bucket": "mycompany-db-backups",
    "region": "eu-west-1",
    "storage_class": "STANDARD_IA",
    "type": "s3"
   },
   "name": "db-backups",
   "schedule": {
    "timeout_minutes": 120,
    "when": "30 3 * * *"
   },
   "sources": [
    "/var/backups/postgresql",
    "/var/backups/mysql"
   ]
  }
 ],
 "global_options": {
  "post_backup_cmd": "eject /dev/sr0",
  "pre_backup_cmd": "sync",
  "skip_media_verify": false,
  "strict_sources": true
 },
 "system": {
  "debug": false,
  "log_dir": "/var/log/cedar-backup3",
  "state_dir": "/var/lib/cedar-backup3"
 }
}
