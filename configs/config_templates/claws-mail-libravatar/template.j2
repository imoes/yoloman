{#
  Claws Mail libravatar Plugin Configuration
  ==========================================
  This file configures the libravatar plugin for Claws Mail. It controls
  how avatar images are retrieved from libravatar.org (a privacy-respecting
  avatar service) and how fallbacks (Gravatar, local defaults) are handled.

  Format: INI-style with a single section [libravatar].
  #}

[libravatar]

# -----------------------------------------------------------------------------
# enabled: Toggle the plugin on or off.
# Default: False (plugin is disabled unless explicitly enabled)
# -----------------------------------------------------------------------------
enabled={{ enabled|default(False)|lower }}

# -----------------------------------------------------------------------------
# default: Avatar fallback method when no matching avatar is found.
# Allowed values: '404', 'mm', 'identicon', 'monsterid', 'wavatar', 'retro', 'blank', 'url'
# Default: 'mm' (Mystery Person)
# -----------------------------------------------------------------------------
default={{ default|default('mm') }}

# -----------------------------------------------------------------------------
# custom_url: URL used as the fallback image when 'default' is set to 'url'.
# If empty, no custom URL is used.
# Default: '' (empty string)
# -----------------------------------------------------------------------------
custom_url={{ custom_url|default('') }}

# -----------------------------------------------------------------------------
# use_gravatar: Whether to fall back to Gravatar if libravatar.org returns no
#               result. Recommended: True.
# Default: True
# -----------------------------------------------------------------------------
use_gravatar={{ use_gravatar|default(True)|lower }}

# -----------------------------------------------------------------------------
# cache_enabled: Whether to cache retrieved avatar images on disk.
# Default: True
# -----------------------------------------------------------------------------
cache_enabled={{ cache_enabled|default(True)|lower }}

# -----------------------------------------------------------------------------
# cache_dir: Directory path where cached avatar images are stored.
# Default: '~/.claws-cache/libravatar'
# -----------------------------------------------------------------------------
cache_dir={{ cache_dir|default('~/.claws-cache/libravatar') }}

# -----------------------------------------------------------------------------
# cache_expiration: Time in seconds before a cached avatar expires and is
#                   re-fetched. Default: 604800 seconds (7 days).
# Default: 604800
# -----------------------------------------------------------------------------
cache_expiration={{ cache_expiration|default(604800) }}