# /etc/dpkg/dpkg.cfg — dpkg main configuration file
# Options here affect dpkg's behavior during install/upgrade/remove operations.
# See `man 5 dpkg.cfg` for full documentation.

# Force overwriting files from other packages (dangerous)
# {%- if force_overwrite %}
force-overwrite
# {%- endif %}

# Allow downgrading packages
# {%- if allow_downgrades %}
allow-downgrades
# {%- endif %}

# Don't configure packages immediately after install (defer to `dpkg --configure`)
# {%- if no_deconfigure %}
no-deconfigure
# {%- endif %}

# Skip running scripts (postinst, prerm, etc.)
# {%- if no_scripts %}
no-scripts
# {%- endif %}

# Use this path for dpkg's internal state (e.g., status file)
# {%- if dpkg_dir %}
depends-path {{ dpkg_dir }}
# {%- endif %}

# Lock file path
# {%- if lock_path %}
lock {{ lock_path }}
# {%- endif %}

# List of extra architectures to support (e.g., `foreign-architectures i386`)
# {%- if foreign_architectures %}
foreign-architectures {%- for arch in foreign_architectures %} {{ arch }}{%- endfor %}
# {%- endif %}

# Skip files matching these glob patterns during dependency checks
# {%- if skip_in_upgrade %}
# skip-in-upgrade is deprecated; use `--skip-in-upgrade` CLI flag instead
# {%- else %}
# (no skip-in-upgrade configured)
# {%- endif %}

# Log to this file instead of syslog
# {%- if log %}
log {{ log }}
# {%- endif %}

# Don’t attempt to unpack files that would overwrite existing files
# {%- if no_force %}
no-force
# {%- endif %}

# Use this architecture (overrides automatic detection)
# {%- if force_architecture %}
force-architecture
# {%- endif %}

# Use this OS (e.g., `linux-gnu`)
# {%- if force_os %}
force-os {{ force_os }}
# {%- endif %}

# Don’t fail if a required package is missing
# {%- if missing_configure %}
missing-config
# {%- endif %}

# Do not prompt for confirmation on certain operations
# {%- if force_confdef %}
force-confdef
# {%- endif %}

# Use the new config file without prompting
# {%- if force_confnew %}
force-confnew
# {%- endif %}

# Preserve existing config file (do not overwrite)
# {%- if force_confold %}
force-confold
# {%- endif %}

# Use these options for conffile conflict resolution (deprecated; prefer force-conf*)
# {%- if no_force_confmiss %}
no-force-confmiss
# {%- endif %}

# Allow dpkg to modify the package database even if unsafe
# {%- if force_conflicts %}
force-conflicts
# {%- endif %}

# Use this directory for dpkg's cache (e.g., for status files)
# {%- if admingroup %}
admingroup {{ admingroup }}
# {%- endif %}

# Use this UID for dpkg’s administrative operations (e.g., 0 for root)
# {%- if adminuid %}
adminuid {{ adminuid }}
# {%- endif %}

# Use this GID for dpkg’s administrative operations (e.g., 0 for root)
# {%- if admingid %}
admingid {{ admingid }}
# {%- endif %}
