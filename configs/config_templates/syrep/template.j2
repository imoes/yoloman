# Syrep repository synchronization tool configuration
# This file is a native configuration format for the syrep tool,
# providing a standardized way to define repository and operational defaults.

# The root directory of the syrep repository to manage.
repository_path: {{ repository_path | default('/srv/data/repository') }}

# General Options

# Enable more verbose operation (-v / --verbose).
verbose: {{ verbose | default(false) | lower }}

# Use temporary directory inside repository (-T / --local-temp).
local_temp: {{ local_temp | default(false) | lower }}

# Disable warning about non-matching origin snapshots (--ignore-origin).
ignore_origin: {{ ignore_origin | default(false) | lower }}

# Compress output snapshots or patches (-z / --compress).
compress: {{ compress | default(false) | lower }}

# Show a rotating dash while executing operations (-p / --progress).
progress: {{ progress | default(false) | lower }}

# Snapshot Configuration

# The snapshot file to use instead of the default one in the repository (--snapshot=STRING).
snapshot_name: {{ snapshot_name | default('current.syrep') }}

# The message digest cache file to use (--cache=STRING).
cache_file: {{ cache_file | default('md-cache') }}

# Don't use a message digest cache (--no-cache).
no_cache: {{ no_cache | default(false) | lower }}

# Don't purge obsolete entries from cache after update run (--no-purge).
no_purge: {{ no_purge | default(false) | lower }}

# Use cache in a read only fashion (--ro-cache).
ro_cache: {{ ro_cache | default(false) | lower }}

# Store information about the device where the file resides (--check-dev).
check_dev: {{ check_dev | default(false) | lower }}

# Merge Options

# Ask a question before each action during merge (-q / --question).
question: {{ question | default(false) | lower }}

# Prune empty directories during merge (-P / --prune-empty).
prune_empty: {{ prune_empty | default(false) | lower }}

# Don't empty trash after merge (--keep-trash).
keep_trash: {{ keep_trash | default(false) | lower }}

# Check message digests of files before deleting or replacing them (--check-md).
check_md: {{ check_md | default(false) | lower }}

# Always copy files instead of hard linking (--always-copy).
always_copy: {{ always_copy | default(false) | lower }}

# Patch Options

# Write patch output to specified file instead of STDOUT (--output-file=STRING).
output_file: {{ output_file | default('') }}

# Include files in patch which do exist on the other side under a different name (--include-all).
include_all: {{ include_all | default(false) | lower }}

# Cleanup Options

# Cleanup level: 1=temp/trash, 2=cache, 3=all (--cleanup-level=INT).
cleanup_level: {{ cleanup_level | default(1) }}

# Forget Options

# Information about how many days in the past should be kept (--remember=DAYS).
remember_days: {{ remember_days | default(180) }}