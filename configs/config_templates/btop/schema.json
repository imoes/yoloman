{
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Logging level: 'debug', 'info', 'warn', 'error'. See GitHub docs.",
    "enum": [
      "debug",
      "info",
      "warn",
      "error"
    ]
  },
  "log_file": {
    "type": "string",
    "default": "",
    "description": "Path to log file. Empty string disables logging."
  },
  "auto_scale": {
    "type": "bool",
    "default": true,
    "description": "Automatically scale graph values."
  },
  "update_ms": {
    "type": "number",
    "default": 1000,
    "description": "UI refresh interval in milliseconds."
  },
  "theme": {
    "type": "string",
    "default": "Default",
    "description": "Theme name; must match a file in the themes directory."
  },
  "show_battery": {
    "type": "bool",
    "default": true,
    "description": "Show battery meter."
  },
  "show_clock": {
    "type": "bool",
    "default": true,
    "description": "Show clock in status bar."
  },
  "show_uptime": {
    "type": "bool",
    "default": true,
    "description": "Show system uptime in status bar."
  },
  "show_cpu_temp": {
    "type": "bool",
    "default": true,
    "description": "Show CPU temperature."
  },
  "show_mem_val": {
    "type": "bool",
    "default": true,
    "description": "Show memory usage values (not just graph)."
  },
  "show_swap_val": {
    "type": "bool",
    "default": true,
    "description": "Show swap usage values."
  },
  "show_disk_io": {
    "type": "bool",
    "default": true,
    "description": "Show disk I/O counters."
  },
  "show_net_io": {
    "type": "bool",
    "default": true,
    "description": "Show network I/O counters."
  },
  "show_gpu": {
    "type": "bool",
    "default": true,
    "description": "Show GPU monitoring panels."
  },
  "gpu_devices": {
    "type": "list",
    "default": [],
    "description": "GPU devices to monitor. Empty means auto-detect all."
  },
  "net_interfaces": {
    "type": "list",
    "default": [],
    "description": "Network interfaces to display. Empty means auto-detect."
  },
  "net_unit": {
    "type": "string",
    "default": "M",
    "description": "Network display unit: 'b' (bytes), 'K' (KB), 'M' (MB), 'G' (GB).",
    "enum": [
      "b",
      "K",
      "M",
      "G"
    ]
  },
  "net_auto_unit": {
    "type": "bool",
    "default": true,
    "description": "Automatically scale network units."
  },
  "proc_auto_update": {
    "type": "bool",
    "default": true,
    "description": "Automatically update process list."
  },
  "proc_tree": {
    "type": "bool",
    "default": false,
    "description": "Show processes in tree view."
  },
  "proc_colors": {
    "type": "bool",
    "default": true,
    "description": "Use colors in process list."
  },
  "proc_gradient": {
    "type": "bool",
    "default": false,
    "description": "Apply gradient to process list."
  },
  "proc_mem_percent": {
    "type": "bool",
    "default": false,
    "description": "Show memory as percentage (instead of absolute)."
  },
  "proc_cmdline": {
    "type": "bool",
    "default": false,
    "description": "Show full command line instead of just command name."
  },
  "proc_sort": {
    "type": "string",
    "default": "cpu",
    "description": "Process sort key: 'cpu', 'mem', 'pid', 'name', 'time', 'prio', 'threads'.",
    "enum": [
      "cpu",
      "mem",
      "pid",
      "name",
      "time",
      "prio",
      "threads"
    ]
  },
  "proc_sort_reverse": {
    "type": "bool",
    "default": false,
    "description": "Reverse process sort order."
  },
  "proc_filter": {
    "type": "string",
    "default": "",
    "description": "Initial process filter string (regex)."
  },
  "proc_follow_pid": {
    "type": "number",
    "default": 0,
    "description": "Process PID to follow; 0 disables follow mode."
  },
  "proc_pause": {
    "type": "bool",
    "default": false,
    "description": "Pause process list updates."
  },
  "proc_show_threads": {
    "type": "bool",
    "default": false,
    "description": "Show threads in process list."
  },
  "proc_show_users": {
    "type": "bool",
    "default": false,
    "description": "Show user names in process list."
  },
  "proc_show_full_cmd": {
    "type": "bool",
    "default": false,
    "description": "Show full command line in process list."
  },
  "proc_sort_string": {
    "type": "string",
    "default": "cpu",
    "description": "Process sort key (deprecated alias for proc_sort).",
    "enum": [
      "cpu",
      "name",
      "time"
    ]
  },
  "proc_sort_string_reverse": {
    "type": "bool",
    "default": false,
    "description": "Reverse process sort order (deprecated alias for proc_sort_reverse)."
  },
  "cpu_graph_type": {
    "type": "string",
    "default": "braille",
    "description": "CPU graph rendering style: 'braille', 'block', 'ascii'.",
    "enum": [
      "braille",
      "block",
      "ascii"
    ]
  },
  "mem_graph_type": {
    "type": "string",
    "default": "braille",
    "description": "Memory graph rendering style."
  },
  "net_graph_type": {
    "type": "string",
    "default": "braille",
    "description": "Network graph rendering style."
  },
  "disk_graph_type": {
    "type": "string",
    "default": "braille",
    "description": "Disk I/O graph rendering style."
  },
  "gpu_graph_type": {
    "type": "string",
    "default": "braille",
    "description": "GPU graph rendering style."
  },
  "battery_graph_type": {
    "type": "string",
    "default": "braille",
    "description": "Battery graph rendering style."
  },
  "cpu_graph_detail": {
    "type": "string",
    "default": "high",
    "description": "CPU graph detail level: 'low', 'medium', 'high'.",
    "enum": [
      "low",
      "medium",
      "high"
    ]
  },
  "mem_graph_detail": {
    "type": "string",
    "default": "high",
    "description": "Memory graph detail level."
  },
  "net_graph_detail": {
    "type": "string",
    "default": "high",
    "description": "Network graph detail level."
  },
  "disk_graph_detail": {
    "type": "string",
    "default": "high",
    "description": "Disk graph detail level."
  },
  "gpu_graph_detail": {
    "type": "string",
    "default": "high",
    "description": "GPU graph detail level."
  },
  "battery_graph_detail": {
    "type": "string",
    "default": "high",
    "description": "Battery graph detail level."
  },
  "graph_symbol": {
    "type": "string",
    "default": "braille",
    "description": "Default graph symbol style: 'braille', 'block', 'ascii'.",
    "enum": [
      "braille",
      "block",
      "ascii"
    ]
  },
  "low_color": {
    "type": "bool",
    "default": false,
    "description": "Disable truecolor (256-color mode)."
  },
  "tty_mode": {
    "type": "bool",
    "default": false,
    "description": "Force tty mode (16 colors, tty-friendly symbols)."
  },
  "utf_force": {
    "type": "bool",
    "default": false,
    "description": "Force start even if no UTF-8 locale is detected."
  },
  "force_tty": {
    "type": "bool",
    "default": false,
    "description": "Alias for tty_mode (deprecated)."
  },
  "cpu_left": {
    "type": "bool",
    "default": false,
    "description": "Place CPU panel on left."
  },
  "mem_left": {
    "type": "bool",
    "default": false,
    "description": "Place memory panel on left."
  },
  "net_left": {
    "type": "bool",
    "default": false,
    "description": "Place network panel on left."
  },
  "disk_left": {
    "type": "bool",
    "default": false,
    "description": "Place disk panel on left."
  },
  "gpu_left": {
    "type": "bool",
    "default": false,
    "description": "Place GPU panel on left."
  },
  "battery_left": {
    "type": "bool",
    "default": false,
    "description": "Place battery panel on left."
  },
  "cpu_on_top": {
    "type": "bool",
    "default": false,
    "description": "Place CPU panel on top (for horizontal layout)."
  },
  "mem_on_top": {
    "type": "bool",
    "default": false,
    "description": "Place memory panel on top."
  },
  "net_on_top": {
    "type": "bool",
    "default": false,
    "description": "Place network panel on top."
  },
  "disk_on_top": {
    "type": "bool",
    "default": false,
    "description": "Place disk panel on top."
  },
  "gpu_on_top": {
    "type": "bool",
    "default": false,
    "description": "Place GPU panel on top."
  },
  "battery_on_top": {
    "type": "bool",
    "default": false,
    "description": "Place battery panel on top."
  },
  "proc_on_top": {
    "type": "bool",
    "default": false,
    "description": "Place process panel on top."
  },
  "show_proc_info": {
    "type": "bool",
    "default": true,
    "description": "Show detailed process info panel."
  },
  "proc_info_left": {
    "type": "bool",
    "default": false,
    "description": "Place process info panel on left."
  },
  "proc_info_on_top": {
    "type": "bool",
    "default": false,
    "description": "Place process info panel on top."
  },
  "preset": {
    "type": "number",
    "default": 0,
    "description": "Preset ID (0\u20139) to load at startup."
  }
}
