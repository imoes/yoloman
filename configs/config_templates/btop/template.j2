{# btop configuration file #}
{# Generated from btop(1) and GitHub docs #}
{# Format: key = value, comments start with # #}

{# General settings #}

# Logging level: 'debug', 'info', 'warn', 'error'. See GitHub docs.
log_level = "{{ log_level | default('info') }}"

# Path to log file. Empty string disables logging.
log_file = "{{ log_file | default('') }}"

# Automatically scale graph values.
auto_scale = {{ auto_scale | default(true) | lower }}

# UI refresh interval in milliseconds.
update_ms = {{ update_ms | default(1000) }}

{# UI settings #}

# Theme name; must match a file in the themes directory.
theme = "{{ theme | default('Default') }}"

# Show battery meter.
show_battery = {{ show_battery | default(true) | lower }}

# Show clock in status bar.
show_clock = {{ show_clock | default(true) | lower }}

# Show system uptime in status bar.
show_uptime = {{ show_uptime | default(true) | lower }}

# Show CPU temperature.
show_cpu_temp = {{ show_cpu_temp | default(true) | lower }}

# Show memory usage values (not just graph).
show_mem_val = {{ show_mem_val | default(true) | lower }}

# Show swap usage values.
show_swap_val = {{ show_swap_val | default(true) | lower }}

# Show disk I/O counters.
show_disk_io = {{ show_disk_io | default(true) | lower }}

# Show network I/O counters.
show_net_io = {{ show_net_io | default(true) | lower }}

# Show GPU monitoring panels.
show_gpu = {{ show_gpu | default(true) | lower }}

# GPU devices to monitor. Empty means auto-detect all.
{% set _gpu_devices = gpu_devices | default([]) %}
gpu_devices = {{ _gpu_devices | tojson }}

# Network interfaces to display. Empty means auto-detect.
{% set _net_interfaces = net_interfaces | default([]) %}
net_interfaces = {{ _net_interfaces | tojson }}

# Network display unit: 'b' (bytes), 'K' (KB), 'M' (MB), 'G' (GB).
net_unit = "{{ net_unit | default('M') }}"

# Automatically scale network units.
net_auto_unit = {{ net_auto_unit | default(true) | lower }}

# Automatically update process list.
proc_auto_update = {{ proc_auto_update | default(true) | lower }}

# Show processes in tree view.
proc_tree = {{ proc_tree | default(false) | lower }}

# Use colors in process list.
proc_colors = {{ proc_colors | default(true) | lower }}

# Apply gradient to process list.
proc_gradient = {{ proc_gradient | default(false) | lower }}

# Show memory as percentage (instead of absolute).
proc_mem_percent = {{ proc_mem_percent | default(false) | lower }}

# Show full command line instead of just command name.
proc_cmdline = {{ proc_cmdline | default(false) | lower }}

{# Colors section (placeholders for future enrichment if schema expands) #}

{# Process list settings #}

# Process sort key: 'cpu', 'mem', 'pid', 'name', 'time', 'prio', 'threads'.
proc_sort = "{{ proc_sort | default('cpu') }}"

# Reverse process sort order.
proc_sort_reverse = {{ proc_sort_reverse | default(false) | lower }}

# Initial process filter string (regex).
proc_filter = "{{ proc_filter | default('') }}"

# Process PID to follow; 0 disables follow mode.
proc_follow_pid = {{ proc_follow_pid | default(0) }}

# Pause process list updates.
proc_pause = {{ proc_pause | default(false) | lower }}

# Show threads in process list.
proc_show_threads = {{ proc_show_threads | default(false) | lower }}

# Show user names in process list.
proc_show_users = {{ proc_show_users | default(false) | lower }}

# Show full command line in process list.
proc_show_full_cmd = {{ proc_show_full_cmd | default(false) | lower }}

# Process sort key (deprecated alias for proc_sort).
proc_sort_string = "{{ proc_sort_string | default('cpu') }}"

# Reverse process sort order (deprecated alias for proc_sort_reverse).
proc_sort_string_reverse = {{ proc_sort_string_reverse | default(false) | lower }}

{# Graph settings #}

# CPU graph rendering style: 'braille', 'block', 'ascii'.
cpu_graph_type = "{{ cpu_graph_type | default('braille') }}"

# Memory graph rendering style.
mem_graph_type = "{{ mem_graph_type | default('braille') }}"

# Network graph rendering style.
net_graph_type = "{{ net_graph_type | default('braille') }}"

# Disk I/O graph rendering style.
disk_graph_type = "{{ disk_graph_type | default('braille') }}"

# GPU graph rendering style.
gpu_graph_type = "{{ gpu_graph_type | default('braille') }}"

# Battery graph rendering style.
battery_graph_type = "{{ battery_graph_type | default('braille') }}"

# CPU graph detail level: 'low', 'medium', 'high'.
cpu_graph_detail = "{{ cpu_graph_detail | default('high') }}"

# Memory graph detail level.
mem_graph_detail = "{{ mem_graph_detail | default('high') }}"

# Network graph detail level.
net_graph_detail = "{{ net_graph_detail | default('high') }}"

# Disk graph detail level.
disk_graph_detail = "{{ disk_graph_detail | default('high') }}"

# GPU graph detail level.
gpu_graph_detail = "{{ gpu_graph_detail | default('high') }}"

# Battery graph detail level.
battery_graph_detail = "{{ battery_graph_detail | default('high') }}"

# Default graph symbol style: 'braille', 'block', 'ascii'.
graph_symbol = "{{ graph_symbol | default('braille') }}"

{# Terminal settings #}

# Disable truecolor (256-color mode).
low_color = {{ low_color | default(false) | lower }}

# Force tty mode (16 colors, tty-friendly symbols).
tty_mode = {{ tty_mode | default(false) | lower }}

# Force start even if no UTF-8 locale is detected.
utf_force = {{ utf_force | default(false) | lower }}

# Alias for tty_mode (deprecated).
force_tty = {{ force_tty | default(false) | lower }}

{# Layout settings #}

# Place CPU panel on left.
cpu_left = {{ cpu_left | default(false) | lower }}

# Place memory panel on left.
mem_left = {{ mem_left | default(false) | lower }}

# Place network panel on left.
net_left = {{ net_left | default(false) | lower }}

# Place disk panel on left.
disk_left = {{ disk_left | default(false) | lower }}

# Place GPU panel on left.
gpu_left = {{ gpu_left | default(false) | lower }}

# Place battery panel on left.
battery_left = {{ battery_left | default(false) | lower }}

# Place CPU panel on top (for horizontal layout).
cpu_on_top = {{ cpu_on_top | default(false) | lower }}

# Place memory panel on top.
mem_on_top = {{ mem_on_top | default(false) | lower }}

# Place network panel on top.
net_on_top = {{ net_on_top | default(false) | lower }}

# Place disk panel on top.
disk_on_top = {{ disk_on_top | default(false) | lower }}

# Place GPU panel on top.
gpu_on_top = {{ gpu_on_top | default(false) | lower }}

# Place battery panel on top.
battery_on_top = {{ battery_on_top | default(false) | lower }}

# Place process panel on top.
proc_on_top = {{ proc_on_top | default(false) | lower }}

# Show detailed process info panel.
show_proc_info = {{ show_proc_info | default(true) | lower }}

# Place process info panel on left.
proc_info_left = {{ proc_info_left | default(false) | lower }}

# Place process info panel on top.
proc_info_on_top = {{ proc_info_on_top | default(false) | lower }}

{# Presets #}

# Preset ID (0–9) to load at startup.
preset = {{ preset | default(0) }}