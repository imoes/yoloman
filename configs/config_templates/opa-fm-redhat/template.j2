    <!-- When the routing algorithm is set to "dgshortestpath" the following -->
    <!-- section is used to configure the algorithm.                         -->
    <!-- Overall, "dgshortestpath" routing is a form of "Min Hop" or         -->
    <!-- "Shortestpath" rout
