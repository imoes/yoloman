# ==============================================================================
# Stopwatch Application Configuration
# ==============================================================================
# This configuration file controls the display, timing, and user interface behavior
# of the stopwatch application.
# ==============================================================================

# --- Display Precision ---

# Number of decimal places for displaying milliseconds accuracy.
# Valid values are integers >= 0.
# Example: 3 displays "12.345"
decimals: {{ decimals | default(3) }}

# --- Display Formatting ---

# The time format string to use for display.
# This string defines how the elapsed or remaining time is presented.
# Common patterns include seconds (s), minutes (m), and hours (h).
format: "{{ format | default('00:00.000') }}"

# --- Visual Theme ---

# Enable night mode (dark background theme for low-light environments).
# When true, the UI switches to darker colors to reduce eye strain.
night_mode: {{ night_mode | default(false) | lower }}

# Color theme for the stopwatch text display.
# Defines the primary text color of the timer.
color: "{{ color | default('blue') }}"

# --- Typography ---

# Base size of the timer font.
# Acceptable standard values are "small", "medium", "large".
# If set to "custom", the font_family and potentially other CSS properties apply.
font_size: "{{ font_size | default('medium') }}"

# Font family to use when a custom font size is selected.
# Specifies the CSS font-family stack for the timer display.
font_family: "{{ font_family | default('monospace') }}"

# --- Timing Behavior ---

# Automatically stop the timer when the count reaches zero.
# If true, the timer halts immediately upon hitting 00:00.000.
# If false, it may continue counting into negative territory or loop.
auto_stop_at_zero: {{ auto_stop_at_zero | default(true) | lower }}

# Maximum number of lap records to keep before overwriting the oldest.
# Ensures the lap history does not grow indefinitely in memory.
max_laps: {{ max_laps | default(100) }}

# --- Localization ---

# ISO language code for the interface translation.
# Determines which translation files are loaded for buttons and labels.
language: "{{ language | default('en') }}"

# --- Presets ---

# List of preset durations in seconds for quick timer setup.
# These values appear as clickable options for common intervals.
# Example: [60, 300, 600, 3600] corresponds to 1m, 5m, 10m, 1h.
preset_timers: {{ preset_timers | default([60, 300, 600, 3600]) | join(', ') }}