# ==============================================================================
# Quassel Core AppArmor Profile
# ==============================================================================
# This template generates the AppArmor profile for quassel-core.
# It restricts file system access to necessary directories and libraries.
#
# Variables used:
#   - rotate_count: Number of rotated log files to keep (integer, default 4).
#                   Note: This variable is currently unused in the AppArmor profile
#                   itself, as AppArmor does not handle log rotation logic directly.
#                   It is kept for schema consistency or potential future hooks.
# ==============================================================================

/usr/bin/quasselcore {
  # Base abstractions required for standard system operations
  #include <tunables/global>

  # Base abstraction providing standard system library paths
  #include <abstractions/base>

  # Abstraction for DNS resolution and NSS (Name Service Switch)
  #include <abstractions/nameservice>

  # Access to temporary directories for the user
  #include <abstractions/user-tmp>

  # Access to SSL certificates for secure connections (IRC over SSL, etc.)
  #include <abstractions/ssl_certs>

  # --- Quassel Data Directories ---

  # Read-write access to the main Quassel data directory (storage, settings)
  /var/lib/quassel/ rw,
  /var/lib/quassel/** rwkl,

  # Read-write access to the Quassel log directory
  # Logs are written here. Rotation is handled externally (e.g., logrotate),
  # using the `rotate_count` variable ({{ rotate_count | default(4) }}) to determine
  # how many old logs to keep.
  /var/log/quassel/* rw,

  # --- Configuration & System Files ---

  # Read access to Trolltech configuration (Qt settings)
  /etc/xdg/Trolltech.conf r,
  # Explicitly deny write/lock access to prevent corruption or unauthorized changes
  deny /etc/xdg/Trolltech.conf k,

  # Read access to OpenSSL configuration
  /etc/ssl/openssl.cnf r,
  /usr/lib/ssl/openssl.cnf r,

  # --- System Identification ---

  # Read access to D-Bus machine ID (used for unique identification)
  # QSysInfo::machineUniqueId()
  /var/lib/dbus/machine-id r,
  /etc/machine-id r,

  # Read access to boot ID (used for unique identification across reboots)
  # QSysInfo::bootUniqueId()
  @{PROC}/sys/kernel/random/boot_id r,

  # --- Local Overrides ---

  # Site-specific additions and overrides.
  # See local/README for details on how to extend this profile.
  #include <local/usr.bin.quasselcore>
}
