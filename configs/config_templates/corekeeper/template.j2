# Corekeeper configuration
#
# Corekeeper is a utility for managing core dumps on Linux systems with a focus
# on privacy and multi-user security. It intercepts core dump generation to
# ensure that only the root user can view the contents of core files generated
# by other users, preventing information leakage between users.
#
# Requirements: Linux kernel 3.7-rc1 or newer.
# See: v3.6-6800-g12a2b4b in linux.git for implementation details.
#
# Note: If using a kernel older than 3.7-rc1, only root can access core dumps
# regardless of this configuration. In such cases, comment out the
# kernel.core_pattern line below, ensure /var/crash has mode 1777 (dpkg-statoverride),
# and uncomment the alternate core_pattern provided.
# When reverting to the default core pattern, set /var/crash mode to 0755 as it
# is unsafe to use the dumper with a world-writable directory.

# The directory where corekeeper stores its state files and core dumps.
# This path is substituted into the kernel.core_pattern to specify
# the output location for core dump files.
kernel.core_pattern = |/usr/lib/corekeeper/dump --dumpable %d --owner %u --limit %c --core {{ corekeeper_cache_dir | default('/var/cache/corekeeper') }}/%p-%u-%g-%s-%t-%h-%E

# Enable appending the process ID to the core file name.
# This helps in identifying which specific process generated the core dump.
kernel.core_uses_pid = 1

# Set SUID_DUMPABLE flag to 2 (suid_dumpable).
# This allows setuid/setgid programs to generate core dumps,
# which are then handled by the core_pattern script (corekeeper).
# Value 2 ensures that the core dump is saved but permissions are adjusted
# so that only the owner (or root) can read it.
fs.suid_dumpable = 2
