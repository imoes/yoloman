# Background color for the Editres Tree widget.
# Default: WINDOW_BACKGROUND
Editres*Tree.Background: {{ editres_tree_background | default('WINDOW_BACKGROUND') }}

# Foreground color for the Editres Tree widget.
# Default: WINDOW_FOREGROUND
Editres*Tree.Foreground: {{ editres_tree_foreground | default('WINDOW_FOREGROUND') }}

# Foreground color for the Editres Tree Toggle widget.
# Default: FOREGROUND
Editres*Tree.Toggle.Foreground: {{ editres_tree_toggle_foreground | default('FOREGROUND') }}

# Background color for the Editres Tree Toggle widget.
# Default: BACKGROUND
Editres*Tree.Toggle.Background: {{ editres_tree_toggle_background | default('BACKGROUND') }}

# Background color for the Editres Panner widget.
# Default: BACKGROUND
Editres*Panner.Background: {{ editres_panner_background | default('BACKGROUND') }}