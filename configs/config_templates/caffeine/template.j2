# Caffeine Desktop Entry Configuration
# This template generates a standard .desktop file for the Caffeine application.
# Caffeine is a utility that temporarily disables the screensaver and sleep mode.

[Desktop Entry]
# Icon name or path used in the desktop entry
Icon={{ desktop_icon | default('caffeine') }}

# Display name of the application
Name={{ desktop_name | default('Caffeine') }}

# Default-language (en) description of the application
Comment={{ desktop_comment | default('Temporarily deactivate the screensaver and sleep mode') }}

# Russian translation of the comment
Comment[ru]={{ desktop_comment_ru | default('Временное отключение экранной заставки и режима сна') }}

# Polish translation of the comment
Comment[pl]={{ desktop_comment_pl | default('Czasowo wyłącza wygaszacz ekranu oraz tryb usypiania') }}

# Arabic translation of the comment
Comment[ar]={{ desktop_comment_ar | default('عطل مؤقتاً وضع شاشة التوقف والسكون') }}

# Czech translation of the comment
Comment[cs]={{ desktop_comment_cs | default('Dočasně deaktivovat šetřič obrazovky a režim spánku') }}

# Danish translation of the comment
Comment[da]={{ desktop_comment_da | default('Deaktivér midlertidigt pauseskærm og slumretilstand') }}

# German translation of the comment
Comment[de]={{ desktop_comment_de | default('Zeitweise Bildschirmschoner und Schlafmodus deaktivieren') }}

# Greek translation of the comment
Comment[el]={{ desktop_comment_el | default('Προσωρινή απενεργοποίηση προφύλαξης οθόνης και κατάστασης αναστολής') }}

# Spanish translation of the comment
Comment[es]={{ desktop_comment_es | default('Desactivar temporalmente el protector de pantalla y el modo de suspensión') }}

# Finnish translation of the comment
Comment[fi]={{ desktop_comment_fi | default('Poista väliaikaisesti näytönsäästäjä ja lepotila käytöstä') }}

# French translation of the comment
Comment[fr]={{ desktop_comment_fr | default("Désactiver temporairement l'écran de veiller et le mode économie d'énergie") }}

# Hungarian translation of the comment
Comment[hu]={{ desktop_comment_hu | default('Átmenetileg deaktiválja a képernyővédőt és az alvó üzemmódot') }}

# Italian translation of the comment
Comment[it]={{ desktop_comment_it | default('Disattiva temporaneamente il salvaschermo e la modalità di sospensione') }}

# Japanese translation of the comment
Comment[ja]={{ desktop_comment_ja | default('スクリーンセーバーとスリープモードを一時的に無効化する') }}

# Norwegian Bokmål translation of the comment
Comment[nb]={{ desktop_comment_nb | default('Deaktiver midlertidig skjermsparer og dvalemodus') }}

# Static entries for the desktop file
# These fields are typically hardcoded or not configurable via this specific schema.
Comment[nl]=Deactiveer tijdelijk de schermbeveiliging en slaapmodus
Comment[pt_BR]=Desative temporariamente a proteção de tela e a hibernação
Comment[ro]=Dezactivează temporar economizorul de ecran și modul adormire
Comment[zh_CN]=暂时取消激活屏保和睡眠模式
Comment[zh_TW]=暫時停用螢幕保護程式與睡眠模式
Exec=/usr/bin/caffeine
Terminal=false
Type=Application
Categories=Utility;
Keywords=Screensaver,Power,Saving,Blank
StartupNotify=false