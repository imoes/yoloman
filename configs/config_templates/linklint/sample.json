{
  "root_directory": "/var/www/html",
  "hostname": "www.example.com",
  "http_port": 8080,
  "use_http": true,
  "http_timeout": 30,
  "request_delay": 1,
  "doc_directory": "/var/log/linklint/report",
  "output_file": "/var/log/linklint/errors.txt",
  "file_limit": 1000,
  "ignore_patterns": [
    "/temp/",
    "*.bak"
  ],
  "skip_patterns": [
    "/old/"
  ],
  "case_sensitive": false,
  "check_orphans": true,
  "substitution_maps": [
    "/images=/assets/images"
  ],
  "http_headers": [
    "User-Agent: Linklint/2.3.5",
    "Accept: text/html"
  ],
  "accept_language": "en-US",
  "proxy_server": "",
  "auth_credentials": "",
  "debug_level": 0,
  "quiet_mode": true,
  "silent_mode": false,
  "check_remote_links": false,
  "use_status_cache": false,
  "cache_flush": false,
  "cache_directory": "",
  "ignore_anchors": false,
  "ignore_query_strings": false,
  "follow_redirects": true,
  "concise_remote_output": false,
  "output_index_name": "linklint",
  "doc_base_url": "http://www.example.com",
  "html_frames": false,
  "text_only": false,
  "html_only": false,
  "suppress_output_files": [
    "X$"
  ],
  "index_file": "index.html",
  "url_doc_prefix": "remote",
  "retry_failed_hosts": false,
  "use_checksum": false,
  "add_xrefs": true,
  "sort_by_referrer": true,
  "list_files": false,
  "list_warnings": true,
  "list_errors": true
}
