# nxproxy configuration template.
# nxproxy is an X11 proxy that tunnels X connections.
# It acts as an intermediary between an X client and an X server,
# providing compression, encryption, and other enhancements.

# IP address for the proxy to listen on.
--listen <listen_host|default('127.0.0.1')>

# Local port used for accepting the proxy connection.
--port <listen_port|default(2200)>

# Name or IP of host that the proxy will connect to.
--connect <connect_host|default('127.0.0.1')>

# Remote port used for the connection.
--port <connect_port|default(2200)>

# Operating mode: 'client' for X client side, 'server' for X server side.
--mode <mode|default('client')>

# Log level: 0 for FATAL, 1 for ERROR, 2 for WARNING, 3 for INFO, 4 for DEBUG.
--log-level <log_level|default(0)>

# Name of the log file. Empty or default implies stderr.
--log-file <log_file|default('')>

# Log format string (e.g., '0' for plain text, 'u' for time, 'l' for level).
--log-format <log_format|default('0')>

# Link speed indication (modem, isdn, adsl, wan, lan, local) or bandwidth spec.
--link <link|default('lan')>

# Type of session (e.g., windows, unix-kde, unix-application).
--type <type|default('unix-kde')>

# Bind to the loopback device only.
--loopback <loopback|default(True)>

# Name or IP of host that can connect to the proxy. Empty implies all.
--accept <accept|default('')>

# Number of connection attempts.
--retry <retry|default(3)>

# Set TCP_NODELAY on the proxy link.
--nodelay <nodelay|default(True)>

# Enable or disable use of the RENDER extension.
--render <render|default(True)>

# Enable X differential compression.
--delta <delta|default(True)>

# ZLIB data compression level (0-9). 0 disables.
--data <data|default(6)>

# ZLIB stream compression level (0-9). 0 disables.
--stream <stream|default(6)>

# Memory optimization trigger size. 0 disables.
--memory <memory|default(0)>

# Size of the in-memory X message cache. 0 disables.
--cache <cache|default(32)>

# Keep-alive timeout in seconds. 0 disables check.
--timeout <timeout|default(60)>

# Set to 1 if the proxy is part of a program providing encryption.
--encryption <encryption|default(False)>