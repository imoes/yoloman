{
  "server_port": 2811,
  "listen_address": "0.0.0.0",
  "data_port_range": {
    "start": 50000,
    "end": 51000
  },
  "max_connections": 100,
  "trusted_cas": [
    {
      "path": "/etc/grid-security/certificates"
    },
    {
      "path": "/etc/grid-security/certificates/eduperson"
    }
  ],
  "access_rules": [
    {
      "type": "allow",
      "match_type": "dn",
      "pattern": "/C=US/O=ExampleOrg/OU=Science/CN=John Doe"
    },
    {
      "type": "allow",
      "match_type": "fqan",
      "pattern": "/example.org/Role=production"
    },
    {
      "type": "deny",
      "match_type": "fqan",
      "pattern": "/example.org/Role=capability"
    }
  ],
  "proxy_storage_path": "/var/lib/globus/proxy",
  "transfer_timeout": 7200,
  "connection_idle_timeout": 1200,
  "max_transfer_rate": 104857600,
  "tls_enabled": true,
  "tls_cipher_list": [
    "AES256-GCM-SHA384",
    "AES128-GCM-SHA256"
  ],
  "tls_client_auth_required": true,
  "log_file": "/var/log/gridftp/server.log",
  "log_level": "notice",
  "dirlist_cache": true,
  "dirlist_cache_ttl": 120,
  "enable_server_side_copy": true,
  "enable_http_proxy": false,
  "http_proxy_host": "",
  "http_proxy_port": 0
}
