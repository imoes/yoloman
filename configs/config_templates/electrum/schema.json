{
  "network": {
    "type": "string",
    "default": "mainnet",
    "description": "Network mode: mainnet, testnet, regtest, or signet.",
    "enum": [
      "mainnet",
      "testnet",
      "regtest",
      "signet"
    ]
  },
  "server": {
    "type": "string",
    "default": "",
    "description": "Server connection string in host:port:protocol format (e.g., 'electrum.example.com:50002:s')."
  },
  "proxy": {
    "type": "string",
    "default": "",
    "description": "Proxy configuration in [type:]host[:port] format or empty string for none."
  },
  "rpc_host": {
    "type": "string",
    "default": "localhost",
    "description": "RPC daemon host."
  },
  "rpc_port": {
    "type": "number",
    "default": 7777,
    "description": "RPC daemon port."
  },
  "rpc_socket_type": {
    "type": "string",
    "default": "tcp",
    "description": "RPC socket type: tcp, unix, or auto.",
    "enum": [
      "tcp",
      "unix",
      "auto"
    ]
  },
  "rpc_socket_path": {
    "type": "string",
    "default": "/run/user/{{ uid }}/electrum/rpc.sock",
    "description": "RPC Unix socket path when rpc_socket_type=unix."
  },
  "rpc_user": {
    "type": "string",
    "default": "",
    "description": "RPC username."
  },
  "rpc_password": {
    "type": "string",
    "default": "",
    "description": "RPC password."
  },
  "data_dir": {
    "type": "string",
    "default": "",
    "description": "Override default electrum data directory."
  },
  "gui": {
    "type": "string",
    "default": "qt",
    "description": "GUI backend: qt, kivy, text, stdio, or qml.",
    "enum": [
      "qt",
      "kivy",
      "text",
      "stdio",
      "qml"
    ]
  },
  "language": {
    "type": "string",
    "default": "",
    "description": "UI language code (e.g., 'en', 'de')."
  },
  "seed_type": {
    "type": "string",
    "default": "segwit",
    "description": "Seed type for new wallets: standard, segwit, 2fa, or 2fa_segwit.",
    "enum": [
      "standard",
      "segwit",
      "2fa",
      "2fa_segwit"
    ]
  },
  "fee_method": {
    "type": "string",
    "default": "",
    "description": "Fee estimation method (e.g., 'eta', 'static')."
  },
  "fee_level": {
    "type": "number",
    "default": 0.5,
    "description": "Fee slider position between 0.0 and 1.0."
  },
  "one_server": {
    "type": "bool",
    "default": false,
    "description": "Use only one server (no fallback)."
  },
  "no_onion": {
    "type": "bool",
    "default": false,
    "description": "Disable connections to onion servers."
  },
  "skip_merkle_check": {
    "type": "bool",
    "default": false,
    "description": "Skip Merkle proof verification (for debugging)."
  },
  "offline": {
    "type": "bool",
    "default": false,
    "description": "Run in offline mode."
  },
  "portable": {
    "type": "bool",
    "default": false,
    "description": "Run in portable mode (uses ./electrum_data)."
  },
  "encrypt_file": {
    "type": "bool",
    "default": false,
    "description": "Encrypt wallet file on disk (applies to wallet creation)."
  },
  "server_fingerprint": {
    "type": "string",
    "default": "",
    "description": "Required SHA256 fingerprint (64 hex chars) for server certificate."
  },
  "verbosity": {
    "type": "number",
    "default": 1,
    "description": "Log verbosity: 0=quiet, 1=info, 2=debug, 3=trace."
  }
}
