# Zephyr Server Operations Configuration
#
# This file configures how the Zephyr server handles specific types of message
# routing based on zones. The format is:
#   operation,category,directive_value
#
# The 'operations' line defines the default zone for general message operations.
operations, message, {{ (personal_zone | default('%me%')) | trim }}

# The 'message' line with 'personal' category specifies the zone used for
# personal messages. This is typically set to the user's own zone.
message, personal, {{ (personal_zone | default('%me%')) | trim }}

# The 'message' line with 'urgent' category specifies the zone used for
# urgent messages. This is typically set to the user's own zone.
message, urgent, {{ (urgent_zone | default('%me%')) | trim }}
