# netproc configuration file
# Self-documenting template for the netproc network traffic monitor.
# Each directive below corresponds to a command-line flag; see the
# man page or `netproc --help` for full usage details.

# -----------------------------------------------------------------------------
# Protocol to monitor: tcp, udp, or both.
# Defaults to 'both' if not specified.
# Corresponds to the -p / --protocol flag.
# -----------------------------------------------------------------------------
protocol={{ protocol | default('both') }}

# -----------------------------------------------------------------------------
# Network interface to monitor.
# Use 'all' to monitor every non-loopback interface.
# Corresponds to the -i / --interface flag.
# -----------------------------------------------------------------------------
interface={{ interface | default('all') }}

# -----------------------------------------------------------------------------
# View traffic in bytes instead of the default bits.
# Corresponds to the -B / --bytes flag.
# -----------------------------------------------------------------------------
use_bytes={{ use_bytes | default(false) }}

# -----------------------------------------------------------------------------
# Use SI format (powers of 1000) instead of the default IEC format (powers of 1024).
# Corresponds to the --si flag.
# -----------------------------------------------------------------------------
use_si_format={{ use_si_format | default(false) }}

# -----------------------------------------------------------------------------
# Color scheme level: 1 (default), 2, or 3.
# Higher values enable more detailed color coding.
# Corresponds to the --color flag.
# -----------------------------------------------------------------------------
color_scheme={{ color_scheme | default(1) }}

# -----------------------------------------------------------------------------
# Show numeric host and service names without DNS/port translation.
# Improves performance by skipping reverse lookups.
# Corresponds to the -n / --numeric flag.
# -----------------------------------------------------------------------------
numeric_mode={{ numeric_mode | default(false) }}

# -----------------------------------------------------------------------------
# Enable verbose mode: show processes even if they have no traffic.
# Corresponds to the -v / --verbose flag.
# -----------------------------------------------------------------------------
verbose_mode={{ verbose_mode | default(false) }}

# -----------------------------------------------------------------------------
# Path to the file where statistics summary will be saved.
# The directory must exist and be writable by the netproc user.
# Corresponds to the -f / --file flag.
# -----------------------------------------------------------------------------
log_file={{ log_file | default('/var/log/netproc/netproc.log') }}