{
  "log_level": "warning",
  "listen_addresses": [
    "unix:path=/run/dbus/system_bus_socket",
    "unix:abstract=/dbus/system_bus_socket"
  ],
  "auth_mechanisms": [
    "EXTERNAL",
    "DBUS_COOKIE_SHA1"
  ],
  "service_activation": {
    "name": "org.freedesktop.systemd1",
    "exec": "/usr/lib/systemd/systemd"
  },
  "user_rules": [
    {
      "user": "root",
      "max_replies_per_connection": 1024,
      "max_connections_per_user": 256,
      "max_services_per_user": 128
    },
    {
      "user": "messagebus",
      "max_replies_per_connection": 512,
      "max_connections_per_user": 128,
      "max_services_per_user": 64
    }
  ],
  "introspection_enabled": false,
  "audit_level": 1,
  "inactivity_timeout": 600,
  "max_outstanding_messages": 100000,
  "max_message_size": 104857600,
  "max_fds_per_connection": 256,
  "max_fds": 65536,
  "listen_backlog": 1024
}
