{
  "http_listen": "127.0.0.1:9090",
  "app_debug": false,
  "app_country": "DE",
  "app_tokentype": "static",
  "tokens_server1": "pubkey1.pem",
  "tokens_server2": "pubkey2.pem",
  "etcd_keyformat": "/signaling/proxy/tokens/%s/public-key",
  "mcu_type": "janus",
  "mcu_url": "ws://localhost:8188/",
  "mcu_maxstreambitrate": 1048576,
  "mcu_maxscreenbitrate": 2097152,
  "stats_allowed_ips": "",
  "etcd_endpoints": "127.0.0.1:2379,127.0.0.1:22379,127.0.0.1:32379",
  "etcd_discoverysrv": "example.com",
  "etcd_discoveryservice": "foo",
  "etcd_clientkey": "/path/to/etcd-client.key",
  "etcd_clientcert": "/path/to/etcd-client.crt",
  "etcd_cacert": "/path/to/etcd-ca.crt"
}
