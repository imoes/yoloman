{
  "log_level": 2,
  "pid_file": "/run/dmeventd.pid",
  "max_worker_threads": 8,
  "operation_timeout": 30,
  "daemonize": true,
  "monitored_devices": [
    {
      "path": "/dev/mapper/vg0-lv_root",
      "flags": "mirror"
    },
    {
      "path": "/dev/mapper/vg0-lv_var",
      "flags": "snapshot"
    },
    {
      "path": "/dev/mapper/vg0-thinpool"
    }
  ],
  "lvm2_path": "/sbin/lvm",
  "state_dir": "/run/dmeventd",
  "use_udev": true,
  "max_retries": 3,
  "retry_delay": 2
}
