{
  "listen_address": "unix:path=/var/run/dbus/system_bus_socket",
  "systemd_socket_activation": true,
  "system_services": [
    {
      "name": "NetworkManager",
      "uid": "root",
      "well_known_name": "org.freedesktop.NetworkManager"
    },
    {
      "name": "systemd-logind",
      "uid": "root",
      "well_known_name": "org.freedesktop.login1"
    },
    {
      "name": "udisks2",
      "uid": "root",
      "well_known_name": "org.freedesktop.UDisks2"
    }
  ],
  "trusted_services": [
    {
      "name": "systemd",
      "well_known_name": "org.freedesktop.systemd1"
    }
  ],
  "includedir": "/etc/dbus-1/system.d",
  "log_destination": "syslog",
  "limits_connections": 1024,
  "limits_max_replies": 100,
  "limits_max_message_size": 262144,
  "shutdown_on_disconnect": false
}
