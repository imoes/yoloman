<?xml version="1.0" encoding="UTF-8"?>
<!--
  D-Bus System Bus Configuration
  ==============================
  Generated by Ansible. Manages the primary system bus listener,
  access policies, logging, limits, and shutdown behavior.
-->
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>

  {# ------------------------------------------------------------------ #}
  {# TRANSPORT: Where the D-Bus daemon listens for connections.        #}
  {# ------------------------------------------------------------------ #}

  <!--
    listen_address: D-Bus transport address to listen on.
    Typically a Unix domain socket path like '/var/run/dbus/system_bus_socket'.
    Can also be 'tcp:host=...,port=...' for network access.
  -->
  <listen>{{ listen_address | default('unix:path=/var/run/dbus/system_bus_socket') }}</listen>

  {# ------------------------------------------------------------------ #}
  {# SYSTEMD SOCKET ACTIVATION                                          #}
  {# ------------------------------------------------------------------ #}

  <!--
    systemd_socket_activation: If true, enable systemd socket activation.
    This improves startup performance by delaying daemon launch until a
    client connects.
  -->
  {% if systemd_socket_activation | default(false) %}
  <listen>systemd:activation=yes</listen>
  {% endif %}

  {# ------------------------------------------------------------------ #}
  {# POLICY: Default Access Control List                                #}
  {# ------------------------------------------------------------------ #}

  <!--
    Default policy: Applies to all connections not matched by specific
    user or group rules. D-Bus denies by default unless explicitly allowed.
  -->
  <policy context="default">
    <!-- Allow any user to connect to the bus daemon. -->
    <allow user="*"/>

    <!-- Allow sending messages to any destination service. -->
    <allow send_destination="*" send_interface="*"/>

    <!-- Allow receiving broadcast signals from any service. -->
    <allow send_type="signal"/>

    <!-- Allow any user to claim (own) any well-known bus name. -->
    <allow own="*"/>

    <!-- Deny unprivileged users from subscribing to all signals. -->
    <deny send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus" send_member="Subscribe"/>
  </policy>

  {# ------------------------------------------------------------------ #}
  {# POLICY: Root User Full Access                                      #}
  {# ------------------------------------------------------------------ #}

  <!--
    Root policy: The root user (UID 0) has unrestricted access to all
    D-Bus services and methods on the system bus.
  -->
  <policy context="root">
    <allow own="*"/>
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
  </policy>

  {# ------------------------------------------------------------------ #}
  {# POLICY: Custom System Services                                     #}
  {# ------------------------------------------------------------------ #}

  <!--
    system_services: List of system services requiring custom policy rules.
    Each entry defines a service user and its allowed D-Bus operations.
  -->
  {% for service in system_services | default([]) %}
  <policy user="{{ service.uid | default(service.well_known_name | default('unknown')) }}">
    <allow own="{{ service.well_known_name | default('*') }}"/>
    <allow send_destination="{{ service.well_known_name | default('*') }}"/>
    <allow receive_sender="{{ service.well_known_name | default('*') }}"/>
  </policy>
  {% endfor %}

  {# ------------------------------------------------------------------ #}
  {# POLICY: Trusted System Services                                    #}
  {# ------------------------------------------------------------------ #}

  <!--
    trusted_services: List of trusted system services (e.g., init, systemd)
    requiring elevated privileges. Each entry defines a service's D-Bus name.
  -->
  {% for trusted in trusted_services | default([]) %}
  <policy context="trusted">
    <allow own="{{ trusted.well_known_name | default('*') }}"/>
    <allow send_destination="{{ trusted.well_known_name | default('*') }}"/>
    <allow receive_sender="{{ trusted.well_known_name | default('*') }}"/>
  </policy>
  {% endfor %}

  {# ------------------------------------------------------------------ #}
  {# INCLUDE: Additional Configuration Fragments                        #}
  {# ------------------------------------------------------------------ #}

  <!--
    includedir: Directory containing additional .conf fragments to include
    in the bus configuration. Default is /etc/dbus-1/system.d.
  -->
  <includedir>{{ includedir | default('/etc/dbus-1/system.d') }}</includedir>

  {# ------------------------------------------------------------------ #}
  {# LOGGING: Output Destination                                        #}
  {# ------------------------------------------------------------------ #}

  <!--
    log_destination: Where to send D-Bus daemon log output (syslog, file,
    or stderr). Default is syslog.
  -->
  <log{{ log_destination | default('syslog') | lower }}>{{ log_destination | default('syslog') }}</log>

  {# ------------------------------------------------------------------ #}
  {# LIMITS: Resource Constraints                                       #}
  {# ------------------------------------------------------------------ #}

  <!--
    limits_connections: Maximum number of concurrent client connections allowed.
  -->
  <limits connections="{{ limits_connections | default(1024) }}"/>

  <!--
    limits_max_replies: Maximum number of reply messages a single connection
    may have queued at once.
  -->
  <limits max_replies_per_connection="{{ limits_max_replies | default(50) }}"/>

  <!--
    limits_max_message_size: Maximum size (in bytes) of a single D-Bus message.
  -->
  <limits max_message_size="{{ limits_max_message_size | default(131072) }}"/>

  {# ------------------------------------------------------------------ #}
  {# EXTENSIONS: Plugin Support                                         #}
  {# ------------------------------------------------------------------ #}

  <!--
    SystemD activation extension. Enables the daemon to support systemd
    socket activation features.
  -->
  <extension path="/usr/lib/dbus-1.0/dbus-daemon-extension" type="systemd">
    <argument name="systemd-activation" value="yes"/>
  </extension>

  {# ------------------------------------------------------------------ #}
  {# SHUTDOWN: Idle Shutdown Behavior                                   #}
  {# ------------------------------------------------------------------ #}

  <!--
    shutdown_on_disconnect: If true, shut down the D-Bus daemon when the
    last client disconnects. Dangerous in production.
  -->
  {% if shutdown_on_disconnect | default(false) %}
  <shutdown_idle/>
  {% endif %}

</busconfig>