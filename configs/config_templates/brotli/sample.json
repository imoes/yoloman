{
  "brotli.entries": [
    {
      "command": "compress",
      "description": "Default compression with best quality and default window",
      "quality": 11,
      "window": 24,
      "suffix": ".br",
      "input_file": "/path/to/input.txt",
      "output_file": "/path/to/output.txt.br"
    },
    {
      "command": "decompress",
      "description": "Decompress .br file to original name, keep source, overwrite output",
      "input_file": "/path/to/file.txt.br",
      "keep": true,
      "force": true
    },
    {
      "command": "test",
      "description": "Test integrity of compressed file",
      "input_file": "/path/to/check.br",
      "verbose": true
    },
    {
      "command": "compress",
      "description": "Compression with custom dictionary and larger window",
      "quality": 9,
      "window": 22,
      "dictionary": "/etc/brotli/dict.txt",
      "input_file": "-",
      "stdout": true
    }
  ]
}
