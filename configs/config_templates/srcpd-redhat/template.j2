<?xml version="1.0"?>
<!--
  srcpd Configuration Template
  -----------------------------
  Self-documenting configuration for the srcpd server.
  See schema fields for descriptions of each parameter.
-->
<srcpd version="2.0">
  <!-- Bus 0 Configuration -->
  <bus number="0">
    <!-- The TCP port for the srcpd server on bus 0. -->
    <tcp-port>{{ tcp_port | default('4303') }}</tcp-port>
    <!-- Path to the PID file for the srcpd server. -->
    <pid-file>{{ pid_file | default('/var/run/srcpd.pid') }}</pid-file>
    <!-- The user account under which the srcpd server runs. -->
    <username>{{ username | default('nobody') }}</username>
    <!-- The group account under which the srcpd server runs. -->
    <groupname>{{ groupname | default('nogroup') }}</groupname>
    <!-- The verbosity level for logging on both buses. -->
    <verbosity>{{ verbosity | default('3') }}</verbosity>
  </bus>

  <!-- Bus 1 Configuration -->
  <bus number="1">
    <!-- Number of loopback interfaces for bus 1. -->
    <loopback>
      <number_fb>{{ number_fb | default('3') }}</number_fb>
    </loopback>
    <!-- Whether to use a watchdog for bus 1. -->
    <use_watchdog>{{ use_watchdog | default('no') }}</use_watchdog>
    <!-- The verbosity level for logging on both buses. -->
    <verbosity>{{ verbosity | default('3') }}</verbosity>
    <!-- Whether to automatically power on devices on bus 1. -->
    <auto_power_on>{{ auto_power_on | default('yes') }}</auto_power_on>
  </bus>
</srcpd>
