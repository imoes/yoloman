# =============================================================================
# nscd (Name Service Cache Daemon) Configuration
# =============================================================================
# This configuration file controls the behavior of the Name Service Cache Daemon
# (nscd), which caches frequently used name service information (passwd, group,
# hosts) to reduce the load on name service backends (like DNS or LDAP) and
# improve system performance.
#
# Global Daemon Settings
# =============================================================================

# debug-level <level>
# Controls the verbosity of the daemon's log output.
# Range: 0 (no debug) to 4 (extremely verbose).
# Default: 0
debug-level {{ debug_level | default('0') }}

# threads <count>
# Sets the initial number of worker threads for the daemon.
# Default: 14
threads {{ threads | default('14') }}

# max-threads <count>
# Sets the maximum number of worker threads the daemon can spawn.
# Default: 32
max-threads {{ max_threads | default('32') }}

# server-user <username>
# Specifies the user account under which the nscd server process runs.
# This is a security measure to run the daemon with minimal privileges.
# Default: unscd
server-user {{ server_user | default('unscd') }}


# =============================================================================
# Cache Configuration
# =============================================================================
# Each cache section defines how a specific type of name service data is cached.
# Supported caches: passwd, group, hosts.
#
# Directives:
#   enable-cache <service> <yes|no>     : Activate or deactivate the cache.
#   positive-time-to-live <seconds>     : How long to cache successful lookups.
#   negative-time-to-live <seconds>     : How long to cache failed lookups.
#   suggested-size <prime number>       : Initial size of the hash table.
#   check-files <yes|no>                : Check file modification times (passwd/group).


# -----------------------------------------------------------------------------
# passwd Cache
# -----------------------------------------------------------------------------

# enable-cache passwd <yes|no>
# Enable caching of password database entries (from /etc/passwd, NIS, LDAP, etc.).
# Default: yes
enable-cache passwd yes

# positive-time-to-live passwd <seconds>
# Duration (in seconds) to cache successful password lookups.
# Default: 600
positive-time-to-live passwd {{ passwd_positive_ttl | default('600') }}

# negative-time-to-live passwd <seconds>
# Duration (in seconds) to cache failed password lookups (e.g., non-existent user).
# Default: 20
negative-time-to-live passwd {{ passwd_negative_ttl | default('20') }}

# suggested-size passwd <prime number>
# Suggested number of entries for the passwd hash table.
# Should ideally be a prime number for optimal performance.
# Default: 1001
suggested-size passwd {{ passwd_suggested_size | default('1001') }}

# check-files passwd <yes|no>
# If yes, nscd checks the modification time of /etc/passwd and related files.
# If a file is modified, the cache for that entry is invalidated.
# Default: yes
check-files passwd yes


# -----------------------------------------------------------------------------
# group Cache
# -----------------------------------------------------------------------------

# enable-cache group <yes|no>
# Enable caching of group database entries (from /etc/group, NIS, LDAP, etc.).
# Default: yes
enable-cache group yes

# positive-time-to-live group <seconds>
# Duration (in seconds) to cache successful group lookups.
# Default: 3600
positive-time-to-live group {{ group_positive_ttl | default('3600') }}

# negative-time-to-live group <seconds>
# Duration (in seconds) to cache failed group lookups.
# Default: 60
negative-time-to-live group {{ group_negative_ttl | default('60') }}

# suggested-size group <prime number>
# Suggested number of entries for the group hash table.
# Default: 1001
suggested-size group {{ group_suggested_size | default('1001') }}

# check-files group <yes|no>
# If yes, nscd checks the modification time of /etc/group and related files.
# Default: yes
check-files group yes


# -----------------------------------------------------------------------------
# hosts Cache
# -----------------------------------------------------------------------------

# enable-cache hosts <yes|no>
# Enable caching of host name lookups (from /etc/hosts, DNS, etc.).
# Note: Caching hosts via nscd can sometimes cause issues with gethostby*
# calls not respecting DNS TTLs strictly. Consider using a dedicated
# caching DNS resolver (like systemd-resolved or dnsmasq) instead.
# Default: no
enable-cache hosts no

# positive-time-to-live hosts <seconds>
# Duration (in seconds) to cache successful host name lookups.
# Default: 3600
positive-time-to-live hosts {{ hosts_positive_ttl | default('3600') }}

# negative-time-to-live hosts <seconds>
# Duration (in seconds) to cache failed host name lookups.
# Default: 20
negative-time-to-live hosts {{ hosts_negative_ttl | default('20') }}

# suggested-size hosts <prime number>
# Suggested number of entries for the hosts hash table.
# Default: 1001
suggested-size hosts {{ hosts_suggested_size | default('1001') }}

# check-files hosts <yes|no>
# If yes, nscd checks the modification time of /etc/hosts.
# Default: yes
check-files hosts yes
