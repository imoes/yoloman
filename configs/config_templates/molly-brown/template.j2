# Molly Brown configuration
# This file defines the SSL certificate paths, document root, and logging locations.

# Path to the SSL certificate file
CertPath = "{{ cert_path | default('/etc/molly-brown/certs/localhost.crt') }}"

# Path to the SSL private key file
KeyPath = "{{ key_path | default('/etc/molly-brown/certs/localhost.key') }}"

# Document root base directory
DocBase = "{{ doc_base | default('/var/lib/private/molly-brown') }}"

# Path to the access log file (use '-' for stdout)
AccessLog = "{{ access_log | default('-') }}"

# Path to the error log file
ErrorLog = "{{ error_log | default('') }}"