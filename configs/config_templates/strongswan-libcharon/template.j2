# strongSwan plugin configuration for bypass-lan
# This plugin allows IKE traffic to bypass the Linux firewall (netfilter) for specific interfaces,
# which is useful for VPN gateways to avoid loopback/forwarding issues.

bypass-lan {

    # A comma-separated list of network interfaces for which connected subnets
    # should be ignored, if interfaces_use is specified this option has no
    # effect.
    # interfaces_ignore =

    # A comma-separated list of network interfaces for which connected subnets
    # should be considered. All other interfaces are ignored.
    # interfaces_use =

    # Whether to load the bypass-lan plugin. Can also be an integer to increase
    # the priority of this plugin.
    # Default: False (plugin not loaded)
    load = {{ load | default(False) | lower }}

}