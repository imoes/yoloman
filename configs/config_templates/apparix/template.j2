{# ============================================================
   Apparix Bookmarks Configuration Template
   ============================================================
   This template generates an Apparix bookmarks resource file.
   Apparix uses this file to store user-defined bookmarks (links to
   directories) in the user's home directory (~/.apparix/bookmarks).

   The file format is a simple CSV-like structure:
   - 'j,<mark>,<path>,' defines a regular bookmark.
   - 'p,<mark>,<path>,' defines a portal (directory expansion).
   - 'j,<mark>,<path>,' inside a portal expansion section defines
     the individual subdirectory bookmarks derived from a portal.

   This template is self-documenting: every directive is preceded
   by a comment explaining its source and purpose.
   ============================================================ #}

{# ------------------------------------------------------------------
   Configuration Metadata
   ------------------------------------------------------------------ #}

{# config_metadata.generated_by: Identifier for the tool that generated this file.
   Default is 'apparix-config-template' if not specified. #}
# Generated by {{ (config_metadata | default({})).generated_by | default('apparix-config-template') }}

{# config_metadata.timestamp: ISO 8601 timestamp of when this config was generated.
   Default is empty string if not provided. #}
# Timestamp: {{ (config_metadata | default({})).timestamp | default('') }}

{# ------------------------------------------------------------------
   Regular Bookmarks
   ------------------------------------------------------------------ #}
{# bookmarks: List of standard bookmarks.
   Each item has a 'mark' (name/alias) and a 'destination' (absolute path).
   Format in file: j,<mark>,<destination>, #}
{% if bookmarks | default([]) | length > 0 %}
# Regular bookmarks
{% for item in bookmarks | default([]) %}
{% if loop.first %}# Format: j,<mark>,<destination>,
{% endif %}j,{{ item.mark | default('') }},{{ item.destination | default('') }},
{% endfor %}
{% endif %}

{# ------------------------------------------------------------------
   Portal Bookmarks
   ------------------------------------------------------------------ #}
{# portals: List of portal bookmarks.
   A portal is a root directory that Apparix expands into subdirectory
   bookmarks.
   Format in file: p,<mark>,<destination>, #}
{% if portals | default([]) | length > 0 %}
# Portal bookmarks
{% for item in portals | default([]) %}
{% if loop.first %}# Format: p,<mark>,<destination>,
{% endif %}p,{{ item.mark | default('') }},{{ item.destination | default('') }},
{% endfor %}
{% endif %}

{# ------------------------------------------------------------------
   Portal Expansions (Derived Bookmarks)
   ------------------------------------------------------------------ #}
{# portal_expansions: List of bookmarks automatically generated from portals.
   These represent the actual subdirectories within a portal root.
   Format in file: j,<mark>,<destination>, #}
{% if portal_expansions | default([]) | length > 0 %}
# Portal expansions
{% for item in portal_expansions | default([]) %}
{% if loop.first %}# Format: j,<mark>,<destination>,
{% endif %}j,{{ item.mark | default('') }},{{ item.destination | default('') }},
{% endfor %}
{% endif %}

# End of resource file