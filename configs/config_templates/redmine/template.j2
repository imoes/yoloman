# ==============================================================================
# Redmine Configuration
#
# This template generates the configuration file for the Redmine web application.
# It defines ownership rules for instance directories and the root path structure.
# ==============================================================================

# Owner:group for Redmine instance directories and files (e.g., 'www-data:www-data').
# Defaults to 'www-data:www-data' if not specified in the role variables.
REDMINE_INSTANCES_OWNERSHIP={{ redmine_instances_ownership | default('www-data:www-data') }}

# Whether to follow Filesystem Hierarchy Standard paths (e.g., /var/lib/redmine).
# If true, instances are stored under standard directories; if false, custom paths may apply.
# Defaults to 'True' if not specified.
REDMINE_INSTANCES_FOLLOW_FHS={{ redmine_instances_follow_fhs | default(True) | lower }}

# Root directory for Redmine instances (must be writable by web server).
# This path is where Redmine instance data is stored.
# Defaults to '/var/lib/redmine' if not specified.
REDMINE_INSTANCES_ROOT={{ redmine_instances_root | default('/var/lib/redmine') }}