# Database connection configuration
# Redmine supports multiple databases (MySQL, PostgreSQL, SQLite).
database:
  # Production environment
  production:
    # Database type: mysql2, postgresql, sqlite3
    adapter: {{ db_adapter }}
    # Hostname or IP address (empty for SQLite)
    host: {{ db_host }}
    # Database name
    database: {{ db_name }}
    # Username for DB connection
    username: {{ db_username }}
    # Password for DB connection (use 'password' key for older Redmine; 'password' is standard)
    password: {{ db_password }}
    # Port (only for non-SQLite; 0 means default)
    port: {{ db_port }}
    # Socket (optional; used instead of host/port for local MySQL/PostgreSQL)
    socket: {{ db_socket | default('') }}
    # Encoding (e.g., 'utf8', 'utf8mb4')
    encoding: {{ db_encoding }}
    # Reconnect on disconnect? (MySQL only)
    reconnect: {{ db_reconnect | default(false) | lower }}
    # Enable prepared statements? (PostgreSQL/MySQL)
    prepared_statements: {{ db_prepared_statements | default(true) | lower }}

  # Development environment (optional; included for completeness)
  development:
    adapter: sqlite3
    database: db/development.sqlite3
    pool: 5
    timeout: 5000

  # Test environment (optional)
  test:
    adapter: sqlite3
    database: db/test.sqlite3
    pool: 5
    timeout: 5000

# Secret token used for session encryption & CSRF protection
# Keep this value secret and long (at least 30 chars); regenerate if exposed.
secret_token: '{{ secret_token }}'

# SMTP server settings for outgoing email
# Required for notifications, password recovery, etc.
email_delivery:
  delivery_method: {{ email_method }}
  # SMTP-specific settings (only used if method is :smtp)
  {{ if email_method == 'smtp' }}smtp_settings:
    # SMTP server hostname
    address: {{ smtp_address }}
    # SMTP port (typically 25, 465 (SSL), or 587 (TLS))
    port: {{ smtp_port }}
    # Domain for HELO (usually your server's FQDN)
    domain: {{ smtp_domain }}
    # Enable authentication? (true/false)
    authentication: {{ smtp_auth_type }}
    # Username (if auth enabled)
    user_name: {{ smtp_username }}
    # Password (if auth enabled)
    password: {{ smtp_password }}
    # Enable TLS? (true/false)
    openssl_verify_mode: {{ smtp_ssl_verify }}
    # Enable STARTTLS? (true/false)
    enable_starttls_auto: {{ smtp_enable_starttls | default(true) | lower }}
  {{ else if email_method == 'sendmail' }}sendmail_settings:
    location: /usr/sbin/sendmail
    arguments: -i
  {{ endif }}

# Application-wide settings
# Controls global behavior of Redmine instance
redmine_site:
  # Site name (displayed in UI header & emails)
  site_name: '{{ site_name }}'
  # Default language (e.g., 'en', 'de', 'fr', 'ja')
  default_language: '{{ default_language }}'
  # Default theme (e.g., 'default', 'redmine' — deprecated in v5+, use CSS/JS hooks instead)
  theme: '{{ theme | default(''redmine'') }}'
  # URL for your Redmine installation (used for links in emails)
  url: '{{ base_url }}'
  # Enable gravatar icons for user avatars? (true/false)
  gravatar_enabled: {{ gravatar_enabled | default(true) | lower }}
  # Default Gravatar fallback image (e.g., 'identicon', 'mp', 'wavatar')
  gravatar_default: '{{ gravatar_default | default(''identicon'') }}'
  # Max uploaded file size (in bytes); set to 0 for unlimited
  max_upload_size: {{ max_upload_size | default(5242880) }}
  # Enable activity feed? (true/false)
  activity_enabled: {{ activity_enabled | default(true) | lower }}
  # Default days to show in activity view
  activity_days_default: {{ activity_days_default | default(14) }}
  # Enable wiki? (true/false)
  wiki_enabled: {{ wiki_enabled | default(true) | lower }}
  # Enable forums? (true/false)
  forums_enabled: {{ forums_enabled | default(true) | lower }}
  # Enable time tracking? (true/false)
  timelogging_enabled: {{ timelogging_enabled | default(true) | lower }}
  # Default project visibility ('public', 'private', or 'loggedin')
  default_project_visibility: '{{ default_project_visibility }}'
  # List of enabled modules (used in new projects)
  enabled_modules:
    {{ for module in enabled_modules }}    - {{ module }}
    {{ endfor }}

# Optional: Custom settings for background jobs (e.g., mailers queue)
# Not in official config.yml but commonly used via environment or plugins
# If needed, use config/initializers/ or environment variables instead.
# (No direct Redmine config key; added for completeness.)