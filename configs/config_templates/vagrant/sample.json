{
  "vagrant_home": "/opt/vagrant/.vagrant.d",
  "plugins": [
    "vagrant-vbguest",
    "vagrant-digitalocean"
  ],
  "default_provider": "virtualbox",
  "port_forwarding": {
    "2222": "22",
    "8080": "80"
  },
  "ssh_user": "vagrant",
  "ssh_private_key_path": "/opt/vagrant/.vagrant.d/insecure_private_key",
  "ssh_enable_pubkey_auth": true,
  "box_catalog_url": "https://vagrantcloud.com/boxes",
  "provision_timeout": 7200,
  "log_level": "debug",
  "show_welcome_message": false,
  "status_format": "json"
}
