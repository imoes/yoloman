{
  "option_dns_servers": {
    "type": "string",
    "default": "192.168.1.1",
    "description": "DNS servers to offer to clients."
  },
  "option_nbns_servers": {
    "type": "string",
    "default": "",
    "description": "NetBIOS name servers to offer to clients."
  },
  "option_routers": {
    "type": "string",
    "default": "192.168.1.254",
    "description": "Default router/gateway for the subnet."
  },
  "default_lease_time": {
    "type": "number",
    "default": 600,
    "description": "Default lease time in seconds."
  },
  "max_lease_time": {
    "type": "number",
    "default": 7200,
    "description": "Maximum lease time in seconds."
  },
  "log_facility": {
    "type": "string",
    "default": "local7",
    "description": "Syslog facility for DHCP logging.",
    "enum": [
      "auth",
      "authpriv",
      "cron",
      "daemon",
      "ftp",
      "kern",
      "lpr",
      "mail",
      "mark",
      "news",
      "ntp",
      "security",
      "syslog",
      "user",
      "uucp",
      "local0",
      "local7"
    ]
  },
  "subnet_cidr": {
    "type": "string",
    "default": "192.168.1.0",
    "description": "Network address of the subnet."
  },
  "subnet_netmask": {
    "type": "string",
    "default": "255.255.255.0",
    "description": "Netmask for the subnet."
  },
  "range_start": {
    "type": "string",
    "default": "192.168.1.100",
    "description": "Start of the IP address pool."
  },
  "range_end": {
    "type": "string",
    "default": "192.168.1.200",
    "description": "End of the IP address pool."
  },
  "broadcast_address": {
    "type": "string",
    "default": "192.168.1.255",
    "description": "Broadcast address for the subnet."
  }
}
