{
  "log_timestamp": true,
  "log_syslog": false,
  "logfacility": "local6",
  "enable_dns": true,
  "enable_http": true,
  "enable_https": true,
  "enable_smtp": true,
  "enable_pop3": false,
  "enable_imap": false,
  "enable_ftp": true,
  "enable_ssh": true,
  "enable_telnets": false,
  "bind_address": "127.0.0.1",
  "bind_port_http": 8080,
  "bind_port_https": 8443,
  "bind_port_smtp": 2525,
  "bind_port_dns": 5353,
  "bind_port_ftp": 2121,
  "bind_port_ssh": 2222,
  "bind_port_pop3": 1100,
  "bind_port_imap": 1430,
  "bind_port_telnets": 2323,
  "dns_mode": "wildcard",
  "dns_default_ip": "192.168.1.1",
  "dns_redirects": [
    {
      "host": "example.com",
      "ip": "10.0.0.1"
    },
    {
      "host": "inetsim.local",
      "ip": "127.0.0.1"
    }
  ],
  "dns_max_ttl": 3600,
  "http_directory": "/var/lib/inetsim/http",
  "http_port": 8080,
  "http_default_file": "index.html",
  "http_error_404": "404.html",
  "http_mimetypes": [
    {
      "ext": "html",
      "mime": "text/html"
    },
    {
      "ext": "css",
      "mime": "text/css"
    },
    {
      "ext": "js",
      "mime": "application/javascript"
    },
    {
      "ext": "png",
      "mime": "image/png"
    },
    {
      "ext": "jpg",
      "mime": "image/jpeg"
    },
    {
      "ext": "gif",
      "mime": "image/gif"
    },
    {
      "ext": "json",
      "mime": "application/json"
    }
  ],
  "http_directory_index": "off",
  "smtp_directory": "/var/lib/inetsim/smtp",
  "smtp_port": 2525,
  "smtp_default_file": "message.eml",
  "smtp_allowed_senders": [],
  "smtp_allowed_recipients": [],
  "ssh_port": 2222,
  "ssh_keys_directory": "/etc/inetsim/ssh",
  "ssh_user_directory": "/var/lib/inetsim/ssh_users",
  "ssh_allow_password_auth": true,
  "ssh_allow_pubkey_auth": false,
  "ftp_directory": "/var/lib/inetsim/ftp",
  "ftp_port": 2121,
  "ftp_writable": false,
  "ftp_anonymous": true,
  "tcp_wrappers": "off",
  "tcp_timeout": 120,
  "tcp_syn_timeout": 15,
  "tcp_fin_timeout": 30,
  "tcp_keepalive": false,
  "tcp_reuse_address": true,
  "tcp_nodelay": false,
  "udp_port": 5353
}
