# inetsim configuration file
# This file configures the inetsim (internet simulation) service, which acts
# as a honeypot simulator for common internet protocols.

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------

# Syslog facility to use when logging to syslog.
# Valid facilities: local0-local7, auth, authpriv, cron, daemon, etc.
# @default local6
logfacility {{ logfacility | default('local6') }}

# Whether to prepend log lines with a timestamp.
# @default true
log_timestamp {{ log_timestamp | default(true) }}

# Whether to send logs to syslog in addition to the log file.
# @default false
log_syslog {{ log_syslog | default(false) }}

# IP address to bind all services to (e.g., 127.0.0.1 for localhost only, 0.0.0.0 for all interfaces).
# @default 0.0.0.0
bind_address {{ bind_address | default('0.0.0.0') }}

# -----------------------------------------------------------------------------
# DNS Service
# -----------------------------------------------------------------------------

# Enable simulated DNS service.
# @default true
enable_dns {{ enable_dns | default(true) }}

# Port to bind the DNS service to (UDP and TCP).
# @default 53
bind_port_dns {{ bind_port_dns | default(53) }}

# Mode for DNS resolution: 'ipv4', 'ipv6', 'ipv4_first', 'ipv6_first', 'none' (disables DNS), or 'wildcard'.
# @default ipv4
dns_mode {{ dns_mode | default('ipv4') }}

# IP address returned for all DNS queries when dns_mode=none or dns_mode=wildcard.
# @default 192.168.1.1
dns_default_ip {{ dns_default_ip | default('192.168.1.1') }}

# Maximum TTL (in seconds) to use in DNS responses.
# @default 86400
dns_max_ttl {{ dns_max_ttl | default(86400) }}

# List of hostnames to override DNS resolution with specific IPs.
# Format per line: hostname ip_address
# @default empty list (no overrides)
# Note: dns_redirects is a list of mappings (dicts) in the schema, e.g. [{'hostname': 'foo', 'ip': '1.2.3.4'}]
{% for redirect in dns_redirects | default([]) %}
dns_redirects {{ redirect.hostname }} {{ redirect.ip }}
{% endfor %}

# -----------------------------------------------------------------------------
# HTTP/HTTPS Services
# -----------------------------------------------------------------------------

# Enable simulated HTTP service.
# @default true
enable_http {{ enable_http | default(true) }}

# Port to bind the HTTP service to.
# @default 80
bind_port_http {{ bind_port_http | default(80) }}

# Directory containing HTTP content (web pages, assets).
# @default /var/lib/inetsim/http
http_directory {{ http_directory | default('/var/lib/inetsim/http') }}

# Enable simulated HTTPS service.
# @default true
enable_https {{ enable_https | default(true) }}

# Port to bind the HTTPS service to.
# @default 443
bind_port_https {{ bind_port_https | default(443) }}

# -----------------------------------------------------------------------------
# FTP Service
# -----------------------------------------------------------------------------

# Enable simulated FTP service.
# @default true
enable_ftp {{ enable_ftp | default(true) }}

# Port to bind the FTP service to.
# @default 21
bind_port_ftp {{ bind_port_ftp | default(21) }}

# -----------------------------------------------------------------------------
# Mail Services
# -----------------------------------------------------------------------------

# Enable simulated SMTP service.
# @default true
enable_smtp {{ enable_smtp | default(true) }}

# Port to bind the SMTP service to.
# @default 25
bind_port_smtp {{ bind_port_smtp | default(25) }}

# Enable simulated IMAP service.
# @default false
enable_imap {{ enable_imap | default(false) }}

# Port to bind the IMAP service to.
# @default 143
bind_port_imap {{ bind_port_imap | default(143) }}

# Enable simulated POP3 service.
# @default false
enable_pop3 {{ enable_pop3 | default(false) }}

# Port to bind the POP3 service to.
# @default 110
bind_port_pop3 {{ bind_port_pop3 | default(110) }}

# -----------------------------------------------------------------------------
# Remote Access Services
# -----------------------------------------------------------------------------

# Enable simulated SSH service (requires valid SSH host keys).
# @default false
enable_ssh {{ enable_ssh | default(false) }}

# Port to bind the SSH service to.
# @default 22
bind_port_ssh {{ bind_port_ssh | default(22) }}

# Enable simulated Telnet service.
# @default false
enable_telnets {{ enable_telnets | default(false) }}

# Port to bind the Telnet service to.
# @default 23
bind_port_telnets {{ bind_port_telnets | default(23) }}

# -----------------------------------------------------------------------------
# Daemon Options
# -----------------------------------------------------------------------------

# Options to pass to the inetsim daemon.
# @default empty string
{% if daemon_args | default('') | trim | length > 0 %}
DAEMON_ARGS="{{ daemon_args }}"
{% else %}
DAEMON_ARGS=""
{% endif %}