# inetsim main configuration file
# Controls logging behavior
log_options {
  log_timestamp = {{ log_timestamp | string | lower }};
  log_syslog = {{ log_syslog | string | lower }};
  logfacility = {{ logfacility }};
}

# Enables or disables network services
service_options {
  enable_dns = {{ enable_dns | string | lower }};
  enable_http = {{ enable_http | string | lower }};
  enable_https = {{ enable_https | string | lower }};
  enable_smtp = {{ enable_smtp | string | lower }};
  enable_pop3 = {{ enable_pop3 | string | lower }};
  enable_imap = {{ enable_imap | string | lower }};
  enable_ftp = {{ enable_ftp | string | lower }};
  enable_ssh = {{ enable_ssh | string | lower }};
  enable_telnets = {{ enable_telnets | string | lower }};
}

# Controls binding of services to specific interface
service_binding {
  bind_address = "{{ bind_address }}";
  bind_port_http = {{ bind_port_http }};
  bind_port_https = {{ bind_port_https }};
  bind_port_smtp = {{ bind_port_smtp }};
  bind_port_dns = {{ bind_port_dns }};
  bind_port_ftp = {{ bind_port_ftp }};
  bind_port_ssh = {{ bind_port_ssh }};
  bind_port_pop3 = {{ bind_port_pop3 }};
  bind_port_imap = {{ bind_port_imap }};
  bind_port_telnets = {{ bind_port_telnets }};
}

# DNS simulation settings
dns_options {
  dns_mode = "{{ dns_mode }}";
  dns_default_ip = "{{ dns_default_ip }}";
{% for entry in dns_redirects %}  {{ entry.host }} = "{{ entry.ip }}";
{% endfor %}
  dns_max_ttl = {{ dns_max_ttl }};
}

# HTTP simulation settings
http_options {
  http_directory = "{{ http_directory }}";
  http_port = {{ http_port }};
  http_default_file = "{{ http_default_file }}";
  http_error_404 = "{{ http_error_404 }}";
{% for mime_type in http_mimetypes %}  {{ mime_type.ext }} = "{{ mime_type.mime }}";
{% endfor %}
  http_directory_index = "{{ http_directory_index }}";
}

# SMTP simulation settings
smtp_options {
  smtp_directory = "{{ smtp_directory }}";
  smtp_port = {{ smtp_port }};
  smtp_default_file = "{{ smtp_default_file }}";
{% for sender in smtp_allowed_senders %}  smtp_allowed_sender {{ sender }};
{% endfor %}
{% for recipient in smtp_allowed_recipients %}  smtp_allowed_recipient {{ recipient }};
{% endfor %}
}

# SSH simulation settings
ssh_options {
  ssh_port = {{ ssh_port }};
  ssh_keys_directory = "{{ ssh_keys_directory }}";
  ssh_user_directory = "{{ ssh_user_directory }}";
  ssh_allow_password_auth = {{ ssh_allow_password_auth | string | lower }};
  ssh_allow_pubkey_auth = {{ ssh_allow_pubkey_auth | string | lower }};
}

# FTP simulation settings
ftp_options {
  ftp_directory = "{{ ftp_directory }}";
  ftp_port = {{ ftp_port }};
  ftp_writable = {{ ftp_writable | string | lower }};
  ftp_anonymous = {{ ftp_anonymous | string | lower }};
}

# General network and timing settings
network_options {
  tcp_wrappers = "{{ tcp_wrappers }}";
  tcp_timeout = {{ tcp_timeout }};
  tcp_syn_timeout = {{ tcp_syn_timeout }};
  tcp_fin_timeout = {{ tcp_fin_timeout }};
  tcp_keepalive = {{ tcp_keepalive | string | lower }};
  tcp_reuse_address = {{ tcp_reuse_address | string | lower }};
  tcp_nodelay = {{ tcp_nodelay | string | lower }};
  udp_port = {{ udp_port }};
}

# End of configuration