{
  "mode": {
    "type": "string",
    "default": "create",
    "description": "Import mode: 'create' or 'append'",
    "enum": [
      "create",
      "append"
    ]
  },
  "database": {
    "type": "string",
    "default": "gis",
    "description": "PostgreSQL database name"
  },
  "username": {
    "type": "string",
    "default": "osm",
    "description": "PostgreSQL username"
  },
  "host": {
    "type": "string",
    "default": "localhost",
    "description": "PostgreSQL host or socket location"
  },
  "port": {
    "type": "number",
    "default": 5432,
    "description": "PostgreSQL port"
  },
  "use_password_prompt": {
    "type": "bool",
    "default": false,
    "description": "Force password prompt (-W)"
  },
  "primary_schema": {
    "type": "string",
    "default": "public",
    "description": "Primary schema for output tables"
  },
  "middle_schema": {
    "type": "string",
    "default": "public",
    "description": "Schema for middle (temporary) tables"
  },
  "table_prefix": {
    "type": "string",
    "default": "planet_osm",
    "description": "Prefix for table names"
  },
  "input_format": {
    "type": "string",
    "default": "auto",
    "description": "Input file format: auto, xml, o5m, pbf",
    "enum": [
      "auto",
      "xml",
      "o5m",
      "pbf"
    ]
  },
  "bbox": {
    "type": "string",
    "default": "",
    "description": "Bounding box filter MINLON,MINLAT,MAXLON,MAXLAT"
  },
  "slim_mode": {
    "type": "bool",
    "default": true,
    "description": "Enable slim mode for updates"
  },
  "cache_size_mb": {
    "type": "number",
    "default": 800,
    "description": "Cache size in MB for slim mode"
  },
  "drop_slime_tables": {
    "type": "bool",
    "default": false,
    "description": "Drop slim tables after import (--drop)"
  },
  "flat_nodes_file": {
    "type": "string",
    "default": "",
    "description": "Path to flat nodes file"
  },
  "middle_with_nodes": {
    "type": "bool",
    "default": false,
    "description": "Store nodes with tags in DB when using flat nodes"
  },
  "output_type": {
    "type": "string",
    "default": "pgsql",
    "description": "Output type: pgsql, flex, null",
    "enum": [
      "pgsql",
      "flex",
      "null"
    ]
  },
  "style_file": {
    "type": "string",
    "default": "/usr/share/osm2pgsql/default.style",
    "description": "Path to style file (default.style or lua config)"
  },
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Log level: debug, info, warn, error",
    "enum": [
      "debug",
      "info",
      "warn",
      "error"
    ]
  },
  "log_progress": {
    "type": "string",
    "default": "true",
    "description": "Progress logging: true, false, auto",
    "enum": [
      "true",
      "false",
      "auto"
    ]
  },
  "log_sql": {
    "type": "bool",
    "default": false,
    "description": "Enable SQL logging for debugging"
  },
  "log_sql_data": {
    "type": "bool",
    "default": false,
    "description": "Enable all data logging for debugging"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output (-v)"
  },
  "use_mercator": {
    "type": "bool",
    "default": true,
    "description": "Use Web Mercator projection (-m)"
  },
  "projection_srid": {
    "type": "number",
    "default": 3857,
    "description": "EPSG SRID for projection (-E)"
  },
  "use_hstore": {
    "type": "bool",
    "default": false,
    "description": "Add hstore column for untagged keys (-k)"
  },
  "use_hstore_all": {
    "type": "bool",
    "default": false,
    "description": "Add hstore column for all tags (-j)"
  },
  "hstore_column_prefix": {
    "type": "string",
    "default": "",
    "description": "Prefix for hstore column containing specific tags (-z)"
  },
  "hstore_match_only": {
    "type": "bool",
    "default": false,
    "description": "Keep only objects with values in non-hstore columns"
  },
  "hstore_add_index": {
    "type": "bool",
    "default": false,
    "description": "Create indexes for hstore columns"
  },
  "include_extra_attributes": {
    "type": "bool",
    "default": false,
    "description": "Include user, changeset, timestamp, version"
  },
  "multi_geometry": {
    "type": "bool",
    "default": false,
    "description": "Generate multi-geometry features (-G)"
  },
  "keep_coastlines": {
    "type": "bool",
    "default": false,
    "description": "Keep coastline data (-K)"
  },
  "reproject_area": {
    "type": "bool",
    "default": false,
    "description": "Compute area using mercator coordinates"
  },
  "tablespace_main_data": {
    "type": "string",
    "default": "",
    "description": "PostgreSQL tablespace for main data tables"
  },
  "tablespace_main_index": {
    "type": "string",
    "default": "",
    "description": "PostgreSQL tablespace for main index tables"
  },
  "tablespace_slime_data": {
    "type": "string",
    "default": "",
    "description": "PostgreSQL tablespace for slim data tables"
  },
  "tablespace_slime_index": {
    "type": "string",
    "default": "",
    "description": "PostgreSQL tablespace for slim index tables"
  },
  "expire_tiles_max_zoom": {
    "type": "number",
    "default": 18,
    "description": "Max zoom for tile expiry list"
  },
  "expire_tiles_min_zoom": {
    "type": "number",
    "default": 0,
    "description": "Min zoom for tile expiry list"
  },
  "expire_output_file": {
    "type": "string",
    "default": "",
    "description": "Output file for expired tiles list"
  },
  "expire_bbox_size": {
    "type": "number",
    "default": 20000,
    "description": "Max polygon size to expire whole bbox"
  },
  "number_processes": {
    "type": "number",
    "default": 0,
    "description": "Number of parallel threads (0 for auto)"
  },
  "disable_parallel_indexing": {
    "type": "bool",
    "default": false,
    "description": "Disable parallel indexing (-I)"
  }
}
