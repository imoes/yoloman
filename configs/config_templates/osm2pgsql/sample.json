{
  "mode": "create",
  "database": "gis",
  "username": "osm",
  "host": "/var/run/postgresql",
  "port": 5432,
  "use_password_prompt": false,
  "primary_schema": "planet_osm",
  "middle_schema": "planet_osm_middle",
  "table_prefix": "planet_osm",
  "input_format": "pbf",
  "bbox": "",
  "slim_mode": true,
  "cache_size_mb": 2048,
  "drop_slime_tables": false,
  "flat_nodes_file": "/data/osm/flat_nodes.bin",
  "middle_with_nodes": false,
  "output_type": "pgsql",
  "style_file": "/usr/share/osm2pgsql/default.style",
  "log_level": "info",
  "log_progress": "auto",
  "log_sql": false,
  "log_sql_data": false,
  "verbose": false,
  "use_mercator": true,
  "projection_srid": 3857,
  "use_hstore": true,
  "use_hstore_all": false,
  "hstore_column_prefix": "name:",
  "hstore_match_only": false,
  "hstore_add_index": true,
  "include_extra_attributes": false,
  "multi_geometry": true,
  "keep_coastlines": false,
  "reproject_area": false,
  "tablespace_main_data": "pg_default",
  "tablespace_main_index": "pg_default",
  "tablespace_slime_data": "",
  "tablespace_slime_index": "",
  "expire_tiles_max_zoom": 17,
  "expire_tiles_min_zoom": 0,
  "expire_output_file": "/data/osm/expired_tiles.list",
  "expire_bbox_size": 20000,
  "number_processes": 4,
  "disable_parallel_indexing": false
}
