{
  "ACPI_SLEEP": {
    "type": "bool",
    "default": true,
    "description": "Enable/disable ACPI suspend to RAM"
  },
  "ACPI_HIBERNATE": {
    "type": "bool",
    "default": true,
    "description": "Enable/disable suspend to disk"
  },
  "LOCK_SCREEN": {
    "type": "bool",
    "default": true,
    "description": "Enable/disable screen locking on resume"
  },
  "DISPLAY_DPMS": {
    "type": "string",
    "default": "xset",
    "description": "Method used to switch off/on the display (xset, xrandr, or vbetool)",
    "enum": [
      "xset",
      "xrandr",
      "vbetool"
    ]
  },
  "XRANDR_OUTPUT": {
    "type": "string",
    "default": "LVDS",
    "description": "Output device name used by xrandr (e.g., LVDS, eDP1)"
  }
}
