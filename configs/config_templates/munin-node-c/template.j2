# ==============================================================================
# Munin-node Configuration Template
# ==============================================================================
# This configuration file controls the behavior of the Munin node daemon.
# It is self-documenting: every directive is preceded by its schema description.
# ==============================================================================

# Specify the directory used to look up plugins.
# The node scans this directory for executable scripts and symlinks.
# Default: /usr/share/munin/plugins
plugin_directory={{ plugin_directory | default('/usr/share/munin/plugins') }}

# Enable extension stripping when given.
# When True, Munin will ignore file extensions in plugin filenames (e.g., treat 'cpu.sh' as 'cpu').
# When False, extensions are part of the plugin identification.
# Default: False
extension_stripping={{ extension_stripping | default(False) | lower }}

# Specify the hostname with which the node should greet clients.
# If empty, the node uses the system's detected hostname.
# It is recommended to set this explicitly to avoid ambiguity.
# Default: '' (empty string, implying auto-detection)
hostname={{ hostname | default('') }}