{
  "listen_address": "0.0.0.0",
  "listen_port": 8080,
  "web_root": "/var/lib/arc/monitor/www",
  "max_connections": 100,
  "debug": false,
  "log_file": "/var/log/arc/monitor.log",
  "ldap_servers": [
    {
      "description": "Primary LDAP server",
      "url": "ldap://ldap.example.com:389",
      "binddn": "cn=monitor,dc=example,dc=com",
      "bindpw": "secret123",
      "basedn": "dc=example,dc=com",
      "timeout": 30,
      "version": 3,
      "starttls": false
    }
  ],
  "refresh_interval": 300,
  "ssl_enabled": false,
  "ssl_cert_file": "",
  "ssl_key_file": "",
  "allowed_hosts": [
    "localhost",
    "127.0.0.1",
    "arc-monitor.internal"
  ],
  "allow_directory_listing": false,
  "base_url": "https://arc-monitor.example.com",
  "auth_type": "none",
  "htpasswd_file": ""
}
