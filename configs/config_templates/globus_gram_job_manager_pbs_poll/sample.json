{
  "qstat_path": "/usr/bin/qstat",
  "qdel_path": "/usr/bin/qdel",
  "qsub_path": "/usr/bin/qsub",
  "poll_interval": 60,
  "max_concurrent_polls": 200,
  "verbose_output": false,
  "preserve_working_dir": false,
  "env_vars": [
    {
      "name": "PATH",
      "value": "/usr/bin:/bin:/usr/local/bin"
    },
    {
      "name": "LD_LIBRARY_PATH",
      "value": "/usr/lib:/usr/local/lib",
      "description": "Shared library path for PBS job execution"
    }
  ],
  "queue_mode": "static",
  "queue_name": "workq",
  "queue_mappings": []
}
