<?xml version="1.0" encoding="UTF-8"?>
<!-- Global GridFTP server configuration -->
<GridFTPConfig>
  <!-- PBS Job Manager polling setup for Globus GRAM -->
  <JobManager>
    <!-- Type of job manager; 'pbs_poll' enables polling-based PBS integration -->
    <Type>pbs_poll</Type>
    <!-- Full path to the PBS qstat command, used to query job status. -->
    <QstatPath>{{ qstat_path | default('/usr/bin/qstat') }}</QstatPath>
    <!-- Full path to the PBS qdel command, used to cancel jobs. -->
    <QdelPath>{{ qdel_path | default('/usr/bin/qdel') }}</QdelPath>
    <!-- Full path to the PBS qsub command, used to submit jobs. -->
    <QsubPath>{{ qsub_path | default('/usr/bin/qsub') }}</QsubPath>
    <!-- Interval (in seconds) between status polls for each job. -->
    <PollInterval>{{ poll_interval | default(30) }}</PollInterval>
    <!-- Maximum number of jobs that can be polled concurrently by the GridFTP server. -->
    <MaxConcurrentPolls>{{ max_concurrent_polls | default(100) }}</MaxConcurrentPolls>
    <!-- Enable verbose PBS output parsing for debugging (e.g., extended status fields). -->
    <VerboseOutput>{{ verbose_output | default(False) | lower }}</VerboseOutput>
    <!-- Preserve the working directory of a job after it completes (useful for post-mortem debugging). -->
    <PreserveWorkingDir>{{ preserve_working_dir | default(False) | lower }}</PreserveWorkingDir>
    <!-- List of environment variables to inject into PBS job scripts. -->
    <EnvVars>
{% for env in env_vars | default([]) %}      <Env name="{{ env.name | default('') }}">{{ env.value | default('') }}</Env>
{% endfor %}    </EnvVars>
  </JobManager>
  <!-- Queue assignment mode: use a single static queue, or dynamic per-user/group mapping. -->
{% if (queue_mode | default('static')) == 'static' %}
  <!-- PBS queue to use when queue_mode=static. -->
  <Queue>{{ queue_name | default('batch') }}</Queue>
{% elif (queue_mode | default('static')) == 'dynamic' %}
  <!-- List of queue mappings (only used when queue_mode=dynamic). -->
  <QueueMapping>
{% for mapping in queue_mappings | default([]) %}    <Entry user="{{ mapping.user | default('') }}" group="{{ mapping.group | default('') }}" type="{{ mapping.type | default('') }}">{{ mapping.queue | default('') }}</Entry>
{% endfor %}  </QueueMapping>
{% endif %}</GridFTPConfig>