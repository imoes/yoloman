{
  "debug": false,
  "log_dir": "/var/log/masakari/masakari-engine",
  "log_file": "masakari-engine.log",
  "api_bind_host": "0.0.0.0",
  "api_bind_port": 8080,
  "api_workers": 2,
  "auth_strategy": "keystone",
  "wsgi_config_path": "/etc/masakari/gunicorn.conf.py",
  "enable_cors": false,
  "cors_allowed_origins": [
    "https://horizon.example.com"
  ],
  "max_request_body_size": 10485760,
  "use_ssl": true,
  "cert_file": "/etc/ssl/certs/masakari.crt",
  "key_file": "/etc/ssl/private/masakari.key",
  "ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "health_check_path": "/healthcheck",
  "upstream_connect_timeout": 10,
  "upstream_max_connections": 200,
  "rate_limit_enabled": true,
  "rate_limit_requests_per_second": 20,
  "upstream_retry_delay": 200,
  "access_log": "/var/log/masakari/masakari-engine/access.log",
  "access_log_format": "%(h)s %(l)s %(u)s %(t)s \"%r\" %(s)s %(b)s",
  "pid_file": "/run/masakari/masakari-engine.pid",
  "keystone_auth_uri": "https://identity.example.com:5000/v3",
  "keystone_auth_url": "https://identity.example.com:35357/v3",
  "keystone_project_domain_name": "Default",
  "keystone_user_domain_name": "Default",
  "keystone_project_name": "service",
  "keystone_username": "masakari",
  "keystone_password": "masakari_secret_password",
  "keystone_region_name": "RegionOne",
  "keystone_insecure": false,
  "keystone_cafile": "/etc/ssl/certs/keystone-ca.pem",
  "keystone_certfile": "",
  "keystone_keyfile": ""
}
