# ============================================================
# apt-config-icons: DEP-11 Icons Download Configuration
# ============================================================
#
# Purpose:
#   Controls whether APT downloads DEP-11 icon metadata for
#   software centers (GNOME Software, KDE Plasma Discover, etc.).
#   Applications without icons may be hidden if downloads are disabled.
#
# Schema Fields:
#   - icons_small_enabled (bool/string): Enable small (64x64px) icon downloads.
#   - icons_full_enabled  (bool/string): Enable full-size icon downloads.
# ============================================================

## Enable downloading of small 64x64px DEP-11 icons for software centers.
## Defaults to 'true'. Set to 'false' to disable small icon retrieval.
Acquire::IndexTargets {
    deb::DEP-11-icons-small  {
        DefaultEnabled "{{ icons_small_enabled | default(true) }}";
    };
    ## Enable downloading of full-size DEP-11 icons for software centers.
    ## Defaults to 'true'. Set to 'false' to disable full icon retrieval.
    deb::DEP-11-icons  {
        DefaultEnabled "{{ icons_full_enabled | default(true) }}";
    };
};