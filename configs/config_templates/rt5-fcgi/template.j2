# Defaults for request-tracker5 FCGI service
# Sourced by /etc/init.d/rt5-fcgi (POSIX shell fragment)
#
# This file provides default values for the RT5 FastCGI service.
# Each variable is self-documented below. If a variable is not
# defined in the Ansible play or inventory, the schema default
# (shown in comments) is used automatically.

# Whether the RT5 FCGI service is enabled to start on boot.
# Supported values are '0' (disabled) or '1' (enabled).
# Default: 0
# Type: boolean/integer
enabled={{ enabled | default(0) }}

# Number of RT worker processes to spawn.
# Increasing this value may improve concurrency but consumes more memory.
# Must be a positive integer.
# Default: 2
# Type: integer
workers={{ workers | default(2) }}