{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "ssl_certificate": "/etc/ssl/certs/calypso.crt",
    "ssl_key": "/etc/ssl/private/calypso.key"
  },
  "storage": {
    "path": "/var/lib/calypso/repositories",
    "tmp_dir": "/var/lib/calypso/tmp",
    "auto_create": true,
    "git_template": "/etc/calypso/git-template"
  },
  "auth": {
    "method": "basic",
    "htpasswd_file": "/etc/calypso/htpasswd",
    "realm": "CalDAV/CardDAV",
    "ldap_enable": false,
    "ldap_uri": "",
    "ldap_base_dn": "",
    "ldap_user_filter": "(uid=%s)",
    "ldap_bind_dn": "",
    "ldap_bind_password": ""
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/calypso/calypso.log"
  },
  "paths": {
    "web_ui_path": "/calypso",
    "default_calendar": "calendar",
    "well_known": true
  },
  "repositories": [
    {
      "name": "alice",
      "user": "alice",
      "displayname": "Alice Smith",
      "path": "alice.git",
      "acl": "rw"
    },
    {
      "name": "bob",
      "user": "bob",
      "displayname": "Bob Jones",
      "path": "bob.git",
      "acl": "rw"
    },
    {
      "name": "public",
      "user": "nobody",
      "displayname": "Public Calendar",
      "path": "public.git",
      "acl": "ro"
    }
  ]
}
