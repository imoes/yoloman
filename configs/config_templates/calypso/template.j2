[server]
# Hostname or IP address the server listens on
host = {{ server.host }}

# Port the server listens on
port = {{ server.port }}

# Enable SSL (binary flag; certificate/key paths are handled via command-line args or internal defaults if not exposed in this config scope)
# Note: The man page indicates SSL is controlled via -s/--ssl and -k/--key/-c/--certificate flags.
# This template maps the available CLI options to config keys for consistency.
ssl_enabled = {{ server.ssl_enabled | lower }}

# SSL certificate file
ssl_certificate = {{ server.ssl_certificate | default('', true) }}

# SSL private key file
ssl_key = {{ server.ssl_key | default('', true) }}