# =============================================================================
# CRM114 Configuration Template
# =============================================================================
# This file configures the CRM114 (Cross-Platform Rule-based Machine-learning
# Network) spam filtering engine. It defines where data is stored, how messages
# are preprocessed, which classifier algorithms are used, and how results are
# formatted.
#
# SELF-DOCUMENTING: Every variable is documented with its source description
# and a safe default derived from the schema.
# =============================================================================

[general]

# Directory where CRM114 stores trained classifier data, dictionaries, and
# persistent state. This directory must be writable by the CRM114 process user.
data_dir = {{ data_dir | default('/var/lib/crm114') }}

# Path to the mailbox (e.g., Maildir, MBox) used for training or batch
# classification. Set to 'none' to disable batch training/spool processing.
mail_spool = {{ mail_spool | default('none') }}

# Enable detailed logging to aid debugging. Set to true only for
# troubleshooting; disable in production for performance and log hygiene.
debug = {{ debug | default(false) | lower }}

# Maximum memory (in MB) CRM114 may use. 0 means no limit. This acts as a
# safeguard against runaway memory consumption during large training batches.
max_memory = {{ max_memory | default(0) }}

[preprocessor]
# Ordered list of preprocessor filter paths (e.g., to strip HTML, decode MIME,
# normalize whitespace). Each item is a path to a preprocessor module or script.
{% for filter in preprocessors | default([]) %}
preprocessor = {{ filter }}
{% endfor %}

[classifier]
# Name of the core classifier algorithm to use (e.g., dispm, svm, bcl).
# 'dispm' is the default discriminative pattern matcher.
classifier = {{ classifier_name | default('dispm') }}

# Training mode — 'online' for incremental updates as new mail arrives,
# 'batch' for full retraining on a collected dataset.
training_method = {{ training_method | default('online') }}

# Minimum occurrence frequency for a token to be included in the model.
# Tokens appearing fewer times than this are ignored to reduce noise.
min_word_freq = {{ min_word_freq | default(2) }}

# Upper limit on the number of tokens the model will consider. Helps control
# model size and training time.
max_features = {{ max_features | default(10000) }}

# Probability threshold above which an email is classified as spam.
# Range is 0.0–1.0. Higher values mean fewer false positives but potentially
# more false negatives (spam getting through).
spam_threshold = {{ spam_threshold | default(0.95) }}

[discriminators]
# List of discriminator/filter names (e.g., 'word' = tokenization, 'bword' =
# bi-grams). These filters transform raw text before the classifier sees it.
{% for disc in discriminators | default(['word', 'bword']) %}
discriminator = {{ disc }}
{% endfor %}

[extensions]
# Optional CRM114 extension modules to enable (e.g., bayes, regexp).
# These extend the core engine with specialized handling capabilities.
{% for ext in extensions | default([]) %}
extension = {{ ext }}
{% endfor %}

[output]
# Output format for classification results. Common values include 'mail'
# (modified message headers/body), 'text' (simple status string), or 'json'.
output_format = {{ output_format | default('mail') }}

# When true, append X-CRM114-Status and related headers to classified messages.
# Useful for mail servers that need to inspect classification metadata.
add_headers = {{ add_headers | default(false) | lower }}