{
  "data_dir": "/var/lib/crm114",
  "mail_spool": "/var/spool/mail/samples",
  "debug": true,
  "max_memory": 256,
  "preprocessors": [
    "/usr/lib/crm114/preproc/html_strip",
    "/usr/lib/crm114/preproc/mime_decode"
  ],
  "classifier_name": "dispm",
  "training_method": "online",
  "min_word_freq": 2,
  "max_features": 8000,
  "spam_threshold": 0.92,
  "discriminators": [
    "word",
    "bword",
    "regexp"
  ],
  "extensions": [
    "bayes"
  ],
  "output_format": "json",
  "add_headers": true
}
