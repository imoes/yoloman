{
  "debug_mode": true,
  "vid_pid_filter": "",
  "image_dir": "/opt/rockchip/images",
  "operations": [
    {
      "command": "list"
    },
    {
      "command": "test-device"
    },
    {
      "command": "write-partition",
      "args": [
        "uboot",
        "u-boot.bin"
      ],
      "output_file": "write_uboot.log"
    },
    {
      "command": "boot",
      "args": [
        "uImage"
      ]
    }
  ],
  "operation_delay_seconds": 2,
  "verbose": true
}
