{
  "fai_config_dir": "/srv/fai/config",
  "fai_root_dir": "/srv/fai/root",
  "fai_log_dir": "/var/log/fai",
  "fai_debootstrap_dir": "/srv/fai/debootstrap",
  "default_arch": "amd64",
  "tftp_root": "/srv/tftp",
  "tftp_server": "",
  "dhcp_method": "isc-dhcpd",
  "dhcp_conf_path": "/etc/dhcp/dhcpd.conf",
  "dns_domain": "prod.example.com",
  "nameservers": [
    "10.0.0.10",
    "10.0.0.11"
  ],
  "gateway": "10.0.0.1",
  "ntp_server": "ntp.example.com",
  "enable_raid": true,
  "enable_lvm": true,
  "kernel_packages": [
    "linux-image-amd64",
    "linux-headers-amd64"
  ],
  "initramfs_options": [
    "-u",
    "-k",
    "all"
  ],
  "ssh_root_keys": [
    "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ... admin@jumpbox"
  ],
  "extra_env_vars": [
    {
      "name": "DEBIAN_FRONTEND",
      "value": "noninteractive"
    },
    {
      "name": "FAI_ACTION",
      "value": "install"
    }
  ],
  "loglevel": "info",
  "max_log_size": 50,
  "enable_status_monitor": true,
  "status_port": 8081,
  "extra_repositories": [
    "http://deb.debian.org/debian-security"
  ],
  "base_packages": [
    "openssh-server",
    "sudo",
    "curl",
    "wget"
  ],
  "timezone": "Europe/Berlin",
  "locale": "de_DE.UTF-8",
  "hostname_prefix": "srv",
  "domain_suffix": "prod.example.com",
  "auto_partition": true,
  "partition_layout": "single-disk",
  "enable_luks": false,
  "luks_passphrase": "",
  "swap_size": 4096,
  "root_fs_type": "ext4",
  "install_grub": true,
  "grub_device": ""
}
