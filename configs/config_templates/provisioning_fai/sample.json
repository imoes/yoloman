{
 "auto_partition": true,
 "base_packages": [
  "openssh-server",
  "sudo",
  "curl",
  "wget"
 ],
 "default_arch": "amd64",
 "dhcp_conf_path": "/etc/dhcp/dhcpd.conf",
 "dhcp_method": "isc-dhcpd",
 "dns_domain": "prod.example.com",
 "domain_suffix": "prod.example.com",
 "enable_luks": false,
 "enable_lvm": true,
 "enable_raid": true,
 "enable_status_monitor": true,
 "extra_env_vars": [
  {
   "name": "DEBIAN_FRONTEND",
   "value": "noninteractive"
  },
  {
   "name": "FAI_ACTION",
   "value": "install"
  }
 ],
 "extra_repositories": [
  "http://deb.debian.org/debian-security"
 ],
 "fai_config_dir": "/srv/fai/config",
 "fai_debootstrap_dir": "/srv/fai/debootstrap",
 "fai_log_dir": "/var/log/fai",
 "fai_root_dir": "/srv/fai/root",
 "gateway": "10.0.0.1",
 "grub_device": "",
 "hostname_prefix": "srv",
 "initramfs_options": [
  "-u",
  "-k",
  "all"
 ],
 "install_grub": true,
 "kernel_packages": [
  "linux-image-amd64",
  "linux-headers-amd64"
 ],
 "locale": "de_DE.UTF-8",
 "loglevel": "info",
 "luks_passphrase": "",
 "max_log_size": 50,
 "nameservers": [
  "10.0.0.10",
  "10.0.0.11"
 ],
 "ntp_server": "ntp.example.com",
 "partition_layout": "single-disk",
 "root_fs_type": "ext4",
 "ssh_root_keys": [
  "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ... admin@jumpbox"
 ],
 "status_port": 8081,
 "swap_size": 4096,
 "tftp_root": "/srv/tftp",
 "tftp_server": "",
 "timezone": "Europe/Berlin"
}
