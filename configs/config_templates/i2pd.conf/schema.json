{
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Logging verbosity: error, warn, info, debug, trace",
    "enum": [
      "error",
      "warn",
      "info",
      "debug",
      "none"
    ]
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/i2pd/i2pd.log",
    "description": "Path to log file"
  },
  "host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Bind host for I2P router (e.g., 0.0.0.0 for all interfaces)"
  },
  "port": {
    "type": "number",
    "default": 4444,
    "description": "Port for I2P router (NTCP/SSU)"
  },
  "max_connections": {
    "type": "number",
    "default": 128,
    "description": "Maximum simultaneous network connections"
  },
  "tunnel_build_timeout": {
    "type": "number",
    "default": 10,
    "description": "Timeout (in seconds) for tunnel build attempts"
  },
  "outbound_bandwidth": {
    "type": "number",
    "default": 1024,
    "description": "Outbound bandwidth limit in KB/s"
  },
  "inbound_bandwidth": {
    "type": "number",
    "default": 1024,
    "description": "Inbound bandwidth limit in KB/s (share for transit)"
  },
  "tunnel_gateways": {
    "type": "number",
    "default": 3,
    "description": "Number of gateway routers per tunnel"
  },
  "tunnel_hops": {
    "type": "number",
    "default": 2,
    "description": "Number of hops in each tunnel (0 = un-anonymized)"
  },
  "tunnel_length": {
    "type": "number",
    "default": 3,
    "description": "Length of tunnel (in hops, overrides 'hops' for\u65b0\u5efa)"
  },
  "tunnel_quantity": {
    "type": "number",
    "default": 1,
    "description": "Number of tunnels to build at once"
  },
  "share_ratio": {
    "type": "number",
    "default": 80,
    "description": "Bandwidth sharing percentage (0\u2013100); higher = more transit participation"
  },
  "daemon_mode": {
    "type": "bool",
    "default": true,
    "description": "Run I2PD as a background daemon"
  },
  "enable_ssdp": {
    "type": "bool",
    "default": true,
    "description": "Enable SSDP to discover UPnP/NAT-PMP devices"
  },
  "enable_upnp": {
    "type": "bool",
    "default": true,
    "description": "Enable automatic NAT-PMP/UPnP port mapping"
  },
  "data_dir": {
    "type": "string",
    "default": "/var/lib/i2pd",
    "description": "Directory for persistent data (keys, tunnels, etc.)"
  },
  "conf_dir": {
    "type": "string",
    "default": "/etc/i2pd",
    "description": "Directory for config and profile files"
  },
  "enable_webconsole": {
    "type": "bool",
    "default": false,
    "description": "Enable the web-based admin console"
  },
  "webconsole_host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Bind host for the webconsole"
  },
  "webconsole_port": {
    "type": "number",
    "default": 7070,
    "description": "Port for the webconsole"
  },
  "webconsole_auth": {
    "type": "string",
    "default": "user:pass",
    "description": "HTTP basic auth credentials as 'username:password'"
  },
  "webconsole_cert": {
    "type": "string",
    "default": "/etc/i2pd/webconsole.crt",
    "description": "Path to TLS certificate for HTTPS webconsole"
  },
  "webconsole_key": {
    "type": "string",
    "default": "/etc/i2pd/webconsole.key",
    "description": "Path to TLS private key for HTTPS webconsole"
  },
  "enable_fees": {
    "type": "bool",
    "default": true,
    "description": "Enable fee-based tunnel prioritization (requires fees.conf)"
  },
  "addressbook_urls": {
    "type": "list",
    "default": [
      "http://stats.i2p/cgi-bin/newbase60.pl",
      "http://i2p.mooo.com/netdb/"
    ],
    "description": "List of address book publisher URLs"
  },
  "transit_enabled": {
    "type": "bool",
    "default": true,
    "description": "Allow routing of I2P traffic for other users"
  },
  "transit_tunnels": {
    "type": "number",
    "default": 40,
    "description": "Maximum number of transit tunnels to maintain"
  },
  "enable_ntcp": {
    "type": "bool",
    "default": true,
    "description": "Enable legacy NTCP transport"
  },
  "enable_ssu": {
    "type": "bool",
    "default": true,
    "description": "Enable SSU transport (recommended)"
  },
  "enable_ntcp2": {
    "type": "bool",
    "default": true,
    "description": "Enable NTCP2 transport (future-proof)"
  },
  "services": {
    "type": "list",
    "default": [],
    "description": "List of local I2P services to expose (e.g., HTTP, IRC, SSH)",
    "items": {
      "name": {
        "type": "string",
        "description": "Service identifier (e.g., 'i2pcontrol', 'webserver', 'irc')"
      },
      "description": {
        "type": "string",
        "description": "Human-readable service description"
      },
      "port": {
        "type": "number",
        "description": "Local port the service listens on"
      },
      "host": {
        "type": "string",
        "default": "127.0.0.1",
        "description": "Local host to bind to"
      },
      "inbound_length": {
        "type": "number",
        "default": 2,
        "description": "Inbound tunnel length (overriding global)"
      },
      "outbound_length": {
        "type": "number",
        "default": 2,
        "description": "Outbound tunnel length"
      },
      "inbound_quantity": {
        "type": "number",
        "default": 3,
        "description": "Number of inbound tunnels"
      },
      "outbound_quantity": {
        "type": "number",
        "default": 3,
        "description": "Number of outbound tunnels"
      },
      "private_key_path": {
        "type": "string",
        "description": "Path to private key file (if static destination)"
      }
    }
  }
}
