{
  "log_level": "info",
  "log_file": "/var/log/i2pd/i2pd.log",
  "host": "127.0.0.1",
  "port": 4444,
  "max_connections": 128,
  "tunnel_build_timeout": 10,
  "outbound_bandwidth": 1024,
  "inbound_bandwidth": 1024,
  "tunnel_gateways": 3,
  "tunnel_hops": 2,
  "tunnel_length": 3,
  "tunnel_quantity": 1,
  "share_ratio": 80,
  "daemon_mode": true,
  "enable_ssdp": true,
  "enable_upnp": true,
  "data_dir": "/var/lib/i2pd",
  "conf_dir": "/etc/i2pd",
  "enable_webconsole": false,
  "webconsole_host": "127.0.0.1",
  "webconsole_port": 7070,
  "webconsole_auth": "user:pass",
  "webconsole_cert": "/etc/i2pd/webconsole.crt",
  "webconsole_key": "/etc/i2pd/webconsole.key",
  "enable_fees": true,
  "addressbook_urls": [
    "http://stats.i2p/cgi-bin/newbase60.pl",
    "http://i2p.mooo.com/netdb/"
  ],
  "transit_enabled": true,
  "transit_tunnels": 40
}
