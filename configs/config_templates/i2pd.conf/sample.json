{
  "log_level": "info",
  "log_file": "/var/log/i2pd/i2pd.log",
  "host": "0.0.0.0",
  "port": 4444,
  "max_connections": 256,
  "tunnel_build_timeout": 15,
  "outbound_bandwidth": 512,
  "inbound_bandwidth": 512,
  "tunnel_gateways": 3,
  "tunnel_hops": 2,
  "tunnel_length": 3,
  "tunnel_quantity": 3,
  "share_ratio": 90,
  "daemon_mode": true,
  "enable_ssdp": true,
  "enable_upnp": true,
  "data_dir": "/var/lib/i2pd",
  "conf_dir": "/etc/i2pd",
  "enable_webconsole": true,
  "webconsole_host": "127.0.0.1",
  "webconsole_port": 7070,
  "webconsole_auth": "admin:i2pwd",
  "webconsole_cert": "",
  "webconsole_key": "",
  "enable_fees": true,
  "addressbook_urls": [
    "http://stats.i2p/cgi-bin/newbase60.pl",
    "http://i2p.mooo.com/netdb/",
    "https://i2pwiki.xenrox.net/static/netdb/"
  ],
  "transit_enabled": true,
  "transit_tunnels": 60,
  "enable_ntcp": true,
  "enable_ssu": true,
  "enable_ntcp2": true,
  "services": [
    {
      "name": "i2pcontrol",
      "description": "I2P Control API",
      "port": 7657,
      "host": "127.0.0.1",
      "inbound_length": 2,
      "outbound_length": 2,
      "inbound_quantity": 2,
      "outbound_quantity": 2,
      "private_key_path": "/var/lib/i2pd/tunnels.d/i2pcontrol.priv"
    },
    {
      "name": "webserver",
      "description": "Local HTTP server via I2P",
      "port": 8080,
      "host": "127.0.0.1",
      "inbound_length": 3,
      "outbound_length": 3,
      "inbound_quantity": 2,
      "outbound_quantity": 2,
      "private_key_path": "/var/lib/i2pd/tunnels.d/webserver.priv"
    }
  ]
}
