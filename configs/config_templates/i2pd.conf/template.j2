## Configuration file for a typical i2pd user
## See https://i2pd.readthedocs.io/en/latest/user-guide/configuration/
## for more options you can use in this file.

## Lines that begin with "## " try to explain what's going on. Lines
## that begin with just "#" are disabled commands: you can enable them
## by removing the "#" symbol.

## Tunnels config file
## Default: ~/.i2pd/tunnels.conf or /var/lib/i2pd/tunnels.conf
# tunconf = /var/lib/i2pd/tunnels.conf

## Tunnels config files path
## Use that path to store separated tunnels in different config files.
## Default: ~/.i2pd/tunnels.d or /var/lib/i2pd/tunnels.d
# tunnelsdir = /var/lib/i2pd/tunnels.d

## Path to certificates used for verifying .su3, families
## Default: ~/.i2pd/certificates or /var/lib/i2pd/certificates
# certsdir = /var/lib/i2pd/certificates

## Where to write pidfile (default: /run/i2pd.pid, not used in Windows)
# pidfile = /run/i2pd.pid

## Logging configuration section
## By default logs go to stdout with level 'info' and higher
## For Windows OS by default logs go to file with level 'warn' and higher
##
## Logs destination (valid values: stdout, file, syslog)
##  * stdout - print log entries to stdout
##  * file - log entries to a file
##  * syslog - use syslog, see man 3 syslog
# log = file
## Path to logfile
{% if log_file is defined and log_file is not none and (log_file is number or log_file is boolean or log_file | length > 0) %}logfile = {{ log_file | default('/var/log/i2pd/i2pd.log') }}
{% else %}# logfile = /var/log/i2pd/i2pd.log
{% endif %}## Log messages above this level
{% if log_level is defined and log_level is not none and (log_level is number or log_level is boolean or log_level | length > 0) %}loglevel = {{ log_level | default('warn') }}
{% else %}# loglevel = warn
{% endif %}## Write full CLF-formatted date and time to log
# logclftime = true

## Daemon mode
{% if daemon_mode is defined and daemon_mode is not none and (daemon_mode is number or daemon_mode is boolean or daemon_mode | length > 0) %}daemon = {{ daemon_mode | default('true') }}
{% else %}# daemon = true
{% endif %}
## Specify a family
# family =

## Network interface to bind to
# ifname =
# ifname4 =
# ifname6 =

## Local address to bind transport sockets to
# address4 =
# address6 =

## External IPv4 or IPv6 address to listen for connections
{% if host is defined and host is not none and (host is number or host is boolean or host | length > 0) %}host = {{ host | default('1.2.3.4') }}
{% else %}# host = 1.2.3.4
{% endif %}
## Port to listen for connections
# port = {{ port | default(4444) }}

## Enable communication through ipv4
ipv4 = true
## Enable communication through ipv6
ipv6 = false

## Bandwidth configuration
## L limit bandwidth to 32 KB/sec, O - to 256 KB/sec, P - to 2048 KB/sec,
## X - unlimited
## Default is L (regular node) and X if floodfill mode enabled.
# bandwidth = L
## Max % of bandwidth limit for transit
{% if share_ratio is defined and share_ratio is not none and (share_ratio is number or share_ratio is boolean or share_ratio | length > 0) %}share = {{ share_ratio | default('100') }}
{% else %}# share = 100
{% endif %}
## Router will not accept transit tunnels
{% if transit_enabled is defined and transit_enabled is not none and (transit_enabled is number or transit_enabled is boolean or transit_enabled | length > 0) %}notransit = {{ transit_enabled | default(True) | ternary('false', 'true') }}
{% else %}# notransit = true
{% endif %}
## Router will be floodfill
# floodfill = true

[ntcp2]
## Enable NTCP2 transport
# enabled = true
## Publish address in RouterInfo
# published = true
## Port for incoming connections
# port = {{ port | default(4444) }}

[ssu2]
## Enable SSU2 transport
# enabled = true
## Publish address in RouterInfo
# published = true
## Port for incoming connections
# port = {{ port | default(4444) }}

[http]
## Web Console settings
## Enable the Web Console
# enabled = {{ enable_webconsole | default('true') }}
## Address and port service will listen on
# address = {{ webconsole_host | default('127.0.0.1') }}
# port = {{ webconsole_port | default(7070) }}
## Path to web console
# webroot = /
## Enable Web Console authentication
{% if enable_webconsole is defined and enable_webconsole is not none and (enable_webconsole is number or enable_webconsole is boolean or enable_webconsole | length > 0) %}auth = {{ enable_webconsole | default('true') }}
{% else %}# auth = true
{% endif %}## HTTP basic auth credentials (format: username:password)
{% if webconsole_auth is defined and webconsole_auth is not none and (webconsole_auth is number or webconsole_auth is boolean or webconsole_auth | length > 0) %}user = {{ webconsole_auth | default('user:pass') | regex_replace('^([^:]*):.*$', '\\1') }}
{% else %}# user = i2pd
{% endif %}{% if webconsole_auth is defined and webconsole_auth is not none and (webconsole_auth is number or webconsole_auth is boolean or webconsole_auth | length > 0) %}pass = {{ webconsole_auth | default('user:pass') | regex_replace('^[^:]*:(.*)$', '\\1') }}
{% else %}# pass = changeme
{% endif %}## Select webconsole language
# lang = english

[httpproxy]
## Enable the HTTP proxy
# enabled = true
## Address and port service will listen on
# address = 127.0.0.1
# port = 4444
## Optional keys file for proxy local destination
# keys = http-proxy-keys.dat
## Enable address helper for adding .i2p domains with "jump URLs"
# addresshelper = true
## Address of a proxy server inside I2P
# outproxy = http://false.i2p

[socksproxy]
## Enable the SOCKS proxy
# enabled = true
## Address and port service will listen on
# address = 127.0.0.1
# port = 4447
## Optional keys file for proxy local destination
# keys = socks-proxy-keys.dat
## Enable using of SOCKS outproxy
# outproxy.enabled = false
## Address and port of outproxy
# outproxy = 127.0.0.1
# outproxyport = 9050

[sam]
## Enable the SAM bridge
# enabled = false
## Address and ports service will listen on
# address = 127.0.0.1
# port = 7656
# portudp = 7655

[bob]
## Enable the BOB command channel
# enabled = false
## Address and port service will listen on
# address = 127.0.0.1
# port = 2827

[i2cp]
## Enable the I2CP protocol
# enabled = false
## Address and port service will listen on
# address = 127.0.0.1
# port = 7654

[i2pcontrol]
## Enable the I2PControl protocol
# enabled = false
## Address and port service will listen on
# address = 127.0.0.1
# port = 7650
## Authentication password
# password = itoopie

[precomputation]
## Enable or disable elgamal precomputation table
# elgamal = true

[upnp]
## Enable or disable UPnP
# enabled = {{ enable_upnp | default(True) }}
## Name i2pd appears in UPnP forwardings list
# name = I2Pd

[meshnets]
## Enable connectivity over the Yggdrasil network
# yggdrasil = false
## You can bind address from your Yggdrasil subnet
# yggaddress =

[reseed]
## Options for bootstrapping into I2P network
## Enable reseed data verification
verify = true
## URLs to request reseed data from
# urls = https://reseed.i2p-projekt.de/,https://i2p.mooo.com/netDb/,https://netdb.i2p2.no/
## Reseed URLs through the Yggdrasil
# yggurls = http://[324:71e:281a:9ed3::ace]:7070/
## Path to local reseed data file (.su3) for manual reseeding
# file = /path/to/i2pseeds.su3
## or HTTPS URL to reseed from
# file = https://legit-website.com/i2pseeds.su3
## Path to local ZIP file or HTTPS URL to reseed from
# zipfile = /path/to/netDb.zip
## If you run i2pd behind a proxy server, set proxy server for reseeding here
# proxy = http://127.0.0.1:8118
## Minimum number of known routers, below which i2pd triggers reseeding
# threshold = 25

[addressbook]
## AddressBook subscription URL for initial setup
## Optional subscriptions URLs, separated by comma
{% if addressbook_urls is defined and addressbook_urls is not none and (addressbook_urls is number or addressbook_urls is boolean or addressbook_urls | length > 0) %}subscriptions = {{ addressbook_urls | default(['http://stats.i2p/cgi-bin/newbase60.pl', 'http://i2p.mooo.com/netdb/']) | join(',') }}
{% else %}# subscriptions = http://reg.i2p/hosts.txt,http://identiguy.i2p/hosts.txt,http://stats.i2p/cgi-bin/newhosts.txt
{% endif %}
[limits]
## Maximum active transit sessions
{% if transit_tunnels is defined and transit_tunnels is not none and (transit_tunnels is number or transit_tunnels is boolean or transit_tunnels | length > 0) %}transittunnels = {{ transit_tunnels | default('5000') }}
{% else %}# transittunnels = 5000
{% endif %}## Limit number of open file descriptors
# openfiles = 0
## Maximum size of corefile in Kb
# coresize = 0

[trust]
## Enable explicit trust options
# enabled = true
## Make direct I2P connections only to routers in specified Family
# family = MyFamily
## Make direct I2P connections only to routers specified here
# routers =
## Should we hide our router from other routers
# hidden = true

[exploratory]
## Exploratory tunnels settings with default values
{% if tunnel_hops is defined and tunnel_hops is not none and (tunnel_hops is number or tunnel_hops is boolean or tunnel_hops | length > 0) %}inbound.length = {{ tunnel_hops | default('2') }}
{% else %}# inbound.length = 2
{% endif %}{% if tunnel_quantity is defined and tunnel_quantity is not none and (tunnel_quantity is number or tunnel_quantity is boolean or tunnel_quantity | length > 0) %}inbound.quantity = {{ tunnel_quantity | default('3') }}
{% else %}# inbound.quantity = 3
{% endif %}{% if tunnel_hops is defined and tunnel_hops is not none and (tunnel_hops is number or tunnel_hops is boolean or tunnel_hops | length > 0) %}outbound.length = {{ tunnel_hops | default('2') }}
{% else %}# outbound.length = 2
{% endif %}{% if tunnel_quantity is defined and tunnel_quantity is not none and (tunnel_quantity is number or tunnel_quantity is boolean or tunnel_quantity | length > 0) %}outbound.quantity = {{ tunnel_quantity | default('3') }}
{% else %}# outbound.quantity = 3
{% endif %}
[persist]
## Save peer profiles on disk
# profiles = true
## Save full addresses on disk
# addressbook = true
