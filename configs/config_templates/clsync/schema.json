{
  "clsync_enable": {
    "type": "bool",
    "default": false,
    "description": "Whether clsync is enabled (true/false)."
  },
  "clsync_ionice_class": {
    "type": "string",
    "default": "3",
    "description": "ionice class for clsync (0=none, 1=realtime, 2=best-effort, 3=idle).\", \"enum\": [\"0\", \"1\", \"2\", \"3\"]",
    "enum": [
      "0",
      "1",
      "2",
      "3"
    ]
  },
  "clsync_args": {
    "type": "string",
    "default": "-M rsyncdirect --output=syslog -L /dev/shm/clsync -x 23 -W /var/www -S /usr/bin/rsync -D /mnt/backup",
    "description": "Command-line arguments passed to clsync in non-systemd mode."
  },
  "clsync_args_systemd": {
    "type": "string",
    "default": "-b0 -Ystderr",
    "description": "Command-line arguments passed to clsync in systemd mode."
  }
}
