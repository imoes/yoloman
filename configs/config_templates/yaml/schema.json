{
  "renderer": {
    "type": "string",
    "default": "networkd",
    "description": "Network backend: 'networkd' (default) or 'NetworkManager'"
  },
  "ethernets": {
    "type": "object",
    "default": {},
    "description": "Ethernet interface configurations keyed by interface name",
    "items": {
      "type": "object",
      "fields": {
        "dhcp4": {
          "type": "boolean",
          "default": false,
          "description": "Enable IPv4 DHCP on this interface"
        },
        "dhcp6": {
          "type": "boolean",
          "default": false,
          "description": "Enable IPv6 DHCP on this interface"
        },
        "addresses": {
          "type": "list",
          "default": [],
          "description": "Static IP addresses (CIDR notation)",
          "items": {
            "type": "string"
          }
        },
        "gateway4": {
          "type": "string",
          "default": "",
          "description": "IPv4 default gateway"
        },
        "gateway6": {
          "type": "string",
          "default": "",
          "description": "IPv6 default gateway"
        },
        "nameservers": {
          "type": "object",
          "default": {},
          "description": "DNS resolver settings",
          "items": {
            "type": "object",
            "fields": {
              "addresses": {
                "type": "list",
                "default": [],
                "items": {
                  "type": "string"
                },
                "description": "List of DNS server IPs"
              },
              "search": {
                "type": "list",
                "default": [],
                "items": {
                  "type": "string"
                },
                "description": "DNS search domains"
              }
            }
          }
        },
        "mtu": {
          "type": "number",
          "default": 1500,
          "description": "Maximum transmission unit (bytes)"
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "If true, ignore this interface if missing"
        },
        "link-local": {
          "type": "list",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Link-local address types (e.g., 'ipv4', 'ipv6')"
        },
        "accept-ra": {
          "type": "boolean",
          "default": false,
          "description": "Accept IPv6 router advertisements (requires ipv6)"
        },
        "wake-on-lan": {
          "type": "boolean",
          "default": false,
          "description": "Enable Wake-on-LAN for this interface"
        }
      }
    }
  },
  "wifis": {
    "type": "object",
    "default": {},
    "description": "WiFi interface configurations keyed by interface name",
    "items": {
      "type": "object",
      "fields": {
        "access-points": {
          "type": "object",
          "default": {},
          "description": "SSID definitions for this interface",
          "items": {
            "type": "object",
            "fields": {
              "password": {
                "type": "string",
                "default": "",
                "description": "WPA/WPA2 passphrase or WEP key"
              },
              "hidden": {
                "type": "boolean",
                "default": false,
                "description": "Whether the SSID is hidden"
              },
              "mode": {
                "type": "string",
                "default": "infrastructure",
                "description": "Mode: 'infrastructure' (default), 'ap', or 'adhoc'"
              },
              "band": {
                "type": "string",
                "default": "any",
                "description": "Radio band: '2.4', '5', or 'any'"
              },
              "channel": {
                "type": "number",
                "default": 0,
                "description": "Explicit channel number (0 = auto)"
              },
              "bssid": {
                "type": "string",
                "default": "",
                "description": "Optional BSSID (MAC address) to associate with"
              },
              "dhcp4": {
                "type": "boolean",
                "default": true,
                "description": "Use IPv4 DHCP (if not using static addresses)"
              },
              "addresses": {
                "type": "list",
                "default": [],
                "items": {
                  "type": "string"
                },
                "description": "Static IP addresses for this AP"
              },
              "gateway4": {
                "type": "string",
                "default": "",
                "description": "IPv4 gateway for this AP"
              },
              "nameservers": {
                "type": "object",
                "default": {},
                "description": "DNS settings for this AP (same schema as ethernets)",
                "items": {
                  "type": "object",
                  "fields": {}
                }
              }
            }
          }
        }
      },
      "dhcp4": {
        "type": "boolean",
        "default": true,
        "description": "Fallback IPv4 DHCP for all APs on this interface"
      },
      "dhcp6": {
        "type": "boolean",
        "default": false,
        "description": "Fallback IPv6 DHCP for all APs on this interface"
      }
    }
  }
}
