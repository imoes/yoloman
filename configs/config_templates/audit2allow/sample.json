{
  "audit_rules": [
    "# Record attempts to modify user/group files",
    "-a always,exit -F path=/etc/passwd -F perm=w",
    "-a always,exit -F path=/etc/group -F perm=w",
    "# Monitor use of sudo",
    "-a always,exit -F path=/usr/bin/sudo -F perm=x",
    "# Log all program executions",
    "-a always,exit -F arch=b64 -S execve",
    "# Exclude common false positives (optional)",
    "# -a exclude,always -F msgtype=SYSCALL -S all -F exe=/usr/bin/whoami"
  ]
}
