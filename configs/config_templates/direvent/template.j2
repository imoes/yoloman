# This is the configuration file for direvent. Read
# direvent.conf(5) for more information about how to
# fill this file. 

# The following block statement declares a watcher
#watcher {
#    path pathname [recursive [level]];
#    file pattern-list;
#    event  event-list;
#    command command-line;
#    user name;
#    timeout number;
#    environ env-spec;
#    option string-list;
#}

# An example of use where test.sh has:
# #!/bin/bash
# /bin/echo "Hello, this is a test of direvent" > /tmp/test.txt

#watcher {
#    path /home/user;
#    event create;
#    command "/tmp/test.sh";
#}

{# direvent 5.2 exits with SIGSEGV when no watcher is declared — the shipped file declares none.
   A watcher is a site's own decision (which path, which command), so the default list is empty. #}{% for w in watchers | default([]) %}
watcher {
    path {{ w.path }}{% if w.recursive is defined and w.recursive | bool %} recursive{% if w.level is defined and w.level is not none and w.level != '' %} {{ w.level }}{% endif %}{% endif %};
{% if w.file is defined and w.file is not none and w.file != '' %}    file {{ w.file }};
{% endif %}    event {{ w.event | default('create') }};
    command "{{ w.command }}";
{% if w.user is defined and w.user is not none and w.user != '' %}    user {{ w.user }};
{% endif %}{% if w.timeout is defined and w.timeout is not none and w.timeout != '' %}    timeout {{ w.timeout }};
{% endif %}}
{% endfor %}