# Main configuration for OpenOverlayRouter (OVR)
# Defines global settings, node roles, and network topology

[global]
# Node identifier (must be unique across the overlay)
node_id = {{ node_id }}

# Log level: debug, info, warn, error
log_level = {{ log_level }}

# Path to the state directory (persists overlay topology, routes, keys)
state_dir = {{ state_dir }}

# Path to the certificate directory
# Certificates used for node authentication and encryption
cert_dir = {{ cert_dir }}

# Interval (seconds) between heartbeats to detect node liveness
heartbeat_interval = {{ heartbeat_interval }}

# Time (seconds) before a node is considered dead if no heartbeat received
heartbeat_timeout = {{ heartbeat_timeout }}

# Enable or disable encryption for overlay traffic
encrypt_traffic = {{ encrypt_traffic | lower }}

# Path to the ECDSA private key file (for signing overlay messages)
private_key_file = {{ private_key_file }}

# Path to the trusted CA certificate file
ca_cert_file = {{ ca_cert_file }}

[overlay]
# Overlay name (used for multi-tenant or segmented overlays)
name = {{ overlay_name }}

# Overlay type: e.g., 'mesh', 'star', 'hybrid'
type = {{ overlay_type }}

# MTU for overlay tunnel traffic (must be ≤ underlay MTU)
mtu = {{ overlay_mtu }}

# Enable or disable automatic route learning (BGP-like topology discovery)
auto_discover = {{ auto_discover | lower }}

# List of static overlay peers (explicit connections, bypassing auto-discovery)
{% for peer in peers %}
[overlay.peer.{{ loop.index }}]
# Static peer address (hostname or IP)
address = {{ peer.address }}
# Static peer port
port = {{ peer.port }}
# Optional role: 'hub', 'spoke', 'gateway' (used in hybrid topologies)
{% if peer.role %}role = {{ peer.role }}{% else %}# (no role specified, defaults to 'spoke'){% endif %}
{% endfor %}

[interfaces]
# Local network interface to bind the overlay control plane
tunnel_interface = {{ tunnel_interface }}

# Underlay interface (used for overlay traffic encapsulation)
underlay_interface = {{ underlay_interface }}

# Underlay IP address used as source for overlay packets
underlay_ip = {{ underlay_ip }}

# Underlay subnet (CIDR notation) for local segment
underlay_subnet = {{ underlay_subnet }}

# Enable or disable IPv6 overlay support
ipv6_enabled = {{ ipv6_enabled | lower }}

# Optional: Local service endpoints (for gateway nodes)
{% if services %}[services]
{% for svc in services %}
# Service: {{ svc.name }}
service_{{ loop.index }} = {{ svc.name }} {{ svc.port }} {{ svc.protocol }}
{% endfor %}
{% endif %}
