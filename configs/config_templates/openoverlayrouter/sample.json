{
  "node_id": "ovr-edge-sfo01",
  "log_level": "info",
  "state_dir": "/var/lib/openoverlayrouter/state",
  "cert_dir": "/etc/openoverlayrouter/certs",
  "heartbeat_interval": 5,
  "heartbeat_timeout": 15,
  "encrypt_traffic": true,
  "private_key_file": "/etc/openoverlayrouter/certs/edge-sfo01.key",
  "ca_cert_file": "/etc/openoverlayrouter/certs/ca.crt",
  "overlay_name": "production-overlay",
  "overlay_type": "hybrid",
  "overlay_mtu": 1400,
  "auto_discover": true,
  "peers": [
    {
      "address": "hub-ny01.example.com",
      "port": 60001,
      "role": "hub"
    },
    {
      "address": "hub-lon01.example.com",
      "port": 60001,
      "role": "hub"
    }
  ],
  "tunnel_interface": "ovr0",
  "underlay_interface": "eth0",
  "underlay_ip": "192.168.10.5",
  "underlay_subnet": "192.168.10.0/24",
  "ipv6_enabled": false,
  "services": [
    {
      "name": "api-gateway",
      "port": 8080,
      "protocol": "tcp"
    },
    {
      "name": "dns-resolver",
      "port": 53,
      "protocol": "udp"
    }
  ]
}
