<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
    <!--
      Font configuration for Amiri Quran Colored.
      This template configures font aliasing so that applications requesting 'serif'
      text prefer the 'Amiri Quran Colored' font, falling back to a generic serif stack.
    -->

    <!-- Alias 1: Redirect generic 'serif' requests to the preferred colored font -->
    <alias>
        <!-- The font family name to which other families should refer -->
        <family>serif</family>
        <!-- The preferred font family to use instead -->
        <prefer>
            <!-- Primary font family to prefer for serif text. Defaults to 'Amiri Quran Colored' -->
            <family>{{ primary_font_family | default('Amiri Quran Colored') }}</family>
        </prefer>
    </alias>

    <!-- Alias 2: Define fallback behavior for the preferred font itself -->
    <alias>
        <!-- The font family that needs a fallback definition -->
        <family>{{ primary_font_family | default('Amiri Quran Colored') }}</family>
        <!-- The fallback font family to use when the primary font is unavailable -->
        <default>
            <family>{{ fallback_font_family | default('serif') }}</family>
        </default>
    </alias>
</fontconfig>
