# Configuration for gpw — generate pronounceable passwords
#
# This template configures the `gpw` (generate pronounceable passwords) utility.
# It defines how many passwords to generate and their character length.

# Number of passwords to generate; must be ≥ 1.
# Default: 10
{{ number_of_passwords | default(10) }}

# Length of each password (1–99); use ≥ 8 for MD5, ≥ 8 for DES per manual.
# Default: 8
{{ length_of_passwords | default(8) }}