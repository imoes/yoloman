{
  "base_dir": {
    "type": "string",
    "default": "/usr/share/mariadb/test",
    "description": "The base directory for tests (--basedir)"
  },
  "database_name": {
    "type": "string",
    "default": "test",
    "description": "The default database to use (--database)"
  },
  "host": {
    "type": "string",
    "default": "localhost",
    "description": "The host name to connect to (--host)"
  },
  "port": {
    "type": "number",
    "default": 3306,
    "description": "The TCP/IP port number (--port)"
  },
  "socket": {
    "type": "string",
    "default": "/run/mysqld/mysqld.sock",
    "description": "The socket file to use (--socket)"
  },
  "user": {
    "type": "string",
    "default": "root",
    "description": "The MariaDB user name (--user)"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "The password to use (--password)"
  },
  "protocol": {
    "type": "string",
    "default": "TCP",
    "description": "The connection protocol (--protocol: TCP|SOCKET|PIPE|MEMORY)",
    "enum": [
      "TCP",
      "SOCKET",
      "PIPE",
      "MEMORY"
    ]
  },
  "ssl_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable SSL for connection (--ssl)"
  },
  "ssl_ca": {
    "type": "string",
    "default": "",
    "description": "CA file in PEM format (--ssl-ca)"
  },
  "ssl_capath": {
    "type": "string",
    "default": "",
    "description": "CA directory (--ssl-capath)"
  },
  "ssl_cert": {
    "type": "string",
    "default": "",
    "description": "X509 cert in PEM format (--ssl-cert)"
  },
  "ssl_key": {
    "type": "string",
    "default": "",
    "description": "X509 key in PEM format (--ssl-key)"
  },
  "ssl_cipher": {
    "type": "string",
    "default": "",
    "description": "SSL cipher to use (--ssl-cipher)"
  },
  "connect_timeout": {
    "type": "number",
    "default": 10,
    "description": "Connection timeout in seconds (--connect-timeout)"
  },
  "max_connect_retries": {
    "type": "number",
    "default": 3,
    "description": "Maximum connection retries (--max-connect-retries)"
  },
  "max_connections": {
    "type": "number",
    "default": 128,
    "description": "Maximum simultaneous connections per client (--max-connections)"
  },
  "compress": {
    "type": "bool",
    "default": false,
    "description": "Compress communication (--compress)"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Verbose mode (--verbose)"
  },
  "silent": {
    "type": "bool",
    "default": false,
    "description": "Suppress normal output (--silent)"
  },
  "continue_on_error": {
    "type": "bool",
    "default": false,
    "description": "Continue on error (--continue-on-error)"
  },
  "sleep_duration": {
    "type": "number",
    "default": 0,
    "description": "Sleep duration in seconds (--sleep)"
  },
  "result_file": {
    "type": "string",
    "default": "",
    "description": "Result file path (--result-file)"
  },
  "record": {
    "type": "bool",
    "default": false,
    "description": "Record results (--record)"
  },
  "logdir": {
    "type": "string",
    "default": "/tmp",
    "description": "Log directory (--logdir)"
  },
  "tmpdir": {
    "type": "string",
    "default": "/tmp",
    "description": "Temporary directory (--tmpdir)"
  },
  "suite_dir": {
    "type": "string",
    "default": "/usr/share/mariadb/test",
    "description": "Suite directory (--suite-dir)"
  },
  "character_sets_dir": {
    "type": "string",
    "default": "/usr/share/mariadb/charsets",
    "description": "Character sets directory (--character-sets-dir)"
  },
  "plugin_dir": {
    "type": "string",
    "default": "",
    "description": "Plugin directory (--plugin-dir)"
  },
  "overlay_dir": {
    "type": "string",
    "default": "",
    "description": "Overlay directory (--overlay-dir)"
  },
  "test_file": {
    "type": "string",
    "default": "",
    "description": "Test file to read (--test-file)"
  },
  "timer_file": {
    "type": "string",
    "default": "",
    "description": "Timer file (--timer-file)"
  },
  "prologue": {
    "type": "string",
    "default": "",
    "description": "Prologue file (--prologue)"
  },
  "tail_lines": {
    "type": "number",
    "default": 0,
    "description": "Tail lines on failure (--tail-lines)"
  },
  "result_format_version": {
    "type": "number",
    "default": 1,
    "description": "Result format version (--result-format-version)"
  },
  "cursor_protocol": {
    "type": "bool",
    "default": false,
    "description": "Use cursors for prepared statements (--cursor-protocol)"
  },
  "ps_protocol": {
    "type": "bool",
    "default": false,
    "description": "Use prepared-statement protocol (--ps-protocol)"
  },
  "view_protocol": {
    "type": "bool",
    "default": false,
    "description": "Wrap SELECT in view (--view-protocol)"
  },
  "sp_protocol": {
    "type": "bool",
    "default": false,
    "description": "Use stored procedure protocol (--sp-protocol)"
  },
  "non_blocking_api": {
    "type": "bool",
    "default": false,
    "description": "Use non-blocking API (--non-blocking-api)"
  },
  "ssl_verify_server_cert": {
    "type": "bool",
    "default": false,
    "description": "Verify server cert CN (--ssl-verify-server-cert)"
  },
  "ssl_crl": {
    "type": "string",
    "default": "",
    "description": "SSL CRL file (--ssl-crl)"
  },
  "ssl_crlpath": {
    "type": "string",
    "default": "",
    "description": "SSL CRL path (--ssl-crlpath)"
  },
  "debug_options": {
    "type": "string",
    "default": "d:t:S:i:O,/tmp/mariadb-test.trace",
    "description": "Debug options string (--debug)"
  },
  "debug_check": {
    "type": "bool",
    "default": false,
    "description": "Print debug check on exit (--debug-check)"
  },
  "debug_info": {
    "type": "bool",
    "default": false,
    "description": "Print debug info on exit (--debug-info)"
  },
  "server_args": {
    "type": "list",
    "default": [],
    "description": "Server arguments for embedded server (--server-arg). Items are flat strings."
  },
  "server_file": {
    "type": "string",
    "default": "",
    "description": "Server argument file (--server-file)"
  },
  "no_defaults": {
    "type": "bool",
    "default": false,
    "description": "Skip default option files (--no-defaults)"
  },
  "mark_progress": {
    "type": "bool",
    "default": false,
    "description": "Mark progress (--mark-progress)"
  }
}
