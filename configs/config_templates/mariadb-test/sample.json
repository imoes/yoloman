{
  "base_dir": "/usr/share/mariadb/test",
  "database_name": "mariadb_test_db",
  "host": "db.example.com",
  "port": 3306,
  "socket": "/var/run/mysqld/mysqld.sock",
  "user": "test_user",
  "password": "secret_pass",
  "protocol": "TCP",
  "ssl_enabled": true,
  "ssl_ca": "/etc/ssl/certs/ca-certificates.crt",
  "ssl_capath": "",
  "ssl_cert": "/etc/ssl/client-cert.pem",
  "ssl_key": "/etc/ssl/client-key.pem",
  "ssl_cipher": "",
  "connect_timeout": 20,
  "max_connect_retries": 5,
  "max_connections": 64,
  "compress": true,
  "verbose": true,
  "silent": false,
  "continue_on_error": false,
  "sleep_duration": 1,
  "result_file": "/tmp/test_results.result",
  "record": false,
  "logdir": "/var/log/mariadb-tests",
  "tmpdir": "/var/tmp/mariadb-test",
  "suite_dir": "/usr/share/mariadb/test/suite",
  "character_sets_dir": "/usr/share/mariadb/charsets",
  "plugin_dir": "/usr/lib/mariadb/plugin",
  "overlay_dir": "",
  "test_file": "/home/user/tests/my_test.test",
  "timer_file": "/tmp/test_timer.txt",
  "prologue": "",
  "tail_lines": 10,
  "result_format_version": 1,
  "cursor_protocol": false,
  "ps_protocol": true,
  "view_protocol": false,
  "sp_protocol": false,
  "non_blocking_api": false,
  "ssl_verify_server_cert": false,
  "ssl_crl": "",
  "ssl_crlpath": "",
  "debug_options": "d:t:S:i:O,/tmp/mariadb-test.trace",
  "debug_check": false,
  "debug_info": false,
  "server_args": [
    "--tmpdir=/tmp/embedded"
  ],
  "server_file": "",
  "no_defaults": false,
  "mark_progress": true
}
