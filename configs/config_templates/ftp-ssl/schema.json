{
  "service_name": {
    "type": "string",
    "default": "ftp-ssl",
    "description": "Service name for identification (e.g., 'ftp-ssl')"
  },
  "server_host": {
    "type": "string",
    "default": "",
    "description": "Default FTP server hostname or IP address"
  },
  "server_port": {
    "type": "number",
    "default": 21,
    "description": "Default FTP control port (standard: 21)"
  },
  "ssl_verify": {
    "type": "number",
    "default": 1,
    "description": "SSL certificate verification level (1 = verify peer)"
  },
  "ssl_cacert": {
    "type": "string",
    "default": "/etc/ssl/certs/ca-certificates.crt",
    "description": "Path to CA certificate bundle for server verification"
  },
  "ssl_cert": {
    "type": "string",
    "default": "",
    "description": "Path to client certificate (optional, may include key)"
  },
  "ssl_key": {
    "type": "string",
    "default": "",
    "description": "Path to client private key (if not in ssl_cert)"
  },
  "ssl_cipher_list": {
    "type": "list",
    "default": [
      "HIGH",
      "!aNULL",
      "!MD5"
    ],
    "description": "List of allowed OpenSSL ciphers for TLS connections"
  },
  "passive_mode": {
    "type": "bool",
    "default": true,
    "description": "Enable passive mode for data connections"
  },
  "transfer_type": {
    "type": "string",
    "default": "ascii",
    "description": "Default file transfer type: 'ascii', 'image' (binary), 'ebcdic', or 'local'",
    "enum": [
      "ascii",
      "image",
      "ebcdic",
      "local"
    ]
  },
  "timeout_seconds": {
    "type": "number",
    "default": 30,
    "description": "Connection timeout in seconds"
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Debug verbosity: 0 (off), 1 (minimal), 2 (verbose)"
  }
}
