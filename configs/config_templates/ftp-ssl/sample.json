{
  "service_name": "ftp-ssl",
  "server_host": "ftp.example.com",
  "server_port": 990,
  "ssl_verify": 1,
  "ssl_cacert": "/etc/ssl/certs/ca-certificates.crt",
  "ssl_cert": "/etc/ssl/certs/client.crt",
  "ssl_key": "/etc/ssl/private/client.key",
  "ssl_cipher_list": [
    "ECDHE-RSA-AES256-GCM-SHA384",
    "ECDHE-RSA-AES128-GCM-SHA256",
    "HIGH",
    "!aNULL",
    "!MD5"
  ],
  "passive_mode": true,
  "transfer_type": "image",
  "timeout_seconds": 60,
  "debug_level": 0
}
