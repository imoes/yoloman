# =============================================================================
# {{ service_name | default('ftp-ssl') }} FTP-SSL Client Configuration
# =============================================================================
# This file configures the ftp(1) command for explicit FTPS (FTP over TLS/SSL)
# connections. It sets default host, port, SSL verification, transfer modes,
# and timeouts.
#
# Generated by Ansible Jinja2. Do not edit manually if managed by automation.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Connection Settings
# -----------------------------------------------------------------------------

# {{ service_name | default('ftp-ssl') }}
# Service name for identification (e.g., 'ftp-ssl')
SERVICE_NAME='{{ service_name | default("ftp-ssl") }}'

# server_host: Default FTP server hostname or IP address
# If empty, ftp(1) will prompt for a host or use a default if configured elsewhere.
{% if server_host | default('') %}
SERVER_HOST='{{ server_host | default("") | string }}'
{% endif %}

# server_port: Default FTP control port (standard: 21)
# Standard FTP uses port 21. FTPS usually uses the same control port.
{% if server_port | default(21) != 21 %}
SERVER_PORT={{ server_port | default(21) }}
{% elif server_port | default(21) is defined %}
# Note: Using standard port 21, so explicit SERVER_PORT is omitted unless customized.
{% endif %}

# -----------------------------------------------------------------------------
# SSL/TLS Security Settings
# -----------------------------------------------------------------------------

# SSL/TLS options — only applies when using ftp(1) with -z flags (e.g., ftp -z)

# ssl_verify: SSL certificate verification level (1 = verify peer, 0 = no verify)
# 1 is recommended for production to prevent MITM attacks.
{% if ssl_verify | default(1) %}
# SSL certificate verification flags (0: none, 1: verify peer)
SSL_VERIFY={{ ssl_verify | default(1) }}
{% endif %}

# ssl_cacert: Path to CA certificate bundle for server verification
# This file should contain trusted CA certificates (e.g., ca-certificates.crt).
{% if ssl_cacert | default('/etc/ssl/certs/ca-certificates.crt') %}
# Path to CA certificate bundle for verifying server cert
SSL_CACERT='{{ ssl_cacert | default("/etc/ssl/certs/ca-certificates.crt") }}'
{% endif %}

# ssl_cert: Path to client certificate (optional, may include private key)
# Used for client-side certificate authentication (mutual TLS).
{% if ssl_cert | default('') %}
# Path to client certificate (may include private key)
SSL_CERT='{{ ssl_cert | default("") }}'
{% endif %}

# ssl_key: Path to client private key (if not in ssl_cert)
# Required if the client certificate is in a separate file.
{% if ssl_key | default('') %}
# Path to client private key (if not embedded in SSL_CERT)
SSL_KEY='{{ ssl_key | default("") }}'
{% endif %}

# ssl_cipher_list: List of allowed OpenSSL ciphers for TLS connections
# Formats a list of cipher strings into a colon-separated list (OpenSSL format).
{% if ssl_cipher_list | default(['HIGH', '!aNULL', '!MD5']) %}
# Colon-separated list of allowed ciphers (openssl ciphers -v output)
SSL_CIPHER='{{ ssl_cipher_list | default(["HIGH", "!aNULL", "!MD5"]) | join(":") }}'
{% endif %}

# -----------------------------------------------------------------------------
# Connection and Transfer Behavior
# -----------------------------------------------------------------------------

# passive_mode: Enable passive mode for data connections
# Passive mode (PASV) is required for clients behind NAT or firewalls.
# True enables PASV; False uses ACTIVE mode.
{% if passive_mode | default(true) %}
# Use passive mode for data connections (recommended behind NAT/firewalls)
PASSIVE_MODE=1
{% else %}
# Active mode is used when passive mode is disabled.
# PASSIVE_MODE=0
{% endif %}

# transfer_type: Default file transfer type: 'ascii', 'image' (binary), 'ebcdic', or 'local'
# 'image' is equivalent to binary transfer. 'ascii' for text files.
{% if transfer_type | default('ascii') %}
# File transfer type: 'ascii', 'image' (binary), 'ebcdic', 'local'
TRANSFER_TYPE='{{ transfer_type | default("ascii") }}'
{% endif %}

# timeout_seconds: Connection timeout in seconds
# Time to wait for a response from the server before giving up.
{% if timeout_seconds | default(30) %}
# Connection timeout in seconds
TIMEOUT={{ timeout_seconds | default(30) }}
{% endif %}

# debug_level: Debug verbosity: 0 (off), 1 (minimal), 2 (verbose)
# 0 is recommended for production. Higher levels output diagnostic info to stderr.
{% if debug_level | default(0) %}
# Debugging (0: off, 1: minimal, 2: verbose)
DEBUG={{ debug_level | default(0) }}
{% endif %}