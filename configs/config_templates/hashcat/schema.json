{
  "hash_type": {
    "type": "number",
    "default": 1000,
    "description": "Hash type identifier (e.g., 1000 = NTLM, 500 = md5crypt). See hashcat(1) 'Hash types' section."
  },
  "attack_mode": {
    "type": "number",
    "default": 0,
    "description": "Attack mode: 0=straight, 1=combination, 3=brute-force, 6=hybrid wordlist+mask, 7=hybrid mask+wordlist."
  },
  "hash_file": {
    "type": "string",
    "default": "",
    "description": "Path to the file containing hashed passwords."
  },
  "wordlist": {
    "type": "list",
    "default": [],
    "description": "List of wordlists for straight/hybrid attacks. Space-separated when used in template."
  },
  "mask": {
    "type": "string",
    "default": "",
    "description": "Mask for brute-force/hybrid attack (e.g., ?l?l?l?d)."
  },
  "left_wordlist": {
    "type": "string",
    "default": "",
    "description": "Left wordlist for combination attacks."
  },
  "right_wordlist": {
    "type": "string",
    "default": "",
    "description": "Right wordlist for combination attacks."
  },
  "outfile": {
    "type": "string",
    "default": "",
    "description": "Path to output file for recovered passwords."
  },
  "outfile_format": {
    "type": "number",
    "default": 3,
    "description": "Output format: integer 1\u201315 (see 'Outfile formats' section in hashcat(1))."
  },
  "separator": {
    "type": "string",
    "default": ":",
    "description": "Separator character used between fields in hash and output files."
  },
  "remove": {
    "type": "bool",
    "default": false,
    "description": "Whether to remove cracked hashes from input file."
  },
  "potfile_disable": {
    "type": "bool",
    "default": true,
    "description": "Disable potfile writing (recommended for ephemeral or containerized deployments)."
  },
  "potfile_path": {
    "type": "string",
    "default": "",
    "description": "Custom path for potfile."
  },
  "runtime": {
    "type": "number",
    "default": 0,
    "description": "Maximum runtime in seconds (0 = no limit)."
  },
  "self_test_disable": {
    "type": "bool",
    "default": false,
    "description": "Disable built-in self-test on startup."
  },
  "skip": {
    "type": "number",
    "default": 0,
    "description": "Number of words to skip from start of wordlist."
  },
  "limit": {
    "type": "number",
    "default": 0,
    "description": "Maximum number of words to process (after skip)."
  },
  "markov_threshold": {
    "type": "number",
    "default": 0,
    "description": "Markov chain threshold (X when to stop accepting new chains)."
  },
  "markov_hcstat2": {
    "type": "string",
    "default": "",
    "description": "Path to hcstat2 file for Markov heuristics."
  },
  "markov_disable": {
    "type": "bool",
    "default": false,
    "description": "Disable Markov chains (classic brute-force)."
  },
  "custom_charset1": {
    "type": "string",
    "default": "",
    "description": "User-defined charset for ?1 (e.g., ?dabcdef)."
  },
  "custom_charset2": {
    "type": "string",
    "default": "",
    "description": "User-defined charset for ?2."
  },
  "custom_charset3": {
    "type": "string",
    "default": "",
    "description": "User-defined charset for ?3."
  },
  "custom_charset4": {
    "type": "string",
    "default": "",
    "description": "User-defined charset for ?4."
  },
  "increment": {
    "type": "bool",
    "default": false,
    "description": "Enable increment mode (auto-increase password length)."
  },
  "increment_min": {
    "type": "number",
    "default": 0,
    "description": "Minimum length for increment mode."
  },
  "increment_max": {
    "type": "number",
    "default": 0,
    "description": "Maximum length for increment mode."
  },
  "rules_file": {
    "type": "string",
    "default": "",
    "description": "Path to rule file (e.g., best64.rule)."
  },
  "generate_rules": {
    "type": "number",
    "default": 0,
    "description": "Number of random rules to generate."
  },
  "debug_mode": {
    "type": "number",
    "default": 0,
    "description": "Debug mode (hybrid only; 1\u20134; see 'Debug mode output formats' section)."
  },
  "debug_file": {
    "type": "string",
    "default": "",
    "description": "Output file for rule debugging (used only with debug_mode > 0)."
  },
  "kernel_threads": {
    "type": "number",
    "default": 0,
    "description": "Manual kernel thread count (0 = auto)."
  },
  "kernel_accel": {
    "type": "number",
    "default": 0,
    "description": "Manual outer-loop step size (0 = auto)."
  },
  "kernel_loops": {
    "type": "number",
    "default": 0,
    "description": "Manual inner-loop step size (0 = auto)."
  },
  "brain_client": {
    "type": "bool",
    "default": false,
    "description": "Enable brain client (distributed cracking)."
  },
  "brain_host": {
    "type": "string",
    "default": "",
    "description": "Brain server hostname or IP."
  },
  "brain_port": {
    "type": "number",
    "default": 0,
    "description": "Brain server port (0 = default)."
  },
  "brain_password": {
    "type": "string",
    "default": "",
    "description": "Brain server authentication password."
  },
  "brain_session": {
    "type": "string",
    "default": "",
    "description": "Override brain session ID (hex)."
  },
  "encoding_from": {
    "type": "string",
    "default": "",
    "description": "Input encoding name (e.g., UTF-8)."
  },
  "encoding_to": {
    "type": "string",
    "default": "",
    "description": "Output encoding name."
  },
  "hex_salt": {
    "type": "bool",
    "default": false,
    "description": "Assume salt in hashlist is hex-encoded."
  },
  "hex_charset": {
    "type": "bool",
    "default": false,
    "description": "Assume charsets are hex-encoded."
  },
  "hex_wordlist": {
    "type": "bool",
    "default": false,
    "description": "Assume words in wordlist are hex-encoded."
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Suppress non-error output."
  },
  "force": {
    "type": "bool",
    "default": false,
    "description": "Ignore warnings and force execution."
  },
  "benchmark": {
    "type": "bool",
    "default": false,
    "description": "Run hardware benchmark instead of cracking."
  }
}
