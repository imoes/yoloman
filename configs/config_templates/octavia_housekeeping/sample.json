{
  "housekeeping_interval": 60,
  "max_lbaas_per_housekeeping": 50,
  "amphora_agent_timeout": 90,
  "amphora_expiry_enabled": true,
  "amphora_expiry_age": 1209600,
  "amphora_expiry_batch_size": 5,
  "amphora_agent_ca": "/etc/octavia/amphora-agent-ca.pem",
  "amphora_agent_cert": "/etc/octavia/amphora-agent.pem",
  "amphora_agent_key": "/etc/octavia/amphora-agent-key.pem",
  "amphora_network": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "amphora_subnet": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
  "exclude_lba_ids": [
    "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
  ],
  "amphora_agent_heartbeat_dir": "/var/lib/octavia/heartbeat",
  "enable_health_sync": true,
  "health_sync_timeout": 15,
  "database_connection": "mysql+pymysql://octavia:secretpass@10.0.0.5/octavia",
  "amphora_agents": [
    {
      "name": "bgp-agent-group",
      "host": "10.10.1.20",
      "port": 9444,
      "use_tls": true
    }
  ],
  "lock_path": "/var/lib/octavia/lock",
  "workers": 4,
  "thread_pool_size": 20,
  "use_eventlet": true,
  "amphora_driver": "amphora_haproxy_rest_driver",
  "loadbalancer_topology": "ACTIVE_STANDBY"
}
