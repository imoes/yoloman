{# Global sensor configuration options #}
set fan_speed_max {{ fan_speed_max }}
set temp_max {{ temp_max }}
set voltage_tolerance {{ voltage_tolerance }}

{# Enable or disable automatic monitoring #}
{% if monitor_enabled %}monitor
{% else %}#monitor
{% endif %}

{# Define individual sensors to monitor #}
{% for sensor in sensors %}{# Sensor: {{ sensor.name }} #}
sensor {{ sensor.device }} {{ sensor.name }}
  set label {{ sensor.label }}
  set min {{ sensor.min }}
  set max {{ sensor.max }}
  set alert {{ sensor.alert | lower }}
{% endfor %}

{# Define fan controls #}
{% for fan in fans %}{# Fan control: {{ fan.name }} #}
fan {{ fan.device }} {{ fan.name }}
  set min {{ fan.min }}
  set max {{ fan.max }}
{% endfor %}
