{
  "fan_speed_max": 65535,
  "temp_max": 85,
  "voltage_tolerance": 5,
  "monitor_enabled": true,
  "sensors": [
    {
      "device": "coretemp-isa-0000",
      "name": "CPU Core 0",
      "label": "cpu0_temp",
      "min": 5,
      "max": 80,
      "alert": "true"
    },
    {
      "device": "nvidia-gpu-0000:01:00.0",
      "name": "GPU Temp",
      "label": "gpu_temp",
      "min": 10,
      "max": 85,
      "alert": "true"
    },
    {
      "device": "acpi-virtual-0000",
      "name": "Battery Voltage",
      "label": "voltage_batt",
      "min": 10.5,
      "max": 13.2,
      "alert": "false"
    }
  ],
  "fans": [
    {
      "device": "pwm1",
      "name": "CPU Fan",
      "min": 1000,
      "max": 5000
    },
    {
      "device": "fan2",
      "name": "System Exhaust",
      "min": 800,
      "max": 3000
    }
  ]
}
