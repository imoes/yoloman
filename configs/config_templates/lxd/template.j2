# LXD daemon configuration — controls global daemon behavior
# See `man lxd.conf` or https://documentation.ubuntu.com/lxd/en/latest/reference/config/ for details
# Network listener (HTTP API port and bind address)
{% if bind_addr %}addr = {{ bind_addr }}{% else %}# addr = 127.0.0.1:8443{% endif %}

# HTTPS port (default 8443)
port = {{ port }}

# Path to the LXD storage pool directory (storage.driver = directory)
storage = {{ storage_path }}

# Logging verbosity: debug, info, warn, error
loglevel = {{ log_level }}

# Enable or disable trust password authentication (if not using TLS client certs)
auth = {{ auth_type }}

# TLS certificate and key paths (for HTTPS API and peer communication)
{% if tls_cert_path %}certificate = {{ tls_cert_path }}{% endif %}
{% if tls_key_path %}key = {{ tls_key_path }}{% endif %}

# Trusted CA certificate(s) for client or peer verification
{% if ca_cert_path %}ca_certificate = {{ ca_cert_path }}{% endif %}

# Restrict API access to Unix socket only (disable TCP listener)
{% if restrict_unix_only %}restricted = true{% else %}# restricted = false{% endif %}

# Unix socket permissions (octal mode, e.g., 0660)
{% if unix_socket_perms %}unix_socket_permissions = {{ unix_socket_perms }}{% endif %}

# LXD daemon shutdown timeout (seconds)
shutdown_timeout = {{ shutdown_timeout }}

# Preload images into storage (true/false)
{% if preload_images %}preload_images = true{% else %}# preload_images = false{% endif %}

# Default image server (URL or alias like `images`)
{% if default_image_server %}image_server = {{ default_image_server }}{% endif %}

# Network bridge configuration for containers (e.g., lxdbr0)
{% for bridge in bridges %}
# Bridge: {{ bridge.name }} — IPv{{ '4' if bridge.ip_version == 4 else '6' }} network: {{ bridge.ip_address }}/{{ bridge.prefix_length }}
network.bridge.name = {{ bridge.name }}
network.bridge.ipv{{ bridge.ip_version }}.address = {{ bridge.ip_address }}
network.bridge.ipv{{ bridge.ip_version }}.nat = {{ 'true' if bridge.nat else 'false' }}
{% endfor %}

# DNS configuration (nameservers for container DNS)
{% if dns_servers %}network.dns.nameservers = {{ dns_servers | join(', ') }}{% endif %}

# Proxy listen addresses (for legacy proxy devices, one per line)
{% for proxy in proxies %}# Proxy: {{ proxy.listen }} → {{ proxy.connect }}
{% if proxy.listen and proxy.connect %}proxy.listen = {{ proxy.listen }}
proxy.connect = {{ proxy.connect }}{% endif %}
{% endfor %}

# Security: require trusted client certificates for API access
{% if require_client_cert %}security.require_client_certificate = true{% else %}# security.require_client_certificate = false{% endif %}

# Allowed network ranges for container NAT (comma-separated)
{% if allowed_networks %}network.ipv4.nat.addresses = {{ allowed_networks | join(', ') }}{% endif %}

# Storage backend: `dir`, `zfs`, `btrfs`, `lvm`, `ceph`, `cephfs`
{% if storage_backend %}storage.backend = {{ storage_backend }}{% endif %}

# Storage pool name (for non-dir backends)
{% if storage_pool %}storage.pool_name = {{ storage_pool }}{% endif %}

# Default profile config (applied to all containers unless overridden)
{% for key, value in default_profile.items() %}# Default profile: {{ key }} = {{ value }}
{% if key and value %}default.profile.{{ key }} = {{ value }}{% endif %}
{% endfor %}

# Allowed storage volumes (comma-separated volume types: `containers`, `snapshots`, `backups`, `images`)
{% if allowed_storage_volumes %}storage.allowed_volumes = {{ allowed_storage_volumes | join(', ') }}{% endif %}

# Allowed instance types (comma-separated: `container`, `virtual-machine`)
{% if allowed_instance_types %}instance.types = {{ allowed_instance_types | join(', ') }}{% endif %}

# Log file path (for daemon stdout/stderr; use `-` for stdout only)
log_file = {{ log_file_path }}
