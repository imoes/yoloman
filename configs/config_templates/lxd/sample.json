{
  "bind_addr": "0.0.0.0:8443",
  "port": 8443,
  "storage_path": "/var/lib/lxd",
  "log_level": "warn",
  "auth_type": "trusted",
  "tls_cert_path": "/etc/lxd/server.crt",
  "tls_key_path": "/etc/lxd/server.key",
  "ca_cert_path": "/etc/lxd/ca.crt",
  "restrict_unix_only": false,
  "unix_socket_perms": "0660",
  "shutdown_timeout": 30,
  "preload_images": true,
  "default_image_server": "images.linuxcontainers.org",
  "bridges": [
    {
      "name": "lxdbr0",
      "ip_version": 4,
      "ip_address": "10.0.8.1",
      "prefix_length": 24,
      "nat": true
    },
    {
      "name": "lxdbr1",
      "ip_version": 6,
      "ip_address": "fd42:46f7:ac52:963b::1",
      "prefix_length": 64,
      "nat": true
    }
  ],
  "dns_servers": [
    "8.8.8.8",
    "2001:4860:4860::8888"
  ],
  "proxies": [],
  "require_client_cert": true,
  "allowed_networks": [
    "10.0.8.0/24",
    "fd42:46f7:ac52:963b::/64"
  ],
  "storage_backend": "zfs",
  "storage_pool": "lxd_pool",
  "default_profile": {
    "raw.idmap": "both 1000 1000",
    "security.nesting": "false"
  },
  "allowed_storage_volumes": [
    "containers",
    "snapshots",
    "backups"
  ],
  "allowed_instance_types": [
    "container",
    "virtual-machine"
  ],
  "log_file_path": "-"
}
