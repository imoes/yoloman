# Configuration file for yaws-chat
# Self-documented template generated from schema.
# Variables use explicit defaults to prevent render failures
# when the role consumer omits optional settings.

# ebin_dir: Path to the directory where yaws-chat beam code is placed.
ebin_dir = {{ ebin_dir | default('/usr/lib/yaws-chat/ebin') }}

# Virtual server definition for yaws-chat.
# Uncomment and adjust the block below to enable the chat service.

#<server chat>
    # port: Port number for the yaws-chat virtual server.
    port = {{ port | default(8080) }}

    # listen: IP address to listen on for the yaws-chat virtual server.
    listen = {{ listen | default('0.0.0.0') }}

    # docroot: Document root for the yaws-chat virtual server.
    docroot = {{ docroot | default('/usr/share/yaws-chat/www') }}
#</server>