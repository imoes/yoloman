# ==============================================================================
# netr: Network Throughput Display Tool - Configuration Template
# ==============================================================================
# This template generates a configuration file for 'netr', a network throughput
# monitoring utility. Although 'netr' is primarily a CLI tool, this file allows
# for persistent defaults or wrapper-based configuration.
#
# Each setting includes its schema description for self-documentation purposes.
# ==============================================================================

# Network interface to monitor (e.g., 'eth0', 'wlan0', 'all'). Defaults to all interfaces.
# Use 'all' to aggregate statistics across every available network interface.
interface_name = "{{ (values | default({})).interface_name | default('all') }}"

# Refresh rate in seconds for updating the display.
# Determines how frequently the throughput metrics are recalculated and redrawn.
refresh_interval = {{ (values | default({})).refresh_interval | default(1) }}

# Enable colored output in the terminal for better readability.
# When true, the tool uses ANSI escape codes to highlight metrics.
color_output = {{ (values | default({})).color_output | default(true) }}

# Path to a log file for storing throughput history.
# Leave empty to disable logging. If specified, must be a writable path.
log_file = "{{ (values | default({})).log_file | default('') }}"