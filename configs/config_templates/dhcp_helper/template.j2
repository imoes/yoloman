# DHCP relay destinations (space-separated list of IP addresses or hostnames)
DHCP_RELAY_DEST={{ destinations | join(' ') }}

# Interface(s) to listen on (space-separated)
DHCP_RELAY_IFACES={{ interfaces | join(' ') }}

# Additional daemon options (e.g., -d for debug, -f for foreground)
DHCP_RELAY_OPTS="{{ options }}"
