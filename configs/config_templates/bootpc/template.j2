# ==============================================================================
# bootpc configuration file (static)
# ==============================================================================
# This file defines command-line arguments passed to the bootpc(8) utility.
# bootpc is a BOOTP (Bootstrap Protocol) client daemon.
#
# Each argument in `bootpc_args` is a complete string representing a single
# command-line option (e.g., "--server 192.168.1.1").
# ==============================================================================

# BOOTPC_ARGS: List of command-line arguments passed directly to bootpc(8).
# Each item is a complete argument string.
# Default: Empty list.
BOOTPC_ARGS="{% for arg in bootpc_args | default([]) %}{{ arg }} {% endfor %}"