# Ansible-managed configuration for Mosquitto MQTT broker
# This file is generated from an Ansible template. Do not edit manually.
# Each directive is prefixed with a comment describing its purpose and default value.

# --- Listeners ---
# List of listeners to expose (port, optional bind address, protocol). Each defines a listening endpoint.
# Default: [] (empty list, meaning no listeners are configured unless explicitly added)
{% for listener in listeners | default([]) %}
# Listener {{ loop.index }}: port={{ listener.port | default(1883) }}, bind={{ listener.bind | default('0.0.0.0') }}
port {{ listener.port | default(1883) }}
# Optional: bind_address for this listener (defaults to 0.0.0.0 if not specified)
{% if listener.bind | default('0.0.0.0') != '0.0.0.0' %}
bind_address {{ listener.bind | default('0.0.0.0') }}
{% endif %}
# Optional: protocol for this listener (e.g., mqtt, websockets)
{% if listener.protocol is defined %}
protocol {{ listener.protocol }}
{% endif %}

{% endfor %}

# --- Authentication & Authorization ---

# Allow clients to connect with an empty client ID (disables automatic client ID assignment).
# Default: False
allow_zero_length_clientid {{ allow_zero_length_clientid | default(false) | lower }}

# If true, permits connections without username/password authentication.
# Set to false to require auth.
# Default: True
allow_anonymous {{ allow_anonymous | default(true) | lower }}

# Absolute path to the file containing usernames and hashed passwords (use mosquitto_passwd to create).
# Only used if allow_anonymous is false.
# Default: /etc/mosquitto/passwd
password_file {{ password_file | default('/etc/mosquitto/passwd') }}

# Absolute path to the file defining access control lists (permissions per user or pattern).
# Only used if allow_anonymous is false.
# Default: /etc/mosquitto/acl
acl_file {{ acl_file | default('/etc/mosquitto/acl') }}

# --- Persistence ---

# Enable disk persistence of subscriptions, retained messages, and in-flight messages.
# Default: False
persistence {{ persistence | default(false) | lower }}

# Directory where persistence files are stored (must exist and be writable by mosquitto user).
# Only used if persistence is true.
# Default: /var/lib/mosquitto
persistence_location {{ persistence_location | default('/var/lib/mosquitto') }}

# --- Performance ---

# Maximum number of QoS 1/2 messages in-flight per client (not yet acknowledged).
# Default: 20
max_inflight_messages {{ max_inflight_messages | default(20) }}

# Maximum size (in bytes) of an incoming MQTT packet (set to 0 for no limit).
# Recommended <= 256MB.
# Default: 268435456 (256 MB)
max_packet_size {{ max_packet_size | default(268435456) }}

# --- Logging ---

# Log client connect/disconnect messages to the log.
# Default: True
connection_messages {{ connection_messages | default(true) | lower }}

# Maximum number of simultaneous client connections (-1 = unlimited).
# Default: -1
max_connections {{ max_connections | default(-1) }}

# Absolute path to the log file (requires proper permissions and directory).
# Default: /var/log/mosquitto/mosquitto.log
log_file {{ log_file | default('/var/log/mosquitto/mosquitto.log') }}

# List of log message types to record (options: none, error, warning, notice, information, subscribe, unsubscribe, websockets, audit, debug).
# Default: ['error', 'warning', 'notice', 'information']
{% for log_type_entry in log_type | default(['error', 'warning', 'notice', 'information']) %}
log_type {{ log_type_entry }}
{% endfor %}

# Include ISO 601 timestamps in log entries.
# Default: True
log_timestamp {{ log_timestamp | default(true) | lower }}

# --- TLS/SSL Configuration ---

# Absolute path to the server’s TLS certificate (PEM format).
# Required if TLS is enabled for listeners.
# Default: /etc/mosquitto/certs/server.crt
tls_certfile {{ tls_certfile | default('/etc/mosquitto/certs/server.crt') }}

# Absolute path to the server’s TLS private key (PEM format).
# Required if TLS is enabled for listeners.
# Default: /etc/mosquitto/certs/server.key
tls_keyfile {{ tls_keyfile | default('/etc/mosquitto/certs/server.key') }}

# Absolute path to the CA certificate file (PEM format) for validating client certificates.
# Leave empty if client certificate verification is not required.
# Default: '' (empty)
{% if tls_ca_file | default('') | trim | length > 0 %}
tls_ca_file {{ tls_ca_file | default('') }}
{% endif %}

# Minimum TLS version to support (e.g., 'tlsv1.2', 'tlsv1.1').
# Default: 'tlsv1.2'
tls_version {{ tls_version | default('tlsv1.2') }}