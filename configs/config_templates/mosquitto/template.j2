# Listener configuration for incoming connections
# Supports multiple listeners on different ports and protocols
{% if listeners is defined and listeners | length > 0 %}
{% for listener in listeners %}
listener {{ listener.port }}{% if listener.bind_address is defined %} {{ listener.bind_address }}{% endif %}{% if listener.protocol is defined %} {{ listener.protocol }}{% endif %}
{% endfor %}
{% else %}
listener 1883
{% endif %}

# Default MQTT protocol (can be overridden per listener)
# If true, enables MQTT v5.0 support; otherwise defaults to v3.1.1
allow_zero_length_clientid {{ allow_zero_length_clientid | string | lower }}

# Authentication and access control
# If true, allows anonymous (unauthenticated) clients; otherwise requires auth
allow_anonymous {{ allow_anonymous | string | lower }}

# Path to password file for username/password authentication
password_file {{ password_file }}

# Path to ACL file for access control lists
acl_file {{ acl_file }}

# Persistence configuration
# Enables disk-based persistence of messages and subscriptions
persistence {{ persistence | string | lower }}
persistence_location {{ persistence_location }}

# Max in-flight messages per client
max_inflight_messages {{ max_inflight_messages }}

# Max packet size (bytes) for incoming messages
max_packet_size {{ max_packet_size }}

# Connection backlogs and timeouts
connection_messages {{ connection_messages | string | lower }}
max_connections {{ max_connections | default(-1) }}

# Logging configuration
log_dest file {{ log_file }}
log_type {{ log_type | join(', ') }}
log_timestamp {{ log_timestamp | string | lower }}

# Bridge configuration (outgoing connections to other brokers)
{% if bridges is defined and bridges | length > 0 %}
{% for bridge in bridges %}
# Bridge: {{ bridge.name }} → {{ bridge.remote_address }}:{{ bridge.remote_port }}
bridge_address {{ bridge.remote_address }}
bridge_port {{ bridge.remote_port }}
bridge_protocol mqtt
bridge_clientid {{ bridge.client_id | default('mosq-bridge-' + bridge.name) }}
bridge_username {{ bridge.username | default('') }}
bridge_password {{ bridge.password | default('') }}
bridge_attempt_unsubscribe {{ bridge.attempt_unsubscribe | default(true) | string | lower }}
try_private {{ bridge.try_private | default(true) | string | lower }}
notifications {{ bridge.notifications | default(false) | string | lower }}
{% if bridge.topics is defined %}
{% for topic in bridge.topocols %}
# topic: {{ topic.direction | default('both') }} {{ topic.topic }}
topic {{ topic.topic }} {{ topic.direction | default('both') }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# Listener TLS configuration (applies to all listeners unless overridden)
# Note: TLS must be configured per listener; this section sets defaults
certfile {{ tls_certfile }}
keyfile {{ tls_keyfile }}
cafile {{ tls_cafile }}
require_certificate {{ tls_require_certificate | string | lower }}

# General server options
autosave_interval {{ autosave_interval }}
autosave_on_changes {{ autosave_on_changes | string | lower }}

# Retained message cache cleanup
retained_cache_size {{ retained_cache_size }}
retained_persistence {{ retained_persistence | string | lower }}