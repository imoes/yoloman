# Place your local configuration in /etc/mosquitto/conf.d/
#
# A full description of the configuration file is at
# /usr/share/doc/mosquitto/examples/mosquitto.conf

{% if pid_file is defined and pid_file is not none and (pid_file is number or pid_file is boolean or pid_file | length > 0) %}pid_file {{ pid_file }}
{% else %}#pid_file /run/mosquitto/mosquitto.pid
{% endif %}
persistence {{ 'true' if persistence | default(true) | bool else 'false' }}
persistence_location {{ persistence_location | default('/var/lib/mosquitto/') }}

log_dest {{ log_dest | default('file /var/log/mosquitto/mosquitto.log') }}

include_dir /etc/mosquitto/conf.d
{% for l in listeners | default([]) %}
listener {{ l.port }}{% if l.bind_address is defined and l.bind_address %} {{ l.bind_address }}{% endif %}
{% endfor %}{% if allow_anonymous is defined and allow_anonymous is not none and (allow_anonymous is number or allow_anonymous is boolean or allow_anonymous | length > 0) %}allow_anonymous {{ 'true' if allow_anonymous | bool else 'false' }}
{% endif %}{% if password_file is defined and password_file is not none and (password_file is number or password_file is boolean or password_file | length > 0) %}password_file {{ password_file }}
{% endif %}{% if acl_file is defined and acl_file is not none and (acl_file is number or acl_file is boolean or acl_file | length > 0) %}acl_file {{ acl_file }}
{% endif %}