{
  "renderd": {
    "num_threads": 8,
    "tile_timeout": 300,
    "xml": [
      "/etc/mapnik-osm-data/osm.xml",
      "/etc/mapnik-osm-data/bicycle.xml"
    ],
    "socket_name": "/var/run/renderd/renderd.sock",
    "max_conn": 16,
    "debug": true
  },
  "maps": [
    {
      "name": "osm",
      "xml": "/etc/mapnik-osm-data/osm.xml",
      "host": "127.0.0.1",
      "port": 8002,
      "tile_dir": "/var/lib/mod_tile/osm",
      "mapnik_image_type": "png",
      "mapnik_image_quality": 85,
      "min_zoom": 0,
      "max_zoom": 18
    },
    {
      "name": "bicycle",
      "xml": "/etc/mapnik-osm-data/bicycle.xml",
      "host": "127.0.0.1",
      "port": 8003,
      "tile_dir": "/var/lib/mod_tile/bicycle",
      "mapnik_image_type": "png256",
      "mapnik_image_quality": 9,
      "min_zoom": 1,
      "max_zoom": 16
    }
  ]
}
