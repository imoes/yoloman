{
  "bind_address": "127.0.0.1",
  "port": 6379,
  "tcp_backlog": 511,
  "unix_socket_path": "",
  "unix_socket_perms": 700,
  "timeout": 0,
  "tcp_keepalive": 300,
  "daemonize": false,
  "pid_file": "/var/run/redis/redis-server.pid",
  "log_level": "notice",
  "log_file": "/var/log/redis/redis-server.log",
  "syslog_enabled": false,
  "syslog_ident": "redis",
  "syslog_facility": "local0",
  "rdb_snapshots": [
    {
      "interval": 900,
      "keys_changed": 1
    },
    {
      "interval": 300,
      "keys_changed": 10
    },
    {
      "interval": 60,
      "keys_changed": 10000
    }
  ],
  "rdb_filename": "dump.rdb",
  "rdb_dir": "/var/lib/redis",
  "stop_writes_on_bgsave_error": true,
  "rdb_compression": true,
  "rdb_checksum": true,
  "aof_enabled": true,
  "aof_filename": "appendonly.aof",
  "aof_fsync_policy": "everysec",
  "no_aof_fsync_on_rewrite": false,
  "auto_aof_rewrite_percentage": 100,
  "auto_aof_rewrite_min_size": "64mb",
  "aof_load_truncated": true,
  "aof_use_rdb_preamble": true,
  "max_memory": "256mb",
  "max_memory_policy": "allkeys-lru",
  "max_memory_samples": 5,
  "lazyfree_lazy_eviction": false,
  "lazyfree_lazy_expire": false,
  "lazyfree_lazy_server_del": false,
  "replica_lazy_flush": false,
  "latency_monitor_threshold": 0,
  "require_password": "redis_secure_pass_2024!",
  "client_output_buffer_limits": [
    {
      "class": "normal",
      "hard": "0",
      "soft": "0",
      "seconds": 0
    },
    {
      "class": "replica",
      "hard": "256mb",
      "soft": "64mb",
      "seconds": 60
    },
    {
      "class": "pubsub",
      "hard": "32mb",
      "soft": "8mb",
      "seconds": 60
    }
  ],
  "acl_file": "/etc/redis/redis.acl",
  "default_user": "disabled",
  "slowlog_slower_than": 10000,
  "slowlog_max_len": 128,
  "notify_keyspace_events": "AKE",
  "hash_max_entries": 512,
  "hash_max_value": "64",
  "list_max_size": "-2",
  "list_compress_depth": 0,
  "set_max_entries": 512,
  "zset_max_entries": 128,
  "zset_max_value": "64",
  "stream_node_max_bytes": "4096",
  "stream_node_max_entries": 100,
  "active_rehashing": true,
  "client_query_buffer_limit": "1gb",
  "proto_max_bulk_len": "512mb",
  "hz": 10,
  "dynamic_hz": true,
  "aof_rewrite_incremental_fsync": true,
  "rdb_save_incremental_fsync": true
}
