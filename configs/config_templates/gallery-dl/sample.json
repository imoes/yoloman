{
  "destination": "/data/gallery-dl",
  "filename": "{category}/{gallery_id}/{num:04}_{title}_{id}.{ext}",
  "retries": 5,
  "sleep": "1.5-2.5",
  "sleep_request": "0.5",
  "sleep_extractor": "2.0",
  "limit_rate": "2M",
  "no_part": false,
  "no_skip": true,
  "download_archive": "/data/archive.txt",
  "range": "1-10",
  "filter": "type == 'image' and width >= 1920",
  "http_timeout": 45.0,
  "proxy": "http://proxy.example.com:8080",
  "cookies": "/home/user/.config/gallery-dl/cookies.txt",
  "cookies_from_browser": "firefox",
  "write_metadata": true,
  "write_info_json": true,
  "write_tags": true,
  "zip": "gallery-dl-{id}.zip",
  "mtime": "date",
  "postprocessors": [
    "ffmpeg"
  ],
  "exec": "convert {} {}.png && rm {}",
  "exec_after": "cd {_directory} && tar -czf ../gallery-{_id}.tar.gz . && rm -rf ../*",
  "rename_to": "{category}/{date:%Y-%m-%d}/{id}_{title}.{ext}",
  "abort": 3,
  "terminate": 5,
  "user_agent": "gallery-dl/1.29.7",
  "browser": "firefox",
  "print": "download:{id}",
  "print_to_file": "download:{id} /data/log.txt",
  "error_file": "/data/errors.txt",
  "write_log": "/data/gallery-dl.log",
  "extractors": [
    {
      "name": "pixiv",
      "username": "user@example.com",
      "password": "secret",
      "options": {
        "ugoira": "webm"
      }
    },
    {
      "name": "reddit",
      "options": {
        "sort": "top",
        "time": "all"
      }
    }
  ],
  "extra_options": {
    "archive": "/data/archive.txt"
  },
  "verbose": true,
  "quiet": false,
  "no_colors": true
}
