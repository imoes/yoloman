{
  "kdcdefaults": {
    "kdc_ports": [
      88
    ],
    "kdc_tcp_ports": [
      88
    ]
  },
  "realms": [
    {
      "name": "EXAMPLE.COM",
      "database_name": "/var/krb5kdc/principal",
      "admin_keytab": "/var/krb5kdc/kadm5.keytab",
      "acl_file": "/var/krb5kdc/kadm5.acl",
      "key_stash_file": "/var/krb5kdc/.k5.EXAMPLE.COM",
      "kdc_ports": [
        88
      ],
      "max_life": "1d",
      "max_renewable_life": "7d",
      "master_key_type": "aes256-cts-hmac-sha1-96",
      "supported_enctypes": [
        "aes256-cts-hmac-sha1-96",
        "aes128-cts-hmac-sha1-96"
      ],
      "extra_params": {}
    },
    {
      "name": "SECURE.NETWORK",
      "database_name": "/var/krb5/principal.secure",
      "admin_keytab": "/var/krb5kdc/kadm5.secure.keytab",
      "acl_file": "/var/krb5kdc/kadm5.secure.acl",
      "key_stash_file": "/var/krb5kdc/.k5.SECURE.NETWORK",
      "kdc_ports": [
        88
      ],
      "max_life": "8h",
      "max_renewable_life": "2d",
      "master_key_type": "aes128-cts-hmac-sha1-96",
      "supported_enctypes": [
        "aes128-cts-hmac-sha1-96"
      ],
      "extra_params": {
        "kdc_max_deltat": "60",
        "kdc_max_skew": "300"
      }
