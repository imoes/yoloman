# wego configuration file
# See wego(1) for documentation

# The weather data backend to use (e.g. openweathermap, openmeteo, caiyun, weatherapi, worldweatheronline, aat, md, json).
# Default: openweathermap
backend = "{{ backend | default('openweathermap') }}"

# The location to query for weather data.
# Default: "New York, NY"
location = "{{ location | default('New York, NY') }}"

# Number of days of weather forecast to display.
# Default: 3
days = {{ days | default(3) }}

# Unitsystem for output. Choices: metric, imperial, si, metric-ms.
# Default: metric
units = "{{ units | default('metric') }}"

# Output frontend to use (e.g. aat, md, json).
# Default: aat
frontend = "{{ frontend | default('aat') }}"

# Cache TTL duration. Set to '0' to disable caching.
# Default: "15m"
cache_ttl = "{{ cache_ttl | default('15m') }}"

# aat-frontend: Enable compact output.
# Default: false
aat_compact = {{ aat_compact | default(false) }}

# aat-frontend: Show geo coordinates.
# Default: false
aat_coords = {{ aat_coords | default(false) }}

# aat-frontend: Enable monochrome output.
# Default: false
aat_monochrome = {{ aat_monochrome | default(false) }}

# md-frontend: Show geo coordinates.
# Default: false
md_coords = {{ md_coords | default(false) }}

# json-frontend: Do not indent the output.
# Default: false
json_no_indent = {{ json_no_indent | default(false) }}

# openmeteo backend: API key for commercial usage. Leave empty if not using commercial plan.
# Default: None (empty)
openmeteo_api_key = "{{ openmeteo_api_key | default('') }}"

# openmeteo backend: Print raw requests and responses.
# Default: false
openmeteo_debug = {{ openmeteo_debug | default(false) }}

# openweathermap backend: API key.
# Default: None (empty)
openweathermap_api_key = "{{ openweathermap_api_key | default('') }}"

# openweathermap backend: Print raw requests and responses.
# Default: false
openweathermap_debug = {{ openweathermap_debug | default(false) }}

# openweathermap backend: Language for API responses.
# Default: "en"
openweathermap_lang = "{{ openweathermap_lang | default('en') }}"

# caiyun backend: API key.
# Default: None (empty)
caiyun_api_key = "{{ caiyun_api_key | default('') }}"

# caiyun backend: Print raw requests and responses.
# Default: false
caiyun_debug = {{ caiyun_debug | default(false) }}

# caiyun backend: Language for API requests.
# Default: "en"
caiyun_lang = "{{ caiyun_lang | default('en') }}"

# weatherapi backend: API key.
# Default: None (empty)
weatherapi_key = "{{ weatherapi_key | default('') }}"

# weatherapi backend: Print raw requests and responses.
# Default: false
weatherapi_debug = {{ weatherapi_debug | default(false) }}

# weatherapi backend: Language for API requests.
# Default: "en"
weatherapi_lang = "{{ weatherapi_lang | default('en') }}"

# worldweatheronline backend: API key.
# Default: None (empty)
worldweatheronline_key = "{{ worldweatheronline_key | default('') }}"

# worldweatheronline backend: Print raw requests and responses.
# Default: false
worldweatheronline_debug = {{ worldweatheronline_debug | default(false) }}

# worldweatheronline backend: Language for API requests.
# Default: "en"
worldweatheronline_lang = "{{ worldweatheronline_lang | default('en') }}"