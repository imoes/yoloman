# ==============================================================================
# BosixNet Daemon Configuration Template
# ==============================================================================
# This template generates the configuration file for the bosixnet-daemon.
# bosixnet is a utility for automatic IPv6 address announcement and /etc/hosts synchronization.
# ==============================================================================

# ------------------------------------------------------------------------------
# Host name
# The hostname to identify this machine within the network.
# ------------------------------------------------------------------------------
# Host name:
HOST_NAME={{ host_name | default('my-laptop') }}

# ------------------------------------------------------------------------------
# Period of updating IPv6 address and /etc/hosts [seconds]
# Interval in seconds at which the daemon checks and updates the IPv6 address
# and synchronizes the local /etc/hosts file.
# ------------------------------------------------------------------------------
# Period of updating IPv6 address and /etc/hosts [seconds]:
UPD_PERIOD={{ upd_period | default(300) }}

# ------------------------------------------------------------------------------
# Directory with auxiliary scripts
# Path to the directory containing helper scripts used by the daemon.
# ------------------------------------------------------------------------------
# Directory with auxiliary scripts:
DIR_UTIL="{{ dir_util | default('/usr/lib/bosixnet') }}"

# ------------------------------------------------------------------------------
# Directory where generated host file is stored
# Local directory where the daemon stores the generated hosts list file.
# This may be useful when you use daemon on the same server as web ui.
# ------------------------------------------------------------------------------
# Directory where generated host file is stored:
LOG_DIR={{ log_dir | default('/var/tmp/bosixnet') }}

# ------------------------------------------------------------------------------
# Network device
# The network interface name through which the IPv6 address is managed.
# ------------------------------------------------------------------------------
# Network device:
NETWORK_DEVICE={{ network_device | default('teredo') }}

# ------------------------------------------------------------------------------
# Address sub-string
# A substring used to filter/identify the specific IPv6 address on the device.
# This may be useful when your network device has few registered IPv6 addresses.
# For example, see: https://en.wikipedia.org/wiki/Unique_local_address
# ------------------------------------------------------------------------------
# Address sub-string:
ADDRESS_SUB_STRING={{ address_sub_string | default('2a02') }}

# ------------------------------------------------------------------------------
# Website URL
# URL(s) to send the IPv6 address to and fetch the synchronized hosts list from.
# You may use multiple servers. For example:
# URL="http://home-server/bosixnet
#      http://remote-server:8098/bosixnet
#      https://common-backup-server/secret-prefix-string"
#
# In this case:
# - IPv6 address is sent to all available servers
# - hosts list is got from the first server which replied to request
# ------------------------------------------------------------------------------
# Website URL:
URL="{{ url | default('http://ipv6.example.com/bosixnet') }}"