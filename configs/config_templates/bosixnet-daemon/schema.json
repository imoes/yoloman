{
  "host_name": {
    "type": "string",
    "default": "my-laptop",
    "description": "Host name"
  },
  "upd_period": {
    "type": "number",
    "default": 300,
    "description": "Period of updating IPv6 address and /etc/hosts [seconds]"
  },
  "dir_util": {
    "type": "string",
    "default": "/usr/lib/bosixnet",
    "description": "Directory with auxiliary scripts"
  },
  "log_dir": {
    "type": "string",
    "default": "/var/tmp/bosixnet",
    "description": "Directory where generated host file is stored"
  },
  "network_device": {
    "type": "string",
    "default": "teredo",
    "description": "Network device"
  },
  "address_sub_string": {
    "type": "string",
    "default": "2a02",
    "description": "Address sub-string for IPv6 filtering"
  },
  "url": {
    "type": "string",
    "default": "http://ipv6.example.com/bosixnet",
    "description": "Website URL(s) to send IPv6 address and fetch hosts list from"
  }
}
