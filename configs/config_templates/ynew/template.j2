# ynew configuration file
# Generated from ynew(1) man page

# The editor command to use when creating a new ynew command script.
# Default: vim
command_editor: {{ command_editor | default('vim') }}

# The shell to use for executing ynew commands.
# Default: bash
shell: {{ shell | default('bash') }}

# The base directory where ynew stores command scripts.
# Default: ~/.ynew
home_dir: {{ home_dir | default('~/.ynew') }}