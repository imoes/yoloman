{
  "daemon": true,
  "pidfile": "/var/run/collectl/collectl.pid",
  "verbose": true,
  "interval": 1,
  "format": "csv",
  "dir": "/var/log/collectl",
  "compress": true,
  "retention": 14,
  "maxSize": 100000,
  "subsystems": [
    "cpu",
    "mem",
    "disk",
    "net",
    "proc"
  ],
  "custom_format": "",
  "optional_features": [
    "procstat",
    "cgroup"
  ],
  "excluded_devices": [
    "lo",
    "docker0"
  ]
}
