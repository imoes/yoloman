# wmforecast configuration file
# This file controls the behavior of the wmforecast weather forecast dockapp.
# It is managed by Ansible; do not edit manually.

# Number of minutes between data refreshes.
interval = {{ interval | default(60) }};

# Temperature unit: 'c' for Celsius, 'f' for Fahrenheit.
units = {{ units | default('f') }};

# Background color for the dockapp icon.
background = "{{ background | default('black') }}";

# Text color for the dockapp icon.
text = "{{ text | default('light sea green') }}";

# Latitude coordinate for the location.
latitude = {{ latitude | default(40.7128) }};

# Longitude coordinate for the location.
longitude = "{{ longitude | default('-74.0060') }}";

# Directory containing weather icons.
icondir = "{{ icondir | default('/usr/local/share/wmforecast') }}";

# Disable geoclue for automatic location detection if set to true.
{%- if no_geoclue | default(False) %}
no_geoclue = true;
{%- endif %}

# Number of days to show in the forecast.
{%- if days is defined %}
days = {{ days | default(7) }};
{%- endif %}