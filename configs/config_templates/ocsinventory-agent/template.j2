################################################################################
#
# OCS Inventory NG Agent - Log Rotation Configuration
#
# This file configures logrotate for the OCS Inventory agent.
# It ensures that agent logs are rotated daily, compressed, and retained
# for a specified number of days.
#
# Self-Documented: All variables include defaults and descriptions to ensure
# the template can be reused safely in any Ansible role without external
# context.
################################################################################

# Log Path: Directory containing OCS Inventory agent logs.
# Default: /var/log/ocsinventory-client
# This variable defines the base path for the log files to be managed.
set log_path = {{ log_path | default('/var/log/ocsinventory-client') }}

# Log Extension: File extension of the logs to rotate.
# Default: log
# This variable specifies the file extension of the log files.
set ext = {{ ext | default('log') }}

# Log Rotate Days: Number of days to keep old compressed logs.
# Default: 7
# This variable controls the retention period for rotated logs.
set log_rotate_days = {{ log_rotate_days | default('7') }}

{#
    Construct the log file pattern dynamically using the path and extension.
    The pattern is: <log_path>/*.<ext>
#}
{%- set log_pattern = (log_path | default('/var/log/ocsinventory-client')) ~ '/*.' ~ (ext | default('log')) %}
{{ log_pattern }} {
    daily
    rotate {{ log_rotate_days | default('7') | int }}
    compress
    notifempty
    missingok
}
