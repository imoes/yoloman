# Lomiri Network Indicator Desktop Entry
# This template generates a .desktop file for the lomiri-indicator-network application.
# It defines metadata such as name, executable, and visibility in desktop environments.

[Desktop Entry]
# The type of desktop entry. Must be 'Application' for standard apps.
Type={{ type | default('Application') }}

# The display name of the application shown in menus.
Name={{ name | default('Indicator Network') }}

# The executable path for the service.
Exec={{ exec | default('/usr/libexec/lomiri-indicator-network/lomiri-indicator-network-service') }}

# Whether to send startup notification to the window manager.
StartupNotify={{ startup_notify | default(False) | lower }}

# Whether the application should run in a terminal.
Terminal={{ terminal | default(False) | lower }}

# List of desktop environments where this entry should be shown.
# Join list items with semicolons as per Desktop Entry Specification.
OnlyShowIn={{ only_show_in | default(['Unity', 'GNOME']) | join('; ') }}

# Condition for autostarting the application.
AutostartCondition={{ autostart_condition | default('GNOME3 unless-session gnome') }}