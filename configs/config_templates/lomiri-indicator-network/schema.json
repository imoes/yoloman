{
  "type": {
    "type": "string",
    "default": "Application",
    "description": "The type of desktop entry.",
    "enum": [
      "Application",
      "Link",
      "Service"
    ]
  },
  "name": {
    "type": "string",
    "default": "Indicator Network",
    "description": "The display name of the application."
  },
  "exec": {
    "type": "string",
    "default": "/usr/libexec/lomiri-indicator-network/lomiri-indicator-network-service",
    "description": "The executable path for the service."
  },
  "startup_notify": {
    "type": "bool",
    "default": false,
    "description": "Whether to send startup notification."
  },
  "terminal": {
    "type": "bool",
    "default": false,
    "description": "Whether the application should run in a terminal."
  },
  "only_show_in": {
    "type": "list",
    "default": [
      "Unity",
      "GNOME"
    ],
    "description": "List of desktop environments where this entry should be shown."
  },
  "autostart_condition": {
    "type": "string",
    "default": "GNOME3 unless-session gnome",
    "description": "Condition for autostarting the application."
  }
}
