# quaternion configuration template
# Generated by Ansible — DO NOT EDIT MANUALLY

[general]
# Enable debug logging for troubleshooting (default: disabled)
debug = {{ debug | default(false) | lower }}

# Path to log file; empty disables file logging (default: empty)
{% if log_file | default('') %}logFile = {{ log_file | default('') }}{% else %}#logFile = {% endif %}

# Verbosity of logging output: trace, debug, info, warning, error, critical (default: 'info')
logLevel = {{ log_level | default('info') }}

# Update behavior: 'none' disables updates, 'check' only warns, 'download' installs automatically (default: 'check')
autoUpdate = {{ auto_update | default('check') }}

# Theme name (e.g., 'system', 'light', 'dark') or path to custom theme file (default: 'system')
theme = {{ theme | default('system') }}

[cache]
# Custom cache directory path; empty uses system default (default: empty)
{% if cache_dir | default('') %}cacheDir = {{ cache_dir | default('') }}{% else %}#cacheDir = {% endif %}

# Maximum cache size in MB (0 = unlimited) (default: 500)
maxCacheSize = {{ max_cache_size | default(500) }}

[rooms]
# Show small checkmarks indicating read receipts (default: enabled)
showReadReceipts = {{ show_read_receipts | default(true) | lower }}

# How to sort the room list in the sidebar: 'activity' or 'alphabetical' (default: 'activity')
sortRoomsBy = {{ room_sort_order | default('activity') }}

# Show technical events (e.g., encryption changes) in chat history (default: disabled)
showHiddenEvents = {{ show_hidden_events | default(false) | lower }}

[notifications]
# Enable desktop notifications for incoming messages (default: enabled)
enableNotifications = {{ enable_notifications | default(true) | lower }}

# Play sound when receiving a new message (default: enabled)
soundOnMessage = {{ sound_on_message | default(true) | lower }}

# Path to custom sound file; empty uses system default (default: empty)
{% if notification_sound | default('') %}notificationSound = {{ notification_sound | default('') }}{% else %}#notificationSound = {% endif %}

# How many seconds notifications stay visible (0 = permanent) (default: 5)
notificationTimeout = {{ notification_timeout | default(5) }}

# Include message content in notification popups (default: enabled)
showMessagePreview = {{ show_message_preview | default(true) | lower }}

# Highlight messages that mention the current user or @room (default: enabled)
highlightMentions = {{ highlight_mentions | default(true) | lower }}

[media]
# Size of inline image/video previews: 'small', 'medium', or 'large' (default: 'medium')
mediaPreviewSize = {{ media_preview_size | default('medium') }}

# Proxy type for downloading media: 'none', 'system', or 'manual' (default: 'system')
mediaProxyType = {{ media_proxy_type | default('system') }}

# Proxy hostname (required if mediaProxyType is 'manual') (default: empty)
{% if media_proxy_host | default('') %}mediaProxyHost = {{ media_proxy_host | default('') }}{% else %}#mediaProxyHost = {% endif %}

# Proxy port (required if mediaProxyType is 'manual') (default: 8080)
{% if media_proxy_port | default(8080) != 8080 %}mediaProxyPort = {{ media_proxy_port | default(8080) }}{% else %}#mediaProxyPort = {% endif %}

# Use system-wide proxy settings for all network requests (default: enabled)
useSystemProxy = {{ use_system_proxy | default(true) | lower }}

[servers]
# List of Matrix servers to connect to (supports multiple accounts)
{% for server in servers | default([]) %}
# Server: {{ server.name | default('unnamed') }}
{% if server.homeserver %}server.{{ loop.index }}.url = {{ server.homeserver }}{% endif %}
{% if server.user_id %}server.{{ loop.index }}.userId = {{ server.user_id }}{% endif %}
{% if server.access_token %}server.{{ loop.index }}.accessToken = {{ server.access_token }}{% endif %}
{% if server.is_default %}server.{{ loop.index }}.isDefault = true{% else %}server.{{ loop.index }}.isDefault = false{% endif %}
{% if server.auto_join_rooms | default([]) | length > 0 %}server.{{ loop.index }}.autoJoinRooms = {{ server.auto_join_rooms | default([]) | join(', ') }}{% endif %}
{% if server.proxy_type %}server.{{ loop.index }}.proxyType = {{ server.proxy_type }}{% else %}server.{{ loop.index }}.proxyType = system{% endif %}
{% if server.proxy_host %}server.{{ loop.index }}.proxyHost = {{ server.proxy_host }}{% endif %}
{% if server.proxy_port %}server.{{ loop.index }}.proxyPort = {{ server.proxy_port }}{% endif %}
{% endfor %}

[fonts]
# Use system monospace font for messages (default: enabled)
useSystemFont = {{ use_system_font | default(true) | lower }}

# Custom font family for message display (default: empty)
{% if font_family | default('') %}fontFamily = {{ font_family | default('') }}{% else %}#fontFamily = {% endif %}

# Font size in points (default: 10)
fontSize = {{ font_size | default(10) }}