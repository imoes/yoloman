{
  "base_dir": "/var/lib/callisto",
  "log_level": "INFO",
  "worker_threads": 4,
  "max_concurrent_requests": 8,
  "enable_telemetry": true,
  "central_host": "e-callisto.imcce.fr",
  "central_port": 8080,
  "calibration_cache_dir": "/var/lib/callisto/calibration",
  "enable_calibration_cache": true,
  "max_calibration_cache_size": 500,
  "hw_config_path": "/etc/callisto/hw.ini",
  "data_store_dir": "/var/lib/callisto/data",
  "retention_days": 30,
  "compress_archived_data": true,
  "api_bind_interface": "",
  "api_port": 8000,
  "api_require_auth": false,
  "trusted_internal_ips": [
    "127.0.0.1",
    "::1",
    "192.168.1.0/24"
  ],
  "cross_reference_stations": [
    {
      "id": "BIR",
      "name": "Birr, Ireland",
      "url": "https://e-callisto.imcce.fr/BIR"
    },
    {
      "id": "Ond\u0159ejov",
      "name": "Ond\u0159ejov, Czechia",
      "url": "https://e-callisto.imcce.fr/Ond\u0159ejov"
    }
  ],
  "tls_enabled": true,
  "tls_cert_path": "/etc/callisto/tls/station.crt",
  "tls_key_path": "/etc/callisto/tls/station.key",
  "tls_ca_cert_path": "/etc/callisto/tls/ca.crt",
  "health_endpoint": "/health",
  "hw_timeout": 30,
  "hw_retry_limit": 3,
  "hw_retry_delay": 5,
  "sampling_rate": 0,
  "buffer_size": 256,
  "enable_spectrum_averaging": true,
  "spectrum_averaging_count": 10,
  "min_upload_interval": 60
}
