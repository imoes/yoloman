{
  "interfaces": [
    {
      "name": "br-lan",
      "router": "yes",
      "verbose": "no",
      "rules": [
        {
          "address_range": "2001:db8:1::/64",
          "static": "no",
          "timeout": 300
        }
      ]
    },
    {
      "name": "wan6",
      "router": "no",
      "verbose": "yes",
      "rules": [
        {
          "address_range": "::/0",
          "static": "no",
          "timeout": 600
        }
      ]
    }
  ],
  "global": {
    "log_level": 2,
    "pid_file": "/run/ndppd/ndppd.pid"
  }
}
