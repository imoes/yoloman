{
  "inputs": [
    "/var/lttng/trace/mytrace",
    "/path/to/another/trace"
  ],
  "output_path": "/tmp/output.txt",
  "input_format": "ctf",
  "output_format": "text",
  "verbose": true,
  "debug": false,
  "no_delta": true,
  "names": [
    "payload",
    "context"
  ],
  "fields": [
    "trace:hostname",
    "loglevel"
  ],
  "clock_cycles": false,
  "clock_offset": 0,
  "clock_seconds": true,
  "clock_date": false,
  "clock_gmt": true,
  "stream_intersection": false,
  "debug_info_dir": "/usr/lib/debug/",
  "debug_info_target_prefix": "",
  "debug_info_full_path": true
}
