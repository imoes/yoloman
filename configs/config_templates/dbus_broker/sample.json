{
  "listen_address": "unix:path=/run/dbus/system_bus_socket",
  "debug": false,
  "max_pending_connections": 1024,
  "max_active_clients": 256,
  "max_owned_services": 128,
  "max_match_rules_per_client": 256,
  "max_file_descriptors_per_client": 1024,
  "client_timeout": 25000,
  "enable_activation": true,
  "service_directories": [
    {
      "path": "/usr/share/dbus-1/services"
    },
    {
      "path": "/usr/local/share/dbus-1/services"
    }
  ]
}
