{
  "use_inetd": false,
  "addr": "",
  "port": 69,
  "root_dir": "/srv/tftp",
  "timeout": 300,
  "max_threads": 25,
  "verbose": true,
  "options": [
    "--daemon",
    "--logfile=/var/log/atftpd.log"
  ],
  "shares": [
    {
      "path": "/srv/tftp/images",
      "readonly": false,
      "description": "Uploadable directory for boot images"
    },
    {
      "path": "/srv/tftp/configs",
      "readonly": true,
      "description": "Read-only config files for PXE clients"
    }
  ],
  "use_ipv6": false
}
