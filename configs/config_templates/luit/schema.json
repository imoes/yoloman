{
  "locale": {
    "type": "string",
    "default": "C",
    "description": "The locale setting for character conversion (e.g., en_US.UTF-8). Sets LC_ALL."
  },
  "encoding": {
    "type": "string",
    "default": "",
    "description": "Specific encoding to use (e.g., ISO-8859-1). Overrides locale derivation."
  },
  "g0_charset": {
    "type": "string",
    "default": "",
    "description": "Output charset for G0 (e.g., ASCII)."
  },
  "g1_charset": {
    "type": "string",
    "default": "",
    "description": "Output charset for G1."
  },
  "g1_assignment": {
    "type": "string",
    "default": "g0",
    "description": "Initial GL assignment for output (g0, g1, g2, g3).",
    "enum": [
      "g0",
      "g1",
      "g2",
      "g3"
    ]
  },
  "g2_assignment": {
    "type": "string",
    "default": "g2",
    "description": "Initial GR assignment for output (g0, g1, g2, g3).",
    "enum": [
      "g0",
      "g1",
      "g2",
      "g3"
    ]
  },
  "input_log": {
    "type": "string",
    "default": "",
    "description": "File path to log bytes received from child (-ilog)."
  },
  "output_log": {
    "type": "string",
    "default": "",
    "description": "File path to log bytes sent to terminal (-olog)."
  },
  "ols": {
    "type": "bool",
    "default": false,
    "description": "Disable interpretation of locking shifts (+ols)."
  },
  "osl": {
    "type": "bool",
    "default": false,
    "description": "Disable interpretation of character set selection sequences (+osl)."
  },
  "oss": {
    "type": "bool",
    "default": false,
    "description": "Disable interpretation of single shifts (+oss)."
  },
  "exit_on_child_exit": {
    "type": "bool",
    "default": false,
    "description": "Exit immediately when child dies (-x)."
  },
  "prefer": {
    "type": "string",
    "default": "fontenc,builtin,iconv,posix",
    "description": "Comma-separated lookup order for charsets (-prefer)."
  },
  "verbose": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level: 0=normal, 1=-v, 2=-vv."
  },
  "command": {
    "type": "string",
    "default": "/bin/sh",
    "description": "The child program to run."
  },
  "arguments": {
    "type": "list",
    "default": [],
    "description": "Arguments to pass to the child program."
  }
}
