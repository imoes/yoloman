{
  "default_prefix": "/home/gamer/wineprefixes",
  "user_name": "gamer",
  "export_qt_theme": true,
  "minimize_on_startup": false,
  "qt_theme": "dark",
  "default_wine_version": "wine-ge-custom",
  "wine_args": "--noconsole",
  "winetricks_plugins": [
    {
      "command": "corefonts",
      "enabled": true
    },
    {
      "command": "vcrun2015",
      "enabled": true
    },
    {
      "command": "dotnet48",
      "enabled": false
    }
  ]
}
