# ==============================================================================
# rosbash - Self-documenting shell aliases and completions for ROS
# ==============================================================================
# This template generates a bash script providing convenience aliases and
# shell completions for Robot Operating System (ROS) tools.
# It is designed to be included in a user's .bashrc or sourced on demand.
#
# Since the original template contained no configurable schema fields (no
# variables, only static shell logic), this enriched version preserves the
# original logic exactly while adding structural comments for clarity.
# No Jinja2 variable injection is required or possible as no schema exists.
# ==============================================================================

# --- Aliases ---

# cd into a ROS package directory.
# Tries to find the package using 'rospack' first, then falls back to 'rosstack'.
alias roscd 'cd `rospack find \!*; if ($status) rosstack find \!*;`'

# Alias for roscd
alias rcd roscd

# List files in a ROS package directory.
# Uses 'rospack' to resolve the package path.
alias rosls 'ls `rospack find \!*`'

# --- Commented-out aliases ---
# These aliases are defined in the original template but commented out.
# They represent unimplemented or deprecated ROS utilities.
# Uncommenting them may have no effect or produce errors if the underlying
# commands do not exist in the current ROS distribution.

#alias rosd 'echo "unimplemented"'
