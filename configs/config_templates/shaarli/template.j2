# Shaarli web server configuration snippet.
# This template generates an Apache Alias directive and a corresponding
# <Directory> block for the Shaarli document root.

# Alias {{ shaarli_url_prefix | default('shaarli') }} {{ shaarli_docroot | default('/usr/share/shaarli') }}
Alias {{ shaarli_url_prefix | default('shaarli') }} {{ shaarli_docroot | default('/usr/share/shaarli') }}

# <Directory {{ shaarli_docroot | default('/usr/share/shaarli') }}>
<Directory {{ shaarli_docroot | default('/usr/share/shaarli') }}>
    # Options FollowSymLinks
    # Enable symbolic links in the document root for security/referential integrity.
    Options FollowSymLinks

    # AllowOverride AuthConfig Limit Options FileInfo
    # Allow .htaccess directives to override configuration for authentication, limits, options, and file info.
    AllowOverride AuthConfig Limit Options FileInfo
</Directory>
