# ==============================================================================
# kea-admin command configuration template
# Generated by Ansible Jinja2
#
# This template constructs the command-line arguments for the `kea-admin` utility,
# which is used to manage the Kea DHCP database (initialization, upgrades, lease
# management).
#
# Variables are sourced from the Ansible role variables or defaults provided in
# the schema. All variable references use `| default(...)` to ensure safe rendering
# even if the variable is undefined.
# ==============================================================================

{% set cmd = command | default('db-init') %}

# ------------------------------------------------------------------------------
# Command selection and specific flags
# The `command` variable determines the mode of operation for kea-admin.
# ------------------------------------------------------------------------------

{% if cmd == "lease-dump" %}
# [lease-dump] Dump current leases to a CSV file.
# Requires `output_file` to be set.
{% set ip_ver = ip_version | default('4') %}
{% if ip_ver == "4" %}
-4
{% elif ip_ver == "6" %}
-6
{% endif %}
-o {{ output_file | default('/var/lib/kea/leases.csv') }}

{% elif cmd == "lease-upload" %}
# [lease-upload] Import leases from a CSV file.
# Requires `input_file` to be set.
{% set ip_ver = ip_version | default('4') %}
{% if ip_ver == "4" %}
-4
{% elif ip_ver == "6" %}
-6
{% endif %}
-i {{ input_file | default('/var/lib/kea/leases_import.csv') }}

{% elif cmd == "db-init" %}
# [db-init] Initialize the database schema.
# No specific command-line flags other than connection details are needed.

{% elif cmd == "db-version" %}
# [db-version] Check the current database schema version.
# No specific command-line flags other than connection details are needed.

{% elif cmd == "db-upgrade" %}
# [db-upgrade] Upgrade the database schema to the latest version.
# Uses `script_directory` to locate upgrade scripts.
{% set script_dir = script_directory | default('/usr/share/kea/scripts') %}

{% elif cmd == "stats-recount" %}
# [stats-recount] Recalculate statistics in the database.
# No specific command-line flags other than connection details are needed.

{% else %}
# [unknown] Default to db-init if an unrecognized command is provided.
# This ensures the template always produces a valid base command structure.
{% set cmd = 'db-init' %}
{% endif %}

# ------------------------------------------------------------------------------
# Database Backend Selection
# Specifies the backend type for the kea-admin tool.
# ------------------------------------------------------------------------------
# The backend determines how kea-admin connects to the data store.
# Common values: pgsql, mysql, memfile.
{{ backend | default('pgsql') }}

# ------------------------------------------------------------------------------
# Database Connection Details
# Standard connection parameters passed to kea-admin.
# ------------------------------------------------------------------------------

# Hostname of the database server.
-h {{ host | default('localhost') }}

# Port of the database server.
-P {{ port | default(5432) }}

# Username to authenticate with the database.
-u {{ username | default('kea_admin') }}

# Password to authenticate with the database.
# If empty, kea-admin will prompt or use the KEA_ADMIN_DB_PASSWORD environment variable.
-p {{ password | default('') }}

# Name of the database to connect to.
-n {{ database_name | default('kea') }}

# ------------------------------------------------------------------------------
# Script Directory Override
# Optional override for the location of database upgrade scripts.
# ------------------------------------------------------------------------------
# Only relevant for db-upgrade.
-d {{ script_directory | default('/usr/share/kea/scripts') }}

# ------------------------------------------------------------------------------
# Extra Arguments
# Allows passing arbitrary extra flags to the kea-admin command.
# ------------------------------------------------------------------------------
{% for extra in extra_args | default([]) %}
-x {{ extra }}
{% endfor %}

# ------------------------------------------------------------------------------
# Safety Flag
# Automatically assumes 'yes' to prompts (e.g., overwriting files).
# ------------------------------------------------------------------------------
{% if yes | default(False) | bool %}
-y
{% endif %}