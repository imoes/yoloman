# Environment variables for the prometheus-dnsmasq-exporter systemd service
# This configuration is managed by Ansible. Do not edit manually.

# [host] IP address the exporter listens on. Use 0.0.0.0 to listen on all interfaces.
HOST={{ host | default('0.0.0.0') }}

# [port] Port number the exporter exposes Prometheus metrics on.
PORT={{ port | default(9109) }}

# [dnsmasq_leasefile] Absolute path to dnsmasq's lease database file,
# typically /var/lib/dnsmasq/dnsmasq.leases.
DNSMASQ_LEASEFILE={{ dnsmasq_leasefile | default('/var/lib/dnsmasq/dnsmasq.leases') }}

# [dnsmasq_dhcp_stats_file] Optional absolute path to dnmasq's DHCP stats file
# (e.g., /var/lib/dnsmasq/dnsmasq-dhcp-stats). Leave empty if not available.
{% if dnsmasq_dhcp_stats_file | default('') %}
DNSMASQ_DHCP_STATS_FILE={{ dnsmasq_dhcp_stats_file | default('') }}
{% endif %}

# [scrape_timeout] Maximum time (seconds) allowed for a single scrape of dnsmasq
# stats before timing out.
SCRAPE_TIMEOUT={{ scrape_timeout | default(5) }}

# [enable_verbose] Enable verbose debug logging for troubleshooting.
# If enabled, LOG_LEVEL is set to debug; otherwise, it defaults to info.
{% if enable_verbose | default(False) %}
LOG_LEVEL=debug
{% else %}
LOG_LEVEL=info
{% endif %}

# [extra_flags] Additional command-line flags to pass to the exporter
# (e.g., ['--log-json']). These are joined into a space-separated string.
{% if extra_flags | default([]) %}
EXTRA_FLAGS={{ extra_flags | default([]) | join(' ') }}
{% endif %}