{
  "command": [
    "for i in $(seq 1 10); do",
    "  echo \"$i - process $i\"",
    "done"
  ],
  "args": "",
  "preaction": "LINE=$(echo \"$BOSH\" | cut -d' ' -f1);",
  "header": 1,
  "refresh": false,
  "autorefresh": 5,
  "cursorsize": 2,
  "cursormovement": 3,
  "multilineseperator": ";",
  "uservars": 2,
  "actions": [
    {
      "key": "k",
      "command": "echo \"Killing line $LINE\" >&2; kill $LINE"
    },
    {
      "key": "K",
      "mode": "!",
      "prompt": "signal",
      "command": "kill -s $BOSHPARAM $LINE"
    },
    {
      "key": "l",
      "mode": ".",
      "command": "echo \"lsof for $LINE\"; echo \"No open files\" "
    }
  ]
}
