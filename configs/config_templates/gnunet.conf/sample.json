{
  "core": {
    "port": 2086,
    "hostname": "0.0.0.0",
    "timeout": 30
  },
  "arm": {
    "port": 2087,
    "hostname": "127.0.0.1",
    "default_services": [
      "core",
      "arm",
      "statistics",
      "transport",
      "topology"
    ],
    "start_services": [
      {
        "name": "dht",
        "enabled": true
      },
      {
        "name": "resolver",
        "enabled": true
      },
      {
        "name": "gns",
        "enabled": true
      },
      {
        "name": "vpn",
        "enabled": false
      }
    ]
  },
  "nat": {
    "enable_upnp": true,
    "behind_nat": false,
    "allow_nat": true,
    "http_proxy": "",
    "external_ip": ""
  },
  "dht": {
    "port": 2088,
    "hostname": "0.0.0.0",
    "cache_size": 2000,
    "worker_threads": 4
  },
  "datastore": {
    "db": "sqlite",
    "limit": "20 GB",
    "prefix": "gnunet",
    "path": "/var/lib/gnunet"
  },
  "transport": {
    "plugins": [
      "tcp",
      "udp"
    ],
    "timeout": 300,
    "plugins_config": [
      {
        "name": "tcp",
        "port": 2086,
        "hostname": "0.0.0.0",
        "listen_addresses": [
          "0.0.0.0",
          "::"
        ]
      },
      {
        "name": "udp",
        "port": 2086,
        "hostname": "0.0.0.0",
        "listen_addresses": [
          "0.0.0.0",
          "::"
        ]
      }
    ]
  },
  "peerinfo": {
    "port": 2089,
    "hostname": "localhost"
  },
  "vpn": {
    "enabled": false
  },
  "resolver": {
    "port": 5353,
    "hostname": "127.0.0.1"
  },
  "gns": {
    "port": 2091,
    "hostname": "localhost",
    "zone_key_file": "/etc/gnunet.d/gns/private-zone.key"
  },
  "set": {
    "port": 2092,
    "hostname": "localhost"
  },
  "cadet": {
    "port": 2093,
    "hostname": "localhost"
  },
  "namestore": {
    "port": 2094,
    "hostname": "localhost"
  },
  "consensus": {
    "port": 2095,
    "hostname": "localhost"
  },
  "revocation": {
    "port": 2096,
    "hostname": "localhost"
  }
}
