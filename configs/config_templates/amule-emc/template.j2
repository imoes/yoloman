{# ============================================================================ #}
{# amule-emc Configuration Template                                             #}
{#                                                                              #}
{# This template generates the configuration file for amule-emc (Enhanced       #}
{# Mule Collection). It handles the processing of .emc (eMule collection) files.#}
{#                                                                              #}
{# Self-Documenting: All configuration directives are preceded by comments      #}
{# describing their purpose, derived from the schema definition. All variables  #}
{# use explicit defaults to ensure safe rendering even when values are omitted. #}
{# ============================================================================ #}

{# --- Collection Files Processing ---                                          #}
{# List of paths to emulecollection files to process.                         #}
{# Each item is a string representing a filesystem path to an .emc file.     #}
{# Default is an empty list (no files processed).                              #}
{# Format: The template expects a flat list of paths; they are indented for  #}
{# readability if multiple files are specified.                                #}

{%- set _collection_files = collection_files | default([]) %}
{% if _collection_files is iterable and _collection_files | length > 0 %}
  {# Indent each collection file path for consistent formatting in the output #}
  {%- for collection_file in _collection_files %}
    {{ collection_file | indent(2) }}
  {%- endfor %}
{% endif %}