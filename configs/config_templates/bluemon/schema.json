{
  "bluemon_enable": {
    "type": "string",
    "default": "no",
    "description": "Enable or disable bluemon ('yes' or 'no')",
    "enum": [
      "yes",
      "no"
    ]
  },
  "bluetooth_id": {
    "type": "string",
    "default": "aa:bb:cc:dd:ee:ff",
    "description": "Bluetooth device address (MAC) to monitor; multiple devices may be space-separated"
  },
  "threshold": {
    "type": "number",
    "default": 200,
    "description": "Signal threshold (out of 255)"
  },
  "interval": {
    "type": "number",
    "default": 100,
    "description": "Interval in milliseconds to check signal strength"
  }
}
