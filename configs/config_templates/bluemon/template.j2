#
# BlueMon (Bluetooth Monitor) configuration file
#
# This file configures the Bluemon utility which monitors Bluetooth device
# signal strength by hooking into the Bluetooth stack using a fake MAC address.
# WARNING: Enabling bluemon can break other bluetooth applications (e.g. kbluetoothd)
# as it intercepts the bluetooth stack.
#

# -------------------------------------------------------------------------
# Enable or disable bluemon
# -------------------------------------------------------------------------
# Accepts 'yes' or 'no'. Default is 'no'.
# Enabling this service requires careful consideration as it may interfere
# with other Bluetooth managers running on the system.
BLUEMON_ENABLE='{{ bluemon_enable | default("no") }}'

# -------------------------------------------------------------------------
# Bluetooth device address(es) to monitor
# -------------------------------------------------------------------------
# The MAC address of the Bluetooth device to track signal strength.
# Multiple devices may be specified, separated by spaces.
# Format: XX:XX:XX:XX:XX:XX
BLUETOOTHID='{{ bluetooth_id | default("aa:bb:cc:dd:ee:ff") }}'

# -------------------------------------------------------------------------
# Signal threshold
# -------------------------------------------------------------------------
# The signal strength threshold value (out of 255) used to determine
# if the signal is considered "good" or "weak".
THRESHOLD={{ threshold | default(200) }}

# -------------------------------------------------------------------------
# Check interval
# -------------------------------------------------------------------------
# The interval in milliseconds between signal strength checks.
INTERVAL={{ interval | default(100) }}

# -------------------------------------------------------------------------
# Optional flags
# -------------------------------------------------------------------------

# Enable link-quality checking.
# Uncomment the line below to activate this feature.
# QUALITY=-q

# Log to stdout instead of syslog.
# Uncomment the line below to activate this feature.
# STDOUT=-s

# Prevent running in daemon mode (run in foreground).
# Uncomment the line below to activate this feature.
# NOFORK=-n

# Enable verbose output for debugging.
# Uncomment the line below to activate this feature.
# VERBOSE=-v

# Enable anti-disconnect hack to handle spurious disconnects.
# Uncomment the line below to activate this feature.
# DISCONNECTHACK=-d