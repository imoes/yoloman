# ============================================================================
# userv-dyndns Configuration Template
# ============================================================================
# This template generates the configuration file for userv-dyndns, a service
# that handles dynamic DNS updates for a specific zone.
#
# The configuration consists of global rate-limiting and zone settings,
# followed by groups of subdomain definitions, each restricted to specific
# RR (Resource Record) types.
#
# Variables are sourced from the Ansible role schema. All variables have
# safe defaults to ensure the template renders correctly even if values
# are not explicitly provided.
# ============================================================================

# ---------------------------------------------------------------------------
# Global Rate Limiting
# ---------------------------------------------------------------------------
# Controls how frequently dynamic updates are allowed.
# Syntax: ratelimit <min-seconds> <avg-seconds> <memory-seconds>
#
# - min-seconds: Minimum time between any two updates.
# - avg-seconds: Average interval allowed over the memory window.
# - memory-seconds: Duration of the history window for rate calculation.
#
# Defaults:
#   min-seconds:  30
#   avg-seconds:  300
#   memory-seconds: 3600
# ---------------------------------------------------------------------------
ratelimit {{ ratelimit_min_seconds | default(30) }} {{ ratelimit_avg_seconds | default(300) }} {{ ratelimit_memory_seconds | default(3600) }}

# ---------------------------------------------------------------------------
# DNS Zone
# ---------------------------------------------------------------------------
# The authoritative DNS zone for which this service handles dynamic updates.
# Syntax: zone <zone-name>
# Default: dynamic.greenend.org.uk
# ---------------------------------------------------------------------------
zone {{ dns_zone | default('dynamic.greenend.org.uk') }}

# ---------------------------------------------------------------------------
# TTL Range
# ---------------------------------------------------------------------------
# Defines the minimum and maximum Time-To-Live (TTL) values allowed for
# records added via dynamic updates.
# Syntax: ttlrange <min-ttl> <max-ttl>
# Defaults:
#   min-ttl: 30
#   max-ttl: 86400
# ---------------------------------------------------------------------------
ttlrange {{ ttl_min | default(30) }} {{ ttl_max | default(86400) }}

# ============================================================================
# Subdomain Group 1
# ============================================================================
# Defines allowed RR types and associated subdomain entries for the first group.
# ---------------------------------------------------------------------------

# Allowed RR types for this group.
# Syntax: rrs <type> ...
# Default: A
# ---------------------------------------------------------------------------
rrs {{ rrs_types_1 | default('A') }}

# Subdomain entries for Group 1.
# Format per line: subdomain <subdomain-name> <groupname>
# The subdomain and groupname are separated by whitespace (tabs in source).
# Default list includes:
#   anjou (rich-avn), badgers (sion-net), bellevue (theom), burrow (vcla-brw),
#   confusion (matt-cnf), dorothee (jdamery), ecstacy (dunc-xtc), firestorm (davi-mul),
#   gallery (jayl-dns), nosreme (ceme-gal), heresy (cjwa-vpn), lemoncurd (bjha-dd),
#   lilac (dame-lil), nijinsky (jmatthew), relativity (ijackson), riva (cjwatson),
#   sinister (Mgend), slappy (chri-cat), stardust (sgtatham), thistles (rcooksey),
#   titus (owen-dns), milton (stev-pub)
# ---------------------------------------------------------------------------
{% for entry in subdomain_1 | default(['anjou\t\trich-avn', 'badgers\t\tsion-net', 'bellevue\ttheom', 'burrow\t\tvcla-brw', 'confusion\tmatt-cnf', 'dorothee\tjdamery', 'ecstacy\t\tdunc-xtc', 'firestorm\tdavi-mul', 'gallery\t\tjayl-dns', 'nosreme\t\tceme-gal', 'heresy\t\tcjwa-vpn', 'lemoncurd\tbjha-dd', 'lilac\t\tdame-lil', 'nijinsky\tjmatthew', 'relativity\tijackson', 'riva\t\tcjwatson', 'sinister\tMgend', 'slappy\t\tchri-cat', 'stardust\tsgtatham', 'thistles\trcooksey', 'titus\t\towen-dns', 'milton\t\tstev-pub']) %}
subdomain {{ entry }}
{% endfor %}

# ============================================================================
# Subdomain Group 2
# ============================================================================
# Defines allowed RR types and associated subdomain entries for the second group.
# ---------------------------------------------------------------------------

# Allowed RR types for this group.
# Syntax: rrs <type> ...
# Default: A CNAME
# ---------------------------------------------------------------------------
rrs {{ rrs_types_2 | default('A CNAME') }}

# Subdomain entries for Group 2.
# Format per line: subdomain <subdomain-name> <groupname>
# Default list includes:
#   gin (dh219), aibs (dh219)
# ---------------------------------------------------------------------------
{% for entry in subdomain_2 | default(['gin\t\tdh219', 'aibs\t\tdh219']) %}
subdomain {{ entry }}
{% endfor %}

# ============================================================================
# Subdomain Group 3
# ============================================================================
# Defines allowed RR types and associated subdomain entries for the third group.
# ---------------------------------------------------------------------------

# Allowed RR types for this group.
# Syntax: rrs <type> ...
# Default: A MX CNAME
# ---------------------------------------------------------------------------
rrs {{ rrs_types_3 | default('A MX CNAME') }}

# Subdomain entries for Group 3.
# Format per line: subdomain <subdomain-name> <groupname>
# Default list includes:
#   test (ijackson)
# ---------------------------------------------------------------------------
{% for entry in subdomain_3 | default(['test ijackson']) %}
subdomain {{ entry }}
{% endfor %}

# ---------------------------------------------------------------------------
# End of Configuration
# ---------------------------------------------------------------------------
# Signals the end of the configuration file to the service parser.
# ---------------------------------------------------------------------------
eof
