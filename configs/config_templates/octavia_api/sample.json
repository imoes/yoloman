{
 "amphora": {
  "agent_workers": 2,
  "amphora_flavor": "m1.medium",
  "amphora_image_tag": "amphora",
  "amphora_name": "amphora-x64-haproxy",
  "amphora_network": "d8e2c2e7-6b3f-4e2a-8b3d-111111111111",
  "amphora_secgroup_list": [
   "a1b2c3d4-5e6f-7g8h-9i0j-k1l2m3n4o5p6"
  ],
  "amphora_subnet": "e9f3d3f8-7c4g-5f3b-9c4e-222222222222"
 },
 "api_settings": {
  "api_rate_limit": 10,
  "bind_host": "0.0.0.0",
  "bind_port": 9876,
  "enable_api_web_ui": false,
  "tls_ciphers": [
   "ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384"
  ],
  "tls_versions": [
   "TLSv1.2",
   "TLSv1.3"
  ]
 },
 "certificates": {
  "ca_certificate": "/etc/octavia/certs/ca_01.pem",
  "ca_private_key": "/etc/octavia/certs/ca_01.key",
  "ca_private_key_passphrase": "mysecretpassphrase",
  "cert_manager": "octavia.certificates.module.local"
 },
 "debug": true,
 "driver_agent": {
  "agent_timeout": 60,
  "config_file_dir": "/etc/octavia/driver-agent"
 },
 "health_manager": {
  "bind_host": "127.0.0.1",
  "bind_port": 5555,
  "health_check_interval": 30,
  "workers": 2
 },
 "keystone_authtoken": {
  "auth_url": "https://keystone.example.com:5000/v3",
  "cafile": "/etc/ssl/certs/ca-certificates.crt",
  "password": "OctaviaSecretPass123",
  "project_domain_name": "Default",
  "project_name": "service",
  "user_domain_name": "Default",
  "username": "octavia"
 },
 "listener": {
  "client_ca_file": "",
  "client_idle_timeout": 50
 },
 "log_dir": "/var/log/octavia",
 "neutron": {
  "auth_url": "https://neutron.example.com:9696",
  "password": "NeutronSecretPass123",
  "project_domain_name": "Default",
  "project_name": "service",
  "region_name": "RegionOne",
  "user_domain_name": "Default",
  "username": "neutron"
 },
 "nova": {
  "auth_url": "https://nova.example.com:8774/v2.1",
  "password": "NovaSecretPass123",
  "project_domain_name": "Default",
  "project_name": "service",
  "region_name": "RegionOne",
  "user_domain_name": "Default",
  "username": "nova"
 },
 "oslo_messaging": {
  "rabbit_host": "rabbitmq.openstack.svc.cluster.local",
  "rabbit_password": "RabbitMQSecretPass123",
  "rabbit_port": 5672,
  "rabbit_use_ssl": true,
  "rabbit_userid": "openstack",
  "rabbit_virtual_host": "/"
 },
 "state_path": "/var/lib/octavia"
}
