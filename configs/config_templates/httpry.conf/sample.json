{
  "log_file": "/var/log/httpry/httpry.log",
  "interface": "eth0",
  "bind_address": "",
  "port": 7777,
  "verbose": false,
  "packet_logging": false,
  "logging": true,
  "max_connections": 500,
  "connection_timeout": 45,
  "ssl_decryption": false,
  "ssl_key": "/etc/httpry/ssl/server.key",
  "ssl_cert": "/etc/httpry/ssl/server.crt",
  "exclude_hosts": [
    "127.0.0.1",
    "::1",
    "192.168.100.0/24"
  ],
  "include_hosts": [],
  "log_format": "json",
  "reverse_dns": true,
  "session_dir": "/var/lib/httpry/sessions",
  "max_session_file_size": 20,
  "max_session_files": 10,
  "session_expiration": true,
  "session_ttl": 172800,
  "daemon_user": "httpry",
  "daemon_group": "httpry",
  "pid_file": "/run/httpry/httpry.pid"
}
