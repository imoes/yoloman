{
 "all_scopes_completion": true,
 "background_index": true,
 "background_index_priority": "low",
 "clang_tidy": true,
 "compile_commands_dir": "/home/user/myproject/build",
 "completion_style": "detailed",
 "enable_config": true,
 "experimental_modules_support": false,
 "fallback_style": "Google",
 "function_arg_placeholders": true,
 "header_insertion": "iwyu",
 "header_insertion_decorators": true,
 "import_insertions": false,
 "limit_references": 0,
 "limit_results": 200,
 "log": "verbose",
 "malloc_trim": true,
 "offset_encoding": "utf-8",
 "path_mappings": [
  "/home/user/src=/work/src",
  "/opt/toolchain=/work/toolchain"
 ],
 "pch_storage": "disk",
 "pretty": true,
 "project_root": "/home/user/myproject",
 "query_driver": [
  "/usr/bin/*clang*",
  "/usr/bin/*g++*"
 ],
 "remote_index_address": "http://localhost:1234",
 "rename_file_limit": 0,
 "threads": 8
}
