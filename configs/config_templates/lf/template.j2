# Configuration for lf terminal file manager
# Generated by Ansible Jinja2 template engine
# This template is self-documenting: every directive is preceded by its schema description.

# Shell executable to use for shell commands
# set shell <shell>
set shell {{ shell | default('sh') }}

# Command line flag used to pass shell commands
# set shellflag <shellflag>
set shellflag {{ shellflag | default('-c') }}

# Show hidden files
# set hidden <bool>
set hidden {{ hidden | default(true) | lower }}

# Sort type for directories
# set sortby <sortby>
set sortby {{ sortby | default('natural') }}

# Reverse the direction of sort
# set reverse <bool>
set reverse {{ reverse | default(false) | lower }}

# Show directories first above regular files
# set dirfirst <bool>
set dirfirst {{ dirfirst | default(true) | lower }}

# List of hidden file glob patterns (colon-separated in config)
# set hiddenfiles <list>
{% if hiddenfiles | default([]) %}
set hiddenfiles {{ hiddenfiles | default([]) | join(':') }}
{% endif %}

# Show icons before each item in the list
# set icons <bool>
set icons {{ icons | default(false) | lower }}

# Show previews of files and directories
# set preview <bool>
set preview {{ preview | default(true) | lower }}

# Path to the previewer script
# set previewer <path>
{% if previewer | default('') %}
set previewer {{ previewer | default('') }}
{% endif %}

# Path to the cleaner script
# set cleaner <path>
{% if cleaner | default('') %}
set cleaner {{ cleaner | default('') }}
{% endif %}

# Interval in seconds for periodic directory updates check
# set period <int>
{% if period | default(0) > 0 %}
set period {{ period | default(0) }}
{% endif %}

# Watch the filesystem for changes
# set watch <bool>
set watch {{ watch | default(false) | lower }}

# Send mouse events as input
# set mouse <bool>
set mouse {{ mouse | default(false) | lower }}

# Show bindings associated with pressed keys
# set showbinds <bool>
set showbinds {{ showbinds | default(true) | lower }}

# Format string of the box drawing characters
# set borderfmt <fmt>
set borderfmt "{{ borderfmt | default('\033[0m') }}"

# Format string of the prompt shown in the top line
# set promptfmt <fmt>
set promptfmt "{{ promptfmt | default('\033[32;1m%u@%h\033[0m:\033[34;1m%d\033[0m\033[1m%f\033[0m') }}"

# Format string of the ruler shown in the bottom right corner
# set rulerfmt <fmt>
set rulerfmt "{{ rulerfmt | default(' %a| %p| \033[7;31m %m \033[0m| \033[7;33m %c \033[0m| \033[7;35m %s \033[0m| \033[7;34m %f \033[0m| %i/%t') }}"

# Format string of the file info shown in the bottom left corner
# set statfmt <fmt>
set statfmt "{{ statfmt | default('\033[36m%p\033[0m| %c| %u| %g| %S| %t| -> %l') }}"

# List of integers for pane width ratios (colon-separated in config)
# set ratios <list>
{% if ratios | default([]) %}
set ratios {{ ratios | default([]) | join(':') }}
{% endif %}

# Minimum number of offset lines shown at top and bottom
# set scrolloff <int>
{% if scrolloff | default(0) > 0 %}
set scrolloff {{ scrolloff | default(0) }}
{% endif %}

# Selection mode for commands
# set selmode <mode>
set selmode {{ selmode | default('all') }}

# Save command history
# set history <bool>
set history {{ history | default(true) | lower }}

# Ignore case in sorting and search patterns
# set ignorecase <bool>
set ignorecase {{ ignorecase | default(true) | lower }}

# Override ignorecase when pattern contains uppercase
# set smartcase <bool>
set smartcase {{ smartcase | default(true) | lower }}

# Jump to first match after each keystroke during searching
# set incsearch <bool>
set incsearch {{ incsearch | default(false) | lower }}

# Apply filter pattern after each keystroke
# set incfilter <bool>
set incfilter {{ incfilter | default(false) | lower }}

# Treat filter patterns as globs
# set globfilter <bool>
set globfilter {{ globfilter | default(false) | lower }}

# Treat search patterns as globs
# set globsearch <bool>
set globsearch {{ globsearch | default(false) | lower }}

# Searching can wrap around the file list
# set wrapscan <bool>
set wrapscan {{ wrapscan | default(true) | lower }}

# Scrolling can wrap around the file list
# set wrapscroll <bool>
set wrapscroll {{ wrapscroll | default(false) | lower }}

# Draw boxes around panes
# set drawbox <bool>
set drawbox {{ drawbox | default(false) | lower }}

# Draw rounded outer corners
# set roundbox <bool>
set roundbox {{ roundbox | default(false) | lower }}

# Format string for copy indicator
# set copyfmt <fmt>
set copyfmt "{{ copyfmt | default('\033[7;33m') }}"

# Format string for cut indicator
# set cutfmt <fmt>
set cutfmt "{{ cutfmt | default('\033[7;31m') }}"

# Format string for selected file indicator
# set selectfmt <fmt>
set selectfmt "{{ selectfmt | default('\033[7;35m') }}"

# Format string for tags
# set tagfmt <fmt>
set tagfmt "{{ tagfmt | default('\033[31m') }}"

# Format string for error messages
# set errorfmt <fmt>
set errorfmt "{{ errorfmt | default('\033[7;31;47m') }}"

# Format string for position numbers
# set numberfmt <fmt>
set numberfmt "{{ numberfmt | default('\033[33m') }}"

# Show position numbers
# set number <bool>
set number {{ number | default(false) | lower }}

# Show relative position numbers
# set relativenumber <bool>
set relativenumber {{ relativenumber | default(false) | lower }}

# List of information types to show (size, time, perm, user, group)
# set info <list>
{% if info | default([]) %}
set info {{ info | default([]) | join(':') }}
{% endif %}

# Time format for recent files
# set infotimefmtnew <fmt>
set infotimefmtnew "{{ infotimefmtnew | default('Jan _2 15:04') }}"

# Time format for old files
# set infotimefmtold <fmt>
set infotimefmtold "{{ infotimefmtold | default('Jan _2 2006') }}"

# Format string for modification time
# set timefmt <fmt>
set timefmt "{{ timefmt | default('Mon Jan _2 15:04:05 2006') }}"

# File separator in environment variables
# set filesep <sep>
set filesep "{{ filesep | default('\n') }}"

# Number of characters prompted for find command
# set findlen <int>
{% if findlen | default(0) > 0 %}
set findlen {{ findlen | default(0) }}
{% endif %}

# Locale for sorting
# set locale <locale>
{% if locale | default('') %}
set locale {{ locale | default('') }}
{% endif %}

# List of shell options
# set shellopts <list>
{% for opt in (shellopts | default([])) %}
set shellopts {{ opt }}
{% endfor %}

# Temporary marks string
# set tempmarks <marks>
{% if tempmarks | default('') %}
set tempmarks {{ tempmarks | default('') }}
{% endif %}

# Message shown after shell-wait commands
# set waitmsg <msg>
set waitmsg "{{ waitmsg | default('Press any key to continue') }}"

# Truncation character
# set truncatechar <char>
set truncatechar "{{ truncatechar | default('~') }}"

# Percentage of space for beginning of truncated filename
# set truncatepct <int>
{% if truncatepct | default(100) != 100 %}
set truncatepct {{ truncatepct | default(100) }}
{% endif %}

# Tab stop width
# set tabstop <int>
{% if tabstop | default(8) != 8 %}
set tabstop {{ tabstop | default(8) }}
{% endif %}

# Auto quit server when no clients
# set autoquit <bool>
set autoquit {{ autoquit | default(true) | lower }}

# Cache directory contents
# set dircache <bool>
set dircache {{ dircache | default(true) | lower }}

# Show directory item counts
# set dircounts <bool>
set dircounts {{ dircounts | default(false) | lower }}

# Show only directories
# set dironly <bool>
set dironly {{ dironly | default(false) | lower }}

# Preview directories
# set dirpreviews <bool>
set dirpreviews {{ dirpreviews | default(false) | lower }}

# Cursor format for active pane
# set cursoractivefmt <fmt>
set cursoractivefmt "{{ cursoractivefmt | default('\033[7m') }}"

# Cursor format for parent panes
# set cursorparentfmt <fmt>
set cursorparentfmt "{{ cursorparentfmt | default('\033[7m') }}"

# Cursor format for preview panes
# set cursorpreviewfmt <fmt>
set cursorpreviewfmt "{{ cursorpreviewfmt | default('\033[4m') }}"

# Format for duplicate file names
# set dupfilefmt <fmt>
set dupfilefmt "{{ dupfilefmt | default('%f.~%n~') }}"

# List of attributes to preserve during copy
# set preserve <list>
{% if preserve | default(['mode']) %}
set preserve {{ preserve | default(['mode']) | join(':') }}
{% endif %}

# Enable sixel image rendering
# set sixel <bool>
set sixel {{ sixel | default(false) | lower }}

# Ignore diacritics in sorting/search
# set ignoredia <bool>
set ignoredia {{ ignoredia | default(true) | lower }}

# Smart diacritics override
# set smartdia <bool>
set smartdia {{ smartdia | default(false) | lower }}

# User-defined options map (key: value)
{% for item in (user_options | default({}) | dict2items) %}
set user_{{ item.key }} {{ item.value }}
{% endfor %}

# Key mappings map (key: command)
{% for item in (key_mappings | default({}) | dict2items) %}
map {{ item.key }} {{ item.value }}
{% endfor %}

# Command-line key mappings map (key: command)
{% for item in (cmap_mappings | default({}) | dict2items) %}
cmap {{ item.key }} {{ item.value }}
{% endfor %}

# Custom commands map (name: command)
{% for item in (custom_commands | default({}) | dict2items) %}
cmd {{ item.key }} {{ item.value }}
{% endfor %}