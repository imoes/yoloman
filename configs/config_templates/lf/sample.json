{
  "shell": "bash",
  "shellflag": "-c",
  "hidden": true,
  "sortby": "name",
  "reverse": false,
  "dirfirst": true,
  "hiddenfiles": [
    ".*",
    ".git"
  ],
  "icons": true,
  "preview": true,
  "previewer": "/usr/bin/cat",
  "cleaner": "",
  "period": 0,
  "watch": true,
  "mouse": false,
  "showbinds": true,
  "borderfmt": "\\033[0m",
  "promptfmt": "\\033[32;1m%u@%h\\033[0m:\\033[34;1m%d\\033[0m\\033[1m%f\\033[0m",
  "rulerfmt": " %a| %p| \\033[7;31m %m \\033[0m| \\033[7;33m %c \\033[0m| \\033[7;35m %s \\033[0m| \\033[7;34m %f \\033[0m| %i/%t",
  "statfmt": "\\033[36m%p\\033[0m| %c| %u| %g| %S| %t| -> %l",
  "ratios": [
    1,
    2,
    3
  ],
  "scrolloff": 0,
  "selmode": "all",
  "history": true,
  "ignorecase": true,
  "smartcase": true,
  "incsearch": false,
  "incfilter": false,
  "globfilter": false,
  "globsearch": false,
  "wrapscan": true,
  "wrapscroll": false,
  "drawbox": true,
  "roundbox": false,
  "copyfmt": "\\033[7;33m",
  "cutfmt": "\\033[7;31m",
  "selectfmt": "\\033[7;35m",
  "tagfmt": "\\033[31m",
  "errorfmt": "\\033[7;31;47m",
  "numberfmt": "\\033[33m",
  "number": false,
  "relativenumber": false,
  "info": [
    "size",
    "time"
  ],
  "infotimefmtnew": "Jan _2 15:04",
  "infotimefmtold": "Jan _2 2006",
  "timefmt": "Mon Jan _2 15:04:05 2006",
  "filesep": "\\n",
  "findlen": 1,
  "locale": "",
  "shellopts": [],
  "tempmarks": "",
  "waitmsg": "Press any key to continue",
  "truncatechar": "~",
  "truncatepct": 100,
  "tabstop": 8,
  "autoquit": true,
  "dircache": true,
  "dircounts": false,
  "dironly": false,
  "dirpreviews": false,
  "cursoractivefmt": "\\033[7m",
  "cursorparentfmt": "\\033[7m",
  "cursorpreviewfmt": "\\033[4m",
  "dupfilefmt": "%f.~%n~",
  "preserve": [
    "mode",
    "timestamps"
  ],
  "sixel": false,
  "ignoredia": true,
  "smartdia": false,
  "user_options": {},
  "key_mappings": {
    "gh": "cd ~",
    "q": "quit"
  },
  "cmap_mappings": {
    "<c-g>": "cmd-escape"
  },
  "custom_commands": {
    "trash": "$rm -rf $fx"
  }
}
