{
  "shell": {
    "type": "string",
    "default": "sh",
    "description": "Shell executable to use for shell commands"
  },
  "shellflag": {
    "type": "string",
    "default": "-c",
    "description": "Command line flag used to pass shell commands"
  },
  "hidden": {
    "type": "bool",
    "default": true,
    "description": "Show hidden files"
  },
  "sortby": {
    "type": "string",
    "default": "natural",
    "description": "Sort type for directories",
    "enum": [
      "natural",
      "name",
      "size",
      "time",
      "ctime",
      "atime",
      "ext"
    ]
  },
  "reverse": {
    "type": "bool",
    "default": false,
    "description": "Reverse the direction of sort"
  },
  "dirfirst": {
    "type": "bool",
    "default": true,
    "description": "Show directories first above regular files"
  },
  "hiddenfiles": {
    "type": "list",
    "default": [],
    "description": "List of hidden file glob patterns (colon-separated in config)"
  },
  "icons": {
    "type": "bool",
    "default": false,
    "description": "Show icons before each item in the list"
  },
  "preview": {
    "type": "bool",
    "default": true,
    "description": "Show previews of files and directories"
  },
  "previewer": {
    "type": "string",
    "default": "",
    "description": "Path to the previewer script"
  },
  "cleaner": {
    "type": "string",
    "default": "",
    "description": "Path to the cleaner script"
  },
  "period": {
    "type": "number",
    "default": 0,
    "description": "Interval in seconds for periodic directory updates check"
  },
  "watch": {
    "type": "bool",
    "default": false,
    "description": "Watch the filesystem for changes"
  },
  "mouse": {
    "type": "bool",
    "default": false,
    "description": "Send mouse events as input"
  },
  "showbinds": {
    "type": "bool",
    "default": true,
    "description": "Show bindings associated with pressed keys"
  },
  "borderfmt": {
    "type": "string",
    "default": "\\033[0m",
    "description": "Format string of the box drawing characters"
  },
  "promptfmt": {
    "type": "string",
    "default": "\\033[32;1m%u@%h\\033[0m:\\033[34;1m%d\\033[0m\\033[1m%f\\033[0m",
    "description": "Format string of the prompt shown in the top line"
  },
  "rulerfmt": {
    "type": "string",
    "default": " %a| %p| \\033[7;31m %m \\033[0m| \\033[7;33m %c \\033[0m| \\033[7;35m %s \\033[0m| \\033[7;34m %f \\033[0m| %i/%t",
    "description": "Format string of the ruler shown in the bottom right corner"
  },
  "statfmt": {
    "type": "string",
    "default": "\\033[36m%p\\033[0m| %c| %u| %g| %S| %t| -> %l",
    "description": "Format string of the file info shown in the bottom left corner"
  },
  "ratios": {
    "type": "list",
    "default": [],
    "description": "List of integers for pane width ratios (colon-separated in config)"
  },
  "scrolloff": {
    "type": "number",
    "default": 0,
    "description": "Minimum number of offset lines shown at top and bottom"
  },
  "selmode": {
    "type": "string",
    "default": "all",
    "description": "Selection mode for commands",
    "enum": [
      "all",
      "dir"
    ]
  },
  "history": {
    "type": "bool",
    "default": true,
    "description": "Save command history"
  },
  "ignorecase": {
    "type": "bool",
    "default": true,
    "description": "Ignore case in sorting and search patterns"
  },
  "smartcase": {
    "type": "bool",
    "default": true,
    "description": "Override ignorecase when pattern contains uppercase"
  },
  "incsearch": {
    "type": "bool",
    "default": false,
    "description": "Jump to first match after each keystroke during searching"
  },
  "incfilter": {
    "type": "bool",
    "default": false,
    "description": "Apply filter pattern after each keystroke"
  },
  "globfilter": {
    "type": "bool",
    "default": false,
    "description": "Treat filter patterns as globs"
  },
  "globsearch": {
    "type": "bool",
    "default": false,
    "description": "Treat search patterns as globs"
  },
  "wrapscan": {
    "type": "bool",
    "default": true,
    "description": "Searching can wrap around the file list"
  },
  "wrapscroll": {
    "type": "bool",
    "default": false,
    "description": "Scrolling can wrap around the file list"
  },
  "drawbox": {
    "type": "bool",
    "default": false,
    "description": "Draw boxes around panes"
  },
  "roundbox": {
    "type": "bool",
    "default": false,
    "description": "Draw rounded outer corners"
  },
  "copyfmt": {
    "type": "string",
    "default": "\\033[7;33m",
    "description": "Format string for copy indicator"
  },
  "cutfmt": {
    "type": "string",
    "default": "\\033[7;31m",
    "description": "Format string for cut indicator"
  },
  "selectfmt": {
    "type": "string",
    "default": "\\033[7;35m",
    "description": "Format string for selected file indicator"
  },
  "tagfmt": {
    "type": "string",
    "default": "\\033[31m",
    "description": "Format string for tags"
  },
  "errorfmt": {
    "type": "string",
    "default": "\\033[7;31;47m",
    "description": "Format string for error messages"
  },
  "numberfmt": {
    "type": "string",
    "default": "\\033[33m",
    "description": "Format string for position numbers"
  },
  "number": {
    "type": "bool",
    "default": false,
    "description": "Show position numbers"
  },
  "relativenumber": {
    "type": "bool",
    "default": false,
    "description": "Show relative position numbers"
  },
  "info": {
    "type": "list",
    "default": [],
    "description": "List of information types to show (size, time, perm, user, group)"
  },
  "infotimefmtnew": {
    "type": "string",
    "default": "Jan _2 15:04",
    "description": "Time format for recent files"
  },
  "infotimefmtold": {
    "type": "string",
    "default": "Jan _2 2006",
    "description": "Time format for old files"
  },
  "timefmt": {
    "type": "string",
    "default": "Mon Jan _2 15:04:05 2006",
    "description": "Format string for modification time"
  },
  "filesep": {
    "type": "string",
    "default": "\\n",
    "description": "File separator in environment variables"
  },
  "findlen": {
    "type": "number",
    "default": 0,
    "description": "Number of characters prompted for find command"
  },
  "locale": {
    "type": "string",
    "default": "",
    "description": "Locale for sorting"
  },
  "shellopts": {
    "type": "list",
    "default": [],
    "description": "List of shell options"
  },
  "tempmarks": {
    "type": "string",
    "default": "",
    "description": "Temporary marks string"
  },
  "waitmsg": {
    "type": "string",
    "default": "Press any key to continue",
    "description": "Message shown after shell-wait commands"
  },
  "truncatechar": {
    "type": "string",
    "default": "~",
    "description": "Truncation character"
  },
  "truncatepct": {
    "type": "number",
    "default": 100,
    "description": "Percentage of space for beginning of truncated filename"
  },
  "tabstop": {
    "type": "number",
    "default": 8,
    "description": "Tab stop width"
  },
  "autoquit": {
    "type": "bool",
    "default": true,
    "description": "Auto quit server when no clients"
  },
  "dircache": {
    "type": "bool",
    "default": true,
    "description": "Cache directory contents"
  },
  "dircounts": {
    "type": "bool",
    "default": false,
    "description": "Show directory item counts"
  },
  "dironly": {
    "type": "bool",
    "default": false,
    "description": "Show only directories"
  },
  "dirpreviews": {
    "type": "bool",
    "default": false,
    "description": "Preview directories"
  },
  "cursoractivefmt": {
    "type": "string",
    "default": "\\033[7m",
    "description": "Cursor format for active pane"
  },
  "cursorparentfmt": {
    "type": "string",
    "default": "\\033[7m",
    "description": "Cursor format for parent panes"
  },
  "cursorpreviewfmt": {
    "type": "string",
    "default": "\\033[4m",
    "description": "Cursor format for preview panes"
  },
  "dupfilefmt": {
    "type": "string",
    "default": "%f.~%n~",
    "description": "Format for duplicate file names"
  },
  "preserve": {
    "type": "list",
    "default": [
      "mode"
    ],
    "description": "List of attributes to preserve during copy"
  },
  "sixel": {
    "type": "bool",
    "default": false,
    "description": "Enable sixel image rendering"
  },
  "ignoredia": {
    "type": "bool",
    "default": true,
    "description": "Ignore diacritics in sorting/search"
  },
  "smartdia": {
    "type": "bool",
    "default": false,
    "description": "Smart diacritics override"
  },
  "user_options": {
    "type": "string",
    "default": "",
    "description": "User-defined options map (key: value)"
  },
  "key_mappings": {
    "type": "string",
    "default": "",
    "description": "Key mappings map (key: command)"
  },
  "cmap_mappings": {
    "type": "string",
    "default": "",
    "description": "Command-line key mappings map (key: command)"
  },
  "custom_commands": {
    "type": "string",
    "default": "",
    "description": "Custom commands map (name: command)"
  }
}
