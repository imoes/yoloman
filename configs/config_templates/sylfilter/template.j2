#!/bin/bash
# SylFilter wrapper script configuration
#
# This script is generated by Ansible to execute sylfilter with the correct
# flags based on the provided schema defaults and variables. It acts as a
# self-contained invocation wrapper.
#
# === Variable Documentation ===
# The following variables are derived from the Ansible role schema.
# All variables use Jinja2 `default()` filters to ensure valid shell syntax
# even if the variable is undefined in the play.

# Path to the sylfilter executable binary.
# Schema: sylfilter_bin (string)
# Default: /usr/bin/sylfilter
SYLFILTER_BIN="{{ sylfilter_bin | default('/usr/bin/sylfilter') }}"

# Directory path where sylfilter stores its .db files.
# Schema: db_path (string)
# Default: /root/.sylfilter
DB_PATH="{{ db_path | default('/root/.sylfilter') }}"

# The key-value store engine to use.
# Options: QDBM, SQLite
# Schema: kv_engine (string)
# Default: QDBM
KV_ENGINE="{{ kv_engine | default('QDBM') }}"

# Filtering method.
# 'n' = Paul Graham (Naive Bayes)
# 'r' = Gary Robinson (Robinson-Fisher)
# Schema: method (string)
# Default: r
METHOD="{{ method | default('r') }}"

# Minimum deviation threshold.
# Ignore scores near this value.
# Schema: min_dev (string)
# Default: 0.1
MIN_DEV="{{ min_dev | default('0.1') }}"

# Robinson's s parameter.
# Only effective when method is 'r'.
# Schema: rob_s (string)
# Default: 1.0
ROB_S="{{ rob_s | default('1.0') }}"

# Robinson's x parameter.
# Only effective when method is 'r'.
# Schema: rob_x (string)
# Default: 0.5
ROB_X="{{ rob_x | default('0.5') }}"

# Do not bias probability for clean mail.
# Only effective if method is 'n'.
# Schema: no_bias (boolean)
# Default: False
NO_BIAS="{{ no_bias | default(False) }}"

# Show verbose messages.
# Schema: verbose (boolean)
# Default: False
VERBOSE="{{ verbose | default(False) }}"

# Show debug messages.
# Schema: debug (boolean)
# Default: False
DEBUG="{{ debug | default(False) }}"

# === Command Construction ===

# Initialize flags
ENGINE_FLAG=""
METHOD_FLAG=""
BIAS_FLAG=""
EXTRA_FLAGS=""

# Determine engine flag (-E)
# If kv_engine is explicitly set to a non-default value, include the flag.
# Default is QDBM, which is often the implicit default for sylfilter,
# but we include it if the user overrides it to ensure correctness.
{% if kv_engine | default('QDBM') != 'QDBM' %}
ENGINE_FLAG="-E {{ kv_engine | default('QDBM') }}"
{% endif %}

# Determine method flag (-m)
# Method is required. Always include -m to ensure explicit selection.
METHOD_FLAG="-m {{ method | default('r') }}"

# Determine bias flag (-B)
# Only applicable if method is 'n' and no_bias is true.
{% if no_bias | default(False) and method | default('r') == 'n' %}
BIAS_FLAG="-B"
{% endif %}

# Construct the base command
# Sylfilter syntax: sylfilter [-E engine] [-p path] [-m method] [--min-dev dev] [--robs s] [--robx x] [-v] [-d]
CMD="${SYLFILTER_BIN} ${ENGINE_FLAG} -p ${DB_PATH} ${METHOD_FLAG} --min-dev ${MIN_DEV}"

# Add Robinson-specific parameters if method is Robinson ('r')
# We check if the values differ from the schema defaults to avoid cluttering
# the command with unnecessary flags, though including them is also safe.
{% if method | default('r') == 'r' %}
    {% if rob_s | default('1.0') != '1.0' %}
        CMD="${CMD} --robs {{ rob_s | default('1.0') }}"
    {% endif %}
    {% if rob_x | default('0.5') != '0.5' %}
        CMD="${CMD} --robx {{ rob_x | default('0.5') }}"
    {% endif %}
{% endif %}

# Add verbosity/debug flags
{% if verbose | default(False) %}
CMD="${CMD} -v"
{% endif %}

{% if debug | default(False) %}
CMD="${CMD} -d"
{% endif %}

# Execute sylfilter with any additional arguments passed to this script.
# The script is designed to be called as: sylfilter_wrapper.sh [message ...]
# or invoked via pipe.
eval "${CMD} $@"