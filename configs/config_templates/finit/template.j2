# =============================================================================
# /etc/finit.conf: Finit System Init Configuration
# =============================================================================
# This file configures the Finit init system. Finit is a lightweight,
# POSIX-compatible init system designed to be fast and simple.
#
# Self-documenting template generated by Ansible.
# All variables are sourced from the provided schema with safe defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Loglevel: Console logging verbosity.
# 0 = Silent
# 1 = Errors
# 2 = Warnings
# 3 = Info (recommended default)
# -----------------------------------------------------------------------------
loglevel {{ loglevel | default(3) }}

# -----------------------------------------------------------------------------
# Syslog Enable: Enable Finit’s internal syslog helper for kernel and service
# logging. When enabled, Finit attempts to log messages to the system syslog.
# -----------------------------------------------------------------------------
{% if syslog_enable | default(False) %}
# Enable internal syslog helper
syslog-enable
{% else %}
# Disable internal syslog helper
syslog-disable
{% endif %}

# -----------------------------------------------------------------------------
# Console Device: The console device to use for kernel/service output.
# Examples: /dev/console, /dev/ttyS0.
# Leave empty to use the kernel default.
# -----------------------------------------------------------------------------
{% if console_device | default('') | length > 0 %}
# Console device for output
console {{ console_device | default('') }}
{% endif %}

# -----------------------------------------------------------------------------
# Hostname: Set the system hostname at boot.
# Overrides the kernel command line hostname if specified.
# -----------------------------------------------------------------------------
{% if hostname | default('') | length > 0 %}
# System hostname
hostname {{ hostname | default('') }}
{% endif %}

# -----------------------------------------------------------------------------
# Runlevel Default: The default runlevel to jump to after the bootstrap
# phase (runlevel S) is complete.
# -----------------------------------------------------------------------------
# Default runlevel to start after bootstrap
runlevel {{ runlevel_default | default(2) }}

# -----------------------------------------------------------------------------
# Runlevels Definition: Define custom runlevels and the services associated
# with each. Each entry specifies a runlevel number and a list of service
# names to activate when that runlevel is entered.
# -----------------------------------------------------------------------------
{% for rl in runlevels | default([{'number': 3, 'services': ['network', 'sshd', 'crond']}, {'number': 5, 'services': ['network', 'sshd', 'crond', 'display-manager']}]) %}
# Runlevel {{ rl.number | default(0) }}: Activate services {{ rl.services | default([]) | join(', ') }}
{% for service_name in rl.services | default([]) %}
# Service {{ service_name }} in runlevel {{ rl.number | default(0) }}
# Note: Service definitions are typically handled in /etc/finit.d/ or the services block below.
{% endfor %}
{% endfor %}

# -----------------------------------------------------------------------------
# Services Definition: List of system services managed by Finit.
# Each service block defines:
# - name: Service identifier
# - cmd: The command to execute
# - pidfile: Path to the PID file (optional)
# - network_required: If true, wait for network before starting
# - early_boot: If true, start during bootstrap phase
# - depends_on: Service(s) this service depends on
# - restart_delay: Delay in seconds before restarting
# - start_timeout: Timeout in seconds for start
# - restart_limit: Maximum restart attempts
# -----------------------------------------------------------------------------
{% for svc in services | default([{'name': 'network', 'cmd': '/usr/sbin/networkctl enable --global', 'pidfile': '/run/network/networkctl.pid', 'network_required': True, 'early_boot': False}, {'name': 'sshd', 'cmd': '/usr/sbin/sshd -D', 'restart_delay': 3, 'start_timeout': 5, 'restart_limit': 3}, {'name': 'crond', 'cmd': '/usr/sbin/crond -n', 'depends_on': 'network'}]) %}
# =============================================================================
# Service: {{ svc.name | default('unknown') }}
# Description: Managed service defined in finit.conf
# =============================================================================

# Command to run for {{ svc.name | default('unknown') }}
start {{ svc.cmd | default('') }}

{% if svc.pidfile | default('') | length > 0 %}
# PID file path for {{ svc.name | default('unknown') }}
pidfile {{ svc.pidfile | default('') }}
{% endif %}

{% if svc.network_required | default(False) %}
# Network must be up before starting {{ svc.name | default('unknown') }}
network
{% endif %}

{% if svc.early_boot | default(False) %}
# Start {{ svc.name | default('unknown') }} during early boot phase
early
{% endif %}

{% if svc.restart_delay | default(0) > 0 %}
# Restart delay for {{ svc.name | default('unknown') }} (seconds)
restart-delay {{ svc.restart_delay | default(0) }}
{% endif %}

{% if svc.start_timeout | default(0) > 0 %}
# Start timeout for {{ svc.name | default('unknown') }} (seconds)
start-timeout {{ svc.start_timeout | default(0) }}
{% endif %}

{% if svc.restart_limit | default(0) > 0 %}
# Maximum restart limit for {{ svc.name | default('unknown') }}
restart-limit {{ svc.restart_limit | default(0) }}
{% endif %}

{% if svc.depends_on | default('') | length > 0 %}
# Dependencies for {{ svc.name | default('unknown') }}
depends-on {{ svc.depends_on | default('') }}
{% endif %}

# End of service definition for {{ svc.name | default('unknown') }}
# -----------------------------------------------------------------------------
{% endfor %}