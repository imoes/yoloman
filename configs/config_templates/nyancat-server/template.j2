# Configuration for nyancat-server telnet service
#
# This template generates a configuration file for the nyancat-server service.
# It controls the TCP listening port, telnet availability, and various
# display/animation parameters for the terminal-based Nyan Cat animation.

# The TCP port for the nyancat-server to listen on
# Default: 3000
PORT={{ (values | default({})).port | default(3000) }}

# Enable telnet mode for remote connections
# Default: True
TELNET_ENABLED={{ (values | default({})).telnet_enabled | default(True) }}

# Show introduction/about information on startup
# Default: False
SHOW_INTRO={{ (values | default({})).show_intro | default(False) }}

# Number of frames to display before quitting (0 for infinite loop)
# Default: 0
FRAMES={{ (values | default({})).frames | default(0) }}

# Crop the animation to the given width in columns
# Default: 80
WIDTH={{ (values | default({})).width | default(80) }}

# Crop the animation to the given height in rows
# Default: 24
HEIGHT={{ (values | default({})).height | default(24) }}

# Display the animation timer
# Default: True
DISPLAY_COUNTER={{ (values | default({})).display_counter | default(True) }}

# Set the terminal titlebar text
# Default: True
SET_TITLE={{ (values | default({})).set_title | default(True) }}

# Clear the display between animation frames
# Default: True
CLEAR_DISPLAY={{ (values | default({})).clear_display | default(True) }}