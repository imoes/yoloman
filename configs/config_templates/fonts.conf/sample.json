{
  "default_font_dirs": [
    "/usr/share/fonts",
    "/usr/local/share/fonts"
  ],
  "font_dirs": [
    "/home/user/.local/share/fonts"
  ],
  "alias_font_names": [
    {
      "family": "serif",
      "fallback": [
        "DejaVu Serif",
        "Liberation Serif",
        "Times New Roman"
      ]
    },
    {
      "family": "sans-serif",
      "fallback": [
        "DejaVu Sans",
        "Liberation Sans",
        "Noto Sans"
      ]
    },
    {
      "family": "monospace",
      "fallback": [
        "DejaVu Sans Mono",
        "Liberation Mono",
        "Noto Sans Mono"
      ]
    }
  ],
  "enable_hinting": true,
  "enable_antialiasing": true,
  "hint_style": "hintslight",
  "subpixel_rendering": "rgb",
  "prefer_embedded_bitmaps": false
}
