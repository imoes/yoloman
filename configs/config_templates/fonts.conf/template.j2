<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Fontconfig configuration file for system-wide font settings -->
<fontconfig>
{% if default_font_dirs | length > 0 %}
  <!-- Default font directories to scan -->
  {% for dir in default_font_dirs %}
  <dir>{{ dir }}</dir>
  {% endfor %}
{% endif %}
{% if font_dirs | length > 0 %}
  <!-- Additional user-defined font directories to scan -->
  {% for dir in font_dirs %}
  <dir>{{ dir }}</dir>
  {% endfor %}
{% endif %}
{% if alias_font_names | length > 0 %}
  <!-- Font aliases for common family names -->
  {% for alias in alias_font_names %}
  <alias>
    <family>{{ alias.family }}</family>
    {% if alias.fallback | length > 0 %}
    <prefer>
      {% for fallback in alias.fallback %}
      <family>{{ fallback }}</family>
      {% endfor %}
    </prefer>
    {% endif %}
  </alias>
  {% endfor %}
{% endif %}
  <!-- Enable hinting and antialiasing by default -->
  <match target="font">
    {% if enable_hinting | bool %}
    <edit name="hinting" mode="assign">
      <bool>true</bool>
    </edit>
    {% endif %}
    {% if enable_antialiasing | bool %}
    <edit name="antialias" mode="assign">
      <bool>true</bool>
    </edit>
    {% endif %}
    {% if hint_style != "none" %}
    <edit name="hintstyle" mode="assign">
      <const>{{ hint_style }}</const>
    </edit>
    {% endif %}
  </match>
  <!-- Subpixel rendering settings -->
  {% if subpixel_rendering | length > 0 %}
  <match target="font">
    <edit name="rgba" mode="assign">
      <const>{{ subpixel_rendering }}</const>
    </edit>
  </match>
  {% endif %}
  <!-- Prefer embedded bitmap fonts only when requested -->
  {% if prefer_embedded_bitmaps | bool %}
  <match target="font">
    <edit name="embeddedbitmap" mode="assign">
      <bool>true</bool>
    </edit>
  </match>
  {% else %}
  <match target="font">
    <edit name="embeddedbitmap" mode="assign">
      <bool>false</bool>
    </edit>
  </match>
  {% endif %}
</fontconfig>