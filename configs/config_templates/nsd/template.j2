# NSD configuration file (nsd.conf(5)). Built on the file Debian ships: a `server:` clause with indented options
# and the include of /etc/nsd/nsd.conf.d. Options are written only when set. The earlier template had no clause
# header and options nsd does not know (log-level, log-queries, interface a:p, remote-control as an option) —
# nsd-checkconf: "syntax error", nsd refused to start.

server:
        # log only to syslog.
        log-only-syslog: {{ (log_only_syslog | default(true) | bool) | ternary('yes', 'no') }}
{% if server_count is defined and server_count is not none %}        server-count: {{ server_count }}
{% endif %}{% if verbosity is defined and verbosity is not none %}        verbosity: {{ verbosity }}
{% endif %}{% if zones_dir is defined and zones_dir %}        zonesdir: "{{ zones_dir }}"
{% endif %}{% if pidfile_path is defined and pidfile_path %}        pidfile: "{{ pidfile_path }}"
{% endif %}{% if chroot_path is defined and chroot_path %}        chroot: "{{ chroot_path }}"
{% endif %}{% if tcp_count is defined and tcp_count is not none %}        tcp-count: {{ tcp_count }}
{% endif %}{% if tcp_query_count is defined and tcp_query_count is not none %}        tcp-query-count: {{ tcp_query_count }}
{% endif %}{% if tcp_timeout is defined and tcp_timeout is not none %}        tcp-timeout: {{ tcp_timeout }}
{% endif %}{% for iface in interfaces | default([]) %}        ip-address: {{ iface.address if iface is mapping else iface }}{% if iface is mapping and iface.port is defined and iface.port %}@{{ iface.port }}{% endif %}
{% endfor %}
{% if remote_control_enable | default(false) | bool %}remote-control:
        control-enable: yes
        control-interface: {{ remote_control_interface | default('127.0.0.1') }}
        control-port: {{ remote_control_port | default(8952) }}
{% if remote_control_key_file is defined and remote_control_key_file %}        server-key-file: "{{ remote_control_key_file }}"
{% endif %}{% if remote_control_cert_file is defined and remote_control_cert_file %}        server-cert-file: "{{ remote_control_cert_file }}"
{% endif %}{% if remote_control_cli_key_file is defined and remote_control_cli_key_file %}        control-key-file: "{{ remote_control_cli_key_file }}"
{% endif %}{% if remote_control_cli_cert_file is defined and remote_control_cli_cert_file %}        control-cert-file: "{{ remote_control_cli_cert_file }}"
{% endif %}
{% endif %}{% for zone in zones | default([]) %}zone:
        name: "{{ zone.name }}"
        zonefile: "{{ zone.zonefile }}"
{% endfor %}

# The following line includes additional configuration files from the
# /etc/nsd/nsd.conf.d directory.

include: "/etc/nsd/nsd.conf.d/*.conf"
