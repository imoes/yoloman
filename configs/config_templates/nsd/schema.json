{
  "log_only_syslog": {
    "type": "bool",
    "default": true,
    "description": "Log only to syslog (the shipped setting)."
  },
  "server_count": {
    "type": "number",
    "default": null,
    "description": "Number of NSD server processes (unset: nsd's 1)."
  },
  "verbosity": {
    "type": "number",
    "default": null,
    "description": "Log verbosity 0\u20135 (unset: nsd's 0)."
  },
  "zones_dir": {
    "type": "string",
    "default": null,
    "description": "Base directory for zone files (unset: nsd's default)."
  },
  "pidfile_path": {
    "type": "string",
    "default": null,
    "description": "PID file (unset: the package's)."
  },
  "chroot_path": {
    "type": "string",
    "default": null,
    "description": "chroot directory (unset: no chroot)."
  },
  "tcp_count": {
    "type": "number",
    "default": null,
    "description": "Maximum concurrent TCP connections per process."
  },
  "tcp_query_count": {
    "type": "number",
    "default": null,
    "description": "Maximum queries per TCP connection (0 = unlimited)."
  },
  "tcp_timeout": {
    "type": "number",
    "default": null,
    "description": "TCP timeout in seconds."
  },
  "interfaces": {
    "type": "list",
    "default": [],
    "description": "Addresses to listen on, each an address or {address, port} (empty: all)."
  },
  "remote_control_enable": {
    "type": "bool",
    "default": false,
    "description": "Enable the nsd-control remote-control interface."
  },
  "remote_control_interface": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "remote-control: control-interface."
  },
  "remote_control_port": {
    "type": "number",
    "default": 8952,
    "description": "remote-control: control-port."
  },
  "remote_control_key_file": {
    "type": "string",
    "default": null,
    "description": "remote-control: server-key-file."
  },
  "remote_control_cert_file": {
    "type": "string",
    "default": null,
    "description": "remote-control: server-cert-file."
  },
  "remote_control_cli_key_file": {
    "type": "string",
    "default": null,
    "description": "remote-control: control-key-file."
  },
  "remote_control_cli_cert_file": {
    "type": "string",
    "default": null,
    "description": "remote-control: control-cert-file."
  },
  "zones": {
    "type": "list",
    "default": [],
    "description": "Zones, each {name, zonefile}."
  }
}
