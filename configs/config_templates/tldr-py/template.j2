# Absolute path to the local tldr pages repository cache.
repo_path: {{ repo_path | default('~/.tldr') }}

# Target operating system platform for page resolution (linux, osx, or sunos).
platform: {{ platform | default('linux') }}

# Locale/language code for page lookup (e.g., en, zh).
locale: {{ locale | default('en') }}

# Path to the directory where the tldr-py configuration file resides.
config_path: {{ config_path | default('~/.config/tldr') }}

# Enable verbose logging output for debugging purposes.
verbose: {{ verbose | default(False) }}

# List of git repository URLs to fetch tldr pages from.
repositories:
{% for repo in repositories | default(['https://github.com/tldr-pages/tldr.git']) %}
  - {{ repo }}
{% endfor %}