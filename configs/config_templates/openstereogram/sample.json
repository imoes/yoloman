{
  "verbose": false,
  "work_dir": "/var/cache/openstereogram/work",
  "output_dir": "/var/www/stereograms",
  "output_format": "png",
  "rendering": {
    "worker_threads": 6,
    "min_depth_res": 128,
    "max_depth_res": 512,
    "auto_depth_scale": true,
    "depth_scale": 0.85,
    "eye_separation": 12,
    "focal_distance": 400
  },
  "gui": {
    "host": "0.0.0.0",
    "port": 8080,
    "auto_open_browser": false,
    "api_secret": "supersecretkey123",
    "allowed_origins": [
      "http://stereograms.example.com",
      "https://app.internal"
    ]
  },
  "filters": [
    {
      "name": "normalize_depth",
      "enabled": true,
      "params": {
        "clamp_min": 0.05,
        "clamp_max": 0.95
      }
    },
    {
      "name": "denoise",
      "enabled": true,
      "params": {
        "strength": 15
      }
    }
  ],
  "security": {
    "local_only": false,
    "max_input_pixels_mpx": 25
  }
}
