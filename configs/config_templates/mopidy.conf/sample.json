{
  "core.timeout": 10,
  "logging.log_file": "/var/log/mopidy/mopidy.log",
  "logging.log_level": "info",
  "logging.log_format": "%(levelname)-8s %(asctime)s [%(processName)s:%(process)d] %(name)s: %(message)s",
  "file.enabled": true,
  "file.media_dir": "/var/lib/mopidy/media",
  "file.scan_directories": [
    "/var/lib/mopidy/media"
  ],
  "file.scan_timeout": 30,
  "file.scan_depth": 1,
  "file.follow_symlinks": false,
  "http.enabled": true,
  "http.hostname": "0.0.0.0",
  "http.port": 6680,
  "http.allow_cors": false,
  "http.max_request_size": 1048576,
  "stream.enabled": true,
  "stream.timeout": 5,
  "stream.buffer_size": 409600,
  "mpd.enabled": true,
  "mpd.hostname": "0.0.0.0",
  "mpd.port": 6600,
  "mpd.max_connections": 20,
  "mpd.password": "",
  "spotify.enabled": true,
  "spotify.username": "user@example.com",
  "spotify.password": "secret_password",
  "spotify.bitrate": 160,
  "spotify.timeout": 10,
  "spotify.offline": false,
  "spotify.volume_normalization": true,
  "spotify.preferred_language": "en",
  "spotify.preferred_quality": "high",
  "spotify.devices": [
    {
      "name": "Living Room Speaker",
      "id": "0123456789abcdef0123456789abcdef01234567"
    }
  ],
  "local.enabled": true,
  "local.media_dir": "/var/lib/mopidy/media",
  "local.data_dir": "/var/lib/mopidy/local",
  "local.max_workers": 10,
  "local.scan_timeout": 30,
  "local.scan_depth": 1,
  "local.scan_directories": [
    "/var/lib/mopidy/media"
  ],
  "local.follow_symlinks": false,
  "iris.enabled": true,
  "iris.api_key": "",
  "bandcamp.enabled": false,
  "bandcamp.search_language": "en"
}
