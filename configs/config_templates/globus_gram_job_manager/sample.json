{
  "listen_host": "10.1.2.3",
  "listen_port": 2119,
  "auth_method": "gridftp",
  "proxy_cert_path": "/etc/globus/hostcert.pem",
  "proxy_key_path": "/etc/globus/hostkey.pem",
  "ca_cert_dir": "/etc/globus/certificates",
  "verbose": false,
  "log_file": "/var/log/globus/gram-job-manager.log",
  "max_jobs": 500,
  "max_queue_depth": 2000,
  "gridftp_endpoints": [
    {
      "host": "staging.example.org",
      "port": 2811,
      "description": "Primary staging GridFTP server"
    },
    {
      "host": "backup-staging.example.org",
      "port": 2812,
      "description": "Backup staging server (delegated proxy)",
      "proxy_mode": "delegate"
    }
  ],
  "jobmanager_types": [
    "jobmanager",
    "jobmanager+pbs"
  ],
  "job_wrapper_path": "/usr/libexec/globus/globus-job-wrapper.sh",
  "resource_manager_plugin": "pbs",
  "resource_manager_config_path": "/etc/globus/pbs-resource-manager.conf",
  "gsh_enabled": true,
  "gsh_shell": "/bin/bash",
  "gsh_working_dir": "/tmp",
  "service_hostname": "grid.example.org",
  "service_port": 8443,
  "ssl_enabled": true,
  "ssl_cert_path": "/etc/globus/hostcert.pem",
  "ssl_key_path": "/etc/globus/hostkey.pem"
}
