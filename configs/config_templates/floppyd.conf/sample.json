{
 "allowed_hosts": [
  "localhost",
  "floppy.internal",
  "10.0.0.5"
 ],
 "cache_dir": "/var/lib/floppyd/cache",
 "host": "0.0.0.0",
 "io_timeout": 30,
 "max_concurrent_ops": 10,
 "mount_options": {
  "cache": false,
  "ro": true
 },
 "port": 8080,
 "rate_limit_max_rpm": 30,
 "rate_limiting_enabled": true,
 "tls_cert_path": "/etc/ssl/certs/floppyd.crt",
 "tls_enabled": true,
 "tls_key_path": "/etc/ssl/private/floppyd.key",
 "verbose": true
}
