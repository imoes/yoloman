{
  "greylist_enabled": true,
  "timeout": 300,
  "autowhite_delay": 600,
  "dbfile": "/var/db/milter-greylist/greylist.db",
  "socket_path": "/var/run/milter-greylist/milter-greylist.sock",
  "user": "mailnull",
  "group": "mailnull",
  "max_connections": 100,
  "log_level": 1,
  "whitelist_networks": [
    "127.0.0.0/8",
    "::1",
    "10.0.0.0/8"
  ],
  "whitelist_senders": [
    "noreply@trusted.example.com",
    "@gmail.com"
  ],
  "greylist_exceptions": [
    {
      "name": "Known-good relay",
      "match": [
        "ip",
        "192.168.1.1"
      ]
    },
    {
      "name": "Internal MX",
      "match": [
        "header",
        "X-Originating-IP",
        "10.1.2.3"
      ]
    }
  ],
  "greylist_delay": 300,
  "autowhite_life": 86400,
  "pidfile": "/var/run/milter-greylist.pid",
  "use_dnsbl": true
}
