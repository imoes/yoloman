#!/bin/bash

# ==============================================================================
# whiptail Configuration Template
# ==============================================================================
# This template generates a bash script that invokes the `whiptail` command-line
# utility to display ncurses-based dialog boxes.
#
# Supported dialog types:
#   msgbox, yesno, inputbox, passwordbox, textbox, menu, checklist, radiolist,
#   infobox, gauge.
# ==============================================================================

whiptail \
    # {{ dialog_type | default('msgbox') }}: The type of dialog box to display (yesno, msgbox, inputbox, passwordbox, textbox, menu, checklist, radiolist, infobox, gauge).
    {% if dialog_type | default('msgbox') == 'yesno' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    --yesno "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }}

    {% elif dialog_type | default('msgbox') == 'msgbox' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    --msgbox "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }}

    {% elif dialog_type | default('msgbox') == 'inputbox' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    # {{ init_text | default('') }}: Initial text for inputbox or passwordbox widgets.
    --inputbox "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }} "{{ init_text | default('') }}"

    {% elif dialog_type | default('msgbox') == 'passwordbox' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    # {{ init_text | default('') }}: Initial text for inputbox or passwordbox widgets.
    --passwordbox "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }} "{{ init_text | default('') }}"

    {% elif dialog_type | default('msgbox') == 'textbox' %}
    # {{ text_file | default('/etc/hostname') }}: Path to the text file for the textbox widget.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    --textbox "{{ text_file | default('/etc/hostname') }}" {{ height | default(10) }} {{ width | default(60) }}

    {% elif dialog_type | default('msgbox') == 'menu' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    # {{ menu_height | default(5) }}: Height of the menu/list portion for menu, checklist, and radiobox types.
    --menu "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }} {{ menu_height | default(5) }} \
    {% for item in (menu_items | default([{'tag': 'opt1', 'description': 'Option One'}, {'tag': 'opt2', 'description': 'Option Two'}])) | default([]) %}
    "{{ item.tag }}" "{{ item.description }}" \
    {% endfor %}

    {% elif dialog_type | default('msgbox') == 'checklist' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    # {{ list_height | default(5) }}: Height of the list portion for checklist and radiolist types.
    --checklist "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }} {{ list_height | default(5) }} \
    {% for item in (checklist_items | default([{'tag': 'pkg1', 'description': 'Package One', 'status': 'off'}, {'tag': 'pkg2', 'description': 'Package Two', 'status': 'on'}])) | default([]) %}
    "{{ item.tag }}" "{{ item.description }}" "{{ item.status }}" \
    {% endfor %}

    {% elif dialog_type | default('msgbox') == 'radiolist' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    # {{ list_height | default(5) }}: Height of the list portion for checklist and radiolist types.
    --radiolist "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }} {{ list_height | default(5) }} \
    {% for item in (radiolist_items | default([{'tag': 'mode1', 'description': 'Mode One', 'status': 'off'}, {'tag': 'mode2', 'description': 'Mode Two', 'status': 'on'}])) | default([]) %}
    "{{ item.tag }}" "{{ item.description }}" "{{ item.status }}" \
    {% endfor %}

    {% elif dialog_type | default('msgbox') == 'infobox' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    --infobox "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }}

    {% elif dialog_type | default('msgbox') == 'gauge' %}
    # {{ text | default('Please confirm your settings.') }}: The main text content of the dialog box.
    # {{ height | default(10) }}: Height of the dialog box in rows.
    # {{ width | default(60) }}: Width of the dialog box in columns.
    # {{ initial_percent | default(0) }}: Initial percentage for the gauge widget.
    --gauge "{{ text | default('Please confirm your settings.') }}" {{ height | default(10) }} {{ width | default(60) }} {{ initial_percent | default(0) }}

    {% else %}
    # WARNING: Unknown dialog_type '{{ dialog_type | default('msgbox') }}'. No arguments generated.
    {% endif %}

    # {{ title | default('Configuration Wizard') }}: Title string displayed at the top of the dialog box.
    {% if title | default('Configuration Wizard') %}
    --title "{{ title | default('Configuration Wizard') }}" \
    {% endif %}

    # {{ backtitle | default('System Setup') }}: Backtitle string displayed on the backdrop at the top of the screen.
    {% if backtitle | default('System Setup') %}
    --backtitle "{{ backtitle | default('System Setup') }}" \
    {% endif %}

    # {{ clear | default(False) }}: Clear the screen on exit.
    {% if clear | default(False) %}
    --clear \
    {% endif %}

    # {{ default_item | default('') }}: Set the default selected item in a menu box.
    {% if default_item | default('') %}
    --default-item "{{ default_item | default('') }}" \
    {% endif %}

    # {{ defaultno | default(False) }}: Open the dialog with the cursor over the No button.
    {% if defaultno | default(False) %}
    --defaultno \
    {% endif %}

    # {{ fullbuttons | default(False) }}: Use full buttons instead of compact buttons.
    {% if fullbuttons | default(False) %}
    --fb \
    {% endif %}

    # {{ nocancel | default(False) }}: Hide the Cancel button.
    {% if nocancel | default(False) %}
    --nocancel \
    {% endif %}

    # {{ yes_button | default('Yes') }}: Text for the Yes button.
    {% if yes_button | default('Yes') %}
    --yes-button "{{ yes_button | default('Yes') }}" \
    {% endif %}

    # {{ no_button | default('No') }}: Text for the No button.
    {% if no_button | default('No') %}
    --no-button "{{ no_button | default('No') }}" \
    {% endif %}

    # {{ ok_button | default('OK') }}: Text for the Ok button.
    {% if ok_button | default('OK') %}
    --ok-button "{{ ok_button | default('OK') }}" \
    {% endif %}

    # {{ cancel_button | default('Cancel') }}: Text for the Cancel button.
    {% if cancel_button | default('Cancel') %}
    --cancel-button "{{ cancel_button | default('Cancel') }}" \
    {% endif %}

    # {{ noitem | default(False) }}: Display tags only, not item strings in menu/checklist/radiolist.
    {% if noitem | default(False) %}
    --noitem \
    {% endif %}

    # {{ notags | default(False) }}: Don't display tags in menu/checklist/radiolist.
    {% if notags | default(False) %}
    --notags \
    {% endif %}

    # {{ separate_output | default(False) }}: Output checklist results one line at a time without quoting.
    {% if separate_output | default(False) %}
    --separate-output \
    {% endif %}

    # {{ output_fd | default(2) }}: File descriptor to direct output to.
    {% if output_fd | default(2) is defined %}
    --output-fd {{ output_fd | default(2) }} \
    {% endif %}

    # {{ scrolltext | default(False) }}: Force display of a vertical scrollbar.
    {% if scrolltext | default(False) %}
    --scrolltext \
    {% endif %}

    # {{ topleft | default(False) }}: Put the window in the top-left corner.
    {% if topleft | default(False) %}
    --topleft \
    {% endif %}