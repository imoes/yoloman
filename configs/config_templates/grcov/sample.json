{
  "paths": [
    "target/coverage/",
    "./src/"
  ],
  "output_types": [
    "lcov",
    "cobertura"
  ],
  "output_path": "/var/tmp/coverage-report",
  "source_dir": "/home/user/project/src",
  "prefix_dir": "/build/",
  "binary_path": "/build/app",
  "llvm_path": "/usr/lib/llvm-14/bin",
  "filter": "covered",
  "ignore": [
    "**/tests/**",
    "**/target/**"
  ],
  "keep_only": [
    "**/*.rs"
  ],
  "path_mapping": "/build/./",
  "branch": true,
  "ignore_not_existing": true,
  "llvm": true,
  "token": "abc123xyz",
  "commit_sha": "a1b2c3d4e5f6",
  "service_name": "github-actions",
  "service_number": "42",
  "service_job_id": "job-12345",
  "service_pull_request": "987",
  "service_flag_name": "linux-coverage",
  "parallel": true,
  "threads": 4,
  "precision": 2,
  "vcs_branch": "main",
  "log": "stderr",
  "log_level": "INFO",
  "excl_line": "// coverage:ignore",
  "excl_start": "// coverage:ignore-start",
  "excl_stop": "// coverage:ignore-stop",
  "excl_br_line": "branch:ignore",
  "excl_br_start": "branch:ignore-start",
  "excl_br_stop": "branch:ignore-stop",
  "no_demangle": false,
  "output_config_file": "/etc/grcov/output-config.json",
  "sort_output_types": [
    "markdown",
    "cobertura"
  ],
  "guess_directory_when_missing": true
}
