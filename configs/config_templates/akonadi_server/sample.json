{
  "sqlite_path": "",
  "mysql_host": "127.0.0.1",
  "mysql_port": 3306,
  "mysql_database": "akonadi",
  "mysql_user": "akonadi",
  "mysql_password": "akonadi_secret",
  "mysql_exec_path": "/usr/bin",
  "debug_enabled": false,
  "sql_logging": false,
  "data_home": "/home/user/.local/share",
  "config_home": "/home/user/.config",
  "cache_home": "/home/user/.cache",
  "runtime_dir": "/run/user/1000/akonadi",
  "connection_timeout": 30,
  "max_reconnection_attempts": 3,
  "enable_migration": true,
  "indexing_enabled": true,
  "batch_size": 1000,
  "max_memory_indexing": 256,
  "polling_interval": 500,
  "search_backend": "Baloo",
  "resource_agents": [
    {
      "name": "Personal Mail",
      "type": "imap",
      "enabled": true,
      "executable_path": ""
    },
    {
      "name": "Local Mail",
      "type": "maildir",
      "enabled": true,
      "executable_path": ""
    },
    {
      "name": "Contacts",
      "type": "kabc",
      "enabled": true,
      "executable_path": ""
    }
  ],
  "fs_monitoring_enabled": true,
  "fs_polling_interval": 5000,
  "mysql_tuning": true,
  "mysql_server_binary": "/usr/sbin/mysqld",
  "mysql_innodb_buffer_pool_size": 512,
  "mysql_innodb_flush_log_at_trx_commit": 2,
  "mysql_innodb_purge_threads": 4,
  "mysql_innodb_read_io_threads": 8,
  "mysql_innodb_write_io_threads": 4,
  "mysql_innodb_thread_concurrency": 0
}
