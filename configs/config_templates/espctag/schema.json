{
  "op": {
    "type": "string",
    "default": "get",
    "description": "Operation mode: 'get' to print tags, 'set' to modify tags (mutually exclusive)",
    "enum": [
      "get",
      "set"
    ]
  },
  "file_names": {
    "type": "bool",
    "default": false,
    "description": "Print file names before each tag output (from -f/--file)"
  },
  "no_field_names": {
    "type": "bool",
    "default": false,
    "description": "Suppress field name prefixes in output (from -n/--field)"
  },
  "print_format": {
    "type": "bool",
    "default": false,
    "description": "Print internal tag format (from -t/--type)"
  },
  "rename_format": {
    "type": "string",
    "default": "",
    "description": "Rename files using FORMAT template (from -r/--rename=FORMAT); uses espctag's %s/%g/%n/%c/%d/%l/%f/%a/%m/%e/% Conversion specifiers"
  },
  "backup_rsn": {
    "type": "bool",
    "default": false,
    "description": "Backup RSN file before modification (from -b/--backup-rsn)"
  },
  "no_error": {
    "type": "bool",
    "default": false,
    "description": "Continue on errors instead of stopping (from -e/--no-error)"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output (from -v/--verbose)"
  },
  "all_fields": {
    "type": "bool",
    "default": false,
    "description": "Select all fields (from -a/--all); cannot be used with --set"
  },
  "song": {
    "type": "string",
    "default": "",
    "description": "Song title (from -S/--song[=SONG_TITLE])"
  },
  "game": {
    "type": "string",
    "default": "",
    "description": "Game title (from -G/--game[=GAME_TITLE])"
  },
  "dumper": {
    "type": "string",
    "default": "",
    "description": "Dumper name (from -N/--dumper[=DUMPER_NAME])"
  },
  "comments": {
    "type": "string",
    "default": "",
    "description": "Comments (from -C/--comments[=COMMENTS])"
  },
  "date": {
    "type": "string",
    "default": "",
    "description": "Dump date in MM/DD/YYYY format (from -D/--date[=MM/DD/YYYY])"
  },
  "length": {
    "type": "string",
    "default": "",
    "description": "Song length (without fade) (from -L/--length[=LENGTH])"
  },
  "fade": {
    "type": "string",
    "default": "",
    "description": "Fadeout length (from -F/--fade[=LENGTH])"
  },
  "artist": {
    "type": "string",
    "default": "",
    "description": "Artist name (from -A/--artist[=ARTIST])"
  },
  "channels": {
    "type": "list",
    "default": [],
    "description": "Channel states as list of 0/1 values (0=enabled, 1=disabled) (from -M/--channels[=CHANNELS])"
  },
  "emulator": {
    "type": "string",
    "default": "",
    "description": "Emulator used for dumping (from -E/--emulator[=EMULATOR])"
  },
  "files": {
    "type": "list",
    "default": [],
    "description": "Input SPC files to process"
  }
}
