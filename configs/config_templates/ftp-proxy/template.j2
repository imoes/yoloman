# =============================================================================
# FTP-Proxy Configuration Template
# =============================================================================
# This file controls the behaviour of the ftp-proxy init script.
# It is parsed as a shell script fragment (variables exported for the init script).
#
# Self-documenting: every variable is accompanied by its schema description.
# All variables use the 'default' filter to ensure safe rendering even if
# the variable is undefined in the Ansible inventory.
# =============================================================================

# ------------------------------------------------------------------------------
# run_daemon: Whether to start ftp-proxy at boot via the init script; set to 'yes' to enable.
# Note: This setting is only used by SysV-style init scripts. On systemd systems,
#       use 'systemctl enable ftp-proxy.service' instead.
# ------------------------------------------------------------------------------
RUN_DAEMON={{ (run_daemon | default('no')) | lower }}