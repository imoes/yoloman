# Global settings
checktimeout = {{ checktimeout }}
checkinterval = {{ checkinterval }}

# Enable/disable logging
verbose = {{ verbose | string | lower }}

# Log file path
logfile = "{{ logfile }}"

# Email alerts
emailalert = {{ emailalert | string | lower }}
emailalertfreq = {{ emailalertfreq }}
emailalertsubject = "{{ emailalertsubject }}"
emailalertfrom = "{{ emailalertfrom }}"
emailalertto = {{ emailalertto | join(', ') }}

# Quiesce (disable) real servers on failure
quiesce = {{ quiesce | string | lower }}

# Default scheduler for all services
scheduler = "{{ scheduler }}"
protocol = "{{ protocol }}"

# Default persistent timeout (seconds)
persistence = {{ persistence }}
persistence_timeout = {{ persistence_timeout }}

# Default network type and gateway (for NAT) - leave empty if not NAT
netmask = {{ netmask | default('255.255.255.255') }}
gateway = {{ gateway | default('') | string | replace("", "") }}

# Service definitions
{% for svc in services %}
# Virtual IP: {{ svc.vip }}:{{ svc.port }} (service group: {{ svc.group | default('none') }})
virtual = {{ svc.vip }}:{{ svc.port }}
{% if svc.group %}group = "{{ svc.group }}"{% endif %}

{% if svc.protocol %}protocol = "{{ svc.protocol }}"{% else %}# inherits global protocol{% endif %}

{% if svc.scheduler %}scheduler = "{{ svc.scheduler }}"{% else %}# inherits global scheduler{% endif %}

{% if svc.quiesce is defined %}quiesce = {{ svc.quiesce | string | lower }}{% else %}# inherits global quiesce{% endif %}

{% if svc.persistence is defined %}persistence = {{ svc.persistence }}{% else %}# inherits global persistence{% endif %}

{% if svc.netmask is defined %}netmask = {{ svc.netmask | default('255.255.255.255') }}{% endif %}

# Real servers for this virtual service
{% for rs in svc.reals %}real = {{ rs.ip }}:{{ rs.port }} {{ 'weight ' ~ rs.weight | default(1) }}{{ ' inet ' ~ rs.family if rs.family else '' }}{{ ' inactive' if rs.inactive | default(false) | string | lower == 'true' else '' }}{{ ' backup' if rs.backup | default(false) | string | lower == 'true' else '' }}
{% endfor %}

{% if svc.checktype == 'http' %}
# HTTP health check configuration
{% if svc.checkpath %}request = "{{ svc.checkpath }}"{% endif %}
{% if svc.httpmethod %}method = "{{ svc.httpmethod | upper }}"{% endif %}
{% if svc.domain %}domain = "{{ svc.domain }}"{% endif %}
{% if svc.receive %}receive = "{{ svc.receive }}"{% endif %}
{% if svc.send %}send = "{{ svc.send }}"{% endif %}
{% if svc.statuscode is defined %}statuscode = {{ svc.statuscode }}{% endif %}
{% elif svc.checktype == 'tcp' or svc.checktype == 'connect' %}
# TCP health check (port connectivity)
# No additional config required beyond real server addresses
{% elif svc.checktype == 'smtp' %}
# SMTP health check
{% if svc.smtpmailfrom %}smtpmailfrom = "{{ svc.smtpmailfrom }}"{% endif %}
{% if svc.smtphelo %}smtphelo = "{{ svc.smtphelo }}"{% endif %}
{% if svc.smtpuser %}smtpuser = "{{ svc.smtpuser }}"{% endif %}
{% if svc.smtppass %}smtppass = "{{ svc.smtppass }}"{% endif %}
{% elif svc.checktype == 'mysql' %}
# MySQL health check
{% if svc.mysqluser %}mysqluser = "{{ svc.mysqluser }}"{% endif %}
{% if svc.mysqlpass %}mysqlpass = "{{ svc.mysqlpass }}"{% endif %}
{% if svc.mysqlport %}mysqlport = {{ svc.mysqlport }}{% endif %}
{% elif svc.checktype == 'pgsql' %}
# PostgreSQL health check
{% if svc.pgsqluser %}pgsqluser = "{{ svc.pgsqluser }}"{% endif %}
{% if svc.pgsqlpass %}pgsqlpass = "{{ svc.pgsqlpass }}"{% endif %}
{% if svc.pgsqlport %}pgsqlport = {{ svc.pgsqlport }}{% endif %}
{% if svc.pgsqldatabase %}pgsqldatabase = "{{ svc.pgsqldatabase }}"{% endif %}
{% endif %}

{% endfor %}
