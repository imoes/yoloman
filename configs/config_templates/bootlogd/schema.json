{
  "DAEMON": {
    "type": "string",
    "default": "/sbin/bootlogd",
    "description": "Path to the bootlogd binary."
  },
  "TMPLOG": {
    "type": "string",
    "default": "/run/bootlog",
    "description": "Temporary file used to store boot messages during early boot."
  },
  "BOOTLOGD_OPTS": {
    "type": "string",
    "default": "-e -c -l /run/bootlog",
    "description": "Command-line options passed to bootlogd."
  },
  "VERBOSE": {
    "type": "string",
    "default": "",
    "description": "If not set to 'no', script outputs status messages."
  }
}
