#
# Apache configuration to serve http-01 ACME challenges responses.
# This is included from the dehydrated-apache2 package, thought to be used
# with dehydrated as packaged in Debian.
#
# Self-documenting enrichment:
# - `acme_challenge_path`: Path to the directory where ACME challenge files are stored.
#   Default: '/var/lib/dehydrated/acme-challenges/'

# Ensure proxy module is available to prevent unauthorized proxying of ACME challenges.
# The '!' directive tells Apache NOT to proxy the following path, leaving it to be
# served by the local Alias/Directory configuration defined below.
<IfModule proxy_module>
    # Do not proxy ACME challenge responses
    ProxyPass /.well-known/acme-challenge/ !
</IfModule>

# Ensure the alias module is loaded so that the Alias directive below works.
# If the module is not already loaded, include its configuration files.
<IfModule !alias_module>
    # Load the alias module, if not loaded already
    Include /etc/apache2/mods-available/alias.load
    Include /etc/apache2/mods-available/alias.conf
</IfModule>

# Define the alias to map the well-known ACME challenge URL path to the local filesystem path.
# The path is taken from the schema field `acme_challenge_path`.
<IfModule alias_module>
    # Serve ACME challenge responses
    Alias /.well-known/acme-challenge/ {{ acme_challenge_path | default('/var/lib/dehydrated/acme-challenges/') }}
</IfModule>

# Configure access permissions for the ACME challenge directory.
# This ensures that Let's Encrypt / ACME servers can read the challenge files
# while preventing directory listing and other security issues.
<Directory {{ acme_challenge_path | default('/var/lib/dehydrated/acme-challenges/') }}>
    # Allow following symbolic links
    Options FollowSymlinks
    # Disable directory listing for security
    Options -Indexes
    # Do not allow .htaccess overrides
    AllowOverride None
    
    # Apache >= 2.4 (mod_authz_core)
    <IfModule mod_authz_core.c>
        # Allow all users to access this directory (required for ACME validation)
        Require all granted
    </IfModule>
    
    # Apache < 2.4 (mod_access_compat)
    <IfModule !mod_authz_core.c>
        # Legacy access control for older Apache versions
        Order Allow,Deny
        Allow from all
    </IfModule>
</Directory>
