#
# =============================================================================
# Apache configuration to serve http-01 ACME challenges responses.
# =============================================================================
#
# Package: dehydrated-apache2
# Purpose: Configures Apache to serve the ACME HTTP-01 challenge files
#          generated by the 'dehydrated' ACME client. This allows Let's
#          Encrypt (or other ACME CAs) to verify domain ownership.
#
# Dependencies:
#   - Requires 'alias' module to be enabled (Alias directive).
#   - Requires 'proxy' module to be enabled (optional ProxyPass exclusion).
#
# Variables:
#   acme_challenge_path: The filesystem path where dehydrated places challenge files.
#

# -----------------------------------------------------------------------------
# Proxy Module Configuration (Optional)
# -----------------------------------------------------------------------------
# If the reverse proxy module is loaded, ensure that ACME challenge requests
# are NOT proxied to a backend, but served locally from the filesystem.
# This prevents the backend from receiving unnecessary challenge validation traffic.
<IfModule proxy_module>
    # Do not proxy ACME challenge responses; handle them locally instead.
    # This ensures the ACME challenge files are served directly by Apache
    # rather than being passed through to a backend application.
    ProxyPass /.well-known/acme-challenge/ !
</IfModule>

# -----------------------------------------------------------------------------
# Alias Module Configuration
# -----------------------------------------------------------------------------
# The Alias directive maps a URL path to a directory on the filesystem.
# We must ensure the 'alias' module is loaded.
# If the module is not loaded, attempt to include its configuration files.
<IfModule !alias_module>
    # Load the alias module if it is not already loaded.
    Include /etc/apache2/mods-available/alias.load
    Include /etc/apache2/mods-available/alias.conf
</IfModule>

# -----------------------------------------------------------------------------
# ACME Challenge Alias
# -----------------------------------------------------------------------------
# Map the URL path /.well-known/acme-challenge/ to the directory where
# dehydrated stores the challenge response files.
# This allows the ACME server to fetch the challenge token via HTTP.
<IfModule alias_module>
    # Serve ACME challenge responses from the configured directory.
    # The path is derived from the acme_challenge_path variable.
    Alias /.well-known/acme-challenge/ {{ acme_challenge_path | default('/var/lib/dehydrated/acme-challenges/') }}
</IfModule>

# -----------------------------------------------------------------------------
# Directory Access Configuration
# -----------------------------------------------------------------------------
# Configure access permissions for the ACME challenge directory.
# This directory must be publicly readable so the ACME CA can fetch challenge files.
# The path matches the alias target.
<Directory {{ acme_challenge_path | default('/var/lib/dehydrated/acme-challenges/') }}>
    # Enable following symbolic links within the challenge directory.
    # This allows challenge files to be symlinks to other locations if needed.
    Options FollowSymlinks
    # Disable directory listing to prevent information leakage.
    # Users should not be able to browse the contents of the challenge directory.
    Options -Indexes
    # Prevent .htaccess files from overriding these settings.
    # Ensures that the security configuration defined here is enforced.
    AllowOverride None

    # Apache 2.4+ Access Control (mod_authz_core)
    # Grant access to everyone for challenge validation.
    # The ACME CA must be able to access the challenge files without authentication.
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>

    # Apache 2.2 Access Control (Legacy)
    # Grant access to everyone for challenge validation.
    # Fallback for older Apache versions that do not support mod_authz_core.
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</Directory>