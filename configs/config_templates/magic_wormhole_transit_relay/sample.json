{
  "bind_address": "0.0.0.0",
  "port": 4000,
  "max_connections_per_client": 50,
  "max_total_connections": 1000,
  "rate_limit_bytes_per_sec": 10485760,
  "tls_enabled": true,
  "tls_cert_path": "/etc/magic-wormhole-transit-relay/cert.pem",
  "tls_key_path": "/etc/magic-wormhole-transit-relay/key.pem",
  "log_level": "info",
  "relay_hostname": "wormhole-relay.example.com",
  "rate_limit_namespaces": [
    {
      "namespace": "production",
      "rate_limit_bytes_per_sec": 20971520
    },
    {
      "namespace": "staging",
      "rate_limit_bytes_per_sec": 5242880
    },
    {
      "namespace": "internal",
      "rate_limit_bytes_per_sec": 0
    }
  ]
}
