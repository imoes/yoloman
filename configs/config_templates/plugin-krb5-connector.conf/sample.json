{
 "admin_server": "admin.example.edu",
 "cache": {
  "enabled": true,
  "path": "/var/cache/krb5-connector",
  "ttl": 600
 },
 "default_ttl": 3600,
 "enabled": true,
 "encryption_types": [
  "aes256-cts-hmac-sha1-96",
  "aes128-cts-hmac-sha1-96"
 ],
 "kdc": "kdc.example.edu",
 "keytab": "/etc/krb5.keytab",
 "krb5_conf": "/etc/krb5.conf",
 "ldap": {
  "base_dn": "dc=example,dc=edu",
  "bind_dn": "cn=krb5-connector,ou=services,dc=example,dc=edu",
  "bind_password": "s3cr3t",
  "enabled": true,
  "group_attr": "memberUid",
  "group_filter": "(&(objectClass=posixGroup)(memberUid=%s))",
  "principal_attr": "krbPrincipalName",
  "uris": [
   "ldap://ldap.example.edu",
   "ldaps://ldap-backup.example.edu"
  ],
  "user_filter": "(&(objectClass=posixAccount)(krbPrincipalName=%s))",
  "username_attr": "uid"
 },
 "log_level": "info",
 "max_ttl": 86400,
 "plugins": {},
 "realm": "EXAMPLE.EDU",
 "service_principal": "HTTP/router@example.edu"
}
