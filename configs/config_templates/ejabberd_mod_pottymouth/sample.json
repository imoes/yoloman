{
  "wordlist_file": "/etc/ejabberd/blacklist.txt",
  "action": "replace",
  "replacement": "[***]",
  "exempt_users": [
    "admin@example.com",
    "moderator@*.example.com"
  ],
  "case_insensitive": true,
  "partial_match": false,
  "log_blocked": true,
  "additional_wordlists": [
    "/etc/ejabberd/slang_blacklist.txt",
    "/etc/ejabberd/profanity_custom.txt"
  ]
}
