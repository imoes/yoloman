{
  "mode": "daemon",
  "host": "0.0.0.0",
  "port": 10041,
  "db_path": "/var/lib/groonga/db",
  "max_connections": 100,
  "request_timeout": 60,
  "log_level": "notice",
  "query_log": true,
  "access_log": true,
  "log_dir": "/var/log/groonga",
  "search_max_n_records": 10000,
  "use_thread_pool": true,
  "n_workers": 4,
  "ssl_enabled": false,
  "ssl_cert_path": "/etc/groonga/ssl/server.crt",
  "ssl_key_path": "/etc/groonga/ssl/server.key",
  "vhosts": [
    {
      "name": "default",
      "host": "0.0.0.0",
      "port": 10041,
      "db_path": "/var/lib/groonga/db/default",
      "ssl_enabled": false,
      "ssl_cert_path": "",
      "ssl_key_path": ""
    }
  ],
  "plugins": [
    {
      "name": "log"
    },
    {
      "name": "status"
    }
  ]
}
