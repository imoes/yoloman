# ==============================================================================
# chiark-backup Configuration Template
# ==============================================================================
# This template generates configuration variables for the chiark-backup system,
# specifically focusing on LVM (Logical Volume Manager) parameters used for
# creating backup storage volumes.
#
# The output format is a series of shell variable assignments or command-line
# arguments depending on how the parent role consumes them. This template
# emits raw values as expected by the upstream script.
# ==============================================================================

# lvm_vg: Name of the LVM volume group to use for backups.
# This defines the storage pool from which logical volumes will be allocated.
{{ lvm_vg | default('') }}

# lvm_lv: Name of the LVM logical volume to use for backups.
# This is the specific volume created within the volume group for storing backup data.
{{ lvm_lv | default('chiark_backup') }}

# lvm_lvsize_opts: Options for specifying the logical volume size.
# Passes size-related arguments (e.g., -L 10G or -l 100%FREE) to the volume creation process.
{{ lvm_lvsize_opts | default('') }}

# lvm_lvtools_opts: Options passed to LVM tools (e.g., lvcreate).
# Default is set to disable automatic snapshot activation (-A n) to prevent unexpected behavior during backup setup.
{{ lvm_lvtools_opts | default('-A n') }}

# lvm_lvcreate_opts: Additional options for the lvcreate command.
# Allows for custom flags not covered by the specific fields above (e.g., --thin).
{{ lvm_lvcreate_opts | default('') }}

# lvm_lvcreate_args: Additional arguments for the lvcreate command.
# Low-level arguments appended directly to the command invocation.
{{ lvm_lvcreate_args | default('') }}