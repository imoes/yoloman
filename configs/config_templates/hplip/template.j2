[hpssd]
# Enable or disable the HP Status Service daemon (hpssd) for device monitoring
hpssd_enable = {{ hpssd_enabled }}

# Path to the HP Status Service PID file
hpssd_pid_file = /var/run/hpssd.pid

# Path to the HP Status Service log file
hpssd_log_file = /var/log/hp/hpssd.log

[hplip]
# Version of the hplip.conf file format (should not be changed manually)
file_version = 9

# Enable or disable the HPLIP automatic discovery of devices on the network
auto_discovery_enabled = {{ auto_discovery_enabled }}

# Default timeout (in seconds) for device discovery operations
discovery_timeout = {{ discovery_timeout }}

# Enable or disable network scanning support (required for network-connected scanners/faxes)
network_scan_enabled = {{ network_scan_enabled }}

# Enable or disable fax support (requires proper modem/fax device setup)
fax_enabled = {{ fax_enabled }}

# Enable or disable printer auto-configuration support
printer_auto_install_enabled = {{ printer_auto_install_enabled }}

# Path to the hpcups driver directory (for HP CUPS drivers)
hpcups_dir = {{ hpcups_dir }}

# Path to the hpijs driver directory (legacy driver support)
hpijs_dir = {{ hpijs_dir }}

# Path to the plugin directory (used for proprietary components)
plugin_path = {{ plugin_path }}

# Enable or disable plugin auto-download (requires internet access)
plugin_download_enabled = {{ plugin_download_enabled }}

# List of allowed USB vendor IDs (by default HP is included, but may be extended)
allowed_usb_ids = {% for id in allowed_usb_ids %}
{{ id }}
{% endfor %}

# List of blacklisted devices (by product ID, e.g., 0x1234:0x5678)
blacklisted_devices = {% for dev in blacklisted_devices %}
{{ dev }}
{% endfor %}

# HPLIP queue directory for job management
queue_dir = /var/spool/hp

# Timeout (in seconds) for device communication operations
device_timeout = {{ device_timeout }}

[refresh]
# Interval (in minutes) to auto-refresh device list
refresh_interval = {{ refresh_interval }}

# Enable or disable automatic refresh of device list
refresh_enabled = {{ refresh_enabled }}

[scan]
# Default scan resolution (in DPI)
default_scan_resolution = {{ default_scan_resolution }}

# Default scan color mode (gray, color, lineart)
default_scan_color_mode = {{ default_scan_color_mode }}

# Enable or disable advanced scan features (e.g., TWAIN support)
advanced_scan_features_enabled = {{ advanced_scan_features_enabled }}

[ fax ]
# Default fax sender name
sender_name = {{ fax_sender_name }}

# Default fax sender fax number
sender_fax_number = {{ fax_sender_fax_number }}

# Enable or disable fax sending over IP (T.38 support)
ip_fax_enabled = {{ ip_fax_enabled }}

[ print ]
# Default print quality (draft, normal, best)
default_print_quality = {{ default_print_quality }}

# Default paper size (a4, letter, legal, etc.)
default_paper_size = {{ default_paper_size }}

# Enable or disable duplex (two-sided) printing by default
duplex_enabled = {{ duplex_enabled }}
