{
  "blacklist": [
    {
      "module": "snd_hda_codec_hdmi"
    },
    {
      "module": "snd_soc_avs"
    }
  ],
  "modprobe_options": [
    {
      "module": "snd_hda_intel",
      "params": [
        "power_save=0",
        "dmic_detect=0"
      ]
    },
    {
      "module": "snd_usb_audio",
      "params": [
        "enable=1",
        "index=2"
      ]
    }
  ],
  "pcm_default": "hw:0,0",
  "card_default": "0",
  "latency_us": 20000,
  "power_save": 0
}
