{
  "archiving": "tgz",
  "beta": true,
  "cache_path_pattern": "",
  "colored_output": "auto",
  "conf_dir": [
    "/usr/share/cdist/conf",
    "~/.cdist/conf"
  ],
  "init_manifest": "",
  "inventory_dir": "~/.cdist/inventory",
  "jobs": 4,
  "local_shell": "/bin/sh",
  "out_path": "/tmp/cdist-output",
  "parallel": 8,
  "remote_copy": "scp",
  "remote_exec": "ssh",
  "remote_out_path": "/tmp/cdist-remote-output",
  "remote_shell": "/bin/sh",
  "save_output_streams": true,
  "timestamp": false,
  "verbosity": "INFO"
}
