{
  "enable_verbose": false,
  "max_recursion": 256,
  "include_dirs": [
    "/etc/apparmor.d",
    "/etc/apparmor.d/local"
  ],
  "include_dirs_verbose": false,
  "include_syntax": "include",
  "helper_dir": "/usr/lib/apparmor",
  "enable_inotify": true,
  "enforce_mode": 1,
  "enable_cache": true,
  "cache_dir": "/run/apparmor/cache",
  "cache_dir_mode": "0755",
  "cache_file_mode": "0644",
  "cache_user": "root",
  "cache_group": "root",
  "enable_networking": true,
  "enable_mount": true,
  "enable_signal": true,
  "enable_hooks": true,
  "debug": false,
  "default_complain": false,
  "use_abstractions": true,
  "abstractions": [
    "common",
    "x11",
    "fonts",
    "nss",
    "mail-common",
    "mail-read"
  ],
  "site_profiles": [
    "/etc/apparmor.d/local/usr.bin.firefox",
    "/etc/apparmor.d/local/usr.sbin.cupsd"
  ]
}
