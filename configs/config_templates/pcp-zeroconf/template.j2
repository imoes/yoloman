# ============================================================================
# pmieconf rules configuration for PCP (Performance Co-Pilot)
# ============================================================================
# This file configures the PMIE (Performance Metrics Interrogator) rules.
# PMIE is responsible for evaluating conditions on metrics and taking actions.
# See pmieconf(5) for detailed documentation on this file format.
#
# Generated by Ansible. Do not edit manually.
# ============================================================================

# --- Rule Definition: {{ rule_name | default('zeroconf.all_threads') }} ---
#
# rule_name: default='zeroconf.all_threads'
# desc='Name of the pmie rule'
# rule_enabled: default=False
# desc='Whether the rule is enabled (yes/no)'
rule	{{ rule_name | default('zeroconf.all_threads') }}
	default	= "$rule$"
	predicate = "some_host ( proc.control.all.threads == 0 )"
	enabled	= {{ rule_enabled | default(False) | lower }}
	version	= 1
	help	=
"Ensure per-thread metrics are exported by the pmdaproc(1)
Performance Metric Domain Agent (PMDA).";

# --- String Variable: {{ rule_string_var | default('rule') }} ---
#
# rule_string_var: default='rule'
# desc='Variable name for the rule description string'
# rule_string_default: default='Enable per-thread proc metrics'
# desc='Default description for the rule variable'
string	{{ rule_string_var | default('rule') }}
	default	= "{{ rule_string_default | default('Enable per-thread proc metrics') }}"
	modify	= no
	display	= no;

# --- Action Expansion String: {{ action_expand_string | default('action_expand') }} ---
#
# action_expand_string: default='action_expand'
# desc='Variable name for the action expansion format'
# action_expand_default: default='threads[%v]@%h'
# desc='Default format string for action expansion'
string	{{ action_expand_string | default('action_expand') }}
	default	= "{{ action_expand_default | default('threads[%v]@%h') }}"
	display	= no
	modify	= no;

# --- Email Expansion String: {{ email_expand_string | default('email_expand') }} ---
#
# email_expand_string: default='email_expand'
# desc='Variable name for the email expansion format'
# email_expand_default: default='host: %h threads=%v'
# desc='Default format string for email expansion'
string	{{ email_expand_string | default('email_expand') }}
	default	= "{{ email_expand_default | default('host: %h threads=%v') }}"
	display	= no
	modify	= no;

# --- Shell Action: {{ shell_action_var | default('all_threads_action') }} ---
#
# shell_action_var: default='all_threads_action'
# desc='Variable name for the shell action'
# shell_action_enabled: default=True
# desc='Whether the shell action is enabled (yes/no)'
# shell_action_default: default='pmstore proc.control.all.threads 1'
# desc='Default shell command to execute'
shell	{{ shell_action_var | default('all_threads_action') }}
	enabled	= {{ shell_action_enabled | default(True) | lower }}
	default	= "{{ shell_action_default | default('pmstore proc.control.all.threads 1') }}"
	help	=
"The pmdaproc(1) Performance Metrics Domain Agent will receive a
metric store to via pmstore(1) to export threads values as well.";

# --- End of Configuration ---