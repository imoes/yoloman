{#
  imvirt - Virtual Machine / Container Detection Configuration
  This template generates the main configuration file for imvirt.
  imvirt is a utility used to detect whether a system is running
  inside a virtual machine, container, or physical hardware.
  
  Since imvirt has no standard persistent daemon configuration or
  network-facing services, this template provides a placeholder
  for local tuning variables if future versions support them,
  or for storing state/cache configuration.
#}

{# imvirt_debug: Enable verbose/debug output for detection routines.
   Default: false #}
debug_mode = {{ imvirt_debug | default(false) | lower }}

{# imvirt_cache_dir: Directory where imvirt may store detection
   results or intermediate state.
   Default: /var/cache/imvirt #}
cache_dir = {{ imvirt_cache_dir | default('/var/cache/imvirt') }}

{# imvirt_log_level: Logging verbosity. Options: error, warning, info, debug.
   Default: info #}
log_level = {{ imvirt_log_level | default('info') }}