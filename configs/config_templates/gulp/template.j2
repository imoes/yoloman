# ==============================================================================
# Gulp CLI Configuration
# ==============================================================================
# This file documents the command-line options passed to the Gulp task runner.
# It is generated by Ansible based on the 'gulp' role variables.
#
# Refer to `man gulp` or `gulp --help` for detailed descriptions of each flag.
# ==============================================================================

# --- Task Documentation ---
# Field: tasks_list
# Description: List of tasks to document or reference in comment; each item must have
#              'name' and optionally 'description'. Not used by CLI, only for documentation.
# Output: A comment block listing the specified tasks and their descriptions.
{% if tasks_list | default([]) | length > 0 %}
# Task dependency tree will be shown for these tasks:
{% for task in tasks_list | default([]) %}
#   {{ task.name }}{% if task.description %} — {{ task.description }}{% endif %}
{% endfor %}
{% endif %}

# --- Module Pre-loading ---
# Field: require_modules
# Description: List of module paths to pre-load with --require (e.g., ['ts-node/register', '@babel/register']).
# Output: One '--require' flag per module.
{% if require_modules | default([]) | length > 0 %}
# Modules to require before loading the gulpfile (e.g., transpilers):
{% for module in require_modules | default([]) %}
#   --require {{ module }}
{% endfor %}
{% endif %}

# --- Gulpfile Location ---
# Field: custom_gulpfile
# Description: Path to explicit gulpfile. If set, CLI will use this file and set CWD to its directory.
# Output: '--gulpfile' flag pointing to the specified path.
{% if custom_gulpfile | default('') | length > 0 %}
# Explicit path to the gulpfile (overrides default search):
#   --gulpfile {{ custom_gulpfile | default('') }}
{% endif %}

# --- Working Directory ---
# Field: custom_cwd
# Description: Manual working directory (CWD) for gulp execution; affects gulpfile search and relative requires.
# Output: '--cwd' flag pointing to the specified directory.
{% if custom_cwd | default('') | length > 0 %}
# Custom working directory for gulp execution:
#   --cwd {{ custom_cwd | default('') }}
{% endif %}

# --- Logging Control ---
# Field: silent
# Description: If true, disables all logging (--silent).
# Output: '--silent' flag if the variable evaluates to true.
{% if silent | default(False) | bool %}
# Disable all gulp logging:
#   --silent
{% endif %}

# --- Color Output Control ---
# Field: color
# Description: If true, forces color output (--color); if false, forces no color (--no-color).
# Output: '--color' or '--no-color' flag depending on the boolean value.
{% if color | default(True) is sameas true %}
# Force color output (true = always use colors, false = never):
#   --color
{% elif color | default(True) is sameas false %}
# Force no color output (false = never use colors):
#   --no-color
{% endif %}

# --- Plugin Verification ---
# Field: verify_plugins
# Description: If true, enables plugin blacklist verification (--verify).
# Output: '--verify' flag if the variable evaluates to true.
{% if verify_plugins | default(False) | bool %}
# Verify plugins against blacklist:
#   --verify
{% endif %}