{
  "DEBUG": {
    "type": "number",
    "default": 0,
    "description": "Debug mode flag. 0 to disable, 1 to enable."
  },
  "DATA_DIR": {
    "type": "string",
    "default": "/var/lib/sysusage",
    "description": "Directory where monitoring data is stored."
  },
  "PID_DIR": {
    "type": "string",
    "default": "/var/run",
    "description": "Directory where PID files are stored."
  },
  "DEST_DIR": {
    "type": "string",
    "default": "/var/www/sysusage",
    "description": "Document root or destination directory for web output."
  },
  "SAR_BIN": {
    "type": "string",
    "default": "/usr/bin/sar",
    "description": "Path to the sar binary."
  },
  "UPTIME": {
    "type": "string",
    "default": "/usr/bin/uptime",
    "description": "Path to the uptime binary."
  },
  "HOSTNAME": {
    "type": "string",
    "default": "/usr/bin/hostname",
    "description": "Path to the hostname binary."
  },
  "INTERVAL": {
    "type": "number",
    "default": 60,
    "description": "Monitoring interval in seconds."
  },
  "SKIP": {
    "type": "string",
    "default": "",
    "description": "General skip list (comma separated items)."
  },
  "HDDTEMP_BIN": {
    "type": "string",
    "default": "",
    "description": "Path to hddtemp binary. Empty to disable."
  },
  "SENSORS_BIN": {
    "type": "string",
    "default": "",
    "description": "Path to sensors binary. Empty to disable."
  },
  "DAEMON": {
    "type": "number",
    "default": 0,
    "description": "Run as daemon flag. 0 to disable, 1 to enable."
  },
  "GRAPH_WIDTH": {
    "type": "number",
    "default": 800,
    "description": "Width of generated graphs in pixels."
  },
  "GRAPH_HEIGHT": {
    "type": "number",
    "default": 350,
    "description": "Height of generated graphs in pixels."
  },
  "FLAMING": {
    "type": "number",
    "default": 0,
    "description": "Flaming effect flag. 0 to disable, 1 to enable."
  },
  "HIRES": {
    "type": "number",
    "default": 0,
    "description": "High resolution flag. 0 to disable, 1 to enable."
  },
  "LINE_SIZE": {
    "type": "number",
    "default": 1,
    "description": "Line width for graphs."
  },
  "PROC_QSIZE": {
    "type": "number",
    "default": 4,
    "description": "Process/Queue size limit."
  },
  "RESRC_URL": {
    "type": "string",
    "default": "",
    "description": "Resource URL for remote access."
  },
  "SSH_BIN": {
    "type": "string",
    "default": "ssh",
    "description": "Path to SSH binary."
  },
  "SSH_OPTIONS": {
    "type": "string",
    "default": "-o ConnectTimeout=5 -o PreferredAuthentications=hostbased,publickey",
    "description": "SSH connection options string."
  },
  "SSH_USER": {
    "type": "string",
    "default": "",
    "description": "SSH username for remote monitoring. Empty to use default."
  },
  "SSH_IDENTITY": {
    "type": "string",
    "default": "",
    "description": "Path to SSH identity key. Empty to use default."
  },
  "WARN_MODE": {
    "type": "number",
    "default": 0,
    "description": "Alarm warning mode. 0 to disable, 1 to enable."
  },
  "ALARM_PROG": {
    "type": "string",
    "default": "/usr/bin/sysusagewarn",
    "description": "Path to the alarm program."
  },
  "SMTP": {
    "type": "string",
    "default": "localhost",
    "description": "SMTP server hostname or IP."
  },
  "FROM": {
    "type": "string",
    "default": "root@localhost",
    "description": "Email sender address for alarms."
  },
  "TO": {
    "type": "string",
    "default": "root@localhost",
    "description": "Email recipient address for alarms."
  },
  "NAGIOS": {
    "type": "string",
    "default": "",
    "description": "Path to Nagios submit_check_result binary. Empty to disable."
  },
  "UPPER_LEVEL": {
    "type": "number",
    "default": 1,
    "description": "Upper alarm level (Nagios: 0=OK, 1=WARNING, 2=Critical, 3=Unknown)."
  },
  "LOWER_LEVEL": {
    "type": "number",
    "default": 2,
    "description": "Lower alarm level."
  },
  "URL": {
    "type": "string",
    "default": "",
    "description": "URL for alarm notification."
  },
  "SKIP_ALARM": {
    "type": "string",
    "default": "",
    "description": "Skip list for alarm monitoring."
  },
