{
  "server": {
    "port": 13666,
    "host": "",
    "protocol": "hd44780",
    "device": "/dev/lcd0",
    "driver": "hd44780",
    "driver_settings_path": "/etc/lcdproc/hd44780.conf",
    "backlight": "on",
    "screen_change_wait": 1000
  },
  "drivers": [
    {
      "name": "hd44780",
      "options": {
        "Columns": "20",
        "Rows": "4",
        "Charmap": "A00",
        "Delay_mult": "100",
        "Backlight": "yes",
        "Backlight_value": "1"
      }
    }
  ],
  "clients": [
    {
      "name": "lcdproc",
      "group": "lcdproc",
      "screens": [
        "clock",
        "uptime",
        "cpu"
      ]
    },
    {
      "name": "myclient",
      "group": "users",
      "screens": [
        "memory"
      ]
    }
  ]
}
