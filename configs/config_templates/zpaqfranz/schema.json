{
  "command": {
    "type": "string",
    "default": "/usr/bin/zpaqfranz",
    "description": "Absolute path to the zpaqfranz binary."
  },
  "action": {
    "type": "string",
    "default": "a",
    "description": "The command to execute (e.g., 'a' for add, 't' for test, 'i' for info).",
    "enum": [
      "a",
      "autotest",
      "b",
      "backup",
      "c",
      "consolidatebackup",
      "cp",
      "d",
      "dir",
      "dirsize",
      "e",
      "f",
      "find",
      "fzf",
      "i",
      "isopen",
      "k",
      "l",
      "last",
      "last2",
      "m",
      "n",
      "p",
      "password",
      "pause",
      "r",
      "rd",
      "rsync",
      "s",
      "sum",
      "t",
      "testbackup",
      "trim",
      "utf",
      "v",
      "versum",
      "w",
      "x",
      "z",
      "zfsadd",
      "zfsbackup",
      "zfslist",
      "zfsproxbackup",
      "zfsproxrestore",
      "zfspurge",
      "zfsreceive",
      "zfsrestore"
    ]
  },
  "archive_path": {
    "type": "string",
    "default": "/var/backups/mybackup.zpaq",
    "description": "Path to the destination .zpaq archive file."
  },
  "sources": {
    "type": "list",
    "default": [
      "/etc"
    ],
    "description": "List of source files or directories to include in the backup operation."
  },
  "switches": {
    "type": "list",
    "default": [],
    "description": "List of additional command-line switches to pass to zpaqfranz."
  }
}
