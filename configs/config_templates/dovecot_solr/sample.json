  "solr_ssl_verify": true,
  "solr_ssl_cert_path": "/etc/dovecot/solr-client.crt",
  "solr_ssl_key_path": "/etc/dovecot/solr-client.key",
  "solr_ssl_ca_cert_path": "/etc/dovecot/ca.crt"
}
