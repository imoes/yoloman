{
  "cluster_name": {
    "type": "string",
    "default": "ExampleCluster",
    "description": "Set name of the cluster"
  },
  "crypto_cipher": {
    "type": "string",
    "default": "none",
    "description": "Encryption cipher algorithm (none, aes256, aes192, aes128)",
    "enum": [
      "none",
      "aes256",
      "aes192",
      "aes128"
    ]
  },
  "crypto_hash": {
    "type": "string",
    "default": "none",
    "description": "Hash algorithm used for encryption (none, sha1, md5)",
    "enum": [
      "none",
      "sha1",
      "md5",
      "sha256",
      "sha384",
      "sha512"
    ]
  },
  "fileline": {
    "type": "string",
    "default": "off",
    "description": "Log the source file and line where messages are being generated",
    "enum": [
      "off",
      "on"
    ]
  },
  "to_stderr": {
    "type": "string",
    "default": "yes",
    "description": "Log to standard error",
    "enum": [
      "yes",
      "no"
    ]
  },
  "to_logfile": {
    "type": "string",
    "default": "yes",
    "description": "Log to a log file",
    "enum": [
      "yes",
      "no"
    ]
  },
  "logfile": {
    "type": "string",
    "default": "/var/log/cluster/corosync.log",
    "description": "Path to the log file"
  },
  "to_syslog": {
    "type": "string",
    "default": "yes",
    "description": "Log to the system log daemon",
    "enum": [
      "yes",
      "no"
    ]
  },
  "debug": {
    "type": "string",
    "default": "off",
    "description": "Log debug messages (very verbose)",
    "enum": [
      "off",
      "on",
      "trace"
    ]
  },
  "logger_subsys_debug": {
    "type": "string",
    "default": "off",
    "description": "Debug level for QUORUM subsystem"
  },
  "node1_name": {
    "type": "string",
    "default": "node1",
    "description": "Hostname of the first node"
  },
  "node1_nodeid": {
    "type": "number",
    "default": 1,
    "description": "Cluster membership node identifier for the first node"
  },
  "node2_name": {
    "type": "string",
    "default": "node2",
    "description": "Hostname of the second node"
  },
  "node2_nodeid": {
    "type": "number",
    "default": 2,
    "description": "Cluster membership node identifier for the second node"
  }
}
