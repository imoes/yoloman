{
  "log_level": "INFO",
  "log_dir": "/var/log/ceilometer",
  "polling_interval": 60,
  "workers": 4,
  "ceilometer_endpoint": "http://ceilometer-api:8777",
  "auth_url": "http://keystone:5000/v3",
  "project_name": "service",
  "username": "ceilometer",
  "password": "ceilometer_secret_password",
  "region_name": "RegionOne",
  "auth_type": "password",
  "insecure": false,
  "enabled_pollsters": [
    "instance",
    "cpu",
    "memory",
    "disk.root.size"
  ],
  "pollster_configs": [
    {
      "name": "instance",
      "section": "instance",
      "interval": 300
    },
    {
      "name": "cpu",
      "section": "cpu",
      "interval": 60
    }
  ],
  "metric_url": "mongodb://ceilometer:ceilometer_secret_password@localhost:27017/ceilometer?replicaSet=rs0"
}
