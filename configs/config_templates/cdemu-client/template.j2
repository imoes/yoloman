# =============================================================================
# cdemu-client Configuration
# =============================================================================
#
# This file configures the behavior of the cdemu-client tool.
# See `man cdemu-client` or the project documentation for further details.
#
# Location: /etc/cdemu-client.conf or ~/.cdemu-client
# Format: INI-style configuration
# =============================================================================

[defaults]

# -----------------------------------------------------------------------------
# bus: D-Bus bus to connect to.
#
# Specifies whether cdemu-client should communicate with the cdemu-daemon
# via the system-wide D-Bus or the user's session D-Bus.
#
# Allowed values:
#   - 'system': Connect to the system D-Bus (requires root or appropriate
#     polkit permissions).
#   - 'session': Connect to the current user's session D-Bus (typical for
#     desktop environments).
#
# Default: 'session'
# -----------------------------------------------------------------------------
bus={{ bus | default('session') }}

# End of config file
