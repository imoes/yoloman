{
  "no_color": {
    "type": "bool",
    "default": true,
    "description": "Toggle color-code by protocol"
  },
  "counters": {
    "type": "bool",
    "default": false,
    "description": "Toggle display of bytes/packets counters"
  },
  "dst_filter": {
    "type": "string",
    "default": "",
    "description": "Only show states with a destination of IP[/NETMASK]"
  },
  "dstpt_filter": {
    "type": "string",
    "default": "",
    "description": "Only show states with a destination port of port"
  },
  "invert_filters": {
    "type": "bool",
    "default": false,
    "description": "Invert filters to display non-matching results"
  },
  "lookup": {
    "type": "bool",
    "default": false,
    "description": "Show hostnames instead of IP addresses"
  },
  "mark_truncated": {
    "type": "bool",
    "default": false,
    "description": "Mark truncated hostnames with a '+'"
  },
  "no_dynamic": {
    "type": "bool",
    "default": false,
    "description": "Toggle dynamic formatting"
  },
  "no_dns": {
    "type": "bool",
    "default": false,
    "description": "Skip outgoing DNS lookup states"
  },
  "no_loopback": {
    "type": "bool",
    "default": false,
    "description": "Filter states on loopback"
  },
  "no_scroll": {
    "type": "bool",
    "default": false,
    "description": "No scrolling (don't use a 'pad')"
  },
  "reverse": {
    "type": "bool",
    "default": false,
    "description": "Reverse sort order"
  },
  "refresh_rate": {
    "type": "string",
    "default": "",
    "description": "Refresh rate in seconds for statetop mode"
  },
  "single": {
    "type": "bool",
    "default": false,
    "description": "Single run (no curses)"
  },
  "sort_column": {
    "type": "string",
    "default": "S",
    "description": "Sort by column: S (Source Port), d (Dest IP), D (Dest Port), p (Protocol), s (State), t (TTL), b (Bytes), P (Packets)",
    "enum": [
      "S",
      "d",
      "D",
      "p",
      "s",
      "t",
      "b",
      "P"
    ]
  },
  "src_filter": {
    "type": "string",
    "default": "",
    "description": "Only show states with a source of IP[/NETMASK]"
  },
  "srcpt_filter": {
    "type": "string",
    "default": "",
    "description": "Only show states with a source port of port"
  },
  "totals": {
    "type": "bool",
    "default": false,
    "description": "Toggle display of totals"
  }
}
