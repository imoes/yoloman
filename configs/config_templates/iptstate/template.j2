# iptstate command-line options configuration
# Generated from Ansible role. Each variable maps to an iptstate CLI flag.
# See schema field descriptions for details.

IPTSTATE_OPTS="
{# no_color: Toggle color-code by protocol. Default: True (disable colors) #}
{%- if not (no_color | default(True)) %}--no-color {%- endif %}

{# counters: Toggle display of bytes/packets counters. Default: False (hide counters) #}
{%- if counters | default(False) %}--counters {%- endif %}

{# dst_filter: Only show states with a destination of IP[/NETMASK]. Default: '' (none) #}
{%- if dst_filter | default('') %}-d {{ dst_filter | default('') }} {%- endif %}

{# dstpt_filter: Only show states with a destination port of port. Default: '' (none) #}
{%- if dstpt_filter | default('') %}-D {{ dstpt_filter | default('') }} {%- endif %}

{# invert_filters: Invert filters to display non-matching results. Default: False (normal) #}
{%- if invert_filters | default(False) %}--invert-filters {%- endif %}

{# lookup: Show hostnames instead of IP addresses. Default: False (show IPs) #}
{%- if lookup | default(False) %}-l {%- endif %}

{# mark_truncated: Mark truncated hostnames with a '+'. Default: False (no mark) #}
{%- if mark_truncated | default(False) %}--mark-truncated {%- endif %}

{# no_dynamic: Toggle dynamic formatting. Default: False (enable dynamic) #}
{%- if no_dynamic | default(False) %}--no-dynamic {%- endif %}

{# no_dns: Skip outgoing DNS lookup states. Default: False (show DNS) #}
{%- if no_dns | default(False) %}-L {%- endif %}

{# no_loopback: Filter states on loopback. Default: False (include loopback) #}
{%- if no_loopback | default(False) %}-f {%- endif %}

{# no_scroll: No scrolling (don't use a 'pad'). Default: False (scroll) #}
{%- if no_scroll | default(False) %}--no-scroll {%- endif %}

{# reverse: Reverse sort order. Default: False (normal) #}
{%- if reverse | default(False) %}-r {%- endif %}

{# refresh_rate: Refresh rate in seconds for statetop mode. Default: '' (use default) #}
{%- if refresh_rate | default('') %}-R {{ refresh_rate | default('') }} {%- endif %}

{# single: Single run (no curses). Default: False (use curses) #}
{%- if single | default(False) %}-1 {%- endif %}

{# sort_column: Sort by column: S (Source Port), d (Dest IP), D (Dest Port), p (Protocol), s (State), t (TTL), b (Bytes), P (Packets). Default: 'S' #}
{%- if sort_column | default('S') %}-b {{ sort_column | default('S') }} {%- endif %}

{# src_filter: Only show states with a source of IP[/NETMASK]. Default: '' (none) #}
{%- if src_filter | default('') %}-s {{ src_filter | default('') }} {%- endif %}

{# srcpt_filter: Only show states with a source port of port. Default: '' (none) #}
{%- if srcpt_filter | default('') %}-S {{ srcpt_filter | default('') }} {%- endif %}

{# totals: Toggle display of totals. Default: False (hide totals) #}
{%- if totals | default(False) %}--totals {%- endif %}
"