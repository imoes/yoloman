{
  "runtime_path": "/usr/lib/x86_64-linux-gnu/monado",
  "runtimes": [
    "openxr-monado-provider"
  ],
  "max_sessions": 2,
  "enable_composition": true,
  "composition_resolution": "auto",
  "composition_scale": 0.9,
  "enable_vulkan_composition": true,
  "gpu_devices": [
    {
      "path": "/dev/dri/renderD128",
      "description": "NVIDIA GPU (primary)"
    },
    {
      "path": "/dev/dri/card0",
      "description": "Intel iGPU (fallback)"
    }
  ],
  "log_level": "info",
  "syslog": true,
  "stderr": false,
  "raw_input": true,
  "hmd_event_device": ""
}
