{
  "host_name": "node1.example.com",
  "cluster_name": "web_cluster",
  "cluster_members": [
    "node1.example.com",
    "node2.example.com",
    "node3.example.com"
  ],
  "auto_preload": false,
  "auto_expire": true,
  "timeout": 120,
  "port": 30865,
  "log_dir": "/var/log/csync2",
  "log_level": "info",
  "syslog_enabled": true,
  "sync_groups": [
    {
      "name": "web_config",
      "include": [
        "/etc/nginx",
        "/etc/apache2",
        "/var/www"
      ],
      "exclude": [
        "*.log",
        "cache/*"
      ],
      "key_path": "/etc/csync2/key_web_cluster.key",
      "auto": true,
      "check_interval": 60,
      "prefer": "",
      "force": false,
      "use_rsync": true
    },
    {
      "name": "app_data",
      "include": [
        "/var/lib/myapp/db",
        "/var/lib/myapp/cache"
      ],
      "exclude": [],
      "key_path": "/etc/csync2/key_app_data.key",
      "auto": false,
      "check_interval": 0,
      "prefer": "node2.example.com",
      "force": true,
      "use_rsync": true
    }
  ]
}
