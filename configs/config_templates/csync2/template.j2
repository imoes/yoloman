# Hostname of this node (must match DNS and /etc/hosts).
# This value is used to identify the local node in the cluster.
host_name {{ host_name | default('localhost') }}

# Cron job to synchronize all groups and check consistency.
# Format: minute hour day month weekday command
# Runs daily at 04:00 as root.
# -cr: Check and repair the cluster consistency database.
# -T <this> <peer>: Test synchronization with the specified peer node.
0 4 * * * root csync2 -cr / ; csync2 -T {{ host_name | default('localhost') }} <peer-hostname>