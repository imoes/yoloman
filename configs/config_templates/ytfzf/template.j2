# ==============================================================================
# ytfzf Configuration Template
# ==============================================================================
# This file is auto-generated by Ansible. Do not edit manually.
# See ytfzf(1) man page for all available directives.
# ==============================================================================

# -----------------------------------------------------------------------------
# Playback & Download Behavior
# -----------------------------------------------------------------------------

# Whether to download selected videos instead of playing them.
# 0: play (default), 1: download. Maps to --download/-d.
is_download={{ is_download | default('0') }}

# Whether to play audio only (extract audio and discard video).
# 0: off (default), 1: on. Maps to --audio-only/-m.
is_audio_only={{ is_audio_only | default('0') }}

# Whether to detach the video player from the terminal (background the player).
# 0: off (default), 1: on. Maps to --detach.
is_detach={{ is_detach | default('0') }}

# Whether to loop the menu when the video playback ends.
# 0: off (default), 1: on. Maps to --loop/-l.
is_loop={{ is_loop | default('0') }}

# Whether to return to the search menu after closing the fzf interface.
# 0: off (default), 1: on. Maps to --search-again/-s.
search_again={{ search_again | default('0') }}

# -----------------------------------------------------------------------------
# Thumbnails & Notifications
# -----------------------------------------------------------------------------

# Whether to show video thumbnails in the fzf preview window.
# 0: off (default), 1: on. Maps to --show-thumbnails/-t.
show_thumbnails={{ show_thumbnails | default('0') }}

# Whether to download thumbnails asynchronously in the background.
# 0: off, 1: on (default). Maps to --async-thumbnails.
async_thumbnails={{ async_thumbnails | default('1') }}

# Whether to skip downloading thumbnails entirely.
# 0: off (default), 1: on. Maps to --skip-thumb-download.
skip_thumb_download={{ skip_thumb_download | default('0') }}

# Whether to show desktop notifications when a video is about to be played.
# 0: off, 1: on (default). Maps to --notify-playing.
notify_playing={{ notify_playing | default('1') }}

# -----------------------------------------------------------------------------
# Sorting & Display Options
# -----------------------------------------------------------------------------

# Sort videos after scraping by upload date (newest first).
# 0: off (default), 1: on. Maps to --sort.
is_sort={{ is_sort | default('0') }}

# Whether to display a visual separator between different subscriptions/categories.
# 0: off (default), 1: on. Maps to --fancy-subs.
fancy_subs={{ fancy_subs | default('0') }}

# Whether to enable the back button in submenus/navigation.
# 0: disable, 1: enable (default). Maps to --disable-back.
enable_back_button={{ enable_back_button | default('1') }}

# Whether to enable interactive actions (submenus, back button, etc.).
# 0: disable, 1: enable (default). Maps to --disable-actions.
enable_actions={{ enable_actions | default('1') }}

# Whether to enable nested submenus for subscriptions/channels.
# 0: disable, 1: enable (default). Maps to --disable-submenus.
enable_submenus={{ enable_submenus | default('1') }}

# Whether options passed into the main ytfzf invocation persist into submenus.
# 0: off, 1: on (default). Maps to --keep-vars.
keep_vars={{ keep_vars | default('1') }}

# -----------------------------------------------------------------------------
# Interface Configuration
# -----------------------------------------------------------------------------

# The interface engine to use. 'fzf' uses fzf, 'ext' uses an external menu like dmenu.
# Maps to --interface/-i or --external-menu/-D.
interface={{ interface | default('fzf') }}

# The side of the screen where the fzf preview window appears.
# Options: left, right, up, down. Default: right.
# Maps to --preview-side.
fzf_preview_side={{ fzf_preview_side | default('right') }}

# The formatting style of the selection screen.
# Options: normal, simple. Default: normal.
# Maps to --format-selection.
format_selection_screen={{ format_selection_screen | default('normal') }}

# -----------------------------------------------------------------------------
# ytdl / yt-dlp Format Preferences
# -----------------------------------------------------------------------------

# Custom format sorting string for ytdl/yt-dlp.
# Maps to --format-sort.
format_selection_sort={{ format_selection_sort | default('') }}

# Specific video format preference string for ytdl.
# Maps to --video-pref.
video_pref={{ video_pref | default('') }}

# Specific audio format preference string for ytdl.
# Maps to --audio-pref.
audio_pref={{ audio_pref | default('') }}

# General format preference string for ytdl.
# Maps to --ytdl-pref.
ytdl_pref={{ ytdl_pref | default('') }}

# -----------------------------------------------------------------------------
# Info & Debugging
# -----------------------------------------------------------------------------

# Action to perform when info-wait is enabled.
# Options: link, video-json, json, format, raw. Default: link.
# Maps to --info-action.
info_wait_action={{ info_wait_action | default('link') }}

# Whether to pause/wait after printing info (requested via -I or -L).
# 0: off (default), 1: on. Maps to --info-wait.
info_wait={{ info_wait | default('0') }}

# Additional options to pass to the URL handler (e.g., mpv flags).
# Maps to --url-handler-opts.
url_handler_opts={{ url_handler_opts | default('') }}

# Options passed specifically to submenu rendering.
# Maps to --submenu-opts.
submenu_opts={{ submenu_opts | default('') }}

# -----------------------------------------------------------------------------
# Scraping & Search Behavior
# -----------------------------------------------------------------------------

# Number of videos to select automatically with auto-select mode.
# Maps to --link-count/-n. Default: 1.
link_count={{ link_count | default('1') }}

# Amount of pages to scrape/search.
# Maps to --pages. Default: 1.
pages_to_scrape={{ pages_to_scrape | default('1') }}

# The starting page number for scraping.
# Maps to --pages-start. Default: 1.
pages_start={{ pages_start | default('1') }}

# Maximum number of concurrent threads for scraping.
# Maps to --max-threads. Default: 4.
max_thread_count={{ max_thread_count | default('4') }}

# Amount of videos to scrape specifically on Odysee.
# Maps to --odysee-video-count.
odysee_video_search_count={{ odysee_video_search_count | default('') }}

# Whether to include NSFW videos in search results (Odysee only).
# 0: off (default), 1: on. Maps to --nsfw.
nsfw={{ nsfw | default('0') }}

# Source for the search query.
# Options: args, prompt, hist (history). Default: args.
# Maps to -q/--search-source.
search_source={{ search_source | default('args') }}

# Whether to keep the search cache after ytfzf exits.
# 0: off (default), 1: on. Maps to --keep-cache.
keep_cache={{ keep_cache | default('0') }}

# -----------------------------------------------------------------------------
# Backend & Instance Configuration
# -----------------------------------------------------------------------------

# Path to the youtube-dl or yt-dlp executable.
# If empty, ytfzf will look for it in PATH. Maps to --ytdl-path.
ytdl_path={{ ytdl_path | default('') }}

# URL of an Invidious instance to use for search/fetching.
# If empty, defaults to public instances or YouTube. Maps to --ii/--invidious-instance.
invidious_instance={{ invidious_instance | default('') }}

# Comma-separated list of scrapers to enable (e.g., youtube,odysee,peertube).
# Maps to -c/--scrape. Default: youtube.
scrapers={{ scrapers | default('youtube') }}

# Whether to use multi-search (combining multiple scrapers).
# 0: off (default), 1: on. Maps to --multi-search.
multi_search={{ multi_search | default('0') }}

# Whether to force YouTube links even if other scrapers are available.
# 0: off (default), 1: on. Maps to --force-youtube.
force_youtube={{ force_youtube | default('0') }}

# Whether to force Invidious links when using the YouTube scraper backend.
# 0: off (default), 1: on. Maps to --force-invidious.
force_invidious={{ force_invidious | default('0') }}

# -----------------------------------------------------------------------------
# Filters & Metadata
# -----------------------------------------------------------------------------

# Filter videos by duration.
# Options: short, long. Maps to --video-duration.
video_duration={{ video_duration | default('') }}

# Type of results to show.
# Options: video, playlist, channel, all. Default: video.
# Maps to --type.
type={{ type | default('video') }}

# Thumbnail resolution/quality.
# Options: maxres, maxresdefault, sddefault, high, medium, default, start, middle, end.
# Default: high. Maps to --thumbnail-quality.
thumbnail_quality={{ thumbnail_quality | default('high') }}

# Comma-separated features to filter videos by.
# Maps to --features.
features={{ features | default('') }}

# Region/Country code for localized search results.
# Maps to --region.
region={{ region | default('') }}

# Sort by criteria.
# Options: relevance, rating, upload_date, oldest_first, view_count.
# Maps to --sort-by.
sort_by={{ sort_by | default('') }}

# Upload date time-frame filter.
# Options: hour, today, week, month, year.
# Maps to --upload-date.
upload_date={{ upload_date | default('') }}

# -----------------------------------------------------------------------------
# Keyboard Shortcuts
# -----------------------------------------------------------------------------

# Shortcut to trigger download action. Default: alt-d.
download_shortcut={{ download_shortcut | default('alt-d') }}

# Shortcut to trigger watch video action. Default: alt-v.
video_shortcut={{ video_shortcut | default('alt-v') }}

# Shortcut to trigger audio-only action. Default: alt-m.
audio_shortcut={{ audio_shortcut | default('alt-m') }}

# Shortcut to trigger detach action. Default: alt-e.
detach_shortcut={{ detach_shortcut | default('alt-e') }}

# Shortcut to print/copy link action. Default: alt-l.
print_link_shortcut={{ print_link_shortcut | default('alt-l') }}

# Shortcut to show available formats action. Default: alt-f.
show_formats_shortcut={{ show_formats_shortcut | default('alt-f') }}

# Shortcut to show video info action. Default: alt-i.
info_shortcut={{ info_shortcut | default('alt-i') }}

# Shortcut to search again action. Default: alt-s.
search_again_shortcut={{ search_again_shortcut | default('alt-s') }}

# Shortcut to trigger next page action. Default: ctrl-p.
next_page_action_shortcut={{ next_page_action_shortcut | default('ctrl-p') }}

# -----------------------------------------------------------------------------
# Extensions & Loaders
# -----------------------------------------------------------------------------

# Load URL handlers (plugins for handling video links).
# Syntax: load_url_handler <handler_name>
{% for handler in (url_handlers | default([])) %}
load_url_handler {{ handler }}
{% endfor %}

# Load thumbnail viewers (plugins for viewing thumbnails).
# Syntax: load_thumbnail_viewer <viewer_name>
{% for viewer in (thumbnail_viewers | default([])) %}
load_thumbnail_viewer {{ viewer }}
{% endfor %}

# Load custom interfaces (replacing or augmenting fzf/ext).
# Syntax: load_interface <interface_name>
{% for interface_name in (interfaces | default([])) %}
load_interface {{ interface_name }}
{% endfor %}

# Load extensions (general plugins).
# Syntax: load_extension <extension_name>
{% for ext in (extensions | default([])) %}
load_extension {{ ext }}
{% endfor %}