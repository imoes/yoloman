# ============================================================
# debian-edu-router-config
# ============================================================
# This template generates the entry point for Debian-Edu router
# configuration. It sources all configuration fragments from the
# designated directory.
#
# Self-documenting: read the comment above the directive to
# understand what the software expects.
# ============================================================

# Source all configuration fragments from the router configuration
# directory. The directory path is controlled by the 'router_conf_dir'
# schema field. Default value is '/etc/debian-edu/router.conf.d'.
# This allows modular configuration where individual scripts or
# configuration files can be placed in this directory and automatically
# included.
source <(cat {{ router_conf_dir | default('/etc/debian-edu/router.conf.d') }}/*)