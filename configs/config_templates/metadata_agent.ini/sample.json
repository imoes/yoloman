{
  "log_file": "/var/log/neutron/metadata-agent.log",
  "log_dir": "/var/log/neutron",
  "workers": 4,
  "verbose": false,
  "debug": false,
  "metadata_proxy_user": "neutron",
  "metadata_proxy_group": "neutron",
  "metadata_proxy_bind_host": "0.0.0.0",
  "metadata_proxy_bind_port": 8775,
  "metadata_proxy_socket": "/var/lib/neutron/metadata_proxy",
  "metadata_proxy_tcp_backlog": 4096,
  "metadata_proxy_workers": 2,
  "metadata_proxy_shared_secret": "my-secret-key",
  "auth_url": "http://controller:5000/v3",
  "region_name": "RegionOne",
  "auth_type": "password",
  "project_domain_name": "Default",
  "project_name": "service",
  "user_domain_name": "Default",
  "username": "neutron",
  "password": "neutron_pass_123",
  "interface": "internal",
  "cafile": "/etc/ssl/certs/ca-certificates.crt",
  "insecure": false,
  "endpoint_overrides": [],
  "enable_isolated_metadata": true,
  "use_namespace": true,
  "dns_servers": [
    "8.8.8.8",
    "8.8.4.4"
  ],
  "isolated_metadata_hostname": "",
  "isolated_metadata_ip": "",
  "metadata_network": true,
  "metadata_ip_version": "ipv4",
  "metadata_cache_ttl": 300,
  "metadata_proxy_max_idle_time": 600,
  "metadata_proxy_max_body_size": 1048576,
  "metadata_proxy_max_concurrent_requests": 1000,
  "metadata_proxy_request_timeout": 60,
  "metadata_proxy_retries": 3,
  "metadata_proxy_retry_backoff": 1.0,
  "metadata_proxy_health_check_interval": 60,
  "metadata_proxy_health_check_timeout": 5,
  "metadata_proxy_ssl": false,
  "metadata_proxy_ssl_cert": "",
  "metadata_proxy_ssl_key": "",
  "metadata_proxy_ssl_ca_cert": "",
  "metadata_proxy_ssl_verify": true,
  "transport_url": "rabbit://guest:guest@controller:5672/",
  "rabbit_host": "controller",
  "rabbit_port": 5672,
  "rabbit_userid": "neutron",
  "rabbit_password": "rabbit_pass_123",
  "rabbit_virtual_host": "/",
  "rabbit_ha_queues": true,
  "redis_hosts": [],
  "redis_password": "",
  "redis_socket_timeout": 2.0,
  "redis_pool_size": 10,
  "redis_db": 0,
  "use_json_logging": false,
  "log_date_format": "%Y-%m-%d %H:%M:%S",
  "syslog_log_facility": "LOG_USER",
  "log_to_stdout": false,
  "log_to_syslog": false,
  "log_level": "INFO",
  "metadata_endpoints": [
    {
      "service": "nova",
      "region": "RegionOne",
      "endpoint_override": "http://nova.internal:8774/v2.1",
      "interface": "internal"
    },
    {
      "service": "neutron",
      "region": "RegionOne",
      "endpoint_override": "http://neutron.internal:9696"
    }
  ]
}
