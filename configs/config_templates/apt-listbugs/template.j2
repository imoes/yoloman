# do nothing if systemd is PID 1: an equivalent systemd timer is enabled
test -d /run/systemd/system && exit 0

# do nothing if prefclean is not executable
# Path to the apt-listbugs prefclean script executable.
# Default: /usr/libexec/apt-listbugs/prefclean
test -x {{ prefclean_path | default('/usr/libexec/apt-listbugs/prefclean') }} || exit 0

# run the daily job
exec {{ prefclean_path | default('/usr/libexec/apt-listbugs/prefclean') }}