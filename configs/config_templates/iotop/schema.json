{
  "help_type": {
    "type": "string",
    "default": "win",
    "description": "Type of interactive help shown (none, win, inline).",
    "enum": [
      "none",
      "win",
      "inline"
    ]
  },
  "only": {
    "type": "bool",
    "default": false,
    "description": "Only show processes or threads actually doing I/O."
  },
  "iter": {
    "type": "number",
    "default": 0,
    "description": "Number of iterations before quitting. 0 means never quit."
  },
  "delay": {
    "type": "number",
    "default": 1.0,
    "description": "Delay between iterations in seconds."
  },
  "pids": {
    "type": "list",
    "default": [],
    "description": "List of process/thread IDs to monitor."
  },
  "users": {
    "type": "list",
    "default": [],
    "description": "List of user IDs to monitor."
  },
  "processes": {
    "type": "bool",
    "default": false,
    "description": "Only show processes, hide threads."
  },
  "accumulated": {
    "type": "bool",
    "default": false,
    "description": "Show accumulated I/O instead of bandwidth."
  },
  "accum_bw": {
    "type": "bool",
    "default": false,
    "description": "Show accumulated I/O as bandwidth."
  },
  "kilobytes": {
    "type": "bool",
    "default": false,
    "description": "Use kilobytes instead of human friendly units."
  },
  "time": {
    "type": "bool",
    "default": false,
    "description": "Add a timestamp on each line."
  },
  "fullcmdline": {
    "type": "bool",
    "default": false,
    "description": "Show processes' full file path and parameters."
  },
  "hide_pid": {
    "type": "bool",
    "default": false,
    "description": "Hide PID/TID column."
  },
  "hide_prio": {
    "type": "bool",
    "default": false,
    "description": "Hide PRIO column."
  },
  "hide_user": {
    "type": "bool",
    "default": false,
    "description": "Hide USER column."
  },
  "hide_read": {
    "type": "bool",
    "default": false,
    "description": "Hide DISK READ column."
  },
  "hide_write": {
    "type": "bool",
    "default": false,
    "description": "Hide DISK WRITE column."
  },
  "hide_swapin": {
    "type": "bool",
    "default": false,
    "description": "Hide SWAPIN column."
  },
  "hide_io": {
    "type": "bool",
    "default": false,
    "description": "Hide IO column."
  },
  "hide_graph": {
    "type": "bool",
    "default": false,
    "description": "Hide GRAPH column."
  },
  "hide_command": {
    "type": "bool",
    "default": false,
    "description": "Hide COMMAND column."
  },
  "grtype": {
    "type": "string",
    "default": "io",
    "description": "GRAPH column data source (io, r, w, rw, sw).",
    "enum": [
      "io",
      "r",
      "w",
      "rw",
      "sw"
    ]
  },
  "reverse_graph": {
    "type": "bool",
    "default": false,
    "description": "Reverse GRAPH direction."
  },
  "quiet": {
    "type": "number",
    "default": 0,
    "description": "Suppress headers (0, 1, 2, or 3)."
  },
  "dead_x": {
    "type": "bool",
    "default": false,
    "description": "Show exited processes with letter x."
  },
  "hide_exited": {
    "type": "bool",
    "default": false,
    "description": "Hide exited processes."
  },
  "no_color": {
    "type": "bool",
    "default": false,
    "description": "Do not colorize values."
  },
  "hide_time": {
    "type": "bool",
    "default": false,
    "description": "Do not show time clock in upper right corner."
  },
  "si": {
    "type": "bool",
    "default": false,
    "description": "Use SI units (1000) instead of binary (1024)."
  },
  "threshold": {
    "type": "number",
    "default": 2,
    "description": "Threshold to switch to next unit (1-10)."
  },
  "ascii": {
    "type": "bool",
    "default": false,
    "description": "Disable using Unicode."
  },
  "inverse": {
    "type": "bool",
    "default": false,
    "description": "Use inverse interface (black on white)."
  },
  "filter": {
    "type": "string",
    "default": "",
    "description": "Filter processes by TID and COMMAND regex."
  }
}
