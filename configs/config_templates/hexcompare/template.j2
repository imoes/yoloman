# hexcompare configuration file - compare binary files interactively
# This template generates a simple key=value configuration file for the hexcompare utility.
# It is self-documenting: every directive is preceded by its schema description.

# Initial display mode for the lower data view: 'hex', 'ascii', or 'auto' (default).
# Controls how binary data is rendered by default in the UI.
{% set _tm = terminal_mode | default('auto') %}
terminal_mode = {{ _tm | lower | trim }}

# Number of lines to scroll vertically with Page Up/Down keys in the data view.
# Determines the granularity of scrolling in the hex/ascii panels.
{% set _sl = scroll_lines | default(20) %}
scroll_lines = {{ _sl | int }}

# Number of bytes each block represents in the overview diagram.
# 0 (default) means auto-detect based on terminal width.
# Non-zero values force a fixed block width for comparison highlights.
{% set _bs = block_size | default(0) %}
block_size = {{ _bs | int }}