# Listen on this IP address for incoming DNS queries (UDP and TCP)
listen: {{ listen_ip }}:{{ listen_port }}

# Upstream recursive resolver (forwarder) to handle non-Curve queries
forward: {{ forward_host }}:{{ forward_port }}

# DNSCurve mode: 'none', 'server', 'client', or 'both'
dnscurve: {{ dnscurve_mode }}

# Optional: DNSCurve public key for server mode (PEM-encoded, base64, or hex)
# If blank, key will be auto-generated at startup (not recommended for production)
{% if dnscurve_public_key %}
publickey: {{ dnscurve_public_key }}
{% endif %}

# Optional: DNSCurve secret key (PEM-encoded or hex); required for server/client modes
{% if dnscurve_secret_key %}
secretkey: {{ dnscurve_secret_key }}
{% endif %}

# Optional: Pre-shared Curve25519 key(s) for authenticated clients/servers
# Format: hex(64 chars) = peer public key + our secret (or vice versa); one per line
{% for peer in peers %}
peer: {{ peer.public_key_hex }}:{{ peer.secret_key_hex }}:{{ peer.role }}{% if peer.comment %} # {{ peer.comment }}{% endif %}
{% endfor %}

# Maximum number of simultaneous connections (0 = no limit)
maxconn: {{ max_connections }}

# Timeout for upstream queries, in seconds
query_timeout: {{ query_timeout_seconds }}

# Log level: 0 (quiet) to 5 (debug)
loglevel: {{ log_level }}

# Optional: chroot directory (empty string = disabled)
chroot: {{ chroot_path }}

# Optional: run as user/group
user: {{ run_user }}
group: {{ run_group }}

# Optional: PID file location
pidfile: {{ pidfile_path }}

# Optional: disable UDP forwarding (force TCP-only upstream queries)
{% if not udp_forward %}
no-udp-forward
{% endif %}

# Optional: enable EDNS0 support for upstream queries
{% if edns0 %}
edns0
{% endif %}

# Optional: restrict upstream recursion to these IPs (space-separated list)
{% if upstream_allow %}
allow-upstream: {% for ip in upstream_allow %}{{ ip }}{% if not loop.last %} {% endif %}{% endfor %}
{% endif %}

# Optional: fallback to plain DNS if DNSCurve handshake fails
{% if fallback_to_plain %}
fallback
{% endif %}
