[Desktop Entry]
# Desktop Entry type; must always be Application for this kind of service.
Type=Application
# Human-readable name shown in session managers.
Name=Preview Creator
# Path to the previews_creator executable that generates thumbnail previews.
Exec={{ exec_path | default('/usr/lib/budgie-previews/previews_creator') }}
# Hide this entry from standard application menus; it runs in the background.
NoDisplay=true
# Autostart condition: only start when the GSettings key is enabled.
# Format: AutostartCondition=GSettings <schema> <key>
AutostartCondition=GSettings {{ gsettings_schema | default('org.ubuntubudgie.budgie-wpreviews') }} {{ gsettings_key | default('enable-previews') }}
# Whether the MATE desktop environment should automatically restart this process if it crashes.
X-MATE-AutoRestart={{ mate_auto_restart | default(true) | lower }}
# Whether the GNOME desktop environment should automatically restart this process if it crashes.
X-GNOME-AutoRestart={{ gnome_auto_restart | default(true) | lower }}