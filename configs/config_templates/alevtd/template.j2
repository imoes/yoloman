# Teletext HTTP Daemon configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
# This file configures alevtd, an HTTP daemon serving teletext (.txt, .html) pages.
# All variables use the 'default()' filter to ensure safe rendering even if undefined.

# -----------------------------------------------------------
# Listening interface and port
# -----------------------------------------------------------
# IP address the daemon binds to (e.g., '0.0.0.0' for all interfaces, or '127.0.0.1' for local only).
listen_address: {{ (listen_address | default('0.0.0.0')) | string }}

# Port number for incoming HTTP connections.
listen_port: {{ (listen_port | default(8080)) | int }}

# -----------------------------------------------------------
# Connection handling
# -----------------------------------------------------------
# Maximum number of simultaneous client connections.
max_connections: {{ (max_connections | default(100)) | int }}

# Seconds before closing idle connections.
idle_timeout: {{ (idle_timeout | default(60)) | int }}

# -----------------------------------------------------------
# Document root
# -----------------------------------------------------------
# Base directory containing teletext page files (e.g., .txt, .html).
root_dir: {{ (root_dir | default('/var/lib/alevtd/pages')) | string }}

# -----------------------------------------------------------
# Compression
# -----------------------------------------------------------
# Enable gzip compression for text-based responses.
use_compression: {{ (use_compression | default(true)) | lower }}

# -----------------------------------------------------------
# Logging
# -----------------------------------------------------------
# Verbosity of logs: debug, info, warn, or error.
log_level: {{ (log_level | default('info')) | lower }}

# Path to log file (empty string logs to stdout).
log_file: {{ (log_file | default('')) | string }}

# -----------------------------------------------------------
# Virtual hosts configuration
# -----------------------------------------------------------
# List of virtual hosts (each with optional SSL, name, and root).
{% for vhost in (vhosts | default([])) %}
# Virtual host configuration block
{% if vhost.server_name %}server_name: {{ (vhost.server_name | default('')) | string }}
{% endif %}
{% if vhost.root_dir %}root_dir: {{ (vhost.root_dir | default('')) | string }}
{% endif %}
{% if vhost.ssl is mapping and vhost.ssl.enabled %}ssl_cert: {{ (vhost.ssl.cert_path | default('')) | string }}
ssl_key: {{ (vhost.ssl.key_path | default('')) | string }}
{% endif %}
{% endfor %}

# -----------------------------------------------------------
# MIME type overrides (optional)
# -----------------------------------------------------------
# Dictionary mapping MIME types (e.g., 'text/plain') to comma-separated extensions.
{% for k, v in (mime_overrides | default({}) | dict2items) %}
mime_{{ (k.key | default('')) | string }}: {{ (k.value | default([])) | join(', ') }}
{% endfor %}

# -----------------------------------------------------------
# Directory listing
# -----------------------------------------------------------
# Show file list when a directory is requested (dangerous in production).
directory_listing: {{ (directory_listing | default(false)) | lower }}

# -----------------------------------------------------------
# Access control: allow/deny IP ranges
# -----------------------------------------------------------
# Ordered list of IP-based access rules (action: 'allow' or 'deny', source: CIDR or IP).
{% for rule in (access_rules | default([])) %}
access_rule: {{ (rule.action | default('allow')) | string }} {{ (rule.source | default('0.0.0.0/0')) | string }}
{% endfor %}

# -----------------------------------------------------------
# Cache settings
# -----------------------------------------------------------
# Cache configuration (enabled by default is False).
{% if (cache | default({'enabled': false})).enabled %}
# Caching enabled
max_cache_size_mb: {{ ((cache | default({'enabled': false})).max_size_mb | default(100)) | int }}
cache_ttl_sec: {{ ((cache | default({'enabled': false})).ttl_sec | default(300)) | int }}
{% else %}
# Caching disabled
use_cache: false
{% endif %}

# -----------------------------------------------------------
# Rate limiting per IP (optional)
# -----------------------------------------------------------
# Rate limiting configuration (enabled by default is False).
{% if (rate_limit | default({'enabled': false})).enabled %}
# Rate limiting active
rate_limit_rps: {{ ((rate_limit | default({'enabled': false})).rps | default(10)) | int }}
rate_limit_burst: {{ ((rate_limit | default({'enabled': false})).burst | default(20)) | int }}
{% endif %}

# -----------------------------------------------------------
# Index page fallback
# -----------------------------------------------------------
# Default page served when a directory is requested.
index_page: {{ (index_page | default('index.txt')) | string }}

# -----------------------------------------------------------
# HTTP headers to append to all responses
# -----------------------------------------------------------
# Custom HTTP headers to add to all responses (e.g., {'X-Frame-Options': 'DENY'}).
{% for k, v in (extra_headers | default({}) | dict2items) %}
header_{{ (k.key | default('')) | string }}: {{ (k.value | default('')) | string }}
{% endfor %}