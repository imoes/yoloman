{
 "access_rules": [
  {
   "action": "allow",
   "source": "10.0.0.0/8"
  },
  {
   "action": "allow",
   "source": "192.168.1.0/24"
  },
  {
   "action": "deny",
   "source": "0.0.0.0/0"
  }
 ],
 "cache": {
  "enabled": true,
  "max_size_mb": 50,
  "ttl_sec": 600
 },
 "directory_listing": false,
 "extra_headers": {
  "X-Content-Type-Options": "nosniff",
  "X-XSS-Protection": "1; mode=block"
 },
 "idle_timeout": 30,
 "index_page": "welcome.txt",
 "listen_address": "127.0.0.1",
 "listen_port": 8080,
 "log_file": "/var/log/alevtd/alevtd.log",
 "log_level": "warn",
 "max_connections": 50,
 "mime_overrides": {
  "text/plain": "txt, ttxt, ttx"
 },
 "rate_limit": {
  "burst": 50,
  "enabled": true,
  "rps": 20
 },
 "root_dir": "/var/lib/alevtd/pages",
 "use_compression": true,
 "vhosts": [
  {
   "name": "main",
   "root_dir": "/var/lib/alevtd/pages/main",
   "server_name": "teletext.example.com",
   "ssl": {
    "cert_path": "/etc/ssl/certs/teletext.crt",
    "enabled": true,
    "key_path": "/etc/ssl/private/teletext.key"
   }
  }
 ]
}
