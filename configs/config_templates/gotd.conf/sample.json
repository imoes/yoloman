{
  "debug": false,
  "bind": "127.0.0.1",
  "port": 9418,
  "repo_root": "/var/git",
  "ssl_enabled": true,
  "ssl_cert": "/etc/ssl/certs/gotd.example.com.crt",
  "ssl_key": "/etc/ssl/private/gotd.example.com.key",
  "auth": "htpasswd",
  "htpasswd_file": "/etc/gotd/htpasswd",
  "ldap_uri": "",
  "ldap_base": "",
  "ldap_bind_dn": "",
  "ldap_bind_password": "",
  "repos": [
    {
      "path": "team-a/shared.git",
      "read": [
        "developers",
        "ci-bot"
      ],
      "write": [
        "developers"
      ],
      "admin": [
        "team-a-lead"
      ]
    },
    {
      "path": "team-b/research.git",
      "read": [
        "researchers"
      ],
      "write": [
        "researchers"
      ],
      "admin": [
        "lab-manager"
      ]
    }
  ],
  "max_concurrent": 100,
  "idle_timeout": 600,
  "auto_detect_repos": true,
  "log_file": "/var/log/gotd/gotd.log"
}
