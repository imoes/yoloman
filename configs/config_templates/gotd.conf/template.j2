# ==============================================================================
# gotd.conf — Main configuration file for gotd (Git over HTTP daemon)
# Generated by Ansible. Do not edit manually.
# ==============================================================================

# Enable verbose debug logging (for troubleshooting only)
# Default: False
{% if (debug | default(False) | bool) %}
# Enable verbose debug logging (for troubleshooting only)
debug = {{ debug | default(False) | bool }}
{% endif %}

# IP address to bind the service to (e.g., 127.0.0.1, 0.0.0.0)
# Default: 0.0.0.0
bind = {{ bind | default('0.0.0.0') }}

# TCP port to listen on for HTTP(S) Git requests
# Default: 9418
port = {{ port | default(9418) }}

# Path to the directory containing all Git repositories
# Default: /var/git
repo_root = {{ repo_root | default('/var/git') }}

# Enable SSL/TLS encryption for secure Git operations
# Default: False
{% if (ssl_enabled | default(False) | bool) %}
# Path to the SSL certificate file (required when ssl_enabled = true)
# Default: /etc/ssl/certs/gotd.crt
ssl_cert = {{ ssl_cert | default('/etc/ssl/certs/gotd.crt') }}

# Path to the SSL private key file (required when ssl_enabled = true)
# Default: /etc/ssl/private/gotd.key
ssl_key = {{ ssl_key | default('/etc/ssl/private/gotd.key') }}
{% endif %}

# Authentication method: 'none' (public), 'htpasswd' (file-based), or 'ldap' (directory-based)
# Default: none
auth = {{ auth | default('none') }}

# Path to the Apache htpasswd file (used when auth = 'htpasswd')
# Default: /etc/gotd/htpasswd
{% if (auth | default('none')) == 'htpasswd' %}
htpasswd_file = {{ htpasswd_file | default('/etc/gotd/htpasswd') }}
{% endif %}

# LDAP server URI (used when auth = 'ldap')
# Default: ldaps://ldap.example.com
# LDAP base DN to search for users (used when auth = 'ldap')
# Default: ou=gitusers,dc=example,dc=com
# LDAP bind DN for performing directory searches (used when auth = 'ldap')
# Default: cn=admin,dc=example,dc=com
{% if (auth | default('none')) == 'ldap' %}
ldap_uri = {{ ldap_uri | default('ldaps://ldap.example.com') }}
ldap_base = {{ ldap_base | default('ou=gitusers,dc=example,dc=com') }}
ldap_bind_dn = {{ ldap_bind_dn | default('cn=admin,dc=example,dc=com') }}

# Password for LDAP bind DN (leave blank if using SASL or anonymous bind; used when auth = 'ldap')
# Default: ''
{% if (ldap_bind_password | default('')) != '' %}
ldap_bind_password = {{ ldap_bind_password | default('') }}
{% endif %}
{% endif %}

# List of repository access control rules (if omitted, default permissions apply)
# Default: []
{% for repo in repos | default([]) %}
# Repository: {{ repo.path | default('unknown') }}
[{{ repo.path | default('unknown') }}]
{% if repo.read | default([]) | length > 0 %}
read = {{ repo.read | default([]) | join(', ') }}
{% endif %}
{% if repo.write | default([]) | length > 0 %}
write = {{ repo.write | default([]) | join(', ') }}
{% endif %}
{% if repo.admin | default([]) | length > 0 %}
admin = {{ repo.admin | default([]) | join(', ') }}
{% endif %}
{% endfor %}

# Maximum number of simultaneous client connections
# Default: 50
max_concurrent = {{ max_concurrent | default(50) }}

# Idle connection timeout in seconds
# Default: 300
idle_timeout = {{ idle_timeout | default(300) }}

# Automatically discover and serve new repositories under repo_root
# Default: True
{% if (auto_detect_repos | default(True) | bool) %}
auto_detect_repos = {{ auto_detect_repos | default(True) | bool | lower }}
{% endif %}

# Path to log file (if empty, logs to stdout/stderr)
# Default: /var/log/gotd/gotd.log
log_file = {{ log_file | default('/var/log/gotd/gotd.log') }}