# ==============================================================================
# LemonLDAP::NG Nginx Configuration Fragment
#
# This template generates Nginx directives for integrating LemonLDAP::NG
# with an upstream identity provider or reverse proxy. It handles the
# transfer of authentication headers, cookie management, and logout
# redirection logic using Lua integration (ngx_lua).
#
# Variables used:
# - upstream_http_headername{1-15}: The names of headers to set from upstream.
# - upstream_http_headervalue{1-15}: The values corresponding to the above headers.
# - upstream_http_deleteheader{1-15}: Header names to remove from the upstream request.
# - upstream_http_cookie: The specific cookie to forward/override.
# - upstream_http_internal_lemonldap_logout_url: The URL for logout redirections.
# ==============================================================================

# --- Header Setting: Name-Value Pairs ---
# For each configured header, we define the Nginx variable name (key) and value.
# These variables are then consumed by the Lua block below to inject headers into the proxied request.

# Header name 1 from upstream to set
auth_request_set $headername1 {{ upstream_http_headername1 | default('$upstream_http_headername1') }};
# Header value 1 from upstream to set
auth_request_set $headervalue1 {{ upstream_http_headervalue1 | default('$upstream_http_headervalue1') }};

