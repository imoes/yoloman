# --- Header Deletion ---
# Headers listed here are cleared from the upstream request before it is proxied.
# This allows LemonLDAP::NG to strip sensitive or unnecessary metadata.

# Header name 1 to delete from upstream
auth_request_set $deleteheader1 {{ upstream_http_deleteheader1 | default('$upstream_http_deleteheader1') }};
# Header name 2 to delete from upstream
auth_request_set $deleteheader2 {{ upstream_http_deleteheader2 | default('$upstream_http_deleteheader2') }};
