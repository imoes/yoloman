# --- Cookie and Logout URL Handling ---
# Sets the specific cookie to be managed by the Lua logic.
auth_request_set $lmcookie {{ upstream_http_cookie | default('$upstream_http_cookie') }};

# Logout URL from upstream for redirection
auth_request_set $internal_lemonldap_logout_url {{ upstream_http_internal_lemonldap_logout_url | default('$upstream_http_internal_lemonldap_logout_url') }};


# --- Lua Logic: Header Injection and Clearing ---
# This Lua block runs during the access phase. It iterates through the
# configured header names and values, setting them in the request.
# It also clears headers specified in the delete list.
access_by_lua '
  local i = 1
  -- Set the LM Cookie
  ngx.req.set_header("Cookie",ngx.var.lmcookie)

  -- Inject headers from name/value pairs
  while true do
    if ngx.var["headername"..i] ~= nil then
      ngx.req.set_header(ngx.var["headername"..i],ngx.var["headervalue"..i])
    else
      break
    end
    i = i + 1
  end

  -- Delete headers from the request
  i = 1
  while true do
    if ngx.var["deleteheader"..i] ~= nil then
      ngx.req.clear_header(ngx.var["deleteheader"..i])
    else
      break
    end
    i = i + 1
  end
';


# --- Logout App / SSO Redirection ---
# This section handles the redirection logic for LemonLDAP::NG's logout_app
# and logout_app_sso features.

# For managing logout_app / logout_app_sso redirection
# Make sure the following block is enabled in the appropriate "location" section
header_filter_by_lua '
  if ngx.var["internal_lemonldap_logout_url"] ~= nil and ngx.var["internal_lemonldap_logout_url"] ~= "" then
    return ngx.exit(457)
  end
';

# Do not drop upstream cookies for logout_app / logout_app_sso redirections
add_header Set-Cookie $upstream_http_set_cookie always;

# Use specific code for triggering logout_app / logout_app_sso redirections
error_page 457 $internal_lemonldap_logout_url;
