{
  "client_launch": {
    "enabled": true,
    "client_hosts": [
      "web*",
      "app[1-3]*"
    ],
    "client_interval": 300,
    "max_concurrent": 8,
    "cmd_prefix": "sudo -u hobbit",
    "base_dir": "/var/lib/hobbit/client-launch",
    "tests": [
      {
        "name": "disk",
        "cmd": "client-disk.sh",
        "timeout": 45,
        "enabled": true
      },
      {
        "name": "memory",
        "cmd": "client-memory.sh",
        "timeout": 30,
        "enabled": true
      },
      {
        "name": "loadavg",
        "cmd": "client-loadavg.sh",
        "timeout": 15,
        "enabled": false
      }
    ]
  }
}
