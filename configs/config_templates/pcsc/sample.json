{
  "debug_enabled": false,
  "max_clients": 10,
  "socket_dir": "/run/pcscd",
  "socket_group": "pcscd",
  "auto_enable": true,
  "drivers_dir": "/usr/lib/pcsc/drivers",
  "enable_usb_scanner": false,
  "readers": [
    {
      "name": "ACS ACR122U",
      "device": "001:002",
      "driver": "libccid.so"
    },
    {
      "name": "Identiv uTrust 3700 F",
      "device": "/dev/bus/usb/001/005",
      "driver": "libibt3700f.so"
    }
  ],
  "log_file": "SysLog",
  "log_level": 1,
  "allow_external_card_rdr": false
}
