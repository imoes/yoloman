{
  "storage": "persistent",
  "runtime_directory": "",
  "system_max_use": "512M",
  "system_keep_free": "1G",
  "system_max_file_size": "100M",
  "system_max_files": 10,
  "runtime_max_use": "10%",
  "runtime_keep_free": "15%",
  "runtime_max_file_size": "100M",
  "runtime_max_files": 5,
  "max_file_sec": "2weeks",
  "max_retention_sec": "3months",
  "compress": true,
  "sync_interval_sec": 0,
  "rate_limit_interval_sec": 30,
  "rate_limit_burst": 5000,
  "forward_to_syslog": true,
  "syslog_socket": "/run/systemd/journal/syslog",
  "forward_to_kmsg": false,
  "forward_to_console": false,
  "console_format": "short",
  "color": false,
  "show_boot_id": true,
  "max_level_store": "info",
  "seal": false,
  "header_checksum": false,
  "boot_ids": 30,
  "stream_socket": "/run/systemd/journal/stdout",
  "stream_path": "/run/systemd/journal/stdout",
  "remote_servers": [
    {
      "address": "logs.example.com",
      "port": 19532,
      "tls": true
    }
  ],
  "audit": true,
  "write_kernel_messages": true,
  "write_service_messages": true,
  "write_user_session_messages": true
}
