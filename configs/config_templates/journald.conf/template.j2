# Enables or disables logging to the systemd-journald journal
# (default: yes)
[Journal]
#Storage=auto

# Directory where journal files are stored
# (default: /var/log/journal)
#RuntimeDirectory=

# Maximum size of a single journal file
# (default: 100M)
#SystemMaxUse=

# Minimum free disk space to preserve on the journal storage device
# (default: 10%
#SystemKeepFree=

# Maximum size of journal files on the system partition
# (default: 10G)
#SystemMaxFileSize=

# Maximum age of journal files on the system partition
# (default: 2 weeks)
#SystemMaxFiles=

# Maximum size of journal files on the runtime partition
# (default: 10% of /run)
#RuntimeMaxUse=

# Minimum free space to preserve on the runtime partition
# (default: 15% of /run)
#RuntimeKeepFree=

# Maximum size of journal files on the runtime partition
# (default: 1G)
#RuntimeMaxFileSize=

# Maximum age of journal files on the runtime partition
# (default: 2 weeks)
#RuntimeMaxFiles=

# Maximum number of journals to keep for each boot
# (default: 0 = unlimited)
#MaxFileSec=

# Maximum retention period for journal entries
# (default: 1 month)
#MaxRetentionSec=

# Maximum size of the journal in bytes
# (default: 0 = automatic)
#MaxLevelStore=

# Maximum size of the journal in bytes (legacy, use MaxLevelStore)
# (default: info)
#MaxLevelStore=

# Enable or disable compression of archived journal files
# (default: yes)
#Compress=yes

# Enable or disable synchronous writes to disk
# (default: no)
#SyncIntervalSec=0

# Enable or disable rate limiting of messages
# (default: yes)
#RateLimitIntervalSec=30
#RateLimitBurst=10000

# Enable or disable journal message rate limiting per unit
# (default: no)
#RateLimitIntervalSec=30
#RateLimitBurst=10000

# Enable or disable journal message rate limiting per unit (unit-specific)
# (default: yes)
#SystemMaxUse=80%
#RuntimeMaxUse=10%

# Enable or disable journal message rate limiting per unit (per unit)
# (default: yes)
#SystemMaxUse=80%
#RuntimeMaxUse=10%

# Forward journal entries to the system syslog daemon
# (default: no)
#ForwardToSyslog=no

# Forward journal entries to the specified syslog socket
# (default: /run/systemd/journal/syslog)
#SyslogSocket=

# Forward journal entries to the kernel ring buffer
# (default: no)
#ForwardToKMsg=no

# Forward journal entries to the console
# (default: no)
#ForwardToConsole=no

# Path to the console device to forward to
# (default: /dev/console)
#ConsoleFormat=

# Enable or disable colorized output to the console
# (default: yes)
#Color=yes

# Enable or disable display of the boot ID in console output
# (default: yes)
#ShowBootId=yes

# Maximum number of lines shown in the journal dump (for `journalctl -n` default)
# (default: 10)
#MaxLevelStore=

# Enable or disable journal metadata validation (for security)
# (default: no)
# Seal=

# Enable or disable journal header checksums (for integrity)
# (default: no)
# HeaderChecksum=

# Maximum number of boot entries to retain in the journal
# (default: 0 = unlimited)
#BootIDs=

# Enable or disable journal streaming over Unix domain socket
# (default: no)
#StreamSocket=

# Path to the journal streaming socket
# (default: /run/systemd/journal/stdout)
#StreamPath=

# Enable or disable journal output over HTTP/2 (for `systemd-journald --socket`)
# (default: no)
#Http2=no

# List of remote journal servers to forward to
# (default: empty)
{% for remote in remote_servers %}#{{ remote.address }}={{ remote.port }}{% if remote.tls %}{{ ' TLS' }}{% endif %}
{% endfor %}

# Enable or disable journal audit logging
# (default: no)
#Audit=no

# Enable or disable journal logging of kernel messages
# (default: yes)
#WriteKernelMessages=yes

# Enable or disable journal logging of service manager messages
# (default: yes)
#WriteServiceMessages=yes

# Enable or disable journal logging of user session messages
# (default: yes)
#WriteUserSessionMessages=yes
