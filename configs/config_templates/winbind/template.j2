# Defaults for winbind initscript
# sourced by /etc/init.d/winbind
#
# This is a POSIX shell fragment.
# Self-documenting: every variable reference below is guarded by a |default()
# filter using the schema's default value, and preceded by a comment explaining
# the field's purpose.

#
# Winbind configuration
#

# winbindd_opts (list, default: [])
# Command-line options to pass to the winbindd daemon, e.g. -n for nmbd compatibility.
# These options are joined into a single space-separated string for the shell variable.
WINBINDD_OPTS="{{ winbindd_opts | default([]) | join(' ') }}"