# Defaults for winbind initscript
# sourced by /etc/init.d/winbind
#

# This is a POSIX shell fragment

# Winbind configuration
# Command-line options to pass to the winbindd daemon, e.g. -n for nmbd compatibility.
# If set, options are joined by spaces; otherwise defaults to disabled.
{% if winbindd_opts is defined %}WINBINDD_OPTS="{{ winbindd_opts | join(' ') }}"
{% else %}#WINBINDD_OPTS="-n"
{% endif %}