# Scamper configuration file
# Generated by Ansible Jinja2 engine

# Monitor canonical name used in warts output files to identify the probe source.
MONITOR_NAME = {{ monitor_name | default('localhost') }}

# List name identifier used in warts output metadata for grouping results.
LIST_NAME = {{ list_name | default('default') }}

# List numerical ID used in warts output metadata for unique identification.
LIST_ID = {{ list_id | default(0) }}

# Cycle ID to begin with for output metadata, incrementing per run.
CYCLE_ID = {{ cycle_id | default(1) }}

# Default command to execute for targets (e.g., trace, ping, host, dealias, neighbourdisc, sniff, sting, tbit, tracelb).
DEFAULT_COMMAND = {{ default_command | default('trace') }}

# Target packets-per-second rate to control probe speed.
PACKETS_PER_SECOND = {{ packets_per_second | default(20) }}

# Maximum number of tasks probed in parallel. 0 means no upper limit.
MAX_PARALLEL_TASKS = {{ max_parallel_tasks | default(0) }}

# Output file path for results. Empty string means stdout.
OUTPUT_FILE = {{ output_file | default('') }}

# Output format: text, warts, or json.
OUTPUT_FORMAT = {{ output_format | default('warts') }}

# Nameserver IP address to use for DNS queries. Empty for default /etc/resolv.conf.
NAMESERVER = {{ nameserver | default('') }}

# Debug file path to write debugging messages to. Empty to disable.
DEBUG_FILE = {{ debug_file | default('') }}

# PID file path for the scamper process to store its process ID.
PID_FILE = {{ pid_file | default('/var/run/scamper.pid') }}

# Firewall specification (e.g., ipfw:range or pf:anchor:num). Empty to disable firewall usage.
FIREWALL = {{ firewall | default('') }}

# Space-separated list of options to tailor behaviour (e.g., warts, text, planetlab, rawtcp, select, kqueue, epoll, noinitndc, outcopy, debugfileappend, notls).
# Note: default('') is applied before join to handle empty list/null safely.
OPTIONS = {{ options | default([]) | join(' ') }}

# Control socket listening address:port or unix domain socket path. Empty to disable daemon mode.
CONTROL_SOCKET = {{ control_socket | default('') }}

# Remote host:port to connect to for receiving commands. Empty to disable remote control.
REMOTE_CONTROLLER = {{ remote_controller | default('') }}

# List of target IP addresses or hostnames to probe directly via -i flag.
# Note: default('') is applied before join to handle empty list/null safely.
TARGETS = {{ targets | default([]) | join(' ') }}

# Path to a file containing target addresses, one per line, passed via -f flag.
TARGET_FILE = {{ target_file | default('') }}

# List of complex commands to execute via -I flag.
# Note: default('') is applied before join to handle empty list/null safely.
COMMANDS = {{ commands | default([]) | join('\n') }}