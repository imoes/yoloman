# ==============================================================================
# Tarantool Instance Configuration
# This file defines the global settings and Lua-based runtime configuration for a Tarantool instance.
# It is auto-generated by Ansible and should not be edited manually.
# ==============================================================================

# ==============================================================================
# Basic Instance Identification and Storage
# ==============================================================================

# Name used to identify this Tarantool instance in logs, metrics, and CLI output.
instance_name = "{{ instance_name | default('default') }}"

# Base directory for instance data, logs, and backups (must be writable).
work_dir = "{{ work_dir | default('/var/lib/tarantool') }}"

# If true, this instance is read-only (e.g., replica). Prevents writes to box.space.
read_only = {{ read_only | default(False) | lower }}

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log format preset: 'default' (structured) or 'json' (machine-parseable).
log_format = "{{ log_format | default('default') }}"

# Logging verbosity (1=error, 2=warn, 3=info, 4=debug, 5=trace).
log_level = {{ log_level | default(5) }}

# If true, logs are written asynchronously to avoid blocking.
log_nonblock = {{ log_nonblock | default(True) | lower }}

# ==============================================================================
# Memtx Engine (In-Memory) Settings
# ==============================================================================

# Maximum memory (in bytes) for memtx engine (in-memory tuples). Default: 256 MB.
memtx_memory = {{ memtx_memory | default(268435456) }}

# Minimum tuple size (in bytes) that memtx allocates (tuning for tiny tuples).
memtx_min_tuple_size = {{ memtx_min_tuple_size | default(8) }}

# Maximum tuple size (in bytes) allowed in memtx engine (default: 1 MB).
memtx_max_tuple_size = {{ memtx_max_tuple_size | default(1048576) }}

# ==============================================================================
# Vinyl Engine (Disk-Backed) Settings
# ==============================================================================

# Maximum memory (in bytes) for vinyl engine’s read/write cache (disk-backed).
vinyl_memory = {{ vinyl_memory | default(268435456) }}

# Size (in bytes) of the vinyl cache for B-trees (read-only).
vinyl_cache = {{ vinyl_cache | default(134217728) }}

# Timeout (in seconds) for vinyl background operations (e.g., compaction).
vinyl_timeout = {{ vinyl_timeout | default(60) }}

# ==============================================================================
# Snapshot and Checkpoint Settings
# ==============================================================================

# Time (in seconds) between automatic snapshots (default: 30 min).
snapshot_interval = {{ snapshot_interval | default(1800) }}

# If true, snapshot is triggered on XLog rotation (instead of time-based).
snapshot_by_xlog = {{ snapshot_by_xlog | default(False) | lower }}

# Number of snapshots retained (older ones are purged).
snapshot_count = {{ snapshot_count | default(2) }}

# If true, snapshots run in background (non-blocking).
snapshot_in_background = {{ snapshot_in_background | default(True) | lower }}

# Time (in seconds) between automatic checkpoints (default: 15 min).
checkpoint_interval = {{ checkpoint_interval | default(900) }}

# ==============================================================================
# Synchronous Replication Settings
# ==============================================================================

# Number of successful synchronous replicas required for commit quorum.
replication_synchro_quorum = {{ replication_synchro_quorum | default(2) }}

# Timeout (in seconds) to wait for synchronous replication quorum.
replication_synchro_timeout = {{ replication_synchro_timeout | default(5.0) }}

# ==============================================================================
# Quota and Engine Defaults
# ==============================================================================

# Default space engine: 'memtx' (RAM) or 'vinyl' (disk).
default_engine = "{{ default_engine | default('memtx') }}"

# Disk write quota (in bytes) — limits total WAL + snapshot disk usage.
quota = {{ quota | default(1073741824) }}

# ==============================================================================
# Runtime Configuration (box.cfg)
# ==============================================================================
# The following block applies the configuration to the Tarantool runtime.
# It mirrors the static configuration above but allows dynamic injection of
# replication sources and specific runtime flags.

box.cfg({
    -- Bind the Tarantool binary protocol to this address and port.
    -- listen_host: IP address to bind the client API to.
    -- listen_port: Port number for the Tarantool client API.
    listen = "{{ listen_host | default('127.0.0.1') }}:{{ listen_port | default(3301) }}",

    -- Work directory for data, logs, and snapshots.
    work_dir = "{{ work_dir | default('/var/lib/tarantool') }}",

    -- Memory settings.
    memtx_memory = {{ memtx_memory | default(268435456) }},
    vinyl_memory = {{ vinyl_memory | default(268435456) }},

    -- Logging configuration.
    log = "{{ work_dir | default('/var/lib/tarantool') }}/tarantool.log",
    log_level = {{ log_level | default(5) }},

    -- Snapshot configuration.
    snapshot_in_background = {{ snapshot_in_background | default(True) | lower }},
    checkpoint_interval = {{ checkpoint_interval | default(900) }},

    -- Replication synchronization settings.
    replication_synchro_quorum = {{ replication_synchro_quorum | default(2) }},
    replication_synchro_timeout = {{ replication_synchro_timeout | default(5.0) }},

    -- Replication sources (peers).
    -- replicas: List of replication source URIs.
{% for replica in replicas | default([]) %}
    replication = "{{ replica }}",
{% endfor %}
{% if replicas | default([]) | length == 0 %}
    -- No replication sources defined.
{% endif %}

    -- Replication connection settings.
    replication_connect_timeout = {{ replication_connect_timeout | default(5.0) }},
    replication_connect_quorum = {{ replication_connect_quorum | default(1) }},

    -- Cluster identification and behavior.
{% if replication_id | default(None) is not none %}
    replication_id = {{ replication_id | default(None) }},
{% endif %}

{% if replication_skip_conflict | default(False) %}
    replication_skip_conflict = {{ replication_skip_conflict | default(False) | lower }},
{% endif %}

    -- Default engine and read-only status.
    default_engine = "{{ default_engine | default('memtx') }}",

{% if read_only | default(False) %}
    read_only = {{ read_only | default(False) | lower }},
{% endif %}

    -- Quota setting.
    quota = {{ quota | default(1073741824) }},
})

# ==============================================================================
# Schema Initialization (Spaces)
# ==============================================================================
# Pre-define spaces and indexes if the `spaces` variable is provided.
# This allows the instance to be schema-ready on startup.

{% if spaces | default([]) | length > 0 %}
--- Declaring spaces defined in schema...
{% for space in spaces | default([]) %}
    -- Space: {{ (space | default({})).name | default('') }}
{% set space_map = space | default({}) %}
{% if space_map.name %}
    -- Engine: {{ space_map.engine | default('memtx') }}
    box.schema.space.create("{{ space_map.name }}", {{ '{' }}engine = "{{ space_map.engine | default('memtx') }}"{{ '}' }})

{% if space_map.field_count | default(1) %}
    -- Creating primary index for {{ space_map.name }} with {{ space_map.field_count }} fields.
    -- primary_parts: {{ space_map.primary_parts | default('[{1, "str"}]') }}
    -- is_unique: {{ space_map.is_unique | default(True) | lower }}
    box.space["{{ space_map.name }}"]:create_index("primary", {{ '{' }}
        type = "tree",
{% if space_map.primary_parts is defined %}
        parts = {{ space_map.primary_parts | default('[{1, "str"}]') | tojson }},
{% else %}
        parts = {{ '[{1, "str"}]' | tojson }},
{% endif %}
{% if space_map.is_unique is defined and space_map.is_unique %}
        unique = true,
{% endif %}
        fields = {{ space_map.field_count | default(1) }}
    {{ '}' }})
{% endif %}
{% endif %}
{% endfor %}
{% else %}
--- No spaces defined to pre-create.
{% endif %}