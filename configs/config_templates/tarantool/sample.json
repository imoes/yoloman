{
  "instance_name": "app-prod-01",
  "work_dir": "/var/lib/tarantool/app-prod-01",
  "conf_dir": "/etc/tarantool/conf.d",
  "read_only": false,
  "listen_host": "0.0.0.0",
  "listen_port": 3301,
  "replicas": [
    {
      "uri": "repl:secret@replica01.internal:3301"
    },
    {
      "uri": "repl:secret@replica02.internal:3301"
    }
  ],
  "log_level": 3,
  "log_format": "default",
  "log_nonblock": true,
  "memtx_memory": 536870912,
  "memtx_min_tuple_size": 8,
  "memtx_max_tuple_size": 2097152,
  "vinyl_memory": 268435456,
  "vinyl_cache": 134217728,
  "vinyl_timeout": 30,
  "snapshot_by_xlog": false,
  "snapshot_interval": 1800,
  "snapshot_count": 3,
  "snapshot_in_background": true,
  "replication_synchro_timeout": 5.0,
  "replication_synchro_quorum": 2,
  "checkpoint_interval": 900,
  "quota": 1073741824,
  "worker_pool_threads": 4,
  "default_engine": "memtx",
  "replication_id": 1,
  "replication_connect_timeout": 5.0,
  "replication_connect_quorum": 1,
  "replication_skip_conflict": false,
  "spaces": [
    {
      "name": "users",
      "engine": "memtx",
      "field_count": 5,
      "primary_parts": "[{1, 'unsigned'}]",
      "is_unique": true
    },
    {
      "name": "sessions",
      "engine": "vinyl",
      "field_count": 3,
      "primary_parts": "[{1, 'string'}]",
      "is_unique": true
    }
  ]
}
