# pkwalify configuration file
# This configuration controls the behavior of the pkwalify validation tool.
# pkwalify validates data files (YAML/JSON) against a specified schema.

# Schema file to validate data against
# Path to the schema file (YAML or JSON) used for validation.
schema_file: {{ schema_file | default('/etc/pkwalify/schema.yaml') }}

# Data file to be validated
# Path to the data file (YAML or JSON) to be validated.
data_file: {{ data_file | default('/var/lib/myapp/data.yaml') }}

# Use specific Perl module for parsing
# Perl module to use for parsing. Valid values: YAML, YAML::XS, YAML::Syck, JSON, JSON::XS.
parse_module: {{ parse_module | default('YAML::XS') }}

# Suppress output if validation is successful
# If true, suppress standard output when the document is valid.
# The `lower` filter ensures the boolean is rendered as 'true' or 'false'
# which is typically expected by YAML/INI-style config parsers for booleans.
silent: {{ silent | default(true) | lower }}