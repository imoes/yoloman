# /etc/at.allow: users explicitly allowed to submit at jobs (if present, at.deny is ignored)
{% if at_allow | length > 0 %}
{% for user in at_allow %}{{ user }}
{% endfor %}
{% else %}
# /etc/at.deny: users explicitly denied from submitting at jobs (if at.allow absent, only these are blocked)
{% if at_deny | length > 0 %}
{% for user in at_deny %}{{ user }}
{% endfor %}
{% else %}
# No restrictions — all users may submit at jobs
{% endif %}
{% endif %}