# /etc/at.allow: List of usernames explicitly permitted to submit scheduled jobs using `at`.
# If this list is non-empty, only these users may use `at`, and `/etc/at.deny` is ignored.
# If this file is absent or empty, the deny list controls access.
# This block is only written if at_allow is explicitly provided and non-empty.
{% if at_allow | default([]) | length > 0 %}
{# Emit one username per line, trimmed to avoid accidental whitespace issues #}
{% for user in at_allow | default([]) %}{{ user | trim }}
{% endfor %}
{% else %}
# /etc/at.deny: List of usernames explicitly blocked from submitting `at` jobs.
# This file is ignored if `/etc/at.allow` exists and is non-empty.
# If both lists are empty or missing, no restrictions apply (all users may use `at`).
{% if at_deny | default([]) | length > 0 %}
{# Emit one username per line, trimmed to avoid accidental whitespace issues #}
{% for user in at_deny | default([]) %}{{ user | trim }}
{% endfor %}
{% else %}
# No restrictions — all users may submit at jobs
{% endif %}
{% endif %}