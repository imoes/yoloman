{
  "atalk_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable atalkd (script exits early if not enabled)."
  },
  "atalk_device": {
    "type": "string",
    "default": "eth0",
    "description": "Network interface to use for AppleTalk."
  },
  "atalk_addr_start": {
    "type": "string",
    "default": "6.254",
    "description": "Starting AppleTalk network number (format: A.B)."
  },
  "atalk_addr_end": {
    "type": "string",
    "default": "6.254",
    "description": "Ending AppleTalk network number (format: A.B)."
  },
  "default_zone": {
    "type": "string",
    "default": "MainZone",
    "description": "Default AppleTalk zone name."
  },
  "nbp_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable Name Binding Protocol (NBP)."
  },
  "rtmp_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable RTMP routing (typically disabled for single-segment setups)."
  },
  "zones": {
    "type": "list",
    "default": [],
    "description": "List of AppleTalk zones (configured externally in atalkd.conf)."
  },
  "router_interfaces": {
    "type": "list",
    "default": [],
    "description": "Interfaces to use for routing (configured externally in atalkd.conf)."
  },
  "max_connections": {
    "type": "number",
    "default": 100,
    "description": "Maximum number of connections."
  },
  "ddp_checksum": {
    "type": "bool",
    "default": false,
    "description": "Enable strict DDP checksum validation."
  },
  "log_level": {
    "type": "number",
    "default": 1,
    "description": "Logging verbosity level."
  }
}
