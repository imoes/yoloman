{
 "allowed_hosts": [
  "127.0.0.1",
  "10.0.0.0/24"
 ],
 "auth_modules": [
  "authpam"
 ],
 "enable_acl": true,
 "enable_quota": true,
 "enabled_extensions": [
  "IMAP4rev1",
  "IDLE",
  "LITERAL+",
  "CHILDREN"
 ],
 "extra_options": {
  "IMAPCaps": "IMAP4rev1 IDLE LITERAL+ MAIL-SIZE",
  "IMAPDDEBUG": "0"
 },
 "idle_timeout": 30,
 "imapd_login_wait": 120,
 "imapd_startup_wait": 30,
 "log_level": 1,
 "mail_format": "maildir",
 "mail_root": "/var/mail",
 "max_daemon": 256,
 "max_message_size": 10485760,
 "max_per_ip": 20,
 "require_ssl_for_plaintext": true,
 "ssl_ca_certificate_path": "/etc/ssl/certs/ca-certificates.crt",
 "ssl_certificate_path": "/etc/ssl/certs/courier-imap.pem",
 "ssl_enabled": true,
 "ssl_port": 993,
 "ssl_require_auth": true
}
