{
  "max_daemon": 256,
  "max_per_ip": 20,
  "log_level": 1,
  "ssl_enabled": true,
  "ssl_port": 993,
  "ssl_certificate_path": "/etc/ssl/certs/courier-imap.pem",
  "ssl_ca_certificate_path": "/etc/ssl/certs/ca-certificates.crt",
  "ssl_require_auth": true,
  "auth_modules": [
    "authpam"
  ],
  "enabled_extensions": [
    "IMAP4rev1",
    "IDLE",
    "LITERAL+",
    "CHILDREN"
  ],
  "mail_root": "/var/mail",
  "mail_format": "maildir",
  "imapd_startup_wait": 30,
  "imapd_login_wait": 120,
  "max_message_size": 10485760,
  "idle_timeout": 30,
  "allowed_hosts": [
    "127.0.0.1",
    "10.0.0.0/24"
  ],
  "require_ssl_for_plaintext": true,
  "enable_quota": true,
  "enable_acl": true,
  "extra_options": {
    "IMAPDDEBUG": "0",
    "IMAPCaps": "IMAP4rev1 IDLE LITERAL+ MAIL-SIZE"
  }
}
