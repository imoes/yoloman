{
  "profile_name": {
    "type": "string",
    "default": "lomiri-generic-carddav",
    "description": "The name of the sync profile."
  },
  "contacts_category": {
    "type": "string",
    "default": "contacts",
    "description": "The category name for contacts."
  },
  "remote_service_name": {
    "type": "string",
    "default": "lomiri-generic-carddav",
    "description": "The remote service name identifier."
  },
  "destinationtype": {
    "type": "string",
    "default": "online",
    "description": "The destination type for the account."
  },
  "enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether the profile is enabled by default."
  },
  "hidden": {
    "type": "bool",
    "default": false,
    "description": "Whether the profile is hidden in the UI."
  },
  "use_accounts": {
    "type": "bool",
    "default": true,
    "description": "Whether to use system accounts."
  },
  "sync_direction": {
    "type": "string",
    "default": "two-way",
    "description": "The direction of synchronization."
  },
  "sync_protocol": {
    "type": "string",
    "default": "carddav",
    "description": "The protocol used for synchronization."
  },
  "sync_transport": {
    "type": "string",
    "default": "HTTP",
    "description": "The transport protocol used."
  },
  "conflictpolicy": {
    "type": "string",
    "default": "prefer remote",
    "description": "The conflict resolution policy."
  },
  "schedule_enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether the automatic schedule is enabled."
  },
  "schedule_interval": {
    "type": "string",
    "default": "",
    "description": "The interval for synchronization (e.g., 15m, 1h)."
  },
  "schedule_days": {
    "type": "string",
    "default": "1,2,3,4,5,6,7",
    "description": "Comma-separated list of days for synchronization (1=Mon, 7=Sun)."
  },
  "schedule_syncconfiguredtime": {
    "type": "string",
    "default": "",
    "description": "Specific sync configured time if applicable."
  },
  "schedule_time": {
    "type": "string",
    "default": "05:00:00",
    "description": "The default time for synchronization."
  }
}
