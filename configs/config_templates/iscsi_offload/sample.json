{
  "debug_level": 2,
  "log_file_path": "/var/log/iscsiuio.log",
  "log_max_files": 3,
  "log_file_size_mb": 20,
  "ifaces": [
    "eth2",
    "eth3"
  ],
  "tcp_checksum_offload": true,
  "tcp_seg_offload": true,
  "lro": true,
  "max_conns_per_interface": 128,
  "session_timeout": 45,
  "login_timeout": 20,
  "recovery_timeout": 120,
  "path_management": true,
  "mpath_algorithm": "round-robin",
  "auto_fw_load": true,
  "fw_path": "",
  "extra_modparams": [
    "ql4xdisablesrst=1",
    "ql4xmaxlpivalue=256"
  ]
}
