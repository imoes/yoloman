# ==============================================================================
# Ceph Configuration File (ceph.conf)
# ==============================================================================
# Generated by Ansible from cephadm role template.
# This file configures the Ceph daemon behavior, networking, authentication,
# and service definitions.
# ==============================================================================

[global]
# fsid: UUID of the Ceph cluster. Must be generated once and reused across all nodes in the cluster.
fsid = {{ cluster_fsid | default('') }}

# mon initial members: List of monitor hostnames/names that should be part of the initial monitor quorum.
# If empty, cephadm usually derives this from the monitor_daemons or cluster state.
mon initial members = {{ monitor_initial_members | default([]) | join(', ') }}

# mon host: List of monitor addresses (hostname or IP) used to reach monitors.
# This is the primary mechanism for clients and new daemons to find the cluster monitors.
mon host = {{ monitor_host | default([]) | join(', ') }}

# log file: Path template for log files. Use $cluster_name, $type, $id as placeholders.
# Example: /var/log/ceph/$cluster_name/$cluster-$type.$id.log
log file = {{ log_file_path | default('/var/log/ceph/$cluster_name/$cluster-$type.$id.log') }}

# max open files: Maximum number of open file descriptors allowed for Ceph daemons.
# Set higher (e.g., 131072) for systems with large stores or high concurrency.
max open files = {{ max_open_files | default(131072) }}

# public network: CIDR or IP range for the public (client-facing) network.
# Required for proper node discovery and client access (RGW, CephFS, RBD).
public network = {{ public_network | default('') }}

# cluster network: CIDR or IP range for the cluster (internal replication traffic) network.
# Optional but recommended for production to separate replication data from client I/O.
cluster network = {{ cluster_network | default('') }}

# auth cluster required: Authentication protocol required for cluster daemons (e.g., mon, osd)
# to talk to each other. 'cephx' is the standard secure protocol.
auth cluster required = {{ auth_cluster_required | default('cephx') }}

# auth service required: Authentication protocol required for services (e.g., mgr, mds, rgw)
# to authenticate to the cluster.
auth service required = {{ auth_service_required | default('cephx') }}

# auth client required: Authentication protocol required for clients (e.g., rados, CephFS, RBD)
# to access the cluster.
auth client required = {{ auth_client_required | default('cephx') }}

# mon clock drift allowed: Maximum clock drift (seconds) allowed between monitors before quorum is broken.
mon clock drift allowed = {{ mon_clock_drift_allowed | default(0.05) }}

# mon clock drift warn extra allowed: Clock drift (seconds) threshold above which warnings are logged
# but quorum is not broken.
mon clock drift warn extra allowed = {{ mon_clock_drift_warn_extra_allowed | default(0.1) }}

# mon sync timeout: Timeout (seconds) for monitor synchronization operations.
mon sync timeout = {{ mon_sync_timeout | default(30) }}

# osd journal size: Size (MB) of the journal for each BlueStore OSD.
# Note: BlueStore typically uses an internal block.db, but this setting applies
# to legacy filestore or specific journal configurations.
osd journal size = {{ osd_journal_size | default(512) }}

# osd op threads: Number of threads used for OSD operations.
# Increase for SSDs/NVMe with high IOPS to improve performance.
osd op threads = {{ osd_op_threads | default(2) }}

# osd max object name len: Maximum length (in characters) of an object name in RADOS.
osd max object name len = {{ osd_max_object_name_len | default(256) }}

# osd max object namespace len: Maximum length (in characters) of an object namespace string.
osd max object namespace len = {{ osd_max_object_namespace_len | default(64) }}

# ==============================================================================
# RADOS Gateway (RGW) Settings
# ==============================================================================
# These settings apply only if rgw_enabled is true.
{% if rgw_enabled | default(False) %}
# rgw frontends: RGW frontend configuration string (e.g., 'civetweb port=80 port=443 ssl_certificate=/etc/ssl/rgw.crt').
rgw frontends = {{ rgw_frontends | default('civetweb port=8080') }}

# rgw dns name: DNS name used for the RGW service (for virtual-host-style bucket access).
rgw dns name = {{ rgw_dns_name | default('rgw') }}
{% endif %}

# ==============================================================================
# Monitor Definitions
# ==============================================================================
# Explicit monitor daemon entries. Usually auto-populated by cephadm,
# but can be overridden here for specific static configurations.
# monitors is a list of objects; iterate directly.
{% for mon in monitors | default([]) %}
[mon.{{ mon.name | default('') }}]
host = {{ mon.host | default('') }}
mon addr = {{ mon.address | default(mon.mon_addr | default('')) }}
{% endfor %}

# ==============================================================================
# OSD Definitions
# ==============================================================================
# Explicit OSD entries. Rarely used with cephadm as it auto-adds OSDs from devices.
# Only include these if you are manually managing OSD placement.
# osds is a list of objects; iterate directly.
{% for osd in osds | default([]) %}
[osd.{{ osd.id | default('') }}]
host = {{ osd.host | default('') }}
{% if osd.device | default(False) %}
bluestore_block_db_path = {{ osd.device }}
{% endif %}
{% endfor %}

# ==============================================================================
# Metadata Server (MDS) Definitions
# ==============================================================================
# MDS daemons for CephFS. Required if using CephFS.
# mdss is a list of objects; iterate directly.
{% for mds in mdss | default([]) %}
[mds.{{ mds.name | default('') }}]
host = {{ mds.host | default('') }}
{% endfor %}

# ==============================================================================
# RGW Daemon Definitions
# ==============================================================================
# Explicit RGW daemon entries for multi-instance RGW setups.
# rgws is a list of objects; iterate directly.
{% for rgw in rgws | default([]) %}
[client.rgw.{{ rgw.name | default('') }}]
host = {{ rgw.host | default('') }}
rgw frontends = {{ rgw.frontends | default('civetweb port=8080') }}
{% endfor %}

# ==============================================================================
# Manager (mgr) Daemon Definitions
# ==============================================================================
# Explicit manager daemon entries. cephadm usually auto-deploys these,
# but allows manual override for specific host assignments.
# mgrs is a list of objects; iterate directly.
{% for mgr in mgrs | default([]) %}
[mgr.{{ mgr.name | default('') }}]
host = {{ mgr.host | default('') }}
{% endfor %}

# ==============================================================================
# Final Boilerplate
# ==============================================================================
# Do not modify below unless explicitly instructed.
osd crush chooseleaf type = 0