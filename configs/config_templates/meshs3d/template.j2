# Configuration for meshs3d service.
# This template manages the primary configuration file for the meshs3d daemon.
# meshs3d is a visualization tool for OLSR (Optimized Link State Routing) networks,
# often used in conjunction with S3D (3D Visualization) environments.

# -----------------------------------------------------------------------------
# Debug Mode
# Description: Enable debug mode in meshs3d (corresponds to -d flag).
# When enabled, the service will output verbose diagnostic information to logs/stderr.
# Default: False
# -----------------------------------------------------------------------------
DEBUG_MODE: {{ debug_mode | default(False) | lower }}

# -----------------------------------------------------------------------------
# OLSR Node Hostname
# Description: Hostname or IP address of the OLSR node to visualize (corresponds to -H flag).
# Specifies the target OLSR router instance that meshs3d will query for topology data.
# Default: localhost
# -----------------------------------------------------------------------------
NODE_HOSTNAME: {{ node_hostname | default('localhost') }}

# -----------------------------------------------------------------------------
# S3D Environment URL
# Description: URL of the S3D environment to connect to, skipping the local S3D check (corresponds to --s3d-url flag).
# Leave empty to use default local behavior. If populated, meshs3d will attempt to
# connect to a remote S3D visualization server rather than spawning or checking a local one.
# Default: '' (empty string)
# -----------------------------------------------------------------------------
S3D_URL: {{ s3d_url | default('') }}