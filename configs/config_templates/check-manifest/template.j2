[check-manifest]
{# ignore #}
ignore =
{% if values.ignore %}
{% for pattern in values.ignore %}    {{ pattern }}
{% endfor %}
{% else %}
{% for pattern in ["PKG-INFO", "*.egg-info", "*.egg-info/*", "setup.cfg", "\\.hgtags", "\\.hgsigs", "\\.hgignore", "\\.gitignore", "\\.bzrignore", "\\.gitattributes", "\\.travis.yml", "Jenkinsfile", "*.mo"] %}    {{ pattern }}
{% endfor %}
{% endif %}
{# ignore-bad-ideas #}
ignore-bad-ideas =
{% if values.ignore_bad_ideas %}
{% for pattern in values.ignore_bad_ideas %}    {{ pattern }}
{% endfor %}
{% endif %}