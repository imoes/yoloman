# busybox-syslogd configuration defaults
# This file is a POSIX shell fragment sourced by the BusyBox syslogd/klogd
# init scripts: /etc/init.d/busybox-syslogd and /etc/init.d/busybox-klogd.
#
# It defines the command-line arguments passed to each daemon at startup.
# For the full list of supported options, run: busybox syslogd -h
# or: busybox klogd -h

# ============================================================
# Syslog daemon (syslogd) options
# ============================================================
# Description: Additional options passed to the syslogd daemon.
# Examples include buffer size (e.g., -C128 for 128 KB), log level,
# remote logging settings, or facility filters.
# Default: -C128
SYSLOG_OPTS="{{ syslog_opts | default('-C128') }}"

# ============================================================
# Kernel log daemon (klogd) options
# ============================================================
# Description: Additional options passed to the klogd daemon.
# Typical options control kernel log level, priority filtering,
# or behavior such as quiet mode (-q) or daemon mode (-d).
# Default: empty string (no extra options)
KLOG_OPTS="{{ klog_opts | default('') }}"