# Jekyll Site Configuration
# Self-documented template for Ansible role management.
# All variables are sourced from the role's variable schema with safe defaults.

# Site title
# The title of the website.
title: {{ site_title | default('My Jekyll Site') }}

# Site description
# A short description of the website.
description: "{{ site_description | default('A simple website generated by Jekyll.') }}"

# Base URL for the site
# The baseurl of the site, e.g. /blog.
baseurl: "{{ site_baseurl | default('') }}"

# The url of the site
# The url of the site, e.g. http://example.com.
url: "{{ site_url | default('http://example.com') }}"

# Site author information
# Contains the name and email address of the site author.
author:
  # The name of the site author.
  name: "{{ author_name | default('Jane Doe') }}"
  # The email address of the site author.
  email: "{{ author_email | default('jane.doe@example.com') }}"

# Build settings
# The name of the markdown processor (e.g., kramdown, redcarpet).
# See: https://jekyllrb.com/docs/configuration/options/#build-settings
markdown: {{ site_markdown | default('kramdown') }}

# Exclude files/directories from processing
# A list of files/directories to exclude from the build process.
# See: https://jekyllrb.com/docs/configuration/options/#build-settings
exclude:
{% for item in site_exclude | default(['_pages']) %}  - {{ item }}
{% endfor %}

# Plugins directory
# The directory containing plugins.
# See: https://jekyllrb.com/docs/plugins/
plugins_dir: {{ site_plugins_dir | default('_plugins') }}

# Safe mode enabled
# Whether to run Jekyll in safe mode, disabling custom plugins.
# See: https://jekyllrb.com/docs/configuration/options/#build-settings
safe: {{ site_safe | default(false) | lower }}

# Permalinks style
# The style of permalinks (e.g., pretty, date, none).
# See: https://jekyllrb.com/docs/permalinks/
permalink: {{ site_permalink | default('pretty') }}