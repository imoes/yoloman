;; -*-emacs-lisp-;
;;
;; Emacs startup file for the Debian GNU/Linux mailutils-mh package.
;;
;; This template configures GNU mailutils MH integration with Emacs (MH-E).
;; It ensures that Emacs finds the mailutils MH binaries and library path.
;; If the package is removed but not purged, it skips setup gracefully.

;; Check if the main MH binary exists; if not, skip configuration.
{% if mu_mh_bin | default('/usr/bin/mu-mh/inc') %}
(if (not (file-exists-p "{{ mu_mh_bin | default('/usr/bin/mu-mh/inc') }}"))
    (message "Package mailutils-mh removed but not purged.  Skipping setup.")

  ;; This sets up Emacs20's and Emacs21's MH-E to use GNU mailutils MH.
  ;; The MH-E Debian package (> 8.0) will find us (or nmh) on its own.
  (setq
    ;; mh-progs: Directory containing the mu-mh binaries.
    ;; Defaults to '/usr/bin/mu-mh' if not explicitly set.
    mh-progs "{{ mu_mh_bin_dir | default('/usr/bin/mu-mh') }}"

    ;; mh-lib: Path to the mailutils MH library directory.
    ;; Defaults to '/usr/share/mailutils/mh' if not explicitly set.
    mh-lib "{{ mh_lib_path | default('/usr/share/mailutils/mh') }}"

    ;; mh-lib-progs: Set to the same value as mh-progs for consistency.
    mh-lib-progs mh-progs))
{% else %}
;; The mu_mh_bin variable is not defined or is empty.
;; Skipping MH setup as the binary path cannot be determined.
{% endif %}