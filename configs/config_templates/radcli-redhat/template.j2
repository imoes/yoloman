ATTRIBUTE	Acct-Input-Gigawords	52	integer
# Acct-Output-Gigawords: High-order 32 bits of output octets
ATTRIBUTE	Acct-Output-Gigawords	53	integer
# Event-Timestamp: Time when the event occurred
