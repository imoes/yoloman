# NAS-Port-Id-String: String identifier for NAS port
ATTRIBUTE	NAS-Port-Id-String	87	string
# Framed-Pool: IP pool name for framing
ATTRIBUTE	Framed-Pool		88	string
# Chargeable-User-Identity: Identity for billing
ATTRIBUTE	Chargeable-User-Identity	89	string
# Tunnel-Client-Auth-ID: Client auth ID for tunnel
ATTRIBUTE	Tunnel-Client-Auth-ID	90	string
