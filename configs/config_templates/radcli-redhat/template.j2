ATTRIBUTE	Tunnel-Server-Auth-ID	91	string
# NAS-Filter-Rule: Filter rule for NAS
ATTRIBUTE	NAS-Filter-Rule		92	string
# Originating-Line-Info: Information about the originating line
ATTRIBUTE	Originating-Line-Info	94	string
# NAS-IPv6-Address: IPv6 address of the NAS
ATTRIBUTE	NAS-IPv6-Address	95	ipv6addr
# Framed-Interface-Id: Interface ID for framing
ATTRIBUTE	Framed-Interface-Id	96	string
