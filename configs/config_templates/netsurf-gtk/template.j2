# NetSurf GTK Configuration
# This file is generated by Ansible from the netsurf-gtk role.
# It configures the GTK2/GTK3 backend of the NetSurf browser.

# Enable verbose logging to stderr.
--verbose {{ verbose | default(False) | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# HTTP Proxy Configuration
# -----------------------------------------------------------------------------
# HTTP proxy configuration. If null, proxy is disabled. If set, all fields are
# required or have defaults as specified in items.
{% set _proxy = http_proxy | default({}) %}
{% set _proxy_enabled = http_proxy_enabled | default(False) %}

--http_proxy {{ _proxy_enabled | ternary('true', 'false') }}
{% if _proxy_enabled %}
# The http proxy host.
--http_proxy_host {{ (_proxy.host | default(http_proxy_host | default('localhost'))) }}
# The http proxy port.
--http_proxy_port {{ (_proxy.port | default(http_proxy_port | default(8080))) }}
# The authentication scheme for the http proxy.
--http_proxy_auth {{ (_proxy.auth_scheme | default(http_proxy_auth_scheme | default('basic'))) }}
# The authentication schemes user.
--http_proxy_auth_user {{ (_proxy.auth_user | default(http_proxy_auth_user | default(''))) }}
# The authentication schemes password.
--http_proxy_auth_pass {{ (_proxy.auth_pass | default(http_proxy_auth_pass | default(''))) }}
{% endif %}

# -----------------------------------------------------------------------------
# Font Settings
# -----------------------------------------------------------------------------
# Font configuration.
{% set _font = font | default({}) %}

# The default font size to use.
--font_size {{ (_font.size | default(font_size | default(16))) }}
# The minimum font size to use.
--font_min_size {{ (_font.min_size | default(font_min_size | default(8))) }}
# Family name of the sans serif font.
--font_sans {{ (_font.family_sans | default(font_family_sans | default('sans-serif'))) }}
# Family name of the serif font.
--font_serif {{ (_font.family_serif | default(font_family_serif | default('serif'))) }}
# Family name of the monospace font.
--font_mono {{ (_font.family_mono | default(font_family_mono | default('monospace'))) }}
# Family name of the cursive font.
--font_cursive {{ (_font.family_cursive | default(font_family_cursive | default('cursive'))) }}
# Family name of the fantasy font.
--font_fantasy {{ (_font.family_fantasy | default(font_family_fantasy | default('fantasy'))) }}

# -----------------------------------------------------------------------------
# Network & Content Settings
# -----------------------------------------------------------------------------
# Languages to accept.
--accept_language {{ accept_language | default('en-GB,en;q=0.9') }}
# Character set to accept.
--accept_charset {{ accept_charset | default('utf-8') }}

# Cache configuration.
{% set _cache = cache | default({}) %}
# Maximum memory cache size (KB).
--memory_cache_size {{ (_cache.memory_size | default(cache_memory_size | default(1024))) }}
# Maximum disc cache age (hours).
--disc_cache_age {{ (_cache.disk_age | default(cache_disk_age | default(24))) }}

# Ad blocking configuration.
{% set _ad_blocking = ad_blocking | default({}) %}
# Boolean to enable ad blocking.
--block_advertisements {{ (_ad_blocking.enabled | default(ad_blocking_enabled | default(False))) | ternary('true', 'false') }}

# GIF animation configuration.
{% set _gif = gif | default({}) %}
# Minimum time between gif frames (ms).
--minimum_gif_delay {{ (_gif.min_delay | default(gif_min_delay | default(100))) }}

# Referer settings.
{% set _referer = referer | default({}) %}
# Boolean controlling whether referer data should be sent.
--send_referer {{ (_referer.send | default(referer_send | default(True))) | ternary('true', 'false') }}

# Image settings.
{% set _images = images | default({}) %}
# Boolean controlling whether images should be animated.
--animate_images {{ (_images.animate | default(images_animate | default(True))) | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# Security & Certificates
# -----------------------------------------------------------------------------
# CA Bundle configuration.
{% set _ca_bundle = ca_bundle | default({}) %}
# CA bundle path.
--ca_bundle {{ (_ca_bundle.path | default(ca_bundle_path | default('/etc/ssl/certs/ca-certificates.crt'))) }}

# CA Path configuration.
{% set _ca_path = ca_path | default({}) %}
# CA path directory.
--ca_path {{ (_ca_path.path | default(ca_path_path | default('/etc/ssl/certs'))) }}

# Cookie configuration.
{% set _cookies = cookies | default({}) %}
# Cookie file path.
--cookie_file {{ (_cookies.file | default(cookies_file | default(''))) }}
# Cookie jar path.
--cookie_jar {{ (_cookies.jar | default(cookies_jar | default(''))) }}

# -----------------------------------------------------------------------------
# Navigation & Search
# -----------------------------------------------------------------------------
# Navigation settings.
{% set _navigation = navigation | default({}) %}
# Homepage URL.
--homepage_url {{ (_navigation.homepage | default(navigation_homepage | default('https://www.netsurf-browser.org/'))) }}
# Search URL bar.
--search_url_bar {{ (_navigation.search_url_bar | default(navigation_search_url_bar | default(True))) | ternary('true', 'false') }}
# Search provider URL.
--search_provider {{ (_navigation.search_provider | default(navigation_search_provider | default('https://www.google.com/search?q='))) }}
# Enable URL suggestion.
--url_suggestion {{ (_navigation.url_suggestion | default(navigation_url_suggestion | default(True))) | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# Window Settings
# -----------------------------------------------------------------------------
# Window geometry and behavior.
{% set _window = window | default({}) %}
# The X co-ordinate of the initial window (-1 for random).
--window_x {{ (_window.x | default(window_x | default(-1))) }}
# The Y co-ordinate of the initial window (-1 for random).
--window_y {{ (_window.y | default(window_y | default(-1))) }}
# The width of the initial window.
--window_width {{ (_window.width | default(window_width | default(1024))) }}
# The height of the initial window.
--window_height {{ (_window.height | default(window_height | default(768))) }}
# Window screen width.
--window_screen_width {{ (_window.screen_width | default(window_screen_width | default(1920))) }}
# Window screen height.
--window_screen_height {{ (_window.screen_height | default(window_screen_height | default(1080))) }}
# Toolbar status size.
--toolbar_status_size {{ (_window.toolbar_status_size | default(window_toolbar_status_size | default(20))) }}
# Initial scale factor.
--scale {{ (_window.scale | default(window_scale | default(1.0))) }}
# Boolean controlling whether incremental reflow is performed.
--incremental_reflow {{ (_window.incremental_reflow | default(window_incremental_reflow | default(True))) | ternary('true', 'false') }}
# Minimum time between incremental reflows (ms).
--min_reflow_period {{ (_window.min_reflow_period | default(window_min_reflow_period | default(100))) }}

# -----------------------------------------------------------------------------
# Performance & Rendering
# -----------------------------------------------------------------------------
# Performance settings.
{% set _performance = performance | default({}) %}
# Core select menu.
--core_select_menu {{ (_performance.core_select_menu | default(performance_core_select_menu | default(True))) | ternary('true', 'false') }}
# Max fetchers.
--max_fetchers {{ (_performance.max_fetchers | default(performance_max_fetchers | default(4))) }}
# Max fetchers per host.
--max_fetchers_per_host {{ (_performance.max_fetchers_per_host | default(performance_max_fetchers_per_host | default(2))) }}
# Max cached fetch handles.
--max_cached_fetch_handles {{ (_performance.max_cached_fetch_handles | default(performance_max_cached_fetch_handles | default(10))) }}
# Suppress curl debug.
--suppress_curl_debug {{ (_performance.suppress_curl_debug | default(performance_suppress_curl_debug | default(False))) | ternary('true', 'false') }}
# Target blank.
--target_blank {{ (_performance.target_blank | default(performance_target_blank | default(False))) | ternary('true', 'false') }}
# Button 2 tab (open links in new tab).
--button_2_tab {{ (_performance.button_2_tab | default(performance_button_2_tab | default(True))) | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# Layout / Margins
# -----------------------------------------------------------------------------
# Margin settings.
{% set _layout = layout | default({}) %}
# Margin top.
--margin_top {{ (_layout.margin_top | default(layout_margin_top | default(10))) }}
# Margin bottom.
--margin_bottom {{ (_layout.margin_bottom | default(layout_margin_bottom | default(10))) }}
# Margin left.
--margin_left {{ (_layout.margin_left | default(layout_margin_left | default(10))) }}
# Margin right.
--margin_right {{ (_layout.margin_right | default(layout_margin_right | default(10))) }}

# -----------------------------------------------------------------------------
# Export & Display
# -----------------------------------------------------------------------------
# Export settings.
{% set _export = export | default({}) %}
# Export scale.
--export_scale {{ (_export.scale | default(export_scale | default(1.0))) }}

# Display settings.
{% set _display = display | default({}) %}
# Suppress images.
--suppress_images {{ (_display.suppress_images | default(display_suppress_images | default(False))) | ternary('true', 'false') }}
# Remove backgrounds.
--remove_backgrounds {{ (_display.remove_backgrounds | default(display_remove_backgrounds | default(False))) | ternary('true', 'false') }}
# Enable loosening.
--enable_loosening {{ (_display.enable_loosening | default(display_enable_loosening | default(False))) | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# PDF Settings
# -----------------------------------------------------------------------------
# PDF settings.
{% set _pdf = pdf | default({}) %}
# Enable PDF compression.
--enable_PDF_compression {{ (_pdf.enable_compression | default(pdf_enable_compression | default(True))) | ternary('true', 'false') }}
# Enable PDF password.
--enable_PDF_password {{ (_pdf.enable_password | default(pdf_enable_password | default(False))) | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# GUI Colours
# -----------------------------------------------------------------------------
# GUI Colour settings.
{% set _colors = colors | default({}) %}
# GUI colour foreground 1.
--gui_colour_fg_1 {{ (_colors.gui_fg_1 | default(colors_gui_fg_1 | default('#000000'))) }}
# GUI colour background 1.
--gui_colour_bg_1 {{ (_colors.gui_bg_1 | default(colors_gui_bg_1 | default('#FFFFFF'))) }}
# GUI colour foreground 2.
--gui_colour_fg_2 {{ (_colors.gui_fg_2 | default(colors_gui_fg_2 | default('#666666'))) }}

# CSS System Colours
# List of CSS system colours to override. Each item has a 'name' and 'value'.
{% set _sys_colours = sys_colours | default([
    {'name': 'ActiveBorder', 'value': '#C0C0C0'},
    {'name': 'ActiveCaption', 'value': '#000080'},
    {'name': 'AppWorkspace', 'value': '#FFFFFF'},
    {'name': 'Background', 'value': '#000000'},
    {'name': 'ButtonFace', 'value': '#D6D6D6'},
    {'name': 'ButtonHighlight', 'value': '#FFFFFF'},
    {'name': 'ButtonShadow', 'value': '#808080'},
    {'name': 'ButtonText', 'value': '#000000'},
    {'name': 'CaptionText', 'value': '#FFFFFF'},
    {'name': 'GrayText', 'value': '#808080'},
    {'name': 'Highlight', 'value': '#000080'},
    {'name': 'HighlightText', 'value': '#FFFFFF'},
    {'name': 'InactiveBorder', 'value': '#A0A0A0'},
    {'name': 'InactiveCaption', 'value': '#A0A0A0'},
    {'name': 'InactiveCaptionText', 'value': '#000000'},
    {'name': 'InfoBackground', 'value': '#FFFFE1'},
    {'name': 'InfoText', 'value': '#000000'},
    {'name': 'Menu', 'value': '#D6D6D6'},
    {'name': 'MenuText', 'value': '#000000'},
    {'name': 'Scrollbar', 'value': '#D6D6D6'},
    {'name': 'ThreeDDarkShadow', 'value': '#404040'},
    {'name': 'ThreeDFace', 'value': '#D6D6D6'},
    {'name': 'ThreeDHighlight', 'value': '#FFFFFF'},
    {'name': 'ThreeDLightShadow', 'value': '#D6D6D6'},
    {'name': 'ThreeDShadow', 'value': '#808080'},
    {'name': 'Window', 'value': '#FFFFFF'},
    {'name': 'WindowFrame', 'value': '#000000'},
    {'name': 'WindowText', 'value': '#000000'}
]) %}
{% for colour in _sys_colours %}
--sys_colour_{{ colour.name }} {{ colour.value }}
{% endfor %}

# -----------------------------------------------------------------------------
# Rendering
# -----------------------------------------------------------------------------
# Rendering settings.
{% set _rendering = rendering | default({}) %}
# Render resample algorithm.
--render_resample {{ (_rendering.resample | default(rendering_resample | default('linear'))) }}

# -----------------------------------------------------------------------------
# Downloads
# -----------------------------------------------------------------------------
# Download settings.
{% set _downloads = downloads | default({}) %}
# Downloads clear.
--downloads_clear {{ (_downloads.clear | default(downloads_clear | default(False))) | ternary('true', 'false') }}
# Request overwrite.
--request_overwrite {{ (_downloads.request_overwrite | default(downloads_request_overwrite | default(True))) | ternary('true', 'false') }}
# Downloads directory.
--downloads_directory {{ (_downloads.directory | default(downloads_directory | default('~/Downloads'))) }}

# -----------------------------------------------------------------------------
# History
# -----------------------------------------------------------------------------
# History settings.
{% set _history = history | default({}) %}
# URL file.
--url_file {{ (_history.url_file | default(history_url_file | default(''))) }}
# History age (days).
--history_age {{ (_history.age | default(history_age | default(30))) }}

# -----------------------------------------------------------------------------
# Interaction
# -----------------------------------------------------------------------------
# Interaction settings.
{% set _interaction = interaction | default({}) %}
# Force tabs to always be show.
--show_single_tab {{ (_interaction.show_single_tab | default(interaction_show_single_tab | default(False))) | ternary('true', 'false') }}
# Button type.
--button_type {{ (_interaction.button_type | default(interaction_button_type | default('classic'))) }}
# Disable popups.
--disable_popups {{ (_interaction.disable_popups | default(interaction_disable_popups | default(False))) | ternary('true', 'false') }}
# Disable plugins.
--disable_plugins {{ (_interaction.disable_plugins | default(interaction_disable_plugins | default(True))) | ternary('true', 'false') }}
# Hover URLs.
--hover_urls {{ (_interaction.hover_urls | default(interaction_hover_urls | default(True))) | ternary('true', 'false') }}
# Focus new.
--focus_new {{ (_interaction.focus_new | default(interaction_focus_new | default(True))) | ternary('true', 'false') }}
# New blank.
--new_blank {{ (_interaction.new_blank | default(interaction_new_blank | default(False))) | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# Hotlist
# -----------------------------------------------------------------------------
# Hotlist settings.
{% set _hotlist = hotlist | default({}) %}
# Hotlist path.
--hotlist_path {{ (_hotlist.path | default(hotlist_path | default(''))) }}

# -----------------------------------------------------------------------------
# Source
# -----------------------------------------------------------------------------
# Source tab.
--source_tab {{ source_tab | default(False) | ternary('true', 'false') }}

# -----------------------------------------------------------------------------
# Theme
# -----------------------------------------------------------------------------
# Theme settings.
{% set _theme = theme | default({}) %}
# Current theme.
--current_theme {{ (_theme.current | default(theme_current | default('default'))) }}