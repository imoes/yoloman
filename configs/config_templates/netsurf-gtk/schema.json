{
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose logging."
  },
  "http_proxy": {
    "type": "object",
    "default": null,
    "description": "HTTP proxy configuration. If null, proxy is disabled. If set, all fields are required or have defaults as specified in items."
  },
  "http_proxy_enabled": {
    "type": "bool",
    "default": false,
    "description": "Boolean indicating if the http proxy is being used."
  },
  "http_proxy_host": {
    "type": "string",
    "default": "localhost",
    "description": "The http proxy host."
  },
  "http_proxy_port": {
    "type": "number",
    "default": 8080,
    "description": "The http proxy port."
  },
  "http_proxy_auth_scheme": {
    "type": "string",
    "default": "basic",
    "description": "The authentication scheme for the http proxy."
  },
  "http_proxy_auth_user": {
    "type": "string",
    "default": "",
    "description": "The authentication schemes user."
  },
  "http_proxy_auth_pass": {
    "type": "string",
    "default": "",
    "description": "The authentication schemes password."
  },
  "font": {
    "type": "object",
    "default": null,
    "description": "Font configuration."
  },
  "font_size": {
    "type": "number",
    "default": 16,
    "description": "The default font size to use."
  },
  "font_min_size": {
    "type": "number",
    "default": 8,
    "description": "The minimum font size to use."
  },
  "font_family_sans": {
    "type": "string",
    "default": "sans-serif",
    "description": "Family name of the sans serif font."
  },
  "font_family_serif": {
    "type": "string",
    "default": "serif",
    "description": "Family name of the serif font."
  },
  "font_family_mono": {
    "type": "string",
    "default": "monospace",
    "description": "Family name of the monospace font."
  },
  "font_family_cursive": {
    "type": "string",
    "default": "cursive",
    "description": "Family name of the cursive font."
  },
  "font_family_fantasy": {
    "type": "string",
    "default": "fantasy",
    "description": "Family name of the fantasy font."
  },
  "accept_language": {
    "type": "string",
    "default": "en-GB,en;q=0.9",
    "description": "Languages to accept."
  },
  "accept_charset": {
    "type": "string",
    "default": "utf-8",
    "description": "Character set to accept."
  },
  "cache": {
    "type": "object",
    "default": null,
    "description": "Cache configuration."
  },
  "cache_memory_size": {
    "type": "number",
    "default": 1024,
    "description": "Maximum memory cache size (KB)."
  },
  "cache_disk_age": {
    "type": "number",
    "default": 24,
    "description": "Maximum disc cache age (hours)."
  },
  "ad_blocking": {
    "type": "object",
    "default": null,
    "description": "Ad blocking configuration."
  },
  "ad_blocking_enabled": {
    "type": "bool",
    "default": false,
    "description": "Boolean to enable ad blocking."
  },
  "gif": {
    "type": "object",
    "default": null,
    "description": "GIF animation configuration."
  },
  "gif_min_delay": {
    "type": "number",
    "default": 100,
    "description": "Minimum time between gif frames (ms)."
  },
  "referer": {
    "type": "object",
    "default": null,
    "description": "Referer settings."
  },
  "referer_send": {
    "type": "bool",
    "default": true,
    "description": "Boolean controlling whether referer data should be sent."
  },
  "images": {
    "type": "object",
    "default": null,
    "description": "Image settings."
  },
  "images_animate": {
    "type": "bool",
    "default": true,
    "description": "Boolean controlling whether images should be animated."
  },
  "ca_bundle": {
    "type": "object",
    "default": null,
    "description": "CA Bundle configuration."
  },
  "ca_bundle_path": {
    "type": "string",
    "default": "/etc/ssl/certs/ca-certificates.crt",
    "description": "CA bundle path."
  },
  "ca_path": {
    "type": "object",
    "default": null,
    "description": "CA Path configuration."
  },
  "ca_path_path": {
    "type": "string",
    "default": "/etc/ssl/certs",
    "description": "CA path directory."
  },
  "cookies": {
    "type": "object",
    "default": null,
    "description": "Cookie configuration."
  },
  "cookies_file": {
    "type": "string",
    "default": "",
    "description": "Cookie file path."
  },
  "cookies_jar": {
    "type": "string",
    "default": "",
    "description": "Cookie jar path."
  },
  "navigation": {
    "type": "object",
    "default": null,
    "description": "Navigation settings."
  },
  "navigation_homepage": {
    "type": "string",
    "default": "https://www.netsurf-browser.org/",
    "description": "Homepage URL."
  },
  "navigation_search_url_bar": {
    "type": "bool",
    "default": true,
    "description": "Search URL bar."
  },
  "navigation_search_provider": {
    "type": "string",
    "default": "https://www.google.com/search?q=",
    "description": "Search provider URL."
  },
  "navigation_url_suggestion": {
    "type": "bool",
    "default": true,
    "description": "Enable URL suggestion."
  },
  "window": {
    "type": "object",
    "default": null,
    "description": "Window geometry and behavior."
  },
  "window_x": {
    "type": "number",
    "default": -1,
    "description": "The X co-ordinate of the initial window (-1 for random)."
  },
  "window_y": {
    "type": "number",
    "default": -1,
    "description": "The Y co-ordinate of the initial window (-1 for random)."
  },
  "window_width": {
    "type": "number",
    "default": 1024,
    "description": "The width of the initial window."
  },
  "window_height": {
    "type": "number",
    "default": 768,
    "description": "The height of the initial window."
  },
  "window_screen_width": {
    "type": "number",
    "default": 1920,
    "description": "Window screen width."
  },
  "window_screen_height": {
    "type": "number",
    "default": 1080,
    "description": "Window screen height."
  },
  "window_toolbar_status_size": {
    "type": "number",
    "default": 20,
    "description": "Toolbar status size."
  },
  "window_scale": {
    "type": "number",
    "default": 1.0,
    "description": "Initial scale factor."
  },
  "window_incremental_reflow": {
    "type": "bool",
    "default": true,
    "description": "Boolean controlling whether incremental reflow is performed."
  },
  "window_min_reflow_period": {
    "type": "number",
    "default": 100,
    "description": "Minimum time between incremental reflows (ms)."
  },
  "performance": {
    "type": "object",
    "default": null,
    "description": "Performance settings."
  },
  "performance_core_select_menu": {
    "type": "bool",
    "default": true,
    "description": "Core select menu."
  },
  "performance_max_fetchers": {
    "type": "number",
    "default": 4,
    "description": "Max fetchers."
  },
  "performance_max_fetchers_per_host": {
    "type": "number",
    "default": 2,
    "description": "Max fetchers per host."
  },
  "performance_max_cached_fetch_handles": {
    "type": "number",
    "default": 10,
    "description": "Max cached fetch handles."
  },
  "performance_suppress_curl_debug": {
    "type": "bool",
    "default": false,
    "description": "Suppress curl debug."
  },
  "performance_target_blank": {
    "type": "bool",
    "default": false,
    "description": "Target blank."
  },
  "performance_button_2_tab": {
    "type": "bool",
    "default": true,
    "description": "Button 2 tab (open links in new tab)."
  },
  "layout": {
    "type": "object",
    "default": null,
    "description": "Margin settings."
  },
  "layout_margin_top": {
    "type": "number",
    "default": 10,
    "description": "Margin top."
  },
  "layout_margin_bottom": {
    "type": "number",
    "default": 10,
    "description": "Margin bottom."
  },
  "layout_margin_left": {
    "type": "number",
    "default": 10,
    "description": "Margin left."
  },
  "layout_margin_right": {
    "type": "number",
    "default": 10,
    "description": "Margin right."
  },
  "export": {
    "type": "object",
    "default": null,
    "description": "Export settings."
  },
  "export_scale": {
    "type": "number",
    "default": 1.0,
    "description": "Export scale."
  },
  "display": {
    "type": "object",
    "default": null,
    "description": "Display settings."
  },
  "display_suppress_images": {
    "type": "bool",
    "default": false,
    "description": "Suppress images."
  },
  "display_remove_backgrounds": {
    "type": "bool",
    "default": false,
    "description": "Remove backgrounds."
  },
  "display_enable_loosening": {
    "type": "bool",
    "default": false,
    "description": "Enable loosening."
  },
  "pdf": {
    "type": "object",
