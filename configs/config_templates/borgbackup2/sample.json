{
 "archive_name": "daily-{now:%Y-%m-%d-%H%M%S}",
 "backup_sources": [
  "/etc",
  "/home",
  "/var/www"
 ],
 "compression": "zstd",
 "description": "Daily backup of /etc, /home, and /var/www to remote repository",
 "enabled": true,
 "extra_args": [
  "--exclude-caches",
  "--one-file-system"
 ],
 "prune_schedule": "weekly",
 "repository_encryption": true,
 "repository_passphrase": "my-strong-passphrase",
 "repository_url": "ssh://user@backup.example.com/~/borg-repo",
 "syslog_identifier": "borgbackup2"
}
