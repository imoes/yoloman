{
  "wsrep_cluster_address": [
    "db1.example.com:3306",
    "db2.example.com:3306",
    "db3.example.com:3306"
  ],
  "wsrep_node_name": "garb1",
  "log_path": "/var/log/garbd.log",
  "repl_connect_timeout": 10,
  "wsrep_ssl_cert": "/etc/mysql/ssl/garb.crt",
  "wsrep_ssl_key": "/etc/mysql/ssl/garb.key",
  "wsrep_ssl_ca": "/etc/mysql/ssl/ca.crt",
  "use_ssl": true,
  "socket_buffer_size": 0,
  "log_level": 1,
  "wsrep_cluster_name": "prod_cluster",
  "garbd_join_timeout": 5,
  "extra_galera_options": [
    {
      "option": "evs.suspect_timeout",
      "value": "5s"
    },
    {
      "option": "pc.weight",
      "value": "0"
    }
  ]
}
