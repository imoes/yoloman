{
 "auth_class": "auth.UserPasswordAuth",
 "auth_config": {
  "userpass": [
   [
    "admin",
    "adminpass"
   ],
   [
    "buildbot",
    "buildbotpass"
   ]
  ]
 },
 "botmaster_maxRetries": 3,
 "build_horizon": 0,
 "builders": [
  {
   "builddir": "test-builder",
   "category": "test",
   "env": {
    "PATH": "/usr/local/bin:/usr/bin",
    "PYTHONPATH": "/opt/app"
   },
   "factory_args": [
    "steps.Git(repourl='https://github.com/example/repo.git', mode='full')",
    "steps.ShellCommand(command=['pytest'], name='run-tests')"
   ],
   "factory_class": "steps.BuildFactory",
   "locks": [
    "compile-lock"
   ],
   "name": "test-builder",
   "properties": {
    "arch": "amd64",
    "distro": "ubuntu"
   },
   "slavenames": [
    "slave1",
    "slave2"
   ],
   "tags": [
    "unit-tests",
    "ci"
   ]
  }
 ],
 "change_sources": [
  {
   "args": [
    "token='ghp_xxxxxxxx'",
    "project='owner/repo'",
    "pullrequesturl='https://api.github.com/repos/owner/repo/pulls'"
   ],
   "class": "changes.GitHubPullRequest",
   "name": "github"
  },
  {
   "args": [
    "repourl='https://github.com/example/repo.git'",
    "pollInterval=60"
   ],
   "class": "changes.Git",
   "name": "git-main"
  }
 ],
 "cleanup": {
  "items": [],
  "logfiles": true,
  "logs": {
   "maxAge": 30,
   "maxBuilds": 50
  }
 },
 "db_url": "sqlite:///state.sqlite",
 "event_horizon": 1000,
 "force_build_user": "admin",
 "force_builds": true,
 "log_encoding": "utf-8",
 "log_level": "INFO",
 "master_basedir": "/var/lib/buildbot/master",
 "protocols": [
  {
   "options": "tcp:9989:interface=127.0.0.1",
   "protocol": "pb"
  }
 ],
 "schedulers": [
  {
   "args": [
    "change_filter=util.ChangeFilter(branch='main')",
    "treeStableTimer=60",
    "builderNames=['test-builder']"
   ],
   "class": "schedulers.SingleBranchScheduler",
   "name": "sched-main"
  },
  {
   "args": [
    "builderNames=['test-builder']",
    "props=None"
   ],
   "class": "schedulers.InteractiveScheduler",
   "name": "sched-pull"
  }
 ],
 "slave_port": 9989,
 "status_targets": [
  {
   "class": "www.HttpInfo",
   "config": {
    "plugins": {
     "buildslaves": true,
     "console": true,
     "grid": true,
     "waterfall": true
    },
    "port": "tcp:8010:interface=0.0.0.0"
   }
  },
  {
   "class": "status.MailNotifier",
   "config": {
    "extraRecipients": [
     "dev@example.com"
    ],
    "fromaddr": "buildbot@example.com",
    "mode": [
     "change"
    ],
    "sendToInterestedUsers": true
   }
  }
 ],
 "user_storage": ""
}
