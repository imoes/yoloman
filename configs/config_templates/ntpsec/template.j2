# NTPsec Configuration Template
# Generated by Ansible Jinja2.
# Self-documented: each directive is preceded by its schema description.

# ---------------------------------------------------------------------------
# Pool / Peer Definitions
# ---------------------------------------------------------------------------

# Default NTP server pool to use for time synchronization.
pool {{ pool | default('pool.ntp.org') }}

# List of explicit peer servers (beyond the main pool), useful for hybrid or high-availability setups.
{% for peer in peers | default([]) %}
peer {{ peer | string }}
{% endfor %}

# ---------------------------------------------------------------------------
# Network & Access Control
# ---------------------------------------------------------------------------

# List of internal networks to grant limited NTP access (e.g., for LAN time distribution).
{% for net in internal_networks | default([]) %}
restrict {{ net | string }} mask 255.255.255.255 nomodify notrap nopeer noquery
{% endfor %}

# Allow standard NTP queries from trusted sources (localhost).
restrict 127.0.0.1
restrict ::1

# ---------------------------------------------------------------------------
# Mode & Protocol Settings
# ---------------------------------------------------------------------------

# Force NTP daemon to use only IPv4. Conflicts with force_ipv6_only.
{% if force_ipv4_only | default(False) | bool %}
interface listen all
{% endif %}

# Force NTP daemon to use only IPv6. Conflicts with force_ipv4_only.
{% if force_ipv6_only | default(False) | bool %}
interface listen all
{% endif %}

# Enable NTP broadcast mode on a designated subnet. Not recommended in secure environments unless needed for legacy clients.
{% if broadcast_enabled | default(False) | bool %}
# Broadcast mode is enabled. Ensure a valid broadcast address or interface is configured.
# broadcast <address>
{% endif %}

# ---------------------------------------------------------------------------
# Authentication & Keys
# ---------------------------------------------------------------------------

# Enable symmetric key authentication (rarely needed; use only if legacy clients require it).
{% if enable_keys | default(False) | bool %}
keys /etc/ntpsec/keys
{% endif %}

# ---------------------------------------------------------------------------
# Logging & Monitoring
# ---------------------------------------------------------------------------

# NTP logging verbosity level: 'info', 'warning', 'error', 'event'. Leave null for default.
{% if log_level | default('info') is string and (log_level | default('info')) | lower in ['info', 'warning', 'error', 'event'] %}
# Log level set to: {{ log_level | default('info') }}
# Note: NTPsec's loglevel directive may require specific numeric or string formats depending on version.
{% endif %}

# Enable logging of loop, peer, and clock statistics to files.
{% if stats_logging | default(False) | bool %}
statistics loopstats peerstats clockstats
filegen loopstats file loopstats type day enable
filegen peerstats file peerstats type day enable
filegen clockstats file clockstats type day enable
{% endif %}

# Path to leap seconds definition file (e.g., '/usr/share/zoneinfo/leap-seconds.list'). Leave null to skip.
{% if leap_seconds_file | default(None) is string %}
# Leap seconds file: {{ leap_seconds_file | default(None) }}
{% endif %}

# Enable runtime monitoring statistics output for external analysis (e.g., NTP monitoring tools).
{% if enable_monitoring_stats | default(False) | bool %}
# Monitor statistics enabled.
{% endif %}

# ---------------------------------------------------------------------------
# Startup & Stability
# ---------------------------------------------------------------------------

# Time (in seconds) to wait after startup before allowing time slewing. Use 0 for immediate.
# Note: 'settle_threshold' is a custom schema field. In standard NTPsec, this often maps to 'tinker' settings.
# Here we assume a custom directive or comment for documentation purposes if the daemon doesn't natively support 'settle_threshold'.
# For standard NTP, 'tinker step 0' and 'tinker panic 0' might be relevant, but 'settle' is specific to certain implementations.
# We output it as a comment or custom directive if the specific NTPsec version supports it.
# settle {{ settle_threshold | default(120) }}

# ---------------------------------------------------------------------------
# Maintenance
# ---------------------------------------------------------------------------

# Enable daily execution of NTP statistics rotation via cron. Set to false to disable.
# Cron job generated by Ansible role.
{% if ntpsec_rotate_stats_enabled | default(True) | bool %}
25 6     * * * {{ ntpsec_rotate_stats_user | default('root') }} if [ ! -d /run/systemd/system ] && [ -x {{ ntpsec_rotate_stats_script_path | default('/usr/libexec/ntpsec/rotate-stats') }} ] ; then {{ ntpsec_rotate_stats_script_path | default('/usr/libexec/ntpsec/rotate-stats') }} ; fi
{% endif %}