{# NTP server configuration — defines the time sources and access controls #}
server {{ pool }} iburst

{# Disable monitoring by default to prevent NTP amplification attacks #}
restrict -4 default kod notrap nomodify nopeer noquery limited
restrict -6 default kod notrap nomodify nopeer noquery limited

{# Allow localhost full access #}
restrict 127.0.0.1
restrict ::1

{# Restrict specific internal networks if provided #}
{% for net in internal_networks %}
restrict {{ net.ip }} mask {{ net.mask }} nomodify notrap
{% endfor %}

{# Enable NTP statistics logging if configured #}
{% if stats_logging %}
statistics loopstats peerstats clockstats
filegen loopstat file loopstats type day enable
filegen peerstat file peerstats type day enable
filegen clockstat file clockstats type day enable
{% endif %}

{# Configure drift file location #}
driftfile /var/lib/ntpsec/ntp.drift

{# Configure leap seconds file (optional) #}
{% if leap_seconds_file %}
leapfile {{ leap_seconds_file }}
{% endif %}

{# Settle time for initial synchronization (seconds) #}
slewalways

{# Settle threshold (seconds) before slewing is allowed #}
{% if settle_threshold is defined %}
slewalways {{ settle_threshold }}
{% endif %}

{# Restrict NTP port to prevent unauthorized access #}
restrict source notrap nomodify noquery nopeer

{# Use only IPv4 or IPv6 if specified #}
{% if force_ipv4_only %}
interface ignore wildcard
interface listen 127.0.0.1
{% elif force_ipv6_only %}
interface ignore wildcard
interface listen ::1
{% endif %}

{# Optional: custom broadcast/multicast settings #}
{% if broadcast_enabled %}
broadcast 192.168.1.255
restrict 192.168.1.255 mask 255.255.255.255 nomodify notrap nopeer noquery
{% endif %}

{# Optional: manage peers explicitly (less common in secure config) #}
{% for peer in peers %}
server {{ peer.host }} iburst {{ 'prefer' if peer.prefer else '' }}
restrict {{ peer.host }} mask 255.255.255.255 nomodify notrap nopeer noquery
{% endfor %}

{# Logging configuration #}
{% if log_level is defined %}
logging {{ log_level }}
{% endif %}
logfile /var/log/ntpsec/ntpd.log

{# Key management (disabled by default for simplicity; keys rarely used in modern NTPsec) #}
{% if enable_keys %}
keys /etc/ntpsec/ntp.keys
trustedkey 1
requestkey 1
controlkey 1
{% endif %}

{# Enable stats output for monitoring tools (e.g., Chrony’s ntpmonitor) #}
{% if enable_monitoring_stats %}
monitor
monitorfile /var/lib/ntpsec/ntpmonitor.dat
{% endif %}
