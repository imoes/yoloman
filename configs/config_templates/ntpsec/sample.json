{
  "pool": "time.cloudflare.com",
  "internal_networks": [
    {
      "ip": "10.0.0.0",
      "mask": "255.255.255.0"
    },
    {
      "ip": "192.168.42.0",
      "mask": "255.255.255.0"
    }
  ],
  "stats_logging": true,
  "leap_seconds_file": "/usr/share/zoneinfo/leap-seconds.list",
  "settle_threshold": 60,
  "force_ipv4_only": true,
  "broadcast_enabled": false,
  "peers": [
    {
      "host": "0.pool.ntp.org",
      "prefer": true
    },
    {
      "host": "1.pool.ntp.org",
      "prefer": false
    }
  ],
  "log_level": "warning",
  "enable_keys": false,
  "enable_monitoring_stats": true
}
