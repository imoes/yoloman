{
  "config_paths_root": "/app/config",
  "input_file": "input/uni_timetable.fet",
  "output_directory": "/app/output",
  "max_iterations": 500000,
  "max_time_minutes": 120,
  "random_seed": 42,
  "allow_unassigned_activities": false,
  "output_format": "html",
  "output_options": {
    "html_show_rooms": true,
    "html_show_comments": false,
    "html_show_statistics": true
  },
  "log_level": "warning",
  "log_file": "/app/logs/fet.log"
}
