# /etc/crypttab: encrypted block device mappings
# Each line defines a single encrypted device to be unlocked at boot or manually.
# Fields are: <name> <device> <keyfile> <options>
{% for entry in crypttab_entries %}{{ entry.name }} {{ entry.device }} {% if entry.keyfile %}{{ entry.keyfile }}{% else %}-{% endif %} {{ entry.options | join(',') }}
{% endfor %}