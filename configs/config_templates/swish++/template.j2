# ==============================================================================
# SWISH++ Configuration File
# Auto-generated by Ansible. Do not edit manually.
# See schema documentation for field definitions.
# ==============================================================================

# -----------------------------------------------------------------------------
# Path to the SWISH++ index file.
# The main binary index database file.
# -----------------------------------------------------------------------------
IndexFile {{ index_file | default('/var/lib/swish++/index.swish-data') }}

# -----------------------------------------------------------------------------
# Directory used for temporary files during indexing.
# SWISH++ uses this dir for scratch work while building the index.
# -----------------------------------------------------------------------------
TempDirectory {{ temp_directory | default('/tmp') }}

# -----------------------------------------------------------------------------
# Path to the PID file for the search daemon.
# Written when the daemon starts to track its process ID.
# -----------------------------------------------------------------------------
PidFile {{ pid_file | default('/var/run/swish++.pid') }}

# -----------------------------------------------------------------------------
# Whether to extract metadata from files.
# Extracts HTML meta tags, PDF info, etc.
# Values: true, false, yes, no, on, off, t, f, y, n
# -----------------------------------------------------------------------------
ExtractFilter {{ extract_filter | default(True) | lower }}

# -----------------------------------------------------------------------------
# Whether to recursively index subdirectories.
# If true, SWISH++ will descend into directories found during indexing.
# -----------------------------------------------------------------------------
RecurseSubdirs {{ recurse_subdirs | default(True) | lower }}

# -----------------------------------------------------------------------------
# Whether to enable incremental indexing.
# Allows updating the index without rebuilding it entirely.
# -----------------------------------------------------------------------------
Incremental {{ incremental | default(True) | lower }}

# -----------------------------------------------------------------------------
# Whether to search in the background.
# Enables non-blocking search operations where supported.
# -----------------------------------------------------------------------------
SearchBackground {{ search_background | default(False) | lower }}

# -----------------------------------------------------------------------------
# Whether to stem words for matching.
# Reduces words to their root form (e.g., "running" -> "run") to improve
# recall of related terms.
# -----------------------------------------------------------------------------
StemWords {{ stem_words | default(True) | lower }}

# -----------------------------------------------------------------------------
# Whether to store word positions for phrase searches.
# Consumes more disk space but enables "phrase" searching capabilities.
# -----------------------------------------------------------------------------
StoreWordPositions {{ store_word_positions | default(True) | lower }}

# -----------------------------------------------------------------------------
# Whether to associate meta tags with results.
# If true, meta tags found in documents are returned with search hits.
# -----------------------------------------------------------------------------
AssociateMeta {{ associate_meta | default(True) | lower }}

# -----------------------------------------------------------------------------
# Enable Launchd cooperation (MacOS).
# Specific integration with macOS service management.
# -----------------------------------------------------------------------------
LaunchdCooperation {{ launchd_cooperation | default(False) | lower }}

# -----------------------------------------------------------------------------
# Whether to follow symbolic links.
# Follows symlinks to directories and files during the indexing process.
# -----------------------------------------------------------------------------
FollowLinks {{ follow_links | default(True) | lower }}

# -----------------------------------------------------------------------------
# Format of search results: 'classic' or 'XML'.
# 'classic' produces plain text output; 'XML' produces structured XML output.
# -----------------------------------------------------------------------------
ResultsFormat {{ results_format | default('classic') }}

# -----------------------------------------------------------------------------
# Daemon mode: 'none', 'tcp', 'unix', or 'both'.
# 'none': Run as a command-line tool.
# 'tcp': Listen for TCP connections.
# 'unix': Listen on a Unix domain socket.
# 'both': Listen on both TCP and Unix socket.
# -----------------------------------------------------------------------------
SearchDaemon {{ search_daemon | default('none') }}

# -----------------------------------------------------------------------------
# Maximum number of results to return.
# Limits the size of the result set returned by the search daemon.
# -----------------------------------------------------------------------------
ResultsMax {{ results_max | default(10) }}

# -----------------------------------------------------------------------------
# Number of words near each other to consider a match.
# Used for proximity searches. 0 means no proximity restriction.
# -----------------------------------------------------------------------------
WordsNear {{ words_near | default(0) }}

# -----------------------------------------------------------------------------
# Minimum word length to index.
# Words shorter than this length are ignored during indexing.
# -----------------------------------------------------------------------------
WordThreshold {{ word_threshold | default(3) }}

# -----------------------------------------------------------------------------
# Maximum number of threads for indexing.
# Controls parallelism during the indexing phase.
# -----------------------------------------------------------------------------
ThreadsMax {{ threads_max | default(4) }}

# -----------------------------------------------------------------------------
# Minimum number of threads for indexing.
# Minimum parallelism level for the indexing worker pool.
# -----------------------------------------------------------------------------
ThreadsMin {{ threads_min | default(1) }}

# -----------------------------------------------------------------------------
# Socket queue size.
# Maximum number of pending connections in the OS listen queue.
# -----------------------------------------------------------------------------
SocketQueueSize {{ socket_queue_size | default(10) }}

# -----------------------------------------------------------------------------
# Socket timeout in seconds.
# Time to wait for activity on a connection before closing it.
# -----------------------------------------------------------------------------
SocketTimeout {{ socket_timeout | default(10) }}

# -----------------------------------------------------------------------------
# Thread timeout in seconds.
# Time after which an idle or stuck indexing thread is terminated.
# -----------------------------------------------------------------------------
ThreadTimeout {{ thread_timeout | default(0) }}

# -----------------------------------------------------------------------------
# Number of lines to use for document title.
# Determines how many leading lines are scanned to determine the document title.
# -----------------------------------------------------------------------------
TitleLines {{ title_lines | default(3) }}

# -----------------------------------------------------------------------------
# Verbosity level (0-5).
# 0 = silent, 5 = most verbose. Controls logging detail.
# -----------------------------------------------------------------------------
Verbosity {{ verbosity | default(1) }}

# -----------------------------------------------------------------------------
# Max word files.
# Internal limit on the number of separate word files created.
# -----------------------------------------------------------------------------
WordFilesMax {{ word_files_max | default(0) }}

# -----------------------------------------------------------------------------
# Max percent of words to skip.
# Percentage threshold for skipping overly common or rare words.
# -----------------------------------------------------------------------------
WordPercentMax {{ word_percent_max | default(0) }}

# -----------------------------------------------------------------------------
# Files reserve.
# Internal optimization parameter for file handle reservation.
# -----------------------------------------------------------------------------
FilesReserve {{ files_reserve | default(0) }}

# -----------------------------------------------------------------------------
# Separator between result fields.
# Character used to separate fields in the classic result format output.
# -----------------------------------------------------------------------------
ResultSeparator {{ result_separator | default(' ') }}

# -----------------------------------------------------------------------------
# User to run search daemon as.
# OS-level user account for dropping privileges when running the daemon.
# Leave empty to run as current user.
# -----------------------------------------------------------------------------
{% if user | default('') | length > 0 %}
User {{ user | default('') }}
{% endif %}

# -----------------------------------------------------------------------------
# Group to run search daemon as.
# OS-level group account for dropping privileges when running the daemon.
# Leave empty to use user's primary group.
# -----------------------------------------------------------------------------
{% if group | default('') | length > 0 %}
Group {{ group | default('') }}
{% endif %}

# -----------------------------------------------------------------------------
# Path to stop word file.
# File containing words to ignore completely during indexing and searching.
# -----------------------------------------------------------------------------
{% if stop_word_file | default('') | length > 0 %}
StopWordFile {{ stop_word_file | default('') }}
{% endif %}

# -----------------------------------------------------------------------------
# Extract extension.
# Internal extension hint for extraction filters.
# -----------------------------------------------------------------------------
{% if extract_extension | default('') | length > 0 %}
ExtractExtension {{ extract_extension | default('') }}
{% endif %}

# -----------------------------------------------------------------------------
# Socket Address for TCP daemon.
# Format: Host:Port. Use '*' or IP for all interfaces.
# -----------------------------------------------------------------------------
{% if search_daemon | default('none') in ['tcp', 'both'] %}
SocketAddress {{ socket_address | default('*:8080') }}
{% endif %}

# -----------------------------------------------------------------------------
# Socket File for Unix domain socket.
# Path where the Unix domain socket file will be created.
# -----------------------------------------------------------------------------
{% if search_daemon | default('none') in ['unix', 'both'] %}
SocketFile {{ socket_file | default('/tmp/swish.sock') }}
{% endif %}

# -----------------------------------------------------------------------------
# Exclude files matching these shell patterns.
# Files matching any of these patterns are skipped during indexing.
# -----------------------------------------------------------------------------
{% for pattern in exclude_files | default([]) %}
ExcludeFile {{ pattern }}
{% endfor %}

# -----------------------------------------------------------------------------
# Exclude meta tags from indexing.
# List of meta tag names to ignore when extracting metadata.
# -----------------------------------------------------------------------------
{% if exclude_meta | default([]) | length > 0 %}
ExcludeMeta {{ exclude_meta | default([]) | join(' ') }}
{% endif %}

# -----------------------------------------------------------------------------
# Extract specific meta tags.
# List of meta tag names to explicitly extract and store.
# -----------------------------------------------------------------------------
{% if extract_meta | default([]) | length > 0 %}
ExtractMeta {{ extract_meta | default([]) | join(' ') }}
{% endif %}

# -----------------------------------------------------------------------------
# Exclude CSS classes (for HTML indexing).
# Content within HTML elements having these classes is excluded.
# -----------------------------------------------------------------------------
{% if exclude_class | default([]) | length > 0 %}
ExcludeClass {{ exclude_class | default([]) | join(' ') }}
{% endif %}

# -----------------------------------------------------------------------------
# Filter: Handle attachments by MIME type pattern and command.
# Each item is a map with 'pattern' (MIME/type glob) and 'command' (shell cmd).
# -----------------------------------------------------------------------------
{% for attachment in filter_attachments | default([]) %}
FilterAttachment {{ attachment.pattern | default('') }} {{ attachment.command | default('') }}
{% endfor %}

# -----------------------------------------------------------------------------
# Filter: Handle files by extension pattern and command.
# Each item is a map with 'pattern' (ext glob) and 'command' (shell cmd).
# -----------------------------------------------------------------------------
{% for file_filter in filter_files | default([]) %}
FilterFile {{ file_filter.pattern | default('') }} {{ file_filter.command | default('') }}
{% endfor %}

# -----------------------------------------------------------------------------
# IncludeFile: Specify modules and file patterns for indexing.
# Each item is a map with 'module' (SWISH module name) and 'patterns' (file globs).
# -----------------------------------------------------------------------------
{% for item in include_files | default([]) %}
IncludeFile {{ item.module | default('') }} {{ item.patterns | default([]) | join(' ') }}
{% endfor %}

# -----------------------------------------------------------------------------
# IncludeMeta: Map meta names to index names.
# Each item defines a mapping from source meta tag to target index meta tag.
# -----------------------------------------------------------------------------
{% for meta in include_meta | default([]) %}
IncludeMeta {{ meta }}
{% endfor %}