{
  "index_file": "/var/lib/swish++/myindex.swish-data",
  "temp_directory": "/var/tmp/swish",
  "pid_file": "/run/swish++.pid",
  "extract_filter": true,
  "recurse_subdirs": true,
  "incremental": true,
  "search_background": false,
  "stem_words": true,
  "store_word_positions": true,
  "associate_meta": true,
  "launchd_cooperation": false,
  "follow_links": true,
  "results_format": "XML",
  "search_daemon": "tcp",
  "results_max": 20,
  "words_near": 5,
  "word_threshold": 3,
  "threads_max": 8,
  "threads_min": 2,
  "socket_queue_size": 20,
  "socket_timeout": 30,
  "thread_timeout": 0,
  "title_lines": 5,
  "verbosity": 2,
  "word_files_max": 0,
  "word_percent_max": 0,
  "files_reserve": 0,
  "result_separator": " | ",
  "user": "swish",
  "group": "swish",
  "stop_word_file": "/etc/swish++/stopwords",
  "extract_extension": "",
  "socket_address": "127.0.0.1:8080",
  "socket_file": "/tmp/swish.sock",
  "exclude_files": [
    "*.bak",
    "*.tmp"
  ],
  "exclude_meta": [],
  "extract_meta": [
    "author",
    "description"
  ],
  "exclude_class": [
    "sidebar",
    "footer"
  ],
  "filter_attachments": [
    {
      "pattern": "application/pdf",
      "command": "pdftotext %f @%F.txt"
    },
    {
      "pattern": "application/msword",
      "command": "antiword %f > @%F.txt"
    }
  ],
  "filter_files": [
    {
      "pattern": "*.gz",
      "command": "gunzip -c %f > @%F.txt"
    },
    {
      "pattern": "*.bz2",
      "command": "bunzip2 -c %f > @%F.txt"
    }
  ],
  "include_files": [
    {
      "module": "html",
      "patterns": [
        "*.html",
        "*.htm"
      ]
    },
    {
      "module": "text",
      "patterns": [
        "*.txt",
        "*.md"
      ]
    },
    {
      "module": "mail",
      "patterns": [
        "*.eml",
        "*.msg"
      ]
    }
  ],
  "include_meta": [
    "title=news_title",
    "date=pub_date"
  ]
}
