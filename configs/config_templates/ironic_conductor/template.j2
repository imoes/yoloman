[DEFAULT]
# Enables debug logging
# debug = False
# Enables verbose logging
# verbose = True
# Path to the Ironic configuration directory
# config_dir = /etc/ironic
# Path to the Ironic config file
# config_file = /etc/ironic/ironic.conf

# Name of this node (used in logs and for conductor identification)
# conductor_id = {{ conductor_id }}

# Number of RPC workers for the conductor service
# rpc_workers = {{ rpc_workers }}

# Number of API workers (used only if api_workers not set)
# api_workers = {{ api_workers }}

# RPC backend (should be 'rabbit' for most deployments)
# transport_url = {{ transport_url }}

# Authentication strategy (keystone or noauth)
# auth_strategy = {{ auth_strategy }}

# Default IPMI timeout (seconds)
# default_ipmi_timeout = {{ default_ipmi_timeout }}

# Enable or disable the inspection service
# enable_inspector = {{ enable_inspector }}

# Enable or disable the deployment API
# enable_api = {{ enable_api }}

# Hostname or IP address where the Ironic API is served (for conductor self-registration)
# my_ip = {{ my_ip }}

# Default HTTP timeout for drivers (seconds)
# driver_http_timeout = {{ driver_http_timeout }}

# Default HTTP retries for drivers
# driver_http_retries = {{ driver_http_retries }}

# Default health check interval (seconds)
# health_check_interval = {{ health_check_interval }}

# Maximum number of concurrent node operations (e.g., provisioning steps)
# max_concurrent_builds = {{ max_concurrent_builds }}

# Maximum number of concurrent cleaning operations
# max_cleaning_timeout = {{ max_cleaning_timeout }}

# Maximum number of concurrent RAID config operations
# max_raid_config_timeout = {{ max_raid_config_timeout }}

# Enable or disable automatic cleaning
# default_cleaning_disable = {{ default_cleaning_disable }}

# Enable or disable automatic inspection on new nodes
# enable_auto_clean = {{ enable_auto_clean }}

# Enable or disable management interface for drivers
# default_management_interface = {{ default_management_interface }}

# Enable or disable power interface for drivers
# default_power_interface = {{ default_power_interface }}

# Enable or disable console interface for drivers
# default_console_interface = {{ default_console_interface }}

# Enable or disable RAID interface for drivers
# default_raid_interface = {{ default_raid_interface }}

# Enable or disable vendor interface for drivers
# default_vendor_interface = {{ default_vendor_interface }}

# Enable or disable deploy interface for drivers
# default_deploy_interface = {{ default_deploy_interface }}

# Enable or disable network interface for drivers
# default_network_interface = {{ default_network_interface }}

# List of enabled network drivers (comma-separated)
# enabled_network_interfaces = {{ enabled_network_interfaces | join(', ') }}

# List of enabled storage interfaces (comma-separated)
# enabled_storage_interfaces = {{ enabled_storage_interfaces | join(', ') }}

# List of enabled RAID interfaces (comma-separated)
# enabled_raid_interfaces = {{ enabled_raid_interfaces | join(', ') }}

# List of enabled vendor interfaces (comma-separated)
# enabled_vendor_interfaces = {{ enabled_vendor_interfaces | join(', ') }}

# List of enabled console interfaces (comma-separated)
# enabled_console_interfaces = {{ enabled_console_interfaces | join(', ') }}

# List of enabled RAID interfaces (comma-separated)
# enabled_raid_interfaces = {{ enabled_raid_interfaces | join(', ') }}

# List of enabled boot interfaces (comma-separated)
# enabled_boot_interfaces = {{ enabled_boot_interfaces | join(', ') }}

# List of enabled deploy interfaces (comma-separated)
# enabled_deploy_interfaces = {{ enabled_deploy_interfaces | join(', ') }}

# List of enabled management interfaces (comma-separated)
# enabled_management_interfaces = {{ enabled_management_interfaces | join(', ') }}

# List of enabled power interfaces (comma-separated)
# enabled_power_interfaces = {{ enabled_power_interfaces | join(', ') }}

# List of enabled inspection interfaces (comma-separated)
# enabled_inspection_interfaces = {{ enabled_inspection_interfaces | join(', ') }}

# List of enabled network interfaces for provisioning (comma-separated)
# enabled_provisioning_network_interfaces = {{ enabled_provisioning_network_interfaces | join(', ') }}

# List of enabled inspect interfaces (comma-separated)
# enabled_inspect_interfaces = {{ enabled_inspect_interfaces | join(', ') }}

# List of enabled inventory interfaces (comma-separated)
# enabled_inventory_interfaces = {{ enabled_inventory_interfaces | join(', ') }}

# List of enabled storage interfaces for provisioning (comma-separated)
# enabled_provisioning_storage_interfaces = {{ enabled_provisioning_storage_interfaces | join(', ') }}

# List of enabled network interfaces for provisioning (comma-separated)
# enabled_provisioning_network_interfaces = {{ enabled_provisioning_network_interfaces | join(', ') }}

# List of enabled inventory interfaces (comma-separated)
# enabled_inventory_interfaces = {{ enabled_inventory_interfaces | join(', ') }}

# List of enabled storage interfaces (comma-separated)
# enabled_storage_interfaces = {{ enabled_storage_interfaces | join(', ') }}

[conductor]
# Database connection string
# database_connection = {{ database_connection }}

# Maximum number of database connections
# max_pool_size = {{ database_max_pool_size }}

# Idle connection timeout (seconds)
# pool_timeout = {{ database_pool_timeout }}

[neutron]
# URL to the Neutron API service
# url = {{ neutron_url }}

# Neutron authentication strategy (keystone or noauth)
# auth_strategy = {{ neutron_auth_strategy }}

# Project domain name (for keystone auth)
# project_domain_name = {{ neutron_project_domain_name }}

# Project name (for keystone auth)
# project_name = {{ neutron_project_name }}

# User domain name (for keystone auth)
# user_domain_name = {{ neutron_user_domain_name }}

# Username (for keystone auth)
# username = {{ neutron_username }}

# Password (for keystone auth)
# password = {{ neutron_password }}

# URL to the Neutron API service
# url = {{ neutron_url }}

[inspector]
# URL to the Ironic Inspector API service
# url = {{ inspector_url }}

# Authentication strategy (keystone or noauth)
# auth_strategy = {{ inspector_auth_strategy }}

[keystone_authtoken]
# Identity service auth URL
# auth_url = {{ keystone_auth_url }}

# Project domain name
# project_domain_name = {{ keystone_project_domain_name }}

# Project name
# project_name = {{ keystone_project_name }}

# User domain name
# user_domain_name = {{ keystone_user_domain_name }}

# Username
# username = {{ keystone_username }}

# Password
# password = {{ keystone_password }}

# API endpoint type (public, internal, admin)
# interface = {{ keystone_interface }}

# Insecure TLS connection (disable certificate verification)
# insecure = {{ keystone_insecure }}

[paste_deploy]
# Flavor of the Ironic API
# flavor = {{ api_flavor }}
