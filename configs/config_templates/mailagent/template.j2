# Mailagent Configuration File
# This file controls the behavior of the mailagent filtering system.
# All variables are self-documenting with their defaults injected inline.

# Your electronic mail address.
email = {{ email | default('user@example.com') }}

# Defines where the home directory is.
home = {{ home | default('/home/user') }}

# Your domain name, without the leading dot.
domain = {{ domain | default('example.com') }}

# First name of the user.
name = {{ name | default('User') }}

# Login name of the user who runs mailagent.
user = {{ user | default('user') }}

# Spool directory.
spool = {{ spool | default('{{ home }}/var/mailagent') }}

# Logging directory.
logdir = {{ logdir | default('{{ home }}/var/log') }}

# Name of the log file.
log = {{ log | default('agentlog') }}

# Log level (0-20).
level = {{ level | default(9) }}

# Maximum size in bytes of files before using kit for sending files.
maxsize = {{ maxsize | default(150000) }}

# The name of the file holding the filtering rules.
rules = {{ rules | default('{{ home }}/.rules') }}

# Queue directory.
queue = {{ queue | default('{{ spool }}/queue') }}

# Directory used for name hashing.
hash = {{ hash | default('{{ spool }}/dbr') }}

# File holding the mailagent context.
context = {{ context | default('{{ spool }}/context') }}

# The name of the callout queue file.
callout = {{ callout | default('{{ spool }}/callout') }}

# Name of the file containing authorized commands.
comfile = {{ comfile | default('{{ spool }}/commands') }}

# Name of the file containing authorized SERVER commands.
comserver = {{ comserver | default('{{ spool }}/server') }}

# Directory where help files for SERVER commands are kept.
helpdir = {{ helpdir | default('{{ spool }}/help') }}

# Directory listing user clearances for SERVER powers.
powerdir = {{ powerdir | default('{{ spool }}/powers/clearance') }}

# Directory for SERVER power administration.
powers = {{ powers | default('{{ spool }}/powers') }}

# File where SERVER power requests are logged.
powerlog = {{ powerlog | default('{{ logdir }}/powerlog') }}

# Directory name where shell and perl server commands are stored.
servdir = {{ servdir | default('{{ spool }}/cmds') }}

# Name of the file describing new filtering commands.
newcmd = {{ newcmd | default('{{ spool }}/newcmd') }}

# A list of all the available distributions.
distlist = {{ distlist | default('{{ spool }}/distribs') }}

# A small description for the available distributions.
proglist = {{ proglist | default('{{ spool }}/proglist') }}

# Name of the file used to save the patchlevels for archived distributions.
plsave = {{ plsave | default('{{ spool }}/plsave') }}

# File used to compute job numbers.
seq = {{ seq | default('{{ home }}/.seq') }}

# Name of the file containing the list of compressed folders.
compress = {{ compress | default('{{ home }}/.compress') }}

# Name of the file containing specifications for compression.
compspecs = {{ compspecs | default('{{ spool }}/compressors') }}

# The default compression tag when creating new folders.
comptag = {{ comptag | default('gzip') }}

# Directory for temporary files.
tmpdir = {{ tmpdir | default('/tmp') }}

# The name of the program used to send mail.
sendmail = {{ sendmail | default('/usr/lib/sendmail') }}

# The name of the program used to post news.
sendnews = {{ sendnews | default('/usr/local/bin/inews') }}

# Options to be passed to the mailer.
mailopt = {{ mailopt | default('-odq -i') }}

# Options to be passed to the news posting program.
newsopt = {{ newsopt | default('') }}

# Minimum path to be used by C filter program.
path = {{ path | default('/bin:/usr/bin:/usr/ucb') }}

# If set to ON, new folders will be created as MMDF ones.
mmdfbox = {{ mmdfbox | default(False) | lower }}

# Set this to ON if you wish to be able to save mail in MMDF-style mailboxes.
mmdf = {{ mmdf | default(False) | lower }}

# The name of the MH profile to be used.
mhprofile = {{ mhprofile | default('{{ home }}/.mh_profile') }}

# Name of the file to put in directory folders, specifying the message prefix.
msgprefix = {{ msgprefix | default('.msg_prefix') }}

# Name of the file used to cache the latest compiled rules.
rulecache = {{ rulecache | default('{{ spool }}/rulecache') }}

# Set this to ON to enable macro substitutions in rule patterns.
rulemac = {{ rulemac | default(False) | lower }}

# The delay in seconds between two locking attempts.
lockdekay = {{ lockdekay | default(2) }}

# The maximum delay in seconds for holding a lock.
lockhold = {{ lockhold | default(3600) }}

# Maximum number of locking attempts before giving up.
lockmax = {{ lockmax | default(20) }}

# Controls locking safety (ON, OFF, PARTIAL).
locksafe = {{ locksafe | default('ON') }}

# Time after which to start emitting warnings when busy trying to acquire a lock.
lockwarn = {{ lockwarn | default('20,300') }}

# Set it to ON to ensure NFS-secure locks.
nfslock = {{ nfslock | default(False) | lower }}

# Whether to be strict before using exec() to launch a new process.
execsafe = {{ execsafe | default(False) | lower }}

# Whether to skip the exec() security checks alltogether.
execskip = {{ execskip | default(False) | lower }}

# When set to ON, mailagent performs extensive security checks.
secure = {{ secure | default(True) | lower }}

# When set to ON, carefully checks symbolic links to directories.
linkdirs = {{ linkdirs | default(True) | lower }}

# If turned OFF, group-writable files will be managed as if they were secure.
groupsafe = {{ groupsafe | default(True) | lower }}

# Default umask.
umask = {{ umask | default('077') }}

# Period after which an entry in the database should be removed.
agemax = {{ agemax | default('1y') }}

# Cleaning period for database entries.
cleanlaps = {{ cleanlaps | default('1M') }}

# Set to ON to enable automatic cleaning of database entries.
autoclean = {{ autoclean | default(False) | lower }}

# Maximum number of commands allowed to be executed by a SERVER command.
maxcmds = {{ maxcmds | default(10) }}

# Maximum number of errors for the SERVER command before flushing.
maxerrors = {{ maxerrors | default(10) }}

# Maximum number of seconds a mail can sit in the mailagent queue.
queuehold = {{ queuehold | default(1800) }}

# Maximum number of seconds after which mailagent should flag messages as old.
queuelost = {{ queuelost | default(86400) }}

# Time in seconds telling the C filter program how long it must wait before launching mailagent.
queuewait = {{ queuewait | default(60) }}

# Timeout for RUN commands and friends.
runmax = {{ runmax | default(3600) }}

# The charset to use when biffing on the terminal.
biffchars = {{ biffchars | default('utf-8') }}

# Whether or not biffing is wanted.
biff = {{ biff | default(False) | lower }}

# Headers to be printed out when biffing.
biffhead = {{ biffhead | default('From, To, Subject, Date') }}

# The maximum length of the message body printed when biffing.
bifflen = {{ bifflen | default(560) }}

# The maximum number of lines of the message body printed when biffing.
bifflines = {{ bifflines | default(7) }}

# Controls whether blank body lines should be printed when biffing.
biffnl = {{ biffnl | default(True) | lower }}

# Controls whether trimmed lines within the biff message should be replaced by a message.
bifftrim = {{ bifftrim | default(True) | lower }}

# States how many lines long a leading quotation should be before performing any trimming.
bifftrlen = {{ bifftrlen | default(2) }}

# Controls whether the leading attribution line introducing a trimmed quotation should be part of the biff message.
biffquote = {{ biffquote | default(True) | lower }}

# Whether the message should be reformatted to nicely fit into the terminal.
biffnice = {{ biffnice | default(False) | lower }}

# When turned ON, the body of the message is compacted before biffing.
biffmh = {{ biffmh | default(False) | lower }}

# The path to a file describing the format biffing should use.
biffmsg = {{ biffmsg | default('{{ home }}/.biffmsg') }}

# Whether to fake a From: line into the message header when absent.
fromfake = {{ fromfake | default(True) | lower }}

# Whether to escape all the From lines in the message.
fromall = {{ fromall | default(False) | lower }}

# Whether to escape potentially dangerous From lines.
fromesc = {{ fromesc | default(True) | lower }}

# Whether to fake a To: line into the message header.
tofake = {{ tofake | default(True) | lower }}

# A comma separated list of alternate logins that are also valid for the user (mail aliases).
tome = {{ tome | default([]) | join(',') }}

# The time zone value for environment variable TZ.
timezone = {{ timezone | default('') }}

# The name of the file to be sent back in vacation mode.
vacfile = {{ vacfile | default('{{ home }}/.vacation') }}

# The minimum time elapsed between two vacation messages.
vacperiod = {{ vacperiod | default('1d') }}

# Set to ON to switch the vacation mode.
vacation = {{ vacation | default(False) | lower }}

# When ON, all changes to the vacation file are forbidden.
vacfixed = {{ vacfixed | default(False) | lower }}

# Name of the directory which should be used for dumps.
emergdir = {{ emergdir | default('{{ home }}/tmp/lost+mail') }}