# Nodau configuration file
# Location: ~/.config/nodau/nodau.conf

# Name of a text editor executable (e.g., vim, nano).
# Falls back to $EDITOR if empty.
external_editor={{ external_editor | default('') }}

# If true, forces the use of the builtin console editor regardless of other settings.
force_builtin_editor={{ force_builtin_editor | default(false) | lower }}

# If true, nodau will attempt to import notes from the 0.2.x database on startup.
import_old_db={{ import_old_db | default(true) | lower }}

# If true, allows creating new notes via the edit command if the name doesn't exist.
edit_autocreate={{ edit_autocreate | default(true) | lower }}