{# ============================================================================== #}
{# splitvt configuration file (~/.splitvt.conf)                                    #}
{# Generated by Ansible Jinja2 template.                                          #}
{# This file configures splitvt: a utility to split a terminal into two windows.  #}
{# ============================================================================== #}

{# -------------------------------------------------------------------------- #}
{# Control Characters                                                         #}
{# -------------------------------------------------------------------------- #}

{# command_char: The control character to enter command mode in splitvt.      #}
{# Default is ^O.                                                             #}
set command_char {{ command_char | default('^O') }}

{# quote_char: The control character to quote the next character typed.       #}
{# Default is ^V.                                                             #}
set quote_char {{ quote_char | default('^V') }}

{# switch_char: The control character to switch focus between upper and       #}
{# lower windows.                                                             #}
{# Default is ^W.                                                             #}
set switch_char {{ switch_char | default('^W') }}

{# -------------------------------------------------------------------------- #}
{# Window Geometry                                                            #}
{# -------------------------------------------------------------------------- #}

{# upper_lines: The number of lines to allocate to the upper window.          #}
{# Default is 12.                                                             #}
set upper_lines {{ upper_lines | default(12) }}

{# -------------------------------------------------------------------------- #}
{# Shell Behavior                                                             #}
{# -------------------------------------------------------------------------- #}

{# login_mode: Whether to run the shells as login shells (on/off).            #}
{# Default is True (on).                                                      #}
set login {{ login_mode | default(True) }}

{# -------------------------------------------------------------------------- #}
{# Commands                                                                   #}
{# -------------------------------------------------------------------------- #}

{# upper_command: List of commands to run in the upper window.                #}
{# Supports multiple entries if needed, but typically one shell.              #}
{# Default is ['/bin/sh'].                                                    #}
{% for cmd in upper_command | default(['/bin/sh']) %}
run -upper {{ cmd }}
{% endfor %}

{# lower_command: List of commands to run in the lower window.                #}
{# Supports multiple entries.                                                 #}
{# Default is ['/usr/bin/top'].                                               #}
{% for cmd in lower_command | default(['/usr/bin/top']) %}
run -lower {{ cmd }}
{% endfor %}