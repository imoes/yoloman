#!/usr/bin/env perl
# ==============================================================================
# igal2 Configuration Script
#
# This file is a self-documenting template for the igal2 image gallery generator.
# It defines source/destination directories, image processing flags, and output
# formatting options. All variables are populated via Ansible/Jinja2 with safe
# defaults derived from the schema.
# ==============================================================================

# Source directory containing images
# Schema: source_dir
# Desc: The directory containing the source JPG/PNG/GIF images to process.
my $igal2_source = "{{ source_dir | default('/var/lib/igal2/images') }}";

# Destination directory for generated HTML/CSS/Thumbnails (empty string means same as source)
# Schema: dest_dir
# Desc: Subdirectory relative to source_dir where HTML/CSS/thumbnails are placed. Empty means same directory.
my $igal2_dest = "{{ dest_dir | default('') }}";

# Main index filename
# Schema: index_file
# Desc: Name of the main thumbnail index file generated by igal2.
my $igal2_index = "{{ index_file | default('index.html') }}";

# Thumbnail width (columns in index table)
# Schema: width
# Desc: Number of images wide (columns) in the thumbnail index table.
my $igal2_width = {{ width | default(5) }};

# Thumbnail height in pixels
# Schema: height
# Desc: Height in pixels of the thumbnails.
my $igal2_height = {{ height | default(75) }};

# Scale thumbnails to longest dimension of n pixels (overrides height if set)
# Schema: xy
# Desc: Scale thumbnails to n pixels along their longest dimension. 0 to disable.
my $igal2_xy = {{ xy | default(0) }};

# Cell padding for thumbnail table
# Schema: padding
# Desc: Cellpadding value (in pixels) for the thumbnail index table.
my $igal2_padding = {{ padding | default(3) }};

# Maximum images per page (0 for no pagination)
# Schema: pagination
# Desc: Maximum number of images on one page. 0 means no pagination.
my $igal2_pagination = {{ pagination | default(0) }};

# Add image dimensions/size under thumbnails (true/false)
# Schema: show_dims
# Desc: Write image dimensions and sizes under each thumbnail.
my $igal2_dims = {{ show_dims | default(false) }};

# Add captions under thumbnails (true/false)
# Schema: show_captions
# Desc: Write captions under each thumbnail on the index page.
my $igal2_captions = {{ show_captions | default(false) }};

# Use filename for slide titles (true/false)
# Schema: slide_titles_from_name
# Desc: Use image file names for the HTML slide titles instead of captions/defaults.
my $igal2_slidetitles = {{ slide_titles_from_name | default(false) }};

# Use filename for slide filenames (true/false)
# Schema: slide_names_from_file
# Desc: Name slide files after the image file name instead of 1.html, 2.html, etc.
my $igal2_slidenames = {{ slide_names_from_file | default(false) }};

# Omit film reel effect (true/false)
# Schema: no_filmreel
# Desc: Omit the film reel effect on the thumbnail index page.
my $igal2_no_filmreel = {{ no_filmreel | default(false) }};

# Omit image count in captions (true/false)
# Schema: no_count
# Desc: Omit the image count from the captions.
my $igal2_no_count = {{ no_count | default(false) }};

# Omit slides entirely, link to images (true/false)
# Schema: no_slides
# Desc: Omit image slides entirely. Clicking thumbnails goes to plain image files.
my $igal2_no_slides = {{ no_slides | default(false) }};

# Watermark image path
# Schema: watermark_path
# Desc: Path to a watermark image file to overlay on each image. Empty to disable.
my $igal2_watermark = "{{ watermark_path | default('') }}";

# Base URL prefix for images/slides if hosted separately
# Schema: url_prefix
# Desc: Base URL prefix for images/slides if index is hosted at a different location.
my $igal2_url_prefix = "{{ url_prefix | default('') }}";

# Internal convert/cjpeg options
# Schema: con_opts
# Desc: Command line options to pass to convert or cjpeg internally.
my $igal2_con_opts = "{{ con_opts | default('') }}";

# Extract and display EXIF data (true/false)
# Schema: show_exif
# Desc: Extract and display EXIF tags on image slides.
my $igal2_exif = {{ show_exif | default(false) }};

# Add links to subdirectories in index (true/false)
# Schema: add_subdir
# Desc: Add links to subdirectories found in the source directory into the index.
my $igal2_add_subdir = {{ add_subdir | default(false) }};

# Tile height for film reel effect
# Schema: tile_height
# Desc: Height in pixels of the tiled image for the film reel effect.
my $igal2_tile_height = {{ tile_height | default(21) }};

# Force regeneration of thumbnails/slides (true/false)
# Schema: force
# Desc: Force regeneration of thumbnails and slides even if they exist.
my $igal2_force = {{ force | default(false) }};

# Make all files world-readable (true/false)
# Schema: chmod_world
# Desc: Make all generated igal2 files world-readable.
my $igal2_chmod = {{ chmod_world | default(true) }};

# Generate captions file (true/false) - first pass creates .captions, second uses it
# Schema: caption_gen
# Desc: First run: generate .captions file. Second run: use .captions file.
my $igal2_caption_gen = {{ caption_gen | default(false) }};

# Preserve filenames as captions in .captions file generation (true/false)
# Schema: caption_preserve_name
# Desc: When generating .captions, preserve file names as initial captions.
my $igal2_caption_preserve_name = {{ caption_preserve_name | default(false) }};

# Run igal2
system("igal2",
    "-d", $igal2_source,
    defined($igal2_dest) && $igal2_dest ne '' ? ("--dest", $igal2_dest) : (),
    defined($igal2_index) && $igal2_index ne '' ? ("-i", $igal2_index) : (),
    $igal2_width > 0 ? ("-w", $igal2_width) : (),
    $igal2_height > 0 ? ("-y", $igal2_height) : (),
    $igal2_xy > 0 ? ("--xy", $igal2_xy) : (),
    $igal2_padding > 0 ? ("-p", $igal2_padding) : (),
    $igal2_pagination > 0 ? ("--pagination", $igal2_pagination) : (),
    $igal2_dims ? "-a" : (),
    $igal2_captions ? "-u" : (),
    $igal2_slidetitles ? "-k" : (),
    $igal2_slidenames ? "-n" : (),
    $igal2_no_filmreel ? "-r" : (),
    $igal2_no_count ? "-x" : (),
    $igal2_no_slides ? "-s" : (),
    defined($igal2_watermark) && $igal2_watermark ne '' ? ("-m", $igal2_watermark) : (),
    defined($igal2_url_prefix) && $igal2_url_prefix ne '' ? ("-o", $igal2_url_prefix) : (),
    defined($igal2_con_opts) && $igal2_con_opts ne '' ? ("--con", $igal2_con_opts) : (),
    $igal2_exif ? "-e" : (),
    $igal2_add_subdir ? "--AddSubdir" : (),
    $igal2_tile_height > 0 ? ("-t", $igal2_tile_height) : (),
    $igal2_force ? "-f" : (),
    $igal2_chmod ? "--www" : (),
    $igal2_caption_gen ? "-c" : (),
    $igal2_caption_preserve_name ? "-C" : ()
);