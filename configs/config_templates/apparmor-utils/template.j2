# Location of system policygroups
# Path to the system policygroups directory
# Default: /usr/share/apparmor/easyprof/policygroups
POLICYGROUPS_DIR="{{ POLICYGROUPS_DIR | default('/usr/share/apparmor/easyprof/policygroups') }}"

# Location of system templates
# Path to the system templates directory
# Default: /usr/share/apparmor/easyprof/templates
TEMPLATES_DIR="{{ TEMPLATES_DIR | default('/usr/share/apparmor/easyprof/templates') }}"
