# ARJ Configuration Template
# This template configures ARJ archive handling behaviors, including
# virus scanning commands and archive creation/extraction patterns
# for various archive formats (ARJ, ZIP, RAR, tar variants).

VIRUS {{ arj_virus_scan_command | default('/usr/bin/scan') }} /nomem /sub *

arj
 # Pattern for creating ARJ archives (command `arj a`)
 arj a -+ -y -a1 -r -j$ -s -jm -2s "{{ arj_archive_create_pattern | default('%s') }}"
 # Pattern for extracting ARJ archives (command `arj x`)
 arj x -y "{{ arj_archive_extract_pattern | default('%s') }}"
AD

zip
 # Pattern for creating ZIP archives
 zip -r "{{ zip_archive_create_pattern | default('%s') }}" . -i *
 # Pattern for extracting ZIP archives
 unzip "{{ zip_archive_extract_pattern | default('%s') }}"
AD

rar
 # Pattern for creating RAR archives
 rar a -r -y "{{ rar_archive_create_pattern | default('%s') }}"
 # Pattern for extracting RAR archives
 rar x -y "{{ rar_archive_extract_pattern | default('%s') }}"
AD

tar.Z
 # Pattern for creating tar.Z archives
 tar -cvZf "{{ tarZ_archive_create_pattern | default('%s') }}" .
 # Pattern for extracting tar.Z archives
 tar -xvZf "{{ tarZ_archive_extract_pattern | default('%s') }}"
ADT

tar.gz
 # Pattern for creating tar.gz archives
 tar -cvzf "{{ tarGZ_archive_create_pattern | default('%s') }}" .
 # Pattern for extracting tar.gz archives
 tar -xvzf "{{ tarGZ_archive_extract_pattern | default('%s') }}"
ADT

tgz
 # Pattern for creating tgz archives (same as tar.gz)
 tar -cvzf "{{ tgz_archive_create_pattern | default('%s') }}" .
 # Pattern for extracting tgz archives
 tar -xvzf "{{ tgz_archive_extract_pattern | default('%s') }}"
ADT

tar.bz2
 # Pattern for creating tar.bz2 archives
 tar --bzip2 -cvf "{{ tarBZ2_archive_create_pattern | default('%s') }}" .
 # Pattern for extracting tar.bz2 archives
 tar --bzip2 -xvf "{{ tarBZ2_archive_extract_pattern | default('%s') }}"
ADT
