# dictconv configuration template
# This tool converts dictionary files between formats (.bgl, .tei, .dct, .ifo, .index, .dic).
# It is designed for one-shot execution (CLI), so this template serves to document
# and validate the parameters passed to the command, ensuring all required fields
# are present with valid defaults before execution.

# Input file path: Source dictionary file (.bgl, .tei, .dct, .ifo).
# Required field. The tool must know where to read the source data.
# Default: .ifo
input_file: {{ input_file | default('.ifo', true) }}

# Output file path: Target dictionary file (.index, .dic, .ifo).
# Required field. The tool must know where to write the converted data.
# Default: .ifo
output_file: {{ output_file | default('.ifo', true) }}

# Help flag: If true, prints help message and exits immediately.
# Overrides other options. Corresponds to -h or -?.
# Default: False
{% if help is defined and help %}
# Action: Print help and exit (-h)
help_enabled: true
{% endif %}

# Version flag: If true, prints version information and exits immediately.
# Corresponds to -v.
# Default: False
{% if version is defined and version %}
# Action: Print version and exit (-v)
version_enabled: true
{% endif %}

# Summary of effective configuration
# input_file: {{ input_file | default('.ifo', true) }}
# output_file: {{ output_file | default('.ifo', true) }}
# help: {{ help | default(False, true) | ternary('enabled', 'disabled') }}
# version: {{ version | default(False, true) | ternary('enabled', 'disabled') }}