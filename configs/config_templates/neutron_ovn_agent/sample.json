{
  "log_dir": "/var/log/neutron",
  "log_file": "neutron-ovn-agent.log",
  "verbose": true,
  "debug": false,
  "ovs_bridge": "br-int",
  "integration_bridge": "br-int",
  "enable_tunneling": true,
  "tunnel_type": "geneve",
  "local_ip": "192.168.1.10",
  "vtep_udp_checksum": false,
  "vtep_flow_offload": false,
  "tunnel_mtu": 1450,
  "ovn_nb_db": "tcp:10.0.0.10:6641,tcp:10.0.0.11:6641",
  "ovn_sb_db": "tcp:10.0.0.10:6642,tcp:10.0.0.11:6642",
  "ovn_nb_db_timeout": 180,
  "ovn_sb_db_timeout": 180,
  "enable_chassis_as_edge": false,
  "enable_distributed_floating_ip": true,
  "enable_ha_for_floating_ips": false,
  "enable_snat": true,
  "snat_gateway_port": "",
  "enable_fip_nat": true,
  "max_l3_router_ports": 100,
  "max_floating_ips_per_router": 50,
  "enable_metadata": true,
  "tenant_network_type": "geneve",
  "metadata_proxy_secret": "mysecret",
  "metadata_network": "metadata",
  "ovn_l3_scheduler": "leastloaded",
  "enable_qos_ext_driver": true,
  "enable_sg_ext_driver": true,
  "audit_log": false,
  "polling_interval": 2,
  "ovsdb_connection_timeout": 10,
  "ovsdb_connection_max_retries": 3,
  "ovsdb_transaction_concurrency": 4,
  "min_workers": 2,
  "max_workers": 16,
  "enable_security_group": true,
  "log_security_group_events": false,
  "debug_security_group_events": false,
  "firewall_driver": "ovn",
  "enable_ipset": true,
  "enable_flood_rules": true,
  "enable_dhcp_options": true,
  "enable_dhcpv6_stateful": true,
  "enable_dhcpv6_stateless": false,
  "type_drivers": [
    "geneve",
    "vlan",
    "flat"
  ],
  "tenant_network_types": [
    "geneve"
  ],
  "mechanism_drivers": [
    "ovn"
  ],
  "extension_drivers": [
    "port_security",
    "qos",
    "security_group"
  ],
  "database_connection": "",
  "database_max_retries": 20,
  "database_retry_interval": 5
}
