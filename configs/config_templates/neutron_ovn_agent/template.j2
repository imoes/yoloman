[DEFAULT]
# Enables the OVN Neutron agent
enabled = True

# Logging configuration
log_dir = {{ log_dir }}
log_file = {{ log_file }}

# Verbosity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
verbose = {{ verbose }}
debug = {{ debug }}

[ovs]
# Open vSwitch integration bridge name
ovs_bridge = {{ ovs_bridge }}

# Enable integration bridge for local VM traffic
integration_bridge = {{ integration_bridge }}

# Enable tunneling (Geneve, VXLAN, or GRE)
enable_tunneling = {{ enable_tunneling }}

# Tunnel type to use (geneve, vxlan, gre)
tunnel_type = {{ tunnel_type }}

# Local IP for tunnel endpoint
local_ip = {{ local_ip }}

# Enable VXLAN UDP checksum
vtep_udp_checksum = {{ vtep_udp_checksum }}

# Enable VXLAN flow offload (if supported by hardware)
vtep_flow_offload = {{ vtep_flow_offload }}

# Maximum transmission unit for tunnel interfaces
tunnel_mtu = {{ tunnel_mtu }}

[ovn]
# Comma-separated list of OVN NB and SB OVSDB server addresses
ovn_nb_db = {{ ovn_nb_db }}
ovn_sb_db = {{ ovn_sb_db }}

# OVN timeout (seconds) for DB connections
ovn_nb_db_timeout = {{ ovn_nb_db_timeout }}
ovn_sb_db_timeout = {{ ovn_sb_db_timeout }}

# Enable L3 routing via OVN Northbound DB
enable_chassis_as_edge = {{ enable_chassis_as_edge }}

# Enable distributed routing (requires L3 agent disabled)
enable_distributed_floating_ip = {{ enable_distributed_floating_ip }}

# Enable L3 HA for floating IPs
enable_ha_for_floating_ips = {{ enable_ha_for_floating_ips }}

# Enable SNAT on chassis for floating IPs
enable_snat = {{ enable_snat }}

# Gateway chassis for SNAT
snat_gateway_port = {{ snat_gateway_port }}

# Enable NAT for floating IPs
enable_fip_nat = {{ enable_fip_nat }}

# Maximum number of L3 router gateway ports per chassis
max_l3_router_ports = {{ max_l3_router_ports }}

# Maximum number of router floating IPs per chassis
max_floating_ips_per_router = {{ max_floating_ips_per_router }}

# Enable metadata service (requires metadata agent disabled)
enable_metadata = {{ enable_metadata }}

# Metadata network ID to bind metadata proxy
tenant_network_type = {{ tenant_network_type }}

# Metadata secret (shared with Neutron server)
metadata_proxy_secret = {{ metadata_proxy_secret }}

# Metadata network name or ID for agent to bind
metadata_network = {{ metadata_network }}

# OVN L3 scheduler (leastloaded, mostloaded, random)
ovn_l3_scheduler = {{ ovn_l3_scheduler }}

# Enable OVN QoS extension driver
enable_qos_ext_driver = {{ enable_qos_ext_driver }}

# Enable security groups extension driver
enable_sg_ext_driver = {{ enable_sg_ext_driver }}

# Enable audit logging for OVN
audit_log = {{ audit_log }}

[agent]
# Polling interval (seconds) for OVSDB changes
polling_interval = {{ polling_interval }}

# Timeout (seconds) for OVSDB commands
ovsdb_connection_timeout = {{ ovsdb_connection_timeout }}

# Number of OVSDB reconnection attempts
ovsdb_connection_max_retries = {{ ovsdb_connection_max_retries }}

# Number of concurrent OVSDB transactions
ovsdb_transaction_concurrency = {{ ovsdb_transaction_concurrency }}

# Minimum number of workers for event processing
min_workers = {{ min_workers }}

# Maximum number of workers for event processing
max_workers = {{ max_workers }}

[securitygroup]
# Enable security groups (requires Neutron security groups enabled)
enable_security_group = {{ enable_security_group }}

# Enable security group logging
log_security_group_events = {{ log_security_group_events }}

# Enable debug logging for security group events
debug_security_group_events = {{ debug_security_group_events }}

# Enable iptables_hybrid (if using legacy iptables + OVS firewall driver)
firewall_driver = {{ firewall_driver }}

# Enable IPsets for efficient SG membership tracking
enable_ipset = {{ enable_ipset }}

# Enable iptables_flood protection (drop packets if too many rules)
enable_flood_rules = {{ enable_flood_rules }}

# Enable DHCP options injection (DHCP options via OVN)
enable_dhcp_options = {{ enable_dhcp_options }}

# Enable DHCPv6 stateful mode
enable_dhcpv6_stateful = {{ enable_dhcpv6_stateful }}

# Enable DHCPv6 stateless mode
enable_dhcpv6_stateless = {{ enable_dhcpv6_stateless }}

[ml2]
# Type drivers (e.g., vlan, flat, geneve, vxlan)
type_drivers = {{ type_drivers | join(', ') }}

# Tenant network types (subset of type_drivers)
tenant_network_types = {{ tenant_network_types | join(', ') }}

# Mechanism drivers
mechanism_drivers = {{ mechanism_drivers | join(', ') }}

# Extension drivers
extension_drivers = {{ extension_drivers | join(', ') }}

[database]
# OVN-specific database connection (if using separate backend)
connection = {{ database_connection }}
max_retries = {{ database_max_retries }}
retry_interval = {{ database_retry_interval }}
