# /etc/security/limits.conf
#
# Each line describes a limit for a user:
# <domain> <type> <item> <value>
#
# Where:
#   domain - user, group, @group, or wildcard (*)
#   type   - hard or soft
#   item   - core, data, fsize, memlock, nofile, msgqueue, nproc, stack, etc.
#   value  - an integer or 'unlimited'
#
# Example:
#   *         soft    nofile      65536
#   @audio    hard    rtprio      99
#
{% for entry in limits %}
# {{ entry.domain }} {{ entry.type }} {{ entry.item }} {{ entry.value }}
{{ entry.domain }}	{{ entry.type }}	{{ entry.item }}	{{ entry.value }}
{% endfor %}