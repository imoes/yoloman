# ikiwiki-hosting-web configuration template.
# This file is managed by Ansible. Do not edit manually.
# It configures parallel aggregation jobs and process priority for ikiwiki.

# === Parallel Aggregation Settings ===

# maxload: Maximum load average for parallel aggregation jobs.
# If the system load exceeds this value, ikiwiki will throttle parallel jobs.
# Default: 5
# Type: int
{% if maxload is defined %}
maxload={{ maxload | default(5) }}
{% else %}
maxload={{ 5 }}
{% endif %}

# maxjobs: Maximum number of parallel aggregation jobs.
# Controls the concurrency limit for build jobs.
# Default: 5
# Type: int
{% if maxjobs is defined %}
maxjobs={{ maxjobs | default(5) }}
{% else %}
maxjobs={{ 5 }}
{% endif %}

# === Process Priority Settings ===

# nice_command: Nice and ionice command string to lower process priority.
# Used to ensure ikiwiki builds do not starve other system processes.
# Default: 'nice -n 19 ionice -c 3'
# Type: string
{% if nice_command is defined %}
nice_command={{ nice_command | default('nice -n 19 ionice -c 3') }}
{% else %}
nice_command={{ 'nice -n 19 ionice -c 3' }}
{% endif %}