{
  "daemon_user": "ipp-usb",
  "daemon_group": "ipp-usb",
  "http_port": 0,
  "enable_https": false,
  "ssl_cert_file": "/etc/ipp-usb/cert.pem",
  "ssl_key_file": "/etc/ipp-usb/privkey.pem",
  "device_timeout": 45,
  "max_devices": 5,
  "log_level": "NOTICE",
  "debug_logging": false,
  "backend_paths": [
    "/usr/lib/ipp-usb",
    "/usr/libexec/ipp-usb"
  ],
  "unix_socket_path": "/run/ipp-usb/ipp-usb.sock",
  "allow_remote": false,
  "allowed_hosts": [
    "localhost",
    "127.0.0.1"
  ],
  "denied_hosts": [],
  "stable_names": true,
  "enable_bonjour": true,
  "bonjour_service_name": "IPPUSB Printer",
  "extra_backend_args": []
}
