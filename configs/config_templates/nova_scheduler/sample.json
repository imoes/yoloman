{
  "enabled": true,
  "log_level": "INFO",
  "log_file": "/var/log/nova/nova-scheduler.log",
  "host": "controller-01",
  "workers": 3,
  "host_state_cache_ttl": 600,
  "scheduler_default_filters": [
    {
      "name": "RetryFilter",
      "description": "Retry hosts that previously failed",
      "enabled": true
    },
    {
      "name": "AvailabilityZoneFilter",
      "description": "Filter based on availability zone",
      "enabled": true
    },
    {
      "name": "RamFilter",
      "description": "Filter based on available RAM",
      "enabled": true
    },
    {
      "name": "DiskFilter",
      "description": "Filter based on available disk space",
      "enabled": true
    },
    {
      "name": "CoreFilter",
      "description": "Filter based on available CPU cores",
      "enabled": true
    },
    {
      "name": "ImagePropertiesFilter",
      "description": "Filter based on image properties (e.g., architecture)",
      "enabled": true
    },
    {
      "name": "ServerGroupAffinityFilter",
      "description": "Respects server group affinity",
      "enabled": true
    },
    {
      "name": "ServerGroupAntiAffinityFilter",
      "description": "Respects server group anti-affinity",
      "enabled": true
    }
  ],
  "scheduler_weight_multiplier": [
    {
      "name": "AvailabilityZoneWeigher",
      "description": "Prefer hosts in the same zone",
      "multiplier": 2.0
    },
    {
      "name": "RamWeigher",
      "description": "Prefer hosts with more free RAM",
      "multiplier": 1.0
    },
    {
      "name": "DiskWeigher",
      "description": "Prefer hosts with more free disk",
      "multiplier": 1.0
    },
    {
      "name": "CoreWeigher",
      "description": "Prefer hosts with fewer used vCPUs",
      "multiplier": 1.0
    }
  ],
  "scheduler_manager": "nova.scheduler.manager.SchedulerManager",
  "scheduler_max_retries": 5,
  "scheduler_retry_delay": 3,
  "ram_allocation_ratio": 1.5,
  "cpu_allocation_ratio": 16.0,
  "disk_allocation_ratio": 1.0,
  "reserved_host_memory_mb": 1024,
  "reserved_host_disk_mb": 2048,
  "image_traits_filter_enabled": true,
  "aggregate_instance_limit_enabled": false,
  "numa_topology_filter_enabled": true,
  "trust_filter_enabled": true,
  "image_type_filter_enabled": true,
  "pci_passthrough_filter_enabled": true,
  "traits_filter_enabled": true,
  "availability_zone_filter_enabled": true,
  "io_weight_filter_enabled": false,
  "server_group_affinity_filter_enabled": true,
  "server_group_anti_affinity_filter_enabled": true,
  "zone_filter_enabled": false,
  "host_manager": "nova.scheduler.host_manager.HostManager",
  "scheduler_driver": "nova.scheduler.filter_scheduler.FilterScheduler",
  "use_cached_state": true,
  "scheduler_stats_driver": "nova.scheduler.stats.StatsDriver",
  "update_host_state_interval": 120,
  "scheduler_metrics_enabled": true,
  "scheduler_metrics_cache_path": "/var/lib/nova/scheduler_metrics"
}
