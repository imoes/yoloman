# Path: This directive maps a URL path to a filesystem directory for the PostfixAdmin web interface.
# The Alias directive tells Apache to serve content from the filesystem path when the URL path is requested.
# The alias_path (URL prefix) is required and defaults to '/postfixadmin' if not provided.
# The document_root (filesystem path) is required and defaults to '/usr/share/postfixadmin/public' if not provided.
Alias {{ postfixadmin_alias_url | default('/postfixadmin') }} {{ postfixadmin_document_root | default('/usr/share/postfixadmin/public') }}