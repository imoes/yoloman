# =============================================================================
# PostfixAdmin Configuration Fragment
# =============================================================================
# This block generates Apache Alias directives for the PostfixAdmin web interface.
# It is designed to be included in an Apache httpd.conf or site-available config.
# =============================================================================

# Alias <URL_PATH> <FILESYSTEM_PATH>
#
# Description: Maps a URL path to the filesystem location of the PostfixAdmin
#              public files.
# Variables:
#   postfixadmin_alias_url
#     - Default: '/postfixadmin'
#     - Desc: The URL path where PostfixAdmin is accessible.
#   postfixadmin_document_root
#     - Default: '/usr/share/postfixadmin/public'
#     - Desc: The filesystem path to the PostfixAdmin public directory.

# The Alias directive requires both the URL path and the document root to be defined.
# We use Jinja2 defaults to ensure the template renders valid syntax even if
# Ansible variables are not explicitly set.
Alias {{ (postfixadmin_alias_url | default('/postfixadmin')) | string }} {{ (postfixadmin_document_root | default('/usr/share/postfixadmin/public')) | string }}
