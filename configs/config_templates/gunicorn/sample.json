{
  "bind": "0.0.0.0:8000",
  "workers": 4,
  "worker_class": "sync",
  "worker_connections": 1000,
  "timeout": 30,
  "graceful_timeout": 30,
  "accesslog": "/var/log/gunicorn/access.log",
  "errorlog": "/var/log/gunicorn/error.log",
  "loglevel": "info",
  "daemon": false,
  "proc_name": "myapp_gunicorn",
  "pidfile": "/run/myapp-gunicorn.pid",
  "user": "www-data",
  "group": "www-data",
  "ssl_enabled": false,
  "ssl_keyfile": "",
  "ssl_certfile": "",
  "preload_app": false,
  "reload": false,
  "max_requests": 0,
  "max_requests_jitter": 0,
  "backlog": 2048,
  "keepalive": 2,
  "extra_config": {
    "capture_output": true,
    "enable_stdio_inheritance": true
  }
}
