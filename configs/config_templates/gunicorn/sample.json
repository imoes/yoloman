{
 "accesslog": "/var/log/gunicorn/access.log",
 "backlog": 2048,
 "bind": "0.0.0.0:8000",
 "daemon": false,
 "errorlog": "/var/log/gunicorn/error.log",
 "extra_config": {
  "capture_output": true,
  "enable_stdio_inheritance": true
 },
 "graceful_timeout": 30,
 "group": "www-data",
 "keepalive": 2,
 "loglevel": "info",
 "max_requests": 0,
 "max_requests_jitter": 0,
 "pidfile": "/run/myapp-gunicorn.pid",
 "preload_app": false,
 "proc_name": "myapp_gunicorn",
 "reload": false,
 "ssl_certfile": "",
 "ssl_enabled": false,
 "ssl_keyfile": "",
 "timeout": 30,
 "user": "www-data",
 "worker_class": "sync",
 "worker_connections": 1000,
 "workers": 4
}
