{
  "service_name": "arc-arex",
  "version": "6.15.0",
  "log_level": "INFO",
  "work_dir": "/var/lib/arc",
  "authz": "xacml",
  "arex": {
    "port": 8080,
    "host": "arc.example.org",
    "use_ssl": true,
    "max_workers": 16,
    "worker_timeout": 7200,
    "executor": "slurm",
    "job_root": "/var/spool/arc/jobs"
  },
  "storage": {
    "path": "/var/lib/arc/storage",
    "max_size": 21474836480,
    "ldap_url": "ldap://ldap.example.com:389",
    "ldap_basedn": "ou=users,dc=example,dc=com"
  },
  "services": [
    {
      "name": "arco",
      "enabled": true,
      "port": 8081,
      "use_ssl": true,
      "log_level": "DEBUG"
    },
    {
      "name": "arc-rest",
      "enabled": false,
      "port": 8082
    }
  ]
}
