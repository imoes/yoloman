# Open Infrastructure: compute-tools configuration

# Path to the container log file
# Default: /var/log/compute-tools/container.log
log_file_path = {{ log_file_path | default('/var/log/compute-tools/container.log') }}

# Number of rotated log files to keep
# Default: 12
log_rotate_count = {{ log_rotate_count | default(12) }}

# sudoers rule allowing the 'container' user to run /usr/bin/container without a password
# This is a static security policy and does not depend on the schema variables above.
container ALL=NOPASSWD: /usr/bin/container
