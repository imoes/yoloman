# ddupdate main configuration file
# Global settings
host: {{ host }}
plugin: {{ plugin }}
plugin_option: {{ plugin_option }}
user: {{ user }}
password: {{ password }}

# Network settings
# Listen address and port for internal web interface (if enabled)
interface: {{ interface }}
port: {{ port }}

# Logging
# Set log level: debug, info, warning, error, critical
log_level: {{ log_level }}
# Path to log file; empty string disables file logging
log_file: {{ log_file }}

# Daemon mode
# Run as a daemon (background service) or once (one-shot update)
foreground: {{ foreground }}

# Update interval in seconds (ignored in foreground mode)
interval: {{ interval }}

# TLS/SSL settings
# Enable TLS for web interface
use_tls: {{ use_tls }}
# Certificate file path
ssl_cert: {{ ssl_cert }}
# Private key file path
ssl_key: {{ ssl_key }}

# DNS cache
# Enable DNS caching for improved performance
cache_dns: {{ cache_dns }}
# TTL for DNS cache entries (seconds)
cache_ttl: {{ cache_ttl }}

# Webhook notifications (optional)
# List of webhook URLs to notify on status changes
{% for webhook in webhooks %}webhook: {{ webhook }}
{% endfor %}

# Plugin-specific configuration (key-value pairs passed directly to plugin)
{% for key, value in plugin_config %}{{ key }}: {{ value }}
{% endfor %}