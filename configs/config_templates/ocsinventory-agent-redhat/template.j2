# Rotate OCS Inventory NG agent logs daily, only if not empty.
# This block configures logrotate for OCS Inventory agent logs.
/var/log/ocsinventory-agent/*.log {
	# Number of days to keep old rotated logs. Defaults to 7.
	daily
	# Rotate directive specifies how many rotated logs to keep.
	# Defaults to 7 if rotate_days is not provided.
	rotate {{ rotate_days | default(7) | int }}
	compress
	notifempty
	missingok
}
