{
  "rcS_env_file": "/etc/default/rcS",
  "mount_points": [
    {
      "target": "/proc",
      "type": "proc"
    },
    {
      "target": "/sys",
      "type": "sysfs"
    },
    {
      "target": "/dev",
      "type": "devtmpfs"
    },
    {
      "target": "/run",
      "type": "tmpfs"
    }
  ],
  "hostname": "myhost",
  "system_clock": {
    "mode": "manual",
    "datetime": "2024-06-01 12:00:00"
  },
  "modules": [
    {
      "name": "e1000e",
      "options": "Debug=1"
    },
    {
      "name": "nvidia",
      "options": ""
    }
  ],
  "swap_enabled": true,
  "swap_devices": [
    "/swapfile"
  ],
  "fsck_force": false,
  "tmp_setup": {
    "mode": "clean"
  },
  "sysctl_params": [
    "kernel.sysrq = 1",
    "vm.swappiness = 60"
  ],
  "default_runlevel": "2",
  "s_scripts": [
    "hwclock.sh"
  ],
  "use_sysv_init": false
}
