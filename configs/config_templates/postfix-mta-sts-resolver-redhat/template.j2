# The hostname or IP address to bind the MTA-STS resolver service to.
host: {{ host | default('localhost') }}

# The TCP port the MTA-STS resolver service listens on.
port: {{ port | default('8461') }}

# Enable SO_REUSEPORT for the listener socket.
reuse_port: {{ reuse_port | default('True') }}

# Maximum seconds to wait for graceful shutdown.
shutdown_timeout: {{ shutdown_timeout | default('20') }}

# Cache configuration
cache:
  # Type of cache backend (sqlite for this resolver).
  type: sqlite
  options:
    # Path to the SQLite cache database file.
    filename: {{ cache_filename | default('/var/lib/mta-sts/cache.db') }}
