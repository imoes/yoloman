# PCP PMDA for Nginx configuration
# This configuration controls how the Performance Co-Pilot (PCP) Nginx PMDA
# retrieves status metrics from an Nginx web server instance.

# The URL for the Nginx stub_status module endpoint.
# Ensure the Nginx configuration has a location block exposing `stub_status`
# that points to this URL, e.g.:
#   location /nginx_status {
#       stub_status on;
#       allow 127.0.0.1;
#       deny all;
#   }
#$nginx_status_url = "{{ nginx_status_url | default('http://localhost/nginx_status') }}";

# Timeout in seconds for fetching the Nginx status page.
# This limits the time the PMDA waits for a response from the stub_status endpoint.
#$nginx_fetch_timeout = {{ nginx_fetch_timeout | default(1) }};
