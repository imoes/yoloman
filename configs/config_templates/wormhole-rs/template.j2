# wormhole-rs CLI configuration template
# Generated by Ansible; do not edit manually.
# This file drives the wormhole-rs binary via command-line flags.

# --relay <address>
# List of relay server addresses to use for data transfer.
# Specifying multiple allows failover or load balancing.
# Each relay is emitted on its own line as a separate CLI argument.
{% for relay in (relays | default(['tcp://relay1.wormhole.com:4001', 'tcp://relay2.wormhole.com:4001'])) %}
--relay {{ relay }}
{% endfor %}

# --rendezvous <url>
# The WebSocket URL of the rendezvous server used for handshake.
# Both peers must use the same value to discover each other.
--rendezvous {{ rendezvous_server | default('wss://wormhole2.ci2w.com') }}

# --force-direct
# Disable relay server support and force a direct connection between peers.
# When enabled, traffic bypasses relays entirely.
{% if force_direct | default(False) | bool %}
--force-direct
{% endif %}

# --force-relay
# Always route traffic over a relay server to hide IP addresses from peers.
# Overrides peer discovery of direct addresses.
{% if force_relay | default(False) | bool %}
--force-relay
{% endif %}

# --verbose
# Enable verbose logging to stdout for debugging purposes.
# Useful for troubleshooting connection issues.
{% if verbose | default(False) | bool %}
--verbose
{% endif %}