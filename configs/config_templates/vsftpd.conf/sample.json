{
  "anonymous_enable": false,
  "local_enable": true,
  "write_enable": true,
  "anon_upload_enable": false,
  "anon_root": "/var/ftp",
  "local_root": "$USER",
  "chroot_local_user": true,
  "chroot_list_file": "/etc/vsftpd/chroot_list",
  "chroot_list_enable": true,
  "pasv_enable": true,
  "pasv_min_port": 10090,
  "pasv_max_port": 10100,
  "listen": true,
  "listen_address": "",
  "listen_port": 21,
  "xferlog_enable": true,
  "xferlog_file": "/var/log/vsftpd/vsftpd.log",
  "xferlog_std_format": false,
  "log_file": "/var/log/vsftpd/vsftpd.log",
  "local_umask": "022",
  "anon_umask": "077",
  "virtual_user_config_dir": "/etc/vsftpd/virtual_users",
  "guest_enable": false,
  "guest_username": "virtual",
  "user_sub_token": "$USER",
  "pam_service_name": "vsftpd",
  "hide_ids": false,
  "user_config_dir": "/etc/vsftpd/user_conf",
  "virtual_users": {
    "jane_doe": {
      "local_root": "/data/jane",
      "write_enable": true
    },
    "bob_smith": {
      "local_root": "/data/bob",
      "write_enable": false
    }
  },
  "ssl_enable": true,
  "allow_ssl": false,
  "rsa_cert_file": "/etc/ssl/certs/vsftpd.crt",
  "rsa_private_key_file": "/etc/ssl/private/vsftpd.key",
  "ssl_protocols": "TLSv1.2 TLSv1.3",
  "ssl_ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "ssl_session_cache": "enabled",
  "require_ssl": true,
  "syslog_enable": false,
  "tcp_wrappers": false,
  "timeout": 300,
  "data_connection_timeout": 120,
  "max_clients": 50,
  "max_per_ip": 3,
  "anon_max_rate": 0,
  "local_max_rate": 0,
  "ftpd_banner": "Welcome to secure FTP server",
  "banner_file": "/etc/vsftpd/banner",
  "ascii_mode_upload": false,
  "ascii_mode_download": false,
  "utf8_filesystem": true,
  "listen_ipv6": false
}
