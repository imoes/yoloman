# libaudit.conf — Main configuration for the Linux audit daemon (auditd)
# Set the maximum size of log files before rotation
max_log_file = {{ max_log_file }}
# Number of log files to keep after rotation
num_logs = {{ num_logs }}
# Enable or disable audit logging
log_group = {{ log_group }}
# Enable or disable audit event logging to the kernel
log_level = {{ log_level }}
# Format of timestamps in audit logs (unix, epoch, iso, or iso-strict)
format = {{ format }}
# Enable or disable synchronous writing of audit logs
flush = {{ flush }}
# Frequency (in seconds) to flush buffers to disk (only if flush is incremental or none)
timeout = {{ timeout }}
# Action to take when disk space is low (ignore, syslog, suspend, or halt)
action_mail_acct = {{ action_mail_acct }}
# Path to the SMTP server for sending mail notifications
admin_msg = {{ admin_msg }}
# Path to the audit log directory
log_file = {{ log_file }}
# Enable or disable local logging (for standalone systems)
local = {{ local }}
# Enable or disable network logging (for remote collection)
remote = {{ remote }}
# Hostname or IP address of remote audit server (if remote = yes)
remote_server = {{ remote_server }}
# Port for remote audit server (if remote = yes)
remote_port = {{ remote_port }}
# Enable or disable support for legacy audit format
legacy = {{ legacy }}
# Enable or disable use of systemd journal for audit events
use_ayat = {{ use_ayat }}
{% for rule in extra_rules %}# Custom audit rule: {{ rule.comment }}
{{ rule.line }}
{% endfor %}