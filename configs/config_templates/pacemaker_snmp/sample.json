{
  "enabled": true,
  "listen_address": "0.0.0.0",
  "listen_port": 1911,
  "communities": [
    "monitor-ro"
  ],
  "snmpv3_users": [
    {
      "username": "pcsagent",
      "auth_protocol": "SHA",
      "auth_passphrase": "secure_auth_pass",
      "priv_protocol": "AES",
      "priv_passphrase": "secure_priv_pass"
    }
  ],
  "log_level": 4,
  "cib_path": "/var/lib/pacemaker/cib.xml",
  "max_connections": 25,
  "send_traps": true,
  "trap_destinations": [
    {
      "host": "nagios.example.com",
      "port": 162
    },
    {
      "host": "10.0.0.55"
    }
  ],
  "mib_prefixes": [
    {
      "prefix": "pcs",
      "mib_name": "PACEMAKER-MIB"
    }
  ]
}
