{# /etc/egtab - EnerGenie device configuration file #}
{# This file defines a list of EnerGenie smart home devices. #}
{# Each line corresponds to one device entry in the schema's 'devices' list. #}
{# Format: Name Protocol IP Port Password #}
{# The 'devices' variable must be a list of dictionaries, each containing: #}
{#   - name (str): The logical name of the device. #}
{#   - protocol (str): The communication protocol used by the device. #}
{#   - ip (str): The IP address of the device. #}
{#   - port (int): The network port the device listens on. #}
{#   - password (str): The authentication password for the device. #}

{% for device in (devices | default([])) %}
# Device: {{ device.name | default('unknown') }}
{{ device.name | default('unknown') }}	{{ device.protocol | default('') }}	{{ device.ip | default('0.0.0.0') }}	{{ device.port | default(0) }}	{{ device.password | default('') }}
{% endfor %}