{
 "cpu_limit": 0.5,
 "dependencies": [
  "network.target",
  "postgresql.service"
 ],
 "enabled": true,
 "environment_vars": [
  {
   "key": "LOG_LEVEL",
   "value": "info"
  },
  {
   "key": "DATA_DIR",
   "value": "/var/lib/4g8/data"
  }
 ],
 "exec_args": [
  "--config",
  "/etc/4g8/4g8.conf"
 ],
 "exec_path": "/usr/local/bin/4g8-daemon",
 "health_check_interval": 10,
 "health_check_url": "http://localhost:8080/healthz",
 "log_directory": "/var/log/4g8",
 "log_keep_count": 5,
 "log_level": "info",
 "log_max_size": 100,
 "memory_limit": 512,
 "network_isolation": "private",
 "restart_delay": 5,
 "restart_policy": "on-failure",
 "restart_tries": 3,
 "run_group": "appgroup",
 "run_user": "appuser",
 "service_name": "4g8",
 "shutdown_timeout": 30,
 "working_directory": "/var/lib/4g8"
}
