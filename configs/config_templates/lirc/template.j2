{# LIRC daemon configuration file - main daemon settings #}
# "lircd.conf" is the runtime configuration for lircd (LIRC daemon).
# It defines remote control devices, their codes, and optional driver parameters.
# This file is typically auto-generated by 'lirc-setup' or 'irexec' tools.
# Below is a template supporting dynamic configuration via Jinja2.

# --- General Daemon Options ---
{% if options.log_level is defined %}log_level = {{ options.log_level | int }}{% else %}# log_level = 0{% endif %}

{% if options.log is defined %}log = {{ options.log | to_json }}{% else %}# log = /var/log/lircd{% endif %}

{% if options.pidfile is defined %}pidfile = {{ options.pidfile }}{% else %}# pidfile = /run/lirc/lircd.pid{% endif %}

{% if options.nodaemon is defined %}nodaemon = {{ options.nodaemon | lower }}{% else %}# nodaemon = false{% endif %}

{% if options.dry_run is defined %}dry_run = {{ options.dry_run | lower }}{% else %}# dry_run = false{% endif %}

{% if options.release_threshold is defined %}release_threshold = {{ options.release_threshold | int }}{% else %}# release_threshold = 150{% endif %}

{% if options.repeat_threshold is defined %}repeat_threshold = {{ options.repeat_threshold | int }}{% else %}# repeat_threshold = 5{% endif %}

# --- Device Definitions ---
# Each device block configures a hardware IR receiver/transmitter.
{% for device in devices %}
# Device: {{ device.name | default('unnamed') }}
{% if device.driver %}driver = {{ device.driver }}{% endif %}
{% if device.device %}device = {{ device.device }}{% endif %}
{% if device.output %}output = {{ device.output }}{% endif %}
{% if device.rate %}rate = {{ device.rate | int }}{% endif %}
{% if device.send_mode is defined %}send_mode = {{ device.send_mode | lower }}{% else %}# send_mode = 0 (use default{% endif %}
{% if device.rc_key_map is defined %}rc_key_map = {{ device.rc_key_map }}{% endif %}
{% if device.send_protocol is defined %}send_protocol = {{ device.send_protocol | lower }}{% endif %}
{% if device.receive_protocol is defined %}receive_protocol = {{ device.receive_protocol | lower }}{% endif %}
{% if device.mode is defined %}mode = {{ device.mode }}{% endif %}
{% if device.ac97_device is defined %}ac97_device = {{ device.ac97_device }}{% endif %}
{% if device.freq is defined %}freq = {{ device.freq | int }}{% endif %}
{% if device.irq is defined %}irq = {{ device.irq | int }}{% endif %}
{% if device.ioport is defined %}ioport = {{ device.ioport | int }}{% endif %}
{% if device.gpio is defined %}gpio = {{ device.gpio | int }}{% endif %}
{% if device.gpio_tx is defined %}gpio_tx = {{ device.gpio_tx | int }}{% endif %}
{% if device.gpio_rx is defined %}gpio_rx = {{ device.gpio_rx | int }}{% endif %}
{% if device.speaker is defined %}speaker = {{ device.speaker | lower }}{% endif %}
{% if device.speaker_channel is defined %}speaker_channel = {{ device.speaker_channel }}{% endif %}
{% if device.input_device is defined %}input_device = {{ device.input_device }}{% endif %}
{% if device.creative_sblive is defined %}creative_sblive = {{ device.creative_sblive | lower }}{% endif %}
{% if device.creative_sblive_port is defined %}creative_sblive_port = {{ device.creative_sblive_port | int }}{% endif %}
{% if device.creative_sblive_irq is defined %}creative_sblive_irq = {{ device.creative_sblive_irq | int }}{% endif %}
{% if device.mtx0 is defined %}mtx0 = {{ device.mtx0 | lower }}{% endif %}
{% if device.mtx0_irport is defined %}mtx0_irport = {{ device.mtx0_irport | int }}{% endif %}
{% if device.mtx0_gpio is defined %}mtx0_gpio = {{ device.mtx0_gpio | int }}{% endif %}
{% if device.mtx0_input_device is defined %}mtx0_input_device = {{ device.mtx0_input_device }}{% endif %}
{% if device.pulseview is defined %}pulseview = {{ device.pulseview | lower }}{% endif %}
{% if device.pulseview_port is defined %}pulseview_port = {{ device.pulseview_port | int }}{% endif %}
{% if device.livedata is defined %}livedata = {{ device.livedata | lower }}{% endif %}
{% if device.livedata_port is defined %}livedata_port = {{ device.livedata_port | int }}{% endif %}
{% if device.livedata_device is defined %}livedata_device = {{ device.livedata_device }}{% endif %}
{% if device.parport is defined %}parport = {{ device.parport | int }}{% endif %}
{% if device.parport_xmit is defined %}parport_xmit = {{ device.parport_xmit | int }}{% endif %}
{% if device.parport_recv is defined %}parport_recv = {{ device.parport_recv | int }}{% endif %}
{% if device.led is defined %}led = {{ device.led | lower }}{% endif %}
{% if device.led_delay is defined %}led_delay = {{ device.led_delay | int }}{% endif %}
{% if device.led_pin is defined %}led_pin = {{ device.led_pin | int }}{% endif %}
{% if device.led_invert is defined %}led_invert = {{ device.led_invert | lower }}{% endif %}
{% if device.led_tx is defined %}led_tx = {{ device.led_tx | lower }}{% endif %}
{% if device.led_rx is defined %}led_rx = {{ device.led_rx | lower }}{% endif %}
{% if device.led_tx_pin is defined %}led_tx_pin = {{ device.led_tx_pin | int }}{% endif %}
{% if device.led_rx_pin is defined %}led_rx_pin = {{ device.led_rx_pin | int }}{% endif %}
{% if device.led_tx_invert is defined %}led_tx_invert = {{ device.led_tx_invert | lower }}{% endif %}
{% if device.led_rx_invert is defined %}led_rx_invert = {{ device.led_rx_invert | lower }}{% endif %}
{% if device.led_tx_delay is defined %}led_tx_delay = {{ device.led_tx_delay | int }}{% endif %}
{% if device.led_rx_delay is defined %}led_rx_delay = {{ device.led_rx_delay | int }}{% endif %}
{% if device.led_tx_mask is defined %}led_tx_mask = {{ device.led_tx_mask }}{% endif %}
{% if device.led_rx_mask is defined %}led_rx_mask = {{ device.led_rx_mask }}{% endif %}
{% if device.led_tx_value is defined %}led_tx_value = {{ device.led_tx_value | int }}{% endif %}
{% if device.led_rx_value is defined %}led_rx_value = {{ device.led_rx_value | int }}{% endif %}
{% if device.led_tx_delay is defined %}led_tx_delay = {{ device.led_tx_delay | int }}{% endif %}
{% if device.led_rx_delay is defined %}led_rx_delay = {{ device.led_rx_delay | int }}{% endif %}
{% if device.led_tx_mask is defined %}led_tx_mask = {{ device.led_tx_mask }}{% endif %}
{% if device.led_rx_mask is defined %}led_rx_mask = {{ device.led_rx_mask }}{% endif %}
{% if device.led_tx_value is defined %}led_tx_value = {{ device.led_tx_value | int }}{% endif %}
{% if device.led_rx_value is defined %}led_rx_value = {{ device.led_rx_value | int }}{% endif %}

{% endfor %}

# --- Remote Definitions (Key Maps) ---
# Each remote block defines a protocol and button codes.
# Use 'mode2', 'ir-ctl', or 'mode2' + 'irrecord' to generate the codes.
{% for remote in remotes %}
begin remote
  name  {{ remote.name }}
  {% if remote.driver %}driver {{ remote.driver }}{% endif %}
  {% if remote.device %}device {{ remote.device }}{% endif %}
  {% if remote.flags %}flags {{ remote.flags }}{% endif %}
  {% if remote.delay %}delay {{ remote.delay | int }}{% endif %}
  {% if remote.repeat %}repeat {{ remote.repeat | int }}{% endif %}
  {% if remote.rc_map_name %}rc_map_name {{ remote.rc_map_name }}{% endif %}
  {% if remote.rc_key_map %}rc_key_map {{ remote.rc_key_map }}{% endif %}
  {% if remote.rc_protocol %}rc_protocol {{ remote.rc_protocol }}{% endif %}
  {% if remote.rc_scancode %}rc_scancode {{ remote.rc_scancode }}{% endif %}
  {% if remote.rc_type %}rc_type {{ remote.rc_type | int }}{% endif %}
  {% if remote.rc_mask %}rc_mask {{ remote.rc_mask }}{% endif %}
  {% if remote.rc_space %}rc_space {{ remote.rc_space | lower }}{% endif %}
  {% if remote.rc_pulselength %}rc_pulselength {{ remote.rc_pulselength | int }}{% endif %}
  {% if remote.rc_min_repeat %}rc_min_repeat {{ remote.rc_min_repeat | int }}{% endif %}
  {% if remote.rc_min_length %}rc_min_length {{ remote.rc_min_length | int }}{% endif %}
  {% if remote.rc_max_length %}rc_max_length {{ remote.rc_max_length | int }}{% endif %}
  {% if remote.rc_freq %}rc_freq {{ remote.rc_freq | int }}{% endif %}
  {% if remote.rc_tolerance %}rc_tolerance {{ remote.rc_tolerance | int }}{% endif %}
  {% if remote.rc_vendor_id %}rc_vendor_id {{ remote.rc_vendor_id }}{% endif %}
  {% if remote.rc_product_id %}rc_product_id {{ remote.rc_product_id }}{% endif %}
  {% if remote.rc_version %}rc_version {{ remote.rc_version | int }}{% endif %}
  {% if remote.rc_device %}rc_device {{ remote.rc_device }}{% endif %}
  {% if remote.rc_input %}rc_input {{ remote.rc_input }}{% endif %}
  {% if remote.rc_input_type %}rc_input_type {{ remote.rc_input_type }}{% endif %}
  {% if remote.rc_input_code %}rc_input_code {{ remote.rc_input_code | int }}{% endif %}
  {% if remote.rc_input_device %}rc_input_device {{ remote.rc_input_device }}{% endif %}
  {% if remote.rc_input_device_type %}rc_input_device_type {{ remote.rc_input_device_type }}{% endif %}
  {% if remote.rc_input_device_code %}rc_input_device_code {{ remote.rc_input_device_code | int }}{% endif %}
  {% if remote.rc_input_device_name %}rc_input_device_name {{ remote.rc_input_device_name }}{% endif %}

  begin codes
{% for code in remote.codes %}    {{ code.name | upper | replace(' ', '_') }} {{ code.scancode }}
{% endfor %}  end codes
end remote

{% endfor %}
