{
  "options": {
    "log_level": 0,
    "log": "/var/log/lircd",
    "pidfile": "/run/lirc/lircd.pid",
    "nodaemon": false,
    "dry_run": false,
    "release_threshold": 150,
    "repeat_threshold": 5
  },
  "devices": [
    {
      "name": "gpio-ir",
      "driver": "gpio",
      "device": "/dev/lirc0",
      "gpio": 18,
      "gpio_tx": 17,
      "freq": 38000,
      "led": true,
      "led_pin": 21,
      "led_invert": true
    }
  ],
  "remotes": [
    {
      "name": "Apple_Remote",
      "rc_protocol": "nec",
      "rc_type": 1,
      "codes": [
        {
          "name": "MENU",
          "scancode": "0x0000000000001001"
        },
        {
          "name": "PLAY",
          "scancode": "0x0000000000001002"
        },
        {
          "name": "VOL_UP",
          "scancode": "0x0000000000001003"
        },
        {
          "name": "VOL_DOWN",
          "scancode": "0x0000000000001004"
        }
      ]
    },
    {
      "name": "Logitech_RC",
      "rc_protocol": "rc-5",
      "rc_type": 0,
      "codes": [
        {
          "name": "POWER",
          "scancode": "0x000000001f000001"
        },
        {
          "name": "MUTE",
          "scancode": "0x000000001f000002"
        }
      ]
    }
  ]
}
