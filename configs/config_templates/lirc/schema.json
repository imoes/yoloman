{
  "options": {
    "type": "object",
    "default": {},
    "description": "Global daemon options for lircd (e.g., logging, mode flags).",
    "properties": {
      "log_level": {
        "type": "number",
        "default": 0,
        "description": "Debug log level: 0 = silent, 1\u20139 = increasing verbosity."
      },
      "log": {
        "type": "string",
        "default": "/var/log/lircd",
        "description": "Path to log file. Use '-' for stdout. Ignored if nodaemon=true."
      },
      "pidfile": {
        "type": "string",
        "default": "/run/lirc/lircd.pid",
        "description": "Path to PID file. Ensure parent directory exists and is writable."
      },
      "nodaemon": {
        "type": "boolean",
        "default": false,
        "description": "Run lircd in foreground (no forking). Useful for debugging or containerized deployments."
      },
      "dry_run": {
        "type": "boolean",
        "default": false,
        "description": "Parse config and exit without starting daemon. Validates configuration syntax."
      },
      "release_threshold": {
        "type": "number",
        "default": 150,
        "description": "Minimum time (in microseconds) between successive key release events."
      },
      "repeat_threshold": {
        "type": "number",
        "default": 5,
        "description": "Number of repeated codes before auto-repeat triggers (0 = disable auto-repeat)."
      }
    }
  },
  "devices": {
    "type": "list",
    "default": [],
    "description": "List of hardware IR devices (e.g., serial, USB, GPIO, parport). At least one device block is required.",
    "items": {
      "type": "object",
      "description": "Configuration for a single IR receiver/transmitter device.",
      "properties": {
        "name": {
          "type": "string",
          "default": "",
          "description": "Logical name for the device (used in logs, keymap references)."
        },
        "driver": {
          "type": "string",
          "default": "",
          "description": "Driver name: 'default', 'devinput', 'uinput', 'serial', 'pins', 'gpio', 'livedata', 'pulseview', 'parport', 'creative', 'creative_sblive', 'mtx0', 'ac97', etc."
        },
        "device": {
          "type": "string",
          "default": "",
          "description": "Device node path (e.g., /dev/lirc0, /dev/input/eventX, /dev/ttyS0)."
        },
        "output": {
          "type": "string",
          "default": "",
          "description": "Output device path for IR transmission (e.g., /dev/lircd0)."
        },
        "rate": {
          "type": "number",
          "default": 38000,
          "description": "IR carrier frequency in Hz (common: 36000, 38000, 40000, 56000)."
        },
        "send_mode": {
          "type": "number",
          "default": 0,
          "description": "Send mode bitmask: 0 = default, 1 = NEC, 2 = Sony, 4 = RC-5, etc. Use only if needed."
        },
        "rc_key_map": {
          "type": "string",
          "default": "",
          "description": "Path to a precompiled keymap file (.lircd.conf or .rc_keymap)."
        },
        "send_protocol": {
          "type": "string",
          "default": "",
          "description": "Protocol to use when sending (e.g., 'nec', 'sony', 'rc-5', 'rc-6', 'jvc', 'samsung', 'raw')."
        },
        "receive_protocol": {
          "type": "string",
          "default": "",
          "description": "Protocol to expect on receive (e.g., 'nec', 'sony', 'rc-5', 'rc-6', 'jvc', 'samsung', 'raw')."
        },
        "mode": {
          "type": "string",
          "default": "",
          "description": "Legacy compatibility mode: 'lirc', 'devinput', 'uinput'."
        },
        "freq": {
          "type": "number",
          "default": 38000,
          "description": "Carrier frequency in Hz (alias for 'rate')."
        },
        "irq": {
          "type": "number",
          "default": 0,
          "description": "Interrupt line (for legacy serial/parport)."
        },
        "ioport": {
          "type": "number",
          "default": 0,
          "description": "I/O port address (for legacy serial/parport)."
        },
        "gpio": {
          "type": "number",
          "default": 0,
          "description": "GPIO pin number for IR input (e.g., 18 for Raspberry Pi)."
        },
        "gpio_tx": {
          "type": "number",
          "default": 0,
          "description": "GPIO pin for IR transmission (if separate from receive)."
        },
        "gpio_rx": {
          "type": "number",
          "default": 0,
          "description": "GPIO pin for IR reception (alias for 'gpio')."
        },
        "input_device": {
          "type": "string",
          "default": "",
          "description": "Input device path (e.g., /dev/input/by-id/usb-*), used with 'devinput' driver."
        },
        "ac97_device": {
          "type": "string",
          "default": "",
          "description": "AC97 device name (e.g., '0', '1') for 'ac97' driver."
        },
        "creative_sblive": {
          "type": "boolean",
          "default": false,
          "description": "Enable Creative SBLive! IR support."
        },
        "creative_sblive_port": {
          "type": "number",
          "default": 0,
          "description": "I/O port for Creative SBLive! IR (e.g., 0x220)."
        },
        "creative_sblive_irq": {
          "type": "number",
          "default": 0,
          "description": "IRQ for Creative SBLive! IR."
        },
        "mtx0": {
          "type": "boolean",
          "default": false,
          "description": "Enable Mtx0 (Matrix 0) driver for specific DVB cards."
        },
        "mtx0_irport": {
          "type": "number",
          "default": 0,
          "description": "IR port address for Mtx0."
        },
        "mtx0_gpio": {
          "type": "number",
          "default": 0,
          "description": "GPIO pin for Mtx0 IR."
        },
        "mtx0_input_device": {
          "type": "string",
          "default": "",
          "description": "Input device path for Mtx0."
        },
        "pulseview": {
          "type": "boolean",
          "default": false,
          "description": "Enable PulseView protocol analyzer support."
        },
        "pulseview_port": {
          "type": "number",
          "default": 0,
          "description": "Port number for PulseView server (default: 2870)."
        },
        "livedata": {
          "type": "boolean",
          "default": false,
          "description": "Enable live data TCP stream (for remote debugging/analysis)."
        },
        "livedata_port": {
          "type": "number",
          "default": 8765,
          "description": "Port for live data stream."
        },
        "livedata_device": {
          "type": "string",
          "default": "",
          "description": "Lirc device to stream (e.g., '/dev/lirc0')."
        },
        "parport": {
          "type": "number",
          "default": 0,
          "description": "Parport number (e.g., 0 for /dev/parport0)."
        },
        "parport_xmit": {
          "type": "number",
          "default": 0,
          "description": "Parport pin for transmit (e.g., 17 for strobe)."
        },
        "parport_recv": {
          "type": "number",
          "default": 0,
          "description": "Parport pin for receive (e.g., 11 for busy)."
        },
        "led": {
          "type": "boolean",
          "default": false,
          "description": "Enable LED activity indicator (if hardware supports)."
        },
        "led_delay": {
          "type": "number",
          "default": 200,
          "description": "LED blink delay (ms)."
        },
        "led_pin": {
          "type": "number",
          "default": 0,
          "description": "GPIO pin for LED control."
        },
        "led_invert": {
          "type": "boolean",
          "default": false,
          "description": "Invert LED logic (active-low)."
        },
        "led_tx": {
          "type": "boolean",
          "default": false,
          "description": "LED flashes on IR transmit."
        },
        "led_rx": {
          "type": "boolean",
          "default": false,
          "description": "LED flashes on IR receive."
        },
        "led_tx_pin": {
          "type": "number",
          "default": 0,
          "description": "GPIO pin for transmit LED."
        },
        "led_rx_pin": {
          "type": "number",
          "default": 0,
          "description": "GPIO pin for receive LED."
        },
        "led_tx_invert": {
          "type": "boolean",
          "default": false,
          "description": "Invert transmit LED logic."
        },
        "led_rx_invert": {
          "type": "boolean",
          "default": false,
          "description": "Invert receive LED logic."
        },
        "led_tx_delay": {
          "type": "number",
          "default": 0,
          "description": "Transmit LED delay (ms)."
        },
        "led_rx_delay": {
          "type": "number",
          "default": 0,
          "description": "Receive LED delay (ms)."
        },
        "led_tx_mask": {
          "type": "string",
          "default": "",
          "description": "LED mask for transmit (hex, e.g., '0x01')."
        },
        "led_rx_mask": {
          "type": "string",
          "default": "",
          "description": "LED mask for receive (hex)."
        },
        "led_tx_value": {
          "type": "number",
          "default": 0,
          "description": "LED value for transmit (0/1)."
        },
        "led_rx_value": {
          "type": "number",
          "default": 0,
          "description": "LED value for receive (0/1)."
        }
      }
    }
  },
  "remotes": {
    "type": "list",
    "default": [],
    "description": "List of IR remote control definitions (keymaps). Required for button recognition.",
    "items": {
      "type": "object",
      "description": "Configuration for a specific remote control model (e.g., 'Apple', 'Logitech').",
      "properties": {
        "name": {
          "type": "string",
          "default": "",
          "description": "Remote name (matches name in lircd.conf or auto-generated keymaps)."
        },
        "driver": {
          "type": "string",
          "default": "",
          "description": "Driver name (optional; if omitted, inherits from device)."
        },
        "device": {
          "type": "string",
          "default": "",
          "description": "Device node (optional; inherits from device)."
        },
        "flags": {
          "type": "string",
          "default": "",
          "description": "Flags: 'MODE2', 'RAW', 'SPACE_FIRST', 'CONST_LENGTH', etc."
        },
        "delay": {
          "type": "number",
          "default": 0,
          "description": "Delay before sending (\u00b5s)."
        },
        "repeat": {
          "type": "number",
          "default": 0,
          "description": "Repeat delay (\u00b5s)."
        },
        "rc_map_name": {
          "type": "string",
          "default": "",
          "description": "Name of the keymap file (e.g., 'rc-rc6-mce')."
        },
        "rc_key_map": {
          "type": "string",
          "default": "",
          "description": "Path to compiled keymap (e.g., '/lib/udev/rc_keymaps/rc-rc6-mce')."
        },
        "rc_protocol": {
          "type": "string",
          "default": "",
          "description": "Protocol name: 'nec', 'sony', 'rc-5', 'rc-6', 'jvc', 'samsung', 'raw'."
        },
        "rc_scancode": {
          "type": "string",
          "default": "",
          "description": "Default scancode mask (e.g., '0xf00ff')."
        },
        "rc_type": {
          "type": "number",
          "default": 0,
          "description": "RC type index (0\u201331)."
        },
        "rc_mask": {
          "type": "string",
          "default": "",
          "description": "Bit mask to apply before scancode comparison."
        },
        "rc_space": {
          "type": "boolean",
          "default": false,
          "description": "Use space-based (not pulse) timing for raw mode."
        },
        "rc_pulselength": {
          "type": "number",
          "default": 0,
          "description": "Pulse length in \u00b5s for raw mode."
        },
        "rc_min_repeat": {
          "type": "number",
          "default": 0,
          "description": "Minimum repeat count before key repeat triggers."
        },
        "rc_min_length": {
          "type": "number",
          "default": 0,
          "description": "Minimum packet length (bits) to accept."
        },
        "rc_max_length": {
          "type": "number",
          "default": 0,
          "description": "Maximum packet length (bits) to accept."
        },
        "rc_freq": {
          "type": "number",
          "default": 38000,
          "description": "Expected carrier frequency (Hz) for raw mode."
        },
        "rc_tolerance": {
          "type": "number",
          "default": 50,
          "description": "Timing tolerance in percent (0\u2013100)."
        },
        "rc_vendor_id": {
          "type": "string",
          "default": "",
          "description": "USB vendor ID (e.g., '0x046d' for Logitech)."
        },
        "rc_product_id": {
          "type": "string",
          "default": "",
          "description": "USB product ID."
        },
        "rc_version": {
          "type": "number",
          "default": 0,
          "description": "IR receiver firmware version."
        },
        "rc_device": {
          "type": "string",
          "default": "",
          "description": "Device path for input subsystem (e.g., '/dev/input/event0')."
        },
        "rc_input": {
          "type": "string",
          "default": "",
          "description": "Input device logical name."
        },
        "rc_input_type": {
          "type": "string",
          "default": "",
          "description": "Input device type: 'keyboard', 'mouse', 'joystick'."
        },
        "rc_input_code": {
          "type": "number",
          "default": 0,
          "description": "Input subsystem scan code (e.g., '0x10000001')."
        },
        "rc_input_device": {
          "type": "string",
          "default": "",
          "description": "Input device path."
        },
        "rc_input_device_type": {
          "type": "string",
          "default": "",
          "description": "Device type (e.g., 'keyboard')."
        },
        "rc_input_device_code": {
          "type": "number",
          "default": 0,
          "description": "Device-specific scan code."
        },
        "rc_input_device_name": {
          "type": "string",
          "default": "",
          "description": "Input device name (e.g., 'Logitech USB Receiver')."
        },
        "codes": {
          "type": "list",
          "default": [],
          "description": "List of button codes for this remote.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "default": "",
                "description": "Button name (e.g., 'KEY_UP', 'KEY_POWER')."
              },
              "scancode": {
                "type": "string",
                "default": "",
                "description": "Hexadecimal scancode (e.g., '0x0000000000001001')."
              }
            }
          }
        }
      }
    }
  }
}
