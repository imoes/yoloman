{
  "httpd": {
    "listen": "127.0.0.1",
    "port": 8080,
    "servername": "caldav.example.com",
    "ssl": true,
    "cert_file": "/etc/ssl/certs/example.crt",
    "key_file": "/etc/ssl/private/example.key",
    "ca_file": "/etc/ssl/certs/ca-bundle.crt"
  },
  "dav": {
    "dbdir": "/var/lib/cyrus/dav",
    "migrate": false,
    "timeout": 300,
    "maxreqsize": 20971520,
    "debug": 1,
    "enabled": true,
    "default_timezone": "America/New_York",
    "user_namespace": true,
    "shared_enabled": true,
    "alarms_enabled": true,
    "max_user_data_size": 104857600,
    "vcard_version": "3.0",
    "implicit_scheduling": true
  },
  "sasl": {
    "saslauthd_path": "/var/run/saslauthd/mux",
    "mech_list": [
      "PLAIN",
      "LOGIN"
    ]
  }
}
