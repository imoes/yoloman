#!/bin/bash
# ==============================================================================
# nsdiff Configuration & Execution Script
# ==============================================================================
# This script configures and executes 'nsdiff' to compare DNS zones and
# automatically generate/execute DNS updates via 'nsupdate'.
#
# Generated by Ansible Jinja2 template.
# Self-documented: read the comments above each variable and logic block.
# ==============================================================================

# ------------------------------------------------------------------------------
# Zone Definition
# ------------------------------------------------------------------------------

# The name of the DNS zone being managed.
ZONE_NAME="{{ zone_name | default('example.com') }}"

# The path to the local DNS zone file to be updated/checked.
ZONE_FILE="{{ zone_file | default('/var/named/example.com.zone') }}"

# ------------------------------------------------------------------------------
# dig Query Options (for fetching the old/new zone contents)
# ------------------------------------------------------------------------------

# Source address for dig queries (-b option).
# Leave empty to let the OS pick the default source address.
BINDIG_SOURCE_ADDRESS="{{ bindig_source_address | default('') }}"

# TSIG key file for dig queries (-k option).
# Path to a file containing the TSIG key used to authenticate dig requests.
BINDIG_KEYFILE="{{ bindig_keyfile | default('') }}"

# Literal TSIG key for dig queries (-y option).
# Format: [hmac:]name:key. Used directly if keyfile is not specified.
BINDIG_TSIG_KEY="{{ bindig_tsig_key | default('') }}"

# Server to transfer the old zone from (-s option).
# IP or hostname. Used as the source of the "current" zone state.
BINDIG_OLD_SERVER="{{ bindig_old_server | default('') }}"

# Server to transfer the new zone from (-m option).
# IP or hostname. Used as the source of the "target" zone state.
BINDIG_NEW_SERVER="{{ bindig_new_server | default('') }}"

# ------------------------------------------------------------------------------
# nsupdate Execution Options
# ------------------------------------------------------------------------------

# TSIG key for nsupdate, passed as -y option.
# Format: [hmac:]name:key. Authenticates the update messages.
NSUPDATE_TSIG_KEY="{{ nsupdate_tsig_key | default('') }}"

# Server to send nsupdate to, passed as argument to nsupdate.
# The authoritative server that will apply the generated changes.
NSUPDATE_SERVER="{{ nsupdate_server | default('') }}"

# SOA serial number update mode (-S option).
# Controls how the SOA serial is incremented or set during updates.
# Options: file, date, serial, unix, or a specific number.
SOA_SERIAL_MODE="{{ soa_serial_mode | default('file') }}"

# Verbosity flags for nsupdate (-v option).
# Controls output detail. Examples: 'q' for query responses, 'r' for full.
VERBOSITY="{{ verbosity | default('') }}"

# ------------------------------------------------------------------------------
# nsdiff Behavior Flags
# ------------------------------------------------------------------------------

# Allow very large updates to be split across multiple request packets (-0 option).
# Default: False
SPLIT_LARGE_UPDATES={{ split_large_updates | default(false) | lower }}

# Abort if update does not fit in one request packet (-1 option).
# Useful for strict MTU environments. Default: False
ABORT_ON_PACKET_OVERFLOW={{ abort_on_packet_overflow | default(false) | lower }}

# Do not ignore CDS/CDNSKEY records when comparing (-C option).
# Ensures DNSSEC delegation signer records are included in the diff.
# Default: False
MANAGE_CDS_CDNSKEY={{ manage_cds_cdnskey | default(false) | lower }}

# Compare records case-insensitively (-c option).
# Prevents false positives due to case differences in hostnames.
# Default: False
CASE_INSENSITIVE_COMPARE={{ case_insensitive_compare | default(false) | lower }}

# Do not ignore DNSKEY records when comparing (-D option).
# Ensures DNSSEC key records are included in the diff.
# Default: False
MANAGE_DNSKEY={{ manage_dnskey | default(false) | lower }}

# Ignore DS records when comparing (-d option).
# DS records are often managed by the registry, not this server.
# Default: True
IGNORE_DS_RECORDS={{ ignore_ds_records | default(true) | lower }}

# Regex to ignore additional DNS records (-i option).
# Useful for ignoring dynamic or transient records.
IGNORE_REGEX="{{ ignore_regex | default('') }}"

# Quiet mode, suppress output unless zones differ (-q option).
# Reduces log noise when zones are identical.
# Default: False
QUIET_MODE={{ quiet_mode | default(false) | lower }}

# Tell nsupdate to send to the server specified by -s option (-u option).
# Overrides the standard -s behavior for nsupdate if set.
# Default: False
NSUPDATE_USE_S_SERVER={{ nsupdate_use_s_server | default(false) | lower }}

# ------------------------------------------------------------------------------
# Command Construction
# ------------------------------------------------------------------------------

# Build the nsdiff command string incrementally.
cmd="nsdiff"

# Append source address if configured
if [ -n "${BINDIG_SOURCE_ADDRESS}" ]; then
  cmd="${cmd} -b ${BINDIG_SOURCE_ADDRESS}"
fi

# Append TSIG key file if configured
if [ -n "${BINDIG_KEYFILE}" ]; then
  cmd="${cmd} -k ${BINDIG_KEYFILE}"
fi

# Append literal TSIG key if configured
if [ -n "${BINDIG_TSIG_KEY}" ]; then
  cmd="${cmd} -y ${BINDIG_TSIG_KEY}"
fi

# Append old zone server if configured
if [ -n "${BINDIG_OLD_SERVER}" ]; then
  cmd="${cmd} -s ${BINDIG_OLD_SERVER}"
fi

# Append new zone server if configured
if [ -n "${BINDIG_NEW_SERVER}" ]; then
  cmd="${cmd} -m ${BINDIG_NEW_SERVER}"
fi

# Append flags for large updates
{% if split_large_updates | default(false) %}
cmd="${cmd} -0"
{% endif %}

# Append flag to abort on packet overflow
{% if abort_on_packet_overflow | default(false) %}
cmd="${cmd} -1"
{% endif %}

# Append flag to manage CDS/CDNSKEY
{% if manage_cds_cdnskey | default(false) %}
cmd="${cmd} -C"
{% endif %}

# Append flag for case-insensitive comparison
{% if case_insensitive_compare | default(false) %}
cmd="${cmd} -c"
{% endif %}

# Append flag to manage DNSKEY
{% if manage_dnskey | default(false) %}
cmd="${cmd} -D"
{% endif %}

# Append flag to ignore DS records (usually always on)
{% if ignore_ds_records | default(true) %}
cmd="${cmd} -d"
{% endif %}

# Append regex to ignore records if provided
if [ -n "${IGNORE_REGEX}" ]; then
  cmd="${cmd} -i '${IGNORE_REGEX}'"
fi

# Append SOA serial mode
cmd="${cmd} -S ${SOA_SERIAL_MODE}"

# Append quiet mode if enabled
{% if quiet_mode | default(false) %}
cmd="${cmd} -q"
{% endif %}

# Append nsupdate -s override if enabled
{% if nsupdate_use_s_server | default(false) %}
cmd="${cmd} -u"
{% endif %}

# Append verbosity if configured
if [ -n "${VERBOSITY}" ]; then
  cmd="${cmd} -v '${VERBOSITY}'"
fi

# ------------------------------------------------------------------------------
# Execution
# ------------------------------------------------------------------------------

# Execute nsdiff, piping the result to nsupdate.
# The nsupdate command receives the TSIG key and target server arguments.
echo "${cmd} ${ZONE_FILE}" | nsupdate ${NSUPDATE_TSIG_KEY} ${NSUPDATE_SERVER}