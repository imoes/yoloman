{
  "treeid": {
    "type": "string",
    "default": "",
    "description": "Unique identifier for the build tree"
  },
  "version": {
    "type": "string",
    "default": "0",
    "description": "Version number of the OS"
  },
  "releasever": {
    "type": "string",
    "default": "0",
    "description": "Release version string"
  },
  "distroverpkg": {
    "type": "string",
    "default": "redhat-release",
    "description": "Package name that provides the distribution version"
  },
  "arch": {
    "type": "string",
    "default": "x86_64",
    "description": "Target architecture"
  },
  "product": {
    "type": "string",
    "default": "Red Hat Enterprise Linux",
    "description": "Product name"
  },
  "product_short": {
    "type": "string",
    "default": "RHEL",
    "description": "Short product name"
  },
  "product_name": {
    "type": "string",
    "default": "RHEL",
    "description": "Product name used in compose metadata"
  },
  "variant": {
    "type": "string",
    "default": "Server",
    "description": "Variant of the installation"
  },
  "variant_label": {
    "type": "string",
    "default": "Server",
    "description": "Label for the variant"
  },
  "variant_name": {
    "type": "string",
    "default": "Server",
    "description": "Human-readable name of the variant"
  },
  "timestamp": {
    "type": "string",
    "default": "",
    "description": "Timestamp of the build"
  },
  "targetdir": {
    "type": "string",
    "default": "/tmp/installtree",
    "description": "Target directory for the output tree"
  },
  "templatedir": {
    "type": "string",
    "default": "/usr/share/lorax",
    "description": "Directory containing templates"
  },
  "rootfs_type": {
    "type": "string",
    "default": "ext4",
    "description": "Filesystem type for the root partition"
  },
  "rootfs_opts": {
    "type": "string",
    "default": "",
    "description": "Additional options for root filesystem creation"
  }
}
