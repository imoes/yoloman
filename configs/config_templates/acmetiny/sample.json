{
  "account_key_path": "/etc/acme-tiny/account.key",
  "domain_csr_path": "/etc/acme-tiny/domain.csr",
  "acme_directory_url": "https://acme-v02.api.letsencrypt.org/directory",
  "challenge_path": "/var/www/.well-known/acme-challenge",
  "webroot_path": "/var/www",
  "renew_before_days": 30,
  "challenge_retries": 3,
  "challenge_retry_delay": 5,
  "post_hook_cmd": "systemctl reload nginx",
  "domains": [
    {
      "name": "example.com",
      "alt_names": [
        "www.example.com",
        "mail.example.com"
      ]
    },
    {
      "name": "api.example.com",
      "alt_names": []
    }
  ]
}
