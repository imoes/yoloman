{
  "root_dir": "/var/log",
  "max_depth": 3,
  "list_dirs_only": false,
  "follow_symlinks": false,
  "print_full_paths": true,
  "stay_on_filesystem": false,
  "include_patterns": [
    "*.log",
    "syslog*"
  ],
  "exclude_patterns": [
    "tmp",
    "cache"
  ],
  "use_gitignore": false,
  "ignore_case": false,
  "match_dirs": false,
  "prune_empty": false,
  "print_info_comments": false,
  "omit_report": false,
  "charset": "UTF-8",
  "file_limit": 1000,
  "time_fmt": "%Y-%m-%d",
  "output_file": "",
  "question_marks": false,
  "quote_names": false,
  "print_permissions": false,
  "print_owner": false,
  "print_group": false,
  "print_size_bytes": false,
  "human_readable_size": true,
  "si_units": false,
  "disk_usage": false,
  "print_mtime": true,
  "print_inodes": false,
  "print_device": false,
  "sort_version": false,
  "sort_mtime": false,
  "sort_ctime": false,
  "no_sort": false,
  "reverse_sort": false,
  "dirs_first": true,
  "files_first": false,
  "sort_type": "",
  "no_indent": false,
  "ansi_graphics": false,
  "force_colors": false,
  "no_colors": false,
  "xml_output": false,
  "json_output": false,
  "html_output": false,
  "html_base_href": "",
  "html_title": "Log Directory Tree",
  "hyperlinks": false,
  "hyperlink_scheme": "file",
  "hyperlink_authority": ""
}
