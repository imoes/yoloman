{
  "root_dir": {
    "type": "string",
    "default": ".",
    "description": "Root directory to start listing from. Defaults to current directory."
  },
  "max_depth": {
    "type": "number",
    "default": 0,
    "description": "Max display depth of the directory tree. 0 means unlimited."
  },
  "list_dirs_only": {
    "type": "bool",
    "default": false,
    "description": "List directories only."
  },
  "follow_symlinks": {
    "type": "bool",
    "default": false,
    "description": "Follow symbolic links if they point to directories."
  },
  "print_full_paths": {
    "type": "bool",
    "default": false,
    "description": "Print the full path prefix for each file."
  },
  "stay_on_filesystem": {
    "type": "bool",
    "default": false,
    "description": "Stay on the current file-system only (-x)."
  },
  "include_patterns": {
    "type": "list",
    "default": [],
    "description": "List of wildcard patterns for files to include (-P). Empty list means no filter."
  },
  "exclude_patterns": {
    "type": "list",
    "default": [],
    "description": "List of wildcard patterns for files to exclude (-I). Empty list means no filter."
  },
  "use_gitignore": {
    "type": "bool",
    "default": false,
    "description": "Use git .gitignore files for filtering."
  },
  "ignore_case": {
    "type": "bool",
    "default": false,
    "description": "Ignore case in pattern matching."
  },
  "match_dirs": {
    "type": "bool",
    "default": false,
    "description": "Apply include patterns to directory names."
  },
  "prune_empty": {
    "type": "bool",
    "default": false,
    "description": "Prune empty directories from output."
  },
  "print_info_comments": {
    "type": "bool",
    "default": false,
    "description": "Print file comments from .info files."
  },
  "omit_report": {
    "type": "bool",
    "default": false,
    "description": "Omit the final file/directory report."
  },
  "charset": {
    "type": "string",
    "default": "UTF-8",
    "description": "Character set for output (--charset)."
  },
  "file_limit": {
    "type": "number",
    "default": 0,
    "description": "Do not descend into directories with more than # entries. 0 means unlimited."
  },
  "time_fmt": {
    "type": "string",
    "default": "",
    "description": "Format string for modification times (--timefmt). Empty string disables."
  },
  "output_file": {
    "type": "string",
    "default": "",
    "description": "Filename to send output to (-o). Empty string means stdout."
  },
  "question_marks": {
    "type": "bool",
    "default": false,
    "description": "Print non-printable characters as question marks (-q)."
  },
  "quote_names": {
    "type": "bool",
    "default": false,
    "description": "Quote filenames in double quotes (-Q)."
  },
  "print_permissions": {
    "type": "bool",
    "default": false,
    "description": "Print file type and permissions (-p)."
  },
  "print_owner": {
    "type": "bool",
    "default": false,
    "description": "Print username/UID of files (-u)."
  },
  "print_group": {
    "type": "bool",
    "default": false,
    "description": "Print group name/GID of files (-g)."
  },
  "print_size_bytes": {
    "type": "bool",
    "default": false,
    "description": "Print size of each file in bytes (-s)."
  },
  "human_readable_size": {
    "type": "bool",
    "default": false,
    "description": "Print file size in human-readable format (-h)."
  },
  "si_units": {
    "type": "bool",
    "default": false,
    "description": "Use SI units for sizes (--si)."
  },
  "disk_usage": {
    "type": "bool",
    "default": false,
    "description": "Print directory sizes as accumulation of file sizes (--du)."
  },
  "print_mtime": {
    "type": "bool",
    "default": false,
    "description": "Print modification time (-D)."
  },
  "print_inodes": {
    "type": "bool",
    "default": false,
    "description": "Print inode number (--inodes)."
  },
  "print_device": {
    "type": "bool",
    "default": false,
    "description": "Print device number (--device)."
  },
  "sort_version": {
    "type": "bool",
    "default": false,
    "description": "Sort by version string (-v)."
  },
  "sort_mtime": {
    "type": "bool",
    "default": false,
    "description": "Sort by last modification time (-t)."
  },
  "sort_ctime": {
    "type": "bool",
    "default": false,
    "description": "Sort by last status change time (-c)."
  },
  "no_sort": {
    "type": "bool",
    "default": false,
    "description": "Do not sort; list in directory order (-U)."
  },
  "reverse_sort": {
    "type": "bool",
    "default": false,
    "description": "Reverse sort order (-r)."
  },
  "dirs_first": {
    "type": "bool",
    "default": false,
    "description": "List directories before files (--dirsfirst)."
  },
  "files_first": {
    "type": "bool",
    "default": false,
    "description": "List files before directories (--filesfirst)."
  },
  "sort_type": {
    "type": "string",
    "default": "name",
    "description": "Sort by type: ctime, mtime, size, version, or none. Empty string disables.",
    "enum": [
      "name",
      "ctime",
      "mtime",
      "size",
      "version",
      "none"
    ]
  },
  "no_indent": {
    "type": "bool",
    "default": false,
    "description": "Do not print indentation lines (-i)."
  },
  "ansi_graphics": {
    "type": "bool",
    "default": false,
    "description": "Turn on ANSI line graphics (-A)."
  },
  "force_colors": {
    "type": "bool",
    "default": false,
    "description": "Turn on colorization always (-C)."
  },
  "no_colors": {
    "type": "bool",
    "default": false,
    "description": "Turn off colorization always (-n)."
  },
  "xml_output": {
    "type": "bool",
    "default": false,
    "description": "Output as XML (-X)."
  },
  "json_output": {
    "type": "bool",
    "default": false,
    "description": "Output as JSON (-J)."
  },
  "html_output": {
    "type": "bool",
    "default": false,
    "description": "Output as HTML (-H)."
  },
  "html_base_href": {
    "type": "string",
    "default": "",
    "description": "HTML base href (-H baseHREF)."
  },
  "html_title": {
    "type": "string",
    "default": "Tree Output",
    "description": "HTML title (-T title)."
  },
  "hyperlinks": {
    "type": "bool",
    "default": false,
    "description": "Enable OSC 8 terminal hyperlinks (--hyperlink)."
  },
  "hyperlink_scheme": {
    "type": "string",
    "default": "file",
    "description": "Scheme for hyperlinks (--scheme).",
    "enum": [
      "file://",
      "file",
      "ftp"
    ]
  },
  "hyperlink_authority": {
    "type": "string",
    "default": "",
    "description": "Authority (hostname) for hyperlinks (--authority)."
  }
}
