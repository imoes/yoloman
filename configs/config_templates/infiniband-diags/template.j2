# infiniband-diags monitoring configuration template
# This file configures the thresholds for various InfiniBand port counter events.
# When a counter exceeds its threshold, an alert is triggered.

# Threshold for SymbolErrorCounter events before alerting.
# Defaults to 10 if not specified.
SymbolErrorCounter={{ symbol_error_counter | default(10) }}

# Threshold for LinkErrorRecoveryCounter events before alerting.
# Defaults to 10 if not specified.
LinkErrorRecoveryCounter={{ link_error_recovery_counter | default(10) }}

# Threshold for LinkDownedCounter events before alerting.
# Defaults to 10 if not specified.
LinkDownedCounter={{ link_downed_counter | default(10) }}

# Threshold for PortRcvErrors events before alerting.
# Defaults to 10 if not specified.
PortRcvErrors={{ port_rcv_errors | default(10) }}

# Threshold for PortRcvRemotePhysicalErrors events before alerting.
# Defaults to 100 if not specified.
PortRcvRemotePhysicalErrors={{ port_rcv_remote_physical_errors | default(100) }}

# Threshold for PortRcvSwitchRelayErrors events before alerting.
# Defaults to 100 if not specified.
PortRcvSwitchRelayErrors={{ port_rcv_switch_relay_errors | default(100) }}

# Threshold for PortXmitDiscards events before alerting.
# Defaults to 100 if not specified.
PortXmitDiscards={{ port_xmit_discards | default(100) }}

# Threshold for PortXmitConstraintErrors events before alerting.
# Defaults to 100 if not specified.
PortXmitConstraintErrors={{ port_xmit_constraint_errors | default(100) }}

# Threshold for PortRcvConstraintErrors events before alerting.
# Defaults to 100 if not specified.
PortRcvConstraintErrors={{ port_rcv_constraint_errors | default(100) }}

# Threshold for LocalLinkIntegrityErrors events before alerting.
# Defaults to 10 if not specified.
LocalLinkIntegrityErrors={{ local_link_integrity_errors | default(10) }}

# Threshold for ExcessiveBufferOverrunErrors events before alerting.
# Defaults to 10 if not specified.
ExcessiveBufferOverrunErrors={{ excessive_buffer_overrun_errors | default(10) }}

# Threshold for VL15Dropped events before alerting.
# Defaults to 100 if not specified.
VL15Dropped={{ vl15_dropped | default(100) }}

# Threshold for PortXmitWait events before alerting.
# Defaults to 1000 if not specified.
PortXmitWait={{ port_xmit_wait | default(1000) }}