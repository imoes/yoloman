# infiniband-diags error threshold configuration
# This file defines thresholds for various InfiniBand port counters.
# When a counter exceeds the specified value, an alert or log entry is generated.
# Lines starting with '#' are commented out and use the default values.
# To enable a threshold, uncomment the line and set the desired value.
#
# Note: Empty or undefined variables will result in the commented-out default being used.

# SymbolErrorCounter: Threshold for SymbolErrorCounter events before alerting.
{% if symbol_error_counter is defined and symbol_error_counter != '' %}
SymbolErrorCounter={{ symbol_error_counter | default('') }}
{% else %}
#SymbolErrorCounter=10
{% endif %}

