{% if oidc_oauth_introspection_endpoint_key_password is defined and oidc_oauth_introspection_endpoint_key_password | default('') %}OIDCOAuthIntrospectionEndpointKeyPassword {{ oidc_oauth_introspection_endpoint_key_password | default('') }}{% else %}#OIDCOAuthIntrospectionEndpointKeyPassword [ <passphrase> | "exec:/path/to/otherProgram arg1" ]{% endif %}

