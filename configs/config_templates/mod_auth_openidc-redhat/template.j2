{% if oidc_oauth_introspection_endpoint_params is defined and oidc_oauth_introspection_endpoint_params | default('') %}OIDCOAuthIntrospectionEndpointParams {{ oidc_oauth_introspection_endpoint_params | default('') }}{% else %}#OIDCOAuthIntrospectionEndpointParams <urlencoded-name1>=<urlencoded-value1>[&<urlencoded-nameN>=<urlencoded-valueN>]* {% endif %}

