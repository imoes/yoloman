########################################################################################
#
# Common Settings
#
########################################################################################

# (Mandatory)
# The redirect_uri for this OpenID Connect client; this is a vanity URL
# that must ONLY point to a path on your server protected by this module
# but it must NOT point to any actual content that needs to be served.
# You can use a relative URL like /protected/redirect_uri if you want to
# support multiple vhosts that belong to the same security domain in a dynamic way
{# The redirect_uri for this OpenID Connect client. #}
{# Default: '' (empty, requiring explicit configuration) #}
{% if oidc_redirect_uri is defined and oidc_redirect_uri | default('') %}OIDCRedirectURI {{ oidc_redirect_uri | default('') }}{% else %}#OIDCRedirectURI https://www.example.com/protected/redirect_uri{% endif %}

{# Password for crypto purposes (encryption of state cookie and cache entries). #}
{# Default: 'changeme' #}
{# Note: In production, ensure this is a strong, random passphrase. #}
OIDCCryptoPassphrase {{ oidc_crypto_passphrase | default('changeme') }}

#
# All other entries below this are optional though some may be required in a
# particular setup e.g. OAuth 2.0 Resource Server vs. OpenID Connect Relying Party
#

{# Directory that holds metadata files for multiple OpenID Connect Providers. #}
{# Default: '' (empty, implying single provider configuration via URL) #}
{# Must be writable for the Apache process/user. #}
{% if oidc_metadata_dir is defined and oidc_metadata_dir | default('') %}OIDCMetadataDir {{ oidc_metadata_dir | default('') }}{% else %}#OIDCMetadataDir /var/cache/httpd/mod_auth_openidc/metadata{% endif %}

########################################################################################
#
# OpenID Connect Provider
#
# For configuration of a single static provider, not using OpenID Connect Provider Discovery.
#
########################################################################################

{# URL where OpenID Connect Provider metadata can be found. #}
{# Default: '' (empty) #}
{# If set, individual entries below (issuer, endpoints, etc.) are optional as they #}
{# will be fetched from this metadata URL. #}
{% if oidc_provider_metadata_url is defined and oidc_provider_metadata_url | default('') %}OIDCProviderMetadataURL {{ oidc_provider_metadata_url | default('') }}{% else %}#OIDCProviderMetadataURL <url>{% endif %}

{# OpenID Connect Provider issuer identifier. #}
{# Default: '' (empty) #}
{# Used when OIDCProviderMetadataURL is not defined or missing from metadata. #}
{% if oidc_provider_issuer is defined and oidc_provider_issuer | default('') %}OIDCProviderIssuer {{ oidc_provider_issuer | default('') }}{% else %}#OIDCProviderIssuer <issuer>{% endif %}

{# OpenID Connect Provider Authorization Endpoint URL. #}
{# Default: '' (empty) #}
{% if oidc_provider_authorization_endpoint is defined and oidc_provider_authorization_endpoint | default('') %}OIDCProviderAuthorizationEndpoint {{ oidc_provider_authorization_endpoint | default('') }}{% else %}#OIDCProviderAuthorizationEndpoint <authorization_endpoint>{% endif %}

{# OpenID Connect Provider JWKS URL. #}
{# Default: '' (empty) #}
{# URL on which the signing keys for this OP are hosted, in JWK formatting. #}
{% if oidc_provider_jwks_uri is defined and oidc_provider_jwks_uri | default('') %}OIDCProviderJwksUri {{ oidc_provider_jwks_uri | default('') }}{% else %}#OIDCProviderJwksUri <jwks_url>{% endif %}

{# OpenID Connect Provider Signed JWKS URL. #}
{# Default: '' (empty) #}
{# Used to verify the provided JWKs value. Takes precedence over OIDCProviderJwksUri. #}
{# Example: OIDCProviderSignedJwksUri <url> "{\"keys\":[...]}" #}
OIDCProviderSignedJwksUri {{ oidc_provider_signed_jwks_uri | default('') }}

{# Files containing X.509 certificates for ID Token verification. #}
{# Default: 'sig' #}
{# Format: ["sig:"|"enc:"][<kid>#]<filename> #}
{% if oidc_provider_verify_cert_files is defined and oidc_provider_verify_cert_files | default('sig') %}OIDCProviderVerifyCertFiles {{ oidc_provider_verify_cert_files | default('sig') }}{% else %}#OIDCProviderVerifyCertFiles (["sig:"|"enc:"][<kid>#]<filename>)+{% endif %}

{# OpenID Connect Provider Token Endpoint URL. #}
{# Default: '' (empty) #}
{% if oidc_provider_token_endpoint is defined and oidc_provider_token_endpoint | default('') %}OIDCProviderTokenEndpoint {{ oidc_provider_token_endpoint | default('') }}{% else %}#OIDCProviderTokenEndpoint <token_endpoint>{% endif %}

{# Authentication method for the Token Endpoint. #}
{# Default: 'client_secret_basic' #}
{% if oidc_provider_token_endpoint_auth is defined and oidc_provider_token_endpoint_auth | default('client_secret_basic') %}OIDCProviderTokenEndpointAuth {{ oidc_provider_token_endpoint_auth | default('client_secret_basic') }}{% else %}#OIDCProviderTokenEndpointAuth [ client_secret_basic | client_secret_post | client_secret_jwt | private_key_jwt | none ]{% endif %}

{# Extra parameters for the Token Endpoint POST request. #}
{# Default: '' (empty) #}
{# URL-encoded form: name1=value1&name2=value2 #}
{% if oidc_provider_token_endpoint_params is defined and oidc_provider_token_endpoint_params | default('') %}OIDCProviderTokenEndpointParams {{ oidc_provider_token_endpoint_params | default('') }}{% else %}#OIDCProviderTokenEndpointParams <urlencoded-name1>=<urlencoded-value1>[&<urlencoded-nameN>=<urlencoded-valueN>]* {% endif %}

{# OpenID Connect Provider UserInfo Endpoint URL. #}
{# Default: '' (empty) #}
{% if oidc_provider_userinfo_endpoint is defined and oidc_provider_userinfo_endpoint | default('') %}OIDCProviderUserInfoEndpoint {{ oidc_provider_userinfo_endpoint | default('') }}{% else %}#OIDCProviderUserInfoEndpoint <user_info_endpoint>{% endif %}

{# OpenID OP Check Session iFrame URL. #}
{# Default: '' (empty) #}
{% if oidc_provider_check_session_iframe is defined and oidc_provider_check_session_iframe | default('') %}OIDCProviderCheckSessionIFrame {{ oidc_provider_check_session_iframe | default('') }}{% else %}#OIDCProviderCheckSessionIFrame <url>{% endif %}

{# OpenID OP End Session Endpoint URL. #}
{# Default: '' (empty) #}
{% if oidc_provider_end_session_endpoint is defined and oidc_provider_end_session_endpoint | default('') %}OIDCProviderEndSessionEndpoint {{ oidc_provider_end_session_endpoint | default('') }}{% else %}#OIDCProviderEndSessionEndpoint <url>{% endif %}

{# Extra parameters for the Logout Request. #}
{# Default: '' (empty) #}
{# URL-query-encoded: client_id=myclient&prompt=none #}
{% if oidc_logout_request_params is defined and oidc_logout_request_params | default('') %}OIDCLogoutRequestParams {{ oidc_logout_request_params | default('') }}{% else %}#OIDCLogoutRequestParams <query-encoded-string>{% endif %}

{# The RFC 7009 Token Revocation Endpoint URL. #}
{# Default: '' (empty) #}
{% if oidc_provider_revocation_endpoint is defined and oidc_provider_revocation_endpoint | default('') %}OIDCProviderRevocationEndpoint {{ oidc_provider_revocation_endpoint | default('') }}{% else %}#OIDCProviderRevocationEndpoint <url>{% endif %}

{# The RFC 9126 Pushed Authorization Request endpoint URL. #}
{# Default: '' (empty) #}
{% if oidc_provider_pushed_authorization_request_endpoint is defined and oidc_provider_pushed_authorization_request_endpoint | default('') %}OIDCProviderPushedAuthorizationRequestEndpoint {{ oidc_provider_pushed_authorization_request_endpoint | default('') }}{% else %}#OIDCProviderPushedAuthorizationRequestEndpoint <url>{% endif %}

{# Define whether the OP supports OpenID Connect Back Channel Logout. #}
{# Default: 'On' #}
{% if oidc_provider_back_channel_logout_supported is defined and oidc_provider_back_channel_logout_supported | default('On') %}OIDCProviderBackChannelLogoutSupported {{ oidc_provider_back_channel_logout_supported | default('On') }}{% else %}#OIDCProviderBackChannelLogoutSupported [On|Off]{% endif %}

{# Extra JSON parameters for the registration request. #}
{# Default: '' (empty) #}
{# JSON form, merged into the request. #}
{% if oidc_provider_registration_endpoint_json is defined and oidc_provider_registration_endpoint_json | default('') %}OIDCProviderRegistrationEndpointJson {{ oidc_provider_registration_endpoint_json | default('') }}{% else %}#OIDCProviderRegistrationEndpointJson <json-string>{% endif %}

{# The OpenID Connect scope requested from the OP. #}
{# Default: '' (empty, defaults to "openid") #}
{# Multiple scopes must be enclosed in double quotes: "openid email profile" #}
{% if oidc_scope is defined and oidc_scope | default('') %}OIDCScope "{{ oidc_scope | default('') }}"{% else %}#OIDCScope "<scope(s)-separated-by-spaces-and-enclosed-in-double-quotes>"{% endif %}

{# Extra parameters for the Authorization Request. #}
{# Default: '' (empty) #}
{# URL-query-encoded: display=popup&prompt=consent #}
{% if oidc_auth_request_params is defined and oidc_auth_request_params | default('') %}OIDCAuthRequestParams {{ oidc_auth_request_params | default('') }}{% else %}#OIDCAuthRequestParams <query-encoded-string>{% endif %}

{# Require a valid SSL server certificate when communicating with the OP. #}
{# Default: 'On' #}
{% if oidc_ssl_validate_server is defined and oidc_ssl_validate_server | default('On') %}OIDCSSLValidateServer {{ oidc_ssl_validate_server | default('On') }}{% else %}#OIDCSSLValidateServer [On|Off]{% endif %}

{# Path to the CA bundle to be used by cURL. #}
{# Default: '' (empty, uses platform default) #}
{% if oidc_ca_bundle_path is defined and oidc_ca_bundle_path | default('') %}OIDCCABundlePath {{ oidc_ca_bundle_path | default('') }}{% else %}#OIDCCABundlePath <path>{% endif %}

{# Require configured issuer to match the issuer returned in id_token. #}
{# Default: 'On' #}
{% if oidc_validate_issuer is defined and oidc_validate_issuer | default('On') %}OIDCValidateIssuer {{ oidc_validate_issuer | default('On') }}{% else %}#OIDCValidateIssuer [On|Off]{% endif %}

{# Refresh interval in seconds for claims from the userinfo endpoint. #}
{# Default: '' (empty, retrieve only once at session creation) #}
{% if oidc_userinfo_refresh_interval is defined and oidc_userinfo_refresh_interval | default('') %}OIDCUserInfoRefreshInterval {{ oidc_userinfo_refresh_interval | default('') }}{% else %}#OIDCUserInfoRefreshInterval <seconds> [ logout_on_error | authenticate_on_error | 502_on_error ]{% endif %}

{# Refresh interval in seconds for the JWKs key set. #}
{# Default: '' (empty, defaults to 3600 seconds) #}
{% if oidc_jwks_refresh_interval is defined and oidc_jwks_refresh_interval | default('') %}OIDCJWKSRefreshInterval {{ oidc_jwks_refresh_interval | default('') }}{% else %}#OIDCJWKSRefreshInterval <seconds>{% endif %}

{# Way in which the access token is presented to the userinfo endpoint. #}
{# Default: 'authz_header' #}
{% if oidc_userinfo_token_method is defined and oidc_userinfo_token_method | default('authz_header') %}OIDCUserInfoTokenMethod {{ oidc_userinfo_token_method | default('authz_header') }}{% else %}#OIDCUserInfoTokenMethod [authz_header|post_param]{% endif %}

{# HTTP method used to pass parameters in the Authentication Request. #}
{# Default: 'GET' #}
{% if oidc_provider_auth_request_method is defined and oidc_provider_auth_request_method | default('GET') %}OIDCProviderAuthRequestMethod {{ oidc_provider_auth_request_method | default('GET') }}{% else %}#OIDCProviderAuthRequestMethod [ GET | POST | PAR ]{% endif %}

{# Files containing PEM-formatted public keys for JWT encryption. #}
{# Default: 'enc' #}
{# Format: ["sig:"|"enc:"][<kid>#]<filename> #}
{% if oidc_public_key_files is defined and oidc_public_key_files | default('enc') %}OIDCPublicKeyFiles {{ oidc_public_key_files | default('enc') }}{% else %}#OIDCPublicKeyFiles (["sig:"|"enc:"][<kid>#]<filename>)+{% endif %}

{# Files containing PEM-formatted private keys for JWT decryption. #}
{# Default: '' (empty) #}
{# Format: ["sig:"|"enc:"][<kid>#]<filename> #}
{% if oidc_private_key_files is defined and oidc_private_key_files | default('') %}OIDCPrivateKeyFiles {{ oidc_private_key_files | default('') }}{% else %}#OIDCPrivateKeyFiles (["sig:"|"enc:"][<kid>#]<filename>)+{% endif %}

########################################################################################
#
# OpenID Connect Client
#
# Settings used by the client in communication with the OpenID Connect Provider(s).
#
########################################################################################

{# The response type (or OpenID Connect Flow) used. #}
{# Default: 'code' #}
{% if oidc_response_type is defined and oidc_response_type | default('code') %}OIDCResponseType {{ oidc_response_type | default('code') }}{% else %}#OIDCResponseType ["code"|"id_token"|"id_token token"|"code id_token"|"code token"|"code id_token token"]{% endif %}

{# The response mode used. #}
{# Default: 'fragment' #}
{% if oidc_response_mode is defined and oidc_response_mode | default('fragment') %}OIDCResponseMode {{ oidc_response_mode | default('fragment') }}{% else %}#OIDCResponseMode [fragment|query|form_post]{% endif %}

{# Client identifier used in calls to the OP. #}
{# Default: '' (empty) #}
{% if oidc_client_id is defined and oidc_client_id | default('') %}OIDCClientID {{ oidc_client_id | default('') }}{% else %}#OIDCClientID <client_id>{% endif %}

{# Client secret used in calls to the OP. #}
{# Default: '' (empty) #}
{% if oidc_client_secret is defined and oidc_client_secret | default('') %}OIDCClientSecret {{ oidc_client_secret | default('') }}{% else %}#OIDCClientSecret [ <client_secret> | "exec:/path/to/otherProgram argument1" ]{% endif %}

{# Filename with the PEM-formatted client certificate for token endpoint authentication. #}
{# Default: '' (empty) #}
{% if oidc_client_token_endpoint_cert is defined and oidc_client_token_endpoint_cert | default('') %}OIDCClientTokenEndpointCert {{ oidc_client_token_endpoint_cert | default('') }}{% else %}#OIDCClientTokenEndpointCert <filename>{% endif %}

{# Filename with the PEM-formatted private key for token endpoint authentication. #}
{# Default: '' (empty) #}
{% if oidc_client_token_endpoint_key is defined and oidc_client_token_endpoint_key | default('') %}OIDCClientTokenEndpointKey {{ oidc_client_token_endpoint_key | default('') }}{% else %}#OIDCClientTokenEndpointKey <filename>{% endif %}

{# Password for the PEM-formatted private key for token endpoint authentication. #}
{# Default: '' (empty) #}
{% if oidc_client_token_endpoint_key_password is defined and oidc_client_token_endpoint_key_password | default('') %}OIDCClientTokenEndpointKeyPassword {{ oidc_client_token_endpoint_key_password | default('') }}{% else %}#OIDCClientTokenEndpointKeyPassword [ <passphrase> | "exec:/path/to/otherProgram arg1" ]{% endif %}

{# The client name registered in dynamic registration. #}
{# Default: '' (empty) #}
{% if oidc_client_name is defined and oidc_client_name | default('') %}OIDCClientName {{ oidc_client_name | default('') }}{% else %}#OIDCClientName <client_name>{% endif %}

{# The contacts registered in dynamic registration. #}
{# Default: '' (empty) #}
{% if oidc_client_contact is defined and oidc_client_contact | default('') %}OIDCClientContact {{ oidc_client_contact | default('') }}{% else %}#OIDCClientContact <contact>{% endif %}

{# The PKCE method used. #}
{# Default: 'S256' #}
{% if oidc_pkce_method is defined and oidc_pkce_method | default('S256') %}OIDCPKCEMethod {{ oidc_pkce_method | default('S256') }}{% else %}#OIDCPKCEMethod [ S256 | plain | |none ]{% endif %}

{# The DPoP mode used. #}
{# Default: 'off' #}
{% if oidc_dpop_mode is defined and oidc_dpop_mode | default('off') %}OIDCDPoPMode {{ oidc_dpop_mode | default('off') }}{% else %}#OIDCDPoPMode [off|optional|required] [on|off]{% endif %}

{# The Client JWKs URL used during client registration. #}
{# Default: '' (empty) #}
{% if oidc_client_jwks_uri is defined and oidc_client_jwks_uri | default('') %}OIDCClientJwksUri {{ oidc_client_jwks_uri | default('') }}{% else %}#OIDCClientJwksUri <url>{% endif %}

{# The algorithm that the OP should use to sign the id_token. #}
{# Default: 'RS256' #}
{% if oidc_id_token_signed_response_alg is defined and oidc_id_token_signed_response_alg | default('RS256') %}OIDCIDTokenSignedResponseAlg {{ oidc_id_token_signed_response_alg | default('RS256') }}{% else %}#OIDCIDTokenSignedResponseAlg [RS256|RS384|RS512|PS256|PS384|PS512|HS256|HS384|HS512|ES256|ES384|ES512]{% endif %}

{# The algorithm that the OP should use to encrypt the Content Encryption Key for the id_token. #}
{# Default: 'RSA-OAEP' #}
{% if oidc_id_token_encrypted_response_alg is defined and oidc_id_token_encrypted_response_alg | default('RSA-OAEP') %}OIDCIDTokenEncryptedResponseAlg {{ oidc_id_token_encrypted_response_alg | default('RSA-OAEP') }}{% else %}#OIDCIDTokenEncryptedResponseAlg [RSA1_5|A128KW|A256KW|RSA-OAEP]{% endif %}

{# The algorithm that the OP should use to encrypt the id_token with the Content Encryption Key. #}
{# Default: 'A256CBC-HS512' #}
{% if oidc_id_token_encrypted_response_enc is defined and oidc_id_token_encrypted_response_enc | default('A256CBC-HS512') %}OIDCIDTokenEncryptedResponseEnc {{ oidc_id_token_encrypted_response_enc | default('A256CBC-HS512') }}{% else %}#OIDCIDTokenEncryptedResponseEnc [A128CBC-HS256|A256CBC-HS512|A256GCM]{% endif %}

{# The accepted value(s) of the "aud" claim in the ID token. #}
{# Default: '' (empty) #}
{% if oidc_id_token_aud_values is defined and oidc_id_token_aud_values | default('') %}OIDCIDTokenAudValues {{ oidc_id_token_aud_values | default('') }}{% else %}#OIDCIDTokenAudValues <value>+{% endif %}

{# The algorithm that the OP should use to sign the UserInfo response. #}
{# Default: 'RS256' #}
{% if oidc_userinfo_signed_response_alg is defined and oidc_userinfo_signed_response_alg | default('RS256') %}OIDCUserInfoSignedResponseAlg {{ oidc_userinfo_signed_response_alg | default('RS256') }}{% else %}#OIDCUserInfoSignedResponseAlg RS256|RS384|RS512|PS256|PS384|PS512|HS256|HS384|HS512|ES256|ES384|ES512]{% endif %}

{# The algorithm that the OP should use to encrypt the Content Encryption Key for the UserInfo response. #}
{# Default: 'RSA-OAEP' #}
{% if oidc_userinfo_encrypted_response_alg is defined and oidc_userinfo_encrypted_response_alg | default('RSA-OAEP') %}OIDCUserInfoEncryptedResponseAlg {{ oidc_userinfo_encrypted_response_alg | default('RSA-OAEP') }}{% else %}#OIDCUserInfoEncryptedResponseAlg [RSA1_5|A128KW|A256KW|RSA-OAEP]{% endif %}

{# The algorithm that the OP should use to encrypt the UserInfo response with the Content Encryption Key. #}
{# Default: 'A256CBC-HS512' #}
{% if oidc_userinfo_encrypted_response_enc is defined and oidc_userinfo_encrypted_response_enc | default('A256CBC-HS512') %}OIDCUserInfoEncryptedResponseEnc {{ oidc_userinfo_encrypted_response_enc | default('A256CBC-HS512') }}{% else %}#OIDCUserInfoEncryptedResponseEnc [A128CBC-HS256|A256CBC-HS512|A256GCM]{% endif %}

{# The OpenID Connect (client) profile to adhere to. #}
{# Default: '' (empty, defaults to OIDC10) #}
{% if oidc_profile is defined and oidc_profile | default('') %}OIDCProfile {{ oidc_profile | default('') }}{% else %}#OIDCProfile [ OIDC10 | FAPI20 ]{% endif %}

