# Configuration for metadata-cleaner
# https://gitlab.com/rmnvgr/metadata-cleaner

[metadata_cleaner]
# If true, runs in lightweight mode to preserve file content integrity at the cost of less thorough metadata removal.
# This prevents altering file data (e.g., re-compressing images) at the expense of potentially leaving some metadata untouched.
# See man page: "Users that are willing to trade off some metadata's presence for the guarantee that files won't be changed might use the lightweight mode."
lightweight = {{ lightweight | default(False) | lower }}