# ==============================================================================
# Ganeti Instance-Debootstrap Configuration Template
# ==============================================================================
# This file is sourced by the `instance-debootstrap` script to configure
# the creation of Debian/Ubuntu instances within a Ganeti cluster.
#
# Self-Documentation:
# Every variable below includes its default value and a description of its
# purpose. If a variable is not provided by the Ansible inventory, the
# default defined in the schema will be used.
#
# Usage:
#   - To override values at runtime, use /etc/ganeti/instance-debootstrap/extra.cfg
#     or environment variables.
#   - Do not edit this generated file directly; it is managed by Ansible.
# ==============================================================================

# --------------------------------------------------------------------------
# Mirror Configuration
# --------------------------------------------------------------------------
# MIRROR: Base URL of the package mirror to use for debootstrap.
#   - If empty, debootstrap will use its default mirror (Debian stable).
#   - Example: 'http://ftp.debian.org/debian'
# --------------------------------------------------------------------------
Mirror = {{ MIRROR | default('') }}

# --------------------------------------------------------------------------
# Proxy Configuration
# --------------------------------------------------------------------------
# PROXY: HTTP(S) proxy URL to use during debootstrap.
#   - Leave empty to disable proxy usage (direct connection).
#   - Example: 'http://proxy.example.com:3128/'
# --------------------------------------------------------------------------
Proxy = {{ PROXY | default('') }}

# --------------------------------------------------------------------------
# Architecture
# --------------------------------------------------------------------------
# ARCH: Target architecture for the new instance.
#   - If empty, the host's architecture is used.
#   - Examples: 'amd64', 'i386', 'arm64'
# --------------------------------------------------------------------------
Arch = {{ ARCH | default('') }}

# --------------------------------------------------------------------------
# Suite (Release)
# --------------------------------------------------------------------------
# SUITE: Debian/Ubuntu suite (release codename or status).
#   - If empty, debootstrap defaults to 'stable'.
#   - Examples: 'buster', 'bullseye', 'jammy', 'unstable', 'testing'
# --------------------------------------------------------------------------
Suite = {{ SUITE | default('') }}

# --------------------------------------------------------------------------
# Components
# --------------------------------------------------------------------------
# COMPONENTS: Comma-separated list of repository components to include.
#   - If empty, defaults to 'main'.
#   - Examples: 'main,contrib,non-free', 'main universe'
# --------------------------------------------------------------------------
Components = {{ COMPONENTS | default('') }}

# --------------------------------------------------------------------------
# Extra Packages
# --------------------------------------------------------------------------
# EXTRA_PKGS: Comma-separated list of additional packages to install
#   inside the new instance during debootstrap.
#   - Examples: 'vim,net-tools,ssh'
# --------------------------------------------------------------------------
ExtraPkgs = {{ EXTRA_PKGS | default('') }}

# --------------------------------------------------------------------------
# Customization Directory
# --------------------------------------------------------------------------
# CUSTOMIZE_DIR: Directory containing hook scripts to run during instance
#   customization. Scripts are executed in 'run-parts' format (alphabetical
#   order) after the base system is installed.
# --------------------------------------------------------------------------
CustomizeDir = {{ CUSTOMIZE_DIR | default('/etc/ganeti/instance-debootstrap/hooks') }}

# --------------------------------------------------------------------------
# Cache Generation
# --------------------------------------------------------------------------
# GENERATE_CACHE: Whether to generate cache files during debootstrap to
#   speed up subsequent instance creations.
#   - 'yes': Enable caching.
#   - Other/empty: Disable caching.
# --------------------------------------------------------------------------
GenerateCache = {{ GENERATE_CACHE | default('yes') }}

# --------------------------------------------------------------------------
# Cache Cleaning
# --------------------------------------------------------------------------
# CLEAN_CACHE: Number of days after which cache files are automatically
#   cleaned up to save disk space.
#   - If empty, cache cleaning is disabled.
# --------------------------------------------------------------------------
CleanCache = {{ CLEAN_CACHE | default('14') }}

# --------------------------------------------------------------------------
# Partition Style
# --------------------------------------------------------------------------
# PARTITION_STYLE: Partition table format for the target virtual disk.
#   - 'none': No partition table (raw disk usage).
#   - 'msdos': Legacy MBR partition table.
# --------------------------------------------------------------------------
PartitionStyle = {{ PARTITION_STYLE | default('msdos') }}

# --------------------------------------------------------------------------
# Partition Alignment
# --------------------------------------------------------------------------
# PARTITION_ALIGNMENT: Partition alignment in 512-byte sectors.
#   - Example: 2048 sectors = 1 MiB alignment (good for SSDs).
# --------------------------------------------------------------------------
PartitionAlignment = {{ PARTITION_ALIGNMENT | default('2048') }}
