{
  "command": "/usr/local/bin/mydaemon",
  "args": [
    "--config",
    "/etc/mydaemon.conf"
  ],
  "chdir": "/var/lib/mydaemon",
  "stdout": "/var/log/mydaemon.log",
  "stderr": "/var/log/mydaemon.err",
  "append_output": true,
  "pidfile": "/run/mydaemon.pid",
  "lockfile": "/run/mydaemon.lock",
  "user": "mydaemon",
  "env": [
    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  ],
  "verbose": true
}
