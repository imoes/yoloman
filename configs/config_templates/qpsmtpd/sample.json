{
  "config.log_to_file": false,
  "config.log_file": "/var/log/qpsmtpd/qpsmtpd.log",
  "config.listeners": [
    {
      "address": "0.0.0.0",
      "port": 25
    }
  ],
  "config.max_connections_per_ip": 20,
  "config.timeout": 300,
  "config.auth_backends": [],
  "config.plugins": [
    {
      "name": "auth/daemon",
      "enabled": true
    },
    {
      "name": "tls",
      "enabled": true
    },
    {
      "name": "pre_qp",
      "enabled": true
    },
    {
      "name": "check_basicheaders",
      "enabled": true
    },
    {
      "name": "check_earlytalker",
      "enabled": true
    },
    {
      "name": "check_badmailfrom",
      "enabled": true
    },
    {
      "name": "check_badrcptto",
      "enabled": true
    },
    {
      "name": "check_spf",
      "enabled": true
    },
    {
      "name": "greylisting",
      "enabled": false
    },
    {
      "name": "spamassassin",
      "enabled": true
    },
    {
      "name": "rbl",
      "enabled": false
    },
    {
      "name": "vpopmail",
      "enabled": false
    },
    {
      "name": "rate",
      "enabled": false
    },
    {
      "name": "antivirus",
      "enabled": true
    }
  ],
  "config.spamassassin": {
    "enabled": true,
    "port": 783,
    "timeout": 30
  },
  "service.port": 25,
  "service.runas": "qpsmtpd",
  "service.enabled": "false"
}
