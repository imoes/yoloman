         The rest are restricted to root for security.
      -->

    <!-- org.freedesktop.ModemManager1.xml -->

    <!-- Allowed for everyone -->
    <!-- Allow Introspection of the main ModemManager object -->
    <allow send_destination="{{ send_destination_allow1 | default('org.freedesktop.ModemManager1') }}"
           send_interface="{{ send_interface_allow1 | default('org.freedesktop.DBus.Introspectable') }}"/>

    <!-- Allow access to standard D-Bus Properties interface -->
    <allow send_destination="{{ send_destination_allow2 | default('org.freedesktop.ModemManager1') }}"
           send_interface="{{ send_interface_allow2 | default('org.freedesktop.DBus.Properties') }}"/>

    <!-- Allow access to D-Bus ObjectManager interface for service discovery -->
    <allow send_destination="{{ send_destination_allow3 | default('org.freedesktop.ModemManager1') }}"
           send_interface="{{ send_interface_allow3 | default('org.freedesktop.DBus.ObjectManager') }}"/>

    <!-- Protected by the Control policy rule -->
    <!-- Allow scanning for available modem devices (requires privilege) -->
    <allow send_destination="{{ send_destination_allow4 | default('org.freedesktop.ModemManager1') }}"
           send_interface="{{ send_interface_allow4 | default('org.freedesktop.ModemManager1') }}"
           send_member="{{ send_member_allow4 | default('ScanDevices') }}"/>

    <!-- Allow changing the logging verbosity of the daemon (requires privilege) -->
