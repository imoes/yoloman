  <policy user="{{ policy_user_root | default('root') }}">
    <!-- Allow root to own the ModemManager bus name -->
    <allow own="{{ allow_own_root | default('org.freedesktop.ModemManager1') }}"/>
    <!-- Allow root to send messages to the ModemManager service -->
    <allow send_destination="{{ send_destination_root | default('org.freedesktop.ModemManager1') }}"/>
  </policy>
</busconfig>
