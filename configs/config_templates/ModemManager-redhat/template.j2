           send_interface="{{ send_interface_allow5 | default('org.freedesktop.ModemManager1') }}"
           send_member="{{ send_member_allow5 | default('SetLogging') }}"/>

    <!-- org.freedesktop.ModemManager1.Modem.xml -->

    <!-- Allowed for everyone -->
