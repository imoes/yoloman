           send_interface="{{ send_interface_allow6 | default('org.freedesktop.ModemManager1.Modem') }}"
           send_member="{{ send_member_allow6 | default('ListBearers') }}"/>

    <!-- Protected by the Device.Control policy rule -->
    <!-- Enable or disable the modem hardware (requires privilege) -->
