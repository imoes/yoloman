{
  "interface_driver": "neutron.agent.linux.interface.OVSInterfaceDriver",
  "enable_ha": true,
  "num_router_processes": 2,
  "router_delete_namespaces": true,
  "max_floating_ips_per_router": 100,
  "dvr_snat_default_snat_ip": "",
  "dvr_mode": "dvr_snat",
  "external_network_bridge": "br-ex",
  "agent_alive_interval": 30,
  "agent_alive_threshold": 10,
  "verbose": true,
  "log_dir": "/var/log/neutron",
  "log_file": "neutron-l3-agent.log",
  "services": [
    {
      "name": "ovs",
      "body": "of_enable_mirror=true\nof_mirror_port=br-int-mirror"
    }
  ],
  "router_mode": "dvr_snat",
  "external_gateway_helper": "neutron.agent.linux.external_gateway.ExternalGateway",
  "snat_internal_bridge": "br-int",
  "use_namespaces": true,
  "max_external_gw_nets": 2
}
