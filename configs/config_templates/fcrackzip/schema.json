{
  "zip_files": {
    "type": "list",
    "default": [],
    "description": "List of encrypted ZIP files to crack (must all share same password)"
  },
  "brute_force": {
    "type": "bool",
    "default": false,
    "description": "Enable brute-force mode"
  },
  "dictionary": {
    "type": "bool",
    "default": false,
    "description": "Enable dictionary mode"
  },
  "charset": {
    "type": "string",
    "default": "",
    "description": "Character set for brute-force (e.g., 'a1:$%' or 'A')",
    "enum": [
      "a",
      "A",
      "1",
      "!"
    ]
  },
  "init_password": {
    "type": "string",
    "default": "",
    "description": "Starting password (brute-force) or dictionary file path (dictionary)"
  },
  "length": {
    "type": "string",
    "default": "",
    "description": "Password length range (e.g., '4-8' or '6')"
  },
  "use_unzip": {
    "type": "bool",
    "default": false,
    "description": "Use external 'unzip' to verify candidates"
  },
  "method": {
    "type": "string",
    "default": "",
    "description": "Cracking method name or number (e.g., 'cpmask' or '2'). Empty string uses default."
  },
  "modulo": {
    "type": "string",
    "default": "",
    "description": "Modulo partition (e.g., 'r/m') \u2014 not yet supported"
  },
  "benchmark": {
    "type": "bool",
    "default": false,
    "description": "Run benchmark (not meaningful)"
  },
  "validate": {
    "type": "bool",
    "default": false,
    "description": "Run self-validation checks"
  },
  "verbose": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level (number of -v flags: 0=quiet, 1=normal, 2+=verbose)"
  }
}
