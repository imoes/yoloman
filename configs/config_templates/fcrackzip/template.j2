# ==============================================================================
# fcrackzip Configuration Template
# ==============================================================================
# This template generates the command-line invocation for fcrackzip.
# fcrackzip is a tool for cracking Zip file passwords using brute-force,
# dictionary, or charset-based methods.
# ==============================================================================

# --- Input Files ---
# List of encrypted ZIP files to crack.
# All files MUST be encrypted with the same password.
# One file per line.
{% for zip_file in zip_files | default([]) %}
{{ zip_file }}
{% endfor %}

# --- Mode Selection ---

# Brute-force mode: attempts all possible character combinations.
# Enables the --brute-force flag.
# Default: false
{% if brute_force | default(false) %}
--brute-force
{% endif %}

# Dictionary mode: uses a file containing potential passwords.
# Enables the --dictionary flag.
# Default: false
{% if dictionary | default(false) %}
--dictionary
{% endif %}

# --- Cracking Parameters ---

# Character set to use for brute-force cracking.
# Examples: 'a1:$%' (alphanumeric + symbols), 'A' (uppercase only).
# If empty, fcrackzip uses its internal default charset.
{% if charset | default('') | trim != '' %}
--charset {{ charset | default('') }}
{% endif %}

# Initial password (for brute-force) or path to dictionary file (for dictionary mode).
# For brute-force: cracking starts from this password.
# For dictionary: the path to the wordlist file.
# Default: empty
{% if init_password | default('') | trim != '' %}
--init-password {{ init_password | default('') }}
{% endif %}

# Password length range for brute-force mode.
# Examples: '4-8' (lengths 4 through 8), '6' (exactly length 6).
# If empty, fcrackzip checks all lengths up to a limit (usually 10-12).
{% if length | default('') | trim != '' %}
--length {{ length | default('') }}
{% endif %}

# Use external 'unzip' command to verify if a candidate password is correct.
# This can be slower but more reliable for some file types.
# Default: false
{% if use_unzip | default(false) %}
--use-unzip
{% endif %}

# Cracking method name or number.
# Examples: 'cpmask', '2'.
# Empty string uses the library's default method.
# Default: empty
{% if method | default('') | trim != '' %}
--method {{ method | default('') }}
{% endif %}

# Modulo partition (e.g., '1/3') for distributed cracking.
# NOTE: This feature may not be fully supported in all fcrackzip versions.
# Default: empty
{% if modulo | default('') | trim != '' %}
--modulo {{ modulo | default('') }}
{% endif %}

# Benchmark mode: runs a performance test to estimate cracking speed.
# Not meaningful in an operational configuration context, but allowed.
# Default: false
{% if benchmark | default(false) %}
--benchmark
{% endif %}

# Validation mode: runs self-validation checks on the tool/environment.
# Default: false
{% if validate | default(false) %}
--validate
{% endif %}

# Verbose level.
# Each '-v' flag increases verbosity.
# 0 = quiet, 1 = normal, 2+ = verbose.
# Generates the specified number of '-v' flags.
{% for i in range(verbose | default(0) | int) %}-v{% endfor %}