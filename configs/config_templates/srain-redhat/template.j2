# Srain built-in configuration file
# Application configuration.
# This configuration file is managed by Ansible. Do not edit manually.

# Configuration file version string
version = "{{ version | default('1.0.0rc5') }}"

# UI Theme name
# Available values: default, default-bubble, etc.
theme = "{{ theme | default('default-bubble') }}"

# Enable Client-Side Decoration
# Bool; true to enable, false to disable
csd = {{ csd | default('true                  # Bool; Whether enable Client-Side Decoration') }}

# Send message on CTRL+Enter
# Bool; true to enable, false to disable
send-on-ctrl-enter = {{ send_on_ctrl_enter | default('false  # Bool; Send messsage on CTRL+Enter pressed') }}

# Exit program on main window closed
# Bool; true to enable, false to disable
exit-on-close = {{ exit_on_close | default('false       # Bool; Exit program on main window closed') }}

# Auto-connect servers after startup
# String array; List of server names to auto-connect to
auto-connect = []

# Whether the server buffer is visible
# Bool; true to show server buffer, false to hide
server-visibility = {{ server_visibility | default('true    # Bool; Whether the server buffer is visible') }}

# Logging configuration
# If you want to report/fix a bug, terminal log will be helpful.
log =
{
    # Colorful log output
    # Bool; true to enable colored logs, false to disable
    prompt-color = {{ log_prompt_color | default('true     # Bool; Colorful output') }}

    # Display filename in log
    # Bool; true to show filename in log statements, false to hide
    prompt-file = {{ log_prompt_file | default('false     # Bool; Display the filename of the file which log') }}

    # Display function name in log
    # Bool; true to show function name in log statements, false to hide
    prompt-function = {{ log_prompt_function | default('true  # Bool; As aboved, function name') }}

    # Display line number in log
    # Bool; true to show line number in log statements, false to hide
    prompt-line = {{ log_prompt_line | default('false     # Bool; As aboved, line number') }}

    # String array; Specify the log level of a group of files
    debug-targets   = []
    info-targets    = []
    warn-targets    = [""]
    error-targets   = []
}

# Global IRC Server configuration
# This group can also appear in server-list for per-server overrides.
server =
{
    # Auto-join chats after server is created
    # String array; List of channel names to auto-join
    auto-join = []

    # Auto-run commands after server is created
    # String array; List of commands to execute
    auto-run = []

    # User identity configuration
    user =
    {
        # Default IRC nickname
        nickname = "{{ user_nickname | default('SrainUser') }}"

        # Default IRC username
        username = "{{ user_username | default('Srain') }}"

        # Default IRC realname
        realname = "{{ user_realname | default('Can you can a can?') }}"

        # Login method configuration
        login:
        {
            # Login method
            # String; Available values:
            # - none: No login method, default value
            # - nickserv: Login with NICKSERV command
            # - msg-nickserv: Login with /msg NickServ identify
            # - sasl-plain: Login with SASL PLAIN mechanism
            # - sasl-ecdsa: Login with SASL ECDSA-NIST256P-CHALLENGE mechanism
            # - sasl-external: Login with SASL EXTERNAL mechanism
            method = "{{ user_login_method | default('none') }}"

            # Path to login ECDSA certificate file (for sasl-ecdsa only)
            # certificate = ""
        }

        # Default messages for performing specified actions
        # Message sent when leaving a channel
        part-message = "{{ user_part_message | default('Leaving.') }}"

        # Message sent when kicking a user
        kick-message = "{{ user_kick_message | default('Kick.') }}"

        # Message sent when setting away status
        away-message = "{{ user_away_message | default('Away from keyboard.') }}"

        # Message sent when quitting the server/network
        quit-message = "{{ user_quit_message | default('El Psy Congroo.') }}"
    }

    # Chat configuration
    # This group can also appear in chat-list for per-chat overrides.
    chat =
    {
        # Persistent chat log to storage
        # Bool; true to enable logging, false to disable
        log = {{ chat_log | default('true                      # Bool; Persistent chat log to storage') }}

        # Send notification on mention or ERROR
        # Bool; true to enable notifications, false to disable
        notify = {{ chat_notify | default('true                   # Bool; Send notification when you are') }}

        # Send notification on any PRIVMSG/ACTION/NOTIFY/ERROR
        # Bool; true to enable all notifications, false to disable
        notify-all = {{ chat_notify_all | default('true               # Bool; Send notification when receiving') }}

        # Show topic
        # Bool; true to display channel topic, false to hide
        show-topic = {{ chat_show_topic | default('true               # Bool; Show topic') }}

        # Show user avatars
        # Bool; true to display avatars, false to hide
        show-avatar = {{ chat_show_avatar | default('false             # Bool; Show user avater') }}

        # Show user list
        # Bool; true to display user list, false to hide
        show-user-list = {{ chat_show_user_list | default('true           # Bool; Show user list') }}

        # Render mIRC colors
        # Bool; true to render mIRC color codes, false to disable
        render-mirc-color = {{ chat_render_mirc_color | default('true        # Bool; Render mirc color') }}

        # Suffix for completed nickname
        # String; e.g. ":" results in "nick: msg"
        nick-completion-suffix = "{{ chat_nick_completion_suffix | default(':') }}"

        # Show previewer for every URL
        # Bool; true to show URL previews, false to disable
        preview-url = {{ chat_preview_url | default('true          # Bool; Show previewer for every URL') }}

        # Automatically preview supported URLs
        # Bool; true to auto-preview, false to require click
        auto-preview-url = {{ chat_auto_preview_url | default('true     # Bool; Automatically preview supported URL') }}

        # Auto-run commands after chat is created
        # String array; List of commands to execute
        auto-run = []
    }

    # Specified chat configuration
    # Every element in list should have a unique ``name``.
    chat-list =
    (
        {
            # Chat name (must be unique)
            # Necessary for a ``chat`` group in ``chat-list``.
            name = "{{ chat_list_name | default('#srain') }}"

            # Show topic in default chat
            # Bool; true to display topic, false to hide
            show-topic = {{ chat_list_show_topic | default('true') }}
        }
    )
}

