# faifa(8) configuration — HomePlug AV management tool
# Each parameter is passed directly to the faifa binary via command-line flags.
# This template generates the command-line invocation arguments.

# Network interface to use (e.g., eth0)
# Default: '' (empty, meaning faifa picks default or requires explicit selection)
-i {{ interface | default('') }}

# Show interactive menu of known MM types
# Default: False
{% if menu | default(False) %}-m{% endif %}

# Destination MAC address to send frames to (e.g., 00:11:22:33:44:55)
# Default: '' (empty)
-a {{ destination_mac | default('') }}

# Network encryption key to set (128-bit hex string, 32 hex chars)
# Default: '' (empty)
-k {{ network_key | default('') }}

# Enable verbose output (increase verbosity)
# Default: False
{% if verbose | default(False) %}-v{% endif %}

# Error stream target (e.g., /dev/stderr, /var/log/faifa.err)
# Default: 'stderr'
-e {{ error_stream | default('stderr') }}

# Output stream target (e.g., /dev/stdout, /tmp/faifa.out)
# Default: 'stdout'
-o {{ output_stream | default('stdout') }}

# Input stream source (e.g., /dev/stdin, /etc/faifa/inputs.conf)
# Default: 'stdin'
-s {{ input_stream | default('stdin') }}