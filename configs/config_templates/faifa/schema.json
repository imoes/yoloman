{
  "interface": {
    "type": "string",
    "default": "",
    "description": "Network interface to use (e.g., eth0)"
  },
  "menu": {
    "type": "bool",
    "default": false,
    "description": "Show interactive menu of known MM types"
  },
  "destination_mac": {
    "type": "string",
    "default": "",
    "description": "Destination MAC address to send frames to (e.g., 00:11:22:33:44:55)"
  },
  "network_key": {
    "type": "string",
    "default": "",
    "description": "Network encryption key to set (128-bit hex string, 32 hex chars)"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output (increase verbosity)"
  },
  "error_stream": {
    "type": "string",
    "default": "stderr",
    "description": "Error stream target (e.g., /dev/stderr, /var/log/faifa.err)"
  },
  "output_stream": {
    "type": "string",
    "default": "stdout",
    "description": "Output stream target (e.g., /dev/stdout, /tmp/faifa.out)"
  },
  "input_stream": {
    "type": "string",
    "default": "stdin",
    "description": "Input stream source (e.g., /dev/stdin, /etc/faifa/inputs.conf)"
  }
}
