# Ansible managed template for phoronix-test-suite shell completions on Red Hat systems.
# This script provides command-line tab completion for the phoronix-test-suite CLI tool.
# It is installed in /etc/bash_completion.d/ to be sourced by interactive shells.

# Install the completion function for the phoronix-test-suite command.
# The function _phoronix_test_suite_show is registered as the completion handler.
complete -F _phoronix_test_suite_show phoronix-test-suite
