# Character encoding for Groonga.
# Defaults to 'utf-8' if not specified in the inventory.
encoding = {{ encoding | default('utf-8') }}

# Logging level: 0=quiet, 1=normal, 2=verbose.
# Defaults to 1 (normal) if not specified.
log-level = {{ log_level | default(1) }}

# IP address to bind the server to.
# Defaults to '0.0.0.0' (all interfaces) if not specified.
bind-address = {{ bind_address | default('0.0.0.0') }}

# Port number to listen for incoming connections.
# Defaults to 10041 if not specified.
port = {{ port | default(10041) }}

# Unique server identifier, typically the hostname.
# Defaults to 'groonga.example.com' if not specified.
server-id = {{ server_id | default('groonga.example.com') }}

# Maximum number of worker threads the server will spawn.
# Defaults to 2 if not specified.
max-threads = {{ max_threads | default(2) }}

# Path to the Groonga administrative HTML interface files.
# Defaults to '/usr/share/groonga/html/admin' if not specified.
admin-html-path = {{ admin_html_path | default('/usr/share/groonga/html/admin') }}

# Protocol used for communication (e.g., http, https).
# Defaults to 'http' if not specified.
protocol = {{ protocol | default('http') }}

# Path to the main Groonga log file.
# Defaults to '/var/log/groonga/groonga.log' if not specified.
log-path = {{ log_path | default('/var/log/groonga/groonga.log') }}

# Path to the Groonga query log file for debugging/auditing.
# Defaults to '/var/log/groonga/query.log' if not specified.
query-log-path = {{ query_log_path | default('/var/log/groonga/query.log') }}

# Maximum cache size in megabytes.
# Defaults to 100 MB if not specified.
cache-limit = {{ cache_limit | default(100) }}