{
  "encoding": {
    "type": "string",
    "default": "utf-8",
    "description": "Character encoding for Groonga"
  },
  "log_level": {
    "type": "number",
    "default": 1,
    "description": "Logging level (0=quiet, 1=normal, 2=verbose)"
  },
  "bind_address": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "IP address to bind to"
  },
  "port": {
    "type": "number",
    "default": 10041,
    "description": "Port to listen on"
  },
  "server_id": {
    "type": "string",
    "default": "groonga.example.com",
    "description": "Unique server identifier (typically hostname)"
  },
  "max_threads": {
    "type": "number",
    "default": 2,
    "description": "Maximum number of worker threads"
  },
  "admin_html_path": {
    "type": "string",
    "default": "/usr/share/groonga/html/admin",
    "description": "Path to Groonga admin HTML files"
  },
  "protocol": {
    "type": "string",
    "default": "http",
    "description": "Protocol to use (e.g., http, https)",
    "enum": [
      "http",
      "https"
    ],
    "enum_open": true
  },
  "log_path": {
    "type": "string",
    "default": "/var/log/groonga/groonga.log",
    "description": "Path to main log file"
  },
  "query_log_path": {
    "type": "string",
    "default": "/var/log/groonga/query.log",
    "description": "Path to query log file"
  },
  "cache_limit": {
    "type": "number",
    "default": 100,
    "description": "Maximum cache size in MB"
  }
}
