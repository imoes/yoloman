{
 "allow_root_scripts": false,
 "event_filter": {
  "carrier": true,
  "dhcp": true,
  "dns": false,
  "down": true,
  "route": true,
  "up": true
 },
 "excluded_interfaces_regex": [
  "^docker",
  "^veth"
 ],
 "extra_env_vars": [
  "ENV=production",
  "LOGTAG=networkd-dispatcher"
 ],
 "fail_on_script_error": false,
 "log_dir": "/var/log/networkd-dispatcher",
 "log_level": "INFO",
 "log_to_file": false,
 "log_to_journal": true,
 "log_to_stdout": false,
 "monitored_interfaces": [],
 "run_dispatcher": true,
 "runtime_dir": "/run/networkd-dispatcher",
 "script_dirs": [
  "/etc/networkd-dispatcher",
  "/usr/lib/networkd-dispatcher"
 ],
 "script_timeout": 20
}
