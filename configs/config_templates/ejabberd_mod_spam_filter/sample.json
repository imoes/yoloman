{
  "modules_list": true,
  "spam_filter": {
    "enabled": true,
    "ignore_jids": [
      "admin@internal.example.com",
      "bot@example.com"
    ],
    "block_from_jids": [
      "spam@example.net"
    ],
    "block_content_substrings": [
      "viagra",
      "casino",
      "lottery"
    ],
    "max_message_size": 51200,
    "max_recipients": 20,
    "log_blocked": true,
    "block_content_regexes": [
      "^[0-9]{5}-[0-9]{5}.*$"
    ],
    "user_thresholds": [
      {
        "user": "user1@example.com",
        "score_threshold": 3
      }
    ],
    "score_threshold": 5,
    "warning_threshold": 2
  }
}
