{
 "modules_list": true,
 "spam_filter": {
  "block_content_regexes": [
   "^[0-9]{5}-[0-9]{5}.*$"
  ],
  "block_content_substrings": [
   "viagra",
   "casino",
   "lottery"
  ],
  "block_from_jids": [
   "spam@example.net"
  ],
  "enabled": true,
  "ignore_jids": [
   "admin@internal.example.com",
   "bot@example.com"
  ],
  "log_blocked": true,
  "max_message_size": 51200,
  "max_recipients": 20,
  "score_threshold": 5,
  "user_thresholds": [
   {
    "score_threshold": 3,
    "user": "user1@example.com"
   }
  ],
  "warning_threshold": 2
 }
}
