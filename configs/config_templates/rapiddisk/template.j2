# Set standard system PATH to ensure commands like sed, echo, grep are found.
PATH=/bin:/sbin:/usr/bin:/usr/sbin

export PATH

# Directory containing OCF (Open Cluster Framework) shell functions.
# OCF_RESKEY_ocf_functions_dir is preferred if provided by the cluster manager,
# otherwise falls back to the schema default.
: ${OCF_FUNCTIONS_DIR=${OCF_RESKEY_ocf_functions_dir | default('/usr/lib/ocf/lib/heartbeat')}}
. ${OCF_FUNCTIONS_DIR}/ocf-shellfuncs

# Path to the rapiddisk binary executable.
# OCF_RESKEY_rapiddisk_bin is preferred if provided, otherwise uses the schema default.
RDSK_bin="${OCF_RESKEY_rapiddisk_bin | default('/sbin/rapiddisk')}"

#######################################################################

metadata()
{
        cat <<END
<?xml version="1.0"?>
<!DOCTYPE resource-agent SYSTEM "ra-api-1.dtd">
<resource-agent name="rapiddisk.sh" version="1.1">
<version>1.1</version>

<longdesc lang="en">
This defines a standard RapidDisk HA failover.
</longdesc>

<shortdesc lang="en">
Defines a standard RapidDisk HA failover.
</shortdesc>

<parameters>
<parameter name="name" unique="1" required="1">
<longdesc lang="en">
This is the name of the resource rule.
</longdesc>
<shortdesc lang="en">Name</shortdesc>
<content type="string"/>
</parameter>

<parameter name="volume" unique="1" required="1">
<longdesc lang="en">
This is the absolute path of the storage device to map with RapidDisk-Cache.
</longdesc>
<shortdesc lang="en">Path of storage device for RapidDisk-Cache.</shortdesc>
<content type="string"/>
</parameter>

<parameter name="size" unique="1" required="1">
<longdesc lang="en">
This is the size of the RapidDisk (and cache for RapidDisk-Cache) volume.
</longdesc>
<shortdesc lang="en">
RapidDisk size.
</longdesc>
<content type="string"/>
</parameter>

<parameter name="mode" unique="1" required="0">
<longdesc lang="en">
This caching mode: Write-Through (wt) or Write-Around (wa).
</longdesc>
<shortdesc lang="en">
Caching mode: wt or wa.
</longdesc>
<content type="string"/>
</parameter>
</parameters>

<actions>
<action name="start" timeout="300"/>
<action name="stop" timeout="30"/>
<action name="status" depth="10" timeout="20" interval="30"/>
<action name="monitor" depth="10" timeout="20" interval="30"/>
<action name="meta-data" timeout="5"/>
<action name="validate-all" timeout="5"/>
</actions>
</resource-agent>
END

        exit $OCF_SUCCESS
}


verify_all()
{
	# Validate that the service name is provided.
	if [ -z "$OCF_RESKEY_name" ]; then
		ocf_log err "Invalid Name Of Service: $OCF_RESKEY_name"
		return $OCF_ERR_ARGS
	fi

	# Validate that the storage volume path is provided.
	if [ -z "$OCF_RESKEY_volume" ]; then
		ocf_log err "Invalid Name Of Volume: $OCF_RESKEY_volume"
		return $OCF_ERR_ARGS
	fi

        # Validate that the RapidDisk volume size is provided.
        if [ -z "$OCF_RESKEY_size" ]; then
		ocf_log err "Invalid Size Of RapidDisk Volume: $OCF_RESKEY_size"
                return $OCF_ERR_ARGS
        fi

	return $OCF_SUCCESS
}


do_start()
{
	verify_all || exit $?

	# Check if the resource is already running to avoid duplicate starts.
	if do_status; then
		ocf_log info "Starting Service $OCF_RESOURCE_INSTANCE > Already running"
		return $OCF_SUCCESS
	fi

        # Determine caching mode: prefer OCF parameter, fallback to schema default.
        if [ -z "$OCF_RESKEY_mode" ]; then
                mode="{{default_mode | default('wt')}}"
        else
                mode=$OCF_RESKEY_mode
        fi

	# Attach the RapidDisk volume.
	output=`$RDSK_bin --attach $OCF_RESKEY_size`
	if [ $? -ne 0 ]; then
		ocf_log info "Unable to create a RapidDisk volume of $OCF_RESKEY_size MB"
		return $OCF_ERR_GENERIC
	fi
	volume="$OCF_RESKEY_volume"
	# Extract the device name from the output (expecting something like 'rd0 ...').
	rdsk=`echo $output|sed -e 's/^.*rd/rd/' -e 's/ .*$//'`
	# Map the cache with the specified mode and volume path.
	$RDSK_bin --cache-map $rdsk $volume $mode

        return $OCF_SUCCESS
}


do_stop()
{
	verify_all || exit $?

        # Determine caching mode for stop operation consistency.
        if [ -z "$OCF_RESKEY_mode" ]; then
                mode="{{default_mode | default('wt')}}"
        else
                mode=$OCF_RESKEY_mode
        fi

	# Construct the cache name based on mode and volume path.
	cache="rc-${mode}_`echo $OCF_RESKEY_volume|rev|cut -d'/' -f1|rev`"
	# Verify the cache exists before unmapping.
	output=`$RDSK_bin --short-list|grep "$cache:"`
	# Unmap the cache.
	$RDSK_bin --cache-unmap $cache
	# Detach the underlying RapidDisk volume.
	$RDSK_bin --detach `echo "$output"|sed -e 's/^rc.*://' -e 's/,.*$//'`

        return $OCF_SUCCESS
}


do_status()
{
	verify_all || exit $?

        # Determine caching mode for status check consistency.
        if [ -z "$OCF_RESKEY_mode" ]; then
                mode="{{default_mode | default('wt')}}"
        else
                mode=$OCF_RESKEY_mode
        fi

	# Normalize the volume path for mapper device checking.
	volume=`echo $OCF_RESKEY_volume|rev|cut -d'/' -f1|rev`
	# Check if the mapped device exists in /dev/mapper.
	if [ -e "/dev/mapper/rc-${mode}_$volume" ]; then
		return $OCF_SUCCESS
	fi
	ocf_log debug "RapidDisk resource for $OCF_RESKEY_volume is not running."
	return $OCF_NOT_RUNNING
}


#
#

# case $1 in
	validate-all|verify-all)
		verify_all
		exit $?
		;;
	start)
		do_start
		exit $?
		;;
	stop)
		do_stop
		exit $?
		;;
	restart)
		do_stop
		do_start
		exit $?
		;;
	status|monitor)
		do_status
		exit $?
		;;
	meta-data)
		metadata
		exit 0
		;;
	*)
		echo "usage: $0 {start|stop|restart|status|meta-data|validate-all}"
		exit $OCF_ERR_UNIMPLEMENTED
		;;
esac