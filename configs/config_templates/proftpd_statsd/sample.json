{
  "statsd_host": "statsd.internal.example.com",
  "statsd_port": 8125,
  "statsd_prefix": "proftpd.prod",
  "statsd_transport": "udp",
  "statsd_flush_interval": 500,
  "statsd_debug": true,
  "enabled_metrics": [
    "session.count",
    "session.duration",
    "auth.success",
    "auth.failure"
  ],
  "statsd_tags": {
    "environment": "production",
    "host": "ftp01"
  },
  "histogram_buckets": [
    0.001,
    0.005,
    0.01,
    0.05,
    0.1,
    0.5,
    1.0
  ]
}
