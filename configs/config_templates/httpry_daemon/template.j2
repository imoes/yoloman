# httpry daemon configuration
# Enable packet capture mode (must run with root/cap_net_raw)
# Set the network interface to capture from
interface: {{ interface }}

# Set the log directory for captured data
log_dir: {{ log_dir }}

# Enable verbose logging
verbose: {{ verbose }}

# Enable debug mode (implies verbose)
debug: {{ debug }}

# Set the maximum number of concurrent connections to track
max_connections: {{ max_connections }}

# Set the timeout (seconds) for idle connections
timeout: {{ timeout }}

# Hostnames to exclude from logging (one per line)
{% for host in exclude_hosts %}
exclude_host: {{ host }}
{% endfor %}

# Enable/Disable logging of HTTP requests
log_requests: {{ log_requests }}

# Enable/Disable logging of HTTP responses
log_responses: {{ log_responses }}

# Enable/Disable logging of HTTP headers
log_headers: {{ log_headers }}

# Enable/Disable logging of HTTP bodies
log_bodies: {{ log_bodies }}

# Enable/Disable logging of HTTP cookies
log_cookies: {{ log_cookies }}

# Enable/Disable logging of user agents
log_user_agents: {{ log_user_agents }}

# Enable/Disable logging of referer headers
log_referer: {{ log_referer }}

# Enable/Disable logging of cookies in plaintext (insecure if sensitive cookies present)
plaintext_cookies: {{ plaintext_cookies }}

# Set the user to drop privileges to (must exist)
user: {{ user }}

# Set the group to drop privileges to (must exist)
group: {{ group }}

# Enable/Disable background daemonization
daemonize: {{ daemonize }}

# Path to PID file
pid_file: {{ pid_file }}
