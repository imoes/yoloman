{
  "interface": "eth0",
  "log_dir": "/var/log/httpry",
  "verbose": true,
  "debug": false,
  "max_connections": 5000,
  "timeout": 600,
  "exclude_hosts": [
    "localhost",
    "127.0.0.1"
  ],
  "log_requests": true,
  "log_responses": true,
  "log_headers": true,
  "log_bodies": false,
  "log_cookies": true,
  "log_user_agents": true,
  "log_referer": true,
  "plaintext_cookies": false,
  "user": "httpry",
  "group": "httpry",
  "daemonize": true,
  "pid_file": "/run/httpry/httpry.pid"
}
