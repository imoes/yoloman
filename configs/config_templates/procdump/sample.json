{
  "count": 3,
  "poll_interval": 5,
  "cpu_threshold": 20,
  "cpu_relative_single_core": false,
  "memory_threshold": null,
  "dump_type": "full",
  "overwrite_existing": true,
  "log_traces": false,
  "wait_for_process": true,
  "filters": [
    "NotFound",
    "OutOfMemory"
  ],
  "exception_handling": false,
  "dump_target": "notepad",
  "dump_path": "/var/log/dumps/notepad.dmp"
}
