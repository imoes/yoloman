# Auto-mount master map - mounts directories on-demand when accessed
# Format: mount_point map_file [options]
{% for mount in mounts %}{{ mount.point }} {{ mount.map }}{% if mount.options %} {{ mount.options | join(', ') }}{% endif %}
{% endfor %}
# The special map '-' enables indirect mounts via /etc/auto.misc
# Uncomment the next line to enable indirect mounts under /misc
{% if enable_misc %}- /etc/auto.misc
{% endif %}
