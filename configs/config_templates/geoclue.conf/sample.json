{
  "enable": true,
  "network_provider": true,
  "gps_provider": false,
  "geoip_provider": true,
  "time_server": "time.google.com",
  "min_time_between_updates": 10,
  "min_distance_between_updates": 25,
  "max_cache_age": 60,
  "allowed_apps": [
    "gnome-maps",
    "firefox",
    "signal-desktop"
  ],
  "log_level": 2,
  "log_domains": "network,gpsd",
  "log_destination": "/var/log/geoclue.log",
  "log_uptime_format": "iso8601"
}
