# Hesiod client configuration (hesiod.conf)
# Format: key = value, one directive per line
# Comment lines begin with '#'

# List of configuration directives for hesiod.conf.
# Each item specifies a key-value pair and an optional comment for clarity.
# Keys must match
{% for item in (hesiod_config | default([])) %}
{% if item.comment is defined %}
# {{ item.comment | default('') }}
{% endif %}
{{ item.key | default('') }} = {{ item.value | default('') }}
{% endfor %}