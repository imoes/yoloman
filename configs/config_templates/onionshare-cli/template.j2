# OnionShare CLI Configuration
# This file corresponds to the --config FILENAME option.
# It is a JSON file containing global settings for OnionShare.
# This template is self-documenting: each JSON key is preceded by
# a comment derived from the Ansible role's schema definition.

{
  # Seconds to wait for Tor connection before giving up.
  # Default: 120
  "connect_timeout": {{ connect_timeout | default(120) }},

  # Directory where received files are saved.
  # Default: '~/.local/share/onionshare'
  "data_dir": "{{ data_dir | default('~/.local/share/onionshare') }}",

  # URL to send webhook notifications when files are received.
  # Default: ''
  "webhook_url": "{{ webhook_url | default('') }}",

  # Disable receiving text messages in receive mode.
  # Default: false
  "disable_text": {{ disable_text | default(false) }},

  # Disable receiving files in receive mode.
  # Default: false
  "disable_files": {{ disable_files | default(false) }},

  # Disable the default Content Security Policy header in website mode.
  # Default: false
  "disable_csp": {{ disable_csp | default(false) }},

  # Custom Content Security Policy header string for website mode.
  # Default: ''
  "custom_csp": "{{ custom_csp | default('') }}",

  # Title for the OnionShare session.
  # Default: ''
  "title": "{{ title | default('') }}",

  # Keep sharing active even after files are downloaded.
  # Default: false
  "no_autostop_sharing": {{ no_autostop_sharing | default(false) }},

  # Enable public mode (no private key).
  # Default: false
  "public": {{ public | default(false) }},

  # Delay in seconds before starting the onion service.
  # Default: 0
  "auto_start_timer": {{ auto_start_timer | default(0) }},

  # Delay in seconds before stopping the onion service.
  # Default: 0
  "auto_stop_timer": {{ auto_stop_timer | default(0) }},

  # Disable Tor usage (development only).
  # Default: false
  "local_only": {{ local_only | default(false) }}
}