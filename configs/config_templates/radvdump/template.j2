# radvdump configuration file
# This template generates a configuration for radvdump, a tool used to
# dump and analyze Router Advertisement packets from radvd (IPv6 Router
# Discovery Daemon) and generate configuration snippets.

# Debug level: 1-4 for verbose output, 0 for quiet. Corresponds to -d/--debug.
DEBUG_LEVEL: {{ debug_level | default(0) }}

# Exclude default valued options from configuration file format.
# Corresponds to -e/--exclude-defaults option.
EXCLUDE_DEFAULTS: {{ exclude_defaults | default(False) }}

# Output received router advertisements in the format of the radvd configuration file.
# Corresponds to -f/--file-format option.
FILE_FORMAT: {{ file_format | default(True) }}