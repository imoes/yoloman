# firewall-applet configuration
#
# This template generates the configuration file for the system firewall applet.
# It controls visual and notification behaviors of the firewall indicator in the desktop environment.
#
# Variables used:
#   notifications : Enable or disable status change notifications
#   show_inactive : Include inactive connections in the view
#   blink         : Enable icon blinking on status changes
#   blink_count   : Number of blinks when status changes
#   shields_up    : Action/state name when firewall is active
#   shields_down  : Action/state name when firewall is inactive

[General]

# notifications: default=False
# Whether to show notifications when firewall status changes.
notifications={{ notifications | default(False) | ternary('true', 'false') }}

# show_inactive: default=False
# Whether to show inactive firewall connections in the applet.
show-inactive={{ show_inactive | default(False) | ternary('true', 'false') }}

# blink: default=False
# Whether to blink the applet icon on status change.
blink={{ blink | default(False) | ternary('true', 'false') }}

# blink_count: default=5
# Number of times to blink the icon on status change.
blink-count={{ blink_count | default(5) }}

# shields_up: default='block'
# Action to take when firewall is active (e.g., block, allow).
shields-up={{ shields_up | default('block') }}

# shields_down: default='public'
# Action to take when firewall is inactive (e.g., public, private).
shields-down={{ shields_down | default('public') }}