{
  "listen_address": "::",
  "listen_port": 53,
  "zone_dir": "/var/lib/all-knowing-dns/zonefiles",
  "max_connections": 512,
  "log_level": 2,
  "query_log_file": "",
  "stats_enabled": true,
  "stats_host": "127.0.0.1",
  "zone_refresh_interval": 600,
  "neg_ttl": 300,
  "upstream_servers": [
    {
      "network": "2001:db8::/32",
      "target": "[2001:db8::1]:53"
    },
    {
      "network": "2001:470::/32",
      "target": "192.0.2.53"
    }
  ],
  "allowed_clients": [
    "2001:db8:abcd::/48",
    "fe80::/10"
  ],
  "dnssec_enabled": false,
  "edns_padding": 128
}
