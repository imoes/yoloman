# ~/.notmuch-config — Notmuch mail indexer configuration file
# This file is managed by Ansible. Do not edit manually.
# It defines how Notmuch indexes local mail and identifies the user.

[general]
# Top-level directory containing your mail (e.g., Maildir). Notmuch will recursively index it.
path = {{ config_path | default('~/Mail') }}

# Primary email address. Used to identify messages sent or received by you during threading.
primary_email = {{ primary_email | default('user@example.com') }}

[user]
# Your real name (optional, used in some UI contexts and email headers).
name = {{ user_name | default('') }}