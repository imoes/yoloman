# ~/.notmuch-config — Notmuch mail indexer configuration
# User identity fields used for threading and header normalization
[general]
# Full path to your mail directory (must be a Maildir or same structure)
path = {{ config_path }}

# Primary email address (used to identify user's messages)
primary_email = {{ primary_email }}

# Additional email addresses (comma-separated list)
# Used to improve threading by recognizing other addresses owned by user
# other_email = {{ other_emails | join(', ') }}

# List of email aliases (comma-separated)
# Aliases are alternative identities used by the user (e.g., work vs personal)
# aliases = {{ aliases | join(', ') }}

# Date format for output (Python strftime format)
# date_directory_format = {{ date_directory_format }}

# Whether to preserve file timestamps when processing mail (true/false)
# preserve_file_timestamps = {{ preserve_file_timestamps | string | lower }}

# Tag prefix for user-specific tags (e.g., 'user_' to disambiguate from system tags)
# user_tag_prefix = {{ user_tag_prefix }}

# Tag to apply to new messages before applying tags from hooks
# new_tags = {{ new_tags | join(', ') }}

# Tag to apply when moving messages to trash (if configured via hooks)
# trash_folder = {{ trash_folder }}

# Tags to remove when moving messages to trash
# remove_tags = {{ trash_remove_tags | join(', ') }}

# List of tag patterns (regex) to exclude from searches
# exclude_tags = {{ exclude_tags | join(',') }}

# Indexing depth for Maildir structure (0 = no subdirs, 1 = one level deep, etc.)
# maildir_sync = {{ maildir_sync | string | lower }}

[search]
# Default limit on number of results shown
# default_limit = {{ search_default_limit }}

# Sort order for search results (oldest_first, newest_first, date, from, subject)
# default_sort = {{ search_default_sort }}

[maildir]
# Whether to sync maildir flags with notmuch tags
# sync_flags = {{ maildir_sync_flags | string | lower }}

[database]
# Path to notmuch database directory (defaults to path/.notmuch)
# path = {{ db_path }}

# Path to legacy database (if migrating from older versions)
# legacy_database_path = {{ legacy_db_path }}

[user]
# Real name of the user
# name = {{ user_name }}

[git]
# Whether to write git commit messages on database changes
# enabled = {{ git_enabled | string | lower }}

# Commit message template
# commit_template = {{ git_commit_template }}
