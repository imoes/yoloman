# Globus GRAM Job Manager LSF Setup Seg Configuration
# This file defines the command line invocation for the Globus Job Manager
# when configured to use the LSF SEG (Submission Event Gateway) module.
#
# The format is a single directive line containing the log destination,
# credential source, executable path, and startup parameters.

# Log destination and credential source:
# stderr_log: Send logs to standard error (useful for debugging or systemd journal).
# local_cred: Use local credentials (no network authentication required for this setup stage).
stderr_log,local_cred - {{ sbin_path | default('/usr/sbin') }}/{{ binary_name | default('globus-job-manager') }} {{ binary_name | default('globus-job-manager') }} -conf {{ conf_file | default('/etc/globus/globus-gram-job-manager.conf') }} -type {{ job_manager_type | default('lsf') }} -seg-module {{ seg_module | default('lsf') }}