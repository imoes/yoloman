# xdg-user-dirs configuration
# Sets default paths for user directories (Documents, Desktop, etc.)
[xdg_user_dirs]

# Enable/Disable custom directory names
{{ enable_custom_names | lower }}

# Default directory names (can be overridden per-user)
{% for item in dirs %}
# {{ item.description }}
{{ item.name | upper | replace(' ', '_') }}="{{ item.path }}"
{% endfor %}

# Optional fallback to XDG user dirs if custom names disabled
FALLBACK_DIR="{{ fallback_dir }}"

# Locale-aware directory names (e.g., ~/Documents instead of ~/Dokumente)
LOCALE_AWARE={{ locale_aware | lower }}