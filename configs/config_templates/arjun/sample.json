{
  "url": "https://api.example.com/v1/userinfo",
  "json_output": "/var/log/arjun/results.json",
  "threads": 10,
  "method": "POST",
  "delay": 0.2,
  "headers": [
    "Authorization: Bearer ${TOKEN}",
    "X-Client-ID: arjun-scanner",
    "User-Agent: Arjun/2.2.7"
  ],
  "timeout": 20,
  "chunks": 50,
  "include_data": "{\"userId\": \"test\"}",
  "burp_port": 8080
}
