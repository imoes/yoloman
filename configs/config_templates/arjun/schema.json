{
  "url": {
    "type": "string",
    "default": "",
    "description": "Target URL to scan for HTTP parameters (required)."
  },
  "json_output": {
    "type": "string",
    "default": "",
    "description": "Path for JSON output file."
  },
  "text_output": {
    "type": "string",
    "default": "",
    "description": "Path for text output file."
  },
  "burp_port": {
    "type": "number",
    "default": 8080,
    "description": "Port for Burp Suite Proxy output. Set to null to disable."
  },
  "delay": {
    "type": "number",
    "default": 0,
    "description": "Delay between requests in seconds."
  },
  "threads": {
    "type": "number",
    "default": 5,
    "description": "Number of concurrent threads."
  },
  "wordlist": {
    "type": "string",
    "default": "/usr/lib/python3/dist-packages/arjun/db/large.txt",
    "description": "Path to custom wordlist file."
  },
  "method": {
    "type": "string",
    "default": "GET",
    "description": "Request method: GET, POST, XML, JSON, or HEADERS.",
    "enum": [
      "GET",
      "POST",
      "XML",
      "JSON",
      "HEADERS"
    ]
  },
  "import_file": {
    "type": "string",
    "default": "",
    "description": "Path to file containing target URLs."
  },
  "timeout": {
    "type": "number",
    "default": 15,
    "description": "HTTP request timeout in seconds."
  },
  "chunks": {
    "type": "number",
    "default": 100,
    "description": "Chunk size (number of parameters sent at once)."
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Enable quiet mode (suppress output)."
  },
  "headers": {
    "type": "list",
    "default": [],
    "description": "List of custom HTTP headers to include in every request (one header per item)."
  },
  "passive": {
    "type": "bool",
    "default": false,
    "description": "Collect parameters from passive sources (Wayback, CommonCrawl, OTX)."
  },
  "stable": {
    "type": "bool",
    "default": false,
    "description": "Prefer stability over speed."
  },
  "include_data": {
    "type": "string",
    "default": "",
    "description": "Additional data to include in every request (e.g., POST body or JSON payload)."
  },
  "disable_redirects": {
    "type": "bool",
    "default": false,
    "description": "Disable HTTP redirects."
  }
}
