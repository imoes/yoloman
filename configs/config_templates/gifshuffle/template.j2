{# gifshuffle configuration #}
# Header comment for generated config file
{{ config_header | default('# gifshuffle configuration generated by system') }}

# Mode of operation: 'conceal' or 'extract'
{{ mode | default('conceal') }}

# Optional message input (if concealing)
# Set to true if concealing a message; false if extracting
{% if conceal_message | default(False) %}
# Message to conceal
# The message string to conceal, if provided directly via -m
{% if message_string | default('') != '' %}-m {{ message_string | default('') }}
{% endif %}
# Path to file containing message to conceal, if provided via -f
{% if message_file | default('') != '' %}-f {{ message_file | default('') }}
{% endif %}
{% endif %}

# Optional extraction output
# Set to true if extracting a message (same as mode=extract)
{% if extract_message | default(False) %}
# Extract hidden message
{% endif %}

# Compression
# Enable Huffman compression during concealment or decompression during extraction
{% if compress | default(False) %}-C
{% endif %}

# Encryption
# Enable encryption (requires password)
{% if encrypt | default(False) %}-p {{ password | default('') }}
{% endif %}

# Compatibility mode
# Use -1 to retain gifshuffle v1 compatibility (natural colourmap ordering)
{% if compatibility_mode | default(False) %}-1
{% endif %}

# Quiet mode (suppress output)
# Enable quiet mode (-Q); suppress statistics output
{% if quiet | default(False) %}-Q
{% endif %}

# Storage capacity report mode
# Report available storage capacity (-S); do not conceal/extract
{% if capacity_report | default(False) %}-S
{% endif %}

# Input and output files
# Path to input GIF file (or stdin if empty)
{% if input_file | default('') != '' %}{{ input_file | default('') }}
{% endif %}
# Path to output GIF/file (or stdout if empty)
{% if output_file | default('') != '' %}{{ output_file | default('') }}
{% endif %}