# pigz compression configuration
# Compression level (0-11)
# 0: no compression, 1-9: speed vs ratio, 11: zopfli (slowest)
compression_level={{ compression_level }}

# Number of parallel threads
# -1: auto-detect (default), 1: single-threaded
threads={{ threads }}

# Block size for parallel compression
# Suffix 'K' (kilo), 'M' (mega), 'G' (giga)
block_size={{ block_size }}

# Compression method
# gzip: standard .gz (default)
# zlib: raw .zz stream
# zip: PKWare single-entry .zip
format={{ format }}

# Do not store the file name or modification time
# Reduces header size and ensures deterministic output
no_name={{ no_name | lower }}

# Keep the original input file after compression
# By default, pigz deletes the original
keep={{ keep | lower }}

# Force operation
# Overwrite existing output, compress to terminal, process links
force={{ force | lower }}

# Use a custom output suffix
# Default is '.gz'
# Leave empty to use default
suffix={{ suffix | default('') }}

# Output to stdout
# Does not delete the input file
stdout={{ stdout | lower }}

# Independent blocks
# Allows decompression of partial archives / rsync-friendly
# Inserts sync flush blocks
independent={{ independent | lower }}

# Rsyncable mode
# Places block boundaries at input-determined locations
rsyncable={{ rsyncable | lower }}

# Verbose output
# Provides more information during processing
verbose={{ verbose | lower }}

# Quiet mode
# Suppresses all output, even errors
quiet={{ quiet | lower }}

# Comment in header
# Stored in gzip or zip central header
# Leave empty for no comment
comment={{ comment | default('') }}