{
  "admin_controls_acls": "all allow user root",
  "admin_controls_engine": "on",
  "allow_overwrite": "yes",
  "auth_order": "mod_auth_pam.c* mod_auth_unix.c",
  "auth_pam_config": "proftpd",
  "controls_acls": "all allow user root",
  "controls_engine": "on",
  "controls_log": "/var/log/proftpd/controls.log",
  "controls_socket_acl": "allow user *",
  "default_root": "~ !adm",
  "default_server": "on",
  "log_options": "-Timestamp -Hostname +RoleBasedProcessLabels",
  "max_instances": "20",
  "persistent_passwd": "off",
  "server_admin": "root@localhost",
  "server_ident": "on \"FTP Server ready.\"",
  "server_name": "\"ProFTPD server\"",
  "trace_log": "/var/log/proftpd/trace.log",
  "umask": "022 is a good standard umask to prevent new dirs and files",
  "use_reverse_dns": "off",
  "use_sendfile": "off",
  "vroot_engine": "on"
}
