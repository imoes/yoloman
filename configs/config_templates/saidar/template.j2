# Saidar system monitoring tool configuration
# This file configures the Saidar daemon or command-line behavior.

# Wait DELAY seconds between updates (default 3)
# Controls the frequency of system metric collection/reporting cycles.
# Maps to the -d command-line option.
update_delay: {{ update_delay | default(3) }}

# Enables coloured output (-c)
# When true, terminal output uses ANSI color codes for better readability.
colored_output: {{ colored_output | default(false) }}