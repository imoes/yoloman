# Command-line arguments for nyancat
# See nyancat(1) for details

# Enable telnet mode (-t)
# telnet_mode: default=False
{% if (values | default({})).telnet_mode | default(false) %}-t {% endif %}

# Display the requested number of frames, then quit (-f)
# frame_count: default=0
{% if (values | default({})).frame_count | default(0) > 0 %}-f {{ (values | default({})).frame_count | default(0) }}{% endif %}

# Crop the animation from the top (-r)
# min_rows: default=0
{% if (values | default({})).min_rows | default(0) > 0 %}-r {{ (values | default({})).min_rows | default(0) }}{% endif %}

# Crop the animation from the bottom (-R)
# max_rows: default=0
{% if (values | default({})).max_rows | default(0) > 0 %}-R {{ (values | default({})).max_rows | default(0) }}{% endif %}

# Crop the animation from the left (-c)
# min_cols: default=0
{% if (values | default({})).min_cols | default(0) > 0 %}-c {{ (values | default({})).min_cols | default(0) }}{% endif %}

# Crop the animation from the right (-C)
# max_cols: default=0
{% if (values | default({})).max_cols | default(0) > 0 %}-C {{ (values | default({})).max_cols | default(0) }}{% endif %}

# Crop the animation to the given width (-W)
# width: default=0
{% if (values | default({})).width | default(0) > 0 %}-W {{ (values | default({})).width | default(0) }}{% endif %}

# Crop the animation to the given height (-H)
# height: default=0
{% if (values | default({})).height | default(0) > 0 %}-H {{ (values | default({})).height | default(0) }}{% endif %}

# Show introduction / about information on startup (-i)
# show_intro: default=True
{% if (values | default({})).show_intro | default(true) %}-i{% else %}-I{% endif %}

# Do not display the timer (-n)
# no_counter: default=False
{% if (values | default({})).no_counter | default(false) %}-n{% endif %}

# Do not set the titlebar text (-s)
# no_title: default=False
{% if (values | default({})).no_title | default(false) %}-s{% endif %}

# Do not clear the display between frames (-e)
# no_clear: default=False
{% if (values | default({})).no_clear | default(false) %}-e{% endif %}