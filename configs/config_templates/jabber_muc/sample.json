{
  "jid": "muc.example.com",
  "port": 5347,
  "secret": "supersecret123",
  "log": "/var/log/jabber/muc.log",
  "log_level": "info",
  "max_occupants": 100,
  "min_password_length": 6,
  "allow_open_registration": true,
  "room_presets": [
    {
      "name": "default",
      "persistent": true,
      "max_occupants": 100,
      "title_required": false
    },
    {
      "name": "announcements",
      "persistent": true,
      "max_occupants": 500,
      "title_required": true,
      "announcement_services": [
        "bot.example.com",
        "admin.example.com"
      ]
    },
    {
      "name": "private",
      "persistent": false,
      "max_occupants": 20,
      "title_required": true
    }
  ],
  "allowed_domains": [
    "example.com",
    "partner.org"
  ],
  "disabled_features": [
    "muc_nonanonymous",
    "muc_membersonly"
  ],
  "namespace_prefix": "conference",
  "ssl": {
    "cert": "/etc/jabber/muc.crt",
    "key": "/etc/jabber/muc.key",
    "ca_cert": "/etc/ssl/certs/ca-certificates.crt"
  }
}
