{
 "allow_open_registration": true,
 "allowed_domains": [
  "example.com",
  "partner.org"
 ],
 "disabled_features": [
  "muc_nonanonymous",
  "muc_membersonly"
 ],
 "jid": "muc.example.com",
 "log": "/var/log/jabber/muc.log",
 "log_level": "info",
 "max_occupants": 100,
 "min_password_length": 6,
 "namespace_prefix": "conference",
 "port": 5347,
 "room_presets": [
  {
   "max_occupants": 100,
   "name": "default",
   "persistent": true,
   "title_required": false
  },
  {
   "announcement_services": [
    "bot.example.com",
    "admin.example.com"
   ],
   "max_occupants": 500,
   "name": "announcements",
   "persistent": true,
   "title_required": true
  },
  {
   "max_occupants": 20,
   "name": "private",
   "persistent": false,
   "title_required": true
  }
 ],
 "secret": "supersecret123",
 "ssl": {
  "ca_cert": "/etc/ssl/certs/ca-certificates.crt",
  "cert": "/etc/jabber/muc.crt",
  "key": "/etc/jabber/muc.key"
 }
}
