# Configuration for psl-make-dafsa
# psl-make-dafsa is a utility to compile the Public Suffix List into a DAFSA (Directed Acyclic Finite State Automaton)
# for use by libpsl. This template generates the configuration parameters for that tool.

# The path to the input text file containing the Public Suffix List (e.g., public_suffix_list.dat).
# Corresponds to the --infile argument.
# Default: /usr/share/publicsuffix/public_suffix_list.dat
psl_make_dafsa_input_file = {{ (input_file | default('/usr/share/publicsuffix/public_suffix_list.dat')) }}

# The path to the output file where the resulting DAFSA representation will be written.
# Corresponds to the --outfile argument.
# Default: /usr/lib/libpsl.so
psl_make_dafsa_output_file = {{ (output_file | default('/usr/lib/libpsl.so')) }}

# The format of the output data.
# Valid values: 'binary' (architecture-independent binary DAFSA), 'cxx' (C/C++ code), 'cxx+' (C/C++ code with stats).
# Corresponds to the --output-format option.
# Default: binary
psl_make_dafsa_output_format = {{ (output_format | default('binary')) }}

# The character encoding mode for processing the input list.
# Valid values: 'utf-8' (supports UTF-8 and punycode, default), 'ascii' (deprecated, punycode only).
# Corresponds to the --encoding option.
# Default: utf-8
psl_make_dafsa_encoding = {{ (encoding | default('utf-8')) }}