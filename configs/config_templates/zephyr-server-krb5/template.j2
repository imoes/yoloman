# Zephyr Server KRB5 Configuration
# This file controls how the Zephyr Kerberos 5 server handles message routing.

# operations_message
# Description: The recipient for operations messages. Default is '*' (all users).
# Type: string
# Default: '*'
message,operations,{{ operations_message | default('*') }}

# message_personal
# Description: The recipient pattern for personal messages. Default is '%me%' (self).
# Type: string
# Default: '%me%'
message,personal,{{ message_personal | default('%me%') }}

# message_urgent
# Description: The recipient pattern for urgent messages. Default is '%me%' (self).
# Type: string
# Default: '%me%'
message,urgent,{{ message_urgent | default('%me%') }}
