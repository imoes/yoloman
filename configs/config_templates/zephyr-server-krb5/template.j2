# Zephyr Server - KRB5 Configuration Template
# This file configures the messaging scopes for the Zephyr server.
# Each line follows the format: <category>,<scope>,<recipient_pattern>

# operations_message: The recipient for operations messages.
# Default is '*' (all users).
operations,message,{{ operations_message | default('*') }}

# message_personal: The recipient pattern for personal messages.
# Default is '%me%' (self).
message,personal,{{ message_personal | default('%me%') }}

# message_urgent: The recipient pattern for urgent messages.
# Default is '%me%' (self).
message,urgent,{{ message_urgent | default('%me%') }}