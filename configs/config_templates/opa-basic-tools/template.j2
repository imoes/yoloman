=== Open Policy Agent (OPA) Basic Tools — SSL Security Parameters ===
<!-- This block configures SSL/TLS security settings for the OPA basic tools installation.
     It defines certificate paths, verification depths, and CRL checking options. -->
<SslSecurityParameters>

  <!-- Whether SSL security is enabled (0 or 1). -->
  <SslSecurityEnabled>{{ ssl_security_enabled | default(0) }}</SslSecurityEnabled>

  <!-- The directory where SSL security files are stored. -->
  <SslSecurityDir>{{ ssl_security_dir | default('/usr/local/ssl/opafm') }}</SslSecurityDir>

  <!-- The filename of the Front-End server certificate. -->
  <SslSecurityFFCertificate>{{ ssl_security_ff_certificate | default('ff_cert.pem') }}</SslSecurityFFCertificate>

  <!-- The filename of the Front-End server private key. -->
  <SslSecurityFFPrivateKey>{{ ssl_security_ff_private_key | default('ff_key.pem') }}</SslSecurityFFPrivateKey>

  <!-- The filename of the Front-End CA certificate. -->
  <SslSecurityFFCaCertificate>{{ ssl_security_ff_ca_certificate | default('ff_ca_cert.pem') }}</SslSecurityFFCaCertificate>

  <!-- The depth of the certificate chain verification. -->
  <SslSecurityFFCertChainDepth>{{ ssl_security_ff_cert_chain_depth | default(1) }}</SslSecurityFFCertChainDepth>

  <!-- The filename of the Diffie-Hellman parameters file. -->
  <SslSecurityFFDHParameters>{{ ssl_security_ff_dh_parameters | default('ff_dh_parms.pem') }}</SslSecurityFFDHParameters>

  <!-- Whether CA CRL checking is enabled (0 or 1). -->
  <SslSecurityFFCaCRLEnabled>{{ ssl_security_ff_ca_crl_enabled | default(0) }}</SslSecurityFFCaCRLEnabled>

  <!-- The filename of the CA CRL file. -->
  <SslSecurityFFCaCRL>{{ ssl_security_ff_ca_crl | default('ff_ca_crl.pem') }}</SslSecurityFFCaCRL>

</SslSecurityParameters>