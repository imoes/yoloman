# =============================================================================
# downtimed(8) Daemon Configuration
# =============================================================================
# This file defines command-line options passed to the downtimed daemon.
# downtimed is a simple service to record downtime periods for statistical analysis.
#
# The options below are concatenated into a single string and exported to the
# environment variable DOWNTIMED_OPTS, which the init system or service wrapper
# reads at startup.
# =============================================================================

# DOWNTIMED_OPTS
# Description: Command-line options passed to the downtimed daemon.
# Default: Empty string (no extra options)
# Example: "--logfile /var/log/downtimed.log --pidfile /run/downtimed.pid"
DOWNTIMED_OPTS="{{ downtimed_opts | default('') }}"