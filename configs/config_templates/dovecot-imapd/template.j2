# Dovecot IMAP Configuration Template
# This section configures the standard IMAP port (143) for mail clients.
[Dovecot IMAP]
title=Secure mail server (IMAP)
description=Dovecot is a mail server whose major goals are security and extreme
 reliability.
# imap_port: The port and protocol for the IMAP service.
# Default: '143/tcp'
ports={{ imap_port | default('143/tcp') }}


# This section configures the secure IMAPS port (993) for encrypted mail access.
[Dovecot Secure IMAP]
title=Secure mail server (IMAPS)
description=Dovecot is a mail server whose major goals are security and extreme
 reliability.
# imaps_port: The port and protocol for the IMAPS (IMAP over SSL/TLS) service.
# Default: '993/tcp'
ports={{ imaps_port | default('993/tcp') }}