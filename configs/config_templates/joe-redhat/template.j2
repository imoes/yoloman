# Joe File Type Table Configuration
# This file defines how the `joe` text editor identifies and syntax-highlights various file types.
# It is typically included by the main joerc file.

# ==============================================================================
# Text Files
# ==============================================================================

# Text file
[text]
# Match any file without a dot in the name, assuming it's a text file with wordwrap enabled.
*
# Explicitly match .txt files.
*.txt

# ==============================================================================
# Not Text Files
# ==============================================================================

# Not a text file
[not_text]
# Match any file with a dot in the name, assuming it's likely a binary or code file.
*.*
# Disable wordwrap for these files.
-wordwrap

# ==============================================================================
# Diff/Patch Files
# ==============================================================================

# Diff
[diff]
# Match standard diff extensions.
*.diff
*.patch
# Pattern matching for diff headers and changes.
+\? [A-Za-z]
+Index: [A-Za-z]
+Only in
+Nur in
+--- 
+\*\*\* 
+[1-9][1-9]*[cda]
# Disable diff-specific syntax highlighting for these entries to allow custom formatting.
-syntax diff

# ==============================================================================
# Troff/Man Page Files
# ==============================================================================

# Troff
[troff]
# Match man page source extensions.
*.1
*.1.in
# Disable wordwrap for troff source.
-wordwrap
# Enable troff syntax highlighting.
-syntax troff

# ==============================================================================
# TeX/LaTeX Files
# ==============================================================================

# TeX
[tex]
# Match LaTeX source and style files.
*.tex
*.sty
# Enable TeX syntax highlighting.
-syntax tex
# Disable TeX comment highlighting (optional, depending on preference).
-tex_comment
# Disable double-quoted string highlighting.
-no_double_quoted
# Enable wordwrap.
-wordwrap

# ==============================================================================
# Email/News Files
# ==============================================================================

# News/mail files.
[email]
# Match various email/newsgroup file patterns.
*.article*
*.followup
*.letter
*tmp/nn.*
*tmp/Re*
*tmp/snd.*
*tmp/dmt*
*tmp/pico.*
*tmp/mutt-*
# Disable wordwrap for email files to preserve formatting.
-wordwrap
# Enable mail syntax highlighting.
-syntax mail

# ==============================================================================
# AVR Assembly Language
# ==============================================================================

# AVR assembly language
[avr]
# Match AVR assembly file extensions.
*.avr
*.inc
# Enable AVR syntax highlighting.
-syntax avr
# Enable auto-indentation.
-autoindent
# Enable wordwrap.
-wordwrap
# Set tab width for AVR assembly syntax highlighting.
# Default: 8
-tab {{ tab_width | default('8') }}

# ==============================================================================
# Generic Assembly Language
# ==============================================================================

# Generic assembly language
[assembly]
# Match common assembly file extensions.
*.asm
*.s
*.S
# Disable highlighter context processing.
-highlighter_context
# Enable wordwrap.
-wordwrap
# Enable assembly syntax highlighting.
-syntax asm

