# /etc/jugglinglab/jugglinglab.conf
# Main configuration file for Jugglinglab
# This configuration file defines the default behavior for the jugglinglab animation tool.

# Pattern to generate by default
# Siteswap string representing the default pattern.
pattern = "{{ pattern | default('3') }}"

# Animation speed in milliseconds per throw
# Higher values mean slower animation.
speed = {{ speed | default(200) }}

# Number of balls in the pattern
# Must be consistent with the siteswap pattern.
nb_balls = {{ nb_balls | default(3) }}

# Duration of the animation cycle in seconds
# Controls how long one full rotation of the pattern takes.
cycle_duration = {{ cycle_duration | default(10.0) }}

# Display mode: true for GUI, false for headless/scripting
# When true, launches the graphical interface.
gui = {{ gui | default(True) | lower }}

# Background color in HTML hex format
# Color of the background in the animation window.
background_color = "{{ background_color | default('#000000') }}"