# ==============================================================================
# Budgie Desktop Environment Session Configuration
# ==============================================================================
# This template generates the user-session configuration for Budgie.
# It defines the session identity and the core components that must always
# be launched when this session is selected by the user.
# ==============================================================================

[budgie Session]
# Name of the session.
# This key is used to identify the session in display managers and session selectors.
# Can be localized; see the .desktop file for language-specific strings.
# Default: 'budgie'
Name={{ (session_name | default('budgie')) | string }}

# List of required component identifiers.
# These components (typically .desktop file names like 'budgie-desktop', 'evolution-data-server', etc.)
# will always be started when this session is active.
# Stored internally as a semicolon-separated list.
# Default: [] (empty list; no extra forced components)
{% if required_components is defined and required_components | length > 0 %}
RequiredComponents={{ required_components | join(';') }}
{% else %}
RequiredComponents=
{% endif %}