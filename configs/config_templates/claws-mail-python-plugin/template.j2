# Claws Mail Python Plugin Configuration
# Generated by Ansible. Do not edit manually.

{% if load_plugin is defined and load_plugin %}
# load_plugin: Whether to load the python.so plugin at Claws Mail startup.
# Default: True
# If true, the plugin is registered and loaded during application initialization.
[Plugin]
name=python
{% endif %}

{% if script_dir is defined and script_dir %}
# script_dir: Absolute or relative path to the directory containing Python scripts
# for the plugin. If empty or omitted, the plugin uses its built-in default path.
# Default: '' (empty)
[Script]
path={{ script_dir }}
{% endif %}

{% if console_autostart is defined and console_autostart %}
# console_autostart: Whether to automatically open the Python console on startup
# for interactive testing of scripts. Intended for development/debugging only.
# Default: False
[Console]
autostart=true
{% endif %}