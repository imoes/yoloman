{
  "libvirtd_config_file": "/etc/libvirt/libvirtd.conf",
  "libvirtd_config_dir": "/etc/libvirt",
  "log_file": "/var/log/libvirt/libvirtd.log",
  "log_level": 2,
  "log_filters": "2:json 1:libvirt 3:qemu",
  "log_outputs": "1:file:/var/log/libvirt/libvirtd.log;2:stderr",
  "audit_level": 1,
  "audit_backend": "auditd",
  "auth_unix_ro": [
    "none"
  ],
  "auth_unix_rw": [
    "polkit"
  ],
  "unix_sock_ro_perms": "0777",
  "unix_sock_rw_perms": "0770",
  "unix_sock_dir": "/run/libvirt",
  "listen_tcp": false,
  "listen_tls": true,
  "tcp_port": "16509",
  "tls_port": "16514",
  "listen_addr": "127.0.0.1",
  "tls_cert_directory": "/etc/pki/libvirt",
  "tls_allowed_cn_list": [
    "client.example.com"
  ],
  "max_workers": 8,
  "min_workers": 2,
  "max_clients": 15,
  "max_requests": 100,
  "client_idle_timeout": 600,
  "network_start": true,
  "default_uri": "qemu:///system",
  "auto_start_storage_pools": [
    "default",
    "images"
  ],
  "qemu_user": "libvirt-qemu",
  "qemu_group": "libvirt-qemu",
  "qemu_dynamic_ownership": true,
  "qemu_image_configuration": [
    {
      "format": "qcow2",
      "cache": "writeback",
      "discard": "unmap",
      "detect_zeroes": "on"
    }
  ]
}
