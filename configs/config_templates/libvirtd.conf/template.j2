# Configuration for libvirtd — the virtualization management daemon
# Adjust paths, authentication, and resource limits for your environment

# Path to the libvirtd configuration file (this file)
config_file = "{{ libvirtd_config_file }}"

# Path to the libvirtd daemon configuration directory
config_dir = "{{ libvirtd_config_dir }}"

# Path to the log file for libvirtd
log_file = "{{ log_file }}"

# Log level: 1=error, 2=warn, 3=info, 4=debug
log_level = {{ log_level }}

# Log filters — semicolon-separated list of filter specs
log_filters = "{{ log_filters }}"

# Logging outputs — semicolon-separated list of output specs
log_outputs = "{{ log_outputs }}"

# Whether to log audit messages (requires auditd)
audit_level = {{ audit_level }}
audit_backend = "{{ audit_backend }}"

# Authentication methods for remote connections
auth_unix_ro = ["{{ auth_unix_ro[0] if auth_unix_ro else 'none' }}", "{{ auth_unix_ro[1] if auth_unix_ro|length > 1 else 'none' }}"]
auth_unix_rw = ["{{ auth_unix_rw[0] if auth_unix_rw else 'none' }}", "{{ auth_unix_rw[1] if auth_unix_rw|length > 1 else 'none' }}"]

# Unix socket permissions (octal string)
unix_sock_ro_perms = "{{ unix_sock_ro_perms }}"
unix_sock_rw_perms = "{{ unix_sock_rw_perms }}"
unix_sock_dir = "{{ unix_sock_dir }}"

# TCP/SSL listen addresses and ports
listen_tcp = {{ listen_tcp }}
listen_tls = {{ listen_tls }}
tcp_port = "{{ tcp_port }}"
tls_port = "{{ tls_port }}"
listen_addr = "{{ listen_addr }}"

# Path to TLS/SSL certificates and keys
tls_port = "{{ tls_port }}"
tls_cert_directory = "{{ tls_cert_directory }}"
tls_allowed_cn_list = [{{ tls_allowed_cn_list | map('quote') | join(', ') | default('') }}]

# Maximum number of worker threads
max_workers = {{ max_workers }}
min_workers = {{ min_workers }}
max_clients = {{ max_clients }}
max_requests = {{ max_requests }}

# Client idle timeout in seconds
client_idle_timeout = {{ client_idle_timeout }}

# Whether to start the network driver (for default NAT network, etc.)
network_start = {{ network_start }}

# Default URI for virsh and other clients
default_uri = "{{ default_uri }}"

# Storage pool auto-start settings
auto_start_storage_pools = [{{ auto_start_storage_pools | map('quote') | join(', ') | default('') }}]

# Driver-specific options — e.g., QEMU
qemu_driver_defaults = {
    "user" = "{{ qemu_user }}",
    "group" = "{{ qemu_group }}",
    "dynamic_ownership" = {{ qemu_dynamic_ownership }}
}

qemu_image_configuration = [
{% for img in qemu_image_configuration %}
    {
        "format" = "{{ img.format }}",
        "cache" = "{{ img.cache }}",
        "discard" = "{{ img.discard }}",
        "detect_zeroes" = "{{ img.detect_zeroes }}"
    }{{ ',' if not loop.last else '' }}
{% endfor %}
]
