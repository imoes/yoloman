{
  "pkg_name": {
    "type": "string",
    "default": "mew",
    "description": "Package name identifier"
  },
  "pkg_sname": {
    "type": "string",
    "default": "mew",
    "description": "Short package name for directory structures"
  },
  "emacs_flavor": {
    "type": "string",
    "default": "emacs",
    "description": "Default Emacs flavor if debian-emacs-flavor is not bound"
  },
  "autoload_mew": {
    "type": "string",
    "default": "mew",
    "description": "Package name for autoload definitions"
  },
  "mew_icon_directory": {
    "type": "string",
    "default": "/usr/share/pixmaps/mew",
    "description": "Directory containing Mew icons"
  },
  "mew_prog_ssl": {
    "type": "string",
    "default": "mewstunnel",
    "description": "Program used for SSL connections"
  },
  "mew_ssl_cert_directory": {
    "type": "string",
    "default": "/etc/ssl/certs",
    "description": "Directory containing SSL certificates"
  },
  "mew_ssl_verify_level": {
    "type": "number",
    "default": 2,
    "description": "SSL verification level"
  },
  "mew_unix_browser": {
    "type": "string",
    "default": "/usr/bin/sensible-browser",
    "description": "Unix browser command to open links"
  },
  "mew_prog_gpg": {
    "type": "string",
    "default": "gpg1",
    "description": "Program used for GPG v1 signing/verification"
  },
  "mew_prog_gpg2": {
    "type": "string",
    "default": "gpg",
    "description": "Program used for GPG v2 signing/verification"
  },
  "mew_field_comment": {
    "type": "string",
    "default": "",
    "description": "Value for mew-field-comment, workaround for Gmail"
  }
}
