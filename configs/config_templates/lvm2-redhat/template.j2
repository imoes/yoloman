# LVM2 Configuration File
# Managed by Ansible. See /etc/lvm/lvm.conf(5) for details.
# This template is self-documenting: every directive is preceded by a comment
# describing its purpose and default value.

# Configuration section config.
# How LVM configuration settings are handled.
config {

	# Configuration option config/validate_metadata.
	# Allows to select the level of validation after metadata transformation.
	# Accepted values: full, none.
	# Default: full.
{% if validate_metadata_default is defined and validate_metadata_default is not none and (validate_metadata_default is number or validate_metadata_default is boolean or validate_metadata_default | length > 0) %}	validate_metadata = "{{ validate_metadata_default | default('full') }}"{% else %}	# validate_metadata = "full"{% endif %}

	# Configuration option config/profile_dir.
	# Directory where LVM looks for configuration profiles.
	# Default: None (uses LVM builtin default).
{% if profile_dir_default is defined and profile_dir_default is not none and (profile_dir_default is number or profile_dir_default is boolean or profile_dir_default | length > 0) %}	profile_dir = "{{ profile_dir_default | default('') }}"{% else %}	# profile_dir = "/etc/lvm/profile"{% endif %}
}

# Configuration section devices.
# How LVM uses block devices.
devices {

	# Configuration option devices/dir.
	# Directory in which to create volume group device nodes.
	# Default: None (uses LVM builtin default, usually /dev).
{% if dir_default is defined and dir_default is not none and (dir_default is number or dir_default is boolean or dir_default | length > 0) %}	dir = "{{ dir_default | default('') }}"{% else %}	# dir = "/dev"{% endif %}

	# Configuration option devices/scan.
	# Directories containing device nodes to use with LVM.
	# Default: None (uses LVM builtin default).
{% if scan_default is defined and scan_default is not none and (scan_default is number or scan_default is boolean or scan_default | length > 0) %}	scan = [ "{{ scan_default | default('') }}" ]{% else %}	# scan = [ "/dev" ]{% endif %}

	# Configuration option devices/external_device_info_source.
	# Enable device information from udev.
	# Accepted values: none, udev.
	# Default: none.
{% if external_device_info_source_default is defined and external_device_info_source_default is not none and (external_device_info_source_default is number or external_device_info_source_default is boolean or external_device_info_source_default | length > 0) %}	external_device_info_source = "{{ external_device_info_source_default | default('none') }}"{% else %}	# external_device_info_source = "none"{% endif %}

	# Configuration option devices/hints.
	# Use a local file to remember which devices have PVs on them.
	# Accepted values: all, none.
	# Default: all.
{% if hints_default is defined and hints_default is not none and (hints_default is number or hints_default is boolean or hints_default | length > 0) %}	hints = "{{ hints_default | default('all') }}"{% else %}	# hints = "all"{% endif %}

	# Configuration option devices/use_devicesfile.
	# Enable or disable the use of a devices file.
	# Default: None (uses LVM builtin default).
	{% if use_devicesfile_default is defined and use_devicesfile_default is not none %}
{% if use_devicesfile_default is defined and use_devicesfile_default is not none and (use_devicesfile_default is number or use_devicesfile_default is boolean or use_devicesfile_default | length > 0) %}	use_devicesfile = {{ use_devicesfile_default }}{% else %}	# use_devicesfile = 1{% endif %}
	{% endif %}

	# Configuration option devices/devicesfile.
	# The name of the system devices file.
	# Default: None (uses LVM builtin default).
	{% if devicesfile_default is defined and devicesfile_default is not none %}
{% if devicesfile_default is defined and devicesfile_default is not none and (devicesfile_default is number or devicesfile_default is boolean or devicesfile_default | length > 0) %}	devicesfile = "{{ devicesfile_default }}"{% else %}	# devicesfile = "system.devices"{% endif %}
	{% endif %}

	# Configuration option devices/devicesfile_backup_limit.
	# The max number of backup files to keep in /etc/lvm/devices/backup.
	# Default: None (uses LVM builtin default).
	{% if devicesfile_backup_limit_default is defined and devicesfile_backup_limit_default is not none %}
{% if devicesfile_backup_limit_default is defined and devicesfile_backup_limit_default is not none and (devicesfile_backup_limit_default is number or devicesfile_backup_limit_default is boolean or devicesfile_backup_limit_default | length > 0) %}	devicesfile_backup_limit = {{ devicesfile_backup_limit_default }}{% else %}	# devicesfile_backup_limit = 50{% endif %}
	{% endif %}

	# Configuration option devices/search_for_devnames.
	# Look outside of the devices file for missing devname entries.
	# Accepted values: none, auto, all.
	# Default: all.
{% if search_for_devnames_default is defined and search_for_devnames_default is not none and (search_for_devnames_default is number or search_for_devnames_default is boolean or search_for_devnames_default | length > 0) %}	search_for_devnames = "{{ search_for_devnames_default | default('all') }}"{% else %}	# search_for_devnames = "all"{% endif %}

	# Configuration option devices/device_ids_refresh.
	# Find PVs on new devices and update the device IDs in the devices file.
	# Default: None (uses LVM builtin default).
	{% if device_ids_refresh_default is defined and device_ids_refresh_default is not none %}
{% if device_ids_refresh_default is defined and device_ids_refresh_default is not none and (device_ids_refresh_default is number or device_ids_refresh_default is boolean or device_ids_refresh_default | length > 0) %}	device_ids_refresh = {{ device_ids_refresh_default }}{% else %}	# device_ids_refresh = 1{% endif %}
	{% endif %}

	# Configuration option devices/device_ids_refresh_checks.
	# Conditions that trigger device_ids_refresh to locate PVIDs on new devices.
	# Accepted values: product_uuid, hostname.
	# Default: hostname (if product_uuid check is not explicitly enabled).
	# Note: If product_uuid is set, both values are included; otherwise only hostname.
	{% if device_ids_refresh_checks_product_uuid_default is defined and device_ids_refresh_checks_product_uuid_default is not none %}
	device_ids_refresh_checks = [ "{{ device_ids_refresh_checks_product_uuid_default | default('') }}", "{{ device_ids_refresh_checks_hostname_default | default('hostname') }}" ]
	{% else %}
{% if device_ids_refresh_checks_hostname_default is defined and device_ids_refresh_checks_hostname_default is not none and (device_ids_refresh_checks_hostname_default is number or device_ids_refresh_checks_hostname_default is boolean or device_ids_refresh_checks_hostname_default | length > 0) %}	device_ids_refresh_checks = [ "{{ device_ids_refresh_checks_hostname_default | default('hostname') }}" ]{% else %}	# device_ids_refresh_checks = [ "product_uuid", "hostname" ]{% endif %}
	{% endif %}

	# Configuration option devices/filter.
	# Limit the block devices that are used by LVM commands.
	# Syntax: [ "a|regex|", "r|regex|" ]
	# Default: a|.*| (accept all).
	{% if global_filter_default is defined and global_filter_default is not none %}
{% if global_filter_default is defined and global_filter_default is not none and (global_filter_default is number or global_filter_default is boolean or global_filter_default | length > 0) %}	global_filter = [ "{{ global_filter_default }}" ]{% else %}	# global_filter = [ "a|.*|" ]{% endif %}
	{% else %}
	global_filter = [ "a|.*|" ]
	{% endif %}

	# Configuration option devices/sysfs_scan.
	# Restrict device scanning to block devices appearing in sysfs.
	# Default: None (uses LVM builtin default).
	{% if sysfs_scan_default is defined and sysfs_scan_default is not none %}
{% if sysfs_scan_default is defined and sysfs_scan_default is not none and (sysfs_scan_default is number or sysfs_scan_default is boolean or sysfs_scan_default | length > 0) %}	sysfs_scan = {{ sysfs_scan_default }}{% else %}	# sysfs_scan = 1{% endif %}
	{% endif %}

	# Configuration option devices/scan_lvs.
	# Allow LVM LVs to be used as PVs.
	# Default: None (uses LVM builtin default).
	{% if scan_lvs_default is defined and scan_lvs_default is not none %}
{% if scan_lvs_default is defined and scan_lvs_default is not none and (scan_lvs_default is number or scan_lvs_default is boolean or scan_lvs_default | length > 0) %}	scan_lvs = {{ scan_lvs_default }}{% else %}	# scan_lvs = 0{% endif %}
	{% endif %}

	# Configuration option devices/multipath_component_detection.
	# Ignore devices that are components of DM multipath devices.
	# Default: None (uses LVM builtin default).
	{% if multipath_component_detection_default is defined and multipath_component_detection_default is not none %}
{% if multipath_component_detection_default is defined and multipath_component_detection_default is not none and (multipath_component_detection_default is number or multipath_component_detection_default is boolean or multipath_component_detection_default | length > 0) %}	multipath_component_detection = {{ multipath_component_detection_default }}{% else %}	# multipath_component_detection = 1{% endif %}
	{% endif %}

	# Configuration option devices/multipath_wwids_file.
	# The path to the multipath wwids file.
	# Default: None (uses LVM builtin default).
	{% if multipath_wwids_file_default is defined and multipath_wwids_file_default is not none %}
{% if multipath_wwids_file_default is defined and multipath_wwids_file_default is not none and (multipath_wwids_file_default is number or multipath_wwids_file_default is boolean or multipath_wwids_file_default | length > 0) %}	multipath_wwids_file = "{{ multipath_wwids_file_default }}"{% else %}	# multipath_wwids_file = "/etc/multipath/wwids"{% endif %}
	{% endif %}

	# Configuration option devices/md_component_detection.
	# Enable detection and exclusion of MD component devices.
	# Default: None (uses LVM builtin default).
	{% if md_component_detection_default is defined and md_component_detection_default is not none %}
{% if md_component_detection_default is defined and md_component_detection_default is not none and (md_component_detection_default is number or md_component_detection_default is boolean or md_component_detection_default | length > 0) %}	md_component_detection = {{ md_component_detection_default }}{% else %}	# md_component_detection = 1{% endif %}
	{% endif %}

	# Configuration option devices/md_component_checks.
	# The checks LVM should use to detect MD component devices.
	# Accepted values: auto, start, full.
	# Default: auto.
{% if md_component_checks_default is defined and md_component_checks_default is not none and (md_component_checks_default is number or md_component_checks_default is boolean or md_component_checks_default | length > 0) %}	md_component_checks = "{{ md_component_checks_default | default('auto') }}"{% else %}	# md_component_checks = "auto"{% endif %}

	# Configuration option devices/fw_raid_component_detection.
	# Ignore devices that are components of firmware RAID devices.
	# Default: None (uses LVM builtin default).
	{% if fw_raid_component_detection_default is defined and fw_raid_component_detection_default is not none %}
{% if fw_raid_component_detection_default is defined and fw_raid_component_detection_default is not none and (fw_raid_component_detection_default is number or fw_raid_component_detection_default is boolean or fw_raid_component_detection_default | length > 0) %}	fw_raid_component_detection = {{ fw_raid_component_detection_default }}{% else %}	# fw_raid_component_detection = 0{% endif %}
	{% endif %}

	# Configuration option devices/md_chunk_alignment.
	# Align the start of a PV data area with md device's stripe-width.
	# Default: None (uses LVM builtin default).
	{% if md_chunk_alignment_default is defined and md_chunk_alignment_default is not none %}
{% if md_chunk_alignment_default is defined and md_chunk_alignment_default is not none and (md_chunk_alignment_default is number or md_chunk_alignment_default is boolean or md_chunk_alignment_default | length > 0) %}	md_chunk_alignment = {{ md_chunk_alignment_default }}{% else %}	# md_chunk_alignment = 1{% endif %}
	{% endif %}

	# Configuration option devices/default_data_alignment.
	# Align the start of a PV data area with this number of MiB.
	# Default: None (uses LVM builtin default).
	{% if default_data_alignment_default is defined and default_data_alignment_default is not none %}
{% if default_data_alignment_default is defined and default_data_alignment_default is not none and (default_data_alignment_default is number or default_data_alignment_default is boolean or default_data_alignment_default | length > 0) %}	default_data_alignment = {{ default_data_alignment_default }}{% else %}	# default_data_alignment = 1{% endif %}
	{% endif %}

	# Configuration option devices/data_alignment_detection.
	# Align the start of a PV data area with sysfs io properties.
	# Default: None (uses LVM builtin default).
	{% if data_alignment_detection_default is defined and data_alignment_detection_default is not none %}
{% if data_alignment_detection_default is defined and data_alignment_detection_default is not none and (data_alignment_detection_default is number or data_alignment_detection_default is boolean or data_alignment_detection_default | length > 0) %}	data_alignment_detection = {{ data_alignment_detection_default }}{% else %}	# data_alignment_detection = 1{% endif %}
	{% endif %}

	# Configuration option devices/data_alignment.
	# Align the start of a PV data area with this number of KiB.
	# Default: None (uses LVM builtin default).
	{% if data_alignment_default is defined and data_alignment_default is not none %}
{% if data_alignment_default is defined and data_alignment_default is not none and (data_alignment_default is number or data_alignment_default is boolean or data_alignment_default | length > 0) %}	data_alignment = {{ data_alignment_default }}{% else %}	# data_alignment = 0{% endif %}
	{% endif %}

	# Configuration option devices/data_alignment_offset_detection.
	# Shift the start of an aligned PV data area based on sysfs information.
	# Default: None (uses LVM builtin default).
	{% if data_alignment_offset_detection_default is defined and data_alignment_offset_detection_default is not none %}
{% if data_alignment_offset_detection_default is defined and data_alignment_offset_detection_default is not none and (data_alignment_offset_detection_default is number or data_alignment_offset_detection_default is boolean or data_alignment_offset_detection_default | length > 0) %}	data_alignment_offset_detection = {{ data_alignment_offset_detection_default }}{% else %}	# data_alignment_offset_detection = 1{% endif %}
	{% endif %}

	# Configuration option devices/ignore_suspended_devices.
	# Ignore DM devices that have I/O suspended while scanning devices.
	# Default: None (uses LVM builtin default).
	{% if ignore_suspended_devices_default is defined and ignore_suspended_devices_default is not none %}
{% if ignore_suspended_devices_default is defined and ignore_suspended_devices_default is not none and (ignore_suspended_devices_default is number or ignore_suspended_devices_default is boolean or ignore_suspended_devices_default | length > 0) %}	ignore_suspended_devices = {{ ignore_suspended_devices_default }}{% else %}	# ignore_suspended_devices = 0{% endif %}
	{% endif %}

	# Configuration option devices/ignore_lvm_mirrors.
	# Do not scan 'mirror' LVs to avoid possible deadlocks.
	# Default: None (uses LVM builtin default).
	{% if ignore_lvm_mirrors_default is defined and ignore_lvm_mirrors_default is not none %}
{% if ignore_lvm_mirrors_default is defined and ignore_lvm_mirrors_default is not none and (ignore_lvm_mirrors_default is number or ignore_lvm_mirrors_default is boolean or ignore_lvm_mirrors_default | length > 0) %}	ignore_lvm_mirrors = {{ ignore_lvm_mirrors_default }}{% else %}	# ignore_lvm_mirrors = 1{% endif %}
	{% endif %}

	# Configuration option devices/require_restorefile_with_uuid.
	# Allow use of pvcreate --uuid without requiring --restorefile.
	# Default: None (uses LVM builtin default).
	{% if require_restorefile_with_uuid_default is defined and require_restorefile_with_uuid_default is not none %}
{% if require_restorefile_with_uuid_default is defined and require_restorefile_with_uuid_default is not none and (require_restorefile_with_uuid_default is number or require_restorefile_with_uuid_default is boolean or require_restorefile_with_uuid_default | length > 0) %}	require_restorefile_with_uuid = {{ require_restorefile_with_uuid_default }}{% else %}	# require_restorefile_with_uuid = 1{% endif %}
	{% endif %}

	# Configuration option devices/pv_min_size.
	# Minimum size in KiB of block devices which can be used as PVs.
	# Default: None (uses LVM builtin default).
	{% if pv_min_size_default is defined and pv_min_size_default is not none %}
{% if pv_min_size_default is defined and pv_min_size_default is not none and (pv_min_size_default is number or pv_min_size_default is boolean or pv_min_size_default | length > 0) %}	pv_min_size = {{ pv_min_size_default }}{% else %}	# pv_min_size = 2048{% endif %}
	{% endif %}

	# Configuration option devices/issue_discards.
	# Issue discards to PVs that are no longer used by an LV.
	# Default: None (uses LVM builtin default).
	{% if issue_discards_default is defined and issue_discards_default is not none %}
{% if issue_discards_default is defined and issue_discards_default is not none and (issue_discards_default is number or issue_discards_default is boolean or issue_discards_default | length > 0) %}	issue_discards = {{ issue_discards_default }}{% else %}	# issue_discards = 0{% endif %}
	{% endif %}

	# Configuration option devices/allow_changes_with_duplicate_pvs.
	# Allow VG modification while a PV appears on multiple devices.
	# Default: None (uses LVM builtin default).
	{% if allow_changes_with_duplicate_pvs_default is defined and allow_changes_with_duplicate_pvs_default is not none %}
{% if allow_changes_with_duplicate_pvs_default is defined and allow_changes_with_duplicate_pvs_default is not none and (allow_changes_with_duplicate_pvs_default is number or allow_changes_with_duplicate_pvs_default is boolean or allow_changes_with_duplicate_pvs_default | length > 0) %}	allow_changes_with_duplicate_pvs = {{ allow_changes_with_duplicate_pvs_default }}{% else %}	# allow_changes_with_duplicate_pvs = 0{% endif %}
	{% endif %}

	# Configuration option devices/allow_mixed_block_sizes.
	# Allow PVs in the same VG with different logical block sizes.
	# Default: None (uses LVM builtin default).
	{% if allow_mixed_block_sizes_default is defined and allow_mixed_block_sizes_default is not none %}
{% if allow_mixed_block_sizes_default is defined and allow_mixed_block_sizes_default is not none and (allow_mixed_block_sizes_default is number or allow_mixed_block_sizes_default is boolean or allow_mixed_block_sizes_default | length > 0) %}	allow_mixed_block_sizes = {{ allow_mixed_block_sizes_default }}{% else %}	# allow_mixed_block_sizes = 0{% endif %}
	{% endif %}
}

# Configuration section allocation.
# How LVM selects space and applies properties to LVs.
allocation {

	# Configuration option allocation/maximise_cling.
	# Use a previous allocation algorithm.
	# Default: None (uses LVM builtin default).
	{% if maximise_cling_default is defined and maximise_cling_default is not none %}
{% if maximise_cling_default is defined and maximise_cling_default is not none and (maximise_cling_default is number or maximise_cling_default is boolean or maximise_cling_default | length > 0) %}	maximise_cling = {{ maximise_cling_default }}{% else %}	# maximise_cling = 1{% endif %}
	{% endif %}

	# Configuration option allocation/use_blkid_wiping.
	# Use blkid to detect and erase existing signatures on new PVs and LVs.
	# Default: None (uses LVM builtin default).
	{% if use_blkid_wiping_default is defined and use_blkid_wiping_default is not none %}
{% if use_blkid_wiping_default is defined and use_blkid_wiping_default is not none and (use_blkid_wiping_default is number or use_blkid_wiping_default is boolean or use_blkid_wiping_default | length > 0) %}	use_blkid_wiping = {{ use_blkid_wiping_default }}{% else %}	# use_blkid_wiping = 1{% endif %}
	{% endif %}

	# Configuration option allocation/wipe_signatures_when_zeroing_new_lvs.
	# Look for and erase any signatures while zeroing a new LV.
	# Default: None (uses LVM builtin default).
	{% if wipe_signatures_when_zeroing_new_lvs_default is defined and wipe_signatures_when_zeroing_new_lvs_default is not none %}
{% if wipe_signatures_when_zeroing_new_lvs_default is defined and wipe_signatures_when_zeroing_new_lvs_default is not none and (wipe_signatures_when_zeroing_new_lvs_default is number or wipe_signatures_when_zeroing_new_lvs_default is boolean or wipe_signatures_when_zeroing_new_lvs_default | length > 0) %}	wipe_signatures_when_zeroing_new_lvs = {{ wipe_signatures_when_zeroing_new_lvs_default }}{% else %}	# wipe_signatures_when_zeroing_new_lvs = 1{% endif %}
	{% endif %}

	# Configuration option allocation/mirror_logs_require_separate_pvs.
	# Mirror logs and images will always use different PVs.
	# Default: None (uses LVM builtin default).
	{% if mirror_logs_require_separate_pvs_default is defined and mirror_logs_require_separate_pvs_default is not none %}
{% if mirror_logs_require_separate_pvs_default is defined and mirror_logs_require_separate_pvs_default is not none and (mirror_logs_require_separate_pvs_default is number or mirror_logs_require_separate_pvs_default is boolean or mirror_logs_require_separate_pvs_default | length > 0) %}	mirror_logs_require_separate_pvs = {{ mirror_logs_require_separate_pvs_default }}{% else %}	# mirror_logs_require_separate_pvs = 0{% endif %}
	{% endif %}

	# Configuration option allocation/raid_stripe_all_devices.
	# Stripe across all PVs when RAID stripes are not specified.
	# Default: None (uses LVM builtin default).
	{% if raid_stripe_all_devices_default is defined and raid_stripe_all_devices_default is not none %}
{% if raid_stripe_all_devices_default is defined and raid_stripe_all_devices_default is not none and (raid_stripe_all_devices_default is number or raid_stripe_all_devices_default is boolean or raid_stripe_all_devices_default | length > 0) %}	raid_stripe_all_devices = {{ raid_stripe_all_devices_default }}{% else %}	# raid_stripe_all_devices = 0{% endif %}
	{% endif %}

	# Configuration option allocation/cache_pool_metadata_require_separate_pvs.
	# Cache pool metadata and data will always use different PVs.
	# Default: None (uses LVM builtin default).
	{% if cache_pool_metadata_require_separate_pvs_default is defined and cache_pool_metadata_require_separate_pvs_default is not none %}
{% if cache_pool_metadata_require_separate_pvs_default is defined and cache_pool_metadata_require_separate_pvs_default is not none and (cache_pool_metadata_require_separate_pvs_default is number or cache_pool_metadata_require_separate_pvs_default is boolean or cache_pool_metadata_require_separate_pvs_default | length > 0) %}	cache_pool_metadata_require_separate_pvs = {{ cache_pool_metadata_require_separate_pvs_default }}{% else %}	# cache_pool_metadata_require_separate_pvs = 0{% endif %}
	{% endif %}

	# Configuration option allocation/cache_metadata_format.
	# Sets default metadata format for new cache.
	# Accepted values: 0 (auto), 1 (original), 2 (improved).
	# Default: None (uses LVM builtin default).
	{% if cache_metadata_format_default is defined and cache_metadata_format_default is not none %}
{% if cache_metadata_format_default is defined and cache_metadata_format_default is not none and (cache_metadata_format_default is number or cache_metadata_format_default is boolean or cache_metadata_format_default | length > 0) %}	cache_metadata_format = {{ cache_metadata_format_default }}{% else %}	# cache_metadata_format = 0{% endif %}
	{% endif %}

	# Configuration option allocation/cache_mode.
	# The default cache mode used for new cache.
	# Accepted values: writethrough, writeback.
	# Default: None (uses LVM builtin default).
	{% if cache_mode_default is defined and cache_mode_default is not none %}
{% if cache_mode_default is defined and cache_mode_default is not none and (cache_mode_default is number or cache_mode_default is boolean or cache_mode_default | length > 0) %}	cache_mode = "{{ cache_mode_default }}"{% else %}	# cache_mode = "writethrough"{% endif %}
	{% endif %}

	# Configuration option allocation/thin_pool_metadata_require_separate_pvs.
	# Thin pool metadata and data will always use different PVs.
	# Default: None (uses LVM builtin default).
	{% if thin_pool_metadata_require_separate_pvs_default is defined and thin_pool_metadata_require_separate_pvs_default is not none %}
{% if thin_pool_metadata_require_separate_pvs_default is defined and thin_pool_metadata_require_separate_pvs_default is not none and (thin_pool_metadata_require_separate_pvs_default is number or thin_pool_metadata_require_separate_pvs_default is boolean or thin_pool_metadata_require_separate_pvs_default | length > 0) %}	thin_pool_metadata_require_separate_pvs = {{ thin_pool_metadata_require_separate_pvs_default }}{% else %}	# thin_pool_metadata_require_separate_pvs = 0{% endif %}
	{% endif %}

	# Configuration option allocation/thin_pool_crop_metadata.
	# Older version of lvm2 cropped pool's metadata size.
	# Default: None (uses LVM builtin default).
	{% if thin_pool_crop_metadata_default is defined and thin_pool_crop_metadata_default is not none %}
{% if thin_pool_crop_metadata_default is defined and thin_pool_crop_metadata_default is not none and (thin_pool_crop_metadata_default is number or thin_pool_crop_metadata_default is boolean or thin_pool_crop_metadata_default | length > 0) %}	thin_pool_crop_metadata = {{ thin_pool_crop_metadata_default }}{% else %}	# thin_pool_crop_metadata = 0{% endif %}
	{% endif %}

	# Configuration option allocation/thin_pool_zero.
	# Thin pool data chunks are zeroed before they are first used.
	# Default: None (uses LVM builtin default).
	{% if thin_pool_zero_default is defined and thin_pool_zero_default is not none %}
{% if thin_pool_zero_default is defined and thin_pool_zero_default is not none and (thin_pool_zero_default is number or thin_pool_zero_default is boolean or thin_pool_zero_default | length > 0) %}	thin_pool_zero = {{ thin_pool_zero_default }}{% else %}	# thin_pool_zero = 1{% endif %}
	{% endif %}

	# Configuration option allocation/thin_pool_discards.
	# The discards behaviour of thin pool volumes.
	# Accepted values: ignore, nopassdown, passdown.
	# Default: None (uses LVM builtin default).
	{% if thin_pool_discards_default is defined and thin_pool_discards_default is not none %}
