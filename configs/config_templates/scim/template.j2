#
# SCIM (Smart Common Input Method) Configuration
#
# This template configures the SCIM input method framework for the X Window System.
# It sets up the X Input Method (XIM) backend, GTK and QT integration modules,
# and system dependencies.
#
# See: https://wiki.debian.org/SCIM (for legacy context)
#

# The name of the X Input Method backend to use.
# Default: SCIM
XIM={{ XIM | default('SCIM') }}

# Path to the SCIM daemon binary.
# Default: /usr/bin/scim
XIM_PROGRAM={{ XIM_PROGRAM | default('/usr/bin/scim') }}

# Command line arguments passed to the XIM program.
# Default: "-d" (run as daemon)
XIM_ARGS={{ XIM_ARGS | default('"-d"') }}

# Whether the XIM program should set itself as a daemon.
# Values: yes, no
# Default: yes
XIM_PROGRAM_SETS_ITSELF_AS_DAEMON={{ XIM_PROGRAM_SETS_ITSELF_AS_DAEMON | default('yes') }}

# GTK input method module name.
# This tells GTK applications to use SCIM/XIM for input.
# Default: xim
GTK_IM_MODULE={{ GTK_IM_MODULE | default('xim') }}

# QT input method module name.
# This tells QT applications to use SCIM/XIM for input.
# Default: xim
QT_IM_MODULE={{ QT_IM_MODULE | default('xim') }}

# Comma or pipe-separated list of dependency packages for SCIM.
# This is primarily used by package managers or init scripts to ensure
# necessary input method engines are installed.
# Examples of engines: scim-anthy, scim-pinyin, scim-tables-ja, etc.
# Default: scim,scim-anthy|scim-canna|scim-chewing|scim-pinyin|scim-hangul|scim-prime|scim-skk|scim-tables-additional|scim-m17n|scim-uim|scim-tables-ja|scim-tables-ko|scim-tables-zh
DEPENDS="{{ DEPENDS | default('scim,scim-anthy|scim-canna|scim-chewing|scim-pinyin|scim-hangul|scim-prime|scim-skk|scim-tables-additional|scim-m17n|scim-uim|scim-tables-ja|scim-tables-ko|scim-tables-zh') }}"
