# /etc/issue: prelogin message and system identification file
# This file is displayed before the login prompt by getty-type programs
# like agetty or mingetty. It may include escape sequences for dynamic
# system information.
#
# Supported sequences (depending on getty implementation):
#   \l  - terminal line (tty name)
#   \m  - machine architecture (uname -m)
#   \n  - network node hostname (uname -n)
#   \o  - domain name (NIS/YP domain, or empty if not in domain)
#   \r  - kernel release (uname -r)
#   \s  - system name (uname -s)
#   \t  - current time (YYYY-MM-DD HH:MM:SS)
#   \u  - number of current users logged in
#   \U  - string 'user' or 'users' depending on pluralization of \u
#   \v  - kernel version (uname -v)
#   \d  - current date (YYYY-MM-DD)
#   \S  - system identification string (if set via issue.net or other means)
#   \\  - backslash
#
# Note: Some sequences (like \o, \U) may not be supported on all systems.
#
# The following is a template with placeholder content.
{{ issue_content | e }}
