{
  "config_dir": "/var/lib/fnott",
  "font": "Inter 11",
  "icon_theme": "Papirus-Dark",
  "autostart": true,
  "max_notifications": 7,
  "notification_timeout": 8,
  "animation_duration": 150,
  "margin": 20,
  "scale": 0.9,
  "log_level": 2,
  "log_file": "/var/log/fnott.log",
  "colors": {
    "background": "#242434ff",
    "text": "#e0e0e0ff",
    "border_urgent": "#ff79c6ff",
    "border_low": "#4c566aff",
    "border_normal": "#8fbcbbff"
  },
  "outputs": [
    "eDP-1"
  ],
  "position": "bottom",
  "hposition": "right",
  "group_by_app": true,
  "default_urgency": "normal",
  "suppressed_app_ids": [
    "org.gnome.SettingsDaemon.Datetime.desktop",
    "blueman-applet.desktop"
  ],
  "actions_enabled": true,
  "action_timeout": 30
}
