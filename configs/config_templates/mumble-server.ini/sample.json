{
  "port": 64738,
  "host": "",
  "ssl_cert_path": "/etc/ssl/mumble.crt",
  "ssl_key_path": "/etc/ssl/private/mumble.key",
  "ssl_ca_path": "/etc/ssl/ca.crt",
  "ssl_verify_peers": true,
  "server_password": "mysecurepass",
  "super_user_password": "initialadmin",
  "max_bandwidth": 128000,
  "max_users": 200,
  "log_level": 3,
  "log_file_path": "/var/log/mumble-server.log",
  "web_enable": true,
  "web_port": 8080,
  "web_host": "0.0.0.0",
  "web_cert_path": "/etc/ssl/web.crt",
  "web_key_path": "/etc/ssl/private/web.key",
  "db_path": "/var/lib/mumble-server/mumble-server.sqlite",
  "pid_file_path": "/run/mumble-server.pid",
  "locale": "en_US",
  "timezone": "UTC",
  "bonjour_enabled": false,
  "config_reload_policy": 2,
  "enable_registration": false,
  "enable_recording": true,
  "opus_mode": 1,
  "opus_dtx": true,
  "silence_threshold": 0.02,
  "udp_packet_size": 1200,
  "ice_no_tcp": false,
  "static_users": [],
  "default_channels": [
    {
      "name": "Root",
      "parent": "",
      "description": "Root channel",
      "max_users": 0,
      "temp": false
    },
    {
      "name": "General",
      "parent": "Root",
      "description": "General discussion",
      "max_users": 50,
      "temp": false
    },
    {
      "name": "Private",
      "parent": "Root",
      "description": "Staff-only",
      "max_users": 10,
      "temp": false
    }
  ]
}
