[General]
# The user's display nickname in the Tox network.
nick = {{ nick | default('ToxicUser') }}

# Tox ID (generated on first run if empty; usually left blank in config for auto-generation)
# tox_id =

[Connection]
# Force IPv4 connection mode.
ipv4 = {{ ipv4 | default(false) | lower }}

# Force TCP connection, typically required when using proxies.
tcp = {{ force_tcp | default(false) | lower }}

# Act as a TCP relay server for the network (high bandwidth usage).
relay = {{ tcp_relay | default(false) | lower }}

# Start the client without connecting to the DHT network.
noconnect = {{ noconnect | default(false) | lower }}

# SOCKS5 proxy settings in format '[IP] [port]'. Leave empty to disable.
{% if socks5_proxy | default('') %}
socks5_proxy = {{ socks5_proxy | default('') }}
{% endif %}

# HTTP proxy settings in format '[IP] [port]'. Leave empty to disable.
{% if http_proxy | default('') %}
http_proxy = {{ http_proxy | default('') }}
{% endif %}

[Logging]
# Enable detailed toxcore logging to stderr.
tox_log = {{ tox_log | default(false) | lower }}

# Enable general client debugging output to stderr.
debug = {{ debug | default(false) | lower }}

[Paths]
# Path to the JSON file containing DHT bootstrap nodes.
nodes_file = {{ nodes_file | default('~/.config/tox/DHTnodes.json') }}

# Path to the file storing personal profile data and Tox ID.
data_file = {{ data_file | default('~/.config/tox/toxic_profile.tox') }}

# Path to the main configuration file.
config_file = {{ config_file | default('~/.config/tox/toxic.conf') }}

[Appearance]
# Force the use of the default locale.
default_locale = {{ default_locale | default(false) | lower }}