{
  "update_interval": 2,
  "font": "Fira Code:size=11",
  "colors": {
    "primary": "#BB9AF7",
    "secondary": "#7AA6C7",
    "alert": "#F7768E",
    "default_text": "#E0AF68"
  },
  "alignment": "top_right",
  "gap_x": 20,
  "gap_y": 20,
  "minimum_width": 280,
  "minimum_height": 0,
  "use_xft": true,
  "override_utf8_locale": true,
  "custom_variables": [
    {
      "name": "hostname",
      "value": "workstation-01"
    },
    {
      "name": "uptime_format",
      "value": "%j days"
    }
  ],
  "monitor_blocks": [
    {
      "type": "text",
      "content": "Host: ${hostname} | Uptime: ${uptime}"
    },
    {
      "type": "time"
    },
    {
      "type": "cpu",
      "cores": 4
    },
    {
      "type": "mem"
    },
    {
      "type": "swap"
    },
    {
      "type": "disk",
      "disks": [
        {
          "path": "/"
        },
        {
          "path": "/home"
        }
      ]
    },
    {
      "type": "net",
      "net_if": "wlan0"
    },
    {
      "type": "process",
      "processes": [
        {
          "name": "chrome"
        },
        {
          "name": "code"
        },
        {
          "name": "discord"
        }
      ]
    }
  ]
}
