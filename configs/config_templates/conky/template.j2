# ==============================================================================
# Conky System Monitor Configuration Template
# ==============================================================================
# This template generates a valid Conky configuration file. Conky is a lightweight
# system monitor for X11.
#
# Self-documentation: Every variable is defined with a default to ensure the
# configuration renders even if the variable is missing. Comments above directives
# explain their purpose based on the schema definition.
# ==============================================================================

{
  # Enable double buffering to reduce flicker; no_buffers prevents Conky
  # from caching text internally (recommended for dynamic monitors).
  double_buffer = true,
  no_buffers = true,

  # Output settings: out_to_console=false and out_to_x=true ensures Conky
  # runs as a desktop overlay window, not in the terminal.
  out_to_console = false,
  out_to_x = true,

  # Window management: Creates its own X window.
  own_window = true,
  own_window_type = 'desktop',
  own_window_transparent = true,
  own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager'
}

# update_interval: How often (in seconds) conky refreshes its display.
update_interval = {{ update_interval | default(2) }}

# Total buffer size (in KiB) — avoid flickering on high update rates.
total_buffer_size = 2048

# Font settings: name and size; use 'sans' fallback if not set.
# The font is wrapped in quotes as required by Conky's string syntax.
{
  font = '{{ font | default("DejaVu Sans Mono:size=10") }}'
}

# Color scheme: X11 color names or #RRGGBB.
# Maps primary, secondary, alert, and default_text colors from the schema.
# colors: default={'primary': '#7AA6C7', 'secondary': '#BB9AF7', 'alert': '#F7768E', 'default_text': '#E0AF68'}
# Note: Parent default ensures safe access to .primary etc. even if colors is undefined.
{
  color0 = '{{ (colors | default({"primary": "#7AA6C7"})).primary | default("#7AA6C7") }}',
  color1 = '{{ (colors | default({"secondary": "#BB9AF7"})).secondary | default("#BB9AF7") }}',
  color2 = '{{ (colors | default({"alert": "#F7768E"})).alert | default("#F7768E") }}',
  color3 = '{{ (colors | default({"default_text": "#E0AF68"})).default_text | default("#E0AF68") }}'
}

# General alignment: top_left, top_right, bottom_left, bottom_right, etc.
# Specifies where the conky window appears on screen.
# alignment: default='top_right'
{
  alignment = '{{ alignment | default("top_right") }}'
}

# Gap between window edge and content (px).
# gap_x: Horizontal gap; gap_y: Vertical gap.
# gap_x: default=10
# gap_y: default=10
{
  gap_x = {{ gap_x | default(10) }},
  gap_y = {{ gap_y | default(10) }}
}

# Window dimensions (px); 0 = auto-size based on content.
# minimum_width: Minimum width of conky window.
# minimum_height: Minimum height of conky window.
# minimum_width: default=0
# minimum_height: default=0
{
  minimum_width = {{ minimum_width | default(0) }},
  minimum_height = {{ minimum_height | default(0) }}
}

# Enable advanced features (Lua, RSS, etc.)
# use_xft: Enable Xft (anti-aliased fonts) support. Required for complex fonts.
# use_xft: default=True
use_xft = {{ use_xft | default(true) | string | lower }}

# Enable/Disable logging to stdout/stderr.
# log_file: Path to log file. Empty string disables logging.
{
  log_file = ''
}

# Define custom user variables (to be used in templates below).
# custom_variables: List of user-defined variables (key-value pairs) for reuse in monitor blocks.
# custom_variables: default=[]
{
  custom_user_variables = [
{% for var in custom_variables | default([]) %}
    { name = '{{ (var | default({"name": ""})).name | default("") }}', value = '{{ (var | default({"value": ""})).value | default("") }}' }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}

# UI layout: main body sections.
# text_buffer_size: Size of the text buffer for the text section.
# override_utf8_locale: Force UTF-8 locale for proper Unicode character rendering.
# override_utf8_locale: default=True
{
  text_buffer_size = 8192,
  override_utf8_locale = {{ override_utf8_locale | default(true) | string | lower }}
}

# Monitor sections (one per line or block).
# monitor_blocks: Ordered list of monitor sections to display. Each block defines
# content and parameters. The template iterates over blocks and renders appropriate
# Conky variable strings for each type (time, cpu, mem, disk, net, etc.).
# monitor_blocks: default=[{'type': 'time'}, ...]
{
  text = [
{% for block in monitor_blocks | default([]) %}
{% if block.type == 'time' %}
    '${color0}Time:${color} ${time %Y-%m-%d %H:%M:%S}',
{% elif block.type == 'cpu' %}
    '${color0}CPU usage:${color} ${cpu}% ${cpubar}',
    '${color0}CPU temperature:${color} ${hwmon 0 temp 1}°C',
{% elif block.type == 'mem' %}
    '${color0}Memory:${color} ${mem} / ${memmax} ${membar}',
{% elif block.type == 'swap' %}
    '${color0}Swap:${color} ${swap} / ${swapmax} ${swapbar}',
{% elif block.type == 'disk' %}
{% for disk in (block.disks | default([{"path": "/"}])) %}
    '${color0}{{ (disk | default({"path": "/"})).path | default("/") }}:${color} ${fs_used {{ (disk | default({"path": "/"})).path | default("/") }} } / {{ (disk | default({"path": "/"})).path | default("/") }} ${fs_bar {{ (disk | default({"path": "/"})).path | default("/") }} }',
{% endfor %}
{% elif block.type == 'net' %}
    '${color0}Network:${color} ${upspeed {{ (block.net_if | default("eth0")) }} } ↑ ${downspeed {{ (block.net_if | default("eth0")) }} } ↓',
{% elif block.type == 'process' %}
    '${color0}Top processes:${color}',
{% for proc in (block.processes | default([])) %}
    '${color1}${top_name {{ loop.index0 }} }${color2}: ${top_mem {{ loop.index0 }} }% ${top_cpu {{ loop.index0 }} }%',
{% endfor %}
{% elif block.type == 'text' %}
    '{{ (block.content | default("") | replace('\n', '\n') | replace("'", "'\"'\"'")) }}',
{% elif block.type == 'custom' %}
    '{{ (block.script | default("") | replace('\n', '\n') | replace("'", "'\"'\"'")) }}',
{% endif %}
{% endfor %}
    '${color}'
  ]
}