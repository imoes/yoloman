# Eggdrop configuration file
# Generated by Ansible Jinja2 template
#
# This file configures the Eggdrop bot. Variables are mapped from the
# role's schema. Defaults are applied inline to ensure safe rendering.

# --- Identity & Basic Settings ---

# User to run the bot as. Defaults to 'root' if not specified.
# Note: Running as root is generally discouraged for security reasons;
# a dedicated system user is preferred.
set username "{{ (eggdrop | default({})).user | default('root') }}"

# The real name (ident) displayed by the bot on IRC networks.
# If not specified in schema, defaults to 'Eggdrop'.
set realname "{{ (eggdrop | default({})).realname | default('Eggdrop') }}"