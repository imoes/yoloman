# =============================================================================
# Mailfromd Main Configuration
# This file configures the mailfromd daemon, which acts as an MTA filter for
# SMTP connections. It performs validation checks (SPF, DKIM, DNSBL, etc.)
# before forwarding mail to the destination MTA.
# See `man 5 mailfromd.conf` for detailed documentation.
# =============================================================================

# -----------------------------------------------------------------------------
# System / Security Settings
# -----------------------------------------------------------------------------

# Enable verbose logging (additional debug output to syslog)
# Default: False
verbose {{ verbose | default(false) }}

# System user to drop privileges to after startup
# Default: 'mailfromd'
user "{{ user | default('mailfromd') }}"

# System group to drop privileges to after startup
# (defaults to user's primary group if not specified)
# Default: 'mailfromd'
group "{{ group | default('mailfromd') }}"

# Path to the PID file
# Default: '/var/run/mailfromd.pid'
pidfile "{{ pidfile | default('/var/run/mailfromd.pid') }}"

# Chroot directory
# Set to empty string to disable chroot
# Default: '/var/chroot/mailfromd'
chroot "{{ chroot | default('/var/chroot/mailfromd') }}"

# -----------------------------------------------------------------------------
# Connection Limits & Timeouts
# -----------------------------------------------------------------------------

# Maximum number of simultaneous client connections
# Default: 1000
max-connections {{ max_connections | default(1000) }}

# Maximum number of recipients per message
# Default: 50
max-recipients {{ max_recipients | default(50) }}

# Timeout for SMTP commands (in seconds)
# Default: 300
command-timeout {{ command_timeout | default(300) }}

# Timeout for data transfer (in seconds)
# Default: 120
data-timeout {{ data_timeout | default(120) }}

# Timeout for connection establishment (in seconds)
# Default: 30
connect-timeout {{ connect_timeout | default(30) }}

# -----------------------------------------------------------------------------
# Network Listeners
# Defines which interfaces and ports the daemon binds to.
# Default: [{'address': '127.0.0.1', 'port': 25}]
# -----------------------------------------------------------------------------
{% for listener in (listeners | default([{'address': '127.0.0.1', 'port': 25}])) %}
listen {{ listener.address }} {{ listener.port }}
{% endfor %}

# -----------------------------------------------------------------------------
# TLS/SSL Configuration
# -----------------------------------------------------------------------------

# Enable TLS encryption for inbound connections
# Default: False
{% if tls_enabled | default(false) %}
# Path to TLS certificate file
# Default: '/etc/mailfromd/cert.pem'
tls-certificate "{{ tls_certificate | default('/etc/mailfromd/cert.pem') }}"

# Path to TLS private key file
# Default: '/etc/mailfromd/key.pem'
tls-key "{{ tls_key | default('/etc/mailfromd/key.pem') }}"

# Path to CA certificate bundle for client verification (optional)
# Default: '' (empty string means no client cert verification)
{% if tls_ca | default('') %}
tls-ca "{{ tls_ca | default('') }}"
{% endif %}
{% endif %}

# -----------------------------------------------------------------------------
# DNSBL (DNS-based Blackhole List) Configuration
# Lists of DNS blackhole servers to query for sender IP reputation.
# Default: [] (empty list, no DNSBL checks)
# -----------------------------------------------------------------------------
{% for dnsbl in (dnsbls | default([])) %}
dnsbl "{{ dnsbl.domain }}" {{ dnsbl.action }}{% if dnsbl.ttl is defined %} {{ dnsbl.ttl }}{% endif %}
{% endfor %}

# -----------------------------------------------------------------------------
# Whitelists
# Trusted hosts/networks that bypass DNSBL and rate limiting.
# Default: [] (empty list, no whitelists)
# -----------------------------------------------------------------------------
{% for whitelist in (whitelists | default([])) %}
whitelist {{ whitelist.network }}{% if whitelist.comment is defined %} # {{ whitelist.comment }}{% endif %}
{% endfor %}

# -----------------------------------------------------------------------------
# Blocked Action
# SMTP action to take when a sender is blocked by DNSBL or other checks.
# Options: 'reject', 'discard'
# Default: 'reject'
# -----------------------------------------------------------------------------
blocked-action {{ blocked_action | default('reject') }}

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------

# Enable connection rate limiting per IP
# Default: True
{% if rate_limiting | default(true) %}
# Maximum connections per minute per IP (used when rate_limiting=true)
# Default: 10
rate-limit {{ rate_limit | default(10) }}
{% endif %}

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log format (syslog facility/priority or "-" for stdout)
# Default: 'mail.fromd'
log-format {{ log_format | default('mail.fromd') }}

# -----------------------------------------------------------------------------
# Authentication & Verification Protocols
# -----------------------------------------------------------------------------

# Enable Sender Policy Framework validation
# Default: True
spf {{ "yes" if spf_enabled | default(true) else "no" }}

# Enable DKIM verification
# Default: True
dkim {{ "yes" if dkim_enabled | default(true) else "no" }}