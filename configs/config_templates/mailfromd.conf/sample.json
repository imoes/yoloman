{
  "verbose": false,
  "user": "mailfromd",
  "group": "mailfromd",
  "pidfile": "/var/run/mailfromd.pid",
  "chroot": "/var/chroot/mailfromd",
  "max_connections": 1000,
  "max_recipients": 50,
  "command_timeout": 300,
  "data_timeout": 120,
  "connect_timeout": 30,
  "listeners": [
    {
      "address": "127.0.0.1",
      "port": 25
    },
    {
      "address": "0.0.0.0",
      "port": 587
    }
  ],
  "tls_enabled": true,
  "tls_certificate": "/etc/letsencrypt/live/mail.example.com/fullchain.pem",
  "tls_key": "/etc/letsencrypt/live/mail.example.com/privkey.pem",
  "tls_ca": "",
  "dnsbls": [
    {
      "domain": "zen.spamhaus.org",
      "action": "reject",
      "ttl": 300
    },
    {
      "domain": "bl.spamcop.net",
      "action": "reject"
    }
  ],
  "whitelists": [
    {
      "network": "127.0.0.0/8",
      "comment": "Localhost"
    },
    {
      "network": "192.168.0.0/16",
      "comment": "Internal networks"
    }
  ],
  "blocked_action": "reject",
  "rate_limiting": true,
  "rate_limit": 20,
  "log_format": "mail.fromd",
  "spf_enabled": true,
  "dkim_enabled": true
}
