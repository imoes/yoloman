{
  "http": {
    "listen_host": "0.0.0.0",
    "listen_port": 8080,
    "ssl": {
      "enabled": true,
      "cert_file": "/etc/condure/ssl/fullchain.pem",
      "key_file": "/etc/condure/ssl/privkey.pem"
    }
  },
  "websocket": {
    "max_connections": 5000,
    "ping_interval": 25,
    "ping_timeout": 15,
    "compression": true
  },
  "backends": [
    {
      "name": "main-app",
      "host": "127.0.0.1",
      "port": 3000
    },
    {
      "name": "api-backend",
      "host": "api.internal.example.com",
      "port": 443,
      "ssl": true,
      "ssl_verify": true
    }
  ],
  "log": {
    "level": "info",
    "format": "json"
  }
}
