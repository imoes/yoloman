{
  "listen_address": "0.0.0.0",
  "listen_port": 9091,
  "web_route_prefix": "/",
  "persistence_file": "/var/lib/prometheus-pushgateway/pushgateway.dat",
  "persisting": false,
  "persist_interval": "5m",
  "max_connections": 2000,
  "web_timeout": "10s",
  "web_basic_auth_realm": "Pushgateway",
  "static_labels": [
    {
      "name": "job",
      "value": "batch"
    },
    {
      "name": "env",
      "value": "production"
    }
  ],
  "basic_auth_enabled": false,
  "web_basic_auth_file": "/etc/prometheus/.htpasswd",
  "tls_enabled": false,
  "web_config_file": "/etc/prometheus/web-config.yml",
  "metrics_enabled": true,
  "metrics_path": "/metrics",
  "log_level": "info"
}
