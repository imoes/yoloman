{
  "instance_name": "example",
  "service_user": "dirsrv",
  "service_group": "dirsrv",
  "enable_networking": true,
  "network_namespace": "",
  "environment_vars": [
    [
      "NSPR_LOG_MODULE",
      "all:5"
    ],
    [
      "NSPR_LOG_FILE",
      "/var/log/dirsrv/slapd-example/nspr.log"
    ],
    [
      "DS_USE_GSSAPI",
      "1"
    ]
  ]
}
