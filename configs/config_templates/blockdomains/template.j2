{# Blockdomains Firewall Agent configuration #}
{# Core operational mode: 'monitor' (log only) or 'block' (deny traffic) #}
mode = {{ mode }}

{# Path to the rules file containing domain patterns and actions #}
rules_file = {{ rules_file }}

{# Path to the allowlist file for exceptions #}
allowlist_file = {{ allowlist_file }}

{# Logging verbosity: 'debug', 'info', 'warn', 'error' #}
log_level = {{ log_level }}

{# Log file path (empty string to log to stderr) #}
log_file = {{ log_file }}

{# Maximum number of concurrent connections to inspect #}
max_connections = {{ max_connections }}

{# Connection timeout in milliseconds #}
connection_timeout_ms = {{ connection_timeout_ms }}

{# DNS resolution settings #}
use_system_dns = {{ use_system_dns }}

{# Optional custom DNS servers (list of IP:port strings) #}
{% if custom_dns is defined and custom_dns | length > 0 %}
custom_dns_servers = {{ custom_dns | join(', ') }}
{% else %}
custom_dns_servers =
{% endif %}

{# TLS inspection settings #}
{% if tls_inspection | lower == 'enabled' %}
tls_inspection = enabled
tls_ca_cert = {{ tls_ca_cert }}
tls_ca_key = {{ tls_ca_key }}
{% else %}
tls_inspection = disabled
{% endif %}

{# Rate limiting per source IP (in requests per second) #}
{% for rule in rate_limit_rules %}
{% if loop.first %}[rate_limits]
{% endif %}
{{ rule.ip_pattern }} = {{ rule.requests_per_second }} rps
{% endfor %}

{# Custom HTTP headers to block (by exact match or prefix) #}
{% for header in blocked_headers %}
{% if loop.first %}[blocked_headers]
{% endif %}
{{ header.name }}{{ '' if header.match_type == 'exact' else '=' + header.match_type }}
{% endfor %}

{# Blocked user agents (regex patterns) #}
{% for pattern in blocked_user_agents %}
{% if loop.first %}[blocked_user_agents]
{% endif %}
{{ pattern }}
{% endfor %}

{# Domain blocking rules (from rules_file — this section is just for documentation) #}
# Format in rules_file:
#   domain_pattern | action | [optional_comment]
#   actions: block, log_only, pass
