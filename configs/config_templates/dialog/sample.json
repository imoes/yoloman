{
  "colors": true,
  "backtitle": "System Configuration Dialog",
  "title": "Dialog Settings",
  "help_button": true,
  "item_help": true,
  "help_tags": false,
  "default_button": "ok",
  "defaultno": false,
  "no_cancel": false,
  "no_shadow": true,
  "no_mouse": true,
  "no_hot_list": false,
  "no_tags": false,
  "visit_items": true,
  "extra_button": true,
  "no_nl_expand": false,
  "cr_wrap": true,
  "no_collapse": false,
  "trim": true,
  "ascii_lines": false,
  "no_lines": false,
  "scrollbar": true,
  "keep_tite": true,
  "clear": true,
  "insecure": false,
  "date_format": "%Y-%m-%d",
  "time_format": "%H:%M:%S",
  "column_separator": "\t",
  "separator": " ",
  "separate_widget": "\t",
  "max_input": 1024,
  "tab_len": 4,
  "week_start": "Mo",
  "iso_week": true,
  "color_list": [
    "black",
    "red",
    "green",
    "yellow",
    "blue",
    "magenta",
    "cyan",
    "white"
  ],
  "key_bindings": [
    {
      "widget": "textbox",
      "curses_key": "F1",
      "dialog_key": "HELPFILE"
    },
    {
      "widget": "formfield",
      "curses_key": "TAB",
      "dialog_key": "form_NEXT"
    },
    {
      "widget": "formbox",
      "curses_key": "BTAB",
      "dialog_key": "form_prev"
    }
  ]
}
