{
  "machine_type": "virt",
  "machine_accel": "tcg",
  "smp_cpus": 4,
  "smp_maxcpus": 4,
  "memory_size": "1G",
  "disk_image_path": "/var/lib/qemu/images/arm64-server.qcow2",
  "disk_interface": "virtio",
  "disk_cache": "writethrough",
  "disk_media": "disk",
  "boot_order": "c",
  "boot_menu_enabled": false,
  "boot_strict": false,
  "kernel_path": "/var/lib/qemu/images/kernel/Image",
  "kernel_cmdline": "console=ttyAMA0,115200 earlyprintk loglevel=8",
  "initrd_path": "/var/lib/qemu/images/kernel/initrd.img",
  "display_type": "none",
  "display_params": "",
  "no_graphic": true,
  "enable_kvm": false,
  "cpu_model": "cortex-a57",
  "network_backends": [
    {
      "type": "user",
      "id": "net0",
      "options": {
        "ipv4": "on"
      }
    }
  ],
  "nics": [
    {
      "driver": "virtio-net-pci",
      "netdev_id": "net0",
      "mac_address": "52:54:00:00:00:01"
    }
  ],
  "serial_config": "stdio",
  "guest_name": "arm64-virtual-machine",
  "system_uuid": "",
  "enable_semihosting": false,
  "dtb_path": "/var/lib/qemu/images/dtb/virt.dtb"
}
