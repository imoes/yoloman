{
  "daemon_enable": true,
  "user": "arpon",
  "group": "arpon",
  "pidfile": "/var/run/arpon/arpon.pid",
  "interfaces": [
    "eth0",
    "br0"
  ],
  "loglevel": 2,
  "log_file": "/var/log/arpon.log",
  "remote_log_host": "syslog.lan.local",
  "remote_log_port": 514,
  "mode": "hybrid",
  "arp_table_path": "/etc/ethers",
  "dhcp_lease_file": "/var/lib/dhcp/dhcpd.leases",
  "detect_spoof": true,
  "prevent_spoof": true,
  "rescan_interval": 30,
  "threshold": 5,
  "anomaly_cmd": "/usr/local/bin/arp-anomaly-alert.sh",
  "whitelist": [
    "00:11:22:33:44:55",
    "aa:bb:cc:dd:ee:ff"
  ],
  "fixed_arp": [
    {
      "ip": "192.168.1.1",
      "mac": "00:11:22:33:44:55"
    },
    {
      "ip": "192.168.1.254",
      "mac": "aa:bb:cc:dd:ee:ff"
    }
  ],
  "start_delay": 10,
  "daemon_opts": "-D -t 10"
}
