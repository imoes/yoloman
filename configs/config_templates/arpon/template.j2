#
# ArpON (Address Resolution Protocol Poison) configuration file.
#
# This file defines static IP-to-MAC mappings used by ArpON to detect ARP spoofing.
# Entries are formatted as 'IP<TAB>MAC'.
# The order of entries corresponds to specific network interfaces:
#   - Entries 0-2 are associated with the 'eth0' interface.
#   - Entries 3-4 are associated with the 'eth1' interface.
#
# See the arpon(8) man page for further details.
#

# Static entries matching the eth0 network interface.
# These entries define known-good mappings for the primary interface.
{% for entry in arp_table_entries | default(['#192.168.1.1\t58:ac:78:10:b9:77', '#192.168.1.3\td4:be:d9:fe:8b:45', '#192.168.1.4\t90:94:e4:bb:1c:10']) %}
    {% if loop.index0 < 3 %}
{{ entry }}
    {% endif %}
{% endfor %}

# Static entries matching the eth1 network interface.
# These entries define known-good mappings for the secondary interface.
{% for entry in arp_table_entries | default(['#192.168.1.1\t58:ac:78:10:b9:77', '#192.168.1.3\td4:be:d9:fe:8b:45', '#192.168.1.4\t90:94:e4:bb:1c:10', '#10.0.1.1\t58:ac:78:88:1a:bb', '#10.0.10.1\t90:94:e4:7e:f4:59']) %}
    {% if loop.index0 >= 3 and loop.index0 < 5 %}
{{ entry }}
    {% endif %}
{% endfor %}