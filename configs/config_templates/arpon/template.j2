# Enable or disable the arpon daemon
DAEMON_ENABLE={{ daemon_enable | string | lower }}

# User and group to run as (must exist on the system)
USER={{ user }}
GROUP={{ group }}

# Path to the PID file
PIDFILE={{ pidfile }}

# Interface(s) to monitor (space-separated list)
INTERFACE="{{ interfaces | join(' ') }}"

# Logging verbosity: 0=quiet, 1=normal, 2=verbose, 3=debug
LOGLEVEL={{ loglevel }}

# Log file path (leave empty for syslog)
LOGFILE="{{ log_file }}"

# DNS hostname for remote logging (leave empty to disable)
REMOTE_LOG_HOST="{{ remote_log_host }}"

# Remote log port (used only if REMOTE_LOG_HOST is set)
REMOTE_LOG_PORT={{ remote_log_port }}

# Mode of operation: 'dhcp' (DHCP-only protection), 'static' (static ARP inspection), 'hybrid' (both)
MODE={{ mode }}

# Path to static ARP table (used in static/hybrid mode)
ARP_TABLE="{{ arp_table_path }}"

# Path to DHCP lease file (used in dhcp/hybrid mode)
DHCP_LEASE_FILE="{{ dhcp_lease_file }}"

# Enable detection of ARP spoofing attempts (true/false)
DETECT_SPOOF={{ detect_spoof | string | lower }}

# Enable prevention (e.g., dropping malicious packets) (true/false)
PREVENT_SPOOF={{ prevent_spoof | string | lower }}

# Time (in seconds) to wait before re-checking ARP entries
RESCAN_INTERVAL={{ rescan_interval }}

# Number of consecutive ARP inconsistencies to tolerate before taking action
THRESHOLD={{ threshold }}

# Command to run when an ARP anomaly is detected (e.g., script or command)
ANOMALY_CMD="{{ anomaly_cmd }}"

# List of MAC addresses to whitelist (ignored by ARP inspection)
WHITELIST="{{ whitelist | join(' ') }}"

# List of fixed ARP entries (format: IP:MAC; one per line for multi-line entries)
{% for entry in fixed_arp %}
FIXED_ARP_{{ loop.index }}="{{ entry.ip }}:{{ entry.mac }}"
{% endfor %}

# Delay (in seconds) before arpon starts after boot
START_DELAY={{ start_delay }}

# Additional arguments passed to arpon binary
DAEMON_OPTS="{{ daemon_opts }}"