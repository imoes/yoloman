{
  "connect_proxy_path": "/usr/bin/connect-proxy",
  "socks5_server": "socks.example.com:1080",
  "http_proxy_server": "proxy.example.com:8080",
  "socks_version": 5,
  "resolve_method": "remote",
  "ssh_proxy_entries": [
    {
      "host": "192.*",
      "socks_server": "",
      "http_proxy": "",
      "protocol_version": 5,
      "resolve_method": ""
    },
    {
      "host": "*",
      "http_proxy": "proxy.example.com:8080",
      "socks_server": "",
      "protocol_version": 5,
      "resolve_method": "remote"
    }
  ]
}
