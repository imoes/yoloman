# Netrik configuration file (~/.netrikrc)
# Generated from netrik(1) documentation

# Initial URL to load on startup. If empty, netrik starts without loading a page.
# See: DESCRIPTION - "If some file name/URL is present in the configuration file ... the one from the config file will be loaded"
initial_url = "{{ values.initial_url | default('http://www.google.com') }}"

# HTML parsing behavior. Valid options: fussy-html, clean-html, valid-html, broken-html, ignore-broken.
# See: OPTIONS
html_mode = "{{ values.html_mode | default('broken-html') }}"

# Force usage of the dark background color scheme regardless of terminal default.
# See: OPTIONS
use_dark_background = {{ values.use_dark_background | default(true) | lower }}

# Force usage of the bright background color scheme.
# See: OPTIONS
use_bright_background = {{ values.use_bright_background | default(false) | lower }}

# Use wget(1) for HTTP retrieval instead of the built-in HTTP handler.
# See: OPTIONS
use_wget_for_http = {{ values.use_wget_for_http | default(false) | lower }}

# Ignore proxy environment variables (HTTP_PROXY/http_proxy) for built-in HTTP.
# See: OPTIONS
ignore_proxy = {{ values.ignore_proxy | default(false) | lower }}

# When jumping to an anchor, place it in the second line of the screen instead of 1/5 down.
# See: OPTIONS
anchor_offset_top = {{ values.anchor_offset_top | default(false) | lower }}

# Use arrow keys for cursor movement instead of vi-like keys.
# See: OPTIONS
use_cursor_keys = {{ values.use_cursor_keys | default(false) | lower }}

# Assume terminal needs xterm-like workaround for bright background colors.
# See: OPTIONS
assume_xterm = {{ values.assume_xterm | default(false) | lower }}

# Assume terminal does NOT need xterm-like workaround (default for linux console).
# See: OPTIONS
assume_console = {{ values.assume_console | default(false) | lower }}

# Use terminal's default colors even if dark background is forced.
# See: OPTIONS
no_force_colors = {{ values.no_force_colors | default(false) | lower }}

# Issue a warning for unknown HTML elements or attributes.
# See: OPTIONS
warn_unknown = {{ values.warn_unknown | default(false) | lower }}

# Render pages with extremely long words wider than the screen (useful for --dump).
# See: OPTIONS
no_term_width = {{ values.no_term_width | default(false) | lower }}

# Show intermediate layouting stages before displaying the page.
# See: OPTIONS
debug = {{ values.debug | default(false) | lower }}
