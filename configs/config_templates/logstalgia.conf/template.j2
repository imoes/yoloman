; Logstalgia configuration template.
; Generated by Ansible. Do not edit manually.

[global]

; Enable colorized terminal output (True = color, False = monochrome)
{% if (logstalgia_color | default(True)) %}
color
{% else %}
nocolor
{% endif %}

; Enable IPv6 support for displaying IPv6 addresses (True = enabled, False = disabled)
{% if (logstalgia_ipv6 | default(True)) %}
ipv6
{% else %}
noipv6
{% endif %}

; Number of worker threads (0 = auto-detect CPU count)
threads {{ (logstalgia_threads | default(0)) }}

; Log format type: 'apache' or 'nginx'
format {{ (logstalgia_format | default('apache')) }}

; Path to TrueType font for rendering text
font {{ (logstalgia_font_path | default('/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf')) }}

; Use precomputed favicon cache for faster rendering (True = enabled, False = disabled)
{% if (logstalgia_precompiled_favicon | default(True)) %}
precompiled_favicon
{% else %}
nofavicon
{% endif %}

[display]

; Playback speed multiplier (e.g., 1 = real-time, 2 = 2x faster)
speed {{ (logstalgia_speed | default(1)) }}

; Output width in characters (0 = auto-detect terminal size)
width {{ (logstalgia_width | default(0)) }}

; Output height in lines (0 = auto-detect terminal size)
height {{ (logstalgia_height | default(0)) }}

; Show request duration bars (True = enabled, False = disabled)
{% if (logstalgia_durations | default(True)) %}
durations
{% else %}
nodurations
{% endif %}

; Show response size bars (True = enabled, False = disabled)
{% if (logstalgia_sizes | default(True)) %}
sizes
{% else %}
nosizes
{% endif %}

; Show client hostnames/IPs instead of masked dots (True = enabled, False = disabled)
{% if (logstalgia_hostnames | default(False)) %}
hostnames
{% else %}
nohostnames
{% endif %}

; Show full request paths instead of masked URLs (True = enabled, False = disabled)
{% if (logstalgia_paths | default(False)) %}
paths
{% else %}
nopath
{% endif %}

; Show HTTP method (GET, POST, etc.) (True = enabled, False = disabled)
{% if (logstalgia_methods | default(True)) %}
methods
{% else %}
nomethods
{% endif %}

; Show HTTP status codes (e.g., 200, 404) (True = enabled, False = disabled)
{% if (logstalgia_statuscodes | default(True)) %}
statuscodes
{% else %}
nostatuscodes
{% endif %}

; Show referrer URLs (True = enabled, False = disabled)
{% if (logstalgia_referrers | default(False)) %}
referrers
{% else %}
noreferrers
{% endif %}

; Show user agent strings (True = enabled, False = disabled)
{% if (logstalgia_useragents | default(False)) %}
useragents
{% else %}
nouseragents
{% endif %}

; Show a progress bar during replay (True = enabled, False = disabled)
{% if (logstalgia_progress | default(True)) %}
progress
{% else %}
noprogress
{% endif %}

; Show the Logstalgia ASCII logo (True = enabled, False = disabled)
{% if (logstalgia_logo | default(True)) %}
logo
{% else %}
nologo
{% endif %}

[access]

; Maximum concurrent connections to track/display
max_connections {{ (logstalgia_max_connections | default(1000)) }}

; Idle connection timeout in seconds
connection_timeout {{ (logstalgia_connection_timeout | default(300)) }}

; Buffer log input before rendering (recommended for high volume) (True = enabled, False = disabled)
{% if (logstalgia_buffered | default(True)) %}
buffered
{% else %}
unbuffered
{% endif %}

; Lines to buffer before flushing to display
buffer_size {{ (logstalgia_buffer_size | default(10000)) }}

; List of log files to stream (supports multiple files and stdin)
{% if (logstalgia_log_files | default([])) %}
{% for log_file in logstalgia_log_files %}
; Source log file entry {{ loop.index }}
{% if log_file is mapping %}
{% if log_file.path is defined and log_file.path %}
log {{ log_file.path }}
{% endif %}
{% elif log_file is string and log_file %}
log {{ log_file }}
{% endif %}
{% endfor %}
{% else %}
; Fallback default log file path (used if log_files is empty)
log {{ (logstalgia_default_log_path | default('/var/log/apache2/access.log')) }}
{% endif %}

; Legacy alias for the access log file (deprecated; prefer log_files)
{% if (logstalgia_access_log_path | default('')) %}
access_log {{ (logstalgia_access_log_path | default('')) }}
{% endif %}

[output]

; Path to output video file (requires FFmpeg support)
{% if (logstalgia_output_video_path | default('')) %}
output {{ (logstalgia_output_video_path | default('')) }}
{% endif %}

; Video frame rate in frames per second
framerate {{ (logstalgia_framerate | default(25)) }}

; Output video width in pixels
video_width {{ (logstalgia_video_width | default(1280)) }}

; Output video height in pixels
video_height {{ (logstalgia_video_height | default(720)) }}

; Show a time scale bar at the top of the screen (True = enabled, False = disabled)
{% if (logstalgia_timescale | default(True)) %}
timescale
{% else %}
notimescale
{% endif %}