{
  "identity": "mme.corenet.example.com",
  "realm": "corenet.example.com",
  "vendor_id": 10415,
  "product_name": "FreeDiameter MME",
  "fqdn_format": true,
  "use_tls": true,
  "use_dtls": false,
  "tls_certificate_file": "/etc/freediameter/mme-cert.pem",
  "tls_private_key_file": "/etc/freediameter/mme-key.pem",
  "ca_list": "/etc/freediameter/ca-chain.pem",
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 3868,
      "proto": "sctp"
    },
    {
      "address": "0.0.0.0",
      "port": 3868,
      "proto": "tcp"
    }
  ],
  "allowed_peers": [
    "hss.corenet.example.com",
    "pcscf.corenet.example.com"
  ],
  "extensions": [
    {
      "path": "libfreediameter-3gpp.so",
      "enabled": true
    },
    {
      "path": "libfreediameter-dcca.so",
      "enabled": true
    }
  ],
  "log_file": "/var/log/freediameter/mme.log",
  "log_level": 7,
  "disabled_commands": [],
  "originate_conn": true,
  "cnx_retry_time": 30,
  "cnx_max_retry_time": 300,
  "cnx_max_retrans": 3
}
