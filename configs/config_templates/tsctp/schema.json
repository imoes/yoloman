{
  "local_addresses": {
    "type": "list",
    "default": [
      "0.0.0.0",
      "::"
    ],
    "description": "List of local addresses to bind/listen on. Use 0.0.0.0 for IPv4 and :: for IPv6."
  },
  "port": {
    "type": "number",
    "default": 1234,
    "description": "Port number for the SCTP socket."
  },
  "remote_address": {
    "type": "string",
    "default": "",
    "description": "Remote address to connect to. If empty, runs in server mode."
  },
  "number_of_messages": {
    "type": "number",
    "default": 0,
    "description": "Number of messages to send. 0 means infinite."
  },
  "buffer_size": {
    "type": "number",
    "default": 1000,
    "description": "Size of send/receive buffer (message size)."
  },
  "sndbufsize": {
    "type": "number",
    "default": 0,
    "description": "Socket send buffer size. 0 uses system default."
  },
  "rcvbufsize": {
    "type": "number",
    "default": 0,
    "description": "Socket receive buffer size. 0 uses system default."
  },
  "timetolive": {
    "type": "number",
    "default": 0,
    "description": "Time to live for messages."
  },
  "runtime": {
    "type": "number",
    "default": 0,
    "description": "Runtime limit in seconds. 0 means no limit."
  },
  "adaptation_indication": {
    "type": "string",
    "default": "0",
    "description": "Adaptation layer indication value.",
    "enum": [
      "0",
      "1",
      "8",
      "10",
      "13",
      "27"
    ]
  },
  "auth_chunk_type": {
    "type": "string",
    "default": "DATA",
    "description": "Chunk type to authenticate.",
    "enum": [
      "DATA",
      "COOKIE",
      "ECHO"
    ]
  },
  "fragmentation_point": {
    "type": "number",
    "default": 0,
    "description": "Fragmentation point."
  },
  "udp_port": {
    "type": "number",
    "default": 0,
    "description": "Port for UDP encapsulation. 0 disables UDP encapsulation."
  },
  "disable_nagle": {
    "type": "bool",
    "default": false,
    "description": "Turns Nagle algorithm off."
  },
  "unordered": {
    "type": "bool",
    "default": false,
    "description": "Set use of unordered messages."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output."
  },
  "very_verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable very verbose output."
  },
  "ipv4_only": {
    "type": "bool",
    "default": false,
    "description": "Use IPv4 only."
  },
  "ipv6_only": {
    "type": "bool",
    "default": false,
    "description": "Use IPv6 only."
  }
}
