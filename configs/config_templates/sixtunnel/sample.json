{
  "listen_addr": "::",
  "listen_port": 8080,
  "dest_host": "example.com",
  "dest_port": 443,
  "user": "nobody",
  "ipv4_enabled": false,
  "ipv6_enabled": true,
  "buffer_size": 131072,
  "idle_timeout": 600,
  "daemonize": true,
  "pid_file": "/run/6tunnel.pid",
  "log_file": "syslog",
  "max_connections": 2048,
  "extra_forwarding": [
    {
      "local_addr": "127.0.0.1",
      "local_port": 2222,
      "remote_host": "internal-server",
      "remote_port": 22
    },
    {
      "local_addr": "192.168.1.10",
      "local_port": 9000,
      "remote_host": "localhost",
      "remote_port": 9000
    }
  ]
}
