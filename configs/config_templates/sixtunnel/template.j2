# sixtunnel TCP tunneling proxy configuration
# ===============================================
# This file defines a single TCP port forwarding rule and optional extra rules.

# [listen]
# Local IP address (IPv4 or IPv6) to bind the proxy to. Use 0.0.0.0 for all IPv4
# interfaces, or :: for all interfaces.
listen_addr = "{{ (listen_addr | default('0.0.0.0')) | string }}"

# Local TCP port number to listen on for incoming connections.
listen_port = {{ listen_port | default(8080) }}

# [destination]
# Remote host (hostname or IP) to which traffic will be forwarded.
dest_host = "{{ (dest_host | default('127.0.0.1')) | string }}"

# Remote port on dest_host to forward traffic to.
dest_port = {{ dest_port | default(80) }}

# [process]
# System user to drop privileges to after binding to the port (must be an
# unprivileged user).
user = "{{ (user | default('nobody')) | string }}"

# [protocol]
# If true, enable IPv4 support (listen and forward using IPv4).
ipv4_only = {{ ipv4_enabled | default(True) | ternary('true', 'false') }}

# If true, enable IPv6 support (listen and forward using IPv6).
ipv6_only = {{ ipv6_enabled | default(False) | ternary('true', 'false') }}

# [performance]
# Size of internal read/write buffer in bytes (larger buffers may improve
# throughput).
buffer_size = {{ buffer_size | default(65536) }}

# [connection]
# Number of seconds of inactivity before closing a connection (0 = no timeout).
idle_timeout = {{ idle_timeout | default(300) }}

# [daemon]
# Maximum number of concurrent connections allowed.
max_connections = {{ max_connections | default(1024) }}

# If true, run as a background daemon process. If false, run in the foreground.
daemonize = {{ daemonize | default(True) | ternary('true', 'false') }}

# Path to the PID file (only used when daemonize=true). Set to empty to disable.
{% if (pid_file | default('/var/run/6tunnel.pid')) != '' %}
pid_file = "{{ (pid_file | default('/var/run/6tunnel.pid')) | string }}"
{% endif %}

# [logging]
# Path to the log file, or 'syslog' to use the system logger.
log_file = "{{ (log_file | default('syslog')) | string }}"

# [forwarding]
# List of additional forwarding rules. Each rule specifies a local address:port
# and remote host:port to proxy.
{% for rule in (extra_forwarding | default([]) | list) %}
{{ rule.local_addr }}:{{ rule.local_port }} -> {{ rule.remote_host }}:{{ rule.remote_port }}
{% endfor %}