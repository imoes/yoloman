# kxgencert configuration template
# This package provides utilities for generating X.509 certificates and keys.
# It is a tooling/utility package and does not expose a network service itself.
# Configuration is typically performed via command-line arguments or environment variables
# passed by the Ansible playbook, rather than a static configuration file.
# However, if persistent settings are required, they can be defined here.

# Global verbosity level for logging (0=quiet, 1=standard, 2=debug)
# Default: 0
# verbosity = {{ kxgencert_verbosity | default(0) }}

# Path to the OpenSSL binary to use
# Default: /usr/bin/openssl
# openssl_bin = {{ kxgencert_openssl_bin | default('/usr/bin/openssl') }}

# Default certificate validity period in days
# Default: 365
# default_days = {{ kxgencert_default_days | default(365) }}

# Default key size for RSA keys
# Default: 2048
# default_key_size = {{ kxgencert_default_key_size | default(2048) }}

# Default cipher suite for generated keys (if applicable)
# Default: AES-256-CBC
# default_cipher = {{ kxgencert_default_cipher | default('AES-256-CBC') }}

# Directory for storing generated certificates and keys
# Default: /etc/pki/kxgencert
# cert_store_path = {{ kxgencert_cert_store_path | default('/etc/pki/kxgencert') }}

# Directory for storing certificate requests (CSRs)
# Default: /etc/pki/kxgencert/csr
# csr_store_path = {{ kxgencert_csr_store_path | default('/etc/pki/kxgencert/csr') }}

# Directory for storing private keys
# Default: /etc/pki/kxgencert/keys
# key_store_path = {{ kxgencert_key_store_path | default('/etc/pki/kxgencert/keys') }}

# Permission mode for generated private keys (octal string)
# Default: '0600'
# key_permissions = {{ kxgencert_key_permissions | default('0600') }}

# Permission mode for generated certificates (octal string)
# Default: '0644'
# cert_permissions = {{ kxgencert_cert_permissions | default('0644') }}

# Enable validation of generated certificates against CA
# Default: true
# validate_on_generate = {{ kxgencert_validate_on_generate | default(true) | lower }}

# Enable auto-renewal checks (if integrated with a scheduler)
# Default: false
# auto_renew = {{ kxgencert_auto_renew | default(false) | lower }}

# CA certificate path for signing requests (if acting as a CA client)
# Default: '' (empty, implying self-signed or external CA)
# ca_cert_path = {{ kxgencert_ca_cert_path | default('') }}

# CA private key path for signing requests (if acting as a CA client)
# Default: '' (empty, implying self-signed or external CA)
# ca_key_path = {{ kxgencert_ca_key_path | default('') }}

# CA serial file path
# Default: /etc/pki/kxgencert/serial
# ca_serial_path = {{ kxgencert_ca_serial_path | default('/etc/pki/kxgencert/serial') }}

# Log file path for kxgencert operations
# Default: /var/log/kxgencert.log
# log_file = {{ kxgencert_log_file | default('/var/log/kxgencert.log') }}