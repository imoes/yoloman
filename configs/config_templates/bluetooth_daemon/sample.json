{
  "enable_service": true,
  "device_name": "My-PC-Bluetooth",
  "short_name": "MyPC-BT",
  "discoverable_timeout": 0,
  "pairing_timeout": 30,
  "page_timeout": 256,
  "inquiry_scan_interval": 256,
  "inquiry_scan_window": 256,
  "page_scan_interval": 256,
  "page_scan_window": 256,
  "device_class": "0x000104",
  "supported_services": [
    "SerialPort",
    "Handsfree",
    "Headset"
  ],
  "auto_enable": [
    "Network",
    "Input"
  ],
  "le_supported": true,
  "le_advertising_interval_min": 800,
  "le_advertising_interval_max": 800,
  "max_connected": 8,
  "debug": false,
  "adapter_data_paths": [
    {
      "adapter": "hci0",
      "path": "/var/lib/bluetooth/hci0"
    },
    {
      "adapter": "hci1",
      "path": "/var/lib/bluetooth/hci1"
    }
  ],
  "legacy_pairing": true,
  "mitm_protection": false,
  "secure_simple_pairing": true,
  "justworks_repairing": false,
  "gatt_primary_service": true,
  "experimental": false,
  "offload": true,
  "hfp": true,
  "a2dp": true,
  "avdtp": true,
  "codecs": [
    "aptX:1",
    "AAC:1"
  ],
  "sink_latency": 200,
  "media": true,
  "media_backend": "bluez",
  "a2dp_endpoints": 3
}
