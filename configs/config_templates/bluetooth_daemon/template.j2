# BlueZ Bluetooth daemon configuration file
# This template generates a self-documenting main.conf.
# Each directive is prefixed with its schema description for clarity.

[General]

# Enable the Bluetooth daemon at system startup.
# Set to 'true' to enable the service, 'false' to disable.
Enable={{ enable_service | default(true) | lower }}

# Human-readable name of the Bluetooth adapter, shown during device discovery.
# Typically 8-32 characters.
Name={{ device_name | default('Linux Bluetooth') }}

# Short name (≤ 8 chars) used in BLE advertising and GATT discovery.
# Used when the full name is too long or for specific profiles.
ShortName={{ short_name | default('BT-Host') }}

# Seconds until the adapter stops being discoverable (0 = always discoverable).
# Set to 30–60 for desktops/laptops to conserve battery; 0 for servers.
DiscoverableTimeout={{ discoverable_timeout | default(0) }}

# Seconds to wait for a pairing operation to complete before timing out.
PairingTimeout={{ pairing_timeout | default(60) }}

# Maximum time (in 0.625ms units) to wait for a page response during inquiry.
# Higher values improve reliability for distant devices.
PageTimeout={{ page_timeout | default(256) }}

# Interval (in 0.625ms units) between inquiry scans.
# Lower = more responsive, higher power use.
InquiryScanInterval={{ inquiry_scan_interval | default(256) }}

# Duration (in 0.625ms units) of each inquiry scan.
# Usually equal to scan interval.
InquiryScanWindow={{ inquiry_scan_window | default(256) }}

# Interval (in 0.625ms units) between page scans for connecting to known devices.
PageScanInterval={{ page_scan_interval | default(256) }}

# Duration (in 0.625ms units) of each page scan.
# Typically equals scan interval.
PageScanWindow={{ page_scan_window | default(256) }}

# Bluetooth device class (major/minor/service) indicating device type and capabilities.
# Format: 0x<3 digits hex>, e.g., 0x000104.
DeviceClass={{ device_class | default('0x000104') }}

# List of Bluetooth service classes to advertise (e.g., 'SerialPort', 'Handsfree').
# Empty list means no services advertised.
# Output is space-separated.
SupportedServices={{ supported_services | default([]) | join(' ') }}

# Bluetooth profiles/services to auto-enable when the adapter starts.
# Comma-separated list; default is 'Network, Input'.
AutoEnable={{ auto_enable | default(['Network', 'Input']) | join(', ') }}

# Enable Bluetooth Low Energy (BLE) support on this adapter.
# Required for modern peripherals (beacons, health monitors, etc.).
LESupported={{ le_supported | default(true) | lower }}

# Minimum LE advertising interval (in 0.625ms units).
# Lower = faster discovery, higher power consumption.
LEAdvertisingIntervalMin={{ le_advertising_interval_min | default(800) }}

# Maximum LE advertising interval (in 0.625ms units).
# Usually equal to min for constant advertising; higher ranges allow adaptive duty cycles.
LEAdvertisingIntervalMax={{ le_advertising_interval_max | default(800) }}

# Maximum number of simultaneous active connections.
# Controls headsets, keyboards, mice, etc.
MaxConnected={{ max_connected | default(8) }}

# Enable verbose debug logging to help diagnose issues.
# Logs appear in journal or /var/log/bluetooth/ depending on system setup.
Debug={{ debug | default(false) | lower }}

# List of per-adapter storage paths for pairing data.
# Used in multi-adapter systems to isolate keys/trust data.
# The schema defines 'adapter_data_paths' as a list.
{% for path in adapter_data_paths | default([]) %}
AdapterPath{{ loop.index }}={{ path | default('') }}
{% endfor %}

# Enable legacy (non-secure) pairing for compatibility with older devices.
LegacyPairing={{ legacy_pairing | default(true) | lower }}

# Require Man-in-the-Middle (MITM) protection (e.g., passkey entry) for pairing.
# Enable for security-critical devices; disable for convenience/peripherals without I/O.
MITMProtection={{ mitm_protection | default(false) | lower }}

# Enforce Secure Simple Pairing (SSP).
# Recommended for all modern devices; provides improved security over legacy pairing.
SecureSimplePairing={{ secure_simple_pairing | default(true) | lower }}

# Allow 'Just Works' (no user interaction) pairing.
# Disable for security-sensitive environments where user confirmation is required.
JustWorksRepairing={{ justworks_repairing | default(true) | lower }}

# Expose BLE GATT server functionality system-wide.
# Required for smart devices and custom BLE services.
GATTPrimaryService={{ gatt_primary_service | default(true) | lower }}

# Enable experimental/unsafe features.
# Only use if required by specific hardware or protocol specifications.
Experimental={{ experimental | default(false) | lower }}

# Enable hardware offloading for BLE connections.
# Improves performance and battery life if supported by the controller.
Offload={{ offload | default(false) | lower }}

# Enable Hands-Free Profile (HFP) for hands-free headsets and car kits.
HFP={{ hfp | default(true) | lower }}

# Enable Advanced Audio Distribution Profile (A2DP) for high-quality stereo audio streaming.
A2DP={{ a2dp | default(true) | lower }}

# Enable AVDTP — required for A2DP streaming.
AVDTP={{ avdtp | default(true) | lower }}

# List of audio codecs to enable, in format '<codec>:<enabled>'.
# Example: 'aptX:1 ldac:1'. Empty list defaults to system codecs.
Codecs={{ codecs | default([]) | join(' ') }}

# Target audio latency (in ms) for A2DP sinks.
# 0 = automatic tuning. Range: 0–1000.
SinkLatency={{ sink_latency | default(0) }}

# Enable remote media control (play/pause/next/prev via headset buttons).
Media={{ media | default(true) | lower }}

# Backend for media control (e.g., 'bluez', 'mpris').
# 'bluez' integrates with BlueZ; 'mpris' uses system media controls.
MediaBackend={{ media_backend | default('bluez') }}

# Maximum concurrent A2DP sources or sinks.
# Limits simultaneous audio streams.
A2DPEndpoints={{ a2dp_endpoints | default(2) }}