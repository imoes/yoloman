{
  "syslog_facility": "mail",
  "logfile": "/var/log/kuvert.log",
  "mail_on_error": "admin@example.com",
  "queuedir": "/home/user/.kuvert_queue",
  "tempdir": "",
  "identify": true,
  "preamble": true,
  "interval": 30,
  "msserver": "smtp.example.com",
  "msport": 587,
  "ssl": "starttls",
  "ssl_cert": "/etc/kuvert/client.pem",
  "ssl_key": "/etc/kuvert/client-key.pem",
  "ssl_ca": "/etc/ssl/certs/ca-certificates.crt",
  "msuser": "user@example.com",
  "mspass": "supersecretpassword",
  "mspass_from_query_secret": false,
  "msp": "",
  "gpg": "gpg",
  "can_detach": true,
  "maport": 2587,
  "ma_user": "kuvertuser",
  "ma_pass": "kuvertpassword",
  "default_key": "0x1234567890ABCDEF",
  "default_action": "fallback",
  "always_trust": true,
  "use_agent": true,
  "query_secret": "",
  "flush_secret": "",
  "rules": [
    {
      "address": "^.*-request@.*$",
      "action": "none",
      "key": ""
    },
    {
      "address": "trusted-internal.*@example\\.com$",
      "action": "fallback",
      "key": "0x1234567890ABCDEF"
    },
    {
      "address": ".*@secure-domain\\.org$",
      "action": "mustencrypt",
      "key": ""
    }
  ]
}
