# Nagzilla configuration file
# This file controls the connection parameters for the Nagzilla monitoring agent.

# Nagzilla server to connect to
# Hostname or IP address of the Nagzilla server to connect to.
NagzillaServer = {{ nagzilla_server | default('127.0.0.1') }}

# Nagzilla Server port to use
# Port number of the Nagzilla server to connect to.
NagzillaPort = {{ nagzilla_port | default('49776') }}
