# Defaults for nagzilla initscript
# sourced by /etc/init.d/nagzilla
# installed at /etc/default/nagzilla by the maintainer scripts
# This file is used by the systemd/sysvinit service wrapper to control
# whether the nagzilla daemon (nagzillad) and its cache daemon (nagzillac)
# are started during boot or service enablement.

# Whether to start the nagzilla service (yes or no)
# If set to 'no', the services will be disabled but remain installed.
RUN="{{ run | default('no') }}"