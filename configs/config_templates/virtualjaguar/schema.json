{
  "rom_path": {
    "type": "string",
    "default": "/opt/games/jaguar/roms/example.j64",
    "description": "Path to the Atari Jaguar ROM image file to load."
  },
  "alpine_mode": {
    "type": "bool",
    "default": false,
    "description": "Run in Alpine emulation mode (-a, --alpine)."
  },
  "use_bios": {
    "type": "bool",
    "default": true,
    "description": "Boot using Jaguar BIOS (-b, --bios). Default is true."
  },
  "enable_gpu": {
    "type": "bool",
    "default": true,
    "description": "Enable GPU emulation (-g, --gpu)."
  },
  "enable_logging": {
    "type": "bool",
    "default": false,
    "description": "Create and use a log file (-l, --log). Only written if enabled."
  },
  "enable_dsp": {
    "type": "bool",
    "default": true,
    "description": "Enable DSP emulation for audio output (-d, --no-dsp)."
  },
  "fullscreen": {
    "type": "bool",
    "default": false,
    "description": "Start in full screen mode (-f, --fullscreen)."
  },
  "video_mode": {
    "type": "string",
    "default": "NTSC",
    "description": "Video output mode. Either 'NTSC' (-n) or 'PAL' (-p).",
    "enum": [
      "NTSC",
      "PAL"
    ]
  },
  "enable_blur": {
    "type": "bool",
    "default": false,
    "description": "Enable GL bilinear filter (-B, --no-blur)."
  },
  "disable_tv_static": {
    "type": "bool",
    "default": false,
    "description": "Do not show emulation of tv static for performance (--please-dont-kill-my-computer)."
  }
}
