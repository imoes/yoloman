{
  "debug": false,
  "max_image_width": 65536,
  "max_image_height": 65536,
  "cache_size_mb": 4096,
  "quality": 90,
  "dcm_enabled": true,
  "image_directories": [
    {
      "path": "/srv/images",
      "read_only": true
    },
    {
      "path": "/mnt/external/collections",
      "read_only": true
    }
  ],
  "bind_address": "0.0.0.0",
  "bind_port": 8000,
  "use_fastcgi_socket": true,
  "fastcgi_socket_path": "/run/iipimage.sock",
  "tile_size": 512,
  "max_tile_cache_size": 2000,
  "compression_format": "jpeg",
  "watermark_path": "/etc/iipimage/watermark.png",
  "client_caching_enabled": true,
  "client_cache_ttl_seconds": 86400,
  "log_file": "/var/log/iipimage/server.log",
  "jpeg2000_enabled": true,
  "jpeg2000_threads": 4,
  "tiff_multipage_enabled": true,
  "large_tiff_support": true,
  "min_level": 0,
  "max_level": 20,
  "progressive_loading": true
}
