# ===========================================================================
# rpmlint-redhat Configuration Template
# ===========================================================================
# This template configures rpmlint, a static analysis tool for RPM packages.
# It reads configuration from this file and any other *.config files
# in the same directory (usually /etc/rpmlint).
#
# Since the schema for 'rpmlint-redhat' contains no fields, this template
# serves as a documentation placeholder and a clean slate for manual
# configuration or role-specific overrides via other mechanisms.
# ===========================================================================

# --- Global Settings ---

# Define which distributions/rpm versions this config applies to.
# Example: "fedora-38", "rhel-9"
# If not specified, rpmlint uses heuristics based on the package being tested.
# # disturl = "fedora-38"

# --- Check Configuration ---

# Enable or disable specific checks by name.
# You can enable checks with '+' and disable with '-' (or '!').
# Example: "+package" to enable package checks, "-doc" to disable documentation checks.
# # +package
# -doc

# --- Package Requirements ---

# Define mandatory and optional requirements for packages.
# This section helps enforce policy on what packages must or must not contain.
# Example:
# RequiredBinaries: /usr/bin/foo
# ForbiddenBinaries: /usr/bin/bar

# --- Documentation Checks ---

# Control documentation-related checks.
# # DocumentationDir: /usr/share/doc
# # DocumentationFiles: "*.txt", "*.md"

# --- Filelist Checks ---

# Control checks related to file ownership and permissions.
# # FileOwnership: "root:root"
# # FilePermissions: "0644"

# --- Binary Checks ---

# Control checks for ELF binaries.
# # BinaryCheck: true
# # RequireRpath: false

# --- Specfile Checks ---

# Control checks for .spec files.
# # SpecCheck: true
# # RequireChangelog: true
# # RequireLicense: true

# --- Other Checks ---

# Control various other checks (scripts, macros, etc.).
# # ScriptCheck: true
# # MacroCheck: true

# --- Output Configuration ---

# Configure output format and verbosity.
# # Verbose: false
# # Output: stdout
# # Color: auto

# ===========================================================================
# End of rpmlint configuration
# ===========================================================================
