# ============================================================================
# JodConverter Configuration Template
# ============================================================================
# This configuration file defines how JodConverter connects to a LibreOffice
# instance running in headless listener mode (soffice --accept=...).
#
# Self-documenting: Each directive includes its schema description and defaults.
# ============================================================================

# ----------------------------------------------------------------------------
# LibreOffice Listener Host
# ----------------------------------------------------------------------------
# Description: The hostname or IP address of the LibreOffice instance.
# Note:        Usually 'localhost' if LibreOffice and JodConverter run on the same host.
SOFFICE_HOST={{ host | default('localhost') }}

# ----------------------------------------------------------------------------
# LibreOffice Listener Port
# ----------------------------------------------------------------------------
# Description: The port number on which LibreOffice listens for conversion requests (default 8100).
# Source:      soffice --accept="socket,port=8100;urp;"
SOFFICE_PORT={{ port | default(8100) }}

# ----------------------------------------------------------------------------
# Document Conversion Timeout
# ----------------------------------------------------------------------------
# Description: Maximum time in seconds to wait for a document conversion to complete.
CONVERSION_TIMEOUT={{ timeout | default(60) }}