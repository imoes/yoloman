# ==============================================================================
# pgnodemx extension configuration for PostgreSQL
# ==============================================================================
# This file configures the pgnodemx PostgreSQL extension, which collects
# OS-level metrics (CPU, memory, disk I/O, network) directly from within
# the database server process.
# ==============================================================================

# --------------------------------------------------------------------------
# Shared Preload Libraries
# --------------------------------------------------------------------------
# Description: Libraries to preload at PostgreSQL server start.
# The pgnodemx extension must be preloaded to function.
shared_preload_libraries = 'pgnodemx'

# --------------------------------------------------------------------------
# Data Directory for pgnodemx Metrics
# --------------------------------------------------------------------------
# Description: Optional directory to store temporary pgnodemx metric data files.
# Leave empty to use PostgreSQL’s data directory.
# Default: ''
pgnodemx.data_directory = '{{ (pgnodemx_data_directory | default('')) | string | trim | quote }}'

# --------------------------------------------------------------------------
# Sample Interval
# --------------------------------------------------------------------------
# Description: Time in milliseconds between OS metric samples. Minimum 1000 ms recommended.
# Default: 2000
pgnodemx.sample_interval_ms = {{ pgnodemx_sample_interval_ms | default(2000) | int }}

# --------------------------------------------------------------------------
# CPU Metrics Collection
# --------------------------------------------------------------------------
# Description: Enable or disable CPU metric collection (e.g., user, system, idle percentages).
# Default: True
pgnodemx.cpu_enabled = {{ pgnodemx_cpu_enabled | default(true) | ternary('on', 'off') }}

# --------------------------------------------------------------------------
# Memory Metrics Collection
# --------------------------------------------------------------------------
# Description: Enable or disable memory metric collection (total, used, free, buffers, cached).
# Default: True
pgnodemx.memory_enabled = {{ pgnodemx_memory_enabled | default(true) | ternary('on', 'off') }}

# --------------------------------------------------------------------------
# Disk I/O Metrics Collection
# --------------------------------------------------------------------------
# Description: Enable or disable disk I/O metric collection (read/write throughput and latency).
# Default: True
pgnodemx.disk_enabled = {{ pgnodemx_disk_enabled | default(true) | ternary('on', 'off') }}

# --------------------------------------------------------------------------
# Network Metrics Collection
# --------------------------------------------------------------------------
# Description: Enable or disable network metric collection (bytes/packets in/out, errors).
# Default: False
pgnodemx.network_enabled = {{ pgnodemx_network_enabled | default(false) | ternary('on', 'off') }}

# --------------------------------------------------------------------------
# Network Interfaces to Monitor
# --------------------------------------------------------------------------
# Description: List of network interfaces to monitor. Leave empty to monitor all non-loopback interfaces.
# Default: []
{% for iface in (pgnodemx_network_interfaces | default([])) %}
# Interface: {{ iface | string | trim }}
pgnodemx.network_interface = '{{ iface | string | trim | quote }}'
{% endfor %}

# --------------------------------------------------------------------------
# Maximum File Descriptors
# --------------------------------------------------------------------------
# Description: Maximum file descriptors pgnodemx may open (0 = use system default).
# Set higher if monitoring many disks or mounts.
# Default: 0
pgnodemx.max_file_descriptors = {{ pgnodemx_max_file_descriptors | default(0) | int }}

# --------------------------------------------------------------------------
# Log Level
# --------------------------------------------------------------------------
# Description: Log verbosity for pgnodemx internal messages. Use 'debug' only when troubleshooting.
# Default: 'warning'
pgnodemx.log_level = '{{ pgnodemx_log_level | default('warning') | string | trim | lower | quote }}'