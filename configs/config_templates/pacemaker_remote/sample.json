{
  "ca_cert": "/etc/pacemaker/ca.crt",
  "cert": "/etc/pacemaker/remote-node1.crt",
  "key": "/etc/pacemaker/remote-node1.key",
  "trusted_certs": [
    "/etc/pki/tls/certs/intermediate-ca.crt"
  ],
  "listen_addr": "192.168.10.50",
  "listen_port": 3128,
  "max_connections": 50,
  "enable_tls": true,
  "auth": "pam",
  "pam_service": "pacemaker-remote",
  "log_level": "notice",
  "log_dest": "syslog",
  "resources": [
    {
      "name": "web-service",
      "exec": "httpd.service",
      "user": "apache"
    },
    {
      "name": "custom-app",
      "exec": "/opt/custom/app-wrapper.sh"
    }
  ],
  "shutdown_timeout": 45
}
