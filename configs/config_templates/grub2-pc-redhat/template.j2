# Grub2-PC Configuration
# This is the default configuration for GRUB2 PC platform.
# No specific parameters to parametrize in the base grub.cfg generation script itself,
# as the actual configuration is generated by grub-mkconfig based on
# /etc/default/grub and scripts in /etc/grub.d/.
# However, the question implies parametrizing a config file shipped by the package.
# For grub2-pc, the main editable default configuration file is /etc/default/grub.

# If this refers to /etc/default/grub content:

# The default boot entry for GRUB. Can be a number, menuentry title, or 'saved'.
GRUB_DEFAULT={{ GRUB_DEFAULT | default('0') }}

# Time in seconds that GRUB will wait before booting the default entry.
GRUB_TIMEOUT={{ GRUB_TIMEOUT | default(5) }}

# The style of the GRUB menu display. Can be 'menu', 'hidden', 'countdown', or 'hidden_countdown'.
GRUB_TIMEOUT_STYLE={{ GRUB_TIMEOUT_STYLE | default('menu') }}

# This line is typically auto-generated or handled by scripts, but kept for compatibility.
GRUB_DISTRIBUTOR=`(lsb_release -i 2>/dev/null || echo Debian) | sed 's/^\(.*\)-b\(.*\)$/\1/'`

# Default parameters appended to the Linux kernel command line for normal boots.
GRUB_CMDLINE_LINUX_DEFAULT="{{ GRUB_CMDLINE_LINUX_DEFAULT | default('quiet') }}"

# Additional parameters appended to the Linux kernel command line for all boots.
GRUB_CMDLINE_LINUX="{{ GRUB_CMDLINE_LINUX | default('') }}"

# Uncomment to enable boot proofing
# GRUB_DISABLE_RECOVERY="true"

# Uncomment to disable graphical terminal
# GRUB_TERMINAL_OUTPUT="console"

# Uncomment to make Grub remember the last selection.
# GRUB_SAVEDEFAULT="true"

# Uncomment to customize the menu background
# GRUB_BACKGROUND="/path/to/image"

# Uncomment to customize the menu foreground
# GRUB_COLOR_NORMAL="light-blue/black"
# GRUB_COLOR_HIGHLIGHT="light-cyan/black"
