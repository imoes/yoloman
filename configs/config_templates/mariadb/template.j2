[mysqld]
# Basic server identification and logging
server-id = {{ server_id }}
log_bin = {{ 'mysql-bin' if log_bin_enabled else '' }}

# Data directory and temporary files
basedir = {{ basedir }}
datadir = {{ datadir }}
tmpdir = {{ tmpdir }}

# Network and connection settings
bind_address = {{ bind_address }}
port = {{ port }}
max_connections = {{ max_connections }}
max_allowed_packet = {{ max_allowed_packet }}

# InnoDB engine configuration
innodb_buffer_pool_size = {{ innodb_buffer_pool_size }}
innodb_log_file_size = {{ innodb_log_file_size }}
innodb_flush_log_at_trx_commit = {{ innodb_flush_log_at_trx_commit }}
innodb_file_per_table = {{ 1 if innodb_file_per_table else 0 }}

# Query cache (deprecated in newer MariaDB versions, but kept for compatibility)
query_cache_type = {{ query_cache_type }}
query_cache_size = {{ query_cache_size }}

# Thread handling
thread_cache_size = {{ thread_cache_size }}

# Character set and collation
character_set_server = {{ character_set_server }}
collation_server = {{ collation_server }}

# Slow query logging
slow_query_log = {{ '1' if slow_query_log_enabled else '0' }}
slow_query_log_file = {{ slow_query_log_file }}
long_query_time = {{ long_query_time }}

# Binary logging (for replication)
log_bin_trust_function_creators = {{ 1 if log_bin_trust_function_creators else 0 }}

# Replication (master) settings
{% for replica_host in replication_hosts %}
{% if replica_host.role == 'master' %}
# Replication: Master settings for {{ replica_host.name }}
server-id = {{ replica_host.server_id }}
binlog_format = {{ replica_host.binlog_format }}
expire_logs_days = {{ replica_host.expire_logs_days }}
{% endif %}
{% endfor %}

# Replication (slave) settings
{% for replica_host in replication_hosts %}
{% if replica_host.role == 'slave' %}
# Replication: Slave settings for {{ replica_host.name }}
server-id = {{ replica_host.server_id }}
relay_log = {{ replica_host.relay_log }}
read_only = {{ 1 if replica_host.read_only else 0 }}
{% endif %}
{% endfor %}

# Custom socket paths
socket = {{ socket }}
