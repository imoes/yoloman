# Bacula logrotate script configuration.
# Manages rotation of Bacula daemon log files located in /var/log/bacula/.
# This template ensures the configuration is self-documenting by including
# schema descriptions as comments and providing safe defaults for all variables.

/var/log/bacula/*.log {
    # Rotate logs on a monthly basis.
    monthly

    # rotate_count: Number of rotated log files to keep
    # Default: '4'
    rotate {{ rotate_count | default('4') }}

    # Do not send a notification if the log file is empty.
    notifempty

    # Do not produce an error message if the log file is missing.
    missingok
}
