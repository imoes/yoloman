# /etc/bootparams: provide diskless clients with information necessary
#                  for booting. See bootparamd(8) for further information.
#
# Format :  client id=server:path
#
# Example:  client_1   base=server_1:/path/to/basedir

# Daemon configuration for bootparamd (Bootstrap Parameter Daemon).
# This service is primarily used by diskless workstations (e.g., Etherboot/PXE)
# to retrieve boot parameters via RPC. Note: This is largely legacy technology
# and often superseded by modern DHCP/TFTP/PXE mechanisms.

# Path to the bootparamd daemon executable.
# [daemon_path]
# default: '/usr/sbin/rpc.bootparamd'
/usr/sbin/rpc.bootparamd

# Service name used for PID files, log messages, and init.d symlink.
# [service_name]
# default: 'bootparamd'
{{ (NAME | default('bootparamd')) | string }}

# Human-readable description of the service.
# [service_description]
# default: 'boot parameter server'
{{ (DESC | default('boot parameter server')) | string }}
