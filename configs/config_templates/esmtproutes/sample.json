{
  "routes": [
    {
      "domain": "example.com",
      "relay": "mail.example.com",
      "port": 587,
      "flags": [
        "starttls",
        "auth"
      ]
    },
    {
      "domain": "secure.net",
      "relay": "relay.secure.net",
      "flags": [
        "ssl"
      ]
    },
    {
      "domain": "*",
      "relay": "smtp.isp.net"
    }
  ]
}
