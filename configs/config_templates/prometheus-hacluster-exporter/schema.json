{
  "listen_address": {
    "type": "string",
    "default": "0.0.0.0:9664",
    "description": "The address and port the exporter listens on."
  },
  "telemetry_path": {
    "type": "string",
    "default": "/metrics",
    "description": "The HTTP path where Prometheus metrics are served."
  },
  "config_file_path": {
    "type": "string",
    "default": "/etc/ha_cluster_exporter.web.yaml",
    "description": "Path to the additional configuration file for the web exporter."
  },
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Minimum log level to output."
  },
  "log_format": {
    "type": "string",
    "default": "logfmt",
    "description": "Format of the log output (logfmt or json)."
  },
  "crm_mon_path": {
    "type": "string",
    "default": "/usr/sbin/crm_mon",
    "description": "Path to the crm_mon binary."
  },
  "cibadmin_path": {
    "type": "string",
    "default": "/usr/sbin/cibadmin",
    "description": "Path to the cibadmin binary."
  },
  "corosync_cfgtool_path": {
    "type": "string",
    "default": "/usr/sbin/corosync-cfgtool",
    "description": "Path to the corosync-cfgtool binary."
  },
  "corosync_quorumtool_path": {
    "type": "string",
    "default": "/usr/sbin/corosync-quorumtool",
    "description": "Path to the corosync-quorumtool binary."
  },
  "sbd_path": {
    "type": "string",
    "default": "/usr/sbin/sbd",
    "description": "Path to the sbd binary."
  },
  "sbd_config_path": {
    "type": "string",
    "default": "/etc/default/sbd",
    "description": "Path to the SBD configuration file."
  },
  "drbdsetup_path": {
    "type": "string",
    "default": "/sbin/drbdsetup",
    "description": "Path to the drbdsetup binary."
  }
}
