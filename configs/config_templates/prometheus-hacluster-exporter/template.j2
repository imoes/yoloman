# Prometheus HA Cluster Exporter Configuration
# This file configures the exporter that scrapes Pacemaker/Corosync/DRBD/SBD status
# and exposes it as Prometheus metrics.

# ============================================================
# Web Interface & Telemetry
# ============================================================

web:
  # listen_address: The address and port the exporter listens on.
  listen-address: "{{ listen_address | default('0.0.0.0:9664') }}"

  # telemetry_path: The HTTP path where Prometheus metrics are served.
  telemetry-path: "{{ telemetry_path | default('/metrics') }}"

  config:
    # config_file_path: Path to the additional configuration file for the web exporter.
    file: "{{ config_file_path | default('/etc/ha_cluster_exporter.web.yaml') }}"

# ============================================================
# Logging Configuration
# ============================================================

log:
  # log_level: Minimum log level to output (e.g., debug, info, warn, error).
  level: "{{ log_level | default('info') }}"

  # log_format: Format of the log output (logfmt or json).
  format: "{{ log_format | default('logfmt') }}"

# ============================================================
# External Binary Paths
# The exporter relies on specific cluster management binaries to gather data.
# Specify the absolute paths if they are not in the default system PATH.
# ============================================================

# crm_mon_path: Path to the crm_mon binary.
crm-mon-path: "{{ crm_mon_path | default('/usr/sbin/crm_mon') }}"

# cibadmin_path: Path to the cibadmin binary.
cibadmin-path: "{{ cibadmin_path | default('/usr/sbin/cibadmin') }}"

# corosync_cfgtool_path: Path to the corosync-cfgtool binary.
corosync-cfgtoolpath-path: "{{ corosync_cfgtool_path | default('/usr/sbin/corosync-cfgtool') }}"

# corosync_quorumtool_path: Path to the corosync-quorumtool binary.
corosync-quorumtool-path: "{{ corosync_quorumtool_path | default('/usr/sbin/corosync-quorumtool') }}"

# sbd_path: Path to the sbd binary.
sbd-path: "{{ sbd_path | default('/usr/sbin/sbd') }}"

# sbd_config_path: Path to the SBD configuration file.
sbd-config-path: "{{ sbd_config_path | default('/etc/default/sbd') }}"

# drbdsetup_path: Path to the drbdsetup binary.
drbdsetup-path: "{{ drbdsetup_path | default('/sbin/drbdsetup') }}"
