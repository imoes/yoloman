# Gufw (GUI Uncomplicated Firewall) Application Profile Configuration
# This template generates a .gufw application definition file for the "0 A.D." game server.
# It defines how the firewall should handle incoming traffic for this specific service.

[0ad]
# Title of the application/profile
title=0 A.D.

# Description displayed in the firewall GUI to help users identify the rule
description=A free/open-source RTS game of ancient warfare from Wildfire Games

# Ports and protocols allowed for this application.
# Format: "port/protocol" (e.g., "20595/udp") or a comma-separated list.
# The firewall will open these ports to allow incoming game traffic.
ports={{ ports | default('20595/udp') }}

# Categories used to group this profile in the firewall GUI.
# This helps in organizing multiple game or service profiles.
categories=Games;Strategy;

# Reference URL for documentation, support, or further information about the service.
# Useful for administrators who need to troubleshoot or verify the service requirements.
reference={{ reference | default('[http://www.wildfiregames.com/forum/index.php?s=&showtopic=13433&view=findpost&p=210378 Wildfire Games Community Forums: multiplayer components]') }}