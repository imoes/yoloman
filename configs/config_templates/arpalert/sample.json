{
  "interfaces": [
    "eth0",
    "br0"
  ],
  "allowed_macs": [
    "aa:bb:cc:dd:ee:01",
    "aa:bb:cc:dd:ee:02"
  ],
  "denied_macs": [
    "ff:ff:ff:00:00:00"
  ],
  "action": "drop",
  "log_level": 2,
  "log_file": "/var/log/arpalert.log",
  "pid_file": "/run/arpalert.pid",
  "scan_interval": 60,
  "max_delay": 3,
  "alert_new_ip_mac": true,
  "alert_duplicate_ip": true,
  "alert_duplicate_mac": true,
  "ignore_gateways": [
    "192.168.1.1",
    "10.0.0.1"
  ],
  "static_bindings": [
    {
      "ip": "192.168.1.1",
      "mac": "aa:bb:cc:dd:ee:01"
    },
    {
      "ip": "192.168.1.254",
      "mac": "aa:bb:cc:dd:ee:02"
    }
  ],
  "alert_cmd": "/usr/local/bin/arp-alert-handler.sh --ip %ip% --mac %mac%",
  "daemonize": true,
  "run_as_user": "nobody"
}
