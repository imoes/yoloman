# Globus GRAM Job Manager SLURM Configuration
# This file configures the Globus GRAM job manager to use SLURM as the batch system backend.
# Each directive specifies the path to a specific SLURM utility used for job lifecycle management.

# Root of the slurm installation
slurm_path="{{ slurm_path | default('/usr') }}"

# Path to the srun tool to run parallel jobs in a slurm cluster
srun="{{ srun | default('/usr/bin/srun') }}"

# Path to the sbatch tool to submit jobs to a slurm cluster
sbatch="{{ sbatch | default('/usr/bin/sbatch') }}"

# Path to the salloc tool to create a slurm job allocation
salloc="{{ salloc | default('/usr/bin/salloc') }}"

# Path to the scancel tool to cancel a slurm job
scancel="{{ scancel | default('/usr/bin/scancel') }}"

# Path to the scontrol tool to view the status of a slurm job
scontrol="{{ scontrol | default('/usr/bin/scontrol') }}"

# Path to the openmpi implementation if available
openmpi_path="{{ openmpi_path | default('') }}"

# Path to the mpich2 implementation if available
mpich2_path="{{ mpich2_path | default('') }}"