{
  "pexec": {
    "name": "data_processing",
    "shell": "/bin/bash",
    "max_procs": 8,
    "nice": 5,
    "remote_shell": "/usr/bin/ssh",
    "remote_pexec": "/usr/local/bin/pexec",
    "control_port": 0,
    "bind_port": 0,
    "mutex": "data_lock",
    "log_file": "/var/log/pexec/data_processing.log",
    "log_level": "warn",
    "verbose": false,
    "hypervisor_mode": false,
    "fifo_queue": false,
    "load_interval": "5min",
    "input_file": "/dev/null",
    "output_file": "/var/log/pexec/data_processing_output.log",
    "error_file": "/var/log/pexec/data_processing_error.log",
    "output_format": "[HOST:%h] [CMD:%c] %s",
    "error_format": "[HOST:%h] [CMD:%c] ERR:%s",
    "omit_newlines": false,
    "environment": "DATA_DIR=/tmp/data",
    "command": "process_data.sh",
    "parameter_file": "/etc/pexec/data_params.list",
    "param_column": 2,
    "treat_line_as_single": false,
    "parameters": [
      "host1",
      "host2"
    ],
    "atomic_command": "echo 'critical' > /var/run/critical_flag",
    "save_file": "",
    "dump_file": "/etc/pexec/mutex_content.txt",
    "connect_to": "",
    "check_status": false,
    "normal_redirection": false,
    "shell_command_mode": true,
    "multiple_command_mode": false
  }
}
