{
  "shared_preload_libraries": "pg_stat_kcache",
  "pg_stat_kcache_level": "user",
  "pg_stat_kcache_track": "queries",
  "pg_stat_kcache_top_k_queries": 100,
  "pg_stat_kcache_reset_on_dump": false,
  "pg_stat_kcache_database_rules": [
    {
      "database": "production_db",
      "include": true,
      "pattern": "app_prod_*"
    },
    {
      "database": "analytics_db",
      "include": false,
      "pattern": "analytics_*"
    }
  ],
  "pg_stat_kcache_sample_rate": 10,
  "pg_stat_kcache_track_time": true,
  "pg_stat_kcache_track_io": true,
  "pg_stat_kcache_track_context": false
}
