# ==============================================================================
# Wapua (Web Access Proxy for User Agents) Configuration Template
# ==============================================================================
# This template configures wApua, a lightweight HTTP client/proxy utility.
# It defines the initial URL to load, debug verbosity, and optional HTTP proxy settings.
# All variables must be provided by the Ansible role or use the defaults defined below.
# ==============================================================================

# ------------------------------------------------------------------------------
# starturl: The initial URL to fetch and display when the application starts.
# Default: http://www.wapforum.org/
# ------------------------------------------------------------------------------
starturl = {{ starturl | default('http://www.wapforum.org/') }}

# ------------------------------------------------------------------------------
# debuglevel: The level of debug output to generate.
# 0 means no debug output. Higher numbers increase verbosity.
# ------------------------------------------------------------------------------
debuglevel = {{ debuglevel | default(0) }}

# ------------------------------------------------------------------------------
# Proxy Configuration Section
# ------------------------------------------------------------------------------

# proxyhost: The hostname or IP address of the HTTP proxy server.
# Leave empty ('') to use a direct connection (no proxy).
proxyhost = {{ proxyhost | default('') }}

# proxyport: The port number of the HTTP proxy server.
# Set to 0 if proxyhost is not used (i.e., if proxyhost is empty).
# If proxyhost is specified, this should match the proxy's listening port.
proxyport = {{ proxyport | default(0) }}