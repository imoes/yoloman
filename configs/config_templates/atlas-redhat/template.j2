# Atlas Configuration
# This file is managed by the atlas-redhat package.

# General Settings
[general]
# The base directory for Atlas user data and configuration.
home_dir = {{ atlas_home_dir | default('/var/atlas') }}

# Logging Settings
[logging]
# Path to the main log file for the Atlas service.
log_file = {{ atlas_log_file | default('/var/log/atlas/atlas.log') }}

# Network Settings
[network]
# The network interface address to listen on.
listen_host = {{ atlas_listen_host | default('0.0.0.0') }}

# The TCP port to listen on for incoming connections.
listen_port = {{ atlas_listen_port | default(8080) }}
