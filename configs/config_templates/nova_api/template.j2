[DEFAULT]
# Enables debug logging
#debug = false

# Enables verbose logging
#verbose = true

# Log directory path
log_dir = {{ log_dir }}

# Logging format string
#logging_context_format_string = %(asctime)s.%(msecs)03d %(process)d %(levelname)s %(name)s [%(request_id)s %(user_identity)s] %(instance)s %(message)s
#logging_default_format_string = %(asctime)s.%(msecs)03d %(process)d %(levelname)s %(name)s - %(message)s
#logging_debug_format_suffix = %(funcName)s %(pathname)s:%(lineno)d
#logging_exception_prefix = %(asctime)s.%(msecs)03d %(process)d TRACE %(name)s %(instance)s

# Connection string for the database
# Default uses sqlite; production uses PostgreSQL or MySQL
#sql_connection = sqlite:////var/lib/nova/nova.sqlite

# Connection string for the placement service
#placement_database_connection = mysql+pymysql://placement:placement@controller/placement

# Hostname or IP of the controller node (used for self-referential endpoints)
#auth_uri = http://{{ keystone_internal_host }}:5000
#auth_url = http://{{ keystone_internal_host }}:35357
#memcached_servers = {{ memcached_servers | join(',') }}

# Use SSL for keystone connections (if enabled in deployment)
#auth_type = password
#project_domain_name = Default
#user_domain_name = Default
#project_name = service
#username = nova
#password = {{ nova_service_password }}

# RPC backend (RabbitMQ or Redis)
#transport_url = rabbit://{{ rabbitmq_user }}:{{ rabbitmq_password }}@{{ rabbitmq_host }}:{{ rabbitmq_port }}/

# Enables the metadata API
#enabled_apis = osapi_compute,metadata

# Number of workers for the API service
api_workers = {{ nova_api_workers }}

# Maximum number of instances per server (used for rate limiting)
#max_limit = 1000

# Enables the os-volume-attach extension
#enable_volume = true

# Enables the os-extended-server-attributes extension
#osapi_compute_extension = nova.api.openstack.compute.all_extensions

# Enables cross-origin resource sharing (CORS)
#enable_cors = false

# Enables trusteless API (NovaTrusts extension)
