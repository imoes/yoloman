[api]
# Host to bind the API service to
host = {{ nova_api_host }}

# Port to bind the API service to
port = {{ nova_api_port }}

# Enable SSL (requires ssl_cert and ssl_key in [ssl] section)
#enabled_ssl = false

[api_database]
# Connection string for the API-specific database
# Separate from the main compute database for performance/scaling
connection = {{ nova_api_db_connection }}

[placement]
# Authentication type for the placement service
auth_type = password

# Placement service user domain
project_domain_name = Default

# Placement service user domain
user_domain_name = Default

# Project name for the placement service
project_name = service

# Username for the placement service
username = placement

# Password for the placement service
password = {{ placement_service_password }}

# URL for the placement API
auth_url = http://{{ keystone_internal_host }}:{{ keystone_admin_port }}/v3

[ssl]
# Enables SSL for the API service
#enabled = false

# Path to the SSL certificate
#cert_file = /etc/ssl/certs/nova.pem

# Path to the SSL private key
#key_file = /etc/ssl/private/nova.key

[oslo_concurrency]
# Path to the lock directory
lock_path = {{ lock_path }}

[oslo_middleware]
# Maximum body size for HTTP requests (in MB)
#max_request_body_size = 114688

# Enables request logging
#enable_proxy_headers_parsing = true

[oslo_policy]
# Policy file path
policy_file = {{ policy_file }}

# Policy default rule
policy_default_rule = {{ policy_default_rule }}

# Enables caching of policy checks
#enforce_scope = false

# Enables enforcer debug logging
#enforce_new_defaults = false
