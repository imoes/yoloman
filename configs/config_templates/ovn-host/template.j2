# ===========================================================================
# ovn-host configuration template
#
# This template generates a POSIX shell fragment that sets up the environment
# for Open Virtual Network (OVN) host components.
#
# It primarily configures OVN_CTL_OPTS, which allows passing extra arguments
# to the `ovs-ctl` helper script (e.g., for debugging wrappers like valgrind).
# ===========================================================================

# OVN_CTL_OPTS: Extra options to pass to ovs-ctl.
# Example use: --ovn-controller-wrapper=valgrind
# Leave empty for default behavior.
OVN_CTL_OPTS={{ ovn_ctl_opts | default('') | quote }}