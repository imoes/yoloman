# =============================================================================
# /etc/nscd.conf - Name Service Cache Daemon Configuration
# =============================================================================
# This file configures nscd, a daemon that caches common name service requests
# to reduce load on NSS sources (like /etc/passwd, DNS, etc.).
#
# WARNING: Running nscd with a secondary caching service like SSSD may lead to
#          unexpected behaviour, especially with how long entries are cached.
# =============================================================================

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------

# Maximum number of simultaneous client connections allowed.
# Increase under high load to prevent connection refusal.
max-connections {{ max_connection | default(256) }}

# Number of worker threads to handle requests.
# Match to CPU core count under high concurrency for optimal performance.
threads {{ threads | default(4) }}

# System user account under which nscd runs.
# Use a non-root user for security best practices.
server-user {{ user | default('nobody') }}

# Debug verbosity level (0 = silent, higher = more verbose).
# Set to 1+ only for troubleshooting.
debug-level {{ debug_level | default('0') }}

# After how many cache reloads (due to file changes) the cache should be
# revalidated automatically.
reload-count {{ reload_count | default(5) }}

# Maximum length (bytes) of database identifier (e.g., filename) used for cache invalidation.
max-db-size {{ max_db_id_len | default(256) }}

# ------------------------------------------------------------------------------
# Cache Configurations
# ------------------------------------------------------------------------------
# Each block below configures a specific cache type.
# Supported services: passwd, group, hosts, services, netgroup

# =============================================================================
# Passwd Cache (User Information)
# =============================================================================

# Enable caching of user (passwd) information.
enable-cache passwd {{ enable_cache_passwd | default('yes') }}

# TTL (seconds) for positive cache entries (successful lookups).
# Higher values reduce load but increase stale data risk.
positive-time-to-live passwd {{ positive_time_to_live | default('28800') }}

# TTL (seconds) for negative cache entries (failed lookups).
# Keep low to avoid missing newly created accounts.
negative-time-to-live passwd {{ negative_time_to_live | default('20') }}

# Suggested size for the cache hash table (prime number).
suggested-size passwd 211

# Check files for changes (passwd, group, shadow, gshadow) to invalidate cache.
check-files passwd yes

# Keep cache data persistent across daemon restarts.
persistent passwd yes

# Share cache memory between client processes (accelerates lookup).
# Note: 'yes' may cause 'nscd -g' to show 0% hit rate as hits aren't counted.
shared passwd yes

# Maximum database size in bytes.
max-db-size passwd 33554432

# Automatically propagate changes detected in source files.
auto-propagate passwd yes

# =============================================================================
# Group Cache (Group Information)
# =============================================================================

# Enable caching of group information.
enable-cache group {{ enable_cache_group | default(True) }}

# TTL (seconds) for positive cache entries.
positive-time-to-live group {{ positive_time_to_live | default('28800') }}

# TTL (seconds) for negative cache entries.
negative-time-to-live group {{ negative_time_to_live | default('20') }}

suggested-size group 211
check-files group yes
persistent group yes
shared group yes
max-db-size group 33554432
auto-propagate group yes

# =============================================================================
# Hosts Cache (DNS/Lookups)
# =============================================================================

# Enable caching of host (DNS) lookups.
enable-cache hosts {{ enable_cache_hosts | default(True) }}

# TTL (seconds) for positive cache entries.
positive-time-to-live hosts {{ positive_time_to_live | default('28800') }}

# TTL (seconds) for negative cache entries.
negative-time-to-live hosts {{ negative_time_to_live | default('20') }}

suggested-size hosts 211
check-files hosts yes
persistent hosts yes
shared hosts yes
max-db-size hosts 33554432

# =============================================================================
# Services Cache (Services Database)
# =============================================================================

# Note: The schema does not explicitly define enable/disable flags for 'services'
# and 'netgroup', but they follow the same structure. We assume they are enabled
# or controlled via the global context if not specified. However, to be safe
# and explicit based on the schema's 'enable_cache_*' fields, we only configure
# the ones explicitly mapped. If 'services' is not explicitly enabled in schema,
# we still provide the config structure but might rely on default daemon behavior.
# Based on the template provided, 'services' was enabled. We will assume standard
# enablement or use the provided schema defaults if available.
# Since there is no 'enable_cache_services' in schema, we keep it enabled as per
# typical defaults or previous template state, but strictly speaking, we only
# have defaults for passwd/group/hosts.
# To be safe and self-documenting, we will enable it by default or leave it
# as per standard nscd.conf examples if no flag exists.
# *Correction*: The schema only has enable_cache_passwd, enable_cache_group, enable_cache_hosts.
# It does not have enable_cache_services or enable_cache_netgroup.
# The original template enabled them. We will assume they are enabled unless
# the user explicitly disables them via a mechanism not present here.
# For strict adherence to schema, we cannot toggle them if the field doesn't exist.
# We will output them as enabled to maintain backward compatibility with the
# provided template structure, which is a safer default for a "config template".

enable-cache services yes
positive-time-to-live services {{ positive_time_to_live | default('28800') }}
negative-time-to-live services {{ negative_time_to_live | default('20') }}
suggested-size services 211
check-files services yes
persistent services yes
shared services yes
max-db-size services 33554432

# =============================================================================
# Netgroup Cache
# =============================================================================

enable-cache netgroup yes
positive-time-to-live netgroup {{ positive_time_to_live | default('28800') }}
negative-time-to-live netgroup {{ negative_time_to_live | default('20') }}
suggested-size netgroup 211
check-files netgroup yes
persistent netgroup yes
shared netgroup yes
max-db-size netgroup 33554432

# =============================================================================
# Shared Memory Files
# =============================================================================
# List of shared memory file paths for each cache type.
# Each entry maps to a cache type in order: passwd, group, hosts, services, netgroup.
# If empty, nscd uses default locations.
{% if pwm_files is defined and pwm_files | trim | length > 0 %}
shm_files {{ pwm_files | default('') }}
{% endif %}