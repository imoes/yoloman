{
  "use_lvmpolld": true,
  "lvmpolld_socket": "/run/lvm/lvmpolld.socket",
  "lvmpolld_timeout": 30,
  "log_lvmpolld": true,
  "lvmpolld_polling_interval": 1,
  "lvmpolld_limits": {
    "memlock": "unlimited",
    "nofile": "65536"
  },
  "prefer_metadata_areas": "none",
  "devicesfile": "/etc/lvm/devices/system.devices",
  "scan_list": [],
  "device_filter": [
    "a|/dev/disk/by-id/*|",
    "r|/dev/sd[0-9]+$|"
  ],
  "dmfile": "",
  "scan_loop_devices": false,
  "log_verbose": 2,
  "log_syslog": true,
  "log_file": "/var/log/lvm/lvmpolld.log",
  "log_overwrite": false,
  "log_levels": [
    "i",
    "n",
    "a",
    "c",
    "e",
    "o",
    "r"
  ],
  "activation_monitoring": true,
  "min_recovery_rate": 100,
  "parallel_activation": 0,
  "background_activation": true
}
