# Inadyn configuration template
# inadyn is a free dynamic DNS update client.
# This file controls the runtime behavior and privileges of the inadyn daemon.

# ---------------------------------------------------------------------------
# Daemon mode
# Description: Whether inadyn should run in daemon mode. Must be 'yes' or 'no'.
# Default: no
# ---------------------------------------------------------------------------
RUN_DAEMON="{{ run_daemon | default('no') }}"

# ---------------------------------------------------------------------------
# Dial-on-demand mode
# Description: Whether inadyn should run on every new ppp connection (dial-on-demand).
#              Must be 'yes' or 'no'.
# Note: If RUN_DAEMON is set to "yes", RUN_IPUP must be set to "no".
# Default: no
# ---------------------------------------------------------------------------
RUN_IPUP="{{ run_ipup | default('no') }}"

# ---------------------------------------------------------------------------
# Runtime user
# Description: User account under which inadyn runs.
# Default: debian-inadyn
# ---------------------------------------------------------------------------
USER="{{ user | default('debian-inadyn') }}"

# ---------------------------------------------------------------------------
# Runtime group
# Description: Group under which inadyn runs.
# Default: debian-inadyn
# ---------------------------------------------------------------------------
GROUP="{{ group | default('debian-inadyn') }}"