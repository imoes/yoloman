{
  "oslogin_enable": true,
  "ssh_cache_ttl": 300,
  "oslogin_2fa": false,
  "ssh_key_refresh": true,
  "ssh_metadata_key": "sshKeys",
  "sudoers_config_path": "/etc/sudoers.d/oslogin",
  "sudo_groups": [
    {
      "name": "oslogin-admins",
      "gid": 1001
    },
    {
      "name": "oslogin-developers",
      "gid": 1002
    }
  ],
  "sync_unix_groups": false,
  "sudo_unix_groups": [
    "oslogin-admins"
  ],
  "import_ssh_keys": true,
  "import_unix_home": true,
  "home_dir_base": "/home",
  "default_shell": "/bin/bash",
  "audit_logging": true,
  "audit_log_file": "/var/log/google_oslogin_audit.log",
  "selinux_enable": false,
  "pam_session": true,
  "use_login": false
}
