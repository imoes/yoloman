# =============================================================================
# /etc/google_oslogin_settings.conf
# Google Compute Engine OS Login configuration file
# =============================================================================
# This file is managed by Ansible. Do not edit manually.
# See the schema field descriptions for each directive.

# ------------------------------------------------------------------------------
# oslogin_enable: Enable OS Login to manage SSH keys and sudo access via Google
# metadata. When enabled, OS Login handles user provisioning and SSH key
# management automatically.
# ------------------------------------------------------------------------------
OSLOGIN={{ oslogin_enable | default(true) | lower }}

# ------------------------------------------------------------------------------
# ssh_cache_ttl: Time (in seconds) to cache SSH public keys before refreshing
# from metadata. Set to 0 to disable caching (keys are fetched on every access).
# ------------------------------------------------------------------------------
SSH_CACHE_TTL_SECONDS={{ ssh_cache_ttl | default(300) | int }}

# ------------------------------------------------------------------------------
# oslogin_2fa: Enable two-factor authentication (2FA) for sudo commands.
# Requires OS Login 2FA support to be enabled in the project/instance policy.
# ------------------------------------------------------------------------------
OSLOGIN_2FA={{ oslogin_2fa | default(false) | lower }}

# ------------------------------------------------------------------------------
# ssh_key_refresh: Automatically refresh SSH keys on each login by fetching from
# instance/project metadata. Ensures the latest keys are available.
# ------------------------------------------------------------------------------
SSH_KEY_REFRESH={{ ssh_key_refresh | default(true) | lower }}

# ------------------------------------------------------------------------------
# ssh_metadata_key: Metadata key name where SSH keys are stored. Common values
# are 'sshKeys' (instance metadata) or 'google-ssh-keys' (project metadata).
# ------------------------------------------------------------------------------
SSH_METADATA_KEY={{ ssh_metadata_key | default('sshKeys') }}

# ------------------------------------------------------------------------------
# sudoers_config_path: Path to the OS Login sudoers configuration file. This
# file is generated by oslogin tools to grant sudo access based on IAM policies.
# ------------------------------------------------------------------------------
SUDOERS_CONFIG={{ sudoers_config_path | default('/etc/sudoers.d/oslogin') }}

# ------------------------------------------------------------------------------
# sudo_groups: List of groups to map SSH keys to. Each entry defines a group
# name and GID. These groups are used to assign sudo privileges to users
# associated with the SSH keys.
# Format: SUDO_GROUP=<name>,<gid>
# ------------------------------------------------------------------------------
{% for group in sudo_groups | default([]) %}# Sudo group mapping: {{ group.name }} (gid {{ group.gid }})
SUDO_GROUP={{ group.name }},{{ group.gid }}
{% endfor %}

# ------------------------------------------------------------------------------
# sync_unix_groups: Sync Unix group membership from external directory (e.g.,
# Active Directory or LDAP) via metadata. Requires directory integration.
# ------------------------------------------------------------------------------
SYNC_UNIX_GROUPS={{ sync_unix_groups | default(false) | lower }}

# ------------------------------------------------------------------------------
# sudo_unix_groups: List of Unix group names allowed sudo access via OS Login.
# Users belonging to these groups will have sudo privileges.
# ------------------------------------------------------------------------------
{% for group in sudo_unix_groups | default([]) %}# Sudo access for Unix group: {{ group.name }}
SUDO_UNIX_GROUP={{ group }}
{% endfor %}

# ------------------------------------------------------------------------------
# import_ssh_keys: Import SSH public keys from instance or project metadata.
# Allows users to authenticate using keys stored in Google Cloud metadata.
# ------------------------------------------------------------------------------
IMPORT_SSH_KEYS={{ import_ssh_keys | default(true) | lower }}

# ------------------------------------------------------------------------------
# import_unix_home: Import Unix home directory settings (e.g., home directory
# path, UID) from metadata. Enables consistent home directory layouts.
# ------------------------------------------------------------------------------
IMPORT_UNIX_HOME={{ import_unix_home | default(true) | lower }}

# ------------------------------------------------------------------------------
# home_dir_base: Base path for user home directories. User home directories
# will be created under this path (e.g., /home/username or /users/username).
# ------------------------------------------------------------------------------
HOME_DIR_BASE={{ home_dir_base | default('/home') }}

# ------------------------------------------------------------------------------
# default_shell: Default login shell for OS Login users. This shell is assigned
# to users who do not have a shell specified in metadata or directory.
# ------------------------------------------------------------------------------
DEFAULT_SHELL={{ default_shell | default('/bin/bash') }}

# ------------------------------------------------------------------------------
# audit_logging: Enable audit logging for OS Login events (e.g., SSH logins,
# sudo usage). Useful for security compliance and troubleshooting.
# ------------------------------------------------------------------------------
AUDIT_LOGGING={{ audit_logging | default(true) | lower }}

# ------------------------------------------------------------------------------
# audit_log_file: Path to the OS Login audit log file. Log entries are written
# here when audit_logging is enabled.
# ------------------------------------------------------------------------------
AUDIT_LOG_FILE={{ audit_log_file | default('/var/log/google_oslogin_audit.log') }}

# ------------------------------------------------------------------------------
# selinux_enable: Enable SELinux support for OS Login operations. Ensures proper
# SELinux contexts are applied to OS Login-managed files and processes.
# ------------------------------------------------------------------------------
SELINUX={{ selinux_enable | default(false) | lower }}

# ------------------------------------------------------------------------------
# pam_session: Enable PAM session management (e.g., setting up environment,
# home directory creation, umask). Integrates OS Login with PAM stack.
# ------------------------------------------------------------------------------
PAM_SESSION={{ pam_session | default(true) | lower }}

# ------------------------------------------------------------------------------
# use_login: Use /bin/login for SSH sessions. May be needed for certain PAM
# integrations or legacy compatibility. Generally not required on modern systems.
# ------------------------------------------------------------------------------
USE_LOGIN={{ use_login | default(false) | lower }}