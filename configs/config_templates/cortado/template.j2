# =============================================================================
# Cortado Apache Configuration Template
# =============================================================================
# This template generates the Apache configuration for the Cortado web application.
# It defines the URL alias and the document root directory permissions.
# =============================================================================

# --- Alias Configuration ---
# Alias directive maps a URL path to a filesystem directory.
# cortado_alias_path: URL alias path for cortado
#   - Default: '/cortado'
# cortado_docroot: Filesystem path to cortado's document root
#   - Default: '/usr/share/cortado'
Alias {{ cortado_alias_path | default('/cortado') }} {{ cortado_docroot | default('/usr/share/cortado') }}

# --- Directory Permissions ---
# <Directory> block restricts or grants access to the specified filesystem path.
# Here, we enable FollowSymlinks for the document root.
<Directory {{ cortado_docroot | default('/usr/share/cortado') }}>
    Options FollowSymlinks
</Directory>