# ==============================================================================
# Apache2 Configuration for Cortado
# ==============================================================================
# This template configures Apache to serve the Cortado Java applet.
# It defines a URL alias pointing to the application's document root and
# sets appropriate directory options for security and functionality.
#
# Required variables:
#   cortado_alias_path: The URL path prefix for accessing Cortado (default: /cortado)
#   cortado_docroot:    The filesystem path where Cortado files reside (default: /usr/share/cortado)
# ==============================================================================

# Alias directive: Maps a URL path to a local filesystem directory.
# This allows users to access Cortado via http://<server>{{ cortado_alias_path | default('/cortado') }}
# The path must start with a slash.
Alias {{ cortado_alias_path | default('/cortado') }} {{ cortado_docroot | default('/usr/share/cortado') }}

# Directory configuration for the Cortado document root.
# Applies to the physical directory specified by cortado_docroot.
<Directory {{ cortado_docroot | default('/usr/share/cortado') }}>
    # FollowSymlinks: Allows symbolic links within this directory to be followed.
    # This is often required for Java applets or scripts that rely on relative links.
    Options FollowSymlinks
</Directory>
