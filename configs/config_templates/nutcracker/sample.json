{
  "servers": [
    {
      "name": "redis-cache",
      "listen": "0.0.0.0:6379",
      "hash": "djb2",
      "distribution": "ketama",
      "timeout": 4000,
      "auto_eject_hosts": true,
      "server_failure_limit": 3,
      "server_retry_timeout": 30000,
      "proto": "redis",
      "redis": true,
      "instances": [
        {
          "host": "redis1.local",
          "port": 6379,
          "weight": 1
        },
        {
          "host": "redis2.local",
          "port": 6379,
          "weight": 1
        },
        {
          "host": "redis3.local",
          "port": 6379,
          "weight": 1
        }
      ]
    },
    {
      "name": "memcached-sessions",
      "listen": "0.0.0.0:11211",
      "hash": "md5",
      "distribution": "ketama",
      "auto_eject_hosts": true,
      "server_failure_limit": 2,
      "instances": [
        {
          "host": "mem1.local",
          "port": 11211,
          "weight": 100
        },
        {
          "host": "mem2.local",
          "port": 11211,
          "weight": 100
        }
      ]
    }
  ],
  "log_level": "warn",
  "log_location": "/var/log/nutcracker/nutcracker.log",
  "stats_port": 22222,
  "stats_interval": 30000,
  "client_connections": 4096
}
