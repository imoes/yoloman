[global]
#
# Default Data Set
#

# twoStepFlag: Two-step flag. If 1, the clock uses two-step timestamps (separate FollowUp message).
twoStepFlag		{{ twoStepFlag | default(1) }}

# clientOnly: Client-only mode (static default).
clientOnly		0

# socket_priority: Socket priority (static default).
socket_priority		0

# priority1: Clock priority 1 (0–255); used in best master clock algorithm. Lower = higher priority.
priority1		{{ priority1 | default(128) }}

# priority2: Clock priority 2 (0–255); used if priority1 values tie. Lower = higher priority.
priority2		{{ priority2 | default(128) }}

# domainNumber: PTP domain number (0–127). Must match between master and slave devices.
domainNumber		{{ domainNumber | default(0) }}

# utc_offset: UTC offset (static default).
#utc_offset		37

# clockClass: Clock class (static default).
clockClass		248

# clockAccuracy: Clock accuracy (static default).
clockAccuracy		0xFE

# offsetScaledLogVariance: Offset scaled log variance (static default).
offsetScaledLogVariance	0xFFFF

# free_running: Free running mode (static default).
free_running		0

# freq_est_interval: Frequency estimation interval (static default).
freq_est_interval	1

# dscp_event: DSCP value for PTP event messages (static default).
dscp_event		0

# dscp_general: DSCP value for PTP general messages (static default).
dscp_general		0

# dataset_comparison: Dataset comparison method (static default).
dataset_comparison	ieee1588

# G.8275.defaultDS.localPriority: G.8275 local priority (static default).
G.8275.defaultDS.localPriority	128

# maxStepsRemoved: Maximum steps removed (static default).
maxStepsRemoved		255

#
# Port Data Set
#

# logAnnounceInterval: Log2 of the interval between ANNOUNCE messages (default 1s).
logAnnounceInterval	{{ logAnnounceInterval | default(1) }}

# logSyncInterval: Log2 of the interval between SYNC messages (default 2^0 = 1s).
logSyncInterval		{{ logSyncInterval | default(0) }}

# operLogSyncInterval: Operational log sync interval (static default).
operLogSyncInterval	0

# logMinDelayReqInterval: Log2 of the minimum interval between delay request messages (default 2^0 = 1s).
logMinDelayReqInterval	{{ logMinDelayReqInterval | default(0) }}

# logMinPdelayReqInterval: Log2 of the minimum peer delay request interval (static default).
logMinPdelayReqInterval	0

# operLogPdelayReqInterval: Operational log peer delay request interval (static default).
operLogPdelayReqInterval	0

# announceReceiptTimeout: Announce receipt timeout (static default).
announceReceiptTimeout	3

# syncReceiptTimeout: Sync receipt timeout (static default).
syncReceiptTimeout	0

# delay_response_timeout: Delay response timeout (static default).
delay_response_timeout	0

# delayAsymmetry: Delay asymmetry correction (static default).
delayAsymmetry		0

# fault_reset_interval: Fault reset interval (static default).
fault_reset_interval	4

# neighborPropDelayReqThresh: Neighbor propagation delay request threshold (static default).
neighborPropDelayReqThresh	20000000

# serverOnly: Server-only mode (static default).
serverOnly		0

# G.8275.portDS.localPriority: G.8275 port local priority (static default).
G.8275.portDS.localPriority	128

# asCapable: AS (Announcing Station) capable mode (static default).
asCapable	       auto

# BMCA: Boundary/Best Master Clock Algorithm mode (static default).
BMCA	            ptp

# inhibit_announce: Inhibit announce messages (static default).
inhibit_announce	0

# inhibit_delay_req: Inhibit delay request messages (static default).
inhibit_delay_req	0

# ignore_source_id: Ignore source ID check (static default).
ignore_source_id	0

# power_profile.2011.grandmasterTimeInaccuracy: GM time inaccuracy (static default).
power_profile.2011.grandmasterTimeInaccuracy	-1

# power_profile.2011.networkTimeInaccuracy: Network time inaccuracy (static default).
power_profile.2011.networkTimeInaccuracy	-1

# power_profile.2017.totalTimeInaccuracy: Total time inaccuracy (static default).
power_profile.2017.totalTimeInaccuracy		-1

# power_profile.grandmasterID: Grandmaster ID (static default).
power_profile.grandmasterID			0

# power_profile.version: Power profile version (static default).
power_profile.version				none

# ptp_minor_version: PTP minor version (static default).
ptp_minor_version       1

#
# Run time options
#

# assume_two_step: Assume two-step clock (static default).
assume_two_step		0

# logging_level: Global logging verbosity (0=debug to 7=emerg). Lower numbers = more verbose.
logging_level		{{ logging_level | default(6) }}

# path_trace_enabled: Enable path trace (static default).
path_trace_enabled	0

# follow_up_info: Follow-up info mode (static default).
follow_up_info		0

# hybrid_e2e: Hybrid end-to-end delay mechanism (static default).
hybrid_e2e		0

# inhibit_multicast_service: Inhibit multicast service (static default).
inhibit_multicast_service	0

# net_sync_monitor: Network sync monitor (static default).
net_sync_monitor	0

# tc_spanning_tree: TC spanning tree support (static default).
tc_spanning_tree	0

# tx_timestamp_timeout: Transmit timestamp timeout (static default).
tx_timestamp_timeout	10

# unicast_listen: Enable unicast listen (static default).
unicast_listen		0

# unicast_master_table: Unicast master table size (static default).
unicast_master_table	0

# unicast_req_duration: Unicast request duration (static default).
unicast_req_duration	3600

# use_syslog: Use syslog for logging (static default).
use_syslog		1

# verbose: Verbose logging (static default).
verbose			0

# summary_interval: Summary interval (static default).
summary_interval	0

# kernel_leap: Kernel leap second handling (static default).
kernel_leap		1

# check_fup_sync: Check follow-up sync consistency (static default).
check_fup_sync		0

# clock_class_threshold: Clock class threshold (static default).
clock_class_threshold	248

#
# Servo Options
#

# pi_proportional_const: PI controller proportional constant (static default).
pi_proportional_const	0.0

# pi_integral_const: PI controller integral constant (static default).
pi_integral_const	0.0

# pi_proportional_scale: PI controller proportional scale (static default).
pi_proportional_scale	0.0

# pi_proportional_exponent: PI controller proportional exponent (static default).
pi_proportional_exponent	-0.3

# pi_proportional_norm_max: PI controller proportional norm max (static default).
pi_proportional_norm_max	0.7

# pi_integral_scale: PI controller integral scale (static default).
pi_integral_scale	0.0

# pi_integral_exponent: PI controller integral exponent (static default).
pi_integral_exponent	0.4

# pi_integral_norm_max: PI controller integral norm max (static default).
pi_integral_norm_max	0.3

# step_threshold: Step threshold (static default).
step_threshold		0.0

# first_step_threshold: First step threshold (static default).
first_step_threshold	0.00002

# max_frequency: Maximum frequency adjustment (static default).
max_frequency		900000000

# clock_servo: Clock servo algorithm (static default).
clock_servo		pi

# sanity_freq_limit: Sanity frequency limit (static default).
sanity_freq_limit	200000000

# refclock_sock_address: Reference clock socket address (static default).
refclock_sock_address	/var/run/refclock.ptp.sock

# ntpshm_segment: NTP SHM segment ID (static default).
ntpshm_segment		0

# msg_interval_request: Message interval request (static default).
msg_interval_request	0

# servo_num_offset_values: Servo number of offset values (static default).
servo_num_offset_values 10

# servo_offset_threshold: Servo offset threshold (static default).
servo_offset_threshold  0

# write_phase_mode: Write phase mode (static default).
write_phase_mode	0

#
# Transport options
#

# transportSpecific: Transport-specific header byte in hexadecimal (e.g., '0x0' for Ethernet).
transportSpecific	{{ transportSpecific | default('0x0') }}

# ptp_dst_mac: PTP destination MAC address (static default).
ptp_dst_mac		01:1B:19:00:00:00

# p2p_dst_mac: P2P destination MAC address (static default).
p2p_dst_mac		01:80:C2:00:00:0E

# udp_ttl: UDP Time-To-Live value (static default).
udp_ttl			1

# udp6_scope: UDPv6 scope ID (static default).
udp6_scope		0x0E

# uds_address: Unix domain socket address for ptp4l (static default).
uds_address		/var/run/ptp4l

# uds_file_mode: Unix domain socket file mode (static default).
uds_file_mode		0660

# uds_ro_address: Unix domain socket address for read-only ptp4l (static default).
uds_ro_address		/var/run/ptp4lro

# uds_ro_file_mode: Read-only Unix domain socket file mode (static default).
uds_ro_file_mode		0666

#
# Default interface options
#

# clock_type: Clock type (static default).
clock_type		OC

# network_transport: Network transport protocol (static default).
network_transport	UDPv4

# delay_mechanism: Delay mechanism (static default).
delay_mechanism		E2E

# time_stamping: Time stamping method (static default).
time_stamping		hardware

# tsproc_mode: Time stamp processing mode (static default).
tsproc_mode		filter

# delay_filter: Delay filter algorithm (static default).
delay_filter		moving_median

# delay_filter_length: Delay filter length (static default).
delay_filter_length	10

# egressLatency: Egress latency (static default).
egressLatency		0

# ingressLatency: Ingress latency (static default).
ingressLatency		0

# boundary_clock_jbod: Boundary clock JBOD mode (static default).
boundary_clock_jbod	0

# phc_index: PHC index (static default).
phc_index		-1

#
# Clock description
#

# productDescription: Product description (static default).
productDescription	;;

# revisionData: Revision data (static default).
revisionData		;;

# manufacturerIdentity: Manufacturer identity OUI (static default).
manufacturerIdentity	00:00:00

# userDescription: User description (static default).
userDescription		;

# timeSource: Time source (static default).
timeSource		0xA0