# ============================================================
# reprozip configuration template
# ============================================================
# This file configures the behavior of the reprozip tool, which
# captures software execution traces for reproducibility.
# ============================================================

# Directory where reprozip stores the trace database and configuration file.
# Default: ./.reprozip-trace
# Type: string
reprozip_dir: {{ reprozip_dir | default('./.reprozip-trace') }}

# If true, attempts to identify which installed package each file in the trace comes from.
# This helps in determining the provenance of files captured in the trace.
# Default: True
# Type: boolean
ident_packages: {{ ident_packages | default(true) | lower }}

# If true, attempts to identify which files are inputs and which are outputs of the experiment.
# This distinguishes between source files and generated artifacts.
# Default: True
# Type: boolean
identify_io: {{ identify_io | default(true) | lower }}

# Enables or disables anonymous usage reports sent to the reprozip developers.
# When enabled, anonymized usage data is collected to improve the tool.
# Default: False
# Type: boolean
usage_report: {{ usage_report | default(false) | lower }}

# List of arguments to pass to the program being traced.
# These arguments are passed directly to the executable/command specified in the trace.
# Items are strings. If empty, no extra arguments are passed.
# Default: []
# Type: list
program_args: {{ program_args | default([]) }}