<?xml version="1.0" encoding="UTF-8"?>
<!-- Gerbera UPnP Media Server Configuration -->
<!--
  This is the self-documenting configuration template for Gerbera.
  Every configurable option is preceded by a comment describing its purpose.
  All variables use safe defaults (| default(...)) so the template never
  fails to render even if the caller omits a value.
-->
<config version="3" xmlns="http://mediatomb.cc/config/3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://mediatomb.cc/config/3 http://mediatomb.cc/config/3.xsd">
  <!-- Logging configuration -->
  <logging>
    <!-- Log verbosity level (ERROR, WARNING, INFO, DEBUG, VERBOSE, TRACE) -->
    <level>{{ logging_level | default('WARNING') }}</level>
    <!-- Path to log file (empty = stderr) -->
    <target>{{ logging_target | default('') }}</target>
  </logging>

  <!-- Server identification and basic settings -->
  <server>
    <!-- Unique device identifier (must be a valid UUID) -->
    <uuid>{{ server_uuid | default('00000000-0000-0000-0000-000000000000') }}</uuid>
    <!-- Display name of the UPnP server on the network -->
    <name>{{ server_name | default('Gerbera Media Server') }}</name>
    <!-- Model name shown to UPnP clients -->
    <model_name>{{ server_model_name | default('Gerbera') }}</model_name>
    <!-- Model number shown to UPnP clients -->
    <model_number>{{ server_model_number | default('1') }}</model_number>
    <!-- Hardware vendor string for UPnP compliance -->
    <hardware>{{ server_hardware | default('Gerbera') }}</hardware>
    <!-- Software vendor string for UPnP compliance -->
    <software>{{ server_software | default('Gerbera') }}</software>
    <!-- Enable automatic port forwarding via UPnP IGD/NAT-PMP -->
    <enable_port_mapping>{{ 'yes' if (server_enable_port_mapping | default(false)) else 'no' }}</enable_port_mapping>
    <!-- Listen address for control interface (empty = all interfaces) -->
    <control>
      <listen_address>{{ server_control_address | default('') }}</listen_address>
      <listen_port>{{ server_control_port | default(49152) }}</listen_port>
    </control>
    <!-- Listen address for media streaming (empty = all interfaces) -->
    <virtual_directory>
      <listen_address>{{ server_virtual_address | default('') }}</listen_address>
      <listen_port>{{ server_virtual_port | default(49153) }}</listen_port>
    </virtual_directory>
    <!-- List of network interfaces to bind to (e.g., eth0, br0) -->
    {% if (server_interfaces | default([])) | length > 0 %}
    <interfaces>
      {% for iface in server_interfaces | default([]) %}
      <interface>{{ iface }}</interface>
      {% endfor %}
    </interfaces>
    {% endif %}
  </server>

  <!-- Database backend configuration -->
  <database>
    <!-- Database engine: sqlite, mysql, or postgresql -->
    <engine>{{ db_engine | default('sqlite') }}</engine>
    <!-- Path to SQLite database file (used only when db_engine=sqlite) -->
    {% if (db_engine | default('sqlite')) | lower == 'sqlite' %}
    <database_file>{{ db_sqlite_path | default('/var/lib/gerbera/gerbera.db') }}</database_file>
    {% endif %}
    <!-- For MySQL/PostgreSQL: connection details -->
    {% if (db_engine | default('sqlite')) | lower in ['mysql', 'postgresql'] %}
    <!-- Database server hostname (used only for MySQL/PostgreSQL) -->
    <host>{{ db_host | default('localhost') }}</host>
    <!-- Database server port (MySQL default: 3306; PostgreSQL default: 5432) -->
    <port>{{ db_port | default(3306) }}</port>
    <!-- Database name (MySQL/PostgreSQL only) -->
    <name>{{ db_name | default('gerbera') }}</name>
    <!-- Database username (MySQL/PostgreSQL only) -->
    <user>{{ db_user | default('gerbera') }}</user>
    <!-- Database password (MySQL/PostgreSQL only) -->
    <password>{{ db_password | default('gerbera') }}</password>
    {% endif %}
    <!-- Database tuning options -->
    <options>
      <!-- Maximum concurrent database connections -->
      <max_connections>{{ db_max_connections | default(5) }}</max_connections>
    </options>
  </database>

  <!-- Media library settings -->
  <container>
    <!-- Default container ID for browse requests (0 = root) -->
    <default_container>{{ default_container | default('0') }}</default_container>
    <!-- Enable playlist support in web UI and clients -->
    <playlist>{{ 'yes' if (playlist_enabled | default(true)) else 'no' }}</playlist>
    <!-- File extension for saved playlists -->
    <playlist_extension>{{ playlist_extension | default('m3u') }}</playlist_extension>
    <!-- Directory for saved playlists -->
    <playlist_directory>{{ playlist_directory | default('/var/lib/gerbera/playlists') }}</playlist_directory>
    <!-- Maximum items allowed per playlist (0 = unlimited) -->
    <playlist_max_items>{{ playlist_max_items | default(0) }}</playlist_max_items>
  </container>

  <!-- File scanning configuration -->
  <import>
    <!-- Include hidden files (dotfiles) during media scans -->
    <hidden_files>{{ 'yes' if (import_hidden_files | default(false)) else 'no' }}</hidden_files>
    <!-- Scan mode: 'auto' (periodic), 'manual' (on-demand only) -->
    <scan_mode>{{ import_scan_mode | default('auto') }}</scan_mode>
    <!-- Maximum directory depth to scan recursively -->
    <max_depth>{{ import_max_depth | default(5) }}</max_depth>
    <!-- Comma-separated list of file extensions to ignore -->
    <excluded_extensions>{{ import_excluded_extensions | default('tmp,cache,log') }}</excluded_extensions>
    <!-- Mapping of file extensions to MIME types (e.g., { 'mp3': 'audio/mpeg' }) -->
    {% if (import_mappings | default({})) | length > 0 %}
    <mappings>
      {% for entry in (import_mappings | default({})) | dict2items %}
      <extension mimetype="{{ entry.value | default('') }}">{{ entry.key | default('') }}</extension>
      {% endfor %}
    </mappings>
    {% endif %}
    <!-- List of transcoding profiles for on-the-fly format conversion -->
    {% if (transcoding_profiles | default([])) | length > 0 %}
    <transcoding>
      {% for profile in (transcoding_profiles | default([])) %}
      <profile name="{{ profile.name | default('') }}" enabled="{{ 'yes' if (profile.enabled | default(true)) else 'no' }}" type="{{ profile.type | default('ffmpeg') }}">
        <agent command="{{ profile.agent_command | default('ffmpeg') }}" arguments="{{ profile.agent_args | default('-i {in} -o {out}') }}"/>
        <mime-type mimetype="{{ profile.mime_type | default('') }}"/>
        <resolution>{{ profile.resolution | default('') }}</resolution>
      </profile>
      {% endfor %}
    </transcoding>
    {% endif %}
  </import>

  <!-- Metadata extraction settings -->
  <metadata>
    <!-- Enable ExifTool for enhanced metadata extraction -->
    <use_exiftool>{{ 'yes' if (metadata_use_exiftool | default(false)) else 'no' }}</use_exiftool>
    <!-- Path to ExifTool executable -->
    <exiftool_path>{{ metadata_exiftool_path | default('exiftool') }}</exiftool_path>
    <!-- Timeout in seconds for metadata loading -->
    <load_timeout>{{ metadata_load_timeout | default(10) }}</load_timeout>
  </metadata>

  <!-- Web UI and API settings -->
  <web>
    <!-- Enable built-in web UI -->
    <enabled>{{ 'yes' if (web_enabled | default(true)) else 'no' }}</enabled>
    <!-- Web UI listen port -->
    <port>{{ web_port | default(9999) }}</port>
    <!-- IP address for web UI (empty = all interfaces) -->
    <address>{{ web_address | default('') }}</address>
    <!-- Web UI theme (e.g., 'classic', 'frost') -->
    <skin>{{ web_skin | default('classic') }}</skin>
    <!-- Admin interface configuration -->
    <admin>
      <!-- Enable admin interface -->
      <enabled>{{ 'yes' if (web_admin_enabled | default(true)) else 'no' }}</enabled>
      <!-- Admin UI username -->
      <user>{{ web_admin_user | default('admin') }}</user>
      <!-- Admin UI password -->
      <password>{{ web_admin_password | default('admin') }}</password>
    </admin>
    <!-- Web UI page title -->
    <title>{{ web_title | default('Gerbera Media Server') }}</title>
    <!-- Enable REST API endpoints (requires authentication) -->
    <api>{{ 'yes' if (web_api_enabled | default(false)) else 'no' }}</api>
  </web>

  <!-- UPnP/AV specific settings -->
  <!-- Additional protocol info extensions -->
  <protocol_info extend="yes">{% if (protocol_info_ext | default([])) | length > 0 %}
    {% for proto in (protocol_info_ext | default([])) %}
    <add mimetype="{{ proto.mimetype | default('') }}" profile="{{ proto.profile | default('') }}"/>
    {% endfor %}
  {% endif %}
  </protocol_info>

</config>