# nsncd configuration template
# Managed by Ansible. Do not edit manually.

# Number of worker threads nsncd will spawn to process requests.
NSNCD_WORKER_COUNT={{ NSNCD_WORKER_COUNT | default(8) }}

# Number of seconds nsncd will wait for a worker thread to become available.
NSNCD_HANDOFF_TIMEOUT={{ NSNCD_HANDOFF_TIMEOUT | default(3) }}

# If set to "true", nsncd will not respond to requests for the group database.
NSNCD_IGNORE_GROUP={{ NSNCD_IGNORE_GROUP | default('false') }}

# If set to "true", nsncd will not respond to requests for the hosts database.
NSNCD_IGNORE_HOSTS={{ NSNCD_IGNORE_HOSTS | default('false') }}

# If set to "true", nsncd will not respond to requests for the initgroups database.
NSNCD_IGNORE_INITGROUPS={{ NSNCD_IGNORE_INITGROUPS | default('false') }}

# If set to "true", nsncd will not respond to requests for the netgroup database.
NSNCD_IGNORE_NETGROUP={{ NSNCD_IGNORE_NETGROUP | default('false') }}

# If set to "true", nsncd will not respond to requests for the passwd database.
NSNCD_IGNORE_PASSWD={{ NSNCD_IGNORE_PASSWD | default('false') }}

# If set to "true", nsncd will not respond to requests for the services database.
NSNCD_IGNORE_SERVICES={{ NSNCD_IGNORE_SERVICES | default('false') }}