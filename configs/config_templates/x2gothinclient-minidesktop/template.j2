#!/bin/sh

# Trap common termination signals to prevent the script from exiting prematurely
# during container or service lifecycle events, ensuring graceful handling.
trap "" SIGHUP SIGINT SIGTERM

# Define the system PATH for service management commands.
# Includes default system paths plus sbin directories required for service execution.
# Variable: path_default (default: '$PATH:/sbin:/usr/sbin')
PATH={{ path_default | default('$PATH:/sbin:/usr/sbin') }}

# Restart the configured display manager service.
# This script is typically used in thin client environments to ensure the display
# manager is active and responsive.
# Variable: service_name (default: 'lightdm')
service {{ service_name | default('lightdm') }} restart
