# ==============================================================================
# Package: sendmail-redhat
# Type: Makefile (Build/Install Helper)
# ==============================================================================
#
# This template generates a minimal Makefile wrapper for managing Sendmail
# configuration or installation on Red Hat-based systems. It serves as a
# convenience layer to standardize build and installation steps.
#
# Since the input schema was empty (no configurable fields provided), this
# template emits a static, self-documenting Makefile structure.
#
# ==============================================================================

# Default target: builds/installs the service.
# If no specific schema targets were provided, this is a generic 'all' target.
.PHONY: all force clean

all: force
	# Execute the underlying make script with the specified target.
	# The actual logic is delegated to ./make as per the original template.
	@./make $@

# Force target to ensure dependencies always run if needed.
force:
	@true

# Ensure the makefile itself is up to date (idempotency check).
$(MAKEFILE_LIST):
	@true

# Optional: Clean target for removing temporary build artifacts.
# Added for standard Makefile completeness, as the original lacked maintenance targets.
clean: force
	# Clean any generated temporary files.
	@rm -f /tmp/sendmail-build-* 2>/dev/null || true
