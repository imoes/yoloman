# port for HTTP (descriptions, SOAP, media transfer) traffic
port={{ http_port | default('8200') }}

# network interfaces to serve, comma delimited (8 interfaces max)
{% if interface is defined and interface is not none and (interface is number or interface is boolean or interface | length > 0) %}network_interface={{ interface }}
{% else %}#network_interface=eth0
{% endif %}
# specify the user account name or uid to run as
{% if user is defined and user is not none and (user is number or user is boolean or user | length > 0) %}user={{ user }}
{% else %}#user=jmaggard
{% endif %}
# set this to the directory you want scanned.
# * if you want multiple directories, you can have multiple media_dir= lines
# * if you want to restrict a media_dir to specific content types, you
#   can prepend the types, followed by a comma, to the directory:
#   + "A" for audio  (eg. media_dir=A,/home/jmaggard/Music)
#   + "V" for video  (eg. media_dir=V,/home/jmaggard/Videos)
#   + "P" for images (eg. media_dir=P,/home/jmaggard/Pictures)
#   + "PV" for pictures and video (eg. media_dir=PV,/home/jmaggard/digital_camera)
media_dir={{ media_dir | default('/opt') }}

# set this to merge all media_dir base contents into the root container
# note: the default is no
{% if merge_media_dirs is defined and merge_media_dirs is not none and (merge_media_dirs is number or merge_media_dirs is boolean or merge_media_dirs | length > 0) %}merge_media_dirs={{ merge_media_dirs }}
{% else %}#merge_media_dirs=no
{% endif %}
# set this if you want to customize the name that shows up on your clients
{% if friendly_name is defined and friendly_name is not none and (friendly_name is number or friendly_name is boolean or friendly_name | length > 0) %}friendly_name={{ friendly_name }}
{% else %}#friendly_name=My DLNA Server
{% endif %}
# set this if you would like to specify the directory where you want MiniDLNA to store its database and album art cache
{% if db_dir is defined and db_dir is not none and (db_dir is number or db_dir is boolean or db_dir | length > 0) %}db_dir={{ db_dir }}
{% else %}#db_dir=/var/cache/minidlna
{% endif %}
# set this if you would like to specify the directory where you want MiniDLNA to store its log file
{% if log_dir is defined and log_dir is not none and (log_dir is number or log_dir is boolean or log_dir | length > 0) %}log_dir={{ log_dir }}
{% else %}#log_dir=/var/log/minidlna
{% endif %}
# set this to change the verbosity of the information that is logged
# each section can use a different level: off, fatal, error, warn, info, or debug
{% if log_level is defined and log_level is not none and (log_level is number or log_level is boolean or log_level | length > 0) %}log_level={{ log_level }}
{% else %}#log_level=general,artwork,database,inotify,scanner,metadata,http,ssdp,tivo=warn
{% endif %}
# this should be a list of file names to check for when searching for album art
# note: names should be delimited with a forward slash ("/")
album_art_names={{ album_art_names | default('Cover.jpg/cover.jpg/AlbumArtSmall.jpg/albumartsmall.jpg/AlbumArt.jpg/albumart.jpg/Album.jpg/album.jpg/Folder.jpg/folder.jpg/Thumb.jpg/thumb.jpg') }}

# set this to no to disable inotify monitoring to automatically discover new files
# note: the default is yes
inotify={{ inotify | default('yes') }}

# set this to yes to enable support for streaming .jpg and .mp3 files to a TiVo supporting HMO
enable_tivo={{ enable_tivo | default('no') }}

# set this to beacon to use legacy broadcast discovery method
# defauts to bonjour if avahi is available
tivo_discovery={{ tivo_discovery | default('bonjour') }}

# set this to strictly adhere to DLNA standards.
# * This will allow server-side downscaling of very large JPEG images,
#   which may hurt JPEG serving performance on (at least) Sony DLNA products.
strict_dlna={{ strict_dlna | default('no') }}

# default presentation url is http address on port 80
{% if presentation_url is defined and presentation_url is not none and (presentation_url is number or presentation_url is boolean or presentation_url | length > 0) %}presentation_url={{ presentation_url }}
{% else %}#presentation_url=http://www.mylan/index.php
{% endif %}
# notify interval in seconds. default is 895 seconds.
notify_interval={{ notify_interval | default('900') }}

# serial and model number the daemon will report to clients
# in its XML description
serial={{ serial_number | default('12345678') }}
model_number={{ model_number | default('1') }}

# specify the path to the MiniSSDPd socket
{% if minissdpdsocket is defined and minissdpdsocket is not none and (minissdpdsocket is number or minissdpdsocket is boolean or minissdpdsocket | length > 0) %}minissdpdsocket={{ minissdpdsocket }}
{% else %}#minissdpdsocket=/var/run/minissdpd.sock
{% endif %}
# use different container as root of the tree
# possible values:
#   + "." - use standard container (this is the default)
#   + "B" - "Browse Directory"
#   + "M" - "Music"
#   + "V" - "Video"
#   + "P" - "Pictures"
#   + Or, you can specify the ObjectID of your desired root container (eg. 1$F for Music/Playlists)
# if you specify "B" and client device is audio-only then "Music/Folders" will be used as root
{% if root_container is defined and root_container is not none and (root_container is number or root_container is boolean or root_container | length > 0) %}root_container={{ root_container }}
{% else %}#root_container=.
{% endif %}
# always force SortCriteria to this value, regardless of the SortCriteria passed by the client
# note: you can prepend the sort criteria with "!" to alter the titles of the objects so that they
# will be alphanumerically sorted in the order you specify here, to work around clients that do their
# own alphanumeric sorting.
{% if force_sort_criteria is defined and force_sort_criteria is not none and (force_sort_criteria is number or force_sort_criteria is boolean or force_sort_criteria | length > 0) %}force_sort_criteria={{ force_sort_criteria }}
{% else %}#force_sort_criteria=+upnp:class,+upnp:originalTrackNumber,+dc:title
{% endif %}
# maximum number of simultaneous connections
# note: many clients open several simultaneous connections while streaming
{% if max_connections is defined and max_connections is not none and (max_connections is number or max_connections is boolean or max_connections | length > 0) %}max_connections={{ max_connections }}
{% else %}#max_connections=50
{% endif %}
# set this to yes to allow symlinks that point outside user-defined media_dirs.
{% if wide_links is defined and wide_links is not none and (wide_links is number or wide_links is boolean or wide_links | length > 0) %}wide_links={{ wide_links }}
{% else %}#wide_links=no
{% endif %}
# enable subtitle support by default on unknown clients.
# note: the default is yes
{% if enable_subtitles is defined and enable_subtitles is not none and (enable_subtitles is number or enable_subtitles is boolean or enable_subtitles | length > 0) %}enable_subtitles={{ enable_subtitles }}
{% else %}#enable_subtitles=yes
{% endif %}