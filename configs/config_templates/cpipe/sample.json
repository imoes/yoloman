{
  "cpipe_instances": [
    {
      "command": "tar cCf / - usr",
      "show_read_times": true,
      "show_write_times": true,
      "show_throughput": true
    },
    {
      "command": "dd if=/dev/zero bs=1M count=100",
      "buffer_size": 256,
      "speed_limit": 1024.0,
      "prefix": "DUPLEX:",
      "non_greedy_read": true
    }
  ]
}
