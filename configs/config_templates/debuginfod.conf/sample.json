{
  "base_cache_dir": "/var/cache/debuginfod",
  "executable_cache_dir": "/var/lib/debuginfod",
  "upstream_debuginfods": [
    "https://debuginfod.ubuntu.com",
    "https://debuginfod.fedoraproject.org"
  ],
  "port": 8002,
  "bind_address": "127.0.0.1",
  "max_workers": 16,
  "cache_size_limit": 10737418240,
  "cache_ttl": 604800,
  "compress_cache": true,
  "prune_cache": true,
  "proxy_url": "",
  "cacert_path": "/etc/ssl/certs/ca-certificates.crt",
  "tls_verify": true,
  "upstream_auth_users": [
    {
      "username": "debuginfod-user",
      "password": "secret-password"
    }
  ],
  "metrics_enabled": true,
  "verbose": false,
  "log_file": "/var/log/debuginfod/debuginfod.log",
  "max_downloads_per_client": 8,
  "max_upstream_connections": 64,
  "upstream_connection_ttl": 300,
  "supported_protocols": [
    "v2"
  ],
  "compress_responses": true,
  "upstream_timeout": 30,
  "upstream_keepalive": true
}
