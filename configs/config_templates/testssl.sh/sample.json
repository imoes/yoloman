{
  "install_dir": "/usr/local/testssl.sh",
  "openssl_path": "/usr/bin/openssl",
  "openssl_2_path": "",
  "output_dir": "/var/log/testssl",
  "output_prefix": "prod-",
  "wide_output": true,
  "color_output": 2,
  "nodns": "min",
  "connect_timeout": 15,
  "openssl_timeout": 5,
  "phone_out": "true",
  "additional_ca_files": "",
  "assume_http": true,
  "basicauth": "",
  "reqheaders": [
    "X-Forwarded-For: 192.168.1.1",
    "Accept-Language: en-US"
  ],
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
  "days2warn1": 45,
  "days2warn2": 20,
  "hsts_min": 179,
  "hpkp_min": 30,
  "severity_threshold": "HIGH",
  "overwrite": false,
  "append": false,
  "max_parallel": 10,
  "max_wait_test": 600,
  "disable_rating": false,
  "ssl_native": false,
  "proxy": "",
  "dns_via_proxy": false,
  "ign_ocsp_proxy": false,
  "ca_bundles_path": "",
  "max_socket_fail": 3,
  "max_ossl_fail": 3,
  "max_header_fail": 5,
  "all_clients": false,
  "show_each": true,
  "mapping": "iana",
  "colorblind": false,
  "debug": 0,
  "ids_friendly": false,
  "hints": true,
  "sneaky": false,
  "quiet": false
}
