# ==============================================================================
# testssl.sh Configuration Template
# ==============================================================================
# This template generates a configuration block for testssl.sh, a tool for testing
# SSL/TLS encryption on servers. The variables below control the certificate
# identification metadata used during testing or reporting.
#
# Note: testssl.sh is primarily a CLI tool. This template assumes the variables
# are passed to the script via environment variables or command-line arguments
# rather than a static configuration file, as testssl.sh does not typically
# use a persistent config file for these specific certificate details.
# However, if this template is intended to generate a wrapper script or a
# specific configuration file for a wrapper, the fields below provide the
# necessary context for certificate identification.

# ------------------------------------------------------------------------------
# Organization Name
# Description: Organization name for the certificate.
# ------------------------------------------------------------------------------
ORGANIZATION="{{ ORGANIZATION | default('Default Organization') }}"

# ------------------------------------------------------------------------------
# Department Name
# Description: Department name for the certificate.
# ------------------------------------------------------------------------------
DEPARTMENT="{{ DEPARTMENT | default('Default Department') }}"

# ------------------------------------------------------------------------------
# Country Code
# Description: Country code for the certificate.
# ------------------------------------------------------------------------------
COUNTRY="{{ COUNTRY | default('US') }}"

# ------------------------------------------------------------------------------
# State or Province Name
# Description: State or province name for the certificate.
# ------------------------------------------------------------------------------
STATE="{{ STATE | default('Default State') }}"

# ------------------------------------------------------------------------------
# City Name
# Description: City name for the certificate.
# ------------------------------------------------------------------------------
CITY="{{ CITY | default('Default City') }}"

# ------------------------------------------------------------------------------
# Common Name
# Description: Common Name (domain) for the certificate.
# ------------------------------------------------------------------------------
COMMON_NAME="{{ COMMON_NAME | default('default.example.com ; example.com') }}"
