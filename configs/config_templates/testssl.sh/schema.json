{
  "ORGANIZATION": {
    "type": "string",
    "default": "Default Organization",
    "description": "Organization name for the certificate."
  },
  "DEPARTMENT": {
    "type": "string",
    "default": "Default Department",
    "description": "Department name for the certificate."
  },
  "COUNTRY": {
    "type": "string",
    "default": "US",
    "description": "Country code for the certificate."
  },
  "STATE": {
    "type": "string",
    "default": "Default State",
    "description": "State or province name for the certificate."
  },
  "CITY": {
    "type": "string",
    "default": "Default City",
    "description": "City name for the certificate."
  },
  "COMMON_NAME": {
    "type": "string",
    "default": "default.example.com ; example.com",
    "description": "Common Name (domain) for the certificate."
  }
}
