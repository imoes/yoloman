{
  "interfaces": [
    "eth0",
    "wlan0"
  ],
  "mcast_group": "224.0.0.251",
  "port": 5353,
  "ipv6_enabled": false,
  "mcast_group_v6": "ff02::fb",
  "max_cache_ttl": 120,
  "negative_cache_ttl": 10,
  "log_level": "warn",
  "log_file": "/var/log/mdns-reflector.log",
  "worker_threads": 2,
  "rate_limit_qps": 200,
  "rate_limits_by_iface": [
    {
      "interface": "wlan0",
      "rate_limit_qps": 50
    }
  ],
  "blacklist_domains": [
    "_homekit._tcp.local",
    "_airplay._tcp.local"
  ],
  "whitelist_domains": [],
  "service_reflection": true,
  "ptr_reflection": false,
  "record_ttl": 60,
  "bind_addr": "",
  "override_ttl": 0
}
