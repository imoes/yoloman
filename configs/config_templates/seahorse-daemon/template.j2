# Seahorse Daemon Configuration
# This file configures the seahorse-daemon passphrase caching agent.
# Note: seahorse-daemon primarily uses command-line arguments. This template
# generates a default arguments string for a service wrapper or init script,
# as no native .conf file exists for this specific daemon in modern Debian packages.

# Run seahorse-daemon in the foreground (do not daemonize) when managed by systemd.
# Corresponds to: -d, --no-daemonize
# Default: true (recommended for systemd service managers)
{% if no_daemonize | default(true) %}-d {% endif %}

# Add any additional GTK+ or GNOME standard command line options here.
# Corresponds to: Additional GTK+ and GNOME options
# Default: empty list
{% for option in extra_options | default([]) %}{{ option }} {% endfor %}