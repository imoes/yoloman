############################################################
# /etc/amanda-security.conf                                #
#                                                          #
# Amanda security configuration.                           #
# See: man amanda-security.conf                            #
#                                                          #
# This file must be installed at /etc/amanda-security.conf #
############################################################

# Primary path to gnutar used by runtar in amanda-client
runtar:gnutar_path={{ runtar_gnutar_path | default('/bin/tar') }}

# Alternative path to gnutar used by runtar (fallback)
runtar:gnutar_path={{ runtar_gnutar_path_alt | default('/usr/bin/tar') }}

# Primary path to gnutar used by amgtar in amanda-client
amgtar:gnutar_path={{ amgtar_gnutar_path | default('/bin/tar') }}

# Alternative path to gnutar used by amgtar (fallback)
amgtar:gnutar_path={{ amgtar_gnutar_path_alt | default('/usr/bin/tar') }}

# Uncomment to use GNU star instead of tar for Amanda-specific operations
#amstar:star_path=/usr/bin/star

# Uncomment to use bsdtar for Amanda-specific operations
#ambsdtar:bsdtar_path=/usr/bin/bsdtar

# Restore files as the amanda user (yes/no)
#restore_by_amanda_user=no

# TCP port range for Amanda communication (lower,upper)
tcp_port_range={{ tcp_port_range | default('512,1024') }}

# UDP port range for Amanda communication (lower,upper)
udp_port_range={{ udp_port_range | default('840,860') }}