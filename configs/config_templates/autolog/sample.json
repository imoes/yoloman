{
  "idle_timeout": 3600,
  "grace_period": 120,
  "enabled": true,
  "exclude_users": [
    "root",
    "nobody"
  ],
  "protected_sessions": [
    "ssh",
    "x11",
    "wayland"
  ],
  "log_file": "/var/log/autolog/autolog.log",
  "log_level": "info",
  "extended_tracking": true,
  "services": [
    {
      "name": "ssh",
      "timeout": 7200
    },
    {
      "name": "xrdp",
      "timeout": 5400
    }
  ]
}
