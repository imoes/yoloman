# Configuration for Kleopatra debug commands.
#
# This file controls the behavior of Kleopatra's debug utilities.
# Adjusting these settings can help diagnose GPG/GnuPG issues
# when interacting with the GnuPG agent or gpgconf.

[DebugCommands]
# kleopatra_debug_command: The debug command executed by Kleopatra.
# Default: gpgconf -X=gpgconf -X
# This command is used by the Kleopatra interface for debugging GnuPG operations.
1;{{ kleopatra_debug_command | default('gpgconf -X=gpgconf -X') }}
