{
  "server_name": "irc.example.org",
  "server_info": "ngIRCd with WebIRC Proxy",
  "server_webirc_enabled": true,
  "max_connections": 200,
  "max_connections_per_ip": 10,
  "max_log_entries": 1000,
  "timeout_seconds": 600,
  "ping_timeout_seconds": 120,
  "pong_timeout_seconds": 60,
  "listen_ports": [
    6667,
    6668
  ],
  "listen_addresses": [
    "0.0.0.0",
    "::"
  ],
  "ssl_cipher_list": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "ssl_dhfile": "/etc/ssl/dhparam.pem",
  "ssl_key_file": "/etc/ssl/private/irc.key",
  "ssl_cert_file": "/etc/ssl/certs/irc.crt",
  "ssl_ca_file": "/etc/ssl/certs/ca.crt",
  "ssl_verify_mode": "optional",
  "ssl_ports": [
    6697
  ],
  "operators": [
    {
      "name": "Admin",
      "password_hash": "$6$rounds=5000$salt$hash...",
      "host": "admin.example.net",
      "flags": [
        "global",
        "kline"
      ]
    }
  ],
  "channel_max_users_per_channel": 200,
  "channel_topic_protection": true,
  "channel_default_key": "",
  "channel_max_channels_per_user": 20,
  "syslog_facility": "local0",
  "log_file_path": "/var/log/ngircd/ngircd.log",
  "log_level": "Notice",
  "webirc_enabled": true,
  "webirc_url": "https://webirc.example.org/",
  "webirc_exec_path": "/usr/bin/ngircd-mod_exec",
  "module_path": "/usr/lib/ngircd",
  "module_config_path": "/etc/ngircd/mod_exec.conf",
  "module_exec_path": "/usr/lib/ngircd/mod_exec.so"
}
