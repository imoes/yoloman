{
  "server_name": "irc.example.net",
  "server_info": "ngIRCd IRC Server",
  "server_webirc_enabled": false,
  "max_connections": 100,
  "max_connections_per_ip": 5,
  "max_log_entries": 500,
  "timeout_seconds": 300,
  "ping_timeout_seconds": 120,
  "pong_timeout_seconds": 60,
  "listen_ports": [
    6667
  ],
  "listen_addresses": [
    "0.0.0.0"
  ],
  "ssl_cipher_list": "HIGH:MEDIUM:!aNULL:!MD5:!3DES",
  "ssl_dhfile": "/etc/ssl/dhparam.pem",
  "ssl_key_file": "/etc/ssl/private/server.key",
  "ssl_cert_file": "/etc/ssl/certs/server.crt",
  "ssl_ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "ssl_verify_mode": "none",
  "ssl_ports": [
    6697
  ],
  "operators": [],
  "verbose": true,
  "pidfile_path": "/var/run/ngircd/ngircd.pid"
}
