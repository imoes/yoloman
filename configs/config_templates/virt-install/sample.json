{
  "vm_name": "fedora-38-vm",
  "vm_memory": 4096,
  "vm_vcpus": 4,
  "os_info": "fedora38",
  "install_source": "location",
  "install_source_url": "https://download.fedoraproject.org/pub/fedora/linux/releases/38/Server/x86_64/os",
  "install_source_path": "",
  "disks": [
    {
      "args": "size=20"
    }
  ],
  "networks": [
    {
      "args": "network=default"
    }
  ],
  "graphics_type": "vnc",
  "graphics_listen": "0.0.0.0",
  "graphics_port": 5900,
  "autoconsole": "graphical",
  "libvirt_uri": "qemu:///system"
}
