{
  "inputfile": {
    "type": "string",
    "default": "fll",
    "description": "Path to engine input file (fll|fis|fcl)",
    "enum": [
      "fll",
      "fis",
      "fcl"
    ]
  },
  "input_format": {
    "type": "string",
    "default": "fll",
    "description": "Format of input file: fll, fis, or fcl",
    "enum": [
      "fll",
      "fis",
      "fcl"
    ]
  },
  "outputfile": {
    "type": "string",
    "default": "fll",
    "description": "Path to engine output file",
    "enum": [
      "fll",
      "fld",
      "cpp",
      "java",
      "fis",
      "fcl"
    ]
  },
  "output_format": {
    "type": "string",
    "default": "fll",
    "description": "Format of output file: fll, fld, cpp, java, fis, fcl",
    "enum": [
      "fll",
      "fld",
      "cpp",
      "java",
      "fis",
      "fcl"
    ]
  },
  "example": {
    "type": "string",
    "default": "m",
    "description": "Built-in example selector: 'm' (Mamdani) or 't' (Takagi-Sugeno)",
    "enum": [
      "m",
      "t"
    ],
    "enum_open": true
  },
  "decimals": {
    "type": "number",
    "default": 6,
    "description": "Number of decimal places for floating-point values"
  },
  "datafile": {
    "type": "string",
    "default": "",
    "description": "Path to input data file for .fld evaluation"
  },
  "maximum_results": {
    "type": "number",
    "default": 100,
    "description": "Maximum number of evaluation results when exporting .fld without datafile"
  },
  "include_header": {
    "type": "bool",
    "default": true,
    "description": "Include header row when exporting .fld"
  },
  "include_inputs": {
    "type": "bool",
    "default": true,
    "description": "Include input values in .fld output"
  }
}
