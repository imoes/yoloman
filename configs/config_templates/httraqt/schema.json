{
  "general": {
    "type": "object",
    "default": "general",
    "description": "General settings section"
  },
  "default_url": {
    "type": "string",
    "default": "http://www.example.com",
    "description": "The default starting URL for downloads"
  },
  "download": {
    "type": "object",
    "default": "download",
    "description": "Download behavior settings"
  },
  "max_retries": {
    "type": "number",
    "default": 3,
    "description": "Maximum number of retry attempts for failed connections"
  },
  "user_agent": {
    "type": "string",
    "default": "HTTraQt/1.4.11",
    "description": "Custom User-Agent string sent to web servers"
  },
  "proxy": {
    "type": "object",
    "default": "proxy",
    "description": "Proxy server configuration"
  },
  "enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether to use a proxy server"
  },
  "host": {
    "type": "string",
    "default": "localhost",
    "description": "Proxy server hostname or IP"
  },
  "port": {
    "type": "number",
    "default": 8080,
    "description": "Proxy server port number"
  },
  "use_auth": {
    "type": "bool",
    "default": false,
    "description": "Whether the proxy requires authentication"
  },
  "user": {
    "type": "string",
    "default": "",
    "description": "Proxy authentication username"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Proxy authentication password"
  },
  "appearance": {
    "type": "object",
    "default": "appearance",
    "description": "UI appearance and language settings"
  },
  "theme": {
    "type": "string",
    "default": "system",
    "description": "UI theme preference (light, dark, or system)",
    "enum": [
      "system",
      "light"
    ]
  },
  "language": {
    "type": "string",
    "default": "en",
    "description": "Interface language code (ISO 639-1)"
  },
  "logs": {
    "type": "object",
    "default": "logs",
    "description": "Logging configuration"
  },
  "level": {
    "type": "string",
    "default": "info",
    "description": "Minimum log level severity (error, info, debug)"
  },
  "file": {
    "type": "string",
    "default": "/var/log/httraqt.log",
    "description": "Absolute path to the log file"
  },
  "version": {
    "type": "string",
    "default": "1.4.11",
    "description": "HTTraQt version string for User-Agent construction"
  }
}
