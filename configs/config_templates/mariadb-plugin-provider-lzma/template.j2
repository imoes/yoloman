# MariaDB Plugin Provider Configuration for LZMA Compression
# This section configures the loading behavior of the LZMA compression provider plugin.
# It is typically used in conjunction with the MariaDB server's compression capabilities.

[server]

# Plugin to load for LZMA compression provider.
# Specifies the plugin name or file path required to enable LZMA support.
# Default value is 'provider_lzma' as per schema.
plugin_load_add={{ plugin_load_add | default('provider_lzma') }}

# Load mode for the LZMA provider plugin.
# Defines how and when the plugin is loaded.
# Allowed values: 'on', 'skip', 'force_plus_permanent'.
# 'force_plus_permanent' ensures the plugin is always loaded and cannot be unloaded.
# Default value is 'force_plus_permanent' as per schema.
provider_lzma={{ provider_lzma | default('force_plus_permanent') }}
