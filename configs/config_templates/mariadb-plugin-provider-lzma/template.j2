# MariaDB Plugin Configuration: LZMA Compression Provider
# This file configures the plugin_load_add and provider_lzma settings
# for the MariaDB LZMA plugin, enabling LZMA compression support.

# Plugin to load for LZMA compression provider.
[server]
plugin_load_add={{ plugin_load_add | default('provider_lzma') }}
provider_lzma={{ provider_lzma | default('force_plus_permanent') }}