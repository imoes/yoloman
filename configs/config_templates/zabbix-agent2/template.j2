# Zabbix Agent 2 Configuration Template
# This configuration file manages the Zabbix Agent 2 daemon.
# It defines runtime behavior, connection targets for passive/active checks,
# and security settings (TLS).

############ GENERAL PARAMETERS #################

### Option: PidFile
# Directory for Zabbix Agent 2 runtime files, including PID file.
# The full path is constructed as: {{ zabbix_agent2_run_dir | default('/run/zabbix') }}/zabbix_agent2.pid
PidFile={{ zabbix_agent2_run_dir | default('/run/zabbix') }}/zabbix_agent2.pid

### Option: LogType
# Specifies where log messages are written to: system, file, or console.
# Default is 'file', using the LogFile path below.

### Option: LogFile
# Log file name for LogType 'file' parameter.
LogFile=/var/log/zabbix/zabbix_agent2.log

### Option: LogFileSize
# Maximum size of log file in MB.
# 0 - disable automatic log rotation.
LogFileSize=0

### Option: DebugLevel
# Specifies debug level (0-5).
# 3 is standard for error/warning/info.
# Default: 3
# DebugLevel=3

### Option: SourceIP
# Source IP address for outgoing connections.
# SourceIP=

##### Passive checks related

### Option: Server
# IP address or DNS name of the Zabbix server/proxy for passive checks.
# Incoming connections will be accepted only from the hosts listed here.
# If left empty or not set, passive checks are disabled.
# Example: Server=127.0.0.1,192.168.1.0/24
Server={{ zabbix_agent2_server | default('127.0.0.1') }}

### Option: ListenPort
# Agent will listen on this port for connections from the server.
# Default: 10050
# ListenPort=10050

### Option: ListenIP
# List of comma delimited IP addresses that the agent should listen on.
# Default: 0.0.0.0
# ListenIP=0.0.0.0

### Option: StatusPort
# Agent will listen on this port for HTTP status requests.
# Default: 10050
# StatusPort=10050

##### Active checks related

### Option: ServerActive
# IP address or DNS name of the Zabbix server/proxy for active checks.
# Can include port (e.g., 127.0.0.1:10051).
# If not specified, active checks are disabled.
# Supports multiple servers separated by comma, or clusters by semicolon.
ServerActive={{ zabbix_agent2_server_active | default('127.0.0.1') }}

### Option: Hostname
# Unique, case sensitive hostname for the agent.
# Required for active checks and must match the hostname configured on the Zabbix Server.
# If undefined, the system's hostname is often used as a fallback by the agent binary,
# but explicit configuration is preferred.
Hostname={{ zabbix_agent2_hostname | default('Zabbix server') }}

### Option: HostMetadata
# Optional parameter that defines host metadata for auto-registration.
# HostMetadata=

####### ADVANCED PARAMETERS #################

### Option: Timeout
# Specifies how long to wait (in seconds) for establishing connection and exchanging data.
# Range: 1-30
# Default: 3
# Timeout=3

### Option: PluginTimeout
# Timeout for connections with external plugins.
# Range: 1-30
# PluginTimeout=3

### Option: ControlSocket
# The control socket path, used to send runtime commands with the -R option.
# Located in the runtime directory.
ControlSocket={{ zabbix_agent2_run_dir | default('/run/zabbix') }}/agent.sock

####### TLS-RELATED PARAMETERS #######

### Option: TLSConnect
# How the agent should connect to server or proxy for active checks.
# Values: unencrypted, psk, cert.
# Default: unencrypted
# TLSConnect=unencrypted

### Option: TLSAccept
# What incoming connections to accept from the server/proxy.
# Values: unencrypted, psk, cert.
# Default: unencrypted
# TLSAccept=unencrypted

### Option: TLSCAFile
# Full pathname of a file containing the top-level CA(s) certificates for peer certificate verification.
# TLSCAFile=

### Option: TLSCertFile
# Full pathname of a file containing the agent certificate or certificate chain (for 'cert' mode).
# TLSCertFile=

### Option: TLSKeyFile
# Full pathname of a file containing the agent private key (for 'cert' mode).
# TLSKeyFile=

### Option: TLSPSKIdentity
# Unique, case sensitive string used to identify the pre-shared key (for 'psk' mode).
# TLSPSKIdentity=

### Option: TLSPSKFile
# Full pathname of a file containing the pre-shared key (for 'psk' mode).
# TLSPSKFile=

####### Additional configuration files  #######

### Option: Include
# You may include individual files or all files in a directory in the configuration file.
# This allows modular configuration of plugins and user parameters.
Include=/etc/zabbix/zabbix_agent2.d/*.conf
