{
  "fail_exit_code": 1,
  "stack_size": 2097152,
  "path_prefix": "/usr/share/njs",
  "disabled_denormals": true,
  "disabled_unsafe": false,
  "sandbox": true,
  "ignore_unhandled_promise_rejection": true,
  "load_as_es6_module": true,
  "modules": [
    {
      "name": "http",
      "path": "/usr/share/njs/http.js"
    },
    {
      "name": "logger",
      "path": "/etc/njs/logger.js"
    }
  ],
  "command": "console.log('Hello from njs configuration script!');"
}
