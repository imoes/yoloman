{
  "read_ahead_sect": {
    "type": "number",
    "default": 12,
    "description": "Sector count for filesystem read-ahead"
  },
  "lookahead": {
    "type": "string",
    "default": "on",
    "description": "Disable/enable the IDE drive's read-lookahead feature (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "bus": {
    "type": "string",
    "default": "on",
    "description": "Bus state (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "apm": {
    "type": "number",
    "default": 255,
    "description": "APM setting (1-255); 255 = disabled"
  },
  "apm_battery": {
    "type": "number",
    "default": 127,
    "description": "APM setting when on battery (1-255); 255 = disabled"
  },
  "io32_support": {
    "type": "number",
    "default": 1,
    "description": "Enable (E)IDE 32-bit I/O support (0|1|3)"
  },
  "dma": {
    "type": "string",
    "default": "off",
    "description": "Disable/enable the \"using_dma\" flag (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "defect_mana": {
    "type": "string",
    "default": "off",
    "description": "Enable/disable on-drive defect management (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "cd_speed": {
    "type": "number",
    "default": 16,
    "description": "CD-ROM speed setting"
  },
  "keep_settings_over_reset": {
    "type": "string",
    "default": "off",
    "description": "Disable/enable the \"keep_settings_over_reset\" flag (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "keep_features_over_reset": {
    "type": "string",
    "default": "on",
    "description": "Disable/enable the drive's \"keep_features_over_reset\" flag (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "mult_sect_io": {
    "type": "number",
    "default": 32,
    "description": "Sector count for multiple sector I/O"
  },
  "prefetch_sect": {
    "type": "number",
    "default": 12,
    "description": "Maximum sector count for the drive's internal prefetch mechanism"
  },
  "read_only": {
    "type": "string",
    "default": "off",
    "description": "Read-only flag for device (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "write_read_verify": {
    "type": "string",
    "default": "off",
    "description": "Enable/Disable Write-Read-Verify (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "poweron_standby": {
    "type": "string",
    "default": "off",
    "description": "Turn on/off power on in standby mode (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "spindown_time": {
    "type": "number",
    "default": 24,
    "description": "Standby (spindown) timeout in 500ms units (0 = never spin down)"
  },
  "force_spindown_time": {
    "type": "number",
    "default": 24,
    "description": "Same as spindown_time, but applied even if disk doesn\u2019t support APM (Debian-specific)"
  },
  "interrupt_unmask": {
    "type": "string",
    "default": "on",
    "description": "Interrupt-unmask flag for the drive (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "write_cache": {
    "type": "string",
    "default": "off",
    "description": "Disable/enable the IDE drive's write-caching feature (on|off)",
    "enum": [
      "on",
      "off"
    ]
  },
  "transfer_mode": {
    "type": "number",
    "default": 34,
    "description": "IDE transfer mode (e.g., 34 = multiword DMA mode 2)"
  },
  "acoustic_management": {
    "type": "string",
    "default": "128",
    "description": "Acoustic management value (e.g., 128 for medium performance)"
  }
}
