#!/bin/bash
# Cron script to cleanup the uploaded archives database from old entries.
#
# This script reads the uploaded archives database and removes entries older
# than the configured retention period. It respects upload-specific TTL overrides
# for SCP, SSH-GPG, FTP, and S3 methods.
#
# Variables are sourced from /etc/backup-manager.conf, enriched with schema defaults
# to ensure safe rendering even if configuration is missing or partial.

# Do not run if backup-manager is not installed, or
# the conf file does not exist or is not readable.

[ -x /usr/sbin/backup-manager ] || exit 0
[ -r /etc/backup-manager.conf ] || exit 0

. /etc/backup-manager.conf

# Do not run if the site admin has not already activated
# the uploaded database or it does not (yet) exist.
# BM_UPLOADED_ARCHIVES: Path to the file containing the database of uploaded archives.

[ "X${BM_UPLOADED_ARCHIVES}" != "X" ] || exit 0
[ -f ${BM_UPLOADED_ARCHIVES} ] || exit 0

# Guard against improper configuration values; give sensible defaults.

# MINPER: Minimum number of days back of entries to keep in the uploaded archives database.
MINPER={{ minper | default(7) }}

# OTHPER: Number of days back of entries to keep for other upload methods (e.g., S3) when TTL is not explicitly configured.
OTHPER={{ otherper | default(30) }}

# BM_ARCHIVE_TTL: Time-to-live (in days) for archives — used as baseline retention period.
# We force it to be an integer to prevent arithmetic errors.
PERIOD=$(expr {{ BM_ARCHIVE_TTL | default(7) | int }} \+ 0 2>/dev/null)

# If TTL is missing, non-numeric, or less than 1, fallback to minimum period.
if [ "X${PERIOD}" = "X" ] || [ ${PERIOD} -lt 1 ]; then
    PERIOD=${MINPER}
fi

# BM_UPLOAD_METHOD: Upload method used (e.g., scp, ssh-gpg, ftp, s3). Determines retention logic.
case ${BM_UPLOAD_METHOD} in
    scp|ssh-gpg)
        # BM_UPLOAD_SSH_TTL: Time-to-live (in days) for SSH-based uploads (scp, ssh-gpg). Overrides archive TTL if set.
        if [ "X${BM_UPLOAD_SSH_TTL}" != "X" ]; then
            PDIFF=$(expr {{ BM_UPLOAD_SSH_TTL | default(30) | int }} - ${PERIOD} 2>/dev/null)
        fi
        ;;
    ftp)
        # BM_UPLOAD_FTP_TTL: Time-to-live (in days) for FTP uploads. Overrides archive TTL if set.
        if [ "X${BM_UPLOAD_FTP_TTL}" != "X" ]; then
            PDIFF=$(expr {{ BM_UPLOAD_FTP_TTL | default(30) | int }} - ${PERIOD} 2>/dev/null)
        fi
        ;;
    s3)
        # For S3 we choose a conservative value because there
        # is no way to know the time-to-live on the remote host.
        # Uses OTHPER as the base override value.

        PDIFF=$(expr ${OTHPER} - ${PERIOD} 2>/dev/null)
        ;;
    *)
        # The upload database is not used in any other method
        # than those listed above. Exit silently.
        exit 0
        ;;
esac

# A bad configuration may result in either a null or a negative PDIFF.
# Correct this here.

if [ "X${PDIFF}" = "X" ] || [ ${PDIFF} -lt 0 ]; then
    PDIFF=0
fi

# Calculate final period including the delta.
PERIOD=$(expr ${PERIOD} \+ ${PDIFF} 2>/dev/null)

# Calculate the date threshold for purging (YYYYMMDD).
PURGE_DATE=$(date "+%Y%m%d" --date ${PERIOD}" days ago")

# Create a temporary file for the cleaned database.
NEW_UPLOAD_DB=$(mktemp)
if [ $? -ne 0 ]; then
    >&2 echo "Error: cannot create temporary file; aborting."
    exit 2
fi

# Use backup-manager configuration values for permissions
# removing the executable bits (database is a file).

# Trap to ensure cleanup on exit.
trap "rm -f ${NEW_UPLOAD_DB}" EXIT

# Ensure ownership matches the repository user/group.
# BM_REPOSITORY_USER: User owning the backup repository directory and files.
# BM_REPOSITORY_GROUP: Group owning the backup repository directory and files.
chown {{ BM_REPOSITORY_USER | default('backup-manager') }}:{{ BM_REPOSITORY_GROUP | default('backup-manager') }} ${NEW_UPLOAD_DB}

# BM_REPOSITORY_CHMOD: Permission mode (octal) applied to repository files (e.g., uploaded archives database).
chmod {{ BM_REPOSITORY_CHMOD | default('0640') }} ${NEW_UPLOAD_DB}
chmod a-x ${NEW_UPLOAD_DB}
set +e

# Now that we have ensured that source and destination exist,
# read in the lines and remove any older than $PURGE_DATE.
# We iterate line-by-line, extract the archive name and date,
# and keep the line if the archive is newer than the purge date
# OR if the physical file still exists (to preserve hashes).

while read line; do

    archive=$(echo "${line}" | cut -d' ' -f1)
    arch_date=$(echo "${archive}" \
      | sed -e 's/.*\([0-9][0-9][0-9][0-9][01][0-9][0-3][0-9]\).*/\1/')

    # Both days are pure numbers of the form YYYYMMDD. Thus comparison
    # can be reduced to a simple numeric comparison (newer is bigger).

    if [ ${arch_date} -gt ${PURGE_DATE} ]; then
        echo "${line}"

    # We do not remove hashes of existing archives, even if older than
    # $PURGE_DATE (if it stayed there, it has to be a reason).
    # BM_REPOSITORY_ROOT: Root directory of the backup repository where archives are stored.
    elif [ -f {{ BM_REPOSITORY_ROOT | default('/var/backup-manager') }}/${archive} ]; then
        echo "${line}"
    fi

done < ${BM_UPLOADED_ARCHIVES} >> ${NEW_UPLOAD_DB}

if [ $? -ne 0 ]; then
    >&2 echo "Error parsing BM_UPLOADED_ARCHIVES database; file was not updated"
    exit 3
fi
trap - EXIT

# If all went well, replace the database.

if mv ${NEW_UPLOAD_DB} ${BM_UPLOADED_ARCHIVES} ; then
    :
else
    >&2 echo "Error replacing backup-manager BM_UPLOADED_ARCHIVES with updated values;"
    >&2 echo "please check its status (updated file was at: $NEW_UPLOAD_DB)"
    exit 4
fi