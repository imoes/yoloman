# ==============================================================================
# MyProxy Server Configuration
# ==============================================================================
# This template generates the environment/startup configuration for the MyProxy server.
# MyProxy is a server for managing X.509 certificates and credentials, typically used
# in Grid computing environments.
#
# Variables are sourced from the Ansible role inventory. All variables use explicit
# defaults to ensure the template is safe and self-documenting.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment variables for MyProxy startup process
# ------------------------------------------------------------------------------

# MYPROXY_USER: The system user account under which MyProxy runs.
# This user must have read access to the data directory and private keys.
{% if myproxy_user is defined and myproxy_user is not none and (myproxy_user is number or myproxy_user is boolean or myproxy_user | length > 0) %}MYPROXY_USER={{ myproxy_user | default('myproxy') }}
{% else %}## MYPROXY_USER=myproxy
{% endif %}
# MYPROXY_OPTIONS: Additional options passed to the MyProxy server daemon.
# The default includes setting the secure data directory for certificates.
{% if myproxy_data_dir is defined and myproxy_data_dir is not none and (myproxy_data_dir is number or myproxy_data_dir is boolean or myproxy_data_dir | length > 0) %}MYPROXY_OPTIONS="-s {{ myproxy_data_dir | default('/var/lib/myproxy') }}"
{% else %}## MYPROXY_OPTIONS="-s /var/lib/myproxy"
{% endif %}
# X509_USER_CERT: Path to the host X.509 certificate file.
# Used by the server to identify itself to clients during TLS handshake.
{% if x509_host_cert is defined and x509_host_cert is not none and (x509_host_cert is number or x509_host_cert is boolean or x509_host_cert | length > 0) %}X509_USER_CERT={{ x509_host_cert | default('/etc/grid-security/myproxy/hostcert.pem') }}
{% else %}## X509_USER_CERT=/etc/grid-security/myproxy/hostcert.pem
{% endif %}
# X509_USER_KEY: Path to the host X.509 private key file.
# MUST be kept secret and readable only by the myproxy_user.
{% if x509_host_key is defined and x509_host_key is not none and (x509_host_key is number or x509_host_key is boolean or x509_host_key | length > 0) %}X509_USER_KEY={{ x509_host_key | default('/etc/grid-security/myproxy/hostkey.pem') }}
{% else %}## X509_USER_KEY=/etc/grid-security/myproxy/hostkey.pem
{% endif %}