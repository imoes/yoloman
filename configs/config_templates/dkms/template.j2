#!/bin/sh

# Automatically install DKMS modules for the specified kernel.
# This script is invoked by the DKMS framework during kernel installation.
# Argument $1 is the kernel version string being installed.

inst_kern=$1

# Path to the dkms_autoinstaller executable.
# Default: /usr/lib/dkms/dkms_autoinstaller
# If the executable exists and is executable, run it to install modules.
if [ -x {{ dkms_autoinstaller_path | default('/usr/lib/dkms/dkms_autoinstaller') }} ]; then
    exec {{ dkms_autoinstaller_path | default('/usr/lib/dkms/dkms_autoinstaller') }} start "$inst_kern"
fi
