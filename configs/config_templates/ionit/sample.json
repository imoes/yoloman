{
  "templates_dir": "/etc/ionit/templates",
  "config_dir": "/etc/ionit/contexts",
  "template_extension": "jinja2",
  "context": [
    {
      "key": "hostname",
      "value": "ionit-server-01"
    },
    {
      "key": "log_level",
      "value": "info"
    },
    {
      "key": "debug",
      "value": "false"
    }
  ],
  "services": [
    {
      "name": "nginx",
      "enabled": true,
      "config_path": "/etc/nginx/nginx.conf.jinja"
    },
    {
      "name": "postgresql",
      "enabled": true,
      "config_path": "/etc/postgresql/pg_hba.conf.jinja"
    }
  ]
}
