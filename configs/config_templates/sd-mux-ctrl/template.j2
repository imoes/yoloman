# SD-MUX-CTRL Device Configuration
# This file configures the default behavior for sd-mux-ctrl interactions.
# It is intended to be generated by Ansible and consumed by the sd-mux-ctrl CLI tool.

# ==============================================================================
# Device Addressing
# ==============================================================================

# --device-serial: Serial number of the specific sd-mux device to address.
# Recommended way of addressing devices over --device-id.
device_serial = {{ device_serial | default('') }}

# ==============================================================================
# Hardware Identification Defaults
# ==============================================================================

# --vendor: Vendor ID (VID) for device discovery. Default 0x04e8 (Samsung).
# Used when device serial is not set or for initial discovery.
vendor_id = {{ vendor_id | default('0x04e8') }}

# --product: Product ID (PID) for device discovery. Default 0x6001.
product_id = {{ product_id | default('0x6001') }}

# ==============================================================================
# Device Type
# ==============================================================================

# --device-type: Type of sd-mux board ('sd-mux' or 'sd-wire').
# 'sd-mux': Standard full-sized board.
# 'sd-wire': Miniaturized version (SD multiplexing only).
device_type = {{ device_type | default('sd-mux') }}

# ==============================================================================
# Operation Configuration
# ==============================================================================

# --tick-time: Period in milliseconds for --tick command (power cycle delay).
# Default is 1000ms if not specified.
tick_time_ms = {{ tick_time_ms | default(1000) }}

# ==============================================================================
# Dynamic Jumper State
# ==============================================================================

# --dyper1: Control dynamic jumper 1 ('on' or 'off').
dyper1_state = {{ dyper1_state | default('off') }}

# --dyper2: Control dynamic jumper 2 ('on' or 'off').
dyper2_state = {{ dyper2_state | default('off') }}

# ==============================================================================
# Pin Control (FT245RL)
# ==============================================================================

# --pins: 8-bit word (hex) to set FT245RL D0-D7 pins.
pins_value = {{ pins_value | default('0x00') }}

# --invert: Invert bits given in --pins. Useful for debugging.
invert_pins = {{ invert_pins | default(false) | lower }}

# ==============================================================================
# Commands to Execute
# ==============================================================================

# list_devices: If true, runs --list to discover devices.
list_devices = {{ list_devices | default(false) | lower }}

# show_info: If true, runs --info for detailed device state.
show_info = {{ show_info | default(false) | lower }}

# show_status: If true, runs --status to check DUT/TS connection state.
show_status = {{ show_status | default(false) | lower }}

# show_serial: If true, runs --show-serial to print serial number.
show_serial = {{ show_serial | default(false) | lower }}

# set_serial: If true, runs --set-serial with the configured device_serial.
# Note: This writes VID/PID/Manufacturer as well.
set_serial = {{ set_serial | default(false) | lower }}

# init_device: If true, runs --init to reset device to known state (USB/SD to TS, DUT off).
init_device = {{ init_device | default(false) | lower }}

# connect_dut: If true, runs --dut to connect USB/SD to DUT and power it on.
connect_dut = {{ connect_dut | default(false) | lower }}

# connect_ts: If true, runs --ts to connect USB/SD to TS and power off DUT.
connect_ts = {{ connect_ts | default(false) | lower }}

# tick: If true, runs --tick to power cycle DUT (disconnect/reconnect after tick_time).
tick = {{ tick | default(false) | lower }}