{
  "agent_listen_addr": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "IP address for the SNMP daemon to listen on (0.0.0.0 = all interfaces)"
  },
  "agent_listen_port": {
    "type": "number",
    "default": 161,
    "description": "UDP port for SNMP requests (standard: 161)"
  },
  "system_name": {
    "type": "string",
    "default": "localhost",
    "description": "Value for the system.sysName MIB object"
  },
  "system_location": {
    "type": "string",
    "default": "Server Room",
    "description": "Value for the system.sysLocation MIB object"
  },
  "system_contact": {
    "type": "string",
    "default": "admin@example.com",
    "description": "Value for the system.sysContact MIB object"
  },
  "enable_agentx": {
    "type": "bool",
    "default": false,
    "description": "Enable AgentX protocol support for external subagents (e.g., net-snmp-detect)"
  },
  "agentx_socket_path": {
    "type": "string",
    "default": "/var/agentx/master",
    "description": "Path to the AgentX master socket (only used when AgentX is enabled)"
  },
  "communities": {
    "type": "list",
    "default": [
      {
        "name": "public",
        "source": "default"
      }
    ],
    "description": "List of SNMPv1/v2c read-only community strings",
    "items": {
      "name": {
        "type": "string",
        "description": "Community string name (e.g., 'public')"
      },
      "source": {
        "type": "string",
        "description": "Source network/netmask (e.g., '127.0.0.1', '10.0.0.0/8', or 'default' for any)",
        "default": "default"
      }
    }
  },
  "write_communities": {
    "type": "list",
    "default": [],
    "description": "List of SNMPv1/v2c read-write community strings (use with caution)",
    "items": {
      "name": {
        "type": "string",
        "description": "Community string name (e.g., 'private')"
      },
      "source": {
        "type": "string",
        "description": "Source network/netmask (e.g., '127.0.0.1', '10.0.0.0/8', or 'default' for any)",
        "default": "default"
      }
    }
  },
  "snmpv3_users": {
    "type": "list",
    "default": [],
    "description": "List of SNMPv3 users (for secure authentication and encryption)",
    "items": {
      "name": {
        "type": "string",
        "description": "SNMPv3 username"
      },
      "auth_protocol": {
        "type": "string",
        "enum": [
          "MD5",
          "SHA"
        ],
        "description": "Authentication protocol (MD5 or SHA)",
        "default": null
      },
      "auth_passphrase": {
        "type": "string",
        "description": "Authentication passphrase (min 8 chars)",
        "default": ""
      },
      "priv_protocol": {
        "type": "string",
        "enum": [
          "DES",
          "AES"
        ],
        "description": "Privacy (encryption) protocol (DES or AES)",
        "default": null
      },
      "priv_passphrase": {
        "type": "string",
        "description": "Privacy passphrase (min 8 chars)",
        "default": ""
      }
    }
  },
  "snmpv3_groups": {
    "type": "list",
    "default": [],
    "description": "List of SNMPv3 groups mapping users to security levels",
    "items": {
      "name": {
        "type": "string",
        "description": "Group name"
      },
      "sec_model": {
        "type": "string",
        "enum": [
          "v1",
          "v2c",
          "usm",
          "tsm"
        ],
        "description": "Security model: v1/v2c for communities, usm/tms for SNMPv3",
        "default": "usm"
      }
    }
  },
  "snmpv3_access": {
    "type": "list",
    "default": [],
    "description": "Access control rules for SNMPv3 groups",
    "items": {
      "group_name": {
        "type": "string",
        "description": "Name of the group to apply access to"
      },
      "sec_model": {
        "type": "string",
        "enum": [
          "v1",
          "v2c",
          "usm",
          "tsm"
        ],
        "description": "Security model (must match group)",
        "default": "usm"
      },
      "sec_level": {
        "type": "string",
        "enum": [
          "noAuthNoPriv",
          "authNoPriv",
          "authPriv"
        ],
        "description": "Required security level"
      },
      "read": {
        "type": "string",
        "description": "MIB view for read access (e.g., 'full')"
      },
      "write": {
        "type": "string",
        "description": "MIB view for write access (e.g., 'full')"
      },
      "notify": {
        "type": "string",
        "description": "MIB view for notifications (e.g., 'full')"
      }
    }
  },
  "trap_destinations": {
    "type": "list",
    "default": [],
    "description": "List of hosts to receive SNMPv2c traps",
    "items": {
      "host": {
        "type": "string",
        "description": "Hostname or IP of trap receiver"
      },
      "community": {
        "type": "string",
        "description": "Community string for trap authentication"
      }
    }
  },
  "disk_monitors": {
    "type": "list",
    "default": [
      {
        "mount_point": "/",
        "min_percent_free": 10
      }
    ],
    "description": "Disk usage monitoring rules",
    "items": {
      "mount_point": {
        "type": "string",
        "description": "Mount point path to monitor"
      },
      "min_percent_free": {
        "type": "number",
        "description": "Alert if free disk space drops below this percentage"
      }
    }
  },
  "enable_memory_monitor": {
    "type": "bool",
    "default": true,
    "description": "Enable high memory usage warning (requires memLoadHigh threshold)"
  },
  "memory_load_warning_threshold": {
    "type": "number",
    "default": 90,
    "description": "Memory load (in percent) at which to issue a warning (used only if memory monitor enabled)"
  },
  "monitored_processes": {
    "type": "list",
    "default": [
      {
        "name": "sshd"
      },
      {
        "name": "snmpd"
      }
    ],
    "description": "List of processes to monitor (ensure at least one instance is running)",
    "items": {
      "name": {
        "type": "string",
        "description": "Process name (must match exact command name)"
      },
      "max_count": {
        "type": "number",
        "description": "Maximum allowed instances (default: 1)",
        "default": 1
      }
    }
  },
  "log_to_syslog": {
    "type": "bool",
    "default": true,
    "description": "Log SNMP daemon messages to system syslog"
  },
  "log_file": {
    "type": "string",
    "default": "",
    "description": "Path to a dedicated SNMP log file (leave empty to disable file logging)"
  }
}
