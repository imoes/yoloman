{
  "agent_listen_addr": "0.0.0.0",
  "agent_listen_port": 161,
  "system_name": "webserver-01",
  "system_location": "Data Center Rack 4",
  "system_contact": "ops@acme.example.com",
  "enable_agentx": true,
  "agentx_socket_path": "/var/agentx/master",
  "communities": [
    {
      "name": "public",
      "source": "127.0.0.1"
    },
    {
      "name": "monitoring",
      "source": "10.10.0.0/16"
    }
  ],
  "write_communities": [
    {
      "name": "private",
      "source": "127.0.0.1"
    }
  ],
  "snmpv3_users": [
    {
      "name": "monitor",
      "auth_protocol": "SHA",
      "auth_passphrase": "secure_auth_pass",
      "priv_protocol": "AES",
      "priv_passphrase": "secure_priv_pass"
    }
  ],
  "snmpv3_groups": [
    {
      "name": "monitoring-group",
      "sec_model": "usm"
    }
  ],
  "snmpv3_access": [
    {
      "group_name": "monitoring-group",
      "sec_model": "usm",
      "sec_level": "authPriv",
      "read": "all",
      "write": "all",
      "notify": "all"
    }
  ],
  "trap_destinations": [
    {
      "host": "10.10.1.5",
      "community": "trap-public"
    }
  ],
  "disk_monitors": [
    {
      "mount_point": "/",
      "min_percent_free": 10
    },
    {
      "mount_point": "/var",
      "min_percent_free": 15
    }
  ],
  "enable_memory_monitor": true,
  "memory_load_warning_threshold": 85,
  "monitored_processes": [
    {
      "name": "sshd"
    },
    {
      "name": "nginx"
    },
    {
      "name": "snmpd"
    }
  ],
  "log_to_syslog": true,
  "log_file": ""
}
