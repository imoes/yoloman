# Configuration for urlextractor
# Base directory for runtime data, logs, and configuration.
home_dir={{ home_dir | default('~/.urlextractor') }}

# Path to the log file recording scanned sites.
# Uses the home_dir variable to ensure logs are stored within the runtime directory.
log_file={{ home_dir | default('~/.urlextractor') }}/log.csv

# Enable or disable directory fuzzing (like Dirbuster).
# 0 = disabled, 1 = enabled
dir_fuzz_enabled={{ dir_fuzz_enabled | default(true) }}

# List of directory paths to include in fuzzing.
# Items are flat strings representing path segments or full paths depending on tool expectation.
dir_list=
{% for item in dir_list | default([]) %}
{{ item }}
{% endfor %}

# Enable URLvoid API checks for ranking and blacklist info.
# 0 = disabled, 1 = enabled
urlvoid_enabled={{ urlvoid_enabled | default(true) }}

# Enable recursive robots.txt analysis for hidden content.
# 0 = disabled, 1 = enabled
robots_recursive_enabled={{ robots_recursive_enabled | default(true) }}

# Enable scanning source code for sensitive information like passwords and users.
# 0 = disabled, 1 = enabled
source_code_scan_enabled={{ source_code_scan_enabled | default(true) }}

# Enable detection and analysis of PAC files.
# 0 = disabled, 1 = enabled
pac_scan_enabled={{ pac_scan_enabled | default(true) }}

# Enable detection of external links and frames.
# 0 = disabled, 1 = enabled
external_links_enabled={{ external_links_enabled | default(true) }}

# Enable load balancer testing.
# 0 = disabled, 1 = enabled
lb_test_enabled={{ lb_test_enabled | default(true) }}

# Enable IP and hosting info gathering via FreegeoIP.
# 0 = disabled, 1 = enabled
geoip_enabled={{ geoip_enabled | default(true) }}

# Enable ASN, Network range, and ISP info gathering via RISwhois.
# 0 = disabled, 1 = enabled
riswhois_enabled={{ riswhois_enabled | default(true) }}

# Enable Whois for abuse mail lookup via Spamcop.
# 0 = disabled, 1 = enabled
spamcop_enabled={{ spamcop_enabled | default(true) }}

# Enable hash comparison to diff code.
# 0 = disabled, 1 = enabled
hash_diff_enabled={{ hash_diff_enabled | default(false) }}

# Option to open all results in browser at the end.
# 0 = disabled, 1 = enabled
open_in_browser={{ open_in_browser | default(false) }}