{
  "entries": [
    {
      "target": "cryptdata",
      "dev": "/dev/disk/by-uuid/abcd1234-5678-efgh-9012-ijkl34567890",
      "crypto": "aes-xts-plain64",
      "keyformat": "passphrase",
      "fstype": "ext4",
      "mountpoint": "/srv/encrypted",
      "options": [
        "noatime",
        "nosuid"
      ],
      "allow_auto": true
    },
    {
      "target": "cryptbackup",
      "dev": "/dev/sdc1",
      "keyfile": "/etc/cryptmount/keys/backup.key",
      "keyformat": "rawkey",
      "crypto": "serpent-xts-plain64",
      "fstype": "xfs",
      "mountpoint": "/mnt/backup",
      "allow_auto": false
    }
  ]
}
