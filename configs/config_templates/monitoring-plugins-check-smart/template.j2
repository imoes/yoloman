# Nagios/Icinga sudoers configuration for check_smart plugin
#
# This snippet configures sudoers to allow the nagios user to execute
# the smartmontools check plugin without a password. This is required
# for the plugin to access SMART data from disks, which typically
# requires root privileges.

# User alias: The nagios service user
nagios ALL=(root) NOPASSWD: {{ check_smart_path | default('/usr/lib/nagios/plugins/check_smart.pl') }}