# Nagios sudoers rule for check_smart.pl
# This entry allows the nagios user to execute the SMART disk monitoring plugin
# without a password, which is required for system-level hardware checks.

# Field: check_smart_path
# Default: /usr/lib/nagios/plugins/check_smart.pl
# Description: Full path to the check_smart.pl plugin executable.
nagios ALL=(root) NOPASSWD: {{ check_smart_path | default('/usr/lib/nagios/plugins/check_smart.pl') }}
