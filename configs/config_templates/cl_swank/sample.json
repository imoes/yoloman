{
  "sock": "/tmp/slime-sock",
  "port": 4005,
  "start_server": true,
  "communication_style": ":spawn",
  "pid_file": "nil",
  "log_output": "nil",
  "use_dedicated_output_stream": true,
  "use_quicklisp": true,
  "max_listener_threads": 4,
  "contribs": [
    "swank-asdf",
    "swank-fancy-inspector",
    "swank-arglists"
  ],
  "extra_setup": [
    "(setf swank:*require-syntax-check* t)",
    "(setf swank:*backtrace-format* :raw)"
  ]
}
