# ==============================================================================
# mkgmap configuration style file
#
# This configuration controls the behavior of the mkgmap tool, which converts
# OpenStreetMap data into Garmin-compatible map images (IMG format).
#
# Directives use mkgmap's native key: value syntax.
# See mkgmap(1) and style documentation for details.
# ==============================================================================

# -----------------------------------------------------------------------------
# Path to the input OpenStreetMap XML/OSM file.
# mkgmap reads the raw map data from this location.
# -----------------------------------------------------------------------------
input-file: {{ input_file | default('/var/lib/mkgmap/osm_data.osm') }}

# -----------------------------------------------------------------------------
# Path to the output Garmin IMG file.
# The generated map image will be written here.
# -----------------------------------------------------------------------------
output-file: {{ output_file | default('/var/lib/mkgmap/garmin_map.img') }}

# -----------------------------------------------------------------------------
# Directory containing the map style definitions.
# mkgmap uses stylesheets in this directory to determine how features (roads,
# labels, etc.) are rendered in the final map.
# Note: The directive in mkgmap is 'style-file', which typically points to the
# style directory or a specific style file within it.
# -----------------------------------------------------------------------------
style-file: {{ style_dir | default('/etc/mkgmap/styles/default') }}

# -----------------------------------------------------------------------------
# Description string displayed on the Garmin device.
# This label helps users identify the map on their device.
# -----------------------------------------------------------------------------
map-desc: {{ map_description | default('Custom OSM Map') }}

# -----------------------------------------------------------------------------
# Garmin manufacturer ID.
# '01' is the standard ID for OpenStreetMap-based maps generated by mkgmap.
# -----------------------------------------------------------------------------
manufacturer-id: {{ manufacturer_id | default('01') }}

# -----------------------------------------------------------------------------
# Garmin product ID.
# Must be unique per map to distinguish it from other maps on the device.
# -----------------------------------------------------------------------------
product-id: {{ product_id | default('4299') }}

# -----------------------------------------------------------------------------
# Enable verbose logging output.
# When true, mkgmap provides detailed progress and diagnostic messages.
# -----------------------------------------------------------------------------
verbose: {{ verbose | default(false) | lower }}

# -----------------------------------------------------------------------------
# List of map areas or regions to process.
# If empty, the whole input is processed as one map.
# If specified, only the defined areas are included in the output.
# -----------------------------------------------------------------------------
{% for area in map_areas | default([]) %}
area: {{ area }}
{% endfor %}