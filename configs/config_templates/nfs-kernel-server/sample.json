{
  "exports": [
    {
      "path": "/srv/nfs4/data",
      "clients": [
        {
          "host": "192.168.1.0/24",
          "opts": [
            "ro",
            "sync",
            "no_subtree_check"
          ]
        },
        {
          "host": "nfs-client.local",
          "opts": [
            "rw",
            "sync",
            "no_subtree_check",
            "no_root_squash"
          ]
        }
      ]
    },
    {
      "path": "/srv/nfs4/public",
      "clients": [
        {
          "host": "*",
          "opts": [
            "ro",
            "all_squash",
            "anonuid=65534",
            "anongid=65534",
            "sync",
            "no_subtree_check"
          ]
        }
      ]
    }
  ]
}
