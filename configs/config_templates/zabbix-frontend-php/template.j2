## Zabbix Frontend Configuration
# This template configures the Apache vhost directives and PHP settings for the Zabbix frontend application.

## Directory: Zabbix Document Root
# Defines the main web directory where Zabbix PHP files reside and sets the PHP runtime limits.

<Directory "{{ zabbix_document_root | default('/usr/share/zabbix') }}">
    Options FollowSymLinks
    AllowOverride None
    Require all granted

    ## PHP Settings for Zabbix
    # These directives configure the PHP engine (mod_php) to meet Zabbix operational requirements.
    # max_execution_time: Maximum time in seconds a script is allowed to run.
    {% if zabbix_php_max_execution_time | default('300') != '' %}
    php_value max_execution_time {{ zabbix_php_max_execution_time | default('300') }}
    {% endif %}

    # memory_limit: Maximum amount of memory a script may consume.
    {% if zabbix_php_memory_limit | default('128M') != '' %}
    php_value memory_limit {{ zabbix_php_memory_limit | default('128M') }}
    {% endif %}

    # post_max_size: Maximum size of POST data allowed.
    {% if zabbix_php_post_max_size | default('16M') != '' %}
    php_value post_max_size {{ zabbix_php_post_max_size | default('16M') }}
    {% endif %}

    # upload_max_filesize: Maximum size of uploaded files.
    {% if zabbix_php_upload_max_filesize | default('2M') != '' %}
    php_value upload_max_filesize {{ zabbix_php_upload_max_filesize | default('2M') }}
    {% endif %}

    # max_input_time: Maximum time in seconds to parse input data.
    {% if zabbix_php_max_input_time | default('300') != '' %}
    php_value max_input_time {{ zabbix_php_max_input_time | default('300') }}
    {% endif %}
</Directory>

## Alias Configuration
# Maps a URL path to the file system location of the Zabbix frontend.

<IfModule mod_alias.c>
    Alias /zabbix {{ zabbix_alias_path | default('/usr/share/zabbix') }}
</IfModule>

## Security: Restrict Access to Sensitive Directories
# Denies direct web access to configuration, application core, and include files to prevent information leakage.

<Directory ~ "^{{ zabbix_document_root | default('/usr/share/zabbix') }}/(conf|app|include|local)/">
    Require all denied
</Directory>

## Security: Deny PHP Execution in Sensitive Files
# Ensures that if any .php files exist in the restricted directories above, they are not executed.

<filesMatch "\.php$">
    Require all denied
</filesMatch>
