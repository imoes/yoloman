{
  "zabbix_alias_path": {
    "type": "string",
    "default": "/usr/share/zabbix",
    "description": "The URL path alias for the Zabbix frontend."
  },
  "zabbix_document_root": {
    "type": "string",
    "default": "/usr/share/zabbix",
    "description": "The file system path to the Zabbix frontend files."
  },
  "zabbix_php_max_execution_time": {
    "type": "number",
    "default": 300,
    "description": "PHP max_execution_time for Zabbix operations."
  },
  "zabbix_php_memory_limit": {
    "type": "string",
    "default": "128M",
    "description": "PHP memory_limit for Zabbix operations."
  },
  "zabbix_php_post_max_size": {
    "type": "string",
    "default": "16M",
    "description": "PHP post_max_size for Zabbix operations."
  },
  "zabbix_php_upload_max_filesize": {
    "type": "string",
    "default": "2M",
    "description": "PHP upload_max_filesize for Zabbix operations."
  },
  "zabbix_php_max_input_time": {
    "type": "number",
    "default": 300,
    "description": "PHP max_input_time for Zabbix operations."
  }
}
