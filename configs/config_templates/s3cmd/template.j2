[default]
# AWS Access Key ID. See --access_key.
access_key = {{ access_key | default('') }}

# AWS Secret Access Key. See --secret_key.
secret_key = {{ secret_key | default('') }}

# Hostname for S3 API requests. See --host.
host_base = {{ host_base | default('s3.amazonaws.com') }}

# DNS-style bucket+hostname:port template for accessing a bucket. See --host-bucket.
host_bucket = {{ host_bucket | default('%(bucket)s.s3.amazonaws.com') }}

# Region to create bucket in. See --region.
default_region = {{ default_region | default('us-east-1') }}

# Use HTTPS connection when communicating with S3. See --ssl.
use_https = {{ use_https | default(True) | ternary('True', 'False') }}

# Encrypt files before uploading to S3. See --encrypt.
enable_encryption = {{ enable_encryption | default(False) | ternary('True', 'False') }}

# Specifies that server-side encryption will be used when putting objects. See --server-side-encryption.
enable_server_side_encryption = {{ enable_server_side_encryption | default(False) | ternary('True', 'False') }}

# Store object with specified CLASS (STANDARD, STANDARD_IA, ONEZONE_IA, INTELLIGENT_TIERING, GLACIER or DEEP_ARCHIVE). See --storage-class.
storage_class = {{ storage_class | default('STANDARD') }}

# Default MIME-type for stored objects. See --default-mime-type.
default_mime_type = {{ default_mime_type | default('application/octet-stream') }}

# Guess MIME-type of files by their extension or mime magic. See --guess-mime-type.
guess_mime_type = {{ guess_mime_type | default(True) | ternary('True', 'False') }}

# Store object with 'Reduced redundancy'. See --reduced-redundancy.
use_rre = {{ use_rre | default(False) | ternary('True', 'False') }}

# Maximum number of times to retry a failed request before giving up. See --max-retries.
max_retries = {{ max_retries | default(5) }}

# Size of each chunk of a multipart upload in Mega-Bytes. See --multipart-chunk-size-mb.
multipart_chunk_size_mb = {{ multipart_chunk_size_mb | default(15) }}

# AWS Access Key ID used for CloudFront operations. If empty, defaults to access_key.
cf_access_key_id = {{ cf_access_key_id | default('') }}

# AWS Secret Access Key used for CloudFront operations. If empty, defaults to secret_key.
cf_secret_access_key = {{ cf_secret_access_key | default('') }}

# Filenames and paths matching GLOB will be excluded from sync. See --exclude. List of strings.
define exclude_patterns
{% for pattern in (exclude_patterns | default([])) %}- {{ pattern }}
{% endfor %}
enddefine

# Filenames and paths matching GLOB will be included even if previously excluded. See --include. List of strings.
define include_patterns
{% for pattern in (include_patterns | default([])) %}- {{ pattern }}
{% endfor %}
enddefine

# Path to client own SSL certificate CRT_FILE. See --ssl-cert.
ssl_client_cert_file = {{ ssl_client_cert_file | default('') }}

# Path to client own SSL certificate private key KEY_FILE. See --ssl-key.
ssl_client_key_file = {{ ssl_client_key_file | default('') }}

# Path to SSL CA certificate FILE. See --ca-certs.
ca_certs_file = {{ ca_certs_file | default('') }}