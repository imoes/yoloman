# iptraf-ng logrotate configuration
#
# Controls how log files generated by iptraf-ng are rotated, compressed,
# and their permissions/ownership are set.

/var/log/iptraf/*.log {
    # Rotate daily/weekly/monthly? (Default: daily if not specified, but here we use defaults)
    # The following directives are standard for iptraf log rotation:

    # Compress old log files to save disk space
    compress

    # Delay compression of the most recent rotated log to allow processes to finish writing
    delaycompress

    # Do not error if the log file is missing
    missingok

    # Do not rotate if the log file is empty
    notifempty

    # Number of rotated log files to keep.
    # Default: 4
    # Specifies how many old log files to retain before deleting the oldest.
    rotate {{ rotate_count | default(4) }}

    # Permissions for newly created log files.
    # Default: '0600'
    # Specifies the octal permissions mode for new log files.
    create {{ file_permissions | default('0600') }}

    # Owner of newly created log files.
    # Default: 'root'
    # Specifies the user owner for new log files.
    {{ log_owner | default('root') }}

    # Group of newly created log files.
    # Default: 'root'
    # Specifies the group owner for new log files.
    {{ log_group | default('root') }}
}