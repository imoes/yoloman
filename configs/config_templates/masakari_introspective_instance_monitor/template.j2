# Masakari Introspective Instance Monitor configuration
# This service monitors instance health via introspective (agent-based) methods.
# Generated by Ansible Jinja2 - Self-documenting

[DEFAULT]
# Enable verbose debug logging for troubleshooting.
debug = {{ debug | default(False) | ternary('true', 'false') }}

# Directory path where log files are stored.
log_dir = {{ log_dir | default('/var/log/masakari') }}

# Optional specific log file name (if null, uses default logging behavior).
{% if log_file is defined and log_file is not none %}
log_file = {{ log_file }}
{% endif %}

# Format string for log messages (uses Python logging format syntax).
log_format = {{ log_format | default('%(asctime)s %(levelname)s %(name)s %(message)s') }}

# Hostname of the introspective monitor instance (must match nova compute host name).
host = {{ host | default('localhost') }}

# Path to the introspective agent binary (must be executable).
introspective_agent_path = {{ introspective_agent_path | default('/usr/local/bin/masakari-introspective-agent') }}

# Interval (in seconds) between health checks for monitored instances.
health_check_interval = {{ health_check_interval | default(10) }}

# Time (in seconds) without successful health checks before marking the host unhealthy.
host_unhealthy_timeout = {{ host_unhealthy_timeout | default(30) }}

# Number of consecutive health check failures before declaring the host unhealthy.
max_failures_before_unhealthy = {{ max_failures_before_unhealthy | default(3) }}

# Base URI of the Masakari API endpoint.
masakari_api_uri = {{ masakari_api_uri | default('http://localhost:15868') }}

# Authentication strategy for Masakari API (supported: 'keystone', 'noauth').
masakari_auth_strategy = {{ masakari_auth_strategy | default('keystone') }}

# Keystone authentication URL for Masakari API.
{% if keystone_auth_url is defined and keystone_auth_url is not none %}
keystone_auth_url = {{ keystone_auth_url }}
{% endif %}

# Project (tenant) name used for Masakari API authentication.
{% if project_name is defined and project_name is not none %}
project_name = {{ project_name }}
{% endif %}

# Username used for Masakari API authentication.
{% if username is defined and username is not none %}
username = {{ username }}
{% endif %}

# Password used for Masakari API authentication.
{% if password is defined and password is not none %}
password = {{ password }}
{% endif %}

# Region name used for Masakari service endpoint lookup (if omitted, uses default region).
{% if region_name is defined and region_name is not none %}
region_name = {{ region_name }}
{% endif %}

# Whether to verify SSL certificates when connecting to Masakari API.
verify_ssl = {{ verify_ssl | default(False) | ternary('true', 'false') }}

# List of OpenStack instance (VM) UUIDs to monitor (if empty, monitors all instances on this host).
{% if monitored_instance_ids is defined and monitored_instance_ids | length > 0 %}
monitored_instance_ids = {{ monitored_instance_ids | join(', ') }}
{% else %}
monitored_instance_ids =
{% endif %}

# Optional config file path to override introspective agent settings.
{% if introspective_agent_config is defined and introspective_agent_config is not none %}
introspective_agent_config = {{ introspective_agent_config }}
{% endif %}

# Directory where introspective agent logs are stored.
{% if introspective_agent_log_dir is defined and introspective_agent_log_dir is not none %}
introspective_agent_log_dir = {{ introspective_agent_log_dir }}
{% else %}
introspective_agent_log_dir = /var/log/masakari/agent
{% endif %}

# Maximum attempts to invoke introspective agent before treating as failure.
{% if agent_retry_count is defined and agent_retry_count is not none %}
agent_retry_count = {{ agent_retry_count }}
{% else %}
agent_retry_count = 3
{% endif %}

# Seconds to wait between introspective agent retries.
{% if agent_retry_delay is defined and agent_retry_delay is not none %}
agent_retry_delay = {{ agent_retry_delay }}
{% else %}
agent_retry_delay = 2
{% endif %}

[notifications]
# Enable sending Masakari notifications on host/instance failure.
{% if notifications_enabled is defined %}
enabled = {{ notifications_enabled | ternary('true', 'false') }}
{% else %}
enabled = true
{% endif %}

# Message broker transport URL for notifications (e.g., RabbitMQ, Redis, or ZMQ).
{% if transport_url is defined and transport_url is not none %}
transport_url = {{ transport_url }}
{% else %}
transport_url = rabbit://guest:guest@localhost:5672//
{% endif %}

# List of notification topics to publish events to (e.g., 'masakari', 'masakari-process').
{% if notification_topics is defined and notification_topics | length > 0 %}
topics = {{ notification_topics | join(', ') }}
{% else %}
topics = masakari
{% endif %}

# Format for Masakari notifications ('default' or 'notification_event_api').
{% if notification_format is defined and notification_format is not none %}
notification_format = {{ notification_format }}
{% else %}
notification_format = notification_event_api
{% endif %}

# Maximum attempts to send notifications before discarding.
{% if notification_retry_count is defined and notification_retry_count is not none %}
notification_retry_count = {{ notification_retry_count }}
{% else %}
notification_retry_count = 3
{% endif %}

# Seconds to wait between notification delivery retries.
{% if notification_retry_delay is defined and notification_retry_delay is not none %}
notification_retry_delay = {{ notification_retry_delay }}
{% else %}
notification_retry_delay = 2
{% endif %}