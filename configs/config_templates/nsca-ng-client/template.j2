#
# Sample configuration for send_nsca(8).  See the send_nsca.cfg(5) man page.
# PLEASE SET THE PERMISSIONS OF THIS FILE APPROPRIATELY TO MAKE SURE THAT ONLY
# AUTHORIZED USERS CAN ACCESS IT!
#

# Identity string for the client. Defaults to hostname if not set.
identity = "{{ identity | default('web-checker') }}"

# Password used for encryption/authentication.
password = "{{ password | default('8a5UMsMzZhu6sSPkSmSaqC3HjMGCLwdt') }}"

# Hostname or IP address of the NSCA server.
server = "{{ server | default('monitoring.example.com') }}"

# TLS cipher suites allowed for the connection.
tls_ciphers = "{{ tls_ciphers | default('PSK-AES256-CBC-SHA') }}"

# Delay in seconds before sending data.
delay = {{ delay | default(2) }}

# Port number of the NSCA server.
port = {{ port | default(5668) }}

# Timeout in seconds for the connection attempt.
timeout = {{ timeout | default(10) }}