{
    # Network interface to bind Serf events to.
    "interface": "{{ (interface | default('eth0')) | string }}",

    # Profile to use for event broadcast (e.g., wan, lan).
    "profile": "{{ (profile | default('wan')) | string }}",

    # Logging verbosity level.
    "log_level": "{{ (log_level | default('warn')) | string }}",

    # JSON object containing tags for this node.
    "tags": {{ (tags | default({})) | tojson }}
}
