# Enables the Hyper-V key value pair (KVP) daemon
KVP_ENABLED={{ kvp_enabled }}

# Enables the Hyper-V shutdown daemon
SHUTDOWN_ENABLED={{ shutdown_enabled }}

# Enables the Hyper-V time synchronization daemon
TIME_SYNC_ENABLED={{ time_sync_enabled }}

# Enables the Hyper-V heartbeat daemon
HEARTBEAT_ENABLED={{ heartbeat_enabled }}

# Enables the Hyper-V file copy daemon
FCOPY_ENABLED={{ fcopy_enabled }}

# Path to the KVP daemon binary (leave blank to use default)
KVP_BIN={{ kvp_bin | default('') }}

# Path to the shutdown daemon binary (leave blank to use default)
SHUTDOWN_BIN={{ shutdown_bin | default('') }}

# Path to the time sync daemon binary (leave blank to use default)
TIME_SYNC_BIN={{ time_sync_bin | default('') }}

# Path to the heartbeat daemon binary (leave blank to use default)
HEARTBEAT_BIN={{ heartbeat_bin | default('') }}

# Path to the file copy daemon binary (leave blank to use default)
FCOPY_BIN={{ fcopy_bin | default('') }}

# Extra arguments passed to KVP daemon
{% if kvp_extra_args %}
KVP_OPTS="{{ kvp_extra_args | join(' ') }}"
{% endif %}

# Extra arguments passed to shutdown daemon
{% if shutdown_extra_args %}
SHUTDOWN_OPTS="{{ shutdown_extra_args | join(' ') }}"
{% endif %}

# Extra arguments passed to time sync daemon
{% if time_sync_extra_args %}
TIME_SYNC_OPTS="{{ time_sync_extra_args | join(' ') }}"
{% endif %}

# Extra arguments passed to heartbeat daemon
{% if heartbeat_extra_args %}
HEARTBEAT_OPTS="{{ heartbeat_extra_args | join(' ') }}"
{% endif %}

# Extra arguments passed to file copy daemon
{% if fcopy_extra_args %}
FCOPY_OPTS="{{ fcopy_extra_args | join(' ') }}"
{% endif %}

# Log level (0=quiet, 1=errors, 2=info, 3=debug)
{% if log_level is defined %}
LOG_LEVEL={{ log_level }}
{% endif %}

# Custom environment variables (space-separated KEY=value pairs)
{% if env_vars %}
{% for pair in env_vars %}
{{ pair }}
{% endfor %}
{% endif %}
