{
  "host": "ecflow.met-office.gov.uk",
  "port": 31414,
  "auth_mode": "password",
  "data_dir": "/var/lib/ecflow-server/data",
  "log_dir": "/var/log/ecflow-server",
  "max_clients": 150,
  "shutdown_timeout": 45,
  "recovery": true,
  "ssl_enabled": true,
  "ssl_cert": "/etc/ssl/certs/ecflow.met-office.gov.uk.crt",
  "ssl_key": "/etc/ssl/private/ecflow.met-office.gov.uk.key",
  "pidfile": "/run/ecflow-server/ecflow-server.pid",
  "allowed_clients": [
    "10.0.0.0/8",
    "ecflow-client.internal",
    "workstation.met-office.gov.uk"
  ],
  "auto_load_suites": [
    "ops/hourly_weather.suite",
    "ops/daily_forecast.suite",
    "research/climatology.suite"
  ],
  "smtp_enabled": true,
  "smtp_host": "smtp.met-office.gov.uk",
  "smtp_port": 587,
  "smtp_user": "ecflow-notifier",
  "smtp_pass": "",
  "smtp_from": "ecflow-ops@met-office.gov.uk",
  "smtp_tls": true,
  "max_open_files": 65536,
  "max_proc": 0
}
