# Relax-and-Recover (ReaR) configuration file.
# This file is sourced by the 'rear' command at runtime.
# Variables must be in bash format: VARIABLE="value"
# For automated role usage, prefer site.conf or passing variables via the environment,
# but this template provides sensible defaults based on the schema.

# OUTPUT: The method used to create the rescue medium.
# Options include 'ISO' (create an ISO image file), 'NETISO' (network ISO),
# 'NETTAR' (network tarball), 'USB' (USB stick), etc.
# Default is 'ISO' which creates a bootable ISO image in the output directory.
OUTPUT="{{ OUTPUT | default('ISO') }}"

# BACKUP: The method used for backing up and restoring data.
# Options include 'NETFS' (network filesystem like NFS/SMB), 'BACKUP_PROG'
# (a specific backup program), or 'REQUESTRESTORE' (interactive prompt).
# Note: 'REQUESTRESTORE' is the default but requires manual intervention during restore
# as it does not automatically perform a backup action. For automated backups,
# set this to 'NETFS' or another configured backup provider.
BACKUP="{{ BACKUP | default('REQUESTRESTORE') }}"
