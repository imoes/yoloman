# /etc/default/rfkill
# Configuration file for rfkill defaults.
# Note: rfkill is primarily a command-line tool. This template represents
# a standard configuration location where persistent default behaviors or
# pre-commands might be stored by an admin or wrapper script, as rfkill
# itself does not read a single global config file for operation.

# Comma-separated list of columns for the default output. Corresponds to rfkill --output.
# Available columns include: ID, TYPE, SOFT, HARD, NAME.
DEFAULT_OUTPUT_COLUMNS="{{ (default_output_columns | default(['ID', 'TYPE', 'NAME']))|join(',') }}"

# List of rfkill types to block by default. Corresponds to rfkill block <type>.
# Types: all, wlan/wifi, bluetooth, uwb/ultrawideband, wimax, wwan, gps, fm, nfc.
DEFAULT_BLOCK_TYPES="{{ (default_block_types | default(['bluetooth', 'nfc']))|join(' ') }}"

# If true, enables JSON output format by default. Corresponds to rfkill -J.
OUTPUT_JSON="{{ (output_json | default(False))|lower }}"

# If true, hides the header line in output. Corresponds to rfkill -n.
NO_HEADINGS="{{ (no_headings | default(False))|lower }}"