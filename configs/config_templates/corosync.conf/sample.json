{
  "cluster_name": "mycluster",
  "transport": "udpu",
  "nodes": [
    {
      "ring0_addr": "10.0.0.10",
      "nodeid": 1
    },
    {
      "ring0_addr": "10.0.0.11",
      "nodeid": 2
    }
  ],
  "totem": {
    "token": 10000,
    "token_retransmits_before_loss_const": 20,
    "join": 50,
    "consensus": 120,
    "ipv6": false,
    "version": 2,
    "max_messages": 20,
    "rrp_mode": "disabled"
  },
  "interface": {
    "ringnumber": 0,
    "bindnetaddr": "10.0.0.0",
    "mcastaddr": null,
    "mcastport": 5405,
    "ttl": 1,
    "linktype": "eth"
  },
  "logging": {
    "to_logfile": true,
    "logfile": "/var/log/cluster/corosync.log",
    "log_level": "warning",
    "log_timestamp": "standard",
    "to_syslog": false,
    "syslog_facility": "daemon"
  },
  "quorum_device": {
    "provider": "net",
    "expected_votes": 1,
    "two_node": true
  },
  "service": {
    "name": "pacemaker",
    "ver": 1
  },
  "enable_pacemaker": true,
  "aisexec": {
    "user": "hacluster",
    "group": "hacluster"
  }
}
