{# ============================================================================ #}
{# getstream Configuration Template                                             #}
{# ============================================================================ #}
{# This template generates the command-line invocation for the getstream utility. #}
{# getstream is a Debian DVB streaming tool.                                     #}
{#                                                                              #}
{# Variables:                                                                   #}
{#   config_file (string): Path to the mandatory configuration file.             #}
{#   debug        (bool):  Enable debug mode (sets DEBUG=1).                     #}
{# ============================================================================ #}

# getstream configuration
# Specifies the mandatory path to the configuration file used by getstream.
# This argument is required by the -c option.
# Default: /etc/getstream.conf
getstream -c {{ config_file | default('/etc/getstream.conf') }}

{% if debug | default(False) | bool %}
# Debug mode is enabled.
# This sets the DEBUG=1 environment variable for the process.
DEBUG=1
{% endif %}