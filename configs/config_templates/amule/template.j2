# aMule configuration file
# This file is auto-generated and must be placed in ~/.aMule/amule.conf
# See amule(1) for usage: https://manpages.debian.org/trixie/amule/amule.1.en.html

[General]
# Path to the aMule configuration directory (overriding default ~/.aMule)
# Parameter: --config-dir=<path>
ConfigDir={{ config_dir | default('~/.aMule') }}

# If true, log messages are printed to stdout instead of files
# Parameter: --log-stdout
LogToStdOut={{ log_to_stdout | default(false) | lower }}

# If true, fatal exceptions are not handled (useful for debugging)
# Parameter: --disable-fatal
DisableFatal={{ disable_fatal | default(false) | lower }}

# If true, stdin is enabled, allowing interaction via amulecmd
# Parameter: --enable-stdin
EnableStdIn={{ enable_stdin | default(true) | lower }}

[Webserver]
# Absolute path to the amuleweb binary. If empty, the default is used.
# Parameter: --use-amuleweb=<path>
WebServerPath={{ amuleweb_path | default('') }}