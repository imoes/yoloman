# MooseFS Metalogger configuration
# This file is generated from template. Do not edit directly.

# Data directory for metadata storage and logging
DATA_PATH={{ data_dir }}

# Metadata log storage path
LOG_PATH={{ log_dir }}

# Hostname or IP address of the master server
MASTER_HOST={{ master_host }}

# Port number for master server connection
MASTER_PORT={{ master_port }}

# Port number for this metalogger to listen on
LISTEN_PORT={{ listen_port }}

# Number of metalogger workers
WORKERS={{ workers }}

# Timeout (in seconds) for connection to master
MASTER_TIMEOUT={{ master_timeout }}

# Timeout (in seconds) for reconnect attempts to master
RECONNECT_TIMEOUT={{ reconnect_timeout }}

# Enable/Disable persistence of metadata logs to disk
PERSISTENCE={{ persistence }}

# List of additional hosts to replicate metadata to (format: host:port)
{% for replica in replicas %}METALOG_REPLICA={{ replica.host }}:{{ replica.port }}
{% endfor %}

# Optional: comma-separated list of allowed master hostnames (empty = allow any)
ALLOWED_HOSTS={{ allowed_hosts }}

# Optional: password for authentication with master (empty = no auth)
MASTER_PASSWORD={{ master_password }}

# Optional: enable/ disable debug mode
DEBUG={{ debug }}