# Ruptime configuration file
# Defines the remote server host and port for uptime reporting.
# The 'rwho' service uses the ruptime protocol to query/advertise system uptime.

# server_host: default='localhost'
# desc='The hostname or IP address of the ruptime server to report to.'
# The host of the remote ruptime server.
server_host: {{ server_host | default('localhost') }}

# server_port: default=4242
# desc='The port number of the ruptime server.'
# The port of the remote ruptime server.
server_port: {{ server_port | default(4242) }}

# hostname: default=''
# desc="The FQDN hostname to report. If empty, the system's local hostname is typically used."
# The FQDN to report to the ruptime server.
hostname: {{ hostname | default('') }}

# key: default='changeme'
# desc='The symmetric key for encrypting/decrypting ruptime data.'
# Symmetric key used for content encryption/decryption.
key: {{ key | default('changeme') }}