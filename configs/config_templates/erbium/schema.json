{
  "verbose_logging": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose logging for debugging."
  },
  "dhcp.enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable DHCP service."
  },
  "dhcp.interfaces": {
    "type": "list",
    "default": [
      "eth0"
    ],
    "description": "DHCP interface(s) to serve on."
  },
  "dhcp.subnet": {
    "type": "string",
    "default": "192.168.1.0/24",
    "description": "DHCP subnet to announce (CIDR notation)."
  },
  "dhcp.gateway": {
    "type": "string",
    "default": "192.168.1.1",
    "description": "DHCP gateway to announce."
  },
  "dhcp.dns_servers": {
    "type": "list",
    "default": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "description": "DHCP DNS servers to announce."
  },
  "dhcp.range": {
    "type": "list",
    "default": [
      {
        "start": "192.168.1.100",
        "end": "192.168.1.200"
      }
    ],
    "description": "DHCP range for dynamic allocation (start-end). Items: {start: string (IP), end: string (IP)}."
  },
  "dhcp.lease_time": {
    "type": "number",
    "default": 86400,
    "description": "DHCP lease time (seconds)."
  },
  "dns.enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable DNS service (limited support)."
  },
  "dns.upstreams": {
    "type": "list",
    "default": [
      "9.9.9.9",
      "149.112.112.112"
    ],
    "description": "DNS upstream resolver(s) (IP or domain)."
  },
  "dns.listen_address": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "DNS listening address (IPv4 or IPv6)."
  },
  "dns.listen_port": {
    "type": "number",
    "default": 53,
    "description": "DNS listening port."
  },
  "dns.cache_enabled": {
    "type": "bool",
    "default": true,
    "description": "DNS caching."
  },
  "dhcp.range.start": {
    "type": "string",
    "default": "192.168.1.100",
    "description": "Start of DHCP dynamic range (IP address)."
  },
  "dhcp.range.end": {
    "type": "string",
    "default": "192.168.1.200",
    "description": "End of DHCP dynamic range (IP address)."
  }
}
