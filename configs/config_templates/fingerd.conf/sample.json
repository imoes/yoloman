{
  "listen_address": "0.0.0.0",
  "listen_port": 79,
  "userinfo_enabled": true,
  "hostname_enabled": false,
  "syslog_enabled": true,
  "max_connections": 200,
  "welcome_file": "/etc/finger.welcome",
  "banner_file": "/etc/finger.banner",
  "search_dirs": [
    "/etc",
    "/var/run",
    "/home"
  ],
  "allowed_hosts": [
    "127.0.0.1",
    "10.0.0.0/8"
  ],
  "denied_hosts": [
    "192.168.0.0/16"
  ],
  "longformat_enabled": true,
  "timeout_seconds": 300
}
