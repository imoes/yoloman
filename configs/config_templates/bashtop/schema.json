{
  "update_pos": {
    "type": "number",
    "default": 2,
    "description": "Update interval in seconds."
  },
  "color_theme": {
    "type": "number",
    "default": 0,
    "description": "Color theme (0-7: default, light, dark, red, green, blue, yellow, cyan, magenta)."
  },
  "update_procs": {
    "type": "bool",
    "default": true,
    "description": "Update process list on draw."
  },
  "show_bytes": {
    "type": "bool",
    "default": false,
    "description": "Show memory as bytes."
  },
  "show_bits": {
    "type": "bool",
    "default": false,
    "description": "Show network in bits per second."
  },
  "show_cpu_threads": {
    "type": "bool",
    "default": false,
    "description": "Show process CPU% as sum of thread CPU%."
  },
  "show_process_tree": {
    "type": "bool",
    "default": false,
    "description": "Show detailed process info."
  },
  "show_process_args": {
    "type": "bool",
    "default": false,
    "description": "Show process arguments."
  },
  "sort_type": {
    "type": "number",
    "default": 0,
    "description": "Sort processes by column (0: cpu, 1: mem, 2: time, 3: pid, 4: name, 5: user, 6: status, 7: mem%)."
  },
  "sort_reverse": {
    "type": "bool",
    "default": false,
    "description": "Sort order (0: descending, 1: ascending)."
  },
  "show_user_procs": {
    "type": "bool",
    "default": false,
    "description": "Show only user processes."
  },
  "auto_scale_net": {
    "type": "bool",
    "default": true,
    "description": "Auto-scale network graph."
  },
  "net_in_one_line": {
    "type": "bool",
    "default": false,
    "description": "Show graph for network in/out separately."
  },
  "disk_io_separate": {
    "type": "bool",
    "default": true,
    "description": "Show graph for disk read/write separately."
  },
  "cpu_temp": {
    "type": "bool",
    "default": false,
    "description": "Show graph for CPU temperature."
  },
  "physical_cores_only": {
    "type": "bool",
    "default": false,
    "description": "Show only physical cores."
  },
  "cpu_freq": {
    "type": "bool",
    "default": false,
    "description": "Show CPU frequency."
  },
  "long_uptime": {
    "type": "bool",
    "default": false,
    "description": "Show uptime in days/hours/minutes/seconds."
  },
  "disk_io_update_rate": {
    "type": "number",
    "default": 5,
    "description": "Update disk I/O stats every N updates."
  },
  "net_io_update_rate": {
    "type": "number",
    "default": 5,
    "description": "Update network stats every N updates."
  },
  "mouse_support": {
    "type": "bool",
    "default": false,
    "description": "Enable mouse support."
  },
  "only_running_procs": {
    "type": "bool",
    "default": true,
    "description": "Show only running processes."
  },
  "tree_depth_limit": {
    "type": "number",
    "default": 3,
    "description": "Show process tree depth limit."
  },
  "tree_indent": {
    "type": "number",
    "default": 2,
    "description": "Show process tree indentation spaces."
  },
  "process_filter": {
    "type": "string",
    "default": "",
    "description": "Custom process filter string."
  },
  "process_cmd_filter": {
    "type": "string",
    "default": "",
    "description": "Custom process command filter string."
  },
  "highlight_procs": {
    "type": "list",
    "default": [],
    "description": "List of user-defined processes to highlight."
  },
  "exclude_procs": {
    "type": "list",
    "default": [],
    "description": "List of user-defined processes to exclude."
  }
}
