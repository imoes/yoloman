{
  "gosa_base_url": "https://admin.example.com/gosa/",
  "ldap_uri": "ldaps://ldap.example.com:636",
  "ldap_basedn": "dc=example,dc=com",
  "ldap_binddn": "cn=admin,dc=example,dc=com",
  "ldap_bindpw": "REPLACE_WITH_SECURE_PASSWORD",
  "ldap_use_tls": false,
  "ldap_tls_check_peer": true,
  "ldap_tls_cacertfile": "/etc/ssl/certs/ca-certificates.crt",
  "session_timeout": 7200,
  "default_lang": "en",
  "debug": false,
  "posix_support": true,
  "samba_support": false,
  "ssh_support": true,
  "auth_method": "ldap",
  "admin_group_dn": "cn=gosa-admins,ou=groups,dc=example,dc=com",
  "user_attribute": "uid",
  "user_display_attribute": "cn",
  "log_level": "INFO",
  "log_file": "/var/log/gosa/gosa.log",
  "log_syslog": false,
  "plugins": [
    "account",
    "dns",
    "group",
    "host",
    "network",
    "sudo",
    "user"
  ],
  "plugins_config": [
    {
      "name": "account",
      "description": "User and group account management",
      "options": {
        "home_base": "/home",
        "shell": "/bin/bash",
        "skel": "/etc/skel"
      }
    },
    {
      "name": "dns",
      "description": "DNS zone and record management",
      "options": {
        "default_ttl": "86400",
        "default_refresh": "28800",
        "default_retry": "7200",
        "default_expire": "604800",
        "default_minimum": "86400"
      }
    },
    {
      "name": "sudo",
      "description": "Sudo command scheduling (requires sudoers_enabled=true)",
      "options": {
        "sudoer_default_order": "0"
      }
    }
  ],
  "sudoers_enabled": false,
  "sudoers_basedn": "ou=Sudoers,dc=example,dc=com",
  "sudoers_role_dn": "cn=defaults,ou=Sudoers,dc=example,dc=com",
  "sudoers_host_attr": "sudoHost"
}
