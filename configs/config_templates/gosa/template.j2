# ==============================================================================
# GOsa+ Class ServNfs Encoding Configuration
# ==============================================================================
# This file defines character encoding mappings for the GOsa+ web interface.
# It is used by the 'servNfs' class plugin to handle locale-specific naming
# for NFS-related attributes or help texts.
#
# Format: <encoding_name>=<human_readable_name>
# Location: /etc/gosa/ (or within the GOsa+ schema directory)
# ==============================================================================

# UTF-8 is the standard Unicode encoding, recommended for modern systems.
UTF-8=UTF-8

# ISO-8859-1 covers Western European languages.
ISO8859-1=ISO8859-1 (Latin 1)

# ISO-8859-2 covers Central and Eastern European languages (e.g., Polish, Hungarian).
ISO8859-2=ISO8859-2 (Latin 2)

# ISO-8859-3 is used for Maltese and Esperanto.
ISO8859-3=ISO8859-3 (Latin 3)

# ISO-8859-4 covers Nordic languages (e.g., Estonian, Latvian, Lithuanian).
ISO8859-4=ISO8859-4 (Latin 4)

# ISO-8859-5 covers Cyrillic scripts (e.g., Russian, Bulgarian).
ISO8859-5=ISO8859-5 (Latin 5)

# CP850 is an MS-DOS code page for Western European characters.
cp850=CP850 (Europe)