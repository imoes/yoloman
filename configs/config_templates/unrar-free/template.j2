# Unrar-free configuration template
# This file configures the default behavior for unrar-free extraction operations.

# Path to the unrar-free executable.
UNRAR_FREE_BIN = {{ binary_path | default('/usr/bin/unrar-free') }}

# The default operation: 'extract' (-x), 'list' (-t), or 'print' (-p).
DEFAULT_ACTION = {{ default_action | default('extract') }}

# The target directory for extraction or output.
DESTINATION_DIR = {{ destination_dir | default('.') }}

# Password to decrypt RAR archives. If empty, no password is used.
PASSWORD = {{ password | default('') }}

# Specific files within the archive to process. If empty, all files are handled based on the action.
FILES_TO_PROCESS = {{ files_to_process | default([]) }}

# If true, overwrite existing files when extracting (--force).
FORCE_OVERWRITE = {{ force_overwrite | default(False) | lower }}

# If true, only extract files that are newer than existing ones (--extract-newer).
EXTRACT_NEWER = {{ extract_newer | default(False) | lower }}

# If true, do not create directories while extracting (--extract-no-paths).
EXTRACT_NO_PATHS = {{ extract_no_paths | default(False) | lower }}

# Destination for messages: 'stdout', 'stderr', or 'nul' (-i).
OUTPUT_FILE = {{ output_file | default('stdout') }}

# If true, list files verbosely (-v equivalent).
VERBOSE = {{ verbose | default(False) | lower }}

# If true, assume yes on queries (-y). Note: ineffective in unrar-free.
ASSUME_YES = {{ assume_yes | default(False) | lower }}