# ipband init.d configuration template
#
# This file configures the /etc/init.d/ipband service wrapper.
# It defines how ipband is launched and which configuration files it should load.

# Flags to be passed to ipband(8) during startup via /etc/init.d/ipband.
# See 'man ipband' for information on what flags are available.
# Keep in mind that process forking is handled by /etc/init.d/ipband.
FLAGS="{{ flags | default('-A') }}"

# Specify your configuration files here.
# You can specify one, two, or more.
# When specifying more than one, separate them by spaces.
# One instance of ipband will be launched for each configuration file listed here.
CONFIG_FILES="{{ config_files | default('/etc/ipband.conf') }}"