{
  "enabled": true,
  "logfile": "/var/log/ipband/ipband.log",
  "loglevel": "warn",
  "snapshot_interval": 30,
  "retained_snapshots": 2880,
  "interfaces": [
    "eth0",
    "eth1"
  ],
  "monitored_subnets": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "excluded_subnets": [
    "192.168.1.0/24"
  ],
  "email_enabled": true,
  "report_recipients": [
    "ops@example.com",
    "netops@example.com"
  ],
  "report_sender": "ipband@monitoring.example.com",
  "smtp_host": "smtp.example.com",
  "smtp_port": 587,
  "smtp_starttls": true,
  "smtp_auth": true,
  "smtp_username": "ipband-alerts",
  "smtp_password": "s3cur3-p@ssw0rd",
  "report_frequency": "weekly",
  "include_interface_breakdown": true,
  "bandwidth_alert_threshold": 200,
  "bandwidth_alert_duration": 180,
  "alert_recipients": [
    "urgent@example.com"
  ],
  "alert_throttle": true,
  "alert_throttle_interval": 1800
}
