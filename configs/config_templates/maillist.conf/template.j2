{# mlmmj maillist.conf: main configuration for a mailing list #}
ADMIN={{ admin_email }}
LISTNAME={{ list_name }}
DOMAIN={{ domain }}
MAILLIST_DIR={{ list_dir }}

# Access control and moderation
ACCESS={{ access_type }}
MODERATE={{ moderate | lower }}

# Subscription and unsubscription
SUBSCRIBE={{ subscribe_enabled | lower }}
UNSUBSCRIBE={{ unsubscribe_enabled | lower }}
SUBSCRIBE_REQUIRED_CONFIRM={{ require_subscription_confirm | lower }}

# Message handling
ALLOW_ANONYMOUS_POST={{ allow_anonymous_post | lower }}
MAX_MESSAGE_SIZE={{ max_message_size }}
MAX_ATTACHMENT_SIZE={{ max_attachment_size }}
MAX_ATTACHMENTS={{ max_attachments }}

# Delivery settings
RETRY_INTERVAL={{ retry_interval }}
MAX_RETRY={{ max_retry }}

# Logging and archiving
LOGLEVEL={{ log_level }}
ARCHIVE={{ archive_enabled | lower }}
ARCHIVE_DIR={{ archive_dir }}

# Optional features
DIGEST={{ digest_enabled | lower }}
DIGEST_MAX_AGE={{ digest_max_age }}
DIGEST_MAX_MESSAGES={{ digest_max_messages }}

# Welcome and goodbye messages
WELCOME_MSG={{ welcome_msg_enabled | lower }}
GOODBYE_MSG={{ goodbye_msg_enabled | lower }}

# Additional moderators and admins (one per line)
{% for mod in moderators %}MODERATOR={{ mod }}
{% endfor %}
{% for admin in additional_admins %}ADMIN={{ admin }}
{% endfor %}