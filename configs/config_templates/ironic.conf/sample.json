{
  "debug": false,
  "api_host": "0.0.0.0",
  "api_port": 6385,
  "api_workers": 4,
  "auth_strategy": "keystone",
  "enable_ssl_api": false,
  "ssl_cert_file": "/etc/ironic/ssl/server.crt",
  "ssl_key_file": "/etc/ironic/ssl/server.key",
  "ssl_ca_file": "/etc/ironic/ssl/ca.crt",
  "default_conductor_group": "default",
  "default_power_interface": "ipmitool",
  "default_management_interface": "ipmitool",
  "default_boot_interface": "pxe",
  "keystone_endpoint_type": "internal",
  "keystone_auth_url": "http://keystone.openstack.svc.cluster.local:5000/v3",
  "keystone_project_name": "service",
  "keystone_username": "ironic",
  "keystone_password": "IRONIC_PASSWORD",
  "keystone_user_domain_name": "Default",
  "keystone_project_domain_name": "Default",
  "keystone_insecure": false,
  "db_connection": "mysql+pymysql://ironic:IRONIC_DB_PWD@mariadb.openstack.svc.cluster.local:3306/ironic?charset=utf8",
  "db_max_pool_size": 10,
  "db_max_overflow": 20,
  "db_pool_timeout": 30,
  "publish_errors_enabled": true,
  "conductor_task_processing_timeout": 3600,
  "conductor_heartbeat_timeout": 60,
  "agent_enabled": true,
  "agent_api_url": "http://ironic-inspector.openstack.svc.cluster.local:5050",
  "agent_connect_timeout": 5,
  "agent_call_timeout": 300,
  "image_download_chunk_size": 131072,
  "ipxe_enabled": false,
  "ipxe_menu_timeout": 5,
  "tftp_server_ip": "10.0.0.1",
  "tftp_root_dir": "/var/lib/ironic/tftpboot",
  "pxe_bootfile_name": "pxelinux.0",
  "pxe_uefi_bootfile_name": "grubaa64.efi",
  "dhcp_provider": "dnsmasq",
  "dns_lookup_enabled": false,
  "neutron_auth_url": "http://neutron.openstack.svc.cluster.local:9696",
  "neutron_project_name": "service",
  "neutron_username": "neutron",
  "neutron_password": "NEUTRON_PASSWORD",
  "neutron_user_domain_name": "Default",
  "neutron_project_domain_name": "Default",
  "neutron_insecure": false,
  "inspector_enabled": true,
  "inspector_url": "http://ironic-inspector.openstack.svc.cluster.local:5050",
  "inspector_auth_type": "keystone",
  "node_drivers": [
    {
      "node_type": "compute",
      "drivers": {
        "power": "redfish",
        "management": "redfish",
        "boot": "pxe",
        "ipmi": "no-ipmi",
        "raid": "redfish",
        "bios": "redfish",
        "vendor": "redfish"
      }
    },
    {
      "node_type": "storage",
      "drivers": {
        "power": "ipmitool",
        "management": "ipmitool",
        "boot": "pxe",
        "ipmi": "ipmitool",
        "raid": "no-raid",
        "bios": "no-bios",
        "vendor": "ipmitool"
      }
    }
  ]
}
