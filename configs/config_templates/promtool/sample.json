{
  "enable_feature": [
    "promql-experimental-functions"
  ],
  "experimental": true,
  "query_lookback_delta": "5m",
  "check_config_files": [
    "/etc/prometheus/prometheus.yml"
  ],
  "check_config_lint": "all",
  "check_config_lint_fatal": true,
  "check_config_syntax_only": false,
  "check_config_agent": false,
  "check_service_discovery": [
    {
      "timeout": "30s",
      "config_file": "/etc/prometheus/prometheus.yml",
      "job": "node"
    }
  ],
  "check_healthy_url": "http://localhost:9090",
  "check_ready_url": "http://localhost:9090",
  "check_rules_lint": "all",
  "check_rules_lint_fatal": false,
  "check_rules_ignore_unknown_fields": false,
  "check_rules_file": [
    "/etc/prometheus/rules/*.yml"
  ],
  "query_instant_http_config": "",
  "query_instant_server": "http://localhost:9090",
  "query_instant_expr": "up",
  "query_instant_time": "",
  "query_range_http_config": "",
  "query_range_server": "http://localhost:9090",
  "query_range_expr": "rate(up[5m])",
  "query_range_start": "2023-01-01T00:00:00Z",
  "query_range_end": "2023-01-01T01:00:00Z",
  "query_range_step": "15s",
  "push_metrics_remote_url": "http://localhost:9091/api/v1/write",
  "push_metrics_label_job": "promtool",
  "push_metrics_timeout": "30s",
  "push_metrics_headers": [
    "Authorization: Bearer token"
  ],
  "test_rules": [
    {
      "run": "",
      "diff": false,
      "test_rule_file": "/etc/prometheus/rules_test.yml"
    }
  ],
  "tsdb_analyze": [
    {
      "db_path": "data/",
      "limit": 20,
      "extended": true,
      "match": [
        "__name__=~'go_.*'"
      ]
    }
  ],
  "tsdb_dump": [
    {
      "db_path": "data/",
      "min_time": -9223372036854775,
      "max_time": 9223372036854775,
      "match": [
        "__name__=~'go_.*'"
      ]
    }
  ],
  "tsdb_bench_write": [
    {
      "file": "testdata/20kseries.json",
      "out": "benchout",
      "metrics": 10000,
      "scrapes": 3000
    }
  ]
}
