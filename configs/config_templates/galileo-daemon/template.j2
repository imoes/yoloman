# Default settings for galileo.py.
# These settings control the Galileo daemon behavior, specifically regarding
# synchronization intervals, data persistence, Fitbit integration, logging,
# and forced synchronization logic.
# Settings may be overridden using command-line switches to galileo.py.

# If in daemon mode, delay between sync runs specified in milliseconds.
# A value of 900000 ms corresponds to 15 minutes.
daemon-period: {{ daemon_period | default('900000') }}

# Whether to keep dump files after processing.
# Setting this to 'true' retains temporary dump files, which is useful for debugging.
# Setting this to 'false' cleans them up after use.
keep-dumps: {{ keep_dumps | default('false') }}

# Whether to upload data to Fitbit.
# If 'true', the daemon will push synchronized data to the Fitbit API.
# If 'false', data is processed locally only.
do-upload: {{ do_upload | default('true') }}

# Logging level for the daemon.
# Valid values are:
#   - 'default': Standard logging output.
#   - 'verbose': More detailed logging information.
#   - 'debug': Full debug output for troubleshooting.
logging: {{ logging | default('verbose') }}

# Whether to synchronize even if trackers were recently synchronized.
# If 'true', bypasses the recent-sync check and forces a full sync cycle.
# If 'false', skips sync if the last sync was too recent.
force-sync: {{ force_sync | default('false') }}
