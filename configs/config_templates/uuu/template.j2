# UUU (Universal Update Utility) Configuration
# Generated by Ansible Jinja2 engine
#
# This configuration file controls the runtime behavior of the `uuu` (Universal Update Utility)
# tool, used primarily for flashing firmware and bootloaders onto NXP i.MX SoCs via USB.
# All settings defined here correspond directly to command-line flags for `uuu`.
#
# Sections:
#   [settings] - Global runtime options for USB device handling, verbosity, and execution mode.

[settings]

# default_target: The default built-in script to run if no command line argument is specified.
# Valid values include: emmc, emmc_all, fat_write, nand, nvme_all, qspi, sd, sd_all, spi_nand, spl
# Default: sd
# Corresponds to command-line flag: -b<target> (without explicit script name)
default_target = {{ default_target | default('sd') }}

# usb_polling_period_ms: USB polling period in milliseconds.
# Controls how frequently uuu checks for USB device events. Lower values increase responsiveness
# but may increase CPU usage.
# Default: 100
# Corresponds to command-line flag: -pp <milliseconds>
usb_polling_period_ms = {{ usb_polling_period_ms | default(100) }}

# timeout_known_usb_seconds: Timeout in seconds for waiting for a known USB device to appear.
# If a device matching the expected VID/PID is not seen within this time, uuu may proceed
# or fail depending on the operation.
# Default: 30
# Corresponds to command-line flag: -t <seconds>
timeout_known_usb_seconds = {{ timeout_known_usb_seconds | default(30) }}

# timeout_stage_switch_seconds: Timeout in seconds for waiting for the next USB device at stage switch.
# During multi-stage flashing (e.g., SPL then U-Boot), this waits for the device to reboot
# and re-enumerate.
# Default: 15
# Corresponds to command-line flag: -T <seconds>
timeout_stage_switch_seconds = {{ timeout_stage_switch_seconds | default(15) }}

# disable_small_memory: If true, disables small memory optimization.
# Small memory optimization attempts to fit large flash images into smaller device memories
# by splitting operations. Disabling it forces full image transfer, which may be required
# for certain specific hardware errata or debugging.
# Default: false
# Corresponds to command-line flag: -dm
disable_small_memory = {{ disable_small_memory | default(False) | lower }}

# verbose_mode: If true, enables standard verbose mode.
# Outputs progress information and standard libusb warnings/errors to stderr. Useful for
# general troubleshooting of connection issues.
# Default: false
# Corresponds to command-line flag: -v
verbose_mode = {{ verbose_mode | default(False) | lower }}

# verbose_error_mode: If true, enables verbose mode with libusb error/warning info.
# Provides deeper debugging output from the underlying libusb library. Significantly more
# verbose than verbose_mode. Intended for developers or complex hardware debugging.
# Default: false
# Corresponds to command-line flag: -V
verbose_error_mode = {{ verbose_error_mode | default(False) | lower }}

# use_bmap_files: If true, tries to use .bmap files even if flash commands do not specify them.
# .bmap files contain block map information for efficient partial flashing. If enabled, uuu
# will attempt to find a corresponding .bmap file next to the flash image.
# Default: false
# Corresponds to command-line flag: -bmap
use_bmap_files = {{ use_bmap_files | default(False) | lower }}

# ignore_bmap_files: If true, ignores .bmap files even if flash commands specify them.
# Overrides use_bmap_files. If set to true, uuu will perform full block transfers regardless
# of available .bmap files, potentially slowing down large image writes.
# Default: false
# Corresponds to command-line flag: -no-bmap
ignore_bmap_files = {{ ignore_bmap_files | default(False) | lower }}

# daemon_mode: If true, runs in daemon mode.
# In daemon mode, uuu does not exit after processing initial commands. Instead, it waits
# indefinitely for new commands or device connections via its API or stdin.
# Default: false
# Corresponds to command-line flag: -d
daemon_mode = {{ daemon_mode | default(False) | lower }}

# dry_run_mode: If true, performs a dry run.
# Checks the correctness of scripts and commands without actually executing them or
# communicating with USB devices. Useful for validating scripts before flashing.
# Default: false
# Corresponds to command-line flag: -dry
dry_run_mode = {{ dry_run_mode | default(False) | lower }}

# usb_path_filter: List of USB path filters to restrict monitoring to specific devices.
# Filters devices by their USB bus and port path (e.g., "1:2", "1:3"). Multiple entries
# can be specified. If empty, all USB devices are monitored.
# Default: []
# Corresponds to command-line flag: -m <path>
# Format: bus:port
{% set _usb_path_filter = usb_path_filter | default([]) %}
{% if _usb_path_filter %}
{% for path in _usb_path_filter %}
usb_path_filter = {{ path }}
{% endfor %}
{% endif %}

# serial_prefix_filter: List of serial number prefixes to monitor.
# Restricts uuu to devices whose USB serial numbers start with one of the specified prefixes.
# Useful when multiple similar devices are connected to the host.
# Default: []
# Corresponds to command-line flag: -ms <prefix>
# Format: string
{% set _serial_prefix_filter = serial_prefix_filter | default([]) %}
{% if _serial_prefix_filter %}
{% for prefix in _serial_prefix_filter %}
serial_prefix_filter = {{ prefix }}
{% endfor %}
{% endif %}

# environment_variables: List of environment variable key=value pairs to pass to the uuu
# execution context.
# These variables are available to scripts executed by uuu.
# Default: []
# Corresponds to command-line flag: -e <key=value>
# Format: key=value
{% set _env_vars = environment_variables | default([]) %}
{% if _env_vars %}
{% for env in _env_vars %}
environment_variables = {{ env }}
{% endfor %}
{% endif %}