{
  "default_target": "emmc",
  "usb_polling_period_ms": 50,
  "timeout_known_usb_seconds": 60,
  "timeout_stage_switch_seconds": 20,
  "disable_small_memory": true,
  "verbose_mode": true,
  "verbose_error_mode": false,
  "use_bmap_files": true,
  "ignore_bmap_files": false,
  "daemon_mode": false,
  "dry_run_mode": false,
  "usb_path_filter": [
    "1:5",
    "2:2"
  ],
  "serial_prefix_filter": [
    "IMX_",
    "NXP_"
  ],
  "environment_variables": [
    "UBOOT_ENV=1",
    "FLASH_MODE=1"
  ]
}
