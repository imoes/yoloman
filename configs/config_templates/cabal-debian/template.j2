# debian control file metadata template for cabal-debian
# (generated automatically from cabal-debian flags)
#
# This template generates the Debian `debian/control` file for a Haskell
# package built via `cabal-debian`. It handles the main package, optional
# profiling and Haddock documentation sub-packages.
#
# Self-documenting: every directive is preceded by its schema description.

# Package name override: Explicit package name override (from --name=NAME).
# Empty to auto-generate.
Package: {{ name | default('haskell-' ~ (pkgname | default('') | replace("-", "_"))) }}

# Version override: Package version (override via --version=VERSION or inferred from .cabal).
Version: {{ version | default('1.0.0') }}

# Release number: Debian package release number (override via --release=RELEASE).
Release: {{ release | default('1') }}

# Maintainer name and email: Maintainer name and email (override via --maintainer=NAME <EMAIL>).
Maintainer: {{ maintainer | default('Unknown Maintainer <unknown@example.com>') }}

# Source line: Not configurable via cabal-debian CLI; fixed pattern derived from pkgname, version, and release.
Source: {{ pkgname | default('') }} ({{ version | default('1.0.0') }}-{{ release | default('1') }})

# Section: Fixed to 'haskell' as per cabal-debian conventions for Haskell packages.
Section: haskell

# Priority: Fixed to 'optional' as per Debian policy for Haskell packages.
Priority: optional

# Architecture: Target architecture (e.g., any, all, amd64). Controlled by Cabal build flags but not exposed as CLI flag; set via --ghc/--jhc/etc. defaults.
Architecture: {{ architecture | default('any') }}

# Build dependencies: List of build dependency groups (each item is a list of package names for a dependency clause).
# Derived from Cabal build-deps, adjusted per dependency clause.
# Each group is joined with ', ' and groups are separated with ' + '.
Build-Depends: debhelper (>= 10), ghc (>= 9.0), libghc-cabal-dev,
{% for dep in build_deps | default([]) %}
{% if loop.first %}{{ ' ' | indent(22) }}{% else %}{{ ' + ' | indent(21) }}{% endif %}{{ dep | join(', ') }}
{% endfor %}

# Standard dependencies (library package): Standard substitution variables for shared libraries and misc deps.
Depends: ${shlibs:Depends}, ${misc:Depends}

# Description (first line: short; second: long, indented): Short one-line description of the package.
Description: {{ description_short | default('Haskell package: ' ~ (pkgname | default(''))) }}
# Long multi-line description (will be indented properly in final control file).
{{ description_long | default('This package provides the ' ~ (pkgname | default('')) ~ ' Haskell library.') | indent(1, true) }}

{% if enable_profiling | default(false) | bool %}
# Profiling library package: Generated if enable_profiling is True (disabled via --disable-library-profiling).
Package: libghc-{{ (pkgname | default('')) | replace('-', '_') }}-prof
Section: haskell
Architecture: {{ architecture | default('any') }}
Depends: libghc-{{ (pkgname | default('')) | replace('-', '_') }}-dev (= ${binary:Version}), ${haskell:Prof-Depends}, ${misc:Depends}
Description: Profiling library for {{ description_short | default(pkgname | default('')) }}
{{ description_long | default('This package provides profiling support for the ' ~ (pkgname | default('')) ~ ' library.') | indent(1, true) }}
{% endif %}

{% if enable_haddock | default(true) | bool %}
# Haddock documentation package: Generated if enable_haddock is True (disabled via --disable-haddock).
Package: libghc-{{ (pkgname | default('')) | replace('-', '_') }}-doc
Section: doc
Architecture: all
Depends: ${haskell:Doc-Depends}, ${misc:Depends}
Description: Haddock documentation for {{ description_short | default(pkgname | default('')) }}
{{ description_long | default('This package provides Haddock API documentation for the ' ~ (pkgname | default('')) ~ ' library.') | indent(1, true) }}
{% endif %}

# Substvars placeholders: These lines are not rendered directly but referenced during build.
# See man:cabal-debian(1) for --substvar values: Doc, Prof, Dev.
# Example substitution lines (commented out; generated by cabal-debian at build time):
# substvars: haddock:Depends=libghc-{{ (pkgname | default('')) | replace('-', '_') }}-doc (>= {{ version | default('1.0.0') }})
# substvars: profile:Depends=libghc-{{ (pkgname | default('')) | replace('-', '_') }}-prof (>= {{ version | default('1.0.0') }})
# substvars: dev:Depends=libghc-{{ (pkgname | default('')) | replace('-', '_') }}-dev (= ${binary:Version})