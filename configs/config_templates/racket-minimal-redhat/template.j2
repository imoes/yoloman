;; Generated by Ansible for racket-minimal-redhat
;; This configuration defines the directory structure and catalog sources for the Racket installation.

;; Path to Racket documentation directory.
(doc-dir . "{{ doc_dir | default('/usr/share/doc/racket') }}")

;; Path to Racket DLL/library directory.
(dll-dir . "{{ dll_dir | default('/usr/lib64') }}")

;; Path to Racket library directory.
(lib-dir . "{{ lib_dir | default('/usr/lib64/racket') }}")

;; Path to Racket share directory.
(share-dir . "{{ share_dir | default('/usr/share/racket') }}")

;; Path to Racket include directory.
(include-dir . "{{ include_dir | default('/usr/include/racket') }}")

;; Path to Racket binary directory.
(bin-dir . "{{ bin_dir | default('/usr/bin') }}")

;; Path to Racket applications directory.
(apps-dir . "{{ apps_dir | default('/usr/share/applications') }}")

;; Path to Racket manual pages directory.
(man-dir . "{{ man_dir | default('/usr/share/man') }}")

;; Whether the installation is absolute.
(absolute-installation? . {{ absolute_installation | default(true) }})

;; URL for Racket documentation search.
(doc-search-url . "{{ doc_search_url | default('https://download.racket-lang.org/releases/7.9/doc/local-redirect/index.html') }}")

;; catalogs: List of catalog URLs for Racket packages.
;; catalog_0: First catalog URL for Racket packages.
;; catalog_1: Second catalog value (often false/null).
;; Note: catalog_1 must have a default to prevent undefined variable errors.
(catalogs . ("{{ catalog_0 | default('https://download.racket-lang.org/releases/7.9/catalog/') }}" {% if (catalog_1 | default(false)) %}{{ catalog_1 | default(false) }}{% else %}"#f"{% endif %}))

;; Build stamp for the Racket installation.
(build-stamp . "{{ build_stamp | default('') }}")
