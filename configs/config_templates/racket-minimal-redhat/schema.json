{
  "doc_dir": {
    "type": "string",
    "default": "/usr/share/doc/racket",
    "description": "Path to Racket documentation directory."
  },
  "dll_dir": {
    "type": "string",
    "default": "/usr/lib64",
    "description": "Path to Racket DLL/library directory."
  },
  "lib_dir": {
    "type": "string",
    "default": "/usr/lib64/racket",
    "description": "Path to Racket library directory."
  },
  "share_dir": {
    "type": "string",
    "default": "/usr/share/racket",
    "description": "Path to Racket share directory."
  },
  "include_dir": {
    "type": "string",
    "default": "/usr/include/racket",
    "description": "Path to Racket include directory."
  },
  "bin_dir": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Path to Racket binary directory."
  },
  "apps_dir": {
    "type": "string",
    "default": "/usr/share/applications",
    "description": "Path to Racket applications directory."
  },
  "man_dir": {
    "type": "string",
    "default": "/usr/share/man",
    "description": "Path to Racket manual pages directory."
  },
  "absolute_installation": {
    "type": "string",
    "default": "#t",
    "description": "Whether the installation is absolute."
  },
  "doc_search_url": {
    "type": "string",
    "default": "https://download.racket-lang.org/releases/7.9/doc/local-redirect/index.html",
    "description": "URL for Racket documentation search."
  },
  "catalog_0": {
    "type": "string",
    "default": "https://download.racket-lang.org/releases/7.9/catalog/",
    "description": "First catalog URL for Racket packages."
  },
  "catalog_1": {
    "type": "string",
    "default": "#f",
    "description": "Second catalog value (often false/null)."
  },
  "build_stamp": {
    "type": "string",
    "default": "",
    "description": "Build stamp for the Racket installation."
  }
}
