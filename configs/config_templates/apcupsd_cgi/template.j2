# APC UPS Power Management Configuration File
# Generated by apcupsd-cgi configuration wizard
# ---
# Device detection and connection

# The type of UPS connected (NIS, MIB, USB, SNMP, etc.)
{{ 'UPSTYPE' | comment }}
UPSTYPE {{ values.ups_type }}

# Device path or identifier (e.g., /dev/ttyS0, /dev/usb/hiddev0, host:port for SNMP)
{{ 'DEVICE' | comment }}
DEVICE {{ values.device }}

# Network interface for NIS (Network Information Server) listener
{{ 'NISIP' | comment }}
NISIP {{ values.nis_ip }}

# Port for NIS server (default 3551)
{{ 'NISPORT' | comment }}
NISPORT {{ values.nis_port }}

# Timeout (seconds) for device communication
{{ 'TIMEOUT' | comment }}
TIMEOUT {{ values.timeout }}

# ---
# Power event handling

# Time (minutes) after power failure before shutdown
{{ 'ONBATTERYDELAY' | comment }}
ONBATTERYDELAY {{ values.on_battery_delay }}

# Battery level (%) at which to initiate shutdown
{{ 'BATTERYLEVEL' | comment }}
BATTERYLEVEL {{ values.battery_level }}

# Minutes of battery runtime remaining before forced shutdown
{{ 'MINUTES' | comment }}
MINUTES {{ values.minutes }}

# Kill UPS power after shutdown? (true/false)
{{ 'KILLONHIBERNATE' | comment }}
KILLONHIBERNATE {{ 'yes' if values.kill_on_hibernate else 'no' }}

# Allow UPS to go into hibernation? (true/false)
{{ 'HIBERNATE' | comment }}
HIBERNATE {{ 'yes' if values.hibernate else 'no' }}

# ---
# Web interface (CGI) configuration

# Enable web server for CGI interface? (true/false)
{{ 'WEBACCESS' | comment }}
WEBACCESS {{ 'yes' if values.web_access else 'no' }}

# IP address(es) allowed to access the CGI interface (list of hostnames/IPs/CIDRs)
{{ 'WEBACCESS' | comment }}
{% for host in values.web_hosts %}WEBACCESS {{ host }}
{% endfor %}

# Port for web server (default 8080)
{{ 'WEBPORT' | comment }}
WEBPORT {{ values.web_port }}

# Path for CGI scripts (typically /usr/lib/apcupsdcgi)
{{ 'CGIPATH' | comment }}
CGIPATH {{ values.cgi_path }}

# ---
# Logging and reporting

# Enable email alerts? (true/false)
{{ 'NETSERVER' | comment }}
NETSERVER {{ 'yes' if values.net_server else 'no' }}

# Email notification recipients (list)
{% if values.email_addresses %}
EMAILADDRS {{ values.email_addresses | join(', ') }}
{% endif %}

# Email alert on power failure? (true/false)
{{ 'EMAILLOG' | comment }}
EMAILLOG {{ 'yes' if values.email_log else 'no' }}

# Path to syslog (e.g., /dev/log)
{{ 'SYSLOG' | comment }}
SYSLOG {{ values.syslog facility }}

# ---
# Advanced / optional settings

# Polling interval (seconds) for UPS status
{{ 'POLLTIME' | comment }}
POLLTIME {{ values.poll_time }}

# Hostname for SNMP UPS (if SNMP type)
{% if values.ups_type == 'snmp' %}
SNMPSN {{ values.snmp_sn }}
{% endif %}

# SNMP community string
{% if values.ups_type == 'snmp' %}
SNMPCOMM {{ values.snmp_community }}
{% endif %}

# Lock device file? (true/false)
{{ 'LOCKFILE' | comment }}
LOCKFILE {{ values.lockfile }}

# ---
# End of apcupsd.conf
