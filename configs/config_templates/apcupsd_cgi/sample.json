{
  "ups_type": "usb",
  "device": "/dev/usb/hiddev0",
  "nis_ip": "127.0.0.1",
  "nis_port": 3551,
  "timeout": 30,
  "on_battery_delay": 60,
  "battery_level": 10,
  "minutes": 5,
  "kill_on_hibernate": false,
  "hibernate": false,
  "web_access": true,
  "web_hosts": [
    "127.0.0.1",
    "192.168.1.0/24"
  ],
  "web_port": 8080,
  "cgi_path": "/usr/lib/apcupsdcgi",
  "net_server": true,
  "email_addresses": [
    "admin@example.com",
    "ops@example.com"
  ],
  "email_log": true,
  "syslog": "daemon",
  "poll_time": 15,
  "lockfile": "/var/lock/apcupsd"
}
