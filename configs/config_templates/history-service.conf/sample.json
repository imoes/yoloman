{
  "db_engine": "sqlite",
  "db_host": "localhost",
  "db_port": 5432,
  "db_name": "/var/lib/lomiri/history.db",
  "db_user": "history",
  "db_password": "",
  "cache_enabled": true,
  "cache_ttl_seconds": 600,
  "cache_max_size": 20000,
  "worker_threads": 2,
  "worker_max_tasks": 15,
  "retention_max_age_days": 45,
  "retention_batch_size": 500,
  "ignore_sources": [
    "lomiri-indicator-datetime",
    "systemd-journald"
  ],
  "filter_min_age_seconds": 10,
  "log_level": "info",
  "log_file": "/var/log/lomiri/history-service.log",
  "log_max_size_mb": 100,
  "log_max_files": 3,
  "enable_dedup": true,
  "enable_remote_sync": false,
  "remote_sync_url": ""
}
