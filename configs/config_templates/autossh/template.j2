# AutoSSH Configuration Template
# This file is generated by Ansible. Do not edit manually.

{# --------------------------------------------------------------------------- #}
# Logging Configuration
# --------------------------------------------------------------------------- #

# log_file: Path to a file where AutoSSH logs will be written. If empty, uses syslog or stderr.
# The variable must be defined in the inventory or group_vars to enable file logging.
{% if log_file | default('') | length > 0 %}
LOGFILE="{{ log_file | default('') }}"
{% else %}
# LOGFILE is not set; AutoSSH will log to syslog or stderr by default.
{% endif %}

{# --------------------------------------------------------------------------- #}
# SSH Options Configuration
# --------------------------------------------------------------------------- #

# ssh_options: List of additional command-line options to pass to the underlying ssh command.
# These options are joined with spaces to form the SSH_ARGUMENTS string.
# Example input: ['-N', '-T', '-o ServerAliveInterval=30']
# Results in: SSH_ARGUMENTS="-N -T -o ServerAliveInterval=30"
SSH_ARGUMENTS="{{ ssh_options | default([]) | join(' ') }}"

{# --------------------------------------------------------------------------- #}
# Environment Variables Configuration
# --------------------------------------------------------------------------- #

# env_vars: Custom environment variables for advanced use cases (e.g., proxy configuration).
# Keys are variable names, values are their string values.
# This section generates `export KEY="VALUE"` lines.
{% if env_vars | default([]) | length > 0 %}
{% for key, value in env_vars | default([]) | dict2items %}
export {{ key }}="{{ value }}"
{% endfor %}
{% endif %}