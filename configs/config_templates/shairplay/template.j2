# ==============================================================================
# shairplay configuration template
# Provides a RAOP (Remote Audio Output Protocol) AirPlay server service.
# ==============================================================================

# The name of the AirPort device as it appears in iOS/Mac discovery.
# This is the friendly name shown in AirPlay device lists.
apname={{ apname | default('AirPort Express') }}

# The password used for pairing with the AirPort device.
# Set to an empty string to disable pairing password requirement (less secure).
password={{ password | default('secret') }}

# The network port for the RAOP service.
server_port={{ server_port | default(5000) }}

# The MAC address of the network interface, used to identify the device or for multiple instances.
# This helps in distinguishing between multiple shairplay instances on the same host.
hwaddr={{ hwaddr | default('00:11:22:33:44:55') }}

# The audio output driver (e.g., alsa, pulse).
# Common options: 'alsa' for Linux ALSA, 'pulse' for PulseAudio.
ao_driver={{ ao_driver | default('alsa') }}

# The specific device name for the audio output driver.
# Leave empty for default device selection.
ao_devicename={{ ao_devicename | default('') }}

# The device ID for the audio output driver.
# Leave empty for default device ID selection.
ao_deviceid={{ ao_deviceid | default('') }}