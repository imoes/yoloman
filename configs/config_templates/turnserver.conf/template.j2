# =============================================================================
# TURN/STUN Server Configuration Template
# Generated by Ansible. Do not edit manually.
# Reference: https://github.com/coturn/coturn
# =============================================================================

# =============================================================================
# Basic Operational Parameters
# =============================================================================

# Primary IP address for listening (use 0.0.0.0 for all IPv4, or :: for all IPv6).
listening-ip={{ listening_ip | default('0.0.0.0') }}

# Additional IP addresses to listen on (e.g., multiple NIC IPs).
{%- for ip in alt_listening_ips | default([]) %}
listening-ip={{ ip }}
{%- endfor %}

# UDP/TCP listening port (standard STUN/TURN port).
listening-port={{ listening_port | default(3478) }}

# TLS (DTLS) listening port (standard secure TURN port).
tls-listening-port={{ tls_listening_port | default(5349) }}

# =============================================================================
# Realm and Authentication
# =============================================================================

# Authentication realm (used to scope credentials).
realm={{ realm | default('turnserver') }}

# Enable time-limited HTTP auth secret (recommended over static credentials).
{%- if use_auth_secret | default(false) | bool %}
static-auth-secret={{ auth_secret | default('') }}
{%- else %}
# Static username:password credentials (only used if use_auth_secret is false).
{%- for user in users | default([]) %}
user={{ user.username }}:{{ user.password }}
{%- endfor %}
{%- endif %}

# =============================================================================
# Network and Relay Settings
# =============================================================================

# IP address used for relay (if not using multiple relay addresses).
# IP addresses to use for relay (e.g., multiple public IPs for load balancing).
{%- if relay_addresses | default([]) %}
{%- for addr in relay_addresses | default([]) %}
relay-address={{ addr }}
{%- endfor %}
{%- else %}
relay-address={{ relay_address | default('') }}
{%- endif %}

# Single public IP to advertise in STUN/TURN responses (e.g., when NAT is involved).
# Multiple public IPs to advertise (e.g., for failover or load balancing).
{%- if external_ip | default('') %}
external-ip={{ external_ip | default('') }}
{%- else %}
{%- for ip in alt_external_ips | default([]) %}
external-ip={{ ip }}
{%- endfor %}
{%- endif %}

# =============================================================================
# Security and Access Control
# =============================================================================

# Allow peers from loopback addresses (e.g., 127.0.0.1) — useful for testing.
{%- if allow_loopback_peers | default(false) | bool %}
allow-loopback-peers
{%- endif %}

# Block relay of private IP ranges (e.g., RFC1918) — recommended for security.
{%- if deny_private_ranges | default(true) | bool %}
DenyPrivateRange
{%- else %}
AllowPrivate
{%- endif %}

# Custom TLS cipher list (colon-separated); leave empty to use system defaults.
{%- if cipher_list | default([]) %}
cipher-list={{ cipher_list | default([]) | join(':') }}
{%- endif %}

# =============================================================================
# Logging and Diagnostics
# =============================================================================

# Enable verbose logging (detailed connection/state info).
verbose={{ verbose | default(true) | lower }}

# Optional file path to write logs (instead of stdout/stderr).
{%- if log_file | default('') %}
log-file={{ log_file | default('') }}
{%- endif %}

# =============================================================================
# Limits and Resource Tuning
# =============================================================================

# Maximum bandwidth (bytes/second) per session.
max-bps={{ max_bps | default(1000000) }}

# Total number of peer connections allowed per user (0 = unlimited).
{%- if total_quota | default(0) %}
total-quota={{ total_quota | default(0) }}
{%- endif %}

# Per-user peer connection quota (0 = unlimited).
{%- if per_user_quota | default(0) %}
per-user-quota={{ per_user_quota | default(0) }}
{%- endif %}

# =============================================================================
# Certificates (TLS)
# =============================================================================

# Path to TLS certificate (PEM format).
{%- if cert | default('') %}
cert={{ cert | default('') }}
{%- endif %}

# Path to TLS private key (PEM format; if not embedded in cert).
{%- if pkey | default('') %}
pkey={{ pkey | default('') }}
{%- endif %}

# Path to CA certificate for client verification (optional).
{%- if ca_cert | default('') %}
ca-cert={{ ca_cert | default('') }}
{%- endif %}

# =============================================================================
# Optional: Additional Flags
# List of additional configuration flags (one per string), e.g., ['no-udp', 'no-tcp'].
# =============================================================================
{%- for opt in extra_options | default([]) %}
{{ opt }}
{%- endfor %}