# Listen address for the worker's HTTP server
listen: {{ listen_address }}:{{ listen_port }}

# Path to the socket used for local control/health checks
control_socket: {{ control_socket_path }}

# Maximum number of concurrent work items the worker can process
max_concurrent_work: {{ max_concurrent_work }}

# Timeout (seconds) for work item execution before being terminated
work_timeout: {{ work_timeout }}

# URL of the Debusine server this worker registers with
server_url: {{ server_url }}

# Worker registration token (shared secret with server)
registration_token: "{{ registration_token }}"

# Optional: Set custom worker labels (key-value pairs shown in the server UI)
{% for label in labels %}labels:
  {{ label.name }}: "{{ label.value }}"
{% endfor %}

# Optional: Enable debug logging for verbose output
debug: {{ debug }}

# Optional: Log format (json or text)
log_format: "{{ log_format }}"
