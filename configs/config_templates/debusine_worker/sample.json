{
  "listen_address": "0.0.0.0",
  "listen_port": 8765,
  "control_socket_path": "/run/debusine/worker.sock",
  "max_concurrent_work": 8,
  "work_timeout": 1200,
  "server_url": "https://debusine.example.com",
  "registration_token": "debusine-worker-secret-token-v1",
  "labels": [
    {
      "name": "location",
      "value": "datacenter-2"
    },
    {
      "name": "role",
      "value": "compute-heavy"
    }
  ],
  "debug": true,
  "log_format": "json"
}
