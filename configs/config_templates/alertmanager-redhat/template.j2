# Ansible-generated Alertmanager configuration
# Source: alertmanager-redhat role template
# This template produces a valid alertmanager.yml configuration file.
# All variables are sourced from the role's defaults/vars and use safe defaults
# to prevent render failures if variables are omitted.

# Global configuration for Alertmanager
global:
  # The smarthost and SMTP sender used for mail notifications.
  # Default: localhost:25
  smtp_smarthost: '{{ smtp_smarthost | default("localhost:25") }}'
  
  # The email address from which alerts are sent.
  # Default: alertmanager@example.org
  smtp_from: '{{ smtp_from | default("alertmanager@example.org") }}'
  
  # The username for SMTP authentication.
  # Default: alertmanager
  smtp_auth_username: '{{ smtp_auth_username | default("alertmanager") }}'
  
  # The password for SMTP authentication.
  # Default: password
  smtp_auth_password: '{{ smtp_auth_password | default("password") }}'

# The directory pattern from which notification templates are read.
# Default: /etc/prometheus/alertmanager_templates/*.tmpl
templates: 
  - '{{ templates_dir | default("/etc/prometheus/alertmanager_templates/*.tmpl") }}'

# The root route on which each incoming alert enters.
# This defines how alerts are grouped and routed to receivers.
route:
  # The labels by which incoming alerts are grouped together.
  group_by: ['alertname', 'cluster', 'service']

  # When a new group of alerts is created by an incoming alert, wait at
  # least 'group_wait' to send the initial notification.
  # Default: 30s
  group_wait: 30s

  # When the first notification was sent, wait 'group_interval' to send a batch
  # of new alerts that started firing for that group.
  # Default: 5m
  group_interval: 5m

  # If an alert has successfully been sent, wait 'repeat_interval' to
  # resend them.
  # Default: 3h
  repeat_interval: 3h 

  # A default receiver for alerts that do not match any child route.
  receiver: team-X-mails

  # The child route trees.
  routes:
    # Route for team-X services. Matches specific services via regex.
    - match_re:
        service: ^(foo1|foo2|baz)$
      receiver: team-X-mails
      # Sub-route for critical alerts within team-X.
      routes:
      - match:
          severity: critical
        receiver: team-X-pager

    # Route for file-related alerts.
    - match:
        service: files
      receiver: team-Y-mails
      # Sub-route for critical file alerts.
      routes:
      - match:
          severity: critical
        receiver: team-Y-pager

    # Route for database alerts.
    - match:
        service: database
      receiver: team-DB-pager
      # Group database alerts by alertname, cluster, and database name.
      group_by: [alertname, cluster, database]
      # Sub-routes to re-route specific team owners within the DB team.
      routes:
      - match:
          owner: team-X
        receiver: team-X-pager
      - match:
          owner: team-Y
        receiver: team-Y-pager

# Inhibition rules allow muting a set of alerts given that another alert is firing.
# This prevents warning notifications when a critical alert is already active for the same entity.
inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    # Apply inhibition if the alertname, cluster, and service match.
    equal: ['alertname', 'cluster', 'service']

# List of receivers defined for use in the route tree.
receivers:
  # Receiver for team-X email alerts.
  # Default email address: team-X+alerts@example.org
  - name: 'team-X-mails'
    email_configs:
    - to: '{{ team_x_alerts_email | default("team-X+alerts@example.org") }}'

  # Receiver for team-X PagerDuty alerts (also includes critical emails).
  # Default email: team-X+alerts-critical@example.org
  # Default PagerDuty key: <team-X-key>
  - name: 'team-X-pager'
    email_configs:
    - to: '{{ team_x_critical_email | default("team-X+alerts-critical@example.org") }}'
    pagerduty_configs:
    - service_key: '{{ team_x_pagerduty_key | default("<team-X-key>") }}'

  # Receiver for team-Y email alerts.
  # Default email address: team-Y+alerts@example.org
  - name: 'team-Y-mails'
    email_configs:
    - to: '{{ team_y_alerts_email | default("team-Y+alerts@example.org") }}'

  # Receiver for team-Y PagerDuty alerts.
  # Default PagerDuty key: <team-Y-key>
  - name: 'team-Y-pager'
    pagerduty_configs:
    - service_key: '{{ team_y_pagerduty_key | default("<team-Y-key>") }}'

  # Receiver for team-DB PagerDuty alerts.
  # Default PagerDuty key: <team-DB-key>
  - name: 'team-DB-pager'
    pagerduty_configs:
    - service_key: '{{ team_db_pagerduty_key | default("<team-DB-key>") }}'
