; gamemode.ini — Gamemode configuration file
; Gamemode is a lightweight tool designed to optimize your Linux system for gaming.
; This template is self-documenting: every setting includes its schema description
; as a comment, ensuring maintainability without external documentation.

[ gamemoded ]
; Enable gamemode system-wide on boot.
; Default: true
enabled = {{ (enabled | default(true)) | string | lower }}

; CPU frequency scaling governor to use when gamemode is active (e.g., performance, schedutil, powersave).
; Default: performance
cpu_governor = {{ (cpu_governor | default('performance')) | string }}

; GPU frequency scaling governor to use when gamemode is active (if supported by hardware).
; Default: performance
gpu_governor = {{ (gpu_governor | default('performance')) | string }}

; Number of seconds to wait after a game exits before restoring original settings.
; Default: 10
idle_time = {{ (idle_time | default(10)) | int }}

; List of process name patterns to exclude from gamemode (supports glob patterns like '*steam*').
; Default: []
; Each entry is commented out with its pattern for clarity; uncomment to exclude a specific process.
{% for pattern in (exclude_processes | default([])) %}; Exclude process pattern {{ loop.index }}: {{ pattern | string }}
; exclude_{{ loop.index }} = {{ pattern | string }}
{% endfor %}

; List of custom scripts to run during gamemode lifecycle events.
; Default: []
; Each script entry is documented. Note: The gamemode.ini format for scripts is limited;
; if complex scripting is needed, use gamemode's external script hooks or systemd services.
; The template below generates comments only, as the actual 'script=' directive in gamemode.ini
; typically expects a single path and relies on the game launch wrapper to handle events.
{% for script in (scripts | default([])) %}; Custom script {{ loop.index }}:
; Event: {{ script.event | string if script.event is defined else 'N/A' }}
; Path: {{ script.path | string if script.path is defined else 'N/A' }}
{% endfor %}

; Enable GPU boost (if hardware/driver supports it).
; Default: true
gpu_boost = {{ (gpu_boost | default(true)) | string | lower }}

; Maximum number of concurrent game sessions allowed.
; Default: 5
max_concurrent_games = {{ (max_concurrent_games | default(5)) | int }}

; Logging verbosity: 0=error, 1=warn (default), 2=info, 3=debug.
; Default: 1
log_level = {{ (log_level | default(1)) | int }}

; Path to the gamemode log file.
; Default: /var/log/gamemode.log
log_file = {{ (log_file | default('/var/log/gamemode.log')) | string }}

; Adjust process nice priority for games.
; Default: { 'enabled': false, 'value': 10 }
; Note: 'value' is the nice value to apply (positive = lower priority, negative = higher).
enable_nice = {{ (nice | default({'enabled': False, 'value': 10})).enabled | string | lower }}
nice_priority = {{ (nice | default({'enabled': False, 'value': 10})).value | int }}

; Adjust I/O scheduling for game processes.
; Default: { 'enabled': false, 'class': 1, 'priority': 7 }
; I/O classes: 0 = none, 1 = idle, 2 = best-effort, 3 = realtime.
; Priority: 0-7 (only meaningful for best-effort class).
enable_io = {{ (io | default({'enabled': False, 'class': 1, 'priority': 7})).enabled | string | lower }}
io_class = {{ (io | default({'enabled': False, 'class': 1, 'priority': 7})).class | int }}
io_priority = {{ (io | default({'enabled': False, 'class': 1, 'priority': 7})).priority | int }}

; Adjust process priority via renice (legacy alias; prefer 'nice' setting).
; Default: { 'enabled': false, 'value': -10 }
; Note: Negative values increase priority.
enable_renice = {{ (renice | default({'enabled': False, 'value': -10})).enabled | string | lower }}
renice_priority = {{ (renice | default({'enabled': False, 'value': -10})).value | int }}

; Reset FPU state on gamemode entry (recommended for Intel CPUs to prevent floating-point inconsistencies).
; Default: true
reset_fpu = {{ (reset_fpu | default(true)) | string | lower }}