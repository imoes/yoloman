{
 "cpu_governor": "performance",
 "enabled": true,
 "exclude_processes": [
  {
   "pattern": "steamwebhelper"
  },
  {
   "pattern": "*flatpak*"
  }
 ],
 "gpu_boost": true,
 "gpu_governor": "performance",
 "idle_time": 10,
 "io": {
  "class": 1,
  "enabled": false,
  "priority": 7
 },
 "log_file": "/var/log/gamemode.log",
 "log_level": 2,
 "max_concurrent_games": 5,
 "nice": {
  "enabled": true,
  "value": 5
 },
 "renice": {
  "enabled": true,
  "value": -5
 },
 "reset_fpu": true,
 "scripts": [
  {
   "event": "enter",
   "path": "/usr/local/bin/gamemode-early.sh"
  },
  {
   "event": "exit",
   "path": "/usr/local/bin/gamemode-late.sh"
  }
 ]
}
