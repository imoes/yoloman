{
  "enabled": true,
  "cpu_governor": "performance",
  "gpu_governor": "performance",
  "idle_time": 10,
  "exclude_processes": [
    {
      "pattern": "steamwebhelper"
    },
    {
      "pattern": "*flatpak*"
    }
  ],
  "scripts": [
    {
      "event": "enter",
      "path": "/usr/local/bin/gamemode-early.sh"
    },
    {
      "event": "exit",
      "path": "/usr/local/bin/gamemode-late.sh"
    }
  ],
  "gpu_boost": true,
  "max_concurrent_games": 5,
  "log_level": 2,
  "log_file": "/var/log/gamemode.log",
  "nice": {
    "enabled": true,
    "value": 5
  },
  "io": {
    "enabled": false,
    "class": 1,
    "priority": 7
  },
  "renice": {
    "enabled": true,
    "value": -5
  },
  "reset_fpu": true
}
