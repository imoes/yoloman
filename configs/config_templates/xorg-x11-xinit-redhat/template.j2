# ============================================================================
# /etc/X11/Xmodmap
# ============================================================================
# Global Xmodmap file -- used by both xdm and xinit (startx).
#
# This file maps keycodes to keysyms, allowing for custom keyboard layouts.
#
# WARNING: Keycode and keysym remapping should generally be used ONLY if the
# X server config file has been configured to disable the XKEYBOARD extension.
# Modern X.org servers enable XKB by default, which often overrides this file.
#
# Syntax: keycode <keycode> = <keysym1> [<shift_keysym> [<mode_switch_keysym> ...]]
#
# See `man xmodmap` and `man xkeyboard-config` for details.
# ============================================================================

# --------------------------------------------------------------------------
# Legacy Key Remappings (Historical/Architecture Specific)
# --------------------------------------------------------------------------
# The following lines are commented out by default. They represent common
# historical mappings for different CPU architectures (i386, alpha, powerpc, sparc).
# Uncommenting these may conflict with your current keyboard layout or XKB settings.

! --- i386 and alpha ---
! keycode 22 = BackSpace
! keycode 107 = Delete

! --- powerpc ---
! keycode 59 = BackSpace
! keycode 125 = Delete

! --- sparc ---
! keycode 50 = BackSpace
! keycode 73 = Delete


# --------------------------------------------------------------------------
# Euro Sign Support
# --------------------------------------------------------------------------
# Enables Euro currency symbols on specific keys.
# Requires an appropriate locale (e.g., en_US.UTF-8) and keyboard layout.

! keycode 26 = e E currency
! keycode 54 = c C cent
! keycode 113 = Mode_switch Mode_switch Multi_key
