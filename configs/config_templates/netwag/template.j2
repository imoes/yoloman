# netwag configuration file
# Location: /etc/netwag.conf
# This file is auto-generated by Ansible. Do not edit manually.

[General]
# Enable debug logging for troubleshooting. The root configuration object 'config' is required; if missing, the render fails.
{% set config = config | default({}) %}
# If 'config' is not provided, provide a minimal empty structure so individual fields don't fail.
debug: {{ (config | default({})).get('debug', false) | default(false) | lower }}

[Appearance]
# Window width in pixels
window_width: {{ (config | default({})).get('window_width', 800) | default(800) }}
# Window height in pixels
window_height: {{ (config | default({})).get('window_height', 600) | default(600) }}
# Language code for the GUI (e.g., en, pt, de)
language: {{ (config | default({})).get('language', 'en') | default('en') }}

[Netwox]
# Path to the netwox binary used by netwag
netwox_path: {{ (config | default({})).get('netwox_path', '/usr/bin/netwox') | default('/usr/bin/netwox') }}
# Enable or disable specific netwox tools in the interface
enabled_tools: {{ (config | default({})).get('enabled_tools', []) | default([]) | join(',') }}