{
  "lvm_daemon_path": "/usr/sbin/lvm",
  "enable_monitoring": true,
  "max_pending_calls": 100,
  "max_queue_size": 50,
  "operation_timeout": 30,
  "monitored_vgs": [
    "vg_data",
    "vg_backup"
  ],
  "log_level": "INFO",
  "log_file": "/var/log/lvm2-dbusd.log",
  "syslog_enabled": true,
  "dbus_service_name": "com.redhat.lvmdbusservice",
  "dbus_object_path": "/com/redhat/lvmdbus/Manager"
}
