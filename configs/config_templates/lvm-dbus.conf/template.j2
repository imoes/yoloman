[# LVM D-Bus daemon configuration]
[# This file controls the behavior of the lvm2-dbusd service]

[# Path to the LVM2 system daemon (lvm) binary]
LvmDaemonPath = "{{ lvm_daemon_path }}"

[# Enable or disable monitoring of LVM events via D-Bus]
EnableMonitoring = {{ enable_monitoring | lower }}

[# Maximum number of pending D-Bus method calls]
MaxPendingCalls = {{ max_pending_calls }}

[# Maximum number of LVM operations that can be queued]
MaxQueueSize = {{ max_queue_size }}

[# Timeout (in seconds) for LVM operations]
OperationTimeout = {{ operation_timeout }}

[# List of monitored LVM volume groups (empty list means all VGs are monitored)]
{% for vg in monitored_vgs %}MonitoredVGs = {{ vg }}
{% endfor %}

[# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL]
LogLevel = "{{ log_level }}"

[# Path to log file (empty string for stderr only)]
LogFile = "{{ log_file }}"

[# Enable or disable logging to syslog]
SyslogEnabled = {{ syslog_enabled | lower }}

[# D-Bus service name]
DBusServiceName = "{{ dbus_service_name }}"

[# D-Bus object path for LVM daemon]
DBusObjectPath = "{{ dbus_object_path }}"
