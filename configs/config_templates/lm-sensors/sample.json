{
  "chips": [
    {
      "name": "it87-*",
      "driver": "it87",
      "labels": [
        {
          "sensor": "in0",
          "label": "VCore"
        },
        {
          "sensor": "in2",
          "label": "3.3V"
        },
        {
          "sensor": "in3",
          "label": "5V"
        },
        {
          "sensor": "temp1",
          "label": "CPU Temp"
        },
        {
          "sensor": "fan1",
          "label": "CPU Fan"
        }
      ],
      "compute": [
        {
          "sensor": "in0",
          "from": "0 255",
          "to": "0 1.5"
        },
        {
          "sensor": "in2",
          "from": "0 255",
          "to": "0 4.08"
        },
        {
          "sensor": "in3",
          "from": "0 255",
          "to": "0 7.65"
        }
      ],
      "set": [
        {
          "type": "in",
          "name": "min",
          "value": "0.9"
        },
        {
          "type": "in",
          "name": "max",
          "value": "1.65"
        },
        {
          "type": "temp",
          "name": "max",
          "value": "80"
        },
        {
          "type": "fan",
          "name": "min",
          "value": "600"
        }
      ]
    },
    {
      "name": "nct6775-*",
      "driver": "nct6775",
      "labels": [
        {
          "sensor": "in0",
          "label": "VCC"
        },
        {
          "sensor": "in1",
          "label": "AVCC"
        },
        {
          "sensor": "temp1",
          "label": "System"
        },
        {
          "sensor": "temp2",
          "label": "CPU"
        },
        {
          "sensor": "fan1",
          "label": "Chassis"
        },
        {
          "sensor": "fan2",
          "label": "CPU"
        }
      ],
      "set": [
        {
          "type": "temp",
          "name": "max",
          "value": "75"
        },
        {
          "type": "temp",
          "name": "max_hyst",
          "value": "70"
        },
        {
          "type": "fan",
          "name": "min",
          "value": "400"
        }
      ]
    },
    {
      "name": "lm90-*",
      "driver": "lm90",
      "labels": [
        {
          "sensor": "temp1",
          "label": "Remote Temp"
        }
      ],
      "set": [
        {
          "type": "temp",
          "name": "max",
          "value": "60"
        }
      ]
    }
  ],
  "scan_all_i2c_buses": false,
  "includes": [
    "/etc/sensors.d/intel-nuc.conf",
    "/etc/sensors.d/mb1-additions.conf"
  ]
}
