{
  "db_file": "/var/lib/plocate/plocate.db",
  "update_interval": 7,
  "prune_paths": [
    "/tmp",
    "/var/tmp",
    "/dev",
    "/proc",
    "/sys"
  ],
  "prunefs": [
    "proc",
    "sysfs",
    "fusectl",
    "debugfs",
    "devpts",
    "rpc_pipefs",
    "securityfs",
    "cgroup"
  ],
  "nodirs": [
    ""
  ],
  "cron_daily_update": true,
  "update_at_boot": false,
  "db_compression": "gzip",
  "updatedb_opts": [
    "--localpaths",
    "/"
  ]
}
