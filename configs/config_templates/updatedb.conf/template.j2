# Location of the locate database file
DB_FILE={{ db_file }}

# Time in days before the database is updated (0 = disabled)
UPDATE_INTERVAL={{ update_interval }}

# Paths to include in the database (space-separated)
PRUNE_PATHS="{{ prune_paths | join(' ') }}"

# Filesystems to include (space-separated); empty = all
PRUNEFS="{{ prunefs | join(' ') }}"

# Filesystems to exclude (space-separated)
NODIRS="{{ nodirs | join(' ') }}"

# Enable or disable daily locate database update via cron
CRON_DAILY_UPDATE={{ cron_daily_update }}

# Enable or disable automatic database updates at boot
UPDATE_AT_BOOT={{ update_at_boot }}

# Compression program for the database; use 'none' for uncompressed
DB_COMPRESSION={{ db_compression }}

# Additional options passed to updatedb (if supported)
UPDATEDB_OPTS="{{ updatedb_opts | join(' ') }}"
