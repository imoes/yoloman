{
  "bind_listen_on_ipv4": "127.0.0.1",
  "bind_listen_on_ipv6": "::1",
  "bind_directory": "/var/named",
  "bind_dump_file": "/var/named/data/cache_dump.db",
  "bind_statistics_file": "/var/named/data/named_stats.txt",
  "bind_memstatistics_file": "/var/named/data/named_mem_stats.txt",
  "bind_secroots_file": "/var/named/data/named.secroots",
  "bind_recursing_file": "/var/named/data/named.recursing",
  "bind_allow_query": "localhost",
  "bind_recursion": true,
  "bind_dnssec_validation": true,
  "bind_managed_keys_directory": "/var/named/dynamic",
  "bind_geoip_directory": "/usr/share/GeoIP",
  "bind_pid_file": "/run/named/named.pid",
  "bind_session_keyfile": "/run/named/session.key"
}
