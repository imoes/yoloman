//
// named.conf
//
// Provided by Red Hat bind package to configure the ISC BIND named(8) DNS
// server as a caching only nameserver (as a localhost DNS resolver only).
//
// See /usr/share/doc/bind*/sample/ for example named configuration files.
//

options {{ options | default('{') }}
	listen-on {{ listen_on | default('port 53 { 127.0.0.1; };') }}
	listen-on-v6 {{ listen_on_v6 | default('port 53 { ::1; };') }}
	directory 	{{ working_directory | default('"/var/named";') }}
	dump-file 	{{ dump_file | default('"/var/named/data/cache_dump.db";') }}
	statistics-file {{ stats_file | default('"/var/named/data/named_stats.txt";') }}
	memstatistics-file {{ memstatistics_file | default('"/var/named/data/named_mem_stats.txt";') }}
	secroots-file	{{ secroots_file | default('"/var/named/data/named.secroots";') }}
	recursing-file	{{ recursing_file | default('"/var/named/data/named.recursing";') }}
	allow-query     {{ allow_query | default('{ localhost; };') }}

	/* 
	 - If you are building an AUTHORITATIVE DNS server, do NOT enable recursion.
	 - If you are building a RECURSIVE (caching) DNS server, you need to enable 
	   recursion. 
	 - If your recursive DNS server has a public IP address, you MUST enable access 
	   control {{ control | default('to limit queries to your legitimate users. Failing to do so will') }}
	   cause {{ cause | default('your server to become part of large scale DNS amplification') }}
	   attacks. {{ attacks_ | default('Implementing BCP38 within your network would greatly') }}
	   reduce {{ reduce | default('such attack surface') }}
	*/
	recursion {{ recursion | default('yes;') }}

	dnssec-validation {{ dnssec_validation | default('yes;') }}

	managed-keys-directory {{ managed_keys_directory | default('"/var/named/dynamic";') }}
	geoip-directory {{ geoip_directory | default('"/usr/share/GeoIP";') }}

	pid-file {{ pid_file | default('"/run/named/named.pid";') }}
	session-keyfile {{ session_keyfile | default('"/run/named/session.key";') }}

	/* https://fedoraproject.org/wiki/Changes/CryptoPolicy */
	include "/etc/crypto-policies/back-ends/bind.config";
};

logging {{ logging | default('{') }}
        channel {{ channel | default('default_debug {') }}
                file "data/named.run";
                severity {{ severity | default('dynamic;') }}
        };
};

zone {{ zone | default('"." IN {') }}
	type {{ type | default('hint;') }}
	file "named.ca";
};

include "/etc/named.rfc1912.zones";
include "/etc/named.root.key";

