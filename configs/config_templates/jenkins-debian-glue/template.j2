# =============================================================================
# jenkins-debian-glue Configuration
# =============================================================================
# This file configures the jenkins-debian-glue tool, which automates Debian
# package building and repository management within Jenkins pipelines.
# It uses a simple KEY=VALUE format. Lines beginning with '#' are comments.
# =============================================================================

# -----------------------------------------------------------------------------
# GnuPG Signing Key
# -----------------------------------------------------------------------------
# GnuPG ID used for signing the reprepro repository (e.g. DEADBEEF).
# If building for older distributions like Squeeze, this MUST be set.
# Default: None (commented out)
{% if KEY_ID is defined and KEY_ID is not none and KEY_ID | length > 0 %}
{% if KEY_ID is defined and KEY_ID is not none and (KEY_ID is number or KEY_ID is boolean or KEY_ID | length > 0) %}KEY_ID={{ KEY_ID }}{% else %}# KEY_ID={% endif %}
{% else %}
# KEY_ID=
{% endif %}

# -----------------------------------------------------------------------------
# Trunk Repository
# -----------------------------------------------------------------------------
# Repository name to copy built packages to, creating a central trunk repository.
# This allows maintaining a "stable" or "latest" repo separate from specific versions.
# Default: None (commented out)
{% if TRUNK_RELEASE is defined and TRUNK_RELEASE is not none and TRUNK_RELEASE | length > 0 %}
{% if TRUNK_RELEASE is defined and TRUNK_RELEASE is not none and (TRUNK_RELEASE is number or TRUNK_RELEASE is boolean or TRUNK_RELEASE | length > 0) %}TRUNK_RELEASE={{ TRUNK_RELEASE }}{% else %}# TRUNK_RELEASE='release-trunk'{% endif %}
{% else %}
# TRUNK_RELEASE='release-trunk'
{% endif %}

# -----------------------------------------------------------------------------
# Main Architecture
# -----------------------------------------------------------------------------
# Architecture on which to build 'Architecture: all' packages.
# Defaults to host architecture if unset. Useful for cross-compilation setups.
# Default: None (commented out)
{% if MAIN_ARCHITECTURE is defined and MAIN_ARCHITECTURE is not none and MAIN_ARCHITECTURE | length > 0 %}
{% if MAIN_ARCHITECTURE is defined and MAIN_ARCHITECTURE is not none and (MAIN_ARCHITECTURE is number or MAIN_ARCHITECTURE is boolean or MAIN_ARCHITECTURE | length > 0) %}MAIN_ARCHITECTURE="{{ MAIN_ARCHITECTURE }}"{% else %}# MAIN_ARCHITECTURE="amd64"{% endif %}
{% else %}
# MAIN_ARCHITECTURE="amd64"
{% endif %}

# -----------------------------------------------------------------------------
# Pbuilder Hook Directory
# -----------------------------------------------------------------------------
# Directory containing hook scripts for pbuilder/cowbuilder.
# Hooks are executed at various stages of the build process (e.g., before/after build).
# Default: /usr/share/jenkins-debian-glue/pbuilder-hookdir/
{% if PBUILDER_HOOKDIR is defined and PBUILDER_HOOKDIR is not none and PBUILDER_HOOKDIR | length > 0 %}
{% if PBUILDER_HOOKDIR is defined and PBUILDER_HOOKDIR is not none and (PBUILDER_HOOKDIR is number or PBUILDER_HOOKDIR is boolean or PBUILDER_HOOKDIR | length > 0) %}PBUILDER_HOOKDIR={{ PBUILDER_HOOKDIR }}{% else %}# PBUILDER_HOOKDIR=/usr/share/jenkins-debian-glue/pbuilder-hookdir/{% endif %}
{% else %}
# PBUILDER_HOOKDIR=/usr/share/jenkins-debian-glue/pbuilder-hookdir/
{% endif %}

# -----------------------------------------------------------------------------
# Pbuilder Configuration File
# -----------------------------------------------------------------------------
# Path to a user-specific pbuilder configuration file.
# See man pbuilder(8) for details on --configfile.
# Default: None (commented out, no user-specific config used)
{% if PBUILDER_CONFIG is defined and PBUILDER_CONFIG is not none and PBUILDER_CONFIG | length > 0 %}
{% if PBUILDER_CONFIG is defined and PBUILDER_CONFIG is not none and (PBUILDER_CONFIG is number or PBUILDER_CONFIG is boolean or PBUILDER_CONFIG | length > 0) %}PBUILDER_CONFIG={{ PBUILDER_CONFIG }}{% else %}# PBUILDER_CONFIG=/etc/jenkins/pbuilderrc{% endif %}
{% else %}
# PBUILDER_CONFIG=/etc/jenkins/pbuilderrc
{% endif %}

# -----------------------------------------------------------------------------
# Default Repository Base Directory
# -----------------------------------------------------------------------------
# Base directory for reprepro repositories.
# Can be overridden via the REPOSITORY variable on demand.
# Default: /srv/repository
{% if DEFAULT_REPOSITORY is defined and DEFAULT_REPOSITORY is not none and DEFAULT_REPOSITORY | length > 0 %}
{% if DEFAULT_REPOSITORY is defined and DEFAULT_REPOSITORY is not none and (DEFAULT_REPOSITORY is number or DEFAULT_REPOSITORY is boolean or DEFAULT_REPOSITORY | length > 0) %}DEFAULT_REPOSITORY='{{ DEFAULT_REPOSITORY }}'{% else %}# DEFAULT_REPOSITORY='/srv/repository'{% endif %}
{% else %}
# DEFAULT_REPOSITORY='/srv/repository'
{% endif %}

# -----------------------------------------------------------------------------
# Preserve Original Version
# -----------------------------------------------------------------------------
# If true, preserve the version number from the changelog without padding.
# By default, versions are padded with date and build number to ensure uniqueness.
# Default: false
{% if USE_ORIG_VERSION is defined and USE_ORIG_VERSION is not none and USE_ORIG_VERSION | length > 0 %}
{% if USE_ORIG_VERSION is defined and USE_ORIG_VERSION is not none and (USE_ORIG_VERSION is number or USE_ORIG_VERSION is boolean or USE_ORIG_VERSION | length > 0) %}USE_ORIG_VERSION={{ USE_ORIG_VERSION }}{% else %}# USE_ORIG_VERSION=true{% endif %}
{% else %}
# USE_ORIG_VERSION=false
{% endif %}

# -----------------------------------------------------------------------------
# Repository Keyring
# -----------------------------------------------------------------------------
# Path to the keyring file holding the public key for signing repositories.
# Required if REPOSITORY_KEYRING signing is enabled (mandatory for Squeeze+).
# Default: None (commented out)
{% if REPOSITORY_KEYRING is defined and REPOSITORY_KEYRING is not none and REPOSITORY_KEYRING | length > 0 %}
{% if REPOSITORY_KEYRING is defined and REPOSITORY_KEYRING is not none and (REPOSITORY_KEYRING is number or REPOSITORY_KEYRING is boolean or REPOSITORY_KEYRING | length > 0) %}REPOSITORY_KEYRING={{ REPOSITORY_KEYRING }}{% else %}# REPOSITORY_KEYRING=/etc/apt/trusted.gpg.d/my-custom-keyring.gpg{% endif %}
{% else %}
# REPOSITORY_KEYRING=/etc/apt/trusted.gpg.d/my-custom-keyring.gpg
{% endif %}

# -----------------------------------------------------------------------------
# Remove from Release Before Incoming
# -----------------------------------------------------------------------------
# If true, remove packages from a release repository before processing incoming.
# This allows rebuilding and providing versions that already exist in the release repo.
# Default: false
{% if REMOVE_FROM_RELEASE is defined and REMOVE_FROM_RELEASE is not none and REMOVE_FROM_RELEASE | length > 0 %}
{% if REMOVE_FROM_RELEASE is defined and REMOVE_FROM_RELEASE is not none and (REMOVE_FROM_RELEASE is number or REMOVE_FROM_RELEASE is boolean or REMOVE_FROM_RELEASE | length > 0) %}REMOVE_FROM_RELEASE={{ REMOVE_FROM_RELEASE }}{% else %}# REMOVE_FROM_RELEASE=false{% endif %}
{% else %}
# REMOVE_FROM_RELEASE=false
{% endif %}

# -----------------------------------------------------------------------------
# Keep Build Environment on Failure
# -----------------------------------------------------------------------------
# If true, keep a copy of the build environment on failure.
# The copy is stored in /var/cache/pbuilder/build/debug.$JOBNAME.
# Warning: Requires significant disk space.
# Default: false
{% if DEB_KEEP_BUILD_ENV is defined and DEB_KEEP_BUILD_ENV is not none and DEB_KEEP_BUILD_ENV | length > 0 %}
{% if DEB_KEEP_BUILD_ENV is defined and DEB_KEEP_BUILD_ENV is not none and (DEB_KEEP_BUILD_ENV is number or DEB_KEEP_BUILD_ENV is boolean or DEB_KEEP_BUILD_ENV | length > 0) %}DEB_KEEP_BUILD_ENV={{ DEB_KEEP_BUILD_ENV }}{% else %}# DEB_KEEP_BUILD_ENV=true{% endif %}
{% else %}
# DEB_KEEP_BUILD_ENV=false
{% endif %}

# -----------------------------------------------------------------------------
# Extra Repositories for Dependencies
# -----------------------------------------------------------------------------
# Comma-separated list of extra repositories for resolving dependencies.
# Example: 'deb http://security.debian.org/ wheezy/updates main,deb-src http://security.debian.org/ wheezy/updates main'
# Default: Empty string
{% if REPOSITORY_EXTRA is defined and REPOSITORY_EXTRA is not none and REPOSITORY_EXTRA | length > 0 %}
REPOSITORY_EXTRA='{{ REPOSITORY_EXTRA }}'
{% else %}
# REPOSITORY_EXTRA=''
{% endif %}

# -----------------------------------------------------------------------------
# Extra Repository Keys
# -----------------------------------------------------------------------------
# Comma-separated list of URLs with keys for extra repositories.
# Example: 'http://foorepo.domain.com/key1.gpg,http://barrepo.domain.com/key2.gpg'
# Default: Empty string
{% if REPOSITORY_EXTRA_KEYS is defined and REPOSITORY_EXTRA_KEYS is not none and REPOSITORY_EXTRA_KEYS | length > 0 %}
REPOSITORY_EXTRA_KEYS='{{ REPOSITORY_EXTRA_KEYS }}'
{% else %}
# REPOSITORY_EXTRA_KEYS=''
{% endif %}

# -----------------------------------------------------------------------------
# Autopkgtest Execution Mode
# -----------------------------------------------------------------------------
# Control autopkgtest execution: internal, external, all, or skip.
# - internal: Run tests inside cowbuilder (default)
# - external: Run tests externally (requires ADT_RUNNER)
# - all: Run both internal and external
# - skip: Disable all autopkgtests
# Default: external
{% if ADT is defined and ADT is not none and ADT | length > 0 %}
ADT='{{ ADT }}'
{% else %}
# ADT='external'
{% endif %}

# -----------------------------------------------------------------------------
# Use Eatmydata
# -----------------------------------------------------------------------------
# Control usage of eatmydata to speed up builds (true/false or auto).
# eatmydata disables fsync, speeding up I/O but risking data loss on crash.
# If 'auto' (or unset), it is enabled for recent distros if available.
# Default: true
{% if USE_EATMYDATA is defined and USE_EATMYDATA is not none and USE_EATMYDATA | length > 0 %}
{% if USE_EATMYDATA is defined and USE_EATMYDATA is not none and (USE_EATMYDATA is number or USE_EATMYDATA is boolean or USE_EATMYDATA | length > 0) %}USE_EATMYDATA={{ USE_EATMYDATA }}{% else %}# USE_EATMYDATA=true{% endif %}
{% else %}
# USE_EATMYDATA=true
{% endif %}

# -----------------------------------------------------------------------------
# Use Ccache
# -----------------------------------------------------------------------------
# Enable ccache for fast recompilation of C/C++ code.
# Default: true
{% if USE_CCACHE is defined and USE_CCACHE is not none and USE_CCACHE | length > 0 %}
{% if USE_CCACHE is defined and USE_CCACHE is not none and (USE_CCACHE is number or USE_CCACHE is boolean or USE_CCACHE | length > 0) %}USE_CCACHE={{ USE_CCACHE }}{% else %}# USE_CCACHE=true{% endif %}
{% else %}
# USE_CCACHE=true
{% endif %}

# -----------------------------------------------------------------------------
# Timestamp Format
# -----------------------------------------------------------------------------
# Format string for the generated build timestamp.
# Uses the 'date' command format.
# Default: None (commented out, uses standard format)
{% if TIMESTAMP_FORMAT is defined and TIMESTAMP_FORMAT is not none and TIMESTAMP_FORMAT | length > 0 %}
{% if TIMESTAMP_FORMAT is defined and TIMESTAMP_FORMAT is not none and (TIMESTAMP_FORMAT is number or TIMESTAMP_FORMAT is boolean or TIMESTAMP_FORMAT | length > 0) %}TIMESTAMP_FORMAT="{{ TIMESTAMP_FORMAT }}"{% else %}# TIMESTAMP_FORMAT="%Y%m%d%H%M%S"{% endif %}
{% else %}
# TIMESTAMP_FORMAT="%Y%m%d%H%M%S"
{% endif %}

# -----------------------------------------------------------------------------
# Unreleased Append Commit
# -----------------------------------------------------------------------------
# If true, append SCM commit to version number even if marked UNRELEASED.
# This ensures unique versions even when the changelog says "unreleased".
# Default: false
{% if UNRELEASED_APPEND_COMMIT is defined and UNRELEASED_APPEND_COMMIT is not none and UNRELEASED_APPEND_COMMIT | length > 0 %}
{% if UNRELEASED_APPEND_COMMIT is defined and UNRELEASED_APPEND_COMMIT is not none and (UNRELEASED_APPEND_COMMIT is number or UNRELEASED_APPEND_COMMIT is boolean or UNRELEASED_APPEND_COMMIT | length > 0) %}UNRELEASED_APPEND_COMMIT={{ UNRELEASED_APPEND_COMMIT }}{% else %}# UNRELEASED_APPEND_COMMIT=false{% endif %}
{% else %}
# UNRELEASED_APPEND_COMMIT=false
{% endif %}