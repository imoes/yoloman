{
  "bind": "127.0.0.1 ::1",
  "port": 6379,
  "daemonize": "yes",
  "supervised": "systemd",
  "pidfile": "/var/run/redis/redis-server.pid",
  "loglevel": "notice",
  "logfile": "/var/log/redis/redis-server.log",
  "databases": 16,
  "save_rules": [
    [
      900,
      1
    ],
    [
      300,
      10
    ]
  ],
  "maxmemory": "256mb",
  "maxmemory_policy": "allkeys-lru",
  "requirepass": "",
  "appendonly": "yes",
  "appendfilename": "appendonly.aof"
}
