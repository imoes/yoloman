{
  "bind": {
    "type": "string",
    "default": "127.0.0.1 ::1",
    "description": "IP addresses Redis will bind to"
  },
  "port": {
    "type": "number",
    "default": 6379,
    "description": "TCP port for Redis to listen on"
  },
  "daemonize": {
    "type": "string",
    "default": "yes",
    "description": "Whether to run as a daemon; must match Redis expectations (e.g., 'yes'/'no')"
  },
  "supervised": {
    "type": "string",
    "default": "systemd",
    "description": "Supervision mode: 'no', 'systemd', 'upstart', 'auto'"
  },
  "pidfile": {
    "type": "string",
    "default": "/var/run/redis/redis-server.pid",
    "description": "Path to PID file"
  },
  "loglevel": {
    "type": "string",
    "default": "notice",
    "description": "Log verbosity: 'debug', 'verbose', 'notice', 'warning'"
  },
  "logfile": {
    "type": "string",
    "default": "/var/log/redis/redis-server.log",
    "description": "Path to log file"
  },
  "databases": {
    "type": "number",
    "default": 16,
    "description": "Number of databases"
  },
  "save_rules": {
    "type": "list",
    "default": [
      [
        900,
        1
      ],
      [
        300,
        10
      ]
    ],
    "description": "List of [seconds, changes] pairs for RDB snapshot triggers"
  },
  "maxmemory": {
    "type": "string",
    "default": "256mb",
    "description": "Maximum memory limit (e.g., '256mb', '1gb')"
  },
  "maxmemory_policy": {
    "type": "string",
    "default": "allkeys-lru",
    "description": "Eviction policy when maxmemory is reached"
  },
  "requirepass": {
    "type": "string",
    "default": "",
    "description": "Password required for clients to authenticate (empty = no auth)"
  },
  "appendonly": {
    "type": "string",
    "default": "yes",
    "description": "Enable AOF persistence ('yes'/'no')"
  },
  "appendfilename": {
    "type": "string",
    "default": "appendonly.aof",
    "description": "Filename for AOF log"
  }
}
