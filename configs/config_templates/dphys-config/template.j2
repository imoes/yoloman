# /etc/cron.d/{{ cron_file | default('dphys-config') }} - nightly trigger automatic config updates
# Filename of the cron.d file under /etc/cron.d/
# authors {{ authors | default('dsbg and franklin') }}, last modification {{ last_modification | default('2006.09.15') }}
# List of authors mentioned in the header comment
# Last modification date in the header comment
# copyright {{ copyright_holder | default('ETH Zuerich Physics Departement') }}
# Copyright holder mentioned in the header comment
#   use under either modified/non-advertising BSD or GPL license

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# daily early morning autoupgrade of config files of our systems
#   after {{ start_hour | default('3') }}:{{ start_minute | default('0') }}, when users are assumed to be least active
# Hour (24h format) when the job starts (before which it should finish)
# Minute when the job starts
#   before {{ end_hour | default('4') }}:{{ end_minute | default('0') }} so that finished long before {{ admin_service | default('dphys-admin') }} starts
# Hour (24h format) by which the job should finish
# Minute by which the job should finish
# Service name that starts after the cron job should finish
#     by 1 hour, because random sleep 0..{{ max_random_delay_minutes | default('59') }}min to spread load on pkg server
# Maximum random delay (in minutes) to spread load
# Cron scheduling line:
#   minute: {{ minute | default('0') }}  hour: {{ start_hour | default('3') }}  day-of-month: *  month: *  day-of-week: *
#   user: {{ user | default('root') }}
#   command: check config_file_path exists and binary_path is executable, then run binary with 'cron' argument
# Cron minute field for scheduling
# User under which the cron job runs
# Path to the config file to check for existence
# Full path to the dphys-config binary
{{ minute | default('0') }} {{ start_hour | default('3') }} * * *	{{ user | default('root') }}	[ -f {{ config_file_path | default('/etc/dphys-config') }} -a -x {{ binary_path | default('/usr/bin/dphys-config') }} ] && {{ binary_path | default('/usr/bin/dphys-config') }} cron > /dev/null 2>&1