# /etc/cron.d/cedar-backup3
#
# Cedar Backup 3 Cron Configuration
# =================================
# This template configures the cron jobs for Cedar Backup 3.
# The backup strategy is determined by the role this machine plays in the Cedar
# infrastructure: Single Machine (standalone), Client, or Master.
#
# Roles:
# - Single: A standalone machine that performs all backup operations locally.
# - Client: A machine that collects data and sends it to a Master.
# - Master: A machine that receives data from Clients, stages, stores, and purges backups.
#
# Instructions:
# Uncomment the section corresponding to your deployment role.
# Ensure only one section is active to prevent conflicting jobs.

# =================================
# Single Machine Configuration
# =================================
# Use this section if the machine is the only one in the pool and handles
# all backup tasks (collect, stage, store, purge) locally.
# Cron schedule for the 'all' task on a single machine.
# Default: 00:30 every day
{{ cron_schedule_single | default('30 00 * * *') }} root /usr/bin/cback3 all

# =================================
# Client Machine Configuration
# =================================
# Use this section if the machine is a client that sends backups to a Master.
# It only collects local data and purges old local collections.

# Cron schedule for collecting data on the client machine.
# Default: 00:30 every day
#{{ cron_schedule_client_collect | default('30 00 * * *') }} root /usr/bin/cback3 collect

# Cron schedule for purging old collected data on the client machine.
# Default: 06:30 every day
#{{ cron_schedule_client_purge | default('30 06 * * *') }} root /usr/bin/cback3 purge

# =================================
# Master Machine Configuration
# =================================
# Use this section if the machine is the central backup server.
# It receives data from Clients, stages it, stores it to final media, and purges old backups.

# Cron schedule for collecting/receiving data from clients on the master machine.
# Default: 00:30 every day
#{{ cron_schedule_master_collect | default('30 00 * * *') }} root /usr/bin/cback3 collect

# Cron schedule for staging data on the master machine (preparing for final storage).
# Default: 02:30 every day
#{{ cron_schedule_master_stage | default('30 02 * * *') }} root /usr/bin/cback3 stage

# Cron schedule for storing data to final media on the master machine.
# Default: 04:30 every day
#{{ cron_schedule_master_store | default('30 04 * * *') }} root /usr/bin/cback3 store

# Cron schedule for purging old backups on the master machine.
# Default: 06:30 every day
#{{ cron_schedule_master_purge | default('30 06 * * *') }} root /usr/bin/cback3 purge
