{
  "sudo_groups": [
    {
      "name": "wheel",
      "full_access": true,
      "commands": []
    },
    {
      "name": "developers",
      "full_access": false,
      "commands": [
        "/usr/bin/systemctl",
        "/usr/bin/docker",
        "/usr/local/bin/build"
      ]
    }
  ],
  "include_sudoers_d": true,
  "enable_passwd_prompt": true,
  "enable_logging": true
}
