{
  "debug": {
    "enabled": false,
    "logfile": "",
    "loglevel": "error"
  },
  "hook_script": "/usr/local/bin/gphoto2-hook.sh",
  "quiet": true,
  "verbose": false,
  "filename_pattern": "%Y%m%d_%H%M%S_%n.%C",
  "filenumber_start": 1,
  "usbid_rules": [
    {
      "detected": "0x4a9:0x306b",
      "treated_as": "0x4a9:0x306c"
    }
  ],
  "camera_model": "Canon EOS 5D Mark IV",
  "port": "usb:001,003",
  "speed": 9600,
  "folder": "/store_00010001/DCIM",
  "recurse": true,
  "capture_keep": false,
  "capture_keep_raw": true,
  "capture_frames": 10,
  "capture_interval": 60,
  "capture_reset_interval": true,
  "capture_tethered": "10, 1"
}
