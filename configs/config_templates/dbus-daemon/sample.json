{
 "apparmor_mode": "enabled",
 "auth_mechanisms": [
  "EXTERNAL"
 ],
 "fork": true,
 "include_dir": "/etc/dbus-1/system.d",
 "include_dir_ignore_missing": true,
 "limits": {
  "max_completed_connections": 512,
  "max_message_size": 64,
  "service_start_timeout": 30000
 },
 "listen_addresses": [
  "unix:path=/var/run/dbus/system_bus_socket",
  "unix:abstract=/dbus/system_bus_socket"
 ],
 "pidfile": "/run/dbus/pid",
 "policies": [
  {
   "context": "default",
   "rules": [
    {
     "attrs": {
      "send_destination": "org.freedesktop.DBus",
      "send_interface": "org.freedesktop.DBus.Introspectable",
      "send_member": "Introspect",
      "send_requested_reply": "false"
     },
     "type": "deny"
    },
    {
     "attrs": {
      "send_destination": "org.freedesktop.DBus",
      "send_interface": "org.freedesktop.DBus.Introspectable",
      "send_member": "Introspect",
      "send_requested_reply": "true"
     },
     "type": "allow"
    },
    {
     "attrs": {
      "send_destination": "org.freedesktop.DBus",
      "send_interface": "org.freedesktop.DBus.Peer",
      "send_member": "Ping"
     },
     "type": "allow"
    }
   ]
  }
 ],
 "run_as_user": "messagebus",
 "selinux_associations": [
  {
   "context": "system_dbusd_t",
   "name": "org.freedesktop.hostname1"
  }
 ],
 "selinux_enabled": true,
 "servicehelper": "/usr/lib/dbus-1.0/dbus-daemon-launch-helper",
 "standard_system_servicedirs": true,
 "type": "system"
}
