# bashbro service configuration
# This template configures the bashbro HTTP server.
# Each section corresponds to a specific field in the package schema.

# Port to listen on (integer, e.g., 5555)
# Schema field: port
# Default: 8080
PORT={{ (port | default(8080)) }}

# Jail root directory (string, e.g., /srv/bashbro or empty for no jail)
# Schema field: jail_root
# Default: ''
JAIL_ROOT={{ jail_root | default('') }}

# Verbose output flag (boolean: true/false)
# Schema field: verbose
# Default: false
VERBOSE={{ verbose | default(false) | ternary('true', 'false') }}