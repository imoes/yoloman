# GlusterFS management daemon configuration
# Generated by glusterfs-server installer; site-specific values below.
volume management
  type management/glusterd
  working-directory {{ glusterd_working_dir }}
  transport.socket.listen-port {{ glusterd_listen_port }}
  option transport-type {{ glusterd_transport_type }}
  option transport.socket.bind-address {{ glusterd_bind_address }}
{% for option_name, option_value in glusterd_options.items() %}  option {{ option_name }} {{ option_value }}
{% endfor %}
end-volume

# Brick volumes defined separately in /etc/glusterfs/*.vol
