# =============================================================================
# GlusterFS Server Configuration Template
# =============================================================================
# This template configures the GlusterFS management daemon (glusterd).
# It is self-documenting: every variable is sourced from the role schema
# with safe defaults to prevent render failures or incorrect behavior.
# =============================================================================

# ------------------------------------------------------------------------------
# glusterd_log_file: Path to the GlusterFS management daemon log file.
# Default: /var/log/glusterfs/glusterd.log
# ------------------------------------------------------------------------------
LOG_FILE='{{ glusterd_log_file | default("/var/log/glusterfs/glusterd.log") }}'

# ------------------------------------------------------------------------------
# glusterd_log_level: Logging level for the GlusterFS management daemon.
# Allowed values typically include: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Default: INFO
# ------------------------------------------------------------------------------
LOG_LEVEL='{{ glusterd_log_level | default("INFO") }}'

# ------------------------------------------------------------------------------
# glusterd_options: Additional key-value configuration options for the management daemon.
# This is a raw string of options passed to glusterd.
# Examples: 'rpc-auth-allow-insecure on' or 'cli-timeout 10'.
# Leave empty if no extra options are required.
# Default: '' (empty string)
# ------------------------------------------------------------------------------
GLUSTERD_OPTIONS='{{ glusterd_options | default("") }}'