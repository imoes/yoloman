{
  "ldap_uris": [
    "ldap://ldap.example.com"
  ],
  "ldap_base": "dc=example,dc=com",
  "ldap_version": 3,
  "ldap_bind_dn": "",
  "ldap_bind_pw": "",
  "ldap_scope": "sub",
  "tls_cacertdir": "",
  "tls_cacertfile": "",
  "tls_reqcert": "demand",
  "timelimit": 30,
  "scope_search_timeout": 10,
  "reconnect_retry": "3 30 120 600",
  "nss_map_passwd": "uid uidNumber cn gecos homeDirectory loginShell",
  "nss_map_group": "cn memberUid gidNumber",
  "nss_map_shadow": "uid userPassword shadowLastChange shadowMax shadowWarning",
  "user_filter": "objectClass=posixAccount",
  "group_filter": "objectClass=posixGroup",
  "shadow_filter": "objectClass=shadowAccount",
  "pam_login_attribute": "uid",
  "pam_filter": "",
  "nss_initgroups_ignoreusers": [
    "root",
    "nobody"
  ],
  "nss_min_uid": 1000,
  "nss_max_uid": 0,
  "nslcd_ssl": "off",
  "sasl_mech": "",
  "k5start_start": "yes",
  "k5start_bin": "/usr/bin/k5start",
  "k5start_keytab": "/etc/krb5.keytab",
  "k5start_ccrefresh": 60,
  "k5start_principal": "host/$(hostname -f)"
}
