{
  "ldap_uris": [
    "ldap://ldap.example.com",
    "ldaps://ldap-backup.example.com"
  ],
  "ldap_base": "ou=users,dc=example,dc=com",
  "ldap_version": 3,
  "ldap_bind_dn": "cn=dirmanager,dc=example,dc=com",
  "ldap_bind_pw": "secret_password_here",
  "ldap_scope": "sub",
  "tls_cacertdir": "/etc/ssl/certs",
  "tls_reqcert": "demand",
  "timelimit": 60,
  "scope_search_timeout": 30,
  "reconnect_retry": "3 30 600 3600",
  "nss_map_passwd": "uid uidNumber cn homeDirectory /bin/bash",
  "nss_map_group": "cn memberUid gidNumber",
  "nss_map_shadow": "uid userPassword",
  "user_filter": "(&(objectClass=posixAccount)(memberOf=cn=sysusers,ou=groups,dc=example,dc=com))",
  "group_filter": "objectClass=posixGroup",
  "pam_login_attribute": "uid",
  "pam_filter": "(memberOf=cn=sysusers,ou=groups,dc=example,dc=com)",
  "nss_initgroups_ignoreusers": [
    "root",
    "nobody",
    "nslcd"
  ],
  "nss_min_uid": 1000,
  "nss_max_uid": 65534,
  "nslcd_ssl": "start_tls",
  "pam_authc_search_base": "ou=authc,dc=example,dc=com"
}
