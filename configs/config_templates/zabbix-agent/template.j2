# Logrotate configuration for Zabbix Agent daemon logs.
# Managed by Ansible. Do not edit manually.

/var/log/zabbix-agent/zabbix_agentd.log {
    # Rotate logs weekly.
    weekly

    # Keep 7 rotated log files.
    rotate 7

    # Compress old log files using gzip to save disk space.
    compress

    # Delay compression of the most recent rotated file until the next rotation cycle.
    # This ensures the previously compressed file is fully closed and safe.
    delaycompress

    # Do not produce an error if the log file is missing.
    missingok

    # Do not rotate the log if it is empty.
    notifempty

    # Create new log files with these permissions, owned by the zabbix user and group.
    # Defaults are taken from the schema: zabbix_agent_user='zabbix', zabbix_agent_group='zabbix'.
    create 0640 {{ zabbix_agent_user | default('zabbix') }} {{ zabbix_agent_group | default('zabbix') }}

    # Run the postrotate script only once for all log files (if multiple matched).
    sharedscripts

    # Reload the Zabbix Agent to reopen log files after rotation.
    # Checks for the PID file to ensure the service is running before sending the signal.
    postrotate
        [ -e /run/zabbix/zabbix_agentd.pid ] && invoke-rc.d zabbix-agent force-reload >/dev/null || true
    endscript
}
