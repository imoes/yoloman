# =============================================================================
# Configuration file for aoetools (AoE - ATA over Ethernet client tools)
# =============================================================================
#
# NOTE: This file is NOT READ by systemd services directly. It is intended
#       for use by shell scripts or init systems that source this configuration.
#
# WARNING: All the following settings are interpolated in the shell.
#          Do NOT configure anything that contains shell syntax (e.g., semicolons).
#          Values are expected to be simple strings or space-separated lists.
# =============================================================================

# -------------------------------------------------------------------------
# Field: interfaces
# Description: List of network interfaces to restrict AoE discovery to.
#              Space-separated list (e.g., 'eth0 eth1').
#              Use 'none' to disable discovery entirely.
#              Use '' (empty) or leave unset to use all interfaces.
# -------------------------------------------------------------------------
# If interfaces is defined, not none, and has content, use it.
# Otherwise default to empty string for "all interfaces".
INTERFACES='{{ (interfaces | default('')) | string }}'

# -------------------------------------------------------------------------
# Field: raid_arrays
# Description: Space-separated list of RAID arrays to activate after AoE
#              volumes are ready. Do NOT include the /dev/ prefix.
#              Example: 'md0 md1'
# -------------------------------------------------------------------------
RAID_ARRAYS='{{ raid_arrays | default('') | string }}'

# -------------------------------------------------------------------------
# Field: lvm_groups
# Description: Space-separated list of LVM2 volume groups to activate
#              after AoE volumes are ready.
# -------------------------------------------------------------------------
LVMGROUPS='{{ (lvm_groups | default('')) | string }}'

# -------------------------------------------------------------------------
# Field: aoemounts
# Description: Space-separated list of file systems to mount over AoE.
#              Note: Entries in /etc/fstab containing '/dev/etherd/' are
#              auto-included by the mounting script, so this list is
#              primarily for explicit mounts not in fstab.
# -------------------------------------------------------------------------
AOEMOUNTS='{{ aoemounts | default('') | string }}'
