{
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Logging level: off, error, warn, info, debug, debug2, debug3, debug4",
    "enum": [
      "off",
      "error",
      "warn",
      "info",
      "debug",
      "debug2",
      "debug3",
      "debug4"
    ]
  },
  "log_file": {
    "type": "string",
    "default": "",
    "description": "Path to log file. Empty string means STDOUT."
  },
  "log_append": {
    "type": "bool",
    "default": false,
    "description": "Append to log file instead of overwriting."
  },
  "modpath": {
    "type": "list",
    "default": [],
    "description": "List of directories to search for YANG/YIN modules. Colon-separated in config."
  },
  "subdirs": {
    "type": "bool",
    "default": true,
    "description": "Search subdirectories in modpath."
  },
  "output_file": {
    "type": "string",
    "default": "",
    "description": "Output file path for translations. Empty means STDOUT/defname."
  },
  "format": {
    "type": "string",
    "default": "",
    "description": "Translation format: xsd, html, yang, copy, yin, c, h, uc, uh, yc, yh. Empty for validation only.",
    "enum": [
      "xsd",
      "html",
      "yang",
      "copy",
      "yin",
      "c",
      "h",
      "uc",
      "uh",
      "yc",
      "yh"
    ]
  },
  "modules": {
    "type": "list",
    "default": [],
    "description": "List of YANG module names or file paths to process."
  },
  "subtrees": {
    "type": "list",
    "default": [],
    "description": "List of directory paths to process recursively."
  },
  "unified": {
    "type": "bool",
    "default": false,
    "description": "Process submodules unified with main module."
  },
  "defnames": {
    "type": "bool",
    "default": false,
    "description": "Use default filenames for output."
  },
  "versionnames": {
    "type": "bool",
    "default": true,
    "description": "Include version string in default filenames."
  },
  "indent": {
    "type": "number",
    "default": 2,
    "description": "Indentation spaces (0-9)."
  },
  "stats": {
    "type": "string",
    "default": "none",
    "description": "Statistics reporting level: none, brief, basic, advanced, all.",
    "enum": [
      "none",
      "brief",
      "basic",
      "advanced",
      "all"
    ]
  },
  "totals": {
    "type": "string",
    "default": "none",
    "description": "Summary statistics mode: none, summary, summary-only.",
    "enum": [
      "none",
      "summary",
      "summary-only"
    ]
  },
  "deviations": {
    "type": "list",
    "default": [],
    "description": "List of deviation module names to apply."
  },
  "features_enable": {
    "type": "list",
    "default": [],
    "description": "List of features to enable (module:feature)."
  },
  "features_disable": {
    "type": "list",
    "default": [],
    "description": "List of features to disable (module:feature)."
  },
  "features_static": {
    "type": "list",
    "default": [],
    "description": "List of static features (module:feature)."
  },
  "features_dynamic": {
    "type": "list",
    "default": [],
    "description": "List of dynamic features (module:feature)."
  },
  "feature_code_default": {
    "type": "string",
    "default": "dynamic",
    "description": "Default feature code generation: dynamic, static, false.",
    "enum": [
      "dynamic",
      "static",
      "false"
    ]
  },
  "feature_enable_default": {
    "type": "bool",
    "default": true,
    "description": "Enable features by default."
  },
  "objview": {
    "type": "string",
    "default": "raw",
    "description": "Object view mode: raw, cooked.",
    "enum": [
      "raw",
      "cooked"
    ]
  },
  "html_toc": {
    "type": "string",
    "default": "menu",
    "description": "HTML ToC mode: none, plain, menu.",
    "enum": [
      "none",
      "plain",
      "menu"
    ]
  },
  "html_div": {
    "type": "bool",
    "default": false,
    "description": "Output single <div> for HTML."
  },
  "simurls": {
    "type": "bool",
    "default": false,
    "description": "Use simplified URL format for HTML."
  },
  "urlstart": {
    "type": "string",
    "default": "",
    "description": "Base URL for HREF links."
  },
  "xsd_schemaloc": {
    "type": "string",
    "default": "",
    "description": "Base URL for XSD schemaLocation."
  },
  "yuma_home": {
    "type": "string",
    "default": "",
    "description": "Yuma project root directory."
  },
  "warn_idlen": {
    "type": "number",
    "default": 64,
    "description": "Identifier length warning threshold."
  },
  "warn_linelen": {
    "type": "number",
    "default": 72,
    "description": "Line length warning threshold."
  },
  "warn_off": {
    "type": "list",
    "default": [],
    "description": "List of warning numbers (400-899) to suppress."
  },
  "show_identifiers": {
    "type": "bool",
    "default": false,
    "description": "Report object identifiers."
  },
  "show_tree_identifiers": {
    "type": "bool",
    "default": false,
    "description": "Report tree identifiers."
  },
  "show_dependencies": {
    "type": "bool",
    "default": false,
    "description": "Report dependencies."
  },
  "show_exports": {
    "type": "bool",
    "default": false,
    "description": "Report exports."
  },
  "show_modversion": {
    "type": "bool",
    "default": false,
    "description": "Report module version info."
  }
}
