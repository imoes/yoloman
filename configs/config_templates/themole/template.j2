# Themole Configuration
# The target URL including parameters to be scanned.
# This is the endpoint that will be probed for SQL injection vulnerabilities.
-u {{ url | default('http://example.com/page?id=1') }}

# Needle string indicating a successful injection (true positive).
# This string appears in the response when the injection is successful and disappears when it fails.
# It is used by the scanner to confirm that a payload was executed.
-n {{ needle | default('Success') }}

# Maximum number of concurrent threads/requests.
# Controls the level of parallelism for the scanning process.
# Higher values speed up scanning but may trigger rate limits or cause instability.
-t {{ threads | default(4) }}