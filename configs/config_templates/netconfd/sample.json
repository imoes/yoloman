{
  "enable_ssh": true,
  "ssh_listen_address": "0.0.0.0",
  "ssh_listen_port": 830,
  "ssh_host_key_file": "/etc/ssh/ssh_host_ed25519_key",
  "enable_tls": true,
  "tls_listen_address": "0.0.0.0",
  "tls_listen_port": 6513,
  "tls_server_cert_file": "/etc/netconf/tls/server.crt",
  "tls_server_key_file": "/etc/netconf/tls/server.key",
  "tls_ca_cert_file": "/etc/netconf/tls/ca.crt",
  "auth_method": "key-based",
  "allowed_users": [
    {
      "name": "netconf"
    },
    {
      "name": "admin"
    }
  ],
  "lock_timeout": 300,
  "max_sessions": 5,
  "enable_nmda": true,
  "with_defaults_mode": "report-all-tagged",
  "yang_module_paths": [
    "/usr/share/yang/standard",
    "/usr/share/yang/ietf",
    "/etc/yang/vendor"
  ],
  "custom_rpcs": [
    {
      "name": "Cisco IOS-XE diagnostics",
      "module": "cisco-xe-diagnostics",
      "path": "/etc/yang/vendor/cisco-xe-diagnostics.yang"
    }
  ],
  "log_level": "warning",
  "log_file": "/var/log/netconfd/netconfd.log"
}
