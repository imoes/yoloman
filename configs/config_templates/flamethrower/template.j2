################################################################################
#
# GLOBAL SETTINGS
#
################################################################################

# Whether to start the flamethrower daemon for multicast installs.
# Default: yes
START_FLAMETHROWER_DAEMON = {{ start_flamethrower_daemon | default('yes') }}

# Port number where the Flamethrower configuration database can be found on the server.
# Default: 9000
FLAMETHROWER_DIRECTORY_PORTBASE = {{ flamethrower_directory_portbase | default('9000') }}

# Network interface used to send data.
# Default: lo
INTERFACE = {{ interface | default('lo') }}

# Maximum bandwidth limit for udpcast (e.g. '20M', '1000k').
# Default: 20M
MAX_BITRATE = {{ max_bitrate | default('20M') }}

# Whether all connections between clients and server are full-duplex.
# Default: off
FULL_DUPLEX = {{ full_duplex | default('off') }}

# Minimum number of clients required before casting begins.
# Default: 1
MIN_CLIENTS = {{ min_clients | default('1') }}

# Maximum seconds to wait for clients before initiating cast.
# Default: 10
MAX_WAIT = {{ max_wait | default('10') }}

# Minimum seconds to wait before initiating cast, even if enough clients have connected.
# Default: 5
MIN_WAIT = {{ min_wait | default('5') }}

# Whether to avoid synchronous mode when writing to target.
# Default: on
NOSYNC = {{ nosync | default('on') }}

# Whether to enable debug output.
# Default: off
DEBUG = {{ debug | default('off') }}

# Directory for flamethrower directory information.
# Default: /var/lib/flamethrower
FLAMETHROWER_DIRECTORY_DIR = {{ flamethrower_directory_dir | default('/var/lib/flamethrower') }}

# Directory for flamethrower state information.
# Default: /var/state/flamethrower
FLAMETHROWER_STATE_DIR = {{ flamethrower_state_dir | default('/var/state/flamethrower') }}

# Whether to use Ethernet broadcast instead of multicast.
# Default: off
BROADCAST = {{ broadcast | default('off') }}

# Forward error correction settings (STRIPESxREDUNDANCY/STRIPESIZE format).
# Default: 8x8/128
FEC = {{ fec | default('8x8/128') }}

# Directory for flamethrower logs.
# Default: /var/log/flamethrower
LOG = {{ log | default('/var/log/flamethrower') }}
