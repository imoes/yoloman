# GNOME Disk Utility Notification Plugin Desktop Entry
# This file defines the desktop entry for the GNOME Settings Daemon (gsd) plugin
# responsible for disk/utility notifications. It ensures the plugin launches
# automatically within the GNOME desktop environment.

[Desktop Entry]
# Entry type; must be Application for executable plugins
Type=Application

# Display name used by the desktop environment
Name=gnome-disk-utility notification plugin for GNOME Settings Daemon

# Command to execute. Defaults to the standard GNOME Settings Daemon plugin path.
Exec={{ exec_path | default('/usr/libexec/gsd-disk-utility-notify') }}

# Restrict visibility to GNOME desktop sessions
OnlyShowIn=GNOME;

# Do not show in application menus; this is a background service component
NoDisplay=true

# Enable automatic restart by GNOME Settings Daemon if it crashes
X-GNOME-AutoRestart=true