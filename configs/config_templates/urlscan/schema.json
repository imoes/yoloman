{
  "config": {
    "type": "object",
    "description": "Top-level configuration block for urlscan settings."
  },
  "config.width": {
    "type": "number",
    "default": 0,
    "description": "Display width. 0 means auto-detect or terminal width."
  },
  "config.palettes": {
    "type": "list",
    "default": [],
    "description": "List of color palettes available in urlscan."
  },
  "config.palettes.items": {
    "type": "object",
    "description": "A single palette definition."
  },
  "config.palettes.items.name": {
    "type": "string",
    "default": "default",
    "description": "Name of the palette (e.g., 'default', 'dark')."
  },
  "config.palettes.items.colors": {
    "type": "list",
    "default": [],
    "description": "List of color strings for the palette (urwid display attributes)."
  },
  "config.palettes.items.colors.items": {
    "type": "string",
    "default": "",
    "description": "A single color attribute string (e.g., 'black,white')."
  },
  "config.keybindings": {
    "type": "list",
    "default": [],
    "description": "List of keybinding overrides."
  },
  "config.keybindings.items": {
    "type": "object",
    "description": "A single keybinding definition."
  },
  "config.keybindings.items.key": {
    "type": "string",
    "default": "",
    "description": "The key character or combination (e.g., 'q', 'Ctrl-l')."
  },
  "config.keybindings.items.action": {
    "type": "string",
    "default": "open_url",
    "description": "The action to bind to the key (e.g., 'quit', 'add_url'). Empty string unsets the binding.",
    "enum": [
      "add_url",
      "all_escape",
      "all_shorten",
      "bottom",
      "clear_screen",
      "clipboard",
      "clipboard_pri",
      "context",
      "del_url",
      "down",
      "help_menu",
      "link_handler",
      "next",
      "open_queue",
      "open_queue_win",
      "open_url",
      "palette",
      "previous",
      "quit",
      "reverse",
      "shorten",
      "top",
      "up"
    ]
  }
}
