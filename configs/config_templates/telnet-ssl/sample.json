{
  "default_term_type": "ansi",
  "hosts": [
    {
      "name": "legacy-switch",
      "port": 23,
      "user": "admin",
      "term_type": "vt100",
      "ssl_enabled": false
    },
    {
      "name": "secure-telnetd",
      "port": 992,
      "ssl_enabled": true,
      "ssl_cert_file": "/etc/ssl/certs/client.pem",
      "ssl_key_file": "/etc/ssl/private/client.key",
      "ssl_ca_file": "/etc/ssl/certs/ca-bundle.crt",
      "ssl_secure": true,
      "ssl_verify": 2
    }
  ]
}
