# Telnet client configuration file (telnetrc)
# Generated by Ansible. This file defines global defaults and per-host
# connection parameters for the GNU Telnet client (and compatible implementations).
#
# Format:
#   GLOBAL section uses 'DEFAULT:' header.
#   Per-host sections use 'hostname:' header.
#   Directives use 'set <name> <value>' or 'open <host> [port] [user]'.

# ==============================================================================
# Global defaults section. Applied to all hosts unless a specific host section
# overrides them.
# ==============================================================================
DEFAULT:
    # --------------------------------------------------------------------------
    # The terminal type string to send via the TERMTYPE option.
    # Affects how the remote shell formats output.
    # --------------------------------------------------------------------------
    term {{ (default_term_type | default('vt100')) }}

    # --------------------------------------------------------------------------
    # Enable binary transmission (8-bit clean) by default.
    # Prevents translation of characters, preserving data integrity for
    # non-text transfers.
    # --------------------------------------------------------------------------
    set binary on

    # --------------------------------------------------------------------------
    # Disable automatic login to remote systems.
    # Forces the client to wait for the remote login prompt.
    # --------------------------------------------------------------------------
    set autologin off

    # --------------------------------------------------------------------------
    # Use the standard escape character ^] (Ctrl+]).
    # Allows the user to escape from the telnet session to the local prompt.
    # --------------------------------------------------------------------------
    set escape ^]

# ==============================================================================
# Per-host configurations.
# Iterate over the list of hosts provided in the 'hosts' variable.
# ==============================================================================
{% for host in (hosts | default([])) %}

# --------------------------------------------------------------------------
# Host: {{ host.name | default('UNKNOWN_HOST') }}
# Configured via: hosts[{{ loop.index0 }}]
# --------------------------------------------------------------------------
{{ host.name | default('unknown') }}:
    # ----------------------------------------------------------------------
    # Connection command: open <host> [<port>].
    # Specifies the target hostname and optionally the port number.
    # ----------------------------------------------------------------------
    {% if host.port is defined and host.port %}
    # Connect to a specific port if defined
    open {{ host.name }} {{ host.port }}
    {% else %}
    # Connect to the default telnet port 23
    open {{ host.name }}
    {% endif %}

    # ----------------------------------------------------------------------
    # Remote username: -l <user>.
    # Specifies the username to use for the session (NEW-ENVIRON propagation).
    # ----------------------------------------------------------------------
    {% if host.user is defined and host.user %}
    open -l {{ host.user }}
    {% endif %}

    # ----------------------------------------------------------------------
    # Terminal type override for this specific host.
    # Overrides the global 'term' setting if specified.
    # ----------------------------------------------------------------------
    {% if host.term_type is defined and host.term_type %}
    set term {{ host.term_type }}
    {% endif %}

    # ----------------------------------------------------------------------
    # SSL/TLS Configuration for this host.
    # Telnet-SSL allows secure encryption of the telnet session.
    # ----------------------------------------------------------------------
    {% if host.ssl_enabled %}
    # Attempt SSL negotiation for this host immediately upon connection.
    startssl
    {% endif %}

    {% if host.ssl_cert_file is defined and host.ssl_cert_file %}
    # Client certificate file for mutual TLS authentication.
    # Path to the PEM-encoded certificate file.
    set cert {{ host.ssl_cert_file }}
    {% endif %}

    {% if host.ssl_key_file is defined and host.ssl_key_file %}
    # Private key file corresponding to the client certificate.
    # Path to the PEM-encoded private key file.
    set key {{ host.ssl_key_file }}
    {% endif %}

    {% if host.ssl_ca_file is defined and host.ssl_ca_file %}
    # CA certificate file for server verification.
    # Used to verify the remote server's identity.
    set cacert {{ host.ssl_ca_file }}
    {% endif %}

    {% if host.ssl_cipher_list is defined and host.ssl_cipher_list %}
    # Preferred SSL/TLS cipher suites.
    # Colon-separated list of allowed ciphers.
    set cipher {{ host.ssl_cipher_list }}
    {% endif %}

    {% if host.ssl_verify is defined and host.ssl_verify %}
    # SSL verification flags.
    # Integer bitmask controlling strictness of certificate verification.
    set verify {{ host.ssl_verify }}
    {% endif %}

    {% if host.ssl_debug %}
    # Enable SSL debugging output to stderr.
    # Useful for troubleshooting handshake failures.
    set debug on
    {% endif %}

    {% if host.ssl_secure %}
    # Do not fall back to unencrypted mode if SSL fails.
    # Prevents accidental downgrade to plaintext telnet.
    set secure on
    {% endif %}

    {% if host.ssl_certrequired %}
    # Require server certificate presence.
    # Abort connection if the server does not present a certificate.
    set certrequired on
    {% endif %}

    {% if host.ssl_verbose %}
    # Be verbose about certificates.
    # Display detailed certificate information during handshake.
    set verbose on
    {% endif %}

    {% if host.skip_rc is defined and host.skip_rc %}
    # Skip reading user-specific .telnetrc for this host.
    # Prevents local aliases or overrides from affecting this connection.
    set skiprc on
    {% endif %}

{% endfor %}