# Indicator Network configuration for Lomiri
# Controls how the network indicator behaves in the system UI
# Enable/disable the network indicator service
enabled: {{ enabled }}

# Path to the network manager D-Bus service
network_manager_service: '{{ network_manager_service }}'

# Network interface monitoring
monitor_interfaces:
{% for iface in monitor_interfaces %}  - {{ iface }}
{% endfor %}

# Show/hide specific connection types in the indicator
show_ethernet: {{ show_ethernet }}
show_wifi: {{ show_wifi }}
show_bluetooth: {{ show_bluetooth }}
show_mobile: {{ show_mobile }}

# Refresh interval (in milliseconds) for connection status updates
status_refresh_interval: {{ status_refresh_interval }}

# Maximum number of connection entries to display in the indicator menu
max_connection_entries: {{ max_connection_entries }}

# Default Wi-Fi SSID to connect to when auto-join is enabled
auto_join_ssid: '{{ auto_join_ssid }}'

# Show connection quality indicator (signal strength bars)
show_signal_strength: {{ show_signal_strength }}

# Enable verbose logging to systemd journal (for debugging)
debug_logging: {{ debug_logging }}
