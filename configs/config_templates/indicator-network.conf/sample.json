{
  "enabled": true,
  "network_manager_service": "org.freedesktop.NetworkManager",
  "monitor_interfaces": [
    "wlan0",
    "eth0",
    "wwan0"
  ],
  "show_ethernet": true,
  "show_wifi": true,
  "show_bluetooth": false,
  "show_mobile": true,
  "status_refresh_interval": 2000,
  "max_connection_entries": 10,
  "auto_join_ssid": "HomeWifi",
  "show_signal_strength": true,
  "debug_logging": false
}
