#!/bin/sh
# Usage: event.sh <event> <if-name>
#
# A helper script for madwimax for a generic Linux host.
# Copyright (C) 2008-2009 Alexander Gordeev <lasaine@lvk.cs.msu.su>
#
# Self-documenting configuration:
# dhclient_pid_dir: Directory where dhclient writes its PID file
# dhclient_lease_dir: Directory where dhclient stores lease information
# udhcpc_pid_dir: Directory where udhcpc writes its PID file

case "$1" in
if-create)
	;;
if-up)
	if [ -x /sbin/dhclient3 ]; then
		# Run dhclient3 with network wait, specifying PID and lease file paths
		/sbin/dhclient3 -nw -pf {{ dhclient_pid_dir | default('/var/run') }}/dhclient."$2".pid -lf {{ dhclient_lease_dir | default('/var/lib/dhcp') }}/dhclient."$2".leases "$2" >/dev/null 2>&1
	elif [ -x /sbin/dhclient ]; then
		# Run dhclient (generic) with PID and lease file paths
		/sbin/dhclient -pf {{ dhclient_pid_dir | default('/var/run') }}/dhclient."$2".pid -lf {{ dhclient_lease_dir | default('/var/lib/dhcp') }}/dhclient."$2".leases "$2"
	elif [ -x /sbin/pump ]; then
		# Run pump DHCP client
		/sbin/pump -i "$2"
	elif [ -x /sbin/udhcpc ]; then
		# Run udhcpc (busybox DHCP client) with PID file path
		/sbin/udhcpc -n -p {{ udhcpc_pid_dir | default('/var/run') }}/udhcpc."$2".pid -i "$2"
	elif [ -x /sbin/dhcpcd ]; then
		# Run dhcpcd DHCP client
		/sbin/dhcpcd "$2"
	fi
	;;
if-down)
	if [ -x /sbin/dhclient3 ]; then
		# Release DHCP lease via dhclient3
		/sbin/dhclient3 -r -pf {{ dhclient_pid_dir | default('/var/run') }}/dhclient."$2".pid -lf {{ dhclient_lease_dir | default('/var/lib/dhcp') }}/dhclient."$2".leases "$2" >/dev/null 2>&1
	elif [ -x /sbin/dhclient ]; then
		# Terminate dhclient process using its PID file
		kill -TERM $(cat {{ dhclient_pid_dir | default('/var/run') }}/dhclient."$2".pid)
	elif [ -x /sbin/pump ]; then
		# Release DHCP lease via pump
		/sbin/pump -i "$2" -r
	elif [ -x /sbin/udhcpc ]; then
		# Terminate udhcpc process using its PID file
		kill -TERM $(cat {{ udhcpc_pid_dir | default('/var/run') }}/udhcpc."$2".pid)
	elif [ -x /sbin/dhcpcd ]; then
		# Kill dhcpcd process
		/sbin/dhcpcd -k "$2"
	fi
	;;
if-release)
	;;
*)
	echo "Usage: $0 { if-create | if-up | if-down | if-release }" >&2
	exit 3
	;;
esac