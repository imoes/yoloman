# /usr/share/doc/lighttpd/ssl.txt
# -*- conflicts: mbedtls, gnutls, nss, ssl -*-

# Load the wolfSSL module for Lighttpd.
server.modules += ( "mod_wolfssl" )

# ssl.* settings in the global scope are inherited by
#   $SERVER["socket"] == "..." { ssl.engine = "enable" }
# Path to the SSL PEM certificate and key file.
# The PEM file must contain both the certificate and the private key.
ssl.pemfile = "{{ ssl_pemfile | default('/etc/lighttpd/server.pem') }}"

# Define the SSL listener socket binding.
# Binds to the specified IP address and port for SSL/TLS connections.
$SERVER["socket"] == "{{ ssl_bind_addr | default('0.0.0.0') }}:{{ ssl_bind_port | default(443) }}" {
	ssl.engine  = "enable"
}

# Include IPv6 configuration if available and applicable.
include_shell "/usr/share/lighttpd/use-ipv6.pl 443"
