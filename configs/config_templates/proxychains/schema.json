{
  "proxy_chain_mode": {
    "type": "string",
    "default": "strict_chain",
    "description": "Chain mode selection (e.g., strict_chain, dynamic_chain). Must be uncommented.",
    "enum": [
      "strict_chain",
      "dynamic_chain",
      "random_chain"
    ]
  },
  "proxy_dns": {
    "type": "string",
    "default": "proxy_dns",
    "description": "Enable proxy DNS resolution."
  },
  "tcp_read_time_out": {
    "type": "number",
    "default": 15000,
    "description": "TCP read timeout in milliseconds."
  },
  "tcp_connect_time_out": {
    "type": "number",
    "default": 8000,
    "description": "TCP connect timeout in milliseconds."
  },
  "proxy_type": {
    "type": "string",
    "default": "socks4",
    "description": "Default proxy type in [ProxyList].",
    "enum": [
      "socks4",
      "socks5",
      "http"
    ]
  },
  "proxy_host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Default proxy host address."
  },
  "proxy_port": {
    "type": "number",
    "default": 9050,
    "description": "Default proxy port."
  }
}
