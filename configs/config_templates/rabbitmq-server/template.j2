# =============================================================================
# RabbitMQ Server System Limits Configuration
# =============================================================================
# This file is sourced by /etc/init.d/rabbitmq-server. Its primary
# reason for existing is to allow adjustment of system limits for the
# rabbitmq-server process.
#
# Configuration directives here are applied to the shell environment
# before the rabbitmq-server daemon is started.

# --- System Limits ---

# ulimit_n: Maximum number of open file handles for the rabbitmq-server process.
# This limit needs to be increased to handle many simultaneous connections,
# especially for high-throughput messaging scenarios.
# Refer to the system documentation for ulimit (in man bash) for more information.
#
# Syntax: ulimit -n <count>
# Default: 1024
{% if ulimit_n is defined and ulimit_n is not none and (ulimit_n is number or ulimit_n is boolean or ulimit_n | length > 0) %}ulimit -n {{ ulimit_n | default(1024) }}{% else %}#ulimit -n 1024{% endif %}
