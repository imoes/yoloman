{
  "cluster_name": "ceph",
  "instance_name": "rgw1",
  "keyring_path": "/etc/ceph/client.radosgw.rgw1.keyring",
  "frontend_config": "civetweb port=8080 num_threads=100",
  "enabled_apis": [
    "s3",
    "swift"
  ],
  "dns_name": "rgw.ceph.internal",
  "log_file_path": "/var/log/ceph/ceph-radosgw.rgw1.log",
  "metadata_pool": "default.rgw.meta",
  "data_pool": "default.rgw.data.root",
  "s3_auth_use_rados": true,
  "max_read_mb": 2048,
  "max_read_time_ms": 30000,
  "max_chunk_size": 1048576,
  "op_thread_pool_size": 64,
  "max_open_buckets": 128,
  "bucket_index_max_shards": 12,
  "zone_enabled": false,
  "zone_name": "default",
  "ssl_enabled": false,
  "ssl_cert_path": "/etc/ceph/rgw.crt",
  "ssl_key_path": "/etc/ceph/rgw.key"
}
