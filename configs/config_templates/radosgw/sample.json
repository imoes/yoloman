{
  "cluster_name": "ceph",
  "instance_name": "rgw-01",
  "keyring_path": "/etc/ceph/client.radosgw.rgw-01.keyring",
  "frontend_config": "civetweb port=8080 num_threads=200",
  "enabled_apis": [
    "s3",
    "swift",
    "admin"
  ],
  "dns_name": "rgw-ceph.internal.example.com",
  "log_file_path": "/var/log/ceph/ceph-radosgw.rgw-01.log",
  "metadata_pool": "default.rgw.meta",
  "data_pool": "default.rgw.data",
  "s3_auth_use_rados": true,
  "max_read_mb": 1024,
  "max_read_time_ms": 60000,
  "max_chunk_size": 524288,
  "op_thread_pool_size": 128,
  "max_open_buckets": 256,
  "bucket_index_max_shards": 24,
  "zone_enabled": true,
  "zone_name": "us-east-1",
  "ssl_enabled": true,
  "ssl_cert_path": "/etc/ssl/certs/rgw.crt",
  "ssl_key_path": "/etc/ssl/private/rgw.key"
}
