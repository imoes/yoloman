{
  "listen_addresses": [
    "0.0.0.0:53",
    "[::]:53"
  ],
  "doh_enabled": true,
  "doh_address": "0.0.0.0:443",
  "doh_certs": "/etc/hickory-dns/certs/doh.crt",
  "doh_key": "/etc/hickory-dns/certs/doh.key",
  "dot_enabled": false,
  "dot_address": "",
  "dot_certs": "",
  "dot_key": "",
  "upstream_mode": "system",
  "upstreams": [],
  "cache_size": 50000,
  "min_ttl": 300,
  "max_ttl": 86400,
  "recursive_query_mode": "local_only",
  "log_level": "info",
  "hosted_zones": [
    {
      "zone_name": "example.com",
      "zone_file": "/etc/hickory-dns/zones/example.com.zone",
      "zone_type": "master"
    },
    {
      "zone_name": "1.168.192.in-addr.arpa",
      "zone_file": "/etc/hickory-dns/zones/1.168.192.in-addr.arpa.zone",
      "zone_type": "slave",
      "masters": [
        "192.168.1.10"
      ],
      "allow_notify": [
        "192.168.1.10"
      ]
    }
  ],
  "rate_limit_enabled": true,
  "rate_limit_max_qps": 200,
  "rate_limit_window": 5
}
