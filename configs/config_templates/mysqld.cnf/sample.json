{
  "mysql_user": "mysql",
  "mysql_gid": "mysql",
  "mysql_datadir": "/var/lib/mysql",
  "mysql_tmpdir": "/tmp",
  "mysql_socket": "/var/run/mysqld/mysqld.sock",
  "mysql_bind_address": "0.0.0.0",
  "mysql_port": 3306,
  "mysql_character_set_server": "utf8mb4",
  "mysql_collation_server": "utf8mb4_unicode_ci",
  "mysql_time_zone": "SYSTEM",
  "mysql_innodb_buffer_pool_size": "1G",
  "mysql_innodb_log_file_size": "256M",
  "mysql_innodb_flush_log_at_trx_commit": 1,
  "mysql_innodb_file_per_table": true,
  "mysql_innodb_flush_method": "O_DIRECT",
  "mysql_query_cache_type": "OFF",
  "mysql_query_cache_size": "0",
  "mysql_query_cache_limit": "256K",
  "mysql_max_connections": 300,
  "mysql_max_allowed_packet": "64M",
  "mysql_thread_cache_size": 32,
  "mysql_thread_stack": "262144",
  "mysql_general_log": false,
  "mysql_general_log_file": "/var/log/mysql/general.log",
  "mysql_slow_query_log": true,
  "mysql_slow_query_log_file": "/var/log/mysql/slow.log",
  "mysql_long_query_time": 1,
  "mysql_log_error": "/var/log/mysql/error.log",
  "mysql_log_bin": "/var/log/mysql/mysql-bin",
  "mysql_binlog_format": "ROW",
  "mysql_expire_logs_days": 14,
  "mysql_max_binlog_size": "256M",
  "mysql_binlog_cache_size": "32K",
  "mysql_replication_slaves": [
    {
      "host": "db-replica-01.internal",
      "server_id": 2,
      "replicate_do_db": [
        "app_db",
        "analytics"
      ]
    }
  ],
  "mysql_ssl_ca": "",
  "mysql_ssl_cert": "",
  "mysql_ssl_key": "",
  "mysql_local_infile": false,
  "mysql_join_buffer_size": "512K",
  "mysql_sort_buffer_size": "512K",
  "mysql_read_buffer_size": "256K",
  "mysql_read_rnd_buffer_size": "512K",
  "mysql_tmp_table_size": "128M",
  "mysql_max_heap_table_size": "128M",
  "mysql_open_files_limit": 4096,
  "mysql_table_open_cache": 4000,
  "mysql_thread_concurrency": 0,
  "mysql_default_storage_engine": "InnoDB"
}
