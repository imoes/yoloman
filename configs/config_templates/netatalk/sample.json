{
  "afp_interfaces": [
    "eth0"
  ],
  "mimic_model": "TimeCapsule6,108",
  "log_level": "default:note",
  "log_file": "/var/log/netatalk.log",
  "home_path": "/home/%U",
  "home_afp_flags": "dperm=0700,fperm=0600",
  "services": [
    {
      "name": "Public",
      "path": "/srv/afp/public",
      "description": "Public read-only share for documents",
      "readonly": true
    },
    {
      "name": "Projects",
      "path": "/srv/afp/projects",
      "valid_users": [
        "alice",
        "bob"
      ],
      "hosts_allow": [
        "192.168.1.0/24"
      ]
    },
    {
      "name": "Backups",
      "path": "/srv/afp/backups",
      "hidden": true,
      "extended_attributes": true
    }
  ]
}
