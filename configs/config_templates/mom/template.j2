[main]
# The wake up frequency of the main daemon (in seconds).
# Controls how often the main loop of the MOM daemon iterates.
main-loop-interval: {{ main_loop_interval | default(5) }}

# The data collection interval for host statistics (in seconds).
# Frequency at which host-level metrics (CPU, RAM, etc.) are collected.
host-monitor-interval: {{ host_monitor_interval | default(5) }}

# The data collection interval for guest statistics (in seconds).
# Frequency at which guest (VM) level metrics are collected.
guest-monitor-interval: {{ guest_monitor_interval | default(5) }}

# The wake up frequency of the guest manager (in seconds).
# The guest manager sets up monitoring and control for newly-created
# guests and cleans up after deleted guests.
guest-manager-interval: {{ guest_manager_interval | default(5) }}

# The interface MOM using to discover active guests and collect guest memory
# statistics. Choices: libvirt, vdsm.
# Determines the hypervisor backend used for guest discovery and stats.
hypervisor-interface: {{ hypervisor_interface | default('libvirt') }}

# The wake up frequency of the policy engine (in seconds).
# During each interval the policy engine evaluates the policy and passes
# the results to each enabled controller plugin.
policy-engine-interval: {{ policy_engine_interval | default(10) }}

# A comma-separated list of Controller plugins to enable.
# Controllers react to policy outcomes (e.g., balancing, memory sharing).
# Example: Balloon, KSM
controllers: {{ controllers | default(['Balloon', 'KSM']) | join(', ') }}

# Sets the maximum number of statistic samples to keep for the purpose of
# calculating moving averages.
# Older samples are discarded to keep memory usage bounded and averages current.
sample-history-length: {{ sample_history_length | default(10) }}

# The URI to use when connecting to this host's libvirt interface.
# If left blank, the system default URI is used.
# Only relevant if hypervisor-interface is libvirt.
libvirt-hypervisor-uri: {{ libvirt_hypervisor_uri | default('') }}

# Set this to an existing, writable directory to enable plotting.
# If empty, plotting is disabled.
# For each invocation, a subdirectory momplot-NNN is created containing
# tab-delimited data files with all data generated by the configured Collectors.
plot-dir: {{ plot_dir | default('') }}

# Activate the RPC server on the designated port (-1 to disable).
# RPC is disabled by default until authentication is added to the protocol.
rpc-port: {{ rpc_port | default(-1) }}

# At startup, load a policy from the given file.
# If empty, no policy is loaded from this specific file path.
policy: {{ policy_file | default('') }}

# At startup, load policies from the given directory.
# Only filenames matching *.policy will be considered.
# Policies are concatenated in alphabetical order by name for evaluation.
policy-dir: {{ policy_dir | default('/etc/mom/policies.d') }}

# The default behaviour of MOM is to monitor each VM in a separate thread.
# This approach offers isolation between VMs, and avoids that one unresponding
# VM affects the monitoring of the others. The drawback is the increased resource
# consumption, which can be high when monitoring hundreds of VMs.
# If set to false, disable the current behaviour and configure MOM to monitor
# all the VMs using only one thread.
guest-manager-multi-thread: {{ guest_manager_multi_thread | default(True) | lower }}

[logging]
# Set the destination for program log messages.
# This can be either 'stdio' (stdout/stderr) or a filename (for file logging).
log: {{ log_destination | default('stdio') }}

# Set the logging verbosity level.
# Supported levels: debug, info, warn, error, critical.
# Can be specified by number or name.
verbosity: {{ log_level | default('info') }}

#log: /var/log/mom.log
## The following two variables are used only when logging is directed to a file.
# Set the maximum size of a log file (in bytes) before it is rotated.
#max-bytes: 2097152
# Set the maximum number of rotated logs to retain.
#backup-count: 5

[host]
# A comma-separated list of Collector plugins to use for Host data collection.
# Collectors gather metrics about the hypervisor host itself.
collectors: {{ host_collectors | default(['HostMemory', 'HostKSM']) | join(', ') }}

[guest]
# A comma-separated list of Collector plugins to use for Guest data collection.
# Collectors gather metrics about individual VMs/guests.
collectors: {{ guest_collectors | default(['GuestQemuProc', 'GuestMemory', 'GuestBalloon']) | join(', ') }}

# Collector-specific configuration for GuestQemuAgent
[Collector: GuestQemuAgent]
# Set the base path where the host-side sockets for guest communication can be
# found. The GuestQemuAgent Collector will try to open the socket:
#   <socket_path>/<socket_name_template>
#   after appropriate socket_name_template substitution as explained below.
socket_path: {{ socket_path | default('/var/lib/libvirt/qemu') }}

# Set the socket name template. Default: %(name)s.agent
# socket name is determined by substituting 'name'
# key in the template with guest name.
# Assuming guest name 'instance-00000001' and default template,
# socketname will be instance-00000001.agent.
# The GuestQemuAgent Collector will try to open the socket:
#   <socket_path>/<socket_name_template>
#   after guest name substitution in the template.
socket_name_template: {{ socket_name_template | default('%(name)s.agent') }}

[Collector: GuestNetworkDaemon]
# Helper program to convert guest names to IP addresses.
# This is only used by the GuestNetworkDaemon Collector.
# See doc/name-to-ip for an example.
#name-to-ip-helper: doc/name-to-ip