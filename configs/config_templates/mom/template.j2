[main]
# The wake up frequency of the main daemon (in seconds).
main-loop-interval: {{ main_loop_interval | default('5') }}

# The data collection interval for host statistics (in seconds).
host-monitor-interval: {{ host_monitor_interval | default('5') }}

# The data collection interval for guest statistics (in seconds).
guest-monitor-interval: {{ guest_monitor_interval | default('5') }}

# The wake up frequency of the guest manager (in seconds).
guest-manager-interval: {{ guest_manager_interval | default('5') }}

# The interface MOM using to discover active guests and collect guest memory statistics. Choices: libvirt, vdsm.
hypervisor-interface: {{ hypervisor_interface | default('libvirt') }}

# The wake up frequency of the policy engine (in seconds).
policy-engine-interval: {{ policy_engine_interval | default('10') }}

# A comma-separated list of Controller plugins to enable.
controllers: {{ controllers | default(['Balloon', 'KSM']) | join(', ') }}

# Sets the maximum number of statistic samples to keep for the purpose of calculating moving averages.
sample-history-length: {{ sample_history_length | default('10') }}

# The URI to use when connecting to this host's libvirt interface. If left blank, the system default URI is used.
libvirt-hypervisor-uri: {{ libvirt_hypervisor_uri | default('') }}

# Set this to an existing, writable directory to enable plotting. If empty, plotting is disabled.
plot-dir: {{ plot_dir | default('') }}

# Activate the RPC server on the designated port (-1 to disable).
rpc-port: {{ rpc_port | default('-1') }}

# At startup, load a policy from the given file. If empty, no policy is loaded.
policy: {{ policy_file | default('') }}

# At startup, load policies from the given directory. Only filenames matching *.policy will be considered.
policy-dir: {{ policy_dir | default('/etc/mom/policies.d') }}

# Monitor each VM in a separate thread (true) or use a single thread for all VMs (false).
guest-manager-multi-thread: {{ guest_manager_multi_thread | default('true') }}

[logging]
# Set the destination for program log messages. This can be either 'stdio' or a filename.
log: {{ log_destination | default('stdio') }}

# Set the logging verbosity level. Supported levels: debug, info, warn, error, critical.
verbosity: {{ log_level | default('info') }}

[host]
# A comma-separated list of Collector plugins to use for Host data collection.
collectors: {{ host_collectors | default(['HostMemory', 'HostKSM']) | join(', ') }}

[guest]
# A comma-separated list of Collector plugins to use for Guest data collection.
collectors: {{ guest_collectors | default(['GuestQemuProc', 'GuestMemory', 'GuestBalloon']) | join(', ') }}

# Collector-specific configuration for GuestQemuAgent
[Collector: GuestQemuAgent]
# Set the base path where the host-side sockets for guest communication can be found.
socket_path: {{ socket_path | default('/var/lib/libvirt/qemu') }}

# Set the socket name template. Default: %(name)s.agent.
socket_name_template: {{ socket_name_template | default('%(name)s.agent') }}
