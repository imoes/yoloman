{
  "enabled": true,
  "log_level": "info",
  "state_file": "/var/lib/mom/mom.state",
  "policy_directory": "/etc/mom/policies.d",
  "poll_interval": 15,
  "memory_enabled": true,
  "memory_max_overcommit_ratio": 1.25,
  "min_free_memory": 1024,
  "balancer_threshold": 2048,
  "ballooning_enabled": true,
  "cpu_enabled": true,
  "cpu_max_overcommit_ratio": 2.0,
  "min_shares_per_vm": 64,
  "cpu_throttling_policy": "adaptive",
  "disk_enabled": true,
  "max_total_iops": 40000,
  "max_per_vm_iops": 4000,
  "burst_allowed_percent": 15,
  "network_enabled": true,
  "max_total_bandwidth": 8000,
  "max_per_vm_bandwidth": 800,
  "network_burst_allowed_percent": 20,
  "memory_pressure_cmd": "/usr/local/bin/mom-action.sh --vm={vm} --action={action} --reason={reason}",
  "cpu_throttling_cmd": "",
  "migration_cmd": "/usr/local/bin/mom-migrate-check.sh --vm={vm} --target={target}",
  "excluded_vms": [
    "564d-8f9e-1a2b-3c4d-5e6f7a8b9c0d"
  ],
  "vm_policies": [
    {
      "vm_name": "vm-web-01",
      "cpu_shares": 512,
      "network_bandwidth_limit": 1200
    },
    {
      "vm_name": "vm-db-01",
      "memory_limit": 16384,
      "disk_iops_limit": 8000
    }
  ]
}
