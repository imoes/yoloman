{
  "main_loop_interval": 5,
  "host_monitor_interval": 5,
  "guest_monitor_interval": 5,
  "guest_manager_interval": 5,
  "hypervisor_interface": "libvirt",
  "policy_engine_interval": 10,
  "controllers": [
    "Balloon",
    "KSM"
  ],
  "sample_history_length": 10,
  "libvirt_hypervisor_uri": "",
  "plot_dir": "",
  "rpc_port": -1,
  "policy_file": "",
  "policy_dir": "/etc/mom/policies.d",
  "guest_manager_multi_thread": true,
  "log_destination": "stdio",
  "log_level": "info",
  "host_collectors": [
    "HostMemory",
    "HostKSM"
  ],
  "guest_collectors": [
    "GuestQemuProc",
    "GuestMemory",
    "GuestBalloon"
  ],
  "socket_path": "/var/lib/libvirt/qemu",
  "socket_name_template": "%(name)s.agent"
}
