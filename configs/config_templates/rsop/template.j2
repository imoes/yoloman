# RSoP (Stateless OpenPGP) Configuration Template
# This file configures the default behaviors for the rsop CLI tool.
# Self-documenting: every setting includes its schema description and default.

[general]
# Enable verbose output for debugging. Corresponds to the --debug flag in rsop(1).
debug = {{ debug | default(False) | lower }}

[default_action]
# The default subcommand to run. Valid values: version, verify, inline-verify, generate-key, change-key-password, revoke-key, extract-cert, up.
default_subcommand = {{ default_subcommand | default('version') }}

[key_management]
# Filesystem path to the secret keyring used by cryptographic operations.
default_key_path = {{ default_key_path | default('~/.gnupg/secring.gpg') }}

[output]
# Default data format (binary or armored) for encryption/decryption/armor operations.
default_format = {{ default_format | default('binary') }}