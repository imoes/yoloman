{
  "viewers": [
    {
      "ext": ".jpg,.gif,.bmp,.tif,.ppm,.xpm",
      "cmd": "xv"
    },
    {
      "ext": ".1,.2,.3,.4,.5,.6,.7,.8,.n",
      "cmd": "nroff -man | less"
    },
    {
      "ext": ".ps",
      "cmd": "ghostview"
    },
    {
      "ext": ".mid,.MID",
      "cmd": "playmidi -e"
    },
    {
      "ext": ".wav,.WAV",
      "cmd": "splay"
    },
    {
      "ext": ".au",
      "cmd": "auplay"
    },
    {
      "ext": ".avi,.mpg,.mov",
      "cmd": "xanim"
    },
    {
      "ext": ".htm,.html",
      "cmd": "lynx"
    },
    {
      "ext": ".pdf,.PDF",
      "cmd": "acroread"
    },
    {
      "ext": ".mp3",
      "cmd": "mpg123"
    }
  ],
  "freeze_cmd": "melt",
  "gzip_cmd": "gunzip -c",
  "other_compressor_cmd": "uncompress",
  "esc_delay": 1000
}
