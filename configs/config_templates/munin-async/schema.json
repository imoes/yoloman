{
  "desc": {
    "type": "string",
    "default": "Munin asynchronous server",
    "description": "Description string for the service."
  },
  "daemond_path": {
    "type": "string",
    "default": "/usr/share/munin/munin-asyncd",
    "description": "Path to the munin-asyncd executable."
  },
  "pidfile_path": {
    "type": "string",
    "default": "/run/munin/munin-asyncd.pid",
    "description": "Path to the PID file for the daemon."
  },
  "daemon_user": {
    "type": "string",
    "default": "munin-async",
    "description": "System user under which the daemon runs."
  },
  "notify_timeout": {
    "type": "number",
    "default": 15,
    "description": "Timeout in seconds for notify-await in start arguments."
  }
}
