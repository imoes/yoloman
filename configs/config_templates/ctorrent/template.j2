# ==========================================
# ctorrent Configuration Template
# ==========================================
# This file configures the ctorrent BitTorrent client.
# It is auto-generated by Ansible. Do not edit manually.
# ==========================================

# TCP port for incoming BitTorrent peer connections.
# Common range: 6881–6889.
port = {{ port | default(6881) }}

# IP address or interface name to bind to (e.g., 'eth0' or '192.168.1.10').
# Leave blank for all interfaces.
bind_address = "{{ bind_address | default('0.0.0.0') }}"

# Maximum total number of peer connections across all torrents.
max_peers = {{ max_peers | default(100) }}

# Maximum number of simultaneous upload (seeding) slots. Set to 0 for unlimited.
max_uploads = {{ max_uploads | default(4) }}

# Enable DHT (Distributed Hash Table) to discover peers without trackers.
enable_dht = {{ 'yes' if (enable_dht | default(true)) else 'no' }}

# Enable automatic port forwarding via UPnP or NAT-PMP on compatible routers.
enable_upnp = {{ 'yes' if (enable_upnp | default(true)) else 'no' }}

# Maximum memory (MiB) to allocate for piece buffers and metadata.
# Adjust based on system RAM.
max_memory = {{ max_memory | default(1024) }}

# Directory where completed torrents are stored.
download_dir = "{{ download_dir | default('/var/lib/ctorrent/download') }}"

# Directory where partial (incomplete) downloads reside until completed.
incomplete_dir = "{{ incomplete_dir | default('/var/lib/ctorrent/incomplete') }}"

# Resume downloads quickly by using stored resume data instead of rechecking all pieces.
fast_resume = {{ 'yes' if (fast_resume | default(true)) else 'no' }}

# Verbosity: 0=none, 1=error, 2=warn, 3=info, 4=debug.
# Use 3 for production monitoring.
log_level = {{ log_level | default(3) }}

# Path to log file. Leave empty to log to stderr/stdout.
log_file = "{{ log_file | default('') }}"

# Encrypt peer connections using TLS (requires peer support).
enable_ssl = {{ 'yes' if (enable_ssl | default(false)) else 'no' }}

# Preallocate full disk space for torrent files to avoid fragmentation and I/O delays.
preallocate = {{ 'yes' if (preallocate | default(true)) else 'no' }}

# Enable endgame mode: download rare remaining pieces from all connected peers.
endgame_mode = {{ 'yes' if (endgame_mode | default(true)) else 'no' }}

# Minimum peers to maintain in seeding mode before pausing new connections.
min_peers_seed = {{ min_peers_seed | default(4) }}

# Max peers per torrent (0 = use global max_peers).
max_peers_torrent = {{ max_peers_torrent | default(0) }}

# List of extra ports to listen on (e.g., [6882, 6883] for IPv4+IPv6 or load balancing).
extra_ports = {{ extra_ports | default([]) | join(', ') }}

# Maximum download rate (KiB/s). Set to 0 for unlimited.
download_rate_limit = {{ download_rate_limit | default(0) }}

# Maximum upload rate (KiB/s). Set to 0 for unlimited.
upload_rate_limit = {{ upload_rate_limit | default(0) }}

# Minimum time (seconds) between tracker announces. Reduces tracker load.
min_announce_interval = {{ min_announce_interval | default(600) }}

# Maximum time (seconds) between tracker announces (fallback interval).
max_announce_interval = {{ max_announce_interval | default(1800) }}

# Timeout (seconds) before retrying a failed tracker.
tracker_timeout = {{ tracker_timeout | default(90) }}

# List of global trackers to append to every new torrent.
# Avoid adding private trackers.
# Note: ctorrent typically takes a raw URL string.
{% for tracker_entry in (global_trackers | default([]) | map(attribute='url') | list) %}
tracker = "{{ tracker_entry }}"
{% endfor %}
{% for tracker_str in (global_trackers | default([]) | select('string') | list) %}
# Alternative raw string tracker entry: {{ tracker_str }}
{% endfor %}

# Custom user-agent string for tracker identification. Leave empty for default.
user_agent = "{{ user_agent | default('') }}"

# Enable TCP Fast Open (Linux kernel ≥3.7). Reduces handshake latency.
fast_open = {{ 'yes' if (fast_open | default(false)) else 'no' }}

# Enable Peer Exchange (PEX) to share peer lists with connected peers.
enable_pex = {{ 'yes' if (enable_pex | default(true)) else 'no' }}

# Enable Local Service Discovery (LSD) to find local peers.
enable_lsd = {{ 'yes' if (enable_lsd | default(false)) else 'no' }}

# Upload/download ratio target before auto-stopping seeding. 1.0 = 100%.
share_ratio_limit = {{ share_ratio_limit | default(1.0) }}

# Maximum seeding time (seconds) per torrent before auto-removing. 0 = unlimited.
seed_time_limit = {{ seed_time_limit | default(0) }}

# Hours to wait after torrent completion before auto-removing. 0 = disabled.
auto_remove_delay = {{ auto_remove_delay | default(0) }}

# Minimum share ratio required before seeding stops.
min_seed_ratio = {{ min_seed_ratio | default(1.0) }}

# Minimum seeding time (seconds) required before seeding stops (even if ratio met).
min_seed_time = {{ min_seed_time | default(3600) }}