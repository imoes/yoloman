# Gzip/Grep Aliases Configuration for RedHat-based systems
# This template generates shell aliases for grep-based commands to enable
# automatic colorized output when used with compressed files.

# Source the system grep configuration helper if it exists.
# This script typically sets up environment variables for grep's color settings.
# We use a raw block to prevent Jinja2 from interpreting the shell syntax as templates.
{% raw %}
test -f /usr/libexec/grepconf.sh
if ( $status == 1 ) exit

/usr/libexec/grepconf.sh -c
if ( $status == 1 ) exit
{% endraw %}

# Define aliases for working with compressed text files.
# These aliases ensure that `zgrep`, `zfgrep`, and `zegrep` always
# highlight matches in color, improving readability.

alias zgrep 'zgrep --color=auto'
alias zfgrep 'zfgrep --color=auto'
alias zegrep 'zegrep --color=auto'
