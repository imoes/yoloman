# =============================================================================
# linuxcnc-uspace: Real-Time API Configuration (rtapi.conf)
# =============================================================================
# Generated from rtapi.conf.in by LinuxCNC build system.
# This file configures the Real-Time API (RTAPI) loader for LinuxCNC USpace.
# It defines installation paths, kernel module locations, and which
# real-time modules to load based on the detected RTAI/Preempt-RT version.
#
# NOTE: Do not edit this file manually. Use Ansible variables to customize.
# =============================================================================

# -----------------------------------------------------------------------------
# Installation and System Paths
# -----------------------------------------------------------------------------

# Root directory for EMC2/LinuxCNC installation.
# Used to resolve relative paths for modules and scripts.
EMC2_HOME={{ emc2_home | default('/usr') }}

# Path to the kernel source directory.
# Often left empty for pre-built modules if not needed for recompilation.
KERNELDIR={{ kerneldir | default('') }}

# Directory where realtime kernel modules are installed.
# This is the base path for loading .ko/.so files.
RTLIB_DIR={{ rtplib_dir | default('/usr/lib/linuxcnc/modules') }}

# File extension for module files.
# Typically '.so' for LinuxCNC USpace modules.
MODULE_EXT={{ module_ext | default('.so') }}

# Prefix for realtime module names.
# Modules are typically loaded as '<prefix>_<module_name>'.
RTPREFIX={{ rtprefix | default('uspace') }}

# Kernel version string.
# Often empty if auto-detected by the runtime loader.
KERNEL_VERS={{ kernel_vers | default('') }}

# -----------------------------------------------------------------------------
# Debugging
# -----------------------------------------------------------------------------

# Sets the default DEBUG level for LinuxCNC components.
# Higher values enable more verbose logging.
DEBUG='{{ debug_level | default('1') }}'

# -----------------------------------------------------------------------------
# Module Loading Configuration
# -----------------------------------------------------------------------------

# Path to the realtime kernel modules.
# Overrides RTLIB_DIR for specific module loading if set.
MODPATH={{ modpath | default('/usr/lib/linuxcnc/modules') }}

# List of realtime kernel modules to be loaded.
# The logic below selects the correct module set based on RT_VERSION.
#
# RT_VERSION Logic:
# - If rt_version is '3': Load RTAI 3 modules (adeos, rtai_hal, etc.)
# - If rt_version is '4': Load RTAI 4 modules (rtai_hal, rtai_sched, etc.)
# - If rt_version is '5': Load RTAI 5 modules (rtai_hal, rtai_sched, etc.)
# - If rt_version is empty/unset: Auto-detect kernel string (e.g., *-rtai*)
# -----------------------------------------------------------------------------

{% set rt = rt_version | default('', true) %}
{% if rt == '3' %}
# --- RT Version 3 Configuration (RTAI 3) ---
MODULES="{{ modules_rt3 | default('adeos rtai_hal rtai_ksched rtai_fifos rtai_sem rtai_math') }}"
RTAI={{ rtaimode_rt3 | default('') }}

# Custom paths for RT v3 modules (if not in default MODPATH)
MODPATH_adeos={{ modpath_adeos | default('') }}
MODPATH_rtai_hal={{ modpath_rtai_hal_rt3 | default('') }}
MODPATH_rtai_ksched={{ modpath_rtai_ksched | default('') }}
MODPATH_rtai_fifos={{ modpath_rtai_fifos | default('') }}
MODPATH_rtai_sem={{ modpath_rtai_sem | default('') }}
MODPATH_rtai_math={{ modpath_rtai_math | default('') }}

{% elif rt == '4' %}
# --- RT Version 4 Configuration (RTAI 4) ---
MODULES="{{ modules_rt4 | default('rtai_hal rtai_sched rtai_fifos rtai_sem rtai_math') }}"
RTAI={{ rtaimode_rt4 | default('') }}

# Custom paths for RT v4 modules
MODPATH_rtai_hal={{ modpath_rtai_hal_rt4 | default('') }}
MODPATH_rtai_sched={{ modpath_rtai_sched_rt4 | default('') }}
MODPATH_rtai_fifos={{ modpath_rtai_fifos | default('') }}
MODPATH_rtai_sem={{ modpath_rtai_sem | default('') }}
MODPATH_rtai_math={{ modpath_rtai_math | default('') }}

{% elif rt == '5' %}
# --- RT Version 5 Configuration (RTAI 5) ---
MODULES="{{ modules_rt5 | default('rtai_hal rtai_sched rtai_math') }}"
RTAI={{ rtaimode_rt5 | default('') }}

# Custom paths for RT v5 modules
MODPATH_rtai_hal={{ modpath_rtai_hal_rt5 | default('') }}
MODPATH_rtai_sched={{ modpath_rtai_sched_rt5 | default('') }}
MODPATH_rtai_math={{ modpath_rtai_math | default('') }}

{% else %}
# --- Auto-Detect Configuration ---
# If rt_version is not explicitly set to 3, 4, or 5, attempt to detect
# the real-time kernel variant via uname -r.

# Note: The original template had a bug where ALL initial branches compared
# against empty string "", causing the first branch (rt3) to always match
# if rt_version was empty. The logic below assumes the intent was to check
# specific versions, falling back to auto-detection otherwise.

case `uname -r` in
*-rtai*)
    # Auto-detected RTAI kernel
    MODULES="{{ modules_rtai | default('rtai_hal rtai_sched') }}"
    # Hardcoded paths for auto-detection (as per original template)
    MODPATH_rtai_hal=/usr/realtime-`uname -r`/modules/rtai_hal.ko
    MODPATH_rtai_sched=/usr/realtime-`uname -r`/modules/rtai_sched.ko
;;
*)
    # Generic/Unknown kernel
    MODULES={{ modules_default | default('') }}
esac
{% endif %}