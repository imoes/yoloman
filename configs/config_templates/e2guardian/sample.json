{
  "listen_address": "0.0.0.0",
  "listen_port": 8080,
  "tls_listen_port": 0,
  "icap_port": 0,
  "transparent_http_port": 0,
  "filter_groups": 1,
  "default_filter_group": 1,
  "enable_ssl": "off",
  "default_icap_filter_group": 1,
