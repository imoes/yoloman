{
  "listen_address": "127.0.0.1",
  "listen_port": 8080,
  "daemon_nodaemon": false,
  "children_count": 8,
  "log_level": 3,
  "log_ip_addresses": true,
  "log_file_path": "/var/log/e2guardian/access.log",
  "banned_mime_types": [
    "application/x-msdownload",
    "application/x-sh",
    "text/scriptlet",
    "application/x-msdos-program"
  ],
  "content_group_files": [
    "/etc/e2guardian/contentgroups"
  ],
  "auth_enabled": false,
  "auth_module": "basic",
  "auth_file": "/etc/e2guardian/authusers",
  "auth_realm": "E2Guardian Proxy",
  "auth_type": "none",
  "upstream_proxy_host": "proxy.example.com",
  "upstream_proxy_port": 3128,
  "time_restrictions_enabled": true,
  "restricted_times": "09:00-17:30",
  "restrict_days": "1-5",
  "url_length_limit": 2048,
  "phrase_group_files": [
    "/etc/e2guardian/phraselists"
  ],
  "url_group_files": [
    "/etc/e2guardian/urlgroups"
  ],
  "pattern_matching_enabled": true,
  "pattern_group_files": [
    "/etc/e2guardian/patterngroups"
  ],
  "exclude_ips": [
    {
      "ip": "192.168.1.0/24",
      "comment": "Internal admin network"
    },
    {
      "ip": "10.0.0.5",
      "comment": "Backup server"
    }
  ],
  "exclude_domains": [
    {
      "domain": "internal.example.com",
      "comment": "Internal docs"
    },
    {
      "domain": "cdn.example.org",
      "comment": "Trusted CDN"
    }
  ],
  "language": "english",
  "ssl_inspection_enabled": false,
  "ssl_cert_file": "/etc/e2guardian/ssl/e2guardian.crt",
  "ssl_key_file": "/etc/e2guardian/ssl/e2guardian.key",
  "ssl_chain_file": "/etc/e2guardian/ssl/chain.crt",
  "ssl_proxy_port": 8081,
  "max_content_download_mb": 10,
  "max_content_download_limit_mb": 100,
  "max_request_size_kb": 1024,
  "max_body_size_kb": 5120,
  "max_connect_time_s": 120,
  "connection_timeout_s": 30,
  "cache_enabled": true,
  "cache_path": "/var/cache/e2guardian",
  "cache_limit_mb": 200
}
