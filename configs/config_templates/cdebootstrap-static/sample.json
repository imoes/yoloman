{
  "arch": "amd64",
  "flavour": "minimal",
  "mirror": "http://ftp.debian.org/debian",
  "target": "/target",
  "origin": "Debian",
  "exclude_packages": [
    "task-english"
  ],
  "include_packages": [
    "sudo",
    "vim"
  ],
  "keyring": "debian-archive-keyring.gpg",
  "configdir": "/etc/cdebootstrap",
  "helperdir": "/usr/lib/cdebootstrap",
  "allow_unauthenticated": false,
  "download_only": false,
  "foreign": false,
  "quiet": false,
  "verbose": true,
  "debug": false,
  "suite_config": false
}
