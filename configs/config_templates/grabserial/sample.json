{
  "device": "/dev/ttyUSB0",
  "baudrate": 115200,
  "width": 8,
  "parity": "N",
  "stopbits": 1,
  "xonxoff": false,
  "rtscts": false,
  "force_reset": false,
  "endtime": 30,
  "command": "",
  "time": true,
  "systime": false,
  "launchtime": false,
  "match": "^Linux version.*",
  "instantpat": "",
  "quitpat": "",
  "output": "/var/log/serial.log",
  "verbose": false
}
