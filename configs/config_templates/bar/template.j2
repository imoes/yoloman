# bar(1) configuration file
# Format: key: value
# Lines starting with # are comments and are ignored by bar.

# Read input from this file. Default: stdin
if: {{ input_file | default('') }}

# Write output to this file. If output-file is a directory, bar creates a file with the input file's name inside it. Default: stdout
of: {{ output_file | default('') }}

# Expect an input stream of this many bytes. Supports suffixes k, m, g, t, p, e, b (if block-size is set first).
s: {{ size | default(0) }}

# Instruct bar that this many bytes have already been copied (continuation of previous transfer).
c: {{ completed | default(0) }}

# Allocate an I/O buffer of this many bytes. Default: 52488 (512 KiB). Same modifiers as size allowed.
bs: {{ buffer_size | default(52488) }}

# Restrict I/O throughput to this rate in bytes per second. Same modifiers as size allowed.
th: {{ throttle | default(0) }}

# Update the display every this many seconds. Default: 1
i: {{ interval | default(1) }}

# Wait for the first byte of data before displaying anything.
dw: {{ display_wait | default(false) | ternary(1, 0) }}

# Use either 1000 or 1024 as the definition of a kilobyte for size/scale parsing. Default: 1024
k: {{ kilobyte | default(1024) }}

# When parsing sizes in blocks (suffix b), assume a single block is this many bytes. Must be set before any block-based sizes. Default: 512
bl: {{ block_size | default(512) }}

# Assume a fixed screen width of this many characters; overrides terminal detection. Use 0 to disable override.
sw: {{ screen_width | default(0) }}

# Use full terminal width minus one for screen width.
sw-1: {{ screen_width_minus_one | default(false) | ternary(1, 0) }}

# Assume a fixed screen height of this many characters; useful only with info-file. Default: 23
sh: {{ screen_height | default(23) }}

# Use full terminal height minus one for screen height.
sh-1: {{ screen_height_minus_one | default(false) | ternary(1, 0) }}

# Set the title string. No title shown unless explicitly set.
ti: {{ title | default('') }}

# Display options — boolean: on|off|yes|no|y|n|true|false|t|f|1|0

# Turn on/off the twirling twiddle character in the display.
dtw: {{ display_twiddle | default(true) | ternary(1, 0) }}

# Turn on/off the title in the display.
dti: {{ display_title | default(true) | ternary(1, 0) }}

# Turn on/off the data count in the display.
dc: {{ display_count | default(true) | ternary(1, 0) }}

# Display the data count in bits instead of bytes.
dcb: {{ display_count_bits | default(false) | ternary(1, 0) }}

# Turn on/off the data throughput in the display.
dth: {{ display_throughput | default(true) | ternary(1, 0) }}

# Display throughput in bits/second instead of bytes/second.
dthb: {{ display_throughput_bits | default(false) | ternary(1, 0) }}

# Turn on/off the time (elapsed or ETA) in the display.
dt: {{ display_time | default(true) | ternary(1, 0) }}

# Force bar to display elapsed time instead of ETA.
de: {{ display_elapsed_only | default(false) | ternary(1, 0) }}

# Turn on/off percent complete in the display.
dp: {{ display_percent | default(true) | ternary(1, 0) }}

# Turn on/off the progress bar in the display.
db: {{ display_bar | default(true) | ternary(1, 0) }}

# Turn on/off the summary information displayed at completion.
ds: {{ display_summary | default(true) | ternary(1, 0) }}

# Display percent as integer per line instead of full display. Requires known total size.
dnum: {{ display_numeric | default(false) | ternary(1, 0) }}

# Turn on/off the use of ANSI color codes in the display.
dan: {{ display_ansi | default(true) | ternary(1, 0) }}

# Path to info file. Sections separated by '@@@' are shown as transfer progresses.
inf: {{ info_file | default('') }}

# Color configuration — keywords: normal, black, red, green, yellow, blue, magenta, cyan, white

# Twiddle foreground color.
twfg: {{ twiddle_fg | default('normal') }}

# Twiddle background color.
twbg: {{ twiddle_bg | default('normal') }}

# Use bold font for the twiddle.
twb: {{ twiddle_bold | default(false) | ternary(1, 0) }}

# Title foreground color.
tifg: {{ title_fg | default('normal') }}

# Title background color.
tibg: {{ title_bg | default('normal') }}

# Use bold font for the title.
tib: {{ title_bold | default(false) | ternary(1, 0) }}

# Data count foreground color.
cfg: {{ count_fg | default('normal') }}

# Data count background color.
cbg: {{ count_bg | default('normal') }}

# Use bold font for the data count.
cb: {{ count_bold | default(false) | ternary(1, 0) }}

# Throughput label foreground color.
thlfg: {{ throughput_label_fg | default('normal') }}

# Throughput label background color.
thlbg: {{ throughput_label_bg | default('normal') }}

# Use bold font for the throughput label.
thlb: {{ throughput_label_bold | default(false) | ternary(1, 0) }}

# Throughput value foreground color.
thfg: {{ throughput_fg | default('normal') }}

# Throughput value background color.
thbg: {{ throughput_bg | default('normal') }}

# Use bold font for the throughput value.
thb: {{ throughput_bold | default(false) | ternary(1, 0) }}

# Time label foreground color.
tlfg: {{ time_label_fg | default('normal') }}

# Time label background color.
tlbg: {{ time_label_bg | default('normal') }}

# Use bold font for the time label.
tlb: {{ time_label_bold | default(false) | ternary(1, 0) }}

# Time value foreground color.
tfg: {{ time_fg | default('normal') }}

# Time value background color.
tbg: {{ time_bg | default('normal') }}

# Use bold font for the time value.
tb: {{ time_bold | default(false) | ternary(1, 0) }}

# Percent foreground color.
pfg: {{ percent_fg | default('normal') }}

# Percent background color.
pbg: {{ percent_bg | default('normal') }}

# Use bold font for the percent.
pb: {{ percent_bold | default(false) | ternary(1, 0) }}

# Bar brace (brackets around bar) foreground color.
bbfg: {{ bar_brace_fg | default('normal') }}

# Bar brace background color.
bbbg: {{ bar_brace_bg | default('normal') }}

# Use bold font for the bar braces.
bbb: {{ bar_brace_bold | default(false) | ternary(1, 0) }}

# Bar fill foreground color.
bfg: {{ bar_fg | default('normal') }}

# Bar fill background color.
bbg: {{ bar_bg | default('normal') }}

# Use bold font for the bar.
bb: {{ bar_bold | default(false) | ternary(1, 0) }}

# Open brace character for the progress bar.
bobc: {{ bar_openbrace_char | default('[') }}

# Close brace character for the progress bar.
bcbc: {{ bar_closebrace_char | default(']') }}

# Character used for the completed portion of the bar.
bcc: {{ bar_complete_char | default('#') }}

# Character used for the incomplete portion of the bar.
bic: {{ bar_incomplete_char | default('-') }}

# Background color used for spacing between display objects.
spbg: {{ space_bg | default('normal') }}