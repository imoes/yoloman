{
  "enabled": true,
  "debug": false,
  "auth_method": "basic",
  "server_url": "https://caldav.example.com/dav/user@example.com/",
  "username": "user@example.com",
  "display_name": "My Work Calendar",
  "use_ssl": true,
  "verify_ssl": true,
  "sync_interval": 1800,
  "timeout": 30,
  "max_retries": 3,
  "caldav_path": "",
  "supports_vcards": false,
  "supports_events": true,
  "supports_tasks": false,
  "calendars": [
    {
      "path": "/dav/user@example.com/Calendar/",
      "name": "Personal Calendar",
      "readonly": false
    },
    {
      "path": "/dav/user@example.com/Work/",
      "name": "Work Schedule",
      "readonly": true
    }
  ]
}
