# CalDAV Generic Plugin Configuration
# -------------------------------------
# This file configures the CalDAV plugin for lomiri-online-accounts.
# It uses a simple INI-like structure under the [General] section.
# Most boolean and string options have safe defaults provided via Jinja2 `default` filters.

[General]

# Enable the CalDAV plugin. If false, the plugin will not load.
{% if enabled | default(true) %}Enabled=true
{% else %}Enabled=false
{% endif %}

# Enable verbose debug logging. Only recommended for troubleshooting.
{% if debug | default(false) %}Debug=true
{% else %}Debug=false
{% endif %}

# Authentication method to use. Supported: 'basic', 'digest', 'oauth2', 'none'.
AuthMethod={{ auth_method | default('basic') }}

# Base URL of the CalDAV server (e.g., https://caldav.example.com/dav/user/). Required if not using auto-discovery.
ServerURL={{ server_url | default('') }}

# User identifier for authentication (often email address). Not used for OAuth2.
Username={{ username | default('') }}

# Human-readable account name shown in the UI. Falls back to username if omitted.
DisplayName={{ display_name | default('') }}

# Require encrypted (TLS/SSL) connections to the server.
{% if use_ssl | default(true) %}UseSSL=true
{% else %}UseSSL=false
{% endif %}

# Verify server certificate chain and hostname. Disable only for self-signed certs (not recommended).
{% if verify_ssl | default(true) %}VerifySSL=true
{% else %}VerifySSL=false
{% endif %}

# Interval (in seconds) between automatic sync attempts (minimum: 60).
SyncInterval={{ sync_interval | default(1800) }}

# Connection and request timeout in seconds.
Timeout={{ timeout | default(30) }}

# Maximum number of retries for failed sync attempts.
MaxRetries={{ max_retries | default(3) }}

# Optional override for CalDAV path if server uses a non-standard endpoint.
CalDAVPath={{ caldav_path | default('') }}

# Set to false if the server does not support CardDAV (vCards) for contacts.
{% if supports_vcards | default(true) %}SupportsVCards=true
{% else %}SupportsVCards=false
{% endif %}

# Set to false to disable calendar event synchronization.
{% if supports_events | default(true) %}SupportsEvents=true
{% else %}SupportsEvents=false
{% endif %}

# Enable task/ToDo synchronization (server must support Tasks extension).
{% if supports_tasks | default(false) %}SupportsTasks=true
{% else %}SupportsTasks=false
{% endif %}

# List of CalDAV calendars to automatically subscribe to during setup.
{% if calendars | default([]) | length > 0 %}
{% for cal in calendars %}
# Calendar entry: {{ loop.index }}
{% if cal.path | default('') %}{{ loop.index }}.Path={{ cal.path }}
{% endif %}
{% if cal.name | default('') %}{{ loop.index }}.Name={{ cal.name }}
{% endif %}
{% if cal.readonly | default(false) %}{{ loop.index }}.ReadOnly=true
{% else %}{{ loop.index }}.ReadOnly=false
{% endif %}
{% endfor %}{% endif %}