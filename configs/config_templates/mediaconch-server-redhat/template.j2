{
    # Whether to run the service as a background daemon process.
    # Default: true
    "Use_Daemon": {{ Use_Daemon | default(true) | lower }},

    # IP address for the daemon to listen on.
    # Default: 127.0.0.1
    "Daemon_Address": "{{ Daemon_Address | default('127.0.0.1') }}",

    # Port number for the daemon to listen on.
    # Default: 8080
    "Daemon_Port": {{ Daemon_Port | default(8080) }}
}
