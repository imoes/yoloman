# atmsigd.conf - configuration data for atmsigd
#
# This configuration file controls the behavior of the ATM SIG Daemon (atmsigd).
# It defines debugging parameters and the ATM Entity address used for signaling.
#
# See the atmsigd.conf man page for detailed configuration options.

# Debugging block: Controls verbosity and logging of atmsigd.
debug {
    # Level of debug output (e.g., debug, info, notice, warn, error, crit, alert, emerg)
    level {{ debug_level | default('warn') }}

    # Path where debug dumps are stored
    dump {{ debug_dump_path | default('/var/tmp') }}

    # Target for debug logging (e.g., syslog, file, stderr)
    log {{ debug_log_target | default('syslog') }}

    # Trace level value (integer)
    trace {{ debug_trace_value | default('100') }}
}

# Entity address: The NSAP (Network Service Access Point) address for this ATM entity.
# This is used for identification and signaling purposes within the ATM network.
entity {{ entity_address | default('0.0.5') }}
