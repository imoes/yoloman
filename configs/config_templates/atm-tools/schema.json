{
  "debug_level": {
    "type": "string",
    "default": "warn",
    "description": "Debug level (e.g., debug, info, notice, warn, error, crit, alert, emerg)",
    "enum": [
      "debug",
      "info",
      "warn"
    ],
    "enum_open": true
  },
  "debug_dump_path": {
    "type": "string",
    "default": "/var/tmp",
    "description": "Path where debug dumps are stored"
  },
  "debug_log_target": {
    "type": "string",
    "default": "syslog",
    "description": "Target for debug logging (e.g., syslog, file, stderr)",
    "enum": [
      "syslog",
      "file"
    ],
    "enum_open": true
  },
  "debug_trace_value": {
    "type": "number",
    "default": 100,
    "description": "Trace level value (integer)"
  },
  "entity_address": {
    "type": "string",
    "default": "0.0.5",
    "description": "Entity address (NSAP format)"
  }
}
