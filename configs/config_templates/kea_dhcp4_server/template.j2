# =============================================================================
# KEA DHCPv4 Server Configuration Template
# =============================================================================
# This template generates a valid JSON configuration file for the KEA DHCPv4
# server. It is self-documenting: every configuration directive is preceded by
# a comment describing its purpose and source variable.
#
# Variables used here map directly to the Ansible role's schema fields.
# All variables include safe defaults (`| default(...)`) to prevent render
# failures if a variable is undefined.
# =============================================================================

{
  "Dhcp4": {
    # Main DHCPv4 server block.

    # Command executed to reload the configuration via the KEA control agent.
    # This is a static string in KEA's standard config; not driven by a schema variable.
    "reload-command": "/usr/bin/kea-ctrl-agent -c /etc/kea/kea-ctrl-agent.conf reload",

    # Socket configuration for control-agent communication.
    # Static path for local Unix domain socket.
    "control-socket": {
      # Type of socket (unix or inet). KEA typically uses unix for local control.
      "socket-type": "unix",
      # Filesystem path to the Unix domain socket.
      "socket-name": "/var/run/kea/dhcp4-ctrl.sock"
    },

    # Network interfaces configuration.
    # List of interface names to listen on for DHCP requests.
    "interfaces-config": {
      # Interfaces list, quoted and comma-separated for JSON array syntax.
      "interfaces": [{{ (interfaces | default(['eth0'])) | map('quote') | join(', ') }}]
    },

    # Lease database backend configuration.
    # Determines where DHCP lease information is stored (memfile, mysql, postgresql, etc.).
    "lease-database": {
      # Database backend type. Defaults to 'memfile' (in-memory with file persistence).
      "type": "{{ (lease_db | default({'type': 'memfile', 'persist': True, 'lename': 'kea-leases4.csv'})).type }}",

      {% set _type = (lease_db | default({'type': 'memfile'})).type %}
      {% if _type == "memfile" %}
      # --- memfile backend specific settings ---
      # Enable persistence of lease data to disk on shutdown/reload.
      "persist": {{ (lease_db | default({'persist': True})).persist | lower }},
      # Filename for the CSV lease database.
      "lename": "{{ (lease_db | default({'lename': 'kea-leases4.csv'})).lename }}"
      {% elif _type == "mysql" or _type == "mariadb" %}
      # --- MySQL/MariaDB backend specific settings ---
      # MySQL server hostname or IP address.
      "host": "{{ (lease_db | default({})).host | default('127.0.0.1') }}",
      # MySQL server port.
      "port": {{ (lease_db | default({})).port | default(3306) }},
      # MySQL database username.
      "user": "{{ (lease_db | default({})).user | default('kea') }}",
      # MySQL database password.
      "password": "{{ (lease_db | default({})).password | default('') }}",
      # MySQL database name/schema.
      "name": "{{ (lease_db | default({})).name | default('kea') }}",
      # Enable multi-threaded database access.
      "auto-multi-thread": {{ (lease_db | default({})).auto_multi_thread | default(false) | lower }}
      {% elif _type == "postgresql" %}
      # --- PostgreSQL backend specific settings ---
      # PostgreSQL server hostname or IP address.
      "host": "{{ (lease_db | default({})).host | default('127.0.0.1') }}",
      # PostgreSQL server port.
      "port": {{ (lease_db | default({})).port | default(5432) }},
      # PostgreSQL database username.
      "user": "{{ (lease_db | default({})).user | default('kea') }}",
      # PostgreSQL database password.
      "password": "{{ (lease_db | default({})).password | default('') }}",
      # PostgreSQL database name/schema.
      "name": "{{ (lease_db | default({})).name | default('kea') }}",
      # Enable multi-threaded database access.
      "auto-multi-thread": {{ (lease_db | default({})).auto_multi_thread | default(false) | lower }}
      {% else %}
      # Fallback for other types (e.g., redis, etc.) if any are supported in future KEA versions.
      {% endif %}
    },

    # Hook libraries to load for extended functionality (DDNS, logging, accounting).
    "hooks-libraries": [
      {% for lib in (hooks_libraries | default([])) %}
      # Hook library entry
      {
        # Path to the shared object library (.so).
        "library": "{{ lib.library | default('') }}",
        # JSON parameters passed to the hook library.
        "parameters": {{ lib.parameters | default({}) | tojson }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],

    # List of IPv4 subnets served by this DHCP server.
    "subnet4": [
      {% for subnet in (subnets | default([{'id': 1, 'subnet': '192.0.2.0/24', 'pools': ['192.0.2.10 - 192.0.2.200'], 'option_data': [{'name': 'routers', 'data': ['192.0.2.1']}, {'name': 'domain-name-servers', 'data': ['192.0.2.1', '192.0.2.2']}], 'renew_timer': 300, 'rebind_timer': 1800, 'valid_lifetime': 3600, 'min_valid_lifetime': 1800, 'max_valid_lifetime': 7200}])) %}
      # Subnet definition
      {
        # Unique numeric identifier for this subnet configuration.
        "id": {{ subnet.id | default(1) }},
        # CIDR notation of the subnet (e.g., 10.0.0.0/24).
        "subnet": "{{ subnet.subnet | default('192.0.2.0/24') }}",
        # List of IP address ranges available for assignment.
        "pool": [
          {% for pool in (subnet.pools | default(['192.0.2.10 - 192.0.2.200'])) %}
          "{{ pool }}"{% if not loop.last %},{% endif %}
          {% endfor %}
        ],
        # DHCP options to send to clients (e.g., router, DNS servers).
        "option-data": [
          {% for opt in (subnet.option_data | default([{'name': 'routers', 'data': ['192.0.2.1']}, {'name': 'domain-name-servers', 'data': ['192.0.2.1', '192.0.2.2']}])) %}
          {
            # Option name (e.g., routers, domain-name-servers, domain-search).
            "name": "{{ opt.name | default('') }}",
            # Option data. Can be a single string or a list.
            "data": {% if opt.data is string %}"{{ opt.data }}"{% else %}"{{ opt.data | join(', ') }}"{% endif %}
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ],
        # Time in seconds before the client attempts to renew the lease (T1).
        "renew-timer": {{ subnet.renew_timer | default(300) }},
        # Time in seconds before the client attempts to rebind with any server (T2).
        "rebind-timer": {{ subnet.rebind_timer | default(1800) }},
        # Total time the lease is valid in seconds.
        "valid-lifetime": {{ subnet.valid_lifetime | default(3600) }},
        # Minimum valid lifetime allowed by the server.
        "min-valid-lifetime": {{ subnet.min_valid_lifetime | default(1800) }},
        # Maximum valid lifetime allowed by the server.
        "max-valid-lifetime": {{ subnet.max_valid_lifetime | default(7200) }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],

    # List of shared networks. Used when multiple subnets exist on the same physical LAN.
    "shared-networks": [
      {% for net in (shared_networks | default([])) %}
      {
        # Name of the shared network.
        "name": "{{ net.name | default('') }}",
        # List of subnets belonging to this shared network.
        "subnet4": [
          {% for subnet in (net.subnets | default([])) %}
          {
            # Unique numeric identifier for this subnet configuration.
            "id": {{ subnet.id | default(1) }},
            # CIDR notation of the subnet (e.g., 10.0.0.0/24).
            "subnet": "{{ subnet.subnet | default('') }}",
            # List of IP address ranges available for assignment.
            "pools": [
              {% for pool in (subnet.pools | default([])) %}
              {
                # Pool range definition.
                "pool": "{{ pool.pool | default('') }}",
                # DHCP options for this pool.
                "option-data": [
                  {% for opt in (pool.option_data | default([])) %}
                  {
                    "name": "{{ opt.name | default('') }}",
                    # Option data joined as a string.
                    "data": "{{ opt.data | join(', ') | default('') }}"
                  }{% if not loop.last %},{% endif %}
                  {% endfor %}
                ]
              }{% if not loop.last %},{% endif %}
              {% endfor %}
            ]
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ],
        # Time in seconds before the client attempts to renew the lease (T1).
        "renew-timer": {{ net.renew_timer | default(300) }},
        # Time in seconds before the client attempts to rebind with any server (T2).
        "rebind-timer": {{ net.rebind_timer | default(1800) }},
        # Total time the lease is valid in seconds.
        "valid-lifetime": {{ net.valid_lifetime | default(3600) }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],

    # Authoritative mode. If true, server responds with authoritative bit even if
    # the client's subnet is not locally configured. Useful for handling rogue servers.
    "authoritative": {{ authoritative | default(true) | lower }},

    # DHCP queue control settings to manage packet processing capacity.
    "dhcp-queue-control": {
      # Enable packet queueing.
      "enabled": {{ (dhcp_queue_control | default({'enabled': True, 'capacity': 1000})).enabled | lower }},
      # Maximum number of packets to queue.
      "capacity": {{ (dhcp_queue_control | default({'capacity': 1000})).capacity }}
    },

    # Logging configuration.
    "loggers": [
      {
        # Logger name.
        "name": "kea-dhcp4",
        # Output configuration.
        "output_options": [
          {
            # Destination for logs: 'stdout', 'stderr', or file path.
            "output": "{{ log_output | default('stdout') }}"
          }{% if (log_rotate | default('0') | string | length) > 0 %},
          {
            # Rotation strategy: '0' for no rotation, 'daily', 'weekly', or byte limit.
            "rotation": "{{ log_rotate | default('0') }}"
          }
          {% endif %}
        ],
        # Minimum severity level for logging (DEBUG, INFO, NOTICE, WARN, ERROR, FATAL).
        "severity": "{{ log_severity | default('INFO') }}",
        # Debug level (0-99). Higher values produce more verbose output.
        "debuglevel": {{ log_debuglevel | default(0) }}
      }
    ]
  }
}