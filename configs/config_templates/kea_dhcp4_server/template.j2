# KEA DHCPv4 server configuration file
# Generated by Jinja2 template engine
# This is the main configuration for kea-dhcp4-server
{
  "Dhcp4": {
    "reload-command": "/usr/bin/kea-ctrl-agent -c /etc/kea/kea-ctrl-agent.conf reload",
    "control-socket": {
      "socket-type": "unix",
      "socket-name": "/var/run/kea/dhcp4-ctrl.sock"
    },

    "interfaces-config": {
      "interfaces": [{{ interfaces | map('quote') | join(', ') }}]
    },

    "lease-database": {
      "type": "{{ lease_db.type }}",
{% if lease_db.type == "memfile" %}
      "persist": {{ lease_db.persist | lower }},
      "lename": "{{ lease_db.lename }}"
{% elif lease_db.type == "mysql" %}
      "host": "{{ lease_db.host }}",
      "port": {{ lease_db.port }},
      "user": "{{ lease_db.user }}",
      "password": "{{ lease_db.password }}",
      "name": "{{ lease_db.name }}",
      "auto-multi-thread": {{ lease_db.auto_multi_thread | lower }}
{% elif lease_db.type == "postgresql" %}
      "host": "{{ lease_db.host }}",
      "port": {{ lease_db.port }},
      "user": "{{ lease_db.user }}",
      "password": "{{ lease_db.password }}",
      "name": "{{ lease_db.name }}",
      "auto-multi-thread": {{ lease_db.auto_multi_thread | lower }}
{% endif %}
    },

    "hooks-libraries": [
{% for lib in hooks_libraries %}
      {
        "library": "{{ lib.library }}",
        "parameters": {{ lib.parameters | tojson }}
      }{% if not loop.last %},{% endif %}
{% endfor %}
    ],

    "subnet4": [
{% for subnet in subnets %}
      {
        "id": {{ subnet.id }},
        "subnet": "{{ subnet.subnet }}",
        "pool": [
{% for pool in subnet.pools %}
          "{{ pool }}"{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "option-data": [
{% for opt in subnet.option_data %}
          {
            "name": "{{ opt.name }}",
{% if opt.data is string %}
            "data": "{{ opt.data }}"
{% else %}
            "data": "{{ opt.data | join(', ') }}"
{% endif %}
          }{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "renew-timer": {{ subnet.renew_timer }},
        "rebind-timer": {{ subnet.rebind_timer }},
        "valid-lifetime": {{ subnet.valid_lifetime }},
        "min-valid-lifetime": {{ subnet.min_valid_lifetime }},
        "max-valid-lifetime": {{ subnet.max_valid_lifetime }}
      }{% if not loop.last %},{% endif %}
{% endfor %}
    ],

    "shared-networks": [
{% for net in shared_networks %}
      {
        "name": "{{ net.name }}",
        "subnet4": [
{% for subnet in net.subnets %}
          {
            "id": {{ subnet.id }},
            "subnet": "{{ subnet.subnet }}",
            "pools": [
{% for pool in subnet.pools %}
              {
                "pool": "{{ pool.pool }}",
                "option-data": [
{% for opt in pool.option_data %}
                  {
                    "name": "{{ opt.name }}",
                    "data": "{{ opt.data | join(', ') }}"
                  }{% if not loop.last %},{% endif %}
{% endfor %}
                ]
              }{% if not loop.last %},{% endif %}
{% endfor %}
            ]
          }{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "renew-timer": {{ net.renew_timer }},
        "rebind-timer": {{ net.rebind_timer }},
        "valid-lifetime": {{ net.valid_lifetime }}
      }{% if not loop.last %},{% endif %}
{% endfor %}
    ],

    "authoritative": {{ authoritative | lower }},
    "dhcp-queue-control": {
      "enabled": {{ dhcp_queue_control.enabled | lower }},
      "capacity": {{ dhcp_queue_control.capacity }}
    },
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output_options": [
          {
            "output": "{{ log_output }}"
{% if log_rotate | length > 0 %}
          },
          {
            "rotation": "{{ log_rotate }}"
{% endif %}
          }
        ],
        "severity": "{{ log_severity }}",
        "debuglevel": {{ log_debuglevel }}
      }
    ]
  }
}