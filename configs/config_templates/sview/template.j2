# sview configuration template
# This file is generated by Ansible. Do not edit manually.
#
# The SLURM_CONF variable points sview to the Slurm controller's
# configuration file so it can query accounting and scheduling data.
# Set via the SLURM_CONF environment variable or systemd drop-in.

# The location of the Slurm configuration file.
# Default: /etc/slurm/slurm.conf
SLURM_CONF={{ slurm_conf | default('/etc/slurm/slurm.conf') }}