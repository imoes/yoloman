{
  "heartbeat_interval": 20,
  "workers": 2,
  "ctable_size": 262144,
  "log_level": "info",
  "sync_mode": "firewall",
  "sync_interface": "eth1",
  "sync_protocol": "tcp",
  "sync_bind_address": "",
  "sync_port": 3780,
  "sync_multicast_group": "",
  "sync_siblings": [
    {
      "ip": "10.0.0.2",
      "port": 3780
    }
  ],
  "sync_flush_on_timeout": false,
  "sync_heartbeat_enabled": true,
  "log_target": "/var/log/conntrackd.log",
  "event_filters": [
    {
      "name": "Protocol",
      "value": "icmp"
    }
  ],
  "cache_tables": {
    "tcp": {
      "established": 432000,
      "close_wait": 60,
      "time_wait": 120
    },
    "udp": {
      "established": 180
    }
  },
  "nl_socket_buf_size": 131072,
  "nl_socket_buf_maxsize": 262144,
  "external_cache_enabled": false,
  "failover_mechanism": "active",
  "ha_node_id": 1,
  "ha_secret": "my-sync-secret-123"
}
