# Conntrackd configuration template.
# This file configures the conntrackd daemon, which synchronizes the kernel connection tracking
# table across a cluster of nodes.
# See conntrackd.conf(5) for detailed documentation on all directives.

General {
    # HashSize: Number of buckets in the cache hashtable.
    # A larger value reduces collision probability but increases memory usage.
    HashSize {{ hash_size | default('8192') }}

    # HashLimit: Maximum number of conntracks to cache in memory.
    # Must be appropriate for the expected number of concurrent connections.
    HashLimit {{ hash_limit | default('65535') }}

    # Syslog: Enable or disable syslog logging.
    # Accepted values are 'on' or 'off'.
    Syslog {{ syslog_mode | default('on') }}

    # LockFile: Path to the lockfile used to prevent multiple instances.
    LockFile {{ lockfile | default('/var/lock/conntrackd.lock') }}

    UNIX {
        # Path: Path to the UNIX socket file for local management commands.
        Path {{ unix_socket_path | default('/var/run/conntrackd.sock') }}

        # Backlog: Maximum number of pending connections for the UNIX socket.
        Backlog {{ unix_backlog | default('20') }}
    }

    # SocketBufferSize: Netlink event socket receive buffer size.
    SocketBufferSize {{ netlink_buffer_size | default('262142') }}

    # SocketBufferSizeMaxGrown: Netlink event socket buffer maximum growth size.
    # Controls how much the buffer can dynamically grow under high load.
    SocketBufferSizeMaxGrown {{ netlink_buffer_size_max_growth | default('655355') }}

    # Systemd: Enable systemd integration (e.g., Type=notify).
    # Accepted values are 'on' or 'off'.
    Systemd {{ systemd_mode | default('on') }}
}

Stats {
    # LogFile: Enable logging to the stats file or specify a path.
    # Use 'on' to enable default logging, 'off' to disable, or a filename for custom path.
    LogFile {{ log_file | default('on') }}
}
