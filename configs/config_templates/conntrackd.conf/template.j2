# Conntrackd configuration file
# Global settings for connection tracking synchronization
# 
# This file controls the behavior of conntrackd, including network interfaces,
# synchronization protocols (ctnetlink, broadcast, unicast), logging, and failover modes.
# 
# For full documentation, see `man 5 conntrackd.conf`.

# General daemon settings
General {
  # How often (in seconds) to send periodic heartbeat notifications
  #{% if heartbeat_interval is defined %}
  #{%   set heartbeat = heartbeat_interval %}
  #{% else %}
  #{%   set heartbeat = 20 %}
  #{% endif %}
  #{% if heartbeat == 0 %}
  #{%   comment 'Disabled (0) means no heartbeat' %}
  #{% endif %}
  #{% if heartbeat is defined %}
  #{%     echo '# Heartbeat interval (seconds)' %}
  #{%     echo 'Heartbeat ' heartbeat %}
  #{%   endif %}

  # Number of worker threads for event processing
  #{% if workers is defined %}
  #{%   set w = workers %}
  #{% else %}
  #{%   set w = 2 %}
  #{% endif %}
  #{% if w == 0 %}
  #{%     comment '0 = auto-detect (recommended)' %}
  #{% endif %}
  #{% if workers is defined or workers is not defined %}
  #{%     echo 'Workers ' w %}
  #{%   endif %}

  # Maximum size of connection tracking table entries to cache in memory
  #{% if ctable_size is defined %}
  #{%   set size = ctable_size %}
  #{% else %}
  #{%   set size = 262144 %}
  #{% endif %}
  #{% if size is defined %}
  #{%     echo 'CTTimeouts ' size %}
  #{%   endif %}

  #{% if log_level is defined %}
  #{%   echo 'LogLevel ' log_level %}
  #{% endif %}
}

