#!/bin/sh
# ==============================================================================
# Neutron L3 Agent Init Script
# This script manages the OpenStack Neutron L3 Agent service.
# It is generated by Ansible and should not be edited manually.
#
# Self-Documenting: All configurable variables are derived from Ansible variables
# with explicit defaults based on the project schema.
# ==============================================================================

### BEGIN INIT INFO
# Provides:          neutron-l3-agent
# Required-Start:    $network $local_fs $remote_fs $syslog
# Required-Stop:     $remote_fs
# Should-Start:      mysql postgresql rabbitmq-server keystone openvswitch-switch
# Should-Stop:       mysql postgresql rabbitmq-server keystone openvswitch-switch
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Neutron L3 agent
# Description:       Provide L3 agent for neutron
### END INIT INFO

# Author: Thomas Goirand <zigo@debian.org>

# Description: Human-readable description of the service for init system
DESC="OpenStack Neutron L3 agent (neutron-l3-agent)"

# Description: The name of the OpenStack project (e.g., neutron, nova, cinder).
# Used to scope directories, users, and configuration paths.
PROJECT_NAME={{ project_name | default('neutron') }}

# Description: The daemon name, derived from the project name.
NAME=${PROJECT_NAME}-l3-agent

# Description: Base configuration file for the L3 agent.
# The actual path is constructed dynamically.
# DAEMON_ARGS="--config-file=/etc/neutron/neutron.conf will be happened
# to DAEMON_ARGS later by openstack-pkg-tools"
DAEMON_ARGS="--config-file=/etc/${PROJECT_NAME}/l3_agent.ini"

# Description: Additional systemd-specific directives to inject.
CUSTOM_SYSTEMD_SERVICE_DIRECTIVES="KillMode=process"

# Description: Load additional agent-side configuration files from a drop-in directory.
# If this directory exists, all .ini files inside are loaded.
if [ -e /etc/${PROJECT_NAME}/agent.conf.d ] ; then
	DAEMON_ARGS="--config-dir=/etc/${PROJECT_NAME}/agent.conf.d ${DAEMON_ARGS}"
fi

# Description: Set the process name for RabbitMQ messaging tracing.
export OS_OSLO_MESSAGING_RABBIT__PROCESSNAME=neutron-l3-agent

# ==============================================================================
# The content after this line comes from openstack-pkg-tools
# and has been automatically added to a .init.in script, which
# contains only the descriptive part for the daemon. Everything
# else is standardized as a single unique script.
# ==============================================================================

# Author: Thomas Goirand <zigo@debian.org>
# Author: Ondřej Nový <novy@ondrej.org>

# Description: System PATH for the daemon execution environment.
# Should only include /usr/* if it runs after the mountnfs.sh script.
PATH=/sbin:/usr/sbin:/bin:/usr/bin

# ==============================================================================
# Optional UWSGI Configuration Block
# If UWSGI environment variables are set, this block configures the daemon
# to run via UWSGI instead of the native Python binary.
# ==============================================================================

# Check if UWSGI integration is requested via environment variables
if [ -n "${UWSGI_PORT}" ] && [ -n "${UWSGI_INI_PATH}" ] && [ -n "${UWSGI_INI_APP}" ] ; then
	# If the UWSGI ini file does not exist, exit gracefully
	if ! [ -f "${UWSGI_INI_APP}" ] ; then
		exit 0
	fi

	# Description: Locate the SSL private key file for HTTPS support.
	# Searches /etc/neutron/ssl/private for .pem files.
	if [ -d /etc/${PROJECT_NAME}/ssl/private ] ; then
		KEY_FILE=$(find /etc/${PROJECT_NAME}/ssl/private -type f -iname '*.pem' 2>/dev/null | head -n 1)
	fi

	# Description: Locate the SSL certificate file.
	# Checks Puppet/OpenStack standard locations.
	if [ -e /usr/local/share/ca-certificates/puppet_openstack.crt ] ; then
		# This is needed for puppet...
		CERT_FILE=/usr/local/share/ca-certificates/puppet_openstack.crt
	else
		if [ -d /etc/${PROJECT_NAME}/ssl/public ] ; then
			CERT_FILE=$(find /etc/${PROJECT_NAME}/ssl/public -type f -iname '*.crt' 2>/dev/null | head -n 1)
		fi
	fi

	# Description: Find the correct UWSGI binary for the installed Python version.
	# Sid doesn't have /usr/bin/uwsgi_python3, so we need
	# to search for a more specific daemon name. For stretch
	# /usr/bin/uwsgi_python3 is fine.
	for i in 3 35 36 37 38 39 310 311 312 313 314 315 316 317 318 319 ; do
		if [ -x /usr/bin/uwsgi_python${i} ] ; then
			DAEMON=/usr/bin/uwsgi_python${i}
		fi
	done

	# Description: Parse UWSGI bind configuration from an external ini file if specified.
	# Uses openstack-pkg-tools helper functions to extract IP, Port, and Worker count.
	if [ -n "${UWSGI_BIND_CONFIG_FILE}" ] && [ -r "${UWSGI_BIND_CONFIG_FILE}" ] && [ -n "${UWSGI_BIND_CONFIG_SECTION}" ] && [ -n "${UWSGI_BIND_CONFIG_IP_DIRECTIVE}" ] && [ -n "${UWSGI_BIND_CONFIG_PORT_DIRECTIVE}" ] && [ -r /usr/share/openstack-pkg-tools/pkgos_func ] ; then
		. /usr/share/openstack-pkg-tools/pkgos_func
		pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_IP_DIRECTIVE}
	        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
			UWSGI_BIND_IP=${RET}
		fi
		pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_PORT_DIRECTIVE}
	        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
			UWSGI_PORT=${RET}
		fi
		# Description: Determine the number of UWSGI worker processes.
		if [ -n "${UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE}" ] ; then
			pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE}
		        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
				UWSGI_PROCESSES=" --processes ${RET}"
			else
				# If we can't find the directive in the config file,
				# we fallback to the number of thread / 2.
				UWSGI_PROCESSES=" --processes "$(( $(nproc) / 2 ))
			fi
		fi

		# Description: Special handling for Swift object storage servers.
		# If configuring swift, loop through device directories to bind multiple ports.
		if [ "${UWSGI_BIND_CONFIG_FILE}" = "/etc/swift/object-server.conf" ] ; then
			pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} devices
			if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
				DEVICES_PATH=${RET}
				NUM_DEVICES=$(ls ${DEVICES_PATH} | wc -l)
				COUNT=0
				while [ "${COUNT}" != "${NUM_DEVICES}" ] ; do
					CUR_PORT=$(( ${UWSGI_PORT} + ${COUNT} ))
					BIND_PARAMS="${BIND_PARAMS} --http-socket ${UWSGI_BIND_IP}:${CUR_PORT}"
					COUNT=$(( ${COUNT} + 1 ))
				done
			fi
		fi
	else
		UWSGI_BIND_IP=""
	fi

	# Description: Construct DAEMON_ARGS for UWSGI execution.
	if [ -n "${BIND_PARAMS}" ] ; then
		DAEMON_ARGS="${BIND_PARAMS}${UWSGI_PROCESSES}"
	else
		# If SSL keys are present, use HTTPS socket, otherwise HTTP.
		if [ -n "${KEY_FILE}" ] && [ -n "${CERT_FILE}" ] ; then
			DAEMON_ARGS="--https-socket ${UWSGI_BIND_IP}:${UWSGI_PORT},${CERT_FILE},${KEY_FILE}${UWSGI_PROCESSES}"
		else
			DAEMON_ARGS="--http-socket ${UWSGI_BIND_IP}:${UWSGI_PORT}${UWSGI_PROCESSES}"
		fi
	fi

	DAEMON_ARGS="${DAEMON_ARGS} --ini ${UWSGI_INI_PATH}"
	NO_OPENSTACK_CONFIG_FILE_DAEMON_ARG=yes
	NO_OPENSTACK_LOGFILE_DAEMON_ARG=yes
fi

# Description: Default daemon binary path.
if [ -z "${DAEMON}" ] ; then
	DAEMON=/usr/bin/${NAME}
fi

# Description: PID file location for the running daemon.
PIDFILE=/var/run/${PROJECT_NAME}/${NAME}.pid

# Description: Script name, defaults to /etc/init.d/name.
if [ -z "${SCRIPTNAME}" ] ; then
	SCRIPTNAME=/etc/init.d/${NAME}
fi

# Description: System user to run the daemon as. Defaults to project name.
if [ -z "${SYSTEM_USER}" ] ; then
	SYSTEM_USER=${PROJECT_NAME}
fi

# Description: System group to run the daemon as. Defaults to project name.
if [ -z "${SYSTEM_GROUP}" ] ; then
	SYSTEM_GROUP=${PROJECT_NAME}
fi

# Description: Set chuid flag if not running as root.
if [ "${SYSTEM_USER}" != "root" ] ; then
	STARTDAEMON_CHUID="--chuid ${SYSTEM_USER}:${SYSTEM_GROUP}"
fi

# Description: Configuration file path. Defaults to /etc/neutron/neutron.conf.
if [ -z "${CONFIG_FILE}" ] ; then
	CONFIG_FILE=/etc/${PROJECT_NAME}/${PROJECT_NAME}.conf
fi

# Description: Log file path.
LOGFILE=/var/log/${PROJECT_NAME}/${NAME}.log

# Description: Add config-file argument unless explicitly disabled by UWSGI mode.
if [ -z "${NO_OPENSTACK_CONFIG_FILE_DAEMON_ARG}" ] ; then
	DAEMON_ARGS="--config-file=${CONFIG_FILE} ${DAEMON_ARGS}"
fi

# Exit if the package is not installed (daemon binary not found)
[ -x $DAEMON ] || exit 0

# Description: Create necessary directories if running as root.
# If ran as root, create /var/lock/X, /var/run/X and /var/cache/X as needed
if [ `whoami` = "root" ] ; then
	for i in lock run cache ; do
		mkdir -p /var/$i/${PROJECT_NAME}
		chown ${SYSTEM_USER}:${SYSTEM_GROUP} /var/$i/${PROJECT_NAME}
	done
fi

# Description: Load LSB init functions.
. /lib/lsb/init-functions

RET=0

# Description: Load default configuration overrides from /etc/default/openstack and /etc/default/$NAME.
# Manage log options: logfile and/or syslog, depending on user's choosing.
[ -r /etc/default/openstack ] && . /etc/default/openstack
[ -r /etc/default/$NAME ] && . /etc/default/$NAME

# If syslog is enabled, add the flag.
[ "x$USE_SYSLOG" = "xyes" ] && DAEMON_ARGS="$DAEMON_ARGS --use-syslog"

# If log file is enabled (and not disabled by UWSGI mode), add the flag.
if [ -z "${NO_OPENSTACK_LOGFILE_DAEMON_ARG}" ] ; then
	[ "x$USE_LOGFILE" != "xno" ] && DAEMON_ARGS="$DAEMON_ARGS --log-file=$LOGFILE"
fi

# ==============================================================================
# Service Actions
# ==============================================================================

do_start() {
	start-stop-daemon \
		--start \
		--quiet \
		--background ${STARTDAEMON_CHUID} \
		--make-pidfile --pidfile ${PIDFILE} \
		--chdir /var/lib/${PROJECT_NAME} \
		--startas $DAEMON \
		--test > /dev/null \
		|| return 1
	# Description: Start daemon with optional Python arguments.
	if [ -n "${PYARGV}" ] ; then
		start-stop-daemon \
			--start \
			--quiet \
			--background ${STARTDAEMON_CHUID} \
			--make-pidfile --pidfile ${PIDFILE} \
			--chdir /var/lib/${PROJECT_NAME} \
			--startas $DAEMON \
			-- $DAEMON_ARGS --pyargv "${PYARGV}" \
			|| return 2
	else
		start-stop-daemon \
			--start \
			--quiet \
			--background ${STARTDAEMON_CHUID} \
			--make-pidfile --pidfile ${PIDFILE} \
			--chdir /var/lib/${PROJECT_NAME} \
			--startas $DAEMON \
			-- $DAEMON_ARGS \
			|| return 2
	fi
}

do_stop() {
	start-stop-daemon \
		--stop \
		--quiet \
		--retry=TERM/30/KILL/5 \
		--pidfile $PIDFILE
	RETVAL=$?
	rm -f $PIDFILE
	return "$RETVAL"
}

do_systemd_start() {
	# Description: Set umask to ensure log files are created with 0644 mode bits.
	# Note we can't set 0026 to have files 0640, because that's going
	# to be in use in for example neutron-dhcp-agent, which makes it
	# so it wont be able to read /var/lib/neutron/external/pids/*.pid.haproxy
	# and then fail hardly. However, 0022 is enough, since the log
	# folders are owned by <project>:adm, so users don't have access
	# to it unless they are on the adm group, which is what we want.
	umask 0022
	if [ -n "${PYARGV}" ] ; then
		exec $DAEMON $DAEMON_ARGS --pyargv "${PYARGV}"
	else
		exec $DAEMON $DAEMON_ARGS
	fi
}

case "$1" in
start)
	log_daemon_msg "Starting $DESC" "$NAME"
	do_start
	case $? in
		0|1) log_end_msg 0 ; RET=$? ;;
		2)   log_end_msg 1 ; RET=$? ;;
	esac
;;
stop)
	log_daemon_msg "Stopping $DESC" "$NAME"
	do_stop
	case $? in
		0|1) log_end_msg 0 ; RET=$? ;;
		2)   log_end_msg 1 ; RET=$? ;;
	esac
;;
status)
	status_of_proc "$DAEMON" "$NAME"
	RET=$?
;;
systemd-start)
	do_systemd_start
;;  
show-args)
	# Description: Output the effective command line for debugging.
	if [ -n "${PYARGV}" ] ; then
		echo $DAEMON $DAEMON_ARGS --pyargv \"${PYARGV}\"
	else
		echo $DAEMON $DAEMON_ARGS
	fi
;;
restart|force-reload)
	log_daemon_msg "Restarting $DESC" "$NAME"
	do_stop
	case $? in
		0|1)
			do_start
			case $? in
				0) log_end_msg 0 ; RET=$? ;;
				1) log_end_msg 1 ; RET=$? ;; # Old process is still running
				*) log_end_msg 1 ; RET=$? ;; # Failed to start
			esac
		;;
		*) log_end_msg 1 ; RET=$? ;; # Failed to stop
	esac
;;
*)
	echo "Usage: $SCRIPTNAME {start|stop|status|restart|force-reload|systemd-start}" >&2
	RET=3
;;
esac

exit $RET