# Neutron L3 Agent Logrotate Configuration
# This template configures log rotation for the Neutron L3 Agent's HA (High Availability)
# keepalived state change logs. It ensures logs are rotated daily, compressed, and
# truncated to prevent issues with running daemons holding file descriptors open.

/var/lib/neutron/ha_confs/*/neutron-keepalived-state-change.log {
    # Rotate log files daily
    daily

    # Do not error if the log file is missing
    missingok

    # Compress old log files using gzip
    compress

    # Delay compression of the most recently rotated log file by one rotation cycle.
    # This allows services to finish writing to the compressed file if they haven't
    # fully released the file handle immediately.
    delaycompress

    # Copy the log file and then truncate the original to zero size.
    # This ensures the running neutron-l3-agent process continues to write to the
    # same file descriptor without needing to be restarted.
    copytruncate
}
