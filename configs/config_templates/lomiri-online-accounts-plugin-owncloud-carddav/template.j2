<?xml version="1.0" encoding="UTF-8"?>
<!-- Main profile configuration for Lomiri Online Accounts CardDAV plugin.
     This template generates the XML profile definition required by the Lomiri
     online-accounts service to manage CardDAV contact synchronization. -->
<profile name="{{ profile_name | default('lomiri-owncloud-carddav') }}"
         type="{{ profile_type | default('sync') }}" >
    <!-- Category for this profile: 'contacts' indicates this is a contact list service. -->
    <key value="{{ category_value | default('contacts') }}" name="category"/>
    
    <!-- Remote service name identifier used by the online accounts backend. -->
    <key value="{{ remote_service_name | default('lomiri-owncloud-carddav') }}" name="remote_service_name"/>
    
    <!-- Destination type: 'online' indicates remote storage rather than local. -->
    <key name="destinationtype" value="{{ destinationtype_value | default('online') }}"/>
    
    <!-- Whether the main profile is enabled. Defaults to false to avoid auto-enabling. -->
    <key name="enabled" value="{{ enabled_value | default('false') }}"/>
    
    <!-- Whether the main profile is hidden from general views. Defaults to false. -->
    <key name="hidden" value="{{ hidden_value | default('false') }}"/>
    
    <!-- Whether to use system accounts for authentication. Defaults to true. -->
    <key name="use_accounts" value="{{ use_accounts_value | default('true') }}"/>

    <!-- Client profile definition: handles the specifics of the CardDAV sync protocol. -->
    <profile type="{{ client_profile_type | default('client') }}" name="{{ client_profile_name | default('carddav') }}">
        <!-- Sync direction: 'two-way' allows changes on both client and server. -->
        <key value="{{ sync_direction_value | default('two-way') }}" name="Sync Direction"/>
        
        <!-- Sync protocol: 'carddav' specifies the CardDAV standard for contacts. -->
        <key value="{{ sync_protocol_value | default('carddav') }}" name="Sync Protocol"/>
        
        <!-- Sync transport: 'HTTP' is the standard transport for CardDAV. -->
        <key value="{{ sync_transport_value | default('HTTP') }}" name="Sync Transport"/>
        
        <!-- Conflict resolution policy: 'prefer remote' keeps server-side changes. -->
        <key value="{{ conflictpolicy_value | default('prefer remote') }}" name="conflictpolicy" />
    </profile>

    <!-- Schedule configuration for background synchronization tasks. -->
    <!-- 
      Note: If schedule_enabled is true, the interval and time settings become active.
      Defaults provide a daily sync at 5:00 AM for all days of the week.
    -->
    <schedule enabled="{{ schedule_enabled | default('false') }}"
              interval="{{ schedule_interval | default('') }}"
              days="{{ schedule_days | default('1,2,3,4,5,6,7') }}"
              syncconfiguredtime="{{ schedule_syncconfiguredtime | default('') }}"
              time="{{ schedule_time | default('05:00:00') }}" />
</profile>
