{
  "general": {
    "enabled": true,
    "interface": "eth0",
    "log_level": 3,
    "sync_interval": 60
  },
  "server": {
    "port": 123,
    "max_connections": 500,
    "broadcast_enabled": true,
    "broadcast_peers": [
      {
        "name": "local-subnet",
        "address": "255.255.255.255",
        "interval": 120
      }
    ],
    "peers": [
      {
        "name": "primary-ntp",
        "host": "0.pool.ntp.org",
        "key_id": 0
      },
      {
        "name": "secondary-ntp",
        "host": "192.168.1.1",
        "key_id": 1
      }
    ]
  },
  "security": {
    "auth_enabled": true,
    "keys_file": "/etc/jamnntpd/ntp.keys",
    "trusted_key": 1
  },
  "leap_seconds": {
    "leapfile": "/etc/jamnntpd/leap-seconds.list",
    "auto_leap": true
  }
}
