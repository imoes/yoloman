{
  "auth_admin_keep.value": false,
  "rules": [
    {
      "name": "allow-admin-group-management",
      "description": "Allow members of admin group to manage systemd units",
      "match_group": "wheel",
      "match_user": "",
      "actions": [
        "org.freedesktop.systemd1.manage-units",
        "org.freedesktop.systemd1.restart-unit",
        "org.freedesktop.systemd1.reload-unit"
      ]
    },
    {
      "name": "allow-networkctl-for-users",
      "description": "Allow all users to inspect network status",
      "match_user": "",
      "match_group": "",
      "actions": [
        "org.freedesktop.networkctl.list",
        "org.freedesktop.networkctl.show"
      ],
      "action_result": {
        "org.freedesktop.networkctl.list": "yes",
        "org.freedesktop.networkctl.show": "auth_admin"
      }
    }
  ],
  "action_result": {
    "org.freedesktop.networkctl.show": "auth_admin"
  }
}
