# Configuration for wlgreet, a login greeter wrapper for Wayland sessions.
# This file defines the command to launch the greeter and the default visual appearance.

# The command to execute for the login greeter.
# Default: /usr/sbin/wlgreet
exec "{{ wlgreet_command | default('/usr/sbin/wlgreet') }}; swaymsg exit"

# Bind Mod4+shift+e to launch swaynag for power management options.
# This provides a safe way to poweroff or reboot from the login screen.
bindsym Mod4+shift+e exec swaynag \
	-t warning \
	-m 'What do you want to do?' \
	-b 'Poweroff' 'systemctl poweroff -i' \
	-b 'Reboot' 'systemctl reboot -i'

# The default background color for outputs without a specific wallpaper.
# This acts as a fallback solid color if no image is set.
# Default: #333333
output * bg {{ default_wallpaper_color | default('#333333') }} solid_color

# Include additional configuration snippets from the system directories.
# These allow local administrators to override or extend the default behavior.
include /etc/sway/config.d/*
include /etc/greetd/sway-config.d/*
