#! /bin/sh
### BEGIN INIT INFO
# Provides:          zabbix-web-service
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start zabbix-web-service daemon
# Description: Start zabbix-web-service daemon
### END INIT INFO

NAME=zabbix_web_service
DAEMON=/usr/sbin/$NAME
# Exit if executable is not installed
[ -x $DAEMON ] || exit 0

# Directory for PID and runtime files.
# Default: /run/zabbix
DIR={{ run_directory | default('/run/zabbix') }}
PID=$DIR/$NAME.pid

# Signal and timeout policy for stopping the daemon.
# Format: SIGNAL/SECONDS/SIGNAL/SECONDS.
# Default: TERM/30/KILL/5
RETRY={{ daemon_retry_policy | default('TERM/30/KILL/5') }}

DAEMON_ARGS=" -c /etc/zabbix/zabbix_web_service.conf"
if [ -r "/etc/default/zabbix-web-service" ]; then
    . /etc/default/zabbix-web-service
fi

# Load the VERBOSE setting and other rcS variables
[ -f /etc/default/rcS ] && . /etc/default/rcS

# define LSB log_* functions.
. /lib/lsb/init-functions

_ev_ () {
  [ "$VERBOSE" = "no" ] || eval $@
}

[ -d "$DIR" ] || mkdir "$DIR"

# User and group to run the zabbix-web-service daemon as.
# Default user: zabbix
# Default group: zabbix
DAEMON_USER={{ daemon_user | default('zabbix') }}
DAEMON_GROUP={{ daemon_group | default('zabbix') }}

chown -R ${DAEMON_USER}:${DAEMON_GROUP} "$DIR"
export PATH="${PATH:+$PATH:}/usr/sbin:/sbin"

case "$1" in
  start)
    start-stop-daemon --start --pidfile $PID --exec $DAEMON --test --quiet > /dev/null
    [ $? -ne 0 ] && log_action_msg "$NAME is already running" && exit 0
    _ev_ log_action_begin_msg \"$NAME starting\"
    R=$(start-stop-daemon --start --pidfile $PID --make-pidfile --background --chuid ${DAEMON_USER}:${DAEMON_GROUP} --exec $DAEMON --oknodo -- $DAEMON_ARGS 2>&1) \
    && _ev_ log_action_end_msg 0 \"$R\" \
    || _ev_ log_action_end_msg 1 \"$R\"
  ;;
  stop)
    _ev_ log_action_begin_msg "$NAME stopping"
    R=$(start-stop-daemon --stop --pidfile $PID --exec $DAEMON --oknodo --retry=$RETRY 2>&1) \
    && _ev_ log_action_end_msg 0 \"$R\" \
    || _ev_ log_action_end_msg 1 \"$R\"
  ;;
  status)
    ## return status 0 if process is running.
    status_of_proc -p $PID "$DAEMON" "$NAME"
  ;;
  restart|force-reload)
    $0 stop
    $0 start
  ;;
  *)
    echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
    exit 1
  ;;
esac