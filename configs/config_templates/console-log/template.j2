# /etc/console-log.conf -- configuration file for console-log.
# see console-log.conf(5) for details

# TTY number for the first log entry block (default: 9)
tty {{ console_log_tty9 | default('9') }}

# uncomment next line if you want to chvt to the syslog on startup
#chvt yes

# Log file for the first log entry block (default: /var/log/syslog)
file {{ console_log_file9 | default('/var/log/syslog') }}

# Group ownership for the first log entry block (default: adm)
group {{ console_log_group9 | default('adm') }}

# TTY number for the second log entry block (default: 8)
tty {{ console_log_tty8 | default('8') }}

# Log files (space-separated) for the second log entry block (default: /var/log/exim4/mainlog /var/log/mail.log)
file {{ console_log_file8 | default('/var/log/exim4/mainlog /var/log/mail.log') }}

# Group ownership for the second log entry block (default: adm)
group {{ console_log_group8 | default('adm') }}