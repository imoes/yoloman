# efingerd configuration file
# This is the main configuration file for efingerd.
# It controls the behavior of the efingerd service, which provides
# finger-like information via TCP.

# Lifetime for spawned services in seconds (equivalent to man page option -t X; default 60).
# Controls how long child processes (e.g. for shell commands) are allowed to run.
timeout = {{ timeout | default(60) }}

# If true, do not lookup addresses, use IP numbers instead (equivalent to man page option -n).
# Disabling DNS lookups can improve performance and avoid delays if DNS is slow/unreliable.
n = {{ nlookup | default(False) | lower }}

# If true, do not display users' full names (equivalent to man page option -f).
# When disabled (default), efingerd may display the user's full name from the system.
f = {{ no_fullnames | default(False) | lower }}

# If true, ignore user-specific .efingerd file (equivalent to man page option -u).
# When disabled (default), efingerd reads per-user configuration files.
u = {{ ignore_efingerd | default(False) | lower }}