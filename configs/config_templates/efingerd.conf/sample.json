{
  "listen.address": "0.0.0.0",
  "listen.port": 79,
  "user": "efingerd",
  "group": "efingerd",
  "root": "/var/efingerd",
  "max_connections": 50,
  "verbose": true,
  "logfile": "/var/log/efingerd/efingerd.log",
  "db_path": "/etc/efingerd/users.db",
  "timeout": 60,
  "allow_anonymous": false,
  "allowed_ips": [
    "127.0.0.1",
    "10.0.0.0/8"
  ],
  "denied_ips": [
    "192.168.100.0/24"
  ],
  "response_templates": {
    "admin.*": "Admin account {{ user }}: restricted access.",
    ".*": "User {{ user }}: system account (no details available)."
  },
  "default_response": "User '{{ user }}' not found in database.",
  "ssl_enabled": true,
  "ssl_cert": "/etc/efingerd/ssl/fullchain.pem",
  "ssl_key": "/etc/efingerd/ssl/privkey.pem",
  "ipv6_enabled": true
}
