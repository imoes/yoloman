# ap51-flash configuration file
# This configuration controls the ap51-flash tool, used for flashing firmware onto Atheros AR933x/AR724x based devices (e.g., TP-Link TL-WR703N).

# Network interface to use for listening and injection.
# The interface must be in the UP state. It does not necessarily need an IP address.
# Default: eth0
INTERFACE={{ (interface | default('eth0')) }}

# List of paths to firmware image files.
# ap51-flash will scan these paths and select the first matching firmware for each detected device.
# Provide as a space-separated list of absolute paths.
# Default: empty list
IMAGES={{ images | default([]) | join(' ') }}