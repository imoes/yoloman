#
# Cron schedule expression (hour and minute) for starting the john password cracking cronjob.
# Default: '00 1' (start at 00:01 every day).
#
{{ cron_start_time | default('00 1') }}	* * *	root	[ -x /usr/share/john/cronjob ] && nice /usr/share/john/cronjob start

#
# Cron schedule expression (hour and minute) for stopping the john password cracking cronjob.
# Default: '00 7' (stop at 00:07 every day).
#
{{ cron_stop_time | default('00 7') }}	* * *	root	[ -x /usr/share/john/cronjob ] stop