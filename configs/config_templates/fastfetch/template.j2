# fastfetch JSON configuration template
# Auto-generated by Ansible. Do not edit manually.

{# -------------------------------------------------------------------------- #}
{# Root config object containing all fastfetch settings                         #}
{# -------------------------------------------------------------------------- #}
{% set _config = config | default({}) %}
{
{# Logo configuration                                                         #}
{# -------------------------------------------------------------------------- #}
{% if _config.logo is defined and _config.logo %}
  {# Logo source — built-in logo name or file path #}
  "logo": {
    {# Logo type (e.g., auto, file, raw, sixel, kitty, chafa, iterm) #}
    "type": "{{ (_config.logo.type | default('auto')) }}",
    {# Logo source — built-in logo name or file path #}
    "source": "{{ (_config.logo.source | default('arch')) }}",
    {# Logo width in characters (required for iTerm) #}
    "width": {{ (_config.logo.width | default(0)) }},
    {# Logo height in characters (required for iTerm) #}
    "height": {{ (_config.logo.height | default(0)) }},
    {# Preserve aspect ratio when resizing (iTerm only) #}
    "preserveAspectRatio": {{ (_config.logo.preserve_aspect_ratio | default(true) | lower) }},
    {# Logo left/right padding #}
    "padding": {{ (_config.logo.padding | default(0)) }},
    {# Left padding #}
    "paddingLeft": {{ (_config.logo.padding_left | default(0)) }},
    {# Right padding #}
    "paddingRight": {{ (_config.logo.padding_right | default(0)) }},
    {# Top padding #}
    "paddingTop": {{ (_config.logo.padding_top | default(0)) }},
    {# Print remaining logo lines if more than modules #}
    "printRemaining": {{ (_config.logo.print_remaining | default(false) | lower) }},
    {# Logo position (left/center/right) #}
    "position": "{{ (_config.logo.position | default('left')) }}",
    {# Regenerate image logo cache #}
    "recache": {{ (_config.logo.recache | default(false) | lower) }},
    {# Override colors in logo (keys: 1..9, values: color strings) #}
{% set _colors = (_config.logo.colors | default([])) %}
{% if _colors is mapping %}
    "colors": {
{% for k, v in _colors | dictsort %}
      "{{ k }}": "{{ v }}"{% if not loop.last %},{% endif %}
{% endfor %}
    }
{% else %}
    "colors": []
{% endif %}
  },
{% endif %}

{# Display configuration                                                      #}
{# -------------------------------------------------------------------------- #}
{% set _display = (_config.display | default({})) %}
{% if _display %}
  {# Display configuration #}
  "display": {
    {# Key-value separator #}
    "separator": "{{ (_display.separator | default(': ')) }}",

    {# Display color configuration #}
    "color": {
      {# Keys color #}
      "keys": "{{ (_display.color.keys | default('blue')) }}",
      {# Title color #}
      "title": "{{ (_display.color.title | default('red')) }}",
      {# Module output color #}
      "output": "{{ (_display.color.output | default('default')) }}",
      {# Separator color #}
      "separator": "{{ (_display.color.separator | default('default')) }}"
    },

    {# Display key configuration #}
    "key": {
      {# Align key width to N characters #}
      "width": {{ (_display.key.width | default(0)) }},
      {# Key left padding #}
      "paddingLeft": {{ (_display.key.padding_left | default(0)) }},
      {# Key type (string/icon) #}
      "type": "{{ (_display.key.type | default('string')) }}"
    },

    {# Print title, keys, and logo in bright color #}
    "brightColor": {{ (_display.bright_color | default(false) | lower) }},
    {# Print errors during execution #}
    "showErrors": {{ (_display.show_errors | default(false) | lower) }},
    {# Disable line wrapping #}
    "disableLinewrap": {{ (_display.disable_linewrap | default(false) | lower) }},
    {# Hide cursor during execution #}
    "hideCursor": {{ (_display.hide_cursor | default(true) | lower) }},

    {# Percentage output type (1=number, 2=bar, 3=both, 6=bar only, 9=colored number, 10=monochrome bar) #}
    "percentType": {{ (_display.percent_type | default(1)) }},
    {# Digits after decimal for percentages #}
    "percentNdigits": {{ (_display.percent_ndigits | default(1)) }},

    {# Percentage colors configuration #}
    "percentColors": {
      {# Green color for percentage bars/numbers #}
      "green": "{{ (_display.percent_colors.green | default('green')) }}",
      {# Yellow color for percentage bars/numbers #}
      "yellow": "{{ (_display.percent_colors.yellow | default('yellow')) }}",
      {# Red color for percentage bars/numbers #}
      "red": "{{ (_display.percent_colors.red | default('red')) }}"
    },

    {# Bar characters configuration #}
    "barChars": {
      {# Elapsed character in percentage bars #}
      "elapsed": "{{ (_display.bar_chars.elapsed | default('█')) }}",
      {# Total character in percentage bars #}
      "total": "{{ (_display.bar_chars.total | default('▁')) }}"
    },

    {# Bar borders configuration #}
    "barBorders": {
      {# Left border of percentage bars #}
      "left": "{{ (_display.bar_borders.left | default('[')) }}",
      {# Right border of percentage bars #}
      "right": "{{ (_display.bar_borders.right | default(']')) }}"
    },

    {# Width of percentage bars in characters #}
    "barWidth": {{ (_display.bar_width | default(20)) }},
    {# Digits after decimal for sizes #}
    "sizeNdigits": {{ (_display.size_ndigits | default(1)) }},
    {# Binary prefix for sizes (auto/k/M/G/T/P/E/Z/Y) #}
    "sizeBinaryPrefix": "{{ (_display.size_binary_prefix | default('auto')) }}",
    {# Maximum binary prefix (auto/k/M/G/T/P/E/Z/Y) #}
    "sizeMaxPrefix": "{{ (_display.size_max_prefix | default('auto')) }}",
    {# Digits after decimal for CPU/GPU frequency #}
    "freqNdigits": {{ (_display.freq_ndigits | default(2)) }},
    {# Temperature unit (celsius/fahrenheit) #}
    "tempUnit": "{{ (_display.temp_unit | default('celsius')) }}",
    {# Digits after decimal for temperature #}
    "tempNdigits": {{ (_display.temp_ndigits | default(1)) }},

    {# Temperature colors configuration #}
    "tempColors": {
      {# Green temperature color #}
      "green": "{{ (_display.temp_colors.green | default('green')) }}",
      {# Yellow temperature color #}
      "yellow": "{{ (_display.temp_colors.yellow | default('yellow')) }}",
      {# Red temperature color #}
      "red": "{{ (_display.temp_colors.red | default('red')) }}"
    },

    {# Show module timing in ms #}
    "stat": {{ (_display.stat | default(false) | lower) }},
    {# Disable colors (auto-detected by default) #}
    "pipe": {{ (_display.pipe | default(false) | lower) }}
  },
{% endif %}

{# Modules configuration                                                      #}
{# -------------------------------------------------------------------------- #}
{% set _modules = (_config.modules | default(['title', 'separator', 'os', 'kernel', 'uptime', 'memory'])) %}
  {# Modules to display; items may be strings (module names) or dicts for custom module config #}
  "modules": [
{% for _mod in _modules %}
{% if _mod is string %}
    "{{ _mod }}"{% if not loop.last %},{% endif %}
{% else %}
    {
      {# Module type (e.g., memory, disk, display, localip, battery, cpu, loadavg) #}
      "type": "{{ (_mod.type | default('memory')) }}",
      {# Format string for module output #}
      "format": "{{ (_mod.format | default('{used}/{total} ({used_percent}%)')) }}",
      {# Override key for module #}
      "key": "{{ (_mod.key | default('')) }}",
      {# Override key color for module #}
      "keyColor": "{{ (_mod.key_color | default('')) }}",
      {# Override key icon (for --key-type icon) #}
      "keyIcon": "{{ (_mod.key_icon | default('')) }}",
      {# Override output color for module #}
      "outputColor": "{{ (_mod.output_color | default('')) }}",
      {# Override key width for module #}
      "keyWidth": {{ (_mod.key_width | default(0)) }},
      {# Override percent type for module #}
      "percentType": {{ (_mod.percent_type | default(0)) }},
      {# Threshold for green percentage #}
      "percentGreen": {{ (_mod.percent_green | default(20)) }},
      {# Threshold for yellow percentage #}
      "percentYellow": {{ (_mod.percent_yellow | default(80)) }},
      {# Threshold for green temperature (°C) #}
      "tempGreen": {{ (_mod.temp_green | default(50)) }},
      {# Threshold for yellow temperature (°C) #}
      "tempYellow": {{ (_mod.temp_yellow | default(80)) }},
      {# Use FQDN in title module #}
      "titleFqdn": {{ (_mod.title_fqdn | default(false) | lower) }},
      {# Show regular volumes #}
      "diskShowRegular": {{ (_mod.disk_show_regular | default(true) | lower) }},
      {# Show external volumes #}
      "diskShowExternal": {{ (_mod.disk_show_external | default(true) | lower) }},
      {# Show hidden volumes #}
      "diskShowHidden": {{ (_mod.disk_show_hidden | default(false) | lower) }},
      {# Show subvolumes #}
      "diskShowSubvolumes": {{ (_mod.disk_show_subvolumes | default(false) | lower) }},
      {# Show read-only volumes #}
      "diskShowReadonly": {{ (_mod.disk_show_readonly | default(false) | lower) }},
      {# Show unknown volumes #}
      "diskShowUnknown": {{ (_mod.disk_show_unknown | default(false) | lower) }},
      {# Use f_bavail instead of f_bfree (for macOS) #}
      "diskUseAvailable": {{ (_mod.disk_use_available | default(false) | lower) }},
      {# Colon-separated list of folders to detect #}
      "diskFolders": "{{ (_mod.disk_folders | default(['/']) | join(';')) }}",
      {# Display module compactness (multi/single) #}
      "displayCompactType": "{{ (_mod.display_compact_type | default('multi')) }}",
      {# Show decimal refresh rates #}
      "displayPreciseRefreshRate": {{ (_mod.display_precise_refresh_rate | default(false) | lower) }},
      {# Display order (primary-first/connected-first) #}
      "displayOrder": "{{ (_mod.display_order | default('primary-first')) }}",
      {# Show disconnected Bluetooth devices #}
      "bluetoothShowDisconnected": {{ (_mod.bluetooth_show_disconnected | default(false) | lower) }},
      {# Colon-separated list of disabled package managers #}
      "packagesDisabled": "{{ (_mod.packages_disabled | default([]) | join(':')) }}",
      {# Show IPv4 addresses #}
      "localipShowIpv4": {{ (_mod.localip_show_ipv4 | default(true) | lower) }},
      {# Show IPv6 addresses #}
      "localipShowIpv6": {{ (_mod.localip_show_ipv6 | default(true) | lower) }},
      {# Show MAC addresses #}
      "localipShowMac": {{ (_mod.localip_show_mac | default(false) | lower) }},
      {# Show loopback addresses #}
      "localipShowLoop": {{ (_mod.localip_show_loop | default(false) | lower) }},
      {# Show MTU #}
      "localipShowMtu": {{ (_mod.localip_show_mtu | default(false) | lower) }},
      {# Show interface speed #}
      "localipShowSpeed": {{ (_mod.localip_show_speed | default(false) | lower) }},
      {# Show prefix length #}
      "localipShowPrefixLen": {{ (_mod.localip_show_prefix_len | default(false) | lower) }},
      {# Filter interfaces by name prefix #}
      "localipNamePrefix": "{{ (_mod.localip_name_prefix | default('')) }}",
      {# Show only default route interface #}
      "localipDefaultRouteOnly": {{ (_mod.localip_default_route_only | default(false) | lower) }},
      {# Show all IPs per interface #}
      "localipShowAllIps": {{ (_mod.localip_show_all_ips | default(false) | lower) }},
      {# Show interface flags #}
      "localipShowFlags": {{ (_mod.localip_show_flags | default(false) | lower) }},
      {# Show all IPs on one line #}
      "localipCompact": {{ (_mod.localip_compact | default(false) | lower) }},
      {# Filter network interfaces by name prefix #}
      "netioNamePrefix": "{{ (_mod.netio_name_prefix | default('')) }}",
      {# Show only default route interface #}
      "netioDefaultRouteOnly": {{ (_mod.netio_default_route_only | default(false) | lower) }},
      {# Detect total bytes instead of rate #}
      "netioDetectTotal": {{ (_mod.netio_detect_total | default(false) | lower) }},
      {# Wait time (ms) for network rate #}
      "netioWaitTime": {{ (_mod.netio_wait_time | default(500)) }},
      {# Public IP detection server URL #}
      "publicipUrl": "{{ (_mod.publicip_url | default('https://ipinfo.io/json')) }}",
      {# Use IPv6 for public IP detection #}
      "publicipIpv6": {{ (_mod.publicip_ipv6 | default(false) | lower) }},
      {# Location for weather (URI-encoded) #}
      "weatherLocation": "{{ (_mod.weather_location | default('New+York')) }}",
      {# Weather output format #}
      "weatherOutputFormat": "{{ (_mod.weather_output_format | default('{temp}°C, {humidity}%')) }}",
      {# Show all users on one line #}
      "usersCompact": {{ (_mod.users_compact | default(false) | lower) }},
      {# Show only current user #}
      "usersMyselfOnly": {{ (_mod.users_myself_only | default(false) | lower) }},
      {# Media player name (Linux) #}
      "playerName": "{{ (_mod.player_name | default('spotify')) }}",
      {# DDC/CI sleep time (ms) #}
      "brightnessDdccSleep": {{ (_mod.brightness_ddcci_sleep | default(20)) }},
      {# Show multiple brightness levels on one line #}
      "brightnessCompact": {{ (_mod.brightness_compact | default(true) | lower) }},
      {# Sound device types to show (all/output/input) #}
      "soundType": "{{ (_mod.sound_type | default('all')) }}",
      {# Use SetupAPI on Windows for battery info #}
      "batteryUseSetupApi": {{ (_mod.battery_use_setup_api | default(false) | lower) }},
      {# Show battery temperature #}
      "batteryTemp": {{ (_mod.battery_temp | default(false) | lower) }},
      {# Show CPU temperature #}
      "cpuTemp": {{ (_mod.cpu_temp | default(false) | lower) }},
      {# Show P-core/E-core frequencies #}
      "cpuShowPeCoreCount": {{ (_mod.cpu_show_pe_core_count | default(false) | lower) }},
      {# Show CPU caches on one line #}
      "cpucacheCompact": {{ (_mod.cpucache_compact | default(false) | lower) }},
      {# Show per-core CPU usage #}
      "cpuusageSeparate": {{ (_mod.cpuusage_separate | default(false) | lower) }},
      {# Wait time (ms) for CPU usage #}
      "cpuusageWaitTime": {{ (_mod.cpuusage_wait_time | default(1000)) }},
      {# Show GPU temperature #}
      "gpuTemp": {{ (_mod.gpu_temp | default(false) | lower) }},
      {# Use driver-specific GPU info #}
      "gpuDriverSpecific": {{ (_mod.gpu_driver_specific | default(false) | lower) }},
      {# GPU detection method (auto/nvidia/intel/amd/vulkan) #}
      "gpuDetectionMethod": "{{ (_mod.gpu_detection_method | default('auto')) }}",
      {# GPU types to hide (none/integrated/discrete) #}
      "gpuHideType": "{{ (_mod.gpu_hide_type | default('none')) }}",
      {# Digits after decimal for load average #}
      "loadavgNdigits": {{ (_mod.loadavg_ndigits | default(2)) }},
      {# Show load average on one line #}
      "loadavgCompact": {{ (_mod.loadavg_compact | default(false) | lower) }},
      {# DNS types to show (all/tcp/udp/tcp-and-udp) #}
      "dnsShowType": "{{ (_mod.dns_show_type | default('all')) }}",
      {# Shell for command module #}
      "commandShell": "{{ (_mod.command_shell | default('sh')) }}",
      {# Shell parameter for command module #}
      "commandParam": "{{ (_mod.command_param | default('-c')) }}",
      {# Key for command module #}
      "commandKey": "{{ (_mod.command_key | default('Command')) }}",
      {# Command text to execute #}
      "commandText": "{{ (_mod.command_text | default('uname -a')) }}",
      {# Color module symbol (block/number/both) #}
      "colorsSymbol": "{{ (_mod.colors_symbol | default('block')) }}",
      {# Padding before color symbol #}
      "colorsPaddingLeft": {{ (_mod.colors_padding_left | default(1)) }},
      {# Width of color blocks #}
      "colorsBlockWidth": {{ (_mod.colors_block_width | default(2)) }},
      {# Start of color block range (0–15) #}
      "colorsBlockRangeStart": {{ (_mod.colors_block_range_start | default(0)) }},
      {# End of color block range (0–15) #}
      "colorsBlockRangeEnd": {{ (_mod.colors_block_range_end | default(15)) }}
    }{% if not loop.last %},{% endif %}
{% endif %}
{% endfor %}
  ]
}