# /etc/incron.conf - incron daemon main configuration
# Defines system-wide settings and access control

# Maximum number of concurrent inotify watches per user (0 = system limit)
maxwatches = {{ max_watches }}

# Allow users/groups listed in /etc/incron.allow (if exists) to use incron
# Deny all others (default behavior if /etc/incron.deny is absent)
allow = {{ allow_users | join(',') | default('') }}

# Explicitly deny users listed in /etc/incron.deny (if exists)
# Ignored if /etc/incron.allow exists and is non-empty
deny = {{ deny_users | join(',') | default('') }}

# Use syslog for logging (true/false)
use_syslog = {{ use_syslog }}

# Log level: 0=error, 1=warn, 2=info, 3=debug
log_level = {{ log_level }}

# Path to the user table directory
user_table_dir = {{ user_table_dir }}
