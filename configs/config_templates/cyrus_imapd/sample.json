{
  "config": {
    "configfile": "/etc/imapd.conf",
    "servername": "mail.example.com",
    "sasl_pwcheck_path": "/usr/sbin/saslauthd",
    "auxprop_plugin": "sasldb",
    "services": {
      "lmtpunix": {
        "enabled": true
      },
      "lmtpunix_zm": {
        "enabled": false
      },
      "imap": {
        "enabled": true
      },
      "imaps": {
        "enabled": true
      },
      "pop3": {
        "enabled": false
      },
      "pop3s": {
        "enabled": false
      },
      "sieve": {
        "enabled": true
      },
      "saslauthd": {
        "enabled": true
      },
      "ctl_mboxlist": {
        "enabled": true
      },
      "ctl_deliver": {
        "enabled": true
      },
      "ctl_cyrusdb": {
        "enabled": true
      },
      "submit": {
        "enabled": false
      }
    },
    "loglevel": "notice",
    "lock_path": "/var/lib/imap/locks",
    "work_path": "/var/spool/imap",
    "ssl_cert_file": "/etc/ssl/certs/mail.example.com.crt",
    "ssl_key_file": "/etc/ssl/private/mail.example.com.key",
    "ssl_ca_file": "/etc/ssl/certs/ca-bundle.crt",
    "ssl_cipher_list": "ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384",
    "mboxlist_db": "sqlite",
    "unique_name_db": "sqlite",
    "timelimit": 900,
    "idletimelimit": 60,
    "defaultdomain": "example.com",
    "quota_default": "1073741824",
    "quota_warning": 85,
    "admin_sasl_name": "cyrus-admin",
    "allowplaintext": false
  }
}
