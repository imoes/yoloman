# /etc/krb5kdc/allow-extract -- List of principals for keytab retrieval.
#
# Any principal matching a regular expression in this file will be
# eligible for keytab retrieval through keytab-backend.  Be careful to
# anchor the regular expressions and include realm information if needed.
#
# This list is defined by the `allow_rules` variable. If `allow_rules` is
# not provided or is empty, the file will be empty (or contain only this
# header depending on upstream software behavior).
#
# Each item in `allow_rules` is treated as a string (regular expression).

{% for rule in (allow_rules | default([])) %}
{{ rule }}
{% endfor %}