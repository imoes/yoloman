{# abook is a console-based address book for Mutt. This is a minimal, production-sane configuration template. #}

{# Directory where abook stores its data files (e.g., abook.db, aliases) #}
set data_dir = {{ data_dir }}

{# Path to the main abook database file #}
set db_file = {{ db_file }}

{# Path to the address book alias file (used by Mutt via external command) #}
set alias_file = {{ alias_file }}

{# Format used when exporting aliases (mutt is the standard for Mutt compatibility) #}
set format = {{ format }}

{# Enable/disable pager for long output (0 = off, 1 = on) #}
set pager = {{ pager }}

{# Enable/disable color output (0 = off, 1 = on) #}
set color = {{ color }}

{# List of fields to display in interactive mode (e.g., name, email, nick) #}
{% for field in fields %}field {{ loop.index }} = {{ field }}
{% endfor %}

{# Optional: custom command to run when selecting an address (e.g., to insert into Mutt) #}
{% if select_command %}select_command = {{ select_command }}
{% endif %}

{# Optional: command to run when editing an entry (e.g., editor) #}
{% if edit_command %}edit_command = {{ edit_command }}
{% endif %}

{# Optional: custom output format string for mutt query (only if format = custom) #}
{% if outformatstr %}outformatstr = {{ outformatstr }}
{% endif %}
