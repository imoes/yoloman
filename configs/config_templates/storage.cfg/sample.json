{
  "storage_path": "/data/storage",
  "cache_enabled": true,
  "cache_path": "/data/cache",
  "cache_max_size_mb": 2048,
  "worker_threads": 8,
  "volumes": [
    {
      "name": "main",
      "path": "/mnt/storage/main",
      "read_only": false,
      "quota_gb": 1000
    },
    {
      "name": "archive",
      "path": "/mnt/storage/archive",
      "read_only": true,
      "quota_gb": 5000
    }
  ],
  "tiers": [
    {
      "name": "ssd",
      "path": "/mnt/tiers/ssd",
      "priority": 1
    },
    {
      "name": "hdd",
      "path": "/mnt/tiers/hdd",
      "priority": 2
    }
  ]
}
