{
  "ra_argus_server": {
    "type": "string",
    "default": null,
    "description": "Host and optional port for Argus server (format: hostname[:port])"
  },
  "ra_source_port": {
    "type": "string",
    "default": null,
    "description": "Source port for remote TCP connections"
  },
  "ra_print_man_records": {
    "type": "string",
    "default": "yes",
    "description": "Print management records by default",
    "enum": [
      "yes",
      "no"
    ]
  },
  "ra_print_event_records": {
    "type": "string",
    "default": "yes",
    "description": "Print event records by default",
    "enum": [
      "yes",
      "no"
    ]
  },
  "ra_generate_bin_mar_records": {
    "type": "string",
    "default": "yes",
    "description": "Generate start/stop management records for bin-like clients",
    "enum": [
      "yes",
      "no"
    ]
  },
  "ra_print_labels": {
    "type": "string",
    "default": "0",
    "description": "Number of lines between repeated headers (0 = once; -1 = none)",
    "enum": [
      "0",
      "-1"
    ],
    "enum_labels": {
      "0": "once",
      "-1": "none"
    }
  },
  "ra_field_specifier": {
    "type": "string",
    "default": null,
    "description": "Default field print specification"
  },
  "ra_field_delimiter": {
    "type": "string",
    "default": null,
    "description": "Field delimiter character (e.g., '\\t', ',')"
  },
  "ra_separate_addr_from_port_with_period": {
    "type": "string",
    "default": null,
    "description": "Use '.' between IP address and port",
    "enum": [
      "yes",
      "no"
    ]
  },
  "ra_field_width": {
    "type": "string",
    "default": null,
    "description": "Field width behavior: 'fixed' or 'variable'",
    "enum": [
      "fixed",
      "variable"
    ]
  },
  "ra_print_names": {
    "type": "string",
    "default": null,
    "description": "Name resolution level: 'none', 'proto', 'port', 'all'",
    "enum": [
      "none",
      "proto",
      "port",
      "all"
    ]
  },
  "ra_cidr_address_format": {
    "type": "string",
    "default": null,
    "description": "CIDR mask printing: 'no', 'yes', 'strict'",
    "enum": [
      "no",
      "yes",
      "strict"
    ]
  },
  "ra_asn_print_format": {
    "type": "string",
    "default": null,
    "description": "AS number format: 'asplain', 'asdot+', 'asdot'",
    "enum": [
      "asplain",
      "asdot+",
      "asdot"
    ]
  },
  "ra_print_response_data": {
    "type": "string",
    "default": null,
    "description": "Include protocol/state-specific response data",
    "enum": [
      "yes",
      "no"
    ]
  },
  "ra_print_unix_time": {
    "type": "string",
    "default": null,
    "description": "Print timestamps in Unix epoch seconds",
    "enum": [
      "yes",
      "no"
    ]
  },
  "ra_time_format": {
    "type": "string",
    "default": null,
    "description": "strftime-compatible timestamp format"
  },
  "ra_tz": {
    "type": "string",
    "default": null,
    "description": "Time zone string for timestamps (tzset(3) format)"
  },
  "ra_usec_precision": {
    "type": "string",
    "default": null,
    "description": "Decimal places for fractional seconds (0\u20136)"
  },
  "ra_userdata_encode": {
    "type": "string",
    "default": "Ascii",
    "description": "User data encoding: 'Ascii', 'Obfuscate', 'Hex', 'Encode64', 'Encode32'",
    "enum": [
      "Ascii",
      "Obfuscate",
      "Hex",
      "Encode64",
      "Encode32"
    ]
  },
  "ra_debug_level": {
    "type": "string",
    "default": null,
    "description": "Debug level (0\u2013N)"
  },
  "ra_connect_time": {
    "type": "string",
    "default": null,
    "description": "Connection timeout in seconds (5\u201360)"
  },
  "ra_filter": {
    "type": "string",
    "default": null,
    "description": "Filter expression"
  }
}
