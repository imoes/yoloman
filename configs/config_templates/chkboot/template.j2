#########################
##CHKBOOT Configuration##
#########################

#Device file of the boot disk
BOOTDISK={{ BOOTDISK | default('/dev/sda') }}

#Device file of the boot partition
BOOTPART={{ BOOTPART | default('/dev/sda1') }}

#Mount point of the boot partition
BOOTDIR={{ BOOTDIR | default('/boot') }}

#Directory to store CHKBOOT data and hash databases
CHKBOOT_DATA={{ CHKBOOT_DATA | default('/var/lib/chkboot') }}

#Filename for the alert file reporting boot changes
CHANGES_ALERT="{{ CHANGES_ALERT | default('boot-differences') }}"

#Filename for the log file tracking boot changes
CHANGES_LOG="{{ CHANGES_LOG | default('boot-differences-log') }}"

#Comma-separated list of alert styles to use (e.g., issue, profile)
# issue: appears at the top of vterms prior to loggin in
# profile: executes as a user's terminal session begins
CHKBOOT_STYLES="{{ CHKBOOT_STYLES | default('issue,profile') }}"

#ANSI color code for highlighting (e.g., 31 = red)
HIGHLIGHT_COLOUR="{{ HIGHLIGHT_COLOUR | default('31') }}"