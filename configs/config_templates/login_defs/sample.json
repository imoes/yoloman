{
  "password": {
    "pass_max_days": 90,
    "pass_min_days": 1,
    "pass_warn_age": 14
  },
  "ranges": {
    "uid_min": 1000,
    "uid_max": 60000,
    "gid_min": 1000,
    "gid_max": 60000,
    "sys_uid_min": 200,
    "sys_uid_max": 999,
    "sys_gid_min": 200,
    "sys_gid_max": 999
  },
  "defaults": {
    "def_shell": "/bin/bash",
    "def_home": "/home",
    "umask": "027",
    "usergroups_enab": true,
    "spool_dir": "/var/spool/mail",
    "groups_to_add": [
      "users"
    ]
  },
  "limits": {
    "login_retries": 3,
    "login_timeout": 30
  },
  "logging": {
    "faillog_enab": true,
    "log_unknown_fail": true,
    "log_ok_logins": false
  }
}
