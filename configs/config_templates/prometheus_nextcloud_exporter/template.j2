# Environment variables for prometheus-nextcloud-exporter
# URL to access the Nextcloud instance
NEXTCLOUD_URL="{{ nextcloud_url }}"

# Nextcloud app password (generated in Admin → Security → App passwords)
NEXTCLOUD_APP_PASSWORD="{{ nextcloud_app_password }}"

# Nextcloud admin username (or any user with 'monitoring' scope)
NEXTCLOUD_USER="{{ nextcloud_user }}"

# Skip TLS verification (set to 'true' for self-signed certs — NOT recommended in production)
NEXTCLOUD_SKIP_TLS="{{ nextcloud_skip_tls }}"

# Listen address (host:port) for the exporter HTTP server
LISTEN_ADDRESS="{{ listen_address }}"

# Metrics path (exposed endpoint for Prometheus to scrape)
METRICS_PATH="{{ metrics_path }}"

# Timeout (in seconds) for scraping the Nextcloud API
SCRAPE_TIMEOUT="{{ scrape_timeout }}"

# Enable debug logging (set to 'true' to increase verbosity)
DEBUG="{{ debug }}"

# Optional: List of extra metrics to collect (e.g., 'activity,files,quota')
{% if nextcloud_extra_metrics %}
# Additional metrics groups to expose
NEXTCLOUD_EXTRA_METRICS="{{ nextcloud_extra_metrics | join(' ') }}"
{% else %}
# No extra metrics groups configured
NEXTCLOUD_EXTRA_METRICS=""
{% endif %}
