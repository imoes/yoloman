# Environment variables for prometheus-nextcloud-exporter
#
# This file is generated by Ansible. Do NOT edit manually.
# Variables are sourced from the role's defaults and vars.
# All values use Jinja2 `default()` to ensure safe rendering even
# if a variable is undefined in the inventory.

# ---------------------------------------------------------------------------
# nextcloud_url: Base URL of the Nextcloud instance (required for all API
#                calls). Must include scheme (http or https).
# ---------------------------------------------------------------------------
NEXTCLOUD_URL="{{ (nextcloud_url | default('https://nextcloud.example.com')) }}"

# ---------------------------------------------------------------------------
# nextcloud_app_password: App password for authentication.
#                         Created in Nextcloud: Admin → Security → App passwords.
#                         Do NOT use your account password.
# ---------------------------------------------------------------------------
NEXTCLOUD_APP_PASSWORD="{{ (nextcloud_app_password | default('')) }}"

# ---------------------------------------------------------------------------
# nextcloud_user: Username of a Nextcloud user with monitoring permissions.
#                 Typically 'admin' or a dedicated service account.
# ---------------------------------------------------------------------------
NEXTCLOUD_USER="{{ (nextcloud_user | default('admin')) }}"

# ---------------------------------------------------------------------------
# nextcloud_skip_tls: Set to true to skip TLS certificate verification.
#                     Use ONLY for self-signed certificates during testing.
# ---------------------------------------------------------------------------
NEXTCLOUD_SKIP_TLS="{{ (nextcloud_skip_tls | default(false)) | lower }}"

# ---------------------------------------------------------------------------
# listen_address: Network interface and port the exporter listens on.
#                 Format: 'host:port' (e.g., '0.0.0.0:9205').
# ---------------------------------------------------------------------------
LISTEN_ADDRESS="{{ (listen_address | default('0.0.0.0:9205')) }}"

# ---------------------------------------------------------------------------
# metrics_path: HTTP path where metrics are exposed for Prometheus scraping.
#               Must be accessible to Prometheus server.
# ---------------------------------------------------------------------------
METRICS_PATH="{{ (metrics_path | default('/metrics')) }}"

# ---------------------------------------------------------------------------
# scrape_timeout: Maximum time (in seconds) to wait for Nextcloud API
#                 responses before timing out a scrape operation.
# ---------------------------------------------------------------------------
SCRAPE_TIMEOUT="{{ (scrape_timeout | default(30)) }}"

# ---------------------------------------------------------------------------
# debug: Enable verbose logging for debugging connection or parsing issues.
# ---------------------------------------------------------------------------
DEBUG="{{ (debug | default(false)) | lower }}"

# ---------------------------------------------------------------------------
# nextcloud_extra_metrics: List of extra metric categories to expose.
#                          Examples: 'activity', 'quota', 'files'.
#                          If empty, no extra metrics are added.
# ---------------------------------------------------------------------------
{% if (nextcloud_extra_metrics | default([])) | length > 0 %}
# Additional metrics groups to expose
NEXTCLOUD_EXTRA_METRICS="{{ (nextcloud_extra_metrics | default([])) | join(' ') }}"
{% else %}
# No extra metrics groups configured
NEXTCLOUD_EXTRA_METRICS=""
{% endif %}