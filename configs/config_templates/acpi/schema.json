{
  "acpi.enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable acpi configuration block"
  },
  "acpi.devices": {
    "type": "list",
    "default": [],
    "description": "List of devices to configure; each item defines how to display a specific device type"
  },
  "acpi.devices[].name": {
    "type": "string",
    "default": "",
    "description": "Device name (e.g., 'BAT0', 'thermal_zone0', 'cooling_device0', 'AC' etc.)"
  },
  "acpi.devices[].type": {
    "type": "string",
    "default": "battery",
    "description": "Device type: battery, thermal, cooling, ac-adapter",
    "enum": [
      "battery",
      "thermal",
      "cooling"
    ]
  },
  "acpi.devices[].show": {
    "type": "bool",
    "default": true,
    "description": "Whether to show device information"
  },
  "acpi.devices[].details": {
    "type": "bool",
    "default": false,
    "description": "Whether to show additional details (capacity, trip points)"
  },
  "acpi.temperature_unit": {
    "type": "string",
    "default": "celsius",
    "description": "Temperature unit: celsius, fahrenheit, kelvin",
    "enum": [
      "celsius",
      "fahrenheit",
      "kelvin"
    ]
  },
  "acpi.use_proc": {
    "type": "bool",
    "default": false,
    "description": "Use legacy /proc/acpi interface instead of /sys/class"
  },
  "acpi.show_empty": {
    "type": "bool",
    "default": false,
    "description": "Show non-operational (disabled) devices"
  }
}
