# This script configures the environment for Linux-HA (Heartbeat) resource agents.
# It sets directory paths for HA binaries, OCF agents, and manages default keepalive values.
# Variables are exported for use by subsequent HA scripts.

# Directory containing high-availability sbin utilities
# Schema default: /usr/sbin
: ${HA_SBIN_DIR:={{ ha_sbin_dir | default('/usr/sbin') }}}

# Directory containing non-architecture specific heartbeat binaries/scripts
# Schema default: /usr/share/heartbeat
: ${HA_NOARCHBIN:={{ ha_noarchbin | default('/usr/share/heartbeat') }}}

# Directory containing OCF resource agents
# Schema default: /usr/lib/ocf/resource.d/heartbeat/
: ${OCF_AGENTS:={{ ocf_agents | default('/usr/lib/ocf/resource.d/heartbeat/') }}}

# Export core HA environment variables
export HA_DIR HA_RCDIR HA_FIFO HA_BIN 
export HA_DEBUGLOG HA_LOGFILE HA_LOGFACILITY
export HA_DATEFMT HA_RESOURCEDIR HA_DOCDIR
export OCF_AGENTS

# Construct PATH with HA directories first
# Removes duplicate colons and leading colons for cleanliness
PATH=$HA_BIN:${HA_SBIN_DIR}:${HA_NOARCHBIN}:$PATH
PATH=`echo $PATH | sed -e 's%::%%' -e 's%:\.:%:%' -e 's%^:%%' -e 's%^\.:%' -e 's%^\.:%'`
export PATH

# A suitable echo command wrapper
Echo() {
  echo "$@"
}

# Copy stdin (text) to FIFO, with surrounding ">>>" and "<<<" marker lines.
# no args.; no result
# Notes:
#	Using "cat -" rather than "cat" simply for clarity.
#	The trailing "| cat -" tries to hold things together as a single
#	  write (which is probably preferable behaviour in this context).
ha_clustermsg() {
	(echo ">>>"; cat -; echo "<<<")	| cat - >> $HA_FIFO
}

# Retrieve a parameter from the HA config file ($HA_CF).
# If the parameter is not set, applies default logic for 'keepalive' and 'deadtime'.
ha_parameter() {
  VALUE=`sed -e 's%[ \t][ \t]*% %' -e 's%^ %%' -e 's%#.*%%'   $HA_CF |
  grep -i "^$1 " | sed 's%[^ ]* %%'`
  
  if [ "X$VALUE" = X ]
  then
    case $1 in
      keepalive)
        # Default keepalive interval in seconds
        # Schema default: 2
        VALUE={{ keepalive_default | default('2') }};;
      deadtime)
        # Calculate deadtime based on keepalive: (keepalive * 2) + 1
        ka=`ha_parameter keepalive`
        VALUE=`expr $ka '*' 2 '+' 1`;;
    esac
  fi
  Echo $VALUE
}

# BSD-style status check for HA processes
BSD_Status() {
  local base=${1##*/}
  local pid

  ret_status=`/bin/ps -ao pid,command | grep $base | sed 's/ .*//'`

  if [ "$ret_status" != "" ]
  then
    echo "${base} is running..."
    return 0
  fi

  if [ -f $HA_VARRUN/${base}.pid ] 
  then
    echo "${base} dead but pid file exists"
    return 1
  fi

  if [ -f /var/run/${base}.pid ] 
  then
    echo "${base} dead but pid file exists"
    return 1
  fi

  if [ -f $HA_VARLOCK/${base}.pid ] 
  then
    echo "${base} dead but lock file exists"
    return 2
  fi

  if [ -f /var/spool/lock/${base} ] 
  then
    echo "${base} dead but lock file exists"
    return 2
  fi
}

# Source the OCF shell functions library
# Now get the good stuff
. /usr/lib/ocf/lib/heartbeat/ocf-shellfuncs
