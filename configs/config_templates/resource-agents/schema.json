{
  "ha_sbin_dir": {
    "type": "string",
    "default": "/usr/sbin",
    "description": "Directory containing high-availability sbin utilities"
  },
  "ha_noarchbin": {
    "type": "string",
    "default": "/usr/share/heartbeat",
    "description": "Directory containing non-architecture specific heartbeat binaries/scripts"
  },
  "ocf_agents": {
    "type": "string",
    "default": "/usr/lib/ocf/resource.d/heartbeat/",
    "description": "Directory containing OCF resource agents"
  },
  "keepalive_default": {
    "type": "number",
    "default": 2,
    "description": "Default keepalive interval in seconds"
  }
}
