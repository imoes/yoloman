[main]
# The Puppet configuration directory
confdir = /etc/puppetlabs/puppet

# The Puppet runtime directory
puppetdir = /opt/puppetlabs/puppet/cache

# The location of the Puppet SSL directory
ssldir = /etc/puppetlabs/puppet/ssl

# The Puppet log directory
logdir = /var/log/puppetlabs/puppet

# The directory where Puppet stores its PID files
rundir = /opt/puppetlabs/puppet/run

# The directory where Puppet stores its facter facts
vardir = /opt/puppetlabs/puppet/lib/facter

# The directory where Puppet stores its modules
modulepath = /etc/puppetlabs/code/modules:/opt/puppetlabs/puppet/modules

# The location of the Puppet manifest file
manifest = /etc/puppetlabs/code/environments/production/manifests/site.pp

# The environment in which the agent is running
environment = production

# The timeout for configuration retrieval
environment_timeout = unlimited

# Whether to auto-enroll certificates (if using Puppet CA)
auto_sign = false

# Whether to use certificate revocation lists (CRL) if available
use_cached_crl = true

# Whether to submit reports to the Puppet master
report = true

# How often the agent checks in (seconds)
runinterval = 1800

# Whether to use Splay for staggering agent runs
splay = true

# Destination for logs
logdest = /var/log/puppetlabs/puppet/puppet.log

# Whether to use syslog for logging
syslog = false

# Whether to use daemon mode
daemon = true

# Whether to run in test mode
test = false

# Certnames that are ignorable
ignorable_certnames =

# The unique identifier (FQDN or custom name) for this Puppet node. Must be unique per agent and match DNS/Cert SANs.
{% if certname is defined and certname %}
certname = {{ certname }}
{% else %}
certname = {{ ansible_hostname | default('puppet-agent') }}
{% endif %}

# The DNS alt names to request in the CSR (comma-separated)
# List of DNS alt names to include in the SSL certificate request (e.g., ['puppet.example.com', 'puppet'] ). Must include at least the certname
{% if subject_alt_names is defined and subject_alt_names | length > 0 %}
subject_alt_names = {{ subject_alt_names | join(', ') }}
{% else %}
# subject_alt_names =
{% endif %}

# The maximum time (in seconds) to wait for a response from the server
timeout = 300

# The number of times to retry connecting to the server before failing
max_wait_between_retries = 30

# Whether to use HTTP/2 (if server supports it)
use_http2 = true

# Whether to use HTTP proxies (set http_proxy env var if needed)
use_http_proxy = false

[agent]
# Reiterate key agent-specific settings for clarity
# Hostname (or DNS alias) of the primary Puppet server. Used for configuration retrieval and reporting.
server = {{ server_hostname | default('puppet') }}

# Hostname of the dedicated Puppet CA server (optional; defaults to same as server_hostname if not set). Leave empty to use the same server.
{% if ca_server_hostname is defined and ca_server_hostname %}
ca_server = {{ ca_server_hostname }}
{% else %}
# ca_server = {{ server_hostname | default('puppet') }}
{% endif %}

environment = production
runinterval = 1800
splay = true
report = true
daemon = true
logdest = /var/log/puppetlabs/puppet/puppet.log

# Whether to use the Puppet CA to sign certificates
# (if set to 'false', certificates must be signed externally or via auto_sign)
# Whether to use the built-in Puppet CA to sign node certificates. Set to false if using an external CA (e.g., ACM, HashiCorp Vault).
ca = {{ ca_enabled | default(true) | string | lower }}

# Whether to use certificate revocation checking
# Whether to enable certificate revocation checking using CRLs. Requires a configured CA and valid CRL distribution points.
use_revocation = {{ cert_revocation_enabled | default(false) | string | lower }}

# Whether to refresh certificates automatically when close to expiry
certificate_refresh = true