# Sympa Logging Configuration
# This template configures where Sympa sends its log messages.

# {{ log_level | default('local1.*') }}
# Syslog facility and priority for Sympa logging.
# Defines the syslog facility (e.g., local1) and priority level (e.g., *, info, err).
{% set log_level = log_level | default('local1.*') %}
{% set log_file = log_file | default('/var/log/sympa.log') %}

# {{ log_file | default('/var/log/sympa.log') }}
# Path to the Sympa log file.
# Absolute path to the file where Sympa will write its logs.
# Note: Ensure the Sympa process user has write permissions to this file and its parent directory.
log_level: {{ log_level }}
log_file: {{ log_file }}
