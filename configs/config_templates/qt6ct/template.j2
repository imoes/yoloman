# Qt6 Configuration Tool (qt6ct) settings file
# This file is managed by Ansible. Do not edit manually.
# Structure follows standard INI format with sections for
# General appearance, Fonts, Icons, and Main/Advanced settings.

[General]
# Name of the Qt6 theme to apply. Common options include 'kvantum', 'breeze', 'oxygen', 'gtk2'.
# See schema for 'theme'.
theme = {{ (qt6ct_theme | default('kvantum')) }}

# Name of the style plugin to use. Common options include 'kvantum', 'qtcurve', 'gtk2', 'gtk3', 'breeze'.
# See schema for 'style'.
style = {{ (qt6ct_style | default('kvantum')) }}

[Fonts]
# Configuration for font settings. This variable is a list of font config objects.
# The schema defines 'fonts' as a list. INI format does not natively support nested objects/lists
# in a flat key=value way without custom parsing by the application.
# Since no specific scalar keys (like fonts_general, fonts_titlebar) are provided in the schema,
# this section is left with standard defaults or commented out to avoid invalid config generation.
# If specific font overrides are needed, they must be mapped as scalar variables in the schema.
# {{ qt6ct_fonts | default([]) }}

[Icons]
# Configuration for icon settings. This variable is a list of icon config objects.
# Similarly to fonts, 'icons' is a list of objects. Without scalar fields like icons_size,
# we cannot generate specific key-value pairs. The section is left blank/commented.
# {{ qt6ct_icons | default([]) }}

[Main]
# Configuration for main/general settings. This variable is a list of main config objects.
# 'auto_reload' and 'plugins_path' are not scalar fields in the schema.
# We omit these keys as they cannot be derived from the schema 'main' list without further contract.
# {{ qt6ct_main | default([]) }}