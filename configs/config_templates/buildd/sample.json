{
  "base_dir": "/var/lib/buildd",
  "port": 8001,
  "bind_addr": "127.0.0.1",
  "max_jobs": 2,
  "max_log_size": 100,
  "log_retention_days": 30,
  "debug": false,
  "architectures": [
    "amd64",
    "arm64"
  ],
  "suites": [
    "unstable",
    "testing"
  ],
  "upload_host": "upload.debian.org",
  "upload_keyfile": "/var/lib/buildd/.ssh/id_rsa",
  "apt_sources": [
    {
      "url": "http://deb.debian.org/debian",
      "suite": "unstable",
      "components": [
        "main",
        "contrib",
        "non-free"
      ],
      "keyring": "/usr/share/keyrings/debian-archive-keyring.gpg",
      "comment": "Debian unstable main"
    },
    {
      "url": "http://deb.debian.org/debian-security",
      "suite": "bullseye-security",
      "components": [
        "main"
      ],
      "keyring": "/usr/share/keyrings/debian-archive-keyring.gpg",
      "comment": "Debian security updates"
    }
  ],
  "keyring_dir": "/usr/share/keyrings",
  "auto_accept": true,
  "buildcmd": ""
}
