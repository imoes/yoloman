# Default settings for smartdns server. This file is sourced by /bin/sh from
# /etc/init.d/smartdns.

# Options to pass to smartdns
# This variable allows overriding the default command-line flags for the smartdns daemon.
# Common options might include `-v` for verbose logging or `-f` for foreground mode.
SMART_DNS_OPTS="{{ smart_dns_opts | default('') }}"