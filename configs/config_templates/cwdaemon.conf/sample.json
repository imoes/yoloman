{
  "cwdaemon_port": 6789,
  "ptt_device": "/dev/ttyUSB0",
  "ptt_type": "serial",
  "enable_speed_control": true,
  "min_speed": 5,
  "max_speed": 50,
  "default_speed": 25,
  "enable_qsk": false,
  "tone_release_delay": 30,
  "key_input_device": "/dev/input/event2",
  "enable_console": true,
  "log_level": 2,
  "firmware_path": "/usr/share/cwdaemon/rtlsdr-keyer.bin",
  "allowed_ips": [
    "127.0.0.1/32",
    "192.168.100.0/24"
  ],
  "blocked_ips": [
    "10.0.0.0/8"
  ],
  "outgoing_prefix": "[CW]",
  "enable_syslog": true
}
