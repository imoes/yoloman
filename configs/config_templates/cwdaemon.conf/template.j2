[cwdaemon]
# UDP port on which cwdaemon listens for incoming Morse code commands.
port = {{ (cwdaemon_port | default(6789)) }}

# Device file used for CW keying control, e.g., a parallel port, serial port, or USB device.
device = {{ (ptt_device | default('/dev/parport0')) }}

# Type of PTT interface: 'serial', 'parallel', 'USB', or 'none'. Note: The man page does not explicitly list 'USB' as a ptt_type string value,
ptt_type = {{ (ptt_type | default('parallel')) }}

# Enable local console (TTY) output
enable_console = {{ (enable_console | default('false') | lower) }}

# Console log level: 0=error, 1=warn, 2=info, 3=debug
log_level = {{ (log_level | default('1')) }}

# Minimum and maximum CW speed (WPM)
min_speed = {{ (min_speed | default('10')) }}
max_speed = {{ (max_speed | default('25')) }}

# Default CW speed (WPM)
default_speed = {{ (default_speed | default('15')) }}

# Delay after tone release (ms)
tone_release_delay = {{ (tone_release_delay | default('0')) }}

# If enabled, send logs to the system syslog daemon.
enable_syslog = {{ (enable_syslog | default(true) | lower) }}

# Prefix prepended to all outgoing messages (e.g., for identification).
outgoing_prefix = {{ (outgoing_prefix | default('CW>')) }}