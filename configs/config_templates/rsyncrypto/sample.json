{
  "source_dir": "/home/user/documents",
  "dest_dir": "/mnt/backup/documents.enc",
  "keys_dir": "/mnt/backup/keys",
  "public_key_path": "/etc/rsyncrypto/server.crt",
  "trim_level": 0,
  "name_encrypt_map": "/mnt/backup/filemap",
  "ne_nesting": 2,
  "recurse": true,
  "check_changed": true,
  "modify_window": 2,
  "no_archive": false,
  "gzip_path": "/usr/bin/rsyncable-gzip",
  "delete": true,
  "delete_keys": true,
  "key_bits": 256,
  "no_atime": 2,
  "verbose_count": 1,
  "export_changes_log": "/var/log/rsyncrypto-changes.log",
  "mode": "recursive"
}
