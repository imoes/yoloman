{
  "openhpi_user": "openhpi",
  "openhpi_group": "openhpi",
  "openhpi_pidfile": "/run/openhpid.pid",
  "openhpi_loglevel": "NOTICE",
  "openhpi_logfile": "/var/log/openhpid.log",
  "openhpi_log_rotation_count": 7,
  "openhpi_log_rotation_max_size": 20971520,
  "openhpi_transport_plugins": [
    {
      "name": "ipmi",
      "options": {
        "DevicePath": "/dev/ipmi0",
        "RetryCount": 3,
        "RetryTimeout": 2000
      }
    },
    {
      "name": "redfish",
      "options": {
        "Timeout": 15,
        "MaxRetries": 2,
        "InsecureSkipVerify": false
      }
    }
  ],
  "openhpi_auto_load_resources": true,
  "openhpi_scan_interval": 300,
  "openhpi_snmp_discovery": {
    "enabled": true,
    "community": "public",
    "subnets": [
      "192.168.1.0/24",
      "10.0.0.0/24"
    ]
  },
  "openhpi_ipmi_discovery": {
    "enabled": false,
    "subnets": []
  },
  "openhpi_redfish_discovery": {
    "enabled": true,
    "ssl_verify": true,
    "timeout": 10,
    "hosts": [
      "https://bmc1.example.com",
      "https://bmc2.example.com"
    ]
  },
  "openhpi_max_sessions": 100,
  "openhpi_max_sessions_per_user": 20,
  "openhpi_session_timeout": 600
}
