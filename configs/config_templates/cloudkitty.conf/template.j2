[DEFAULT]
# Logging configuration
log_dir = /var/log/cloudkitty
log_file = cloudkitty.log
log_format = %(asctime)s %(levelname)s %(name)s: %(message)s
log_date_format = %Y-%m-%d %H:%M:%S

# Debug mode toggle
# Enable debug logging and verbose output
debug = {{ debug | lower }}

# Verbose logging level
# Increase log verbosity (implies debug if enabled)
verbose = {{ verbose | lower }}

[auth]
# Authentication backend configuration
# Which auth plugin to use (e.g., keystone, none)
auth_type = {{ auth.auth_type }}

# Keystone-specific auth settings (if auth_type = keystone)
auth_url = {{ auth.auth_url }}
project_domain_name = {{ auth.project_domain_name }}
project_name = {{ auth.project_name }}
user_domain_name = {{ auth.user_domain_name }}
username = {{ auth.username }}
password = {{ auth.password }}

[storage]
# Storage backend configuration
# Storage backend module name
backend = {{ storage.backend }}

# Storage connection string (e.g., for SQLAlchemy)
connection = {{ storage.connection }}

# Number of retry attempts on storage failure
retry_attempts = {{ storage.retry_attempts }}

# Delay between retries (seconds)
retry_delay = {{ storage.retry_delay }}

[prometheus]
# Prometheus collector configuration
enabled = {{ prometheus.enabled | lower }}
endpoint = {{ prometheus.endpoint }}
query_path = {{ prometheus.query_path }}

[collector]
# Metrics collector configuration
# List of metrics to collect
metrics = [{% for metric in collector.metrics %}
  {{ metric | tojson }}{% if not loop.last %},{% endif %}{% endfor %}
]

[fetcher]
# Fetcher module configuration
# Source of metrics data
module = {{ fetcher.module }}

[reporting]
# Reporting configuration
# Path where monthly reports are written
report_dir = {{ reporting.report_dir }}
report_period = {{ reporting.report_period }}

[api]
# API server configuration
# Host and port to bind the CloudKitty API
host = {{ api.host }}
port = {{ api.port }}

# Enable TLS/SSL for the API
ssl_cert = {{ api.ssl_cert }}
ssl_key = {{ api.ssl_key }}

# Number of workers for the API service
workers = {{ api.workers }}

# Enable CORS
enable_cors = {{ api.enable_cors | lower }}

[cinder]
# Cinder integration (for volume-based rating)
enabled = {{ cinder.enabled | lower }}
endpoint_type = {{ cinder.endpoint_type }}

[glance]
# Glance integration (for image-based rating)
enabled = {{ glance.enabled | lower }}
endpoint_type = {{ glance.endpoint_type }}

[keystone]
# Keystone integration for identity and auth (if not using [auth] block)
enabled = {{ keystone.enabled | lower }}
endpoint_type = {{ keystone.endpoint_type }}

[neutron]
# Neutron integration (for network-based rating)
enabled = {{ neutron.enabled | lower }}
endpoint_type = {{ neutron.endpoint_type }}

[nova]
# Nova integration (for compute-based rating)
enabled = {{ nova.enabled | lower }}
endpoint_type = {{ nova.endpoint_type }}

# Rate-modifying modules (e.g., rating by usage tier, region, etc.)
[modules]
# List of enabled rating modules
enabled_modules = [{% for mod in modules.enabled_modules %}
  {{ mod | tojson }}{% if not loop.last %},{% endif %}{% endfor %}
]

[collectors]
# Collector-specific config (e.g., for custom collectors)
{% for name, config in collectors.items() %}[collectors.{{ name }}]
# Collector: {{ name }}
enabled = {{ config.enabled | lower }}
interval = {{ config.interval }}
endpoint = {{ config.endpoint }}
{% endfor %}