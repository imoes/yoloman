{
  "service_name": "ironic-inspector",
  "debug": false,
  "log_level": "INFO",
  "log_file": "/var/log/ironic-inspector/inspector.log",
  "bind_host": "0.0.0.0",
  "bind_port": 5050,
  "ipa_ramdisk_path": "/var/lib/ironic-inspector/ipa-initramfs",
  "ipa_ramdisk_type": "pxelinux",
  "enable_tls": false,
  "tls_cert": "/etc/ironic-inspector/ssl/inspector.crt",
  "tls_key": "/etc/ironic-inspector/ssl/inspector.key",
  "max_concurrent_cleaning_steps": 3,
  "max_clean_retries": 3,
  "max_inspect_retries": 2,
  "retry_interval": 10,
  "enroll_nodes": true,
  "ironic_auth_strategy": "keystone",
  "ironic_endpoint_type": "internalURL",
  "ironic_identity_api_version": "v3",
  "ironic_url": "http://192.168.100.1:6385",
  "ironic_username": "ironic",
  "ironic_password": "IRONIC_PASS",
  "ironic_project_name": "services",
  "ironic_user_domain_name": "Default",
  "ironic_project_domain_name": "Default",
  "dhcp_filter": true,
  "dnsmasq_config_dir": "/etc/dnsmasq.d",
  "dnsmasq_pid_file": "/run/dnsmasq/dnsmasq.pid",
  "dnsmasq_interface": "br-ctlplane",
  "dnsmasq_dhcp_range": "192.168.100.10,192.168.100.100",
  "pxe_bootfile_name": "pxelinux.0",
  "dnsmasq_dns_servers": [
    "10.0.0.1",
    "10.0.0.2"
  ],
  "max_workers": 8,
  "log_levels_by_module": {
    "ironic_inspector": "INFO",
    "sqlalchemy": "WARNING",
    "keystoneclient": "WARNING"
  },
  "ipxe_rules": [
    {
      "name": "default",
      "chain": true,
      "description": "Chain IPA ramdisk for unmodified nodes"
    },
    {
      "name": "secure_boot",
      "chain": true,
      "description": "Chain IPA ramdisk with secure boot enabled"
    }
  ]
}
