{
 "arch": "amd64",
 "cache_dir": "/var/cache/debootstrap",
 "components": [
  "main"
 ],
 "download_only": true,
 "exclude": [
  "tasksel",
  "debtags"
 ],
 "extra_suites": [
  "bullseye-backports"
 ],
 "extractor": "dpkg-deb",
 "foreign": false,
 "include": [
  "vim",
  "systemd"
 ],
 "keep_debootstrap_dir": true,
 "keyring": "/usr/share/keyrings/debian-archive-keyring.gpg",
 "merged_usr": true,
 "mirror": "http://deb.debian.org/debian",
 "no_resolve_deps": false,
 "second_stage": false,
 "suite": "bullseye",
 "target": "/var/chroot/debian-bullseye",
 "variant": "minbase",
 "verbose": true
}
