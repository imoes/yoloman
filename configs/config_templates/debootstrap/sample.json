{
  "suite": "bullseye",
  "target": "/var/chroot/debian-bullseye",
  "mirror": "http://deb.debian.org/debian",
  "arch": "amd64",
  "variant": "minbase",
  "components": [
    "main"
  ],
  "extra_suites": [
    "bullseye-backports"
  ],
  "include": [
    "vim",
    "systemd"
  ],
  "exclude": [
    "tasksel",
    "debtags"
  ],
  "merged_usr": true,
  "keyring": "/usr/share/keyrings/debian-archive-keyring.gpg",
  "cache_dir": "/var/cache/debootstrap",
  "download_only": true,
  "keep_debootstrap_dir": true,
  "foreign": false,
  "second_stage": false,
  "verbose": true,
  "no_resolve_deps": false,
  "extractor": "dpkg-deb"
}
