%% ========================================================================
%% ejabberd Configuration Template
%% ========================================================================
%% This template configures the core startup parameters for ejabberd.
%% It handles network binding, virtual hosts (hostnames), and DNS resolution.
%%
%% NOTE: Modern ejabberd versions (18.07+) typically use `ejabberd.yml`.
%% This template appears to be for an older configuration style or a specific
%% wrapper script. Ensure compatibility with your ejabberd version.
%% ========================================================================

%% ----------------------------------------------------------------------------
%% 1. Network Binding Configuration
%% ----------------------------------------------------------------------------
%% Field: ejabberd_bind_address
%% Desc:  IP address(es) or network interface configuration for ejabberd to bind to.
%%        Must be a tuple-like list of integers for IPv4.
%%
%% Example: [127, 0, 0, 1] binds to localhost.
%% Example: [0, 0, 0, 0] binds to all interfaces.
%% ----------------------------------------------------------------------------
{lookup, ["file", "native"]}.

%% The {host, ..., ...} tuple defines the network interface and the virtual hosts
%% the ejabberd node will register on.
{host, {{ ejabberd_bind_address | default([127, 0, 0, 1]) }}, {{ ejabberd_hostnames | default(['localhost', 'hostalias']) }}}.

%% ----------------------------------------------------------------------------
%% 2. DNS Resolver Configuration
%% ----------------------------------------------------------------------------
%% Field: ejabberd_resolv_conf_path
%% Desc:  Path to the DNS resolver configuration file used by ejabberd for
%%        domain resolution (SIP, XMPP, etc.).
%% ----------------------------------------------------------------------------
{file, resolv, "{{ ejabberd_resolv_conf_path | default('/etc/resolv.conf') }}"} .
