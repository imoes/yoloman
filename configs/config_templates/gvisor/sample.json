{
  "log_level": "info",
  "crash_reporter": false,
  "root_dir": "/run/gvisor",
  "grpc_threads": 4,
  "nested": false,
  "pty": true,
  "debug_enabled": false,
  "network_enabled": true,
  "allowed_interfaces": [
    "eth0"
  ],
  "allowed_protocols": [
    "tcp",
    "udp",
    "icmp"
  ],
  "mounts": [
    {
      "src": "/var/log",
      "dst": "/logs",
      "options": [
        "ro",
        "bind"
      ]
    }
  ],
  "log_to_journald": true,
  "kernel_args": [],
  "seccomp_filters": true,
  "seccomp_profile": "",
  "fd_passing_enabled": false,
  "max_open_files": 65535,
  "cpu_pinning_enabled": false,
  "pinned_cores": [],
  "memory_limit_enabled": false,
  "memory_limit_bytes": 0,
  "cpu_quota_enabled": false,
  "cpu_quota_us": 0,
  "cpu_period_us": 100000,
  "swap_enabled": false,
  "overlay_dir": "/var/lib/gvisor/overlay",
  "overlay_enabled": true
}
