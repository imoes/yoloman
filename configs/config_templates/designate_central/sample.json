{
  "log_level": "INFO",
  "base_dir": "/var/lib/designate",
  "pid_file": "/var/run/designate/designate-central.pid",
  "host": "192.168.1.10",
  "rpc_port": 9001,
  "workers": 4,
  "max_tasks": 5000,
  "enabled": true,
  "enable_rpc": true,
  "central_enabled": true,
  "max_records_per_zone": 500,
  "max_zones_per_tenant": 10,
  "default_ttl": 3600,
  "default_refresh": 3600,
  "default_retry": 900,
  "default_expire": 1209600,
  "default_minimum": 86400,
  "ixfr_enabled": true,
  "axfr_enabled": true,
  "database": {
    "connection": "mysql+pymysql://designate:designate@192.168.1.5/designate?charset=utf8mb4",
    "pool_size": 20,
    "pool_max_overflow": 30,
    "connection_recycle_time": 300
  },
  "keystone": {
    "auth_url": "http://keystone.example.com:5000/v3",
    "project_domain_name": "Default",
    "project_name": "service",
    "user_domain_name": "Default",
    "username": "designate",
    "password": "secure_designate_password",
    "auth_version": "3",
    "cafile": "/etc/ssl/certs/ca-certificates.crt",
    "region_name": "RegionOne"
  },
  "rpc_transport_url": "rabbit://openstack:RABBIT_SECRET@controller:5672/",
  "rpc_response_timeout": 60,
  "rpc_workers": 4,
  "endpoints": [
    {
      "name": "oslo_messaging_notifications",
      "enabled": true
    },
    {
      "name": "central_policy",
      "enabled": true
    }
  ]
}
