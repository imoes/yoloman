<!-- /etc/dbus-1/system.conf template generated by D-Bus config generator -->
<!-- Global service limit for maximum number of active connections -->
<limit name="max_connections_per_user">{{ limits.max_connections_per_user }}</limit>

<!-- Global service limit for maximum number of pending method calls per connection -->
<limit name="max_pending_service_calls">{{ limits.max_pending_service_calls }}</limit>

<!-- Global service limit for maximum number of active services (i.e., well-known names) per connection -->
<limit name="max_services_per_connection">{{ limits.max_services_per_connection }}</limit>

<!-- Global service limit for maximum number of active match rules per connection -->
<limit name="max_matches_per_connection">{{ limits.max_matches_per_connection }}</limit>

<!-- Global service limit for maximum length of a single message (bytes) -->
<limit name="max_message_length">{{ limits.max_message_length }}</limit>

<!-- Global service limit for maximum size of a single authentication blob (bytes) -->
<limit name="max_auth_length">{{ limits.max_auth_length }}</limit>

<!-- Define where service activation files are located -->
<incdir>{{ service_dirs.activate }}</incdir>

<!-- Include additional configuration fragments from system.d (common in Debian-based distros) -->
{% if service_dirs.system_d | default(true) %}
<includedir>{{ service_dirs.system_d_path }}</includedir>
{% endif %}

<!-- Security policy for system bus -->
{% for policy in policies %}
<policy context="{{ policy.context }}">
  <!-- Allow or deny specific users/groups to own well-known names -->
  {% for rule in policy.rules %}
  <{% if rule.type == 'allow' %}allow{% else %}deny{% endif %}
    {% if rule.user is defined %}user="{{ rule.user }}"{% endif %}
    {% if rule.group is defined %}group="{{ rule.group }}"{% endif %}
    {% if rule.service is defined %}service="{{ rule.service }}"{% endif %}
    {% if rule.path is defined %}path="{{ rule.path }}"{% endif %}
    {% if rule.path_namespace is defined %}path_namespace="{{ rule.path_namespace }}"{% endif %}
    {% if rule.interface is defined %}interface="{{ rule.interface }}"{% endif %}
    {% if rule.member is defined %}member="{{ rule.member }}"{% endif %}
    {% if rule.error is defined %}error="{{ rule.error }}"{% endif %}
    {% if rule.destination is defined %}destination="{{ rule.destination }}"{% endif %}
    {% if rule.send_interface is defined %}send_interface="{{ rule.send_interface }}"{% endif %}
    {% if rule.send_member is defined %}send_member="{{ rule.send_member }}"{% endif %}
    {% if rule.send_error is defined %}send_error="{{ rule.send_error }}"{% endif %}
    {% if rule.send_destination is defined %}send_destination="{{ rule.send_destination }}"{% endif %}
    {% if rule.recv_interface is defined %}recv_interface="{{ rule.recv_interface }}"{% endif %}
    {% if rule.recv_member is defined %}recv_member="{{ rule.recv_member }}"{% endif %}
    {% if rule.recv_error is defined %}recv_error="{{ rule.recv_error }}"{% endif %}
    {% if rule.recv_sender is defined %}recv_sender="{{ rule.recv_sender }}"{% endif %}
    {% if rule.type == 'allow' %}
      {% if rule.setbusname is defined %}setbusname="{{ rule.setbusname }}"{% endif %}
      {% if rule.send_destination is undefined %}send_destination="org.freedesktop.DBus"{% endif %}
    {% endif %}
  />
  {% endfor %}
</policy>
{% endfor %}

<!-- Define default security context (for legacy systems; usually 'default') -->
<policy context="default">
  <!-- Deny all users by default from connecting to system bus -->
  <deny send_interface="org.freedesktop.DBus"/>
</policy>