{
  "limits": {
    "type": "object",
    "default": {
      "max_connections_per_user": 256,
      "max_pending_service_calls": 16,
      "max_services_per_connection": 128,
      "max_matches_per_connection": 256,
      "max_message_length": 131072,
      "max_auth_length": 65536
    },
    "description": "Hard resource limits for the system bus. Adjust to accommodate high-traffic or constrained environments."
  },
  "service_dirs": {
    "type": "object",
    "default": {
      "activate": "/usr/share/dbus-1/services",
      "system_d": true,
      "system_d_path": "/etc/dbus-1/system.d"
    },
    "description": "Directories containing D-Bus service activation files and additional policy fragments."
  },
  "policies": {
    "type": "list",
    "default": [
      {
        "context": "default",
        "rules": [
          {
            "type": "allow",
            "group": "system",
            "send_destination": "org.freedesktop.DBus",
            "send_interface": "org.freedesktop.DBus.Introspectable",
            "send_member": "Introspect"
          },
          {
            "type": "allow",
            "user": "root",
            "send_destination": "org.freedesktop.DBus",
            "send_interface": "org.freedesktop.DBus",
            "send_member": "RequestName"
          },
          {
            "type": "allow",
            "user": "root",
            "send_destination": "org.freedesktop.DBus",
            "send_interface": "org.freedesktop.DBus",
            "send_member": "ReleaseName"
          },
          {
            "type": "allow",
            "user": "root",
            "send_destination": "org.freedesktop.DBus",
            "send_interface": "org.freedesktop.DBus",
            "send_member": "StartServiceByName"
          }
        ]
      }
    ],
    "items": {
      "type": "object",
      "description": "A security policy block. Each block groups rules for a given context (usually 'default').",
      "properties": {
        "context": {
          "type": "string",
          "description": "Policy context name (e.g., 'default').",
          "default": "default"
        },
        "rules": {
          "type": "list",
          "description": "List of allow/deny rules.",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Rule type: 'allow' or 'deny'.",
                "default": "allow",
                "enum": [
                  "allow",
                  "deny"
                ]
              },
              "user": {
                "type": "string",
                "description": "Unix username (optional)."
              },
              "group": {
                "type": "string",
                "description": "Unix group name (optional)."
              },
              "service": {
                "type": "string",
                "description": "Well-known service name to match (optional)."
              },
              "path": {
                "type": "string",
                "description": "Object path to match (optional)."
              },
              "path_namespace": {
                "type": "string",
                "description": "Object path namespace prefix (optional)."
              },
              "interface": {
                "type": "string",
                "description": "Interface name to match (optional)."
              },
              "member": {
                "type": "string",
                "description": "Method name to match (optional)."
              },
              "error": {
                "type": "string",
                "description": "Error name to match (optional)."
              },
              "destination": {
                "type": "string",
                "description": "Destination bus name to match (optional)."
              },
              "send_interface": {
                "type": "string",
                "description": "Interface name in outbound messages (optional)."
              },
              "send_member": {
                "type": "string",
                "description": "Method name in outbound messages (optional)."
              },
              "send_error": {
                "type": "string",
                "description": "Error name in outbound messages (optional)."
              },
              "send_destination": {
                "type": "string",
                "description": "Destination name in outbound messages (optional)."
              },
              "recv_interface": {
                "type": "string",
                "description": "Interface name in inbound messages (optional)."
              },
              "recv_member": {
                "type": "string",
                "description": "Method name in inbound messages (optional)."
              },
              "recv_error": {
                "type": "string",
                "description": "Error name in inbound messages (optional)."
              },
              "recv_sender": {
                "type": "string",
                "description": "Sender bus name in inbound messages (optional)."
              },
              "setbusname": {
                "type": "string",
                "description": "Bus name to set when allowing (for owner rules)."
              }
            }
          }
        }
      }
    }
  }
}
