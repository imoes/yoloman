{
  "debug_enabled": false,
  "pid_file_path": "/run/clamav/clamd.pid",
  "socket_path": "/run/clamav/clamd.ctl",
  "socket_group": "clamav",
  "socket_mode": "660",
  "max_clients": 15,
  "daemon_user": "clamav",
  "database_dir": "/var/lib/clamav",
  "extra_signatures": [
    "/opt/custom-sigs/custom.ndb"
  ],
  "update_log_path": "/var/log/clamav/freshclam.log",
  "log_file_path": "/var/log/clamav/clamd.log",
  "log_rotate": true,
  "log_file_size_mb": 10,
  "scan_recursive": true,
  "scan_pe": true,
  "scan_ole2": true,
  "scan_pdf": true,
  "scan_html": true,
  "scan_mail": true,
  "scan_archive": true,
  "archive_max_depth": 16,
  "archive_max_files": 1000,
  "archive_max_file_size_mb": 25,
  "idle_timeout": 30,
  "bytecode_enabled": true,
  "bytecode_timeout": 60,
  "stream_max_length_mb": 25,
  "stream_min_port": 1024,
  "stream_max_port": 2048,
  "heuristic_precedence": false,
  "max_scan_size_mb": 100,
  "max_file_size_mb": 25,
  "max_recursion": 16,
  "max_files": 10000,
  "pua_enabled": false,
  "pua_categories": [],
  "exclude_paths": [
    "/var/spool/postfix/queue",
    "/proc",
    "/sys"
  ],
  "include_paths": []
}
