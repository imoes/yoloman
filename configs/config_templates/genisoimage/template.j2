{# genisoimage configuration template #}
{# This template generates the list of file paths (with optional graft points) #}
{# to be included in an ISO9660 filesystem for genisoimage/mkisofs. #}

{# Iterate over the 'pathspecs' list. Each entry is a string representing a #}
{# directory or file, optionally with a graft point syntax like "src=dst". #}
{# If the variable is undefined or empty, render nothing. #}
{% for pathspec in (pathspecs | default([])) %}
{{ pathspec }}{% if not loop.last %} {% endif %}
{% endfor %}