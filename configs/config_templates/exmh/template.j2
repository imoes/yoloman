# ==============================================================================
# /etc/exmh.conf - Configuration file for the EXmh Mail Handler
# ==============================================================================
# This file is generated by Ansible. Do NOT edit manually.
# It configures the exmh Tcl/Tk-based MH mail handler interface.
# ==============================================================================

# -- General Information ---------------------------------------------------------

# Version string for exmh, e.g. "2.9.0 2018-07-11 (debian 1:2.9.0-8)"
set exmh(version) "{{ exmh_version | default('2.9.0 2018-07-11 (debian 1:2.9.0-8)') }}"

# Path to the Wish (Tcl/Tk) interpreter required to run exmh
set wish {{ wish_path | default('/usr/bin/wish') }}

# -- Documentation ---------------------------------------------------------------

# Location of exmh HTML documentation
set exmh(helploc) {{ exmh_helploc | default('/usr/share/doc/exmh/html/') }}

# Name of the exmh application
set exmh(name) {{ exmh_name | default('exmh') }}

# Email of the exmh package maintainer
set exmh(maintainer) {{ exmh_maintainer | default('az@debian.org') }}

# -- MH System Integration -------------------------------------------------------

# Path to the MH mail system binary (the underlying mail handler)
set mh_path {{ mh_path | default('/usr/bin/mh') }}

# Path to slocal, the MH local delivery agent used for filtering
set exmh(slocal) {{ exmh_slocal | default('/usr/lib/mh/slocal') }}

# -- MIME and Content Handling ---------------------------------------------------

# Directory containing MIME utilities (e.g., metamail)
set mime(dir) {{ mime_dir | default('/usr/bin') }}

# Default mailcap file location (defines how to handle different content types)
set mailcap_default {{ mailcap_default | default('/etc/mailcap') }}

# Default MIME types file location (maps file extensions to MIME types)
set mimetypes_default {{ mimetypes_default | default('/etc/mime.types') }}

# -- Interpreter Requirements ----------------------------------------------------

# Path to the Expect interpreter (used for automating interactive applications)
set exmh(expect) {{ exmh_expect | default('/usr/bin/expect') }}

# Path to ExpectK (Expect with Tk support, used for GUI automation)
set exmh(expectk) {{ exhm_expectk | default('/usr/bin/expectk') }}

# -- User Interface Resources ----------------------------------------------------

# Directory containing exmh bitmap icons (for the GUI)
set exmh(bitmaps) {{ exmh_bitmaps | default('/usr/share/exmh/bitmaps/') }}

# Directory containing faces (picons/avatar images)
set faces(dir) {{ faces_dir | default('/usr/lib/picon') }}

# User-defined face categories (space-separated set)
set faces(set,user) {{ faces_set_user | default('{local users usenix misc}') }}

# Unknown-domain face categories (space-separated set)
set faces(set,unknown) {{ faces_set_unknown | default('{domains unknown}') }}

# News-related face categories
set faces(set,news) {{ faces_set_news | default('news') }}

# Default face domain (empty = none)
set faces(defaultDomain) {{ faces_defaultDomain | default('{}') }}

# Face image file extensions to search (space-separated set)
set faces(suffix) {{ faces_suffix | default('{xpm gif xbm}') }}

# -- PGP/GPG Encryption Support --------------------------------------------------

# Directory containing PGP 2.x executable
set pgp(pgp,path) {{ pgp_pgp_path | default('/usr/bin') }}

# Directory containing PGP 5.x executable
set pgp(pgp5,path) {{ pgp_pgp5_path | default('/usr/bin') }}

# Directory containing GnuPG executable
set pgp(gpg,path) {{ pgp_gpg_path | default('/usr/bin') }}

# Directory containing PGP 6.x executable
set pgp(pgp6,path) {{ pgp_pgp6_path | default('/usr/bin') }}

# -- Search Engine Support -------------------------------------------------------

# Directory containing glimpse search engine binary
set glimpse(path) {{ glimpse_path | default('/usr/bin') }}

# Directory containing Recoll search engine binary
set recoll(path) {{ recoll_path | default('/usr/bin') }}

# -- Notifications ---------------------------------------------------------------

# Command to play sound notifications (empty string or '{}' disables sound)
set sound(cmd) {{ sound_cmd | default('{}') }}

# -- Installation Paths ----------------------------------------------------------

# Directory containing exmh library files
set exmh(library) {{ exmh_library | default('/usr/lib/exmh') }}

# this is where internal scripts live, not exmh itself...
set install(dir,bin) {{ install_dir_bin | default('/usr/share/exmh') }}

set install(dir,man) {{ install_dir_man | default('/usr/man/man1') }}

set install(dir,lib) {{ install_dir_lib | default('/usr/lib/exmh') }}