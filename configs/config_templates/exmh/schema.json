{
  "exmh_version": {
    "type": "string",
    "default": "2.9.0 2018-07-11 (debian 1:2.9.0-8)",
    "description": "Version string for exmh"
  },
  "wish_path": {
    "type": "string",
    "default": "/usr/bin/wish",
    "description": "Path to the Wish (Tcl/Tk) interpreter"
  },
  "exmh_helploc": {
    "type": "string",
    "default": "/usr/share/doc/exmh/html/",
    "description": "Location of exmh HTML documentation"
  },
  "exmh_name": {
    "type": "string",
    "default": "exmh",
    "description": "Name of the exmh application"
  },
  "exmh_maintainer": {
    "type": "string",
    "default": "az@debian.org",
    "description": "Email of the exmh package maintainer"
  },
  "mh_path": {
    "type": "string",
    "default": "/usr/bin/mh",
    "description": "Path to the MH mail system binary"
  },
  "exmh_slocal": {
    "type": "string",
    "default": "/usr/lib/mh/slocal",
    "description": "Path to slocal (MH local delivery agent)"
  },
  "mime_dir": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Directory containing MIME utilities (e.g., metamail)"
  },
  "mailcap_default": {
    "type": "string",
    "default": "/etc/mailcap",
    "description": "Default mailcap file location"
  },
  "mimetypes_default": {
    "type": "string",
    "default": "/etc/mime.types",
    "description": "Default MIME types file location"
  },
  "exmh_expect": {
    "type": "string",
    "default": "/usr/bin/expect",
    "description": "Path to the Expect interpreter"
  },
  "exmh_expectk": {
    "type": "string",
    "default": "/usr/bin/expectk",
    "description": "Path to ExpectK (Expect with Tk)"
  },
  "exmh_bitmaps": {
    "type": "string",
    "default": "/usr/share/exmh/bitmaps/",
    "description": "Directory containing exmh bitmap icons"
  },
  "faces_dir": {
    "type": "string",
    "default": "/usr/lib/picon",
    "description": "Directory containing faces (picons)"
  },
  "faces_set_user": {
    "type": "string",
    "default": "{local users usenix misc}",
    "description": "User-defined face categories"
  },
  "faces_set_unknown": {
    "type": "string",
    "default": "{domains unknown}",
    "description": "Unknown-domain face categories"
  },
  "faces_set_news": {
    "type": "string",
    "default": "news",
    "description": "News-related face categories"
  },
  "faces_defaultDomain": {
    "type": "string",
    "default": "{}",
    "description": "Default face domain (empty = none)"
  },
  "faces_suffix": {
    "type": "string",
    "default": "{xpm gif xbm}",
    "description": "Face image file extensions to search"
  },
  "pgp_pgp_path": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Directory containing PGP 2.x executable"
  },
  "pgp_pgp5_path": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Directory containing PGP 5.x executable"
  },
  "pgp_gpg_path": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Directory containing GnuPG executable"
  },
  "pgp_pgp6_path": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Directory containing PGP 6.x executable"
  },
  "glimpse_path": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Directory containing glimpse search engine"
  },
  "recoll_path": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Directory containing Recoll search engine"
  },
  "sound_cmd": {
    "type": "string",
    "default": "{}",
    "description": "Command to play sound notifications (empty = none)"
  },
  "exmh_library": {
    "type": "string",
    "default": "/usr/lib/exmh",
    "description": "Directory containing exmh library files"
  },
  "install_dir_bin": {
    "type": "string",
    "default": "/usr/share/exmh",
    "description": "Directory for exmh internal scripts (bin-like)"
  },
  "install_dir_man": {
    "type": "string",
    "default": "/usr/man/man1",
    "description": "Directory for exmh man pages"
  },
  "install_dir_lib": {
    "type": "string",
    "default": "/usr/lib/exmh",
    "description": "Directory for exmh library files (config, resources, etc.)"
  }
}
