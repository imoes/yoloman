{
 "log_streams": [
  {
   "hardlink": "/var/log/apache2/access/last.log",
   "name": "Apache access log",
   "symlink": "/var/log/apache2/access/current.log",
   "template": "/var/log/apache2/access/%Y/%m/%d/access.log"
  },
  {
   "delay": "5m",
   "name": "Apache error log",
   "period": "1d",
   "symlink": "/var/log/apache2/error/current.log",
   "template": "/var/log/apache2/error/%Y/%m/%d/error.log"
  },
  {
   "name": "Debug log (once-only)",
   "once_only": true,
   "template": "/var/log/debug.log"
  }
 ]
}
