{
  "site_owner": {
    "type": "string",
    "default": "root@localhost",
    "description": "The email address for the site owner, used for undeliverable messages."
  },
  "bin_dir": {
    "type": "string",
    "default": "/usr/libexec/mailman3",
    "description": "Directory containing Mailman binary executables."
  },
  "var_dir": {
    "type": "string",
    "default": "/var/lib/mailman3",
    "description": "Variable data directory for Mailman state."
  },
  "queue_dir": {
    "type": "string",
    "default": "/var/spool/mailman3",
    "description": "Directory for Mailman message queues."
  },
  "log_dir": {
    "type": "string",
    "default": "/var/log/mailman3",
    "description": "Directory for Mailman log files."
  },
  "lock_dir": {
    "type": "string",
    "default": "/run/lock/mailman3",
    "description": "Directory for Mailman lock files."
  },
  "ext_dir": {
    "type": "string",
    "default": "/etc/mailman3.d",
    "description": "Directory for extension configurations."
  },
  "pid_file": {
    "type": "string",
    "default": "/run/mailman3/master.pid",
    "description": "Path to the master process PID file."
  }
}
