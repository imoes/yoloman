# =============================================================================
# Alpine Linux chroot bootstrap configuration
# Generated by Ansible Jinja2 template for alpine-chroot-install(8)
#
# This configuration file drives the alpine-chroot-install script to set up a
# minimal Alpine Linux environment inside a specified directory. It controls
# architecture, branch, packages, mirrors, and environment variable passing.
#
# SELF-DOCUMENTING: Each variable is commented with its schema description and
# default value. Use the provided defaults to avoid runtime errors.
# =============================================================================

# -----------------------------------------------------------------------------
# CPU architecture for the chroot (e.g., x86_64, aarch64).
# Defaults to host architecture if not set.
# -----------------------------------------------------------------------------
ARCH={{ arch | default('') }}

# -----------------------------------------------------------------------------
# Alpine branch to install (e.g., v3.19, edge).
# Defaults to 'latest-stable' if not set.
# -----------------------------------------------------------------------------
ALPINE_BRANCH={{ alpine_branch | default('latest-stable') }}

# -----------------------------------------------------------------------------
# Absolute path to the chroot directory (REQUIRED).
# The script will fail if this is empty.
# -----------------------------------------------------------------------------
CHROOT_DIR={{ chroot_dir | default('/mnt/alpine-chroot') }}

# -----------------------------------------------------------------------------
# Directory on the host to bind-mount inside the chroot.
# Defaults to PWD if under /home, otherwise none (commented out).
# -----------------------------------------------------------------------------
BIND_DIR={{ bind_dir | default('') }}{% if bind_dir | default('') != '' %}
BIND_DIR={{ bind_dir }}{% else %}
# BIND_DIR unset (defaults to PWD if under /home, else none)
{% endif %}

# -----------------------------------------------------------------------------
# Environment variable names (ERE patterns) to pass from host to chroot.
# Defaults to ['ARCH', 'CI', 'QEMU_EMULATOR', 'TRAVIS_.*'] if empty.
# Patterns are space-separated in the output.
# -----------------------------------------------------------------------------
CHROOT_KEEP_VARS={{ chroot_keep_vars | default(['ARCH', 'CI', 'QEMU_EMULATOR', 'TRAVIS_.*']) | join(' ') }}

# -----------------------------------------------------------------------------
# URI of Alpine Aports mirror.
# Empty uses default http://dl-cdn.alpinelinux.org/alpine.
# -----------------------------------------------------------------------------
ALPINE_MIRROR={{ alpine_mirror | default('') }}{% if alpine_mirror | default('') != '' %}
ALPINE_MIRROR={{ alpine_mirror }}{% else %}
# ALPINE_MIRROR unset (uses default: http://dl-cdn.alpinelinux.org/alpine)
{% endif %}

# -----------------------------------------------------------------------------
# List of Alpine packages to install into chroot.
# Defaults to ['build-base', 'ca-certificates', 'ssl_client'] if empty.
# Packages are space-separated in the output.
# -----------------------------------------------------------------------------
ALPINE_PACKAGES={{ alpine_packages | default(['build-base', 'ca-certificates', 'ssl_client']) | join(' ') }}

# -----------------------------------------------------------------------------
# List of additional Alpine repositories to add to /etc/apk/repositories.
# Empty means none added beyond main/community.
# Repositories are space-separated in the output.
# -----------------------------------------------------------------------------
EXTRA_REPOS={{ extra_repos | default([]) | join(' ') }}

# -----------------------------------------------------------------------------
# Absolute path to temporary directory for bootstrap files.
# Empty uses mktemp -d to create a system temp dir.
# -----------------------------------------------------------------------------
TEMP_DIR={{ temp_dir | default('') }}{% if temp_dir | default('') != '' %}
TEMP_DIR={{ temp_dir }}{% else %}
# TEMP_DIR unset (uses mktemp -d)
{% endif %}

# -----------------------------------------------------------------------------
# Full URL of apk.static binary to download.
# Empty uses a default architecture-specific binary.
# -----------------------------------------------------------------------------
APK_TOOLS_URI={{ apk_tools_uri | default('') }}{% if apk_tools_uri | default('') != '' %}
APK_TOOLS_URI={{ apk_tools_uri }}{% else %}
# APK_TOOLS_URI unset (uses default x86_64 binary)
{% endif %}

# -----------------------------------------------------------------------------
# SHA-256 checksum of the apk.static binary, used for integrity verification.
# Empty means checksum is not verified.
# -----------------------------------------------------------------------------
APK_TOOLS_SHA256={{ apk_tools_sha256 | default('') }}{% if apk_tools_sha256 | default('') != '' %}
APK_TOOLS_SHA256={{ apk_tools_sha256 }}{% else %}
# APK_TOOLS_SHA256 unset (checksum not verified)
{% endif %}