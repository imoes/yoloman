{
  "output_directory": "/tmp/bear-output",
  "append": true,
  "force_method": "wrapper",
  "filter_rules": [
    {
      "type": "include",
      "pattern": "clang(-\\d+)?|gcc(-\\d+)?",
      "arguments": [
        "-c",
        "-o"
      ]
    },
    {
      "type": "exclude",
      "pattern": ".*test.*",
      "arguments": []
    }
  ],
  "compiler_aliases": {
    "gcc": "/usr/bin/gcc-13",
    "g++": "/usr/bin/g++-13"
  },
  "extra_flags": [
    "-Wall",
    "-Wextra"
  ],
  "emit_command_field": false
}
