# $OpenBSD: afrinic.constraints,v 1.3 2023/12/19 08:10:19 job Exp $
#
# This file defines RPKI trust anchor constraints for AFRINIC.
# It is consumed by rpki-client(1) to validate ROAs and prefixes
# received from the RPKI repository.
#
# Each section below corresponds to a specific IANA or RIR resource
# assignment, recovery, or transfer event. The variables contain
# lists of CIDR ranges or AS numbers as appropriate.
# If a list is empty, no constraints are applied for that category.
# ========================================================================

# List of IPv4 allow rules from IANA assignments.
# These define the primary IPv4 address space allocated by IANA.
{% for rule in (ipv4_ranges | default([])) %}
{%- if loop.first %}{% else %}
{% endif -%}{{ rule | string }}
{% endfor %}

# List of IPv6 allow rules from IANA assignments.
# These define the primary IPv6 address space allocated by IANA.
{% for rule in (ipv6_ranges | default([])) %}
{%- if loop.first %}{% else %}
{% endif -%}{{ rule | string }}
{% endfor %}

# List of AS number allow rules from IANA assignments.
# These define the Autonomous System numbers allocated by IANA.
{% for rule in (as_ranges | default([])) %}
{%- if loop.first %}{% else %}
{% endif -%}{{ rule | string }}
{% endfor %}

# List of IPv4 allow rules for recovered address space.
# Recovered space refers to IPv4 blocks reclaimed by IANA from unassigned pools.
{% for rule in (recovered_ranges | default([])) %}
{%- if loop.first %}{% else %}
{% endif -%}{{ rule | string }}
{% endfor %}

# List of AS and IPv4 allow rules for transferred resources.
# These cover resources transferred between RIRs or entities.
# Sources:
# - https://web.archive.org/web/20131120040037/http://www.ripe.net/lir-services/resource-management/erx/transferred-resources
# - https://afrinic.net/fr/library/policies/220-erx-transfer
{% for rule in (transferred_ranges | default([])) %}
{%- if loop.first %}{% else %}
{% endif -%}{{ rule | string }}
{% endfor %}

# List of AS number allow rules for RIR transition (RIPE NCC to AFRINIC).
# Covers the transition of ASNs from RIPE NCC operational region to AFRINIC.
# Source: https://www.ripe.net/participate/internet-governance/internet-technical-community/the-rir-system/afrinic/ripe-ncc-to-afrinic-transition
{% for rule in (ripe_to_afrinic_as | default([])) %}
{%- if loop.first %}{% else %}
{% endif -%}{{ rule | string }}
{% endfor %}

# List of IPv4 allow rules from Afrinic audit report.
# Derived from AFRINIC's WHOIS audit report (Appendix A3).
# Source: https://afrinic.net/ast/pdf/afrinic-whois-audit-report-full-20210121.pdf
{% for rule in (afrinic_audit_ranges | default([])) %}
{%- if loop.first %}{% else %}
{% endif -%}{{ rule | string }}
{% endfor %}

# List of AS and IPv4 allow rules from ARIN transfers.
# Historical transfer data from ARIN to AFRINIC resources.
# Source: https://ftp.arin.net/afrinic/afrinic-transfers-by-resource.txt (Feb 21, 2005)
{% for rule in (arin_transfers_ranges | default([])) %}
{%- if loop.first %}{% else %}
{% endif -%}{{ rule | string }}
{% endfor %}

