# $OpenBSD: afrinic.constraints,v 1.3 2023/12/19 08:10:19 job Exp $
#
# RPKI Client Constraints Template
# This file defines the routing policy constraints for the RPKI client (rpki-client).
# It specifies which IP prefixes and Autonomous System (AS) numbers are allowed
# based on various Regional Internet Registry (RIR) assignments and transfers.
#
# Each section corresponds to a specific schema field. If a field is not provided
# or is empty, the corresponding section will be skipped.

# -----------------------------------------------------------------------------
# IPv4 allow rules from IANA assignments
# Source: https://www.iana.org/assignments/ipv4-address-space/
# Format: allow <prefix>
# -----------------------------------------------------------------------------
{% for range in ipv4_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# IPv6 allow rules from IANA assignments
# Source: https://www.iana.org/assignments/ipv6-address-space/
# Format: allow <prefix>
# -----------------------------------------------------------------------------
{% for range in ipv6_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# AS number allow rules from IANA assignments
# Format: allow <AS number>
# -----------------------------------------------------------------------------
{% for range in as_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# IPv4 allow rules for recovered address space
# Format: allow <prefix>
# -----------------------------------------------------------------------------
{% for range in recovered_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# AS and IPv4 allow rules for transferred resources
# Format: allow <AS number> or allow <prefix>
# -----------------------------------------------------------------------------
{% for range in transferred_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# AS number allow rules for RIR transition (RIPE to AFRINIC)
# Format: allow <AS number>
# -----------------------------------------------------------------------------
{% for range in ripe_to_afrinic_as | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# IPv4 allow rules from Afrinic audit report
# Format: allow <prefix>
# -----------------------------------------------------------------------------
{% for range in afrinic_audit_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# AS and IPv4 allow rules from ARIN transfers
# Format: allow <AS number> or allow <prefix>
# -----------------------------------------------------------------------------
{% for range in arin_transfers_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# IPv4 allow rules from APNIC to Afrinic certificate
# Format: allow <prefix>
# -----------------------------------------------------------------------------
{% for range in apnic_to_afrinic_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# IPv4 allow rules from RIPE to Afrinic certificate
# Format: allow <prefix>
# -----------------------------------------------------------------------------
{% for range in ripe_to_afrinic_ranges | default([], true) %}allow {{ range }}
{% endfor %}

# -----------------------------------------------------------------------------
# IPv4 allow rules from ARIN to Afrinic certificate
# Format: allow <prefix>
# -----------------------------------------------------------------------------
{% for range in arin_to_afrinic_ranges | default([], true) %}allow {{ range }}
{% endfor %}