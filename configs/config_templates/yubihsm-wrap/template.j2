# =============================================================================
# YubiHSM Wrap Configuration Template
# This template generates a configuration file for the YubiHSM2 'wrap' utility.
# The 'wrap' command is used to create encrypted backups of objects (keys/certs)
# stored in a YubiHSM2 device.
# =============================================================================

# -----------------------------------------------------------------------------
# algorithm: Object algorithm used for wrapping. Accepted values are AES128 or AES256.
# This determines the block cipher mode for the encrypted payload.
# -----------------------------------------------------------------------------
# Algorithm: {{ algorithm | default('AES256') }}

# -----------------------------------------------------------------------------
# capabilities: String of capabilities granted to the object.
# Example: signPSS,decryptRSA.
# This restricts what operations can be performed on the wrapped object.
# -----------------------------------------------------------------------------
# Capabilities: {{ capabilities | default('signPSS,decryptRSA') }}

# -----------------------------------------------------------------------------
# delegated: String of delegated capabilities allowed for the object.
# Leave empty if none.
# Used to pass delegation permissions to the wrapped object.
# -----------------------------------------------------------------------------
# Delegated: {{ delegated | default('') }}

# -----------------------------------------------------------------------------
# domains: String of domains the object is accessible from.
# Range or specific IDs (e.g., '1', '1-65535').
# Limits which HSM domains can unwrap/decrypt the resulting object.
# -----------------------------------------------------------------------------
# Domains: {{ domains | default('1-65535') }}

# -----------------------------------------------------------------------------
# id: Object ID (short integer). Default is 0.
# The unique identifier assigned to the wrapped object on the HSM.
# -----------------------------------------------------------------------------
# ID: {{ id | default(0) }}

# -----------------------------------------------------------------------------
# input_file: Path to the input data filename.
# The file containing the data to be wrapped/encrypted.
# -----------------------------------------------------------------------------
# In: {{ input_file | default('/etc/yubihsm/input.dat') }}

# -----------------------------------------------------------------------------
# output_file: Path to the output data filename.
# The file where the wrapped/encrypted output will be written.
# -----------------------------------------------------------------------------
# Out: {{ output_file | default('/etc/yubihsm/output.dat') }}

# -----------------------------------------------------------------------------
# label: String label for the object.
# A human-readable name associated with the object inside the HSM.
# -----------------------------------------------------------------------------
# Label: {{ label | default('wrapped-object') }}

# -----------------------------------------------------------------------------
# wrap_key_file: Path to the wrap key filename.
# The local file containing the AES wrapping key (typically 32 bytes for AES256).
# This key is used to encrypt the object before storage.
# -----------------------------------------------------------------------------
# Wrapkey: {{ wrap_key_file | default('/etc/yubihsm/wrap.key') }}