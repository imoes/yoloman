# man_db.conf
#
# This file is used by the man-db package to configure the man and cat paths.
# It is also used to provide a manpath for those without one by examining
# their PATH environment variable. For details see the manpath(5) man page.
#
# Lines beginning with `#' are comments and are ignored. Any combination of
# tabs or spaces may be used as `whitespace' separators.
#
# There are three mappings allowed in this file:
# --------------------------------------------------------
# MANDATORY_MANPATH			manpath_element
# MANPATH_MAP		path_element	manpath_element
# MANDB_MAP		global_manpath	[relative_catpath]
#---------------------------------------------------------
# every automatically generated MANPATH includes these fields
#
#MANDATORY_MANPATH 			/usr/src/pvm3/man
#

# First mandatory manpath element.
MANDATORY_MANPATH			{{ mandatory_manpath_1 | default('/usr/man') }}
# Second mandatory manpath element.
MANDATORY_MANPATH			{{ mandatory_manpath_2 | default('/usr/share/man') }}
# Third mandatory manpath element.
MANDATORY_MANPATH			{{ mandatory_manpath_3 | default('/usr/local/share/man') }}

#---------------------------------------------------------
# set up PATH to MANPATH mapping
# ie. what man tree holds man pages for what binary directory.
#
#		*PATH*        ->	*MANPATH*
#

# Manpath for /bin.
MANPATH_MAP	/bin			{{ manpath_map_bin | default('/usr/share/man') }}
# Manpath for /usr/bin.
MANPATH_MAP	/usr/bin		{{ manpath_map_usr_bin | default('/usr/share/man') }}
# Manpath for /sbin.
MANPATH_MAP	/sbin			{{ manpath_map_sbin | default('/usr/share/man') }}
# Manpath for /usr/sbin.
MANPATH_MAP	/usr/sbin		{{ manpath_map_usr_sbin | default('/usr/share/man') }}
# First manpath for /usr/local/bin.
MANPATH_MAP	/usr/local/bin		{{ manpath_map_usr_local_bin_1 | default('/usr/local/man') }}
# Second manpath for /usr/local/bin.
MANPATH_MAP	/usr/local/bin		{{ manpath_map_usr_local_bin_2 | default('/usr/local/share/man') }}
# First manpath for /usr/local/sbin.
MANPATH_MAP	/usr/local/sbin		{{ manpath_map_usr_local_sbin_1 | default('/usr/local/man') }}
# Second manpath for /usr/local/sbin.
MANPATH_MAP	/usr/local/sbin		{{ manpath_map_usr_local_sbin_2 | default('/usr/local/share/man') }}
# Manpath for /usr/X11R6/bin.
MANPATH_MAP	/usr/X11R6/bin		{{ manpath_map_usr_x11r6_bin | default('/usr/X11R6/man') }}
# Manpath for /usr/bin/X11.
MANPATH_MAP	/usr/bin/X11		{{ manpath_map_usr_bin_x11 | default('/usr/X11R6/man') }}
# Manpath for /usr/games.
MANPATH_MAP	/usr/games		{{ manpath_map_usr_games | default('/usr/share/man') }}
# Manpath for /opt/bin.
MANPATH_MAP	/opt/bin		{{ manpath_map_opt_bin | default('/opt/man') }}
# Manpath for /opt/sbin.
MANPATH_MAP	/opt/sbin		{{ manpath_map_opt_sbin | default('/opt/man') }}

#---------------------------------------------------------
# For a manpath element to be treated as a system manpath (as most of those
# above should normally be), it must be mentioned below. Each line may have
# an optional extra string indicating the catpath associated with the
# manpath. If no catpath string is used, the catpath will default to the
# given manpath.
#
# You *must* provide all system manpaths, including manpaths for alternate
# operating systems, locale specific manpaths, and combinations of both, if
# they exist, otherwise the permissions of the user running man/mandb will
# be used to manipulate the manual pages. Also, mandb will not initialise
# the database cache for any manpaths not mentioned below unless explicitly
# requested to do so.
#
# In a per-user configuration file, this directive only controls the
# location of catpaths and the creation of database caches; it has no effect
# on privileges.
#
# Any manpaths that are subdirectories of other manpaths must be mentioned
# *before* the containing manpath. E.g. /usr/man/preformat must be listed
# before /usr/man.
#
#		*MANPATH*     ->	*CATPATH*
#

# Catpath for /usr/man.
MANDB_MAP	/usr/man		{{ mandb_map_usr_man | default('/var/cache/man/fsstnd') }}
# Catpath for /usr/share/man.
MANDB_MAP	/usr/share/man		{{ mandb_map_usr_share_man | default('/var/cache/man') }}
# Catpath for /usr/local/man.
MANDB_MAP	/usr/local/man		{{ mandb_map_usr_local_man | default('/var/cache/man/oldlocal') }}
# Catpath for /usr/local/share/man.
MANDB_MAP	/usr/local/share/man	{{ mandb_map_usr_local_share_man | default('/var/cache/man/local') }}
# Catpath for /usr/X11R6/man.
MANDB_MAP	/usr/X11R6/man		{{ mandb_map_usr_x11r6_man | default('/var/cache/man/X11R6') }}
# Catpath for /opt/man.
MANDB_MAP	/opt/man		{{ mandb_map_opt_man | default('/var/cache/man/opt') }}
# Catpath for /var/lib/snapd/snap/man.
MANDB_MAP	/var/lib/snapd/snap/man		{{ mandb_map_var_lib_snapd_snap_man | default('/var/cache/man/snap') }}
#

#---------------------------------------------------------
# Program definitions.  These are commented out by default as the value
# of the definition is already the default.  To change: uncomment a
# definition and modify it.
#
#DEFINE 	pager	less
#DEFINE 	cat	cat
#DEFINE 	tr	tr '\255\267\264\327' '\055\157\047\170'
#DEFINE		grep	grep
#DEFINE 	troff 	groff -mandoc
#DEFINE 	nroff 	nroff -mandoc
#DEFINE 	eqn 	eqn
#DEFINE 	neqn	neqn
#DEFINE 	tbl 	tbl
#DEFINE 	col 	col
#DEFINE 	vgrind 	
#DEFINE 	refer 	refer
#DEFINE 	grap 	
#DEFINE 	pic 	pic -S
#
#DEFINE		compressor	gzip -c7
#---------------------------------------------------------
# Misc definitions: same as program definitions above.
#
#DEFINE		whatis_grep_flags		-i
#DEFINE		apropos_grep_flags		-iEw
#DEFINE		apropos_regex_grep_flags	-iE
#---------------------------------------------------------
# Section names. Manual sections will be searched in the order listed here;
# the default is 1, n, l, 8, 3, 0, 2, 5, 4, 9, 6, 7. Multiple SECTION
# directives may be given for clarity, and will be concatenated together in
# the expected way.
# If a particular extension is not in this list (say, 1mh), it will be
# displayed with the rest of the section it belongs to. The effect of this
# is that you only need to explicitly list extensions if you want to force a
# particular order. Sections with extensions should usually be adjacent to
# their main section (e.g. "1 1mh 8 ...").
#
SECTION		{{ section_names | default('1 1p 8 2 3 3p 3pm 4 5 6 7 9 0p n l p o 1x 2x 3x 4x 5x 6x 7x 8x') }}
#

#---------------------------------------------------------
# Range of terminal widths permitted when displaying cat pages. If the
# terminal falls outside this range, cat pages will not be created (if
# missing) or displayed.
#
#MINCATWIDTH	80
#MAXCATWIDTH	80
#
# If CATWIDTH is set to a non-zero number, cat pages will always be
# formatted for a terminal of the given width, regardless of the width of
# the terminal actually being used. This should generally be within the
# range set by MINCATWIDTH and MAXCATWIDTH.
#
#CATWIDTH	0
#
#---------------------------------------------------------
# Flags.
# NOCACHE keeps man from creating cat pages.
#NOCACHE
