# Postfix SQLite Plugin Library Path Configuration
# This directive tells Postfix where to load the sqlite.so plugin module.
# It is managed by the postfix-sqlite package.
#
# $shlib_directory is a Postfix internal variable resolving to the
# shared library path (usually /usr/lib/postfix or /usr/lib64/postfix).
# The format is: <path>:<type>:<owner>:<group>:<perms>
$shlib_directory/postfix-sqlite.so:f:root:-:755