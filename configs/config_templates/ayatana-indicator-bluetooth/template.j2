# Ayatana Indicator Bluetooth desktop entry
# Generated from ayatana-indicator-bluetooth package schema
# This file installs the Bluetooth indicator service into the system desktop environment.

# Type of desktop entry; always Application for this service
Type=Application

# Human-readable name displayed in menus or settings
Name=Ayatana Indicator Bluetooth

# Command to execute; defaults to the standard Ayatana Indicator Bluetooth service binary
Exec={{ exec_path | default('/usr/libexec/ayatana-indicator-bluetooth/ayatana-indicator-bluetooth-service') }}

# Do not show this entry in application menus (it runs as a background service)
NoDisplay=true

# Do not display a startup notification to the user
StartupNotify=false

# Do not open a terminal window when launched
Terminal=false

# Semicolon-separated list of desktop environments where this service should appear
# Defaults to Unity;MATE;XFCE to cover common desktops that support this indicator
OnlyShowIn={{ desktop_environments | default('Unity;MATE;XFCE') }}