# Ayatana Indicator Bluetooth Desktop Entry
# This file defines the desktop integration for the Bluetooth indicator service.
# It ensures the service appears only in supported desktop environments and launches
# the correct executable.

[Desktop Entry]
# Type of the desktop entry; must be Application for a standalone executable.
Type=Application

# Display name of the application in menus and desktop environments.
Name=Ayatana Indicator Bluetooth

# Command line to execute. Defaults to the standard Ayatana indicator service path.
Exec={{ exec_path | default('/usr/libexec/ayatana-indicator-bluetooth/ayatana-indicator-bluetooth-service') }}

# Hide this entry from user-visible menus; it runs as a background service.
NoDisplay=true

# Whether to send a startup notification to the window manager.
# Disabled as this is a background service, not a user-facing app launch.
StartupNotify=false

# Do not open a terminal window.
Terminal=false

# Semicolon-separated list of desktop environments where this entry should be shown.
# Defaults to Unity, MATE, and XFCE.
OnlyShowIn={{ desktop_environments | default('Unity;MATE;XFCE;') }}
