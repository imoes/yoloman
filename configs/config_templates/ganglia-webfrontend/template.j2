# Document root for the Ganglia web frontend.
# Path: /usr/share/ganglia-webfrontend (default)
Alias /ganglia {{ ganglia_webfrontend_docroot | default('/usr/share/ganglia-webfrontend') }}

<Directory "{{ ganglia_webfrontend_docroot | default('/usr/share/ganglia-webfrontend') }}">
	# Allow configuration overrides via .htaccess
	AllowOverride All

	# Allow access from all sources (legacy Apache 2.2 syntax)
	Order allow,deny
	Allow from all
	Deny from none
</Directory>