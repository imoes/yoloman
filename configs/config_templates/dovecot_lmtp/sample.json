{
  "protocols": [
    "lmtp"
  ],
  "lmtp_rcpt_check": "yes",
  "lmtp_auth_required": false,
  "lmtp_connection_limit": 100,
  "lmtp_recipient_limit": 100,
  "lmtp_connect_timeout": 30,
  "lmtp_linenSize_limit": 2048,
  "mail_location": "maildir:~/Maildir",
  "lmtp_unix_mode": "0660",
  "lmtp_unix_user": "postfix",
  "lmtp_unix_group": "postfix",
  "lmtp_tcp_enabled": false,
  "lmtp_tcp_address": "127.0.0.1",
  "lmtp_tcp_port": 24,
  "log_path": "/var/log/dovecot-lmtp.log",
  "info_log_path": "/var/log/dovecot-lmtp-info.log",
  "mail_plugins": [
    "sieve"
  ],
  "auth_mechanisms": [
    "plain",
    "login"
  ],
  "passdb_driver": "pam",
  "passdb_args": "",
  "userdb_driver": "static",
  "userdb_args": "uid=vmail gid=vmail home=/var/vmail/%d/%n",
  "mail_fsize_limit": 26214400,
  "mail_max_userip_connections": 10,
  "ssl": "no",
  "ssl_cert_path": "/etc/ssl/certs/dovecot.pem",
  "ssl_key_path": "/etc/ssl/private/dovecot.key",
  "postmaster_address": "postmaster@example.org",
  "hostname": "mail.example.org",
  "lda_mailbox_autocreate": true,
  "lda_mailbox_autosubscribe": true
}
