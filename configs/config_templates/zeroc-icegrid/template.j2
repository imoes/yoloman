#
# IceGrid Node Configuration
# Managed by Ansible. Do not edit manually.
#

#
# Proxy to the IceGrid registry
#
# Hostname or IP address of the IceGrid registry host.
# Default: localhost
#
Ice.Default.Locator=DemoIceGrid/Locator:tcp -h {{ ice_registry_host | default('localhost') }} -p {{ ice_registry_port | default(4061) }}

{% if ice_registry_ssl_port | default('') | string | trim != '' %}
# SSL port for the IceGrid registry locator (used if SSL locator is enabled).
# Default: '' (disabled)
# If set, this overrides the TCP locator above for SSL connections.
Ice.Default.Locator=DemoIceGrid/Locator:ssl -h {{ ice_registry_host | default('localhost') }} -p {{ ice_registry_ssl_port | default('') }}
{% else %}
# SSL locator is disabled.
#Ice.Default.Locator=DemoIceGrid/Locator:ssl -h localhost -p 4062
{% endif %}

#
# The name of this node; must be unique within an IceGrid deployment
# Unique name for this IceGrid node within the deployment.
# Default: node1
#
IceGrid.Node.Name={{ ice_grid_node_name | default('node1') }}

#
# The node object adapter listens on the loopback interface using an
# OS-assigned port. These endpoints must be accessible to IceGrid registries.
#
# Host or IP address the node object adapter binds to.
# Default: localhost
#
# To listen on an additional interface add an additional endpoint with
# -h <name | IP address> or remove -h localhost to listen on all
# interfaces. Note that access to these endpoints can pose a security
# risk (remote code execution) and therefore these endpoints should be
# secured. See the Ice manual for more information.
#
IceGrid.Node.Endpoints=tcp -h {{ ice_grid_node_bind_host | default('localhost') }}

#
# The directory where the IceGrid node maintains its data
# (server configuration files etc.). This directory must exist when icegridnode starts.
# Directory where the IceGrid node maintains its data.
# Default: /var/lib/ice/icegrid/node1
#
IceGrid.Node.Data={{ ice_grid_node_data_dir | default('/var/lib/ice/icegrid/node1') }}

#
# Redirect the servers'stdout and stderr to files in this directory.
# Directory where server stdout and stderr are redirected.
# Default: /var/lib/ice/icegrid/node1
#
IceGrid.Node.Output={{ ice_grid_node_output_dir | default('/var/lib/ice/icegrid/node1') }}

#
# Logging to syslog / systemd journal.
# Whether to use systemd journal for logging.
# Default: '' (disabled/0)
#
{% if ice_use_systemd_journal | default('') | string | trim | bool | default(false) %}
Ice.UseSystemdJournal=1
{% else %}
Ice.UseSystemdJournal=0
{% endif %}

Ice.ProgramName=icegridnode (DemoIceGrid {{ ice_grid_node_name | default('node1') }})

# Trace level for replica operations.
# Default: 2
#
IceGrid.Node.Trace.Replica={{ ice_grid_trace_replica | default('2') }}

#
# IceMX configuration
#
IceMX.Metrics.Debug.GroupBy=id
IceMX.Metrics.Debug.Disabled=1
IceMX.Metrics.Debug.Reject.parent=Ice\.Admin
IceMX.Metrics.ByParent.GroupBy=parent
IceMX.Metrics.ByParent.Disabled=1
