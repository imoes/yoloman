{
  "inbound_dir": "/var/spool/crashmail/inbound",
  "outbound_dir": "/var/spool/crashmail/outbound",
  "areas_dir": "/var/lib/crashmail/areas",
  "log_file": "syslog",
  "areas": [
    {
      "name": "main_fidonet",
      "type": "jam",
      "path": "/var/lib/crashmail/areas/fidojam",
      "auto_add": {
        "use_8dot3": false,
        "path_format": "%A-%Y"
      }
    },
    {
      "name": "local_msg",
      "type": "msg",
      "path": "/var/lib/crashmail/areas/local",
      "auto_add": {
        "use_8dot3": true
      }
    }
  ],
  "links": [
    {
      "node": "2:5020/1234",
      "address": "fido",
      "options": [
        "SECURE",
        "COMPRESS"
      ]
    },
    {
      "node": "2:5030/5678",
      "address": "fido"
    }
  ],
  "system_name": "CrashMail-Debian-Node",
  "system_location": "Data Center, EU",
  "sysop_name": "Debian Admin",
  "sysop_phone": "+49 30 12345678",
  "sysop_email": "sysop@crashmail.example.org",
  "remote_passwords": [
    {
      "node": "2:5020/1234",
      "password": "secret123"
    }
  ],
  "security_enabled": true
}
