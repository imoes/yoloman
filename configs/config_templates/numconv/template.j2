# numconv configuration
# Input number system (e.g., Roman, Western_Lower, Mandarin_Regular_Simplified)
# The number system of the input data.
-f {{ (numconv | default({})).input_system | default('Western_Lower') }}

# Output number system (e.g., Western_Lower, Devanagari, Perso_Arabic)
# The number system of the output data.
-t {{ (numconv | default({})).output_system | default('Western_Lower') }}

# Input base for Western numbers (range 1-36). Only used if input_system is Western.
# Input base for Western numbers, 1-36.
-b {{ (numconv | default({})).input_base | default(10) }}

# Output base for Western numbers (range 1-36). Only used if output_system is Western.
# Output base for Western numbers, 1-36.
-B {{ (numconv | default({})).output_base | default(10) }}

# General digit group size for output (e.g., thousands separator grouping)
# Size of general digit groups (e.g., thousands).
-g {{ (numconv | default({})).group_size | default(3) }}

# Low-order digit group size for output
# Size of the low-order digit group.
-G {{ (numconv | default({})).low_group_size | default(3) }}

# Character to use as group separator
# Character used as the thousands separator.
-s "{{ (numconv | default({})).group_separator | default(',') }}"

# Enable superscript macron for Roman numerals > 1000
# Use superscript macron for Roman numerals > 1000.
-m {{ (numconv | default({})).roman_superscript | default(False) | lower }}

# Use current locale for grouping parameters
# Apply locale settings for grouping parameters.
-L {{ (numconv | default({})).use_locale | default(False) | lower }}

# Input file to read from. If omitted, reads from stdin.
# Path to input file. Empty means stdin.
-i "{{ (numconv | default({})).input_file | default('') }}"

# Output file to write to. If omitted, writes to stdout.
# Path to output file. Empty means stdout.
-o "{{ (numconv | default({})).output_file | default('') }}"