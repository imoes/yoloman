# ==============================================================================
# /etc/issue.net — Network Login Banner Configuration
# ==============================================================================
# This file is used by the SSH daemon (sshd) when the 'Banner' option is enabled
# in sshd_config (e.g., Banner /etc/issue.net). It displays a message to users
# before they authenticate.
#
# This template is self-documenting. All variables are pulled from the Ansible
# inventory/variables with safe defaults derived from the schema.
# ==============================================================================

{# --- Header Line --- #}
{# Description: First line shown in the banner (often includes system name or environment). #}
{# Default: Welcome to {{ hostname }} #}
# {{ (header_line | default('Welcome to {{ hostname }}')) }}

{# --- Welcome Message --- #}
{# Description: Primary welcome or authorization statement. Supports line breaks. #}
{# Default: This system is for authorized users only.\nAll activities may be monitored and recorded. #}
# {{ (welcome_message | default('This system is for authorized users only.\nAll activities may be monitored and recorded.')) }}

{# --- Legal Notice (Optional) --- #}
{# Description: Optional legal disclaimer or terms of use. Leave empty to omit. #}
{# Default: (empty) #}
{% if legal_notice | default('', true) %}
#
# {{ legal_notice | default('') }}
{% endif %}

{# --- Warning Lines (List) --- #}
{# Description: List of additional warning or usage restriction lines. Each entry appears on its own line. #}
{# Default: [] #}
{% if warning_lines | default([]) %}
#
# Additional Notices:
{% for line in warning_lines | default([]) %}
# {{ line }}
{% endfor %}
{% endif %}

{# --- Footer Line --- #}
{# Description: Final separator or closing line. Leave empty to omit. #}
{# Default: --- #}
{% if footer_line | default('---', true) %}
#
# {{ footer_line | default('---') }}
{% endif %}