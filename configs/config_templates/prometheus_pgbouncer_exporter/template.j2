# ==============================================================================
# /etc/default/prometheus-pgbouncer-exporter — Environment variables for the
# Prometheus PgBouncer exporter systemd service.
#
# This file is auto-generated by Ansible from a Jinja2 template.
# Do NOT edit by hand; your changes will be overwritten on next playbook run.
#
# For documentation on every setting, see the Ansible role schema or the
# upstream exporter README: https://github.com/prometheus-community/pgbouncer_exporter
# ==============================================================================

# ------------------------------------------------------------------------------
# listen_address: IP address the exporter listens on for incoming HTTP requests
# from Prometheus.
# ------------------------------------------------------------------------------
PGBOUNCER_EXPORTER_LISTEN_ADDRESS={{ listen_address | default('0.0.0.0') }}

# ------------------------------------------------------------------------------
# listen_port: Port number the exporter listens on for Prometheus scrapes.
# ------------------------------------------------------------------------------
PGBOUNCER_EXPORTER_LISTEN_PORT={{ listen_port | default(9127) }}

# ------------------------------------------------------------------------------
# instances: List of PgBouncer instances to monitor, each specified as
# 'host:port'. Joined with commas for the DSN format.
# ------------------------------------------------------------------------------
{% if (instances | default([])) | length > 0 %}
# One or more PgBouncer instances to scrape (format: host:port,host:port,...)
PGBOUNCER_EXPORTER_PGBOUNCER_DSN={{ instances | default([]) | join(',') }}
{% else %}
# No PgBouncer instances configured — set PGBOUNCER_EXPORTER_PGBOUNCER_DSN
# to at least one host:port before starting the exporter.
PGBOUNCER_EXPORTER_PGBOUNCER_DSN=""
{% endif %}

# ------------------------------------------------------------------------------
# dsn_password: Password for authenticating to PgBouncer (if required by
# PgBouncer's auth_type). Leave empty if using trust or other non-password auth.
# ------------------------------------------------------------------------------
{% if dsn_password | default('') != '' %}
PGBOUNCER_EXPORTER_PGBOUNCER_DSN_PASSWORD={{ dsn_password | default('') }}
{% endif %}

# ------------------------------------------------------------------------------
# metrics_path: HTTP path under which metrics are exposed (e.g., /metrics or
# /pgbouncer/metrics).
# ------------------------------------------------------------------------------
PGBOUNCER_EXPORTER_METRICS_PATH={{ metrics_path | default('/metrics') }}

# ------------------------------------------------------------------------------
# collect_database_metrics: Whether to collect per-database metrics
# (e.g., total queries, active connections per DB).
# ------------------------------------------------------------------------------
{% if collect_database_metrics | default(True) %}
PGBOUNCER_EXPORTER_COLLECT_DATABASE_METRICS=true
{% else %}
PGBOUNCER_EXPORTER_COLLECT_DATABASE_METRICS=false
{% endif %}

# ------------------------------------------------------------------------------
# collect_pool_metrics: Whether to collect per-pool metrics
# (e.g., pool size, waiting clients per pool).
# ------------------------------------------------------------------------------
{% if collect_pool_metrics | default(True) %}
PGBOUNCER_EXPORTER_COLLECT_POOL_METRICS=true
{% else %}
PGBOUNCER_EXPORTER_COLLECT_POOL_METRICS=false
{% endif %}

# ------------------------------------------------------------------------------
# log_level: Log verbosity: debug, info, warn, or error.
# ------------------------------------------------------------------------------
PGBOUNCER_EXPORTER_LOG_LEVEL={{ log_level | default('info') }}

# ------------------------------------------------------------------------------
# connection_timeout: Maximum time (seconds) to wait for a response from
# PgBouncer. Set to 0 to disable timeout.
# ------------------------------------------------------------------------------
{% if connection_timeout | default(0) != 0 %}
PGBOUNCER_EXPORTER_CONNECTION_TIMEOUT={{ connection_timeout | default(0) }}
{% endif %}

# ------------------------------------------------------------------------------
# tls_enabled: Enable TLS (HTTPS) for the exporter's metrics endpoint
# (requires cert/key files).
# ------------------------------------------------------------------------------
{% if tls_enabled | default(False) %}
PGBOUNCER_EXPORTER_TLS_ENABLED=true
PGBOUNCER_EXPORTER_TLS_CERT_FILE={{ tls_cert_file | default('/etc/prometheus-pgbouncer-exporter/tls/cert.pem') }}
PGBOUNCER_EXPORTER_TLS_KEY_FILE={{ tls_key_file | default('/etc/prometheus-pgbouncer-exporter/tls/key.pem') }}
{% else %}
PGBOUNCER_EXPORTER_TLS_ENABLED=false
{% endif %}