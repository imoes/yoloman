# iftop configuration file
# Interface to capture traffic on
interface: {{ interface }}

# Network interface filter (BPF format)
# e.g., 'port 80' to only show HTTP traffic
bpf_filter: {{ bpf_filter }}

# Display mode: 'c' (default: cumulative bytes), 't' (total), 'b' (bytes per second)
output_mode: {{ output_mode }}

# Number of hosts to display in the host list (top N)
host_limit: {{ host_limit }}

# Log file path for continuous monitoring (disabled if empty)
log_file: {{ log_file }}

# Enable/disable reverse DNS lookups for IP addresses
reverse_dns: {{ reverse_dns }}

# DNS timeout (milliseconds) for reverse lookups
dns_timeout: {{ dns_timeout }}

# Port mapping file path (custom port→service mappings)
port_map_file: {{ port_map_file }}

# Enable/disable sorting by traffic (0: source, 1: destination, 2: total)
sort_by: {{ sort_by }}

# Enable/disable color output (ignored if no terminal)
color: {{ color }}

# Log level: 0=quiet, 1=normal, 2=verbose, 3=debug
log_level: {{ log_level }}

# List of hosts/IPs to ignore in display (matched as substring)
ignore_hosts:
{% for host in ignore_hosts %}  - {{ host }}
{% endfor %}
