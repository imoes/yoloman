{
  "interface": "enp4s0",
  "bpf_filter": "not host 10.0.0.1",
  "output_mode": "b",
  "host_limit": 50,
  "log_file": "/var/log/iftop/current.log",
  "reverse_dns": true,
  "dns_timeout": 3000,
  "port_map_file": "/etc/iftop/portmap",
  "sort_by": 1,
  "color": true,
  "log_level": 2,
  "ignore_hosts": [
    "10.0.0.1",
    "127.0.0.1"
  ]
}
