{
  "home_dir": {
    "type": "string",
    "default": ".",
    "description": "The home directory used for RANDFILE and other relative paths."
  },
  "ca_dir": {
    "type": "string",
    "default": "./demoCA",
    "description": "The root directory for all CA operations (certs, crl, database, keys)."
  },
  "ca_default_days": {
    "type": "number",
    "default": 365,
    "description": "Default number of days to certify for."
  },
  "ca_default_crl_days": {
    "type": "number",
    "default": 30,
    "description": "Default number of days before next CRL."
  },
  "ca_default_md": {
    "type": "string",
    "default": "md5",
    "description": "Which message digest to use."
  },
  "ca_preserve": {
    "type": "bool",
    "default": false,
    "description": "Keep passed DN ordering."
  },
  "req_default_bits": {
    "type": "number",
    "default": 1024,
    "description": "Default number of bits in keys."
  },
  "req_default_keyfile": {
    "type": "string",
    "default": "privkey.pem",
    "description": "The default private key file name."
  },
  "req_string_mask": {
    "type": "string",
    "default": "nombstr",
    "description": "Mask for permitted string types.",
    "enum": [
      "default",
      "pkix",
      "utf8only",
      "nombstr",
      "MASK:XXXX"
    ]
  },
  "req_country_default": {
    "type": "string",
    "default": "AU",
    "description": "Default Country Name (2 letter code)."
  },
  "req_state_default": {
    "type": "string",
    "default": "Some-State",
    "description": "Default State or Province Name."
  },
  "req_org_default": {
    "type": "string",
    "default": "Internet Widgits Pty Ltd",
    "description": "Default Organization Name."
  },
  "req_challenge_password": {
    "type": "string",
    "default": "A challenge password",
    "description": "Default challenge password prompt text/value."
  }
}
