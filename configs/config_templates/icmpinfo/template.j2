# /etc/default/icmpinfo
# Configuration file for icmpinfo
# This file controls the behavior of the icmpinfo utility.
# Each variable corresponds to a specific operational mode of the tool.

# Verbosity level: 0 (normal/weird packets only), 1 (all except pings),
# 2 (include pings), 3 (hex dump).
# Default: 0
VERBOSE={{ verbose | default(0) }}

# Avoid name queries, use IP addresses only.
# When enabled, icmpinfo will not perform DNS lookups on packet addresses.
# Default: false
NO_RESOLVE={{ no_resolve | default(False) }}

# Avoid port number to service name decoding.
# When enabled, icmpinfo will display raw port numbers instead of resolving them to service names.
# Default: false
NO_PORTS={{ no_ports | default(False) }}

# Show the interface IP that received the packet.
# Useful for diagnosing which network interface handled the traffic.
# Default: false
SHOW_INTERFACE={{ show_interface | default(False) }}

# Fork and use syslog facility to record events.
# When enabled, icmpinfo logs to syslog instead of writing to stdout/stderr.
# Default: false
SYSLOG={{ syslog | default(False) }}