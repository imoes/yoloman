{
  "agent_id": "l3-agent-az1",
  "debug": false,
  "state_sync_interval": 60,
  "max_routers_per_agent": 50,
  "external_network_bridge": "br-ex",
  "enable_nat": true,
  "num_router_agents": 2,
  "ha": true,
  "ha_network_name": "ha-net",
  "ha_network_mtu": 1400,
  "gateway_external_device": "eth2",
  "enable_ipv6": true,
  "report_interval": 30,
  "min_restart_interval": 5,
  "keepalived_max_retries": 3,
  "keepalived_restart_delay": 15,
  "external_networks": [
    {
      "name": "provider-net",
      "bridge": "br-ex",
      "gateway": "203.0.113.1/24"
    },
    {
      "name": "mpls-ext",
      "bridge": "br-mpls",
      "gateway": "100.64.0.1/24",
      "vlan": 100
    }
  ]
}
