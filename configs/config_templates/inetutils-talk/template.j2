# Configuration for inetutils-talk
# This template configures the inetutils-talk daemon. It listens for connection
# requests from talk clients on a specified port and bind address.

# TALKD_PORT: The TCP/UDP port number on which the talk daemon listens for
# connection requests. Default is 517.
# See: man talkd
TALKD_PORT={{ talkd_port | default(517) }}

# ENABLE_TALKD: Whether to start the talk daemon (talkd) as a background
# service. Set to 'yes' or 'no'. Default is 'no'.
ENABLE_TALKD={{ enable_talkd | default(false) | ternary('yes', 'no') }}

# TALKD_ADDRESS: The IP address or hostname to bind the talk daemon to.
# An empty string binds to all interfaces. Default is empty.
TALKD_ADDRESS={{ talkd_address | default('', true) }}