# =============================================================================
# Psensor-Server Configuration Template
# =============================================================================
# This template generates the command-line arguments for the psensor-server daemon.
# Psensor-server is a lightweight HTTP server that exposes sensor data (temperature,
# fans, etc.) collected by Psensor/libstats to remote clients via a REST-like API.
# =============================================================================

# --port
# Webserver port number.
# The TCP port on which psensor-server listens for incoming HTTP connections.
# Default: 3131
#
# If `port` is not provided, defaults to 3131.
--port={{ port | default(3131) }}

# --wdir
# Directory containing webserver pages.
# Specifies the directory where static HTML/CSS/JS files for the web interface are stored.
# Default: /usr/share/psensor
#
# If `wdir` is not provided, defaults to /usr/share/psensor.
--wdir={{ wdir | default('/usr/share/psensor') }}

# --log-file
# Path to the log file.
# The absolute path to the file where psensor-server will write its operational logs.
# Ensure the directory exists and the service user has write permissions.
# Default: /var/log/psensor-server.log
#
# If `log_file` is not provided, defaults to /var/log/psensor-server.log.
--log-file={{ log_file | default('/var/log/psensor-server.log') }}

# --sensor-log-file
# Path to the sensor log file.
# If specified, psensor-server will log raw sensor data readings to this file.
# Leave empty (or omit) to disable sensor logging.
# Default: '' (empty string, disables logging)
#
# If `sensor_log_file` is not provided, defaults to empty string.
--sensor-log-file={{ sensor_log_file | default('') }}

# --sensor-log-interval
# Sensor log interval in seconds.
# Determines how frequently sensor data is written to the sensor log file.
# Only applies if `sensor_log_file` is set.
# Default: 10
#
# If `sensor_log_interval` is not provided, defaults to 10.
--sensor-log-interval={{ sensor_log_interval | default(10) }}

# --debug
# Debug level.
# Controls the verbosity of debug output. Integer between 0 and 3.
# 0 = No debug output, 1 = Basic, 2 = Detailed, 3 = Verbose.
# Default: 0
#
# If `debug_level` is not provided, defaults to 0.
--debug={{ debug_level | default(0) }}