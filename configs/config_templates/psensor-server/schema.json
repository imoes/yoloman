{
  "port": {
    "type": "number",
    "default": 3131,
    "description": "Webserver port number"
  },
  "wdir": {
    "type": "string",
    "default": "/usr/share/psensor",
    "description": "Directory containing webserver pages"
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/psensor-server.log",
    "description": "Path to the log file"
  },
  "sensor_log_file": {
    "type": "string",
    "default": "",
    "description": "Path to the sensor log file. Leave empty to disable sensor logging."
  },
  "sensor_log_interval": {
    "type": "number",
    "default": 10,
    "description": "Sensor log interval in seconds"
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Debug level, integer between 0 and 3"
  }
}
