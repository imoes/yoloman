# ttylog service configuration
#
# This configuration file drives the ttylog daemon, which mirrors serial terminal
# activity to a log file. All values are self-documented with their schema defaults.

# The serial device file path (e.g., /dev/ttyS0, /dev/ttyUSB0).
# default: /dev/ttyS0
device: {{ device | default('/dev/ttyS0') }}

# The baud rate for the serial device. Must be one of: 300, 1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200.
# default: 9600
baud: {{ baud | default(9600) }}

# The absolute path to the file where ttylog output is redirected.
# default: /var/log/ttylog.log
logfile: {{ logfile | default('/var/log/ttylog.log') }}

# If true, enables the --flush option to output buffers after every write.
# default: True
flush: {{ flush | default(true) | lower }}

# Timeout in seconds. If 0, ttylog runs indefinitely.
# default: 0
timeout: {{ timeout | default(0) }}

# List of additional command-line arguments to append to the ttylog command.
# default: []
extra_args: {{ extra_args | default([]) | join(' ') }}