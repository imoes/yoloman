# ==============================================================================
# Configuration for Wig (WebApp Information Gatherer)
#
# This template generates a YAML-style configuration for the 'wig' tool,
# which scans websites for CMS identification and fingerprinting.
#
# All fields use Jinja2 defaults derived from the schema. If you wish to
# override them via Ansible variables, simply define the variable (e.g.,
# `wig_url: http://target.com`) in your play or inventory.
# ==============================================================================

# The primary URL to scan for CMS identification.
# Schema: url | default='http://example.com'
url: {{ url | default('http://example.com') }}

# File with URLs, one per line. Use '-' to read from stdin.
# Schema: input_file | default='-'
input_file: {{ input_file | default('-') }}

# File to dump results into (JSON). Use '-' to print to stdout.
# Schema: output_file | default='-'
output_file: {{ output_file | default('-') }}

# Number of threads to use for concurrent requests.
# Schema: threads | default=4
threads: {{ threads | default(4) }}

# Proxy server address to tunnel through (format: localhost:8080).
# Schema: proxy | default=''
proxy: {{ proxy | default('') }}

# User-Agent header string to use in requests.
# Schema: user_agent | default='Wig/0.6'
user_agent: {{ user_agent | default('Wig/0.6') }}

# Verbosity level. Increase for more detailed output.
# Schema: verbosity | default=0
verbosity: {{ verbosity | default(0) }}

# Stop after this amount of CMSs have been detected.
# Schema: n_stop_after | default=1
n_stop_after: {{ n_stop_after | default(1) }}

# If true, do not stop after the first CMS is detected.
# Schema: a_all | default=False
a_all: {{ a_all | default(false) | lower }}

# If true, try harder to find a match without making more requests.
# Schema: m_harder | default=False
m_harder: {{ m_harder | default(false) | lower }}

# If true, disable the search for subdomains.
# Schema: d_no_subdomains | default=False
d_no_subdomains: {{ d_no_subdomains | default(false) | lower }}

# If true, do not load cached responses.
# Schema: no_cache_load | default=False
no_cache_load: {{ no_cache_load | default(false) | lower }}

# If true, do not save the cache for later use.
# Schema: no_cache_save | default=False
no_cache_save: {{ no_cache_save | default(false) | lower }}

# If true, set wig to not prompt for user input during run.
# Schema: quiet | default=False
quiet: {{ quiet | default(false) | lower }}