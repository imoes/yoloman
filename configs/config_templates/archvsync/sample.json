{
  "enabled": true,
  "mirror_root": "/srv/mirror/debian",
  "max_rsync_jobs": 4,
  "max_bandwidth_per_job_kb": 0,
  "architectures": [
    "amd64",
    "arm64"
  ],
  "distributions": [
    "bullseye",
    "bullseye-updates",
    "bullseye-security"
  ],
  "components": [
    "main",
    "contrib",
    "non-free"
  ],
  "sync_sources": false,
  "sync_installer": true,
  "delete_missing": false,
  "upstreams": [
    "rsync://ftp.debian.org/debian/",
    "rsync://mirror.csclub.uwaterloo.ca/debian/"
  ],
  "log_file": "/var/log/archvsync.log",
  "admin_email": "mirror-admin@myorg.edu",
  "run_cron": true,
  "cron_schedule": "0 2 * * *",
  "lock_file": "/var/lock/archvsync.lock",
  "proxy": "",
  "rsync_extra_opts": [
    "--delete-after",
    "--compress"
  ],
  "max_metadata_age_hours": 72,
  "generate_metaindex": true,
  "post_sync_script": ""
}
