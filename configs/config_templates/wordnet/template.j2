# ===========================================================================
# WordNet Configuration Template
# ===========================================================================
# This file configures the WordNet lexical database lookup tool.
# It sets the environment variables that WordNet uses to locate its dictionary
# data and base installation directory.
#
# Schema Fields:
#   - WNHOME: Base directory for WordNet (e.g., /usr/local/WordNet-3.0)
#   - WNSEARCHDIR: Directory containing the WordNet dictionary files (e.g., /usr/local/WordNet-3.0/dict)
# ===========================================================================

# ---------------------------------------------------------------------------
# WNHOME: Base directory for WordNet installation
# ---------------------------------------------------------------------------
# Corresponds to the WNHOME environment variable.
# This is the root directory where WordNet is installed.
# Default: /usr/local/WordNet-3.0
# ---------------------------------------------------------------------------
WNHOME={{ wnhome | default('/usr/local/WordNet-3.0') }}

# ---------------------------------------------------------------------------
# WNSEARCHDIR: Directory containing the WordNet database files
# ---------------------------------------------------------------------------
# Corresponds to the WNSEARCHDIR environment variable.
# This is the specific directory where the dictionary data files reside.
# Default: /usr/local/WordNet-3.0/dict
# ---------------------------------------------------------------------------
WNSEARCHDIR={{ wnsearchdir | default('/usr/local/WordNet-3.0/dict') }}