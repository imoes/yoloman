{
  "debug": false,
  "log_file": "/var/log/glance/api.log",
  "log_level": "INFO",
  "workers": 2,
  "database": {
    "connection": "mysql+pymysql://glance:secretpassword@192.168.1.10/glance",
    "max_retries": 10
  },
  "keystone_authtoken": {
    "auth_url": "https://keystone.example.com:5000/v3",
    "username": "glance",
    "password": "glance_secret_pass",
    "project_name": "service",
    "project_domain_name": "Default",
    "user_domain_name": "Default",
    "insecure": false,
    "cafile": "/etc/ssl/certs/ca-certificates.crt"
  },
  "paste_deploy": {
    "flavor": "keystone"
  },
  "stores": [
    {
      "name": "file",
      "description": "Local filesystem (primary store)"
    },
    {
      "name": "swift",
      "region": "RegionOne",
      "description": "Swift object storage (backup)"
    },
    {
      "name": "s3",
      "region": "us-east-1",
      "description": "S3-compatible storage (DR site)"
    }
  ],
  "default_store": "file",
  "filesystem_store_datadir": "/var/lib/glance/images",
  "image_cache_dir": "/var/lib/glance/image-cache",
  "image_formats": [
    "qcow2",
    "raw",
    "vhd",
    "vdi",
    "vmdk",
    "bare",
    "docker",
    "aki",
    "ari",
    "ami"
  ],
  "task": {
    "enable": true,
    "workers": 2
  },
  "notifications_driver": "routing"
}
