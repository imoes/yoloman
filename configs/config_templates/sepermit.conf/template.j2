# /etc/security/sepermit.conf — Controls session enforcement policy for sepermit (SELinux session tracking module)
# Enable or disable permissive mode at boot
permissive = {{ permissive | string | lower }}

# Log violations to syslog in addition to audit logs
log_violations = {{ log_violations | string | lower }}

# Maximum number of concurrent session tracking entries
max_sessions = {{ max_sessions }}

# List of SELinux types that may bypass session enforcement (empty = none)
{% for type in bypass_types %}bypass_type = {{ type }}
{% endfor %}

# List of users exempted from session enforcement
{% for user in exempt_users %}exempt_user = {{ user }}
{% endfor %}

# Path to the SELinux enforcement state file (for external tools)
enforcement_state_file = {{ enforcement_state_file }}

# Optional: custom audit prefix for log messages
# (Leave empty to use default 'sepermit:' prefix)
{% if audit_prefix %}audit_prefix = {{ audit_prefix }}
{% endif %}