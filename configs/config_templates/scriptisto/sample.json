{
  "cache_dir": "/var/cache/scriptisto",
  "template_dir": "/etc/scriptisto/templates",
  "compile_timeout": 60,
  "exec_timeout": 300,
  "languages": [
    {
      "name": "python3",
      "compiler_path": "/usr/bin/python3",
      "compiler_args": [],
