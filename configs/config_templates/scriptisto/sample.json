        ".py"
      ],
      "description": "Python 3 script"
    },
    {
      "name": "go",
      "compiler_path": "/usr/bin/go",
      "compiler_args": [
        "run"
      ],
      "exec_args": [],
      "extensions": [
        ".go"
      ],
      "description": "Go script"
    }
  ]
}
