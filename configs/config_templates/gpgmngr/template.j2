# =============================================================================
# gpgmngr configuration
# =============================================================================
# This file is generated by Ansible. Do not edit manually.
# It configures the 'gpgmngr' service which manages GPG keyrings.
# See schema fields for detailed descriptions.

# --------------------------------------------
# Global settings for gpgmngr
# --------------------------------------------
[global]
# Path to the GPG home directory (GPGCONF_DIR), where keyrings and configuration
# files are stored.
home = {{ gpg_home | default('~/.gnupg') }}

# Default keyserver URL used for key lookup and import/export operations.
# Must be an HKP, LDAP, or HTTPS URL.
keyserver = {{ keyserver | default('hkp://keyserver.ubuntu.com') }}

# Timeout in seconds for network operations to the keyserver.
timeout = {{ keyserver_timeout | default(10) }}

# --------------------------------------------
# Backup configuration
# --------------------------------------------
[backup]
# Whether to enable automatic backups of the keyring before destructive operations.
# Must be 'true' or 'false'.
enabled = {{ backup_enabled | default(false) | string | lower }}

# Directory path where backup copies of the keyring are stored.
backup_dir = {{ backup_dir | default('~/.gpgmngr/backups') }}

# Maximum number of backup files to retain in the backup directory.
retention_count = {{ backup_retention_count | default(5) }}

# --------------------------------------------
# Notification configuration
# --------------------------------------------
[notify]
# Whether to enable desktop notifications for long-running or critical operations.
enabled = {{ notify_enabled | default(true) | string | lower }}

# Optional path to a sound file to play with notifications (desktop-specific).
sound = {{ notify_sound | default('') }}