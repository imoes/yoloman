{
  "target_host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Target IP or hostname to attack."
  },
  "service": {
    "type": "string",
    "default": "ssh",
    "description": "Service module to use (e.g., ssh, ftp, http-get).",
    "enum": [
      "adam6500",
      "afp",
      "asterisk",
      "cisco",
      "cisco-enable",
      "cvs",
      "firebird",
      "ftp",
      "ftps",
      "http-proxy",
      "http-proxy-urlenum",
      "icq",
      "imap",
      "irc",
      "ldap2",
      "ldap3",
      "mssql",
      "mysql",
      "mysql5",
      "ncp",
      "nntp",
      "oracle",
      "oracle-listener",
      "oracle-sid",
      "pcanywhere",
      "pcnfs",
      "pop3",
      "postgres",
      "rdp",
      "radmin2",
      "redis",
      "rexec",
      "rlogin",
      "rpcap",
      "rsh",
      "rtsp",
      "s7-300",
      "sapr3",
      "sip",
      "smb",
      "smtp",
      "smtp-enum",
      "snmp",
      "socks5",
      "ssh",
      "sshkey",
      "svn",
      "teamspeak",
      "telnet",
      "vmauthd",
      "vnc",
      "xmpp"
    ]
  },
  "service_params": {
    "type": "string",
    "default": "",
    "description": "Optional parameters specific to the service module."
  },
  "tasks": {
    "type": "number",
    "default": 16,
    "description": "Number of parallel connections."
  },
  "wait_time": {
    "type": "number",
    "default": 32,
    "description": "Max wait time for responses in seconds."
  },
  "wait_between": {
    "type": "number",
    "default": 0,
    "description": "Wait time between each connection per task in seconds."
  },
  "wait_per_login": {
    "type": "number",
    "default": 0,
    "description": "Wait time per login attempt across all threads in seconds."
  },
  "login": {
    "type": "string",
    "default": "admin",
    "description": "Username to use (-l)."
  },
  "password_file": {
    "type": "string",
    "default": "/path/to/passwords.txt",
    "description": "Path to password list file (-P)."
  },
  "output_file": {
    "type": "string",
    "default": "hydra_results.txt",
    "description": "Output file for results (-o)."
  },
  "output_format": {
    "type": "string",
    "default": "text",
    "description": "Output format: text, json, or jsonv1 (-b).",
    "enum": [
      "text",
      "json",
      "jsonv1"
    ]
  },
  "exit_any": {
    "type": "bool",
    "default": false,
    "description": "Exit after first found pair for any host (-F)."
  },
  "exit_host": {
    "type": "bool",
    "default": false,
    "description": "Exit after first found pair per host (-f)."
  },
  "use_ssl": {
    "type": "bool",
    "default": false,
    "description": "Connect via SSL (-S)."
  },
  "prefer_ipv4": {
    "type": "bool",
    "default": true,
    "description": "Prefer IPv4 (-4)."
  },
  "prefer_ipv6": {
    "type": "bool",
    "default": false,
    "description": "Prefer IPv6 (-6)."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Verbose mode (-v)."
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Debug mode (-d)."
  },
  "login_file": {
    "type": "string",
    "default": "",
    "description": "Path to login list file (-L)."
  },
  "try_null_password": {
    "type": "bool",
    "default": false,
    "description": "Try null password check (-e n)."
  },
  "try_login_as_pass": {
    "type": "bool",
    "default": false,
    "description": "Try login as password check (-e s)."
  },
  "try_reverse_login": {
    "type": "bool",
    "default": false,
    "description": "Try reverse login as password check (-e r)."
  },
  "port": {
    "type": "number",
    "default": 0,
    "description": "Custom port for the service (-s). 0 means default."
  },
  "restore_session": {
    "type": "bool",
    "default": false,
    "description": "Restore a previously aborted session (-R)."
  },
  "ignore_restore": {
    "type": "bool",
    "default": false,
    "description": "Ignore existing restore file (-I)."
  },
  "loop_passwords": {
    "type": "bool",
    "default": false,
    "description": "Loop through passwords for each login (-u)."
  },
  "module_options": {
    "type": "string",
    "default": "",
    "description": "Module specific options (-m)."
  },
  "custom_args": {
    "type": "string",
    "default": "",
    "description": "Additional raw arguments to pass to hydra."
  }
}
