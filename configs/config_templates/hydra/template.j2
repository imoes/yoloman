# Hydra Network Logon Cracker Configuration
# This file stores default options for the 'hydra' tool.
# Note: Hydra is primarily a CLI tool. This config supports default values for
# common operational parameters to avoid typing them repeatedly.

# Target IP or hostname to attack.
# Corresponds to the positional 'server' argument.
target_host = {{ target_host | default('127.0.0.1') }}

# Service module to use (e.g., ssh, ftp, http-get).
# Corresponds to the positional 'service' argument.
service = {{ service | default('ssh') }}

# Optional parameters specific to the service module.
# Corresponds to optional service parameters passed after service.
# Example for http-post-form: "/login.php^user=^pass^S=success"
service_params = {{ service_params | default('') }}

# Number of parallel connections.
# Corresponds to -t TASKS (default: 16)
tasks = {{ tasks | default(16) }}

# Max wait time for responses in seconds.
# Corresponds to -w TIME (default: 32)
wait_time = {{ wait_time | default(32) }}

# Wait time between each connection per task in seconds.
# Corresponds to -W TIME
wait_between = {{ wait_between | default(0) }}

# Wait time per login attempt across all threads in seconds.
# Corresponds to -c TIME
wait_per_login = {{ wait_per_login | default(0) }}

# Username to use (-l).
login = {{ login | default('admin') }}

# Path to password list file (-P).
password_file = {{ password_file | default('/path/to/passwords.txt') }}

# Output file for results (-o).
output_file = {{ output_file | default('hydra_results.txt') }}

# Output format: text, json, or jsonv1 (-b).
output_format = {{ output_format | default('text') }}

# Exit after first found pair for any host (-F).
exit_any = {{ exit_any | default(false) | lower }}

# Exit after first found pair per host (-f).
exit_host = {{ exit_host | default(false) | lower }}

# Connect via SSL (-S).
use_ssl = {{ use_ssl | default(false) | lower }}

# Prefer IPv4 (-4).
prefer_ipv4 = {{ prefer_ipv4 | default(true) | lower }}

# Prefer IPv6 (-6).
prefer_ipv6 = {{ prefer_ipv6 | default(false) | lower }}

# Verbose mode (-v).
verbose = {{ verbose | default(false) | lower }}

# Debug mode (-d).
debug = {{ debug | default(false) | lower }}

# Path to login list file (-L).
login_file = {{ login_file | default('') }}

# Try null password check (-e n).
try_null_password = {{ try_null_password | default(false) | lower }}

# Try login as password check (-e s).
try_login_as_pass = {{ try_login_as_pass | default(false) | lower }}

# Try reverse login as password check (-e r).
try_reverse_login = {{ try_reverse_login | default(false) | lower }}

# Custom port for the service (-s). 0 means default.
port = {{ port | default(0) }}

# Restore a previously aborted session (-R).
restore_session = {{ restore_session | default(false) | lower }}

# Ignore existing restore file (-I).
ignore_restore = {{ ignore_restore | default(false) | lower }}

# Loop through passwords for each login (-u).
loop_passwords = {{ loop_passwords | default(false) | lower }}

# Module specific options (-m).
module_options = {{ module_options | default('') }}

# Additional raw arguments to pass to hydra.
custom_args = {{ custom_args | default('') }}