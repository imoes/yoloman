{
  "rules": [
    {
      "name": "update",
      "command": "sudo apt update -y"
    },
    {
      "name": "install",
      "command": "sudo apt install -y {package}"
    }
  ],
  "bottles": [
    {
      "name": "package",
      "value": "vim"
    }
  ],
  "log_verbose": true,
  "auto_export": false
}
