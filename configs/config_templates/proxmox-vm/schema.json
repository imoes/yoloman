{
  "name": {"type": "string", "description": "VM name"},
  "cores": {"type": "number", "default": 2},
  "sockets": {"type": "number", "default": 1},
  "memory": {"type": "number", "default": 2048, "description": "MiB"},
  "ostype": {"type": "string", "default": "l26"},
  "scsihw": {"type": "string", "default": "virtio-scsi-single"},
  "disks": {"type": "list", "description": "[{bus, storage, volume, size}]"},
  "nets": {"type": "list", "description": "[{model, mac, bridge, tag?}]"},
  "boot_order": {"type": "string", "default": "scsi0"},
  "onboot": {"type": "number", "default": 1},
  "agent": {"type": "number", "default": 1}
}
