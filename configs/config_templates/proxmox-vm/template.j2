# Proxmox VE Virtual Machine Definition
# Generated by Ansible. Do not edit manually.

# VM name
name: {{ name | default('default-vm') }}

# Number of virtual CPU cores allocated to the VM
cores: {{ cores | default(2) }}

# Number of virtual CPU sockets (affects NUMA layout and CPU allocation)
sockets: {{ sockets | default(1) }}

# Memory in MiB
memory: {{ memory | default(2048) }}

# Guest operating system type identifier (e.g., l26 for Linux 2.6+)
ostype: {{ ostype | default('l26') }}

# SCSI controller model used for disk devices (e.g., virtio-scsi-single)
scsihw: {{ scsihw | default('virtio-scsi-single') }}

# Disk devices
# Each disk entry defines a virtual disk attached to the VM.
# Schema: {bus: str, storage: str, volume: str, size: int}
{% for d in (disks | default([])) %}
# Disk {{ loop.index0 }}: bus={{ d.bus }}, storage={{ d.storage }}, volume={{ d.volume }}, size={{ d.size }}
{{ d.bus }}: {{ d.storage }}:{{ d.volume }},size={{ d.size }}
{% endfor %}

# Network devices
# Each network entry defines a virtual NIC.
# Schema: {model: str, mac: str, bridge: str, tag: int (optional)}
{% for n in (nets | default([])) %}
# Network {{ loop.index0 }}: model={{ n.model }}, mac={{ n.mac }}, bridge={{ n.bridge }}{% if n.tag %}, tag={{ n.tag }}{% endif %}
net{{ loop.index0 }}: {{ n.model }}={{ n.mac }},bridge={{ n.bridge }}{% if n.tag %},tag={{ n.tag }}{% endif %}
{% endfor %}

# Boot sequence specifying which device(s) to attempt booting from first
boot: order={{ boot_order | default('scsi0') }}

# Whether the VM should start automatically on host boot (1 = enabled, 0 = disabled)
onboot: {{ onboot | default(1) }}

# Whether the QEMU guest agent is enabled for enhanced VM management (1 = enabled, 0 = disabled)
agent: {{ agent | default(1) }}