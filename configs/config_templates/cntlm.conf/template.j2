# Cntlm authentication proxy configuration file
# Cntlm is an NTLM/Negotiate authenticating HTTP proxy
# Set up proxy server details
Username    {{ username }}
Domain      {{ domain }}
Password    {{ password }}
Proxy       {{ proxy_hosts | join(', ') }}

# Optional: Listen address and port for local proxy
Listen      {{ listen_addr }}:{{ listen_port }}

# Authentication method: use NTLMv2 by default (recommended)
Auth        NTLMv2

# Optional: Local proxy timeout settings
Timeout     {{ timeout }}

# Optional: DNS caching and connection settings
Tunnel      {{ tunnel_hosts | join(', ') }}

# Optional: Logging verbosity (0-5, 0 = silent, 5 = debug)
Verbose     {{ verbose }}

# Optional: Filter local addresses (e.g., exclude localhost from proxying)
NoProxy     {{ no_proxy | join(', ') }}

# Optional: Use system-wide certificate store (Linux)
# (requires cntlm >= 0.94.1 with OpenSSL support)
GssFallback {{ gss_fallback | lower }}

# Optional: Certificate file for SSL proxying (PEM format)
# CertFile    {{ cert_file }}

# Optional: TLS minimum version (1.0, 1.1, 1.2, 1.3)
# TLSMinVer   {{ tls_min_version }}
