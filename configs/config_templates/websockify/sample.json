{
  "bind_address": "0.0.0.0",
  "bind_port": 6080,
  "target_host": "localhost",
  "target_port": 5900,
  "ssl_target": true,
  "ssl_cert": "/etc/ssl/certs/websockify.crt",
  "ssl_key": "/etc/ssl/private/websockify.key",
  "ssl_ca": "",
  "log_level": "INFO",
  "log_file": "/var/log/websockify.log",
  "idle_timeout": 600,
  "tcp_keepalive": true,
  "allowed_origins": [
    "https://vnc.example.com",
    "https://console.example.com"
  ],
  "routes": [],
  "daemonize": true,
  "pidfile": "/run/websockify.pid",
  "user": "websockify",
  "group": "websockify",
  "compression": false,
  "ws_path": "/ws"
}
