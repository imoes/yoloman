{
  "rules": [
    {
      "comment": "# Allow root access at any time on any service and terminal",
      "service": "login",
      "tty": "*",
      "user": "root",
      "time": "Al0000-2400"
    },
    {
      "comment": null,
      "service": "sshd",
      "tty": "pts/*",
      "user": "developers",
      "time": "W10800-W51800"
    },
    {
      "comment": "# Deny regular users access on weekends (Sat/Sun)",
      "service": "login",
      "tty": "*",
      "user": "!users",
      "time": "W60000-W72400"
    },
    {
      "comment": "",
      "service": "cron",
      "tty": "*",
      "user": "backup",
      "time": "Al0200-0600"
    },
    {
      "service": "*",
      "tty": "tty1",
      "user": "alice",
      "time": "!W00800-W01800"
    }
  ]
}
