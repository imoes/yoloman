# /etc/security/time.conf — PAM time module configuration
# This file controls time-based access restrictions for services and users.
# Lines starting with ';' or '#' are comments.
# Format: <service>;<tty>;<user>;<time>
#   - service: PAM service name (e.g., login, sshd, cron)
#   - tty: terminal device (use '*' for any), may include wildcards
#   - user: username or group (prefix with '@' for groups), may include wildcards
#   - time: time specification in `WDayhhmm-WDayhhmm` format (see time(3) man page)
# Example: |login;*;*;!W0800-2000| denies access outside 8am–8pm on weekdays
{% for rule in rules %}{% if rule.comment %}{{ rule.comment }}
{% endif %}{{ rule.service }};{{ rule.tty }};{{ rule.user }};{{ rule.time }}
{% endfor %}