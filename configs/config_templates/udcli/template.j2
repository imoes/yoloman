# udcli configuration file
#
# This template configures `udcli`, a disassembly utility. It generates a simple key=value
# configuration file where every boolean option is emitted as 'True' or 'False' (Python-style)
# or numeric values as integers. All variables use their schema defaults to ensure idempotent
# and safe rendering even if the variable is undefined in the Ansible play.
#
# Disassembly bit mode: 16, 32, or 64.
mode = {{ mode | default('32') }}

# Instruction syntax format: intel or att.
syntax = {{ syntax | default('intel') }}

# CPU Vendor identification: intel or amd.
vendor = {{ vendor | default('intel') }}

# Initial Program Counter value.
pc = {{ pc | default(0) }}

# Number of bytes to skip before disassembly starts.
skip = {{ skip | default(0) }}

# Number of bytes to disassemble (0 for all).
count = {{ count | default(0) }}

# Enable hex input mode for whitespace separated hex numbers.
hex_input = {{ hex_input | default(False) | lower }}

# Suppress display of instruction offsets.
no_offset = {{ no_offset | default(False) | lower }}

# Suppress display of hexadecimal machine code.
no_hex = {{ no_hex | default(False) | lower }}

# Display EFLAGS register status.
show_eflags = {{ show_eflags | default(False) | lower }}

# Display operand access information.
show_access = {{ show_access | default(False) | lower }}

# Display implicit registers modified by instructions.
show_implicit = {{ show_implicit | default(False) | lower }}