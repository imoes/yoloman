{
  "source_type": {
    "type": "string",
    "default": "device",
    "description": "Source type: 'device', 'file', or 'tpg' (test pattern generator)",
    "enum": [
      "device",
      "file",
      "tpg"
    ]
  },
  "device_path": {
    "type": "string",
    "default": "0",
    "description": "Video device node index. If numeric, /dev/video<value> is used. Only valid if source_type is 'device'."
  },
  "file_path": {
    "type": "string",
    "default": "/dev/null",
    "description": "Path to the raw frame data file. Only valid if source_type is 'file'."
  },
  "port": {
    "type": "number",
    "default": 8362,
    "description": "Port to listen for network connections."
  },
  "count": {
    "type": "number",
    "default": 0,
    "description": "Stop after this many captured frames. 0 means no limit."
  },
  "buffers": {
    "type": "number",
    "default": 4,
    "description": "Number of buffers to request when streaming from a video device."
  },
  "single_step": {
    "type": "bool",
    "default": false,
    "description": "Pause after displaying each frame until Space is pressed."
  },
  "pixel_format": {
    "type": "string",
    "default": "",
    "description": "Pixel format to set/interpret. Leave empty to use default/auto."
  },
  "width": {
    "type": "number",
    "default": 0,
    "description": "Override frame width. 0 to use device default."
  },
  "height": {
    "type": "number",
    "default": 0,
    "description": "Override frame height. 0 to use device default."
  },
  "fps": {
    "type": "number",
    "default": 30,
    "description": "Frames per second."
  },
  "padding": {
    "type": "number",
    "default": 0,
    "description": "Additional horizontal padding (after width) in bytes."
  },
  "colorspace": {
    "type": "string",
    "default": "default",
    "description": "Override colorspace (e.g., smpte170m, rec709, jpeg, srgb).",
    "enum": [
      "smpte170m",
      "smpte240m",
      "rec709",
      "470m",
      "470bg",
      "jpeg",
      "srgb",
      "oprgb",
      "bt2020",
      "dcip3",
      "default"
    ]
  },
  "xfer_func": {
    "type": "string",
    "default": "default",
    "description": "Override transfer function (e.g., 709, srgb, smpte240m).",
    "enum": [
      "default",
      "709",
      "srgb",
      "oprgb",
      "smpte240m",
      "smpte2084",
      "dcip3",
      "none"
    ]
  },
  "ycbcr_enc": {
    "type": "string",
    "default": "default",
    "description": "Override Y'CbCr encoding (e.g., 601, 709, bt2020).",
    "enum": [
      "default",
      "601",
      "709",
      "xv601",
      "xv709",
      "bt2020",
      "bt2020c",
      "smpte240m"
    ]
  },
  "quant": {
    "type": "string",
    "default": "default",
    "description": "Override quantization (e.g., full-range, lim-range).",
    "enum": [
      "default",
      "full-range",
      "lim-range"
    ]
  },
  "field": {
    "type": "string",
    "default": "any",
    "description": "Override field setting for file playback (e.g., any, none, top, interlaced).",
    "enum": [
      "any",
      "none",
      "top",
      "bottom",
      "interlaced",
      "seq_tb",
      "seq_bt",
      "alternate",
      "interlaced_tb",
      "interlaced_bt"
    ]
  },
  "no_loop": {
    "type": "bool",
    "default": false,
    "description": "Stop at end of file instead of looping."
  },
  "from_frame": {
    "type": "number",
    "default": 0,
    "description": "Start playing back file from this frame number."
  },
  "tpg_pattern": {
    "type": "number",
    "default": 0,
    "description": "Test pattern index to use when TPG mode is enabled."
  },
  "tpg_square": {
    "type": "bool",
    "default": false,
    "description": "Show a square in the middle of the test pattern."
  },
  "tpg_border": {
    "type": "bool",
    "default": false,
    "description": "Show a border around the pillar/letterboxed video."
  },
  "tpg_sav": {
    "type": "bool",
    "default": false,
    "description": "Insert SAV code in every line."
  },
  "tpg_eav": {
    "type": "bool",
    "default": false,
    "description": "Insert EAV code in every line."
  },
  "tpg_pixel_aspect": {
    "type": "string",
    "default": "square",
    "description": "Pixel aspect ratio (square, ntsc, pal).",
    "enum": [
      "square",
      "ntsc",
      "pal"
    ]
  },
  "tpg_video_aspect": {
    "type": "string",
    "default": "4 x3",
    "description": "Video aspect ratio (4 x3, 14x9, 16x9, anamorphic).",
    "enum": [
      "4 x3",
      "14x9",
      "16x9",
      "anamorphic"
    ]
  },
  "tpg_alpha": {
    "type": "number",
    "default": 0,
    "description": "Alpha component value (0-255)."
  },
  "tpg_alpha_red_only": {
    "type": "bool",
    "default": false,
    "description": "Only use alpha value for red colors."
  },
  "tpg_rgb_lim_range": {
    "type": "bool",
    "default": false,
    "description": "Encode RGB values as limited [16-235] instead of full range."
  },
  "tpg_hor_speed": {
    "type": "number",
    "default": 0,
    "description": "Horizontal movement speed (-3 to 3)."
  },
  "tpg_vert_speed": {
    "type": "number",
    "default": 0,
    "description": "Vertical movement speed (-3 to 3)."
  },
  "tpg_perc_fill": {
    "type": "number",
    "default": 100,
    "description": "Percentage of frame to fill (0-100)."
  },
  "opengl": {
    "type": "bool",
    "default": false,
    "description": "Force OpenGL backend."
  },
  "opengles": {
    "type": "bool",
    "default": false,
    "description": "Force OpenGL ES backend."
  },
  "raw_mode": {
    "type": "bool",
    "default": false,
    "description": "Open device in raw mode."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Be more verbose."
  },
  "timings": {
    "type": "bool",
    "default": false,
    "description": "Report frame render timings."
  }
}
