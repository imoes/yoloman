# ============================================================================
# qvidcap configuration file
# ============================================================================
# This file is generated by Ansible. Do not edit manually.
# See the schema field descriptions for details on each parameter.

# ---------------------------------------------------------------------------
# Source Selection
# ---------------------------------------------------------------------------
# Source type: 'device', 'file', or 'tpg' (test pattern generator)
# Determines how qvidcap acquires video data.
# Only ONE source block should be active at a time.
{% if source_type | default('device') == 'device' %}
# Video device node index. If numeric, /dev/video<value> is used.
# Only valid if source_type is 'device'.
DEVICE={{ device_path | default('0') }}

{% elif source_type | default('device') == 'file' %}
# Path to the raw frame data file.
# Only valid if source_type is 'file'.
FILE={{ file_path | default('/dev/null') }}

{% elif source_type | default('device') == 'tpg' %}
# Enable Test Pattern Generator (TPG) mode.
# Generates synthetic video patterns instead of reading from device/file.
TPG=true

{% endif %}

# ---------------------------------------------------------------------------
# Network Settings
# ---------------------------------------------------------------------------
# Port to listen for network connections.
PORT={{ port | default(8362) }}

# ---------------------------------------------------------------------------
# Capture Settings
# ---------------------------------------------------------------------------
# Stop after this many captured frames.
# 0 means no limit (capture until interrupted).
COUNT={{ count | default(0) }}

# Number of buffers to request when streaming from a video device.
BUFFERS={{ buffers | default(4) }}

# Pause after displaying each frame until Space is pressed.
# Useful for debugging or manual inspection.
SINGLE_STEP={{ single_step | default(False) | lower }}

# ---------------------------------------------------------------------------
# Video Format Overrides
# ---------------------------------------------------------------------------
# Pixel format to set/interpret.
# Leave empty to use default/auto.
PIXEL_FORMAT={{ pixel_format | default('') }}

# Override frame width.
# 0 to use device default.
WIDTH={{ width | default(0) }}

# Override frame height.
# 0 to use device default.
HEIGHT={{ height | default(0) }}

# Frames per second.
FPS={{ fps | default(30) }}

# Additional horizontal padding (after width) in bytes.
# Useful for aligning to 4-byte or 16-byte boundaries.
PADDING={{ padding | default(0) }}

# ---------------------------------------------------------------------------
# Color Space and Encoding Overrides
# ---------------------------------------------------------------------------
# Override colorspace (e.g., smpte170m, rec709, jpeg, srgb).
COLORSPACE={{ colorspace | default('default') }}

# Override transfer function (e.g., 709, srgb, smpte240m).
XFER_FUNC={{ xfer_func | default('default') }}

# Override Y'CbCr encoding (e.g., 601, 709, bt2020).
YCBCR_ENC={{ ycbcr_enc | default('default') }}

# Override quantization (e.g., full-range, lim-range).
QUANT={{ quant | default('default') }}

# ---------------------------------------------------------------------------
# File Playback Specific
# ---------------------------------------------------------------------------
# Override field setting for file playback (e.g., any, none, top, interlaced).
FIELD={{ field | default('any') }}

# Stop at end of file instead of looping.
NO_LOOP={{ no_loop | default(False) | lower }}

# Start playing back file from this frame number.
FROM_FRAME={{ from_frame | default(0) }}

# ---------------------------------------------------------------------------
# Test Pattern Generator (TPG) Specific
# ---------------------------------------------------------------------------
# Test pattern index to use when TPG mode is enabled.
TPG_PATTERN={{ tpg_pattern | default(0) }}

# Show a square in the middle of the test pattern.
TPG_SQUARE={{ tpg_square | default(False) | lower }}

# Show a border around the pillar/letterboxed video.
TPG_BORDER={{ tpg_border | default(False) | lower }}

# Insert SAV (Start Active Video) code in every line.
TPG_SAV={{ tpg_sav | default(False) | lower }}

# Insert EAV (End Active Video) code in every line.
TPG_EAV={{ tpg_eav | default(False) | lower }}

# Pixel aspect ratio (square, ntsc, pal).
TPG_PIXEL_ASPECT={{ tpg_pixel_aspect | default('square') }}

# Video aspect ratio (4 x3, 14x9, 16x9, anamorphic).
TPG_VIDEO_ASPECT={{ tpg_video_aspect | default('4 x3') }}

# Alpha component value (0-255).
TPG_ALPHA={{ tpg_alpha | default(0) }}

# Only use alpha value for red colors.
TPG_ALPHA_RED_ONLY={{ tpg_alpha_red_only | default(False) | lower }}

# Encode RGB values as limited [16-235] instead of full range.
TPG_RGB_LIM_RANGE={{ tpg_rgb_lim_range | default(False) | lower }}

# Horizontal movement speed (-3 to 3).
TPG_HOR_SPEED={{ tpg_hor_speed | default(0) }}

# Vertical movement speed (-3 to 3).
TPG_VERT_SPEED={{ tpg_vert_speed | default(0) }}

# Percentage of frame to fill (0-100).
TPG_PERC_FILL={{ tpg_perc_fill | default(100) }}

# ---------------------------------------------------------------------------
# Display/Backend Settings
# ---------------------------------------------------------------------------
# Force OpenGL backend.
OPENGL={{ opengl | default(False) | lower }}

# Force OpenGL ES backend.
OPENGLES={{ opengles | default(False) | lower }}

# Open device in raw mode.
RAW_MODE={{ raw_mode | default(False) | lower }}

# ---------------------------------------------------------------------------
# Debug/Verbose
# ---------------------------------------------------------------------------
# Be more verbose (output debug information to stderr).
VERBOSE={{ verbose | default(False) | lower }}

# Report frame render timings.
TIMINGS={{ timings | default(False) | lower }}