# =============================================================================
# Coolmail Application Configuration Template
# =============================================================================
# This template generates the default configuration file for the 'coolmail'
# application. It is designed to be reused within an Ansible role.
# All configuration directives are documented with their schema descriptions
# and use safe defaults derived from the schema definitions.
# =============================================================================

! =============================================================================
! Section: General Settings
! =============================================================================

# Path to the sound file played when mail arrives.
!coolmail.soundFile: {{ coolmail_soundFile | default('/usr/local/lib/sounds/youvegotmail.au') }}

# Number of animation frames to display (if enabled).
!coolmail.frameCount: {{ coolmail_frameCount | default(15) }}

# Path to the user's mailbox file.
!coolmail.inbox: {{ coolmail_inbox | default('/var/spool/mail/username') }}

# Command to invoke for reading mail.
!coolmail.mailCommand: {{ coolmail_mailCommand | default('emacs -f rmail') }}

# Whether to run in monochrome mode.
# Note: The schema default is False (boolean). The template output
# preserves the native boolean representation as expected by the application.
coolmail.monochrome: {{ coolmail_monochrome | default(False) | lower }}

# Window geometry specification (width x height + xoffset + yoffset).
# Note: The '*' character is literal in the target config, not a Jinja operator.
coolmail*geometry: {{ coolmail_geometry | default('76x84-2+2') }}

# Volume level for the sound (0–100).
coolmail.volume: {{ coolmail_volume | default(70) }}