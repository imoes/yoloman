{
  "server_host": "0.0.0.0",
  "server_port": 8388,
  "local_host": "127.0.0.1",
  "local_port": 1080,
  "method": "chacha20-ietf-poly1305",
  "password": "my-secure-password-123",
  "timeout": 60,
  "dns_server": "1.1.1.1",
  "udp_enabled": true,
  "no_log": false,
  "fast_open": true,
  "acl": "/etc/shadowsocks-libev/acl.json",
  "mtu": 1400,
  "mptcp": false,
  "ipv6_first": false,
  "plugins": [
    {
      "plugin_exec": "/usr/bin/obfs-local",
      "plugin_opts": "obfs=http;obfs-host=cdn.example.com"
    }
  ],
  "workers": 2,
  "log_file": "/var/log/shadowsocks-libev.log"
}
