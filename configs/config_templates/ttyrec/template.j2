# ttyrec session recorder configuration
# This file is generated by Ansible. Do not edit manually.
# Format: directive: value
# See `ttyrec --help` for detailed option descriptions.

# Full path of the first ttyrec file to write to.
# If this is set, output_dir is generally ignored for the primary file,
# but may still be used for rotated files depending on implementation.
# -f, --output FILE
output_file: "{{ (values | default({})).output_file | default('/var/log/ttyrec/session.ttyrec') }}"

# Folder where to write the ttyrec files.
# Used if output_file is not specified or for SIGUSR1 rotated files.
# -d, --dir FOLDER
output_dir: "{{ (values | default({})).output_dir | default('/var/log/ttyrec') }}"

# UUID string that will appear in the ttyrec output file names,
# and kept with SIGUSR1 rotations.
# Use 'auto' for default PID-based behavior.
# -z, --uuid UUID
session_uuid: "{{ (values | default({})).session_uuid | default('auto') }}"

# Custom strftime-compatible format string to qualify the full path
# of the output files, including the SIGUSR1 rotated ones.
# -F, --name-format FMT
name_format: "{{ (values | default({})).name_format | default('%Y-%m-%d_%H:%M:%S') }}"

# Open the ttyrec output file in append mode instead of write-clobber mode.
# -a, --append
append_mode: {{ (values | default({})).append_mode | default(false) | lower }}

# Enable on-the-fly compression (zlib) if available.
# -Z
enable_compression: {{ (values | default({})).enable_compression | default(false) | lower }}

# Force on-the-fly compression of output file using zstd.
# --zstd
enable_zstd: {{ (values | default({})).enable_zstd | default(false) | lower }}

# Maximum number of seconds after which zstd will force flush its output buffers.
# Only relevant if enable_zstd is true.
# --max-flush-time S
zstd_max_flush_time: {{ (values | default({})).zstd_max_flush_time | default(15) }}

# Compression level, must be between 1 and 19 for zstd.
# Higher values mean better compression but more CPU usage.
# -l, --level LEVEL
compression_level: {{ (values | default({})).compression_level | default(3) }}

# Count the number of bytes out and print it on termination.
# -n, --count-bytes
count_bytes: {{ (values | default({})).count_bytes | default(false) | lower }}

# Lock session on input timeout after S seconds.
# 0 disables the lock timeout.
# -t, --lock-timeout S
lock_timeout: {{ (values | default({})).lock_timeout | default(0) }}

# Warn S seconds before locking.
# Only relevant if lock_timeout is set.
# --warn-before-lock S
warn_before_lock: {{ (values | default({})).warn_before_lock | default(0) }}

# Kill session on input timeout after S seconds.
# 0 disables the kill timeout.
# -k, --kill-timeout S
kill_timeout: {{ (values | default({})).kill_timeout | default(0) }}

# Warn S seconds before killing.
# Only relevant if kill_timeout is set.
# --warn-before-kill S
warn_before_kill: {{ (values | default({})).warn_before_kill | default(0) }}

# Disable cheat-codes.
# Cheat-codes are terminal escape sequences that can affect recording.
# -C, --no-cheatcodes
no_cheatcodes: {{ (values | default({})).no_cheatcodes | default(true) | lower }}

# Don't use openpty() even when it's available.
# Disables pseudo-terminal allocation.
# -p, --no-openpty
no_openpty: {{ (values | default({})).no_openpty | default(false) | lower }}

# Terminal allocation mode: 'never', 'always', or 'auto'.
# Determines how ttyrec interacts with the terminal device.
# -T, --term MODE
term_mode: "{{ (values | default({})).term_mode | default('auto') }}"

# Verbose (debug) mode.
# -v, --verbose
verbose: {{ (values | default({})).verbose | default(false) | lower }}

# Command to be executed by ttyrec.
# Note: ttyrec syntax is 'ttyrec [options] -- <command>'.
# In a config file, this field typically dictates what ttyrec runs.
command: "{{ (values | default({})).command | default('/bin/bash') }}"