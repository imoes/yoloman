{
  "output_file": "/var/log/ttyrec/user_session.ttyrec",
  "output_dir": "/var/log/ttyrec",
  "session_uuid": "my-session-001",
  "name_format": "%Y%m%d",
  "append_mode": false,
  "enable_compression": false,
  "enable_zstd": true,
  "zstd_max_flush_time": 30,
  "compression_level": 9,
  "count_bytes": false,
  "lock_timeout": 60,
  "warn_before_lock": 10,
  "kill_timeout": 300,
  "warn_before_kill": 60,
  "no_cheatcodes": true,
  "no_openpty": false,
  "term_mode": "auto",
  "verbose": false,
  "command": "/bin/bash"
}
