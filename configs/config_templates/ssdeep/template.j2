# ==============================================================================
# ssdeep configuration template
# ==============================================================================
# This template configures the default behavior for the ssdeep fuzzy hashing tool.
# It supports thresholds, known hash files, output formatting, and input selection.
# ==============================================================================

# Minimum match score threshold for -t. Only matches scoring above this value are displayed.
# Valid range: 0-100. Default 0 means all matches are shown.
threshold={{ threshold | default(0) }}

# List of files containing known signatures to match against (-m flag).
# Each entry is a file path. These files must exist and contain valid ssdeep hashes.
{% if (known_hash_files | default([]) | length) > 0 %}
known_hash_files:
{% for file in known_hash_files | default([]) %}- {{ file | string }}
{% endfor %}
{% endif %}

# Enable verbose mode (-v) to print filename to stderr as it is being hashed.
# Useful for debugging or tracking progress on large batches.
verbose={{ verbose | default(false) }}

# Enable recursive mode (-r) to traverse all subdirectories.
# When enabled, ssdeep will descend into directories found in input_files.
recursive={{ recursive | default(false) }}

# Enable silent mode (-s) to suppress all error messages.
# Useful for cron jobs or automated scripts where error output is handled separately.
silent={{ silent | default(false) }}

# Enable bare mode (-b) to strip leading directory information from displayed filenames.
# Only the base filename is shown in the output instead of the full path.
bare={{ bare | default(false) }}

# Enable relative paths (-l) to display relative file paths instead of absolute.
# The paths are relative to the current working directory at execution time.
relative_paths={{ relative_paths | default(false) }}

# Enable comma-separated output (-c) for matching modes.
# Displays input file, known file, and matching score in CSV format.
csv_output={{ csv_output | default(false) }}

# Display all matches regardless of score (-a).
# Normally ssdeep might filter results; this ensures every potential match is reported.
all_matches={{ all_matches | default(false) }}

# Group similar files into clusters (-g).
# Organizes output by similarity clusters rather than individual file comparisons.
group_similar={{ group_similar | default(false) }}

# List of files or directories that ssdeep will analyze.
{% if (input_files | default([]) | length) > 0 %}
input_files:
{% for file in input_files | default([]) %}- {{ file | string }}
{% endfor %}
{% endif %}