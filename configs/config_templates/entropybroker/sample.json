{
  "listen_address": "0.0.0.0",
  "listen_port": 4433,
  "workers": 4,
  "max_queue_size": 10000,
  "entropy_source": "rdseed",
  "chunk_size": 256,
  "tls_enabled": true,
  "tls_cert_path": "/etc/entropybroker/tls/entropybroker.crt",
  "tls_key_path": "/etc/entropybroker/tls/entropybroker.key",
  "log_level": "info",
  "pid_file": "/run/entropybroker/entropybroker.pid",
  "metrics_enabled": true,
  "metrics_listen_address": "127.0.0.1",
  "metrics_listen_port": 9102,
  "upstream_sources": [
    {
      "name": "primary",
      "host": "entropy.example.com",
      "port": 4433,
      "weight": 100
    },
    {
      "name": "backup",
      "host": "entropy-backup.example.com",
      "port": 4433,
      "weight": 50
    }
  ],
  "allowed_networks": [
    {
      "description": "Kubernetes pods",
      "cidr": "10.96.0.0/12"
    },
    {
      "description": "Production servers",
      "cidr": "10.10.0.0/16"
    }
  ],
  "rate_limiting_enabled": true,
  "rate_limit_max_rps": 30,
  "rate_limit_burst_size": 60
}
