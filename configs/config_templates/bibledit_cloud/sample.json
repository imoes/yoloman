{
  "bind_address": "127.0.0.1",
  "port": 8080,
  "base_url_path": "",
  "data_directory": "/var/lib/bibledit-cloud/data",
  "temp_directory": "/var/tmp/bibledit-cloud",
  "max_connections_per_session": 10,
  "ssl_enabled": false,
  "ssl_certificate_file": "/etc/ssl/certs/bibledit-cloud.crt",
  "ssl_key_file": "/etc/ssl/private/bibledit-cloud.key",
  "log_level": "info",
  "log_file": "/var/log/bibledit-cloud/bibledit-cloud.log",
  "enable_modules": false,
  "modules": [],
  "auth_backend": "sqlite",
  "auth_database": "/var/lib/bibledit-cloud/auth.db",
  "session_timeout": 3600,
  "cors_allowed_origins": [
    "https://bible.myorg.org"
  ],
  "branding_title": "My Church Bible Editor",
  "backup_enabled": true,
  "backup_interval_hours": 24,
  "backup_retention_days": 30,
  "backup_directory": "/var/backups/bibledit-cloud",
  "database_backend": "sqlite",
  "database_file": "/var/lib/bibledit-cloud/database.db",
  "debug_mode": false,
  "smtp_enabled": true,
  "smtp_server": "smtp.mail.myorg.org",
  "smtp_port": 587,
  "smtp_use_tls": true,
  "smtp_username": "bibledit",
  "smtp_from_address": "bibledit-notifications@myorg.org"
}
