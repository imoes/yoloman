# =============================================================================
# Bible Editor Cloud Configuration
# =============================================================================
# This file is generated by Ansible. Do NOT edit manually.
# Every directive is commented with its schema description for self-documentation.
# =============================================================================

# --- Network Binding ---

# IP address the server binds to. Use 0.0.0.0 to allow connections from any network interface.
bind_address: {{ bind_address | default('127.0.0.1') }}

# TCP port for incoming HTTP(S) connections.
port: {{ port | default(8080) }}

# Optional URL prefix (e.g., /bibledit) when deployed behind a reverse proxy.
base_url_path: {{ base_url_path | default('') }}

# --- Data Storage ---

# Absolute path to the directory where user projects, Bibles, and other persistent data are stored.
data_directory: {{ data_directory | default('/var/lib/bibledit-cloud/data') }}

# Absolute path to a temporary directory for transient files (e.g., uploads, conversions).
temp_directory: {{ temp_directory | default('/var/tmp/bibledit-cloud') }}

# --- Connection Limits ---

# Maximum number of concurrent HTTP connections allowed per user session.
max_connections_per_session: {{ max_connections_per_session | default(10) }}

# --- SSL/TLS Configuration ---

# Whether to serve the application over HTTPS.
ssl_enabled: {{ ssl_enabled | default(False) }}

# Path to the SSL certificate file (used only if ssl_enabled is true).
ssl_certificate_file: {{ ssl_certificate_file | default('/etc/ssl/certs/bibledit-cloud.crt') }}

# Path to the SSL private key file (used only if ssl_enabled is true).
ssl_key_file: {{ ssl_key_file | default('/etc/ssl/private/bibledit-cloud.key') }}

# --- Logging ---

# Verbosity of logging. One of: debug, info, warning, error, critical.
log_level: {{ log_level | default('info') }}

# Absolute path to the main log file.
log_file: {{ log_file | default('/var/log/bibledit-cloud/bibledit-cloud.log') }}

# --- Modules ---

# Enable loading of external modules (e.g., plugins for translation tools or language support).
enable_modules: {{ enable_modules | default(False) }}

# List of external module paths to load (only active if enable_modules is true).
# Each item defines a module location.
{% if enable_modules | default(False) %}
  {% for module_path in modules | default([]) %}
  module: {{ module_path }}
  {% endfor %}
{% endif %}

# --- Authentication ---

# Authentication backend to use. Currently only 'sqlite' is supported.
auth_backend: {{ auth_backend | default('sqlite') }}

# Path to the SQLite database file storing users, passwords, and permissions (used only if auth_backend is 'sqlite').
{% if auth_backend | default('sqlite') == 'sqlite' %}
auth_database: {{ auth_database | default('/var/lib/bibledit-cloud/auth.db') }}
{% endif %}

# Session inactivity timeout in seconds (after which the user must re-authenticate).
session_timeout: {{ session_timeout | default(3600) }}

# --- CORS (Cross-Origin Resource Sharing) ---

# List of allowed origins for CORS (cross-origin requests). Avoid using '*' in production.
{% for origin in cors_allowed_origins | default(['http://localhost:3000']) %}
cors_origin: {{ origin }}
{% endfor %}

# --- Branding ---

# Custom title displayed in the web UI (e.g., 'My Organization’s Bible Editor').
branding_title: {{ branding_title | default('Bible Editor Cloud') }}

# --- Backup Settings ---

# Whether to automatically back up the data directory and database.
backup_enabled: {{ backup_enabled | default(True) }}

# Number of hours between automatic backups.
backup_interval_hours: {{ backup_interval_hours | default(24) }}

# Number of days to retain each backup before deletion.
backup_retention_days: {{ backup_retention_days | default(30) }}

# Absolute path to the directory where backups are stored.
backup_directory: {{ backup_directory | default('/var/backups/bibledit-cloud') }}

# --- Database Backend ---

# Database backend (currently only SQLite is supported).
database_backend: {{ database_backend | default('sqlite') }}

# Path to the main SQLite database file storing Bibles, projects, and documents.
database_file: {{ database_file | default('/var/lib/bibledit-cloud/database.db') }}

# --- Debug Mode ---

# Enable verbose debugging (logs extra details, disables caching). Only for development or troubleshooting.
debug_mode: {{ debug_mode | default(False) }}

# --- SMTP (Email Notifications) ---

# SMTP server hostname (e.g., smtp.example.com). Required if smtp_enabled is true.
smtp_server: {{ smtp_server | default('') }}

# SMTP server port (typically 587 for TLS or 465 for SSL).
smtp_port: {{ smtp_port | default(587) }}

# Whether to enable SMTP-based email sending (e.g., for password resets).
smtp_enabled: {{ smtp_enabled | default(False) }}

# Whether to use TLS encryption for SMTP connections.
smtp_use_tls: {{ smtp_use_tls | default(True) }}

# SMTP authentication username (if required by the server).
smtp_username: {{ smtp_username | default('') }}

# Email address used as the sender for outgoing emails (e.g., password reset links).
smtp_from_address: {{ smtp_from_address | default('noreply@example.com') }}