;;; 51mu-cite.el --- Debian mu-cite startup file -*-mode: emacs-lisp;-*-

;;; The default Emacs flavor to use for loading mu-cite.
;;; Defaults to 'emacs' (GNU Emacs) unless overridden by the system-wide
;;; `debian-emacs-flavor` variable.
(let* ((pkg "mu-cite")
       (flavor-name (if (boundp 'debian-emacs-flavor)
                        (symbol-name debian-emacs-flavor)
                      "{{ emacs_flavor_default | default('emacs') }}"))
       (pkg-inst (concat "/usr/lib/emacsen-common/packages/install/" pkg))
       (elc-dir (concat "/usr/share/" flavor-name "/site-lisp/" pkg)))
  ;; Ensure the package directory and installer script exist before proceeding.
  (when (and (file-exists-p elc-dir)
             (file-exists-p pkg-inst))
    ;; Add the package to the load path using the Debian-specific hook if available,
    ;; otherwise append it directly to load-path.
    (if (fboundp 'debian-pkg-add-load-path-item)
        (debian-pkg-add-load-path-item elc-dir)
      (setq load-path (cons elc-dir load-path)))
    ;;
    ;; Register autoloads for mu-cite and related LaTeX math support.
    (autoload 'mu-cite-original "mu-cite" nil t)
    (autoload 'latex-math-decode-buffer "latex-math-symbol" nil t)
    ;;
    ))

;;; 51mu-cite.el ends here
