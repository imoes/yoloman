{
  "periodic_e2scrub": {
    "type": "bool",
    "default": false,
    "description": "Enable automatic periodic runs of e2scrub_all"
  },
  "recipient": {
    "type": "string",
    "default": "root",
    "description": "Email destination for e2scrub_fail notifications"
  },
  "sender": {
    "type": "string",
    "default": "e2scrub@host.domain.name",
    "description": "Email sender for e2scrub_fail notifications"
  },
  "snap_size_mb": {
    "type": "number",
    "default": 256,
    "description": "Size (in MB) of snapshots created to run fsck"
  },
  "fstrim": {
    "type": "bool",
    "default": false,
    "description": "Enable fstrim for all mounts"
  },
  "e2fsck_opts": {
    "type": "string",
    "default": "-vtt",
    "description": "Arguments passed into e2fsck"
  },
  "scrub_all": {
    "type": "bool",
    "default": false,
    "description": "Scrub all logical volumes, not just mounted ones"
  }
}
