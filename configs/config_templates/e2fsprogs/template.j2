# /etc/mke2fs.conf
# Configuration file for mke2fs and related e2fsprogs tools.
# This template is self-documenting: every setting includes its schema description.

[defaults]
	# Enable automatic periodic runs of e2scrub_all (0=disabled, 1=enabled)
	enable_periodic_fsck = {{ enable_periodic_fsck | default('0') }}

	# Default blocksize for new filesystems (typically 1024, 2048, or 4096)
	blocksize = {{ blocksize | default('4096') }}

	# Default inode size for new filesystems (128, 256, 512, or 1024)
	inode_size = {{ inode_size | default('256') }}

	# Default inode ratio (bytes per inode; lower ratio = more inodes)
	inode_ratio = {{ inode_ratio | default('16384') }}

[fs_types]
	# ext3 filesystem type definition
	ext3 = {
		features = has_journal
	}

	# ext4 filesystem type definition
	ext4 = {
		features = has_journal,extent,huge_file,flex_bg,metadata_csum,metadata_csum_seed,64bit,dir_nlink,extra_isize,orphan_file
	}

	# 'small' filesystem type: optimized for small drives
	small = {
		# Blocksize for 'small' fs type
		blocksize = {{ small_blocksize | default(1024) }}

		# Inode ratio for 'small' fs type
		inode_ratio = {{ small_inode_ratio | default(4096) }}
	}

	# 'floppy' filesystem type: optimized for floppy disks
	floppy = {
		# Blocksize for 'floppy' fs type
		blocksize = {{ floppy_blocksize | default(1024) }}

		# Inode ratio for 'floppy' fs type
		inode_ratio = {{ floppy_inode_ratio | default(8192) }}
	}

	# 'big' filesystem type: optimized for large filesystems with fewer inodes
	big = {
		# Inode ratio for 'big' fs type
		inode_ratio = {{ big_inode_ratio | default(32768) }}
	}

	# 'huge' filesystem type: optimized for very large filesystems with minimal inodes
	huge = {
		# Inode ratio for 'huge' fs type
		inode_ratio = {{ huge_inode_ratio | default(65536) }}
	}

	# 'news' filesystem type: optimized for news spools
	news = {
		# Inode ratio for 'news' fs type
		inode_ratio = {{ news_inode_ratio | default(4096) }}
	}

	# 'largefile' filesystem type: optimized for files larger than 4GB
	largefile = {
		# Inode ratio for 'largefile' fs type
		inode_ratio = {{ largefile_inode_ratio | default(1048576) }}

		# Blocksize for 'largefile' fs type (-1 means automatic)
		blocksize = {{ largefile_blocksize | default(-1) }}
	}

	# 'largefile4' filesystem type: optimized for files larger than 4GB with smaller blocksize
	largefile4 = {
		# Inode ratio for 'largefile4' fs type
		inode_ratio = {{ largefile4_inode_ratio | default(4194304) }}

		# Blocksize for 'largefile4' fs type (-1 means automatic)
		blocksize = {{ largefile4_blocksize | default(-1) }}
	}

	# 'hurd' filesystem type: optimized for GNU Hurd
	hurd = {
		# Blocksize for 'hurd' fs type
		blocksize = {{ hurd_blocksize | default('4096') }}

		# Inode size for 'hurd' fs type
		inode_size = {{ hurd_inode_size | default('128') }}

		# Warn about Y2038 dates for 'hurd' fs type (0=disabled, 1=enabled)
		warn_y2038_dates = {{ hurd_warn_y2038_dates | default('0') }}
	}
