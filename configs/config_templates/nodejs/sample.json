{
  "node_icu_data": "/usr/share/nodejs/icu",
  "node_path": "/usr/local/lib/node_modules:/opt/myapp/node_modules",
  "node_options": "--max-old-space-size=512 --unhandled-rejections=strict",
  "uv_threadpool_size": 8,
  "force_color": "2",
  "node_extra_ca_certs": "/etc/ssl/certs/internal-ca.pem",
  "node_tls_reject_unauthorized": "",
  "tz": "America/Los_Angeles"
}
