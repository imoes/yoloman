{
  "email": "admin@example.com",
  "target": "https://acme-v02.api.letsencrypt.org/directory",
  "renew_threshold": 2592000,
  "timeout": 90,
  "dns_retry_limit": 8,
  "use_http_challenge": true,
  "use_dns_challenge": false,
  "use_tls_alpn_challenge": false,
  "private_key_type": "rsa",
  "private_key_size": 4096,
  "dns_provider": null,
  "certs": [
    {
      "name": "main-site",
      "domains": [
        "example.com",
        "www.example.com"
      ]
    },
    {
      "name": "api",
      "domains": [
        "api.example.com",
        "admin.example.com"
      ]
    },
    {
      "name": "wildcard",
      "domains": [
        "*.staging.example.com"
      ]
    }
  ]
}
