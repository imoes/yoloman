# Path to the security support check hook script.
# This script is executed by apt after a transaction to check for packages
# that are no longer supported by Debian security updates.
# See: man apt-hooks(5) and /usr/share/debian-security-support/
post-invoke="if [ -x {{ hook_path | default('/usr/share/debian-security-support/check-support-status.hook') }} ] ; then {{ hook_path | default('/usr/share/debian-security-support/check-support-status.hook') }} || /bin/true ; fi"
