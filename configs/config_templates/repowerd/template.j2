# Configuration for repowerd log forwarding to rsyslog.
# Directives matching the program name and writing to a specific log file.

# Match log messages originating from the 'repowerd' daemon.
:programname,isequal,"repowerd" {{ log_file_name | default('/var/log/repowerd.log') }};RSYSLOG_FileFormat

# Stop processing these messages further down the rsyslog pipeline to avoid duplicate logging.
& stop
