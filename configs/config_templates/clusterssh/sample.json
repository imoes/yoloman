{
  "clusters": [
    {
      "name": "web-prod",
      "description": "Production web front-ends",
      "hosts": [
        "web01.example.com",
        "web02.example.com",
        "web03.example.com"
      ]
    },
    {
      "name": "db-prod",
      "description": "Production database servers",
      "hosts": [
        "db01.example.com",
        "db02.example.com"
      ]
    },
    {
      "name": "web-staging",
      "description": "Staging web tier \u2014 mirrors prod topology",
      "hosts": [
        "web-stg01.example.com",
        "web-stg02.example.com"
      ]
    },
    {
      "name": "all-prod",
      "description": "All production nodes \u2014 inherits web-prod and db-prod",
      "hosts": [
        "web-prod",
        "db-prod"
      ]
    },
    {
      "name": "all",
      "description": "Every managed host across all environments",
      "hosts": [
        "all-prod",
        "web-staging"
      ]
    }
  ]
}
