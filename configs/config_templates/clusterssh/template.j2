# /etc/clusterssh/clusters
# Configuration file for ClusterSSH (cssh).
# Each non-comment line defines a named cluster. The first token is the cluster name,
# and the remaining tokens are the hostnames, FQDNs, or IP addresses belonging to that cluster.
# Hosts can also reference other cluster names for inheritance (though this template
# focuses on explicit host lists as per the schema).

# List of named host groups. Each entry becomes one line in this file.
{% for cluster in (clusters | default([])) %}
# Cluster: {{ cluster.name | default('unnamed') }}
# Hosts: {{ cluster.hosts | default([]) | join(' ') }}
{{ cluster.name | default('unnamed') }} {{ cluster.hosts | default([]) | join(' ') }}
{% endfor %}