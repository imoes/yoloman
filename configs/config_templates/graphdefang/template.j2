        'grouping_times'=> {{ graphs_1_grouping_times | default(["hourly","daily","monthly"]) | tojson }},
	#'filter'	=> '{{ graphs_1_filter | default("^(?:(?!klez).)*$") }}',
	#'filter_name'   => '{{ graphs_1_filter_name | default("Not Klez") }}',
        );
push @GRAPHS, { %GraphSettings };

