# ==============================================================================
# Partimage Server SSL Certificate Generation Configuration
# ==============================================================================
# This file is used by the `partimaged` service to generate a self-signed SSL
# certificate for client-server communication. The certificate ensures that
# disk imaging clients can verify the server's identity before transferring data.
#
# Variables are sourced from the Ansible inventory/role defaults.
# ==============================================================================

# Path to the RANDFILE for SSL key generation.
# This file stores random state to improve the entropy of the generated key.
RANDFILE = {{ randfile | default('/etc/partimaged/partimaged.rand') }}

[ req ]
# Configuration section for `openssl req` command.

# Number of bits in the generated SSL key.
# 4096 bits is recommended for strong security; 2048 is the minimum acceptable.
default_bits = {{ default_bits | default('4096') }}

# Whether to encrypt the generated SSL private key.
# If 'yes', the key will be encrypted with a passphrase (not used here as
# partimaged typically expects the key for automated startup, but this
# flag controls the request format).
encrypt_key = {{ encrypt_key | default('yes') }}

# Reference to the distinguished name section below.
distinguished_name = req_dn

# Reference to the certificate extensions section.
x509_extensions = cert_type

# Disable prompt for input; all values are taken from the configuration file.
prompt = no

[ req_dn ]
# Distinguished Name (DN) fields for the SSL Certificate.
# These fields identify the server in the certificate subject.

# Country Code (C) for the SSL certificate.
# ISO 3166-1 alpha-2 two-letter code.
C={{ country | default('US') }}

# State or Province (ST) for the SSL certificate.
# The full name of the state or province.
ST={{ state | default('NY') }}

# Locality or City (L) for the SSL certificate.
# The city or locality where the organization is located.
L={{ locality | default('New York') }}

# Organization Name (O) for the SSL certificate.
# The legal name of the organization or server owner.
O={{ organization | default('Partimage Server') }}

# Organizational Unit (OU) for the SSL certificate.
# The unit or department responsible for the server.
OU={{ organizational_unit | default('Automatically-generated Partimage SSL key') }}

# Common Name (CN) for the SSL certificate.
# Typically the Fully Qualified Domain Name (FQDN) or IP address of the server.
# Clients verify this CN against the hostname they use to connect.
CN={{ common_name | default('localhost') }}

# Email Address (emailAddress) for the SSL certificate.
# Administrative contact email for the certificate/organization.
emailAddress={{ email_address | default('postmaster@example.com') }}

[ cert_type ]
# X.509 Certificate Extension definitions.

# Specifies the type of certificate.
# 'server' indicates this certificate is intended for server authentication
# (TLS/SSL server side), which is required for partimaged.
nsCertType = server
