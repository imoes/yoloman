{
  "mode": {
    "type": "string",
    "default": "passive",
    "description": "Operational mode: 'passive' (listen) or 'active' (connect)",
    "enum": [
      "passive",
      "active"
    ]
  },
  "passive_port": {
    "type": "number",
    "default": 9000,
    "description": "Port number for the passive side's data socket"
  },
  "active_destination": {
    "type": "string",
    "default": "",
    "description": "Destination endpoint to connect to in active mode (Address:Port)"
  },
  "control_over_tcp": {
    "type": "bool",
    "default": false,
    "description": "Use TCP instead of SCTP for the control connection"
  },
  "local_data_addresses": {
    "type": "list",
    "default": [],
    "description": "List of local data endpoint addresses"
  },
  "local_control_addresses": {
    "type": "list",
    "default": [],
    "description": "List of local control endpoint addresses"
  },
  "runtime": {
    "type": "number",
    "default": 300,
    "description": "Measurement runtime in seconds"
  },
  "vector_file": {
    "type": "string",
    "default": "vector.vec.bz2",
    "description": "Name pattern for vector files"
  },
  "scalar_file": {
    "type": "string",
    "default": "scalar.vec.bz2",
    "description": "Name pattern for scalar files"
  },
  "active_node_name": {
    "type": "string",
    "default": "Client",
    "description": "Textual description of the active node"
  },
  "passive_node_name": {
    "type": "string",
    "default": "Server",
    "description": "Textual description of the passive node"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Increase verbosity of log output"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Reduce verbosity of log output"
  },
  "verbosity": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level from 0 (lowest) to 6 (highest)"
  },
  "ipv6_only": {
    "type": "bool",
    "default": false,
    "description": "Use sockets with IPv6 only"
  },
  "path_manager": {
    "type": "string",
    "default": "",
    "description": "MPTCP path manager name"
  },
  "scheduler": {
    "type": "string",
    "default": "",
    "description": "MPTCP scheduler name"
  },
  "sndbuf": {
    "type": "number",
    "default": 0,
    "description": "Sender buffer size in bytes on the listening socket"
  },
  "rcvbuf": {
    "type": "number",
    "default": 0,
    "description": "Receiver buffer size in bytes on the listening socket"
  },
  "use_sctp": {
    "type": "bool",
    "default": false,
    "description": "Establish a new SCTP association"
  },
  "use_tcp": {
    "type": "bool",
    "default": true,
    "description": "Establish a new TCP or MPTCP connection"
  },
  "use_udp": {
    "type": "bool",
    "default": false,
    "description": "Establish a new UDP connection"
  },
  "use_dccp": {
    "type": "bool",
    "default": false,
    "description": "Establish a new DCCP connection"
  },
  "flows": {
    "type": "list",
    "default": [],
    "description": "List of flow specifications"
  },
  "flows.items": {
    "type": "object",
    "default": null,
    "description": "Individual flow specification items"
  },
  "flows.items.outgoing_frame_rate": {
    "type": "string",
    "default": "const0",
    "description": "The frame rate of the outgoing transfer"
  },
  "flows.items.outgoing_frame_size": {
    "type": "string",
    "default": "const0",
    "description": "The frame size of the outgoing transfer"
  },
  "flows.items.incoming_frame_rate": {
    "type": "string",
    "default": "const0",
    "description": "The frame rate of the incoming transfer"
  },
  "flows.items.incoming_frame_size": {
    "type": "string",
    "default": "const0",
    "description": "The frame size of the incoming transfer"
  },
  "flows.items.options": {
    "type": "list",
    "default": [],
    "description": "List of flow options as key-value pairs"
  },
  "flows.items.options.items": {
    "type": "object",
    "default": null,
    "description": "Individual flow option item"
  },
  "flows.items.options.items.key": {
    "type": "string",
    "default": "",
    "description": "Option key name"
  },
  "flows.items.options.items.value": {
    "type": "string",
    "default": "",
    "description": "Option value"
  }
}
