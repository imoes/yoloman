{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 22
    },
    {
      "address": "::",
      "port": 2222
    }
  ],
  "rsa_key_path": "/etc/dropbear/dropbear_rsa_host_key",
  "dss_key_path": "/etc/dropbear/dropbear_dss_host_key",
  "ecdsa_key_path": "/etc/dropbear/dropbear_ecdsa_host_key",
  "disable_password_auth": true,
  "allow_root_login": false,
  "idle_timeout": 300,
  "max_auth_tries": 3,
  "log_level": 1,
  "banner_path": "/etc/issue.net",
  "enable_legacy_ciphers": false,
  "ciphers_list": [],
  "enable_legacy_kex": false,
  "kex_list": [],
  "enable_legacy_macs": false,
  "macs_list": [],
  "allow_tcp_forwarding": false,
  "allow_x11_forwarding": false,
  "allow_agent_forwarding": false,
  "forced_command": "",
  "keepalive_interval": 60
}
