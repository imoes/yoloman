# ==============================================================================
# mbw (Memory BandWidth) Benchmark Configuration Template
# ==============================================================================
# This template generates a command-line invocation for the `mbw` utility,
# which measures memory bandwidth by performing memcpy, dumb copy, and
# block-size-specific memcpy operations.
#
# Generated by Ansible. Do not edit manually.
# ==============================================================================

# --- Quiet Mode ---
# If true, suppresses informational messages (-q).
{% if quiet | default(False) | bool %}
-q
{% endif %}

# --- Suppress Average ---
# If true, suppresses printing the average of each test (-a).
{% if suppress_average | default(False) | bool %}
-a
{% endif %}

# --- Loops ---
# Number of loops per test (-n).
-n {{ loops | default(100) }}

# --- Tests ---
# Tests to be run. Use 'all' for all tests, or a list of integers:
#   0 = memcpy
#   1 = dumb copy
#   2 = memcpy with arbitrary block size
# (-t flag is repeated for each test type)
{% set tests_val = tests | default('all') %}
{% if tests_val == 'all' %}
-t0 -t1 -t2
{% elif tests_val is iterable and (tests_val is not string) %}
{% for t in tests_val %}
-t{{ t }}
{% endfor %}
{% else %}
# Warning: tests value is neither 'all' nor a valid list of integers.
# Defaulting to all tests.
-t0 -t1 -t2
{% endif %}

# --- Block Size ---
# Block size in bytes for test type 2 (-t2).
# Only relevant if test type 2 is selected.
{% if block_size | default(None) is not none %}
-b {{ block_size | default(0) }}
{% endif %}

# --- Array Size ---
# Array size in MiB for the benchmark (positional argument).
# This is the primary memory allocation size for the benchmark.
{{ array_size_mib | default(64) }}