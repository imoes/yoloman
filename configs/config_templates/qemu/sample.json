{
  "enable_userns": true,
  "user": "qemu",
  "group": "qemu",
  "network_bridge": true,
  "network_script": "/etc/qemu/qemu-bridge-helper.sh",
  "network_interface": "br0",
  "storage_pools": [
    {
      "name": "default",
      "path": "/var/lib/libvirt/images"
    },
    {
      "name": "ssd-cache",
      "path": "/ssd/vms"
    }
  ],
  "seccomp_sandbox": true,
  "apparmor_profile": "qemu-default",
  "vcpu_limit": 128,
  "memory_limit_mb": 524288,
  "max_devices": 512,
  "log_level": "INFO",
  "log_outputs": "file:/var/log/qemu/qemu.log,stderr",
  "audio_driver": "pa",
  "tls_enabled": true,
  "tls_port": 61000,
  "tls_cert_dir": "/etc/pki/qemu",
  "usb_redir_enabled": false,
  "usb_redir_port": 8000,
  "usb_redir_filter": "",
  "console_mode": "text",
  "console_log_path": "/var/log/qemu/console",
  "migration": {
    "host": "0.0.0.0",
    "port_min": 49152,
    "port_max": 49664
  },
  "watchdog_action": "reset",
  "default_machine_type": "q35",
  "device_hotplug": true,
  "numa_enabled": true,
  "numa_mode": "strict",
  "numa_mem_mode": "interleave"
}
