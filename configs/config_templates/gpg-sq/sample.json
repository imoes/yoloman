{
  "gpg_home": "/home/user/.gnupg",
  "crypto_policy_file": "/etc/crypto-policies/back-ends/sequoia.config",
  "options": [
    {
      "name": "keyserver",
      "type": "value",
      "value": "hkps://keys.openpgp.org"
    },
    {
      "name": "keyserver-options",
      "type": "value",
      "value": "timeout=10\ninclude-revoked"
    },
    {
      "name": "personal-digest-preferences",
      "type": "value",
      "value": "SHA512 SHA384 SHA256"
    },
    {
      "name": "cert-digest-algo",
      "type": "value",
      "value": "SHA512"
    },
    {
      "name": "personal-cipher-preferences",
      "type": "value",
      "value": "AES256 AES192 AES"
    },
    {
      "name": "s2k-cipher-algo",
      "type": "value",
      "value": "AES256"
    },
    {
      "name": "s2k-digest-algo",
      "type": "value",
      "value": "SHA512"
    },
    {
      "name": "s2k-mode",
      "type": "value",
      "value": "3"
    },
    {
      "name": "s2k-count",
      "type": "value",
      "value": "65011712"
    },
    {
      "name": "throw-keyids",
      "type": "flag"
    },
    {
      "name": "no-emit-version",
      "type": "flag"
    },
    {
      "name": "no-comments",
      "type": "flag"
    },
    {
      "name": "armor",
      "type": "flag"
    },
    {
      "name": "trust-model",
      "type": "value",
      "value": "pgp"
    }
  ],
  "default_key": "0xABCDEF1234567890",
  "encrypt_to": [
    "0x1234567890ABCDEF"
  ],
  "group_spec": "devs:dev@example.org,tester:test@example.org",
  "auto_key_locate": "node,ldap,wkd",
  "compression_level": 6
}
