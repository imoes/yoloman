# Configure the email address that debug-me uses when emailing logs to users.
# This address is used in the "From:" header of notification emails sent to
# users when their debug session logs are generated.
#
# Variable: debug_me_from_email
# Default: 'postmaster'
DEBUG_ME_FROM_EMAIL="{{ (debug_me_from_email | default('postmaster')) }}"

# Parameters to pass to debug-me when it's started as a daemon.
# These parameters control the log storage location and log retention policy.
#
# Variable: debug_me_log_dir
# Default: '/var/log/debug-me/'
DAEMON_PARAMS="--server {{ (debug_me_log_dir | default('/var/log/debug-me/')) }} --delete-old-logs"