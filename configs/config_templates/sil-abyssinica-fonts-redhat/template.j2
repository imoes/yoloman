<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
	<!-- Generic names -->
	<alias>
		<!-- The font family name for Abyssinica SIL. -->
		<family>{{ font_family | default('Abyssinica SIL') }}</family>
		<default>
			<family>serif</family>
		</default>
	</alias>
	<!-- Simple priority lists -->
	<alias>
		<family>serif</family>
		<prefer>
			<!-- The font family name for Abyssinica SIL. -->
			<family>{{ font_family | default('Abyssinica SIL') }}</family>
		</prefer>
	</alias>
    <match target="font">
      <test name="family" ignore-blanks="true">
         <!-- The font family name for Abyssinica SIL. -->
         <string>{{ font_family | default('Abyssinica SIL') }}</string>
      </test>
      <edit name="autohint" mode="assign">
         <!-- Whether to enable autohinting for the Abyssinica SIL font. -->
         <bool>{{ autohint | default('true') }}</bool>
      </edit>
    </match>
</fontconfig>
