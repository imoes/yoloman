{
  "log_level": "quiet",
  "quiet": true,
  "silent": false,
  "progress": false,
  "jack": false,
  "serialise": false,
  "serialise_filename": "",
  "repository": "",
  "profile": "default",
  "consumers": [
    {
      "id": "avformat",
      "args": "filename=output.mp4 vcodec=libx264 acodec=aac"
    }
  ],
  "tracks": [
    {
      "audio_only": false,
      "video_only": false,
      "hidden": false,
      "clips": [
        {
          "id": "avformat",
          "args": "filename=input_video.mp4"
        },
        {
          "id": "avformat",
          "args": "filename=input_audio.wav"
        }
      ],
      "filters": [
        {
          "id": "colorlevels",
          "args": "rcomp=1.05"
        }
      ],
      "cuts": [
        {
          "id": "avformat",
          "args": "filename=input_video.mp4"
        }
      ],
      "mixes": [
        {
          "length": 30,
          "mixer": "dissolve"
        }
      ]
    }
  ],
  "global_filters": [],
  "global_transitions": [],
  "global_attachments": []
}
