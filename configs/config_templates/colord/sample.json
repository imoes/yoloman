{
  "session_bus_enabled": false,
  "database_path": "/var/lib/colord",
  "cache_dir": "/var/cache/colord",
  "max_cache_size": 0,
  "vendor_profiles_enabled": true,
  "embedded_profiles_enabled": true,
  "upload_enabled": true,
  "vendor_profile_dirs": [
    {
      "path": "/usr/share/color/icc/colord",
      "description": "colord's built-in vendor profiles"
    },
    {
      "path": "/usr/share/color/icc",
      "description": "system-wide vendor ICC profiles"
    }
  ],
  "system_profile_dirs": [
    {
      "path": "/usr/share/color/icc/system",
      "description": "system-managed ICC profiles"
    }
  ],
  "lcms_enabled": true,
  "display_calibration_enabled": false,
  "printer_calibration_enabled": false,
  "hwc_enabled": true,
  "max_workers": 4,
  "device_timeout": 30,
  "debug_enabled": false
}
