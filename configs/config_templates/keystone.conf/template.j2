[DEFAULT]
# Logical name for this deployment; used in logs and to disambiguate multi-tenancy.
deployment_name = {{ keystone_default_deployment_name | default('openstack') }}

[assignment]
# Backend driver for managing role/project/user assignments.
driver = {{ keystone_assignment_driver | default('sql') }}

[auth]
# Supported authentication methods for clients (e.g., password, token, oauth1).
methods = {{ keystone_auth_methods | default(['password', 'token']) | join(', ') }}

[catalog]
# Backend driver for service catalog (list of endpoints per service).
driver = {{ keystone_catalog_driver | default('sql') }}

[credential]
# Storage backend for credentials (e.g., fernet for encrypted key rotation).
driver = {{ keystone_credential_driver | default('fernet') }}

[database]
# Database connection URI. Supports MySQL, PostgreSQL, SQLite (for dev).
connection = {{ keystone_database_connection | default('mysql+pymysql://keystone:keystone@localhost/keystone') }}

[federation]
# Backend for federated identity (SAML, OpenID Connect, etc.).
driver = {{ keystone_federation_driver | default('sql') }}

[fernet_tokens]
# Path to directory storing Fernet token keys. Must be writable and synced across nodes.
key_repository = {{ keystone_fernet_tokens_key_repository | default('/etc/keystone/fernet-keys/') }}

[identity]
# Backend driver for user/group management.
driver = {{ keystone_identity_driver | default('sql') }}

[ldap]
# LDAP server URL (required only if using LDAP backend).
url = {{ keystone_ldap_url | default('') }}

[memcache]
# List of memcached servers for caching (e.g., ['host1:11211', 'host2:11211']).
servers = {{ keystone_memcache_servers | default([]) | join(',') }}

[oauth1]
# Backend for OAuth1 token/consumer storage.
driver = {{ keystone_oauth1_driver | default('sql') }}

[paste_deploy]
# PasteDeploy config path defining WSGI pipeline and middleware.
config_file = {{ keystone_paste_deploy_config | default('config:/etc/keystone/keystone-paste.ini') }}

[policy]
# Backend for RBAC policy rules.
driver = {{ keystone_policy_driver | default('sql') }}

[resource]
# Backend driver for managing projects and domains.
driver = {{ keystone_resource_driver | default('sql') }}

[s3]
# Backend for S3-compatible credential storage.
driver = {{ keystone_s3_driver | default('sql') }}

[signing]
# Path to PKI signing certificate (legacy PKI tokens only).
certfile = {{ keystone_signing_certfile | default('') }}
# Path to PKI signing private key (legacy PKI tokens only).
keyfile = {{ keystone_signing_keyfile | default('') }}

[token]
# Token format: 'fernet' (recommended), 'uuid', or legacy 'pki'.
provider = {{ keystone_token_provider | default('fernet') }}
# Token lifetime in seconds. Shorter = more secure, more overhead.
expiration = {{ keystone_token_expiration | default(3600) }}
# Max simultaneous active tokens per user.
max_concurrent = {{ keystone_token_max_concurrent | default(10) }}
# Backend for token revocation list (e.g., sql, redis, memcache).
revocation_driver = {{ keystone_token_revocation_driver | default('sql') }}
# Backend for caching token metadata (e.g., sql, memcache).
cache_driver = {{ keystone_token_cache_driver | default('sql') }}
# Redis connection URL for token storage or caching (e.g., 'redis://redis:6379').
redis_url = {{ keystone_redis_url | default('') }}
# Enable caching of token lookups for improved performance.
use_cache = {{ keystone_token_use_cache | default(True) | lower }}
# TTL for cached token entries (seconds).
cache_ttl = {{ keystone_token_cache_ttl | default(600) }}
# Max revocation events to cache.
revocation_cache_size = {{ keystone_token_revocation_cache_size | default(1000) }}
# Immediately expire revoked tokens (requires driver support).
expire_on_revocation = {{ keystone_token_expire_on_revocation | default(False) | lower }}
# Enable PKI revocation cache (legacy PKI tokens only).
pki_revocation_cache = {{ keystone_token_pki_revocation_cache | default(False) | lower }}

[tokenless_auth]
# Backend for tokenless auth flows (e.g., OAuth1).
driver = {{ keystone_tokenless_auth_driver | default('sql') }}

[trust]
# Backend for delegated trust tokens.
driver = {{ keystone_trust_driver | default('sql') }}

[endpoint_filter]
# Backend for project-level endpoint filtering.
driver = {{ keystone_endpoint_filter_driver | default('sql') }}

[endpoint_policy]
# Backend for endpoint access control policies.
driver = {{ keystone_endpoint_policy_driver | default('sql') }}

[eventlet_server]
# Network interface for public API server (v2/v3).
bind_host = {{ keystone_eventlet_server_bind_host | default('0.0.0.0') }}
# Port for public API endpoints (e.g., /v3/auth/tokens).
public_port = {{ keystone_eventlet_server_public_port | default(5000) }}
# Port for admin-only API endpoints (e.g., user management).
admin_port = {{ keystone_eventlet_server_admin_port | default(35357) }}
# Number of worker processes for handling requests.
workers = {{ keystone_eventlet_server_workers | default(1) }}
# Enable HTTPS for the API endpoints.
enable_ssl = {{ keystone_eventlet_server_enable_ssl | default(False) | lower }}
# Path to SSL certificate file (required if SSL is enabled).
ssl_certfile = {{ keystone_eventlet_server_ssl_certfile | default('/etc/keystone/ssl/cert.pem') }}
# Path to SSL private key file (required if SSL is enabled).
ssl_keyfile = {{ keystone_eventlet_server_ssl_keyfile | default('/etc/keystone/ssl/key.pem') }}
# Path to CA bundle for client certificate verification (mTLS).
ssl_ca_certs = {{ keystone_eventlet_server_ssl_ca_certs | default('') }}
# Maximum size (in bytes) of request body allowed (DOCS: default ~112 KiB).
max_request_body_size = {{ keystone_eventlet_server_max_request_body_size | default(114688) }}