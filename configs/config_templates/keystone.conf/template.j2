[DEFAULT]
# The name of the deployment (e.g., 'openstack')
# This is used for logging, caching, and to identify the deployment
# in multi-tenant or multi-region environments

[assignment]
# Driver used for assignment management (e.g., 'sql')
# Determines how roles, projects, and users are assigned and managed

[auth]
# Methods allowed for authenticating users (e.g., 'password', 'token')
# Controls which authentication mechanisms are available to clients

[catalog]
# Driver used for catalog management (e.g., 'sql', 'template')
# Dictates how service endpoints are stored and retrieved

[credential]
# Driver used for credential storage (e.g., 'fernet', 'sql')
# Specifies how credentials (e.g., user passwords) are stored and protected

[database]
# SQL connection string for the keystone database (e.g., 'mysql+pymysql://keystone:PASS@HOST/keystone')
# Used to connect to the backend database for persistence

[federation]
# Driver used for federated identity (e.g., 'sql')
# Enables integration with external identity providers (SAML, OpenID Connect)

[fernet_tokens]
# Directory where Fernet token keys are stored
# Used only when token format is Fernet; keys must be rotated periodically

[identity]
# Driver used for identity management (e.g., 'sql')
# Specifies how users and groups are stored and managed

[ldap]
# LDAP server URL (e.g., 'ldap://ldap.example.com')
# Used when identity or assignment backend is LDAP

[memcache]
# Memcached servers (comma-separated list, e.g., 'mem1:11211,mem2:11211')
# Enables caching via memcached for improved performance

[oauth1]
# Driver used for OAuth1 support (e.g., 'sql')
# Enables support for OAuth1 tokens and consumers

[paste_deploy]
# Configuration file for the PasteDeploy router (e.g., 'config:/etc/keystone/keystone-paste.ini')
# Defines WSGI pipeline and middleware for the keystone service

[policy]
# Driver used for policy enforcement (e.g., 'sql')
# Dictates how RBAC policies are stored and evaluated

[resource]
# Driver used for resource management (e.g., 'sql')
# Specifies how projects (tenants) and domains are handled

[s3]
# Driver used for S3 compatibility (e.g., 'sql')
# Enables support for S3-compatible object storage authentication

[signing]
# Directory where PKI token signing certificates are stored
# Used only when token format is PKI; deprecated in newer versions

[token]
# Provider class for token management (e.g., 'fernet', 'uuid', 'pki')
# Determines token format and handling (Fernet is recommended in modern deployments)

# Expiration time for tokens in seconds (e.g., 3600)
# Tokens will expire after this duration unless revoked
# Maximum number of concurrent tokens a user may hold
# Enables token revocation via token blacklist (e.g., 'sql')
# Driver used for token storage (e.g., 'sql', 'fernet', 'redis')
# Redis connection URL when using Redis-backed token storage (e.g., 'redis://redis:6379')

# Whether to expire tokens immediately upon revocation (e.g., false)
# When true, revoking a token instantly invalidates it (requires driver support)
# Enable PKI token revocation cache (e.g., false)
# Enables token caching for performance (e.g., true)
# Time-to-live for cached tokens in seconds (e.g., 600)
# Number of revocation events to cache (e.g., 1000)

[tokenless_auth]
# Driver used for tokenless authentication (e.g., 'sql')
# Allows authentication without issuing tokens (e.g., for certain OAuth1 flows)

[trust]
# Driver used for trust management (e.g., 'sql')
# Enables delegation of roles via trust tokens

[endpoint_filter]
# Driver used for endpoint filtering (e.g., 'sql')
# Enables project-level endpoint filtering

[endpoint_policy]
# Driver used for endpoint policy (e.g., 'sql')
# Controls access to service endpoints based on policy rules

[eventlet_server]
# Host address to bind the keystone service to (e.g., '0.0.0.0')
# Listening interface for the main API server

# Port to bind the keystone service to (e.g., 5000)
# Public API endpoint port (v2 and v3)

# Port for admin API endpoint (e.g., 35357)
# Admin API port for privileged operations

# Maximum number of worker processes (e.g., 1)
# Controls concurrency via multiprocessing; set >1 for multi-core systems

# Enable SSL/TLS for the API endpoints (e.g., false)
# Enables HTTPS when set to true

# Path to SSL certificate file (e.g., '/etc/keystone/ssl/cert.pem')
# Required when SSL is enabled

# Path to SSL private key file (e.g., '/etc/keystone/ssl/key.pem')
# Required when SSL is enabled

# Path to CA bundle for client verification (e.g., '/etc/keystone/ssl/cacert.pem')
# Enables mutual TLS (mTLS) when provided

# Number of request body size allowed (in bytes) (e.g., 114688)
# Prevents oversized payloads (DOCS: default ~112 KiB)
