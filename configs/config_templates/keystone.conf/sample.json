{
  "keystone_default_deployment_name": "prod",
  "keystone_assignment_driver": "sql",
  "keystone_auth_methods": [
    "password",
    "token"
  ],
  "keystone_catalog_driver": "sql",
  "keystone_credential_driver": "fernet",
  "keystone_database_connection": "mysql+pymysql://keystone:keystone_pass@db.example.com/keystone",
  "keystone_federation_driver": "sql",
  "keystone_fernet_tokens_key_repository": "/etc/keystone/fernet-keys/",
  "keystone_identity_driver": "sql",
  "keystone_ldap_url": "",
  "keystone_memcache_servers": [
    "cache1:11211",
    "cache2:11211"
  ],
  "keystone_oauth1_driver": "sql",
  "keystone_paste_deploy_config": "config:/etc/keystone/keystone-paste.ini",
  "keystone_policy_driver": "sql",
  "keystone_resource_driver": "sql",
  "keystone_s3_driver": "sql",
  "keystone_signing_certfile": "",
  "keystone_signing_keyfile": "",
  "keystone_token_provider": "fernet",
  "keystone_token_expiration": 3600,
  "keystone_token_max_concurrent": 10,
  "keystone_token_revocation_driver": "sql",
  "keystone_token_cache_driver": "memcache",
  "keystone_token_use_cache": true,
  "keystone_token_cache_ttl": 300,
  "keystone_token_revocation_cache_size": 2000,
  "keystone_token_expire_on_revocation": true,
  "keystone_token_pki_revocation_cache": false,
  "keystone_tokenless_auth_driver": "sql",
  "keystone_trust_driver": "sql",
  "keystone_endpoint_filter_driver": "sql",
  "keystone_endpoint_policy_driver": "sql",
  "keystone_eventlet_server_bind_host": "0.0.0.0",
  "keystone_eventlet_server_public_port": 5000,
  "keystone_eventlet_server_admin_port": 35357,
  "keystone_eventlet_server_workers": 4,
  "keystone_eventlet_server_enable_ssl": true,
  "keystone_eventlet_server_ssl_certfile": "/etc/keystone/ssl/cert.pem",
  "keystone_eventlet_server_ssl_keyfile": "/etc/keystone/ssl/key.pem",
  "keystone_eventlet_server_ssl_ca_certs": "/etc/keystone/ssl/ca.pem",
  "keystone_eventlet_server_max_request_body_size": 114688,
  "keystone_redis_url": "redis://redis.example.com:6379"
}
