{#
  b3sum command invocation template.
  Generates a multi-line shell command for the `b3sum` utility.
  Self-documenting: every variable and block is described below.
#}

# Command to run b3sum with specified options and files
b3sum \
{% for option in options | default([], true) %}
  # Option: {{ option }}
{{ option }} \
{% endfor %}
{% for file in files | default([], true) %}
  # Input file: {{ file }}
{{ file }} \
{% endfor %}