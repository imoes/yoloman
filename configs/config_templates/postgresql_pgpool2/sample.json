{
  "listen_addresses": "*",
  "port": 9999,
  "unix_socket_directories": "/var/run/postgresql",
  "num_init_children": 32,
  "max_pool": 4,
  "backends": [
    {
      "hostname": "pg1.internal.example.com",
      "port": 5432,
      "weight": 1,
      "data_directory": "/var/lib/postgresql/17/main",
      "status": 1
    },
    {
      "hostname": "pg2.internal.example.com",
      "port": 5432,
      "weight": 1,
      "data_directory": "/var/lib/postgresql/17/main",
      "status": 1
    }
  ],
  "num_backends": 2,
  "load_balance_mode": true,
  "health_check_period": 10,
  "health_check_timeout": 5,
  "failover_on_backend_error": true,
  "log_connections": false,
  "log_hostname": false,
  "log_statement": false,
  "log_per_node_statement": false,
  "authentication_timeout": 60,
  "ssl": false,
  "delay_threshold": 0,
  "ignore_missing_postmaster_parameter": false,
  "memory_cache_enabled": true,
  "use_watchdog": false,
  "watchdog_hostname": "",
  "watchdog_port": 9000,
  "watchdog_interval": 1
}
