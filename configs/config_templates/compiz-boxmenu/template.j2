<?xml version="1.0" encoding="UTF-8"?>
<!--
  compiz-boxmenu configuration template.
  Generates an XML menu configuration for Compiz Boxmenu plugin.
  This file defines the structure of the application launcher menu,
  including browsers, terminals, editors, and system tools.
-->
<menu>
  <!--
    Epiphany Browser Launcher
    Display name for Epiphany browser launcher, with optional accelerator mnemonic prefix (_)
  -->
  <item type="launcher">
    <name>{{ epiphany_name | default('_Epiphany') }}</name>
    <!-- Icon name/path for Epiphany browser -->
    <icon>{{ epiphany_icon | default('gnome-web-browser') }}</icon>
    <!-- Command to launch Epiphany browser -->
    <command>{{ epiphany_command | default('epiphany') }}</command>
  </item>

  <!--
    Terminal Launcher
    Display name for Terminal launcher, with optional accelerator mnemonic prefix (_)
  -->
  <item type="launcher">
    <name>{{ terminal_name | default('_Terminal') }}</name>
    <!-- Icon name/path for Terminal -->
    <icon>{{ terminal_icon | default('gnome-terminal') }}</icon>
    <!-- Command to launch Terminal -->
    <command>{{ terminal_command | default('gnome-terminal') }}</command>
  </item>

  <!--
    Extras Submenu
    Display name for the E_xtras menu, with optional accelerator mnemonic prefix (_)
  -->
  <menu name="{{ extras_menu_name | default('E_xtras') }}">
    <!--
      Text Editor Launcher
      Display name for text editor launcher, with optional accelerator mnemonic prefix (_)
    -->
    <item type="launcher">
      <name>{{ text_editor_name | default('Te_xt Editor') }}</name>
      <!-- Icon name/path for text editor -->
      <icon>{{ text_editor_icon | default('accessories-text-editor') }}</icon>
      <!-- Command to launch text editor -->
      <command>{{ text_editor_command | default('gedit') }}</command>
    </item>

    <!--
      Aisleriot Solitaire Launcher
      Display name for Aisleriot Solitaire launcher, with optional accelerator mnemonic prefix (_)
    -->
    <item type="launcher">
      <name>{{ aisleriot_name | default('_Aisleriot Solitaire') }}</name>
      <!-- Icon name/path for Aisleriot Solitaire -->
      <icon>{{ aisleriot_icon | default('gnome-aisleriot') }}</icon>
      <!-- Command to launch Aisleriot Solitaire -->
      <command>{{ aisleriot_command | default('sol') }}</command>
    </item>
  </menu>

  <!-- Separator line in the menu -->
  <separator/>

  <!-- Window List: Shows currently open windows -->
  <item type="windowlist"/>

  <!-- Viewport List: Shows virtual desktops -->
  <item type="viewportlist"/>

  <!--
    Boxmenu Editor Launcher
    Display name for boxmenu editor launcher, with optional accelerator mnemonic prefix (_)
  -->
  <item type="launcher">
    <!-- Icon name/path for boxmenu editor launcher -->
    <icon>{{ edit_icon | default('gtk-edit') }}</icon>
    <!-- Command to launch boxmenu editor -->
    <command>{{ edit_command | default('compiz-boxmenu-editor') }}</command>
    <name>{{ edit_name | default('E_dit') }}</name>
  </item>

  <!-- Reload Action: Refreshes the menu configuration -->
  <item type="reload"/>
</menu>