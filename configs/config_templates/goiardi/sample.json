{
  "environment": "production",
  "verbose": false,
  "log_level": "info",
  "log_file": "/var/log/goiardi/goiardi.log",
  "web_addr": "0.0.0.0",
  "web_port": 4545,
  "use_ssl": true,
  "ssl_cert_file": "/etc/goiardi/certs/server.crt",
  "ssl_key_file": "/etc/goiardi/certs/server.key",
  "client_cert_verify": false,
  "client_ca_cert_file": "",
  "data_dir": "/var/lib/goiardi",
  "db_backend": "postgresql",
  "postgresql_host": "localhost",
  "postgresql_port": 5432,
  "postgresql_db": "goiardi_prod",
  "postgresql_user": "goiardi",
  "postgresql_password": "supersecret",
  "postgresql_max_open_conns": 128,
  "chef_zero_compat": false,
  "enable_search": true,
  "worker_count": 16,
  "max_concurrent_uploads": 32,
  "webhooks": [
    {
      "name": "slack_ops",
      "url": "https://hooks.slack.com/services/XXX/YYY/ZZZ",
      "enabled": true,
      "method": "POST",
      "headers": [
        {
          "Content-Type": "application/json"
        }
      ]
    },
    {
      "name": "pagerduty_events",
      "url": "https://events.pagerduty.com/v2/enqueue",
      "enabled": true,
      "method": "POST",
      "headers": [
        {
          "Content-Type": "application/json",
          "Authorization": "Token token=YOUR_PAGERDUTY_KEY"
        }
      ]
    }
  ],
  "default_node_attributes": {
    "automatic": {
      "kernel": {
        "machine": "x86_64"
      }
    }
  },
  "enable_cors": false,
  "cors_origins": [],
  "cors_credentials": false,
  "idle_timeout": 90,
  "max_request_body_size": 524288000,
  "gzip_responses": true,
  "enable_metrics": true,
  "metrics_token": "metrics-secret-123",
  "server_version_string": "goiardi/0.12.1 (production)",
  "node_attribute_whitelist_enabled": true,
  "node_attribute_whitelist": [
    "automatic",
    "automatic/kernel",
    "automatic/ohai_time",
    "chef_packages"
  ],
  "enable_chef_vault": false,
  "enable_audit_logging": true,
  "audit_log_file": "/var/log/goiardi/audit.log",
  "enable_run_list_expansion": true,
  "knife_zero_compat": false,
  "enable_key_rotation": true
}
