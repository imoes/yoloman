# ==============================================================================
# dmarcts-report-parser cron job configuration
#
# This template generates a crontab entry for the DMARCS Report Parser.
# The parser runs periodically to fetch and process DMARC aggregate/forensic reports.
#
# Generated variables:
#   - cron_minute: Minute of the hour (default: 1)
#   - cron_user: System user to execute the job as (default: _dmarcts)
# ==============================================================================

# Cron entry: Runs the dmarcts-report-parser cronjob script.
# Syntax: <minute> <hour> <day_of_month> <month> <day_of_week> <user> <command>
# The command checks if the script exists and is executable before running it.
{{ cron_minute | default('1') | string }} * * * {{ cron_user | default('_dmarcts') }} [ -x /usr/libexec/dmarcts-report-parser.cronjob ] && /usr/libexec/dmarcts-report-parser.cronjob
