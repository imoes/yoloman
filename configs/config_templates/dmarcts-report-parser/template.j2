# CRON configuration for dmarcts-report-parser
# This template generates a cron entry to run the DMARC report parser periodically.
# The schedule and user are configurable via Ansible variables.

# Cron schedule expression (minute hour day-of-month month day-of-week)
# Default: Daily at 00:01
0 1 * * * {{ dmarcts_cron_user | default('_dmarcts') }} [ -x /usr/libexec/dmarcts-report-parser.cronjob ] && /usr/libexec/dmarcts-report-parser.cronjob