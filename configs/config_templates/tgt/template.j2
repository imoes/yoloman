# TGT (Target Generic Framework) configuration template.
# This file serves as the entry point for TGT's iSCSI target configuration.
# Actual target definitions should be placed in separate files within the
# configuration directory, which are then included via the glob pattern below.

# Directory where individual configuration snippets are placed.
# TGT looks for .conf files in this directory to define storage targets.
# Default: /etc/tgt/conf.d
conf_dir {{ conf_dir | default('/etc/tgt/conf.d') }}

# Glob pattern for including configuration files from the conf_dir.
# Any file matching this pattern will be parsed and included into the
# active TGT configuration. This allows modular management of multiple
# storage targets.
# Default: /etc/tgt/conf.d/*.conf
include {{ include_pattern | default('/etc/tgt/conf.d/*.conf') }}