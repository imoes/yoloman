{
  "daemon_run_as_daemon": true,
  "daemon_run_as_user": "nobody",
  "daemon_run_as_group": "nogroup",
  "daemon_pidfile": "/var/run/lbcd.pid",
  "logging_log_level": 2,
  "logging_log_destination": "file",
  "logging_log_file": "/var/log/lbcd/lbcd.log",
  "server_bind_address": "0.0.0.0",
  "server_bind_port": 80,
  "server_max_connections": 5000,
  "backends": [
    {
      "name": "app1",
      "host": "10.0.1.10",
      "port": 3000,
      "weight": 100,
      "enabled": true
    },
    {
      "name": "app2",
      "host": "10.0.1.11",
      "port": 3000,
      "weight": 100,
      "enabled": true
    },
    {
      "name": "app3",
      "host": "10.0.1.12",
      "port": 3000,
      "weight": 50,
      "enabled": false
    }
  ],
  "healthcheck_enabled": true,
  "healthcheck_interval": 15,
  "healthcheck_timeout": 5,
  "healthcheck_failure_count": 3,
  "healthcheck_success_count": 2,
  "failover_strategy": "leastconn",
  "failover_preserve_client_ip": false,
  "failover_grace_period": 60
}
