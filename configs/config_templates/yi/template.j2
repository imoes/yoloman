# Path to the Yi configuration file.
# This variable is primarily used by Ansible to place this template at the correct location.
# The file itself is a Haskell source file (.hs).
# {{ config_file | default('~/.config/yi/yi.hs') }}

-- Frontend Selection
-- Select frontend interface. One of: vty, gtk, pango, cocoa.
-- Default: vty
frontend = "{{ frontend | default('vty') }}"

-- Initial Line Number
-- Start the editor on a given line number.
-- Default: 1
initialLine = {{ line_number | default(1) }}

-- Key Bindings Profile
-- Start with key bindings of a given editor (e.g., vi, emacs).
-- Empty string for defaults.
keyBindings = "{{ key_bindings_profile | default('') }}"

-- Debug Mode
-- Enable debug mode to write debug information in a log file.
-- Default: False
debugMode = {{ debug_mode | default(false) | lower }}

-- Self Check
-- Run self-checks on startup.
-- Default: False
selfCheck = {{ self_check | default(false) | lower }}

-- Resume
-- Resume execution of Yi from previous state.
-- Default: False
resume = {{ resume | default(false) | lower }}