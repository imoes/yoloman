{
  "session_type": {
    "type": "string",
    "default": "default",
    "description": "Session type to start: 'failsafe', 'default', or 'program'"
  },
  "xsession_d_path": {
    "type": "string",
    "default": "/etc/X11/Xsession.d",
    "description": "Path to the directory containing modular X session startup scripts"
  },
  "xresources_d_path": {
    "type": "string",
    "default": "/etc/X11/Xresources",
    "description": "Path to directory containing system-wide X resources"
  },
  "user_xresources": {
    "type": "boolean",
    "default": true,
    "description": "Whether to load user's ~/.Xresources"
  },
  "allow_failsafe": {
    "type": "boolean",
    "default": true,
    "description": "Whether to allow 'failsafe' session type"
  },
  "allow_user_xsession": {
    "type": "boolean",
    "default": true,
    "description": "Whether to allow user .xsession/.Xsession scripts"
  },
  "allow_user_xsession_program": {
    "type": "boolean",
    "default": true,
    "description": "Whether to allow 'program' session type (arbitrary session command)"
  },
  "use_ssh_agent": {
    "type": "boolean",
    "default": true,
    "description": "Whether to use/start ssh-agent for the session"
  },
  "sysmodmap": {
    "type": "string",
    "default": "/etc/X11/Xmodmap",
    "description": "System X modmap file path"
  },
  "usrmodmap": {
    "type": "string",
    "default": "$HOME/.Xmodmap",
    "description": "User X modmap file path"
  },
  "xmodmap_executable": {
    "type": "string",
    "default": "/usr/bin/X11/xmodmap",
    "description": "Path to xmodmap binary"
  },
  "xhost_enabled": {
    "type": "boolean",
    "default": true,
    "description": "Whether to run xhost to allow local user access"
  },
  "error_log_path": {
    "type": "string",
    "default": "$TMPDIR/xsession-XXXXXX",
    "description": "Fallback path for session error log when ~/.xsession-errors is unwritable"
  }
}
