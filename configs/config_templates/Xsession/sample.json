{
  "session_type": "failsafe",
  "xsession_d_path": "/etc/X11/Xsession.d",
  "xresources_d_path": "/etc/X11/Xresources",
  "user_xresources": true,
  "allow_failsafe": false,
  "allow_user_xsession": true,
  "allow_user_xsession_program": false,
  "use_ssh_agent": true,
  "sysmodmap": "/etc/X11/Xmodmap",
  "usrmodmap": "$HOME/.Xmodmap",
  "xmodmap_executable": "/usr/bin/xmodmap",
  "xhost_enabled": true,
  "error_log_path": "/tmp/xsession-XXXXXX"
}