{
  "mode": {
    "type": "string",
    "default": "default",
    "description": "The operation mode for sipsak: default, flood, usrloc, traceroute, randtrash, message.",
    "enum": [
      "default",
      "flood",
      "usrloc",
      "traceroute",
      "randtrash",
      "message"
    ]
  },
  "sip_uri": {
    "type": "string",
    "default": "sip:test@sip.example.com",
    "description": "The target SIP URI (-s)."
  },
  "remote_port": {
    "type": "number",
    "default": 5060,
    "description": "The remote port to connect to (-r)."
  },
  "verbose": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level (-v). 0=normal, 1=verbose, 2=very verbose, 3=packet content."
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Password for authentication (-a)."
  },
  "from_uri": {
    "type": "string",
    "default": "",
    "description": "From header URI (-c)."
  },
  "max_forwards": {
    "type": "number",
    "default": 70,
    "description": "Max-Forwards header value (-m)."
  },
  "timeout_factor": {
    "type": "number",
    "default": 1,
    "description": "SIP_T1 timer multiplier (-D)."
  },
  "timer_t1": {
    "type": "number",
    "default": 500,
    "description": "SIP timer T1 in milliseconds (-Z)."
  },
  "transport": {
    "type": "string",
    "default": "udp",
    "description": "IP transport to use (-E): udp or tcp.",
    "enum": [
      "udp",
      "tcp"
    ]
  },
  "ignore_redirects": {
    "type": "bool",
    "default": false,
    "description": "Ignore redirects (-d)."
  },
  "no_via": {
    "type": "bool",
    "default": false,
    "description": "Deactivate Via line insertion (-i)."
  },
  "remove_crlf": {
    "type": "bool",
    "default": false,
    "description": "Deactivate automatic CRLF insertion (-L)."
  },
  "local_port": {
    "type": "number",
    "default": 0,
    "description": "Local port to use (-l). 0 means default/random."
  },
  "symmetric": {
    "type": "bool",
    "default": false,
    "description": "Use same port for send/receive (-S)."
  },
  "local_ip": {
    "type": "string",
    "default": "",
    "description": "Local IP address to bind to (-k)."
  },
  "hostname": {
    "type": "string",
    "default": "",
    "description": "Override hostname detection (-H)."
  },
  "auth_username": {
    "type": "string",
    "default": "",
    "description": "Username for authentication (-u)."
  },
  "autohash": {
    "type": "string",
    "default": "",
    "description": "Hex string for H(A1) digest auth (-J)."
  },
  "message_body": {
    "type": "string",
    "default": "",
    "description": "Body content for MESSAGE requests (-B)."
  },
  "content_disposition": {
    "type": "string",
    "default": "",
    "description": "Content-Disposition header value (-O)."
  },
  "additional_headers": {
    "type": "string",
    "default": "",
    "description": "Additional headers string (-j). Use \\n for multiple headers."
  },
  "search_regexp": {
    "type": "string",
    "default": "",
    "description": "Regular expression to match replies against (-q)."
  },
  "replace_string": {
    "type": "string",
    "default": "",
    "description": "Custom replacement string for $var$ patterns (-g)."
  },
  "replace_auto": {
    "type": "bool",
    "default": false,
    "description": "Enable automatic replacement of $dsthost$, $srchost$, etc. (-G)."
  },
  "filename": {
    "type": "string",
    "default": "",
    "description": "Filename to read SIP message from (-f)."
  },
  "numeric": {
    "type": "bool",
    "default": true,
    "description": "Use IP instead of FQDN in Via line (-n)."
  },
  "nagios_code": {
    "type": "bool",
    "default": false,
    "description": "Return Nagios compliant exit codes (-N)."
  },
  "warn_threshold": {
    "type": "number",
    "default": 0,
    "description": "Return Nagios warn code if retransmissions exceed this (-W)."
  },
  "timing_only": {
    "type": "bool",
    "default": false,
    "description": "Print only timing values (-A)."
  },
  "invite_mode": {
    "type": "bool",
    "default": false,
    "description": "Activate Invite cycles in usrloc mode (-I)."
  },
  "message_mode": {
    "type": "bool",
    "default": false,
    "description": "Activate Message cycles in usrloc mode (-M)."
  },
  "expires": {
    "type": "number",
    "default": 3600,
    "description": "Expires header value (-x)."
  },
  "contact_uri": {
    "type": "string",
    "default": "",
    "description": "Contact header URI (-C)."
  },
  "sleep_time": {
    "type": "number",
    "default": 0,
    "description": "Sleep time in milliseconds before next cycle (-o)."
  },
  "appendix_begin": {
    "type": "number",
    "default": 1,
    "description": "Starting number for user name appendix in usrloc mode (-b)."
  },
  "appendix_end": {
    "type": "number",
    "default": 0,
    "description": "Ending number for user name appendix in usrloc mode (-e). 0 uses default max."
  },
  "remove_bindings": {
    "type": "bool",
    "default": false,
    "description": "Randomly remove old bindings in usrloc mode (-z)."
  },
  "max_messages": {
    "type": "number",
    "default": 0,
    "description": "Maximum number of messages in flood mode (-e)."
  },
  "processes": {
    "type": "number",
    "default": 1,
    "description": "Number of parallel processes (-P)."
  },
  "max_trash_chars": {
    "type": "number",
    "default": 0,
    "description": "Maximum trashed characters in randtrash mode (-t)."
  },
  "extract_ip": {
    "type": "bool",
    "default": false,
    "description": "Extract IP from Warning header in traceroute mode (-w)."
  }
}
