{
  "loglevel": 2,
  "default_delivery": "\"Maildir/\"",
  "logfile": "\"/var/log/maildrop.log\"",
  "quota_enabled": true,
  "quota_mb": 1024,
  "maxsize": 25000000,
  "ext_filter_enabled": true,
  "sieve_script": "\"/var/lib/dovecot/sieve/default.sieve\"",
  "filter_rules": [
    {
      "description": "Spam filtering \u2014 divert to Spam folder if header indicates spam",
      "condition": "'/^X-Spam-Flag: YES/'",
      "action": "to \"Spam/\""
    },
    {
      "description": "Mailing list archive \u2014 store list traffic",
      "condition": "to 'lists@example.com'",
      "action": "to \"Lists/lists/\""
    },
    {
      "description": "Priority email \u2014 move high-priority messages to Priority folder",
      "condition": "'/^Subject: \\*\\*Priority\\*\\*/'",
      "action": "to \"Priority/\""
    }
  ],
  "pre_delivery_hook": "\"/usr/bin/spamc -u maildrop 2>/dev/null || true\""
}
