{
  "video_dir": "/home/user/videos",
  "preferred_languages": [
    "en",
    "es",
    "fr"
  ],
  "cli_mode": true,
  "log_level": "debug",
  "log_file": "/var/log/subdownloader/subdownloader.log",
  "recursive": true,
  "proxy": "http://proxy.example.com:8080",
  "naming_strategy": "video",
  "providers": [
    {
      "name": "opensubtitles",
      "enabled": true,
      "parameters": {
        "username": "myuser",
        "password": "mypass"
      }
    },
    {
      "name": "podnapisi",
      "enabled": false,
      "parameters": {}
    }
  ]
}
