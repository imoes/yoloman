# ngetty configuration template
# This file controls the default environment settings for getty (get terminal) sessions.
# It is processed by the ngetty utility to set up the initial environment for login prompts.

# --- Global Options ---
# The format is: #	[ttyX]=option[=value]
# Currently, global environ settings are applied to all terminals.

# environ=,TERM=<value>
# Sets the TERM environment variable for getty sessions.
# This tells the terminal emulator and applications what type of terminal
# capabilities to expect (e.g., vt100, linux, xterm).
#
# Schema Field: default_term
# Description: The default TERM environment variable value for getty sessions.
# Default: 'linux'
#
# We use |default('linux') to ensure a safe fallback if the variable is not defined in Ansible.
=environ=,TERM={{ default_term | default('linux') }}