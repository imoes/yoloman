{
  "bin_path": "/usr/bin/globus-gatekeeper",
  "listen_host": "0.0.0.0",
  "control_port": 50003,
  "data_port": 50004,
  "max_connections": 128,
  "listen_backlog": 64,
  "idle_timeout": 300,
  "use_tls": true,
  "cert_file": "/etc/globus/hostcert.pem",
  "key_file": "/etc/globus/hostkey.pem",
  "ca_cert_file": "/etc/globus/certificates.pem",
  "require_client_cert": true,
  "allowed_client_dns": [
    "/DC=com/DC=org/CN=My Organization/CN=My User",
    "/DC=org/CN=Trusted Proxy Issuer"
  ],
  "allowed_proxy_issuers": [
    "/CN=My Delegation CA"
  ],
  "allow_proxy_delegation": true,
  "cred_dir": "/var/lib/globus/gatekeeper/cred",
  "max_proxy_lifetime": 43200,
  "log_to_syslog": true,
  "log_file": "/var/log/globus/gatekeeper.log",
  "log_level": "WARNING",
  "enabled": true
}
