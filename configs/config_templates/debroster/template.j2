# debroster configuration file
# Generated by Jinja2 — DO NOT EDIT MANUALLY
#
# This template configures the debroster application (a Debian-themed Eterm
# background scroller). All variables are self-documenting: each directive
# is preceded by a comment taken from the schema description, and every
# variable reference includes its schema default via the `default` filter.
#
# Variables used:
#   background_image: Path to the background image
#   developers: List of developer objects (name, email)
#   scroll_speed: Update interval in ms
#   font: X11 font spec string
#   geometry: Window size/position
#   double_buffer: Boolean toggle

# Path to background image used by Eterm.
# Default: '/usr/share/backgrounds/debian/debian-wallpaper.png'
background_image = {{ background_image | default('/usr/share/backgrounds/debian/debian-wallpaper.png') | quote }}

# List of Debian developers to display.
# This list is iterated directly; each item is expected to be a mapping with 'name' and 'email' keys.
# Defaults to an empty list if omitted.
{% for dev in developers | default([]) %}
# Developer: {{ dev.name | default('') }} <{{ dev.email | default('') }}>
{{ dev.name | default('') }}
{% endfor %}

# Scroll speed in milliseconds between updates.
# Default: 200
scroll_speed = {{ scroll_speed | default(200) }}

# Eterm font specification (X11 font name).
# Default: '-misc-fixed-medium-r-normal--14-130-75-75-c-70-iso8859-1'
font = {{ font | default('-misc-fixed-medium-r-normal--14-130-75-75-c-70-iso8859-1') | quote }}

# Eterm window geometry in WxH+X+Y format.
# Default: '800x600+0+0'
geometry = {{ geometry | default('800x600+0+0') | quote }}

# Enable double buffering for smoother rendering.
# Default: true
double_buffer = {{ double_buffer | default(true) | string | lower }}