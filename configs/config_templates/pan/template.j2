# ============================================================================
# Pan Usenet Newsreader Configuration File
# Generated by Jinja2 Template — Self-Documenting
#
# This file configures the Pan Usenet newsreader client. It uses the INI format
# with sections: [general], [logging], [nzb], [server], and [ssl].
# All values are drawn from Ansible variables with safe defaults defined
# inline via the `default()` Jinja filter.
# ============================================================================

[general]
# User data directory to use. Corresponds to the PAN_HOME environment variable.
home = {{ home | default('~/.pan2') }}

[logging]
# Enable verbose mode. Corresponds to the --verbose command-line flag.
# When true, Pan emits detailed information to the console.
verbose = {{ verbose | default(false) }}

# Run in debug mode. Corresponds to the --debug command-line flag.
# When true, enables internal debugging output for troubleshooting.
debug = {{ debug | default(false) }}

# Run in TLS/SSL debug mode. Corresponds to the --debug-ssl command-line flag.
# When true, enables verbose logging for TLS/SSL handshake and certificate issues.
debug_ssl = {{ debug_ssl | default(false) }}

[nzb]
# Path to save attachments listed in NZB files. Corresponds to the -o/--output option.
# This is the default download destination for newsgroup attachments.
output_dir = {{ nzb_output_dir | default('./downloads') }}

[server]
# Hostname of the primary Usenet server.
# This is the main server Pan connects to for retrieving articles.
server_host = {{ server_host | default('news.example.com') }}

# Port number of the primary Usenet server.
# Typically 119 for plaintext NNTP or 563 for NNTPS.
server_port = {{ server_port | default(119) }}

# Whether to use SSL/TLS for the primary server connection.
# When true, the connection to server_host:server_port is encrypted.
server_ssl = {{ server_ssl | default(false) }}

# Username for Usenet server authentication.
# Leave empty if the server allows anonymous access.
username = {{ username | default('') }}

# Password for Usenet server authentication.
# Leave empty if the server allows anonymous access.
password = {{ password | default('') }}

# List of additional Usenet server host:port strings for multi-server support.
# Each entry should be in the format "hostname:port".
# Pan rotates through these servers when one is unavailable.
# Output is a newline-separated list of host:port strings.
{% if extra_servers is defined and extra_servers | default([]) | length > 0 %}
# Additional servers ({{ extra_servers | default([]) | length }} defined):
{% for srv in extra_servers | default([]) %}
{{ srv }}
{% endfor %}
{% else %}
# No additional servers configured.
{% endif %}

[ssl]
# Directory to search for SSL certificates. Corresponds to SSL_CERT_DIR.
# This path is used to validate the Usenet server's TLS certificate.
ssl_cert_dir = {{ ssl_cert_dir | default('/etc/ssl/certs') }}

# Additional directory to search for SSL certificates. Corresponds to SSL_DIR.
# Provides a secondary location for CA certificates if the primary dir is insufficient.
ssl_alt_dir = {{ ssl_alt_dir | default('/etc/ssl/certs') }}