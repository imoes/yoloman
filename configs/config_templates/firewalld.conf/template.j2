[Daemon]
# Enable or disable the firewalld daemon
# Set to 'yes' to run firewalld as the primary firewall management service
# Set to 'no' to disable firewalld (e.g., if using another firewall like nftables)
# (Default: yes)
# Boolean: enable_firewalld
# Example: 'yes' → firewalld runs; 'no' → disabled
EnableFirewalld={{ enable_firewalld }}

# Directory where runtime state (e.g., zone, service, IptablesBackends) is stored
# (Default: /run/firewalld)
# Path: runtime directory
RuntimeDirectory={{ runtime_directory }}

# Directory where persistent configuration (e.g., zones, services, ipsets) is stored
# (Default: /etc/firewalld)
# Path: configuration directory
ConfigDirectory={{ config_directory }}

# Path to firewalld binary (for internal use or override)
# (Default: /usr/sbin/firewalld)
# Path: executable path
FirewallBackend={{ firewall_backend }}

# Maximum number of concurrent connections tracked (affects conntrack table size)
# (Default: 65536)
# Number: max tracked connections
MaxConnections={{ max_connections }}

# Enable logging of denied packets
# (Default: no)
# Boolean: enable logging of denied packets
LogDenied={{ log_denied }}

[Logging]
# Enable logging of all firewall events
# (Default: yes)
# Boolean: enable logging
# Set to 'no' to disable all logging
Logging={{ logging }}

# Minimum log level for events (e.g., 'emergency', 'alert', 'crit', 'error', 'warning', 'notice', 'info', 'debug')
# (Default: info)
# String: log level
# Lower levels = more verbose logging
LogLevel={{ log_level }}

[RFC3964]
# Enable RFC3964 IPv6 address filtering (6to4/6over4 handling)
# (Default: yes)
# Boolean: RFC3964 compliance
# Disable only if causing issues with legacy IPv6 tunnels
AllowRFC3964={{ allow_rfc3964 }}

[ipv6]
# Enable IPv6 support in firewalld
# (Default: yes)
# Boolean: IPv6 support
# Disable only if IPv6 is unused and you want to reduce attack surface
EnableIPv6={{ enable_ipv6 }}

[ipv4]
# Enable IPv4 support in firewalld
# (Default: yes)
# Boolean: IPv4 support
# Disable only if system is IPv6-only
EnableIPv4={{ enable_ipv4 }}

[interfaces]
# List of trusted interfaces (no firewall rules applied)
# (Default: empty list)
# List of strings: trusted interface names
{% for interface in trusted_interfaces %}# Trusted interface: {{ interface }}
TrustedInterface={{ interface }}
{% endfor %}

[zones]
# Default zone applied to new interfaces
# (Default: public)
# String: zone name
# Must correspond to an existing zone file in ConfigDirectory/zones/
DefaultZone={{ default_zone }}

# Enable or disable automatic zone assignment for interfaces
# (Default: no)
# Boolean: automatic zone assignment
# When enabled, interfaces are assigned to DefaultZone on activation
AutomaticZoneAssignment={{ automatic_zone_assignment }}