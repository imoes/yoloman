{
  "enable_firewalld": true,
  "runtime_directory": "/run/firewalld",
  "config_directory": "/etc/firewalld",
  "firewall_backend": "/usr/sbin/firewalld",
  "max_connections": 131072,
  "log_denied": "all",
  "logging": true,
  "log_level": "warning",
  "allow_rfc3964": true,
  "enable_ipv6": true,
  "enable_ipv4": true,
  "trusted_interfaces": [
    "lo",
    "virbr0"
  ],
  "default_zone": "dmz",
  "automatic_zone_assignment": false
}
