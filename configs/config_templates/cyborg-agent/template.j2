#!/bin/sh
### BEGIN INIT INFO
# Provides:          cyborg-agent
# Required-Start:    $network $local_fs $remote_fs $syslog
# Required-Stop:     $remote_fs
# Should-Start:      postgresql mysql keystone rabbitmq-server ntp
# Should-Stop:       postgresql mysql keystone rabbitmq-server ntp
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Cyborg agent daemon
# Description:       Provides the agent daemon for
#                    Acceleration-as-a-Service for OpenStack
### END INIT INFO

# Author: Thomas Goirand <zigo@debian.org>
DESC="OpenStack Cyborg agent"

# project_name: OpenStack project name; used for directories, config paths, and system user/group
PROJECT_NAME={{ project_name | default('cyborg') }}

# NAME: The base name for the service process (derived from project_name)
NAME=${PROJECT_NAME}-agent

# rabbitmq_process_name: Process name for RabbitMQ messaging; must match expected value in OpenStack config
# This environment variable is used by the oslo.messaging library to identify the process in RabbitMQ
export OS_OSLO_MESSAGING_RABBIT__PROCESSNAME={{ rabbitmq_process_name | default('cyborg-agent') }}