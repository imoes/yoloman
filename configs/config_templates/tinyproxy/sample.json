{
  "listen_ip": "127.0.0.1",
  "port": 8888,
  "hostname": "",
  "log_level": "Info",
  "log_file": "/var/log/tinyproxy/tinyproxy.log",
  "max_clients": 100,
  "min_spare_servers": 2,
  "max_spare_servers": 8,
  "start_servers": 4,
  "timeout": 600,
  "reverse_proxy": false,
  "transparent": false,
  "access_rules": [
    {
      "type": "allow",
      "source": "10.0.0.0/24"
    },
    {
      "type": "allow",
      "source": "192.168.1.0/24"
    },
    {
      "type": "deny",
      "source": "all"
    }
  ],
  "auth_enabled": true,
  "upstream_proxies": [],
  "no_proxy": [
    "localhost",
    "127.0.0.1",
    ".local"
  ],
  "user_agent": "",
  "hide_info_header": true,
  "filter_ports": true,
  "filtered_port_range": "1-65535",
  "ssl_support": false,
  "ssl_port": 8889,
  "ssl_cert": "/etc/tinyproxy/cert.pem"
}
