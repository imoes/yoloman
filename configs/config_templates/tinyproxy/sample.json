{
  "listen_ip": "127.0.0.1",
  "port": 8888,
  "hostname": "",
  "log_level": "Info",
  "log_file": "/var/log/tinyproxy/tinyproxy.log",
  "max_clients": 100,
  "min_spare_servers": 1,
  "max_spare_servers": 5,
  "start_servers": 3,
  "timeout": 600,
  "reverse_proxy": false,
  "transparent": false,
  "access_rules": [
    {
      "type": "allow",
      "source": "127.0.0.1"
    },
    {
      "type": "deny",
      "source": "all"
    }
  ],
  "auth_enabled": false,
  "upstream_proxies": [],
  "no_proxy": [
    "localhost",
    "127.0.0.1"
  ],
  "user_agent": ""
}
