### tinyproxy defaults

# Edit to configure alternate config file...
#
# If running under systemd, please make sure to uncomment
# both variables below!

# config: configuration file tinyproxy is started with (CONFIG, passed as -c). Unset = commented as shipped.
{% if config is defined and config is not none and config | length > 0 %}CONFIG="{{ config }}"
FLAGS="-c $CONFIG"
{% else %}#CONFIG="/etc/tinyproxy/tinyproxy.conf"
#FLAGS="-c $CONFIG"
{% endif %}

# Add more command line options, as desired...

# extra_flags: further tinyproxy command-line options appended to FLAGS (e.g. -d). Unset = commented as shipped.
{% if extra_flags is defined and extra_flags is not none and extra_flags | length > 0 %}FLAGS="$FLAGS {{ extra_flags }}"
{% else %}#FLAGS="$FLAGS ..."
{% endif %}
