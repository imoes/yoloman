# Configuration for rpc.rusersd (rusersd)
#
# This file configures the rpc.rusersd daemon, which provides
# remote user and load information over RPC (portmapper/udp).
#
# IMPORTANT: rusersd relies on the portmapper (rpcbind). Ensure
# rpcbind is running and the rusersd service is registered with it.

# rusersd_bind_address: List of IP addresses to bind the service to.
# Empty list binds to all interfaces (0.0.0.0).
# Entries are strings in IPv4 format.
# Format: Comma-separated list of IPs.
bind_address={{ (rusersd_bind_address | default([])) | join(',') }}

# rusersd_debug: Enable verbose logging for troubleshooting.
# Default is false.
# Format: Boolean (true/false).
debug={{ rusersd_debug | default(false) | lower }}