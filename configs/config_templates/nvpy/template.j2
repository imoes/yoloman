# NVPy Configuration File
# Generated by Ansible Jinja2 engine

[DEFAULT]
# Path to the local Simplenote cache directory where notes and metadata are stored locally.
config_dir = {{ config_dir|default('/home/npycache') }}

[server]
# The base URL of the Simplenote API server to connect to.
server_url = {{ server_url|default('https://simplenote.com/api/v1') }}

[authentication]
# Simplenote account username used for authentication.
username = {{ username|default('') }}
# Simplenote account password or API key used for authentication.
password = {{ password|default('') }}

[app]
# Whether to automatically sync notes with the Simplenote server in the background.
auto_sync = {{ auto_sync|default(true) }}
# The number of seconds to wait between automatic syncs when auto_sync is enabled.
sync_interval = {{ sync_interval|default(60) }}
# Whether to render and display markdown syntax in the note viewer.
markdown_enabled = {{ markdown_enabled|default(false) }}
# A list of specific tag names to filter which notes are displayed. If empty, all notes are shown.
tags_to_show = {{ tags_to_show|default([])|join(',') }}