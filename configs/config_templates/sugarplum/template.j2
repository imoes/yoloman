# Apache configuration for the Sugarplum application.
# This file configures the ScriptAlias directives and URL rewriting rules
# required to serve Sugarplum's CGI scripts via the web server.

# ==============================================================================
# Include file for hostile agents configuration.
# This file typically contains rules to block or handle malicious user agents.
# Do not place anything between this Include directive and the following
# RewriteCond directives, as it may break the configuration parsing.
# ==============================================================================
Include /usr/share/sugarplum/apache-hostile-agents.conf

# ==============================================================================
# URL Rewriting Rules
# These rules ensure that requests to the script alias path are correctly
# proxied to the CGI visions module.
# ==============================================================================

# RewriteCond: Skip rewriting if the request URI does not start with the
# script alias path. This prevents unnecessary processing for other URLs.
# Variable: script_alias_path
RewriteCond %{REQUEST_URI} !^/{{ (script_alias_path | default('sugarplum')) }}/{{ (script_alias_path | default('sugarplum')) }}

# RewriteRule: Redirect any request matching the pattern to the 'visions'
# endpoint within the script alias path, preserving the path info ([PT] flag
# passes the request to the next handler, typically CGI).
# Variables: script_alias_path
RewriteRule .* /{{ (script_alias_path | default('sugarplum')) }}/{{ (script_alias_path | default('sugarplum')) }}/visions [PT]

# ==============================================================================
# CGI Alias Configuration
# Maps a URL path to the filesystem directory containing the CGI scripts.
# ==============================================================================

# ScriptAlias: Defines the base URL path (/script_alias_path/) that maps
# to the CGI scripts directory (script_alias_cgi_root/poison/).
#
# Variables:
#   - script_alias_path: The URL prefix (e.g., 'sugarplum').
#   - script_alias_cgi_root: The absolute path to the CGI binary directory
#                            (e.g., '/usr/lib/cgi-bin/sugarplum').
#
# Example output:
# ScriptAlias /sugarplum/ /usr/lib/cgi-bin/sugarplum/poison/
#
ScriptAlias /{{ (script_alias_path | default('sugarplum')) }}/ {{ (script_alias_cgi_root | default('/usr/lib/cgi-bin/sugarplum')) }}/poison/
