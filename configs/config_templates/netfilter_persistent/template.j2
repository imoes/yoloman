# Netfilter IPv4 rules — loaded at boot by netfilter-persistent
# Do not edit this file directly; it is regenerated by `iptables-persistent`
# Use /etc/iptables/rules.v4.d/* or `iptables-apply` for safe updates
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
{% for rule in rules %}{{ rule | replace('#', '# ') }}
{% endfor %}
COMMIT
