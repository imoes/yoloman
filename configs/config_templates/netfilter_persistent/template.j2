# ==============================================================================
# Netfilter IPv4 iptables rules
# ==============================================================================
#
# This file defines the IPv4 packet filtering rules for the system.
# It is loaded at boot by the `netfilter-persistent` service.
#
# NOTE: Do not edit this file directly; it is regenerated by `iptables-persistent`.
# To manage custom rules, place them in `/etc/iptables/rules.v4.d/*` or use
# `iptables-apply` for safe, temporary updates.
#
# The rules are generated from the `rules` variable provided by Ansible.
# ==============================================================================

*filter

# Default policies:
# INPUT   - Accept packets unless explicitly dropped by a rule below.
# FORWARD - Accept forwarded packets (no NAT/routing rules defined here).
# OUTPUT  - Accept all outgoing packets from the local system.
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

# --------------------------------------------------------------------------
# User-defined rules
# --------------------------------------------------------------------------
# Each line in the `rules` list is emitted as a raw iptables command fragment.
# Ensure every rule is a valid iptables argument line (e.g., `-A INPUT ...`).
# Comments within rules are preserved but normalized to avoid ambiguity.
{% for rule in (rules | default([])) %}
{{ rule | replace('#', '# ') }}
{% endfor %}

COMMIT