{
  "accounts": [
    {
      "name": "work",
      "host": "imap.gmail.com",
      "port": 993,
      "user": "alice@example.com",
      "pass_cmd": "gpg --quiet --for-your-eyes-only --no-tty --decrypt ~/.authinfo.gpg | awk '/machine imap.gmail.com login alice@example.com/{print $NF}'",
      "ssl_type": "IMAPS",
      "ssl_versions": "TLSv1.2 TLSv1.3",
      "cert_file": "/etc/ssl/certs/ca-certificates.crt",
      "auth_mechs": "LOGIN",
      "timeout": 120,
      "subfolder_style": "Verbatim",
      "local_path": "~/Mail/work/",
      "inbox_path": "~/Mail/work/Inbox",
      "patterns": [
        "*"
      ],
      "create": "Near",
      "expunge": "None",
      "sync_state": "*",
      "sync": "All",
      "max_messages": 0,
      "max_size": 0
    },
    {
      "name": "personal",
      "host": "imap.fastmail.com",
      "port": 993,
      "user": "alice@fastmail.com",
      "pass_cmd": "secret-tool lookup server imap.fastmail.com user alice@fastmail.com",
      "ssl_type": "IMAPS",
      "ssl_versions": "TLSv1.2 TLSv1.3",
      "cert_file": "/etc/ssl/certs/ca-certificates.crt",
      "auth_mechs": "LOGIN",
      "timeout": 120,
      "subfolder_style": "Verbatim",
      "local_path": "~/Mail/personal/",
      "inbox_path": "~/Mail/personal/Inbox",
      "patterns": [
        "INBOX",
        "Sent",
        "Drafts",
        "Trash",
        "Archive",
        "Spam"
      ],
      "create": "Near",
      "expunge": "None",
      "sync_state": "*",
      "sync": "All",
      "max_messages": 5000,
      "max_size": 52428800
    }
  ],
  "group_name": "all"
}
