{
  "commands": [
    {
      "mode": "pair",
      "description": "Compare two strings as byte arrays (default fstrcmp behavior)",
      "args": [
        "example_string_1",
        "example_string_2"
      ]
    },
    {
      "mode": "wide-pair",
      "description": "Compare two multi-byte character strings",
      "args": [
        "caf\u00e9",
        "cafe\u0301"
      ]
    },
    {
      "mode": "files-as-bytes",
      "description": "Compare two files as raw byte arrays",
      "args": [
        "/etc/hosts",
        "/etc/hosts.backup"
      ]
    },
    {
      "mode": "select",
      "description": "Find closest match among alternatives (error correction use case)",
      "args": [
        "rstart",
        "start",
        "stop",
        "restart"
      ]
    }
  ]
}
