{#
  mpich-autoload-redhat
  --------------------
  This template generates a script or environment hook to load the MPICH
  environment module on Red Hat-based systems.

  The `mpi_module_name` variable specifies the exact path or name of the
  environment module to be loaded via the `module` command (usually
  Lmod or Environment Modules).
#}

# Load mpich environment module
# Variable: mpi_module_name
# Description: The module path/name to load for MPICH.
# Example values: 'mpi/mpich-x86_64', 'mpi/openmpi-x86_64'
module load {{ mpi_module_name | default('mpi/mpich-x86_64') }}
