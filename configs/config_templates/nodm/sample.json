{
  "enabled": true,
  "user": "debian",
  "minimum_uid": 1000,
  "xsession": "/usr/bin/startplasma-x11",
  "xserver_options": "-nolisten tcp vt1",
  "initialize_delay": 3,
  "max_startup_time": 10,
  "pid_file": "/run/nodm/nodm.pid",
  "environment": [
    {
      "key": "LANG",
      "value": "en_US.UTF-8"
    },
    {
      "key": "XDG_SESSION_TYPE",
      "value": "x11"
    }
  ]
}
