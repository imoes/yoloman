{
  "enabled": true,
  "user": "alice",
  "minimum_uid": 1000,
  "xsession": "/usr/bin/startplasma-x11",
  "xserver_options": "-nolisten tcp vt7",
  "initialize_delay": 5,
  "max_startup_time": 15,
  "pid_file": "/run/nodm/nodm.pid",
  "environment": [
    {
      "key": "LANG",
      "value": "en_US.UTF-8"
    },
    {
      "key": "XDG_SESSION_TYPE",
      "value": "x11"
    },
    {
      "key": "XDG_CURRENT_DESKTOP",
      "value": "KDE"
    }
  ]
}
