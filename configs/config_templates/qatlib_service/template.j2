# Intel QuickAssist (QAT) library configuration file
# Generated by Ansible Jinja2; edit values via management interface, not this file.
#
# Global settings for QAT device management and service behavior.

[General]
# Whether to start the QAT daemon automatically on boot.
# Default: True
EnableService={{ service_enabled | default(True) | lower }}

# Verbosity of logging: 0 (error) to 4 (trace). Set to 2 (info) for normal operation.
# Default: 2
LogLevel={{ log_level | default(2) }}

# Maximum number of QAT instances (devices) the daemon will manage. Must match hardware capabilities.
# Default: 1
MaxInstances={{ max_instances | default(1) }}

# Timeout (seconds) for device initialization and shutdown. Increase if devices fail to come up reliably.
# Default: 30
DeviceTimeout={{ device_timeout | default(30) }}

# If supported, automatically load firmware to QAT devices at startup. Disable only if firmware is preloaded.
# Default: True
AutoLoadFirmware={{ auto_load_firmware | default(True) | lower }}

# Optional custom path to firmware images. If empty, default locations are used.
# Default: '' (empty)
{% set fw_path = firmware_path | default('') %}
{% if fw_path is defined and fw_path is string and fw_path | trim | length > 0 %}
FirmwarePath={{ fw_path }}
{% else %}
# FirmwarePath=
{% endif %}

# List of PCI devices (in BDF format) to be managed by this daemon. Leave empty to auto-discover all QAT devices.
# Default: [] (empty list)
{% set devs = pci_devices | default([]) %}
{% if devs is defined and devs is iterable and devs | length > 0 %}
# Devices detected for binding:
{% for dev in devs %}
# Device {{ loop.index }}: {{ dev | default('') }}
{% endfor %}
# Comma-separated device list for explicit binding (commented by default)
# DeviceList={{ devs | join(',') }}
{% else %}
# pci_devices is empty; auto-discovery is active.
# To pin specific devices, uncomment and edit the line below with their BDFs.
# DeviceList=0000:af:00.0,0000:af:00.1
{% endif %}

# Per-instance settings (one block per QAT instance)
# Each instance corresponds to a set of work queues and workers.
# Default: list with one typical instance
{% set inst_list = instances | default([{'id': 0, 'type': 'typical', 'num_vfs': 0, 'shm_enabled': False, 'shm_size': 64, 'num_work_queues': 1, 'queue_types': ['sym'], 'worker_affinity': 'auto', 'poll_mode': False, 'max_pending_requests': 256, 'compress_enabled': False}]) %}
{% for inst in inst_list %}
[Instance{{ (inst.id | default(0)) | int }}]
# Instance {{ (inst.id | default(0)) | int }}: type and worker configuration.
# Default type: 'typical'
InstanceType={{ (inst.type | default('typical')) | string }}

# Number of virtual functions (VFs) to allocate for this instance
# Default: 0 (no VFs created)
NumVFs={{ inst.num_vfs | default(0) | int }}

# Enable shared memory interface (SHM) for inter-process communication
# Default: False
ShmEnabled={{ inst.shm_enabled | default(False) | lower }}

# Shared memory region size (in MB)
# Default: 64
ShmSize={{ inst.shm_size | default(64) | int }}

# Number of work queues of this type
# Default: 1
NumWorkQueues={{ inst.num_work_queues | default(1) | int }}

# Queue type(s) — comma-separated list: sym, asym, deflate, compress, dsa, etc.
# Default: ['sym']
QueueTypes={{ inst.queue_types | default(['sym']) | join(', ') }}

# Affinity mask (CPU core(s) to bind workers, hex format or 'auto')
# Default: 'auto'
WorkerAffinity={{ inst.worker_affinity | default('auto') }}

# Enable polling mode (true) vs interrupt mode (false)
# Default: False
PollMode={{ inst.poll_mode | default(False) | lower }}

# Maximum number of pending requests per work queue
# Default: 256
MaxPendingRequests={{ inst.max_pending_requests | default(256) | int }}

# Enable compression acceleration (for compress/deflate queues)
# Default: False
CompressEnabled={{ inst.compress_enabled | default(False) | lower }}

{% endfor %}

# Optional: Advanced device-specific tuning (uncomment & customize as needed)
#[Device0]
#DeviceId=0
#PfBarOffset=0
#VfBarOffset=0
#PfBarSize=0x1000000
#VfBarSize=0x1000000