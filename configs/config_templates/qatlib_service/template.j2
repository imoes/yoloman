# Intel QuickAssist (QAT) library configuration file
# Generated by Jinja2; edit values via management interface, not this file.
# Global settings for QAT device management and service behavior.

[General]
# Enable or disable the QAT service at boot.
EnableService={{ service_enabled }}

# Log level: 0=error, 1=warn, 2=info, 3=debug, 4=trace
LogLevel={{ log_level }}

# Maximum number of QAT instances (devices) to manage
MaxInstances={{ max_instances }}

# Timeout (seconds) for device initialization and shutdown
DeviceTimeout={{ device_timeout }}

# Enable or disable firmware auto-upload (if supported by device)
AutoLoadFirmware={{ auto_load_firmware }}

# Path to firmware image(s) — optional; leave empty to use defaults
{% if firmware_path is not none %}FirmwarePath={{ firmware_path }}
{% else %}# FirmwarePath=
{% endif %}

# List of PCI devices to manage (BDF format: domain:bus:device.function)
{% for dev in pci_devices %}# Device {{ loop.index }}: {{ dev.domain }}:{{ dev.bus }}:{{ dev.slot }}.{{ dev.func }}
{% endfor %}

# Explicit device list (commented by default; use only if needed)
# DeviceList={{ pci_devices | map(attribute='bdf') | join(',') if pci_devices else '' }}

# Per-instance settings (one block per QAT instance)
{% for inst in instances %}[Instance{{ inst.id }}]
# Instance {{ inst.id }}: type and worker configuration.
InstanceType={{ inst.type }}

# Number of virtual functions (VFs) to allocate for this instance
NumVFs={{ inst.num_vfs }}

# Enable shared memory interface (SHM) for inter-process communication
ShmEnabled={{ inst.shm_enabled }}

# Shared memory region size (in MB)
ShmSize={{ inst.shm_size }}

# Number of work queues of this type
NumWorkQueues={{ inst.num_work_queues }}

# Queue type(s) — comma-separated list: sym, asym, deflate, compress, dsa, etc.
QueueTypes={{ inst.queue_types | join(', ') }}

# Affinity mask (CPU core(s) to bind workers, hex format or 'auto')
WorkerAffinity={{ inst.worker_affinity }}

# Enable polling mode (true) vs interrupt mode (false)
PollMode={{ inst.poll_mode }}

# Maximum number of pending requests per work queue
MaxPendingRequests={{ inst.max_pending_requests }}

# Enable compression acceleration (for compress/deflate queues)
CompressEnabled={{ inst.compress_enabled }}

{% endfor %}

# Optional: Advanced device-specific tuning (uncomment & customize as needed)
#[Device0]
#DeviceId=0
#PfBarOffset=0
#VfBarOffset=0
#PfBarSize=0x1000000
#VfBarSize=0x1000
