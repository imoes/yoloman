{
  "forwarding_rules": [
    {
      "comment": "Forward external HTTP to internal web server",
      "protocol": "tcp",
      "bind_addr": "0.0.0.0",
      "bind_port": 80,
      "connect_addr": "192.168.1.10",
      "connect_port": 8080
    },
    {
      "comment": "Expose internal SSH on a public port",
      "protocol": "tcp",
      "bind_addr": "*",
      "bind_port": 2222,
      "connect_addr": "127.0.0.1",
      "connect_port": 22
    },
    {
      "comment": "Forward DNS queries to upstream resolver",
      "protocol": "udp",
      "bind_addr": "192.168.0.1",
      "bind_port": 53,
      "connect_addr": "8.8.8.8",
      "connect_port": 53
    }
  ]
}
