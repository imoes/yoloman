# fping configuration template
# This file is generated by Ansible. It defines the targets and options for the fping utility.
# fping is typically invoked as: fping -f <targets_file> [options]
# or piped targets: cat <targets_file> | fping [options]

# targets_file: Path to file containing one target per line (use with -f; only allowed for root).
# If empty, use targets_list or stdin.
# Note: In this template, we prioritize targets_list for dynamic inventory,
# but if targets_file is explicitly set, it usually implies an external file path.
# Since fping reads files directly, this config serves as a manifest for Ansible
# to either write the file or pipe the content. Here we generate the content
# as if it were the stdin/file content, respecting the schema.

{% if targets_file | default('') %}
# NOTE: targets_file is set to "{{ targets_file }}".
# In a real deployment, you would likely write targets_list to this file
# on the remote host, or pass it via stdin. This template generates
# the target list content below which should correspond to that file.
{% endif %}

# targets_list: List of targets (hostnames or IPs) to ping.
# Ignored if targets_file is set (since file usage is preferred for large lists),
# but here we render it for the service configuration context.
{% set current_targets = targets_list | default([]) %}
{% if current_targets | length > 0 %}
# Targets to ping (one per line):
{% for target in current_targets %}{{ target }}
{% endfor %}
{% else %}
# No targets defined in targets_list.
# Ensure targets_file is set or targets are piped via stdin.
{% endif %}

# options: List of command-line options (e.g., ['-a', '-q', '-g 192.168.1.0/24']).
# Each item must be a single shell token or quoted phrase safe for command execution.
# These are appended to the fping command invocation.
{% set current_options = options | default([]) %}
{% if current_options | length > 0 %}
# Command-line options:
{% for opt in current_options %}{{ opt }}
{% endfor %}
{% else %}
# No additional options specified.
{% endif %}