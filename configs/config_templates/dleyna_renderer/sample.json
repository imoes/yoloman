{
  "log_level": "info",
  "max_transfers": 5,
  "dbus_timeout": 30,
  "verbose": false,
  "interfaces": [
    "eth0"
  ],
  "supported_protocols": [
    {
      "protocol": "http-get",
      "mime_type": "audio/*,video/*,image/*"
    },
    {
      "protocol": "rtsp-rtp-udp",
      "mime_type": "*"
    },
    {
      "protocol": "liveserver",
      "mime_type": "video/*"
    }
  ],
  "enable_external": true,
  "friendly_name": "Office DLNA Speaker",
  "location_url": "http://192.168.1.50:9790"
}
