# Limnoria bot configuration file
# Generated by Ansible Jinja2 template engine
#
# This file configures the Limnoria IRC bot. It uses an INI-style format
# with sections [general], [supybot], [supybot.databases], [plugins],
# [networks], and [users].

[general]

# The nickname the bot uses on IRC networks.
# Default: limnoria-bot
nick = {{ nick | default('limnoria-bot') }}

# The full username (ident) the bot presents to servers.
# Default: limnoria
user = {{ user | default('limnoria') }}

# The ident string sent during IRC connection.
# Default: limnoria
ident = {{ ident | default('limnoria') }}

# Whether the bot should daemonize itself.
# Set to False if managed by systemd (recommended).
# Default: false
runasdaemon = {{ runasdaemon | default(false) }}

# Enable extra debugging logs.
# Useful for troubleshooting connection or plugin issues.
# Default: false
debug = {{ debug | default(false) }}

# Whether to allow users to have owner capabilities by default.
# SECURITY RISK: Setting this to true allows any user to become owner.
# Default: false
allow_default_owner = {{ allow_default_owner | default(false) }}

# Whether to allow the bot to run as root.
# SECURITY RISK: The bot should run as an unprivileged user.
# Default: false
allow_root = {{ allow_root | default(false) }}

[supybot]

# List of default capabilities for new users.
# '-owner' grants full administrative rights.
# Default: ['-owner']
capabilities = {{ capabilities | default(['-owner']) | join(', ') }}

[supybot.databases]

# List of database names to load.
# Common databases include 'users', 'config', etc.
# Default: ['users']
databases = {{ databases | default(['users']) | join(', ') }}

[plugins]

# List of plugin names to load.
# Example: 'Bot' is essential for basic functionality.
# Default: ['Bot']
plugins = {{ plugins | default(['Bot']) | join(', ') }}

[networks]

# Configuration for IRC networks to connect to.
{% for network in networks | default([]) %}

# Network section header: {{ (network | default({})).name | default('freenode') }}
[{{ (network | default({})).name | default('freenode') }}]

# The hostname of the IRC server.
# Default: irc.libera.chat
host = {{ (network | default({})).host | default('irc.libera.chat') }}

# The port of the IRC server (usually 6697 for SSL).
# Default: 6697
port = {{ (network | default({})).port | default(6697) }}

# Whether to use SSL for the connection.
# Default: true
ssl = {{ (network | default({})).ssl | default(true) }}

# Password for the network (e.g., SASL or registered nick).
# Default: ''
password = {{ (network | default({})).password | default('') }}

# List of channels to join.
# Default: ['#limnoria']
channels = {{ (network | default({})).channels | default(['#limnoria']) | join(', ') }}
{% endfor %}

[users]

# Users who should be granted specific capabilities.
# Structure: [username] with hostmask and capabilities.
{% for user_entry in users | default([]) %}

# User section header: {{ (user_entry | default({})).name | default('admin') }}
[{{ (user_entry | default({})).name | default('admin') }}]

# The hostmask pattern for the user (e.g., user!ident@host).
# Default: admin!*@*
hostmask = {{ (user_entry | default({})).hostmask | default('admin!*@*') }}

# Capabilities granted to this user (e.g., '-owner', '+admin').
# Default: ['-owner']
capabilities = {{ (user_entry | default({})).capabilities | default(['-owner']) | join(', ') }}
{% endfor %}