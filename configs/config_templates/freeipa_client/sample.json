{
  "realm_domain": "example.com",
  "realm_name": "EXAMPLE",
  "server_hostnames": [
    "ipa1.example.com",
    "ipa2.example.com"
  ],
  "dns_discovery": true,
  "ssl_verify": true,
  "ca_cert_path": "/etc/ipa/ca.crt",
  "ssh_key_algorithm": "ssh-rsa,ssh-ed25519",
  "update_dns": false,
  "sssd_enabled": true,
  "nss_enabled": true,
  "sudo_enabled": true,
  "autofs_enabled": false,
  "ccache_enabled": true,
  "ccache_type": "KEYRING:",
  "krb5_use_kdcinfo": true,
  "ipv6_enabled": true,
  "connect_timeout": 15,
  "verbose_logging": false,
  "enroll_keytab": true,
  "ssh_enroll_enabled": true,
  "advertised_hostname": ""
}
