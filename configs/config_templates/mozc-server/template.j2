# vim:syntax=apparmor
# Profile abstraction for allowing mozc to run in including guest session
# Author: Aron Xu <happyaron@ubuntu.com>

# Requires apparmor 2.9

# Controls the Unix socket path prefix for Mozc input method communication.
# Defines the directory where the Mozc socket files are created (e.g., @/tmp/.mozc.*).
# Default: tmp
  unix (bind, listen) type=stream addr="@{% raw %}{{{% endraw %} mozc_socket_prefix | default('tmp') | trim | replace('.', '\\.') }}{% raw %}}{% endraw %}/.mozc.*",
