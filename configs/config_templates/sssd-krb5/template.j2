# sssd-krb5 configuration snippet
# This file is intended to be placed in a directory included by the main Kerberos configuration
# (/etc/krb5.conf). It provides a mechanism to include additional Kerberos configuration
# snippets from a specified directory, allowing for modular and organized configuration
# management without editing the main krb5.conf file.

# includedir: Directory containing Kerberos configuration snippets included by this file.
# Default: /var/lib/sss/pubconf/krb5.include.d/
# This directive tells the Kerberos libraries to read all files in the specified directory
# and merge them into the main configuration context.
includedir {{ includedir | default('/var/lib/sss/pubconf/krb5.include.d/') }}