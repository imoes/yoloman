# =============================================================================
# Wit Configuration Template
# =============================================================================
# This template generates the configuration file for 'wit' (Wii Image Tool).
# It controls global behavior (output format, verbosity) and file system paths
# for storing Wii/GameCube game images in ISO, WBFS, or WDF formats.
#
# Self-documenting: every directive is preceded by a comment describing its
# schema default and purpose. All variables use | default(D) to ensure the
# template renders safely even if the variable is undefined in the playbook.
# =============================================================================

[global]

# output_format: The default output format for wit tools.
# Options typically include 'iso', 'wbfs', or 'wdf'.
# Default: 'iso'
output_format = "{{ output_format | default('iso') }}"

# compression: The compression level used for wdf containers.
# Range is 0 (no compression) to 9 (maximum compression).
# Default: 5
compression = {{ compression | default(5) }}

# verbose: Enable verbose logging output for debugging and troubleshooting.
# Default: False
verbose = {{ verbose | default(False) }}

# default_image: Path to a default ISO or WBFS image to use when no file is
# specified in the command arguments. If empty, the user must provide a path.
# Default: "" (empty string)
default_image = "{{ default_image | default('') }}"

[paths]

# game_directory: The default directory where Wii and GameCube game images are stored.
# Default: "/var/lib/wit/games"
game_directory = "{{ game_directory | default('/var/lib/wit/games') }}"

# wbfs_directory: The default directory where WBFS container files are stored.
# Default: "/var/lib/wit/wbfs"
wbfs_directory = "{{ wbfs_directory | default('/var/lib/wit/wbfs') }}"