{
  "lvm_vg": "vg00",
  "paths_yaml_config_path": "/etc/lxctl",
  "paths_lxc_conf_dir": "/var/lib/lxc",
  "paths_root_mount_path": "/var/lib/lxctl/root",
  "paths_template_path": "/var/lib/lxctl/templates",
  "paths_lxc_log_path": "/var/log/lxc.log",
  "paths_lxc_log_level": "DEBUG",
  "check_skip_kernel_config_check": 1,
  "rsync_rsync_opts": "-aH --delete --numeric-ids --exclude 'proc/*' --exclude 'sys/*' -e ssh",
  "root_root_size": "50G",
  "root_root_type": "lvm",
  "fs_fs": "ext4",
  "fs_fs_opts": "-b 4096",
  "fs_fs_mount_opts": "defaults,barrier=0",
  "os_os_template": "ubuntu-10.04-amd64",
  "set_searchdomain": "ru",
  "set_ifname": "ip",
  "list_columns": "name,disk_free_mb,status,ip,hostname"
}
