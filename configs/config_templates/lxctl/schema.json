{
  "lvm_vg": {
    "type": "string",
    "default": "vg00",
    "description": "Volume Group name for LVM storage."
  },
  "paths_yaml_config_path": {
    "type": "string",
    "default": "/etc/lxctl",
    "description": "Path to the YAML configuration directory."
  },
  "paths_lxc_conf_dir": {
    "type": "string",
    "default": "/var/lib/lxc",
    "description": "Directory where LXC container configurations are stored."
  },
  "paths_root_mount_path": {
    "type": "string",
    "default": "/var/lib/lxctl/root",
    "description": "Mount path for root filesystems."
  },
  "paths_template_path": {
    "type": "string",
    "default": "/var/lib/lxctl/templates",
    "description": "Path to OS templates."
  },
  "paths_lxc_log_path": {
    "type": "string",
    "default": "/var/log/lxc.log",
    "description": "Path to the LXC log file."
  },
  "paths_lxc_log_level": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for LXC operations."
  },
  "check_skip_kernel_config_check": {
    "type": "number",
    "default": 1,
    "description": "Skip kernel configuration check (1=true, 0=false)."
  },
  "rsync_rsync_opts": {
    "type": "string",
    "default": "-aH --delete --numeric-ids --exclude 'proc/*' --exclude 'sys/*' -e ssh",
    "description": "Options passed to rsync for container transfers."
  },
  "root_root_size": {
    "type": "string",
    "default": "50G",
    "description": "Size of the root filesystem (e.g., 50G, 10G)."
  },
  "root_root_type": {
    "type": "string",
    "default": "lvm",
    "description": "Type of root filesystem storage (e.g., lvm, dir)."
  },
  "fs_fs": {
    "type": "string",
    "default": "ext4",
    "description": "Filesystem type to use (e.g., ext4, xfs)."
  },
  "fs_fs_opts": {
    "type": "string",
    "default": "-b 4096",
    "description": "Options for filesystem creation."
  },
  "fs_fs_mount_opts": {
    "type": "string",
    "default": "defaults,barrier=0",
    "description": "Mount options for the filesystem."
  },
  "os_os_template": {
    "type": "string",
    "default": "ubuntu-10.04-amd64",
    "description": "Default OS template name."
  },
  "set_searchdomain": {
    "type": "string",
    "default": "ru",
    "description": "Search domain for network configuration."
  },
  "set_ifname": {
    "type": "string",
    "default": "ip",
    "description": "Interface name or command used for network setup."
  },
  "list_columns": {
    "type": "string",
    "default": "name,disk_free_mb,status,ip,hostname",
    "description": "Comma-separated list of columns for list output."
  }
}
