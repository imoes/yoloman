[
  {
    # DSA device identifier. Used to target the specific DSA (Data Streaming Accelerator) device.
    "dev":"{{ dsa_device | default('dsa0') }}",
    # Read buffer limit. 0 means default/automatic.
    "read_buffer_limit":0,
    # List of device groups associated with this DSA device.
    "groups":[
      {
        # First group device identifier (e.g., group0.0).
        "dev":"{{ group0_dev | default('group0.0') }}",
        # List of workqueues belonging to this group.
        "grouped_workqueues":[
          {
            # First workqueue device identifier (e.g., wq0.0).
            "dev":"{{ wq0_0_dev | default('wq0.0') }}",
            # Workqueue mode. 'shared' allows multiple processes to use the workqueue.
            "mode":"shared",
            # Workqueue size (number of descriptors). Determines capacity for pending operations.
            "size":"{{ wq0_0_size | default(8) }}",
            # Workqueue group ID. Must match the group this workqueue belongs to.
            "group_id":"{{ wq0_0_group_id | default(0) }}",
            # Workqueue priority. Higher values generally indicate higher priority.
            "priority":"{{ wq0_0_priority | default(10) }}",
            # Block on fault. 0=disabled, 1=enabled. Controls behavior on hardware faults.
            "block_on_fault":"{{ wq0_0_block_on_fault | default(0) }}",
            # Maximum batch size. Limits the number of descriptors per batch request.
            "max_batch_size":"{{ wq0_0_max_batch_size | default(32) }}",
            # Maximum transfer size in bytes. Limits the size of individual data transfers.
            "max_transfer_size":"{{ wq0_0_max_transfer_size | default(16384) }}",
            # Workqueue type. 'user' indicates a user-space accessible workqueue.
            "type":"{{ wq0_0_type | default('user') }}",
            # Driver name for the workqueue. Identifies the kernel driver managing this queue.
            "driver_name":"{{ wq0_0_driver_name | default('user') }}",
            # Workqueue name. A human-readable label for this workqueue.
            "name":"{{ wq0_0_name | default('app1') }}",
            # Workqueue threshold. Determines when work is submitted or processed.
            "threshold":"{{ wq0_0_threshold | default(6) }}"
          }
        ],
        # List of engines belonging to this group.
        "grouped_engines":[
          {
            # First engine device identifier (e.g., engine0.0).
            "dev":"{{ engine0_0_dev | default('engine0.0') }}",
            # Engine group ID. Must match the group this engine belongs to.
            "group_id":"{{ engine0_0_group_id | default(0) }}"
          }
        ]
      },
      {
        # Second group device identifier (e.g., group0.1).
        "dev":"{{ group0_1_dev | default('group0.1') }}",
        # List of workqueues belonging to this second group.
        "grouped_workqueues":[
          {
            # Second workqueue device identifier (e.g., wq0.1).
            "dev":"{{ wq0_1_dev | default('wq0.1') }}",
            # Workqueue mode. 'shared' allows multiple processes to use the workqueue.
            "mode":"shared",
            # Workqueue size (number of descriptors). Determines capacity for pending operations.
            "size":"{{ wq0_1_size | default(32) }}",
            # Workqueue group ID. Must match the group this workqueue belongs to.
            "group_id":"{{ wq0_1_group_id | default(1) }}",
            # Workqueue priority. Higher values generally indicate higher priority.
            "priority":"{{ wq0_1_priority | default(10) }}",
            # Block on fault. 0=disabled, 1=enabled. Controls behavior on hardware faults.
            "block_on_fault":"{{ wq0_1_block_on_fault | default(0) }}",
            # Maximum batch size. Limits the number of descriptors per batch request.
            "max_batch_size":"{{ wq0_1_max_batch_size | default(32) }}",
            # Maximum transfer size in bytes. Limits the size of individual data transfers.
            "max_transfer_size":"{{ wq0_1_max_transfer_size | default(2097152) }}",
            # Workqueue type. 'user' indicates a user-space accessible workqueue.
            "type":"{{ wq0_1_type | default('user') }}",
            # Driver name for the workqueue. Identifies the kernel driver managing this queue.
            "driver_name":"{{ wq0_1_driver_name | default('user') }}",
            # Workqueue name. A human-readable label for this workqueue.
            "name":"{{ wq0_1_name | default('app2') }}",
            # Workqueue threshold. Determines when work is submitted or processed.
            "threshold":"{{ wq0_1_threshold | default(28) }}"
          }
        ],
        # List of engines belonging to this second group.
        "grouped_engines":[
          {
            # Second engine device identifier (e.g., engine0.1).
            "dev":"{{ engine0_1_dev | default('engine0.1') }}",
            # Engine group ID. Must match the group this engine belongs to.
            "group_id":"{{ engine0_1_group_id | default(1) }}"
          }
        ]
      }
    ]
  }
]
