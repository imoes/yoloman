# accel-config configuration file (JSON format)
# Generated by Ansible. Do not edit manually.
# This file configures Intel DSA (Data Streaming Accelerator) devices, workqueues, and engines.
[
  {
    # DSA device identifier
    "dev": "{{ dsa_device | default('dsa0') }}",
    # Read buffer limit (0 = default)
    "read_buffer_limit": {{ read_buffer_limit | default(0) }},
    # List of device groups
    "groups": [
      {
        # First group device identifier
        "dev": "{{ group0_dev | default('group0.0') }}",
        # Grouped workqueues configuration
        "grouped_workqueues": [
          {
            # First workqueue device identifier
            "dev": "{{ wq0_0_dev | default('wq0.0') }}",
            # Workqueue mode (shared)
            "mode": "shared",
            # Workqueue size (number of descriptors)
            "size": {{ wq0_0_size | default(8) }},
            # Workqueue group ID
            "group_id": {{ wq0_0_group_id | default(0) }},
            # Workqueue priority
            "priority": {{ wq0_0_priority | default(10) }},
            # Block on fault (0=disabled, 1=enabled)
            "block_on_fault": {{ wq0_0_block_on_fault | default(0) }},
            # Maximum batch size
            "max_batch_size": {{ wq0_0_max_batch_size | default(32) }},
            # Maximum transfer size in bytes
            "max_transfer_size": {{ wq0_0_max_transfer_size | default(16384) }},
            # Workqueue type
            "type": "{{ wq0_0_type | default('user') }}",
            # Driver name for the workqueue
            "driver_name": "{{ wq0_0_driver_name | default('user') }}",
            # Workqueue name
            "name": "{{ wq0_0_name | default('app1') }}",
            # Workqueue threshold
            "threshold": {{ wq0_0_threshold | default(6) }}
          }
        ],
        # Grouped engines configuration
        "grouped_engines": [
          {
            # First engine device identifier
            "dev": "{{ engine0_0_dev | default('engine0.0') }}",
            # Engine group ID
            "group_id": {{ engine0_0_group_id | default(0) }}
          }
        ]
      },
      {
        # Second group device identifier
        "dev": "{{ group0_1_dev | default('group0.1') }}",
        # Grouped workqueues configuration
        "grouped_workqueues": [
          {
            # Second workqueue device identifier
            "dev": "{{ wq0_1_dev | default('wq0.1') }}",
            # Workqueue mode (shared)
            "mode": "shared",
            # Workqueue size (number of descriptors)
            "size": {{ wq0_1_size | default(32) }},
            # Workqueue group ID
            "group_id": {{ wq0_1_group_id | default(1) }},
            # Workqueue priority
            "priority": {{ wq0_1_priority | default(10) }},
            # Block on fault (0=disabled, 1=enabled)
            "block_on_fault": {{ wq0_1_block_on_fault | default(0) }},
            # Maximum batch size
            "max_batch_size": {{ wq0_1_max_batch_size | default(32) }},
            # Maximum transfer size in bytes
            "max_transfer_size": {{ wq0_1_max_transfer_size | default(2097152) }},
            # Workqueue type
            "type": "{{ wq0_1_type | default('user') }}",
            # Driver name for the workqueue
            "driver_name": "{{ wq0_1_driver_name | default('user') }}",
            # Workqueue name
            "name": "{{ wq0_1_name | default('app2') }}",
            # Workqueue threshold
            "threshold": {{ wq0_1_threshold | default(28) }}
          }
        ],
        # Grouped engines configuration
        "grouped_engines": [
          {
            # Second engine device identifier
            "dev": "{{ engine0_1_dev | default('engine0.1') }}",
            # Engine group ID
            "group_id": {{ engine0_1_group_id | default(1) }}
          }
        ]
      }
    ]
  }
]