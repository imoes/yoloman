# ==============================================================================
# diod (RBD iSCSI Gateway) Configuration Template
# ==============================================================================
# This template configures the default settings for the diod service.
# It is self-documenting: every variable is sourced from the schema with
# explicit defaults, and every directive is commented with its purpose.
# ==============================================================================

# ------------------------------------------------------------------------------
# Enable diod at startup
# Schema Field: diod_enable (boolean)
# Default: false
# Description: Whether to enable the diod server at startup.
# ------------------------------------------------------------------------------
DIOD_ENABLE={{ diod_enable | default(false) | lower }}

# ------------------------------------------------------------------------------
# Additional daemon arguments
# Schema Field: daemon_args (string)
# Default: '' (empty string)
# Description: Additional options passed to the diod daemon.
# ------------------------------------------------------------------------------
DAEMON_ARGS="{{ daemon_args | default('') }}"