# ==============================================================================
# Debian-Edu FAI (Fully Automated Installation) Configuration
# ==============================================================================
# This file contains shell variables for the 'debian-edu-fai_install' script.
# It is self-documenting: each variable is preceded by a comment explaining its
# purpose and default value. Variables are safe to use; if undefined in the
# Ansible play, sensible defaults are applied.
# ==============================================================================

# --- FAI Savelog Configuration ---
# These settings enable pushing installation logs from client machines to the
# FAI server after installation completes. Requires prior SSH key setup on the
# FAI server user account (see schema description for manual steps).

# FQDN of the FAI server for savelog feature.
# Default: The hostname of the FAI server itself (via $(hostname -f)).
# If undefined, this line is commented out, disabling remote savelog.
{% if fai_logserver is defined and fai_logserver is not none and (fai_logserver is number or fai_logserver is boolean or fai_logserver | length > 0) %}fai_logserver="{{ fai_logserver | default(omit) }}"
{% else %}# fai_logserver="$(hostname -f)"
{% endif %}

# System user on the FAI server for savelog operations.
# Default: 'fai'
# If undefined, this line is commented out.
{% if fai_loguser is defined and fai_loguser is not none and (fai_loguser is number or fai_loguser is boolean or fai_loguser | length > 0) %}fai_loguser='{{ fai_loguser | default(omit) }}'
{% else %}# fai_loguser='fai'
{% endif %}

# --- APT Mirror and Proxy Configuration ---
# Settings for package installation network access.

# Primary APT mirror URL used for fetching Debian packages.
# Default: http://deb.debian.org/debian
# Note: Can be overridden by apt-cacher-ng proxy below.
{% if mirrorurl is defined and mirrorurl is not none and mirrorurl != '' %}mirrorurl={{ mirrorurl | default(omit) }}
{% else %}# mirrorurl=http://deb.debian.org/debian
{% endif %}

# HTTP proxy for apt-cacher-ng (or similar caching proxy).
# Default: http://10.0.0.1:3142
# If undefined, commented out to allow direct connection to mirrorurl.
{% if http_proxy is defined and http_proxy is not none and http_proxy != '' %}http_proxy={{ http_proxy | default(omit) }}
{% else %}# http_proxy=http://10.0.0.1:3142
{% endif %}

# FTP proxy for apt-cacher-ng.
# Default: http://10.0.0.1:3142
# If undefined, commented out.
{% if ftp_proxy is defined and ftp_proxy is not none and ftp_proxy != '' %}ftp_proxy={{ ftp_proxy | default(omit) }}
{% else %}# ftp_proxy=http://10.0.0.1:3142
{% endif %}

# --- TFTP and Installer Chroot Configuration ---
# Settings controlling the generation of the netboot environment.

# Directory for TFTP configuration files.
# Default: /srv/tftp
# If undefined, commented out (script uses its own default).
{% if tftpdir is defined and tftpdir is not none and (tftpdir is number or tftpdir is boolean or tftpdir | length > 0) %}tftpdir={{ tftpdir | default(omit) }}
{% else %}# tftpdir=/srv/tftp
{% endif %}

# List of Debian codenames (versions) to build installers for.
# Example: "trixie bookworm bullseye"
# Default: Auto-detected from the FAI installer host's Debian version.
# If undefined, commented out.
{% if codenames is defined and codenames is not none and (codenames is number or codenames is boolean or codenames | length > 0) %}codenames="{{ codenames | default(omit) }}"
{% else %}# codenames="trixie bookworm bullseye"
{% endif %}

# Default codename used for the iPXE boot menu entry.
# Default: First name in the 'codenames' list.
# If undefined, commented out.
{% if default_codename is defined and default_codename is not none and (default_codename is number or default_codename is boolean or default_codename | length > 0) %}default_codename="{{ default_codename | default(omit) }}"
{% else %}# default_codename="trixie"
{% endif %}

# Space-separated list of architectures for installer chroots.
# Example: "amd64 i386"
# Default: Auto-detected from the FAI installer host.
# If undefined, commented out.
{% if archs is defined and archs is not none and (archs is number or archs is boolean or archs | length > 0) %}archs="{{ archs | default(omit) }}"
{% else %}# archs="amd64 i386"
{% endif %}

# Default architecture for iPXE boot menu entry.
# Default: First arch in the 'archs' list.
# If undefined, commented out.
{% if default_arch is defined and default_arch is not none and (default_arch is number or default_arch is boolean or default_arch | length > 0) %}default_arch="{{ default_arch | default(omit) }}"
{% else %}# default_arch="i386"
{% endif %}

# --- Installed System Account Configuration ---
# Settings for the root and local user accounts on FAI-installed devices.

# SHA-512 or yescrypt hash of root password.
# Empty or undefined: Uses the host's current root password (not recommended for automation).
# Default: Commented out (use empty string or omit to use host root pw, or provide hash).
{% if rootpw is defined and rootpw is not none and (rootpw is number or rootpw is boolean or rootpw | length > 0) %}rootpw='{{ rootpw | default(omit) }}'
{% else %}# rootpw='<pwhash-for-root-account>'
{% endif %}

# Local username to create in installed systems.
# Empty or undefined: Skips local user creation.
# Default: Commented out (no local user created).
{% if localuser is defined and localuser is not none and (localuser is number or localuser is boolean or localuser | length > 0) %}localuser='{{ localuser | default(omit) }}'
{% else %}# localuser='<localuser>'
{% endif %}

# Password hash for the local user account.
# Only relevant if 'localuser' is set.
# Default: Commented out.
{% if localuserpw is defined and localuserpw is not none and (localuserpw is number or localuserpw is boolean or localuserpw | length > 0) %}localuserpw='{{ localuserpw | default(omit) }}'
{% else %}# localuserpw='<pwhash-for-localuser-account>'
{% endif %}

# --- Network Configuration (WiFi) ---
# Settings for provisioning WiFi on installed devices.

# WiFi ESSID (Network Name) to configure on installed devices.
# Empty or undefined: Skips WiFi configuration.
# Default: Commented out.
{% if wifi_essid is defined and wifi_essid is not none and (wifi_essid is number or wifi_essid is boolean or wifi_essid | length > 0) %}wifi_essid='{{ wifi_essid | default(omit) }}'
{% else %}# wifi_essid='<edu-essid>'
{% endif %}

# WiFi passphrase in cleartext.
# WARNING: Store this securely. Only used if wifi_essid is set.
# Default: Commented out.
{% if wifi_passphrase is defined and wifi_passphrase is not none and (wifi_passphrase is number or wifi_passphrase is boolean or wifi_passphrase | length > 0) %}wifi_passphrase='{{ wifi_passphrase | default(omit) }}'
{% else %}# wifi_passphrase='<edu-wifi-passphrase-in-cleartext-sorry>'
{% endif %}

# --- School Configuration ---
# Short tag/name for the school environment.
# Default: SKOLE
# If undefined, commented out.
{% if school_tag is defined and school_tag is not none and (school_tag is number or school_tag is boolean or school_tag | length > 0) %}school_tag='{{ school_tag | default(omit) }}'
{% else %}# school_tag='SKOLE'
{% endif %}