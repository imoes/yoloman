{
  "fai_logserver": {
    "type": "string",
    "default": "faiserver.localdomain",
    "description": "FQDN of the FAI server for savelog feature"
  },
  "fai_loguser": {
    "type": "string",
    "default": "fai",
    "description": "System user for FAI savelog operations"
  },
  "mirrorurl": {
    "type": "string",
    "default": "http://deb.debian.org/debian",
    "description": "Primary APT mirror URL"
  },
  "mirrorurl_alternative": {
    "type": "string",
    "default": "http://10.0.0.1:3142/debian",
    "description": "Alternative APT mirror via apt-cacher-ng"
  },
  "http_proxy": {
    "type": "string",
    "default": "http://10.0.0.1:3142",
    "description": "HTTP proxy for apt-cacher-ng"
  },
  "ftp_proxy": {
    "type": "string",
    "default": "http://10.0.0.1:3142",
    "description": "FTP proxy for apt-cacher-ng"
  },
  "http_proxy_squid": {
    "type": "string",
    "default": "http://faiserver:8000",
    "description": "HTTP proxy for squid-deb-proxy"
  },
  "ftp_proxy_squid": {
    "type": "string",
    "default": "http://faiserver:8000",
    "description": "FTP proxy for squid-deb-proxy"
  },
  "tftpdir": {
    "type": "string",
    "default": "/srv/tftp",
    "description": "Directory for TFTP configuration files"
  },
  "codenames": {
    "type": "string",
    "default": "trixie bookworm bullseye",
    "description": "Space-separated list of Debian codenames to build installers for"
  },
  "default_codename": {
    "type": "string",
    "default": "trixie",
    "description": "Default codename used for iPXE boot menu entry"
  },
  "archs": {
    "type": "string",
    "default": "amd64 i386",
    "description": "Space-separated list of architectures for installer chroots"
  },
  "default_arch": {
    "type": "string",
    "default": "i386",
    "description": "Default architecture for iPXE boot menu entry"
  },
  "rootpw": {
    "type": "string",
    "default": "",
    "description": "SHA-512 or yescrypt hash of root password; empty = use host's root password"
  },
  "localuser": {
    "type": "string",
    "default": "",
    "description": "Local username to create in installed systems; empty = skip user creation"
  },
  "localuserpw": {
    "type": "string",
    "default": "",
    "description": "Password hash for the local user"
  },
  "wifi_essid": {
    "type": "string",
    "default": "",
    "description": "WiFi ESSID to configure on installed devices; empty = skip WiFi config"
  },
  "wifi_passphrase": {
    "type": "string",
    "default": "",
    "description": "WiFi passphrase in cleartext"
  },
  "school_tag": {
    "type": "string",
    "default": "SKOLE",
    "description": "Short tag/name for the school"
  }
}
