{
  "shell_options": [
    {
      "name": "cdspell",
      "enabled": true
    },
    {
      "name": "dirspell",
      "enabled": true
    },
    {
      "name": "histappend",
      "enabled": true
    }
  ],
  "set_options": [
    {
      "name": "pipefail",
      "enabled": true
    },
    {
      "name": "nounset",
      "enabled": true
    }
  ],
  "aliases": [
    {
      "name": "ll",
      "value": "ls -alF"
    },
    {
      "name": "la",
      "value": "ls -A"
    },
    {
      "name": "l",
      "value": "ls -CF"
    }
  ],
  "functions": [
    {
      "name": "mkcd",
      "body": "mkdir -p \"$1\" && cd \"$1\""
    },
    {
      "name": "extract",
      "body": "if [ -f \"$1\" ] ; then\n  case \"$1\" in\n    *.tar.gz)  tar xzf \"$1\"    ;;\n    *.tar.bz2) tar xjf \"$1\"    ;;\n    *.zip)     unzip \"$1\"      ;;\n    *)         echo \"Don't know how to extract '$1'...\" ;;\n  esac\nfi"
    }
  ],
  "read_keybindings": [
    {
      "keyseq": "\"\\C-x\\C-r\"",
      "function": "re-read-init-file"
    }
  ],
  "export_vars": [
    {
      "name": "HISTSIZE",
      "value": "10000"
    },
    {
      "name": "HISTFILESIZE",
      "value": "20000"
    },
    {
      "name": "PAGER",
      "value": "less"
    }
  ],
  "readonly_vars": [
    {
      "name": "EDITOR",
      "value": "vim"
    }
  ]
}
