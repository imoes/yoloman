# =============================================================================
# t-prot Configuration Template
# =============================================================================
# This file configures t-prot (The PGP/SSL/TOFU Protection Tool) integration,
# primarily for use with mutt or similar mail user agents.
# =============================================================================

# --- Display Filter Configuration ---
# Description: The display_filter string used to invoke t-prot with its default options.
#              This command processes messages before display, checking for TOFU (Trust On First Use)
#              issues and other security warnings.
#              Set to '' to disable TOFU protection by default.
# Default:     't-prot -cmekatlS --max-lines=250 --bigq --pgp-short --pgp-move-vrf -Mmutt -L/etc/t-prot/footers -A/etc/t-prot/ads'
set display_filter='{{ tprot_display_filter | default("t-prot -cmekatlS --max-lines=250 --bigq --pgp-short --pgp-move-vrf -Mmutt -L/etc/t-prot/footers -A/etc/t-prot/ads") }}'

# Macro to toggle TOFU protection OFF using ESC-0 (0x10)
# When executed, it unsets the display_filter, effectively disabling the filter for the current view.
macro generic \e0 ":unset display_filter\n" "Turn TOFU protection off"

# Macro to toggle TOFU protection ON using ESC-1 (0x11)
# When executed, it sets the display_filter back to the configured value, re-enabling protection.
macro generic \e1 ":set display_filter='{{ tprot_display_filter | default("t-prot -cmekatlS --max-lines=250 --bigq --pgp-short --pgp-move-vrf -Mmutt -L/etc/t-prot/footers -A/etc/t-prot/ads") }}'\n" "Turn TOFU protection on"

# --- Pager Mode Macros ---
# These macros handle the toggle behavior when the message is being viewed in pager mode.
# They are slightly more complex to ensure the filter is active when the message is displayed
# but respects the toggle state.

# Macro to toggle TOFU protection OFF in pager mode using ESC-0
# Unsets filter, then re-executes display-message to refresh the view without filtering.
macro pager \e0 ":unset display_filter; exec exit\n:exec display-message\n" "Turn TOFU protection off"

# Macro to toggle TOFU protection ON in pager mode using ESC-1
# Sets filter back, exits current command, and refreshes the message display with filtering enabled.
macro pager \e1 ":set display_filter='{{ tprot_display_filter | default("t-prot -cmekatlS --max-lines=250 --bigq --pgp-short --pgp-move-vrf -Mmutt -L/etc/t-prot/footers -A/etc/t-prot/ads") }}'; exec exit\n:exec display-message\n" "Turn TOFU protection on"

# --- Highlighting Configuration ---
# These color directives highlight specific T-prot output patterns in the message body.

# Highlight T-prot header markers (lines starting with "---") in bright magenta.
# This helps users quickly identify where the protection report begins/ends.
color body	brightmagenta		default	"^\\[---.*"

# Highlight T-prot verification markers (lines starting with "#v-" or "#v+") in green.
# This indicates successful verification or specific status codes within the report.
color body	green			default	"^#v[-+]"
