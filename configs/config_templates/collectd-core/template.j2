# collectd-core configuration file
# This file defines core paths for the collectd daemon.
# It is machine-generated by an Ansible role; do not edit manually.

# Path to the directory where RRD files are stored.
# Used by the rrdtool plugin to persist time-series data.
datadir: "{{ datadir | default('/var/lib/collectd/rrd/') }}"

# Path to the directory where collectd plugins are installed.
# collectd searches this directory for shared object (.so) plugins at runtime.
libdir: "{{ libdir | default('/usr/lib/collectd/') }}"