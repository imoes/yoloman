{
  "autostart": {
    "type": "bool",
    "default": false,
    "description": "Enable autostart. Corresponds to --enable-autostart."
  },
  "obfs4": {
    "type": "bool",
    "default": false,
    "description": "Use obfs4 to obfuscate the traffic. Corresponds to --obfs4."
  },
  "no_systray": {
    "type": "bool",
    "default": false,
    "description": "Do not show the systray icon. Corresponds to --no-systray."
  },
  "web_api": {
    "type": "bool",
    "default": false,
    "description": "Enable Web API. Corresponds to --web-api."
  },
  "web_port": {
    "type": "number",
    "default": 8080,
    "description": "Web API port. Corresponds to --web-port."
  }
}
