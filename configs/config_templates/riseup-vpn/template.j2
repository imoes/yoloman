# riseup-vpn configuration file
# Generated by Ansible Jinja2 template.
# Each directive is documented below with its schema description and default value.

# Enable autostart on boot. Corresponds to --enable-autostart.
# Default: False
autostart={{ autostart|default(False)|lower }}

# Use obfs4 to obfuscate the traffic. Corresponds to --obfs4.
# Default: False
obfs4={{ obfs4|default(False)|lower }}

# Do not show the systray icon. Corresponds to --no-systray.
# Default: False
no_systray={{ no_systray|default(False)|lower }}

# Enable Web API. Corresponds to --web-api.
# Default: False
web_api={{ web_api|default(False)|lower }}

# Web API port. Corresponds to --web-port.
# Default: 8080
web_port={{ web_port|default(8080) }}