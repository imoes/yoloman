# =============================================================================
# mini-buildd Configuration Template
# =============================================================================
# This file configures the mini-buildd daemon. It is self-documenting: every
# variable reference includes its schema default and description as a comment.
# =============================================================================

# --- mini_buildd_options ---
# Type: string
# Default: '' (empty string)
# Description: Extra command line options for mini-buildd service.
# These options are appended to the daemon's startup command.
MINI_BUILDD_OPTIONS="{{ (mini_buildd_options | default('')) | string }}"


# --- python_warnings ---
# Type: string
# Default: 'ignore'
# Description: Python warnings configuration string. Supported values are:
#              ignore, default, once.
# This controls how Python warnings are handled by the mini-buildd process.
PYTHONWARNINGS="{{ (python_warnings | default('ignore')) | string }}"
