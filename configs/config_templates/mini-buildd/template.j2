# Extra command line options for the mini-buildd service.
# These are passed directly to the daemon at startup.
# See ``mini-buildd --help`` for available options.
MINI_BUILDD_OPTIONS="{{ mini_buildd_options | default('') }}"

# Python warnings configuration for mini-buildd's internal Python scripts.
# It is recommended to keep this on "ignore" for production environments
# to reduce log noise from non-critical warnings.
# See ``man python`` for details on warning filters.
PYTHONWARNINGS="{{ python_warnings | default('ignore') }}"