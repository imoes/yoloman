# dumpet(1) configuration for El Torito boot image dump
# One option per line; options are mutually exclusive and positional.
# Required: ISO image path

--iso {{ iso_image | default('') }}
{% if dumpdisks | default(false) %}
--dumpdisks
{% endif %}
{% if dumphex | default(false) %}
--dumphex
{% endif %}
{% if xml | default(false) %}
--xml
{% endif %}