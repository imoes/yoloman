# Open vSwitch (OVS) Switch Configuration Fragment
# This file is sourced by the ovs-ctl init script to configure daemon behavior.
# It is self-documenting: every variable maps to a schema field with a default.

# -------------------------------------------------------------------------
# Force Core Dumps
# -------------------------------------------------------------------------
# Description: If set to 'yes', core files will be enabled for OVS processes.
#              This is useful for debugging crashes in ovs-vswitchd or ovsdb-server.
#              Default behavior (when unset or not 'yes') is to NOT generate core dumps.
# Variable: force_corefiles
# Default: None (commented out in config)
{% if force_corefiles | default(None) is defined and force_corefiles | default(None) is not none and force_corefiles | default(None) | trim | lower == 'yes' %}
FORCE_COREFILES=yes
{% else %}
# FORCE_COREFILES=yes
{% endif %}

# -------------------------------------------------------------------------
# OVS Control Options
# -------------------------------------------------------------------------
# Description: Extra options to pass to ovs-ctl, e.g. for wrapping daemons
#              with valgrind or setting other runtime flags.
#              This string is appended directly to the ovs-ctl command line.
#              Be careful with quoting here; usually space-separated flags work best.
# Variable: ovs_ctl_opts
# Default: None (empty, commented out in config)
# Example: OVS_CTL_OPTS="--ovs-vswitchd-wrapper=valgrind"
{% if ovs_ctl_opts | default(None) is defined and ovs_ctl_opts | default(None) is not none and ovs_ctl_opts | default(None) | trim | length > 0 %}
OVS_CTL_OPTS={{ ovs_ctl_opts | default(None) | trim }}
{% else %}
# OVS_CTL_OPTS=
{% endif %}

# -------------------------------------------------------------------------
# DPDK Configuration Note
# -------------------------------------------------------------------------
# DPDK options are now configured via ovs-vsctl/ovsdb, see:
# - /usr/share/doc/openvswitch-common/INSTALL.DPDK.md.gz
# - /usr/share/doc/openvswitch-common/INSTALL.DPDK-ADVANCED.md.gz
#
# The variable 'dpdk-extra' was historically used as a fallback for users
# who formerly set e.g. '--vhost-owner libvirt-qemu:kvm --vhost-perm 0664'
# here or any other DPDK EAL arguments via DPDK_OPTS which are not covered by
# the default switches provided by ovs-vsctl.
#
# For more on the new ovsdb based configuration of DPDK features, see:
# `man ovs-vswitchd.conf.db`
