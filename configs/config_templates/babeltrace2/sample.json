{
  "log_level": "WARN",
  "omit_home_plugin_path": false,
  "omit_system_plugin_path": false,
  "plugin_paths": [
    "/opt/bt2-plugins",
    "/usr/local/lib/babeltrace2/plugins"
  ],
  "term_color": "ALWAYS",
  "lib_log_level": "ERROR",
  "cli_log_level": "WARN",
  "py_log_level": "INFO",
  "disable_python_plugins": true,
  "disable_dlclose": false,
  "plugin_provider_dir": "/usr/local/lib/babeltrace2/plugin-providers",
  "exec_on_abort": [
    "systemctl",
    "restart",
    "babeltrace2"
  ],
  "bright_means_bold": false,
  "suppress_clash_warning": false,
  "legacy_debug": false,
  "legacy_verbose": true
}
