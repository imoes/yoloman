{
  "port": 53,
  "allow_query": [
    "any"
  ],
  "allow_recursion": [
    "192.168.0.0/16",
    "10.0.0.0/8",
    "127.0.0.1/32"
  ],
  "dnssec_validation": "auto",
  "listen_on": [
    {
      "address": "127.0.0.1"
    },
    {
      "address": "192.168.1.1"
    }
  ],
  "listen_on_v6": [
    {
      "address": "::1"
    }
  ],
  "forwarders": [
    {
      "address": "208.67.222.222"
    },
    {
      "address": "208.67.220.220"
    }
  ],
  "forward_policy": "only",
  "max_cache_size": 100,
  "querylog": false,
  "pid_file": "/run/named/named.pid",
  "working_directory": "/var/cache/bind",
  "stats_file": "/var/cache/bind/named.stats",
  "doh_endpoint": {
    "address": "127.0.0.1",
    "port": 443,
    "tls_cert": "/etc/ssl/certs/dns.example.com.crt",
    "tls_key": "/etc/ssl/private/dns.example.com.key"
  }
}
