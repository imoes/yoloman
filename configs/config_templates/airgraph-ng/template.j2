# airgraph-ng configuration template
# This template generates the command-line arguments for the airgraph-ng utility.
# airgraph-ng is a standalone visualization tool that converts airodump-ng CSV captures
# into PNG graphs showing Wi-Fi network relationships.
# It is a leaf tool with no persistent state, no listening ports, and no network dependencies.

# Input CSV file generated by airodump-ng (e.g., dump-01.csv)
# If not specified or set to /dev/stdin, the tool reads from standard input.
-i {{ input_csv_file | default('/dev/stdin') }}

# Output PNG file to write the generated graph.
# The path can be absolute or relative to the working directory.
-o {{ output_png_file | default('graph.png') }}

# Graph type: 'CAPR' (Client-to-AP Relationship) or 'CPG' (Common Probe Graph).
# CAPR shows connections between clients and access points.
# CPG shows associations between access points based on probe requests.
# Defaults to CAPR.
-g {{ graph_type | default('CAPR') | upper }}

# Print the about message (version and copyright information) before processing.
# Accepts boolean-like values (true/false, yes/no, 1/0).
# Defaults to false (no output).
-a {{ print_about | default(false) | ternary('true', 'false') }}