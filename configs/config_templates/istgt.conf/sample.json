{
  "log_level": "Info",
  "pid_file": "/var/run/istgt.pid",
  "control_socket": "/var/run/istgt.control",
  "allow_remote": true,
  "max_connections": 256,
  "io_timeout": 30,
  "preallocate_memory": false,
  "luns": [
    {
      "path": "/var/lib/istgt/vdisk0",
      "block_size": 512,
      "read_only": false
    },
    {
      "path": "/dev/disk/by-id/wwn-0x50014027c3a8e4f1",
      "block_size": 4096,
      "read_only": true
    }
  ],
  "serial": "ISTGT0001",
  "vendor": "ISTGT",
  "product": "iSCSI Target",
  "revision": "0001",
  "portals": [
    {
      "discovery": true
    }
  ],
  "allowed_initiators": [
    "iqn.2005-05.com.example:server1",
    "iqn.1994-05.com.redhat:client1"
  ],
  "auth_users": [
    {
      "user": "initiator-user",
      "secret": "my-super-secret-passphrase"
    }
  ],
  "target_name": "iqn.2005-05.com.example:storage.target1",
  "queue_depth": 32,
  "data_digest": "CRC32C",
  "header_digest": "CRC32C",
  "default_block_size": 512,
  "login_timeout": 30,
  "max_connections_per_session": 2,
  "send_target_name": true,
  "suppress_target_name": false
}
