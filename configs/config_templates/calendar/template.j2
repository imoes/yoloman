# /etc/default/calendar: System-wide default configuration for the calendar(1) utility.
# This file is sourced by the calendar command to determine paths and behavior.
# Users can override these settings via their own configuration files or environment variables.

# Name of the default configuration file to source under /etc/default/.
# This allows administrators to specify a specific config file name if multiple
# configuration variants are needed.
# Default: calendar
CALENDAR_CONFIG={{ default_calendar_config_file | default('calendar') }}

# Full path to the sendmail executable.
# Used by calendar(1) to send reminders or notifications via mail if configured.
# Ensure the path points to a valid MTA binary installed on the system.
# Default: /usr/sbin/sendmail
SENDMAIL_PATH={{ sendmail_path | default('/usr/sbin/sendmail') }}

# Full path to the calendar binary.
# Specifies the location of the calendar(1) executable.
# Useful in environments where the binary might be located in a non-standard path.
# Default: /usr/bin/calendar
CALENDAR_BINARY={{ calendar_binary | default('/usr/bin/calendar') }}

# Name of the default calendar include file to source.
# If set, this file is included in addition to or instead of the default calendar.all.
# If empty, the system defaults to including /usr/share/calendar/calendar.all
# (handled in the calendar data directory, not here).
# Default: '' (empty, uses default include behavior)
CALENDAR_INCLUDE_FILE={{ calendar_include_file | default('') }}
