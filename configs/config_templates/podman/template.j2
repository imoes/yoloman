{
  "cniVersion": "0.4.0",
  "name": "{{ cni_network_name }}",
  "plugins": [
    {
      "type": "bridge",
      "bridge": "{{ cni_bridge_name }}",
      "isGateway": true,
      "ipMasq": true,
      "hairpinMode": true,
      "ipam": {
        "type": "host-local",
        "routes": [{ "dst": "0.0.0.0/0" }],
        "ranges": [
          [
            {
              "subnet": "{{ cni_subnet }}",
              "gateway": "{{ cni_gateway }}"
            }
          ]
        ]
      }
    },
    {
      "type": "portmap",
      "capabilities": {
        "portMappings": true
      }
    },
    {
      "type": "firewall"
    },
    {
      "type": "tuning"
    }
  ]
}