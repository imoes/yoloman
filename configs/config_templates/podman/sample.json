{
  "storage_driver": "overlay",
  "storage_config_path": "~/.local/share/containers/storage",
  "default_runtime": "crun",
  "systemd_cgroup": true,
  "log_level": "warn",
  "cni_config_file": "",
  "registries": [
    {
      "name": "docker.io",
      "insecure": false,
      "blocked": false
    },
    {
      "name": "quay.io",
      "insecure": false,
      "blocked": false
    },
    {
      "name": "registry.example.com",
      "insecure": true,
      "prefix": "internal/"
    }
  ],
  "default_namespace": "",
  "default_tag": "latest",
  "runtimes": {
    "crun": {
      "path": "/usr/bin/crun"
    },
    "runc": {
      "path": "/usr/bin/runc"
    }
  },
  "selinux_enabled": true,
  "default_volumes": [],
  "env": {
    "HTTP_PROXY": "http://proxy.example.com:8080"
  },
  "hooks": [
    {
      "type": "prestart",
      "path": "/usr/local/bin/hook.sh",
      "args": [
        "arg1"
      ]
    },
    {
      "type": "poststop",
      "path": "/usr/local/bin/cleanup.sh",
      "args": []
    }
  ],
  "netns": "private",
  "dns": [
    "8.8.8.8",
    "1.1.1.1",
    "9.9.9.9"
  ],
  "userns_mode": "auto:1000:1"
}
