{
  "instance_name": "daphne-main",
  "bind_hosts": [
    "0.0.0.0"
  ],
  "bind_ports": [
    8000
  ],
  "asgi_application": "myproject.asgi:application",
  "num_workers": 3,
  "num_threads": 2,
  "log_level": "info",
  "log_file": "/var/log/daphne/error.log",
  "serve_static": true,
  "static_mappings": [
    {
      "path": "/static/",
      "directory": "/var/www/myproject/static"
    },
    {
      "path": "/media/",
      "directory": "/var/www/myproject/media"
    }
  ],
  "health_check_path": "/health/",
  "worker_timeout": 30,
  "websocket_timeout": 120,
  "websocket_max_size": 65536,
  "websocket_max_queue": 200,
  "process_name": "myapp-daphne",
  "environment_variables": [
    {
      "key": "DJANGO_SETTINGS_MODULE",
      "value": "myproject.settings.prod"
    },
    {
      "key": "PYTHONPATH",
      "value": "/srv/myproject"
    }
  ],
  "access_log": "/var/log/daphne/access.log",
  "user": "www-data",
  "group": "www-data",
  "daemon": true,
  "pid_file": "/run/daphne/daphne-main.pid"
}
