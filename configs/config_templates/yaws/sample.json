{
  "logdir": "/var/log/yaws",
  "docroot": "/var/www/yaws",
  "listen": "0.0.0.0",
  "port": 80,
  "ipv6": false,
  "dir_listings": true,
  "user": "yaws",
  "max_connections": 4096,
  "num_acceptors": 8,
  "servers": [
    {
      "name": "example.com",
      "listen": "192.168.1.10",
      "port": 80,
      "docroot": "/var/www/example.com/www",
      "dir_listings": false,
      "index_files": [
        "index.html",
        "index.yaws"
      ],
      "extra_headers": [
        {
          "name": "X-Frame-Options",
          "value": "DENY"
        }
      ],
      "access_log": "/var/log/yaws/example.com_access.log",
      "error_log": "/var/log/yaws/example.com_error.log",
      "apps": [
        {
          "name": "php",
          "scgi": false,
          "cgi": true,
          "dir": "/var/www/example.com/www/app",
          "extra_params": [
            {
              "key": "php_value",
              "value": "include_path = .:/usr/share/php"
            }
          ]
        }
      ]
    },
    {
      "name": "api.example.com",
      "listen": "192.168.1.10",
      "port": 8080,
      "docroot": "/var/www/api.example.com/www",
      "index_files": [],
      "apps": [
        {
          "name": "scgi",
          "scgi": true,
          "cgi": false,
          "dir": "/var/www/api.example.com/backend"
        }
      ]
    }
  ]
}
