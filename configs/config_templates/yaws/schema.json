{
  "yaws_conf": {
    "type": "string",
    "default": "/etc/yaws/yaws.conf",
    "description": "Path to the main Yaws configuration file."
  },
  "yaws_id": {
    "type": "string",
    "default": "debian_yaws",
    "description": "Daemon ID used by init scripts; must be alphanumeric only."
  },
  "daemon_opts": {
    "type": "string",
    "default": "--heart",
    "description": "Additional options passed to the Yaws daemon (e.g., `--heart`, `--debug`).",
    "enum": [
      "--heart",
      "--nodebug",
      "--debug",
      "--daemon",
      "--interactive",
      "--winteractive",
      "--trace",
      "--tracetraf",
      "--tracehttp",
      "--traceout",
      "--disable-kpoll",
      "--umask",
      "--encoding",
      "--id",
      "--name",
      "--sname",
      "--mnesiadir",
      "--proto_dist",
      "--erlarg",
      "--pa",
      "--runmod",
      "--conf",
      "--heart-restart"
    ]
  }
}
