# /etc/ftpusers: list of users disallowed FTP access.
#
# This file specifies system users who are forbidden from logging in via
# the FTP service. It is a plain text list, one username per line.
# The Pure-FTPd daemon reads this file at startup and/or on reload.

# The 'root' user must always be excluded to prevent direct root login via FTP,
# which is a significant security risk.
root

# 'daemon', 'bin', and 'sys' are standard system accounts with no interactive login capability.
daemon
bin
sys

# 'sync' is typically used by the 'sync' command to write memory buffers to disk;
# it should not have an FTP shell.
sync

# 'games' and 'man' are service accounts for game scores and manual pages, respectively.
games
man

# 'lp' (Line Printer) and 'mail' are system service accounts for printing and mail handling.
# 'news' is for Usenet news systems.
lp
mail
news

# 'uucp' is for Unix-to-Unix Copy Protocol, an older file transfer system.
# 'proxy' is used for the proxy package manager.
uucp
proxy

# 'majordom' is a mailing list manager user.
# 'postgres' is the PostgreSQL database superuser. Excluding it prevents database admin
# accounts from potentially accessing files via FTP if compromised.
majordom
postgres

# 'www-data' is the common web server user (Debian/Ubuntu). Excluding it prevents web
# directory traversal via FTP if the FTP service is misconfigured.
www-data

# 'backup' is a system account used by backup utilities.
# 'msql' is an older MySQL (mSQL) database account.
# 'operator' is a system administrative account.
backup
msql
operator

# 'list' is a generic system account.
# 'irc' is the Internet Relay Chat service account.
list
irc

# 'nobody' is the generic unprivileged user.
nobody

# Note: If you need to allow specific service accounts (like 'www-data') to access
# specific directories via FTP, you must remove them from this list and configure
# chroot restrictions in the main Pure-FTPd configuration. However, this is generally
# discouraged due to security implications.