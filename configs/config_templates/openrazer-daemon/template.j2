# ==============================================================================
# OpenRazer Daemon Configuration
# ==============================================================================
#
# This file is managed by Ansible. Do not edit manually.
# Default location: ~/.config/openrazer/razer.conf
#
# Fields and defaults (from schema):
#   - verbose:             Enable logging of DEBUG messages.  (Default: False)
#   - as_root:             Allow the daemon to be started as root.  (Default: False)
#   - persistence_file:    Specifies the location of the persistence file.  (Default: '')
#   - run_dir:             The directory the daemon changes to once started.  (Default: '')
#   - log_dir:             The directory for log files.  (Default: '')
#   - test_dir:            Directory for test-driver mode exposing fake devices.  (Default: '')
#   - config_file:         The location of this configuration file.  (Default: '~/.config/openrazer/razer.conf')
#

[daemon]
# Enable logging of DEBUG messages.
# Default: False
verbose = {{ verbose | default(false) | lower }}

# Allow the daemon to be started as root.
# Default: False
as_root = {{ as_root | default(false) | lower }}

[persistence]
# Specifies the location of the persistence file.
# Defaults to ~/.local/share/openrazer/persistence when empty.
# Default: ''
persistence_file = {{ persistence_file | default('') }}

[run]
# The directory the daemon changes to once started.
# Defaults to $XDG_RUNTIME_DIR or ~/.local/share/openrazer/ when empty.
# Default: ''
run_dir = {{ run_dir | default('') }}

[log]
# The directory for log files.
# Defaults to ~/.local/share/openrazer/logs/ when empty.
# Default: ''
log_dir = {{ log_dir | default('') }}

[devices]
# Directory for test-driver mode exposing fake devices.
# An empty string disables test mode.
# Default: ''
test_dir = {{ test_dir | default('') }}