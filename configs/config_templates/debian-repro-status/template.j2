# debian-repro-status(5) configuration file
# Generated by debian-repro-status(1) configuration template
# See man:debian-repro-status(1) for options

# Target architecture (e.g., amd64, arm64); empty string means auto-detect by the tool
# --architecture
architecture: {{ architecture | default('') }}

# URL of the rebuilderd API endpoint to query for reproducibility status
# --rebuilderd
rebuilderd: {{ rebuilderd | default('https://rebuilds.debian.net') }}

# Path to a pre-captured dpkg-query output file.
# If provided (non-empty), debian-repro-status will use this file instead of running dpkg-query.
# If empty, the tool runs the dpkg-query binary directly.
# --dpkg-query-output
dpkg_query_output: {{ dpkg_query_output | default('') }}

# Path to a pre-captured rebuilderd package list file.
# If provided (non-empty), debian-repro-status will use this file instead of querying the API.
# If empty, the tool queries the rebuilderd API defined in `rebuilderd`.
# --rebuilderd-query-output
rebuilderd_query_output: {{ rebuilderd_query_output | default('') }}

# Filter by package status to include in output.
# Valid values are GOOD, BAD, or UNKWN.
# Empty string means no filtering (show all).
# --filter
filter: {{ filter | default('') | upper }}

# If true, output only summary counts (no per-package details).
# If false or omitted, output includes detailed per-package information.
# --summary
summary: {{ summary | default(false) | lower }}