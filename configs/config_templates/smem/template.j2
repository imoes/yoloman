{# ============================================================================ #}
{# smem Command-Line Invocation Template                                        #}
{# ============================================================================ #}
{# This template generates a command-line invocation for the `smem` utility.     #}
{# `smem` is a reporting tool for memory usage in Linux, providing PSS (Proportional Set Size) #}
{# and USS (Unique Set Size) metrics.                                           #}
{#                                                                                #}
{# Self-Documentation:                                                          #}
{# Each option below corresponds to a specific `smem` flag. The Jinja2 variable  #}
{# references use the `default()` filter with the schema default to ensure      #}
{# the rendered command is always valid, even if a role does not provide a       #}
{# specific variable.                                                           #}
{# ============================================================================ #}

{# --- Source Data Options --- #}

{# -K, --kernel: Path to an uncompressed kernel image (vmlinux) to include #}
{# kernel code size in systemwide output. If empty/undefined, this flag is omitted. #}
{% if (kernel | default('')) != '' %}
-K {{ kernel | default('') }}
{% endif %}

{# -R, --realmem: Amount of physical RAM (e.g., '1024M', '8G') to detect #}
{# firmware/hardware memory usage and base percentages on. If empty/undefined, omitted. #}
{% if (realmem | default('')) != '' %}
-R {{ realmem | default('') }}
{% endif %}

{# -S, --source: Path to an alternate /proc data source, typically a .tar file #}
{# generated by smemcap. If empty/undefined, omitted. #}
{% if (source | default('')) != '' %}
-S {{ source | default('') }}
{% endif %}

{# --- Report By Options (Mutually Exclusive Logic) --- #}

{# -m, --mappings: If true, reports memory usage by mapping instead of by process. #}
{% if mappings | default(False) | bool %}
-m
{% endif %}

{# -u, --users: If true, reports memory usage by user instead of by process. #}
{% if users | default(False) | bool %}
-u
{% endif %}

{# -w, --system: If true, reports systemwide memory usage summary. #}
{% if system | default(False) | bool %}
-w
{% endif %}

{# --- Filter Options --- #}

{# -M, --mapfilter: Regular expression to filter mappings. #}
{# If empty/undefined, no filtering is applied. #}
{% if (mapfilter | default('')) != '' %}
-M {{ mapfilter | default('') }}
{% endif %}

{# -P, --processfilter: Regular expression to filter processes. #}
{# If empty/undefined, no filtering is applied. #}
{% if (processfilter | default('')) != '' %}
-P {{ processfilter | default('') }}
{% endif %}

{# -U, --userfilter: Regular expression to filter users. #}
{# If empty/undefined, no filtering is applied. #}
{% if (userfilter | default('')) != '' %}
-U {{ userfilter | default('') }}
{% endif %}

{# --- Output Formatting Options --- #}

{# -a, --autosize: If true, auto-sizes columns to fit terminal width. #}
{% if autosize | default(False) | bool %}
-a
{% endif %}

{# -c, --columns: List of column names to display (e.g., PSS, USS, Swap, SwapP). #}
{# If empty, smem uses its default columns. #}
{% if (columns | default([])) | length > 0 %}
-c {{ columns | default([]) | join(',') }}
{% endif %}

{# -H, --no-header: If true, disables the header line in the output. #}
{% if no_header | default(False) | bool %}
-H
{% endif %}

{# -k, --abbreviate: If true, shows unit suffixes (K, M, G) for memory values. #}
{% if abbreviate | default(True) | bool %}
-k
{% endif %}

{# -n, --numeric: If true, shows numeric user IDs instead of usernames. #}
{% if numeric | default(False) | bool %}
-n
{% endif %}

{# -p, --percent: If true, shows memory usage as percentages. #}
{% if percent | default(False) | bool %}
-p
{% endif %}

{# -r, --reverse: If true, reverses the sort order of the output. #}
{% if reverse | default(False) | bool %}
-r
{% endif %}

{# -s, --sort: Field name to sort the output by (e.g., PSS, USS, Swap, Pid, Name). #}
{# Default is PSS. #}
{% if (sort | default('PSS')) != 'PSS' %}
-s {{ sort | default('PSS') }}
{% endif %}

{# -t, --totals: If true, shows a totals line at the bottom of the output. #}
{% if totals | default(False) | bool %}
-t
{% endif %}

{# --- Graphical Output Options --- #}

{# --bar: Field name to use for bar graph generation (requires matplotlib). #}
{# If empty/undefined, no bar graph is generated. #}
{% if (bar | default('')) != '' %}
--bar={{ bar | default('') }}
{% endif %}

{# --pie: Field name to use for pie graph generation (requires matplotlib). #}
{# If empty/undefined, no pie graph is generated. #}
{% if (pie | default('')) != '' %}
--pie={{ pie | default('') }}
{% endif %}