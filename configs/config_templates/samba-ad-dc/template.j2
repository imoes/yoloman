# Global settings
[global]
   workgroup = {{ workgroup }}
   realm = {{ realm }}
   netbios name = {{ netbios_name }}
   server role = active directory domain controller
   server services = {{ server_services | join(', ') }}

   # Logging
   log level = {{ log_level }}
   log file = {{ log_file }}
   max log size = {{ max_log_size }}

   # DNS and Kerberos
   dns forwarder = {{ dns_forwarder }}
   # Use internal DNS by default; set to 'no' to use external DNS (e.g., BIND9 DLZ)
   dcerpc endpoint servers = {{ dcerpc_endpoint_servers | join(', ') }}
   idmap_ldb:use rfc2307 = yes
   # Internal DNS backend
   dns backend = {{ dns_backend }}

   # Password and account policies
   # Password policy settings (enforced by default DC policy)
   min password length = {{ min_password_length }}
   password complexity = {{ password_complexity | lower }}
   password history = {{ password_history }}
   logon script = {{ logon_script }}
   logon path = {{ logon_path }}
   logon drive = {{ logon_drive }}

   # Kerberos and time sync
   time server = yes

   # File serving & shares defaults
   # Disable default shares; enable only explicit shares below
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

   # Performance tuning
   # Worker and connection limits
   max connections = {{ max_connections }}
   socket options = {{ socket_options | join(', ') }}
   read raw = {{ read_raw | lower }}
   write raw = {{ write_raw | lower }}
   # Thread pool for async I/O (e.g., VFS modules)
   aio max threads = {{ aio_max_threads }}

   # Security hardening
   # Require encryption (modern clients only)
   server signing = {{ server_signing }}
   client signing = {{ client_signing }}
   # Prefer strong ciphers
   server min protocol = {{ server_min_protocol }}
   client min protocol = {{ client_min_protocol }}
   # Disable insecure auth by default
   lanman auth = no
   ntlm auth = {{ ntlm_auth | lower }}
   krb5 auth = yes

   # LDAP backend (for internal use only — not LDAP DC mode)
   # Do NOT expose LDAP externally without explicit hardening
   ldap server require strong auth = yes
   # Use Samba's built-in LDAP (sam.ldb) — do not change
   # (Other LDAP backends unsupported for AD DC)

# Default shares
[netlogon]
   comment = Domain logon services
   path = {{ netlogon_path }}
   read only = no
   browsable = no
   share modes = no

[sysvol]
   comment = SYSVOL (policy & scripts) share
   path = {{ sysvol_path }}
   read only = no
   browsable = no
   share modes = no

# Custom user-defined shares
{% for share in shares %}
[{{ share.name }}]
   comment = {{ share.comment | default('') }}
   path = {{ share.path }}
   read only = {{ 'yes' if share.read_only else 'no' }}
   browsable = {{ 'yes' if share.browsable else 'no' }}
{% if share.guest_ok %}   guest ok = yes{% endif %}
{% if share.write_list %}   write list = {{ share.write_list | join(', ') }}{% endif %}
{% if share.valid_users %}   valid users = {{ share.valid_users | join(', ') }}{% endif %}
{% if share.force_user %}   force user = {{ share.force_user }}{% endif %}
{% if share.force_group %}   force group = {{ share.force_group }}{% endif %}
{% if share.create_mask %}   create mask = {{ share.create_mask }}{% endif %}
{% if share.directory_mask %}   directory mask = {{ share.directory_mask }}{% endif %}
{% endfor %}
