{
  "workgroup": "EXAMPLE",
  "realm": "EXAMPLE.COM",
  "netbios_name": "DC1",
  "server_services": [
    "smb",
    "kdc",
    "ldap",
    "ldap-dc",
    "rpcproxy",
    "dnsupdate"
  ],
  "log_level": "2",
  "log_file": "/var/log/samba/log.%m",
  "max_log_size": 5000,
  "dns_forwarder": "8.8.8.8",
  "dcerpc_endpoint_servers": [
    "remote",
    "samr",
    "lsarpc",
    "epmapper",
    "dpss"
  ],
  "dns_backend": "SAMBA_INTERNAL",
  "min_password_length": 12,
  "password_complexity": "Strong",
  "password_history": 24,
  "logon_script": "logon.bat",
  "logon_path": "\\\\%N\\profiles\\%U",
  "logon_drive": "H:",
  "max_connections": 100,
  "socket_options": [
    "TCP_NODELAY",
    "SO_RCVBUF=131072",
    "SO_SNDBUF=131072"
  ],
  "read_raw": true,
  "write_raw": true,
  "aio_max_threads": 10,
  "server_signing": "required",
  "client_signing": "required",
  "SAMBAOPTIONS": ""
}
