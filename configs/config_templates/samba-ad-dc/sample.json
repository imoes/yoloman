{
  "workgroup": "CORP",
  "realm": "CORP.EXAMPLE.COM",
  "netbios_name": "DC01",
  "server_services": [
    "smb",
    "kdc",
    "ldap",
    "ldap-dc",
    "rpcproxy",
    "dnsupdate"
  ],
  "log_level": "3",
  "log_file": "/var/log/samba/log.%m",
  "max_log_size": 10000,
  "dns_forwarder": "1.1.1.1",
  "dcerpc_endpoint_servers": [
    "remote",
    "samr",
    "lsarpc"
  ],
  "dns_backend": "SAMBA_INTERNAL",
  "min_password_length": 14,
  "password_complexity": "Strong",
  "password_history": 24,
  "logon_script": "logon.cmd",
  "logon_path": "\\\\%N\\profiles\\%U",
  "logon_drive": "Z:",
  "max_connections": 200,
  "socket_options": [
    "TCP_NODELAY",
    "SO_RCVBUF=262144",
    "SO_SNDBUF=262144"
  ],
  "read_raw": true,
  "write_raw": true,
  "aio_max_threads": 16,
  "server_signing": "required",
  "client_signing": "required",
  "server_min_protocol": "SMB3_00",
  "client_min_protocol": "SMB3_00",
  "ntlm_auth": false,
  "netlogon_path": "/var/lib/samba/sysvol/corp.example.com/scripts",
  "sysvol_path": "/var/lib/samba/sysvol",
  "shares": [
    {
      "name": "data",
      "comment": "Shared department data",
      "path": "/srv/samba/data",
      "read_only": false,
      "browsable": true,
      "guest_ok": false,
      "write_list": [
        "CORP\\Domain Users"
      ],
      "valid_users": [
        "CORP\\Domain Admins",
        "CORP\\IT-Team"
      ],
      "force_user": "root",
      "create_mask": "0660",
      "directory_mask": "0770"
    },
    {
      "name": "home",
      "comment": "User home directories",
      "path": "/home",
      "read_only": false,
      "browsable": false,
      "guest_ok": false,
      "force_user": "DOMAIN\\%U",
      "create_mask": "0600",
      "directory_mask": "0700"
    }
  ]
}
