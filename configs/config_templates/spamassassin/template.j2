# This is the right place to customize your installation of SpamAssassin.
#
# See 'perldoc Mail::SpamAssassin::Conf' for details of what can be
# tweaked.
#
# Only a small subset of options are listed below
#
###########################################################################

#    A 'contact address' users should contact for more info. (replaces
#    _CONTACTADDRESS_ in the report template)
{% if report_contact is defined and report_contact is not none and (report_contact is number or report_contact is boolean or report_contact | length > 0) %}report_contact {{ report_contact }}
{% else %}# report_contact youremailaddress@domain.tld
{% endif %}

#   Add *****SPAM***** to the Subject header of spam e-mails
#
{% if rewrite_header_subject is defined and rewrite_header_subject is not none and (rewrite_header_subject is number or rewrite_header_subject is boolean or rewrite_header_subject | length > 0) %}rewrite_header Subject {{ rewrite_header_subject }}
{% else %}# rewrite_header Subject *****SPAM*****
{% endif %}

#   Save spam messages as a message/rfc822 MIME attachment instead of
#   modifying the original message (0: off, 2: use text/plain instead)
#
{% if report_safe is defined and report_safe is not none and (report_safe is number or report_safe is boolean or report_safe | length > 0) %}report_safe {{ report_safe }}
{% else %}# report_safe 1
{% endif %}

#   Set which networks or hosts are considered 'trusted' by your mail
#   server (i.e. not spammers)
#
{% if trusted_networks is defined and trusted_networks is not none and (trusted_networks is number or trusted_networks is boolean or trusted_networks | length > 0) %}trusted_networks {{ trusted_networks }}
{% else %}# trusted_networks 212.17.35.
{% endif %}

#   Set file-locking method (flock is not safe over NFS, but is faster)
#
{% if lock_method is defined and lock_method is not none and (lock_method is number or lock_method is boolean or lock_method | length > 0) %}lock_method {{ lock_method }}
{% else %}# lock_method flock
{% endif %}

#   Set the threshold at which a message is considered spam (default: 5.0)
#
{% if required_score is defined and required_score is not none and (required_score is number or required_score is boolean or required_score | length > 0) %}required_score {{ required_score }}
{% else %}# required_score 5.0
{% endif %}

#   Use Bayesian classifier (default: 1)
#
{% if use_bayes is defined and use_bayes is not none and (use_bayes is number or use_bayes is boolean or use_bayes | length > 0) %}use_bayes {{ use_bayes }}
{% else %}# use_bayes 1
{% endif %}

#   Bayesian classifier auto-learning (default: 1)
#
{% if bayes_auto_learn is defined and bayes_auto_learn is not none and (bayes_auto_learn is number or bayes_auto_learn is boolean or bayes_auto_learn | length > 0) %}bayes_auto_learn {{ bayes_auto_learn }}
{% else %}# bayes_auto_learn 1
{% endif %}

#   Set headers which may provide inappropriate cues to the Bayesian
#   classifier
#
# bayes_ignore_header X-Bogosity
# bayes_ignore_header X-Spam-Flag
# bayes_ignore_header X-Spam-Status


#   Whether to decode non- UTF-8 and non-ASCII textual parts and recode
#   them to UTF-8 before the text is given over to rules processing.
#
{% if normalize_charset is defined and normalize_charset is not none and (normalize_charset is number or normalize_charset is boolean or normalize_charset | length > 0) %}normalize_charset {{ normalize_charset }}
{% else %}# normalize_charset 1
{% endif %}
#   Textual body scan limit    (default: 50000)
#
#   Amount of data per email text/* mimepart, that will be run through body
#   rules.  This enables safer and faster scanning of large messages,
#   perhaps having very large textual attachments.  There should be no need
#   to change this well tested default.
#
{% if body_part_scan_size is defined and body_part_scan_size is not none and (body_part_scan_size is number or body_part_scan_size is boolean or body_part_scan_size | length > 0) %}body_part_scan_size {{ body_part_scan_size }}
{% else %}# body_part_scan_size 50000
{% endif %}
#   Textual rawbody data scan limit    (default: 500000)
#
#   Amount of data per email text/* mimepart, that will be run through
#   rawbody rules.
#
{% if rawbody_part_scan_size is defined and rawbody_part_scan_size is not none and (rawbody_part_scan_size is number or rawbody_part_scan_size is boolean or rawbody_part_scan_size | length > 0) %}rawbody_part_scan_size {{ rawbody_part_scan_size }}
{% else %}# rawbody_part_scan_size 500000
{% endif %}
#   Some shortcircuiting, if the plugin is enabled
# 
ifplugin Mail::SpamAssassin::Plugin::Shortcircuit
#
#   default: strongly-welcomelisted mails are *really* welcomelisted now, if
#   the shortcircuiting plugin is active, causing early exit to save CPU
#   load.  Uncomment to turn this on
#
#   SpamAssassin tries hard not to launch DNS queries before priority -100. 
#   If you want to shortcircuit without launching unneeded queries, make
#   sure such rule priority is below -100. These examples are already:
#
# shortcircuit USER_IN_WELCOMELIST       on
# shortcircuit USER_IN_DEF_WELCOMELIST   on
# shortcircuit USER_IN_ALL_SPAM_TO     on

#   the opposite; blocklisted mails can also save CPU
#
# shortcircuit USER_IN_BLOCKLIST       on
# shortcircuit USER_IN_BLOCKLIST_TO    on

#   if you have taken the time to correctly specify your "trusted_networks",
#   this is another good way to save CPU
#
# shortcircuit ALL_TRUSTED             on

#   and a well-trained bayes DB can save running rules, too
#
# shortcircuit BAYES_99                spam
# shortcircuit BAYES_00                ham

endif # Mail::SpamAssassin::Plugin::Shortcircuit
