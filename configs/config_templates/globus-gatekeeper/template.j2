# Globus Gatekeeper Log Rotation Configuration
# Managed by Ansible. Do not edit manually.

# Log file path for globus-gatekeeper.
# If empty or unset, logs go to syslog.
# Default: /var/log/globus-gatekeeper.log
{% set log_path = GLOBUS_GATEKEEPER_LOG | default('/var/log/globus-gatekeeper.log') %}

{# Only define logrotate rules if a specific file log path is provided #}
{% if log_path and log_path | length > 0 %}
{{ log_path | default('/var/log/globus-gatekeeper.log') }} {
    # Rotate logs daily
    daily

    # Compress old log files using gzip
    compress

    # Do not error if the log file is missing
    missingok

    # Do not rotate empty log files
    notifempty

    # Do not create a new empty log file after rotation
    nocreate

    # Keep 4 rotated log files
    rotate 4

    # Run scripts only once after all logs are rotated
    sharedscripts

    # Copy the log file and then truncate the original, rather than moving it
    # This ensures that processes with open file descriptors continue to write correctly
    copytruncate
}
{% endif %}