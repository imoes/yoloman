{
 "worker.auth_token_file": "/etc/debusine/token.txt",
 "worker.docker": {
  "host": "unix:///var/run/docker.sock"
 },
 "worker.environment": {
  "HOME": "/builder",
  "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
 },
 "worker.listen.host": "0.0.0.0",
