{
  "worker_id": "ci-worker-04",
  "worker.listen.host": "0.0.0.0",
  "worker.listen.port": 8080,
  "worker.workdir": "/var/lib/debusine/worker",
  "worker.max_concurrent_tasks": 3,
  "worker.task_timeout": 5400,
  "worker.server.url": "https://debusine.example.com",
  "worker.server.verify_tls": true,
  "worker.logging.level": "info",
  "worker.logging.file": "/var/log/debusine/worker.log",
  "worker.resource_limits.memory_mb": 4096,
  "worker.resource_limits.cpus": 2,
  "worker.docker": {
    "host": "unix:///var/run/docker.sock"
  },
  "worker.environment": {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME": "/builder"
  },
  "worker.tls_ca_path": "/etc/ssl/debusine-ca.crt",
  "worker.auth_token_file": "/etc/debusine/token.txt"
}
