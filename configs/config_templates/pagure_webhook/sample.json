{
 "allowed_hosts": [
  "webhook-github.internal",
  "ci-server.example.com"
 ],
 "custom_headers": {
  "X-Auth-Token": "secret123",
  "X-Source": "Pagure"
 },
 "db_path": "/var/lib/pagure/pagure_webhook.db",
 "debug": false,
 "git_dir": "/var/lib/pagure/git",
 "host": "127.0.0.1",
 "log_file": "/var/log/pagure-webhook/pagure-webhook.log",
 "log_level": "INFO",
 "metrics_enabled": true,
 "metrics_endpoint": "/metrics",
 "metrics_port": 9090,
 "pagure_url": "https://git.example.com",
 "port": 5002,
 "proxy_url": "http://proxy.local:3128",
 "rate_limits": [
  {
   "event": "push",
   "requests_per_minute": 100
  },
  {
   "event": "pull_request",
   "requests_per_minute": 20
  }
 ],
 "secret_token": "supersecrettoken123",
 "ssl_cert": "/etc/ssl/certs/pagure-webhook.crt",
 "ssl_enabled": true,
 "ssl_key": "/etc/ssl/private/pagure-webhook.key",
 "triggers": [
  {
   "enabled": true,
   "event": "push"
  },
  {
   "enabled": true,
   "event": "pull_request"
  },
  {
   "enabled": false,
   "event": "issue"
  }
 ],
 "webhook_endpoint": "/hooks",
 "webhook_methods": [
  "POST"
 ],
 "webhook_retries": 3,
 "webhook_retry_delay": 5,
 "webhook_timeout": 20,
 "workers": 4
}
