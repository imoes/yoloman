# =============================================================================
# Pagure Webhook Server Configuration Template
# =============================================================================
# This file configures the Pagure Webhook server, which listens for events
# from the Pagure Git forge (push, pull request, issue, etc.) and forwards
# them to configured external endpoints.
#
# Generated by Ansible Jinja2. Do NOT edit manually.
# =============================================================================

# -----------------------------------------------------------------------------
# Database / Git Storage
# -----------------------------------------------------------------------------

# Absolute path to the directory containing Pagure-managed Git repositories.
# This directory must be accessible by the webhook process.
GIT_DIR = '{{ git_dir | default("/var/lib/pagure/git") }}'

# Absolute path to the SQLite database storing webhook registration and
# delivery metadata (e.g., pending deliveries, retry counts).
DB_PATH = '{{ db_path | default("/var/lib/pagure/pagure_webhook.db") }}'

# -----------------------------------------------------------------------------
# Network Binding
# -----------------------------------------------------------------------------

# IP address or hostname the webhook server should bind to.
# Use '0.0.0.0' to listen on all interfaces, or '127.0.0.1' for local only.
HOST = '{{ host | default("0.0.0.0") }}'

# Port number for the webhook server to listen on.
PORT = {{ port | default(5002) }}

# -----------------------------------------------------------------------------
# Runtime Behavior
# -----------------------------------------------------------------------------

# Enable verbose debug logging and developer-friendly error pages.
# NOT recommended for production; use log_level instead for production tuning.
DEBUG = {{ debug | default(false) | lower }}

# Number of worker threads/processes to handle webhook delivery.
# Adjust based on CPU cores and expected concurrency.
WORKERS = {{ workers | default(2) }}

# -----------------------------------------------------------------------------
# Webhook Delivery Settings
# -----------------------------------------------------------------------------

# Maximum time (in seconds) to wait for a remote webhook endpoint to respond.
WEBHOOK_TIMEOUT = {{ webhook_timeout | default(30) }}

# Number of times to retry delivery if the remote endpoint fails or times out.
WEBHOOK_RETRIES = {{ webhook_retries | default(3) }}

# Delay (in seconds) between successive retry attempts.
WEBHOOK_RETRY_DELAY = {{ webhook_retry_delay | default(5) }}

# -----------------------------------------------------------------------------
# SSL/TLS Configuration
# -----------------------------------------------------------------------------

{% if ssl_enabled | default(false) | bool %}
# SSL is ENABLED. The server will listen on HTTPS using the provided certificate and key.
SSL_ENABLED = True
SSL_CERT = '{{ ssl_cert | default("/etc/ssl/certs/pagure-webhook.crt") }}'
SSL_KEY = '{{ ssl_key | default("/etc/ssl/private/pagure-webhook.key") }}'
{% else %}
# SSL is DISABLED. The server will listen on plain HTTP.
SSL_ENABLED = False
{% endif %}

# -----------------------------------------------------------------------------
# Security & Origin Verification
# -----------------------------------------------------------------------------

# List of allowed hostnames for webhook origin verification.
# Used to prevent SSRF attacks by restricting which Host headers are accepted.
# If empty, all hosts are accepted (not recommended for production).
ALLOWED_HOSTS = [{{ allowed_hosts | default([]) | map('quote') | join(', ') }}]

# Secret token used to sign webhook payloads with HMAC-SHA256.
# If provided, outgoing payloads include a signature header; incoming
# requests can also be verified against this secret for security.
# Keep this value secret and do not commit it to version control.
SECRET_TOKEN = '{{ secret_token | default("") }}'

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Logging verbosity level (CRITICAL, ERROR, WARNING, INFO, DEBUG).
LOG_LEVEL = '{{ log_level | default("INFO") | upper }}'

# Path to a log file. If empty or omitted, logs are written to stdout.
# Ensure the directory exists and is writable by the process user.
{% if log_file | default("") | trim != "" %}
LOG_FILE = '{{ log_file | default("") | trim }}'
{% endif %}

# -----------------------------------------------------------------------------
# Webhook Endpoint Configuration
# -----------------------------------------------------------------------------

# URL path prefix where the webhook receiver endpoint is served.
WEBHOOK_ENDPOINT = '{{ webhook_endpoint | default("/webhook") }}'

# HTTP methods accepted for webhook delivery.
# Typically 'POST' is required; 'GET' or 'PUT' may be added if needed.
WEBHOOK_METHODS = [{{ webhook_methods | default(["POST"]) | map('quote') | join(', ') }}]

# -----------------------------------------------------------------------------
# Event Triggers
# -----------------------------------------------------------------------------

# List of event types that trigger webhook delivery.
# Each entry specifies an event and whether it is enabled.
{% for trigger in triggers | default([{'event': 'push', 'enabled': True}, {'event': 'pull_request', 'enabled': True}, {'event': 'issue', 'enabled': True}]) %}
# Enable webhook delivery for {{ trigger.event }} events.
TRIGGER_{{ trigger.event | upper }} = {{ trigger.enabled | lower }}
{% endfor %}

# -----------------------------------------------------------------------------
# Rate Limiting (per event type)
# -----------------------------------------------------------------------------

# Rate limiting configuration per event type, specifying max requests per minute.
# Prevents overwhelming downstream endpoints with too many events.
{% for rate in rate_limits | default([{'event': 'push', 'requests_per_minute': 60}, {'event': 'pull_request', 'requests_per_minute': 30}, {'event': 'issue', 'requests_per_minute': 30}]) %}
# Rate limit for {{ rate.event }} events: {{ rate.requests_per_minute }} requests per minute.
RATE_LIMIT_{{ rate.event | upper }} = {{ rate.requests_per_minute }}
{% endfor %}

# -----------------------------------------------------------------------------
# Proxy Configuration
# -----------------------------------------------------------------------------

# HTTP/HTTPS proxy URL for outgoing webhook requests.
# Useful if the webhook server is behind a corporate firewall or proxy.
# Format: http://proxy.example.com:3128
# Leave empty to connect directly.
{% if proxy_url | default("") | trim != "" %}
PROXY_URL = '{{ proxy_url | default("") | trim }}'
{% endif %}

# -----------------------------------------------------------------------------
# Custom HTTP Headers
# -----------------------------------------------------------------------------

# Map of custom HTTP headers to include in all outgoing webhook requests.
# Useful for adding authentication tokens or custom metadata.
{% for header, value in (custom_headers | default({})) | dict2items %}
# Custom header: {{ header }} = {{ value }}
HEADER_{{ header | upper | replace('-', '_') }} = '{{ value }}'
{% endfor %}

# -----------------------------------------------------------------------------
# Pagure Forge URL
# -----------------------------------------------------------------------------

# Public base URL of the Pagure forge.
# Used for generating absolute links to repositories, issues, or pull requests
# within webhook payloads.
PAGURE_URL = '{{ pagure_url | default("http://localhost") }}'

# -----------------------------------------------------------------------------
# Prometheus Metrics (Optional)
# -----------------------------------------------------------------------------

{% if metrics_enabled | default(false) | bool %}
# Prometheus-compatible metrics endpoint is ENABLED.
METRICS_ENABLED = True
METRICS_PORT = {{ metrics_port | default(9090) }}
METRICS_ENDPOINT = '{{ metrics_endpoint | default("/metrics") }}'
{% else %}
# Prometheus metrics endpoint is DISABLED.
METRICS_ENABLED = False
{% endif %}