{
  "general": {
    "enabled": true,
    "max_clients": 20,
    "data_dir": "/var/cache/geoclue",
    "log_level": 2,
    "require_consent": true,
    "allowed_origins": [
      "file://",
      "xdg-portal://",
      "org.gnome.SettingsDaemon.Geolocation"
    ],
    "allowed_locales": [
      "en-US",
      "de-DE"
    ],
    "cache_ttl": 300,
    "provider_ttl": 60
  },
  "whitelist": {
    "enabled": false,
    "services": [
      "org.freedesktop.GeoClue2.Client",
      "org.gnome.SettingsDaemon.Geolocation"
    ]
  },
  "providers": [
    {
      "name": "network",
      "enabled": true,
      "config": {
        "timeout": 30
      }
    },
    {
      "name": "gps",
      "enabled": false,
      "config": {
        "device": "/dev/ttyUSB0"
      }
    },
    {
      "name": "wps",
      "enabled": false,
      "config": {}
    },
    {
      "name": "cell",
      "enabled": false,
      "config": {}
    }
  ]
}
