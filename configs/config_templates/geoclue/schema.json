{
  "general": {
    "type": "object",
    "default": {},
    "description": "Global Geoclue service settings",
    "properties": {
      "enabled": {
        "type": "bool",
        "default": true,
        "description": "Whether the Geoclue service is active and can respond to location requests."
      },
      "max_clients": {
        "type": "number",
        "default": 10,
        "description": "Maximum number of simultaneous client connections allowed."
      },
      "data_dir": {
        "type": "string",
        "default": "/var/cache/geoclue",
        "description": "Directory where Geoclue stores cached location data and metadata."
      },
      "log_level": {
        "type": "number",
        "default": 2,
        "description": "Verbosity level for logging (0=errors only, 1=warnings, 2=info, 3=debug)."
      },
      "require_consent": {
        "type": "bool",
        "default": true,
        "description": "If true, users must explicitly grant permission before location data is shared."
      },
      "allowed_origins": {
        "type": "list",
        "default": [
          "file://",
          "xdg-portal://"
        ],
        "description": "List of allowed D-Bus origin bus names or URIs that may request location data.",
        "items": {
          "type": "string",
          "description": "A single allowed origin (e.g., 'org.gnome.SettingsDaemon.Geolocation')"
        }
      },
      "allowed_locales": {
        "type": "list",
        "default": [
          "en-US"
        ],
        "description": "List of locales (language-region codes) to accept for location queries.",
        "items": {
          "type": "string",
          "description": "A locale tag such as 'en-US' or 'fr-FR'."
        }
      },
      "cache_ttl": {
        "type": "number",
        "default": 300,
        "description": "Duration in seconds that cached location results are considered fresh."
      },
      "provider_ttl": {
        "type": "number",
        "default": 60,
        "description": "How often (in seconds) to refresh provider status (e.g., availability of Wi-Fi/gps)."
      }
    }
  },
  "whitelist": {
    "type": "object",
    "default": {},
    "description": "Controls access to location data via a whitelist of allowed services.",
    "properties": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "If true, only explicitly listed services may access Geoclue."
      },
      "services": {
        "type": "list",
        "default": [
          "org.freedesktop.GeoClue2.Client"
        ],
        "description": "List of D-Bus service names permitted to access location data.",
        "items": {
          "type": "string",
          "description": "D-Bus service name, e.g., 'org.gnome.SettingsDaemon.Geolocation'"
        }
      }
    }
  },
  "providers": {
    "type": "list",
    "default": [
      {
        "name": "network",
        "enabled": true,
        "config": {
          "timeout": 30
        }
      },
      {
        "name": "geoname",
        "enabled": false,
        "config": {}
      },
      {
        "name": "gps",
        "enabled": false,
        "config": {}
      },
      {
        "name": "wps",
        "enabled": false,
        "config": {}
      },
      {
        "name": "cell",
        "enabled": false,
        "config": {}
      }
    ],
    "description": "List of geolocation providers with individual enablement and settings.",
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Provider name (e.g., 'network', 'gps', 'wps').",
          "default": ""
        },
        "enabled": {
          "type": "bool",
          "description": "Whether this provider is active.",
          "default": false
        },
        "config": {
          "type": "object",
          "description": "Provider-specific configuration key-value pairs.",
          "default": {},
          "additionalProperties": {
            "type": "string|number|bool"
          }
        }
      }
    }
  }
}
