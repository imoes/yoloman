{
  "server_bin": "/usr/bin/remind",
  "client_bin": "/usr/bin/remindclient",
  "base_dir": "/var/lib/remind",
  "rem_file": "/etc/remind/reminder.rem",
  "log_file": "/var/log/remind/remind.log",
  "pid_file": "/run/remind/remind.pid",
  "run_as_user": "remind",
  "run_as_group": "remind",
  "workers": 2,
  "notify_timeout": 60,
  "daemon_mode": true,
  "verbose": false,
  "sound_on_alarm": true,
  "sound_cmd": "paplay /usr/share/sounds/freedesktop/stereo/bell.oga",
  "popup_on_alarm": true,
  "popup_cmd": "notify-send 'Remind' '{{ message }}' --icon=appointment",
  "notification_channels": [
    {
      "name": "desktop",
      "type": "desktop"
    },
    {
      "name": "email_backup",
      "type": "email",
      "recipient": "admin@example.com",
      "subject": "Remind Alarm: {{ message }}",
      "body_template": "An alarm triggered:\n\n{{ message }}\n\nat {{ datetime }}\n\n\u2014 Remind"
    }
  ],
  "timezone": "America/New_York",
  "default_offset": 10,
  "enable_pre_reminders": true,
  "holidays_files": [
    "/usr/share/remind/holidays/world.cal"
  ],
  "scripts": [
    "/etc/remind/custom.funcs"
  ]
}
