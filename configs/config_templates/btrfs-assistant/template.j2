# Configuration file for btrfs-assistant
# This template manages paths to external tools and maintenance scripts.
# It is self-contained and does not require external service connections.

# ==============================================================================
# Snapper Binary Path
# ==============================================================================
# Description: Absolute path to the snapper binary used for snapshot management.
# Snapper is a tool for managing filesystem snapshots on Btrfs.
snapper = {{ snapper_path | default('/usr/bin/snapper') }}

# ==============================================================================
# Btrfs Maintenance Configuration Path
# ==============================================================================
# Description: Absolute path to the btrfsmaintenance configuration file.
# btrfsmaintenance provides automated maintenance tasks (cleanup, scrub, etc.) for Btrfs.
bm_config = {{ bm_config_path | default('/etc/default/btrfsmaintenance') }}

# ==============================================================================
# Btrfs Maintenance Refresh Script Path
# ==============================================================================
# Description: Absolute path to the cron refresh script for btrfsmaintenance.
# This script is executed to reload or refresh the maintenance configuration.
bm_refresh_script = "{{ bm_refresh_script_path | default('/usr/share/btrfsmaintenance/btrfsmaintenance-refresh-cron.sh') }}"

# ==============================================================================
# Subvolume Mapping Configuration
# ==============================================================================
# Description: Manual mapping between subvolumes and their snapshot directories.
# This section is typically unused if default nested subvolumes are employed by snapper.
# It is only required for non-standard snapshot layouts.
#
# Format: <name> = "<snapshot_subvol>,<source_subvol>,<UUID>"
# - name: A local identifier for the mapping.
# - snapshot_subvol: Path to the snapshot subvolume relative to the Btrfs root.
# - source_subvol: Path to the source subvolume relative to the Btrfs root.
# - UUID: The UUID of the Btrfs filesystem hosting these subvolumes.
#
# Example:
# root = "@snapshots,@,48bee883-0eef-4332-9bc5-65f01295e470"
[Subvol-Mapping]
