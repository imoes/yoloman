# ============================================================
# OTPClient Configuration Template
# ============================================================
# This file configures default behaviors for OTPClient.
# Note: otpclient primarily uses GTK/GSettings for configuration.
# However, for service-like automation or batch generation, we can simulate
# a configuration profile file that maps to the documented CLI options.
#
# This template is SELF-DOCUMENTING. Each directive is preceded by a comment
# explaining its purpose and valid values, derived from the schema.
# ============================================================

[General]
# The hashing algorithm used for OTP generation. Supported values: SHA1, SHA256, SHA512.
algorithm = {{ algorithm | default('SHA1') }}

# The number of digits in the generated OTP code. Must be between 4 and 10.
digits = {{ digits | default(6) }}

# The time period in seconds for TOTP generation. Must be between 10 and 120.
period = {{ period | default(30) }}

[Security]
# Whether to use AES256-GCM encrypted local database storage.
encrypted_storage = {{ encrypted_storage | default(True) | lower }}

# The number of PBKDF2 iterations used to derive the encryption key.
pbkdf2_iterations = {{ pbkdf2_iterations | default(100000) }}

[Import]
# List of supported backup import formats. Options: andOTP, Aegis, FreeOTPPlus, AuthenticatorPlus.
backup_formats = {{ backup_formats | default(['andOTP', 'Aegis']) | join(', ') }}