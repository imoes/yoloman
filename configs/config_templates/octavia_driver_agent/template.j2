[DEFAULT]
# Enable debug logging for the Octavia Driver Agent
{% if debug %}debug = true{% else %}debug = false{% endif %}

# Log file path (empty string disables file logging)
log_file = {{ log_file | default('') }}

# Logging level
{% if log_level %}logging_level = {{ log_level }}{% endif %}

# Path to the Octavia driver agent configuration
state_path = {{ state_path }}

# Worker count for handling requests
{% if worker_count %}workers = {{ worker_count }}{% endif %}

[driver_agent]
# Backend driver module to use for load balancer operations
driver_name = {{ driver_name | default('amphora') }}

# API endpoint for the Octavia controller
{% if controller_endpoint %}controller_endpoint = {{ controller_endpoint }}{% endif %}

# Path to the SSL/TLS CA certificate for controller communication
{% if controller_ca_cert %}controller_ca_cert = {{ controller_ca_cert }}{% endif %}

# Path to the client certificate for mutual TLS authentication
{% if client_cert %}client_cert = {{ client_cert }}{% endif %}

# Path to the client private key
{% if client_key %}client_key = {{ client_key }}{% endif %}

# Timeout (in seconds) for communication with the Octavia controller
{% if controller_timeout %}controller_timeout = {{ controller_timeout }}{% endif %}

# Period (in seconds) for periodic health check of amphorae
{% if amphora_periodic_health_check_interval %}amphora_periodic_health_check_interval = {{ amphora_periodic_health_check_interval }}{% endif %}

# Maximum number of load balancers a single amphora can support
{% if max_loadbalancers_per_amphora %}max_loadbalancers_per_amphora = {{ max_loadbalancers_per_amphora }}{% endif %}

# Enable automatic failover of amphorae on failure
{% if failover_enabled %}failover_enabled = true{% else %}failover_enabled = false{% endif %}

# List of enabled load balancer topologies
{% for topology in loadbalancer_topologies %}# Topology: {{ topology }}
{% endfor %}
loadbalancer_topology = {% for topology in loadbalancer_topologies %}{{ topology }}{% if not loop.last %}, {% endif %}{% endfor %}

# List of enabled provider drivers (used if driver_name='provider_driver')
{% if provider_drivers %}
[provider_drivers]
# Provider driver list
provider_drivers = {% for driver in provider_drivers %}{{ driver }}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}

{% if amphorae %}
[amphorae]
# List of amphora agents to manage
{% for amphora in amphorae %}# Amphora ID: {{ amphora.id }}
{% if amphora.ip %}ip = {{ amphora.ip }}{% endif %}
{% if amphora.compute_id %}compute_id = {{ amphora.compute_id }}{% endif %}
{% if amphora.status %}status = {{ amphora.status }}{% endif %}
{% if amphora.vrrp_ip %}vrrp_ip = {{ amphora.vrrp_ip }}{% endif %}
{% if amphora.ha_ip %}ha_ip = {{ amphora.ha_ip }}{% endif %}
{% endfor %}
{% endif %}

[oslo_messaging]
# AMQP transport URL
{% if transport_url %}transport_url = {{ transport_url }}{% endif %}

# RPC topic name for driver agent communication
{% if rpc_topic %}rpc_topic = {{ rpc_topic }}{% endif %}

# RPC cache duration (in seconds) for message bus connections
{% if rpc_response_timeout %}rpc_response_timeout = {{ rpc_response_timeout }}{% endif %}

[health_executor]
# Backend health manager driver
driver = {{ health_driver | default('health_master') }}

# Enable health manager
{% if health_manager_enabled %}enabled = true{% else %}enabled = false{% endif %}

# Interval (in seconds) between health syncs
{% if health_check_interval %}health_check_interval = {{ health_check_interval }}{% endif %}

# Path to the health manager socket
{% if health_manager_socket %}health_manager_socket = {{ health_manager_socket }}{% endif %}
