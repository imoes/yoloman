# Database host (hostname or IP)
DBHost: {{ db_host }}

# Database name
DBName: {{ db_name }}

# Database user
DBUser: {{ db_user }}

# Database password (leave empty for no password)
DBPass: {{ db_pass | default('') }}

# Database port (0 = default)
DBPort: {{ db_port }}

# Maximum number of concurrent poller processes
# (Set to 0 for automatic scaling based on CPUs)
Concurrency: {{ concurrency }}

# Number of threads per poller process
Threads: {{ threads }}

# Path to the Cacti log directory
LogPath: {{ log_path }}

# Log level: 0=quiet, 1=error, 2=warning, 3=info, 4=debug
LogLevel: {{ log_level }}

# Path to SNMP binary (usually /usr/bin/snmpwalk, /usr/bin/snmpget, etc.)
SNMPWalk: {{ snmp_walk }}
SNMPGet: {{ snmp_get }}
SNMPSet: {{ snmp_set }}
SNMPBulk: {{ snmp_bulk }}
SNMPGetNext: {{ snmp_getnext }}

# SNMP timeout in seconds
SNMPTimeout: {{ snmp_timeout }}

# Enable IPv6 support (true/false)
IPv6: {{ ipv6 | lower }}

# List of additional SNMP options per host (e.g., for v3 authentication)
# Each line is passed directly to SNMP commands (space-separated args)
{% for opt in snmp_opts %}SNMPOpts: {{ opt }}
{% endfor %}

# Path to PHP CLI binary (required for some poller scripts)
PHP: {{ php_path }}

# Path to rrdtool binary
RRDTool: {{ rrdtool_path }}

# Enable SNMPv3 support
SNMPv3: {{ snmpv3_enabled | lower }}

# Path to libmysqlclient (optional, leave blank to use system default)
MySQLLib: {{ mysql_lib | default('') }}
