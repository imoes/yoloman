{
  "db_host": "localhost",
  "db_name": "cacti",
  "db_user": "cacti",
  "db_pass": "cacti_pass",
  "db_port": 3306,
  "concurrency": 0,
  "threads": 4,
  "log_path": "/var/log/cacti",
  "log_level": 3,
  "snmp_walk": "/usr/bin/snmpwalk",
  "snmp_get": "/usr/bin/snmpget",
