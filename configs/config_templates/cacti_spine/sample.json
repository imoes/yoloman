  "snmp_getnext": "/usr/bin/snmpgetnext",
  "snmp_timeout": 500,
  "ipv6": false,
  "snmp_opts": [
    "-l authPriv -u spineuser -a SHA -x AES"
  ],
  "php_path": "/usr/bin/php",
  "rrdtool_path": "/usr/bin/rrdtool",
  "snmpv3_enabled": true,
  "mysql_lib": ""
}
