{
  "spool_directory": "/var/spool/extmail",
  "external_command": "/usr/bin/bsmtp -h smtp.example.com -f %f %t",
  "max_retries": 5,
  "retry_interval": 300,
  "timeout": 600,
  "log_facility": "MAIL",
  "debug_level": 1,
  "always_bcc": "archive@example.com",
  "sender_canonical": "/^user@localhost$/^user@real.example.com/",
  "recipient_canonical": "/@local\\.internal$/@internal.example.com/",
  "queue_only": true,
  "externals": [
    {
      "pattern": "/^bounce-.*@.*$/",
      "command": "/usr/local/bin/bounce-handler.sh"
    }
  ]
}
