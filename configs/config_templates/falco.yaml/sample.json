{
  "rules_files_paths": [
    "/etc/falco/rules.yaml",
    "/etc/falco/rules.d"
  ],
  "gvisor_enabled": false,
  "output_format": "json",
  "output_json_include_properties": true,
  "output_json_add_fields": [
    "proc.aname",
    "container.id"
  ],
  "syscall_enabled": true,
  "syscall_ebpf_enabled": true,
  "syscall_module_enabled": false,
  "buffers_syscalls_size": 1024,
  "log_level": "info",
  "log_stderr": true,
  "log_file_path": "/var/log/falco.log",
  "metrics_enabled": false,
  "metrics_interval": "5s",
  "metrics_endpoint": "/metrics",
  "fim_enabled": false,
  "fim_directories": [
    {
      "path": "/etc",
      "recursive": true
    },
    {
      "path": "/usr/bin",
      "recursive": true
    }
  ],
  "syscall_timeout": 100,
  "json_include_output_properties": true,
  "json_add_fields": [
    "proc.aname",
    "fd.typechar",
    "container.id"
  ],
  "output_file_enabled": false,
  "output_file_path": "/var/log/falco_alerts.json",
  "grpc_enabled": false,
  "grpc_server_enabled": false,
  "grpc_server_bind_address": "0.0.0.0:5060",
  "k8s_audit_enabled": false,
  "k8s_audit_policy_path": "/etc/falco/k8s_audit_policy.yaml",
  "k8s_audit_log_path": "/var/log/kubernetes/audit/audit.log",
  "k8s_audit_log_url": ""
}
