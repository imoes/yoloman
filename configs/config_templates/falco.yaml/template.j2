# ==============================================================================
# Falco Configuration Template
# ==============================================================================
# Falco is a behavioral activity monitor for containers and Linux systems.
# This file controls rule loading, output formatting, system call sources,
# logging, metrics, and optional integrations (gRPC, Kubernetes Audit).
#
# All variables are sourced from Ansible host/group vars or defaults defined
# within this template. If a variable is not defined in Ansible, the schema
# default is used.
# ==============================================================================

# ------------------------------------------------------------------------------
# Rule File Paths
# ------------------------------------------------------------------------------
# List of paths to Falco rules files or directories containing .yaml/.yml rules files.
# Falco reads these files in order. Directories are scanned recursively for .yaml/.yml files.
rules_files:
{% for path in rules_files_paths | default(['/etc/falco/rules.d', '/etc/falco/rules.yaml']) %}
  - "{{ path }}"
{% endfor %}

# ------------------------------------------------------------------------------
# gVisor Support
# ------------------------------------------------------------------------------
# Enable support for gvisor container runtime.
# Requires gvisor and the Falco gvisor plugin to be installed and configured.
gvisor:
  enabled: {{ gvisor_enabled | default(False) | lower }}

# ------------------------------------------------------------------------------
# Output Configuration
# ------------------------------------------------------------------------------
# Global output format: 'text' for human-readable logs, 'json' for structured/machine-parsable logs.
output:
  format: "{{ output_format | default('json') }}"

# ------------------------------------------------------------------------------
# JSON Output Properties and Fields
# ------------------------------------------------------------------------------
# Controls the inclusion of metadata properties (timestamp, hostname, etc.) in JSON output.
# Also allows appending custom JSON fields to every event.
output_json:
  # Include output properties (timestamp, hostname, etc.) in JSON output.
  include_output_properties: {{ output_json_include_properties | default(True) | lower }}
  
  # Additional JSON fields to include in output.
  # Example values: 'proc.aname', 'fd.typechar', 'container.id'
  add_json_fields: {{ output_json_add_fields | default([]) }}

# ------------------------------------------------------------------------------
# Syscall Source Configuration
# ------------------------------------------------------------------------------
# Controls how Falco captures kernel system call events.
# eBPF is the modern, recommended driver. Kernel module is legacy.
syscall:
  # Enable capture of kernel syscall events (required for Falco’s core detection).
  enabled: {{ syscall_enabled | default(True) | lower }}
  
  # eBPF Driver Settings
  ebpf:
    # Enable/disable the eBPF driver.
    # Recommended to be True on modern Linux kernels.
    enabled: {{ syscall_ebpf_enabled | default(True) | lower }}

  # Kernel Module Driver Settings (Legacy Fallback)
  module:
    # Enable/disable the legacy kernel module driver.
    # Should only be True if eBPF is unavailable and you have the kernel module loaded.
    enabled: {{ syscall_module_enabled | default(False) | lower }}

# ------------------------------------------------------------------------------
# Buffer Settings
# ------------------------------------------------------------------------------
# Controls the size of per-CPU ring buffers for syscall events.
# Increase if you see "syscall event lost" warnings in logs.
buffers:
  # Size (in MB) of per-CPU syscall ring buffers.
  syscalls: {{ buffers_syscalls_size | default(1024) }}

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Controls logging verbosity and destinations (stderr vs file).
log_level: "{{ log_level | default('info') }}"
log_stderr: {{ log_stderr | default(True) | lower }}
log_file: "{{ log_file_path | default('/var/log/falco.log') }}"

# ------------------------------------------------------------------------------
# Metrics Configuration (Prometheus)
# ------------------------------------------------------------------------------
# Enables a Prometheus-style metrics endpoint for scraping system health and performance data.
# Requires Falco to be compiled with metrics support enabled.
metrics:
  enabled: {{ metrics_enabled | default(False) | lower }}
  
  # Metrics export interval (e.g., '5s', '1m').
  # Only used if metrics_enabled is True.
  interval: "{{ metrics_interval | default('5s') }}"
  
  # HTTP path for the Prometheus metrics endpoint (e.g., '/metrics').
  endpoint: "{{ metrics_endpoint | default('/metrics') }}"

# ------------------------------------------------------------------------------
# File Integrity Monitoring (FIM)
# ------------------------------------------------------------------------------
# Optional feature to monitor critical system files for unauthorized changes.
fim_enabled: {{ fim_enabled | default(False) | lower }}

fim:
  # List of directories to monitor for file integrity changes.
  # Each entry specifies a path and whether to scan recursively.
  directories:
{% for dir in fim_directories | default([{'path': '/etc', 'recursive': True}, {'path': '/bin', 'recursive': True}, {'path': '/sbin', 'recursive': True}, {'path': '/usr/bin', 'recursive': True}, {'path': '/usr/sbin', 'recursive': True}, {'path': '/usr/lib', 'recursive': True}]) %}
    - path: "{{ dir.path }}"
      recursive: {{ dir.recursive | lower }}
{% endfor %}

# ------------------------------------------------------------------------------
# Syscall Timeout
# ------------------------------------------------------------------------------
# Timeout in milliseconds for syscall event processing.
# If processing takes longer, events may be dropped to maintain system performance.
syscall_timeout: {{ syscall_timeout | default(100) }}

# ------------------------------------------------------------------------------
# JSON Output Properties (Legacy Alias)
# ------------------------------------------------------------------------------
# Alias for output_json.include_output_properties. Kept for backward compatibility.
json_include_output_properties: {{ json_include_output_properties | default(True) | lower }}

# ------------------------------------------------------------------------------
# JSON Add Fields (Legacy Alias)
# ------------------------------------------------------------------------------
# List of additional JSON fields to append to each event output.
# Legacy alias for output_json.add_json_fields.
json_add_fields:
{% for field in json_add_fields | default(['proc.aname', 'fd.typechar', 'container.id']) %}
  - "{{ field }}"
{% endfor %}

# ------------------------------------------------------------------------------
# Output File Configuration
# ------------------------------------------------------------------------------
# Enables writing raw alert events to a file instead of (or in addition to) stdout.
# Useful for local logging or ingestion by log collectors.
output_file:
  # Enable/disable writing to file.
  enabled: {{ output_file_enabled | default(False) | lower }}
  
  # Path to the file where alert events will be written.
  path: "{{ output_file_path | default('/var/log/falco_alerts.json') }}"

# ------------------------------------------------------------------------------
# gRPC Configuration
# ------------------------------------------------------------------------------
# Enables gRPC output for forwarding alerts to external consumers (e.g., Falcosidekick, K8s operators).
grpc:
  # Enable gRPC output.
  enabled: {{ grpc_enabled | default(False) | lower }}
  
  # gRPC Output Settings
  output:
    # Path to an external gRPC output config file (optional).
    # path: "{{ grpc_output_path | default('') }}"

  # gRPC Server Settings
  server:
    # Enable Falco to run as a gRPC server (accept incoming connections).
    # Only set to True if Falco is intended to receive gRPC requests.
    enabled: {{ grpc_server_enabled | default(False) | lower }}
    
    # Host:Port for the gRPC server to bind to.
    bind_address: "{{ grpc_server_bind_address | default('0.0.0.0:5060') }}"

# ------------------------------------------------------------------------------
# Kubernetes Audit Log Configuration
# ------------------------------------------------------------------------------
# Enables monitoring of Kubernetes API server audit logs for security events.
# Requires access to the audit log file or an HTTP endpoint streaming audit logs.
kubernetes_audit:
  # Enable Kubernetes audit log monitoring.
  enabled: {{ k8s_audit_enabled | default(False) | lower }}
  
  # Path to the Kubernetes audit policy YAML file.
  policy: "{{ k8s_audit_policy_path | default('') }}"
  
  # Kubernetes Audit Log Source Configuration
  log:
    # Path to the Kubernetes audit log file (for file-based input).
    path: "{{ k8s_audit_log_path | default('/var/log/kubernetes/audit/audit.log') }}"
    
    # HTTP endpoint URL to stream Kubernetes audit logs (for HTTP-based input).
    url: "{{ k8s_audit_log_url | default('') }}"

# ------------------------------------------------------------------------------
# Rule Overrides (Optional)
# ------------------------------------------------------------------------------
# Allows disabling specific rules or overriding their severity levels.
# Uncomment and add entries as needed to suppress false positives.
# rules:
#   - rule: "Rule Name"
#     enabled: false
#     severity: 0