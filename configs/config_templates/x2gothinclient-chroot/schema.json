{
  "nfs_rpc_pipefs_path": {
    "type": "string",
    "default": "/var/lib/nfs/rpc_pipefs",
    "description": "Path to the NFS rpc_pipefs directory."
  },
  "nfs_sm_path": {
    "type": "string",
    "default": "/var/lib/nfs/sm",
    "description": "Path to the NFS sm directory."
  },
  "nfs_sm_bak_path": {
    "type": "string",
    "default": "/var/lib/nfs/sm.bak",
    "description": "Path to the NFS sm.bak directory."
  },
  "nfs_owner_user": {
    "type": "string",
    "default": "statd",
    "description": "Owner user for NFS directories."
  },
  "nfs_owner_group": {
    "type": "string",
    "default": "nogroup",
    "description": "Owner group for NFS directories."
  }
}
