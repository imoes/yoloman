{
 "bandwidth": {
  "download_limit": 51200,
  "rules": [
   {
    "description": "Local subnet gets higher bandwidth",
    "download_limit": 0,
    "enabled": true,
    "match_type": "src_ip",
    "match_value": "10.0.0.0/24",
    "name": "local_high_priority",
    "upload_limit": 0
   },
   {
    "description": "Block BitTorrent port",
    "download_limit": 0,
    "enabled": true,
    "match_type": "port",
    "match_value": "6881",
    "name": "block_torrent",
    "upload_limit": 0
   }
  ],
  "upload_limit": 10240
 },
 "daemonize": true,
 "grp": "ipband",
 "interfaces": [
  "eth0",
  "eth1"
 ],
 "logfile": "/var/log/ipband/ipband.log",
 "loglevel": 4,
 "logsyslog": true,
 "maxconn": 2048,
 "pidfile": "/var/run/ipband/ipband.pid",
 "statsfile": "/var/lib/ipband/stats",
 "statsinterval": 30,
 "user": "ipband"
}
