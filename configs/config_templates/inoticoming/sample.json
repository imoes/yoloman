{
  "inotify": {
    "logfile": "/var/log/inoticoming/changes.log",
    "pid_file": "/run/inoticoming.pid",
    "initial_search": false,
    "foreground": false,
    "directory": "/srv/incoming/reprepro",
    "actions": [
      {
        "prefix": null,
        "suffix": ".changes",
        "regexp": null,
        "chdir": "/srv/incoming",
        "stdout_to_log": false,
        "stderr_to_log": true,
        "command": "reprepro -s -b /srv/reprepro processincoming stable {}"
      }
    ]
  }
}
