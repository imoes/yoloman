# Spotlighter GTK Configuration
# Configuration file for spotlighter

[input]
# Enable XInput awareness for graphic tablet support
# Default: True
enable_xinput = {{ enable_xinput | default(True) | lower }}

# Spotlight color in hex format (e.g., FF000000 for black with alpha)
# Default is semi-transparent black
spotlight_color = "{{ spotlight_color | default('FF000000') }}"

# Spotlight opacity (0.0 to 1.0)
# 0.0 is fully transparent, 1.0 is fully opaque
# Default: 0.8
spotlight_opacity = {{ spotlight_opacity | default(0.8) }}

# Spotlight border width in pixels
# Default: 2
spotlight_border_width = {{ spotlight_border_width | default(2) }}

# Spotlight border color in hex format
# Default: FF000000 (semi-transparent yellow)
border_color = "{{ border_color | default('FFFFFF00') }}"

# Enable mouse wheel zooming
# Default: True
enable_zoom = {{ enable_zoom | default(True) | lower }}

# Default zoom level (0.5 to 2.0)
# 1.0 is 100% size
# Default: 1.0
zoom_level = {{ zoom_level | default(1.0) }}

# Auto-hide spotlight on mouse inactivity (seconds)
# 0 to disable
# Default: 0
auto_hide_delay = {{ auto_hide_delay | default(0) }}

# Spotlight position: "center", "top-left", "top-right", "bottom-left", "bottom-right"
# Default: center
position = "{{ position | default('center') }}"