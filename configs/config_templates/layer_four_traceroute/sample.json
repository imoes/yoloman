{
  "timeout": 3,
  "start_ttl": 1,
  "max_ttl": 25,
  "probes_per_hop": 3,
  "use_icmp": true,
  "verbose": false,
  "targets": [
    {
      "hostname": "example.com",
      "ports": [
        80,
        443
      ]
    },
    {
      "hostname": "8.8.8.8",
      "ports": [
        53
      ],
      "source_ip": "192.168.1.100"
    }
  ],
  "default_ports": [
    80,
    443,
    53
  ],
  "interface": "eth0",
  "rate_limit": 5
}
