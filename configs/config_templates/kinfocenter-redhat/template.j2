<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
  "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">

<!--
  KDE Info Center Red Hat Menu Descriptor
  This template generates a freedesktop.org menu specification file
  for the "Information" category, typically used in KDE Plasma environments
  on Red Hat-based distributions.
-->

<Menu>
  <!--
    The display name of the menu section.
    Schema: name (default: 'Information')
    Description: A human-readable name for the menu entry.
  -->
  <Name>{{ name | default('Information') }}</Name>

  <!--
    The directory tag associated with this menu section.
    Schema: directory (default: 'kde-information.directory')
    Description: The .desktop file name representing this menu directory.
  -->
  <Directory>{{ directory | default('kde-information.directory') }}</Directory>

  <!--
    The category used to include items in this menu section.
    Schema: category (default: 'X-KDE-information')
    Description: The MenuXDG category key used to filter and group menu entries.
  -->
  <Include>
    <Category>{{ category | default('X-KDE-information') }}</Category>
  </Include>
</Menu>
