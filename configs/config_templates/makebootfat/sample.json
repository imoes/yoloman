{
 "bios_drive": 255,
 "boot_sectors": {
  "fat12": "/usr/lib/syslinux/bios/ldlinux.bss",
  "fat16": "/usr/lib/syslinux/bios/ldlinux.bss",
  "fat32": "/usr/lib/syslinux/bios/ldlinux.bss"
 },
 "excludes": [
  "isolinux",
  "docs"
 ],
 "files": [
  {
   "dest": "ldlinux.sys",
   "source": "/path/to/ldlinux.sys"
  },
  {
   "dest": "syslinux.cfg",
   "source": "/path/to/syslinux.cfg"
  },
  {
   "dest": "linux",
   "source": "/path/to/vmlinuz"
  },
  {
   "dest": "initrd.img",
   "source": "/path/to/initrd.img"
  }
 ],
 "image_directory": "/var/lib/makebootfat/rootfs",
 "label": "BOOTDISK",
 "mbr_fat": true,
 "mbr_file": "/usr/lib/syslinux/bios/mbr.bin",
 "oem_name": "SYSINSTL",
 "output_device": "usb",
 "partition_mode": false,
 "serial": 12345,
 "syslinux_version": "3",
 "zip_compat": true
}
