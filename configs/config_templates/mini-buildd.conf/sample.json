{
  "debian": {
    "suites": [
      "bullseye",
      "bookworm"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ],
    "keyring": "/usr/share/keyrings/debian-archive-keyring.gpg"
  },
  "repositories": [
    {
      "url": "http://deb.debian.org/debian",
      "dist": "bookworm",
      "components": [
        "main",
        "contrib",
        "non-free"
      ],
      "key": "/usr/share/keyrings/debian-archive-keyring.gpg"
    },
    {
      "url": "http://security.debian.org/debian-security",
      "dist": "bookworm-security",
      "components": [
        "main",
        "contrib"
      ],
      "key": "/usr/share/keyrings/debian-archive-keyring.gpg"
    }
  ],
  "paths": {
    "chroot_base": "/var/lib/mini-buildd/chroots",
    "log_dir": "/var/log/mini-buildd",
    "cache_dir": "/var/cache/mini-buildd"
  },
  "daemon": {
    "bind_host": "0.0.0.0",
    "api_port": 8080,
    "max_builds": 6,
    "worker_count": 3,
    "use_https": false,
    "cert_file": "/etc/mini-buildd/ssl/cert.pem",
    "key_file": "/etc/mini-buildd/ssl/key.pem"
  },
  "notifications": {
    "email_enabled": true,
    "email_recipients": [
      "builds@example.com",
      "ops@example.com"
    ],
    "smtp_host": "smtp.example.com",
    "smtp_port": 587,
    "smtp_use_tls": true
  },
  "build": {
    "timeout": 5400,
    "keep_success_artifacts": true,
    "default_packages": [
      "build-essential",
      "devscripts",
      "dpkg-dev",
      "quilt"
    ]
  }
}
