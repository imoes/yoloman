{
  "enabled": true,
  "interface": "eth0",
  "device_name": "Living Room Media Server",
  "min_port": 7500,
  "max_port": 7600,
  "log_level": 3,
  "media_dir": "/srv/rygel/media",
  "trash_dir": "/var/lib/rygel/trash",
  "enable_transcoding": true,
  "transcode_dir": "/var/lib/rygel/transcodes",
  "media_export": {
    "enabled": true,
    "uris": [
      "/srv/rygel/media/videos",
      "/srv/rygel/media/music",
      "/srv/rygel/media/photos"
    ]
  },
  "tracker": {
    "enabled": true,
    "metadata_extract": true
  },
  "plugins": [
    {
      "name": "GstLaunch",
      "enabled": true,
      "description": "Enable GStreamer-based live streams",
      "options": {
        "transcode": "true",
        "formats": "mp3,wav"
      }
    },
    {
      "name": "LMS",
      "enabled": false,
      "description": "Logitech Media Server integration",
      "options": {
        "server_host": "192.168.1.100",
        "server_port": "9000"
      }
    }
  ]
}
