# ============================================================================
# mod_dav_svn - Apache Subversion Module Configuration
# ============================================================================
# This template loads the required Apache modules for Subversion (SVN)
# support. It configures the shared object paths for:
#   1. mod_dav_svn: The core WebDAV module for Subversion.
#   2. mod_authz_svn: Authorization module for repository access control.
#   3. mod_dontdothat: Security module to prevent specific dangerous SVN operations.
# ============================================================================

# Load the core Subversion WebDAV module.
# Default: modules/mod_dav_svn.so
LoadModule dav_svn_module {{ dav_svn_module_path | default('modules/mod_dav_svn.so') }}

# Load the Subversion authorization module.
# This module provides access control via SVNPathAuthz and SVNParentPathAuthz.
# Default: modules/mod_authz_svn.so
LoadModule authz_svn_module {{ authz_svn_module_path | default('modules/mod_authz_svn.so') }}

# Load the 'mod_dontdothat' security module.
# This module helps mitigate risks associated with certain SVN operations.
# Default: modules/mod_dontdothat.so
LoadModule dontdothat_module {{ dontdothat_module_path | default('modules/mod_dontdothat.so') }}
