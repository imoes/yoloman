{
  "server_id": 101,
  "basedir": "/usr",
  "datadir": "/var/lib/mysql",
  "socket": "/run/mysqld/mysqld.sock",
  "port": 3306,
  "max_connections": 200,
  "max_allowed_packet": "128M",
  "default_storage_engine": "InnoDB",
  "wait_timeout": 28800,
  "interactive_timeout": 28800,
  "lock_wait_timeout": 31536000,
  "character_set_server": "utf8mb4",
  "collation_server": "utf8mb4_unicode_ci",
  "enable_binlog": true,
  "binlog_path": "/var/log/mysql/mariadb-bin",
  "binlog_format": "ROW",
  "enable_general_log": false,
  "general_log_file": "/var/log/mysql/mariadb.log",
  "enable_slow_log": true,
  "slow_query_log_file": "/var/log/mysql/mariadb-slow.log",
  "long_query_time": 1,
  "innodb_buffer_pool_size": "1G",
  "innodb_log_file_size": "256M",
  "innodb_flush_method": "O_DIRECT",
  "innodb_read_io_threads": 8,
  "innodb_write_io_threads": 8,
  "innodb_buffer_pool_instances": 8,
  "innodb_flush_log_at_trx_commit": 1,
  "thread_cache_size": 24,
  "table_open_cache": 1024,
  "open_files_limit": 16384,
  "tmp_table_size": "128M",
  "max_heap_table_size": "128M",
  "enable_query_cache": false,
  "query_cache_size": "0",
  "query_cache_limit": "2M",
  "log_error_file": "/var/log/mysql/error.log",
  "skip_name_resolve": true,
  "bind_address": "0.0.0.0",
  "enable_ssl": true,
  "ssl_ca_path": "/etc/mysql/ssl/ca.pem",
  "ssl_cert_path": "/etc/mysql/ssl/server-cert.pem",
  "ssl_key_path": "/etc/mysql/ssl/server-key.pem",
  "default_authentication_plugin": "mysql_native_password",
  "aria_group_commit": "interval",
  "aria_log_file_size": "2G",
  "enable_rocksdb": false,
  "is_master": false,
  "replicate_do_db": [],
  "replicate_ignore_db": [
    "information_schema",
    "performance_schema"
  ],
  "is_slave": true,
  "relay_log_path": "/var/log/mysql/relay-bin",
  "relay_log_index_path": "/var/log/mysql/relay-bin.index",
  "gtid_mode": true,
  "gtid_slave_pos": "",
  "master_host": "db-master.internal",
  "master_port": 3306,
  "master_user": "repl_user",
  "master_password": "REPLACE_WITH_SECURE_SECRET",
  "local_infile": false,
  "use_syslog": false,
  "extra_plugins": [],
  "extra_vars": {}
}
