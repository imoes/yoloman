{
  "drives": {
    "type": "list",
    "default": [],
    "description": "List of GPT drives to configure with partitions and options"
  },
  "drives[].device": {
    "type": "string",
    "default": "",
    "description": "Path to the drive (e.g., /dev/sda, /dev/mmcblk0)"
  },
  "drives[].partitions": {
    "type": "list",
    "default": [],
    "description": "List of partitions for this drive"
  },
  "drives[].partitions[].index": {
    "type": "number",
    "default": 0,
    "description": "Partition index (1-based)"
  },
  "drives[].partitions[].label": {
    "type": "string",
    "default": "",
    "description": "Partition label (string description)"
  },
  "drives[].partitions[].type": {
    "type": "string",
    "default": "data",
    "description": "Partition type: 'data', 'kernel', 'rootfs', or a GUID",
    "enum": [
      "data",
      "kernel",
      "rootfs"
    ]
  },
  "drives[].partitions[].flags": {
    "type": "list",
    "default": [],
    "description": "List of flags (e.g., 'required', 'attempt_first')"
  },
  "drives[].partitions[].priority": {
    "type": "number",
    "default": 0,
    "description": "Kernel partition priority (0 = disabled)"
  },
  "drives[].partitions[].start": {
    "type": "number",
    "default": 0,
    "description": "Starting sector (LBA)"
  },
  "drives[].partitions[].size": {
    "type": "number",
    "default": 0,
    "description": "Size in sectors"
  },
  "drives[].partitions[].guid": {
    "type": "string",
    "default": "",
    "description": "Partition GUID"
  },
  "drives[].partitions[].system": {
    "type": "number",
    "default": 0,
    "description": "System flag: 0 = no, 1 = yes (e.g., for BIOS boot)"
  },
  "drives[].partitions[].tries": {
    "type": "number",
    "default": 0,
    "description": "Number of boot attempts remaining"
  },
  "drives[].partitions[].attributes": {
    "type": "string",
    "default": "",
    "description": "Hexadecimal attributes string (e.g., '0x0000000000000000')"
  }
}
