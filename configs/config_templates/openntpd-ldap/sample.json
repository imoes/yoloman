{
  "listen_addr": [
    "127.0.0.1",
    "10.0.1.5"
  ],
  "allowed_networks": [
    {
      "network": "10.0.1.0",
      "mask": "255.255.255.0"
    },
    {
      "network": "192.168.42.0",
      "mask": "/24"
    }
  ],
  "ldap_uri": "ldaps://ldap.internal.example.com:636",
  "ldap_base_dn": "ou=TimeSources,ou=Infra,dc=internal,dc=example,dc=com",
  "ldap_bind_dn": "cn=ntpd-ldap,ou=Services,dc=internal,dc=example,dc=com",
  "ldap_bind_pw": "s3cr3t_ldap_bind_password",
  "ldap_search_filter": "(&(objectClass=ntpServer)(ntpEnabled=TRUE)(ntpLocation=us-east))",
  "ldap_tls_ca_dir": "/etc/ssl/certs/internal-ca",
  "ldap_tls_reqcert": "demand",
  "min_poll_interval": 120,
  "max_poll_interval": 1800,
  "step_threshold": 0.2,
  "fallback_servers": [
    "time.cloudflare.com",
    "time.google.com"
  ],
  "log_level": 1,
  "leapfile": "/usr/share/zoneinfo/leap-seconds.list"
}
