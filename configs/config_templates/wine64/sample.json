{
  "wine_prefix": "/opt/wine64_prefix",
  "wine_debug": "err+all,fixme-all",
  "wine_arch": "win64",
  "win_dll_overrides": [
    "comdlg32=n,b",
    "shell32=n,b",
    "oleaut32=b"
  ],
  "wine_d3d_config": [
    "renderer=vulkan",
    "VideoPciVendorID=0x10de"
  ],
  "wine_path_extra": [
    "/usr/lib/wine",
    "/opt/myapp/libs"
  ]
}
