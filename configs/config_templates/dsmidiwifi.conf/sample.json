{
  "config": {
    "base_dir": "/var/lib/dsmidiwifi",
    "log_level": 2,
    "syslog": false,
    "interface": "eth0"
  },
  "server": {
    "http_port": 8080,
    "http_host": "",
    "enable_https": true,
    "ssl_cert": "/etc/ssl/certs/dsmidiwifi.crt",
    "ssl_key": "/etc/ssl/private/dsmidiwifi.key"
  },
  "midi": {
    "input_enabled": true,
    "output_enabled": true,
    "default_clock_source": "internal",
    "ports": [
      {
        "name": "hw:1,0,0",
        "direction": "in"
      },
      {
        "name": "hw:1,0,1",
        "direction": "out"
      },
      {
        "name": "synth_in",
        "direction": "in"
      },
      {
        "name": "synth_out",
        "direction": "out"
      }
    ]
  },
  "websocket": {
    "ws_port": 8081,
    "enable_cors": true,
    "allowed_origins": [
      "localhost",
      "192.168.1.10"
    ]
  },
  "ntp": {
    "server": "time.google.com",
    "update_interval": 3600,
    "enabled": true
  },
  "mqtt": {
    "broker": "192.168.1.20",
    "port": 1883,
    "enabled": true,
    "client_id": "dsmidi-wifi-001",
    "topic_base": "studio/dsmidi",
    "qos": 1,
    "retained": false
  },
  "webui": {
    "enabled": true,
    "theme": "dark"
  }
}
