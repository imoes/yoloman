{
 "config": {
  "base_dir": "/var/lib/dsmidiwifi",
  "interface": "eth0",
  "log_level": 2,
  "syslog": false
 },
 "midi": {
  "default_clock_source": "internal",
  "input_enabled": true,
  "output_enabled": true,
  "ports": [
   {
    "direction": "in",
    "name": "hw:1,0,0"
   },
   {
    "direction": "out",
    "name": "hw:1,0,1"
   },
   {
    "direction": "in",
    "name": "synth_in"
   },
   {
    "direction": "out",
    "name": "synth_out"
   }
  ]
 },
 "mqtt": {
  "broker": "192.168.1.20",
  "client_id": "dsmidi-wifi-001",
  "enabled": true,
  "port": 1883,
  "qos": 1,
  "retained": false,
  "topic_base": "studio/dsmidi"
 },
 "ntp": {
  "enabled": true,
  "server": "time.google.com",
  "update_interval": 3600
 },
 "server": {
  "enable_https": true,
  "http_host": "",
  "http_port": 8080,
  "ssl_cert": "/etc/ssl/certs/dsmidiwifi.crt",
  "ssl_key": "/etc/ssl/private/dsmidiwifi.key"
 },
 "websocket": {
  "allowed_origins": [
   "localhost",
   "192.168.1.10"
  ],
  "enable_cors": true,
  "ws_port": 8081
 },
 "webui": {
  "enabled": true,
  "theme": "dark"
 }
}
