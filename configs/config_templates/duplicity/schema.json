    "type": "bool",
    "default": false,
    "description": "Store in S3 Glacier Flexible Retrieval"
  },
  "s3_use_glacier_ir": {
    "type": "bool",
    "default": false,
    "description": "Store in S3 Glacier Instant Retrieval"
  },
  "s3_use_deep_archive": {
    "type": "bool",
    "default": false,
    "description": "Store in S3 Glacier Deep Archive"
  },
  "s3_use_ia": {
    "type": "bool",
    "default": false,
    "description": "Store in S3 Standard-Infrequent Access"
  },
  "s3_use_onezone_ia": {
    "type": "bool",
    "default": false,
    "description": "Store in S3 One Zone-Infrequent Access"
  },
  "s3_use_rrs": {
    "type": "bool",
    "default": false,
    "description": "Store in S3 Reduced Redundancy Storage"
