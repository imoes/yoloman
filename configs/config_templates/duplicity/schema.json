{
  "actions": {
    "type": "list",
    "default": [],
    "description": "Backup actions (e.g., 'backup', 'full', 'incremental', 'restore', 'verify', 'cleanup', 'list-current-files', etc.)"
  },
  "source_dir": {
    "type": "string",
    "default": "",
    "description": "Source directory to back up (required for backup/restore)"
  },
  "target_url": {
    "type": "string",
    "default": "",
    "description": "Target URL (backend://path)"
  },
  "include_list": {
    "type": "list",
    "default": [],
    "description": "List of shell-glob include patterns"
  },
  "exclude_list": {
    "type": "list",
    "default": [],
    "description": "List of shell-glob exclude patterns"
  },
  "filelist_include": {
    "type": "string",
    "default": "",
    "description": "Path to include filelist"
  },
  "filelist_exclude": {
    "type": "string",
    "default": "",
    "description": "Path to exclude filelist"
  },
  "files_from": {
    "type": "string",
    "default": "",
    "description": "Path to file containing explicit files to back up (one per line)"
  },
  "null_separator": {
    "type": "bool",
    "default": false,
    "description": "Use null separators in file lists"
  },
  "encryption_key": {
    "type": "string",
    "default": "",
    "description": "GPG public key ID to encrypt to"
  },
  "sign_key": {
    "type": "string",
    "default": "",
    "description": "GPG signing key ID"
  },
  "gpg_binary": {
    "type": "string",
    "default": "gpg",
    "description": "Path to GPG binary"
  },
  "gpg_options": {
    "type": "string",
    "default": "",
    "description": "Extra GPG options (quoted)"
  },
  "archive_dir": {
    "type": "string",
    "default": "",
    "description": "Custom archive directory"
  },
  "name": {
    "type": "string",
    "default": "",
    "description": "Symbolic name for this backup (affects archive dir)"
  },
  "tempdir": {
    "type": "string",
    "default": "",
    "description": "Override default temp directory"
  },
  "concurrency": {
    "type": "number",
    "default": 1,
    "description": "Number of concurrent backend operations"
  },
  "volsize": {
    "type": "number",
    "default": 200,
    "description": "Volume size in MB"
  },
  "full_if_older_than": {
    "type": "string",
    "default": "",
    "description": "Force full backup if last full is older than this interval (e.g., 1M)"
  },
  "exclude_older_than": {
    "type": "string",
    "default": "",
    "description": "Exclude files older than this interval"
  },
  "no_compression": {
    "type": "bool",
    "default": false,
    "description": "Disable GZip compression"
  },
  "no_encryption": {
    "type": "bool",
    "default": false,
    "description": "Disable encryption"
  },
  "no_check_remote": {
    "type": "bool",
    "default": false,
    "description": "Skip remote manifest validation"
  },
  "time": {
    "type": "string",
    "default": "",
    "description": "Time for restore/list/verify (e.g., 3D, now, ISO8601)"
  },
  "path_to_restore": {
    "type": "string",
    "default": "",
    "description": "Restore a specific path only"
  },
  "compare_data": {
    "type": "bool",
    "default": false,
    "description": "Compare restored files to current files in verify action"
  },
  "filter_globbing": {
    "type": "bool",
    "default": true,
    "description": "Use shell globbing (default)"
  },
  "filter_literal": {
    "type": "bool",
    "default": false,
    "description": "Use literal matching"
  },
  "filter_regexp": {
    "type": "bool",
    "default": false,
    "description": "Use regular expressions"
  },
  "filter_strictcase": {
    "type": "bool",
    "default": false,
    "description": "Case-sensitive pattern matching"
  },
  "filter_ignorecase": {
    "type": "bool",
    "default": false,
    "description": "Case-insensitive pattern matching"
  },
  "copy_links": {
    "type": "bool",
    "default": false,
    "description": "Resolve symlinks"
  },
  "exclude_device_files": {
    "type": "bool",
    "default": false,
    "description": "Exclude device files"
  },
  "exclude_other_filesystems": {
    "type": "bool",
    "default": false,
    "description": "Exclude non-root filesystems"
  },
  "exclude_if_present": {
    "type": "string",
    "default": "",
    "description": "Exclude directories containing this file"
  },
  "file_prefix": {
    "type": "string",
    "default": "",
    "description": "Global filename prefix (e.g., for S3 lifecycle rules)"
  },
  "file_prefix_manifest": {
    "type": "string",
    "default": "",
    "description": "Prefix for manifest files"
  },
  "file_prefix_archive": {
    "type": "string",
    "default": "",
    "description": "Prefix for archive files"
  },
  "file_prefix_signature": {
    "type": "string",
    "default": "",
    "description": "Prefix for signature files"
  },
  "par2_volumes": {
    "type": "number",
    "default": 1,
    "description": "Number of Par2 recovery volumes"
  },
  "par2_redundancy": {
    "type": "number",
    "default": 10,
    "description": "Par2 redundancy percentage"
  },
  "par2_options": {
    "type": "string",
    "default": "",
    "description": "Extra Par2 options (quoted)"
  },
  "skip_if_no_change": {
    "type": "bool",
    "default": false,
    "description": "Skip backup if no files changed"
  },
  "ftp_passive": {
    "type": "bool",
    "default": false,
    "description": "Use FTP passive mode"
  },
  "ftp_regular": {
    "type": "bool",
    "default": false,
    "description": "Use FTP active (PORT) mode"
  },
  "use_scp": {
    "type": "bool",
    "default": false,
    "description": "Use SCP instead of SFTP for SSH"
  },
  "ssh_options": {
    "type": "string",
    "default": "",
    "description": "Extra SSH options (quoted)"
  },
  "scp_command": {
    "type": "string",
    "default": "",
    "description": "SCP command for pexpect backend"
  },
  "sftp_command": {
    "type": "string",
    "default": "",
    "description": "SFTP command for pexpect backend"
  },
  "verbosity": {
    "type": "string",
    "default": "notice",
    "description": "Log verbosity (e/w/n/i/d or error/warning/notice/info/debug)",
    "enum": [
      "error",
      "warning",
      "notice",
      "info",
      "debug",
      "e",
      "w",
      "n",
      "i",
      "d"
    ]
  },
  "no_print_statistics": {
    "type": "bool",
    "default": false,
    "description": "Suppress end-of-run statistics"
  },
  "jsonstat": {
    "type": "bool",
    "default": false,
    "description": "Output JSON statistics"
  },
  "log_fd": {
    "type": "number",
    "default": 0,
    "description": "Write structured logs to file descriptor (e.g., 2 for stderr)"
  },
  "log_file": {
    "type": "string",
    "default": "",
    "description": "File for structured logs"
  },
  "log_timestamp": {
    "type": "bool",
    "default": false,
    "description": "Prefix logs with timestamp"
  },
  "no_restore_ownership": {
    "type": "bool",
    "default": false,
    "description": "Preserve current ownership on restore"
  },
  "numeric_owner": {
    "type": "bool",
    "default": false,
    "description": "Use numeric uid/gid on restore"
  },
  "use_agent": {
    "type": "bool",
    "default": false,
    "description": "Use gpg-agent for passphrase entry"
  },
  "backend_retry_delay": {
    "type": "number",
    "default": 10,
    "description": "Seconds to wait before retrying backend operations"
  },
  "num_retries": {
    "type": "number",
    "default": 3,
    "description": "Number of backend retries"
  },
  "timeout": {
    "type": "number",
    "default": 30,
    "description": "Socket timeout in seconds"
  },
  "allow_source_mismatch": {
    "type": "bool",
    "default": false,
    "description": "Allow same backend used for multiple sources"
  },
  "force": {
    "type": "bool",
    "default": false,
    "description": "Proceed even if data loss is possible"
  },
  "dry_run": {
    "type": "bool",
    "default": false,
    "description": "Dry run: simulate actions"
  },
  "max_blocksize": {
    "type": "number",
    "default": 0,
    "description": "Max blocksize in bytes (must be multiple of 512)"
  },
  "s3_endpoint_url": {
    "type": "string",
    "default": "",
    "description": "S3-compatible endpoint (e.g., for GCS interoperability)"
  },
  "s3_region_name": {
    "type": "string",
    "default": "",
    "description": "S3 region name"
  },
  "s3_multipart_chunk_size": {
    "type": "number",
    "default": 20,
    "description": "S3 multipart chunk size in MB"
  },
  "s3_multipart_max_procs": {
    "type": "number",
    "default": 4,
    "description": "Max concurrent S3 multipart uploads"
  },
