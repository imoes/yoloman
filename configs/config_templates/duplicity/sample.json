{
  "actions": [
    "backup"
  ],
  "source_dir": "/home/me",
  "target_url": "sftp://uid@other.host/some_dir",
  "exclude_list": [
    "/proc",
    "/tmp",
    "/mnt"
  ],
  "gpg_binary": "/usr/bin/gpg",
  "archive_dir": "/var/lib/duplicity/archive",
  "name": "home_daily_s3",
  "volsize": 100,
  "concurrency": 2,
  "full_if_older_than": "1M",
  "no_compression": false,
  "no_encryption": false,
  "tempdir": "/mnt/backup-tmp",
  "verbosity": "notice",
  "jsonstat": true,
  "log_file": "/var/log/duplicity.log",
  "log_timestamp": true,
  "force": false,
  "max_blocksize": 2048,
  "s3_endpoint_url": "https://storage.googleapis.com",
  "s3_region_name": "us-central1",
  "s3_use_glacier": true,
  "par2_volumes": 2,
  "par2_redundancy": 15,
  "ssh_options": "-oIdentityFile=/root/.ssh/id_ed25519",
  "rename_items": [
    {
      "original": "old/docs",
      "new": "archive/docs"
    }
  ],
  "no_files_changed": true,
  "copy_blocksize": 256,
  "timeout": 60,
  "num_retries": 5,
  "backend_retry_delay": 15,
  "ssl_cacert_file": "/etc/ssl/certs/ca-certificates.crt",
  "ssh_askpass": false,
  "imap_mailbox": "INBOX"
}
