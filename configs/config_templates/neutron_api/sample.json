{
 "allow_overlapping_ips": false,
 "api_bind_address": "10.0.0.10",
 "api_port": 9696,
 "api_workers": 4,
 "auth_strategy": "keystone",
 "core_plugin": "ml2",
 "db_connection": "mysql+pymysql://neutron:dbpass@10.0.0.5:3306/neutron",
 "db_connection_timeout": 15,
 "db_max_overflow": 30,
 "db_max_pool_size": 15,
 "db_reconnect_interval": 3,
 "db_reconnect_retries": 20,
 "debug": false,
 "default_dns_domain": "openstack.local",
 "default_floating_pool": "public",
 "dhcp_agent_scheduler": "neutron.scheduler.dhcp_agent_scheduler.AvailableDHCPAgentScheduler",
 "enable_isolated_metadata": true,
 "enable_metadata_proxy": true,
 "floatip_ttl": 7200,
 "keystone_authtoken": {
  "auth_url": "http://10.0.0.1:5000/v3",
  "auth_version": "v3",
  "insecure": false,
  "password": "secretpass",
  "project_domain_name": "Default",
  "project_name": "service",
  "signing_dir": "/var/cache/neutron/keystone-signing",
  "user_domain_name": "Default",
  "username": "neutron"
 },
 "log_dir": "/var/log/neutron",
 "log_file": "neutron-api.log",
 "log_level": "INFO",
 "metadata_host": "10.0.0.11",
 "metadata_port": 8775,
 "metadata_secret": "metadatasecret123",
 "network_scheduler": "neutron.scheduler.network_scheduler.SimpleNetworkScheduler",
 "notification_drivers": [
  "neutron.services.metering.notifications.RoutingDriver"
 ],
 "notification_level": "WARNING",
 "notification_topics": "notifications, metering",
 "oslo_concurrency": {
  "lock_path": "/var/lib/neutron/tmp"
 },
 "quotas": {
  "floatingip": 50,
  "network": 50,
  "port": 500,
  "router": 10,
  "security_group": 50,
  "security_group_rule": 100,
  "subnet": 100
 },
 "region_name": "RegionOne",
 "router_scheduler": "neutron.scheduler.l3_agent_scheduler.LeastRoutersScheduler",
 "rpc_backend": "oslo",
 "service_plugins": [
  "router",
  "trunk"
 ],
 "sg_ttl": 600,
 "transport_url": "rabbit://neutron:secretpass@10.0.0.5:5672/"
}
