{
  "rdma_modules_to_load": [
    "iser",
    "rdma_ucm",
    "rdma_cm",
    "ib_uverbs",
    "ib_mad",
    "ib_sa",
    "ib_core"
  ],
  "enable_kernel_module_loading": true,
  "rdma_provider_lib_dir": "/usr/lib64",
  "rdma_skip_device_prefixes": [
    "lo"
  ],
  "max_rdma_connections": 1024,
  "enable_rdma_netdev": true,
  "rdma_interfaces": [
    {
      "name": "eth1",
      "mode": "ethernet",
      "mtu": 9000,
      "link_layer": "ethernet"
    },
    {
      "name": "ib0",
      "mode": "infiniband",
      "mtu": 4096,
      "link_layer": "infiniband"
    }
  ],
  "enable_subnet_manager": false,
  "subnet_manager_priority": 0
}
