# Knot DNS Server Configuration Template
# This file configures the Knot DNS authoritative name server.
# It controls runtime behavior, logging, database storage, and zone templates.

server:
    # rundir: Directory where the KNOT daemon stores runtime files (e.g., PID file).
    # Default: /run/knot
    rundir: {{ rundir | default('/run/knot') }}

    # server_user: User and group under which the Knot DNS server runs.
    # Format: user:group. Default: knot:knot
    user: {{ server_user | default('knot:knot') }}

    # automatic_acl: Enable automatic ACLs for local addresses.
    # Set to 'on' or 'off'. Default: on
    automatic-acl: {{ automatic_acl | default('on') }}

    # listen: List of addresses and ports to listen on.
    # Commented out by default; Knot will auto-discover interfaces if automatic-acl is on.
    # Example: [ 127.0.0.1@53, ::1@53 ]
    #    listen: [ 127.0.0.1@53, ::1@53 ]

log:
  - target: syslog
    # log_level: Verbosity of logging.
    # Options: critical, error, warning, notice, info, debug.
    # Default: info
    any: {{ log_level | default('info') }}

database:
    # database_storage: Directory where the Knot DNS database is stored.
    # Default: /var/lib/knot
    storage: {{ database_storage | default('/var/lib/knot') }}

remote:
    # remote: List of remote servers for zone transfers (AXFR/IXFR).
    # Uncomment and configure to set up secondary/relay behavior.
    # Example:
    # - id: secondary
    #   address: 192.168.1.1@53
    #
    # - id: primary
    #   address: 192.168.2.1@53

template:
  - id: default
    # template_storage: Directory where zone files for default templates are stored.
    # Default: /var/lib/knot
    storage: {{ template_storage | default('/var/lib/knot') }}
    file: "%s.zone"
