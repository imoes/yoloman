###############################################################################
# Urlview configuration file.
# Man page: man urlview
#
# This configuration file controls the behavior of `urlview`, a tool that scans
# text for URLs and allows the user to select one to open in a browser or other
# application.
###############################################################################

# =============================================================================
# urlview_command
# =============================================================================
# Description: The command to execute when a URL is selected by the user.
# The '%s' placeholder will be replaced by the selected URL.
#
# Default: /usr/bin/url_handler.sh %s (if not explicitly configured)
#
# Note: If this variable is undefined, empty, null, a number, or a boolean,
# the template falls back to the default comment.
{%- if urlview_command is defined and urlview_command is not none and (urlview_command is number or urlview_command is boolean or urlview_command | length > 0) %}
COMMAND {{ urlview_command }}
{%- else %}
# COMMAND /usr/bin/url_handler.sh %s
{%- endif %}
