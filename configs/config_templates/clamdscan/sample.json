{
  "fdpass": true,
  "multiscan": true,
  "verbose": true,
  "log_file": "/var/log/clamdscan.log",
  "config_file": "/etc/clamav/clamd.conf",
  "move_dir": "/var/quarantine",
  "no_summary": false,
  "infected_only": true,
  "ping_attempts": 5,
  "ping_interval": 2,
  "wait": true,
  "targets": [
    "/home",
    "/var/www"
  ]
}
