{
 "archive_features": [
  "unix",
  "chattr",
  "xattrs",
  "acl",
  "selinux",
  "32bit-uids",
  "nsec-time",
  "subvolume"
 ],
 "chunk_size": "32K:64K:256K",
 "compression": "xz",
 "delete": true,
 "digest": "sha256",
 "exclude_file": false,
 "exclude_nodump": true,
 "exclude_submounts": false,
 "hardlink": false,
 "path": "/var/backups/myfs",
 "punch_holes": true,
 "rate_limit_bps": 1048576,
 "reflink": true,
 "seed": "/var/seeds/base.catar",
 "seed_output": true,
 "store": "/var/lib/casync/store",
 "uid_range": "0:65536",
 "uid_shift": "yes",
 "undo_immutable": false
}
