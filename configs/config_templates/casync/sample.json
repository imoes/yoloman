{
  "path": "/var/backups/myfs",
  "store": "/var/lib/casync/store",
  "digest": "sha256",
  "compression": "xz",
  "chunk_size": "32K:64K:256K",
  "seed": "/var/seeds/base.catar",
  "rate_limit_bps": 1048576,
  "exclude_nodump": true,
  "exclude_submounts": false,
  "exclude_file": false,
  "reflink": true,
  "hardlink": false,
  "punch_holes": true,
  "delete": true,
  "undo_immutable": false,
  "seed_output": true,
  "uid_shift": "yes",
  "uid_range": "0:65536",
  "archive_features": [
    "unix",
    "chattr",
    "xattrs",
    "acl",
    "selinux",
    "32bit-uids",
    "nsec-time",
    "subvolume"
  ]
}
