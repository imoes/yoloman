{
  "comment": {
    "type": "string",
    "default": "dragsnap",
    "description": "The name of the process described in the Comment field"
  },
  "condition": {
    "type": "string",
    "default": "half/cornertiling",
    "description": "The description text after 'to run' in the Comment field"
  },
  "exec_path": {
    "type": "string",
    "default": "/usr/lib/budgie-window-shuffler/dragsnap",
    "description": "Absolute path to the executable"
  },
  "gsettings_key": {
    "type": "string",
    "default": "org.ubuntubudgie.windowshuffler dragsnaptiling",
    "description": "GSettings key used for AutostartCondition"
  }
}
