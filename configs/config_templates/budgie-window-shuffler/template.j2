# Budgie Window Shuffler Desktop Entry Configuration
# This template generates a .desktop file to autostart the Budgie Window Shuffler utility.
# It configures the application name, execution path, and conditions under which it launches.

[Desktop Entry]
# Entry type: must be Application for standalone programs
Type=Application

# The name of the process described in the Comment field
# Defaults to 'dragsnap' which is the core component of Budgie Window Shuffler
Name=DragSnap

# Comment field describing what the application does.
# It dynamically inserts the process name and the condition for running.
# Variables:
#   comment: The name of the process (default: 'dragsnap')
#   condition: The description text after 'to run' (default: 'half/cornertiling')
Comment=Kick starts the {{ comment | default('dragsnap') }} process to run {{ condition | default('half/cornertiling') }}

# Absolute path to the executable
# Defaults to the standard Budgie Window Shuffler binary location
Exec={{ exec_path | default('/usr/lib/budgie-window-shuffler/dragsnap') }}

# Do not show the application in the main application menu
# Typically true for utility/daemon-like desktop entries
NoDisplay=true

# Condition for autostarting based on GSettings.
# Uses a GSettings key to check if a specific setting is enabled before launching.
# Format: AutostartCondition=GSettings <key>
# Variable:
#   gsettings_key: GSettings key used for AutostartCondition (default: 'org.ubuntubudgie.windowshuffler dragsnaptiling')
AutostartCondition=GSettings {{ gsettings_key | default('org.ubuntubudgie.windowshuffler dragsnaptiling') }}

# Compatibility flags for GNOME/MATE desktop environments
# Ensures the window shuffler respects restart policies from these environments
X-MATE-AutoRestart=true
X-GNOME-AutoRestart=true
