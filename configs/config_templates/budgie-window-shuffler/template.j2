# Budgie Window Shuffler (DragSnap) Autostart Entry
# This template generates a .desktop file for the Budgie Window Shuffler extension.
# It configures the desktop entry to launch the dragsnap tiling helper with specific GSettings conditions.

# Type of the desktop entry; must be Application for autostart daemons.
Type=Application

# Displayed name of the application in desktop environments.
Name=DragSnap

# Comment describing the application's purpose and the condition under which it runs.
# comment: The name of the process described in the Comment field (default: 'dragsnap')
# condition: The description text after 'to run' in the Comment field (default: 'half/cornertiling')
Comment=Kick starts the {{ comment | default('dragsnap') }} process to run {{ condition | default('half/cornertiling') }}

# Absolute path to the executable that will be launched.
# exec_path: Absolute path to the executable (default: '/usr/lib/budgie-window-shuffler/dragsnap')
Exec={{ exec_path | default('/usr/lib/budgie-window-shuffler/dragsnap') }}

# Prevent the application from appearing in application menus; it runs in the background.
NoDisplay=true

# AutostartCondition specifies the GSettings key to monitor for changes to trigger the application.
# gsettings_key: GSettings key used for AutostartCondition (default: 'org.ubuntubudgie.windowshuffler dragsnaptiling')
AutostartCondition=GSettings {{ gsettings_key | default('org.ubuntubudgie.windowshuffler dragsnaptiling') }}

# Desktop environment compatibility flags for automatic restart.
X-MATE-AutoRestart=true
X-GNOME-AutoRestart=true