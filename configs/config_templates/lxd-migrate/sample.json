{
  "rsync_args": [
    "-avz",
    "--delete",
    "--exclude=/proc/*",
    "--exclude=/sys/*"
  ],
  "verbose": true,
  "target_remote": "lxd-remote-server",
  "target_name": "migrated-debian-box",
  "source_mounts": [
    {
      "path": "/",
      "target": "/"
    },
    {
      "path": "/home",
      "target": "/home"
    }
  ],
  "network": {
    "type": "physical",
    "address": "192.168.1.100",
    "netmask": "255.255.255.0"
  },
  "start_on_create": true
}
