# Ansible-managed configuration for lsd (LS LSD)
# This file is generated dynamically. Do not edit manually.
# Schema field 'config' is a list of parameter maps. This template renders
# standard key-value pairs based on the provided parameters.

{% if config is defined and config is iterable and not config is string %}
{% for param in config %}
{% set name = param.get('name', '') %}
{% set value = param.get('value', None) %}

{% if name == 'color' %}
# Enable color output (always, auto, never)
# Corresponds to --color
color = "{{ value | default('auto') }}"

{% elif name == 'long' %}
# Display extended file metadata as a table
# Corresponds to --long
long = {{ value | default(false) | lower }}

{% elif name == 'permission' %}
# How to display permissions (rwx, octal, numeric)
# Corresponds to --permission
permission = "{{ value | default('rwx') }}"

{% elif name == 'size' %}
# How to display size (default, bytes, si)
# Corresponds to --size
size = "{{ value | default('default') }}"

{% elif name == 'date' %}
# How to display date (date, relative, +format)
# Corresponds to --date
date = "{{ value | default('date') }}"

{% elif name == 'sort' %}
# Sort files by name, time, size, extension, version
# Corresponds to --sort
sort = "{{ value | default('name') }}"

{% elif name == 'inode' %}
# Display the index number (inode) of each file
# Corresponds to --inode
inode = {{ value | default(false) | lower }}

{% elif name == 'context' %}
# Display security context (label) of each file
# Corresponds to --context
context = {{ value | default(false) | lower }}

{% elif name == 'icon' %}
# When to print icons (auto, always, never)
# Corresponds to --icon
icon = "{{ value | default('auto') }}"

{% elif name == 'icon_theme' %}
# Theme to use for icons (fancy, unicode, theme)
# Corresponds to --icon-theme
icon_theme = "{{ value | default('fancy') }}"

{% elif name == 'ignore_globs' %}
# Do not display files/directories with names matching the glob pattern(s)
# Corresponds to -I / --ignore-glob
{% for pattern in value %}
ignore-glob = ["{{ pattern }}"]
{% endfor %}

{% elif name == 'hyperlink' %}
# Attach hyperlink to filenames
# Corresponds to --hyperlink
hyperlink = "{{ value | default('never') }}"

{% elif name == 'group_directories_first' %}
# Display directories at the top before the files
# Corresponds to --group-directories-first
group-directories-first = {{ value | default(false) | lower }}

{% elif name == 'classic' %}
# Enable classic mode (display output similar to ls)
# Corresponds to --classic
classic = {{ value | default(false) | lower }}

{% elif name == 'no_symlink' %}
# Do not display symlink target
# Corresponds to --no-symlink
no-symlink = {{ value | default(false) | lower }}

{% elif name == 'recursive' %}
# Recurse into directories
# Corresponds to -R / --recursive
recursive = {{ value | default(false) | lower }}

{% elif name == 'tree' %}
# Recurse into directories and present the result as a tree
# Corresponds to --tree
tree = {{ value | default(false) | lower }}

{% elif name == 'depth' %}
# Stop recursing into directories after reaching specified depth
# Corresponds to --depth
depth = {{ value | default(0) | int }}

{% elif name == 'directory_only' %}
# Display directories themselves, and not their contents
# Corresponds to --directory-only
directory-only = {{ value | default(false) | lower }}

{% elif name == 'total_size' %}
# Display the total size of directories
# Corresponds to --total-size
total-size = {{ value | default(false) | lower }}

{% elif name == 'classify' %}
# Append indicator (one of */=>@|) at the end of the file names
# Corresponds to -F / --classify
classify = {{ value | default(false) | lower }}

{% elif name == 'oneline' %}
# Display one entry per line
# Corresponds to -1 / --oneline
oneline = {{ value | default(false) | lower }}

{% elif name == 'reverse' %}
# Reverse the order of the sort
# Corresponds to -r / --reverse
reverse = {{ value | default(false) | lower }}

{% elif name == 'no_sort' %}
# Do not sort. List entries in directory order
# Corresponds to -U / --no-sort
no-sort = {{ value | default(false) | lower }}

{% elif name == 'all' %}
# Do not ignore entries starting with .
# Corresponds to -a / --all
all = {{ value | default(false) | lower }}

{% elif name == 'almost_all' %}
# Do not list implied . and ..
# Corresponds to -A / --almost-all
almost-all = {{ value | default(false) | lower }}

{% elif name == 'dereference' %}
# When showing file information for a symbolic link, show information for the file the link references
# Corresponds to -L / --dereference
dereference = {{ value | default(false) | lower }}

{% endif %}
{% endfor %}
{% else %}
# No configuration parameters provided in 'config' list.
{% endif %}