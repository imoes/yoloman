# Megactl configuration for MeRAID diagnostics
# This file is auto-generated by an Ansible role. Do not edit manually.
# All variables use inline defaults to ensure safe rendering even if the role
# fails to pass them. Comments describe the corresponding CLI flags.

# Verbosity level (-v): 0=quiet, 1=info, 2=verbose.
# Controls the amount of output details printed to stdout/stderr.
verbosity: {{ verbosity | default(0) }}

# Log pages to dump (0x02, 0x03, 0x05, 0x0d, 0x10).
# If the list is empty or not provided, the tool uses its standard set.
# If specific pages are listed, ONLY those are inspected.
# Output format: space-separated hex values like "0x02 0x03".
dump_pages: >-
  {% if dump_pages | default([]) | length > 0 %}
  {{ dump_pages | default([]) | map('format', '0x{:02x}') | join(' ') }}
  {% else %}
  none
  {% endif %}

# Self-test type (-T): 'short' or 'long'.
# 'none' initiates no test.
# Allows initiating a diagnostic self-test on the controller.
test_type: {{ test_type | default('none') }}

# Targets to operate on (-t).
# Examples: 'a0', 'a0c0', 'a0c0t0'.
# Empty list means all adapters/disks.
# Iterates safely over the list to produce a space-separated string.
targets: >-
  {% for t in targets | default([]) %}
  {{ t }}{% if not loop.last %} {% endif %}
  {% endfor %}

# Perform adapter health check (-H).
# Inspects logical/physical drives and BBU.
# Boolean flag to enable the health check routine.
run_health_check: {{ run_health_check | default(false) | lower }}

# Ignore battery problems during health check (-B).
# Do not treat battery issues as failures.
# Boolean flag to suppress battery-related errors.
ignore_battery_issues: {{ ignore_battery_issues | default(false) | lower }}

# Exclude physical disks from report (-p).
# Reports only adapters and logical drives.
# Boolean flag to hide physical disk details in the output.
exclude_physical_disks: {{ exclude_physical_disks | default(false) | lower }}