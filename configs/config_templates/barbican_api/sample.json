{
  "barbican_service_name": "barbican",
  "debug": false,
  "user": "barbican",
  "group": "barbican",
  "state_path": "/var/lib/barbican",
  "api_bind_host": "0.0.0.0",
  "api_bind_port": 9311,
  "enable_v1_api": true,
  "cors_allowed_origins": [
    "https://horizon.example.com",
    "https://console.example.com"
  ],
  "auth_strategy": "keystone",
  "keystone_public_endpoint": "https://keystone.example.com:5000",
  "keystone_project_domain_name": "Default",
  "keystone_project_name": "service",
  "keystone_user_domain_name": "Default",
  "keystone_username": "barbican",
  "keystone_password": "barbican_secret_2024!",
  "db_connection_url": "mysql+pymysql://barbican:SuperSecurePass@192.168.1.50/barbican",
  "db_max_pool_size": 15,
  "db_max_overflow": 25,
  "secretstore_plugin": "store_crypto",
  "store_crypto_key": "b64+encoded+256bit+aes+key+here+000000000000000=",
  "store_crypto_key_wrap": "AES_WRAP",
  "worker_processes": 4,
  "worker_threads": 2,
  "worker_timeout": 300,
  "worker_access_log": "-",
  "worker_error_log": "/var/log/barbican/barbican-api.log",
  "worker_log_datefmt": "%Y-%m-%d %H:%M:%S",
  "worker_log_format": "[%(asctime)s] [%(process)d] [%(levelname)s] %(message)s",
  "worker_access_log_format": "%(h)s %(l)s %(u)s %(t)s \"%(r)s\" %(s)s %(b)s \"%(f)s\" \"%(a)s\"",
  "disable_private_key_export": true,
  "max_secret_data_size": 131072
}
