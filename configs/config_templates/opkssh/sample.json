{
  "providers": [
    {
      "issuer_uri": "https://accounts.google.com",
      "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "expiration": "24h"
    },
    {
      "issuer_uri": "https://login.microsoftonline.com/common/v2.0",
      "client_id": "YOUR_MICROSOFT_CLIENT_ID",
      "expiration": "12h"
    }
  ],
  "policy_rules": [
    {
      "principal": "root",
      "identity_spec": "alice@example.com",
      "provider_issuer": "https://accounts.google.com"
    },
    {
      "principal": "root",
      "identity_spec": "oidc:groups:ssh-admins",
      "provider_issuer": ""
    },
    {
      "principal": "deployer",
      "identity_spec": "oidc:\"https://acme.com/groups\":ci-cd"
    }
  ]
}
