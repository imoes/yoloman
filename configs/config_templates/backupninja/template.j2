#
#                          |\_
# B A C K U N I N J A   /()/
#                         `\|
# main configuration file
#
# This file configures the global behavior of the Backupninja
# backup automation framework. It controls logging verbosity,
# email reporting preferences, and directory layouts.
#

# Verbosity level for logs (5=Debug, 4=Info, 3=Warning, 2=Error, 1=Fatal).
# Controls how much detail is written to the main log file.
# how verbose to make the logs
# 5 -- Debugging messages     (and below)
# 4 -- Informational messages (and below)
# 3 -- Warnings               (and below)
# 2 -- Errors                 (and below)
# 1 -- Fatal errors           (only)
loglevel = {{ loglevel | default(4) }}

# Produce prometheus metrics of backup status.
# Requires `prometheus-node-exporter` to be installed
reportprom = {{ reportprom | default(False) }}

# Email address (local part only) to receive backup reports.
# send a summary of the backup status to
# this email address:
reportemail = {{ emailto | default('root') }}

# Send email report even if all modules succeeded.
# if set to 'yes', a report email will be generated
# even if all modules reported success. (default = yes)
reportsuccess = {{ reportsuccess | default(True) }}

# Include info messages from handlers in email reports.
# if set to 'yes', info messages from handlers will be
# sent into the email (default = no)
reportinfo = {{ reportinfo | default(False) }}

# Send email report even if there were no errors.
# if set to 'yes', a report email will be generated
# even if there was no error. (default = yes)
reportwarning = {{ reportwarning | default(True) }}

# Include disk space usage in backup email reports.
# if set to 'yes', disk space usage will be included in
# the backup email report
reportspace = {{ reportspace | default(False) }}

# Remote host to rsync backupninja logs for aggregation.
# Empty string means disabled.
# where to rsync the backupninja.log to be aggregated in
# a ninjareport
reporthost = {{ reporthost | default('') }}

# what user to connect to reporthost to sync the
# backupninja.log
reportuser = ninja

# where on the reporthost should the report go
# NOTE: the name of the log will be used in the report,
# use a globally unique name, preferably the hostname
reportdirectory = /var/lib/backupninja/reports

# number of columns the report email body should wrap to
#reportwrap = 80

# set to the administration group that is allowed to
# read/write configuration files in /etc/backup.d
admingroup = root

#######################################################
# for most installations, the defaults below are good #
#######################################################

# Where the main backupninja log file is located.
# where to log:
logfile = {{ masterlogfile | default('/var/log/backupninja.log') }}

# Directory where all the backup configuration files live.
# directory where all the backup configuration files live
configdirectory = {{ tmpdir | default('/etc/backup.d') }}

# where backupninja helper scripts are found
scriptdirectory = /usr/share/backupninja

# where backupninja libs are found
libdirectory = /usr/lib/backupninja

# whether to use colors in the log file
usecolors = yes

# default value for 'when'
when = everyday at 01:00

# programs paths
# SLAPCAT=/usr/sbin/slapcat
# LDAPSEARCH=/usr/bin/ldapsearch
# RDIFFBACKUP=/usr/bin/rdiff-backup
# CSTREAM=/usr/bin/cstream
# MYSQL=/usr/bin/mysql
# MYSQLHOTCOPY=/usr/bin/mysqlhotcopy
# MYSQLDUMP=/usr/bin/mysqldump
# PSQL=/usr/bin/psql
# PGSQLDUMP=/usr/bin/pg_dump
# PGSQLDUMPALL=/usr/bin/pg_dumpall
# GZIP=/bin/gzip
# GZIP_OPTS='--rsyncable'
# RSYNC=/usr/bin/rsync