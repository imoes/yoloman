{
  "tmpdir": "/etc/backupninja",
  "logdir": "/var/log/backupninja",
  "masterlogfile": "/var/log/backupninja/master.log",
  "emailresults": true,
  "emailto": "admin@example.com",
  "smtpserver": "smtp.example.com",
  "smtpport": 587,
  "smtptls": 1,
  "smtpfrom": "backup@example.com",
  "retention_days": 45,
  "maxjobs": 2,
  "dryrun": false,
  "actions": [
    {
      "name": "duplicity",
      "when": "0 3 * * 0",
      "options": [
        "--full-if-older-than",
        "1W",
        "file:///backup/full"
      ],
      "description": "Weekly full duplicity backup to local storage"
    },
    {
      "name": "rsync",
      "when": "0 1 * * *",
      "options": [
        "--archive",
        "--delete",
        "/data/",
        "/backup/rsync/"
      ],
      "description": "Daily rsync of data directory"
    },
    {
      "name": "mysqldump.sh",
      "when": "",
      "options": [
        "--all-databases",
        "--single-transaction"
      ],
      "description": "MySQL full dump on each backupninja run"
    },
    {
      "name": "cloudsync.sh",
      "when": "30 5 * * *",
      "options": [
        "--provider",
        "s3",
        "--bucket",
        "backup-bucket"
      ],
      "description": "Upload local backups to S3"
    }
  ]
}
