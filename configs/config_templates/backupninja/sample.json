{
  "admingroup": "root",
  "libdirectory": "/usr/lib/backupninja",
  "loglevel": "4",
  "reportdirectory": "/var/lib/backupninja/reports",
  "reporthost": "=",
  "reportinfo": "no",
  "reportprom": "false",
  "reportspace": "no",
  "reportsuccess": "yes",
  "reportuser": "ninja",
  "reportwarning": "yes",
  "reportwrap": "80",
  "scriptdirectory": "/usr/share/backupninja",
  "usecolors": "yes",
  "when": "everyday at 01:00"
}
