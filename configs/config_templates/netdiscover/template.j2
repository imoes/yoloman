# Netdiscover configuration for auto-scan ranges.
#
# This template generates the list of CIDR network ranges that
# netdiscover will scan in auto-discovery mode.
#
# Source variable: ranges (list of strings)
# Default: ['192.168.0.0/16', '172.16.0.0/12', '10.0.0.0/8']

# List of network CIDR ranges to scan in auto-scan mode.
# One range per line in the config file.
# Overrides the default ranges (192.168.0.0/16, 172.16.0.0/12, 10.0.0.0/8)
{% for range in ranges | default(['192.168.0.0/16', '172.16.0.0/12', '10.0.0.0/8']) %}
{{ range }}
{% endfor %}