{
  "cache_path": "/var/cache/lomiri/upload-manager",
  "max_cache_size": 10737418240,
  "max_concurrent_uploads": 2,
  "max_retries": 3,
  "retry_delay": 120,
  "compress_uploads": true,
  "allow_metered_uploads": false,
  "auto_start_on_charging": true,
  "backends": [
    "ftp",
    "http"
  ],
  "backend_enabled": {
    "ftp": true,
    "http": true
  },
  "backend_hosts": {
    "ftp": "ftp.example.com",
    "http": "https://upload.example.com"
  },
  "backend_users": {
    "ftp": "uploader"
  },
  "backend_passwords": {
    "ftp": "secret123"
  },
  "backend_paths": {
    "ftp": "/incoming",
    "http": "/upload"
  },
  "backend_ftp_tls": {
    "ftp": true
  }
}
