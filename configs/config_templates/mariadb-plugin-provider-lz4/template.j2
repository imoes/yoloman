[server]
# plugin_load_add: The plugin to load for LZ4 compression support.
# The name of the MariaDB/MySQL plugin to be loaded.
# Default: 'provider_lz4'
plugin_load_add={{ plugin_load_add | default('provider_lz4') }}

# provider_lz4: The loading mode for the LZ4 provider plugin.
# Specifies whether the plugin is loaded permanently, optionally, or forcibly.
# Valid values usually include: 'force', 'force_plus_permanent', 'optional'.
# Default: 'force_plus_permanent'
provider_lz4={{ provider_lz4 | default('force_plus_permanent') }}