{
  "port": 3001,
  "allow_hosts": [
    "127.0.0.1",
    "192.168.1.0/24"
  ],
  "deny_hosts": [],
  "server_root": "/usr/share/owhttpd/www",
  "max_connections": 15,
  "idle_timeout": 300,
  "compression": true,
  "verbosity": 4,
  "log_file": "/var/log/owhttpd/owhttpd.log",
  "buses": [
    {
      "index": 1,
      "type": "usb",
      "device": "all",
      "params": ""
    },
    {
      "index": 2,
      "type": "net",
      "device": "server.local:4304",
      "params": "timeout=2"
    }
  ],
  "mount_point": "/mnt/1wire",
  "ssl_certificate": "",
  "ssl_private_key": "",
  "pid_file": "/run/owhttpd.pid"
}
