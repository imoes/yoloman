#!/bin/sh

### BEGIN INIT INFO
# Provides:          owhttpd
# Required-Start:    $remote_fs $network $syslog $named
# Required-Stop:     $remote_fs $network $syslog $named
# Should-Start:      owserver
# Should-Stop:       owserver
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: 1-wire HTTP server
# Description:       Start and stop a tiny webserver for 1-wire control.
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# The service name used for the daemon binary, PID file, and log messages.
# Default: 'owhttpd'
DESC="1-Wire HTTP Daemon"
NAME="{{ name | default('owhttpd') }}"

# The daemon binary path, constructed from the service name.
DAEMON=/usr/bin/{{ name | default('owhttpd') }}

# Directory where the PID file is stored.
# Default: '/var/run/owfs'
PIDDIR={{ pid_dir | default('/var/run/owfs') }}

# The full path to the PID file.
PIDFILE=$PIDDIR/{{ name | default('owhttpd') }}.pid

# The main configuration file passed to the daemon.
CONFFILE=/etc/owfs.conf

# Gracefully exit if the package has been removed.
test -x $DAEMON || exit 0

. /lib/lsb/init-functions

d_start() {
    # Ensure the PID directory exists with correct permissions.
    [ -d $PIDDIR ] || {
    mkdir -m 0775 -p $PIDDIR
    chown root:root $PIDDIR >/dev/null 2>&1
    }
    # Start the daemon with its configuration and PID file.
    start-stop-daemon --start --quiet --oknodo --exec $DAEMON -- -c $CONFFILE \
        --pid-file $PIDFILE
    # ensure the daemon has been started 
    sleep 1
    pidofproc -p $PIDFILE $DAEMON >/dev/null
}

d_stop() {
    # Stop the running daemon.
    start-stop-daemon --stop --quiet --oknodo --exec $DAEMON
    sleep 1
    # Clean up stale PID file if the process is no longer running.
    if [ -f $PIDFILE ] && ! ps h `cat $PIDFILE` > /dev/null
    then
        # Stale PID file (owhttpd was successfilly stoped),
        #remove it
        rm -f $PIDFILE
    fi
}

d_status() {
    # Check if the daemon process is currently running.
    pidofproc -p $PIDFILE $DAEMON > /dev/null
}

case "$1" in
    start)
        log_daemon_msg "Starting $DESC" "$NAME"
        d_start
        log_end_msg $?
        ;;
    stop)
        log_daemon_msg "Stopping $DESC" "$NAME"
        d_stop
        log_end_msg $?
        ;;
    restart|force-reload)
        log_daemon_msg "Restarting $DESC" "$NAME"
        d_status && d_stop
        d_start
        log_end_msg $?
        ;;
    status)
        d_status
        if [ $? -eq 0 ];then
            log_success_msg "$NAME is running"
        else
            log_failure_msg "$NAME is not running"
        fi
        ;;
    *)
        echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
        exit 1
        ;;
esac

exit 0