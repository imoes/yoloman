{
  "nsd_port": 53,
  "nsd_verbosity": 0,
  "nsd_username": "nsd",
  "nsd_zonesdir": "/etc/nsd",
  "nsd_zonelistfile": "/var/lib/nsd/zone.list",
  "nsd_database": "",
  "nsd_logfile": "/var/log/nsd.log",
  "nsd_pidfile": "",
  "nsd_round_robin": true,
  "nsd_minimal_responses": true,
  "nsd_refuse_any": true,
  "nsd_server_d_include": "\"/etc/nsd/server.d/*.conf\"",
  "nsd_conf_d_include": "\"/etc/nsd/conf.d/*.conf\"",
  "nsd_control_enable": true,
  "nsd_control_interface": "",
  "nsd_control_interface_path": "/run/nsd/nsd.ctl",
  "nsd_control_port": 8952
}
