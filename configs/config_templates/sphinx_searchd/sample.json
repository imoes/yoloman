{
  "db_host": "localhost",
  "db_port": 3306,
  "db_user": "sphinx",
  "db_pass": "sphinxpass",
  "db_name": "products",
  "start_id": 0,
  "end_id": 1000000,
  "data_path": "/var/lib/sphinxsearch/data",
  "morphology": "stem_en",
  "min_word_len": 2,
  "min_prefix_len": 2,
  "min_infix_len": 3,
  "charset_type": "utf-8",
  "charset_table": [
    "a..z,A..Z->a..z,A..Z,0..9",
    "U+410..U+42F->U+430..U+44F",
    "U+430..U+44F"
  ],
  "indexer_mem_limit": "512M",
  "searchd_listen_host": "0.0.0.0",
  "searchd_listen_port": 9312,
  "log_path": "/var/log/sphinxsearch",
  "searchd_read_timeout": 5,
  "searchd_max_children": 20,
  "pid_path": "/var/run/sphinxsearch",
  "binlog_path": "/var/lib/sphinxsearch/binlog",
  "binlog_flush": "1",
  "binlog_max_ram": "2G",
  "searchd_worker_threads": 8,
  "searchd_plugins": [
    {
      "plugin_dir": "/usr/lib/sphinx/plugins"
    }
  ],
  "searchd_listen_options": [
    {
      "name": "MySQL protocol listener",
      "listen_spec": "",
      "port": 9306,
      "protocol": "mysql"
    },
    {
      "name": "HTTP listener",
      "listen_spec": "",
      "port": 8080,
      "protocol": "http"
    }
  ]
}
