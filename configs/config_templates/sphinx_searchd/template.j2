# =============================================================================
# Sphinx Search Daemon (searchd) Configuration
# =============================================================================
# This template generates sphinx.conf for the Sphinx search engine daemon.
# It connects to a MySQL/MariaDB database to index documents and exposes a
# native API and SphinxQL interface on a TCP port.

# -----------------------------------------------------------------------------
# Data Storage & Indexing Parameters
# -----------------------------------------------------------------------------

# Base path for storing index files and binary logs.
# Default: /var/lib/sphinxsearch/data
data_path = {{ data_path | default('/var/lib/sphinxsearch/data') }}

# -----------------------------------------------------------------------------
# Source Definition: MySQL Data Source
# -----------------------------------------------------------------------------

source main_source {
    type            = mysql

    # MySQL database host address.
    # Default: localhost
    host            = {{ db_host | default('localhost') }}

    # MySQL database port.
    # Default: 3306
    port            = {{ db_port | default(3306) }}

    # MySQL user for Sphinx to connect as.
    # Default: sphinx
    user            = {{ db_user | default('sphinx') }}

    # MySQL password. Use an empty string if no password is needed.
    # Default: ''
    pass            = {{ db_pass | default('') }}

    # Name of the MySQL database to index.
    # Default: sphinx
    db              = {{ db_name | default('sphinx') }}

    # SQL query to fetch data for indexing.
    # Uses start_id and end_id for incremental indexing.
    query           = SELECT id, title, content, published_at FROM documents WHERE id > {{ start_id | default(0) }} AND id <= {{ end_id | default(999999999) }}

    # Define attributes available for filtering/sorting.
    sql_attr_uint   = id
    sql_attr_timestamp = published_at
}

# -----------------------------------------------------------------------------
# Index Definition
# -----------------------------------------------------------------------------

index main_index {
    source          = main_source

    # Path for the index files (appends index name to data_path).
    path            = {{ data_path | default('/var/lib/sphinxsearch/data') }}/main_index

    # Morphology processor to use for text analysis.
    # Options: stem_en, stem_ru, stem_en2, none, etc.
    # Default: stem_en
    morphology      = {{ morphology | default('stem_en') }}

    # Minimum word length to index.
    # Default: 1
    min_word_len    = {{ min_word_len | default(1) }}

    # Minimum prefix length for prefix indexing.
    # Set to 0 to disable prefix indexing.
    # Default: 0
    min_prefix_len  = {{ min_prefix_len | default(0) }}

    # Minimum infix length for infix indexing (used for infix type indexes).
    # Set to 0 to disable infix indexing.
    # Default: 0
    min_infix_len   = {{ min_infix_len | default(0) }}

    # Charset type for text processing.
    # Common values: utf-8, sbcs.
    # Default: utf-8
    charset_type    = {{ charset_type | default('utf-8') }}

    # List of charset mapping rules.
    # If empty, default charset tables are used.
    # Default: [] (empty)
    {% if charset_table | default([]) | length > 0 %}
    charset_table   = {{ charset_table | default([]) | join(',') }}
    {% else %}
    # charset_table is empty; using default mappings.
    {% endif %}
}

# -----------------------------------------------------------------------------
# Indexer Settings
# -----------------------------------------------------------------------------

indexer {
    # Maximum memory the indexer process can use.
    # Formats: e.g., '128M', '512M', '1G'.
    # Default: 256M
    mem_limit       = {{ indexer_mem_limit | default('256M') }}
}

# -----------------------------------------------------------------------------
# Search Daemon (searchd) Settings
# -----------------------------------------------------------------------------

searchd {
    # IP address and port searchd listens on.
    # Format: host:port. Use '0.0.0.0:9312' for all interfaces.
    # Default: 0.0.0.0:9312
    listen          = {{ searchd_listen_host | default('0.0.0.0') }}:{{ searchd_listen_port | default(9312) }}

    # Path to the main searchd log file.
    # Default: /var/log/sphinxsearch/searchd.log
    log             = {{ log_path | default('/var/log/sphinxsearch') }}/searchd.log

    # Path to the query log file.
    # Default: /var/log/sphinxsearch/query.log
    query_log       = {{ log_path | default('/var/log/sphinxsearch') }}/query.log

    # Read timeout in seconds for client connections.
    # Default: 5
    read_timeout    = {{ searchd_read_timeout | default(5) }}

    # Maximum number of worker processes searchd can spawn.
    # Default: 30
    max_children    = {{ searchd_max_children | default(30) }}

    # Path to the PID file.
    # Default: /var/run/sphinxsearch/searchd.pid
    pid_file        = {{ pid_path | default('/var/run/sphinxsearch') }}/searchd.pid

    # Path for binary log files (used for replication/cluster).
    # Default: /var/lib/sphinxsearch/data
    binlog_path     = {{ binlog_path | default('/var/lib/sphinxsearch/data') }}

    # Flush binlog on every transaction.
    # 1 = safe (sync on every write), 0 = faster but less durable.
    # Default: 1
    binlog_flush    = {{ binlog_flush | default('1') }}

    # Maximum RAM to allocate for binlog files.
    # Format: e.g., '512M', '1G'.
    # Default: 1G
    binlog_max_ram  = {{ binlog_max_ram | default('1G') }}

    # Number of worker threads for request handling.
    # Default: 4
    worker_threads  = {{ searchd_worker_threads | default(4) }}
}