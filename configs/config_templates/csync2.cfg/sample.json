{
  "home": "/var/lib/csync2",
  "database_dir": "/var/lib/csync2",
  "log_file": "/var/log/csync2.log",
  "verbose": 1,
  "exclude_patterns": [
    "*.tmp",
    "*.bak",
    ".git/",
    "*.swp",
    "node_modules/"
  ],
  "auth_mode": "shared_secret",
  "secret": "cluster-secret-2024",
  "ssl_cert": "/etc/csync2/certs/csync2_cert.pem",
  "ssl_key": "/etc/csync2/certs/csync2_key.pem",
  "ssl_ca": "/etc/csync2/certs/ca.pem",
  "peers": [
    {
      "name": "web1.example.com"
    },
    {
      "name": "web2.example.com"
    },
    {
      "name": "web3.example.com"
    }
  ],
  "groups": [
    {
      "name": "www_data",
      "paths": [
        "/var/www",
        "/etc/nginx"
      ],
      "auto": true,
      "group": "www-data",
      "user": "root",
      "mode": "0755"
    },
    {
      "name": "etc_critical",
      "paths": [
        "/etc/hosts",
        "/etc/resolv.conf"
      ],
      "auto": false,
      "group": "root",
      "user": "root"
    }
  ]
}
