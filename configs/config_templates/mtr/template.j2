# ==============================================================================
# MTR (My TraceRoute) Diagnostic Script Wrapper
# ==============================================================================
#
# NOTE: MTR does not use a native configuration file on disk. This Jinja2 template
# generates a self-contained Bash script that enforces consistent diagnostic
# parameters via environment variables and explicit command-line flags.
#
# The MTR_OPTIONS environment variable provides a baseline of default flags
# (e.g., report mode), which can be overridden by individual flags specified
# below. For more information, consult `man mtr` section ENVIRONMENT.
#
# Generated by Ansible Jinja2 Template
# ==============================================================================

#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------------------------
# Default Options
# ------------------------------------------------------------------------------
# Description: Default options string passed via MTR_OPTIONS env var.
# Overrides are handled by explicit flags below.
export MTR_OPTIONS="{{ mtr_options | default('--report --report-wide') }}"

# ------------------------------------------------------------------------------
# Target Host
# ------------------------------------------------------------------------------
# Description: The destination hostname or IP address to trace.
TARGET_HOST="{{ target_host | default('8.8.8.8') }}"

# ------------------------------------------------------------------------------
# Protocol Selection
# ------------------------------------------------------------------------------
# Description: Protocol to use for probes: icmp, udp, tcp, or sctp.
# Flag Mapping: icmp (none), udp (-u), tcp (-T), sctp (-S)
PROTOCOL_ARG=""
{% set protocol = protocol | default('icmp') %}
{% if protocol == 'udp' %}
PROTOCOL_ARG="-u"
{% elif protocol == 'tcp' %}
PROTOCOL_ARG="-T"
{% elif protocol == 'sctp' %}
PROTOCOL_ARG="-S"
{% endif %}

# ------------------------------------------------------------------------------
# Source Interface
# ------------------------------------------------------------------------------
# Description: Network interface name to send probes from (e.g., eth0).
# Leave empty for default route.
# Flag Mapping: -I NAME
INTERFACE_ARG=""
{% set interface = interface | default('') %}
{% if interface %}
INTERFACE_ARG="-I {{ interface }}"
{% endif %}

# ------------------------------------------------------------------------------
# Source Port (UDP Only)
# ------------------------------------------------------------------------------
# Description: Source port number for UDP traces. Only used if protocol is udp.
# 0 means auto-select by the OS.
# Flag Mapping: -L LOCALPORT
LOCALPORT_ARG=""
{% set local_port = local_port | default(0) %}
{% if local_port != 0 %}
LOCALPORT_ARG="-L {{ local_port }}"
{% endif %}

# ------------------------------------------------------------------------------
# Packet Size
# ------------------------------------------------------------------------------
# Description: Packet size in bytes for ICMP/TCP/UDP probes.
# Flag Mapping: -s PACKETSIZE
{% set packet_size = packet_size | default(64) %}
PSIZE_ARG="-s {{ packet_size }}"

# ------------------------------------------------------------------------------
# Report Cycles
# ------------------------------------------------------------------------------
# Description: Number of cycles (seconds) to run in report mode.
# Flag Mapping: -c COUNT
{% set report_cycles = report_cycles | default(10) %}
CYCLE_ARG="-c {{ report_cycles }}"

# ------------------------------------------------------------------------------
# Probe Interval
# ------------------------------------------------------------------------------
# Description: Interval in seconds between probe packets.
# Flag Mapping: -i SECONDS
{% set interval_seconds = interval_seconds | default(1) %}
INTERVAL_ARG="-i {{ interval_seconds }}"

# ------------------------------------------------------------------------------
# Maximum TTL (Hops)
# ------------------------------------------------------------------------------
# Description: Maximum number of hops (TTL) to trace.
# Flag Mapping: -m NUM
{% set max_ttl = max_ttl | default(30) %}
MAX_TTL_ARG="-m {{ max_ttl }}"

# ------------------------------------------------------------------------------
# Display Mode
# ------------------------------------------------------------------------------
# Description: Initial display mode: 0 (statistics), 1 (stripchart no latency),
# 2 (stripchart with latency). For automated processing/reporting, mode 0 is
# usually preferred.
# Flag Mapping: --displaymode MODE
{% set display_mode = display_mode | default(0) %}
DISPLAYMODE_ARG="--displaymode {{ display_mode }}"

# ------------------------------------------------------------------------------
# Command Execution
# ------------------------------------------------------------------------------
# Assemble and execute the MTR command with all configured arguments.
CMD="mtr $PROTOCOL_ARG $INTERFACE_ARG $LOCALPORT_ARG $PSIZE_ARG $CYCLE_ARG $INTERVAL_ARG $MAX_TTL_ARG $DISPLAYMODE_ARG $TARGET_HOST"

echo "Running: $CMD"
exec $CMD