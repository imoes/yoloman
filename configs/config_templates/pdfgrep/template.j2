# pdfgrep configuration for batch processing or script integration
# Note: pdfgrep is primarily a CLI tool. This template generates a wrapper script
# or configuration list of arguments to be consumed by a scheduler or init system.

# The regular expression pattern to search for. Corresponds to -e/--regexp.
pattern: {{ pattern | default('pdfgrep') }}

# List of PDF files or directories to search. Corresponds to FILE...
files: {{ files | default(['/var/lib/docs']) }}

# Use Perl-compatible regular expressions. Corresponds to -P/--perl-regexp.
use_perl_regex: {{ use_perl_regex | default(false) | lower }}

# Ignore case distinctions. Corresponds to -i/--ignore-case.
ignore_case: {{ ignore_case | default(false) | lower }}

# Print only the matched part of a line. Corresponds to -o/--only-matching.
only_matching: {{ only_matching | default(false) | lower }}

# Suppress normal output; print number of matches per file. Corresponds to -c/--count.
count: {{ count | default(false) | lower }}

# Limit search to a specified set of pages (e.g., '1-3,5'). Corresponds to --page-range.
page_range: {{ page_range | default('') }}

# Only search files whose base name matches GLOB. Corresponds to --include.
include_glob: {{ include_glob | default('*.pdf') }}

# Skip files whose base name matches GLOB. Corresponds to --exclude.
exclude_globs: {{ exclude_globs | default([]) }}

# Recursively search directories. Corresponds to -r/--recursive.
recursive: {{ recursive | default(true) | lower }}

# Number of lines of context after matching lines. Corresponds to -A/--after-context.
after_context: {{ after_context | default(0) }}

# Number of lines of context before matching lines. Corresponds to -B/--before-context.
before_context: {{ before_context | default(0) }}

# Use a cache for rendered text. Corresponds to --cache.
use_cache: {{ use_cache | default(false) | lower }}

# Exit immediately with status 0 if match found. Corresponds to -q/--quiet.
quiet: {{ quiet | default(false) | lower }}

# Print debug output. Corresponds to --debug.
debug: {{ debug | default(false) | lower }}

