{
  "pattern": "contract",
  "files": [
    "/var/lib/docs/2023",
    "/var/lib/docs/2024"
  ],
  "use_perl_regex": false,
  "ignore_case": true,
  "only_matching": false,
  "count": false,
  "page_range": "1-10",
  "include_glob": "*.pdf",
  "exclude_globs": [
    "temp_*.pdf"
  ],
  "recursive": true,
  "after_context": 2,
  "before_context": 2,
  "use_cache": true,
  "quiet": false,
  "debug": false
}
