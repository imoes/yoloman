# ==============================================================================
# Adminer Configuration for Apache2 (libapache2-mod-php)
# ==============================================================================
# This block configures an Apache Alias and Directory block for the Adminer
# web-based database management tool.
# ==============================================================================

# Adminer URL Alias
# Defines the URL path where Adminer is accessible.
# Schema: adminer_alias (default='/adminer')
Alias {{ adminer_alias | default('/adminer') }} {{ adminer_path | default('/etc/adminer') }}

# Adminer Directory Configuration
# Access control and default index settings for the Adminer installation directory.
# Schema: adminer_path (default='/etc/adminer')
<Directory {{ adminer_path | default('/etc/adminer') }}>
    # Allow access to the directory
    Require all granted

    # Default index file for the Adminer directory.
    # Schema: adminer_index (default='conf.php')
    DirectoryIndex {{ adminer_index | default('conf.php') }}
</Directory>
