{
  "host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Host address to listen on"
  },
  "port": {
    "type": "number",
    "default": 3030,
    "description": "TCP port number to listen on"
  },
  "loglevel": {
    "type": "string",
    "default": "warning",
    "description": "Log level for the server",
    "enum": [
      "debug",
      "info",
      "warning",
      "error",
      "critical"
    ]
  },
  "idle_suicide_seconds": {
    "type": "number",
    "default": 3600,
    "description": "Seconds of idleness before the server shuts down"
  },
  "stdout": {
    "type": "string",
    "default": "/var/log/ycmd.stdout.log",
    "description": "File path for stdout output"
  },
  "stderr": {
    "type": "string",
    "default": "/var/log/ycmd.stderr.log",
    "description": "File path for stderr output"
  },
  "keep_logfiles": {
    "type": "bool",
    "default": false,
    "description": "Whether to retain logfiles after the server exits"
  }
}
