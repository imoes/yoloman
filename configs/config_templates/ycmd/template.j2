# ycmd options file configuration
# This file is in JSON format as documented in ycmd(1).
{
    "options": {
        # List of global root directories for semantic analysis. Empty by default.
        "global_roots": [],
        "server": {
            # Host address to listen on
            "host": "{{ host | default('127.0.0.1') }}",
            # TCP port number to listen on
            "port": {{ port | default(3030) }},
            # Log level for the server (debug, info, warning, error, critical)
            "loglevel": "{{ loglevel | default('warning') }}",
            # Seconds of idleness before the server shuts down
            "idle_suicide_seconds": {{ idle_suicide_seconds | default(3600) }}
        },
        "log": {
            # File path for stdout output
            "stdout": "{{ stdout | default('/var/log/ycmd.stdout.log') }}",
            # File path for stderr output
            "stderr": "{{ stderr | default('/var/log/ycmd.stderr.log') }}",
            # Whether to retain logfiles after the server exits
            "keep_logfiles": {{ keep_logfiles | default(false) }}
        }
    }
}