# /etc/default/parprouted — configuration for the parprouted daemon
# Enable/disable the daemon at boot (true/false)
PARPRouted_ENABLED={{ enabled }}

# Interface pairs to bridge (format: 'in_if out_if') — one pair per line
{% for pair in interfaces %}PARPRouted_INTERFACES="{{ pair.in_if }} {{ pair.out_if }}"
{% endfor %}

# Log level: 0 (quiet) to 5 (verbose)
PARPRouted_LOGLEVEL={{ loglevel }}

# Path to PID file
PARPRouted_PIDFILE={{ pidfile }}

# Additional options passed directly to parprouted(8)
PARPRouted_OPTIONS="{{ options }}"
