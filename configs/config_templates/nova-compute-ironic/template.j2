[DEFAULT]
# compute_driver: The driver to use for managing ironic compute nodes.
compute_driver={{ compute_driver | default('ironic.IronicDriver') }}

# ram_allocation_ratio: Ratio used for floating point comparisons. RAM allocation ratio for ironic compute nodes.
ram_allocation_ratio={{ ram_allocation_ratio | default(1.0) }}

# reserved_host_memory_mb: Amount of host memory (in MB) to leave reserved for the host.
reserved_host_memory_mb={{ reserved_host_memory_mb | default(0) }}

[libvirt]
# virt_type: The type of virtualization to use for ironic compute nodes.
virt_type={{ virt_type | default('qemu') }}