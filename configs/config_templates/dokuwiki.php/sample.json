{
  "site_title": "My Organization Wiki",
  "base_url": "https://wiki.example.com/",
  "data_dir": "/var/lib/dokuwiki/data",
  "config_dir": "/etc/dokuwiki/conf",
  "start_namespace": "start",
  "use_acl": true,
  "default_user_level": 10,
  "syntax_mode": "dokuwiki",
  "recent_changes_count": 25,
  "admin_items_per_page": 30,
  "allow_register": true,
  "notify_enabled": true,
  "smtp_enabled": true,
  "smtp_host": "smtp.mail.example.com",
  "smtp_port": 587,
  "smtp_user": "wiki-notifier",
  "smtp_pass": "secret-password",
  "timezone": "America/Los_Angeles",
  "media_extensions": [
    "jpg",
    "jpeg",
    "png",
    "gif",
    "svg",
    "pdf",
    "doc",
    "docx",
    "xls",
    "xlsx",
    "mp4"
  ]
}
