{
  "bind": "0.0.0.0",
  "port": 8080,
  "upload_dir": "/var/lib/droopy/uploads",
  "max_file_size": 52428800,
  "auth_enabled": true,
  "auth_file": "/etc/droopy/htpasswd",
  "auth_realm": "Secure Upload Zone",
  "allow_overwrite": false,
  "max_concurrent_uploads": 10,
  "custom_message": "<p><em>For security, all uploads are logged. Max file size: 50 MiB.</em></p>",
  "ssl_enabled": true,
  "ssl_cert": "/etc/ssl/droopy/droopy.crt",
  "ssl_key": "/etc/ssl/droopy/droopy.key",
  "allowed_mime_types": [
    "image/jpeg",
    "image/png",
    "application/pdf"
  ],
  "allowed_extensions": [
    ".jpg",
    ".jpeg",
    ".png",
    ".pdf"
  ],
  "log_level": "warning",
  "log_file": "/var/log/droopy/droopy.log"
}
