# Logrotate configuration for {{ log_file | default('super.log') }}
#
# This block manages log rotation for the target application.
# It ensures that logs are rotated weekly, compressed, and
# a specific number of old logs are retained.

{% set _lf = log_file | default('super.log') %}
{% if _lf is string and _lf | length > 0 %}
# Logrotate file for {{ _lf }}
{% else %}
# Logrotate file for super.log
{% endif %}
{{ log_file | default('super.log') }} {
    notifempty

    # Number of rotated log files to keep.
    rotate {{ rotate_count | default('4') }}

    weekly

    compress

    missingok

    # Octal permissions, owner, and group for newly created log files.
    # Defaults to 0640 root:adm
    create {{ permissions | default('0640') }} {{ owner | default('root') }} {{ group | default('adm') }}
}
