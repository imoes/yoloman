{
  "plugin_load_add": {
    "type": "string",
    "default": "ha_s3",
    "description": "The plugin to load for the S3 storage engine."
  },
  "s3_host_name": {
    "type": "string",
    "default": "s3.amazonaws.com",
    "description": "The hostname of the S3 server."
  },
  "s3_protocol_version": {
    "type": "string",
    "default": "Amazon",
    "description": "The S3 protocol version."
  },
  "s3_bucket": {
    "type": "string",
    "default": "",
    "description": "The name of the S3 bucket."
  },
  "s3_access_key": {
    "type": "string",
    "default": "",
    "description": "The S3 access key ID."
  },
  "s3_secret_key": {
    "type": "string",
    "default": "",
    "description": "The S3 secret access key."
  },
  "s3_region": {
    "type": "string",
    "default": "eu-north-1",
    "description": "The S3 region."
  }
}
