[mariadb]
# plugin_load_add: The plugin to load for the S3 storage engine.
plugin-load-add = {{ plugin_load_add | default('ha_s3') }}

#
# Uncomment to configure the S3 engine
# See all options at https://mariadb.com/kb/en/s3-storage-engine/
#

# s3_host_name: The hostname of the S3 server.
s3-host-name = {{ s3_host_name | default('s3.amazonaws.com') }}

# s3_protocol_version: The S3 protocol version.
s3-protocol-version = {{ s3_protocol_version | default('Amazon') }}

# s3_bucket: The name of the S3 bucket.
s3-bucket = {{ s3_bucket | default('') }}

# s3_access_key: The S3 access key ID.
s3-access-key = {{ s3_access_key | default('') }}

# s3_secret_key: The S3 secret access key.
s3-secret-key = {{ s3_secret_key | default('') }}

# s3_region: The S3 region.
s3-region = {{ s3_region | default('eu-north-1') }}