# This is a POSIX shell fragment                -*- sh -*-
#
# Self-documenting configuration for openvswitch-testcontroller.
#
# Generated from Ansible variables. All variables use `default()`
# to prevent render failures if a role variable is undefined.
#

# LISTEN: OpenFlow connection methods the controller should listen on.
# Example: "pssl:6653" for SSL/TLS or "ptcp:6653" for plain TCP.
# Default is 'pssl:' which typically implies port 6653.
LISTEN="{{ listen | default('pssl:') }}"

# PRIVKEY: Path to the controller's private key file.
# Required if SSL/TLS is enabled (e.g., using 'pssl' in LISTEN).
PRIVKEY={{ privkey | default('/etc/openvswitch-testcontroller/privkey.pem') }}

# CERT: Path to the certificate file corresponding to the private key.
# Required if SSL/TLS is enabled.
CERT={{ cert | default('/etc/openvswitch-testcontroller/cert.pem') }}

# CACERT: Path to the switch CA certificate file.
# Required if SSL/TLS is enabled. Used to verify the client or peer certificates.
CACERT={{ cacert | default('/etc/openvswitch-testcontroller/cacert.pem') }}

# DAEMON_OPTS: Additional options to pass to the ovs-testcontroller daemon.
# Common examples include '--hub' for hub mode or log levels.
DAEMON_OPTS="{{ daemon_opts | default('') }}"