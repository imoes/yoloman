# Open vSwitch Test Controller Configuration
#
# This file configures the ovs-testcontroller service. It defines
# how the controller accepts incoming OpenFlow connections and
# handles SSL/TLS termination.
#
# Variables are sourced from Ansible playbook variables matching
# the field names: listen, privkey, cert, cacert, daemon_opts.

# LISTEN: OpenFlow connection methods the controller should listen on.
# Accepts space-delimited methods such as pssl: for SSL/TLS or ptcp: for plain TCP.
# Example: pssl:6653 or ptcp:6653 or "pssl:6653 ptcp:6650"
LISTEN="{{ listen | default('pssl:') }}"

# PRIVKEY: Path to the controller's private key file.
# Required if SSL/TLS (pssl) is enabled in LISTEN.
# Defaults to /etc/openvswitch-testcontroller/privkey.pem.
PRIVKEY="{{ privkey | default('/etc/openvswitch-testcontroller/privkey.pem') }}"

# CERT: Path to the certificate file for the private key.
# Required if SSL/TLS (pssl) is enabled in LISTEN.
# Defaults to /etc/openvswitch-testcontroller/cert.pem.
CERT="{{ cert | default('/etc/openvswitch-testcontroller/cert.pem') }}"

# CACERT: Path to the switch CA certificate file.
# Required if SSL/TLS (pssl) is enabled in LISTEN.
# Defaults to /etc/openvswitch-testcontroller/cacert.pem.
CACERT="{{ cacert | default('/etc/openvswitch-testcontroller/cacert.pem') }}"

# DAEMON_OPTS: Additional options to pass to the ovs-testcontroller daemon.
# Common options include --hub to act as an OpenFlow hub.
# Leave empty for default behavior.
DAEMON_OPTS="{{ daemon_opts | default('') }}"
