# postgrey (greylisting daemon) configuration for Postfix.
#
# This template defines the format of log entries generated by the
# Postgrey greylisting service when it rejects a message for the first time.
# The output follows the syslog format expected by log parsers (e.g., rsyslog,
# logstash) to parse the sender, recipient, and client IP addresses.

# log_date_format: The month abbreviation format for syslog timestamps.
# This variable controls how the month is printed in the syslog timestamp
# at the beginning of the log line.
# Default: '%b' (e.g., 'Jan', 'Feb')
# Syntax: strftime format codes.
log_date_format {{ log_date_format | default('%b') }}

# log_time_width: The fixed width padding for the time component in syslog messages.
# This ensures alignment of the time field in syslog logs.
# Default: ' 11' (space-padded to 11 characters, standard for syslog)
log_time_width {{ log_time_width | default(' 11') }}

# Example of a generated log line with these settings:
# Jan  5 12:00:00 mailserver gld: Greylist activated for recipient=<user@example.com> sender=<admin@other.com> ip=<192.168.1.1>
^\w{3} [ :0-9]{11} [._[:alnum:]-]+ gld: Greylist activated for recipient=<[[:alnum:]@._-]+> sender=<[[:alnum:]@._-]+> ip=<([0-9.]{7,15}|[0-9a-fA-F:.]{4,39})>$
