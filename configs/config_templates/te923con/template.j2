#!/usr/bin/env te923con
# ==========================================================
# te923con Configuration Template
# Self-documenting Jinja2 template for the te923con weather station utility.
# ==========================================================

# Enable debug output for bugfixing and diagnostics.
# When true, the tool emits verbose diagnostic messages to stderr.
{% if debug_output | default(False) %}-D {% endif %}

# Dump all values from the internal small memory.
# This flag requests the tool to dump all values stored in the weather station's small memory area.
# Note: This variable is named 'dump_small_memory' in the schema; no 'small' prefix is used for the flag itself.
{% if dump_small_memory | default(False) %}-d {% endif %}

# Dump all values from the internal big memory (new hardware).
# This flag requests the tool to dump all values stored in the weather station's big memory area,
# typically found in newer hardware versions.
# Note: This variable is named 'dump_big_memory' in the schema.
{% if dump_big_memory | default(False) %}-b {% endif %}

# Get status from the weather station.
# When true, the tool requests the device's status report instead of reading sensor values.
# Note: This variable is named 'get_status' in the schema.
{% if get_status | default(False) %}-s {% endif %}

# Set the output representation for invalid or unreachable sensor values.
# This string is used in the colon-separated output to mark values that could not be read.
# Default is 'i' if not specified.
-i {{ invalid_value_output | default('i') }}