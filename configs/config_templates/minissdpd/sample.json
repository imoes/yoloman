{
  "interface": "eth0",
  "port": 80,
  "ssdp_address": "192.168.1.1",
  "max_entries": 500,
  "logging": true,
  "extra_interfaces": [
    {
      "name": "iot-bridge",
      "description": "IOT subnet (10.10.20.0/24)",
      "device": "br-iot"
    },
    {
      "name": "guest-vlan",
      "description": "Guest network VLAN 30",
      "device": "eth0.30"
    }
  ],
  "pidfile": "/run/minissdpd.pid",
  "daemon_args": "-d"
}
