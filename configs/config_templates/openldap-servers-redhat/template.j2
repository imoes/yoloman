# OpenLDAP password policy (pwdPolicy) and password checking configuration.
# This file configures the pwdChecker module used by the slapd service.

# Enable cracklib password checking.
# If set to '1', the system will check passwords against a dictionary
# to prevent easy-to-guess passwords.
# Default is disabled (commented out).
# useCracklib: boolean, default is 0 (disabled).
{% if use_cracklib is defined and use_cracklib is not none and (use_cracklib is number or use_cracklib is boolean or use_cracklib | length > 0) %}useCracklib {{ use_cracklib | default('0') }}{% else %}#useCracklib 1{% endif %}

# Minimum number of points required for a password to be accepted.
# This is part of the pwdPolicy quality check scoring.
# Default is 3.
# minPoints: integer, default is 3.
{% if min_points is defined and min_points is not none and (min_points is number or min_points is boolean or min_points | length > 0) %}minPoints {{ min_points | default('3') }}{% else %}#minPoints 3{% endif %}

# Minimum number of uppercase letters required in the password.
# Default is 0 (no restriction).
# minUpper: integer, default is 0.
{% if min_upper is defined and min_upper is not none and (min_upper is number or min_upper is boolean or min_upper | length > 0) %}minUpper {{ min_upper | default('0') }}{% else %}#minUpper 0{% endif %}

# Minimum number of lowercase letters required in the password.
# Default is 0 (no restriction).
# minLower: integer, default is 0.
{% if min_lower is defined and min_lower is not none and (min_lower is number or min_lower is boolean or min_lower | length > 0) %}minLower {{ min_lower | default('0') }}{% else %}#minLower 0{% endif %}

# Minimum number of digits required in the password.
# Default is 0 (no restriction).
# minDigit: integer, default is 0.
{% if min_digit is defined and min_digit is not none and (min_digit is number or min_digit is boolean or min_digit | length > 0) %}minDigit {{ min_digit | default('0') }}{% else %}#minDigit 0{% endif %}

# Minimum number of punctuation characters required in the password.
# Default is 0 (no restriction).
# minPunct: integer, default is 0.
{% if min_punct is defined and min_punct is not none and (min_punct is number or min_punct is boolean or min_punct | length > 0) %}minPunct {{ min_punct | default('0') }}{% else %}#minPunct 0{% endif %}
