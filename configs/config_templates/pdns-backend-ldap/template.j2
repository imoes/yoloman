# {# ObjectClass: dNSDomain2 #}
# {# Description: Structural object class for DNS zones in LDAP. #}
# {# Supersedes: dNSDomain #}
# {# Optional Attributes: All defined DNS record types. #}
objectclass ( 1.3.6.1.4.1.2428.20.2 NAME 'dNSDomain2'
	SUP 'dNSDomain' STRUCTURAL
