{
  "language": {
    "type": "string",
    "default": "ukenglish",
    "description": "e2guardian.conf `language` (shipped value: 'ukenglish')."
  },
  "languagedir": {
    "type": "string",
    "default": "/usr/share/e2guardian/languages",
    "description": "e2guardian.conf `languagedir` (shipped value: '/usr/share/e2guardian/languages')."
  },
  "cacertificatepath": {
    "type": "string",
    "default": "/etc/e2guardian/private/ca.pem",
    "description": "e2guardian.conf `cacertificatepath` (shipped value: '/etc/e2guardian/private/ca.pem')."
  },
  "caprivatekeypath": {
    "type": "string",
    "default": "/etc/e2guardian/private/ca.key",
    "description": "e2guardian.conf `caprivatekeypath` (shipped value: '/etc/e2guardian/private/ca.key')."
  },
  "certprivatekeypath": {
    "type": "string",
    "default": "/etc/e2guardian/private/cert.key",
    "description": "e2guardian.conf `certprivatekeypath` (shipped value: '/etc/e2guardian/private/cert.key')."
  },
  "generatedcertpath": {
    "type": "string",
    "default": "/etc/e2guardian/private/generatedcerts/",
    "description": "e2guardian.conf `generatedcertpath` (shipped value: '/etc/e2guardian/private/generatedcerts/')."
  },
  "ipmaplist": {
    "type": "string",
    "default": "name=ipmap, path=__LISTDIR__/../authplugins/ipgroups",
    "description": "e2guardian.conf `ipmaplist` (shipped value: 'name=ipmap, path=__LISTDIR__/../authplugins/ipgroups')."
  },
  "reverseclientiplookups": {
    "type": "string",
    "default": "off",
    "description": "e2guardian.conf `reverseclientiplookups` (shipped value: off).",
    "enum": [
      "on",
      "off"
    ]
  },
  "urllist": {
    "type": "string",
    "default": "name=authexception,messageno=603,path=__LISTDIR__/authexceptionurllist",
    "description": "e2guardian.conf `urllist` (shipped value: 'name=authexception,messageno=603,path=__LISTDIR__/authexceptionurllist')."
  },
  "regexpboollist": {
    "type": "string",
    "default": "name=browser,path=__LISTDIR__/browserregexplist",
    "description": "e2guardian.conf `regexpboollist` (shipped value: 'name=browser,path=__LISTDIR__/browserregexplist')."
  },
  "dstatlocation": {
    "type": "string",
    "default": "/var/log/e2guardian/dstats.log",
    "description": "e2guardian.conf `dstatlocation` (shipped value: '/var/log/e2guardian/dstats.log')."
  },
  "reverseaddresslookups": {
    "type": "string",
    "default": "off",
    "description": "e2guardian.conf `reverseaddresslookups` (shipped value: off).",
    "enum": [
      "on",
      "off"
    ]
  },
  "usexforwardedfor": {
    "type": "string",
    "default": "off",
    "description": "e2guardian.conf `usexforwardedfor` (shipped value: off).",
    "enum": [
      "on",
      "off"
    ]
  },
  "downloadmanager": {
    "type": "string",
    "default": "/etc/e2guardian/downloadmanagers/default.conf",
    "description": "e2guardian.conf `downloadmanager` (shipped value: '/etc/e2guardian/downloadmanagers/default.conf')."
  },
  "weightedphrasemode": {
    "type": "number",
    "default": 2,
    "description": "e2guardian.conf `weightedphrasemode` (shipped value: 2).",
    "enum": [
      0,
      1,
      2
    ]
  },
  "originalip": {
    "type": "string",
    "default": "off",
    "description": "e2guardian.conf `originalip` (shipped value: off)."
  }
}
