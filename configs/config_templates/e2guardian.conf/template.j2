[main]
# Controls the listening port for the proxy
port = {{ port }}

# IP address the proxy binds to (0.0.0.0 = all interfaces)
bind = {{ bind_address }}

# Number of worker processes to spawn
children = {{ children }}

# Log level: 0=quiet, 1=minimal, 2=normal, 3=verbose, 4=debug
loglevel = {{ log_level }}

# Path to the main log file
log = {{ log_file }}

# Path to the access log file (optional, if empty uses main log)
accesslog = {{ access_log_file }}

# Enable or disable SSL interception (requires cert+key paths)
sslintercept = {{ ssl_intercept }}

# Path to SSL certificate (PEM format)
sslcert = {{ ssl_cert }}

# Path to SSL private key (PEM format)
sslkey = {{ ssl_key }}

# Path to CA certificate for signing intercepted SSL (required if sslintercept=true)
sslca = {{ ssl_ca }}

# Path to CA private key for signing intercepted SSL
sslcakey = {{ ssl_ca_key }}

# Timeout (seconds) for client connections
clienttimeout = {{ client_timeout }}

# Maximum size (in bytes) of HTTP headers to parse
maxheaderlines = {{ max_header_lines }}

# Maximum total size (in bytes) of HTTP request/response
maxbodylines = {{ max_body_lines }}

# Enable or disable content scanning (anti-virus/anti-malware)
contentscan = {{ content_scan }}

# Path to ClamAV socket or 'disabled' to skip AV scanning
clamavsocket = {{ clamav_socket }}

# Path to ClamAV timeout (ms)
clamavtimeout = {{ clamav_timeout }}

# Enable or disable URL filtering
urlfilter = {{ url_filter }}

# Path to the URL filtering config file
urlfilterconfig = {{ url_filter_config }}

# Enable or disable content filtering
contentfilter = {{ content_filter }}

# Path to content filtering rules file
contentfilterconfig = {{ content_filter_config }}

# Enable or disable domain/keyword blocking
blockedsitelist = {{ blockedsitelist }}

# Path to blocked site rules file
blockedsitelistconfig = {{ blocked_site_list_config }}

# Enable or disable allowed site list (whitelist)
whitelistsitelist = {{ whitelistsitelist }}

# Path to allowed site rules file
whitelistsitelistconfig = {{ whitelist_site_list_config }}

# Enable or disable group-based access control
groupaccess = {{ group_access }}

# Path to group access rules file
groupaccessconfig = {{ group_access_config }}

# Enable or disable authentication (basic/digest via external method)
authentication = {{ authentication }}

# Path to authentication config file (e.g., LDAP, PAM, local passwd)
authconfig = {{ auth_config }}

# Enable or disable HTTP compression
enablecompression = {{ enable_compression }}

# Enable or disable HTTP pipelining
enablepipelining = {{ enable_pipelining }}

# Enable or disable keep-alive
enablekeepalive = {{ enable_keepalive }}

# Enable or disable X-Forwarded-For header handling
forwardfor = {{ forward_for }}

# Enable or disable HTTP Strict Transport Security (HSTS) injection
hsts = {{ hsts }}

# Enable or disable request logging to syslog
logtosyslog = {{ log_to_syslog }}

# Syslog facility (e.g., daemon, local0..local7)
syslogfacility = {{ syslog_facility }}

# Path to the PID file
pidfile = {{ pid_file }}

# User to run as (after binding privileged port)
runasuser = {{ run_as_user }}

# Group to run as
runasgroup = {{ run_as_group }}

[language]
# Default language for error messages
language = {{ default_language }}

# Path to language template directory
languagepath = {{ language_path }}

# Enable or disable language auto-detection
languagedetect = {{ language_detect }}

[filter]
# Enable or disable regex-based filtering
regexfilter = {{ regex_filter }}

# Path to regex filter rules file
regexfilterconfig = {{ regex_filter_config }}

# Enable or disable MIME type filtering
mimefilter = {{ mime_filter }}

# Path to MIME filter rules file
mimefilterconfig = {{ mime_filter_config }}

# Enable or disable file extension filtering
extensionfilter = {{ extension_filter }}

# Path to file extension filter rules file
extensionfilterconfig = {{ extension_filter_config }}

# Enable or disable referrer filtering
referrerfilter = {{ referrer_filter }}

# Path to referrer filter rules file
referrerfilterconfig = {{ referrer_filter_config }}

# Enable or disable user agent filtering
useragentfilter = {{ user_agent_filter }}

# Path to user agent filter rules file
useragentfilterconfig = {{ user_agent_filter_config }}

[proxy]
# Upstream proxy host:port (if using chaining)
upstreamproxyhost = {{ upstream_proxy_host }}

# Upstream proxy port
upstreamproxyport = {{ upstream_proxy_port }}

# Enable or disable upstream proxy auth
upstreamproxyauth = {{ upstream_proxy_auth }}

# Username for upstream proxy auth
upstreamproxyusername = {{ upstream_proxy_username }}

# Password for upstream proxy auth
upstreamproxypassword = {{ upstream_proxy_password }}

# Enable or disable proxy chaining (transparent mode)
chainproxy = {{ chain_proxy }}

# Enable or disable round-robin upstream selection
roundrobin = {{ round_robin }}

[cache]
# Enable or disable object caching
objectcache = {{ object_cache }}

# Cache directory path
cachedir = {{ cache_dir }}

# Maximum cache size (MB)
cachemaxsize = {{ cache_max_size }}

# Maximum object size to cache (KB)
cachemaxobjectsize = {{ cache_max_object_size }}

# Cache expiry time (seconds)
cacheexpiry = {{ cache_expiry }}

# Enable or disable cache cleaning on startup
cachecleanonstart = {{ cache_clean_on_start }}

# Minimum free disk space (MB) to avoid cache corruption
cachefreemin = {{ cache_free_min }}

# Cache mode: 0=none, 1=local only, 2=shared (if supported)
cachemode = {{ cache_mode }}

[security]
# Enable or disable protection against XXE
preventxxe = {{ prevent_xxe }}

# Enable or disable protection against SSRF
preventssrf = {{ prevent_ssrf }}

# Enable or disable protection against directory traversal
preventdirtraversal = {{ prevent_dir_traversal }}

# Enable or disable protection against HTTP smuggling
preventhttp smuggling = {{ prevent_http_smuggling }}

# Enable or disable IP-based rate limiting
ipratelimit = {{ ip_rate_limit }}

# Maximum requests per IP per minute
ipratelimitmax = {{ ip_rate_limit_max }}

# Enable or disable per-user rate limiting
userratelimit = {{ user_rate_limit }}

# Maximum requests per user per minute
userratelimitmax = {{ user_rate_limit_max }}

# Enable or disable DLP (data loss prevention)
contentdlp = {{ content_dlp }}

# Path to DLP rules file
contentdlpconfig = {{ content_dlp_config }}

# Enable or disable password leakage detection
passwordleakage = {{ password_leakage }}

# Enable or disable credit card detection
creditcarddetection = {{ credit_card_detection }}

[admin]
# Enable or disable web-based admin interface
webadmin = {{ web_admin }}

# Port for admin interface (if enabled)
webadminport = {{ web_admin_port }}

# Enable or disable admin password protection
webadminpassword = {{ web_admin_password }}

# Path to admin user list file
webadminuserlist = {{ web_admin_user_list }}

# Enable or disable admin log access
webadminlogaccess = {{ web_admin_log_access }}

# Enable or disable admin config editing
webadminconfigedit = {{ web_admin_config_edit }}

# Enable or disable admin report generation
webadminreports = {{ web_admin_reports }}

[logging]
# Log format: 0=standard, 1=common, 2=combined, 3=custom
logformat = {{ log_format }}

# Custom log format string (only if logformat=3)
logcustomformat = {{ log_custom_format }}

# Enable or disable log rotation
logrotate = {{ log_rotate }}

# Number of rotated logs to keep
logrotatecount = {{ log_rotate_count }}

# Max size (MB) of log before rotation
logrotatesize = {{ log_rotate_size }}

# Enable or disable compressed rotated logs
logrotatecompress = {{ log_rotate_compress }}

[performance]
# Max number of concurrent connections per child
maxconnperchild = {{ max_conn_per_child }}

# Max number of concurrent requests per connection
maxreqperconn = {{ max_req_per_conn }}

# Enable or disable TCP_DEFER_ACCEPT (if supported)
tcpdeferaccept = {{ tcp_defer_accept }}

# Enable or disable SO_REUSEPORT (if supported)
soreuseport = {{ so_reuse_port }}

# Enable or disable TCP_NODELAY
tcpnodelay = {{ tcp_no_delay }}

# Enable or disable keep-alive timeout (seconds)
keepalivetimeout = {{ keep_alive_timeout }}

# Enable or disable DNS cache
 dnscache = {{ dns_cache }}

# DNS cache TTL (seconds)
 dnscachettl = {{ dns_cache_ttl }}

# Enable or disable DNS query timeout (seconds)
 dnstimeout = {{ dns_timeout }}

# Enable or disable DNS fallback to TCP
 dnsuse_tcp = {{ dns_use_tcp }}
