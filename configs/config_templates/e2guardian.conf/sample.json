{
  "port": 3128,
  "bind_address": "0.0.0.0",
  "children": 16,
  "log_level": 2,
  "log_file": "/var/log/e2guardian/e2guardian.log",
  "access_log_file": "/var/log/e2guardian/access.log",
  "ssl_intercept": true,
  "ssl_cert": "/etc/e2guardian/ssl/proxy.crt",
  "ssl_key": "/etc/e2guardian/ssl/proxy.key",
  "ssl_ca": "/etc/e2guardian/ssl/ca.crt",
  "ssl_ca_key": "/etc/e2guardian/ssl/ca.key",
  "client_timeout": 60,
  "max_header_lines": 100,
  "max_body_lines": 4000,
  "content_scan": true,
  "clamav_socket": "/var/run/clamav/clamd.sock",
  "clamav_timeout": 30,
  "url_filter": true,
  "url_filter_config": "/etc/e2guardian/lists/urlfilter.conf",
  "content_filter": true,
  "content_filter_config": "/etc/e2guardian/lists/contentfilter.conf",
  "blockedsitelist": true,
  "blocked_site_list_config": "/etc/e2guardian/lists/blacklists",
  "whitelistsitelist": true,
  "whitelist_site_list_config": "/etc/e2guardian/lists/whitelists",
  "group_access": true,
  "group_access_config": "/etc/e2guardian/lists/groups",
  "authentication": true,
  "auth_config": "/etc/e2guardian/auth/ldap.conf",
  "enable_compression": true,
  "enable_pipelining": false,
  "enable_keepalive": true,
  "forward_for": true,
  "hsts": false,
  "log_to_syslog": true,
  "syslog_facility": "local0",
  "pid_file": "/run/e2guardian/e2guardian.pid",
  "run_as_user": "e2guardian",
  "run_as_group": "e2guardian",
  "default_language": "english",
  "language_path": "/usr/share/e2guardian/languages",
  "language_detect": false,
  "regex_filter": false,
  "regex_filter_config": "/etc/e2guardian/lists/regexfilter.conf",
  "mime_filter": true,
  "mime_filter_config": "/etc/e2guardian/lists/mimefilter.conf",
  "extension_filter": true,
  "extension_filter_config": "/etc/e2guardian/lists/extensionfilter.conf",
  "referrer_filter": false,
  "referrer_filter_config": "/etc/e2guardian/lists/referrerfilter.conf",
  "user_agent_filter": false,
  "user_agent_filter_config": "/etc/e2guardian/lists/useragentfilter.conf",
  "upstream_proxy_host": "",
  "upstream_proxy_port": 3128,
  "upstream_proxy_auth": false,
  "upstream_proxy_username": "",
  "upstream_proxy_password": "",
  "chain_proxy": false,
  "round_robin": false,
  "object_cache": true,
  "cache_dir": "/var/cache/e2guardian",
  "cache_max_size": 2048,
  "cache_max_object_size": 2048,
  "cache_expiry": 3600,
  "cache_clean_on_start": true,
  "cache_free_min": 256,
  "cache_mode": 1,
  "prevent_xxe": true,
  "prevent_ssrf": true,
  "prevent_dir_traversal": true,
  "prevent_http_smuggling": true,
  "ip_rate_limit": false,
  "ip_rate_limit_max": 100,
  "user_rate_limit": true,
  "user_rate_limit_max": 200,
  "content_dlp": false,
  "content_dlp_config": "/etc/e2guardian/lists/dlp.conf",
  "password_leakage": false,
  "credit_card_detection": false,
  "web_admin": false,
  "web_admin_port": 8081,
  "web_admin_password": true,
  "web_admin_user_list": "/etc/e2guardian/adminusers.conf",
  "web_admin_log_access": true,
  "web_admin_config_edit": false,
  "web_admin_reports": true,
  "log_format": 2,
  "log_custom_format": "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"",
  "log_rotate": true,
  "log_rotate_count": 14,
  "log_rotate_size": 20,
  "log_rotate_compress": true,
  "max_conn_per_child": 10000,
  "max_req_per_conn": 200,
  "tcp_defer_accept": true,
  "so_reuse_port": false,
  "tcp_no_delay": true,
  "keep_alive_timeout": 30,
  "dns_cache": true,
  "dns_cache_ttl": 120,
  "dns_timeout": 5,
  "dns_use_tcp": true
}
