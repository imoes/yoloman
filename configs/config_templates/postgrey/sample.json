{
  "listen_address": "127.0.0.1",
  "listen_port": 10023,
  "run_as_user": "postfix",
  "run_as_group": "",
  "db_path": "/var/lib/postgrey/postgrey.db",
  "db_engine": "sqlite",
  "whitelist_clients_delay": 0,
  "whitelist_recipients_delay": 0,
  "whitelist_clients": [
    "127.0.0.0/8",
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "whitelist_sender_domains": [
    "example.com",
    "google.com"
  ],
  "whitelist_sender_addresses": [
    "noreply@example.com",
    "bounce-*@example.com"
  ],
  "whitelist_recipient_domains": [],
  "whitelist_recipient_addresses": [],
  "syslog": true,
  "log_file": "/var/log/postgrey.log",
  "loglevel": 1,
  "greylist_seconds": 300,
  "greylist_max_age": 3600,
  "whitelist_postfix_smtpd": true,
  "skip_local": false,
  "pid_file": "/var/run/postgrey/postgrey.pid",
  "extra_options": ""
}
