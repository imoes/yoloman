# Postgrey configuration
#
# This is the main configuration file for postgrey.
# Lines starting with '#' are comments and will be ignored.
# Parameters can be specified as 'param=value'.

# IP address on which postgrey listens for incoming SMTP connections from Postfix. Usually localhost.
listen_address = {{ (listen_address | default('127.0.0.1')) }}

# TCP port number for postgrey to bind to. Default Postfix port for greylisting is 10023.
listen_port = {{ (listen_port | default(10023)) }}

# System user account to run the postgrey daemon under. Should have read/write access to the database file.
run_as_user = {{ (run_as_user | default('postgrey')) }}

# Optional system group to run the daemon under. If empty, uses the primary group of `run_as_user`.
{% if (run_as_group | default('')) is string and (run_as_group | default('')) | length > 0 %}
run_as_group = {{ (run_as_group | default('')) }}
{% endif %}

# Path to the database file used for storing greylisting records. SQLite is used by default.
db_path = {{ (db_path | default('/var/lib/postgrey/postgrey.db')) }}

# Database engine: 'sqlite', 'mysql', or 'postgres'. SQLite is standard for most Postfix setups.
db_engine = {{ (db_engine | default('sqlite')) }}

# Time (in seconds) before greylisting is skipped for whitelisted clients. Set to 0 to skip greylisting entirely for them.
whitelist_clients_delay = {{ (whitelist_clients_delay | default(0)) }}

# Time (in seconds) before greylisting is skipped for whitelisted recipients. Set to 0 to disable greylisting for them.
whitelist_recipients_delay = {{ (whitelist_recipients_delay | default(0)) }}

# List of IPs, CIDR ranges, or hostnames to whitelist from greylisting.
{% for item in (whitelist_clients | default([])) %}
whitelist_clients = {{ item }}
{% endfor %}

# List of sender domains (exact or regex) to whitelist.
{% for item in (whitelist_sender_domains | default([])) %}
whitelist_sender_domains = {{ item }}
{% endfor %}

# List of exact sender email addresses or patterns to whitelist.
{% for item in (whitelist_sender_addresses | default([])) %}
whitelist_sender_addresses = {{ item }}
{% endfor %}

# List of recipient domains to whitelist.
{% for item in (whitelist_recipient_domains | default([])) %}
whitelist_recipient_domains = {{ item }}
{% endfor %}

# List of exact recipient email addresses to whitelist.
{% for item in (whitelist_recipient_addresses | default([])) %}
whitelist_recipient_addresses = {{ item }}
{% endfor %}

# If true, log to system syslog. If false, log to file instead.
{% if (syslog | default(True)) is sameas true %}
syslog = {{ syslog | default(True) }}
{% else %}
# Path to log file when syslog is disabled. Ignored if syslog is enabled.
log_file = {{ (log_file | default('/var/log/postgrey.log')) }}
{% endif %}

# Verbosity level: 0 (quiet), 1 (normal), 2 (verbose). Set higher if troubleshooting.
loglevel = {{ (loglevel | default(1)) }}

# Minimum seconds to wait before accepting mail from a new sender. Typical value: 300 (5 minutes).
greylist_seconds = {{ (greylist_seconds | default(300)) }}

# Maximum seconds after which greylisting records expire (i.e., after how long a sender must re-greylist).
greylist_max_age = {{ (greylist_max_age | default(3600)) }}

# If true, skip greylisting for mail submitted via postfix local smtpd.
whitelist_postfix_smtpd = {{ (whitelist_postfix_smtpd | default(True)) }}

# Custom greylist rejection message text. Used only if set (non-empty).
{% if (postgrey_text | default('')) is string and (postgrey_text | default('')) | length > 0 %}
postgrey_text = {{ (postgrey_text | default('Delayed by postgrey')) }}
{% endif %}