{
  "global_backend": "external",
  "global_max_connections": 1024,
  "global_ssl_cert": "/etc/ovn/ssl/db-cert.pem",
  "global_ssl_private_key": "/etc/ovn/ssl/db-privkey.pem",
  "global_ssl_ca_cert": "/etc/ovn/ssl/ca-cert.pem",
  "global_use_ssl": true,
  "global_cluster_id": "cluster-east-1",
  "ic_enable": true,
  "ic_site_id": "site-a",
  "ic_peers": [
    {
      "site_id": "site-b",
      "url": "tcp:10.0.0.101:6643",
      "ssl_cert": "",
      "ssl_private_key": "",
      "ssl_ca_cert": ""
    },
    {
      "site_id": "site-c",
      "url": "ssl:10.0.0.102:6643",
      "ssl_cert": "/etc/ovn/ssl/client-b.pem",
      "ssl_private_key": "/etc/ovn/ssl/client-b-privkey.pem",
      "ssl_ca_cert": "/etc/ovn/ssl/ca-cert.pem"
    }
  ],
  "ic_peer_health_check_interval": 20,
  "ic_peer_timeout": 8,
  "ic_verbose": false,
  "log_file": "/var/log/ovn/ovn-ic-db.log",
  "log_level": "info",
  "log_syslog_facility": "local0",
  "audit_enable": true,
  "audit_file": "/var/log/ovn/ovn-ic-db-audit.log",
  "audit_level": "notice"
}
