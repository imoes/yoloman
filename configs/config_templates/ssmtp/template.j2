# ssmtp.conf: configuration file for sSMTP sendmail.
#
# The format of this file is line-based with key=value pairs.
# Comments start with a '#' and may appear on their own line or at the end of a value line.
#
# For more information, see ssmtp.conf(5).

# The person who gets all mail for uid 0 (root)
# Set this to your main email address or local user
# If you want all mail for root to go to user "admin", set to "admin"
# If you want mail for root to go to an external address, set to "admin@example.com"
#root={{ root_user }}

# The SMTP relay server (hostname or IP), optionally with port
# Example: mailhub=smtp.gmail.com:587
#mailhub={{ mailhub }}

# Use TLS (STARTTLS or implicit TLS)
#use_tls={{ use_tls | lower }}

# Use STARTTLS negotiation explicitly (ignored if UseTLS=NO)
#use_starttls={{ use_starttls | lower }}

# Hostname to send in HELO/EHLO (empty means use system hostname)
#hostname={{ hostname }}

# Allow overriding the From: line for root's mail
#from_line_override={{ from_line_override | lower }}

# SMTP authentication (if required by relay)
#auth_user={{ auth_user }}
#auth_pass={{ auth_pass }}

# Certificate verification for TLS (set to NO only for testing)
#tls_cert_check={{ tls_cert_check | lower }}

# Domain to append to From: addresses without domain
#rewrite_domain={{ rewrite_domain }}

# Default domain to append to addresses missing one (e.g., local-only addresses)
#default_domain={{ default_domain }}

# CA certificate bundle for TLS verification
#tls_ca_file={{ ca_cert_file }}

# Enable debug output to stderr (for troubleshooting)
#debug={{ debug | lower }}

# IMPORTANT: This file is read-only by default (mode 600).
# Keep it secured — especially if auth_pass is set.
