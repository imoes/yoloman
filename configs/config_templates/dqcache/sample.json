{
  "config_root": "/usr",
  "run_user": "nobody",
  "run_dir": "/var/run/dqcache",
  "config_dir": "/etc/dqcache",
  "cache_size": 536870912,
  "max_connections": 1000,
  "listen_addresses": [
    "127.0.0.1",
    "192.168.1.1",
    "::1"
  ],
  "listen_port": 53,
  "dnscurve_enabled": true,
  "dnscurve_keyfile": "/etc/dqcurve/keypair",
  "dnscurve_pubkey": "1a2b3c4d...",
  "dnscurve_auth_enabled": true,
  "log_level": 3,
  "recursion_enabled": true,
  "upstream_servers": [
    "9.9.9.9",
    "149.112.112.112"
  ],
  "upstream_timeout_ms": 3000,
  "max_query_depth": 12,
  "edns_disabled": false,
  "dnssec_disabled": false,
  "chroot_dir": "/var/dqcache/chroot",
  "debug_mode": false
}
