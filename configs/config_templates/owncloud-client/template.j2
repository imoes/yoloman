# ownCloud Client Sync Configuration Template
# This template generates the global exclude patterns file for the ownCloud sync client.
# The content is static and does not depend on Ansible variables.
# Any future dynamic exclusions should be passed via an Ansible variable `owncloud_exclude_patterns`
# if the static defaults below are insufficient.

# General backup and temporary file patterns
# Backup files created by editors or system tools
*~
# Files ending with tilde
~$*

# Lock files
# Files starting with .~lock. are used by ownCloud to indicate ongoing sync/editing
.~lock.*
# Temporary files with specific naming conventions
~*.tmp
# Bracketed temporary files
]*.~*]

# macOS specific files
# Finder icon cache files
Icon\r*
# macOS resource forks and hidden metadata
].DS_Store
].ds_store
# macOS local metadata
._*
# Windows thumbnail cache
]Thumbs.db

# Vim swap files
# Matches .file.swp, .file.swo, etc.
.*.sw?
# Matches .file.swx
.*.*sw?

# macOS specific trash and revision folders
# Temporary items folder
].TemporaryItems
# Trash folder
].Trashes
# Document revisions
].DocumentRevisions-V100
# Trash-* folder
].Trash-*

# macOS event daemon
.fseventd
# APFS disk image mount indicator
.apdisk

# Hidden directory marker (sometimes generated)
.directory

# ownCloud sync specific temporary/part files
# Partial download files
*.part
# File part files
*.filepart
# Chrome download marker (sometimes used by sync clients)
*.crdownload

# Kate editor swap file
*.kate-swp
# GnuCash temporary files
*.gnucash.tmp-*

# Synkron client files
.synkron.*
# FreeFileSync database file
.sync.ffs_db
# Symform client files
.symform
# Symform store directory
.symform-store

# Fuse hidden files
.fuse_hidden*
# Unison backup files
*.unison
# NFS lock/hidden files
.nfs*

# Custom user-defined saved places or local overrides
# This section is left blank by default but can be populated if needed.
# To add custom exclusions, define the `owncloud_exclude_patterns` variable
# in your Ansible inventory or role defaults as a list of strings.
{%- if owncloud_exclude_patterns is defined and owncloud_exclude_patterns is iterable %}
{% for pattern in owncloud_exclude_patterns %}
{{ pattern }}
{% endfor %}
{%- endif %}

