# ownCloud Client Sync Exclude Patterns
#
# This template generates the list of glob patterns that the ownCloud client
# uses to ignore specific files and directories during synchronization.
#
# Schema Field: owncloud_exclude_patterns
# Description : List of glob patterns for files to exclude from sync.
# Default     : Standard set of temporary, lock, and OS-specific files.

{% for pattern in owncloud_exclude_patterns | default(['*~', '~$*', '.~lock.*', '~*.tmp', ']*.~**', ']Icon\\r*', '].DS_Store', '].ds_store', '._*', ']Thumbs.db', '.*.sw?', '.*.*sw?', '].TemporaryItems', '].Trashes', '].DocumentRevisions-V100', '].Trash-*', '.fseventd', '.apdisk', '.directory', '*.part', '*.filepart', '*.crdownload', '*.kate-swp', '*.gnucash.tmp-*', '.synkron.*', '.sync.ffs_db', '.symform', '.symform-store', '.fuse_hidden*', '*.unison', '.nfs*', 'My Saved Places.']) %}
{{ pattern }}
{% endfor %}