{
  "relay_host": "smtp.gmail.com",
  "relay_port": 587,
  "use_tls": true,
  "use_starttls": true,
  "tls_trust_file": "/etc/ssl/certs/ca-certificates.crt",
  "use_auth": true,
  "auth_user": "user@example.com",
  "auth_password": "secret_password",
  "default_from": "alerting@myserver.local",
  "log_file": "/var/log/msmtp.log",
  "sendmail_path": "/usr/bin/msmtp"
}
