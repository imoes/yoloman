{
  "server": {
    "use_ipv4": true,
    "use_ipv6": true,
    "publish_hinfo": true,
    "publish_workstation": true,
    "publish_domain": "local",
    "publish_resolved": true,
    "publish_addr": true,
    "publish_cname": true,
    "rr_ttl": 7200,
    "host_name": "",
    "watch_config": true,
    "reflector": {
      "enabled": false,
      "rr_ttl": 7200,
      "network_namespace": false
    },
    "wide_area": {
      "enabled": false
    },
    "lua": {
      "enabled": false,
      "directory": "/etc/avahi/services"
    },
    "dbus": {
      "system_pub_sub": true
    },
    "rate_limiting": {
      "enabled": true,
      "interval_sec": 30,
      "max_packets": 100
    },
    "publish_services": [
      {
        "name": "My HTTP Service",
        "type": "_http._tcp",
        "port": 8080,
        "txt": "path=/api"
      },
      {
        "name": "SSH Server",
        "type": "_ssh._tcp",
        "port": 22
      }
    ],
    "publish_domains": [
      {
        "name": "internal.example.com",
        "ttl": 3600
      }
    ]
  }
}
