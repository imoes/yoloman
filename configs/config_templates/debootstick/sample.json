{
  "system_type": "live",
  "kernel_package": "linux-image-amd64",
  "hostname": "debootstick-host",
  "kernel_bootargs": [
    "+console=ttyS0",
    "-rootdelay"
  ],
  "root_password_ask": true,
  "root_password_none": false,
  "root_password_first_boot": false,
  "grub_on_serial_line": false,
  "disk_layout": "/etc/debootstick/layouts/custom-layout.cfg",
  "run_on_first_boot": "etc/scripts/post-migration.sh",
  "sector_size": 4096,
  "source": "/tmp/buster_tree",
  "dest": "/tmp/img.dd"
}
