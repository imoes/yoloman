{
  "line_number_interval_blame": 1,
  "line_number_interval_grep": 1,
  "line_number_interval_main": 5,
  "line_number_interval_reflog": 5,
  "line_number_interval_stash": 5,
  "line_number_interval_status": 5,
  "line_number_interval_tree": 5,
  "line_number_interval_pager": 5,
  "line_number_interval_stage": 5,
  "line_number_interval_log": 5,
  "line_number_interval_blob": 5,
  "line_number_interval_diff": 5,
  "show_changes": true,
  "show_untracked": true,
  "wrap_lines": false,
  "tab_size": 8,
  "line_graphics": "default",
  "truncation_delimiter": "~",
  "reference_format": "[branch] <tag> {remote} ~replace~",
  "commit_order": "auto",
  "status_show_untracked_dirs": true,
  "status_show_untracked_files": true,
  "ignore_space": "no",
  "show_notes": true,
  "mailmap": true,
  "start_on_head": false,
  "refresh_mode": "auto",
  "refresh_interval": 10,
  "ignore_case": "no",
  "wrap_search": true,
  "focus_child": true,
  "send_child_enter": true,
  "horizontal_scroll": "50%",
  "split_view_height": "67%",
  "vertical_split": "auto",
  "split_view_width": "50%",
  "editor_line_number": true,
  "history_size": 500,
  "mouse": false,
  "mouse_scroll": 3,
  "mouse_wheel_cursor": false,
  "pgrp": false
}
