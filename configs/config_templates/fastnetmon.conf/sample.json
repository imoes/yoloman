{
  "main": {
    "ban_time": 300,
    "graphite_enable": true,
    "graphite_host": "graphite.internal",
    "graphite_port": 2003,
    "log_level": "info",
    "log_dir": "/var/log/fastnetmon",
    "monitor_interfaces": [
      "eth0",
      "eth1"
    ],
    "capture_method": "netmap",
    "bandwidth_threshold_enable": true,
    "pps_threshold_enable": true,
    "flow_collector_ip": "0.0.0.0",
    "flow_collector_port": 2055
  },
  "threshold": {
    "bandwidth_threshold": 2000,
    "pps_threshold": 25000,
    "udp_amplification_pps_threshold": 1000,
    "ntp_amplification_pps_threshold": 500,
    "dns_amplification_pps_threshold": 500,
    "syn_flood_pps_threshold": 5000
  },
  "white_list": {
    "ip_list": [
      "192.0.2.0/24",
      "2001:db8::/32"
    ]
  },
  "black_list": {
    "ip_list": [
      "198.51.100.42"
    ]
  },
  "attack_notification": {
    "enable": true,
    "telegram_enable": true,
    "telegram_token": "123456789:ABCdefGHIjklMNOpqrsTUVwxyz",
    "telegram_chat_id": "-1001234567890",
    "email_enable": false,
    "email_to": "ops@example.com",
    "email_from": "fastnetmon@example.com",
    "email_smtp_server": "smtp.example.com",
    "email_smtp_port": 587,
    "email_smtp_tls": true,
    "message_template": "\u26a0\ufe0f FastNetMon Alert: {{ attack_type }} from {{ attacker_ip }} \u2014 {{ traffic_mbps }} Mbps, {{ traffic_pps }} pps"
  },
  "mitigation": {
    "enable": true,
    "method": "blackhole",
    "bgp_flow_spec_enable": false,
    "bgp_flow_spec_announce_to": []
  }
}
