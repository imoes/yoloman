{
  "listen_address": "0.0.0.0",
  "listen_port": 543,
  "pap_active": true,
  "max_jobs": 5,
  "queue_timeout": 43200,
  "syslog_enabled": true,
  "debug_enabled": false,
  "printcap_path": "/etc/printcap",
  "default_command": "lp -d {{printer}} {{job}}",
  "printers": [
    {
      "name": "HP-LaserJet",
      "at_name": "HP_LJ",
      "queue_name": "HP-LaserJet",
      "command": ""
    },
    {
      "name": "EPSON-Stylus",
      "at_name": "Epson",
      "queue_name": "EPSON-Stylus",
      "command": "lp -o sides=two-sided-long-edge -d {{printer}} {{job}}"
    }
  ],
  "default_printer": "HP-LaserJet"
}
