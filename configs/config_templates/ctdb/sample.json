{
  "nodes_file": "/etc/ctdb/nodes",
  "public_interfaces": [
    "eth0"
  ],
  "private_interface": "eth1",
  "locking_method": "tdb",
  "recovery_manager": true,
  "recovery_timeout": 60,
  "node_health_check_interval": 5,
  "node_health_check_max_latency": 30,
  "recovery_strategy": "balanced",
  "log_level": "WARNING",
  "log_file": "/var/log/ctdb/ctdb.log",
  "transport": "tcp",
  "socket_reuse_port": true,
  "tcp_no_delay": true,
  "tcp_backlog": 128,
  "workers_per_ip": 0,
  "public_addresses": [
    {
      "ip": "10.1.1.100",
      "prefixlen": 24,
      "interface": "eth0"
    },
    {
      "ip": "10.1.1.101",
      "prefixlen": 24,
      "interface": "eth0"
    }
  ],
  "enable_ha": true,
  "service_check_script": "/usr/lib/ctdb/helpers/ctdb_service_check",
  "failover_delay": 10,
  "database_cache_size": 2000,
  "queue_depth": 200,
  "remote_tdb_timeout": 30,
  "use_sasl": false,
  "sasl_config_path": "/etc/ctdb/sasl.conf"
}
