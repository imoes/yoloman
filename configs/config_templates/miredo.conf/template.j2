# Please refer to the miredo.conf(5) man page for details.
InterfaceName	{{ interface_name | default('teredo') }}

# Pick a Teredo server:
#ServerAddress	teredo.ipv6.microsoft.com
ServerAddress	{{ server_address | default('teredo-debian.remlab.net') }}

# Some firewall/NAT setups require a specific UDP port number:
{% if bind_port is defined and bind_port is not none and bind_port != '' %}BindPort	{{ bind_port }}
{% else %}#BindPort	3545
{% endif %}{% if relay_type is defined and relay_type is not none and relay_type != '' %}
# Operating mode, miredo.conf(5): client (default), autoclient, relay/cone, restricted.
RelayType	{{ relay_type }}
{% endif %}