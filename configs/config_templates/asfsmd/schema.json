{
  "loglevel": {
    "type": "string",
    "default": "WARNING",
    "description": "Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).",
    "enum": [
      "DEBUG",
      "INFO",
      "WARNING",
      "ERROR",
      "CRITICAL"
    ]
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Suppress standard output, only errors are printed."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output messages."
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Print debug messages."
  },
  "file_list": {
    "type": "bool",
    "default": false,
    "description": "Interpret INPUT as a file containing product names."
  },
  "urls": {
    "type": "bool",
    "default": false,
    "description": "Interpret INPUT as URLs pointing to products on ASF server."
  },
  "outdir": {
    "type": "string",
    "default": ".",
    "description": "Output directory path for downloaded XML files."
  },
  "username": {
    "type": "string",
    "default": "",
    "description": "ASF authentication username (overrides .netrc)."
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "ASF authentication password (overrides .netrc)."
  },
  "block_size": {
    "type": "number",
    "default": 16,
    "description": "HTTPIO block size in MB."
  },
  "beam": {
    "type": "string",
    "default": "",
    "description": "Select beam mode: s1, s2, s3, s4, s5, s6, iw1, iw2, iw3, ew1, ew2, ew3, ew4, ew5, wv1, wv2.",
    "enum": [
      "s1",
      "s2",
      "s3",
      "s4",
      "s5",
      "s6",
      "iw1",
      "iw2",
      "iw3",
      "ew1",
      "ew2",
      "ew3",
      "ew4",
      "ew5",
      "wv1",
      "wv2"
    ]
  },
  "pol": {
    "type": "string",
    "default": "",
    "description": "Select polarization: vv, vh, hv, hh.",
    "enum": [
      "vv",
      "vh",
      "hv",
      "hh"
    ]
  },
  "cal": {
    "type": "bool",
    "default": false,
    "description": "Download calibration files."
  },
  "noise": {
    "type": "bool",
    "default": false,
    "description": "Download noise calibration files."
  },
  "rfi": {
    "type": "bool",
    "default": false,
    "description": "Download RFI files."
  },
  "data": {
    "type": "bool",
    "default": false,
    "description": "Download measurement files."
  },
  "noprogress": {
    "type": "bool",
    "default": false,
    "description": "Disable progress bar."
  },
  "products": {
    "type": "list",
    "default": [],
    "description": "List of Sentinel-1 product names or URLs depending on flags. Each entry is a string; if file_list is true, this is ignored and product file is read instead."
  }
}
