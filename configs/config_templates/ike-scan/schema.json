{
  "hosts_file": {
    "type": "string",
    "default": "/etc/ike-scan/targets.list",
    "description": "File containing list of target hosts/IPs to scan, one per line."
  },
  "source_port": {
    "type": "number",
    "default": 500,
    "description": "UDP source port. 0 for random. Superuser needed for <1024."
  },
  "dest_port": {
    "type": "number",
    "default": 500,
    "description": "UDP destination port. Default 500 (ISAKMP)."
  },
  "retries": {
    "type": "number",
    "default": 3,
    "description": "Total number of attempts per host."
  },
  "timeout": {
    "type": "number",
    "default": 500,
    "description": "Initial per-host timeout in milliseconds."
  },
  "bandwidth": {
    "type": "number",
    "default": 56000,
    "description": "Desired outbound bandwidth in bits per second."
  },
  "show_backoff": {
    "type": "bool",
    "default": false,
    "description": "Enable backoff fingerprinting table display."
  },
  "backoff_wait": {
    "type": "number",
    "default": 60,
    "description": "Seconds to wait after last packet when displaying backoff table."
  },
  "ikev2": {
    "type": "bool",
    "default": false,
    "description": "Use IKE version 2."
  },
  "aggressive_mode": {
    "type": "bool",
    "default": false,
    "description": "Use IKE Aggressive Mode instead of Main Mode."
  },
  "id_type": {
    "type": "number",
    "default": 3,
    "description": "Identification type (e.g., 3=ID_USER_FQDN). Aggressive Mode only."
  },
  "dh_group": {
    "type": "number",
    "default": 2,
    "description": "Diffie Hellman Group number. Aggressive Mode/IKEv2."
  },
  "id_value": {
    "type": "string",
    "default": "",
    "description": "Identification string or hex value (0x...). Aggressive Mode only."
  },
  "nonce_len": {
    "type": "number",
    "default": 20,
    "description": "Nonce length in bytes. Aggressive Mode/IKEv2 only."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Display verbose progress messages."
  },
  "multiline": {
    "type": "bool",
    "default": false,
    "description": "Split payload decode across multiple lines."
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Don't decode returned packet, shorter output."
  },
  "show_timestamps": {
    "type": "bool",
    "default": false,
    "description": "Display timestamps for received packets."
  },
  "show_num": {
    "type": "bool",
    "default": false,
    "description": "Display host number for received packets."
  },
  "nat_t": {
    "type": "bool",
    "default": false,
    "description": "Enable RFC 3947 NAT-Traversal."
  },
  "no_dns": {
    "type": "bool",
    "default": false,
    "description": "Do not use DNS to resolve names."
  },
  "random_hosts": {
    "type": "bool",
    "default": false,
    "description": "Randomize the host list order."
  },
  "transforms": {
    "type": "list",
    "default": [],
    "description": "List of custom transform strings to send with --trans."
  },
  "vendor_ids": {
    "type": "list",
    "default": [],
    "description": "List of vendor ID hex strings to send with --vendor."
  },
  "patterns_file": {
    "type": "string",
    "default": "/usr/local/share/ike-scan/ike-backoff-patterns",
    "description": "Path to IKE backoff patterns file."
  },
  "vidpatterns_file": {
    "type": "string",
    "default": "/usr/local/share/ike-scan/ike-vendor-ids",
    "description": "Path to Vendor ID patterns file."
  },
  "ike_lifetime": {
    "type": "number",
    "default": 28800,
    "description": "IKE lifetime in seconds."
  },
  "psk_crack": {
    "type": "bool",
    "default": false,
    "description": "Output aggressive mode PSK parameters for cracking."
  },
  "source_ip": {
    "type": "string",
    "default": "",
    "description": "Source IP address for outgoing packets. Use 'random' for per-packet random."
  },
  "fuzz": {
    "type": "number",
    "default": 0,
    "description": "Pattern matching fuzz in ms. 0 to use default."
  },
  "header_ver": {
    "type": "number",
    "default": 16,
    "description": "ISAKMP header version. Default 16 (v1.0)."
  },
  "mbz": {
    "type": "number",
    "default": 0,
    "description": "Value for reserved MBZ fields (0-255)."
  },
  "doi": {
    "type": "number",
    "default": 1,
    "description": "SA DOI. Default 1 (IPsec)."
  },
  "situation": {
    "type": "number",
    "default": 1,
    "description": "SA Situation. Default 1 (SIT_IDENTITY_ONLY)."
  },
  "protocol": {
    "type": "number",
    "default": 1,
    "description": "Proposal protocol ID. Default 1 (PROTO_ISAKMP)."
  },
  "transid": {
    "type": "number",
    "default": 1,
    "description": "Transform ID. Default 1 (KEY_IKE)."
  },
  "spisize": {
    "type": "number",
    "default": 0,
    "description": "Proposal SPI size. 0 for no SPI."
  },
  "hdrflags": {
    "type": "number",
    "default": 0,
    "description": "ISAKMP header flags."
  },
  "hdrmsgid": {
    "type": "number",
    "default": 0,
    "description": "ISAKMP header message ID."
  },
  "rcookie": {
    "type": "string",
    "default": "",
    "description": "ISAKMP responder cookie in hex."
  },
  "certreq": {
    "type": "string",
    "default": "",
    "description": "CertificateRequest payload in hex."
  },
  "exchange": {
    "type": "number",
    "default": 0,
    "description": "Exchange type. 0 for default."
  },
  "nextpayload": {
    "type": "number",
    "default": 0,
    "description": "Next payload value."
  },
  "auth": {
    "type": "number",
    "default": 1,
    "description": "Auth method. Default 1 (PSK)."
  },
  "gssid": {
    "type": "string",
    "default": "",
    "description": "GSS ID hex string."
  },
  "headerlen": {
    "type": "string",
    "default": "",
    "description": "ISAKMP header length modifier (e.g., '+10', '-5', '100')."
  },
  "tcp_mode": {
    "type": "number",
    "default": 0,
    "description": "TCP transport mode. 1=RAW (Checkpoint), 2=Encapsulated (Cisco). 0=UDP."
  },
  "tcp_timeout": {
    "type": "number",
    "default": 10,
    "description": "TCP connect timeout in seconds."
  },
  "random_seed": {
    "type": "number",
    "default": 0,
    "description": "Seed for PRNG. 0 for unpredictable."
  }
}
