{
  "debug_level": 1,
  "allow_plaintext_auth": false,
  "allow_cram_md5": true,
  "allow_digest_md5": false,
  "listeners": [
    {
      "host": "0.0.0.0",
      "port": 110
    },
    {
      "host": "::",
      "port": 110
    },
    {
      "host": "0.0.0.0",
      "port": 995
    }
  ],
  "auth_mechanism": "pam",
  "maildir_path": "Maildir",
  "enable_tls": true,
  "tls_cert_file": "/etc/ssl/certs/pop3.example.com.crt",
  "tls_key_file": "/etc/ssl/private/pop3.example.com.key",
  "tls_min_version": "tls1.2",
  "tls_cipher_list": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "max_connections_per_ip": 5,
  "max_total_connections": 200,
  "idle_timeout": 180,
  "auth_timeout": 30,
  "log_to_file": true,
  "log_file": "/var/log/mailutils/pop3d.log",
  "log_level": 4
}
