# ==============================================================================
# amtterm — Intel AMT Serial-over-LAN (SoL) Client Configuration
# ==============================================================================
# This file configures amtterm, a client utility for accessing the serial-over-LAN
# console of Intel Active Management Technology (AMT) machines.
#
# Self-documenting: every directive below is prefixed with its schema description.
# Defaults are explicitly enforced via Jinja2 |default() filters to ensure safe
# rendering even when variables are undefined or omitted.
# ==============================================================================

[amtterm]

# Hostname or IP address of the Intel AMT machine.
# Defaults to 'localhost' if not specified by the caller.
host = {{ host | default('localhost') }}

# TCP port for AMT redirection; standard is 16994.
# Defaults to 16994 if not specified.
port = {{ port | default(16994) | string }}

# Username for AMT authentication.
# Defaults to 'admin' if not specified.
user = {{ user | default('admin') }}

# Password for AMT authentication.
# Optional; if empty, AMT_PASSWORD environment variable or interactive prompt is used.
# Defaults to empty string if not specified.
password = {{ password | default('') }}

# Verbosity level: 0=quiet, 1=default, 2=verbose.
# Defaults to 1 (normal) if not specified.
verbosity = {{ verbosity | default(1) | string }}