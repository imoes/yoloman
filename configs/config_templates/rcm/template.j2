# RCM dotfile management configuration
# This file is read by rcup, rcdn, lsrc, and mkrc.
#
# This template is self-documenting. Every configuration directive is preceded
# by a comment derived from the schema description. All variables use the
# `| default(...)` filter to prevent rendering errors when values are not
# provided in the inventory or playbook variables.

# The path to the directory containing the source rc files.
DOTFILES_DIRS = "{{ (dotfiles_dir | default('~/.dotfiles')) }}"

# Tags to include during rcup operations. Corresponds to tag-* subdirectories.
TAGS = {{ tags | default(['default']) | tojson }}

# Patterns or files to exclude from management. Supports scoping like 'dir:file'.
# Corresponds to -x flag.
EXCLUDES = {{ excludes | default([]) | tojson }}

# Names of files or directories that should be created without a leading dot.
# Corresponds to -U flag context.
UNDOTTED = {{ undotted | default([]) | tojson }}