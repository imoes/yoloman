{
  "url_base": "https://example.com",
  "wordlists": [
    "/usr/share/dirb/wordlists/common.txt"
  ],
  "user_agent": "Dirb/2.22",
  "no_squash_sequences": true,
  "cookie": "sessionid=abc123",
  "certificate_file": "/etc/ssl/client.crt",
  "fine_tune_404": true,
  "extra_headers": [
    "X-Forwarded-For: 10.0.0.1",
    "X-Request-ID: scan-1"
  ],
  "case_insensitive": true,
  "print_location_header": true,
  "ignore_codes": [
    301,
    302
  ],
  "output_file": "/tmp/dirb_results.txt",
  "proxy": "proxy.internal:3128",
  "proxy_auth": "user:pass",
  "no_recursive": true,
  "interactive_recursive": false,
  "silent_mode": true,
  "no_trailing_slash": true,
  "auth_credentials": "admin:secretpass",
  "verbose_not_exist": true,
  "no_stop_warning": true,
  "extensions_file": "",
  "extra_extensions": [
    ".php",
    ".bak",
    ".old"
  ],
  "delay_ms": 100
}
