{
  "exec": {
    "type": "string",
    "default": "/usr/sbin/spice-vdagentd",
    "description": "Path to the spice-vdagentd executable."
  },
  "prog": {
    "type": "string",
    "default": "spice-vdagentd",
    "description": "Name of the program/daemon."
  },
  "pidfile": {
    "type": "string",
    "default": "/var/run/spice-vdagentd/spice-vdagentd.pid",
    "description": "Path to the PID file for the daemon."
  },
  "port": {
    "type": "string",
    "default": "/dev/virtio-ports/com.redhat.spice.0",
    "description": "Path to the virtio serial port device used by the spice agent."
  }
}
