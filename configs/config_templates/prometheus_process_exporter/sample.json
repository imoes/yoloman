{
  "web.listen_address": ":9256",
  "procfs.path": "/proc",
  "sysfs.path": "/sys",
  "process.include_patterns": [
    "nginx",
    "node",
    "re:python.*"
  ],
  "process.exclude_patterns": [
    "prometheus-process-exporter",
    "sshd"
  ],
  "metrics.collect_threads": true,
  "metrics.collect_zombies": false,
  "metrics.collect_init": true,
  "web.timeout": "30s",
  "web.max_requests": 0,
  "tls.enabled": false,
  "tls.config_file": "",
  "extra_args": []
}
