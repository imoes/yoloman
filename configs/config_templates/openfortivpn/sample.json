{
  "gateway": "vpn.example.com",
  "username": "alice",
  "password": "",
  "realm": "corp",
  "ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "client_cert": "/etc/openfortivpn/client.crt",
  "client_key": "/etc/openfortivpn/client.key",
  "no_verify_ssl": false,
  "local_ip": "",
  "local_netmask": "",
  "set_routes": true,
  "add_routes": [
    "10.10.0.0/24",
    "172.16.0.0/16"
  ],
  "exclude_routes": [
    "192.168.1.0/24"
  ],
  "dns_servers": [
    "10.10.0.1",
    "10.10.0.2"
  ],
  "proxy_host": "proxy.example.com",
  "proxy_port": 3128,
  "proxy_username": "proxyuser",
  "proxy_password": "proxypass",
  "ppp_mtu": 1380,
  "trusted_cert": "a1:b2:c3:d4:e5:f6:...",
  "interface": "ppp0",
  "post_up": "/usr/local/bin/vpn-firewall.sh up",
  "pre_down": "/usr/local/bin/vpn-firewall.sh down",
  "idle_timeout": 1800
}
