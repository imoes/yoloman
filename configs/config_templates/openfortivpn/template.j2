### configuration file for openfortivpn, see man openfortivpn(1) ###

{% if gateway is defined and gateway is not none and (gateway is number or gateway is boolean or gateway | length > 0) %}host = {{ gateway }}
{% else %}# host = vpn.example.org
{% endif %}{% if port is defined and port is not none and (port is number or port is boolean or port | length > 0) %}port = {{ port }}
{% else %}# port = 443
{% endif %}{% if username is defined and username is not none and (username is number or username is boolean or username | length > 0) %}username = {{ username }}
{% else %}# username = vpnuser
{% endif %}{% if password is defined and password is not none and (password is number or password is boolean or password | length > 0) %}password = {{ password }}
{% else %}# password = VPNpassw0rd
{% endif %}