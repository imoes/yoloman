<?xml version="1.0"?>
<!--
  BOINC Client Configuration File (cc_config.xml)

  This file controls the behavior and logging verbosity of the BOINC core client.
  For a complete reference, see:
  https://boinc.berkeley.edu/wiki/client_configuration

  NOTE: All boolean values in BOINC config are represented as '1' (true) or '0' (false).
-->
<cc_config>
  <!-- Logging flags: control which events are written to the BOINC log file. -->
  <log_flags>
    <!-- Log task-related events (e.g., starting, finishing, aborting tasks).
         Default: '1' (enabled) -->
    <task>{{ boinc_log_task | default('1') }}</task>

    <!-- Log file transfer events (e.g., downloading results, uploading output).
         Default: '1' (enabled) -->
    <file_xfer>{{ boinc_log_file_xfer | default('1') }}</file_xfer>

    <!-- Log scheduler operations (e.g., checking for new work, scheduling decisions).
         Default: '1' (enabled) -->
    <sched_ops>{{ boinc_log_sched_ops | default('1') }}</sched_ops>
  </log_flags>
</cc_config>
