{
  "ovs_bridge": "br-int",
  "enable_tunneling": true,
  "local_ip": "10.0.0.3",
  "tunnel_types": [
    "vxlan"
  ],
  "vlan_mapping": false,
  "enable_isolated_metadata": true,
  "enable_metadata_proxy": true,
  "flow_limit": 0,
  "ovsdb_connection_timeout": 180,
  "ovs_vsctl_timeout": 5,
  "log_rate_limit": 1000,
  "log_level": "INFO",
  "enable_security_group": true,
  "firewall_driver": "iptables_hybrid",
  "ipset_fuzzy_match": false,
  "type_drivers": [
    "flat",
    "vlan",
    "vxlan"
  ],
  "tenant_network_types": [
    "vxlan",
    "vlan"
  ],
  "mechanism_drivers": [
    "openvswitch"
  ],
  "bridge_mappings": [
    {
      "network": "physnet1",
      "bridge": "br-ex"
    },
    {
      "network": "physnet2",
      "bridge": "br-ex2"
    }
  ],
  "device_mappings": [
    {
      "network": "physnet1",
      "device": "eth1"
    },
    {
      "network": "physnet2",
      "device": "eth2"
    }
  ],
  "enable_l3_agent_extension": true,
  "enable_dhcp_agent_extension": true,
  "enable_metering_extension": false
}
