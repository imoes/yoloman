{
  "logfile": {
    "type": "string",
    "default": "syslog",
    "description": "Logfile for status messages"
  },
  "loglevel": {
    "type": "number",
    "default": 3,
    "description": "Log level: debug(1), info(3), notice(5), error(7) or fatal(8)"
  },
  "ct2_hash_enable": {
    "type": "number",
    "default": 0,
    "description": "Enable hash for ct2"
  },
  "log1_group": {
    "type": "number",
    "default": 0,
    "description": "Netlink multicast group for log1"
  },
  "log2_group": {
    "type": "number",
    "default": 1,
    "description": "Netlink multicast group for log2"
  },
  "log3_group": {
    "type": "number",
    "default": 2,
    "description": "Netlink multicast group for log3"
  },
  "log3_numeric_label": {
    "type": "number",
    "default": "1 # you can label the log info based on the packet verdict",
    "description": "Numeric label for log3"
  },
  "ulog1_nlgroup": {
    "type": "number",
    "default": 1,
    "description": "Netlink multicast group for ulog1"
  },
