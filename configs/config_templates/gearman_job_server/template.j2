# =============================================================================
# Gearman Job Server Configuration
# =============================================================================
# This template generates the configuration file for the Gearman Job Server.
# It handles network listening, process management, logging, worker threads,
# queue backend selection (memory, SQLite, MySQL), access control, and status endpoints.
#
# All variables are sourced from the Ansible inventory/group vars.
# Each configuration directive is preceded by a comment describing its purpose,
# derived from the schema definition.
# =============================================================================

# ===========================================================================
# Network / Listener Configuration
# ===========================================================================

# listen_addr: IP address the Gearman server listens on (e.g., '0.0.0.0' for all interfaces, or '127.0.0.1' for localhost only).
# listen_port: Port number for the Gearman job server.
# The server binds to the specified address and port for incoming client and worker connections.
listen={{ (listen_addr | default('0.0.0.0')) }}:{{ (listen_port | default(4730)) }}

# ===========================================================================
# Process & System
# ===========================================================================

# pid_file: Full path to the PID file.
# The Gearman daemon writes its Process ID here upon startup for management purposes.
pid={{ (pid_file | default('/var/run/gearmand.pid')) }}

# data_dir: Directory for persistent data (used for SQLite journal files or other state).
# This directory must exist and be writable by the user running the daemon.
data-dir={{ (data_dir | default('/var/lib/gearmand')) }}

# daemonize: If true, run Gearman as a background daemon. Set to false for foreground debugging.
# When enabled, the process forks to the background after initialization.
{% if (daemonize | default(true)) %}
daemon
{% endif %}

# ===========================================================================
# Logging & Diagnostics
# ===========================================================================

# log_file: Path to the log file (use '-' to log to stderr, or empty string to disable file logging).
# Specifies the destination for standard log output. Use '-' for standard error.
log-file={{ (log_file | default('/var/log/gearmand/gearmand.log')) }}

# log_level: Verbosity level for logging. Higher levels include more detail.
# Levels typically include: emerg, alert, crit, err, warning, notice, info, debug.
log-level={{ (log_level | default('warning')) }}

# use_syslog: If true, disable logging to syslog (note: 'no-log' disables ALL logging; this setting controls syslog specifically).
# If use_syslog is False, the 'no-log' directive is emitted to suppress syslog output as per legacy behavior.
{% if not (use_syslog | default(false)) %}
no-log
{% endif %}

# ===========================================================================
# Worker & Thread Management
# ===========================================================================

# worker_threads: Number of worker threads. Set to 0 for automatic detection (recommended).
# Controls the base number of threads used to process jobs.
worker={{ (worker_threads | default(0)) }}

# max_threads: Maximum number of worker threads (upper bound for internal thread pool size).
# Prevents the thread pool from growing beyond this limit under heavy load.
max-threads={{ (max_threads | default(1024)) }}

# job_limit: Maximum number of concurrent jobs a worker may handle (set to null/undefined to disable limit).
# If a specific limit is defined (non-null), it restricts how many jobs a single worker processes simultaneously.
{% if (job_limit | default(None)) is not none %}
job-limit={{ job_limit | default(omit) }}
{% endif %}

# ===========================================================================
# Queue Backend & Persistence
# ===========================================================================

# queue_type: Backend storage for job queue persistence: 'memory' (fastest, volatile), 'sqlite' (local file), or 'mysql' (remote database).
# Selects the storage engine for the job queue. 'memory' is volatile; 'sqlite' and 'mysql' provide persistence.
queue-type={{ (queue_type | default('memory')) }}

# sqlite_db_path: Path to the SQLite database file (only used when queue_type='sqlite').
# Specifies the location of the SQLite database file if the queue backend is SQLite.
{% if (queue_type | default('memory')) == 'sqlite' %}
sqlite-db={{ (sqlite_db_path | default('/var/lib/gearmand/gearmand.db')) }}
{% endif %}

# ===========================================================================
# MySQL Connection Parameters (used only if queue-type=mysql)
# ===========================================================================
# These fields configure the remote MySQL database connection for job persistence.
{% if (queue_type | default('memory')) == 'mysql' %}

# mysql_host: MySQL server hostname or IP address (only used when queue_type='mysql').
# The address of the MySQL server providing persistent storage.
mysql-host={{ (mysql_host | default('localhost')) }}

# mysql_port: MySQL server port (only used when queue_type='mysql').
# The network port on which the MySQL server listens.
mysql-port={{ (mysql_port | default(3306)) }}

# mysql_user: MySQL username for the Gearman database (only used when queue_type='mysql').
# The database user account used for authentication.
mysql-user={{ (mysql_user | default('gearman')) }}

# mysql_password: MySQL password for the Gearman user (only used when queue_type='mysql').
# The password for the database user. Empty string if not used.
mysql-password={{ (mysql_password | default('')) }}

# mysql_db: MySQL database name (only used when queue_type='mysql').
# The specific database schema where Gearman tables reside.
mysql-db={{ (mysql_db | default('gearman')) }}

{% endif %}

# ===========================================================================
# Security & Access Control
# ===========================================================================

# timeout: Seconds before a client or worker is considered dead and disconnected.
# If no activity is received within this period, the connection is closed.
timeout={{ (timeout | default(60)) }}

# allow_clients: List of allowed client IP addresses or CIDR blocks. Use '*' to allow all.
# Restricts which hosts can connect to the Gearman server. '*' allows unrestricted access.
allow-client={{ (allow_clients | default(['*'])) | join(',') }}

# ===========================================================================
# HTTP Status Endpoint
# ===========================================================================

# status_port: Port for the HTTP-based status endpoint (set to 0 to disable).
# Enables a lightweight HTTP server for monitoring job statistics and server status.
{% if (status_port | default(0)) > 0 %}
http-port={{ status_port | default(0) }}
{% endif %}