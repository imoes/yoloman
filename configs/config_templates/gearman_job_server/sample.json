{
  "listen_addr": "0.0.0.0",
  "listen_port": 4730,
  "pid_file": "/var/run/gearmand.pid",
  "log_file": "/var/log/gearmand/gearmand.log",
  "log_level": "info",
  "worker_threads": 0,
  "max_threads": 2048,
  "queue_type": "sqlite",
  "sqlite_db_path": "/var/lib/gearmand/gearmand.db",
  "data_dir": "/var/lib/gearmand",
  "timeout": 120,
  "daemonize": true,
  "allow_clients": [
    "10.0.0.0/8",
    "192.168.1.0/24"
  ],
  "use_syslog": true,
  "status_port": 4731
}
