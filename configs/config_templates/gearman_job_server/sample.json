{
 "allow_clients": [
  "10.0.0.0/8",
  "192.168.1.0/24"
 ],
 "daemonize": true,
 "data_dir": "/var/lib/gearmand",
 "listen_addr": "0.0.0.0",
 "listen_port": 4730,
 "log_file": "/var/log/gearmand/gearmand.log",
 "log_level": "info",
 "max_threads": 2048,
 "omit": "",
 "pid_file": "/var/run/gearmand.pid",
 "queue_type": "sqlite",
 "sqlite_db_path": "/var/lib/gearmand/gearmand.db",
 "status_port": 4731,
 "timeout": 120,
 "use_syslog": true,
 "worker_threads": 0
}
