<?xml version="1.0"?>
<!--
  XHTML 1.0 DTD Catalog Configuration
  ====================================
  This file defines an OASIS XML Catalog that delegates all XHTML 1.0 DTD
  lookups (Public IDs and System IDs/URIs) to the local DTD installation.
  It allows XML processors to resolve W3C XHTML references using the
  Red Hat-provided local files instead of fetching them from the web.
-->
<!DOCTYPE catalog PUBLIC "-//OASIS//DTD Entity Resolution XML Catalog V1.0//EN" "http://www.oasis-open.org/committees/entity/release/1.0/catalog.dtd">
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">

  {# ----------------------------------------------------------------------- #}
  {# Delegate Public IDs for XHTML 1.0 Strict/Transitional/Frameset DTDs   #}
  {# The public ID starts with "-//W3C//DTD XHTML 1.0"                      #}
  {# ----------------------------------------------------------------------- #}
  <!--
    Description: Delegate Public ID lookups starting with "-//W3C//DTD XHTML 1.0"
                 to the local catalog.xml found in the DTD base path.
    Variable:    xhtml_dtd_base_path (default: /usr/share/xml/xhtml/1.0)
  -->
  <delegatePublic publicIdStartString="-//W3C//DTD XHTML 1.0"
                  catalog="file://{{ xhtml_dtd_base_path | default('/usr/share/xml/xhtml/1.0') }}/catalog.xml"/>

  {# ----------------------------------------------------------------------- #}
  {# Delegate Public IDs for XHTML Entity Sets                               #}
  {# Latin 1, Special, and Symbols entity sets                               #}
  {# ----------------------------------------------------------------------- #}

  <!--
    Description: Delegate Public ID lookups for the "Latin 1 for XHTML" entity
                 set to the local catalog.xml.
    Variable:    xhtml_dtd_base_path (default: /usr/share/xml/xhtml/1.0)
  -->
  <delegatePublic publicIdStartString="-//W3C//ENTITIES Latin 1 for XHTML"
                  catalog="file://{{ xhtml_dtd_base_path | default('/usr/share/xml/xhtml/1.0') }}/catalog.xml"/>

  <!--
    Description: Delegate Public ID lookups for the "Special for XHTML" entity
                 set to the local catalog.xml.
    Variable:    xhtml_dtd_base_path (default: /usr/share/xml/xhtml/1.0)
  -->
  <delegatePublic publicIdStartString="-//W3C//ENTITIES Special for XHTML"
                  catalog="file://{{ xhtml_dtd_base_path | default('/usr/share/xml/xhtml/1.0') }}/catalog.xml"/>

  <!--
    Description: Delegate Public ID lookups for the "Symbols for XHTML" entity
                 set to the local catalog.xml.
    Variable:    xhtml_dtd_base_path (default: /usr/share/xml/xhtml/1.0)
  -->
  <delegatePublic publicIdStartString="-//W3C//ENTITIES Symbols for XHTML"
                  catalog="file://{{ xhtml_dtd_base_path | default('/usr/share/xml/xhtml/1.0') }}/catalog.xml"/>

  {# ----------------------------------------------------------------------- #}
  {# Delegate System IDs (URI-like system identifiers)                       #}
  {# ----------------------------------------------------------------------- #}

  <!--
    Description: Delegate System ID lookups for the standard XHTML 1.0 DTD
                 path to the local catalog.xml.
    Variable:    xhtml_dtd_base_path (default: /usr/share/xml/xhtml/1.0)
  -->
  <delegateSystem systemIdStartString="http://www.w3.org/TR/xhtml1/DTD/"
                  catalog="file://{{ xhtml_dtd_base_path | default('/usr/share/xml/xhtml/1.0') }}/catalog.xml"/>

  {# ----------------------------------------------------------------------- #}
  {# Delegate URI lookups (for processors that treat System IDs as URIs)     #}
  {# ----------------------------------------------------------------------- #}

  <!--
    Description: Delegate URI lookups for the standard XHTML 1.0 DTD path
                 to the local catalog.xml.
    Variable:    xhtml_dtd_base_path (default: /usr/share/xml/xhtml/1.0)
  -->
  <delegateURI uriStartString="http://www.w3.org/TR/xhtml1/DTD/"
               catalog="file://{{ xhtml_dtd_base_path | default('/usr/share/xml/xhtml/1.0') }}/catalog.xml"/>

  {# ----------------------------------------------------------------------- #}
  {# Delegate Legacy REC XHTML 1.0 DTD                                       #}
  {# ----------------------------------------------------------------------- #}

  <!--
    Description: Delegate System ID lookups for the specific 2002 XHTML 1.0
                 Recommendation DTD path to the local catalog.xml.
    Variable:    xhtml_dtd_base_path (default: /usr/share/xml/xhtml/1.0)
  -->
  <delegateSystem systemIdStartString="http://www.w3.org/TR/2002/REC-xhtml1-20020801/DTD/"
                  catalog="file://{{ xhtml_dtd_base_path | default('/usr/share/xml/xhtml/1.0') }}/catalog.xml"/>

  <!--
    Description: Delegate URI lookups for the specific 2002 XHTML 1.0
                 Recommendation DTD path to the local catalog.xml.
    Variable:    xhtml_dtd_base_path (default: /usr/share/xml/xhtml/1.0)
  -->
  <delegateURI uriStartString="http://www.w3.org/TR/2002/REC-xhtml1-20020801/DTD/"
               catalog="file://{{ xhtml_dtd_base_path | default('/usr/share/xml/xhtml/1.0') }}/catalog.xml"/>

</catalog>
