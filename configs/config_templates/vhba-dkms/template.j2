# vhba-dkms module configuration
#
# vhba-dkms is a kernel module that provides Virtual Host Bus Adapter (VHBA) functionality,
# allowing the creation of virtual SCSI host adapters within the kernel. It is typically
# used by storage virtualization layers or testing frameworks to simulate SCSI devices.
#
# Since this is a kernel module, it does not have a traditional long-running configuration
# file. Parameters are passed to the module at load time via modprobe configuration files
# located in /etc/modprobe.d/.
#
# This template generates the modprobe configuration file to set default module parameters.

# Main configuration directive for vhba-dkms module options
# Format: options <module_name> [param=value ...]
# This line combines all defined parameters into a single 'options' directive for modprobe.
options vhba {{ vhba_options | default({}) | tojson | replace('": ', '=') | replace('{', '') | replace('}', '') | replace('"', '') | trim }}

{% for item in vhba_options | default({}) | dict2items %}
# {{ item.key }}: {{ item.value | default('unset') }}
# Description: Sets the '{{ item.key }}' parameter for the vhba kernel module.
{% endfor %}