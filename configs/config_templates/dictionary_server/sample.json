{
  "bind_host": "0.0.0.0",
  "bind_port": 2628,
  "max_connections": 200,
  "debug": false,
  "default_db": [
    "gcide",
    "moby-thesaurus"
  ],
  "dict_dir": "/usr/share/dicod/dicts",
  "client_timeout": 60,
  "compression": true,
  "auth_realm": "",
  "databases": [
    {
      "name": "gcide",
      "path": "dicts/gcide.dict",
      "description": "GNU Collaborative International Dictionary of English",
      "allow_hosts": [
        "10.0.0.0/8",
        "192.168.1.0/24"
      ],
      "deny_hosts": [
        "203.0.113.0/24"
      ],
      "max_results": 100
    },
    {
      "name": "moby-thesaurus",
      "path": "moby-thesaurus.dict",
      "description": "Moby Thesaurus II",
      "allow_hosts": [],
      "deny_hosts": [],
      "max_results": null
    }
  ]
}
