{#
  gfxboot-themes Configuration Template
  =====================================
  This template generates the configuration for the gfxboot bootloader themes.
  It is self-documenting: every configuration directive is preceded by a comment
  derived from the schema description. All variables use `default()` to ensure
  safe rendering even if the variable is undefined in the Ansible inventory.
#}

{#
  Splash screen mode: '0' to disable, 'woordryk' for verbose, 'stil' for silent with progress bar
#}
splat={{ o_splash | default('stil') }}

{#
  APM status: 'af' to disable, 'aan' to enable
#}
apm={{ o_apm | default('aan') }}

{#
  ACPI status: 'af' to disable, 'dwang' to force on (even on old BIOS), 'ouselflaai' for boot-only, 'aan' for default
#}
acpi={{ o_acpi | default('aan') }}

{#
  IDE kernel parameter: 'geendma' to disable DMA, empty or other string for other settings
#}
ide={{ o_ide | default('geendma') }}