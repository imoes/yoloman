{#
  gfxboot-themes boot loader configuration template.
  This template generates a configuration file for gfxboot (GRUB-based splash screen loader).
  It handles splash screen modes, APM/ACPI power management, and IDE settings.
#}

# gfxboot-themes Configuration
# Generated by Ansible Jinja2 Template

# ==============================================================================
# Splash Screen Configuration
# o_splash: Controls the visual feedback during boot.
#   - '0': Disables the splash screen entirely (text mode).
#   - 'woordryk': Verbose mode; shows splash, kernel messages, and boot details.
#   - 'stil': Silent mode; shows splash with a progress bar, suppresses messages.
# ==============================================================================
o_splash={{ o_splash | default('stil') }}

# ==============================================================================
# APM (Advanced Power Management) Configuration
# o_apm: Toggles legacy APM power management support.
#   - 'af': Disables APM completely.
#   - 'aan': Enables APM (default for older hardware compatibility).
# ==============================================================================
o_apm={{ o_apm | default('aan') }}

# ==============================================================================
# ACPI (Advanced Configuration and Power Interface) Configuration
# o_acpi: Controls ACPI behavior.
#   - 'af': Disables ACPI completely.
#   - 'dwang': Forces ACPI on, even if the BIOS is old (pre-2000).
#   - 'ouselflaai': Boot-only mode; activates only ACPI parts necessary for booting.
#   - 'aan': Default mode; uses standard ACPI behavior.
# ==============================================================================
o_acpi={{ o_acpi | default('aan') }}

# ==============================================================================
# IDE Kernel Parameter Configuration
# o_ide: Controls IDE subsystem settings.
#   - 'geendma': Disables Direct Memory Access (DMA) for IDE drives (useful for unstable hardware).
#   - Any other value or empty string: Leaves default IDE settings alone.
# ==============================================================================
o_ide={{ o_ide | default('geendma') }}
