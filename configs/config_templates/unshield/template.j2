# Unshield CLI execution script template
# Generated by gonja Jinja2 engine

# Command to run unshield
{% set command = 'unshield' %}

{% if command_type == 'extract' %}
  # Extract files to {{ output_directory }}
  {{ command }} x -d {{ output_directory }} {{ input_cab_file }}
  {% if force_version %}
  # Force InstallShield version {{ force_version }}
  {{ command }} x -d {{ output_directory }} -i {{ force_version }} {{ input_cab_file }}
  {% endif %}
  {% if debug_level != '0' %}
  # Set debug log level {{ debug_level }}
  {{ command }} x -d {{ output_directory }} -D {{ debug_level }} {{ input_cab_file }}
  {% endif %}
  {% if overwrite %}
  # Always overwrite files
  {{ command }} x -d {{ output_directory }} -o {{ input_cab_file }}
  {% endif %}
  {% if never_overwrite %}
  # Never overwrite files
  {{ command }} x -d {{ output_directory }} -n {{ input_cab_file }}
  {% endif %}
  {% if lower_case_names %}
  # Make file and directory names lowercase
  {{ command }} x -d {{ output_directory }} -L {{ input_cab_file }}
  {% endif %}
  {% if junk_paths %}
  # Junk paths (do not make directories)
  {{ command }} x -d {{ output_directory }} -j {{ input_cab_file }}
  {% endif %}
  {% if raw_data %}
  # Save raw data (do not decompress)
  {{ command }} x -d {{ output_directory }} -r {{ input_cab_file }}
  {% endif %}
  {% if old_compression %}
  # Use old compression
  {{ command }} x -d {{ output_directory }} -O {{ input_cab_file }}
  {% endif %}
  {% if no_conversion %}
  # Don't do any conversion to file and directory names
  {{ command }} x -d {{ output_directory }} -R {{ input_cab_file }}
  {% endif %}
  {% if component %}
  # Only list/extract component {{ component }}
  {{ command }} x -d {{ output_directory }} -c {{ component }} {{ input_cab_file }}
  {% endif %}
  {% if file_group %}
  # Only list/extract file group {{ file_group }}
  {{ command }} x -d {{ output_directory }} -g {{ file_group }} {{ input_cab_file }}
  {% endif %}
  {% if verbose %}
  # Be verbose
  {{ command }} x -d {{ output_directory }} -v {{ input_cab_file }}
  {% endif %}
{% elif command_type == 'list' %}
  # List files in {{ input_cab_file }}
  {{ command }} l {{ input_cab_file }}
  {% if verbose %}
  # Be verbose
  {{ command }} l -v {{ input_cab_file }}
  {% endif %}
{% elif command_type == 'test' %}
  # Test files in {{ input_cab_file }}
  {{ command }} t {{ input_cab_file }}
  {% if verbose %}
  # Be verbose
  {{ command }} t -v {{ input_cab_file }}
  {% endif %}
{% elif command_type == 'components' %}
  # List components in {{ input_cab_file }}
  {{ command }} c {{ input_cab_file }}
  {% if verbose %}
  # Be verbose
  {{ command }} c -v {{ input_cab_file }}
  {% endif %}
{% elif command_type == 'groups' %}
  # List file groups in {{ input_cab_file }}
  {{ command }} g {{ input_cab_file }}
  {% if verbose %}
  # Be verbose
  {{ command }} g -v {{ input_cab_file }}
  {% endif %}
{% endif %}