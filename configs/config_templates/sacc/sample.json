{
  "pager": "less",
  "sacc_cert_dir": "/etc/sacc/certs",
  "plumber": "firefox",
  "shortcuts": [
    {
      "key": "j",
      "action": "Move one line down"
    },
    {
      "key": "k",
      "action": "Move one line up"
    },
    {
      "key": "u",
      "action": "Print the URI of the highlighted item"
    },
    {
      "key": "q",
      "action": "Exit sacc"
    }
  ]
}
