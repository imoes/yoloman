{
  "ntp_server": "time.google.com",
  "ntp_pools": [
    {
      "name": "Regional Pool",
      "hostname": "0.pool.ntp.org",
      "description": "Fallback NTP pool for fallback redundancy"
    },
    {
      "name": "Local Pool",
      "hostname": "1.pool.ntp.org",
      "description": "Secondary local pool for resilience"
    }
  ],
  "subnet": "10.0.0.0/8",
  "leapsec_tz": "right/UTC",
  "log_dir": "/var/log/chrony",
  "user": "chrony",
  "ntp_port": 123,
  "driftfile_path": "/var/lib/chrony/drift",
  "enable_auth": false,
  "keyfile_path": "/etc/chrony/keys",
  "makestep_threshold": 1.0,
  "max_steps": 10,
  "leapfile_path": "/usr/share/zoneinfo/leap-seconds.list",
  "smooth_start": true,
  "max_slew_steps": 3,
  "enable_server": true,
  "command_port": 323,
  "enable_rtc": true
}
