- log-level: info
- control-service:
    service: control
    filename: {{ control_service_filename }}
    permissions: {{ control_service_permissions }}

- tcp-listener:
    port: {{ tcp_listener_port }}

- work-command:
    worktype: local
    command: {{ work_command_command }}
    params: {{ work_command_params }}
    allowruntimeparams: {{ work_command_allowruntimeparams | lower }}
