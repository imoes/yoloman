# NATS Server Configuration
# This file configures the basic networking endpoints for the NATS messaging server.

# The host to bind the NATS server to.
# Limits which network interfaces the server listens on.
# Default: 127.0.0.1 (localhost only)
host: {{ host | default('127.0.0.1') }}

# The port to listen on for client connections.
# This is the primary port used by NATS clients to connect to the cluster.
# Default: 4222
port: {{ port | default(4222) }}