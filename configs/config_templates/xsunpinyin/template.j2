# ==============================================================================
# xSunpinyin Input Method Configuration Template
# ==============================================================================
# This configuration file defines the settings for the xSunpinyin XIM server
# and the associated GTK/Qt input method modules.
# ==============================================================================

# Name of the XIM server program.
# Default: 'xsunpinyin'
XIM={{ xim_program_name | default('xsunpinyin') }}

# Command-line arguments for the XIM server.
# Default: '-d' (daemon mode)
XIM_ARGS={{ xim_args | default('-d') }}

# Full path to the XIM server executable.
# Default: '/usr/bin/xsunpinyin'
XIM_PROGRAM={{ xim_program_path | default('/usr/bin/xsunpinyin') }}

# GTK Input Method module name.
# This tells GTK applications which input method framework to use.
# Default: 'xim'
GTK_IM_MODULE={{ gtk_im_module | default('xim') }}

# Qt Input Method module name.
# This tells Qt applications which input method framework to use.
# Default: 'xim'
QT_IM_MODULE={{ qt_im_module | default('xim') }}