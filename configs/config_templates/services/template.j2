# Standard /etc/services — maps network service names to port numbers and protocols
# This file is typically managed by the 'netbase' package.
# Do NOT edit manually — use 'update-inetd' or similar tools instead.
# However, for containerized or minimal deployments, a static template is provided below.
# Lines starting with '#' are comments.
# Each service line has format: <name> <port>/<protocol> [aliases...] #[comment]
{% for service in services %}{{ service.name }}	{{ service.port }}/{{ service.protocol }}{% if service.aliases %} {% for alias in service.aliases %}{{ alias }}{% if not loop.last %} {% endif %}{% endfor %}{% endif %}{% if service.comment %} # {{ service.comment }}{% endif %}
{% endfor %}