{
  "services": {
    "type": "list",
    "default": [],
    "description": "List of network services to define in /etc/services. Each service entry maps a name to a port, protocol, optional aliases, and comment.",
    "items": {
      "type": "object",
      "fields": {
        "name": {
          "type": "string",
          "default": "",
          "description": "Official service name (e.g., http, ssh, ftp). Must be unique."
        },
        "port": {
          "type": "number",
          "default": 0,
          "description": "TCP or UDP port number (1\u201365535)."
        },
        "protocol": {
          "type": "string",
          "default": "tcp",
          "description": "Transport protocol \u2014 usually 'tcp', 'udp', or 'tcp/udp'."
        },
        "aliases": {
          "type": "list",
          "default": [],
          "description": "Optional list of alternate/common names for this service.",
          "items": {
            "type": "string"
          }
        },
        "comment": {
          "type": "string",
          "default": "",
          "description": "Optional human-readable description or note."
        }
      }
    }
  }
}
