{
  "gosa_url": "https://gosa.example.com",
  "gosa_data_dir": "/var/lib/gosa",
  "config_dir": "/etc/gosa",
  "ldap_uri": "ldaps://ldap.example.com:636",
  "ldap_base": "dc=example,dc=com",
  "ldap_bind_dn": "cn=gosa,ou=system,dc=example,dc=com",
  "ldap_bind_password": "secretpassword",
  "ldap_schema_version": "3.0",
  "ldap_debug": false,
  "ldap_tls_verify": true,
  "ldap_timeout": 60,
  "default_lang": "en",
  "default_theme": "dark",
  "session_timeout": 45,
  "session_max_users": 3,
  "password_policy": true,
  "password_min_length": 14,
  "password_require_upper": true,
  "password_require_lower": true,
  "password_require_digit": true,
  "password_require_special": true,
  "smtp_host": "smtp.example.com",
  "smtp_port": 587,
  "smtp_user": "gosa@example.com",
  "smtp_pass": "smtpsecretpassword",
  "smtp_from": "gosa-notifications@example.com",
  "smtp_use_tls": true,
  "log_level": "warning",
  "log_file": "/var/log/gosa/gosa.log",
  "audit_log": true,
  "audit_log_file": "/var/log/gosa/audit.log",
  "admin_allowed_ips": [
    "10.0.0.0/8",
    "192.168.1.0/24"
  ],
  "admin_allowed_hosts": [
    "admin.example.com"
  ],
  "tfa_enabled": true,
  "tfa_methods": [
    "totp",
    "webauthn"
  ],
  "default_groups": [
    "users",
    "staff"
  ],
  "auto_provision": true,
  "ldap_uid_attr": "uid",
  "ldap_mail_attr": "mail",
  "ldap_cn_attr": "cn",
  "ldap_group_objectclass": "groupOfNames",
  "ldap_group_member_attr": "member",
  "ldap_group_member_mode": "dn",
  "service_account_groups": [
    "admin",
    "gosa-admins"
  ],
  "api_enabled": true,
  "api_auth_method": "token",
  "api_cors_origins": [
    "https://dashboard.example.com"
  ],
  "web_enabled": true,
  "web_prefix": "/gosa",
  "session_cookie_name": "gosasid",
  "session_cookie_domain": ".example.com",
  "force_https": true,
  "maintenance_mode": false,
  "maintenance_message": "GOsa will resume shortly \u2014 please stand by.",
  "enabled_plugins": [
    {
      "name": "samba",
      "enabled": true,
      "description": "Samba account management extension"
    },
    {
      "name": "mail",
      "enabled": true,
      "description": "Mail routing and alias management"
    },
    {
      "name": "netgroups",
      "enabled": false,
      "description": "NIS netgroup management"
    }
  ]
}
