# =============================================================================
# GOsa Configuration File
# Main configuration file for GOsa (Groupware Open Source Administration)
# =============================================================================
# This file is generated by Ansible from a Jinja2 template. Do not edit manually.

# =============================================================================
# [GENERAL] Application Paths and Base URL
# =============================================================================

# Base URL where GOsa will be accessible to users (e.g., https://gosa.example.com)
# Must include the protocol and fully qualified domain name.
gosa_url = {{ gosa_url | default('https://gosa.example.com') }}

# Directory for GOsa runtime data (cache, temporary files, session storage)
# Ensure this directory exists and is writable by the GOsa service user.
gosa_data_dir = {{ gosa_data_dir | default('/var/lib/gosa') }}

# Directory where GOsa stores its configuration templates and local overrides
# Custom plugin configs often live here.
config_dir = {{ config_dir | default('/etc/gosa') }}

# =============================================================================
# [LDAP] Directory Server Connection Settings
# =============================================================================

# LDAP server URI (supports ldap://, ldaps://)
# Example: ldap://ldap.example.com or ldaps://ldap.example.com:636
ldap_uri = {{ ldap_uri | default('ldap://localhost') }}

# Base DN for all LDAP operations (search base, user root, etc.)
# Example: dc=example,dc=com
ldap_base = {{ ldap_base | default('dc=example,dc=com') }}

# DN used to bind to LDAP for administrative operations
# This service account needs sufficient privileges to read/write GOsa schemas.
ldap_bind_dn = {{ ldap_bind_dn | default('cn=admin,dc=example,dc=com') }}

# Password for the LDAP bind DN
# SECURITY: In production, inject this securely (e.g., from Ansible Vault) rather than hardcoding.
ldap_bind_password = {{ ldap_bind_password | default('') }}

# GOsa LDAP schema version to use
# Must match the schema installed in the LDAP directory (e.g., 2.6, 3.0).
ldap_schema_version = {{ ldap_schema_version | default('3.0') }}

# Enable low-level LDAP debugging (verbose logging)
# Use only for troubleshooting connection issues; impacts performance.
ldap_debug = {{ ldap_debug | default(False) | lower }}

# Verify SSL/TLS certificates when connecting to LDAP over LDAPS
# Set to False only if using self-signed certs with custom CA configuration elsewhere.
ldap_tls_verify = {{ ldap_tls_verify | default(True) | lower }}

# Maximum time in seconds to wait for LDAP operations (search, bind, modify)
ldap_timeout = {{ ldap_timeout | default(30) }}

# =============================================================================
# [UI] User Interface Localization and Theming
# =============================================================================

# Default language for the GOsa user interface
# ISO 639-1 code (e.g., en, de, fr, es).
default_lang = {{ default_lang | default('en') }}

# Default visual theme for the WebUI
# Examples: default, dark, corporate.
default_theme = {{ default_theme | default('default') }}

# =============================================================================
# [SESSIONS] Session Management
# =============================================================================

# User session expiration time in minutes
# Users will be logged out after this period of inactivity or total duration.
session_timeout = {{ session_timeout | default(60) }}

# Maximum concurrent sessions per user (0 = unlimited)
# Set to 1 to force logout on new login, or a positive integer for limits.
session_max_users = {{ session_max_users | default(0) }}

# =============================================================================
# [SECURITY] Password Policy
# =============================================================================

# Enforce password complexity rules for new/changed passwords
password_policy = {{ password_policy | default(True) | lower }}

# Minimum password length
password_min_length = {{ password_min_length | default(12) }}

# Require at least one uppercase letter in passwords
password_require_upper = {{ password_require_upper | default(True) | lower }}

# Require at least one lowercase letter in passwords
password_require_lower = {{ password_require_lower | default(True) | lower }}

# Require at least one digit in passwords
password_require_digit = {{ password_require_digit | default(True) | lower }}

# Require at least one special character in passwords
# Special characters usually include !@#$%^&*()-_+=[]{}|;:'",.<>?/
password_require_special = {{ password_require_special | default(False) | lower }}

# =============================================================================
# [EMAIL] SMTP Server Configuration
# =============================================================================

# SMTP server hostname for sending emails (notifications, password resets)
smtp_host = {{ smtp_host | default('localhost') }}

# SMTP server port
# Common ports: 587 (STARTTLS), 465 (SSL/TLS), 25 (legacy/relay).
smtp_port = {{ smtp_port | default(587) }}

# SMTP authentication username (leave blank for no auth/open relay)
smtp_user = {{ smtp_user | default('') }}

# SMTP authentication password
# SECURITY: Store securely in Ansible Vault or external secrets manager.
smtp_pass = {{ smtp_pass | default('') }}

# From address used in GOsa-generated emails
smtp_from = {{ smtp_from | default('gosa@example.com') }}

# Use STARTTLS for SMTP connections (recommended for security)
smtp_use_tls = {{ smtp_use_tls | default(True) | lower }}

# =============================================================================
# [LOGGING] Application and Audit Logs
# =============================================================================

# Verbosity level for main application logs
# Levels: debug, info, warning, error, critical
log_level = {{ log_level | default('info') }}

# Path to log file (empty string uses system syslog)
log_file = {{ log_file | default('') }}

# Enable logging of administrative actions for compliance/forensics
audit_log = {{ audit_log | default(True) | lower }}

# Path to audit log file
audit_log_file = {{ audit_log_file | default('/var/log/gosa/audit.log') }}

# =============================================================================
# [ACCESS CONTROL] Admin Access Restrictions
# =============================================================================

# List of allowed IP ranges for administrative access
# Format: space-separated CIDR blocks or IPs (e.g., '192.168.1.0/24 10.0.0.5')
# Empty list allows all IPs.
admin_allowed_ips = {{ admin_allowed_ips | default([]) | join(' ') }}

# List of allowed hostnames for admin access
# Format: space-separated hostnames or FQDNs
# Empty list allows all hosts.
admin_allowed_hosts = {{ admin_allowed_hosts | default([]) | join(' ') }}

# =============================================================================
# [AUTH] Two-Factor Authentication (2FA)
# =============================================================================

# Enable two-factor authentication for admin users
tfa_enabled = {{ tfa_enabled | default(False) | lower }}

# TFA methods allowed for admin accounts
# Supported methods: totp, webauthn, email, sms.
tfa_methods = {{ tfa_methods | default(['totp']) | join(' ') }}

# =============================================================================
# [PROVISIONING] User and Group Defaults
# =============================================================================

# Groups automatically assigned when a new user is registered
# Format: space-separated group names
default_groups = {{ default_groups | default(['users']) | join(' ') }}

# Automatically create local GOsa accounts when users authenticate from LDAP
# Ensures consistent local environment for users coming from LDAP.
auto_provision = {{ auto_provision | default(True) | lower }}

# =============================================================================
# [LDAP MAPPING] Attribute Mappings for Users and Groups
# =============================================================================

# LDAP attribute used as the unique username identifier
ldap_uid_attr = {{ ldap_uid_attr | default('uid') }}

# LDAP attribute used for email address
ldap_mail_attr = {{ ldap_mail_attr | default('mail') }}

# LDAP attribute used for full display name
ldap_cn_attr = {{ ldap_cn_attr | default('cn') }}

# LDAP objectClass used to identify groups
ldap_group_objectclass = {{ ldap_group_objectclass | default('groupOfNames') }}

# LDAP attribute used to list group members
ldap_group_member_attr = {{ ldap_group_member_attr | default('member') }}

# How group membership is stored: 'dn' (full DN) or 'uid' (short username)
ldap_group_member_mode = {{ ldap_group_member_mode | default('dn') }}

# Groups granted elevated privileges for automated tasks/service accounts
service_account_groups = {{ service_account_groups | default(['admin']) | join(' ') }}

# =============================================================================
# [API] REST API Configuration
# =============================================================================

# Enable the REST API for programmatic access
api_enabled = {{ api_enabled | default(True) | lower }}

# Authentication method for API requests (session or token)
api_auth_method = {{ api_auth_method | default('session') }}

# List of origins allowed to make cross-origin requests to the API
# Format: space-separated URLs (e.g., 'https://app.example.com https://dashboard.example.com')
# Empty list disables CORS or restricts based on other rules.
api_cors_origins = {{ api_cors_origins | default([]) | join(' ') }}

# =============================================================================
# [WEBUI] Web Interface Settings
# =============================================================================

# Enable the WebUI interface
web_enabled = {{ web_enabled | default(True) | lower }}

# URL path prefix under which WebUI is served (e.g., /gosa, /)
web_prefix = {{ web_prefix | default('/') }}

# Name of the session cookie
session_cookie_name = {{ session_cookie_name | default('gosasid') }}

# Domain scope for session cookies (empty = current host)
# Set to '.example.com' to share cookies across subdomains.
session_cookie_domain = {{ session_cookie_domain | default('') }}

# Redirect all HTTP to HTTPS (recommended in production)
force_https = {{ force_https | default(True) | lower }}

# Disable user logins and show maintenance banner
maintenance_mode = {{ maintenance_mode | default(False) | lower }}

# Message displayed to users during maintenance mode
maintenance_message = {{ maintenance_message | default('GOsa is currently undergoing scheduled maintenance.') }}

# =============================================================================
# [PLUGINS] Enabled Plugins Configuration
# =============================================================================
# Each plugin listed in `enabled_plugins` generates a `plugin_<name> = true/false` directive.

{% for plugin in enabled_plugins | default([{'name': 'samba', 'enabled': True, 'description': 'Samba account management extension'}, {'name': 'mail', 'enabled': True, 'description': 'Mail routing and alias management'}, {'name': 'netgroups', 'enabled': False, 'description': 'NIS netgroup management'}]) %}
# Plugin: {{ plugin.name }}
# Description: {{ plugin.description }}
plugin_{{ plugin.name }} = {{ plugin.enabled | lower }}
{% endfor %}