# ==============================================================================
# nextcloud-client-libs-redhat: Global Exclusion Patterns
# ==============================================================================
#
# This configuration file defines global file patterns that Nextcloud Client
# should ignore or exclude from synchronization. It is typically located in
# system-wide configuration directories (e.g., /etc/nextcloud-client) or
# applied via package-provided defaults.
#
# These patterns help avoid syncing temporary files, editor backups, OS metadata,
# and other non-essential files, reducing bandwidth and disk I/O.
#
# Format: Each line is a glob pattern. Lines starting with # are comments.
# ==============================================================================

# Ignore Emacs backup files (e.g., file~, file#)
*~
~$*

# Ignore Vim/gedit lock files (e.g., .file.swp, .file.swo)
# Note: The original template used `]*.~*` which is likely a typo for standard
# lock file patterns, but we preserve specific exclusions listed.
.~lock.*

# Generic temporary file patterns
~*.tmp
]*.~*

# macOS/OS X metadata files
# Ignore Spotlight thumbnails
]Icon\r*
# Ignore macOS hidden metadata stores (case-insensitive match handled by glob)
].DS_Store
].ds_store

# macOS resource forks/clippings
*.textClipping
._*

# Windows thumbnail cache
]Thumbs.db
]photothumb.db

# Windows system folder
System Volume Information

# Vim swap files
.*.sw?
.*.*sw?

# macOS temporary/trash folders
].TemporaryItems
].Trashes
].DocumentRevisions-V100
].Trash-*

# macOS hidden files
.fseventd
.apdisk
.Spotlight-V100

# Linux D-Bus directory marker
.directory

# Nextcloud Client temporary download files
# These are created during sync and should not be committed
*.part
*.filepart
*.crdownload

# Kate editor swap files
*.kate-swp

# GNU Cash temporary files
*.gnucash.tmp-*

# Synkron synchronization database
.synkron.*

# FreeFileSync database
.sync.ffs_db

# Symform sync files
.symform
.symform-store

# FUSE hidden files
.fuse_hidden*

# Unison sync files
*.unison

# NFS-related temporary files (often created by NFS clients)
.nfs*

# User-specific saved places (likely specific to a particular client version/config)
# Preserved for compatibility with existing deployments
My Saved Places.

# Hash-based temporary files (e.g., from git or other tools)
\#*#

# Specific library/plugin temporary files
*.sb-*
