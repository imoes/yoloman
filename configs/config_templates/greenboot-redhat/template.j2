# ==============================================================================
# Greenboot Configuration File
# ==============================================================================
# This file configures the greenboot health-checking framework used during
# the boot process on RHEL/Rocky/AlmaLinux systems.
# ==============================================================================

## Generic Settings
# -----------------

# Maximum number of boot attempts before failing.
# Greenboot will retry the boot sequence up to this number of times if a health
# check fails. This allows transient issues to recover before marking the boot
# as failed.
# Type: Integer
# Default: 3
GREENBOOT_MAX_BOOT_ATTEMPTS={{ GREENBOOT_MAX_BOOT_ATTEMPTS | default('3') }}


# Disabled Healthchecks
# ---------------------
# List of healthcheck script names to skip during the boot process.
# These scripts will not be executed, effectively bypassing their checks.
# The value should be a shell-compatible list representation, e.g.:
#   "script1.sh" "script2.sh"
# or an empty list for none:
#   ""
# NOTE: Script names must be spelled EXACTLY as they appear in the healthcheck
# directory. Typos will result in the script being ignored (disabled) or
# potentially causing unexpected behavior if the string is interpreted literally.
# Default: Empty list '()'
DISABLED_HEALTHCHECKS={{ DISABLED_HEALTHCHECKS | default('()') }}
