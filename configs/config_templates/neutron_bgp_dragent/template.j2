[DEFAULT]
# The logging verbosity level (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL)
log_level = {{ log_level | default('INFO') }}

# Path to the log file; empty string disables file logging
log_file = {{ log_file | default('') }}

# Directory path where the agent stores its runtime state (e.g., PID files, lock files)
state_path = {{ state_path | default('/var/lib/neutron/dynamic_routing') }}

# RPC backend implementation (e.g., 'rabbit', 'kombu', 'oslo')
rpc_backend = {{ rpc_backend | default('rabbit') }}

[bgp]
# The BGP router ID (must be a valid IPv4 address); typically the node's management IP
bgp_router_id = {{ bgp_router_id | default('0.0.0.0') }}

# Time in seconds between BGP keepalive messages
keepalive_interval = {{ keepalive_interval | default(30) }}

# BGP hold time in seconds (must be >= keepalive_interval * 3)
hold_interval = {{ hold_interval | default(90) }}

# BGP neighbor configurations (list of objects)
# Each item in bgp_neighbors defines a peer connection.
{% for neighbor in (bgp_neighbors | default([])) %}
# Neighbor: {{ neighbor.name | default('unnamed') }}
[neutron:bgp_neighbor:{{ neighbor.name | default('unnamed') }}]
# IP address of the BGP peer
ip_address = {{ neighbor.ip_address | default('') }}
# Autonomous System number of the peer
remote_as = {{ neighbor.remote_as | default(0) }}
# Password for MD5 authentication (overrides global md5_key_file if set)
password = {{ neighbor.password | default('', true) }}
# Enable or disable this neighbor
enabled = {{ neighbor.enabled | default(true) }}
{% endfor %}