{
  "hosts": [
    {
      "name": "backup",
      "url": "ftp.backup.example.com",
      "user": "backup_user",
      "password": "secret123",
      "port": 21,
      "remote_dir": "backups"
    },
    {
      "name": "cdn",
      "url": "http://cdn.example.com",
      "remote_dir": "static"
    }
  ],
  "sessions": [
    {
      "name": "secure",
      "ssl": true,
      "ssl_force": true,
      "parallel_max": 2,
      "parallel_num": 1
    },
    {
      "name": "high_speed",
      "timeout": 60,
      "passive": false,
      "parallel_max": 8,
      "parallel_num": 4
    }
  ],
  "net_timeout": 30,
  "net_reconnect_interval": 5,
  "ftp_passive_mode": true,
  "ftp_ssl_allow": true,
  "ftp_ssl_force": false,
  "ftp_ssl_data_protect": false,
  "dns_timeout": 30,
  "http_use_proxy": false,
  "http_proxy_host": "",
  "http_proxy_port": 0,
  "ftp_proxy_host": "",
  "ftp_proxy_port": 0,
  "mirror_retry_timeout": 5,
  "mirror_connect_timeout": 10
}
