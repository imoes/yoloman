# Global settings for lftp
set net:timeout 30
set net:reconnect-interval 5
set ftp:passive-mode true

# Mirror and transfer settings
set mirror:parallel-max 4
set mirror:parallel-num 2
set mirror:connect-timeout 10
set mirror:retry-timeout 5
set mirror:ignore-time 0
set ftp:ssl-allow false
set ftp:ssl-force false
set ftp:ssl-data-protect false
set http:use-proxy false
set http:proxy-host ""
set http:proxy-port 0
set ftp:proxy-host ""
set ftp:proxy-port 0
set dns:timeout 30
set ftp:reconnect-interval 5
set ftp:ssl-allow true
set ftp:ssl-force false
set ftp:ssl-data-protect false

# Logging (commented by default)
# set xfer:log true
# set xfer:logfile "/var/log/lftp.log"

# Per-host aliases (expanded from list)
{% for host in hosts %}
# Host: {{ host.name }} ({{ host.url }})
alias {{ host.name }} "open {{ host.url }}{% if host.user %};user {{ host.user }}{% endif %}{% if host.password %};pass {{ host.password }}{% endif %}{% if host.port %} -p {{ host.port }}{% endif %};cd {{ host.remote_dir }}"
{% endfor %}

# Pseudo-interactive session defaults (can be overridden per-session)
{% for session in sessions %}
# Session: {{ session.name }}
{% if session.timeout is defined %}set net:timeout {{ session.timeout }}
{% endif %}{% if session.passive is defined %}set ftp:passive-mode {{ session.passive | lower }}
{% endif %}{% if session.ssl is defined %}set ftp:ssl-allow {{ session.ssl | lower }}
{% endif %}{% if session.ssl_force is defined %}set ftp:ssl-force {{ session.ssl_force | lower }}
{% endif %}{% if session.reconnect is defined %}set ftp:reconnect-interval {{ session.reconnect }}
{% endif %}{% if session.parallel_max is defined %}set mirror:parallel-max {{ session.parallel_max }}
{% endif %}{% if session.parallel_num is defined %}set mirror:parallel-num {{ session.parallel_num }}
{% endif %}
{% endfor %}

# Final EOF newline preserved
