{
  "base_url": "https://my-hugo-site.com/",
  "destination": "public",
  "content_dir": "content",
  "layout_dir": "layouts",
  "themes_dir": "themes",
  "themes": [
    "ananke"
  ],
  "build_drafts": true,
  "build_expired": false,
  "build_future": false,
  "minify": true,
  "gc": true,
  "panic_on_warning": false,
  "quiet": false,
  "log_level": "info",
  "environment": "production",
  "enable_git_info": true,
  "clean_destination_dir": true,
  "ignore_cache": false,
  "no_build_lock": false,
  "no_chmod": false,
  "no_times": false,
  "print_i18n_warnings": false,
  "print_path_warnings": true,
  "print_unused_templates": false,
  "cache_dir": ".hugo_cache",
  "config_dir": "config",
  "source": "",
  "disable_kinds": [
    "RSS",
    "robotsTXT"
  ],
  "render_segments": [],
  "ignore_vendor_paths": "",
  "poll": ""
}
