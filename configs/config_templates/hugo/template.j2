# Hugo Configuration File (YAML)
# This template generates a hugo.yaml (or hugo.toml/hugo.json) compatible configuration.
# It maps schema fields to their corresponding Hugo configuration keys.
# Every variable uses the |default() filter to ensure safe rendering even if the variable is undefined.

# ==============================================================================
# Site Configuration
# ==============================================================================

# --baseURL: The hostname and path to the root of the site (--baseURL)
# This is a critical setting for generating absolute links.
baseURL: {{ base_url | default('https://example.org/') }}

# --destination: Filesystem path to write files to (--destination)
# The directory where Hugo will write the static HTML files.
destination: {{ destination | default('public') }}

# --contentDir: Filesystem path to the content directory (--contentDir)
# The directory containing your Markdown content files.
contentDir: {{ content_dir | default('content') }}

# --layoutDir: Filesystem path to the layout directory (--layoutDir)
# The directory containing your HTML templates/layouts.
layoutDir: {{ layout_dir | default('layouts') }}

# --themesDir: Filesystem path to themes directory (--themesDir)
# The directory containing installed themes.
themesDir: {{ themes_dir | default('themes') }}

# --theme: Themes to use (--theme)
# Hugo expects 'theme' to be a string or a list of strings.
# We iterate over the list provided in the schema and format it as a YAML list.
theme:
{% for theme in (themes | default(['ananke'])) %}
  - {{ theme }}
{% endfor %}

# ==============================================================================
# Build & Publishing Options
# ==============================================================================

# --buildDrafts: Include content marked as draft (--buildDrafts)
# Set to true to include content with 'draft: true' in front matter.
buildDrafts: {{ build_drafts | default(false) | lower }}

# --buildExpired: Include expired content (--buildExpired)
# Set to true to include content with a future 'date' that has now passed.
buildExpired: {{ build_expired | default(false) | lower }}

# --buildFuture: Include content with publishdate in the future (--buildFuture)
# Set to true to include content with a future 'publishDate' or 'date'.
buildFuture: {{ build_future | default(false) | lower }}

# --minify: Minify any supported output format (--minify)
# Minifies HTML, XML, JSON, and CSS output.
minify: {{ minify | default(false) | lower }}

# --gc: Enable cleanup tasks after build (--gc)
# Removes unused cache files and other artifacts to save disk space.
gc: {{ gc | default(false) | lower }}

# --panicOnWarning: Panic on first WARNING log (--panicOnWarning)
# Stops the build immediately if a warning is encountered.
panicOnWarning: {{ panic_on_warning | default(false) | lower }}

# --quiet: Build in quiet mode (--quiet)
# Suppresses normal output during the build process.
quiet: {{ quiet | default(false) | lower }}

# --logLevel: Log level (--logLevel)
# Valid values: debug, info, warn, error.
logLevel: {{ log_level | default('info') }}

# --environment: Build environment (--environment)
# Determines which configuration files are loaded (e.g., config.production.yaml).
environment: {{ environment | default('production') }}

# --enableGitInfo: Add Git revision, date, author info (--enableGitInfo)
# Adds Git metadata to pages for version tracking.
enableGitInfo: {{ enable_git_info | default(false) | lower }}

# --cleanDestinationDir: Remove files from destination not found in static directories (--cleanDestinationDir)
# Ensures the destination folder only contains files generated by the current build.
cleanDestinationDir: {{ clean_destination_dir | default(false) | lower }}

# --ignoreCache: Ignores the cache directory (--ignoreCache)
# Forces Hugo to rebuild everything without using cached assets.
ignoreCache: {{ ignore_cache | default(false) | lower }}

# ==============================================================================
# Lock & Permission Options
# ==============================================================================

# --noBuildLock: Don't create .hugo_build.lock file (--noBuildLock)
# Disables the creation of the build lock file, useful for parallel builds.
noBuildLock: {{ no_build_lock | default(false) | lower }}

# --noChmod: Don't sync permission mode of files (--noChmod)
# Skips changing file permissions to match the target directory.
noChmod: {{ no_chmod | default(false) | lower }}

# --noTimes: Don't sync modification time of files (--noTimes)
# Skips setting the modification time of files to match their source.
noTimes: {{ no_times | default(false) | lower }}

# ==============================================================================
# Warning & Debug Options
# ==============================================================================

# --printI18nWarnings: Print missing translations (--printI18nWarnings)
# Outputs warnings for keys that are missing in i18n bundles.
printI18nWarnings: {{ print_i18n_warnings | default(false) | lower }}

# --printPathWarnings: Print warnings on duplicate target paths (--printPathWarnings)
# Warns if multiple source paths map to the same destination file.
printPathWarnings: {{ print_path_warnings | default(false) | lower }}

# --printUnusedTemplates: Print warnings on unused templates (--printUnusedTemplates)
# Warns if layout files are defined but never used during rendering.
printUnusedTemplates: {{ print_unused_templates | default(false) | lower }}

# ==============================================================================
# Directories & Paths
# ==============================================================================

# --cacheDir: Filesystem path to cache directory (--cacheDir)
# Directory used to store Hugo's internal build cache.
cacheDir: {{ cache_dir | default('.hugo_cache') }}

# --configDir: Config directory (--configDir)
# Directory where Hugo looks for configuration files (e.g., config/_default/).
configDir: {{ config_dir | default('config') }}

# --source: Filesystem path to read files relative from (--source)
# Sets the root directory for content, data, layouts, etc.
source: {{ source | default('') }}

# --ignoreVendorPaths: Ignores _vendor for module paths matching glob pattern (--ignoreVendorPaths)
# Allows excluding specific module paths from the vendor directory check.
ignoreVendorPaths: {{ ignore_vendor_paths | default('') }}

# ==============================================================================
# Rendering Options
# ==============================================================================

# --disableKinds: Disable different kind of pages (--disableKinds)
# List of page kinds to disable (home, rss, section, taxonomy, sitemap, robotsTXT).
# Rendered as a YAML list.
{% set dk_list = disable_kinds | default([]) %}
{% if dk_list is iterable and dk_list is not string %}
disableKinds:
{% for kind in dk_list %}
  - {{ kind }}
{% endfor %}
{% else %}
disableKinds: []
{% endif %}

# --renderSegments: Named segments to render (--renderSegments)
# Renders only the content segments defined here.
# Rendered as a YAML list.
{% set rs_list = render_segments | default([]) %}
{% if rs_list is iterable and rs_list is not string %}
renderSegments:
{% for segment in rs_list %}
  - {{ segment }}
{% endfor %}
{% else %}
renderSegments: []
{% endif %}

# --poll: Poll interval for file system changes (--poll)
# Used in watch mode. Specify interval (e.g., '700ms', '1s').
poll: {{ poll | default('') }}