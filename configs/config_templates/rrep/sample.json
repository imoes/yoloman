{
  "extended_regex": false,
  "fixed_strings": false,
  "recursive": true,
  "all_files": false,
  "binary": false,
  "dry_run": false,
  "interactive": false,
  "quiet": false,
  "no_messages": false,
  "word_regexp": false,
  "line_regexp": false,
  "ignore_case": true,
  "backup_suffix": ".bak",
  "backup_control": "simple",
  "keep_times": false,
  "pattern": "old_pattern",
  "replacement": "new_value",
  "include_patterns": [
    "*.html",
    "*.txt"
  ],
  "exclude_patterns": [
    "*.min.css"
  ],
  "exclude_dirs": [
    "node_modules",
    ".git"
  ],
  "target_files": [
    "/var/www/html",
    "/opt/config/settings.json"
  ]
}
