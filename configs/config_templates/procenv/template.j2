#!/usr/bin/env procenv
# Configuration for procenv invocation. Generated by Ansible/Jinja2.
# This file drives the `procenv` utility to dump system/process environment details.

# --output: Destination for output.
# Accepts: stdout, stderr, file, syslog, terminal.
# Default: stdout
# Description: 'Destination for output: stdout, stderr, file, syslog, or terminal.'
{% set output_type = output_type | default('stdout') %}
--output={{ output_type }}

# --format: Output format style.
# Accepts: text, json, xml, crumb.
# Default: text
# Description: 'Output format: text, json, xml, or crumb.'
{% set format_type = format_type | default('text') %}
--format={{ format_type }}

# --separator: Delimiter for text format output.
# Default: ': '
# Description: 'Delimiter string for text format output.'
{% set separator = separator | default(': ') %}
--separator={{ separator }}

# --crumb-separator: Delimiter for crumb format output.
# Default: ':'
# Description: 'Delimiter string for crumb format output.'
{% set crumb_separator = crumb_separator | default(':') %}
--crumb-separator={{ crumb_separator }}

# --indent: Number of indent characters for JSON/XML.
# Default: 2
# Description: 'Number of indent characters to use.'
{% set indent = indent | default(2) %}
--indent={{ indent }}

# --indent-char: Character used for indentation.
# Default: ' ' (space)
# Description: 'Character to use for indenting (e.g., space or tab).'
{% set indent_char = indent_char | default(' ') %}
--indent-char={{ indent_char }}

# --file: Path to output file.
# Only set if output_file is non-empty.
# Default: '' (empty, disables file output)
# Description: 'Path to file for output when --output=file. Empty string disables file output.'
{% set output_file = output_file | default('') %}
{% if output_file %}
--file={{ output_file }}

  # --file-append: If true, append to file instead of overwriting.
  # Default: False
  # Description: 'If true, append to output file rather than overwriting.'
  {% set file_append = file_append | default(False) %}
  {% if file_append %}
  --file-append
  {% endif %}
{% endif %}

# Sections to display.
# Each item maps to a specific short flag (see mapping below).
# If empty, procenv displays all sections.
# Description: "List of detail sections to display. Each item corresponds to a specific procenv flag (e.g., 'meta' enables -a). If empty, all are displayed"
#
# Section Flag Mapping:
#   meta         -> -a
#   arguments    -> -A
#   libs         -> -b
#   libc         -> -B
#   cgroups      -> -c
#   cpu          -> -C
#   compiler     -> -d
#   environment  -> -e
#   semaphores   -> -E
#   fds          -> -f
#   namespaces   -> -F
#   sizeof       -> -g
#   misc         -> -i
#   uname        -> -j
#   clocks       -> -k
#   limits       -> -l
#   locale       -> -L
#   mounts       -> -m
#   message-queues -> -M
#   confstr      -> -n
#   network      -> -N
#   oom          -> -o
#   process      -> -p
#   platform     -> -P
#   time         -> -q
#   ranges       -> -r
#   signals      -> -s
#   shared-memory -> -S
#   tty          -> -t
#   threads      -> -T
#   stat         -> -u
#   rusage       -> -U
#   version      -> -v
#   capabilities -> -w
#   pathconf     -> -x
#   sysconf      -> -y
#   memory       -> -Y
#   timezone     -> -z
#
{% set sections = sections | default(['meta', 'arguments', 'libs', 'libc', 'cgroups', 'cpu', 'compiler', 'environment', 'semaphores', 'fds', 'namespaces', 'sizeof', 'misc', 'uname', 'clocks', 'limits', 'locale', 'mounts', 'message-queues', 'confstr', 'network', 'oom', 'process', 'platform', 'time', 'ranges', 'signals', 'shared-memory', 'tty', 'threads', 'stat', 'rusage', 'version', 'capabilities', 'pathconf', 'sysconf', 'memory', 'timezone']) %}
{% for section in sections %}
  {% if section == 'meta' %}
-a
  {% elif section == 'arguments' %}
-A
  {% elif section == 'libs' %}
-b
  {% elif section == 'libc' %}
-B
  {% elif section == 'cgroups' %}
-c
  {% elif section == 'cpu' %}
-C
  {% elif section == 'compiler' %}
-d
  {% elif section == 'environment' %}
-e
  {% elif section == 'semaphores' %}
-E
  {% elif section == 'fds' %}
-f
  {% elif section == 'namespaces' %}
-F
  {% elif section == 'sizeof' %}
-g
  {% elif section == 'misc' %}
-i
  {% elif section == 'uname' %}
-j
  {% elif section == 'clocks' %}
-k
  {% elif section == 'limits' %}
-l
  {% elif section == 'locale' %}
-L
  {% elif section == 'mounts' %}
-m
  {% elif section == 'message-queues' %}
-M
  {% elif section == 'confstr' %}
-n
  {% elif section == 'network' %}
-N
  {% elif section == 'oom' %}
-o
  {% elif section == 'process' %}
-p
  {% elif section == 'platform' %}
-P
  {% elif section == 'time' %}
-q
  {% elif section == 'ranges' %}
-r
  {% elif section == 'signals' %}
-s
  {% elif section == 'shared-memory' %}
-S
  {% elif section == 'tty' %}
-t
  {% elif section == 'threads' %}
-T
  {% elif section == 'stat' %}
-u
  {% elif section == 'rusage' %}
-U
  {% elif section == 'version' %}
-v
  {% elif section == 'capabilities' %}
-w
  {% elif section == 'pathconf' %}
-x
  {% elif section == 'sysconf' %}
-y
  {% elif section == 'memory' %}
-Y
  {% elif section == 'timezone' %}
-z
  {% endif %}
{% endfor %}

# --exec: Command to execute after running procenv.
# Only set if command_to_exec is non-empty.
# Default: '' (empty, disables exec mode)
# Description: 'Command to execute after running procenv when --exec is used. Empty string disables exec mode.'
{% set command_to_exec = command_to_exec | default('') %}
{% if command_to_exec %}
--exec -- {{ command_to_exec }}
{% endif %}