{
  "bumblebeed_virtual_display": ":8",
  "bumblebeed_keep_unused_x_server": false,
  "bumblebeed_server_group": "bumblebee",
  "bumblebeed_turn_card_off_at_exit": false,
  "bumblebeed_no_eco_mode_override": false,
  "bumblebeed_driver": "",
  "bumblebeed_xorg_conf_dir": "/etc/bumblebee/xorg.conf.d",
  "bumblebeed_xorg_binary": "/usr/lib/xorg/Xorg",
  "optirun_bridge": "auto",
  "optirun_vgl_transport": "proxy",
  "optirun_primus_library_path": "/usr/lib/x86_64-linux-gnu/primus:/usr/lib/i386-linux-gnu/primus",
  "optirun_allow_fallback_to_igc": false,
  "driver_nvidia_kernel_driver": "nvidia",
  "driver_nvidia_pm_method": "auto",
  "driver_nvidia_library_path": "/usr/lib/x86_64-linux-gnu/nvidia:/usr/lib/i386-linux-gnu/nvidia:/usr/lib/x86_64-linux-gnu:/usr/lib/i386-linux-gnu",
  "driver_nvidia_xorg_module_path": "/usr/lib/nvidia,/usr/lib/xorg/modules",
  "driver_nvidia_xorg_conf_file": "/etc/bumblebee/xorg.conf.nvidia",
  "driver_nvidia_always_unload_kernel_driver": false,
  "driver_nouveau_kernel_driver": "nouveau",
  "driver_nouveau_pm_method": "auto",
  "driver_nouveau_xorg_conf_file": "/etc/bumblebee/xorg.conf.nouveau"
}
