{
  "server": {
    "host": "0.0.0.0",
    "port": 5672,
    "max_connections": 500,
    "auth_mode": "scram-sha-256",
    "client_ca_file": "/etc/qmf/ca.crt",
    "tls_cert_file": "/etc/qmf/server.crt",
    "tls_key_file": "/etc/qmf/server.key",
    "force_tls": true
  },
  "workers": {
    "thread_count": 6,
    "max_queue_depth": 5000,
    "process_timeout_ms": 20000
  },
  "storage": {
    "backend": "file",
    "file_path": "/var/lib/qmf/qmf_data",
    "max_messages_per_queue": 200000,
    "durable": true
  },
  "logging": {
    "level": "info",
    "path": "-",
    "json_output": true
  },
  "queues": {
    "default_ttl_seconds": 3600,
    "default_max_size_bytes": 52428800,
    "per_queues": [
      {
        "name": "critical",
        "ttl_seconds": 600,
        "max_size_bytes": 10485760
      },
      {
        "name": "audit",
        "ttl_seconds": 7776000,
        "max_size_bytes": 1048576000
      }
    ]
  },
  "health": {
    "http_port": 8081,
    "liveness_check_interval_seconds": 15
  }
}
