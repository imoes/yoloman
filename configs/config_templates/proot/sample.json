{
  "initial_cwd": "/home/user/myapp",
  "verbose_level": 2,
  "fake_root": true,
  "kernel_release": "5.10.0-generic",
  "change_id": "1000:1000",
  "qemu_command": "qemu-arm -g 1234",
  "mounts": [
    "/tmp/alternate_opt:/opt",
    "/etc/hosts:/etc/hosts",
    "/bin/bash:/bin/sh!"
  ],
  "rootfs_path": "/mnt/slackware-8.0",
  "use_recommended_binds": false,
  "use_safe_install_binds": false,
  "command": "/bin/bash -l"
}
