# Listen on this address and port
bind {{ listen_address }} {{ listen_port }}

# Username under which the node runs
user {{ munin_user }}

# Log level: 0=quiet, 1=errors, 2=warnings, 3=info, 4=debug
log_level {{ log_level }}

# PID file location
pid_file {{ pid_file }}

# Maximum number of simultaneous connections
max_connections {{ max_connections }}

# Enable TLS (true/false)
{% if use_tls %}tls true
tls_cert_file {{ tls_cert_file }}
tls_key_file {{ tls_key_file }}
{% else %}tls false
{% endif %}

# List of allowed client hosts (CIDR or hostname)
{% for host in allowed_hosts %}allow ^{{ host | replace('.', '\.') | replace('*', '.*') }}$
{% endfor %}

# Optional: list of plugins to exclude from auto-discovery
{% for plugin in excluded_plugins %}exclude {{ plugin }}
{% endfor %}

# Optional: plugin-specific config (e.g., timeouts)
{% for plugin, config in plugin_configs.items() %}[{{ plugin }}]
{% for key, value in config.items() %}  {{ key }} {{ value }}
{% endfor %}{% endfor %}

# Optional: host-specific config (for multi-host setups)
{% for host_config in host_configs %}[{{ host_config.host_name }}]
  address {{ host_config.address }}
  use_tls {{ 'true' if host_config.use_tls else 'false' }}
  port {{ host_config.port }}
{% endfor %}

# Final directive: which plugins to run (auto if omitted)
# plugin_dir specifies where to look for plugins
plugin_dir {{ plugin_dir }}

# Timeout for plugin execution (seconds)
plugin_timeout {{ plugin_timeout }}

# Whether to include load plugin in defaults
plugin_load_include {{ 'true' if plugin_load_include else 'false' }}
