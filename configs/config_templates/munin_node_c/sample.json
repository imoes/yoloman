{
 "allowed_hosts": [
  "^10\\.10\\.",
  "munin\\.internal"
 ],
 "excluded_plugins": [
  "smart",
  "nginx_request"
 ],
 "host_configs": [
  {
   "address": "10.0.1.10",
   "host_name": "web1.example.com",
   "port": 4949,
   "use_tls": false
  }
 ],
 "listen_address": "127.0.0.1",
 "listen_port": 4949,
 "log_level": 2,
 "max_connections": 5,
 "munin_user": "munin",
 "pid_file": "/run/munin/munin-node.pid",
 "plugin_configs": {
  "df": {
   "timeout": "15"
  },
  "nginx_request": {
   "env.include_status": "200,301,302"
  }
 },
 "plugin_dir": "/usr/share/munin/plugins",
 "plugin_load_include": false,
 "plugin_timeout": 8,
 "tls_cert_file": "/etc/munin/tls/cert.pem",
 "tls_key_file": "/etc/munin/tls/key.pem",
 "use_tls": true
}
