{
  "listen_address": "127.0.0.1",
  "listen_port": 4949,
  "munin_user": "munin",
  "log_level": 2,
  "pid_file": "/run/munin/munin-node.pid",
  "max_connections": 5,
  "use_tls": true,
  "tls_cert_file": "/etc/munin/tls/cert.pem",
  "tls_key_file": "/etc/munin/tls/key.pem",
  "allowed_hosts": [
    "^10\\.10\\.",
    "munin\\.internal"
  ],
  "excluded_plugins": [
    "smart",
    "nginx_request"
  ],
  "plugin_configs": {
    "df": {
      "timeout": "15"
    },
    "nginx_request": {
      "env.include_status": "200,301,302"
    }
  },
  "host_configs": [
    {
      "host_name": "web1.example.com",
      "address": "10.0.1.10",
      "use_tls": false,
      "port": 4949
    }
  ],
  "plugin_dir": "/usr/share/munin/plugins",
  "plugin_timeout": 8,
  "plugin_load_include": false
}
