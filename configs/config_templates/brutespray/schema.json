{
  "input_file": {
    "type": "string",
    "default": "",
    "description": "Path to nmap GNMAP/JSON/XML input file (required)"
  },
  "output_dir": {
    "type": "string",
    "default": "",
    "description": "Directory to write successful credentials (optional)"
  },
  "services": {
    "type": "list",
    "default": [],
    "description": "List of services to target (e.g., ['ftp','ssh','telnet'])"
  },
  "threads": {
    "type": "number",
    "default": 5,
    "description": "Number of concurrent Medusa threads"
  },
  "max_hosts": {
    "type": "number",
    "default": 5,
    "description": "Maximum number of hosts to test concurrently"
  },
  "userlist": {
    "type": "string",
    "default": "",
    "description": "Path to custom username wordlist file"
  },
  "passlist": {
    "type": "string",
    "default": "",
    "description": "Path to custom password wordlist file"
  },
  "username": {
    "type": "string",
    "default": "",
    "description": "Single username to use (overrides wordlists)"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Single password to use (overrides wordlists)"
  },
  "continuous": {
    "type": "bool",
    "default": false,
    "description": "Continue brute-forcing after first success"
  },
  "interactive": {
    "type": "bool",
    "default": false,
    "description": "Enable interactive mode for user prompts"
  },
  "verbose_level": {
    "type": "number",
    "default": 5,
    "description": "Medusa verbosity (0\u20136); default 5"
  },
  "debug_level": {
    "type": "number",
    "default": 5,
    "description": "Medusa debug level (0\u201310); default 5"
  },
  "combos": {
    "type": "list",
    "default": [],
    "description": "List of predefined host:username:password combos (optional, passed via -C flag). Each combo is a flat map of fields."
  },
  "combos.items": {
    "type": "object",
    "default": null,
    "description": "Single combo entry"
  },
  "combos.items.host": {
    "type": "string",
    "default": "",
    "description": "Target host address"
  },
  "combos.items.username": {
    "type": "string",
    "default": "",
    "description": "Username for combo"
  },
  "combos.items.password": {
    "type": "string",
    "default": "",
    "description": "Password for combo"
  }
}
