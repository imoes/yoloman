# ============================================================================
# brutespray configuration file
# This template generates a configuration file for Brutespray, a tool that
# automates brute-force credential testing against services discovered by Nmap.
# It wraps the Medusa brute-forcer and supports various input formats (GNMAP,
# JSON, XML) and output strategies.
# ============================================================================

[brutespray]

# Path to nmap GNMAP/JSON/XML input file (required)
# If left empty, the tool may rely on command-line arguments or other discovery
# mechanisms, but typically this file is the primary input.
input_file = {{ input_file | default('') }}

# Directory to write successful credentials (optional)
# Successful login attempts and their credentials are saved here.
# If empty, output might be directed to stdout or a default log location.
output_dir = {{ output_dir | default('') }}

# List of services to target (e.g., ['ftp','ssh','telnet'])
# Only these specific services will be brute-forced. If empty, all discovered
# services with known brute-force scripts might be targeted.
services = {{ services | default([]) | join(',') }}

# Number of concurrent Medusa threads
# Controls parallelism for the brute-force engine. Higher values increase speed
# but also load and noise. Default is 5.
threads = {{ threads | default(5) }}

# Maximum number of hosts to test concurrently
# Limits the scope of parallel execution to prevent overwhelming the target
# or the local system. Default is 5.
max_hosts = {{ max_hosts | default(5) }}

# Path to custom username wordlist file
# Provides a file containing usernames to attempt. Mutually exclusive with
# `username` in terms of strategy (wordlist vs single), though both can be set.
userlist = {{ userlist | default('') }}

# Path to custom password wordlist file
# Provides a file containing passwords to attempt. Mutually exclusive with
# `password` in terms of strategy.
passlist = {{ passlist | default('') }}

# Single username to use (overrides wordlists)
# If provided, this single username is used for all targets, ignoring userlist.
username = {{ username | default('') }}

# Single password to use (overrides wordlists)
# If provided, this single password is used for all targets, ignoring passlist.
password = {{ password | default('') }}

# Continue brute-forcing after first success
# If true, the tool will continue testing other credentials even after finding
# a valid pair for a service. Default is False.
continuous = {{ continuous | default(false) | lower }}

# Enable interactive mode for user prompts
# If true, the tool will pause for user input, useful for debugging or manual
# control. Default is False.
interactive = {{ interactive | default(false) | lower }}

# Medusa verbosity (0–6); default 5
# Controls the amount of output generated by Medusa. Higher is noisier.
verbose_level = {{ verbose_level | default(5) }}

# Medusa debug level (0–10); default 5
# Internal debug information. Higher values produce more detailed logs.
debug_level = {{ debug_level | default(5) }}

# Predefined host:username:password combos
# These are passed to Medusa via the -C flag. Each combo is a flat map with
# host, username, and password keys. They override wordlists for those specific
# combinations.
{% for combo in combos | default([]) %}{{ (combo.host | default('')) }}:{{ (combo.username | default('')) }}:{{ (combo.password | default('')) }}
{% endfor %}