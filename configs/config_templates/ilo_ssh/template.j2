# Fence agent for HP iLO using SSH (fence_ilo_ssh)
# Configuration is a simple key=value file

# IP address or hostname of the iLO interface
ilo_ip={{ ilo_ip }}

# iLO username
login={{ login }}

# iLO password (WARNING: stored in plaintext)
password={{ password }}

# SSH port (default 22)
port={{ port }}

# SSH identity file (optional, leave blank to use default)
identity_file={{ identity_file | default('') }}

# SSH options (e.g., '-o StrictHostKeyChecking=no')
ssh_options={{ ssh_options | default('') }}

# Command timeout in seconds (default 60)
timeout={{ timeout }}

# Wait time after power-on command before checking status (seconds, default 10)
wait={{ wait }}

# Use SSL/TLS for SSH (true/false, default true)
ssl={{ ssl }}

# Use IPMI over LAN (deprecated, ignored by fence_ilo_ssh — kept for compatibility)
# Set to 'no' to avoid confusion
ipmi_lan=no

# Action to perform on fence (e.g., 'reboot', 'on', 'off', 'status') — not configurable at runtime
# Set via CLI when invoking fence_ilo_ssh
