{
  "autostart": true,
  "debug_level": 2,
  "kernel_module": "/lib/modules/$(uname -r)/kernel/fs/dlm/dlm.ko",
  "lockspace_dir": "/var/lib/dlm",
  "start_timeout": 30,
  "threads": 8,
  "voting": true,
  "quorum_threshold": 0,
  "log_file": "",
  "log_subsys": "syslog",
  "log_priority": "info",
  "cluster_nodes": [
    {
      "name": "node1",
      "addr": "10.1.1.1"
    },
    {
      "name": "node2",
      "addr": "10.1.1.2"
    },
    {
      "name": "node3",
      "addr": "10.1.1.3"
    }
  ],
  "lockspace_config": [
    {
      "name": "gfs2",
      "recovery_slot_timeout": 5,
      "recovery_retries": 10,
      "recovery_timeout": 60,
      "client_timeout": 30
    }
  ],
  "fencing": {
    "enabled": true,
    "method": "fence_scsi",
    "fence_timeout": 120
  },
  "network": {
    "max_retries": 5,
    "retry_delay": 3,
    "connect_timeout": 45
  }
}
