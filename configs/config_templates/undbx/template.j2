# ============================================================================
# Configuration for undbx (Outlook Express .dbx extractor)
#
# This configuration file drives the undbx utility to extract emails from
# Outlook Express .dbx database files or directories. It specifies the source
# location, the output destination, and whether to attempt recovery from
# corrupted data.
# ============================================================================

# -------------------------------------------------------------------------
# Source Input
# -------------------------------------------------------------------------
# Path to the source .dbx file or directory containing Outlook Express
# database files. undbx will read emails from this location.
# Type: string
# Default: /var/lib/undbx/inbox.dbx
DBX_SOURCE: {{ dbx_source | default('/var/lib/undbx/inbox.dbx') }}

# -------------------------------------------------------------------------
# Output Destination
# -------------------------------------------------------------------------
# Path to the directory where extracted .eml files will be stored.
# If left empty, undbx defaults to creating a subdirectory in the current
# working directory.
# Type: string
# Default: /var/lib/undbx/output
OUTPUT_DIR: {{ output_dir | default('/var/lib/undbx/output') }}

# -------------------------------------------------------------------------
# Recovery Mode
# -------------------------------------------------------------------------
# If true, enables --recover mode to extract emails from corrupted files.
# When enabled, undbx attempts to salvage data from damaged .dbx archives,
# extracting all possible messages and fragments.
# Type: boolean
# Default: false
RECOVER_MODE: {{ recover_mode | default(false) }}