{
  "machine_type": "malta",
  "accel": "tcg",
  "smp_cpus": 2,
  "ram_size": 256,
  "blockdev_0_driver": "qcow2",
  "blockdev_0_node_name": "hd0",
  "blockdev_0_filename": "/var/lib/qemu/mips_images/malta_rootfs.qcow2",
  "nics": [
    {
      "netdev_type": "user",
      "id": "net0",
      "ipv4": "on"
    },
    {
      "netdev_type": "tap",
      "id": "net1",
      "fd": "3"
    }
  ],
  "kernel_args": "console=tty0 console=ttyS0 earlyprintk root=/dev/sda1",
  "kernel_path": "/home/user/images/linux-mips-kernel",
  "initrd_path": "/home/user/images/initramfs.cpio.gz",
  "dtb_path": "/home/user/images/malta.dtb"
}
