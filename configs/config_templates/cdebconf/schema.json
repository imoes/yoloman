{
  "cdebconf_module_path_frontend": {
    "type": "string",
    "default": "/usr/lib/cdebconf/frontend",
    "description": "Path to frontend modules directory"
  },
  "cdebconf_module_path_database": {
    "type": "string",
    "default": "/usr/lib/cdebconf/db",
    "description": "Path to database modules directory"
  },
  "cdebconf_frontend_instance": {
    "type": "string",
    "default": "default_fe",
    "description": "Frontend instance name"
  },
  "cdebconf_frontend_driver": {
    "type": "string",
    "default": "text",
    "description": "Frontend driver type",
    "enum": [
      "text",
      "db"
    ]
  },
  "cdebconf_template_instance_templatedb": {
    "type": "string",
    "default": "templatedb",
    "description": "Main template database instance name"
  },
  "cdebconf_template_instance_target_templatedb": {
    "type": "string",
    "default": "target_templatedb",
    "description": "Target template database instance name"
  },
  "cdebconf_template_instance_di_templatedb": {
    "type": "string",
    "default": "di_templatedb",
    "description": "Installer template database instance name"
  },
  "cdebconf_template_instance_old_templatedb": {
    "type": "string",
    "default": "old_templatedb",
    "description": "Old template database instance name"
  },
  "cdebconf_template_driver": {
    "type": "string",
    "default": "rfc822db",
    "description": "Template database driver type",
    "enum": [
      "rfc822db",
      "db"
    ]
  },
  "cdebconf_template_path_templatedb": {
    "type": "string",
    "default": "/var/lib/cdebconf/templates.dat",
    "description": "Path to main templates database file"
  },
  "cdebconf_template_path_target_templatedb": {
    "type": "string",
    "default": "/target/var/cache/debconf/templates.dat",
    "description": "Path to target templates database file"
  },
  "cdebconf_template_path_di_templatedb": {
    "type": "string",
    "default": "/var/log/installer/cdebconf/templates.dat",
    "description": "Path to installer templates database file"
  },
  "cdebconf_template_path_old_templatedb": {
    "type": "string",
    "default": "/var/cache/debconf/templates.dat",
    "description": "Path to old templates database file"
  },
  "cdebconf_config_instance_config_gen_db": {
    "type": "string",
    "default": "config_gen_db",
    "description": "General config database instance name"
  },
  "cdebconf_config_instance_config_passwd_db": {
    "type": "string",
    "default": "config_passwd_db",
    "description": "Password config database instance name"
  },
  "cdebconf_config_instance_configdb": {
    "type": "string",
    "default": "configdb",
    "description": "Main config database instance name"
  },
  "cdebconf_config_instance_target_config_gen_db": {
    "type": "string",
    "default": "target_config_gen_db",
    "description": "Target general config database instance name"
  },
  "cdebconf_config_instance_target_config_passwd_db": {
    "type": "string",
    "default": "target_config_passwd_db",
    "description": "Target password config database instance name"
  },
  "cdebconf_config_instance_target_configdb": {
    "type": "string",
    "default": "target_configdb",
    "description": "Target config database instance name"
  },
  "cdebconf_config_instance_old_config_gen_db": {
    "type": "string",
    "default": "old_config_gen_db",
    "description": "Old general config database instance name"
  },
  "cdebconf_config_instance_old_config_passwd_db": {
    "type": "string",
    "default": "old_config_passwd_db",
    "description": "Old password config database instance name"
  }
}
