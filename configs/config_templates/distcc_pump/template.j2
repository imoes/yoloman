# =============================================================================
# distcc_pump configuration template
# =============================================================================
# This file configures distcc's "pump" mode, which enables pre-processing and
# caching of compilation units for faster distributed builds.
# =============================================================================

# Enable pump mode for distributed compilation.
# If disabled, distcc falls back to standard (non-pump) distributed compilation.
# Valid values: true, false
# Default: true
{% if (pump_enabled | default(true)) | bool %}
PUMP_ENABLE=true
{% else %}
PUMP_ENABLE=false
{% endif %}

# Base directory for pump mode state and cache files.
# This directory must be writable by the distccd user.
# Default: /var/cache/distcc/pump
PUMP_DIR={{ pump_dir | default('/var/cache/distcc/pump') }}

# Maximum number of concurrent pump mode sessions.
# Higher values allow more parallel jobs but increase resource usage.
# Valid values: integer >= 0
# Default: 4
PUMP_MAX_SESSIONS={{ pump_max_sessions | default(4) }}

# Host(s) to use for pump mode; if empty, local-only pump session.
# Each host should be in 'hostname' or 'hostname:port' format.
# Comma-separated list.
# Default: empty list (local only)
{% if (pump_hosts | default([])) | length > 0 %}
PUMP_HOSTS={{ pump_hosts | default([]) | join(',') }}
{% else %}
PUMP_HOSTS=
{% endif %}

# Timeout (in seconds) for pump session startup.
# Maximum time to wait for a pump session to start before timing out.
# Valid values: integer >= 0
# Default: 30
PUMP_STARTUP_TIMEOUT={{ pump_startup_timeout | default(30) }}

# Enable verbose logging for pump mode internals.
# Helpful for debugging.
# Valid values: true, false
# Default: false
{% if (pump_verbose | default(false)) | bool %}
PUMP_VERBOSE=true
{% else %}
PUMP_VERBOSE=false
{% endif %}

# Path to the pump mode log file.
# If empty, logs go to syslog instead.
# Default: empty (syslog)
{% if (pump_log | default('')) | length > 0 %}
PUMP_LOG={{ pump_log | default('') }}
{% else %}
PUMP_LOG=
{% endif %}

# Enable compression of data over pump sessions.
# Reduces network usage at the cost of CPU.
# Valid values: true, false
# Default: true
{% if (pump_compress | default(true)) | bool %}
PUMP_COMPRESS=true
{% else %}
PUMP_COMPRESS=false
{% endif %}