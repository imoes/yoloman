{
  "pump_enabled": true,
  "pump_dir": "/var/cache/distcc/pump",
  "pump_max_sessions": 8,
  "pump_hosts": [
    "build-node1.local",
    "build-node2.local:3632"
  ],
  "pump_bin": "/usr/bin/distccd",
  "pump_args": [
    "--allow 10.0.0.0/8",
    "--log-file=/var/log/distccd.log"
  ],
  "pump_startup_timeout": 45,
  "pump_verbose": true,
  "pump_log": "/var/log/distcc-pump.log",
  "pump_compress": true
}
