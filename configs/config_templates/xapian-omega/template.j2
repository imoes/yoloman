# Directory containing Xapian databases
# Schema field: database_dir
# Default: /var/lib/xapian-omega/data
database_dir {{ database_dir | default('/var/lib/xapian-omega/data') }}

# Directory containing OmegaScript templates
# Schema field: template_dir
# Default: /var/lib/xapian-omega/templates
template_dir {{ template_dir | default('/var/lib/xapian-omega/templates') }}

# Directory to write Omega logs to
# Schema field: log_dir
# Default: /var/log/xapian-omega
log_dir {{ log_dir | default('/var/log/xapian-omega') }}

# Directory containing any cdb files for the $lookup OmegaScript command
# Schema field: cdb_dir
# Default: /var/lib/xapian-omega/cdb
cdb_dir {{ cdb_dir | default('/var/lib/xapian-omega/cdb') }}
