{
  "database_dir": {
    "type": "string",
    "default": "/var/lib/xapian-omega/data",
    "description": "Directory containing Xapian databases"
  },
  "template_dir": {
    "type": "string",
    "default": "/var/lib/xapian-omega/templates",
    "description": "Directory containing OmegaScript templates"
  },
  "log_dir": {
    "type": "string",
    "default": "/var/log/xapian-omega",
    "description": "Directory to write Omega logs to"
  },
  "cdb_dir": {
    "type": "string",
    "default": "/var/lib/xapian-omega/cdb",
    "description": "Directory containing any cdb files for the $lookup OmegaScript command"
  }
}
