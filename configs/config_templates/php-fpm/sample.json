{
  "pool_name": "www",
  "user": "www-data",
  "group": "www-data",
  "listen": "/run/php/php8.4-fpm.sock",
  "listen_owner": "www-data",
  "listen_group": "www-data",
  "listen_mode": "",
  "listen_acl_users": "",
  "listen_allowed_clients": "",
  "pm": "dynamic",
  "pm_max_children": 5,
  "pm_start_servers": 2,
  "pm_min_spare_servers": 1,
  "pm_max_spare_servers": 3,
  "pm_max_requests": 500,
  "pm_status_path": "/status",
  "slowlog": "",
  "request_slowlog_timeout": "5s",
  "php_admin_values": {},
  "php_admin_flags": {},
  "php_values": {
    "memory_limit": "256M"
  },
  "php_flags": {
    "display_errors": "off"
  }
}
