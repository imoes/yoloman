{
 "e": {
  "g": ""
 },
 "error": {
  "log": ""
 },
 "fpm": {
  "conf": ""
 },
 "global": {
  "error_log": "/var/log/php8.2-fpm.log",
  "log_level": "notice"
 },
 "install": {
  "fpm": {
   "configuration": {
    "php": ""
   }
  }
 },
 "item": {
  "key": ""
 },
 "listen": {
  "allowed_clients": ""
 },
 "pm": {
  "error": "",
  "group": "",
  "log": "",
  "max": "",
  "process": "",
  "request_slowlog_timeout": "",
  "slowlog": "",
  "status_path": "",
  "user": ""
 },
 "pool": {
  "group": "www-data",
  "listen": "/run/php/php8.2-fpm.sock",
  "listen_allowed_clients": [
   "127.0.0.1",
   "::1"
  ],
  "listen_backlog": 1024,
  "listen_group": "www-data",
  "listen_mode": "0660",
  "listen_owner": "www-data",
  "max_requests": 1000,
  "max_spare_servers": 6,
  "min_spare_servers": 2,
  "php_admin_flag": {
   "display_startup_errors": false,
   "log_errors": true
  },
  "php_admin_value": {
   "error_log": "/var/log/php8.2-fpm-error.log"
  },
  "php_flags": {
   "display_errors": false,
   "zlib.output_compression": true
  },
  "php_values": {
   "max_execution_time": "120",
   "memory_limit": "256M",
   "post_max_size": "16M",
   "upload_max_filesize": "16M"
  },
  "process_manager": "dynamic",
  "request_slowlog_timeout": 10,
  "slowlog": "/var/log/php-fpm/www-slow.log",
  "start_servers": 4,
  "status_path": "/status",
  "user": "www-data"
 },
 "slow": {
  "log": ""
 },
 "www": {
  "php": {
   "net": ""
  }
 }
}
