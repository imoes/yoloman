{
  "dhcp6r_bin": {
    "type": "string",
    "default": "/usr/sbin/dhcp6relay",
    "description": "Path to the dhcp6relay binary."
  },
  "dhcp6r_pid_file": {
    "type": "string",
    "default": "/var/run/dhcp6relay.pid",
    "description": "Path to the PID file for the dhcp6relay process."
  },
  "name": {
    "type": "string",
    "default": "dhcp6relay",
    "description": "The name of the service."
  },
  "description": {
    "type": "string",
    "default": "WIDE DHCPv6 relay",
    "description": "The description of the service."
  },
  "stop_retry_schedule": {
    "type": "string",
    "default": "TERM/20/forever/KILL/1",
    "description": "Stop retry schedule for start-stop-daemon.",
    "enum": [
      "TERM/20/forever/KILL/1",
      "KILL"
    ]
  }
}
