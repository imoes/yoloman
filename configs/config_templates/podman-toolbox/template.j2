[general]
# Operating system distro for the toolbox container.
# Defaults to 'fedora' if not specified.
distro = "{{ distro | default('fedora') }}"

# Operating system release for the toolbox container.
# Defaults to '33' if not specified.
release = "{{ release | default('33') }}"

# Image name used to create the toolbox container.
# This is useful for creating containers from custom-built images.
# If the name does not contain a registry, the local image storage will be
# consulted, and if it's not present there then it will be pulled from a
# suitable remote registry.
# Defaults to 'registry.fedoraproject.org/fedora-toolbox:34' if not specified.
image = "{{ image | default('registry.fedoraproject.org/fedora-toolbox:34') }}"