{
  "device_name": {
    "type": "string",
    "default": "Wireless Mouse MX Master",
    "description": "Name of the mouse device."
  },
  "smartshift_on": {
    "type": "bool",
    "default": true,
    "description": "Enable SmartShift functionality."
  },
  "smartshift_threshold": {
    "type": "number",
    "default": 30,
    "description": "SmartShift threshold value."
  },
  "smartshift_torque": {
    "type": "number",
    "default": 50,
    "description": "SmartShift torque value."
  },
  "hiresscroll_hires": {
    "type": "bool",
    "default": true,
    "description": "Enable high-resolution scrolling."
  },
  "hiresscroll_invert": {
    "type": "bool",
    "default": false,
    "description": "Invert scrolling direction."
  },
  "hiresscroll_target": {
    "type": "bool",
    "default": false,
    "description": "Target specific window for scrolling."
  },
  "dpi": {
    "type": "number",
    "default": 1000,
    "description": "Default DPI setting."
  },
  "cycle_dpis": {
    "type": "list",
    "default": [
      400,
      600,
      800,
      1000,
      1200,
      1400,
      1600
    ],
    "description": "List of DPIs to cycle through."
  },
  "button_c4_key": {
    "type": "string",
    "default": "KEY_A",
    "description": "Key mapped to button with CID 0xc4."
  }
}
