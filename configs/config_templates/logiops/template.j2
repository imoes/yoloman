# ==============================================================================
# Logiops Configuration Template
# ==============================================================================
# This template configures the Logitech Options daemon (logiops) for a
# specific HID device (e.g., a mouse). It manages button mappings, DPI cycling,
# and specialized features like SmartShift and HiRes Scroll.
#
# Schema Fields:
# - device_name: The name of the mouse device.
# - smartshift_on: Enable SmartShift functionality.
# - smartshift_threshold: SmartShift threshold value.
# - smartshift_torque: SmartShift torque value.
# - hiresscroll_hires: Enable high-resolution scrolling.
# - hiresscroll_invert: Invert scrolling direction.
# - hiresscroll_target: Target specific window for scrolling.
# - dpi: Default DPI setting.
# - cycle_dpis: List of DPIs to cycle through.
# - button_c4_key: Key mapped to button with CID 0xc4.
# ==============================================================================

devices: (
{
    # Name of the mouse device as detected by the system.
    name: "{{ device_name | default('Wireless Mouse MX Master') }}";

    # SmartShift configuration (Magnetic gear shifting on MX Master/MX Master 2S/3).
    smartshift:
    {
        # Enable SmartShift functionality.
        on: {{ smartshift_on | default(true) }};

        # SmartShift threshold value (percentage of effort to engage gear).
        threshold: {{ smartshift_threshold | default(30) }};

        # SmartShift torque value (force required to shift gears).
        torque: {{ smartshift_torque | default(50) }};
    };

    # HiRes Scroll configuration.
    hiresscroll:
    {
        # Enable high-resolution scrolling mode.
        hires: {{ hiresscroll_hires | default(true) }};

        # Invert scrolling direction (natural scrolling).
        invert: {{ hiresscroll_invert | default(false) }};

        # Target specific window for scrolling (focus follows scroll).
        target: {{ hiresscroll_target | default(false) }};
    };

    # Default DPI setting for the device.
    dpi: {{ dpi | default(1000) }};

    # Button configurations.
    buttons: (
        {
            cid: 0xc3;
            action =
            {
                type: "Gestures";
                gestures: (
                    {
                        direction: "Up";
                        mode: "OnRelease";
                        action =
                        {
                            type: "Keypress";
                            keys: ["KEY_UP"];
                        };
                    },
                    {
                        direction: "Down";
                        mode: "OnRelease";
                        action =
                        {
                            type: "Keypress";
                            keys: ["KEY_DOWN"];
                        };
                    },
                    {
                        direction: "Left";
                        mode: "OnRelease";
                        action =
                        {
                            type: "CycleDPI";
                            # List of DPI values to cycle through when swiping left.
                            dpis: {{ cycle_dpis | default([400, 600, 800, 1000, 1200, 1400, 1600]) }};
                        };
                    },
                    {
                        direction: "Right";
                        mode: "OnRelease";
                        action =
                        {
                            type = "ToggleSmartshift";
                        }
                    },
                    {
                        direction: "None"
                        mode: "NoPress"
                    }
                );
            };
        },
        {
            cid: 0xc4;
            action =
            {
                type: "Keypress";
                # Key mapped to button with CID 0xc4 (typically G4 or similar).
                keys: ["{{ button_c4_key | default('KEY_A') }}"];
            };
        }
    );
}
);
