# Path to the BCB partition device (misc partition)
# The path of the misc partition device (BCB partition).
BCB_PARTITION = "{{ bcb_partition | default('/dev/block/mmcblk0p30') }}"

# Command to execute: read, write, clear, or dump
# The command to execute: read, write, clear, or dump.
COMMAND = "{{ command | default('dump') }}"

# Field to operate on (command, status, recovery, or stage)
# The field to operate on (command, status, recovery, or stage).
# Required if COMMAND is 'write'
FIELD = "{{ field | default('command') }}"

# Data value to write to the specified field
# The data to write to the BCB's field. Empty if not writing.
# Required if COMMAND is 'write'
DATA = "{{ data | default('') }}"