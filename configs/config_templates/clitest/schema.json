{
  "first": {
    "type": "bool",
    "default": false,
    "description": "Stop execution upon first failed test"
  },
  "list": {
    "type": "bool",
    "default": false,
    "description": "List all tests (no execution)"
  },
  "list_run": {
    "type": "bool",
    "default": false,
    "description": "List all tests with OK/FAIL status"
  },
  "test_range": {
    "type": "string",
    "default": "",
    "description": "Run specific tests, by number (e.g., '1,2,4-7')"
  },
  "skip_range": {
    "type": "string",
    "default": "",
    "description": "Skip specific tests, by number (e.g., '1,2,4-7')"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Quiet operation, no output shown"
  },
  "progress_type": {
    "type": "string",
    "default": "none",
    "description": "Progress indicator: test, number, dot, none",
    "enum": [
      "test",
      "number",
      "dot",
      "none"
    ]
  },
  "pre_flight": {
    "type": "string",
    "default": "",
    "description": "Execute command before running the first test"
  },
  "post_flight": {
    "type": "string",
    "default": "",
    "description": "Execute command after running the last test"
  },
  "color_when": {
    "type": "string",
    "default": "auto",
    "description": "When to use colors: auto, always, never",
    "enum": [
      "auto",
      "always",
      "never"
    ]
  },
  "diff_options": {
    "type": "string",
    "default": "-u",
    "description": "Diff command options (default: '-u')"
  },
  "inline_prefix": {
    "type": "string",
    "default": "#\u2192 ",
    "description": "Inline output prefix (default: '#\u2192 ')"
  },
  "prefix": {
    "type": "string",
    "default": "",
    "description": "Command line prefix (default: '')"
  },
  "prompt": {
    "type": "string",
    "default": "$ ",
    "description": "Prompt string (default: '$ ')"
  }
}
