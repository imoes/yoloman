{
  "wmf_dir": {
    "type": "string",
    "default": "./",
    "description": "Directory where generated HTML files are written to."
  },
  "wmf_mbox": {
    "type": "string",
    "default": "-",
    "description": "Path to the mailbox file. Use '-' for stdin."
  },
  "wmf_name": {
    "type": "string",
    "default": "Mailing List",
    "description": "Name of the mail folder/list displayed in the index."
  },
  "wmf_extension": {
    "type": "string",
    "default": ".html",
    "description": "File extension for generated pages."
  },
  "wmf_days": {
    "type": "number",
    "default": 0,
    "description": "Day limit. Mails older than this many days won't be listed. 0 means no limit."
  },
  "wmf_lines": {
    "type": "number",
    "default": 0,
    "description": "Lines per page index. 0 means only one page."
  },
  "wmf_wmode": {
    "type": "number",
    "default": 0,
    "description": "Write mode: 0=indexing, 1=overwrite, 2=append."
  },
  "wmf_rsort": {
    "type": "bool",
    "default": false,
    "description": "Enable reverse sorting of mails."
  },
  "wmf_debug": {
    "type": "number",
    "default": 0,
    "description": "Debug level (bitmask: 1=Functions, 2=Information, 4=Fileoperations)."
  },
  "wmf_mcmd": {
    "type": "string",
    "default": "MAILTO:",
    "description": "Command to send mail (e.g., MAILTO:user@example.com)."
  }
}
