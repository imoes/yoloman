{
  "input_font": {
    "type": "string",
    "default": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "description": "Path to the input TrueType font file."
  },
  "base_name": {
    "type": "string",
    "default": "",
    "description": "Base name for output files. If empty, derived from input filename."
  },
  "include_all_glyphs": {
    "type": "bool",
    "default": false,
    "description": "Include all glyphs from source (-a)."
  },
  "output_pfb": {
    "type": "bool",
    "default": false,
    "description": "Output PFB file instead of PFA (-b)."
  },
  "language": {
    "type": "string",
    "default": "",
    "description": "Language for extraction (-l)."
  },
  "encoding_map": {
    "type": "string",
    "default": "",
    "description": "Map file for encoding (-L)."
  },
  "max_hint_stack_depth": {
    "type": "number",
    "default": 128,
    "description": "Max hint stack depth (-m h=...)."
  },
  "disable_forcebold_guess": {
    "type": "bool",
    "default": false,
    "description": "Disable ForceBold guessing (-Ob)."
  },
  "disable_hints": {
    "type": "bool",
    "default": false,
    "description": "Disable hint autogeneration (-Oh)."
  },
  "disable_hint_substitution": {
    "type": "bool",
    "default": false,
    "description": "Disable hint substitution (-Ou)."
  },
  "disable_space_optimization": {
    "type": "bool",
    "default": false,
    "description": "Disable space optimization (-Oo)."
  },
  "disable_smoothing": {
    "type": "bool",
    "default": false,
    "description": "Disable smoothing (-Os)."
  },
  "disable_auto_scaling": {
    "type": "bool",
    "default": false,
    "description": "Disable auto-scaling (-Ot)."
  },
  "enable_vectorization": {
    "type": "bool",
    "default": false,
    "description": "Enable bitmap vectorization (-OV)."
  },
  "enable_width_correction": {
    "type": "bool",
    "default": false,
    "description": "Enable width correction (-Ow)."
  },
  "parser": {
    "type": "string",
    "default": "auto",
    "description": "Parser to use: ttf, bdf, or ft (-p)."
  },
  "unique_id": {
    "type": "string",
    "default": "A",
    "description": "Unique ID value or 'A' for auto (-u)."
  },
  "resize_letter_a": {
    "type": "number",
    "default": 0,
    "description": "Rescale uppercase A size in points (-v)."
  },
  "verbosity_level": {
    "type": "number",
    "default": 3,
    "description": "Warning verbosity level (-W)."
  }
}
