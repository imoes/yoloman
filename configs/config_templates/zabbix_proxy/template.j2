# Configuration file for Zabbix Proxy

# Unique name of the proxy (must be known to the Zabbix server)
Hostname={{ proxy_hostname }}

# Address of the Zabbix server to forward collected data
Server={{ zabbix_server_host }}

# Port on which Zabbix proxy listens for incoming connections from Zabbix server
ListenPort={{ listen_port }}

# IP address to bind to for incoming connections (use 0.0.0.0 for all interfaces)
ListenIP={{ listen_ip }}

# Database type: sqlite3 for this package
DBType=sqlite3

# Path to SQLite database file
DBName={{ db_path }}

# Database user — not used for SQLite, but required by template logic
DBUser=

# Database password — not used for SQLite
DBPassword=

# Database host — not used for SQLite
DBHost=

# Maximum number of concurrent configuration syncs (0 = disabled)
ConfigFrequency={{ config_frequency }}

# How often (in seconds) the proxy sends data to the server
DataFrequency={{ data_frequency }}

# Enable remote commands (0 = disabled, 1 = enabled)
EnableRemoteCommands={{ enable_remote_commands | lower }}

# Log level: 0 (basic) to 5 (debug)
LogLevel={{ log_level }}

# Log file path
LogFile={{ log_file }}

# Maximum size of log file in MB before rotation (0 = no limit)
LogFileSize={{ log_file_size }}

# Timeout for agent checks (in seconds)
Timeout={{ timeout }}

# Number of pre-forked pollers for passive checks
NumPollers={{ num_pollers }}

# Number of pre-forked pollers for active checks
NumPreprocessingPollers={{ num_preprocessing_pollers }}

# Number of pre-forked pollers for SNMP checks
NumSNMPPollers={{ num_snmp_pollers }}

# Number of pre-forked pollers for IPMI checks
NumIPMIPollers={{ num_ipmi_pollers }}

# Number of pre-forked pollers for HTTP agent checks
NumHTTPPollers={{ num_http_pollers }}

# Number of pre-forked pollers for database checks
NumDBPollers={{ num_db_pollers }}

# Number of pre-forked pollers for internal checks
NumInternalPollers={{ num_internal_pollers }}

# Enable TLS connections to the Zabbix server
TLSConnect={{ tls_connect | lower }}
TLSAccept={{ tls_accept | lower }}
TLSCAFile={{ tls_ca_file }}
TLSCertFile={{ tls_cert_file }}
TLSKeyFile={{ tls_key_file }}

# Paths to SSL certificate files for TLSv1.2+ (optional, empty = use defaults)
TLSServerCertIssuer=
TLSServerCertSubject=

# Enable proxy to collect data for hosts not registered on server (experimental)
UnreachablePeriod={{ unreachable_period }}
UnavailableDelay={{ unavailable_delay }}

# Maximum number of items that can be queued for processing
MaxHousekeeperExecution={{ max_housekeeper_execution }}

# Enable data compression between proxy and server
StartProxyAgents={{ start_proxy_agents | lower }}
