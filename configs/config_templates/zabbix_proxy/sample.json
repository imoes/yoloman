{
  "proxy_hostname": "zabbix-proxy-01",
  "zabbix_server_host": "zabbix-server.example.com",
  "listen_port": 10051,
  "listen_ip": "10.0.1.25",
  "db_path": "/var/lib/zabbix/zabbix_proxy.db",
  "config_frequency": 3600,
  "data_frequency": 60,
  "enable_remote_commands": false,
  "log_level": 4,
  "log_file": "/var/log/zabbix/zabbix_proxy.log",
  "log_file_size": 10,
  "timeout": 3,
  "num_pollers": 5,
  "num_preprocessing_pollers": 2,
  "num_snmp_pollers": 2,
  "num_ipmi_pollers": 1,
  "num_http_pollers": 3,
  "num_db_pollers": 1,
  "num_internal_pollers": 1,
  "tls_connect": "cert",
  "tls_accept": "cert",
  "tls_ca_file": "/etc/ssl/zabbix/zabbix-ca.crt",
  "tls_cert_file": "/etc/ssl/zabbix/zabbix-proxy.crt",
  "tls_key_file": "/etc/ssl/zabbix/zabbix-proxy.key",
  "unreachable_period": 60,
  "unavailable_delay": 30,
  "max_housekeeper_execution": 86400,
  "start_proxy_agents": false
}
