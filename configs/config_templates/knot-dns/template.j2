# Knot DNS configuration file
# This is a production-sane template; instance-specific values are parameterized.

# Global server settings
global:
  # Worker thread count (set to 'auto' for automatic detection)
  worker-count: {{ worker_count }}

  # Maximum number of pending connections
  # (increase under high load; 0 = unlimited)
  max-pending: {{ max_pending }}

  # Maximum number of concurrent TCP connections per worker
  max-tcp-connections: {{ max_tcp_connections }}

  # Maximum TCP idle timeout in seconds
  tcp-idle-timeout: {{ tcp_idle_timeout }}

  # Maximum UDP payload size for EDNS (0 = use default 1232)
  edns-payload-size: {{ edns_payload_size }}

  # Enable DNSCrypt support (requires external library)
  dnssec-support: {{ dnssec_support }}

  # Enable XPF (Extended DNS Errors) support
  extended-errors: {{ extended_errors }}

# Listening interfaces and ports
listen:
  # Main DNS query endpoint(s)
{% for addr in listen_addrs %}
  - address: {{ addr.address }}
{% if addr.port is defined %}    port: {{ addr.port }}
{% endif %}{% if addr.proto is defined %}    proto: {{ addr.proto }}
{% endif %}{% if addr.interface is defined %}    interface: {{ addr.interface }}
{% endif %}{% endfor %}

  # DNS over HTTPS (DoH) endpoint(s) — optional
{% for doh in doh_endpoints %}  - address: {{ doh.address }}
    port: {{ doh.port }}
    proto: https
    tls:
      certificate: {{ doh.tls_certificate_path }}
      key: {{ doh.tls_key_path }}
{% if doh.http_host is defined %}    http-host: {{ doh.http_host }}
{% endif %}{% endfor %}

  # DNS over TLS (DoT) endpoint(s) — optional
{% for dot in dot_endpoints %}  - address: {{ dot.address }}
    port: {{ dot.port }}
    proto: tls
    tls:
      certificate: {{ dot.tls_certificate_path }}
      key: {{ dot.tls_key_path }}
{% endfor %}

# Access control lists (ACLs)
acls:
{% for acl in acls %}  - id: {{ acl.id }}
    # List of allowed IP addresses or prefixes
    address: [{{ acl.addresses | join(', ') }}]
{% if acl.action is defined %}    action: {{ acl.action }}
{% endif %}{% if acl.log is defined %}    log: {{ acl.log }}
{% endif %}{% endfor %}

# Zones configuration
zones:
{% for zone in zones %}  - domain: {{ zone.domain }}
    # Storage for zone data (file or database)
    file: {{ zone.data_path }}
    # Zone-specific settings
    storage: {{ zone.storage_backend }}
{% if zone.zonefile_format is defined %}    zonefile-format: {{ zone.zonefile_format }}
{% endif %}{% if zone.signing is defined %}    # DNSSEC signing settings
    signing:
      # Zone signing key (ZSK) and key-signing key (KSK) parameters
      algorithm: {{ zone.signing.algorithm }}
      ksk-size: {{ zone.signing.ksk_size }}
      zsk-size: {{ zone.signing.zsk_size }}
      ksk-lifetime: {{ zone.signing.ksk_lifetime }}
      zsk-lifetime: {{ zone.signing.zsk_lifetime }}
      dnskey-ttl: {{ zone.signing.dnskey_ttl }}
      soa-ttl: {{ zone.signing.soa_ttl }}
{% if zone.signing.nsec3_iterations is defined %}      nsec3-iterations: {{ zone.signing.nsec3_iterations }}
{% endif %}{% if zone.signing.nsec3_salt_length is defined %}      nsec3-salt-length: {{ zone.signing.nsec3_salt_length }}
{% endif %}{% if zone.signing.nsec3_opt_out is defined %}      nsec3-opt-out: {{ zone.signing.nsec3_opt_out }}
{% endif %}{% endfor %}

# Logging configuration
log:
  # Destination for logs: file, syslog, or console (stdout)
{% for target in log_targets %}  - target: {{ target.type }}
{% if target.path is defined %}    path: {{ target.path }}
{% endif %}
{% if target.levels is defined %}    any: {{ target.levels }}
{% endif %}{% endfor %}

  # Format of log entries
  format: "%(time) [%(module)] %(level) %(message)"

# Statistics and telemetry
stats:
  # Path to the statistics socket (for knotc query-stats)
  socket: {{ stats_socket_path }}

  # Interval (seconds) for periodic stats updates
  interval: {{ stats_interval }}
