{
  "bind_address": "0.0.0.0",
  "ntp_port": 123,
  "nts_enable": true,
  "nts_key_file": "/etc/ntpd-rs/nts.key",
  "nts_cert_file": "/etc/ntpd-rs/nts.crt",
  "allowed_subnets": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "refclock_enabled": true,
  "refclock_driver": "pps",
  "refclock_path": "/dev/pps0",
  "refclock_flags": "0",
  "peers": [
    {
      "address": "time.cloudflare.com",
      "nts": true
    },
    {
      "address": "time.google.com",
      "nts": true
    },
    {
      "address": "0.pool.ntp.org",
      "nts": false
    }
  ],
  "log_level": "info",
  "state_dir": "/var/lib/ntpd-rs",
  "max_rate": 50,
  "init_sync_mode": "fast"
}
