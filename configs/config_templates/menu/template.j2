# Top-Level / General Substitutions
# ============================================================================

# Global Substitution: Replaces "Apps/" prefix with "Applications/" anywhere in the path.
# Note: 'substitute' is a substring match (sed-like), not an exact section match.
substitute section->section
  {{ apps_sub_source | default('Apps/') }} {{ apps_sub_target | default('Applications/') }}
endtranslate

