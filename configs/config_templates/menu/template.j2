# ============================================================================
# FVWM Menu Migration Configuration
# ============================================================================
# This template generates FVWM `translate` and `substitute` directives to migrate
# legacy menu section names to their standardized equivalents.
#
# Structure:
#   translate section->section <source> <target>
#   substitute section->section <source> <target>
#
# Note: 'translate' is used for exact matches (regex "^<source>$"), while
# 'substitute' is used for substring replacement (sed -s "/^<source>/<target>/").
#
# See the original template comments for the full mapping hierarchy.

# ============================================================================
# Applications Group
# ============================================================================

# Amateur Radio: Migrates "Apps/Hamradio" to "Apps/Amateur Radio"
# Uses quotes around target to preserve spaces in FVWM section names.
translate section->section
  {{ hamradio_source | default('Apps/Hamradio') }} "{{ hamradio_target | default('Apps/Amateur Radio') }}"
endtranslate

