# InfiniBand Diagnostics Thresholds Configuration
# This file defines thresholds for various InfiniBand port error counters.
# When a counter exceeds its configured threshold, an event or alert can be triggered.
# Empty values (defaults) result in the default threshold being used (uncommented lines).
# Set a variable to a non-empty string to override the default.

# Threshold for SymbolErrorCounter errors.
# Default: 10
{% if symbol_error_counter is defined and symbol_error_counter | length > 0 %}SymbolErrorCounter={{ symbol_error_counter | trim }}
{% else %}#SymbolErrorCounter=10
{% endif %}

# Threshold for LinkErrorRecoveryCounter errors.
# Default: 10
{% if link_error_recovery_counter is defined and link_error_recovery_counter | length > 0 %}LinkErrorRecoveryCounter={{ link_error_recovery_counter | trim }}
{% else %}#LinkErrorRecoveryCounter=10
{% endif %}

