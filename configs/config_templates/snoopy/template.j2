; Snoopy configuration template - auto-generated by Ansible
; This file configures the Snoopy audit library (LD_PRELOAD).
; It uses the INI-style format with `;` for comments.

[snoopy]

; Log message format string using data source variables.
; Supports arbitrary text and data source calls like %{login}, %{cmdline}, etc.
; See the schema description for available data sources.
message_format = '{{ message_format | default("[login:%{login} ssh:(%{env:SSH_CONNECTION}) sid:%{sid} tty:%{tty} (%{tty_uid}/%{tty_username}) uid:%{username}(%{uid})/%{eusername}(%{euid}) cwd:%{cwd}]: %{cmdline}") }}'

; Semicolon-separated list of filters to apply to log entries.
; Examples: "exclude_uid:0", "only_uid:0", "exclude_spawns_of:cron,my_daemon"
; Must not contain spaces outside of filter arguments.
filter_chain = '{{ filter_chain | default("") }}'

; Output destination (e.g., devlog, file:/var/log/snoopy.log, socket:/path/to/socket).
; Common values: devlog, devnull, devtty, file, socket, stderr, stdout.
output = '{{ output | default("devlog") }}'

; Enable error logging (generally disabled for performance).
; Enable only for debugging new data sources or format issues.
; Value should be 'yes' or 'no'.
error_logging = {{ error_logging | default(False) | ternary('yes', 'no') }}

; Syslog facility to use for logging.
; One of: AUTH|AUTHPRIV|CRON|DAEMON|FTP|KERN|LOCAL[0-7]|LPR|MAIL|NEWS|SYSLOG|USER|UUCP
syslog_facility = '{{ syslog_facility | default("LOG_AUTHPRIV") }}'

; Syslog ident (program name) string.
; Any non-spaced string. Can use data sources like %{username}.
syslog_ident = '{{ syslog_ident | default("snoopy") }}'

; Syslog level to use.
; One of: EMERG|ALERT|CRIT|ERR|WARNING|NOTICE|INFO|DEBUG
syslog_level = '{{ syslog_level | default("LOG_INFO") }}'

; Maximum length of a message emitted by an individual data source.
; WARNING: Memory of this size is allocated on every Snoopy invocation.
; Range: 255 to 1048575.
datasource_message_max_length = {{ datasource_message_max_length | default(2047) | int }}

; Maximum length of the final formatted log message.
; WARNING: Memory of this size is allocated on every Snoopy invocation.
; Range: 255 to 1048575.
log_message_max_length = {{ log_message_max_length | default(16383) | int }}