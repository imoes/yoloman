{
  "datasource_message_max_length": {
    "default": 2047,
    "description": "Maximum length of a message emitted by an individual data source.",
    "type": "number"
  },
  "error_logging": {
    "default": false,
    "description": "Enable error logging (generally disabled for performance).",
    "type": "bool"
  },
  "filter_chain": {
    "description": "Semicolon-separated list of filters to apply to log entries.",
    "enum": [
      "exclude_spawns_of",
      "exclude_uid",
      "only_root",
      "only_tty",
      "only_uid"
    ],
    "type": "string"
  },
  "log_message_max_length": {
    "default": 16383,
    "description": "Maximum length of the final formatted log message.",
    "type": "number"
  },
  "message_format": {
    "default": "[login:%{login} ssh:(%{env:SSH_CONNECTION}) sid:%{sid} tty:%{tty} (%{tty_uid}/%{tty_username}) uid:%{username}(%{uid})/%{eusername}(%{euid}) cwd:%{cwd}]: %{cmdline}",
    "description": "Log message format string using data source variables.",
    "type": "string"
  },
  "output": {
    "default": "devlog",
    "description": "Output destination (e.g., devlog, file:/var/log/snoopy.log, socket:/path/to/socket).",
    "enum": [
      "devlog",
      "devnull",
      "devtty",
      "file",
      "socket",
      "stderr",
      "stdout",
      "syslog"
    ],
    "type": "string",
    "enum_open": true
  },
  "syslog_facility": {
    "default": "LOG_AUTHPRIV",
    "description": "Syslog facility to use for logging.",
    "type": "string"
  },
  "syslog_ident": {
    "default": "snoopy",
    "description": "Syslog ident (program name) string.",
    "type": "string"
  },
  "syslog_level": {
    "default": "LOG_INFO",
    "description": "Syslog level to use.",
    "type": "string"
  }
}
