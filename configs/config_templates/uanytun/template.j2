# Defaults for uanytun initscript
# sourced by /etc/init.d/uanytun

# Additional options that are passed to the Daemon.
# These are concatenated to the daemon invocation command.
# Example: --username uanytun --listen 0.0.0.0:8888
DAEMONOPTS="{{ (daemon_opts | default('--username uanytun')) | string }}"