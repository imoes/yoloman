-- | Propellor Configuration File
-- |
-- | This file is generated by Ansible/Jinja2 from the propellor role schema.
-- | It defines the Haskell configuration for the Propellor infrastructure
-- | management tool. Variables are sourced from Ansible inventory or defaults.
--
-- | All variable references use the `default()` filter to ensure idempotency
-- | and safety when variables are undefined in the inventory.

module Config where

import Propellor
import Propellor.Property.Git
import Propellor.Property.User

-- | Central repository URL for synchronization.
-- | Default: git@github.com:user/propellor-repo.git
-- | Corresponds to the 'central_repo_url' schema field.
centralRepoUrl = "{{ central_repo_url | default('git@github.com:user/propellor-repo.git') }}"

-- | Hostname to configure on this machine.
-- | Default: localhost
-- | Corresponds to the 'hostname' schema field.
-- | Used to set the system's FQDN or hostname property.
hostname = "{{ hostname | default('localhost') }}"

-- | Enable debug output for propellor.
-- | Default: False
-- | Corresponds to the 'enable_debug' schema field.
-- | Sets propellor.debug git config and PROPELLOR_DEBUG environment variable.
enableDebug = {{ enable_debug | default(False) | lower }}

-- | Restrict spinning to a specific branch.
-- | Default: '' (empty string)
-- | Corresponds to the 'spin_branch' schema field.
-- | If set, propellor refuses to spin unless this specific branch is checked out.
spinBranch = "{{ spin_branch | default('') }}"

-- | Forbid spinning if there are uncommitted changes.
-- | Default: False
-- | Corresponds to the 'forbid_dirty_spin' schema field.
-- | If true, propellor refuses to spin when there are uncommitted changes in ~/.propellor.
forbidDirtySpin = {{ forbid_dirty_spin | default(False) | lower }}

-- | Build system to use for propellor itself.
-- | Default: cabal
-- | Corresponds to the 'build_system' schema field.
-- | Options: cabal, stack.
buildSystem = "{{ build_system | default('cabal') }}"

-- | Privdata fields to be managed.
-- | Default: [] (empty list)
-- | Corresponds to the 'privdata' schema field.
-- | Each item is a map with 'name' and 'context'.
privdataFields = [
{% for field in privdata | default([]) %}
  {{ field.name }}
{% if not loop.last %},{% endif %}
{% endfor %}
]

-- | Main configuration block.
-- | Assembles the property list that Propellor will apply.
main = propertyList "propellor configuration"
    [ hostnameProperty hostname
    , gitRepo "~/.propellor" [ centralRepoUrl ]
    , if enableDebug then Debug else noop
    , if spinBranch != "" then Git.branch (spinBranch :: Branch) else noop
    , if forbidDirtySpin then Git.forbidDirtySpin else noop
    , if buildSystem == "stack" then Stack else Cabal
    ]

-- | Helper to apply privdata fields.
-- | This function iterates over the defined privdata fields.
-- | Actual application logic (encryption/decryption) is handled internally by Propellor.
applyPrivdata :: IO ()
applyPrivdata = mapM_ applyField privdataFields
  where
    applyField f = do
      -- Placeholder for actual privdata application logic
      return ()