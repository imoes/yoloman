# Configuration for procinfo-ng daemon
# This file provides defaults for the procinfo system information tool.
# Variables are sourced by the init script/service wrapper.

{# Pause interval in seconds between updates. Set to 0 for highest priority (root only). #}
PAUSE_INTERVAL={{ (pause_interval | default(5)) | int }}

{# Display values per second rather than totals for memory, CPU, paging, etc. Implies continuous mode. #}
PER_SECOND_STATS={{ per_second_stats | default(false) | lower }}

{# Display memory stats as totals even when PER_SECOND_STATS is true. #}
MEMORY_TOTALS={{ memory_totals | default(false) | lower }}

{# Always show per-second values even when PAUSE_INTERVAL > 1. #}
FORCE_PER_SECOND={{ force_per_second | default(false) | lower }}

{# Display numbers of bytes rather than number of I/O requests. #}
BYTES_FORMAT={{ bytes_format | default(false) | lower }}

{# Show extra line for 'real' free memory (assuming Buffers/Cache are disposable). #}
REAL_FREE_MEMORY={{ real_free_memory | default(false) | lower }}

{# Display memory stats in human-readable numbers (KiB, MiB, GiB). #}
HUMAN_READABLE={{ human_readable | default(false) | lower }}

{# Extra command line options passed to procinfo. #}
EXTRA_OPTS={{ extra_opts | default('') }}