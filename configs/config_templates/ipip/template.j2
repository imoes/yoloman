#! /bin/sh
### BEGIN INIT INFO
# Provides:          ipip
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: IP over IP encapsulation daemon
### END INIT INFO

. /lib/lsb/init-functions

PATH=/bin:/usr/bin:/sbin:/usr/sbin
DAEMON=/usr/sbin/ipip

# flags: Default flags passed to the ipip daemon (e.g., 'defaults 50').
FLAGS="{{ flags | default('defaults 50') }}"

test -f $DAEMON || exit 0

case "$1" in
  start)
    # start_flags: Additional arguments passed specifically when starting the daemon.
    start-stop-daemon --start --verbose --exec $DAEMON {{ start_flags | default('') }}
    ;;
  stop)
    start-stop-daemon --stop --verbose --exec $DAEMON
    ;;
  restart|force-reload)
    start-stop-daemon --stop --verbose --exec $DAEMON
    start-stop-daemon --start --verbose --exec $DAEMON {{ start_flags | default('') }}
    ;;
  *)
    echo "Usage: /etc/init.d/ipip {start|stop|restart|force-reload}"
    exit 1
    ;;
esac

exit 0