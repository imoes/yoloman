#       C o m m a n d s

# Path to Ghostscript executable.
# Used by colplot to process PostScript/PDF graphics.
GS=      {{ GS | default('/usr/bin/gs') }}

# Path to cp (copy) command.
# Standard Unix copy utility.
CP=      {{ CP | default('/bin/cp') }}

# Path to gzip command.
# Compression utility used for plot archives or logs.
GZIP=    {{ GZIP | default('/bin/gzip') }}

# Path to mail command.
# Used to send plot reports or notifications via email.
MAIL=    {{ MAIL | default('/bin/mail') }}

# Path to rm (remove) command.
# Standard Unix remove utility, used for cleaning up old plots.
RM=      {{ RM | default('/bin/rm') }}

# Path to tar command.
# Archiving utility for bundling plot files.
TAR=     {{ TAR | default('/bin/tar') }}

# Path to uuencode command.
# Encoding utility for attaching binary data to emails.
UUENCODE={{ UUENCODE | default('/usr/bin/uuencode') }}

#       D i r e c t o r i e s

# Directory where plot files are stored.
PlotDir  = {{ PlotDir | default('/var/log/collectl') }}

#	g n u p l o t

# Colon-separated list of paths to search for the gnuplot executable.
# Used to locate the gnuplot binary during runtime.
GnuPlot= {{ GnuPlot | default('/usr/bin/gnuplot:/usr/local/bin/gnuplot') }}

# Default gnuplot version string.
# Primarily used on Windows systems or for version-specific rendering hints.
GnuVersion={{ GnuVersion | default('3.7') }}

#    P l o t    D e f a u l t s

# Default line type 1 for gnuplot styling.
lt1={{ lt1 | default(8) }}

# Default line type 2 for gnuplot styling.
lt2={{ lt2 | default(3) }}

# Default line type 3 for gnuplot styling.
lt3={{ lt3 | default(1) }}

# Default line type 4 for gnuplot styling.
lt4={{ lt4 | default(2) }}

# Default line type 5 for gnuplot styling.
lt5={{ lt5 | default(-1) }}

# Default line type 6 for gnuplot styling.
lt6={{ lt6 | default(5) }}

# Default line type 7 for gnuplot styling.
lt7={{ lt7 | default(16) }}

# Default line type 8 for gnuplot styling.
lt8={{ lt8 | default(14) }}

# Default line type 9 for gnuplot styling.
lt9={{ lt9 | default(4) }}

# Default line type 10 for gnuplot styling.
lt10={{ lt10 | default(6) }}

# Default line type 11 for gnuplot styling.
lt11={{ lt11 | default(7) }}

# Default line type 12 for gnuplot styling.
lt12={{ lt12 | default(9) }}

# Default line type 13 for gnuplot styling.
lt13={{ lt13 | default(10) }}

# Default line type 14 for gnuplot styling.
lt14={{ lt14 | default(11) }}

# Default line type 15 for gnuplot styling.
lt15={{ lt15 | default(12) }}

# Default line type 16 for gnuplot styling.
lt16={{ lt16 | default(13) }}