  },
  "term_height": {
    "type": "string",
    "description": "termHeight (as documented in the shipped file). Unset keeps the shipped commented line (#termHeight = 0.2).",
    "default": null
  },
  "term_width": {
    "type": "string",
    "description": "termWidth (as documented in the shipped file). Unset keeps the shipped commented line (#termWidth =  1).",
    "default": null
  }
}
