{
  "GS": {
    "type": "string",
    "default": "/usr/bin/gs",
    "description": "Path to Ghostscript executable."
  },
  "CP": {
    "type": "string",
    "default": "/bin/cp",
    "description": "Path to cp (copy) command."
  },
  "GZIP": {
    "type": "string",
    "default": "/bin/gzip",
    "description": "Path to gzip command."
  },
  "MAIL": {
    "type": "string",
    "default": "/bin/mail",
    "description": "Path to mail command."
  },
  "RM": {
    "type": "string",
    "default": "/bin/rm",
    "description": "Path to rm (remove) command."
  },
  "TAR": {
    "type": "string",
    "default": "/bin/tar",
    "description": "Path to tar command."
  },
  "UUENCODE": {
    "type": "string",
    "default": "/usr/bin/uuencode",
    "description": "Path to uuencode command."
  },
  "PlotDir": {
    "type": "string",
    "default": "/var/log/collectl",
    "description": "Directory where plots are stored."
  },
  "GnuPlot": {
    "type": "string",
    "default": "/usr/bin/gnuplot:/usr/local/bin/gnuplot",
    "description": "Colon-separated list of paths to search for gnuplot executable."
  },
  "GnuVersion": {
    "type": "string",
    "default": "3.7",
    "description": "Default gnuplot version (used primarily on Windows)."
  },
  "lt1": {
    "type": "number",
    "default": 8,
    "description": "Gnuplot line type 1."
  },
  "lt2": {
    "type": "number",
    "default": 3,
    "description": "Gnuplot line type 2."
  },
  "lt3": {
    "type": "number",
    "default": 1,
    "description": "Gnuplot line type 3."
  },
  "lt4": {
    "type": "number",
    "default": 2,
    "description": "Gnuplot line type 4."
  },
  "lt5": {
    "type": "number",
    "default": -1,
    "description": "Gnuplot line type 5."
  },
  "lt6": {
    "type": "number",
    "default": 5,
    "description": "Gnuplot line type 6."
  },
  "lt7": {
    "type": "number",
    "default": 16,
    "description": "Gnuplot line type 7."
  },
  "lt8": {
    "type": "number",
    "default": 14,
