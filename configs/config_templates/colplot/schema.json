{
  "CP": {
    "type": "string",
    "description": "Path to cp (copy) command.",
    "default": "/bin/cp"
  },
  "GS": {
    "type": "string",
    "description": "Path to Ghostscript executable.",
    "default": "/usr/bin/gs"
  },
  "GZIP": {
    "type": "string",
    "description": "Path to gzip command.",
    "default": "/bin/gzip"
  },
  "GnuPlot": {
    "type": "string",
    "description": "Colon-separated list of paths to search for gnuplot executable.",
    "default": "/usr/bin/gnuplot:/usr/local/bin/gnuplot"
  },
  "GnuVersion": {
    "type": "string",
    "description": "Default gnuplot version (used primarily on Windows).",
    "default": "3.7"
  },
  "MAIL": {
    "type": "string",
    "description": "Path to mail command.",
    "default": "/bin/mail"
  },
  "PlotDir": {
    "type": "string",
    "description": "Directory where plots are stored.",
    "default": "/var/log/collectl"
  },
  "RM": {
    "type": "string",
    "description": "Path to rm (remove) command.",
    "default": "/bin/rm"
  },
  "TAR": {
    "type": "string",
    "description": "Path to tar command.",
    "default": "/bin/tar"
  },
  "UUENCODE": {
    "type": "string",
    "description": "Path to uuencode command.",
    "default": "/usr/bin/uuencode"
  },
  "help_dir": {
    "type": "string",
    "description": "HelpDir (as documented in the shipped file).",
    "default": "="
  },
  "http_height": {
    "type": "string",
    "description": "httpHeight (as documented in the shipped file). Unset keeps the shipped commented line (#httpHeight = 0.3).",
    "default": null
  },
  "http_width": {
    "type": "string",
    "description": "httpWidth (as documented in the shipped file). Unset keeps the shipped commented line (#httpWidth =  1.2).",
    "default": null
  },
  "lt1": {
    "type": "number",
    "description": "Gnuplot line type 1.",
    "default": 8
  },
  "lt10": {
    "type": "number",
    "description": "Gnuplot line type 10.",
    "default": 6
  },
  "lt11": {
    "type": "number",
    "description": "Gnuplot line type 11.",
    "default": 7
  },
  "lt12": {
    "type": "number",
    "description": "Gnuplot line type 12.",
    "default": 9
  },
  "lt13": {
    "type": "number",
    "description": "Gnuplot line type 13.",
    "default": 10
  },
  "lt14": {
    "type": "number",
    "description": "Gnuplot line type 14.",
    "default": 11
  },
  "lt15": {
    "type": "number",
    "description": "Gnuplot line type 15.",
    "default": 12
  },
  "lt16": {
    "type": "number",
    "description": "Gnuplot line type 16.",
    "default": 13
  },
  "lt2": {
    "type": "number",
    "description": "Gnuplot line type 2.",
    "default": 3
  },
  "lt3": {
    "type": "number",
    "description": "Gnuplot line type 3.",
    "default": 1
  },
  "lt4": {
    "type": "number",
    "description": "Gnuplot line type 4.",
    "default": 2
  },
  "lt5": {
    "type": "number",
    "description": "Gnuplot line type 5.",
    "default": -1
  },
  "lt6": {
    "type": "number",
    "description": "Gnuplot line type 6.",
    "default": 5
  },
  "lt7": {
    "type": "number",
    "description": "Gnuplot line type 7.",
    "default": 16
  },
  "lt8": {
    "type": "number",
    "description": "Gnuplot line type 8.",
    "default": 14
  },
  "lt9": {
    "type": "number",
    "description": "Gnuplot line type 9.",
