{
  "heat_api_cfn": {
    "bind_host": "0.0.0.0",
    "bind_port": 8000,
    "api_workers": 2,
    "debug": false,
    "verbose": false
  },
  "keystone_authtoken": {
    "auth_uri": "https://keystone.example.com:5000",
    "auth_url": "https://keystone.example.com:5000",
    "username": "heat",
    "password": "heat_secret_password",
    "project_name": "services",
    "user_domain_name": "Default",
    "project_domain_name": "Default",
    "auth_type": "password",
    "insecure": false
  },
  "trustee": {
    "username": "heat",
    "password": "heat_trustee_secret_password",
    "project_name": "services",
    "user_domain_name": "Default",
    "project_domain_name": "Default",
    "auth_url": "https://keystone.example.com:5000"
  },
  "clients_keystone": {
    "endpoint_type": "internalURL"
  },
  "database": {
    "connection": "mysql+pymysql://heat:heat_db_pass@db.example.com/heat"
  },
  "oslo_concurrency": {
    "lock_path": "/var/lib/heat/locks"
  },
  "oslo_messaging_notifications": {
    "driver": [
      "messagingv2"
    ],
    "topics": [
      "notifications"
    ]
  },
  "oslo_messaging_rabbit": {
    "rabbit_host": "rabbitmq.example.com",
    "rabbit_port": 5672,
    "rabbit_userid": "heat",
    "rabbit_password": "rabbit_secret",
    "rabbit_virtual_host": "/heat",
    "rabbit_heartbeat_timeout_threshold": 60,
    "rabbit_use_ssl": true,
    "rabbit_ssl_version": "tlsv1_2",
    "rabbit_ha_queues": true
  },
  "oslo_policy": {
    "policy_file": "/etc/heat/policy.yaml",
    "default_rule": "default"
  }
}
