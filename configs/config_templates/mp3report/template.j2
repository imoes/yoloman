<!DOCTYPE html>
<!-- mp3report.html: Self-documenting HTML report generated by mp3report.
     All variables use explicit defaults matching the schema to ensure safe rendering. -->
<html>
<head>
    <!-- The title used in the HTML <TITLE> tag and the first line of the report. -->
    <title>{{ (t_title | default('MP3 Report')) | e }}</title>
</head>
<body>
    <!-- The title used in the HTML <TITLE> tag and the first line of the report. -->
    <h1>{{ (t_title | default('MP3 Report')) | e }}</h1>
    
    <!-- The local date and time when the report was generated. -->
    <p>Generated on {{ (t_datetime | default('2023-10-05 12:00:00')) | e }}</p>
    
    <!-- The list of parent directories that was scanned in the report. -->
    <p>
        Scanned directories:
        <br>
        {% if (t_dirs | default([])) is iterable and (t_dirs | default([])) is not mapping %}
            {{ (t_dirs | default([])) | join('<br>') | safe }}
        {% else %}
            {{ (t_dirs | default([])) | string | e }}
        {% endif %}
    </p>
    
    <!-- The total number of directories and subdirectories scanned. -->
    <p>Total directories: {{ (t_numdirs | default(5)) | e }}</p>
    
    <!-- The total number of MP3 files included in the report. -->
    <p>Total files: {{ (t_numfiles | default(150)) | e }}</p>
    
    <!-- The total size of all MP3 files included in the report combined. -->
    <p>Total size: {{ (t_size | default('5.00 GB (5120.00 MB)')) | e }}</p>
    
    <!-- The total playing time of all songs combined. -->
    <p>Total playtime: {{ (t_playtime | default('2 days, 4 hours, 12 minutes, 30 seconds')) | e }}</p>
    
    <!-- The total time it took to generate the report. -->
    <p>Execution time: {{ (t_exectime | default('10 seconds')) | e }}</p>
    
    <!-- The average size of the MP3s in this report. -->
    <p>Average size: {{ (t_avgsize | default('35.00 MB')) | e }}</p>
    
    <!-- The average playing time of a single song in the report. -->
    <p>Average playtime: {{ (t_avgplaytime | default('4 minutes, 32 seconds')) | e }}</p>
    
    <hr>
    <table border="1">
    <tr>
        <th>#</th>
        <th>Artist</th>
        <th>Title</th>
        <th>Album</th>
        <th>Year</th>
        <th>Genre</th>
        <th>Bitrate</th>
        <th>Length</th>
        <th>Size</th>
    </tr>
    
    <!-- A list of MP3 file items scanned in the directories. Each item must be an object with the following fields: -->
    {% for item in (items | default([])) %}
    <tr>
        <!-- Background color for the item row, if specified -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_num | default(0)) | e }}</td>
        <!-- Artist ID3 tag -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_id3artist | default('')) | e }}</td>
        <!-- Title ID3 tag -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_id3title | default('')) | e }}</td>
        <!-- Album ID3 tag -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_id3album | default('')) | e }}</td>
        <!-- Year ID3 tag -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_id3year | default('')) | e }}</td>
        <!-- Genre ID3 tag -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_id3genre | default('')) | e }}</td>
        <!-- Bitrate in kbps -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_bitrate | default('')) | e }} kbps</td>
        <!-- Length of the track -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_len | default('')) | e }}</td>
        <!-- Size of the file -->
        <td bgcolor="{{ (item.item_bgcolor | default('')) | e }}">{{ (item.item_size | default('')) | e }}</td>
    </tr>
    {% endfor %}
    </table>
    <hr>
    
    <!-- The filename that the report is being written to. -->
    <p>Report written to: {{ (t_filename | default('report.html')) | e }}</p>
    
    <!-- The filename of the template that is being used. -->
    <p>Template used: {{ (t_template_filename | default('default.html')) | e }}</p>
    
    <!-- Either 'Yes' or 'No' depending on whether the '--printmode' flag was specified. -->
    <p>Print mode: {{ (t_printmode | default('No')) | e }}</p>
    
    <!-- Either 'Yes' or 'No' depending on whether user specified custom directories to scan on the command line. -->
    <p>Custom dirs: {{ (t_customdirs | default('Yes')) | e }}</p>
    
    <!-- Either 'Standard' or 'WinAMP' depending on whether or not the user specified '--stdgenres'. -->
    <p>Genre type: {{ (t_genretype | default('WinAMP')) | e }}</p>
    
    <!-- Either 'Yes' or 'No' depending on whether the '--id3v2' flag was specified. -->
    <p>ID3v2 support: {{ (t_id3v2 | default('Yes')) | e }}</p>
</body>
</html>