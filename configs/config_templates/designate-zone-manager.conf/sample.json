{
  "log_level": "INFO",
  "bind_host": "127.0.0.1",
  "bind_port": 9000,
  "workers": 2,
  "rpc_workers": 2,
  "rpc_transport_url": "rabbit://guest:guest@127.0.0.1:5672//",
  "rpc_use_ssl": false,
  "zone_sync_interval": 30,
  "zone_sync_batch_size": 200,
  "zone_processing_retries": 5,
  "zone_retry_delay": 10,
  "enabled": true,
  "service_endpoints": [
    {
      "name": "dns",
      "url": "http://designate-api:9001/",
      "region": "RegionOne",
      "service_type": "dns",
      "enabled": true
    },
    {
      "name": "notify",
      "url": "http://designate-api:9001/",
      "region": "RegionOne",
      "service_type": "dns",
      "enabled": true
    }
  ],
  "database_connection": "mysql+pym://designate:secretpass@dbhost/designate?charset=utf8mb4",
  "pool_enabled": true,
  "pool_size": 20,
  "pool_max_overflow": 30,
  "pool_timeout": 45
}
