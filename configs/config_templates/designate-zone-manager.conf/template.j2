[DEFAULT]
# The log level for the zone manager service
log_level = {{ log_level }}

# The host to bind the RPC server to (unused in most deployments; RPC is local-only by default)
# RPC is not exposed over the network; kept for completeness
bind_host = {{ bind_host }}

# The port to bind the RPC server to (unused; kept for completeness)
bind_port = {{ bind_port }}

# Number of worker processes to handle zone management tasks
workers = {{ workers }}

# Number of RPC workers (usually matches workers)
rpc_workers = {{ rpc_workers }}

# RPC transport URL for communication with other Designate services
rpc_transport_url = {{ rpc_transport_url }}

# Enable secure RPC (SSL/TLS) — typically disabled in internal networks
rpc_use_ssl = {{ rpc_use_ssl | lower }}

[service:zone_manager]
# The period (in seconds) between zone sync checks
zone_sync_interval = {{ zone_sync_interval }}

# Maximum number of zones to process in a single sync batch
zone_sync_batch_size = {{ zone_sync_batch_size }}

# Number of retries when processing a zone fails
zone_processing_retries = {{ zone_processing_retries }}

# Delay (in seconds) between retry attempts
zone_retry_delay = {{ zone_retry_delay }}

# Enable or disable the zone manager service
enabled = {{ enabled }}

{% for service in service_endpoints %}
[service_endpoint:{{ service.name }}]
# URL for the {{ service.name | replace('_', ' ') | title }} service
endpoint = {{ service.url }}

# Region where the service is located
region_name = {{ service.region }}

# Service type as known to OpenStack service catalog
service_type = {{ service.service_type }}

# Enable or disable this endpoint
enabled = {{ service.enabled }}

# Optional: auth-related overrides (rarely used in zone-manager)
{% if service.username %}
username = {{ service.username }}
{% endif %}
{% if service.password %}
password = {{ service.password }}
{% endif %}
{% if service.project_name %}
project_name = {{ service.project_name }}
{% endif %}
{% if service.auth_url %}
auth_url = {{ service.auth_url }}
{% endif %}
{% endfor %}

[storage:sqlalchemy]
# Database connection string (e.g., mysql+pymysql://user:pass@host/db)
database_connection = {{ database_connection }}

# Enable database pooling
pool_enabled = {{ pool_enabled }}

# Maximum number of DB connections in the pool
pool_size = {{ pool_size }}

# Maximum overflow for DB connections beyond pool_size
pool_max_overflow = {{ pool_max_overflow }}

# DB connection timeout (seconds)
pool_timeout = {{ pool_timeout }}
