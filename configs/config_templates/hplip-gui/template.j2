# ============================================================================
# HPLIP GUI Desktop Entry Configuration
# ============================================================================
# This template generates a .desktop file for the HP System Tray Service.
# It is used by desktop environments to launch the HP printer status applet.
# ============================================================================

[Desktop Entry]
# Desktop file specification version
Version=0.6

# Entry type: Application indicates this is a runnable program
Type=Application

# Display name of the application in menus and launchers
Name=HP System Tray Service

# Generic name/category label for the application
GenericName=Printer Status Applet

# Description displayed in tooltips or properties
Comment=HP System Tray Service

# Command line to execute when launching the application
Exec=hp-systray -x

# Path to the icon file representing this application in menus and panels.
# Uses the default HP logo path if not specified by the user.
Icon={{ icon_path | default('/usr/share/hplip/data/images/128x128/hp_logo.png') }}

# Whether to run the application in a terminal window
Terminal=false

# Categories for the application, used by the desktop environment to organize menus
Categories=Application;Utility;

# KDE-specific: Disable startup notification for this app
X-KDE-StartupNotify=false

# Standard startup notification setting
StartupNotify=false

# List of desktop environments where this application should NOT appear
NotShowIn=GNOME;