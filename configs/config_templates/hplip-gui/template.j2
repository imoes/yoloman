# HPLIP GUI Desktop Entry
#
# This template generates a .desktop file for the HP System Tray Service.
# It defines the application metadata, executable command, and associated icon.
#
# Variables:
#   icon_path: Path to the HP system tray icon file.
#              Defaults to '/usr/share/hplip/data/images/128x128/hp_logo.png'.

[Desktop Entry]

# Version of the desktop entry specification
Version=0.6

# Type of entry; 'Application' indicates a standalone application
Type=Application

# Display name of the application
Name=HP System Tray Service

# Generic name used for grouping or categorization
GenericName=Printer Status Applet

# Short description displayed in tooltips or menus
Comment=HP System Tray Service

# Command line executed when the application is launched
Exec=hp-systray -x

# Path to the application icon.
# Defaults to the standard HP logo provided by the hplip package.
Icon={{ icon_path | default('/usr/share/hplip/data/images/128x128/hp_logo.png') }}

# Whether to run in a terminal window (false for GUI apps)
Terminal=false

# Semicolon-separated list of categories for the application
Categories=Application;Utility;

# KDE-specific flag to suppress startup notification
X-KDE-StartupNotify=false

# Standard startup notification flag
StartupNotify=false

# List of desktop environments where this application should NOT be shown
# 'GNOME' is excluded here as HPLIP systray may conflict or be handled differently
NotShowIn=GNOME;
