{
  "config_dir": {
    "type": "string",
    "default": ".claws-mail",
    "description": "User config directory under $HOME (e.g., .claws-mail)"
  },
  "main_rc": {
    "type": "string",
    "default": "clawsrc",
    "description": "Main configuration filename (clawsrc)"
  },
  "accounts": {
    "type": "list",
    "default": [],
    "description": "List of email accounts (accountrc format). Each item defines one account."
  },
  "accounts[].name": {
    "type": "string",
    "default": "Default Account",
    "description": "Account display name"
  },
  "accounts[].protocol": {
    "type": "string",
    "default": "IMAP4",
    "description": "Protocol: POP3, IMAP4, IMAP4rev1 (case-sensitive, per real docs)"
  },
  "accounts[].server": {
    "type": "string",
    "default": "",
    "description": "Mail server hostname (required for IMAP/POP3)"
  },
  "accounts[].port": {
    "type": "number",
    "default": 0,
    "description": "Port number (0 = default)"
  },
  "accounts[].user": {
    "type": "string",
    "default": "",
    "description": "Mailbox login username"
  },
  "accounts[].passwd": {
    "type": "string",
    "default": "",
    "description": "Plain-text password or empty (use * to mask)"
  },
  "accounts[].use_ssl": {
    "type": "bool",
    "default": false,
    "description": "Use SSL (ssl=1) \u2014 for POP3/IMAP"
  },
  "accounts[].use_tls": {
    "type": "bool",
    "default": false,
    "description": "Use STARTTLS (ssl=2) \u2014 for POP3/IMAP"
  },
  "accounts[].smtp_server": {
    "type": "string",
    "default": "",
    "description": "SMTP server hostname"
  },
  "accounts[].smtp_port": {
    "type": "number",
    "default": 587,
    "description": "SMTP port (default 587 if not specified)"
  },
  "accounts[].use_smtp_auth": {
    "type": "bool",
    "default": false,
    "description": "Enable SMTP AUTH (smtp_auth=1)"
  },
  "accounts[].use_smtp_user": {
    "type": "string",
    "default": "",
    "description": "SMTP auth username"
  },
  "accounts[].use_smtp_passwd": {
    "type": "string",
    "default": "",
    "description": "SMTP auth password (leave empty to mask with *)"
  },
  "accounts[].local_repository": {
    "type": "string",
    "default": "",
    "description": "Local mailbox directory (e.g., #mh/Mailbox)"
  },
  "accounts[].default_identity": {
    "type": "bool",
    "default": true,
    "description": "Use default identity for this account (1=yes, 0=no)"
  },
  "accounts[].from_addr": {
    "type": "string",
    "default": "",
    "description": "Email address used as From:"
  },
  "accounts[].real_name": {
    "type": "string",
    "default": "",
    "description": "Display name used in From: header"
  },
  "main_config": {
    "type": "object",
    "default": null,
    "description": "Main clawsrc settings"
  },
  "main_config.default_folder": {
    "type": "string",
    "default": "",
    "description": "Default folder path (e.g., #mh/Mailbox/Inbox)"
  },
  "main_config.default_send_account": {
    "type": "number",
    "default": 1,
    "description": "Default account index for sending (1-based)"
  },
  "main_config.auto_check_interval": {
    "type": "number",
    "default": 0,
    "description": "Auto-check interval in minutes (0 = disable)"
  },
  "main_config.check_on_startup": {
    "type": "bool",
    "default": true,
    "description": "Check for new mail on startup (true=1, false=0)"
  },
  "main_config.offline_mode": {
    "type": "bool",
    "default": false,
    "description": "Start in offline mode (true=1, false=0)"
  },
  "main_config.font": {
    "type": "string",
    "default": "",
    "description": "Main interface font (e.g., 'Sans 10')"
  },
  "main_config.message_font": {
    "type": "string",
    "default": "",
    "description": "Message view font"
  },
  "main_config.composer_font": {
    "type": "string",
    "default": "",
    "description": "Composer font"
  },
  "main_config.date_format": {
    "type": "string",
    "default": "",
    "description": "Date format string (per strftime)"
  },
  "main_config.theme_dir": {
    "type": "string",
    "default": "",
    "description": "User theme directory (e.g., ~/.claws-mail/themes)"
  },
  "filters": {
    "type": "list",
    "default": [],
    "description": "Filter rules (matcherrc format)"
  },
  "filters[].name": {
    "type": "string",
    "default": "",
    "description": "Filter name (appears in UI)"
  },
  "filters[].condition": {
    "type": "string",
    "default": "",
    "description": "Filter condition (e.g., 'subject ~ \"spam\"')"
  },
  "filters[].action": {
    "type": "string",
    "default": "",
    "description": "Filter action (e.g., 'move #mh/Mailbox/Spam')"
  }
}
