{
  "config_dir": ".claws-mail",
  "main_rc": "clawsrc",
  "accounts": [
    {
      "name": "Personal",
      "protocol": "IMAP4",
      "server": "imap.example.com",
      "port": 993,
      "user": "user@example.com",
      "passwd": "",
      "use_ssl": true,
      "smtp_server": "smtp.example.com",
      "smtp_port": 587,
      "use_smtp_auth": true,
      "use_smtp_user": "user@example.com",
      "use_smtp_passwd": "",
      "local_repository": "#mh/Mailbox",
      "from_addr": "user@example.com",
      "real_name": "John Doe"
    },
    {
      "name": "Work",
      "protocol": "IMAP4",
      "server": "imap.work.com",
      "port": 143,
      "user": "jdoe@work.com",
      "passwd": "secret",
      "use_tls": true,
      "smtp_server": "smtp.work.com",
      "smtp_port": 25,
      "use_smtp_auth": false,
      "local_repository": "#mh/WorkMail",
      "from_addr": "jdoe@work.com",
      "real_name": "John Doe (Work)"
    }
  ],
  "main_config": {
    "default_folder": "#mh/Mailbox/Inbox",
    "default_send_account": 1,
    "auto_check_interval": 5,
    "check_on_startup": true,
    "offline_mode": false,
    "font": "Sans 10",
    "message_font": "Monospace 10",
    "composer_font": "Sans 10",
    "date_format": "%Y-%m-%d %H:%M",
    "theme_dir": "~/.claws-mail/themes"
  },
  "filters": [
    {
      "name": "Move spam",
      "condition": "subject ~ \"spam\" OR x-spam-flag = YES",
      "action": "move #mh/Mailbox/Spam"
    },
    {
      "name": "Archive newsletters",
      "condition": "from ~ \"newsletter\"",
      "action": "move #mh/Mailbox/Archives/Newsletters"
    }
  ]
}
