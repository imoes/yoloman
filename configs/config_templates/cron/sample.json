{
  "cron_jobs": [
    {
      "minute": "0",
      "hour": "5",
      "day_of_month": "*",
      "month": "*",
      "day_of_week": "0",
      "user": "root",
      "command": "/usr/bin/systemctl restart nginx"
    },
    {
      "minute": "30",
      "hour": "2",
      "day_of_month": "*",
      "month": "*",
      "day_of_week": "*",
      "user": "backup",
      "command": "/usr/local/bin/backup.sh"
    },
    {
      "minute": "*/15",
      "hour": "*",
      "day_of_month": "*",
      "month": "*",
      "day_of_week": "*",
      "user": "www-data",
      "command": "/var/www/cron/cleanup_sessions.php"
    }
  ]
}
