{
  "journal_storage_dir": "/var/log/journal",
  "journal_system_max_use": "200M",
  "journal_system_max_file_size": "20M",
  "journal_system_keep_free": "10%",
  "journal_sync_interval_sec": 5,
  "journal_max_file_sec": "1month",
  "syslog_forward_to_socket": true,
  "forward_to_journal": true,
  "forward_to_kmsg": false,
  "forward_to_console": false,
  "journal_runtime_journal_dir": "/run/log/journal",
  "journal_system_journal_dir": "/var/log/journal",
  "syslog_stream_socket": "/run/systemd/journal/syslog",
  "stream_socket_extra_fields": [
    "SYSLOG_FACILITY",
    "SYSLOG_IDENTIFIER",
    "SYSLOG_PID"
  ],
  "rate_limit_interval_sec": 30,
  "rate_limit_burst": 2000,
  "compress": true,
  "log_level": "info",
  "log_facility": [
    "kern",
    "user",
    "daemon",
    "auth",
    "local0",
    "local7"
  ],
  "readahead_max_threads": 3,
  "binary_journal": true,
  "journal_max_entries": 15000,
  "journal_max_entries_sec": 90,
  "journal_user_max_entries": 5000
}
