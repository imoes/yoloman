{
  "rest_base_url": "/rest",
  "rest_endpoints": [
    {
      "path": "/users",
      "methods": [
        "GET",
        "POST"
      ],
      "handler": "ejabberd_mod_rest_user",
      "acl": [
        {
          "user": "admin@localhost",
          "access": "allow"
        },
        {
          "user": "*@localhost",
          "access": "deny"
        }
      ]
    },
    {
      "path": "/users/:user@:host",
      "methods": [
        "GET",
        "PUT",
        "DELETE"
      ],
      "handler": "ejabberd_mod_rest_user",
      "acl": []
    },
    {
      "path": "/rooms",
      "methods": [
        "GET",
        "POST"
      ],
      "handler": "ejabberd_mod_rest_muc",
      "acl": [
        {
          "user": "*@localhost",
          "access": "allow"
        }
      ]
    }
  ],
  "rest_log_requests": false,
  "rest_max_request_size": 5242880,
  "rest_request_timeout": 60,
  "rest_enable_cors": true,
  "rest_cors_origins": [
    "https://admin.example.com",
    "https://webapp.example.com"
  ],
  "rest_cors_headers": [
    "Content-Type",
    "Authorization",
    "X-Ejabberd-Node"
  ]
}
