# OpenStack Fence Agent configuration
# Authentication parameters for connecting to OpenStack
auth_url={{ auth_url }}
username={{ username }}
password={{ password }}
project_name={{ project_name }}
user_domain_name={{ user_domain_name }}
project_domain_name={{ project_domain_name }}
# Optional: region and API version
{% if region %}region={{ region }}{% endif %}
{% if api_version %}api_version={{ api_version }}{% endif %}
# Optional: custom endpoint overrides
{% for endpoint in endpoint_overrides %}{{ endpoint.key }}={{ endpoint.value }}{% endfor %}
# Optional: insecure (SSL verification toggle)
{% if insecure is defined %}insecure={{ insecure | lower }}{% endif %}
# Optional: cafile/certfile for TLS
{% if cafile %}cafile={{ cafile }}{% endif %}
{% if certfile %}certfile={{ certfile }}{% endif %}
