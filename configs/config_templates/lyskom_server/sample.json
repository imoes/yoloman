{
  "listen_address": "0.0.0.0",
  "port": 4343,
  "db_dir": "/var/lib/lyskom",
  "max_connections": 100,
  "max_rooms_per_user": 50,
  "max_posts_per_day": 500,
  "allow_anonymous": false,
  "use_tls": true,
  "tls_cert": "/etc/lyskom/tls.crt",
  "tls_key": "/etc/lyskom/tls.key",
  "log_level": "info",
  "log_file": "/var/log/lyskom/lyskomd.log",
  "admins": [
    "komadmin"
  ],
  "blocked_hosts": [],
  "lang_default": "en",
  "locale_default": "en_US.UTF-8",
  "timezone": "UTC",
  "max_text_size": 100000,
  "auto_backup": true,
  "backup_dir": "/var/lib/lyskom/backups",
  "backup_interval": 3600,
  "smtp_servers": [
    "localhost:25"
  ],
  "email_notifications": true,
  "sender_email": "lyskom-noreply@lyskom.example.com",
  "dns_timeout": 5,
  "max_dns_lookups": 3,
  "rate_limit_registrations": true,
  "max_registrations_per_ip_per_hour": 10
}
