# LysKOM configuration file — main server settings
# Hostname and port the server listens on
listen: {{ listen_address }}:{{ port }}

# Path to the LysKOM database directory
db_dir: {{ db_dir }}

# Maximum number of simultaneous client connections
max_connections: {{ max_connections }}

# Maximum number of concurrent conference (room) creations per user
max_rooms_per_user: {{ max_rooms_per_user }}

# Maximum number of messages a user may post per day
max_posts_per_day: {{ max_posts_per_day }}

# Enable or disable anonymous access
allow_anonymous: {{ allow_anonymous }}

# Enable or disable TLS (SSL) for secure connections
use_tls: {{ use_tls }}

# Path to TLS certificate and key (used only if use_tls is true)
tls_cert: {{ tls_cert }}
tls_key: {{ tls_key }}

# Logging level: debug, info, notice, warning, error, critical, alert, emergency
log_level: {{ log_level }}

# Path to the log file
log_file: {{ log_file }}

# List of administrators (user IDs or usernames)
admin_list:
{% for admin in admins %}  {{ admin }}
{% endfor %}

# List of blocked hosts/IPs (optional — leave empty if none)
{% if blocked_hosts %}blocked_hosts:
{% for host in blocked_hosts %}  {{ host }}
{% endfor %}
{% else %}blocked_hosts:
{% endif %}

# Locale and language defaults
lang_default: {{ lang_default }}
locale_default: {{ locale_default }}

# Timezone for server logs and timestamps
timezone: {{ timezone }}

# Maximum size of a text (in characters) allowed for new posts
max_text_size: {{ max_text_size }}

# Enable or disable automatic backup of database after changes
auto_backup: {{ auto_backup }}

# Path for backup files (used only if auto_backup is true)
backup_dir: {{ backup_dir }}

# Interval (in seconds) between automatic backups
backup_interval: {{ backup_interval }}

# List of SMTP servers for outgoing mail (e.g., notifications)
smtp_servers:
{% for smtp in smtp_servers %}  {{ smtp }}
{% endfor %}

# Enable or disable email notifications
email_notifications: {{ email_notifications }}

# Default sender email for system messages
sender_email: {{ sender_email }}

# DNS resolver timeout (in seconds)
dns_timeout: {{ dns_timeout }}

# Maximum number of DNS lookups per connection
max_dns_lookups: {{ max_dns_lookups }}

# Enable or disable rate-limiting of new user registrations
rate_limit_registrations: {{ rate_limit_registrations }}

# Maximum registrations per IP per hour
max_registrations_per_ip_per_hour: {{ max_registrations_per_ip_per_hour }}
