# ============================================================================
# LysKOM Server Configuration Template
# ============================================================================
# This file configures the LysKOM conference system server (lyskomd).
# It is generated by Ansible using Jinja2. Do NOT edit manually.
#
# Format: Simple key: value pairs and list blocks.
# See: http://www.lysator.liu.se/~lyskom/ for upstream documentation.
# ============================================================================

# --- Network Settings ---

# IP address the LysKOM server binds to.
# Use 0.0.0.0 to listen on all interfaces, or a specific IP.
# Default: '0.0.0.0'
listen: {{ (listen_address | default('0.0.0.0')) }}:{{ (port | default(4343)) }}

# TCP port number for LysKOM client connections (standard: 4343).
# Default: 4343

# --- Database & Storage ---

# Absolute path to the directory containing the LysKOM database files.
# These files are the core persistent storage for the conference system.
# Default: '/var/lib/lyskom'
db_dir: {{ (db_dir | default('/var/lib/lyskom')) }}

# --- Connection Limits ---

# Maximum number of simultaneous client connections allowed.
# Controls concurrency; higher values require more system resources.
# Default: 100
max_connections: {{ (max_connections | default(100)) }}

# Maximum number of conference rooms a single user may create.
# Prevents resource exhaustion by individual users.
# Default: 50
max_rooms_per_user: {{ (max_rooms_per_user | default(50)) }}

# Maximum number of messages a user may post per day.
# Helps manage load and prevent spam.
# Default: 500
max_posts_per_day: {{ (max_posts_per_day | default(500)) }}

# --- Access Control ---

# Allow anonymous (unregistered) users to connect and read public conferences.
# Set to 'yes' for open read-only access, 'no' for registered-only.
# Default: False
allow_anonymous: {{ (allow_anonymous | default(False)) | ternary('yes', 'no') }}

# --- TLS/SSL Encryption ---

# Enable TLS encryption for client connections.
# Set to 'yes' to require encrypted connections.
# Default: False
use_tls: {{ (use_tls | default(False)) | ternary('yes', 'no') }}

# Path to the TLS certificate file (PEM format).
# Required if use_tls is true.
# Default: '/etc/lyskom/tls.crt'
tls_cert: {{ (tls_cert | default('/etc/lyskom/tls.crt')) }}

# Path to the TLS private key file (PEM format).
# Required if use_tls is true.
# Default: '/etc/lyskom/tls.key'
tls_key: {{ (tls_key | default('/etc/lyskom/tls.key')) }}

# --- Logging ---

# Verbosity level for server logging.
# Options: debug, info, notice, warning, error, critical, alert, emergency.
# Default: 'info'
log_level: {{ (log_level | default('info')) }}

# Path to the server log file.
# Use 'stdout' to log to standard output instead of a file.
# Default: '/var/log/lyskom/lyskomd.log'
log_file: {{ (log_file | default('/var/log/lyskom/lyskomd.log')) }}

# --- Administration ---

# List of user IDs or usernames with administrative privileges.
# Admins can manage conferences, users, and server configuration.
admins:
{% for admin in (admins | default(['admin'])) %}  {{ admin }}
{% endfor %}

# List of IP addresses or hostnames to block from connecting to the server.
# Useful for banning abusive clients.
blocked_hosts:
{% for host in (blocked_hosts | default([])) %}  {{ host }}
{% endfor %}

# --- Localization & Time ---

# Default language code (ISO 639-1) for new users and system messages.
# Example: 'en', 'sv', 'de'.
# Default: 'en'
lang_default: {{ (lang_default | default('en')) }}

# Default locale for date/time formatting and collation.
# Example: 'en_US.UTF-8', 'sv_SE.UTF-8'.
# Default: 'en_US.UTF-8'
locale_default: {{ (locale_default | default('en_US.UTF-8')) }}

# Server timezone for logs and timestamps.
# Example: 'UTC', 'Europe/Oslo', 'America/New_York'.
# Default: 'UTC'
timezone: {{ (timezone | default('UTC')) }}

# --- Content Limits ---

# Maximum length (in characters) allowed for a single post or text.
# Prevents excessively large entries.
# Default: 100000
max_text_size: {{ (max_text_size | default(100000)) }}

# --- Backup Configuration ---

# Enable automatic database backups after writes.
# Set to 'yes' to activate periodic backup generation.
# Default: True
auto_backup: {{ (auto_backup | default(True)) | ternary('yes', 'no') }}

# Directory where automatic backups are stored.
# Ensure this path exists and is writable by the lyskom user.
# Default: '/var/lib/lyskom/backups'
backup_dir: {{ (backup_dir | default('/var/lib/lyskom/backups')) }}

# Minimum time (in seconds) between automatic backups.
# Prevents excessive I/O during high-load periods.
# Default: 3600
backup_interval: {{ (backup_interval | default(3600)) }}

# --- Email Notifications ---

# List of SMTP servers (host or host:port) for sending email notifications.
# Used for registration confirmations, mentions, etc.
smtp_servers:
{% for smtp in (smtp_servers | default(['localhost'])) %}  {{ smtp }}
{% endfor %}

# Enable or disable email notifications for new messages, mentions, etc.
# Default: True
email_notifications: {{ (email_notifications | default(True)) | ternary('yes', 'no') }}

# Email address used as the sender for system-generated emails.
# Default: 'lyskom-noreply@localhost'
sender_email: {{ (sender_email | default('lyskom-noreply@localhost')) }}

# --- DNS & Networking Helpers ---

# Timeout (in seconds) for DNS lookups during connection handling.
# Helps prevent hanging connections on unresponsive DNS servers.
# Default: 5
dns_timeout: {{ (dns_timeout | default(5)) }}

# Maximum number of DNS lookups per connection attempt.
# Prevents DNS amplification or loop issues.
# Default: 3
max_dns_lookups: {{ (max_dns_lookups | default(3)) }}

# --- Registration Security ---

# Enable rate limiting on new user registrations.
# Prevents automated bulk registration attacks.
# Default: True
rate_limit_registrations: {{ (rate_limit_registrations | default(True)) | ternary('yes', 'no') }}

# Maximum new registrations allowed per IP address per hour.
# Applied only if rate_limit_registrations is enabled.
# Default: 10
max_registrations_per_ip_per_hour: {{ (max_registrations_per_ip_per_hour | default(10)) }}