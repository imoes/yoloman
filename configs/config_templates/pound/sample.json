{
  "http_listen_address": "0.0.0.0",
  "http_listen_port": 80,
  "https_listen_address": "0.0.0.0",
  "https_listen_port": 443,
  "ssl_cert_path": "/etc/pound/ssl/server.pem",
  "ssl_ciphers": "ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384",
