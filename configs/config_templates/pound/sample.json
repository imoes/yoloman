        {
          "address": "10.0.1.11",
          "port": 8080
        }
      ],
      "x_header": 1,
      "session_persistence": 0,
      "dead_threshold": 3
    },
    {
      "name": "api-backend",
      "backends": [
        {
          "address": "10.0.2.20",
          "port": 3000
        }
      ],
      "x_header": 1,
      "session_persistence": 2,
      "dead_threshold": 2
    }
  ]
