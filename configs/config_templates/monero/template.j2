# /etc/monerod.conf — Main configuration file for the Monero daemon (monerod)
#
# This file is parsed line-by-line by monerod.
# Lines starting with '#' are comments.
# This template is self-documenting: every directive is preceded by its
# schema description and uses explicit defaults for safety.
#
# Variables are expected to be defined in Ansible variables (e.g., monero_p2p_port).
# If a variable is undefined, the default specified in the Jinja2 `default()` filter is used.

# Port on which the daemon listens for incoming P2P connections.
p2p-bind-port={{ p2p_port | default(18080) }}

# IP address to bind the P2P interface to. Use '127.0.0.1' to restrict to local only.
p2p-bind-ip={{ p2p_bind_ip | default('0.0.0.0') }}

# Disable Internet Gateway Protocol (NAT-PMP/UPnP) port forwarding. Default is true (disabled).
no-igd={{ p2p_no_igd | default(true) }}

# Port for the JSON-RPC API (used by wallets, explorers, and tools).
rpc-bind-port={{ rpc_port | default(18081) }}

# IP to bind the RPC server to. Keep '127.0.0.1' for local-only access for security.
rpc-bind-ip={{ rpc_bind_ip | default('127.0.0.1') }}

# Authentication credentials in 'username:password' format. Leave empty for no auth.
rpc-login={{ rpc_login | default('') }}

# Restrict RPC to known outputs, incoming transactions, and the wallet daemon.
# Set to true for tighter security.
restrict-rpc={{ rpc_restricted | default(false) }}

# Directory where the blockchain and wallet data are stored.
data-dir={{ data_dir | default('/var/lib/monero') }}

# Path to the log file. If empty or omitted, logs go to stderr.
log-file={{ log_file | default('') }}

# Verbosity level: 0 (none), 1 (info), 2 (debug), 3 (trace). Use '1' for production.
log-level={{ log_level | default(1) }}

# Rate limit for inbound traffic in KB/s. 0 means no limit.
limit-download={{ limit_download | default(0) }}

# Rate limit for outbound traffic in KB/s. 0 means no limit.
limit-upload={{ limit_upload | default(0) }}

# Enable DNSSEC validation for Monero DNS seeds.
# Note: The config key 'dns-secure' is the inverse of the schema 'dnssec_enabled'.
dns-secure={{ not dnssec_enabled | default(false) }}

# Optional list of trusted seed nodes (host:port) for bootstrap.
# Leave empty to use default seeds.
{% if seed_nodes | default([]) | length > 0 %}
seed-node={{ seed_nodes | default([]) | join(',') }}
{% endif %}

# List of trusted daemon nodes to exclusively use for syncing.
{% if exclusive_nodes | default([]) | length > 0 %}
add-exclusive-node={{ exclusive_nodes | default([]) | join(',') }}
{% endif %}

# Additional nodes to try connecting to.
{% if additional_nodes | default([]) | length > 0 %}
add-node={{ additional_nodes | default([]) | join(',') }}
{% endif %}

# Enable blockchain pruning to reduce disk usage.
prune-blockchain={{ pruning_enabled | default(false) }}

# Enable local mining. Requires CPU and significant power.
# Note: The config key 'disable-mining' is the inverse of the schema 'mining_enabled'.
disable-mining={{ not mining_enabled | default(false) }}

# Number of mining threads. 0 = auto-detect.
miner-threads={{ mining_threads | default(0) }}

# Monero address to receive mined rewards. Required if mining is enabled.
miner-address={{ mining_address | default('') }}

# Allow background mining when system is idle.
background-mining-enabled={{ background_mining_enabled | default(false) }}

# Enable local network peer discovery (LAN).
local-peer-discovery={{ local_peer_discovery_enabled | default(true) }}

# Enable UPnP port mapping. Use with caution.
upnp={{ upnp_enabled | default(false) }}

# RPC timeout in milliseconds (e.g., 30000 = 30s).
rpc-timeout={{ rpc_timeout | default(30000) }}

# Override minimum fee (e.g., '0.00001' XMR per KB).
fee-override={{ fee_override | default('') }}

# URL of a Monero blockchain snapshot for fast initial sync.
sync-from-snapshot-url={{ sync_snapshot_url | default('') }}

# Enable ZeroMQ for real-time pub/sub of blocks/transactions.
enable-zmq={{ zmq_enabled | default(false) }}

# ZMQ address to publish raw transactions.
zmq-pub-tx-address={{ zmq_pub_tx_addr | default('tcp://127.0.0.1:18083') }}

# ZMQ address to publish new blocks in JSON format.
zmq-pub-block-address={{ zmq_pub_block_addr | default('tcp://127.0.0.1:18084') }}

# ZMQ address to publish raw (binary) blocks.
zmq-pub-raw-block-address={{ zmq_pub_raw_block_addr | default('tcp://127.0.0.1:18085') }}

# Unparsed additional configuration lines to append verbatim.
{% for extra_line in extra_lines | default([]) %}{{ extra_line }}
{% endfor %}