[Settings]
# The default layout mode for the viewer (e.g., single, grid, presenter).
default_layout={{ default_layout | default('single') }}

# Background color in hex format (ARGB) for normal view.
background_color={{ background_color | default('0xDF202020') }}

# Background color in hex format (ARGB) for fullscreen mode.
background_color_fullscreen={{ background_color_fullscreen | default('0xFF000000') }}

# Color shown for pages that have not yet been rendered.
unrendered_page_color={{ unrendered_page_color | default('0x40FFFFFF') }}

# Mouse button index to use for clicking links (1=Left, 2=Middle, 3=Right).
click_link_button={{ click_link_button | default('1') }}

# Mouse button index to use for dragging/panning the view.
drag_view_button={{ drag_view_button | default('2') }}

# Mouse button index to use for selecting text.
select_text_button={{ select_text_button | default('1') }}

# Time in milliseconds to wait before hiding the mouse cursor.
hide_mouse_timeout={{ hide_mouse_timeout | default('2000') }}

# The delta value for smooth scrolling operations.
smooth_scroll_delta={{ smooth_scroll_delta | default('30') }}

# Fraction of the screen height to scroll when using screen scroll commands.
screen_scroll_factor={{ screen_scroll_factor | default('0.9') }}

# Padding fraction applied around the target position when jumping.
jump_padding={{ jump_padding | default('0.2') }}

# Margin in pixels around rectangular selections or annotations.
rect_margin={{ rect_margin | default('2') }}

# Gap size in pixels between layout elements (e.g., in grid mode).
useless_gap={{ useless_gap | default('2') }}

# Minimum zoom level allowed.
min_zoom={{ min_zoom | default('-14') }}

# Maximum zoom level allowed.
max_zoom={{ max_zoom | default('30') }}

# Step size for zoom in/out operations.
zoom_factor={{ zoom_factor | default('0.05') }}

# Minimum page width in pixels for layout calculations.
min_page_width={{ min_page_width | default('50') }}

# Aspect ratio or proportion used for presenter mode layouts.
presenter_slide_ratio={{ presenter_slide_ratio | default('0.67') }}

# Whether to quit immediately if initialization fails.
quit_on_init_fail={{ quit_on_init_fail | default('false') }}

# If true, enforce a single instance window per file.
single_instance_per_file={{ single_instance_per_file | default('false') }}

# Path to an optional CSS stylesheet for customization. Empty string for none.
stylesheet={{ stylesheet | default('') }}

# Format string for the page counter overlay (%1=current, %2=total).
page_overlay_text={{ page_overlay_text | default('Page %1/%2') }}

# Name of the icon theme to use for UI elements. Empty for default.
icon_theme={{ icon_theme | default('') }}

# Number of adjacent pages to prefetch/render in advance.
prefetch_count={{ prefetch_count | default('4') }}

# Contrast adjustment factor for inverted color mode.
inverted_color_contrast={{ inverted_color_contrast | default('0.5') }}

# Brightening factor applied to colors in inverted mode.
inverted_color_brightening={{ inverted_color_brightening | default('0.15') }}

# Delta value reported by mouse wheel events.
mouse_wheel_factor={{ mouse_wheel_factor | default('120') }}

# Enable filtering/optimization for thumbnail generation.
thumbnail_filter={{ thumbnail_filter | default('true') }}

# Width/height in pixels for generated thumbnails.
thumbnail_size={{ thumbnail_size | default('32') }}

[Keys]
# Keybinding for page up.
page_up={{ key_page_up | default('PgUp') }}

# Keybinding for page down.
page_down={{ key_page_down | default('PgDown') }}

# Keybinding for going to the top of the document.
top={{ key_top | default('Home, G') }}

# Keybinding for going to the bottom of the document.
bottom={{ key_bottom | default('End, Shift+G') }}

# Keybinding for jumping to a specific page number.
goto_page={{ key_goto_page | default('Ctrl+G') }}

# Keybinding for scrolling half screen up.
half_screen_up={{ key_half_screen_up | default('Ctrl+U') }}

# Keybinding for scrolling half screen down.
half_screen_down={{ key_half_screen_down | default('Ctrl+D') }}

# Keybinding for scrolling one screen up.
screen_up={{ key_screen_up | default('Backspace, Ctrl+B') }}

# Keybinding for scrolling one screen down.
screen_down={{ key_screen_down | default('Space, Ctrl+F') }}

# Keybinding for smooth scrolling up.
smooth_up={{ key_smooth_up | default('Up, K') }}

# Keybinding for smooth scrolling down.
smooth_down={{ key_smooth_down | default('Down, J') }}

# Keybinding for smooth scrolling left.
smooth_left={{ key_smooth_left | default('Left, H') }}

# Keybinding for smooth scrolling right.
smooth_right={{ key_smooth_right | default('Right, L') }}

# Keybinding to start forward search.
search={{ key_search | default('/') }}

# Keybinding to start backward search.
search_backward={{ key_search_backward | default('?') }}

# Keybinding for finding the next search hit.
next_hit={{ key_next_hit | default('N') }}

# Keybinding for finding the previous search hit.
previous_hit={{ key_previous_hit | default('Shift+N') }}

# Keybinding for finding the next invisible hit.
next_invisible_hit={{ key_next_invisible_hit | default('Ctrl+N') }}

# Keybinding for finding the previous invisible hit.
previous_invisible_hit={{ key_previous_invisible_hit | default('Ctrl+Shift+N') }}

# Keybinding for jumping back in navigation history.
jump_back={{ key_jump_back | default('Ctrl+O, Alt+Left') }}

# Keybinding for jumping forward in navigation history.
jump_forward={{ key_jump_forward | default('Ctrl+I, Alt+Right') }}

# Keybinding for marking or jumping to a marked location.
mark_jump={{ key_mark_jump | default('M') }}

# Keybinding to set single layout mode.
set_single_layout={{ key_set_single_layout | default('1') }}

# Keybinding to set grid layout mode.
set_grid_layout={{ key_set_grid_layout | default('2') }}

# Keybinding to set presenter layout mode.
set_presenter_layout={{ key_set_presenter_layout | default('3') }}

# Keybinding for zooming in.
zoom_in={{ key_zoom_in | default('", +') }}

# Keybinding for zooming out.
zoom_out={{ key_zoom_out | default('-') }}

# Keybinding for resetting zoom level.
reset_zoom={{ key_reset_zoom | default('Z') }}

# Keybinding to increase the number of columns in grid view.
increase_columns={{ key_increase_columns | default(']') }}

# Keybinding to decrease the number of columns in grid view.
decrease_columns={{ key_decrease_columns | default('[') }}

# Keybinding to increase the offset/position in grid view.
increase_offset={{ key_increase_offset | default('}') }}

# Keybinding to decrease the offset/position in grid view.
decrease_offset={{ key_decrease_offset | default('{') }}

# Keybinding to rotate the page left.
rotate_left={{ key_rotate_left | default('","') }}

# Keybinding to rotate the page right.
rotate_right={{ key_rotate_right | default('.') }}

# Keybinding to toggle the overlay (page counter/status).
toggle_overlay={{ key_toggle_overlay | default('T') }}

# Keybinding to quit the application.
quit={{ key_quit | default('Q, "W,E,E,E"') }}

# Keybinding to close the search bar.
close_search={{ key_close_search | default('Esc') }}

# Keybinding to toggle inverted colors.
invert_colors={{ key_invert_colors | default('I') }}

# Keybinding to copy selected text to clipboard.
copy_to_clipboard={{ key_copy_to_clipboard | default('Ctrl+C') }}

# Keybinding to swap the roles of selection and panning buttons.
swap_selection_and_panning_buttons={{ key_swap_selection_and_panning_buttons | default('V') }}

# Keybinding to toggle fullscreen mode.
toggle_fullscreen={{ key_toggle_fullscreen | default('F') }}

# Keybinding to reload the current document.
reload={{ key_reload | default('R') }}

# Keybinding to open a new file.
open={{ key_open | default('O') }}

# Keybinding to save current state or document.
save={{ key_save | default('S') }}

# Keybinding to toggle the table of contents view.
toggle_toc={{ key_toggle_toc | default('F9') }}

# Keybinding to freeze the current presentation slide.
freeze_presentation={{ key_freeze_presentation | default('X') }}
