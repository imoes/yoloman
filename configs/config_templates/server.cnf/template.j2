[mysqld]
# Base server configuration for MariaDB
# This section defines the core MariaDB server behavior

# Set the base directory for data and installations
{% if base_dir is defined %}basedir = {{ base_dir }}{% endif %}

# Set the data directory where databases and tables are stored
data_dir = {{ data_dir }}

# Character set and collation for server-wide defaults
{% if character_set_server is defined %}character-set-server = {{ character_set_server }}{% endif %}
{% if collation_server is defined %}collation-server = {{ collation_server }}{% endif %}

# TCP/IP networking and socket configuration
{% if port is defined %}port = {{ port }}{% endif %}
{% if socket is defined %}socket = {{ socket }}{% endif %}

# Bind address — leave commented to listen on all interfaces, or specify an IP
{% if bind_address is defined %}# bind-address = {{ bind_address }}{% endif %}

# Maximum simultaneous connections allowed
{% if max_connections is defined %}max_connections = {{ max_connections }}{% endif %}

# Thread cache size — number of threads to keep cached for reuse
{% if thread_cache_size is defined %}thread_cache_size = {{ thread_cache_size }}{% endif %}

# InnoDB settings
{% if innodb_buffer_pool_size is defined %}innodb_buffer_pool_size = {{ innodb_buffer_pool_size }}{% endif %}
{% if innodb_log_file_size is defined %}innodb_log_file_size = {{ innodb_log_file_size }}{% endif %}
{% if innodb_log_buffer_size is defined %}innodb_log_buffer_size = {{ innodb_log_buffer_size }}{% endif %}
{% if innodb_flush_log_at_trx_commit is defined %}innodb_flush_log_at_trx_commit = {{ innodb_flush_log_at_trx_commit }}{% endif %}
{% if innodb_file_per_table is defined %}innodb_file_per_table = {{ innodb_file_per_table | int | string | lower }}{% endif %}
{% if innodb_flush_method is defined %}innodb_flush_method = {{ innodb_flush_method }}{% endif %}

# Query cache (deprecated in newer MariaDB; controlled via variable existence)
{% if query_cache_type is defined %}query_cache_type = {{ query_cache_type }}{% endif %}
{% if query_cache_size is defined %}query_cache_size = {{ query_cache_size }}{% endif %}

# Logging configuration
{% if log_error is defined %}log_error = {{ log_error }}{% endif %}
{% if general_log is defined %}general_log = {{ general_log | int | string | lower }}{% endif %}
{% if general_log_file is defined %}general_log_file = {{ general_log_file }}{% endif %}
{% if slow_query_log is defined %}slow_query_log = {{ slow_query_log | int | string | lower }}{% endif %}
{% if slow_query_log_file is defined %}slow_query_log_file = {{ slow_query_log_file }}{% endif %}
{% if long_query_time is defined %}long_query_time = {{ long_query_time }}{% endif %}

# Binary logging (required for replication and point-in-time recovery)
{% if log_bin is defined %}log_bin = {{ log_bin }}{% endif %}
{% if expire_logs_days is defined %}expire_logs_days = {{ expire_logs_days }}{% endif %}
{% if max_binlog_size is defined %}max_binlog_size = {{ max_binlog_size }}{% endif %}

# Replication — primary (master) settings
{% if server_id is defined %}server_id = {{ server_id }}{% endif %}
{% if binlog_format is defined %}binlog_format = {{ binlog_format }}{% endif %}

# Replication — replica (slave) settings
{% for replica in replication_replicas %}
# Replica: {{ replica.name }}
{% if replica.server_id is defined %}server_id = {{ replica.server_id }}{% endif %}
{% if replica.host is defined %}report_host = {{ replica.host }}{% endif %}
{% if replica.port is defined %}report_port = {{ replica.port }}{% endif %}
{% endfor %}

# TLS/SSL configuration
{% if ssl_key is defined %}ssl_key = {{ ssl_key }}{% endif %}
{% if ssl_cert is defined %}ssl_cert = {{ ssl_cert }}{% endif %}
{% if ssl_ca is defined %}ssl_ca = {{ ssl_ca }}{% endif %}
{% if ssl_cipher is defined %}ssl_cipher = {{ ssl_cipher }}{% endif %}

# Optional per-thread memory buffers
{% if sort_buffer_size is defined %}sort_buffer_size = {{ sort_buffer_size }}{% endif %}
{% if join_buffer_size is defined %}join_buffer_size = {{ join_buffer_size }}{% endif %}
{% if read_buffer_size is defined %}read_buffer_size = {{ read_buffer_size }}{% endif %}
{% if read_rnd_buffer_size is defined %}read_rnd_buffer_size = {{ read_rnd_buffer_size }}{% endif %}

# Optional table open cache
{% if table_open_cache is defined %}table_open_cache = {{ table_open_cache }}{% endif %}
{% if table_definition_cache is defined %}table_definition_cache = {{ table_definition_cache }}{% endif %}

# Optional temporary directory
{% if tmpdir is defined %}tmpdir = {{ tmpdir }}{% endif %}
