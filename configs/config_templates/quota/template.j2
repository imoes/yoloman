#! /bin/sh

# check if quota package is available
test -x {{ warnquota_path }} || exit 0

# check if warnquota run is configured
test -f {{ default_quota_file }} || exit 0
. {{ default_quota_file }}

if [ "${run_warnquota}" = "true" ]; then
	# check if quotas are enabled
	if grep -q '^[^#]*quota' {{ fstab_path }}; then
        	{{ warnquota_command }} -ug
	fi	
fi

exit 0