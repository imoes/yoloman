# /etc/exports: NFS server export definitions
# Each line exports a directory to specified clients with given options.
# Syntax: <path> <client>[options] ...\n# Use 'ro' for read-only, 'rw' for read-write access.
# 'sync' ensures writes are committed to disk before reply; 'no_root_squash' allows root access on client.
{% for export in exports %}{{ export.path }} {{ export.client }}{% if export.options %}({{ export.options | join(', ') }}){% endif %}{% endfor %}