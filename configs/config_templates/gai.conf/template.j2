# /etc/gai.conf - configuration file for getaddrinfo() behavior
# Priority and label mappings for IPv4/IPv6 address selection per RFC 6724
# Each line defines a prefix, its label, and optionally its precedence

# Default precedence values (RFC 6724 § 4)
precedence  ::1/128       50
precedence  2002::/16     30
precedence  ::/0          10

# Default label values (RFC 6724 § 4)
label       ::1/128       1
label       2002::/16     2
label       ::/0          100

# Optional: Override label for specific IPv4-mapped or IPv6 addresses
{% for item in label_overrides %}label       {{ item.prefix }}      {{ item.label }}{% endfor %}

# Optional: Override precedence for specific prefixes
{% for item in precedence_overrides %}precedence  {{ item.prefix }}      {{ item.precedence }}{% endfor %}