{
  "debug": false,
  "verbose": false,
  "log_dir": "/var/log/octavia",
  "log_file": "amphora-agent.log",
  "amphora_id": "8b4e7c9d-6a3f-4e8b-b90c-123456789abc",
  "amphora_name": "amphora-01",
  "worker_count": 4,
  "max_connections": 16384,
  "max_concurrent_connections_per_listener": 200,
  "heartbeat_interval": 5,
  "status_update_interval": 30,
  "amp_driver": "haproxy",
  "amp_network_driver": "neutron",
  "use_tls": true,
  "ca_cert": "/etc/octavia/certs/ca_01.pem",
  "client_cert": "/etc/octavia/certs/client.pem",
  "client_key": "/etc/octavia/certs/client.key",
  "api_endpoints": [
    "https://192.0.2.10:9876",
    "https://192.0.2.11:9876"
  ],
  "verify_server_cert": true,
  "security_group_enabled": true,
  "security_group_id": "sg-12345678",
  "metadata_proxy_enabled": true,
  "metadata_proxy_host": "127.0.0.1",
  "metadata_proxy_port": 8775,
  "metadata_auth_cache": 300,
  "base_config_path": "/var/lib/octavia",
  "base_runtime_path": "/var/lib/octavia/runtime",
  "use_systemd": true,
  "command_timeout": 30,
  "stats_socket": "/var/lib/octavia/haproxy.stats",
  "stats_timeout": 10,
  "use_namespaces": true,
  "namespace_prefix": "octavia-",
  "systemd_enabled": true,
  "keepalived_conf_dir": "/etc/keepalived",
  "vrrp_sync_group": "VG_1",
  "vrrp_advert_int": 1,
  "vrrp_priority": 100,
  "vrrp_low_priority": 50,
  "vrrp_garp_master_deliver": 0,
  "lvs_sync_daemon_interface": "eth1",
  "health_bind_host": "127.0.0.1",
  "health_bind_port": 5555,
  "heartbeat_receiver_threads": 2,
  "health_check_interval": 2,
  "health_check_timeout": 1,
  "max_retries": 3,
  "min_retry_interval": 2
}
