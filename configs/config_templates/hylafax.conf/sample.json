{
  "spool_dir": "/var/spool/hylafax",
  "config_dir": "/etc/hylafax",
  "log_dir": "/var/log/hylafax",
  "var_dir": "/var",
  "system_id": "NYOfficeFax",
  "country_code": 1,
  "area_code": "212",
  "fax_number": "+12125551234",
  "time_zone": "US/Eastern",
  "modems": [
    {
      "device": "/dev/ttyS0",
      "speed": 115200
    },
    {
      "device": "/dev/ttyS1",
      "speed": 115200
    }
  ],
  "receive_threads": 2,
  "send_threads": 3,
  "max_msg_size": 20480,
  "caller_id": true,
  "t30_auto_negotiate": true,
  "t30_parameters": "Class:2.0,Modem:V.27ter,V.29,V.34,Rate:14400,EC:MMR,Compression:True",
  "pagers": [
    {
      "destination": "fax-receive@nyoffice.local",
      "timeout": 20
    },
    {
      "destination": "http://alert.local/hylafax",
      "timeout": 10
    }
  ],
  "access_rules": [
    {
      "action": "allow",
      "network": "127.0.0.0/8"
    },
    {
      "action": "allow",
      "network": "10.0.0.0/8"
    },
    {
      "action": "deny",
      "network": "0.0.0.0/0"
    }
  ],
  "admin_util": "/usr/sbin/faxadmin",
  "sendmail": "/usr/sbin/sendmail.postfix",
  "verbose_logging": false,
  "page_size": "letter",
  "resolution": "196x196",
  "max_retries": 4,
  "retry_time": 10,
  "compression": true,
  "page_margin": 12,
  "t38_enable": false,
  "t38_udp_port": 4455,
  "dialout_enable": true,
  "auto_answer": true,
  "answer_delay": 5
}
