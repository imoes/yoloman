# ==============================================================================
# qweborf Configuration Template
# ==============================================================================
# This file is auto-generated by Ansible. Do not edit manually.
# Each directive is preceded by a comment derived from the schema description,
# making this configuration self-documenting and safe to reuse in an Ansible role.
# ==============================================================================

# IP address and port the server will bind to (e.g., '127.0.0.1:8080').
listen = {{ bind_address | default('0.0.0.0:8080') }}

# Absolute filesystem path to the directory containing files to serve.
root = {{ root_path | default('/var/www/html') }}

# Maximum number of simultaneous client connections allowed.
max_connections = {{ max_connections | default(1024) }}

# If true, display a directory index when accessing a directory; if false, return 404.
directory_listing = {{ directory_listing | default(true) | lower }}

# List of filenames to serve automatically when a directory is requested.
index_files = {{ index_files | default(['index.html', 'index.htm']) | join(', ') }}

# If true, enable HTTPS using the provided certificate and key.
ssl_enabled = {{ ssl_enabled | default(false) | lower }}

# Path to the SSL certificate file (required if ssl_enabled is true).
ssl_cert = {{ ssl_cert_path | default('/etc/ssl/certs/qweborf.crt') }}

# Path to the SSL private key file (required if ssl_enabled is true).
ssl_key = {{ ssl_key_path | default('/etc/ssl/private/qweborf.key') }}

# Map of file extensions to custom MIME types (e.g., { 'webm': 'video/webm' }).
# Rendered as 'mime_<ext> = <type>' per entry.
{% for item in mime_mappings | default({}) | dict2items %}
mime_{{ item.key }} = {{ item.value }}
{% endfor %}

# Map of HTTP header names (e.g., 'X-Frame-Options') to values (e.g., 'SAMEORIGIN').
# Rendered as 'header_<name> = <value>' per entry, with dots/hyphens normalized.
{% for item in custom_headers | default({}) | dict2items %}
header_{{ item.key | replace('.', '_') | replace('-', '_') }} = {{ item.value }}
{% endfor %}

# List of access control rules, in order. Each rule specifies an action ('allow' or 'deny')
# and an IP or CIDR range. Rendered as 'access_<action> = <entity>'.
{% for rule in access_rules | default([]) %}
access_{{ rule.action }} = {{ rule.entity }}
{% endfor %}

# If true, log to standard output; otherwise, log to the specified log file.
log_stdout = {{ log_stdout | default(true) | lower }}

# Path to the log file (only used if log_stdout is false).
log_file = {{ log_file_path | default('/var/log/qweborf/qweborf.log') }}

# Minimum severity level for logged messages.
log_level = {{ log_level | default('info') }}

# Time-to-live in seconds for caching static files (0 disables caching).
cache_ttl = {{ cache_ttl | default(3600) }}

# If true, compress text-based responses using gzip or brotli where supported by the client.
compression = {{ compression | default(true) | lower }}