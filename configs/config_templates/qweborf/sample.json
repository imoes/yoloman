{
 "access_rules": [
  {
   "action": "deny",
   "entity": "10.0.0.0/8"
  },
  {
   "action": "allow",
   "entity": "0.0.0.0/0"
  }
 ],
 "bind_address": "0.0.0.0:80",
 "cache_ttl": 1800,
 "compression": true,
 "custom_headers": {
  "X-Content-Type-Options": "nosniff",
  "X-Frame-Options": "DENY"
 },
 "directory_listing": true,
 "index_files": [
  "index.html",
  "index.htm",
  "default.html"
 ],
 "log_file_path": "/var/log/qweborf/access.log",
 "log_level": "warn",
 "log_stdout": true,
 "max_connections": 256,
 "mime_mappings": {
  "webp": "image/webp",
  "woff2": "font/woff2"
 },
 "root_path": "/srv/http/public",
 "ssl_cert_path": "/etc/ssl/certs/qweborf.crt",
 "ssl_enabled": false,
 "ssl_key_path": "/etc/ssl/private/qweborf.key"
}
