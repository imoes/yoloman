{
  "bind_address": "0.0.0.0:80",
  "root_path": "/srv/http/public",
  "max_connections": 256,
  "directory_listing": true,
  "index_files": [
    "index.html",
    "index.htm",
    "default.html"
  ],
  "ssl_enabled": false,
  "ssl_cert_path": "/etc/ssl/certs/qweborf.crt",
  "ssl_key_path": "/etc/ssl/private/qweborf.key",
  "mime_mappings": {
    "woff2": "font/woff2",
    "webp": "image/webp"
  },
  "custom_headers": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "access_rules": [
    {
      "action": "deny",
      "entity": "10.0.0.0/8"
    },
    {
      "action": "allow",
      "entity": "0.0.0.0/0"
    }
  ],
  "log_stdout": true,
  "log_file_path": "/var/log/qweborf/access.log",
  "log_level": "warn",
  "cache_ttl": 1800,
  "compression": true
}
