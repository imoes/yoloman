# =============================================================================
# systemd-logind Configuration Template
# =============================================================================
# This template generates /etc/systemd/logind.conf (or drop-ins).
# All variables must be provided via Ansible inventory/vars with sensible defaults
# matching the systemd-logind(8) man page.
# =============================================================================

[Login]

# Number of virtual terminals automatically activated on boot (0 = disable)
# Schema default: 6
NAutoVTs={{ n_auto_vts | default(6) }}

# VT number kept reserved for the display manager even when it is not running
# Schema default: 6
ReserveVT={{ reserve_vt | default(6) }}

# Terminate all processes of a user when their last session exits
# Schema default: false
KillUserProcesses={{ 'yes' if kill_user_processes | default(false) else 'no' }}

# If non-empty, only these usernames are subject to process-killing on logout;
# empty implies all users (minus KillExcludeUsers).
# Schema default: []
{% if kill_only_users | default([]) | length > 0 %}
# Restrict process-killing to this whitelist of users (space-separated)
KillOnlyUsers={{ kill_only_users | default([]) | join(' ') }}
{% endif %}

# Users whose processes are never killed on logout regardless of KillUserProcesses
# Schema default: ['root']
KillExcludeUsers={{ kill_exclude_users | default(['root']) | join(' ') }}

# Maximum seconds logind waits for inhibitor locks to be released before
# proceeding with sleep or shutdown
# Schema default: 5
InhibitDelayMaxSec={{ inhibit_delay_max_sec | default(5) }}

# Seconds to wait before stopping the user's systemd instance after all
# their sessions have ended
# Schema default: 10
UserStopDelaySec={{ user_stop_delay_sec | default(10) }}

# Action on a short power-button press: ignore, poweroff, reboot, halt,
# kexec, suspend, hibernate, hybrid-sleep, suspend-then-hibernate, lock
# Schema default: 'poweroff'
HandlePowerKey={{ handle_power_key | default('poweroff') }}

# Action on a long power-button press (same choices as handle_power_key)
# Schema default: 'ignore'
HandlePowerKeyLongPress={{ handle_power_key_long_press | default('ignore') }}

# Action on reboot-key press (same choices as handle_power_key)
# Schema default: 'reboot'
HandleRebootKey={{ handle_reboot_key | default('reboot') }}

# Action on long reboot-key press (same choices as handle_power_key)
# Schema default: 'poweroff'
HandleRebootKeyLongPress={{ handle_reboot_key_long_press | default('poweroff') }}

# Action on suspend-key press (same choices as handle_power_key)
# Schema default: 'suspend'
HandleSuspendKey={{ handle_suspend_key | default('suspend') }}

# Action on long suspend-key press (same choices as handle_power_key)
# Schema default: 'hibernate'
HandleSuspendKeyLongPress={{ handle_suspend_key_long_press | default('hibernate') }}

# Action on hibernate-key press (same choices as handle_power_key)
# Schema default: 'hibernate'
HandleHibernateKey={{ handle_hibernate_key | default('hibernate') }}

# Action on long hibernate-key press (same choices as handle_power_key)
# Schema default: 'ignore'
HandleHibernateKeyLongPress={{ handle_hibernate_key_long_press | default('ignore') }}

# Action when the laptop lid is closed while on battery power
# Schema default: 'suspend'
HandleLidSwitch={{ handle_lid_switch | default('suspend') }}

# Action when the lid is closed while on AC/external power
# Schema default: 'suspend'
HandleLidSwitchExternalPower={{ handle_lid_switch_external_power | default('suspend') }}

# Action when the lid is closed with a docking station or second display connected
# Schema default: 'ignore'
HandleLidSwitchDocked={{ handle_lid_switch_docked | default('ignore') }}

# When true, lid-switch actions proceed even if inhibitor locks are held
# Schema default: true
LidSwitchIgnoreInhibited={{ 'yes' if lid_switch_ignore_inhibited | default(true) else 'no' }}

# Inactivity duration before IdleAction is triggered; accepts systemd time
# suffixes: s, min, h
# Schema default: '30min'
IdleActionSec={{ idle_action_sec | default('30min') }}

# Action taken after IdleActionSec of inactivity (same choices as handle_power_key)
# Schema default: 'ignore'
IdleAction={{ idle_action | default('ignore') }}

# Maximum size of each user's /run/user/<uid> tmpfs; accepts a percentage of
# RAM (e.g. 10%), plain bytes, or a suffix K/M/G
# Schema default: '10%'
RuntimeDirectorySize={{ runtime_directory_size | default('10%') }}

# Maximum inode count for /run/user/<uid>; leave empty to let systemd derive
# it from RuntimeDirectorySize
# Schema default: ''
{% if runtime_directory_inodes_max | default('') | trim != '' %}
# Maximum inode count for /run/user/<uid>; derived from RuntimeDirectorySize when unset
RuntimeDirectoryInodesMax={{ runtime_directory_inodes_max | default('') }}
{% endif %}

# Remove POSIX IPC objects (shared memory segments, semaphores, message queues)
# owned by a user when their last session ends
# Schema default: true
RemoveIPC={{ 'yes' if remove_ipc | default(true) else 'no' }}

# Maximum number of concurrent systemd-inhibit locks accepted system-wide
# Schema default: 8192
InhibitorsMax={{ inhibitors_max | default(8192) }}

# Maximum number of concurrent user sessions logind will manage
# Schema default: 8192
SessionsMax={{ sessions_max | default(8192) }}

# Forcibly terminate sessions that have been idle for this duration; set to
# infinity to never auto-terminate
# Schema default: 'infinity'
StopIdleSessionSec={{ stop_idle_session_sec | default('infinity') }}