# Stealth configuration policy file
# Auto-generated by Ansible Jinja2 template

# --- Global Defaults ---

# Base directory from where stealth operates
USE BASE {{ base_dir | default('/var/lib/stealth') }}

# Email address to receive integrity scan reports
USE EMAIL {{ email_address | default('root') }}

# Path to the mailer program
USE MAILER {{ mailer_path | default('/usr/bin/mail') }}

# Arguments passed to the mailer program
USE MAILARGS {{ mail_args | default('-s "STEALTH scan report"') }}

# Name of the report file relative to BASE
USE REPORT {{ report_file | default('report') }}

# SSH command specification for connecting to the client
USE SSH {{ ssh_command | default('root@localhost -T -q') }}

# Path to the diff utility
USE DIFF {{ diff_path | default('/usr/bin/diff') }}

# Path to the dd utility
USE DD {{ dd_path | default('/bin/dd') }}

# If true, defines FINDARGS for SUID/SGID executable checks
{% if check_suid_executable | default(False) %}
DEFINE FINDARGS -xdev -perm /6111 -type f -exec
{% endif %}

# --- Integrity Checks ---

# List of integrity checks to perform
{% for check in checks | default([]) %}
    {% if check.label %}
# Label: {{ check.label }}
LABEL {{ check.label | replace('\n', '\n') }}
    {% endif %}

    {% if check.type == 'remote' %}
# Remote integrity check with optional logging
CHECK {% if check.log %}LOG = {% endif %}{{ check.log_path | default('') }} {% if check.path_offset %}{{ check.path_offset }} {% endif %}{{ check.command }}

    {% elif check.type == 'remote_notest' %}
# Remote integrity check without test execution
NOTEST CHECK {% if check.log %}LOG = {% endif %}{{ check.log_path | default('') }} {% if check.path_offset %}{{ check.path_offset }} {% endif %}{{ check.command }}

    {% elif check.type == 'local' %}
# Local integrity check
LOCAL {{ check.command }}

    {% elif check.type == 'local_notest' %}
# Local integrity check without test execution
LOCAL NOTEST {{ check.command }}

    {% elif check.type == 'local_check' %}
# Local integrity check with logging
LOCAL CHECK {% if check.log %}LOG = {% endif %}{{ check.log_path | default('') }} {% if check.path_offset %}{{ check.path_offset }} {% endif %}{{ check.command }}

    {% elif check.type == 'local_check_notest' %}
# Local integrity check with logging and no test execution
LOCAL NOTEST CHECK {{ check.log_path | default('') }} {% if check.path_offset %}{{ check.path_offset }} {% endif %}{{ check.command }}

    {% elif check.type == 'get' %}
# Get file from client to local
GET {{ check.client_path }} {{ check.local_path }}

    {% elif check.type == 'get_notest' %}
# Get file from client to local without test
GET NOTEST {{ check.client_path }} {{ check.local_path }}

    {% elif check.type == 'put' %}
# Put file from local to client
PUT {{ check.local_path }} {{ check.remote_path }}

    {% elif check.type == 'put_notest' %}
# Put file from local to client without test
PUT NOTEST {{ check.local_path }} {{ check.remote_path }}
    {% endif %}
{% endfor %}

##

# --- Daemon and Operational Options ---

# If true, enables daemon mode options in the second section
{% if daemon_mode | default(False) %}
# Daemon mode configuration
daemon {{ uds_path | default('/var/run/stealth.uds') }}
{% endif %}

# Interval in seconds (or 'm' for minutes) between scans in daemon mode
{% if repeat_interval | default('') %}
repeat {{ repeat_interval }}
{% endif %}

# Random interval to add to repeat interval in daemon mode
{% if random_interval | default('') %}
random-interval {{ random_interval }}
{% endif %}

# File path to append log messages
{% if log_file | default('') %}
log {{ log_file }}
{% endif %}

# If true, writes messages to syslog
{% if syslog | default(False) %}
syslog
{% endif %}

# Syslog facility to use (e.g., DAEMON, LOCAL0)
{% if syslog_facility | default('') %}
syslog-facility {{ syslog_facility }}
{% endif %}

# Syslog priority to use (e.g., NOTICE, INFO)
{% if syslog_priority | default('') %}
syslog-priority {{ syslog_priority }}
{% endif %}

# Syslog tag prefix for messages
{% if syslog_tag | default('') %}
syslog-tag {{ syslog_tag }}
{% endif %}

# Verbosity level (0-3)
{% if verbosity is defined and verbosity | default('1') != '' %}
verbosity {{ verbosity | default('1') }}
{% endif %}

# Maximum size for files retrieved by GET commands (e.g., 10M, 1G)
{% if max_size | default('') %}
max-size {{ max_size }}
{% endif %}

# List of absolute file paths to skip integrity monitoring
# Note: If skip_files_list is populated, skip_files_path must be set to the path where the list is stored
{% if skip_files_list | default([]) | length > 0 %}
skip-files {{ skip_files_path | default('') }}
{% endif %}

# Timestamp format: 'UTC' or 'LT' (Local Time)
{% if time_stamp | default('UTC') %}
time-stamp {{ time_stamp | default('UTC') }}
{% endif %}