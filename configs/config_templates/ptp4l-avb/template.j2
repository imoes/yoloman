# ptp4l.conf — PTPv2 AVB profile configuration for linuxptp
# Enable hardware timestamping for low-latency AVB applications
[global]
# Use hardware timestamping for precise timing (required for AVB)
hw_timestamping on
# Select the AVB profile (IEEE 1722.1 / AVB profile)
# Must match the AVB profile used by the network
profile_id 0x001b
# Set the priority1 field for the Best Master Clock Algorithm (BMCA)
# Lower value = higher priority (0–14); 2 is typical for AVB boundary clocks
priority1 2
# Set the priority2 field for tie-breaking in BMCA
priority2 6
# Clock class: 0–127; for AVB, typically 248 (boundary clock) or 254 (OC/BC)
clock_class 248
# Offset from primary time source (in log2 microseconds); 0 = synced to grandmaster
# Set to 0 for AVB boundary clocks; adjust only for known offsets
offset_from_master 0
# Mean path delay (in microseconds); auto-detected if 0, but explicit value improves convergence
path_delay 0
# Number of failed Sync messages before declaring master out-of-sync
master_acceptable 2
# Enable slave-only mode (for endpoint AVB devices like audio interfaces)
# Set to 'on' for endpoints that should never act as master
slave_only off
# Clock accuracy: 0x21 = ±25 ns typical for AVB hardware
accuracy 0x21
# Set the time source: 0x80 = atomic clock, 0x10 = GPS, etc.
time_source 0x10
# Domain number: AVB typically uses domain 0
domain_number 0
# SDO_ID: unique identifier for the PTP domain (0–65535)
sdo_id 0
# Announce interval: -3 → 125 ms; -2 → 250 ms; -1 → 500 ms; 0 → 1 s (AVB default)
announce_interval 0
# Sync interval: -4 → 6.25 ms; -3 → 12.5 ms; -2 → 25 ms; -1 → 50 ms (AVB typical)
sync_interval -2
# Delay request interval: -3 → 12.5 ms; -2 → 25 ms (AVB typical)
delayreq_interval -2
# Initial log2 interval for parent time mismatch reporting
# 0 → 1 s, -1 → 500 ms; keep at -1 or 0 for AVB
ptp_dst_mac 01:80:C2:00:00:0E
# Allow multiple interfaces; list interfaces below
network_transport L2
# Transport-specific: L2 (Ethernet) for AVB
transport_specific 0x0
# Set the message interval for follow-up and PDelayResp (optional)
# follow_up_interval -3
# pdelay_resp_interval -3

# Interface configuration section
# Define each AVB interface separately; use {{ interfaces }} to iterate over a list
{% for iface in interfaces %}
[{{ iface.name | default('default') }}]
# Interface name (e.g., eth0, eno1)
interface {{ iface.name }}
# Use hardware timestamping per-interface (must match global)
hw_timestamping {{ 'on' if iface.hw_timestamping is none else iface.hw_timestamping }}
# MAC address of interface (auto-detected, but explicit is safer for AVB)
# mac_address {{ iface.mac }}
# Clock identity override (default: derived from MAC)
# clock_identity {{ iface.clock_identity }}
# Port number (1-indexed; usually 1 for single-port NICs)
port_number {{ iface.port_number | default(1) }}
# Delay mechanism: 'peer' (PDelay) required for AVB
# peer_delay mechs (PDelayReq/Resp) mandatory for AVB
{% if iface.delay_mechanism %}
delay_mechanism {{ iface.delay_mechanism }}
{% else %}
delay_mechanism E2E
{% endif %}
# Time-aware gateway: enable for gateways between AVB domains
# time_aware_gateway {{ 'on' if iface.time_aware_gateway else 'off' }}

{% endfor %}
