{
  "tmpdir": "/var/lib/rkhunter/tmp",
  "dbdir": "/var/lib/rkhunter/db",
  "scriptdir": "/usr/share/rkhunter/scripts",
  "installdir": "/usr",
  "logfile": "/var/log/rkhunter.log",
  "append_log": 0,
  "copy_log_on_error": 0,
  "lock_timeout": 300,
  "show_lock_msgs": 1,
  "update_mirrors": 1,
  "mirrors_mode": 0,
  "web_cmd": "",
  "mail_on_warning": "root@localhost",
  "mail_cmd": "mail -s \"[rkhunter] Warnings found for ${HOST_NAME}\"",
  "pkgmgr": "DPKG",
  "pkgmgr_no_warnings": 0,
  "scan_mode_dev": "THOROUGH",
  "scanrootkitmode": "THOROUGH",
  "unhide_tests": "sys",
  "disable_tests": [
    "suspscan",
    "hidden_ports",
    "packet_cap_apps"
  ],
  "os_version_file": "/etc/debian_version",
  "password_file": "/etc/shadow",
  "group_file": "/etc/group",
  "syslog_config_file": "/etc/rsyslog.conf",
  "startup_paths": [
    "/etc/init.d",
    "/etc/rc.local"
  ],
  "port_whitelist": [
    "TCP:22",
    "TCP:80",
    "TCP:443"
  ],
  "allow_hidden_dirs": [
    "/dev/.udev",
    "/dev/.static",
    "/dev/.initramfs"
  ],
  "allow_hidden_files": [
    "/dev/.blkid.tab",
    "/dev/.blkid.tab.old"
  ],
  "allow_dev_files": [
    "/dev/.udev/rules.d/root.rules"
  ],
  "script_whitelist": [
    "/usr/sbin/adduser",
    "/usr/sbin/prelink"
  ],
  "rtkt_file_whitelist": [],
  "rtkt_dir_whitelist": [],
  "shared_lib_whitelist": [],
  "app_whitelist": [
    "openssl:1.1.1"
  ]
}
