#
# Regular cron jobs for the apt-mirror package
# This template defines a single cron entry that runs apt-mirror at a specific hour,
# as a specific user, logging to a specific file.
#

# cron_hour: Hour of the day (0–23) when apt-mirror cron job runs
{{ (cron_hour | default('4')) | int }} * * * {{ (apt_mirror_user | default('apt-mirror')) | string }} /usr/bin/apt-mirror > {{ (cron_log_path | default('/var/spool/apt-mirror/var/cron.log')) | string }}