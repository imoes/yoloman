# Syncthing Relay Server Configuration (strelaysrv)
# This template configures the global relay server behavior.

# Enable NAT traversal features (e.g., UPnP/NAT-PMP).
# If true, the relay server will attempt to discover its public address and port
# via UPnP or NAT-PMP protocols, which is useful for deployments behind a NAT.
NAT={{ (nat_enabled | default(true)) | lower }}