{{"# Global server settings"}}
{
  {{"# Address and port to listen on for relay connections"}}
  "address": "{{ listen_address }}:{{ listen_port }}",
  {{"# Optional TLS configuration (for secure relay connections)"}}
  "tls": {
    "address": "{{ tls_address }}:{{ tls_port }}",
    "certFile": "{{ tls_cert_path }}",
    "keyFile": "{{ tls_key_path }}"
  },
  {{"# Rate limiting and connection limits"}}
  "limits": {
    "maxConnsPerIP": {{ max_conns_per_ip }},
    "maxConnsPerDevice": {{ max_conns_per_device }},
    "maxTotalConns": {{ max_total_conns }},
    "rateLimitBps": {{ rate_limit_bps }}
  },
  {{"# Logging configuration"}}
  "log": {
    "level": "{{ log_level }}",
    "file": "{{ log_file_path }}"
  },
  {{"# Optional authentication for relay administration"}}
  "auth": {
    "enabled": {{ auth_enabled | lower }},
    "passwordHash": "{{ auth_password_hash }}"
  },
  {{"# STUN/UPnP support for NAT traversal hints (not required, but helpful)"}}
  "stun": {
    "enabled": {{ stun_enabled | lower }},
    "servers": [
      {% for server in stun_servers %}
      "{{ server }}"{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  },
  {{"# Optional relay announce service (public relay directory)"}}
  "announce": {
    "enabled": {{ announce_enabled | lower }},
    "interval": {{ announce_interval }}
  },
  {{"# Optional metrics endpoint (for monitoring)"}}
  "metrics": {
    "enabled": {{ metrics_enabled | lower }},
    "address": "{{ metrics_address }}:{{ metrics_port }}"
  }
}