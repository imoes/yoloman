# Lighttpd SSL/TLS Configuration via mod_mbedtls
#
# This template configures the `mod_mbedtls` module for Lighttpd to enable
# HTTPS support. It defines the global SSL context (certificate path) and
# opens a specific listening socket for encrypted traffic.
#
# Variables expected:
#   - mod_name: Name of the Lighttpd module to load (default: 'mod_mbedtls').
#   - ssl_pemfile: Path to the PEM file containing the server certificate and private key.
#   - ssl_listen_addr: IP address to bind the SSL listener to.
#   - ssl_listen_port: Port number for the SSL listener.

# Load the mTLS (mbed TLS) SSL module.
# The module name should match the package providing the SSL backend.
server.modules += ( "{{ mod_name | default('mod_mbedtls') }}" )

# Path to the SSL PEM file.
# This file must contain both the server's certificate and its private key,
# concatenated in that order. Ensure permissions allow the Lighttpd user to read it.
ssl.pemfile = "{{ ssl_pemfile | default('/etc/lighttpd/server.pem') }}"

# Define the SSL listening socket.
# This block enables SSL encryption for connections on the specified address and port.
$SERVER["socket"] == "{{ ssl_listen_addr | default('0.0.0.0') }}:{{ ssl_listen_port | default('443') }}" {
    # Enable the SSL engine for this socket.
    ssl.engine  = "enable"
}

# Include shell script to automatically configure IPv6 if supported.
include_shell "/usr/share/lighttpd/use-ipv6.pl {{ ssl_listen_port | default('443') }}"
