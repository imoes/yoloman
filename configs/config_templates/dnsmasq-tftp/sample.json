{
  "tftp_root": "/srv/tftp",
  "tftp_interfaces": [
    "eth0"
  ],
  "tftp_no_interfaces": [
    "lo"
  ],
  "tftp_bind_addresses": [
    "10.0.0.1"
  ],
  "tftp_boot_file": "pxelinux.0",
  "pxe_prompt": "Boot from network? [Enter] to continue, [F8] for menu",
  "pxe_services": [
    {
      "name": "Linux x86 PXE",
      "type": "0",
      "desc": "Linux kernel (x86)",
      "bootfile": "vmlinuz"
    },
    {
      "name": "UEFI x86-64",
      "type": "7",
      "desc": "GRUB2 UEFI (x86-64)",
      "bootfile": "grubaa64.efi"
    }
  ],
  "tftp_port": 0,
  "tftp_connections": 128,
  "tftp_blocksize": 1024,
  "tftp_no_fail": true,
  "tftp_unique_root": true
}
