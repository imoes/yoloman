# stac-check configuration file
# https://github.com/assetgraph/stac-check/blob/main/stac_check/cli.py
# This configuration drives the stac-check CLI tool's validation behavior for STAC catalogs.

# Enable validation of links for format and response.
# Corresponds to: --links / -l
# Defaults to True to ensure link integrity by default.
validate_links: {{ validate_links | default(true) }}

# Enable validation of assets for format and response.
# Corresponds to: --assets / -a
# Defaults to True to ensure asset integrity by default.
validate_assets: {{ validate_assets | default(true) }}

# Maximum depth to traverse when recursing. Set to null for unlimited depth.
# Corresponds to: --max-depth / -m
# Defaults to 10 to prevent excessive recursion on deeply nested catalogs.
# Use null if the catalog structure is unknown or potentially very deep.
max_depth: {{ max_depth | default(10) }}

# Enable recursive validation of all related STAC objects.
# Corresponds to: --recursive / -r
# Defaults to True to ensure full catalog traversal.
recursive: {{ recursive | default(true) }}