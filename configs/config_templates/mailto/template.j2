# mailto.conf - Configuration for permitted email recipients
#
# This file controls which recipients are allowed to receive mail
# sent via the `mailto` command or similar utilities.
#
# Format per line:
#   email_address [Real Name]
#
# If no real name is provided, just the email address is used.

{% for recipient in (permitted_recipients | default(['root'])) %}
# Permitted recipient: {{ recipient | default('root') }}
{{ recipient | default('root') }}
{% endfor %}