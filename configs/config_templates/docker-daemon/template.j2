{#
  Docker daemon configuration — /etc/docker/daemon.json (JSON; dockerd refuses the file if it does not parse).

  Every value goes through `to_json`, so strings are quoted and escaped and lists/objects are valid JSON.
  Conditions are `x is defined and x`: the agent's renderer (gonja) took `x | default({})` for true on an unset
  value and wrote "log-opts": null.
  Optional keys appear only when set; the two keys at the end are always written, so no entry is followed by a
  dangling comma. storage-driver is optional: the package ships no daemon.json and lets dockerd pick the driver
  the filesystem supports — forcing overlay2 failed where overlay is not available ("driver not supported").

  hosts is OMITTED by default: Debian's and Docker's systemd units start dockerd with `-H fd://`, and dockerd
  refuses to start when `hosts` is given both as a flag and in this file ("the following directives are specified
  both as a flag and in the configuration file: hosts"). Set it only together with a unit override that drops -H.
#}
{
{% if hosts is defined and hosts %}  "hosts": {{ hosts | to_json }},
{% endif %}{% if dns is defined and dns %}  "dns": {{ dns | to_json }},
{% endif %}{% if dns_search is defined and dns_search %}  "dns-search": {{ dns_search | to_json }},
{% endif %}{% if insecure_registries is defined and insecure_registries %}  "insecure-registries": {{ insecure_registries | to_json }},
{% endif %}{% if log_opts is defined and log_opts %}  "log-opts": {{ log_opts | to_json }},
{% endif %}{% if runtimes is defined and runtimes %}  "runtimes": {{ runtimes | to_json }},
{% endif %}{% if default_runtime | default('runc') != 'runc' %}  "default-runtime": {{ default_runtime | to_json }},
{% endif %}{% if storage_driver is defined and storage_driver %}  "storage-driver": {{ storage_driver | to_json }},
{% endif %}  "data-root": {{ data_root | default('/var/lib/docker') | to_json }},
  "log-driver": {{ log_driver | default('json-file') | to_json }}
}
