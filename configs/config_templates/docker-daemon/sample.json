{
 "data_root": "/mnt/docker-data",
 "default_runtime": "runc",
 "dns": [
  "10.0.0.2",
  "10.0.0.3"
 ],
 "dns_search": [
  "docker.internal",
  "prod.local"
 ],
 "features_containerd_snapshotter": true,
 "hosts": [
  "unix:///var/run/docker.sock",
  "tcp://0.0.0.0:2376"
 ],
 "insecure_registries": [
  "registry.local:5000",
  "192.168.1.10:5000"
 ],
 "live_restore": true,
 "log_driver": "json-file",
 "log_opts": {
  "max-file": "5",
  "max-size": "50m"
 },
 "omit": "",
 "runtimes": {
  "kata": {
   "args": [
    "--config",
    "/etc/kata-containers/configuration.toml"
   ],
   "path": "/usr/bin/kata-runtime"
  },
  "runsc": {
   "args": [],
   "path": "/usr/bin/runsc"
  }
 },
 "storage_driver": "overlay2"
}
