# ==============================================================================
# jftp Configuration Template
# ==============================================================================
# This template configures the jftp Java-based GUI file transfer client.
# It generates a configuration file containing the default FTP server URL,
# the path to the Java runtime, the location of the jftp.jar application,
# and any additional JVM arguments required for startup.
# ==============================================================================

# --------------------------------------------------------------------------
# Section: General Settings
# --------------------------------------------------------------------------

# SERVER_URL: The fully qualified server URL to open in jftp on startup,
# as specified in the SYNOPSIS/OPTIONS.
SERVER_URL: {{ server_url | default('ftp.kernel.org') }}

# --------------------------------------------------------------------------
# Section: Java Environment
# --------------------------------------------------------------------------

# JAVA_HOME: Path to the Java Virtual Machine binary, as suggested in the
# EXAMPLE section. This is the executable used to launch the application.
JAVA_HOME: {{ java_home | default('/usr/bin/java') }}

# JFTP_JAR: Path to the main jftp.jar executable, as suggested in the
# EXAMPLE section.
JFTP_JAR: {{ jftp_jar | default('/usr/share/java/jftp.jar') }}

# --------------------------------------------------------------------------
# Section: JVM Arguments
# --------------------------------------------------------------------------

# JVM_ARGS: List of JVM arguments to pass to the java command.
# Items are strings. Common uses include memory allocation settings
# (e.g., -Xms256m, -Xmx512m).
# This value is joined into a single space-separated string for the command line.
JVM_ARGS: {{ jvm_args | default([]) | join(' ') }}