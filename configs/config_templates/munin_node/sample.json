{
 "allowed_hosts": [
  "127.0.0.1",
  "::1",
  "192.168.10.0/24",
  "^10\\.50\\.\\d+\\.\\d+$"
 ],
 "dirdir": "/etc/munin/plugin-conf.d",
 "group": "munin",
 "htmldir": "/var/www/munin",
 "log_level": 1,
 "logdir": "/var/log/munin",
 "max_connections": 20,
 "node_hostname": "web01.internal.example.com",
 "plugin_conf_includes": [
  "/etc/munin/plugin-conf.d",
  "/etc/munin/custom-conf.d"
 ],
 "port": 4949,
 "rundir": "/var/run/munin",
 "strict_host_verification": 1,
 "timeout": 300,
 "user": "munin"
}
