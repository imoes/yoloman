<?xml version="1.0" encoding="UTF-8"?>
<!--
  This template generates a D-Bus bus configuration file for a Click application service.
  It defines security policies allowing the service to own its name and communicate.
-->
<!DOCTYPE busconfig PUBLIC
 "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>

	<!--
	  Policy for the root user.
	  Allows the root user to own (claim) the D-Bus service name associated with this Click service.
	  This is typically required for system-level services or daemons.
	-->
	<policy user="root">
		<!--
		  service_dbus_name: The unique D-Bus service name (interface) for the click-service.
		  Defaults to 'com.lomiri.click' if not specified in variables.
		-->
		<allow own="{{ service_dbus_name | default('com.lomiri.click') }}"/>
	</policy>

	<!--
	  Default policy for all other users/clients.
	  Defines what actions are permitted for clients connecting to the bus when no more specific policy applies.
	-->
	<policy context="default">
		<!--
		  Allows any client to send messages TO this service.
		  The destination must match the service's unique name.
		-->
		<allow send_destination="{{ service_dbus_name | default('com.lomiri.click') }}"/>
		<!--
		  Allows any client to receive messages FROM this service.
		  The sender must be the service's unique name.
		-->
		<allow receive_sender="{{ service_dbus_name | default('com.lomiri.click') }}"/>
	</policy>

</busconfig>
