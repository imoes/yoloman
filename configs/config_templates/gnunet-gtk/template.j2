# =============================================================================
# gnunet-gtk configuration file
# =============================================================================
# This file configures the GTK frontend for GNU NetUN (GNUnet).
# It corresponds to the options available via the gnunet-gtk(1) man page.
# Generated from schema definitions.
# =============================================================================

[GNUNET-GTK]

# Logging level for the GNUnet GTK interface.
# Valid values are typically: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Maps to CLI option: -L LOGLEVEL, --log=LOGLEVEL
# If omitted or empty, defaults to 'INFO'.
LOGLEVEL = {{ loglevel | default('INFO') }}

# Path to the log file.
# If this value is empty or unset, logs are written to stderr (standard output/error) instead of a file.
# Maps to CLI option: -l LOGFILE, --logfile=LOGFILE
LOGFILE = {{ logfile | default('') }}