{
  "statsd_host": "127.0.0.1",
  "statsd_udp_port": 8125,
  "statsd_tcp_port": 8126,
  "statsd_metric_prefix": "openstack.",
  "statsd_udp_buffer_size": 65535,
  "statsd_max_metrics_per_message": 2000,
  "statsd_flush_interval": 5,
  "statsd_create_metrics": true,
  "statsd_metrics": [
    {
      "name": "openstack.compute.cpu_util",
      "type": "gauge",
      "unit": "%"
    },
    {
      "name": "openstack.volume.io_ops",
      "type": "rate",
      "unit": "ops/s"
    },
    {
      "name": "openstack.network.packet_loss",
      "type": "counter",
      "unit": "packets"
    }
  ],
  "statsd_log_level": "info"
}
