# nxdialog helper configuration
# This file provides runtime parameters to the nxdialog binary.
# It is generated by Ansible based on the role variables defined in the schema.

# Path to the nxdialog binary executable.
# Schema field: nxdialog_executable
# Default: /usr/bin/nxdialog
EXECUTABLE="{{ nxdialog_executable | default('/usr/bin/nxdialog') }}"

# Type of dialog to display.
# Valid values: yesno, ok, error, panic, quit, pulldown, yesnosuspend.
# Corresponds to: --dialog
# Schema field: nxdialog_dialog_type
# Default: ok
DIALOG_TYPE="{{ nxdialog_dialog_type | default('ok') }}"

# The text message to be displayed inside the dialog box.
# Corresponds to: --message
# Schema field: nxdialog_message
# Default: Operation completed successfully.
DIALOG_MESSAGE="{{ nxdialog_message | default('Operation completed successfully.') }}"

# The title string shown in the dialog window's title bar.
# Corresponds to: --caption
# Schema field: nxdialog_caption
# Default: NX Dialog
DIALOG_CAPTION="{{ nxdialog_caption | default('NX Dialog') }}"

# The X11 display string where the dialog should be rendered (e.g., ':0').
# If left empty, the application defaults to using the $DISPLAY environment variable.
# Corresponds to: --display
# Schema field: nxdialog_display
# Default: ''
DISPLAY_TARGET="{{ nxdialog_display | default('') }}"

# The Process ID (PID) of the parent nxagent process.
# A value of 0 indicates standalone testing mode with no parent.
# Corresponds to: --parent
# Schema field: nxdialog_parent_pid
# Default: 0
PARENT_PID="{{ nxdialog_parent_pid | default(0) }}"

# The X11 Window ID used for embedding pulldown dialogs.
# Leave empty if pulldown embedding is not being used.
# Corresponds to: --window
# Schema field: nxdialog_window_id
# Default: ''
WINDOW_ID="{{ nxdialog_window_id | default('') }}"

# The message class used for styling or icon selection.
# Valid values: info, warning, error.
# Corresponds to: --class
# Schema field: nxdialog_msg_class
# Default: info
MSG_CLASS="{{ nxdialog_msg_class | default('info') }}"

# Flag to enable proxy mode.
# Note: This feature is currently unimplemented in the binary but the flag is supported.
# Corresponds to: --local
# Schema field: nxdialog_use_local
# Default: false
USE_LOCAL="{{ nxdialog_use_local | default(False) | lower }}"

# Flag to allow multiple instances of the same dialog to run simultaneously.
# Note: This feature is currently unimplemented in the binary but the flag is supported.
# Corresponds to: --allowmultiple
# Schema field: nxdialog_allow_multiple
# Default: false
ALLOW_MULTIPLE="{{ nxdialog_allow_multiple | default(False) | lower }}"