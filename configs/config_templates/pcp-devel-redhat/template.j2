# Configuration for PCP (Performance Co-Pilot) metrics collection.
# This template handles the `sec,min,hour` aggregation intervals for historical metrics.
# It is self-documenting: if schema fields are added, defaults and comments must be updated here.
#
# Fields:
# - pcp_metric_interval_sec: Interval in seconds for short-term metrics.
# - pcp_metric_interval_min: Interval in minutes for medium-term metrics.
# - pcp_metric_interval_hour: Interval in hours for long-term metrics.

# The output format is a simple comma-separated list of time intervals.
# Example output: 5,15,24
{{ (pcp_metric_interval_sec | default(5)) }},{{ (pcp_metric_interval_min | default(15)) }},{{ (pcp_metric_interval_hour | default(24)) }}
