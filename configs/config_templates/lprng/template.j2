# LPRng for Debian GNU/Linux
# /etc/lprng/lpd.conf
# See lpd.conf(5) and /usr/share/doc/lprng/examples/lpd.conf.gz
#

# cs_warn: Warning string pattern to detect in checkpc output
cs_warn={{ cs_warn }}

# cs_error: Error string pattern to detect in checkpc output
cs_error={{ cs_error }}

# cs_lock_own: Specific lock file ownership warning to ignore
cs_lock_own={{ cs_lock_own }}

# cs_lock_perm: Specific lock file permission warning to ignore
cs_lock_perm={{ cs_lock_perm }}

# cs_miss_lockfile: Specific missing lockfile warning to ignore
cs_miss_lockfile={{ cs_miss_lockfile }}

# cs_rv_match: Return value string indicating errors were found (match for grep -v logic)
cs_rv_match={{ cs_rv_match }}

# cs_error_message: Syslog message to log when errors are detected
cs_error_message={{ cs_error_message }}
