{# Configuration for claws-mail-address-keeper plugin #}
# Load address_keeper plugin
# Plugin file name is 'address_keeper.so'
#
# Schema field: enabled
# Description: Whether to load the address_keeper plugin on Claws Mail startup.
#              Note: The plugin must be loaded via the GUI "Configuration" -> "Plugins" ->
#              "Load plugin..." and selecting 'address_keeper.so'.
{% if enabled | default(false) %}
# Before using a plugin you must instruct Claws Mail to load
# it on startup.
# For this you must go “Configuration” menu on main
# window toolbar, open “Plugins...” dialog, click on the
# “Load plugin...” button and select the plugin file, named
# address_keeper.so, and press the “Open” button.
{% else %}
# The address_keeper plugin is disabled.
# To enable it, set 'enabled' to True in the Ansible role variables.
# Alternatively, load it manually via Claws Mail's GUI:
# Configuration -> Plugins -> Load plugin... -> address_keeper.so
{% endif %}