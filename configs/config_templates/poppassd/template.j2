# POP Password Change Server configuration file
# List of allowed hosts (IPs or hostnames) permitted to connect
{% for host in allowed_hosts %}# Host: {{ host }}
{% endfor %}
# Path to the PAM service configuration (without .conf extension)
pam_service {{ pam_service_name }}
# Enable debug logging (true/false)
debug {{ debug | lower }}
# Path to the syslog facility (e.g., daemon, local0, etc.)
syslog_facility {{ syslog_facility }}
# Enable/disable chroot() for security (true/false)
chroot {{ chroot | lower }}
# Path to the chroot directory (used only if chroot is enabled)
chroot_dir {{ chroot_dir }}
# Port to listen on (default: 106; 0 = do not bind to port, e.g., for inetd)
port {{ port }}
# Path to the PID file (empty = do not write PID file)
pid_file {{ pid_file | default('') }}
# Command to invoke for password change (optional; if absent, uses PAM only)
# {{ password_change_command }}
{% if password_change_command %}command {{ password_change_command }}{% endif %}
# Maximum number of concurrent connections (0 = unlimited)
max_connections {{ max_connections }}
# Timeout (seconds) for idle connections
idle_timeout {{ idle_timeout }}
