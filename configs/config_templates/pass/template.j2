# ~/.password-store: Password Store configuration
# This file is a symbolic link or directory used by `pass`, the standard Unix password manager.
# It is NOT a typical config file — pass uses a Git-tracked directory of GPG-encrypted .gpg files.
# For per-user configuration, pass reads optional env vars or ~/.config/pass.conf (if used).
# However, if you're managing multiple password stores or custom setups via wrapper scripts,
# you may define a symlink or directory path variable here.
{{ store_path }}
