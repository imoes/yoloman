# Fence agent for RHEV-M (Red Hat Enterprise Virtualization Manager)
# Target virtualization platform: Red Hat Enterprise Virtualization (RHEV)
# This configuration is used by the `fence_rhevm` agent to manage fencing via RHEV-M REST API

[default]
# Hostname or IP of the RHEV-M (Manager) API endpoint
hostname = {{ hostname }}

# Port used to connect to RHEV-M API (typically 443 for HTTPS)
port = {{ port }}

# Username (in domain\user or user@domain format) for authentication
login = {{ login }}

# Password for the user; preferably use a secure method like 'passwd_file'
# (Do NOT hardcode sensitive passwords in config; use passwd_file or environment)
# passwd = {{ passwd }}

# Path to a file containing the password (preferred for security)
passwd_file = {{ passwd_file }}

# API endpoint path; usually /api for RHEV-M v3+, /api/v2.3 for older
api_path = {{ api_path }}

# Use SSL/TLS for connection (set to 0 to disable for testing only)
secure = {{ secure }}

# Verify SSL certificate (1=verify, 0=ignore — not recommended in production)
ssl_verify = {{ ssl_verify }}

# Optional: timeout for API requests in seconds
# timeout = {{ timeout }}

# Optional: retry count and interval (if omitted, defaults to fence-agents behavior)
# retry_count = {{ retry_count }}
# retry_timeout = {{ retry_timeout }}

# Optional: domain (for SSO/kerberos auth scenarios, rarely needed here)
# domain = {{ domain }}

# Optional: use HTTP Basic Auth instead of OAuth (default is OAuth2 for newer RHEV-M)
# use_oauth = {{ use_oauth }}
