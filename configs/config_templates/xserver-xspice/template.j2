# =============================================================================
# XSPICE X Server Configuration Template
# =============================================================================
# This template configures the xserver-xspice (SPICE display server) component.
# It generates an xorg.conf snippet defining the Device, Input, Monitor, Screen,
# and ServerLayout sections required for SPICE remote desktop functionality.
#
# Self-documentation:
# - Every Option line is preceded by a comment explaining its source field.
# - Every Jinja2 variable reference includes a | default(...) filter matching
#   the schema definition to prevent render errors if a variable is undefined.
# =============================================================================

Section "Device"
    Identifier "XSPICE"
    Driver "spiceqxl"

    # -------------------------------------------------------------------------
    # Network and security options.
    # These options control authentication, encryption, and network binding
    # for the Spice display server.
    # -------------------------------------------------------------------------

    # Do not require a client password.
    # When True, clients can connect without providing a password.
    # Schema field: spice_disable_ticketing
    Option "SpiceDisableTicketing" "{{ spice_disable_ticketing | default('False') }}"

    # Set the password required to connect to the Spice server.
    # Only used if SpiceDisableTicketing is False.
    # Schema field: spice_password
    Option "SpicePassword" "{{ spice_password | default('') }}"

    # Enable usage of SASL supported by the spice-gtk client.
    # Used for authentication via SASL mechanisms (e.g., GSSAPI, PLAIN).
    # Schema field: spice_sasl
    Option "SpiceSasl" "{{ spice_sasl | default('False') }}"

    # Use Spice's regular unencrypted port.
    # Specify 0 to disable. One of SpicePort or SpiceTlsPort must be specified.
    # Schema field: spice_port
    Option "SpicePort" "{{ spice_port | default('5900') }}"

    # Use a TLS (encrypted) port.
    # Specify 0 to disable. One of SpicePort or SpiceTlsPort must be specified.
    # Schema field: spice_tls_port
    Option "SpiceTlsPort" "{{ spice_tls_port | default('5900') }}"

    # Set the directory where the CA certificate, server key and server certificate
    # are searched for TLS.
    # QEMU-style predefined names are used: cacert.pem, server-key.pem, server-cert.pem.
    # Schema field: spice_x509_dir
    Option "SpiceX509Dir" "{{ spice_x509_dir | default('') }}"

    # Set the CA certificate file location for TLS.
    # If set, this file is used instead of looking for cacert.pem in SpiceX509Dir.
    # Schema field: spice_cacert_file
    Option "SpiceCacertFile" "{{ spice_cacert_file | default('') }}"

    # Set the server key file location for TLS.
    # If set, this file is used instead of looking for server-key.pem in SpiceX509Dir.
    # Schema field: spice_x509_key_file
    Option "SpiceX509KeyFile" "{{ spice_x509_key_file | default('') }}"

    # Set the server key's password for TLS.
    # Required if the private key is encrypted.
    # Schema field: spice_x509_key_password
    Option "SpiceX509KeyPassword" "{{ spice_x509_key_password | default('') }}"

    # Set the server certificate file location for TLS.
    # If set, this file is used instead of looking for server-cert.pem in SpiceX509Dir.
    # Schema field: spice_x509_cert_file
    Option "SpiceX509CertFile" "{{ spice_x509_cert_file | default('') }}"

    # Set the server DH (Diffie-Hellman) file location for TLS.
    # Used for key exchange in older cipher suites.
    # Schema field: spice_dh_file
    Option "SpiceDhFile" "{{ spice_dh_file | default('') }}"

    # Set the TLS ciphers preference order.
    # Comma-separated list of allowed ciphers.
    # Schema field: spice_tls_ciphers
    Option "SpiceTlsCiphers" "{{ spice_tls_ciphers | default('') }}"

    # Listen to a specific interface.
    # Empty string means listen on all interfaces (0.0.0.0).
    # Schema field: spice_addr
    Option "SpiceAddr" "{{ spice_addr | default('') }}"

    # Set to True to only listen on IPv4 interfaces.
    # Schema field: spice_ipv4_only
    Option "SpiceIPV4Only" "{{ spice_ipv4_only | default('False') }}"

    # Set to True to only listen on IPv6 interfaces.
    # Schema field: spice_ipv6_only
    Option "SpiceIPV6Only" "{{ spice_ipv6_only | default('False') }}"

    # If set, the Spice server will exit when the first client disconnects.
    # Useful for single-session environments.
    # Schema field: spice_exit_on_disconnect
    Option "SpiceExitOnDisconnect" "{{ spice_exit_on_disconnect | default('True') }}"

    # -------------------------------------------------------------------------
    # Monitor configuration options.
    # -------------------------------------------------------------------------

    # The number of heads (virtual monitors) to allocate by default.
    # Schema field: num_heads
    Option "NumHeads" "{{ num_heads | default('4') }}"

    # -------------------------------------------------------------------------
    # Compression options.
    # -------------------------------------------------------------------------

    # Set zlib glz wan compression.
    # Options: auto, never, always.
    # Schema field: spice_zlib_glz_wan_compression
    Option "SpiceZlibGlzWanCompression" "{{ spice_zlib_glz_wan_compression | default('auto') }}"

    # Set jpeg wan compression.
    # Options: auto, never, always.
    # Schema field: spice_jpeg_wan_compression
    Option "SpiceJpegWanCompression" "{{ spice_jpeg_wan_compression | default('auto') }}"

    # Set image compression.
    # Options: off, auto_glz, auto_lz, quic, glz, lz.
    # Schema field: spice_image_compression
    Option "SpiceImageCompression" "{{ spice_image_compression | default('auto_glz') }}"

    # If non zero, render operations to frame buffer and transmit changed
    # rectangles at this rate (frames per second).
    # This can dramatically reduce network bandwidth for some use cases.
    # Schema field: spice_deferred_fps
    Option "SpiceDeferredFPS" "{{ spice_deferred_fps | default('10') }}"

    # Set the streaming video method.
    # Options: filter, off, all.
    # Schema field: spice_streaming_video
    Option "SpiceStreamingVideo" "{{ spice_streaming_video | default('filter') }}"

    # Sets a semicolon-separated list of preferred video codecs.
    # Each takes the form encoder:codec (e.g., spice:mjpeg, gstreamer:h264).
    # Schema field: spice_video_codecs
    Option "SpiceVideoCodecs" "{{ spice_video_codecs | default('') }}"

    # Enable caching of images directly written with uxa->put_image.
    # Improves performance for certain drawing operations.
    # Schema field: enable_image_cache
    Option "EnableImageCache" "{{ enable_image_cache | default('True') }}"

    # Enable caching of images created by uxa->prepare_access.
    # Improves performance for complex image transformations.
    # Schema field: enable_fallback_cache
    Option "EnableFallbackCache" "{{ enable_fallback_cache | default('True') }}"

    # -------------------------------------------------------------------------
    # Xspice-specific buffer options.
    # These control memory allocation for rendering buffers.
    # -------------------------------------------------------------------------

    # The amount of surface buffer ram, in megabytes, to allocate.
    # Should be at least as large as the frame buffer.
    # Note: This value is hardcoded in the original schema context as it has
    # no corresponding schema variable provided.
    Option "SurfaceBufferSize" "128"

    # The amount of command buffer ram, in megabytes, to allocate.
    # Should be substantially larger than the frame buffer.
    # Note: This value is hardcoded in the original schema context.
    Option "CommandBufferSize" "128"

    # The amount of frame buffer ram, in megabytes, to reserve.
    # Reserved out of CommandBuffer RAM. Governs max X screen size.
    # Note: This value is hardcoded in the original schema context.
    Option "FrameBufferSize" "16"

    # -------------------------------------------------------------------------
    # VDAgent options (Virtio Serial Agent).
    # -------------------------------------------------------------------------

    # Whether or not to accept Vdagent connections.
    # Note: No schema variable provided; defaulting to hardcoded False.
    Option "SpiceVdagentEnabled" "False"

    # Default path to listen for agent virtual io connections.
    # Note: No schema variable provided; defaulting to hardcoded path.
    Option "SpiceVdagentVirtioPath" "/tmp/xspice-virtio"

    # Default path to listen for agent uinput connections.
    # Note: No schema variable provided; defaulting to hardcoded path.
    Option "SpiceVdagentUinputPath" "/tmp/xspice-uinput"

    # Default user id to set for the Virtio and Uinput sockets.
    # Note: Both uid and gid must be given for either to take effect.
    # Note: No schema variable provided; defaulting to hardcoded 0.
    Option "SpiceVdagentUid" "0"

    # Default group id to set for the Virtio and Uinput sockets.
    # Note: Both uid and gid must be given for either to take effect.
    # Note: No schema variable provided; defaulting to hardcoded 0.
    Option "SpiceVdagentGid" "0"

    # Set Spice Agent Mouse - Use Agent mouse if an agent connects.
    # Note: No schema variable provided; defaulting to hardcoded True.
    Option "SpiceAgentMouse" "True"

    # Set Spice Playback compression.
    # Note: No schema variable provided; defaulting to hardcoded True.
    Option "SpicePlaybackCompression" "True"

    # Disable copy and paste.
    # Note: No schema variable provided; defaulting to hardcoded False.
    Option "SpiceDisableCopyPaste" "False"

    # If a directory is given, any file in that directory will be read
    # for audio data to be sent to the client.
    # Note: No schema variable provided; defaulting to hardcoded /tmp/.
    Option "SpicePlaybackFIFODir" "/tmp/"

    # A unix domain name for a unix domain socket to communicate with
    # a spiceccid smartcard driver.
    # Note: No schema variable provided; defaulting to hardcoded path.
    Option "SpiceSmartCardFile" "/tmp/spice.pcsc.comm"
EndSection

Section "InputDevice"
    Identifier "XSPICE POINTER"
    Driver     "xspice pointer"
EndSection

Section "InputDevice"
    Identifier "XSPICE KEYBOARD"
    Driver     "xspice keyboard"
EndSection

Section "Monitor"
    Identifier    "Configured Monitor"
EndSection

Section "Screen"
    Identifier     "XSPICE Screen"
    Monitor        "Configured Monitor"
    Device        "XSPICE"
    DefaultDepth    24
EndSection

Section "ServerLayout"
    Identifier "XSPICE Example"
    Screen "XSPICE Screen"
    InputDevice "XSPICE KEYBOARD"
    InputDevice "XSPICE POINTER"
EndSection

# Prevent udev from loading vmmouse in a vm and crashing.
Section "ServerFlags"
    Option "AutoAddDevices" "False"
EndSection
