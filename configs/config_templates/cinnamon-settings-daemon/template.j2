# ==============================================================================
# Cinnamon Settings Daemon - Accessibility Settings Autostart Entry
# ==============================================================================
# This template generates a desktop entry (.desktop) file for the Cinnamon
# Settings Daemon's accessibility settings component. It configures how and
# when the daemon autostarts within the desktop session.
# ==============================================================================

[Desktop Entry]
# Type of entry; always Application for daemons/launchers
Type=Application

# Display name shown in session managers and desktop environments
Name=Cinnamon Settings Daemon - a11y-settings

# The executable path or command for the accessibility settings daemon.
# Default: csd-a11y-settings
Exec={{ csd_a11y_settings_exec | default('csd-a11y-settings') }}

# Desktop environments in which this application should appear.
# Default: ['X-Cinnamon']
# Renders as a pipe-separated list (e.g., X-Cinnamon;GNOME;)
OnlyShowIn={{ csd_a11y_settings_only_show_in | default(['X-Cinnamon']) | join(';') }}

# If true, the application is not shown in menus or desktops.
# Default: true
NoDisplay={{ csd_a11y_settings_no_display | default(True) | lower }}

# The phase at which the autostart application should be launched.
# Default: Initialization
X-GNOME-Autostart-Phase={{ csd_a11y_settings_autostart_phase | default('Initialization') }}

# If true, notify the session manager that the application is ready.
# Default: true
X-GNOME-Autostart-Notify={{ csd_a11y_settings_autostart_notify | default(True) | lower }}

# If true, automatically restart the application if it crashes.
# Default: true
X-GNOME-AutoRestart={{ csd_a11y_settings_auto_restart | default(True) | lower }}