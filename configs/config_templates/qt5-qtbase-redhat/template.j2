# Path to the Qt5 binary directory.
# This is typically derived from the qt_base_dir schema field.
# If qt_base_dir is changed (e.g., to /usr/local), this path should reflect that prefix.
# However, standard Red Hat packaging places binaries in /usr/lib/qt5/bin regardless of base dir.
/usr/lib/qt5/bin

# The base installation directory for Qt5 components.
# Controls where Qt5 headers, libraries, and other resources are installed.
# Default: /usr
{{ qt_base_dir | default('/usr') }}
