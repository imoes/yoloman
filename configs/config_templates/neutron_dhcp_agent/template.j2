[DEFAULT]
# Enable debug logging for troubleshooting.
debug = {{ debug | default(False) | ternary('True', 'False') }}

# Enable verbose (trace-level) logging.
verbose = {{ verbose | default(False) | ternary('True', 'False') }}

# Path to the rootwrap configuration file used to elevate privileges.
rootwrap_config = {{ rootwrap_config | default('/etc/neutron/rootwrap.conf') }}

# RPC backend to use (e.g., rabbit, redis, or messaging v2).
rpc_backend = {{ rpc_backend | default('rabbit') }}

# Hostname or IP of RabbitMQ server.
rabbit_host = {{ rabbit_host | default('localhost') }}

# Port of RabbitMQ server.
rabbit_port = {{ rabbit_port | default(5672) }}

# Username for RabbitMQ authentication.
rabbit_userid = {{ rabbit_user | default('guest') }}

# Password for RabbitMQ authentication (required in production).
rabbit_password = {{ rabbit_password | default('') }}

# Virtual host for RabbitMQ.
rabbit_virtual_host = {{ rabbit_virtual_host | default('/') }}

# Base directory for runtime state files.
state_path = {{ state_path | default('/var/lib/neutron') }}

# Number of DHCP agents to handle each network (enables high availability).
dhcp_agents_per_network = {{ dhcp_agents_per_network | default(1) }}

# DHCP driver to use (e.g., Dnsmasq, external, or custom).
dhcp_driver = {{ dhcp_driver | default('neutron.agent.linux.dhcp.Dnsmasq') }}

# Enable metadata service for isolated networks (requires NAT).
enable_isolated_metadata = {{ enable_isolated_metadata | default(False) | ternary('True', 'False') }}

# Enable metadata network (required when using isolated metadata with NAT).
enable_metadata_network = {{ enable_metadata_network | default(False) | ternary('True', 'False') }}

# Shared secret for authenticating metadata proxy requests (must match server config).
metadata_proxy_shared_secret = {{ metadata_proxy_shared_secret | default('') }}

# Interface driver for plug/unplug devices (OVS, LinuxBridge, or custom).
interface_driver = {{ interface_driver | default('neutron.agent.linux.interface.OVSInterfaceDriver') }}

# Metadata driver for handling instance metadata.
metadata_driver = {{ metadata_driver | default('neutron.agent.linux.metadata.driver.MetadataDriver') }}

# DHCP lease time in seconds (default: 24 hours).
dhcp_lease_time = {{ dhcp_lease_time | default(86400) }}

# List of DNS servers for instances (IPv4 or IPv6 addresses).
{% if dns_servers | default([]) | length > 0 %}
dns_servers = {{ dns_servers | default([]) | join(', ') }}
{% endif %}

# Prefix for network namespaces (if namespaces enabled).
network_namespace = {{ network_namespace | default('qdhcp-') }}

# Path to PID file for the DHCP agent process.
pid_file = {{ pid_file | default('/var/run/neutron/dhcp-agent.pid') }}

# Open vSwitch integration bridge name (for OVS driver).
ovs_integration_bridge = {{ ovs_integration_bridge | default('br-int') }}

# Map physical networks to devices for Linux Bridge driver.
{% if linux_bridge_physical_device_mappings | default([]) | length > 0 %}
# Format: <physical_network>:<device_name>
{% for mapping in linux_bridge_physical_device_mappings | default([]) %}
linux_bridge_physical_device_mappings = {{ mapping.physical_network }}:{{ mapping.device_name }}
{% endfor %}{% endif %}

# Multicast group for VxLAN overlays (e.g., '239.1.1.1').
{% if vxlan_group | default('') | trim | length > 0 %}
vxlan_group = {{ vxlan_group | default('') }}
{% endif %}

# MTU to send in DHCP options (overrides interface MTU).
dhcp_mtu = {{ dhcp_mtu | default(1500) }}

# Enable per-network namespaces (required for overlapping IPs).
use_namespaces = {{ use_namespaces | default(True) | ternary('True', 'False') }}

# [Deprecated] Number of DHCP agents; use `dhcp_agents_per_network` instead.
dhcp_agents = {{ dhcp_agents | default(2) }}

# Enable DHCP option 121 (classless static route) for improved routing.
enable_dhcp_opt121 = {{ enable_dhcp_opt121 | default(False) | ternary('True', 'False') }}

# Hostname or identifier for this agent (must match nova/neutron config).
{% if host | default('') | trim | length > 0 %}
host = {{ host | default('') }}
{% endif %}

# Identity endpoint URL (Keystone v3).
auth_url = {{ auth_url | default('http://controller:5000/v3') }}

# Authentication type (e.g., password, token, or application credential).
auth_type = {{ auth_type | default('password') }}

# Project domain name for authentication.
project_domain_name = {{ project_domain_name | default('Default') }}

# User domain name for authentication.
user_domain_name = {{ user_domain_name | default('Default') }}

# Service project name (tenant) for authentication.
project_name = {{ project_name | default('service') }}

# Username for service authentication.
username = {{ username | default('neutron') }}

# Password for service authentication (required).
password = {{ password | default('') }}

# Allow insecure TLS connections (disable certificate verification).
insecure = {{ insecure | default(False) | ternary('True', 'False') }}

# Path to CA bundle for TLS verification (if insecure=false).
{% if cafile | default('') | trim | length > 0 %}
cafile = {{ cafile | default('') }}
{% endif %}

[agent]
# Interval (seconds) between resource updates from Neutron server.
polling_interval = {{ polling_interval | default(2) }}

# QoS driver class (e.g., neutron.plugins.ml2.drivers.mech_sriov.agent.qos_driver.QoSDriver).
{% if qos_driver | default('') | trim | length > 0 %}
qos_driver = {{ qos_driver | default('') }}
{% endif %}