{# ============================================================================ #}
{# Claws Mail TNEF Parser Plugin Configuration                                 #}
{# This file configures the tnef_parse plugin for Claws Mail.                  #}
{# It enables/disables the plugin and specifies the path to the shared library. #}
{# ============================================================================ #}

[plugin]

# Name of the plugin to load; must match the plugin's internal registration name.
name=tnef_parse

# Whether the TNEF parser plugin should be loaded at startup.
# Accepts 'true' or 'false'. Defaults to true if not specified.
enabled={{ enabled | default(true) | lower }}

# Absolute path to the plugin shared library file (tnef_parse.so).
# Usually system-managed, but allows override for custom builds.
# Defaults to the standard Debian/Ubuntu path.
path={{ plugin_path | default('/usr/lib/claws-mail/plugins/tnef_parse.so') }}