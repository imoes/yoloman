################################################################################
#           JAXP Strict Configuration Template
#
# This file, jaxp-strict.properties.template, provides a template for creating
# custom configuration files. The settings in this file are more restrictive than
# those in the default configuration, jaxp.properties. In particular:
#   - JDKCatalog Resolve is on "strict" setting
#   - Extension Functions are disabled
#   - JAXP Limits are set to smaller numbers
#
# To create a configuration file, copy the template to a new file with
# the .properties extension, that is:
#
#     cp $JAVA_HOME/conf/jaxp-strict.properties.template /path/to/jaxp-strict.properties
#
# The configuration file can then be set up using the system property
# java.xml.config.file to override the default configuration jaxp.properties
# and used to assess the impact of a stricter configuration, for example:
#
#     java -Djava.xml.config.file=/path/to/jaxp-strict.properties
#
# The system property java.xml.config.file is defined in the java.xml module
# description.
#
################################################################################

#
# ---- Implementation Specific Properties ----
# For a complete list of properties, refer to the Implementation Specific Properties
# table in the java.xml/module-summary.
#

# Controls whether XSLT and XPath extension functions are allowed.
# Set to 'false' to disable.
jdk.xml.enableExtensionFunctions={{ jdk_xml_enableExtensionFunctions | default('false') }}

# Controls whether a third-party implementation can override the default JDK parser.
jdk.xml.overrideDefaultParser={{ jdk_xml_overrideDefaultParser | default('false') }}

# How the CatalogResolver behaves when unable to resolve an external reference.
# Options: continue, ignore, strict.
jdk.xml.jdkcatalog.resolve={{ jdk_xml_jdkcatalog_resolve | default('strict') }}

# Controls DTD processing.
# Options: deny, ignore, allow.
jdk.xml.dtd.support={{ jdk_xml_dtd_support | default('allow') }}

# Limits the number of entity expansions.
jdk.xml.entityExpansionLimit={{ jdk_xml_entityExpansionLimit | default(2500) }}

# Limits the total size of all entities.
jdk.xml.totalEntitySizeLimit={{ jdk_xml_totalEntitySizeLimit | default(100000) }}

# Limits the maximum size of any general entities.
jdk.xml.maxGeneralEntitySizeLimit={{ jdk_xml_maxGeneralEntitySizeLimit | default(100000) }}

# Limits the maximum size of any parameter entities.
jdk.xml.maxParameterEntitySizeLimit={{ jdk_xml_maxParameterEntitySizeLimit | default(15000) }}

# Limits the total number of nodes in all entity references.
jdk.xml.entityReplacementLimit={{ jdk_xml_entityReplacementLimit | default(100000) }}

# Limits the number of attributes an element can have.
jdk.xml.elementAttributeLimit={{ jdk_xml_elementAttributeLimit | default(200) }}

# Limits the number of content model nodes for W3C XML Schema maxOccurs.
jdk.xml.maxOccurLimit={{ jdk_xml_maxOccurLimit | default(5000) }}

# Limits the maximum element depth.
jdk.xml.maxElementDepth={{ jdk_xml_maxElementDepth | default(100) }}

# Limits the maximum size of XML names.
jdk.xml.maxXMLNameLimit={{ jdk_xml_maxXMLNameLimit | default(1000) }}

# Limits the number of groups an XPath expression can contain.
jdk.xml.xpathExprGrpLimit={{ jdk_xml_xpathExprGrpLimit | default(10) }}

# Limits the number of operators an XPath expression can contain.
jdk.xml.xpathExprOpLimit={{ jdk_xml_xpathExprOpLimit | default(100) }}

# Limits the total number of XPath operators in an XSL Stylesheet.
jdk.xml.xpathTotalOpLimit={{ jdk_xml_xpathTotalOpLimit | default(10000) }}
