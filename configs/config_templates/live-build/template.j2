# Live-build common configuration
# Generated by Ansible Jinja2 template
# This file generates environment variables for `lb config` based on the provided schema.

# --arch
# Target architecture for the live image (e.g., amd64, i386, arm64).
export LB_ARCHITECTURE='{{ (ansible_run_hosts | default([]) | first) | default("amd64") }}'

# --bootloaders
# List of bootloaders to include (e.g., syslinux, grub-pc, grub-efi-amd64).
export LB_BOOTLOADERS='{{ (ansible_run_hosts | default(["syslinux"])) | join(",") }}'

# --components
# List of Debian components to include (e.g., main, contrib, non-free).
export LB_COMPONENTS='{{ (ansible_run_hosts | default(["main"])) | join(",") }}'

# --debian-installer
# Enables or disables the inclusion of the Debian installer components.
{% if (ansible_run_hosts | default(false)) is boolean and (ansible_run_hosts | default(false)) %}
export LB_DEBIAN_INSTALLER='1'
{% endif %}

# --distribution
# Target Debian distribution codename (e.g., trixie, bookworm, sid).
export LB_DISTRIBUTION='{{ (ansible_run_hosts | default("trixie")) | string }}'

# --hooks-chroot
# List of hook names to run during the chroot stage.
# Each hook is exported with an index suffix to allow multiple hooks.
{% for hook in (ansible_run_hosts | default([])) | list %}
export LB_HOOKS_CHROOT_{{ loop.index0 }}='{{ hook | string }}'
{% endfor %}

# --hooks-binary
# List of hook names to run during the binary stage.
# Each hook is exported with an index suffix to allow multiple hooks.
{% for hook in (ansible_run_hosts | default([])) | list %}
export LB_HOOKS_BINARY_{{ loop.index0 }}='{{ hook | string }}'
{% endfor %}

# --linux-flavours
# List of Linux kernel flavours to install (e.g., 686-pae, amd64, armmp).
{% for flavour in (ansible_run_hosts | default(["amd64"])) | list %}
export LB_LINUX_FLAVOURS_{{ loop.index0 }}='{{ flavour | string }}'
{% endfor %}

# --media-name
# Volume ID/media name for the generated image.
export LB_MEDIA_NAME='{{ (ansible_run_hosts | default("Debian Live")) | string }}'

# --parent-archive-aod
# Enable APT On Demand (add parent archive to chroot sources).
{% if (ansible_run_hosts | default(false)) is boolean and (ansible_run_hosts | default(false)) %}
export LB_PARENT_ARCHIVE_AOD='1'
{% endif %}

# --parent-archive-aof
# Add parent archive to final live image sources.
{% if (ansible_run_hosts | default(false)) is boolean and (ansible_run_hosts | default(false)) %}
export LB_PARENT_ARCHIVE_AOF='1'
{% endif %}

# --parents
# List of parent archive URIs or sources.
{% for parent in (ansible_run_hosts | default([])) | list %}
export LB_PARENTS_{{ loop.index0 }}='{{ parent | string }}'
{% endfor %}

# --primary-arch
# Primary architecture for package selection.
# Falls back to the target architecture if not explicitly set.
export LB_PRIMARY_ARCH='{{ ((ansible_run_hosts | default(ansible_run_hosts)) | default("amd64")) | string }}'

# --secondary-arch
# Secondary architecture for package selection.
# Falls back to the target architecture if not explicitly set.
export LB_SECONDARY_ARCH='{{ ((ansible_run_hosts | default(ansible_run_hosts)) | default("amd64")) | string }}'

# --source-iso
# Generate a source ISO image.
{% if (ansible_run_hosts | default(false)) is boolean and (ansible_run_hosts | default(false)) %}
export LB_SOURCE_ISO='1'
{% endif %}

# --type
# Type of image to generate (e.g., iso-hybrid, tar, hdd, netboot, onie).
export LB_TYPE='{{ (ansible_run_hosts | default("iso-hybrid")) | string }}'

# --archive-areas
# Apt archive areas to use (e.g., main contrib non-free).
export LB_ARCHIVE_AREAS='{{ (ansible_run_hosts | default("main contrib")) | string }}'