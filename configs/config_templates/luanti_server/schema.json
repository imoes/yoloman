{
  "world_dir": {
    "type": "string",
    "default": "/var/lib/luanti/worlds/main",
    "description": "Directory where world data is stored"
  },
  "bind_to": {
    "type": "string",
    "default": "",
    "description": "IP address to bind server to (empty = all interfaces)"
  },
  "port": {
    "type": "number",
    "default": 30000,
    "description": "TCP port for client connections"
  },
  "server_name": {
    "type": "string",
    "default": "Luanti Server",
    "description": "Public name of your server (shown in server list)"
  },
  "server_description": {
    "type": "string",
    "default": "A friendly Luanti server",
    "description": "Short description displayed below server name"
  },
  "server_url": {
    "type": "string",
    "default": "",
    "description": "URL to server website (e.g., forum, rules)"
  },
  "admin_email": {
    "type": "string",
    "default": "",
    "description": "Admin contact email (not publicly displayed)"
  },
  "max_users": {
    "type": "number",
    "default": 10,
    "description": "Maximum simultaneous players"
  },
  "enable_remote_media_server": {
    "type": "boolean",
    "default": true,
    "description": "Enable remote media server (required for custom textures/models)"
  },
  "pvp_mode": {
    "type": "boolean",
    "default": true,
    "description": "Allow players to attack each other"
  },
  "default_privs": {
    "type": "list",
    "default": [
      "interact",
      "chat"
    ],
    "items": {
      "type": "string",
      "enum": [
        "admin",
        "ban",
        "privs",
        "kick",
        "teleport",
        "give",
        "settime",
        "fly",
        "noclip",
        "debug",
        "area_claim",
        "home",
        "sethome",
        "setspawn",
        "spawn",
        "settime",
        "setweather",
        "settime",
        "settime",
        "settime"
      ]
    },
    "description": "Default player privileges (comma-separated in config)"
  },
  "economy_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Enable economy features (e.g., for currency-based mods)"
  },
  "protect_spawn_radius": {
    "type": "number",
    "default": 10,
    "description": "Radius (in nodes) around spawn point protected from modification"
  },
  "anticheat_enabled": {
    "type": "boolean",
    "default": true,
    "description": "Enable built-in anticheat (basic movement and speed checks)"
  },
  "allow_flying": {
    "type": "boolean",
    "default": false,
    "description": "Allow players to fly (usually requires priv)"
  },
  "unlimited_flying": {
    "type": "boolean",
    "default": false,
    "description": "Allow unlimited flying (bypass stamina)"
  },
  "voice_chat_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Enable in-game voice chat (requires Voice mod and media server)"
  },
  "chat_logging_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Log chat messages to file"
  },
  "chat_message_limit": {
    "type": "number",
    "default": 256,
    "description": "Maximum length of a chat message (characters)"
  },
  "chat_rate_limit": {
    "type": "number",
    "default": 3,
    "description": "Minimum seconds between chat messages"
  },
  "damage_enabled": {
    "type": "boolean",
    "default": true,
    "description": "Enable player damage from falls, mobs, etc."
  },
  "hunger_enabled": {
    "type": "boolean",
    "default": true,
    "description": "Enable hunger mechanics (requires Hunger mod)"
  },
  "difficulty": {
    "type": "number",
    "default": 1,
    "description": "Difficulty: 0=peaceful, 1=easy, 2=normal, 3=hard"
  },
  "physics_speed": {
    "type": "number",
    "default": 1.0,
    "description": "Global physics speed multiplier"
  },
  "time_speed": {
    "type": "number",
    "default": 1.0,
    "description": "Day-night cycle speed multiplier"
  },
  "world_generation": {
    "type": "object",
    "default": {
      "name": "v6",
      "seed": "",
      "size": "1",
      "flags": ""
    },
    "items": {
      "name": {
        "type": "string",
        "default": "v6",
        "description": "Mapgen name (e.g., v6, v7, singlenode)"
      },
      "seed": {
        "type": "string",
        "default": "",
        "description": "World seed (leave empty for random)"
      },
      "size": {
        "type": "string",
        "default": "1",
        "description": "Mapgen chunk size (usually 1)"
      },
      "flags": {
        "type": "string",
        "default": "",
        "description": "Mapgen flags, comma-separated (e.g., 'caves, dungeons')"
      }
    }
  },
  "secure_enable_security": {
    "type": "boolean",
    "default": true,
    "description": "Enforce mod security (only trusted mods allowed)"
  },
  "trusted_mod_dirs": {
    "type": "list",
    "default": [
      "/usr/share/luanti/mods"
    ],
    "items": {
      "type": "string"
    },
    "description": "Directories containing trusted mods"
  },
  "motd": {
    "type": "string",
    "default": "A Luanti server",
    "description": "Message of the day (shown to players on connect)"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Server password (empty = open server)"
  },
  "enable_heartbeat": {
    "type": "boolean",
    "default": true,
    "description": "Enable server heartbeat (required for public listing)"
  },
  "server_announce": {
    "type": "boolean",
    "default": true,
    "description": "Announce server to public Minetest server list"
  },
  "server_announce_url": {
    "type": "string",
    "default": "https://servers.minetest.net",
    "description": "Public server list URL"
  },
  "server_announce_timeout": {
    "type": "number",
    "default": 60,
    "description": "Heartbeat interval (seconds)"
  },
  "enable_console": {
    "type": "boolean",
    "default": false,
    "description": "Enable interactive console (Ctrl+T in dedicated mode)"
  },
  "console_buffer_size": {
    "type": "number",
    "default": 1000,
    "description": "Console command history size"
  },
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Minimum log level (none, error, warning, info, debug)"
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/luanti/server.log",
    "description": "Path to server log file"
  },
  "log_stderr": {
    "type": "boolean",
    "default": true,
    "description": "Output logs to stderr (console)"
  },
  "max_block_send_dist": {
    "type": "number",
    "default": 10,
    "description": "Maximum block send distance (rendering range)"
  },
  "simul_distance": {
    "type": "number",
    "default": 10,
    "description": "Maximum simulation distance (nodes)"
  },
  "min_time_between_sends": {
    "type": "number",
    "default": 50,
    "description": "Minimum time between player sends (ms)"
  },
  "send_queue_low_water_mark": {
    "type": "number",
    "default": 20,
    "description": "Low-water mark for send queue (chunks)"
  },
  "send_queue_high_water_mark": {
    "type": "number",
    "default": 100,
    "description": "High-water mark for send queue (chunks)"
  },
  "max_pending_sends": {
    "type": "number",
    "default": 50,
    "description": "Max pending outgoing sends"
  },
  "sends_per_second": {
    "type": "number",
    "default": 0,
    "description": "Max sends per second (0 = unlimited)"
  },
  "max_packets_per_send": {
    "type": "number",
    "default": 20,
    "description": "Max packets per send"
  },
  "max_packets_per_receive": {
    "type": "number",
    "default": 50,
    "description": "Max packets per receive"
  },
  "network_compression": {
    "type": "number",
    "default": 7,
    "description": "Network packet compression level (1\u20139)"
  },
  "network_compression_world": {
    "type": "number",
    "default": 5,
    "description": "World data compression level (1\u20139)"
  },
  "enable_ipv6": {
    "type": "boolean",
    "default": true,
    "description": "Enable IPv6 support"
  },
  "ssl_enable": {
    "type": "boolean",
    "default": false,
    "description": "Enable SSL/TLS for remote media and HTTP (requires cert/key)"
  },
  "ssl_cert": {
    "type": "string",
    "default": "",
    "description": "SSL certificate chain file (PEM format)"
  },
  "ssl_key": {
    "type": "string",
    "default": "",
    "description": "SSL private key file (PEM format)"
  },
  "ssl_ca_file": {
    "type": "string",
    "default": "",
    "description": "SSL CA certificate file (for client auth)"
  },
  "enable_map_saving": {
    "type": "boolean",
    "default": true,
    "description": "Persist world changes to disk"
  },
  "map_compression_level": {
    "type": "number",
    "default": 2,
    "description": "Map storage compression (0=none, 1=fast, 2=best)"
  },
  "world_backup_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable automatic world backups"
  },
  "world_backup_interval": {
    "type": "number",
    "default": 720,
    "description": "Backup interval (minutes)"
  },
  "world_backup_max_files": {
    "type": "number",
    "default": 5,
    "description": "Max backup files to retain"
  },
  "world_backup_path": {
    "type": "string",
    "default": "/var/lib/luanti/backups",
    "description": "Directory for world backups"
  },
  "enable_vfs_write": {
    "type": "boolean",
    "default": false,
    "description": "Allow VFS writes (development only \u2014 security risk)"
  },
  "enable_http": {
    "type": "boolean",
    "default": true,
    "description": "Enable built-in HTTP server (for remote media)"
  },
  "http_port": {
    "type": "number",
    "default": 30001,
    "description": "HTTP server port"
  },
  "http_address": {
    "type": "string",
    "default": "",
    "description": "HTTP server bind address (empty = all)"
  },
  "http_max_connections": {
    "type": "number",
    "default": 50,
    "description": "Max simultaneous HTTP connections"
  },
  "http_requests_per_second": {
    "type": "number",
    "default": 20,
    "description": "Max HTTP requests per second per connection"
  },
  "http_request_timeout": {
    "type": "number",
    "default": 30000,
    "description": "HTTP request timeout (ms)"
  },
  "http_response_timeout": {
    "type": "number",
    "default": 30000,
    "description": "HTTP response timeout (ms)"
  },
  "http_max_request_size": {
    "type": "number",
    "default": 10485760,
    "description": "Max HTTP request size (bytes)"
  },
  "http_max_response_size": {
    "type": "number",
    "default": 104857600,
    "description": "Max HTTP response size (bytes)"
  },
  "http_max_upload_size": {
    "type": "number",
    "default": 104857600,
    "description": "Max upload size per request (bytes)"
  },
  "http_upload_timeout": {
    "type": "number",
    "default": 120000,
    "description": "Upload timeout (ms)"
  },
  "http_upload_max_files": {
    "type": "number",
    "default": 100,
    "description": "Max files per upload"
  },
  "http_upload_allowed_extensions": {
    "type": "list",
    "default": [
      ".png",
      ".dds",
      ".webp",
      ".ogg",
      ".mp3",
      ".json"
    ],
    "items": {
      "type": "string"
    },
    "description": "Allowed file extensions for uploads"
  },
  "http_upload_path": {
    "type": "string",
    "default": "/var/lib/luanti/http_upload",
    "description": "Local path for uploaded files"
  },
  "http_upload_quota": {
    "type": "number",
    "default": 1073741824,
    "description": "Total upload quota per user (bytes)"
  },
  "http_upload_rate_limit": {
    "type": "number",
    "default": 1048576,
    "description": "Upload rate limit (bytes/s)"
  },
  "http_upload_burst": {
    "type": "number",
    "default": 5242880,
    "description": "Upload burst size (bytes)"
  },
  "http_upload_max_concurrent": {
    "type": "number",
    "default": 5,
    "description": "Max simultaneous uploads"
  },
  "http_upload_allowed_ips": {
    "type": "list",
    "default": [
      "127.0.0.1",
      "::1"
    ],
    "items": {
      "type": "string"
    },
    "description": "Allowed source IPs for uploads"
  },
  "http_upload_deny_ips": {
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    },
    "description": "Denied source IPs for uploads"
  },
  "http_upload_require_auth": {
    "type": "boolean",
    "default": true,
    "description": "Require admin auth for uploads"
  },
  "http_upload_admin_user": {
    "type": "string",
    "default": "admin",
    "description": "Admin username for upload auth"
  },
  "http_upload_admin_pass": {
    "type": "string",
    "default": "",
    "description": "Admin password for upload auth (hash if stored)"
  }
}
