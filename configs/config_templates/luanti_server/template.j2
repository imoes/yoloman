# Luanti (Minetest) server configuration
# Generated via Jinja2 template — do not edit manually; use configuration management

# Base directory for world data
world_dir = {{ world_dir }}

# Server listen address (empty = all interfaces)
bind_to = {{ bind_to | default('') }}

# Port to listen on
port = {{ port }}

# Server name displayed in server list
server_name = {{ server_name }}

# Server description
server_description = {{ server_description }}

# URL for server website (shown in client server list)
server_url = {{ server_url | default('') }}

# Admin email (optional)
admin_email = {{ admin_email | default('') }}

# Maximum number of players
max_users = {{ max_users }}

# Enable remote access (required for public servers)
enable_remote_media_server = {{ enable_remote_media_server | lower }}

# Enable PVP
pvp_mode = {{ pvp_mode | lower }}

# Enable creative mode for new players by default
default_privs = {{ default_privs | join(', ') }}

# Enable digital currency (economy) mod support
economy_enabled = {{ economy_enabled | lower }}

# Enable spawn point protection radius (0 = disabled)
protect_spawn_radius = {{ protect_spawn_radius }}

# Enable anticheat (basic built-in)
anticheat_enabled = {{ anticheat_enabled | lower }}

# Enable flight for players
allow_flying = {{ allow_flying | lower }}

# Enable unlimited flying (if allow_flying)
unlimited_flying = {{ unlimited_flying | lower }}

# Enable voice chat
voice_chat_enabled = {{ voice_chat_enabled | lower }}

# Enable chat logging
chat_logging_enabled = {{ chat_logging_enabled | lower }}

# Chat message limit (characters)
chat_message_limit = {{ chat_message_limit }}

# Chat rate limit (seconds between messages)
chat_rate_limit = {{ chat_rate_limit }}

# Enable damage (e.g., from falls, mobs)
damage_enabled = {{ damage_enabled | lower }}

# Enable hunger
hunger_enabled = {{ hunger_enabled | lower }}

# Default difficulty
difficulty = {{ difficulty }}

# Enable physics speed (multiplier)
physics_speed = {{ physics_speed }}

# Enable time speed (multiplier)
time_speed = {{ time_speed }}

# World generation parameters
world_generation_name = {{ world_generation.name }}
world_generation_seed = {{ world_generation.seed | default('') }}
world_generation_size = {{ world_generation.size | default('1') }}
world_generation_flags = {{ world_generation.flags | join(',') }}

# Enable mod security (if enabled, mods must be in world directory or trusted)
secure_enable_security = {{ secure_enable_security | lower }}

# Trusted mod directories
{% for mod_dir in trusted_mod_dirs %}
trusted_mods_{{ loop.index }} = {{ mod_dir }}
{% endfor %}

# Server motd (message of the day)
motd = {{ motd | default('A Luanti server') }}

# Default player password (if empty, no password required)
password = {{ password | default('') }}

# Enable server announcement (to Minetest server list)
enable_heartbeat = {{ enable_heartbeat | lower }}

# Public server listing
server_announce = {{ server_announce | lower }}

# Announce URL (public server list)
server_announce_url = {{ server_announce_url | default('https://servers.minetest.net') }}

# Server list timeout
server_announce_timeout = {{ server_announce_timeout }}

# Enable dedicated server mode (prevents GUI)
dedicated = true

# Enable console
enable_console = {{ enable_console | lower }}

# Console buffer size (lines)
console_buffer_size = {{ console_buffer_size }}

# Log level (none, error, warning, info, debug)
log_level = {{ log_level }}

# Log file path
log_file = {{ log_file }}

# Log to stdout
log_stderr = {{ log_stderr | lower }}

# Max block send distance (rendering range, in blocks)
max_block_send_dist = {{ max_block_send_dist }}

# Maximum simulation distance (in nodes)
simul_distance = {{ simul_distance }}

# Minimum time between sends (ms)
min_time_between_sends = {{ min_time_between_sends }}

# Send queue low-water mark (chunks)
send_queue_low_water_mark = {{ send_queue_low_water_mark }}

# Send queue high-water mark (chunks)
send_queue_high_water_mark = {{ send_queue_high_water_mark }}

# Max pending sends
max_pending_sends = {{ max_pending_sends }}

# Max sends per second (0 = unlimited)
sends_per_second = {{ sends_per_second }}

# Max packets per send
max_packets_per_send = {{ max_packets_per_send }}

# Max packets per receive
max_packets_per_receive = {{ max_packets_per_receive }}

# Network compression level (1–9)
network_compression = {{ network_compression }}

# Network compression level for world data
network_compression_world = {{ network_compression_world }}

# Enable IPv6
enable_ipv6 = {{ enable_ipv6 | lower }}

# Use SSL for remote media (if enabled)
ssl_enable = {{ ssl_enable | lower }}

# SSL certificate file (if enabled)
ssl_cert = {{ ssl_cert | default('') }}

# SSL key file (if enabled)
ssl_key = {{ ssl_key | default('') }}

# Trusted CA file
ssl_ca_file = {{ ssl_ca_file | default('') }}

# Enable map saving
enable_map_saving = {{ enable_map_saving | lower }}

# Map compression (0 = none, 1 = fast, 2 = best)
map_compression_level = {{ map_compression_level }}

# Enable automatic world backup
world_backup_enable = {{ world_backup_enable | lower }}

# Backup interval (minutes)
world_backup_interval = {{ world_backup_interval }}

# Max backup files
world_backup_max_files = {{ world_backup_max_files }}

# World backup path
world_backup_path = {{ world_backup_path }}

# Enable VFS write (for mod development only)
enable_vfs_write = {{ enable_vfs_write | lower }}

# Enable built-in HTTP server (for remote media)
enable_http = {{ enable_http | lower }}

# HTTP server port
http_port = {{ http_port }}

# HTTP server address (empty = all)
http_address = {{ http_address | default('') }}

# HTTP max connections
http_max_connections = {{ http_max_connections }}

# HTTP max requests per connection
http_requests_per_second = {{ http_requests_per_second }}

# HTTP request timeout (ms)
http_request_timeout = {{ http_request_timeout }}

# HTTP response timeout (ms)
http_response_timeout = {{ http_response_timeout }}

# HTTP max request size (bytes)
http_max_request_size = {{ http_max_request_size }}

# HTTP max response size (bytes)
http_max_response_size = {{ http_max_response_size }}

# HTTP max upload size (bytes)
http_max_upload_size = {{ http_max_upload_size }}

# HTTP upload timeout (ms)
http_upload_timeout = {{ http_upload_timeout }}

# HTTP upload max files
http_upload_max_files = {{ http_upload_max_files }}

# HTTP upload allowed extensions
http_upload_allowed_extensions = {{ http_upload_allowed_extensions | join(',') }}

# HTTP upload path
http_upload_path = {{ http_upload_path }}

# HTTP upload quota (bytes)
http_upload_quota = {{ http_upload_quota }}

# HTTP upload rate limit (bytes/s)
http_upload_rate_limit = {{ http_upload_rate_limit }}

# HTTP upload burst (bytes)
http_upload_burst = {{ http_upload_burst }}

# HTTP upload max concurrent
http_upload_max_concurrent = {{ http_upload_max_concurrent }}

# HTTP upload allowed IPs
{% for ip in http_upload_allowed_ips %}
http_upload_allow_ip_{{ loop.index }} = {{ ip }}
{% endfor %}

# HTTP upload deny IPs
{% for ip in http_upload_deny_ips %}
http_upload_deny_ip_{{ loop.index }} = {{ ip }}
{% endfor %}

# HTTP upload require auth
http_upload_require_auth = {{ http_upload_require_auth | lower }}

# HTTP upload admin user
http_upload_admin_user = {{ http_upload_admin_user | default('') }}

# HTTP upload admin pass
http_upload_admin_pass = {{ http_upload_admin_pass | default('') }}
