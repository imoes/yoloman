{
  "default_hosts": [],
  "http_fallback": "127.0.0.1:9090",
  "http_hosts": [
    {
      "pattern": "app.example.test",
      "target": "192.0.2.50:8080"
    }
  ],
  "http_listen": 8081,
  "https_hosts": [
    {
      "pattern": ".*\\.example\\.test$",
      "target": "192.0.2.60:443"
    }
  ],
  "https_listen": 8443,
  "log_priority": "info",
  "pidfile": "/run/sniproxy.pid",
  "user": "daemon"
}
