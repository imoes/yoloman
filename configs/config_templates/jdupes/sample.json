{
  "directories": [
    "/home/user/photos",
    "/mnt/backup/photos"
  ],
  "action": "delete",
  "auto_delete": true,
  "exclude_hidden": false,
  "one_file_system": true,
  "ignore_hard_links": false,
  "follow_symlinks": false,
  "recurse": true,
  "sort_order": "time",
  "exclude_extensions": [
    "tmp",
    "cache"
  ],
  "include_extensions": [
    "jpg",
    "png"
  ],
  "exclude_substrings": [
    "trash",
    "temp"
  ],
  "include_substrings": [],
  "hash_db": "",
  "chunk_size": 0,
  "print_info": "none",
  "summarize": true,
  "quiet": false,
  "loud": false,
  "reverse": false,
  "omit_first": false,
  "check_permissions": true,
  "match_zero_length": false,
  "quick": false,
  "soft_abort": false,
  "json_output": false,
  "error_on_dupes": false,
  "isolate": false,
  "param_order": false,
  "show_size": true,
  "partial_only": false,
  "no_trav_check": false,
  "print_unique": false,
  "print_summarize": false,
  "use_dedupe": false
}
