# ==============================================================================
# jdupes configuration
# ==============================================================================
# This file defines how jdupes scans for duplicate files and what action to take.
# It maps directly to jdupes command-line flags.
# ==============================================================================

# ------------------------------------------------------------------------------
# Scanning Directories
# Description: List of directory paths to scan for duplicates.
# Each directory is printed on its own line.
# ------------------------------------------------------------------------------
{% for dir in directories | default([], true) %}
{{ dir }}
{% endfor %}

# ------------------------------------------------------------------------------
# Action Mode
# Description: The primary action to take on duplicate files.
# Valid values: print, delete, hard-link, soft-link, dedupe, link-hard, link-soft
# Default: print
# ------------------------------------------------------------------------------
action={{ action | default('print') }}

# ------------------------------------------------------------------------------
# Auto Delete
# Description: If true, automatically delete duplicates without prompting.
# Requires action=delete.
# Default: false
# ------------------------------------------------------------------------------
auto_delete={{ auto_delete | default(false) }}

# ------------------------------------------------------------------------------
# Exclude Hidden Files
# Description: Exclude hidden files (starting with .) from consideration.
# Default: false
# ------------------------------------------------------------------------------
exclude_hidden={{ exclude_hidden | default(false) }}

# ------------------------------------------------------------------------------
# One File System
# Description: Do not match files that are on different filesystems.
# Default: false
# ------------------------------------------------------------------------------
one_file_system={{ one_file_system | default(false) }}

# ------------------------------------------------------------------------------
# Ignore Hard Links
# Description: Normally hard links are treated as non-duplicates; this option
# changes that behavior, treating them as potential duplicates to match.
# Default: false
# ------------------------------------------------------------------------------
ignore_hard_links={{ ignore_hard_links | default(false) }}

# ------------------------------------------------------------------------------
# Follow Symlinks
# Description: Follow symlinked directories during recursion.
# Default: false
# ------------------------------------------------------------------------------
follow_symlinks={{ follow_symlinks | default(false) }}

# ------------------------------------------------------------------------------
# Recurse
# Description: Recurse into subdirectories of the given directories.
# Default: false
# ------------------------------------------------------------------------------
recurse={{ recurse | default(false) }}

# ------------------------------------------------------------------------------
# Sort Order
# Description: Sort order for matches.
# Valid values: name, time
# Default: name
# ------------------------------------------------------------------------------
sort_order={{ sort_order | default('name') }}

# ------------------------------------------------------------------------------
# Exclude Extensions
# Description: List of file extensions to exclude (e.g., 'txt').
# Comma-separated in output, no leading dot.
# Default: []
# ------------------------------------------------------------------------------
exclude_extensions={{ exclude_extensions | default([], true) | join(',') }}

# ------------------------------------------------------------------------------
# Include Extensions
# Description: List of file extensions to include only (e.g., 'jpg').
# Comma-separated in output, no leading dot.
# Default: []
# ------------------------------------------------------------------------------
include_extensions={{ include_extensions | default([], true) | join(',') }}

# ------------------------------------------------------------------------------
# Exclude Substrings
# Description: List of substrings to exclude from file paths (e.g., 'cache/').
# Comma-separated in output.
# Default: []
# ------------------------------------------------------------------------------
exclude_substrings={{ exclude_substrings | default([], true) | join(',') }}

# ------------------------------------------------------------------------------
# Include Substrings
# Description: List of substrings that must be present in file paths (e.g., 'photos/').
# Comma-separated in output.
# Default: []
# ------------------------------------------------------------------------------
include_substrings={{ include_substrings | default([], true) | join(',') }}

# ------------------------------------------------------------------------------
# Hash Database
# Description: Path to a hash database file for caching results.
# Use '.' for default 'jdupes_hashdb.txt'.
# Default: ''
# ------------------------------------------------------------------------------
hash_db={{ hash_db | default('') }}

# ------------------------------------------------------------------------------
# Chunk Size
# Description: I/O chunk size in KiB. 0 uses default.
# Default: 0
# ------------------------------------------------------------------------------
chunk_size={{ chunk_size | default(0) }}

# ------------------------------------------------------------------------------
# Print Info
# Description: Print extra info during scanning.
# Valid values: early, partial, fullhash, none
# Default: none
# ------------------------------------------------------------------------------
print_info={{ print_info | default('none') }}

# ------------------------------------------------------------------------------
# Summarize
# Description: Summarize duplicate file information at the end of execution.
# Default: false
# ------------------------------------------------------------------------------
summarize={{ summarize | default(false) }}

# ------------------------------------------------------------------------------
# Quiet Mode
# Description: Hide progress indicator.
# Default: false
# ------------------------------------------------------------------------------
quiet={{ quiet | default(false) }}

# ------------------------------------------------------------------------------
# Loud Mode
# Description: Output low-level debug info.
# Default: false
# ------------------------------------------------------------------------------
loud={{ loud | default(false) }}

# ------------------------------------------------------------------------------
# Reverse Sort
# Description: Reverse (invert) the sort order of matches.
# Default: false
# ------------------------------------------------------------------------------
reverse={{ reverse | default(false) }}

# ------------------------------------------------------------------------------
# Omit First
# Description: Omit the first file in each set of matches.
# Default: false
# ------------------------------------------------------------------------------
omit_first={{ omit_first | default(false) }}

# ------------------------------------------------------------------------------
# Check Permissions
# Description: Don't consider files with different owner/group or permissions
# as duplicates.
# Default: false
# ------------------------------------------------------------------------------
check_permissions={{ check_permissions | default(false) }}

# ------------------------------------------------------------------------------
# Match Zero Length
# Description: Consider zero-length files to be duplicates.
# Default: false
# ------------------------------------------------------------------------------
match_zero_length={{ match_zero_length | default(false) }}

# ------------------------------------------------------------------------------
# Quick Mode
# Description: Skip byte-for-byte verification.
# RISK: RISK OF DATA LOSS. Use with caution.
# Default: false
# ------------------------------------------------------------------------------
quick={{ quick | default(false) }}

# ------------------------------------------------------------------------------
# Soft Abort
# Description: Act on matches found before user aborts (CTRL-C).
# Default: false
# ------------------------------------------------------------------------------
soft_abort={{ soft_abort | default(false) }}

# ------------------------------------------------------------------------------
# JSON Output
# Description: Produce JSON output instead of plain text.
# Default: false
# ------------------------------------------------------------------------------
json_output={{ json_output | default(false) }}

# ------------------------------------------------------------------------------
# Error On Dupes
# Description: Exit with status 255 if any duplicate is found.
# Default: false
# ------------------------------------------------------------------------------
error_on_dupes={{ error_on_dupes | default(false) }}

# ------------------------------------------------------------------------------
# Isolate
# Description: Isolate command-line parameters; only match files under
# different parameter specs.
# Default: false
# ------------------------------------------------------------------------------
isolate={{ isolate | default(false) }}

# ------------------------------------------------------------------------------
# Param Order
# Description: Preserve parameter order in results.
# Default: false
# ------------------------------------------------------------------------------
param_order={{ param_order | default(false) }}

# ------------------------------------------------------------------------------
# Show Size
# Description: Show size of duplicate files.
# Default: false
# ------------------------------------------------------------------------------
show_size={{ show_size | default(false) }}

# ------------------------------------------------------------------------------
# Partial Only
# Description: Match based on hash of first block only.
# RISK: EXTREME RISK of false positives. Requires -T -T in CLI.
# Default: false
# ------------------------------------------------------------------------------
partial_only={{ partial_only | default(false) }}

# ------------------------------------------------------------------------------
# No Trav Check
# Description: Disable double-traversal safety check.
# Default: false
# ------------------------------------------------------------------------------
no_trav_check={{ no_trav_check | default(false) }}

# ------------------------------------------------------------------------------
# Print Unique
# Description: Print only unique (non-duplicate) files.
# Default: false
# ------------------------------------------------------------------------------
print_unique={{ print_unique | default(false) }}

# ------------------------------------------------------------------------------
# Print Summarize
# Description: Print matches and summarize at the end.
# Default: false
# ------------------------------------------------------------------------------
print_summarize={{ print_summarize | default(false) }}

# ------------------------------------------------------------------------------
# Use Dedupe
# Description: Call ioctl/clonefile() for Copy-on-Write deduplication.
# Default: false
# ------------------------------------------------------------------------------
use_dedupe={{ use_dedupe | default(false) }}