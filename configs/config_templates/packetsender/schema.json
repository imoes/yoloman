{
  "protocol": {
    "type": "string",
    "default": "tcp",
    "description": "Protocol to use: tcp, udp, ssl, http",
    "enum": [
      "tcp",
      "udp",
      "ssl",
      "http"
    ]
  },
  "address": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Destination address"
  },
  "port": {
    "type": "number",
    "default": 8080,
    "description": "Destination port"
  },
  "data": {
    "type": "string",
    "default": "Hello World",
    "description": "Data payload to send"
  },
  "wait": {
    "type": "number",
    "default": 0,
    "description": "Wait time in milliseconds for a response"
  },
  "bindip": {
    "type": "string",
    "default": "",
    "description": "Bind custom IP address"
  },
  "bindport": {
    "type": "number",
    "default": 0,
    "description": "Bind port"
  },
  "ipv4": {
    "type": "bool",
    "default": false,
    "description": "Force IPv4"
  },
  "ipv6": {
    "type": "bool",
    "default": false,
    "description": "Force IPv6"
  },
  "hex": {
    "type": "bool",
    "default": true,
    "description": "Parse data as hex"
  },
  "ascii": {
    "type": "bool",
    "default": false,
    "description": "Parse data as mixed-ascii"
  },
  "pure_ascii": {
    "type": "bool",
    "default": false,
    "description": "Parse data as pure ascii"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Quiet mode"
  },
  "bps": {
    "type": "number",
    "default": 0,
    "description": "Intense traffic: bits per second"
  },
  "num": {
    "type": "number",
    "default": 0,
    "description": "Intense traffic: number of packets"
  },
  "rate": {
    "type": "number",
    "default": 0,
    "description": "Intense traffic: rate in Hertz"
  },
  "usdelay": {
    "type": "number",
    "default": 0,
    "description": "Intense traffic: resend delay in microseconds"
  }
}
