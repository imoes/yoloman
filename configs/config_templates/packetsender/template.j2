# Packetsender Configuration Template
# Self-documenting: all variables use schema defaults via `| default(...)`

# Protocol to use: tcp, udp, ssl, http
protocol: {{ protocol | default('tcp') }}

# Destination address
address: {{ address | default('127.0.0.1') }}

# Destination port
port: {{ port | default(8080) }}

# Data payload to send
data: {{ data | default('Hello World') }}

# Wait time in milliseconds for a response
wait: {{ wait | default(0) }}

# Bind custom IP address
bindip: {{ bindip | default('') }}

# Bind port
bindport: {{ bindport | default(0) }}

# Force IPv4
ipv4: {{ ipv4 | default(false) }}

# Force IPv6
ipv6: {{ ipv6 | default(false) }}

# Parse data as hex
hex: {{ hex | default(true) }}

# Parse data as mixed-ascii
ascii: {{ ascii | default(false) }}

# Parse data as pure ascii
pure_ascii: {{ pure_ascii | default(false) }}

# Quiet mode
quiet: {{ quiet | default(false) }}

# Intense traffic: bits per second
bps: {{ bps | default(0) }}

# Intense traffic: number of packets
num: {{ num | default(0) }}

# Intense traffic: rate in Hertz
rate: {{ rate | default(0) }}

# Intense traffic: resend delay in microseconds
usdelay: {{ usdelay | default(0) }}