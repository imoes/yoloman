# AIDE (Advanced Intrusion Detection Environment) configuration
# Version: {{ aide_version }}
# Generated by configuration management

# Database settings
DB_DIR = {{ db_dir }}
DB_FILE = {{ db_file }}
DB_URL = {{ db_url }}

# Log settings
LOG_FILE = {{ log_file }}

# Compression of database (none|gz|bzip2)
DATABASE_COMPRESS = {{ db_compress }}

# Enable/Disable verbose output
VERBOSE = {{ verbose | lower }}

# Path to the database (used at init time)
DATABASE_NEW = {{ db_new }}

# Reread configuration at startup
REREAD_CONF = {{ reread_conf | lower }}

# Maximum number of symbolic links to follow
SYMLINK_COUNT = {{ symlink_count }}

# Time to wait for user input during init (seconds)
TIMEOUT = {{ timeout }}

# Rule definitions
{% for rule in rules %}# {{ rule.name }}: {{ rule.desc | default('Custom rule') }}
{{ rule.name }} = {{ rule.expression }}
{% endfor %}

# File list definitions
{% for group in file_groups %}
# Group: {{ group.name }} — {{ group.desc | default('File group') }}
{{ group.name }} = {% for path in group.paths %}{{ path }}{% if not loop.last %} + {% endif %}{% endfor %}
{% endfor %}

# Rule-to-group mappings (which rules apply to which groups)
{% for mapping in mappings %}
# Mapping: {{ mapping.name }} — {{ mapping.desc | default('Rule-group mapping') }}
{{ mapping.name }} = {{ mapping.group }} {{ mapping.rules | join(' ') }}
{% endfor %}

# Default rule set to use
{% if default_rule_set %}
{% for name in default_rule_set %}{{ name }}
{% endfor %}
{% else %}
# (No default rule set specified)
{% endif %}
