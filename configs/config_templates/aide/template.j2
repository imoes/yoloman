# AIDE (Advanced Intrusion Detection Environment) configuration
# Version: {{ aide_version | default('5.4') }}
# Generated by configuration management

# Database settings
# Directory where the AIDE database files are stored.
DB_DIR = {{ db_dir | default('/var/lib/aide') }}

# Filename of the active AIDE database (relative to DB_DIR).
DB_FILE = {{ db_file | default('aide.db.gz') }}

# URL (or file path) to the database used at runtime (used by --check).
# Uses the configured db_dir and db_file with appropriate defaults.
DB_URL = {{ (db_url | default('file://{{ db_dir }}/{{ db_file }}')) | replace('{{ db_dir }}', db_dir | default('/var/lib/aide')) | replace('{{ db_file }}', db_file | default('aide.db.gz')) }}

# Log settings
# Path to the AIDE log file for integrity check reports.
LOG_FILE = {{ log_file | default('/var/log/aide/aide.log') }}

# Compression of database (none|gz|bzip2)
# Compression type for the database: 'none', 'gz', or 'bzip2'.
DATABASE_COMPRESS = {{ db_compress | default('gz') }}

# Enable/Disable verbose output
# Enable verbose output during database operations (true/false).
VERBOSE = {{ verbose | default(False) | lower }}

# Path to the database (used at init time)
# Filename used when building a new database (relative to DB_DIR).
DATABASE_NEW = {{ db_new | default('aide.db.new') }}

# Reread configuration at startup
# Whether AIDE should reread the config file on startup.
REREAD_CONF = {{ reread_conf | default(True) | lower }}

# Maximum number of symbolic links to follow
# Maximum number of symbolic links to follow during a scan.
SYMLINK_COUNT = {{ symlink_count | default(5) }}

# Time to wait for user input during init (seconds)
# Seconds to wait for interactive input during init (0 = no timeout).
TIMEOUT = {{ timeout | default(0) }}

# Rule definitions
# Defines the checksums and attributes to check for each rule set.
{% for rule in rules | default([{'name': 'Basic', 'desc': 'Standard file attributes and checksums', 'expression': 'p+u+g+acl+selinux+xattrs+sha256'}, {'name': 'Dir', 'desc': 'Directories only', 'expression': 'p+u+g+acl+selinux+xattrs+sha256+dir'}, {'name': 'All', 'desc': 'All attributes including inode and timestamps', 'expression': 'p+u+g+acl+selinux+xattrs+sha256+atime+ctime+inode+mtime+size'}]) %}
# {{ rule.name | default('Unnamed Rule') }}: {{ rule.desc | default('Custom rule') }}
{{ rule.name | default('Unnamed Rule') }} = {{ rule.expression | default('p+u+g') }}
{% endfor %}

# File list definitions
# Groups files together for easier rule application.
{% for group in file_groups | default([{'name': 'Bin', 'desc': 'Essential system binaries', 'paths': ['/bin', '/sbin', '/usr/bin', '/usr/sbin']}, {'name': 'Etc', 'desc': 'Configuration files', 'paths': ['/etc', '/etc/passwd', '/etc/group', '/etc/hosts', '/etc/ssh']}, {'name': 'Logs', 'desc': 'Log files (only check for changes in existence/size)', 'paths': ['/var/log']}]) %}
# Group: {{ group.name | default('Unnamed Group') }} — {{ group.desc | default('File group') }}
{{ group.name | default('Unnamed Group') }} = {% for path in group.paths | default([]) %}{{ path }}{% if not loop.last %} + {% endif %}{% endfor %}
{% endfor %}

# Rule-to-group mappings (which rules apply to which groups)
# Maps rule sets to the file groups they should monitor.
{% for mapping in mappings | default([{'name': 'FullSystem', 'desc': 'Default mapping for the entire filesystem', 'group': 'Bin Etc', 'rules': 'Basic Dir'}]) %}
# Mapping: {{ mapping.name | default('Unnamed Mapping') }} — {{ mapping.desc | default('Rule-group mapping') }}
{{ mapping.name | default('Unnamed Mapping') }} = {{ mapping.group | default('') }} {{ mapping.rules | default([]) | join(' ') }}
{% endfor %}

# Default rule set to use
# List of rule-set names (from 'mappings') to use by default.
{% if default_rule_set | default(['FullSystem']) %}
{% for name in default_rule_set | default(['FullSystem']) %}{{ name }}
{% endfor %}
{% else %}
# (No default rule set specified)
{% endif %}