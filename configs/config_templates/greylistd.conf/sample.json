{
  "enabled": true,
  "socket_path": "/var/run/greylistd/socket",
  "db_dir": "/var/lib/greylistd",
  "db_type": "sqlite",
  "db_file": "/var/lib/greylistd/greylist.db",
  "expires": 172800,
  "retry_delay": 300,
  "max_retry_delay": 86400,
  "delay": 60,
  "whitelist_networks": [
    "127.0.0.0/8",
    "10.0.0.0/8"
  ],
  "dnsbl_whitelist": [
    "zen.spamhaus.org"
  ],
  "log_level": "info",
  "log_file": "/var/log/greylistd.log",
  "rate_limit": true,
  "rate_limit_max": 15,
  "rate_limit_window": 60,
  "syslog": true,
  "experimental": false,
  "custom_headers": [
    {
      "key": "X-Greylist-Sender",
      "value": "%s"
    },
    {
      "key": "X-Greylist-Reason",
      "value": "deferred per policy"
    }
  ]
}
