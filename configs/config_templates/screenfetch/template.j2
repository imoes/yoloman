# screenfetch CLI configuration template
# Generated by gonja Jinja2 engine

# Command: screenfetch [OPTIONS]

# -o 'VAR="VAL";...'
# Set script variables via command line. This is the primary mechanism for
# customization as screenfetch does not use a standard config file.
# We construct the string of variable assignments here.
SCREENFETCH_CMD_ARGS="-o "
SCREENFETCH_CMD_ARGS="{{ SCREENFETCH_CMD_ARGS }}{% for kv in custom_vars %}{{ kv.key }}="{{ kv.value }}";{% endfor %}"

# -d '+var;-var'
# Control which information blocks are displayed.
# Defaults to 'kernel;distro;uptime;shell;packages;memory;cpu;gpu'.
# You can add (+var) or remove (-var) blocks.
DISPLAY_INFO="{% if display_info %}{{ display_info | join(',') }}{% else %}kernel;distro;uptime;shell;packages;memory;cpu{% endif %}"

# -c 'COLOR1;COLOR2'
# Set output colors. Format: [0-9][0-9],[0-9][0-9].
# COLOR1: Logo and label colors. COLOR2: Info text colors.
# If empty, uses default auto-detection or ANSI defaults.
OUTPUT_COLORS="{{ colors_string | default('44;48,37;39') }}"

# -n
# Disable ASCII distribution logo.
# If true, -n flag is added.
NO_ASCII="{% if no_ascii %}-n {% endif %}"

# -p
# Portrait mode (logo above info).
PORTRAIT="{% if portrait %}-p {% endif %}"

# -N
# Strip all color.
NO_COLOR="{% if no_color %}-N {% endif %}"

# -v
# Verbose output.
VERBOSE="{% if verbose %}-v {% endif %}"

# -s
# Take screenshot.
# Note: Requires a screenshot tool like scrot or gnome-screenshot.
SCREENSHOT="{% if screenshot %}-s {% endif %}"

# -u IMGHOST
# Upload screenshot to predefined host if -s is used.
UPLOAD_HOST="{% if screenshot and upload_host %}-u {{ upload_host }} {% endif %}"

# Final command construction
# This represents the shell command that would be executed.
# In a real deployment, this might be wrapped in a script or cron job.
echo "Executing: screenfetch {{ NO_ASCII }}{{ PORTRAIT }}{{ NO_COLOR }}{{ VERBOSE }}{{ SCREENSHOT }}{{ UPLOAD_HOST }}-c {{ OUTPUT_COLORS }}-d {{ DISPLAY_INFO }}{{ SCREENFETCH_CMD_ARGS }}"
