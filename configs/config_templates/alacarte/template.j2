{# ============================================================================== #}
{# Alacarte Menu Editor Configuration                                           #}
{#                                                                              #}
{# This file configures the XDG Base Directory paths used by Alacarte,          #}
{# a GNOME-based menu editor for managing application menus. It adheres to      #}
{# the freedesktop.org XDG Base Directory Specification to determine where      #}
{# system-wide and user-specific menu definitions are stored and searched.      #}
{#                                                                              #}
{# Variables:                                                                   #}
{#   xdg_config_dirs:   Colon-separated list of directories to search for      #}
{#                      system-wide menu files.                                #}
{#   xdg_data_dirs:     Colon-separated list of directories to search for      #}
{#                      desktop entries.                                       #}
{#   xdg_config_home:   User-specific directory for configuration data         #}
{#                      (menu modifications).                                  #}
{#   xdg_data_home:     User-specific directory for data files                 #}
{#                      (new/modified desktop entries).                        #}
{#   xdg_menu_prefix:   Prefix applied to the main menu file name (e.g.,       #}
{#                      'gnome-' results in 'gnome-applications.menu').        #}
{# ============================================================================== #}

# --------------------------------------------------------------------------
# Menu file search path(s)
# Colon-separated list of directories to search for menu files.
# Default is /etc/xdg.
# --------------------------------------------------------------------------
XDG_CONFIG_DIRS={{ (xdg_config_dirs | default(['/etc/xdg'])) | join(':') }}

# --------------------------------------------------------------------------
# Desktop file search path(s)
# Colon-separated list of directories to search for desktop files.
# Default includes /usr/local/share and /usr/share.
# --------------------------------------------------------------------------
XDG_DATA_DIRS={{ (xdg_data_dirs | default(['/usr/local/share', '/usr/share'])) | join(':') }}

# --------------------------------------------------------------------------
# User-specific menu file location
# Directory for user-specific menu files (modified menus).
# Default is ~/.config.
# --------------------------------------------------------------------------
XDG_CONFIG_HOME={{ xdg_config_home | default('~/.config') }}

# --------------------------------------------------------------------------
# User-specific desktop file location
# Directory for user-specific desktop files (new/modified applications).
# Default is ~/.local/share.
# --------------------------------------------------------------------------
XDG_DATA_HOME={{ xdg_data_home | default('~/.local/share') }}

# --------------------------------------------------------------------------
# Menu prefix for main menu file
# Prefix for the main menu file name (e.g., 'gnome-' results in
# gnome-applications.menu). Empty string uses applications.menu.
# --------------------------------------------------------------------------
XDG_MENU_PREFIX={{ xdg_menu_prefix | default('') }}