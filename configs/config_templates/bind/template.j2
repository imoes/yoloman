{# ============================================================================= #}
{# BIND9 (named) main configuration file template                                  #}
{# This template generates named.conf options, logging, ACLs, trusted-keys,       #}
{# zone declarations, and optional views. It is self-documenting: every directive #}
{# is preceded by a comment derived from the schema description.                  #}
{# ============================================================================= #}

{# Global options block for the DNS server named process #}
options {

    {# Listen for IPv4 DNS queries on the configured port and addresses. #}
    {%- if bind_listen_on_ipv4 | default(true) %}
    listen-on port {{ bind_port | default(53) }} {
        {{ bind_listen_on | default(['127.0.0.1']) | join(', ') }};
    };
    {%- endif %}

    {# Listen for IPv6 DNS queries on the configured port and addresses. #}
    {%- if bind_listen_on_ipv6 | default(false) %}
    listen-on-v6 port {{ bind_port | default(53) }} {
        {{ bind_listen_on_v6 | default([]) | join(', ') }};
    };
    {%- endif %}

    {# Working directory for the DNS server where zone files are stored by default. #}
    {%- if bind_directory is defined and bind_directory %}
    directory "{{ bind_directory }}";
    {%- else %}
    directory "/var/cache/bind";
    {%- endif %}

    {# Path to the PID file for the named process. #}
    {%- if bind_pid_file is defined and bind_pid_file %}
    pid-file "{{ bind_pid_file }}";
    {%- else %}
    pid-file "/run/named/named.pid";
    {%- endif %}

    {# Allow recursive queries (required for forwarder/resolver operation). #}
    {%- if bind_recursion | default(true) %}
    recursion yes;
    {%- else %}
    recursion no;
    {%- endif %}

    {# List of ACLs or IP ranges permitted to submit queries. #}
    {%- if bind_allow_query is defined and bind_allow_query | length > 0 %}
    allow-query {
        {{ bind_allow_query | join(', ') }};
    };
    {%- else %}
    allow-query { any; };
    {%- endif %}

    {# List of upstream DNS servers to forward queries to (if recursion is enabled). #}
    {%- if bind_forwarders is defined and bind_forwarders | length > 0 %}
    forwarders {
        {# Note: Forwarders entries are terminated with semicolons in BIND. #}
        {{ bind_forwarders | join('; ') }};
    };
    {%- endif %}

    {# When forwarding, only forward (don’t try root resolution if forwarder fails). #}
    {%- if bind_forward_only | default(false) %}
    forward only;
    {%- else %}
    forward first;
    {%- endif %}

    {# Enable DNSSEC validation (set to false to disable). #}
    {%- if bind_dnssec_validation | default(true) %}
    dnssec-validation auto;
    {%- else %}
    dnssec-validation no;
    {%- endif %}

    {# Enable DNSSEC processing globally. #}
    {%- if bind_dnssec_enabled | default(false) %}
    dnssec-enable yes;
    {%- else %}
    dnssec-enable no;
    {%- endif %}

    {# Accept non-authoritative answers from upstream servers (for stub zones or special setups). #}
    {%- if bind_accept_foreign | default(false) %}
    accept-foreign yes;
    {%- else %}
    accept-foreign no;
    {%- endif %}

    {# Maximum cache size (e.g., '512M', '1G') — 0 means unlimited. #}
    {%- if bind_max_cache_size is defined and bind_max_cache_size %}
    max-cache-size {{ bind_max_cache_size }};
    {%- endif %}

    {# Enable verbose query logging (querylog directive). #}
    {%- if bind_log_queries | default(false) %}
    querylog yes;
    {%- endif %}
};

{# Define logging configuration channels and categories #}
logging {

    {# List of logging channel definitions. Each item defines where and how to log. #}
    {%- if bind_logging_channels is defined and bind_logging_channels | length > 0 %}
    {%- for channel in bind_logging_channels %}
    channel {{ channel.name | default('default') }} {
        {# Destination: file path with size/rotation, syslog facility, or /dev/null. #}
        {%- if channel.file is defined and channel.file %}
        file "{{ channel.file }}" {{ channel.max_size | default('10m') }} {{ channel.versions | default(3) }};
        {%- elif channel.syslog is defined %}
        syslog {{ channel.syslog }};
        {%- elif channel.null is defined %}
        null;
        {%- endif %}

        {# Log severity level (e.g., dynamic, notice, warning, error). #}
        {%- if channel.severity is defined %}
        severity {{ channel.severity }};
        {%- endif %}

        {# Include timestamp information in log entries. #}
        {%- if channel.print_time is defined %}
        print-time {{ 'yes' if channel.print_time else 'no' }};
        {%- endif %}
    };
    {%- endfor %}

    {# List of log categories and the channels they bind to. #}
    {%- if bind_logging_categories is defined and bind_logging_categories | length > 0 %}
    {%- for category in bind_logging_categories %}
    category {{ category.name | default('default') }} {
        {{ category.channels | join(', ') }};
    };
    {%- endfor %}
    {%- endif %}
    {%- endif %}
};

{# Define access control lists (ACLs) for reuse in allow-query/transfer/etc. #}
{%- if bind_acls is defined and bind_acls | length > 0 %}
{%- for acl in bind_acls %}
acl {{ acl.name }} {
    {%- for item in acl.items %}
    {{ item }};
    {%- endfor %}
};
{%- endfor %}
{%- endif %}

{# Define trusted keys for DNSSEC (used for trust anchor validation). #}
{%- if bind_trusted_keys is defined and bind_trusted_keys | length > 0 %}
trusted-keys {
    {%- for key in bind_trusted_keys %}
    "{{ key.name }}" {{ key.flags }} {{ key.protocol }} {{ key.algorithm }} "{{ key.public_key }}";
    {%- endfor %}
};
{%- endif %}

{# Define zone definitions for authoritative serving. #}
{%- if bind_zones is defined and bind_zones | length > 0 %}
{%- for zone in bind_zones %}
zone "{{ zone.name }}" {

    {# Zone type: master, slave, stub, hint, or other valid BIND zone types. #}
    {%- if zone.type == 'master' %}
    type master;
    file "{{ zone.file }}";
    {%- elif zone.type == 'slave' %}
    type slave;
    file "{{ zone.file }}";
    masters {
        {{ zone.masters | join(', ') }};
    };
    {%- elif zone.type == 'stub' %}
    type stub;
    masters {
        {{ zone.masters | join(', ') }};
    };
    {%- elif zone.type == 'hint' %}
    type hint;
    file "{{ zone.file }}";
    {%- else %}
    type {{ zone.type }};
    {%- endif %}

    {# List of ACLs or IP ranges permitted to submit queries for this zone. #}
    {%- if zone.allow_query is defined and zone.allow_query | length > 0 %}
    allow-query {
        {{ zone.allow_query | join(', ') }};
    };
    {%- endif %}

    {# List of ACLs or IP ranges permitted to request zone transfers. #}
    {%- if zone.allow_transfer is defined and zone.allow_transfer | length > 0 %}
    allow-transfer {
        {{ zone.allow_transfer | join(', ') }};
    };
    {%- endif %}

    {# Enable or disable NOTIFY messages for this zone. #}
    {%- if zone.notify is defined %}
    notify {{ 'yes' if zone.notify else 'no' }};
    {%- endif %}

    {# List of ACLs or IP ranges permitted to perform AXFR/IXFR transfers (alias for allow-transfer). #}
    {%- if zone.xfers is defined and zone.xfers | length > 0 %}
    allow-xfers {
        {{ zone.xfers | join(', ') }};
    };
    {%- endif %}

    {# Check zone record names for validity (error, warn, ignore). #}
    {%- if zone.check_names is defined %}
    check-names {{ zone.check_names }};
    {%- endif %}

    {# Enable or disable DNSSEC validation for this specific zone. #}
    {%- if zone.dnssec is defined %}
    dnssec-{{ 'enable' if zone.dnssec else 'disable' }};
    {%- endif %}
};
{%- endfor %}
{%- endif %}

{# Optional view block for split-horizon DNS or conditional responses. #}
{%- if bind_views is defined and bind_views | length > 0 %}
{%- for view in bind_views %}
view "{{ view.name }}" {

    {# List of client IP addresses or ACLs matching this view. #}
    {%- if view.match_clients is defined and view.match_clients | length > 0 %}
    match-clients {
        {{ view.match_clients | join(', ') }};
    };
    {%- endif %}

    {# List of destination IP addresses matching this view. #}
    {%- if view.match_destinations is defined and view.match_destinations | length > 0 %}
    match-destinations {
        {{ view.match_destinations | join(', ') }};
    };
    {%- endif %}

    {# List of query source addresses matching this view. #}
    {%- if view.match_query_sources is defined and view.match_query_sources | length > 0 %}
    match-query-source {
        {{ view.match_query_sources | join(', ') }};
    };
    {%- endif %}

    {# Allow recursive queries within this view. #}
    {%- if view.recursion is defined %}
    recursion {{ 'yes' if view.recursion else 'no' }};
    {%- else %}
    recursion yes;
    {%- endif %}

    {# List of authoritative zones served within this view. #}
    {%- if view.zones is defined and view.zones | length > 0 %}
    {%- for zone in view.zones %}
    zone "{{ zone.name }}" {

        {# Zone type: master, slave, stub, hint, or other valid BIND zone types. #}
        {%- if zone.type == 'master' %}
        type master;
        file "{{ zone.file }}";
        {%- elif zone.type == 'slave' %}
        type slave;
        file "{{ zone.file }}";
        masters {
            {{ zone.masters | join(', ') }};
        };
        {%- elif zone.type == 'stub' %}
        type stub;
        masters {
            {{ zone.masters | join(', ') }};
        };
        {%- else %}
        type {{ zone.type }};
        {%- endif %}

        {# List of ACLs or IP ranges permitted to submit queries for this zone. #}
        {%- if zone.allow_query is defined and zone.allow_query | length > 0 %}
        allow-query {
            {{ zone.allow_query | join(', ') }};
        };
        {%- endif %}

        {# List of ACLs or IP ranges permitted to request zone transfers. #}
        {%- if zone.allow_transfer is defined and zone.allow_transfer | length > 0 %}
        allow-transfer {
            {{ zone.allow_transfer | join(', ') }};
        };
        {%- endif %}
    };
    {%- endfor %}
    {%- endif %}
};
{%- endfor %}
{%- endif %}