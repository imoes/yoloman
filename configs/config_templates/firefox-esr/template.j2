// ============================================================================
// Firefox ESR - Debian-specific preferences file (auto-generated by Ansible)
// ============================================================================
// This file is located at /etc/firefox-esr/debian.cfg (or similar path).
// It overrides Firefox preferences defined in about:config.
// Format: pref("preference.name", value, modifier);
// Modifiers allowed: "locked" (user cannot change), "sticky" (user can change
// but Firefox resets it on profile upgrade).
// ============================================================================

// --- Extension Update Behavior ---
// If true, enables automatic extension updates (overrides Firefox default behavior).
// Default: true
pref("extensions.update.enabled", {{ extensions_update_enabled | default(true) | lower }});

// --- Locale Configuration ---
// Use LANG environment variable to choose locale. Empty string lets Firefox
// fall back to the system locale.
// Note: This is a standard Debian pref, not managed by role variables.
pref("intl.locale.requested", "");

// --- Default Browser Check ---
// Disable the check for being the default browser.
// Standard Firefox behavior, kept explicitly for clarity.
pref("browser.shell.checkDefaultBrowser", false);

// --- OpenH264 Codec ---
// If true, DISABLES the OpenH264 codec.
// OpenH264 is used for WebRTC H.264 video support.
// Default: false (codec is enabled)
pref("media.gmp-gmpopenh264.enabled", {{ disable_openh264 | default(false) | lower }});

// --- Enhanced NewTab Content ---
// Controls the "enhanced" (suggested) content on about:newtab.
// If true, disables enhanced content, showing the classic simple view.
// Modifier "sticky" means the user can change it, but Firefox will reset it
// during profile upgrades/updates.
// Default: false (enhanced content is enabled)
pref("browser.newtabpage.enhanced", {{ disable_enhanced_newtab | default(false) | lower }}, sticky);

// --- Health Report Uploads ---
// If true, DISABLES uploading of health reports (crash data, usage metrics)
// to Mozilla servers.
// Default: false (uploads are enabled)
pref("datareporting.healthreport.uploadEnabled", {{ disable_healthreport_upload | default(false) | lower }});

// --- URL Bar Search Suggestions ---
// If true, DISABLES search suggestions in the URL bar.
// This includes history, bookmarks, and matching searches.
// Note: On first use, Firefox may still ask the user to opt-in to suggestions.
// Default: false (suggestions are enabled)
pref("browser.urlbar.suggest.searches", {{ disable_urlbar_search_suggestions | default(false) | lower }});