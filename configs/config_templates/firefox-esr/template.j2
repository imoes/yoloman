// =============================================================================
// Firefox ESR - Debian Specific Preferences (policies.js / user.js style)
// =============================================================================
// This file overrides default Firefox behavior via policy or user preferences.
// All boolean values must be literal `true` or `false` (no quotes).
// =============================================================================

// -----------------------------------------------------------------------------
// Extension Updates
// -----------------------------------------------------------------------------
// If true, enables extension updates (overrides Firefox default behavior).
pref("extensions.update.enabled", {{ extensions_update_enabled | default('true') }});

// -----------------------------------------------------------------------------
// Locale Configuration
// -----------------------------------------------------------------------------
// Use LANG environment variable to choose locale.
pref("intl.locale.requested", "{{ extensions_update_enabled | default('') }}");

// -----------------------------------------------------------------------------
// Default Browser Check
// -----------------------------------------------------------------------------
// Disable default browser checking.
pref("browser.shell.checkDefaultBrowser", false);

// -----------------------------------------------------------------------------
// Media Codecs (OpenH264)
// -----------------------------------------------------------------------------
// If true, disables the OpenH264 codec (used for WebRTC H.264 video).
// Note: The schema name is 'disable_openh264', so if this var is true, we
// set the preference to false to disable it. If the var is false, we set
// the preference to true (default behavior).
pref("media.gmp-gmpopenh264.enabled", {% if disable_openh264 | default(false) %}false{% else %}true{% endif %});

// -----------------------------------------------------------------------------
// New Tab Page (Enhanced Content)
// -----------------------------------------------------------------------------
// If true, disables enhanced (suggested) content on about:newtab (classic view only).
// Note: The schema name is 'disable_enhanced_newtab', so if this var is true,
// we set the preference to false (disable enhanced content). If false, we set
// the preference to true (enable enhanced content).
pref("browser.newtabpage.enhanced", {% if disable_enhanced_newtab | default(false) %}false{% else %}true{% endif %}, sticky);

// -----------------------------------------------------------------------------
// Health Reports
// -----------------------------------------------------------------------------
// If true, disables uploading of health reports (crash data, usage metrics).
// Note: The schema name is 'disable_healthreport_upload', so if this var is
// true, we set the preference to false.
pref("datareporting.healthreport.uploadEnabled", {% if disable_healthreport_upload | default(false) %}false{% else %}true{% endif %});

// -----------------------------------------------------------------------------
// URL Bar Search Suggestions
// -----------------------------------------------------------------------------
// If true, disables search suggestions in the URL bar (including history/matching).
// Note: The schema name is 'disable_urlbar_search_suggestions', so if this var
// is true, we set the preference to false.
pref("browser.urlbar.suggest.searches", {% if disable_urlbar_search_suggestions | default(false) %}false{% else %}true{% endif %});
