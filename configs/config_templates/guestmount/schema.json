{
  "disks": {
    "type": "list",
    "default": [],
    "description": "List of disk image paths to add (required unless -d/-i used); each item is a path string. Example: [\"/var/lib/libvirt/images/win10.qcow2\"]"
  },
  "mounts": {
    "type": "list",
    "default": [],
    "description": "List of mount specifications; each entry has dev (required), optional mountpoint, options, fstype"
  },
  "mounts.items.dev": {
    "type": "string",
    "default": "",
    "description": "Device path (e.g., /dev/sda1, /dev/VG/LV, or /dev/disk/by-uuid/...)",
    "enum": [
      "/dev/sda1",
      "/dev/VG/LV"
    ]
  },
  "mounts.items.mountpoint": {
    "type": "string",
    "default": "",
    "description": "Guest mountpoint (e.g., /, /boot). If omitted, defaults to /"
  },
  "mounts.items.options": {
    "type": "string",
    "default": "",
    "description": "Mount options (e.g., acl,user_xattr). If omitted, uses default (empty or ro)"
  },
  "mounts.items.fstype": {
    "type": "string",
    "default": "",
    "description": "Filesystem driver (e.g., ext3, ntfs)"
  },
  "mounts.items.description": {
    "type": "string",
    "default": "",
    "description": "Optional human-readable description comment"
  },
  "ro": {
    "type": "bool",
    "default": true,
    "description": "Mount read-only (true) or read-write (false)"
  },
  "domain": {
    "type": "string",
    "default": "",
    "description": "Libvirt domain name or UUID to use (requires -i for auto-mount)"
  },
  "inspector": {
    "type": "bool",
    "default": false,
    "description": "Enable inspection to auto-detect guest mounts"
  },
  "fuse_opts": {
    "type": "list",
    "default": [],
    "description": "List of extra FUSE -o options (e.g., [{\"name\":\"allow_other\"}])"
  },
  "fuse_opts.items.name": {
    "type": "string",
    "default": "",
    "description": "FUSE option name (required)"
  },
  "fuse_opts.items.value": {
    "type": "string",
    "default": "",
    "description": "FUSE option value (optional)"
  },
  "fuse_opts.items.description": {
    "type": "string",
    "default": "",
    "description": "Optional human-readable description"
  },
  "blocksize": {
    "type": "number",
    "default": 512,
    "description": "Sector size in bytes (e.g., 512 or 4096). Default is 512."
  },
  "format": {
    "type": "string",
    "default": "",
    "description": "Force image format (raw, qcow2, vmdk, etc.)",
    "enum": [
      "raw",
      "qcow2"
    ]
  },
  "trace": {
    "type": "bool",
    "default": false,
    "description": "Enable tracing of libguestfs calls"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output"
  },
  "pid_file": {
    "type": "string",
    "default": "",
    "description": "Path to write guestmount worker PID for safe shutdown"
  },
  "keys": {
    "type": "list",
    "default": [],
    "description": "List of key definitions for LUKS devices"
  },
  "keys.items.target": {
    "type": "string",
    "default": "",
    "description": "Device target: /dev/sda1, UUID=..., or 'all'"
  },
  "keys.items.kind": {
    "type": "string",
    "default": "",
    "description": "Key source type: 'key', 'file', or 'clevis'",
    "enum": [
      "key",
      "file",
      "clevis"
    ]
  },
  "keys.items.source": {
    "type": "string",
    "default": "",
    "description": "Key string, file path, or 'clevis'"
  },
  "dir_cache_timeout": {
    "type": "number",
    "default": 60,
    "description": "Directory cache timeout in seconds. Default is 60."
  },
  "no_fork": {
    "type": "bool",
    "default": false,
    "description": "Do not fork into background (for captive use)"
  },
  "no_sync": {
    "type": "bool",
    "default": false,
    "description": "Disable sync on unmount"
  },
  "fd": {
    "type": "number",
    "default": 0,
    "description": "File descriptor for signaling readiness"
  },
  "echo_keys": {
    "type": "bool",
    "default": false,
    "description": "Echo key input (not recommended in production)"
  },
  "keys_from_stdin": {
    "type": "bool",
    "default": false,
    "description": "Read keys from stdin"
  },
  "connect_uri": {
    "type": "string",
    "default": "",
    "description": "Libvirt URI to connect to (e.g., qemu:///system)"
  }
}
