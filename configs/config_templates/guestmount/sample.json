{
  "disks": [
    {
      "path": "/var/lib/libvirt/images/win10.qcow2"
    }
  ],
  "mounts": [
    {
      "dev": "/dev/sda1",
      "mountpoint": "/",
      "description": "Main Windows NTFS partition"
    }
  ],
  "ro": true,
  "fuse_opts": [
    {
      "name": "allow_other",
      "value": "",
      "description": "Allow other users to see the mount"
    },
    {
      "name": "kernel_cache",
      "value": "",
      "description": "Enable kernel-side file caching"
    },
    {
      "name": "uid",
      "value": "1000",
      "description": "Map all guest UIDs to host 1000"
    },
    {
      "name": "use_ino",
      "value": "",
      "description": "Preserve underlying inode numbers"
    }
  ],
  "pid_file": "/tmp/guestmount-win10.pid",
  "dir_cache_timeout": 30,
  "verbose": true
}
