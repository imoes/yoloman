# Global definitions
{{ global_definitions | default('# Global definitions\nglobal_defs {\n  # Notification email settings\n  notification_email {\n    admin@example.com\n  }\n  notification_email_from keepalived@example.com\n  smtp_server 127.0.0.1\n  smtp_connect_timeout 30\n  # Optional: LVS ID (must match across cluster)\n  # lvs_id VIRTUAL_SERVER_1\n}\n' | indent(0, true) }}

# VRRP instance configuration (failover + health checks)
{% for instance in vrrp_instances %}
# {{ instance.name }}: {{ instance.description | default('VRRP instance') }}
vrrp_instance {{ instance.name }} {
  # State: MASTER or BACKUP
  state {{ instance.state | upper }}

  # Interface to bind to (e.g., eth0, eno1)
  interface {{ instance.interface }}

  # Virtual Router ID (0–255; must be unique per VRRP domain)
  virtual_router_id {{ instance.virtual_router_id }}

  # Priority (0–255; higher = preferred master)
  priority {{ instance.priority }}

  # Advert interval in seconds (default 1)
  advert_int {{ instance.advert_int | default(1) }}

{% if instance.authentication is defined and instance.authentication.enabled %}
  # Authentication settings (pre-shared key for VRRP traffic)
  authentication {
    auth_type {{ instance.authentication.type | upper | default('PASS') }}
    auth_pass {{ instance.authentication.password }}
  }
{% endif %}

{% if instance.vips is defined and instance.vips | length > 0 %}
  # Virtual IP(s) (one or more for load distribution)
{% for vip in instance.vips %}
  virtual_ipaddress {
    {{ vip.address | default('') }}{% if vip.dev is defined %}/{{ vip.dev }}{% endif %}{% if vip.scope is defined %} scope {{ vip.scope }}{% endif %}
  }
{% endfor %}
{% endif %}

{% if instance.vroutes is defined and instance.vroutes | length > 0 %}
  # Virtual routes
{% for route in instance.vroutes %}
  virtual_routes {
    to {{ route.to | default('') }}{% if route.dev is defined %} dev {{ route.dev }}{% endif %}{% if route.gw is defined %} via {{ route.gw }}{% endif %}{% if route.scope is defined %} scope {{ route.scope }}{% endif %}
  }
{% endfor %}
{% endif %}

{% if instance.track_scripts is defined %}
  # Track scripts for dynamic priority adjustment
{% for script in track_scripts %}
  track_script {
    {{ script.name }}{% if script.weight is defined %} weight {{ script.weight }}{% endif %}
  }
{% endfor %}
{% endif %}

{% if instance.preempt | default(true) == false %}
  # Disable preemption (prevent抢回 master on recovery)
  preempt_no_delay
{% endif %}

{% if instance.nopreempt | default(false) %}
  # Non-preemptive mode: never抢回 master
  nopreempt
{% endif %}

{% if instance.garp_master_delay is defined %}
  # Delay before sending gratuitous ARP after becoming MASTER (seconds)
  garp_master_delay {{ instance.garp_master_delay }}
{% endif %}

{% if instance.smtp_alert is defined %}
  # Send email alerts on state change
  smtp_alert
{% endif %}

{% if instance.notify_master is defined %}
  # Command to run on MASTER transition
  notify_master "{{ instance.notify_master }}"
{% endif %}

{% if instance.notify_backup is defined %}
  # Command to run on BACKUP transition
  notify_backup "{{ instance.notify_backup }}"
{% endif %}

{% if instance.notify_fault is defined %}
  # Command to run on FAULT transition
  notify_fault "{{ instance.notify_fault }}"
{% endif %}

{% if instance.notify_stop is defined %}
  # Command to run when instance stops
  notify_stop "{{ instance.notify_stop }}"
{% endif %}

{% if instance.notify is defined %}
  # Generic notify script (receives type, instance name, state)
  notify "{{ instance.notify }}"
{% endif %}

{% if instance.use_vmac is defined %}
  # Use VMAC (Virtual MAC) for VRRP
{% if instance.use_vmac %}
  use_vmac
{% else %}
  # use_vmac explicitly disabled
  # use_vmac
{% endif %}
{% endif %}

{% if instance.vmac_iface is defined %}
  # Custom VMAC interface name
  vmac_iface {{ instance.vmac_iface }}
{% endif %}

{% if instance.dns_redirect is defined %}
  # Redirect DNS queries to VIP
{% if instance.dns_redirect %}
  dns_redirect
{% endif %}
{% endif %}

{% if instance.debug is defined %}
  # Enable debug logging for this instance
  debug
{% endif %}

{% if instance.track_interface is defined %}
  # Track additional interfaces for failure detection
{% for iface in track_interface %}
  track_interface {
    interface {{ iface.name | default(iface) }}{% if iface.weight is defined %} weight {{ iface.weight }}{% endif %}
  }
{% endfor %}
{% endif %}

}
{% endfor %}

# Virtual server definitions (for LVS)
{% for vs in lvs_virtual_servers %}
# {{ vs.name }}: LVS virtual server
virtual_server {{ vs.ip }} {{ vs.port }} {
  #LB algo: rr|wrr|lc|wlc|lblc|sh|dh|lblcr (see docs)
  lb_algo {{ vs.lb_algo | default('wlc') }}

  #LB kind: NAT|DR|TUN
  lb_kind {{ vs.lb_kind | default('NAT') | upper }}

{% if vs.protocol | default('TCP') | upper != 'TCP' %}
  # Protocol: TCP, UDP, SCTP
  protocol {{ vs.protocol | upper }}
{% endif %}

  # Delay between health checks (seconds)
  delay_loop {{ vs.delay_loop | default(2) }}

{% if vs.ha_pause is defined %}
  # Time to wait before re-checking after failure (seconds)
  ha_pause {{ vs.ha_pause }}
{% endif %}

{% if vs.hello is defined %}
  # HELLO interval (for LVS mirror)
  hello {{ vs.hello }}
{% endif %}

{% if vs.hello_timeout is defined %}
  # HELLO timeout
  hello_timeout {{ vs.hello_timeout }}
{% endif %}

{% if vs.connect_timeout is defined %}
  # TCP connect timeout (seconds)
  connect_timeout {{ vs.connect_timeout }}
{% endif %}

{% if vs.connect_retries is defined %}
  # TCP connection retries before declaring failure
  connect_retries {{ vs.connect_retries }}
{% endif %}

{% if vs.smooth_transit is defined %}
  # Smooth transition: gradually shift traffic during recovery
  smooth_transit
{% endif %}

{% if vs.real_server_retry is defined %}
  # Retry interval for failed real servers (seconds)
  real_server_retry {{ vs.real_server_retry }}
{% endif %}

{% if vs.delay_before_retry is defined %}
  # Delay before retrying a failed server
  delay_before_retry {{ vs.delay_before_retry }}
{% endif %}

{% if vs.timeout is defined %}
  # General timeout (seconds)
  timeout {{ vs.timeout }}
{% endif %}

{% if vs.alpha is defined %}
  # Alpha mode: assume all servers down initially
{% if vs.alpha %}
  alpha
{% endif %}
{% endif %}

{% if vs.omega is defined %}
  # Omega mode: run notify_stop on all real servers when failover ends
{% if vs.omega %}
  omega
{% endif %}
{% endif %}

{% if vs.http_get is defined %}
  # HTTP health check
  http_get {
    url {
      path {{ vs.http_get.path | default('/') }}
{% if vs.http_get.digest is defined %}
      digest {{ vs.http_get.digest }}
{% endif %}
{% if vs.http_get.status is defined %}
      status {{ vs.http_get.status | join(',') }}
{% endif %}
    }
{% if vs.http_get.port is defined %}
    port {{ vs.http_get.port }}
{% endif %}
{% if vs.http_get.connect_timeout is defined %}
    connect_timeout {{ vs.http_get.connect_timeout }}
{% endif %}
{% if vs.http_get.ssl is defined %}
{% if vs.http_get.ssl %}
    ssl
{% endif %}
{% endif %}
  }
{% endif %}

{% if vs.ssl_hh is defined %}
  # SSL health check
  ssl_hh {
    host {{ vs.ssl_hh.host | default(vs.ip) }}
    port {{ vs.ssl_hh.port | default(443) }}
{% if vs.ssl_hh.path is defined %}
    path {{ vs.ssl_hh.path }}
{% endif %}
  }
{% endif %}

{% if vs.dns_hh is defined %}
  # DNS health check
  dns_hh {
    host {{ vs.dns_hh.host | default('') }}
    port {{ vs.dns_hh.port | default(53) }}
{% if vs.dns_hh.query is defined %}
    query {{ vs.dns_hh.query | tojson }}
{% endif %}
{% if vs.dns_hh.timeout is defined %}
    timeout {{ vs.dns_hh.timeout }}
{% endif %}
  }
{% endif %}

{% if vs.tcp_check is defined %}
  # TCP port check
  tcp_check {
    port {{ vs.tcp_check.port }}
{% if vs.tcp_check.connect_timeout is defined %}
    connect_timeout {{ vs.tcp_check.connect_timeout }}
{% endif %}
{% if vs.tcp_check.connect_retries is defined %}
    connect_retries {{ vs.tcp_check.connect_retries }}
{% endif %}
  }
{% endif %}

{% if vs.smtp_check is defined %}
  # SMTP health check
  smtp_check {
    host {{ vs.smtp_check.host | default(vs.ip) }}
    port {{ vs.smtp_check.port | default(25) }}
{% if vs.smtp_check.connect_timeout is defined %}
    connect_timeout {{ vs.smtp_check.connect_timeout }}
{% endif %}
{% if vs.smtp_check.hello is defined %}
    smtp_helo {{ vs.smtp_check.hello }}
{% endif %}
{% if vs.smtp_check.timeout is defined %}
    timeout {{ vs.smtp_check.timeout }}
{% endif %}
  }
{% endif %}

{% if vs.udp_check is defined %}
  # UDP check (send/receive pattern)
  udp_check {
    port {{ vs.udp_check.port }}
{% if vs.udp_check.send is defined %}
    send {{ vs.udp_check.send | tojson }}
{% endif %}
{% if vs.udp_check.expect is defined %}
    expect {{ vs.udp_check.expect | tojson }}
{% endif %}
{% if vs.udp_check.connect_timeout is defined %}
    connect_timeout {{ vs.udp_check.connect_timeout }}
{% endif %}
  }
{% endif %}

{% if vs.firewall_mark is defined %}
  # Use iptables FWMark instead of IP:port
  firewall_mark {{ vs.firewall_mark }}
{% endif %}

{% if vs.scheduler is defined %}
  # LVS scheduler (same as lb_algo for compatibility)
  scheduler {{ vs.scheduler }}
{% endif %}

{% if vs persistence_timeout is defined %}
  # Persistence timeout (seconds); 0 disables
  persistence_timeout {{ vs.persistence_timeout | default(0) }}
{% endif %}

{% if vs persistence_granularity is defined %}
  # Netmask for persistence (e.g., 255.255.255.255 for per-client)
  persistence_granularity {{ vs.persistence_granularity | default('0.0.0.0') }}
{% endif %}

{% if vs.ftp_persistence is defined %}
  # Enable FTP persistence
{% if vs.ftp_persistence %}
  ftp_persistence
{% endif %}
{% endif %}

{% if vs.vs_source is defined %}
  # Virtual server source IP (for LVS mirror)
  vs_source {{ vs.vs_source }}
{% endif %}

{% if vs.delay_loop is defined and vs.delay_loop > 0 %}
{% if vs.real_servers | length > 0 %}
  # Real servers (backends)
{% for rs in vs.real_servers %}
  real_server {{ rs.ip }} {{ rs.port }} {
{% if rs.weight is defined %}
    weight {{ rs.weight }}
{% endif %}
{% if rs.inhibit_on_failure is defined %}
{% if rs.inhibit_on_failure %}
    inhibit_on_failure
{% endif %}
{% endif %}

{% if rs.notify_up is defined %}
    notify_up "{{ rs.notify_up }}"
{% endif %}

{% if rs.notify_down is defined %}
    notify_down "{{ rs.notify_down }}"
{% endif %}

{% if rs.http_get is defined %}
    # HTTP health check
    HTTP_GET {
{% if rs.http_get.url is defined %}
{% for url in rs.http_get.url %}
      url {
        path {{ url.path | default('/') }}
{% if url.digest is defined %}
        digest {{ url.digest }}
{% endif %}
{% if url.status is defined %}
        status {{ url.status }}
{% endif %}
      }
{% endfor %}
{% endif %}
      connect_timeout {{ rs.http_get.connect_timeout | default(3) }}
      connect_port {{ rs.http_get.port | default(rs.port) }}
    }
{% elif rs.tcp_check is defined %}
    # TCP check
    TCP_CHECK {
      connect_port {{ rs.tcp_check.port | default(rs.port) }}
      connect_timeout {{ rs.tcp_check.connect_timeout | default(3) }}
    }
{% elif rs.ssl_hh is defined %}
    # SSL health check
    SSL_HL
{% else %}
    # No health check — assume always healthy
    # (not recommended in production)
{% endif %}

  }
{% endfor %}
{% endif %}
{% endif %}

}
{% endfor %}

# Optional: LVS sync daemon configuration
{% if lvs_sync_daemon is defined and lvs_sync_daemon.enabled %}
# LVS sync daemon (for HA of LVS state)
lvs_sync_daemon {
  interface {{ lvs_sync_daemon.interface | default('eth0') }}
  syncid {{ lvs_sync_daemon.syncid | default(0) }}
{% if lvs_sync_daemon.mcast_group is defined %}
  mcast_group {{ lvs_sync_daemon.mcast_group | default('224.0.0.81') }}
{% endif %}
{% if lvs_sync_daemon.mcast_port is defined %}
  mcast_port {{ lvs_sync_daemon.mcast_port | default(5432) }}
{% endif %}
{% if lvs_sync_daemon.mcast_ttl is defined %}
  mcast_ttl {{ lvs_sync_daemon.mcast_ttl | default(1) }}
{% endif %}
{% if lvs_sync_daemon.sync_maxlen is defined %}
  sync_maxlen {{ lvs_sync_daemon.sync_maxlen | default(64) }}
{% endif %}
}
{% endif %}

# Optional: Script definitions
{% for script in scripts %}
# {{ script.name }}: custom health-check script
vrrp_script {{ script.name }} {
  script "{{ script.cmd }}"
  interval {{ script.interval }}
{% if script.timeout is defined %}
  timeout {{ script.timeout }}
{% endif %}
{% if script.weight is defined %}
  weight {{ script.weight }}
{% endif %}
{% if script.initial_weight is defined %}
  initial_weight {{ script.initial_weight }}
{% endif %}
{% if script.decrease is defined %}
  decrease {{ script.decrease }}
{% endif %}
{% if script.increase is defined %}
  increase {{ script.increase }}
{% endif %}
}
{% endfor %}
