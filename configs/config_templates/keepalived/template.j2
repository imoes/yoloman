# =============================================================================
# Keepalived Configuration Template
# =============================================================================
# This file configures the `keepalived` service, providing High Availability (HA)
# and Load Balancing for Linux systems using Virtual IP addresses (VRRP).
# It is auto-generated by Ansible from the 'keepalived' role schema.
#
# Self-Documenting: Every configuration directive is commented with its
# purpose and source variable.
# =============================================================================

# ------------------------------------------------------------------------------
# Daemon Arguments
# ------------------------------------------------------------------------------
# Description: Command-line arguments to pass to keepalived daemon.
# Source Variable: daemon_args
# Default: '' (empty string)
# ------------------------------------------------------------------------------
DAEMON_ARGS="{{ (daemon_args | default('')) | tojson }}"

# ------------------------------------------------------------------------------
# VRRP Instances
# ------------------------------------------------------------------------------
# Description: List of VRRP instances for IP failover and redundancy.
# Each instance defines a virtual router configuration.
# Source Variable: vrrp_instances
# Default: [] (empty list)
# ------------------------------------------------------------------------------
# If no instances are defined, keepalived may run but will not configure VIPs.
{% if (vrrp_instances | default([])) | length > 0 %}
{% for instance in vrrp_instances %}
# ---------------------------------------------------------------------------
# VRRP Instance: {{ (instance.name | default('unnamed')) | string }}
# ---------------------------------------------------------------------------
# Description: Configuration block for a single VRRP virtual router.
# Source Field: vrrp_instances[].name
vrrp_instance {{ (instance.name | default('unnamed')) | string }} {
    # Description: State of the instance (MASTER or BACKUP).
    # Source Field: vrrp_instances[].state
    state {{ (instance.state | default('BACKUP')) | string }}

    # Description: Interface to bind the VRRP multicast packets to.
    # Source Field: vrrp_instances[].interface
    interface {{ (instance.interface | default('eth0')) | string }}

    # Description: Virtual Router ID (1-255). Must match between MASTER and BACKUP.
    # Source Field: vrrp_instances[].virtual_router_id
    virtual_router_id {{ (instance.virtual_router_id | default(51)) | int }}

    # Description: Priority (1-254) for election. Higher value wins.
    # Source Field: vrrp_instances[].priority
    priority {{ (instance.priority | default(100)) | int }}

    # Description: Interval in seconds between VRRP advertisements.
    # Source Field: vrrp_instances[].advert_int
    advert_int {{ (instance.advert_int | default(1)) | int }}

    # Description: Authentication method (PASS or AH).
    # Source Field: vrrp_instances[].authentication.auth_type
    authentication {
        auth_type {{ ((instance.authentication | default({})).auth_type | default('PASS')) | string }}
        # Description: Authentication password (max 8 chars).
        # Source Field: vrrp_instances[].authentication.auth_pass
        auth_pass {{ ((instance.authentication | default({})).auth_pass | default('')) | string }}
    }

    # Description: Virtual IP addresses assigned to this instance.
    # Source Field: vrrp_instances[].virtual_ips
    {% if (instance.virtual_ips | default([])) | length > 0 %}
{% for ip in instance.virtual_ips %}
    virtual_ipaddress {
        {{ (ip.address | default('0.0.0.0')) | string }}{% if (ip.label | default(None)) is not none %}/{{ (ip.label | default(None)) | string }}{% endif %}{% if (ip.scope | default(None)) is not none %} dev {{ (ip.scope | default(None)) | string }}{% endif %}
    }
{% endfor %}
{% else %}
    # No virtual IPs defined for this instance.
{% endif %}
}
{% endfor %}
{% else %}
# No VRRP instances defined.
{% endif %}