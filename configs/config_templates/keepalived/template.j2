! Configuration File for keepalived — keepalived.conf(5). Written by Bossman; Debian ships none (a sample only).

global_defs {
{% if router_id is defined and router_id is not none and (router_id is number or router_id is boolean or router_id | length > 0) %}   router_id {{ router_id }}
{% endif %}}
{% for v in vrrp_instances | default([]) %}
vrrp_instance {{ v.name }} {
    state {{ v.state | default('BACKUP') }}
    interface {{ v.interface }}
    virtual_router_id {{ v.virtual_router_id }}
    priority {{ v.priority | default(100) }}
    advert_int {{ v.advert_int | default(1) }}
{% if v.auth_pass is defined and v.auth_pass %}    authentication {
        auth_type PASS
        auth_pass {{ v.auth_pass }}
    }
{% endif %}    virtual_ipaddress {
{% for ip in v.virtual_ipaddresses | default([]) %}        {{ ip }}
{% endfor %}    }
}
{% endfor %}