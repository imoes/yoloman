{
  "global_definitions": "# Global definitions\nglobal_defs {\n  notification_email { admin@example.com, ops@example.com }\n  notification_email_from keepalived@cluster.local\n  smtp_server 127.0.0.1\n  smtp_connect_timeout 10\n  lvs_id VRRP_CLUSTER_1\n}\n",
  "vrrp_instances": [
    {
      "name": "VI_1",
      "state": "MASTER",
      "interface": "eth0",
      "virtual_router_id": 51,
      "priority": 100,
      "advert_int": 1,
      "vips": [
        {
          "address": "192.168.1.100/24",
          "dev": "eth0"
        }
      ],
      "authentication": {
        "enabled": true,
        "type": "PASS",
        "password": "mypassword"
      },
      "preempt": true,
      "smtp_alert": true,
      "notify_master": "/usr/local/bin/vrrp_notify.sh master",
      "notify_backup": "/usr/local/bin/vrrp_notify.sh backup",
      "notify_fault": "/usr/local/bin/vrrp_notify.sh fault"
    },
    {
      "name": "VI_2",
      "state": "BACKUP",
      "interface": "eth0",
      "virtual_router_id": 52,
      "priority": 90,
      "advert_int": 1,
      "vips": [
        {
          "address": "10.0.0.10/24",
          "dev": "eth0"
        }
      ],
      "authentication": {
        "enabled": true,
        "type": "PASS",
        "password": "another_secret"
      },
      "preempt": false,
      "smtp_alert": false
    }
  ],
  "scripts": [
    {
      "name": "chk_nginx",
      "cmd": "/usr/bin/pgrep -x nginx > /dev/null",
      "interval": 2,
      "timeout": 3,
      "weight": -20
    }
  ],
  "lvs_virtual_servers": [
    {
      "name": "Web VIP",
      "ip": "192.168.1.100",
      "port": 80,
      "lb_algo": "wlc",
      "lb_kind": "DR",
      "protocol": "TCP",
      "delay_loop": 3,
      "real_servers": [
        {
          "ip": "192.168.1.10",
          "port": 80,
          "weight": 10,
          "tcp_check": {
            "port": 80,
            "connect_timeout": 3,
            "connect_retries": 2
          }
        },
        {
          "ip": "192.168.1.11",
          "port": 80,
          "weight": 5,
          "http_get": {
            "url": [
              {
                "path": "/health",
                "status": "200"
              }
            ],
            "connect_timeout": 3
          }
        }
      ],
      "persistence_timeout": 600
    }
  ],
  "lvs_sync_daemon": {
    "enabled": true,
    "interface": "eth1",
    "syncid": 1,
    "mcast_group": "224.0.0.81",
    "mcast_port": 5432
  }
}
