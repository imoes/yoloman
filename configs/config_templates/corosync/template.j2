# Corosync Cluster Configuration
# Managed by Ansible. Generated from schema fields.
# See corosync.conf.5 manual page for details.

totem {
	# Corosync Protocol version. Modern clusters use version 2.
	version: {{ config_version | default(1) }}

	# Cluster name. Used by DLM for shared locking and written to VG metadata.
	cluster_name: {{ cluster_name | default('debian') }}

	# Cryptographic settings for mutual node authentication.
	# If enabled, requires a shared secret generated by "corosync-keygen".
	# Only applicable with knet transport.
	crypto_cipher: none
	crypto_hash: none

	# Transport layer configuration (knet is default in modern corosync).
	# Ring addresses are defined in the nodelist below.
}

logging {
	# Log source file and line number (useful for debugging, can be verbose).
	fileline: off

	# Log to standard error (useful when running in foreground).
	to_stderr: yes

	# Log to a dedicated logfile.
	to_logfile: yes
	logfile: /var/log/corosync/corosync.log

	# Log to system logger (syslog/journald).
	to_syslog: yes

	# Enable debug logging (very verbose).
	debug: off

	# Log subsystem-specific settings
	logger_subsys {
		subsys: QUORUM
		# Debug level for the Quorum subsystem.
		debug: off
	}
}

quorum {
	# Enable quorum functionality. Required for cluster decision making.
	# Provider: corosync_votequorum is the standard implementation.
	provider: corosync_votequorum
}

nodelist {
	# List of cluster member nodes.
	# Each node must have a unique nodeid and at least one ring address.

{% for node in nodes | default([{'name': 'node1', 'nodeid': 1, 'ring0_addr': '127.0.0.1'}]) %}
	node {
		# Human-readable node name (should match DNS/hostname).
		name: {{ node.name }}

		# Unique integer identifier for this node within the cluster.
		# Must be unique across all nodes.
		nodeid: {{ node.nodeid }}

		# IP address for the first communication ring (ring0).
		# This is the primary cluster heartbeat/address.
		ring0_addr: {{ node.ring0_addr }}

{% if node.ring1_addr is defined %}
		# IP address for the second communication ring (ring1).
		# Used for redundant/backup communication paths when knet is used.
		ring1_addr: {{ node.ring1_addr }}
{% endif %}
	}
{% endfor %}
}