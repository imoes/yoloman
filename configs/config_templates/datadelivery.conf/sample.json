{
  "cache.enabled": true,
  "cache.max_size": 15000,
  "cache.ttl": 7200,
  "cache.path": "/var/cache/arc/datadelivery",
  "delivery.enabled": true,
  "delivery.max_workers": 12,
  "delivery.max_size": 2147483648,
  "delivery.output_path": "/var/spool/arc/datadelivery",
  "delivery.allowed_hosts": [
    "client1.example.com",
    "client2.example.com"
  ],
  "delivery.allowed_cidrs": [
    "192.168.0.0/24",
    "10.0.0.0/8"
  ],
  "log.level": "INFO",
  "log.path": "/var/log/arc/datadelivery.log",
  "log.rotate": true,
  "log.max_size": 52428800,
  "log.max_files": 3,
  "storage.type": "filesystem",
  "storage.base_path": "/var/lib/arc/datadelivery",
  "storage.compress": true
}
