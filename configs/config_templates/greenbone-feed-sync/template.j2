# Greenbone Feed Sync Service Configuration
# This file defines the runtime context for the greenbone-feed-sync daemon.
# It specifies the unprivileged system user and group under which the service
# operates to ensure security isolation.

[greenbone-feed-sync]

# user: System user account under which the greenbone-feed-sync service runs.
# Defaults to '_gvm' to follow standard GVM deployment practices.
user="{{ user | default('_gvm') }}"

# group: System group associated with the greenbone-feed-sync service user.
# Defaults to '_gvm' to match the default user group.
group="{{ group | default('_gvm') }}"