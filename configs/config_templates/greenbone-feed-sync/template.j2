# ==============================================================================
# Greenbone Feed Sync Configuration Template
# ==============================================================================
# This template configures the [greenbone-feed-sync] section for the Greenbone
# Feed Sync service. It controls the system identity under which the feed
# synchronization daemon operates.
#
# Variables:
#   - user (string): The system user account running the service. Defaults to '_gvm'.
#   - group (string): The system group associated with the service user. Defaults to '_gvm'.
# ==============================================================================

[greenbone-feed-sync]
# user: System user account under which the greenbone-feed-sync service runs.
# This user must have appropriate permissions to access feed directories and logs.
user="{{ user | default('_gvm') }}"

# group: System group associated with the greenbone-feed-sync service user.
# This group defines the primary group for file access permissions.
group="{{ group | default('_gvm') }}"
