# ==============================================================================
# nordugrid-arc-datadelivery-service Logrotate Configuration
# ==============================================================================
# This file configures log rotation for the ARC Data Delivery Service.
# It ensures logs are kept for a defined period, compressed to save space,
# and the service is signaled to reopen log files after rotation.
# ==============================================================================

# The full path to the log file.
# Variable: log_file_name
# Default: 'datadelivery-service'
# Description: Base name for the log file.
/var/log/arc/{{ log_file_name | default('datadelivery-service') }}.log {

    # --- Rotation Policy ---

    # Variable: missingok
    # Default: true (implied by common practice, though not strictly in schema,
    # but standard logrotate behavior often defaults to missingok or nocreate.
    # Here we explicitly enable it for safety if the log hasn't been created yet.
    missingok

    # Variable: compress
    # Default: true
    # Description: Compress old log files using gzip.
    compress

    # Variable: delaycompress
    # Default: true
    # Description: Delay compression of the most recently rotated log file
    # until the next rotation cycle. This prevents issues with processes
    # still writing to the compressed file.
    delaycompress

    # Variable: daily
    # Default: true
    # Description: Rotate log files every day.
    daily

    # Variable: log_rotation_count
    # Default: '14'
    # Description: Number of rotated log files to keep.
    rotate {{ log_rotation_count | default('14') }}

    # --- File Permissions ---

    # Variable: create
    # Default: true
    # Description: Create new empty log files after rotation, inheriting
    # permissions from the parent directory or defaults.
    create

    # --- Post-Rotation Actions ---

    # Variable: pid_file_name
    # Default: 'arched-datadelivery-service'
    # Description: Base name for the PID file (without .pid extension).
    postrotate
        # Send a HUP signal to the service to force it to reopen log files.
        # This ensures new log entries go to the newly created log file.
        # We read the PID from the standard ARC runtime location.
        kill -HUP `cat /run/{{ pid_file_name | default('arched-datadelivery-service') }}.pid 2> /dev/null` 2> /dev/null || true
    endscript
}
