# Nordugrid ARC DataDelivery Service Logrotate Configuration
# This file manages the rotation of logs generated by the arc-datadelivery-service.

# Log file path: located in /var/log/arc/ with the configured base name.
/var/log/arc/{{ log_file_name | default('datadelivery-service') }}.log
{
  # Do not error if the log file is missing.
  missingok

  # Compress rotated log files to save disk space.
  compress

  # Delay compression of the most recently rotated file.
  delaycompress

  # Perform rotation on a daily basis.
  daily

  # Retain the specified number of rotated log files before discarding.
  rotate {{ log_rotation_count | default(14) }}

  # Create new log files with default permissions after rotation.
  create

  postrotate
    # Send a SIGHUP signal to the DataDelivery service to reopen log files.
    # This ensures that the service writes to the new log file immediately after rotation.
    # The PID file path is constructed from the configured base name.
    kill -HUP `cat /run/{{ pid_file_name | default('arched-datadelivery-service') }}.pid 2> /dev/null` 2> /dev/null || true
  endscript
}