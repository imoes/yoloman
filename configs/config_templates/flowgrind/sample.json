{
  "report_interval": 0.1,
  "throughput_unit": false,
  "log_file": "/var/log/flowgrind/throughput.log",
  "overwrite_log": true,
  "dump_prefix": "tcp-test-",
  "tcp_stack_unit": "byte",
  "random_seed": 42,
  "one_way_delay": true,
  "show_columns": [
    "blocks",
    "rtt",
    "delay"
  ],
  "flows": [
    {
      "id": "loopback_v4",
      "host_source": "127.0.0.1",
      "host_dest": "127.0.0.1",
      "duration_source": 5.0,
      "duration_dest": 0.0,
      "block_size": 16384,
      "request_distribution": "C",
      "request_params": [
        1000
      ],
      "response_distribution": "C",
      "response_params": [
        1000
      ],
      "gap_distribution": "C",
      "gap_params": [
        0.01
      ],
      "block_size_limit": 65536,
      "socket_opts": [
        "TCP_NODELAY"
      ],
      "tcp_nodelay": true,
      "tcp_congestion": "cubic",
      "tcp_info_metrics": [
        "cwnd",
        "ssth",
        "rtt"
      ]
    },
    {
      "id": "remote_v6",
      "host_source": "2001:db8::1",
      "control_source": "192.168.1.100:7000",
      "host_dest": "2001:db8::2",
      "control_dest": "192.168.1.101:7000",
      "duration_source": 10.0,
      "duration_dest": 0.0,
      "request_distribution": "U",
      "request_params": [
        500,
        5000
      ],
      "response_distribution": "N",
      "response_params": [
        2000,
        100
      ],
      "gap_distribution": "U",
      "gap_params": [
        0.005,
        0.015
      ],
      "block_size_limit": 32768,
      "min_response_size": true,
      "tcp_info_metrics": [
        "rtt",
        "cwnd",
        "retr"
      ]
    }
  ]
}
