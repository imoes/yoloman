{
  "mail_to": "root@localhost",
  "mail_from": "Logwatch <root@localhost>",
  "format": "text",
  "detail": 5,
  "service_whitelist": [],
  "service_blacklist": [],
  "temp_dir": "/var/cache/logwatch",
