{
  "mail_to": "sysadmin@example.com",
  "mail_from": "Logwatch Server <logwatch@example.com>",
  "format": "html",
  "detail": 7,
  "service_whitelist": [
    "sshd",
    "cron",
    "yum",
    "http"
  ],
  "service_blacklist": [
    "postfix",
    "named"
  ],
  "temp_dir": "/var/cache/logwatch",
  "log_dir": "/etc/logwatch",
  "archive": 14,
  "compress": true,
  "ignore_old": true,
  "unassociated": false,
  "date_prefix": true,
  "split_long_lines": true,
  "hostnames": true,
  "range": "Last 7 days",
  "debug": false,
  "use_journal": true,
  "journal_filters": [
    "-u sshd",
    "--priority=err..crit"
  ],
  "archive_days": 90
}
