# ==============================================================================
# WADC (WAD Creation and Distribution Compiler) Configuration
# ==============================================================================
# This configuration file stores site-specific preferences for the WAD creation
# workflow managed by wadc. Although wadc(1) describes the tool as having no
# standard persistent configuration, this file maps hypothetical site-specific
# preferences to satisfy configuration management requirements.
#
# Structure:
#   [General]  -> Core paths and defaults for output and documentation.
#   [Display]  -> Terminal UI appearance and behavior.
#   [List]     -> Lists of key bindings and supported game versions.
# ==============================================================================

[General]
# output_directory
# Description: Directory where generated WAD files are saved.
# Type: string
# Default: '/home/user/wad_files'
output_directory = {{ output_directory | default('/home/user/wad_files') }}

# reference_doc
# Description: Path to the official WadC language reference documentation.
# Type: string
# Default: '/usr/share/doc/wadc/reference.adoc.gz'
reference_doc = {{ reference_doc | default('/usr/share/doc/wadc/reference.adoc.gz') }}

# examples_dir
# Description: Directory containing example WadC programs.
# Type: string
# Default: '/usr/share/doc/wadc/examples'
examples_dir = {{ examples_dir | default('/usr/share/doc/wadc/examples') }}

[Display]
# font_size
# Description: Font size used in the editor terminal interface.
# Type: integer
# Default: 12
font_size = {{ font_size | default(12) }}

# syntax_highlighting
# Description: Whether to enable syntax highlighting in the editor.
# Type: boolean
# Default: True
syntax_highlighting = {{ syntax_highlighting | default(true) | lower }}

[List]
# key_bindings
# Description: List of custom key bindings for editor actions.
# Type: list of strings
# Default: ['ctrl+s', 'ctrl+q']
# Format: Comma-separated values enclosed in brackets.
key_bindings = {{ key_bindings | default(['ctrl+s', 'ctrl+q']) | join(', ') }}

# wad_versions
# Description: List of WAD game versions supported for output.
# Type: list of strings
# Default: ['DOOM', 'DOOM2', 'HACX']
# Format: Comma-separated values enclosed in brackets.
wad_versions = {{ wad_versions | default(['DOOM', 'DOOM2', 'HACX']) | join(', ') }}