# Varnish VCL Configuration Template
# Managed by Ansible. Do not edit manually.
#
# This file defines the backend server(s) that Varnish caches content from.
# See https://www.varnish-cache.org/docs/ for VCL documentation.

# Marker to tell the VCL compiler that this VCL has been written with the
# 4.0 or 4.1 syntax.
vcl 4.1;

# Default backend definition. Set this to point to your content server.
# Defines the hostname or IP address and port of the upstream web server
# from which Varnish fetches content.
# This configuration acts as a consumer of a web_server capability,
# connecting to the upstream HTTP/HTTPS service provided by a web server.
backend default {
    # The hostname or IP address of the backend web server.
    # Defaults to 127.0.0.1 if not specified in the role variables.
    .host = "{{ backend_host | default('127.0.0.1') }}";

    # The port number of the backend web server.
    # Defaults to 8080 if not specified in the role variables.
    .port = "{{ backend_port | default('8080') }}";
}

sub vcl_recv {
    # Happens before we check if we have this in cache already.
    #
    # Typically you clean up the request here, removing cookies you don't need,
    # rewriting the request, etc.
}

sub vcl_backend_response {
    # Happens after we have read the response headers from the backend.
    #
    # Here you clean the response headers, removing silly Set-Cookie headers
    # and other mistakes your backend does.
}

sub vcl_deliver {
    # Happens when we have all the pieces we need, and are about to send the
    # response to the client.
    #
    # You can do accounting or modifying the final object here.
}
