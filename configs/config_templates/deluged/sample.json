{
  "enabled": true,
  "log_level": 3,
  "log_file": "/var/log/deluge/deluged.log",
  "console_enabled": false,
  "listen_interface": "0.0.0.0",
  "json_rpc_port": 8112,
  "json_rpc_ssl_enabled": true,
  "ssl_certificate_path": "/etc/ssl/certs/deluge.crt",
  "ssl_private_key_path": "/etc/ssl/private/deluge.key",
  "auth_enabled": true,
  "default_username": "admin",
  "default_password": "secretpass123",
  "allow_remote": true,
  "allowed_hosts": [
    "127.0.0.1",
    "::1",
    "192.168.1.0/24"
  ],
  "pidfile": "/run/deluged/deluged.pid",
  "worker_threads": 4,
  "enable_resume_data_cache": true,
  "max_connections_per_torrent": 50,
  "max_uploads_per_torrent": 8,
  "upload_rate_limit": 2048,
  "download_rate_limit": 8192,
  "enable_dht": true,
  "enable_lsd": true,
  "enable_upnp": true,
  "enable_natpmp": false,
  "listen_ports": [
    58846,
    58846
  ],
  "randomize_ports": false
}
