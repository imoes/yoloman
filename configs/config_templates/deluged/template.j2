# Enable or disable the deluged daemon
{% if enabled | default(false) %}
[deluged]
# Log level: 0=CRITICAL, 1=ERROR, 2=WARNING, 3=INFO, 4=DEBUG
loglevel = {{ log_level }}

# Path to log file (empty = log to stdout only if console logging enabled)
logfile = {{ log_file }}

# Enable console logging
console_enabled = {{ console_enabled }}

# Interface to listen on for JSON-RPC and WebUI connections
# Use 0.0.0.0 for all interfaces, or specify a single IP (e.g., 127.0.0.1)
listen_interface = {{ listen_interface }}

# Port to listen on for JSON-RPC (deluge-web uses this)
port = {{ json_rpc_port }}

# Enable or disable SSL for JSON-RPC and WebUI
# Note: WebUI requires SSL if enabled here; certificate must be provided separately
ssl_enabled = {{ json_rpc_ssl_enabled }}

# Path to SSL certificate (PEM format) — only used if ssl_enabled is true
certificate = {{ ssl_certificate_path }}

# Path to SSL private key (PEM format) — only used if ssl_enabled is true
private_key = {{ ssl_private_key_path }}

# Enable or disable authentication
auth_enabled = {{ auth_enabled }}

# Default username (used only if auth_enabled and no existing auth file)
default_username = {{ default_username }}

# Default password (plaintext; will be hashed on first run if auth_enabled)
default_password = {{ default_password }}

# Enable or disable remote connections (non-localhost)
allow_remote = {{ allow_remote }}

# Comma-separated list of allowed hosts (empty = allow all if allow_remote=true)
allowed_hosts = {{ allowed_hosts | join(', ') }}

# Daemon PID file path
pidfile = {{ pidfile }}

# Number of worker threads for I/O operations
worker_threads = {{ worker_threads }}

# Enable or disable the libtorrent resume data cache
enable_resume_data_cache = {{ enable_resume_data_cache }}

# Maximum number of connections per torrent
max_connections_per_torrent = {{ max_connections_per_torrent }}

# Maximum number of upload slots per torrent
max_uploads_per_torrent = {{ max_uploads_per_torrent }}

# Global upload rate limit (KiB/s; 0 = unlimited)
upload_rate_limit = {{ upload_rate_limit }}

# Global download rate limit (KiB/s; 0 = unlimited)
download_rate_limit = {{ download_rate_limit }}

# Enable or disable DHT
enable_dht = {{ enable_dht }}

# Enable or enable LSD
enable_lsd = {{ enable_lsd }}

# Enable or disable UPnP for port mapping
enable_upnp = {{ enable_upnp }}

# Enable or disable NAT-PMP
enable_natpmp = {{ enable_natpmp }}

# Listen ports for incoming BitTorrent connections
# First is main TCP port; second (if present) is UDP port (often same)
listen_ports = {{ listen_ports | map('string') | join(', ') }}

# Port randomization: enable to use a random port range on start
randomize_ports = {{ randomize_ports }}

# Random port range for listen_ports when randomize_ports=true
# Format: 