{
  "database_file": "/home/user/Secrets.kdbx",
  "key_file": "/home/user/keyfile.kgf",
  "histfile": "/home/user/.kpcli_history",
  "inactivity_timeout": 600,
  "password_generate_words": true,
  "password_special_min": 2,
  "password_special_max": 4,
  "password_length": 8,
  "password_special_chars": "-_!",
  "clipboard_clear_seconds": 30,
  "show_password_stars": false,
  "print_generated_password": true,
  "autosave_enabled": true,
  "disable_recycle_bin": false,
  "read_only_mode": false,
  "startup_commands": "open /home/user/Secrets.kdbx; ls /"
}
