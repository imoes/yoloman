{
  "ARMAGETRONAD_SERVER_START": {
    "type": "number",
    "default": 0,
    "description": "Whether to start the server (0 = don't start, 1 = start)",
    "enum": [
      0,
      1
    ]
  },
  "ARMAGETRONAD_USER": {
    "type": "string",
    "default": "armagetronad",
    "description": "User to run the server as"
  },
  "VARDIR": {
    "type": "string",
    "default": "/var/games/armagetronad",
    "description": "Directory for variable data"
  },
  "PIDDIR": {
    "type": "string",
    "default": "/var/games/armagetronad",
    "description": "Directory for pid files"
  },
  "LOGDIR": {
    "type": "string",
    "default": "/var/log",
    "description": "Directory for log files"
  },
  "NAME": {
    "type": "string",
    "default": "armagetronad-dedicated",
    "description": "Name used for pidfile and logfile generation"
  },
  "NICENESS": {
    "type": "string",
    "default": "\"-5\"",
    "description": "Niceness level of the server"
  }
}
