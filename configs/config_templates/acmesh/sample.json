{
  "account_key_path": "/root/.acme.sh/ca/account.key",
  "acme_directory": "https://acme-v02.api.letsencrypt.org/directory",
  "default_ca": "letsencrypt",
  "debug": false,
  "dns_alias": false,
  "custom_ca_bundle": "",
  "http_timeout": 60,
  "retry_max": 3,
  "retry_delay": 2,
  "acme_home": "/root/.acme.sh",
  "account_key_length": 4096,
  "cert_key_length": 4096,
  "use_eab": false,
  "eab_kid": "",
  "eab_hmac_key": "",
  "dns_plugins": [
    {
      "name": "cloudflare",
      "enabled": true
    },
    {
      "name": "dns_aws",
      "enabled": false
    }
  ],
  "dns_credentials": [
    {
      "provider": "cloudflare",
      "api_key": "secret-cloudflare-api-token"
    }
  ],
  "ocsp": false,
  "acme_sh_path": "/usr/local/bin/acme.sh",
  "auto_renew": true,
  "auto_renew_days": 30,
  "account_email": "admin@example.com",
  "no_reinstall": false,
  "strict_mode": true,
  "log_level": 0,
  "log_file": "",
  "default_key_algo": "rsa",
  "country_code": "US",
  "state": "California",
  "location": "San Francisco",
  "organization": "Example Corp",
  "organization_unit": "IT Security",
  "json_output": false
}
