#         'replication', 'rollback', 'savepoint', 'snapshot', 'split', 'table',
#         'transaction', 'write', 'cache', 'checkpoint', 'session', 'connection']
# Default: [] (empty list, no verbose output)
# Verbose output levels.
{% set verbose_list = wt.verbose | default([]) %}
{% if verbose_list is iterable and verbose_list | length > 0 %}
verbose = [
{% for v in verbose_list %}
    '{{ v }}'
{% if not loop.last %},{% endif %}
{% endfor %}
]
{% endif %}

