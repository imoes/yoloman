# WiredTiger configuration template
# Generated by Ansible Jinja2
#
# This template configures the WiredTiger storage engine.
# WiredTiger is primarily used by MongoDB, but can be configured standalone
# or for other embedded use cases.
#
# For MongoDB-specific configuration, this file is typically included
# within the mongod.conf or managed via the mongod --setParameter flags.
# However, this template allows explicit control over WiredTiger internals.

# ==========================================
# General WiredTiger Engine Settings
# ==========================================

# [cache_size]
# Specifies the amount of memory the WiredTiger storage engine can use for caching
# data and indexes in memory. If not specified, WiredTiger will attempt to use
# up to 50% of the system's physical RAM.
# Schema: cache_size (string/number) - The size of the cache (e.g., '2g', '512m').
# Default: auto-calculated by WiredTiger if omitted, but often best to set explicitly.
# Note: In many deployments, this is managed by the database server (e.g., mongod --cacheSizeGB),
# not directly in a standalone wt.conf. If this config is for a standalone WiredTiger instance,
# set it here.
{% set wt = wiredtiger | default({}) %}
# Cache size for WiredTiger.
# WiredTiger uses this to limit memory usage.
cache_size = {{ wt.cache_size | default('1g') }}

# [checkpoint]
# Options related to checkpointing.
# Schema: checkpoint (dict) - Checkpoint configuration.
{% set checkpoint_config = wt.checkpoint | default({}) %}
# Checkpoint configuration
{% if checkpoint_config is mapping %}
{% if checkpoint_config.get('wait') is defined %}
# [checkpoint.wait]
# Specifies whether the server should wait for checkpoints to complete.
# Default: true
checkpoint.wait = {{ checkpoint_config.wait | default(true) | lower }}
{% endif %}
{% if checkpoint_config.get('log_size') is defined %}
# [checkpoint.log_size]
# Specifies the maximum size of the data log file (in MB).
# Default: 0 (unlimited)
checkpoint.log_size = {{ checkpoint_config.log_size | default(0) }}
{% endif %}
{% endif %}

# [directory]
# Specifies the directory where WiredTiger stores its files.
# Schema: directory (string) - Path to the database directory.
# Default: '.' (current directory)
# NOTE: In MongoDB, this is usually data/db. Ensure this matches the data directory.
# Directory for WiredTiger storage files.
directory = {{ wt.directory | default('.') }}

# [encryption]
# Options related to data encryption at rest.
# Schema: encryption (dict) - Encryption configuration.
{% set encryption_config = wt.encryption | default({}) %}
# Encryption configuration
{% if encryption_config is mapping %}
{% if encryption_config.get('name') is defined %}
# [encryption.name]
# Specifies the encryption mechanism. Common values: 'none', 'libmongocrypt', 'rocksdb'.
# Default: 'none'
encryption.name = {{ encryption_config.name | default('none') }}
{% endif %}
{% if encryption_config.get('keyfile') is defined %}
# [encryption.keyfile]
# Specifies the path to the key file for encryption.
# Default: null
encryption.keyfile = {{ encryption_config.keyfile | default('') | string }}
{% endif %}
{% endif %}

