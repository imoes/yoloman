# /etc/initramfs-tools/initramfs.conf — global configuration for initramfs generation
# COMMENT: Controls whether to compress the initramfs image (gzip, xz, zstd, etc.)
COMPRESS={{ compress }}

# COMMENT: Directory where the initramfs image will be stored
MODULES={{ modules }}

# COMMENT: List of modules to include in the initramfs (space-separated; use 'most' or 'dep' for automatic detection)
MODULES_LIST="{{ modules_list | join(' ') }}"

# COMMENT: Root device to mount during boot (e.g., /dev/sda1, UUID=..., or LVM/MD paths)
ROOT={{ root }}

# COMMENT: Filesystem type of the root device (e.g., ext4, xfs, btrfs)
ROOTFSTYPE={{ rootfstype }}

# COMMENT: Add kernel modules required for early boot devices (e.g., USB, RAID)
DEVICE="{{ device }}"

# COMMENT: Timeout (in seconds) to wait for the root device to appear
ROOTDELAY={{ rootdelay }}

# COMMENT: Enable or disable quiet boot (reduce verbosity)
QUIET={{ quiet | lower }}

# COMMENT: Enable or disable debugging output in initramfs
DEBUG={{ debug | lower }}

# COMMENT: Additional space-separated modules to load early (e.g., 'usb_storage sd_mod')
ADDMODULES="{{ addmodules | join(' ') }}"

# COMMENT: Whether to include initramfs-tools hooks in the image
HOOKS="{{ hooks | join(' ') }}"

# COMMENT: Post-processing commands to run after initramfs generation
POST_BUILD="{{ post_build }}"

# COMMENT: Compressor options (e.g., '-9' for gzip compression level)
COMPRESSOPTIONS="{{ compressoptions | join(' ') }}"

# COMMENT: List of hooks to exclude (space-separated)
EXTRAHOOKS="{{ extrahooks | join(' ') }}"

# COMMENT: List of hooks to remove (space-separated)
REMOVEHOOKS="{{ removehooks | join(' ') }}"

# COMMENT: Additional kernel parameters passed to the kernel command line
KERNEL_APPEND="{{ kernel_append }}"

# COMMENT: Whether to generate initramfs for all installed kernels
ALL_KERNELS={{ all_kernels | lower }}

# COMMENT: Whether to keep old initramfs images (true/false)
KEEP_OLD={{ keep_old | lower }}

# COMMENT: List of blacklist modules (space-separated)
BLACKLIST="{{ blacklist | join(' ') }}"

# COMMENT: Whether to use plymouth for graphical boot
USE_POLLYMOUTH={{ use_plymouth | lower }}

# COMMENT: Additional space-separated modules to load before the root filesystem is mounted
PRE_STREAM="{{ pre_stream | join(' ') }}"
