[CPU-Z]

# Font name for information text boxes
TextFontName={{ text_font_name | default('Verdana') }}

# Font size (in points) for information text boxes
TextFontSize={{ text_font_size | default(13) }}

# Text color in RRGGBB hex format
TextFontColor={{ text_font_color | default('000060') }}

# Font name for label text boxes
LabelFontName={{ label_font_name | default('Verdana') }}

# Font size (in points) for label text boxes
LabelFontSize={{ label_font_size | default(13) }}

# Enable PCI bus scanning
PCI={{ pci | default(true) | lower }}

# Maximum PCI bus number to scan
MaxPCIBus={{ max_pci_bus | default(256) }}

# Enable DMI/SMBIOS information gathering
DMI={{ dmi | default(true) | lower }}

# Enable hardware sensor detection and voltage measurements
Sensor={{ sensor | default(true) | lower }}

# Enable SMBus information gathering
SMBus={{ smbus | default(true) | lower }}

# Enable video card information reporting
Display={{ display | default(true) | lower }}

# Use display driver API to read adapter info
UseDisplayAPI={{ use_display_api | default(false) | lower }}

# Enable real-time CPU clock measurement
BusClock={{ bus_clock | default(true) | lower }}

# Enable chipset identification
Chipset={{ chipset | default(true) | lower }}

# Enable SPD memory module information reading
SPD={{ spd | default(true) | lower }}

# Automatically check for application updates on startup
CheckUpdates={{ check_updates | default(true) | lower }}

# Use alternate clock computation method based on duty cycles
ShowDutyCycles={{ show_duty_cycles | default(false) | lower }}