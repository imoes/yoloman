# astroid configuration file
# Generated by astroid(1) — graphical threads-with-tags style, lightweight e-mail client for Notmuch
# Documentation: https://github.com/astroidmail/astroid/wiki

[general]
# Path to the Notmuch mail database.
# Default: ~/.notmuch/mail
notmuch_database = {{ (notmuch_database | default('~/.notmuch/mail')) }}

# Directory containing custom HTML/SCSS UI assets.
# Default: ~/.config/astroid/ui
ui_directory = {{ (ui_directory | default('~/.config/astroid/ui')) }}

# Whether to enable automatic polling for new mail.
# Default: true
auto_poll = {{ (auto_poll | default(true)) | string | lower }}

# Interval in seconds between automatic mail polls.
# Default: 300
poll_interval = {{ (poll_interval | default(300)) }}

[logger]
# Minimum log level: trace, debug, info, warn, error, fatal.
# Default: debug
level = {{ (log_level | default('debug')) }}

# Whether to send logs to stdout regardless of other logging config.
# Default: false
log_stdout = {{ (log_stdout | default(false)) | string | lower }}

[mail]
# Email address to use in the From field of composed messages.
# Default: user@example.com
email_address = {{ (email_address | default('user@example.com')) }}

# Sendmail-compatible command to send outgoing mail.
# Default: msmtp
sendmail_command = {{ (sendmail_command | default('msmtp')) }}

# Editor command used for composing messages.
# Default: vim
editor_command = {{ (editor_command | default('vim')) }}

# Optional path to a file containing the signature to append to messages.
# Only emitted if signature_file is defined and non-empty.
{% if (signature_file | default('', boolean=True)) is defined and (signature_file | default('')) != '' %}
# Signature file path
signature_file = {{ (signature_file | default('')) }}
{% endif %}

[plugins]
# List of plugin names to load (by filename without .py).
# Only emitted if plugins list is defined and non-empty.
{% if (plugins | default([], boolean=True)) is defined and (plugins | default([]) | length) > 0 %}
# Comma-separated list of plugins to load
load_plugins = {{ (plugins | default([])) | join(',') }}
{% else %}
# No plugins loaded
load_plugins =
{% endif %}

# Whether plugins are enabled (true means plugins listed in load_plugins are loaded).
# Default: true
enable_plugins = {{ (enable_plugins | default(true)) | string | lower }}