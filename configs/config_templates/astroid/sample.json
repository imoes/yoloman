{
  "notmuch_database": "~/.notmuch/mail",
  "ui_directory": "~/.config/astroid/ui",
  "auto_poll": true,
  "poll_interval": 300,
  "log_level": "debug",
  "log_stdout": false,
  "email_address": "me@example.com",
  "sendmail_command": "msmtp",
  "editor_command": "vim",
  "signature_file": "~/.config/astroid/signature.txt",
  "plugins": [
    "example"
  ],
  "enable_plugins": true
}
