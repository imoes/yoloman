# Reverse Address Resolution Protocol (RARP) configuration file
# Listen on specified network interfaces (required)
# Format: interface_name [hardware_address]
{% for iface in interfaces %}
{{ iface.name }}{{ ' ' + iface.hwaddr if iface.hwaddr else '' }}
{% endfor %}

# Log level: 0 = quiet, 1 = normal, 2 = verbose, 3 = debug
# Default: 1
loglevel {{ loglevel }}

# PID file path
# Default: /var/run/rarpd.pid
pidfile {{ pidfile }}

# Allow RARP requests only from known MAC addresses (true/false)
# Default: false
strict_mode {{ strict_mode | lower }}

# Optional static RARP entries (MAC -> IPv4 mappings)
# Format: hwaddr ipv4
{% for entry in static_entries %}
{{ entry.hwaddr }} {{ entry.ipv4 }}
{% endfor %}
