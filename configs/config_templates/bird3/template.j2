# BIRD daemon configuration file for command-line arguments and runtime user/group settings.
# This configuration is managed by Ansible. Do not edit manually.

# System user under which BIRD runs.
# Default: 'bird'
BIRD_RUN_USER={{ bird_run_user | default('bird') }}

# System group under which BIRD runs.
# Default: 'bird'
BIRD_RUN_GROUP={{ bird_run_group | default('bird') }}

# Additional command-line arguments passed to the BIRD daemon.
# Leave empty to use defaults.
# Default: '' (empty string)
{% if bird_args | default('') | trim %}
BIRD_ARGS={{ bird_args | default('') }}
{% else %}
BIRD_ARGS=
{% endif %}