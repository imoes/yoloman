# ==============================================================================
# BIRD3 Daemon Configuration Template
# ==============================================================================
# This template generates the environment file for the BIRD3 daemon (BGP router).
# It controls the system user/group the daemon runs as and any additional CLI arguments.
#
# Self-documenting: Every variable usage includes its schema default and description.
# ==============================================================================

# System user under which BIRD runs.
# Schema default: 'bird'
BIRD_RUN_USER={{ bird_run_user | default('bird') }}

# System group under which BIRD runs.
# Schema default: 'bird'
BIRD_RUN_GROUP={{ bird_run_group | default('bird') }}

# Additional command-line arguments passed to the BIRD daemon.
# Leave empty to use defaults.
# Schema default: ''
BIRD_ARGS={{ bird_args | default('') }}