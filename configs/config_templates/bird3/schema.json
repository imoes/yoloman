{
  "bird": {
    "type": "object",
    "default": {},
    "description": "Top-level BIRD configuration options.",
    "properties": {
      "router_id": {
        "type": "string",
        "default": "1.1.1.1",
        "description": "Router ID (IP address format, e.g., 192.0.2.1). Must be unique per routing domain."
      },
      "kernel_metric": {
        "type": "number",
        "default": 64,
        "description": "Metric to assign to routes installed into the kernel routing table."
      },
      "kernel_persist": {
        "type": "boolean",
        "default": true,
        "description": "If true, kernel routes remain after BIRD stops (persistent kernel sync)."
      },
      "bgp_neighbors": {
        "type": "list",
        "default": [],
        "description": "List of BGP peers to configure.",
        "items": {
          "type": "object",
          "description": "A BGP neighbor configuration.",
          "properties": {
            "name": {
              "type": "string",
              "default": "peer1",
              "description": "Unique name for the BGP neighbor (used as protocol instance name)."
            },
            "ip": {
              "type": "string",
              "default": "192.0.2.2",
              "description": "IP address of the BGP peer."
            },
            "local_as": {
              "type": "number",
              "default": 64500,
              "description": "Local AS number of this router."
            },
            "peer_as": {
              "type": "number",
              "default": 64501,
              "description": "AS number of the peer."
            },
            "description": {
              "type": "string",
              "default": "",
              "description": "Optional human-readable description of the peer."
            },
            "local_ip": {
              "type": "string",
              "default": "",
              "description": "Local source IP address for the BGP session (e.g., loopback address)."
            },
            "multihop": {
              "type": "number",
              "default": 1,
              "description": "Number of hops for EBGP multihop (set >1 for non-adjacent peers)."
            },
            "password": {
              "type": "string",
              "default": "",
              "description": "MD5 password for BGP session authentication (leave empty to disable)."
            },
            "hold_time": {
              "type": "number",
              "default": 90,
              "description": "BGP hold time in seconds."
            },
            "connect_retry": {
              "type": "number",
              "default": 120,
              "description": "Seconds between connection retry attempts."
            },
            "graceful_restart": {
              "type": "boolean",
              "default": true,
              "description": "Enable BGP graceful restart capability."
            },
            "passive": {
              "type": "boolean",
              "default": false,
              "description": "If true, do not attempt to establish TCP connection (wait for incoming)."
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "If false, disable the neighbor (protocol instance will be inactive)."
            },
            "in_filter": {
              "type": "list",
              "default": [],
              "description": "List of AS numbers to accept from this peer (AS-path filter).",
              "items": {
                "type": "number"
              }
            },
            "out_filter": {
              "type": "list",
              "default": [],
              "description": "List of AS numbers to advertise to this peer (not yet supported in BIRD v3, reserved for future).",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "name",
            "ip",
            "local_as",
            "peer_as"
          ]
        }
      },
      "static_routes": {
        "type": "list",
        "default": [],
        "description": "List of static routes to install.",
        "items": {
          "type": "object",
          "description": "A static route entry.",
          "properties": {
            "prefix": {
              "type": "string",
              "default": "198.51.100.0/24",
              "description": "IPv4 prefix in CIDR notation (e.g., 198.51.100.0/24)."
            },
            "next_hop": {
              "type": "string",
              "default": "",
              "description": "Explicit next-hop IP address (e.g., '192.0.2.254')."
            },
            "via": {
              "type": "string",
              "default": "",
              "description": "Interface name (e.g., 'eth1') \u2014 use only if next_hop omitted."
            }
          },
          "required": [
            "prefix"
          ]
        }
      },
      "interfaces": {
        "type": "list",
        "default": [],
        "description": "List of network interfaces to manage (for direct protocol).",
        "items": {
          "type": "object",
          "description": "Interface to include in BIRD.",
          "properties": {
            "name": {
              "type": "string",
              "default": "eth0",
              "description": "Name of the network interface (e.g., 'lo', 'eth0')."
            },
            "metric": {
              "type": "number",
              "default": 10,
              "description": "Metric to use for routes learned from this interface."
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "If false, skip this interface."
            }
          },
          "required": [
            "name"
          ]
        }
      }
    },
    "required": [
      "router_id"
    ]
  }
}
