# ============================================================================
# Debian Edu Main Configuration File
# ============================================================================
#
# This file is sourced by shell scripts during system configuration.
# It controls locale, networking, LDAP/AD integration, printing, file sharing,
# diskless workstation (LTSP) settings, firewall, backup, and monitoring.
#
# GENERATED BY ANSIBLE — DO NOT EDIT MANUALLY.
# Use the Debian Edu config wizard or Ansible variables to change settings.
#
# Variable Mapping:
#   Each shell variable uses the Jinja2 default() filter to ensure a value is
#   always present, falling back to the schema default if the variable is
#   undefined or None. This prevents empty assignments and syntax errors.
# ============================================================================

# System locale setting (language_TERRITORY.charset).
# Controls the default language, character encoding, and collation rules.
BASE_LOCALE={{ base_locale | default('en_US.UTF-8') }}

# System timezone (e.g., Europe/Berlin, America/New_York).
# Controls the system clock interpretation.
TIMEZONE={{ timezone | default('UTC') }}

# System hostname (short or FQDN).
# Used by the operating system for local identification and DNS resolution.
HOSTNAME={{ hostname | default('skolelinux') }}

# DNS domain for the school network (required for LDAP/AD integration).
# Used to resolve short hostnames and form the FQDN.
DOMAIN={{ domain | default('school.local') }}

# List of NTP servers to sync time with.
# Space-separated list of hostnames or IPs.
NTP_SERVERS={{ (ntp_servers | default(['0.debian.pool.ntp.org', '1.debian.pool.ntp.org'])) | join(' ') }}

# LDAP base DN (e.g., 'dc=school,dc=local').
# Root of the directory tree for user and group objects.
LDAP_BASE_DN={{ ldap_base_dn | default('dc=school,dc=local') }}

# URI of LDAP server (must include scheme: ldap:// or ldaps://).
# Network address and protocol for connecting to the directory service.
LDAP_SERVER_URI={{ ldap_server_uri | default('ldap://ldap.school.local') }}

# DN of LDAP admin user.
# Used for administrative operations like schema updates or initial setup.
LDAP_ROOT_BIND_DN={{ ldap_root_bind_dn | default('cn=admin,dc=school,dc=local') }}

# Password for LDAP admin user.
# Leave blank (empty string) to use debconf-secret or other secure mechanisms.
# NOTE: In production, never hardcode this; rely on secrets management.
LDAP_ROOT_BIND_PASSWORD={{ ldap_root_bind_password | default('') }}

# Human-readable name of the school (displayed in UIs).
# Used in login greeters, help screens, and system banners.
PRIMARY_SCHOOL_NAME={{ primary_school_name | default('My School') }}

# Enable central printing infrastructure (CUPS).
# If "yes", the system configures CUPS clients to use the remote CUPS server.
ENABLE_PRINTING={{ enable_printing | default(True) | lower }}

# Hostname of the central CUPS print server.
# Used by clients to submit print jobs to the network printer management system.
CUPS_SERVER={{ cups_server | default('cups.school.local') }}

# Enable central file sharing (NFS/Samba).
# If "yes", mount points for home directories and shared resources are configured.
ENABLE_FILESHARE={{ enable_fileshare | default(True) | lower }}

# Hostname of the NFS server for home directories.
# The server providing the /exports/home (or similar) path for user data.
NFS_SERVER={{ nfs_server | default('nfs.school.local') }}

# Path exported by NFS server for user home directories.
# Remote path on the NFS server that will be mounted on clients.
NFS_HOME_PATH={{ nfs_home_path | default('/exports/home') }}

# Enable Active Directory integration via Winbind.
# If "yes", Samba/Winbind is configured to authenticate against AD.
WINBIND_ENABLED={{ winbind_enabled | default(False) | lower }}

# Active Directory realm (uppercase).
# The Kerberos realm, usually matching the DNS domain in uppercase.
WINBIND_REALM={{ winbind_realm | default('SCHOOL.LOCAL') }}

# Short Windows domain/netbios name.
# Legacy name used for NetBIOS network identification.
WINBIND_DOMAIN={{ winbind_domain | default('SCHOOL') }}

# Hostname or IP of Active Directory domain controller.
# Used by Winbind to locate KDCs and global catalogs.
WINBIND_AD_SERVER={{ winbind_ad_server | default('dc1.school.local') }}

# AD username with rights to join machines to the domain.
# Used for initial domain join operations.
WINBIND_ADMIN={{ winbind_admin | default('administrator') }}

# Password for AD join account.
# Use secure debconf entry in production. Empty string implies manual or secret handling.
WINBIND_ADMIN_PASSWORD={{ winbind_admin_password | default('') }}

# Hostname of the LTSP (diskless workstation) server.
# Server that boots and manages thin clients/diskless workstations.
LTS_SERVER={{ lts_server | default('ltsp.school.local') }}

# Path on the LTSP server containing the root filesystem for clients.
# NFS or NBD export path for the client root image.
LTS_ROOT_PATH={{ lts_root_path | default('/opt/ltsp/i386') }}

# Architecture used for LTSP client images (i386, amd64, arm64).
# Must match the hardware of the diskless clients.
LTSP_CLIENT_ARCH={{ ltsp_client_arch | default('amd64') }}

# Use NBD instead of NFS to serve the LTSP root filesystem.
# NBD (Network Block Device) can offer better performance or specific features.
LTSP_NBD_ENABLED={{ ltsp_nbd_enabled | default(True) | lower }}

# Swap partition size (in MiB) for diskless clients (0 = disable swap).
# Configures the swapfile or swap partition on the client's RAM disk or local storage.
LTSP_SWAP_SIZE_MB={{ ltsp_swap_size_mb | default(512) }}

# Additional key=value options to inject into LTSP client initrd.
# One option per line, formatted as LTSP_CLIENT_OPT_N="value".
{% set client_opts = ltsp_client_options | default([]) %}
{% if client_opts | length > 0 %}
# Additional LTSP client options (key=value per line)
{% for opt in client_opts %}
LTSP_CLIENT_OPT_{{ loop.index }}="{{ opt }}"
{% endfor %}
{% endif %}

# Enable local iptables/nftables rules.
# If "yes", the local firewall is activated.
FIREWALL_ENABLED={{ firewall_enabled | default(True) | lower }}

# Path to custom firewall rules file.
# File containing iptables-restore or nftables-compatible rules.
FIREWALL_RULES={{ firewall_rules | default('/etc/iptables/rules.v4') }}

# Enable automatic backup jobs.
# If "yes", cron jobs or systemd timers are configured for backups.
BACKUP_ENABLED={{ backup_enabled | default(False) | lower }}

# Hostname of backup server (rsync/ssh target).
# Remote server where backup data is transferred.
BACKUP_SERVER={{ backup_server | default('backup.school.local') }}

# Remote user account for backup transfers.
# SSH user for connecting to the backup server.
BACKUP_USER={{ backup_user | default('backup') }}

# Remote path where backups are stored.
# Target directory on the backup server for received data.
BACKUP_DESTINATION_PATH={{ backup_destination_path | default('/backup/school') }}

# Backup schedule frequency: daily, weekly, or monthly.
# Used to configure cron expressions or systemd timers.
BACKUP_FREQUENCY={{ backup_frequency | default('daily') }}

# Enable local monitoring via Nagios/Icinga agent.
# If "yes", the monitoring agent is started and configured to send metrics.
MONITORING_ENABLED={{ monitoring_enabled | default(False) | lower }}

# Hostname of the monitoring server.
# Nagios/Icinga core server receiving host checks and metrics.
MONITORING_SERVER={{ monitoring_server | default('monitor.school.local') }}

# SNMP community string for local system monitoring.
# Used if SNMP is the protocol for gathering system metrics.
MONITORING_SNMP_COMMUNITY={{ monitoring_snmp_community | default('public') }}

# End of config file