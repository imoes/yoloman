# Debian Edu main configuration file — auto-generated template
# This file is sourced by shell scripts during system configuration.
# Do NOT edit manually; use debconf or the Debian Edu config wizard.

{% if base_locale %}# Set the system locale (language/territory)
BASE_LOCALE={{ base_locale }}
{% endif %}

{% if timezone %}# Set the system timezone
TIMEZONE={{ timezone }}
{% endif %}

{% if hostname %}# Set the system hostname (FQDN recommended)
HOSTNAME={{ hostname }}
{% endif %}

{% if domain %}# Set the DNS domain name (used for LDAP/kerberos)
DOMAIN={{ domain }}
{% endif %}

{% if ntp_servers | length > 0 %}# NTP servers for time synchronization (space-separated)
NTP_SERVERS={{ ntp_servers | join(' ') }}
{% endif %}

{% if ldap_base_dn %}# LDAP base DN (required for central user/group management)
LDAP_BASE_DN={{ ldap_base_dn }}
{% endif %}

{% if ldap_server_uri %}# LDAP server URI (ldap:// or ldaps://)
LDAP_SERVER_URI={{ ldap_server_uri }}
{% endif %}

{% if ldap_root_bind_dn %}# LDAP root bind DN (for admin operations)
LDAP_ROOT_BIND_DN={{ ldap_root_bind_dn }}
{% endif %}

{% if ldap_root_bind_password %}# LDAP root bind password (preferably set via debconf-secret)
LDAP_ROOT_BIND_PASSWORD={{ ldap_root_bind_password }}
{% endif %}

{% if primary_school_name %}# Human-readable school name (shown in login greeter, etc.)
PRIMARY_SCHOOL_NAME={{ primary_school_name }}
{% endif %}

{% if enable_printing %}# Enable centralized printing via CUPS (yes/no)
ENABLE_PRINTING={{ enable_printing | lower }}
{% endif %}

{% if cups_server %}# CUPS server hostname for remote printing
CUPS_SERVER={{ cups_server }}
{% endif %}

{% if enable_fileshare %}# Enable central file sharing (NFS/Samba) (yes/no)
ENABLE_FILESHARE={{ enable_fileshare | lower }}
{% endif %}

{% if nfs_server %}# NFS server hostname for home directories
NFS_SERVER={{ nfs_server }}
{% endif %}

{% if nfs_home_path %}# Path on NFS server for home directories
NFS_HOME_PATH={{ nfs_home_path }}
{% endif %}

{% if winbind_enabled %}# Enable AD integration via Winbind (yes/no)
WINBIND_ENABLED={{ winbind_enabled | lower }}
{% endif %}

{% if winbind_realm %}# Active Directory realm (uppercase)
WINBIND_REALM={{ winbind_realm }}
{% endif %}

{% if winbind_domain %}# Active Directory short domain name
WINBIND_DOMAIN={{ winbind_domain }}
{% endif %}

{% if winbind_ad_server %}# AD server hostname or IP
WINBIND_AD_SERVER={{ winbind_ad_server }}
{% endif %}

{% if winbind_admin %}# AD account with admin rights (for join operations)
WINBIND_ADMIN={{ winbind_admin }}
{% endif %}

{% if winbind_admin_password %}# Password for WINBIND_ADMIN (use debconf-secret for real deployments)
WINBIND_ADMIN_PASSWORD={{ winbind_admin_password }}
{% endif %}

{% if lts_server %}# LTSP server hostname (for diskless workstations)
LTS_SERVER={{ lts_server }}
{% endif %}

{% if lts_root_path %}# Path to LTSP root filesystem on LTSP server
LTS_ROOT_PATH={{ lts_root_path }}
{% endif %}

{% if ltsp_client_arch %}# Architecture for LTSP clients (e.g., i386, amd64)
LTSP_CLIENT_ARCH={{ ltsp_client_arch }}
{% endif %}

{% if ltsp_nbd_enabled %}# Use NBD instead of NFS for LTSP root (yes/no)
LTSP_NBD_ENABLED={{ ltsp_nbd_enabled | lower }}
{% endif %}

{% if ltsp_swap_size_mb %}# Swap partition size (in MiB) for diskless clients (0 = none)
LTSP_SWAP_SIZE_MB={{ ltsp_swap_size_mb }}
{% endif %}

{% if ltsp_client_options | length > 0 %}# Additional LTSP client options (key=value per line)
{% for opt in ltsp_client_options %}LTSP_CLIENT_OPT_{{ loop.index }}="{{ opt }}"
{% endfor %}
{% endif %}

{% if firewall_enabled %}# Enable local firewall rules (yes/no)
FIREWALL_ENABLED={{ firewall_enabled | lower }}
{% endif %}

{% if firewall_rules %}# Path to custom iptables rules file
FIREWALL_RULES={{ firewall_rules }}
{% endif %}

{% if backup_enabled %}# Enable periodic backups (yes/no)
BACKUP_ENABLED={{ backup_enabled | lower }}
{% endif %}

{% if backup_server %}# Backup destination server (rsync/ssh target)
BACKUP_SERVER={{ backup_server }}
{% endif %}

{% if backup_user %}# Remote user for backup transfers
BACKUP_USER={{ backup_user }}
{% endif %}

{% if backup_destination_path %}# Remote path on backup server
BACKUP_DESTINATION_PATH={{ backup_destination_path }}
{% endif %}

{% if backup_frequency %}# Backup schedule frequency (daily/weekly/monthly)
BACKUP_FREQUENCY={{ backup_frequency }}
{% endif %}

{% if monitoring_enabled %}# Enable monitoring via Nagios/Icinga (yes/no)
MONITORING_ENABLED={{ monitoring_enabled | lower }}
{% endif %}

{% if monitoring_server %}# Monitoring server hostname
MONITORING_SERVER={{ monitoring_server }}
{% endif %}

{% if monitoring_snmp_community %}# SNMP community string for local monitoring
MONITORING_SNMP_COMMUNITY={{ monitoring_snmp_community }}
{% endif %}

# End of config file
