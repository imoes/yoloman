<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE busconfig PUBLIC
 "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <!--
    D-Bus Bus Configuration Template for biometryd-bin
    
    This configuration file defines the D-Bus security policies for the biometryd service.
    It grants 'root' ownership and interface access, while setting a restrictive default policy
    for other users, allowing only specific observation capabilities.
    
    Variables used:
      - service_bus_name:          The unique D-Bus service name for the main daemon.
      - device_bus_name:           The D-Bus interface name for device interactions.
      - identifier_bus_name:       The D-Bus interface name for identifier interactions.
      - template_store_bus_name:   The D-Bus interface name for template storage interactions.
      - operation_bus_name:        The D-Bus interface name for operation management.
      - operation_observer_bus_name: The D-Bus interface name for observing operation status.
  -->

  <!-- Policy for the root user: Full access to own the service and interact with all interfaces -->
  <policy user="root">
    <!-- Allow root to claim ownership of the service name -->
    <allow own="{{ service_bus_name | default('com.ubports.biometryd.Service') }}"/>
    
    <!-- Allow root to send messages to the service endpoints -->
    <allow send_destination="{{ service_bus_name | default('com.ubports.biometryd.Service') }}"/>
    <allow send_destination="{{ device_bus_name | default('com.ubports.biometryd.Device') }}"/>
    <allow send_destination="{{ identifier_bus_name | default('com.ubports.biometryd.Identifier') }}"/>
    <allow send_destination="{{ template_store_bus_name | default('com.ubports.biometryd.TemplateStore') }}"/>
    <allow send_destination="{{ operation_bus_name | default('com.ubports.biometryd.Operation') }}"/>
    <allow send_destination="{{ operation_observer_bus_name | default('com.ubports.biometryd.Operation.Observer') }}"/>
    
    <!-- Allow root to send messages using the defined interfaces -->
    <allow send_interface="{{ service_bus_name | default('com.ubports.biometryd.Service') }}"/>
    <allow send_interface="{{ device_bus_name | default('com.ubports.biometryd.Device') }}"/>
    <allow send_interface="{{ identifier_bus_name | default('com.ubports.biometryd.Identifier') }}"/>
    <allow send_interface="{{ template_store_bus_name | default('com.ubports.biometryd.TemplateStore') }}"/>
    <allow send_interface="{{ operation_bus_name | default('com.ubports.biometryd.Operation') }}"/>
    <allow send_interface="{{ operation_observer_bus_name | default('com.ubports.biometryd.Operation.Observer') }}"/>
  </policy>

  <!-- Default policy for non-root users: Restricted access -->
  <policy context="default">
    <!-- Deny non-root users from owning the main service bus name -->
    <deny own="{{ service_bus_name | default('com.ubports.biometryd.Service') }}"/>
    
    <!-- Allow non-root users to observe operation status (read-only monitoring) -->
    <allow own="{{ operation_observer_bus_name | default('com.ubports.biometryd.Operation.Observer') }}"/>
    
    <!-- Allow non-root users to send messages to service endpoints for operations -->
    <allow send_destination="{{ service_bus_name | default('com.ubports.biometryd.Service') }}"/>
    <allow send_destination="{{ device_bus_name | default('com.ubports.biometryd.Device') }}"/>
    <allow send_destination="{{ identifier_bus_name | default('com.ubports.biometryd.Identifier') }}"/>
    <allow send_destination="{{ template_store_bus_name | default('com.ubports.biometryd.TemplateStore') }}"/>
    <allow send_destination="{{ operation_bus_name | default('com.ubports.biometryd.Operation') }}"/>
    <allow send_destination="{{ operation_observer_bus_name | default('com.ubports.biometryd.Operation.Observer') }}"/>
    
    <!-- Allow non-root users to send messages using the defined interfaces -->
    <allow send_interface="{{ service_bus_name | default('com.ubports.biometryd.Service') }}"/>
    <allow send_interface="{{ device_bus_name | default('com.ubports.biometryd.Device') }}"/>
    <allow send_interface="{{ identifier_bus_name | default('com.ubports.biometryd.Identifier') }}"/>
    <allow send_interface="{{ template_store_bus_name | default('com.ubports.biometryd.TemplateStore') }}"/>
    <allow send_interface="{{ operation_bus_name | default('com.ubports.biometryd.Operation') }}"/>
    <allow send_interface="{{ operation_observer_bus_name | default('com.ubports.biometryd.Operation.Observer') }}"/>
  </policy>
</busconfig>
