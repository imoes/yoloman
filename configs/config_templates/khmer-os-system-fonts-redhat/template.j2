<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!-- Generic names -->
  <alias>
    <!-- The primary font family name for Khmer OS System. -->
    <family>{{ family_name | default('Khmer OS System') }}</family>
    <default>
      <family>system-ui</family>
    </default>
  </alias>
  <!-- Locale-specific overrides -->
  <match>
    <test name="lang" compare="contains">
      <!-- The locale code for Khmer language overrides. -->
      <string>{{ locale_code | default('km') }}</string>
    </test>
    <test name="family">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend">
      <!-- The primary font family name for Khmer OS System. -->
      <string>{{ family_name | default('Khmer OS System') }}</string>
    </edit>
  </match>
</fontconfig>
