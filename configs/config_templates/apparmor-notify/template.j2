# AppArmor Profile Configuration
# This template generates an AppArmor profile for a specific binary.
# It uses the 'unconfined' flag by default, meaning it logs violations but does not enforce them.

# ABI version declaration
# Required for AppArmor profiles to define the syntax version being used.
abi <abi/4.0>,

# Include global tunables
# Provides standard variables like @{HOME}, @{PROC}, etc., used in rules.
include <tunables/global>

# Profile Definition
# Defines the name of the profile and the executable path it applies to.
# The `flags=(unconfined)` directive ensures the profile logs denials without blocking them.
#
# Variables:
#   - name: The name of the AppArmor profile. Defaults to 'default'.
#   - path: The absolute path to the binary being profiled. Defaults to '/usr/bin/apparmor-notify'.
