{
  "config_path": "/etc/certstream-server-go/config.yml",
  "address": "127.0.0.1",
  "port": 9999,
  "timeout": 30,
  "ctfe_servers": [
    {
      "url": "https://ct.googleapis.com/logs/argon2023/",
      "name": "Google Argon2023 CT Log",
      "enabled": true
    },
    {
      "url": "https://ct.cloudflare.com/logs/nimbus2023/",
      "name": "Cloudflare Nimbus2023",
      "enabled": true
    },
    {
      "url": "https://ct.izenpe.com/logs/izenpe.com/",
      "name": "Izenpe CT Log",
      "enabled": false
    }
  ],
  "verbose": false,
  "pid_file": "/run/certstream-server-go/certstream-server-go.pid"
}
