{
  "commands": {
    "type": "list",
    "default": [],
    "description": "List of configuration blocks; only type 'connection' is supported by charon-cmd"
  },
  "commands[].type": {
    "type": "string",
    "default": "connection",
    "description": "Block type; must be 'connection' for charon-cmd"
  },
  "commands[].connections": {
    "type": "list",
    "default": [],
    "description": "List of IKE connection definitions"
  },
  "commands[].connections[].name": {
    "type": "string",
    "default": "default",
    "description": "Logical name for the connection"
  },
  "commands[].connections[].host": {
    "type": "string",
    "default": "",
    "description": "Remote gateway DNS name or IP address"
  },
  "commands[].connections[].identity": {
    "type": "string",
    "default": "",
    "description": "Client identity for IKE exchange"
  },
  "commands[].connections[].remote_identity": {
    "type": "string",
    "default": "",
    "description": "Expected server identity; defaults to --host if omitted"
  },
  "commands[].connections[].profile": {
    "type": "string",
    "default": "",
    "description": "Authentication profile (e.g., ikev2-pub, ikev1-xauth)",
    "enum": [
      "ikev2-pub",
      "ikev2-eap",
      "ikev2-pub-eap",
      "ikev1-pub",
      "ikev1-pub-am",
      "ikev1-xauth",
      "ikev1-xauth-am",
      "ikev1-xauth-psk",
      "ikev1-xauth-psk-am",
      "ikev1-hybrid",
      "ikev1-hybrid-am"
    ]
  },
  "commands[].connections[].eap_identity": {
    "type": "string",
    "default": "",
    "description": "EAP client identity"
  },
  "commands[].connections[].xauth_username": {
    "type": "string",
    "default": "",
    "description": "XAuth username"
  },
  "commands[].connections[].cert": {
    "type": "list",
    "default": [],
    "description": "Paths to trusted certificates"
  },
  "commands[].connections[].rsa": {
    "type": "string",
    "default": "",
    "description": "Path to RSA private key for authentication"
  },
  "commands[].connections[].priv": {
    "type": "string",
    "default": "",
    "description": "Path to generic private key for authentication"
  },
  "commands[].connections[].p12": {
    "type": "string",
    "default": "",
    "description": "Path to PKCS#12 file with key and certificates"
  },
  "commands[].connections[].agent": {
    "type": "bool",
    "default": false,
    "description": "Enable SSH agent authentication"
  },
  "commands[].connections[].agent_socket": {
    "type": "string",
    "default": "",
    "description": "Optional SSH agent socket path (used only if agent is true)"
  },
  "commands[].connections[].local_ts": {
    "type": "string",
    "default": "",
    "description": "Local traffic selector subnet"
  },
  "commands[].connections[].remote_ts": {
    "type": "string",
    "default": "",
    "description": "Remote traffic selector subnet"
  },
  "commands[].connections[].ike_proposal": {
    "type": "list",
    "default": [],
    "description": "IKE proposal strings (e.g., aes256-sha256-modp2048)"
  },
  "commands[].connections[].esp_proposal": {
    "type": "list",
    "default": [],
    "description": "ESP proposal strings"
  },
  "commands[].connections[].ah_proposal": {
    "type": "list",
    "default": [],
    "description": "AH proposal strings"
  },
  "commands[].connections[].version": {
    "type": "number",
    "default": 2,
    "description": "IKE version (1 or 2)"
  }
}
