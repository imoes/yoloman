# This config file is to be sourced by garb service script.

# A comma-separated list of node addresses (address[:port]) in the cluster
{% if galera_nodes is defined and galera_nodes is not none and (galera_nodes is number or galera_nodes is boolean or galera_nodes | length > 0) %}GALERA_NODES="{{ galera_nodes | default('') }}"{% else %}# GALERA_NODES=""{% endif %}

# Galera cluster name, should be the same as on the rest of the nodes.
{% if galera_group is defined and galera_group is not none and (galera_group is number or galera_group is boolean or galera_group | length > 0) %}GALERA_GROUP="{{ galera_group | default('') }}"{% else %}# GALERA_GROUP=""{% endif %}

# Optional Galera internal options string (e.g. SSL settings)
# see https://galeracluster.com/library/documentation/galera-parameters.html
{% if galera_options is defined and galera_options is not none and (galera_options is number or galera_options is boolean or galera_options | length > 0) %}GALERA_OPTIONS="{{ galera_options | default('') }}"{% else %}# GALERA_OPTIONS=""{% endif %}

# Log file for garbd. Optional, by default logs to syslog
{% if log_file is defined and log_file is not none and (log_file is number or log_file is boolean or log_file | length > 0) %}LOG_FILE="{{ log_file | default('') }}"{% else %}# LOG_FILE=""{% endif %}

# Where to persist necessary data
{% if work_dir is defined and work_dir is not none and (work_dir is number or work_dir is boolean or work_dir | length > 0) %}WORK_DIR="{{ work_dir | default('') }}"{% else %}# WORK_DIR=""{% endif %}
