{
 "algorithm": "ffsplit",
 "heuristics": [
  "ping -c1 -W1 10.0.0.1"
 ],
 "heuristics_interval": 5,
 "ip": "",
 "logging": {
  "enabled": true,
  "file": "/var/log/corosync/qdevice.log"
 },
 "models": {
  "net": {
   "address": "192.168.1.100"
  }
 },
 "nodes": [
  {
   "nodeid": 1
  },
  {
   "nodeid": 2
  }
 ],
 "port": 5403,
 "reconnect_interval": 1,
 "tie_breaker": "lowest",
 "timeout_connect": 3000,
 "timeout_exec": 3000,
 "tls": {
  "enabled": true
 },
 "tls_ca": "/etc/corosync/qdevice/net/ca.crt",
 "tls_cert": "/etc/corosync/qdevice/net/tls.crt",
 "tls_key": "/etc/corosync/qdevice/net/tls.key"
}
