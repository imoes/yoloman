{
  "bind_address": "0.0.0.0",
  "http_port": 8080,
  "ssl_enabled": true,
  "ssl_cert_path": "/etc/ssl/certs/pnopaste.crt",
  "ssl_key_path": "/etc/ssl/private/pnopaste.key",
  "base_url": "https://paste.myorg.net/",
  "backend_type": "postgresql",
  "data_dir": "/var/lib/pnopaste/data",
  "database_url": "postgresql://pnopaste:securepass@db.internal:5432/pnopaste",
  "max_paste_size_bytes": 5242880,
  "default_expiration_seconds": 604800,
  "syntax_highlighting": true,
  "allowed_languages_list": [
    "python",
    "rust",
    "go",
    "javascript",
    "sql",
    "yaml",
    "html"
  ],
  "rate_limit_enabled": true,
  "rate_limit_requests_per_minute": 5,
  "rate_limit_burst_size": 10,
  "public_only": true,
  "admin_enabled": true,
  "admin_token": "admin_7X9f3QpL2mNk5rT8wY1v",
  "log_level": "warning",
  "log_file": "/var/log/pnopaste/server.log"
}
