{
  "bind_address": "127.0.0.1",
  "http_port": 8080,
  "ssl_enabled": false,
  "ssl_cert_path": "/etc/pnopaste/ssl/cert.pem",
  "ssl_key_path": "/etc/pnopaste/ssl/key.pem",
  "base_url": "https://paste.example.com/",
  "backend_type": "filesystem",
  "data_dir": "/var/lib/pnopaste/data",
  "database_url": "sqlite:///var/lib/pnopaste/pnopaste.db",
  "max_paste_size_bytes": 1048576,
  "default_expiration_seconds": 2592000,
  "syntax_highlighting": true,
  "allowed_languages_list": [],
  "rate_limit_enabled": true,
  "rate_limit_requests_per_minute": 10,
  "rate_limit_burst_size": 20,
  "public_only": false,
  "admin_enabled": true,
  "admin_token": "",
  "log_level": "info",
  "log_file": "/var/log/pnopaste/pnopaste.log"
}
