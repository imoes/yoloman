[Desktop Entry]
# The command to execute the Solaar application.
Exec={{ exec_command | default('solaar --window=hide') }}

# The name of the icon file for the application.
Icon={{ icon_name | default('solaar') }}

# Startup notification flag.
StartupNotify=true

# Run in terminal flag.
Terminal=false

# Entry type.
Type=Application

# Semicolon-separated keywords for the desktop entry.
Keywords={{ keywords | default('logitech;unifying;receiver;mouse;keyboard;') }}

# Semicolon-separated categories for the desktop entry.
Categories={{ categories | default('Utility;GTK;') }}
#Categories=Utility;GTK;Settings;HardwareSettings;