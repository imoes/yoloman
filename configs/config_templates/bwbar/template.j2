# bwbar configuration template
# bwbar is a command-line tool that draws a bandwidth bar in the terminal.
# This configuration file controls its default behavior.

# Directory to put files into
# Default: /var/www
# The directory where bwbar will look for or store files (if applicable).
DIR={{ dir | default('/var/www') }}

# User to run the service as
# Default: www-data
# The system user account under which bwbar should execute.
# Note: bwbar is typically run interactively, but if used in a service context,
# this specifies the unprivileged user for execution.
RUNAS={{ runas | default('www-data') }}

# Options for bwbar
# Default: 'eth0 1.5'
# Specifies the network interface and bandwidth limit.
# Format: "<interface> <speed>" where speed is in Mbps (e.g., eth0 1.5).
# This controls which interface's traffic is monitored and the scale of the bar.
OPTIONS="{{ options | default('eth0 1.5') }}"