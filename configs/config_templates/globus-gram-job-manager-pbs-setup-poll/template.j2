# Globus GRAM Job Manager PBS Poll Service Configuration
# This template configures the command-line invocation for the Globus
# GRAM Job Manager when used in 'poll' mode with the PBS backend.
# The service is responsible for polling the PBS scheduler for job status
# updates.

# Path to the globus-job-manager binary
# Specifies the full path to the executable that manages job lifecycle events.
# Defaults to '/usr/sbin/globus-job-manager'.
stderr_log,local_cred - {{ globus_job_manager_bin | default('/usr/sbin/globus-job-manager') }} {{ globus_job_manager_bin | default('/usr/sbin/globus-job-manager') }} -conf {{ globus_config_file | default('/etc/globus/globus-gram-job-manager.conf') }} -type pbs