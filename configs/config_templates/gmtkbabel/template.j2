# Configuration for gmtkbabel

# Serial port device for the logger (e.g., /dev/ttyACM0, /dev/ttyUSB0)
PORT={{ PORT | default('/dev/ttyACM0') }}

# Default directory for log files (e.g., /var/log/gmtkbabel, ~/logs)
DIR={{ DIR | default('~') }}

# Base name pattern for log files; supports shell command substitution
# The default uses `date` to generate a timestamped filename (e.g., 2023-10-27_14-30)
FNAME={{ FNAME | default('`date +%Y-%m-%d_%H:%M`') }}