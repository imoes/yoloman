{
  "general": {
    "bind_address": "0.0.0.0",
    "port": 1500,
    "metadata_dir": "/var/lib/gfarm2/meta",
    "num_worker_threads": 8,
    "log_level": "info",
    "log_file": "/var/log/gfarm2/gfmd.log",
    "enable_md_replication": false,
    "md_replication_peers": [],
    "replication_port": 1501,
    "replication_timeout": 30,
    "replication_max_connections": 64
  },
  "security": {
    "auth_method": "gssapi",
    "keytab_file": "/etc/gfarm2/keytab",
    "krb_service_name": "gfmd",
    "ssl_cert_file": "",
    "ssl_key_file": "",
    "ssl_verify_client": true,
    "trusted_ca_certs": []
  },
  "limits": {
    "max_metadata_size": 10485760,
    "max_open_files": 65536,
    "max_connections": 1024,
    "client_idle_timeout": 3600
  },
  "quota": {
    "enable_quota": false,
    "quota_db_path": "/var/lib/gfarm2/quota.db"
  },
  "storage": {
    "journal_size_limit": 1073741824,
    "journal_rotation_count": 10,
    "journal_sync_writes": true,
    "journal_dir": "/var/lib/gfarm2/journal",
    "compress_metadata": true
  }
}
