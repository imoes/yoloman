# ==============================================================================
# clevis-udisks2 Desktop Entry Configuration
# ==============================================================================
# This file defines a desktop integration entry for the clevis-luks-udisks2
# helper application. It allows udisks2 (the disk management daemon) to
# automatically invoke clevis for LUKS decryption when needed.
# ==============================================================================

[Desktop Entry]

# Type of the entry; must be Application for executable actions.
Type=Application

# Display name used by desktop environments to identify the application.
Name=clevis-luks-udisks2

# The command line to execute. Defaults to the standard path for the
# clevis-luks-udisks2 helper binary.
Exec={{ exec_path | default('/usr/libexec/clevis-luks-udisks2') }}

# Hide this entry from user menus; it is a background service helper.
NoDisplay=true