{
  "client": {
    "type": "object",
    "default": {},
    "description": "Core client configuration parameters",
    "properties": {
      "proto": {
        "type": "string",
        "default": "udp",
        "description": "Protocol used for connection (e.g., udp, tcp-client)"
      },
      "remote_host": {
        "type": "string",
        "default": "vpn.example.com",
        "description": "Primary remote server hostname or IP"
      },
      "remote_port": {
        "type": "number",
        "default": 1194,
        "description": "Port number of the primary remote server"
      },
      "remotes": {
        "type": "list",
        "default": [],
        "description": "List of additional remote servers for failover/load balancing",
        "items": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "default": "",
              "description": "Remote server hostname or IP"
            },
            "port": {
              "type": "number",
              "default": 1194,
              "description": "Remote server port"
            },
            "proto": {
              "type": "string",
              "default": "",
              "description": "Protocol override (empty = use global proto)"
            }
          }
        }
      },
      "auth_algorithm": {
        "type": "string",
        "default": "SHA256",
        "description": "Authentication algorithm for control channel (e.g., SHA256, SHA512)"
      },
      "ca_file": {
        "type": "string",
        "default": "/etc/openvpn3/ca.crt",
        "description": "Path to CA certificate file"
      },
      "tls_auth_file": {
        "type": "string",
        "default": "",
        "description": "Path to TLS authentication static key file (optional)"
      },
      "cert_file": {
        "type": "string",
        "default": "/etc/openvpn3/client.crt",
        "description": "Path to client certificate file"
      },
      "key_file": {
        "type": "string",
        "default": "/etc/openvpn3/client.key",
        "description": "Path to client private key file"
      },
      "tls_cipher": {
        "type": "string",
        "default": "",
        "description": "Allowed TLS cipher list (e.g., 'TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256')"
      },
      "compression": {
        "type": "bool",
        "default": false,
        "description": "Enable legacy LZO compression (not recommended for security)"
      },
      "adaptive_compression": {
        "type": "bool",
        "default": false,
        "description": "Enable adaptive LZO compression"
      },
      "redirect_gateway": {
        "type": "bool",
        "default": true,
        "description": "Redirect all network traffic through the VPN (include default route)"
      },
      "dns_servers": {
        "type": "list",
        "default": [],
        "description": "List of DNS servers to push via DHCP (e.g., ['8.8.8.8', '1.1.1.1'])",
        "items": {
          "type": "string"
        }
      },
      "routes": {
        "type": "list",
        "default": [],
        "description": "Additional static routes to install",
        "items": {
          "type": "object",
          "properties": {
            "network": {
              "type": "string",
              "default": "",
              "description": "Network address (e.g., 192.168.10.0)"
            },
            "netmask": {
              "type": "string",
              "default": "255.255.255.0",
              "description": "Netmask (e.g., 255.255.255.0)"
            },
            "gateway": {
              "type": "string",
              "default": "",
              "description": "Optional gateway for the route (empty = use VPN interface)"
            }
          }
        }
      },
      "log_file": {
        "type": "string",
        "default": "/var/log/openvpn3/client.log",
        "description": "Path to log file (optional)"
      },
      "verb_level": {
        "type": "number",
        "default": 3,
        "description": "Verbosity level of log output (0\u201311)"
      },
      "log_level": {
        "type": "number",
        "default": null,
        "description": "OpenVPN daemon log level (overrides verb_level; 0\u20139)"
      },
      "daemonize": {
        "type": "bool",
        "default": true,
        "description": "Run as background daemon"
      },
      "pid_file": {
        "type": "string",
        "default": "/run/openvpn3/client.pid",
        "description": "Path to PID file"
      },
      "user": {
        "type": "string",
        "default": "nobody",
        "description": "User to drop privileges to"
      },
      "group": {
        "type": "string",
        "default": "nogroup",
        "description": "Group to drop privileges to"
      },
      "no_adjust_mss": {
        "type": "bool",
        "default": true,
        "description": "Prevent TCP MSS adjustment (helps with broken routers)"
      },
      "no_routes_auto": {
        "type": "bool",
        "default": false,
        "description": "Disable automatic route injection (for manual routing)"
      },
      "no_ipv6": {
        "type": "bool",
        "default": true,
        "description": "Disable IPv6 support in client"
      },
      "tun_mtu": {
        "type": "number",
        "default": 1500,
        "description": "TUN interface MTU"
      },
      "tun_mtu_extra": {
        "type": "number",
        "default": 0,
        "description": "Additional MTU for header space (e.g., 16)"
      },
      "fragment": {
        "type": "number",
        "default": null,
        "description": "Fragment size (in bytes) for UDP (e.g., 1300)"
      }
    }
  }
}
