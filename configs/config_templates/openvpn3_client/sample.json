{
  "client": {
    "proto": "udp",
    "remote_host": "vpn.provider.net",
    "remote_port": 1194,
    "remotes": [
      {
        "host": "backup1.provider.net",
        "port": 443
      },
      {
        "host": "backup2.provider.net",
        "port": 1194,
        "proto": "tcp-client"
      }
    ],
    "auth_algorithm": "SHA256",
    "ca_file": "/etc/openvpn3/ca.crt",
    "tls_auth_file": "/etc/openvpn3/ta.key",
    "cert_file": "/etc/openvpn3/client.crt",
    "key_file": "/etc/openvpn3/client.key",
    "tls_cipher": "TLS_AES_256_GCM_SHA384",
    "compression": false,
    "adaptive_compression": false,
    "redirect_gateway": true,
    "dns_servers": [
      "10.8.0.1",
      "8.8.8.8"
    ],
    "routes": [
      {
        "network": "192.168.10.0",
        "netmask": "255.255.255.0"
      },
      {
        "network": "10.10.0.0",
        "netmask": "255.255.0.0",
        "gateway": "10.8.0.5"
      }
    ],
    "log_file": "/var/log/openvpn3/client.log",
    "verb_level": 2,
    "log_level": 4,
    "daemonize": true,
    "pid_file": "/run/openvpn3/client.pid",
    "user": "nobody",
    "group": "nobody",
    "no_adjust_mss": true,
    "no_routes_auto": false,
    "no_ipv6": true,
    "tun_mtu": 1500,
    "tun_mtu_extra": 16,
    "fragment": null
  }
}
