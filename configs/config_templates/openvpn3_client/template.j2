{#
    OpenVPN 3 Linux Client Configuration Template
    ================================================
    This template generates the `ovpn3` client configuration file.
    It is designed to be self-documenting: every directive is preceded by
    a comment derived from the schema description.

    Variable Usage Rules:
    - All variables from the `client` mapping are accessed via `(client | default({})).field`.
    - This ensures that if `client` is undefined, the template renders safely with defaults
      rather than failing with a Jinja2 undefined error.
    - Defaults are taken from the schema definitions provided.
#}

{# OpenVPN 3 Client Configuration File #}
{# Generated by Ansible - do not edit manually #}

{# Connection parameters #}
{# Core client mode switch: required for OpenVPN 3 Linux client #}
client

{# Protocol to use for the connection (e.g., udp, tcp) #}
proto {{ (client | default({})).proto | default('udp') }}

{# Primary remote server address and port #}
{# remote <host> <port> [proto] #}
remote {{ (client | default({})).remote_host | default('0.0.0.0') }} {{ (client | default({})).remote_port | default(1194) }}

{# Alternate remote entries for failover #}
{% for remote in ((client | default({})).remotes | default([])) %}
# Alternate remote entry {{ loop.index }}
{# Remote host for failover #}
{# Remote port for failover #}
{# Protocol for this specific remote, inherits from client.proto if not set #}
remote {{ remote.host }} {{ remote.port }} {{ remote.proto | default((client | default({})).proto | default('udp')) }}
{% endfor %}

{# Retry indefinitely if the server is not reachable #}
resolv-retry infinite

{# Security and authentication #}
{# Authentication algorithm (e.g., sha256) #}
auth {{ (client | default({})).auth_algorithm | default('sha256') }}

{# Use external user/pass file for authentication #}
auth-user-pass

{# Certificate Authority file path #}
{% if (client | default({})).ca_file is defined and (client | default({})).ca_file %}
# Certificate Authority file
ca {{ (client | default({})).ca_file }}
{% endif %}

{# Additional TLS authentication file (static key) #}
{% if (client | default({})).tls_auth_file is defined and (client | default({})).tls_auth_file %}
# Additional TLS authentication (static key)
tls-auth {{ (client | default({})).tls_auth_file }} 1
{% endif %}

{# Client certificate and private key #}
{% if (client | default({})).cert_file is defined and (client | default({})).cert_file and (client | default({})).key_file is defined and (client | default({})).key_file %}
# Client certificate and key
cert {{ (client | default({})).cert_file }}
key {{ (client | default({})).key_file }}
{% endif %}

{# TLS cipher suite restriction #}
{% if (client | default({})).tls_cipher is defined and (client | default({})).tls_cipher %}
# TLS cipher suite
tls-cipher "{{ (client | default({})).tls_cipher }}"
{% endif %}

{# Compression and optimization #}
{% if (client | default({})).compression is defined and (client | default({})).compression %}
# Enable compression (legacy; use only if needed)
comp-lzo
{% endif %}

{% if (client | default({})).adaptive_compression is defined %}
# Adaptive compression (optional)
{% if (client | default({})).adaptive_compression %}
comp-lzo adaptive
{% else %}
# comp-lzo adaptive
{% endif %}
{% endif %}

{# Network and routing #}
{% if (client | default({})).redirect_gateway is defined %}
# Route all traffic through VPN
{% if (client | default({})).redirect_gateway %}
redirect-gateway def1 bypass-dhcp
{% else %}
# redirect-gateway
{% endif %}
{% endif %}

{% if (client | default({})).dns_servers is defined and (client | default({})).dns_servers %}
# Custom DNS servers
{% for dns in (client | default({})).dns_servers %}
dhcp-option DNS {{ dns }}
{% endfor %}
{% endif %}

{% if (client | default({})).routes is defined and (client | default({})).routes %}
# Static routes
{% for route in (client | default({})).routes %}
route {{ route.network }} {{ route.netmask }} {% if route.gateway is defined and route.gateway %}{{ route.gateway }}{% endif %}
{% endfor %}
{% endif %}

{# Logging and verbosity #}
{% if (client | default({})).log_file is defined and (client | default({})).log_file %}
# Log file location
log {{ (client | default({})).log_file }}
{% endif %}

{# Verbose level for logging (0-6) #}
verb {{ (client | default({})).verb_level | default(1) }}

{% if (client | default({})).log_level is defined %}
# Verbosity of OpenVPN daemon logging
{% if (client | default({})).log_level != (client | default({})).verb_level %}
log-level {{ (client | default({})).log_level }}
{% endif %}
{% endif %}

{# Daemon behavior #}
{% if (client | default({})).daemonize is defined and (client | default({})).daemonize %}
daemon openvpn3-client
{% endif %}

{% if (client | default({})).pid_file is defined and (client | default({})).pid_file %}
writepid {{ (client | default({})).pid_file }}
{% endif %}

{% if (client | default({})).user is defined and (client | default({})).user %}
{# OS user to run the process as (for privilege dropping) #}
user {{ (client | default({})).user }}
{% endif %}

{% if (client | default({})).group is defined and (client | default({})).group %}
{# OS group to run the process as #}
group {{ (client | default({})).group }}
{% endif %}

{# Security hardening #}
{% if (client | default({})).no_adjust_mss is defined and (client | default({})).no_adjust_mss %}
# Prevent TCP MSS issues
no-adjust-mss
{% endif %}

{% if (client | default({})).no_routes_auto is defined and (client | default({})).no_routes_auto %}
# Prevent automatic route injection
no-route
{% endif %}

{% if (client | default({})).no_ipv6 is defined and (client | default({})).no_ipv6 %}
# Disable IPv6
no-ipv6
{% endif %}

{# Keepalive and timeouts #}
keepalive 10 60
ping-timer-rem

{# TUN/MTU size #}
tun-mtu {{ (client | default({})).tun_mtu | default(1500) }}

{% if (client | default({})).tun_mtu_extra is defined and (client | default({})).tun_mtu_extra %}
tun-mtu-extra {{ (client | default({})).tun_mtu_extra }}
{% endif %}

{% if (client | default({})).fragment is defined and (client | default({})).fragment %}
fragment {{ (client | default({})).fragment }}
{% endif %}

{# Persistence #}
persist-key
persist-tun