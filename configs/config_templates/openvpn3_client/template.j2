# OpenVPN 3 client configuration file
# Generated by template engine; do not edit manually
# Connection parameters
client
proto {{ client.proto }}
remote {{ client.remote_host }} {{ client.remote_port }}
{% for remote in client.remotes %}
# Alternate remote entry
remote {{ remote.host }} {{ remote.port }} {{ remote.proto | default(client.proto) }}
{% endfor %}
resolv-retry infinite

# Security and authentication
auth {{ client.auth_algorithm }}
auth-user-pass
{% if client.ca_file %}
# Certificate Authority file
ca {{ client.ca_file }}
{% endif %}
{% if client.tls_auth_file %}
# Additional TLS authentication (static key)
tls-auth {{ client.tls_auth_file }} 1
{% endif %}
{% if client.cert_file and client.key_file %}
# Client certificate and key
cert {{ client.cert_file }}
key {{ client.key_file }}
{% endif %}
{% if client.tls_cipher %}
# TLS cipher suite
tls-cipher "{{ client.tls_cipher }}"
{% endif %}

# Compression and optimization
{% if client.compression %}
# Enable compression (legacy; use only if needed)
comp-lzo
{% endif %}
{% if client.adaptive_compression is defined %}
# Adaptive compression (optional)
{% if client.adaptive_compression %}comp-lzo adaptive{% else %}# comp-lzo adaptive{% endif %}
{% endif %}

# Network and routing
{% if client.redirect_gateway is defined %}
# Route all traffic through VPN
{% if client.redirect_gateway %}redirect-gateway def1 bypass-dhcp{% else %}# redirect-gateway{% endif %}
{% endif %}
{% if client.dns_servers %}
# Custom DNS servers
{% for dns in client.dns_servers %}dhcp-option DNS {{ dns }}
{% endfor %}
{% endif %}
{% if client.routes %}
# Static routes
{% for route in client.routes %}route {{ route.network }} {{ route.netmask }} {% if route.gateway %}{{ route.gateway }}{% endif %}
{% endfor %}
{% endif %}

# Logging and verbosity
{% if client.log_file %}
# Log file location
log {{ client.log_file }}
{% endif %}
verb {{ client.verb_level }}
{% if client.log_level is defined %}
# Verbosity of OpenVPN daemon logging
{% if client.log_level != client.verb_level %}log-level {{ client.log_level }}{% endif %}
{% endif %}

# Daemon behavior
{% if client.daemonize %}daemon openvpn3-client
{% endif %}
{% if client.pid_file %}writepid {{ client.pid_file }}
{% endif %}
{% if client.user %}user {{ client.user }}
{% endif %}
{% if client.group %}group {{ client.group }}
{% endif %}

# Security hardening
{% if client.no_adjust_mss %}# Prevent TCP MSS issues
no-adjust-mss
{% endif %}
{% if client.no_routes_auto %}# Prevent automatic route injection
no-route
{% endif %}
{% if client.no_ipv6 %}# Disable IPv6
no-ipv6
{% endif %}

# Keepalive and timeouts
keepalive 10 60
ping-timer-rem
tun-mtu {{ client.tun_mtu }}
{% if client.tun_mtu_extra %}tun-mtu-extra {{ client.tun_mtu_extra }}{% endif %}
{% if client.fragment %}fragment {{ client.fragment }}{% endif %}

# Persistence
persist-key
persist-tun
