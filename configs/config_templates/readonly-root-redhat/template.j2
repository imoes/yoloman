# Configuration for readonly-root-redhat
# This template generates a configuration file that defines which directories and files
# should remain writable or be preserved when the root filesystem is mounted read-only.

# List of directories that should remain writable.
# These directories are exempted from read-only mounting, allowing applications
# to write logs, cache data, or state information without errors.
dirs	{{ dirs | default(['/var/cache/man', '/var/gdm', '/var/lib/xkb', '/var/log', '/var/lib/puppet', '/var/lib/dbus', '/var/lib/mlocate', '/var/lib/systemd/rfkill']) | join('\n\t') }}

# List of directories that should be emptied on boot.
# These directories are mounted as tmpfs or are cleared at startup to ensure
# a clean state for the next boot cycle, preventing stale data accumulation.
empty	{{ empty_dirs | default(['/tmp', '/var/cache/foomatic', '/var/cache/logwatch', '/var/cache/httpd/ssl', '/var/cache/httpd/proxy', '/var/cache/php-pear', '/var/cache/systemtap', '/var/db/nscd', '/var/lib/dav', '/var/lib/dhcpd', '/var/lib/dhclient', '/var/lib/php', '/var/lib/pulse', '/var/lib/systemd/timers', '/var/lib/ups', '/var/lib/chrony', '/var/tmp']) | join('\n\t') }}

# List of files that should be preserved or handled specially.
# Specific files that require persistent state or configuration across boots
# are listed here to be excluded from cleanup operations or remounted with write access.
files	{{ files | default(['/etc/adjtime', '/etc/ntp.conf', '/etc/resolv.conf', '/etc/lvm/cache', '/etc/lvm/archive', '/etc/lvm/backup', '/var/account', '/var/lib/arpwatch', '/var/lib/NetworkManager', '/var/cache/alchemist', '/var/lib/gdm', '/var/lib/iscsi', '/var/lib/logrotate.status', '/var/lib/ntp', '/var/lib/xen', '/var/empty/sshd/etc/localtime', '/var/lib/systemd/random-seed', '/var/spool', '/var/lib/samba', '/var/log/audit/audit.log', '/var/lib/nfs']) | join('\n\t') }}
