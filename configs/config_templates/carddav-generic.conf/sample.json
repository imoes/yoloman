{
  "account_type": "CardDAV",
  "account_name": "Nextcloud Contacts",
  "carddav_url": "https://nextcloud.example.com/remote.php/dav/addressbooks/users/jane/contacts/",
  "user": "jane",
  "password_ref": "keyring://nextcloud/jane-carddav",
  "display_name_value": "Jane\u2019s Contacts",
  "use_ssl_value": true,
  "verify_ssl_value": true,
  "auth_method_value": "Basic",
  "timeout_value": 30,
  "max_connections_value": 4,
  "supported_methods_value": [
    "GET",
    "PROPFIND",
    "REPORT",
    "PUT",
    "DELETE"
  ],
  "custom_headers": [
    {
      "name": "User-Agent",
      "value": "Lomiri-Online-Accounts/1.0"
    },
    {
      "name": "X-Request-ID",
      "value": "{{ account_name | replace(' ', '-').lower() }}"
    }
  ],
  "cache_enabled_value": true,
  "cache_path_value": "/var/cache/online-accounts/carddav/nextcloud/",
  "cache_ttl_value": 7200,
  "cache_max_size_value": 104857600,
  "sync_enabled_value": true,
  "sync_interval_value": 900,
  "sync_on_connect_value": true,
  "sync_on_battery_value": false
}
