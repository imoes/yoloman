[# CardDAV Generic Account Plugin Configuration
# Defines CardDAV server connection settings and optional features
[Account]
{{ account_type }}={{ account_name }}
{{ endpoint }}={{ carddav_url }}
{{ username }}={{ user }}
{{ password }}={{ password_ref }}
{% if display_name %}
{{ display_name }}={{ display_name_value }}
{% endif %}
{% if use_ssl %}
{{ use_ssl }}={{ use_ssl_value }}
{% endif %}
{% if verify_ssl %}
{{ verify_ssl }}={{ verify_ssl_value }}
{% endif %}
{% if auth_method %}
{{ auth_method }}={{ auth_method_value }}
{% endif %}
{% if timeout %}
{{ timeout }}={{ timeout_value }}
{% endif %}
{% if max_connections %}
{{ max_connections }}={{ max_connections_value }}
{% endif %}
{% if supported_methods %}
{{ supported_methods }}={{ supported_methods_value | join(', ') }}
{% endif %}
{% for header in custom_headers %}
{{ header.name }}={{ header.value }}
{% endfor %}

[Cache]
{{ cache_enabled }}={{ cache_enabled_value }}
{% if cache_path %}
{{ cache_path }}={{ cache_path_value }}
{% endif %}
{% if cache_ttl %}
{{ cache_ttl }}={{ cache_ttl_value }}
{% endif %}
{% if cache_max_size %}
{{ cache_max_size }}={{ cache_max_size_value }}
{% endif %}

[Sync]
{{ sync_enabled }}={{ sync_enabled_value }}
{{ sync_interval }}={{ sync_interval_value }}
{% if sync_on_connect %}
{{ sync_on_connect }}={{ sync_on_connect_value }}
{% endif %}
{% if sync_on_battery %}
{{ sync_on_battery }}={{ sync_on_battery_value }}
{% endif %}
