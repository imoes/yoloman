# Configuration file for sxhkd (Simple X Hotkey Daemon)
# This file is auto-generated by Ansible. Do not edit manually.
# See sxhkd(1) for syntax details regarding the binding format.

# ==============================================================================
# Global Settings
# ==============================================================================

# The shell interpreter used to execute bound commands.
# Default: /bin/sh
# Syntax: shell = "command"
# Example: shell = "/bin/bash"
shell = "{{ shell | default('/bin/sh') }}"

# Timeout in seconds for chord chains (sequences of key presses).
# Set to 0 to disable timeout, meaning sxhkd will wait indefinitely for the chord to complete.
# Default: 0
# Syntax: chord_timeout = N
chord_timeout = {{ chord_timeout | default(0) }}

# Keysym name used to abort an ongoing chord chain.
# Pressing this key will cancel the current sequence of keys being held for a chord.
# Default: escape
# Syntax: abort_key = keysym_name
abort_key = {{ abort_key | default('escape') }}

# Number of mapping notify events to handle.
# These events occur when keyboard layouts are switched.
# 1 = handle one event, -1 = handle all events (recommended if switching layouts often), 0 = ignore.
# Default: 0
# Syntax: mapping_notify = COUNT
mapping_notify = {{ mapping_notify | default(0) }}

# Redirection file for command output (stdout and stderr) generated by bound commands.
# If empty, output is not redirected to a specific file.
# Default: '' (empty string, no redirection)
# Syntax: redirect = /path/to/file
redirect = "{{ redirect | default('') }}"

# Path to a FIFO (named pipe) for sending status information to sxhkd.
# If empty, no status FIFO is used.
# Default: '' (empty string, no FIFO)
# Syntax: status_fifo = /path/to/fifo
status_fifo = "{{ status_fifo | default('') }}"

# ==============================================================================
# Key Bindings
# ==============================================================================
# Define hotkey chords and their associated commands.
#
# Syntax:
#   Hotkey combination(s)
#       command to execute
#
# - Multiple keys in a chord are separated by semicolons (;).
#   Example: alt + tab; super + tab
# - The command must be indented with spaces (typically 4 spaces) on the next line.
# - Multiple binding blocks can be defined; they are processed in order.

{% for binding in bindings | default([]) %}
# Binding Definition
# Hotkey(s): {{ binding.hotkey | join(' ; ') }}
# Command  : {{ binding.command }}
{{ binding.hotkey | join(' ; ') }} 
    {{ binding.command }}

{% endfor %}