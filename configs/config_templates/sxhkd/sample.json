{
  "shell": "/bin/bash",
  "chord_timeout": 2,
  "abort_key": "escape",
  "mapping_notify": 1,
  "redirect": "/tmp/sxhkd.log",
  "status_fifo": "",
  "bindings": [
    {
      "hotkey": [
        "super",
        "Return"
      ],
      "command": "urxvt"
    },
    {
      "hotkey": [
        "super",
        "alt",
        "l"
      ],
      "command": "i3lock"
    },
    {
      "hotkey": [
        "super",
        "f"
      ],
      "command": "firefox"
    },
    {
      "hotkey": [
        "super",
        "up"
      ],
      "command": "i3-msg layout toggle split"
    },
    {
      "hotkey": [
        "super",
        "down"
      ],
      "command": "i3-msg focus down"
    },
    {
      "hotkey": [
        "alt",
        "tab"
      ],
      "command": "i3-msg focus next"
    },
    {
      "hotkey": [
        "ctrl",
        "alt",
        "Delete"
      ],
      "command": "systemctl poweroff"
    }
  ]
}
