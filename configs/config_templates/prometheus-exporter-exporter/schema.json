{
  "config_file": {
    "type": "string",
    "default": "/etc/prometheus/exporter-exporter.yml",
    "description": "The path to the configuration file."
  },
  "listen_address": {
    "type": "string",
    "default": ":9999",
    "description": "The address to listen on for HTTP requests."
  },
  "proxy_path": {
    "type": "string",
    "default": "/proxy",
    "description": "The path for proxy requests."
  },
  "telemetry_path": {
    "type": "string",
    "default": "/metrics",
    "description": "The path for telemetry/metrics requests."
  },
  "tls_ca": {
    "type": "string",
    "default": "ca.pem",
    "description": "Path to CA to auth clients against."
  },
  "tls_cert": {
    "type": "string",
    "default": "cert.pem",
    "description": "Path to TLS certificate."
  },
  "tls_key": {
    "type": "string",
    "default": "key.pem",
    "description": "Path to TLS private key."
  }
}
