# Configuration for cryptsetup suspend/resume behavior.
# This file is sourced by /usr/share/cryptsetup/cryptsetup-functions or similar scripts.
# It MUST be writable only by root for security reasons.

# Whether to automatically unlock user sessions (e.g., LUKS-bound keyrings)
# after the system resumes from suspend.
# Schema: UNLOCK_SESSIONS (string, default='false')
# Accepted values: 'true' or 'false'
UNLOCK_SESSIONS="{{ UNLOCK_SESSIONS | default('false') }}"

# Whether to keep the unpacked initramfs image in RAM after the system boots.
# This accelerates suspension/resume cycles because the encrypted volume header
# does not need to be read from disk again.
# Note: This setting is ignored when the default initramfs image is newer than
# the cached/unpacked image in RAM.
# Schema: KEEP_INITRAMFS (string, default='false')
# Accepted values: 'true' or 'false'
KEEP_INITRAMFS="{{ KEEP_INITRAMFS | default('false') }}"