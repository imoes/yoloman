{
  "base_uri": "/monitorix",
  "http_host": "0.0.0.0",
  "http_port": 8080,
  "use_internal_server": true,
  "template_dir": "/usr/share/monitorix/templates",
  "data_dir": "/var/lib/monitorix",
  "pid_file": "/run/monitorix/monitorix.pid",
  "log_file": "-",
  "log_level": 3,
  "timezone": "UTC",
  "lang": "en",
  "interval": 60,
  "history_hours": 168,
  "mysql_enabled": false,
  "mysql_host": "localhost",
  "mysql_port": 3306,
  "mysql_user": "monitorix",
  "mysql_password": "",
  "mysql_socket": "/run/mysqld/mysqld.sock",
  "monitored_services": [
    {
      "name": "SSH Server",
      "enabled": true,
      "unit": "sshd",
      "description": "OpenSSH daemon"
    },
    {
      "name": "Web Server",
      "enabled": true,
      "unit": "nginx",
      "description": "Nginx HTTP server"
    }
  ],
  "monitored_ports": [
    {
      "name": "HTTP",
      "enabled": true,
      "port": 80,
      "proto": "tcp"
    },
    {
      "name": "HTTPS",
      "enabled": true,
      "port": 443,
      "proto": "tcp"
    }
  ],
  "monitored_filesystems": [
    {
      "name": "root",
      "enabled": true,
      "mount_point": "/",
      "type": "auto"
    },
    {
      "name": "home",
      "enabled": true,
      "mount_point": "/home",
      "type": "xfs"
    }
  ],
  "monitored_interfaces": [
    {
      "name": "LAN",
      "enabled": true,
      "device": "eth0"
    },
    {
      "name": "WAN",
      "enabled": true,
      "device": "ens3"
    }
  ],
  "monitored_processes": [
    {
      "name": "nginx workers",
      "enabled": true,
      "pattern": "nginx"
    },
    {
      "name": "postgres backends",
      "enabled": true,
      "pattern": "postgres"
    }
  ],
  "webserver_enabled": true,
  "webserver_type": "nginx",
  "webserver_url": "http://localhost/nginx_status",
  "webserver_user": "",
  "webserver_password": "",
  "smart_enabled": true,
  "smart_devices": [
    "/dev/sda",
    "/dev/sdb"
  ]
}
