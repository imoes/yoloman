# ltrace 0.7.3 only read ~/.ltrace.conf and /etc/ltrace.conf,
# and shipped standard library prototypes in /etc/ltrace.conf.
#
# ltrace 0.7.91 reads files named "$library.conf" under:
#   $XDG_CONFIG_HOME/ltrace/ (if $XDG_CONFIG_HOME set)
#   ~/.config/ltrace/        (otherwise)
#   ~/.ltrace/
#
#   $XDG_CONFIG_DIRS/ltrace/ (for each element)
#   /usr/share/ltrace/
# then
#   ~/.ltrace.conf
#   /etc/ltrace.conf
# (see ltrace(1) for minutiae).
#
# To aid migration from 0.7.3, /usr/share/doc/ltrace/ltrace.conf.old
# has been provided, and diffing from /etc/ltrace.conf thereto
# should help you filter your additions to keep in this file.

# Maximum number of system calls traced per process.
max_syscalls {{ max_syscalls | default(4096) }}

# Maximum number of stack frames traced.
max_stack {{ max_stack | default(1024) }}

# Maximum length of strings traced.
max_str_len {{ max_str_len | default(64) }}

# Maximum depth of recursive library calls traced.
max_rec_depth {{ max_rec_depth | default(32) }}

# List of library names to ignore during tracing.
# Note: ltrace expects a whitespace-separated list of library names.
ignore_libs {{ ignore_libs | default(['ld.so', 'linux-gate.so']) | join(' ') }}
