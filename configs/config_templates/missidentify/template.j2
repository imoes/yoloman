# missidentify configuration template
# Controls the behavior of the missidentify tool as documented in missidentify(1).
#
# This configuration file is self-documenting. Every setting corresponds to a
# command-line flag and includes its description as a comment for easy reference.

# Enable recursive mode (-r) to examine all subdirectories.
# When enabled, the tool will traverse into subdirectories of scan_root.
recursive: {{ recursive | default(false) | lower }}

# Enable silent mode (-q) to suppress non-fatal error messages.
# When enabled, only critical errors or results (if not suppressed by other flags) are shown.
silent: {{ silent | default(false) | lower }}

# Display filenames of all executable files (-a), not just those with unknown extensions.
# If false, only files identified as unknown/misidentified are listed.
show_all: {{ show_all | default(false) | lower }}

# Enable bare mode (-b) to strip leading directory information from output.
# This outputs just the filename basename rather than the full path.
bare_mode: {{ bare_mode | default(false) | lower }}

# Enable relative file paths (-l) instead of absolute paths.
# Paths will be relative to scan_root if this is true.
relative_paths: {{ relative_paths | default(false) | lower }}

# Enable verbose mode (-v) to show progress indicators.
# Provides more detailed output during the scanning process.
verbose: {{ verbose | default(false) | lower }}

# Length of strings to print with each filename (-s/-S len).
# Set to 0 to disable string content printing entirely.
# A positive integer limits the number of bytes displayed for each file's content.
string_length: {{ string_length | default(0) }}

# The root directory or file path to scan with missidentify.
# The tool will start its analysis from this location.
scan_root: {{ scan_root | default("/tmp") }}