# ALSA USB Stream Plugin Configuration
# Generated by Ansible for alsa-plugins-usbstream-redhat
# This template defines the `pcm.usbstream` plugin configuration used by ALSA
# to handle USB audio devices with specific stream parameters.

pcm.usbstream {
	@args [ CARD RATE PERIOD_SIZE ]
	@args.CARD {
		type string
		default {
			func refer
			name defaults.pcm.card
		}
	}
	@args.RATE {
		type integer
	}
	@args.PERIOD_SIZE {
		type integer
	}

	# Base plugin type for USB streaming
	type usb_stream

	# The ALSA card name or index for the USB audio device.
	# Maps to the `card` schema field.
	card {{ card | default('$CARD') }}

	# The sample rate for the USB stream output.
	# Maps to the `rate` schema field.
	rate {{ rate | default('$RATE') }}

	# The period size for the USB stream buffer.
	# Maps to the `period_size` schema field.
	period_size {{ period_size | default('$PERIOD_SIZE') }}

	hint {
		show {
			@func refer
			name defaults.namehint.basic
		}
                description "USB Stream Output"
	}
}
