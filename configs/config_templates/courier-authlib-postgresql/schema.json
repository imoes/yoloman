{
  "pgsql_host": {
    "type": "string",
    "default": "localhost",
    "description": "PostgreSQL server hostname or IP address"
  },
  "pgsql_port": {
    "type": "number",
    "default": 5432,
    "description": "PostgreSQL server port"
  },
  "pgsql_dbname": {
    "type": "string",
    "default": "auth",
    "description": "Database name to connect to"
  },
  "pgsql_user": {
    "type": "string",
    "default": "authuser",
    "description": "Database user for authentication"
  },
  "pgsql_password": {
    "type": "string",
    "default": "secret",
    "description": "Password for the database user"
  },
  "pgsql_user_table": {
    "type": "string",
    "default": "passwd",
    "description": "Name of the table containing user data"
  },
  "pgsql_crypt_pwfield": {
    "type": "string",
    "default": "crypt",
    "description": "Field name for encrypted passwords"
  },
  "pgsql_clear_pwfield": {
    "type": "string",
    "default": "",
    "description": "Field name for clear-text passwords (optional)"
  },
  "pgsql_default_domain": {
    "type": "string",
    "default": "",
    "description": "Default domain to append to usernames without domain"
  },
  "pgsql_uid_field": {
    "type": "string",
    "default": "uid",
    "description": "Field containing numeric user ID"
  },
  "pgsql_gid_field": {
    "type": "string",
    "default": "gid",
    "description": "Field containing numeric group ID"
  },
  "pgsql_login_field": {
    "type": "string",
    "default": "id",
    "description": "Field used as login identifier"
  },
  "pgsql_home_field": {
    "type": "string",
    "default": "home",
    "description": "Field containing user's home directory"
  },
  "pgsql_name_field": {
    "type": "string",
    "default": "name",
    "description": "Field containing user's full name (optional)"
  },
  "pgsql_maildir_field": {
    "type": "string",
    "default": "",
    "description": "Field containing maildir path override (optional)"
  },
  "pgsql_defaultdelivery": {
    "type": "string",
    "default": "",
    "description": "Field for custom mail delivery instructions (Courier only)"
  },
  "pgsql_quota_field": {
    "type": "string",
    "default": "",
    "description": "Field containing maildir quota (optional)"
  },
  "pgsql_auxoptions_field": {
    "type": "string",
    "default": "",
    "description": "Field containing auxiliary options string (optional)"
  },
  "pgsql_where_clause_domain": {
    "type": "string",
    "default": "",
    "description": "Domain name to use in WHERE clause (if used)"
  }
}
