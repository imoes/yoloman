# ==============================================================================
# checkrestart(8) Configuration Template
# ==============================================================================
#
# This file is used by the `checkrestart` utility (from debian-goodies) to exclude
# specific file paths from the report of deleted files held open by running
# processes. It is primarily used with the `-x` option (exclude patterns).
#
# Syntax:
#   The format is `type:^/regex/` where `type` can be `file:` or `process:`.
#   Lines starting with `#` are ignored.
#
# Self-Documentation Note:
#   This template uses variable defaults to ensure it works correctly even if
#   specific variables are not defined in the Ansible inventory.
# ==============================================================================

## Excluding individual files
# Common locations for temporary files which are created and unlinked,
# or other locations where deleted files are expected (eg, apache2
# uses /dev/zero, nginx uses files in /var and many prorams use /tmp
# or /home)
#
# Variable: checkrestart_temp_file_dirs
# Description: List of directory prefixes to exclude temporary or volatile files.
# Default: ['dev', 'run', 'home', 'tmp', 'var']
file:^/( {{ checkrestart_temp_file_dirs | default(['dev', 'run', 'home', 'tmp', 'var']) | join('|') }} )/

# /memfd: - see memfd_create(2), used by (eg) gnome
# /[aio] - asynchronous io files, used by (eg) MySQL
# /SYSV - SysV shared memory segments, used by (eg), gnome-shell
#
# Variable: checkrestart_memfd_aio_sysv_pattern
# Description: List of patterns to exclude special memory/file mappings (e.g., memfd, aio, SysV shm).
# Default: ['memfd:', '[aio]', 'SYSV']
file:^/( {{ checkrestart_memfd_aio_sysv_pattern | default(['memfd:', '[aio]', 'SYSV']) | join('|') }} )

# Used by chromium, firefox (#979878)
# Exclude procfd info files which are often transient or not indicative of actual leaks.
file:^/proc/[0-9]+/fdinfo$

# /i915 "used by some X apps on systems with Intel video" -
#  see https://etbe.coker.com.au/2020/02/04/deleted-mapped-files/
#
# Variable: checkrestart_x11_intel_video_pattern
# Description: List of patterns to exclude Intel graphics-related virtual files (e.g., /drm, /i915).
# Default: ['drm', 'i915']
file:^/( {{ checkrestart_x11_intel_video_pattern | default(['drm', 'i915']) | join('|') }} )
