# =============================================================================
# unace Configuration Template
# =============================================================================
# This template generates a configuration file for the `unace` utility.
# It defines which archive to process, the operation to perform,
# where to extract files, and whether to auto-accept prompts.
# =============================================================================

# -----------------------------------------------------------------------------
# command: The unace command to perform: 'e' (extract), 'l' (list), 't' (test),
#          'v' (verbose list), or 'x' (extract with full path).
# Default: 'l'
# -----------------------------------------------------------------------------
command: "{{ command | default('l') }}"

# -----------------------------------------------------------------------------
# archive_path: Path to the ACE archive file to process.
# Default: '/var/lib/unace/archive.ace'
# -----------------------------------------------------------------------------
archive_path: "{{ archive_path | default('/var/lib/unace/archive.ace') }}"

# -----------------------------------------------------------------------------
# destination_dir: Target directory for extracted files when using 'e' or 'x' commands.
# Default: '/tmp/unace_output'
# -----------------------------------------------------------------------------
destination_dir: "{{ destination_dir | default('/tmp/unace_output') }}"

# -----------------------------------------------------------------------------
# auto_yes: If true, passes the -y switch to assume 'yes' on all questions,
#           never asking for input.
# Default: False
# -----------------------------------------------------------------------------
auto_yes: {{ auto_yes | default(false) }}