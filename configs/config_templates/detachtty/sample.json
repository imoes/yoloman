{
  "socket_path": "/run/detachtty/bottom.sock",
  "command": "/usr/bin/bottom",
  "command_args": [
    "--config",
    "/etc/bottom/bottom.toml"
  ],
  "no_detach": true,
  "log_file": "/var/log/detachtty/bottom.log",
  "pid_file": "/run/detachtty/bottom.pid",
  "dribble_file": "/var/log/detachtty/bottom.dribble",
  "socket_dir_mode": "700"
}
