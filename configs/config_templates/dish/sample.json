{
  "dish_conf_dir": "/etc/dish/conf",
  "connector": "ssh",
  "user": "admin",
  "timeout_per_host": 45,
  "total_timeout": 600,
  "hosts_file": "/etc/dish/conf/hosts",
  "resting_hosts_file": "/etc/dish/conf/rests",
  "password_file": "/etc/dish/conf/pass",
  "ignore_pass_perms": true,
  "fork_mode": true,
  "seq_delay": 0.5,
  "log_file": "/var/log/dish.log",
  "host_log_base": "/var/log/dish_host",
  "journal": "/etc/dish/conf/journal",
  "options_file": "/etc/dish/conf/options",
  "prompt_regex": "# $",
  "password_prompt_regex": "Password:",
  "ssh_key_prompt_regex": "The authenticity of host '.*' can't be established\\.",
  "ssh_key_answer": "yes",
  "force_tty": false,
  "debug_mode": false
}
