# Configuration directory (default: ~/.dish)
{% if dish_conf_dir is defined %}DISH_CONF_DIR={{ dish_conf_dir | quote }}{% endif %}

# Default connector (ssh, rsh, telnet, etc.)
{% if connector is defined %}CONNECTOR={{ connector | quote }}{% endif %}

# Default user (overrides local username)
{% if user is defined %}DISH_USER={{ user | quote }}{% endif %}

# Timeout per host (seconds)
{% if timeout_per_host is defined %}TIMEOUT_PER_HOST={{ timeout_per_host }}{% endif %}

# Total timeout for all hosts (seconds)
{% if total_timeout is defined %}TOTAL_TIMEOUT={{ total_timeout }}{% endif %}

# Hosts file (default: ~/.dish/hosts)
{% if hosts_file is defined %}HOSTS_FILE={{ hosts_file | quote }}{% endif %}

# Resting hosts file to exclude (default: ~/.dish/rests)
{% if resting_hosts_file is defined %}RESTING_HOSTS_FILE={{ resting_hosts_file | quote }}{% endif %}

# Password file (default: ~/.dish/pass)
{% if password_file is defined %}PASSWORD_FILE={{ password_file | quote }}{% endif %}

# Ignore password file permissions (default: false)
{% if ignore_pass_perms is defined %}IGNORE_PASS_PERMS={{ ignore_pass_perms | string | lower }}{% endif %}

# Fork mode: parallel background processing (default: false)
{% if fork_mode is defined %}FORK_MODE={{ fork_mode | string | lower }}{% endif %}

# Sequential processing delay (seconds)
{% if seq_delay is defined %}SEQ_DELAY={{ seq_delay }}{% endif %}

# Log command output to file (appends)
{% if log_file is defined %}LOG_FILE={{ log_file | quote }}{% endif %}

# Separate log per host (base name)
{% if host_log_base is defined %}HOST_LOG_BASE={{ host_log_base | quote }}{% endif %}

# Journal file for command history (default: ~/.dish/journal)
{% if journal is defined %}JOURNAL={{ journal | quote }}{% endif %}

# Command line options file (default: ~/.dish/options)
{% if options_file is defined %}OPTIONS_FILE={{ options_file | quote }}{% endif %}

# Prompt regex (for telnet/mysql/etc.)
{% if prompt_regex is defined %}PROMPT_REGEX={{ prompt_regex | quote }}{% endif %}

# Password prompt regex (case-insensitive)
{% if password_prompt_regex is defined %}PASSWORD_PROMPT_REGEX={{ password_prompt_regex | quote }}{% endif %}

# SSH host key prompt regex
{% if ssh_key_prompt_regex is defined %}SSH_KEY_PROMPT_REGEX={{ ssh_key_prompt_regex | quote }}{% endif %}

# SSH host key answer (e.g. 'yes' or 'no')
{% if ssh_key_answer is defined %}SSH_KEY_ANSWER={{ ssh_key_answer | quote }}{% endif %}

# Force pseudo-tty allocation
{% if force_tty is defined %}FORCE_TTY={{ force_tty | string | lower }}{% endif %}

# Debug mode (dry-run)
{% if debug_mode is defined %}DEBUG_MODE={{ debug_mode | string | lower }}{% endif %}
