# Linux command line options recommended by the Kernel Self Protection Project (KSPP)
# https://kernsec.org/wiki/index.php/Kernel_Self_Protection_Project/Recommended_Settings#kernel_command_line_options
#
# These parameters enhance kernel security by enabling features such as:
# - KasLR: Kernel Address Space Layout Randomization
# - PTI: Page Table Isolation (prevents Meltdown-style attacks)
# - slab_nomerge: Prevents merging of slab caches (reduces infoleaks)
# - page_poison: Overwrites freed pages with a poison pattern (detects use-after-free)
# - slub_debug: Enables debugging features for the SLUB allocator
# - nosmt: Disables simultaneous multithreading (prevents side-channel attacks like L1TF)

# Set the additional kernel command line parameters.
# The variable `grub_cmdline_linux_default_additions` contains the space-separated
# list of parameters to append to the existing GRUB_CMDLINE_LINUX_DEFAULT string.
# Default: 'kaslr pti=on slab_nomerge page_poison=1 slub_debug=FPZ nosmt'
GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT {{ grub_cmdline_linux_default_additions | default('kaslr pti=on slab_nomerge page_poison=1 slub_debug=FPZ nosmt') }}"

# Other interesting options are:
# - intel_iommu=on (sometimes intel_iommu=on,igfx_off) for enabling IOMMU

# When done editing the file, rebuild grub configuration with: update-grub
