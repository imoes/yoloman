{
  "config": [
    [
      "auto-shun",
      "off"
    ],
    [
      "basicauth",
      "none"
    ],
    [
      "default-gateway",
      "none"
    ],
    [
      "https",
      "off"
    ],
    [
      "max-upload",
      "10000000"
    ],
    [
      "skin",
      "blue-square"
    ],
    [
      "url",
      "https://fossil.example.com/"
    ]
  ],
  "enable_https": true,
  "ssl_cert_file": "/etc/ssl/certs/fossil.example.com.crt",
  "ssl_key_file": "/etc/ssl/private/fossil.example.com.key",
  "extra_repos": [
    {
      "path": "/srv/fossil/repos/proj1.fossil",
      "url": "https://fossil.example.com/proj1"
    },
    {
      "path": "/srv/fossil/repos/proj2.fossil",
      "url": "none"
    }
  ]
}
