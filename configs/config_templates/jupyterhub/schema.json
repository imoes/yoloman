{
  "auth": {
    "type": "object",
    "default": {
      "type": "native"
    },
    "description": "Authentication backend configuration",
    "items": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "default": "native",
          "description": "Authenticator type (native, ldap, github, oauth2, or fully-qualified class path)",
          "enum": [
            "native",
            "ldap",
            "github",
            "oauth2",
            "custom"
          ]
        },
        "admin_users": {
          "type": "list",
          "default": [],
          "description": "List of usernames with admin privileges"
        },
        "allowed_users": {
          "type": "list",
          "default": [],
          "description": "List of usernames allowed to log in"
        },
        "admin_groups": {
          "type": "list",
          "default": [],
          "description": "List of group names whose members get admin access"
        },
        "allowed_groups": {
          "type": "list",
          "default": [],
          "description": "List of group names whose members are allowed to log in"
        },
        "oauth_callback_url": {
          "type": "string",
          "default": "",
          "description": "OAuth callback URL (required for OAuth backends)"
        },
        "client_id": {
          "type": "string",
          "default": "",
          "description": "OAuth client ID"
        },
        "client_secret": {
          "type": "string",
          "default": "",
          "description": "OAuth client secret (ensure secure storage)",
          "secret": true
        }
      }
    }
  },
  "spawner": {
    "type": "object",
    "default": {
      "class": "dockerspawner.DockerSpawner",
      "image": "jupyter/base-notebook",
      "hub_ip_connect": "jupyterhub",
      "notebook_dir": "~/notebooks",
      "default_url": "/lab",
      "env_keep": [
        "PATH",
        "PYTHONPATH"
      ],
      "resources": {
        "cpu_limit": 1.0,
        "mem_limit": "1G",
        "cpu_guarantee": 0.1,
        "mem_guarantee": "250M"
      }
    },
    "description": "User server spawner configuration",
    "items": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "default": "dockerspawner.DockerSpawner",
          "description": "Spawner class (DockerSpawner, KubeSpawner, or custom)"
        },
        "image": {
          "type": "string",
          "default": "jupyter/base-notebook",
          "description": "Container image for user servers"
        },
        "hub_ip_connect": {
          "type": "string",
          "default": "jupyterhub",
          "description": "IP/hostname users\u2019 servers use to reach JupyterHub (e.g., container name or service IP)"
        },
        "volumes": {
          "type": "list",
          "default": [],
          "description": "Host paths to mount in user containers, format: 'host_path:container_path'",
          "items": {
            "type": "string",
            "description": "Volume mapping in format host:container"
          }
        },
        "notebook_dir": {
          "type": "string",
          "default": "~/notebooks",
          "description": "Default working directory inside user notebook servers"
        },
        "default_url": {
          "type": "string",
          "default": "/lab",
          "description": "Default URL path opened for new servers (e.g., /lab, /tree)"
        },
        "env_keep": {
          "type": "list",
          "default": [
            "PATH",
            "PYTHONPATH"
          ],
          "description": "Environment variables to preserve from parent process"
        },
        "env": {
          "type": "object",
          "default": {},
          "description": "Additional environment variables to inject into user servers"
        },
        "resources": {
          "type": "object",
          "default": {
            "cpu_limit": 1.0,
            "mem_limit": "1G",
            "cpu_guarantee": 0.1,
            "mem_guarantee": "250M"
          },
          "description": "CPU and memory limits/guarantees",
          "items": {
            "type": "object",
            "properties": {
              "cpu_limit": {
                "type": "number",
                "default": 1.0,
                "description": "Maximum CPU cores per user server"
              },
              "mem_limit": {
                "type": "string",
                "default": "1G",
                "description": "Maximum memory per user server (e.g., '1G', '512M')"
              },
              "cpu_guarantee": {
                "type": "number",
                "default": 0.1,
                "description": "CPU cores guaranteed per user server"
              },
              "mem_guarantee": {
                "type": "string",
                "default": "250M",
                "description": "Memory guaranteed per user server"
              }
            }
          }
        },
        "namespace": {
          "type": "string",
          "default": "jupyter",
          "description": "Kubernetes namespace to deploy user pods (KubeSpawner only)"
        },
        "node_selector": {
          "type": "object",
          "default": {},
          "description": "Kubernetes node selectors to constrain pod placement (KubeSpawner only)"
        }
      }
    }
  },
  "service": {
    "type": "object",
    "default": {
      "ip": "0.0.0.0",
      "port": 8000,
      "base_url": "/",
      "proxy_port": 8001,
      "cookie_secret_file": "/etc/jupyterhub/jupyterhub_cookie_secret",
      "db_url": "sqlite:///jupyterhub.sqlite",
      "log_level": "INFO",
      "tls": {
        "enabled": false,
        "self_signed": false,
        "certfile": "/etc/jupyterhub/ssl/jupyterhub.crt",
        "keyfile": "/etc/jupyterhub/ssl/jupyterhub.key"
      },
      "api_tokens": []
    },
    "description": "JupyterHub service and networking configuration",
    "items": {
      "type": "object",
      "properties": {
        "ip": {
          "type": "string",
          "default": "0.0.0.0",
          "description": "IP address to bind the JupyterHub proxy to"
        },
        "port": {
          "type": "number",
          "default": 8000,
          "description": "Port to expose the JupyterHub UI/API on"
        },
        "base_url": {
          "type": "string",
          "default": "/",
          "description": "Base URL path for the Hub (e.g., '/hub/')"
        },
        "proxy_port": {
          "type": "number",
          "default": 8001,
          "description": "Port for the internal proxy API (typically not user-facing)"
        },
        "cookie_secret_file": {
          "type": "string",
          "default": "/etc/jupyterhub/jupyterhub_cookie_secret",
          "description": "Path to the file containing the encrypted cookie secret"
        },
        "db_url": {
          "type": "string",
          "default": "sqlite:///jupyterhub.sqlite",
          "description": "Database connection URL (e.g., sqlite, PostgreSQL)"
        },
        "log_level": {
          "type": "string",
          "default": "INFO",
          "description": "Logging verbosity (DEBUG, INFO, WARN, ERROR)",
          "enum": [
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR"
          ]
        },
        "tls": {
          "type": "object",
          "default": {
            "enabled": false,
            "self_signed": false
          },
          "description": "TLS/SSL encryption settings",
          "items": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false,
                "description": "Enable HTTPS"
              },
              "self_signed": {
                "type": "boolean",
                "default": false,
                "description": "Use self-signed certificate (if no external cert)"
              },
              "certfile": {
                "type": "string",
                "default": "/etc/jupyterhub/ssl/jupyterhub.crt",
                "description": "Path to TLS certificate file"
              },
              "keyfile": {
                "type": "string",
                "default": "/etc/jupyterhub/ssl/jupyterhub.key",
                "description": "Path to TLS private key file"
              }
            }
          }
        },
        "api_tokens": {
          "type": "list",
          "default": [],
          "description": "List of API tokens for programmatic access (format: 'token:username')",
          "items": {
            "type": "string",
            "description": "Token and user, e.g., 'mysecrettoken:deploy-bot'",
            "secret": true
          }
        }
      }
    }
  },
  "limits": {
    "type": "object",
    "default": {
      "concurrent_spawn_limit": 10,
      "spawn_timeout": 600,
      "stop_timeout": 300
    },
    "description": "Server lifecycle and rate limiting",
    "items": {
      "type": "object",
      "properties": {
        "concurrent_spawn_limit": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of user servers being started simultaneously"
        },
        "spawn_timeout": {
          "type": "number",
          "default": 600,
          "description": "Seconds to wait for a user server to spawn before giving up"
        },
        "stop_timeout": {
          "type": "number",
          "default": 300,
          "description": "Seconds to wait for a server to stop before force-killing"
        }
      }
    }
  },
  "services": {
    "type": "list",
    "default": [],
    "description": "List of additional JupyterHub services",
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": "",
          "description": "Service name"
        },
        "host": {
          "type": "string",
          "default": "localhost",
          "description": "Service host (DNS or IP)"
        },
        "port": {
          "type": "number",
          "default": 8888,
          "description": "Service port"
        },
        "api_token": {
          "type": "string",
          "default": "",
          "description": "API token for the service to authenticate with JupyterHub",
          "secret": true
        },
        "admin": {
          "type": "boolean",
          "default": false,
          "description": "Whether the service has administrative privileges"
        },
        "oauth_no_confirm": {
          "type": "boolean",
          "default": true,
          "description": "Skip OAuth user confirmation (for trusted internal services)"
        },
        "oauth_scopes": {
          "type": "list",
          "default": [],
          "description": "OAuth scopes requested by the service",
          "items": {
            "type": "string",
            "description": "OAuth scope, e.g., 'read:users', 'admin:service'"
          }
        }
      }
    }
  },
  "cull": {
    "type": "object",
    "default": {
      "enabled": false,
      "timeout": 3600,
      "every": 600,
      "max_age": 0
    },
    "description": "Idle server culling configuration (requires jupyterhub-idle-culler)",
    "items": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic culling of idle servers"
        },
        "timeout": {
          "type": "number",
          "default": 3600,
          "description": "Seconds of inactivity before considering a server idle"
        },
        "every": {
          "type": "number",
          "default": 600,
          "description": "Seconds between culling checks"
        },
        "max_age": {
          "type": "number",
          "default": 0,
          "description": "Maximum server age in seconds (0 = no age limit)"
        }
      }
    }
  }
}
