{
  "bind_address": "0.0.0.0",
  "port": 21,
  "passive_ports": {
    "start": 40000,
    "end": 40099
  },
  "max_connections": 50,
  "syslog": true,
  "logfile": "/var/log/ftp-proxy/ftp-proxy.log",
  "control_timeout": 300,
  "transfer_timeout": 600,
  "chroot_anonymous": true,
  "chroot_local": true,
  "allowed_networks": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "denied_networks": [
    "172.16.0.0/12"
  ],
  "virtual_hosts": [
    {
      "name": "ftp.example.com",
      "target": "10.10.20.30:21"
    },
    {
      "name": "backup.example.org",
      "target": "192.168.5.100:21"
    }
  ],
  "ssl": {
    "enabled": true,
    "cert_path": "/etc/ftp-proxy/ssl.crt",
    "key_path": "/etc/ftp-proxy/ssl.key",
    "min_version": "TLSv1.2"
  },
  "ftps": {
    "enabled": false,
    "port": 990,
    "explicit": true
  },
  "ipv6": {
    "enabled": false
  }
}
