# Nutanix AHV Fence Agent configuration
# Generated by cluster fencing framework

# API endpoint for Nutanix AHV Prism Element/Element Cluster
api_url: {{ api_url }}

# Authentication credentials
username: {{ username }}
password: {{ password }}

# Optional: Domain for authentication (default: local)
domain: {{ domain | default('local') }}

# Optional: Use SSL/TLS verification (default: true)
verify_ssl: {{ verify_ssl | default(true) }}

# Optional: SSL certificate path for self-signed certs (leave empty to use system CA)
ssl_ca_cert: {{ ssl_ca_cert | default('') }}

# Optional: API version override (default: auto-detect)
api_version: {{ api_version | default('') }}

# Optional: Retry configuration for transient failures
retry_count: {{ retry_count | default(3) }}
retry_sleep: {{ retry_sleep | default(5) }}

# Optional: Action timeout per attempt (seconds)
timeout: {{ timeout | default(60) }}

# Optional: Operation mode: 'native' (default) or 'prism_central' for Prism Central managed clusters
mode: {{ mode | default('native') }}

# Optional: Cluster UUID — required only when connecting to Prism Central
# and fencing resources across multiple clusters
cluster_uuid: {{ cluster_uuid | default('') }}

# Optional: Port for AHV API (default: 9440 for HTTP, 9443 for HTTPS — auto-selected based on scheme)
# Only override if non-standard port is in use
port: {{ port | default(0) }}

# Optional: List of additional metadata tags to include in fencing operations
# These tags may be used for filtering or debugging
metadata_tags: {% for tag in metadata_tags %}
  - {{ tag }}{% endfor %}

# Optional: Log level — debug, info, warn, error
# Set to 'debug' for verbose output during troubleshooting
log_level: {{ log_level | default('info') }}
