# Nutanix AHV Fence Agent configuration
# Generated by cluster fencing framework.
# This template is self-documenting: every variable is sourced from the schema with a safe default.

# API endpoint for Nutanix AHV Prism Element/Prism Central.
# Full HTTPS URL of the API gateway (e.g., https://10.0.0.1).
# Required field; defaults to empty string if not provided.
api_url: {{ api_url | default('') }}

# Authentication credentials.
# Username with cluster admin or appropriate privilege to perform VM fencing
# (e.g., admin@local). Required field.
username: {{ username | default('') }}

# Password for the specified username.
# Stored in plaintext in config — secure via filesystem permissions.
# Required field.
password: {{ password | default('') }}

# Optional: Domain for authentication (e.g., 'local', 'ad.example.com').
# Typically 'local' for built-in users.
domain: {{ domain | default('local') }}

# Optional: Enable strict SSL certificate validation.
# Disable only in lab/test environments with self-signed certs.
verify_ssl: {{ verify_ssl | default(true) }}

# Optional: Path to custom CA certificate file for self-signed or internal PKI.
# Leave empty to use system trust store.
ssl_ca_cert: {{ ssl_ca_cert | default('') }}

# Optional: Explicit API version override (e.g., 'v2.0' or 'v3').
# If left blank, the agent auto-detects the version.
api_version: {{ api_version | default('') }}

# Optional: Retry configuration for transient failures.
# Number of retry attempts for failed API calls before marking the fence operation as failed.
retry_count: {{ retry_count | default(3) }}

# Optional: Seconds to wait between retry attempts.
# Minimum 1; higher values reduce load during transient outages.
retry_sleep: {{ retry_sleep | default(5) }}

# Optional: Maximum time (seconds) to wait for a single fencing action
# (e.g., VM power-off) to complete.
timeout: {{ timeout | default(60) }}

# Optional: Connection mode.
# 'native' for Prism Element, or 'prism_central' for centralized management across clusters.
mode: {{ mode | default('native') }}

# Optional: UUID of the target cluster when using Prism Central mode.
# Required for multi-cluster environments.
cluster_uuid: {{ cluster_uuid | default('') }}

# Optional: Custom port for Prism API.
# 0 means auto-select based on URL scheme (443 → 9443, 80 → 9440).
port: {{ port | default(0) }}

# Optional: List of additional metadata tags to include in fencing operations.
# These tags may be used for filtering or debugging.
metadata_tags: {% for tag in metadata_tags | default([]) %}
  - {{ tag }}{% endfor %}

# Optional: Log level — debug, info, warn, error.
# Set to 'debug' for verbose output during troubleshooting.
log_level: {{ log_level | default('info') }}