#!/bin/sh
# kFreeBSD do not accept scripts as interpreters, using #!/bin/sh and sourcing.
#
# Self-documenting Courier POP3 init script template.
# Variables are sourced from the Ansible role schema with explicit defaults.
if [ true != "$INIT_D_SCRIPT_SOURCED" ] ; then
    set "$0" "$@"; INIT_D_SCRIPT_SOURCED=true . /lib/init/init-d-script
fi
### BEGIN INIT INFO
# Provides: The name this init script provides (used by system services manager)
# Provides:          {{ init_info_provides | default('courier-pop') }}
# Required-Start: Dependencies that must start before this service
# Required-Start:    {{ init_info_required_start | default('courier-authdaemon $remote_fs $syslog') }}
# Required-Stop: Dependencies required to stop this service
# Required-Stop:     {{ init_info_required_stop | default('$remote_fs $syslog') }}
# Default-Start: Runlevels in which this service starts by default
# Default-Start:     {{ init_info_default_start | default('2 3 4 5') }}
# Default-Stop: Runlevels in which this service stops by default
# Default-Stop:      {{ init_info_default_stop | default('0 1 6') }}
# Short-Description: Short description of the service
# Short-Description: {{ init_info_short_description | default('Courier POP3 server') }}
### END INIT INFO

# Author: Ondřej Surý <ondrej@debian.org>

# DAEMON: Path to the POP3 daemon executable
DAEMON="{{ daemon_path | default('/usr/sbin/pop3d') }}"

# DESC: Human-readable description of the service
DESC="{{ desc | default('Courier POP3 server') }}"

# POP3D_START: Reads POP3DSTART from the main config file to determine if the daemon should start.
# Uses sed to parse the value from {{ pop3d_config_path | default('/etc/courier/pop3d') }}
DO_START=$(sed -ne "s/^POP3DSTART[[:space:]]*=[[:space:]]*[\\'\\\"]\?\\(\\w*\\)[\\'\\\"]\?/\\L\\1/p" {{ pop3d_config_path | default('/etc/courier/pop3d') }})

# PIDFILE: Reads PIDFILE from the main config file.
PIDFILE=$(sed -ne "s/^PIDFILE[[:space:]]*=[[:space:]]*[\\'\\\"]\?\([^[:space:]]*\)[\\'\\\"]\?/\\1/p" {{ pop3d_config_path | default('/etc/courier/pop3d') }})

# Source the Courier-specific init-d-script helper for standard service management functions.
. {{ init_d_script_courier_path | default('/usr/lib/courier/init-d-script-courier') }}