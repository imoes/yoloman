# This file configures MariaDB plugins for the GSSAPI (Kerberos) authentication server.
# It is loaded by the main MariaDB configuration (usually my.cnf or mariadb.conf.d/*).

[mariadb]
# The GSSAPI authentication plugin to load.
# Default: auth_gssapi.so
plugin-load-add={{ plugin_load_add | default('auth_gssapi.so') }}
