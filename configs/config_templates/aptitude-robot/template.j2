#!/bin/sh

# ============================================================================
# Package: aptitude-robot
# Description: Automated package cache and configuration file cleanup script.
#
# This script is intended to be sourced or executed in a managed environment
# to ensure that obsolete package configurations are purged and the package
# cache is cleaned up regularly.
#
# Environment Variables:
#   {{ max_random_delay_env_var | default('MAX_RANDOM_DELAY_SECONDS') | quote }}
#     (Default: '{{ max_random_delay_env_var | default('MAX_RANDOM_DELAY_SECONDS') }}')
#     Specifies the environment variable name used to pass the maximum random
#     delay (in seconds) to the random-delay script. If defined, the script
#     may delay execution by up to this amount to stagger cleanup jobs.
# ============================================================================

# Source environment variables from the specified config file if it exists.
# The config file is expected to be located at: /etc/default/{{ config_file | default('aptitude-robot') }}
# This allows administrators to set defaults or override behavior via environment variables.
CONFIG_FILE="/etc/default/{{ config_file | default('aptitude-robot') }}"
if [ -f "$CONFIG_FILE" ]; then
    . "$CONFIG_FILE"
fi

echo '----- 90-cleanup: package cache and config file cleanup'

# Purge all packages that have been removed. In a managed environment we do
# not want to carry around obsolete config files.
# The tilde-c syntax (~c) matches packages that have been configured but
# their packages have since been removed.
aptitude -y -q purge '~c'

# Clean the local repository of retrieved package files.
# This frees up disk space by removing .deb files that are no longer needed
# after installation.
apt-get clean

# Update the available package list from repositories.
# This ensures that dpkg knows about the current state of available packages.
dpkg --clear-avail
