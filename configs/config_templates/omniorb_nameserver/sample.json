{
  "log_file": "/var/log/omniORB/nameserver.log",
  "log_max_size": 10485760,
  "log_max_backup_index": 5,
  "name_service_port": 2809,
  "stdout": false,
  "debug_level": 0,
  "ior_file": "/var/lib/omniORB/naming.ior",
  "ior_files": [
    {
      "description": "public interface",
      "path": "/var/lib/omniORB/public.ior"
    }
  ],
  "max_connections": 500,
  "persistent_state": true,
  "persistent_state_file": "/var/lib/omniORB/naming.state",
  "shutdown_delay": 5,
  "use_ssl": false,
  "ssl_cert_file": "/etc/omniORB4/certs/nameserver.crt",
  "ssl_key_file": "/etc/omniORB4/certs/nameserver.key",
  "host": "0.0.0.0",
  "ipv6": false
}
