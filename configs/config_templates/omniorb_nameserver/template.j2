# omniORB4 Naming Service configuration file
#
# This template configures the omniORB naming service (omniorb-nameserver).
# It is self-documenting: every directive is preceded by its schema description.
# Variables use the exact field names from the schema with safe defaults.

# Absolute path to the main log file for the naming service.
# Default: /var/log/omniORB/nameserver.log
logFile = {{ log_file | default('/var/log/omniORB/nameserver.log') }};

# Maximum size (in bytes) of the log file before rotation (0 = no limit).
# Default: 10485760
logMaxSize = {{ log_max_size | default(10485760) }};

# Maximum number of rotated log files to keep (before oldest is deleted).
# Default: 5
logMaxBackupIndex = {{ log_max_backup_index | default(5) }};

# TCP port on which the Naming Service listens. Standard CORBA port 2809 is recommended.
# Default: 2809
NameServicePort = {{ name_service_port | default(2809) }};

# Absolute path to the default IOR (Inter-ORB Reference) file used by clients to locate the Naming Service.
# Default: /var/lib/omniORB/naming.ior
iorFile = {{ ior_file | default('/var/lib/omniORB/naming.ior') }};