# omniORB4 Naming Service configuration file
# Generated by configuration management; do not edit manually
# This file configures the omniORB naming service (omniorb-nameserver)
# Log file location
logFile = {{ log_file }};

# Maximum number of log rotations before deletion
logMaxSize = {{ log_max_size }};
logMaxBackupIndex = {{ log_max_backup_index }};

# TCP port for the Naming Service (default 2809)
NameServicePort = {{ name_service_port }};

# Enable logging to stdout? (true/false)
stdout = {{ stdout | lower }};

# Enable debug logging? (true/false)
debugLevel = {{ debug_level }};

# Initial IOR file path (for bootstrap clients)
iorFile = {{ ior_file }};

# List of additional IOR files for multi-homed or HA deployments
{% for ior_file_entry in ior_files %}
# IOR file for {{ ior_file_entry.description }}: {{ ior_file_entry.path }}
iorFile = {{ ior_file_entry.path }};
{% endfor %}

# Maximum number of connections allowed (0 = unlimited)
maxConnections = {{ max_connections }};

# Enable persistent state (store naming context in file)
persistentState = {{ persistent_state }};

# Path for persistent state file (only if persistentState = 1)
{% if persistent_state %}
persistentStateFile = {{ persistent_state_file }};
{% endif %}

# Time to wait (seconds) before shutting down after receiving SIGTERM
shutdownDelay = {{ shutdown_delay }};

# Enable SSL/TLS support for Naming Service? (true/false)
useSSL = {{ use_ssl | lower }};

# SSL certificate and key file paths (only if useSSL = 1)
{% if use_ssl %}
SSLCertFile = {{ ssl_cert_file }};
SSLKeyFile = {{ ssl_key_file }};
{% endif %}

# Default host to bind to (0.0.0.0 = all interfaces)
host = {{ host }};

# Enable IPv6 support? (true/false)
IPv6 = {{ ipv6 | lower }};
