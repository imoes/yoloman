# /etc/remote-logon-config-agent.conf
# Configuration file for remote-logon-config-agent
# Retrieved from Arctica Greeter documentation

# SERVER_ROOT: The root URL of the remote logon broker server, typically ending with the UCCS inifile endpoint path.
SERVER_ROOT={{ server_root | default('http://localhost:8080/uccs/inifile/') }}

# USERID: The username used to retrieve session information from the broker server.
USERID={{ userid | default('user') }}