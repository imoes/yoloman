{
  "registry_mirrors": [],
  "insecure_registries": [
    "myregistry.local:5000"
  ],
  "default_runtime": "runc",
  "runtimes": [
    {
      "name": "nvidia",
      "path": "/usr/bin/nvidia-container-runtime",
      "runtimeArgs": [
        "--runtime-flag",
        "flag1=value1"
      ]
    }
  ],
  "storage_driver": "overlay2",
  "storage_opts": [],
  "live_restore": true,
  "userland_proxy": true,
  "ipv6": true,
  "fixed_cidr_v6": "fd00::/80",
  "dns": [
    "8.8.8.8",
    "1.1.1.1"
  ],
  "dns_search": [
    "internal.example.com"
  ],
  "labels": [
    "node.role=worker",
    "region=us-west"
  ],
  "log_driver": "json-file",
  "log_opts": [
    "max-size=50m",
    "max-file=5"
  ],
  "max_concurrent_downloads": 5,
  "max_concurrent_uploads": 10,
  "default_ulimits": [
    {
      "Name": "nofile",
      "Hard": 262144,
      "Soft": 262144
    },
    {
      "Name": "nproc",
      "Hard": 65536,
      "Soft": 65536
    }
  ],
  "features": {
    "containerd-snapshotter": true
  },
  "max_concurrent_updates": 3,
  "max_containers": 100,
  "debug": false,
  "data_root": "/var/lib/docker",
  "exec_root": "/run/docker",
  "pidfile": "/run/docker.pid",
  "containerd": "/run/containerd/containerd.sock",
  "bip": "172.20.0.1/16",
  "fixed_cidr": "172.20.0.0/24",
  "mtu": 1450,
  "default_gateway": "172.20.0.1",
  "default_gateway_v6": "fd00::1",
  "bridge": "docker0"
}
