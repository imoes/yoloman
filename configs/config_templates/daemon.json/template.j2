{# Docker daemon configuration #}
{
{# Registry mirrors for image pulls #}
  "registry-mirrors": {{ registry_mirrors | tojson }},
{# Insecure registries (HTTP or HTTPS with invalid certs) #}
  "insecure-registries": {{ insecure_registries | tojson }},
{# Default runtime to use when none specified #}
  "default-runtime": "{{ default_runtime }}",
{# List of additional runtimes with custom configurations #}
  "runtimes": {{ runtimes | tojson }},
{# Storage driver to use (e.g., overlay2, zfs, btrfs) #}
  "storage-driver": "{{ storage_driver }}",
{# Storage options passed to the storage driver #}
  "storage-opts": {{ storage_opts | tojson }},
{# Enable live restore of containers on daemon stop/restart #}
  "live-restore": {{ live_restore | lower }},
{# Enable userland proxy for port mapping #}
  "userland-proxy": {{ userland_proxy | lower }},
{# Enable IPv6 networking #}
  "ipv6": {{ ipv6 | lower }},
{# Fixed CIDR for IPv6 addresses (used when ipv6 is true) #}
  "fixed-cidr-v6": "{{ fixed_cidr_v6 }}",
{# DNS servers for containers #}
  "dns": {{ dns | tojson }},
{# DNS search domains for containers #}
  "dns-search": {{ dns_search | tojson }},
{# List of labels describing node characteristics #}
  "labels": {{ labels | tojson }},
{# Log driver and options for containers #}
  "log-driver": "{{ log_driver }}",
  "log-opts": {{ log_opts | tojson }},
{# Max number of containers logs to retain #}
  "max-concurrent-downloads": {{ max_concurrent_downloads }},
{# Max concurrent uploads #}
  "max-concurrent-uploads": {{ max_concurrent_uploads }},
{# Default max size of container logs before rotation (bytes) #}
  "default-ulimits": {{ default_ulimits | tojson }},
{# Enable containerd snapshotter (required for certain image formats like OCIv2) #}
  "features": {{ features | tojson }},
{# Max number of containers running simultaneously (0 = unlimited) #}
  "max-concurrent-updates": {{ max_concurrent_updates }},
{# Maximum number of running containers (0 = unlimited) #}
  "max-containers": {{ max_containers }},
{# Enable debug logging #}
  "debug": {{ debug | lower }},
{# Data root directory for Docker state (images, volumes, etc.) #}
  "data-root": "{{ data_root }}",
{# Exec root directory for exec-specific data #}
  "exec-root": "{{ exec_root }}",
{# PID file location #}
  "pidfile": "{{ pidfile }}",
{# Enable containerd integration (true by default in modern Docker) #}
  "containerd": "{{ containerd }}",
{# Bridge network settings (when not using CNI) #}
  "bip": "{{ bip }}",
  "fixed-cidr": "{{ fixed_cidr }}",
  "mtu": {{ mtu }},
  "default-gateway": "{{ default_gateway }}",
  "default-gateway-v6": "{{ default_gateway_v6 }}",
{# Enable CNI networking (true by default in modern Docker) #}
  "bridge": "{{ bridge }}"
}
