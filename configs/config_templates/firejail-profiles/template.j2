{# ============================================================================= #}
{# Firejail Profile Configuration Template                                        #}
{# This template generates a Firejail sandbox profile for a specific application. #}
{# It enforces strict security policies while allowing necessary file access.     #}
{# ============================================================================= #}

{# Header Section #}
{# Define the profile title using the package name. Falls back to a generic comment if package_name is missing or empty. #}
{% if package_name is defined and package_name is not none and (package_name is number or package_name is boolean or package_name | length > 0) %}
{% if package_name is defined and package_name is not none and (package_name is number or package_name is boolean or package_name | length > 0) %}Firejail profile for {{ package_name }}{% else %}# Firejail profile for 0ad{% endif %}
{% else %}
# Firejail profile for 0ad
{% endif %}

{# Description #}
{# Human-readable description of the application being sandboxed. #}
# Description: {{ description | default('Real-time strategy game of ancient warfare') }}

# This file is overwritten after every install/update
# Persistent local customizations
{# Include user-defined local customizations if the package name is known to allow a specific .local file. #}
{# If package_name is missing, this path will be invalid or generic; the schema implies it's tied to the package. #}
include {{ package_name | default('unknown_package') }}.local

# Persistent global definitions
include globals.local

{# Cache Directory #}
{# Allow read/write access to the application's cache directory within the user's home. #}
# Prevents firejail from blacklisting the cache directory, ensuring the app can store temp files.
noblacklist ${HOME}/.cache/{{ package_name | default('unknown_package') }}

{# Configuration Directory #}
{# Allow read/write access to the application's configuration directory. #}
noblacklist ${HOME}/.config/{{ package_name | default('unknown_package') }}

{# Data Directory #}
{# Allow read/write access to the application's local data directory. #}
noblacklist ${HOME}/.local/share/{{ package_name | default('unknown_package') }}

{# Interpreter Access #}
{# Allow the use of GJS (GNOME JavaScript) runtime, which is otherwise blocked by disable-interpreters.inc. #}
# This is often required for Gnome-shell extensions or specific GNOME-based apps.
# Allow gjs (blacklisted by disable-interpreters.inc)
include allow-gjs.inc

{# System Executables #}
{# Blacklist /usr/libexec to prevent the sandbox from accessing potentially privileged system helpers. #}
blacklist /usr/libexec

{# Security Baseline Includes #}
{# Include standard security restriction modules. These provide a hardened default configuration. #}

{# Disable common utilities that are rarely needed in a sandboxed context. #}
include disable-common.inc

{# Disable development tools (compilers, debuggers, etc.). #}
include disable-devel.inc

{# Disable execution of arbitrary binaries outside the whitelist. #}
include disable-exec.inc

{# Disable interpreters (bash, python, etc.) to prevent code injection. #}
include disable-interpreters.inc

{# Disable non-essential programs. #}
include disable-programs.inc

{# Disable XDG desktop integration features. #}
include disable-xdg.inc

{# Directory Setup #}
{# Create the necessary directories inside the private home if they don't exist, then whitelist them. #}

{# Create Cache Dir #}
mkdir ${HOME}/.cache/{{ package_name | default('unknown_package') }}

{# Create Config Dir #}
mkdir ${HOME}/.config/{{ package_name | default('unknown_package') }}

{# Create Local Share Dir #}
mkdir ${HOME}/.local/share/{{ package_name | default('unknown_package') }}

{# Whitelist Cache Dir #}
whitelist ${HOME}/.cache/{{ package_name | default('unknown_package') }}

{# Whitelist Config Dir #}
whitelist ${HOME}.config/{{ package_name | default('unknown_package') }}

{# Whitelist Local Share Dir #}
whitelist ${HOME}/.local/share/{{ package_name | default('unknown_package') }}

{# Application Data #}
{# Allow read access to the application's data in /usr/share and standard games directory. #}
whitelist ${HOME}/.cache/{{ package_name | default('unknown_package') }}
whitelist ${HOME}/.config/{{ package_name | default('unknown_package') }}
whitelist ${HOME}/.local/share/{{ package_name | default('unknown_package') }}

{# Specific package data #}
whitelist /usr/share/{{ package_name | default('unknown_package') }}

{# General games directory #}
whitelist /usr/share/games

{# Common Whitespace #}
{# Include standard whitelisting rules for common system resources. #}
include whitelist-common.inc
include whitelist-usr-share-common.inc
include whitelist-var-common.inc

{# Caps and Network #}
{# Drop all Linux capabilities to minimize kernel privileges. #}
caps.drop all

{# Enable network filtering (iptables/nftables rules generated by Firejail). #}
netfilter

{# Disable DVD access. #}
nodvd

{# Remove group memberships to limit access to group-restricted resources. #}
nogroups

{# Disable keyboard and mouse input capture (useful for remote sessions). #}
noinput

{# Prevent gaining new privileges via setuid/setgid. #}
nonewprivs

{# Prevent the process from becoming root. #}
noroot

{# Disable TV output. #}
notv

{# Disable YubiKey/U2F support. #}
nou2f

{# Disable video capture devices. #}
novideo

{# Allow only Unix, IPv4, and IPv6 protocols. #}
protocol unix,inet,inet6

{# Enable Seccomp-BPF for syscall filtering. #}
seccomp

{# Block secondary seccomp filters (keep it simple/safe). #}
seccomp.block-secondary

{# Enable tracing logs for debugging sandbox issues. #}
tracelog

{# Mount Namespace #}
{# Disable mount namespace changes to prevent hiding/remounting filesystem parts. #}
disable-mnt

{# Private Binary Execution #}
{# Isolate the binary search path to only allow specific binaries: the main app, pyrogenesis, and utils. #}
private-bin {{ package_name | default('0ad') }},pyrogenesis,sh,which

{# Private Cache #}
{# Use a private cache directory for the sandbox. #}
private-cache

{# Private Device Nodes #}
{# Mount a private /dev namespace to restrict hardware access. #}
private-dev

{# Private Temporary Directory #}
{# Mount a private /tmp namespace to prevent leaking temp files between sessions. #}
private-tmp

{# DBUS Restrictions #}
{# Disable access to user and system DBUS sessions to prevent inter-process communication leaks. #}
dbus-user none
dbus-system none

{# Namespace Restrictions #}
{# Restrict the creation of new namespaces (PID, IPC, etc.) inside the sandbox. #}
restrict-namespaces
