# ============================================================================
# Apache Directory Server (ApacheDS) JVM and Service Configuration
# ============================================================================
#
# This file configures the core JVM options and service-level parameters
# for Apache Directory Server. It is NOT the LDAP schema/partition
# configuration (which lives in LDIF files under the instance directory).
#
# Each directive below is mapped to an Ansible variable. If a variable
# is not defined in the playbook/role, the schema default is used
# (see `| default(...)` filters).
#
# ============================================================================

# --------------------------------------------------------------------------
# JVM Heap Sizing
# --------------------------------------------------------------------------
# Initial heap size (in MB) for the Apache Directory Server JVM.
# Increase for larger directories (>100k entries).
-Xms{{ jvm_heap_min_mb | default(256) }}M

# Maximum heap size (in MB) for the JVM.
# Must be ≥ initial heap; set based on available system RAM and directory size.
-Xmx{{ jvm_heap_max_mb | default(1024) }}M

# --------------------------------------------------------------------------
# Garbage Collection Tuning
# --------------------------------------------------------------------------
# Use G1GC garbage collector for better latency with larger heaps.
-XX:+UseG1GC

# --------------------------------------------------------------------------
# Garbage Collection Logging
# --------------------------------------------------------------------------
# Enable detailed garbage collection logging for performance analysis
# and troubleshooting. Disabled by default.
{% if enable_gc_logging | default(False) %}
# GC log file path (only used if GC logging is enabled).
-Xloggc:{{ gc_log_path | default('/var/log/apacheds/gc.log') }}
-XX:+PrintGCDetails
-XX:+PrintGCDateStamps
# Log rotation: keep 5 files, 10MB each.
-XX:+UseGCLogFileRotation
-XX:NumberOfGCLogFiles=5
-XX:GCLogFileSize=10M
{% endif %}

# --------------------------------------------------------------------------
# Directory Server Working Directory
# --------------------------------------------------------------------------
# Root directory containing one or more Apache Directory Server instances.
-Dapacheds.dir={{ instance_dir | default('/var/lib/apacheds') }}

# --------------------------------------------------------------------------
# Service Instance Name
# --------------------------------------------------------------------------
# Name of the instance directory under `instance_dir` (e.g.,
# /var/lib/apacheds/instances/default). Must match the physical folder name.
-Dinstance.uid={{ instance_uid | default('default') }}

# --------------------------------------------------------------------------
# Logging Verbosity
# --------------------------------------------------------------------------
# Logging verbosity level: OFF, ERROR, WARN, INFO, DEBUG, or TRACE.
# Use DEBUG only for diagnostics due to performance impact.
-Dlog.level={{ log_level | default('INFO') }}

# --------------------------------------------------------------------------
# LDAP Service Binding (Unencrypted)
# --------------------------------------------------------------------------
# TCP port on which the unencrypted LDAP service listens.
# Standard port is 389, but 10389 is the default for apacheds.
-Dldap.port={{ ldap_port | default(10389) }}

# IP address (or hostname) to bind the LDAP service to.
# Use '127.0.0.1' for local-only access, or a specific interface IP for production.
-Dldap.internet.address={{ ldap_bind_address | default('0.0.0.0') }}

# --------------------------------------------------------------------------
# LDAPS Service Binding (Encrypted)
# --------------------------------------------------------------------------
# LDAPS (LDAP over SSL/TLS) — disable if not needed.
# Requires keystore configuration in the instance's config.
{% if enable_ldaps | default(False) %}
# TCP port for LDAPS (used only if LDAPS is enabled).
-Dldaps.port={{ ldaps_port | default(10636) }}

# IP address for LDAPS binding (used only if LDAPS is enabled).
-Dldaps.internet.address={{ ldaps_bind_address | default('0.0.0.0') }}
{% endif %}

# --------------------------------------------------------------------------
# JNDI Provider URL
# --------------------------------------------------------------------------
# JNDI provider URL for embedded LDAP (used by some tools).
# Dynamically reflects the configured LDAP bind address and port.
-Djava.naming.provider.url=ldap://{{ ldap_bind_address | default('0.0.0.0') }}:{{ ldap_port | default(10389) }}

# --------------------------------------------------------------------------
# RMI Management Port (JMX)
# --------------------------------------------------------------------------
# RMI port for JMX monitoring (used only if RMI is enabled).
# Not recommended in production due to security risks.
{% if enable_rmi | default(False) %}
-Drmi.port={{ rmi_port | default(16891) }}
{% endif %}

# --------------------------------------------------------------------------
# Debug Flags
# --------------------------------------------------------------------------
# Enable low-level JVM and Kerberos debug flags (useful for troubleshooting
# authentication issues). Disabled by default.
{% if enable_debug | default(False) %}
-Dcom.sun.management.debug=true
-Dsun.security.krb5.debug=true
{% endif %}

# --------------------------------------------------------------------------
# Additional JVM System Properties
# --------------------------------------------------------------------------
# Additional JVM system properties in `key=value` format
# (e.g., for custom environment overrides).
# Provided as a list of mappings: [{'key': '...', 'value': '...'}]
{% for prop in extra_system_properties | default([]) %}
-D{{ prop.key }}={{ prop.value }}
{% endfor %}

# --------------------------------------------------------------------------
# Thread Stack Size
# --------------------------------------------------------------------------
# Thread stack size in KB. Increase only if encountering stack overflow errors.
-Xss{{ thread_stack_size_kb | default(256) }}k

# --------------------------------------------------------------------------
# Biased Locking
# --------------------------------------------------------------------------
# Disable biased locking in the JVM. Useful for high-contention
# multi-threaded workloads (rarely needed).
{% if disable_biased_locking | default(False) %}
-XX:-UseBiasedLocking
{% endif %}

# --------------------------------------------------------------------------
# Classpath
# --------------------------------------------------------------------------
# JVM classpath. Usually should not be changed unless custom libraries are added.
-cp {{ classpath | default('/usr/share/apacheds/lib/*') }}

# --------------------------------------------------------------------------
# Main Class
# --------------------------------------------------------------------------
# Main class to launch the Apache Directory Server.
org.apache.directory.server.App