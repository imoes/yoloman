{
  "jvm_heap_min_mb": 512,
  "jvm_heap_max_mb": 2048,
  "enable_gc_logging": true,
  "gc_log_path": "/var/log/apacheds/gc.log",
  "instance_dir": "/var/lib/apacheds",
  "instance_uid": "default",
  "log_level": "INFO",
  "ldap_port": 389,
  "ldap_bind_address": "0.0.0.0",
  "enable_ldaps": true,
  "ldaps_port": 636,
  "ldaps_bind_address": "0.0.0.0",
  "enable_rmi": false,
  "rmi_port": 16891,
  "enable_debug": false,
  "extra_system_properties": [
    {
      "key": "apacheds.instance.workDir",
      "value": "/var/lib/apacheds/instances/default/work"
    },
    {
      "key": "apacheds.instance.logDir",
      "value": "/var/log/apacheds/default"
    }
  ],
  "thread_stack_size_kb": 256,
  "disable_biased_locking": false,
  "classpath": "/usr/share/apacheds/lib/*"
}
