#!/bin/sh
# dhcp-probe init script (sysvinit style).
# This script is auto-generated by Ansible. Do not edit manually.
# It manages the dhcp-probe daemon, which surveys DHCP/BootP servers on LAN interfaces.
# Configuration is read from {{ ETC | default('/etc') }}/{{ NAME | default('dhcp-probe') }}/*.

### BEGIN INIT INFO
# Provides:		dhcp-probe
# Required-Start:    $local_fs $remote_fs $syslog $network
# Required-Stop:     $local_fs $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: dhcp-probe daemon to survey DHCP/BootP server on LAN
# Description: Enable or disable dhcp-probe service
### END INIT INFO

set -e

# Standard path for system binaries
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# DAEMON: Full path to the dhcp_probe executable.
# See schema field: DAEMON
DAEMON={{ DAEMON | default('/usr/sbin/dhcp_probe') }}

# Extract the base name of the daemon for labeling purposes
LABEL=${DAEMON##*/}

# NAME: Service name used for PID file directory and init script naming.
# See schema field: NAME
NAME={{ NAME | default('dhcp-probe') }}

# PID file name base
PIDFILE=dhcp_probe.pid

# BASE_RUNNING: Base directory for runtime files.
BASE_RUNNING=/var/run

# BASEPIDDIR: Directory where PID files for each interface are stored.
# See schema field: BASEPIDDIR
BASEPIDDIR={{ BASEPIDDIR | default('/var/run/dhcp-probe') }}

# Full path to the initial PID file (before interface-specific suffix is added)
INITPIDFILE=$BASEPIDDIR/$PIDFILE

# DESC: Human-readable description used in log messages.
DESC="$NAME daemon"

# ETC: Base configuration directory; config files are read from $ETC/$NAME/*.
# See schema field: ETC
ETC={{ ETC | default('/etc') }}

# LOGDIR: Log file path (currently unused in the script logic but defined for completeness).
LOGDIR=/var/log/$NAME.log

# DODTIME: Time in seconds to wait between SIGTERM and SIGKILL in force_stop.
# See schema field: DODTIME
DODTIME={{ DODTIME | default(2) }}

# Check if the daemon executable exists and is executable
test -x $DAEMON || exit 0

# Load LSB init functions if available
if [ -r /lib/lsb/init-functions ]; then
	. /lib/lsb/init-functions
fi

# sourceable: Checks if a file is readable and not a temporary file (e.g. Vim swap).
sourceable() {
	[ -r $1 ] || return 1
  # Ignore temporary files created by VIM
	case $1 in
		*\~)
			return 1
			;;
		*)
			return 0
			;;
	esac
}

# running: Checks if the dhcp_probe process is running for a specific interface.
# $1: Interface name
running() {
  INTERFACE=$1
  # Construct the specific PID file for this interface
  PIDFILE=$INITPIDFILE.$INTERFACE

  # Wait for the PID file to appear (up to 10 seconds)
  _max_repeat=10
  _repeat=1
  while [ ! -r $PIDFILE ] && [ $_repeat -le $_max_repeat ]; do
	printf "Waiting for pid file round: $_repeat\n" >&2
	sleep 1
	_repeat=$(($_repeat + 1))
  done
  printf "Waited ${_repeat}s to find a $INTERFACE pid file\n" >&2

  # Read the PID from the file if it appeared in time
  if [ $_repeat -le $_max_repeat ]; then
    read pid < $PIDFILE || return 1
  else
    return 1
  fi

  # Verify the PID is actually running and matches dhcp_probe
  for i in `pidof dhcp_probe`; do
    if [ "$i" = "$pid" ]; then
      return 0
    fi
  done
  return 1
}

# start_daemon: Starts the daemon on all configured interfaces.
start_daemon() {
	# Ensure the PID directory exists
	[ -d $BASEPIDDIR ] || mkdir -p $BASEPIDDIR || {
		printf "Failed to create missing pid file directory $BASEPIDDIR!\n"
		return 1
	}

	sts=0

	# Iterate over configuration files in the config directory
	for config_file in $ETC/$NAME/*; do
		# Skip unreadable or temp files
		sourceable $config_file || continue
		. $config_file

		# Expect 'INTERFACE' to be defined in the sourced config file
		PIDFILE=$INITPIDFILE.$INTERFACE

		# Build daemon options
		DAEMON_OPTS="-T -p $PIDFILE $INTERFACE"

		printf "Starting $DESC on interface $INTERFACE: "

		# Wait for the interface to have an IP address (up to 10 seconds)
		max_repeat=10
		repeat=1
		while sleep 1; do
			printf "\nstart_daemon - Waiting for an ip on iface $INTERFACE, round: $repeat" >&2
			if ip address show dev "$INTERFACE" | grep -w 'inet' || [ $repeat -gt 10 ]; then
				break
			fi
			repeat=$(( repeat + 1 ))
		done
		printf "\nwaited ${repeat}s to get an ip on $INTERFACE" >&2

		# Start the daemon
		start-stop-daemon --start --quiet --pidfile $PIDFILE \
			--exec $DAEMON -- $DAEMON_OPTS

		# Verify it started successfully
		if running $INTERFACE; then
			printf "Done.\n"
		else
			printf "Failed!\n"
			sts=1
		fi
	done
	return $sts
}

# stop_daemon: Gracefully stops the daemon on all configured interfaces.
stop_daemon() {
	for config_file in $ETC/$NAME/*; do
		sourceable $config_file || continue
		. $config_file

		PIDFILE=$INITPIDFILE.$INTERFACE

		if [ -r $PIDFILE ]; then
			printf "Stopping $DESC on interface $INTERFACE: "
			start-stop-daemon --stop --quiet --pidfile $PIDFILE
			printf "$NAME.\n"
			rm -f $PIDFILE
		else
			# If PID file is missing, try force stop
			force_stop
		fi
	done
}

# force_stop: Forcefully kills the process if graceful stop fails or PID is missing.
force_stop() {
	for config_file in $ETC/$NAME/*; do
		sourceable $config_file || continue
		. $config_file

		PIDFILE=$INITPIDFILE.$INTERFACE

		if [ -r "$PIDFILE" ]; then
			if running $INTERFACE; then
				# Send SIGTERM
				start-stop-daemon -K 15 --quiet --pidfile $PIDFILE \
					--exec $DAEMON -- $DAEMON_OPTS

				# Wait DODTIME seconds to allow graceful shutdown
				[ -z "$DODTIME" ] || sleep "$DODTIME"

				# Check if it's still running
				if running $INTERFACE; then
					# Send SIGKILL
					start-stop-daemon -K 9 --quiet --pidfile $PIDFILE \
						--exec $DAEMON -- $DAEMON_OPTS

					# Wait again
					[ -z "$DODTIME" ] || sleep "$DODTIME"

					# Final check
					if running $INTERFACE; then
						printf "Cannot kill $LABEL (pid=$pid)!\n"
						exit 1
					fi
				fi
			fi
		else
			# Fallback: kill all processes named like the daemon
			killall `basename $DAEMON`
		fi

		rm -f $PIDFILE
	done
}

# Main control case statement
case $1 in
	start)
		start_daemon
		;;

	stop)
		stop_daemon
		;;

	force-stop)
		# Handle force-stop action
		for config_file in $ETC/$NAME/*; do
			sourceable $config_file || continue
			. $config_file
			PIDFILE=$INITPIDFILE.$INTERFACE
			printf "Forcefully stopping $DESC: "
			force_stop
			if ! running $INTERFACE; then
				printf "$NAME on interface $INTERFACE.\n"
			else
				printf "Error !\n"
			fi
		done
		;;

	force-reload)	# Reload operation is not supported by this daemon
		printf "Reload operation is not supported -- use restart.\n"
		exit 1
		;;

	restart)
		printf "Restarting $DESC: "
		stop_daemon
		[ -z "$DODTIME" ] || sleep $DODTIME
		start_daemon
		printf "$NAME."
		;;

	status)
		for config_file in $ETC/$NAME/*; do
			sourceable $config_file || continue
			. $config_file
			PIDFILE=$INITPIDFILE.$INTERFACE
			printf "$LABEL is "
			if running $INTERFACE;  then
				printf "running on interface $INTERFACE.\n"
			else
				printf "not running.\n"
				exit 1
			fi
		done
		;;

	*)
		N=/etc/init.d/$NAME
		printf "Usage: $N {start|stop|restart|status|force-stop}\n" >&2
		exit 1
		;;
esac

exit 0