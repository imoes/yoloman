# =============================================================================
# Globus Scheduler Event Generator Configuration
# =============================================================================
# This file configures the Globus Scheduler Event Generator (SEG) runtime
# directories and behavior. It is auto-generated by Ansible. Do not edit manually.

# Base directory for variable state data (e.g., run, log, lib).
# Default: ${localstatedir} (typically /var on most Linux distributions).
GLOBUS_SEG_PIDFMT="{{ localstatedir | default('${localstatedir}') }}/run/globus-scheduler-event-generator-%s.pid"

# Base directory for log and library variable state data.
# Default: ${localstatedir} (typically /var on most Linux distributions).
GLOBUS_SEG_LOGFMT="{{ localstatedir | default('${localstatedir}') }}/lib/globus/globus-seg-%s"

# Base directory for configuration files.
# Default: ${sysconfdir} (typically /etc on most Linux distributions).
GLOBUS_SEG_LRM_DIR="{{ sysconfdir | default('${sysconfdir}') }}/globus/scheduler-event-generator"

# Nice level for the SEG process.
# Value: Integer representing the process priority (-20 to 19).
# Default: 0 (normal priority).
# Note: This line is commented out in the default template. To enable,
# uncomment the line below and set the desired integer value.
# GLOBUS_SEG_NICE_LEVEL=0
