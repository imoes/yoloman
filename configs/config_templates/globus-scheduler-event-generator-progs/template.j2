# Globus Scheduler Event Generator (SEG) configuration template
# Generated by Ansible Jinja2 - DO NOT EDIT MANUALLY

# Base directory for variable state data (e.g., run, log, lib)
# Controls where runtime files like PID files and logs are stored.
# Default: /var
{% set localstatedir = localstatedir | default('/var') %}

# Base directory for configuration files
# Controls the root path for configuration data.
# Default: /etc
{% set sysconfdir = sysconfdir | default('/etc') %}

# GLOBUS_SEG_PIDFMT:
# Path pattern for PID (Process ID) files.
# The %s placeholder is replaced by the SEG instance identifier at runtime.
# These files track running daemon processes and are stored under the run directory.
GLOBUS_SEG_PIDFMT="{{ localstatedir }}/run/globus-scheduler-event-generator-%s.pid"

# GLOBUS_SEG_LOGFMT:
# Path pattern for log files.
# The %s placeholder is replaced by the SEG instance identifier at runtime.
# Logs are stored under the lib directory within the state directory.
GLOBUS_SEG_LOGFMT="{{ localstatedir }}/lib/globus/globus-seg-%s"

# GLOBUS_SEG_LRM_DIR:
# Directory containing the Local Resource Manager (LRM) configuration files.
# Globus SEG uses this directory to load site-specific LRM scripts/configs
# that define how jobs are scheduled and executed on the local cluster.
GLOBUS_SEG_LRM_DIR="{{ sysconfdir }}/globus/scheduler-event-generator"

# GLOBUS_SEG_NICE_LEVEL:
# Unix nice value for the SEG daemon process.
# Lower priority (higher nice value) prevents SEG from starving other jobs.
# Currently commented out; defaults to 0 (normal priority) if omitted.
# To set, uncomment and adjust the value (e.g., 5 or 10).
# # GLOBUS_SEG_NICE_LEVEL=0