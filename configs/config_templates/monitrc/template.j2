# Monit global settings and control file
# Set polling interval in seconds
set daemon {{ daemon_interval | default(60) }}

# Log file path
{% if log_path %}set logfile {{ log_path }}{% endif %}

# Syslog facility (e.g., 'daemon')
{% if syslog_facility %}set syslog facility {{ syslog_facility }}{% endif %}

# Mail server settings for alert notifications
{% if mail_server %}
set mailserver {{ mail_server }} port {{ mail_server_port | default(25) }}
{% if mail_from %}with timeout {{ mail_timeout | default(30) }}{% endif %}
{% endif %}

# Email alert recipients
{% if mail_alerts %}{% for addr in mail_alerts %}set alert {{ addr }}{% endfor %}{% endif %}

# HTTP daemon for web UI
{% if httpd_enabled %}
set httpd port {{ httpd_port | default(2812) }}
{% if httpd_allow_addr %}allow {{ httpd_allow_addr }}{% endif %}
{% if httpd_allow_username %}allow {{ httpd_allow_username }}{% if httpd_allow_password %}:{{ httpd_allow_password }}{% endif %}{% endif %}
{% endif %}

# Default service check interval (can be overridden per-service)
{% if service_check_interval %}set daemon {{ service_check_interval | default(60) }}{% endif %}

# Umask
{% if umask %}set umask {{ umask }}{% endif %}

# PID file path
{% if pidfile %}set pidfile {{ pidfile }}{% endif %}

# Event queue settings (for batched alerts)
{% if eventqueue_enabled %}
set eventqueue basedir {{ eventqueue_basedir | default('/var/lib/monit/events') }}
{% if eventqueue_slots %}slots {{ eventqueue_slots }}{% endif %}
{% endif %}

# Include other config files (e.g., /etc/monit/conf.d/*.conf)
{% if include_dirs %}{% for dir in include_dirs %}include {{ dir }}{% endfor %}{% else %}include /etc/monit/conf.d/*{% endif %}
