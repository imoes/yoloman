{
 "daemon_interval": 60,
 "eventqueue_basedir": "/var/lib/monit/events",
 "eventqueue_enabled": true,
 "eventqueue_slots": 500,
 "httpd_allow_addr": "127.0.0.1",
 "httpd_allow_password": "supersecret",
 "httpd_allow_username": "monit",
 "httpd_enabled": true,
 "httpd_port": 2812,
 "include_dirs": [
  "/etc/monit/conf.d/*"
 ],
 "log_path": "/var/log/monit.log",
 "mail_alerts": [
  "admin@example.com",
  "ops@example.com"
 ],
 "mail_from": "monit@example.com",
 "mail_server": "smtp.example.com",
 "mail_server_port": 587,
 "mail_timeout": 30,
 "pidfile": "/var/run/monit.pid",
 "service_check_interval": 120,
 "syslog_facility": "daemon",
 "umask": "022"
}
