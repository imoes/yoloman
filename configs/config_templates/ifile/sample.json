{
  "db_file": "/var/lib/ifile/idata",
  "db_verbosity": 1,
  "strip_headers": true,
  "use_stemming": true,
  "keep_stopwords": false,
  "keep_infrequent": true,
  "use_bitvector": false,
  "max_message_length": 100000,
  "training_folders": [
    "spam",
    "legitimate"
  ],
  "concise_threshold": 15,
  "message_source_path": "/tmp/mail_queue"
}
