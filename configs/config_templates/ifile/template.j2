# ifile configuration parameters
#
# This file serves as a documentation template for ifile command-line arguments.
# ifile is a command-line tool; it does not have a persistent daemon config file.
# However, for reproducibility (e.g., cron jobs or wrapper scripts), these settings
# define the default behavior of the ifile binary.
#
# Generated by Ansible Jinja2 template. Do not edit manually.

# Location to read/store ifile database. Defaults to user home directory .idata file.
# Corresponds to: -b, --db-file=file
# Default: ~/.idata
db_file: {{ (db_file | default('~/.idata')) | string }}

# Amount of output while running: 0=silent, 1=quiet, 2=progress, 3=verbose, 4=debug.
# Corresponds to: -v num
# Default: 1
db_verbosity: {{ db_verbosity | default(1) | int }}

# Skip all header lines except Subject:, From: and To:.
# Corresponds to: -h, --strip-header
# Default: true
strip_headers: {{ strip_headers | default(true) | string | lower }}

# Use 'Porter' stemming algorithm when lexing documents.
# Corresponds to: -S, --stemming
# Default: true
use_stemming: {{ use_stemming | default(true) | string | lower }}

# Do not throw out overly frequent (stoplist) words when lexing.
# Corresponds to: -s, --no-stoplist
# Default: false
keep_stopwords: {{ keep_stopwords | default(false) | string | lower }}

# Leave in the database words that occur infrequently (normally they are tossed).
# Corresponds to: -k, --keep-infrequent
# Default: false
keep_infrequent: {{ keep_infrequent | default(false) | string | lower }}

# Uses document bit-vector representation. Count each word once per document.
# Corresponds to: -o, --occur
# Default: false
use_bitvector: {{ use_bitvector | default(false) | string | lower }}

# Ignore portion of message after first char characters. Use entire message if char set to 0.
# Corresponds to: -m, --max-length=char
# Default: 50000
max_message_length: {{ max_message_length | default(50000) | int }}

# List of folder/category names used for training or classification.
# Must not include space characters.
# Corresponds to: -i, --insert=folder or -Q/-q usage
# Default: ['spam', 'ham']
training_folders:
{% for folder in (training_folders | default(['spam', 'ham'])) %}
  - {{ folder | string }}
{% endfor %}

# Threshold for concise output difference (used with -c -q).
# Output two highest ranking categories if score differs by at most threshold / 100.
# Corresponds to: -T threshold
# Default: 10
concise_threshold: {{ concise_threshold | default(10) | int }}

# Directory path where message files reside for batch processing with ifile.
# (Not a direct flag, but a common wrapper parameter for batch processing)
# Default: /var/spool/mail/inbox
message_source_path: {{ message_source_path | default('/var/spool/mail/inbox') | string }}