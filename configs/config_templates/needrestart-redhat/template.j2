# needrestart - Restart daemons after library updates.
#
# This is the configuration file of needrestart. This is perl syntax.
# needrestart uses reasonable default values, you might not need to
# change anything.
#

# Verbosity level: 0=quiet, 1=normal, 2=verbose
$nrconf{verbosity} = {{ nr_verbosity | default('2') }};

# Path of the package manager hook scripts
$nrconf{hook_d} = '{{ nr_hook_d | default("/etc/needrestart/hook.d") }}';

# Path of user notification scripts
$nrconf{notify_d} = '{{ nr_notify_d | default("/etc/needrestart/notify.d") }}';

# Path of restart scripts
$nrconf{restart_d} = '{{ nr_restart_d | default("/etc/needrestart/restart.d") }}';

# Disable sending notifications to user sessions running obsolete binaries
# using scripts from $nrconf{notify_d}
$nrconf{sendnotify} = {{ nr_sendnotify | default('0') }};

# Assume systemd PAM module is used for session detection
# In case you use systemd *without* pam_systemd.so you should set has_pam_systemd to false
# to enable legacy session detection!
$nrconf{has_pam_systemd} = {{ nr_has_pam_systemd | default('0') }};

# Restart mode: l=list only, i=interactive, a=automatic
# ATTENTION: If needrestart is configured to run in interactive mode but is run
# non-interactive (i.e. unattended-upgrades) it will fallback to list only mode.
$nrconf{restart} = '{{ nr_restart | default("i") }}';

# Preferred UI package
$nrconf{ui} = '{{ nr_ui | default("NeedRestart::UI::stdio") }}';

# Change default answer to 'no' in interactive mode
$nrconf{defno} = {{ nr_defno | default('1') }};

# UI mode: e=easy, a=advanced
$nrconf{ui_mode} = '{{ nr_ui_mode | default("e") }}';

# Print a combined systemctl restart command line for skipped services
$nrconf{systemctl_combine} = {{ nr_systemctl_combine | default('1') }};

# Blacklist binaries (list of regex).
$nrconf{blacklist} = [
    # ignore sudo (not a daemon)
    qr(^/usr/bin/sudo(\.dpkg-new)?$),

    # ignore apt-get (Debian Bug#784237)
    qr(^/usr/bin/apt-get(\.dpkg-new)?$),
];

# Blacklist services (list of regex) - USE WITH CARE.
# You should prefer to put services to $nrconf{override_rc} instead.
# Any service listed in $nrconf{blacklist_rc} will be ignored completely!
$nrconf{blacklist_rc} = [
    # {{ nr_blacklist_rc | default([]) | join(",\n    ") }}
];

# Override service default selection (hash of regex).
# Regexes are checked in lexical order; the first matching regex will be used.
$nrconf{override_rc} = {
    # DBus
    qr(^dbus) => {{ nr_override_rc_dbus | default('0') }},

    # display managers
    qr(^gdm) => {{ nr_override_rc_gdm | default('0') }},
    qr(^greetd) => {{ nr_override_rc_greetd | default('0') }},
    qr(^kdm) => {{ nr_override_rc_kdm | default('0') }},
    qr(^nodm) => {{ nr_override_rc_nodm | default('0') }},
    qr(^sddm) => {{ nr_override_rc_sddm | default('0') }},
    qr(^wdm) => {{ nr_override_rc_wdm | default('0') }},
    qr(^xdm) => {{ nr_override_rc_xdm | default('0') }},
    qr(^lightdm) => {{ nr_override_rc_lightdm | default('0') }},
    qr(^slim) => {{ nr_override_rc_slim | default('0') }},
    qr(^lxdm) => {{ nr_override_rc_lxdm | default('0') }},

    # networking stuff
    qr(^bird) => {{ nr_override_rc_bird | default('0') }},
    qr(^network) => {{ nr_override_rc_network | default('0') }},
    qr(^NetworkManager) => {{ nr_override_rc_networkmanager | default('0') }},
    qr(^ModemManager) => {{ nr_override_rc_modemmanager | default('0') }},
    qr(^wpa_supplicant) => {{ nr_override_rc_wpa_supplicant | default('0') }},
    qr(^ifup) => {{ nr_override_rc_ifup | default('0') }},
    qr(^openvpn) => {{ nr_override_rc_openvpn | default('0') }},
    qr(^quagga) => {{ nr_override_rc_quagga | default('0') }},
    qr(^frr) => {{ nr_override_rc_frr | default('0') }},
    qr(^tinc) => {{ nr_override_rc_tinc | default('0') }},
    qr(^(open|free|libre|strong)swan) => {{ nr_override_rc_swan | default('0') }},
    qr(^bluetooth) => {{ nr_override_rc_bluetooth | default('0') }},

    # gettys
    qr(^getty@.+\.service) => {{ nr_override_rc_getty | default('0') }},

    # systemd --user
    qr(^user@\d+\.service) => {{ nr_override_rc_user_services | default('0') }},

    # misc
    qr(^usbguard\.service$) => {{ nr_override_rc_usbguard | default('0') }},
    qr(^zfs-fuse) => {{ nr_override_rc_zfs_fuse | default('0') }},
    qr(^mythtv-backend) => {{ nr_override_rc_mythtv_backend | default('0') }},
    qr(^xendomains) => {{ nr_override_rc_xendomains | default('0') }},
    qr(^lxcfs) => {{ nr_override_rc_lxcfs | default('0') }},
    qr(^libvirt) => {{ nr_override_rc_libvirt | default('0') }},
    qr(^virtlogd) => {{ nr_override_rc_virtlogd | default('0') }},
    qr(^virtlockd) => {{ nr_override_rc_virtlockd | default('0') }},
    qr(^docker) => {{ nr_override_rc_docker | default('0') }},

    # systemd stuff
    # (see also Debian Bug#784238 & #784437)
    qr(^emergency\.service$) => {{ nr_override_rc_emergency | default('0') }},
    qr(^rescue\.service$) => {{ nr_override_rc_rescue | default('0') }},
    qr(^elogind) => {{ nr_override_rc_elogind | default('0') }},

    # do not restart oneshot services, see also #862840
    qr(^apt-daily\.service$) => {{ nr_override_rc_apt_daily | default('0') }},
    qr(^apt-daily-upgrade\.service$) => {{ nr_override_rc_apt_daily_upgrade | default('0') }},
    qr(^unattended-upgrades\.service$) => {{ nr_override_rc_unattended_upgrades | default('0') }},
    # do not restart oneshot services from systemd-cron, see also #917073
    qr(^cron-.*\.service$) => {{ nr_override_rc_cron_services | default('0') }},

    # ignore rc-local.service, see #852864
    qr(^rc-local\.service$) => {{ nr_override_rc_rc_local | default('0') }},

    # don't restart systemd-logind, see #798097
    qr(^systemd-logind) => {{ nr_override_rc_systemd_logind | default('0') }},
};

# Override container default selection (hash of regex)
$nrconf{override_cont} = {
    # {{ nr_override_cont | default({}) | tojson }}
};

# Disable interpreter scanners
$nrconf{interpscan} = {{ nr_interpscan | default('0') }};

# Path to persistent cache file for perl scanning results
$nrconf{perlcache} = '{{ nr_perlcache | default("/var/cache/needrestart/perl_scandeps_cache") }}';

# Ignore script files matching these regexs
$nrconf{blacklist_interp} = [
    # ignore temporary files
    qr(^/tmp/),
    qr(^/var/),
    qr(^/run/),
    # {{ nr_blacklist_interp | default([]) | join(",\n    ") }}
];

# Ignore +x mapped files matching one of these regexs
$nrconf{blacklist_mappings} = [
    # special device paths
    qr(^/(SYSV00000000( \(deleted\))?|drm(\s|$)|dev/)),

    # ignore memfd mappings
    qr(^/memfd:),

    # aio(7) mapping
    qr(^/\[aio\]),

    # Oil Runtime Compiler's JIT files
    qr#/orcexec\.[\w\d]+( \(deleted\))?$#,

    # plasmashell (issue #65)
    qr(/#\d+( \(deleted\))?$),

    # Java Native Access (issues #142 #185)
    qr#/jna\d+\.tmp( \(deleted\))?$#,

    # temporary stuff
    qr#^(/var)?/tmp/#,
    qr#^(/var)?/run/#,
    # {{ nr_blacklist_mappings | default([]) | join(",\n    ") }}
];

# Verify mapped files in filesystem:
# 0: enabled
# -1: ignore non-existing files, workaround for chroots and broken grsecurity kernels (default)
# 1: disable check completely, rely on content of maps file only
$nrconf{skip_mapfiles} = {{ nr_skip_mapfiles | default("-1") }};

# Enable/disable hints on pending kernel upgrades:
# 1: requires the user to acknowledge pending kernels
# 0: disable kernel checks completely
# -1: print kernel hints to stderr only
$nrconf{kernelhints} = {{ nr_kernelhints | default("-1") }};

# Filter kernel image filenames by regex. This is required on Raspian having
# multiple kernel image variants installed in parallel.
$nrconf{kernelfilter} = qr({{ nr_kernelfilter | default("kernel7\\.img") }});

# Enable/disable CPU microcode update hints:
# 1: requires the user to acknowledge pending updates
# 0: disable microcode checks completely
$nrconf{ucodehints} = {{ nr_ucodehints | default('0') }};

# Nagios Plugin: configure return code use by nagios
# as service status[1].
#
# [1] https://nagios-plugins.org/doc/guidelines.html#AEN78
#
# Default:
#  'nagios-status' => {
#     'sessions' => 1,
#     'services' => 2,
#     'kernel' => 2,
#     'ucode' => 2,
#     'containers' => 1
#  },
#
# Example: to ignore outdated sessions (status OK)
# $nrconf{'nagios-status'}->{sessions} = 0;

# Read additional config snippets.
if(-d q(/etc/needrestart/conf.d)) {
      foreach my $fn (sort </etc/needrestart/conf.d/*.conf>) {
	      print STDERR "$LOGPREF eval $fn\n" if($nrconf{verbosity} > 1);
	      eval do { local(@ARGV, $/) = $fn; <>};
	      die "Error parsing $fn: $@" if($@);
      }
}
