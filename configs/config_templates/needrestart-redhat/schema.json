{
  "nr_verbosity": {
    "type": "number",
    "default": 2,
    "description": "Verbosity level: 0=quiet, 1=normal, 2=verbose"
  },
  "nr_hook_d": {
    "type": "string",
    "default": "/etc/needrestart/hook.d",
    "description": "Path of the package manager hook scripts"
  },
  "nr_notify_d": {
    "type": "string",
    "default": "/etc/needrestart/notify.d",
    "description": "Path of user notification scripts"
  },
  "nr_restart_d": {
    "type": "string",
    "default": "/etc/needrestart/restart.d",
    "description": "Path of restart scripts"
  },
  "nr_sendnotify": {
    "type": "number",
    "default": 0,
    "description": "Disable sending notifications to user sessions running obsolete binaries"
  },
  "nr_has_pam_systemd": {
    "type": "number",
    "default": 0,
    "description": "Assume systemd PAM module is used for session detection"
  },
  "nr_restart": {
    "type": "string",
    "default": "i",
    "description": "Restart mode: l=list only, i=interactive, a=automatic",
    "enum": [
      "l",
      "i",
      "a"
    ]
  },
  "nr_ui": {
    "type": "string",
    "default": "NeedRestart::UI::stdio",
    "description": "Preferred UI package"
  },
  "nr_defno": {
    "type": "number",
    "default": 1,
    "description": "Change default answer to 'no' in interactive mode"
  },
  "nr_ui_mode": {
    "type": "string",
    "default": "e",
    "description": "UI mode: e=easy, a=advanced",
    "enum": [
      "e",
      "a"
    ]
  },
  "nr_systemctl_combine": {
    "type": "number",
    "default": 1,
    "description": "Print a combined systemctl restart command line for skipped services"
  },
  "nr_interpscan": {
    "type": "number",
    "default": 0,
    "description": "Disable interpreter scanners"
  },
  "nr_perlcache": {
    "type": "string",
    "default": "/var/cache/needrestart/perl_scandeps_cache",
    "description": "Path to persistent cache file for perl scanning results"
  },
  "nr_skip_mapfiles": {
    "type": "number",
    "default": -1,
    "description": "Verify mapped files in filesystem: 0=enabled, -1=ignore non-existing, 1=disable check"
  },
  "nr_kernelhints": {
    "type": "number",
    "default": -1,
    "description": "Enable/disable hints on pending kernel upgrades: 1=require ack, 0=disable, -1=stderr only"
  },
  "nr_kernelfilter": {
    "type": "string",
    "default": "kernel7\\.img",
    "description": "Filter kernel image filenames by regex"
  },
  "nr_ucodehints": {
    "type": "number",
    "default": 0,
    "description": "Enable/disable CPU microcode update hints: 1=require ack, 0=disable"
  },
