{
  "args": "--web.listen-address=:9154 --web.metrics-path=/metrics --postfix-queue-dir=/var/spool/postfix --timeout=5 --log.level=info --log.format=json",
  "web_listen_address": ":9154",
  "web_metrics_path": "/metrics",
  "postfix_queue_dir": "/var/spool/postfix",
  "enable_tls": true,
  "tls_cert_file": "/etc/prometheus-postfix-exporter/tls.crt",
  "tls_key_file": "/etc/prometheus-postfix-exporter/tls.key",
  "timeout_seconds": 5,
  "stats": [
    {
      "name": "queue",
      "enabled": true
    },
    {
      "name": "transport",
      "enabled": true
    },
    {
      "name": "smtpd",
      "enabled": true
    },
    {
      "name": "qmgr",
      "enabled": true
    },
    {
      "name": "bounce",
      "enabled": true
    },
    {
      "name": "flush",
      "enabled": true
    },
    {
      "name": "pickup",
      "enabled": true
    },
    {
      "name": "cleanup",
      "enabled": true
    },
    {
      "name": "trivial-rewrite",
      "enabled": true
    },
    {
      "name": "local",
      "enabled": true
    },
    {
      "name": "virtual",
      "enabled": true
    },
    {
      "name": "smtp",
      "enabled": true
    },
    {
      "name": "pipe",
      "enabled": true
    },
    {
      "name": "proxymap",
      "enabled": true
    }
  ]
}
