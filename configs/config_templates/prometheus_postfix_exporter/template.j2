# Command-line arguments for the Prometheus Postfix exporter
# See 'prometheus-postfix-exporter --help' for all options
# Enable systemd-style logging output
# Path to Postfix queue directory (default: /var/spool/postfix)
# Enable collection of queue statistics (default: true)
# Enable collection of transport statistics (default: true)
# Enable collection of smtpd connection stats (default: true)
# Enable collection of qmgr stats (default: true)
# Enable collection of defer stats (default: true)
# Enable collection of bounce stats (default: true)
# Enable collection of flush stats (default: true)
# Enable collection of pickup stats (default: true)
# Enable collection of cleanup stats (default: true)
# Enable collection of trivial-rewrite stats (default: true)
# Enable collection of qmgr-in/out stats (default: true)
# Enable collection of local/remote/delivery stats (default: true)
# Enable collection of pipe/bounce/fetch/stats (default: true)
# Enable collection of proxy/bounce/flush stats (default: true)
# Listen address (default: :9154)
# HTTP path for metrics endpoint (default: /metrics)
# Timeout for Postfix command execution (seconds)
# Enable TLS for metrics endpoint (default: false)
# Path to TLS certificate (required if TLS enabled)
# Path to TLS key (required if TLS enabled)

ARGS="{{ args }}"