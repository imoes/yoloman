{
  "mta": "postfix",
  "default_format": "mbox",
  "from_address": "admin@example.com",
  "local_recipient": "postmaster",
  "debug_level": 1,
  "log_destination": "syslog",
  "retry_attempts": 5,
  "retry_delay": 120,
  "enabled_transports": [
    "smtp",
    "fetchmail"
  ],
  "smtp_server": "smtp.example.com",
  "smtp_port": 587,
  "tls_enabled": true,
  "smtp_user": "mailer@example.com",
  "smtp_pass": "secure_password",
  "fetchmail_enabled": true,
  "poll_interval": 600,
  "fetch_server": "pop.example.com",
  "fetch_protocol": "pop3",
  "fetch_user": "user@example.com",
  "fetch_pass": "remote_password",
  "delete_on_server": false,
  "imap_enabled": false,
  "imap_address": "127.0.0.1",
  "imap_port": 143
}
