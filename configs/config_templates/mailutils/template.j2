# ==============================================================================
# Mailutils Configuration
#
# This configuration file defines the behavior for the mailutils package,
# including the Mail Transfer Agent (MTA), transport mechanisms (SMTP,
# Fetchmail, IMAP), logging, and general mail handling defaults.
# ==============================================================================

# --- Section: Defaults ---
[defaults]

# Default MTA implementation to use (e.g., postfix, exim4, sendmail)
# If not specified or empty, 'postfix' is used as the fallback.
mta = {{ mta | default('postfix') }}

# Default message format for local storage and output (mbox, maildir).
default_format = {{ default_format | default('mbox') }}

# --- Section: Mail ---
[mail]

# Default envelope sender address for outgoing mail generated by local scripts/system.
from_address = {{ from_address | default('root@localhost') }}

# Default local recipient for undeliverable or system mail (e.g., error messages).
local_recipient = {{ local_recipient | default('root') }}

# Debug mode level. 0 disables debug logging; 1-5 increases verbosity.
debug_level = {{ debug_level | default(0) }}

# Logging destination. Options: 'syslog', 'stdout', 'stderr', or a file path.
log_destination = {{ log_destination | default('syslog') }}

# Number of times to retry failed mail delivery attempts.
retry_attempts = {{ retry_attempts | default(3) }}

# Delay in seconds between each delivery retry attempt.
retry_delay = {{ retry_delay | default(60) }}

# --- Section: Transports ---
[transport]

# List of enabled transport plugins to load (e.g., smtp, fetchmail, imap).
# These items correspond to the subsection names defined below.
enabled_transports = {{ enabled_transports | default([]) | join(',') }}

# --- Subsection: SMTP Transport ---
[transport.smtp]

# Hostname of the external SMTP relay server to use for outbound mail.
smtp_server = {{ smtp_server | default('localhost') }}

# Port of the external SMTP relay server.
smtp_port = {{ smtp_port | default(25) }}

# Whether to use TLS for connections to the SMTP relay.
# Set to 'true' if the server expects STARTTLS or implicit TLS.
tls_enabled = {{ tls_enabled | default(false) | lower }}

# Username for SMTP authentication (if required by the relay).
smtp_user = {{ smtp_user | default('') }}

# Password for SMTP authentication (if required by the relay).
smtp_pass = {{ smtp_pass | default('') }}

# --- Subsection: Fetchmail Transport ---
[transport.fetchmail]

# Whether to enable the fetchmail transport to retrieve mail from remote servers.
fetchmail_enabled = {{ fetchmail_enabled | default(false) | lower }}

# Interval in seconds between poll attempts to the remote mail server.
poll_interval = {{ poll_interval | default(300) }}

# Hostname of the remote mail server to fetch messages from.
fetch_server = {{ fetch_server | default('localhost') }}

# Protocol to use for fetching mail (pop3, imap).
fetch_protocol = {{ fetch_protocol | default('pop3') }}

# Username on the remote mail server to authenticate as.
fetch_user = {{ fetch_user | default('') }}

# Password for the remote mail server user.
fetch_pass = {{ fetch_pass | default('') }}

# Whether to delete mail from the remote server after successful fetching.
delete_on_server = {{ delete_on_server | default(true) | lower }}

# --- Subsection: IMAP Transport ---
[transport.imap]

# Whether to enable the local IMAP server functionality.
imap_enabled = {{ imap_enabled | default(false) | lower }}

# IP address for the IMAP server to listen on.
imap_address = {{ imap_address | default('localhost') }}

# Port for the IMAP server to listen on.
imap_port = {{ imap_port | default(143) }}

# --- Section: Aliases ---
[aliases]
# List of alias mappings in format local_user=destination.
# Example: root=admin@example.com
# (No default aliases are defined in the schema.)
aliases = {{ aliases | default('') }}