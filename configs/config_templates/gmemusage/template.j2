{#
  gmemusage configuration template
  This template generates resource usage limits for the gmemusage utility.
  Each resource entry is defined by a name and a value string, as specified in the 'resources' list.
  The format is: <name>: <value> (with a colon added if not already present in the name).
#}

{# List of X resource entries for gmemusage, each with a name and value string. Entries must match documented resource names and types from gme #}
{% set resources = resources | default([]) %}
{% for resource in resources %}
  {# Name of the resource entry #}
  {# Value of the resource entry #}
  {{ resource.name }}{{ ':' if not resource.name.endswith(':') }} {{ resource.value }}
{% endfor %}