# ==============================================================================
# MATE-Tweak Global Configuration
# ==============================================================================
# This file configures global defaults for the MATE Tweaker application.
# It is managed by Ansible. Do not edit manually; changes will be overwritten.
# ==============================================================================

[General]

# theme_name: The name of the GTK theme to apply globally via mate-tweak.
# Default: Mint-X
theme_name = {{ (theme_name | default('Mint-X')) | string }}

# icon_theme_name: The name of the icon theme to apply globally via mate-tweak.
# Default: Mint-X
icon_theme_name = {{ (icon_theme_name | default('Mint-X')) | string }}

[Appearance]

# enable_daemon: Whether to run the mate-tweak helper daemon in the background.
# Default: True
enable_daemon = {{ enable_daemon | default(true) | lower }}

# background_image: File path to the desktop background image.
# Default: /usr/share/backgrounds/default.jpg
background_image = {{ (background_image | default('/usr/share/backgrounds/default.jpg')) | string }}

# cursor_theme: The name of the cursor theme to apply.
# Default: Adwaita
cursor_theme = {{ (cursor_theme | default('Adwaita')) | string }}

[Fonts]

# font_name_title: Font specification for window title bars.
# Default: Sans Bold 11
font_name_title = {{ (font_name_title | default('Sans Bold 11')) | string }}

# font_name_text: Font specification for regular interface text.
# Default: Sans 11
font_name_text = {{ (font_name_text | default('Sans 11')) | string }}

# font_name_monospace: Font specification for terminal and code fonts.
# Default: Monospace 11
font_name_monospace = {{ (font_name_monospace | default('Monospace 11')) | string }}

[Desktop]

# enabled_plugins: List of MATE desktop plugins to enable by default.
# This is a flat list of plugin names/identifiers.
# Default: ['caja', 'desktop']
enabled_plugins = {{ (enabled_plugins | default(['caja', 'desktop'])) | join(',') }}

# hidden_apps: List of application desktop file names to hide from the main menu.
# This is a flat list of .desktop basenames.
# Default: []
hidden_apps = {{ (hidden_apps | default([])) | join(',') }}

# enable_global_menu: Whether to enable the global menu integration for MATE applications.
# Default: False
enable_global_menu = {{ enable_global_menu | default(false) | lower }}