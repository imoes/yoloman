{#
  Bacula Director Configuration Template
  ======================================
  This template generates the bacula-dir.conf file for the Bacula Director component.
  Bacula uses a specific directive-based configuration format.
  All variables are sourced from the Ansible inventory or role defaults, with strict defaults
  to ensure safe rendering even if specific fields are omitted from the parent scope.
#}

{#
  Director {
    The main director block defines the Director daemon itself.
    It requires a unique Name and a Port for communication with Storage and Client daemons.
  #}
Director {
    {#
      director_name: The unique name of this Director instance.
      Default is derived from the hostname if not explicitly provided.
    #}
    Name = "{{ (director_name | default(ansible_hostname | default('localhost'))) }}-Director"

    {#
      director_port: The TCP port on which the Bacula Director listens for connections.
      Default port for Bacula is 9101.
    #}
    Port = {{ director_port | default(9101) }}
}