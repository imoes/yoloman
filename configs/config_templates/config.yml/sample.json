{
  "log_level": "info",
  "log_environment": "production",
  "log_file": false,
  "storage_driver": "filesystem",
  "storage_filesystem_rootdirectory": "/var/lib/registry",
  "s3_region": "us-east-1",
  "s3_bucket": "",
  "s3_encrypt": false,
  "s3_keyid": "",
  "s3_secure": true,
  "s3_v4auth": true,
  "gcs_bucket": "",
  "gcs_keyid": "",
  "gcs_private_key": "",
  "gcs_user_project": "",
  "azure_container": "",
  "azure_accountname": "",
  "azure_accountkey": "",
  "azure_realm": "blob.core.windows.net",
  "storage_delete_enabled": false,
  "storage_cache_blobdescriptor": true,
  "storage_redirect": false,
  "http_addr": "0.0.0.0:5000",
  "tls_enabled": false,
  "tls_addr": "0.0.0.0:5001",
  "tls_keystore": "/etc/registry/tls/registry.crt",
  "tls_key": "/etc/registry/tls/registry.key",
  "tls_client_ca": "",
  "debug_addr": "localhost:5001",
  "debug_prometheus_enabled": true,
  "debug_pprof_enabled": false,
  "debug_pprof_addr": "localhost:6060",
  "debug_trace_enabled": false,
  "debug_trace_sampler": false,
  "debug_trace_sampler_param": 0.1,
  "auth_type": "none",
  "auth_token_realm": "",
  "auth_token_service": "registry.docker.io",
  "auth_token_issuer": "registry-token-issuer",
  "auth_token_rootcertbundle": "",
  "auth_htpasswd_realm": "Registry Realm",
  "auth_htpasswd_path": "/etc/registry/htpasswd",
  "proxy_remoteurl": "",
  "proxy_username": "",
  "proxy_password": "",
  "notifications_enabled": false,
  "notifications_endpoints": [],
  "health_storagedriver_enabled": true,
  "health_storagedriver_interval": "10s",
  "health_storagedriver_threshold": 3
}
