<?xml version="1.0" encoding="UTF-8"?> <!-- -*- XML -*- -->

<!DOCTYPE busconfig PUBLIC
 "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>

  <!--
    Only root can own the service.
    Schema: dbus_service_name
    Description: The D-Bus service name that the CupsPkHelper mechanism registers and listens on.
  -->
  <policy user="root">
    <allow own="{{ dbus_service_name | default('org.opensuse.CupsPkHelper.Mechanism') }}"/>
  </policy>

  <!--
    Allow anyone to invoke methods on the interfaces.
    This grants access to the service owned by the root user.
  -->
  <policy context="default">
    <allow send_destination="{{ dbus_service_name | default('org.opensuse.CupsPkHelper.Mechanism') }}"/>
  </policy>

</busconfig>
