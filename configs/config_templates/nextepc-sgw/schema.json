{
  "sgw_log_file": {
    "type": "string",
    "default": "/var/log/nextepc/sgw.log",
    "description": "Path to the SGW log file"
  },
  "logger_trace_app": {
    "type": "number",
    "default": 1,
    "description": "Application trace level for logger"
  },
  "logger_trace_gtpv2": {
    "type": "number",
    "default": 1,
    "description": "GTPv2 trace level for logger"
  },
  "logger_trace_gtp": {
    "type": "number",
    "default": 1,
    "description": "GTP trace level for logger"
  },
  "parameter_no_ipv6": {
    "type": "bool",
    "default": true,
    "description": "Disable IPv6 support"
  },
  "sgw_gtpc_addr": {
    "type": "string",
    "default": "127.0.0.2",
    "description": "Address of the GTP-C peer (PGW/MME)"
  }
}
