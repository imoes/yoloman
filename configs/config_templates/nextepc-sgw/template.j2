# NextEPc SGW Configuration Template
# This file configures the Serving Gateway (SGW) for the NextEPC LTE core network.
# It uses YAML format similar to the main nextepc.conf.

# === Logger Configuration ===
logger:
    # Path to the SGW log file
    file: {{ sgw_log_file | default('/var/log/nextepc/sgw.log') }}
    trace:
        # Application trace level for logger
        app: {{ logger_trace_app | default(1) }}
        # GTPv2 trace level for logger
        gtpv2: {{ logger_trace_gtpv2 | default(1) }}
        # GTP trace level for logger
        gtp: {{ logger_trace_gtp | default(1) }}

# === Global Parameters ===
parameter:
    # Disable IPv6 support
    no_ipv6: {{ parameter_no_ipv6 | default(true) }}

# === SGW Configuration ===
sgw:
    gtpc:
        # Address of the GTP-C peer (PGW/MME)
        addr: {{ sgw_gtpc_addr | default('127.0.0.2') }}
    gtpu:
        # GTP-U settings (reserved for future expansion or dynamic binding)
        # No default fields defined in schema.