# Alias configuration for the Tirex example map.
# Defines the URL path alias and the local document root directory.
Alias {{ tirex_alias_path | default('/tirex-example-map') }} {{ tirex_document_root | default('/usr/share/tirex/example-map') }}

# Directory block for the document root.
# Enables symlink following and allows all overrides (e.g., .htaccess).
# Grants access to all clients by default (legacy Apache 2.2 syntax).
<Directory {{ tirex_document_root | default('/usr/share/tirex/example-map') }}/>
	Options +FollowSymLinks
	AllowOverride All
	order allow,deny
	allow from all
</Directory>

# Apache Listen directive.
# Specifies the port on which the Apache virtual host listens.
Listen {{ apache_listen_port | default('8083') }}

# VirtualHost block for the Tirex map serving.
# Configures mod_tile and Apache to serve map tiles.
<VirtualHost *:{{ apache_listen_port | default('8083') }}>

    # mod_tile Tile Directory.
    # The directory where mod_tile stores tiles.
    ModTileTileDir {{ mod_tile_tile_dir | default('/var/cache/tirex/tiles') }}

    # AddTileConfig: Add a tile set configuration.
    # Maps a URL path relative to the virtual host to a tile set name.
    # The tile set name is used in communication with tirex and identifies
    # the directory under which (meta)tiles are stored on disk.
    # Default behavior serves PNG files; other types may require AddTileMimeConfig.
    AddTileConfig {{ tileset_url_path | default('/tiles/tirex-example') }} {{ tileset_name | default('tirex-example') }}

    # Enable Stats.
    # Enable or disable tile delivery stats.
    # Stats allow monitoring delivery metrics via /mod_tile but incur locking overhead.
    ModTileEnableStats {{ mod_tile_enable_stats | default('On') }}

    # Bulk Mode.
    # Turns on bulk mode for mod_tile.
    # In bulk mode, mod_tile does not request dirty tiles to be re-rendered.
    # Missing tiles are always requested in the lowest priority.
    ModTileBulkMode {{ mod_tile_bulk_mode | default('Off') }}

    # Request Timeout.
    # Timeout before giving up for a tile to be rendered (in seconds).
    ModTileRequestTimeout {{ mod_tile_request_timeout | default('0') }}

    # Missing Request Timeout.
    # Timeout before giving up for a tile to be rendered that is otherwise missing (in seconds).
    ModTileMissingRequestTimeout {{ mod_tile_missing_request_timeout | default('60') }}

    # Max Load Old.
    # Load threshold above which old tiles are not re-rendered.
    # If load exceeds this, users receive stale tiles instead of triggering re-renders.
    ModTileMaxLoadOld {{ mod_tile_max_load_old | default('2') }}

    # Max Load Missing.
    # Load threshold above which missing tiles are not rendered.
    # If load exceeds this, users receive 404 errors instead of triggering re-renders.
    ModTileMaxLoadMissing {{ mod_tile_max_load_missing | default('5') }}

    # Renderd Socket Name.
    # Socket path to connect to the rendering daemon (tirex).
    ModTileRenderdSocketName {{ mod_tile_renderd_socket_name | default('/run/tirex/modtile.sock') }}

    # Cache Duration Max.
    # Upper bound on cache duration for tiles in seconds.
    # Precedes other settings regarding how long a tile remains cacheable.
    ModTileCacheDurationMax {{ mod_tile_cache_duration_max | default('604800') }}

    # Cache Duration Dirty.
    # Cache duration for dirty/outdated tiles in seconds.
    # Applies to tiles known to be outdated and queued for re-rendering.
    ModTileCacheDurationDirty {{ mod_tile_cache_duration_dirty | default('900') }}

    # Cache Duration Minimum.
    # Minimum cache duration for fresh tiles in seconds.
    # An additional fuzz factor (0-3 hours) may be applied on top of this.
    ModTileCacheDurationMinimum {{ mod_tile_cache_duration_minimum | default('10800') }}

    # Cache Duration Medium Zoom.
    # Specifies the zoom level below which medium caching applies and the duration in seconds.
    # Lower zoom levels change less frequently, allowing longer cache times.
    ModTileCacheDurationMediumZoom {{ mod_tile_cache_duration_medium_zoom_level | default(13) }} {{ mod_tile_cache_duration_medium_time | default(86400) }}

    # Cache Duration Low Zoom.
    # Specifies the zoom level below which low caching applies and the duration in seconds.
    # Very low zoom levels can be cached for extended periods.
    ModTileCacheDurationLowZoom {{ mod_tile_cache_duration_low_zoom_level | default(9) }} {{ mod_tile_cache_duration_low_time | default(518400) }}

    # Cache Last Modified Factor.
    # Factor for determining cache duration based on last modified time.
    # Example: factor 0.20 means if a tile is 5 days old, it can be cached for 1 day.
    ModTileCacheLastModifiedFactor {{ mod_tile_cache_last_modified_factor | default('0.20') }}

    # Enable Tile Throttling.
    # Enable or disable tile throttling to prevent scraper overload.
    # Uses a token bucket approach to shape traffic per IP.
    ModTileEnableTileThrottling {{ mod_tile_enable_tile_throttling | default('Off') }}

    # Enable Tile Throttling X-Forwarded.
    # Use X-Forwarded-For header for throttling (0=client IP, 1=X-Forwarded-For first).
    # Use with caution as X-Forwarded-For can be manipulated by clients.
    ModTileEnableTileThrottlingXForward {{ mod_tile_enable_tile_throttling_xforward | default('0') }}

    # Throttling Tiles Pool.
    # Pool size in tiles for tile serving throttling.
    # Defines the initial burst capacity for an IP before rate limiting applies.
    ModTileThrottlingTiles {{ mod_tile_throttling_tiles_pool | default('10000') }} 1

    # Throttling Renders.
    # Parameters for throttling render requests (poolsize: 128, topup rate: 0.2/sec).
    # Limits how fast the server accepts new rendering tasks from a single source.
    ModTileThrottlingRenders 128 0.2

    # Block internal commands.
    # Prevent access to dirty and status endpoints for security.
    RedirectMatch 404 /tiles/.*/dirty
    RedirectMatch 404 /tiles/.*/status

</VirtualHost>
