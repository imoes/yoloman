{
  "home_page": "https://www.wikipedia.org",
  "user_agent": "Vimb/Custom/1.0",
  "cookie_accept": "origin",
  "dark_mode": true,
  "scripts": true,
  "images": false,
  "plugins": false,
  "default_font": "Arial, sans-serif",
  "font_size": 18,
  "monospace_font": "Consolas, monospace",
  "serif_font": "Georgia, serif",
  "sans_serif_font": "Helvetica, sans-serif",
  "cursiv_font": "Comic Sans MS, cursive",
  "download_path": "/home/user/Downloads",
  "download_command": "wget -O %s %s",
  "download_use_external": true,
  "headers": [
    "DNT=1",
    "Referer=none"
  ],
  "editor_command": "nvim %s",
  "timeoutlen": 500,
  "hint_keys": "asdfghjklqwertyuiop",
  "hardware_acceleration_policy": "always",
  "geolocation": "never",
  "notification": "never"
}
