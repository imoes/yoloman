#
# Defaults for ifupdown-ng networking service
# Self-documenting template for Ansible role management.
#

# Set to 'yes' to enable verbose logging for ifup/ifdown commands.
# This helps in debugging network interface configuration issues.
VERBOSE="{{ verbose | default('no') }}"

# Set to 'yes' if you want to skip deconfiguring all interfaces during system
# reboot and shutdown. This might be of interest in large scale deployments,
# where you might not want to wait for interface deconfiguration to speed up
# shutdown/reboot.
SKIP_DOWN_AT_SYSRESET="{{ skip_down_at_sysreset | default('yes') }}"