{
  "pid_file": "/var/run/qemu-ga/qemu-ga.pid",
  "log_file": "/var/log/qemu-ga/qemu-ga.log",
  "log_verbosity": 1,
  "fsfreeze_hook": "/usr/lib/qemu/qemu-ga-fsfreeze-hook",
  "fsfreeze_hooks": [
    {
      "path": "/usr/local/bin/backup-checkpoint.sh",
      "args": [
        "--snapshot",
        "daily"
      ]
    },
    {
      "path": "/usr/local/bin/vol-sync.sh",
      "args": []
    }
  ],
  "acpi_device_path": "yes"
}
