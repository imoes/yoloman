{
  "log_level": "INFO",
  "log_file": "/var/log/designate/designate-agent.log",
  "log_dir": "/var/log/designate",
  "bind_host": "0.0.0.0",
  "bind_port": 9001,
  "transport_url": "rabbit://designate:secret@192.168.1.10:5672/",
  "rpc_workers": 2,
  "rpc_response_timeout": 120,
  "rate_limit": 0,
  "rate_limit_period": 60,
  "agent_enabled": true,
  "agent_bind_host": "127.0.0.1",
  "agent_bind_port": 53,
  "agent_endpoint_type": "internal",
  "agent_region_name": "RegionOne",
  "agent_project_name": "service",
  "agent_username": "designate",
  "agent_password": "designate_secret_password",
  "agent_auth_url": "http://192.168.1.10:5000/v3",
  "agent_auth_plugin": "password",
  "upstream_dns_servers": [
    "10.0.0.1:53",
    "10.0.0.2:53"
  ],
  "zonefile_dir": "/var/lib/designate/zonefiles",
  "agent_workers": 4,
  "agent_max_workers": 200,
  "lock_path": "/run/designate/lock",
  "policy_file": "/etc/designate/policy.json",
  "policy_rules": ""
