{
 "auth": {
  "authfile": "/etc/ha.d/authkeys"
 },
 "auto_failback": true,
 "deadtime_interval": 30,
 "debug_mode": false,
 "heartbeat": {
  "serial": {
   "enabled": false
  },
  "udp_broadcast": {
   "interfaces": [
    "eth0"
   ]
  },
  "unicast": {
   "peers": [
    {
     "address": "192.168.1.102",
     "interface": "eth0"
    },
    {
     "address": "192.168.1.103",
     "interface": "eth0"
    }
   ]
  }
 },
 "initdead_interval": 60,
 "keepalive_interval": 2,
 "logging": {
  "facility": "daemon",
  "logfile": "/var/log/ha-log"
 },
 "node_name": "node1.example.com",
 "nodes": [
  {
   "name": "node1.example.com"
  },
  {
   "name": "node2.example.com"
  },
  {
   "name": "node3.example.com"
  }
 ],
 "pacemaker": {
  "enabled": false
 },
 "use_logd": true,
 "warntime_interval": 15,
 "watchdog": {
  "device": "/dev/watchdog"
 }
}
