{
  "pid_file": "/var/run/osspd.pid",
  "log_level": "info",
  "work_dir": "/run/osspd",
  "bind_addr": "",
  "control_port": 9001,
  "audio_ports": [
    9002,
    9003
  ],
  "max_clients": 64,
  "osss_compat_v4": false,
  "device_emulation": [
    {
      "device": "/dev/dsp",
      "channels": 2,
      "sample_rate": 48000,
      "format": "S16_LE"
    }
  ],
  "backend_dsp": "alsa",
  "alsa_device": "hw:0",
  "jack_client_name": "osspd",
  "pipewire_node_name": "osspd",
  "realtime": true,
  "realtime_priority": 85,
  "buffer_size": 8192,
  "periods": 4,
  "latency_compensation": true,
  "device_mappings": []
}
