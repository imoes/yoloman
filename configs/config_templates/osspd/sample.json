{
  "log_level": "info",
  "pid_file": "/run/osspd/osspd.pid",
  "work_dir": "/run/osspd",
  "bind_addr": "127.0.0.1",
  "control_port": 9001,
  "audio_ports": [
    9002,
    9003
  ],
  "max_clients": 128,
  "osss_compat_v4": true,
  "device_emulation": [
    {
      "device": "/dev/dsp",
      "channels": 2,
      "sample_rate": 48000,
      "format": "S16_LE"
    },
    {
      "device": "/dev/mixer",
      "channels": 1,
      "sample_rate": 48000,
      "format": "U8"
    }
  ],
  "backend_dsp": "pipewire",
  "pipewire_node_name": "osspd-main",
  "realtime": true,
  "realtime_priority": 75,
  "buffer_size": 4096,
  "periods": 2,
  "latency_compensation": true,
  "device_mappings": [
    {
      "oss_device": "/dev/dsp0",
      "oss_instance": 0
    },
    {
      "oss_device": "/dev/dsp1",
      "oss_instance": 1
    }
  ]
}
