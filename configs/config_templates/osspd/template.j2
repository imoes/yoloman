# OSSPD Configuration Template
# Package: osspd (OSS Device Access Daemon)
# This service manages access to OSS (Open Sound System) devices for non-root users.
# Generated from schema fields: pid_file, log_level

# -----------------------------------------------------------------------------
# Daemon Management
# -----------------------------------------------------------------------------

# Absolute path to the PID file for the daemon process
# Schema: pid_file
pid_file = {{ pid_file | default('/var/run/osspd.pid') }}

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Logging verbosity: 'debug', 'info', 'warn', or 'error'
# Schema: log_level
log_level = {{ log_level | default('info') | lower }}

# -----------------------------------------------------------------------------
# Kernel Module Blacklisting
# -----------------------------------------------------------------------------
# The following lines blacklist the legacy OSS kernel modules to prevent conflicts
# with osspd, which provides userspace access to audio devices.
# These directives are typically written to /etc/modprobe.d/osspd.conf or similar.

blacklist snd-pcm-oss
blacklist snd-mixer-oss
blacklist snd-seq-oss
