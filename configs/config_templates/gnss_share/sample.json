{
  "enabled": true,
  "api": {
    "bind_address": "0.0.0.0",
    "port": 8080
  },
  "gnss": {
    "device_path": "/dev/ttyACM0",
    "baud_rate": 115200,
    "accepted_nmea_types": [
      "GGA",
      "RMC",
      "ZDA"
    ],
    "min_satellites": 5,
    "max_position_age": 45
  },
  "logging": {
    "position_log_path": "/var/log/gnss-share/positions.log",
    "log_level": "warn"
  },
  "sharing": {
    "peers": [
      {
        "hostname": "gnss-relay.local",
        "port": 8081
      },
      {
        "hostname": "192.168.10.50",
        "port": 8081
      }
    ],
    "tls": {
      "enabled": true,
      "cert_path": "/etc/gnss-share/tls/server.crt",
      "key_path": "/etc/gnss-share/tls/server.key"
    },
    "cache_path": "/var/lib/gnss-share/cache.json",
    "interval": 15
  }
}
