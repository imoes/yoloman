{
  "base_dir": "/var/cache/apt-cacher-ng",
  "temp_dir": "/tmp/apt-cacher-ng",
  "log_dir": "/var/log/apt-cacher-ng",
  "bind_address": "0.0.0.0",
  "port": 3142,
  "max_connections": 100,
  "debug_level": 0,
  "max_age": 86400,
  "timeout": 45,
  "compression": "gzip",
  "use_pipelining": true,
  "use_gzip_encoding": true,
  "support_deb822": true,
  "normalize_path": true,
  "upstream_proxies": [
    "proxy.company.local:3128"
  ],
  "mirrors": [
    {
      "name": "Ubuntu 22.04 LTS (Jammy)",
      "url": "http://archive.ubuntu.com/ubuntu/",
      "local_path": "ubuntu-jammy"
    },
    {
      "name": "Ubuntu Security",
      "url": "http://security.ubuntu.com/ubuntu/",
      "local_path": "ubuntu-security"
    },
    {
      "name": "Debian Stable",
      "url": "http://deb.debian.org/debian/",
      "local_path": "debian-stable"
    }
  ]
}
