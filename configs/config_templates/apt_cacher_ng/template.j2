# ============================================================================
# apt-cacher-ng Configuration Template
# ============================================================================
# This template generates the main configuration file for apt-cacher-ng,
# a Debian/Ubuntu package caching proxy server. It is self-documenting:
# every directive is preceded by a comment derived from its schema description.
#
# Variable defaults are applied inline using Jinja2's `default` filter to
# ensure safe rendering even if a variable is undefined in the Ansible play.
# ============================================================================

# Base directory where cached packages, indexes, and metadata are stored.
BaseDir: {{ base_dir | default('/var/cache/apt-cacher-ng') }}

# Directory for temporary files (e.g., incomplete downloads). Should be on fast I/O storage.
TempDir: {{ temp_dir | default('/tmp') }}

# Directory where access and error logs are written.
LogDir: {{ log_dir | default('/var/log/apt-cacher-ng') }}

# IP address to bind the server to. Use '127.0.0.1' to restrict to local only.
BindAddress: {{ bind_address | default('0.0.0.0') }}

# TCP port the server listens on. Clients must point to this port (e.g., http://server:3142).
Port: {{ port | default(3142) }}

# Maximum number of simultaneous client connections. Increase for high-traffic environments.
MaxConnections: {{ max_connections | default(50) }}

# Verbosity of logs: 0 (quiet, production), 1 (normal), 2 (verbose, debugging).
DebugLevel: {{ debug_level | default(0) }}

# Maximum age (in seconds) of cached metadata before it's refreshed from upstream. Default: 7 days.
MaxAge: {{ max_age | default(604800) }}

# Seconds to wait for upstream response before giving up. Reduce for faster failure in unstable networks.
Timeout: {{ timeout | default(30) }}

# Compression format for cached files. 'gzip' saves disk space; 'none' may improve speed on I/O-bound systems.
Compression: {{ compression | default('gzip') }}

# Whether to enable HTTP/1.1 request pipelining for better upstream throughput. Disable if upstream has bugs.
# Converts boolean to string '0' or '1' as expected by apt-cacher-ng.
UsePipelining: {{ use_pipelining | default(true) | ternary('1', '0') }}

# Enable gzip content encoding for downloads. Reduces bandwidth but increases CPU usage.
# Converts boolean to string '0' or '1' as expected by apt-cacher-ng.
UseGzipEncoding: {{ use_gzip_encoding | default(true) | ternary('1', '0') }}

# Enable support for DEB822-style Sources files (apt ≥ 2.7). Required for newer Ubuntu/Debian clients.
# Converts boolean to string '0' or '1' as expected by apt-cacher-ng.
SupportDeb822: {{ support_deb822 | default(true) | ternary('1', '0') }}

# Normalize request paths to avoid duplicate caching (e.g., /dists/ and /dists are treated identically).
# Converts boolean to string '0' or '1' as expected by apt-cacher-ng.
NormalizePath: {{ normalize_path | default(true) | ternary('1', '0') }}

# List of upstream HTTP proxies to use (e.g., corporate proxies). Format: 'host:port' or 'host:port:user:pass'. Leave empty if none.
# The values are joined by semicolons (;) as per apt-cacher-ng convention.
UpstreamProxies: {{ upstream_proxies | default([]) | join(';') }}

# Per-repository or per-mirror configuration.
# Format: <scheme>://<host>[:<port>]/<path> → local_path
# Each entry maps an upstream URL to a local cache path.
# The mirrors field is expected to be a list of mappings (dictionaries) in the schema.
# We iterate over the list, treating each item as a map of url -> local_path.
{% for mirror_entry in mirrors | default([]) %}
{% set m = mirror_entry %}
# Repository mirror configuration
# URL to upstream source
{{ m.url | default('') }}: {{ m.local_path | default('') }}
{% endfor %}