{
  "listen_addr": "127.0.0.1",
  "listen_port": 564,
  "root_path": "/srv/p9ufs/root",
  "auth_mode": "user",
  "tls_cert_path": "/etc/p9ufs/tls/server.crt",
  "tls_key_path": "/etc/p9ufs/tls/server.key",
  "max_connections": 256,
  "verbose_logging": true,
  "extra_filesystems": [
    {
      "name": "Backup Data",
      "path": "/data/backups",
      "mount_point": "backup"
    },
    {
      "name": "Public Files",
      "path": "/srv/public",
      "mount_point": "pub"
    }
  ],
  "user_map": [
    {
      "username": "alice",
      "uid": "1001",
      "gid": "1001"
    },
    {
      "username": "bob",
      "uid": "1002",
      "gid": "1002"
    }
  ],
  "server_name": "p9ufs-home"
}
