{# console-setup configuration file #}
{# Only one assignment per line; comments start with '#' #}
{% if 'ACTIVE_CONSOLES' in values %}
ACTIVE_CONSOLES='{{ values.ACTIVE_CONSOLES }}'
{% endif %}
{% if 'CHARMAP' in values %}
CHARMAP='{{ values.CHARMAP }}'
{% endif %}
{% if 'CODESET' in values %}
CODESET='{{ values.CODESET }}'
{% endif %}
{% if 'FONTFACE' in values %}
FONTFACE='{{ values.FONTFACE }}'
{% endif %}
{% if 'FONTSIZE' in values %}
FONTSIZE='{{ values.FONTSIZE }}'
{% endif %}
{% if 'VIDEOMODE' in values %}
VIDEOMODE='{{ values.VIDEOMODE }}'
{% endif %}
{% if 'FONT' in values and values.FONT | length > 0 %}
FONT='{{ values.FONT | join(" ") }}'
{% endif %}
{% if 'FONT_MAP' in values and values.FONT_MAP is not none %}
FONT_MAP='{{ values.FONT_MAP }}'
{% endif %}
{% if 'CONSOLE_MAP' in values and values.CONSOLE_MAP is not none %}
CONSOLE_MAP='{{ values.CONSOLE_MAP }}'
{% endif %}
{% if 'SCREEN_WIDTH' in values and values.SCREEN_WIDTH is not none %}
SCREEN_WIDTH='{{ values.SCREEN_WIDTH }}'
{% endif %}
{% if 'SCREEN_HEIGHT' in values and values.SCREEN_HEIGHT is not none %}
SCREEN_HEIGHT='{{ values.SCREEN_HEIGHT }}'
{% endif %}
{% if 'BEEP' in values %}
BEEP='{{ values.BEEP }}'
{% endif %}
