# ==============================================================================
# bootlogd_daemon configuration
# ==============================================================================
# This template generates the configuration file for the bootlogd daemon.
# bootlogd captures kernel and init messages during the system boot process
# before the full logging infrastructure (like rsyslog or journald) is fully
# operational or configured.

# ------------------------------------------------------------------------------
# bootlogd_enable: Enable the boot logging daemon to capture messages during system startup.
# Values are 'yes' or 'no'.
# ------------------------------------------------------------------------------
BOOTLOGD_ENABLE={{ bootlogd_enable | default(true) | ternary('yes', 'no') }}

# ------------------------------------------------------------------------------
# bootlogd_logfile: Path to the file where boot messages will be logged.
# This file is created by bootlogd if it does not exist.
# ------------------------------------------------------------------------------
LOGFILE={{ bootlogd_logfile | default('/var/log/boot') }}

# ------------------------------------------------------------------------------
# bootlogd_log_to_syslog: If enabled, also send boot messages to syslog (e.g., systemd-journald).
# Values are 'yes' or 'no'.
# ------------------------------------------------------------------------------
LOG_TO_SYSLOG={{ bootlogd_log_to_syslog | default(false) | ternary('yes', 'no') }}

# ------------------------------------------------------------------------------
# bootlogd_extra_opts: Additional command-line arguments passed directly to bootlogd
# (e.g., `-f` for forced overwrite, `-q` for quiet). Items are strings.
# ------------------------------------------------------------------------------
EXTRA_OPTS="{{ bootlogd_extra_opts | default([]) | join(' ') }}"