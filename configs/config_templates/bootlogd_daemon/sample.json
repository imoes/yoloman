{
  "bootlogd_enable": true,
  "bootlogd_logfile": "/var/log/boot",
  "bootlogd_log_to_syslog": true,
  "bootlogd_verbose": true,
  "bootlogd_suppress_dups": true,
  "bootlogd_delay": 5,
  "bootlogd_extra_opts": [
    "-q",
    "-f"
  ],
  "bootlogd_post_boot_actions": [
    {
      "description": "Compress boot log after 10 seconds",
      "command": "sleep 10 && gzip -9 /var/log/boot"
    },
    {
      "description": "Send boot summary to admin email",
      "command": "/usr/local/bin/report-boot-summary.sh admin@example.com"
    }
  ]
}
