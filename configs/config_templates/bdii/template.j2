# =============================================================================
# BDII (BEIRUT Data Integration Index) Configuration
# =============================================================================
# This template configures the BDII service, which provides a GIP-compliant
# LDAP interface to Grid Infrastructure information.
# =============================================================================

# Path to the BDII update log file.
BDII_LOG_FILE={{ log_file | default('/var/log/bdii/bdii-update.log') }}

# Path to the PID file for the BDII update process.
BDII_PID_FILE={{ pid_file | default('/run/bdii/bdii-update.pid') }}

# Verbosity level for logging (e.g., DEBUG, INFO, ERROR).
BDII_LOG_LEVEL={{ log_level | default('ERROR') }}

# Directory containing LDIF files used by GIP updates.
BDII_LDIF_DIR={{ ldif_dir | default('/var/lib/bdii/gip/ldif') }}

# Directory with GIP provider scripts.
BDII_PROVIDER_DIR={{ provider_dir | default('/var/lib/bdii/gip/provider') }}

# Directory with GIP plugin scripts.
BDII_PLUGIN_DIR={{ plugin_dir | default('/var/lib/bdii/gip/plugin') }}

# LDAP port for incoming queries (standard BDII port is 2170).
BDII_PORT={{ port | default(2170) }}

# Time in seconds to wait after an update cycle completes before allowing the next update.
BDII_BREATHE_TIME={{ breathe_time | default(120) }}

# Read timeout in seconds for LDAP connections.
BDII_READ_TIMEOUT={{ read_timeout | default(300) }}

# Maximum size of the archive directory in MB. 0 means no limit.
BDII_ARCHIVE_SIZE={{ archive_size | default(0) }}

# Delay in seconds before deleting old archive files.
BDII_DELETE_DELAY={{ delete_delay | default(0) }}

# System user under which the BDII service runs.
BDII_USER={{ user | default('openldap') }}

# Directory where BDII stores its Berkeley DB files.
BDII_VAR_DIR={{ database_dir | default('/var/lib/bdii') }}