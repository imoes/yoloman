{# Main configuration file for BDII (Berkeley Database Information Index) #}

{# Hostname or IP address the BDII service will bind to #}
global:Host = {{ host }}

{# Port on which the BDII service listens for LDAP queries (standard: 2170) #}
global:Port = {{ port }}

{# Directory where BDII stores its database files (must be writable by the bdii user) #}
global:DatabaseDir = {{ database_dir }}

{# Directory for temporary files and logs #}
global:TmpDir = {{ tmp_dir }}

{# Maximum number of concurrent client connections #}
global:MaxConnections = {{ max_connections }}

{# Number of worker threads for processing requests #}
global:Threads = {{ threads }}

{# Enable or disable GIP (Grid Information Provider) updates from local grid services #}
global:GIPEnable = {{ gip_enable | lower }}

{# Interval (in seconds) between GIP updates (0 disables periodic updates) #}
global:GIPUpdateInterval = {{ gip_update_interval }}

{# List of additional configuration files or scripts to include (space-separated paths) #}
global:Include = {{ include_files | join(' ') }}

{# Log level: 0=quiet, 1=error, 2=warn, 3=info, 4=debug #}
global:LogLevel = {{ log_level }}

{# LDAP suffix for the BDII root DSE (typically based on site name) #}
global:Suffix = {{ suffix }}

{# Root DN for the BDII directory #}
global:RootDN = {{ root_dn }}

{# Password for the root DN (use 'none' if unauthenticated binds are allowed) #}
global:RootPW = {{ root_pw }}

{# ACL: define access control rules — format: [suffix] [who] [access] [what] #}
{% for acl in acls %}acl: {{ acl }}
{% endfor %}

{# Backend database type — 'bdb' for Berkeley DB (default), 'hdb' for hierarchical BDB #}
global:Backend = {{ backend }}

{# Enable or disable SSL/TLS for secure connections (requires valid certificates) #}
global:TLSEnable = {{ tls_enable | lower }}

{# Path to the server certificate for TLS #}
global:TLSCertificateFile = {{ tls_cert_file }}

{# Path to the server private key for TLS #}
global:TLSCertificateKeyFile = {{ tls_cert_key_file }}

{# Path to CA certificate bundle for client verification (optional) #}
global:TLSCACertificateFile = {{ tls_ca_cert_file }}

{# List of additional schemas to load (e.g., 'glue2.ldif') #}
{% for schema in schemas %}schema: {{ schema }}
{% endfor %}
