{
  "host": "0.0.0.0",
  "port": 2170,
  "database_dir": "/var/lib/bdii",
  "tmp_dir": "/var/lib/bdii/tmp",
  "max_connections": 100,
  "threads": 8,
  "gip_enable": true,
  "gip_update_interval": 300,
  "include_files": [],
  "log_level": 3,
  "suffix": "Mds-Vo-name=EGI,O=Grid",
  "root_dn": "cn=Manager,Mds-Vo-name=EGI,O=Grid",
  "root_pw": "CHANGEME_strong_password_here",
  "acls": [
    "access to attrs=userPassword,shadowLastChange by dn.regex,\"cn=Manager,.\" write by anonymous auth by self write by * none",
    "access to * by dn.regex,\"cn=Manager,.\" write by * read"
  ],
  "backend": "bdb",
  "tls_enable": false,
  "tls_cert_file": "/etc/bdii/certs/bdii.crt",
  "tls_cert_key_file": "/etc/bdii/certs/bdii.key",
  "tls_ca_cert_file": "/etc/bdii/certs/ca-bundle.crt",
  "schemas": [
    "core.ldif",
    "cosine.ldif",
    "nis.ldif",
    "inetorgperson.ldif",
    "glue.ldif"
  ]
}
