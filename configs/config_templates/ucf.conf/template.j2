#
# This file is a POSIX shell snippet, and is sourced by the
# ucf script for configuration.
#

# Debugging information: The default value is 0 (no debugging
# information is printed). To change the default behavior, uncomment
# the following line and set the value to 1.
#
{% if DEBUG is defined and DEBUG is not none and (DEBUG is number or DEBUG is boolean or DEBUG | length > 0) %}DEBUG={{ DEBUG }}
{% else %}# DEBUG=0
{% endif %}
# Verbosity: The default value is 0 (quiet). To change the default
# behavior, uncomment the following line and set the value to 1.
#
{% if VERBOSE is defined and VERBOSE is not none and (VERBOSE is number or VERBOSE is boolean or VERBOSE | length > 0) %}VERBOSE={{ VERBOSE }}
{% else %}# VERBOSE=0
{% endif %}

# The src directory. This is the directory where the historical
# md5sums for a file are looked for.  Specifically, the historical
# md5sums are looked for in the subdirectory ${filename}.md5sum.d/
#
{% if conf_source_dir is defined and conf_source_dir is not none and (conf_source_dir is number or conf_source_dir is boolean or conf_source_dir | length > 0) %}conf_source_dir={{ conf_source_dir }}
{% else %}# conf_source_dir=/some/path/
{% endif %}
# Force the installed file to be retained. The default is have this
# variable unset, which makes the script ask in case of doubt. To
# change the default behavior, uncomment the following line and set
# the value to YES
#
{% if conf_force_conffold is defined and conf_force_conffold is not none and (conf_force_conffold is number or conf_force_conffold is boolean or conf_force_conffold | length > 0) %}conf_force_conffold={{ conf_force_conffold }}
{% else %}# conf_force_conffold=YES
{% endif %}
# Force the installed file to be overridden. The default is have this
# variable unset, which makes the script ask in case of doubt. To
# change the default behavior, uncomment the following line and set
# the value to YES
#
{% if conf_force_conffnew is defined and conf_force_conffnew is not none and (conf_force_conffnew is number or conf_force_conffnew is boolean or conf_force_conffnew | length > 0) %}conf_force_conffnew={{ conf_force_conffnew }}
{% else %}# conf_force_conffnew=YES
{% endif %}
# Please note that only one of conf_force_conffold and
# conf_force_conffnew should be set.
