#
# ucf.conf - Configuration for ucf (Update Configuration Files)
# This file is sourced as a POSIX shell snippet by the ucf script.
# It controls debugging, verbosity, and conffile handling behavior.
#

# Enable debugging output.
# 1 = enabled, 0 = disabled.
# DEBUG={{ DEBUG | default(0) }}

# Enable verbose user output.
# 1 = enabled, 0 = quiet.
# VERBOSE={{ VERBOSE | default(0) }}

# Directory containing historical .md5sum files.
# Currently unused in shipped defaults, but allows explicit path specification.
# conf_source_dir={{ conf_source_dir | default('') }}

# Force retaining old conffile without user prompt.
# Set to 'true' to enable.
# conf_force_conffold={{ conf_force_conffold | default('') }}

# Force replacing old conffile with new without user prompt.
# Set to 'true' to enable.
# conf_force_conffnew={{ conf_force_conffnew | default('') }}

# Note: Only one of conf_force_conffold and conf_force_conffnew should be set.