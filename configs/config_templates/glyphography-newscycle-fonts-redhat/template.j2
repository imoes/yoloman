<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!--
    Alias the specified font family as the default sans-serif font.
    This ensures that applications requesting 'sans-serif' will use the
    specified font family instead of the system default.
  -->
  <alias>
    <family>sans-serif</family>
    <default>
      <!--
        The font family name to alias as the default sans-serif font.
        Default: 'News Cycle'
      -->
      <family>{{ (sans_family | default('News Cycle')) | string }}</family>
    </default>
  </alias>
  <!--
    Create a reciprocal alias so the font family also points to sans-serif.
    This maintains consistency in font substitution logic.
  -->
  <alias>
    <family>{{ (sans_family | default('News Cycle')) | string }}</family>
    <default>
      <family>sans-serif</family>
    </default>
  </alias>
</fontconfig>
