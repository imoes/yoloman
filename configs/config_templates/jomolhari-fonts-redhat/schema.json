{
  "font_family": {
    "type": "string",
    "default": "Jomolhari",
    "description": "The font family name to use for Tibetan scripts."
  },
  "default_font_family": {
    "type": "string",
    "default": "serif",
    "description": "The default font family to alias or match against."
  },
  "locale_bo_cn": {
    "type": "string",
    "default": "bo-cn",
    "description": "Locale tag for Tibetan (China)."
  },
  "locale_bo_in": {
    "type": "string",
    "default": "bo-in",
    "description": "Locale tag for Tibetan (India)."
  },
  "locale_bo": {
    "type": "string",
    "default": "bo",
    "description": "Locale tag for general Tibetan."
  },
  "locale_dz_bt": {
    "type": "string",
    "default": "dz-bt",
    "description": "Locale tag for Dzongkha (Bhutan)."
  },
  "locale_dz": {
    "type": "string",
    "default": "dz",
    "description": "Locale tag for general Dzongkha."
  },
  "autohint": {
    "type": "string",
    "default": "true",
    "description": "Whether to enable autohinting for the font."
  }
}
