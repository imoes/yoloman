{
  "ftp_user": "anonymous",
  "ftp_pass": "ftp-admin@your.domain.name",
  "http_proxy": "proxy.your.net.com",
  "ftp_passive": "yes",
  "ftp_force_mtime": "yes",
  "ftp_stats": "yes",
  "log_mask": "main=6",
  "unlink": "no",
  "temp_directory": "/tmp",
  "lock_directory": "/tmp",
  "ftpmirror_bin": "/usr/sbin/ftpmirror",
  "log_file": "/var/log/ftpmirror/ftpmirror.daily",
  "savelog_bin": "/usr/bin/savelog",
  "config_dir": "/etc/ftpmirror"
}
