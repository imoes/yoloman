{
  "ftp_user": {
    "type": "string",
    "default": null,
    "description": "Login name for ftp session"
  },
  "ftp_pass": {
    "type": "string",
    "default": null,
    "description": "Password for ftp session, typically an email address"
  },
  "http_proxy": {
    "type": "string",
    "default": null,
    "description": "HTTP proxy to use if no listing method required"
  },
  "ftp_passive": {
    "type": "string",
    "default": "yes",
    "description": "Use passive mode for data transfer"
  },
  "ftp_force_mtime": {
    "type": "bool",
    "default": null,
    "description": "Force getting mtime via MDTM ftp command"
  },
  "ftp_stats": {
    "type": "bool",
    "default": null,
    "description": "See ftp statistics report"
  },
  "log_mask": {
    "type": "string",
    "default": null,
    "description": "Log mask to list up all available files"
  },
  "unlink": {
    "type": "string",
    "default": null,
    "description": "Whether to unlink no file",
    "enum": [
      "yes",
      "no"
    ]
  },
  "temp_directory": {
    "type": "string",
    "default": null,
    "description": "Temporary directory used for operations"
  },
  "lock_directory": {
    "type": "string",
    "default": null,
    "description": "Directory for lock files (defaults to temp-directory)"
  },
  "ftpmirror_bin": {
    "type": "string",
    "default": "/usr/sbin/ftpmirror",
    "description": "Path to the ftpmirror binary"
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/ftpmirror/ftpmirror.daily",
    "description": "Path to the daily log file"
  },
  "savelog_bin": {
    "type": "string",
    "default": "/usr/bin/savelog",
    "description": "Path to the savelog binary"
  },
  "config_dir": {
    "type": "string",
    "default": "/etc/ftpmirror",
    "description": "Directory containing ftpmirror configuration files"
  }
}
