{
  "config_dir": {
    "type": "string",
    "default": "/etc/ftpmirror",
    "description": "Directory containing ftpmirror configuration files"
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/ftpmirror/ftpmirror.daily",
    "description": "Path to the daily log file"
  },
  "ftpmirror_bin": {
    "type": "string",
    "default": "/usr/sbin/ftpmirror",
    "description": "Path to the ftpmirror binary"
  },
  "savelog_bin": {
    "type": "string",
    "default": "/usr/bin/savelog",
    "description": "Path to the savelog binary"
  }
}
