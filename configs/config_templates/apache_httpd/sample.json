{
  "server_root": "/etc/apache2",
  "runtime_dir": "/run/apache2",
  "listen_addresses": [
    {
      "address": "0.0.0.0",
      "port": 80
    },
    {
      "address": "0.0.0.0",
      "port": 443
    }
  ],
  "worker_user": "www-data",
  "worker_group": "www-data",
  "server_admin": "webmaster@example.com",
  "server_name": "www.example.com",
  "timeout": 60,
  "keepalive": true,
  "max_keepalive_requests": 100,
  "keepalive_timeout": 5,
  "error_log_path": "/var/log/apache2/error.log",
  "log_level": "warn",
  "modules_to_load": [
    {
      "name": "mpm_event",
      "path": "/usr/lib/apache2/modules/mod_mpm_event.so"
    },
    {
      "name": "ssl",
      "path": "/usr/lib/apache2/modules/mod_ssl.so"
    },
    {
      "name": "rewrite",
      "path": "/usr/lib/apache2/modules/mod_rewrite.so"
    }
  ],
  "included_configs": [
    {
      "path": "/etc/apache2/mods-enabled/*.conf",
      "enabled": true
    },
    {
      "path": "/etc/apache2/conf-enabled/*.conf",
      "enabled": true
    },
    {
      "path": "/etc/apache2/sites-enabled/*.conf",
      "enabled": true
    }
  ],
  "docroot": "/var/www/html",
  "docroot_options": [
    "FollowSymLinks",
    "Indexes"
  ],
  "allow_override": "All",
  "directory_index": [
    "index.html",
    "index.php"
  ],
  "mime_types_config": "/etc/mime.types",
  "mpm": "event",
  "mpm_start_servers": 3,
  "mpm_min_spare_servers": 3,
  "mpm_max_spare_servers": 10,
  "mpm_max_request_workers": 150,
  "mpm_max_connections_per_child": 0,
  "server_status_enabled": true,
  "server_status_allowed_hosts": [
    "localhost",
    "127.0.0.1",
    "192.168.1.0/24"
  ],
  "server_info_enabled": false,
  "server_info_allowed_hosts": [
    "localhost",
    "127.0.0.1"
  ],
  "default_vhost_enabled": true,
  "default_vhost_port": 80,
  "vhost_error_log": "/var/log/apache2/www.example.com-error.log",
  "vhost_access_log": "/var/log/apache2/www.example.com-access.log",
  "include_default_modules": false
}
