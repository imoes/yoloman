{
  "dest_dir": "/var/backups/vbackup",
  "log_level": 6,
  "modules": [
    {
      "priority": 10,
      "name": "dpkg",
      "type": "dpkg",
      "filename": "dpkg.lst"
    },
    {
      "priority": 20,
      "name": "etc",
      "type": "tar",
      "source": "/etc",
      "excludes": [
        "cache",
        "tmp"
      ]
    },
    {
      "priority": 30,
      "name": "home",
      "type": "tar",
      "source": "/home",
      "excludes": []
    }
  ]
}
