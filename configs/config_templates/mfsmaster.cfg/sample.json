{
  "master_host": "0.0.0.0",
  "master_port": 9420,
  "metalogger_port": 9419,
  "worker_port": 9422,
  "data_path": "/var/lib/mfs",
  "worker_threads": 4,
  "max_open_files": 65536,
  "chunkserver_reconnect_interval": 30,
  "access_log": false,
  "transaction_log": true,
  "statistics_log": false,
  "read_only": false,
  "quota_support": true,
  "exports_interval": 3600,
  "chunkservers": [
    {
      "hostname": "chunk01.storage.local",
      "id": 1
    },
    {
      "hostname": "chunk02.storage.local",
      "id": 2
    },
    {
      "hostname": "chunk03.storage.local",
      "id": 3
    }
  ],
  "allowed_hosts": [
    "*.internal.example.com",
    "192.168.100.0/24"
  ],
  "allowed_metalogger_hosts": [],
  "allowed_chunkserver_hosts": [
    "chunk*.storage.local"
  ]
}
