# Kytos Utilities Configuration
# This file controls the behavior of Kytos utility scripts and helper services.
# It is managed by Ansible; do not edit manually.

# The base URL of the Kytos API endpoint.
# Used by utilities to connect to the Kytos controller's REST API.
kytos_api_url: {{ kytos_api_url | default('http://localhost:8181') }}

# Timeout in seconds for HTTP requests made by the utility.
# If the Kytos API does not respond within this window, requests are aborted.
request_timeout: {{ request_timeout | default(30) }}

# Whether to enable verbose debug logging.
# When true, the utilities emit detailed logs for troubleshooting.
verbose_logging: {{ verbose_logging | default(False) | lower }}

# Default language code (ISO 639-1) for translations.
# This language is used when no user preference is set and no fallback is found.
default_language: {{ default_language | default('en') }}

# List of supported language codes for translation features.
# Only languages in this list are available for selection or fallback.
supported_languages: {{ supported_languages | default(['en', 'es', 'fr', 'de', 'pt']) | tojson }}