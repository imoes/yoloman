# Jetring GPG Keyring Configuration
#
# This file configures Jetring, a tool for managing GPG keyring changesets.
# It defines where source data lives, which keyring is used for signing,
# and the GPG home directory for operations.

# The directory containing the jetring changesets and index file.
# (default: /etc/keys)
source_dir: {{ (values | default({})).source_dir | default('/etc/keys') }}

# Path to the GPG keyring file used to sign the index file.
# If not set or empty, signing is disabled.
# (default: /etc/gnupg/pubring.kbx)
sign_keyring: {{ (values | default({})).sign_keyring | default('/etc/gnupg/pubring.kbx') }}

# The GPG home directory to use for GPG operations.
# (default: /root/.gnupg)
gpg_home: {{ (values | default({})).gpg_home | default('/root/.gnupg') }}