{
  "sftp_listen_port": 22,
  "sftp_bind_address": "0.0.0.0",
  "password_auth_enabled": false,
  "sftp_chroot_dir": "/sftp",
  "sftp_only_users": [
    "sftp_user1",
    "sftp_user2"
  ],
  "sftp_client_alive_interval": 300,
  "sftp_client_alive_count_max": 3,
  "sftp_log_level": "VERBOSE",
  "sftp_max_sessions": 5,
  "sftp_login_grace_time": 60,
  "ssh_allow_groups": [
    "sftpusers"
  ]
}
