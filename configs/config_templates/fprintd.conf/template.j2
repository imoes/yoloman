[main]
# The maximum number of devices that can be enrolled simultaneously
# (per user session); set to 0 for unlimited
MaxDevices={{ max_devices }}

# Enable or disable verbose logging (true/false)
LogLevel={{ log_level }}

# Path to the directory where fingerprint data is stored
# (per-user storage; relative to $XDG_RUNTIME_DIR or absolute)
DataStore={{ data_store }}

# List of enabled drivers (in order of preference); empty means auto-select
{% for driver in drivers %}Driver={{ driver }}
{% endfor %}

# Timeout (in seconds) for device enumeration
Timeout={{ timeout }}
