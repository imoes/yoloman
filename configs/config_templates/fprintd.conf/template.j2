[main]
# Maximum number of fingerprint devices that can be enrolled per user at the same time.
# Set to 0 for unlimited.
MaxDevices={{ max_devices | default(1) }}

# Absolute or relative path for storing fingerprint templates.
# If empty, uses the default XDG-based location.
DataStore={{ data_store | default('') }}

# Ordered list of fingerprint drivers to use.
# Leave empty to let fprintd auto-select drivers.
{% for driver in drivers | default([]) %}
Driver={{ driver }}{% endfor %}