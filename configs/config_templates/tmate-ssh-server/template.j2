# tmate-ssh-server configuration
# This template configures the command-line options for the tmate-ssh-server service.

# Path to the directory containing SSH host keys.
# See: https://github.com/tmate-io/tmate-ssh-server
# Default: /etc/tmate-ssh-server/keys
OPTS="-k {{ keys_directory | default('/etc/tmate-ssh-server/keys -p 10022') }}"

# Port number on which the tmate-ssh-server listens for connections.
# Default: 10022
OPTS="-p {{ listen_port | default(10022) }}"
