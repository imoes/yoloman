# tmate-ssh-server configuration
# Generated by Ansible Jinja2 template.
#
# This configuration passes command-line arguments to the tmate-ssh-server daemon.
# See 'tmate-ssh-server --help' for full documentation of available options.

# Path to the directory containing SSH host keys for authentication.
# These keys are used to identify the server to connecting clients.
# Default: /etc/tmate-ssh-server/keys
OPTS="-k {{ keys_directory | default('/etc/tmate-ssh-server/keys') }}"

# Port number on which the tmate-ssh-server listens for incoming TCP connections.
# Default: 10022
OPTS="{{ '-p ' ~ opts_port | default(omit) | default(10022) }}"

# NOTE: The original template concatenated both flags into a single OPTS variable.
# If additional options are required in the future, they should be appended to this string
# or managed via a separate variable that is joined here.
# Example for adding extra options: OPTS="-k {{ keys_directory | default('/etc/tmate-ssh-server/keys') }} -p {{ listen_port | default(10022) }} {{ extra_opts | default('') }}"