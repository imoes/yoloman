{
  "work_dir": "/var/www/mrtg",
  "language": "en",
  "log_dir": "/var/log/mrtg",
  "snmp_interval": "5",
  "snmp_timeout": 300,
  "snmp_default_authname": "public",
  "snmp_default_version": "2c",
  "enable_ipv6": false,
  "mail_alert_enabled": true,
  "mail_alert_recipient": "noc@example.com",
  "html_title": "Network Traffic Monitor",
  "html_directory": "/var/www/mrtg",
  "png_directory": "/var/www/mrtg",
  "html_background_color": "#F8F9FA",
  "threshold_enabled": false,
  "targets": [
    {
      "name": "core_router_ge1",
      "description": "Core router ge-1/0/0 (WAN uplink)",
      "host": "10.0.0.1",
      "oid_in": "1.3.6.1.2.1.2.2.1.10.1",
      "oid_out": "1.3.6.1.2.1.2.2.1.16.1",
      "snmp_community": "public",
      "title": "Core Router \u2014 ge-1/0/0",
      "page_top": "<h2>WAN Uplink (10 Gbps)</h2>",
      "max_bytes": 1250000000,
      "with_peak": true,
      "ylegend": "Bytes/sec",
      "short_legend": "bps",
      "legend_in": "In",
      "legend_out": "Out",
      "legend_1": "Current",
      "legend_2": "5-min avg",
      "threshold_in": 1100000000,
      "threshold_out": 1100000000,
      "color_in": "#2E86C1",
      "color_out": "#E74C3C",
      "color_background": "#FFFFFF",
      "color_text": "#333333",
      "mail_alert_enabled": true,
      "mail_alert_recipient": "noc@example.com"
    },
    {
      "name": "switch1_gi0_1",
      "description": "Access switch gi0/1 \u2014 Server rack",
      "host": "10.0.0.2",
      "oid_in": "1.3.6.1.2.1.2.2.1.10.2",
      "oid_out": "1.3.6.1.2.1.2.2.1.16.2",
      "title": "Access Switch \u2014 gi0/1",
      "page_top": "<h2>Server Access Port (1 Gbps)</h2>",
      "max_bytes": 125000000,
      "with_peak": true,
      "ylegend": "Bytes/sec",
      "short_legend": "bps",
      "legend_in": "In",
      "legend_out": "Out",
      "legend_1": "Current",
      "legend_2": "5-min avg",
      "html_filename": "switch1_gi0_1.html",
      "color_in": "#27AE60",
      "color_out": "#F39C12",
      "add_options": {
        "XSize": "480",
        "YSize": "160"
      }
    }
  ]
}
