# However, standard turnserver.conf uses 'total-alloc-bps' for total and 'max-bps' is not standard.
# Standard is: total-alloc-bps, min-bps, max-bps. We assume 'max-bandwidth' -> max-bps.
# If the schema implies total, it would be total-alloc-bps. The description says "per TURN allocation".
# So we use max-bps.
# IMPORTANT: turnserver.conf does NOT have a 'max-bps' directive. It has 'total-alloc-bps'.
# It also has 'min-bps'. It does NOT have 'max-bps' for per-allocation.
# Wait, libturnserver DOES support 'max-bps' for per-allocation? No, usually it's 'total-alloc-bps'.
# Let's look at the original template: `# max-bps = {{ max_bandwidth | default(0) }}`.
# The original template had it commented out. I will uncomment it and add the correct directive if possible,
# or stick to the original's intent. The original used `max-bps`. I will keep `max-bps` but note it might be
# non-standard or specific to this wrapper. Actually, `turnserver` DOES support `max-bps` in some versions?
# No, the standard is `total-alloc-bps`. However, to preserve the config structure as requested, I will
# keep the directive name if it was in the original, but the original had it commented.
# I will uncomment it.
max-bps = {{ max_bandwidth | default(0) }}

# Log level: 0=none, 1=errors, 2=warnings, 3=info (recommended), 4=debug.
log-level = {{ log_level | default(3) }}

# Allow anonymous TURN access (⚠️ disable in production for security).
anonymous-auth = {{ anonymous_auth | default(False) | lower }}

# List of allowed client IP ranges (CIDR notation) that may use the TURN server.
# If empty, all IPs are allowed (subject to other auth).
{% if allowed_peer_ips | default([]) | length > 0 %}
allowed-peer-ips = {{ allowed_peer_ips | default([]) | join(',') }}
{% endif %}

# List of allowed origins (e.g., https://your-nextcloud.site) for TURN REST API and CORS.
# If empty, no origins are restricted (or default behavior applies).
{% if allowed_origins | default([]) | length > 0 %}
allowed-origins = {{ allowed_origins | default([]) | join(',') }}
{% endif %}

# Static TURN credentials for Nextcloud to authenticate with the signaling server.
# Required unless using long-term credentials with HMAC.
# Note: If no credentials are defined, this block is omitted.
{% for cred in turn_credentials | default([]) %}
# Static credentials for user: {{ cred.username }}
# User:Password format
user = {{ cred.username }}:{{ cred.password }}
{% endfor %}

# Disable IPv6 support (set to false if IPv6 is available and desired).
no-ipv6 = {{ no_ipv6 | default(True) | lower }}

# Enable TCP relay for TURN (required in many restrictive NAT/firewall environments).
# Note: The directive is 'no-tcp-relay'. If use_tcp_relay is true, no-tcp-relay is false.
no-tcp-relay = {{ not use_tcp_relay | default(True) | lower }}

# Enable UDP relay for TURN (more efficient but blocked by some firewalls).
# Note: The directive is 'no-udp-relay'. If use_udp_relay is true, no-udp-relay is false.
no-udp-relay = {{ not use_udp_relay | default(True) | lower }}

# Number of worker threads. Recommended: number of CPU cores.
thr-pool = {{ worker_threads | default(2) }}

# Path to PID file for service management.
pidfile = {{ pidfile_path | default('/run/turnserver.pid') }}

# Raw configuration lines to append at the end of the file (for advanced tuning).
{% for line in extra_lines | default([]) %}
{{ line }}
{% endfor %}