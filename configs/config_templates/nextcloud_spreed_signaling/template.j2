# Turnserver configuration for Nextcloud Talk Signaling Server
# IP address of the network interface(s) to bind to (e.g., 0.0.0.0 for all, or specific IP).
listen = {{ listen_ip | default('0.0.0.0') }}

# TCP port for STUN/TURN connections.
port = {{ port | default(8080) }}

# TLS port for secure STUN/TURN connections.
tls-port = {{ tls_port | default(8443) }}

# Realm for authentication (typically your Nextcloud domain).
realm = {{ realm | default('nextcloud.local') }}

# Path to TLS certificate (PEM format).
cert = {{ cert_path | default('/etc/ssl/turn/cert.pem') }}

# Path to TLS private key (PEM format).
key = {{ key_path | default('/etc/ssl/turn/key.pem') }}

# Enable TURN (true/false).
use-turn = {{ use_turn | default(True) | lower }}

# Enable STUN (true/false).
use-stun = {{ use_stun | default(True) | lower }}

# Maximum bandwidth (bytes/sec) per TURN allocation. Set to 0 for unlimited.
