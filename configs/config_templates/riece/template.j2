;; -*-emacs-lisp--;
;;
;; Emacs startup file for the Debian riece package
;;
;; Originally contributed by Nils Naumann <naumann@unileoben.ac.at>
;; Modified by Dirk Eddelbuettel <edd@debian.com>
;; Adapted for dh-make by Jim Van Zandt <jrv@vanzandt.mv.com>
;;
;; Self-documenting enrichment:
;; This template configures the Riece IRC client integration within Emacs.
;; It ensures the data directory is present and adds the necessary load-path
;; and autoloads for the 'riece' package.

;; The riece package follows the Debian/GNU Linux 'emacsen' policy and
;; byte-compiles its elisp files for each 'emacs flavor' (emacs19,
;; xemacs19, emacs20, xemacs20...).  The compiled code is then
;; installed in a subdirectory of the respective site-lisp directory.
;; We have to add this to the load-path:

;; Check if the data directory exists. If not, it implies the package
;; was removed but not purged, or the directory is missing.
;; Variable: riece_data_directory
;; Default: '/usr/share/emacs/site-lisp/riece'
;; Description: The directory where riece data files are stored and loaded from.
(if (not (file-exists-p "{{ riece_data_directory | default('/usr/share/emacs/site-lisp/riece') }}"))
    (message "Package riece removed but not purged.  Skipping setup.")
  (debian-pkg-add-load-path-item
   (concat "/usr/share/" (symbol-name debian-emacs-flavor)
	   "/site-lisp/riece"))

  ;; Autoload the riece function so it is available without loading the full package immediately.
  (autoload 'riece "riece" nil t)

  ;; Set the riece data directory variable.
  ;; Variable: riece-data-directory
  ;; Default: '/usr/share/emacs/site-lisp/riece'
  (setq riece-data-directory "{{ riece_data_directory | default('/usr/share/emacs/site-lisp/riece') }}"))
