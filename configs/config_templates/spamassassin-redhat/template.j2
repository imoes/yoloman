# SpamAssassin User Preferences Configuration Template
#
# This file defines global settings for SpamAssassin.
# Individual users can override these settings in their ~/.spamassassin/user_prefs.cf file.
# See spamassassin(1) for detailed documentation on these directives.

# -----------------------------------------------------------------------------
# Threshold Configuration
# -----------------------------------------------------------------------------

# The score threshold at which an email is considered spam.
# Emails with a score equal to or greater than this value will be tagged as spam.
# Default: 5
required_hits {{ required_hits | default('5') }}

# -----------------------------------------------------------------------------
# Safety and Quarantine Behavior
# -----------------------------------------------------------------------------

# Whether to rewrite headers or quarantine emails (0=rewrite, 1=quarantine/report).
# If set to 1, SpamAssassin will attempt to quarantine the message or report it
# as spam using the configured method. If set to 0, it simply rewrites headers.
# Default: 0
report_safe {{ report_safe | default('0') }}

# -----------------------------------------------------------------------------
# Subject Header Rewriting
# -----------------------------------------------------------------------------

# The text to prepend to the subject line of spam emails.
# This helps users visually identify potential spam in their inbox.
# Default: [SPAM]
rewrite_header Subject {{ rewrite_header_subject | default('[SPAM]') }}
