{
  "qstat_path": "/usr/bin/qstat",
  "qsub_path": "/usr/bin/qsub",
  "qdel_path": "/usr/bin/qdel",
  "qacct_path": "/usr/bin/qacct",
  "qhost_path": "",
  "qrun_path": "",
  "max_jobs_per_query": 500,
  "poll_interval": 60,
  "verbose": false,
  "allowed_queues": [
    "batch",
    "express"
  ],
  "default_queue": "batch",
  "default_resources": "walltime=02:00:00,mem=2gb,nodes=1:ppn=2",
  "prolog_path": "/etc/globus/pbs-prolog.sh",
  "epilog_path": "/etc/globus/pbs-epilog.sh",
  "env_vars": [
    "HOME",
    "PATH",
    "LD_LIBRARY_PATH",
    "TMPDIR"
  ],
  "attr_mappings": [
    {
      "name": "map_walltime",
      "pbs_attr": "Resource_List.walltime",
      "globus_attr": "walltime_seconds"
    },
    {
      "name": "map_nodes",
      "pbs_attr": "Resource_List.nodes",
      "globus_attr": "node_count"
    }
  ]
}
