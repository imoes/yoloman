{
  "servers": [
    {
      "host": "0.pool.ntp.org",
      "port": 123
    },
    {
      "host": "1.pool.ntp.org",
      "port": 123
    },
    {
      "host": "time.google.com",
      "port": 123,
      "key_id": 1
    }
  ],
  "interface": "eth0",
  "logging": {
    "verbose": false,
    "normal": true,
    "quiet": false,
    "logfile": "/var/log/sntp.log"
  },
  "offset_limit": 2.0,
  "max_samples": 6,
  "strict": true,
  "leap_smear": false,
  "trusted_keys": [
    1
  ],
  "request_key_id": 1,
  "keys_file": "/etc/ntpsec/ntp.keys",
  "timeout": 4,
  "poll_interval": 600,
  "burst": true,
  "initial_delay": 5
}
