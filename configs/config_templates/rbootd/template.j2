#
# Top configuration file for rbootd
#
# This file configures the remote boot daemon (rbootd), which handles
# network booting (RARP, BootP, and DHCP-like requests) for clients.
# It is a lightweight service typically used in PXE environments.
#

#
# Network interface to listen on for boot requests.
# Specify a specific interface name (e.g., 'eth0') to bind only to that interface,
# or '0.0.0.0' to listen on all available network interfaces.
#
# Source: listen_interface
# Default: eth0
#
IFACE="{{ listen_interface | default('eth0') }}"