# Canna-Shion Configuration Template
# This template generates configuration entries for the Canna-Shion system.
# It defines paths and identifiers for various modules (basho, keisan, pub, scien, sup).
# Each module generates two types of entries: .cbd and .cld.

# --- Basho Module Configuration ---
# Path or identifier for basho.mwd (typically a module or config file reference)
{{ basho_mwd | default('basho.mwd') }}.cbd({{ basho_mwd | default('basho.mwd') }})
{{ basho_mwd | default('basho.mwd') }}.cld({{ basho_mwd | default('basho.mwd') }})

