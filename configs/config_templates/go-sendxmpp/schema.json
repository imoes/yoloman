{
  "username": {
    "type": "string",
    "default": "",
    "description": "XMPP account JID (required, e.g., user@example.org)"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Password for XMPP account"
  },
  "jserver": {
    "type": "string",
    "default": "",
    "description": "XMPP server address (optional; overrides server discovery)"
  },
  "timeout": {
    "type": "number",
    "default": 10,
    "description": "Connection timeout in seconds"
  },
  "tls": {
    "type": "bool",
    "default": true,
    "description": "Use direct TLS (default: true)"
  },
  "tls_version": {
    "type": "number",
    "default": 12,
    "description": "Minimal TLS version (10=TLSv1.0, 11=TLSv1.1, 12=TLSv1.2, 13=TLSv1.3)"
  },
  "tls_verify": {
    "type": "bool",
    "default": true,
    "description": "Verify TLS certificates (default: true; set to false to skip verification)"
  },
  "allow_plain": {
    "type": "bool",
    "default": false,
    "description": "Allow PLAIN authentication (not recommended unless needed)"
  },
  "no_sasl_upgrade": {
    "type": "bool",
    "default": false,
    "description": "Disable XEP-0480: SASL Upgrade Tasks"
  },
  "scram_mech_pinning": {
    "type": "string",
    "default": "",
    "description": "Enforce a specific SCRAM mechanism (e.g., 'SCRAM-SHA-256-PLUS')",
    "enum": [
      "SCRAM-SHA-1",
      "SCRAM-SHA-1-PLUS",
      "SCRAM-SHA-256",
      "SCRAM-SHA-256-PLUS",
      "SCRAM-SHA-512",
      "SCRAM-SHA-512-PLUS"
    ]
  },
  "fast_off": {
    "type": "bool",
    "default": false,
    "description": "Disable XEP-0484: Fast Authentication Streamlining Tokens"
  },
  "fast_invalidate": {
    "type": "bool",
    "default": false,
    "description": "Invalidate current FAST token"
  },
  "ssdp_off": {
    "type": "bool",
    "default": false,
    "description": "Disable XEP-0474: SASL SCRAM Downgrade Protection"
  },
  "chatroom": {
    "type": "string",
    "default": "",
    "description": "MUC JID to send messages to (e.g., room@chat.example.org)"
  },
  "muc_password": {
    "type": "string",
    "default": "",
    "description": "Password for password-protected MUC"
  },
  "alias": {
    "type": "string",
    "default": "",
    "description": "Nickname/alias for MUC"
  },
  "ox": {
    "type": "bool",
    "default": false,
    "description": "Enable OpenPGP for XMPP encryption (experimental, 1:1 only)"
  },
  "ox_genprivkey_rsa": {
    "type": "bool",
    "default": false,
    "description": "Generate RSA 4096-bit OpenPGP private key for account"
  },
  "ox_genprivkey_x25519": {
    "type": "bool",
    "default": false,
    "description": "Generate X25519 OpenPGP private key for account"
  },
  "ox_import_privkey": {
    "type": "string",
    "default": "",
    "description": "Path to existing private OpenPGP key to import"
  },
  "ox_passphrase": {
    "type": "string",
    "default": "",
    "description": "Passphrase to protect the OpenPGP private key"
  },
  "ox_delete_nodes": {
    "type": "bool",
    "default": false,
    "description": "Delete existing OpenPGP pubsub nodes"
  },
  "anonymous": {
    "type": "bool",
    "default": false,
    "description": "Use anonymous authentication"
  },
  "suppress_root_warning": {
    "type": "bool",
    "default": false,
    "description": "Suppress warning when running as root"
  }
}
