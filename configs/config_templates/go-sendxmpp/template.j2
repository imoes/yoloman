# =============================================================================
# go-sendxmpp Configuration File
# Format: key = value (one per line)
# Lines starting with '#' are comments
#
# This file is auto-generated by Ansible. Do not edit manually.
# Each directive is accompanied by its schema description as a comment.
# =============================================================================

# XMPP account JID (required, e.g., user@example.org)
username = {{ username | default('') }}

# Password for XMPP account
password = {{ password | default('') }}

# Optional XMPP server address (overrides server discovery)
{% if jserver | default('') -%}
# XMPP server address (optional; overrides server discovery)
jserver = {{ jserver | default('') }}
{% endif %}

# Connection timeout in seconds
timeout = {{ timeout | default(10) }}

# =============================================================================
# TLS settings
# =============================================================================

# Use direct TLS (default: true)
tls = {{ tls | default(True) | lower }}

# Minimal TLS version (10=TLSv1.0, 11=TLSv1.1, 12=TLSv1.2, 13=TLSv1.3)
tls_version = {{ tls_version | default(12) }}

{% if not (tls_verify | default(True)) -%}
# Verify TLS certificates (default: true; set to false to skip verification)
no_tls_verify = true
{% endif %}

# =============================================================================
# Authentication settings
# =============================================================================

{% if allow_plain | default(False) -%}
# Allow PLAIN authentication (not recommended unless needed)
allow_plain = true
{% endif %}

{% if no_sasl_upgrade | default(False) -%}
# Disable XEP-0480: SASL Upgrade Tasks
no_sasl_upgrade = true
{% endif %}

{% if scram_mech_pinning | default('') -%}
# Enforce a specific SCRAM mechanism (e.g., 'SCRAM-SHA-256-PLUS')
scram_mech_pinning = {{ scram_mech_pinning | default('') }}
{% endif %}

# =============================================================================
# Fast Authentication Streamlining (XEP-0484)
# =============================================================================

{% if fast_off | default(False) -%}
# Disable XEP-0484: Fast Authentication Streamlining Tokens
fast_off = true
{% endif %}

{% if fast_invalidate | default(False) -%}
# Invalidate current FAST token
fast_invalidate = true
{% endif %}

# =============================================================================
# SASL SCRAM Downgrade Protection (XEP-0474)
# =============================================================================

{% if ssdp_off | default(False) -%}
# Disable XEP-0474: SASL SCRAM Downgrade Protection
ssdp_off = true
{% endif %}

# =============================================================================
# Chatroom (MUC) settings
# =============================================================================

{% if chatroom | default('') -%}
# MUC JID to send messages to (e.g., room@chat.example.org)
chatroom = {{ chatroom | default('') }}
{% endif %}

{% if muc_password | default('') -%}
# Password for password-protected MUC
muc_password = {{ muc_password | default('') }}
{% endif %}

{% if alias | default('') -%}
# Nickname/alias for MUC
alias = {{ alias | default('') }}
{% endif %}

# =============================================================================
# OpenPGP for XMPP (OX) settings
# =============================================================================

{% if ox | default(False) -%}
# Enable OpenPGP for XMPP encryption (experimental, 1:1 only)
ox = true
{% endif %}

{% if ox_genprivkey_rsa | default(False) -%}
# Generate RSA 4096-bit OpenPGP private key for account
ox_genprivkey_rsa = true
{% endif %}

{% if ox_genprivkey_x25519 | default(False) -%}
# Generate X25519 OpenPGP private key for account
ox_genprivkey_x25519 = true
{% endif %}

{% if ox_import_privkey | default('') -%}
# Path to existing private OpenPGP key to import
ox_import_privkey = {{ ox_import_privkey | default('') }}
{% endif %}

{% if ox_passphrase | default('') -%}
# Passphrase to protect the OpenPGP private key
ox_passphrase = {{ ox_passphrase | default('') }}
{% endif %}

{% if ox_delete_nodes | default(False) -%}
# Delete existing OpenPGP pubsub nodes
ox_delete_nodes = true
{% endif %}

# =============================================================================
# Anonymous authentication
# =============================================================================

{% if anonymous | default(False) -%}
# Use anonymous authentication
anonymous = true
{% endif %}

# =============================================================================
# Miscellaneous
# =============================================================================

{% if suppress_root_warning | default(False) -%}
# Suppress warning when running as root
suppress_root_warning = true
{% endif %}