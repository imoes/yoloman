# Enable GSSAPI authentication mechanism
disable_plaintext_auth = yes
auth_mechanisms = plain gssapi

# GSSAPI principal and keytab configuration
# (Leave empty to use the default service principal and keytab)
# Dovecot will use the service name 'imap' and hostname from hostname setting
gssapi_hostname = {{ gssapi_hostname }}
{% if gssapi_keytab %}gssapi_keytab = {{ gssapi_keytab }}{% endif %}

# Enable GSSAPI module for authentication
disable_auth = no
# Load the GSSAPI auth module (required on some platforms)
{% if gssapi_auth_module_path %}!include_try {{ gssapi_auth_module_path }}{% endif %}

# Log GSSAPI-related messages at appropriate verbosity
log_path = {{ log_path }}
log_timestamp = "%b %d %H:%M:%S "
auth_verbose = yes

# Optional: restrict GSSAPI to trusted networks (e.g., internal LAN)
# Override per-service if needed in auth-worker or service blocks
{% if gssapi_trusted_networks %}# Trust only these networks for GSSAPI auth
{% for network in gssapi_trusted_networks %}# {{ network }}{% endfor %}{% endif %}

# Example service override — adjust if per-service GSSAPI policy is needed
{% for svc in gssapi_services %}
# Service: {{ svc.name }}
service {{ svc.name }} {
{% if svc.chroot %}  chroot = {{ svc.chroot }}{% endif %}
{% if svc.listen %}  listen = {{ svc.listen | join(', ') }}{% endif %}
{% if svc.max_processes %}  process_limit = {{ svc.max_processes }}{% endif %}
{% if svc.gssapi_enabled is defined %}  # GSSAPI per-service override
  auth_gssapi_enabled = {{ svc.gssapi_enabled | lower }}
{% endif %}
}
{% endfor %}

# Global auth service settings (shared across mechanisms)
service auth {
  unix_listener auth-userdb {
    mode = 0600
    user = {{ auth_userdb_user }}
    group = {{ auth_userdb_group }}
  }
}
