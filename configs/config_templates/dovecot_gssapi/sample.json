{
  "gssapi_hostname": "mail.example.org",
  "gssapi_keytab": "/etc/dovecot/imap.keytab",
  "log_path": "/var/log/dovecot.log",
  "auth_userdb_user": "dovecot",
  "auth_userdb_group": "dovecot",
  "gssapi_auth_module_path": "/usr/lib/dovecot/authgssapi.so",
  "gssapi_trusted_networks": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "gssapi_services": [
    {
      "name": "imap",
      "listen": [
        "127.0.0.1",
        "::1"
      ],
      "max_processes": 512,
      "gssapi_enabled": true
    },
    {
      "name": "pop3",
      "gssapi_enabled": false
    }
  ]
}
