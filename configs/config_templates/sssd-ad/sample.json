{
  "domains": [
    "example.com"
  ],
  "domains_config": [
    {
      "name": "example.com",
      "ldap_uri": "ldaps://dc1.example.com ldaps://dc2.example.com",
      "search_base": "DC=example,DC=com",
      "krb5_realm": "EXAMPLE.COM",
      "krb5_server": "dc1.example.com",
      "allow_groups": [
        "linux-admins",
        "devs"
      ],
      "cache_credentials": true,
      "entry_cache_timeout": 900,
      "ldap_referrals": false
    }
  ],
  "pam_offline_expiration": 7,
  "pam_id_disable": false
}
