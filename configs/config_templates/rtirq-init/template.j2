# /etc/sysconfig/rtirq
# /etc/default/rtirq
#
# Configuration for IRQ thread tunning,
# for realtime-preempt enabled kernels.
#
# This program is free software; you can redistribute it and/or modify it
# under the terms of the GNU General Public License version 2 or later.
#

# Space-separated list of IRQ thread service names, ordered from higher to lower priority.
# RTIRQ_NAME_LIST="snd usb i8042"
RTIRQ_NAME_LIST="{{ RTIRQ_NAME_LIST | default('snd usb i8042') }}"

# Highest priority level for RT IRQ threads.
# RTIRQ_PRIO_HIGH=90
RTIRQ_PRIO_HIGH={{ RTIRQ_PRIO_HIGH | default(90) }}

# Priority decrease step for each subsequent priority level.
# RTIRQ_PRIO_DECR=5
RTIRQ_PRIO_DECR={{ RTIRQ_PRIO_DECR | default(5) }}

# Lowest priority level for RT IRQ threads.
# RTIRQ_PRIO_LOW=51
RTIRQ_PRIO_LOW={{ RTIRQ_PRIO_LOW | default(51) }}

# Whether to reset all IRQ threads to SCHED_OTHER (1=yes, 0=no).
# RTIRQ_RESET_ALL=0
RTIRQ_RESET_ALL={{ RTIRQ_RESET_ALL | default('0') }}

# Space-separated list of services that should not be threaded.
# RTIRQ_NON_THREADED="rtc snd"
RTIRQ_NON_THREADED="{{ RTIRQ_NON_THREADED | default('rtc snd') }}"

# Process names which will be forced to the
# highest realtime priority range (99-91)
# (space separated list, from highest to lower priority).
# RTIRQ_HIGH_LIST="timer"