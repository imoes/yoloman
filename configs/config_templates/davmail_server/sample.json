{
  "enable_debug": false,
  "log_file": "/var/log/davmail/davmail.log",
  "bind_all_interfaces": false,
  "local_address": "127.0.0.1",
  "exchange_url": "https://outlook.office365.com/EWS/Exchange.asmx",
  "username": "user@example.com",
  "password": "",
  "oauth2_enabled": true,
  "oauth2_client_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "oauth2_tenant_id": "12345678-1234-1234-1234-123456789012",
  "ports": {
    "pop3": 1110,
    "imap": 1143,
    "smtp": 1025,
    "caldav": 8443,
    "ldap": 1389,
    "admin": 8080
  },
  "limits": {
    "max_connections": 10,
    "timeout_seconds": 60,
    "message_size_kb": 10240
  },
  "keystore_path": "/etc/davmail/keystore.jks",
  "keystore_type": "JKS",
  "keystore_password": "changeit",
  "trust_all_certs": false,
  "services": {
    "pop3": true,
    "imap": true,
    "smtp": true,
    "caldav": true,
    "ldap": true
  },
  "imap_show_deleted": true,
  "imap_keep_drafts": true,
  "ldap_base_dn": "dc=example,dc=com",
  "ldap_bind_dn": "cn=admin,dc=example,dc=com",
  "ldap_bind_password": "secret",
  "ldap_server_url": "",
  "caldav_default_calendar": "Calendar",
  "jvm_args": [
    "-Xmx512m",
    "-Dfile.encoding=UTF-8"
  ]
}
