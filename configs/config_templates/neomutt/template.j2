#
# NeoMutt configuration template - managed by Ansible
# This file configures NeoMutt email client behavior, UI, and caching.
#

# ============================================================
# User Identity and Envelope Settings
# ============================================================

# Your full name, used in the 'From:' header of outgoing messages.
set realname="{{ realname | default('User Name') }}"

# The primary email address used as 'From:' in sent messages.
set from="{{ from_address | default('user@example.com') }}"

# Whether to set the envelope-sender address equal to 'From:' (required by many mail servers to prevent SPF failures).
{% if use_envelope_from is sameas true or use_envelope_from is sameas 'true' %}
set use_envelope_from=yes
{% else %}
set use_envelope_from=no
{% endif %}

# ============================================================
# Account and Folder Settings
# ============================================================

# Name of the default account to use when no explicit account is specified (must match an entry in `accounts`).
set default_account="{{ default_account | default('primary') }}"

# Default IMAP inbox folder name (e.g., 'INBOX', 'INBOX/Archives').
set folder="{{ default_imap_spoolfile | default('INBOX') }}"

# IMAP folder where sent messages are saved (e.g., 'Sent', 'Sent Messages').
set record="{{ record_folder | default('Sent') }}"

# IMAP folder for postponed messages.
set postponed="{{ postponed_folder | default('Drafts') }}"

# IMAP folder for deleted messages.
set trash="{{ trash_folder | default('Trash') }}"

# ============================================================
# Caching Settings
# ============================================================

# Path to the header cache file (improves indexing speed).
set header_cache="{{ header_cache_path | default('~/.cache/neomutt/headers') }}"

# Path to the message body cache directory (speeds up mail display).
set message_cache="{{ message_cache_path | default('~/.cache/neomutt/bodies') }}"

# How long (in seconds) to keep cached headers valid; 0 = never expire. Increase for IMAP to reduce re-fetching.
set cache_life="{{ cache_life | default(0) }}"

# ============================================================
# Editor Settings
# ============================================================

# The external text editor used to compose messages.
set editor="{{ editor | default('vim') }}"

# ============================================================
# PGP/GnuPG Settings
# ============================================================

# Enable PGP/GnuPG support for signing and encrypting messages.
{% if enable_pgp is sameas true or enable_pgp is sameas 'true' %}
set pgp_replysign=yes
set pgp_replysignencrypted=yes
set pgp_encryptsignkeys="{{ pgp_default_key | default('') }}"
set pgp_signkeys="{{ pgp_sign_as | default('') }}"
set pgp_timeout="{{ pgp_timeout | default(3600) }}"
{% else %}
# PGP support is disabled
{% endif %}

# ============================================================
# UI / Sidebar Settings
# ============================================================

# Enable the sidebar (folder list) display (requires +sidebar support in NeoMutt build).
{% if enable_sidebar is sameas true or enable_sidebar is sameas 'true' %}
set sidebar_visible=yes
set sidebar_width="{{ sidebar_width | default(20) }}"
{% else %}
set sidebar_visible=no
{% endif %}

# ============================================================
# Theme / Color Scheme
# ============================================================

# Color scheme for NeoMutt UI elements. Each entry defines `target`, foreground (`fg`), background (`bg`), and optional `attrs`.
{% if theme is defined and theme is not none %}
{% for entry in theme %}
color {{ entry.target | default('') }} {{ entry.fg | default('') }} {{ entry.bg | default('') }} {% if entry.attrs | default('') %}{{ entry.attrs | default('') }}{% endif %}
{% endfor %}
{% endif %}

# ============================================================
# Macros
# ============================================================

# Key macros to define (list of objects with `where`, `key`, `command`, `desc`).
{% if macros is defined and macros is not none %}
{% for macro in macros %}
macro {{ macro.where | default('index') }} {{ macro.key | default('') }} "{{ macro.command | default('') }}" "{{ macro.desc | default('') }}"
{% endfor %}
{% endif %}

# ============================================================
# System Defaults & Misc
# ============================================================

# Default list of header fields to weed when displaying.
# Ignore all lines by default...
ignore *

# ... then allow these through.
unignore from: subject to cc date x-mailer x-url user-agent

# Display the fields in this order
hdr_order date from to cc subject

# emacs-like bindings
bind editor    "\e<delete>"    kill-word
bind editor    "\e<backspace>" kill-word

# map delete-char to a sane value
bind editor     <delete>  delete-char

# Enable the use of threads
set use_threads=threads

# Postfix and qmail use Delivered-To for detecting loops
unset bounce_delivered

# System-wide CA file managed by the ca-certificates package
set ssl_ca_certificates_file="/etc/ssl/certs/ca-certificates.crt"

# imitate the old search-body function
macro index \eb "<search>~b " "search in message bodies"

# simulate the old url menu
macro index,pager,attach,compose \cb "\
<enter-command> set my_pipe_decode=\$pipe_decode pipe_decode<Enter>\
<pipe-message> urlview<Enter>\
<enter-command> set pipe_decode=\$my_pipe_decode; unset my_pipe_decode<Enter>" \
"call urlview to extract URLs out of a message"

# Show documentation when pressing F1
macro generic,pager <F1> "<shell-escape> zcat /usr/share/doc/neomutt/manual.txt.gz | sensible-pager<Enter>" "show NeoMutt documentation"
# and also F2, as some terminals use F1
macro generic,pager <F2> "<shell-escape> zcat /usr/share/doc/neomutt/manual.txt.gz | sensible-pager<Enter>" "show NeoMutt documentation"

# show the incoming mailboxes list (just like "neomutt -y") and back when pressing "y"
macro index y "<change-folder>?" "show incoming mailboxes list"
macro pager y "<exit><change-folder>?" "show incoming mailboxes list"
bind browser y exit

bind editor <delete> delete-char

# If NeoMutt is unable to determine your site's domain name correctly, you can
# set the default here. (better: fix /etc/mailname)
set hostname="{{ hostname | default('') }}"

# Use mime.types to look up handlers for application/octet-stream.
mime_lookup application/octet-stream

# Upgrade the progress counter every 250ms, good for mutt over SSH
set time_inc=250

# Qualify any MIME part with an "attachment" disposition, EXCEPT for
# text/vcard, text/x-vcard, application/pgp.*, application/pkcs7-.* and
# application/x-pkcs7-.* parts.
attachments   +A */.*
attachments   -A text/vcard text/x-vcard
attachments   -A application/pgp.*
attachments   -A application/pkcs7-.* application/x-pkcs7-.*

# Discount all MIME parts with an "inline" disposition, unless they're
# text/plain.
attachments   +I text/plain

# You probably don't really care to know about deleted attachments.
attachments   -A message/external-body
attachments   -I message/external-body

##
source /usr/libexec/neomutt/source-neomuttrc.d|