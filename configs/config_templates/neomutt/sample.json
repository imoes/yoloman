{
  "realname": "Alex Johnson",
  "from_address": "alex.johnson@example.org",
  "use_envelope_from": true,
  "default_account": "work",
  "default_imap_spoolfile": "INBOX",
  "record_folder": "Sent",
  "postponed_folder": "Drafts",
  "trash_folder": "Trash",
  "header_cache_path": "~/.cache/neomutt/headers",
  "message_cache_path": "~/.cache/neomutt/bodies",
  "cache_life": 600,
  "editor": "nvim",
  "enable_pgp": true,
  "pgp_default_key": "0x1234567890ABCDEF",
  "pgp_sign_as": "0x1234567890ABCDEF",
  "pgp_timeout": 1800,
  "enable_sidebar": true,
  "sidebar_width": 24,
  "theme": {
    "colors": [
      {
        "target": "index",
        "fg": "white",
        "bg": "black"
      },
      {
        "target": "index",
        "fg": "red",
        "bg": "black",
        "attrs": [
          "bold"
        ]
      },
      {
        "target": "message",
        "fg": "white",
        "bg": "black"
      },
      {
        "target": "status",
        "fg": "white",
        "bg": "blue"
      },
      {
        "target": "tree",
        "fg": "yellow",
        "bg": "black",
        "attrs": [
          "bold"
        ]
      }
    ]
  },
  "macros": [
    {
      "where": "index",
      "key": "<enter>",
      "command": "<display-message>",
      "desc": "View selected message"
    },
    {
      "where": "pager",
      "key": "q",
      "command": "<quit>",
      "desc": "Quit pager"
    },
    {
      "where": "index",
      "key": "<space>",
      "command": "<mark-message>",
      "desc": "Mark message read/unread"
    }
  ],
  "log_file": "",
  "accounts": [
    {
      "name": "work",
      "config_dir": "",
      "imap": {
        "enabled": true,
        "user": "alex.johnson@example.org",
        "password": "",
        "folder": "imaps://imap.example.org/",
        "ssl": true,
        "starttls": false,
        "verify_cert": true
      },
      "smtp": {
        "url": "smtps://alex.johnson@example.org@smtp.example.org:465"
      }
    },
    {
      "name": "personal",
      "config_dir": "",
      "imap": {
        "enabled": true,
        "user": "alex.johnson+personal@gmail.com",
        "password": "",
        "folder": "imaps://imap.gmail.com/",
        "ssl": true,
        "starttls": false,
        "verify_cert": true
      },
      "smtp": {
        "url": "smtps://alex.johnson+personal@gmail.com@smtp.gmail.com:465"
      }
    }
  ]
}
