# ============================================
# Ayatana Indicator Date & Time Desktop Entry
# ============================================
# This template generates a .desktop file for the Ayatana indicator
# which displays date and time in the system tray.

[Desktop Entry]
# Application type; must be Application for executables.
Type=Application

# Human-readable name of the application.
Name=Ayatana Indicator Date & Time

# Executable path for the indicator service.
# Default: /usr/libexec/ayatana-indicator-datetime/ayatana-indicator-datetime-service
Exec={{ exec_path | default('/usr/libexec/ayatana-indicator-datetime/ayatana-indicator-datetime-service') }}

# Semicolon-separated list of desktop environments where this application should appear.
OnlyShowIn=MATE;Unity;XFCE;Pantheon;Budgie

# Prevent the application from showing in menus (it's a tray indicator).
NoDisplay=true

# Whether to notify the session manager on startup (usually false for tray apps).
StartupNotify=false

# Whether to open a terminal window (false for daemon/tray apps).
Terminal=false

# Icon name or path.
# Default: '' (empty string uses the system default icon for the service).
Icon={{ icon_name | default('') }}