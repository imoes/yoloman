# Desktop Entry file for the Ayatana Indicator Date & Time applet.
# This file is used by desktop environments (MATE, Unity, XFCE, Pantheon, Budgie)
# to launch and identify the indicator service.

# The type of the entry. Always Application for executable launchers.
Type=Application

# Human-readable name displayed in menus or applets.
Name=Ayatana Indicator Date & Time

# Command line to execute.
# Defaults to the standard system path for the ayatana-indicator-datetime-service executable.
Exec={{ exec_path | default('/usr/libexec/ayatana-indicator-datetime/ayatana-indicator-datetime-service') }}

# Comma-separated list of desktop environments where this entry should be shown.
OnlyShowIn=MATE;Unity;XFCE;Pantheon;Budgie

# If true, the entry is hidden from menus and only used by other applications.
# Ayatana indicators are typically hidden from standard menus as they run as applets.
NoDisplay=true

# If true, the desktop entry is not allowed to notify the desktop environment.
StartupNotify=false

# If true, the application is never associated with a terminal.
Terminal=false

# Icon name or path.
# Defaults to an empty string, allowing the desktop environment to use its default icon for this application.
Icon={{ icon_name | default('') }}
