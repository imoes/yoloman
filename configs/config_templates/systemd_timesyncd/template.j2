[Time]
# Enable time synchronization via SNTP
RootDistanceMaxSec={{ root_distance_max_sec }}

# Accept time updates even if the system clock is far out of sync (in seconds)
PollIntervalMaxSec={{ poll_interval_max_sec }}
PollIntervalMinSec={{ poll_interval_min_sec }}

# Fallback NTP servers to use if no others are reachable
FallbackNTP={{ fallback_ntp_servers | join(' ') }}

# Primary NTP servers to use
NTP={{ ntp_servers | join(' ') }}

# Enable or disable IPv4 and IPv6 NTP support
UseIPv4={{ use_ipv4|lower }}
UseIPv6={{ use_ipv6|lower }}

# Verbosity level: 0=quiet, 1=minimal, 2=debug
LogLevel={{ log_level }}

# Log to systemd-journald instead of syslog
LogTarget={{ log_target }}

# Maximum number of retries before giving up on a server
RetrySec={{ retry_sec }}

# Directory for additional server configurations (typically unused)
# (systemd timesyncd does not support this; kept for compatibility but ignored)
# ServerDirectory={{ server_directory }}
