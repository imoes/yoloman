{
  "log_dir": "/var/log/aodh",
  "log_file": "aodh-evaluator.log",
  "debug": false,
  "workers": 4,
  "batch_size": 200,
  "evaluation_interval": 30,
  "evaluation_timeout": 20,
  "enabled": true,
  "database": {
    "connection": "mysql+pymysql://aodh:secretdbpass@10.0.0.10/aodh?charset=utf8",
    "max_retries": 15,
    "retry_interval": 3,
    "pool_timeout": 60
  },
  "keystone_authtoken": {
    "auth_type": "password",
    "auth_url": "https://keystone.example.com:5000/v3",
    "project_domain_name": "Default",
    "project_name": "service",
    "user_domain_name": "Default",
    "username": "aodh",
    "password": "aodhsecret",
    "interface": "internal",
    "insecure": false,
    "cafile": "/etc/ssl/certs/ca-certificates.crt"
  },
  "oslo_messaging_notifications": {
    "transport_url": "rabbit://aodh:mqpass@10.0.0.11:5672/",
    "driver": "messagingv2",
    "topics": [
      "alarm_notification",
      "telemetry.alarm"
    ]
  },
  "oslo_messaging_rpc": {
    "transport_url": "rabbit://aodh:mqpass@10.0.0.11:5672/"
  },
  "rabbit": {
    "host": "10.0.0.11",
    "port": 5672,
    "userid": "aodh",
    "password": "mqpass",
    "virtual_host": "/",
    "heartbeat": 60
  },
  "eventlet_executor": {
    "threads": 20
  },
  "service_credentials": {
    "auth_type": "password",
    "auth_url": "https://keystone.example.com:5000/v3",
    "project_domain_name": "Default",
    "project_name": "service",
    "user_domain_name": "Default",
    "username": "aodh",
    "password": "aodhsecret",
    "interface": "internal",
    "insecure": false,
    "cafile": "/etc/ssl/certs/ca-certificates.crt"
  }
}
