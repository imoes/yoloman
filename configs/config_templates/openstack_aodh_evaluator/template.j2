# Main configuration for OpenStack Aodh Alarm Evaluator service
# Controls alarm evaluation behavior: thresholds, timeouts, and worker settings

[DEFAULT]
# Logging configuration
log_dir = {{ log_dir }}
log_file = {{ log_file }}

# Debug mode
debug = {{ debug }}

[evaluator]
# Number of concurrent alarm evaluation workers
workers = {{ workers }}

# Maximum number of alarms evaluated in a single batch
batch_size = {{ batch_size }}

# Time (in seconds) to wait between evaluation cycles
evaluation_interval = {{ evaluation_interval }}

# Timeout (in seconds) for a single alarm evaluation
evaluation_timeout = {{ evaluation_timeout }}

# Enable/Disable alarm evaluation (set to false to pause evaluation)
enabled = {{ enabled }}

# Path to the alarm history storage backend
# Note: Aodh uses a database backend (e.g., SQLAlchemy URL)
# This is typically configured in [database] section below

[database]
# Database connection string for alarm history
# Example: mysql+pymysql://aodh:password@dbhost/aodh?charset=utf8
connection = {{ database.connection }}

# Maximum number of database connection retries
max_retries = {{ database.max_retries }}

# Interval (in seconds) between retry attempts
retry_interval = {{ database.retry_interval }}

# Enable/Disable database connection pooling
pool_timeout = {{ database.pool_timeout }}

[keystone_authtoken]
# Authentication settings for keystone
auth_type = {{ keystone_authtoken.auth_type }}
auth_url = {{ keystone_authtoken.auth_url }}
project_domain_name = {{ keystone_authtoken.project_domain_name }}
project_name = {{ keystone_authtoken.project_name }}
user_domain_name = {{ keystone_authtoken.user_domain_name }}
username = {{ keystone_authtoken.username }}
password = {{ keystone_authtoken.password }}

# API version (e.g., '3')
interface = {{ keystone_authtoken.interface }}

# Whether to verify SSL/TLS certificates
insecure = {{ keystone_authtoken.insecure }}
cafile = {{ keystone_authtoken.cafile }}

[oslo_messaging_notifications]
# Transport URL for RabbitMQ / Kafka / etc.
transport_url = {{ oslo_messaging_notifications.transport_url }}

# Topic for notification exchange
driver = {{ oslo_messaging_notifications.driver }}

# Notification topics to listen on (list of topics)
 topics = {{ [topic for topic in oslo_messaging_notifications.topics] | join(', ') }}

[oslo_messaging_rpc]
# Transport URL for RPC communication
transport_url = {{ oslo_messaging_rpc.transport_url }}

[rabbit]
# RabbitMQ-specific settings (if used)
host = {{ rabbit.host }}
port = {{ rabbit.port }}
userid = {{ rabbit.userid }}
password = {{ rabbit.password }}
virtual_host = {{ rabbit.virtual_host }}
heartbeat = {{ rabbit.heartbeat }}

[eventlet_executor]
# ThreadPool size for eventlet-based execution
threads = {{ eventlet_executor.threads }}

[service_credentials]
# Optional separate credentials for service-to-service communication
auth_type = {{ service_credentials.auth_type }}
auth_url = {{ service_credentials.auth_url }}
project_domain_name = {{ service_credentials.project_domain_name }}
project_name = {{ service_credentials.project_name }}
user_domain_name = {{ service_credentials.user_domain_name }}
username = {{ service_credentials.username }}
password = {{ service_credentials.password }}
interface = {{ service_credentials.interface }}
insecure = {{ service_credentials.insecure }}
cafile = {{ service_credentials.cafile }}
