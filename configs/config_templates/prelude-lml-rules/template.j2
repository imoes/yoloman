{% for rule in (rules | default([
  {
    "name": "high_humidity",
    "description": "Environmental Monitoring - high humidity violation",
    "category": "Environmental",
    "regex": "EMU: Probe (\\d+) ('.+') high  humidity violation, '(\\d+%)'",
    "classification_text": "High Environmental Humidity",
    "id": 2800,
    "revision": 2,
    "analyzer_name": "Environmental Monitoring Unit",
    "analyzer_manufacturer": "APC",
    "analyzer_class": "Power",
    "severity": "high",
    "description_detail": "Environmental probe $2 has reported a high humidity: $3",
    "data_probe": 1,
    "data_probe_name": 2,
    "data_humidity": 3
  },
  {
    "name": "high_humidity_cleared",
    "description": "Environmental Monitoring - high humidity violation cleared",
    "category": "Environmental",
    "regex": "EMU: Probe (\\d+) ('.+') high  humidity violation cleared, '(\\d+%)'",
    "classification_text": "Environmental Humidity Normal",
    "id": 2801,
    "revision": 2,
    "analyzer_name": "Environmental Monitoring Unit",
    "analyzer_manufacturer": "APC",
    "analyzer_class": "Power",
    "severity": "low",
    "description_detail": "Environmental probe $2 has reported humidity has returned to normal: $3",
    "data_probe": 1,
    "data_probe_name": 2,
    "data_humidity": 3
  },
  {
    "name": "contact_opened",
    "description": "Environmental Monitoring - Device Contact Opened",
    "category": "Environmental",
    "regex": "EMU: Input Contact (\\d+) ('.+') opened, abnormal condition",
    "classification_text": "Device Contact Opened",
    "id": 2802,
    "revision": 2,
    "analyzer_name": "Environmental Monitoring Unit",
    "analyzer_manufacturer": "APC",
    "analyzer_class": "Power",
    "severity": "high",
    "description_detail": "Contact $2 has reported an open condition",
    "data_contact": 1,
    "data_contact_name": 2
  },
  {
    "name": "contact_closed",
    "description": "Environmental Monitoring - Device Contact Closed",
    "category": "Environmental",
    "regex": "EMU: Input Contact (\\d+) ('.+') closed, abnormal condition cleared",
    "classification_text": "Device Contact Closed",
    "id": 2803,
    "revision": 2,
    "analyzer_name": "Environmental Monitoring Unit",
    "analyzer_manufacturer": "APC",
    "analyzer_class": "Power",
    "severity": "low",
    "description_detail": "Contact $2 has reported a closed condition",
    "data_contact": 1,
    "data_contact_name": 2
  }
])) %}
#DESCRIPTION:{{ rule.description | default('Unknown rule') }}
#CATEGORY:{{ rule.category | default('Unknown') }}
#LOG:Example log entry for {{ rule.name | default('unnamed') }} rule
regex={{ rule.regex | default('') }}; \
 classification.text={{ rule.classification_text | default('Unknown') }}; \
 id={{ rule.id | default(0) }}; \
 revision={{ rule.revision | default(1) }}; \
 analyzer(0).name={{ rule.analyzer_name | default('Unknown') }}; \
 analyzer(0).manufacturer={{ rule.analyzer_manufacturer | default('Unknown') }}; \
 analyzer(0).class={{ rule.analyzer_class | default('Unknown') }}; \
 assessment.impact.severity={{ rule.severity | default('info') }}; \
 assessment.impact.completion=succeeded; \
 assessment.impact.type=other; \
 assessment.impact.description={{ rule.description_detail | default('No description') }}; \
{% if rule.data_probe is defined %}additional_data(0).type=integer; \
 additional_data(0).meaning=Probe; \
 additional_data(0).data=${rule.data_probe | default(1)}; \
{% endif %}{% if rule.data_probe_name is defined %}additional_data(1).type=string; \
 additional_data(1).meaning=Probe name; \
 additional_data(1).data=${rule.data_probe_name | default(2)}; \
{% endif %}{% if rule.data_humidity is defined %}additional_data(2).type=string; \
 additional_data(2).meaning=Humidity; \
 additional_data(2).data=${rule.data_humidity | default(3)}; \
{% endif %}{% if rule.data_contact is defined %}additional_data(0).type=integer; \
 additional_data(0).meaning=Contact; \
 additional_data(0).data=${rule.data_contact | default(1)}; \
{% endif %}{% if rule.data_contact_name is defined %}additional_data(1).type=string; \
 additional_data(1).meaning=Contact name; \
 additional_data(1).data=${rule.data_contact_name | default(2)}; \
{% endif %}last

{% endfor %}

