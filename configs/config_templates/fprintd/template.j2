# Configuration for the Fingerprint Authentication Daemon (fprintd)
# Sets general daemon behavior and policy options
[LibFingerprint]
# Enable or disable debug logging (useful for troubleshooting)
Debug={{ debug|lower }}

# Maximum number of retries allowed for fingerprint enrollment per user
MaxEnrollRetries={{ max_enroll_retries }}

# Time (in seconds) to wait before resetting the enrollment retry counter
EnrollTimeout={{ enroll_timeout }}

# List of supported verification policies — each policy controls how many fingers are required
# Format: policy_name:required_finger_count
{% for policy in policies %}Policy={{ policy.name }}={{ policy.required_fingers }}
{% endfor %}

# Enable or disable auto-resume of suspended devices (e.g., after system suspend)
AutoResume={{ auto_resume|lower }}
