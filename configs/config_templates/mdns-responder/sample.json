{
  "use_ipv6": true,
  "use_ipv4": true,
  "allow_interfaces": [
    "eth0",
    "wlan0"
  ],
  "deny_interfaces": [
    "docker0",
    "virbr0"
  ],
  "system_hostname": "myserver",
  "domain_name": "local.",
  "reflector_enabled": false,
  "reflect_dns_services": false,
  "nss_resolve_enabled": false,
  "max_cache_entries": 10000,
  "max_ttl": 75,
  "max_neg_ttl": 120,
  "wide_area_enabled": false,
  "publish_hinfo": false,
  "publish_services": true,
  "publish_addresses": true,
  "publish_ptr": true,
  "publish_srv": true,
  "publish_txt": true,
  "publish_workstation": false,
  "publish_service_types": [
    "_ssh._tcp",
    "_ftp._tcp"
  ],
  "respond_to_interfaces": [],
  "rlimit_nofile": 1024,
  "rlimit_nproc": 50
}
