# Claws Mail pgpinline plugin configuration
# This file is NOT used directly by pgpinline — the plugin is loaded via Claws Mail GUI.
# However, GnuPG configuration affects PGP/Inline behavior.
#
# NOTE: The pgpinline plugin itself does not read this file. This template is provided
# for documentation, audit, or potential future integration with configuration management.
# The actual plugin settings are managed within Claws Mail's graphical interface.

{% if gpg_conf_path | default('') != '' %}
# Optional absolute path to gpg.conf; if empty, uses default ~/.gnupg/gpg.conf
# GnuPG config path override: {{ gpg_conf_path | default('') }}
{% endif %}

# Sign all outgoing messages by default (user prompt still required unless auto_sign=true)
# Default: {{ sign_by_default | default(False) }}
# {% if sign_by_default | default(False) %}sign_by_default = yes{% else %}sign_by_default = no{% endif %}

# Encrypt all outgoing messages by default (recipient key required and user prompt still required unless auto_encrypt=true)
# Default: {{ encrypt_by_default | default(False) }}
# {% if encrypt_by_default | default(False) %}encrypt_by_default = yes{% else %}encrypt_by_default = no{% endif %}

# Automatically sign messages without prompting the user
# Default: {{ auto_sign | default(False) }}
# {% if auto_sign | default(False) %}auto_sign = yes{% else %}auto_sign = no{% endif %}

# Automatically encrypt messages without prompting the user
# Default: {{ auto_encrypt | default(False) }}
# {% if auto_encrypt | default(False) %}auto_encrypt = yes{% else %}auto_encrypt = no{% endif %}

# Refuse to send if encryption is requested but no valid key found for recipient
# Default: {{ strict_encryption | default(False) }}
# {% if strict_encryption | default(False) %}strict_encryption = yes{% else %}strict_encryption = no{% endif %}

# Include public key in signed or encrypted messages (useful for interoperability)
# Default: {{ include_key | default(False) }}
# {% if include_key | default(False) %}include_key = yes{% else %}include_key = no{% endif %}

# Use ASCII armored format for PGP/Inline messages (required for text-only channels)
# Default: {{ use_ascii_armored | default(True) }}
# {% if use_ascii_armored | default(True) %}use_ascii_armored = yes{% else %}use_ascii_armored = no{% endif %}

# Use GPGME backend (required by Claws Mail pgpinline plugin)
# Default: {{ use_gpgme | default(True) }}
# {% if use_gpgme | default(True) %}use_gpgme = yes{% else %}use_gpgme = no{% endif %}