# HerculesStudio configuration file
# This file serves as a wrapper or launcher configuration for the Hercules Studio environment.

# ---------------------------------------------------------------------------
# hercules_config_file
# Path to the Hercules virtual machine configuration file (passed via -f).
# This points to the actual CPU/system configuration that Hercules will load.
# ---------------------------------------------------------------------------
hercules_config_file = {{ hercules_config_file | default('/etc/hercules.conf') }}

# ---------------------------------------------------------------------------
# hercules_run_commands_file
# Path to the Hercules run commands file (passed via -r).
# This file contains commands to be executed automatically when Hercules
# starts, such as loading devices or issuing control commands.
# If left empty (the default), no run commands file is specified.
# ---------------------------------------------------------------------------
hercules_run_commands_file = {{ hercules_run_commands_file | default('') }}