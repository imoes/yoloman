# KubeVirt API endpoint URL
kubevirt_api_url={{ kubevirt_api_url }}

# KubeVirt authentication token (service account token or bearer token)
kubevirt_token={{ kubevirt_token | default('') }}

# Path to kubeconfig file (alternative to token authentication)
kubevirt_kubeconfig={{ kubevirt_kubeconfig | default('') }}

# Namespace to scope operations to (optional, defaults to 'default')
kubevirt_namespace={{ kubevirt_namespace | default('default') }}

# Verify TLS certificates of the API server (true/false)
kubevirt_insecure_skip_tls_verify={{ kubevirt_insecure_skip_tls_verify | default(false) | lower }}

# Timeout for API calls in seconds
kubevirt_timeout={{ kubevirt_timeout | default(60) }}

# List of VMs to fence (for multi-VM operations)
{% for vm in kubevirt_vms %}
kubevirt_vm={{ vm.name }}
{% endfor %}