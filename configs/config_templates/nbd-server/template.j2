#!/bin/sh
# vim:ft=sh
#
# skeleton	example file to build /etc/init.d/ scripts.
#		This file should be used to construct scripts for /etc/init.d.
#
#		Written by Miquel van Smoorenburg <miquels@cistron.nl>.
#		Modified for Debian GNU/Linux
#		by Ian Murdock <imurdock@gnu.ai.mit.edu>.
#	 	Modified for the nbd-server package
#		by Wouter Verhelst <wouter@debian.org>
#
# Version:	@(#)skeleton	1.8	03-Mar-1998	miquels@cistron.nl
#
### BEGIN INIT INFO 
# Provides: {{ name | default('nbd-server') }} 
# Required-Start: $remote_fs $syslog
# Required-Stop: $remote_fs $syslog
# Should-Start: $network
# Should-Stop: $network
# Default-Start: 2 3 4 5 
# Default-Stop: 0 1 6 
# Short-Description: {{ description | default('Network Block Device server') }}
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin
DAEMON="/bin/nbd-server"
# The name of the service/daemon.
NAME="{{ name | default('nbd-server') }}"
# A short description of the service.
DESC="{{ description | default('Network Block Device server') }}"

test -x $DAEMON || exit 0

case "$1" in
    start)
	# Start the NBD server daemon, using the specified PID file.
	start-stop-daemon --start --quiet --exec /bin/nbd-server --oknodo --pidfile {{ pidfile | default('/var/run/nbd-server.pid') }}
	echo " $NAME."
	;;
    stop)
	echo -n "Stopping $DESC:"
	# Stop the NBD server daemon gracefully, retrying if necessary.
	start-stop-daemon --stop --quiet --exec /bin/nbd-server --oknodo --pidfile {{ pidfile | default('/var/run/nbd-server.pid') }} --retry 1
	echo " $NAME."
	;;
    reload)
	 echo -n "Reloading $DESC:"
	# Send a HUP signal to the NBD server to reload configuration, if the PID file exists.
	if [ -f {{ pidfile | default('/var/run/nbd-server.pid') }} ]
	then
		kill -HUP $(cat {{ pidfile | default('/var/run/nbd-server.pid') }})
	fi
	;;
    restart|force-reload)
	echo "Restarting the $DESC is pretty harsh on clients still using it."
	echo -n "waiting 5 seconds..."
	sleep 5
	echo "You have been warned!"
	echo -n "Restarting $DESC: "
	$0 stop
	sleep 10
	$0 start
	;;
    *)
	N=/etc/init.d/$NAME
	# echo "Usage: $N {start|stop|restart|reload|force-reload}" >&2
	echo "Usage: $N {start|stop|restart|force-reload}" >&2
	exit 1
	;;
esac

exit 0