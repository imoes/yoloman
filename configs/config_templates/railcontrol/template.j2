# Path to the log file where railcontrol writes its logs.
# Type: string (path)
--logfile={{ logfile | default('/var/log/railcontrol.log') }}

# Whether to run railcontrol as a daemon (background process).
# Type: boolean
--daemonize={{ daemonize | default(True) | lower }}

# Whether to suppress console output. Implied by daemonize.
# Type: boolean
--silent={{ silent | default(True) | lower }}