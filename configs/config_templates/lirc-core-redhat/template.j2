#
# LIRC irexec configuration template.
# This file configures the irexec daemon to execute commands when
# specific remote control keys are pressed.
#
# The system-wide service runs without a terminal. To check output,
# use: journalctl -b0 /usr/bin/irexec
#

# --- Global Program Name ---
# The program name to run for key bindings.
begin
    prog   = {{ irexec_program | default('irexec') }}

    # --- Key: RED ---
    # Command to execute when the RED key is pressed.
    button = KEY_RED
    config = {{ action_key_red | default('echo "KEY_RED"') }}

    # --- Key: BLUE ---
    # Command to execute when the BLUE key is pressed.
    button = KEY_BLUE
    config = {{ action_key_blue | default('echo "KEY_BLUE"') }}

    # --- Key: 1 ---
    # Command to execute when the 1 key is pressed.
    button = KEY_1
    config = {{ action_key_1 | default('echo "KEY_1"') }}

    # --- Key: 2 ---
    # Command to execute when the 2 key is pressed.
    button = KEY_2
    config = {{ action_key_2 | default('echo "KEY_2"') }}

    # --- Key: 3 ---
    # Command to execute when the 3 key is pressed.
    button = KEY_3
    config = {{ action_key_3 | default('echo "KEY_3"') }}

    # --- Key: OK ---
    # Command to execute when the OK key is pressed.
    button = KEY_OK
    config = {{ action_key_ok | default('echo "KEY_OK"') }}

    # --- Key: LEFT ---
    # Command to execute when the LEFT key is pressed.
    button = KEY_LEFT
    config = {{ action_key_left | default('echo "KEY_LEFT"') }}

    # --- Key: RIGHT ---
    # Command to execute when the RIGHT key is pressed.
    button = KEY_RIGHT
    config = {{ action_key_right | default('echo "KEY_RIGHT"') }}

end
