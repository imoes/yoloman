{
  "pid_file": "/var/run/sendmail.pid",
  "run_as_user": "smmsp",
  "run_as_group": "smmsp",
  "queue_directory": "/var/spool/mqueue",
  "temp_directory": "/var/spool/mqueue/df",
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 25
    },
    {
      "address": "::1",
      "port": 25
    }
  ],
  "my_hostname": "mail.example.com",
  "domain_masquerade": "example.com",
  "max_daemon_children": 20,
  "queue_interval": 600,
  "max_message_size": 20971520,
  "blacklist_files": [
    "/etc/mail/blacklist",
    "/etc/mail/spamhaus-deny"
  ],
  "restricted_relay": true,
  "relay_file": "/etc/mail/relay",
  "log_level": 12,
  "log_smtp_transactions": true,
  "trusted_user": "smmsp",
  "alias_file": "/etc/aliases",
  "map_directory": "/etc/mail",
  "tls_cert": "/etc/ssl/certs/mail.example.com.crt",
  "tls_key": "/etc/ssl/private/mail.example.com.key",
  "tls_ca": "/etc/ssl/certs/ca-bundle.crt",
  "tls_options": "+SSLv23 -SSLv2 -SSLv3",
  "starttls_enabled": true,
  "delivery_mode_retry_interval": 300
}
