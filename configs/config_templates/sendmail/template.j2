# ==============================================================================
# Sendmail Configuration Template (Nullmailer Emulator)
# ==============================================================================
# This template generates a configuration file for the nullmailer sendmail emulator.
# The nullmailer sendmail emulator acts as a local MTA (Mail Transfer Agent) that
# accepts mail via the sendmail command-line interface or SMTP (port 25) and forwards
# it to the configured remote transport (defined in /etc/nullmailer/remotes).
#
# This file is self-documenting: every directive includes its schema description as
# a comment, and every variable is safely defaulted to prevent render failures.
#
# Generated by Ansible Jinja2 engine. Do not edit manually.
# ==============================================================================

# ------------------------------------------------------------------------------
# System Definitions: Logging
# ------------------------------------------------------------------------------

# Path to the log file for the sendmail emulator. Used by nullmailer-inject/smtpd.
# If unset, defaults to /var/log/sendmail.log.
O LogFile={{ log_file | default('/var/log/sendmail.log') }}

# ------------------------------------------------------------------------------
# Host & Domain Settings: Identity
# ------------------------------------------------------------------------------

# Fully qualified domain name (FQDN) of this host — used in SMTP banner and envelope.
# If unset, defaults to 'localhost'. Ensure this matches your DNS PTR record.
O MyName={{ my_hostname | default('localhost') }}

# ------------------------------------------------------------------------------
# Logging & Diagnostics: Verbosity
# ------------------------------------------------------------------------------

# Logging verbosity: 0 (minimal) to 14 (debug). Higher values increase log detail.
# Set to 9 for standard operational logging; increase for troubleshooting delivery issues.
O LogLevel={{ log_level | default(9) }}

# ------------------------------------------------------------------------------
# Delivery & Reliability: Queue Management
# ------------------------------------------------------------------------------

# Seconds between automatic queue runs (0 = disable automatic queue runs; rely on cron
# or manual `nullmailer-queue` or `sendmail -q`).
# Typical production value is 900 (15 minutes). Set to 0 if managed by external scheduler.
O QueueInterval={{ queue_interval | default(900) }}

# ------------------------------------------------------------------------------
# Delivery & Reliability: Message Limits
# ------------------------------------------------------------------------------

# Maximum accepted message size in bytes (0 = no limit).
# Recommended: 10 MB (10485760 bytes) to prevent abuse and disk exhaustion.
# If set to 0 or negative, the limit is effectively disabled.
{% if (max_message_size | default(10485760)) > 0 %}
O MaxMessageSize={{ max_message_size | default(10485760) }}
{% else %}
O MaxMessageSize=0
{% endif %}