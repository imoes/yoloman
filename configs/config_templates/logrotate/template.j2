# Global configuration for logrotate
# This file sets default behavior for all log rotation jobs unless overridden
# in the include directory (/etc/logrotate.d).

# Log rotation frequency
# Defines how often logs are rotated (e.g., daily, weekly, monthly, yearly).
# See `man logrotate` for allowed intervals.
{{ frequency | default('weekly') }}

# Number of rotated log files to keep
# Specifies how many old rotated versions of the log file should be retained.
# Older files are deleted to save disk space.
rotate {{ rotate_count | default(4) }}

# Create new log files after rotation
# When enabled, logrotate will create a new, empty log file with the same
# permissions and ownership after moving the old one.
# Options: empty (default), or 'create mode owner group'.
{% set create_val = create | default('') %}
{% if create_val %}
create {{ create_val }}
{% endif %}

# Use date extension for rotated files
# When enabled, rotated files get a date suffix (e.g., logfile-20230401)
# instead of a numeric suffix (e.g., logfile.1).
# Requires dateformat to be set if you want a specific date format.
{% if dateext | default(false) %}
dateext
{% endif %}

# Compress rotated log files
# When enabled, old log files are compressed using gzip (or bzip2/xz if configured)
# to save disk space.
{% if compress | default('nocompress') != 'nocompress' %}
compress
{% endif %}

# Include additional configuration files
# Logrotate reads all files in this directory for per-application settings.
include /etc/logrotate.d

# End of global configuration
