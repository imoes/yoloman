# /etc/bmf/bmf.conf - BMF Bayesian mail filter configuration
#
# This file configures the BMF (Bayesian Mail Filter) application.
# It primarily serves as a wrapper for command-line arguments passed
# to the bmf binary daemon. Each argument must be properly shell-quoted
# within the list to handle spaces or special characters correctly.

# List of command-line arguments for the bmf binary; each item is a
# shell-quoted argument string (e.g., '-p -d /var/lib/bmf').
# Must contain at least the daemon mode flag to run as a service.
# If empty, the service will likely start with default/empty arguments.
{% for arg in bmf_args | default([]) %}{{ arg }}
{% endfor %}