# Configuration file for usbmuxd
# This service manages the USB multiplexing protocol used by Apple devices (iPod, iPhone, etc.)
# to communicate with a host machine.

# -----------------------------------------------------------------------------
# Daemon user account
# Description: The system user account to switch to after startup. Needs USB privileges.
# Default: usbmux
# -----------------------------------------------------------------------------
USER={{ user | default('usbmux') }}

# -----------------------------------------------------------------------------
# Hotplug discovery
# Description: If true, disables automatic discovery of devices on hotplug.
# Default: False
# -----------------------------------------------------------------------------
DISABLE_HOTPLUG={{ disable_hotplug | default(False) | lower }}

# -----------------------------------------------------------------------------
# Exit behavior
# Description: If true, enables '--exit' request from other instances and exit
# automatically if no device is attached.
# Default: True
# -----------------------------------------------------------------------------
ENABLE_EXIT={{ enable_exit | default(True) | lower }}

# -----------------------------------------------------------------------------
# Udev operation mode
# Description: If true, runs in udev operation mode (implies disable-hotplug and
# enable-exit).
# Default: False
# -----------------------------------------------------------------------------
RUN_UDEV_MODE={{ run_udev_mode | default(False) | lower }}

# -----------------------------------------------------------------------------
# Systemd operation mode
# Description: If true, runs in systemd operation mode (implies enable-exit and
# foreground).
# Default: False
# -----------------------------------------------------------------------------
RUN_SYSTEMD_MODE={{ run_systemd_mode | default(False) | lower }}