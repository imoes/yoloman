# /etc/bogofilter.cf - System-wide Bogofilter configuration
# Generated by Class-B template for bogofilter-bdb
# All options use --option=value syntax (GNU longopt)

{# Directory containing user ~/.bogofilter.cf and other config files. Overrides BOGOFILTER_DIR and home directory. See ENVIRONMENT. #}
{% if config_dir | default('') | length > 0 %}
--config-dir={{ config_dir | default('') }}
{% endif %}

{# Directory for the Berkeley DB wordlist.db and related files. See -d option in man page. #}
{% if wordlist_dir | default('.bogofilter') | length > 0 %}
--data-dir={{ wordlist_dir | default('.bogofilter') }}
{% endif %}

{# Berkeley DB cache size in MiB. Recommended: one third of database file size. See -k option. #}
--cache-size={{ cache_size | default(0) }}

{# Name of the header field inserted when -p (passthrough) mode is used. #}
--spam-header-name={{ spam_header_name | default('X-Bogosity') }}

{# Score (spam probability) assigned to unseen tokens. Default 0.5 per documentation. #}
--robx={{ robx | default(0.5) }}

{# Weight applied to robx for rare tokens. See -m option. #}
--robs={{ robs | default(0.0) }}

{# Minimum deviation from 0.5 for tokens to be used in classification. See -m option. #}
--min-dev={{ min_dev | default(0.1) }}

{# Threshold above which messages are marked as spam. See -o option. #}
--spam-cutoff={{ spam_cutoff | default(0.99) }}

{# Threshold below which messages are marked as ham; if 0 or equal to spam-cutoff, tristate mode is disabled. See -o option. #}
--ham-cutoff={{ ham_cutoff | default(0.01) }}

{# Spam effective size factor (ESF). See -E option. #}
--sp-esf={{ sp_esf | default(1.0) }}

{# Non-spam (ham) effective size factor (ESF). See -E option. #}
--ns-esf={{ ns_esf | default(1.0) }}

{# If true, enables logging via syslog (implies -l option). #}
{% if log_enabled | default(false) %}
--log
{% endif %}

{# Tag for syslog entries when logging is enabled. Requires log_enabled. #}
{% if log_tag | default('') | length > 0 %}
--log-tag={{ log_tag | default('') }}
{% endif %}

{# Override current date for token timestamps. 0 disables timestamping. See -y option. #}
{% if timestamp_date | default(0) != 0 %}
--timestamp={{ timestamp_date | default(0) }}
{% endif %}

{# Debug flags for output. See -x option and debug.h for values. #}
{% if debug_flags | default('') | length > 0 %}
--debug={{ debug_flags | default('') }}
{% endif %}