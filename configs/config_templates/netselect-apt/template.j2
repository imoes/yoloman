# =============================================================================
# netselect-apt Configuration Template
# =============================================================================
# This template generates a Bash script that executes `netselect-apt` to
# produce an optimized Debian/Ubuntu sources.list file.
#
# netselect-apt is a tool that tests multiple Debian mirrors to find the
# fastest ones based on network latency, and writes the best mirrors into
# a sources.list file.
#
# Self-Documenting: Every variable below includes its schema default and
# description as a comment. Ensure all variables are defined in your Ansible
# inventory or role vars to avoid render failures.
# =============================================================================

#!/bin/bash
# Generated by netselect-apt-config Ansible template

# --- Distribution Selection ---
# Debian distribution to use (e.g., stable, testing, unstable, sid, bookworm).
# Corresponds to: netselect-apt [dist]
# Default: 'stable'
DIST="{{ dist | default('stable') }}"

# --- Architecture Selection ---
# Architecture for mirrors (e.g., amd64, arm64).
# An empty string uses the dpkg default architecture of the system.
# Corresponds to: -a ARCH
# Default: ''
ARCH="{{ arch | default('') }}"

# --- Output File ---
# Output filename for the generated sources.list.
# Corresponds to: -o OUTFILE
# Default: 'sources.list'
OUTFILE="{{ out_file | default('sources.list') }}"

# --- Source Packages ---
# Include deb-src lines for source packages in the generated list.
# Corresponds to: -s, --sources
# Default: false
INCLUDE_SOURCES="{{ sources | default(false) | lower }}"

# --- Non-Free Components ---
# Include non-free section (and non-free-firmware if applicable) in the generated list.
# Corresponds to: -n, --nonfree
# Default: false
INCLUDE_NONFREE="{{ nonfree | default(false) | lower }}"

# --- Protocol Selection ---
# Use FTP mirrors instead of HTTP.
# Corresponds to: -f, --ftp
# Default: false
USE_FTP="{{ ftp | default(false) | lower }}"

# --- Mirror Testing ---
# Number of hosts to test for mirror validity before selecting the best ones.
# Corresponds to: -t HOSTS
# Default: 10
TEST_HOSTS="{{ tests | default(10) }}"

# --- Country Filtering ---
# Country code (ISO-3166) or full name to filter mirrors to a specific region.
# Corresponds to: -c COUNTRY
# Default: '' (no filtering)
COUNTRY="{{ country | default('') }}"

# --- Input File ---
# Local file path to use as a pre-downloaded mirror list instead of downloading
# the current list from the internet.
# Corresponds to: -i INFILE
# Default: '' (download fresh list)
INFILE="{{ infile | default('') }}"

# --- Additional Netselect Options ---
# Additional options passed verbatim to the netselect binary for tuning.
# Corresponds to: -O OPTIONS
# Default: ''
NETSELECT_OPTIONS="{{ netselect_options | default('') }}"

# =============================================================================
# Command Construction
# =============================================================================
# Build the netselect-apt command string incrementally based on the variables above.

cmd="netselect-apt"

# Add distribution (default is stable, but we specify if provided or force it)
if [ -n "${DIST}" ]; then
    cmd="${cmd} ${DIST}"
fi

# Add architecture flag if specified
if [ -n "${ARCH}" ]; then
    cmd="${cmd} -a ${ARCH}"
fi

# Add output file flag if specified
if [ -n "${OUTFILE}" ]; then
    cmd="${cmd} -o ${OUTFILE}"
fi

# Add sources flag if enabled
if [ "${INCLUDE_SOURCES}" == "true" ]; then
    cmd="${cmd} -s"
fi

# Add nonfree flag if enabled
if [ "${INCLUDE_NONFREE}" == "true" ]; then
    cmd="${cmd} -n"
fi

# Add ftp flag if enabled
if [ "${USE_FTP}" == "true" ]; then
    cmd="${cmd} -f"
fi

# Add tests count if it differs from the default (10)
if [ "${TEST_HOSTS}" != "10" ]; then
    cmd="${cmd} -t ${TEST_HOSTS}"
fi

# Add country filter if specified
if [ -n "${COUNTRY}" ]; then
    cmd="${cmd} -c ${COUNTRY}"
fi

# Add input file flag if specified
if [ -n "${INFILE}" ]; then
    cmd="${cmd} -i ${INFILE}"
fi

# Add netselect options if specified
if [ -n "${NETSELECT_OPTIONS}" ]; then
    cmd="${cmd} -O \"${NETSELECT_OPTIONS}\""
fi

# Execute the constructed command
echo "Executing: ${cmd}"
${cmd}