{
  "tcp_port": 5555,
  "usb_enabled": true,
  "tcp_enabled": false,
  "max_connections": 1,
  "adb_root_mode": "allow",
  "adb_auth_key": "/data/adb/adbd_key",
  "adb_log_level": "debug",
  "adb_server_port": 5037,
  "trusted_hosts": [
    "192.168.1.10",
    "10.0.0.5"
  ],
  "shell_timeout_ms": 15000,
  "adb_secure": true,
  "adb_tmp_dir": "/data/local/tmp",
  "usb_product_ids": [
    "0xABCD",
    "0x1234"
  ],
  "no_auto_start": false
}
