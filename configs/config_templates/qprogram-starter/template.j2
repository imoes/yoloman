# Configuration file for qprogram-starter
# Located at ~/.qprogram-starter/qprogram-starter.conf

# The executable name or absolute path of the program to launch.
program="{{ program | default('firefox') }}"

# List of command-line arguments to pass to the program.
# Defaults to an empty string if the list is empty or undefined.
arguments="{{ arguments | default([]) | join(' ') }}"

# Strftime format string for displaying the start date.
start_date_format="{{ start_date_format | default('%Y-%m-%d %H:%M:%S') }}"

# Path to the file where standard output is logged.
log_file="{{ log_file | default('/tmp/qprogram-starter.log') }}"

# Path to the file where standard error is logged.
error_log_file="{{ error_log_file | default('/tmp/qprogram-starter-error.log') }}"

# Whether to enable logging of output and errors.
enable_logging={{ enable_logging | default(true) | lower }}

# Shutdown method to use: gnome, kde, hal, consolekit, or sudo.
shutdown_method={{ shutdown_method | default('gnome') }}

# Path to the gnome-power-cmd script used by the gnome shutdown method.
gnome_power_cmd="{{ gnome_power_cmd | default('/usr/bin/gnome-power-cmd.sh') }}"

# User or group pattern allowed to use sudo for shutdown if method is sudo.
sudo_user="{{ sudo_user | default('*') }}"