{
  "program": "vlc",
  "arguments": [
    "--play-and-exit",
    "/home/user/video.mp4"
  ],
  "start_date_format": "%c",
  "log_file": "/var/log/qprogram-starter.log",
  "error_log_file": "/var/log/qprogram-starter-err.log",
  "enable_logging": true,
  "shutdown_method": "consolekit",
  "gnome_power_cmd": "/usr/bin/gnome-power-cmd.sh",
  "sudo_user": "admin"
}
