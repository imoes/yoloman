# TLP Radio Device Wizard (RDW) Configuration
# /etc/tlp-rdw.conf

# Enable or disable the Radio Device Wizard (RDW) functionality.
# When disabled, tlp-rdw commands are ignored or unavailable.
RDW_ENABLED={{ rdw_enabled | default(true) | lower }}

# List of radio device types to manage. Valid types: bluetooth, wifi, wwan.
# These devices will be toggled based on power state (AC/Battery).
RDW_DEVICES={{ rdw_devices | default(['bluetooth', 'wifi', 'wwan']) | join(',') }}

# Specify which radio devices to disable when running on Battery Power.
# Defaults to all RDW_DEVICES if empty.
# Format: comma-separated list of device types (e.g., 'wifi,bluetooth').
RDW_BATT_ENABLED_BY_DEFAULT={{ rdw_batt_enabled_by_default | default(['bluetooth', 'wifi']) | join(',') }}

# Specify which radio devices to disable when running on AC Power.
# Defaults to all RDW_DEVICES if empty.
# Format: comma-separated list of device types (e.g., 'wifi').
RDW_AC_ENABLED_BY_DEFAULT={{ rdw_ac_enabled_by_default | default([]) | join(',') }}