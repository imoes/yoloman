{
  "imap_host": {
    "type": "string",
    "default": "",
    "description": "IMAP server hostname (required)"
  },
  "imap_port": {
    "type": "number",
    "default": 993,
    "description": "IMAP server port (default: 993 for SSL)"
  },
  "imap_user": {
    "type": "string",
    "default": "",
    "description": "IMAP username (required)"
  },
  "imap_password": {
    "type": "string",
    "default": "",
    "description": "IMAP password (optional; prefer environment variables in production)"
  },
  "imap_use_ssl": {
    "type": "bool",
    "default": true,
    "description": "Use SSL/TLS for IMAP connection"
  },
  "imap_folder": {
    "type": "string",
    "default": "INBOX.Feeds",
    "description": "Target IMAP folder for feed items"
  },
  "cache_file": {
    "type": "string",
    "default": "~/.feed2imap.cache",
    "description": "Path to cache file for tracking processed items"
  },
  "feeds": {
    "type": "list",
    "default": [],
    "description": "List of RSS/Atom feed URLs to aggregate"
  },
  "timeout": {
    "type": "number",
    "default": 30,
    "description": "Network timeout in seconds"
  },
  "verbose": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level: 0 (quiet), 1 (default), 2 (verbose)"
  }
}
