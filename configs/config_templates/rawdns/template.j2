# rawdns: Upstart service definition for the rawdns utility
# rawdns acts as a raw DNS interface to the Docker API, allowing DNS queries
# to be resolved against Docker containers.

# -----------------------------------------------------------------------------
# Service Identification
# -----------------------------------------------------------------------------
# Description of the service job.
description "raw DNS interface to the Docker API"

# Author information.
author "Tianon Gravi <admwiggin@gmail.com>"

# -----------------------------------------------------------------------------
# Lifecycle Triggers
# -----------------------------------------------------------------------------
# Start this service when local filesystems are mounted.
start on local-filesystems

# Stop this service when entering runlevels other than 2, 3, 4, or 5.
stop on runlevel [!2345]

# -----------------------------------------------------------------------------
# Respawn Behavior
# -----------------------------------------------------------------------------
# Automatically restart the service if it exits unexpectedly.
respawn

# -----------------------------------------------------------------------------
# Execution Script
# -----------------------------------------------------------------------------
script
    # -----------------------------------------------------------------
    # Variable Definitions
    # -----------------------------------------------------------------
    # The base name of the service, used for binary, config, pid, and log files.
    # Defaults to the Upstart job name if not explicitly set.
    BINARY=/usr/bin/{{ base | default('$UPSTART_JOB') }}
    CONFIG=/etc/{{ base | default('$UPSTART_JOB') }}.json

    # -----------------------------------------------------------------
    # Configuration Loading
    # -----------------------------------------------------------------
    # If a default configuration file exists, source it to export
    # environment variables or override defaults for the binary.
    if [ -f /etc/default/{{ base | default('$UPSTART_JOB') }} ]; then
        . /etc/default/{{ base | default('$UPSTART_JOB') }}
    fi

    # -----------------------------------------------------------------
    # Service Launch
    # -----------------------------------------------------------------
    # Execute the rawdns binary with the JSON configuration file as an argument.
    exec "$BINARY" "$CONFIG"
end script

# vim:set ft=upstart:
