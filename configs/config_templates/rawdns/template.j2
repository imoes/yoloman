#!/bin/sh
set -e

### BEGIN INIT INFO
# Provides:           {{ base | default('rawdns') }}
# Required-Start:     $syslog $remote_fs
# Required-Stop:      $syslog $remote_fs
# Default-Start:      2 3 4 5
# Default-Stop:       0 1 6
# Short-Description:  raw DNS interface to the Docker API
# Description:
#  "rawdns" is a DNS forwarder that allows for DNS requests to return the IP
#  addresses of Docker containers directly.
### END INIT INFO

# Service configuration defaults
# base: The base name of the service (binary, config, pid, log files)
BASE=$(basename $0)

BINARY=/usr/bin/{{ base | default('rawdns') }}
CONFIG=/etc/{{ base | default('rawdns') }}.json
PIDFILE=/var/run/{{ base | default('rawdns') }}.pid
LOGFILE=/var/log/{{ base | default('rawdns') }}.log
DESC="{{ base | default('rawdns') }}"

. /lib/lsb/init-functions

# Load optional environment overrides from /etc/default/rawdns
if [ -f /etc/default/{{ base | default('rawdns') }} ]; then
	. /etc/default/{{ base | default('rawdns') }}
fi

# Upstart compatibility check
if init_is_upstart; then
	log_failure_msg "$BASE is managed via upstart, try using service $BASE $1"
	exit 1
fi

# Binary existence check
if [ ! -x "$BINARY" ]; then
	log_failure_msg "$BINARY not present or not executable"
	exit 1
fi

fail_unless_root() {
	if [ "$(id -u)" != '0' ]; then
		log_failure_msg "$DESC must be run as root"
		exit 1
	fi
}

case "$1" in
	start)
		fail_unless_root
		log_begin_msg "Starting $DESC"
		start-stop-daemon --start --background \
			--no-close \
			--exec "$BINARY" \
			--pidfile "$PIDFILE" \
			--make-pidfile \
			-- "$CONFIG" \
				>> "$LOGFILE" 2>&1
		log_end_msg $?
		;;
	
	stop)
		fail_unless_root
		log_begin_msg "Stopping $DESC"
		start-stop-daemon --stop --pidfile "$PIDFILE"
		log_end_msg $?
		;;
	
	restart|force-reload)
		fail_unless_root
		$0 stop
		$0 start
		;;
	
	status)
		status_of_proc -p "$PIDFILE" "$BINARY" "$DESC"
		;;
	
	*)
		echo "usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac