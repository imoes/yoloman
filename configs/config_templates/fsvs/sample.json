{
  "fsvs_urls": [
    {
      "url": "http://svn/repos/installation/machine-1/trunk",
      "name": "local",
      "prio": 10,
      "target": -1
    },
    {
      "url": "http://svn/repos/installation/common/trunk",
      "name": "common",
      "prio": 50,
      "target": -1,
      "readonly": true
    }
  ],
  "fsvs_ignore": [
    {
      "pattern": "/proc"
    },
    {
      "pattern": "/dev/pts"
    },
    {
      "pattern": "./**.bak",
      "mode": [
        "append"
      ]
    },
    {
      "pattern": "./**.tmp",
      "mode": [
        "at=1"
      ]
    }
  ],
  "fsvs_groups": [
    {
      "name": "unreadable",
      "criteria": [
        "mode:4:0"
      ],
      "mode": [
        "append"
      ]
    },
    {
      "name": "secrets",
      "criteria": [
        "group:secrets",
        "/etc/*shadow"
      ],
      "mode": [
        "prepend"
      ]
    }
  ],
  "fsvs_properties": [
    {
      "key": "fsvs:commit-pipe",
      "value": "/usr/local/bin/compress-and-backup.sh"
    }
  ]
}
