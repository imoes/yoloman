{
  "cache": {
    "disk": {
      "directory": "/var/cache/mapcache",
      "cleanup": {
        "enabled": true,
        "interval": 7200,
        "ttl": 172800
      }
    }
  },
  "tilesets": [
    {
      "name": "osm",
      "source": {
        "name": "osm-wms"
      },
      "format": "png",
      "meta_tiles": true,
      "grid": "global-mercator",
      "metadata": {
        "title": "OpenStreetMap",
        "abstract": "World map tiles from OSM"
      },
      "expires": 604800,
      "acl": {
        "allow": [
          "10.0.0.0/8",
          "192.168.0.0/16"
        ]
      }
    },
    {
      "name": "satellite",
      "source": {
        "name": "sentinel2"
      },
      "format": "jpeg",
      "meta_tiles": true,
      "grid": "global-mercator",
      "expires": 2592000
    }
  ],
  "sources": [
    {
      "name": "osm-wms",
      "type": "wms",
      "wms": {
        "url": "https://ows.terrestris.de/osm/service",
        "params": {
          "layers": "OSM-WMS",
          "transparent": "false",
          "version": "1.3.0"
        }
      },
      "timeout": 20,
      "retries": 2
    },
    {
      "name": "sentinel2",
      "type": "tilesource",
      "tilesource": {
        "url": "https://services.sentinel-hub.com/ogc/wmts/1.0.0/SENTINEL2_HUB/default/{Time}/{TileMatrixSet}/{TileMatrix}/{TileRow}/{TileCol}.jpeg"
      },
      "timeout": 45
    }
  ],
  "services": {
    "wms": {
      "enabled": true
    },
    "tms": {
      "enabled": true
    },
    "kml": {
      "enabled": false
    },
    "wmts": {
      "enabled": true
    },
    "ve": {
      "enabled": false
    }
  },
  "errors": {
    "report": "false"
  },
  "log": {
    "level": "info",
    "filepath": "/var/log/mapcache/mapcache.log"
  },
  "defaults": {
    "expires": 3600,
    "tile_cache": "disk"
  }
}
