# cdck configuration file
# This file configures cdck, a tool for testing CD/DVD drive read performance and integrity.

# Path to the CD/DVD device file (e.g., /dev/sr0, /dev/cdrom).
# This is the physical or virtual disc device that cdck will operate on.
device = {{ device | default('/dev/cdrom') }}

# If set to true, cdck will print information about the disc and exit immediately,
# without performing any read tests.
info_only = {{ info_only | default(false) }}

# If set to true, cdck performs a read timing test to measure drive performance.
# Note: This option is not valid for audio CDs.
timing_test = {{ timing_test | default(false) }}

# If set to true, cdck writes raw read data to the plot file for later analysis
# using gnuplot(1). This is useful for visualizing read errors or performance drops.
gnuplot = {{ gnuplot | default(false) }}

# Path to the file where raw data is written when gnuplot mode is enabled.
# Defaults to a relative path in the current working directory.
plot_file = {{ plot_file | default('./cdck-plot.dat') }}

# If set to true, cdck outputs detailed diagnostic messages to stderr,
# including progress and timing information.
verbose = {{ verbose | default(false) }}