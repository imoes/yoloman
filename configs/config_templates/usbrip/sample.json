{
  "default_domain": "my-server",
  "default_number_of_events": 50,
  "default_output_format": "table",
  "external_only": true,
  "quiet_mode": true,
  "debug_mode": false,
  "output_file": "/tmp/usbrip_output.txt",
  "target_url": "https://raw.githubusercontent.com/blacktop/usbids/master/usb.ids",
  "word_list": "",
  "parallel_tasks": 4,
  "extensions": "json,xml",
  "storage_type": "violations",
  "offline_search": false,
  "input_auth_file": "/etc/usbrip/auth.json",
  "output_auth_file": "/etc/usbrip/trusted.json",
  "input_dump_file": "/var/log/usbrip/dump.json",
  "domains": [
    "server1.example.com",
    "server2.example.com"
  ],
  "date_filters": [
    "2023-01-01",
    "2023-12-31"
  ],
  "vid_filters": [
    "0781",
    "1234"
  ],
  "pid_filters": [
    "5580",
    "abcd"
  ],
  "product_filters": [
    "Flash Drive",
    "Keyboard"
  ],
  "manufacturer_filters": [
    "SanDisk",
    "Logitech"
  ],
  "serial_filters": [
    "123456789",
    "987654321"
  ],
  "host_filters": [
    "Bob-PC",
    "Alice-PC"
  ],
  "port_filters": [
    "1-1",
    "2-2"
  ],
  "columns": [
    "conn",
    "vid",
    "pid",
    "disconn",
    "serial"
  ],
  "auth_attributes": [
    "vid",
    "pid"
  ],
  "history_files": [
    "/var/log/syslog.1",
    "/var/log/syslog.2.gz"
  ]
}
