# patool configuration wrapper
#
# This file documents the intended runtime configuration for a service or wrapper
# script utilizing the `patool` CLI tool. Note: `patool` itself does not read a
# standard system configuration file for these options. This template serves to
# standardize how these options are passed to the CLI in an automated environment.
#
# See patool(1) for full documentation:
# https://manpages.debian.org/trixie/patool/patool.1.en.html

# Level of verbosity (--verbose).
# 0 for normal, 1 for verbose, 2 for more verbose.
# https://manpages.debian.org/trixie/patool/patool.1.en.html#GLOBAL_OPTIONS
verbose_level = {{ verbose_level | default(0) }}

# Whether to use --non-interactive flag to prevent user prompts.
# This ensures the tool runs safely in automated pipelines without hanging.
# https://manpages.debian.org/trixie/patool/patool.1.en.html#GLOBAL_OPTIONS
non_interactive = {{ non_interactive | default(false) }}

# Default output directory for extract command (--outdir).
# If not specified in a command line, extracts will go here.
# https://manpages.debian.org/trixie/patool/patool.1.en.html#COMMANDS
extract_outdir = {{ extract_outdir | default('.') }}

# Shell alias string for patool list.
# Defines the short command used to list archive contents.
# https://manpages.debian.org/trixie/patool/patool.1.en.html#SHELL_ALIASES
alias_list = {{ alias_list | default('pl') }}

# Shell alias string for patool extract.
# Defines the short command used to extract archives.
# https://manpages.debian.org/trixie/patool/patool.1.en.html#SHELL_ALIASES
alias_extract = {{ alias_extract | default('px') }}

# Shell alias string for patool create.
# Defines the short command used to create archives.
# https://manpages.debian.org/trixie/patool/patool.1.en.html#SHELL_ALIASES
alias_create = {{ alias_create | default('pc') }}

# Shell alias string for patool diff.
# Defines the short command used to compare archives.
# https://manpages.debian.org/trixie/patool/patool.1.en.html#SHELL_ALIASES
alias_diff = {{ alias_diff | default('pd') }}