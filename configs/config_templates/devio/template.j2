# devio(1) configuration template
# This file configures the devio command-line utility.
# devio is a simple I/O benchmarking tool.

{% if options is defined and options is iterable %}
# List of command-line options passed to devio(1)
# Each item must be a valid argument string (e.g., '--help', '-v')
# per GNU long-option syntax.
/devio {{ options | join(' ') }}
{% else %}
# No options specified; running devio with defaults.
/devio
{% endif %}