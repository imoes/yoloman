{
  "authmodulepath": "/usr/lib/courier-authlib",
  "authmodule": [
    "authmysql",
    "authpam"
  ],
  "minprocs": 5,
  "maxdaemons": 30,
  "daemontimeout": 300,
  "debug": true,
  "syslog_facility": "authpriv",
  "usepam": true,
  "pam_service": "courier-auth",
  "logfile": "/var/log/courier/authdaemon.log",
  "module_instances": [
    {
      "comment": "MySQL authentication backend configuration",
      "config": {
        "MYSQL_SERVER": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USERNAME": "authuser",
        "MYSQL_PASSWORD": "secret123",
        "MYSQL_DATABASE": "mail",
        "MYSQL_USER_TABLE": "users",
        "MYSQL_CRYPT_PWFIELD": "password",
        "MYSQL_UID_FIELD": "uid",
        "MYSQL_GID_FIELD": "gid",
        "MYSQL_HOME_FIELD": "homedir",
        "MYSQL_MAILDIR_FIELD": "maildir",
        "MYSQL_QUOTA_FIELD": "quota",
        "MYSQL_SELECT_CLAUSE": "SELECT username, password, '', uid, gid, homedir, maildir, quota, '' FROM users WHERE username = '@'"
      }
    }
  ]
}
