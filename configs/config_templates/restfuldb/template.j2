# ==============================================================================
# restfuldb Apache VirtualHost / Directory Configuration Template
# ==============================================================================
# This template generates an Apache configuration for the 'restfuldb' application.
# It handles URL rewriting for CGI scripts, SSL renegotiation for large uploads,
# and conditional authentication based on SSL client verification status.
# ==============================================================================

# --------------------------------------------------------------------------
# Document Root Alias
# --------------------------------------------------------------------------
# Sets the URL path alias to the application's document root directory.
# Schema field: document_root
Alias /restfuldb {{ document_root | default('/usr/share/restfuldb') }}

# --------------------------------------------------------------------------
# Directory Configuration Block
# --------------------------------------------------------------------------
# Configures access, rewriting, and security policies for the document root.
<Directory {{ document_root | default('/usr/share/restfuldb') }}>
    
    # Enable Apache's mod_rewrite engine for URL manipulation.
    RewriteEngine On

    # ----------------------------------------------------------------------
    # Rewrite Rules: Static Assets
    # ----------------------------------------------------------------------
    # An exception has to be made for CSS files to prevent them from being
    # routed to the CGI handler.
    # Matches paths like /restfuldb/styles/default/style.css
    RewriteRule ^(styles/default/.*.css)$  $1  [L]

    # ----------------------------------------------------------------------
    # Rewrite Rules: Static HTML
    # ----------------------------------------------------------------------
    # Serve index.html directly if requested as 'index' (no extension).
    RewriteRule ^index$                             index.html          [QSA,L]
    
    # Serve index.html directly if requested as 'index.html'.
    RewriteRule ^index.html$                        index.html          [QSA,L]

    # ----------------------------------------------------------------------
    # Rewrite Rules: CGI Routing (Level 1)
    # ----------------------------------------------------------------------
    # Routes single-path segments to the tables listing script.
    # Example: /restfuldb/movies -> /cgi-bin/restfuldb-tables.pl
    RewriteRule ^([^\/]+)$                          /cgi-bin/restfuldb-tables.pl   [QSA,L]

    # ----------------------------------------------------------------------
    # Rewrite Rules: CGI Routing (Level 2)
    # ----------------------------------------------------------------------
    # Routes two-path segments to the database detail script.
    # Example: /restfuldb/movies/123 -> /cgi-bin/restfuldb-db.pl
    RewriteRule ^([^\/]+)/([^\/\.]+)$               /cgi-bin/restfuldb-db.pl       [QSA,L]

    # ----------------------------------------------------------------------
    # Rewrite Rules: CGI Routing (Level 3)
    # ----------------------------------------------------------------------
    # Routes three-path segments to the modification script.
    # Example: /restfuldb/movies/123/edit -> /cgi-bin/restfuldb-modify.pl
    RewriteRule ^([^\/]+)/([^\/\.]+)/([^\/]+)$      /cgi-bin/restfuldb-modify.pl   [QSA,L]

    # ----------------------------------------------------------------------
    # Rewrite Rules: CGI Routing (Level 4)
    # ----------------------------------------------------------------------
    # Routes four-path segments to the image retrieval script.
    # Example: /restfuldb/movies/123/img/thumb -> /cgi-bin/restfuldb-image.pl
    RewriteRule ^([^\/]+)/([^\/\.]+)/([^\/]+)/([^\/]+)$ /cgi-bin/restfuldb-image.pl    [QSA,L]

    # ----------------------------------------------------------------------
    # Rewrite Rules: Not Found / Fallback
    # ----------------------------------------------------------------------
    # Levels 1 through 4 are redirected to the respective CGI scripts above.
    # This rule catches deeper paths (5+ levels) and redirects to a not-found
    # script, passing the suffix and maximum starting level for logging/error handling.
    # Schema fields involved: (implicit logic based on URL structure)
    RewriteRule ^([^\/]+)/([^\/\.]+)/([^\/]+)/([^\/]+)/(.*)$ /cgi-bin/restfuldb-notfound.pl?suffix=$5&starting_level=4  [L]

    # Note: The following rule for generic CGI execution is currently commented out.
    # RewriteRule cgi$                        cgi-bin/cgi.pl

    # --------------------------------------------------------------------------
    # SSL / Large Upload Configuration
    # --------------------------------------------------------------------------
    # Allow uploads of large files via SSL renegotiation.
    # See: https://bz.apache.org/bugzilla/show_bug.cgi?id=39243
    # Schema field: ssl_reneg_buffer_size
    SSLRenegBufferSize {{ ssl_reneg_buffer_size | default('13107200') }}

    # Require SSL for the entire directory.
    SSLRequireSSL

    # Configure SSL client verification.
    # 'optional' allows connections without a client cert, falling back to
    # other auth methods (like Basic Auth) defined later.
    SSLVerifyClient optional
    SSLVerifyDepth 3

    # --------------------------------------------------------------------------
    # Conditional Authentication Logic
    # --------------------------------------------------------------------------

    # CASE 1: Valid SSL Client Certificate
    # If the SSL client certificate verification succeeded, trust the client
    # and identify them by their Common Name (CN).
    <If "%{SSL:SSL_CLIENT_VERIFY} == 'SUCCESS'" >
        # SSLUserName maps the Apache REMOTE_USER variable to the CN of the
        # client certificate. This allows CGI scripts to know who the user is
        # without a password prompt.
        SSLUserName SSL_CLIENT_S_DN_CN
        
        # Restrict access to clients who successfully passed SSL verification.
        Require ssl-verify-client 
    </If>

    # CASE 2: Invalid/No SSL Cert BUT Read-Only Access (GET)
    # If SSL verification failed (or no cert) but the request is a GET,
    # allow access ('Satisfy any') so that unauthenticated users can
    # browse the database (if permitted by other rules).
    <ElseIf "%{SSL:SSL_CLIENT_VERIFY} != 'SUCCESS' && %{REQUEST_METHOD} == 'GET'" >
        Satisfy any
    </ElseIf>

    # CASE 3: Write Access / No SSL Cert (POST/PUT/etc.)
    # If SSL verification failed AND it's not a GET request (e.g., POST to modify data),
    # require Basic Authentication.
    <Else>
        AuthType basic
        AuthName "Editing a database requires authentication"
        AuthBasicProvider file
        
        # Path to the htpasswd file containing valid users for Basic Auth.
        # Schema field: auth_user_file
        AuthUserFile "{{ auth_user_file | default('/etc/restfuldb/htpasswd') }}"
        
        # Enable FakeBasicAuth to simulate Basic Auth headers over SSL if needed,
        # though standard Basic Auth is used here.
        SSLOptions +FakeBasicAuth

        # Require a valid user from the AuthUserFile.
        Require valid-user
    </Else>

</Directory>
