# ==============================================================================
# pristine-tar Environment Configuration Template
# ==============================================================================
# This template configures global defaults for the `pristine-tar` command-line tool.
# pristine-tar is used in Debian packaging to manage pristine upstream tarballs.
#
# Variables:
#   tmpdir: Path to a directory for temporary files.
#   pristine_tar_opts: Default command-line options for pristine-tar.
#   xdelta_tool: The delta compression tool to use (xdelta3 or xdelta).
# ==============================================================================

# ------------------------------------------------------------------------------
# Temporary Directory
# ------------------------------------------------------------------------------
# Specifies the location to place temporary files, other than the default.
# This overrides the system default temporary directory for pristine-tar operations.
#
# Variable: tmpdir
# Default: /tmp
# ------------------------------------------------------------------------------
TMPDIR={{ tmpdir | default('/tmp') }}

# ------------------------------------------------------------------------------
# Default Options
# ------------------------------------------------------------------------------
# Defines default command line options to be assumed by pristine-tar.
# Overrides the PRISTINE_TAR environment variable if set via CLI.
# Options are split on whitespace; use --opt=arg syntax for arguments.
#
# Variable: pristine_tar_opts
# Default: --verbose
# ------------------------------------------------------------------------------
PRISTINE_TAR={{ pristine_tar_opts | default('--verbose') }}

# ------------------------------------------------------------------------------
# Delta Tool Selection
# ------------------------------------------------------------------------------
# Defines the underlying binary delta tool to be used for new deltas.
# Supported values are "xdelta3" (default) and "xdelta".
#
# Variable: xdelta_tool
# Default: xdelta3
# ------------------------------------------------------------------------------
PRISTINE_ALL_XDELTA={{ xdelta_tool | default('xdelta3') }}