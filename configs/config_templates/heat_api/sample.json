{
  "name": "heat",
  "log_level": "INFO",
  "log_dir": "/var/log/heat",
  "log_file": "heat-api.log",
  "use_syslog": false,
  "syslog_log_facility": "LOG_USER",
  "bind_host": "192.168.10.5",
  "bind_port": 8004,
  "paste_config": "/etc/heat/api-paste.ini",
  "connection": "mysql+pymysql://heat:HeatDbPass@192.168.10.20/heat",
  "auth_protocol": "https",
  "auth_host": "keystone.internal.example.com",
  "auth_port": 35357,
  "auth_uri": "https://keystone.internal.example.com:5000/v3",
  "project_domain_name": "Default",
  "user_domain_name": "Default",
  "project_name": "service",
  "username": "heat",
  "password": "HeatServicePass123",
  "interface": "internal",
  "cafile": "/etc/ssl/certs/ca-certificates.crt",
  "insecure": false,
  "auth_type": "password",
  "endpoint_type": "internal",
  "auth_uri_ec2": "https://keystone.internal.example.com:5000/v2.0/ec2tokens",
  "driver": "messagingv2",
  "topic": "notifications",
  "rabbit_host": "rabbitmq.internal.example.com",
  "rabbit_port": 5672,
  "rabbit_userid": "openstack",
  "rabbit_password": "RabbitMqPass123",
  "rabbit_virtual_host": "/",
  "rabbit_use_ssl": true,
  "heartbeat_timeout_threshold": 60,
  "heartbeat_rate": 2,
  "policy_file": "/etc/heat/policy.json",
  "policy_default_rule": "default",
  "lock_path": "/var/lib/heat/tmp",
  "backend": "dogpile.cache.redis",
  "url": "redis://:RedisPass123@redis.internal.example.com:6379/0",
  "expiration_time": 600,
  "enabled": true
}
