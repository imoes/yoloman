{
  "font": "Inter 11",
  "icon_dir": "/usr/share/icons/hicolor/24x24/apps",
  "history_size": 100,
  "timeout": 6,
  "max_lines": 4,
  "max_visible": 5,
  "offset_x": 20,
  "offset_y": 20,
  "corner_radius": 6,
  "bold_title": true,
  "italic_body": false,
  "underline_actions": false,
  "show_close_button": true,
  "show_timestamp": true,
  "styles": [
    {
      "app_name": "firefox",
      "summary_regex": ".*Download.*",
      "style": "color:#2e7d32 background:rgba(255,255,255,0.1)"
    },
    {
      "app_name": "discord",
      "summary_regex": ".*Mentioned.*",
      "style": "color:#5865F2 background:rgba(88,101,242,0.15)"
    }
  ],
  "log_level": "warning",
  "custom_config": ""
}
