[config]
# Font name and size for notifications (Pango font description)
font = {{ font }}

# Path to the notification icon directory (optional; uses built-in defaults if omitted)
{% if icon_dir %}icon_dir = {{ icon_dir }}{% else %}# icon_dir = /usr/share/icons/hicolor/24x24/apps{% endif %}

# Maximum number of notifications to keep in history (0 = unlimited)
history_size = {{ history_size }}

# Timeout (in seconds) before a notification automatically fades out
{% if timeout %}timeout = {{ timeout }}{% else %}# timeout = 5{% endif %}

# Maximum number of lines per notification (0 = unlimited)
max_lines = {{ max_lines }}

# Number of notifications to display at once (0 = show all)
max_visible = {{ max_visible }}

# Horizontal offset from screen edge (in pixels)
offset_x = {{ offset_x }}

# Vertical offset from screen edge (in pixels)
offset_y = {{ offset_y }}

# Notification corner radius (0 = no rounding)
corner_radius = {{ corner_radius }}

# Enable bold text for summary/title
bold_title = {% if bold_title %}true{% else %}false{% endif %}

# Enable italics for message body
italic_body = {% if italic_body %}true{% else %}false{% endif %}

# Enable underlined actions (e.g., button labels)
underline_actions = {% if underline_actions %}true{% else %}false{% endif %}

# Enable or disable the close button on notifications
show_close_button = {% if show_close_button %}true{% else %}false{% endif %}

# Enable or disable the timestamp (Unix epoch) display
show_timestamp = {% if show_timestamp %}true{% else %}false{% endif %}

# List of custom styles (one per line) — applies to matching notifications
# Each item has 'app_name' (exact match), 'summary_regex' (PCRE), and 'style' (comma-separated CSS-like properties)
{% for style in styles %}# app={{ style.app_name }}, summary={{ style.summary_regex }}, style={{ style.style }}
{% endfor %}

# Logging level: 'debug', 'info', 'warning', 'error'
{% if log_level %}log_level = {{ log_level }}{% else %}# log_level = info{% endif %}

# Path to custom config file (optional; overrides defaults)
{% if custom_config %}config_file = {{ custom_config }}{% else %}# config_file = /etc/fnott/config.ini{% endif %}
