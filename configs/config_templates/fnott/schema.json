{
  "output": {
    "type": "string",
    "default": "",
    "description": "Output (display) to place notifications on (e.g., 'eDP-1')"
  },
  "min_width": {
    "type": "number",
    "default": 0,
    "description": "Minimum notification width in pixels (0 = no minimum)"
  },
  "max_width": {
    "type": "number",
    "default": 0,
    "description": "Maximum notification width in pixels (0 = no maximum)"
  },
  "max_height": {
    "type": "number",
    "default": 0,
    "description": "Maximum notification height in pixels (0 = no maximum)"
  },
  "stacking_order": {
    "type": "string",
    "default": "bottom-up",
    "description": "Stacking order of notifications: 'bottom-up' or 'top-down'",
    "enum": [
      "bottom-up",
      "top-down"
    ]
  },
  "anchor": {
    "type": "string",
    "default": "top-right",
    "description": "Screen edge anchor for notifications (e.g., 'top-right', 'bottom-left')"
  },
  "edge_margin_vertical": {
    "type": "number",
    "default": 10,
    "description": "Vertical margin (pixels) from the screen edge"
  },
  "edge_margin_horizontal": {
    "type": "number",
    "default": 10,
    "description": "Horizontal margin (pixels) from the screen edge"
  },
  "notification_margin": {
    "type": "number",
    "default": 10,
    "description": "Vertical margin between stacked notifications (pixels)"
  },
  "icon_theme": {
    "type": "string",
    "default": "hicolor",
    "description": "Icon theme name (e.g., 'hicolor', 'Adwaita')"
  }
}
