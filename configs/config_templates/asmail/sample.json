{
  "mailboxes": [
    {
      "name": "Work Unix Mailbox",
      "type": "unix",
      "path": "/var/mail/developer",
      "timeout": 45,
      "show_counts": true
    },
    {
      "name": "Home Maildir",
      "type": "maildir",
      "path": "~/Maildir",
      "show_counts": false
    },
    {
      "name": "Project MH",
      "type": "mh",
      "path": "~/Mail/project",
      "use_mh_sequences": true,
      "timeout": 60
    },
    {
      "name": "POP3 Account",
      "type": "pop3",
      "server": "pop.example.com",
      "port": 995,
      "user": "user@example.com",
      "password": "secret",
      "timeout": 30,
      "show_counts": true,
      "icon_empty": "/usr/share/icons/pop_empty.xpm",
      "icon_full": "/usr/share/icons/pop_full.xpm"
    },
    {
      "name": "IMAP Inbox",
      "type": "imap",
      "server": "imap.gmail.com",
      "port": 993,
      "user": "user@gmail.com",
      "password": "app-password",
      "folder": "INBOX",
      "timeout": 45,
      "show_counts": true
    }
  ]
}
