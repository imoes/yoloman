# Email recipient for cron job output (e.g., 'root' or 'admin@example.com')
MAILTO={{ (mailto | default('root')) | string }}

# Absolute path to the poller error log file
# The cron job runs the Cacti poller every 5 minutes as www-data.
# Output is logged to the specified file using ts (if available) or tee for timestamping.
*/5 * * * * www-data php /usr/share/cacti/site/poller.php 2>&1 >/dev/null | if [ -f /usr/bin/ts ] ; then ts ; else tee ; fi >> {{ (poller_log_file | default('/var/log/cacti/poller-error.log')) | string }}

# it is recommended to regularly refresh the csrf key; however, as
# that potentially impacts user experience, it should be done during
# non-production hours. As the cacti package doesn't know when that is
# on this system, this cron entry serves as an example that should be
# adjusted to a proper time and enabled.
#30 2 * * sat www-data /usr/share/cacti/cli/refresh_csrf.php
