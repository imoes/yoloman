{
  "default_file": "/home/user/presentations/quarterly_review.pdf",
  "talk_time": "45:00",
  "log_level": "INFO",
  "notes_position": "right",
  "vlc": {
    "enabled": false
  },
  "gstreamer": {
    "enabled": true
  },
  "layout": {
    "notes": {
      "children": [
        {
          "children": [
            "current",
            "notes"
          ],
          "proportions": [
            0.5,
            0.5
          ],
          "orientation": "horizontal",
          "resizeable": true
        },
        "next"
      ],
      "proportions": [
        0.5,
        0.5
      ],
      "orientation": "vertical",
      "resizeable": true
    }
  },
  "keybindings": {
    "next_slide": "<Control>Right",
    "prev_slide": "<Control>Left",
    "fullscreen": "F",
    "quit": "<Control>q"
  },
  "cache_size": 150,
  "auto_reload": true,
  "auto_fullscreen": true,
  "theme_name": ""
}
