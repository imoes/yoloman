# Configuration for ucrpf1host
# The TCP port number for the ucrpf1host service to listen on.
PORT={{ (port | default(8080)) }}

# The hostname or IP address of the Panowin F1 3D printer.
HOST={{ (host | default('localhost')) }}

# The serial device path for direct printer communication.
DEVICE={{ (device | default('/dev/ttyUSB0')) }}

# The baud rate for serial communication with the printer.
BAUD_RATE={{ (baud_rate | default(115200)) }}

# Whether to enable verbose logging output.
VERBOSE={{ (verbose | default(false)) }}