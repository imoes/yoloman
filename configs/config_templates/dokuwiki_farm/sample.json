{
  "farm_dir": "/var/lib/dokuwiki/farm",
  "farm_base_domain": "wiki.example.com",
  "url_detection_mode": "domain",
  "default_animal": "main",
  "animals": [
    {
      "key": "main",
      "dir": "main",
      "base_url": "https://main.wiki.example.com",
      "description": "Main company wiki \u2014 general knowledge base"
    },
    {
      "key": "it",
      "dir": "it",
      "base_url": "https://it.wiki.example.com",
      "description": "IT department runbooks and infrastructure docs"
    },
    {
      "key": "hr",
      "dir": "hr",
      "base_url": "https://hr.wiki.example.com",
      "description": "HR policies, onboarding guides and org charts"
    }
  ],
  "memory_limit": "256M",
  "upload_max_filesize": "32M",
  "post_max_size": "32M",
  "max_execution_time": 120,
  "session_cookie_lifetime": 0,
  "session_gc_maxlifetime": 1440,
  "session_cookie_secure": true,
  "error_reporting_mask": "E_ALL & ~E_NOTICE",
  "display_errors": false
}
