# List of SINIT ACM files to load for Intel TXT.
# These files are loaded by GRUB to initialize tboot (Trusted Boot).
# Wildcards are used to match relevant SINIT files in /boot.
# Note: Each file is loaded twice to workaround a grub/tboot overlap issue.
# See: https://sourceforge.net/p/tboot/mailman/message/37340469/
GRUB_TBOOT_SINIT_LIST='{{ grub_tboot_sinit_list | default("/boot/*sinit* /boot/*SINIT* /boot/*sinit* /boot/*SINIT*") }}'