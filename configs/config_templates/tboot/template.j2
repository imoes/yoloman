# tboot configuration for GRUB
# This file configures the initial SINIT ACM files loaded by GRUB to enable
# Intel Trust Execution Technology (TXT) with tboot.
#
# The SINIT ACM (Authenticated Control Module) is a binary blob that must be
# loaded into Intel TXT launchable memory to establish the root of trust.
# tboot requires these files to be specified in GRUB's configuration.
#
# Note: Each ACM is typically loaded twice in the GRUB menu entry to work
# around a known issue where GRUB might load an ACM to an address overlapping
# with tboot's data structures. See:
# https://sourceforge.net/p/tboot/mailman/message/37340469/

# List of SINIT ACM files to load for Intel TXT.
# Wildcards are used to match relevant SINIT files in /boot.
# Default matches standard naming conventions for SINIT modules.
#
# Variable: grub_tboot_sinit_list
# Schema description: List of SINIT ACM files to load for Intel TXT, used by GRUB to initialize tboot. Wildcards are used to match relevant SINIT files in /boot.
GRUB_TBOOT_SINIT_LIST='{{ grub_tboot_sinit_list | default("/boot/*sinit* /boot/*SINIT* /boot/*sinit* /boot/*SINIT*") }}'
