# moosefs-cgiserv configuration template
# Managed by Ansible. Do not edit manually.
#
# This file configures the MooseFS CGI service (mfscgiserv).
# See mfscgiserv(8) for full documentation.

# User account under which the mfscgiserv daemon will run.
# Default: nobody
# MFSCGISERV_USER={{ mfscgiserv_user | default('nobody') }}

# Group account under which the mfscgiserv daemon will run.
# Default: nogroup
# MFSCGISERV_GROUP={{ mfscgiserv_group | default('nogroup') }}

# Network address for the CGI service to bind/listen on.
# Use 'any' (or '0.0.0.0') to listen on all interfaces, or a specific IP.
# Default: localhost
# BIND_HOST={{ mfscgiserv_bind_host | default('localhost') }}

# TCP port for the CGI service to listen on.
# Default: 9425
# BIND_PORT={{ mfscgiserv_bind_port | default(9425) }}

# Local filesystem path serving as the HTTP document root for the CGI service.
# This path should contain the CGI scripts and static assets.
# Default: /usr/share/moosefs-cgi
# ROOT_PATH={{ mfscgiserv_root_path | default('/usr/share/moosefs-cgi') }}

# Additional command-line options passed directly to the mfscgiserv daemon.
# Leave empty for defaults, or provide a quoted string of flags.
# Default: ''
DAEMON_OPTS="{{ mfscgiserv_daemon_opts | default('') }}"