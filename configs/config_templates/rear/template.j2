# Relax-and-Recover (ReaR) local configuration file.
# This file is intended for manual configuration. For automated management,
# consider using a site.conf file alongside this one, as upstream ReaR
# does not ship a site.conf and will not overwrite local.conf.
#
# ReaR reads configuration files using the bash 'source' builtin.
# Therefore, syntax MUST be valid bash: VARIABLE="value" (no spaces around '=').
# You may use bash logic (e.g., conditionals) within this file, but ensure
# commands do not fail unexpectedly during rescue media creation or restoration.
#
# Detailed documentation is available in:
#   /usr/share/rear/conf/default.conf
# Example configurations can be found in:
#   /usr/share/rear/conf/examples/

# OUTPUT: Output type for ReaR rescue medium, e.g., ISO, USB_GENERIC, NETFS.
# The default creates an ISO image.
OUTPUT="{{ OUTPUT | default('ISO') }}"

# BACKUP: Backup method for data, e.g., NETFS, TAR, LVM2, etc.
# Note: The default 'REQUESTRESTORE' is a placeholder and does not perform actual backups.
# You must specify your particular backup and restore method for your data.
BACKUP="{{ BACKUP | default('REQUESTRESTORE') }}"
