# Relax-and-Recover (ReaR) local configuration file.
# This file is sourced by the ReaR bash script, so variables must be
# assigned using standard Bash syntax: VARIABLE="value" (no spaces around '=').
# See /usr/share/rear/conf/default.conf for a full list of available variables.

# OUTPUT=<type>
# Specifies the output type for the ReaR rescue medium.
# Determines how the recovery environment is created (e.g., as an ISO image,
# a USB stick, or network files).
# Possible values include: ISO, USB_GENERIC, NETFS, etc.
# Default is 'ISO'.
OUTPUT="{{ OUTPUT | default('ISO') }}"

# BACKUP=<method>
# Specifies the backup method to use for data backup and restore operations.
# This directive tells ReaR which backup/restore backend plugin to invoke.
# Note: The default 'REQUESTRESTORE' is a placeholder and does not perform
# actual backups; you must specify a real method like NETFS, TAR, LVM2, etc.
BACKUP="{{ BACKUP | default('REQUESTRESTORE') }}"