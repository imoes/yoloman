{{ '# The primary tables are: Bridge, Port, Interface, Controller, SSL, Mirror, Flow_Table, NetFlow, sFlow, IPFIX, Flow_Sample_Collection_Set, Collector_Set, Mirrors, QoS, Queue, SSL, Certificate, CA_Cert, Client_Cert, Private_Key, Server_Cert, Bootstrap_Cert_Key, System, Open_vSwitch, Manager, Target, Backup, Rollback, Version, UUID' }}

{{ '# Example row from Bridge table (created via ovs-vsctl add-br)' }}
{% for bridge in bridges %}
{{ '# Bridge: ' + bridge.name }}
{{ '#   - UUID: ' + bridge.uuid }}
{{ '#   - fail_mode: ' + bridge.fail_mode }}
{{ '#   - stp_enable: ' + (bridge.stp_enable | string) }}
{% if bridge.flood_vlans is defined and bridge.flood_vlans | length > 0 %}
{{ '#   - flood_vlans: ' + (bridge.flood_vlans | join(', ')) }}
{% endif %}
{% endfor %}

{{ '# Example row from Port table (created via ovs-vsctl add-port)' }}
{% for port in ports %}
{{ '# Port: ' + port.name }}
{{ '#   - bridge: ' + port.bridge }}
{{ '#   - interfaces: ' + (port.interfaces | join(', ')) }}
{% if port.trunks is defined and port.trunks | length > 0 %}
{{ '#   - trunks: ' + (port.trunks | join(', ')) }}
{% endif %}
{% endfor %}

