{
  "format_inputdate": "4",
  "format_outputdate": "%Y-%m-%d",
  "general_autogc": true,
  "daemon_enable": false,
  "notify_hours_before": 48,
  "notify_popup_cmd": "notify-send 'calcurse' '%s'",
  "keys_enabled": true,
  "keys_bindings": [
    {
      "key": "F1",
      "action": "help"
    },
    {
      "key": "F2",
      "action": "apts"
    },
    {
      "key": "F3",
      "action": "todo"
    }
  ],
  "hooks_enabled": true,
  "hooks_list": [
    {
      "name": "pre-load",
      "path": "/home/user/.config/calcurse/hooks/pre-load"
    },
    {
      "name": "post-save",
      "path": "/home/user/.config/calcurse/hooks/post-save"
    }
  ]
}
