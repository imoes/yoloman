# Defaults for dns-flood-detector initscript
# sourced by /etc/init.d/dns-flood-detector
# installed at /etc/default/dns-flood-detector by the maintainer scripts

# Command-line options passed to the dns-flood-detector daemon.
# Common flags include:
#   -d : Run as a daemon (background)
#   -v : Increase verbosity (use multiple times for more detail)
#   -t : Threshold for flood detection (packets per second)
#   -w : Window size for threshold calculation (seconds)
# Default is set to '-d -v -v -t5 -w3'
DAEMON_OPTS="{{ (daemon_opts | default('-d -v -v -t5 -w3')) | string }}"