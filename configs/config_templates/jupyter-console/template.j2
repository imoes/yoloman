# Jupyter Console Configuration
# This file configures the runtime behavior of jupyter-console.
# It is managed by Ansible; do not edit manually.

# Connect to an existing kernel by its connection file ID.
# If empty, jupyter-console will connect to the most recently started kernel.
# Corresponds to --existing <file_id> option.
existing_kernel = '{{ existing_kernel | default("") }}'

# If true, skips the interactive confirmation prompt when exiting the console.
# Useful for non-interactive or script-driven sessions.
# Corresponds to --no-confirm-exit option.
no_confirm_exit = {{ no_confirm_exit | default(false) | lower }}

# The name of the language kernel to start or use (e.g., python3, julia, ir).
# Corresponds to --kernel <name> option.
kernel_name = '{{ kernel_name | default("python3") }}'

# If true, enables verbose debugging output to stderr.
# Corresponds to --debug option.
debug = {{ debug | default(false) | lower }}