# ~/.claws-mail/clawsrc
# Main Claws Mail configuration file
# This template configures the pgpmime plugin for Claws Mail.
[main]
# Path to Claws Mail plugins directory; pgpmime.so is typically installed in this path.
plugin_path={{ plugin_path | default('~/.claws-mail/plugins') }}

{% if enable_plugin | default(False) %}
[plugins]
# Enable pgpmime plugin explicitly. When enabled, this section ensures the
# pgpmime plugin is loaded on startup.
pgpmime=1
{% endif %}

# GnuPG configuration file location (system-wide or user-specific)
# See gpg(1) and gpgconf(1) man pages for gpg.conf options
[gpg]
# Path to the GnuPG configuration file used by pgpmime for signature verification and decryption.
gpg_conf={{ gpg_conf | default('~/.gnupg/gpg.conf') }}