{
  "config_file": ".config/ansible-lint.yml",
  "exclude_paths": [
    "roles/*/tests/",
    "vendor/",
    "**/.git/"
  ],
  "rules_dir": [
    "./custom_rules/"
  ],
  "format": "codeclimate",
  "profile": "production",
  "skip_list": [
    "name[missing]",
    "yaml[line-length]"
  ],
  "warn_list": [
    "experimental",
    "jinja[spacing]"
  ],
  "enable_list": [
    "fqcn"
  ],
  "write_list": "all",
  "sarif_file": "ansible-lint.sarif",
  "ignore_file": ".ansible-lint-ignore",
  "strict": true,
  "parseable": false,
  "show_relpath": true,
  "offline": false,
  "force_color": false,
  "no_color": false
}
