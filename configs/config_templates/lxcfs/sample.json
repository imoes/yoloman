{
  "bin_dir": "/usr/bin",
  "mount_point": "/var/lib/lxcfs",
  "pid_user": "lxcfs",
  "pid_group": "lxcfs",
  "pid_file": "/run/lxcfs.pid",
  "num_threads": 4,
  "debug": false,
  "libvirt_support": false,
  "cgroupv2": true,
  "bind_mounts": [
    {
      "source": "/etc/localtime",
      "target": "/etc/localtime"
    },
    {
      "source": "/etc/timezone",
      "target": "/etc/timezone"
    }
  ],
  "pam_service": "",
  "follow_symlinks": false,
  "namespace_support": true
}
