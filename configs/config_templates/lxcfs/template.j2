#!/bin/sh

### BEGIN INIT INFO
# Short-Description:    FUSE filesystem for LXC
# Description:          FUSE filesystem for LXC
# Provides:             lxcfs
# Required-Start:       $remote_fs
# Required-Stop:        $remote_fs
# Should-Start:         cgroupfs-mount
# Should-Stop:          cgroupfs-mount
# Default-Start:        2 3 4 5
# Default-Stop:         0 1 6
### END INIT INFO

# ==============================================================================
# LXCFS Init Script - Ansible Managed
# ==============================================================================
# This script manages the LXCFS daemon. LXCFS provides a FUSE filesystem
# that emulates /proc, /sys, and /etc/hostname to improve container resource
# visibility and isolation.
#
# Configuration variables are derived from the Ansible role variables.
# See the schema definition for defaults and descriptions.
# ==============================================================================

# bin_dir: Directory containing the lxcfs binary.
DAEMON={{ bin_dir | default('/usr/bin') }}/lxcfs

NAME=lxcfs
DESC="FUSE filesystem for LXC"

# pid_file: Path to the PID file for the lxcfs daemon.
PIDFILE={{ pid_file | default('/run/lxcfs.pid') }}

# OOM_SCORE_ADJ: Adjust the Out-Of-Memory score to protect the daemon.
OOM_SCORE_ADJ="-1000"

. /lib/lsb/init-functions

test -f ${DAEMON} || exit 0

set -e

# Construct the start arguments.
# -m: Mount the filesystem.
# --start: Start the daemon.
# --quiet: Reduce verbosity.
# --pidfile: Specify the PID file path.
# --name: Service name.
# --startas: Path to the actual binary.
# --background: Run in background.
START="-m --start --quiet --pidfile ${PIDFILE} --name ${NAME} --startas $DAEMON --background"

case "$1" in
    start)
        if init_is_upstart; then
            exit 1
        fi

        # mount_point: Mount point for the LXCFS FUSE filesystem.
        # Must exist and be accessible by the lxcfs process.
        # Don't start if the mount point structure already exists (indicating previous mount).
        [ ! -d {{ mount_point | default('/var/lib/lxcfs') }}/proc ] || exit 0

        # Cleanup in case of crash
        fusermount -u {{ mount_point | default('/var/lib/lxcfs') }} 2> /dev/null || true
        [ -L /etc/mtab ] || \
            sed -i "/^lxcfs \/{{ mount_point | default('/var/lib/lxcfs') }} fuse.lxcfs/d" /etc/mtab

        echo -n "Starting $DESC: "
        if start-stop-daemon ${START} -- {{ mount_point | default('/var/lib/lxcfs') }} >/dev/null 2>&1 ; then
            echo "${NAME}."
            echo ${OOM_SCORE_ADJ} > /proc/`cat ${PIDFILE}`/oom_score_adj
        else
            if start-stop-daemon --test ${START} >/dev/null 2>&1; then
                echo "(failed)."
                exit 1
            else
                echo "${DAEMON} already running."
                exit 0
            fi
        fi

        exit 0
    ;;

    stop)
        if init_is_upstart; then
            exit 0
        fi
        echo -n "Stopping $DESC: "
        if start-stop-daemon --stop --quiet --pidfile ${PIDFILE} \
            --startas ${DAEMON} --retry 10 --name ${NAME} \
            >/dev/null 2>&1 ; then
                echo "${NAME}."
        else
            if start-stop-daemon --test ${START} >/dev/null 2>&1; then
                echo "(not running)."
                exit 0
            else
                echo "(failed)."
                exit 1
            fi
        fi

        exit 0
    ;;

    status)
        if init_is_upstart; then
            exit 0
        fi
        status_of_proc -p ${PIDFILE} "${DAEMON}" lxcfs
    ;;

    reload)
        if init_is_upstart; then
            exit 1
        fi
        # Reload configuration by sending USR1 signal to the daemon.
        kill -USR1 $(cat ${PIDFILE})
    ;;

    restart|force-reload)
        if init_is_upstart; then
            exit 1
        fi
        $0 stop
        exec $0 start
    ;;

    *)
        echo "Usage: $0 {start|stop|restart|force-reload}" 1>&2
        exit 1
    ;;
esac