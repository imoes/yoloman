{
  "daemon_mode": true,
  "pidfile_path": "/run/inadyn.pid",
  "update_period": 300,
  "log_verbosity": 2,
  "log_file": "/var/log/inadyn.log",
  "providers": [
    {
      "name": "dyndns",
      "username": "myuser@example.com",
      "password": "secretpassword",
      "hostnames": [
        "myhome.ddns.net",
        "www.myhome.ddns.net"
      ],
      "ip_version": "ipv4"
    },
    {
      "name": "cloudflare",
      "username": "api_token_here",
      "password": "",
      "hostnames": [
        "myapp.example.com"
      ],
      "server_url": "https://api.cloudflare.com/client/v4",
      "timeout": 15
    }
  ]
}
