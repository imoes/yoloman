# LuaRocks Configuration Template
# This configuration file defines the system-wide LuaRocks environment.
# It specifies where rocks are installed, which Lua interpreter is used,
# and where Lua libraries and binaries are located.

-- LuaRocks configuration

-- Define the list of rock trees (repositories for Lua modules).
-- The 'user' tree is per-user, and the 'system' tree is global.
rocks_trees = {
   -- User-specific rocks directory (typically ~/.luarocks)
   { name = "user", root = home .. "/.luarocks" };

   -- System-wide rocks directory.
   -- Defined by: luarocks_system_rocks_root (default: '/usr')
   -- Description: The root directory for the system-wide LuaRocks tree.
   { name = "system", root = "{{ luarocks_system_rocks_root | default('/usr') }}" };
}

-- The Lua interpreter binary to use for executing Lua scripts.
-- Defined by: luarocks_lua_interpreter (default: 'lua-5.1')
-- Description: The Lua interpreter binary name to use.
lua_interpreter = "{{ luarocks_lua_interpreter | default('lua-5.1') }}";

-- Global variables exposed to the Lua environment.
variables = {
   -- The installation directory for Lua libraries/includes.
   -- Defined by: luarocks_lua_dir (default: '/usr')
   -- Description: The Lua installation directory.
   LUA_DIR = "{{ luarocks_lua_dir | default('/usr') }}";

   -- The directory containing Lua binaries.
   -- Defined by: luarocks_lua_bindir (default: '/usr/bin')
   -- Description: The Lua binary installation directory.
   LUA_BINDIR = "{{ luarocks_lua_bindir | default('/usr/bin') }}";
}
