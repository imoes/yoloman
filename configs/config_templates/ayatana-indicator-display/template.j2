# Desktop Entry for Ayatana Indicator Display
# This file generates a .desktop file to register the application entry in the system menu.
# It ensures the service is only shown on compatible desktop environments and is not displayed
# in standard application menus (NoDisplay=true).

[Desktop Entry]
# Standard desktop entry type
Type=Application

# The display name for the application entry.
# Default: 'Ayatana Indicator Display'
Name={{ name | default('Ayatana Indicator Display') }}

# The full path to the executable to run.
# Default: '/usr/libexec/ayatana-indicator-display/ayatana-indicator-display-service'
Exec={{ exec_path | default('/usr/libexec/ayatana-indicator-display/ayatana-indicator-display-service') }}

# Semicolon-separated list of desktop environments where this application should be shown.
# Default: 'Unity;MATE;XFCE;Budgie:GNOME;'
OnlyShowIn={{ only_show_in | default('Unity;MATE;XFCE;Budgie:GNOME;') }}

# Whether to hide the application from menus.
# Since this is a background indicator service, it should typically be hidden.
# Default: 'true'
NoDisplay={{ nodisplay | default('true') }}

# Whether to show a startup notification when the application is launched.
# Background services usually do not need user-facing startup notifications.
# Default: 'false'
StartupNotify={{ startup_notify | default('false') }}

# Whether the application runs in a terminal window.
# GUI indicator services run in the background, so this is false.
# Default: 'false'
Terminal={{ terminal | default('false') }}
