{
  "name": {
    "type": "string",
    "default": "lomiri-nextcloud-caldav",
    "description": "Name of the profile."
  },
  "category": {
    "type": "string",
    "default": "calendar",
    "description": "Category of the account/service."
  },
  "remote_service_name": {
    "type": "string",
    "default": "lomiri-nextcloud-caldav",
    "description": "Remote service name identifier."
  },
  "destinationtype": {
    "type": "string",
    "default": "online",
    "description": "Destination type for the data."
  },
  "enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether the profile is enabled by default."
  },
  "hidden": {
    "type": "bool",
    "default": false,
    "description": "Whether the profile is hidden from the user interface."
  },
  "use_accounts": {
    "type": "bool",
    "default": true,
    "description": "Whether to use system accounts."
  },
  "client_name": {
    "type": "string",
    "default": "caldav",
    "description": "Name of the client profile."
  },
  "sync_direction": {
    "type": "string",
    "default": "two-way",
    "description": "Direction of synchronization."
  },
  "sync_protocol": {
    "type": "string",
    "default": "caldav",
    "description": "Protocol used for synchronization."
  },
  "sync_transport": {
    "type": "string",
    "default": "HTTP",
    "description": "Transport protocol used for synchronization."
  },
  "conflict_policy": {
    "type": "string",
    "default": "prefer remote",
    "description": "Policy for handling synchronization conflicts."
  },
  "schedule_enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether scheduled synchronization is enabled."
  },
  "schedule_interval": {
    "type": "string",
    "default": "",
    "description": "Interval for scheduled synchronization (if applicable)."
  },
  "schedule_days": {
    "type": "string",
    "default": "1,2,3,4,5,6,7",
    "description": "Days of the week for scheduled synchronization."
  },
  "schedule_syncconfiguredtime": {
    "type": "string",
    "default": "",
    "description": "Time when synchronization was last configured (if applicable)."
  },
  "schedule_time": {
    "type": "string",
    "default": "05:00:00",
    "description": "Time of day for scheduled synchronization."
  }
}
