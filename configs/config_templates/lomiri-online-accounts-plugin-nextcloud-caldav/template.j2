<?xml version="1.0" encoding="UTF-8"?>
<!--
    Lomiri Online Accounts Plugin: NextCloud CalDAV Profile Configuration
    
    This template generates the XML profile configuration used by the
    lomiri-online-accounts-plugin to synchronize calendar data with
    NextCloud (or compatible CalDAV servers) via the CalDAV protocol.
    
    Variables are sourced from the Ansible role variables defined in the
    schema. Each variable is given a safe default using the `default()`
    filter to prevent rendering errors if a variable is undefined.
-->
<profile name="{{ name | default('lomiri-nextcloud-caldav') }}" type="sync">

    <!-- Category of the account/service -->
    <key name="category" value="{{ category | default('calendar') }}" />

    <!-- Remote service name identifier -->
    <key name="remote_service_name" value="{{ remote_service_name | default('lomiri-nextcloud-caldav') }}"/>

    <!-- Destination type for the data -->
    <key name="destinationtype" value="{{ destinationtype | default('online') }}"/>

    <!-- Whether the profile is enabled by default -->
    <key name="enabled" value="{{ enabled | default('false') }}"/>

    <!-- Whether the profile is hidden from the user interface -->
    <key name="hidden" value="{{ hidden | default('false') }}"/>

    <!-- Whether to use system accounts -->
    <key name="use_accounts" value="{{ use_accounts | default('true') }}"/>

    <!-- Client Profile Configuration -->
    <profile type="client" name="{{ client_name | default('caldav') }}">

        <!-- Direction of synchronization (e.g., two-way, one-way) -->
        <key value="{{ sync_direction | default('two-way') }}" name="Sync Direction"/>

        <!-- Protocol used for synchronization -->
        <key value="{{ sync_protocol | default('caldav') }}" name="Sync Protocol"/>

        <!-- Transport protocol used for synchronization (e.g., HTTP, HTTPS) -->
        <key value="{{ sync_transport | default('HTTP') }}" name="Sync Transport"/>

        <!-- Policy for handling synchronization conflicts -->
        <key value="{{ conflict_policy | default('prefer remote') }}" name="conflictpolicy" />

    </profile>

    <!-- Schedule Configuration -->
    <!--
        enabled: Whether scheduled synchronization is enabled (True/False)
        interval: Interval for scheduled synchronization (if applicable, string or empty)
        days: Days of the week for scheduled synchronization (1=Sun, 7=Sat, comma-separated)
        syncconfiguredtime: Time when synchronization was last configured
        time: Time of day for scheduled synchronization (HH:MM:SS)
    -->
    <schedule 
        enabled="{{ schedule_enabled | default(False) }}" 
        interval="{{ schedule_interval | default('') }}" 
        days="{{ schedule_days | default('1,2,3,4,5,6,7') }}" 
        syncconfiguredtime="{{ schedule_syncconfiguredtime | default('') }}" 
        time="{{ schedule_time | default('05:00:00') }}" 
    />

</profile>
