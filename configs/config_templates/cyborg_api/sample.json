{
  "debug": false,
  "log_level": "INFO",
  "log_file": "/var/log/cyborg/cyborg-api.log",
  "bind_host": "0.0.0.0",
  "bind_port": 6666,
  "api_workers": 4,
  "enable_ssl": false,
  "ssl_cert_file": "",
  "ssl_key_file": "",
  "enable_cors": true,
  "cors_allowed_origins": [
    "https://dashboard.example.com"
  ],
  "rate_limiting_enabled": false,
  "rate_limit_threshold": 100,
  "rate_limit_period": 60,
  "keystone_auth_type": "password",
  "keystone_auth_url": "https://keystone.example.com:5000/v3",
  "keystone_project_domain_name": "Default",
  "keystone_user_domain_name": "Default",
  "keystone_project_name": "services",
  "keystone_username": "cyborg",
  "keystone_password": "CYBORG_SERVICE_PASSWORD",
  "keystone_interface": "internal",
  "keystone_cafile": "/etc/ssl/certs/ca-certificates.crt",
  "keystone_insecure": "false",
  "default_driver": "fpga_intel_pac",
  "resource_tracker_interval": 60,
  "accelerator_discovery_auto": true,
  "known_accelerators": [],
  "db_connection": "mysql+pymysql://cyborg:Cyborg_DB_Pass@db.example.com/cyborg"
}
