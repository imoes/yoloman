{
  "font_dir_usr_share_fonts": {
    "type": "string",
    "default": "/usr/share/fonts",
    "description": "Primary font directory"
  },
  "font_dir_usr_share_x11_type1": {
    "type": "string",
    "default": "/usr/share/X11/fonts/Type1",
    "description": "X11 Type1 fonts directory"
  },
  "font_dir_usr_share_x11_ttf": {
    "type": "string",
    "default": "/usr/share/X11/fonts/TTF",
    "description": "X11 TTF fonts directory"
  },
  "font_dir_local_share_fonts": {
    "type": "string",
    "default": "/usr/local/share/fonts",
    "description": "Local system fonts directory"
  },
  "font_dir_home_fonts": {
    "type": "string",
    "default": "~/.fonts",
    "description": "User fonts directory (deprecated)"
  },
  "cachedir_usr_lib_fontconfig_cache": {
    "type": "string",
    "default": "/usr/lib/fontconfig/cache",
    "description": "Primary font cache directory"
  },
  "cachedir_home_fontconfig": {
    "type": "string",
    "default": "~/.fontconfig",
    "description": "User font cache directory (deprecated)"
  }
}
