{
  "log_file": "/var/log/aodh/aodh-expirer.log",
  "debug": false,
  "log_format": "%(asctime)s.%(msecs)03d %(process)d %(levelname)s %(name)s [-] %(message)s",
  "log_date_format": "%Y-%m-%d %H:%M:%S",
  "log_dir": "/var/log/aodh",
  "transport_url": "rabbit://openstack:secretrabbit@controller:5672/",
  "database": {
    "connection": "mysql+pymysql://aodh:secretdb@controller/aodh"
  },
  "service_credentials": {
    "auth_url": "http://10.0.0.10:5000/v3",
    "project_name": "service",
    "username": "aodh",
    "password": "aodh_secret_password",
    "region_name": "RegionOne",
    "interface": "internal",
    "project_domain_name": "Default",
    "user_domain_name": "Default",
    "auth_type": "password",
    "verify": true
  },
  "extra_sections": {
    "alarm": {
      "evaluation_interval": 60,
      "history_limit": 1000
    }
  }
}
