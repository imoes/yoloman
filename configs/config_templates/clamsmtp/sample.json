{
  "listen.address": "127.0.0.1",
  "listen.port": 10025,
  "forward.address": "127.0.0.1",
  "forward.port": 25,
  "clamd.address": "/var/run/clamav/clamd.sock",
  "max_size_mb": 50,
  "scan_timeout": 120,
  "clamd_timeout": 60,
  "workers": 2,
  "log.syslog": true,
  "log.file": "/var/log/clamsmtp/clamsmtpd.log",
  "log.facility": "MAIL",
  "action.on_infected": "Reject",
  "quarantine.enabled": false,
  "quarantine.dir": "/var/spool/quarantine",
  "add_header": true,
  "custom_virus_msg": "Message rejected: virus detected by ClamAV",
  "dnsbl.rules": [
    {
      "query": "bl.spamcop.net",
      "action": "Deny"
    },
    {
      "query": "zen.spamhaus.org",
      "action": "Deny"
    }
  ],
  "rate_limit.enabled": true,
  "rate_limit.max": 15,
  "rate_limit.window": 60,
  "acl.allow": [
    "127.0.0.1",
    "10.0.0.0/8"
  ],
  "acl.deny": [
    "0.0.0.0/0"
  ],
  "forward.tls.enabled": false,
  "forward.tls.ca_file": "",
  "forward.tls.cert_file": "",
  "forward.tls.key_file": "",
  "forward.tls.verify": true,
  "user": "clamsmtp",
  "group": "clamsmtp"
}
