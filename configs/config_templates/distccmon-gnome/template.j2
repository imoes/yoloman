# ==============================================================================
# distccmon-gnome Configuration Template
# ==============================================================================
# This template generates command-line arguments for `distccmon-gnome`.
# It is self-documenting: every variable reference includes its default value
# from the schema, and every directive is preceded by its description comment.
# ==============================================================================

# -- Load dynamic modules
# Description: List of dynamic modules to load (e.g., 'atk-bridge,gtk-primary-button-warps-handle') per --load-modules=MODULE1,MODULE2,...
# Default: []
# Renders as a single --load-modules flag with comma-separated values if the list is non-empty.
{% set modules_val = modules | default([]) %}
{% if modules_val | length > 0 %}--load-modules={{ modules_val | join(',') }}
{% endif %}

# -- X Display and Screen
# Description: X display to use (e.g., ':0.0')
# Default: ''
{% set display_val = display | default('') %}
{% if display_val %}--display={{ display_val }}
{% endif %}

# Description: X screen to use (e.g., '0')
# Default: ''
{% set screen_val = screen | default('') %}
{% if screen_val %}--screen={{ screen_val }}
{% endif %}

# -- Program Identification
# Description: Program name as used by the window manager
# Default: ''
{% set name_val = name | default('') %}
{% if name_val %}--name={{ name_val }}
{% endif %}

# Description: Program class as used by the window manager
# Default: ''
{% set class_val = class | default('') %}
{% if class_val %}--class={{ class_val }}
{% endif %}

# -- Sound Server Control
# Description: Enable (true) or disable (false) sound server usage
# Default: True
{% set enable_sound_val = enable_sound | default(True) | bool %}
{% if enable_sound_val %}--enable-sound
{% else %}--disable-sound
{% endif %}

# Description: Host:port of the sound server (e.g., 'localhost:5555')
# Default: ''
{% set espeaker_val = espeaker | default('') %}
{% if espeaker_val %}--espeaker={{ espeaker_val }}
{% endif %}

# -- Session Management
# Description: Session management client ID
# Default: ''
{% set sm_client_id_val = sm_client_id | default('') %}
{% if sm_client_id_val %}--sm-client-id={{ sm_client_id_val }}
{% endif %}

# Description: Prefix for saved session configuration files
# Default: ''
{% set sm_config_prefix_val = sm_config_prefix | default('') %}
{% if sm_config_prefix_val %}--sm-config-prefix={{ sm_config_prefix_val }}
{% endif %}

# Description: Disable connection to session manager
# Default: False
{% set sm_disable_val = sm_disable | default(False) | bool %}
{% if sm_disable_val %}--sm-disable
{% endif %}

# -- Debugging and Safety Flags
# Description: GDK debugging flags to set (comma-separated, e.g., 'events,draw')
# Default: ''
{% set gdk_debug_val = gdk_debug | default('') %}
{% if gdk_debug_val %}--gdk-debug={{ gdk_debug_val }}
{% endif %}

# Description: GDK debugging flags to unset
# Default: ''
{% set gdk_no_debug_val = gdk_no_debug | default('') %}
{% if gdk_no_debug_val %}--gdk-no-debug={{ gdk_no_debug_val }}
{% endif %}

# Description: GTK+ debugging flags to set
# Default: ''
{% set gtk_debug_val = gtk_debug | default('') %}
{% if gtk_debug_val %}--gtk-debug={{ gtk_debug_val }}
{% endif %}

# Description: GTK+ debugging flags to unset
# Default: ''
{% set gtk_no_debug_val = gtk_no_debug | default('') %}
{% if gtk_no_debug_val %}--gtk-no-debug={{ gtk_no_debug_val }}
{% endif %}

# Description: Make all warnings fatal
# Default: False
{% set g_fatal_warnings_val = g_fatal_warnings | default(False) | bool %}
{% if g_fatal_warnings_val %}--g-fatal-warnings
{% endif %}

# -- Additional GTK Modules
# Description: Additional Gtk modules to load (one per --gtk-module=MODULE)
# Default: []
{% set gtk_modules_val = gtk_modules | default([]) %}
{% for mod in gtk_modules_val %}--gtk-module={{ mod }}
{% endfor %}

# -- Crash Dialog Control
# Description: Disable the crash dialog
# Default: False
{% set disable_crash_dialog_val = disable_crash_dialog | default(False) | bool %}
{% if disable_crash_dialog_val %}--disable-crash-dialog
{% endif %}

# -- Synchronous X Calls
# Description: Make X calls synchronous
# Default: False
{% set sync_val = sync | default(False) | bool %}
{% if sync_val %}--sync
{% endif %}