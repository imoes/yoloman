{
  "modules": {
    "type": "list",
    "default": [],
    "description": "List of dynamic modules to load (e.g., 'atk-bridge,gtk-primary-button-warps-handle') per --load-modules=MODULE1,MODULE2,..."
  },
  "display": {
    "type": "string",
    "default": "",
    "description": "X display to use (e.g., ':0.0')"
  },
  "screen": {
    "type": "string",
    "default": "",
    "description": "X screen to use (e.g., '0')"
  },
  "name": {
    "type": "string",
    "default": "",
    "description": "Program name as used by the window manager"
  },
  "class": {
    "type": "string",
    "default": "",
    "description": "Program class as used by the window manager"
  },
  "enable_sound": {
    "type": "bool",
    "default": true,
    "description": "Enable (true) or disable (false) sound server usage"
  },
  "espeaker": {
    "type": "string",
    "default": "",
    "description": "Host:port of the sound server (e.g., 'localhost:5555')"
  },
  "sm_client_id": {
    "type": "string",
    "default": "",
    "description": "Session management client ID"
  },
  "sm_config_prefix": {
    "type": "string",
    "default": "",
    "description": "Prefix for saved session configuration files"
  },
  "sm_disable": {
    "type": "bool",
    "default": false,
    "description": "Disable connection to session manager"
  },
  "gdk_debug": {
    "type": "string",
    "default": "",
    "description": "GDK debugging flags to set (comma-separated, e.g., 'events,draw')"
  },
  "gdk_no_debug": {
    "type": "string",
    "default": "",
    "description": "GDK debugging flags to unset"
  },
  "gtk_debug": {
    "type": "string",
    "default": "",
    "description": "GTK+ debugging flags to set"
  },
  "gtk_no_debug": {
    "type": "string",
    "default": "",
    "description": "GTK+ debugging flags to unset"
  },
  "g_fatal_warnings": {
    "type": "bool",
    "default": false,
    "description": "Make all warnings fatal"
  },
  "gtk_modules": {
    "type": "list",
    "default": [],
    "description": "Additional Gtk modules to load (one per --gtk-module=MODULE)"
  },
  "disable_crash_dialog": {
    "type": "bool",
    "default": false,
    "description": "Disable the crash dialog"
  },
  "sync": {
    "type": "bool",
    "default": false,
    "description": "Make X calls synchronous"
  }
}
