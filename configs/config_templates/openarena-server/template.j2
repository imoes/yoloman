// =============================================================================
// OpenArena Server Configuration
// =============================================================================
// This template generates the server.cfg for an OpenArena dedicated server.
// It is designed to be self-documenting: every setting includes its description
// and safe defaults derived from the schema.

// --- Server Identity & Discovery ---

// Set to 2 to advertise your server in the global server list.
// 1 = private/unlisted, 2 = public/listed.
set dedicated {{ dedicated | default('2') }}

// The name of your server displayed in the server list.
// This helps players identify your specific instance.
set sv_hostname "{{ sv_hostname | default('An anonymous Debian server') }}"

// --- Game Settings ---

// Type of game to run.
// 0 = Free-For-All (FFA) Deathmatch
// 1 = Tournament (1-on-1)
// 3 = Team Deathmatch (TDM)
// 4 = Capture The Flag (CTF)
// 5 = 1-Flag CTF
// 6 = Obelisk
// 7 = Harvester
// 8 = Team Elimination
// 9 = CTF Elimination
// 10 = Last Man Standing
// 11 = Double Domination
// 12 = Domination
set g_gametype {{ g_gametype | default('0') }}

// --- Map Configuration ---

// The map to start first when the server launches.
// Ensure this map name exists in your OpenArena `maps` directory.
set map {{ map | default('oa_dm1') }}
