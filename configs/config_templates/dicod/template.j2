# Defaults for dicod initscript
# sourced by /etc/init.d/dicod
# installed at /etc/default/dicod by the maintainer scripts

#
# This is a POSIX shell fragment
#

# Whether to disable the dicod init script (set to true to disable)
# When enabled (non-zero/false), the service will be started by the init system.
# When disabled (zero/true), the service will remain inactive.
DICOD_DISABLED={{ dicod_disabled | default(False) | ternary(1, 0) }}

# Additional options that are passed to the Daemon. ( See dicod(8) )
# Pass custom flags here, such as log levels or configuration paths, as needed.
DAEMON_OPTS="{{ daemon_opts | default('') }}"