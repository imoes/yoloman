# =============================================================================
# MariaDB BZIP2 Plugin Configuration
# =============================================================================
# This template configures the server-side BZIP2 plugin for MariaDB.
# The BZIP2 plugin provides compression support for specific storage engines
# or data transfers.
#
# See the schema for detailed descriptions of each parameter.
# =============================================================================

[server]

# Name of the plugin to load.
# Schema Default: provider_bzip2
plugin_load_add={{ plugin_load_add | default('provider_bzip2') }}

# Loading behavior for the bzip2 provider.
# Schema Default: force_plus_permanent
provider_bzip2={{ provider_bzip2 | default('force_plus_permanent') }}