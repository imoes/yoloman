# =============================================================================
# MariaDB Plugin Provider Configuration: bzip2
# =============================================================================
# This file configures the bzip2 compression provider plugin for the MariaDB server.
# It allows the server to use bzip2 for compression in various storage engines.

# -----------------------------------------------------------------------------
# Plugin Load Add
# -----------------------------------------------------------------------------
# Description: Name of the plugin to load.
# Default: provider_bzip2
# Note: This directive specifies the name of the provider plugin being configured.
[server]
plugin_load_add={{ plugin_load_add | default('provider_bzip2') }}

# -----------------------------------------------------------------------------
# Provider Bzip2 Loading Behavior
# -----------------------------------------------------------------------------
# Description: Loading behavior for the bzip2 provider.
# Default: force_plus_permanent
# Valid values:
#   - force_plus_permanent: The plugin is loaded at server startup and cannot be unloaded.
#   - permanent: The plugin is loaded at startup but can be unloaded if necessary.
provider_bzip2={{ provider_bzip2 | default('force_plus_permanent') }}
