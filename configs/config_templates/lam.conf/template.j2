; Absolute path to the directory containing module-specific configuration files.
config_dir = {{ config_dir | default('/etc/ldap-account-manager/config') }}

; LDAP server hostname or IP address. Optionally include port (e.g., 'ldap.example.com:389').
; If a port is embedded here, the ldap_port directive is ignored.
ldap_host = {{ ldap_host | default('localhost') }}

; LDAP server port. Only used if port is not embedded in ldap_host.
; Use 389 for standard LDAP, 636 for LDAPS.
ldap_port = {{ ldap_port | default(389) }}

; The base distinguished name (DN) for LDAP searches.
ldap_base = {{ ldap_base | default('dc=example,dc=com') }}

; DN of the account used to bind to the LDAP directory for read/write operations.
ldap_binddn = {{ ldap_binddn | default('cn=admin,dc=example,dc=com') }}

; Password for the bind DN. Recommended to use a service account with minimal required privileges.
ldap_bindpw = {{ ldap_bindpw | default('') }}

; Enable TLS (via STARTTLS) for unencrypted LDAP connections.
ldap_usetls = {{ ldap_usetls | default(true) | lower }}

; Absolute path to the CA certificate file to verify LDAPS/TLS server certificates.
; Leave empty to skip verification (not recommended for production).
ldap_cacertfile = {{ ldap_cacertfile | default('') }}

; LDAP protocol version. Must be 3 for modern servers.
ldap_version = {{ ldap_version | default(3) }}

; Timeout in seconds for LDAP operations (connection and search).
ldap_timeout = {{ ldap_timeout | default(10) }}

[language]
; Default language for the web interface (ISO 639-1 two-letter code).
default_lang = {{ default_lang | default('en') }}

; List of languages supported by the web interface (comma-separated ISO 639-1 codes).
supported_languages = {{ supported_languages | default(['en', 'de', 'fr', 'es', 'nl', 'it', 'pt', 'ja', 'zh', 'ru']) | join(', ') }}

[logging]
; Logging verbosity: 0=none, 1=errors, 2=warnings, 3=info, 4=debug.
log_level = {{ log_level | default(1) }}

; Absolute path to the log file. If empty, logs go to syslog (recommended in containerized environments).
log_file = {{ log_file | default('') }}

[session]
; Session lifetime in seconds before requiring re-authentication.
session_lifetime = {{ session_lifetime | default(3600) }}

; Set session cookie as 'Secure' (only sent over HTTPS). Required for production.
session_secure = {{ session_secure | default(true) | lower }}

[security]
; Enforce HTTPS access to the admin interface. Disable only for local development.
https_required = {{ https_required | default(true) | lower }}

; List of allowed IP addresses or CIDR ranges for admin access.
; Empty list means allow all (not recommended for production).
allowed_ips = {{ allowed_ips | default([]) | join(', ') }}

; Maximum number of consecutive failed login attempts before account lockout.
max_login_attempts = {{ max_login_attempts | default(5) }}

; Lockout duration in seconds after exceeding max_login_attempts.
lockout_duration = {{ lockout_duration | default(900) }}

[password_policy]
; Enable enforcement of password complexity rules for new/changed passwords.
password_policy_enabled = {{ password_policy_enabled | default(true) | lower }}

; Minimum password length required.
min_password_length = {{ min_password_length | default(12) }}

; Require at least one uppercase letter in passwords.
require_uppercase = {{ require_uppercase | default(true) | lower }}

; Require at least one lowercase letter in passwords.
require_lowercase = {{ require_lowercase | default(true) | lower }}

; Require at least one digit in passwords.
require_digit = {{ require_digit | default(true) | lower }}

; Require at least one special character in passwords.
require_special = {{ require_special | default(false) | lower }}

[modules]
; List of LAM modules to enable. Common modules: users, groups, hosts, nfs, smb, sudo, ssh, printers, mail.
enabled_modules = {{ enabled_modules | default(['users', 'groups']) | join(', ') }}

; Module-specific configurations.
; Iterates over the modules_config list, creating a section for each module and its key-value pairs.
{% for module_item in modules_config | default([]) %}
{% if module_item is mapping %}
  {% set mod_name = module_item.get('name') | default('unknown') %}
  ; Module-specific configuration for {{ mod_name }}
  [{{ mod_name }}]
  {% for key, value in module_item | dict2items %}
  {% if key != 'name' %}
  {{ key }} = {{ value }}
  {% endif %}
  {% endfor %}
{% else %}
  ; Module-specific configuration for {{ module_item }}
  [{{ module_item }}]
{% endif %}
{% endfor %}