{
 "allowed_ips": [
  "10.0.0.0/8",
  "192.168.1.0/24"
 ],
 "config_dir": "/etc/ldap-account-manager/config",
 "default_lang": "en",
 "enabled_modules": [
  "users",
  "groups",
  "sudo",
  "ssh"
 ],
 "https_required": true,
 "ldap_base": "dc=example,dc=com",
 "ldap_binddn": "cn=lam,ou=system,dc=example,dc=com",
 "ldap_bindpw": "s3cr3tP@ssw0rd!",
 "ldap_cacertfile": "/etc/ssl/certs/ca.example.crt",
 "ldap_host": "ldap.internal.example.com",
 "ldap_port": 389,
 "ldap_timeout": 15,
 "ldap_usetls": true,
 "ldap_version": 3,
 "lockout_duration": 600,
 "log_file": "/var/log/lam/lam.log",
 "log_level": 3,
 "max_login_attempts": 3,
 "min_password_length": 14,
 "mod_name": "",
 "modules_config": [
  {
   "config": {
    "smb_domain": "EXAMPLE",
    "smb_policy_minlen": 8,
    "smb_sid": "S-1-5-21-1234567890-1234567890-1234567890",
    "smb_workgroup": "EXAMPLE"
   },
   "module": "smb"
  },
  {
   "config": {
    "sudo_basedn": "ou=Sudoers,dc=example,dc=com",
    "sudo_order": "000"
   },
   "module": "sudo"
  }
 ],
 "password_policy_enabled": true,
 "require_digit": true,
 "require_lowercase": true,
 "require_special": true,
 "require_uppercase": true,
 "session_lifetime": 1800,
 "session_secure": true,
 "supported_languages": [
  "en",
  "de",
  "fr"
 ]
}
