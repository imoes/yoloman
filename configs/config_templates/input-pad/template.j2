# input-pad configuration
# Language/locale for the character map display
LANGUAGE={{ language | default('en') }}

# Character sets to display in the pad
# Each set is defined by a name and a list of characters (or hex ranges)
{% for char_set in char_sets %}
# Set: {{ char_set.name }}
CHARSET_{{ char_set.name | upper }}={{ char_set.chars | join(' ') }}
{% endfor %}

# Default layout/theme for the button grid
# Options: minimal, standard, extended
LAYOUT={{ layout | default('standard') }}