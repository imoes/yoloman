{
  "telnet_ipv4_enabled": true,
  "telnet_ipv6_enabled": false,
  "run_user": "root",
  "use_tcp_wrappers": true,
  "tcpd_path": "/usr/sbin/tcpd",
  "telnetd_path": "/usr/sbin/in.telnetd",
  "telnetd_options": [
    "-a",
    "none"
  ],
  "extra_services": [
    {
      "name": "ftp",
      "socket_type": "stream",
      "proto": "tcp",
      "wait": "nowait",
      "user": "root",
      "server_path": "/usr/sbin/tcpd",
      "args": "/usr/sbin/in.ftpd -l",
      "comment": "FTP \u2014 disable if a standalone daemon such as vsftpd or proftpd is used instead"
    }
  ]
}
