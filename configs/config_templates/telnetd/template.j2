# /etc/inetd.conf — Internet super-server configuration
# Format: service  socket-type  protocol  wait/nowait  user  server-path  server-arguments
#
# WARNING: Telnet transmits credentials in plaintext. Restrict access via TCP Wrappers
# (/etc/hosts.allow, /etc/hosts.deny) or replace with SSH wherever possible.
{% if telnet_ipv4_enabled %}
# Telnet (IPv4) — inetd spawns in.telnetd for every incoming connection on port 23
telnet  stream  tcp  nowait  {{ run_user }}  {% if use_tcp_wrappers %}{{ tcpd_path }}  {{ telnetd_path }}{% else %}{{ telnetd_path }}{% endif %}{% if telnetd_options %}  {{ telnetd_options | join(" ") }}{% endif %}
{% endif %}
{% if telnet_ipv6_enabled %}
# Telnet (IPv6) — same handler exposed on the IPv6 stack
telnet  stream  tcp6  nowait  {{ run_user }}  {% if use_tcp_wrappers %}{{ tcpd_path }}  {{ telnetd_path }}{% else %}{{ telnetd_path }}{% endif %}{% if telnetd_options %}  {{ telnetd_options | join(" ") }}{% endif %}
{% endif %}
{% for svc in extra_services %}
# {{ svc.comment }}
{{ svc.name }}  {{ svc.socket_type }}  {{ svc.proto }}  {{ svc.wait }}  {{ svc.user }}  {{ svc.server_path }}{% if svc.args %}  {{ svc.args }}{% endif %}
{% endfor %}
