# NTPSec ntpviz Web Interface Configuration
# This template generates an Apache configuration snippet to serve the ntpviz
# static web application, which visualizes NTP daemon logs.

# The URL path under which ntpviz is served.
# Default: 'ntpviz'
Alias /{{ ntpviz_url_path | default('ntpviz') }} {{ ntpviz_document_root | default('/usr/share/ntpsec-ntpviz/ntpviz') }}

# Directory options for the ntpviz application root.
# Default: '/usr/share/ntpsec-ntpviz/ntpviz'
<Directory {{ ntpviz_document_root | default('/usr/share/ntpsec-ntpviz/ntpviz') }}>
    # Allow symbolic link following for the directory content.
    Options +FollowSymLinks

    # Prevent .htaccess files from overriding these settings.
    AllowOverride None

    # Set the default index file to serve when a directory is requested.
    DirectoryIndex index.html
</Directory>