# Configuration for ntpsec-ntpviz Apache/Apache2 alias directives.
# This template generates the necessary mod_alias and mod_dir configuration
# to serve the ntpviz web interface.

{# ntpviz_url_path: default='ntpviz' desc='The URL path under which ntpviz is served.' #}
# Alias directive maps a URL path to the filesystem document root.
Alias {{ ntpviz_url_path | default('ntpviz') }} {{ ntpviz_document_root | default('/usr/share/ntpsec-ntpviz/ntpviz') }}

{# ntpviz_document_root: default='/usr/share/ntpsec-ntpviz/ntpviz' desc='The filesystem path to the ntpviz web application files.' #}
# Directory block configures access and options for the document root.
<Directory {{ ntpviz_document_root | default('/usr/share/ntpsec-ntpviz/ntpviz') }}>
    # Enable symlink following for the directory.
    Options +FollowSymLinks
    # Prevent .htaccess files from overriding these settings.
    AllowOverride None
    # Specify the default index file to serve.
    DirectoryIndex index.html
</Directory>
