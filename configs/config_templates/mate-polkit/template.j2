# Mate PolicyKit wrapper configuration
# See mate-polkit(1) for details.

[Configuration]
# The absolute path to the MATE PolicyKit executable wrapper.
# This is typically the MATE authentication agent.
Executable={{ default_executable | default('/usr/bin/mate-polkit') }}

# The desktop entry file name for the authentication agent.
# Used to integrate with the desktop environment.
DesktopFile={{ default_desktop_file | default('org.mate.PolicyKit.mate-polkit.desktop') }}

# Enable verbose debug output to standard error.
Verbose={{ verbose | default(false) | lower }}

# Automatically detect the running desktop environment if possible.
# If false, uses the configured desktop file.
AutoDetectDesktop={{ auto_detect_desktop | default(true) | lower }}