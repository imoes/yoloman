{
  "cache_dir": "/var/cache/apt-cacher",
  "log_dir": "/var/log/apt-cacher",
  "admin_email": "root@localhost",
  "daemon_port": 3142,
  "daemon_group": "www-data",
  "daemon_user": "www-data",
  "daemon_addr": "localhost",
  "offline_mode": 0,
  "checksum": 0,
  "concurrent_import_limit": 1,
  "http_proxy": "proxy.example.com:8080",
  "interface": "eth0",
  "limit": 0,
  "path_map": "debian ftp.uni-kl.de/pub/linux/debian ftp2.de.debian.org/debian ; ubuntu archive.ubuntu.com/ubuntu ; security security.debian.org/debian-security ftp2.de.debian.org/debian-security",
  "path_map_debian_changelogs_override": "debian-changelogs",
  "distinct_namespaces": 0,
  "allowed_hosts": "*",
  "denied_hosts": "",
  "allowed_ssl_locations": "",
  "allowed_ssl_ports": "443",
  "allowed_locations": "ftp.uni-kl.de, ftp.nerim.net, debian.tu-bs.de/debian"
}
