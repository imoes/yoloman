# =============================================================================
# globus-gram-job-manager-lsf Configuration
# =============================================================================
# This file configures the GlobusGRAMJobManager LSF backend. It defines the paths
# to MPI launchers, LSF utility commands, and environment profile sources.
# =============================================================================

# -----------------------------------------------------------------------------
# MPI Job Execution Configuration
# -----------------------------------------------------------------------------
# Path to the mpiexec executable.
# If set to "no", MPI execution support is disabled.
# mpiexec is preferred over mpirun when both are available.
mpiexec={{ mpiexec | default('no') }}

# Path to the mpirun executable.
# If set to "no", mpirun is not used.
# mpirun is a fallback if mpiexec is not configured.
mpirun={{ mpirun | default('no') }}

# -----------------------------------------------------------------------------
# LSF Environment Configuration
# -----------------------------------------------------------------------------
# Path to the LSF profile file (e.g., profile.lsf).
# This file defines the shell environment variables required for LSF operations.
lsf_profile={{ lsf_profile | default('/etc/profile.lsf') }}

# -----------------------------------------------------------------------------
# LSF Command Utilities
# -----------------------------------------------------------------------------
# Path to the bsub command.
# Used to submit jobs to the LSF resource manager.
bsub={{ bsub | default('/usr/bin/bsub') }}

# Path to the bqueues command.
# Used to list available LSF queues for the current user.
bqueues={{ bqueues | default('/usr/bin/bqueues') }}

# Path to the bjobs command.
# Used to poll job status in LSF.
bjobs={{ bjobs | default('/usr/bin/bjobs') }}

# Path to the bhist command.
# Used to retrieve job history from LSF.
bhist={{ bhist | default('/usr/bin/bhist') }}

# Path to the bacct command.
# Used to retrieve job accounting information.
bacct={{ bacct | default('/usr/bin/bacct') }}

# Path to the bkill command.
# Used to terminate running jobs in LSF.
bkill={{ bkill | default('/usr/bin/bkill') }}

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Path to the LSF event log directory.
# Used by the globus-scheduler-event-generator to parse lsb_event files.
# Set to "no" to disable event log parsing.
log_path={{ log_path | default('no') }}