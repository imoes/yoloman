{
  "pidfile": {
    "type": "string",
    "default": "/var/run/tenshi/tenshi.pid",
    "description": "Path to the PID file."
  },
  "logfile": {
    "type": "string",
    "default": "/var/log/syslog",
    "description": "Primary logfile path."
  },
  "auth_logfile": {
    "type": "string",
    "default": "/var/log/auth.log",
    "description": "Secondary logfile path (second set logfile directive)."
  },
  "sleep": {
    "type": "number",
    "default": 5,
    "description": "Sleep interval in seconds between log checks."
  },
  "limit": {
    "type": "number",
    "default": 800,
    "description": "Maximum number of entries to process per cycle."
  },
  "pager_limit": {
    "type": "number",
    "default": 2,
    "description": "Number of entries to send to pager."
  },
  "mailserver": {
    "type": "string",
    "default": "localhost",
    "description": "Mail server hostname."
  },
  "subject": {
    "type": "string",
    "default": "tenshi report",
    "description": "Default subject line for emails."
  },
  "includedir": {
    "type": "string",
    "default": "/etc/tenshi/includes-active",
    "description": "Directory containing additional regexp include files."
  }
}
