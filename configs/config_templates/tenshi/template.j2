# =============================================================================
# Tenshi Configuration Template
# =============================================================================
# Tenshi is a log monitoring daemon that watches system logs and sends alerts.
# This template generates the configuration file for Tenshi based on provided
# schema variables.
# =============================================================================

##
## Tenshi Configuration
## Generated by Ansible Jinja2 Template
##

## General Settings
## These settings control the daemon's identity, file paths, and basic behavior.

# Set the user ID under which the Tenshi daemon will run.
set uid tenshi

# Set the group ID under which the Tenshi daemon will run.
set gid tenshi

# Path to the PID file.
# The daemon writes its process ID here to allow management tools (like systemd)
# to track and signal the process.
set pidfile {{ pidfile | default('/var/run/tenshi/tenshi.pid') }}

# Primary logfile path.
# Tenshi monitors this log file for entries.
set logfile {{ logfile | default('/var/log/syslog') }}

# Secondary logfile path.
# Tenshi can monitor multiple log files. This directive adds a second log source.
set logfile {{ auth_logfile | default('/var/log/auth.log') }}

# Sleep interval in seconds between log checks.
# Determines how often Tenshi polls the log files for new entries.
set sleep {{ sleep | default('5') }}

# Maximum number of entries to process per cycle.
# Limits the number of log lines Tenshi reads in a single pass to prevent
# resource exhaustion during log floods.
set limit {{ limit | default('800') }}

# Number of entries to send to pager.
# Controls how many log entries are passed to the pager command for alerting.
set pager_limit {{ pager_limit | default('2') }}

# Mail server hostname.
# The SMTP server Tenshi uses to send email alerts.
set mailserver {{ mailserver | default('localhost') }}

# Default subject line for emails.
# The subject line used in alert emails generated by Tenshi queues.
set subject {{ subject | default('tenshi report') }}

# Hide PIDs in log output.
# When 'on', Tenshi masks PIDs in matched log lines to reduce noise and
# potential information leakage in alerts.
set hidepid on

## Queue Definitions
## Syntax: set queue <name> <mail_from> <mail_to> [<schedule>] [<subject>]
## These queues define how alerts are dispatched for different log categories.

# Queue for mail-related logs.
# Sends reports from root@localhost.
set queue mail tenshi@localhost root@localhost [30 18 * * *]

# Queue for network failures (nf).
# Sends alerts every 30 minutes.
set queue nf tenshi@localhost root@localhost [*/30 * * * *]

# Queue for general reports.
# Runs every 2 hours between 9 AM and 5 PM.
set queue report tenshi@localhost root@localhost [0 9-17/2 * * *]

# Queue for miscellaneous logs.
# Runs every 2 hours between 9 AM and 5 PM.
set queue misc tenshi@localhost root@localhost [0 9-17/2 * * *]

# Queue for critical errors.
# Immediate alerting ('now') with subject 'tenshi CRITICAL report'.
set queue critical tenshi@localhost root@localhost [now] tenshi CRITICAL report

# Queue for root user events.
# Immediate alerting.
set queue root tenshi@localhost root@localhost [now]

# Queue for pager alerts.
# Sends to pager@localhost with immediate alerting.
set queue pager tenshi@localhost pager:pager@localhost [now] tenshi alert

# Queue for mobile alerts.
# Sends to specific mobile numbers via pager protocol.
set queue mobile tenshi@localhost pager:93384@localhost,pager:235953@localhost [now] tenshi alert

# Queue for unprefixed alerts.
# Immediate alerting for unprefixed log lines.
set queue noprefix tenshi@localhost root@localhost [now] tenshi unprefixed alert

## Regexp Definitions
## These rules classify log lines into categories (trash, critical, misc).
#
# Syntax:
#   trash <regexp>          -> Discard these logs (don't alert).
#   critical <regexp>       -> Mark as critical (alert immediately).
#   <queue_name> <regexp>   -> Match for specific queue processing.

# Repeat messages filter.
# Matches repeated log lines and consolidates them.
repeat ^(?:last message repeated|above message repeats) (\\d+) times?

# Trash rules: These patterns are considered noise and are ignored.
trash ^hub.c
trash ^usb.c
trash ^uhci.c
trash ^sda
trash ^Initializing USB
trash ^scsi0 : SCSI emulation
trash ^Vendor:
trash ^Type:
trash ^Attached scsi removable
trash ^SCSI device sda
trash ^sda: Write
trash ^/dev/scsi
trash ^WARNING: USB
trash ^USB Mass Storage
trash ^/dev
trash ^ISO
trash ^floppy0
trash ^end_request
trash ^Directory
trash ^I/O error: dev 08:(.+), sector

# Critical rules: These patterns trigger critical alerts.
critical ^Oops
critical ^Linux
critical ^init

# Include external regexp files.
# Allows modular configuration by including additional pattern files from a directory.
includedir {{ includedir | default('/etc/tenshi/includes-active') }}

# Catch-all rule.
# Any log line not matched by previous rules falls into the 'misc' queue.
misc .*
