{
  "lookaside_url": {
    "type": "string",
    "default": "https://src.stg.fedoraproject.org/repo/pkgs",
    "description": "Base URL for the lookaside cache (packages)."
  },
  "lookaside_hash": {
    "type": "string",
    "default": "sha512",
    "description": "Hash algorithm for lookaside uploads."
  },
  "lookaside_cgi_url": {
    "type": "string",
    "default": "https://src.stg.fedoraproject.org/repo/pkgs/upload.cgi",
    "description": "URL for the lookaside CGI upload script."
  },
  "git_base_host": {
    "type": "string",
    "default": "pkgs.stg.fedoraproject.org",
    "description": "Hostname for SSH Git access."
  },
  "anongit_url": {
    "type": "string",
    "default": "https://src.stg.fedoraproject.org",
    "description": "Base URL for anonymous Git access (excluding repo path)."
  },
  "koji_profile": {
    "type": "string",
    "default": "stg",
    "description": "Koji configuration profile to use."
  },
  "build_client": {
    "type": "string",
    "default": "koji",
    "description": "Build client to use."
  },
  "bz_default_tracker": {
    "type": "string",
    "default": "partner-bugzilla.redhat.com",
    "description": "Default Bugzilla tracker for cloned repositories."
  },
  "bz_default_product_rpms": {
    "type": "string",
    "default": "Fedora",
    "description": "Default Bugzilla product for RPM packages."
  },
  "bz_default_version": {
    "type": "string",
    "default": "rawhide",
    "description": "Default Bugzilla version."
  },
  "bz_default_email_rpms": {
    "type": "string",
    "default": "%(repo)s-maintainers@fedoraproject.org",
    "description": "Default email recipient for RPM package bugs."
  },
  "bz_default_product_container": {
    "type": "string",
    "default": "Fedora Container Images",
    "description": "Default Bugzilla product for container images."
  },
  "bz_default_email_container": {
    "type": "string",
    "default": "container-%(repo)s-maintainers@fedoraproject.org",
    "description": "Default email recipient for container image bugs."
  },
  "distgit_namespaced": {
    "type": "string",
    "default": "True",
    "description": "Enable namespaced distgit structure."
  },
  "distgit_namespaces": {
    "type": "string",
    "default": "rpms container flatpaks",
    "description": "List of distgit namespaces."
  },
  "lookaside_namespaced": {
    "type": "string",
    "default": "True",
    "description": "Enable namespaced lookaside structure."
  },
  "kerberos_realms": {
    "type": "string",
    "default": "STG.FEDORAPROJECT.ORG",
    "description": "Kerberos realms to use."
  },
  "oidc_id_provider": {
    "type": "string",
    "default": "https://id.stg.fedoraproject.org/openidc/",
    "description": "OpenID Connect Identity Provider URL."
  },
  "oidc_client_id": {
    "type": "string",
    "default": "fedpkg",
    "description": "OpenID Connect Client ID."
  },
  "oidc_client_secret": {
    "type": "string",
    "default": "notsecret",
    "description": "OpenID Connect Client Secret."
  },
  "oidc_scopes": {
    "type": "string",
    "default": "openid,https://id.fedoraproject.org/scope/groups,https://src.fedoraproject.org/push",
    "description": "Comma-separated list of OpenID Connect scopes."
  },
  "results_dir": {
    "type": "string",
    "default": "root",
    "description": "Results directory setting."
  },
  "lookaside_attempts": {
    "type": "number",
    "default": 3,
    "description": "Number of attempts for lookaside uploads."
  },
  "lookaside_delay": {
    "type": "number",
    "default": 15,
    "description": "Delay in seconds between lookaside upload attempts."
  },
  "lookaside_http_version": {
    "type": "string",
    "default": "auto",
    "description": "HTTP version for lookaside transfers (auto, 1.1, or 2).",
    "enum": [
      "auto",
      "1.1",
      "2"
    ]
  },
  "bodhi_staging": {
    "type": "string",
    "default": "True",
    "description": "Enable Bodhi staging environment."
  },
  "bodhi_releases_service": {
    "type": "string",
    "default": "https://bodhi.stg.fedoraproject.org/releases/%(release)s",
    "description": "Bodhi releases service URL (includes %(release)s variable)."
  },
  "bodhi_url": {
    "type": "string",
    "default": "https://bodhi.stg.fedoraproject.org/",
    "description": "Bodhi main URL."
  },
  "bugzilla_url": {
    "type": "string",
    "default": "https://bugzilla.redhat.com/",
    "description": "Bugzilla URL."
  },
  "forgejo_url": {
    "type": "string",
    "default": "https://forge.stg.fedoraproject.org/",
    "description": "Forgejo URL."
  },
  "greenwave_url": {
    "type": "string",
    "default": "https://greenwave.stg.fedoraproject.org/",
    "description": "Greenwave URL."
  },
  "distgit_apibaseurl": {
    "type": "string",
    "default": "https://src.stg.fedoraproject.org",
    "description": "Distgit API base URL."
  },
  "distgit_token": {
    "type": "string",
    "default": "",
    "description": "Distgit authentication token."
  }
}
