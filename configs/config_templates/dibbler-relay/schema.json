{
  "log_level": {
    "type": "number",
    "default": 8,
    "description": "Log level (0-8, where 8 is debug)"
  },
  "log_mode": {
    "type": "string",
    "default": "short",
    "description": "Log mode (short or long)"
  },
  "iface1_name": {
    "type": "string",
    "default": null,
    "description": "Name of the client-facing interface"
  },
  "iface1_client_multicast": {
    "type": "string",
    "default": "yes",
    "description": "Whether client traffic is multicast"
  },
  "iface1_client_unicast": {
    "type": "string",
    "default": null,
    "description": "Unicast address for client traffic (if used)"
  },
  "iface1_interface_id": {
    "type": "number",
    "default": null,
    "description": "Interface ID for client-facing interface"
  },
  "iface2_name": {
    "type": "string",
    "default": "eth2",
    "description": "Name of the server-facing interface"
  },
  "iface2_server_multicast": {
    "type": "string",
    "default": "yes",
    "description": "Whether server traffic is multicast"
  },
  "iface2_server_unicast": {
    "type": "string",
    "default": null,
    "description": "Unicast address for server traffic (if used)"
  }
}
