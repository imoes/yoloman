# ==============================================================================
# Dibbler Relay Configuration Template
# ==============================================================================
# This template configures the Dibbler DHCPv6 Relay agent.
# See: http://dibbler.info/
# ==============================================================================

# --------------------------------------------------------------------------
# Logging Configuration
# --------------------------------------------------------------------------

# log_level: Log level (0-8, where 8 is debug).
# 0 = emergency, 1 = alert, 2 = critical, 3 = error, 4 = warning,
# 5 = notice, 6 = information, 7 = debug, 8 = debug extra.
log-level {{ log_level | default('8') }}

# log_mode: Log mode (short or long).
# 'short' provides a concise format, 'long' provides detailed timestamps.
log-mode {{ log_mode | default('short') }}

# --------------------------------------------------------------------------
# Optional Global Options (Commented out by default)
# --------------------------------------------------------------------------

# Uncomment the following line to force relay to start including remote-id
# option with enterprise-id 5 and content of 01:02:03:04
# option remote-id 5-0x01020304

# Uncomment the following line to force relay to send Echo Request Option
# asking the server to echo back options 100, 101 and 102
# option echo-request 100,101,102

# Uncommenting this option will make relay to insert relay-id option
# into forwarded RELAY-FORW messages.
# option relay-id aa:bb:cc:dd:ee:ff

# Uncomment this line to tell relay to attempt to insert client link-layer
# address option. Relay will attempt to get that info from client's DUID
# or source IPv6 link-layer address. These are not 100% reliable methods!
# option link-layer

# --------------------------------------------------------------------------
# Interface 1: Client-Facing Interface
# --------------------------------------------------------------------------

# iface1_name: Name of the client-facing interface.
# If undefined or empty, the comment indicates the default 'eth1' should be used.
{% if iface1_name is defined and iface1_name is not none and (iface1_name is number or iface1_name is boolean or iface1_name | length > 0) %}
The relay should listen on {{ iface1_name }} interface for incoming client's traffic.
{% else %}
# The relay should listen on eth1 interface for incoming client's traffic.
{% endif %}

# Define the client-facing interface block.
# Uses iface1_name if provided, otherwise defaults to 'eth1' for the config directive.
iface {{ iface1_name | default('eth1') }} {

    # Clients by default send their traffic to multicast.
    # iface1_client_multicast: Whether client traffic is multicast.
    # Allowed values: yes, no.
    client multicast {{ iface1_client_multicast | default('yes') }}

    # You may uncomment this if you want the relay to also listen on specific
    # unicast address. Usually you don't need that.
    # iface1_client_unicast: Unicast address for client traffic (if used).
    {% if iface1_client_unicast is defined and iface1_client_unicast is not none and (iface1_client_unicast is number or iface1_client_unicast is boolean or iface1_client_unicast | length > 0) %}
    client unicast {{ iface1_client_unicast }}
    {% else %}
    # client unicast 2001:db8::1
    {% endif %}

    # When forwarding traffic from that interface, please add interface-id
    # to so the server will know where the clients are connected.
    # iface1_interface_id: Interface ID for client-facing interface.
    {% if iface1_interface_id is defined and iface1_interface_id is not none and (iface1_interface_id is number or iface1_interface_id is boolean or iface1_interface_id | length > 0) %}
    # with value {{ iface1_interface_id }}, so the server will know where the clients are connected.
    interface-id {{ iface1_interface_id }}
    {% else %}
    # with value 5555, so the server will know where the clients are connected.
    interface-id {{ iface1_interface_id | default('') }}
    {% endif %}
}

# --------------------------------------------------------------------------
# Interface 2: Server-Facing Interface
# --------------------------------------------------------------------------

# This is a second interface. It is used to reach the server.
# iface2_name: Name of the server-facing interface.
iface {{ iface2_name | default('eth2') }} {

    # Send message on this interface to the server multicast (ff05::1:3)
    # iface2_server_multicast: Whether server traffic is multicast.
    # Allowed values: yes, no.
    server multicast {{ iface2_server_multicast | default('yes') }}

    # send messages on this interface to this global address
    # iface2_server_unicast: Unicast address for server traffic (if used).
    {% if iface2_server_unicast is defined and iface2_server_unicast is not none and (iface2_server_unicast is number or iface2_server_unicast is boolean or iface2_server_unicast | length > 0) %}
    server unicast {{ iface2_server_unicast }}
    {% else %}
    # server unicast 2001:db8::123
    {% endif %}
}
