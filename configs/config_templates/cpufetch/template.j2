# cpufetch configuration file
#
# This configuration drives the command-line options passed to the cpufetch utility.
# cpufetch is a CPU information fetching tool that displays the CPU model, frequency,
# cache sizes, and architecture details in an ASCII-art format.
#
# Each list item in the 'options' schema variable corresponds to a single command-line
# argument (flag and optional value) passed to the cpufetch binary.
# For example, an item '--color' or '--json' will appear as a separate argument.
#
# To customize the output, add items to the 'options' list in the Ansible role variables.
# If no options are needed, leave the list empty.

{% for opt in options | default([], true) %}
{{ opt }}
{% endfor %}