{
  "monitor": {
    "type": "number",
    "default": 0,
    "description": "Which monitor should the notifications be displayed on."
  },
  "follow": {
    "type": "string",
    "default": "none",
    "description": "Follow mode for focused monitor: 'mouse', 'keyboard', or 'none'.\n",
    "enum": [
      "mouse",
      "keyboard",
      "none"
    ]
  },
  "width": {
    "type": "string",
    "default": "300",
    "description": "Width of notification window (constant or range like '(0, 300)')."
  },
  "height": {
    "type": "string",
    "default": "(0, 300)",
    "description": "Height of a single notification (constant or range like '(0, 300)')."
  },
  "origin": {
    "type": "string",
    "default": "top-right",
    "description": "Position of notification window relative to corner.\n"
  },
  "offset": {
    "type": "string",
    "default": "(10, 50)",
    "description": "Offset from origin corner."
  },
  "scale": {
    "type": "number",
    "default": 0,
    "description": "Scale factor; 0 for auto-detection."
  },
  "notification_limit": {
    "type": "number",
    "default": 20,
    "description": "Maximum number of displayed notifications (0 for no limit)."
  },
  "progress_bar": {
    "type": "bool",
    "default": true,
    "description": "Enable progress bar display."
  },
  "progress_bar_height": {
    "type": "number",
    "default": 10,
    "description": "Progress bar height including frame."
  },
  "progress_bar_frame_width": {
    "type": "number",
    "default": 1,
    "description": "Frame width for progress bar."
  },
  "progress_bar_min_width": {
    "type": "number",
    "default": 150,
    "description": "Minimum progress bar width."
  },
  "progress_bar_max_width": {
    "type": "number",
    "default": 300,
    "description": "Maximum progress bar width."
  },
  "progress_bar_corner_radius": {
    "type": "number",
    "default": 0,
    "description": "Corner radius for progress bar; 0 disables rounded corners."
  },
  "progress_bar_corners": {
    "type": "string",
    "default": "all",
    "description": "Which corners to round for progress bar (e.g., 'all', 'bottom-right,bottom-left').\n",
    "enum": [
      "all",
      "bottom-right",
      "bottom-left",
      "top-right",
      "top-left",
      "top",
      "bottom",
      "left",
      "right"
    ]
  },
  "icon_corner_radius": {
    "type": "number",
    "default": 0,
    "description": "Corner radius for icon image; 0 disables rounded corners."
  },
  "icon_corners": {
    "type": "string",
    "default": "all",
    "description": "Which corners to round for icon image.\n",
    "enum": [
      "all",
      "bottom-right",
      "bottom-left",
      "top-right",
      "top-left",
      "top",
      "bottom",
      "left",
      "right"
    ]
  },
  "indicate_hidden": {
    "type": "string",
    "default": "yes",
    "description": "Show indicator for hidden notifications ('yes' or 'no').\n",
    "enum": [
      "yes",
      "no"
    ]
  },
  "transparency": {
    "type": "number",
    "default": 0,
    "description": "Window transparency (0\u2013100); requires compositing."
  },
  "separator_height": {
    "type": "number",
    "default": 2,
    "description": "Height of separator line between notifications (0 disables)."
  },
  "padding": {
    "type": "number",
    "default": 8,
    "description": "Padding between text and separator."
  },
  "horizontal_padding": {
    "type": "number",
    "default": 8,
    "description": "Horizontal padding."
  },
  "text_icon_padding": {
    "type": "number",
    "default": 0,
    "description": "Padding between text and icon."
  },
  "frame_width": {
    "type": "number",
    "default": 3,
    "description": "Width of frame around notification window (0 disables)."
  },
  "frame_color": {
    "type": "string",
    "default": "\"#aaaaaa\"",
    "description": "Color of frame around notification window."
  },
  "gap_size": {
    "type": "number",
    "default": 0,
    "description": "Size of gap between notifications."
  },
  "separator_color": {
    "type": "string",
    "default": "frame",
    "description": "Color of the separator.",
    "enum": [
      "auto",
      "foreground",
      "frame"
    ]
  },
  "sort": {
    "type": "string",
    "default": "yes",
    "description": "Sort type (yes/no).",
    "enum": [
      "yes",
      "no",
      "id",
      "urgency_ascending",
      "urgency_descending",
      "update"
    ]
  },
  "font": {
    "type": "string",
    "default": "Monospace 8",
    "description": "Font to use for notifications."
  },
  "line_height": {
    "type": "number",
    "default": 0,
    "description": "Line height."
  },
  "markup": {
    "type": "string",
    "default": "full",
    "description": "Markup level (full, strip, no).",
    "enum": [
      "full",
      "strip",
      "no"
    ]
  },
  "format": {
    "type": "string",
    "default": "\"<b>%s</b>\\n%b\"",
    "description": "Format string."
  },
  "alignment": {
    "type": "string",
    "default": "left",
    "description": "Text alignment.",
    "enum": [
      "left",
      "center",
      "right"
    ]
  },
  "vertical_alignment": {
    "type": "string",
    "default": "center",
    "description": "Vertical alignment.",
    "enum": [
      "top",
      "center",
      "bottom"
    ]
  },
  "show_age_threshold": {
    "type": "number",
    "default": 60,
    "description": "Show age threshold."
  },
  "ellipsize": {
    "type": "string",
    "default": "middle",
    "description": "Ellipsis position.",
    "enum": [
      "start",
      "middle",
      "end"
    ]
  },
  "ignore_newline": {
    "type": "bool",
    "default": false,
    "description": "Ignore newlines."
  },
  "stack_duplicates": {
    "type": "bool",
    "default": true,
    "description": "Stack duplicates."
  },
  "hide_duplicate_count": {
    "type": "bool",
    "default": false,
    "description": "Hide duplicate count."
  },
  "show_indicators": {
    "type": "string",
    "default": "yes",
    "description": "Show indicators.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "enable_recursive_icon_lookup": {
    "type": "bool",
    "default": true,
    "description": "Enable recursive icon lookup."
  },
  "icon_theme": {
    "type": "string",
    "default": "Adwaita",
    "description": "Icon theme."
  },
  "icon_position": {
    "type": "string",
    "default": "left",
    "description": "Icon position.",
    "enum": [
      "left",
      "right",
      "top",
      "off"
    ]
  },
  "min_icon_size": {
    "type": "number",
    "default": 32,
    "description": "Minimum icon size."
  },
  "max_icon_size": {
    "type": "number",
    "default": 128,
    "description": "Maximum icon size."
  },
  "icon_path": {
    "type": "string",
    "default": "/usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/",
    "description": "Icon path."
  },
  "sticky_history": {
    "type": "bool",
    "default": true,
    "description": "Sticky history."
  },
  "history_length": {
    "type": "number",
    "default": 20,
    "description": "History length."
  },
  "dmenu": {
    "type": "string",
    "default": "/usr/bin/dmenu -p dunst:",
    "description": "Dmenu path."
  },
  "browser": {
    "type": "string",
    "default": "/usr/bin/xdg-open",
    "description": "Browser path."
  },
  "always_run_script": {
    "type": "bool",
    "default": true,
    "description": "Always run script."
  },
  "title": {
    "type": "string",
    "default": "Dunst",
    "description": "Window title."
  },
  "class": {
    "type": "string",
    "default": "Dunst",
    "description": "Window class."
  },
  "corner_radius": {
    "type": "number",
    "default": 0,
    "description": "Corner radius for the window."
  },
  "corners": {
    "type": "string",
    "default": "all",
    "description": "Corners to round.",
    "enum": [
      "all",
      "bottom-right",
      "bottom-left",
      "top-right",
      "top-left",
      "top",
      "bottom",
      "left",
      "right"
    ]
  },
  "ignore_dbusclose": {
    "type": "bool",
    "default": false,
    "description": "Ignore dbus close."
  },
  "force_xwayland": {
    "type": "bool",
    "default": false,
    "description": "Force Xwayland."
  },
  "force_xinerama": {
    "type": "bool",
    "default": false,
    "description": "Force Xinerama."
  },
  "mouse_left_click": {
    "type": "string",
    "default": "close_current",
    "description": "Mouse left click action.",
    "enum": [
      "none",
      "do_action",
      "open_url",
      "close_current",
      "close_all",
      "context",
      "context_all"
    ]
  },
  "mouse_middle_click": {
    "type": "string",
    "default": "do_action, close_current",
    "description": "Mouse middle click action."
  },
  "mouse_right_click": {
    "type": "string",
    "default": "close_all",
    "description": "Mouse right click action.",
    "enum": [
      "none",
      "do_action",
      "open_url",
      "close_current",
      "close_all",
      "context",
      "context_all"
    ]
  },
  "per_monitor_dpi": {
    "type": "bool",
    "default": false,
    "description": "Per monitor DPI."
  },
  "urgency_low_background": {
    "type": "string",
    "default": "\"#222222\"",
    "description": "Background color for low urgency."
  },
  "urgency_low_foreground": {
    "type": "string",
    "default": "\"#888888\"",
    "description": "Foreground color for low urgency."
  },
  "urgency_low_timeout": {
    "type": "number",
    "default": 10,
    "description": "Timeout for low urgency."
  },
  "urgency_low_default_icon": {
    "type": "string",
    "default": "dialog-information",
    "description": "Default icon for low urgency."
  },
  "urgency_normal_background": {
    "type": "string",
    "default": "\"#285577\"",
    "description": "Background color for normal urgency."
  },
  "urgency_normal_foreground": {
    "type": "string",
    "default": "\"#ffffff\"",
    "description": "Foreground color for normal urgency."
  },
  "urgency_normal_timeout": {
    "type": "number",
    "default": 10,
    "description": "Timeout for normal urgency."
  },
  "urgency_normal_override_pause_level": {
    "type": "number",
    "default": 30,
    "description": "Override pause level for normal urgency."
  },
  "urgency_normal_default_icon": {
    "type": "string",
    "default": "dialog-information",
    "description": "Default icon for normal urgency."
  },
  "urgency_critical_background": {
    "type": "string",
    "default": "\"#900000\"",
    "description": "Background color for critical urgency."
  },
  "urgency_critical_foreground": {
    "type": "string",
    "default": "\"#ffffff\"",
    "description": "Foreground color for critical urgency."
  },
  "urgency_critical_frame_color": {
    "type": "string",
    "default": "\"#ff0000\"",
    "description": "Frame color for critical urgency."
  },
  "urgency_critical_timeout": {
    "type": "number",
    "default": 0,
    "description": "Timeout for critical urgency."
  },
  "urgency_critical_override_pause_level": {
    "type": "number",
    "default": 60,
    "description": "Override pause level for critical urgency."
  },
  "urgency_critical_default_icon": {
    "type": "string",
    "default": "dialog-warning",
    "description": "Default icon for critical urgency."
  }
}
