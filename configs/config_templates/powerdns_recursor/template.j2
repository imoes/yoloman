# Listen on these IPv4 and IPv6 addresses
# Accepts comma-separated list of IPs; empty means all interfaces
listen-addresses={{ listen_addresses | join(',') }}

# DNS port to listen on
dns-port={{ dns_port }}

# Maximum number of concurrent UDP queries
max-udp-queries-per-connection={{ max_udp_queries_per_connection }}

# Enable or disable DNSSEC validation
dnssec={{ 'on' if dnssec else 'off' }}

# Allow recursion for these networks (comma-separated CIDRs or hostnames)
allow-recursion={{ allow_recursion | join(',') }}

# Log queries (for debugging); can be 'yes' or 'no'
log-querylog={{ 'yes' if log_querylog else 'no' }}

# Log level: 0 (none) to 6 (most verbose)
loglevel={{ log_level }}

# Maximum number of simultaneous connections
max-concurrent-queries={{ max_concurrent_queries }}

# Timeout for backend queries (ms)
query-local-address-timeout={{ query_local_address_timeout }}

# Local address to use when querying upstream servers
query-local-address={{ query_local_address }}

# Do not use the system DNS servers (fallback to root hints)
forward-zones={{ forward_zones | join(',') }}

# Recursive resolver timeout (ms)
forward-timeout={{ forward_timeout }}

# Enable or disable the cache
cache-max-ttl={{ cache_max_ttl }}
cache-min-ttl={{ cache_min_ttl }}

# Number of worker threads (set to 0 for automatic)
threads={{ threads }}

# Local address for the API server (empty = disable API)
api={{ 'yes' if api_enabled else 'no' }}
api-key={{ api_key }}
api-listen={{ api_listen }}

# Network timeouts (ms)
remote-pipe-timeout={{ remote_pipe_timeout }}
socket-dir={{ socket_dir }}

# Rate-limiting (max queries per second per client)
max-queries-per-ip-per-second={{ max_queries_per_ip_per_second }}

# EDNS Client Subnet (ECS) handling: 'off', 'pass', 'pass-nonzero', 'recursed', 'proxy', 'proxy-nonzero'
ecs-ipv4-bits={{ ecs_ipv4_bits }}
ecs-ipv6-bits={{ ecs_ipv6_bits }}
ecs-case={{ 'preserve' if ecs_preserve_case else 'lowercase' }}

# Use systemd socket activation if available
systemd socket activation is disabled
