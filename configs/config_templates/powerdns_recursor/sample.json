{
  "listen_addresses": [
    "127.0.0.1",
    "192.168.1.1"
  ],
  "dns_port": 53,
  "max_udp_queries_per_connection": 50,
  "dnssec": true,
  "allow_recursion": [
    "127.0.0.0/8",
    "192.168.1.0/24",
    "::1/128",
    "fc00::/7"
  ],
  "log_querylog": false,
  "log_level": 3,
  "max_concurrent_queries": 10000,
  "query_local_address_timeout": 10000,
  "query_local_address": "",
  "forward_zones": [
    "example.com=8.8.8.8,8.8.4.4",
    "internal.lan=10.1.1.1"
  ],
  "forward_timeout": 2000,
  "cache_max_ttl": 86400,
  "cache_min_ttl": 60,
  "threads": 2,
  "api_enabled": true,
  "api_key": "secret-api-key-here",
  "api_listen": "127.0.0.1",
  "remote_pipe_timeout": 10000,
  "socket_dir": "/run/pdns-recursor",
  "max_queries_per_ip_per_second": 60,
  "ecs_ipv4_bits": 24,
  "ecs_ipv6_bits": 56,
  "ecs_preserve_case": true
}
