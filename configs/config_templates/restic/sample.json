{
  "repository": "/mnt/backup/restic",
  "password_file": "/etc/restic/password",
  "cache_dir": "/var/cache/restic",
  "compression": "auto",
  "limit_upload": 0,
  "limit_download": 0,
  "pack_size": 0,
  "retry_lock": "5m",
  "options": [
    "sftp.command=sftp -o BatchMode=yes user@host:/backup"
  ],
  "verbose": 0,
  "insecure_tls": false,
  "cacert": "",
  "tls_client_cert": "",
  "key_hint": "",
  "http_user_agent": "restic-backup-script",
  "no_cache": false,
  "no_lock": false,
  "cleanup_cache": false,
  "no_extra_verify": false,
  "stuck_request_timeout": "5m"
}
