{
  "service_name": "mydatabase",
  "executable": "/opt/mydb/bin/server",
  "exec_args": [
    "--config",
    "/etc/mydb/server.conf",
    "--start"
  ],
  "physcpubind": "0-3",
  "cpunodebind": "0",
  "membind": "0",
  "preferred_node": "",
  "interleave_nodes": "",
  "weighted_interleave_nodes": "",
