  "huge_pages": true,
  "touch": true,
  "shm_file": "",
  "shm_id": "",
  "shm_keyfile": "",
  "shm_length": "",
  "shm_offset": "",
  "shm_mode": "",
  "use_all": false,
  "separator_cmd": false
}
