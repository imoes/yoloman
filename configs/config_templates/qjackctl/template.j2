# QjackCtl Configuration File
# Generated via Jinja2 template.
# This INI-style configuration controls the QjackCtl JACK Audio Connection Kit controller application.
# It manages server launch behavior, preset loading, D-Bus interface availability, and UI settings.

[Options]
# --start: If true, start the JACK audio server immediately when qjackctl launches (corresponds to --start).
# Default: false
StartServer={{ (values | default({})).start_server | default(false) | lower }}

# --server-name=[label]: The default name for the JACK audio server instance (corresponds to --server-name).
# Default: jackd
ServerName={{ (values | default({})).server_name | default('jackd') }}

# --preset=[label]: The name of the saved preset to load on startup (corresponds to --preset). Empty uses defaults.
# Default: ''
PresetName={{ (values | default({})).preset_name | default('') }}

# --active-patchbay=[path]: The filename or path of the active patchbay definition file to load (corresponds to --active-patchbay). Empty loads default or last.
# Default: ''
ActivePatchbay={{ (values | default({})).active_patchbay | default('') }}

[D-Bus]
# Enable the D-Bus interface to allow external applications to control JACK via qjackctl.
# Default: false
EnableDBus={{ (values | default({})).enable_dbus | default(false) | lower }}

[Paths]
# Explicit path to the patchbay definition file.
# Default: ''
PatchbayPath={{ (values | default({})).patchbay_path | default('') }}

[Display]
# Qt font description string for the application interface.
# Default: Sans,10,-1,5,50,0,0,0,0,0
Font={{ (values | default({})).font | default('Sans,10,-1,5,50,0,0,0,0,0') }}

[Messages]
# Maximum number of status messages to retain in the log buffer.
# Default: 1000
MaxMessages={{ (values | default({})).max_messages | default(1000) }}

# Time in seconds to keep messages in the log buffer before expiring them.
# Default: 300
MessageTimeLimit={{ (values | default({})).message_time_limit | default(300) }}