{
  "global_options": [
    "log_fifo_uid",
    "log_procuid"
  ],
  "rules": [
    {
      "facility": "kern",
      "priority": "*",
      "target": "/var/log/kern.log"
    },
    {
      "facility": "user",
      "priority": "*",
      "target": "/var/log/user.log"
    },
    {
      "facility": "daemon",
      "priority": "*",
      "target": "/var/log/daemon.log"
    },
    {
      "facility": "auth",
      "priority": "*",
      "target": "/var/log/auth.log"
    },
    {
      "facility": "local0",
      "priority": "info",
      "target": "/var/log/local0.log"
    },
    {
      "facility": "*",
      "priority": ".=notice",
      "target": "/var/log/messages"
    },
    {
      "facility": "*",
      "priority": "err",
      "target": "root"
    },
    {
      "facility": "*",
      "priority": "debug",
      "target": "/dev/null"
    }
  ]
}
