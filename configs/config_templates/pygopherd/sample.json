{
  "pygopherd_detach": false,
  "pygopherd_pidfile": "/var/run/pygopherd/pygopherd.pid",
  "gopher_port": 70,
  "gopherroot": "/var/gopher",
  "loglevel": "INFO",
  "tls_enabled": false,
  "tls_cert": "/etc/ssl/certs/pygopherd.crt",
  "tls_key": "/etc/ssl/private/pygopherd.key",
  "http_enabled": true,
  "wap_enabled": false
}
