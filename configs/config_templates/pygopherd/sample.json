{
  "loglevel": "INFO",
  "gopherroot": "/var/gopher",
  "gopher_listen": "0.0.0.0",
  "gopher_port": 70,
  "gopher_enabled": true,
  "http_listen": "0.0.0.0",
  "http_port": 7001,
  "http_enabled": true,
  "wap_listen": "0.0.0.0",
  "wap_port": 7002,
  "wap_enabled": false,
  "title": "My Gopher Space",
  "hostname": "gopher.example.com",
  "cgidir": "/var/gopher/cgi-bin",
  "cgi_enabled": true,
  "max_upload_size": 2097152,
  "charset": "UTF-8",
  "tls_enabled": true,
  "tls_cert": "/etc/ssl/certs/gopher.example.com.crt",
  "tls_key": "/etc/ssl/private/gopher.example.com.key",
  "mime_overrides": [
    "gif:image/gif",
    "png:image/png"
  ],
  "vhosts": [
    {
      "hostname": "gopher.example.com",
      "gopherroot": "/var/gopher/main",
      "title": "Main Gopher Site"
    },
    {
      "hostname": "archive.example.com",
      "gopherroot": "/var/gopher/archive",
      "title": "Archives"
    }
  ],
  "logfile": "/var/log/pygopherd/gopher.log",
  "log_rotate_size": 10485760,
  "log_rotate_count": 5,
  "syslog_enabled": false,
  "allowed_subnets": [],
  "denied_subnets": [
    "192.168.66.0/24"
  ],
  "ftp_gateway_enabled": false,
  "ftp_gateway_host": "ftp.gnu.org",
  "ftp_gateway_port": 21,
  "ftp_gateway_user": "anonymous",
  "ftp_gateway_pass": "guest@example.com"
}
