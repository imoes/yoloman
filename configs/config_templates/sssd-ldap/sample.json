{
  "services": [
    "nss",
    "pam"
  ],
  "domains": [
    "ldap"
  ],
  "ldap_uris": [
    "ldap://ldap.company.com",
    "ldap://ldap-backup.company.com"
  ],
  "search_base": "ou=People,dc=company,dc=com",
  "ldap_schema": "rfc2307",
  "default_bind_dn": "cn=readonly,dc=company,dc=com",
  "default_authtok": "s3cr3t_r0ld",
  "tls_reqcert": "demand",
  "tls_ca_cert_dir": "/etc/ssl/certs",
  "user_name_attr": "uid",
  "user_uid_attr": "uidNumber",
  "user_gid_attr": "gidNumber",
  "user_homedir_attr": "homeDirectory",
  "user_shell_attr": "loginShell",
  "group_name_attr": "cn",
  "group_gid_attr": "gidNumber",
  "cache_credentials": true,
  "enable_authorization": false,
  "debug_level": 2,
  "log_file": "/var/log/sssd/sssd.log"
}
