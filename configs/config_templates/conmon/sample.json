{
  "api_version": "v1",
  "bundle": "/var/lib/containers/storage/overlay-containers/abc123/userdata",
  "container_id": "abc123def456",
  "container_name": "myapp",
  "log_path": "/var/log/containers/myapp.log",
  "conmon_pidfile": "/run/containers/myapp.conmon.pid",
  "container_pidfile": "/run/containers/myapp.pid",
  "runtime": "crun",
  "systemd_cgroup": true,
  "socket_dir_path": "/run/containers",
  "timeout": 30,
  "exit_command": "/usr/local/bin/notify.sh",
  "exit_command_args": [
    "container-stopped",
    "abc123"
  ],
  "exit_delay": 5,
  "exit_dir": "/var/run/exit",
  "terminal": true,
  "log_level": "info",
  "log_size_max": 10485760,
  "new_keyring": false,
  "restore": true,
  "restore_args": [
    "--image-path",
    "/var/lib/containers/checkpoint"
  ],
  "runtime_opts": [
    "--no-new-keypid"
  ]
}
