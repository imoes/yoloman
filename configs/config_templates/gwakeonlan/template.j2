{# Configuration file for gWakeOnLAN #}
# gwakeonlan configuration (JSON format)
#
# This file controls the logging verbosity of the gWakeOnLAN utility.
# It is a JSON object with two boolean keys:
# - verbose: Enable verbose mode to show all error and information messages
# - quiet: Enable quiet mode to hide all error and information messages (takes precedence over verbose)
#
# Note: If 'quiet' is true, it overrides 'verbose' regardless of its value.
#
{
  # Verbose mode: show all error and information messages
  "verbose": {{ verbose | default(false) | lower }},
  # Quiet mode: hide all error and information messages (overrides verbose)
  "quiet": {{ quiet | default(false) | lower }}
}