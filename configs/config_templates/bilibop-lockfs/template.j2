[Desktop Entry]
Version=1.0
Encoding=UTF-8
Type=Application
# The command to execute when the desktop entry is launched.
Exec={{ exec | default('lockfs-notify') }}
# Icon name or path for the application.
Icon={{ icon | default('changes-prevent') }}
Name=bilibop-lockfs
# Notification of locking of the filesystems
Comment=Notification of locking of the filesystems
Comment[en]=Notification of locking of the filesystems
Comment[fr]=Notification de verrouillage des systèmes de fichiers
# Whether startup notification should be enabled.
StartupNotify={{ startup_notify | default(false) | ternary('true', 'false') }}
# Whether the application should run in a terminal window.
Terminal={{ terminal | default(false) | ternary('true', 'false') }}
# Whether the desktop entry should be hidden from menus.
Hidden={{ hidden | default(false) | ternary('true', 'false') }}