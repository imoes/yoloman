{
  "default_key": "ABCDEF0123456789ABCDEF0123456789ABCDEF01",
  "default_recipient_self": true,
  "verbose": true,
  "batch": true,
  "no_tty": true,
  "armor": true,
  "homedir": "/home/user/.gnupg",
  "compress_level": 6,
  "keyrings": [
    "/home/user/.gnupg/pubring.kbx"
  ],
  "default_cert_level": 2,
  "min_cert_level": 2,
  "trusted_keys": [
    "ABCDEF0123456789ABCDEF0123456789ABCDEF01"
  ],
  "default_new_key_algo": "rsa4096/cert,sign+rsa4096/encr",
  "trust_model": "tofu+pgp",
  "tofu_default_policy": "unknown",
  "s2k_cipher_algo": "AES256",
  "s2k_digest_algo": "SHA512",
  "s2k_mode": 3,
  "s2k_count": 65011712,
  "personal_cipher_preferences": "AES256,AES192,AES128",
  "personal_digest_preferences": "SHA512,SHA384,SHA256",
  "personal_compress_preferences": "ZLIB,BZIP2,ZIP",
  "list_options": [
    "show-photos",
    "show-uid-validity",
    "show-sig-expire"
  ],
  "verify_options": [
    "show-policy-urls",
    "show-uid-validity"
  ],
  "import_options": [
    "import-clean",
    "repair-keys"
  ],
  "export_options": [
    "export-minimal"
  ],
  "compliance": "openpgp",
  "require_cross_certification": true,
  "no_auto_check_trustdb": false,
  "no_autostart": true,
  "lock_once": false,
  "no_emit_version": true,
  "comments": [
    "Generated by gpg.conf template"
  ],
  "enable_large_rsa": false,
  "enable_dsa2": true,
  "with_v5_fingerprint": true,
  "enable_progress_filter": true,
  "pinentry_mode": "loopback",
  "keyid_format": "long",
  "auto_key_locate": [
    "local",
    "wkd"
  ],
  "auto_key_import": true,
  "auto_key_retrieve": true,
  "no_random_seed_file": true,
  "expert": true,
  "enable_special_filenames": true,
  "default_preference_list": "AES256 SHA512 ZLIB",
  "default_keyserver_url": "hkp://keys.openpgp.org"
}
