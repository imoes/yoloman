# gpg.conf - GNU Privacy Guard configuration file
#
# This file configures the GnuPG command-line tools (gpg, gpg2).
# It is self-documenting: every directive includes its schema description
# as a comment and a safe Jinja2 default value.
#
# Generated by Ansible. Do not edit manually; edit the Ansible variables instead.

# Fingerprint, long key ID, or user ID of the default key for signing operations
# --default-key
{% set default_key = default_key | default('') %}
{% if default_key %}default-key {{ default_key }}{% endif %}

# Fingerprint, long key ID, or user ID of the default recipient for encryption
# --default-recipient
{% set default_recipient = default_recipient | default('') %}
{% if default_recipient %}default-recipient {{ default_recipient }}{% endif %}

# Use the default key as the default recipient (overrides default_recipient)
# --default-recipient-self
{% set default_recipient_self = default_recipient_self | default(False) %}
{% if default_recipient_self %}default-recipient-self{% endif %}

# Enable verbose output (equivalent to --verbose)
# --verbose
{% set verbose = verbose | default(False) %}
{% if verbose %}verbose{% endif %}

# Enable quiet mode (suppress non-error output)
# --quiet
{% set quiet = quiet | default(False) %}
{% if quiet %}quiet{% endif %}

# Enable batch mode (non-interactive)
# --batch
{% set batch = batch | default(False) %}
{% if batch %}batch{% endif %}

# Disable TTY output
# --no-tty
{% set no_tty = no_tty | default(False) %}
{% if no_tty %}no-tty{% endif %}

# Assume 'yes' for all questions
# --yes
{% set yes = yes | default(False) %}
{% if yes %}yes{% endif %}

# Create ASCII armored output (equivalent to --armor)
# --armor
{% set armor = armor | default(False) %}
{% if armor %}armor{% endif %}

# Output file path (equivalent to --output)
# --output
{% set output = output | default('') %}
{% if output %}output {{ output }}{% endif %}

# Compression level for ZIP/ZLIB algorithms (0-9, 6 is default)
# -z / --compress-level
{% set compress_level = compress_level | default(6) %}
{% if compress_level is defined %}compress-level {{ compress_level }}{% endif %}

# Compression level for BZIP2 algorithm (0-9, 6 is default)
# --bzip2-compress-level
{% set bzip2_compress_level = bzip2_compress_level | default(6) %}
{% if bzip2_compress_level is defined %}bzip2-compress-level {{ bzip2_compress_level }}{% endif %}

# Disable compression (equivalent to --no-compress)
# --no-compress
{% set no_compression = no_compression | default(False) %}
{% if no_compression %}no-compress{% endif %}

# GnuPG home directory path
# --homedir
{% set homedir = homedir | default('~/.gnupg') %}
{% if homedir %}homedir {{ homedir }}{% endif %}

# Native character set for display (e.g., 'utf-8', 'iso-8859-1')
# --display-charset
{% set display_charset = display_charset | default('') %}
{% if display_charset %}display-charset {{ display_charset }}{% endif %}

# Assume UTF-8 encoding for command-line arguments
# --utf8-strings
{% set utf8_strings = utf8_strings | default(False) %}
{% if utf8_strings %}utf8-strings{% endif %}

# Additional keyring files to include (appended to keyring list)
# --keyring
{% set keyrings = keyrings | default([]) %}
{% for keyring in keyrings %}keyring {{ keyring }}{% endfor %}

# Primary public keyring file path
# --primary-keyring
{% set primary_keyring = primary_keyring | default('') %}
{% if primary_keyring %}primary-keyring {{ primary_keyring }}{% endif %}

# Custom trust database file path
# --trustdb-name
{% set trustdb_name = trustdb_name | default('') %}
{% if trustdb_name %}trustdb-name {{ trustdb_name }}{% endif %}

# Default certification level for key signing (0-3, 0 = no claim)
# --default-cert-level
{% set default_cert_level = default_cert_level | default(0) %}
{% if default_cert_level is defined %}default-cert-level {{ default_cert_level }}{% endif %}

# Minimum certification level required for key validity (0-3)
# --min-cert-level
{% set min_cert_level = min_cert_level | default(2) %}
{% if min_cert_level is defined %}min-cert-level {{ min_cert_level }}{% endif %}

# List of fingerprints to treat as ultimately trusted (for remote keys)
# --trusted-key
{% set trusted_keys = trusted_keys | default([]) %}
{% for trusted_key in trusted_keys %}trusted-key {{ trusted_key }}{% endfor %}

# List of fingerprints for designated revokers
# --add-desig-revoker
{% set desig_revokers = desig_revokers | default([]) %}
{% for desig_revoker in desig_revokers %}add-desig-revoker {{ desig_revoker }}{% endfor %}

# Default algorithm settings for new key generation
# --default-new-key-algo
{% set default_new_key_algo = default_new_key_algo | default('default') %}
{% if default_new_key_algo %}default-new-key-algo {{ default_new_key_algo }}{% endif %}

# Deprecated keyserver URI (prefer dirmngr.conf); e.g., 'hkp://keys.gnupg.net'
# --keyserver
{% set keyserver = keyserver | default('') %}
{% if keyserver %}keyserver {{ keyserver }}{% endif %}

# List of keyserver options (e.g., 'timeout=10', 'http-proxy=http://proxy:8080')
# --keyserver-options
{% set keyserver_options = keyserver_options | default([]) %}
{% for keyserver_opt in keyserver_options %}keyserver-options {{ keyserver_opt }}{% endfor %}

# Trust model: 'pgp', 'classic', 'tofu', 'tofu+pgp', 'direct', 'always', or 'auto'
# --trust-model
{% set trust_model = trust_model | default('auto') %}
{% if trust_model %}trust-model {{ trust_model }}{% endif %}

# Default TOFU trust policy: 'auto', 'good', 'unknown', 'bad', or 'ask'
# --tofu-default-policy
{% set tofu_default_policy = tofu_default_policy | default('auto') %}
{% if tofu_default_policy %}tofu-default-policy {{ tofu_default_policy }}{% endif %}

# Maximum certification chain depth
# --max-cert-depth
{% set max_cert_depth = max_cert_depth | default(5) %}
{% if max_cert_depth is defined %}max-cert-depth {{ max_cert_depth }}{% endif %}

# Number of completely trusted introducers needed to introduce a new signer
# --completes-needed
{% set completes_needed = completes_needed | default(1) %}
{% if completes_needed is defined %}completes-needed {{ completes_needed }}{% endif %}

# Number of marginally trusted introducers needed to introduce a new signer
# --marginals-needed
{% set marginals_needed = marginals_needed | default(3) %}
{% if marginals_needed is defined %}marginals-needed {{ marginals_needed }}{% endif %}

# Disable passphrase caching for symmetric encryption
# --no-symkey-cache
{% set no_symkey_cache = no_symkey_cache | default(False) %}
{% if no_symkey_cache %}no-symkey-cache{% endif %}

# Cipher algorithm for symmetric encryption with passphrase
# --s2k-cipher-algo
{% set s2k_cipher_algo = s2k_cipher_algo | default('AES-128') %}
{% if s2k_cipher_algo %}s2k-cipher-algo {{ s2k_cipher_algo }}{% endif %}

# Digest algorithm for passphrase mangling
# --s2k-digest-algo
{% set s2k_digest_algo = s2k_digest_algo | default('SHA1') %}
{% if s2k_digest_algo %}s2k-digest-algo {{ s2k_digest_algo }}{% endif %}

# S2K mode for passphrase mangling (0=plain, 1=salted, 3=iterated)
# --s2k-mode
{% set s2k_mode = s2k_mode | default(3) %}
{% if s2k_mode is defined %}s2k-mode {{ s2k_mode }}{% endif %}

# S2K iteration count (1024-65011712, 0 = agent default)
# --s2k-count
{% set s2k_count = s2k_count | default(0) %}
{% if s2k_count is defined %}s2k-count {{ s2k_count }}{% endif %}

# Personal cipher preference list (e.g., 'AES256,AES192,AES128')
# --personal-cipher-preferences
{% set personal_cipher_preferences = personal_cipher_preferences | default('') %}
{% if personal_cipher_preferences %}personal-cipher-preferences {{ personal_cipher_preferences }}{% endif %}

# Personal digest preference list (e.g., 'SHA512,SHA256,SHA1')
# --personal-digest-preferences
{% set personal_digest_preferences = personal_digest_preferences | default('') %}
{% if personal_digest_preferences %}personal-digest-preferences {{ personal_digest_preferences }}{% endif %}

# Personal compression preference list (e.g., 'ZLIB,BZIP2,ZIP')
# --personal-compress-preferences
{% set personal_compress_preferences = personal_compress_preferences | default('') %}
{% if personal_compress_preferences %}personal-compress-preferences {{ personal_compress_preferences }}{% endif %}

# Include V5-style fingerprints in colon mode listings
# --with-v5-fingerprint
{% set with_v5_fingerprint = with_v5_fingerprint | default(False) %}
{% if with_v5_fingerprint %}with-v5-fingerprint{% endif %}

# List options (e.g., 'show-photos', 'show-uid-validity', 'show-sig-expire')
# --list-options
{% set list_options = list_options | default([]) %}
{% for list_opt in list_options %}list-options {{ list_opt }}{% endfor %}

# Verify options (e.g., 'show-policy-urls', 'show-uid-validity')
# --verify-options
{% set verify_options = verify_options | default([]) %}
{% for verify_opt in verify_options %}verify-options {{ verify_opt }}{% endfor %}

# Import options (e.g., 'import-clean', 'repair-keys')
# --import-options
{% set import_options = import_options | default([]) %}
{% for import_opt in import_options %}import-options {{ import_opt }}{% endfor %}

# Export options (e.g., 'export-minimal', 'export-clean')
# --export-options
{% set export_options = export_options | default([]) %}
{% for export_opt in export_options %}export-options {{ export_opt }}{% endfor %}

# Compliance mode: 'openpgp', 'rfc4880', 'rfc2440', 'pgp7', 'pgp8'
# --openpgp / --rfc4880 / --rfc2440 / --pgp7 / --pgp8
{% set compliance = compliance | default('openpgp') %}
{% if compliance == 'openpgp' %}openpgp{% endif %}
{% if compliance == 'rfc4880' %}rfc4880{% endif %}
{% if compliance == 'rfc2440' %}rfc2440{% endif %}
{% if compliance == 'pgp7' %}pgp7{% endif %}
{% if compliance == 'pgp8' %}pgp8{% endif %}

# Require cross-certification signatures for signing subkeys
# --require-cross-certification
{% set require_cross_certification = require_cross_certification | default(True) %}
{% if require_cross_certification %}require-cross-certification{% endif %}

# Display photo IDs in key listings (deprecated; use list-options instead)
# --show-photos
{% set show_photos = show_photos | default(False) %}
{% if show_photos %}show-photos{% endif %}

# Use embedded filename during decryption
# --use-embedded-filename
{% set use_embedded_filename = use_embedded_filename | default(False) %}
{% if use_embedded_filename %}use-embedded-filename{% endif %}

# Skip signature verification during decryption
# --skip-verify
{% set skip_verify = skip_verify | default(False) %}
{% if skip_verify %}skip-verify{% endif %}

# Disable automatic trust database checks
# --no-auto-check-trustdb
{% set no_auto_check_trustdb = no_auto_check_trustdb | default(False) %}
{% if no_auto_check_trustdb %}no-auto-check-trustdb{% endif %}

# Do not auto-start gpg-agent/dirmngr
# --no-autostart
{% set no_autostart = no_autostart | default(False) %}
{% if no_autostart %}no-autostart{% endif %}

# Lock databases once and hold lock until exit
# --lock-once
{% set lock_once = lock_once | default(False) %}
{% if lock_once %}lock-once{% endif %}

# Disable locking entirely
# --lock-never
{% set lock_never = lock_never | default(False) %}
{% if lock_never %}lock-never{% endif %}

# Do not emit version string in ASCII armor
# --no-emit-version
{% set no_emit_version = no_emit_version | default(True) %}
{% if no_emit_version %}no-emit-version{% endif %}

# Comment strings to add to armored output
# --comment
{% set comments = comments | default([]) %}
{% for comment in comments %}comment {{ comment }}{% endfor %}

# Allow RSA keys up to 8192 bits
# --enable-large-rsa
{% set enable_large_rsa = enable_large_rsa | default(False) %}
{% if enable_large_rsa %}enable-large-rsa{% endif %}

# Enable DSA2 (hash truncation for DSA keys)
# --enable-dsa2
{% set enable_dsa2 = enable_dsa2 | default(True) %}
{% if enable_dsa2 %}enable-dsa2{% endif %}

# Display ICAO phonetic spelling of fingerprints
# --with-icao-spelling
{% set with_icao_spelling = with_icao_spelling | default(False) %}
{% if with_icao_spelling %}with-icao-spelling{% endif %}

# Include key origin information in listings
# --with-key-origin
{% set with_key_origin = with_key_origin | default(False) %}
{% if with_key_origin %}with-key-origin{% endif %}

# Enable progress filter for status output
# --enable-progress-filter
{% set enable_progress_filter = enable_progress_filter | default(False) %}
{% if enable_progress_filter %}enable-progress-filter{% endif %}

# Passphrase for unattended operations (security risk!)
# --passphrase
{% set passphrase = passphrase | default('') %}
{% if passphrase %}passphrase {{ passphrase }}{% endif %}

# Path to passphrase file (security risk!)
# --passphrase-file
{% set passphrase_file = passphrase_file | default('') %}
{% if passphrase_file %}passphrase-file {{ passphrase_file }}{% endif %}

# Pinentry mode: 'default', 'ask', 'cancel', 'error', or 'loopback'
# --pinentry-mode
{% set pinentry_mode = pinentry_mode | default('default') %}
{% if pinentry_mode %}pinentry-mode {{ pinentry_mode }}{% endif %}

# Key ID display format: 'none', 'short', 'long', '0xshort', or '0xlong'
# --keyid-format
{% set keyid_format = keyid_format | default('long') %}
{% if keyid_format %}keyid-format {{ keyid_format }}{% endif %}

# Command to view photo IDs (%i = temp file, %I = temp file not deleted)
# --photo-viewer
{% set photo_viewer = photo_viewer | default('xdg-open %i') %}
{% if photo_viewer %}photo-viewer {{ photo_viewer }}{% endif %}

# Auto key locate mechanisms: 'cert', 'dane', 'wkd', 'ldap', 'ntds', 'keyserver', 'local', 'nodefault', 'clear'
# --auto-key-locate
{% set auto_key_locate = auto_key_locate | default(['local', 'wkd']) %}
{% for auto_key_loc in auto_key_locate %}auto-key-locate {{ auto_key_loc }}{% endfor %}

# Enable automatic key import from embedded keys
# --auto-key-import
{% set auto_key_import = auto_key_import | default(False) %}
{% if auto_key_import %}auto-key-import{% endif %}

# Enable automatic key retrieval from keyservers
# --auto-key-retrieve
{% set auto_key_retrieve = auto_key_retrieve | default(False) %}
{% if auto_key_retrieve %}auto-key-retrieve{% endif %}

# Refuse to run if secure memory is unavailable
# --require-secmem
{% set require_secmem = require_secmem | default(False) %}
{% if require_secmem %}require-secmem{% endif %}

# Disable use of random seed file
# --no-random-seed-file
{% set no_random_seed_file = no_random_seed_file | default(False) %}
{% if no_random_seed_file %}no-random-seed-file{% endif %}

# Suppress the initial copyright message
# --no-greeting
{% set no_greeting = no_greeting | default(False) %}
{% if no_greeting %}no-greeting{% endif %}

# Suppress the insecure memory warning
# --no-secmem-warning
{% set no_secmem_warning = no_secmem_warning | default(False) %}
{% if no_secmem_warning %}no-secmem-warning{% endif %}

# Suppress file/homedir permission warnings
# --no-permission-warning
{% set no_permission_warning = no_permission_warning | default(False) %}
{% if no_permission_warning %}no-permission-warning{% endif %}

# Enable expert mode (allows risky operations)
# --expert
{% set expert = expert | default(False) %}
{% if expert %}expert{% endif %}

# Allow import/use of keys with non-self-signed UIDs
# --allow-non-selfsigned-uid
{% set allow_non_selfsigned_uid = allow_non_selfsigned_uid | default(False) %}
{% if allow_non_selfsigned_uid %}allow-non-selfsigned-uid{% endif %}

# Allow multiple messages in one file (obsolete)
# --allow-multiple-messages
{% set allow_multiple_messages = allow_multiple_messages | default(False) %}
{% if allow_multiple_messages %}allow-multiple-messages{% endif %}

# Enable special filenames (e.g., '-1' as file descriptor)
# --enable-special-filenames
{% set enable_special_filenames = enable_special_filenames | default(False) %}
{% if enable_special_filenames %}enable-special-filenames{% endif %}

# Preserve secret key file permissions
# --preserve-permissions
{% set preserve_permissions = preserve_permissions | default(False) %}
{% if preserve_permissions %}preserve-permissions{% endif %}

# Default preference list for new keys
# --default-preference-list
{% set default_preference_list = default_preference_list | default('') %}
{% if default_preference_list %}default-preference-list {{ default_preference_list }}{% endif %}

# Default keyserver URL
# --default-keyserver-url
{% set default_keyserver_url = default_keyserver_url | default('') %}
{% if default_keyserver_url %}default-keyserver-url {{ default_keyserver_url }}{% endif %}