{
 "allow_multiple_messages": {
  "default": false,
  "description": "Allow multiple messages in one file (obsolete)",
  "type": "bool"
 },
 "allow_non_selfsigned_uid": {
  "default": false,
  "description": "Allow import/use of keys with non-self-signed UIDs",
  "type": "bool"
 },
 "armor": {
  "default": false,
  "description": "Create ASCII armored output (equivalent to --armor)",
  "type": "bool"
 },
 "auto_key_import": {
  "default": false,
  "description": "Enable automatic key import from embedded keys",
  "type": "bool"
 },
 "auto_key_locate": {
  "default": [
   "local",
   "wkd"
  ],
  "description": "Auto key locate mechanisms: 'cert', 'dane', 'wkd', 'ldap', 'ntds', 'keyserver', 'local', 'nodefault', 'clear'",
  "type": "list"
 },
 "auto_key_retrieve": {
  "default": false,
  "description": "Enable automatic key retrieval from keyservers",
  "type": "bool"
 },
 "batch": {
  "default": false,
  "description": "Enable batch mode (non-interactive)",
  "type": "bool"
 },
 "bzip2_compress_level": {
  "default": 6,
  "description": "Compression level for BZIP2 algorithm (0-9, 6 is default)",
  "type": "number"
 },
