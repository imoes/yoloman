{
  "default_key": {
    "type": "string",
    "default": "",
    "description": "Fingerprint, long key ID, or user ID of the default key for signing operations"
  },
  "default_recipient": {
    "type": "string",
    "default": "",
    "description": "Fingerprint, long key ID, or user ID of the default recipient for encryption"
  },
  "default_recipient_self": {
    "type": "bool",
    "default": false,
    "description": "Use the default key as the default recipient (overrides default_recipient)"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output (equivalent to --verbose)"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Enable quiet mode (suppress non-error output)"
  },
  "batch": {
    "type": "bool",
    "default": false,
    "description": "Enable batch mode (non-interactive)"
  },
  "no_tty": {
    "type": "bool",
    "default": false,
    "description": "Disable TTY output"
  },
  "yes": {
    "type": "bool",
    "default": false,
    "description": "Assume 'yes' for all questions"
  },
  "armor": {
    "type": "bool",
    "default": false,
    "description": "Create ASCII armored output (equivalent to --armor)"
  },
  "output": {
    "type": "string",
    "default": "",
    "description": "Output file path (equivalent to --output)"
  },
  "compress_level": {
    "type": "number",
    "default": 6,
    "description": "Compression level for ZIP/ZLIB algorithms (0-9, 6 is default)"
  },
  "bzip2_compress_level": {
    "type": "number",
    "default": 6,
    "description": "Compression level for BZIP2 algorithm (0-9, 6 is default)"
  },
  "no_compression": {
    "type": "bool",
    "default": false,
    "description": "Disable compression (equivalent to --no-compress)"
  },
  "homedir": {
    "type": "string",
    "default": "~/.gnupg",
    "description": "GnuPG home directory path"
  },
  "display_charset": {
    "type": "string",
    "default": "",
    "description": "Native character set for display (e.g., 'utf-8', 'iso-8859-1')",
    "enum": [
      "iso-8859-1",
      "iso-8859-2",
      "iso-8859-15",
      "koi8-r",
      "utf-8"
    ]
  },
  "utf8_strings": {
    "type": "bool",
    "default": false,
    "description": "Assume UTF-8 encoding for command-line arguments"
  },
  "keyrings": {
    "type": "list",
    "default": [],
    "description": "Additional keyring files to include (appended to keyring list)"
  },
  "primary_keyring": {
    "type": "string",
    "default": "",
    "description": "Primary public keyring file path"
  },
  "trustdb_name": {
    "type": "string",
    "default": "",
    "description": "Custom trust database file path"
  },
  "default_cert_level": {
    "type": "number",
    "default": 0,
    "description": "Default certification level for key signing (0-3, 0 = no claim)"
  },
  "min_cert_level": {
    "type": "number",
    "default": 2,
    "description": "Minimum certification level required for key validity (0-3)"
  },
  "trusted_keys": {
    "type": "list",
    "default": [],
    "description": "List of fingerprints to treat as ultimately trusted (for remote keys)"
  },
  "desig_revokers": {
    "type": "list",
    "default": [],
    "description": "List of fingerprints for designated revokers"
  },
  "default_new_key_algo": {
    "type": "string",
    "default": "default",
    "description": "Default algorithm settings for new key generation",
    "enum": [
      "default",
      "rsa",
      "dsa",
      "elg",
      "ed25519",
      "cv25519",
      "future-default"
    ]
  },
  "keyserver": {
    "type": "string",
    "default": "",
    "description": "Deprecated keyserver URI (prefer dirmngr.conf); e.g., 'hkp://keys.gnupg.net'"
  },
  "keyserver_options": {
    "type": "list",
    "default": [],
    "description": "List of keyserver options (e.g., 'timeout=10', 'http-proxy=http://proxy:8080')"
  },
  "trust_model": {
    "type": "string",
    "default": "auto",
    "description": "Trust model: 'pgp', 'classic', 'tofu', 'tofu+pgp', 'direct', 'always', or 'auto'",
    "enum": [
      "pgp",
      "classic",
      "tofu",
      "tofu+pgp",
      "direct",
      "always",
      "auto"
    ]
  },
  "tofu_default_policy": {
    "type": "string",
    "default": "auto",
    "description": "Default TOFU trust policy: 'auto', 'good', 'unknown', 'bad', or 'ask'",
    "enum": [
      "auto",
      "good",
      "unknown",
      "bad",
      "ask"
    ]
  },
  "max_cert_depth": {
    "type": "number",
    "default": 5,
    "description": "Maximum certification chain depth"
  },
  "completes_needed": {
    "type": "number",
    "default": 1,
    "description": "Number of completely trusted introducers needed to introduce a new signer"
  },
  "marginals_needed": {
    "type": "number",
    "default": 3,
    "description": "Number of marginally trusted introducers needed to introduce a new signer"
  },
  "no_symkey_cache": {
    "type": "bool",
    "default": false,
    "description": "Disable passphrase caching for symmetric encryption"
  },
  "s2k_cipher_algo": {
    "type": "string",
    "default": "AES-128",
    "description": "Cipher algorithm for symmetric encryption with passphrase"
  },
  "s2k_digest_algo": {
    "type": "string",
    "default": "SHA1",
    "description": "Digest algorithm for passphrase mangling",
    "enum": [
      "SHA1",
      "SHA224",
      "SHA384",
      "SHA512",
      "MD5",
      "RIPEMD160"
    ]
  },
  "s2k_mode": {
    "type": "number",
    "default": 3,
    "description": "S2K mode for passphrase mangling (0=plain, 1=salted, 3=iterated)"
  },
  "s2k_count": {
    "type": "number",
    "default": 0,
    "description": "S2K iteration count (1024-65011712, 0 = agent default)"
  },
  "personal_cipher_preferences": {
    "type": "string",
    "default": "",
    "description": "Personal cipher preference list (e.g., 'AES256,AES192,AES128')",
    "enum": [
      "AES256",
      "AES192",
      "AES128",
      "TWOFISH",
      "CAST5",
      "3DES",
      "BLOWFISH",
      "IDEA",
      "AES256",
      "AES192",
      "AES128"
    ]
  },
  "personal_digest_preferences": {
    "type": "string",
    "default": "",
    "description": "Personal digest preference list (e.g., 'SHA512,SHA256,SHA1')",
    "enum": [
      "SHA512",
      "SHA384",
      "SHA256",
      "SHA224",
      "SHA1",
      "MD5"
    ]
  },
  "personal_compress_preferences": {
    "type": "string",
    "default": "",
    "description": "Personal compression preference list (e.g., 'ZLIB,BZIP2,ZIP')",
    "enum": [
      "ZLIB",
      "BZIP2",
      "ZIP",
      "Uncompressed"
    ]
  },
  "with_v5_fingerprint": {
    "type": "bool",
    "default": false,
    "description": "Include V5-style fingerprints in colon mode listings"
  },
  "list_options": {
    "type": "list",
    "default": [],
    "description": "List options (e.g., 'show-photos', 'show-uid-validity', 'show-sig-expire')"
  },
  "verify_options": {
    "type": "list",
    "default": [],
    "description": "Verify options (e.g., 'show-policy-urls', 'show-uid-validity')"
  },
  "import_options": {
    "type": "list",
    "default": [],
    "description": "Import options (e.g., 'import-clean', 'repair-keys')"
  },
  "export_options": {
    "type": "list",
    "default": [],
    "description": "Export options (e.g., 'export-minimal', 'export-clean')"
  },
  "compliance": {
    "type": "string",
    "default": "openpgp",
    "description": "Compliance mode: 'openpgp', 'rfc4880', 'rfc2440', 'pgp7', 'pgp8'",
    "enum": [
      "openpgp",
      "rfc4880",
      "gnupg",
      "de-vs"
    ]
  },
  "require_cross_certification": {
    "type": "bool",
    "default": true,
    "description": "Require cross-certification signatures for signing subkeys"
  },
  "show_photos": {
    "type": "bool",
    "default": false,
    "description": "Display photo IDs in key listings (deprecated; use list-options instead)"
  },
  "use_embedded_filename": {
    "type": "bool",
    "default": false,
    "description": "Use embedded filename during decryption"
  },
  "skip_verify": {
    "type": "bool",
    "default": false,
    "description": "Skip signature verification during decryption"
  },
  "no_auto_check_trustdb": {
    "type": "bool",
    "default": false,
    "description": "Disable automatic trust database checks"
  },
  "no_autostart": {
    "type": "bool",
    "default": false,
    "description": "Do not auto-start gpg-agent/dirmngr"
  },
  "lock_once": {
    "type": "bool",
    "default": false,
    "description": "Lock databases once and hold lock until exit"
  },
  "lock_never": {
    "type": "bool",
    "default": false,
    "description": "Disable locking entirely"
  },
  "no_emit_version": {
    "type": "bool",
    "default": true,
    "description": "Do not emit version string in ASCII armor"
  },
  "comments": {
    "type": "list",
    "default": [],
    "description": "Comment strings to add to armored output"
  },
  "enable_large_rsa": {
    "type": "bool",
    "default": false,
    "description": "Allow RSA keys up to 8192 bits"
  },
  "enable_dsa2": {
    "type": "bool",
    "default": true,
    "description": "Enable DSA2 (hash truncation for DSA keys)"
  },
  "with_icao_spelling": {
    "type": "bool",
    "default": false,
    "description": "Display ICAO phonetic spelling of fingerprints"
  },
  "with_key_origin": {
    "type": "bool",
    "default": false,
    "description": "Include key origin information in listings"
  },
  "enable_progress_filter": {
    "type": "bool",
    "default": false,
    "description": "Enable progress filter for status output"
  },
  "passphrase": {
    "type": "string",
    "default": "",
    "description": "Passphrase for unattended operations (security risk!)"
  },
  "passphrase_file": {
    "type": "string",
    "default": "",
    "description": "Path to passphrase file (security risk!)"
  },
  "pinentry_mode": {
    "type": "string",
    "default": "default",
    "description": "Pinentry mode: 'default', 'ask', 'cancel', 'error', or 'loopback'",
    "enum": [
      "default",
      "ask",
      "cancel",
      "error",
      "loopback"
    ]
  },
  "keyid_format": {
    "type": "string",
    "default": "long",
    "description": "Key ID display format: 'none', 'short', 'long', '0xshort', or '0xlong'",
    "enum": [
      "none",
      "short",
      "long",
      "0xshort",
      "0xlong"
    ]
  },
  "photo_viewer": {
    "type": "string",
    "default": "xdg-open %i",
    "description": "Command to view photo IDs (%i = temp file, %I = temp file not deleted)"
  },
  "auto_key_locate": {
    "type": "list",
    "default": [
      "local",
      "wkd"
    ],
    "description": "Auto key locate mechanisms: 'cert', 'dane', 'wkd', 'ldap', 'ntds', 'keyserver', 'local', 'nodefault', 'clear'"
  },
  "auto_key_import": {
    "type": "bool",
    "default": false,
    "description": "Enable automatic key import from embedded keys"
  },
  "auto_key_retrieve": {
    "type": "bool",
    "default": false,
    "description": "Enable automatic key retrieval from keyservers"
  },
  "require_secmem": {
    "type": "bool",
    "default": false,
    "description": "Refuse to run if secure memory is unavailable"
  },
  "no_random_seed_file": {
    "type": "bool",
    "default": false,
    "description": "Disable use of random seed file"
  },
  "no_greeting": {
    "type": "bool",
    "default": false,
    "description": "Suppress the initial copyright message"
  },
  "no_secmem_warning": {
    "type": "bool",
    "default": false,
    "description": "Suppress the insecure memory warning"
  },
  "no_permission_warning": {
    "type": "bool",
    "default": false,
    "description": "Suppress file/homedir permission warnings"
  },
  "expert": {
    "type": "bool",
    "default": false,
    "description": "Enable expert mode (allows risky operations)"
  },
  "allow_non_selfsigned_uid": {
    "type": "bool",
    "default": false,
    "description": "Allow import/use of keys with non-self-signed UIDs"
  },
  "allow_multiple_messages": {
    "type": "bool",
    "default": false,
    "description": "Allow multiple messages in one file (obsolete)"
  },
  "enable_special_filenames": {
    "type": "bool",
    "default": false,
    "description": "Enable special filenames (e.g., '-1' as file descriptor)"
  },
  "preserve_permissions": {
    "type": "bool",
    "default": false,
    "description": "Preserve secret key file permissions"
  },
  "default_preference_list": {
    "type": "string",
    "default": "",
    "description": "Default preference list for new keys",
    "enum": [
      "AES256",
      "AES192",
      "AES128",
      "TWOFISH",
      "CAST5",
      "3DES",
      "SHA512",
      "SHA384",
      "SHA256",
      "SHA224",
      "SHA1",
      "MD5",
      "ZLIB",
      "BZIP2",
      "ZIP",
      "Uncompressed"
    ]
  },
  "default_keyserver_url": {
    "type": "string",
    "default": "",
    "description": "Default keyserver URL"
  }
}
