  "default": "openpgp",
  "description": "Compliance mode: 'openpgp', 'rfc4880', 'rfc2440', 'pgp7', 'pgp8'",
  "enum": [
   "openpgp",
   "rfc4880",
   "gnupg",
   "de-vs"
  ],
  "type": "string"
 },
 "compress_level": {
  "default": 6,
  "description": "Compression level for ZIP/ZLIB algorithms (0-9, 6 is default)",
  "type": "number"
 },
 "default_cert_level": {
  "default": 0,
  "description": "Default certification level for key signing (0-3, 0 = no claim)",
  "type": "number"
 },
 "default_key": {
  "default": "",
  "description": "Fingerprint, long key ID, or user ID of the default key for signing operations",
