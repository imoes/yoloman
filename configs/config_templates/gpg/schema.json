 },
 "default_keyserver_url": {
  "default": "",
  "description": "Default keyserver URL",
  "type": "string"
 },
 "default_new_key_algo": {
  "default": "default",
  "description": "Default algorithm settings for new key generation",
  "enum": [
   "default",
   "rsa",
   "dsa",
   "elg",
   "ed25519",
   "cv25519",
   "future-default"
  ],
  "type": "string"
 },
 "default_preference_list": {
  "description": "Default preference list for new keys",
  "enum": [
   "AES256",
   "AES192",
   "AES128",
   "TWOFISH",
   "CAST5",
   "3DES",
   "SHA512",
   "SHA384",
   "SHA256",
   "SHA224",
   "SHA1",
   "MD5",
   "ZLIB",
   "BZIP2",
   "ZIP",
   "Uncompressed"
  ],
  "type": "string"
 },
