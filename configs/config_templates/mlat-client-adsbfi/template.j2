#
# Configuration for mlat-client-adsbfi
# Self-documenting template enriched with schema defaults and descriptions.
#

# Whether to start the mlat client (yes/no)
# Default: no
START_CLIENT={{ START_CLIENT | default('no') }}

# Input receiver configuration
# Host and port of the input receiver (e.g., 127.0.0.1:30005)
# Default: ''
INPUT_HOSTPORT={{ INPUT_HOSTPORT | default('') }}

# Type of input receiver (e.g., dump1090, readsb)
# Default: dump1090
INPUT_TYPE={{ INPUT_TYPE | default('dump1090') }}

# MLAT Server configuration
# Host and port of the MLAT server (e.g., mlat.adsb.fi:31001)
# Default: ''
SERVER_HOSTPORT={{ SERVER_HOSTPORT | default('') }}

# ADS-B server user identifier
# Default: ''
SERVER_USER={{ SERVER_USER | default('') }}

# Location of receiver station (required for MLAT)
# Latitude of the receiver station
# Default: ''
LAT={{ LAT | default('') }}

# Longitude of the receiver station
# Default: ''
LON={{ LON | default('') }}

# Altitude of the receiver station in meters
# Default: ''
ALT={{ ALT | default('') }}

# Output results servers
# List of result servers to connect to (e.g., mlat.adsb.fi:31001)
# Default: []
{% for result in RESULTS | default([]) %}
RESULT {{ result }}
{% endfor %}

# Logging
# Log file path for the daemon output
# Default: /var/log/mlat-client-adsbfi.log
LOGFILE={{ LOGFILE | default('/var/log/mlat-client-adsbfi.log') }}

# Run as user
# User to run the mlat client daemon as
# Default: missing-RUN_AS_USER-setting-in-config
RUN_AS_USER={{ RUN_AS_USER | default('missing-RUN_AS_USER-setting-in-config') }}

# Extra arguments
# Additional command line arguments for the mlat client
# Default: ''
EXTRA_ARGS={{ EXTRA_ARGS | default('') }}

# Logrotate configuration for the mlat-client-adsbfi log file
/var/log/mlat-client-adsbfi.log {
  daily
  rotate 4
  copytruncate
  missingok
  notifempty
}
