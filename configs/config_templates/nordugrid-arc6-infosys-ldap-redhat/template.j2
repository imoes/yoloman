# Nordugrid ARC BDII LDAP Information Service logrotate configuration
# Managed by Ansible: nordugrid-arc6-infosys-ldap-redhat

/var/log/arc/bdii/bdii-update.log {
    # Number of rotated log files to keep.
    rotate {{ LOG_ROTATE_COUNT | default(14) }}

    # Do not remove log file when rotating (keep missing files quiet).
    missingok

    # Compress old log files to save disk space.
    compress

    # Rotate the log file every day.
    daily

    # Copy the log file and then truncate the original, ensuring no disruption to the logging daemon.
    copytruncate
}
