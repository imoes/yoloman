{
  "input_file": "/var/spool/ripmime/incoming.eml",
  "output_dir": "/var/spool/ripmime/extracted",
  "prefix": "att",
  "header_file": "mail_headers.txt",
  "verbose": true,
  "quiet": false,
  "log_destination": "syslog",
  "paranoid": true,
  "name_by_type": false,
  "no_nameless": true,
  "overwrite": false,
  "recursion_max": 15,
  "mailbox": false,
  "extended_errors": false,
  "debug": false,
  "no_ole": false,
  "no_uudecode": false,
  "no_quotedprintable": false,
  "no_doublecr": false,
  "no_mht": false,
  "disable_header_fix": false,
  "disable_qmail_bounce": true,
  "no_multiple_filename": true,
  "verbose_contenttype": false,
  "verbose_oldstyle": false,
  "verbose_defects": true,
  "unique_names_strategy": "prefix"
}
