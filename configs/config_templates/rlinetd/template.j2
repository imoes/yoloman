# Path to the main rlinetd configuration file.
# This file defines the global settings and includes additional configuration snippets.
# The rlinetd daemon reads this file to determine which services to forward and how.

# Include additional configuration files from the specified directory.
# This allows splitting the configuration into smaller, manageable pieces.
# The wildcard pattern ignores editor backup files (e.g., file.bak, file.swp).
#
# Schema field: rlinetd_config_dir
# Default: /etc/rlinetd.d
directory "{{ rlinetd_config_dir | default('/etc/rlinetd.d') }}" "" "(~|\.bak|\.swp|\.ucf-.*|\.dpkg-.*)$";

# Global defaults for all services defined in the configuration.
# These settings apply to all entries unless overridden locally.
defaults {
  # Number of rlinetd instances (worker processes) to spawn.
  # Increasing this number can improve performance for high connection counts.
  #
  # Schema field: rlinetd_instances
  # Default: 5
  instances {{ rlinetd_instances | default('5') }};

  # Optional: Bind specific services to a local interface address.
  # Uncomment and set to restrict access to a specific network interface.
  # Example: interface 192.168.1.1;
  # interface 192.168.1.1;
}
