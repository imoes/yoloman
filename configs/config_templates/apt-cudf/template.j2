# apt-cudf configuration template
# Generated by Ansible. Do not edit manually.
#
# apt-cudf is a tool for solving dependency conflicts in APT packages.
# This configuration defines default solvers and upgrade policies.

# solver_default: Default solver specification for 'solver:' directive; admin may replace with '*' for automatic selection or other solver name(s)
solver: {{ (solver_default | default('mccs-cbc , mccs-lpsolve')) }}

upgrade: -lex[-new,-removed,-notuptodate]
dist-upgrade: -lex[-notuptodate,-new]
install: -lex[-removed,-changed]
remove: -lex[-removed,-changed]
trendy: -lex[-removed,-notuptodate,-unsat_recommends,-new]
paranoid: -lex[-removed,-changed]

# Override section: These directives allow specific solver/policy overrides.
# If the user has provided specific overrides in their inventory/vars, they will be applied here.
# Otherwise, the defaults above are used.
{% set overrides = (overrides | default({})) %}
{% if overrides %}
{% if overrides.get('solver') is defined and overrides.get('solver') %}
solver: {{ overrides.get('solver') }}
{% endif %}
{% if overrides.get('upgrade') is defined and overrides.get('upgrade') %}
upgrade: {{ overrides.get('upgrade') }}
{% endif %}
{% if overrides.get('dist_upgrade') is defined and overrides.get('dist_upgrade') %}
dist-upgrade: {{ overrides.get('dist_upgrade') }}
{% endif %}
{% if overrides.get('install') is defined and overrides.get('install') %}
install: {{ overrides.get('install') }}
{% endif %}
{% if overrides.get('remove') is defined and overrides.get('remove') %}
remove: {{ overrides.get('remove') }}
{% endif %}
{% if overrides.get('trendy') is defined and overrides.get('trendy') %}
trendy: {{ overrides.get('trendy') }}
{% endif %}
{% if overrides.get('paranoid') is defined and overrides.get('paranoid') %}
paranoid: {{ overrides.get('paranoid') }}
{% endif %}
{% endif %}

# The following section is a fallback or alternative configuration if 'solver_default' is set to '*'.
# This section is kept for compatibility but is generally not used unless explicitly triggered.
# If solver_default is '*', the system uses automatic selection.
{% if solver_default | default('mccs-cbc , mccs-lpsolve') == '*' %}
solver: *
upgrade: -new,-removed,-notuptodate
dist-upgrade: -notuptodate,-new
install: -removed,-changed
remove: -removed,-changed
trendy: -removed,-notuptodate,-unsat_recommends,-new
paranoid: -removed,-changed
{% endif %}