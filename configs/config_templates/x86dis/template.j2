# x86dis configuration
# ============================================================
# Disassembler syntax: 'intel', 'att', or 'raw'.
# ============================================================
syntax = {{ syntax | default('intel') }}

# Input file to disassemble. Empty or '-' means read from stdin.
# ============================================================
input_file = {{ input_file | default('') }}

# Output file for disassembly results. Empty means write to stdout.
# ============================================================
output_file = {{ output_file | default('') }}

# Log file for errors. Empty means write to stderr.
# ============================================================
log_file = {{ log_file | default('') }}

# Page size for buffering stdin in bytes.
# Default is 512K (524288 bytes).
# ============================================================
pagesize = {{ pagesize | default(524288) }}

# Disassemble a single instruction at a specific hex offset
# (e.g., '0x100').
# ============================================================
single_addr = {{ single_addr | default('') }}

# Disassemble forward from a specific hex offset
# (e.g., '0x0').
# ============================================================
entry_addr = {{ entry_addr | default('') }}

# Disassemble a specific range starting from this hex offset.
# ============================================================
range_start = {{ range_start | default('') }}

# Length (in hex) of the range to disassemble.
# 0 means disassemble to the end of the file.
# ============================================================
range_len = {{ range_len | default('') }}