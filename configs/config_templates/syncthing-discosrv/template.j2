{{'{'}}
  "api_key": "{{ api_key }}",
  "bind": "{{ bind_address }}:{{ port }}",
  "log_level": "{{ log_level }}",
  "max_conn_per_ip": {{ max_conn_per_ip }},
  "rate_limit": {{ rate_limit }},
  "rate_limit_burst": {{ rate_limit_burst }},
  {% if enable_metrics %}
  "metrics": {
    "enabled": true,
    "bind": "{{ metrics_bind }}:{{ metrics_port }}",
    "enable_pprof": {{ enable_pprof }}
  },
  {% else %}
  "metrics": {
    "enabled": false
  },
  {% endif %}
  "tls": {
    "enabled": {{ tls_enabled }},
    "cert_file": "{{ tls_cert_path }}",
    "key_file": "{{ tls_key_path }}"
  },
  {% if listen_urls | length > 0 %}
  "listen_urls": [
    {% for url in listen_urls %}    "{{ url }}"{% if not loop.last %},{% endif %}
    {% endfor %}  ],
  {% else %}
  "listen_urls": [],
  {% endif %}
  "log_to_stdout": {{ log_to_stdout }},
  "log_file": "{{ log_file }}",
  "pid_file": "{{ pid_file }}"
{{'}'}}