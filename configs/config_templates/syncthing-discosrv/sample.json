{
  "api_key": "my-secure-api-key-123456789",
  "bind_address": "0.0.0.0",
  "port": 22026,
  "log_level": "info",
  "max_conn_per_ip": 15,
  "rate_limit": 200,
  "rate_limit_burst": 400,
  "enable_metrics": true,
  "metrics_bind": "127.0.0.1",
  "metrics_port": 22027,
  "enable_pprof": false,
  "tls_enabled": true,
  "tls_cert_path": "/etc/syncthing-discosrv/tls.crt",
  "tls_key_path": "/etc/syncthing-discosrv/tls.key",
  "listen_urls": [
    "unix:///var/run/syncthing-discosrv.sock"
  ],
  "log_to_stdout": false,
  "log_file": "/var/log/syncthing-discosrv/syncthing-discosrv.log",
  "pid_file": "/run/syncthing-discosrv.pid"
}
