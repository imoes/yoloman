{
  "server": {
    "host": "0.0.0.0",
    "port": 6523,
    "ssl_enabled": true,
    "ssl_certificate": "/etc/ssl/certs/gobby.crt",
    "ssl_key": "/etc/ssl/private/gobby.key",
    "max_connections": 100
  },
  "security": {
    "password_auth": true,
    "password_file": "/etc/gobby-0.5/users.conf",
    "cert_auth": false,
    "ca_certificate": "",
    "require_cert": true,
    "allowed_cert_fingerprints": []
  },
  "logging": {
    "level": "warning",
    "file": "/var/log/gobby/server.log",
    "rotate": true,
    "rotate_max_size": 50,
    "rotate_max_files": 10
  },
  "general": {
    "autosave_dir": "/var/lib/gobby-0.5/autosave",
    "autosave_interval": 60,
    "versioning": true,
    "versioning_dir": "/var/lib/gobby-0.5/versions"
  }
}
