#############################################################################
#
# OpenSLP configuration file
#
# Format and contents conform to specification in IETF RFC 2614 so the
# comments use the language of the RFC.  In OpenSLP, SLPD operates as an SA
# and a DA.  The SLP UA functionality is encapsulated by SLPLIB.
#
#############################################################################

#----------------------------------------------------------------------------
# Static Scope and Static DA Configuration
#----------------------------------------------------------------------------

# Comma delimited list of strings indicating the only scopes a UA or SA is allowed. (default value is "DEFAULT")
net.slp.useScopes = {{ (slp | default({})).useScopes | default('DEFAULT') }}

# Comma delimited list of specific DAs to force UA and SA agents to use. Empty or unset implies dynamic DA discovery.
net.slp.DAAddresses = {{ (slp | default({})).DAAddresses | default('myDa1,myDa2,myDa3') }}

#----------------------------------------------------------------------------
# DA Specific Configuration
#----------------------------------------------------------------------------

# Enables slpd to function as a DA. Default is false.
net.slp.isDA = {{ (slp | default({})).isDA | default(False) }}

# Number of seconds for the DA heartbeat. Default is 3 hours (10800 seconds).
net.slp.DAHeartBeat = {{ (slp | default({})).DAHeartBeat | default(10800) }}

# Seconds after which a DA is considered stale. Default is 0 (disabled). A minimum of 60s will be applied if non-zero.
net.slp.staleDACheckPeriod = {{ (slp | default({})).staleDACheckPeriod | default(60) }}

#----------------------------------------------------------------------------
# SA Specific Configuration
#----------------------------------------------------------------------------

# If true, local registrations are monitored. Default value is true.
net.slp.watchRegistrationPID = {{ (slp | default({})).watchRegistrationPID | default(True) }}

#----------------------------------------------------------------------------
# UA Specific Configuration
#----------------------------------------------------------------------------

# Maximum number of results to accumulate and return for a synchronous request. Default value is 256.
net.slp.maxResults = {{ (slp | default({})).maxResults | default(256) }}

# If true, libslp sends SLP v1 commands. Default is false.
net.slp.preferSLPv1 = {{ (slp | default({})).preferSLPv1 | default(False) }}

#----------------------------------------------------------------------------
# Network Configuration Properties
#----------------------------------------------------------------------------

# Force broadcasts to be used instead of multicast. Default is false.
net.slp.isBroadcastOnly = {{ (slp | default({})).isBroadcastOnly | default(False) }}

# Whether passive DA detection should be used. Default is true.
net.slp.passiveDADetection = {{ (slp | default({})).passiveDADetection | default(True) }}

# Whether active DA detection should be used. Default is true.
net.slp.activeDADetection = {{ (slp | default({})).activeDADetection | default(True) }}

# Controls periodic transmission of active DA discovery SrvRqsts. Default setting of 1 disables sending periodic active DA discovery SrvRqsts.
net.slp.DAActiveDiscoveryInterval = {{ (slp | default({})).DAActiveDiscoveryInterval | default(1) }}

# Positive integer less than or equal to 255. Default is 255.
net.slp.multicastTTL = {{ (slp | default({})).multicastTTL | default(255) }}

# Maximum time (in milliseconds) to perform active DA discovery requests. Default is 2000 ms.
net.slp.DADiscoveryMaximumWait = {{ (slp | default({})).DADiscoveryMaximumWait | default(2000) }}

# Value-list of 32 bit integers used as timeouts, in milliseconds, for multicast convergence algorithm during active DA discovery.
net.slp.DADiscoveryTimeouts = {{ (slp | default({})).DADiscoveryTimeouts | default('500,750,1000,1500,2000,3000') }}

# Maximum time (in milliseconds) to perform multicast requests. Default is 5000 ms.
net.slp.multicastMaximumWait = {{ (slp | default({})).multicastMaximumWait | default(5000) }}

# Value-list of 32 bit integers used as timeouts, in milliseconds, for multicast convergence algorithm.
net.slp.multicastTimeouts = {{ (slp | default({})).multicastTimeouts | default('500,750,1000,1500,2000,3000') }}

# Maximum time (in milliseconds) to perform unicast requests. Default is 5000 ms.
net.slp.unicastMaximumWait = {{ (slp | default({})).unicastMaximumWait | default(5000) }}

# Value-list of 32 bit integers used as timeouts, in milliseconds, for unicast datagram transmission to DAs.
net.slp.unicastTimeouts = {{ (slp | default({})).unicastTimeouts | default('500,750,1000,1500,2000,3000') }}

# To OpenSLP the following is the same as net.slp.unicastTimeouts.  Use net.slp.unicastTimeouts instead.
;net.slp.datagramTimeouts = IGNORED

# Maximum value for all random wait parameters. Default is 5000.
net.slp.randomWaitBound = {{ (slp | default({})).randomWaitBound | default(5000) }}

# Network packet MTU in bytes. Default is 1400.
net.slp.MTU = {{ (slp | default({})).MTU | default(1400) }}

# Maximum number of interfaces that can be active if operating as an SA or DA. Default is 100.
net.slp.max_ifaces = {{ (slp | default({})).max_ifaces | default(100) }}

# List of local addresses to be used. Both IPv4 and IPv6 addresses may be specified.
net.slp.interfaces = {{ (slp | default({})).interfaces | default('192.168.0.1') }}

# Broadcast address to use when sending broadcast packets.
net.slp.broadcastAddr = {{ (slp | default({})).broadcastAddr | default('255.255.255.255') }}

# Port to use for all SLP messages. Default is 427.
net.slp.port = {{ (slp | default({})).port | default(427) }}

# Whether DHCP should be used for DA discovery and/or scope discovery. Default is true.
net.slp.useDHCP = {{ (slp | default({})).useDHCP | default(True) }}

#----------------------------------------------------------------------------
# Security
#----------------------------------------------------------------------------

# Whether the agent should enable security for URLs, attribute lists, DAAdverts, and SAAdverts. Default is false.
net.slp.securityEnabled = {{ (slp | default({})).securityEnabled | default(False) }}

# Whether the DA or SA will only allow deregistrations and re-registration from the exact host that made the registration. Default is true.
net.slp.checkSourceAddr = {{ (slp | default({})).checkSourceAddr | default(True) }}

#----------------------------------------------------------------------------
# Indexing
#----------------------------------------------------------------------------

# Whether SLP service types should be indexed. Default setting is false.
net.slp.indexSrvtype = {{ (slp | default({})).indexSrvtype | default(False) }}

# List of names of attributes with string values that should be indexed.
net.slp.indexedAttributes = {{ (slp | default({})).indexedAttributes | default('attr1,attr2,...') }}

#----------------------------------------------------------------------------
# Tracing and Logging
#----------------------------------------------------------------------------

# Printing of messages about traffic with DAs. Default is false.
net.slp.traceDATraffic = {{ (slp | default({})).traceDATraffic | default(False) }}

# Dumps of all registered services upon registration and deregistration. Default is false.
net.slp.traceReg = {{ (slp | default({})).traceReg | default(False) }}

# Printing details when a SLP message is dropped. Default is false.
net.slp.traceDrop = {{ (slp | default({})).traceDrop | default(False) }}

# Printing of details on SLP messages. Very verbose. Default is false.
net.slp.traceMsg = {{ (slp | default({})).traceMsg | default(False) }}

# Whether slpd appends log messages to slpd.log or overwrites the existing log. Default is true.
net.slp.appendLog = {{ (slp | default({})).appendLog | default(True) }}

#----------------------------------------------------------------------------
# Serialized Proxy Registration
#----------------------------------------------------------------------------
# The net.slp.serializedRegURL is not supported by net.slp.serializeRegURL.
#
# slpd accepts the [-r] command line parameter that specifies the serialized
# registration file.  The default serialized registration file is 
# /etc/slp.reg

#----------------------------------------------------------------------------
# IPv6 configuration options
#----------------------------------------------------------------------------

# Whether IPv4 is enabled for SLP. Default is true.
net.slp.useIPv4 = {{ (slp | default({})).useIPv4 | default(True) }}

# Whether IPv6 is enabled for SLP. Default is false.
net.slp.useIPv6 = {{ (slp | default({})).useIPv6 | default(False) }}
