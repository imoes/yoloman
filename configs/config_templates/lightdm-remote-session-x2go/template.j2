# vim:syntax=apparmor
# Profile for restricting lightdm remote session for X2Go
# Based on the Guest Account Apparmor script from:
# Author: Martin Pitt <martin.pitt@ubuntu.com>
#         Mike Gabriel <mike.gabriel@das-netzwerkteam.de>
#
# This template is self-documenting. Every path and directive is annotated
# with its purpose from the original upstream configuration. No schema variables
# are present as this is a static security profile; defaults are embedded.

#include <tunables/global>

/usr/lib/lightdm-remote-session-x2go/x2go-session-wrapper {
  # Include standard authentication abstraction (PAM, NSS, etc.)
  #include <abstractions/authentication>
  
  # Include standard name service abstraction (resolv.conf, hosts, nsswitch)
  #include <abstractions/nameservice>
  
  # Include wtmp/utmp abstraction for login tracking
  #include <abstractions/wutmp>

  # Read/Write config for compizconfig
  # Bug reference: https://launchpad.net/bugs/697678
  /etc/compizconfig/config rw,

  # Root filesystem read access
  / r,

  # Binary execution permissions
  /bin/ rmix,
  # fusermount requires 'Px' (profile execution) to mount user namespaces
  /bin/fusermount Px,
  # All binaries under /bin
  /bin/** rmix,

  # CD-ROM access
  /cdrom/ rmix,
  /cdrom/** rmix,

  # Device nodes read access
  /dev/ r,
  # Read/Write device nodes (e.g. audio, graphics)
  /dev/** rmw,
  # Shared memory owner access
  owner /dev/shm/** rmw,

  # Etc directory: Read access to root, Read/Map/Exec for files
  /etc/ r,
  /etc/** rmk,
  # Specific include for GDM Xsession script
  /etc/gdm/Xsession ix,

  # Library directories: Read/Map/Exec
  /lib/ r,
  /lib/** rmixk,
  /lib32/ r,
  /lib32/** rmixk,
  /lib64/ r,
  /lib64/** rmixk,

  # Media directories (USB sticks, etc.) - Owner read/write/link/exec
  owner /media/ r,
  owner /media/** rmwlixk,

  # Opt directory: Read/Map/Exec
  /opt/ r,
  /opt/** rmixk,

  # Proc filesystem access
  @{PROC}/ r,
  @{PROC}/* rm,
  @{PROC}/asound rm,
  @{PROC}/asound/** rm,
  @{PROC}/ati rm,
  @{PROC}/ati/** rm,
  owner @{PROC}/** rm,
  # Needed for gnome-keyring-daemon status check
  @{PROC}/*/status r,

  # Sbin directory: Read/Map/Exec
  /sbin/ r,
  /sbin/** rmixk,

  # Sys filesystem: Read only
  /sys/ r,
  /sys/** rm,

  # Temp directories: Read/Write
  /tmp/ rw,
  owner /tmp/** rwlkmix,
  /var/tmp/ rw,
  owner /var/tmp/** rwlkm,

  # Runtime directories: Read
  /{,var/}run/ r,
  # Necessary for writing to sockets (Map/Exec/Link)
  /{,var/}run/** rmkix,
  # Write access to shm in run
  /{,var/}run/shm/** wl,

  # UUID generator access (required by pyhoca-cli)
  @{PROC}/sys/kernel/random/uuid r,
  /var/lib/libuuid/clock.txt rw,

  # Systemd journal log access
  /run/systemd/journal/dev-log w,

  # X2Go socket read access
  /tmp/**/.x2go-socket r,
  # X11 unix socket write access (display 0-9)
  /tmp/.X11-unix/X[0-9]* wr,

  # UUId request write access
  /run/uuidd/request w,

  # Kernel ngroups_max read access
  /proc/sys/kernel/ngroups_max r,

  # Allow all network types (TCP/UDP etc)
  network,

  # D-Bus permissions
  dbus(send) bus=session,
  dbus(send, receive) bus=accessibility,

  # Capabilities
  capability ipc_lock,

  # Deny high-privilege capabilities to silence warnings/secure
  deny capability dac_override,
  deny capability dac_read_search,

  # Deny writes to system binaries and crash directories
  # Note: /etc/** write was commented out in original due to LP#697678
  # deny /etc/** w,
  deny /usr/** w,
  deny /var/crash/ w,
}
