{
  "name": {
    "type": "string",
    "default": "%H",
    "description": "The name the service will advertise to iTunes."
  },
  "password": {
    "type": "string",
    "default": "secret",
    "description": "(AirPlay 1 only) Password to require for connection."
  },
  "interpolation": {
    "type": "string",
    "default": "auto",
    "description": "Audio stuffing method: auto, basic, or soxr.",
    "enum": [
      "auto",
      "basic",
      "soxr"
    ]
  },
  "output_backend": {
    "type": "string",
    "default": "alsa",
    "description": "Audio output backend: alsa, pipe, stdout, pa, jack, pw, etc.",
    "enum": [
      "alsa",
      "pipe",
      "stdout",
      "pa",
      "jack",
      "pw"
    ]
  },
  "mdns_backend": {
    "type": "string",
    "default": "avahi",
    "description": "mDNS/Bonjour backend: avahi, etc."
  },
  "interface": {
    "type": "string",
    "default": "name",
    "description": "Network interface name. Leave empty/nil for auto."
  },
  "udp_port_base": {
    "type": "number",
    "default": 6001,
    "description": "(AirPlay 1 only) Start UDP port number."
  },
  "udp_port_range": {
    "type": "number",
    "default": 10,
    "description": "(AirPlay 1 only) Range of UDP ports to scan."
  },
  "airplay_device_id_offset": {
    "type": "number",
    "default": 0,
    "description": "(AirPlay 2 only) Offset for device ID."
  },
  "airplay_device_id": {
    "type": "string",
    "default": "<six-digit_hexadecimal_number>",
    "description": "(AirPlay 2 only) Hexadecimal device ID (12 digits)."
  },
  "regtype": {
    "type": "string",
    "default": "<string>",
    "description": "Service type string for Zeroconf/Bonjour."
  },
  "drift_tolerance_in_seconds": {
    "type": "number",
    "default": 0.002,
    "description": "Allowed timing drift before correction."
  },
  "resync_threshold_in_seconds": {
    "type": "number",
    "default": 0.05,
    "description": "Resynchronization threshold."
  },
  "resync_recovery_time_in_seconds": {
    "type": "number",
    "default": 0.1,
    "description": "Recovery time after resync."
  },
  "playback_mode": {
    "type": "string",
    "default": "stereo",
    "description": "Playback mode: stereo, mono, etc.",
    "enum": [
      "stereo",
      "mono",
      "reverse stereo",
      "both left",
      "both right"
    ]
  },
  "alac_decoder": {
    "type": "string",
    "default": "hammerton",
    "description": "ALAC decoder: hammerton or apple.",
    "enum": [
      "hammerton",
      "apple"
    ]
  },
  "ignore_volume_control": {
    "type": "string",
    "default": "no",
    "description": "Ignore source volume control."
  },
  "volume_range_db": {
    "type": "number",
    "default": 60,
    "description": "Volume range in dB (30-150)."
  },
  "volume_max_db": {
    "type": "number",
    "default": 0.0,
    "description": "Maximum volume in dB."
  },
  "volume_control_profile": {
    "type": "string",
    "default": "standard",
    "description": "Volume control profile: standard, flat, dasl_tapered.",
    "enum": [
      "standard",
      "flat",
      "dasl_tapered"
    ]
  },
  "volume_control_combined_hardware_priority": {
    "type": "string",
    "default": "no",
    "description": "Prioritize hardware mixer for volume reduction."
  },
  "default_airplay_volume": {
    "type": "number",
    "default": -24.0,
    "description": "Default volume after reset or idle timeout."
  },
  "high_threshold_airplay_volume": {
    "type": "number",
    "default": -16.0,
    "description": "Volume threshold for 'very loud' detection."
  },
  "high_volume_idle_timeout_in_minutes": {
    "type": "number",
    "default": 0,
    "description": "Idle minutes before resetting volume from very loud state."
  },
  "audio_backend_latency_offset_in_seconds": {
    "type": "number",
    "default": 0.0,
    "description": "Fixed latency offset for audio output."
  },
  "audio_backend_buffer_desired_length_in_seconds": {
    "type": "number",
    "default": 0.2,
    "description": "Desired buffer length in seconds."
  },
  "audio_backend_buffer_interpolation_threshold_in_seconds": {
    "type": "number",
    "default": 0.075,
    "description": "Buffer threshold to stop interpolation."
  },
  "audio_backend_silent_lead_in_time": {
    "type": "string",
    "default": "auto",
    "description": "Silent lead-in time: auto or numeric."
  },
  "dbus_service_bus": {
    "type": "string",
    "default": "system",
    "description": "DBus bus name: system or session.",
    "enum": [
      "system",
      "session"
    ]
  },
  "mpris_service_bus": {
    "type": "string",
    "default": "system",
    "description": "MPRIS bus name: system or session.",
    "enum": [
      "system",
      "session"
    ]
  },
  "resend_control_first_check_time": {
    "type": "number",
    "default": 0.1,
    "description": "Wait time before checking for missing packet."
  },
  "resend_control_check_interval_time": {
    "type": "number",
    "default": 0.25,
    "description": "Interval between packet resend requests."
  },
  "resend_control_last_check_time": {
    "type": "number",
    "default": 0.1,
    "description": "Latest time to check for missing packet."
  },
  "missing_port_dacp_scan_interval_seconds": {
    "type": "number",
    "default": 2.0,
    "description": "Interval to scan for DACP port."
  },
  "active_state_timeout": {
    "type": "number",
    "default": 10.0,
    "description": "Seconds to wait after play ends to leave active state."
  },
  "wait_for_completion": {
    "type": "string",
    "default": "no",
    "description": "Wait for run_this scripts to finish."
  },
  "allow_session_interruption": {
    "type": "string",
    "default": "no",
    "description": "Allow another device to interrupt playback."
  },
  "session_timeout": {
    "type": "number",
    "default": 120,
    "description": "Seconds to wait after source disappears."
  },
  "alsa_output_device": {
    "type": "string",
    "default": "default",
    "description": "ALSA output device name."
  },
  "alsa_mixer_control_name": {
    "type": "string",
    "default": "PCM",
    "description": "ALSA mixer control name."
  },
  "alsa_mixer_control_index": {
    "type": "number",
    "default": 0,
    "description": "ALSA mixer control index."
  },
  "alsa_mixer_device": {
    "type": "string",
    "default": "default",
    "description": "ALSA mixer device name."
  },
  "alsa_output_rate": {
    "type": "string",
    "default": "auto",
    "description": "ALSA output rate: auto, 44100, etc.",
    "enum": [
      "auto",
      "44100",
      "88200",
      "176400",
      "352800"
    ]
  },
  "alsa_output_format": {
    "type": "string",
    "default": "auto",
    "description": "ALSA output format: auto, S16, etc.",
    "enum": [
      "auto",
      "U8",
      "S8",
      "S16",
      "S16_LE",
      "S16_BE",
      "S24",
      "S24_LE",
      "S24_BE",
      "S24_3LE",
      "S24_3BE",
      "S32",
      "S32_LE",
      "S32_BE"
    ]
  },
  "alsa_disable_synchronization": {
    "type": "string",
    "default": "no",
    "description": "Disable synchronization (troubleshooting)."
  },
  "alsa_use_mmap_if_available": {
    "type": "string",
    "default": "yes",
    "description": "Use MMAP for output."
  },
  "alsa_use_hardware_mute_if_available": {
    "type": "string",
    "default": "no",
    "description": "Use hardware mute."
  },
  "alsa_maximum_stall_time": {
    "type": "number",
    "default": 0.2,
    "description": "Max stall time before error."
  },
  "alsa_use_precision_timing": {
    "type": "string",
    "default": "auto",
    "description": "Precision timing: auto, yes, no.",
    "enum": [
      "auto",
      "yes",
      "no"
    ]
  },
  "alsa_disable_standby_mode": {
    "type": "string",
    "default": "never",
    "description": "Disable DAC standby: always, auto, never.",
    "enum": [
      "always",
      "auto",
      "never",
      "yes",
      "no"
    ]
  },
  "alsa_disable_standby_mode_silence_threshold": {
    "type": "number",
    "default": 0.04,
    "description": "Silence threshold to trigger standby disable."
  },
  "alsa_disable_standby_mode_silence_scan_interval": {
    "type": "number",
    "default": 0.004,
    "description": "Interval to scan buffer for silence."
  },
  "pw_application_name": {
    "type": "string",
    "default": "Shairport Sync",
    "description": "PipeWire application name."
  },
  "pw_node_name": {
    "type": "string",
    "default": "Shairport Sync",
    "description": "PipeWire node name."
  },
  "pw_sink_target": {
    "type": "string",
    "default": "<sink target name>",
    "description": "PipeWire sink target."
  },
  "sndio_device": {
    "type": "string",
    "default": "default",
    "description": "Sndio output device."
  },
  "sndio_rate": {
    "type": "number",
    "default": 44100,
    "description": "Sndio output rate."
  },
  "sndio_format": {
    "type": "string",
    "default": "S16",
    "description": "Sndio output format."
  },
  "pa_server": {
    "type": "string",
    "default": "host",
    "description": "PulseAudio server address."
  },
  "pa_sink": {
    "type": "string",
    "default": "Sink Name",
    "description": "PulseAudio sink name."
  },
  "pa_application_name": {
    "type": "string",
    "default": "Shairport Sync",
    "description": "PulseAudio application name."
  },
  "jack_client_name": {
    "type": "string",
    "default": "shairport-sync",
    "description": "JACK client name."
  },
  "jack_autoconnect_pattern": {
    "type": "string",
    "default": "",
    "description": "JACK autoconnect regex pattern."
  },
  "jack_soxr_resample_quality": {
    "type": "string",
    "default": "none",
    "description": "JACK resampling quality: none, low, medium, high, very high.",
    "enum": [
      "none",
      "low",
      "medium",
      "high",
      "very high"
    ]
  },
  "pipe_name": {
    "type": "string",
    "default": "/tmp/shairport-sync-audio",
    "description": "Pipe output path."
  },
  "dsp_convolution": {
    "type": "string",
    "default": "no",
    "description": "Enable convolution filter."
  },
  "dsp_convolution_ir_file": {
    "type": "string",
    "default": "impulse.wav",
    "description": "Impulse response file for convolution."
  },
  "dsp_convolution_gain": {
    "type": "number",
    "default": -4.0,
    "description": "Static gain for convolution."
  },
  "dsp_convolution_max_length": {
    "type": "number",
    "default": 44100,
    "description": "Max length of impulse response."
  },
  "dsp_loudness": {
    "type": "string",
    "default": "no",
    "description": "Enable loudness compensation."
  },
  "dsp_loudness_reference_volume_db": {
    "type": "number",
    "default": -20.0,
    "description": "Reference volume for loudness filter."
  },
  "metadata_enabled": {
    "type": "string",
    "default": "yes",
    "description": "Enable metadata solicitation."
  },
  "metadata_include_cover_art": {
    "type": "string",
    "default": "yes",
    "description": "Include cover art in metadata."
  },
  "metadata_cover_art_cache_directory": {
    "type": "string",
    "default": "/tmp/shairport-sync/.cache/coverart",
    "description": "Directory for cover art cache."
  },
  "metadata_pipe_name": {
    "type": "string",
    "default": "/tmp/shairport-sync-metadata",
    "description": "Metadata pipe path."
  },
  "metadata_pipe_timeout": {
    "type": "number",
    "default": 5000,
    "description": "Pipe timeout in milliseconds."
  },
  "metadata_progress_interval": {
    "type": "number",
    "default": 0.0,
    "description": "Progress message interval in seconds."
  },
  "metadata_socket_address": {
    "type": "string",
    "default": "226.0.0.1",
    "description": "UDP socket address for metadata."
  },
  "metadata_socket_port": {
    "type": "number",
    "default": 5555,
    "description": "UDP socket port for metadata."
  },
  "metadata_socket_msglength": {
    "type": "number",
    "default": 65000,
    "description": "Max UDP message length."
  },
  "mqtt_enabled": {
    "type": "string",
    "default": "no",
    "description": "Enable MQTT service."
  },
  "mqtt_hostname": {
    "type": "string",
    "default": "iot.eclipse.org",
    "description": "MQTT broker hostname."
  },
  "mqtt_port": {
    "type": "number",
    "default": 1883,
    "description": "MQTT broker port."
  },
  "mqtt_username": {
    "type": "string",
    "default": "NULL",
    "description": "MQTT username."
  },
  "mqtt_password": {
    "type": "string",
    "default": "NULL",
    "description": "MQTT password."
  },
  "mqtt_capath": {
    "type": "string",
    "default": "NULL",
    "description": "CA certificates path."
  },
  "mqtt_cafile": {
    "type": "string",
    "default": "NULL",
    "description": "CA certificates file."
  },
  "mqtt_certfile": {
    "type": "string",
    "default": "NULL",
    "description": "Client certificate file."
  },
  "mqtt_keyfile": {
    "type": "string",
    "default": "NULL",
    "description": "Client key file."
  },
  "mqtt_topic": {
    "type": "string",
    "default": "NULL",
    "description": "MQTT topic."
  },
  "mqtt_publish_raw": {
    "type": "string",
    "default": "no",
    "description": "Publish raw metadata."
  },
  "mqtt_publish_parsed": {
    "type": "string",
    "default": "no",
    "description": "Publish parsed metadata."
  },
  "mqtt_empty_payload_substitute": {
    "type": "string",
    "default": "--",
    "description": "Substitute for empty payloads."
  },
  "mqtt_publish_cover": {
    "type": "string",
    "default": "no",
    "description": "Publish cover art."
  },
  "mqtt_enable_autodiscovery": {
    "type": "string",
    "default": "no",
    "description": "Enable Home Assistant autodiscovery."
  },
  "mqtt_autodiscovery_prefix": {
    "type": "string",
    "default": "homeassistant",
    "description": "Autodiscovery topic prefix."
  },
  "mqtt_enable_remote": {
    "type": "string",
    "default": "no",
    "description": "Enable remote control via MQTT."
  },
  "diagnostics_disable_resend_requests": {
    "type": "string",
    "default": "no",
    "description": "Disable packet resend requests."
  },
  "diagnostics_log_output_to": {
    "type": "string",
    "default": "syslog",
    "description": "Log output destination.",
    "enum": [
      "syslog",
      "stderr"
    ]
  },
  "diagnostics_statistics": {
    "type": "string",
    "default": "no",
    "description": "Print statistics in log."
  },
  "diagnostics_log_verbosity": {
    "type": "number",
    "default": 0,
    "description": "Log verbosity level (0-3)."
  },
  "diagnostics_log_show_file_and_line": {
    "type": "string",
    "default": "yes",
    "description": "Show file and line in logs."
  },
  "diagnostics_log_show_time_since_startup": {
    "type": "string",
    "default": "no",
    "description": "Show time since startup in logs."
  },
  "diagnostics_log_show_time_since_last_message": {
    "type": "string",
    "default": "yes",
    "description": "Show time since last message in logs."
  },
  "diagnostics_drop_this_fraction_of_audio_packets": {
    "type": "number",
    "default": 0.0,
    "description": "Fraction of packets to drop for testing."
  },
  "diagnostics_retain_cover_art": {
    "type": "string",
    "default": "no",
    "description": "Retain cover art permanently."
  }
}
