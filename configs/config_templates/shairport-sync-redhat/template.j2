// Sample Configuration File for Shairport Sync
// Self-Documented Template: shairport-sync-redhat
// Generated from Ansible schema. All variables use explicit defaults.
// C-style comments used as per upstream shairport-sync.conf format.

// General Settings
general =
{
    // name: The name the service will advertise to iTunes. Supports %H (Hostname), %h, %v (Version).
    name = "{{ name | default('%H') }}";

    // password: (AirPlay 1 only) Password to require for connection. Leave empty/commented if not needed.
    password = "{{ password | default('secret') }}";

    // interpolation: Audio stuffing method. 'auto', 'basic', or 'soxr'. 'soxr' requires build flag and fast CPU.
    interpolation = "{{ interpolation | default('auto') }}";

    // output_backend: Audio output backend. Options: alsa, pipe, stdout, pa, jack, pw (PipeWire), sndio.
    output_backend = "{{ output_backend | default('alsa') }}";

    // mdns_backend: mDNS/Bonjour backend for service discovery. 'avahi' or 'cocoa' (macOS) or 'none'.
    mdns_backend = "{{ mdns_backend | default('avahi') }}";

    // interface: Network interface name for listening. Leave empty for auto-detection.
    interface = "{{ interface | default('name') }}";

    // port: Listen port. 5000 for AirPlay 1, 7000 for AirPlay 2. Usually determined by backend.
    // port = 5000;

    // udp_port_base: (AirPlay 1 only) Start UDP port number for audio stream allocation.
    udp_port_base = {{ udp_port_base | default('6001') }};

    // udp_port_range: (AirPlay 1 only) Range of UDP ports to scan/allocate.
    udp_port_range = {{ udp_port_range | default('10') }};

    // airplay_device_id_offset: (AirPlay 2 only) Offset for device ID calculation.
    airplay_device_id_offset = {{ airplay_device_id_offset | default('0') }};

    // airplay_device_id: (AirPlay 2 only) Hexadecimal device ID (12 digits). Must end with L.
    airplay_device_id = 0x{{ airplay_device_id | default('000000000000') }}L;

    // regtype: Service type string for Zeroconf/Bonjour. e.g., "_raop._tcp" or "_airplay._tcp".
    regtype = "{{ regtype | default('_raop._tcp') }}";

    // drift_tolerance_in_seconds: Allowed timing drift before correction is applied.
    drift_tolerance_in_seconds = {{ drift_tolerance_in_seconds | default('0.002') }};

    // resync_threshold_in_seconds: Error threshold triggering resynchronization. 0 disables.
    resync_threshold_in_seconds = {{ resync_threshold_in_seconds | default('0.050') }};

    // resync_recovery_time_in_seconds: Extra time allowed to recover after a late resync.
    resync_recovery_time_in_seconds = {{ resync_recovery_time_in_seconds | default('0.100') }};

    // playback_mode: Channel mode. 'stereo', 'mono', 'reverse stereo', etc.
    playback_mode = "{{ playback_mode | default('stereo') }}";

    // alac_decoder: ALAC decoder engine. 'hammerton' (default) or 'apple'.
    alac_decoder = "{{ alac_decoder | default('hammerton') }}";

    // ignore_volume_control: Ignore source volume control and maintain 100% output.
    ignore_volume_control = "{{ ignore_volume_control | default('no') }}";

    // volume_range_db: Range between max and min volume in dB (30-150).
    volume_range_db = {{ volume_range_db | default('60') }};

    // volume_max_db: Maximum volume in dB (e.g., -96.2 to 0.0).
    volume_max_db = {{ volume_max_db | default('0.0') }};

    // volume_control_profile: Profile for volume attenuation. 'standard', 'flat', 'dasl_tapered'.
    volume_control_profile = "{{ volume_control_profile | default('standard') }}";

    // volume_control_combined_hardware_priority: Prioritize hardware mixer for volume reduction.
    volume_control_combined_hardware_priority = "{{ volume_control_combined_hardware_priority | default('no') }}";

    // default_airplay_volume: Default volume after reset/idle.
    default_airplay_volume = {{ default_airplay_volume | default('-24.0') }};

    // high_threshold_airplay_volume: Volume level considered "very loud" (dB).
    high_threshold_airplay_volume = {{ high_threshold_airplay_volume | default('-16.0') }};

    // high_volume_idle_timeout_in_minutes: Minutes of idleness before resetting "very loud" volume to default.
    high_volume_idle_timeout_in_minutes = {{ high_volume_idle_timeout_in_minutes | default('0') }};

    // audio_backend_latency_offset_in_seconds: Fixed latency offset for output synchronization.
    audio_backend_latency_offset_in_seconds = {{ audio_backend_latency_offset_in_seconds | default('0.0') }};

    // audio_backend_buffer_desired_length_in_seconds: Desired buffer length to prevent underruns.
    audio_backend_buffer_desired_length_in_seconds = {{ audio_backend_buffer_desired_length_in_seconds | default('0.2') }};

    // audio_backend_buffer_interpolation_threshold_in_seconds: Stop interpolation if buffer drops below this.
    audio_backend_buffer_interpolation_threshold_in_seconds = {{ audio_backend_buffer_interpolation_threshold_in_seconds | default('0.075') }};

    // audio_backend_silent_lead_in_time: Silence duration before audio starts. 'auto' or numeric.
    audio_backend_silent_lead_in_time = "{{ audio_backend_silent_lead_in_time | default('auto') }}";

    // dbus_service_bus: D-Bus bus name. 'system' or 'session'.
    dbus_service_bus = "{{ dbus_service_bus | default('system') }}";

    // mpris_service_bus: MPRIS bus name. 'system' or 'session'.
    mpris_service_bus = "{{ mpris_service_bus | default('system') }}";

    // resend_control_first_check_time: Wait time before checking for missing audio packets.
    resend_control_first_check_time = {{ resend_control_first_check_time | default('0.10') }};

    // resend_control_check_interval_time: Interval between packet resend requests.
    resend_control_check_interval_time = {{ resend_control_check_interval_time | default('0.25') }};

    // resend_control_last_check_time: Latest time to check for missing packets.
    resend_control_last_check_time = {{ resend_control_last_check_time | default('0.10') }};

    // missing_port_dacp_scan_interval_seconds: Interval to scan for DACP port if not provided.
    missing_port_dacp_scan_interval_seconds = {{ missing_port_dacp_scan_interval_seconds | default('2.0') }};

    // active_state_timeout: Seconds to stay in active state after play ends.
    active_state_timeout = {{ active_state_timeout | default('10.0') }};
};

// Advanced parameters for controlling how Shairport Sync stays active and how it runs a session
sessioncontrol =
{
    // active_state_timeout: Wait seconds after play ends before leaving active state.
    active_state_timeout = {{ active_state_timeout | default('10.0') }};

    // wait_for_completion: Wait for run_this scripts to finish before continuing.
    wait_for_completion = "{{ wait_for_completion | default('no') }}";

    // allow_session_interruption: Allow another device to interrupt playback.
    allow_session_interruption = "{{ allow_session_interruption | default('no') }}";

    // session_timeout: Seconds to wait after source disappears before terminating session.
    session_timeout = {{ session_timeout | default('120') }};
};

// Back End Settings

// ALSA Audio Backend
alsa =
{
    // alsa_output_device: ALSA output device name (e.g., 'default', 'hw:0,0').
    alsa_output_device = "{{ alsa_output_device | default('default') }}";

    // alsa_mixer_control_name: Mixer control name (e.g., 'PCM').
    alsa_mixer_control_name = "{{ alsa_mixer_control_name | default('PCM') }}";

    // alsa_mixer_control_index: Mixer control index.
    alsa_mixer_control_index = {{ alsa_mixer_control_index | default('0') }};

    // alsa_mixer_device: Mixer device name. Usually same as output_device.
    alsa_mixer_device = "{{ alsa_mixer_device | default('default') }}";

    // alsa_output_rate: Output sample rate. 'auto', 44100, 88200, etc.
    alsa_output_rate = "{{ alsa_output_rate | default('auto') }}";

    // alsa_output_format: Output sample format. 'auto', S16, S24_3LE, etc.
    alsa_output_format = "{{ alsa_output_format | default('auto') }}";

    // alsa_disable_synchronization: Disable sync. For troubleshooting only.
    alsa_disable_synchronization = "{{ alsa_disable_synchronization | default('no') }}";

    // alsa_use_mmap_if_available: Use MMAP for output.
    alsa_use_mmap_if_available = "{{ alsa_use_mmap_if_available | default('yes') }}";

    // alsa_use_hardware_mute_if_available: Use hardware mute if supported.
    alsa_use_hardware_mute_if_available = "{{ alsa_use_hardware_mute_if_available | default('no') }}";

    // alsa_maximum_stall_time: Max stall time before error.
    alsa_maximum_stall_time = {{ alsa_maximum_stall_time | default('0.200') }};

    // alsa_use_precision_timing: Use precision timing. 'auto', 'yes', 'no'.
    alsa_use_precision_timing = "{{ alsa_use_precision_timing | default('auto') }}";

    // alsa_disable_standby_mode: Disable DAC standby. 'always', 'auto', 'never'.
    alsa_disable_standby_mode = "{{ alsa_disable_standby_mode | default('never') }}";

    // alsa_disable_standby_mode_silence_threshold: Silence threshold to trigger standby disable.
    alsa_disable_standby_mode_silence_threshold = {{ alsa_disable_standby_mode_silence_threshold | default('0.040') }};

    // alsa_disable_standby_mode_silence_scan_interval: Interval to scan buffer for silence.
    alsa_disable_standby_mode_silence_scan_interval = {{ alsa_disable_standby_mode_silence_scan_interval | default('0.004') }};
};

// PipeWire Audio Backend
pw =
{
    // pw_application_name: Name shown in PipeWire volume controls.
    pw_application_name = "{{ pw_application_name | default('Shairport Sync') }}";

    // pw_node_name: Name shown in PipeWire CLI tools.
    pw_node_name = "{{ pw_node_name | default('Shairport Sync') }}";

    // pw_sink_target: Specific PipeWire sink to use.
    pw_sink_target = "{{ pw_sink_target | default('<sink target name>') }}";
};

// Sndio Audio Backend
sndio =
{
    // sndio_device: Output device name.
    sndio_device = "{{ sndio_device | default('default') }}";

    // sndio_rate: Output sample rate.
    sndio_rate = {{ sndio_rate | default('44100') }};

    // sndio_format: Output sample format.
    sndio_format = "{{ sndio_format | default('S16') }}";
};

// PulseAudio Audio Backend
pa =
{
    // pa_server: PulseAudio server address.
    pa_server = "{{ pa_server | default('host') }}";

    // pa_sink: PulseAudio sink name.
    pa_sink = "{{ pa_sink | default('Sink Name') }}";

    // pa_application_name: Application name in PulseAudio.
    pa_application_name = "{{ pa_application_name | default('Shairport Sync') }}";
};

// JACK Audio Backend
jack =
{
    // jack_client_name: JACK client name.
    jack_client_name = "{{ jack_client_name | default('shairport-sync') }}";

    // jack_autoconnect_pattern: Regex for auto-connecting ports.
    jack_autoconnect_pattern = "{{ jack_autoconnect_pattern | default('') }}";

    // jack_soxr_resample_quality: Resampling quality. 'none', 'low', 'medium', 'high', 'very high'.
    jack_soxr_resample_quality = "{{ jack_soxr_resample_quality | default('none') }}";
};

// Pipe Backend
pipe =
{
    // pipe_name: Path to the pipe file.
    pipe_name = "{{ pipe_name | default('/tmp/shairport-sync-audio') }}";
};

// Digital Signal Processing (DSP)
dsp =
{
    // dsp_convolution: Enable convolution filter.
    dsp_convolution = "{{ dsp_convolution | default('no') }}";

    // dsp_convolution_ir_file: Impulse response file for convolution.
    dsp_convolution_ir_file = "{{ dsp_convolution_ir_file | default('impulse.wav') }}";

    // dsp_convolution_gain: Static gain for convolution.
    dsp_convolution_gain = {{ dsp_convolution_gain | default('-4.0') }};

    // dsp_convolution_max_length: Max length of impulse response.
    dsp_convolution_max_length = {{ dsp_convolution_max_length | default('44100') }};

    // dsp_loudness: Enable loudness compensation filter.
    dsp_loudness = "{{ dsp_loudness | default('no') }}";

    // dsp_loudness_reference_volume_db: Reference volume for loudness filter.
    dsp_loudness_reference_volume_db = {{ dsp_loudness_reference_volume_db | default('-20.0') }};
};

// Metadata Settings
metadata =
{
    // metadata_enabled: Enable metadata solicitation and piping.
    metadata_enabled = "{{ metadata_enabled | default('yes') }}";

    // metadata_include_cover_art: Include cover art in metadata.
    metadata_include_cover_art = "{{ metadata_include_cover_art | default('yes') }}";

    // metadata_cover_art_cache_directory: Directory for cover art cache.
    metadata_cover_art_cache_directory = "{{ metadata_cover_art_cache_directory | default('/tmp/shairport-sync/.cache/coverart') }}";

    // metadata_pipe_name: Path for metadata pipe.
    metadata_pipe_name = "{{ metadata_pipe_name | default('/tmp/shairport-sync-metadata') }}";

    // metadata_pipe_timeout: Pipe timeout in milliseconds.
    metadata_pipe_timeout = {{ metadata_pipe_timeout | default('5000') }};

    // metadata_progress_interval: Interval for progress messages.
    metadata_progress_interval = {{ metadata_progress_interval | default('0.0') }};

    // metadata_socket_address: UDP socket address for metadata.
    metadata_socket_address = "{{ metadata_socket_address | default('226.0.0.1') }}";

    // metadata_socket_port: UDP socket port for metadata.
    metadata_socket_port = {{ metadata_socket_port | default('5555') }};

    // metadata_socket_msglength: Max UDP message length.
    metadata_socket_msglength = {{ metadata_socket_msglength | default('65000') }};
};

// MQTT Settings
mqtt =
{
    // mqtt_enabled: Enable MQTT service.
    mqtt_enabled = "{{ mqtt_enabled | default('no') }}";

    // mqtt_hostname: MQTT broker hostname.
    mqtt_hostname = "{{ mqtt_hostname | default('iot.eclipse.org') }}";

    // mqtt_port: MQTT broker port.
    mqtt_port = {{ mqtt_port | default('1883') }};

    // mqtt_username: MQTT username. Use 'NULL' or empty string if not needed.
    mqtt_username = "{{ mqtt_username | default('NULL') }}";

    // mqtt_password: MQTT password. Use 'NULL' or empty string if not needed.
    mqtt_password = "{{ mqtt_password | default('NULL') }}";

    // mqtt_capath: CA certificates path.
    mqtt_capath = "{{ mqtt_capath | default('NULL') }}";

    // mqtt_cafile: CA certificates file.
    mqtt_cafile = "{{ mqtt_cafile | default('NULL') }}";

    // mqtt_certfile: Client certificate file.
    mqtt_certfile = "{{ mqtt_certfile | default('NULL') }}";

    // mqtt_keyfile: Client key file.
    mqtt_keyfile = "{{ mqtt_keyfile | default('NULL') }}";

    // mqtt_topic: MQTT topic for this instance.
    mqtt_topic = "{{ mqtt_topic | default('NULL') }}";

    // mqtt_publish_raw: Publish raw metadata.
    mqtt_publish_raw = "{{ mqtt_publish_raw | default('no') }}";

    // mqtt_publish_parsed: Publish parsed metadata.
    mqtt_publish_parsed = "{{ mqtt_publish_parsed | default('no') }}";

    // mqtt_empty_payload_substitute: Substitute for empty payloads.
    mqtt_empty_payload_substitute = "{{ mqtt_empty_payload_substitute | default('--') }}";

    // mqtt_publish_cover: Publish cover art via MQTT.
    mqtt_publish_cover = "{{ mqtt_publish_cover | default('no') }}";

    // mqtt_enable_autodiscovery: Enable Home Assistant autodiscovery.
    mqtt_enable_autodiscovery = "{{ mqtt_enable_autodiscovery | default('no') }}";

    // mqtt_autodiscovery_prefix: Autodiscovery topic prefix.
    mqtt_autodiscovery_prefix = "{{ mqtt_autodiscovery_prefix | default('homeassistant') }}";

    // mqtt_enable_remote: Enable remote control via MQTT.
    mqtt_enable_remote = "{{ mqtt_enable_remote | default('no') }}";
};

// Diagnostic Settings
diagnostics =
{
    // diagnostics_disable_resend_requests: Disable packet resend requests.
    diagnostics_disable_resend_requests = "{{ diagnostics_disable_resend_requests | default('no') }}";

    // diagnostics_log_output_to: Log destination. 'syslog', 'stderr', 'stdout', or file path.
    diagnostics_log_output_to = "{{ diagnostics_log_output_to | default('syslog') }}";

    // diagnostics_statistics: Print statistics in log.
    diagnostics_statistics = "{{ diagnostics_statistics | default('no') }}";

    // diagnostics_log_verbosity: Log verbosity level (0-3).
    diagnostics_log_verbosity = {{ diagnostics_log_verbosity | default('0') }};

    // diagnostics_log_show_file_and_line: Show file and line in logs.
    diagnostics_log_show_file_and_line = "{{ diagnostics_log_show_file_and_line | default('yes') }}";

    // diagnostics_log_show_time_since_startup: Show time since startup in logs.
    diagnostics_log_show_time_since_startup = "{{ diagnostics_log_show_time_since_startup | default('no') }}";

    // diagnostics_log_show_time_since_last_message: Show time since last message in logs.
    diagnostics_log_show_time_since_last_message = "{{ diagnostics_log_show_time_since_last_message | default('yes') }}";

    // diagnostics_drop_this_fraction_of_audio_packets: Fraction of packets to drop for testing.
    diagnostics_drop_this_fraction_of_audio_packets = {{ diagnostics_drop_this_fraction_of_audio_packets | default('0.0') }};

    // diagnostics_retain_cover_art: Retain cover art permanently.
    diagnostics_retain_cover_art = "{{ diagnostics_retain_cover_art | default('no') }}";
};
