{
  "listen_addr": "0.0.0.0",
  "listen_port": 5004,
  "midi_device_path": "/dev/midiC0D0",
  "keepalive_enabled": true,
  "max_clients": 6,
  "idle_timeout": 300,
  "log_level": 3,
  "log_file_path": "/var/log/dsmidiwifi.log",
  "ssl_enabled": false,
  "ssl_cert_path": "/etc/dsmidiwifi/cert.pem",
  "ssl_key_path": "/etc/dsmidiwifi/key.pem",
  "mdns_hostname": "dsmidiwifi",
  "acl_entries": [
    {
      "network": "192.168.1.0/24"
    },
    {
      "network": "10.0.0.0/24"
    }
  ]
}
