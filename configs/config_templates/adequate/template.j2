// Configuration for the 'adequate' package (Debian package quality checker).
// This file is processed by dpkg hooks to check package integrity and consistency.

{% if adequate_enabled | default('false') == 'true' %}
// Adequate::Enabled: Controls whether adequate runs on every install.
// When set to "true", it reports results via debconf.
// Schema default: 'false'
Adequate::Enabled "{{ adequate_enabled | default('false') }}";

{% endif %}
DPkg::Pre-Install-Pkgs {
    // DPkg::Pre-Install-Pkgs: Hook executed before package installation.
    // Runs adequate in pre-installation mode to check dependencies and quality.
    // Uses the user specified by adequate_user.
    // Schema variable: adequate_user (default: 'nobody')
    "adequate --help >/dev/null 2>&1 || exit 0; exec adequate --user {{ adequate_user | default('nobody') }} --apt-preinst";
};

DPkg::Post-Invoke {
    // DPkg::Post-Invoke: Hook executed after package installation/removal.
    // Runs adequate in debconf mode to report pending issues.
    // Uses the user specified by adequate_user.
    // Schema variable: adequate_user (default: 'nobody')
    "adequate --help >/dev/null 2>&1 || exit 0; exec adequate --debconf --user {{ adequate_user | default('nobody') }} --pending";
};

DPkg::Tools::Options::adequate::Version {
    // DPkg::Tools::Options::adequate::Version: Specifies the version of the DPkg::Tools::Options API.
    // Ensures compatibility with the adequate tool version.
    // Schema default: '2'
    "{{ adequate_version | default('2') }}";
};
