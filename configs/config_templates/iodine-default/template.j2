# Default settings for iodine. This file is sourced from
# /etc/init.d/iodined
START_IODINED="false"
IODINED_ARGS="{% if extra_args is defined and extra_args is not none and (extra_args is number or extra_args is boolean or extra_args | length > 0) %}{{ extra_args }} {% endif %}{% if tunnel_ip is defined and tunnel_ip is not none and (tunnel_ip is number or tunnel_ip is boolean or tunnel_ip | length > 0) %}{{ tunnel_ip }}{% endif %}{% if topdomain is defined and topdomain is not none and (topdomain is number or topdomain is boolean or topdomain | length > 0) %} {{ topdomain }}{% endif %}"
IODINED_PASSWORD="{{ password | default('') }}"
