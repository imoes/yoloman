{
  "listen_address": "0.0.0.0",
  "port": 22,
  "syslog_facility": "AUTH",
  "log_level": "INFO",
  "login_grace_time": 60,
  "permit_root_login": "no",
  "strict_modes": true,
  "max_auth_tries": 4,
  "max_sessions": 5,
  "pubkey_authentication": true,
  "authorized_keys_file": ".ssh/authorized_keys",
  "password_authentication": false,
  "permit_empty_passwords": false,
  "challenge_response_authentication": false,
  "kerberos_authentication": false,
  "gssapi_authentication": false,
  "use_pam": true,
  "accept_env": [
    "LANG",
    "LC_*"
  ],
  "set_env": [
    "PATH=/usr/local/bin:/usr/bin:/bin"
  ],
  "sftp_subsystem_enabled": true,
  "sftp_internal": true,
  "sftp_subsystem_path": "/usr/lib/openssh/sftp-server",
  "sftp_users": [
    {
      "name": "sftp-only-users",
      "match_user": "sftpuser",
      "chroot_path": "/home/sftpuser",
      "disable_tcp_forwarding": true,
      "disable_x11": true,
      "pubkey_auth_only": true
    },
    {
      "name": "group restricted SFTP",
      "match_group": "sftponly",
      "chroot_path": "/sftp/%U",
      "set_env": [
        "SFTP_CHROOT=/sftp"
      ],
      "pubkey_auth_only": true
    }
  ],
  "tcp_keep_alive": true,
  "client_alive_interval": 300,
  "client_alive_count_max": 2,
  "max_startups": "10:30:100",
  "max_sessions_global": 5,
  "banner_path": "/etc/ssh/banner",
  "print_last_log": true,
  "print_motd": false,
  "compression": "no",
  "x11_forwarding_global": false,
  "x11_display_offset": 10,
  "x11_use_localhost": true,
  "permit_user_environment": false
}
