{
  "auth": {
    "type": "object",
    "default": {
      "type": "certificate",
      "ca_cert": "/etc/ocserv/ca.pem",
      "password_db": "local",
      "radius_config": "/etc/ocserv/radius.conf",
      "realm": "VPN"
    },
    "description": "Authentication method and settings. Choose one: certificate, password, radius, or certificate+password. Adjust paths and DBs accordingly.",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "certificate",
          "password",
          "radius",
          "certificate+password"
        ],
        "default": "certificate",
        "description": "Authentication type."
      },
      "ca_cert": {
        "type": "string",
        "default": "/etc/ocserv/ca.pem",
        "description": "Path to CA certificate (required if type = 'certificate')."
      },
      "password_db": {
        "type": "string",
        "default": "local",
        "description": "Password database type: 'local' (uses /etc/ocserv/ocserv.conf user section), 'radius', or path to passwd file."
      },
      "radius_config": {
        "type": "string",
        "default": "/etc/ocserv/radius.conf",
        "description": "Path to RADIUS configuration (required if type = 'radius' or 'certificate+password')."
      },
      "realm": {
        "type": "string",
        "default": "VPN",
        "description": "Authentication realm displayed to clients."
      }
    }
  },
  "limits": {
    "type": "object",
    "default": {
      "max_sessions": 2,
      "timeout": 3600,
      "idle_timeout": 1200,
      "max_total_sessions": 100,
      "session_timeout": 0,
      "session_id_length": 32
    },
    "description": "Session and resource limits.",
    "properties": {
      "max_sessions": {
        "type": "number",
        "default": 2,
        "description": "Maximum concurrent sessions per user."
      },
      "timeout": {
        "type": "number",
        "default": 3600,
        "description": "TLS session timeout in seconds."
      },
      "idle_timeout": {
        "type": "number",
        "default": 1200,
        "description": "Idle timeout (seconds) before disconnect."
      },
      "max_total_sessions": {
        "type": "number",
        "default": 100,
        "description": "Maximum total concurrent sessions server-wide."
      },
      "session_timeout": {
        "type": "number",
        "default": 0,
        "description": "Absolute session lifetime (0 = unlimited)."
      },
      "session_id_length": {
        "type": "number",
        "default": 32,
        "description": "Length of session ID (bytes). Reduce to 16 for compatibility with older clients."
      }
    }
  },
  "network": {
    "type": "object",
    "default": {
      "ipv4_network": "192.168.1.0/24",
      "dns": [
        "8.8.8.8",
        "8.8.4.4"
      ],
      "split_dns": [],
      "routes": [
        "10.0.0.0/24"
      ],
      "nat_enabled": true,
      "nat_table": "mangle",
      "mtu": 1400,
      "keep_alive": 300,
      "ipv4_only": false,
      "ipv4_netmask": null
    },
    "description": "Network configuration for VPN clients (IPv4 only).",
    "properties": {
      "ipv4_network": {
        "type": "string",
        "default": "192.168.1.0/24",
        "description": "IPv4 address pool for VPN clients in CIDR notation."
      },
      "ipv4_netmask": {
        "type": "string",
        "default": null,
        "description": "IPv4 netmask (deprecated; prefer CIDR in ipv4_network)."
      },
      "dns": {
        "type": "list",
        "default": [
          "8.8.8.8",
          "8.8.4.4"
        ],
        "items": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "description": "DNS servers pushed to clients."
      },
      "split_dns": {
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "description": "Domains for split DNS resolution."
      },
      "routes": {
        "type": "list",
        "default": [
          "10.0.0.0/24"
        ],
        "items": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        },
        "description": "Routes pushed to clients (format: network/prefix or gateway,network/prefix)."
      },
      "nat_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable NAT/masquerade for outbound traffic from clients."
      },
      "nat_table": {
        "type": "string",
        "default": "mangle",
        "description": "iptables table for NAT rules."
      },
      "mtu": {
        "type": "number",
        "default": 1400,
        "description": "Tunnel MTU. Reduce if fragmentation issues occur."
      },
      "keep_alive": {
        "type": "number",
        "default": 300,
        "description": "Keep-alive interval (seconds) for client sessions."
      },
      "ipv4_only": {
        "type": "boolean",
        "default": false,
        "description": "Listen only on IPv4 (true) or dual-stack (false)."
      }
    }
  },
  "dpi": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "DPI (Deep Packet Inspection) protection \u2014 enables obfuscation of VPN traffic to bypass censorship.",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable DPI protection (RFC 8265-style obfuscation)."
      }
    }
  },
  "tls": {
    "type": "object",
    "default": {
      "server_cert": "/etc/ocserv/server.pem",
      "server_key": "/etc/ocserv/server.key",
      "client_cert_required": false,
      "cert_user_oid": "2.5.4.3",
      "crl_file": null,
      "dh_size": 2048,
      "ciphers": [
        "ECDHE-ECDSA-AES256-GCM-SHA384",
        "ECDHE-RSA-AES256-GCM-SHA384",
        "ECDHE-ECDSA-AES128-GCM-SHA256",
        "ECDHE-RSA-AES128-GCM-SHA256"
      ],
      "hello_timeout": 30
    },
    "description": "TLS and certificate security settings.",
    "properties": {
      "server_cert": {
        "type": "string",
        "default": "/etc/ocserv/server.pem",
        "description": "Server TLS certificate (PEM, may include chain)."
      },
      "server_key": {
        "type": "string",
        "default": "/etc/ocserv/server.key",
        "description": "Server private key (PEM, must be unencrypted)."
      },
      "client_cert_required": {
        "type": "boolean",
        "default": false,
        "description": "Require client certificates for authentication."
      },
      "cert_user_oid": {
        "type": "string",
        "default": "2.5.4.3",
        "description": "OID in client cert to extract username (default: commonName = 2.5.4.3)."
      },
      "crl_file": {
        "type": "string",
        "default": null,
        "description": "Path to Certificate Revocation List (PEM)."
      },
      "dh_size": {
        "type": "number",
        "enum": [
          1024,
          2048,
          3072,
          4096
        ],
        "default": 2048,
        "description": "Minimum DH group size. Use \u22652048 for security."
      },
      "ciphers": {
        "type": "list",
        "default": [
          "ECDHE-ECDSA-AES256-GCM-SHA384",
          "ECDHE-RSA-AES256-GCM-SHA384",
          "ECDHE-ECDSA-AES128-GCM-SHA256",
          "ECDHE-RSA-AES128-GCM-SHA256"
        ],
        "items": {
          "type": "string"
        },
        "description": "Ordered list of allowed TLS ciphers. Prefer AEAD with forward secrecy."
      },
      "hello_timeout": {
        "type": "number",
        "default": 30,
        "description": "Timeout (seconds) for TLS hello handshake."
      }
    }
  },
  "listen": {
    "type": "object",
    "default": {
      "port": 443,
      "dtls_port": 443,
      "protocol": "tcp+udp",
      "host": "0.0.0.0"
    },
    "description": "Network listening settings.",
    "properties": {
      "port": {
        "type": "number",
        "default": 443,
        "description": "TCP port to listen on (default 443 for HTTPS compatibility)."
      },
      "dtls_port": {
        "type": "number",
        "default": 443,
        "description": "UDP port for DTLS (0 to disable)."
      },
      "protocol": {
        "type": "string",
        "enum": [
          "tcp",
          "udp",
          "tcp+udp"
        ],
        "default": "tcp+udp",
        "description": "Protocols to use. 'tcp+udp' recommended for best client compatibility."
      },
      "host": {
        "type": "string",
        "default": "0.0.0.0",
        "description": "IP address to bind to (e.g., '0.0.0.0' or a specific IPv4/IPv6)."
      }
    }
  },
  "logging": {
    "type": "object",
    "default": {
      "syslog_class": 2,
      "log_file": "/var/log/ocserv.log"
    },
    "description": "Logging verbosity and target.",
    "properties": {
      "syslog_class": {
        "type": "number",
        "enum": [
          0,
          1,
          2,
          3
        ],
        "default": 2,
        "description": "Syslog level: 0=none, 1=errors, 2=info (default), 3=debug."
      },
      "log_file": {
        "type": "string",
        "default": "/var/log/ocserv.log",
        "description": "Path to log file (optional; omit or empty string to disable)."
      }
    }
  }
}
