{
  "auth": {
    "type": "certificate",
    "ca_cert": "/etc/ocserv/ca.pem",
    "realm": "MyCorp-VPN"
  },
  "limits": {
    "max_sessions": 2,
    "timeout": 3600,
    "idle_timeout": 600,
    "max_total_sessions": 50,
    "session_timeout": 0,
    "session_id_length": 32
  },
  "network": {
    "ipv4_network": "172.16.10.0/24",
    "dns": [
      "10.0.0.53",
      "1.1.1.1"
    ],
    "split_dns": [
      "internal.example.com"
    ],
    "routes": [
      "10.0.0.0/16"
    ],
    "nat_enabled": true,
    "nat_table": "nat",
    "mtu": 1400,
    "keep_alive": 300,
    "ipv4_only": false
  },
  "dpi": {
    "enabled": true
  },
  "tls": {
    "server_cert": "/etc/ocserv/server.crt",
    "server_key": "/etc/ocserv/server.key",
    "client_cert_required": true,
    "cert_user_oid": "2.5.4.3",
    "crl_file": "/etc/ocserv/crl.pem",
    "dh_size": 2048,
    "ciphers": [
      "ECDHE-ECDSA-AES256-GCM-SHA384",
      "ECDHE-RSA-AES256-GCM-SHA384"
    ],
    "hello_timeout": 30
  },
  "listen": {
    "port": 443,
    "dtls_port": 443,
    "protocol": "tcp+udp",
    "host": "0.0.0.0"
  },
  "logging": {
    "syslog_class": 2,
    "log_file": "/var/log/ocserv.log"
  }
}
