{
  "listen_address": ":9100",
  "worker_limit": 10,
  "metrics_path": "/metrics",
  "collectors": [
    {
      "name": "cpu",
      "enabled": true
    },
    {
      "name": "diskstats",
      "enabled": true
    },
    {
      "name": "filesystem",
      "enabled": true
    },
    {
      "name": "loadavg",
      "enabled": true
    },
    {
      "name": "meminfo",
      "enabled": true
    },
    {
      "name": "netdev",
      "enabled": true
    },
    {
      "name": "network_namespace",
      "enabled": false
    },
    {
      "name": "processes",
      "enabled": true
    },
    {
      "name": "stat",
      "enabled": true
    },
    {
      "name": "textfile",
      "enabled": true
    },
    {
      "name": "time",
      "enabled": true
    },
    {
      "name": "uname",
      "enabled": true
    },
    {
      "name": "vmstat",
      "enabled": true
    },
    {
      "name": "xfs",
      "enabled": false
    }
  ],
  "collector_options": [
    "--filesystem.ignored-mount-points=^/(sys|proc|dev|etc|var/lib/docker)($|/)",
    "--textfile.directory=/var/lib/node_exporter/textfile_collector"
  ],
  "log_level": "info",
  "log_format": "logfmt",
  "pid_file": "",
  "web_timeout": 2,
  "web_max_requests": 0,
  "web_enable_lifecycle": false,
  "web_enable_admin_api": false
}
