{
  "hopm_pidfile": {
    "type": "string",
    "default": "/run/hopm/hopm.pid",
    "description": "Full path and filename for storing the process ID of the running HOPM."
  },
  "hopm_command_queue_size": {
    "type": "number",
    "default": 64,
    "description": "Maximum commands to queue."
  },
  "hopm_command_interval": {
    "type": "string",
    "default": "10 seconds",
    "description": "Interval to check command queue for timed out commands."
  },
  "hopm_command_timeout": {
    "type": "string",
    "default": "180 seconds",
    "description": "Timeout of commands."
  },
  "hopm_negcache": {
    "type": "string",
    "default": "1 hour",
    "description": "Time to store IP addresses of confirmed secure hosts."
  },
  "hopm_negcache_rebuild": {
    "type": "string",
    "default": "12 hours",
    "description": "How long between rebuilds of the negative cache."
  },
  "hopm_dns_fdlimit": {
    "type": "number",
    "default": 64,
    "description": "Amount of file descriptors to allocate to asynchronous DNS."
  },
  "hopm_dns_timeout": {
    "type": "string",
    "default": "5 seconds",
    "description": "Amount of time the resolver waits until a response is received from a name server."
  },
  "hopm_scanlog": {
    "type": "string",
    "default": "/var/log/hopm/scan.log",
    "description": "Full path and filename of a logfile for every scan."
  },
  "hopm_irc_bind": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "IP address to bind to for the IRC connection."
  },
  "hopm_irc_nick": {
    "type": "string",
    "default": "MyHopm",
    "description": "Nickname for HOPM to use."
  },
  "hopm_irc_realname": {
    "type": "string",
    "default": "Hybrid Open Proxy Monitor",
    "description": "Text to appear in the 'realname' field of HOPM's /whois output."
  },
  "hopm_irc_username": {
    "type": "string",
    "default": "hopm",
    "description": "Username to use if no identd is running."
  },
  "hopm_irc_server": {
    "type": "string",
    "default": "irc.example.org",
    "description": "Hostname or IP address of the IRC server."
  },
  "hopm_irc_password": {
    "type": "string",
    "default": "secret",
    "description": "Password used to connect to the IRC server."
  },
  "hopm_irc_port": {
    "type": "number",
    "default": 6667,
    "description": "Port of the IRC server to connect to."
  },
  "hopm_irc_tls": {
    "type": "bool",
    "default": false,
    "description": "Whether to use TLS when connecting to the IRC server."
  },
  "hopm_irc_rsa_private_key_file": {
    "type": "string",
    "default": "etc/rsa.key",
    "description": "Path to the file containing the RSA key for TLS."
  },
  "hopm_irc_tls_certificate_file": {
    "type": "string",
    "default": "etc/cert.pem",
    "description": "Path to the file containing the TLS certificate."
  },
  "hopm_irc_tls_hostname_verification": {
    "type": "bool",
    "default": true,
    "description": "Checks if the host name matches the identity in the certificate."
  },
  "hopm_irc_readtimeout": {
    "type": "string",
    "default": "15 minutes",
    "description": "Time in which bot will timeout if no data is received."
  },
  "hopm_irc_reconnectinterval": {
    "type": "string",
    "default": "30 seconds",
    "description": "Interval in how often we try to reconnect to the IRC server."
  },
  "hopm_irc_nickserv": {
    "type": "string",
    "default": "NS IDENTIFY password",
    "description": "Command to execute to identify to NickServ."
  },
  "hopm_irc_oper": {
    "type": "string",
    "default": "hopm operpass",
    "description": "The username and password needed for HOPM to oper up."
  },
  "hopm_irc_mode": {
    "type": "string",
    "default": "+c",
    "description": "Mode string that HOPM needs to set on itself as soon as it opers up."
  },
  "hopm_irc_away": {
    "type": "string",
    "default": "I'm a bot. Your messages will be ignored.",
    "description": "Away message sent on connection."
  },
  "hopm_irc_channel_name": {
    "type": "string",
    "default": "#hopm",
    "description": "Channel name for HOPM to join."
  },
  "hopm_irc_channel_key": {
    "type": "string",
    "default": "somekey",
    "description": "Key to enter the channel if required."
  },
  "hopm_irc_channel_invite": {
    "type": "string",
    "default": "CS INVITE #hopm",
    "description": "Invite command for ChanServ."
  },
  "hopm_irc_connregex": {
    "type": "string",
    "default": "\\\\*\\\\*\\\\* Notice -- Client connecting: ([^ ]+) \\\\(([^@]+)@([^\\\\)]+)\\\\) \\\\[([0-9a-f\\\\.:]+)\\\\].*",
    "description": "Regex for connection notices (bahamut/charybdis/etc)."
  },
  "hopm_irc_connregex_far": {
    "type": "string",
    "default": "\\\\*\\\\*\\\\* Notice -- Client connecting.*: ([^ ]+) \\\\(([^@]+)@([^\\\\)]+)\\\\) \\\\[([0-9a-f\\\\.:]+)\\\\].*",
    "description": "Regex for connection notices with far connect notices."
  },
  "hopm_irc_connregex_unreal": {
    "type": "string",
    "default": "\\\\*\\\\*\\\\* Client connecting: ([^ ]+) \\\\(([^@]+)@([^\\\\)]+)\\\\) \\\\[([0-9a-f\\\\.:]+)\\\\].*",
    "description": "Regex for connection notices (UnrealIRCd 4.0.x)."
  },
  "hopm_irc_connregex_inspircd": {
    "type": "string",
    "default": "\\\\*\\\\*\\\\* .*CONNECT: Client connecting.*: ([^ ]+)!([^@]+)@([^\\\\)]+) \\\\(([0-9a-f\\\\.:]+)\\\\) \\\\[.*\\\\]",
    "description": "Regex for connection notices (InspIRCd)."
  },
  "hopm_irc_connregex_ngircd": {
    "type": "string",
    "default": "Client connecting: ([^ ]+) \\\\(([^@]+)@([^\\\\)]+)\\\\) \\\\[([0-9a-f\\\\.:]+)\\\\].*",
    "description": "Regex for connection notices (ngIRCd)."
  },
  "hopm_irc_kline_default": {
    "type": "string",
    "default": "KLINE 180 *@%i :Open proxy found on your host.",
    "description": "KLINE command for bahamut/charybdis/ircd-hybrid/ircd-ratbox."
  },
  "hopm_irc_kline_inspircd": {
    "type": "string",
    "default": "KLINE *@%i 3h :Open proxy found on your host.",
    "description": "KLINE command for InspIRCd."
  },
  "hopm_irc_kline_ngircd": {
    "type": "string",
    "default": "KLINE *@%i 10800 :Open proxy found on your host.",
    "description": "KLINE command for ngIRCd."
  },
  "hopm_irc_kline_ircu": {
    "type": "string",
    "default": "GLINE +*@%i 10800 :Open proxy found on your host.",
    "description": "GLINE command for ircu."
  },
  "hopm_irc_kline_unreal": {
    "type": "string",
    "default": "ZLINE *@%i 3h :Open proxy found on your host.",
    "description": "ZLINE command for UnrealIRCd."
  },
  "hopm_irc_kline_akill": {
    "type": "string",
    "default": "OS AKILL ADD +3h *@%i Open proxy found on your host.",
    "description": "AKILL command for OperServ."
  },
  "hopm_irc_perform": {
    "type": "string",
    "default": "PROTOCTL HCN",
    "description": "Text to send on connection."
  },
  "hopm_irc_notice": {
    "type": "string",
    "default": "You are now being scanned for open proxies. If you have nothing to hide, you have nothing to fear.",
    "description": "Text to send, via NOTICE, immediately when a new client connects."
  },
