## ==============================================================================
# policyd-weight daemon configuration fragment
# This file is sourced by the init script (/etc/init.d/policyd-weight).
# It sets the DAEMON_OPTS variable passed to the policyd-weight binary.
## ==============================================================================

# DAEMON_OPTS: Options passed to the policyd-weight daemon.
# Schema description: Daemon options for policyd-weight (e.g., -D for foreground, -d for debug, -f for config file path).
# Common options:
#   -D                  Do not detach; run master in foreground.
#   -d                  Debug mode; do not daemonize, log to STDOUT.
#   -f /path/to/file    Specify a configuration file path.
#   -h                  Display help and exit.
#   -k                  Kill the cache instance.
#   -s                  Show cache entries and exit. Use with -d to show debug info.
#   -v                  Show version and exit.
# Default: empty string (no extra options).
DAEMON_OPTS="{{ (daemon_opts | default('')) | string }}"