  "dns_ttl": 300,
  "disable_dns_update": false,
  "use_fqdn": true,
  "ca_cert_file": "/etc/ssl/certs/example-ca.crt",
  "ldaps_servers": [
    {
      "hostname": "dc1.example.com",
      "port": 636
    },
    {
      "hostname": "dc2.example.com"
    }
  ]
}
