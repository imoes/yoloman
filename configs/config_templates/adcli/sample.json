{
  "domain": "example.com",
  "domain_controller": "dc1.example.com",
  "domain_realm": "EXAMPLE.COM",
  "domain_short": "EXAMPLE",
  "computer_ou": "OU=Linux,OU=Servers,DC=example,DC=com",
  "adcli_user": "join-svc@example.com",
  "join_type": "server",
  "keytab_file": "/etc/adcli.keytab",
