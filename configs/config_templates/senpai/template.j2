# Senpai IRC Client Configuration
# Self-documenting template generated by Ansible role.
# See senpai(5) for full documentation of the ini-format.

# --- Network Section ---
[network]
# Display name for the IRC network connection.
name = "{{ (network | default({})).name | default('default') }}"

# List of server addresses to connect to.
# Each item is a string 'host:port'.
# Output format: <index>.addr = "<address>"
{% set servers = (network | default({})).servers | default([]) %}
{% for server in servers %}
{{ loop.index0 }}.addr = "{{ server }}"
{% endfor %}

# --- Client Section ---
[client]
# The nickname to identify as on IRC.
nick = "{{ (client | default({})).nick | default('guest') }}"

# The username to identify as (defaults to nick if empty).
user = "{{ (client | default({})).user | default((client | default({})).nick | default('guest')) }}"

# The realname field used in IRC protocols.
realname = "{{ (client | default({})).realname | default('Senpai User') }}"

# Position of the buffer list: 'left' or 'bottom'.
bufferlist_pos = "{{ (client | default({})).bufferlist_pos | default('left') }}"

# Whether to send typing indicators.
typing = {{ (client | default({})).typing | default(true) | lower }}

# List of channels to automatically join on connect.
# Output format: <index> = "<channel>"
{% set chanjoin = (client | default({})).chanjoin | default([]) %}
{% for channel in chanjoin %}
{{ loop.index0 }} = "{{ channel }}"
{% endfor %}

# --- Authentication Section (SASL) ---
{% set auth = (client | default({})).auth | default({}) %}
{% if (auth | default({})).enabled | default(false) | bool %}
[auth]
# Enable SASL authentication.
sasl = true
# SASL authentication mechanism (e.g., PLAIN).
sasl_mechanism = "{{ auth.mechanism | default('PLAIN') }}"
# SASL username.
username = "{{ auth.username | default('') }}"
# SASL password.
password = "{{ auth.password | default('') }}"
{% endif %}