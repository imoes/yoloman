{
  "network": {
    "type": "object",
    "description": "Network connection settings"
  },
  "network.name": {
    "type": "string",
    "default": "default",
    "description": "Display name for the IRC network"
  },
  "network.servers": {
    "type": "list",
    "default": [],
    "description": "List of server addresses to connect to"
  },
  "network.servers.items": {
    "type": "string",
    "default": "",
    "description": "A single server address (host:port)"
  },
  "client": {
    "type": "object",
    "description": "Client UI and behavior settings"
  },
  "client.nick": {
    "type": "string",
    "default": "guest",
    "description": "The nickname to identify as on IRC"
  },
  "client.user": {
    "type": "string",
    "default": "",
    "description": "The username to identify as (defaults to nick if empty)"
  },
  "client.realname": {
    "type": "string",
    "default": "Senpai User",
    "description": "The realname field used in IRC protocols"
  },
  "client.bufferlist_pos": {
    "type": "string",
    "default": "left",
    "description": "Position of the buffer list: 'left' or 'bottom'",
    "enum": [
      "left",
      "bottom"
    ]
  },
  "client.typing": {
    "type": "bool",
    "default": true,
    "description": "Whether to send typing indicators"
  },
  "client.chanjoin": {
    "type": "list",
    "default": [],
    "description": "List of channels to automatically join on connect"
  },
  "client.chanjoin.items": {
    "type": "string",
    "default": "",
    "description": "A channel name to auto-join"
  },
  "client.auth": {
    "type": "object",
    "description": "Authentication settings for the network"
  },
  "client.auth.enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable SASL authentication"
  },
  "client.auth.mechanism": {
    "type": "string",
    "default": "PLAIN",
    "description": "SASL authentication mechanism (e.g., PLAIN)"
  },
  "client.auth.username": {
    "type": "string",
    "default": "",
    "description": "SASL username"
  },
  "client.auth.password": {
    "type": "string",
    "default": "",
    "description": "SASL password"
  }
}
