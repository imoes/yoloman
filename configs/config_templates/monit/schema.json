{
  "monitor_daemon_interval": {
    "type": "number",
    "default": 60,
    "description": "Interval in seconds between Monit checks. Minimum 5 seconds."
  },
  "monitor_log_file": {
    "type": "string",
    "default": "/var/log/monit.log",
    "description": "Path to the Monit log file."
  },
  "mail_servers": {
    "type": "list",
    "default": [],
    "description": "SMTP servers to use for sending alert emails. At least one required for email alerts.",
    "items": {
      "host": {
        "type": "string",
        "default": "",
        "description": "SMTP server hostname or IP address"
      },
      "port": {
        "type": "number",
        "default": 25,
        "description": "SMTP server port (typically 25, 465, or 587)"
      },
      "tls": {
        "type": "bool",
        "default": false,
        "description": "Use TLS encryption for SMTP connection"
      },
      "username": {
        "type": "string",
        "default": "",
        "description": "SMTP authentication username (if required)"
      },
      "password": {
        "type": "string",
        "default": "",
        "description": "SMTP authentication password (if required)"
      },
      "timeout": {
        "type": "number",
        "default": 30,
        "description": "SMTP connection timeout in seconds"
      },
      "from_name": {
        "type": "string",
        "default": "",
        "description": "Name for the 'From:' field (optional)"
      }
    }
  },
  "email_recipients": {
    "type": "list",
    "default": [],
    "description": "Email addresses to receive alerts (comma-separated in Monit config)."
  },
  "httpd_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable the built-in HTTP server for web UI and status checks."
  },
  "httpd_port": {
    "type": "number",
    "default": 2812,
    "description": "Port for the HTTP daemon. Required if httpd_enabled is true."
  },
  "httpd_ssl": {
    "type": "bool",
    "default": false,
    "description": "Enable HTTPS for the HTTP daemon."
  },
  "httpd_ssl_cert": {
    "type": "string",
    "default": "/etc/monit/monit.pem",
    "description": "Path to SSL certificate file (if HTTPS enabled)."
  },
  "httpd_ssl_key": {
    "type": "string",
    "default": "/etc/monit/monit.pem",
    "description": "Path to SSL private key file (if HTTPS enabled)."
  },
  "httpd_allow_from": {
    "type": "list",
    "default": [
      "localhost",
      "127.0.0.1"
    ],
    "description": "List of allowed IP addresses or CIDR subnets for HTTP access."
  },
  "httpd_username": {
    "type": "string",
    "default": "",
    "description": "Username for HTTP authentication (if used)."
  },
  "httpd_password": {
    "type": "string",
    "default": "",
    "description": "Password for HTTP authentication (if used)."
  },
  "event_queue": {
    "type": "object",
    "default": null,
    "description": "Event queue configuration for buffering alerts during downtime.",
    "items": {
      "basepath": {
        "type": "string",
        "default": "/var/lib/monit",
        "description": "Base directory for event queue storage"
      },
      "slots": {
        "type": "number",
        "default": 100,
        "description": "Maximum number of events to buffer"
      }
    }
  },
  "services": {
    "type": "list",
    "default": [],
    "description": "List of services to monitor.",
    "items": {
      "name": {
        "type": "string",
        "default": "",
        "description": "Unique name for the service"
      },
      "withpidfile": {
        "type": "string",
        "default": "",
        "description": "Path to PID file if service writes one"
      },
      "start": {
        "type": "string",
        "default": "",
        "description": "Command to start the service (full path or script)"
      },
      "stop": {
        "type": "string",
        "default": "",
        "description": "Command to stop the service"
      },
      "restart": {
        "type": "string",
        "default": "",
        "description": "Command to restart the service (optional)"
      },
      "group": {
        "type": "string",
        "default": "",
        "description": "Service group name for batch operations"
      },
      "mode": {
        "type": "string",
        "default": "active",
        "description": "Monitoring mode: 'active' or 'passive'"
      },
      "uid": {
        "type": "string",
        "default": "",
        "description": "Expected user ID (numeric or name)"
      },
      "gid": {
        "type": "string",
        "default": "",
        "description": "Expected group ID (numeric or name)"
      },
      "startwait": {
        "type": "number",
        "default": 0,
        "description": "Seconds to wait after start command before checking status"
      },
      "stopwait": {
        "type": "number",
        "default": 10,
        "description": "Seconds to wait after stop command before checking status"
      },
      "ignores": {
        "type": "list",
        "default": [],
        "items": {
          "type": {
            "type": "string",
            "enum": [
              "checksum",
              "uid",
              "gid",
              "timestamp",
              "size"
            ],
            "description": "Type of check to ignore"
          },
          "value": {
            "type": "string",
            "default": "",
            "description": "Optional value (e.g., checksum hash)"
          }
        }
      },
      "if_failed": {
        "type": "object",
        "default": {},
        "description": "Conditions to trigger restart/recovery on failure",
        "items": {
          "port": {
            "type": "number",
            "default": 0,
            "description": "Port to check for availability"
          },
          "protocol": {
            "type": "string",
            "default": "http",
            "description": "Protocol to use (e.g., http, smtp, ftp)"
          },
          "address": {
            "type": "string",
            "default": "localhost",
            "description": "Address to connect to"
          },
          "timeout": {
            "type": "number",
            "default": 5,
            "description": "Connection timeout in seconds"
          },
          "content": {
            "type": "string",
            "default": "",
            "description": "Expected response content (exact)"
          },
          "content_match": {
            "type": "string",
            "default": "",
            "description": "Regular expression to match in response"
          },
          "perm": {
            "type": "string",
            "default": "",
            "description": "Expected permission (octal or symbolic)"
          },
          "uid": {
            "type": "string",
            "default": "",
            "description": "Expected UID when checking file"
          },
          "gid": {
            "type": "string",
            "default": "",
            "description": "Expected GID when checking file"
          },
          "timestamp": {
            "type": "string",
            "default": "",
            "description": "Expected timestamp format"
          },
          "checksum": {
            "type": "string",
            "default": "",
            "description": "Expected MD5/SHA checksum"
          },
          "cpu": {
            "type": "number",
            "default": 0,
            "description": "CPU usage threshold percentage"
          },
          "memory": {
            "type": "string",
            "default": "",
            "description": "Memory usage threshold (e.g., 20MB or 50%)"
          },
          "threads": {
            "type": "number",
            "default": 0,
            "description": "Maximum allowed thread count"
          },
          "children": {
            "type": "number",
            "default": 0,
            "description": "Maximum allowed child process count"
          },
          "timestamp_diff": {
            "type": "number",
            "default": 0,
            "description": "Maximum allowed timestamp difference (seconds)"
          }
        }
      },
      "if_totalmemory": {
        "type": "string",
        "default": "",
        "description": "Total memory usage threshold for service"
      },
      "if_cpu": {
        "type": "number",
        "default": 0,
        "description": "CPU usage threshold percentage for service"
      },
      "if_loadavg": {
        "type": "string",
        "default": "",
        "description": "Load average window (e.g., '1,5,15')"
      },
      "if_loadavg_threshold": {
        "type": "number",
        "default": 0,
        "description": "Maximum load average"
      },
      "if_timestamp": {
        "type": "number",
        "default": 0,
        "description": "Maximum age of service process (seconds)"
      },
      "if_permission": {
        "type": "string",
        "default": "",
        "description": "Expected file permission (octal)"
      },
      "if_uid": {
        "type": "string",
        "default": "",
        "description": "Expected file UID"
      },
      "if_gid": {
        "type": "string",
        "default": "",
        "description": "Expected file GID"
      },
      "if_link": {
        "type": "object",
        "default": {},
        "items": {
          "url": {
            "type": "string",
            "default": "",
            "description": "URL to check link health"
          },
          "content": {
            "type": "string",
            "default": "",
            "description": "Expected content from link check"
          }
        }
      }
    }
  }
}
