{
  "monitor_daemon_interval": 120,
  "monitor_log_file": "/var/log/monit.log",
  "mail_servers": [
    {
      "host": "smtp.example.com",
      "port": 587,
      "tls": true,
      "username": "alert@example.com",
      "password": "secret123",
      "timeout": 30,
      "from_name": "Monit"
    }
  ],
  "email_recipients": [
    "admin@example.com",
    "ops@example.com"
  ],
  "httpd_enabled": true,
  "httpd_port": 2812,
  "httpd_ssl": true,
  "httpd_ssl_cert": "/etc/monit/monit.pem",
  "httpd_ssl_key": "/etc/monit/monit.pem",
  "httpd_allow_from": [
    "localhost",
    "127.0.0.1",
    "10.0.0.0/8"
  ],
  "httpd_username": "admin",
  "httpd_password": "$1$xyz$abc123",
  "event_queue": {
    "basepath": "/var/lib/monit",
    "slots": 500
  },
  "services": [
    {
      "name": "nginx",
      "withpidfile": "/run/nginx.pid",
      "start": "/etc/init.d/nginx start",
      "stop": "/etc/init.d/nginx stop",
      "restart": "/etc/init.d/nginx restart",
      "group": "web",
      "mode": "active",
      "uid": "www-data",
      "gid": "www-data",
      "startwait": 2,
      "stopwait": 10,
      "if_failed": {
        "port": 80,
        "protocol": "http",
        "address": "127.0.0.1",
        "content": "Welcome to nginx"
      },
      "if_totalmemory": "100 MB",
      "if_cpu": 80,
      "if_loadavg": "1,5,15",
      "if_loadavg_threshold": 5
    },
    {
      "name": "postgresql",
      "withpidfile": "/run/postgresql/.s.PGSQL.5432.pid",
      "start": "/etc/init.d/postgresql start",
      "stop": "/etc/init.d/postgresql stop",
      "group": "database",
      "if_failed": {
        "port": 5432,
        "protocol": "tcp",
        "timeout": 5
      },
      "if_totalmemory": "1 GB",
      "if_loadavg": "1",
      "if_loadavg_threshold": 10
    }
  ]
}
