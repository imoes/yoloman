{
  "url": {
    "type": "string",
    "default": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
    "description": "Default URL prefilled in the application"
  },
  "path": {
    "type": "string",
    "default": "/home/user/Videos",
    "description": "Base directory for downloaded files"
  },
  "filename_format": {
    "type": "string",
    "default": "%(title)s.%(ext)s",
    "description": "Output filename template using yt-dlp style format"
  },
  "output_dir": {
    "type": "string",
    "default": "%(title)s",
    "description": "Subdirectory pattern for organizing downloads"
  },
  "overwrite": {
    "type": "bool",
    "default": false,
    "description": "Whether to overwrite existing files"
  },
  "continue_download": {
    "type": "bool",
    "default": true,
    "description": "Continue partially downloaded files"
  },
  "max_concurrent": {
    "type": "number",
    "default": 5,
    "description": "Maximum number of simultaneous downloads"
  },
  "bandwidth_limit": {
    "type": "number",
    "default": 0,
    "description": "Bandwidth limit in bytes per second (0 for unlimited)"
  },
  "proxy_url": {
    "type": "string",
    "default": "",
    "description": "Proxy URL for HTTP/HTTPS requests"
  },
  "user_agent": {
    "type": "string",
    "default": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36",
    "description": "User-Agent string"
  },
  "timeout": {
    "type": "number",
    "default": 30,
    "description": "Timeout for HTTP requests in seconds"
  },
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Log level for the application"
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/video-downloader.log",
    "description": "Path to the log file"
  }
}
