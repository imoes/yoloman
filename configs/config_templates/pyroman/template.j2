# Pyroman: iptables Built-in Chain Definitions
# This block defines the default policies for standard iptables chains (filter, nat, mangle tables).
# Each line calls `add_chain` to register the chain with the specified default policy.
# Variable names match schema fields exactly. Defaults are applied via Jinja2 `default` filter.

# Default policy for the INPUT chain (filter table).
# Controls packets destined for the local system.
add_chain("INPUT",                     default="{{ input_policy | default('DROP') }}")

# Default policy for the OUTPUT chain (filter table).
# Controls packets originating from the local system.
add_chain("OUTPUT",                    default="{{ output_policy | default('DROP') }}")

# Default policy for the FORWARD chain (filter table).
# Controls packets passing through the local system (routing).
add_chain("FORWARD",                   default="{{ forward_policy | default('DROP') }}")

# --- NAT Table Chains ---

# Default policy for the OUTPUT chain in the nat table.
# Controls NAT for locally generated packets.
add_chain("OUTPUT",      id="natOUT",  default="{{ nat_output_policy | default('ACCEPT') }}", table="nat")

# Default policy for the PREROUTING chain in the nat table.
# Controls NAT for incoming packets before routing decision.
add_chain("PREROUTING",  id="natPRE",  default="{{ nat_prerouting_policy | default('ACCEPT') }}", table="nat")

# Default policy for the POSTROUTING chain in the nat table.
# Controls NAT for outgoing packets after routing decision.
add_chain("POSTROUTING", id="natPOST", default="{{ nat_postrouting_policy | default('ACCEPT') }}", table="nat")

# --- Mangle Table Chains ---

# Default policy for the INPUT chain in the mangle table.
# Controls packet modification before routing decision for incoming traffic.
add_chain("INPUT",       id="manIN",   default="{{ mangle_input_policy | default('ACCEPT') }}", table="mangle")

# Default policy for the OUTPUT chain in the mangle table.
# Controls packet modification for locally generated traffic.
add_chain("OUTPUT",      id="manOUT",  default="{{ mangle_output_policy | default('ACCEPT') }}", table="mangle")

# Default policy for the FORWARD chain in the mangle table.
# Controls packet modification for routed traffic.
add_chain("FORWARD",     id="manFWD",  default="{{ mangle_forward_policy | default('ACCEPT') }}", table="mangle")

# Default policy for the PREROUTING chain in the mangle table.
# Controls packet modification before routing decision for incoming traffic.
add_chain("PREROUTING",  id="manPRE",  default="{{ mangle_prerouting_policy | default('ACCEPT') }}", table="mangle")

# Default policy for the POSTROUTING chain in the mangle table.
# Controls packet modification for outgoing traffic.
add_chain("POSTROUTING", id="manPOST", default="{{ mangle_postrouting_policy | default('ACCEPT') }}", table="mangle")
