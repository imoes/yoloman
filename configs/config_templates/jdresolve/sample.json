{
  "database_path": "/var/lib/jdresolve/hosts.db",
  "timeout": 60,
  "sockets": 128,
  "linecache": 5000,
  "debug_level": 1,
  "recursive": true,
  "anywhere": false,
  "mask": "%i.in.%c",
  "dbfirst": true,
  "dbonly": false,
  "dumpdb": false,
  "mergedb": false,
  "expiredb_hours": 24,
  "unresolved": false,
  "progress": true,
  "nostats": false,
  "log_file": "/var/log/apache2/access.log"
}
