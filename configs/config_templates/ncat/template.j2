#!/usr/bin/env ncat
# Ncat configuration template generated by Ansible/Jinja2
# This script configures `ncat` (the GNU netcat replacement) based on provided variables.
# It supports both server (listen) and client (connect) modes, SSL, proxies, and advanced networking features.

# Determine the base command and mode (listen vs connect)
# listen: True -> Server mode, listens on bind_address:port
# listen: False -> Client mode, connects to remote_host:remote_port
{% if listen | default(False) %}
# Listen for incoming connections on the specified interface and port
ncat -l {{ bind_address | default('0.0.0.0') }} {{ port | default(31337) }}
{% else %}
# Connect to a remote host and port in client mode
ncat {{ remote_host | default('example.org') }} {{ remote_port | default(80) }}
{% endif %}

# Network Protocol Options
# Use IPv4 only
{% if use_ipv4 | default(False) %}
# Force the use of IPv4 only
ncat -4
{% endif %}

# Use IPv6 only
{% if use_ipv6 | default(False) %}
# Force the use of IPv6 only
ncat -6
{% endif %}

# Use UDP instead of the default TCP
{% if use_udp | default(False) %}
# Use UDP instead of the default TCP
ncat -u
{% endif %}

# Use SCTP instead of TCP
{% if sctp | default(False) %}
# Use SCTP instead of TCP
ncat --sctp
{% endif %}

# SSL/TLS Encryption Options
# Enable SSL/TLS encryption for the connection
{% if use_ssl | default(False) %}
# Enable SSL encryption for the connection
ncat --ssl
{% endif %}

# Specify the SSL certificate file for server mode or client auth
{% if ssl_cert | default('') %}
# Specify the SSL certificate file for server mode or client auth
ncat --ssl-cert {{ ssl_cert | default('') }}
{% endif %}

# Specify the SSL private key file
{% if ssl_key | default('') %}
# Specify the SSL private key file
ncat --ssl-key {{ ssl_key | default('') }}
{% endif %}

# Verify server certificates in client mode
{% if ssl_verify | default(False) %}
# Verify server certificates in client mode
ncat --ssl-verify
{% endif %}

# Specify PEM file containing trusted SSL certificates
{% if ssl_trustfile | default('') %}
# Specify PEM file containing trusted SSL certificates
ncat --ssl-trustfile {{ ssl_trustfile | default('') }}
{% endif %}

# Specify SSL ciphersuites to use
{% if ssl_ciphers | default('') %}
# Specify SSL ciphersuites to use
ncat --ssl-ciphers {{ ssl_ciphers | default('') }}
{% endif %}

# Request distinct server name (SNI) in client mode
{% if ssl_servername | default('') %}
# Request distinct server name (SNI) in client mode
ncat --ssl-servername {{ ssl_servername | default('') }}
{% endif %}

# Specify ALPN protocol list to use
{% if ssl_alpn | default('') %}
# Specify ALPN protocol list to use
ncat --ssl-alpn {{ ssl_alpn | default('') }}
{% endif %}

# Connection Management Options
# Accept multiple connections in listen mode (keep server open after client disconnects)
{% if keep_open | default(False) %}
# Accept multiple connections in listen mode
ncat -k
{% endif %}

# Set the maximum number of simultaneous connections
{% if max_conns | default(100) > 0 %}
# Set the maximum number of simultaneous connections
ncat -m {{ max_conns | default(100) }}
{% endif %}

# Set the idle timeout for connections in seconds
{% if idle_timeout | default(0) > 0 %}
# Set the idle timeout for connections in seconds
ncat -i {{ idle_timeout | default(0) }}
{% endif %}

# Set the timeout for connection attempts in seconds
{% if connect_timeout | default(0) > 0 %}
# Set the timeout for connection attempts in seconds
ncat -w {{ connect_timeout | default(0) }}
{% endif %}

# Set delay interval for lines sent
{% if delay | default(0) > 0 %}
# Set delay interval for lines sent
ncat -d {{ delay | default(0) }}
{% endif %}

# Do not shutdown socket on EOF (backward compatibility)
{% if no_shutdown | default(False) %}
# Do not shutdown socket on EOF (backward compatibility)
ncat --no-shutdown
{% endif %}

# Zero-I/O mode, report connection status only (useful for port scanning)
{% if zero_io | default(False) %}
# Zero-I/O mode, report connection status only
ncat -z
{% endif %}

# Use AF_VSOCK sockets (VMware guest/host communication)
{% if vsock | default(False) %}
# Use AF_VSOCK sockets
ncat --vsock
{% endif %}

# Access Control Options
# Allow only the specified hosts to connect. Supports Nmap syntax.
{% if allow_list | default([]) %}
# Allow only the specified hosts to connect
ncat --allow {{ allow_list | default([]) | join(',') }}
{% endif %}

# Deny the specified hosts from connecting. Supports Nmap syntax.
{% if deny_list | default([]) %}
# Deny the specified hosts from connecting
ncat --deny {{ deny_list | default([]) | join(',') }}
{% endif %}

# Allow connections from file
{% if allow_file | default('') %}
# Allow connections from file
ncat --allowfile {{ allow_file | default('') }}
{% endif %}

# Deny connections from file
{% if deny_file | default('') %}
# Deny connections from file
ncat --denyfile {{ deny_file | default('') }}
{% endif %}

# Source Binding Options
# Specify the source port to use
{% if source_port | default(0) > 0 %}
# Specify the source port to use
ncat -p {{ source_port | default(0) }}
{% endif %}

# Specify the source address to bind to
{% if source_address | default('') %}
# Specify the source address to bind to
ncat -s {{ source_address | default('') }}
{% endif %}

# Set loose source routing hop points
{% if source_routing_hops | default([]) %}
# Set loose source routing hop points
ncat -g {{ source_routing_hops | default([]) | join(',') }}
{% endif %}

# Set source routing pointer for loose source routing
{% if source_routing_pointer | default(0) > 0 %}
# Set source routing pointer for loose source routing
ncat -G {{ source_routing_pointer | default(0) }}
{% endif %}

# Proxy Options
# Specify the proxy address
{% if proxy_host | default('') %}
# Specify the proxy address
ncat --proxy {{ proxy_host | default('') }}
{% endif %}

# Specify the proxy protocol type
{% if proxy_type | default('http') %}
# Specify the proxy protocol type
ncat --proxy-type {{ proxy_type | default('http') }}
{% endif %}

# Specify proxy authentication credentials
{% if proxy_auth | default('') %}
# Specify proxy authentication credentials
ncat --proxy-auth {{ proxy_auth | default('') }}
{% endif %}

# Specify where to resolve proxy destination
{% if proxy_dns | default('remote') %}
# Specify where to resolve proxy destination
ncat --proxy-dns {{ proxy_dns | default('remote') }}
{% endif %}

# I/O and Execution Options
# Execute a command after connection is established (-e)
{% if command | default('') %}
# Execute a command after connection is established
ncat -e {{ command | default('') }}
{% endif %}

# Execute command via /bin/sh (-c)
{% if sh_exec | default('') %}
# Execute command via /bin/sh
ncat -c {{ sh_exec | default('') }}
{% endif %}

# Execute a Lua script after connection
{% if lua_exec | default('') %}
# Execute a Lua script after connection
ncat --lua-exec {{ lua_exec | default('') }}
{% endif %}

# Only send data, ignoring received
{% if send_only | default(False) %}
# Only send data, ignoring received
ncat --send-only
{% endif %}

# Only receive data, never send anything
{% if recv_only | default(False) %}
# Only receive data, never send anything
ncat --recv-only
{% endif %}

# Dump session data to a file
{% if output_file | default('') %}
# Dump session data to a file
ncat -o {{ output_file | default('') }}
{% endif %}

# Dump session data as hex to a file
{% if hex_dump_file | default('') %}
# Dump session data as hex to a file
ncat -x {{ hex_dump_file | default('') }}
{% endif %}

# Append output files rather than clobbering them
{% if append_output | default(False) %}
# Append output files rather than clobbering them
ncat --append-output
{% endif %}

# Advanced Modes and Options
# Enable connection brokering mode (connects two clients together)
{% if broker | default(False) %}
# Enable connection brokering mode
ncat --broker
{% endif %}

# Enable simple chat server mode
{% if chat | default(False) %}
# Enable simple chat server mode
ncat --chat
{% endif %}

# Use CRLF for EOL sequence
{% if crlf | default(False) %}
# Use CRLF for EOL sequence
ncat -C
{% endif %}

# Answer Telnet negotiations
{% if telnet | default(False) %}
# Answer Telnet negotiations
ncat -t
{% endif %}

# Do not resolve hostnames via DNS (speeds up connection, prevents DNS leaks)
{% if nodns | default(False) %}
# Do not resolve hostnames via DNS
ncat -n
{% endif %}

# Enable verbose output
{% if verbose | default(False) %}
# Set verbosity level
ncat -v
{% endif %}

# Use Unix domain socket instead of network socket
{% if unix_socket | default('') %}
# Use Unix domain socket instead of network socket
ncat -U {{ unix_socket | default('') }}
{% endif %}