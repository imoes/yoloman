# Konqueror AdBlock Subscription Configuration
#
# This file configures the built-in AdBlock engine in Konqueror/KDE web browsing components.
# It defines a list of Adblock Plus (ABP) compatible filter subscriptions.
# Each section corresponds to a specific language or regional filter list.
#
# Variables are expected to be provided via Ansible variables matching the field names.
# If a variable is missing, the schema default is used.
#
# Syntax: INI-like format used by KDE's kwin/khtml/adblock subsystem.

# --- Global / EasyList without element hiding ---
# URL for EasyList without element hiding subscription
[EasyList without element hiding]
# Whether this subscription is active
Enabled=false
# URL pointing to the filter list content
URL={{ easylist_noelemhide_url | default('https://easylist-downloads.adblockplus.org/easylist_noelemhide.txt') }}
# Local filename where the list is stored
LocalFileName=easylist_noelemhide.txt
# Display order in the UI
Position=1

# --- APBIndo (Indonesian Adblock Rules) ---
# URL for APBIndo subscription
[APBIndo]
Enabled=false
URL={{ abpindo_url | default('https://raw.githubusercontent.com/ABPindo/indonesianadblockrules/master/subscriptions/abpindo.txt') }}
LocalFileName=abpindo.txt
Position=2

# URL for APBIndo noadult subscription
[APBIndo noadult]
Enabled=false
URL={{ abpindo_noadult_url | default('https://raw.githubusercontent.com/ABPindo/indonesianadblockrules/master/subscriptions/abpindo_noadult.txt') }}
LocalFileName=abpindo_noadult.txt
Position=3

