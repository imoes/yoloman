{
  "log_level": 2,
  "max_streams": 64,
  "mem_lock": false,
  "sample_rate": 48000,
  "audio_channels": 2,
  "default_sink": "0",
  "latency": "1024/48000",
  "enable_spare_nodes": true,
  "spare_sinks": 2,
  "spare_sources": 1,
  "volume_boost_db": 15.0,
  "modules": [
    {
      "name": "module-native-protocol-unix",
      "args": {
        "auth-cookie-enabled": "false"
      },
      "description": "Native protocol over Unix socket",
      "enabled": true
    },
    {
      "name": "module-zeroconf-discover",
      "args": {},
      "description": "Discover remote PulseAudio servers",
      "enabled": false
    },
    {
      "name": "module-always-sink",
      "args": {},
      "description": "Ensure at least one sink always exists",
      "enabled": true
    },
    {
      "name": "module-intended-roles",
      "args": {},
      "description": "Route streams based on device roles",
      "enabled": true
    }
  ],
  "optional_plugins": [
    {
      "name": "support-portal-audio",
      "enabled": true,
      "description": "Enable Portal audio device support"
    },
    {
      "name": "support-nvidia-audio",
      "enabled": false,
      "description": "NVIDIA HDMI audio quirks (if needed)"
    }
  ],
  "enable_system_mode": false
}
