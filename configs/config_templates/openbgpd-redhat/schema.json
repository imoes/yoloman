{
  "asn": {
    "type": "string",
    "default": "4200000001",
    "description": "The autonomous system number for this router, used as a macro and in global AS directive."
  },
  "router_id": {
    "type": "string",
    "default": "192.0.2.1",
    "description": "The router ID for BGP, typically a loopback address."
  },
  "prefix_set_mynetworks": {
    "type": "list",
    "default": [
      "192.0.2.0/24",
      "2001:db8:abcd::/48"
    ],
    "description": "List of prefix networks that may be originated by this ASN."
  },
  "ibgp_local_address_ipv4": {
    "type": "string",
    "default": "192.0.2.1",
    "description": "IPv4 local address for IBGP sessions."
  },
  "ibgp_local_address_ipv6": {
    "type": "string",
    "default": "2001:db8:abcd::1",
    "description": "IPv6 local address for IBGP sessions."
  },
  "ibgp_neighbor_ipv4_1": {
    "type": "string",
    "default": "192.0.2.2",
    "description": "IPv4 address of IBGP neighbor 2."
  },
  "ibgp_neighbor_ipv6_1": {
    "type": "string",
    "default": "2001:db8:abcd::2",
    "description": "IPv6 address of IBGP neighbor 2."
  },
  "ibgp_neighbor_ipv4_2": {
    "type": "string",
    "default": "192.0.2.3",
    "description": "IPv4 address of IBGP neighbor 3."
  },
  "ibgp_neighbor_ipv6_2": {
    "type": "string",
    "default": "2001:db8:abcd::3",
    "description": "IPv6 address of IBGP neighbor 3."
  },
  "upstream1_neighbor_ip": {
    "type": "string",
    "default": "203.0.113.1",
    "description": "IPv4 address of upstream provider 1."
  },
  "upstream1_asn": {
    "type": "number",
    "default": 65002,
    "description": "AS number of upstream provider 1."
  },
  "upstream2_neighbor_ip": {
    "type": "string",
    "default": "198.51.100.0",
    "description": "IPv4 address of upstream provider 2."
  },
  "upstream2_asn": {
    "type": "number",
    "default": 65123,
    "description": "AS number of upstream provider 2."
  },
  "upstream2_ipv6_neighbor_ip": {
    "type": "string",
    "default": "2001:db8:666::2",
    "description": "IPv6 address of upstream provider 2."
  },
  "asn_private_start": {
    "type": "number",
    "default": 4200000000,
    "description": "Start of the private AS range to filter out in deny rules."
  }
}
