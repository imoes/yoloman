#!/usr/bin/env bash
# ==============================================================================
# ripcalc CLI invocation wrapper
# ==============================================================================
# This script is generated by an Ansible Jinja2 template to invoke the `ripcalc`
# utility with a specific set of parameters for IP/network calculations.
#
# ripcalc is a command-line tool for calculating IP addresses, subnets, and
# network ranges. It does not have a persistent global configuration file (e.g.,
# /etc/ripcalc.conf). Instead, it is invoked with arguments. This wrapper
# script serves as the persistent "configuration" for your deployment, ensuring
# that `ripcalc` is always called with the correct defaults defined in your
# Ansible role.
#
# To use this script, ensure it is executable (chmod +x) and invoke it directly,
# or source it if you need to capture output into shell variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuration Variables
# ------------------------------------------------------------------------------

# The primary IPv4 or IPv6 address or network to perform calculations on.
# If empty, ripcalc may expect input via stdin or arguments.
INPUT_ADDRESS="{{ input_address | default('127.0.0.1') }}"

# Printf-style format string defining output fields (e.g., %a for IP, %c for CIDR, %n for network).
# Common formats: "%a/%c" (IP/CIDR), "%n" (Network), "%b" (Broadcast).
FORMAT_STRING="{{ format_string | default('%a/%c') }}"

# If true, restrict processing to IPv4 addresses only (equivalent to -4/--ipv4).
# If false, allows IPv6 or auto-detection.
FORCE_IPV4="{{ force_ipv4 | default(false) | lower }}"

# If true, restrict processing to IPv6 addresses only (equivalent to -6/--ipv6).
# If false, allows IPv4 or auto-detection.
FORCE_IPV6="{{ force_ipv6 | default(false) | lower }}"

# CIDR mask to apply to the input address (equivalent to -m/--mask).
# Example: '24' for 255.255.255.0.
# Empty string means no override; the input address's existing mask (if any) is used.
SUBNET_MASK="{{ subnet_mask | default('') }}"

# Base for numeric interpretation of input/output addresses (equivalent to -b/--base).
# Valid values: 8 (octal), 10 (decimal), 16 (hexadecimal).
NUMBER_BASE="{{ number_base | default(10) }}"

# If true, when used with a source list, prints only addresses not currently
# assigned to the network (equivalent to -a/--available).
# This requires SOURCE_FILE to be set or piped input.
SHOW_AVAILABLE="{{ show_available | default(false) | lower }}"

# Path to a CSV file for matching networks (equivalent to -c/--csv).
# Empty string means no CSV processing.
CSV_FILE="{{ csv_file | default('') }}"

# Column name in the CSV to use for matching networks (equivalent to -i/--field).
# Example: 'range', 'network', 'cidr'.
CSV_FIELD="{{ csv_field | default('range') }}"

# Path to a file containing a list of IP addresses to process (equivalent to -s/--file).
# If empty, ripcalc reads from stdin or processes INPUT_ADDRESS directly.
SOURCE_FILE="{{ source_file | default('') }}"

# If true, only print addresses from the source file that are inside the input network (equivalent to --inside).
# This is a filtering operation: only keep IPs that fall within INPUT_ADDRESS/CIDR.
MATCH_INSIDE="{{ match_inside | default(false) | lower }}"

# If true, only print addresses from the source file that are outside the input network (equivalent to --outside).
# This is a filtering operation: exclude IPs that fall within INPUT_ADDRESS/CIDR.
MATCH_OUTSIDE="{{ match_outside | default(false) | lower }}"

# If true, treat inputs/sources as back-to-front (equivalent to --reverse).
# Useful for specific network scanning or reverse lookups.
REVERSE_INPUTS="{{ reverse_inputs | default(false) | lower }}"

# CIDR mask to divide the input network into subnets (equivalent to --divide).
# Example: '24' divides a /16 network into /24 subnets.
# Empty string means no division/subnetting occurs.
DIVIDE_CIDR="{{ divide_cidr | default('') }}"

# If true, return the encapsulating/containing network (equivalent to --encapsulating).
# This finds the smallest network that contains all provided input addresses.
ENCAPSULATING="{{ encapsulating | default(false) | lower }}"

# ------------------------------------------------------------------------------
# Execution
# ------------------------------------------------------------------------------

# Construct the ripcalc command line based on the configuration above.
# We use a helper function to handle boolean flags cleanly.

ripcalc_args=()

# Add the primary address
if [ -n "${INPUT_ADDRESS}" ]; then
    ripcalc_args+=("${INPUT_ADDRESS}")
fi

# Add format string
ripcalc_args+=(-f "${FORMAT_STRING}")

# Add IPv4/IPv6 flags
if [ "${FORCE_IPV4}" = "true" ]; then
    ripcalc_args+=(--ipv4)
elif [ "${FORCE_IPV6}" = "true" ]; then
    ripcalc_args+=(--ipv6)
fi

# Add subnet mask override
if [ -n "${SUBNET_MASK}" ]; then
    ripcalc_args+=(-m "${SUBNET_MASK}")
fi

# Add number base
if [ "${NUMBER_BASE}" != "10" ]; then
    ripcalc_args+=(-b "${NUMBER_BASE}")
fi

# Add source file
if [ -n "${SOURCE_FILE}" ]; then
    ripcalc_args+=(-s "${SOURCE_FILE}")
fi

# Add CSV matching
if [ -n "${CSV_FILE}" ]; then
    ripcalc_args+=(-c "${CSV_FILE}")
    if [ -n "${CSV_FIELD}" ]; then
        ripcalc_args+=(-i "${CSV_FIELD}")
    fi
fi

# Add filtering options
if [ "${SHOW_AVAILABLE}" = "true" ]; then
    ripcalc_args+=(--available)
fi
if [ "${MATCH_INSIDE}" = "true" ]; then
    ripcalc_args+=(--inside)
fi
if [ "${MATCH_OUTSIDE}" = "true" ]; then
    ripcalc_args+=(--outside)
fi

# Add processing options
if [ "${REVERSE_INPUTS}" = "true" ]; then
    ripcalc_args+=(--reverse)
fi
if [ -n "${DIVIDE_CIDR}" ]; then
    ripcalc_args+=(--divide "${DIVIDE_CIDR}")
fi
if [ "${ENCAPSULATING}" = "true" ]; then
    ripcalc_args+=(--encapsulating)
fi

# Execute ripcalc
# If no arguments were added, ripcalc might still run, but typically it needs input.
# We pass all collected arguments to the binary.
exec ripcalc "${ripcalc_args[@]}"