{
  "user": "memcache",
  "bind_address": "0.0.0.0",
  "port": 11211,
  "max_memory_mb": 512,
  "max_item_size_mb": 2,
  "verbose": false,
  "num_threads": 4,
  "max_open_files": 10240,
  "foreground": false,
  "log_file": "/var/log/memcached/memcached.log",
  "udp_enabled": false,
  "udp_max_payload": 1024,
  "disable_sasl": true,
  "local_only": false,
  "pid_file": "/run/memcached/memcached.pid",
  "slab_page_size": 1048576,
  "slab_chunk_size": 48,
  "use_large_pages": false,
  "disable_mlock": true,
  "enable_all_evictions": false,
  "idle_timeout": 0,
  "check_nulls": false,
  "extra_options": [
    "-b 2048"
  ]
}
