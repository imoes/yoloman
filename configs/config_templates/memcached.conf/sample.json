{
  "log_file": "/var/log/memcached.log",
  "verbosity": 1,
  "max_memory_mb": 512,
  "port": 11211,
  "udp_port": 0,
  "user": "memcache",
  "bind_address": "127.0.0.1",
  "max_connections": 1024,
  "num_threads": 4,
  "max_item_size": "1m",
  "growth_factor": 1.25,
  "min_chunk_size": 48,
  "pid_file": "/var/run/memcached/memcached.pid",
  "no_evictions": false,
  "lock_memory": false,
  "disable_cas": false,
  "enable_sasl": false,
  "extra_options": [
    "-b 2048"
  ]
}
