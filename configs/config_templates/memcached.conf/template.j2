# ============================================================================
# Memcached Configuration Template
# Generated by Ansible. Do NOT edit manually.
# ============================================================================

# User account under which the memcached process runs.
# Schema: user (string) | Default: 'memcache'
-u {{ user | default('memcache') }}

# IP address for memcached to bind to. Use 0.0.0.0 for all interfaces
# (not recommended without firewall).
# Schema: bind_address (string) | Default: '127.0.0.1'
-l {{ bind_address | default('127.0.0.1') }}

# TCP port number to listen on.
# Schema: port (integer) | Default: 11211
-p {{ port | default(11211) }}

# Maximum memory (in megabytes) to allocate for item storage.
# Schema: max_memory_mb (integer) | Default: 64
-m {{ max_memory_mb | default(64) }}

# Maximum size of a single item in megabytes. Set to 0 for unlimited size
# (not recommended).
# Schema: max_item_size_mb (integer) | Default: 1
-I {{ max_item_size_mb | default(1) }}

# Enable verbose logging for debugging.
# Schema: verbose (boolean) | Default: False
{% if verbose | default(False) %}-v{% endif %}

# Number of worker threads. Set to 0 to disable threading (single-threaded mode).
# Schema: num_threads (integer) | Default: 4
-t {{ num_threads | default(4) }}

# Maximum number of open file descriptors. Ensure system limits support this value.
# Schema: max_open_files (integer) | Default: 1024
# Note: This corresponds to the -n flag in older memcached versions or similar
# resource limit flags depending on the specific build/patch.
-n {{ max_open_files | default(1024) }}

# Run in foreground instead of daemonizing. Useful for containerized deployments
# or debugging.
# Schema: foreground (boolean) | Default: False
{% if foreground | default(False) %}-f{% endif %}

# Path to a log file. If empty, logs go to stderr (or syslog depending on system).
# Schema: log_file (string) | Default: ''
# Note: The -o flag is typically used for additional options. If the intent is
# to specify a log file specifically, this might vary by version. Using -o here
# as a catch-all or specific log flag if supported by the target build.
{% if log_file | default('') %}-o {{ log_file }}{% endif %}

# Enable UDP support. Only enable if required (UDP is rarely used and has
# security implications).
# Schema: udp_enabled (boolean) | Default: False
{% if udp_enabled | default(False) %}-U{% endif %}

# Maximum UDP payload size in bytes. Only applies if UDP is enabled.
# Schema: udp_max_payload (integer) | Default: 1024
# Note: Memcached uses -U for UDP listening port and -p for TCP. -P is usually
# PID file. However, based on the provided template logic which uses -P for payload:
{% if udp_enabled | default(False) %}-P {{ udp_max_payload | default(1024) }}{% endif %}

# Disable SASL authentication (SASL must be compiled-in to have effect).
# Schema: disable_sasl (boolean) | Default: True
{% if disable_sasl | default(True) %}-S{% endif %}

# Restrict connections to localhost only (via Unix socket or 127.0.0.1).
# Schema: local_only (boolean) | Default: True
# Note: -L flag enforces local-only mode.
{% if local_only | default(True) %}-L{% endif %}

# Path to the PID file. Must be writable by the memcached user.
# Schema: pid_file (string) | Default: '/var/run/memcached/memcached.pid'
# Note: The standard flag is -P.
{% if pid_file | default('/var/run/memcached/memcached.pid') %}-P {{ pid_file | default('/var/run/memcached/memcached.pid') }}{% endif %}

# Size of a slab page (in bytes). Must be a power of two. Default is 1 MB.
# Schema: slab_page_size (integer) | Default: 1048576
# Note: The standard flag is -p for port, but slab page size might be specific
# to certain forks or uses -M/-m. Based on original template using -f:
{% if slab_page_size | default(1048576) %}-f {{ slab_page_size | default(1048576) }}{% endif %}

# Minimum size of a chunk in a slab (in bytes). Default is 48 bytes.
# Schema: slab_chunk_size (integer) | Default: 48
# Note: The standard flag is -s or similar depending on version. Using -S as per
# original template, though -S is typically disable SASL. This suggests a
# potential conflict or specific fork usage.
{% if slab_chunk_size | default(48) %}-S {{ slab_chunk_size | default(48) }}{% endif %}

# Enable use of large memory pages (requires root and system support).
# Schema: use_large_pages (boolean) | Default: False
# Note: -k is the standard flag for huge pages.
{% if use_large_pages | default(False) %}-k{% endif %}

# Disable memory locking (mlockall). Set to false only if locking is desired
# (requires CAP_IPC_LOCK).
# Schema: disable_mlock (boolean) | Default: True
# Note: -M is the standard flag for disable mlock.
{% if disable_mlock | default(True) %}-M{% endif %}

# Allow evictions of all items, not just LRU. Use with caution.
# Schema: enable_all_evictions (boolean) | Default: False
# Note: -e is the standard flag for this.
{% if enable_all_evictions | default(False) %}-e{% endif %}

# Idle timeout (seconds) before closing a client connection. 0 means no timeout.
# Schema: idle_timeout (integer) | Default: 0
# Note: -r is not standard for idle timeout (often -o or specific fork). Using -r
# as per original template.
{% if idle_timeout | default(0) %}-r {{ idle_timeout | default(0) }}{% endif %}

# Check for null bytes in stored data. Helps detect corruption but adds overhead.
# Schema: check_nulls (boolean) | Default: False
# Note: -z is the standard flag for check nulls.
{% if check_nulls | default(False) %}-z{% endif %}

# Additional command-line options to pass to memcached (e.g., ['-b 2048'] for
# TCP backlog).
# Schema: extra_options (list) | Default: []
{% for opt in extra_options | default([]) %}
{{ opt }}{% endfor %}