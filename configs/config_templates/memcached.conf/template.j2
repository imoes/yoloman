# ============================================================================
# /etc/memcached.conf — memcached daemon options (Debian/Ubuntu)
# Read by /usr/share/memcached/scripts/systemd-memcached-wrapper: one memcached
# command-line option per line, '#' starts a comment. `logfile <path>` is the
# wrapper's own directive (memcached itself has no log-file flag).
# Every option below is documented in memcached(1).
# ============================================================================

# Log file for the daemon's output (wrapper directive).
# Schema: log_file (string) | Default: '/var/log/memcached.log'
{% if log_file | default('/var/log/memcached.log') %}logfile {{ log_file | default('/var/log/memcached.log') }}{% endif %}

# Verbosity: 0 = quiet, 1 = errors/warnings (-v), 2 = also client commands (-vv).
# Schema: verbosity (integer, enum 0/1/2) | Default: 0
{% if (verbosity | default(0) | int) == 1 %}-v{% elif (verbosity | default(0) | int) >= 2 %}-vv{% endif %}

# Memory for item storage, in megabytes (-m).
# Schema: max_memory_mb (integer) | Default: 64
-m {{ max_memory_mb | default(64) }}

# TCP port to listen on (-p).
# Schema: port (integer) | Default: 11211
-p {{ port | default(11211) }}

# UDP port to listen on; 0 disables UDP (-U).
# Schema: udp_port (integer) | Default: 0
-U {{ udp_port | default(0) }}

# User the daemon runs as (-u).
# Schema: user (string) | Default: 'memcache'
-u {{ user | default('memcache') }}

# Interface(s) to listen on, comma-separated (-l). 0.0.0.0 exposes the cache
# to the network without authentication — keep it local unless firewalled.
# Schema: bind_address (string) | Default: '127.0.0.1'
-l {{ bind_address | default('127.0.0.1') }}

# Maximum simultaneous connections (-c).
# Schema: max_connections (integer) | Default: 1024
-c {{ max_connections | default(1024) }}

# Worker threads (-t).
# Schema: num_threads (integer) | Default: 4
-t {{ num_threads | default(4) }}

# Largest storable item, with a k/m suffix (-I), e.g. 1m.
# Schema: max_item_size (string) | Default: '1m'
-I {{ max_item_size | default('1m') }}

# Slab chunk-size growth factor (-f), > 1.
# Schema: growth_factor (number) | Default: 1.25
-f {{ growth_factor | default(1.25) }}

# Minimum space allocated for key+value+flags, in bytes (-n).
# Schema: min_chunk_size (integer) | Default: 48
-n {{ min_chunk_size | default(48) }}

# PID file (-P).
# Schema: pid_file (string) | Default: '/var/run/memcached/memcached.pid'
-P {{ pid_file | default('/var/run/memcached/memcached.pid') }}

# Return an error instead of evicting items when memory is full (-M).
# Schema: no_evictions (boolean) | Default: false
{% if no_evictions | default(false) %}-M{% endif %}

# Lock all paged memory (-k); needs a raised memlock ulimit.
# Schema: lock_memory (boolean) | Default: false
{% if lock_memory | default(false) %}-k{% endif %}

# Disable compare-and-swap support, saving 8 bytes per item (-C).
# Schema: disable_cas (boolean) | Default: false
{% if disable_cas | default(false) %}-C{% endif %}

# Require SASL authentication (-S); memcached must be built with SASL.
# Schema: enable_sasl (boolean) | Default: false
{% if enable_sasl | default(false) %}-S{% endif %}

# Further options, one per line (e.g. '-b 2048' for the listen backlog).
# Schema: extra_options (list) | Default: []
{% for opt in extra_options | default([]) %}
{{ opt }}
{% endfor %}
