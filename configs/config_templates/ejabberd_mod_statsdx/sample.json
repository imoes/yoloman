{
  "statsd": {
    "host": "statsd.internal.example.com",
    "port": 8125,
    "protocol": "statsd",
    "prefix": "ejabberd.prod",
    "flush_interval": 500,
    "enabled": true,
    "debug": false,
    "metric_types": [
      "counter",
      "timer",
      "gauge"
    ],
    "stats_filter": {
      "enabled": true,
      "include": [
        "users",
        "muc",
        "c2s",
        "s2s",
        "roster"
      ]
    }
  }
}
