# StatsD metrics reporting via ejabberd_mod_statsdx
# Enables the ejabberd_mod_statsdx module to send real-time XMPP statistics to StatsD
modules:
  # Load the statsd metrics module
  mod_statsdx:
    # Hostname or IP of StatsD server
    host: "{{ statsd.host }}"
    # Port StatsD listens on (default: 8125)
    port: {{ statsd.port }}
    # StatsD protocol: "statsd" (UDP, default) or "datadog" (UDP with tags support)
    protocol: "{{ statsd.protocol }}"
    # Prefix for all metrics (e.g., "ejabberd.production")
    prefix: "{{ statsd.prefix }}"
    # Flush interval in milliseconds (how often metrics are sent)
    flush_interval: {{ statsd.flush_interval }}
    # Enable or disable metrics collection
    enabled: {{ statsd.enabled | lower }}