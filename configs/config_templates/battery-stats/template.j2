# Battery Stats Collector Configuration
#
# This file is sourced from /etc/init.d/battery-stats. It provides command-line
# arguments to the battery-stats-collector binary. If values are not overridden
# here, the hard-wired defaults in /etc/init.d/battery-stats apply.
#
# Variables:
#   interval (int): Interval in seconds between battery data collection samples.
#   flush      (int): Number of samples to accumulate before flushing to storage.

# Interval in seconds between battery data collection samples
ARGS="--interval={{ interval | default(60) }} --flush={{ flush | default(10) }} --ignore-missing-battery"