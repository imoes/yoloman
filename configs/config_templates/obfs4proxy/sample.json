{
  "enable_logging": true,
  "log_level": "INFO",
  "unsafe_logging": false,
  "obfs4_dist_bias": false,
  "torrc_directives": [
    "ClientTransportPlugin obfs4 exec /usr/bin/obfs4proxy",
    "ServerTransportPlugin obfs4 exec /usr/bin/obfs4proxy",
    "ServerTransportListenAddr obfs4 0.0.0.0:9443"
  ]
}
