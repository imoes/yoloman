# /etc/depmod.d/ubuntu.conf — depmod configuration for kernel module dependency search paths and search order
# Search for kernel modules under /lib/modules/$(uname -r)/
# Override default search paths: /lib/modules, /usr/lib/modules
# Options: search, search_order, search_dir
# Format: option value (one option per line)

# Search order for module directories: prefer local over built-in
search_order dep mod builtin

# Define custom search directories (added after standard ones)
{% for dir in search_dirs %}
dir {{ dir }}
{% endfor %}

# Enable verbose output for debugging (disabled by default)
{% if verbose %}
verbose
{% endif %}
