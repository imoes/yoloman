{
  "netsurf": {
    "homepage_url": "https://example.com",
    "window": {
      "width": 800,
      "height": 600,
      "x": 100,
      "y": 100
    },
    "fonts": {
      "default": "serif",
      "sans": "Arial",
      "serif": "Times New Roman",
      "mono": "Courier New",
      "cursive": "Comic Sans MS",
      "fantasy": "Impact",
      "size": 14,
      "min_size": 10
    },
    "proxy": {
      "enabled": true,
      "host": "proxy.example.com",
      "port": 3128,
      "auth_scheme": "basic",
      "auth_user": "admin",
      "auth_pass": "secret123"
    },
    "cache": {
      "memory": 2048,
      "disk_age": 604800
    },
    "security": {
      "block_ads": true,
      "send_referer": false
    },
    "content": {
      "animate_images": false,
      "suppress_images": false,
      "remove_backgrounds": false,
      "disable_plugins": true,
      "disable_popups": true
    },
    "search": {
      "url": "https://duckduckgo.com/?q=%s",
      "provider": "DuckDuckGo"
    },
    "navigation": {
      "suggestions": false,
      "target_blank": true,
      "middle_click_tab": false
    },
    "colors": {
      "ActiveBorder": "#cccccc",
      "ActiveCaption": "#000080",
      "AppWorkspace": "#ffffff",
      "Background": "#ffffff",
      "ButtonFace": "#cccccc",
      "ButtonHighlight": "#ffffff",
      "ButtonShadow": "#808080",
      "ButtonText": "#000000",
      "CaptionText": "#ffffff",
      "GrayText": "#808080",
      "Highlight": "#000080",
      "HighlightText": "#ffffff",
      "InactiveBorder": "#a0a0a0",
      "InactiveCaption": "#a0a0a0",
      "InactiveCaptionText": "#808080",
      "InfoBackground": "#ffffe0",
      "InfoText": "#000000",
      "Menu": "#ffffff",
      "MenuText": "#000000",
      "Scrollbar": "#cccccc",
      "ThreeDDarkShadow": "#404040",
      "ThreeDFace": "#cccccc",
      "ThreeDHighlight": "#ffffff",
      "ThreeDLightShadow": "#808080",
      "ThreeDShadow": "#404040",
      "Window": "#ffffff",
      "WindowFrame": "#808080",
      "WindowText": "#000000"
    },
    "downloads": {
      "directory": "/tmp/downloads"
    },
    "history": {
      "age": 30
    },
    "hotlist": {
      "path": "/home/user/.netsurf/hotlist.html"
    },
    "theme": "classic"
  }
}
