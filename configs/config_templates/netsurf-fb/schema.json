{
  "netsurf": {
    "type": "object",
    "description": "Main configuration group for NetSurf FB browser settings."
  },
  "netsurf.homepage_url": {
    "type": "string",
    "default": "https://www.google.com",
    "description": "The URL to load on startup."
  },
  "netsurf.window": {
    "type": "object",
    "description": "Window geometry settings."
  },
  "netsurf.window.width": {
    "type": "number",
    "default": 1024,
    "description": "Initial window width in pixels."
  },
  "netsurf.window.height": {
    "type": "number",
    "default": 768,
    "description": "Initial window height in pixels."
  },
  "netsurf.window.x": {
    "type": "number",
    "default": 0,
    "description": "Initial window X coordinate."
  },
  "netsurf.window.y": {
    "type": "number",
    "default": 0,
    "description": "Initial window Y coordinate."
  },
  "netsurf.fonts": {
    "type": "object",
    "description": "Font family and size settings."
  },
  "netsurf.fonts.default": {
    "type": "string",
    "default": "sans-serif",
    "description": "Default font family."
  },
  "netsurf.fonts.sans": {
    "type": "string",
    "default": "DejaVu Sans",
    "description": "Sans-serif font family name."
  },
  "netsurf.fonts.serif": {
    "type": "string",
    "default": "DejaVu Serif",
    "description": "Serif font family name."
  },
  "netsurf.fonts.mono": {
    "type": "string",
    "default": "DejaVu Sans Mono",
    "description": "Monospace font family name."
  },
  "netsurf.fonts.cursive": {
    "type": "string",
    "default": "DejaVu Sans",
    "description": "Cursive font family name."
  },
  "netsurf.fonts.fantasy": {
    "type": "string",
    "default": "DejaVu Sans",
    "description": "Fantasy font family name."
  },
  "netsurf.fonts.size": {
    "type": "number",
    "default": 16,
    "description": "Default font size in pixels."
  },
  "netsurf.fonts.min_size": {
    "type": "number",
    "default": 8,
    "description": "Minimum font size in pixels."
  },
  "netsurf.proxy": {
    "type": "object",
    "description": "HTTP Proxy configuration."
  },
  "netsurf.proxy.enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether to use an HTTP proxy."
  },
  "netsurf.proxy.host": {
    "type": "string",
    "default": "",
    "description": "HTTP proxy host address."
  },
  "netsurf.proxy.port": {
    "type": "number",
    "default": 8080,
    "description": "HTTP proxy port."
  },
  "netsurf.proxy.auth_scheme": {
    "type": "string",
    "default": "",
    "description": "Authentication scheme for proxy (e.g., basic, digest)."
  },
  "netsurf.proxy.auth_user": {
    "type": "string",
    "default": "",
    "description": "Proxy authentication username."
  },
  "netsurf.proxy.auth_pass": {
    "type": "string",
    "default": "",
    "description": "Proxy authentication password."
  },
  "netsurf.cache": {
    "type": "object",
    "description": "Cache size settings."
  },
  "netsurf.cache.memory": {
    "type": "number",
    "default": 1024,
    "description": "Maximum memory cache size in KB."
  },
  "netsurf.cache.disk_age": {
    "type": "number",
    "default": 2592000,
    "description": "Maximum disk cache age in seconds (30 days)."
  },
  "netsurf.security": {
    "type": "object",
    "description": "Security and content blocking settings."
  },
  "netsurf.security.block_ads": {
    "type": "bool",
    "default": false,
    "description": "Boolean to enable ad blocking."
  },
  "netsurf.security.send_referer": {
    "type": "bool",
    "default": true,
    "description": "Boolean controlling whether referer data should be sent."
  },
  "netsurf.content": {
    "type": "object",
    "description": "Content rendering and feature settings."
  },
  "netsurf.content.animate_images": {
    "type": "bool",
    "default": true,
    "description": "Boolean controlling whether images should be animated."
  },
  "netsurf.content.suppress_images": {
    "type": "bool",
    "default": false,
    "description": "Suppress image loading."
  },
  "netsurf.content.remove_backgrounds": {
    "type": "bool",
    "default": false,
    "description": "Remove CSS backgrounds."
  },
  "netsurf.content.disable_plugins": {
    "type": "bool",
    "default": true,
    "description": "Disable browser plugins."
  },
  "netsurf.content.disable_popups": {
    "type": "bool",
    "default": true,
    "description": "Disable popup windows."
  },
  "netsurf.search": {
    "type": "object",
    "description": "Search engine configuration."
  },
  "netsurf.search.url": {
    "type": "string",
    "default": "https://www.google.com/search?q=%s",
    "description": "URL template for search engine."
  },
  "netsurf.search.provider": {
    "type": "string",
    "default": "Google",
    "description": "Name of the search provider."
  },
  "netsurf.navigation": {
    "type": "object",
    "description": "Navigation behavior settings."
  },
  "netsurf.navigation.suggestions": {
    "type": "bool",
    "default": true,
    "description": "Enable URL suggestions."
  },
  "netsurf.navigation.target_blank": {
    "type": "bool",
    "default": false,
    "description": "Target links in new tab by default."
  },
  "netsurf.navigation.middle_click_tab": {
    "type": "bool",
    "default": true,
    "description": "Open middle-clicked links in new tab."
  },
  "netsurf.colors": {
    "type": "object",
    "description": "CSS system color overrides. Keys are color names, values are hex strings."
  },
  "netsurf.colors.default": {
    "type": "string",
    "default": "#ffffff",
    "description": "Default background color."
  },
  "netsurf.downloads": {
    "type": "object",
    "description": "Download settings."
  },
  "netsurf.downloads.directory": {
    "type": "string",
    "default": "/home/user/Downloads",
    "description": "Directory for downloaded files."
  },
  "netsurf.history": {
    "type": "object",
    "description": "History settings."
  },
  "netsurf.history.age": {
    "type": "number",
    "default": 365,
    "description": "Maximum age of history entries in days."
  },
  "netsurf.hotlist": {
    "type": "object",
    "description": "Hotlist/Bookmark settings."
  },
  "netsurf.hotlist.path": {
    "type": "string",
    "default": "/home/user/.netsurf/hotlist",
    "description": "File path for the hotlist."
  },
  "netsurf.theme": {
    "type": "string",
    "default": "default",
    "description": "Current theme identifier."
  }
}
