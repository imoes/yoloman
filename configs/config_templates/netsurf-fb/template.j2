# =============================================================================
# NetSurf FB Configuration
# This template generates the command-line/configuration file for the NetSurf
# framebuffer browser. It is self-documenting: every directive is preceded by
# a comment explaining its source schema field and default value.
# =============================================================================

# -----------------------------------------------------------------------------
# Main Configuration Group: netsurf
# Description: Main configuration group for NetSurf FB browser settings.
# -----------------------------------------------------------------------------

# --homepage_url: The URL to load on startup.
# Schema: netsurf.homepage_url | Default: 'https://www.google.com'
--homepage_url {{ (netsurf | default({})).homepage_url | default('https://www.google.com') }}

# -----------------------------------------------------------------------------
# Window Geometry Settings: netsurf.window
# Description: Window geometry settings.
# -----------------------------------------------------------------------------
# --window_width: Initial window width in pixels.
# Schema: netsurf.window.width | Default: 1024
--window_width {{ ((netsurf | default({})).window | default({})).width | default(1024) }}

# --window_height: Initial window height in pixels.
# Schema: netsurf.window.height | Default: 768
--window_height {{ ((netsurf | default({})).window | default({})).height | default(768) }}

# --window_x: Initial window X coordinate.
# Schema: netsurf.window.x | Default: 0
--window_x {{ ((netsurf | default({})).window | default({})).x | default(0) }}

# --window_y: Initial window Y coordinate.
# Schema: netsurf.window.y | Default: 0
--window_y {{ ((netsurf | default({})).window | default({})).y | default(0) }}

# -----------------------------------------------------------------------------
# Font Family and Size Settings: netsurf.fonts
# Description: Font family and size settings.
# -----------------------------------------------------------------------------
# --font_default: Default font family.
# Schema: netsurf.fonts.default | Default: 'sans-serif'
--font_default {{ ((netsurf | default({})).fonts | default({})).default | default('sans-serif') }}

# --font_sans: Sans-serif font family name.
# Schema: netsurf.fonts.sans | Default: 'DejaVu Sans'
--font_sans {{ ((netsurf | default({})).fonts | default({})).sans | default('DejaVu Sans') }}

# --font_serif: Serif font family name.
# Schema: netsurf.fonts.serif | Default: 'DejaVu Serif'
--font_serif {{ ((netsurf | default({})).fonts | default({})).serif | default('DejaVu Serif') }}

# --font_mono: Monospace font family name.
# Schema: netsurf.fonts.mono | Default: 'DejaVu Sans Mono'
--font_mono {{ ((netsurf | default({})).fonts | default({})).mono | default('DejaVu Sans Mono') }}

# --font_cursive: Cursive font family name.
# Schema: netsurf.fonts.cursive | Default: 'DejaVu Sans'
--font_cursive {{ ((netsurf | default({})).fonts | default({})).cursive | default('DejaVu Sans') }}

# --font_fantasy: Fantasy font family name.
# Schema: netsurf.fonts.fantasy | Default: 'DejaVu Sans'
--font_fantasy {{ ((netsurf | default({})).fonts | default({})).fantasy | default('DejaVu Sans') }}

# --font_size: Default font size in pixels.
# Schema: netsurf.fonts.size | Default: 16
--font_size {{ ((netsurf | default({})).fonts | default({})).size | default(16) }}

# --font_min_size: Minimum font size in pixels.
# Schema: netsurf.fonts.min_size | Default: 8
--font_min_size {{ ((netsurf | default({})).fonts | default({})).min_size | default(8) }}

# -----------------------------------------------------------------------------
# HTTP Proxy Configuration: netsurf.proxy
# Description: HTTP Proxy configuration.
# -----------------------------------------------------------------------------
# --http_proxy: Whether to use an HTTP proxy.
# Schema: netsurf.proxy.enabled | Default: False
--http_proxy {{ ((netsurf | default({})).proxy | default({})).enabled | default(False) }}

# --http_proxy_host: HTTP proxy host address.
# Schema: netsurf.proxy.host | Default: ''
--http_proxy_host {{ ((netsurf | default({})).proxy | default({})).host | default('') }}

# --http_proxy_port: HTTP proxy port.
# Schema: netsurf.proxy.port | Default: 8080
--http_proxy_port {{ ((netsurf | default({})).proxy | default({})).port | default(8080) }}

# --http_proxy_auth: Authentication scheme for proxy (e.g., basic, digest).
# Schema: netsurf.proxy.auth_scheme | Default: ''
--http_proxy_auth {{ ((netsurf | default({})).proxy | default({})).auth_scheme | default('') }}

# --http_proxy_auth_user: Proxy authentication username.
# Schema: netsurf.proxy.auth_user | Default: ''
--http_proxy_auth_user {{ ((netsurf | default({})).proxy | default({})).auth_user | default('') }}

# --http_proxy_auth_pass: Proxy authentication password.
# Schema: netsurf.proxy.auth_pass | Default: ''
--http_proxy_auth_pass {{ ((netsurf | default({})).proxy | default({})).auth_pass | default('') }}

# -----------------------------------------------------------------------------
# Cache Size Settings: netsurf.cache
# Description: Cache size settings.
# -----------------------------------------------------------------------------
# --memory_cache_size: Maximum memory cache size in KB.
# Schema: netsurf.cache.memory | Default: 1024
--memory_cache_size {{ ((netsurf | default({})).cache | default({})).memory | default(1024) }}

# --disc_cache_age: Maximum disk cache age in seconds (30 days).
# Schema: netsurf.cache.disk_age | Default: 2592000
--disc_cache_age {{ ((netsurf | default({})).cache | default({})).disk_age | default(2592000) }}

# -----------------------------------------------------------------------------
# Security and Content Blocking Settings: netsurf.security
# Description: Security and content blocking settings.
# -----------------------------------------------------------------------------
# --block_advertisements: Boolean to enable ad blocking.
# Schema: netsurf.security.block_ads | Default: False
--block_advertisements {{ ((netsurf | default({})).security | default({})).block_ads | default(False) }}

# --send_referer: Boolean controlling whether referer data should be sent.
# Schema: netsurf.security.send_referer | Default: True
--send_referer {{ ((netsurf | default({})).security | default({})).send_referer | default(True) }}

# -----------------------------------------------------------------------------
# Content Rendering and Feature Settings: netsurf.content
# Description: Content rendering and feature settings.
# -----------------------------------------------------------------------------
# --animate_images: Boolean controlling whether images should be animated.
# Schema: netsurf.content.animate_images | Default: True
--animate_images {{ ((netsurf | default({})).content | default({})).animate_images | default(True) }}

# --suppress_images: Suppress image loading.
# Schema: netsurf.content.suppress_images | Default: False
--suppress_images {{ ((netsurf | default({})).content | default({})).suppress_images | default(False) }}

# --remove_backgrounds: Remove CSS backgrounds.
# Schema: netsurf.content.remove_backgrounds | Default: False
--remove_backgrounds {{ ((netsurf | default({})).content | default({})).remove_backgrounds | default(False) }}

# --disable_plugins: Disable browser plugins.
# Schema: netsurf.content.disable_plugins | Default: True
--disable_plugins {{ ((netsurf | default({})).content | default({})).disable_plugins | default(True) }}

# --disable_popups: Disable popup windows.
# Schema: netsurf.content.disable_popups | Default: True
--disable_popups {{ ((netsurf | default({})).content | default({})).disable_popups | default(True) }}

# -----------------------------------------------------------------------------
# Search Engine Configuration: netsurf.search
# Description: Search engine configuration.
# -----------------------------------------------------------------------------
# --search_url_bar: URL template for search engine.
# Schema: netsurf.search.url | Default: 'https://www.google.com/search?q=%s'
--search_url_bar {{ ((netsurf | default({})).search | default({})).url | default('https://www.google.com/search?q=%s') }}

# --search_provider: Name of the search provider.
# Schema: netsurf.search.provider | Default: 'Google'
--search_provider {{ ((netsurf | default({})).search | default({})).provider | default('Google') }}

# -----------------------------------------------------------------------------
# Navigation Behavior Settings: netsurf.navigation
# Description: Navigation behavior settings.
# -----------------------------------------------------------------------------
# --url_suggestion: Enable URL suggestions.
# Schema: netsurf.navigation.suggestions | Default: True
--url_suggestion {{ ((netsurf | default({})).navigation | default({})).suggestions | default(True) }}

# --target_blank: Target links in new tab by default.
# Schema: netsurf.navigation.target_blank | Default: False
--target_blank {{ ((netsurf | default({})).navigation | default({})).target_blank | default(False) }}

# --button_2_tab: Open middle-clicked links in new tab.
# Schema: netsurf.navigation.middle_click_tab | Default: True
--button_2_tab {{ ((netsurf | default({})).navigation | default({})).middle_click_tab | default(True) }}

# -----------------------------------------------------------------------------
# CSS System Color Overrides: netsurf.colors
# Description: CSS system color overrides. Keys are color names, values are hex strings.
# -----------------------------------------------------------------------------
# Iterating over key-value pairs in the colors mapping.
{% for color_item in (netsurf | default({})).colors | default({}) | dict2items %}
# Override CSS sys_colour_{{ color_item.key }}
# Schema: netsurf.colors (key={{ color_item.key }}), Value: {{ color_item.value }}
--sys_colour_{{ color_item.key }} {{ color_item.value }}
{% endfor %}

# -----------------------------------------------------------------------------
# Download Settings: netsurf.downloads
# Description: Download settings.
# -----------------------------------------------------------------------------
# --downloads_directory: Directory for downloaded files.
# Schema: netsurf.downloads.directory | Default: '/home/user/Downloads'
--downloads_directory {{ ((netsurf | default({})).downloads | default({})).directory | default('/home/user/Downloads') }}

# -----------------------------------------------------------------------------
# History Settings: netsurf.history
# Description: History settings.
# -----------------------------------------------------------------------------
# --history_age: Maximum age of history entries in days.
# Schema: netsurf.history.age | Default: 365
--history_age {{ ((netsurf | default({})).history | default({})).age | default(365) }}

# -----------------------------------------------------------------------------
# Hotlist/Bookmark Settings: netsurf.hotlist
# Description: Hotlist/Bookmark settings.
# -----------------------------------------------------------------------------
# --hotlist_path: File path for the hotlist.
# Schema: netsurf.hotlist.path | Default: '/home/user/.netsurf/hotlist'
--hotlist_path {{ ((netsurf | default({})).hotlist | default({})).path | default('/home/user/.netsurf/hotlist') }}

# -----------------------------------------------------------------------------
# Theme Settings: netsurf.theme
# Description: Current theme identifier.
# -----------------------------------------------------------------------------
# Schema: netsurf.theme | Default: 'default'
--current_theme {{ (netsurf | default({})).theme | default('default') }}