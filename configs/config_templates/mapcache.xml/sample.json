{
  "cache_type": "disk",
  "cache_dir": "/var/cache/mapcache",
  "http_timeout": 30,
  "http_user_agent": "MapCache/1.6",
  "image_format": "png",
  "image_quality": 80,
  "image_interlaced": false,
  "error_report": false,
  "wms_enabled": true,
  "wms_online_resource": "http://localhost/cgi-bin/mapcache?",
  "wms_title": "MapCache WMS Demo",
  "wms_abstract": "Demo WMS server with cached tile proxy.",
  "wms_fees": "none",
  "wms_access_constraints": "none",
