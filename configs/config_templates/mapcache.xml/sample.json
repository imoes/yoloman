    {
      "name": "Basemap",
      "layers": [
        {
          "name": "world"
        },
        {
          "name": "roads"
        }
      ]
    }
  ],
  "wmts_enabled": true,
  "wmts_online_resource": "http://localhost/cgi-bin/mapcache?",
  "wmts_title": "MapCache WMTS",
  "wmts_abstract": "OGC WMTS 1.0.0 compliant tile service.",
  "wmts_fees": "none",
  "wmts_access_constraints": "none",
  "tiles_enabled": true,
  "tiles_online_resource": "http://localhost/tiles/",
