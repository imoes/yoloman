# YAC (Yet Another Cache) configuration for PHP

; Enable YAC extension
extension={{ extension }}

; Shared memory size (in megabytes)
yac.maxfilesize = {{ yac.maxfilesize }}

; Maximum number of entries to store in the cache
yac.maxentries = {{ yac.maxentries }}

; Compress values using gzip
yac.compress = {{ yac.compress }}

; TTL for cached entries
yac.ttl = {{ yac.ttl }}

; Skip large files (files larger than this size in bytes will not be cached)
yac.skip_large_files = {{ yac.skip_large_files }}
