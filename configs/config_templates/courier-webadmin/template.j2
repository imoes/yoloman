#!/bin/sh
# kFreeBSD do not accept scripts as interpreters, using #!/bin/sh and sourcing.
# This script is an LSB-compliant init script for the Courier Web Admin daemon.
if [ true != "$INIT_D_SCRIPT_SOURCED" ] ; then
    set "$0" "$@"; INIT_D_SCRIPT_SOURCED=true . /lib/init/init-d-script
fi
### BEGIN INIT INFO
# Provides:          {{ service_name | default('courier-webadmin') }}
# Required-Start:    courier-authdaemon $remote_fs $syslog
# Required-Stop:     courier-authdaemon $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Courier Web Admin
### END INIT INFO

# Author: Ondřej Surý <ondrej@debian.org>
# Modified by Soren Stoutner <soren@debian.org>

# Path to the courierlogger daemon wrapper used to manage the PID and process.
# The logger writes the PID of the child process (webadmin) to the specified file.
DAEMON="courierlogger -pid={{ pidfile_path | default('/run/courier/webadmin.pid') }}"
DESC="Courier Web Admin"

# Enable start/stop logic for this service.
DO_START=yes

# Full path to the PID file tracking the webadmin daemon process.
# Ensures the init script can correctly identify and manage the running process.
PIDFILE="{{ pidfile_path | default('/run/courier/webadmin.pid') }}"

# Source the standard Courier init script helpers.
. /usr/lib/courier/init-d-script-courier

# Override function to handle the start command.
# Launches the webadmin daemon in the background via courierlogger.
do_start_cmd_override() {
    $DAEMON -start /usr/lib/courier/courier/webmail/webadmin daemon
}

# Override function to handle the stop command.
# Sends stop signal to the daemon managed by courierlogger.
do_stop_cmd_override() {
    $DAEMON -stop
}