{
  "account": {
    "type": "string",
    "default": "",
    "description": "Twitter.com account name (e.g., 'username')."
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Password for the Twitter account. Not recommended for untrusted environments."
  },
  "action": {
    "type": "string",
    "default": "update",
    "description": "Operation to perform. Valid values: update, friends, public, replies, user, direct, retweet, page, dry-run, bash, background, version, help, debug. Default is 'update'.",
    "enum": [
      "update",
      "friends",
      "public",
      "replies",
      "user",
      "direct"
    ]
  },
  "user": {
    "type": "string",
    "default": "",
    "description": "Target username for 'user' or 'direct' actions."
  },
  "host": {
    "type": "string",
    "default": "twitter",
    "description": "Target host. Valid values: twitter, custom.",
    "enum": [
      "twitter",
      "custom"
    ]
  },
  "proxy": {
    "type": "string",
    "default": "",
    "description": "HTTP proxy in host:port format (e.g., 'proxy.example.com:3128')."
  },
  "logfile": {
    "type": "string",
    "default": "",
    "description": "Logfile name, relative to user's home directory (e.g., '.bti.log')."
  },
  "replyto": {
    "type": "string",
    "default": "",
    "description": "Status ID to link replies to."
  },
  "shrink_urls": {
    "type": "string",
    "default": "",
    "description": "Enable URL shortening: 'yes' or 'true'.",
    "enum": [
      "yes",
      "true"
    ]
  },
  "verbose": {
    "type": "string",
    "default": "",
    "description": "Enable verbose mode: 'yes' or 'true'.",
    "enum": [
      "yes",
      "true"
    ]
  }
}
