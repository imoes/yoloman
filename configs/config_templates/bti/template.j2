{# ============================================================================ #}
{# bti(1) Configuration File                                                      #}
{#                                                                              #}
{# This template generates a self-documenting configuration file for the bti    #}
{# (BackTwitIt) Twitter client. Each directive is commented with its schema     #}
{# description and uses safe defaults for all variables.                        #}
{#                                                                              #}
{# Format: key = value                                                          #}
{# Lines starting with '#' are comments and are ignored by bti(1).            #}
{# ============================================================================ #}

{# account: Twitter.com account name (e.g., 'username').                        #}
{# Default is empty string, resulting in 'account' with no value.               #}
account = {{ account | default('') }}

{# password: Password for the Twitter account. Not recommended for              #}
{# untrusted environments. Defaults to empty string.                            #}
password = {{ password | default('') }}

{# action: Operation to perform. Valid values: update, friends, public,         #}
{# replies, user, direct, retweet, page, dry-run, bash, background,             #}
{# version, help.                                                               #}
{# Default is 'update'.                                                         #}
action = {{ action | default('update') }}

{# user: Target username for 'user' or 'direct' actions.                        #}
{# Default is empty string.                                                     #}
user = {{ user | default('') }}

{# host: Target host. Valid values: twitter, custom.                            #}
{# Default is 'twitter'.                                                        #}
host = {{ host | default('twitter') }}

{# proxy: HTTP proxy in host:port format (e.g., 'proxy.example.com:3128').      #}
{# Default is empty string.                                                     #}
proxy = {{ proxy | default('') }}

{# logfile: Logfile name, relative to user's home directory (e.g.,              #}
{# '.bti.log').                                                                 #}
{# Default is empty string.                                                     #}
logfile = {{ logfile | default('') }}

{# replyto: Status ID to link replies to.                                       #}
{# Default is empty string.                                                     #}
replyto = {{ replyto | default('') }}

{# shrink_urls: Enable URL shortening: 'yes' or 'true'.                         #}
{# Default is empty string.                                                     #}
shrink_urls = {{ shrink_urls | default('') }}

{# verbose: Enable verbose mode: 'yes' or 'true'.                               #}
{# Default is empty string.                                                     #}
verbose = {{ verbose | default('') }}