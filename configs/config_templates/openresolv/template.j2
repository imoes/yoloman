# Configuration for resolvconf(8)
# See resolvconf.conf(5) for details

# resolv_conf: Path to the resolv.conf file managed by resolvconf.
# Default: /etc/resolv.conf
resolv_conf={{ resolv_conf | default('/etc/resolv.conf') }}

# name_servers: Local name server IP address.
# Leave commented if not using a local DNS server.
{% if name_servers is defined and name_servers != '' and name_servers | length > 0 %}
# You run a local name server. Uncomment the below line and
# configure your subscribers configuration files below.
name_servers={{ name_servers }}
{% else %}
#name_servers=127.0.0.1
{% endif %}