# Configuration for resolvconf(8)
#
# This file is a Jinja2 template managed by Ansible.
# It generates the configuration for the `resolvconf` service,
# which manages the system's DNS resolver configuration (/etc/resolv.conf).
#
# Variables:
#   - resolv_conf: Path to the main resolv.conf file.
#   - name_servers: List or string of DNS server IPs to use locally.

# Path to the resolv.conf file managed by resolvconf.
# This directive tells resolvconf where to write the generated resolver configuration.
resolv_conf={{ resolv_conf | default('/etc/resolv.conf') }}

# If you run a local name server, you should uncomment the below line and
# configure your subscribers configuration files below.
#
# This directive specifies the IP address of a local DNS resolver (e.g., dnsmasq, systemd-resolved)
# that the system should query for name resolution.
# If left commented, the system may rely on upstream DNS servers or other configuration.
#name_servers={{ name_servers | default('127.0.0.1') }}