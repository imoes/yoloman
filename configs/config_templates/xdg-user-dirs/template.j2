# =============================================================================
# xdg-user-dirs configuration template
# =============================================================================
# This file configures the behavior of xdg-user-dirs-update, which is
# automatically invoked on user login to create standard user directories
# (Desktop, Documents, Downloads, etc.) according to the XDG Base Directory
# specification.
#
# Per-user overrides can be placed in ~/.config/user-dirs.conf or controlled
# via environment variables XDG_CONFIG_HOME and/or XDG_CONFIG_DIRS.
# =============================================================================

# ------------------------------------------------------------------------------
# enabled (default: True)
# ------------------------------------------------------------------------------
# Whether xdg-user-dirs-update is enabled on user login.
# If set to 'false', the update script will be skipped, leaving directory
# names unchanged or in their default state.
# ------------------------------------------------------------------------------
enabled={{ enabled | default(True) }}

# ------------------------------------------------------------------------------
# filename_encoding (default: 'UTF-8')
# ------------------------------------------------------------------------------
# The filename encoding to use for creating user directories.
# Can be an explicit encoding (e.g., 'UTF-8', 'ISO-8859-1') or the literal
# string 'locale', which instructs the system to use the current user's
# locale encoding.
# ------------------------------------------------------------------------------
filename_encoding={{ filename_encoding | default('UTF-8') }}