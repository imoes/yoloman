# =============================================================================
# LegionD Configuration Template
# This template configures the fan curve and thermal thresholds for legiond.
# It defines 10 entries (0-9), each specifying fan speeds and temperature
# thresholds for CPU, GPU, and IC (Internal Controller) components, along
# with acceleration/deceleration rates.
# =============================================================================

# Profile name for this configuration
name: {{ name | default('balanced-ac') }}

# List of fan curve entries. Each entry defines the behavior for a specific
# thermal range or state.
entries:
  # -------------------------------------------------------------------------
  # Entry 0: Default/Idle state
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_0 | default(0) }}
    fan2_speed: {{ fan2_speed_0 | default(0) }}
    cpu_lower_temp: {{ cpu_lower_temp_0 | default(0) }}
    cpu_upper_temp: {{ cpu_upper_temp_0 | default(50) }}
    gpu_lower_temp: {{ gpu_lower_temp_0 | default(0) }}
    gpu_upper_temp: {{ gpu_upper_temp_0 | default(50) }}
    ic_lower_temp: {{ ic_lower_temp_0 | default(0) }}
    ic_upper_temp: {{ ic_upper_temp_0 | default(30) }}
    acceleration: {{ acceleration_0 | default(3) }}
    deceleration: {{ deceleration_0 | default(3) }}

  # -------------------------------------------------------------------------
  # Entry 1: Low load
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_1 | default(1200) }}
    fan2_speed: {{ fan2_speed_1 | default(1200) }}
    cpu_lower_temp: {{ cpu_lower_temp_1 | default(50) }}
    cpu_upper_temp: {{ cpu_upper_temp_1 | default(55) }}
    gpu_lower_temp: {{ gpu_lower_temp_1 | default(50) }}
    gpu_upper_temp: {{ gpu_upper_temp_1 | default(55) }}
    ic_lower_temp: {{ ic_lower_temp_1 | default(30) }}
    ic_upper_temp: {{ ic_upper_temp_1 | default(40) }}
    acceleration: {{ acceleration_1 | default(3) }}
    deceleration: {{ deceleration_1 | default(3) }}

  # -------------------------------------------------------------------------
  # Entry 2: Moderate load
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_2 | default(1500) }}
    fan2_speed: {{ fan2_speed_2 | default(1500) }}
    cpu_lower_temp: {{ cpu_lower_temp_2 | default(55) }}
    cpu_upper_temp: {{ cpu_upper_temp_2 | default(60) }}
    gpu_lower_temp: {{ gpu_lower_temp_2 | default(55) }}
    gpu_upper_temp: {{ gpu_upper_temp_2 | default(60) }}
    ic_lower_temp: {{ ic_lower_temp_2 | default(40) }}
    ic_upper_temp: {{ ic_upper_temp_2 | default(50) }}
    acceleration: {{ acceleration_2 | default(3) }}
    deceleration: {{ deceleration_2 | default(3) }}

  # -------------------------------------------------------------------------
  # Entry 3: High load
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_3 | default(2000) }}
    fan2_speed: {{ fan2_speed_3 | default(2000) }}
    cpu_lower_temp: {{ cpu_lower_temp_3 | default(60) }}
    cpu_upper_temp: {{ cpu_upper_temp_3 | default(65) }}
    gpu_lower_temp: {{ gpu_lower_temp_3 | default(60) }}
    gpu_upper_temp: {{ gpu_upper_temp_3 | default(65) }}
    ic_lower_temp: {{ ic_lower_temp_3 | default(50) }}
    ic_upper_temp: {{ ic_upper_temp_3 | default(55) }}
    acceleration: {{ acceleration_3 | default(3) }}
    deceleration: {{ deceleration_3 | default(3) }}

  # -------------------------------------------------------------------------
  # Entry 4: Heavy load
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_4 | default(2400) }}
    fan2_speed: {{ fan2_speed_4 | default(2400) }}
    cpu_lower_temp: {{ cpu_lower_temp_4 | default(65) }}
    cpu_upper_temp: {{ cpu_upper_temp_4 | default(70) }}
    gpu_lower_temp: {{ gpu_lower_temp_4 | default(65) }}
    gpu_upper_temp: {{ gpu_upper_temp_4 | default(70) }}
    ic_lower_temp: {{ ic_lower_temp_4 | default(55) }}
    ic_upper_temp: {{ ic_upper_temp_4 | default(127) }}
    acceleration: {{ acceleration_4 | default(3) }}
    deceleration: {{ deceleration_4 | default(3) }}

  # -------------------------------------------------------------------------
  # Entry 5: Very heavy load
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_5 | default(2600) }}
    fan2_speed: {{ fan2_speed_5 | default(2600) }}
    cpu_lower_temp: {{ cpu_lower_temp_5 | default(70) }}
    cpu_upper_temp: {{ cpu_upper_temp_5 | default(78) }}
    gpu_lower_temp: {{ gpu_lower_temp_5 | default(70) }}
    gpu_upper_temp: {{ gpu_upper_temp_5 | default(78) }}
    ic_lower_temp: {{ ic_lower_temp_5 | default(127) }}
    ic_upper_temp: {{ ic_upper_temp_5 | default(127) }}
    acceleration: {{ acceleration_5 | default(3) }}
    deceleration: {{ deceleration_5 | default(3) }}

  # -------------------------------------------------------------------------
  # Entry 6: Thermal throttling range
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_6 | default(3000) }}
    fan2_speed: {{ fan2_speed_6 | default(3000) }}
    cpu_lower_temp: {{ cpu_lower_temp_6 | default(78) }}
    cpu_upper_temp: {{ cpu_upper_temp_6 | default(83) }}
    gpu_lower_temp: {{ gpu_lower_temp_6 | default(78) }}
    gpu_upper_temp: {{ gpu_upper_temp_6 | default(83) }}
    ic_lower_temp: {{ ic_lower_temp_6 | default(127) }}
    ic_upper_temp: {{ ic_upper_temp_6 | default(127) }}
    acceleration: {{ acceleration_6 | default(2) }}
    deceleration: {{ deceleration_6 | default(2) }}

  # -------------------------------------------------------------------------
  # Entry 7: Critical thermal range
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_7 | default(3500) }}
    fan2_speed: {{ fan2_speed_7 | default(3500) }}
    cpu_lower_temp: {{ cpu_lower_temp_7 | default(83) }}
    cpu_upper_temp: {{ cpu_upper_temp_7 | default(88) }}
    gpu_lower_temp: {{ gpu_lower_temp_7 | default(83) }}
    gpu_upper_temp: {{ gpu_upper_temp_7 | default(88) }}
    ic_lower_temp: {{ ic_lower_temp_7 | default(127) }}
    ic_upper_temp: {{ ic_upper_temp_7 | default(127) }}
    acceleration: {{ acceleration_7 | default(2) }}
    deceleration: {{ deceleration_7 | default(2) }}

  # -------------------------------------------------------------------------
  # Entry 8: Max performance / Emergency cooling
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_8 | default(4000) }}
    fan2_speed: {{ fan2_speed_8 | default(4000) }}
    cpu_lower_temp: {{ cpu_lower_temp_8 | default(88) }}
    cpu_upper_temp: {{ cpu_upper_temp_8 | default(127) }}
    gpu_lower_temp: {{ gpu_lower_temp_8 | default(88) }}
    gpu_upper_temp: {{ gpu_upper_temp_8 | default(127) }}
    ic_lower_temp: {{ ic_lower_temp_8 | default(127) }}
    ic_upper_temp: {{ ic_upper_temp_8 | default(127) }}
    acceleration: {{ acceleration_8 | default(1) }}
    deceleration: {{ deceleration_8 | default(1) }}

  # -------------------------------------------------------------------------
  # Entry 9: Disabled/Reserved entry
  # -------------------------------------------------------------------------
  - fan1_speed: {{ fan1_speed_9 | default(0) }}
    fan2_speed: {{ fan2_speed_9 | default(0) }}
    cpu_lower_temp: {{ cpu_lower_temp_9 | default(0) }}
    cpu_upper_temp: {{ cpu_upper_temp_9 | default(0) }}
    gpu_lower_temp: {{ gpu_lower_temp_9 | default(0) }}
    gpu_upper_temp: {{ gpu_upper_temp_9 | default(0) }}
    ic_lower_temp: {{ ic_lower_temp_9 | default(0) }}
    ic_upper_temp: {{ ic_upper_temp_9 | default(0) }}
    acceleration: {{ acceleration_9 | default(0) }}
    deceleration: {{ deceleration_9 | default(0) }}

# Enable or disable the minifancurve feature
enable_minifancurve: {{ enable_minifancurve | default('false') }}
