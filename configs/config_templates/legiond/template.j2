# Profile name for the Legion fan curve configuration
name: {{ name | default('balanced-ac') }}

# Fan curve entries. Each entry defines a temperature band with corresponding fan speeds
# and thermal thresholds for CPU, GPU, and Integrated Circuit (IC).
entries:

# --- Entry 0: Cold/Idle State ---
- # Fan 1 speed for entry 0
  fan1_speed: {{ fan1_speed_0 | default(0) }}
  # Fan 2 speed for entry 0
  fan2_speed: {{ fan2_speed_0 | default(0) }}
  # CPU lower temp threshold for entry 0
  cpu_lower_temp: {{ cpu_lower_temp_0 | default(0) }}
  # CPU upper temp threshold for entry 0
  cpu_upper_temp: {{ cpu_upper_temp_0 | default(50) }}
  # GPU lower temp threshold for entry 0
  gpu_lower_temp: {{ gpu_lower_temp_0 | default(0) }}
  # GPU upper temp threshold for entry 0
  gpu_upper_temp: {{ gpu_upper_temp_0 | default(50) }}
  # IC lower temp threshold for entry 0
  ic_lower_temp: {{ ic_lower_temp_0 | default(0) }}
  # IC upper temp threshold for entry 0
  ic_upper_temp: {{ ic_upper_temp_0 | default(30) }}
  # Acceleration for entry 0
  acceleration: {{ acceleration_0 | default(3) }}
  # Deceleration for entry 0
  deceleration: {{ deceleration_0 | default(3) }}

# --- Entry 1: Normal Operation ---
- # Fan 1 speed for entry 1
  fan1_speed: {{ fan1_speed_1 | default(1200) }}
  # Fan 2 speed for entry 1
  fan2_speed: {{ fan2_speed_1 | default(1200) }}
  # CPU lower temp threshold for entry 1
  cpu_lower_temp: {{ cpu_lower_temp_1 | default(50) }}
  # CPU upper temp threshold for entry 1
  cpu_upper_temp: {{ cpu_upper_temp_1 | default(55) }}
  # GPU lower temp threshold for entry 1
  gpu_lower_temp: {{ gpu_lower_temp_1 | default(50) }}
  # GPU upper temp threshold for entry 1
  gpu_upper_temp: {{ gpu_upper_temp_1 | default(55) }}
  # IC lower temp threshold for entry 1
  ic_lower_temp: {{ ic_lower_temp_1 | default(30) }}
  # IC upper temp threshold for entry 1
  ic_upper_temp: {{ ic_upper_temp_1 | default(40) }}
  # Acceleration for entry 1
  acceleration: {{ acceleration_1 | default(3) }}
  # Deceleration for entry 1
  deceleration: {{ deceleration_1 | default(3) }}

# --- Entry 2: Moderate Load ---
- # Fan 1 speed for entry 2
  fan1_speed: {{ fan1_speed_2 | default(1500) }}
  # Fan 2 speed for entry 2
