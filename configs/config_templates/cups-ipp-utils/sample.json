{
  "listen_address": "192.168.1.10",
  "listen_port": 631,
  "network_access": true,
  "admin_access": false,
  "browsing_enabled": true,
  "max_job_time": 86400,
  "max_jobs": 200,
  "log_level": "info",
  "log_file": "/var/log/cups/ipp_error_log",
  "access_log_file": "/var/log/cups/ipp_access_log",
  "ssl_enabled": true,
  "dns_sd_enabled": true,
  "dns_sd_service_name": "Office-IPP-Server",
  "max_request_size_kb": 2048,
  "access_rules": [
    {
      "action": "allow",
      "source": "127.0.0.0/8",
      "description": "Localhost always allowed"
    },
    {
      "action": "allow",
      "source": "192.168.1.0/24",
      "description": "Office LAN only"
    },
    {
      "action": "deny",
      "source": "*",
      "description": "Block all other networks"
    }
  ],
  "default_printer_options": [
    {
      "name": "MediaType",
      "value": "Auto",
      "description": "Auto-select media based on job"
    },
    {
      "name": "sides",
      "value": "two-sided-long-edge",
      "description": "Default to duplex printing"
    },
    {
      "name": "copies",
      "value": "1",
      "description": "Default single copy"
    }
  ]
}
