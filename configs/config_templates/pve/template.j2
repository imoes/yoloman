# Fence agent for Proxmox VE (PVE) cluster nodes
# Login credentials for PVE API
auth_url: {{ (pve | default({})).auth_url }}
username: {{ (pve | default({})).username }}
password: {{ (pve | default({})).password }}
# Optional: API token (if using token auth instead of password)
{% if (pve | default({})).api_token %}api_token: {{ (pve | default({})).api_token }}
{% endif %}# PVE cluster name
cluster: {{ (pve | default({})).cluster }}
# Fence action timeout in seconds
timeout: {{ (pve | default({})).timeout }}
# Verify SSL certificate (set to 0 to disable)
ssl_verify: {{ (pve | default({})).ssl_verify | lower }}
# Optional: custom SSL CA file path
{% if (pve | default({})).ssl_ca_path %}ssl_ca_path: {{ (pve | default({})).ssl_ca_path }}
{% endif %}# Optional: override hostname resolution
{% if (pve | default({})).ipaddr %}ipaddr: {{ (pve | default({})).ipaddr }}
{% endif %}# Optional: login domain (for Kerberos or AD integration)
{% if (pve | default({})).domain %}domain: {{ (pve | default({})).domain }}
{% endif %}