# =============================================================================
# heat-api-cfn uWSGI Configuration Template
# =============================================================================
# This template configures the uWSGI application server for the OpenStack Heat
# CloudFormation-compatible API service. It manages process spawning, networking,
# and logging for the WSGI application.
# =============================================================================

[uwsgi]

# ------------------------------------------------------------------------------
# Generic UWSGI Settings
# ------------------------------------------------------------------------------

# Override the default size for headers from the 4k default.
# Allows larger HTTP headers which may be needed for complex OpenStack requests.
buffer-size = 65535

# This avoids error 104: "Connection reset by peer"
# Removes Content-Length header from upstream requests if present, preventing
# issues with keep-alive connections and chunked encoding mismatches.
rem-header = Content-Length

# This is running standalone
# Enables the master process mode, allowing graceful reloads and worker management.
master = true

# uwsgi recommends this to prevent thundering herd on accept.
# Ensures only one worker wakes up to accept a new connection, reducing
# CPU contention under high load.
thunder-lock = true

# Load the Python 3 plugin for WSGI support.
plugins = python3

# This ensures that file descriptors aren't shared between the WSGI application processes.
# Workers fork after loading the application, ensuring clean state per worker.
lazy-apps = true

# Log from the wsgi application: needs python3-pastescript as runtime depends.
# Enables the Paste logging handler for consistent log formatting.
paste-logger = true

# automatically kill workers if master dies
# Prevents orphaned worker processes if the master process crashes.
no-orphans = true

# exit instead of brutal reload on SIGTERM
# Ensures a clean shutdown on service stop/restart.
die-on-term = true

# ------------------------------------------------------------------------------
# Performance tuning
# ------------------------------------------------------------------------------

# Threads and processes
# Enables threading support for the application.
enable-threads = true

# For max perf, set this to number of core*2
# Number of uWSGI worker processes.
processes = {{ heat_api_cfn_uwsgi_workers | default('8') }}

# This was benchmarked as a good value
# Number of threads per worker process.
threads = {{ heat_api_cfn_uwsgi_threads | default('32') }}

# This is the number of sockets in the queue.
# It improves a lot performances. This is comparable
# to the Apache ServerLimit/MaxClients option.
# Size of the listen backlog queue for incoming connections.
listen = {{ heat_api_cfn_uwsgi_listen_backlog | default('100') }}

# ------------------------------------------------------------------------------
# OpenStack service specific
# ------------------------------------------------------------------------------

# Environment variable passed to the application:
# Sets the Oslo Messaging process name for log tracing and monitoring.
# Uses project_name and heat_api_cfn_suffix to form a unique identifier.
env = OS_OSLO_MESSAGING_RABBIT__PROCESSNAME={{ project_name | default('heat') }}-{{ heat_api_cfn_suffix | default('api-cfn') }}

# This is the standard port for the WSGI application, listening on all available IPs

# Path to the log file for this service.
# Ensures logs are directed to the OpenStack standard log directory.
logto = /var/log/{{ project_name | default('heat') }}/{{ project_name | default('heat') }}-{{ heat_api_cfn_suffix | default('api-cfn') }}.log

# Name identifier for the uWSGI instance (used in logs/monitoring).
name = {{ project_name | default('heat') }}-{{ heat_api_cfn_suffix | default('api-cfn') }}

# System user under which the uWSGI worker processes will run.
uid = {{ SYSTEM_USER | default('heat') }}

# System group under which the uWSGI worker processes will run.
gid = {{ SYSTEM_GROUP | default('heat') }}

# Working directory for the application.
chdir = /var/lib/{{ project_name | default('heat') }}

# Path to the uWSGI application script (WSGI entry point).
wsgi-file = {{ heat_api_cfn_uwsgi_ini_app | default('/usr/bin/heat-wsgi-api-cfn') }}

# ------------------------------------------------------------------------------
# Network Configuration
# ------------------------------------------------------------------------------

# HTTP/HTTPS Socket Configuration
# This section is controlled by the init script using the --http-socket
# or using the --https thing. https will be activated if a file
# /etc/nova/ssl/private/*.pem is found. In both case, port 9292
# on all IPs will be used.
# The pattern to search for the private key file is:
# find /etc/nova/ssl/private -type f -iname '*.pem' | head -n 1
# and for the certificate:
# find /etc/nova/ssl/private -type f -iname '*.crt' | head -n 1
# just drop files there and restart the daemon, and you'll have
# SSL up to running.

{% if heat_api_cfn_uwsgi_port is defined and heat_api_cfn_uwsgi_port | length > 0 %}
# Port is explicitly defined. Bind HTTP socket to this port.
http-socket = :{{ heat_api_cfn_uwsgi_port }}

# Bind HTTPS socket to this port.
# NOTE: The certificate and key filenames ('foobar.crt', 'foobar.key')
# are placeholders here. In a production role, these should likely be
# configured via separate variables pointing to real cert paths.
https-socket = 0.0.0.0:{{ heat_api_cfn_uwsgi_port }},foobar.crt,foobar.key
{% else %}
# No port defined. The service is expected to be managed by an external
# socket-activating systemd service or load balancer. The internal HTTP
# socket is commented out to prevent binding conflicts.
#http-socket = :8778

# HTTPS socket is also commented out.
#https-socket = 0.0.0.0:8778,foobar.crt,foobar.key
{% endif %}