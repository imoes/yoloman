{
  "options": {
    "output": "output.bin",
    "cbm_prg": true,
    "long_address": true,
    "ascii": true,
    "long_branch": true,
    "case_sensitive": true,
    "quiet": false,
    "defines": [
      "VERSION=1",
      "DEBUG=1"
    ],
    "includes": [
      "include/",
      "/usr/local/65tass/include"
    ],
    "error_file": "errors.log",
    "no_caret_diag": true,
    "all_warnings": true,
    "suppressed_warnings": [
      "page",
      "float-compare"
    ],
    "m65c02": true,
    "labels": "labels.txt",
    "vice_labels": true,
    "list": "listing.lst",
    "line_numbers": true,
    "tab_size": 4
  }
}
