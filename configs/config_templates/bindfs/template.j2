# /etc/fstab entry for bindfs mount
# Syntax: bindfs#/source_dir /mount_point fuse [options] dump pass
# See: https://bindfs.org/ for documentation on bindfs options and behavior.
#
# Variables:
#   source_dir:  Path to the source directory to be mirrored (required).
#   mount_point: Path to the mount point where the mirrored filesystem will appear (required).
#   options:     List of bindfs options. These are joined into a single comma-separated string.
bindfs#{{ source_dir | default('') }} {{ mount_point | default('') }} fuse {{ options | default([]) | join(',') }} 0 0