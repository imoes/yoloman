    # Contrast setting for LK204 display.
    Contrast {{ LK204_Contrast | default('256/2') }}
}

# Driver: MDM166A (MDM166A LCD)
Display MDM166A {
    Driver   'MDM166A'
    # Brightness setting for MDM166A display.
    Brightness {{ MDM166A_Brightness | default(1) }}
    # Inverted setting for MDM166A display.
    Inverted {{ MDM166A_Inverted | default(0) }}
