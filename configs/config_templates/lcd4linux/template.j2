{% if display %}
# Display-specific configuration
{% for disp in display %}
Display {{ disp.name }} {{ disp.type }}
{% if disp.driver_params %}
{% for param, val in disp.driver_params.items() %}
{{ disp.name }}.{{ param }} {{ val }}
{% endfor %}
{% endif %}
{% if disp.plugins %}
