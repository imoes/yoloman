# ==========================================================================
# lcd4linux configuration template
# This file configures the lcd4linux daemon.
# Self-documented: every variable has a comment and a default.
# ==========================================================================

# ==========================================================================
# Global Tick Settings
# ==========================================================================

Variables {
    # Tick interval for 'tick' update style.
    tick {{ tick | default('500') }}

    # Tack interval for 'tack' update style.
    tack {{ tack | default('100') }}

    # Minute interval for 'minute' update style.
    minute {{ minute | default('60000') }}
}

# ==========================================================================
# Display Drivers
# ==========================================================================

# Driver: ACool (serdisplib based)
Display ACool {
    Driver 'serdisplib'
    Port 'USB:060c/04eb'
    Model 'ALPHACOOL'
}

# Driver: G15 (Logitech G15 LCD)
Display G15 {
    Driver 'G-15'
    Font   '6x8'
    # Contrast setting for G15 display.
    Contrast {{ G15_Contrast | default(10) }}
    # Inverted setting for G15 display.
    Inverted {{ G15_Inverted | default(0) }}
    # UInput device path for G15 display.
    UInput '{{ G15_UInput | default("/dev/input/uinput") }}'
    # SingleKeyPress setting for G15 display.
    SingleKeyPress {{ G15_SingleKeyPress | default(1) }}
}

# Driver: SerDispLib (generic serial display library)
Display SerDispLib {
    Driver 'serdisplib'
    Port 'PAR:/dev/parports/0'
    Model 'OPTREX323'
    Options ''
}

# Driver: TeakLCM (TeakLCD displays)
Display TeakLCM {
    Driver 'TeakLCM'
    Size '20x2'
    Port '/dev/ttyS1'
    # Speed (baud rate) for TeakLCM display.
    Speed {{ TeakLCM_Speed | default(38400) }}
    # Backlight setting for TeakLCM display.
    Backlight {{ TeakLCM_Backlight | default(1) }}
    # Icons setting for TeakLCM display.
    Icons {{ TeakLCM_Icons | default(0) }}
}

# Driver: Trefon (Trefon displays)
Display Trefon {
    Driver 'TREFON'
    Size '16x2'
    # Backlight setting for Trefon display.
    Backlight {{ Trefon_Backlight | default(1) }}
    # Icons setting for Trefon display.
    Icons {{ Trefon_Icons | default(1) }}
}

# Driver: LCD-Linux (Linux framebuffer LCD driver)
Display LCD-Linux {
    Driver 'LCD-Linux'
    Size '20x2'
    # UseBusy setting for LCD-Linux display.
    UseBusy {{ LCD_Linux_UseBusy | default(0) }}
}

# Driver: IRLCD (IR-based LCD controller)
Display IRLCD {
    Driver 'IRLCD'
    Size '16x2'
    # Backlight setting for IRLCD display.
    Backlight {{ IRLCD_Backlight | default(0) }}
    # Icons setting for IRLCD display.
    Icons {{ IRLCD_Icons | default(1) }}
}

# Driver: LCD2USB (USB LCD adapter)
Display LCD2USB {
    Driver 'LCD2USB'
    Size '20x2'
    # Backlight setting for LCD2USB display.
    Backlight {{ LCD2USB_Backlight | default(1) }}
    # Icons setting for LCD2USB display.
    Icons {{ LCD2USB_Icons | default(1) }}
}

# Driver: GLCD2USB (Large Graphic LCD over USB)
Display GLCD2USB {
    Driver 'GLCD2USB'
    # Brightness setting for GLCD2USB display.
    Brightness {{ GLCD2USB_Brightness | default(255) }}
}

# Driver: ABP08-16x3 (Aurora ABP08-16x3)
Display ABP08-16x3 {
    Driver  'LW_ABP'
    Port '/dev/tts/0'
    # Speed (baud rate) for ABP08-16x3 display.
    Speed {{ ABP08_16x3_Speed | default(19200) }}
    Size    '16x3'
}

# Driver: LCD2041 (Matrix Orbital LCD2041)
Display LCD2041 {
    Driver 'MatrixOrbital'
    Model 'LCD2041'
    Port '/dev/tts/0'
