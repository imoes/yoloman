# generic HD44780 display (LCD4Linux wiring)
Display HD44780-generic {
    Driver 'HD44780'
    Model 'generic'
    Port '/dev/parports/0'	
    Size '8x2'
    asc255bug {{ HD44780-generic_asc255bug }}
    GPOs {{ HD44780-generic_GPOs }}
    Wire {
	RW      'GND'
	RS      'AUTOFD'
	ENABLE  'STROBE'
	ENABLE2 'GND'
	GPO     'INIT'
	POWER   'GND'
    }
}

# generic HD44780 display (WinAmp wiring)
Display HD44780-winamp {
    Driver 'HD44780'
    Model 'generic'
    UseBusy {{ HD44780-winamp_UseBusy }}
    Port '/dev/parports/0'	
    Size '20x4'
    asc255bug {{ HD44780-winamp_asc255bug }}
    Wire {
	RW      'AUTOFD'
	RS      'INIT'
	ENABLE  'STROBE'
	ENABLE2 'GND'
	GPO     'GND'
	POWER   'GND'
    }
    Timing {
	# fuzz timings by value (100 = no change)
	fuzz {{ HD44780-winamp_Timing_fuzz }}
	# low-level communication [ns]
	CY {{ HD44780-winamp_Timing_CY }}  # Enable cycle time
	PW  {{ HD44780-winamp_Timing_PW }}  # Enable pulse width
	AS  {{ HD44780-winamp_Timing_AS }}  # Address setup time
	AH   {{ HD44780-winamp_Timing_AH }}  # Address hold time
	# HD44780 execution timings [us]
	INIT1 {{ HD44780-winamp_Timing_INIT1 }}  # first init sequence: 4.1 msec
	INIT2  {{ HD44780-winamp_Timing_INIT2 }}  # second init sequence: 100 usec
	EXEC    {{ HD44780-winamp_Timing_EXEC }}  # normal execution time
	WRCG   {{ HD44780-winamp_Timing_WRCG }}  # CG RAM Write
	CLEAR {{ HD44780-winamp_Timing_CLEAR }}  # Clear Display
	HOME  {{ HD44780-winamp_Timing_HOME }}  # Return Cursor Home
	ONOFF {{ HD44780-winamp_Timing_ONOFF }}  # Display On/Off Control
	# GPO timing [ns]
	GPO_ST  {{ HD44780-winamp_Timing_GPO_ST }}  # 74HCT573 set-up time
	GPO_PW {{ HD44780-winamp_Timing_GPO_PW }}  # 74HCT573 enable pulse width
	# Power supply timing [ms]
	POWER  {{ HD44780-winamp_Timing_POWER }}  # power-on delay
    }
}

