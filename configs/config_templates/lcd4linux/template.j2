{% if layout_block.y %}{{ layout_block.name }}.Y {{ layout_block.y }}{% endif %}
{% if layout_block.font %}{{ layout_block.name }}.Font {{ layout_block.font }}{% endif %}
{% if layout_block.wrap is defined %}{{ layout_block.name }}.Wrap {{ 'yes' if layout_block.wrap else 'no' }}{% endif %}
