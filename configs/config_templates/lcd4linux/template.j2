    Speed {{ LCD2041_Speed | default(19200) }}
    # Contrast setting for LCD2041 display.
    Contrast {{ LCD2041_Contrast | default(160) }}
}

# Driver: LK202 (Matrix Orbital LK202)
Display LK202 {
