Plugin DBus {
       # signal 0 is displayed IM msg
       #
       signal0sender '{{ DBus_signal0sender }}'      # should be in the form com.domain.app.service,
                                                           # the :1.23 form given by dbus-monitor will NOT work,
                                                           # if unsure skip it
       signal0path '{{ DBus_signal0path }}'        # find using dbus-monitor
       signal0interface '{{ DBus_signal0interface }}' # find using dbus-monitor
       signal0member '{{ DBus_signal0member }}'                      # find using dbus-monitor
       signal0eventname '{{ DBus_signal0eventname }}' # make something up, all Text widgets with an
                                 # event option matching this will be updated
}


#this example prints the second argument of signal#  0
#(in this case it prints the message displayed)
Widget Pidgin {
    class 'Text'
    expression dbus::argument(0, 1) . ': ' . dbus::argument(0, 2))
    width 20	
    align 'R'	
    event '{{ Pidgin_event }}'	
}	


Widget OS {
    class 'Text'
    expression '*** '.uname('sysname').' '.uname('release').' ***'
    width 20
    align 'M'
    style 'bold'
    speed {{ OS_speed }}	
    update tick
}

Widget CPU {
    class  'Text'
    expression  uname('machine')
    prefix 'CPU '
    width  9
    align  'L'
    style test::onoff(7)>0?'bold':'norm'
    update tick
}


Widget CPUinfo {
    class  'Text'
    expression  cpuinfo('model name')
    prefix ''
    width  20
    align  'M'
    speed {{ CPUinfo_speed }}	
    update tick
}


Widget RAM {
    class  'Text'
    expression meminfo('MemTotal')/1024
    postfix ' MB RAM'	
    width  11
    precision {{ RAM_precision }}
    align  'R'
    update tick
}

Widget Busy {
    class 'Text'
    expression proc_stat::cpu('busy', 500)
    prefix 'Busy'	
    postfix '%'	
    width 9	
    precision {{ Busy_precision }}
    align 'R'	
    update tick	
}	

Widget BusyBar {
    class 'Bar'
    expression  proc_stat::cpu('busy',   500)
    expression2 proc_stat::cpu('system', 500)
    length {{ BusyBar_length }}	
    direction 'E'
    update tack
}

Widget Load {
    class 'Text'
    expression loadavg(1)
    prefix 'Load'
    postfix loadavg(1)>1.0?'!':' '
    width {{ Load_width }}
    precision {{ Load_precision }}
    align 'R'
    update tick
}

Widget LoadBar {
    class 'Bar'
    expression  loadavg(1)
    max {{ LoadBar_max }}
    length {{ LoadBar_length }}	
    direction 'E'
    update tack
}


Widget Disk {
    class 'Text'
    # disk.[rw]blk return blocks, we assume a blocksize of 512
    # to get the number in kB/s we would do blk*512/1024, which is blk/2 
    # expression (proc_stat::disk('.*', 'rblk', 500)+proc_stat::disk('.*', 'wblk', 500))/2
    # with kernel 2.6, disk_io disappeared from /proc/stat but moved to /proc/diskstat
    # therefore you have to use another function called 'diskstats':
    expression diskstats('hd.', 'read_sectors', 500) + diskstats('hd.', 'write_sectors', 500)
    prefix 'disk'
    postfix ' '
    width {{ Disk_width }}	
    precision {{ Disk_precision }}
    align 'R'	
    update tick	
}	

Widget DiskBar {
    class 'Bar'
    #expression  proc_stat::disk('.*', 'rblk', 500)
    #expression2 proc_stat::disk('.*', 'wblk', 500)
    # for kernel 2.6:
    expression  diskstats('hd.', 'read_sectors',  500)
    expression2 diskstats('hd.', 'write_sectors', 500)
    length {{ DiskBar_length }}	
    direction 'E'
    update tack
}

Widget Eth0 {
    class 'Text'
    expression (netdev('eth0', 'Rx_bytes', 500)+netdev('eth0', 'Tx_bytes', 500))/1024
    prefix 'eth0'
    postfix ' '
    width {{ Eth0_width }}	
    precision {{ Eth0_precision }}
    align 'R'	
    update tick	
}	

Widget Eth0Bar {
    class 'Bar'
    expression  netdev('eth0', 'Rx_bytes', 500)
    expression2 netdev('eth0', 'Tx_bytes', 500)
    length {{ Eth0Bar_length }}	
    direction 'E'
    update tack
}

Widget PPP {
