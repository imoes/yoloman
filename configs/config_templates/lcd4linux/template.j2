Widget KVV_TIME {
    class 'Text'
    expression kvv::time_str(0)
    width {{ KVV_TIME_width }}

    align 'R'
    update tick
    foreground kvv::time(0) < 2 ? 'FF0000' : ( kvv::time(0) < 5 ? 'FFFF00' : '00FF00' )
    style 'bold'
}

