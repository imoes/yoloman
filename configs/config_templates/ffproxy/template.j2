# Defaults for ffproxy initscript
# sourced by /etc/init.d/ffproxy

# yes = start on boot; no = don't start on boot
FFPROXY_START={{ ffproxy_start | default('yes') }}

# yes = chroot daemon; no = no chroot
FFPROXY_USECHROOT={{ ffproxy_usechroot | default('yes') }}

# daemon will drop its privileges?
FFPROXY_USER={{ user | default('nobody') }}
FFPROXY_GROUP={{ group | default('nogroup') }}

# Additional options that are passed to the Daemon
FFPROXY_OPTS=
