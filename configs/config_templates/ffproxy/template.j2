# Ansible-generated init defaults for ffproxy
# This file is sourced by /etc/init.d/ffproxy to configure the service daemon.

# Controls whether the ffproxy service starts automatically on boot.
# Supported values are typically 'yes' or 'no'.
# Source schema: ffproxy_start (default: true)
FFPROXY_START={{ ffproxy_start | default(true) | lower }}

# Controls whether the ffproxy daemon runs inside a chroot jail for security.
# Supported values are typically 'yes' or 'no'.
# Source schema: ffproxy_usechroot (default: true)
FFPROXY_USECHROOT={{ ffproxy_usechroot | default(true) | lower }}

# System username to drop privileges to after startup.
# The user must exist on the system.
# Source schema: user (default: 'nobody')
FFPROXY_USER={{ user | default('nobody') }}

# System group for the privileged user.
# Source schema: group (default: 'nogroup')
FFPROXY_GROUP={{ group | default('nogroup') }}

# Additional options that are passed to the Daemon.
# Can be used to override listen ports, interfaces, or other runtime flags.
# Source schema: ffproxy_opts (not in schema, leave empty or extend schema)
FFPROXY_OPTS={{ ffproxy_opts | default('') }}