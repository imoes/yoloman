{
  "general": {
    "enabled": true,
    "logger_level": "INFO",
    "worker_threads": 8,
    "max_open_files": 131072,
    "listen_address": "0.0.0.0",
    "listen_port": 8080,
    "tls": {
      "enabled": true,
      "cert_file": "/etc/nas/tls/fullchain.pem",
      "key_file": "/etc/nas/tls/privkey.pem"
    }
  },
  "storage": {
    "default_path": "/var/lib/nas/data",
    "backends": [
      {
        "name": "local",
        "description": "Primary local storage",
        "type": "local",
        "path": "/mnt/nas/local",
        "max_size": 10995116277760,
        "readonly": false
      },
      {
        "name": "archive",
        "description": "Cold archive tier",
        "type": "local",
        "path": "/mnt/nas/archive",
        "readonly": true
      }
    ]
  },
  "auth": {
    "method": "ldap",
    "ldap_url": "ldap://ldap.company.internal",
    "ldap_base_dn": "ou=users,dc=company,dc=internal"
  }
}
