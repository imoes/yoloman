#Patroni configuration file — controls PostgreSQL instance behavior in a high-availability cluster
#Path to the PostgreSQL configuration directory
postgresql:
  data_dir: {{ pg_data_dir }}
  bin_dir: {{ pg_bin_dir }}
  configuration_files:
    postgresql.conf: {{ pg_config_file }}
    pg_hba.conf: {{ pg_hba_file }}
  use_slots: {{ replication_use_slots }}
  use_pg_rewind: {{ replication_use_pg_rewind }}
  parameters:
{% for key, value in pg_params.items() %}    # PostgreSQL parameter: {{ key }}
    {{ key | replace('_', ' ') | title | replace(' ', '_') }}: {{ value }}
{% endfor %}  # Authentication and replication settings
  authentication:
    superuser:
      username: {{ superuser_name }}
      password: {{ superuser_password }}
    replication:
      username: {{ replicator_name }}
      password: {{ replicator_password }}

# Cluster definition — identifies the cluster and its scope in the DCS
scope: {{ cluster_scope }}
name: {{ node_name }}

# DCS (Distributed Configuration Store) backend — determines which consensus service to use
dcs:
{% if dcs_type == 'zookeeper' %}
  # ZooKeeper backend configuration
  zookeeper:
{% for host in dcs_hosts %}    # ZooKeeper host: {{ host }}
    - host: {{ host }}
{% endfor %}    username: {{ dcs_username }}
    password: {{ dcs_password }}
    use_ssl: {{ dcs_use_ssl }}
{% elif dcs_type == 'etcd' %}
  # etcd backend configuration
  etcd:
{% for host in dcs_hosts %}    # etcd endpoint: {{ host }}
    host: {{ host }}
{% endfor %}    username: {{ dcs_username }}
    password: {{ dcs_password }}
    use_ssl: {{ dcs_use_ssl }}
    ca_path: {{ dcs_ca_path }}
    cert_path: {{ dcs_cert_path }}
    key_path: {{ dcs_key_path }}
{% elif dcs_type == 'consul' %}
  # Consul backend configuration
  consul:
    host: {{ dcs_hosts[0] }}
    port: {{ dcs_port }}
    token: {{ dcs_token }}
    scheme: {{ dcs_scheme }}
    verify_ssl: {{ dcs_verify_ssl }}
{% elif dcs_type == 'kubernetes' %}
  # Kubernetes backend configuration
  kubernetes:
    namespace: {{ k8s_namespace }}
    labels:
      app: patroni
    # Optional: use pod annotations for service discovery
    # pod_ip: {{ k8s_pod_ip }}
    # port: {{ k8s_port }}
    # use_endpoints: {{ k8s_use_endpoints }}
{% else %}
  # Generic DCS configuration — placeholder for custom setups
  # ⚠️ Unsupported DCS backend — configure manually
{% endif %}

# REST API — used for health checks, failover, and manual interventions
restapi:
  # Listen address for the Patroni HTTP API
  listen: {{ restapi_listen }}
  port: {{ restapi_port }}
{% if restapi_use_ssl %}
  # SSL/TLS configuration
  ssl:
    certfile: {{ restapi_certfile }}
    keyfile: {{ restapi_keyfile }}
{% endif %}
  # Authentication for administrative REST endpoints
  authentication:
    username: {{ restapi_admin_user }}
    password: {{ restapi_admin_password }}

# PostgreSQL lifecycle behavior
bootstrap:
  # Default configuration for new clusters
  dcs:
    ttl: {{ bootstrap_ttl }}
    loop_wait: {{ bootstrap_loop_wait }}
    retry_timeout: {{ bootstrap_retry_timeout }}
    maximum_lag_on_failover: {{ bootstrap_max_lag }}
    # Use synchronous replication during bootstrap
    synchronous_mode: {{ bootstrap_sync_mode }}
    # Primary start options for new clusters
    postgresql:
      use_pg_rewind: {{ replication_use_pg_rewind }}
      use_slots: {{ replication_use_slots }}
      parameters:
        wal_level: replica
        hot_standby: 'on'
        wal_keep_size: 1GB
        max_wal_senders: 10
        max_replication_slots: 10
{% if bootstrap_superuser %}
      superuser:
        username: {{ superuser_name }}
        password: {{ superuser_password }}
{% endif %}
{% if bootstrap_replicator %}
      replication:
        username: {{ replicator_name }}
        password: {{ replicator_password }}
{% endif %}
  # Initialize new cluster from existing backup
  initdb:
{% for key, value in bootstrap_initdb.items() %}    # initdb option: {{ key }}
    {{ key | replace('_', '-') | replace('  ', '-') }}: {{ value }}
{% endfor %}
  pg_hba:
{% for rule in bootstrap_pg_hba %}    # pg_hba.conf rule
    - {{ rule }}
{% endfor %}

# Health check and monitoring
watchdog:
  # Use watchdog device (e.g., /dev/watchdog) for fencing
  mode: {{ watchdog_mode }}  # allowed: off, automatic, mandatory
  device: {{ watchdog_device }}
  safety_margin: {{ watchdog_safety_margin }}

# Optional: tags to control failover priority
tags:
  nofailover: {{ node_nofailover }}
  noloadbalance: {{ node_noloadbalance }}
  clonefrom: {{ node_clonefrom }}
