{
  "pg_data_dir": "/var/lib/postgresql/14/main",
  "pg_bin_dir": "/usr/lib/postgresql/14/bin",
  "pg_config_file": "postgresql.conf",
  "pg_hba_file": "pg_hba.conf",
  "replication_use_slots": true,
  "replication_use_pg_rewind": true,
  "pg_params": {
    "shared_buffers": "512MB",
    "work_mem": "16MB",
    "effective_cache_size": "1536MB",
    "max_connections": 200,
    "logging_collector": "on",
    "log_directory": "pg_log"
  },
  "superuser_name": "postgres",
  "superuser_password": "supersecurepassword",
  "replicator_name": "replicator",
  "replicator_password": "replsecurepassword",
  "cluster_scope": "patroni_cluster",
  "node_name": "pg-node-01",
  "dcs_type": "etcd",
  "dcs_hosts": [
    "etcd1.local:2379",
    "etcd2.local:2379",
    "etcd3.local:2379"
  ],
  "dcs_username": "",
  "dcs_password": "",
  "dcs_token": "",
  "dcs_scheme": "http",
  "dcs_verify_ssl": true,
  "dcs_use_ssl": false,
  "dcs_ca_path": "/etc/patroni/etcd-ca.crt",
  "dcs_cert_path": "/etc/patroni/etcd-client.crt",
  "dcs_key_path": "/etc/patroni/etcd-client.key",
  "k8s_namespace": "database",
  "restapi_listen": "0.0.0.0",
  "restapi_port": 8008,
  "restapi_use_ssl": true,
  "restapi_certfile": "/etc/patroni/api.crt",
  "restapi_keyfile": "/etc/patroni/api.key",
  "restapi_admin_user": "admin",
  "restapi_admin_password": "adminpassword",
  "bootstrap_ttl": 30,
  "bootstrap_loop_wait": 10,
  "bootstrap_retry_timeout": 10,
  "bootstrap_max_lag": 1048576,
  "bootstrap_sync_mode": true,
  "bootstrap_superuser": true,
  "bootstrap_replicator": true,
  "bootstrap_initdb": {
    "encoding": "UTF8",
    "locale": "en_US.UTF-8",
    "data-checksums": true
  },
  "bootstrap_pg_hba": [
    "local all postgres peer",
    "local all all md5",
    "host all all 127.0.0.1/32 md5",
    "host all all 10.0.0.0/8 md5",
    "host replication replicator 10.0.0.0/8 md5"
  ],
  "watchdog_mode": "off",
  "watchdog_device": "/dev/watchdog",
  "watchdog_safety_margin": 5,
  "node_nofailover": false,
  "node_noloadbalance": false,
  "node_clonefrom": false
}
