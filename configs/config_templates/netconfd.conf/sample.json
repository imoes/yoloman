{
  "enabled": true,
  "log_level": "info",
  "log_file": "/var/log/netconfd/netconfd.log",
  "pid_file": "/run/netconfd/netconfd.pid",
  "max_sessions_per_user": 10,
  "max_sessions_total": 100,
  "session_timeout": 600,
  "ssh_enabled": true,
  "ssh_host": "0.0.0.0",
  "ssh_port": 830,
  "ssh_host_key": "/etc/ssh/netconfd_host_key",
  "ssh_authorized_keys": "/etc/ssh/netconfd_authorized_keys",
  "tls_enabled": false,
  "tls_host": "0.0.0.0",
  "tls_port": 6513,
  "tls_cert": "",
  "tls_key": "",
  "tls_ca_cert": "",
  "restconf_enabled": false,
  "restconf_host": "0.0.0.0",
  "restconf_port": 443,
  "restconf_tls_cert": "",
  "restconf_tls_key": "",
  "validate_yang_on_startup": true,
  "yang_module_paths": [
    "/usr/share/yang/modules",
    "/usr/local/share/yang/modules",
    "/etc/yang/modules"
  ],
  "startup_config": "/etc/netconfd/startup.xml",
  "candidate_config": "/etc/netconfd/candidate.xml",
  "running_config": "/etc/netconfd/running.xml",
  "notifications_enabled": true,
  "notification_streams_dir": "/etc/netconfd/streams",
  "extensions": [
    {
      "path": "/usr/lib/netconfd/ext_yang_push.so",
      "args": "interval=60, filter=ietf-yang-push:system"
    }
  ],
  "users": [
    {
      "name": "netconf",
      "password": "",
      "public_key": "/etc/ssh/keys/netconf.pub",
      "role": "admin"
    }
  ]
}
