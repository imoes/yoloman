# Main context: Global configuration settings
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /run/nginx.pid;

# Events context: Connection handling tuning
events {
  worker_connections {{ worker_connections }};
  multi_accept on;
  use epoll;
}

# HTTP context: HTTP server defaults and upstreams
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  # Logging format and access log
  log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent" "$http_x_forwarded_for"';
  access_log /var/log/nginx/access.log main;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout {{ keepalive_timeout }};
  types_hash_max_size 2048;

  # Gzip compression (optional, but common for gRPC over HTTP/2 — disabled per gRPC spec)
  # Note: gRPC does NOT support compression via gzip; left disabled by default
  gzip off;

  # Include site-specific configs (e.g., /etc/nginx/conf.d/*.conf)
  include /etc/nginx/conf.d/*.conf;
}

# Stream context: TCP/UDP load balancing (used for raw gRPC over TCP without HTTP/2 if needed)
stream {
  # Optional: TCP upstreams for non-HTTP/2 gRPC
  {% for stream_upstream in stream_upstreams %}
  # Upstream: {{ stream_upstream.name }}
  upstream {{ stream_upstream.name }} {
    {% for server in stream_upstream.servers %}
    server {{ server.host }}:{{ server.port }} {{ server.options | join(', ') }};
    {% endfor %}
    {{ stream_upstream.extra_directives | join('\n') }}
  }
  {% endfor %}

  {% for stream_server in stream_servers %}
  # Server: {{ stream_server.name }} — TCP proxy for raw gRPC
  server {
    listen {{ stream_server.listen.port }} {{ stream_server.listen.options | join(', ') }};
    proxy_timeout {{ stream_server.proxy_timeout }}s;
    proxy_responses {{ stream_server.proxy_responses }};
    proxy_pass {{ stream_server.upstream }};
  }
  {% endfor %}
}
