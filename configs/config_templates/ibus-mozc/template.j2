# Desktop entry for the ibus-mozc GNOME Initial Setup assistant.
# This file is generated by Ansible and should not be edited manually.
# It configures the autostart behavior of the Mozc input method setup wizard
# within the GNOME desktop environment.

[Desktop Entry]

# The display name for the desktop entry.
# Schema field: name
# Default: ibus-mozc GNOME Initial Setup
Name={{ name | default('ibus-mozc GNOME Initial Setup') }}

# Type of entry; always Application for GUI apps.
Type=Application

# The command to execute for the desktop entry.
# Schema field: exec
# Default: /usr/share/ibus-mozc/ibus-mozc-gnome-initial-setup.sh
Exec={{ exec | default('/usr/share/ibus-mozc/ibus-mozc-gnome-initial-setup.sh') }}

# Semicolon-separated list of desktop environments where this application should be shown.
# Schema field: only_show_in
# Default: GNOME;
OnlyShowIn={{ only_show_in | default('GNOME;') }}

# If true, the application will not be displayed in the application menu.
# This is typically true for setup wizards that run once and then disappear.
# Schema field: no_display
# Default: true
NoDisplay={{ no_display | default(true) }}

# Condition for autostarting the application.
# The default value implies the setup only runs if the marker file does not exist.
# Schema field: autostart_condition
# Default: unless-exists ibus-mozc-gnome-initial-setup-done
AutostartCondition={{ autostart_condition | default('unless-exists ibus-mozc-gnome-initial-setup-done') }}
