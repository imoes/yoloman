{
  "accounts": [
    {
      "name": "gmail",
      "host": "smtp.gmail.com",
      "port": 587,
      "from_address": "user@gmail.com",
      "auth": "login",
      "user": "user@gmail.com",
      "password": "your-app-password",
      "tls": true,
      "tls_starttls": true,
      "tls_trust_file": "/etc/ssl/certs/ca-certificates.crt",
      "syslog": true,
      "log_file": "/var/log/msmtp.log",
      "timeout": 60
    },
    {
      "name": "protonmail",
      "host": "smtp.protonmail.ch",
      "port": 587,
      "from_address": "user@protonmail.com",
      "auth": "login",
      "user": "user@protonmail.com",
      "password": "your-protonmail-password",
      "tls": true,
      "tls_starttls": true,
      "syslog": false
    }
  ],
  "default_account": "gmail",
  "aliases": {
    "root": "admin@example.com",
    "postmaster": "admin@example.com"
  }
}
