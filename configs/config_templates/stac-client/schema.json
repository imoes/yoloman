{
  "catalog_url": {
    "type": "string",
    "default": "https://earth-search.aws.element84.com/v1",
    "description": "Root Catalog URL to connect to"
  },
  "logging_level": {
    "type": "string",
    "default": "INFO",
    "description": "Logging level: DEBUG, INFO, WARN, ERROR, CRITICAL",
    "enum": [
      "DEBUG",
      "INFO",
      "WARN",
      "ERROR",
      "CRITICAL"
    ]
  },
  "headers": {
    "type": "list",
    "default": [],
    "description": "Additional request headers (KEY=VALUE pairs)"
  },
  "add_conforms_to": {
    "type": "list",
    "default": [
      "CORE"
    ],
    "description": "Conformance classes to add"
  },
  "remove_conforms_to": {
    "type": "list",
    "default": [],
    "description": "Conformance classes to remove"
  },
  "clear_conforms_to": {
    "type": "bool",
    "default": false,
    "description": "Clear all conformance classes"
  },
  "error_warnings": {
    "type": "list",
    "default": [],
    "description": "Warnings to treat as errors: no-conforms-to, does-not-conform-to, missing-link, fallback-to-pystac"
  },
  "ignore_warnings": {
    "type": "list",
    "default": [],
    "description": "Warnings to ignore: no-conforms-to, does-not-conform-to, missing-link, fallback-to-pystac"
  },
  "collections": {
    "type": "list",
    "default": [],
    "description": "Collection IDs to search within"
  },
  "ids": {
    "type": "list",
    "default": [],
    "description": "Item IDs to retrieve (ignores other params)"
  },
  "bbox": {
    "type": "list",
    "default": [],
    "description": "Bounding box [min_lon, min_lat, max_lon, max_lat]"
  },
  "intersects": {
    "type": "string",
    "default": "",
    "description": "GeoJSON Feature or geometry string/file path"
  },
  "datetime": {
    "type": "string",
    "default": "",
    "description": "Single datetime or range (e.g. 2017-01-01/2017-02-15)"
  },
  "query": {
    "type": "list",
    "default": [],
    "description": "Query properties KEY=VALUE pairs"
  },
  "filter": {
    "type": "string",
    "default": "",
    "description": "Filter expression using filter-lang"
  },
  "filter_lang": {
    "type": "string",
    "default": "cql2-json",
    "description": "Filter language (default cql2-json)"
  },
  "sortby": {
    "type": "list",
    "default": [],
    "description": "Fields to sort by"
  },
  "fields": {
    "type": "list",
    "default": [],
    "description": "Fields to return"
  },
  "limit": {
    "type": "number",
    "default": 10,
    "description": "Page size limit"
  },
  "max_items": {
    "type": "number",
    "default": 100,
    "description": "Max items to retrieve"
  },
  "method": {
    "type": "string",
    "default": "POST",
    "description": "HTTP method: GET or POST",
    "enum": [
      "GET",
      "POST"
    ]
  },
  "matched": {
    "type": "bool",
    "default": false,
    "description": "Print number matched"
  },
  "save_path": {
    "type": "string",
    "default": "",
    "description": "Filename to save Item collection to"
  }
}
