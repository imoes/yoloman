{
  "acl_entries": [
    {
      "principal": "admin/admin@EXAMPLE.COM",
      "permissions": [
        "all"
      ],
      "pattern": "*"
    },
    {
      "principal": "kadmin/changepw@EXAMPLE.COM",
      "permissions": [
        "changepw"
      ],
      "pattern": "*"
    },
    {
      "principal": "admin/*@INTERNAL.NET",
      "permissions": [
        "read",
        "write"
      ],
      "pattern": "*/*@INTERNAL.NET"
    },
    {
      "principal": "helpdesk/*@EXAMPLE.COM",
      "permissions": [
        "add",
        "delete"
      ],
      "pattern": "*/user@EXAMPLE.COM"
    }
  ]
}
