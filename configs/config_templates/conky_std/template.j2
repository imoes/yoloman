# Automatically generated Conky configuration — do not edit directly
# Basic settings
template_use_utf8 = {{ values.use_utf8 | lower }}
template_text_alignment = "{{ values.text_alignment }}"
template_gap_x = {{ values.gap_x }}
template_gap_y = {{ values.gap_y }}
template_minimum_width = {{ values.minimum_width }}
template_minimum_height = {{ values.minimum_height }}

# Window & display
background = {{ values.background | lower }}
out_to_console = {{ values.out_to_console | lower }}
out_to_stderr = {{ values.out_to_stderr | lower }}
extra_newline = {{ values.extra_newline | lower }}

# Font
template_font = "{{ values.font.name }}:size={{ values.font.size }};{{ values.font.extra }}"

# Color scheme
template_colors = [
{% for color in values.colors %}  "{{ color.name }}" = "{{ color.value }}",
{% endfor %}]

template_default_color = "{{ values.default_color }}"

# Update interval (in seconds)
template_update_interval = {{ values.update_interval }}

# Disk monitor
template_draw_borders = {{ values.draw_borders | lower }}
template_draw_graph_borders = {{ values.draw_graph_borders | lower }}
template_draw_outline = {{ values.draw_outline | lower }}
template_draw_shades = {{ values.draw_shades | lower }}

# Text alignment and spacing
template_text_alignment = "{{ values.text_alignment }}"
template_text_buffer = {{ values.text_buffer }}

# Process monitoring
template_max_user_text = {{ values.max_user_text }}
template_text_size = {{ values.text_size }}

# Network interfaces
template_interfaces = [{{ values.network_interfaces | map('quote') | join(', ') }}]

# Disk devices to monitor
template_disk_devices = [{{ values.disk_devices | map('quote') | join(', ') }}]

# CPU usage graph settings
template_cpu_avg_samples = {{ values.cpu_avg_samples }}

# Temperature units: 'c' or 'f'
template_temperature_unit = "{{ values.temperature_unit }}"

# Time formatting (strftime compatible)
template_time_format = "{{ values.time_format }}"

# System information display sections
template_top_name = "{{ values.top_name }}"
template_top_exe = "{{ values.top_exe }}"
template_top_mem = "{{ values.top_mem }}"
template_top_cpu = "{{ values.top_cpu }}"
template_top_io = "{{ values.top_io }}"
template_top_time = "{{ values.top_time }}"

# Custom user-defined text blocks
{% for block in values.user_text_blocks %}
{{ block.name }} = "{{ block.text }}"
{% endfor %}

# Main UI layout: start of body section
template_text = [[
{{ values.body_text | indent(2) }}
]]
