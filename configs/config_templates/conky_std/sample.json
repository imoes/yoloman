{
  "use_utf8": true,
  "text_alignment": "left",
  "gap_x": 10,
  "gap_y": 20,
  "minimum_width": 300,
  "minimum_height": 200,
  "background": true,
  "out_to_console": false,
  "out_to_stderr": false,
  "extra_newline": false,
  "font": {
    "name": "Fira Code",
    "size": 11,
    "extra": "bold"
  },
  "colors": [
    {
      "name": "color1",
      "value": "#6c7a89"
    },
    {
      "name": "color2",
      "value": "#e0e0e0"
    },
    {
      "name": "color3",
      "value": "#ff6b6b"
    }
  ],
  "default_color": "#e0e0e0",
  "update_interval": 2,
  "draw_borders": false,
  "draw_graph_borders": true,
  "draw_outline": false,
  "draw_shades": true,
  "text_buffer": 2048,
  "max_user_text": 32768,
  "text_size": 500,
  "network_interfaces": [
    "enp0s31f6",
    "wlp4s0"
  ],
  "disk_devices": [
    "/",
    "/home"
  ],
  "cpu_avg_samples": 3,
  "temperature_unit": "c",
  "time_format": "%Y-%m-%d %H:%M",
  "top_name": "NAME",
  "top_exe": "COMMAND",
  "top_mem": "MEM%",
  "top_cpu": "CPU%",
  "top_io": "IO%",
  "top_time": "TIME",
  "user_text_blocks": [
    {
      "name": "header_block",
      "text": "=== System Monitor ==="
    },
    {
      "name": "footer_block",
      "text": "Report: ${date}"
    }
  ],
  "body_text": "${color2}Hostname: ${color1}${nodename}\n${color2}Kernel: ${color1}${kernel}\n\n${color2}CPU: ${color1}${cpu cpu0}% ${color2}${cpubar cpu0}\n${color2}RAM: ${color1}${mem}/${memmax} (${memperc}%) ${color2}${membar}\n${color2}Disk: ${color1}${fs_used /}/${fs_size /} ${color2}${fs_bar /}\n\n${color2}Processes: ${color1}${processes}\n${color2}Top CPU: ${color1}${top name 1} (${top cpu 1}%)\n\n${color2}Network (enp0s31f6):\n${color1}Down: ${downspeed enp0s31f6} ${color2}Up: ${upspeed enp0s31f6}"
}
