{
  "bind_host": "0.0.0.0",
  "port": 8080,
  "max_connections": 500,
  "log_dir": "/var/log/pagure",
  "log_level": "INFO",
  "pagure_uri": "https://pagure.example.com",
  "idle_timeout": 120,
  "use_tls": true,
  "tls_cert": "/etc/letsencrypt/live/pagure.example.com/fullchain.pem",
  "tls_key": "/etc/letsencrypt/live/pagure.example.com/privkey.pem",
  "allowed_origins": [
    "https://pagure.example.com",
    "https://docs.pagure.example.com"
  ],
  "redis_url": "redis://redis.internal:6379/1",
  "workers": 4,
  "local_db_path": "/var/lib/pagure/pagure_ev_server.db",
  "debug": false
}
