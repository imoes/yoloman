{# The hostname or IP address the EventSource server will bind to #}
bind_host = "{{ bind_host }}"

{# The port the EventSource server will listen on #}
port = {{ port }}

{# The maximum number of concurrent connections #}
max_connections = {{ max_connections }}

{# Path to the log directory #}
log_dir = "{{ log_dir }}"

{# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL #}
log_level = "{{ log_level }}"

{# Path to the main Pagure instance (for reverse proxy or health-check references) #}
pagure_uri = "{{ pagure_uri }}"

{# Timeout (in seconds) for idle connections #}
idle_timeout = {{ idle_timeout }}

{# Enable or disable TLS (requires cert/key paths if true) #}
use_tls = {{ use_tls }}

{# Path to TLS certificate file (used only if use_tls is true) #}
tls_cert = "{{ tls_cert }}"

{# Path to TLS private key file (used only if use_tls is true) #}
tls_key = "{{ tls_key }}"

{# Optional: Additional WebSocket origins to allow (for CORS) #}
allowed_origins = [
{% for origin in allowed_origins %}    "{{ origin }}"{% if not loop.last %},{% endif %}
{% endfor %}]

{# Path to the Redis server for pub/sub coordination (used for multi-instance sync) #}
redis_url = "{{ redis_url }}"

{# Number of worker processes (0 = auto based on CPU count) #}
workers = {{ workers }}

{# Path to the SQLite database for local state (fallback if Redis unavailable) #}
local_db_path = "{{ local_db_path }}"

{# Whether to enable debug mode (not recommended in production) #}
debug = {{ debug }}
