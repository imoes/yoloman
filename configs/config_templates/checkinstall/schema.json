{
  "ACCEPT_DEFAULT": {
    "type": "number",
    "description": "Accept default values for all questions (0/1)",
    "default": 0
  },
  "ADD_SO": {
    "type": "number",
    "description": "Automatically add found shared libs to ld.so.conf (experimental) (0/1)",
    "default": 0
  },
  "ARCHITECTURE": {
    "type": "string",
    "description": "Target architecture (empty = auto-guess)",
    "default": "\"\""
  },
  "AUTODOINST": {
    "type": "number",
    "description": "Write doinst.sh for Slackware (0/1)",
    "default": 1
  },
  "BACKUP": {
    "type": "number",
    "description": "Backup overwritten/modified files (0/1)",
    "default": 1
  },
  "BASE_TMP_DIR": {
    "type": "string",
    "description": "Base directory for temporary files",
    "default": "/var/tmp   ##  Don't set this to /tmp or / !!"
  },
  "CKUMASK": {
    "type": "string",
    "description": "Umask value for file permissions",
    "default": "0022"
  },
  "CK_INSPECT": {
    "type": "number",
    "description": "Inspect the file list before creating the package (0/1)",
    "default": 0
  },
  "COMPRESS_MAN": {
    "type": "number",
    "description": "Automatically compress man pages (0/1)",
    "default": 1
  },
  "DEBUG": {
    "type": "number",
    "description": "Debug level: 0 = no debug, 1 = keep temp files, 2 = keep package files too",
    "default": 0
  },
  "DEL_DESC": {
    "type": "number",
    "description": "Automatically delete description-pak (0/1)",
    "default": 0
  },
  "DEL_DOCPAK": {
    "type": "number",
    "description": "Automatically delete doc-pak on termination (0/1)",
    "default": 0
  },
  "DEL_SPEC": {
    "type": "number",
    "description": "Automatically delete spec file (0/1)",
    "default": 0
  },
  "DOC_DIR": {
    "type": "string",
    "description": "Directory for installed document files",
    "default": "\"/usr/share/doc\""
  },
  "DPKG_FLAGS": {
    "type": "string",
    "description": "Optional flags for dpkg",
    "default": "\"\""
  },
  "EXCLUDE": {
    "type": "string",
    "description": "Comma-delimited list of paths to exclude",
    "default": "\"\""
  },
  "INSTALL": {
    "type": "number",
    "description": "Install the package or just create it? (0/1)",
    "default": 1
  },
  "INSTALLWATCH_PREFIX": {
    "type": "string",
    "description": "Prefix directory for installwatch binary",
    "default": "\"/usr\""
  },
  "INSTYPE": {
    "type": "string",
    "description": "Default package type: S=Slackware, R=RPM, D=Debian (empty = ask every time)",
    "default": "\"D\"",
    "enum": [
      "S",
      "R",
      "D"
    ]
  },
  "MAKEPKG": {
    "type": "string",
    "description": "Path to the makepkg program",
    "default": "/sbin/makepkg"
  },
  "MAKEPKG_FLAGS": {
    "type": "string",
    "description": "Optional flags for makepkg",
    "default": "\"-l y -c n\""
  },
  "NEW_SLACK": {
    "type": "number",
    "description": "Use new Slackware description file format (0/1)",
    "default": 1
  },
  "PAK_DIR": {
    "type": "string",
    "description": "Storage directory for newly created packages (empty = default for package type)",
    "default": "\"\""
  },
  "RESET_UIDS": {
    "type": "number",
    "description": "Reset owner/group to root.root (0/1)",
    "default": 0
  },
  "REVIEW_CONTROL": {
    "type": "number",
    "description": "Review the control file before creating a .deb (0/1)",
    "default": 0
  },
  "REVIEW_SPEC": {
    "type": "number",
    "description": "Review the .spec file before creating a .rpm (0/1)",
    "default": 0
  },
  "RPM_FLAGS": {
    "type": "string",
    "description": "Optional flags for rpm",
    "default": "\" --force --nodeps --replacepkgs \""
  },
  "RPM_IU": {
    "type": "string",
    "description": "Use -U flag for rpm by default ('U' = update, 'i' = install)",
    "enum": [
      "U",
      "i"
    ],
    "default": "U"
  },
  "SHOW_INSTALL": {
    "type": "number",
    "description": "Show install command output interactively (0/1)",
    "default": 1
  },
  "SHOW_MAKEPKG": {
    "type": "number",
    "description": "Whether to show makepkg output interactively (0 = no, 1 = yes)",
    "default": 0
  },
  "SHOW_SLACK_INSTALL": {
    "type": "number",
    "description": "Show Slackware install script while it runs (0/1)",
    "default": 1
  },
  "STRIP_ELF": {
    "type": "number",
    "description": "Automatically strip ELF binaries (0/1)",
    "default": 1
  },
  "STRIP_SO_ELF": {
    "type": "number",
    "description": "Automatically strip ELF shared libraries (0/1)",
    "default": 1
  },
  "TRANSLATE": {
    "type": "number",
    "description": "Use filesystem translation (0/1)",
    "default": 1
  },
  "installwatch": {
    "type": "string",
    "description": "INSTALLWATCH (as documented in the shipped file).",
    "default": "${INSTALLWATCH_PREFIX}/bin/installwatch"
  },
  "these": {
    "type": "string",
    "description": "These (as documented in the shipped file). Unset keeps the shipped commented line (# These are default settings for CheckInstall, modify them as you  #).",
    "default": null
  }
}
