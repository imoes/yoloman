#----------------------------------------------------------------------------#
#    CheckInstall configuration file                                           #
#   ##########################################################################

####################################################################
# These are default settings for CheckInstall, modify them as you  #
# need. Remember that command line switches will override them.    #
####################################################################

# Debug level
#   0: No debug
#   1: Keep all temp files except the package's files
#   2: Keep the package's files too
# Debug level: 0 = no debug, 1 = keep temp files, 2 = keep package files too
DEBUG={{ DEBUG | default(0) }}

# Location of the "installwatch" program
# Prefix directory for installwatch binary
INSTALLWATCH_PREFIX="{{ INSTALLWATCH_PREFIX | default('/usr') }}"
INSTALLWATCH=${INSTALLWATCH_PREFIX}/bin/installwatch

# Location of the makepkg program. "makepak" is the default, and is 
# included with checkinstall. If you want to use Slackware's native "makepkg"
# then set this to "makepkg"
# Path to the makepkg program
MAKEPKG="{{ MAKEPKG | default('/sbin/makepkg') }}"

# makepkg optional flags. These are recommended if running a newer Slackware
# version: "-l y -c n"
# Optional flags for makepkg
MAKEPKG_FLAGS="{{ MAKEPKG_FLAGS | default('-l y -c n') }}"

# Is MAKEPKG running interactively? If so, you might want
# to see what it's doing:
# Whether to show makepkg output interactively (0 = no, 1 = yes)
SHOW_MAKEPKG="{{ SHOW_MAKEPKG | default(0) }}"

# Where will we keep our temp files?
# Don't set this to /tmp or /!!
# Base directory for temporary files
BASE_TMP_DIR="{{ BASE_TMP_DIR | default('/var/tmp') }}"

# Where to place the installed document files
# Directory for installed document files
DOC_DIR="{{ DOC_DIR | default('/usr/share/doc') }}"

# Default architecture type (Leave it empty to allow auto-guessing)
# Target architecture (empty = auto-guess)
ARCHITECTURE="{{ ARCHITECTURE | default('') }}"

# Default package type. Leave it empty to enable asking everytime
#   S : Slackware
#   R : RPM
#   D : Debian
# Default package type: S=Slackware, R=RPM, D=Debian (empty = ask every time)
INSTYPE="{{ INSTYPE | default('D') }}"

# Storage directory for newly created packages
# By default they will be stored at the default
# location defined for the package type
# Storage directory for newly created packages (empty = default for package type)
PAK_DIR="{{ PAK_DIR | default('') }}"

# RPM optional flags
# Optional flags for rpm
RPM_FLAGS="{{ RPM_FLAGS | default(' --force --nodeps --replacepkgs ') }}"

# dpkg optional flags
# Optional flags for dpkg
DPKG_FLAGS="{{ DPKG_FLAGS | default('') }}"


## These are boolean. Set them to 1 or 0

# Interactively show the results of the install command (i.e. "make install")?
# This is useful for interactive installation commands
# Show install command output interactively (0/1)
SHOW_INSTALL="{{ SHOW_INSTALL | default(1) }}"

# Show Slackware package installation script while it runs? Again, useful if
# it's an interactive script
# Show Slackware install script while it runs (0/1)
SHOW_SLACK_INSTALL="{{ SHOW_SLACK_INSTALL | default(1) }}"

# Automatic deletion of "doc-pak" upon termination?
# Automatically delete doc-pak on termination (0/1)
DEL_DOCPAK="{{ DEL_DOCPAK | default(0) }}"

# Automatic deletion of the spec file?
# Automatically delete spec file (0/1)
DEL_SPEC="{{ DEL_SPEC | default(0) }}"

# Automatic deletion of "description-pak"?
# Automatically delete description-pak (0/1)
DEL_DESC="{{ DEL_DESC | default(0) }}"

# Automatically strip all ELF binaries?
# Automatically strip ELF binaries (0/1)
STRIP_ELF="{{ STRIP_ELF | default(1) }}"

# Automatically strip all ELF shared libraries?
# Note: this setting will automatically be set to "0" if STRIP_ELF=0
# Automatically strip ELF shared libraries (0/1)
STRIP_SO_ELF="{{ STRIP_SO_ELF | default(1) }}"

# Automatically search for shared libraries and add them to /etc/ld.so.conf?
# This is experimental and could mess up your dynamic loader configuration.
# Use it only if you know what you are doing.
# Automatically add found shared libs to ld.so.conf (experimental) (0/1)
ADD_SO="{{ ADD_SO | default(0) }}"

# Automatically compress all man pages?
# Automatically compress man pages (0/1)
COMPRESS_MAN="{{ COMPRESS_MAN | default(1) }}"

# Set the umask to this value
# Umask value for file permissions
CKUMASK="{{ CKUMASK | default('0022') }}"

# Backup files overwritten or modified by your install command?
# Backup overwritten/modified files (0/1)
BACKUP="{{ BACKUP | default(1) }}"

# Write a doinst.sh file that installs your description (Slackware)?
# Write doinst.sh for Slackware (0/1)
AUTODOINST="{{ AUTODOINST | default(1) }}"

# Are we going to use filesystem translation?
# Use filesystem translation (0/1)
TRANSLATE="{{ TRANSLATE | default(1) }}"

# Reset the owner/group of all files to root.root?
# Reset owner/group to root.root (0/1)
RESET_UIDS="{{ RESET_UIDS | default(0) }}"

# Use the new (8.1+) Slackware description file format?
# Use new Slackware description file format (0/1)
NEW_SLACK="{{ NEW_SLACK | default(1) }}"

# Comma delimited list of files/directories to be ignored
# Comma-delimited list of paths to exclude
EXCLUDE="{{ EXCLUDE | default('') }}"

# Accept default values for all questions?
# Accept default values for all questions (0/1)
ACCEPT_DEFAULT="{{ ACCEPT_DEFAULT | default(0) }}"

# Use "-U" flag in rpm by default when installing a rpm package
# This tells rpm to (U)pdate the package instead of (i)nstalling it.
# Use -U flag for rpm by default ('U' = update, 'i' = install)
RPM_IU="{{ RPM_IU | default('U') }}"

# Inspect the file list before creating the package
# Inspect the file list before creating the package (0/1)
CK_INSPECT="{{ CK_INSPECT | default(0) }}"

# Review the .spec file before creating a .rpm
# Review the .spec file before creating a .rpm (0/1)
REVIEW_SPEC="{{ REVIEW_SPEC | default(0) }}"

# Review the control file before creating a .deb
# Review the control file before creating a .deb (0/1)
REVIEW_CONTROL="{{ REVIEW_CONTROL | default(0) }}"

# Install the package or just create it?
# Install the package or just create it? (0/1)
INSTALL="{{ INSTALL | default(1) }}"