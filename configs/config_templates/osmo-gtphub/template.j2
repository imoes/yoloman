! 
! Osmocom gtphub configuration
!
! This template configures the GTP-Hub service from the Osmocom project.
! It handles logging verbosity/formatting and network binding for SGSN and GGSN
! GTP (GPRS Tunnelling Protocol) interfaces.

! Enable color output in logs (1 = enable, 0 = disable)
log stderr
 logging color {{ logging_color | default('1') }}

! Print category as hex code (1 = enable, 0 = disable)
 logging print category-hex {{ logging_print_category_hex | default('0') }}

! Print category name in logs (1 = enable, 0 = disable)
 logging print category {{ logging_print_category | default('1') }}

! Include timestamps in log messages (1 = enable, 0 = disable)
 logging timestamp {{ logging_timestamp | default('0') }}

! Print the log level in messages (1 = enable, 0 = disable)
 logging print level {{ logging_print_level | default('1') }}

! Note: 'logging print file basename last' is hardcoded in the base template
! and not exposed as a variable, as it was not present in the schema.

! Configure VTY (Virtual Terminal) interface for management access
line vty
 ! Disable login prompt for VTY access (common in containerized/automated deployments)
 no login

! GTP-Hub main configuration block
gtphub
 ! ---------------------------------------------------------------------------
 ! Network Binding
 ! ---------------------------------------------------------------------------
 ! Bind the GTP-C/GTP-U socket for SGSN connections to this local address.
 ! Local address to bind to for SGSN traffic
 bind-to-sgsns {{ bind_to_sgsns | default('127.0.0.10') }}

 ! Bind the GTP-C/GTP-U socket for GGSN connections to this local address.
 ! Local address to bind to for GGSN traffic
 bind-to-ggsns {{ bind_to_ggsns | default('127.0.0.20') }}

 ! ---------------------------------------------------------------------------
 ! Proxy & DNS (Optional/Advanced)
 ! ---------------------------------------------------------------------------
 ! The following directives are commented out as they were not part of the
 ! provided schema defaults. Uncomment and configure if specific proxy
 ! or DNS resolution behavior is required.

 ! Local nonstandard ports or separate IPs:
 !bind-to-sgsns ctrl 127.0.0.1 2342 user 127.0.0.1 4223

 ! Proxy: unconditionally direct all traffic to...
 !ggsn-proxy 127.0.0.3
 !sgsn-proxy 127.0.0.4

 ! Proxy with nonstandard ports or separate IPs:
 !ggsn-proxy ctrl 127.0.0.3 2123 user 127.0.0.5 2152

 ! Add a name server for GGSN resolution
 !grx-dns-add 192.168.0.1
