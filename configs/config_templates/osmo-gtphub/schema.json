{
  "logging_color": {
    "type": "number",
    "default": 1,
    "description": "Enable color output in logs"
  },
  "logging_print_category_hex": {
    "type": "number",
    "default": 0,
    "description": "Print category as hex code"
  },
  "logging_print_category": {
    "type": "number",
    "default": 1,
    "description": "Print category name in logs"
  },
  "logging_timestamp": {
    "type": "number",
    "default": 0,
    "description": "Include timestamps in log messages"
  },
  "logging_print_level": {
    "type": "number",
    "default": 1,
    "description": "Print log level in messages"
  },
  "bind_to_sgsns": {
    "type": "string",
    "default": "127.0.0.10",
    "description": "Local address to bind to for SGSN traffic"
  },
  "bind_to_ggsns": {
    "type": "string",
    "default": "127.0.0.20",
    "description": "Local address to bind to for GGSN traffic"
  }
}
