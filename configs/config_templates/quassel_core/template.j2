# Quassel Core configuration file
# Generated by configuration management

# Network and connection settings
[core]
# Database backend to use: SQLite, PostgreSQL, or MySQL
DbDriver={{ db_driver }}
# Path to SQLite database file (only used if DbDriver=SQLite)
DbPath={{ db_path }}
# PostgreSQL connection parameters (only used if DbDriver=PostgreSQL)
DbHost={{ db_host }}
DbPort={{ db_port }}
DbName={{ db_name }}
DbUser={{ db_user }}
# MySQL connection parameters (only used if DbDriver=MySQL)
# DbHost={{ db_host }}
# DbPort={{ db_port }}
# DbName={{ db_name }}
# DbUser={{ db_user }}

# Daemon configuration
# Whether to run as a background daemon (true/false)
Daemon={{ daemon }}
# PID file location for daemon mode
PidFile={{ pid_file }}

# Network listen configuration
# Host to bind to (e.g., 0.0.0.0, ::, or localhost)
Host={{ host }}
# TCP port for client connections
Port={{ port }}
# Use SSL for client connections (true/false)
UseSSL={{ use_ssl }}
# Path to SSL certificate file (if UseSSL=true)
SSLCert={{ ssl_cert }}
# Path to SSL private key file (if UseSSL=true)
SSLKey={{ ssl_key }}

# Storage and performance settings
# Maximum number of backlog messages per buffer (0 = unlimited)
MaxBufferCount={{ max_buffer_count }}
# Maximum size of each buffer in bytes (0 = unlimited)
MaxBufferedBytes={{ max_buffered_bytes }}

# Logging settings
# Log level: 0=Debug, 1=Info, 2=Warning, 3=Error
LogLevel={{ log_level }}

# Client network settings
# Allow external clients to connect (true/false)
AllowRemote={{ allow_remote }}
# Timeout (in seconds) for idle client connections
IdleTimeout={{ idle_timeout }}

# Optional: authentication backends (not commonly used directly, but supported)
# AuthBackend={{ auth_backend }}
