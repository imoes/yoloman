{
  "db_driver": "SQLite",
  "db_path": "/var/lib/quassel/quassel-core.sqlite",
  "db_host": "localhost",
  "db_port": 5432,
  "db_name": "quassel",
  "db_user": "quassel",
  "daemon": true,
  "pid_file": "/run/quassel/quassel-core.pid",
  "host": "0.0.0.0",
  "port": 4242,
  "use_ssl": true,
  "ssl_cert": "/etc/quassel/quassel-cert.pem",
  "ssl_key": "/etc/quassel/quassel-key.pem",
  "max_buffer_count": 100,
  "max_buffered_bytes": 0,
  "log_level": 2,
  "allow_remote": true,
  "idle_timeout": 300
}
