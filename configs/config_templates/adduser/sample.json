{
  "dshell": "/bin/bash",
  "skel": "/etc/skel",
  "first_system_uid": 100,
  "last_system_uid": 999,
  "first_system_gid": 100,
  "last_system_gid": 999,
  "first_uid": 1000,
  "last_uid": 59999,
  "first_gid": 1000,
  "last_gid": 59999,
  "usergroups": "yes",
  "dir_mode": "0700",
  "sys_dir_mode": "0755",
  "name_regex": "^[a-zA-Z][a-zA-Z0-9_-]*\\$?$",
  "sys_name_regex": "^[a-zA-Z_][a-zA-Z0-9_-]*\\$?$",
  "skel_ignore_regex": "\\\\.(dpkg|ucf)-(old|new|dist|save)$",
  "extra_groups": "users"
}
