# Server port(s) to listen on (comma-separated list; IPv6 addresses must be enclosed in brackets)
port = {{ port }}

# Number of worker threads (0 = auto-select based on CPU cores)
num_threads = {{ num_threads }}

# Root directory for web content
 DocumentRoot = {{ document_root }}

# Default index page(s) when directory is requested (comma-separated)
 index_files = {{ index_files | join(', ') }}

# Enable or disable directory listing (on/off)
 enable_directory_listing = {{ enable_directory_listing | lower }}

# Enable SSL support (on/off)
 ssl_certificate = {{ ssl_certificate }}

# Enable CGI support (on/off)
 enable_cgi = {{ enable_cgi | lower }}

# Path to CGI directory (ignored if enable_cgi=off)
 cgi_interpreter = {{ cgi_interpreter }}

# CGI extensions (space-separated list; e.g., .py .pl)
 cgi_patterns = {{ cgi_patterns | join(' ') }}

# Enable Lua scripting support (on/off)
 enable_lua = {{ enable_lua | lower }}

# Lua script path prefix (e.g., /lua/)
 lua_script_prefix = {{ lua_script_prefix }}

# Lua script directory (ignored if enable_lua=off)
 lua_script_dir = {{ lua_script_dir }}

# IP address to bind to (e.g., 0.0.0.0 for all, or 127.0.0.1 for localhost only)
 listening_ip = {{ listening_ip }}

# Set maximum request size in bytes (0 = no limit)
 max_request_size = {{ max_request_size }}

# Logging configuration
 access_log_file = {{ access_log_file }}
 error_log_file = {{ error_log_file }}

# Enable authentication (on/off)
 enable_auth = {{ enable_auth | lower }}

# Authentication realm
 auth_realm = {{ auth_realm }}

# User credentials file (if enable_auth=on)
 auth_file = {{ auth_file }}

# Extra configuration directives (one per line)
{% for line in extra_lines %}{{ line }}
{% endfor %}