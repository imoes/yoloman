{
  "port": "8080,8443",
  "num_threads": 4,
  "document_root": "/var/www/html",
  "index_files": [
    "index.html",
    "index.htm"
  ],
  "enable_directory_listing": true,
  "ssl_certificate": "/etc/ssl/certs/civetweb.pem",
  "enable_cgi": true,
  "cgi_interpreter": "/usr/bin/python3",
  "cgi_patterns": [
    ".py",
    ".sh"
  ],
  "enable_lua": false,
  "lua_script_prefix": "/lua/",
  "lua_script_dir": "/etc/civetweb/lua",
  "listening_ip": "0.0.0.0",
  "max_request_size": 10485760,
  "access_log_file": "/var/log/civetweb/access.log",
  "error_log_file": "/var/log/civetweb/error.log",
  "enable_auth": true,
  "auth_realm": "Admin Area",
  "auth_file": "/etc/civetweb/htpasswd",
  "extra_lines": [
    "add_header X-Content-Type-Options nosniff",
    "add_header X-Frame-Options DENY",
    "directory_index index.html index.php"
  ]
}
