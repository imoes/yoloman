{
  "global": {
    "Enabled": true,
    "Timeout": 45,
    "MaxConnections": 5,
    "AuthMethods": [
      "pap",
      "mschap-v2"
    ],
    "DNS": [
      "8.8.8.8",
      "8.8.4.4"
    ],
    "NTP": [
      "time.google.com"
    ],
    "IPv4RoutePrefix": "192.168.100.0/24",
    "IPv6RoutePrefix": "fd00::/64",
    "LogLevel": 3,
    "DataPath": "/var/lib/connman-vpn",
    "PluginPath": "/usr/lib/connman-vpn/plugins",
    "VerifyCertificate": true,
    "CAPath": "/etc/ssl/certs",
    "CAFile": "",
    "IPv6": true,
    "L2TPOverIPSec": true,
    "SSTP": false,
    "OpenVPN": true,
    "OpenVPNConfigDir": "/etc/connman-vpn/openvpn/client",
    "IKEv2": true,
    "EAPSIM": false
  },
  "plugins": [
    {
      "name": "l2tp",
      "config_lines": [
        "L2TPAuthType=MSCHAPV2",
        "L2TPMTU=1400",
        "L2TPRedialInterval=10",
        "L2TPRedialTimeout=30"
      ]
    },
    {
      "name": "openvpn",
      "config_lines": [
        "OpenVPNAutoStart=auto",
        "OpenVPNAllowLocalDNS=true",
        "OpenVPNRemoteCertTLS=server"
      ]
    },
    {
      "name": "ikev2",
      "config_lines": [
        "IKEv2EAPMethod=MSCHAPV2",
        "IKEv2Mobike=off"
      ]
    }
  ]
}
