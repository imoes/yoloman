# ==============================================================================
# This template configures the sqwebmaild daemon. It is self-documenting:
# every configuration directive is preceded by its schema description.
# All variables use safe defaults derived from the schema to prevent
# render failures when optional fields are omitted.
# ==============================================================================

##NAME: PIDFILE:0
#
# Path to the PID file for the sqwebmail daemon.
# Default: /run/courier/sqwebmaild.pid
#
PIDFILE={{ sqwebmail_pidfile | default('/run/courier/sqwebmaild.pid') }}

##NAME: DEBUG_LOGIN:0
#
# Debug level for login diagnostics.
# 0 = off
# 1 = on
# 2 = on + log passwords (use with caution)
# Default: 0
#
DEBUG_LOGIN={{ sqwebmail_debug_login | default('0') }}

##NAME: MAILDIRPATH:0
#
# Directory name of the maildir directory.
# This is appended to the user's home directory or mailbox root.
# Default: Maildir
#
MAILDIRPATH={{ sqwebmail_maildirpath | default('Maildir') }}

##NAME: SQWEBMAIL_PREFORK:0
#
# Override default number of pre-forked child processes, or set to 0
# to disable pre-forking.
# Note: This setting is not exposed in the current schema variables;
# it remains commented out to use the daemon's internal defaults.
#
# SQWEBMAIL_PREFORK=5

##NAME: AUTH_MKHOMEDIR_SKEL:0
#
# Uncomment this setting to automatically create a home directory on first
# login. if the AUTH_MKHOMEDIR_SKEL environment variable is set, and the
# home directory does not exist, the home directory gets created, with its
# initial contents copied from AUTH_MKHOMEDIR_SKEL which must be a directory,
# typically /etc/skel.
#
# Note that this must be a complete home directory structure, including
# the maildir. Typically:
#
# mkdir /etc/skel
# chmod 700 /etc/skel
# maildirmak /etc/skel/Maildir
#
# This directory gets copied as is, preserving each file/subdirectory's
# permissions, with only userid/groupid changed to match the account's.
#
# Note: This setting is not exposed in the current schema variables.

##NAME: LOGGEROPTS:0
#
# Courierlogger options, e.g. to set syslog facility.
# Default: "" (empty string)
#
LOGGEROPTS={{ sqwebmail_loggeropts | default('""') }}

##NAME: CRON_CLEANER:
#
# Configuration for the scheduled cache cleanup job.
# While not a runtime daemon setting, the cleaner_minute schema field
# determines when the cron job runs. This section documents that intent.
#
# To enable the cron job, ensure the system cron daemon is active and
# the sqwebmail package provides the cleaner script (usually
# /usr/lib/courier/sqwebmail/cleaner or similar).
#
# The cleaner runs at:
#   Minute: {{ sqwebmail_cache_clean_minute | default(16) }}
#   Hour:   *
#   Day:    *
#   Month:  *
#   DOW:    *
#
# Add the following to /etc/cron.d/sqwebmail if not present:
#   {{ sqwebmail_cache_clean_minute | default(16) }} * * * * root /usr/lib/courier/sqwebmail/cleaner > /dev/null 2>&1
