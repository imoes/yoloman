# SCIM-IM-Agent configuration file
# This service provides the SCIM Instant Messaging gateway agent.
# It manages the connection between SCIM-enabled IM clients and IM backends.

# Verbosity of debug output (0-9). 0 is quiet, 9 is verbose.
DebugLevel={{ debug_level | default(0) }}

# Comma-separated list of debug categories (agent, messenger, imcontext, scim).
DebugFlags={{ debug_flags | default('none') }}

# If true, prevents the agent from daemonizing itself.
# Note: The config key 'Daemon' is inverted relative to 'standalone'.
# standalone=true means "do not run as daemon", so Daemon=false.
Daemon={{ not (standalone | default(True)) }}

# If true, prevents the agent from exiting when there are no clients.
# When true, the agent stays resident even if no IM clients are connected.
NoExit={{ noexit | default(False) | lower }}