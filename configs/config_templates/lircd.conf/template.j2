# /etc/lirc/lircd.conf - LIRC daemon configuration file
# Automatically generated by LIRC setup tools
# Each line defines a remote control button mapping
# Format: <KEY_NAME> <SCAN_CODE> <PROTO> <BITS>
# See `man lircd.conf` for full syntax

# Global configuration
start_driver = {{ driver_name | default('default') }}
device = {{ device_path | default('/dev/lirc0') }}
driver = {{ driver_type | default('default') }}
hwtypes = {% for hwtype in hardware_types %}{{ hwtype }}{% if not loop.last %} {% endif %}{% endfor %}

# Remote-specific section
{% for remote in remotes %}
begin remote
  name  = {{ remote.name }}
  flags = {% for flag in remote.flags | default([]) %}{{ flag }}{% if not loop.last %} | {% endif %}{% endfor %}
  bits  = {{ remote.bits | default(32) }}
  eps   = {{ remote.eps | default(30) }}
  aeps  = {{ remote.aeps | default(100) }}
  gap   = {{ remote.gap | default(108000) }}

  # Raw timing codes (if using raw protocol)
  {% if remote.protocol == 'raw' %}
  raw_codes = {% for code in remote.raw_codes %}{{ code }}{% if not loop.last %} {% endif %}{% endfor %}
  {% endif %}

  # Button mappings
  begin codes
    {% for button in remote.buttons %}
{{ button.key_name | default('UNKNOWN') }} {{ button.scan_code }}
    {% endfor %}
  end codes

  # Raw timing entries (if applicable)
  {% if remote.raw_timings %}
  begin raw_codes
    {% for button in remote.buttons %}
{{ button.key_name | default('UNKNOWN') }} {% for t in button.raw_timings %}{{ t }}{% if not loop.last %} {% endif %}{% endfor %}
    {% endfor %}
  end raw_codes
  {% endif %}

end remote
{% endfor %}