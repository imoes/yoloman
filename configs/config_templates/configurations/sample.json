{
  "enabled": true,
  "uinput_path": "/dev/uinput",
  "log_level": "info",
  "default_grab_exclusive": true,
  "devices": [
    {
      "name": "Logitech Gaming Mouse G502",
      "phys": "usb-0000:00:14.0-5/input1",
      "enabled": true,
      "grab_exclusive": false,
      "mappings": [
        {
          "comment": "Map wheel tilt left to backward",
          "from": {
            "button": "BTN_SIDE"
          },
          "to": {
            "key": "KEY_BACK"
          }
        },
        {
          "comment": "Map extra forward button to forward",
          "from": {
            "button": "BTN_EXTRA"
          },
          "to": {
            "key": "KEY_FORWARD"
          }
        },
        {
          "comment": "Invert vertical scroll axis",
          "from": {
            "axis": "REL_WHEEL"
          },
          "to": {
            "axis": "REL_WHEEL",
            "invert": true
          }
        }
      ]
    },
    {
      "name": "Microsoft Microsoft\u00ae Digital Mouse",
      "enabled": false,
      "mappings": []
    }
  ],
  "stop_on_exit": true
}
