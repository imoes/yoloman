{
  "bind_address": "0.0.0.0",
  "web_port": 4545,
  "use_unix_socket": false,
  "unix_socket_path": "/run/goiardi/goiardi.sock",
  "db_host": "localhost",
  "db_port": 5432,
  "db_socket": "",
  "db_name": "goiardi",
  "db_user": "goiardi",
  "db_password": "secret123",
  "use_ssl": true,
  "ssl_cert_path": "/etc/goiardi/ssl/server.crt",
  "ssl_key_path": "/etc/goiardi/ssl/server.key",
  "ssl_ca_cert": "/etc/goiardi/ssl/ca.crt",
  "enable_opaques_auth": false,
  "ldap_url": "ldap://ldap.example.com",
  "ldap_binddn": "cn=reader,dc=example,dc=com",
  "ldap_bindpw": "bindpass",
  "ldap_user_filter": "(&(objectClass=person)(sAMAccountName={{ username }}))",
  "ldap_group_base": "OU=Groups,DC=example,DC=com",
  "ldap_group_filter": "(member={{ userdn }})",
  "file_backend": "filesystem",
  "file_root_path": "/var/lib/goiardi/files",
  "s3_bucket": "",
  "s3_region": "",
  "s3_access_key": "",
  "s3_secret_key": "",
  "log_level": "INFO",
  "log_file_path": "/var/log/goiardi/goiardi.log",
  "max_concurrent_uploads": 10,
  "max_nodes": 10000,
  "max_search_results": 500,
  "enable_metrics": true,
  "metrics_port": 9090,
  "text_search_enabled": true
}
