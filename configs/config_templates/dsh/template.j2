# Default configuration file for dsh (Dancer's Shell).
# This tool allows executing commands on multiple remote machines simultaneously.
# See `man dsh` for full documentation.

# -----------------------------------------------------------------------------
# Verbosity level for dsh output.
# 0 = silent, higher values = more verbose output.
verbose = {{ verbose | default(0) }}

# -----------------------------------------------------------------------------
# Remote shell command to use for connecting to remote hosts.
# Common values: 'ssh', 'rsh'.
remoteshell = {{ remoteshell | default('rsh') }}

# -----------------------------------------------------------------------------
# Whether to prefix output lines with the machine name.
# 0 = no prefix, 1 = prefix with hostname.
showmachinenames = {{ showmachinenames | default(0) }}

# -----------------------------------------------------------------------------
# Whether to wait for execution of remote commands to complete before proceeding.
# 0 = do not wait (fire-and-forget), 1 = wait for completion.
waitshell = {{ waitshell | default(1) }}