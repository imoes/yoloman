
#default configuration file for dsh.
  # suppled as part of dancer's shell

verbose = {{ verbose | default('0') }}

 remoteshell ={{ remoteshell | default('rsh') }}
 showmachinenames = {{ showmachinenames | default('0') }}
waitshell={{ waitshell | default('1  # whether to wait for execution') }}

{% if remoteshellopt is defined and remoteshellopt is not none and (remoteshellopt is number or remoteshellopt is boolean or remoteshellopt | length > 0) %}remoteshellopt={{ remoteshellopt }}
{% else %}#remoteshellopt=...
{% endif %}
# default config file end.
