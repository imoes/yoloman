# Boxbackup Client Synchronization Cron Job Configuration
# This template generates a cron entry for the boxbackup client to perform
# a synchronization with the backup server. The schedule is controlled by
# the variables defined below.

# Minute when the sync cron job runs (0-59, * for any)
{{ cron_minute | default('0') }}

# Hour when the sync cron job runs (0-23, * for any)
{{ cron_hour | default('0') }}

# Day(s) of the month when the sync cron job runs (1-31, * for any)
{{ cron_day_of_month | default('*') }}

# Month(s) when the sync cron job runs (1-12, * for any)
{{ cron_month | default('*') }}

# Day(s) of the week when the sync cron job runs (0-7, where 0 and 7 are Sunday, * for any)
{{ cron_day_of_week | default('*') }}

# Cron directive: user running the command
root

# Cron directive: command to execute
/usr/sbin/bbackupctl -q sync