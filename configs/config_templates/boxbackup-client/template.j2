# Box Backup Client Sync Schedule
# Configures the cron job for bbackupctl synchronization in snapshot mode.

# Minute(s) when the sync cron job runs (0-59, * for any)
{{ cron_minute | default('0') }}

# Hour(s) when the sync cron job runs (0-23, * for any)
{{ cron_hour | default('0') }}

# Day(s) of the month when the sync cron job runs (1-31, * for any)
{{ cron_day_of_month | default('*') }}

# Month(s) when the sync cron job runs (1-12, * for any)
{{ cron_month | default('*') }}

# Day(s) of the week when the sync cron job runs (0-7, where 0 and 7 are Sunday, * for any)
{{ cron_day_of_week | default('*') }} root /usr/sbin/bbackupctl -q sync
