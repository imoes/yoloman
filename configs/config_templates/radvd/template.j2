# radvd.conf - Router Advertisement Daemon configuration
#
# This file is managed by Ansible. Do not edit manually.
# See the radvd(8) man page for detailed syntax information.
#
# Structure:
#   interface <name> {
#       AdvSendAdverts on|off;
#       MinRtrAdvInterval ...;
#       MaxRtrAdvInterval ...;
#       HopLimit ...;
#       prefix <ipv6-prefix>/<length> { ... };
#       RDNSS <ipv6-address> ...;
#       DNSSL <search-domain> ...;
#	};

# Global defaults for all interfaces defined below.
# If not specified per-interface, these values apply.

# interface_name: Network interface on which to advertise router advertisements (e.g., 'eth0', 'wlan0').
# Defaults to 'eth0'.
interface {{ (interface_name | default('eth0')) }} {

    # send_advertisements: Enable or disable sending of router advertisements on this interface.
    # Defaults to True (on). Set to off to disable RA sending entirely on this interface.
    {% if send_advertisements | default(true) | bool %}
    AdvSendAdvert on;
    {% else %}
    AdvSendAdvert off;
    {% endif %}

    # min_interval / max_interval: seconds between unsolicited router advertisements (radvd.conf(5)
    # MinRtrAdvInterval / MaxRtrAdvInterval; radvd requires Min <= 0.75 * Max). The earlier template wrote
    # AdvIntervalMin/AdvIntervalMax and HopLimit — not radvd keywords: "syntax error", radvd refused the file.
{% if min_interval is defined and min_interval is not none and (min_interval is number or min_interval is boolean or min_interval | length > 0) %}    MinRtrAdvInterval {{ min_interval | default(3) }};{% else %}#	MinRtrAdvInterval 30;{% endif %}
    {% if max_interval is defined and max_interval is not none %}
{% if max_interval is defined and max_interval is not none and (max_interval is number or max_interval is boolean or max_interval | length > 0) %}    MaxRtrAdvInterval {{ max_interval }};{% else %}#	MaxRtrAdvInterval 100;{% endif %}
    {% else %}
    MaxRtrAdvInterval {{ [((min_interval | default(3)) * 4 / 3) | round(0, 'ceil') | int, 4] | max }};
    {% endif %}

    # hop_limit: the hop limit advertised to hosts (AdvCurHopLimit). Defaults to 64.
    AdvCurHopLimit {{ hop_limit | default(64) }};

    # prefixes: IPv6 prefixes to advertise — each {prefix, adv_valid_lifetime?, adv_preferred_lifetime?, adv_onlink?,
    # adv_autonomous?}. Every block in radvd.conf ends with "};" (radvd.conf(5)).
    {% for prefix_entry in (prefixes | default([])) %}
    prefix {{ prefix_entry.prefix | default('::/64') }}
    {
        {% if prefix_entry.adv_valid_lifetime is defined and prefix_entry.adv_valid_lifetime is not none %}AdvValidLifetime {{ prefix_entry.adv_valid_lifetime }};
        {% endif %}{% if prefix_entry.adv_preferred_lifetime is defined and prefix_entry.adv_preferred_lifetime is not none %}AdvPreferredLifetime {{ prefix_entry.adv_preferred_lifetime }};
        {% endif %}AdvOnLink {{ (prefix_entry.adv_onlink | default(true) | bool) | ternary('on', 'off') }};
        AdvAutonomous {{ (prefix_entry.adv_autonomous | default(true) | bool) | ternary('on', 'off') }};
    };
    {% endfor %}

    # route_descriptors: more-specific routes — each {prefix, lifetime?, priority? (low|medium|high)}.
    {% for route in (route_descriptors | default([])) %}
    route {{ route.prefix | default('::/0') }}
    {
        {% if route.lifetime is defined and route.lifetime is not none %}AdvRouteLifetime {{ route.lifetime }};
        {% endif %}AdvRoutePreference {{ route.priority | default('medium') }};
    };
    {% endfor %}

    # rdnss_list: recursive DNS servers — each an IPv6 address or {address, lifetime?}.
    {% for rdnss in (rdnss_list | default([])) %}
    RDNSS {{ rdnss.address if rdnss is mapping else rdnss }}
    {
        {% if rdnss is mapping and rdnss.lifetime is defined and rdnss.lifetime is not none %}AdvRDNSSLifetime {{ rdnss.lifetime }};
        {% endif %}
    };
    {% endfor %}

    # dnssl_list: DNS search domains.
    {% for domain in (dnssl_list | default([])) %}
    DNSSL {{ domain }}
    {
    };
    {% endfor %}
};
