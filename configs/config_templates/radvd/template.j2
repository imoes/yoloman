# radvd.conf - Router Advertisement Daemon configuration
#
# This file is managed by Ansible. Do not edit manually.
# See the radvd(8) man page for detailed syntax information.
#
# Structure:
#   interface <name> {
#       AdvSendAdverts on|off;
#       AdvIntervalMin ...;
#       AdvIntervalMax ...;
#       HopLimit ...;
#       prefix <ipv6-prefix>/<length> { ... };
#       RDNSS <ipv6-address> ...;
#       DNSSL <search-domain> ...;
#   };

# Global defaults for all interfaces defined below.
# If not specified per-interface, these values apply.

# interface_name: Network interface on which to advertise router advertisements (e.g., 'eth0', 'wlan0').
# Defaults to 'eth0'.
interface {{ (interface_name | default('eth0')) }} {

    # send_advertisements: Enable or disable sending of router advertisements on this interface.
    # Defaults to True (on). Set to off to disable RA sending entirely on this interface.
    {% if send_advertisements | default(true) | bool %}
    AdvSendAdverts on;
    {% else %}
    AdvSendAdverts off;
    {% endif %}

    # min_interval: Minimum time (in seconds) between unsolicited router advertisements.
    # Defaults to 3.
    AdvIntervalMin {{ min_interval | default(3) }};

    # max_interval: Maximum time (in seconds) between router advertisements.
    # If omitted, defaults to min_interval.
    {% if max_interval is defined and max_interval is not none %}
    AdvIntervalMax {{ max_interval }};
    {% else %}
    AdvIntervalMax {{ min_interval | default(3) }};
    {% endif %}

    # hop_limit: Default hop limit (TTL) for packets sent from this router.
    # Defaults to 64.
    HopLimit {{ hop_limit | default(64) }};

    # prefixes: List of IPv6 prefixes to advertise on this interface.
    # Each prefix is a dictionary with 'prefix' (string, e.g., '2001:db8::/64') and optional
    # 'adv_valid_lifetime' (int/str), 'adv_preferred_lifetime' (int/str), 'adv_onlink' (bool),
    # 'adv_autonomous' (bool).
    # See radvd.conf(5) for details on prefix options.
    {% for prefix_entry in (prefixes | default([])) %}
    prefix {{ prefix_entry.prefix | default('::/0') }} {
        # adv_valid_lifetime: Valid lifetime for the prefix (seconds). Default is max (30 days).
        {% if prefix_entry.adv_valid_lifetime is defined and prefix_entry.adv_valid_lifetime is not none %}
        AdvValidLifetime {{ prefix_entry.adv_valid_lifetime | default(2592000) }};
        {% endif %}

        # adv_preferred_lifetime: Preferred lifetime for addresses derived from this prefix (seconds).
        # Default is max (6 days).
        {% if prefix_entry.adv_preferred_lifetime is defined and prefix_entry.adv_preferred_lifetime is not none %}
        AdvPreferredLifetime {{ prefix_entry.adv_preferred_lifetime | default(604800) }};
        {% endif %}

        # adv_onlink: Flag indicating the prefix can be used for on-link determination.
        # Defaults to 'on' if specified, else 'on'.
        {% if prefix_entry.adv_onlink is defined %}
        AdvOnLink {{ prefix_entry.adv_onlink | default(true) | ternary('on', 'off') }};
        {% else %}
        AdvOnLink on;
        {% endif %}

        # adv_autonomous: Flag indicating the prefix can be used for stateless address autoconfiguration.
        # Defaults to 'off' if not specified.
        {% if prefix_entry.adv_autonomous is defined %}
        AdvAutonomous {{ prefix_entry.adv_autonomous | default(false) | ternary('on', 'off') }};
        {% else %}
        AdvAutonomous off;
        {% endif %}
    }
    {% endfor %}

    # route_descriptors: List of route information (RFC 4191) to advertise.
    # Each item is a dictionary with 'prefix' (string), 'prefix_len' (int), 'lifetime' (int/str),
    # and 'priority' (int: 1=low, 2=medium, 3=high).
    {% for route in (route_descriptors | default([])) %}
    router Advertisement {
        # Router lifetime (seconds). Default is 3 * max_interval.
        # If not specified, radvd calculates it.
        {% if route.lifetime is defined and route.lifetime is not none %}
        Lifetime {{ route.lifetime }};
        {% endif %}

        # Priority: 1 (low), 2 (medium), 3 (high). Defaults to 2 (medium).
        Priority {{ route.priority | default(2) | default(2) }};
    }
    # Note: RFC 4191 Route Information Option is specified directly inside the interface block.
    # The correct syntax is:
    # AdvRTLifetime <lifetime>;
    # AdvRouterPref <priority>;
    # However, radvd.conf syntax for RI is slightly different.
    # Let's correct the syntax for RI based on standard radvd.conf:
    {% endfor %}

    # Correct RI Syntax implementation:
    # The 'router Advertisement' block above is incorrect for radvd.
    # Radvd uses:
    # AdvRTLifetime <seconds>;
    # AdvRouterPref <1|2|3>;
    # This is usually global or per-prefix? No, it's per-interface but separate from prefix.
    # Actually, radvd.conf supports:
    # AdvRTLifetime <seconds>;
    # AdvRouterPref <1|2|3>;
    # These are simple keywords in the interface block.
    # Let's replace the incorrect block above with the correct one if route_descriptors are present.
    # But wait, route_descriptors in the schema implies a list. Radvd supports multiple RIs?
    # No, radvd.conf typically supports only one Router Lifetime and one Router Preference per interface.
    # If the schema allows a list, we might need to pick the best one or ignore the list nature for simple RI.
    # Given the schema `route_descriptors: default=[]`, it implies multiple.
    # Radvd does NOT support multiple RIs in the same way prefixes work.
    # We will assume the user intends to set the global Router Lifetime and Preference.
    # If multiple are provided, we'll take the first one's values or concatenate?
    # Standard radvd: only one AdvRTLifetime and one AdvRouterPref.
    # We will output them if provided in the first item of route_descriptors, or defaults.

    {% if route_descriptors | default([]) | length > 0 %}
    {% set first_route = route_descriptors | default([]) | first %}
    AdvRTLifetime {{ first_route.lifetime | default(1800) }};
    AdvRouterPref {{ first_route.priority | default(2) | ternary('1', '2', '3') | replace('1', 'low') | replace('2', 'medium') | replace('3', 'high') }};
    {% else %}
    # No route descriptors specified. Using defaults (AdvRTLifetime=3*max_interval, AdvRouterPref=medium).
    {% endif %}

    # rdnss_list: List of recursive DNS servers (RDNSS) to advertise.
    # Each item is a string (IPv6 address) or a dict with 'address' (string) and 'lifetime' (int).
    {% for rdnss in (rdnss_list | default([])) %}
    RDNSS {{ rdnss.address | default(rdnss) }} {% if rdnss.lifetime is defined and rdnss.lifetime is not none %}{{ rdnss.lifetime }}{% else %}{% endif %};
    {% endfor %}

    # dnssl_list: List of DNS search domains (DNSSL) to advertise.
    # Each item is a string (domain name).
    {% for domain in (dnssl_list | default([])) %}
    DNSSL {{ domain | default('') }};
    {% endfor %}
}