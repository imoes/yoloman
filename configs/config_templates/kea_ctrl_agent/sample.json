{
  "http_host": "192.168.1.10",
  "http_port": 8000,
  "user_file": "/etc/kea/kea-ctrl-agent-users.conf",
  "control_sockets": [
    {
      "name": "dhcp4",
      "type": "unix",
      "socket_type": "unix",
      "socket_name": "/var/lib/kea/dhcp4.ctl"
    },
    {
      "name": "dhcp6",
      "type": "unix",
      "socket_type": "unix",
      "socket_name": "/var/lib/kea/dhcp6.ctl"
    }
  ],
  "allow_from": [
    "127.0.0.1",
    "::1",
    "192.168.1.10"
  ],
  "log_level": "INFO",
  "log_output": "/var/log/kea/ctrl-agent.log",
  "log_debuglevel": 0
}
