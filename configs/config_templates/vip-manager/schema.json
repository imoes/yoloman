{
  "vip_ip": {
    "type": "string",
    "default": "10.1.2.3",
    "description": "IP address for the VIP"
  },
  "vip_mask": {
    "type": "number",
    "default": 24,
    "description": "Netmask for the IP address"
  },
  "vip_iface": {
    "type": "string",
    "default": "eth0",
    "description": "Primary network interface name"
  },
  "vip_key": {
    "type": "string",
    "default": "/service/batman/leader",
    "description": "Etcd/Consul key matching Patroni scope"
  },
  "vip_host": {
    "type": "string",
    "default": "serverX",
    "description": "Hostname for the VIP"
  },
  "vip_type": {
    "type": "string",
    "default": "etcd",
    "description": "Type of endpoint: etcd or consul",
    "enum": [
      "etcd",
      "consul"
    ]
  },
  "vip_endpoint": {
    "type": "string",
    "default": "http://10.1.2.3:2379",
    "description": "Endpoint URL for the service discovery backend"
  },
  "vip_hostingtype": {
    "type": "string",
    "default": "basic",
    "description": "Hosting type for the VIP"
  },
  "vip_etcd_user": {
    "type": "string",
    "default": "",
    "description": "Etcd username for authentication"
  },
  "vip_etcd_password": {
    "type": "string",
    "default": "",
    "description": "Etcd password for authentication"
  },
  "vip_etcd_ca_file": {
    "type": "string",
    "default": "/etc/etcd/ca.cert.pem",
    "description": "Path to Etcd CA certificate file"
  },
  "vip_etcd_cert_file": {
    "type": "string",
    "default": "/etc/etcd/host.cert.pem",
    "description": "Path to Etcd client certificate file"
  },
  "vip_etcd_key_file": {
    "type": "string",
    "default": "/etc/etcd/host.key.pem",
    "description": "Path to Etcd client key file"
  }
}
