# ==============================================================================
# vip-manager configuration template
# Self-documenting Jinja2 template for ansible-role-vip-manager
# ==============================================================================

# --- Mandatory Configuration Keys ---

# IP address for the VIP. Default: 10.1.2.3
#VIP_IP="{{ vip_ip | default('10.1.2.3') }}"

# Netmask for the IP address. Default: 24
#VIP_MASK={{ vip_mask | default(24) }}

# Primary network interface name. Default: eth0
#VIP_IFACE="{{ vip_iface | default('eth0') }}"

# Etcd/Consul key matching Patroni scope. Default: /service/batman/leader
# This must match scope from Patroni postgres.yml
#VIP_KEY="{{ vip_key | default('/service/batman/leader') }}"

# Hostname for the VIP. Default: serverX
# This value must match the value used in Patroni postgres.yml
#VIP_HOST="{{ vip_host | default('serverX') }}"

# Type of endpoint: etcd or consul. Default: etcd
# Specify the type of endpoint (etcd|consul)
#VIP_TYPE="{{ vip_type | default('etcd') }}"

# Endpoint URL for the service discovery backend. Default: http://10.1.2.3:2379
#VIP_ENDPOINT="{{ vip_endpoint | default('http://10.1.2.3:2379') }}"

# --- Optional Configuration Keys ---

# Hosting type for the VIP. Default: basic
#VIP_HOSTINGTYPE="{{ vip_hostingtype | default('basic') }}"

# Etcd username for authentication. Default: ''
#VIP_ETCD_USER={{ vip_etcd_user | default('') }}

# Etcd password for authentication. Default: ''
#VIP_ETCD_PASSWORD={{ vip_etcd_password | default('') }}

# These keys are optional if VIP_TYPE="etcd" is chosen

# Path to Etcd CA certificate file. Default: /etc/etcd/ca.cert.pem
#VIP_ETCD_CA_FILE="{{ vip_etcd_ca_file | default('/etc/etcd/ca.cert.pem') }}"

# Path to Etcd client certificate file. Default: /etc/etcd/host.cert.pem
#VIP_ETCD_CERT_FILE="{{ vip_etcd_cert_file | default('/etc/etcd/host.cert.pem') }}"

# Path to Etcd client key file. Default: /etc/etcd/host.key.pem
#VIP_ETCD_KEY_FILE="{{ vip_etcd_key_file | default('/etc/etcd/host.key.pem') }}"