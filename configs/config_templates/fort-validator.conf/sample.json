{
  "log_level": "info",
  "refresh_interval": 3600,
  "max_sessions": 10,
  "strict_mode": true,
  "max_chain_depth": 10,
  "tal_files": [
    "/etc/fort-validator/ta/afrinic.tal",
    "/etc/fort-validator/ta/arin.tal",
    "/etc/fort-validator/ta/ripe.tal"
  ],
  "repositories": [
    {
      "uri": "https://rpki.afrinic.net/repository/afrinic.tal",
      "name": "AFRINIC"
    },
    {
      "uri": "https://rpki.arin.net/repository/arin.tal",
      "name": "ARIN"
    },
    {
      "uri": "https://rpki.ripe.net/repository/ripe.tal",
      "name": "RIPE NCC"
    }
  ],
  "trust_anchors": [],
  "ca_repos": [],
  "cache_dir": "/var/cache/fort-validator",
  "http2_enabled": true,
  "timeouts": {
    "connect": 10,
    "read": 60,
    "write": 30
  },
  "rate_limits": [
    {
      "uri": "https://rpki.arin.net/repository/",
      "requests_per_minute": 120
    }
  ]
}
