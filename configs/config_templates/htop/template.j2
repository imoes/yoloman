# HTOP Configuration File
# Path: ~/.config/htop/htoprc
# Generated by Ansible Jinja2 template
#
# This file controls the runtime configuration of the htop process viewer.
# It corresponds to the 'Setup' menu options and command-line flags.

# --- Display Options ---

# Tree view mode (F5 toggle).
# Shows processes in a hierarchy rather than a flat list.
# Corresponds to: -t
{% if tree_view | default(false) is sameas true %}
tree_view=1
{% else %}
tree_view=0
{% endif %}

# Highlight new and old processes (H key).
# Visually distinguishes processes that appeared or disappeared since the last update.
# Corresponds to: --highlight-changes
{% if highlight_changes | default(false) is sameas true %}
highlight_changes=1
{% else %}
highlight_changes=0
{% endif %}

# Highlight the base name of the executable.
# Makes the command name in the USER column bold.
# Corresponds to: Display Options > Highlight base name
{% if highlight_base_name | default(true) is sameas true %}
highlight_base_name=1
{% else %}
highlight_base_name=0
{% endif %}

# Highlight deleted executables.
# Marks processes whose executable file has been deleted (red).
# Corresponds to: Display Options > Highlight deleted executables
{% if highlight_megabytes | default(false) is sameas true %}
highlight_megabytes=1
{% else %}
highlight_megabytes=0
{% endif %}

# Color scheme to use.
# Sets the visual theme (e.g., default, blackbox, linux).
# Corresponds to: Setup > Colors > Color Scheme
color_scheme={{ color_scheme | default('default') }}

# Delay between updates.
# Time in tenths of a second between screen refreshes (range 1-100).
# Corresponds to: -d
delay={{ delay | default(10) }}

# Kill process using niceness.
# When killing a process, allow adjusting its priority (niceness) first.
# Corresponds to: Setup > Display Options > Kill process using niceness
{% if kill_using_niceness | default(false) is sameas true %}
kill_using_niceness=1
{% else %}
kill_using_niceness=0
{% endif %}

# Detect CPU frequency automatically.
# Determines the CPU clock speed dynamically instead of using a static value.
# Corresponds to: Setup > Display Options > Detect CPU frequency
{% if detect_cpu_frequency | default(true) is sameas true %}
detect_cpu_frequency=1
{% else %}
detect_cpu_frequency=0
{% endif %}

# Hide kernel threads.
# Excludes kernel threads from the process list.
# Corresponds to: -K
{% if hide_kernel_threads | default(false) is sameas true %}
hide_kernel_threads=1
{% else %}
hide_kernel_threads=0
{% endif %}

# Hide userland threads.
# Excludes user-space threads from the process list.
# Corresponds to: -H
{% if hide_userland_threads | default(false) is sameas true %}
hide_userland_threads=1
{% else %}
hide_userland_threads=0
{% endif %}

# Highlight column headers.
# Makes the header row bold for better readability.
# Corresponds to: Setup > Display Options > Highlight column headers
{% if highlight_column_headers | default(true) is sameas true %}
highlight_column_headers=1
{% else %}
highlight_column_headers=0
{% endif %}

# --- Columns & Display ---

# Show full paths to running programs.
# Displays the absolute path in the COMMAND column.
# Corresponds to: -p
{% if show_program_path | default(false) is sameas true %}
show_program_path=1
{% else %}
show_program_path=0
{% endif %}

# Show thread names.
# Displays the name of individual threads instead of just the process.
# Corresponds to: Setup > Columns > Thread name
{% if show_thread_name | default(false) is sameas true %}
show_thread_name=1
{% else %}
show_thread_name=0
{% endif %}

# Show program arguments.
# Displays the full command line arguments in the COMMAND column.
# Corresponds to: Setup > Columns > Command line
{% if show_program_args | default(false) is sameas true %}
show_program_args=1
{% else %}
show_program_args=0
{% endif %}

# Merge exe, comm, and cmdline in Command column.
# Consolidates the process identifier into a single column.
# Corresponds to: m
{% if show_merged_command | default(false) is sameas true %}
show_merged_command=1
{% else %}
show_merged_command=0
{% endif %}

# --- Filtering ---

# Hide processes by mask.
# Hides processes matching certain criteria (advanced).
# Corresponds to: Setup > Display Options > Hide process by mask
{% if hide_program_by_mask | default(false) is sameas true %}
hide_program_by_mask=1
{% else %}
hide_program_by_mask=0
{% endif %}

# Show only processes of a given user.
# Filters the list to show only processes owned by the specified user.
# Empty string means no filter (show all).
# Corresponds to: -u
user_filter={{ user_filter | default('') }}

# Filter by capabilities.
# If enabled, uses capability_filter to restrict visible processes.
# Corresponds to: Setup > Display Options > Filter by capabilities
{% if filter_by_capabilities | default(false) is sameas true %}
filter_by_capabilities=1
{% else %}
filter_by_capabilities=0
{% endif %}

# Mask for capabilities filter.
# The specific capability bitmask to use when filtering.
capability_filter={{ capability_filter | default('') }}

# --- Cgroups ---

# Preferred cgroup display mode.
# 0: Disabled, 1: Cgroup name, 2: Cgroup path.
preferred_cgroup_mode={{ preferred_cgroup_mode | default(0) }}

# --- Sorting ---

# Column to sort by.
# Determines which column defines the primary sort order.
# Common values: PID, USER, PERCENT_CPU, PERCENT_MEM, TIME, COMMAND.
sort_key={{ sort_key | default('PERCENT_CPU') }}

# Sort direction.
# 0: Increasing, 1: Decreasing.
# Corresponds to: I key toggle
sort_direction={{ sort_direction | default(1) }}

# --- Columns Layout ---

# List of column names to display in the process list.
# Valid keys: PID, USER, PRI, NI, VIRT, RES, STATE, PERCENT_CPU, PERCENT_MEM, TIME, COMMAND, etc.
# These are joined into a comma-separated string for the config file.
fields={{ fields | default(['PID', 'USER', 'PRI', 'NI', 'VIRT', 'RES', 'STATE', 'PERCENT_CPU', 'PERCENT_MEM', 'TIME', 'COMMAND']) | join(',') }}

# --- Meters (CPU/Memory) ---

# Number of CPUs to display in meters.
# 1: Total CPU usage meter, >1: Individual core meters.
# Corresponds to: Setup > Meters > CPU
cpu_count={{ cpu_count | default(1) }}

# How to display CPU usage in meters.
# Options: Total, per-core, or specific core index.
cpu_display={{ cpu_display | default('Total') }}

# CPU frequency override in MHz.
# 0: Auto-detect from the system.
cpu_frequency={{ cpu_frequency | default(0) }}

# Memory units for display.
# 0: KiB, 1: MiB, 2: GiB.
# Corresponds to: Setup > Display Options > Memory units
memory_units={{ memory_units | default(0) }}

# I/O rate units.
# 0: KiB, 1: MiB, 2: GiB.
# Corresponds to: Setup > Display Options > I/O rate units
io_rate_units={{ io_rate_units | default(0) }}

# Clock format string.
# Standard strftime format.
# Corresponds to: Setup > Display Options > Clock format
clock_format={{ clock_format | default('%H:%M:%S') }}

# --- Screen Tabs ---

# List of tab names to display in the top header.
# Default layout: Left (summary), Center (cpu/memory), Right (tasks/load).
tabs={{ tabs | default(['Left', 'Center', 'Right']) | join(',') }}