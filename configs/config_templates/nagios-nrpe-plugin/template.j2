# The full path to the check_nrpe binary.
# Default: /usr/lib/nagios/plugins/check_nrpe
{% set _nrpe_plugin_path = nrpe_plugin_path | default('/usr/lib/nagios/plugins/check_nrpe') %}

# Command definition for NRPE checks using SSL/TLS encryption.
# This command runs the check_nrpe binary against the remote host.
define command {
    command_name	check_nrpe
    # Executes the check_nrpe binary (-H host, -c command_to_run).
    # SSL is enabled by default for secure communication.
    command_line	{{ _nrpe_plugin_path }} -H $HOSTADDRESS$ -c $ARG1$
}

# Command definition for NRPE checks without SSL/TLS.
# Use this only on trusted networks or for testing, as credentials/data are sent in plaintext.
define command {
    command_name	check_nrpe_nossl
    # Executes the check_nrpe binary with the -n flag to disable SSL.
    command_line	{{ _nrpe_plugin_path }} -H $HOSTADDRESS$ -c $ARG1$ -n
}
