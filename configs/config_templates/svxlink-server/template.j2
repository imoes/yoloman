###############################################################################
#
#                Configuration file for the SvxLink server
#
###############################################################################

[GLOBAL]
# Path to SvxLink modules.
#MODULE_PATH=/usr/lib/x86_64-linux-gnu/svxlink
# Path to core logic libraries.
LOGIC_CORE_PATH=/usr/lib/x86_64-linux-gnu/svxlink
# Comma-separated list of logic instances to load.
LOGICS={{ svxlink_logics | default('SimplexLogic') }}
# Directory containing additional configuration files.
CFG_DIR={{ svxlink_cfg_dir | default('svxlink.d') }}
# Timestamp format for log entries.
TIMESTAMP_FORMAT="%c"
# Audio card sample rate in Hz.
CARD_SAMPLE_RATE={{ svxlink_card_sample_rate | default('48000') }}
#CARD_CHANNELS=1
#LOCATION_INFO=LocationInfo
#LINKS=LinkToR4

[SimplexLogic]
TYPE=Simplex
RX=Rx1
TX=Tx1
MODULES=ModuleHelp,ModuleParrot,ModuleEchoLink,ModuleTclVoiceMail
CALLSIGN={{ svxlink_callsign | default('MYCALL') }}
# Interval in seconds for short identification in SimplexLogic.
SHORT_IDENT_INTERVAL={{ svxlink_simplex_short_ident_interval | default(60) }}
# Interval in seconds for long identification in SimplexLogic.
LONG_IDENT_INTERVAL={{ svxlink_simplex_long_ident_interval | default('60') }}
#IDENT_ONLY_AFTER_TX=4
#EXEC_CMD_ON_SQL_CLOSE=500
EVENT_HANDLER=/usr/share/svxlink/events.tcl
DEFAULT_LANG=en_US
RGR_SOUND_DELAY=0
#RGR_SOUND_ALWAYS=0
# CTCSS frequency for reporting in SimplexLogic.
REPORT_CTCSS={{ svxlink_simplex_report_ctcss | default('136.5') }}
#TX_CTCSS=ALWAYS
MACROS=Macros
FX_GAIN_NORMAL=0
FX_GAIN_LOW=-12
#ACTIVATE_MODULE_ON_LONG_CMD=4:EchoLink
#QSO_RECORDER=8:QsoRecorder
#ONLINE_CMD=998877
#ONLINE=1
#MUTE_RX_ON_TX=1
#MUTE_TX_ON_RX=1
#STATE_PTY=/var/run/svxlink/state
#DTMF_CTRL_PTY=/dev/shm/simplex_dtmf_ctrl
#CTCSS_TO_TG=77.0:999,123.0:9990,146.2:9992
#CTCSS_TO_TG_DELAY=1000

[RepeaterLogic]
TYPE=Repeater
RX=Rx1
TX=Tx1
MODULES=ModuleHelp,ModuleParrot,ModuleEchoLink,ModuleTclVoiceMail
CALLSIGN={{ svxlink_callsign | default('MYCALL') }}
# Interval in seconds for short identification in RepeaterLogic.
SHORT_IDENT_INTERVAL={{ svxlink_repeater_short_ident_interval | default(10) }}
# Interval in seconds for long identification in RepeaterLogic.
LONG_IDENT_INTERVAL={{ svxlink_repeater_long_ident_interval | default('60') }}
#IDENT_ONLY_AFTER_TX=4
#EXEC_CMD_ON_SQL_CLOSE=500
EVENT_HANDLER=/usr/share/svxlink/events.tcl
DEFAULT_LANG=en_US
RGR_SOUND_DELAY=0
# CTCSS frequency for reporting in RepeaterLogic.
REPORT_CTCSS={{ svxlink_repeater_report_ctcss | default('136.5') }}
#TX_CTCSS=SQL_OPEN
MACROS=Macros
#SEL5_MACRO_RANGE=03400,03499
FX_GAIN_NORMAL=0
FX_GAIN_LOW=-12
#QSO_RECORDER=8:QsoRecorder
#NO_REPEAT=1
# Idle timeout in seconds for RepeaterLogic.
IDLE_TIMEOUT={{ svxlink_repeater_idle_timeout | default('30') }}
# Delay in ms to open repeater on 1750Hz tone.
OPEN_ON_1750={{ svxlink_repeater_open_on_1750 | default('1000') }}
#OPEN_ON_CTCSS=1000
#OPEN_ON_DTMF=*
#OPEN_ON_SQL=5000
#OPEN_ON_SEL5=01234
#OPEN_SQL_FLANK=OPEN
#OPEN_ON_SQL_AFTER_RPT_CLOSE=10
# Interval in ms between idle sounds.
IDLE_SOUND_INTERVAL={{ svxlink_repeater_idle_sound_interval | default('3000') }}
#SQL_FLAP_SUP_MIN_TIME=1000
#SQL_FLAP_SUP_MAX_COUNT=10
#ACTIVATE_MODULE_ON_LONG_CMD=4:EchoLink
#IDENT_NAG_TIMEOUT=15
#IDENT_NAG_MIN_TIME=2000
#ONLINE_CMD=998877
#ONLINE=1
#STATE_PTY=/var/run/svxlink/state
#DTMF_CTRL_PTY=/dev/shm/repeater_dtmf_ctrl
#CTCSS_TO_TG=77.0:999,123.0:9990,146.2:9992
#CTCSS_TO_TG_DELAY=0

[ReflectorLogic]
TYPE=Reflector
#DNS_DOMAIN=example.com
# Comma-separated list of reflector hosts.
HOSTS={{ svxlink_reflector_hosts | default('reflector-primary.example.org,reflector-secondary.example.org:5301') }}
#HOST_PORT=5300
#HOST_PRIO=100
#HOST_PRIO_INC=1
#HOST_WEIGHT=10
CALLSIGN="{{ svxlink_callsign | default('MYCALL') }}"
# Authentication key for reflector connections.
AUTH_KEY="{{ svxlink_reflector_auth_key | default('Change this key now!') }}"
#JITTER_BUFFER_DELAY=0
#DEFAULT_TG=999
#MONITOR_TGS=99901,99902,99903
#TG_SELECT_TIMEOUT=30
#TG_SELECT_INHIBIT_TIMEOUT=0
# Minimum interval in seconds between remote announcements.
ANNOUNCE_REMOTE_MIN_INTERVAL={{ svxlink_reflector_announce_remote_min_interval | default('300') }}
EVENT_HANDLER=/usr/share/svxlink/events.tcl
#NODE_INFO_FILE=/etc/svxlink/node_info.json
#MUTE_FIRST_TX_LOC=1
#MUTE_FIRST_TX_REM=1
#TMP_MONITOR_TIMEOUT=3600
#UDP_HEARTBEAT_INTERVAL=15
# Timeout in seconds for QSY pending state.
QSY_PENDING_TIMEOUT={{ svxlink_reflector_qsy_pending_timeout | default('15') }}
#DEFAULT_LANG=en_US
#VERBOSE=1

[LinkToR4]
# Comma-separated list of logic connections for LinkToR4.
CONNECT_LOGICS={{ svxlink_link_to_r4_connect_logics | default('RepeaterLogic:94:SK3AB,SimplexLogic:92:SK3CD') }}
#DEFAULT_ACTIVE=1
# Timeout in seconds for LinkToR4.
TIMEOUT={{ svxlink_link_to_r4_timeout | default('300') }}
#ACTIVATE_ON_ACTIVITY=RepeaterLogic

[Macros]
1=EchoLink:9999#
9=Parrot:0123456789#
03400=EchoLink:9999#

[QsoRecorder]
# Directory for QSO recorder recordings.
REC_DIR={{ svxlink_qso_recorder_rec_dir | default('/var/spool/svxlink/qso_recorder') }}
#MIN_TIME=1000
# Maximum recording time in seconds.
MAX_TIME={{ svxlink_qso_recorder_max_time | default('3600') }}
# Soft timeout in seconds for QSO recorder.
SOFT_TIME={{ svxlink_qso_recorder_soft_time | default('300') }}
# Maximum directory size in MB for QSO recorder.
MAX_DIRSIZE={{ svxlink_qso_recorder_max_dirsize | default('1024') }}
#DEFAULT_ACTIVE=1
#TIMEOUT=300
#QSO_TIMEOUT=300
#ENCODER_CMD=/usr/bin/oggenc -Q \"%f\" && rm \"%f\"

[Voter]
TYPE=Voter
RECEIVERS=Rx1,Rx2,Rx3
# Voting delay in milliseconds.
VOTING_DELAY={{ svxlink_voter_voting_delay | default('200') }}
BUFFER_LENGTH=0
#REVOTE_INTERVAL=1000
#HYSTERESIS=50
#SQL_CLOSE_REVOTE_DELAY=500
#RX_SWITCH_DELAY=500
#COMMAND_PTY=/dev/shm/voter_ctrl
#VERBOSE=1

[MultiTx]
TYPE=Multi
TRANSMITTERS=Tx1,Tx2,Tx3

[NetRx]
TYPE=Net
# Host for NetRx connection.
HOST={{ svxlink_net_rx_host | default('remote.rx.host') }}
# TCP port for NetRx connection.
TCP_PORT={{ svxlink_net_rx_tcp_port | default('5210') }}
#LOG_DISCONNECTS_ONCE=0
# Authentication key for NetRx.
AUTH_KEY="{{ svxlink_net_rx_auth_key | default('Change this key now!') }}"
CODEC=S16
#SPEEX_ENC_FRAMES_PER_PACKET=4
#SPEEX_ENC_QUALITY=4
#SPEEX_ENC_BITRATE=15000
#SPEEX_ENC_COMPLEXITY=2
#SPEEX_ENC_VBR=0
#SPEEX_ENC_VBR_QUALITY=4
#SPEEX_ENC_ABR=15000
#SPEEX_DEC_ENHANCER=1
#OPUS_ENC_FRAME_SIZE=20
#OPUS_ENC_COMPLEXITY=10
#OPUS_ENC_BITRATE=20000
#OPUS_ENC_VBR=1

[NetTx]
TYPE=Net
#TX_ID=T
# Host for NetTx connection.
HOST={{ svxlink_net_tx_host | default('remote.tx.host') }}
# TCP port for NetTx connection.
TCP_PORT={{ svxlink_net_tx_tcp_port | default('5210') }}
#LOG_DISCONNECTS_ONCE=0
# Authentication key for NetTx.
AUTH_KEY="{{ svxlink_net_tx_auth_key | default('Change this key now!') }}"
CODEC=S16
#SPEEX_ENC_FRAMES_PER_PACKET=4
#SPEEX_ENC_QUALITY=4
#SPEEX_ENC_BITRATE=15000
#SPEEX_ENC_COMPLEXITY=2
#SPEEX_ENC_VBR=0
#SPEEX_ENC_VBR_QUALITY=4
#SPEEX_ENC_ABR=15000
#SPEEX_DEC_ENHANCER=1
#OPUS_ENC_FRAME_SIZE=20
#OPUS_ENC_COMPLEXITY=10
#OPUS_ENC_BITRATE=20000
#OPUS_ENC_VBR=1

[Rx1]
TYPE=Local
#RX_ID=?
AUDIO_DEV=alsa:plughw:0
AUDIO_CHANNEL=0
#AUDIO_DEV_KEEP_OPEN=0
LIMITER_THRESH=-6
SQL_DET=VOX
SQL_START_DELAY=0
SQL_DELAY=0
# SQL hang time in milliseconds for Rx1.
SQL_HANGTIME={{ svxlink_rx1_sql_hangtime | default('2000') }}
#SQL_EXTENDED_HANGTIME=1000
#SQL_EXTENDED_HANGTIME_THRESH=15
#SQL_TIMEOUT=600
# VOX filter depth for Rx1.
VOX_FILTER_DEPTH={{ svxlink_rx1_vox_filter_depth | default('20') }}
# VOX threshold for Rx1.
VOX_THRESH={{ svxlink_rx1_vox_thresh | default('1000') }}
#CTCSS_MODE=2
# CTCSS frequency for Rx1.
CTCSS_FQ={{ svxlink_rx1_ctcss_fq | default('136.5') }}
#CTCSS_SNR_OFFSET=0
#CTCSS_SNR_OFFSETS=88.5:-1.0,136.5:-0.5
#CTCSS_OPEN_THRESH=15
#CTCSS_CLOSE_THRESH=9
#CTCSS_BPF_LOW=60
#CTCSS_BPF_HIGH=270
#CTCSS_EMIT_TONE_DETECTED=0
# Serial port for Rx1.
SERIAL_PORT={{ svxlink_rx1_serial_port | default('/dev/ttyS0') }}
# Serial pin for Rx1.
SERIAL_PIN={{ svxlink_rx1_serial_pin | default('CTS') }}
#SERIAL_SET_PINS=DTR!RTS
#EVDEV_DEVNAME=/dev/input/by-id/usb-SYNIC_SYNIC_Wireless_Audio-event-if03
#EVDEV_OPEN=1,163,1
#EVDEV_CLOSE=1,163,0
#GPIO_PATH=/sys/class/gpio
#GPIO_SQL_PIN=gpio30
#SQL_GPIOD_CHIP=gpiochip0
#SQL_GPIOD_LINE=22
#SQL_GPIOD_BIAS=PULLDOWN
#PTY_PATH=/tmp/rx1_sql
#HID_DEVICE=/dev/hidraw3
#HID_SQL_PIN=VOL_UP
#SIGLEV_DET=TONE
# Signal level slope for Rx1.
SIGLEV_SLOPE={{ svxlink_rx1_siglev_slope | default('1') }}
# Signal level offset for Rx1.
SIGLEV_OFFSET={{ svxlink_rx1_siglev_offset | default('0') }}
#SIGLEV_BOGUS_THRESH=120
#TONE_SIGLEV_MAP=100,84,60,50,37,32,28,23,19,8
# SQL signal level open threshold for Rx1.
SQL_SIGLEV_OPEN_THRESH={{ svxlink_rx1_sql_siglev_open_thresh | default('30') }}
# SQL signal level close threshold for Rx1.
SQL_SIGLEV_CLOSE_THRESH={{ svxlink_rx1_sql_siglev_close_thresh | default('10') }}
DEEMPHASIS=0
#SQL_TAIL_ELIM=300
#PREAMP=6
PEAK_METER=1
DTMF_DEC_TYPE=INTERNAL
DTMF_MUTING=1
# DTMF hang time in milliseconds for Rx1.
DTMF_HANGTIME={{ svxlink_rx1_dtmf_hangtime | default('40') }}
# Serial port for DTMF in Rx1.
DTMF_SERIAL={{ svxlink_rx1_dtmf_serial | default('/dev/ttyS0') }}
#DTMF_PTY=/tmp/rx1_dtmf
#DTMF_MAX_FWD_TWIST=8
#DTMF_MAX_REV_TWIST=4
#1750_MUTING=1
#SEL5_DEC_TYPE=INTERNAL
#SEL5_TYPE=ZVEI1
#LADSPA_PLUGINS=hpf:1000
#FQ=433475000
#MODULATION=FM
#WBRX=WbRx1
#OB_AFSK_ENABLE=0
#OB_AFSK_VOICE_GAIN=6
#IB_AFSK_ENABLE=0

[WbRx1]
#TYPE=RtlUsb
#DEV_MATCH=0
#HOST=localhost
#PORT=1234
#CENTER_FQ=435075000
#FQ_CORR=0
#GAIN=0
#PEAK_METER=1
#SAMPLE_RATE=960000

[Tx1]
TYPE=Local
TX_ID=T
AUDIO_DEV=alsa:plughw:0
AUDIO_CHANNEL=0
#AUDIO_DEV_KEEP_OPEN=0
LIMITER_THRESH=-6
# PTT type for Tx1.
PTT_TYPE={{ svxlink_tx1_ptt_type | default('NONE') }}
# PTT port for Tx1.
PTT_PORT={{ svxlink_tx1_ptt_port | default('/dev/ttyS0') }}
# PTT pin for Tx1.
PTT_PIN={{ svxlink_tx1_ptt_pin | default('DTRRTS') }}
#HID_DEVICE=/dev/hidraw3
#HID_PTT_PIN=GPIO3
#SERIAL_SET_PINS=DTR!RTS
#GPIO_PATH=/sys/class/gpio
#PTT_GPIOD_CHIP=gpiochip0
#PTT_GPIOD_LINE=17
#PTT_HANGTIME=1000
#TIMEOUT=300
# TX delay in milliseconds for Tx1.
TX_DELAY={{ svxlink_tx1_tx_delay | default('500') }}
#CTCSS_FQ=136.5
#CTCSS_LEVEL=-24
PREEMPHASIS=0
# DTMF tone length in milliseconds for Tx1.
DTMF_TONE_LENGTH={{ svxlink_tx1_dtmf_tone_length | default('100') }}
# DTMF tone spacing in milliseconds for Tx1.
DTMF_TONE_SPACING={{ svxlink_tx1_dtmf_tone_spacing | default('50') }}
# DTMF digit power in dB for Tx1.
DTMF_DIGIT_PWR={{ svxlink_tx1_dtmf_digit_pwr | default('-15') }}
#MASTER_GAIN=0.0
#OB_AFSK_ENABLE=0
#OB_AFSK_VOICE_GAIN=-6
#OB_AFSK_LEVEL=-12
#OB_AFSK_TX_DELAY=100
#IB_AFSK_ENABLE=0
#IB_AFSK_LEVEL=-6
#IB_AFSK_TX_DELAY=100

[LocationInfo]
# APRS server list for LocationInfo.
APRS_SERVER_LIST={{ svxlink_location_info_aprs_server_list | default('euro.aprs2.net:14580') }}
#STATUS_SERVER_LIST=aprs.echolink.org:5199
#LON_POSITION=12.10.00E
#LAT_POSITION=51.10.00N
#CALLSIGN=EL-DL0ABC
#FREQUENCY=438.875
#TX_POWER=8
#ANTENNA_GAIN=6
#ANTENNA_HEIGHT=20m
#ANTENNA_DIR=-1
# APRS path for LocationInfo.
PATH={{ svxlink_location_info_path | default('WIDE1-1') }}
# Beacon interval in minutes for LocationInfo.
BEACON_INTERVAL={{ svxlink_location_info_beacon_interval | default('10') }}
#TONE=136
COMMENT=SvxLink by SM0SVX (www.svxlink.org)
