<?xml version="1.0" encoding="UTF-8"?>
<!--
  NX Agent RedHat Keystroke Configuration Template
  ================================================
  This template generates the XML configuration for nxagent's custom
  keystroke mappings. Each block defines a specific action (e.g., close session,
  switch screens, viewports) along with its associated modifier keys (Control,
  Shift, AltMeta) and the primary key.

  All variables use the `default()` filter to ensure safe rendering even if
  not explicitly provided in the Ansible playbook.
-->

<!DOCTYPE NXKeystroke>
<keystrokes>
  <!--
    Action: Close Session
    Description: Keystroke combination to terminate the current NX session.
    Modifiers:
      - Control: {{ close_session_control | default('1') }}
      - AltMeta: {{ close_session_altmeta | default('1') }}
    Key: {{ close_session_key | default('t') }}
  -->
  <keystroke
    action="close_session"
    Control="{{ close_session_control | default('1') }}"
    AltMeta="{{ close_session_altmeta | default('1') }}"
    key="{{ close_session_key | default('t') }}"
  />

  <!--
    Action: Switch All Screens
    Description: Keystroke combination to toggle visibility across all virtual screens.
    Modifiers:
      - Control: {{ switch_all_screens_control | default('1') }}
      - AltMeta: {{ switch_all_screens_altmeta | default('1') }}
    Key: {{ switch_all_screens_key | default('f') }}
  -->
  <keystroke
    action="switch_all_screens"
    Control="{{ switch_all_screens_control | default('1') }}"
    AltMeta="{{ switch_all_screens_altmeta | default('1') }}"
    key="{{ switch_all_screens_key | default('f') }}"
  />

  <!--
    Action: Fullscreen
    Description: Keystroke combination to toggle the fullscreen mode.
    Modifiers:
      - Control: {{ fullscreen_control | default('1') }}
      - Shift: {{ fullscreen_shift | default('1') }}
      - AltMeta: {{ fullscreen_altmeta | default('1') }}
    Key: {{ fullscreen_key | default('f') }}
  -->
  <keystroke
    action="fullscreen"
    Control="{{ fullscreen_control | default('1') }}"
    Shift="{{ fullscreen_shift | default('1') }}"
    AltMeta="{{ fullscreen_altmeta | default('1') }}"
    key="{{ fullscreen_key | default('f') }}"
  />

  <!--
    Action: Minimize
    Description: Keystroke combination to minimize the current window.
    Modifiers:
      - Control: {{ minimize_control | default('1') }}
      - AltMeta: {{ minimize_altmeta | default('1') }}
    Key: {{ minimize_key | default('m') }}
  -->
  <keystroke
    action="minimize"
    Control="{{ minimize_control | default('1') }}"
    AltMeta="{{ minimize_altmeta | default('1') }}"
    key="{{ minimize_key | default('m') }}"
  />

  <!--
    Action: Defer
    Description: Keystroke combination to defer/suspend current operations.
    Modifiers:
      - Control: {{ defer_control | default('1') }}
      - AltMeta: {{ defer_altmeta | default('1') }}
    Key: {{ defer_key | default('e') }}
  -->
  <keystroke
    action="defer"
    Control="{{ defer_control | default('1') }}"
    AltMeta="{{ defer_altmeta | default('1') }}"
    key="{{ defer_key | default('e') }}"
  />

  <!--
    Action: Force Synchronization
    Description: Keystroke combination to force a sync of the display.
    Modifiers:
      - Control: {{ force_synchronization_control | default('1') }}
      - AltMeta: {{ force_synchronization_altmeta | default('1') }}
    Key: {{ force_synchronization_key | default('j') }}
  -->
  <keystroke
    action="force_synchronization"
    Control="{{ force_synchronization_control | default('1') }}"
    AltMeta="{{ force_synchronization_altmeta | default('1') }}"
    key="{{ force_synchronization_key | default('j') }}"
  />

  <!--
    Action: Resize
    Description: Keystroke combination to trigger window resize operations.
    Modifiers:
      - Control: {{ resize_control | default('1') }}
      - AltMeta: {{ resize_altmeta | default('1') }}
    Key: {{ resize_key | default('r') }}
  -->
  <keystroke
    action="resize"
    Control="{{ resize_control | default('1') }}"
    AltMeta="{{ resize_altmeta | default('1') }}"
    key="{{ resize_key | default('r') }}"
  />

  <!--
    Action: Viewport Move Left (Primary)
    Description: Moves the viewport to the left.
    Modifiers:
      - Control: {{ viewport_move_left_control | default('1') }}
      - Shift: {{ viewport_move_left_shift | default('1') }}
      - AltMeta: {{ viewport_move_left_altmeta | default('1') }}
    Key: {{ viewport_move_left_key | default('Left') }}
  -->
  <keystroke
    action="viewport_move_left"
    Control="{{ viewport_move_left_control | default('1') }}"
    Shift="{{ viewport_move_left_shift | default('1') }}"
    AltMeta="{{ viewport_move_left_altmeta | default('1') }}"
    key="{{ viewport_move_left_key | default('Left') }}"
  />

  <!--
    Action: Viewport Move Left (Secondary)
    Description: Secondary keybinding for moving the viewport left.
    Modifiers:
      - Control: {{ viewport_move_left_control_2 | default('1') }}
      - Shift: {{ viewport_move_left_shift_2 | default('1') }}
      - AltMeta: {{ viewport_move_left_altmeta_2 | default('1') }}
    Key: {{ viewport_move_left_key_2 | default('KP_Left') }}
  -->
  <keystroke
    action="viewport_move_left"
    Control="{{ viewport_move_left_control_2 | default('1') }}"
    Shift="{{ viewport_move_left_shift_2 | default('1') }}"
    AltMeta="{{ viewport_move_left_altmeta_2 | default('1') }}"
    key="{{ viewport_move_left_key_2 | default('KP_Left') }}"
  />

  <!--
    Action: Viewport Move Up (Primary)
    Description: Moves the viewport up.
    Modifiers:
      - Control: {{ viewport_move_up_control | default('1') }}
      - Shift: {{ viewport_move_up_shift | default('1') }}
      - AltMeta: {{ viewport_move_up_altmeta | default('1') }}
    Key: {{ viewport_move_up_key | default('Up') }}
  -->
  <keystroke
    action="viewport_move_up"
    Control="{{ viewport_move_up_control | default('1') }}"
    Shift="{{ viewport_move_up_shift | default('1') }}"
    AltMeta="{{ viewport_move_up_altmeta | default('1') }}"
    key="{{ viewport_move_up_key | default('Up') }}"
  />

  <!--
    Action: Viewport Move Up (Secondary)
    Description: Secondary keybinding for moving the viewport up.
    Modifiers:
      - Control: {{ viewport_move_up_control_2 | default('1') }}
      - Shift: {{ viewport_move_up_shift_2 | default('1') }}
      - AltMeta: {{ viewport_move_up_altmeta_2 | default('1') }}
    Key: {{ viewport_move_up_key_2 | default('KP_Up') }}
  -->
  <keystroke
    action="viewport_move_up"
    Control="{{ viewport_move_up_control_2 | default('1') }}"
    Shift="{{ viewport_move_up_shift_2 | default('1') }}"
    AltMeta="{{ viewport_move_up_altmeta_2 | default('1') }}"
    key="{{ viewport_move_up_key_2 | default('KP_Up') }}"
  />

  <!--
    Action: Viewport Move Right (Primary)
    Description: Moves the viewport to the right.
    Modifiers:
      - Control: {{ viewport_move_right_control | default('1') }}
      - Shift: {{ viewport_move_right_shift | default('1') }}
      - AltMeta: {{ viewport_move_right_altmeta | default('1') }}
    Key: {{ viewport_move_right_key | default('Right') }}
  -->
  <keystroke
    action="viewport_move_right"
    Control="{{ viewport_move_right_control | default('1') }}"
    Shift="{{ viewport_move_right_shift | default('1') }}"
    AltMeta="{{ viewport_move_right_altmeta | default('1') }}"
    key="{{ viewport_move_right_key | default('Right') }}"
  />

  <!--
    Action: Viewport Move Right (Secondary)
    Description: Secondary keybinding for moving the viewport right.
    Modifiers:
      - Control: {{ viewport_move_right_control_2 | default('1') }}
      - Shift: {{ viewport_move_right_shift_2 | default('1') }}
      - AltMeta: {{ viewport_move_right_altmeta_2 | default('1') }}
    Key: {{ viewport_move_right_key_2 | default('KP_Right') }}
  -->
  <keystroke
    action="viewport_move_right"
    Control="{{ viewport_move_right_control_2 | default('1') }}"
    Shift="{{ viewport_move_right_shift_2 | default('1') }}"
    AltMeta="{{ viewport_move_right_altmeta_2 | default('1') }}"
    key="{{ viewport_move_right_key_2 | default('KP_Right') }}"
  />

  <!--
    Action: Viewport Move Down (Primary)
    Description: Moves the viewport down.
    Modifiers:
      - Control: {{ viewport_move_down_control | default('1') }}
      - Shift: {{ viewport_move_down_shift | default('1') }}
      - AltMeta: {{ viewport_move_down_altmeta | default('1') }}
    Key: {{ viewport_move_down_key | default('Down') }}
  -->
  <keystroke
    action="viewport_move_down"
    Control="{{ viewport_move_down_control | default('1') }}"
    Shift="{{ viewport_move_down_shift | default('1') }}"
    AltMeta="{{ viewport_move_down_altmeta | default('1') }}"
    key="{{ viewport_move_down_key | default('Down') }}"
  />

  <!--
    Action: Viewport Move Down (Secondary)
    Description: Secondary keybinding for moving the viewport down.
    Modifiers:
      - Control: {{ viewport_move_down_control_2 | default('1') }}
      - Shift: {{ viewport_move_down_shift_2 | default('1') }}
      - AltMeta: {{ viewport_move_down_altmeta_2 | default('1') }}
    Key: {{ viewport_move_down_key_2 | default('KP_Down') }}
  -->
  <keystroke
    action="viewport_move_down"
    Control="{{ viewport_move_down_control_2 | default('1') }}"
    Shift="{{ viewport_move_down_shift_2 | default('1') }}"
    AltMeta="{{ viewport_move_down_altmeta_2 | default('1') }}"
    key="{{ viewport_move_down_key_2 | default('KP_Down') }}"
  />

  <!--
    Action: Viewport Scroll Left (Primary)
    Description: Scrolls the viewport content to the left.
    Modifiers:
      - Control: {{ viewport_scroll_left_control | default('1') }}
      - AltMeta: {{ viewport_scroll_left_altmeta | default('1') }}
    Key: {{ viewport_scroll_left_key | default('Left') }}
  -->
  <keystroke
    action="viewport_scroll_left"
    Control="{{ viewport_scroll_left_control | default('1') }}"
    AltMeta="{{ viewport_scroll_left_altmeta | default('1') }}"
    key="{{ viewport_scroll_left_key | default('Left') }}"
  />

  <!--
    Action: Viewport Scroll Left (Secondary)
    Description: Secondary keybinding for scrolling the viewport left.
    Modifiers:
      - Control: {{ viewport_scroll_left_control_2 | default('1') }}
      - AltMeta: {{ viewport_scroll_left_altmeta_2 | default('1') }}
    Key: {{ viewport_scroll_left_key_2 | default('KP_Left') }}
  -->
  <keystroke
    action="viewport_scroll_left"
    Control="{{ viewport_scroll_left_control_2 | default('1') }}"
    AltMeta="{{ viewport_scroll_left_altmeta_2 | default('1') }}"
    key="{{ viewport_scroll_left_key_2 | default('KP_Left') }}"
  />

  <!--
    Action: Viewport Scroll Up (Primary)
    Description: Scrolls the viewport content up.
    Modifiers:
      - Control: {{ viewport_scroll_up_control | default('1') }}
      - AltMeta: {{ viewport_scroll_up_altmeta | default('1') }}
    Key: {{ viewport_scroll_up_key | default('Up') }}
  -->
  <keystroke
    action="viewport_scroll_up"
    Control="{{ viewport_scroll_up_control | default('1') }}"
    AltMeta="{{ viewport_scroll_up_altmeta | default('1') }}"
    key="{{ viewport_scroll_up_key | default('Up') }}"
  />

  <!--
    Action: Viewport Scroll Up (Secondary)
    Description: Secondary keybinding for scrolling the viewport up.
    Modifiers:
      - Control: {{ viewport_scroll_up_control_2 | default('1') }}
      - AltMeta: {{ viewport_scroll_up_altmeta_2 | default('1') }}
    Key: {{ viewport_scroll_up_key_2 | default('KP_Up') }}
  -->
  <keystroke
    action="viewport_scroll_up"
    Control="{{ viewport_scroll_up_control_2 | default('1') }}"
    AltMeta="{{ viewport_scroll_up_altmeta_2 | default('1') }}"
    key="{{ viewport_scroll_up_key_2 | default('KP_Up') }}"
  />

  <!--
    Action: Viewport Scroll Right (Primary)
    Description: Scrolls the viewport content to the right.
    Modifiers:
      - Control: {{ viewport_scroll_right_control | default('1') }}
      - AltMeta: {{ viewport_scroll_right_altmeta | default('1') }}
    Key: {{ viewport_scroll_right_key | default('Right') }}
  -->
  <keystroke
    action="viewport_scroll_right"
    Control="{{ viewport_scroll_right_control | default('1') }}"
    AltMeta="{{ viewport_scroll_right_altmeta | default('1') }}"
    key="{{ viewport_scroll_right_key | default('Right') }}"
  />

  <!--
    Action: Viewport Scroll Right (Secondary)
    Description: Secondary keybinding for scrolling the viewport right.
    Modifiers:
      - Control: {{ viewport_scroll_right_control_2 | default('1') }}
      - AltMeta: {{ viewport_scroll_right_altmeta_2 | default('1') }}
    Key: {{ viewport_scroll_right_key_2 | default('KP_Right') }}
  -->
  <keystroke
    action="viewport_scroll_right"
    Control="{{ viewport_scroll_right_control_2 | default('1') }}"
    AltMeta="{{ viewport_scroll_right_altmeta_2 | default('1') }}"
    key="{{ viewport_scroll_right_key_2 | default('KP_Right') }}"
  />

  <!--
    Action: Viewport Scroll Down (Primary)
    Description: Scrolls the viewport content down.
    Modifiers:
      - Control: {{ viewport_scroll_down_control | default('1') }}
      - AltMeta: {{ viewport_scroll_down_altmeta | default('1') }}
    Key: {{ viewport_scroll_down_key | default('Down') }}
  -->
  <keystroke
    action="viewport_scroll_down"
    Control="{{ viewport_scroll_down_control | default('1') }}"
    AltMeta="{{ viewport_scroll_down_altmeta | default('1') }}"
    key="{{ viewport_scroll_down_key | default('Down') }}"
  />

  <!--
    Action: Viewport Scroll Down (Secondary)
    Description: Secondary keybinding for scrolling the viewport down.
    Modifiers:
      - Control: {{ viewport_scroll_down_control_2 | default('1') }}
      - AltMeta: {{ viewport_scroll_down_altmeta_2 | default('1') }}
    Key: {{ viewport_scroll_down_key_2 | default('KP_Down') }}
  -->
  <keystroke
    action="viewport_scroll_down"
    Control="{{ viewport_scroll_down_control_2 | default('1') }}"
    AltMeta="{{ viewport_scroll_down_altmeta_2 | default('1') }}"
    key="{{ viewport_scroll_down_key_2 | default('KP_Down') }}"
  />

  <!--
    Action: Reread Keystrokes
    Description: Keystroke combination to reload the keystroke configuration file.
    Modifiers:
      - Control: {{ reread_keystrokes_control | default('1') }}
      - AltMeta: {{ reread_keystrokes_altmeta | default('1') }}
    Key: {{ reread_keystrokes_key | default('k') }}
  -->
  <keystroke
    action="reread_keystrokes"
    Control="{{ reread_keystrokes_control | default('1') }}"
    AltMeta="{{ reread_keystrokes_altmeta | default('1') }}"
    key="{{ reread_keystrokes_key | default('k') }}"
  />

  <!--
    Action: Autograb
    Description: Keystroke combination to toggle automatic key grabbing.
    Modifiers:
      - Control: {{ autograb_control | default('1') }}
      - AltMeta: {{ autograb_altmeta | default('1') }}
    Key: {{ autograb_key | default('g') }}
  -->
  <keystroke
    action="autograb"
    Control="{{ autograb_control | default('1') }}"
    AltMeta="{{ autograb_altmeta | default('1') }}"
    key="{{ autograb_key | default('g') }}"
  />

  <!--
    Action: Dump Clipboard
    Description: Keystroke combination to dump/copy clipboard content.
    Modifiers:
      - Control: {{ dump_clipboard_control | default('1') }}
      - Shift: {{ dump_clipboard_shift | default('1') }}
      - AltMeta: {{ dump_clipboard_altmeta | default('1') }}
    Key: {{ dump_clipboard_key | default('c') }}
  -->
  <keystroke
    action="dump_clipboard"
    Control="{{ dump_clipboard_control | default('1') }}"
    Shift="{{ dump_clipboard_shift | default('1') }}"
    AltMeta="{{ dump_clipboard_altmeta | default('1') }}"
    key="{{ dump_clipboard_key | default('c') }}"
  />
</keystrokes>
