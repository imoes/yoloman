# /etc/netplug/netplug.conf — Configuration for the netplug network link management daemon
# Each line defines an interface to monitor and optional action script
# Format: interface [action_script]
# Lines starting with '#' or empty lines are ignored
# See `man netplug.conf` for details
{% for iface in interfaces %}{{ iface.name }}{% if iface.action_script %} {{ iface.action_script }}{% endif %}
{% endfor %}