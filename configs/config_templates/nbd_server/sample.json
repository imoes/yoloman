{
  "addr": "192.168.1.10",
  "port": 10809,
  "threads": 8,
  "export_name": "storage1",
  "description": "Primary storage volume for VM images",
  "export_file": "/dev/vg0/vm_storage",
  "export_size": "2T",
  "read_only": false,
  "multifile": false,
