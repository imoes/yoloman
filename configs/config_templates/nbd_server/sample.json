  "strict_io": false,
  "prealloc": "falloc",
  "block_size": 4096,
  "tls": true,
  "tls_cert": "/etc/nbd-server/certs/server.crt",
  "tls_key": "/etc/nbd-server/certs/server.key",
  "tls_ca_cert": "/etc/nbd-server/certs/ca.crt",
  "hosts_allow": [
    "192.168.1.0/24",
    "10.0.1.5"
  ],
  "hosts_deny": [
    "0.0.0.0/0"
  ],
  "custom_options": [
    "no-tls"
  ]
}
