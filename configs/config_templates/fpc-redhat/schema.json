{
  "release_optimization_level": {
    "type": "string",
    "default": "O2",
    "description": "Optimization level for release builds (e.g., O2)"
  },
  "release_strip_debuginfo": {
    "type": "string",
    "default": "Xs",
    "description": "Switch to strip debuginfo for release builds"
  },
  "debug_info_flag": {
    "type": "string",
    "default": "gl",
    "description": "Flag to generate debug info and line info for debug builds"
  },
  "xcode_developer_path": {
    "type": "string",
    "default": "/Applications/Xcode.app/Contents/Developer/usr/bin",
    "description": "Path to Xcode utilities on Darwin"
  },
  "parsing_switches": {
    "type": "string",
    "default": "gic",
    "description": "Concatenated semantic checking switches (e.g., gic for goto, inline, C-ops)"
  },
  "default_heapsize_hex": {
    "type": "string",
    "default": "8000000",
    "description": "Default heap size in hexadecimal (e.g., 8000000 for 8MB)"
  },
  "units_path_64_base": {
    "type": "string",
    "default": "/usr/lib64/fpc/$fpcversion/units/$fpctarget",
    "description": "Base path for 64-bit unit files"
  },
  "units_path_32_base": {
    "type": "string",
    "default": "/usr/lib/fpc/$fpcversion/units/$fpctarget",
    "description": "Base path for 32-bit unit files"
  },
  "lib_path_64_target": {
    "type": "string",
    "default": "/usr/lib64/fpc/$fpcversion/lib/$FPCTARGET",
    "description": "Library search path for 64-bit targets"
  },
  "lib_path_32_target": {
    "type": "string",
    "default": "/usr/lib/fpc/$fpcversion/lib/$FPCTARGET",
    "description": "Library search path for 32-bit targets"
  },
  "bin_path_64_target": {
    "type": "string",
    "default": "/usr/lib64/fpc/$fpcversion/bin/$FPCTARGET",
    "description": "Binary search path for 64-bit targets"
  },
  "bin_path_32_target": {
    "type": "string",
    "default": "/usr/lib/fpc/$fpcversion/bin/$FPCTARGET",
    "description": "Binary search path for 32-bit targets"
  },
  "linker_strip_debuginfo": {
    "type": "string",
    "default": "s",
    "description": "Linker switch to strip debuginfo (Xs)"
  },
  "verbosity_flags": {
    "type": "string",
    "default": "iwn",
    "description": "Verbosity flags to display info, warnings, and notes"
  }
}
