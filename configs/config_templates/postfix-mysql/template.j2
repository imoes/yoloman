# Configuration for Postfix MySQL lookup support module.
# This file specifies the parameters for loading the postfix-mysql shared library
# into Postfix via the `mysql` lookup tables mechanism (transport_maps, virtual_mailbox_maps, etc.).
#
# Schema Field: shlib_directory
# Description: The directory where Postfix looks for shared libraries (modules).
# Default: /usr/lib/postfix
# Note: The variable `shlib_directory` usually comes from the main Postfix configuration
# or the distribution's default paths.

$shlib_directory/postfix-mysql.so:f:root:-:755
