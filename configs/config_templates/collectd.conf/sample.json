{
  "plugins": [
    "cpu",
    "load",
    "memory",
    "interface",
    "disk",
    "csv"
  ],
  "plugin_configs": [
    {
      "name": "cpu",
      "options": {
        "ValuesPercentage": true
      },
      "comments": {
        "ValuesPercentage": "Report CPU usage as percentages (0\u2013100)"
      }
    },
    {
      "name": "disk",
      "options": {
        "Disk": [
          "/",
          "/var",
          "/home"
        ],
        "IgnoreSelected": false
      },
      "comments": {
        "Disk": "List of mount points to monitor; use regex if needed"
      },
      "types": {
        "Disk": "list"
      }
    },
    {
      "name": "interface",
      "options": {
        "Interface": [
          "eth0",
          "lo"
        ],
        "IgnoreSelected": true
      },
      "comments": {
        "Interface": "Monitor only these interfaces; ignored if IgnoreSelected is false"
      },
      "types": {
        "Interface": "list"
      }
    },
    {
      "name": "memory",
      "options": {}
    },
    {
      "name": "load",
      "options": {}
    },
    {
      "name": "csv",
      "options": {
        "DataDir": "/var/lib/collectd/csv",
        "StoreRates": true
      },
      "comments": {
        "DataDir": "Directory where CSV files are stored",
        "StoreRates": "Store rates (e.g., per-second) instead of raw counters"
      }
    }
  ],
  "include_fragments": [
    "/etc/collectd/collectd.conf.d/*.conf"
  ],
  "logfile": "/var/log/collectd.log",
  "log_level": "info",
  "fqdn_lookup": true
}
