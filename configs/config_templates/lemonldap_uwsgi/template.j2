# ==============================================================================
# LemonLDAP::NG uWSGI configuration — main settings
# This file is auto-generated by Ansible from the 'lemonldap_uwsgi' package schema.
# Do not edit manually; changes will be overwritten.
# ==============================================================================

[lemonldap]

; ==============================================================================
; General Application Settings
; ==============================================================================

; Directory containing LemonLDAP::NG configuration files (e.g., lemonldap-ng.ini, domains, vhost.conf).
configDir = {{ config_dir | default('/etc/lemonldap-ng') }}

; Directory where LemonLDAP::NG stores session files (must be writable by the service user).
sessionDir = {{ session_dir | default('/var/lib/lemonldap-ng/sessions') }}

; Minimum log level for the application. Options: debug, info, notice, warning, error, crit, alert, emerg.
logLevel = {{ log_level | default('warning') }}

; Enable verbose debug output. Should be disabled in production.
debug = {{ debug | default(False) | lower }}

; ==============================================================================
; HTTP Server Configuration
; ==============================================================================

; Network interface address to bind the HTTP/HTTPS server (e.g., 'localhost', '127.0.0.1', or '0.0.0.0' for all interfaces).
host = {{ host | default('0.0.0.0') }}

; TCP port to listen on for HTTP requests (ignored if using Unix socket).
port = {{ port | default(8080) }}

; ==============================================================================
; HTTPS Configuration
; ==============================================================================

{% if https_enabled | default(False) %}
; HTTPS is enabled.
; Enable HTTPS mode in uWSGI
https = 1

; Path to the SSL certificate file (PEM format).
sslCertFile = {{ ssl_cert_file | default('/etc/lemonldap-ng/ssl/cert.pem') }}

; Path to the SSL private key file (PEM format).
sslKeyFile = {{ ssl_key_file | default('/etc/lemonldap-ng/ssl/key.pem') }}
{% else %}
; HTTPS is disabled.
https = 0
{% endif %}

; ==============================================================================
; uWSGI Worker & Process Configuration
; ==============================================================================

; Number of uWSGI worker processes to spawn.
processes = {{ processes | default(2) }}

; Number of threads per worker process (set to 1 if not using threading).
threads = {{ threads | default(4) }}

; Socket binding: either a TCP address:port (e.g., ':8080') or a Unix socket path (e.g., '/run/lemonldap-ng/lemonldap.sock').
; Note: The config directive is typically 'socket', but this template uses 'uwsgi_socket' to match legacy/specific LemonLDAP-ng.ini mappings.
uwsgi_socket = {{ uwsgi_socket | default(':8080') }}

; Enable uWSGI master process for better management of workers and signals.
master = {{ master | default(True) | lower }}

; Load applications in each worker individually to reduce memory via copy-on-write (recommended for LemonLDAP::NG).
lazy-apps = {{ lazy_apps | default(True) | lower }}

; Clean up temporary files (e.g., sockets) on shutdown.
vacuum = {{ vacuum | default(True) | lower }}

; ==============================================================================
; Memory & Performance Tuning
; ==============================================================================

; Maximum memory (in MB) a worker process is allowed to use before being gracefully respawned (helps prevent memory leaks).
max_memory = {{ max_memory | default(128) }}

; Reload a worker after it handles this many requests (prevents resource exhaustion).
max_requests = {{ max_requests | default(5000) }}

; Graceful reload timeout in seconds — if a request takes longer, the worker is restarted.
harakiri = {{ harakiri | default(60) }}

; ==============================================================================
; Logging Configuration
; ==============================================================================

; Optional file path to redirect logs (ensure the directory exists and is writable).
; If omitted or empty, logs go to stderr.
{% if log_file | default(None) is defined and log_file | default(None) | trim | length > 0 %}
logto = {{ log_file | default('/var/log/lemonldap-ng/lemonldap.log') }}
{% endif %}

; ==============================================================================
; Static Assets
; ==============================================================================

; Map URL path to static asset directory (used for serving LemonLDAP::NG's UI assets).
staticMap = {{ static_map | default('/static=/usr/share/perl5/vendor_perl/auto/share/dist/Lemonldap-NG-Handler/static') }}