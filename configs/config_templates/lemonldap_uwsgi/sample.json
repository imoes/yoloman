{
  "config_dir": "/etc/lemonldap-ng",
  "session_dir": "/var/lib/lemonldap-ng/sessions",
  "log_level": "warning",
  "debug": false,
  "host": "127.0.0.1",
  "port": 8080,
  "https_enabled": true,
  "ssl_cert_file": "/etc/lemonldap-ng/ssl/server.crt",
  "ssl_key_file": "/etc/lemonldap-ng/ssl/server.key",
  "processes": 4,
  "threads": 2,
  "uwsgi_socket": ":9090",
  "master": true,
  "lazy_apps": true,
  "vacuum": true,
  "max_memory": 256,
  "max_requests": 10000,
  "harakiri": 120,
  "log_file": "/var/log/lemonldap-ng/lemonldap.log",
  "static_map": "/static=/usr/share/perl5/vendor_perl/auto/share/dist/Lemonldap-NG-Handler/static"
}
