# Shed configuration template
# shed does not have a standard system configuration file; these are command-line defaults.
# This file represents the effective command-line arguments passed to shed.

# Open the file in read-only mode (corresponds to -r / --readonly)
# Schema field: readonly (default=False)
readonly: {{ (values | default({})).readonly | default(false) }}

# Position cursor to this byte offset from start of file (corresponds to -s / --start=OFFSET)
# Schema field: start_offset (default=0)
start_offset: {{ (values | default({})).start_offset | default(0) }}

# Set length of file to this value. Useful for special files where shed cannot obtain length with stat (corresponds to -L / --length=LENGTH)
# Schema field: file_length (default=0)
file_length: {{ (values | default({})).file_length | default(0) }}

# Start in hex mode with hex offsets etc. (corresponds to -H / --hex)
# Schema field: hex_mode (default=False)
hex_mode: {{ (values | default({})).hex_mode | default(false) }}