# HexChat configuration file
# Generated by Ansible - self-documenting template
#
# This file controls HexChat's IRC client behavior, including plugin loading,
# user identity, and channel appearance settings.
# All variables are sourced from Ansible variables with safe defaults.

[General]
# Disable loading plugins at startup. Set to 'yes' to enhance security/simplicity,
# or 'no' to allow plugins (default).
# Variable: no_plugins (boolean)
no_plugins={{ 'yes' if no_plugins|default(false) else 'no' }}

[Colors]
# Default channel colors setting. Usually a comma-separated list of hex color codes
# (e.g., '#FF0000,#00FF00,#0000FF') applied to channel elements.
# Variable: channel_colors (string, empty means defaults)
channel_colors={{ channel_colors|default('') }}

[Userinfo]
# Nickname to use on IRC networks.
# Variable: nick (string)
nick={{ nick|default('hexchat_user') }}

# Username (ident) for IRC login. Also known as the "ident" field.
# Variable: username (string)
username={{ username|default('hexchat') }}

# Real name (gecos) field for IRC. Displayed in user information queries.
# Variable: realname (string)
realname={{ realname|default('HexChat User') }}