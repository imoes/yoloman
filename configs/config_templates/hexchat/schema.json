{
  "no_plugins": {
    "type": "bool",
    "default": false,
    "description": "Disable loading plugins at startup"
  },
  "channel_colors": {
    "type": "string",
    "default": "",
    "description": "Default channel colors setting (usually a comma-separated list of hex colors)"
  },
  "nick": {
    "type": "string",
    "default": "hexchat_user",
    "description": "Nickname to use on IRC"
  },
  "username": {
    "type": "string",
    "default": "hexchat",
    "description": "Username (ident) for IRC login"
  },
  "realname": {
    "type": "string",
    "default": "HexChat User",
    "description": "Real name (gecos) field for IRC"
  }
}
