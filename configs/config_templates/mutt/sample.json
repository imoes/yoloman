{
  "ignore_all_headers": "*",
  "unignore_headers": "from: subject to cc date x-mailer x-url user-agent",
  "hdr_order_fields": "date from to cc subject",
  "sort_method": "threads",
  "mixmaster_filter_program": "mixmaster-filter",
  "ssl_ca_certificates_path": "/etc/ssl/certs/ca-certificates.crt",
  "mime_lookup_types": "application/octet-stream",
  "time_inc_value": 250,
  "mailto_allow_headers": "cc in-reply-to references",
  "attachments_default_include": "*/.*",
  "attachments_vcard_pgp_exclude": "text/x-vcard application/pgp.*",
  "attachments_pkcs7_exclude": "application/x-pkcs7-.*",
  "attachments_inline_include": "text/plain",
  "attachments_external_body_exclude": "message/external-body",
  "attachments_external_body_inline_exclude": "message/external-body"
}
