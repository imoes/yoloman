{
  "test_types": [
    {
      "flag": "s",
      "description": "Single Argument Test",
      "enabled": true
    },
    {
      "flag": "m",
      "description": "Multiple Argument Test",
      "enabled": true
    },
    {
      "flag": "e",
      "description": "Environment Variable Test",
      "enabled": false
    },
    {
      "flag": "a",
      "description": "Selects all tests",
      "enabled": false
    }
  ],
  "tempfile_monitor": true,
  "debug_level": 1,
  "max_execs": 128,
  "skip_binaries": [
    "kill",
    "reboot"
  ],
  "output_file": "/var/log/bfbtester/report.log",
  "targets": [
    "/usr/bin/patch",
    "/usr/bin/traceroute",
    "/usr/local/bin"
  ]
}
