# /etc/bfbtester.conf
# BFBTester configuration file
# Generated by Ansible Jinja2 template

{% for test in test_types | default([]) %}
{# {{ test.description | default('') }} #}
{# Whether to include the corresponding flag (-s, -m, -e, or -a) in the command line. #}
{% if test.enabled | default(False) %}-{{ test.flag | default('s') }}{% endif %}
{% endfor %}
{# Whether to enable tempfile creation monitoring (-t). #}
{% if tempfile_monitor | default(False) %}-t{% endif %}
# Debug level (0–2)
-d {{ debug_level | default(0) }}
# Maximum concurrent executions
-x {{ max_execs | default(250) }}
# Skip binaries (comma-separated)
{% if skip_binaries | default([]) | length > 0 %}-r {{ skip_binaries | default([]) | join(',') }}{% endif %}
# Output file (optional)
{% if output_file | default('') %}-o {{ output_file | default('') }}{% endif %}
# Targets ( binaries or directories )
{% for target in targets | default([]) %}{{ target }}
{% endfor %}