{# ============================================================================
 # catimg Configuration Template
 # ============================================================================
 # This template configures the command-line arguments passed to the 'catimg'
 # utility. 'catimg' is a tool for displaying images in the terminal.
 #
 # The configuration consists of a list of arguments (strings) that are
 # passed directly to the executable.
 # ============================================================================ #}

{% set _args = args | default([]) %}

{# --- Runtime Arguments --- #}
{% if _args | length > 0 %}
# catimg invocation arguments
# Each line below corresponds to one argument or flag passed to catimg.
# Examples: '-c', '-w 100', 'image.png'
{% for arg in _args %}
{{ arg | indent(width=4) }}
{% endfor %}
{% endif %}