# dselect configuration file
#
# This file can contain default options for dselect. All command-line
# options are allowed. Values can be specified by putting them after
# the option, separated by whitespace and/or an '=' sign.
#
# This file is typically located at /etc/dselect/config.
# It allows setting default behaviors for package selection and installation.

# Default method to use when updating/instaling packages.
# Common values: 'apt', 'aptitude'.
# If omitted, dselect may prompt or use system defaults.
method = {{ dselect_method | default('apt') }}

# The mirror or source list configuration to use.
# Typically points to a valid sources.list or mirror URL.
# If omitted, the system's default sources.list is used.
mirror = {{ dselect_mirror | default('') }}

# Whether to automatically upgrade packages if dependencies allow.
# true: Automatically select upgrades during 'update' phase.
# false: Only select new packages, require manual intervention for upgrades.
auto_upgrade = {{ dselect_auto_upgrade | default(false) }}

# Enable verbose logging during dselect operations.
# true: Print detailed output of actions taken.
# false: Minimal output.
verbose = {{ dselect_verbose | default(false) }}

# Number of retries if a download fails.
retries = {{ dselect_retries | default(3) }}

# Delay in seconds between retries.
retry_delay = {{ dselect_retry_delay | default(5) }}

# Timeout in seconds for network operations.
timeout = {{ dselect_timeout | default(30) }}