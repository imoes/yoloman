# nat-traverse tunnel configuration
# This template generates the command-line configuration for nat-traverse connections.
# Each entry in the `connections` list represents one side of a UDP tunnel connection
# traversing NAT devices.
#
# The output consists of a series of nat-traverse invocations, one per connection.

{% for connection in (connections | default([])) %}
# -----------------------------------------------------------------------------
# Connection: {{ (connection | default({})).name | default('tunnel_1') }}
# Human-readable name for the connection entry, used for comment identification only.
# -----------------------------------------------------------------------------

# Local port on the host where the tunnel endpoint listens.
# Default: 40000
# The local UDP port to use for the connection.
{% if (connection | default({})).quit_after_connect | default(False) %}
# Quit after connection established.
# If true, quits nat-traverse after the tunnel is established successfully.
# Useful for chaining with other services like OpenVPN.
# Default: False
--quit-after-connect \
{% endif %}

# Number of initial garbage packets to send to traverse firewalls.
# Default: 10
# Number of initial garbage packets to send. Default 10 works with most firewalls.
--window={{ (connection | default({})).window | default(10) }} \

# Maximum seconds to wait for an acknowledgement by the peer.
# Default: 10
# Maximum seconds to wait for an acknowledgement by the peer.
--timeout={{ (connection | default({})).timeout | default(10) }} \

# Command to run after establishing the connection (e.g., pppd or nc).
# Empty string disables command execution.
# Default: ''
{% if (connection | default({})).cmd | default('') %}
--cmd="{{ (connection | default({})).cmd | default('') }}" \
{% endif %}

# Connection format: local_port:peer_nat_gateway:remote_port
# local_port: The local UDP port to use for the connection.
# Default: 40000
# peer_nat_gateway: The IP address or hostname of the NAT gateway of the remote host.
# Default: natgw.example.com
# remote_port: The UDP port on the remote host that nat-traverse is listening on.
# Default: 40001
{{ (connection | default({})).local_port | default(40000) }}:{{ (connection | default({})).peer_nat_gateway | default('natgw.example.com') }}:{{ (connection | default({})).remote_port | default(40001) }}

{% endfor %}