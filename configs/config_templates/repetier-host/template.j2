# Repetier-Host Configuration Template
# Generated for Debian-based systems using Monogame/Mono registry style.
# This file configures Repetier-Host, a 3D printer management interface.

# Global Application Settings
[ApplicationSettings]

# ISO 639-1 language code for the user interface.
# Default: 'en' (English).
Language={{ language | default('en') }}

# Whether to show notifications when new versions of Repetier-Host are available.
# Default: True.
ShowUpdates={{ show_updates | default(true) }}

# Whether to automatically check for updates on application startup.
# Default: True.
AutoCheckUpdates={{ auto_check_updates | default(true) }}

# Connection and Printer Settings
[PrinterSettings]

# Default serial baud rate for printer communication.
# Typical values: 115200, 250000.
# Default: 115200.
BaudRate={{ baud_rate | default(115200) }}

# Default serial port device path for the connected 3D printer.
# Typical values: '/dev/ttyUSB0', '/dev/ttyACM0'.
# Default: '/dev/ttyUSB0'.
SerialPort={{ serial_port | default('/dev/ttyUSB0') }}

# Automatically retry connection if the initial attempt fails.
# Default: True.
RetryConnection={{ retry_connection | default(true) }}

# Maximum number of connection retry attempts.
# Default: 3.
MaxRetries={{ max_retries | default(3) }}

# Timeout in milliseconds for waiting for a response from the printer.
# Default: 5000.
ResponseTimeout={{ response_timeout | default(5000) }}

# Advanced/Experimental Settings
[AdvancedSettings]

# Enable verbose logging for troubleshooting.
# Default: False.
VerboseLogging={{ verbose_logging | default(false) }}

# Custom path for the log file. Empty string uses the default location in ~/.mono/registry.
# Default: '' (empty).
LogFilePath={{ log_file_path | default('') }}

# List of G-code commands that are trusted to run without confirmation prompts.
# Example: ['G1', 'G28'] renders as 'G1,G28'.
# For security, default to empty to require confirmation for all commands.
# Default: [] (empty list).
TrustedGcodes={{ trusted_gcodes | default([]) | join(',') }}