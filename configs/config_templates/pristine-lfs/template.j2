# pristine-lfs configuration
# See pristine-lfs(1) for details

# tmpdir: Specifies a location to place temporary files, other than the default.
# Corresponds to the TMPDIR environment variable.
tmpdir = "{{ tmpdir | default('/tmp') }}"

# default_branch: Branch to store Git LFS metadata on.
# Corresponds to the -b/--branch option used as default for commands.
default_branch = "{{ default_branch | default('master') }}"