{
  "mode": "d",
  "source_socket": "/run/spiped/frontend.sock",
  "target_socket": "127.0.0.1:8080",
  "key_file": "/etc/spiped/keys/frontend.key",
  "bind_address": "",
  "run_foreground": false,
  "fast_handshake": false,
  "perfect_forward_secrecy": true,
  "disable_keep_alive": false,
  "max_connections": 50,
  "connection_timeout": 10,
  "pid_file": "/run/spiped.pid",
  "resolve_interval": 30,
  "use_syslog": true,
  "user": "spiped",
  "group": "spiped"
}
