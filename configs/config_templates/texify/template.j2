# =============================================================================
# texify — LaTeX code-to-LaTeX converter configuration
# =============================================================================
# This template generates the configuration file for the `texify` utility,
# which converts source code into syntax-highlighted LaTeX listings.
# It is self-documenting: every directive is preceded by a comment explaining
# its purpose and default value.
# =============================================================================

# Path to the source code file to be formatted.
# Use '/dev/stdin' for standard input.
# Default: /dev/stdin
input_file: {{ input_file | default('/dev/stdin') }}

# Path to the output LaTeX file.
# Use '/dev/stdout' for standard output.
# Default: /dev/stdout
output_file: {{ output_file | default('/dev/stdout') }}

# Maximum line length for the generated LaTeX output.
# This controls wrapping or splitting of long lines in the resulting LaTeX.
# Default: 79
line_length: {{ line_length | default(79) }}

# Number of spaces to substitute for a tab character in the output.
# Default: 6
tab_width: {{ tab_width | default(6) }}

# Interval for adding line number prefixes.
# 0 disables line numbers.
# 1 adds line numbers to every line.
# Default: 0
line_number_interval: {{ line_number_interval | default(0) }}

# If true, uses \tiny for line numbers; if false, uses \footnotesize.
# Default: false
use_tiny_numbers: {{ use_tiny_numbers | default(false) | lower }}

# Input source language for syntax highlighting.
# Examples: c, java, python, sql.
# Default: c
language: {{ language | default('c') }}