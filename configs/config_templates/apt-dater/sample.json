{
  "ssh_cmd": "/usr/bin/ssh",
  "ssh_opt_cmd_flags": "-t -o StrictHostKeyChecking=no",
  "ssh_sftp_cmd": "/usr/bin/sftp",
  "ssh_spawn_agent": "false",
  "ssh_add_key_1": "/path/to/id_rsa1",
  "ssh_add_key_2": "/path/to/id_rsa2",
  "ssh_multiuser_opt_cmd_flags": "-t -o StrictHostKeyChecking=no",
  "ssh_multiuser_spawn_agent": "true",
  "ssh_multiuser_add_key": "/etc/apt-dater/ssh/id_rsa",
  "paths_hosts_file": "/etc/apt-dater/hosts.xml",
  "paths_history_dir": "/var/lib/apt-dater/history",
  "paths_stats_dir": "/var/cache/apt-dater/stats",
  "paths_umask": "007",
  "screen_rc_file": "path-to/screenrc",
  "screen_title": "%m # %u@%h:%p",
  "tmux_socket_path": "/var/cache/apt-dater/tmux",
  "appearance_colors": "menu brightgreen blue;status brightgreen blue;selector black red;",
  "notify_beep": "true",
  "notify_flash": "true",
  "hooks_plugin_dir": "/etc/apt-dater/plugins",
  "hooks_pre_upgrade": "/etc/apt-dater/pre-upg.d",
  "hooks_post_upgrade": "/etc/apt-dater/post-upg.d",
  "hooks_pre_refresh": "/etc/apt-dater/pre-ref.d",
  "hooks_post_refresh": "/etc/apt-dater/post-ref.d",
  "hooks_pre_install": "/etc/apt-dater/pre-ins.d",
  "hooks_post_install": "/etc/apt-dater/post-ins.d",
  "hooks_pre_connect": "/etc/apt-dater/pre-con.d",
  "hooks_post_connect": "/etc/apt-dater/post-con.d"
}
