<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE apt-dater SYSTEM "file:///usr/share/xml/schema/apt-dater/apt-dater.dtd">
<apt-dater xmlns:xi="http://www.w3.org/2001/XInclude">
    <!--
	SSH(1) options configuration.

	Attributes:
	  cmd            : Path to the SSH executable.
	  opt-cmd-flags  : Default flags passed to SSH commands (e.g., -t for pseudo-tty, StrictHostKeyChecking).
	  sftp-cmd       : Path to the SFTP executable.
	  spawn-agent    : Whether to automatically spawn an ssh-agent for the session (true/false).

	Multiuser setup notes:
	- It is recommended to disable StrictHostKeyChecking in opt-cmd-flags to avoid interactive prompts.
	- Setting spawn-agent to "true" allows key reuse across sessions.
	- Add shared SSH keys via <add-key> tags below.
    -->
    <ssh
        opt-cmd-flags="{{ ssh_opt_cmd_flags | default('-t -o StrictHostKeyChecking=no') }}"
        spawn-agent="{{ ssh_multiuser_spawn_agent | default('true') }}">
        <!--
            Shared SSH key for multiuser authentication.
            The user running apt-dater must have read access to this file.
            Format: <add-key fn="/path/to/key"/>
        -->
        <!-- add-key fn="{{ ssh_multiuser_add_key | default('/etc/apt-dater/ssh/id_rsa') }}" /-->
    </ssh>

    <!--
	Path configuration for apt-dater data files.

	Attributes:
	  hosts-file     : Path to the XML file containing the list of managed hosts.
	  history-dir    : Directory where execution history for host commands is stored.
	  stats-dir      : Directory where statistical data (e.g., update counts) is cached.
	  umask          : File creation mask (octal) applied when creating files/directories in multiuser mode.

	Multiuser setup notes:
	- Use global, shared directories to ensure all users see the same host list and history.
	- Explicit umask prevents other group members from reading sensitive data if desired.
    -->
    <paths
        hosts-file="{{ paths_hosts_file | default('/etc/apt-dater/hosts.xml') }}"
        history-dir="{{ paths_history_dir | default('/var/lib/apt-dater/history') }}"
        stats-dir="{{ paths_stats_dir | default('/var/cache/apt-dater/stats') }}"
        umask="{{ paths_umask | default('007') }}"/>

    <!--
	SCREEN(1) options configuration.

	Attributes:
	  rc-file        : Path to a custom screenrc file.
	  title          : Screen window title format string (supports %m, %u, %h, %p).

	Note: apt-dater primarily uses tmux in modern configurations, but screen support remains for legacy.
    -->
    <!--
    <screen
        rc-file="path-to/screenrc"
        title="%m # %u@%h:%p"/>
    -->

    <!--
	TMUX(1) options configuration.

	Attributes:
	  socket-path    : Path to the shared tmux server socket.

	Multiuser setup notes:
	- All users must be able to connect to this socket.
	- Ensure the directory exists and permissions allow the socket file to be created.
    -->
    <tmux
        socket-path="{{ tmux_socket_path | default('/var/cache/apt-dater/tmux') }}"/>

    <!--
	Appearance / Colors configuration.

	Format: "component fg_bg;component fg_bg;..."
	Components: default, menu, status, selector, hoststatus, query, input.
	Colors: black, blue, cyan, green, magenta, red, white, yellow, bright[colors].

	Example:
	  colors="menu brightgreen blue;status brightgreen blue;selector black red;"
    -->
    <!--
    <appearance
        colors="menu brightgreen blue;status brightgreen blue;selector black red;"/>
    -->

    <!--
	Notification settings for command results.

	Attributes:
	  beep           : Play a terminal bell on completion (true/false).
	  flash          : Flash the screen/window on completion (true/false).
    -->
    <!--
    <notify
        beep="true"
        flash="true"/>
    -->

    <!--
	Hook configuration for pre/post actions.

	Attributes:
	  plugin-dir     : Directory containing executable host plugins.
	  pre-upgrade    : Command/script to run before 'upgrade' action.
	  post-upgrade   : Command/script to run after 'upgrade' action.
	  pre-refresh    : Command/script to run before 'refresh' action.
	  post-refresh   : Command/script to run after 'refresh' action.
	  pre-install    : Command/script to run before 'install' action.
	  post-install   : Command/script to run after 'install' action.
	  pre-connect    : Command/script to run before 'connect' action.
	  post-connect   : Command/script to run after 'connect' action.

	Note: Paths are relative to the hook execution context or absolute.
    -->
    <!--
    <hooks
        plugin-dir="/etc/apt-dater/plugins";

        pre-upgrade="/etc/apt-dater/pre-upg.d"
        post-upgrade="/etc/apt-dater/post-upg.d"
        pre-refresh="/etc/apt-dater/pre-ref.d"
        post-refresh="/etc/apt-dater/post-ref.d"
        pre-install="/etc/apt-dater/pre-ins.d"
        post-install="/etc/apt-dater/post-ins.d"
        pre-connect="/etc/apt-dater/pre-con.d"
        post-connect="/etc/apt-dater/post-con.d"/>
    -->

    <!--
	Automatic reference update configuration.

	Requires apt-dater to be built with --enable-autoref.

	Attributes:
	  enabled        : Enable automatic checking for apt-dater updates (true/false).
    -->
    <!--
    <auto-ref
        enabled="true"/>
    -->

    <!--
	History recording configuration.

	Requires apt-dater to be built with --enable-history.

	Attributes:
	  record         : Enable recording of command history (true/false).
	  err-pattern    : Regex pattern to identify error lines in output (PCRE).
    -->
    <!--
    <history
        record="true"
        err-pattern="((?&lt;!no )error|(?&lt;!insserv: )warning|fail(ed)?)"/>
    -->

    <!--
	TCL filtering configuration for host selection/processing.

	Requires apt-dater to be built with --enable-tclfilter.

	Attributes:
	  filter-exp     : Inline Tcl expression for filtering.
	  filter-file    : Path to an external Tcl script file.
    -->
    <!--
    <tcl-filter
        filter-exp="return [expr [string compare $lsb_distri \\"Debian\\"] == 0 && $lsb_rel < 4.0]"
        filter-file="/path/to/file.tcl" />
    -->
</apt-dater>
