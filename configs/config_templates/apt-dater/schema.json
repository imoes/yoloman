{
  "ssh_cmd": {
    "type": "string",
    "default": "/usr/bin/ssh",
    "description": "Path to the SSH client executable."
  },
  "ssh_opt_cmd_flags": {
    "type": "string",
    "default": "-t",
    "description": "Additional SSH command-line flags (non-multiuser mode)."
  },
  "ssh_sftp_cmd": {
    "type": "string",
    "default": "/usr/bin/sftp",
    "description": "Path to the SFTP client executable."
  },
  "ssh_spawn_agent": {
    "type": "string",
    "default": "false",
    "description": "Whether to spawn ssh-agent for SSH connections (non-multiuser mode). (Currently unused in active config block)",
    "enum": [
      "true",
      "false"
    ]
  },
  "ssh_add_key_1": {
    "type": "string",
    "default": "/path/to/id_rsa1",
    "description": "First custom SSH key path (for non-multiuser mode)."
  },
  "ssh_add_key_2": {
    "type": "string",
    "default": "/path/to/id_rsa2",
    "description": "Second custom SSH key path (for non-multiuser mode)."
  },
  "ssh_multiuser_opt_cmd_flags": {
    "type": "string",
    "default": "-t -o StrictHostKeyChecking=no",
    "description": "SSH flags for multiuser setup (e.g., disable host key checking)."
  },
  "ssh_multiuser_spawn_agent": {
    "type": "string",
    "default": "true",
    "description": "Whether to spawn ssh-agent for multiuser sessions.",
    "enum": [
      "true",
      "false"
    ]
  },
  "ssh_multiuser_add_key": {
    "type": "string",
    "default": "/etc/apt-dater/ssh/id_rsa",
    "description": "Shared SSH key path for multiuser mode."
  },
  "paths_hosts_file": {
    "type": "string",
    "default": "/etc/apt-dater/hosts.xml",
    "description": "Path to the hosts configuration XML file."
  },
  "paths_history_dir": {
    "type": "string",
    "default": "/var/lib/apt-dater/history",
    "description": "Directory for storing host operation history files."
  },
  "paths_stats_dir": {
    "type": "string",
    "default": "/var/cache/apt-dater/stats",
    "description": "Directory for storing statistics."
  },
  "paths_umask": {
    "type": "string",
    "default": "007",
    "description": "Umask to apply when creating files/dirs (multiuser mode).",
    "enum": [
      "000",
      "007"
    ]
  },
  "screen_rc_file": {
    "type": "string",
    "default": "path-to/screenrc",
    "description": "Path to custom screenrc configuration file."
  },
  "screen_title": {
    "type": "string",
    "default": "%m # %u@%h:%p",
    "description": "Screen window title format (uses screen escape sequences)."
  },
  "tmux_socket_path": {
    "type": "string",
    "default": "/var/cache/apt-dater/tmux",
    "description": "Shared tmux socket path (multiuser mode)."
  },
  "appearance_colors": {
    "type": "string",
    "default": "menu brightgreen blue;status brightgreen blue;selector black red;",
    "description": "Color configuration for UI components (format: 'component fg bg;')."
  },
  "notify_beep": {
    "type": "string",
    "default": "true",
    "description": "Enable terminal bell notification.",
    "enum": [
      "true",
      "false"
    ]
  },
  "notify_flash": {
    "type": "string",
    "default": "true",
    "description": "Enable screen flash notification.",
    "enum": [
      "true",
      "false"
    ]
  },
  "hooks_plugin_dir": {
    "type": "string",
    "default": "/etc/apt-dater/plugins",
    "description": "Directory containing host plugins."
  },
  "hooks_pre_upgrade": {
    "type": "string",
    "default": "/etc/apt-dater/pre-upg.d",
    "description": "Path to pre-upgrade hook directory."
  },
  "hooks_post_upgrade": {
    "type": "string",
    "default": "/etc/apt-dater/post-upg.d",
    "description": "Path to post-upgrade hook directory."
  },
  "hooks_pre_refresh": {
    "type": "string",
    "default": "/etc/apt-dater/pre-ref.d",
    "description": "Path to pre-refresh hook directory."
  },
  "hooks_post_refresh": {
    "type": "string",
    "default": "/etc/apt-dater/post-ref.d",
    "description": "Path to post-refresh hook directory."
  },
  "hooks_pre_install": {
    "type": "string",
    "default": "/etc/apt-dater/pre-ins.d",
    "description": "Path to pre-install hook directory."
  },
  "hooks_post_install": {
    "type": "string",
    "default": "/etc/apt-dater/post-ins.d",
    "description": "Path to post-install hook directory."
  },
  "hooks_pre_connect": {
    "type": "string",
    "default": "/etc/apt-dater/pre-con.d",
    "description": "Path to pre-connect hook directory."
  },
  "hooks_post_connect": {
    "type": "string",
    "default": "/etc/apt-dater/post-con.d",
    "description": "Path to post-connect hook directory."
  }
}
