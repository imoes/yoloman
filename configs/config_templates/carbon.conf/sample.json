{
  "whisper_dir": "/var/lib/graphite/whisper",
  "whisper_user": "carbon",
  "log_level": "info",
  "log_file": "/var/log/carbon/carbon.log",
  "use_systick": false,
  "max_creates_per_minute": 100,
  "max_updates_per_second": 1000,
  "max_updates_queue_size": 10000,
  "max_updates_buffer_size": 1048576,
  "relay": {
    "enabled": true,
    "destinations": [
      {
        "host": "10.0.0.1",
        "port": 2004,
        "instance": "a"
      },
      {
        "host": "10.0.0.2",
        "port": 2004,
        "instance": "b"
      }
    ],
    "method": "consistent",
    "consistent_hashing": true,
    "hash_key": "metric"
  },
  "aggregator": {
    "enabled": false,
    "rules_file": "/etc/carbon/aggregator-rules.conf",
    "max_queue_size": 10000
  },
  "cache": {
    "enabled": true,
    "line_receiver_port": 2003,
    "pickle_receiver_port": 2004,
    "max_connections": 1000,
    "pickle_receiver_buffer_size": 1048576,
    "enable_logging": false,
    "max_updates_per_second": 2000,
    "max_creates_per_minute": 150,
    "max_updates_queue_size": 20000,
    "max_creates_queue_size": 2000,
    "enable_udp_listener": false,
    "udp_receiver_port": 2003
  }
}
