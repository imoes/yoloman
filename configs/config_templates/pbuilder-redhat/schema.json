{
  "LOGLEVEL": {
    "type": "string",
    "default": "I",
    "description": "Log level: E (errors), W (warnings), I (info), D (debug)",
    "enum": [
      "E",
      "W",
      "I",
      "D"
    ]
  },
  "USECOLORS": {
    "type": "string",
    "default": "auto",
    "description": "Use colors in logs: auto, yes, no",
    "enum": [
      "auto",
      "yes",
      "no"
    ]
  },
  "BASETGZ": {
    "type": "string",
    "default": "/var/cache/pbuilder/base.tgz",
    "description": "Path to the base tarball"
  },
  "BUILDPLACE": {
    "type": "string",
    "default": "/var/cache/pbuilder/build",
    "description": "Directory where builds take place"
  },
  "BUILDDIR": {
    "type": "string",
    "default": "/build",
    "description": "Build directory inside the chroot"
  },
  "BUILD_HOME": {
    "type": "string",
    "default": "/nonexistent",
    "description": "HOME directory during builds"
  },
  "MIRRORSITE": {
    "type": "string",
    "default": "http://deb.debian.org/debian",
    "description": "APT mirror site URL"
  },
  "USESHM": {
    "type": "string",
    "default": "yes",
    "description": "Use shared memory in chroot"
  },
  "USEPROC": {
    "type": "string",
    "default": "yes",
    "description": "Mount /proc in chroot"
  },
  "USEDEVFS": {
    "type": "string",
    "default": "no",
    "description": "Mount devfs in chroot"
  },
  "USEDEVPTS": {
    "type": "string",
    "default": "yes",
    "description": "Mount devpts in chroot"
  },
  "USESYSFS": {
    "type": "string",
    "default": "yes",
    "description": "Mount sysfs in chroot"
  },
  "USENETWORK": {
    "type": "string",
    "default": "no",
    "description": "Enable network access in chroot"
  },
  "USECGROUP": {
    "type": "string",
    "default": "yes",
    "description": "Mount cgroup in chroot"
  },
  "BUILDRESULT": {
    "type": "string",
    "default": "/var/cache/pbuilder/result/",
    "description": "Directory for build results"
  },
  "COMPONENTS": {
    "type": "string",
    "default": "\"main\"",
    "description": "APT repository components (e.g., main contrib non-free)"
  },
  "APTCACHE": {
    "type": "string",
    "default": "\"/var/cache/pbuilder/aptcache/\"",
    "description": "Path to APT cache directory"
  },
  "APTCACHEHARDLINK": {
    "type": "string",
    "default": "\"yes\"",
    "description": "Use hardlinks for APT cache"
  },
  "REMOVEPACKAGES": {
    "type": "string",
    "default": "\"\"",
    "description": "Space-separated list of packages to remove after build"
  },
  "HOOKDIR": {
    "type": "string",
    "default": "\"\"",
    "description": "Directory containing pbuilder hooks"
  },
  "EATMYDATA": {
    "type": "string",
    "default": "no",
    "description": "Use eatmydata to speed up build"
  },
  "BUILDSOURCEROOTCMD": {
    "type": "string",
    "default": "\"fakeroot\"",
    "description": "Command to run build as root for sources"
  },
  "PBUILDERROOTCMD": {
    "type": "string",
    "default": "\"sudo -E\"",
    "description": "Command to run pbuilder with elevated privileges"
  },
  "SOURCE_ONLY_CHANGES": {
    "type": "string",
    "default": "yes",
    "description": "Generate .changes file for source-only uploads"
  },
  "PBUILDERSATISFYDEPENDSCMD": {
    "type": "string",
    "default": "\"/usr/lib/pbuilder/pbuilder-satisfydepends-apt\"",
    "description": "Command to satisfy build dependencies"
  },
  "ALLOWUNTRUSTED": {
    "type": "string",
    "default": "no",
    "description": "Allow untrusted APT repositories"
  },
  "DEBDELTA": {
    "type": "string",
    "default": "no",
    "description": "Use debdelta for package updates"
  },
  "APTCONFDIR": {
    "type": "string",
    "default": "\"\"",
    "description": "Directory for APT configuration files"
  },
  "BUILDUSERNAME": {
    "type": "string",
    "default": "pbuilder",
    "description": "Username used inside the chroot"
  },
  "BINDMOUNTS": {
    "type": "string",
    "default": "\"\"",
    "description": "Space-separated list of paths to bind-mount into chroot"
  },
  "DEBOOTSTRAP": {
    "type": "string",
    "default": "\"debootstrap\"",
    "description": "Command to use for debootstrap"
  },
  "COMPRESSPROG": {
    "type": "string",
    "default": "\"gzip\"",
    "description": "Compression program to use"
  },
  "CONFDIR": {
    "type": "string",
    "default": "\"/etc/pbuilder/conf_files\"",
    "description": "Directory containing custom config files to copy to chroot"
  },
  "CCACHEDIR": {
    "type": "string",
    "default": "\"\"",
    "description": "Path to ccache directory (empty to disable)"
  }
}
