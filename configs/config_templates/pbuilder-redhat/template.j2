# pbuilder defaults; edit /etc/pbuilderrc to override these and see
# pbuilderrc.5 for documentation

# Log level: E (errors), W (warnings), I (info), D (debug)
LOGLEVEL={{ LOGLEVEL | default('I') }}

# Use colors in logs: auto, yes, no
USECOLORS={{ USECOLORS | default('auto') }}

# Path to the base tarball
BASETGZ={{ BASETGZ | default('/var/cache/pbuilder/base.tgz') }}

# Directory where builds take place
BUILDPLACE={{ BUILDPLACE | default('/var/cache/pbuilder/build') }}

# Build directory inside the chroot
BUILDDIR={{ BUILDDIR | default('/build') }}

# HOME directory during builds
BUILD_HOME={{ BUILD_HOME | default('/nonexistent') }}

# APT mirror site URL
MIRRORSITE={{ MIRRORSITE | default('http://deb.debian.org/debian') }}

# Use shared memory in chroot
USESHM={{ USESHM | default('yes') }}

# Mount /proc in chroot
USEPROC={{ USEPROC | default('yes') }}

# Mount devfs in chroot
USEDEVFS={{ USEDEVFS | default('no') }}

# Mount devpts in chroot
USEDEVPTS={{ USEDEVPTS | default('yes') }}

# Mount sysfs in chroot
USESYSFS={{ USESYSFS | default('yes') }}

# Enable network access in chroot
USENETWORK={{ USENETWORK | default('no') }}

# Mount cgroup in chroot
USECGROUP={{ USECGROUP | default('yes') }}

# Directory for build results
BUILDRESULT={{ BUILDRESULT | default('/var/cache/pbuilder/result/') }}

# APT repository components (e.g., main contrib non-free)
# Note: The schema default includes quotes; Jinja renders them literally.
# If you want a shell array or unquoted string, ensure your input variable
# is a list or string without surrounding quotes.
COMPONENTS={{ COMPONENTS | default('"main"') }}

# Path to APT cache directory
# Note: The schema default includes quotes.
APTCACHE={{ APTCACHE | default('"/var/cache/pbuilder/aptcache/"') }}

# Use hardlinks for APT cache
# Note: The schema default includes quotes.
APTCACHEHARDLINK={{ APTCACHEHARDLINK | default('"yes"') }}

# Space-separated list of packages to remove after build
# Note: The schema default is an empty string.
REMOVEPACKAGES={{ REMOVEPACKAGES | default('""') }}

# Directory containing pbuilder hooks
# Note: The schema default is an empty string.
HOOKDIR={{ HOOKDIR | default('""') }}

# Use eatmydata to speed up build
EATMYDATA={{ EATMYDATA | default('no') }}

# Command to run build as root for sources
# Note: The schema default includes quotes.
BUILDSOURCEROOTCMD={{ BUILDSOURCEROOTCMD | default('"fakeroot"') }}

# Command to run pbuilder with elevated privileges
# Note: The schema default includes quotes.
PBUILDERROOTCMD={{ PBUILDERROOTCMD | default('"sudo -E"') }}

# Generate .changes file for source-only uploads
SOURCE_ONLY_CHANGES={{ SOURCE_ONLY_CHANGES | default('yes') }}

# Command to satisfy build dependencies
# Note: The schema default includes quotes.
PBUILDERSATISFYDEPENDSCMD={{ PBUILDERSATISFYDEPENDSCMD | default('"/usr/lib/pbuilder/pbuilder-satisfydepends-apt"') }}

# Allow untrusted APT repositories
ALLOWUNTRUSTED={{ ALLOWUNTRUSTED | default('no') }}

# Use debdelta for package updates
DEBDELTA={{ DEBDELTA | default('no') }}

# Directory for APT configuration files
# Note: The schema default is an empty string.
APTCONFDIR={{ APTCONFDIR | default('""') }}

# Username used inside the chroot
BUILDUSERNAME={{ BUILDUSERNAME | default('pbuilder') }}

# Space-separated list of paths to bind-mount into chroot
# Note: The schema default is an empty string.
BINDMOUNTS={{ BINDMOUNTS | default('""') }}

# Command to use for debootstrap
# Note: The schema default includes quotes.
DEBOOTSTRAP={{ DEBOOTSTRAP | default('"debootstrap"') }}

# Compression program to use
# Note: The schema default includes quotes.
COMPRESSPROG={{ COMPRESSPROG | default('"gzip"') }}

# Directory containing custom config files to copy to chroot
# Note: The schema default includes quotes.
CONFDIR={{ CONFDIR | default('"/etc/pbuilder/conf_files"') }}

# Path to ccache directory (empty to disable)
# Note: The schema default is an empty string.
CCACHEDIR={{ CCACHEDIR | default('""') }}
