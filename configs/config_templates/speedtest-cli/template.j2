# ==============================================================================
# speedtest-cli Configuration Template
# ==============================================================================
# This template generates the configuration file for the `speedtest-cli` tool.
# It maps schema fields to boolean switches, integer timeouts, and list arguments.
# ==============================================================================

# --- General Connection Settings ---

# Use HTTPS instead of HTTP when communicating with speedtest.net operated servers.
# See --secure flag
# Type: boolean
SECURE_ENABLED: {{ secure_enabled | default(false) }}

# HTTP timeout in seconds.
# See --timeout flag
# Type: integer
TIMEOUT: {{ timeout | default(10) }}

# --- Output Formatting Settings ---

# Display values in bytes instead of bits.
# Note: Does not affect the image generated by --share, nor output from --json or --csv.
# See --bytes flag
# Type: boolean
BYTES_MODE: {{ bytes_mode | default(false) }}

# Suppress verbose output, only show basic information.
# See --simple flag
# Type: boolean
SIMPLE_OUTPUT: {{ simple_output | default(false) }}

# Suppress verbose output, only show basic information in CSV format.
# Speeds listed in bit/s and are not affected by --bytes.
# See --csv flag
# Type: boolean
CSV_OUTPUT: {{ csv_output | default(false) }}

# Single character delimiter to use in CSV output.
# See --csv-delimiter flag
# Type: string
CSV_DELIMITER: "{{ csv_delimiter | default(',') }}"

# Print CSV headers when using CSV output.
# See --csv-header flag
# Type: boolean
CSV_HEADER: {{ csv_header | default(false) }}

# Suppress verbose output, only show basic information in JSON format.
# Speeds listed in bit/s and are not affected by --bytes.
# See --json flag
# Type: boolean
JSON_OUTPUT: {{ json_output | default(false) }}

# --- Server Selection Settings ---

# Specify a server ID to test against.
# Can be supplied multiple times.
# See --server flag
# Type: list
# Renders as space-separated arguments if items exist.
{% if server_ids | default([]) | length > 0 %}
SERVER_IDS: {{ server_ids | default([]) | join(' ') }}
{% endif %}

# Exclude a server from selection.
# Can be supplied multiple times.
# See --exclude flag
# Type: list
# Renders as space-separated arguments if items exist.
{% if excluded_servers | default([]) | length > 0 %}
EXCLUDED_SERVERS: {{ excluded_servers | default([]) | join(' ') }}
{% endif %}

# URL of the Speedtest Mini server to use for testing.
# See --mini flag
# Type: string
{% if mini_server_url | default('') | length > 0 %}
MINI_SERVER_URL: "{{ mini_server_url | default('') }}"
{% endif %}

# Source IP address to bind to for the connection.
# See --source flag
# Type: string
{% if source_ip | default('') | length > 0 %}
SOURCE_IP: "{{ source_ip | default('') }}"
{% endif %}

# --- Test Behavior Settings ---

# Do not perform download test.
# See --no-download flag
# Type: boolean
NO_DOWNLOAD: {{ no_download | default(false) }}

# Do not perform upload test.
# See --no-upload flag
# Type: boolean
NO_UPLOAD: {{ no_upload | default(false) }}

# Only use a single connection instead of multiple.
# This simulates a typical file transfer.
# See --single flag
# Type: boolean
SINGLE_CONNECTION: {{ single_connection | default(false) }}

# Do not pre-allocate upload data.
# Pre-allocation is enabled by default to improve upload performance.
# Use this option to support systems with insufficient memory to avoid MemoryError.
# See --no-pre-allocate flag
# Type: boolean
NO_PRE_ALLOCATE: {{ no_pre_allocate | default(false) }}

# Generate and provide a URL to the speedtest.net share results image.
# Note: Not displayed when using --csv.
# See --share flag
# Type: boolean
SHARE_RESULTS: {{ share_results | default(false) }}