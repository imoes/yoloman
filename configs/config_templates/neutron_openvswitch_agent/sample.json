{
  "log_dir": "/var/log/neutron",
  "log_file": "ovs-agent.log",
  "verbose": true,
  "debug": false,
  "rpc_transport_url": "rabbit://neutron:secretpass@controller:5672/",
  "auth_strategy": "keystone",
  "report_interval": 30,
  "min_broadcast_domain_size": 0,
  "l2_population": true,
  "extension_drivers": [
    "port_security",
    "qos",
    "security_group"
  ],
  "qos_extension_driver": true,
  "port_security_extension_driver": true,
  "trunk_extension_driver": false,
  "sriov_extension_driver": false,
  "security_group_extension_driver": true,
  "qos_limit_direction": "both",
  "bridge_mappings": [
    {
      "type": "flat",
      "bridge": "br-ex"
    },
    {
      "type": "vlan",
      "bridge": "br-vlan"
    }
  ],
  "ovs_integration_bridge": "br-int",
  "ovs_tunnel_bridge": "br-tun",
  "ovs_local_ip": "192.168.1.10",
  "ovs_enable_tunneling": true,
  "ovs_tunnel_types": [
    "vxlan"
  ],
  "ovs_vxlan_udp_port": 4789,
  "ovs_vxlan_group": "",
  "ovs_arp_responder": true,
  "ovs_use_centralized_nat": false,
  "ovs_dvr_snat_default_br": "br-snat",
  "securitygroup_enable_security_group": true,
  "securitygroup_firewall_driver": "openvswitch",
  "securitygroup_log_dropped_traffic": false,
  "l3_enable_distributed_routing": true,
  "l3_ha_max_agents_per_router": 2,
  "l3_l3_ha": false,
  "l3_min_l3_agents_per_router": 1,
  "ml2_type_drivers": [
    "flat",
    "vlan",
    "vxlan"
  ],
  "ml2_tenant_network_types": [
    "vxlan"
  ],
  "ml2_mechanism_drivers": [
    "openvswitch"
  ],
  "ml2_extension_drivers": [
    "port_security",
    "qos",
    "security_group"
  ]
}
