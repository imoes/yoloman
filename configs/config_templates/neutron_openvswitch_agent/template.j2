# =============================================================================
# Neutron Open vSwitch Agent Configuration Template
# =============================================================================
# This template generates the /etc/neutron/plugin.ini or /etc/neutron/
# openvswitch_agent.ini configuration file for the Neutron OVS agent.
# It covers logging, RPC transport, extension drivers, OVS tunneling,
# security groups, L3 DVR, and ML2 backend settings.
# =============================================================================

[DEFAULT]
# Directory to store log files.
log_dir = {{ log_dir | default('/var/log/neutron') }}
# Name of the log file (relative to log_dir).
log_file = {{ log_file | default('ovs-agent.log') }}
# Logging format string.
log_format = %(asctime)s.%(msecs03d %(levelname)-8s] %(message)s
# Logging date format.
log_date_format = %Y-%m-%d %H:%M:%S
# Enable verbose logging (INFO level and above).
verbose = {{ verbose | default(True) | lower }}
# Enable debug-level logging.
debug = {{ debug | default(False) | lower }}

# Messaging transport URL for RPC communication (e.g., RabbitMQ).
# Format: transport://user:pass@host:port/virtual_host
rpc_transport_url = {{ rpc_transport_url | default('rabbit://neutron:neutron@controller:5672/') }}

# Authentication strategy. Use 'keystone' for Keystone-based auth.
auth_strategy = {{ auth_strategy | default('keystone') }}

[agent]
# L2 agent type — must be 'openvswitch'.
agent_type = openvswitch
# Seconds between agent state reports to Neutron server.
report_interval = {{ report_interval | default(30) }}
# Minimum broadcast domain size for L2 agent health checks.
# Set > 0 only if needed for legacy environments.
min_broadcast_domain_size = {{ min_broadcast_domain_size | default(0) }}
# Enable L2 population driver for optimized flooding in tunnel networks
# (required for DVR).
l2_population = {{ l2_population | default(True) | lower }}
# List of extension drivers to enable (comma-separated string when rendered).
extension_drivers = {{ extension_drivers | default(['port_security', 'qos', 'security_group']) | join(', ') }}
# Explicit toggle for QoS extension driver (used as fallback if not in extension_drivers list).
qos_extension_driver = {{ qos_extension_driver | default(True) | lower }}
# Explicit toggle for Port Security extension driver.
port_security_extension_driver = {{ port_security_extension_driver | default(True) | lower }}
# Enable trunk extension driver for subport management.
trunk_extension_driver = {{ trunk_extension_driver | default(False) | lower }}
# Enable SR-IOV extension driver for bare-metal SR-IOV ports.
sriov_extension_driver = {{ sriov_extension_driver | default(False) | lower }}
# Enable security group extension driver (often auto-enabled via extension_drivers).
security_group_extension_driver = {{ security_group_extension_driver | default(True) | lower }}
# Direction for QoS bandwidth limits (ingress, egress, or both).
qos_limit_direction = {{ qos_limit_direction | default('both') }}

# List of network type to OVS bridge mappings
# (e.g., flat networks → br-ex, VLANs → br-vlan).
# Rendered as one directive per mapping: bridge_mappings = type:bridge
{% for item in bridge_mappings | default([{'type': 'flat', 'bridge': 'br-ex'}, {'type': 'vlan', 'bridge': 'br-vlan'}]) %}
# Bridge mapping: {{ item.type }} -> {{ item.bridge }}
bridge_mappings = {{ item.type }}:{{ item.bridge }}
{% endfor %}

[ovs]
# OVS integration bridge name for tenant traffic.
integration_bridge = {{ ovs_integration_bridge | default('br-int') }}
# OVS tunnel bridge name for VXLAN/GRE tunnels.
tunnel_bridge = {{ ovs_tunnel_bridge | default('br-tun') }}
# Local IP address used for tunnel endpoints
# (must be reachable by other compute hosts).
local_ip = {{ ovs_local_ip | default('10.0.0.1') }}
# Enable overlay network tunneling (VXLAN/GRE).
enable_tunneling = {{ ovs_enable_tunneling | default(True) | lower }}
# List of tunnel types to use (comma-separated in rendered config).
tunnel_types = {{ ovs_tunnel_types | default(['vxlan']) | join(', ') }}
# UDP port for VXLAN tunneling (standard: 4789).
vxlan_udp_port = {{ ovs_vxlan_udp_port | default(4789) }}
# Multicast group for VXLAN learning
# (e.g., '239.1.1.1'). Leave empty to disable (recommended with L2POP).
vxlan_group = {{ ovs_vxlan_group | default('') }}
# Enable ARP responder in OVS to respond to ARP requests locally.
arp_responder = {{ ovs_arp_responder | default(True) | lower }}
# Enable centralized NAT (SNAT) for external network access (non-DVR mode).
use_centralized_nat = {{ ovs_use_centralized_nat | default(False) | lower }}
# OVS bridge used for SNAT in DVR mode
# (when centralized NAT is disabled).
dvr_snat_default_br = {{ ovs_dvr_snat_default_br | default('br-snat') }}

[securitygroup]
# Enable security groups for instances.
enable_security_group = {{ securitygroup_enable_security_group | default(True) | lower }}
# Firewall driver: 'openvswitch' (OVS flow-based) or 'iptables' (legacy).
firewall_driver = {{ securitygroup_firewall_driver | default('openvswitch') }}
# Log dropped packets for security group rules.
log_dropped_traffic = {{ securitygroup_log_dropped_traffic | default(False) | lower }}

[l3]
# Enable distributed virtual routing (DVR) support in the agent.
enable_distributed_routing = {{ l3_enable_distributed_routing | default(False) | lower }}
# Maximum number of L3 agents to schedule per HA router.
ha_max_agents_per_router = {{ l3_ha_max_agents_per_router | default(2) }}
# Enable high-availability mode for L3 services (requires DVR).
l3_ha = {{ l3_l3_ha | default(False) | lower }}
# Minimum number of L3 agents required to keep a router functional.
min_l3_agents_per_router = {{ l3_min_l3_agents_per_router | default(1) }}

[ml2]
# List of ML2 type drivers enabled
# (must include types used by bridge_mappings).
type_drivers = {{ ml2_type_drivers | default(['vxlan']) | join(', ') }}
# Network types available for tenant provisioning.
tenant_network_types = {{ ml2_tenant_network_types | default(['vxlan']) | join(', ') }}
# Mechanism drivers that map network types to OVS or other backends.
mechanism_drivers = {{ ml2_mechanism_drivers | default(['openvswitch']) | join(', ') }}
# Extension drivers for ML2
# (same as agent extension_drivers, used in Neutron server).
extension_drivers = {{ ml2_extension_drivers | default(['port_security', 'qos', 'security_group']) | join(', ') }}