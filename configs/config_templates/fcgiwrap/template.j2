#!/bin/sh
### BEGIN INIT INFO
# Provides:          fcgiwrap
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: FastCGI wrapper for CGI scripts
# Description:       Spawns a FastCGI server that executes CGI scripts
### END INIT INFO

# Adjust these variables to suit your environment
FCGI_SOCKET={{ socket_path }}
FCGI_USER={{ user }}
FCGI_GROUP={{ group }}
FCGI_NUM_PROCESSES={{ num_processes }}
FCGI_CHMOD_SOCKET={{ socket_mode | default('0660') }}

DAEMON=/usr/bin/spawn-fcgi
DAEMON_OPTS="-s $FCGI_SOCKET -u $FCGI_USER -g $FCGI_GROUP -C $FCGI_NUM_PROCESSES /usr/sbin/fcgiwrap"

NAME=fcgiwrap
DESC="FastCGI wrapper for CGI scripts"

. /lib/lsb/init-functions

case "$1" in
  start)
    log_daemon_msg "Starting $DESC"
    # Ensure parent directory exists and has correct permissions
    mkdir -p "$(dirname $FCGI_SOCKET)"
    chown $FCGI_USER:$FCGI_GROUP "$(dirname $FCGI_SOCKET)" 2>/dev/null || true
    if start-stop-daemon --start --quiet --pidfile /var/run/$NAME.pid --exec $DAEMON -- $DAEMON_OPTS; then
      log_end_msg 0
    else
      log_end_msg 1
      exit 1
    fi
    ;;
  stop)
    log_daemon_msg "Stopping $DESC"
    if start-stop-daemon --stop --quiet --pidfile /var/run/$NAME.pid --retry 5; then
      log_end_msg 0
    else
      log_end_msg 1
      exit 1
    fi
    ;;
  restart|force-reload)
    $0 stop
    $0 start
    ;;
  status)
    status_of_proc -p /var/run/$NAME.pid "$DAEMON" $NAME && exit 0 || exit $?
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0