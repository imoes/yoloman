{
  "socket_path": {
    "type": "string",
    "default": "/run/fcgiwrap.socket",
    "description": "Path to the FastCGI Unix socket"
  },
  "user": {
    "type": "string",
    "default": "www-data",
    "description": "User to run fcgiwrap as"
  },
  "group": {
    "type": "string",
    "default": "www-data",
    "description": "Group to run fcgiwrap as"
  },
  "num_processes": {
    "type": "number",
    "default": 1,
    "description": "Number of worker processes to spawn"
  }
}
