{
  "verbose": 1,
  "log_level": "WARN",
  "max_image_cache_size": 200,
  "cache_expiration_time": 7200,
  "max_size": 16384,
  "jpeg_quality": 85,
  "webp_quality": 85,
  "max_jpeg_size": 200,
  "min_zoom_level": 0,
  "max_zoom_level": 24,
  "tile_size": 512,
  "tile_overlap": 1,
  "compression": "webp",
  "allow_animated_gif": false,
  "allow_animated_webp": true,
  "use_caching": true,
  "use_shared_memory": true,
  "shared_memory_key": 17767,
  "log_file": "/var/log/iipimage/iipimage.log",
  "log_format": "%Y-%m-%d %H:%M:%S",
  "bind_address": "127.0.0.1",
  "port": 8000,
  "max_connections": 200,
  "timeout": 60,
  "max_workers": 8,
  "max_threads": 20,
  "enable_ssl": true,
  "ssl_cert_file": "/etc/ssl/certs/iipimage.crt",
  "ssl_key_file": "/etc/ssl/private/iipimage.key",
  "formats": [
    {
      "type": "tiff",
      "loader": "tiff",
      "options": "threads=4"
    },
    {
      "type": "jp2",
      "loader": "j2k",
      "options": ""
    },
    {
      "type": "jpeg",
      "loader": "jpeg",
      "options": ""
    },
    {
      "type": "png",
      "loader": "png",
      "options": ""
    },
    {
      "type": "webp",
      "loader": "webp",
      "options": "quality=85"
    }
  ],
  "paths": [
    {
      "alias": "/images",
      "path": "/data/images",
      "read_only": false,
      "recursive": true
    },
    {
      "alias": "/private",
      "path": "/data/private",
      "read_only": true,
      "recursive": true
    }
  ]
}
