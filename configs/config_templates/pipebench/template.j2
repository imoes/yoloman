# pipebench configuration
#
# This template configures the `pipebench` utility, a simple tool for testing
# pipe and I/O throughput by piping data between processes.
# Each section below corresponds to a command-line flag and is documented
# with the schema description for clarity.

# --- Error Handling ---

# error_exit (default: False)
# Exit immediately if an error occurs, breaking the pipe.
# If false, it prints to stderr and continues.
# Corresponds to the -e flag.
ERROR_EXIT: {{ error_exit | default(false) }}

# --- Output Verbosity ---

# quiet (default: False)
# Only show summary statistics.
# Corresponds to the -q flag.
QUIET: {{ quiet | default(false) }}

# silent (default: False)
# Don't show running speed or summary stats.
# Corresponds to the -Q flag.
SILENT: {{ silent | default(false) }}

# no_summary (default: False)
# Don't show the final summary.
# Corresponds to the -o flag.
NO_SUMMARY: {{ no_summary | default(false) }}

# raw_speed (default: False)
# Show only raw speed, no fancy stats or summary.
# Corresponds to the -r flag.
RAW_SPEED: {{ raw_speed | default(false) }}

# decimal_units (default: False)
# Use 1kB = 1000B instead of the default 1024B.
# Corresponds to the -I flag.
DECIMAL_UNITS: {{ decimal_units | default(false) }}

# no_units (default: False)
# Don't convert to units (kilo, Mega, etc...), show raw bytes.
# Corresponds to the -u flag.
NO_UNITS: {{ no_units | default(false) }}

# --- Performance Tuning ---

# buffer_size (default: 65536)
# Buffer size in bytes for I/O operations.
# Corresponds to the -b flag.
BUFFER_SIZE: {{ buffer_size | default(65536) }}

# --- Status Reporting ---

# status_file (default: '/dev/null')
# Path to write status updates to instead of stderr.
# Corresponds to the -s flag.
STATUS_FILE: {{ status_file | default('/dev/null') }}