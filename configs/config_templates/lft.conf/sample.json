{
  "verbose": true,
  "interface": "eth0",
  "tcp_ports": [
    80,
    443
  ],
  "udp_ports": [
    53
  ],
  "max_connections": 500,
  "pidfile": "/var/run/lft.pid",
  "logfile": "/var/log/lft/lft.log",
  "promiscuous": true,
  "whitelist": [],
  "blacklist": [
    "192.168.1.1",
    "10.0.0.1"
  ],
  "connection_timeout": 120,
  "stats_interval": 30,
  "payload_capture": false,
  "max_payload_size": 256,
  "dns_lookup": true
}
