# QLC+ Service Configuration
# Self-documenting Jinja2 template generated for Ansible.
# All variable references include safe defaults matching the schema definitions.

[General]
# Start mode for fullscreen. 'normal' or 'resize'.
Fullscreen={{ fullscreen | default('normal') }}

# Enable kiosk mode where the application is locked in operate mode.
Kiosk={{ kiosk | default(false) | lower }}

# Start the application in Operate mode.
Operate={{ operate | default(false) | lower }}

# Position for close button in virtual console: x,y,w,h. Only effective in kiosk mode.
CloseButton={{ closebutton | default('10,10,50,30') }}

[Network]
# Port number for remote web access.
WebPort={{ web_port | default(9999) }}

# Locale for translation. Supported: ca_ES, cz_CZ, de_DE, en_GB, es_ES, fi_FI, fr_FR, it_IT, ja_JP, nl_NL, pt_BR.
Locale={{ locale | default('en_GB') }}

[Logging]
# Enable logging debug messages to $HOME/QLC+.log.
LogFileEnabled={{ log_file_enabled | default(false) | lower }}

# Debug output level (0-3). Note that level 0 is not included in released binaries.
DebugLevel={{ debug_level | default(0) }}

[Paths]
# Path to a .qxw workspace file to open on startup.
WorkspaceFile={{ workspace_file | default('') }}