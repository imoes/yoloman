{
  "bucket": {
    "type": "string",
    "default": "",
    "description": "The S3 bucket name to use for storing blocks."
  },
  "mount_point": {
    "type": "string",
    "default": "/mnt/s3backer",
    "description": "The local mount point for the s3backer filesystem."
  },
  "access_file": {
    "type": "string",
    "default": "/home/s3backer/.s3backer_passwd",
    "description": "Path to the file containing accessID:accessKey pairs."
  },
  "access_ec2_iam": {
    "type": "string",
    "default": "",
    "description": "AWS IAM role name for automatic credential retrieval."
  },
  "access_id": {
    "type": "string",
    "default": "",
    "description": "AWS access ID."
  },
  "access_key": {
    "type": "string",
    "default": "",
    "description": "AWS access key."
  },
  "auth_version": {
    "type": "string",
    "default": "aws4",
    "description": "Authentication version: aws2 or aws4.",
    "enum": [
      "aws2",
      "aws4"
    ]
  },
  "base_url": {
    "type": "string",
    "default": "http://s3.amazonaws.com/",
    "description": "Base URL for the S3 service."
  },
  "block_size": {
    "type": "number",
    "default": 4096,
    "description": "Block size for the virtual disk."
  },
  "size": {
    "type": "string",
    "default": "",
    "description": "Total size of the backed virtual disk file."
  },
  "filename": {
    "type": "string",
    "default": "file",
    "description": "Name of the file exported by the s3backer filesystem."
  },
  "file_mode": {
    "type": "string",
    "default": "0600",
    "description": "UNIX permission mode for the backed file."
  },
  "stats_filename": {
    "type": "string",
    "default": "stats",
    "description": "Name of the statistics file."
  },
  "prefix": {
    "type": "string",
    "default": "",
    "description": "Prefix for S3 object names."
  },
  "sse": {
    "type": "string",
    "default": "",
    "description": "Server-side encryption algorithm (e.g., AES256)."
  },
  "encrypt": {
    "type": "string",
    "default": "",
    "description": "Enable client-side encryption.",
    "enum": [
      "false",
      "true"
    ]
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Encryption password."
  },
  "password_file": {
    "type": "string",
    "default": "",
    "description": "Path to file containing encryption password."
  },
  "storage_class": {
    "type": "string",
    "default": "STANDARD",
    "description": "S3 storage class.",
    "enum": [
      "STANDARD",
      "STANDARD_IA",
      "REDUCED_REDUNDANCY"
    ]
  },
  "compress": {
    "type": "string",
    "default": "false",
    "description": "Enable compression (optional level 1-9).",
    "enum": [
      "false",
      "true",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "9"
    ]
  },
  "block_cache_size": {
    "type": "number",
    "default": 1000,
    "description": "Size of the block cache in number of blocks."
  },
  "block_cache_file": {
    "type": "string",
    "default": "",
    "description": "Path to persistent block cache file."
  },
  "block_cache_max_dirty": {
    "type": "number",
    "default": 0,
    "description": "Max dirty blocks in cache."
  },
  "block_cache_threads": {
    "type": "number",
    "default": 20,
    "description": "Number of block cache worker threads."
  },
  "block_cache_timeout": {
    "type": "number",
    "default": 0,
    "description": "Clean block cache timeout in ms."
  },
  "block_cache_write_delay": {
    "type": "number",
    "default": 250,
    "description": "Dirty block write delay in ms."
  },
  "block_cache_sync": {
    "type": "bool",
    "default": false,
    "description": "Enable synchronous writes."
  },
  "block_cache_recover_dirty_blocks": {
    "type": "bool",
    "default": false,
    "description": "Recover dirty blocks on startup."
  },
  "block_cache_no_verify": {
    "type": "bool",
    "default": false,
    "description": "Disable MD5 verification for cached blocks."
  },
  "md5_cache_size": {
    "type": "number",
    "default": 1000,
    "description": "Size of the MD5 checksum cache."
  },
  "md5_cache_time": {
    "type": "number",
    "default": 10000,
    "description": "MD5 cache time in ms."
  },
  "min_write_delay": {
    "type": "number",
    "default": 500,
    "description": "Min write delay in ms."
  },
  "read_ahead": {
    "type": "number",
    "default": 4,
    "description": "Number of blocks to read ahead."
  },
  "read_ahead_trigger": {
    "type": "number",
    "default": 2,
    "description": "Consecutive blocks to trigger read ahead."
  },
  "vhost": {
    "type": "bool",
    "default": false,
    "description": "Force virtual hosted style requests."
  },
  "ssl": {
    "type": "bool",
    "default": false,
    "description": "Use SSL."
  },
  "insecure": {
    "type": "bool",
    "default": false,
    "description": "Do not verify SSL certificate."
  },
  "cacert": {
    "type": "string",
    "default": "",
    "description": "Custom CA certificate file."
  },
  "region": {
    "type": "string",
    "default": "",
    "description": "AWS region name."
  },
  "read_only": {
    "type": "bool",
    "default": false,
    "description": "Enable read-only access."
  },
  "no_auto_detect": {
    "type": "bool",
    "default": false,
    "description": "Disable auto-detection of size/block size."
  },
  "list_blocks": {
    "type": "bool",
    "default": false,
    "description": "List existing blocks at startup."
  },
  "erase": {
    "type": "bool",
    "default": false,
    "description": "Erase the filesystem."
  },
  "force": {
    "type": "bool",
    "default": false,
    "description": "Force operations despite errors."
  },
  "reset_mounted_flag": {
    "type": "bool",
    "default": false,
    "description": "Reset the mounted flag."
  },
  "initial_retry_pause": {
    "type": "number",
    "default": 200,
    "description": "Initial retry pause in ms."
  },
  "max_retry_pause": {
    "type": "number",
    "default": 30000,
    "description": "Max total retry pause in ms."
  },
  "timeout": {
    "type": "number",
    "default": 30,
    "description": "HTTP timeout in seconds."
  },
  "max_upload_speed": {
    "type": "string",
    "default": "",
    "description": "Max upload speed."
  },
  "max_download_speed": {
    "type": "string",
    "default": "",
    "description": "Max download speed."
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug logging."
  },
  "debug_http": {
    "type": "bool",
    "default": false,
    "description": "Enable debug HTTP output."
  },
  "foreground": {
    "type": "bool",
    "default": false,
    "description": "Run in foreground."
  },
  "fuse_debug": {
    "type": "bool",
    "default": false,
    "description": "Enable FUSE debug mode."
  },
  "single_thread": {
    "type": "bool",
    "default": false,
    "description": "Run in single-threaded mode."
  },
  "uid": {
    "type": "string",
    "default": "",
    "description": "Override UID."
  },
  "gid": {
    "type": "string",
    "default": "",
    "description": "Override GID."
  },
  "direct_io": {
    "type": "bool",
    "default": false,
    "description": "Disable kernel caching."
  },
  "sync_read": {
    "type": "bool",
    "default": false,
    "description": "Synchronous reads."
  },
  "block_hash_prefix": {
    "type": "bool",
    "default": false,
    "description": "Prepend random prefixes to block names."
  },
  "key_length": {
    "type": "number",
    "default": 0,
    "description": "Override encryption key length."
  },
  "default_content_encoding": {
    "type": "string",
    "default": "",
    "description": "Default Content-Encoding value."
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Suppress progress output."
  }
}
