# Zeal offline API documentation browser configuration
# Zeal stores its settings in a Qt-style INI file (Zeal.conf).
# This template generates the correct key-value pairs for the [General] section.

[General]

# Modifier keys for the global search hotkey (e.g., 'Alt', 'Ctrl', 'Meta', or 'Alt+Ctrl').
globalHotkeyModifiers = {{ global_hotkey_modifiers | default('Alt') }}

# Key for the global search hotkey (e.g., 'Space', 'F1').
globalHotkeyKey = {{ global_hotkey_key | default('Space') }}

# Whether Zeal should start minimized to the system tray.
# Accepted values: true / false
startMinimized = {{ start_minimized | default(false) | lower }}

# Whether Zeal should automatically check for application updates.
# Accepted values: true / false
checkForUpdates = {{ check_for_updates | default(true) | lower }}

# Custom path to the directory containing documentation sets.
# Leave empty for default location.
docsetsPath = {{ docsets_path | default('') }}