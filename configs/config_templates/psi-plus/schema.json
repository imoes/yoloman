{
  "server": {
    "type": "string",
    "default": "xmpp.example.com",
    "description": "The XMPP server hostname to connect to."
  },
  "port": {
    "type": "number",
    "default": 5222,
    "description": "The port number for the XMPP connection."
  },
  "username": {
    "type": "string",
    "default": "user",
    "description": "The XMPP username (JID local part)."
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "The password for XMPP authentication."
  },
  "use_ssl": {
    "type": "bool",
    "default": true,
    "description": "Enable SSL/TLS encryption."
  },
  "theme": {
    "type": "string",
    "default": "Default",
    "description": "The UI theme to use."
  },
  "animated_emoticons": {
    "type": "bool",
    "default": true,
    "description": "Enable animated emoticons."
  },
  "enable_gnupg": {
    "type": "bool",
    "default": false,
    "description": "Enable GnuPG encryption."
  },
  "enable_otr": {
    "type": "bool",
    "default": false,
    "description": "Enable OTR encryption."
  },
  "enable_omemo": {
    "type": "bool",
    "default": false,
    "description": "Enable OMEMO encryption."
  },
  "cache_contacts": {
    "type": "bool",
    "default": true,
    "description": "Cache contacts offline."
  },
  "contacts": {
    "type": "list",
    "default": [],
    "description": "List of contacts with JID and nickname."
  },
  "contacts.items": {
    "type": "flat_map",
    "default": "",
    "description": "Schema for individual contact entries in the contacts list."
  },
  "contacts.items.jid": {
    "type": "string",
    "default": "",
    "description": "The JID of the contact."
  },
  "contacts.items.nickname": {
    "type": "string",
    "default": "",
    "description": "The nickname for the contact."
  }
}
