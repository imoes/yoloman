# This is a configuration template for the Hashicorp Vault plugin (mariadb-plugin-hashicorp-key-management).
#
# Self-Documentation:
# -------------------
# This configuration section `[mariadb]` is used to load and configure the
# `hashicorp_key_management` plugin.
#
# IMPORTANT: The plugin must be explicitly loaded via the `plugin-load-add` directive
# in the main MariaDB/MySQL configuration (e.g., my.cnf or 50-server.cnf).
# This template only configures the plugin parameters once loaded.
#
# Variables are defaulted to ensure the file is syntactically valid and
# safe to render even if the user does not provide values.
# - Empty strings result in commented-out directives.
# - Boolean-like parameters default to 'on' or 'off'.
# - Numeric parameters default to 0 or specific safe values where noted.

[mariadb]

#
# Load the Hashicorp Key Management plugin.
# NOTE: This line MUST be uncommented and placed in the appropriate
# configuration file for MariaDB to load the plugin.
# The filename `hashicorp_key_management.so` may need adjustment
# depending on the plugin path and OS.
#
# This directive tells MariaDB to load the plugin.
# The actual loading usually happens in a separate server config file
# using the variable `plugin_load_add`. This template focuses on
# plugin-specific parameters.
#
# Note: The plugin-load-add directive itself is typically NOT placed here
# in the plugin's specific config section, but in the [mysqld] section
# of the main server config. However, if this file is included there,
# it might appear. Based on standard MariaDB practices, plugin-load-add
# is a server option, not a plugin option. We leave it commented or
# handled by the caller, but since the prompt provided it in the template,
# we document it.
#
# plugin-load-add=hashicorp_key_management.so

#
# HTTP[s] URL that is used to connect to the Hashicorp Vault server.
# It must include the name of the scheme ("https://" for a secure connection)
# and, according to the API rules for storages of the key-value type in
# Hashicorp Vault, after the server address, the path must begin with the
# "/v1/" string (as prefix), for example: "https://127.0.0.1:8200/v1/my_secrets"
#
# If left empty, this parameter is commented out.
#
{% if (hashicorp_key_management_vault_url | default('')) | length > 0 %}hashicorp-key-management-vault-url="{{ hashicorp_key_management_vault_url | default('') }}"{% else %}#hashicorp-key-management-vault-url="<url>"{% endif %}

#
# Authentication token that is passed to the Hashicorp Vault in the request header.
# This is used for authentication with the Vault server.
#
# If left empty, this parameter is commented out.
#
{% if (hashicorp_key_management_token | default('')) | length > 0 %}hashicorp-key-management-token="{{ hashicorp_key_management_token | default('') }}"{% else %}#hashicorp-key-management-token="<token>"{% endif %}

#
# Optional path to the Certificate Authority (CA) bundle.
# This file contains root and intermediate certificates required to
# verify the Vault server's TLS certificate.
#
# If left empty, this parameter is commented out.
#
{% if (hashicorp_key_management_vault_ca | default('')) | length > 0 %}hashicorp-key-management-vault-ca="{{ hashicorp_key_management_vault_ca | default('') }}"{% else %}#hashicorp-key-management-vault-ca="<path>"{% endif %}

#
# Set the duration (in seconds) for the Hashicorp Vault server connection timeout.
# The allowed range is from 1 to 86400 seconds.
# The user can also specify a zero value, which means the default timeout value
# set by the libcurl library (currently 300 seconds).
#
# If left empty, defaults to 0 (libcurl default).
#
{% if (hashicorp_key_management_timeout | default('')) | length > 0 %}hashicorp-key-management-timeout={{ hashicorp_key_management_timeout | default('') | int }}{% else %}#hashicorp-key-management-timeout=0{% endif %}

#
# Number of server request retries in case of timeout.
#
# If left empty, defaults to 0 (no retries).
#
{% if (hashicorp_key_management_retries | default('')) | length > 0 %}hashicorp-key-management-retries={{ hashicorp_key_management_retries | default('') | int }}{% else %}#hashicorp-key-management-retries=0{% endif %}

#
# Enable key caching (storing key values received from the Hashicorp Vault
# server in the local memory).
# Enum: on, off
#
# Defaults to 'on'.
#
{% if hashicorp_key_management_caching_enabled is defined and hashicorp_key_management_caching_enabled is not none and (hashicorp_key_management_caching_enabled is number or hashicorp_key_management_caching_enabled is boolean or hashicorp_key_management_caching_enabled | length > 0) %}hashicorp-key-management-caching-enabled="{{ hashicorp_key_management_caching_enabled | default('on') }}"{% else %}#hashicorp-key-management-caching-enabled="on"{% endif %}

#
# This parameter instructs the plugin to use the key values or version numbers
# taken from the cache in the event of a timeout when accessing the vault server.
# By default this option is disabled.
#
# Please note that key values or version numbers will be read from the cache
# when the timeout expires only after the number of attempts to read them from
# the storage server that specified by the hashicorp-key-management-retries
# parameter has been exhausted.
# Enum: on, off
#
# Defaults to 'off'.
#
{% if hashicorp_key_management_use_cache_on_timeout is defined and hashicorp_key_management_use_cache_on_timeout is not none and (hashicorp_key_management_use_cache_on_timeout is number or hashicorp_key_management_use_cache_on_timeout is boolean or hashicorp_key_management_use_cache_on_timeout | length > 0) %}hashicorp-key-management-use-cache-on-timeout="{{ hashicorp_key_management_use_cache_on_timeout | default('off') }}"{% else %}#hashicorp-key-management-use-cache-on-timeout="off"{% endif %}

#
# The time (in milliseconds) after which the value of the key stored in the
# cache becomes invalid and an attempt to read this data causes a new request
# to be sent to the vault server.
#
# If the value of this parameter is zero, then the keys will always be
# considered invalid, but they still can be used if the vault server is
# unavailable and the corresponding cache operating mode
# (--[loose-]hashicorp-key-management-use-cache-on-timeout="on") is enabled.
#
# If left empty, defaults to 0.
#
{% if (hashicorp_key_management_cache_timeout | default('')) | length > 0 %}hashicorp-key-management-cache-timeout={{ hashicorp_key_management_cache_timeout | default('') | int }}{% else %}#hashicorp-key-management-cache-timeout=0{% endif %}

#
# The time (in milliseconds) after which the information about the latest
# version number of the key (which is stored in the cache) becomes invalid
# and an attempt to read this information causes a new request to be sent
# to the vault server.
#
# If the value of this parameter is zero, then information about latest
# key version numbers is always considered invalid, unless there is no
# communication with the vault server and use of the cache is allowed
# when the server is unavailable.
#
# By default, this parameter is zero, that is, the latest version numbers
# for the keys stored in the cache are considered always invalid, except
# when the vault server is unavailable and use of the cache is allowed
# on server failures.
#
# If left empty, defaults to 0.
#
{% if (hashicorp_key_management_cache_version_timeout | default('')) | length > 0 %}hashicorp-key-management-cache-version-timeout={{ hashicorp_key_management_cache_version_timeout | default('') | int }}{% else %}#hashicorp-key-management-cache-version-timeout=0{% endif %}

#
# This parameter enables ("on", this is the default value) or disables
# ("off") checking the KV storage version during plugin initialization.
# The plugin requires storage to be version 2 or older in order for it
# to work properly.
# Enum: on, off
#
# Defaults to 'on'.
#
{% if hashicorp_key_management_check_kv_version is defined and hashicorp_key_management_check_kv_version is not none and (hashicorp_key_management_check_kv_version is number or hashicorp_key_management_check_kv_version is boolean or hashicorp_key_management_check_kv_version | length > 0) %}hashicorp-key-management-check-kv-version={{ hashicorp_key_management_check_kv_version | default('on') }}{% else %}#hashicorp-key-management-check-kv-version=on{% endif %}
