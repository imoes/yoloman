{
  "smtp_port": 25,
  "smtp_bindto": "127.0.0.1",
  "max_connections": 150,
  "connect_timeout": 30,
  "mail_timeout": 300,
  "data_timeout": 600,
  "command_timeout": 60,
  "max_message_size": 26214400,
  "max_recipients": 100,
  "verbosity": 2,
  "pidfile": "/run/mailfromd/mailfromd.pid",
  "run_user": "mailfromd",
  "run_group": "mailfromd",
  "chroot": "/var/chroot/mailfromd",
  "tls_enabled": true,
  "tls_cert": "/etc/mailfromd/certs/fullchain.pem",
  "tls_key": "/etc/mailfromd/certs/privkey.pem",
  "spf_enabled": true,
  "greylisting_enabled": true,
  "greylisting_dir": "/var/lib/mailfromd/greylist",
  "greylisting_delay": 300,
  "dnsbl_lists": [
    "zen.spamhaus.org",
    "bl.spamcop.net",
    "b.barracudacentral.org"
  ],
  "relay_host": "smtp-out.example.com:587",
  "sasl_enabled": true,
  "sasl_mech": "PLAIN LOGIN",
  "rate_limiting_enabled": true,
  "rate_limit_per_ip": 30,
  "rate_limit_window": 1800,
  "extra_directives": [
    "MACRO _MAX_RCPT 50",
    "ACL_ALLOW_RCPT(192.168.0.0/16)"
  ]
}
