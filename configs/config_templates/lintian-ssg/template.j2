# Base URL for the generated static site
# desc: URL, including the scheme, where the root of the website will be located.
--base-url={{ (base_url | default('https://lintian.example.com')) | string }}

# Footer text (Markdown supported)
# desc: Text to add to the footer. Inline Markdown elements will be parsed.
--footer={{ (footer | default('Generated by lintian-ssg')) | string }}

# Override Lintian version in output
# desc: Override Lintian's version in output. Leave empty to auto-detect or omit.
{% if lintian_version | default('') | string | length > 0 %}
--lintian-version={{ (lintian_version | default('')) | string }}
{% endif %}

# Path to Lintian's manual HTML file
# desc: Read Lintian's manual from this FILE.
--manual-file={{ (manual_file | default('/usr/share/doc/lintian/lintian.html')) | string }}

# Output directory for the generated site
# desc: Path of the directory where to output the generated website.
-o {{ (output_dir | default('out')) | string }}

# Path to the JSON tags file
# desc: Read Lintian tags from this FILE (in JSON format). Leave empty to use lintian-explain-tags subprocess.
{% if tags_file | default('') | string | length > 0 %}
--tags-file={{ (tags_file | default('')) | string }}
{% endif %}

# Disable sitemap.xml.gz (and thus robots.txt) generation
# desc: Disable sitemap.xml.gz (and thus robots.txt) generation.
{% if no_sitemap | default(False) | bool %}
--no-sitemap
{% endif %}

# Display some statistics
# desc: Display some statistics.
{% if stats | default(False) | bool %}
--stats
{% endif %}

# Print stack traces on errors
# desc: Print stack traces on errors.
{% if debug | default(False) | bool %}
--debug
{% endif %}