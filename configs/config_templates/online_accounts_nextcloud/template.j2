{# Nextcloud account plugin configuration for Lomiri Online Accounts #}
{# The base URL of the Nextcloud server (required) #}
URL={{ url }}

{# The username to use for initial authentication (optional, can be overridden by user) #}
{% if username %}Username={{ username }}{% endif %}

{# The app password or OAuth client ID (optional, if not set, user will be prompted) #}
{% if app_password %}AppPassword={{ app_password }}{% endif %}

{# Enable WebDAV sync for contacts (default: true) #}
WebDAVContacts={{ webdav_contacts }}

{# Enable WebDAV sync for calendars (default: true) #}
WebDAVCalendars={{ webdav_calendars }}

{# Enable WebDAV sync for files (default: true) #}
WebDAVFiles={{ webdav_files }}

{# Timeout (in seconds) for HTTP requests (default: 30) #}
Timeout={{ timeout }}

{# Maximum number of retries for failed requests (default: 3) #}
MaxRetries={{ max_retries }}

{# Optional list of WebDAV paths (e.g., for custom calendar/contacts paths) #}
{% for path in webdav_paths %}WebDAVPath={{ path }}
{% endfor %}

{# Enable background sync (default: false) #}
BackgroundSync={{ background_sync }}

{# Sync interval in minutes (only used if BackgroundSync=true) (default: 60) #}
{% if background_sync %}SyncInterval={{ sync_interval }}{% endif %}

{# Disable SSL verification (dangerous, for testing only) (default: false) #}
DisableSSLVerify={{ disable_ssl_verify }}