# ==============================================================================
# Packit Configuration Template
# ==============================================================================
# This file configures `packit`, a network packet injection, capture, and tracing tool.
# It is generated dynamically by Ansible. All settings below map directly to packit's
# configuration sections.
# ==============================================================================

# ------------------------------------------------------------------------------
# Section: [modes]
# ------------------------------------------------------------------------------
[modes]
# Runtime mode: capture, inject, or trace.
# - capture: Listen and record packets.
# - inject: Send crafted packets.
# - trace: Trace packet paths.
mode = {{ mode | default('inject') }}

# ------------------------------------------------------------------------------
# Section: [packet_count]
# ------------------------------------------------------------------------------
[packet_count]
# Number of packets to capture or inject.
# Set to 0 to run indefinitely (forever).
count = {{ count | default(10) }}

# ------------------------------------------------------------------------------
# Section: [injection_interval]
# ------------------------------------------------------------------------------
[injection_interval]
# Seconds to wait between packet bursts.
interval = {{ interval | default(1) }}

# ------------------------------------------------------------------------------
# Section: [injection_burst]
# ------------------------------------------------------------------------------
[injection_burst]
# Number of packets to inject every interval.
# Set to 0 to send as fast as the system allows.
burst = {{ burst | default(0) }}

# ------------------------------------------------------------------------------
# Section: [verbose]
# ------------------------------------------------------------------------------
[verbose]
# Verbose mode to display injected/captured packets in the console.
verbose = {{ verbose | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [host_response]
# ------------------------------------------------------------------------------
[host_response]
# Wait for a response from the host after injecting a packet.
host_response = {{ host_response | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [host_timeout]
# ------------------------------------------------------------------------------
[host_timeout]
# Timeout in seconds when waiting for a host response.
host_timeout = {{ host_timeout | default(1) }}

# ------------------------------------------------------------------------------
# Section: [interface]
# ------------------------------------------------------------------------------
[interface]
# Network interface to use for transmission or listening.
interface = {{ interface | default('eth0') }}

# ------------------------------------------------------------------------------
# Section: [protocol]
# ------------------------------------------------------------------------------
[protocol]
# Packet protocol type: ARP, RARP, TCP, UDP, ICMP.
protocol = {{ protocol | default('TCP') }}

# ------------------------------------------------------------------------------
# Section: [ip_src]
# ------------------------------------------------------------------------------
[ip_src]
# Source IP address for the packet.
ip_src = {{ ip_src | default('0.0.0.0') }}

[ip_src_random]
# Use a random source IP address instead of the configured ip_src.
ip_src_random = {{ ip_src_random | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [ip_dst]
# ------------------------------------------------------------------------------
[ip_dst]
# Destination IP address for the packet.
ip_dst = {{ ip_dst | default('127.0.0.1') }}

[ip_dst_random]
# Use a random destination IP address instead of the configured ip_dst.
ip_dst_random = {{ ip_dst_random | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [ip_tos]
# ------------------------------------------------------------------------------
[ip_tos]
# IP Type of Service (TOS) value as an integer.
ip_tos = {{ ip_tos | default(0) }}

# ------------------------------------------------------------------------------
# Section: [ip_id]
# ------------------------------------------------------------------------------
[ip_id]
# IP ID number. Leave empty to let the system generate a random one.
ip_id = {{ ip_id | default('') }}

# ------------------------------------------------------------------------------
# Section: [ip_ttl]
# ------------------------------------------------------------------------------
[ip_ttl]
# IP Time To Live.
ip_ttl = {{ ip_ttl | default(128) }}

# ------------------------------------------------------------------------------
# Section: [ip_protocol]
# ------------------------------------------------------------------------------
[ip_protocol]
# IP protocol number (used for RAWIP). Default 255 implies auto/raw.
ip_protocol = {{ ip_protocol | default(255) }}

# ------------------------------------------------------------------------------
# Section: [tcp_src_port]
# ------------------------------------------------------------------------------
[tcp_src_port]
# TCP source port. Set to 0 for random selection.
tcp_src_port = {{ tcp_src_port | default(0) }}

# ------------------------------------------------------------------------------
# Section: [tcp_dst_port]
# ------------------------------------------------------------------------------
[tcp_dst_port]
# TCP destination port. Supports ranges like 1:1024. Set to 0 for default.
tcp_dst_port = {{ tcp_dst_port | default('0') }}

[tcp_no_fragment]
# Prevent fragmentation of this packet.
tcp_no_fragment = {{ tcp_no_fragment | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [tcp_flags]
# ------------------------------------------------------------------------------
[tcp_flags]
# TCP flags string (e.g., S for SYN, SF for SYN+FIN, R for RST).
tcp_flags = {{ tcp_flags | default('S') }}

# ------------------------------------------------------------------------------
# Section: [tcp_sequence]
# ------------------------------------------------------------------------------
[tcp_sequence]
# TCP sequence number.
tcp_sequence = {{ tcp_sequence | default(0) }}

[tcp_ack]
# TCP acknowledgement number.
tcp_ack = {{ tcp_ack | default(0) }}

# ------------------------------------------------------------------------------
# Section: [tcp_window]
# ------------------------------------------------------------------------------
[tcp_window]
# TCP window size for flow control.
tcp_window = {{ tcp_window | default(1500) }}

[tcp_urgent]
# TCP urgent pointer.
tcp_urgent = {{ tcp_urgent | default(0) }}

# ------------------------------------------------------------------------------
# Section: [udp_src_port]
# ------------------------------------------------------------------------------
[udp_src_port]
# UDP source port.
udp_src_port = {{ udp_src_port | default(0) }}

# ------------------------------------------------------------------------------
# Section: [udp_dst_port]
# ------------------------------------------------------------------------------
[udp_dst_port]
# UDP destination port.
udp_dst_port = {{ udp_dst_port | default(0) }}

# ------------------------------------------------------------------------------
# Section: [icmp_type]
# ------------------------------------------------------------------------------
[icmp_type]
# ICMP type number (e.g., 8 for Echo Request).
icmp_type = {{ icmp_type | default(8) }}

# ------------------------------------------------------------------------------
# Section: [icmp_code]
# ------------------------------------------------------------------------------
[icmp_code]
# ICMP code number.
icmp_code = {{ icmp_code | default(0) }}

# ------------------------------------------------------------------------------
# Section: [icmp_id]
# ------------------------------------------------------------------------------
[icmp_id]
# ICMP ID number. Set to 0 for random.
icmp_id = {{ icmp_id | default(0) }}

# ------------------------------------------------------------------------------
# Section: [icmp_sequence]
# ------------------------------------------------------------------------------
[icmp_sequence]
# ICMP sequence number. Set to 0 for random.
icmp_sequence = {{ icmp_sequence | default(0) }}

# ------------------------------------------------------------------------------
# Section: [icmp_gateway]
# ------------------------------------------------------------------------------
[icmp_gateway]
# Gateway address for ICMP Redirect messages.
icmp_gateway = {{ icmp_gateway | default('') }}

# ------------------------------------------------------------------------------
# Section: [icmp_redirect_src_addr]
# ------------------------------------------------------------------------------
[icmp_redirect_src_addr]
# Source address of the original packet that triggered the ICMP unreachable/redirect.
icmp_redirect_src_addr = {{ icmp_redirect_src_addr | default('') }}

[icmp_redirect_src_port]
# Source port of the original packet (for ICMP unreachable/redirect).
icmp_redirect_src_port = {{ icmp_redirect_src_port | default(0) }}

# ------------------------------------------------------------------------------
# Section: [icmp_redirect_dst_addr]
# ------------------------------------------------------------------------------
[icmp_redirect_dst_addr]
# Destination address of the original packet (for ICMP unreachable/redirect).
icmp_redirect_dst_addr = {{ icmp_redirect_dst_addr | default('') }}

[icmp_redirect_dst_port]
# Destination port of the original packet (for ICMP unreachable/redirect).
icmp_redirect_dst_port = {{ icmp_redirect_dst_port | default(0) }}

[icmp_redirect_ttl]
# TTL of the original packet (for ICMP unreachable/redirect).
icmp_redirect_ttl = {{ icmp_redirect_ttl | default(128) }}

[icmp_redirect_ip_id]
# IP ID of the original packet (for ICMP unreachable/redirect).
icmp_redirect_ip_id = {{ icmp_redirect_ip_id | default(0) }}

[icmp_redirect_tos]
# TOS of the original packet (for ICMP unreachable/redirect).
icmp_redirect_tos = {{ icmp_redirect_tos | default(0) }}

[icmp_redirect_protocol]
# Protocol of the original packet (for ICMP unreachable/redirect).
icmp_redirect_protocol = {{ icmp_redirect_protocol | default('UDP') }}

# ------------------------------------------------------------------------------
# Section: [icmp_mask]
# ------------------------------------------------------------------------------
[icmp_mask]
# Network mask for ICMP Mask Request/Reply.
icmp_mask = {{ icmp_mask | default('255.255.255.0') }}

# ------------------------------------------------------------------------------
# Section: [icmp_timestamp_orig]
# ------------------------------------------------------------------------------
[icmp_timestamp_orig]
# Original timestamp for ICMP Timestamp Request/Reply.
icmp_timestamp_orig = {{ icmp_timestamp_orig | default(0) }}

[icmp_timestamp_recv]
# Received timestamp for ICMP Timestamp Request/Reply.
icmp_timestamp_recv = {{ icmp_timestamp_recv | default(0) }}

[icmp_timestamp_xmit]
# Transmit timestamp for ICMP Timestamp Request/Reply.
icmp_timestamp_xmit = {{ icmp_timestamp_xmit | default(0) }}

# ------------------------------------------------------------------------------
# Section: [arp_operation]
# ------------------------------------------------------------------------------
[arp_operation]
# ARP/RARP operation type (1=Request, 2=Reply).
arp_operation = {{ arp_operation | default(1) }}

# ------------------------------------------------------------------------------
# Section: [arp_target_ip]
# ------------------------------------------------------------------------------
[arp_target_ip]
# Target IP address for ARP/RARP.
arp_target_ip = {{ arp_target_ip | default('') }}

[arp_target_ip_random]
# Use a random target IP for ARP/RARP.
arp_target_ip_random = {{ arp_target_ip_random | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [arp_target_mac]
# ------------------------------------------------------------------------------
[arp_target_mac]
# Target MAC address for ARP/RARP.
arp_target_mac = {{ arp_target_mac | default('') }}

[arp_target_mac_random]
# Use a random target MAC address for ARP/RARP.
arp_target_mac_random = {{ arp_target_mac_random | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [arp_sender_ip]
# ------------------------------------------------------------------------------
[arp_sender_ip]
# Sender IP address for ARP/RARP.
arp_sender_ip = {{ arp_sender_ip | default('') }}

[arp_sender_ip_random]
# Use a random sender IP for ARP/RARP.
arp_sender_ip_random = {{ arp_sender_ip_random | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [arp_sender_mac]
# ------------------------------------------------------------------------------
[arp_sender_mac]
# Sender MAC address for ARP/RARP.
arp_sender_mac = {{ arp_sender_mac | default('') }}

[arp_sender_mac_random]
# Use a random sender MAC address for ARP/RARP.
arp_sender_mac_random = {{ arp_sender_mac_random | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [eth_src_mac]
# ------------------------------------------------------------------------------
[eth_src_mac]
# Source Ethernet (MAC) address for the packet.
eth_src_mac = {{ eth_src_mac | default('') }}

[eth_src_mac_random]
# Use a random source Ethernet address.
eth_src_mac_random = {{ eth_src_mac_random | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [eth_dst_mac]
# ------------------------------------------------------------------------------
[eth_dst_mac]
# Destination Ethernet (MAC) address for the packet.
eth_dst_mac = {{ eth_dst_mac | default('') }}

[eth_dst_mac_random]
# Use a random destination Ethernet address.
eth_dst_mac_random = {{ eth_dst_mac_random | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [payload]
# ------------------------------------------------------------------------------
[payload]
# Packet payload data. Use '0x' prefix for hex strings, or raw ASCII.
payload = {{ payload | default('') }}

# ------------------------------------------------------------------------------
# Section: [vlan_tci]
# ------------------------------------------------------------------------------
[vlan_tci]
# 802.1Q TCI (VLAN Tag Control Information).
vlan_tci = {{ vlan_tci | default(0) }}

# ------------------------------------------------------------------------------
# Section: [packet_size]
# ------------------------------------------------------------------------------
[packet_size]
# Total size of the packet(s) to inject.
packet_size = {{ packet_size | default(0) }}

[packet_size_max]
# Maximum allowed packet size.
packet_size_max = {{ packet_size_max | default(65535) }}

# ------------------------------------------------------------------------------
# Section: [pcap_expression]
# ------------------------------------------------------------------------------
[pcap_expression]
# PCAP filter expression for capture mode (e.g., 'tcp and not port 22').
pcap_expression = {{ pcap_expression | default('') }}

# ------------------------------------------------------------------------------
# Section: [pcap_snaplen]
# ------------------------------------------------------------------------------
[pcap_snaplen]
# Capture snap length (number of bytes to capture per packet).
pcap_snaplen = {{ pcap_snaplen | default(68) }}

# ------------------------------------------------------------------------------
# Section: [pcap_write_file]
# ------------------------------------------------------------------------------
[pcap_write_file]
# Output file path for captured packets.
pcap_write_file = {{ pcap_write_file | default('/tmp/packit_capture.pcap') }}

# ------------------------------------------------------------------------------
# Section: [pcap_read_file]
# ------------------------------------------------------------------------------
[pcap_read_file]
# Input file to read packets from (instead of live capture).
pcap_read_file = {{ pcap_read_file | default('') }}

# ------------------------------------------------------------------------------
# Section: [pcap_display_link_header]
# ------------------------------------------------------------------------------
[pcap_display_link_header]
# Display link-layer header information in capture output.
pcap_display_link_header = {{ pcap_display_link_header | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [pcap_display_gmt]
# ------------------------------------------------------------------------------
[pcap_display_gmt]
# Display timestamps in GMT rather than local time.
pcap_display_gmt = {{ pcap_display_gmt | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [pcap_no_resolve_hosts]
# ------------------------------------------------------------------------------
[pcap_no_resolve_hosts]
# Do not resolve IP addresses to hostnames in capture output.
pcap_no_resolve_hosts = {{ pcap_no_resolve_hosts | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [pcap_no_resolve_ports]
# ------------------------------------------------------------------------------
[pcap_no_resolve_ports]
# Do not resolve port numbers to service names in capture output.
pcap_no_resolve_ports = {{ pcap_no_resolve_ports | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [pcap_hex_ascii_dump]
# ------------------------------------------------------------------------------
[pcap_hex_ascii_dump]
# Display hex and ASCII dump of packet payloads in capture mode.
pcap_hex_ascii_dump = {{ pcap_hex_ascii_dump | default(false) | lower }}

# ------------------------------------------------------------------------------
# Section: [pcap_verbose]
# ------------------------------------------------------------------------------
[pcap_verbose]
# Enable verbose mode for packet capture operations.
pcap_verbose = {{ pcap_verbose | default(false) | lower }}