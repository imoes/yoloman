{
  "mode": {
    "type": "string",
    "default": "inject",
    "description": "Runtime mode: capture, inject, or trace.",
    "enum": [
      "capture",
      "inject",
      "trace"
    ]
  },
  "count": {
    "type": "number",
    "default": 10,
    "description": "Number of packets to capture or inject. 0 means forever."
  },
  "interval": {
    "type": "number",
    "default": 1,
    "description": "Seconds to wait between packet bursts."
  },
  "burst": {
    "type": "number",
    "default": 0,
    "description": "Packets to inject every interval. 0 sends as fast as possible."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Verbose mode to display injected/captured packets."
  },
  "host_response": {
    "type": "bool",
    "default": false,
    "description": "Wait for response after injecting packet."
  },
  "host_timeout": {
    "type": "number",
    "default": 1,
    "description": "Timeout in seconds for host response."
  },
  "interface": {
    "type": "string",
    "default": "eth0",
    "description": "Network interface to use."
  },
  "protocol": {
    "type": "string",
    "default": "TCP",
    "description": "Packet protocol: ARP, RARP, TCP, UDP, ICMP.",
    "enum": [
      "ARP",
      "RARP",
      "TCP",
      "UDP",
      "ICMP"
    ]
  },
  "ip_src": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "Source IP address."
  },
  "ip_src_random": {
    "type": "bool",
    "default": false,
    "description": "Use random source IP."
  },
  "ip_dst": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Destination IP address."
  },
  "ip_dst_random": {
    "type": "bool",
    "default": false,
    "description": "Use random destination IP."
  },
  "ip_tos": {
    "type": "number",
    "default": 0,
    "description": "IP Type of Service (TOS) as integer."
  },
  "ip_id": {
    "type": "string",
    "default": "",
    "description": "IP ID number. Empty for random."
  },
  "ip_ttl": {
    "type": "number",
    "default": 128,
    "description": "IP Time To Live."
  },
  "ip_protocol": {
    "type": "number",
    "default": 255,
    "description": "IP protocol number (RAWIP)."
  },
  "tcp_src_port": {
    "type": "number",
    "default": 0,
    "description": "TCP source port. 0 for random."
  },
  "tcp_dst_port": {
    "type": "string",
    "default": "0",
    "description": "TCP destination port. Supports ranges like 1:1024. 0 for default."
  },
  "tcp_no_fragment": {
    "type": "bool",
    "default": false,
    "description": "Do not fragment packet."
  },
  "tcp_flags": {
    "type": "string",
    "default": "S",
    "description": "TCP flags string (e.g., S, SF, R, P).",
    "enum": [
      "S",
      "F",
      "A",
      "P",
      "U",
      "R"
    ]
  },
  "tcp_sequence": {
    "type": "number",
    "default": 0,
    "description": "TCP sequence number."
  },
  "tcp_ack": {
    "type": "number",
    "default": 0,
    "description": "TCP acknowledgement number."
  },
  "tcp_window": {
    "type": "number",
    "default": 1500,
    "description": "TCP window size."
  },
  "tcp_urgent": {
    "type": "number",
    "default": 0,
    "description": "TCP urgent pointer."
  },
  "udp_src_port": {
    "type": "number",
    "default": 0,
    "description": "UDP source port."
  },
  "udp_dst_port": {
    "type": "number",
    "default": 0,
    "description": "UDP destination port."
  },
  "icmp_type": {
    "type": "number",
    "default": 8,
    "description": "ICMP type."
  },
  "icmp_code": {
    "type": "number",
    "default": 0,
    "description": "ICMP code."
  },
  "icmp_id": {
    "type": "number",
    "default": 0,
    "description": "ICMP ID. 0 for random."
  },
  "icmp_sequence": {
    "type": "number",
    "default": 0,
    "description": "ICMP sequence number. 0 for random."
  },
  "icmp_gateway": {
    "type": "string",
    "default": "",
    "description": "Gateway for ICMP redirects."
  },
  "icmp_redirect_src_addr": {
    "type": "string",
    "default": "",
    "description": "Source address of original packet for ICMP unreachable/redirect."
  },
  "icmp_redirect_src_port": {
    "type": "number",
    "default": 0,
    "description": "Source port of original packet for ICMP unreachable/redirect."
  },
  "icmp_redirect_dst_addr": {
    "type": "string",
    "default": "",
    "description": "Destination address of original packet for ICMP unreachable/redirect."
  },
  "icmp_redirect_dst_port": {
    "type": "number",
    "default": 0,
    "description": "Destination port of original packet for ICMP unreachable/redirect."
  },
  "icmp_redirect_ttl": {
    "type": "number",
    "default": 128,
    "description": "TTL of original packet for ICMP unreachable/redirect."
  },
  "icmp_redirect_ip_id": {
    "type": "number",
    "default": 0,
    "description": "IP ID of original packet for ICMP unreachable/redirect."
  },
  "icmp_redirect_tos": {
    "type": "number",
    "default": 0,
    "description": "TOS of original packet for ICMP unreachable/redirect."
  },
  "icmp_redirect_protocol": {
    "type": "string",
    "default": "UDP",
    "description": "Protocol of original packet for ICMP unreachable/redirect."
  },
  "icmp_mask": {
    "type": "string",
    "default": "255.255.255.0",
    "description": "Network mask for ICMP mask requests."
  },
  "icmp_timestamp_orig": {
    "type": "number",
    "default": 0,
    "description": "Original timestamp for ICMP timestamp requests."
  },
  "icmp_timestamp_recv": {
    "type": "number",
    "default": 0,
    "description": "Received timestamp for ICMP timestamp requests."
  },
  "icmp_timestamp_xmit": {
    "type": "number",
    "default": 0,
    "description": "Transmit timestamp for ICMP timestamp requests."
  },
  "arp_operation": {
    "type": "number",
    "default": 1,
    "description": "ARP/RARP operation type (1-6)."
  },
  "arp_target_ip": {
    "type": "string",
    "default": "",
    "description": "Target IP for ARP/RARP."
  },
  "arp_target_ip_random": {
    "type": "bool",
    "default": false,
    "description": "Random target IP for ARP/RARP."
  },
  "arp_target_mac": {
    "type": "string",
    "default": "",
    "description": "Target MAC for ARP/RARP."
  },
  "arp_target_mac_random": {
    "type": "bool",
    "default": false,
    "description": "Random target MAC for ARP/RARP."
  },
  "arp_sender_ip": {
    "type": "string",
    "default": "",
    "description": "Sender IP for ARP/RARP."
  },
  "arp_sender_ip_random": {
    "type": "bool",
    "default": false,
    "description": "Random sender IP for ARP/RARP."
  },
  "arp_sender_mac": {
    "type": "string",
    "default": "",
    "description": "Sender MAC for ARP/RARP."
  },
  "arp_sender_mac_random": {
    "type": "bool",
    "default": false,
    "description": "Random sender MAC for ARP/RARP."
  },
  "eth_src_mac": {
    "type": "string",
    "default": "",
    "description": "Source Ethernet address."
  },
  "eth_src_mac_random": {
    "type": "bool",
    "default": false,
    "description": "Random source Ethernet address."
  },
  "eth_dst_mac": {
    "type": "string",
    "default": "",
    "description": "Destination Ethernet address."
  },
  "eth_dst_mac_random": {
    "type": "bool",
    "default": false,
    "description": "Random destination Ethernet address."
  },
  "payload": {
    "type": "string",
    "default": "",
    "description": "Packet payload. Hex with '0x' prefix or ASCII string."
  },
  "vlan_tci": {
    "type": "number",
    "default": 0,
    "description": "802.1Q TCI (VLAN)."
  },
  "packet_size": {
    "type": "number",
    "default": 0,
    "description": "Packet size to inject."
  },
  "packet_size_max": {
    "type": "number",
    "default": 65535,
    "description": "Maximum packet size."
  },
  "pcap_expression": {
    "type": "string",
    "default": "",
    "description": "PCAP filter expression for capture."
  },
  "pcap_snaplen": {
    "type": "number",
    "default": 68,
    "description": "Capture snap length."
  },
  "pcap_write_file": {
    "type": "string",
    "default": "/tmp/packit_capture.pcap",
    "description": "Output file for capture."
  },
  "pcap_read_file": {
    "type": "string",
    "default": "",
    "description": "Input file for capture."
  },
  "pcap_display_link_header": {
    "type": "bool",
    "default": false,
    "description": "Display link-layer header in capture."
  },
  "pcap_display_gmt": {
    "type": "bool",
    "default": false,
    "description": "Display GMT timestamps in capture."
  },
  "pcap_no_resolve_hosts": {
    "type": "bool",
    "default": false,
    "description": "Do not resolve host addresses in capture."
  },
  "pcap_no_resolve_ports": {
    "type": "bool",
    "default": false,
    "description": "Do not resolve ports in capture."
  },
  "pcap_hex_ascii_dump": {
    "type": "bool",
    "default": false,
    "description": "Hex/ASCII dump in capture."
  },
  "pcap_verbose": {
    "type": "bool",
    "default": false,
    "description": "Verbose capture mode."
  }
}
