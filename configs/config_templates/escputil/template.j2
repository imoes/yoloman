# escputil configuration - Epson Stylus inkjet printer maintenance
# One-time configuration for escputil(1) operation parameters
# This file documents runtime behavior expectations; actual configuration is via CLI args.

# Name of the printer to operate on (used with -P).
# The default is the system default printer.
{% if printer_name is defined %}
PRINTER_NAME="{{ printer_name | default('', true) }}"
{% endif %}

# Name of the device to write to directly (used with -r).
# Required for ink levels, identify, or head alignment without model detection.
{% if raw_device is defined %}
RAW_DEVICE="{{ raw_device | default('', true) }}"
{% endif %}

# Precise printer model for head alignment (used with -m).
{% if model is defined %}
MODEL="{{ model | default('', true) }}"
{% endif %}

# Quiet mode flag (suppresses banner; used with -q).
{% if quiet is defined %}
QUIET={{ "true" if quiet else "false" }}
{% endif %}

# Default operations (enabled via CLI at runtime; preserved here for documentation)
# CLEAN_HEAD=false
# NOZZLE_CHECK=false
# ALIGN_HEAD=false
# INK_LEVEL=false
# IDENTIFY=false
# ALIGN_COLOR=false
# STATUS=false