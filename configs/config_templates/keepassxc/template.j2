# KeePassXC Configuration File
# This file is referenced by the --config command-line argument.
# It uses INI-style formatting supported by Qt's QSettings.

[General]
# Path to the KeePassXC database file to open by default.
db_path = {{ db_path }}

# Key file path used for database authentication (optional).
# If not set, the user must provide the key file or password manually.
keyfile_path = {{ keyfile_path | default('', true) }}

# Whether to start KeePassXC minimized to the system tray.
start_minimized = {{ start_minimized | lower }}

[Browser]
# Enable integration with web browsers for auto-fill and KeePassXC-Browser.
enabled = {{ browser_enabled | lower }}

# Allowed hosts/domains that can connect to KeePassXC via browser extension.
# Multiple hosts can be listed, separated by semicolons.
allowed_hosts = {{ allowed_hosts | join(';') }}

[Security]
# Automatically lock the database after this many minutes of inactivity (0 = never).
lock_after_secs = {{ lock_after_secs }}

# Require a master key (password) to open the database, even if a key file is set.
require_master_key = {{ require_master_key | lower }}

# Hide passwords by default in the interface.
hide_passwords = {{ hide_passwords | lower }}
