{
  "pidfile_path": "/var/run/finit.pid",
  "verbosity": 2,
  "syslog_enabled": true,
  "console_level": 3,
  "service_dirs": [
    "/etc/finit.d",
    "/etc/init.d"
  ],
  "default_runlevel": "3",
  "default_target": null,
  "console_device": "/dev/console",
  "sync_on_shutdown": true,
  "plugins_enabled": false,
  "plugins_dir": "/usr/lib/finit/plugins",
  "network_enabled": true,
  "hostname_enabled": true,
  "plugins_config": {}
}
