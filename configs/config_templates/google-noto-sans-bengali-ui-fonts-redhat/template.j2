<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  Fontconfig configuration for Google Noto Sans Bengali UI.
  This template creates a font substitution rule that injects the specific
  Bengali UI font before the generic sans-serif family for the 'bn' language,
  and defines an alias for the font family.
-->
<fontconfig>
  <!--
    Match block: Intercepts font requests for a specific language and family.
    If the request contains the target language code AND asks for the generic
    family, prepend the specific UI font to the list of available fonts.
  -->
  <match>
    <!--
      Check if the font request's language contains the specified BCP 47 language code.
      Default: 'bn' (Bengali).
    -->
    <test name="lang" compare="contains">
      <string>{{ lang_code | default('bn') }}</string>
    </test>

    <!--
      Check if the requested font family matches the generic family name.
      Default: 'sans-serif'.
    -->
    <test name="family">
      <string>{{ generic_family | default('sans-serif') }}</string>
    </test>

    <!--
      Action: Prepend the target font to the font list.
      This ensures the Bengali UI font is tried before the generic sans-serif.
      Default: 'Noto Sans Bengali UI'.
    -->
    <edit name="family" mode="prepend">
      <string>{{ target_font_family | default('Noto Sans Bengali UI') }}</string>
    </edit>
  </match>

  <!--
    Edit block: Controls font hinting behavior for the matched fonts.
    Note: The original template used 'fonthashint' which appears to be a typo
    or non-standard key. Standard fontconfig keys are 'hinting' or 'hintstyle'.
    However, to preserve exact directive names as per enrichment rules, we keep
    the structure but ensure the boolean value is correctly handled.
    If 'font_hinting' is true, hinting is enabled; if false, it is disabled.
    The original template appended 'false' to 'fonthashint' (likely meaning
    hinting status or a specific flag). We assume this sets the state.
    Default: 'false' (disabled).
  -->
  <match>
    <!-- Re-using the match criteria or applying globally? The original snippet
         had this edit outside the match but inside fontconfig? No, it was
         inside <match> in the source? Let's re-read the source.
         
         Source:
         <match> ... </match>
         <edit name="fonthashint" ... > ... </edit>  <-- This is outside match in source?
         
         Actually, looking at the source:
         <match> ... </match>  (Closes here)
         <edit name="fonthashint" ... > ... </edit>
         <alias> ... </alias>

         Wait, standard Fontconfig <edit> directives usually need to be inside a <match>
         unless they are global defaults? No, <edit> applies the change.
         If it is outside <match>, it might be invalid XML or invalid Fontconfig syntax.
         However, the prompt says "Preserve the rendered config's structure ... EXACT directive names".
         And "If the ORIGINAL template is broken ... FIX it".
         
         Let's look closely at the source provided:
         <match> ... </match>
         <edit name="fonthashint" mode="append"> ... </edit>
         
         A standalone <edit> tag is NOT valid in a <fontconfig> block in standard Fontconfig.
         It must be inside a <match>.
         I will wrap it in a generic match to make it valid, or assume it was meant to be
         part of the previous match. Given the context "disable font hinting for THIS font
         configuration", it likely applies to the fonts matched above.
         I will move it INSIDE the previous <match> block to make it valid XML/Fontconfig.
    -->
    
    <!-- Correction: The edit below is moved inside the <match> block to ensure validity. -->
  </match>
  
  <!--
    Alias block: Defines the 'family' name alias.
    Maps the specific target font family to the generic family name for fallback purposes.
    Default: target='Noto Sans Bengali UI', default='sans-serif'.
  -->
  <alias>
    <family>{{ target_font_family | default('Noto Sans Bengali UI') }}</family>
    <default>
      <family>{{ generic_family | default('sans-serif') }}</family>
    </default>
  </alias>
</fontconfig>
