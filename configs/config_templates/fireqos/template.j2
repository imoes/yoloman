# =============================================================================
# FireQOS Configuration Template
# =============================================================================
# This file is the default configuration for FireQOS, sourced by the
# initscript `/etc/init.d/fireqos'. It controls basic service behavior.
# For advanced configuration, refer to the FireQOS manual.
# =============================================================================

# -----------------------------------------------------------------------------
# start_fireqos
# Description: Whether to enable FireQOS at system startup (true = enable, false = disable)
# Default: False
# -----------------------------------------------------------------------------
# Note: The init script typically expects "YES" or "NO". We convert the boolean
# schema value to this format.
{% if start_fireqos | default(False) | bool %}
START_FIREQOS=YES
{% else %}
START_FIREQOS=NO
{% endif %}