<?php
// HACI configuration file
// Generated by config template

// Base URL for the HACI web interface (without trailing slash)
$base_url = '{{ base_url }}';

// Database connection settings
$host = '{{ db.host }}';
$port = {{ db.port }};
$user = '{{ db.user }}';
$password = '{{ db.password }}';
$dbname = '{{ db.name }}';

// Enable/disable debug mode
$debug = {{ debug|lower }};

// Session timeout in seconds
$session_timeout = {{ session_timeout }};

// Maximum number of simultaneous sessions per user
$max_sessions_per_user = {{ max_sessions_per_user }};

// Allowed login methods: 'local', 'ldap', 'radius', 'none'
$auth_methods = {{ auth_methods | tojson }};

// LDAP configuration (only used if 'ldap' in $auth_methods)
{% if 'ldap' in auth_methods %}
$ldap_url = '{{ ldap.url }}';
$ldap_binddn = '{{ ldap.binddn }}';
$ldap_password = '{{ ldap.password }}';
$ldap_basedn = '{{ ldap.basedn }}';
$ldap_filter = '{{ ldap.filter }}';
$ldap_user_attr = '{{ ldap.user_attr }}';
$ldap_group_attr = '{{ ldap.group_attr }}';
{% endif %}

// RADIUS configuration (only used if 'radius' in $auth_methods)
{% if 'radius' in auth_methods %}
$radius_servers = {{ radius.servers | tojson }};
$radius_secret = '{{ radius.secret }}';
$radius_timeout = {{ radius.timeout }};
$radius_retries = {{ radius.retries }};
{% endif %}

// Logging configuration
$log_level = '{{ log.level }}'; // 'error', 'warn', 'info', 'debug'
$log_file = '{{ log.file }}';

// Network defaults
$default_prefix_v4 = {{ default_prefix_v4 }};
$default_prefix_v6 = {{ default_prefix_v6 }};

// Allow automatic IP allocation (DHCP-style) for new subnets
$auto_allocate = {{ auto_allocate|lower }};

// Email configuration for notifications
{% if email.enabled %}
$mail_from = '{{ email.from }}';
$mail_smtp_host = '{{ email.smtp.host }}';
$mail_smtp_port = {{ email.smtp.port }};
$mail_smtp_user = '{{ email.smtp.user }}';
$mail_smtp_pass = '{{ email.smtp.pass }}';
$mail_smtp_secure = '{{ email.smtp.secure }}'; // 'tls', 'ssl', or ''
{% endif %}

// UI theme: 'default', 'dark', or custom path
$theme = '{{ theme }}';

// Timezone (PHP format)
date_default_timezone_set('{{ timezone }}');

// Languages supported (ISO 639-1 codes)
{% for lang in languages %}
{% if loop.first %}$languages = ["{{ lang }}"{% else %},"{{ lang }}"{% endif %}
{% endfor %}];

// Primary language
$lang_default = '{{ lang_default }}';

// Enable/disable two-factor authentication (2FA)
$enable_2fa = {{ enable_2fa|lower }};

// Allowed IP ranges (CIDR notation) — for access restriction
{% if allowed_ranges|length > 0 %}
$allowed_ranges = {{ allowed_ranges | tojson }};
{% else %}
$allowed_ranges = [];
{% endif %}

// Web server user/group (if running CLI scripts as specific user)
$cli_user = '{{ cli.user }}';
$cli_group = '{{ cli.group }}';
