{
  "base_url": "https://ipam.internal.example.org/haci",
  "db": {
    "host": "10.0.1.5",
    "port": 3306,
    "user": "haci",
    "password": "db_password_here",
    "name": "haci_prod"
  },
  "debug": false,
  "session_timeout": 1800,
  "max_sessions_per_user": 2,
  "auth_methods": [
    "local",
    "ldap"
  ],
  "ldap": {
    "url": "ldaps://ldap.internal.example.org",
    "binddn": "cn=readonly,ou=services,dc=internal,dc=example,dc=org",
    "password": "ldap_bind_pass",
    "basedn": "ou=People,dc=internal,dc=example,dc=org",
    "filter": "(&(objectClass=inetOrgPerson)(uid=%s))",
    "user_attr": "uid",
    "group_attr": "cn"
  },
  "log": {
    "level": "info",
    "file": "/var/log/haci/haci.log"
  },
  "default_prefix_v4": 24,
  "default_prefix_v6": 64,
  "auto_allocate": true,
  "email": {
    "enabled": true,
    "from": "haci-alerts@example.org",
    "smtp": {
      "host": "smtp.example.org",
      "port": 587,
      "user": "haci-alerts",
      "pass": "smtp_pass_here",
      "secure": "tls"
    }
  },
  "theme": "dark",
  "timezone": "America/Los_Angeles",
  "languages": [
    "en",
    "es",
    "fr"
  ],
  "lang_default": "en",
  "enable_2fa": true,
  "allowed_ranges": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "cli": {
    "user": "haci",
    "group": "haci"
  }
}
