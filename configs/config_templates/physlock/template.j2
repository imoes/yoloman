#!/usr/bin/env physlock
# Command-line arguments for physlock
# -d: Fork and detach (useful for suspend/hibernate scripts)
# -m: Mute kernel messages on console
# -s: Disable SysRq mechanism
# -p: Display message before password prompt

{# detach: Fork and detach physlock before prompting for authentication. default=False #}
{% if detach | default(false) %}-d {% endif %}{# mute: Mute kernel messages on console while physlock is running. default=False #}
{% if mute | default(false) %}-m {% endif %}{# disable_sysrq: Disable SysRq mechanism while physlock is running. default=False #}
{% if disable_sysrq | default(false) %}-s {% endif %}{# prompt_msg: Message displayed before the password prompt. default='' #}
{% if prompt_msg | default('') %}-p "{{ prompt_msg | default('') }}" {% endif %}