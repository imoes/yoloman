{
  "max_connections": 5,
  "max_connections_to_host": 2,
  "retries": 3,
  "receive_timeout": 120,
  "unrestartable_receive_timeout": 600,
  "download_dir": "/tmp/downloads",
  "language": "en",
  "http_proxy": "proxy.example.com:8080",
  "ftp_proxy": "",
  "https_proxy": "proxy.example.com:8080",
  "socks_proxy": "",
  "no_proxy_domains": "localhost,127.0.0.1",
  "ssl_certificates": 2,
  "ssl_builtin_certificates": 0,
  "async_dns": 1,
  "http_fake_user_agent": "Mozilla/5.0",
  "http_fake_referer": "https://example.com",
  "enable_cookies": 1,
  "save_cookies": 1,
  "max_cookie_age": 30,
  "html_assume_codepage": "UTF-8",
  "html_frames": 1,
  "html_tables": 1,
  "html_display_images": 1,
  "save_url_history": 1,
  "address_preference": 1,
  "bookmarks": [
    {
      "url": "https://example.com",
      "name": "Example Site"
    },
    {
      "url": "https://debian.org",
      "name": "Debian"
    }
  ]
}
