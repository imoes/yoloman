# ==============================================================================
# Per-user configuration file for links2 (W3M-based text-mode web browser)
# Generated by Ansible Jinja2 engine
#
# This file configures network behavior, proxy settings, rendering options,
# and security preferences for the links2 browser.
# ==============================================================================

# ==============================================================================
# CONNECTION & NETWORK SETTINGS
# ==============================================================================

# Maximum number of concurrent connections allowed by the browser.
# Limits resource usage when fetching multiple resources from a page.
max-connections = {{ (links2 | default({})).max_connections | default(10) }}

# Maximum number of concurrent connections to a single remote host.
# Prevents overwhelming a specific server with too many parallel requests.
max-connections-to-host = {{ (links2 | default({})).max_connections_to_host | default(2) }}

# Number of times to retry a failed request before giving up.
# Useful for unstable network connections.
retries = {{ (links2 | default({})).retries | default(3) }}

# Timeout in seconds for receiving data on a connection.
# If no data is received within this time, the connection is aborted.
receive-timeout = {{ (links2 | default({})).receive_timeout | default(120) }}

# Timeout in seconds for connections that cannot be restarted (e.g., certain
# FTP or POST requests). Longer timeout to allow slow transfers.
unrestartable-receive-timeout = {{ (links2 | default({})).unrestartable_receive_timeout | default(600) }}

# ==============================================================================
# PROXY CONFIGURATION
# ==============================================================================

# Default directory where downloaded files are saved.
# Use '.' for the current working directory.
download-dir = "{{ (links2 | default({})).download_dir | default('.') }}"

# ==============================================================================
# LANGUAGE & RENDERING
# ==============================================================================

# User interface language code (e.g., 'english', 'german', 'japanese').
language = "{{ (links2 | default({})).language | default('english') }}"

# HTTP proxy server address in host:port format.
# Leave empty to disable HTTP proxy.
http-proxy = "{{ (links2 | default({})).http_proxy | default('') }}"

# FTP proxy server address in host:port format.
# Leave empty to disable FTP proxy.
ftp-proxy = "{{ (links2 | default({})).ftp_proxy | default('') }}"

# HTTPS proxy server address in host:port format.
# Leave empty to disable HTTPS proxy.
https-proxy = "{{ (links2 | default({})).https_proxy | default('') }}"

# SOCKS proxy server address in user@host:port format.
# Leave empty to disable SOCKS proxy.
socks-proxy = "{{ (links2 | default({})).socks_proxy | default('') }}"

# List of domains that should bypass all configured proxies (Noproxy list).
# Comma-separated list of domains (e.g., 'localhost, internal.corp').
no-proxy-domains = "{{ (links2 | default({})).no_proxy_domains | default('') }}"

# ==============================================================================
# SSL/TLS SECURITY
# ==============================================================================

# SSL Certificate validation mode.
# 0: Ignore certificate errors (insecure).
# 1: Warn but allow connection.
# 2: Reject invalid certificates (secure).
ssl.certificates = {{ (links2 | default({})).ssl_certificates | default(1) }}

# Whether to use built-in certificates provided by links2 instead of system ones.
# 0: Use system certificates.
# 1: Use built-in certificates (fallback).
ssl.builtin-certificates = {{ (links2 | default({})).ssl_builtin_certificates | default(0) }}

# ==============================================================================
# DNS & HTTP BEHAVIOR
# ==============================================================================

# Asynchronous DNS resolver.
# 0: Synchronous (blocking) DNS lookup.
# 1: Asynchronous (non-blocking) DNS lookup (recommended).
async-dns = {{ (links2 | default({})).async_dns | default(1) }}

# Fake User-Agent string to send in HTTP requests.
# Empty string uses the default links2 User-Agent.
http.fake-user-agent = "{{ (links2 | default({})).http_fake_user_agent | default('') }}"

# Fake Referer string to send in HTTP requests.
# Useful for bypassing simple Referer checks on some sites.
# Empty string uses the actual previous URL.
http.fake-referer = "{{ (links2 | default({})).http_fake_referer | default('') }}"

# ==============================================================================
# COOKIES
# ==============================================================================

# Enable cookie handling.
# 0: Disabled.
# 1: Enabled.
enable-cookies = {{ (links2 | default({})).enable_cookies | default(0) }}

# Save cookies to disk on exit so they persist across sessions.
# 0: Discard cookies on exit.
# 1: Save cookies.
save-cookies = {{ (links2 | default({})).save_cookies | default(0) }}

# Maximum age of cookies in days before they expire automatically.
# 0 means cookies expire based on their 'Max-Age' or 'Expires' header
# regardless of this setting.
max-cookie-age = {{ (links2 | default({})).max_cookie_age | default(365) }}

# ==============================================================================
# HTML RENDERING OPTIONS
# ==============================================================================

# Default character encoding (codepage) to assume if the HTML page
# does not specify one. Common values: 'ISO-8859-1', 'UTF-8', 'Shift_JIS'.
html-assume-codepage = "{{ (links2 | default({})).html_assume_codepage | default('ISO-8859-1') }}"

# Render HTML framesets.
# 0: Disable frames (treat as no frames).
# 1: Enable frames (interactive navigation between frames).
html-frames = {{ (links2 | default({})).html_frames | default(1) }}

# Render HTML tables.
# 0: Disable tables (text-only flow).
# 1: Enable tables (structured display).
html-tables = {{ (links2 | default({})).html_tables | default(1) }}

# Display inline images in graphics mode.
# In text-only mode, this controls whether [IMG] placeholders are shown.
# 0: Disable images.
# 1: Enable images.
html-display-images = {{ (links2 | default({})).html_display_images | default(0) }}

# ==============================================================================
# HISTORY & ADDRESS PREFERENCES
# ==============================================================================

# Save URL history during the session and on exit.
# 0: Do not save history.
# 1: Save history.
save-url-history = {{ (links2 | default({})).save_url_history | default(1) }}

# IP address family preference for new connections.
# 0: System default (usually dual-stack).
# 1: Prefer IPv4.
# 2: Prefer IPv6.
# 3: IPv4 only.
# 4: IPv6 only.
address-preference = {{ (links2 | default({})).address_preference | default(0) }}

# ==============================================================================
# BOOKMARKS
# ==============================================================================

# List of stored bookmarks.
# Each entry is defined by a URL and an optional name.
# If 'bookmarks' is empty or undefined, no bookmarks are added.
{% for bookmark in (links2 | default({})).bookmarks | default([]) %}
bookmark {{ loop.index0 }} = "{{ bookmark.url }}"
{% if bookmark.name is defined and bookmark.name %}
bookmark {{ loop.index0 }}_name = "{{ bookmark.name }}"
{% endif %}
{% endfor %}