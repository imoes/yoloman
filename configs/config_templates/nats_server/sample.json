{
  "cluster_name": "prod_cluster",
  "server_id": "S1",
  "host": "0.0.0.0",
  "ports": {
    "client": 4222,
    "monitoring": 8222,
    "cluster": 6222
  },
  "cluster_host": "10.0.1.10",
  "cluster_auth": {
    "user": "cluster_user",
    "password": "secret123",
    "timeout": 2
  },
  "cluster_routes": [
    {
      "host": "10.0.1.11",
      "port": 6222
    },
    {
      "host": "10.0.1.12",
      "port": 6222
    }
  ],
  "jetstream_enabled": true,
  "jetstream_store_dir": "/var/lib/nats/jetstream",
  "max_connections": 10000,
  "max_subscriptions": 0,
  "max_pending_bytes": 104857600,
  "write_deadline": 10,
  "system_account": "ADJW4N6YIQE7KZ...",
  "no_log": false,
  "log_file": "/var/log/nats/nats-server.log",
  "log_time": true,
  "trace": false,
  "debug": false,
  "tls": {
    "cert_file": "/etc/nats/tls/server.crt",
    "key_file": "/etc/nats/tls/server.key",
    "ca_file": "/etc/nats/tls/ca.crt",
    "verify": true,
    "timeout": 2
  },
  "accounts": [
    {
      "name": "global",
      "users": [
        {
          "user": "app_user",
          "password": "securepassword",
          "permissions": {
            "publish": [
              "public.>",
              "requests.>"
            ],
            "subscribe": [
              "responses.>",
              "updates.>"
            ]
          }
        }
      ]
    }
  ]
}
