# LDIF entry for GOsa+ DNS schema plugin configuration.
# This file defines custom LDAP schema attributes and object classes required
# for managing DNS records via GOsa+.

# dn: The Distinguished Name for the schema entry.
# Default: cn=dnszone,cn=schema,cn=config
dn: {{ dn | default('cn=dnszone,cn=schema,cn=config') }}

# The object class for this schema configuration entry.
# This is standard for OpenLDAP schema additions.
objectClass: olcSchemaConfig

# cn: The common name for the schema entry.
# Default: dnszone
cn: {{ cn | default('dnszone') }}

# -----------------------------------------------------------------------------
# olcAttributeTypes: Definition of custom DNS-related LDAP attributes.
# Each block below defines an attribute type compliant with RFC 2252 and relevant
# DNS RFCs (e.g., RFC 1035, 2535, 3658). These allow storage of specific DNS RR
# types within the LDAP directory.
# -----------------------------------------------------------------------------

# olcAttributeTypes: An integer denoting time to live (TTL).
# OID: 1.3.6.1.4.1.2428.20.0.0
# Syntax: Integer (OID 1.3.6.1.4.1.1466.115.121.1.27)
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.0.0 NAME 'dNSTTL' DESC 'An integer denoting time to live' EQUALITY integerMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 )

# olcAttributeTypes: The class of a resource record (usually CS IN).
# OID: 1.3.6.1.4.1.2428.20.0.1
# Syntax: IA5 String (OID 1.3.6.1.4.1.1466.115.121.1.26)
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.0.1 NAME 'dNSClass' DESC 'The class of a resource record' EQUALITY caseIgnoreIA5Match SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: The name of a zone, i.e. the name of the highest node in the zone.
# OID: 1.3.6.1.4.1.2428.20.0.2
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.0.2 NAME 'zoneName' DESC 'The name of a zone, i.e. the name of the highest node in the zone' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: The starting labels of a domain name (relative domain name).
# OID: 1.3.6.1.4.1.2428.20.0.3
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.0.3 NAME 'relativeDomainName' DESC 'The starting labels of a domain name' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Domain name pointer (PTR record), RFC 1035.
# OID: 1.3.6.1.4.1.2428.20.1.12
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.12 NAME 'pTRRecord' DESC 'domain name pointer, RFC 1035' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Host information (HINFO record), RFC 1035.
# OID: 1.3.6.1.4.1.2428.20.1.13
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.13 NAME 'hInfoRecord' DESC 'host information, RFC 1035' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Mailbox or mail list information (MINFO record), RFC 1035.
# OID: 1.3.6.1.4.1.2428.20.1.14
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.14 NAME 'mInfoRecord' DESC 'mailbox or mail list information, RFC 1035' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Text string (TXT record), RFC 1035.
# OID: 1.3.6.1.4.1.2428.20.1.16
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.16 NAME 'tXTRecord' DESC 'text string, RFC 1035' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: For AFS Data Base location (AFSDB record), RFC 1183.
# OID: 1.3.6.1.4.1.2428.20.1.18
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.18 NAME 'aFSDBRecord' DESC 'for AFS Data Base location, RFC 1183' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Signature (SIG record), RFC 2535.
# OID: 1.3.6.1.4.1.2428.20.1.24
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.24 NAME 'SigRecord' DESC 'Signature, RFC 2535' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Key (KEY record), RFC 2535.
# OID: 1.3.6.1.4.1.2428.20.1.25
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.25 NAME 'KeyRecord' DESC 'Key, RFC 2535' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: IPv6 address (AAAA record), RFC 1886.
# OID: 1.3.6.1.4.1.2428.20.1.28
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.28 NAME 'aAAARecord' DESC 'IPv6 address, RFC 1886' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Location (LOC record), RFC 1876.
# OID: 1.3.6.1.4.1.2428.20.1.29
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.29 NAME 'LocRecord' DESC 'Location, RFC 1876' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Non-existant node (NXT/NSEC predecessor), RFC 2535.
# OID: 1.3.6.1.4.1.2428.20.1.30
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.30 NAME 'nXTRecord' DESC 'non-existant, RFC 2535' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Service location (SRV record), RFC 2782.
# OID: 1.3.6.1.4.1.2428.20.1.33
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.33 NAME 'sRVRecord' DESC 'service location, RFC 2782' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Naming Authority Pointer (NAPTR record), RFC 2915.
# OID: 1.3.6.1.4.1.2428.20.1.35
olcAttributeTypes: ( 1.3.6.1.4.1.2428.20.1.35 NAME 'nAPTRRecord' DESC 'Naming Authority Pointer, RFC 2915' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# olcAttributeTypes: Key Exchange Delegation (KX record), RFC 2230.
