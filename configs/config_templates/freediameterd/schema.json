{
  "Identity": {
    "type": "string",
    "default": "peer1.localdomain",
    "description": "Diameter peer identity (FQDN)"
  },
  "Realm": {
    "type": "string",
    "default": "localdomain",
    "description": "Diameter realm"
  },
  "Port": {
    "type": "number",
    "default": 3868,
    "description": "Diameter base port (unsecured)"
  },
  "SecPort": {
    "type": "number",
    "default": 3869,
    "description": "Diameter TLS port"
  },
  "TLS_Cred_cert": {
    "type": "string",
    "default": "peer1.cert.pem",
    "description": "Path to TLS certificate file"
  },
  "TLS_Cred_key": {
    "type": "string",
    "default": "peer1.key.pem",
    "description": "Path to TLS private key file"
  },
  "TLS_CA": {
    "type": "string",
    "default": "cacert.pem",
    "description": "Path to CA certificate bundle"
  },
  "LoadExtension_path": {
    "type": "string",
    "default": "extensions/test_app.fdx",
    "description": "Path to extension module"
  },
  "LoadExtension_config": {
    "type": "string",
    "default": "test_app1.conf",
    "description": "Path to extension-specific config file"
  },
  "ConnectPeer_identity": {
    "type": "string",
    "default": "peer2.localdomain",
    "description": "Identity of peer to connect to (if enabled)"
  },
  "ConnectPeer_connectTo": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address to connect to"
  },
  "ConnectPeer_port": {
    "type": "number",
    "default": 30868,
    "description": "Port to connect to"
  }
}
