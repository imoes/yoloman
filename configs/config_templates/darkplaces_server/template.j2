# Quake server executable and working directory
exec_prefix=/usr/bin
cd=/var/lib/darkplaces-server

# Server binary name
binary=darkplaces-server

# Default Quake port (TCP and UDP share same port in Quake protocol)
port={{ port }}

# Maximum simultaneous players
maxclients={{ maxclients }}

# Server hostname (visible in server browser)
sname={{ hostname }}

# Server description (shown in browser)
message={{ server_message }}

# Map rotation: first map to load at startup
map={{ initial_map }}

# Game type: 0 = Quake (classic), 1 = QuakeWorld (netplay), 2 = Quake II (not supported by DarkPlaces), etc.
game={{ game_type }}

# Enable/Disable dedicated mode (true = headless, false = windowed)
dedicated={{ dedicated }}

# Network interface to bind to (empty = all interfaces)
address={{ bind_address }}

# Password to join (empty = no password)
password={{ join_password }}

# Password for admin/console access (empty = none)
sv_password={{ admin_password }}

# Enable spectator mode (players can watch without joining a team)
sv_spectator={{ enable_spectators }}

# Log file path (leave empty to disable logging)
log_file={{ log_file }}

# Time between auto-saves (in minutes); 0 = disabled
sv_auto_save_time={{ auto_save_interval }}

# Enable server browser announcements (true = announce to master server list)
sv_heartbeat={{ announce_to_master }}

# Master server address (default = id's public master)
master_address={{ master_address }}

# Custom CVAR overrides (e.g., for gameplay tweaks)
{% for cvar in cvars %}{{ cvar.name }}={{ cvar.value }}
{% endfor %}

# Path to additional mods (colon-separated for multiple)
mod_search_path={{ mod_search_path | join(':') }}

# Startup commands (semicolon-separated; runs after map load)
command={{ startup_commands | join(';') }}
