# prometheus-pgbackrest-exporter configuration
# This file sets the command-line arguments for the exporter process.
# The exporter reads pg_backrest repository data and exposes it via Prometheus metrics.

# Additional command-line arguments to pass to the prometheus-pgbackrest-exporter server.
# Default: --backrest.config="/etc/pgbackrest.conf"
# Note: Due to shell escaping, to pass backslashes for regexes, you need to double
# them (\\d for \d). If running under systemd, you need to double them again
# (\\\\d to mean \d), and escape newlines too.
ARGS='{{ args | default("--backrest.config=\"/etc/pgbackrest.conf\"") }}'