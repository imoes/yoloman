#!/bin/sh
# Script generated by Ansible to launch the Debian Installer.
#
# Configuration sources:
#   - plugin: The installer plugin to invoke. Supported values depend on the
#     installed debian-installer-launcher version.
#   - use_expert: If true, lowers the installer priority to 'low', enabling
#     expert mode with more configuration options exposed.
#   - enforce_text: If true, forces the installer frontend to 'text',
#     disabling graphical or ncurses interfaces.
#   - plugin_options: A list of additional command-line arguments passed
#     specifically to the selected plugin.

set -e

{% if use_expert | default(False) %}
# Enable expert mode by setting DEBIAN_PRIORITY to 'low'.
# This allows the installer to prompt for advanced configuration options.
export DEBIAN_PRIORITY=low
{% endif %}

{% if enforce_text | default(False) %}
# Force the Debian Installer to use the text-based frontend.
# This is useful for headless installations or when graphical drivers
# are unavailable or problematic.
export DEBIAN_FRONTEND=text
{% endif %}

# Launch the Debian Installer with the configured plugin.
# The 'exec' replaces the shell process with the installer for cleaner
# process management and signal handling.
exec debian-installer-launcher {{ plugin | default("live") }}{% if plugin_options | default([]) | length > 0 %}{{ ' ' }}{% for opt in plugin_options | default([]) %}{{ opt | default('') }}{% if not loop.last %} {{ '%20' | replace(' ', '') }}{% endif %}{% endfor %}{% endif %}