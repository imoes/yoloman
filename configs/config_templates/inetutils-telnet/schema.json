{
  "escape_char": {
    "type": "string",
    "default": "^]",
    "description": "The escape character to enter telnet command mode."
  },
  "host": {
    "type": "string",
    "description": "Remote host."
  },
  "port": {
    "type": "number",
    "description": "Remote port."
  },
  "ipv4": {
    "type": "bool",
    "description": "Use IPv4."
  },
  "ipv6": {
    "type": "bool",
    "description": "Use IPv6."
  },
  "binary_output": {
    "type": "bool",
    "description": "8-bit data path on output."
  },
  "automatic_login": {
    "type": "bool",
    "description": "Attempt automatic login."
  },
  "remote_user": {
    "type": "string",
    "description": "User to send to remote."
  },
  "rlogin_mode": {
    "type": "bool",
    "description": "rlogin interface."
  },
  "debug_enabled": {
    "type": "bool",
    "description": "Debug toggle."
  },
  "trace_file": {
    "type": "string",
    "description": "Trace output file."
  },
  "encrypt_enabled": {
    "type": "bool",
    "description": "Enable encryption."
  },
  "kerberos_realm": {
    "type": "string",
    "description": "Kerberos realm."
  },
  "env_vars": {
    "type": "list",
    "description": "Environment variables to define/export."
  },
  "template": {
    "type": "string",
    "description": "The telnetrc file content."
  },
  "env_vars_items": {
    "type": "object",
    "description": "Item schema for env_vars."
  },
  "env_vars_items_key": {
    "type": "string",
    "description": "Variable name."
  },
  "env_vars_items_value": {
    "type": "string",
    "description": "Variable value."
  }
}
