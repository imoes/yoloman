{
  "escape_char": "^]",
  "host": "myserver.example.com",
  "port": 23,
  "ipv4": true,
  "ipv6": false,
  "binary_output": false,
  "automatic_login": true,
  "remote_user": "",
  "rlogin_mode": false,
  "debug_enabled": false,
  "trace_file": "/var/log/telnet.trace",
  "encrypt_enabled": false,
  "kerberos_realm": "EXAMPLE.COM",
  "env_vars": [
    {
      "key": "TERM",
      "value": "xterm-256color"
    },
    {
      "key": "USER",
      "value": "admin"
    }
  ]
}
