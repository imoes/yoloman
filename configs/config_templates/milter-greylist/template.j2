# Defaults for milter-greylist initscript
# sourced by /etc/init.d/milter-greylist
# installed at /etc/default/milter-greylist by the maintainer scripts
# 2006-08-18 Herbert Straub

# Path to the PID file for the milter-greylist daemon.
PIDFILE="{{ pid_file | default('/var/run/milter-greylist.pid') }}"

# Path to the Unix socket used by milter-greylist.
SOCKET="{{ socket_path | default('/var/run/milter-greylist/greylist.sock') }}"

# User under which the milter-greylist daemon should run.
USER="{{ run_user | default('root') }}"

# Other options
# Additional command-line options passed to the milter-greylist daemon.
OPTIONS="{{ options | default('') }}"