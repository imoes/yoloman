# Defaults for milter-greylist initscript
# sourced by /etc/init.d/milter-greylist
# installed at /etc/default/milter-greylist by the maintainer scripts
# 2006-08-18 Herbert Straub

# Path to the PID file for the milter-greylist daemon.
{% if pid_file is defined and pid_file is not none and (pid_file is number or pid_file is boolean or pid_file | length > 0) %}PIDFILE="{{ pid_file | default('/var/run/milter-greylist.pid') }}"{% else %}# PIDFILE="/var/run/milter-greylist.pid"{% endif %}

# Path to the Unix socket used by milter-greylist.
{% if socket_path is defined and socket_path is not none and (socket_path is number or socket_path is boolean or socket_path | length > 0) %}SOCKET="{{ socket_path | default('/var/run/milter-greylist/greylist.sock') }}"{% else %}# SOCKET="/var/run/milter-greylist/greylist.sock"{% endif %}

# User under which the milter-greylist daemon should run.
{% if run_user is defined and run_user is not none and (run_user is number or run_user is boolean or run_user | length > 0) %}USER="{{ run_user | default('root') }}"{% else %}# USER="root"{% endif %}

# Other options
# Additional command-line options passed to the milter-greylist daemon.
{% if options is defined and options is not none and (options is number or options is boolean or options | length > 0) %}OPTIONS="{{ options | default('') }}"{% else %}# OPTIONS=""{% endif %}
