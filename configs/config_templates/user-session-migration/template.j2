# Configuration for user-session-migration
# This file controls the behavior of the user-session-migration utility.

# verbose: Whether to enable verbose output for debugging configuration issues.
# Default: False
verbose = {{ verbose | default(False) }}

# dry_run: Whether to run the migration without launching scripts or marking them as migrated.
# Default: False
dry_run = {{ dry_run | default(False) }}

# script_file: Path to a specific script file to consider, ignoring the XDG_DATA_DIR/user-session-migration/scripts directory.
# Default: '' (empty string, meaning auto-detect/search)
script_file = {{ script_file | default('') }}