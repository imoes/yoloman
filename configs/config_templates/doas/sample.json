{
  "rules": [
    {
      "action": "permit",
      "ident": "any",
      "targets": [
        "root"
      ],
      "commands": [
        "/bin/ls",
        "/bin/ping"
      ],
      "options": [
        "nopass"
      ]
    },
    {
      "action": "permit",
      "ident": "user1",
      "targets": [
        "root"
      ],
      "commands": [
        "/usr/bin/systemctl",
        "/usr/bin/apt-get"
      ],
      "options": [
        "log",
        "keepenv",
        "setenv LANG=en_US.UTF-8"
      ]
    },
    {
      "action": "deny",
      "ident": "user2",
      "targets": [
        "root"
      ],
      "commands": [
        "/bin/rm"
      ],
      "options": []
    }
  ]
}
