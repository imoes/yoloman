{
  "global": {
    "type": "object",
    "default": null,
    "description": "Global cmis-client configuration (command-line options as key-value pairs). See individual fields below for structure."
  },
  "global.url": {
    "type": "string",
    "default": "",
    "description": "CMIS service document URL (AtomPub or WebService binding)."
  },
  "global.repository_id": {
    "type": "string",
    "default": "",
    "description": "Target CMIS repository ID (required if multiple repos exist)."
  },
  "global.username": {
    "type": "string",
    "default": "",
    "description": "Username for basic authentication (leave empty for anonymous)."
  },
  "global.password": {
    "type": "string",
    "default": "",
    "description": "Password for basic authentication (leave empty for anonymous)."
  },
  "global.verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose debug output."
  },
  "global.ssl_check": {
    "type": "bool",
    "default": true,
    "description": "Verify SSL certificates (set false to disable)."
  },
  "global.proxy": {
    "type": "string",
    "default": "",
    "description": "HTTP proxy URL."
  },
  "global.proxy_username": {
    "type": "string",
    "default": "",
    "description": "Username for HTTP proxy authentication."
  },
  "global.proxy_password": {
    "type": "string",
    "default": "",
    "description": "Password for HTTP proxy authentication."
  },
  "global.noproxy": {
    "type": "list",
    "default": [],
    "description": "List of hostnames/domains exempt from proxy use (comma-separated in output)."
  },
  "global.oauth2.client_id": {
    "type": "string",
    "default": "",
    "description": "OAuth2 client ID."
  },
  "global.oauth2.client_secret": {
    "type": "string",
    "default": "",
    "description": "OAuth2 client secret."
  },
  "global.oauth2.auth_url": {
    "type": "string",
    "default": "",
    "description": "OAuth2 authorization endpoint URL."
  },
  "global.oauth2.token_url": {
    "type": "string",
    "default": "",
    "description": "OAuth2 token endpoint URL."
  },
  "global.oauth2.redirect_uri": {
    "type": "string",
    "default": "",
    "description": "OAuth2 redirect URI."
  },
  "global.oauth2.scope": {
    "type": "string",
    "default": "",
    "description": "OAuth2 scope."
  }
}
