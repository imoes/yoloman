# cmis-client configuration file
# Generated by Ansible from Jinja2 template.
# See individual fields below for details.

# Global cmis-client configuration (command-line options as key-value pairs).
# If 'global' is not provided, this block defaults to this header comment.
{% if global is defined %}

# CMIS service document URL (AtomPub or WebService binding).
# If empty, the client may rely on discovery or other configuration.
{% if global.url is defined %}
url={{ global.url | default('') | string }}
{% endif %}

# Target CMIS repository ID (required if multiple repos exist).
# Specify the ID of the repository to interact with.
{% if global.repository_id is defined %}
repository={{ global.repository_id | default('') | string }}
{% endif %}

# Username for basic authentication (leave empty for anonymous).
# If provided along with password, basic auth will be used.
{% if global.username is defined %}
username={{ global.username | default('') | string }}
{% endif %}

# Password for basic authentication (leave empty for anonymous).
# Stored in plain text; ensure file permissions restrict access.
{% if global.password is defined %}
password={{ global.password | default('') | string }}
{% endif %}

# Enable verbose debug output.
# When true, detailed logs are emitted for troubleshooting.
{% if global.verbose is defined %}
{% if global.verbose | default(False) | bool %}
verbose
{% endif %}
{% endif %}

# Verify SSL certificates (set false to disable).
# Set to false only for testing with self-signed certificates.
{% if global.ssl_check is defined %}
{% if not (global.ssl_check | default(True) | bool) %}
no-ssl-check
{% endif %}
{% endif %}

# HTTP proxy URL.
# The client will route HTTP/HTTPS requests through this proxy.
{% if global.proxy is defined %}
proxy={{ global.proxy | default('') | string }}
{% endif %}

# Username for HTTP proxy authentication.
# Used if the proxy requires basic authentication.
{% if global.proxy_username is defined %}
proxy-username={{ global.proxy_username | default('') | string }}
{% endif %}

# Password for HTTP proxy authentication.
# Used if the proxy requires basic authentication.
{% if global.proxy_password is defined %}
proxy-password={{ global.proxy_password | default('') | string }}
{% endif %}

# List of hostnames/domains exempt from proxy use.
# Comma-separated list of hosts that bypass the configured proxy.
{% if global.noproxy is defined %}
noproxy={{ global.noproxy | default([]) | join(',') }}
{% endif %}

{% if global.oauth2 is defined %}

# OAuth2 client ID.
# Identifies the client application to the OAuth2 provider.
{% if global.oauth2.client_id is defined %}
oauth2-client-id={{ global.oauth2.client_id | default('') | string }}
{% endif %}

# OAuth2 client secret.
# Secret key for the OAuth2 client application.
{% if global.oauth2.client_secret is defined %}
oauth2-client-secret={{ global.oauth2.client_secret | default('') | string }}
{% endif %}

# OAuth2 authorization endpoint URL.
# The URL where the user is redirected to grant consent.
{% if global.oauth2.auth_url is defined %}
oauth2-auth-url={{ global.oauth2.auth_url | default('') | string }}
{% endif %}

# OAuth2 token endpoint URL.
# The URL used to exchange the authorization code for tokens.
{% if global.oauth2.token_url is defined %}
oauth2-token-url={{ global.oauth2.token_url | default('') | string }}
{% endif %}

# OAuth2 redirect URI.
# The URI where the authorization server will redirect the user after consent.
{% if global.oauth2.redirect_uri is defined %}
oauth2-redirect-uri={{ global.oauth2.redirect_uri | default('') | string }}
{% endif %}

# OAuth2 scope.
# Defines the level of access requested from the authorization server.
{% if global.oauth2.scope is defined %}
oauth2-scope={{ global.oauth2.scope | default('') | string }}
{% endif %}

{% endif %}
{% else %}
# cmis-client configuration
# Global options
{% endif %}