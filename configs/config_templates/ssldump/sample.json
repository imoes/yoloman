{
  "interface": "eth0",
  "filter": "port 443",
  "key_file": "/etc/ssl/private/server.pem",
  "key_password": "secret123",
  "ssl_key_log_file": "",
  "print_acks": false,
  "print_all_fields": true,
  "display_app_data": true,
  "print_absolute_timestamps": true,
  "connection_pool_clean_freq": 50,
  "print_full_header": false,
  "output_json": false,
  "no_resolve": false,
  "parse_asn1": true,
  "no_promiscuous": false,
  "quiet": false,
  "read_dump_file": "",
  "ssl_flags": "crypto",
  "inactive_conn_ttl": 60,
  "print_tcp_headers": false,
  "print_hex": false,
  "suppress_printable_hex": false,
  "write_pcap": "/var/log/ssl_traffic.pcap"
}
