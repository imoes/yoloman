# ============================================================================
# ssldump Configuration Template
# ============================================================================
# This template generates the command-line arguments for the ssldump utility.
# ssldump is a TCP/IP packet analyzer that acts like a tcpdump for SSL/TLS
# traffic. It displays not only the contents of TCP/IP packets whose payload
# is SSL compatible, but also the SSL handshake that occurred to set up the
# TCP session.
#
# Variables are drawn from the Ansible 'values' dictionary. If a variable
# is undefined in the playbook, the schema default is used to ensure
# self-documentation and safe rendering.
# ============================================================================

# ----------------------------------------------------------------------------
# Interface Configuration
# ----------------------------------------------------------------------------

# Network interface to capture traffic on (e.g., eth0, ens33)
# Default: lo
# If left empty, ssldump may attempt to select the default interface.
INTERFACE={{ (values | default({})).interface | default('lo') }}

# ----------------------------------------------------------------------------
# Packet Selection & Filtering
# ----------------------------------------------------------------------------

# BPF filter expression to select packets (e.g., 'host 10.0.0.1 and port 443').
# Empty string captures all packets on the specified interface.
# Uses Berkeley Packet Filter (BPF) syntax.
FILTER={{ (values | default({})).filter | default('') }}

# Read from a PCAP dump file instead of capturing from the network interface.
# If specified, the INTERFACE is ignored and FILTER applies to the file contents.
# Default: '' (Live capture)
READ_DUMP_FILE={{ (values | default({})).read_dump_file | default('') }}

# ----------------------------------------------------------------------------
# SSL/TLS Decryption Configuration
# ----------------------------------------------------------------------------

# Path to the SSL/TLS private key file (OpenSSL PEM format) for decryption.
# Used to decrypt captured traffic if the key is available.
# Default: '' (No decryption)
KEY_FILE={{ (values | default({})).key_file | default('') }}

# Password for the SSL key file if it is encrypted.
# Default: '' (No password)
KEY_PASSWORD={{ (values | default({})).key_password | default('') }}

# Path to the SSLKEYLOGFILE (Mozilla NSS format) for TLS 1.3 decryption.
# TLS 1.3 encryption keys are not available in standard PCAPs; this file
# must be generated by the client/server (e.g., via SSLKEYLOGFILE env var)
# and provided here.
# Default: '' (No TLS 1.3 decryption)
SSL_KEY_LOG_FILE={{ (values | default({})).ssl_key_log_file | default('') }}

# SSL flags to print specific details: crypto, d, ht, H.
# Multiple flags can be comma or space separated.
# Example: 'crypto,d'
# Default: ''
SSL_FLAGS={{ (values | default({})).ssl_flags | default('') }}

# ----------------------------------------------------------------------------
# Output Formatting Options
# ----------------------------------------------------------------------------

# Print bare TCP ACKs (-a).
# Default: False
PRINT_ACKS={{ (values | default({})).print_acks | default(false) | lower }}

# Print all record fields (-A).
# Default: False
PRINT_ALL_FIELDS={{ (values | default({})).print_all_fields | default(false) | lower }}

# Display application data traffic (-d).
# Default: False
DISPLAY_APP_DATA={{ (values | default({})).display_app_data | default(false) | lower }}

# Print absolute timestamps instead of relative (-e).
# Default: False
PRINT_ABSOLUTE_TIMESTAMPS={{ (values | default({})).print_absolute_timestamps | default(false) | lower }}

# Print the full SSL packet header (-H).
# Default: False
PRINT_FULL_HEADER={{ (values | default({})).print_full_header | default(false) | lower }}

# Switch output format to JSON (-j).
# Useful for machine parsing.
# Default: False
OUTPUT_JSON={{ (values | default({})).output_json | default(false) | lower }}

# Parse ASN.1 in certificates/Distinguished Names (-N).
# Attempt to parse ASN.1 structures when they appear.
# Default: False
PARSE_ASN1={{ (values | default({})).parse_asn1 | default(false) | lower }}

# Print TCP headers (-T).
# Default: False
PRINT_TCP_HEADERS={{ (values | default({})).print_tcp_headers | default(false) | lower }}

# Print each record in hex, as well as decoding it (-x).
# Default: False
PRINT_HEX={{ (values | default({})).print_hex | default(false) | lower }}

# Suppress printable characters in hex dump (-X).
# Default: False
SUPPRESS_PRINTABLE_HEX={{ (values | default({})).suppress_printable_hex | default(false) | lower }}

# Don't try to resolve host names from IP addresses (-n).
# Improves performance and avoids DNS dependency.
# Default: True
NO_RESOLVE={{ (values | default({})).no_resolve | default(true) | lower }}

# Quiet mode, only print summary lines (-q).
# Default: False
QUIET={{ (values | default({})).quiet | default(false) | lower }}

# ----------------------------------------------------------------------------
# Connection Management
# ----------------------------------------------------------------------------

# Number of packets after which a connection pool cleaning is performed (-F).
# Helps manage memory usage during long captures.
# Default: 100
CONNECTION_POOL_CLEAN_FREQ={{ (values | default({})).connection_pool_clean_freq | default(100) }}

# Don't put the interface into promiscuous mode (-P).
# By default, ssldump puts the interface in promiscuous mode. Set this to
# True to disable that behavior (requires appropriate privileges/permissions).
# Default: False
NO_PROMISCUOUS={{ (values | default({})).no_promiscuous | default(false) | lower }}

# TTL for inactive connections in seconds (-t).
# Connections idle for this duration are cleaned up.
# Default: 100
INACTIVE_CONN_TTL={{ (values | default({})).inactive_conn_ttl | default(100) }}

# ----------------------------------------------------------------------------
# Output Destination
# ----------------------------------------------------------------------------

# Destination file for decrypted packets in pcap format (-w).
# Useful for saving decrypted traffic for later analysis.
# Default: '' (No output file)
WRITE_PCAP={{ (values | default({})).write_pcap | default('') }}

# ----------------------------------------------------------------------------
# Command Construction
# ----------------------------------------------------------------------------

# The base command to execute.
COMMAND=ssldump