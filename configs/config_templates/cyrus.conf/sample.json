{
  "services": [
    {
      "daemon": "defaults",
      "service": "imap",
      "type": "socket",
      "cmd": "imapd -s"
    },
    {
      "daemon": "defaults",
      "service": "pop3",
      "type": "socket",
      "cmd": "pop3d -s"
    },
    {
      "daemon": "defaults",
      "service": "nntp",
      "type": "inet",
      "cmd": "nntpd -s -p 119"
    },
    {
      "daemon": "defaults",
      "service": "sieve",
      "type": "socket",
      "cmd": "timsieved -s"
    },
    {
      "daemon": "defaults",
      "service": "lmtp",
      "type": "socket",
      "cmd": "lmtpd -l"
    }
  ],
  "sieve_options": [
    {
      "key": "sieve_maxscriptsize",
      "value": "1024"
    },
    {
      "key": "sieve_trace_dir",
      "value": "/var/spool/sieve/trace"
    }
  ],
  "port_imap": 143,
  "port_pop3": 110,
  "port_sieve": 4190,
  "socket_path": "/var/lib/imap/socket",
  "enable_inet": false
}
