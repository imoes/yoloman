# matekbd-keyboard-display configuration
#
# This template configures the MATE Keyboard Display utility.
# The displayed settings are used by the display applet to show
# keyboard layouts and options in the system tray.

# The keyboard layout group index to preview.
# If 0, the currently selected system layout is used.
# Valid values are non-negative integers corresponding to layout groups.
# See 'man matekbd-keyboard-display' for more details.
layout_group: {{ layout_group | default(0) }}