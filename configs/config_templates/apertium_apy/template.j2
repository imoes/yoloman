# Shell environment variables for apertium-apy (APY service)
# Must be sourced by init scripts or systemd drop-in files

# Interface and port to listen on
APY_HOST={{ host }}
APY_PORT={{ port }}

# Number of worker processes (0 = auto, based on CPU cores)
APY_WORKERS={{ workers }}

# Maximum number of concurrent requests per worker
APY_MAX_REQUESTS={{ max_requests }}

# Timeout for request handling (in seconds)
APY_TIMEOUT={{ timeout }}

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
APY_LOGLEVEL={{ loglevel }}

# Path to log file (empty = stdout)
APY_LOGFILE={{ log_file }}

# Path to PID file
APY_PIDFILE={{ pid_file }}

# List of supported language pairs to expose (e.g. 'eng-spa,spa-eng')
# If empty or unset, all installed pairs are exposed
APY_LANGPAIRS={{ langpairs | join(',') }}

# Comma-separated list of language pairs to restrict to (whitelist mode)
# If empty, no restriction (all pairs from APY_LANGPAIRS or auto-discovered)
APY_WHITELIST={{ whitelist | join(',') }}

# Enable or disable preloading of models at startup (speeds up first request)
APY_PRELOAD={{ preload | lower }}

# Maximum memory (in MB) allowed per worker process
APY_MAXMEMORY={{ max_memory }}

# Enable or disable HTTP/1.1 keep-alive
APY_KEEPALIVE={{ keepalive | lower }}

# Base path for API endpoints (default: /translator)
APY_PATH={{ path }}

# Enable or disable CORS (Cross-Origin Resource Sharing)
APY_CORS={{ cors | lower }}

# Optional: custom server header (e.g. for reverse proxy compatibility)
APY_SERVERHEADER="{{ server_header }}"

# Optional: extra arguments passed directly to apertium-apy binary
APY_EXTRA_ARGS="{{ extra_args }}"
