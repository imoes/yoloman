{
  "host": "0.0.0.0",
  "port": 2737,
  "workers": 4,
  "max_requests": 10000,
  "timeout": 60,
  "loglevel": "INFO",
  "log_file": "/var/log/apertium-apy.log",
  "pid_file": "/run/apertium-apy.pid",
  "langpairs": [
    "eng-spa",
    "spa-eng",
    "fra-deu"
  ],
  "whitelist": [],
  "preload": true,
  "max_memory": 4096,
  "keepalive": true,
  "path": "/api/v1/translate",
  "cors": true,
  "server_header": "Apertium-APY/3.8.1",
  "extra_args": "--enable-webserver-mode"
}
