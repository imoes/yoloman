#!/bin/sh
# =============================================================================
# mtkbabel configuration wrapper script
# Generated by Ansible Jinja2 template.
# This script wraps the `mtkbabel` tool to read GPS data from Holux-style
# serial devices or pre-saved binary files.
# =============================================================================

# --- Device Connection Settings ---

# Communication port for the GPS device (e.g., /dev/ttyUSB0).
# If read_bin_file is set, this port is ignored.
PORT={{ port | default('/dev/ttyUSB0') }}

# Serial communication speed in baud (e.g., 115200).
SPEED={{ speed | default(115200) }}

# --- Output File Settings ---

# Base name for saved files (e.g., gpslog).
# Output files will be named like gpslog.gpx, gpslog_trk.gpx, etc.
BASENAME={{ basename | default('gpslog') }}

# Create a GPX file with tracks.
OUTPUT_TRACKS={{ output_tracks | default(True) | lower }}

# Create a GPX file with waypoints.
OUTPUT_WAYPOINTS={{ output_waypoints | default(True) | lower }}

# Create a single GPX file with both tracks and waypoints.
OUTPUT_COMBINED={{ output_combined | default(False) | lower }}

# --- Device Logging Control ---

# Turn logging ON or OFF on the device before reading.
# Common values: 'on', 'off'.
LOGGING_MODE={{ logging_mode | default('off') }}

# Set STOP or OVERLAP recording method when device memory is full.
# 'stop': stop recording. 'overlap': overwrite oldest data.
FULL_METHOD={{ full_method | default('overlap') }}

# Set logging criteria as time:distance:speed (e.g., '1:10:10').
# 0:0:0 disables custom criteria (record based on time/distance thresholds only).
LOG_CRITERIA={{ log_criteria | default('0:0:0') }}

# List of fields to enable in the log format.
# Comma-separated list: UTC, VALID, LATITUDE, LONGITUDE, HEIGHT, SPEED, HEADING, etc.
LOG_FIELDS={{ log_fields | default(['UTC', 'VALID', 'LATITUDE', 'LONGITUDE', 'HEIGHT', 'SPEED', 'HEADING']) | join(',') }}

# --- Advanced / Diagnostic Options ---

# Force reading Holux format even if auto-detection fails.
FORCE_HOLUX={{ force_holux | default(False) | lower }}

# Debug level (0-7). Higher numbers produce more verbose output.
DEBUG_LEVEL={{ debug_level | default(0) }}

# Ignore some error conditions and try to extract as much data as possible.
IGNORE_ERRORS={{ ignore_errors | default(False) | lower }}

# Write bad records into the GPX file.
# Requires ignore_errors to be true.
WRITE_BAD_RECORDS={{ write_bad_records | default(False) | lower }}

# Add weeks count to timestamps to fix rollover bug.
WEEKS_ROLLOVER={{ weeks_rollover | default('1024') }}

# --- Destructive Actions ---

# Erase data log memory before starting.
# WARNING: This is a destructive action.
ERASE_MEMORY={{ erase_memory | default(False) | lower }}

# Recover from disabled log: erase data and reset recording criteria.
RECOVER_DISABLED={{ recover_disabled | default(False) | lower }}

# --- Input Source ---

# Path to a previously saved .bin file to read instead of a device.
# If provided, device commands are ignored.
READ_BIN_FILE={{ read_bin_file | default('') }}

# =============================================================================
# Command Construction
# =============================================================================

# Base command with port and speed
CMD="mtkbabel -p ${PORT} -s ${SPEED}"

# Determine mode: Read from file OR Read from Device
if [ -n "${READ_BIN_FILE}" ]; then
    # Mode: Read from saved binary file
    CMD="${CMD} -b ${READ_BIN_FILE}"
else
    # Mode: Read from serial device
    if [ "${ERASE_MEMORY}" = "true" ]; then
        # Priority: Erase memory
        CMD="${CMD} -E"
    elif [ "${RECOVER_DISABLED}" = "true" ]; then
        # Priority: Recover disabled log
        CMD="${CMD} -R"
    else
        # Standard reading mode
        if [ -n "${BASENAME}" ]; then
            CMD="${CMD} -f ${BASENAME}"
        fi

        if [ "${OUTPUT_TRACKS}" = "true" ]; then
            CMD="${CMD} -t"
        fi
        if [ "${OUTPUT_WAYPOINTS}" = "true" ]; then
            CMD="${CMD} -w"
        fi
        if [ "${OUTPUT_COMBINED}" = "true" ]; then
            CMD="${CMD} -c"
        fi

        if [ -n "${LOGGING_MODE}" ]; then
            CMD="${CMD} -l ${LOGGING_MODE}"
        fi
        if [ -n "${FULL_METHOD}" ]; then
            CMD="${CMD} -m ${FULL_METHOD}"
        fi
        if [ -n "${LOG_CRITERIA}" ]; then
            CMD="${CMD} -r ${LOG_CRITERIA}"
        fi
        if [ -n "${LOG_FIELDS}" ]; then
            CMD="${CMD} -o ${LOG_FIELDS}"
        fi
        if [ "${FORCE_HOLUX}" = "true" ]; then
            CMD="${CMD} -x"
        fi
        if [ "${IGNORE_ERRORS}" = "true" ]; then
            CMD="${CMD} -i"
        fi
        if [ "${WRITE_BAD_RECORDS}" = "true" ]; then
            CMD="${CMD} -I"
        fi
        if [ -n "${WEEKS_ROLLOVER}" ]; then
            CMD="${CMD} -W ${WEEKS_ROLLOVER}"
        fi

        # Default: if no specific output flags are set, read all log memory
        if [ "${OUTPUT_TRACKS}" != "true" ] && \
           [ "${OUTPUT_WAYPOINTS}" != "true" ] && \
           [ "${OUTPUT_COMBINED}" != "true" ] && \
           [ "${ERASE_MEMORY}" != "true" ] && \
           [ "${RECOVER_DISABLED}" != "true" ] && \
           [ -z "${READ_BIN_FILE}" ]; then
            CMD="${CMD} -a"
        fi
    fi
fi

# Append debug level if enabled (0-7)
if [ ${DEBUG_LEVEL} -gt 0 ] && [ ${DEBUG_LEVEL} -le 7 ]; then
    CMD="${CMD} -d ${DEBUG_LEVEL}"
fi

# Execute the constructed command
exec ${CMD}