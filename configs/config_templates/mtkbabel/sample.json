{
  "port": "/dev/ttyUSB0",
  "speed": 115200,
  "basename": "my_gps_log",
  "output_tracks": true,
  "output_waypoints": true,
  "output_combined": false,
  "logging_mode": "off",
  "full_method": "stop",
  "log_criteria": "5:100:10",
  "log_fields": [
    "UTC",
    "LATITUDE",
    "LONGITUDE",
    "SPEED"
  ],
  "force_holux": false,
  "debug_level": 0,
  "ignore_errors": false,
  "write_bad_records": false,
  "weeks_rollover": "1024",
  "erase_memory": false,
  "recover_disabled": false,
  "read_bin_file": ""
}
