# ==============================================================================
# Configuration for pyp (The Pyed Piper)
#
# pyp is a text-processing utility that uses Python scripts to filter,
# transform, and generate text. This configuration file controls the
# runtime behavior of the tool.
#
# All variables must have their defaults defined to ensure idempotent
# and safe rendering when optional role variables are not provided.
# ==============================================================================

# --blank_inputs
# Generate this number of blank input lines; useful for generating
# numbered lists with variable 'n'.
BLANK_INPUTS={{ blank_inputs | default(0) }}

# --keep_false
# Print blank lines for lines that test as False. Default is to
# filter out False lines from the output.
KEEP_FALSE={{ keep_false | default(false) | lower }}

# --macro_group
# Specify group macros for save and delete; default is user.
# Use 'true' to enable group-based macros, 'false' for user-based.
MACRO_GROUP={{ macro_group | default(false) | lower }}

# --text_file
# Specify text file to load as input. For advanced users, you
# should typically cat a file into pyp.
TEXT_FILE={{ text_file | default('') }}