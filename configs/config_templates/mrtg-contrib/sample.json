{
  "working_dir": "/var/www/mrtg",
  "language": "en",
  "refresh_interval": 300,
  "targets": [
    {
      "id": "eth0",
      "name": "Server Ethernet Traffic",
      "description": "In/Out traffic on eth0 interface",
      "target_expr": "1.3.6.1.2.1.2.2.1.10.2#1.3.6.1.2.1.2.2.1.16.2@public:192.168.1.10",
      "max_bytes": 125000000,
      "title": "Server Ethernet Traffic (eth0)",
      "max_warn": "100000000"
    },
    {
      "id": "cpu",
      "name": "Server CPU Load",
      "description": "System CPU utilization percentage",
      "target_expr": "1.3.6.1.2.1.25.3.3.1.2.1#1.3.6.1.2.1.25.3.3.1.2.1@public:192.168.1.10",
      "max_bytes": 100,
      "title": "Server CPU Load",
      "max_warn": "90"
    }
  ]
}
