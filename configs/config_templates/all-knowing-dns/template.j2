# Configuration file for AllKnowingDNS v1.3
#
# This template configures the "all-knowing-dns" service.
# It defines the IPv6 network prefix, the associated hostname,
# and the upstream DNS server used for resolution.
#
# All variables are provided with safe defaults based on the schema
# to ensure the configuration renders correctly even if variables are missing.

# The IPv6 network prefix assigned to the service.
network {{ network_prefix | default('2001:4d88:100e:ccc0::/64') }}
    # The hostname that the network resolves to.
    resolves to {{ hostname | default('ipv6-%DIGITS%.nutzer.raumzeitlabor.de') }}
    # The IPv6 address of the upstream DNS server.
    with upstream {{ upstream_dns | default('2001:4d88:100e:1::2') }}
