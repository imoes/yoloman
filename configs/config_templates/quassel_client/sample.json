{
  "database": {
    "type": "SQLite",
    "sqlite": {
      "path": "~/.local/share/quassel-irc.org/quassel-storage.sqlite"
    },
    "postgres": {
      "host": "localhost",
      "port": 5432,
      "name": "quassel",
      "user": "quassel",
      "password": "",
      "ssl_mode": "prefer"
    }
  },
  "core": {
    "bind_address": "*",
    "port": 4242,
    "use_ssl": true,
    "ssl_cert_file": "~/.config/quassel-irc.org/quasselCore.crt",
    "ssl_pkey_file": "~/.config/quassel-irc.org/quasselCore.key",
    "max_connections": 5,
    "use_compression": true
  },
  "ui": {
    "geometry": "1024x768+50+50",
    "show_sidebar": true,
    "buffer_view": "combined",
    "networks": [
      {
        "name": "Libera Chat",
        "servers": [
          {
            "host": "irc.libera.chat",
            "port": 6697,
            "use_ssl": true
          },
          {
            "host": "irc2.libera.chat",
            "port": 6697,
            "use_ssl": true
          }
        ],
        "user": "quasseluser",
        "nick": "quassel_",
        "alt_nicks": "quassel__,quassel___",
        "real_name": "Quassel Distributed Client",
        "auto_connect": true,
        "auto_join": [
          "#quassel",
          "#help"
        ]
      },
      {
        "name": "OFTC",
        "servers": [
          {
            "host": "irc.oftc.net",
            "port": 6697,
            "use_ssl": true
          }
        ],
        "user": "quasseluser",
        "nick": "quassel_of",
        "alt_nicks": "quassel_of2,quassel_of3",
        "real_name": "Quassel OFTC User",
        "auto_connect": false,
        "auto_join": []
      }
    ]
  }
}
