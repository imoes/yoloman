# Configuration for the Link Layer Discovery Protocol daemon (lldpd).
# This file controls the startup arguments passed to the lldpd service.

# DAEMON_ARGS: Startup arguments for the lldpd daemon.
# These arguments are passed directly to the lldpd process upon start.
# Common flags:
#   -x          Enable LLDP-MED (Media Endpoint Discovery)
#   -c          Enable CDP (Cisco Discovery Protocol)
#   -s          Enable SONMP (ShoreTel Network Management Protocol)
#   -e          Enable EDP (Edge Discovery Protocol)
#   -u          Disable SNMP subagent
#
# The default value '-x -c -s -e' enables LLDP-MED and several proprietary
# discovery protocols while keeping the SNMP subagent active.
#
# To modify the behavior, change the string below. Ensure the value is
# properly quoted if it contains spaces.
{% if lldpd is defined and lldpd is not none and (lldpd is number or lldpd is boolean or lldpd | length > 0) %}DAEMON_ARGS="{{ lldpd | default('-x -c -s -e') }}"{% else %}#DAEMON_ARGS="-x -c -s -e"{% endif %}
