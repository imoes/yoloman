# Configure global lldpd settings
CONFIGURE GLOBAL
  sysname {{ lldp.sysname | default('') | trim }}
  system-description {{ lldp.system_description | default('') | trim }}
  port-description {{ lldp.port_description | default('') | trim }}

# Enable or disable LLDP globally
{% if lldp.enabled | default(true) %}
ENABLE LLDP
{% else %}
DISABLE LLDP
{% endif %}

# Configure LLDP packet transmission interval (in seconds)
CONFIGURE LLDP
  tx-hold {{ lldp.tx_hold | default(4) }}
  tx-interval {{ lldp.tx_interval | default(30) }}

# Configure management address (IPv4/IPv6) for LLDP announcements
{% for addr in lldp.management_addresses | default([]) %}
CONFIGURE MANAGEMENT
  {% if addr.version == 4 %}
  ipv4 {{ addr.address }}
  {% elif addr.version == 6 %}
  ipv6 {{ addr.address }}
  {% endif %}
{% endfor %}

# Configure interfaces to enable/disable LLDP on
{% for interface in lldp.interfaces | default([]) %}
{% if interface.enabled | default(true) %}
CONFIGURE INTERFACE {{ interface.name }}
  ENABLE LLDP
{% if interface.description %}
  PORT DESCRIPTION {{ interface.description }}
{% endif %}
{% else %}
CONFIGURE INTERFACE {{ interface.name }}
  DISABLE LLDP
{% endif %}
{% endfor %}

# Set SNMP read-only community for LLDP-MIB access (if needed)
{% if lldp.snmp_community %}
CONFIGURE SNMP
  READCOMMUNITY {{ lldp.snmp_community }}
{% endif %}

# Configure chassis ID (MAC or chassis subtypes)
{% if lldp.chassis_id %}
CONFIGURE CHASSIS
  ID {{ lldp.chassis_id }}
{% endif %}
