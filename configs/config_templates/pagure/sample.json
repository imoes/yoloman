{
  "db_uri": "postgresql://pagure:secret@localhost/pagure_prod",
  "debug": false,
  "git_folder": "/var/lib/pagure/git/",
  "docs_folder": "/var/lib/pagure/docs/",
  "attachments_folder": "/var/lib/pagure/attachments/",
  "avatars_folder": "/var/lib/pagure/avatars/",
  "ssh_keydir": "/etc/pagure/authorized_keys/",
  "hooks_dir": "/usr/share/pagure/hooks/",
  "email_templates_dir": "/usr/share/pagure/email_templates/",
  "static_folder": "/usr/share/pagure/static/",
  "template_folder": "/usr/share/pagure/templates/",
  "static_url_path": "/static/",
  "pagure_url": "https://pagure.example.com/",
  "host": "127.0.0.1",
  "port": 5000,
  "use_ssl": true,
  "items_per_page": 25,
  "request_timeout": 10,
  "git_timeout": 60,
  "email_require_confirmation": true,
  "git_anonymous_clone": true,
  "git_http": false,
  "git_ssh": true,
  "git_http_auth": false,
  "git_hooks_enabled": [
    "post-receive",
    "pre-receive",
    "update"
  ],
  "email_domain_whitelist": [],
  "email_domain_blacklist": [
    "tempmail.com",
    "10minutemail.com"
  ],
  "mail_server": "smtp.example.com",
  "mail_port": 587,
  "mail_use_tls": true,
  "mail_use_ssl": false,
  "mail_username": "noreply@example.com",
  "mail_password": "smtp_password",
  "mail_default_sender": "noreply@example.com",
  "ldap_uri": "",
  "ldap_user_base": "",
  "ldap_user_filter": "(uid={{username}})",
  "ldap_uid_field": "uid",
  "ldap_email_field": "mail",
  "ldap_binddn": "",
  "ldap_bindpw": "",
  "oauth_providers": [
    {
      "name": "github",
      "client_id": "gh_client_id",
      "client_secret": "gh_client_secret",
      "base_url": "https://api.github.com/",
      "auth_url": "https://github.com/login/oauth/authorize",
      "token_url": "https://github.com/login/oauth/access_token",
      "user_info_url": "https://api.github.com/user",
      "scopes": [
        "user:email",
        "read:user"
      ]
    }
  ],
  "redis_url": "redis://localhost:6379/1",
  "webhook_delivery_timeout": 5,
  "notifications_on": true,
  "notify_on_new_issue": false,
  "reauth_require": true,
  "custom_footer": "<p>&copy; 2025 Example Corp.</p>",
  "project_forks": true,
  "project_readme_mandatory": false,
  "git_default_branch": "main",
  "branch_protection": true,
  "default_group": "",
  "tokens_enabled": true,
  "token_expiry": 0,
  "rate_limit": [
    100,
    60
  ],
  "plugins_enabled": true,
  "enabled_plugins": [
    "pagure_ci",
    "pagure_hook_deploy"
  ],
  "issues_enabled": true,
  "pull_requests_enabled": true,
  "wiki_enabled": false,
  "docs_enabled": false,
  "timeline_enabled": true,
  "avatars_enabled": true,
  "tags_enabled": true,
  "milestones_enabled": true,
  "priorities_enabled": false,
  "dependencies_enabled": false,
  "assignees_enabled": true,
  "cc_enabled": true,
  "milestone_due_dates": true,
  "allow_user_avatar": true,
  "gravatar_fallback": true,
  "gravatar_url": "https://www.gravatar.com/avatar/",
  "email_digests_enabled": false,
  "project_create": true,
  "project_private": true,
  "group_create": false,
  "private_project_require_group": true,
  "project_transfer": true,
  "project_delete": true,
  "issue_delete": true,
  "issue_soft_delete": true,
  "two_factor_auth": false,
  "oidc_enabled": false,
  "oidc_metadata_url": "",
  "oidc_discovery": true,
  "webauthn_enabled": false,
  "totp_enabled": true,
  "email_2fa_enabled": false,
  "maintenance": false,
  "maintenance_message": "",
  "sql_alchemy_echo": false,
  "custom_error_page": false,
  "x_frame_options": "DENY",
  "x_content_type_options": "nosniff",
  "content_security_policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'",
  "hsts_enabled": true,
  "hsts_max_age": 31536000,
  "session_cookie_secure": true,
  "session_cookie_http_only": true,
  "session_cookie_name": "pagure_session",
  "permanent_session_lifetime": 31536000,
  "wtf_csrf_enabled": true,
  "login_rate_limit": true,
  "login_rate_limit_count": 10,
  "login_rate_limit_window": 300,
  "password_require_complex": true,
  "password_min_length": 12,
  "password_require_digit": true,
  "password_require_upper": true,
  "password_require_lower": true,
  "password_require_special": false,
  "email_verification_on_reset": true,
  "password_reuse_check": true,
  "password_reuse_count": 5,
  "account_lockout": true,
  "account_lockout_threshold": 5,
  "account_lockout_duration": 900,
  "password_expiry": false,
  "password_expiry_days": 90,
  "password_expiry_warning_days": 14,
  "password_history": false,
  "password_history_count": 5,
  "password_self_service": true,
  "account_self_delete": true,
  "account_delete_confirm": true,
  "account_delete_email": true,
  "project_delete_archive": true,
  "audit_log": true,
  "audit_log_file": "/var/log/pagure/audit.log",
  "activity_log": true,
  "log_ip_address": true,
  "log_user_agent": false,
  "request_log": true,
  "request_log_file": "/var/log/pagure/request.log",
  "access_log": true,
  "access_log_file": "/var/log/pagure/access.log",
  "error_log": true,
  "error_log_file": "/var/log/pagure/error.log",
  "debug_log": false,
  "debug_log_file": "/var/log/pagure/debug.log",
  "log_rotate": true,
  "log_rotate_max_bytes": 10485760,
  "log_rotate_backup_count": 5,
  "json_log": false,
  "structured_log": false
}
