# PostgreSQL Configuration Tracker (pg_track_settings) extension configuration
# Track changes to PostgreSQL configuration settings over time
pg_track_settings.track_ddl = {{ track_ddl }}
pg_track_settings.track_function_usage = {{ track_function_usage }}
pg_track_settings.track_planning_usage = {{ track_planning_usage }}
pg_track_settings.track_utilization = {{ track_utilization }}
pg_track_settings.track_locks = {{ track_locks }}
pg_track_settings.track_wal = {{ track_wal }}
pg_track_settings.track_io_timing = {{ track_io_timing }}
pg_track_settings.track_locks_mode = '{{ track_locks_mode }}'
pg_track_settings.track_function_usage_mode = '{{ track_function_usage_mode }}'
pg_track_settings.track_planning_usage_mode = '{{ track_planning_usage_mode }}'
pg_track_settings.track_utilization_mode = '{{ track_utilization_mode }}'
pg_track_settings.track_locks_mode = '{{ track_locks_mode }}'
pg_track_settings.track_wal_mode = '{{ track_wal_mode }}'
pg_track_settings.track_io_timing_mode = '{{ track_io_timing_mode }}'
pg_track_settings.track_ddl_schema = '{{ track_ddl_schema }}'
pg_track_settings.track_ddl_table = '{{ track_ddl_table }}'
pg_track_settings.track_function_usage_schema = '{{ track_function_usage_schema }}'
pg_track_settings.track_function_usage_table = '{{ track_function_usage_table }}'
pg_track_settings.track_planning_usage_schema = '{{ track_planning_usage_schema }}'
pg_track_settings.track_planning_usage_table = '{{ track_planning_usage_table }}'
pg_track_settings.track_utilization_schema = '{{ track_utilization_schema }}'
pg_track_settings.track_utilization_table = '{{ track_utilization_table }}'
pg_track_settings.track_locks_schema = '{{ track_locks_schema }}'
pg_track_settings.track_locks_table = '{{ track_locks_table }}'
pg_track_settings.track_wal_schema = '{{ track_wal_schema }}'
pg_track_settings.track_wal_table = '{{ track_wal_table }}'
pg_track_settings.track_io_timing_schema = '{{ track_io_timing_schema }}'
pg_track_settings.track_io_timing_table = '{{ track_io_timing_table }}'
pg_track_settings.track_ddl_retention_days = {{ track_ddl_retention_days }}
pg_track_settings.track_function_usage_retention_days = {{ track_function_usage_retention_days }}
pg_track_settings.track_planning_usage_retention_days = {{ track_planning_usage_retention_days }}
pg_track_settings.track_utilization_retention_days = {{ track_utilization_retention_days }}
pg_track_settings.track_locks_retention_days = {{ track_locks_retention_days }}
pg_track_settings.track_wal_retention_days = {{ track_wal_retention_days }}
pg_track_settings.track_io_timing_retention_days = {{ track_io_timing_retention_days }}
{% for table in excluded_tables %}pg_track_settings.excluded_tables = '{{ table.schema_name }}.{{ table.table_name }}'
{% endfor %}
{% for function in excluded_functions %}pg_track_settings.excluded_functions = '{{ function.schema_name }}.{{ function.function_name }}'
{% endfor %}