{# sogo.conf from the shipped file — a GNUstep property list, where only /* */ and // are comments; every
   `Key = value;` is a field named after the key. The regenerated template wrote `#` comments and SOGo refused
   it ("Cannot read configuration from '/etc/sogo/sogo.conf'"). #}
{
  SOGoProfileURL = "{{ SOGoProfileURL | default("postgresql://sogo:password@127.0.0.1:5432/sogo/sogo_user_profile") }}";
  OCSFolderInfoURL = "{{ OCSFolderInfoURL | default("postgresql://sogo:password@127.0.0.1:5432/sogo/sogo_folder_info") }}";
  OCSSessionsFolderURL = "{{ OCSSessionsFolderURL | default("postgresql://sogo:password@127.0.0.1:5432/sogo/sogo_sessions_folder") }}";
  OCSEMailAlarmsFolderURL = "{{ OCSEMailAlarmsFolderURL | default("postgresql://sogo:password@127.0.0.1:5432/sogo/sogo_alarms_folder") }}";
  SOGoLanguage = {{ SOGoLanguage | default("English") }};
  SOGoAppointmentSendEMailNotifications = {{ SOGoAppointmentSendEMailNotifications | default("YES") }};
  SOGoMailingMechanism = {{ SOGoMailingMechanism | default("smtp") }};
  SOGoSMTPServer = {{ SOGoSMTPServer | default("127.0.0.1") }};
  SOGoTimeZone = {{ SOGoTimeZone | default("UTC") }};
  SOGoSentFolderName = {{ SOGoSentFolderName | default("Sent") }};
  SOGoTrashFolderName = {{ SOGoTrashFolderName | default("Trash") }};
  SOGoDraftsFolderName = {{ SOGoDraftsFolderName | default("Drafts") }};
  SOGoIMAPServer = "{{ SOGoIMAPServer | default("imaps://localhost:143/?tls=YES") }}";
  SOGoSieveServer = "{{ SOGoSieveServer | default("sieve://localhost:4190/?tls=YES") }}";
  SOGoIMAPAclConformsToIMAPExt = {{ SOGoIMAPAclConformsToIMAPExt | default("YES") }};
  SOGoVacationEnabled = {{ SOGoVacationEnabled | default("NO") }};
  SOGoForwardEnabled = {{ SOGoForwardEnabled | default("NO") }};
  SOGoSieveScriptsEnabled = {{ SOGoSieveScriptsEnabled | default("NO") }};
  SOGoFirstDayOfWeek = {{ SOGoFirstDayOfWeek | default(0) }};
  SOGoMailMessageCheck = {{ SOGoMailMessageCheck | default("manually") }};
  SOGoMailAuxiliaryUserAccountsEnabled = {{ SOGoMailAuxiliaryUserAccountsEnabled | default("NO") }};
  SOGoMemcachedHost = {{ SOGoMemcachedHost | default("127.0.0.1") }};
}
