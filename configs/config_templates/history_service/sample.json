{
  "base_dir": "/var/lib/lomiri/history-service",
  "database": {
    "path": "/var/lib/lomiri/history-service/db.sqlite3",
    "max_size_mb": 2048,
    "journal_mode": "wal",
    "pool_size": 15
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/lomiri/history-service/history-service.log",
    "console": true,
    "max_file_size_mb": 100,
    "max_file_count": 10
  },
  "network": {
    "host": "0.0.0.0",
    "api_port": 8080,
    "metrics_port": 9090,
    "tls_enabled": true,
    "tls_cert": "/etc/ssl/certs/history-service.crt",
    "tls_key": "/etc/ssl/private/history-service.key"
  },
  "compression": {
    "enabled": true,
    "min_size": 256
  },
  "workers": {
    "processes": 4,
    "threads": 4,
    "max_requests": 10000,
    "worker_timeout": 60
  },
  "retention": {
    "message_days": 365,
    "call_days": 365,
    "prune_enabled": true,
    "prune_schedule": "0 2 * * *"
  },
  "cors": {
    "origins": [
      "https://lomiri.example.com",
      "https://webapp.example.com"
    ],
    "allow_credentials": true
  },
  "cache": {
    "max_entries": 50000,
    "ttl_seconds": 600,
    "stats_enabled": true
  }
}
