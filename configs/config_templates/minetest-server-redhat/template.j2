#    Requires shaders to be enabled.
#    type: bool
{% if enable_waving_leaves is defined and enable_waving_leaves is not none and (enable_waving_leaves is number or enable_waving_leaves is boolean or enable_waving_leaves | length > 0) %}enable_waving_leaves = {{ enable_waving_leaves }}
{% else %}# enable_waving_leaves = false
{% endif %}
#    Set to true to enable waving plants.
#    Requires shaders to be enabled.
#    type: bool
{% if enable_waving_plants is defined and enable_waving_plants is not none and (enable_waving_plants is number or enable_waving_plants is boolean or enable_waving_plants | length > 0) %}enable_waving_plants = {{ enable_waving_plants }}
{% else %}# enable_waving_plants = false
{% endif %}
#    Set to true to enable waving liquids (like water).
#    Requires shaders to be enabled.
#    type: bool
{% if enable_waving_water is defined and enable_waving_water is not none and (enable_waving_water is number or enable_waving_water is boolean or enable_waving_water | length > 0) %}enable_waving_water = {{ enable_waving_water }}
{% else %}# enable_waving_water = false
{% endif %}
#    The maximum height of the surface of waving liquids.
#    4.0 = Wave height is two nodes.
#    0.0 = Wave doesn't move at all.
#    Default is 1.0 (1/2 node).
#    Requires waving liquids to be enabled.
#    type: float min: 0 max: 4
{% if water_wave_height is defined and water_wave_height is not none and (water_wave_height is number or water_wave_height is boolean or water_wave_height | length > 0) %}water_wave_height = {{ water_wave_height }}
{% else %}# water_wave_height = 1.0
