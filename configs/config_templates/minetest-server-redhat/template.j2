## Mapgen V7

#    Map generation attributes specific to Mapgen v7.
#    'ridges': Rivers.
#    'floatlands': Floating land masses in the atmosphere.
#    'caverns': Giant caves deep underground.
#    type: flags possible values: mountains, ridges, floatlands, caverns, nomountains, noridges, nofloatlands, nocaverns
{% if mgv7_spflags is defined and mgv7_spflags is not none and (mgv7_spflags is number or mgv7_spflags is boolean or mgv7_spflags | length > 0) %}mgv7_spflags = {{ mgv7_spflags }}
{% else %}# mgv7_spflags = mountains,ridges,nofloatlands,caverns
{% endif %}
#    Y of mountain density gradient zero level. Used to shift mountains vertically.
#    type: int min: -31000 max: 31000
{% if mgv7_mount_zero_level is defined and mgv7_mount_zero_level is not none and (mgv7_mount_zero_level is number or mgv7_mount_zero_level is boolean or mgv7_mount_zero_level | length > 0) %}mgv7_mount_zero_level = {{ mgv7_mount_zero_level }}
{% else %}# mgv7_mount_zero_level = 0
{% endif %}
#    Lower Y limit of floatlands.
#    type: int min: -31000 max: 31000
{% if mgv7_floatland_ymin is defined and mgv7_floatland_ymin is not none and (mgv7_floatland_ymin is number or mgv7_floatland_ymin is boolean or mgv7_floatland_ymin | length > 0) %}mgv7_floatland_ymin = {{ mgv7_floatland_ymin }}
{% else %}# mgv7_floatland_ymin = 1024
{% endif %}
#    Upper Y limit of floatlands.
#    type: int min: -31000 max: 31000
{% if mgv7_floatland_ymax is defined and mgv7_floatland_ymax is not none and (mgv7_floatland_ymax is number or mgv7_floatland_ymax is boolean or mgv7_floatland_ymax | length > 0) %}mgv7_floatland_ymax = {{ mgv7_floatland_ymax }}
{% else %}# mgv7_floatland_ymax = 4096
{% endif %}
#    Y-distance over which floatlands taper from full density to nothing.
#    Tapering starts at this distance from the Y limit.
#    For a solid floatland layer, this controls the height of hills/mountains.
#    Must be less than or equal to half the distance between the Y limits.
#    type: int min: 0 max: 32767
{% if mgv7_floatland_taper is defined and mgv7_floatland_taper is not none and (mgv7_floatland_taper is number or mgv7_floatland_taper is boolean or mgv7_floatland_taper | length > 0) %}mgv7_floatland_taper = {{ mgv7_floatland_taper }}
{% else %}# mgv7_floatland_taper = 256
{% endif %}
#    Exponent of the floatland tapering. Alters the tapering behaviour.
#    Value = 1.0 creates a uniform, linear tapering.
#    Values > 1.0 create a smooth tapering suitable for the default separated
#    floatlands.
#    Values < 1.0 (for example 0.25) create a more defined surface level with
#    flatter lowlands, suitable for a solid floatland layer.
#    type: float
{% if mgv7_float_taper_exp is defined and mgv7_float_taper_exp is not none and (mgv7_float_taper_exp is number or mgv7_float_taper_exp is boolean or mgv7_float_taper_exp | length > 0) %}mgv7_float_taper_exp = {{ mgv7_float_taper_exp }}
{% else %}# mgv7_float_taper_exp = 2.0
{% endif %}
#    Adjusts the density of the floatland layer.
#    Increase value to increase density. Can be positive or negative.
#    Value = 0.0: 50% of volume is floatland.
#    Value = 2.0 (can be higher depending on 'mgv7_np_floatland', always test
#    to be sure) creates a solid floatland layer.
#    type: float
{% if mgv7_floatland_density is defined and mgv7_floatland_density is not none and (mgv7_floatland_density is number or mgv7_floatland_density is boolean or mgv7_floatland_density | length > 0) %}mgv7_floatland_density = {{ mgv7_floatland_density }}
{% else %}# mgv7_floatland_density = -0.6
{% endif %}
#    Surface level of optional water placed on a solid floatland layer.
#    Water is disabled by default and will only be placed if this value is set
#    to above 'mgv7_floatland_ymax' - 'mgv7_floatland_taper' (the start of the
#    upper tapering).
#    ***WARNING, POTENTIAL DANGER TO WORLDS AND SERVER PERFORMANCE***:
#    When enabling water placement the floatlands must be configured and tested
#    to be a solid layer by setting 'mgv7_floatland_density' to 2.0 (or other
#    required value depending on 'mgv7_np_floatland'), to avoid
#    server-intensive extreme water flow and to avoid vast flooding of the
#    world surface below.
#    type: int min: -31000 max: 31000
{% if mgv7_floatland_ywater is defined and mgv7_floatland_ywater is not none and (mgv7_floatland_ywater is number or mgv7_floatland_ywater is boolean or mgv7_floatland_ywater | length > 0) %}mgv7_floatland_ywater = {{ mgv7_floatland_ywater }}
{% else %}# mgv7_floatland_ywater = -31000
{% endif %}
#    Controls width of tunnels, a smaller value creates wider tunnels.
