### Filtering and Antialiasing

#    Use mipmapping to scale textures. May slightly increase performance,
#    especially when using a high resolution texture pack.
#    Gamma correct downscaling is not supported.
#    type: bool
{% if mip_map is defined and mip_map is not none and (mip_map is number or mip_map is boolean or mip_map | length > 0) %}mip_map = {{ mip_map }}
{% else %}# mip_map = false
{% endif %}
#    Use anisotropic filtering when viewing at textures from an angle.
#    type: bool
{% if anisotropic_filter is defined and anisotropic_filter is not none and (anisotropic_filter is number or anisotropic_filter is boolean or anisotropic_filter | length > 0) %}anisotropic_filter = {{ anisotropic_filter }}
{% else %}# anisotropic_filter = false
{% endif %}
#    Use bilinear filtering when scaling textures.
#    type: bool
{% if bilinear_filter is defined and bilinear_filter is not none and (bilinear_filter is number or bilinear_filter is boolean or bilinear_filter | length > 0) %}bilinear_filter = {{ bilinear_filter }}
{% else %}# bilinear_filter = false
{% endif %}
#    Use trilinear filtering when scaling textures.
#    type: bool
{% if trilinear_filter is defined and trilinear_filter is not none and (trilinear_filter is number or trilinear_filter is boolean or trilinear_filter | length > 0) %}trilinear_filter = {{ trilinear_filter }}
{% else %}# trilinear_filter = false
{% endif %}
#    Filtered textures can blend RGB values with fully-transparent neighbors,
#    which PNG optimizers usually discard, often resulting in dark or
#    light edges to transparent textures. Apply a filter to clean that up
#    at texture load time. This is automatically enabled if mipmapping is enabled.
#    type: bool
{% if texture_clean_transparent is defined and texture_clean_transparent is not none and (texture_clean_transparent is number or texture_clean_transparent is boolean or texture_clean_transparent | length > 0) %}texture_clean_transparent = {{ texture_clean_transparent }}
{% else %}# texture_clean_transparent = false
{% endif %}
#    When using bilinear/trilinear/anisotropic filters, low-resolution textures
#    can be blurred, so automatically upscale them with nearest-neighbor
#    interpolation to preserve crisp pixels. This sets the minimum texture size
#    for the upscaled textures; higher values look sharper, but require more
#    memory. Powers of 2 are recommended. This setting is ONLY applied if
#    bilinear/trilinear/anisotropic filtering is enabled.
#    This is also used as the base node texture size for world-aligned
#    texture autoscaling.
#    type: int min: 1 max: 32768
{% if texture_min_size is defined and texture_min_size is not none and (texture_min_size is number or texture_min_size is boolean or texture_min_size | length > 0) %}texture_min_size = {{ texture_min_size }}
{% else %}# texture_min_size = 64
{% endif %}
#    Use multi-sample antialiasing (MSAA) to smooth out block edges.
#    This algorithm smooths out the 3D viewport while keeping the image sharp,
#    but it doesn't affect the insides of textures
#    (which is especially noticeable with transparent textures).
#    Visible spaces appear between nodes when shaders are disabled.
#    If set to 0, MSAA is disabled.
#    A restart is required after changing this option.
#    type: enum values: 0, 1, 2, 4, 8, 16
{% if fsaa is defined and fsaa is not none and (fsaa is number or fsaa is boolean or fsaa | length > 0) %}fsaa = {{ fsaa }}
{% else %}# fsaa = 0
{% endif %}
## Shaders

#    Shaders allow advanced visual effects and may increase performance on some video
