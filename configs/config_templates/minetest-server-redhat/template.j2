#    This file contains a list of all available settings and their default value for minetest.conf

#    By default, all the settings are commented and not functional.
#    Uncomment settings by removing the preceding #.

#    minetest.conf is read by default from:
#    ../minetest.conf
#    ../../minetest.conf
#    Any other path can be chosen by passing the path as a parameter
#    to the program, eg. "minetest.exe --config ../minetest.conf.example".

#    Further documentation:
#    http://wiki.minetest.net/

#
# Controls
#

## General

#    If enabled, you can place blocks at the position (feet + eye level) where you stand.
#    This is helpful when working with nodeboxes in small areas.
#    type: bool
{% if enable_build_where_you_stand is defined and enable_build_where_you_stand is not none and (enable_build_where_you_stand is number or enable_build_where_you_stand is boolean or enable_build_where_you_stand | length > 0) %}enable_build_where_you_stand = {{ enable_build_where_you_stand }}
{% else %}# enable_build_where_you_stand = false
{% endif %}
#    Smooths camera when looking around. Also called look or mouse smoothing.
#    Useful for recording videos.
#    type: bool
{% if cinematic is defined and cinematic is not none and (cinematic is number or cinematic is boolean or cinematic | length > 0) %}cinematic = {{ cinematic }}
{% else %}# cinematic = false
{% endif %}
#    Smooths rotation of camera. 0 to disable.
#    type: float min: 0 max: 0.99
{% if camera_smoothing is defined and camera_smoothing is not none and (camera_smoothing is number or camera_smoothing is boolean or camera_smoothing | length > 0) %}camera_smoothing = {{ camera_smoothing }}
{% else %}# camera_smoothing = 0.0
{% endif %}
#    Smooths rotation of camera in cinematic mode. 0 to disable.
#    type: float min: 0 max: 0.99
{% if cinematic_camera_smoothing is defined and cinematic_camera_smoothing is not none and (cinematic_camera_smoothing is number or cinematic_camera_smoothing is boolean or cinematic_camera_smoothing | length > 0) %}cinematic_camera_smoothing = {{ cinematic_camera_smoothing }}
{% else %}# cinematic_camera_smoothing = 0.7
{% endif %}
#    If enabled, "Aux1" key instead of "Sneak" key is used for climbing down and
#    descending.
#    type: bool
{% if aux1_descends is defined and aux1_descends is not none and (aux1_descends is number or aux1_descends is boolean or aux1_descends | length > 0) %}aux1_descends = {{ aux1_descends }}
{% else %}# aux1_descends = false
{% endif %}
#    Double-tapping the jump key toggles fly mode.
#    type: bool
{% if doubletap_jump is defined and doubletap_jump is not none and (doubletap_jump is number or doubletap_jump is boolean or doubletap_jump | length > 0) %}doubletap_jump = {{ doubletap_jump }}
{% else %}# doubletap_jump = false
{% endif %}
#    If disabled, "Aux1" key is used to fly fast if both fly and fast mode are
#    enabled.
#    type: bool
{% if always_fly_fast is defined and always_fly_fast is not none and (always_fly_fast is number or always_fly_fast is boolean or always_fly_fast | length > 0) %}always_fly_fast = {{ always_fly_fast }}
{% else %}# always_fly_fast = true
{% endif %}
#    The time in seconds it takes between repeated node placements when holding
#    the place button.
#    type: float min: 0.25 max: 2
{% if repeat_place_time is defined and repeat_place_time is not none and (repeat_place_time is number or repeat_place_time is boolean or repeat_place_time | length > 0) %}repeat_place_time = {{ repeat_place_time }}
{% else %}# repeat_place_time = 0.25
{% endif %}
#    Automatically jump up single-node obstacles.
#    type: bool
{% if autojump is defined and autojump is not none and (autojump is number or autojump is boolean or autojump | length > 0) %}autojump = {{ autojump }}
{% else %}# autojump = false
{% endif %}
#    Prevent digging and placing from repeating when holding the mouse buttons.
#    Enable this when you dig or place too often by accident.
#    type: bool
{% if safe_dig_and_place is defined and safe_dig_and_place is not none and (safe_dig_and_place is number or safe_dig_and_place is boolean or safe_dig_and_place | length > 0) %}safe_dig_and_place = {{ safe_dig_and_place }}
{% else %}# safe_dig_and_place = false
{% endif %}
## Keyboard and Mouse

#    Invert vertical mouse movement.
#    type: bool
{% if invert_mouse is defined and invert_mouse is not none and (invert_mouse is number or invert_mouse is boolean or invert_mouse | length > 0) %}invert_mouse = {{ invert_mouse }}
{% else %}# invert_mouse = false
{% endif %}
#    Mouse sensitivity multiplier.
#    type: float min: 0.001 max: 10
{% if mouse_sensitivity is defined and mouse_sensitivity is not none and (mouse_sensitivity is number or mouse_sensitivity is boolean or mouse_sensitivity | length > 0) %}mouse_sensitivity = {{ mouse_sensitivity }}
{% else %}# mouse_sensitivity = 0.2
{% endif %}
## Touchscreen

#    The length in pixels it takes for touch screen interaction to start.
#    type: int min: 0 max: 100
{% if touchscreen_threshold is defined and touchscreen_threshold is not none and (touchscreen_threshold is number or touchscreen_threshold is boolean or touchscreen_threshold | length > 0) %}touchscreen_threshold = {{ touchscreen_threshold }}
{% else %}# touchscreen_threshold = 20
{% endif %}
#    (Android) Fixes the position of virtual joystick.
