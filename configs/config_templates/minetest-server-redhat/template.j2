### Camera

#    Camera 'near clipping plane' distance in nodes, between 0 and 0.25
#    Only works on GLES platforms. Most users will not need to change this.
#    Increasing can reduce artifacting on weaker GPUs.
#    0.1 = Default, 0.25 = Good value for weaker tablets.
#    type: float min: 0 max: 0.25
{% if near_plane is defined and near_plane is not none and (near_plane is number or near_plane is boolean or near_plane | length > 0) %}near_plane = {{ near_plane }}
{% else %}# near_plane = 0.1
{% endif %}
#    Field of view in degrees.
#    type: int min: 45 max: 160
{% if fov is defined and fov is not none and (fov is number or fov is boolean or fov | length > 0) %}fov = {{ fov }}
{% else %}# fov = 72
{% endif %}
#    Alters the light curve by applying 'gamma correction' to it.
#    Higher values make middle and lower light levels brighter.
#    Value '1.0' leaves the light curve unaltered.
#    This only has significant effect on daylight and artificial
#    light, it has very little effect on natural night light.
#    type: float min: 0.33 max: 3
{% if display_gamma is defined and display_gamma is not none and (display_gamma is number or display_gamma is boolean or display_gamma | length > 0) %}display_gamma = {{ display_gamma }}
{% else %}# display_gamma = 1.0
{% endif %}
#    The strength (darkness) of node ambient-occlusion shading.
#    Lower is darker, Higher is lighter. The valid range of values for this
#    setting is 0.25 to 4.0 inclusive. If the value is out of range it will be
#    set to the nearest valid value.
#    type: float min: 0.25 max: 4
{% if ambient_occlusion_gamma is defined and ambient_occlusion_gamma is not none and (ambient_occlusion_gamma is number or ambient_occlusion_gamma is boolean or ambient_occlusion_gamma | length > 0) %}ambient_occlusion_gamma = {{ ambient_occlusion_gamma }}
{% else %}# ambient_occlusion_gamma = 2.2
{% endif %}
