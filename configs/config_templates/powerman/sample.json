{
  "listen_port": 3880,
  "log_level": "info",
  "log_file": "",
  "auth_required": true,
  "auth_file": "/etc/powerman/htpasswd",
  "device_timeout": 10,
  "device_retries": 2,
  "status_poll_interval": 30,
  "ssl_enabled": false,
  "ssl_certificate_path": "/etc/powerman/ssl.crt",
  "ssl_private_key_path": "/etc/powerman/ssl.key",
  "devices": [
    {
      "name": "pdu_rack_a",
      "type": "pdu",
      "host": "pdu-rack-a.example.com",
      "port": 23,
      "username": "admin",
      "password": "secret123",
      "model": "APC SmartSlot"
    },
    {
      "name": "ups_main",
      "type": "ups",
      "host": "10.0.0.50",
      "port": 161,
      "username": "public",
      "model": "APC UPSNet"
    }
  ],
  "nodes": [
    {
      "name": "rack_a_servers",
      "members": [
        "pdu_rack_a"
      ]
    }
  ],
  "resources": [
    {
      "name": "web_cluster",
      "type": "outlet",
      "outlets": [
        {
          "device": "pdu_rack_a",
          "outlet": "1"
        },
        {
          "device": "pdu_rack_a",
          "outlet": "2"
        },
        {
          "device": "pdu_rack_a",
          "outlet": "3"
        }
      ]
    }
  ],
  "acls": [
    {
      "name": "ops_web_cluster",
      "description": "Allow ops group to control web cluster",
      "action": "on",
      "resource": "web_cluster",
      "group": "ops"
    },
    {
      "name": "ops_cycle_all",
      "description": "Allow ops group to cycle any resource",
      "action": "cycle",
      "resource": "*",
      "group": "ops"
    }
  ]
}
