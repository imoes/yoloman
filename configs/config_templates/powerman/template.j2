# Powerman APC Masterswitch Plus configuration via SNMP.
# This template configures the powerman daemon to control an APC PDU (Power Distribution Unit)
# using the PowerNet-MIB over SNMPv1.

# Specification block for the APC SNMP driver.
specification "apc-snmp" {

    # Timeout value for SNMP commands in seconds.
    # If the PDU does not respond within this time, the command fails.
    timeout {{ timeout | default('10') }}   # about 5 sec for cycle command

    # Define the names/indices of the power outlets available on the switch.
    # These correspond to the physical ports on the APC unit.
    plug name { "1" "2" "3" "4" "5" "6" "7" "8" }

    # Script to establish an SNMP session with the PDU.
    script login {
        # Wait for the command prompt from the APC device.
        expect "snmppower> "
        # Send the login command using community string "private".
        send "start_v1 private\n"
        # Confirm the device has accepted the session.
        expect "snmppower> "
    }

    # Script to cleanly terminate the SNMP session.
    script logout {
        # Send the finish command to close the connection.
        send "finish\n"
        # Ensure the prompt is back before proceeding.
        expect "snmppower> "
    }

    # Script to retrieve the power state of all 8 outlets simultaneously.
    # Queries PowerNet-MIB::sPDUMasterState.0 which returns a concatenated status string.
    script status_all {
        # Send the SNMP GET request for the master state OID.
        send "get enterprises.318.1.1.4.2.2.0\n"
        # Expect the response containing the On/Off state for each plug.
        # The regex captures the state of plugs 1 through 8 into variables $1-$8.
        expect   "enterprises.318.1.1.4.2.2.0: (On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]*\n"
        # Map the captured states to the respective plug indices.
        setplugstate "1" $1 off="Off" on="On"
        setplugstate "2" $2 off="Off" on="On"
        setplugstate "3" $3 off="Off" on="On"
        setplugstate "4" $4 off="Off" on="On"
        setplugstate "5" $5 off="Off" on="On"
        setplugstate "6" $6 off="Off" on="On"
        setplugstate "7" $7 off="Off" on="On"
        setplugstate "8" $8 off="Off" on="On"
    }

    # Script to power ON a specific outlet.
    # Queries PowerNet-MIB::sPDUOutletControl.sPDUOutletControlTable.
    # sPDUOutletControlEntry.sPDUOutletCtl.<outlet:1-8>
    script on {
        # Set the control OID for the target plug (passed as %s) to value 1 (On).
        send "set enterprises.318.1.1.4.4.2.1.3.%s i 1\n"
        # Expect confirmation of the new state.
        expect   "enterprises.318.1.1.4.4.2.1.3.[1-8]: 1\n"
        # Wait for the prompt to indicate readiness for the next command.
        expect "snmppower> "
    }

    # Script to power OFF a specific outlet.
    # Queries PowerNet-MIB::sPDUOutletControl.sPDUOutletControlTable.
    script off {
        # Set the control OID for the target plug (passed as %s) to value 2 (Off).
        send "set enterprises.318.1.1.4.4.2.1.3.%s i 2\n"
        # Expect confirmation of the new state.
        expect   "enterprises.318.1.1.4.4.2.1.3.[1-8]: 2\n"
        # Wait for the prompt to indicate readiness for the next command.
        expect "snmppower> "
    }

    # Script to cycle power (turn off, wait, turn on) for a specific outlet.
    script cycle {
        # Step 1: Turn OFF the target plug (passed as %s).
        send "set enterprises.318.1.1.4.4.2.1.3.%s i 2\n"
        # Expect confirmation of the OFF state.
        expect   "enterprises.318.1.1.4.4.2.1.3.[1-8]: 2\n"
        # Wait for the prompt.
        expect "snmppower> "
        
        # Delay to allow devices to fully power down.
        delay 5
        
        # Step 2: Turn ON the target plug.
        send "set enterprises.318.1.1.4.4.2.1.3.%s i 1\n"
        # Expect confirmation of the ON state.
        expect   "enterprises.318.1.1.4.4.2.1.3.[1-8]: 1\n"
        # Wait for the prompt.
        expect "snmppower> "
    }
}
