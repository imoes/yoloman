[# Main configuration file for Hyper-V daemons (hv_vss_daemon, hv_fcopy_daemon, hv_kvp_daemon)
# Each daemon can be enabled/disabled independently
# Optional: specify custom binary path, log level, and extra arguments

# Enable hv_vss_daemon (Hyper-V Volume Shadow Copy Service daemon)
ENABLE_HV_VSS={{ hv_vss_daemon.enabled | string | lower }}
HV_VSS_DAEMON={{ hv_vss_daemon.bin_path }}
HV_VSS_LOGLEVEL={{ hv_vss_daemon.log_level }}
HV_VSS_ARGS={{ hv_vss_daemon.extra_args | join(' ') if hv_vss_daemon.extra_args else '' }}

# Enable hv_fcopy_daemon (Hyper-V File Copy daemon)
ENABLE_HV_FCOPY={{ hv_fcopy_daemon.enabled | string | lower }}
HV_FCOPY_DAEMON={{ hv_fcopy_daemon.bin_path }}
HV_FCOPY_LOGLEVEL={{ hv_fcopy_daemon.log_level }}
HV_FCOPY_ARGS={{ hv_fcopy_daemon.extra_args | join(' ') if hv_fcopy_daemon.extra_args else '' }}

# Enable hv_kvp_daemon (Hyper-V Key-Value Pair daemon)
ENABLE_HV_KVP={{ hv_kvp_daemon.enabled | string | lower }}
HV_KVP_DAEMON={{ hv_kvp_daemon.bin_path }}
HV_KVP_LOGLEVEL={{ hv_kvp_daemon.log_level }}
HV_KVP_ARGS={{ hv_kvp_daemon.extra_args | join(' ') if hv_kvp_daemon.extra_args else '' }}