{
  "raddb_dir": {
    "type": "string",
    "default": "/etc/freeradius",
    "description": "Base directory for FreeRADIUS configuration files"
  },
  "raddb_mods_available_dir": {
    "type": "string",
    "default": "/etc/freeradius/mods-available",
    "description": "Directory containing available module configuration files"
  },
  "raddb_mods_enabled_dir": {
    "type": "string",
    "default": "/etc/freeradius/mods-enabled",
    "description": "Directory containing enabled module configuration files"
  },
  "raddb_mods_config_dir": {
    "type": "string",
    "default": "/etc/freeradius/mods-config",
    "description": "Directory containing module-specific configuration files"
  },
  "raddb_sites_available_dir": {
    "type": "string",
    "default": "/etc/freeradius/sites-available",
    "description": "Directory containing available virtual server configurations"
  },
  "raddb_sites_enabled_dir": {
    "type": "string",
    "default": "/etc/freeradius/sites-enabled",
    "description": "Directory containing enabled virtual server configurations"
  },
  "raddb_policies_dir": {
    "type": "string",
    "default": "/etc/freeradius/policy.d",
    "description": "Directory containing policy files"
  },
  "raddb_users_file": {
    "type": "string",
    "default": "/etc/freeradius/users",
    "description": "Path to the default users file"
  },
  "raddb_huntgroups_file": {
    "type": "string",
    "default": "/etc/freeradius/huntgroups",
    "description": "Path to the default huntgroups file"
  },
  "raddb_clients_file": {
    "type": "string",
    "default": "/etc/freeradius/clients.conf",
    "description": "Path to the clients configuration file"
  },
  "raddb_eap_conf": {
    "type": "string",
    "default": "/etc/freeradius/mods-available/eap",
    "description": "Path to the EAP module configuration file"
  },
  "raddb_sql_conf": {
    "type": "string",
    "default": "/etc/freeradius/mods-available/sql",
    "description": "Path to the SQL module configuration file"
  },
  "raddb_sql_ippool_conf": {
    "type": "string",
    "default": "/etc/freeradius/mods-available/sqlippool",
    "description": "Path to the SQLippool module configuration file"
  },
  "raddb_ldap_conf": {
    "type": "string",
    "default": "/etc/freeradius/mods-available/ldap",
    "description": "Path to the LDAP module configuration file"
  },
  "radacctdir": {
    "type": "string",
    "default": "/var/log/radacct",
    "description": "Directory for accounting log files"
  },
  "logfile": {
    "type": "string",
    "default": "${logdir}/radius.log",
    "description": "Main radius log file path"
  },
  "logdir": {
    "type": "string",
    "default": "/var/log/freeradius",
    "description": "Base directory for log files"
  },
  "libdir": {
    "type": "string",
    "default": "/usr/lib/freeradius",
    "description": "Directory for FreeRADIUS modules"
  },
  "confdir": {
    "type": "string",
    "default": "/etc/freeradius",
    "description": "Configuration directory alias (same as raddb_dir)"
  },
  "run_dir": {
    "type": "string",
    "default": "/run/freeradius",
    "description": "Directory for runtime files (PID, sockets)"
  },
  "db_dir": {
    "type": "string",
    "default": "/var/lib/freeradius",
    "description": "Directory for runtime databases (e.g. sql, cache)"
  },
  "max_request_time": {
    "type": "number",
    "default": 30,
    "description": "Maximum request processing time in seconds"
  },
  "cleanup_delay": {
    "type": "number",
    "default": 5,
    "description": "Delay before cleaning up completed requests"
  },
  "max_requests": {
    "type": "number",
    "default": 1024,
    "description": "Maximum number of simultaneous requests"
  },
  "hostname": {
    "type": "string",
    "default": "localhost",
    "description": "Hostname used for local identification"
  },
  "port": {
    "type": "number",
    "default": 1812,
    "description": "Default RADIUS authentication port"
  },
  "acct_port": {
    "type": "number",
    "default": 1813,
    "description": "Default RADIUS accounting port"
  }
}
