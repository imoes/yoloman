{
  "config_path": "/usr/local/bin/yara-scan-wrapper.sh",
  "rules_file": "/etc/yara/rules/malware.yar",
  "target": "/tmp/incoming",
  "target_type": "directory",
  "compiled_rules": false,
  "fast_scan": true,
  "recursive": true,
  "no_warnings": true,
  "strict_escape": false,
  "max_rules": 0,
  "threads": 8,
  "timeout": 3600,
  "skip_larger": 104857600,
  "external_variables": [
    {
      "identifier": "is_packer",
      "value": "true"
    },
    {
      "identifier": "max_entropy",
      "value": "7.5"
    }
  ],
  "tags": [
    "malware",
    "ransomware"
  ],
  "identifiers": [],
  "module_data_list": [
    {
      "module": "cuckoo",
      "file": "/var/lib/cuckoo/reports/12345.json"
    }
  ],
  "print_meta": true,
  "print_strings": false,
  "print_string_length": false,
  "print_xor_key": false,
  "print_tags": true,
  "count_only": false,
  "negate": false,
  "print_module_data": false,
  "print_stats": false,
  "scan_list": false
}
