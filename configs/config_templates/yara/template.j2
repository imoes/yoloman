#!/bin/sh
# =============================================================================
# Yara CLI Scanner Wrapper Script
# =============================================================================
# Generated by Ansible Jinja2 template.
# This script encapsulates the yara(1) command line with configurable options
# derived from the 'yara' package schema.
#
# Usage: source this script or execute it directly. The final command is
#        assigned to the variable $CMD and executed at the end.
# =============================================================================

# --- Configuration Variables ---

# The path to the Yara rules file (.yar or compiled .yarx).
# Schema: rules_file
# Default: /opt/yara/rules/default.yar
RULES_FILE="{{ rules_file | default('/opt/yara/rules/default.yar') }}"

# The file, directory, or PID to scan.
# If scan_list is true, this is the path to a file containing a list of targets.
# Schema: target
# Default: /var/incoming
TARGET="{{ target | default('/var/incoming') }}"

# The path where the generated wrapper script will be saved (metadata only).
# Schema: config_path
# Default: /usr/local/bin/yara-scan-wrapper.sh
CONFIG_PATH="{{ config_path | default('/usr/local/bin/yara-scan-wrapper.sh') }}"

# =============================================================================
# Command Construction
# =============================================================================
# We build the command in $CMD to allow easy inspection or modification before
# execution. This avoids shell expansion issues with complex flag lists.

CMD="yara"

# -----------------------------------------------------------------------------
# Flag: -C (compiled-rules)
# -----------------------------------------------------------------------------
# Schema: compiled_rules
# Description: Set to true if RULES_FILE contains rules already compiled with yarac (-C).
# Default: False
{% if compiled_rules | default(False) | bool %}
CMD="${CMD} -C"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -f (fast-scan)
# -----------------------------------------------------------------------------
# Schema: fast_scan
# Description: Speeds up scanning by searching only for the first occurrence of each pattern.
# Default: False
{% if fast_scan | default(False) | bool %}
CMD="${CMD} -f"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -r (recursive)
# -----------------------------------------------------------------------------
# Schema: recursive
# Description: Scan files in directories recursively and follow symlinks.
# Default: True
{% if recursive | default(True) | bool %}
CMD="${CMD} -r"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -w (no-warnings)
# -----------------------------------------------------------------------------
# Schema: no_warnings
# Description: Disable warnings.
# Default: False
{% if no_warnings | default(False) | bool %}
CMD="${CMD} -w"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: --strict-escape
# -----------------------------------------------------------------------------
# Schema: strict_escape
# Description: Print warnings if rules contain ambiguous escape statements.
# Default: True
{% if strict_escape | default(True) | bool %}
CMD="${CMD} --strict-escape"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -l (max-rules)
# -----------------------------------------------------------------------------
# Schema: max_rules
# Description: Abort scanning after this number of rules matched (-l). 0 means no limit.
# Default: 0
{% if max_rules | default(0) != 0 %}
CMD="${CMD} -l {{ max_rules | default(0) }}"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -p (threads)
# -----------------------------------------------------------------------------
# Schema: threads
# Description: Use this number of threads to scan a directory (-p).
# Default: 4
{% if threads | default(4) > 0 %}
CMD="${CMD} -p {{ threads | default(4) }}"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -a (timeout)
# -----------------------------------------------------------------------------
# Schema: timeout
# Description: Abort scanning after this many seconds (-a). 0 means no timeout.
# Default: 0
{% if timeout | default(0) != 0 %}
CMD="${CMD} -a {{ timeout | default(0) }}"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -z (skip-larger)
# -----------------------------------------------------------------------------
# Schema: skip_larger
# Description: Skip files larger than this size in bytes when scanning a directory (-z). 0 means no limit.
# Default: 0
{% if skip_larger | default(0) != 0 %}
CMD="${CMD} -z {{ skip_larger | default(0) }}"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -d (external-variables)
# -----------------------------------------------------------------------------
# Schema: external_variables
# Description: List of external variables to define with -d. Each item is a flat map with 'identifier' and 'value'.
# Default: []
{% for ext_var in (external_variables | default([])) %}
CMD="${CMD} -d {{ ext_var.identifier | string }}={{ ext_var.value | string }}"
{% endfor %}

# -----------------------------------------------------------------------------
# Flag: -t (tags)
# -----------------------------------------------------------------------------
# Schema: tags
# Description: List of tags to filter rules. Only rules with these tags are printed (-t).
# Default: []
{% for tag in (tags | default([])) %}
CMD="${CMD} -t {{ tag | string }}"
{% endfor %}

# -----------------------------------------------------------------------------
# Flag: -i (identifiers)
# -----------------------------------------------------------------------------
# Schema: identifiers
# Description: List of rule identifiers to filter rules. Only rules with these names are printed (-i).
# Default: []
{% for identifier in (identifiers | default([])) %}
CMD="${CMD} -i {{ identifier | string }}"
{% endfor %}

# -----------------------------------------------------------------------------
# Flag: -x (module-data)
# -----------------------------------------------------------------------------
# Schema: module_data_list
# Description: List of module data mappings to pass to modules with -x. Each item is a flat map with 'module' and 'file'.
# Default: []
{% for module_data in (module_data_list | default([])) %}
CMD="${CMD} -x {{ module_data.module | string }}={{ module_data.file | string }}"
{% endfor %}

# -----------------------------------------------------------------------------
# Flag: -m (print-meta)
# -----------------------------------------------------------------------------
# Schema: print_meta
# Description: Print metadata associated to the rule (-m).
# Default: False
{% if print_meta | default(False) | bool %}
CMD="${CMD} -m"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -s (print-strings)
# -----------------------------------------------------------------------------
# Schema: print_strings
# Description: Print strings found in the file (-s).
# Default: False
{% if print_strings | default(False) | bool %}
CMD="${CMD} -s"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -L (print-string-length)
# -----------------------------------------------------------------------------
# Schema: print_string_length
# Description: Print length of strings found in the file (-L).
# Default: False
{% if print_string_length | default(False) | bool %}
CMD="${CMD} -L"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -X (print-xor-key)
# -----------------------------------------------------------------------------
# Schema: print_xor_key
# Description: Print xor key of matched strings (-X).
# Default: False
{% if print_xor_key | default(False) | bool %}
CMD="${CMD} -X"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -g (print-tags)
# -----------------------------------------------------------------------------
# Schema: print_tags
# Description: Print the tags associated to the rule (-g).
# Default: False
{% if print_tags | default(False) | bool %}
CMD="${CMD} -g"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -c (count-only)
# -----------------------------------------------------------------------------
# Schema: count_only
# Description: Print number of matches only (-c).
# Default: False
{% if count_only | default(False) | bool %}
CMD="${CMD} -c"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -n (negate)
# -----------------------------------------------------------------------------
# Schema: negate
# Description: Print rules that don't apply (negate) (-n).
# Default: False
{% if negate | default(False) | bool %}
CMD="${CMD} -n"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -D (print-module-data)
# -----------------------------------------------------------------------------
# Schema: print_module_data
# Description: Print module data (-D).
# Default: False
{% if print_module_data | default(False) | bool %}
CMD="${CMD} -D"
{% endif %}

# -----------------------------------------------------------------------------
# Flag: -S (print-stats)
# -----------------------------------------------------------------------------
# Schema: print_stats
# Description: Print rules' statistics (-S).
# Default: False
{% if print_stats | default(False) | bool %}
CMD="${CMD} -S"
{% endif %}

# -----------------------------------------------------------------------------
# Target and Rules File Placement
# -----------------------------------------------------------------------------
# Yara syntax: yara [OPTIONS] RULES_FILE [TARGET] [--scan-list]
# If scan_list is enabled, the TARGET argument points to a file containing
# a list of files/dirs/PIDs to scan.

# The type of target being scanned. Used to clarify intent, though Yara accepts files, dirs, and PIDs.
# Schema: target_type
# Default: directory
TARGET_TYPE="{{ target_type | default('directory') }}"

{% if scan_list | default(False) | bool %}
# When --scan-list is used, the target is the file containing the list of targets.
CMD="${CMD} {{ rules_file | default('/opt/yara/rules/default.yar') }} {{ target | default('/var/incoming') }} --scan-list"
{% else %}
# Standard mode: Rules file followed by the target (file, dir, or pid).
CMD="${CMD} {{ rules_file | default('/opt/yara/rules/default.yar') }} {{ target | default('/var/incoming') }}"
{% endif %}

# =============================================================================
# Execution
# =============================================================================
# Execute the constructed command.
${CMD}