{
  "workers": {
    "type": "number",
    "default": 10,
    "description": "Number of concurrent HTTP workers."
  },
  "sockets": {
    "type": "number",
    "default": 500,
    "description": "Number of concurrent sockets per worker."
  },
  "method": {
    "type": "string",
    "default": "get",
    "description": "HTTP method to use: 'get', 'post', or 'random'.",
    "enum": [
      "get",
      "post",
      "random"
    ]
  },
  "useragents_file": {
    "type": "string",
    "default": "/usr/share/goldeneye/useragents/useragents.txt",
    "description": "Path to a file containing one user-agent string per line."
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose/debug mode."
  }
}
