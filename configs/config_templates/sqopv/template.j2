# sqopv verification service configuration
# See sqopv(1) man page for details.

# Enable verbose output for debugging. Corresponds to the --debug flag in sqopv(1).
debug: {{ debug | default(false) }}

# Path to the public keyring file used for verifying OpenPGP signatures.
keyring: {{ keyring | default('/etc/sqopv/keys.gpg') }}

# Path to a file listing the files or signatures to be verified.
manifest: {{ manifest | default('/etc/sqopv/manifest.txt') }}

# Directory where verification logs or results are stored.
output_dir: {{ output_dir | default('/var/log/sqopv') }}