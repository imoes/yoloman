{
  "solver": "/usr/bin/clasp",
  "grounder": "/usr/bin/gringo",
  "preprocessor": "/usr/bin/cudf2lp",
  "criterion": "min-inconsistent",
  "verbosity": 3,
  "debug": true,
  "solver_opts": [
    "--heuristic=VBID",
    "--restarts=100"
  ],
  "grounder_opts": [
    "--const=threads=1"
  ],
  "preprocessor_opts": [
    "--no-simplify"
  ],
  "encodings": [
    "/usr/share/aspcud/encodings/custom.lp"
  ],
  "input_files": [
    "/etc/cudf/problem.cudf"
  ],
  "output_file": "/var/log/aspcud/solution.cudf"
}
