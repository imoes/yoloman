{
  "skkdic_dir": {
    "type": "string",
    "default": "/var/lib/skk/dic",
    "description": "Directory containing SKK dictionary CDB files."
  },
  "skkdic_main": {
    "type": "string",
    "default": "JISYO.cdb",
    "description": "Main SKK dictionary file (basename, must exist in SKKDIC_DIR)."
  },
  "skkdic_extra": {
    "type": "list",
    "default": [],
    "description": "Extra SKK dictionary files (basename list)."
  },
  "skkdic_lang": {
    "type": "string",
    "default": "ja_JP.UTF-8",
    "description": "Language code for the dictionaries."
  },
  "skkdic_timeout": {
    "type": "number",
    "default": 300,
    "description": "Idle timeout (seconds) before closing client connection."
  },
  "skkdic_maxconn": {
    "type": "number",
    "default": 0,
    "description": "Maximum simultaneous connections (0 = no limit)."
  },
  "skkdic_bindaddr": {
    "type": "string",
    "default": "",
    "description": "IP address to bind to (empty = bind to all interfaces)."
  },
  "skkdic_port": {
    "type": "number",
    "default": 1178,
    "description": "TCP port to listen on."
  },
  "skkdic_log_level": {
    "type": "number",
    "default": 1,
    "description": "Logging verbosity (0=quiet,1=normal,2=debug)."
  },
  "skkdic_chroot": {
    "type": "string",
    "default": "",
    "description": "Chroot directory (empty = do not chroot)."
  },
  "skkdic_user": {
    "type": "string",
    "default": "nobody",
    "description": "User to drop privileges to after binding port."
  },
  "skkdic_group": {
    "type": "string",
    "default": "nogroup",
    "description": "Group to drop privileges to after binding port."
  },
  "skkdic_tcpwrapper": {
    "type": "bool",
    "default": false,
    "description": "Enable tcp_wrappers access control."
  }
}
