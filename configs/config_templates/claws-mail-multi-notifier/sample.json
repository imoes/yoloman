{
  "modules": [
    {
      "name": "Banner",
      "text": "You have new mail!",
      "font": "Sans Bold 14",
      "color": "#00008B",
      "bgcolor": "#FFFFE0",
      "duration": 5000,
      "position_x": 100,
      "position_y": 100
    },
    {
      "name": "Command",
      "command": "notify-send -i mail-unread 'Claws Mail' 'New message arrived'",
      "on_arrival": true,
      "on_unread": false,
      "on_imap": true
    },
    {
      "name": "SysTrayicon",
      "toaster": true,
      "toaster_command": "",
      "toaster_timeout": 8,
      "toaster_text": "New mail arrived!",
      "toaster_title": "Claws Mail",
      "toaster_icon": "/usr/share/icons/hicolor/48x48/apps/claws-mail.png",
      "tooltip": "Claws Mail: 1 unread message"
    }
  ]
}
