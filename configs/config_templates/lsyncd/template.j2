#! /bin/sh
### BEGIN INIT INFO
# Provides:          lsyncd
# Required-Start:    $remote_fs
# Required-Stop:    $remote_fs
# Default-Start:    2 3 4 5
# Default-Stop:     0 1 6
# Short-Description: lsyncd daemon init script
# Description:       This script launches the lsyncd daemon, which synchronizes local directories
#                    to remote locations (or other local directories) using rsync via inotify events.
### END INIT INFO

# Author: Ignace Mouzannar <ignace@enovance.com>

# --- Configuration Variables ---
# These variables can be overridden via /etc/default/lsyncd or environment variables.

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DESC="synchronization daemon"
NAME=lsyncd

# Path to the lsyncd binary executable
DAEMON=/usr/bin/$NAME

# Path to the main Lua configuration file.
# This file is generated by the Ansible role from a Jinja2 template.
CONFIG=/etc/lsyncd/lsyncd.conf.lua

# Path to the PID file created by the daemon
PIDFILE=/var/run/$NAME.pid

# Arguments passed to the daemon.
# Includes the PID file path and the configuration file path.
DAEMON_ARGS="-pidfile ${PIDFILE} ${CONFIG}"

# Path to this init script itself
SCRIPTNAME=/etc/init.d/$NAME

# Nice level for the daemon process (-20 to 19). Higher number = lower priority.
# 10 is a standard low-priority setting for background sync tasks.
NICELEVEL=10

# --- Pre-flight Checks ---

# Exit gracefully if the package is not installed or the binary is missing
[ -x "$DAEMON" ] || exit 0

# Exit gracefully if the configuration file does not exist or is not readable
# This ensures we don't start without a valid config
[ -r "$CONFIG" ] || exit 0

# Read configuration variable file if it is present
# This allows administrators to set environment variables that override defaults
[ -r /etc/default/$NAME ] && . /etc/default/$NAME

# Define LSB log_* functions.
# Depend on lsb-base (>= 3.0-6) to ensure that this file is present.
. /lib/lsb/init-functions

#
# Function that starts the daemon/service
#
do_start()
{
	# Test if the daemon can start (dry run)
	start-stop-daemon --start --quiet --pidfile $PIDFILE --exec $DAEMON \
        --test > /dev/null \
		|| return 1

	# Actually start the daemon with specified nice level and arguments
	start-stop-daemon --start --quiet --pidfile $PIDFILE \
        --nicelevel $NICELEVEL --exec $DAEMON -- \
		$DAEMON_ARGS \
		|| return 2
}

#
# Function that stops the daemon/service
#
do_stop()
{
	# Send SIGTERM to stop the daemon
	start-stop-daemon --stop --quiet --pidfile $PIDFILE --name $NAME
	RETVAL="$?"
	
	# Handle specific return codes
	[ "$RETVAL" = 2 ] && return 2

	# Force stop the executable if the named process didn't stop
	start-stop-daemon --stop --quiet --oknodo --exec $DAEMON
	[ "$?" = 2 ] && return 2
	
	# Many daemons don't delete their pidfiles when they exit.
	# Clean up the PID file to ensure a fresh start next time.
	rm -f $PIDFILE
	return "$RETVAL"
}

#
# Function that sends a SIGHUP to the daemon/service
# SIGHUP typically triggers a configuration reload in lsyncd
#
do_reload() {
	start-stop-daemon --stop --signal 1 --quiet --pidfile $PIDFILE --name $NAME
	return 0
}

#
# Main Control Case Statement
#
case "$1" in
  start)
	log_daemon_msg "Starting $DESC" "$NAME"
	do_start
	case "$?" in
		0|1) log_end_msg 0 ;;
		2) log_end_msg 1 ;;
	esac
	;;
  stop)
	log_daemon_msg "Stopping $DESC" "$NAME"
	do_stop
	case "$?" in
		0|1) log_end_msg 0 ;;
		2) log_end_msg 1 ;;
	esac
	;;
  status)
        status_of_proc $DAEMON $NAME && exit 0 || exit $?
        ;;
  restart|force-reload)
	log_daemon_msg "Restarting $DESC" "$NAME"
	do_stop
	case "$?" in
	  0|1)
		do_start
		case "$?" in
			0) log_end_msg 0 ;;
			1) log_end_msg 1 ;; # Old process is still running
			*) log_end_msg 1 ;; # Failed to start
		esac
		;;
	  *)
	  	# Failed to stop
		log_end_msg 1
		;;
	esac
	;;
  *)
	echo "Usage: $SCRIPTNAME {start|stop|restart|force-reload}" >&2
	exit 3
	;;
esac

: