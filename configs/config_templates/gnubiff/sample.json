{
  "mailboxes": [
    {
      "type": "imap4",
      "server": "imap.example.com",
      "user": "user@example.com",
      "pass": "secret123",
      "port": 993,
      "use_ssl": true
    },
    {
      "type": "mbox",
      "user": "user",
      "path": "/var/spool/mail/user"
    }
  ],
  "check_newmail": true,
  "check_every": 120,
  "show_newmail": true,
  "sort_by_date": false,
  "play_sound": true,
  "sound_file": "/usr/share/sounds/gnubiff/newmail.wav",
  "mail_reader": "xdg-open",
  "spam_filter": true,
  "spam_header": "X-Spam-Flag",
  "spam_value": "YES",
  "system_tray": true
}
