# =============================================================================
# Pilot Configuration Template
# =============================================================================
# This file configures the "pilot" file manager.
# See pilot(1) for full documentation.
# =============================================================================

# -----------------------------------------------------------------------------
# show_all_files
# Description: Display all files including those beginning with a period (.).
#              Corresponds to -a.
# Default: False
# -----------------------------------------------------------------------------
show_all_files: {{ show_all_files | default(false) | lower }}

# -----------------------------------------------------------------------------
# enable_function_keys
# Description: Use function keys for commands. Corresponds to -f.
# Default: False
# -----------------------------------------------------------------------------
enable_function_keys: {{ enable_function_keys | default(false) | lower }}

# -----------------------------------------------------------------------------
# show_cursor
# Description: Enable "Show Cursor" mode. Corresponds to -g.
# Default: False
# -----------------------------------------------------------------------------
show_cursor: {{ show_cursor | default(false) | lower }}

# -----------------------------------------------------------------------------
# enable_goto
# Description: Enable "Goto" command. Corresponds to -j.
# Default: False
# -----------------------------------------------------------------------------
enable_goto: {{ enable_goto | default(false) | lower }}

# -----------------------------------------------------------------------------
# enable_mouse
# Description: Enable mouse functionality. Corresponds to -m.
# Default: False
# -----------------------------------------------------------------------------
enable_mouse: {{ enable_mouse | default(false) | lower }}

# -----------------------------------------------------------------------------
# operating_directory
# Description: Sets operating directory. Only files within this directory are
#              accessible. Corresponds to -o <dir>.
# Default: '' (empty string, uses current working directory)
# -----------------------------------------------------------------------------
operating_directory: {{ operating_directory | default('') | string }}

# -----------------------------------------------------------------------------
# single_column_display
# Description: Enable single vertical column display. Corresponds to -v.
# Default: False
# -----------------------------------------------------------------------------
single_column_display: {{ single_column_display | default(false) | lower }}

# -----------------------------------------------------------------------------
# hide_keymenu
# Description: Disable keymenu at the bottom of the screen. Corresponds to -x.
# Default: False
# -----------------------------------------------------------------------------
hide_keymenu: {{ hide_keymenu | default(false) | lower }}

# -----------------------------------------------------------------------------
# enable_suspend
# Description: Enable ^Z suspension of pilot. Corresponds to -z.
# Default: False
# -----------------------------------------------------------------------------
enable_suspend: {{ enable_suspend | default(false) | lower }}

# -----------------------------------------------------------------------------
# mail_check_interval
# Description: Interval in seconds to check for new mail. Corresponds to
#              -n<seconds>. Min 30, default 180.
# Default: 180
# -----------------------------------------------------------------------------
mail_check_interval: {{ mail_check_interval | default(180) }}

# -----------------------------------------------------------------------------
# use_termcap_sequences
# Description: Use termcap/terminfo for input escape sequences. Corresponds to -q.
# Default: False
# -----------------------------------------------------------------------------
use_termcap_sequences: {{ use_termcap_sequences | default(false) | lower }}

# -----------------------------------------------------------------------------
# do_setlocale_ctype
# Description: Perform setlocale(LC_CTYPE). Corresponds to -setlocale_ctype.
# Default: False
# -----------------------------------------------------------------------------
do_setlocale_ctype: {{ do_setlocale_ctype | default(false) | lower }}

# -----------------------------------------------------------------------------
# no_setlocale_collate
# Description: Do not perform setlocale(LC_COLLATE). Corresponds to -no_setlocale_collate.
# Default: False
# -----------------------------------------------------------------------------
no_setlocale_collate: {{ no_setlocale_collate | default(false) | lower }}