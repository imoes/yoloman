#!/bin/bash
# wait-for-it.sh: Wait for a TCP host:port and optionally execute a command.
#
# This script is generated by Ansible. It uses the `wait-for-it` tool
# to block execution until a network service is available, or until a timeout expires.
#
# Schema Variables Used:
#   host: Host or IP under test (default: localhost)
#   port: TCP port under test (default: 8080)
#   timeout: Timeout in seconds, zero for no timeout (default: 0)
#   strict: Only execute subcommand if the test succeeds (default: false)
#   quiet: Don't output any status messages (default: false)
#   command: Command and args to execute after the test finishes. Items should be strings. Empty list means just wait/check (default: [])

# --- Configuration ---

# Host or IP under test
HOST="{{ host | default('localhost') }}"

# TCP port under test
PORT="{{ port | default(8080) }}"

# Timeout in seconds, zero for no timeout
TIMEOUT="{{ timeout | default(0) }}"

# Strict mode: only execute subcommand if the test succeeds
# Maps to the -s flag for wait-for-it
{% if strict | default(false) %}
STRICT_FLAG="-s"
{% else %}
STRICT_FLAG=""
{% endif %}

# Quiet mode: don't output any status messages
# Maps to the -q flag for wait-for-it
{% if quiet | default(false) %}
QUIET_FLAG="-q"
{% else %}
QUIET_FLAG=""
{% endif %}

# Construct the command to run after connection is established.
# If no command is provided in the schema, we default to a simple echo.
# Items are joined by spaces to form a valid shell argument list.
{% set cmd_args = command | default([]) | join(' ') %}

# --- Execution ---

echo "Waiting for ${HOST}:${PORT}..."

# Execute wait-for-it with the provided arguments.
# Note: This assumes `wait-for-it` is in the PATH or provided by the entrypoint.
wait-for-it ${HOST}:${PORT} \
    -p {{ port | default(8080) }} \
    -t {{ timeout | default(0) }} \
    ${STRICT_FLAG} \
    ${QUIET_FLAG} \
{% if command | default([]) | length > 0 %}
    -- {{ cmd_args }}
{% else %}
    -- echo "Port {{ port | default(8080) }} on {{ host | default('localhost') }} is available."
{% endif %}