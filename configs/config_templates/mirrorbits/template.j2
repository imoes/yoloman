# Log rotation configuration for Mirrorbits log files.
# This template generates a logrotate configuration file.
# The log directory and rotation count are derived from the provided schema.

# Rotate the main Mirrorbits log files.
/var/log/{{ log_dir | default('mirrorbits') }}/*.log {
    # Rotate logs daily.
    daily
    # Keep the specified number of rotated log files before discarding the oldest.
    rotate {{ rotate_count | default('14') }}
    # Do not produce an error if the log file is missing.
    missingok
    # Do not rotate the log if it is empty.
    notifempty
    # Compress rotated log files using gzip.
    compress
    # Delay compression of the most recently rotated log file until the next rotation cycle.
    delaycompress
    # Commands to execute after rotation is complete.
    postrotate
        # Check if systemd is running; if so, use systemctl to send the USR1 signal to mirrorbits.
        if [ -e /run/systemd/system ]; then
            if systemctl -q is-active mirrorbits; then
                systemctl kill -s USR1 mirrorbits
            fi
        # Fallback for non-systemd environments: read PID from file and send signal.
        elif [ -s /run/mirrorbits/pid ]; then
            pid=$(cat /run/mirrorbits/pid)
            kill -s USR1 "$pid" 2>/dev/null || true
        fi
    endscript
}

# Rotate subdirectory-based Mirrorbits log files (e.g., for multiple sites or instances).
/var/log/{{ log_dir | default('mirrorbits') }}/*/*.log {
    # Rotate logs daily.
    daily
    # Keep the specified number of rotated log files before discarding the oldest.
    rotate {{ rotate_count | default('14') }}
    # Do not produce an error if the log file is missing.
    missingok
    # Do not rotate the log if it is empty.
    notifempty
    # Compress rotated log files using gzip.
    compress
    # Delay compression of the most recently rotated log file until the next rotation cycle.
    delaycompress
    # Commands to execute after rotation is complete.
    postrotate
        # Determine the directory name (instance/site name) from the log path.
        dir=$(dirname "$1")
        i=$(basename "$dir")
        # Check if systemd is running; if so, use systemctl to send the USR1 signal to the specific instance.
        if [ -e /run/systemd/system ]; then
            if systemctl -q is-active mirrorbits@"$i"; then
                systemctl kill -s USR1 mirrorbits@"$i"
            fi
        # Fallback for non-systemd environments: read PID from file and send signal.
        elif [ -s /run/mirrorbits/"$i"/pid ]; then
            pid=$(cat /run/mirrorbits/"$i"/pid)
            kill -s USR1 "$pid" 2>/dev/null || true
        fi
    endscript
}
