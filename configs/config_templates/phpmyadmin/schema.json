{
  "phpmyadmin_alias_path": {
    "type": "string",
    "default": "/phpmyadmin",
    "description": "URL alias path for phpMyAdmin (e.g., '/phpmyadmin')"
  },
  "phpmyadmin_docroot": {
    "type": "string",
    "default": "/usr/share/phpmyadmin",
    "description": "Filesystem path to phpMyAdmin installation"
  },
  "phpmyadmin_tmp_dir": {
    "type": "string",
    "default": "/var/lib/phpmyadmin/tmp",
    "description": "PHP temporary upload directory for phpMyAdmin (must be writable by web server)"
  }
}
