# Batmand (BATMAN II) daemon configuration template
# Manages command-line options passed to the batmand binary.

# First network interface for batmand to bind to.
# Default: eth1
DAEMON_OPTS="-d 0 {{ interface1 | default('eth1') }} {{ interface2 | default('eth2') }}"

# Second network interface for batmand to bind to.
# Default: eth2
# Note: The above line includes both interfaces in a single DAEMON_OPTS line
# as per the original template structure.