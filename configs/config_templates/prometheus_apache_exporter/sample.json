{
  "urls": [
    "http://localhost/server-status?auto",
    "http://backend1.internal:80/server-status?auto"
  ],
  "listen_address": "127.0.0.1",
  "port": 9117,
  "status_path": "/server-status",
  "tls_enabled": false,
  "auth_username": "",
  "auth_password": "",
  "request_timeout": 3,
  "collect_ssl": true,
  "extra_args": [
    "no-collect-vhost"
  ],
  "headers": [
    {
      "name": "X-Apache-Cluster",
      "value": "main"
    }
  ]
}
