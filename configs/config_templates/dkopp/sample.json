{
  "job_name": "MyDVDBackup",
  "media_type": "BD-R",
  "backup_mode": "incremental",
  "verify_mode": "thorough",
  "sources": [
    "/home/user/Documents",
    "/home/user/Pictures"
  ],
  "destination": "/mnt/backup/archive",
  "exclude_patterns": [
    "*.tmp",
    "*~",
    "*.cache"
  ],
  "preserve_perms": true,
  "force_full": false,
  "log_file": "/var/log/dkopp_MyDVDBackup.log"
}
