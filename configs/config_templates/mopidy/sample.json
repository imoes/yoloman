{
  "library_backend": "m3u",
  "core_max_history_size": 100,
  "local_enabled": true,
  "local_media_dir": "/var/lib/mopidy/media/music",
  "local_scan_timeout": 30,
  "local_scan_flush_threshold": 1000,
  "local_scan_ignore_patterns": [
    ".*",
    "*~",
    "*.pyc",
    "*.pyo",
    "*.cache"
  ],
  "local_images_enabled": true,
  "local_images_search_dirs": [],
  "file_enabled": true,
  "file_media_dir": "/var/lib/mopidy/media",
  "file_allowed_extensions": [
    "mp3",
    "flac",
    "wav",
    "ogg",
    "m4a",
    "opus"
  ],
  "http_enabled": true,
  "http_hostname": "0.0.0.0",
  "http_port": 6680,
  "http_allowed_origins": [],
  "http_cors_headers": [],
  "mpd_enabled": true,
  "mpd_hostname": "0.0.0.0",
  "mpd_port": 6600,
  "mpd_password": "",
  "webstats_enabled": false,
  "spotify_enabled": true,
  "spotify_username": "my_spotify_user",
  "spotify_client_id": "abc123xyz",
  "spotify_client_secret": "secret789",
  "spotify_cache_path": "/var/lib/mopidy/spotify/credentials.cache",
  "spotify_enabled_oauth": true,
  "spotify_bitrate": 160,
  "extensions": [
    {
      "name": "musicbox_webclient",
      "description": "Lightweight web UI for Mopidy (by MusicBox)",
      "enabled": true,
      "config": {
        "enabled": "true",
        "musicbox": "true",
        "websocket_host": "",
        "websocket_port": "",
        "on_track_click": "PLAY_ALL"
      }
    },
    {
      "name": "subsonic",
      "description": "Subsonic-compatible REST API",
      "enabled": false,
      "config": {
        "hostname": "127.0.0.1",
        "port": "8080",
        "https": "false",
        "username": "",
        "password": ""
      }
    }
  ]
}
