{
  "core_max_tracklist_length": 5000,
  "core_cache_dir": "/var/cache/mopidy",
  "core_data_dir": "/var/lib/mopidy",
  "logging_verbosity": 1,
  "audio_output": "autoaudiosink",
  "audio_mixer_volume": 50,
  "file_media_dirs": [
    "/var/lib/mopidy/media|Music"
  ],
  "file_excluded_file_extensions": [
    ".txt",
    ".jpg"
  ],
  "file_show_dotfiles": false,
  "file_follow_symlinks": false,
  "http_hostname": "127.0.0.1",
  "http_port": 6680,
  "http_allowed_origins": [
    "example.org"
  ],
  "http_csrf_protection": true,
  "m3u_playlists_dir": "/var/lib/mopidy/playlists"
}
