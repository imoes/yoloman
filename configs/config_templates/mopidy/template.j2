# For information about configuration values that can be set in this file see:
#
#   https://docs.mopidy.com/en/latest/config/
#
# Run `sudo mopidyctl config` to see the current effective config, based on
# both defaults and this configuration file.


[core]
core_max_history_size = {{ core_max_history_size }}

[logging]
config_file = /etc/mopidy/logging.conf
verbosity = 0
format = %(levelname)-8s [%(threadName)s] %(name)s[%(process)d] %(message)s
color = true

[file]
enabled = {{ file_enabled }}
media_dir = {{ file_media_dir }}
allowed_extensions = {{ file_allowed_extensions | join(',') }}
metadata_timeout = 3

[http]
enabled = {{ http_enabled }}
hostname = {{ http_hostname }}
port = {{ http_port }}
cors_allowed_origins = {{ http_allowed_origins | join(',') }}
auth =
static_dir =
zeroconf = Mopidy HTTP server on $HOSTNAME
allowed_media_types =

[mpd]
enabled = {{ mpd_enabled }}
hostname = {{ mpd_hostname }}
port = {{ mpd_port }}
password = {{ mpd_password }}
max_connections = 20
connection_timeout = 60
ipv6 = true

[m3u]
enabled = {{ library_backend == 'm3u' }}
dir = {{ local_media_dir }}

[local]
enabled = {{ local_enabled }}
media_dir = {{ local_media_dir }}
speculative_cache_size = 32
scan_timeout = {{ local_scan_timeout }}
scan_flush_threshold = {{ local_scan_flush_threshold }}
scan_ignore_patterns = {{ local_scan_ignore_patterns | join(',') }}

[local-images]
enabled = {{ local_images_enabled }}
search_dirs = {{ local_images_search_dirs | join(',') }}

[webstats]
enabled = {{ webstats_enabled }}

[spotify]
enabled = {{ spotify_enabled }}
username = {{ spotify_username }}
password = {{ spotify_password }}
client_id = {{ spotify_client_id }}
client_secret = {{ spotify_client_secret }}
bitrate = 160
volume_normalization = true
cache_dir = /var/cache/mopidy/spotify
backend_timeout = 5
