# SYSLINUX configuration file
# Timeout in tenths of a second before auto-booting the default entry
# A value of 0 disables the timeout
TIMEOUT {{ timeout | default(50) }}

# If 1, always display the 'boot:' prompt
# If 0, prompt only if Shift/Alt is pressed or Caps/Scroll lock is set
PROMPT {{ prompt | default(0) | lower }}

# Global options appended to the kernel command line for all boots
# Usually used for root device or console settings
APPEND {{ global_append | default('') }}

{% for label in labels %}
# Boot label entry
LABEL {{ label.label }}
    # Kernel image to load
    KERNEL {{ label.kernel }}
    # Options for this specific entry
    APPEND {{ label.append | default(global_append | default('')) }}
{% endfor %}