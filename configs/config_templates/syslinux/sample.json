{
  "timeout": 300,
  "prompt": true,
  "global_append": "quiet splash",
  "labels": [
    {
      "label": "linux",
      "kernel": "/boot/vmlinuz-linux",
      "append": "root=UUID=1234-5678 ro"
    },
    {
      "label": "fallback",
      "kernel": "/boot/vmlinuz-linux-fallback",
      "append": "root=UUID=1234-5678 ro"
    }
  ]
}
