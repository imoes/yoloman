{
  "ca_dir": {
    "type": "string",
    "default": "./demoCA",
    "description": "Base directory where CA files are kept."
  },
  "ca_default_days": {
    "type": "number",
    "default": 365,
    "description": "How long to certify for (days)."
  },
  "ca_default_crl_days": {
    "type": "number",
    "default": 30,
    "description": "How long before next CRL (days)."
  },
  "ca_default_md": {
    "type": "string",
    "default": "sha1",
    "description": "Which message digest to use."
  },
  "ca_preserve": {
    "type": "bool",
    "default": false,
    "description": "Keep passed DN ordering."
  },
  "req_default_bits": {
    "type": "number",
    "default": 4096,
    "description": "Default number of bits for keys."
  },
  "req_default_keyfile": {
    "type": "string",
    "default": "privkey.pem",
    "description": "The default private key file name."
  },
  "req_countryName_default": {
    "type": "string",
    "default": "AU",
    "description": "Default country name."
  },
  "req_stateOrProvinceName_default": {
    "type": "string",
    "default": "Some-State",
    "description": "Default state or province name."
  },
  "req_0.organizationName_default": {
    "type": "string",
    "default": "Internet Widgits Pty Ltd",
    "description": "Default organization name."
  }
}
