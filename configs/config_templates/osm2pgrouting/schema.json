{
 "DB_PREFIX": {
  "source": "inferred-from-template",
  "type": "string"
 },
 "DB_SCHEMA": {
  "source": "inferred-from-template",
  "type": "string"
 },
 "DB_SUFFIX": {
  "source": "inferred-from-template",
  "type": "string"
 },
 "add_nodes": {
  "default": false,
  "description": "Import the osm_nodes table.",
  "type": "bool"
 },
 "clean": {
  "default": false,
  "description": "Drop previously created tables before import.",
  "type": "bool"
 },
 "conf_file": {
  "default": "/usr/share/osm2pgrouting/mapconfig.xml",
  "description": "Path to the configuration XML file.",
  "type": "string"
 },
 "db_host": {
  "default": "localhost",
  "description": "Host of the PostgreSQL database.",
  "type": "string"
 },
 "db_name": {
  "default": "routing_db",
  "description": "Name of the PostgreSQL database (required).",
  "type": "string"
 },
 "db_port": {
  "default": 5432,
  "description": "Port of the PostgreSQL database.",
  "type": "number"
 },
 "db_prefix": {
  "default": "",
  "description": "Prefix added to the beginning of table names.",
  "type": "string"
 },
 "db_schema": {
  "default": "",
  "description": "Database schema to put tables. Leave empty for default search_path.",
  "type": "string"
 },
 "db_suffix": {
  "default": "",
  "description": "Suffix added to the end of table names.",
  "type": "string"
 },
 "db_user": {
  "default": "postgres",
  "description": "Username with write access to the database.",
  "type": "string"
 },
 "osm_file": {
  "default": "/data/osm/bundle.osm.pbf",
  "description": "Path to the input OSM file (required).",
  "type": "string"
 }
}
