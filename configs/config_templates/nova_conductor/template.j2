[DEFAULT]
# Base directory for nova conductor logs
log_dir = {{ log_dir }}

# Log level
log_level = {{ log_level }}

# Hostname or IP address to bind to
host = {{ conductor_host }}

# Port to listen on for internal RPC and HTTP endpoints
port = {{ conductor_port }}

# Number of workers for the conductor service
workers = {{ conductor_workers }}

# Maximum number of database connections to pool
max_pool_size = {{ db_max_pool_size }}

# Database connection URI (optional: override individual sections below)
# If omitted, rely on [database]/connection
# database = {{ database_url }}

[api_database]
# Connection string for the API database
connection = {{ api_database_connection }}

[database]
# Connection string for the main (cell) database
connection = {{ database_connection }}

[keystone_authtoken]
# Authenticate using keystone (required for production)
auth_url = {{ keystone_auth_url }}
project_domain_name = {{ keystone_project_domain_name }}
user_domain_name = {{ keystone_user_domain_name }}
project_name = {{ keystone_project_name }}
username = {{ keystone_username }}
password = {{ keystone_password }}

[oslo_messaging_rabbit]
# RabbitMQ connection details
rabbit_host = {{ rabbitmq_host }}
rabbit_port = {{ rabbitmq_port }}
rabbit_userid = {{ rabbitmq_userid }}
rabbit_password = {{ rabbitmq_password }}

[ssl]
# TLS support (optional)
# Enable TLS for conductor API
enabled = {{ ssl_enabled }}
certfile = {{ ssl_certfile }}
keyfile = {{ ssl_keyfile }}
ca_file = {{ ssl_ca_file }}

[conductor]
# Enable local mode (for single-node dev/testing only)
local_mode = {{ conductor_local_mode }}
