{# cdrskin configuration file #}
# {{ description | default('cdrskin configuration') }}
# Generated by {{ generator | default('unknown') }}
# Date: {{ date | default('unknown') }}

# Drive device address
# dev: Specifies the drive device to use (e.g., /dev/sr0, 0, ATA:1,0,0). Must be a valid libburn address.
dev={{ dev | default('0') }}

# Burn speed setting
# speed: Set drive speed (e.g., 0=minimal, -1=maximal, specific number).
speed={{ speed | default(-1) }}

# FIFO buffer size
# fs: Set the FIFO buffer size (e.g., 4m). Suffixes: s (2048), k/K (1024), m/M (1024k), g/G (1024m).
fs={{ fs | default('4m') }}

# FIFO start threshold
# fifo_start_at: Start burning when FIFO contains this many bytes. Same suffixes as fs.
fifo_start_at={{ fifo_start_at | default('0') }}

# Padding size for data tracks
# padsize: Add trailing zeros to each data track (e.g., 300k). Same suffixes as fs.
padsize={{ padsize | default('300k') }}

# Blank type before burning (if needed)
# blank: Blank/format media before writing (e.g., as_needed, fast, all, format_overwrite, deformat_sequential).
# Empty string disables blanking.
{% if blank | default('') %}
blank={{ blank | default('') }}
{% endif %}

# Multi-session mode
# multi: If true, keep media appendable after current session.
{% if multi | default(False) %}
-multi
{% endif %}

# Session-at-once (SAO) or Track-at-once (TAO) mode
# sao: If true, use Session-at-Once (SAO) mode for CD or Disc-at-Once (DAO) for DVD.
# tao: If true, use Track-at-Once (TAO) mode for CD or Incremental Streaming for DVD.
# These options are mutually exclusive; SAO takes precedence if both are true.
{% if sao | default(False) %}
-sao
{% elif tao | default(False) %}
-tao
{% endif %}

# Eject disc after burning
# eject: If true, eject the disc after work is done.
{% if eject | default(False) %}
-eject
{% endif %}

# Dummy mode (dry-run)
# dummy: If true, perform drive operations without affecting media (dry-run).
{% if dummy | default(False) %}
-dummy
{% endif %}

# Write mode for overwriteable media with ISO-9660
# grow_overwriteable_iso: If true, enable emulated multi-session for ISO-9660 on overwriteable DVD/BD media.
{% if grow_overwriteable_iso | default(False) %}
--grow_overwriteable_iso
{% endif %}

# Input source track(s)
# tracks: List of track sources to burn. Each item must have 'source' (file path or '-' for stdin).
{% for track in tracks | default([]) %}
{% if track.source == '-' %}
-
{% else %}
{{ track.source }}
{% endif %}
{% endfor %}

# Additional options
# verbose: Verbosity level (0–3). Each increment adds -v to the command line.
{% if verbose | default(0) > 0 %}
{% for i in range(verbose | default(0)) %}
-v
{% endfor %}
{% endif %}

# Grace time before burning
# gracetime: Delay (in seconds) before burning starts. Default 0.
{% if gracetime | default(0) %}
gracetime={{ gracetime | default(0) }}
{% endif %}