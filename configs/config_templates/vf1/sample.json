{
  "color_menus": true,
  "debug": false,
  "encoding": "iso-8859-1",
  "ipv6": true,
  "timeout": 15,
  "handlers": [
    {
      "mime_type": "text/html",
      "command": "lynx -dump -force_html %s"
    },
    {
      "mime_type": "text/plain",
      "command": "cat %s"
    },
    {
      "mime_type": "image/*",
      "command": "feh %s"
    }
  ],
  "initial_url": "gopher://gopher.floodgap.com/"
}
