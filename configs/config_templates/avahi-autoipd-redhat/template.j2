#!/usr/bin/sh
#
# avahi-autoipd RedHat Hook Script (Enriched)
#
# This script is executed by avahi-autoipd when network events occur
# on an interface using the Avahi Link-Local Auto-IP (APIPA) mechanism.
# It configures IP addresses and default routes based on schema parameters.
#
# Generated from Ansible Jinja2 template. Do not edit manually.

# This file is part of avahi.
#
# avahi is free software; you can redistribute it and/or modify it
# under the terms of the GNU Lesser General Public License as
# published by the Free Software Foundation; either version 2 of the
# License, or (at your option) any later version.
#
# avahi is distributed in the hope that it will be useful, but WITHOUT
# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
# or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public
# License for more details.
#
# You should have received a copy of the Lesser General Public
# License along with avahi; if not, write to the Free Software
# Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA 02111-1307
# USA.

set -e

# Command line arguments passed by avahi-autoipd:
#   $1 event that happened:
#          BIND:     Successfully claimed address
#          CONFLICT: An IP address conflict happened
#          UNBIND:   The IP address is no longer needed
#          STOP:     The daemon is terminating
#   $2 interface name
#   $3 IP address assigned/claimed

PATH="$PATH:/usr/bin:/usr/sbin:/bin:/sbin"

# Use a different metric for each interface, so that we can set
# identical routes to multiple interfaces.
# metric_base: default='1000' desc='The base metric added to the interface index for route priority.'
METRIC=$(({{ metric_base | default('1000') }} + `cat "/sys/class/net/$2/ifindex" 2>/dev/null || echo 0`))

if [ -x /bin/ip -o -x /sbin/ip ] ; then

    # We have the Linux ip tool from the iproute package

    case "$1" in
        BIND)
            # Flush existing Avahi addresses on this interface
            ip addr flush dev "$2" label "$2:avahi"
            # Add the link-local address
            # subnet_bits: default='16' desc='The CIDR prefix length for the link-local address.'
            # broadcast_addr: default='169.254.255.255' desc='The broadcast address for the link-local subnet.'
            ip addr add "$3"/{{ subnet_bits | default('16') }} brd {{ broadcast_addr | default('169.254.255.255') }} label "$2:avahi" scope link dev "$2"
            # Add a default route for the link-local subnet
            # route metric is calculated above using metric_base
            ip route add default dev "$2" metric "$METRIC" scope link ||:
            ;;

        CONFLICT|UNBIND|STOP)
            # Remove the link-local default route
            ip route del default dev "$2" metric "$METRIC" scope link ||:
            # Remove the link-local address
            # subnet_bits: default='16' desc='The CIDR prefix length for the link-local address.'
            # broadcast_addr: default='169.254.255.255' desc='The broadcast address for the link-local subnet.'
            ip addr del "$3"/{{ subnet_bits | default('16') }} brd {{ broadcast_addr | default('169.254.255.255') }} label "$2:avahi" scope link dev "$2"
            ;;

        *)
            echo "Unknown event $1" >&2
            exit 1
            ;;
    esac

elif [ -x /bin/ifconfig -o -x /sbin/ifconfig ] ; then

    # We have the old ifconfig tool

    case "$1" in
        BIND)
            # Configure interface with ifconfig
            # netmask: default='255.255.0.0' desc='The netmask corresponding to the link-local subnet.'
            # broadcast_addr: default='169.254.255.255' desc='The broadcast address for the link-local subnet.'
            ifconfig "$2:avahi" inet "$3" netmask {{ netmask | default('255.255.0.0') }} broadcast {{ broadcast_addr | default('169.254.255.255') }} up
            # Add default route
            # metric is calculated above using metric_base
            route add default dev "$2:avahi" metric "$METRIC" ||:
            ;;

        CONFLICT|STOP|UNBIND)
            # Remove default route
            route del default dev "$2:avahi" metric "$METRIC" ||:
            ifconfig "$2:avahi" down
            ;;

        *)
            echo "Unknown event $1" >&2
            exit 1
            ;;
    esac

else

    echo "No network configuration tool found." >&2
    exit 1

fi

exit 0
