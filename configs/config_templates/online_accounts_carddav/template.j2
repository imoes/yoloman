# ============================================================================
# Lomiri Online Accounts CardDAV Plugin Configuration
# ============================================================================
# This file is sourced by the CardDAV plugin to configure a generic CardDAV server.
# It uses INI-style sections and key-value pairs.
#
# Self-Documenting Template:
# Every configuration directive below is annotated with its schema description
# and uses safe default values derived from the schema to prevent render failures
# when variables are undefined in Ansible.
# ============================================================================

[Service]

# --------------------------------------------------------------------------
# Protocol to use for connecting to the CardDAV server (http or https). Prefer https.
# --------------------------------------------------------------------------
Protocol={{ protocol | default('https') }}

# --------------------------------------------------------------------------
# Hostname (fully qualified domain name) of the CardDAV server (e.g., cards.example.com).
# --------------------------------------------------------------------------
Server={{ server_host | default('') }}

# --------------------------------------------------------------------------
# TCP port the CardDAV server listens on (typically 443 for HTTPS, 80 for HTTP).
# --------------------------------------------------------------------------
Port={{ port | default(443) }}

# --------------------------------------------------------------------------
# Base path on the server where CardDAV endpoints reside (e.g., /dav/, /carddav/).
# Set to '/' if root-based.
# --------------------------------------------------------------------------
Path={{ path | default('/') }}

# --------------------------------------------------------------------------
# Username or email used to authenticate with the CardDAV server.
# Not stored in config in secure deployments.
# --------------------------------------------------------------------------
Username={{ username | default('') }}

# --------------------------------------------------------------------------
# Password for authentication. For security, consider leaving blank and using
# secure storage (e.g., secret-service).
# --------------------------------------------------------------------------
Password={{ password | default('') }}

# --------------------------------------------------------------------------
# User-friendly name for this account (e.g., 'Work Contacts' or 'Personal CardDAV').
# --------------------------------------------------------------------------
DisplayName={{ display_name | default('') }}

# --------------------------------------------------------------------------
# Explicit WebDAV principal URL (e.g., /principals/user@example.com/).
# Leave blank for autodiscovery.
# --------------------------------------------------------------------------
PrincipalURL={{ principal_url | default('') }}

# --------------------------------------------------------------------------
# Enable background sync of contacts (if supported by the plugin and backend).
# --------------------------------------------------------------------------
EnableSync={{ enable_sync | default(false) }}

# --------------------------------------------------------------------------
# Verify the server’s SSL/TLS certificate. Disable only for testing with
# self-signed certs (not recommended).
# --------------------------------------------------------------------------
VerifySSL={{ verify_ssl | default(true) }}

# --------------------------------------------------------------------------
# Explicit path to the user’s address book collection (e.g., /user/me/cards/).
# Omit to rely on autodiscovery.
# --------------------------------------------------------------------------
AddressBookPath={{ address_book_path | default('') }}

# --------------------------------------------------------------------------
# List of custom HTTP headers to send with each request.
# Format per header: 'Header-Name: Value'
# --------------------------------------------------------------------------
{% for header in headers | default([]) %}
Headers={{ header }}
{% endfor %}

# --------------------------------------------------------------------------
# Force use of HTTP/1.1 instead of HTTP/2. Enable only if the server has
# HTTP/2 issues.
# --------------------------------------------------------------------------
ForceHTTP1={{ force_http1 | default(false) }}

# --------------------------------------------------------------------------
# Maximum number of retries for transient network failures.
# --------------------------------------------------------------------------
MaxRetries={{ max_retries | default(3) }}