# =============================================================================
# Lynx Browser Configuration
# =============================================================================
# This file configures the Lynx text-mode web browser.
# It sets default behaviors for navigation, display, networking, and protocols.
#
# Variables used are expected to be defined in the Ansible inventory or defaults
# with types matching their defaults below. All variables have inline defaults
# to ensure safe rendering even if undefined in the play context.
# =============================================================================

# -----------------------------------------------------------------------------
# startfile: The initial URL or local file to load when Lynx starts.
# Default: 'http://www.gnu.org/'
# -----------------------------------------------------------------------------
STARTFILE: {{ startfile | default('http://www.gnu.org/') }}

# -----------------------------------------------------------------------------
# homepage: A separate homepage URL, distinct from the startfile.
# Default: '' (empty string)
# -----------------------------------------------------------------------------
HOMEPAGE: {{ homepage | default('') }}

# -----------------------------------------------------------------------------
# display_charset: The MIME name of the character set for terminal output.
# This controls how Lynx renders text on the screen.
# Default: 'ISO-8859-1'
# -----------------------------------------------------------------------------
DISPLAY_CHARSET: {{ display_charset | default('ISO-8859-1') }}

# -----------------------------------------------------------------------------
# assume_charset: The MIME name of the character set for documents that do not
# specify one in their HTTP headers.
# Default: 'ISO-8859-1'
# -----------------------------------------------------------------------------
ASSUME_CHARSET: {{ assume_charset | default('ISO-8859-1') }}

# -----------------------------------------------------------------------------
# organization: The string used in the Organization: header for USENET news
# postings. Useful for identifying your organization in newsgroups.
# Default: '' (empty string)
# -----------------------------------------------------------------------------
ORGANIZATION: {{ organization | default('') }}

# -----------------------------------------------------------------------------
# nntpserver: The default NNTP server used for USENET news reading and posting.
# Only used if the user attempts to access news without specifying a server.
# Default: '' (empty string)
# -----------------------------------------------------------------------------
NNTPSERVER: {{ nntpserver | default('') }}

# -----------------------------------------------------------------------------
# mail_inbox: The default inbox Lynx will check for new mail via the mail
# user-agent facility.
# Default: '' (empty string)
# -----------------------------------------------------------------------------
MAIL: {{ mail_inbox | default('') }}

# -----------------------------------------------------------------------------
# cookies_enabled: Toggle handling of Set-Cookie headers.
# true: Cookies are accepted and stored.
# false: Cookies are ignored.
# Default: True
# -----------------------------------------------------------------------------
COOKIES: {{ cookies_enabled | default(True) | lower }}

# -----------------------------------------------------------------------------
# timeout_seconds: Sets the connection timeout in seconds for network
# requests. A value of 0 means no timeout (wait indefinitely).
# Default: 0
# -----------------------------------------------------------------------------
TIMEOUT: {{ timeout_seconds | default(0) }}

# -----------------------------------------------------------------------------
# dump_width: Number of columns for formatting of dumps (e.g., when using
# Lynx's dump mode to save pages to text files).
# Default: 80
# -----------------------------------------------------------------------------
WIDTH: {{ dump_width | default(80) }}