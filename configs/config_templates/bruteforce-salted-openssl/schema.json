{
  "mode": {
    "type": "string",
    "default": "exhaustive",
    "description": "Operation mode: 'exhaustive' (brute-force) or 'dictionary' (wordlist)",
    "enum": [
      "exhaustive",
      "dictionary"
    ]
  },
  "begin_password": {
    "type": "string",
    "default": "",
    "description": "Beginning of the password to try in exhaustive mode"
  },
  "end_password": {
    "type": "string",
    "default": "",
    "description": "End of the password to try in exhaustive mode"
  },
  "charset": {
    "type": "string",
    "default": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
    "description": "Character set for exhaustive mode"
  },
  "min_length": {
    "type": "number",
    "default": 1,
    "description": "Minimum password length (inclusive) for exhaustive mode"
  },
  "max_length": {
    "type": "number",
    "default": 8,
    "description": "Maximum password length (inclusive) for exhaustive mode"
  },
  "dictionary_file": {
    "type": "string",
    "default": "",
    "description": "Path to dictionary file for dictionary mode"
  },
  "cipher": {
    "type": "string",
    "default": "aes-256-cbc",
    "description": "Symmetric cipher algorithm to use",
    "enum": [
      "aes-256-cbc",
      "des3"
    ]
  },
  "digest": {
    "type": "string",
    "default": "md5",
    "description": "Digest algorithm for key/IV derivation"
  },
  "threads": {
    "type": "number",
    "default": 1,
    "description": "Number of threads to use"
  },
  "progress_interval": {
    "type": "number",
    "default": 0,
    "description": "Print progress every N seconds; 0 disables periodic output"
  },
  "state_file": {
    "type": "string",
    "default": "",
    "description": "File to save/restore session state"
  },
  "stop_after_first": {
    "type": "bool",
    "default": false,
    "description": "Stop after finding the first candidate password"
  },
  "ignore_salt": {
    "type": "bool",
    "default": false,
    "description": "Ignore salt during decryption"
  },
  "ignore_errors": {
    "type": "bool",
    "default": false,
    "description": "Ignore decryption errors (similar to openssl -nopad)"
  },
  "preview_bytes": {
    "type": "number",
    "default": 1024,
    "description": "Preview size (in bytes) to check for magic string"
  },
  "magic_string": {
    "type": "string",
    "default": "",
    "description": "Consider decryption successful if data starts with this string (matches -M)"
  }
}
