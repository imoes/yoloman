[infinoted]
# Unique identifier for this collaborative server instance, used in session negotiation.
identifier = {{ server_identifier | default('infinoted') }}

# IP address or hostname the server binds to. Use 0.0.0.0 for all interfaces.
listen_host = {{ listen_host | default('0.0.0.0') }}

# TCP port the server listens on for client connections.
listen_port = {{ listen_port | default(16993) }}

# Absolute path to the SSL/TLS certificate file (PEM format). Required if SSL is enabled.
{% if (ssl_cert | default('')) | trim %}ssl_cert = {{ ssl_cert | default('') }}{% endif %}

# Absolute path to the SSL/TLS private key file (PEM format). Required if SSL is enabled.
{% if (ssl_key | default('')) | trim %}ssl_key = {{ ssl_key | default('') }}{% endif %}

# GnuTLS priority string controlling cipher suites and protocol version. Adjust for security vs compatibility.
gnutls_priority = {{ gnutls_priority | default('NORMAL:%COMPAT') }}

# Maximum number of concurrent client connections allowed.
max_connections = {{ max_connections | default(100) }}

# Allow guests to connect without authentication.
allow_anonymous = {{ allow_anonymous | default(true) | ternary('true', 'false') }}

# Default role assigned to anonymous users (e.g., 'reader' or 'writer').
anonymous_role = {{ anonymous_role | default('reader') }}

# Directory path where collaborative documents are stored and served from.
share_path = {{ share_path | default('/var/lib/infinoted/shares') }}

# Enable automatic saving of shared documents on change.
auto_save = {{ auto_save | default(true) | ternary('true', 'false') }}

# Seconds between auto-save checkpoints.
auto_save_interval = {{ auto_save_interval | default(30) }}

# Path to log file. Use '-' to log to standard output (e.g., for systemd journal).
log_file = {{ log_file | default('-') }}

# Verbosity level: 0=error, 1=warn, 2=notice, 3=info, 4=debug. Higher = more verbose.
log_level = {{ log_level | default(4) }}

# Enable SSL/TLS for secure connections. Requires ssl_cert and ssl_key.
ssl_enabled = {{ ssl_enabled | default(false) | ternary('true', 'false') }}

# Path to PID file. Must be writable by the infinoted process.
pid_file = {{ pid_file | default('/run/infinoted/infinoted.pid') }}

# Enable WebSockets support for real-time sync (required by some clients like Gobby).
websocket_enabled = {{ websocket_enabled | default(true) | ternary('true', 'false') }}

# Host for WebSocket interface (if enabled).
{% if websocket_enabled | default(true) %}
websocket_host = {{ websocket_host | default('0.0.0.0') }}

# Port for WebSocket interface (if enabled).
websocket_port = {{ websocket_port | default(16994) }}
{% endif %}

# Authentication method: 'none' (no auth), 'simple' (user/password file), or 'ldap' (LDAP server).
auth_backend = {{ auth_backend | default('none') }}

# List of users for simple authentication. Only used when auth_backend = simple.
# Each user entry is mapped as: username = password_hash
{% if auth_backend | default('none') == 'simple' %}
{% for user in simple_auth_users | default([]) %}
{{ user.username | default('') }} = {{ user.password_hash | default('') }}
{% endfor %}
{% endif %}

# LDAP server configuration.
{% if auth_backend | default('none') == 'ldap' %}
# LDAP server URI (e.g., ldap://host:port or ldaps:// for secure).
ldap_uri = {{ ldap_uri | default('ldap://localhost:389') }}

# Base DN for user searches in the LDAP directory.
ldap_base = {{ ldap_base | default('ou=people,dc=example,dc=com') }}

# DN to bind as when querying LDAP (optional; for anonymous bind leave empty).
{% if (ldap_bind_dn | default('')) | trim %}ldap_bind_dn = {{ ldap_bind_dn | default('') }}{% endif %}

# Password for LDAP bind DN (optional).
{% if (ldap_bind_password | default('')) | trim %}ldap_bind_password = {{ ldap_bind_password | default('') }}{% endif %}

# LDAP filter for user lookup; '%u' is replaced by the username.
ldap_user_filter = {{ ldap_user_filter | default('(uid=%u)') }}
{% endif %}

# Maximum session duration in seconds. 0 = no timeout.
session_timeout = {{ session_timeout | default(0) }}

# Seconds of inactivity before automatically disconnecting a client.
idle_timeout = {{ idle_timeout | default(300) }}