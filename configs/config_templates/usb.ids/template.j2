# =============================================================================
# usb.ids / system USB driver configuration template
# =============================================================================
# Self-documenting Jinja2 template for managing USB subsystem parameters.
# All variables are provided with safe defaults to ensure valid output even
# if the caller does not supply specific values.

# hw.usb_debug: Debug output level for the USB driver. 0 is debugging disabled
#               and larger values increase debug message verbosity.
# Default: 0
hw.usb.debug = {{ (hw | default({})).usb_debug | default(0) }}

# usb_load: Loader directive to load the USB driver as a module. Set to YES
#           to load usb(4) as a module, or NO to compile it into the kernel
#           or not load it.
# Default: YES
usb_load="{{ usb_load | default('YES') }}"