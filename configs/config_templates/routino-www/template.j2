# Cron job configuration for the Routino web service cleanup routine.
# This template generates a single crontab line that periodically removes
# stale result files generated by the Routino routing engine.

# Schedule for the cleanup job. Uses standard five-field cron syntax
# (minute hour day-of-month month day-of-week).
# Default: runs daily at 03:00 AM.
{{ cleanup_schedule | default('0 3 * * *') }}	{{ cleanup_user | default('root') }}	find {{ cleanup_dir | default('/var/lib/routino/results') }} -atime {{ cleanup_days | default(7) }} -exec rm "{}" \;