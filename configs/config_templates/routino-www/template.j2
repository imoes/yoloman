# Routino WWW Configuration
# Generated from routino-www role.
# This template generates an Apache VirtualHost or Directory configuration snippet
# for the Routino web-based routing interface.

# The URL alias path where the Routino web interface is served.
# Default: /routino
# Example: Alias /routino /usr/share/routino/www
Alias {{ routino_alias_path | default('/routino') }} {{ routino_document_root | default('/usr/share/routino/www') }}

# Directory block configuring access and execution policies for the Routino web root.
<Directory {{ routino_document_root | default('/usr/share/routino/www') }}>
    # Enable CGI script execution for .cgi files.
    AddHandler cgi-script .cgi

    # Set default language priority for content negotiation.
    LanguagePriority en

    # Prefer specified language over fallback in case of negotiation ambiguity.
    ForceLanguagePriority Prefer Fallback

    # Enable CGI execution options explicitly.
    Options +ExecCGI

    # Disable .htaccess overrides for security and performance.
    AllowOverride None

    # Allow access from the local host (IPv4).
    Require ip 127.0.0.0/255.0.0.0

    # Allow access from the local host (hostname resolution).
    Require host localhost

    # Deny access to Perl scripts to prevent unintended execution if present.
    <FilesMatch .*\.pl$>
        Require all denied
    </FilesMatch>
</Directory>
