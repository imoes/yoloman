# ============================================================================
# mosquitto_clients configuration
# ============================================================================
#
# Package: mosquitto_clients
# Description: Configuration for the Mosquitto MQTT client tools.
#
# NOTE: The mosquitto-clients package provides command-line utilities
#       (mosquitto_pub, mosquitto_sub, mosquitto_rr, etc.).
#       These tools do NOT use a persistent configuration file.
#       Behavior is controlled entirely via command-line arguments.
#       Consequently, this template is empty/placeholder only.
#       Any connection parameters (host, port, topic, qos, retain, etc.)
#       must be passed directly when invoking the tools.
#
# Example usage:
#   mosquitto_sub -h {{ (mosquitto_broker | default({})).host | default('localhost') }} -p {{ (mosquitto_broker | default({})).port | default(1883) }} -t 'my/topic'
#   mosquitto_pub -h {{ (mosquitto_broker | default({})).host | default('localhost') }} -p {{ (mosquitto_broker | default({})).port | default(1883) }} -t 'my/topic' -m 'message'
#
# ============================================================================
# No configuration directives apply.