# Suffix appended to the desktop entry name and script filename for the initial setup wizard.
Name=ibus-anthy {{ initial_setup_name_suffix | default('GNOME Initial Setup') }}
Type=Application
# Path to the setup script, dynamically named using the same suffix.
Exec=/usr/share/ibus-anthy/ibus-anthy-{{ initial_setup_name_suffix | default('GNOME Initial Setup') }}.sh
OnlyShowIn=GNOME;
NoDisplay=true
# Token used in the AutostartCondition to check if the initial setup has already been performed.
AutostartCondition=unless-exists ibus-anthy-{{ autostart_token | default('gnome-initial-setup-done') }}