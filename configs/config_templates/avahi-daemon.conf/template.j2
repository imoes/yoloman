[server]
# Enable or disable mDNS/DNS-SD service on this machine
use-ipv4={{ use_ipv4 | default('yes') }}
# Enable or disable IPv6 support
use-ipv6={{ use_ipv6 | default('yes') }}
# Enable or disable publishing of local hostnames and services
publish-hinfo={{ publish_hinfo | default('yes') }}
# Enable or disable publishing of MX records
publish-mx={{ publish_mx | default('yes') }}
# Enable or disable publishing of SRV records for local services
publish-srv={{ publish_srv | default('yes') }}
# Enable or disable publishing of TXT records for local services
publish-txt={{ publish_txt | default('yes') }}
# Enable or disable publishing of local user-defined service records
publish-domain={{ publish_domain | default('yes') }}
# Enable or disable publishing of DNS-SD service discovery browsing records
publish-workstation={{ publish_workstation | default('yes') }}
# Enable or disable publishing of SSH service record (if enabled in daemon)
publish-ssh={{ publish_ssh | default('no') }}
# Enable or disable publishing of FTP service record (if enabled in daemon)
publish-ftp={{ publish_ftp | default('no') }}
# Enable or disable publishing of WebDAV service record (if enabled in daemon)
publish-webdav={{ publish_webdav | default('no') }}
# Enable or disable publishing of AirPrint service record (if enabled in daemon)
publish-airprint={{ publish_airprint | default('no') }}
# Enable or disable publishing ofipp service record (if enabled in daemon)
publish-ipp={{ publish_ipp | default('no') }}
# Enable or disable publishing of CUPS service record (if enabled in daemon)
publish-cups={{ publish_cups | default('no') }}
# Enable or disable publishing of LPD service record (if enabled in daemon)
publish-lpd={{ publish_lpd | default('no') }}
# Enable or disable publishing of Avahi API service record
publish-apia={{ publish_apia | default('no') }}
# Enable or disable publishing of mDNS-SD responder on this host
publish-resolv-conf={{ publish_resolv_conf | default('yes') }}

# Rate limiting: max number of packets per second per interface (0 = unlimited)
ratelimit-interval-usec={{ rate_limit_interval_usec | default(1000000) }}
# Max packets per rate-limit interval (0 = unlimited)
ratelimit-burst={{ rate_limit_burst | default(50) }}

[wide-area]
# Enable or disable Wide Area mDNS (requires DNS-SD server discovery)
enable-wide-area={{ enable_wide_area | default('no') }}

[publish]
# Enable or disable publishing of local hostnames and services on the local domain
publish-domain={{ publish_local_domain | default('yes') }}
# Enable or disable publishing of local services
publish-services={{ publish_local_services | default('yes') }}

[reflector]
# Enable or disable reflector mode: forward mDNS/DNS-SD packets across subnets
enable-reflector={{ enable_reflector | default('no') }}
# Enable or disable reflection of IPv4 packets
reflect-ipv4={{ reflect_ipv4 | default('yes') }}
# Enable or disable reflection of IPv6 packets
reflect-ipv6={{ reflect_ipv6 | default('yes') }}

[nss-mdns]
# Minimum TTL (in seconds) for mDNS-resolved hostnames
min-ttl={{ min_ttl | default(120) }}

[rlimits]
# Maximum number of open file descriptors (0 = system default)
rlimit-nofile={{ rlimit_nofile | default(512) }}
# Maximum size of core dump (0 = system default)
rlimit-core={{ rlimit_core | default(0) }}
