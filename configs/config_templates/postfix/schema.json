{
  "hostname": {
    "type": "string",
    "default": "mail.example.com",
    "description": "Primary hostname for the mail server"
  },
  "domain": {
    "type": "string",
    "default": "example.com",
    "description": "Primary domain name"
  },
  "inet_interfaces": {
    "type": "string",
    "default": "all",
    "description": "Network interfaces to listen on (e.g., 'all', 'loopback-only')"
  },
  "relayhost": {
    "type": "string",
    "default": "[smtp.upstream.example.com]:587",
    "description": "Outgoing SMTP relay host (with optional port)"
  },
  "mynetworks": {
    "type": "string",
    "default": "127.0.0.0/8 10.0.0.0/24",
    "description": "Allowed networks for relay (space-separated CIDR/networks)"
  },
  "tls": {
    "type": "object",
    "default": null,
    "description": "TLS configuration (ignored in init script; present for completeness)"
  },
  "message_size_limit": {
    "type": "number",
    "default": 26214400,
    "description": "Maximum message size in bytes"
  }
}
