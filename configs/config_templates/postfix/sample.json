{
  "hostname": "mail.example.com",
  "domain": "example.com",
  "inet_interfaces": "all",
  "relayhost": "[smtp.upstream.example.com]:587",
  "mynetworks": "127.0.0.0/8 10.0.0.0/24",
  "tls": {
    "enabled": true,
    "cert_file": "/etc/ssl/certs/mail.crt",
    "key_file": "/etc/ssl/private/mail.key",
    "security_level": "may"
  },
  "message_size_limit": 26214400
}