myhostname = {{ hostname }}
mydomain = {{ domain }}
myorigin = $mydomain
inet_interfaces = {{ inet_interfaces }}
mydestination = $myhostname, localhost.$mydomain, localhost
relayhost = {{ relayhost }}
mynetworks = {{ mynetworks }}
{% if tls.enabled %}smtpd_tls_cert_file = {{ tls.cert_file }}
smtpd_tls_key_file = {{ tls.key_file }}
smtp_tls_security_level = {{ tls.security_level }}
{% endif %}message_size_limit = {{ message_size_limit }}