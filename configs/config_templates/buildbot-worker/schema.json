{
 "basedir": {
  "default": "/var/lib/buildbot/workers/default",
  "description": "Base directory for worker (absolute path)",
  "type": "string"
 },
 "enabled": {
  "default": "0",
  "description": "Enable instance: '1' to enable, '0' to disable",
  "enum": [
   "0",
   "1",
   "false",
   "no",
   "true",
   "yes"
  ],
  "type": "string"
 },
 "instance_id": {
  "default": "1",
  "description": "Instance identifier (used as index in arrays)",
  "type": "string"
 },
 "name": {
  "default": "default",
  "description": "Short name printed on start/stop",
  "type": "string"
 },
 "options": {
  "description": "Buildbot options",
  "enum": [
   "-f",
   "-h",
   "--help",
   "--version",
   "--verbose",
   "-q",
   "--quiet",
   "-r",
   "--relocatable",
   "-n",
   "--no-logrotate",
   "-k",
   "--keepalive",
   "-l",
   "--log-count",
   "-s",
   "--log-size",
   "--umask",
   "--usepty",
   "--delete-leftover-dirs"
  ],
  "type": "string"
 },
 "prefixcmd": {
  "default": "",
  "description": "Prefix command (e.g., nice, linux32, dchroot)",
  "type": "string"
 },
 "user": {
  "default": "buildbot",
  "description": "User to run worker as",
  "type": "string"
 }
}
