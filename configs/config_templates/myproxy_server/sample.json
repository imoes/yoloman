{
  "myproxy_server_port": 7512,
  "myproxy_data_port": 2811,
  "myproxy_server_host": "myproxy.grid.example.org",
  "myproxy_server_cred_dir": "/var/lib/myproxy",
  "myproxy_max_lifetime": 168,
  "myproxy_min_lifetime": 1,
  "myproxy_default_lifetime": 24,
  "myproxy_delegate": true,
  "myproxy_revoke": true,
  "myproxy_ssl": true,
  "myproxy_server_cert": "/etc/grid-security/hostcert.pem",
  "myproxy_server_key": "/etc/grid-security/hostkey.pem",
  "myproxy_ca_certs": "/etc/grid-security/certificates",
  "myproxy_allowed_users": [
    "/C=US/O=Example/CN=Alice Smith",
    "/C=US/O=Example/CN=Bob Jones"
  ],
  "myproxy_allowed_groups": [
    "/Example/Role=production",
    "/Example/Capability=submit"
  ],
  "myproxy_syslog": true,
  "myproxy_log_level": 3,
  "myproxy_log_file": "/var/log/myproxy/server.log",
  "myproxy_num_threads": 8,
  "myproxy_voms": true,
  "myproxy_voms_config": "/etc/myproxy-voms.conf",
  "myproxy_voms_servers": [
    {
      "hostname": "voms1.grid.example.org",
      "port": 15000,
      "ca_path": "/etc/grid-security/vomsdir/voms1.grid.example.org"
    },
    {
      "hostname": "voms2.grid.example.org",
      "port": 15000,
      "ca_path": "/etc/grid-security/vomsdir/voms2.grid.example.org"
    }
  ],
  "myproxy_rotate": true,
  "myproxy_rotate_interval": 12,
  "myproxy_batch": false,
  "myproxy_no_passphrase": false,
  "myproxy_max_credentials": 50,
  "myproxy_rfc_proxy": true
}
