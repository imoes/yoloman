# ==============================================================================
# MyProxy Credential Management Service configuration
# This file is sourced by the myproxy-server script and defines runtime parameters.
# ==============================================================================

# TCP port the MyProxy server listens on for incoming credential requests.
# Default: 7512
MYPROXY_SERVER_PORT={{ (myproxy_server_port | default(7512)) }}

# Host IP address or hostname the server binds to.
# Default: '0.0.0.0' (all interfaces)
MYPROXY_SERVER_HOST={{ (myproxy_server_host | default('0.0.0.0')) }}

# Directory where user credentials are persistently stored.
# Default: '/var/lib/myproxy'
MYPROXY_SERVER_CRED_DIR={{ (myproxy_server_cred_dir | default('/var/lib/myproxy')) }}

# Maximum lifetime (in hours) allowed for stored credentials.
# Default: 168
MYPROXY_MAX_LIFETIME={{ (myproxy_max_lifetime | default(168)) }}

# Minimum lifetime (in hours) required for newly stored credentials.
# Default: 1
MYPROXY_MIN_LIFETIME={{ (myproxy_min_lifetime | default(1)) }}

# Default lifetime (in hours) applied when no explicit lifetime is requested.
# Default: 24
MYPROXY_DEFAULT_LIFETIME={{ (myproxy_default_lifetime | default(24)) }}

# If enabled, allows users to delegate credentials.
# Default: True
MYPROXY_DELEGATE={{ (myproxy_delegate | default(True)) | ternary('true', 'false') }}

# Path to the server's X.509 certificate file.
# Default: '/etc/grid-security/hostcert.pem'
MYPROXY_SERVER_CERT={{ (myproxy_server_cert | default('/etc/grid-security/hostcert.pem')) }}

# Path to the server's private key file.
# Default: '/etc/grid-security/hostkey.pem'
MYPROXY_SERVER_KEY={{ (myproxy_server_key | default('/etc/grid-security/hostkey.pem')) }}

# Path to the directory containing trusted CA certificates.
# Default: '/etc/grid-security/certificates'
MYPROXY_CA_CERTS={{ (myproxy_ca_certs | default('/etc/grid-security/certificates')) }}

# Verbosity of logging: 0=none, 5=debug.
# Default: 2
MYPROXY_LOG_LEVEL={{ (myproxy_log_level | default(2)) }}

# Path to a dedicated log file. If empty, logging goes to syslog only.
# Default: '' (empty)
MYPROXY_LOG_FILE={{ (myproxy_log_file | default('')) }}

# If enabled, enforces TLS/SSL encryption for connections.
# Default: True
MYPROXY_SSL={{ (myproxy_ssl | default(True)) | ternary('true', 'false') }}

# Path to the OpenSSL engine module. Leave empty to use the default engine.
# Default: '' (empty)
MYPROXY_SSL_ENGINE={{ (myproxy_ssl_engine | default('')) }}