# Enable POP3 protocol
protocols = pop3

# Base directory where to store runtime data
base_dir = /var/run/dovecot/

# Directory for per-user configuration (if used)
userdb { 
  driver = passwd-file
  args = scheme=SHA512-CRYPT username_format = %n /etc/dovecot/users
}

# Password database for authentication
passdb {
  driver = passwd-file
  args = scheme=SHA512-CRYPT username_format = %n /etc/dovecot/users
}

# Listen on specified interfaces (IPv4 and/or IPv6)
# Set to '*' to listen on all interfaces
listen = {{ listen_address | join(', ') }}

# TLS/SSL configuration
ssl = {{ ssl_enabled | string | lower }}

# Path to SSL certificate
ssl_cert = </etc/dovecot/ssl/dovecot.crt

# Path to SSL private key
ssl_key = </etc/dovecot/ssl/dovecot.key

# Minimum SSL protocol version (e.g., ssl_min_protocol = !SSLv3, !TLSv1)
ssl_min_protocol = TLSv1.2

# Allowed ciphers (strong ciphers only)
ssl_cipher_list = ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384

# Login user (for unauthenticated operations)
login_greeting = Dovecot POP3 ready.

# Mail location format
mail_location = maildir:~/Maildir

# Namespace for mailboxes
namespace {
  type = private
  separator = /
  prefix =
  inbox = yes
}

# Mail processes: master process and service definitions
mail processes = {{ mail_processes }}

# Process limits
# Maximum number of simultaneous connections per service
# Set to 0 for unlimited (not recommended in production)
# Services: auth, pop3, pop3-login
mail_max_userip_connections = {{ mail_max_userip_connections }}

# POP3-specific settings
pop3_uidl_format = %08Xu%08Xv
pop3_client_workarounds = {{ pop3_client_workarounds | join(', ') }}

# Disable plaintext auth unless SSL/TLS is active (recommended)
disable_plaintext_auth = {{ disable_plaintext_auth | string | lower }}

# Log path (optional, leave blank to use syslog)
# log_path = /var/log/dovecot.log

# Auth socket path for mail delivery (e.g., from Postfix)
# auth_socket_path = /var/run/dovecot/auth-userdb

# Authentication mechanisms (plain and login; avoid anonymous)
auth_mechanisms = {{ auth_mechanisms | join(' ') }}

# Timeout values (seconds)
# Mailbox access timeout
mail_temp_dir = /var/spool/dovecot
mail_fsync = always
mail_nfs_storage = no
mail_nfs_index = no

# Mail processes: worker and service configuration
service auth {
  unix_listener auth-userdb {
    mode = 0660
    user = vmail
    group = vmail
  }
}

# POP3 service definition
service pop3 {
  # Max connections per POP3 process
  max_clients = {{ pop3_max_clients }}
}

# POP3 login service (handles incoming connections)
service pop3-login {
  # Max connections to login service
  max_clients = {{ pop3_login_max_clients }}
  # Idle kill timeout for login sessions
  # idle_kill = {{ login_idle_kill }}
}

# Logging
# Log to syslog or file
log_path = {{ log_path | default('syslog') }}
info_log_path = {{ log_path | default('syslog') }}

# Include conf.d/*.conf files (optional, enabled by default)
# !include conf.d/*.conf
