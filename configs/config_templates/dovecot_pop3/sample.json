{
  "listen_address": [
    "*"
  ],
  "ssl_enabled": true,
  "mail_processes": 10,
  "mail_max_userip_connections": 20,
  "pop3_client_workarounds": [
    "outlook-no-nuls",
    "oe-ns-eoh"
