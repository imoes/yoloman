{
  "kernel": {
    "type": "string",
    "default": "/boot/vmlinuz",
    "description": "Path to the Linux kernel binary file"
  },
  "output": {
    "type": "string",
    "default": "",
    "description": "Path to the output file. Empty string implies stdout"
  },
  "params": {
    "type": "string",
    "default": "root=/dev/sda1",
    "description": "Kernel commandline parameters"
  },
  "format": {
    "type": "string",
    "default": "elf",
    "description": "Output format: elf, multiboot, or nbi",
    "enum": [
      "elf",
      "multiboot",
      "nbi"
    ]
  },
  "load_high": {
    "type": "bool",
    "default": false,
    "description": "Whether to load components above 1MB"
  },
  "initrds": {
    "type": "list",
    "default": [],
    "description": "List of initial ramdisk filenames"
  }
}
