# ==============================================================================
# wraplinux — Kernel Packaging Configuration
# ==============================================================================
# This template configures the 'wraplinux' utility, which packages a Linux kernel
# binary along with initial ramdisks (initrds) into a specified output format
# (ELF, Multiboot, or NBI).
# ==============================================================================

# Path to the Linux kernel binary file to be wrapped.
# This is the vmlinuz or bzImage file generated by the kernel build process.
KERNEL: {{ kernel | default('/boot/vmlinuz') }}

# Path to the output file.
# If left empty, the result is written to stdout.
# Use this field to specify where the final packaged kernel image should be saved.
OUTPUT: {{ output | default('') }}

# Kernel commandline parameters.
# These parameters are embedded into the wrapped image and passed to the kernel
# at boot time (e.g., root device, console, quiet mode).
PARAMS: {{ params | default('root=/dev/sda1') }}

# Output format for the wrapped kernel image.
# Supported formats:
#   - elf:       Standard ELF executable format (common for EFI bootloaders).
#   - multiboot: Multiboot Specification format (compatible with GRUB, Syslinux).
#   - nbi:       Network Boot Image format (used for PXE/network booting).
FORMAT: {{ format | default('elf') }}

# Whether to load components above the 1MB memory boundary.
# Set to true if the kernel/initrd are large or if the boot environment
# requires high-memory loading. Set to false for legacy/compatibility modes.
LOAD_HIGH: {{ load_high | default(false) }}

# List of initial ramdisk (initrd) filenames to include in the package.
# Each entry is a path to an initrd image that will be appended or linked.
# These are critical for early boot modules (filesystem drivers, etc.).
INITRDS:
{% for initrd in initrds | default([]) %}
- {{ initrd }}
{% endfor %}