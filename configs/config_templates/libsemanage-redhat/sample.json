  "module_store": "direct",
  "policy_version": "19",
  "expand_check": "0",
  "usepasswd": false,
  "bzip_small": true,
  "bzip_blocksize": 5,
  "ignoredirs": "/root;/bin;/boot;/dev;/etc;/lib;/lib64;/proc;/run;/sbin;/sys;/tmp;/usr;/var",
