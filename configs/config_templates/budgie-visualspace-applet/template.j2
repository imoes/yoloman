# ==============================================================================
# Budgie VisualSpace Applet Autostart Configuration
# ==============================================================================
# This template generates a .desktop entry file for the Budgie VisualSpace applet.
# It configures the automatic workspace feature provided by the Budgie desktop environment.
#
# Variables required:
#   - exec_path: Path to the auto_workspace executable (defaults to /usr/lib/budgie-desktop/plugins/budgie-visualspace/auto_workspace)
#   - gsettings_key: GSettings schema key to determine autostart condition (defaults to org.ubuntubudgie.plugins.budgie-visualspace autospaces)
# ==============================================================================

[Desktop Entry]
# Entry type: Must be Application for desktop launchers
Type=Application

# Display name of the application in the system menus
Name=VisualSpace automatic workspaces

# Command to execute. Uses the configured path to the auto_workspace binary.
Exec={{ exec_path | default('/usr/lib/budgie-desktop/plugins/budgie-visualspace/auto_workspace') }}

# Hide this entry from standard application menus (it runs in background)
NoDisplay=true

# Autostart condition: Only start if the GSettings key indicates auto-spaces are enabled.
# Format: GSettings <key>
# Example: GSettings org.ubuntubudgie.plugins.budgie-visualspace autospaces
AutostartCondition=GSettings {{ gsettings_key | default('org.ubuntubudgie.plugins.budgie-visualspace autospaces') }}

# Compatibility flags for other desktop environments
X-MATE-AutoRestart=true
X-GNOME-AutoRestart=true
