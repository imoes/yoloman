# Configuration file for the Budgie VisualSpace Applet autostart entry.
# This file is rendered as a standard freedesktop Desktop Entry file.

[Desktop Entry]
# The application type; always Application for desktop starters.
Type=Application

# A human-readable name for the entry, displayed in session managers.
Name=VisualSpace automatic workspaces

# The command line to execute.
# Defaults to the standard path provided by the budgie-desktop package.
Exec={{ exec_path | default('/usr/lib/budgie-desktop/plugins/budgie-visualspace/auto_workspace') }}

# Hide this entry from standard application menus; it is a background service.
NoDisplay=true

# Condition under which the application should be started.
# Uses GSettings schema and key to detect if the feature is enabled.
# The key defaults to the Ubuntu Budgie plugin's standard settings location.
AutostartCondition=GSettings {{ gsettings_key | default('org.ubuntubudgie.plugins.budgie-visualspace autospaces') }}

# Compatibility flags for GNOME and MATE session managers to handle restarts gracefully.
X-MATE-AutoRestart=true
X-GNOME-AutoRestart=true