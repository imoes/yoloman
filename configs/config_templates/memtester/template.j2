#!/bin/sh
# memtester service script configuration
# Automatically generated by Ansible Jinja2 template
# This script configures and executes the memtester binary with specified parameters.

# Number of iterations to run (0 for infinite loops)
ITERATIONS={{ iterations | default(0) }}

# Amount of memory to allocate and test (e.g., 512M, 1G, 1024)
MEMORY={{ memory | default('512M') }}

# Physical address to test (hex string) if using -p option; empty to skip
PHYS_ADDR={{ phys_addr | default('') }}

# Device to open with -p option (e.g., /dev/mem) if using -p; empty to skip
DEVICE={{ device | default('') }}

# Use uncached memory semantics (-u) if true
UNCACHED={{ uncached | default(false) | lower }}

# Bitmask of tests to run via MEMTESTER_TEST_MASK environment variable
# Leave empty to run all tests
TEST_MASK={{ test_mask | default('') }}

# --- Execution Logic ---

# Construct the base command string
cmd="memtester ${MEMORY} ${ITERATIONS}"

# If a physical address is specified, add the -p flag and optional device/uncached flags
{% if phys_addr | default('') != '' %}
  cmd="${cmd} -p ${PHYS_ADDR}"
  {% if device | default('') != '' %}
    cmd="${cmd} -d ${DEVICE}"
  {% endif %}
  {% if uncached | default(false) %}
    cmd="${cmd} -u"
  {% endif %}
{% endif %}

# If a test mask is specified, export it as an environment variable
{% if test_mask | default('') != '' %}
export MEMTESTER_TEST_MASK={{ test_mask | default('') }}
{% endif %}

echo "Running: ${cmd}"
exec su -c "${cmd}" root