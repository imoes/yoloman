#
# This is a POSIX shell fragment
# Configuration for the 'consolation' service daemon.
#
# See the system service wrapper (systemd unit file or init script)
# which executes this configuration and passes the DAEMON_OPTS
# variable to the actual daemon binary.

# DAEMON_OPTS: Command-line options passed to the consolation daemon at startup.
# No options is fine for most users.
DAEMON_OPTS="{{ DAEMON_OPTS | default('') | trim }}"