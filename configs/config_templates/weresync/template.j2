# WererSync Configuration Template
# This file defines the parameters for incremental Linux drive cloning.
# It is auto-generated by Ansible to be self-documenting.

# The source disk device path to clone from.
SOURCE_DEVICE: {{ source_device | default('/dev/sda') }}

# The target disk device path to clone to.
TARGET_DEVICE: {{ target_device | default('/dev/sdb') }}

# The partition number on the source drive that is mounted as the root filesystem (/).
ROOT_PARTITION_NUM: {{ root_partition_num | default(2) }}

# The partition number on the source drive that is the EFI System Partition.
# Use 0 if not applicable.
EFI_PARTITION_NUM: {{ efi_partition_num | default(1) }}

# The partition number on the source drive that is mounted as /boot.
# Use 0 if not applicable.
BOOT_PARTITION_NUM: {{ boot_partition_num | default(0) }}

# The bootloader plugin to use for installing the bootloader on the target (e.g., grub2, uuid_copy, syslinux).
BOOTLOADER_PLUGIN: {{ bootloader_plugin | default('grub2') }}

# If true, check if target partitions are valid and re-partition/re-format them if necessary.
# WARNING: Setting to true will destroy existing data on target.
CHECK_AND_PARTITION: {{ check_and_partition | default(false) | lower }}

# A list of partition numbers to exclude from being copied or searched. Items are integers representing partition numbers.
EXCLUDED_PARTITIONS: {{ excluded_partitions | default([]) | join(',') }}

# Arguments to pass to the rsync command used for file copying.
RSYNC_ARGS: {{ rsync_args | default('-aAXxH --delete') }}

# The name of the LVM source Volume Group to clone.
# Empty string if no LVM cloning is required.
LVM_SOURCE_VG: {{ lvm_source_vg | default('') }}

# The name of the LVM target Volume Group.
# Empty string uses {source}-copy.
LVM_TARGET_VG: {{ lvm_target_vg | default('') }}

# If true, enable verbose output from wereSync.
VERBOSE: {{ verbose | default(false) | lower }}

# If true, enable debug output from wereSync.
DEBUG: {{ debug | default(false) | lower }}

# A format string to construct source partition paths, taking device name and partition number as arguments.
SOURCE_PARTITION_MASK: {{ source_partition_mask | default('{0}{1}') }}

# A format string to construct target partition paths, taking device name and partition number as arguments.
TARGET_PARTITION_MASK: {{ target_partition_mask | default('{0}{1}') }}

# The directory to mount source partitions.
# Empty string uses a random /tmp directory.
SOURCE_MOUNT_DIR: {{ source_mount_dir | default('') }}

# The directory to mount target partitions.
# Empty string uses a random /tmp directory.
TARGET_MOUNT_DIR: {{ target_mount_dir | default('') }}

# If true, halt the program if any errors occur during copying.
BREAK_ON_ERROR: {{ break_on_error | default(false) | lower }}