{
  "debug": false,
  "server": {
    "bindings": [
      {
        "address": "127.0.0.1",
        "port": 10080
      },
      {
        "address": "0.0.0.0",
        "port": 10081
      }
    ],
    "max_clients": 250,
    "idle_timeout": 600,
    "client_mem_limit": 8192,
    "persistent_sessions": true,
    "log_level": 2,
    "log_file": "/var/log/canna/canna.log",
    "default_locale": "ja_JP.UTF-8",
    "kanji_code": "utf8",
    "user_dict_enabled": true,
    "dict_update_perm": 1
  },
  "canna": {
    "dic_dir": "/var/lib/canna/dic",
    "shm_dir": "/var/lib/canna/shm",
    "dictionaries": [
      "sys",
      "jisyo",
      "user"
    ]
  },
  "security": {
    "allowed_hosts": [
      "127.0.0.1",
      "kana.example.org"
    ],
    "allowed_networks": [
      "10.0.0.0/8",
      "192.168.42.0/24"
    ]
  }
}
