#! /bin/sh
#
# Init script for the Canna Japanese Input System.
# Auto-generated by Ansible from template.
#
# Written by Miquel van Smoorenburg <miquels@drinkel.ow.org>.
# Modified for Debian GNU/Linux by Ian Murdock <imurdock@gnu.ai.mit.edu>.
# Modified for Debian by Christoph Lameter <clameter@debian.org>

### BEGIN INIT INFO
# Provides:          canna
# Required-Start:    $local_fs $remote_fs
# Required-Stop:     $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: canna Japanese Input System
# Description:       Canna provides a unified user interface for inputting Japanese.
### END INIT INFO

PATH=/bin:/usr/bin:/sbin:/usr/sbin
CANNASERVER=/usr/sbin/cannaserver
CANNAKILL=/usr/bin/cannakill
CANNASTAT=/usr/bin/cannastat

# System user account under which the Canna server process runs.
# Default: 'canna'
CANNA_SERVER_OPT="-u {{ canna_user | default('canna') }}"

if [ -e /etc/default/canna ] ; then
    . /etc/default/canna
fi

# The following value is extracted by debstd to figure out how to generate
# the postinst script. Edit the field to change the way the script is
# registered through update-rc.d (see the manpage for update-rc.d!)
FLAGS="defaults 98"

test -f $CANNASERVER || exit 0
test -f $CANNAKILL || exit 0

# Whether the Canna server should be run (set to 'no' to disable).
# The CANNA_SERVER_RUN environment variable is used at runtime by the init script.
# Default: 'yes'
{% if (CANNA_SERVER_RUN | default('yes')) == 'no' %}
exit 0
{% endif %}

# Whether to enable INET mode (set to 'yes' or 'no').
# Similar to canna_server_run, this corresponds to CANNA_ENABLE_INET.
# The script checks $CANNA_ENABLE_INET at runtime.
# Default: 'yes'
if [ "{{ (CANNA_ENABLE_INET | default('yes')) }}" = "yes" ] ; then
    CANNA_INET_OPT="-inet"
else
    CANNA_INET_OPT=""
fi

. /lib/lsb/init-functions

RUN_SERVER=1

case "$1" in
  start)
    echo "Starting cannaserver..."
    $CANNASERVER $CANNA_INET_OPT $CANNA_SERVER_OPT
    ;;
  stop)
    echo "Stopping cannaserver..."
    $CANNAKILL
    ;;
  force-reload|restart)
    echo "Restarting cannaserver..."
    $CANNAKILL
    $CANNASERVER $CANNA_INET_OPT $CANNA_SERVER_OPT
    ;;
  status)
    $CANNASTAT
    ;;
  *)
    echo "Usage: /etc/init.d/$0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0