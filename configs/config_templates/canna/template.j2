# Canna Japanese Input System Configuration
# This file configures the Canna server (cannaserv) and related components.
# Generated template; site-specific values are parameterized.

# System-wide defaults for the Canna server
# Enable debugging mode for troubleshooting
{% if debug %}Debug{% else %}NoDebug{% endif %}

# Network listening interface and port
# Bind to localhost by default for security
{% for binding in server.bindings %}ServerAddr {{ binding.address }} {{ binding.port }}{% endfor %}

# Dictionary and shared memory settings
# Path to the dictionary files
DicDir {{ canna.dic_dir }}

# Path to the shared memory directory (must be writable by canna user)
ShmDir {{ canna.shm_dir }}

# Dictionary name list (comma-separated, no spaces)
# Defines the default dictionaries loaded at startup
{% if canna.dictionaries %}DicList {{ canna.dictionaries | join(',') }}{% else %}# No dictionaries defined — add via canna.dictionaries{% endif %}

# Process limits and resource settings
# Maximum number of concurrent clients
MaxClients {{ server.max_clients }}

# Timeout for idle connections (in seconds)
IdleTimeout {{ server.idle_timeout }}

# Memory limit per client session (in KB)
ClientMemLimit {{ server.client_mem_limit }}

# Enable/disable session persistence
{% if server.persistent_sessions %}PersistentSession{% else %}NoPersistentSession{% endif %}

# Logging configuration
# Log level: 0=quiet, 1=error, 2=info, 3=debug
LogLevel {{ server.log_level }}

# Log file path (use '-' for stdout)
Logfile {{ server.log_file }}

# Security: restrict access to trusted hosts/networks
{% for host in security.allowed_hosts %}AllowHost {{ host }}{% endfor %}
{% for cidr in security.allowed_networks %}AllowNet {{ cidr }}{% endfor %}

# Optional: locale and input method defaults
# Default locale for client sessions (e.g., ja_JP.eucJP, ja_JP.UTF-8)
{% if server.default_locale %}DefaultLocale {{ server.default_locale }}{% endif %}

# Use kanji code conversion: euc, sjis, jis, utf8
{% if server.kanji_code %}KanjiCode {{ server.kanji_code }}{% else %}KanjiCode euc{% endif %}

# Enable built-in user dictionary support
{% if server.user_dict_enabled %}UserDict{% else %}NoUserDict{% endif %}

# Dictionary update permissions: 0=none, 1=admin, 2=all
DictUpdatePerm {{ server.dict_update_perm }}
