# Canna Input Method System Configuration
#
# This file defines the dictionary directories and search order for the Canna
# Japanese input method server. It maps dictionary files (.cbd, .ctd, .mwd, .swd)
# to their respective processing modules.
#
# Syntax:
#   dictionary_file(alternate_file)   -module_name---
#
# - dictionary_file: Primary dictionary path relative to the Canna dictionary directory.
# - alternate_file: Fallback dictionary path (usually in parentheses).
# - module_name: The internal module identifier used by Canna for processing.

#
# === Main Dictionary Entries ===
#

# Fuzokugo (auxiliary words) dictionary
# Uses fuzokugo.cbd with fuzokugo.swd as an alternative
# Module: -fuzokugo---
fuzokugo.cbd(fuzokugo.swd)	-fuzokugo---

# Iroha (basic Japanese kana/kanji) dictionary
# Uses iroha.cbd with iroha.mwd (morphological) as the primary
# Module: -iroha---
iroha.cbd(iroha.mwd)		-iroha---

# Bushu (radical-based) dictionary
# Uses iroha.cbd with bushu.mwd
# Module: -bushu---
iroha.cbd(bushu.mwd)		-bushu---

# Hojoswd (supplementary word) dictionary
# Uses hojoswd.ctd with .swd fallback
# Module: -hojoswd---
hojoswd.ctd(.swd)		-hojoswd---

# Iroha (Kanji lookup) dictionary
# Uses iroha.cld with iroha.mwd
# Module: -iroha---
iroha.cld(iroha.mwd)		-iroha---

# Bushu (Radical) dictionary
# Uses bushu.cld with bushu.mwd
# Module: -bushu---
bushu.cld(bushu.mwd)		-bushu---

# Hojomwd (Morphological) dictionary
# Uses hojomwd.ctd with .mwd fallback
# Module: -hojomwd---
hojomwd.ctd(.mwd)		-hojomwd---

# Number dictionary
# Uses number.ctd with .swd fallback
# Module: -number---
number.ctd(.swd)		-number---

# Katakana dictionary
# Uses katakana.ctd with .mwd fallback
# Module: -katakana---
katakana.ctd(.mwd)		-katakana---

# Keishiki (format/style) dictionary
# Uses keishiki.ctd with .swd fallback
# Module: -keishiki---
keishiki.ctd(.swd)		-keishiki---

# Suffix dictionary
# Uses suffix.ctd with .swd fallback
# Module: -suffix---
suffix.ctd(.swd)		-suffix---

#
# === Additional/Extended Dictionary Entries ===
#

# Chimei (homophones) dictionary
# Uses chimei.ctd with .mwd fallback
# Module: -chimei---
chimei.ctd(.mwd)		-chimei---

# Kana Sample dictionary
# Uses kanasmpl.ctd with .mwd fallback
# Module: -kanasample---
kanasmpl.ctd(.mwd)		-kanasample---

# NEC Gaiji (external/unique characters) dictionary
# Uses necgaiji.ctd with .mwd fallback
# Module: -necgaiji---
necgaiji.ctd(.mwd)		-necgaiji---

# Software dictionary
# Uses software.ctd with .mwd fallback
# Module: -software---
software.ctd(.mwd)		-software---
