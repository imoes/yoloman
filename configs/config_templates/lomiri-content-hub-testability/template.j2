# vim:syntax=apparmor
# Author: Ken VanDine <ken.vandine@canonical.com>
#
# Lomiri Content Hub Testability - AppArmor Profile Configuration
#
# This template generates two AppArmor profiles used for testing the
# Lomiri Content Hub. One profile allows access to `/etc/issue`,
# while the other explicitly denies it (auditing the denial).
#
# The profiles are named dynamically based on the schema fields
# `profile_ok_name` and `profile_bad_name`.

#include <tunables/global>

# Profile: OK Test Case
# Description: A permissive profile used to verify that the Content Hub
#              can successfully read system files like `/etc/issue`.
#              This profile includes standard base abstractions and
#              session D-Bus access.
profile "{{ profile_ok_name | default('lomiri-content-hub-test-ok') }}" {
    #include <abstractions/base>
    #include <abstractions/dbus-session>
    
    # Rule: Read /etc/issue
    # Description: Allows reading the issue file (often containing system
    #              identification info). This is allowed in the "ok" test
    #              case.
    /etc/issue r,
}

# Profile: BAD Test Case
# Description: A restrictive profile used to verify that the Content Hub
#              correctly fails (or is denied) when attempting to access
#              restricted files. This profile audits the denial.
#              This profile includes standard base abstractions and
#              session D-Bus access.
profile "{{ profile_bad_name | default('lomiri-content-hub-test-bad') }}" {
    #include <abstractions/base>
    #include <abstractions/dbus-session>
    
    # Rule: Deny and Audit /etc/issue
    # Description: Explicitly denies reading `/etc/issue` and generates
    #              an audit log entry. This is used in the "bad" test
    #              case to ensure security boundaries are enforced.
    audit deny /etc/issue r,
}
