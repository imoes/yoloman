{
 "case_insensitive_search": true,
 "custom_folders": {
  "All": "*/cur",
  "Unread": "Inbox/cur/*"
 },
 "db_path": ".mairix",
 "external_indexer": "",
 "extra_folders": [
  "Archive/2023"
 ],
 "folder_prefix": "/home/user/Mail/",
