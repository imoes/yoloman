{
  "mail_base": "/home/user/Mail",
  "db_path": ".mairix",
  "mail_folders": [
    "Inbox",
    "Sent",
    "Drafts"
  ],
  "extra_folders": [
    "Archive/2023"
  ],
  "sendmail_path": "/usr/bin/msmtp",
  "result_limit": 50,
  "include_message_ids": true,
  "case_insensitive_search": true,
  "search_headers": true,
  "search_bodies": true,
  "custom_folders": {
    "All": "*/cur",
    "Unread": "Inbox/cur/*"
  },
  "ignore_pattern": ".*, tmp",
  "folder_prefix": "/home/user/Mail/",
  "external_indexer": ""
}
