# Configuration file for user-specific settings
# Generated by service configuration wizard

# General service settings
[general]
# Enable or disable debug mode
{{ 'enabled' if debug_mode else 'disabled' }}

# Logging verbosity level
log_level = {{ log_level }}

# Directory where runtime files are stored
runtime_dir = {{ runtime_dir }}

# Directory where configuration files are stored
config_dir = {{ config_dir }}

# Path to PID file
pid_file = {{ pid_file }}

# Service name (used for logging and process identification)
service_name = {{ service_name }}

# Network interface binding
bind_address = {{ bind_address }}

# TCP port for primary service listener
port = {{ port }}

# Maximum number of concurrent connections
max_connections = {{ max_connections }}

# Timeout for client connections (seconds)
connection_timeout = {{ connection_timeout }}

# Timeout for backend requests (seconds)
backend_timeout = {{ backend_timeout }}

# Retry attempts for transient failures
retry_attempts = {{ retry_attempts }}

# Delay between retries (milliseconds)
retry_delay = {{ retry_delay }}

# Worker process settings
# Number of worker processes to spawn
worker_count = {{ worker_count }}

# Enable graceful reload on configuration change
worker_graceful_reload = {{ worker_graceful_reload }}

# Worker idle timeout (seconds) — workers restart after this inactivity
worker_idle_timeout = {{ worker_idle_timeout }}

# Worker memory limit (MB) — workers restart if exceeded
worker_memory_limit = {{ worker_memory_limit }}

# Feature toggles
# Enable HTTPS support
enable_https = {{ enable_https }}

# Enable compression for responses
enable_compression = {{ enable_compression }}

# Enable access logging
enable_access_log = {{ enable_access_log }}

# Enable error logging
enable_error_log = {{ enable_error_log }}

# SSL/TLS configuration
ssl_enabled = {{ ssl_enabled }}
ssl_cert_file = {{ ssl_cert_file }}
ssl_key_file = {{ ssl_key_file }}
ssl_ca_file = {{ ssl_ca_file }}
ssl_protocols = {{ ssl_protocols | join(', ') }}
ssl_prefer_server_ciphers = {{ ssl_prefer_server_ciphers }}
ssl_session_cache_size = {{ ssl_session_cache_size }}
ssl_session_timeout = {{ ssl_session_timeout }}

# Backend servers
# List of backend servers to forward requests to
{% for backend in backends %}
[backend:{{ backend.name }}]
address = {{ backend.address }}
port = {{ backend.port }}
weight = {{ backend.weight }}
{% if backend.health_check %}health_check = enabled
health_check_interval = {{ backend.health_check_interval }}
health_check_uri = {{ backend.health_check_uri }}
healthy_threshold = {{ backend.healthy_threshold }}
unhealthy_threshold = {{ backend.unhealthy_threshold }}
{% else %}health_check = disabled
{% endif %}
{% endfor %}

# Security settings
# Enable request rate limiting
rate_limit_enabled = {{ rate_limit_enabled }}
rate_limit_requests_per_second = {{ rate_limit_requests_per_second }}
rate_limit_burst = {{ rate_limit_burst }}

# Enable request body size limit (KB)
request_body_limit = {{ request_body_limit }}

# Enable origin validation (CORS)
origin_validation_enabled = {{ origin_validation_enabled }}
allowed_origins = {{ allowed_origins | join(', ') }}
