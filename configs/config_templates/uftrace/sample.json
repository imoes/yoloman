{
  "subcommand": "report",
  "command": "",
  "data_dir": "my_app.trace",
  "verbose": 1,
  "debug_domains": [],
  "color": "yes",
  "no_pager": true,
  "filter": [
    "main",
    "process_data"
  ],
  "hide": [
    "libc_*",
    "pthread_*"
  ],
  "depth": 10,
  "max_stack": 65535,
  "flat": false,
  "auto_args": true,
  "show_retval": true,
  "output_format": "html",
  "sort_keys": [
    "self",
    "total"
  ],
  "kernel_trace": false,
  "kernel_depth": 0,
  "libmcount_path": "",
  "demangle": "full",
  "match_type": "regex",
  "time_filter": "1ms",
  "size_filter": ""
}
