# AppArmor ABI version used in the profile.
# Defaults to '4.0' if not specified in the Ansible variables.
abi <abi/{{ apparmor_abi_version | default('4.0') }}>,

include <tunables/global>

# Profile for the ping utility.
# Defines the security policy for /{usr/,}bin/{,iputils-}ping running in complain mode.
profile ping /{usr/,}bin/{,iputils-}ping flags=(complain) {
  # Include base abstractions required for standard operation.
  include <abstractions/base>

  # Include console-related abstractions (tty access, etc.).
  include <abstractions/consoles>

  # Include nameservice abstractions (DNS, NIS, etc.).
  include <abstractions/nameservice>

  # Allow raw network capabilities required for ping.
  capability net_raw,
  capability setuid,

  # Allow raw IPv4 and IPv6 network access.
  network inet raw,
  network inet6 raw,

  # Read/write access to the ping binary itself and libraries.
  /{,usr/}bin/{,iputils-}ping mixr,

  # Read access to module configuration.
  /etc/modules.conf r,

  # Read access to IPv6 sysctl settings to determine if IPv6 is disabled.
  @{PROC}/sys/net/ipv6/conf/all/disable_ipv6 r,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/bin.ping>
}
