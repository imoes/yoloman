# AppArmor ABI version declaration.
# Specifies the version of the AppArmor ABI used to compile and interpret the profile rules.
# Must match the kernel's AppArmor ABI version for compatibility.
# @see apparmor_abi_version
abi {{ (apparmor_abi_version | default('4.0')) }},

# Include global tunables (variable definitions like @{HOME}, @{TMP}, etc.).
# This provides standard variable definitions used throughout the profile.
include <tunables/global>

# Profile definition for the 'ping' utility.
# Defines the access control policy for the ping command.
# The 'flags=(complain)' mode logs violations but does not block them.
# Remove 'flags=(complain)' to enforce strict blocking (enforce mode).
profile ping /{usr/,}bin/{,iputils-}ping flags=(complain) {
  # Include base abstractions providing common file and library access.
  include <abstractions/base>
  
  # Include abstractions for console access.
  include <abstractions/consoles>
  
  # Include abstractions for DNS resolution and nameservice access.
  include <abstractions/nameservice>

  # Allow raw network capabilities.
  # net_raw: Used to construct ICMP packets.
  capability net_raw,
  # setuid: Allowed for privilege escalation if required by the binary (though ping usually doesn't need it in modern kernels, it's often included for compatibility).
  capability setuid,

  # Allow raw network access for IPv4 and IPv6.
  # ICMP packets are transmitted over raw sockets.
  network inet raw,
  network inet6 raw,

  # Read access for the ping binary and libraries.
  # 'mixr' allows mixed read and execute.
  /{,usr/}bin/{,iputils-}ping mixr,

  # Read access to module configuration.
  /etc/modules.conf r,

  # Read access to IPv6 disable status in procfs.
  @{PROC}/sys/net/ipv6/conf/all/disable_ipv6 r,

  # Site-specific additions and overrides.
  # Include local customizations for the ping profile if they exist.
  # @see /etc/apparmor.d/local/bin.ping
  include if exists <local/bin.ping>
}