# Megatools configuration file
# Generated by Ansible Jinja2 engine
#
# This configuration file controls authentication and general behavior
# for megatools, a command-line interface to the Mega.nz cloud storage service.
#
# Sections:
#   [login]   - Credentials for the Mega.nz account.
#   [settings]- Operational parameters such as cache timeout and client identification.

[login]
# Mega.nz account email address used for authentication.
# Schema field: email
email = {{ email | default('user@example.com') }}

# Mega.nz account password used for authentication.
# Schema field: password
password = {{ password | default('') }}

[settings]
# Session cache timeout in minutes.
# Megatools refreshes its session cache after this period of inactivity.
# Schema field: session_cache_timeout
session_cache_timeout = {{ session_cache_timeout | default(10) }}

# HTTP User-Agent string sent to Mega.nz servers.
# Schema field: user_agent
user_agent = {{ user_agent | default('Megatools/1.11.5') }}