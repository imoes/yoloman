{
  "bind_address": "127.0.0.1",
  "bind_port": 5353,
  "upstreams": [
    {
      "server": "https://dns.google/dns-query",
      "name": "Google DNS",
      "tls_servername": "dns.google"
    },
    {
      "server": "https://cloudflare-dns.com/dns-query",
      "name": "Cloudflare DNS",
      "tls_servername": "cloudflare-dns.com"
    }
  ],
  "log_level": "info",
  "log_file": "/var/log/curvedns/curvedns.log",
  "max_queries_per_client": 60,
  "ecs": false,
  "dnssec": true,
  "trust_anchor_file": "/etc/curvedns/root.ds",
  "timeout": 5,
  "cert_file": "/etc/curvedns/tls.crt",
  "key_file": "/etc/curvedns/tls.key",
  "sni_hostname": "dns.example.com",
  "ipv6": true,
  "rate_limit_burst": 40,
  "rate_limit_window": 30,
  "cache_size": 5000,
  "cache_min_ttl": 60,
  "cache_max_ttl": 3600,
  "hosts_file": [
    {
      "host": "printer.local",
      "ip": "192.168.1.42"
    },
    {
      "host": "nas.local",
      "ip": "192.168.1.10"
    }
  ]
}
