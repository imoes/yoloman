# ============================================================
# Curvedns Configuration Template
# This file configures the Curvedns DoH resolver service.
# It defines listening parameters, upstream resolvers, logging,
# security (TLS/DNSSEC), and caching behavior.
# ============================================================

# [bind_address] Local IP address on which to listen for incoming DNS queries
#   (e.g., '127.0.0.1' for localhost only, or '0.0.0.0' for all interfaces).
# [bind_port] Port number for the DoH resolver listener.
# Note: The bind directive expects an "address:port" string.
bind: "{{ ((bind_address | default('127.0.0.1')) + ':' + (bind_port | default(5353) | string)) }}"

# ============================================================
# Upstream DNS Resolvers
# List of upstream DNS resolvers to forward queries to.
# Supports DoH (HTTPS), DoT (TLS), or plain DNS.
# ============================================================
# [upstreams] List of upstream DNS resolvers. Each item is a map with 'server' (required)
#   and optional 'name', 'tls_servername', etc.
upstreams:
{% for upstream in (upstreams | default([{'server': 'https://dns.google/dns-query', 'name': 'Google DNS (DoH)'}])) %}
  # Upstream resolver
  - server: "{{ upstream.server | default('') }}"
{% if upstream.name is defined and upstream.name is not none %}
    name: "{{ upstream.name }}"
{% endif %}
{% if upstream.tls_servername is defined and upstream.tls_servername is not none %}
    # TLS server name for this upstream
    tls_servername: "{{ upstream.tls_servername }}"
{% endif %}
{% endfor %}

# ============================================================
# Logging Configuration
# ============================================================

# [log_level] Verbosity of logging: 'debug', 'info', 'warn', or 'error'.
log_level: "{{ log_level | default('info') }}"

# [log_file] Path to the log file. Set to empty string ('') to log to stdout.
log_file: "{{ log_file | default('/var/log/curvedns/curvedns.log') }}"

# ============================================================
# Client Limits & Abuse Prevention
# ============================================================

# [max_queries_per_client] Maximum queries allowed per client IP per second
#   (0 = unlimited). Helps prevent abuse.
max_queries_per_client: "{{ max_queries_per_client | default(100) }}"

# ============================================================
# DNS Features & Security
# ============================================================

# [ecs] Enable EDNS Client Subnet (ECS) support to pass client network
#   info to upstream resolvers.
ecs: {{ ecs | default(False) | lower }}

# [dnssec] Enable DNSSEC validation. Requires upstream support and a trust
#   anchor file.
dnssec: {{ dnssec | default(True) | lower }}

# [trust_anchor_file] Path to the root DS (Delegation Signer) records file,
#   used for DNSSEC validation.
trust_anchor_file: "{{ trust_anchor_file | default('/etc/curvedns/root.ds') }}"

# [timeout] Timeout (in seconds) for upstream DNS queries and HTTP connections.
timeout: "{{ timeout | default(10) }}"

# ============================================================
# TLS Configuration for DoH Endpoint
# ============================================================

# [cert_file] Path to the TLS certificate file (PEM format) for the DoH HTTPS endpoint.
cert_file: "{{ cert_file | default('/etc/curvedns/tls.crt') }}"

# [key_file] Path to the TLS private key file (PEM format, unencrypted).
key_file: "{{ key_file | default('/etc/curvedns/tls.key') }}"

# [sni_hostname] Optional SNI hostname for TLS. If omitted, defaults to bind_address.
sni_hostname: "{{ sni_hostname | default('') }}"

# [ipv6] Enable IPv6 support for upstream queries and client connections.
ipv6: {{ ipv6 | default(True) | lower }}

# ============================================================
# Rate Limiting
# ============================================================

# [rate_limit_burst] Maximum number of queries allowed in a burst before
#   rate limiting kicks in.
rate_limit_burst: "{{ rate_limit_burst | default(50) }}"

# [rate_limit_window] Time window (in seconds) for rate limiting calculations.
rate_limit_window: "{{ rate_limit_window | default(60) }}"

# ============================================================
# Caching Configuration
# ============================================================

# [cache_size] Maximum number of DNS responses to cache (0 = disable caching).
cache_size: "{{ cache_size | default(10000) }}"

# [cache_min_ttl] Minimum TTL (seconds) to cache a response (overrides low TTL values).
cache_min_ttl: "{{ cache_min_ttl | default(0) }}"

# [cache_max_ttl] Maximum TTL (seconds) to cache a response (overrides high TTL values).
cache_max_ttl: "{{ cache_max_ttl | default(86400) }}"

# ============================================================
# Static Host Overrides
# [hosts_file] Static hostname-to-IP mappings to override upstream resolution
#   (e.g., for local devices).
# Expected format: List of maps with 'host' and 'ip' keys.
hosts_file:
{% for entry in (hosts_file | default([])) %}
  # Host override
  - host: "{{ entry.host | default('') }}"
    ip: "{{ entry.ip | default('') }}"
{% endfor %}