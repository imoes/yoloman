{
  "server": {
    "type": "string",
    "default": "paste.grml.org",
    "description": "URL of the paste server"
  },
  "nickname": {
    "type": "string",
    "default": "unknown",
    "description": "Nickname to use for uploads (defaults to login username if not set)"
  },
  "lang": {
    "type": "string",
    "default": "text",
    "description": "Language identifier for syntax highlighting",
    "enum": [
      "text",
      "bash",
      "php",
      "html",
      "xml",
      "css",
      "shell",
      "powershell",
      "r",
      "v",
      "log",
      "apache",
      "dmesg",
      "systemd",
      "user",
      "news",
      "docker",
      "kvm",
      "docker",
      "kvm",
      "docker",
      "kvm"
    ]
  },
  "expire": {
    "type": "number",
    "default": 0,
    "description": "Time in hours after which paste expires (0 = never expires)"
  },
  "private": {
    "type": "bool",
    "default": false,
    "description": "Whether pastes should be private (hidden) by default"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Whether to enable more verbose output"
  }
}
