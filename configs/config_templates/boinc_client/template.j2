<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration file for BOINC client -->
<boinc>
{% if project_auth_files | length > 0 %}
<!-- List of project authentication files (for autorun projects) -->
  <project_auth_files>
{% for auth_file in project_auth_files %}    <file>{{ auth_file }}</file>
{% endfor %}  </project_auth_files>
{% endif %}
{% if use_http_proxy %}
<!-- Use HTTP proxy for network communication -->
  <http_proxy>
    <host>{{ http_proxy_host }}</host>
    <port>{{ http_proxy_port }}</port>
{% if http_proxy_username is defined and http_proxy_username != '' %}    <username>{{ http_proxy_username }}</username>
{% endif %}
{% if http_proxy_password is defined and http_proxy_password != '' %}    <password>{{ http_proxy_password }}</password>
{% endif %}  </http_proxy>
{% endif %}
{% if max_memory_percent is defined and max_memory_percent != '' %}
<!-- Limit BOINC memory usage to percentage of total system RAM -->
  <max_memory_percent>{{ max_memory_percent }}</max_memory_percent>
{% endif %}
{% if max_disk_percent is defined and max_disk_percent != '' %}
<!-- Limit BOINC disk usage to percentage of total disk space -->
  <max_disk_percent>{{ max_disk_percent }}</max_disk_percent>
{% endif %}
{% if max_disk_used is defined and max_disk_used != '' %}
<!-- Limit BOINC disk usage to absolute value in GB (overrides max_disk_percent) -->
  <max_disk_used>{{ max_disk_used }}</max_disk_used>
{% endif %}
{% if max_memory_in_use is defined and max_memory_in_use != '' %}
<!-- Limit BOINC memory usage to absolute value in MB (overrides max_memory_percent) -->
  <max_memory_in_use>{{ max_memory_in_use }}</max_memory_in_use>
{% endif %}
{% if cpu_time_limit is defined and cpu_time_limit != '' %}
<!-- Limit CPU time usage per day in minutes (0 = unlimited) -->
  <cpu_time_limit>{{ cpu_time_limit }}</cpu_time_limit>
{% endif %}
{% if suspend_cpu_usage is defined and suspend_cpu_usage != '' %}
<!-- Suspend computation if CPU usage exceeds this percentage -->
  <suspend_cpu_usage>{{ suspend_cpu_usage }}</suspend_cpu_usage>
{% endif %}
{% if network_suspend_days is defined and network_suspend_days != '' %}
<!-- Suspend network activity after this many days of inactivity -->
  <network_suspend_days>{{ network_suspend_days }}</network_suspend_days>
{% endif %}
{% if run_profiler is defined %}
<!-- Run profiler for benchmarking (boolean) -->
  <run_profiler>{{ '1' if run_profiler else '0' }}</run_profiler>
{% endif %}
{% if max_ncpus is defined and max_ncpus != '' %}
<!-- Maximum number of CPU cores to use for computation -->
  <max_ncpus>{{ max_ncpus }}</max_ncpus>
{% endif %}
{% if gpu_usage_limit is defined and gpu_usage_limit != '' %}
<!-- GPU usage limit as percentage (0–100) -->
  <gpu_usage_limit>{{ gpu_usage_limit }}</gpu_usage_limit>
{% endif %}
{% if gpu_only_when_idle is defined %}
<!-- Only use GPU when system is idle (boolean) -->
  <gpu_only_when_idle>{{ '1' if gpu_only_when_idle else '0' }}</gpu_only_when_idle>
{% endif %}
{% if sleep_interval is defined and sleep_interval != '' %}
<!-- Sleep interval in seconds between checks for work -->
  <sleep_interval>{{ sleep_interval }}</sleep_interval>
{% endif %}
{% if max_sleep_interval is defined and max_sleep_interval != '' %}
<!-- Maximum sleep interval in seconds when idle -->
  <max_sleep_interval>{{ max_sleep_interval }}</max_sleep_interval>
{% endif %}
{% if start_delay is defined and start_delay != '' %}
<!-- Delay before starting first job (in seconds) -->
  <start_delay>{{ start_delay }}</start_delay>
{% endif %}
{% if dont_verify_images is defined %}
<!-- Skip image verification (for testing only; not recommended in production) -->
  <dont_verify_images>{{ '1' if dont_verify_images else '0' }}</dont_verify_images>
{% endif %}
{% if use_all_gpus is defined %}
<!-- Use all detected GPUs for computation (boolean) -->
  <use_all_gpus>{{ '1' if use_all_gpus else '0' }}</use_all_gpus>
{% endif %}
{% if no_gpus is defined %}
<!-- Disable GPU support (boolean) -->
  <no_gpus>{{ '1' if no_gpus else '0' }}</no_gpus>
{% endif %}
{% if allow_remote_gui_rpc is defined %}
<!-- Allow GUI RPC from remote hosts (boolean) -->
  <allow_remote_gui_rpc>{{ '1' if allow_remote_gui_rpc else '0' }}</allow_remote_gui_rpc>
{% endif %}
{% if gui_rpc_port is defined and gui_rpc_port != '' %}
<!-- Port for GUI RPC interface (0 = auto) -->
  <gui_rpc_port>{{ gui_rpc_port }}</gui_rpc_port>
{% endif %}
{% if gui_rpc_password is defined and gui_rpc_password != '' %}
<!-- Password for GUI RPC authentication -->
  <gui_rpc_password>{{ gui_rpc_password }}</gui_rpc_password>
{% endif %}
{% if auth_domain_name is defined and auth_domain_name != '' %}
<!-- Domain name for authentication (optional, used in multi-machine setups) -->
  <auth_domain_name>{{ auth_domain_name }}</auth_domain_name>
{% endif %}
{% if core_client_only is defined %}
<!-- Run only the core client (no graphics) -->
  <core_client_only>{{ '1' if core_client_only else '0' }}</core_client_only>
{% endif %}
{% if checkpoint_freq is defined and checkpoint_freq != '' %}
<!-- Checkpoint every N seconds of CPU time -->
  <checkpoint_freq>{{ checkpoint_freq }}</checkpoint_freq>
{% endif %}
{% if max_file_xfers is defined and max_file_xfers != '' %}
<!-- Maximum simultaneous file transfers -->
  <max_file_xfers>{{ max_file_xfers }}</max_file_xfers>
{% endif %}
{% if max_file_xfers_per_project is defined and max_file_xfers_per_project != '' %}
<!-- Maximum simultaneous file transfers per project -->
  <max_file_xfers_per_project>{{ max_file_xfers_per_project }}</max_file_xfers_per_project>
{% endif %}
{% if min_file_xfers is defined and min_file_xfers != '' %}
<!-- Minimum number of file transfers to maintain -->
  <min_file_xfers>{{ min_file_xfers }}</min_file_xfers>
{% endif %}
{% if file_xfer_min_priority is defined and file_xfer_min_priority != '' %}
<!-- Minimum priority for file transfers -->
  <file_xfer_min_priority>{{ file_xfer_min_priority }}</file_xfer_min_priority>
{% endif %}
{% if scheduler_poll_min_interval is defined and scheduler_poll_min_interval != '' %}
<!-- Minimum interval between scheduler polls (in seconds) -->
  <scheduler_poll_min_interval>{{ scheduler_poll_min_interval }}</scheduler_poll_min_interval>
{% endif %}
{% if log_flags is defined %}
<!-- Enable logging of specific categories (list of strings) -->
  <log_flags>
{% for flag in log_flags %}    <{{ flag }}/>
{% endfor %}  </log_flags>
{% endif %}
{% if debug_flags is defined %}
<!-- Enable debug output for specific modules (list of strings) -->
  <debug_flags>
{% for flag in debug_flags %}    <{{ flag }}/>
{% endfor %}  </debug_flags>
{% endif %}
{% if default_project_preferences is defined %}
<!-- Default project preferences for new projects -->
  <default_project_preferences>
{% if default_project_preferences.run_on_batteries is defined %}    <run_on_batteries>{{ '1' if default_project_preferences.run_on_batteries else '0' }}</run_on_batteries>
{% endif %}
{% if default_project_preferences.run_if_user_active is defined %}    <run_if_user_active>{{ '1' if default_project_preferences.run_if_user_active else '0' }}</run_if_user_active>
{% endif %}
{% if default_project_preferences.max_jobs_run is defined %}    <max_jobs_run>{{ default_project_preferences.max_jobs_run }}</max_jobs_run>
{% endif %}
{% if default_project_preferences.dont_suspend_natively is defined %}    <dont_suspend_natively>{{ '1' if default_project_preferences.dont_suspend_natively else '0' }}</dont_suspend_natively>
{% endif %}
{% if default_project_preferences.network_usage_limit is defined %}    <network_usage_limit>{{ default_project_preferences.network_usage_limit }}</network_usage_limit>
{% endif %}
{% if default_project_preferences.day_of_week is defined %}    <day_of_week>{{ default_project_preferences.day_of_week }}</day_of_week>
{% endif %}
{% if default_project_preferences.start_time is defined %}    <start_time>{{ default_project_preferences.start_time }}</start_time>
{% endif %}
{% if default_project_preferences.end_time is defined %}    <end_time>{{ default_project_preferences.end_time }}</end_time>
{% endif %}
{% if default_project_preferences.start_day_of_week is defined %}    <start_day_of_week>{{ default_project_preferences.start_day_of_week }}</start_day_of_week>
{% endif %}
{% if default_project_preferences.end_day_of_week is defined %}    <end_day_of_week>{{ default_project_preferences.end_day_of_week }}</end_day_of_week>
{% endif %}
  </default_project_preferences>
{% endif %}
{% if coproc_config is defined %}
<!-- Explicit coprocessor (e.g., GPU) configuration -->
  <coproc_config>
{% for coproc in coproc_config %}    <coproc>
      <type>{{ coproc.type }}</type>
      <count>{{ coproc.count }}</count>
    </coproc>
{% endfor %}  </coproc_config>
{% endif %}
</boinc>