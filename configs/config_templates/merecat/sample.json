{
  "listen_address": "0.0.0.0",
  "port": 80,
  "root": "/var/www/merecat",
  "default_files": [
    "index.html",
    "index.htm"
  ],
  "max_connections": 256,
  "max_body_size": 10485760,
  "directory_listing": true,
  "ssl_enabled": true,
  "ssl_cert": "/etc/merecat/ssl/fullchain.pem",
  "ssl_key": "/etc/merecat/ssl/privkey.pem",
  "virtual_hosts": [
    {
      "name": "api.example.com",
      "root": "/var/www/api",
      "index_files": [],
      "ssl_cert": "/etc/ssl/api.example.com.crt",
      "ssl_key": "/etc/ssl/api.example.com.key"
    },
    {
      "name": "static.example.com",
      "root": "/var/www/static",
      "index_files": []
    }
  ],
  "mime_types": {
    "html": "text/html",
    "css": "text/css",
    "js": "application/javascript",
    "json": "application/json",
    "png": "image/png"
  },
  "access_log": "/var/log/merecat/access.log",
  "error_log": "/var/log/merecat/error.log"
}
