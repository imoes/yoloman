{# ============================================================================= #}
{# Template for dnsspoof hosts file                                          #}
{#                                                                              #}
{# dnsspoof is a network tool that intercepts DNS replies and can alter them.  #}
{# This file provides a mapping of domain names to IP addresses (typically      #}
{# 127.0.0.1 to block ads).                                                   #}
{#                                                                              #}
{# The format is: <IP_ADDRESS> <DOMAIN_PATTERN>                               #}
{# Patterns support wildcards (*) as used in the dnsspoof utility.            #}
{# ============================================================================= #}

{# --- Default/Static Block: Common Ad Domains --- #}
{# These entries are standard for blocking common ad networks and trackers. #}
{# They are included by default but can be overridden or replaced by the   #}
{# `dnsspoof_custom_entries` variable if provided.                         #}

{# Block generic ad-like prefixes in hostnames #}
127.0.0.1	ad.*
127.0.0.1	ads*.*
127.0.0.1	adbot*.*
127.0.0.1	adcount*.*
127.0.0.1	adfinity*.*
127.0.0.1	adforce*.*
127.0.0.1	adimage*.*
127.0.0.1	adlink*.*
127.0.0.1	adserv*.*
127.0.0.1	adremote*.*
127.0.0.1	adv.*
127.0.0.1	advert*.*
127.0.0.1	banner*.*
127.0.0.1	count*.*
127.0.0.1	promo*.*
127.0.0.1	werbung*.*

{# Block common ad/tracker domains by TLD pattern #}
127.0.0.1	*ads*.*.com
127.0.0.1	*.adbot.com
127.0.0.1	*.adone.com
127.0.0.1	*.adforce.com
127.0.0.1	*.ad-up.com
127.0.0.1	*.advert*.*
127.0.0.1	*.banner*.*
127.0.0.1	*.bfast.com
127.0.0.1	*.burstnet.com
127.0.0.1	*.doubleclick.net
127.0.0.1	*.focalink.com
127.0.0.1	*.flycast.com
127.0.0.1	*.freestats.com
127.0.0.1	*.hitbox.com
127.0.0.1	*.globaltrack.com
127.0.0.1	*.globaltrak.net
127.0.0.1	*.imagine-inc.com
127.0.0.1	*.imgis.com
127.0.0.1	*.link*.com
127.0.0.1	*.memory.net
127.0.0.1	*.preferences.com
127.0.0.1	*.smartclicks.com
127.0.0.1	*.sponsorpool.net
127.0.0.1	*.stats.net
127.0.0.1	*.stattrax.com
127.0.0.1	*.*tracker.com
127.0.0.1	*.valueclick.com
127.0.0.1	*.wisewire.com

{# --- Custom Entries Section --- #}
{# Users can append custom rules via the `dnsspoof_custom_entries` variable.  #}
{# Expected format for `dnsspoof_custom_entries`:                              #}
{#   [                                                #}
{#     {"ip": "127.0.0.1", "domain": "my-custom-ad.com"}, #}
{#     {"ip": "127.0.0.1", "domain": "*.tracker.net"}      #}
{#   ]                                               #}
{# If the variable is undefined or empty, no custom entries are added.      #}

{% if dnsspoof_custom_entries is defined and dnsspoof_custom_entries is iterable %}
{% for entry in dnsspoof_custom_entries %}
127.0.0.1	{{ entry.domain | default('*') }}
{% endfor %}
{% endif %}