# Enable/disable tracking of URLs visited
TrackURLEnabled=1

# Enable/disable tracking of hostnames (reverse DNS lookups)
TrackHostEnabled=0

# Enable/disable tracking of IP addresses
TrackIPEnabled=0

# Enable/disable tracking of user agents
TrackUserAgentEnabled=0

# Enable/disable tracking of operating systems
TrackOSEnabled=1

# Enable/disable tracking of browsers
TrackBrowserEnabled=1

# Enable/disable tracking of screen resolution (if client sends it via JS)
TrackScreenResolutionEnabled=0

# Enable/disable tracking of plugins
TrackPluginEnabled=0

# Enable/disable tracking of cookie support
