# AWStats configuration file - generated by template

# Log file to analyze (can be compressed or uncompressed)
LogFile="/var/log/apache2/access.log"

# Log format: 1 = combined (Apache), 2 = IIS, 3 = CLF, etc.
LogType=W
LogFormat=1

# Optional: log rotation support (AWStats handles multiple rotated files if path matches)
LogSeparator=" "

# Domain name(s) to analyze (comma-separated or space-separated)
SiteDomain="{{ site_domain }}"

# Host aliases (for virtual hosts or CNAMEs)
{% for alias in host_aliases %}HostAliases="{{ alias }}"
{% endfor %}

# Directory where AWStats stores its persistent data (database files)
DirData="/var/lib/awstats"

# Enable/disable dynamic page generation (requires web server CGI support)
AllowToUpdateStatsFromBrowser=1

# Enable/disable CGI execution (set to 0 for security if not using web interface)
AllowFullYearView=1

# Time zone adjustment (in hours from UTC)
TZ={{ timezone }}

# Language for output
Lang={{ language }}

# Enable/disable URL detection for external referrers
LoadDNSLib=0

# Enable/disable DNS lookups for unknown IP addresses (expensive!)
LoadDnsLib=0
DNSLookup=0

# Enable/disable detection of search engine keywords (requires search engine definitions)
EnableLockForUpdate=0

# Enable/disable URL redirection tracking
URLRedirectEnabled=0

# Enable/disable user tracking (cookies or IP-based)
TrackUserEnabled=0
TrackFileEnabled=0

# Enable/disable IP blocking (by default AWStats doesn't block IPs)
# You must define IP blocking rules via IPBlockFile or IPExcludeFile below

# File containing blacklisted/whitelisted IP addresses
# Use one IP or CIDR per line. Lines starting with # are comments.
IPBlockFile=""
IPExcludeFile=""

# File containing whitelisted hosts (only these will be counted)
# Hosts not matching will be ignored
IPIncludeFile=""

# Exclude URLs or URL patterns (regex, one per line, case-insensitive)
URLExclude=""
URLInclude=""

# Exclude files by extension (e.g., images, CSS, JS)
FileExclude="css|js|gif|jpg|jpeg|png|ico|bmp|tiff|wav|mp3|avi|mpg|mpeg|zip|gz"

# Include only files matching these extensions (overrides FileExclude if not empty)
FileInclude=""

# Exclude hostnames matching these patterns (regex, one per line)
HostExcluded=""

# Enable/disable detection of bots/crawlers
BotTrackEnabled=0

# Enable/disable detection of robots by user-agent (built-in patterns)
RobotsTrackEnabled=0

# Enable/disable detection of new vs. returning visitors
TrackNewUserEnabled=0

# Enable/disable detailed page view tracking
TrackPageViewEnabled=1

# Enable/disable tracking of downloads (by file extension)
TrackDownloadEnabled=1

# File types to treat as downloads
DownloadFileExt="pdf|doc|docx|xls|xlsx|rtf|ppt|pptx|odt|ods|odp|zip|tar|gz|bz2|7z|rpm|deb"

# Enable/disable tracking of HTTP errors (4xx/5xx status codes)
TrackHTTPErrorCodeEnabled=1

# Enable/disable tracking of SSL/TLS usage
TrackSSLUsageEnabled=0

# Enable/disable tracking of bandwidth usage
TrackBandwidthEnabled=1

# Enable/disable tracking of CPU load (if supported by OS — Linux only)
TrackLoadEnabled=0

# Enable/disable tracking of memory usage (Linux only)
TrackMemoryEnabled=0

# Enable/disable tracking of disk usage (Linux only)
TrackDiskEnabled=0

# Enable/disable tracking of network usage (Linux only)
TrackNetworkEnabled=0

# Enable/disable tracking of process counts (Linux only)
TrackProcessEnabled=0

# Enable/disable tracking of users per session (experimental)
TrackUserPerSessionEnabled=0

# Enable/disable tracking of sessions (by IP + user-agent + cookies)
TrackSessionEnabled=0

# Enable/disable tracking of page load time (requires JavaScript instrumentation)
TrackPageLoadTimeEnabled=0

# Enable/disable tracking of click paths (experimental)
TrackClickPathEnabled=0

# Enable/disable tracking of custom parameters (via URL query strings)
TrackCustomParamEnabled=0
TrackCustomParamList=""

# Enable/disable tracking of user agent types (desktop/mobile/app)
TrackUserAgentTypeEnabled=0

# Enable/disable tracking of referer spam
TrackRefererSpamEnabled=1

# Enable/disable tracking of search engine queries
TrackSearchEngineEnabled=1

# Enable/disable tracking of keywords (from search engines)
TrackKeywordsEnabled=1

# Enable/disable tracking of search engine names (Google, Bing, etc.)
TrackSearchEngineNameEnabled=1

# Enable/disable tracking of search engine keywords per engine
TrackSearchEngineKeywordPerEngineEnabled=0

# Enable/disable tracking of page titles
TrackPageTitleEnabled=1

# Enable/disable tracking of referrer URLs
