# Command-line options passed to the FreeRADIUS daemon at startup.
# This variable controls how the FreeRADIUS service is launched.
# Common values include:
#   -X      Debug mode (print all packets)
#   -d <dir> Set the directory for config files and modules
#   -A      Enable ACCT packets
#   -f      Run in foreground
#   -l <log> Set the log file destination (default: stdout/syslog)
#   -S <sock> Set the control socket path
#   -i <ip> Set the default IP address to listen on
#   -p <port> Set the default listening port
#
# Example usage in Ansible playbook:
#   freeradius_options: "-f -l /var/log/freeradius/radius.log"
FREERADIUS_OPTIONS="{{ FREERADIUS_OPTIONS | default('') }}"