{
  "log_file": "/var/log/freeradius/radius.log",
  "syslog_facility": "daemon",
  "log_stripped_names": false,
  "log_auth": true,
  "log_auth_badpass": false,
  "log_auth_goodpass": false,
  "run_user": "freerad",
  "run_group": "freerad",
  "core_dump": false,
  "pid_file": "/var/run/freeradius/freeradius.pid",
  "include_modules_dir": true,
  "include_sites_dir": true,
  "max_requests": 16384,
  "idle_timeout": 30,
  "auth_timeout": 4,
  "pkt_delay": 0,
  "max_clients_per_ip": 0,
  "enable_threads": true,
  "num_threads": 16,
  "shutdown_timeout": 5,
  "auth_ipaddr": [
    "10.0.0.10",
    "127.0.0.1"
  ],
  "auth_port": 1812,
  "acct_ipaddr": [
    "0.0.0.0"
  ],
  "acct_port": 1813,
  "interface": "",
  "max_auth_connections": 1024,
  "auth_idle_timeout": 30,
  "ssl_enabled": true,
  "ca_cert_path": "/etc/freeradius/3.0/certs/ca.pem",
  "server_cert_path": "/etc/freeradius/3.0/certs/server.pem",
  "server_key_path": "/etc/freeradius/3.0/certs/server.key",
  "dh_file_path": "/etc/freeradius/3.0/certs/dh",
  "cipher_list": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384",
  "min_tls_version": "1.2",
  "radius_clients": [
    {
      "name": "cisco-aaa",
      "ipaddr": "192.168.1.10",
      "secret": "s3cr3t_cisco_key_2024",
      "shortname": "cisco-1",
      "nastype": "cisco",
      "require_message_authenticator": true,
      "max_connections": 64,
      "idle_timeout": 60
    },
    {
      "name": "aruba-controller",
      "ipaddr": "10.20.30.0/24",
      "secret": "aruba-radius-secret",
      "shortname": "aruba-wlc",
      "nastype": "other",
      "require_message_authenticator": true,
      "max_connections": 128,
      "idle_timeout": 30
    }
  ]
}
