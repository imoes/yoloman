{% elif item.option == 'exclude-files' %}
exclude-files
{% elif item.option == 'min_size' %}
min_size {{ item.value | default('') }}
{% elif item.option == 'database' %}
database {{ item.value | default('~/.duc.db') }}
{% endif %}
{% endfor %}
{% endif %}

{% if (default_values | default({})).json is defined and (default_values | default({})).json | length > 0 %}
[json]
{% for item in (default_values | default({})).json %}
{% if item.option == 'apparent' %}
apparent
{% elif item.option == 'exclude-files' %}
exclude-files
{% elif item.option == 'min_size' %}
min_size {{ item.value | default('') }}
{% elif item.option == 'database' %}
database {{ item.value | default('~/.duc.db') }}
{% endif %}
{% endfor %}
{% endif %}

{% if (default_values | default({})).gui is defined and (default_values | default({})).gui | length > 0 %}
[gui]
{% for item in (default_values | default({})).gui %}
{% if item.option == 'apparent' %}
apparent
{% elif item.option == 'bytes' %}
bytes
{% elif item.option == 'count' %}
count
{% elif item.option == 'dark' %}
dark
{% elif item.option == 'fuzz' %}
fuzz {{ item.value | default(0.7) }}
{% elif item.option == 'gradient' %}
gradient
{% elif item.option == 'levels' %}
levels {{ item.value | default(4) }}
{% elif item.option == 'palette' %}
palette {{ item.value | default('size') }}
{% elif item.option == 'ring-gap' %}
