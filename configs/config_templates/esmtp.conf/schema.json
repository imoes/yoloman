{
  "smtp_host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address or hostname of the outbound SMTP relay server."
  },
  "smtp_port": {
    "type": "number",
    "default": 25,
    "description": "Port number of the outbound SMTP relay server."
  },
  "default_from": {
    "type": "string",
    "default": "root@localhost",
    "description": "Default 'From:' address used for outgoing messages."
  },
  "verbose": {
    "type": "boolean",
    "default": false,
    "description": "Enable verbose logging for debugging."
  },
  "tls_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Enable TLS for outbound connections (STARTTLS if supported)."
  },
  "tls_required": {
    "type": "boolean",
    "default": false,
    "description": "Require TLS; fail if server does not support it."
  },
  "tls_cafile": {
    "type": "string",
    "default": "",
    "description": "Path to CA certificate bundle for TLS verification."
  },
  "tls_ciphers": {
    "type": "string",
    "default": "",
    "description": "Colon-separated list of allowed TLS ciphersuites."
  },
  "routes": {
    "type": "list",
    "default": [],
    "description": "List of routing rules for domain/user-specific relays.",
    "items": {
      "type": "object",
      "fields": {
        "match": {
          "type": "string",
          "default": "for any",
          "description": "Match criteria (e.g., 'for domain', 'for user', 'for any')."
        },
        "domain": {
          "type": "string",
          "default": "",
          "description": "Domain to match (required if match includes 'domain')."
        },
        "user": {
          "type": "string",
          "default": "",
          "description": "Username to match (required if match includes 'user')."
        },
        "any": {
          "type": "boolean",
          "default": false,
          "description": "Match all mail (used when match is 'for any')."
        },
        "relay_host": {
          "type": "string",
          "default": "",
          "description": "Hostname or IP of the relay for this route."
        },
        "relay_port": {
          "type": "number",
          "default": 25,
          "description": "Port on the relay host."
        },
        "auth_user": {
          "type": "string",
          "default": "",
          "description": "Username for relay authentication (if required)."
        },
        "auth_pass": {
          "type": "string",
          "default": "",
          "description": "Password for relay authentication (if required)."
        },
        "tls_enabled": {
          "type": "boolean",
          "default": null,
          "description": "Override global TLS setting for this route (null = inherit)."
        }
      }
    }
  },
  "local_delivery_enabled": {
    "type": "boolean",
    "default": true,
    "description": "Enable local Maildir delivery under /var/mail."
  },
  "local_maildir_path": {
    "type": "string",
    "default": "/var/mail",
    "description": "Base path for local Maildir delivery (e.g., /var/mail)."
  },
  "aliases": {
    "type": "list",
    "default": [],
    "description": "List of alias mappings (local-to-local or local-to-external).",
    "items": {
      "type": "object",
      "fields": {
        "local_user": {
          "type": "string",
          "default": "",
          "description": "Local user whose mail to forward."
        },
        "to_user": {
          "type": "string",
          "default": "",
          "description": "Local destination user (if forwarding locally)."
        },
        "to_external": {
          "type": "string",
          "default": "",
          "description": "External email address (e.g., user@example.com)."
        }
      }
    }
  },
  "auth_backend": {
    "type": "object",
    "default": null,
    "description": "External authentication backend (e.g., 'passwd', 'ldap').",
    "items": {
      "type": "object",
      "fields": {
        "type": {
          "type": "string",
          "default": "",
          "description": "Backend type (e.g., 'passwd', 'ldap')."
        },
        "options": {
          "type": "object",
          "default": {},
          "description": "Key\u2013value options for the backend (e.g., {'file': '/etc/passwd'})."
        }
      }
    }
  }
}
