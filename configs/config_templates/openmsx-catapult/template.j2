# Configuration for openmsx-catapult
# See /usr/share/doc/openmsx-catapult/manual for detailed documentation

# Root directory for ROMs and cart images
rom_path = "{{ (values | default({})).rom_path | default('/usr/share/openmsx') }}"

# Default audio output device (e.g., 'alsa', 'pulse', 'oss')
audio_device = "{{ (values | default({})).audio_device | default('pulse') }}"

# Master volume level (0-100)
volume = {{ (values | default({})).volume | default(80) }}

# Enable windowed mode instead of fullscreen
windowed = {{ (values | default({})).windowed | default(false) | lower }}

# X11 display ID for graphical output
display = "{{ (values | default({})).display | default(':0') }}"