{
  "quiet": true,
  "load": [
    "/var/log/apache2/access.log",
    "/var/log/apache2/access*.gz"
  ],
  "execute": "SELECT source, COUNT(id) AS cnt FROM logs GROUP BY source ORDER BY cnt DESC LIMIT 10;",
  "input_file": "/etc/asql/queries.sql",
  "save_db": "/var/cache/asql/apache.db",
  "restore_db": "/var/cache/asql/apache.db"
}
