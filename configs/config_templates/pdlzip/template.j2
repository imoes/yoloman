# ==============================================================================
# Pdlzip Configuration File
# ==============================================================================
# This file is generated by Ansible using a Jinja2 template.
# It configures the behavior of the `pdlzip` utility for compression tasks.
#
# Pdlzip is a compression tool similar to zip/unzip but optimized for
# specific use cases. This configuration covers default behavior for
# compression levels, dictionary sizes, file handling, and verbosity.
# ==============================================================================

# ------------------------------------------------------------------------------
# Section: General Compression Settings
# ------------------------------------------------------------------------------

# Default compression level (0-9, where 0 is fastest, 9 is best compression).
# Corresponds to pdlzip -0 through -9.
# 0: Fastest compression, lowest ratio.
# 9: Slowest compression, best ratio.
DEFAULT_COMPRESSION_LEVEL={{ default_compression_level | default(6) }}

# Default dictionary size in bytes (12-27 for powers of 2, or explicit byte value).
# Corresponds to pdlzip -s, --dictionary-size. Default 8 MiB.
# Larger dictionaries can improve compression ratios for large files but use more memory.
DEFAULT_DICTIONARY_SIZE={{ dictionary_size | default(8388608) }}

# Default match length limit in bytes.
# Corresponds to pdlzip -m, --match-length. Default 36 bytes.
# Limits how long a repeating sequence must be to be considered for compression.
DEFAULT_MATCH_LENGTH={{ match_length | default(36) }}

# ------------------------------------------------------------------------------
# Section: File Handling
# ------------------------------------------------------------------------------

# Keep input files after compression/decompression.
# Corresponds to pdlzip -k, --keep.
# If true, the original files are not deleted after processing.
# If false, they are removed (standard behavior for many compression tools).
{% if keep_input_files | default(false) | bool %}
DEFAULT_KEEP_FILES=true
{% else %}
DEFAULT_KEEP_FILES=false
{% endif %}

# Default output directory for compressed files.
# Corresponds to pdlzip -o, --output.
# Files will be written to this directory if not specified otherwise on the command line.
DEFAULT_OUTPUT_DIRECTORY={{ output_directory | default('/var/lib/pdlzip/outputs') | string }}

# ------------------------------------------------------------------------------
# Section: Logging and Verbosity
# ------------------------------------------------------------------------------

# Verbosity level (0-2, where 0 is quiet, 1 is normal, 2 is very verbose).
# Corresponds to pdlzip -v, --verbose.
# 0: No output.
# 1: Standard status messages.
# 2: Detailed debugging information.
DEFAULT_VERBOSE_LEVEL={{ verbose_level | default(0) }}

# Suppress all output messages.
# Corresponds to pdlzip -q, --quiet.
# Overrides verbose_level. If true, nothing is printed to stdout/stderr unless there is an error.
{% if quiet_mode | default(false) | bool %}
DEFAULT_QUIET_MODE=true
{% else %}
DEFAULT_QUIET_MODE=false
{% endif %}

# Exit with error status if trailing data is present.
# Corresponds to pdlzip -a, --trailing-error.
# If true, the tool will report an error if it detects data after the end of the archive/file.
{% if trailing_error | default(false) | bool %}
DEFAULT_TRAILING_ERROR=true
{% else %}
DEFAULT_TRAILING_ERROR=false
{% endif %}

# Allow trailing data seeming corrupt header.
# Corresponds to pdlzip --loose-trailing.
# If true, pdlzip will attempt to process the file even if it detects trailing data that looks
# like a corrupt header, potentially ignoring it. Useful for partially corrupted archives.
{% if loose_trailing | default(false) | bool %}
DEFAULT_LOOSE_TRAILING=true
{% else %}
DEFAULT_LOOSE_TRAILING=false
{% endif %}

# ------------------------------------------------------------------------------
# Section: File List
# ------------------------------------------------------------------------------

# List of files to compress.
# Corresponds to pdlzip [files]. Each item is a file path.
# If this list is empty, pdlzip may use standard input or a default set of files depending
# on invocation context.
{% if files_to_compress | default([]) | length > 0 %}
{% for file in files_to_compress %}
FILE_{{ loop.index }}={{ file | string }}
{% endfor %}
{% endif %}