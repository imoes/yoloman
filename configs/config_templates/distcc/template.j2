# ============================================================================
# distccd Configuration Template
# ============================================================================
# This configuration file controls the behavior of the distccd distributed
# compilation daemon. It defines access control, logging, and runtime
# parameters.
#
# See: man distccd
# ============================================================================

# ----------------------------------------------------------------------------
# Access Control: Allowed Clients
# ----------------------------------------------------------------------------
# Description: List of client networks/IPs (CIDR or single IP) allowed to connect.
#
# The distccd daemon uses this list to whitelist incoming connections.
# Unauthorized connections are rejected immediately.
#
# IMPORTANT: Only allow trusted hosts. Any user on a trusted host can execute
# commands as the distccd user.
# ----------------------------------------------------------------------------

# Format: One IP or CIDR range per line.
# Example:
#   192.168.1.100
#   192.168.2.0/24

{% for client in allowed_clients | default(['127.0.0.0/8', '::1']) %}{{ client }}
{% endfor %}

# ----------------------------------------------------------------------------
# Daemon Runtime Arguments (Systemd/sysconfig)
# ----------------------------------------------------------------------------
# Description: This section generates the command-line arguments passed to
# the distccd service. These arguments typically go into /etc/sysconfig/distccd
# (RHEL/CentOS/Fedora) or a systemd drop-in unit file.

# Bind Address
# Description: Network interface or IP to bind the daemon to.
# Default: 0.0.0.0 (Listen on all interfaces)
# Directive: -N <address> (or passed via systemd ExecStart)
DISTCC_ARGS="${DISTCC_ARGS} -N {{ listen | default('0.0.0.0') }}"

# Max Jobs
# Description: Maximum number of parallel compilation jobs the server will accept.
# Default: 8
# Directive: -j <number>
DISTCC_ARGS="${DISTCC_ARGS} -j {{ max_jobs | default(8) }}"

# Warm Jobs
# Description: Number of idle worker processes to keep warm for faster response.
# Default: 2
# Directive: -w <number>
DISTCC_ARGS="${DISTCC_ARGS} -w {{ warm_jobs | default(2) }}"

# Log Level
# Description: Log verbosity (0 = silent, 1 = errors only, 2 = warnings, 3 = info, 4 = debug).
# Default: 2 (Warnings)
# Directive: -L <level>
DISTCC_ARGS="${DISTCC_ARGS} -L {{ log_level | default(2) }}"

# Log File
# Description: Path to the log file.
# Default: /var/log/distcc/distccd.log
# Directive: --log-file <path>
DISTCC_ARGS="${DISTCC_ARGS} --log-file {{ log_file | default('/var/log/distcc/distccd.log') }}"

# PID File
# Description: Path to the PID file used for daemon management.
# Default: /var/run/distccd.pid
# Directive: --pid-file <path>
DISTCC_ARGS="${DISTCC_ARGS} --pid-file {{ pid_file | default('/var/run/distccd.pid') }}"

# Standalone Mode
# Description: Whether to start distccd as a standalone daemon (required for server mode).
# Default: False
# Directive: --standalone
{% if enable_standalone | default(False) | bool %}DISTCC_ARGS="${DISTCC_ARGS} --standalone"{% endif %}

# Transparent Mode
# Description: Enable transparent mode (distcc automatically falls back to local compilation if remote jobs fail).
# Default: False
# Directive: --allow-transparency
{% if enable_transparent | default(False) | bool %}DISTCC_ARGS="${DISTCC_ARGS} --allow-transparency"{% endif %}

# Disable Insecure Features
# Description: Disable insecure legacy features like IPv6 fallback and RFC 2553 compatibility for production safety.
# Default: True
# Directive: --disable-insecure
{% if disable_insecure | default(True) | bool %}DISTCC_ARGS="${DISTCC_ARGS} --disable-insecure"{% endif %}

# Extra Arguments
# Description: Additional command-line arguments passed to distccd.
# Default: '' (Empty)
{% if extra_args | default('') | trim != '' %}DISTCC_ARGS="${DISTCC_ARGS} {{ extra_args | default('') }}"{% endif %}

# ----------------------------------------------------------------------------
# Final Command Construction
# ----------------------------------------------------------------------------
# This variable is intended to be sourced by the init script or systemd unit.
# The --allow option is handled via the /etc/distcc/clients file (above).
# ----------------------------------------------------------------------------

# Export the final arguments string for the service manager
export DISTCC_ARGS
