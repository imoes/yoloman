{
  "auth_lua_enabled": {
    "type": "bool",
    "default": {},
    "description": "Enable Lua authentication plugin"
  },
  "auth_lua_script_path": {
    "type": "string",
    "default": {},
    "description": "Absolute path to the Lua authentication script"
  },
  "auth_lua_params": {
    "type": "list",
    "default": {},
    "description": "List of key-value parameters passed to the Lua script as environment variables"
  },
  "mail_location": {
    "type": "string",
    "default": {},
    "description": "Mailbox storage format and path"
  },
  "namespaces": {
    "type": "list",
    "default": {},
    "description": "Mail namespace definitions"
  },
  "auth_mechanisms": {
    "type": "list",
    "default": {},
    "description": "SASL authentication mechanisms to offer to clients"
  },
  "ssl_mode": {
    "type": "string",
    "default": {},
    "description": "SSL/TLS behavior: 'yes', 'optional', 'no', or 'required'"
  },
  "ssl_cert": {
    "type": "string",
    "default": {},
    "description": "Path to SSL certificate"
  },
  "ssl_key": {
    "type": "string",
    "default": {},
    "description": "Path to SSL private key"
  },
  "log_path": {
    "type": "string",
    "default": {},
    "description": "Log destination: file path or 'syslog'"
  },
  "log_timestamp_format": {
    "type": "string",
    "default": {},
    "description": "Format for log timestamps"
  },
  "first_valid_uid": {
    "type": "number",
    "default": {},
    "description": "Minimum UID allowed for mail access"
  },
  "mail_uid": {
    "type": "number",
    "default": {},
    "description": "System UID for mail process"
  },
  "mail_gid": {
    "type": "number",
    "default": {},
    "description": "System GID for mail process"
  },
  "protocols": {
    "type": "list",
    "default": {},
    "description": "Enabled protocols"
  },
  "allow_nets": {
    "type": "list",
    "default": {},
    "description": "Allowed client IP ranges for login"
  },
  "disable_plaintext_auth": {
    "type": "bool",
    "default": {},
    "description": "Reject plaintext auth unless TLS is active"
  },
  "mail_max_userip_connections": {
    "type": "number",
    "default": {},
    "description": "Max concurrent IMAP connections per user/IP"
  },
  "mail_plugins": {
    "type": "list",
    "default": {},
    "description": "Extra mail plugins to load"
  },
  "auth_cache_size": {
    "type": "number",
    "default": {},
    "description": "Auth result cache size (0 = disable caching)"
  },
  "auth_lua_fallback": {
    "type": "bool",
    "default": {},
    "description": "Include commented fallback config"
  },
  "services": {
    "type": "list",
    "default": {},
    "description": "Service definitions for login daemons"
  }
}
