{
  "auth_lua_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable Lua authentication plugin (required for Lua-based auth)"
  },
  "auth_lua_script_path": {
    "type": "string",
    "default": "/etc/dovecot/auth-lua.lua",
    "description": "Absolute path to the Lua authentication script"
  },
  "auth_lua_params": {
    "type": "list",
    "default": [],
    "description": "List of key-value parameters passed to the Lua script as environment variables",
    "items": {
      "name": {
        "type": "string",
        "description": "Parameter name (e.g., 'DB_HOST')"
      },
      "value": {
        "type": "string",
        "description": "Parameter value"
      }
    }
  },
  "mail_location": {
    "type": "string",
    "default": "maildir:~/Maildir",
    "description": "Mailbox storage format and path (see Dovecot wiki for formats)"
  },
  "namespaces": {
    "type": "list",
    "default": [
      {
        "name": "inbox",
        "type": "private",
        "prefix": "INBOX.",
        "separator": ".",
        "location": "maildir:~/Maildir",
        "description": "Default private namespace for user INBOX"
      }
    ],
    "description": "Mail namespace definitions (IMAP folders, prefixes)",
    "items": {
      "name": {
        "type": "string",
        "description": "Namespace name (e.g., 'inbox', 'shared')"
      },
      "type": {
        "type": "string",
        "enum": [
          "private",
          "public",
          "shared"
        ],
        "default": "private",
        "description": "Namespace visibility type"
      },
      "prefix": {
        "type": "string",
        "default": "INBOX.",
        "description": "Folder prefix (e.g., 'INBOX.' or 'shared/'"
      },
      "separator": {
        "type": "string",
        "default": ".",
        "description": "Hierarchy separator character"
      },
      "location": {
        "type": "string",
        "default": "maildir:~/Maildir",
        "description": "Mailbox location (overrides global mail_location if set)"
      },
      "description": {
        "type": "string",
        "default": "User inbox namespace",
        "description": "Human-readable description for documentation"
      }
    }
  },
  "auth_mechanisms": {
    "type": "list",
    "default": [
      "plain",
      "login"
    ],
    "description": "SASL authentication mechanisms to offer to clients",
    "items": {
      "type": "string",
      "enum": [
        "plain",
        "login",
        "cram-md5",
        "digest-md5",
        "gssapi",
        "external",
        "anonymous"
      ],
      "description": "Supported SASL mechanism"
    }
  },
  "ssl_mode": {
    "type": "string",
    "default": "required",
    "description": "SSL/TLS behavior: 'yes', 'optional', 'no', or 'required'"
  },
  "ssl_cert": {
    "type": "string",
    "default": "/etc/ssl/certs/dovecot.pem",
    "description": "Path to SSL certificate (must be readable by dovecot user)"
  },
  "ssl_key": {
    "type": "string",
    "default": "/etc/ssl/private/dovecot.pem",
    "description": "Path to SSL private key (must be readable by dovecot user)"
  },
  "log_path": {
    "type": "string",
    "default": "syslog",
    "description": "Log destination: file path or 'syslog'"
  },
  "log_timestamp_format": {
    "type": "string",
    "default": "%b %d %H:%M:%S",
    "description": "Format for log timestamps (POSIX strftime format)"
  },
  "first_valid_uid": {
    "type": "number",
    "default": 1000,
    "description": "Minimum UID allowed for mail access"
  },
  "mail_uid": {
    "type": "number",
    "default": 5000,
    "description": "System UID for mail process (e.g., vmail user)"
  },
  "mail_gid": {
    "type": "number",
    "default": 5000,
    "description": "System GID for mail process"
  },
  "protocols": {
    "type": "list",
    "default": [
      "imap",
      "pop3"
    ],
    "description": "Enabled protocols (e.g., ['imap', 'pop3', 'lmtp']",
    "items": {
      "type": "string",
      "enum": [
        "imap",
        "pop3",
        "lmtp",
        "managesieve",
        "lda"
      ],
      "description": "Protocol name"
    }
  },
  "allow_nets": {
    "type": "list",
    "default": [
      "127.0.0.0/8",
      "::1/128"
    ],
    "description": "Allowed client IP ranges for login (without SSL/TLS)",
    "items": {
      "type": "string",
      "description": "CIDR notation or IP range"
    }
  },
  "disable_plaintext_auth": {
    "type": "bool",
    "default": true,
    "description": "Reject plaintext auth unless TLS is active (strongly recommended)"
  },
  "mail_max_userip_connections": {
    "type": "number",
    "default": 20,
    "description": "Max concurrent IMAP connections per user/IP (prevent abuse)"
  },
  "mail_plugins": {
    "type": "list",
    "default": [
      "imap_quota",
      "acl"
    ],
    "description": "Extra mail plugins to load (e.g., 'imap_quota', 'fts', 'sieve')",
    "items": {
      "type": "string",
      "description": "Plugin name"
    }
  },
  "auth_cache_size": {
    "type": "number",
    "default": 1024,
    "description": "Auth result cache size (0 = disable caching)"
  },
  "auth_lua_fallback": {
    "type": "bool",
    "default": false,
    "description": "Include commented fallback config (for development/testing)"
  },
  "services": {
    "type": "list",
    "default": [
      {
        "name": "imap-login",
        "login_mode": "0600",
        "login_user": "dovecot",
        "login_group": "dovecot",
        "process_limit": 10
      },
      {
        "name": "pop3-login",
        "login_mode": "0600",
        "login_user": "dovecot",
        "login_group": "dovecot",
        "process_limit": 10
      }
    ],
    "description": "Service definitions for login daemons",
    "items": {
      "name": {
        "type": "string",
        "enum": [
          "imap-login",
          "pop3-login",
          "lmtp"
        ],
        "description": "Dovecot service name"
      },
      "login_mode": {
        "type": "string",
        "default": "0600",
        "description": "Unix socket permission (octal)"
      },
      "login_user": {
        "type": "string",
        "default": "dovecot",
        "description": "Unix user for login process"
      },
      "login_group": {
        "type": "string",
        "default": "dovecot",
        "description": "Unix group for login process"
      },
      "process_limit": {
        "type": "number",
        "default": 10,
        "description": "Max number of login processes (0 = no limit)"
      }
    }
  }
}
