{
 "allow_nets": [
  "127.0.0.0/8",
  "10.0.0.0/8"
 ],
 "auth_cache_size": 2048,
 "auth_lua_enabled": true,
 "auth_lua_fallback": false,
 "auth_lua_params": [
  {
   "name": "DB_HOST",
   "value": "localhost"
  },
  {
   "name": "DB_USER",
   "value": "mailuser"
  },
  {
   "name": "DB_NAME",
   "value": "mailauth"
  },
  {
   "name": "DB_PASS",
   "value": "secret123"
  }
 ],
 "auth_lua_script_path": "/etc/dovecot/lua-auth.lua",
 "auth_mechanisms": [
  "plain",
  "login"
 ],
 "disable_plaintext_auth": true,
 "first_valid_uid": 1000,
 "log_path": "/var/log/dovecot.log",
 "log_timestamp_format": "%Y-%m-%d %H:%M:%S",
 "mail_gid": 5000,
 "mail_location": "maildir:~/Maildir",
 "mail_max_userip_connections": 15,
 "mail_plugins": [
  "imap_quota",
  "acl",
  "sieve"
 ],
 "mail_uid": 5000,
 "namespaces": [
  {
   "description": "User’s main mailbox",
   "location": "maildir:~/Maildir",
   "name": "inbox",
   "prefix": "INBOX.",
   "separator": ".",
   "type": "private"
  }
 ],
 "protocols": [
  "imap",
  "pop3"
 ],
 "services": [
  {
   "login_group": "dovecot",
   "login_mode": "0600",
   "login_user": "dovecot",
   "name": "imap-login",
   "process_limit": 16
  },
  {
   "login_group": "dovecot",
   "login_mode": "0600",
   "login_user": "dovecot",
   "name": "pop3-login",
   "process_limit": 8
  }
 ],
 "ssl_cert": "/etc/letsencrypt/live/mail.example.com/fullchain.pem",
 "ssl_key": "/etc/letsencrypt/live/mail.example.com/privkey.pem",
 "ssl_mode": "required"
}
