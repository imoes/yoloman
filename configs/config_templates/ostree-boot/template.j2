# ==============================================================================
# ostree-boot configuration fragment (dracut)
# ==============================================================================
# This file is consumed by dracut to augment the initramfs image used for
# ostree-based systems. It controls which dracut modules are loaded and whether
# build artifacts are stripped for reproducibility.

# Space-separated list of dracut modules to add for ostree boot support.
# Common modules include 'ostree', 'systemd', 'network', etc.
# Default: 'ostree systemd ' (note the trailing space is safe for concatenation)
add_dracutmodules+=" {{ ostree_dracut_modules | default('ostree systemd ') }} "

# Whether to enable reproducible build settings.
# When true, dracut attempts to produce bit-identical initramfs images
# across builds given the same inputs. This aids in auditing and verification.
# Default: true
reproducible={{ ostree_reproducible | default(true) | lower }}