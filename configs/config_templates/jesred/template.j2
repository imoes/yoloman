# ===========================================================================
# Jesred Configuration Template
#
# This template configures Jesred, a Squid ACL-based URL rewriting tool.
# It manages ACL paths, rewrite rules, logging, and debug modes.
# All variables use defaults defined in the schema to ensure self-containment.
# ===========================================================================

# allow_acl_path: Path to the ACL file containing IP addresses for which URL
# rewriting is allowed or denied.
# Default: /etc/jesred.acl
allow = {{ allow_acl_path | default('/etc/jesred.acl') }}

# rules_path: Path to the main rules file for URL rewriting.
# Default: /etc/jesred.rules
rules = {{ rules_path | default('/etc/jesred.rules') }}
#rules = /usr/share/doc/jesred/jesred.bofh.rules

# redirect_log_path: Path to the log file for general, error, and debug messages.
# Setting this to an empty value or commenting it out disables logging.
# Note: Depending on your Squid variant, the directory might need to be
# changed to /var/log/squid3.
# Default: /var/log/squid/jesred-redirect.log
redirect_log = {{ redirect_log_path | default('/var/log/squid/jesred-redirect.log') }}

# log file for URL rewrites (empty value or commenting this out disables
# logging of URL rewrites)
# Log file format: Timestamp Client/Ident URL RURL NO
# rewrite_log = /var/log/squid/jesred-rewrite.log

# debug_mode: Enable debug logging if the DEBUG option was compiled in.
# Accepts boolean or truthy string values. If unset or None, debug is disabled.
# Default: None (disabled)
{% if debug_mode | default(None) is not none %}
{% set debug_val = debug_mode | default(None) | lower %}
debug = {{ debug_val }}
{% else %}
#debug = true
{% endif %}