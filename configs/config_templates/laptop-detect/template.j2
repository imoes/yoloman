# /etc/default/laptop-detect
# Configuration file for laptop-detect utility.
# This file allows setting default behavior or overrides, though laptop-detect
# primarily relies on runtime detection via /sys and /proc.

# Enable verbose output by default if this script is invoked directly.
# Corresponds to the -v/--verbose flag.
# Schema field: verbose (default=False)
VERBOSE="{{ verbose | default(false, true) }}"

# Enable debug mode for detailed diagnostics.
# Corresponds to the -D/--debug flag.
# Schema field: debug (default=False)
DEBUG="{{ debug | default(false, true) }}"

# List of subsystems or paths to explicitly check or ignore.
# If empty, default system paths (/sys/devices/virtual/dmi/id/chassis_type, etc.) are used.
# Corresponds to standard detection logic, parametric for specific hardware quirks.
# Schema field: paths (default=[])
CHECK_PATHS="{{ paths | default([], true) | join(' ') }}"