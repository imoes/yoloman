# AppArmor profile for ibus-engine-hangul
#
# This profile enforces mandatory access control on the IBUS Hangul
# input method engine. It allows the engine to read its data files,
# schemas, and communicate via D-Bus and dconf, while restricting
# other filesystem and system interactions.
#
# See the package schema for any tunable parameters (none defined).

#include <tunables/global>

/usr/libexec/ibus-engine-hangul flags=(complain) {
    # Include standard base abstractions for system libraries and files
    #include <abstractions/base>
    
    # Include D-Bus session abstraction to allow inter-process communication
    # on the user session bus.
    #include <abstractions/dbus-session-strict>
    
    # Include libhangul abstraction if available, allowing access to
    # Hangul processing library resources.
    #include <abstractions/libhangul1>

    # Allow reading Hangul input method data files installed by ibus-hangul.
    /usr/share/ibus-hangul/** r,

    # Allow reading IBUS keymap files required for input method switching.
    /usr/share/ibus/keymaps/* r,

    # Allow reading GLib schema compilation file for configuration.
    /usr/share/glib-2.0/schemas/gschemas.compiled r,

    # Allow read/write access to the IBUS bus cache and configuration
    # directories in the user's home directory.
    owner @{HOME}/.{cache,config}/ibus/bus/ rw,
    owner @{HOME}/.{cache,config}/ibus/bus/* rw,

    # Allow read/write access to the dconf database and user settings
    # required for persisting IBUS configuration.
    owner /{,var/}run/user/*/dconf/user rw,
    owner @{HOME}/.config/dconf/user rw,

    # Allow execution of the main ibus binary, which is often used to
    # query engine status or trigger restarts.
    /usr/bin/ibus PUx,

    # Allow reading the process file descriptors to introspect the
    # current process environment or open files.
    @{PROC}/@{pid}/fd/ r,

    # Allow receiving signal messages from the ibus-daemon. This is
    # required for the daemon to gracefully stop the engine process.
    signal (receive) set=("term") peer=/usr/bin/ibus-daemon,
}
