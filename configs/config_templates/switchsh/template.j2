# Switchsh configuration wrapper
# Executes command with bash as /bin/sh via bind-mount.
#
# The primary command to execute. switchsh bind-mounts bash as /bin/sh for this command.
{{ command | default('/usr/bin/env bash -l') }}

# Arguments for the command
# List of arguments to pass to the command. This allows using bashisms within the context of the command execution.
{% for arg in (arguments | default([])) %}
# {{ arg }}
{{ arg }}
{% endfor %}