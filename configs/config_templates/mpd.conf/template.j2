{# ============================================================================ #}
{# Music Player Daemon (MPD) configuration file                                 #}
{# Generated by Ansible Jinja2 template.                                        #}
{# This template is self-documenting: every directive is preceded by its schema #}
{# description and uses safe defaults for all variables.                        #}
{# ============================================================================ #}

{# Core filesystem paths for MPD databases, logs, music, and state files.       #}
{# The 'paths' mapping must contain the required keys: db, log, playlists,      #}
{# pid, passwords, music, sticker, socket.                                      #}
{# Using dict2items to safely iterate the paths mapping without Python methods. #}
{% set paths_map = (paths | default({'db': '/var/lib/mpd/database', 'log': '/var/log/mpd/mpd.log', 'playlists': '/var/lib/mpd/playlists', 'pid': '/run/mpd.pid', 'passwords': '/etc/mpd.password', 'music': '/var/lib/mpd/music', 'sticker': '/var/lib/mpd/sticker.sql', 'socket': '/run/mpd.sock'})) %}
{% for path_item in paths_map | dict2items %}
{%- if path_item.key == 'db' %}
{# Database file path. #}
db_file            "{{ path_item.value | default('/var/lib/mpd/database') }}"
{%- elif path_item.key == 'log' %}
{# Log file path. #}
log_file           "{{ path_item.value | default('/var/log/mpd/mpd.log') }}"
{%- elif path_item.key == 'playlists' %}
{# Playlist directory path. #}
playlist_directory "{{ path_item.value | default('/var/lib/mpd/playlists') }}"
{%- elif path_item.key == 'pid' %}
{# PID file path. #}
pid_file           "{{ path_item.value | default('/run/mpd.pid') }}"
{%- elif path_item.key == 'passwords' %}
{# Password file path. #}
password_file      "{{ path_item.value | default('/etc/mpd.password') }}"
{%- elif path_item.key == 'music' %}
{# Music directory path. #}
music_directory    "{{ path_item.value | default('/var/lib/mpd/music') }}"
{%- elif path_item.key == 'sticker' %}
{# Sticker database file path. #}
sticker_file       "{{ path_item.value | default('/var/lib/mpd/sticker.sql') }}"
{%- elif path_item.key == 'socket' %}
{# Socket file path. #}
# socket_file      "{{ path_item.value | default('/run/mpd.sock') }}"
{%- endif %}
{% endfor %}

{# --- Network configuration -------------------------------------------------- #}
{# TCP port for MPD client connections.                                         #}
port               {{ port | default(6600) }}

{# Network interface to bind MPD to (e.g., 127.0.0.1 for local-only, or       #}
{# 0.0.0.0 for all interfaces).                                               #}
bind_address        "{{ bind_address | default('0.0.0.0') }}"

{# Enable Unix socket for local client connections (overrides TCP port if      #}
{# enabled).                                                                  #}
{# If use_socket is true but no socket_path is provided, falls back to the    #}
{# standard socket location in the paths dict.                                #}
{% if use_socket | default(False) | bool %}
{# Path to the Unix socket file (used only if use_socket is true).            #}
socket              "{{ socket_path | default((paths | default({})).get('socket', '/run/mpd.sock') | default('/run/mpd.sock')) }}"
{% endif %}

{# --- Audio Outputs ---------------------------------------------------------- #}
{# List of audio output devices (e.g., ALSA, PipeWire, PulseAudio).             #}
{# Each item in the list configures one output block.                         #}
{% for output in audio_outputs | default([{'type': 'alsa', 'name': 'My ALSA Device', 'device': 'default', 'format': '44100:16:2', 'samplerate_converter': 'soxr_medium', 'autosuspend': 'no'}]) %}
audio_output {
  {# Audio output type (e.g., 'alsa', 'pipewire', 'pulse'). #}
  type        "{{ output.type | default('alsa') }}"
  {# Name of the audio output device (used by clients to identify outputs).   #}
  name        "{{ output.name | default('My ALSA Device') }}"

  {# Device name or path (e.g., 'default' for ALSA, '/dev/video0').           #}
  {% if output.device is defined and output.device is not none %}
  device      "{{ output.device }}"
  {% endif %}

  {# Sample format: sample_rate:bits:channels (e.g., '44100:16:2').          #}
  {% if output.format is defined and output.format is not none %}
  format      "{{ output.format }}"
  {% endif %}

  {# Direct Mix: enable software mixing (ALSA specific).                      #}
  {% if output.dmix is defined and output.dmix is not none %}
  dmix        "{{ output.dmix }}"
  {% endif %}

  {# Sample rate converter (e.g., 'soxr_medium', 'speex_medium').             #}
  {% if output.samplerate_converter is defined and output.samplerate_converter is not none %}
  samplerate_converter "{{ output.samplerate_converter }}"
  {% endif %}

  {# Autosuspend: close device when idle.                                     #}
  {% if output.autosuspend is defined and output.autosuspend is not none %}
  autosuspend "{{ output.autosuspend }}"
  {% endif %}

  {# Buffer time in ms for audio playback.                                    #}
  {% if output.buffer_time is defined and output.buffer_time is not none %}
  buffer_time "{{ output.buffer_time }}"
  {% endif %}
}
{% endfor %}

{# Global output sample format override (e.g., '44100:24:2').                   #}
{# Leave empty to use input source format.                                    #}
{% if audio_format | default('') | string is not none and audio_format | default('') | string != '' %}
audio_output_format "{{ audio_format | default('') }}"
{% endif %}

{# Legacy resampling quality (0–7). Prefer `samplerate_converter` in output    #}
{# blocks for newer MPD.                                                      #}
{% if resample_quality | default('4') is not none %}
resample_quality      "{{ resample_quality | default('4') }}"
{% endif %}

{# --- Limits and Buffers ----------------------------------------------------- #}
{# Maximum number of simultaneously connected clients.                        #}
max_clients           "{{ max_clients | default(10) }}"

{# Maximum number of concurrent playback streams (e.g., for multiroom setups).#}
max_players           "{{ max_players | default(1) }}"

{# Maximum number of parallel file reads (improves performance with large      #}
{# libraries).                                                                #}
max_readers           "{{ max_readers | default(10) }}"

{# Maximum internal buffer size in kilobytes (~0.5 MB). Increase for          #}
{# high-bitrate streaming.                                                    #}
max_buffer_size       "{{ max_buffer_size | default(524288) }}"

{# --- Filesystem Settings ---------------------------------------------------- #}
{# Character set for filesystem paths (should almost always be 'UTF-8').      #}
filesystem_charset    "{{ filesystem_charset | default('UTF-8') }}"

{# Enable iconv-based charset conversion for legacy filesystems.              #}
filesystem_iconv      "{{ filesystem_iconv | default('no') }}"

{# Follow symlinks inside the music directory.                                #}
follow_symlink        "{{ follow_symlink | default(False) }}"

{# Follow symlinks pointing outside the music directory.                      #}
follow_outside_symlink "{{ follow_outside_symlink | default(False) | lower }}"

{# --- Privileges ------------------------------------------------------------- #}
{# User account to run MPD under (use 'root' only for testing; not           #}
{# recommended).                                                              #}
{% if user | default('mpd') is not none %}
user                  "{{ user | default('mpd') }}"
{% endif %}

{# Group for file permissions (e.g., 'audio' to allow audio device access).   #}
{% if group | default('mpd') is not none %}
group                 "{{ group | default('mpd') }}"
{% endif %}

{# --- Logging and Debugging -------------------------------------------------- #}
{# Verbosity of log output. Use 'debug' only for troubleshooting.             #}
{% if log_level | default('notice') is not none %}
log_level             "{{ log_level | default('notice') }}"
{% endif %}

{# Timeout (in seconds) for sticker database queries.                         #}
{% if sticker_timeout | default(60) is not none %}
sticker_timeout       "{{ sticker_timeout | default(60) }}"
{% endif %}

{# --- Playback Settings ------------------------------------------------------ #}
{# Randomize playback order by default in playlists.                          #}
{% if randomize_playlist | default(True) is not none %}
randomize_playlist    "{{ randomize_playlist | default(True) }}"
{% endif %}

{# Crossfade duration in seconds (0 disables crossfading).                    #}
{% if crossfade | default(5) is not none %}
crossfade             "{{ crossfade | default(5) }}"
{% endif %}

{# Replay Gain processing mode. 'auto' applies track/album gain as needed.    #}
{% if replay_gain_mode | default('auto') is not none %}
replay_gain_mode      "{{ replay_gain_mode | default('auto') }}"
{% endif %}

{# Additional preamp (in dB) applied to Replay Gain.                          #}
{% if replay_gain_preamp | default(0) is not none %}
replay_gain_preamp    "{{ replay_gain_preamp | default(0) }}"
{% endif %}

{# Gain (in dB) applied if no metadata is present.                            #}
{% if replay_gain_fallback | default(0) is not none %}
replay_gain_fallback  "{{ replay_gain_fallback | default(0) }}"
{% endif %}

{# Initial volume percentage (0–100) on startup.                              #}
{% if default_volume | default(75) is not none %}
default_volume        "{{ default_volume | default(75) }}"
{% endif %}

{# Restore last volume setting on startup.                                    #}
{% if restore_volume | default(True) is not none %}
restore_volume        "{{ restore_volume | default(True) }}"
{% endif %}

{# Audio delay in milliseconds (useful for lip-sync correction).              #}
{% if audio_delay | default(0) is not none %}
audio_delay           "{{ audio_delay | default(0) }}"
{% endif %}

{# Audio buffer size in kilobytes (legacy; prefer `buffer_time` in           #}
{# audio_output blocks).                                                      #}
{% if audio_buffer_size | default(1024) is not none %}
audio_buffer_size     "{{ audio_buffer_size | default(1024) }}"
{% endif %}

{# --- Network Streaming Settings --------------------------------------------- #}
{# Timeout in seconds for network I/O (e.g., streaming).                      #}
{% if network_timeout | default(60) is not none %}
network_timeout       "{{ network_timeout | default(60) }}"
{% endif %}

{# Network buffer size in milliseconds (0 = disable buffering).               #}
{% if network_buffer | default(1000) is not none %}
network_buffer        "{{ network_buffer | default(1000) }}"
{% endif %}

{# Zeroconf/Avahi service discovery for MPD (allows auto-discovery on LAN).   #}
{% if zeroconf_enabled | default(True) is not none %}
zeroconf_enabled      "{{ zeroconf_enabled | default(True) | lower }}"
{% endif %}

{# Service name advertised via Zeroconf (shown in discovery clients).         #}
{% if zeroconf_name | default('Music Player Daemon') is not none %}
zeroconf_name         "{{ zeroconf_name | default('Music Player Daemon') }}"
{% endif %}

{# --- HTTP Streaming Outputs ------------------------------------------------- #}
{# HTTP streaming outputs (e.g., Icecast-compatible streams).                 #}
{# Each item in the list creates an audio_output block of type 'http'.        #}
{% for stream in http_streams | default([{'name': 'My HTTP Stream', 'encoder': 'vorbis', 'port': 8000, 'mimetype': 'audio/ogg', 'quality': 0.5, 'max_clients': 10}]) %}
audio_output {
  {# Output type must be 'http' for streaming outputs.                        #}
  type        "http"
  {# Name of the HTTP stream output.                                          #}
  name        "{{ stream.name | default('My HTTP Stream') }}"
  {# Encoder to use for the stream (e.g., 'vorbis', 'lame', 'opus').         #}
  encoder     "{{ stream.encoder | default('vorbis') }}"
  {# Port number for the HTTP stream.                                         #}
  port        "{{ stream.port | default(8000) }}"

  {% if stream.bind_to_address is defined and stream.bind_to_address is not none %}
  {# Bind address for the HTTP stream.                                        #}
  bind_to_address "{{ stream.bind_to_address }}"
  {% endif %}

  {% if stream.mimetype is defined and stream.mimetype is not none %}
  {# MIME type of the stream content.                                         #}
  mimetype    "{{ stream.mimetype }}"
  {% endif %}

  {% if stream.max_clients is defined and stream.max_clients is not none %}
  {# Max clients for this stream output.                                      #}
  max_clients "{{ stream.max_clients }}"
  {% endif %}

  {% if stream.quality is defined and stream.quality is not none %}
  {# Quality of the stream (0.0 - 1.0).                                       #}
  quality     "{{ stream.quality }}"
  {% endif %}
}
{% endfor %}

{# --- Input Plugins ---------------------------------------------------------- #}
{# Optional input plugins (e.g., network streamers).                          #}
{# Each item in the list configures an input plugin.                          #}
{% for input_item in inputs | default([{'type': 'curl', 'enabled': True, 'url': 'http://example.com/stream'}, {'type': 'file', 'enabled': True}]) %}
{% if input_item.enabled | default(True) | bool %}
{% for k, v in input_item | dict2items if k != 'type' and k != 'enabled' %}
{# Input plugin configuration key-value pairs.                              #}
input "{{ k }}" {
  {# Value of the input plugin setting.                                       #}
  {{ k }} "{{ v | default('') }}"
}
{% endfor %}
{% endif %}
{% endfor %}

{# Priority order of metadata tag formats to read (left to right).            #}
{% if tag_types | default(['ID3v1', 'ID3v2', 'Ape', 'Lyrics3', 'Flac', 'Vorbis', 'Musepack', 'WavPack', 'Spc', 'Mpeg', 'Wma', 'Aiff', 'Opus', 'Sndfile']) is iterable %}
tag_types [ "{{ tag_types | default(['ID3v1', 'ID3v2', 'Ape', 'Lyrics3', 'Flac', 'Vorbis', 'Musepack', 'WavPack', 'Spc', 'Mpeg', 'Wma', 'Aiff', 'Opus', 'Sndfile']) | join('" "') }}" ]
{% endif %}

{# Charset for ID3v1 tags (MP3 legacy).                                       #}
{% if id3v1_encoding | default('UTF-8') is not none %}
id3v1_encoding          "{{ id3v1_encoding | default('UTF-8') }}"
{% endif %}

{# Charset for ID3v2 tags (modern MP3/AAC).                                   #}
{% if id3v2_encoding | default('UTF-8') is not none %}
id3v2_encoding          "{{ id3v2_encoding | default('UTF-8') }}"
{% endif %}

{# Enable gapless playback for MP3 files (requires precise Xing headers).     #}
{% if gapless_mp3 | default(True) is not none %}
gapless_mp3             "{{ gapless_mp3 | default(True) }}"
{% endif %}

{# Buffer fill time in milliseconds (used to avoid underruns on startup).     #}
{% if buffer_fill_time | default(2000) is not none %}
buffer_fill_time        "{{ buffer_fill_time | default(2000) }}"
{% endif %}