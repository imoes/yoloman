# MPD Configuration File
# This template is self-documenting. Read the comments to understand each setting.

# ============================================================================
# FILES AND DIRECTORIES
# ============================================================================

# Core filesystem paths for MPD databases, logs, music, and state files.
# This block defines the standard directory structure.
# paths is expected to be a mapping/object with keys: music, playlists, db, log, pid, sticker.
# If paths is not defined, this sets defaults.
{% set paths = paths | default({
    'music': '/var/lib/mpd/music',
    'playlists': '/var/lib/mpd/playlists',
    'db': '/var/lib/mpd/tag_cache',
    'log': '/var/log/mpd/mpd.log',
    'pid': '/run/mpd/mpd.pid',
    'sticker': '/var/lib/mpd/sticker.db',
    'socket': '/run/mpd/socket'
}) %}

# This setting controls the top directory which MPD will search to discover the
# available audio files and add them to the daemon's online database.
# Schema: paths.music
music_directory "{{ paths.music | default('/var/lib/mpd/music') }}"

# This setting sets the MPD internal playlist directory. The purpose of this
# directory is storage for playlists created by MPD.
# Schema: paths.playlists
playlist_directory "{{ paths.playlists | default('/var/lib/mpd/playlists') }}"

# This setting sets the location of the MPD database. This file is used to
# load the database at server start up and store the database while the
# server is not up.
# Schema: paths.db
db_file "{{ paths.db | default('/var/lib/mpd/tag_cache') }}"

# These settings are the locations for the daemon log files for the daemon.
# The special value "syslog" makes MPD use the local syslog daemon.
# If you use systemd, do not configure a log_file.
# Schema: paths.log
#log_file "{{ paths.log | default('/var/log/mpd/mpd.log') }}"

# This setting sets the location of the file which stores the process ID
# for use of mpd --kill and some init scripts.
# If you use systemd, do not configure a pid_file.
# Schema: paths.pid
#pid_file "{{ paths.pid | default('/run/mpd/mpd.pid') }}"

# This setting sets the location of the file which contains information about
# most variables to get MPD back into the same general shape it was in before
# it was brought down.
state_file "/var/lib/mpd/state"

# The location of the sticker database. This is a database which
# manages dynamic information attached to songs.
# Schema: paths.sticker
sticker_file "{{ paths.sticker | default('/var/lib/mpd/sticker.db') }}"

# ============================================================================
# GENERAL MUSIC DAEMON OPTIONS
# ============================================================================

# This setting specifies the user that MPD will run as. MPD should never run as
# root and you may use this setting to make MPD change its user ID after
# initialization.
# Note: This is an OS user account, not a credential field for network services.
user "mpd"

# This setting sets the address for the daemon to listen on. Careful attention
# should be paid if this is assigned to anything other than the default, any.
# This setting can deny access to control of the daemon. Not effective if
# systemd socket activation is in use.
#
# Configuration logic:
# - If use_socket is False (default), we bind to a TCP address and port.
# - If use_socket is True, we bind to a Unix socket path.

{% if not (use_socket | default(false) | bool) %}
# TCP Mode: Bind to network interface and port.
# Network interface to bind MPD to (e.g., 127.0.0.1 for local-only, or 0.0.0.0 for all interfaces).
# Schema: bind_address
bind_to_address "{{ bind_address | default('0.0.0.0') }}"

# This setting is the TCP port that is desired for the daemon to get assigned
# to.
# Schema: port
port "{{ port | default(6600) }}"
{% else %}
# Unix Socket Mode: Bind to a local socket file.
# Path to the Unix socket file (used only if use_socket is true).
# Schema: paths.socket (used as fallback for socket_path if specific socket_path field isn't in schema)
# Note: MPD allows multiple bind_to_address lines; here we prioritize the socket.
bind_to_address "{{ paths.socket | default('/run/mpd/socket') }}"

# TCP Port is implicitly disabled/ignored when using a dedicated Unix socket in this mode,
# but we leave the config block commented out or empty to avoid conflicts unless explicitly needed.
{% endif %}

# ============================================================================
# INPUT, DECODER, AND AUDIO OUTPUTS
# ============================================================================

# Input configuration for fetching audio data.
input {
    plugin "curl"
#   proxy "proxy.isp.com:8080"
#   proxy_user "user"
#   proxy_password "password"
}

# Decoder configuration.
decoder {
    plugin                  "hybrid_dsd"
    enabled                 "no"
}
decoder {
    plugin        "wildmidi"
    enabled       "no"
}

# Audio Outputs
# List of audio output devices (e.g., ALSA, PipeWire, PulseAudio). Each item configures one output.
# Schema: audio_outputs
{% set audio_outputs = audio_outputs | default([]) %}
{% for output in audio_outputs %}
# Audio Output Configuration
# Type of the audio output device (e.g., alsa, pulse, httpd, shout, null).
audio_output {
    type "{{ output.type | default('alsa') }}"
    name "{{ output.name | default('Default Output') }}"

    {# ALSA Specifics #}
    {% if output.type | default('') == 'alsa' %}
        {% if output.device %}
    device "{{ output.device }}"
        {% endif %}
        #mixer_type      "hardware"
        #mixer_device    "default"
        #mixer_control   "PCM"
        #mixer_index     "0"
    {% endif %}

    {# HTTP Daemon (Streaming Server) Specifics #}
    {% if output.type | default('') == 'httpd' %}
        {% if output.encoder %}
    encoder "{{ output.encoder }}"
        {% endif %}
        {% if output.port %}
    port "{{ output.port }}"
        {% endif %}
        {% if output.bind_to_address %}
    bind_to_address "{{ output.bind_to_address }}"
        {% endif %}
        {% if output.quality %}
    quality "{{ output.quality }}"
        {% endif %}
        {% if output.bitrate %}
    bitrate "{{ output.bitrate }}"
        {% endif %}
        {% if output.max_clients %}
    max_clients "{{ output.max_clients }}"
        {% endif %}
    {% endif %}

    {# Shoutcast/Icecast Streaming Specifics #}
    {% if output.type | default('') == 'shout' %}
        {% if output.encoder %}
    encoder "{{ output.encoder }}"
        {% endif %}
        {% if output.host %}
    host "{{ output.host }}"
        {% endif %}
        {% if output.port %}
    port "{{ output.port }}"
        {% endif %}
        {% if output.mount %}
    mount "{{ output.mount }}"
        {% endif %}
        {% if output.password %}
    password "{{ output.password }}"
        {% endif %}
        {% if output.quality %}
    quality "{{ output.quality }}"
        {% endif %}
        {% if output.bitrate %}
    bitrate "{{ output.bitrate }}"
        {% endif %}
        {% if output.format %}
    format "{{ output.format }}"
        {% endif %}
        {% if output.protocol %}
    #protocol "{{ output.protocol }}"
        {% endif %}
        {% if output.user %}
    #user "{{ output.user }}"
        {% endif %}
        {% if output.description %}
    #description "{{ output.description }}"
        {% endif %}
        {% if output.url %}
    #url "{{ output.url }}"
        {% endif %}
        {% if output.genre %}
    #genre "{{ output.genre }}"
        {% endif %}
        {% if output.public %}
    #public "{{ output.public }}"
        {% endif %}
        {% if output.timeout %}
    #timeout "{{ output.timeout }}"
        {% endif %}
        {% if output.mixer_type %}
    #mixer_type "{{ output.mixer_type }}"
        {% endif %}
    {% endif %}

    {# Null Output (No Audio) #}
    {% if output.type | default('') == 'null' %}
    #mixer_type "none"
    {% endif %}

    {# Format Setting (Common for pipe, httpd, shout, etc.) #}
    {% if output.format %}
    format "{{ output.format }}"
    {% endif %}
}
{% endfor %}

# ============================================================================
# OTHER SETTINGS
# ============================================================================

# Character Encoding
# If file or directory names do not display correctly for your locale then you
# may need to modify this setting.
filesystem_charset "UTF-8"

# Include optional local configuration overrides
include_optional "mpd_local.conf"
