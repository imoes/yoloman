{
  "port": 6600,
  "bind_address": "127.0.0.1",
  "use_socket": true,
  "socket_path": "/run/mpd.sock",
  "paths": {
    "db": "/var/lib/mpd/database",
    "log": "/var/log/mpd/mpd.log",
    "playlists": "/var/lib/mpd/playlists",
    "pid": "/run/mpd.pid",
    "passwords": "/etc/mpd.password",
    "music": "/var/lib/mpd/music",
    "sticker": "/var/lib/mpd/sticker.sql",
    "socket": "/run/mpd.sock"
  },
  "audio_outputs": [
    {
      "type": "pipewire",
      "name": "PipeWire Output",
      "format": "auto",
      "samplerate_converter": "soxr_medium",
      "autosuspend": "no"
    },
    {
      "type": "http",
      "name": "Icecast Stream",
      "encoder": "vorbis",
      "port": 8000,
      "mimetype": "audio/ogg",
      "quality": 0.6,
      "max_clients": 20
    }
  ],
  "max_clients": 10,
  "max_players": 2,
  "max_readers": 20,
  "max_buffer_size": 1048576,
  "filesystem_charset": "UTF-8",
  "filesystem_iconv": "no",
  "follow_symlink": false,
  "follow_outside_symlink": false,
  "user": "mpd",
  "group": "audio",
  "log_level": "notice",
  "sticker_timeout": 60,
  "randomize_playlist": true,
  "crossfade": 5,
  "replay_gain_mode": "auto",
  "replay_gain_preamp": 0,
  "replay_gain_fallback": -10,
  "default_volume": 80,
  "restore_volume": true,
  "audio_delay": 0,
  "audio_buffer_size": 2048,
  "network_timeout": 60,
  "network_buffer": 0,
  "zeroconf_enabled": true,
  "zeroconf_name": "MPD @ Living Room",
  "http_streams": [],
  "inputs": [
    {
      "type": "curl",
      "enabled": true,
      "buffer_size": 2048
    },
    {
      "type": "file",
      "enabled": true
    }
  ],
  "tag_types": [
    "Flac",
    "Vorbis",
    "ID3v2",
    "ID3v1"
  ],
  "id3v1_encoding": "UTF-8",
  "id3v2_encoding": "UTF-8",
  "gapless_mp3": true,
  "buffer_fill_time": 2000
}
