# Configuration for HAVEGE daemon
# Enables HAVEGE to run as a service and provide additional entropy

# Daemon execution user and group
DAEMON_USER={{ user }}
DAEMON_GROUP={{ group }}

# Path to the HAVEGE binary
DAEMON={{ daemon_path }}

# Extra arguments passed to the daemon
DAEMON_ARGS="{{ args }}"

# Enable HAVEGE on system startup (1=yes, 0=no)
START={{ enable | lower }}

# Optional: extra environment variables (key=value per line)
{% for env_var in env_vars %}{{ env_var.key }}={{ env_var.value }}
{% endfor %}