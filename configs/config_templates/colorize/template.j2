{# forensics-colorize configuration template #}
{# This template generates the command-line arguments for the `forensics-colorize` utility. #}

{# List of input .fc files to process (generated by filecompare). Must contain at least one file. #}
{% for item in input_files | default([], true) %}
{{ item }}{% endfor %}

{# Image orientation: 'vertical' or 'horizontal'. #}
{% if orientation | default('vertical', true) == 'horizontal' %} -o{% endif %}

{# Data flow direction: 'down', 'up', 'left', or 'right'. Default 'down' (right for horizontal orientation). #}
{% if direction | default('down', true) in ['left', 'up'] %} -d{% endif %}

{# Output image width in pixels. Must be a positive integer. #}
-w {{ width | default(100, true) }}

{# Enable verbose mode. #}
{% if verbose | default(False, true) %} -v{% endif %}