# /etc/fingerd.conf — Main configuration for the Finger Remote User Information Server
#
# This file controls the behavior of the fingerd daemon (RFC 1288).
# It supports basic access control, logging, banner customization,
# and information disclosure limits.
#
# Generated by Ansible Jinja2 template. Do NOT edit manually; changes
# will be overwritten on next playbook run.

# ---------------------------------------------------------------------------
# General Settings
# ---------------------------------------------------------------------------

# Whether the finger daemon is enabled and should start on boot.
# If false, the service will be stopped/disabled by the role.
# Schema: enabled (bool) - default: True
{% if enabled | default(true) %}
enable = true
{% else %}
enable = false
{% endif %}

# Verbosity of logging: 0 = quiet, 1 = normal, 2 = verbose.
# Schema: loglevel (int) - default: 1
loglevel = {{ loglevel | default(1) }}

# Path to the log file. If empty or omitted, file logging is disabled
# (syslog may still be used if configured at the OS level).
# Note: If set, ensure the directory exists and the process user has write access.
# Schema: log_file (str) - default: ''
{% if log_file | default('') %}
logfile = {{ log_file | default('') }}
{% endif %}

# ---------------------------------------------------------------------------
# Access Control
# ---------------------------------------------------------------------------

# List of hostnames or CIDR subnets permitted to query this finger server.
# Leave empty (default) to allow all clients.
# When defined, only these hosts are explicitly allowed; others are denied
# unless a broader rule applies (implementation-dependent).
# Schema: allow_hosts (list) - default: []
{% for host in allow_hosts | default([]) %}
allow from {{ host }}
{% endfor %}

# List of hosts explicitly denied access (e.g., known attackers or
# misbehaving networks). Deny rules typically take precedence over allow rules.
# Schema: deny_hosts (list) - default: []
{% for host in deny_hosts | default([]) %}
deny from {{ host }}
{% endfor %}

# ---------------------------------------------------------------------------
# Banner & Information Disclosure
# ---------------------------------------------------------------------------

# Custom hostname to display in the server banner.
# If empty or omitted, the system's own hostname is used.
# Schema: banner_host (str) - default: ''
{% if banner_host | default('') %}
banner = {{ banner_host | default('') }}
{% endif %}

# Custom banner message shown before user data.
# Single line only; special characters are passed through as-is.
# Schema: banner_text (str) - default: ''
{% if banner_text | default('') %}
banner text = {{ banner_text | default('') }}
{% endif %}

# Maximum number of concurrent connections the server will accept.
# Prevents resource exhaustion under high load.
# Schema: max_connections (int) - default: 20
maxconnections = {{ max_connections | default(20) }}

# Number of seconds before an idle connection is closed.
# Helps free up file descriptors for unused sessions.
# Schema: idle_timeout (int) - default: 30
idletimeout = {{ idle_timeout | default(30) }}

# Whether to show detailed user info (full name, shell, home directory,
# login time, etc.) in responses.
# Setting to false reduces information leakage to potential attackers.
# Schema: show_full_info (bool) - default: True
{% if show_full_info | default(true) %}
full info = true
{% else %}
full info = false
{% endif %}

# Whether to include user's plan/project files (if present) in the output.
# Typically refers to .plan or .project files in the user's home directory.
# Recommend keeping this false for security best practices.
# Schema: show_plans (bool) - default: False
{% if show_plans | default(false) %}
show plans = true
{% else %}
show plans = false
{% endif %}

# Whether to obfuscate email addresses in the output.
# For example, `user@example.com` becomes `user AT example DOT com`.
# Useful to reduce spam harvesting but may confuse users.
# Schema: obfuscate_email (bool) - default: False
{% if obfuscate_email | default(false) %}
obfuscate email = true
{% else %}
obfuscate email = false
{% endif %}

# List of group names whose members should be hidden from non-local queries.
# If the implementation supports it, users in these groups will not appear
# in finger responses unless the query originates from localhost.
# Schema: hidden_groups (list) - default: []
{% for group in hidden_groups | default([]) %}
hide group {{ group }}
{% endfor %}

# ---------------------------------------------------------------------------
# Network Binding
# ---------------------------------------------------------------------------

# TCP port to listen on.
# Set to 0 to disable standalone mode (use only with inetd/xinetd).
# Schema: port (int) - default: 79
port = {{ port | default(79) }}

# IP address to bind to (e.g., '127.0.0.1' for localhost-only).
# Empty or omitted means bind to all interfaces (0.0.0.0 / ::).
# Restricting to 127.0.0.1 is recommended if finger is not needed externally.
# Schema: bind_address (str) - default: ''
{% if bind_address | default('') %}
bind = {{ bind_address | default('') }}
{% endif %}