{
  "mount_point": {
    "type": "string",
    "default": "",
    "description": "Mount point directory (required)"
  },
  "iso_image": {
    "type": "string",
    "default": "",
    "description": "Path to ISO/BIN/NGR image to mount (required)"
  },
  "iocharset": {
    "type": "string",
    "default": "UTF-8",
    "description": "Character set for Joliet filesystems (see iconv --list)"
  },
  "fuse_opts": {
    "type": "list",
    "default": [],
    "description": "List of additional FUSE mount options (e.g., ['ro', 'allow_other'])"
  },
  "foreground": {
    "type": "bool",
    "default": false,
    "description": "Run in foreground (do not daemonize)"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug output (implies foreground)"
  },
  "single_threaded": {
    "type": "bool",
    "default": false,
    "description": "Run single-threaded"
  },
  "maintain_mtab": {
    "type": "bool",
    "default": true,
    "description": "Maintain ~/.mtab.fuseiso (set to false to use -n)"
  },
  "create_mountpoint": {
    "type": "bool",
    "default": false,
    "description": "Create mount point if missing and delete on exit (use -p)"
  }
}
