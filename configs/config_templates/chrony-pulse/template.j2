# Chrony Configuration Template
# This template generates a valid chrony.conf file.
# It uses Jinja2 variables with explicit defaults to ensure safe rendering.
# Comments above each directive describe the corresponding schema field.

# -----------------------------------------------------------------------------
# allow_networks: List of IP subnets or hostnames allowed to query this chrony
# instance as an NTP server.
# -----------------------------------------------------------------------------
{% set allow_nets = allow_networks | default([]) %}
{% if allow_nets | length > 0 %}
{% for net in allow_nets %}
allow {{ net }}
{% endfor %}
{% endif %}

# -----------------------------------------------------------------------------
# ntp_servers: List of NTP servers to synchronize with. Each entry defines a
# server hostname and optional flags.
# -----------------------------------------------------------------------------
{% set servers = ntp_servers | default([]) %}
{% for server in servers %}
server {{ server.hostname }}{{ ' iburst' if (server.iburst | default(true)) else '' }}{{ ' prefer' if (server.prefer | default(false)) else '' }}
{% endfor %}

# -----------------------------------------------------------------------------
# pps_enabled: Enable Pulse Per Second (PPS) reference for high-precision
# timing, e.g., from GPS receiver.
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# pps_device: Path to the PPS device (e.g., /dev/pps0).
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# pps_refid: Reference ID string (max 4 chars) to identify the PPS source in
# logs and status.
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# pps_precision: Expected precision of the PPS signal in seconds (e.g., 1e-9
# for nanoseconds).
# -----------------------------------------------------------------------------
{% if pps_enabled | default(false) %}
# PPS reference device configuration
refclock PPS {{ pps_device | default('/dev/pps0') }} refid {{ pps_refid | default('PPS') }} prefer precision {{ pps_precision | default(1e-9) }}
{% endif %}

# -----------------------------------------------------------------------------
# Drift file path (standard chrony location).
# -----------------------------------------------------------------------------
driftfile /var/lib/chrony/drift

# -----------------------------------------------------------------------------
# rtcsync: Enable RTC hardware clock synchronization.
# -----------------------------------------------------------------------------
rtcsync

# -----------------------------------------------------------------------------
# leapsectz: Timezone for leap second handling (e.g., 'right/UTC', 'Etc/UTC').
# -----------------------------------------------------------------------------
leapsectz {{ leapsectz | default('right/UTC') }}

# -----------------------------------------------------------------------------
# Logging directory.
# -----------------------------------------------------------------------------
logdir /var/log/chrony

# -----------------------------------------------------------------------------
# log_options: Log categories to enable (e.g., 'measurements', 'statistics',
# 'tracking').
# -----------------------------------------------------------------------------
{% set logs = log_options | default(['measurements', 'statistics', 'tracking']) %}
{% for log_item in logs %}
log {{ log_item }}
{% endfor %}

# -----------------------------------------------------------------------------
# ntp_auth_enabled: Enable NTP authentication using keys in chrony.keys file.
# -----------------------------------------------------------------------------
{% if ntp_auth_enabled | default(false) %}
keyfile /etc/chrony/chrony.keys
{% endif %}

# -----------------------------------------------------------------------------
# makestep: Allow time to be stepped even after initial sync (for recovery).
# Default: 1.0 seconds threshold, 3 updates.
# -----------------------------------------------------------------------------
makestep 1.0 3

# -----------------------------------------------------------------------------
# rtconutc: Enable RTC kernel pll for continuous time adjustments.
# -----------------------------------------------------------------------------
rtconutc

# -----------------------------------------------------------------------------
# maxslewrate: Maximum slew rate (ms/day).
# -----------------------------------------------------------------------------
maxslewrate 1000

# -----------------------------------------------------------------------------
# maxdistance: Maximum distance to a synchronization source (seconds); sources
# farther away are rejected.
# -----------------------------------------------------------------------------
maxdistance {{ maxdistance | default(3600.0) }}

# -----------------------------------------------------------------------------
# minsources: Minimum number of valid sources required before synchronization is
# allowed.
# -----------------------------------------------------------------------------
minsources {{ minsources | default(2) }}

# -----------------------------------------------------------------------------
# sourcereplacementthreshold: Threshold (in seconds) for replacing the current
# reference source (0 = use default).
# -----------------------------------------------------------------------------
sourcereplacementthreshold {{ sourcereplacementthreshold | default(0) }}

# -----------------------------------------------------------------------------
# initstepslew: Enable initial time step at startup (use with
# initstepslew_threshold).
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# initstepslew_threshold: Maximum clock offset (seconds) to allow step-based
# initial sync.
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# initstepslew_hosts: List of hosts to consider as time sources during initial
# slew.
# -----------------------------------------------------------------------------
{% set threshold = initstepslew_threshold | default(0) %}
{% set hosts = initstepslew_hosts | default([]) %}
{% set hosts_str = hosts | join(' ') %}
initstepslew {{ threshold }} {{ hosts_str }}

# -----------------------------------------------------------------------------
# ntp_server_enabled: Enable this host to serve time to other NTP clients.
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# local_stratum: Stratum level when serving time locally (only effective if
# ntp_server_enabled is true).
# -----------------------------------------------------------------------------
{% if ntp_server_enabled | default(false) %}
local stratum {{ local_stratum | default(10) }}
{% endif %}

# -----------------------------------------------------------------------------
# offline_mode: Disable all internet time sources — useful for air-gapped or
# offline systems.
# -----------------------------------------------------------------------------
{% if offline_mode | default(false) %}
offline
{% endif %}

# -----------------------------------------------------------------------------
# bind_interfaces: List of IP addresses or interface names to bind NTP commands
# and queries to (for security).
# -----------------------------------------------------------------------------
{% set bind_ifaces = bind_interfaces | default([]) %}
{% if bind_ifaces | length > 0 %}
{% for iface in bind_ifaces %}
bindaddress {{ iface }}
{% endfor %}
{% endif %}

# -----------------------------------------------------------------------------
# manual_allowed: Allow use of 'manpage' (chronyc manual control) for
# debugging/administration.
# -----------------------------------------------------------------------------
{% if manual_allowed | default(true) %}
manpage
{% endif %}

# -----------------------------------------------------------------------------
# cmdport: Specify command port (for chronyc).
# NOTE: cmdport is NOT a standard network listening port for NTP clients.
# It is used only for local CLI connections. Standard NTP port 123 is implicit
# and not configurable in chrony.conf.
# -----------------------------------------------------------------------------
{% if cmdport is defined %}
cmdport {{ cmdport }}
{% endif %}

# -----------------------------------------------------------------------------
# ntp_broadcast_enabled: Enable broadcast of time to local subnet (requires
# ntp_broadcast_addr).
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# ntp_broadcast_addr: Broadcast address for time (e.g., 192.168.1.255).
# -----------------------------------------------------------------------------
{% if ntp_broadcast_enabled | default(false) %}
broadcast {{ ntp_broadcast_addr | default('') }}
{% endif %}