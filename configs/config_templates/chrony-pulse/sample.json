    "statistics",
    "tracking",
    "rawdata"
  ],
  "ntp_auth_enabled": false,
  "maxdistance": 10.0,
  "minsources": 2,
  "sourcereplacementthreshold": 0.5,
  "initstepslew": true,
  "initstepslew_threshold": 10.0,
  "initstepslew_hosts": [],
  "ntp_server_enabled": true,
  "local_stratum": 2,
  "offline_mode": false,
  "bind_interfaces": [
    "192.168.1.10"
  ],
  "manual_allowed": true,
  "ntp_broadcast_enabled": true,
  "ntp_broadcast_addr": "192.168.1.255"
