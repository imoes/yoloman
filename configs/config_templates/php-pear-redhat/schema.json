{
  "cache_dir": {
    "type": "string",
    "default": "/var/cache/php-pear",
    "description": "Directory where PEAR stores cached files."
  },
  "cache_dir_len": {
    "type": "number",
    "default": 19,
    "description": "String length of cache_dir for serialization."
  },
  "default_channel": {
    "type": "string",
    "default": "pear.php.net",
    "description": "Default PEAR channel."
  },
  "default_channel_len": {
    "type": "number",
    "default": 12,
    "description": "String length of default_channel for serialization."
  },
  "preferred_mirror": {
    "type": "string",
    "default": "pear.php.net",
    "description": "Preferred PEAR mirror."
  },
  "preferred_mirror_len": {
    "type": "number",
    "default": 12,
    "description": "String length of preferred_mirror for serialization."
  },
  "auto_discover": {
    "type": "number",
    "default": 0,
    "description": "Whether to auto-discover channels."
  },
  "master_server": {
    "type": "string",
    "default": "pear.php.net",
    "description": "Master PEAR server."
  },
  "master_server_len": {
    "type": "number",
    "default": 12,
    "description": "String length of master_server for serialization."
  },
  "php_dir": {
    "type": "string",
    "default": "/usr/share/pear",
    "description": "Directory for installed PEAR packages."
  },
  "php_dir_len": {
    "type": "number",
    "default": 15,
    "description": "String length of php_dir for serialization."
  },
  "doc_dir": {
    "type": "string",
    "default": "/usr/share/doc/pear",
    "description": "Directory for PEAR package documentation."
  },
  "doc_dir_len": {
    "type": "number",
    "default": 19,
    "description": "String length of doc_dir for serialization."
  },
  "bin_dir": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Directory for PEAR executable scripts."
  },
  "bin_dir_len": {
    "type": "number",
    "default": 8,
    "description": "String length of bin_dir for serialization."
  },
  "data_dir": {
    "type": "string",
    "default": "/usr/share/pear-data",
    "description": "Directory for PEAR package data files."
  },
  "data_dir_len": {
    "type": "number",
    "default": 20,
    "description": "String length of data_dir for serialization."
  },
  "cfg_dir": {
    "type": "string",
    "default": "/etc/pear",
    "description": "Directory for PEAR package configuration files."
  },
  "cfg_dir_len": {
    "type": "number",
    "default": 9,
    "description": "String length of cfg_dir for serialization."
  },
  "www_dir": {
    "type": "string",
    "default": "/var/www/html",
    "description": "Directory for PEAR web-accessible files."
  },
  "www_dir_len": {
    "type": "number",
    "default": 13,
    "description": "String length of www_dir for serialization."
  },
  "man_dir": {
    "type": "string",
    "default": "/usr/share/man",
    "description": "Directory for PEAR manual pages."
  },
  "man_dir_len": {
    "type": "number",
    "default": 14,
    "description": "String length of man_dir for serialization."
  },
  "test_dir": {
    "type": "string",
    "default": "/usr/share/tests/pear",
    "description": "Directory for PEAR package tests."
  },
  "test_dir_len": {
    "type": "number",
    "default": 21,
    "description": "String length of test_dir for serialization."
  },
  "temp_dir": {
    "type": "string",
    "default": "/var/tmp",
    "description": "Directory for temporary files."
  },
  "temp_dir_len": {
    "type": "number",
    "default": 8,
    "description": "String length of temp_dir for serialization."
  },
  "download_dir": {
    "type": "string",
    "default": "/tmp/pear/download",
    "description": "Directory for downloading PEAR packages."
  },
  "download_dir_len": {
    "type": "number",
    "default": 18,
    "description": "String length of download_dir for serialization."
  },
  "php_bin": {
    "type": "string",
    "default": "/usr/bin/php",
    "description": "Path to the PHP binary."
  },
  "php_bin_len": {
    "type": "number",
    "default": 12,
    "description": "String length of php_bin for serialization."
  },
  "metadata_dir": {
    "type": "string",
    "default": "/var/lib/pear",
    "description": "Directory for PEAR metadata."
  },
  "metadata_dir_len": {
    "type": "number",
    "default": 13,
    "description": "String length of metadata_dir for serialization."
  },
  "verbose": {
    "type": "number",
    "default": 1,
    "description": "Verbosity level."
  },
  "preferred_state": {
    "type": "string",
    "default": "stable",
    "description": "Preferred stability state for packages.",
    "enum": [
      "stable",
      "alpha",
      "beta"
    ]
  },
  "preferred_state_len": {
    "type": "number",
    "default": 6,
    "description": "String length of preferred_state for serialization."
  },
  "umask": {
    "type": "number",
    "default": 18,
    "description": "Umask for file creation."
  },
  "cache_ttl": {
    "type": "number",
    "default": 3600,
    "description": "Cache time-to-live in seconds."
  },
  "sig_type": {
    "type": "string",
    "default": "gpg",
    "description": "Signature type."
  },
  "sig_type_len": {
    "type": "number",
    "default": 3,
    "description": "String length of sig_type for serialization."
  },
  "sig_bin": {
    "type": "string",
    "default": "/usr/bin/gpg",
    "description": "Path to the signature binary."
  },
  "sig_bin_len": {
    "type": "number",
    "default": 12,
    "description": "String length of sig_bin for serialization."
  },
  "sig_keydir": {
    "type": "string",
    "default": "/etc/pearkeys",
    "description": "Directory for signature keys."
  },
  "sig_keydir_len": {
    "type": "number",
    "default": 13,
    "description": "String length of sig_keydir for serialization."
  },
  "pecl_doc_dir": {
    "type": "string",
    "default": "/usr/share/doc/pecl",
    "description": "Directory for PECL documentation."
  },
  "pecl_doc_dir_len": {
    "type": "number",
    "default": 19,
    "description": "String length of pecl_doc_dir for serialization."
  },
  "pecl_test_dir": {
    "type": "string",
    "default": "/usr/share/tests/pecl",
    "description": "Directory for PECL tests."
  },
  "pecl_test_dir_len": {
    "type": "number",
    "default": 21,
    "description": "String length of pecl_test_dir for serialization."
  }
}
