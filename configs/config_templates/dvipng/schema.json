{
 "bg_color": {
  "default": "transparent",
  "description": "Background color in TeX \\special syntax, or 'Transparent'",
  "enum": [
   "Transparent",
   "transparent"
  ],
  "type": "string"
 },
 "border_color": {
  "default": "",
  "description": "Fallback border color (for viewers lacking alpha transparency)",
  "type": "string"
 },
 "border_width": {
  "default": 0,
  "description": "Transparent border width in pixels (nonzero only with --bg Transparent)",
  "type": "number"
 },
 "debug_flags": {
  "default": 0,
  "description": "Debug level; -1 for maximum",
  "type": "number"
 },
 "dpi_mode": {
  "default": 0,
  "description": "Base DPI for bitmapped (PK) fonts (required with --mode)",
  "type": "number"
 },
 "dvinum": {
  "default": false,
  "description": "Use TeX page numbers in output filenames",
  "type": "bool"
 },
 "fg_color": {
  "default": "",
  "description": "Foreground color in TeX \\special syntax",
  "type": "string"
 },
 "follow_input": {
  "default": false,
  "description": "Wait for more input at end-of-file (--follow)",
  "type": "bool"
 },
 "freetype_disabled": {
  "default": false,
  "description": "Disable FreeType rendering",
  "type": "bool"
 },
 "freetype_enabled": {
  "default": true,
  "description": "Enable FreeType rendering for Type1/TT fonts",
  "type": "bool"
 },
 "gamma": {
  "default": 1.0,
  "description": "Gamma correction factor for antialiasing palette",
  "type": "number"
 },
 "gif_format": {
  "default": false,
  "description": "Output GIF instead of PNG (uses dvigif binary)",
  "type": "bool"
 },
 "image_size": {
  "default": "bbox",
  "description": "Bounding box size: 'bbox', 'tight', or 'hsize,vsize'",
  "enum": [
   "bbox",
   "tight"
  ],
  "type": "string"
 },
 "input_file": {
  "default": "",
  "description": "Input DVI filename",
  "type": "string"
 },
 "mode": {
  "description": "Metafont device mode (e.g., 'laserjet')",
  "enum": [
   "screen",
   "color"
  ],
  "type": "string"
 },
 "no_gf": {
  "default": false,
  "description": "Disable automatic PK font generation (mktexpk)",
  "type": "bool"
 },
 "no_gs": {
  "default": false,
  "description": "Disable internal GhostScript call for PostScript",
  "type": "bool"
 },
 "no_rawps": {
  "default": false,
  "description": "Disable raw PostScript rendering",
  "type": "bool"
 },
 "no_safeguard": {
  "default": false,
  "description": "Disable -dSAFER for GhostScript",
  "type": "bool"
 },
 "origin_offset": {
  "default": null,
  "description": "Origin offset as x,y dimension pair. Must specify x and y.",
  "type": "object"
 },
 "origin_offset.x": {
  "default": "",
  "description": "X component of origin offset (e.g., '.1in')",
  "type": "string"
 },
 "origin_offset.y": {
  "default": "",
  "description": "Y component of origin offset (e.g., '-.3cm')",
  "type": "string"
 },
 "output_file": {
  "default": "png",
  "description": "Output filename pattern (must contain %d or %0Nd for page number)",
  "enum": [
   "png",
   "gif"
  ],
  "type": "string"
 },
 "page_first": {
  "default": 0,
  "description": "First TeX page number to render (TeX \\count0)",
  "type": "number"
 },
 "page_first_physical": {
  "default": 0,
  "description": "First physical (absolute) page number to render",
  "type": "number"
 },
 "page_last": {
  "default": 0,
  "description": "Last TeX page number to render (TeX \\count0)",
  "type": "number"
 },
 "page_last_physical": {
  "default": 0,
  "description": "Last physical (absolute) page number to render",
  "type": "number"
 },
 "pages": {
  "default": [],
  "description": "List of page ranges to process; each item has 'start'/'end' or 'page' key. Only 'start'/'end' supported by dvipng -pp syntax in template; 'page' maps to -p or -l as appropriate.",
  "type": "list"
 },
 "pages[].end": {
  "default": 0,
  "description": "End page for range",
  "type": "number"
 },
 "pages[].page": {
  "description": "Single page number (string: 'first', 'last', or number as string)",
  "enum": [
   "first",
   "last"
  ],
  "type": "string"
 },
 "pages[].start": {
  "default": 0,
  "description": "Start page for range",
  "type": "number"
 },
 "palette": {
  "default": false,
  "description": "Force palette (256-color) output",
  "type": "bool"
 },
 "picky": {
  "default": false,
  "description": "Report warnings only on failure (--picky)",
  "type": "bool"
 },
 "png_compression": {
  "default": 1,
  "description": "PNG compression level (0-9)",
  "type": "number"
 },
 "quality": {
  "default": 4,
  "description": "Antialiasing quality (num; yields num*num+1 levels)",
  "type": "number"
 },
 "quiet": {
  "default": false,
  "description": "Suppress non-error output",
  "type": "bool"
 },
 "report_depth": {
  "default": false,
  "description": "Report image depth (requires preview.sty with 'active')",
  "type": "bool"
 },
 "report_height": {
  "default": false,
  "description": "Report image height (requires preview.sty with 'active')",
  "type": "bool"
 },
 "report_width": {
  "default": false,
  "description": "Report image width",
  "type": "bool"
 },
 "resolution_dpi": {
  "default": 120,
  "description": "Output resolution in DPI (dots per inch)",
  "type": "number"
 },
 "reverse_pages": {
  "default": false,
  "description": "Request reverse page order (overrides default)",
  "type": "bool"
 },
 "reverse_pages_default": {
  "default": true,
  "description": "True if default forward order; emit -r only if reverse is desired",
  "type": "bool"
 },
 "strict": {
  "default": false,
  "description": "Exit on warning",
  "type": "bool"
 },
 "truecolor": {
  "default": false,
  "description": "Force truecolor output",
  "type": "bool"
 },
 "verbose": {
  "default": false,
  "description": "Enable verbose output",
  "type": "bool"
 }
}
