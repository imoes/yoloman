{
  "interface": "eth0",
  "collector_ip": "10.1.2.3",
  "collector_port": 4739,
  "flow_version": "ipfix",
  "sampling_rate": 1,
  "active_timeout": 1800,
  "idle_timeout": 300,
  "ipfix_tcp_flags": true,
  "source_ip": "10.1.2.100",
