{
  "bind_addr": "0.0.0.0",
  "bind_port": 9638,
  "metrics_path": "/metrics",
  "scrape_interval": 15,
  "scrape_timeout": 10,
  "tls_enabled": true,
  "tls_cert_path": "/etc/ntpd-rs/tls/metrics.crt",
  "tls_key_path": "/etc/ntpd-rs/tls/metrics.key",
  "labels": [
    {
      "name": "env",
      "value": "production"
    },
    {
      "name": "instance",
      "value": "ntp-main-01"
    }
  ],
  "extra_filters": {
    "whitelist": [
      "ntpd_rs.*_duration_seconds",
      "ntpd_rs_leap_status",
      "ntpd_rs_offset_estimate"
    ],
    "blacklist": [
      "ntpd_rs_debug_.*"
    ]
  },
  "server_read_timeout": 10,
  "server_write_timeout": 10,
  "server_max_connections": 100
}
