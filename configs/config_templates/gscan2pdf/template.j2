# gscan2pdf configuration file
# Generated by Jinja2 template for Ansible
# This file controls the behavior of gscan2pdf, a GUI frontend for scanning and OCR.
# All variables use schema defaults to ensure a valid configuration even if not provided.

[Preferences]

# Frontend to use for scanning: libsane-perl (default), scanimage, or scanadf.
frontend = {{ frontend | default('libsane-perl') }}

# Directory for temporary files; empty means use system $TMPDIR.
tmp_dir = {{ tmp_dir | default('') }}

# Compression to apply to temporary files: none or lzw.
tmp_compression = {{ tmp_compression | default('none') }}

# Default directory for saving exported files; empty means home.
default_output_dir = {{ default_output_dir | default('') }}

# Default filename pattern for PDF/DjVu exports (supports strftime + %Da, %De, %Dt).
default_filename = {{ default_filename | default('%Y-%m-%d__%H-%M-%S%De') }}

# Allow batch scanning from flatbed scanners (workaround for scanners without ADF).
# Converted to lowercase boolean string.
allow_batch_flatbed = {{ allow_batch_flatbed | default(false) | bool | lower }}

# Force new scan job between pages (for scanners with flaky 'out of documents' signals).
# Converted to lowercase boolean string.
force_new_job_between_pages = {{ force_new_job_between_pages | default(false) | bool | lower }}

# Show advanced SANE options in scan dialog.
# Converted to lowercase boolean string.
show_advanced_options = {{ show_advanced_options | default(false) | bool | lower }}

# Comma-separated SANE options that trigger a full reload when changed.
reload_triggers = {{ reload_triggers | default('source,resolution,pages') }}

# OCR engine to use: tesseract, gocr, or cuneiform. Empty disables OCR.
ocr_engine = {{ ocr_engine | default('') }}

# Language codes for OCR (space-separated, passed as '-l' to OCR tools).
ocr_lang = {{ ocr_lang | default('eng') }}

# Path to unpaper executable; empty disables unpaper.
unpaper_path = {{ unpaper_path | default('') }}

# Default resolution (PPI) in scan dialog (0 = auto).
default_resolution = {{ default_resolution | default(0) }}

# Default scanning mode: color, gray, or lineart.
default_mode = {{ default_mode | default('color') }}

# Default paper size: a4, letter, etc.
default_paper_size = {{ default_paper_size | default('a4') }}

# Default document source: flatbed, adf, or automatic.
default_source = {{ default_source | default('automatic') }}

# Device URI to use (e.g. 'escl:http://scanner.local'); empty auto-detects.
device = {{ device | default('') }}

# List of device URIs (regex) to ignore during device discovery.
# One entry per line, prefixed with 'device_blacklist = ' for the parser.
{% set blacklist = device_blacklist | default([]) %}
{% if blacklist %}
{% for item in blacklist %}device_blacklist = {{ item }}
{% endfor %}
{% endif %}

# Metadata section for embedded PDF/DjVu properties
[Metadata]

# Author name for embedded PDF/DjVu metadata.
author = {{ metadata_author | default('') }}

# Document title for embedded PDF/DjVu metadata.
title = {{ metadata_title | default('') }}

[Tools]

# Custom tools definition.
# Each tool requires a 'name' and a 'cmd' (command template with %i, %o, %r placeholders).
# Iterates over the 'custom_tools' list defined in the schema.
{% set custom_tools_list = custom_tools | default([]) %}
{% for tool in custom_tools_list %}{{ tool.name | default('') }} = {{ tool.cmd | default('') }}
{% endfor %}