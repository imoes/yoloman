{
  "frontend": "libsane-perl",
  "tmp_dir": "/var/tmp/gscan2pdf",
  "tmp_compression": "lzw",
  "default_output_dir": "~/ScannedDocuments",
  "default_filename": "%Y-%m-%d__%H-%M-%S%De",
  "allow_batch_flatbed": true,
  "force_new_job_between_pages": false,
  "show_advanced_options": true,
  "reload_triggers": "source,resolution",
  "ocr_engine": "tesseract",
  "ocr_lang": "eng+fra",
  "unpaper_path": "/usr/bin/unpaper",
  "default_resolution": 300,
  "default_mode": "gray",
  "default_paper_size": "letter",
  "default_source": "adf",
  "device": "",
  "hide_device_name": true,
  "device_blacklist": [
    "/dev/video[0-9]+",
    "/dev/usb/lp[0-9]+"
  ],
  "metadata_author": "John Doe",
  "metadata_title": "Scanned Documents",
  "custom_tools": [
    {
      "name": "deskew_and_crop",
      "cmd": "convert %i -deskew 40% -crop 0x0 +repage %o"
    },
    {
      "name": "resize_for_email",
      "cmd": "convert %i -resize '800x1200>' %o"
    }
  ]
}
