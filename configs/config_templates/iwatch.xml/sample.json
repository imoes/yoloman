{
  "guard_email": "iwatch@localhost",
  "guard_name": "iWatch",
  "watchlist_title": "Operating System",
  "contacts": [
    {
      "email": "root@localhost",
      "name": "Administrator"
    }
  ],
  "paths": [
    {
      "type": "single",
      "syslog": "on",
      "value": "/bin"
    },
    {
      "type": "single",
      "syslog": "on",
      "value": "/sbin"
    },
    {
      "type": "single",
      "value": "/etc"
    },
    {
      "type": "recursive",
      "value": "/lib"
    },
    {
      "type": "exception",
      "value": "/lib/modules"
    }
  ]
}
