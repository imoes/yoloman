{
  "email_to": "security@example.com",
  "log_level": "warning",
  "log_file": "/var/log/iwatch.log",
  "worker_count": 2,
  "timeout_seconds": 60,
  "use_kernel": true,
  "watch_dirs": [
    {
      "path": "/etc",
      "mode": "realtime",
      "recursive": true,
      "include_pattern": ".*",
      "exclude_pattern": "\\.swp$",
      "alert": "changewatch",
      "alert_to": "ops@example.com"
    },
    {
      "path": "/var/www",
      "mode": "mixed",
      "recursive": true,
      "include_pattern": "\\.php$|\\.html$",
      "exclude_pattern": "\\.tmp$",
      "alert": "modwatch"
    }
  ]
}
