<?xml version="1.0" ?>
<!-- iWatch XML Configuration Template -->
<!-- Root element defining the document type and character encoding -->
<!DOCTYPE config SYSTEM "/etc/iwatch/iwatch.dtd" >

<config charset="utf-8">
  <!-- Guard section: Defines the identity and email address for the iWatch monitoring service -->
  <guard email="{{ guard_email | default('iwatch@localhost') }}" name="{{ guard_name | default('iWatch') }}"/>

  <!-- Watchlist section: Defines which files/directories to monitor and who to notify -->
  <watchlist>
    <!-- Title for this specific watchlist configuration block -->
    <title>{{ watchlist_title | default('Operating System') }}</title>

    <!-- Contact points to notify when events occur -->
    <!-- Iterates over the list of contacts provided in the schema -->
    {% for contact in contacts | default([{'email': 'root@localhost', 'name': 'Administrator'}]) %}
    <contactpoint email="{{ contact.email }}" name="{{ contact.name }}"/>
    {% endfor %}

    <!-- Paths to monitor -->
    <!-- Iterates over the list of paths provided in the schema -->
    {% for path in paths | default([{'type': 'single', 'syslog': 'on', 'value': '/bin'}, {'type': 'single', 'syslog': 'on', 'value': '/sbin'}, {'type': 'single', 'value': '/etc'}, {'type': 'recursive', 'value': '/lib'}, {'type': 'exception', 'value': '/lib/modules'}]) %}
    <path type="{{ path.type }}"{% if path.syslog is defined and path.syslog != '' %} syslog="{{ path.syslog }}"{% endif %}>{{ path.value }}</path>
    {% endfor %}
  </watchlist>
</config>
