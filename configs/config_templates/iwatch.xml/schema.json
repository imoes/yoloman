{
  "guard_email": {
    "type": "string",
    "default": "iwatch@localhost",
    "description": "Email address for the iWatch guard component."
  },
  "guard_name": {
    "type": "string",
    "default": "iWatch",
    "description": "Name of the guard component."
  },
  "watchlist_title": {
    "type": "string",
    "default": "Operating System",
    "description": "Title for the watchlist section."
  },
  "contacts": {
    "type": "list",
    "default": [
      {
        "email": "root@localhost",
        "name": "Administrator"
      }
    ],
    "description": "List of contact points for the watchlist."
  },
  "paths": {
    "type": "list",
    "default": [
      {
        "type": "single",
        "syslog": "on",
        "value": "/bin"
      },
      {
        "type": "single",
        "syslog": "on",
        "value": "/sbin"
      },
      {
        "type": "single",
        "value": "/etc"
      },
      {
        "type": "recursive",
        "value": "/lib"
      },
      {
        "type": "exception",
        "value": "/lib/modules"
      }
    ],
    "description": "List of directories to monitor. Each item has 'type' (single, recursive, exception), optional 'syslog' ('on'/'off'), and 'value' (the path)."
  }
}
