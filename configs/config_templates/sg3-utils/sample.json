{
  "verbose": true,
  "default_timeout": 60,
  "no_auto": false,
  "device_rules": [
    {
      "comment": "Skip all loopback devices (e.g., iSCSI initiators)",
      "dev_node": "/dev/sg[0-9]*loop*",
      "skip": true
    },
    {
      "comment": "Use 5-second timeout for NVMe devices exposed as sg",
      "dev_node": "/dev/nvme*",
      "timeout": 5
    },
    {
      "comment": "Explicitly include /dev/sdb with default timeout",
      "dev_node": "/dev/sdb",
      "skip": false
    }
  ]
}
