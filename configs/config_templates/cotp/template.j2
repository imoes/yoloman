# /etc/cotp/cotp.conf — COTP CLI configuration
# This file configures the COTP (Time-based One-Time Password) tool.
# It primarily controls where the encrypted database of TOTP/HOTP secrets is stored.
# For more information see: man cotp or https://github.com/ctokio/cotp

# Absolute path to the encrypted TOTP/HOTP database file.
# Overrides the default location (~/.local/share/cotp/cotp.db).
# Required only if you want to store the database in a non-standard location.
{% if database_path is defined %}
# Database location
DATABASE_PATH={{ database_path | trim }}
{% else %}
# Database location
# Uses the default user-specific path if not specified here:
# DATABASE_PATH=~/.local/share/cotp/cotp.db
{% endif %}