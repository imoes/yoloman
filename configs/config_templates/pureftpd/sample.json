{
  "auth_backend": "puredb",
  "allow_anonymous": false,
  "puredb_path": "/etc/pure-ftpd/pureftpd.pdb",
  "require_tls": true,
  "tls_cert_file": "/etc/ssl/certs/pure-ftpd.crt",
  "tls_key_file": "/etc/ssl/private/pure-ftpd.key",
  "tls_min_version": "TLSv1.3",
  "chroot_all": true,
  "hide_ids": true,
  "max_clients": 30,
  "max_clients_per_ip": 3,
  "bind_address": "",
  "port": 21,
  "passive_port_range_start": 40000,
  "passive_port_range_end": 45000,
  "public_ip": "auto",
  "auto_homedir": false,
  "max_bandwidth": 5000,
  "log_level": 2,
  "extra_config": [
    "NoAnonymous",
    "ChrootEveryone yes",
    "CustomLog /var/log/pure-ftpd/transfer.log"
  ]
}
