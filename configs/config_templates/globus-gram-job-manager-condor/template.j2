# =============================================================================
# globus-gram-job-manager-condor configuration
# =============================================================================
# This file configures the Globus GRAM job manager's interaction with HTCondor.
# It defines job submission defaults, executable paths, and optional features.
# =============================================================================

# -----------------------------------------------------------------------------
# Operating System Default for Condor Jobs
# -----------------------------------------------------------------------------
# Specifies the operating system to use as the default requirement for Condor
# jobs (e.g., LINUX, LINUX26). Leave empty to automatically use the machine's
# detected OS.
# Reference: condor_os
# Default: '' (empty, uses machine default)
# condor_os="{{ condor_os | default('') }}"

# -----------------------------------------------------------------------------
# Architecture Default for Condor Jobs
# -----------------------------------------------------------------------------
# Specifies the computer architecture to use as the default requirement for
# Condor jobs (e.g., X86_64, X86_64_UNKNOWN_LINUX). Leave empty to
# automatically use the machine's detected architecture.
# Reference: condor_arch
# Default: '' (empty, uses machine default)
# condor_arch="{{ condor_arch | default('') }}"

# -----------------------------------------------------------------------------
# Path to condor_submit
# -----------------------------------------------------------------------------
# Full filesystem path to the `condor_submit` executable. This is required
# for submitting jobs to the HTCondor pool.
# Reference: condor_submit
# Default: '/usr/bin/condor_submit'
condor_submit="{{ condor_submit | default('/usr/bin/condor_submit') }}"

# -----------------------------------------------------------------------------
# Path to condor_rm
# -----------------------------------------------------------------------------
# Full filesystem path to the `condor_rm` executable. This is required for
# cancelling/removing jobs from the HTCondor pool.
# Reference: condor_rm
# Default: '/usr/bin/condor_rm'
condor_rm="{{ condor_rm | default('/usr/bin/condor_rm') }}"

# -----------------------------------------------------------------------------
# Condor Configuration File Path
# -----------------------------------------------------------------------------
# Value for the CONDOR_CONFIG environment variable. Used to locate specific
# Condor configuration files. Uncomment and set if Condor is installed in a
# non-default location or requires a specific config file.
# Reference: condor_config
# Default: '' (empty, uses system default)
# condor_config="{{ condor_config | default('') }}"

# -----------------------------------------------------------------------------
# Vanilla Universe File Checks
# -----------------------------------------------------------------------------
# Enables file existence and permission checks for "vanilla" universe jobs.
# The GRAM Condor module always checks files for the standard universe, but
# this setting extends those checks to vanilla jobs.
# Reference: check_vanilla_files
# Default: 'no'
check_vanilla_files="{{ check_vanilla_files | default('no') }}"

# -----------------------------------------------------------------------------
# MPI Script for Parallel Jobs
# -----------------------------------------------------------------------------
# Path to the site-specific MPI script used to launch parallel jobs in the
# Condor parallel universe. Set to 'no' to disable MPI job support.
# Reference: condor_mpi_script
# Default: 'no' (disabled)
# condor_mpi_script="{{ condor_mpi_script | default('no') }}"