{# ============================================================================ #}
{# dwarfdump Configuration File                                                   #}
{# ============================================================================ #}
{# This file is read by dwarfdump to determine its default behavior.            #}
{# It is parsed in the following order of precedence (first match wins for      #}
{# conflicting options, but generally all are applied in sequence):              #}
{#   1. ./dwarfdump.conf                                                        #}
{#   2. $HOME/dwarfdump.conf                                                    #}
{#   3. $HOME/.dwarfdump.conf                                                   #}
{#   4. <prefix>/lib/dwarfdump.conf                                             #}
{#                                                                             #}
{# Each entry in the 'lines' variable should be a raw command-line option       #}
{# string (e.g., '--format-limit=10', '-H10', '--help').                       #}
{# Options are processed in the order they appear; later entries may override   #}
{# earlier ones depending on how dwarfdump parses them.                        #}
{# Only valid options recognized by dwarfdump (see dwarfdump(1)) should be     #}
{# included here. Invalid options may cause dwarfdump to exit with an error.   #}
{# ============================================================================ #}

{% for line in lines | default([]) %}
# {{ line | default('') }}
{% endfor %}