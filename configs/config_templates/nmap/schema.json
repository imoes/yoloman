{
  "targets": {
    "type": "list",
    "default": [
      "127.0.0.1"
    ],
    "description": "List of hostnames or IP addresses to scan."
  },
  "scan_type": {
    "type": "string",
    "default": "sS",
    "description": "Scan technique: sS (SYN), sT (Connect), sU (UDP), sN (Null), etc."
  },
  "scripts": {
    "type": "string",
    "default": "default",
    "description": "NSE Script categories or files to run (e.g., default, safe, vuln).",
    "enum": [
      "auth",
      "broadcast",
      "default",
      "discovery",
      "dos",
      "exploit",
      "external",
      "fuzzer",
      "intrusive",
      "malware",
      "safe",
      "version",
      "vuln",
      "all"
    ]
  },
  "ports": {
    "type": "string",
    "default": "1-65535",
    "description": "Port range to scan (e.g., 80, 1-1023, U:53,T:80)."
  },
  "timing": {
    "type": "string",
    "default": "3",
    "description": "Timing template: 0 (Paranoid), 1 (Sneaky), 2 (Polite), 3 (Normal), 4 (Aggressive), 5 (Insane).",
    "enum": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "paranoid",
      "sneaky",
      "polite",
      "normal",
      "aggressive",
      "insane"
    ]
  },
  "dns_servers": {
    "type": "list",
    "default": [],
    "description": "List of DNS servers to use for reverse resolution."
  },
  "output_file": {
    "type": "string",
    "default": "scan_results.nmap",
    "description": "Filename for normal output."
  },
  "xml_output_file": {
    "type": "string",
    "default": "scan_results.xml",
    "description": "Filename for XML output."
  }
}
