# /etc/dnsvi/dnsvi.conf
# Configuration for dnsvi — a frontend for nsupdate using vi.
# This file is generated by Ansible. Do not edit manually.

# DNS server hostname or IP to use for zone transfers and updates.
# If not set, falls back to system resolver or @nameserver CLI arg.
# Format: 'hostname' or 'IP address'.
nameserver={{ nameserver | default('') }}

# UDP/TCP port to use for DNS queries and updates.
# Must be an integer. Default is 53.
port={{ port | default(53) }}

# Path to TSIG key file for secure dynamic updates.
# If empty, TSIG authentication is not used.
# Example: '/etc/bind/rndc.key'
{% if keyfile is defined and keyfile %}
keyfile={{ keyfile }}
{% endif %}

# If true, use localhost as nameserver and pass -l (local mode) to nsupdate.
# This is useful when nsupdate runs on the DNS server itself.
{% if use_localhost is defined and use_localhost %}
localhost=yes
{% endif %}

# If true, disable IDN output — required for punycode zones on BIND >=9.14.0
# to avoid mixed punycode/non-punycode output.
{% if noidnout is defined and noidnout %}
noidnout=yes
{% endif %}

# If true, use Kerberos (GSS-TSIG) credentials for nsupdate instead of TSIG keys.
# Requires proper Kerberos configuration (krb5.conf) and credentials cache.
{% if use_gssapi is defined and use_gssapi %}
gssapi=yes
{% endif %}

# Note: dnsvi reads the EDITOR environment variable directly.
# This config file does not support a separate 'editor' directive.
# To change the editor, set the EDITOR env var in the user's profile or ansible task.