# ==============================================================================
# Salt SSH Minion Configuration
# ==============================================================================
# This file defines the roster of minions reachable via salt-ssh.
# It is auto-generated by Ansible based on the provided schema.
#
# Structure for each minion:
#   - name: Unique identifier for the minion.
#   - host: The IP address or hostname to connect to via SSH.
#   - user: The SSH login username.
#   - passwd: The password for the SSH login (if not using key-based auth).
#   - sudo: Whether to escalate privileges using sudo after login.
#   - timeout: Connection timeout in seconds.
#   - priv: Path to the private SSH key (if used instead of password).
#   - tty: Allocate a TTY for the remote shell.
# ==============================================================================

# Define the list of minions to be managed.
# Each entry must contain at least 'name' and 'host'.
# Defaults are applied for optional fields if not provided in the input list.
salt_ssh_minions:
{%- for minion in salt_ssh_minions | default([{'name': 'web1', 'host': '192.168.42.1', 'user': 'fred', 'passwd': 'foobarbaz', 'sudo': True}, {'name': 'web2', 'host': '192.168.42.2'}]) %}
  - name: {{ minion.name | default('unknown') }}
    host: {{ minion.host | default('localhost') }}
    {# Optional fields with safe defaults #}
    {# If 'user' is not specified, salt-ssh usually falls back to root or current user, #}
    {# but we provide a placeholder default for clarity. #}
    user: {{ minion.user | default('root') }}
    {# Password is sensitive; omit if not provided to allow key-based auth #}
    {%- if minion.passwd is defined and minion.passwd %}
    passwd: {{ minion.passwd }}
    {%- endif %}
    sudo: {{ minion.sudo | default(false) | lower }}
    {# Timeout in seconds #}
    timeout: {{ minion.timeout | default(30) }}
    {# Private key path for key-based authentication #}
    {%- if minion.priv is defined and minion.priv %}
    priv: {{ minion.priv }}
    {%- endif %}
    {# Allocate TTY #}
    tty: {{ minion.tty | default(false) | lower }}
{%- endfor %}
