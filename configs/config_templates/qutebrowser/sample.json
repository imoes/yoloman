{
  "config_py": "/etc/qutebrowser/config.py",
  "qt_wrapper": "PyQt6",
  "backend": "webengine",
  "desktop_file_name": "qutebrowser",
  "loglevel": "warning",
  "logfilter": "misc.*",
  "loglines": 50,
  "json_logging": true,
  "nocolor": false,
  "force_color": false,
  "nowindow": false,
  "no_err_windows": false,
  "qt_args": [
    {
      "name": "geometry",
      "value": "1920x1080+0+0"
    }
  ],
  "qt_flags": [],
  "debug_flags": [
    "print_stylesheet"
  ],
  "startup_urls": [
    "https://www.qutebrowser.org/",
    "https://duckduckgo.com"
  ],
  "startup_commands": [
    "bind <Ctrl-q> quit",
    "set colors.webpage.preferred_color_scheme dark"
  ],
  "restore_session": "",
  "override_restore": false,
  "open_target": "tab",
  "untrusted_args": false
}
