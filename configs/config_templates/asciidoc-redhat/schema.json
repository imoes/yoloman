{
  "tabsize": {
    "type": "number",
    "default": 8,
    "description": "Tab size in characters"
  },
  "textwidth": {
    "type": "number",
    "default": 70,
    "description": "Text width in characters"
  },
  "newline": {
    "type": "string",
    "default": "\\r\\n",
    "description": "Newline character sequence"
  },
  "toclevels": {
    "type": "number",
    "default": 2,
    "description": "Table of contents levels"
  },
  "iconsdir": {
    "type": "string",
    "default": "./images/icons",
    "description": "Path to icons directory"
  },
  "encoding": {
    "type": "string",
    "default": "UTF-8",
    "description": "Character encoding"
  },
  "source-highlighter": {
    "type": "string",
    "default": "source-highlight",
    "description": "Source code highlighter (source-highlight, pygments, or highlight)",
    "enum": [
      "source-highlight",
      "pygments",
      "highlight"
    ]
  }
}
