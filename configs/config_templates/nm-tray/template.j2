# Desktop entry configuration for the Network Manager Tray application.
# This template generates a standard .desktop file compliant with the
# Freedesktop.org Desktop Entry Specification.

[Desktop Entry]
# Specifies the type of the entry; 'Application' indicates a runnable application.
Type=Application

# Display name for the application entry.
# Defaults to 'nm-tray' if not provided by the calling role or inventory.
Name={{ name | default('nm-tray') }}

# Executable path for the TryExec directive.
# TryExec is used by desktop environments to check if the command exists before displaying the entry.
# Defaults to 'nm-tray' if not provided.
TryExec={{ try_exec | default('nm-tray') }}

# Executable path for the Exec directive.
# The actual command executed to launch the application.
# Defaults to 'nm-tray' if not provided.
Exec={{ exec | default('nm-tray') }}

# Semicolon-separated list of desktop environments where this entry should NOT appear.
# Useful for hiding the tray app in environments where it is redundant or incompatible.
# Defaults to 'KDE;GNOME;' if not provided.
NotShowIn={{ not_show_in | default('KDE;GNOME;') }}

# Boolean flag indicating whether the LXQt desktop environment requires this entry
# to be in the system tray for proper operation.
# Defaults to True if not provided.
X-LXQt-Need-Tray={{ lxqt_need_tray | default(true) | lower }}