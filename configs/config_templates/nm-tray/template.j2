# ==============================================================================
# nm-tray Desktop Entry Configuration
# ==============================================================================
# This template generates a standard .desktop file for the NetworkManager Tray
# application. It configures the application's display name, execution paths,
# and visibility rules for various desktop environments.
# ==============================================================================

[Desktop Entry]

# Standard entry type; "Application" indicates this is a runnable program.
Type=Application

# ==============================================================================
# Application Identification & Execution
# ==============================================================================

# Display name for the application entry in menus and launchers.
# Schema default: 'nm-tray'
Name={{ name | default('nm-tray') }}

# Executable path for the TryExec directive.
# The desktop environment uses this to verify the executable exists before
# adding the entry to the menu.
# Schema default: 'nm-tray'
TryExec={{ try_exec | default('nm-tray') }}

# Executable path for the Exec directive.
# The command line used to launch the application.
# Schema default: 'nm-tray'
Exec={{ exec | default('nm-tray') }}

# ==============================================================================
# Visibility & Environment Specifics
# ==============================================================================

# Semicolon-separated list of desktop environments where this entry should
# NOT appear. Useful for hiding GTK/NetworkManager-specific tools in
# environments like KDE or GNOME if they are managed by native plasmoids/apps.
# Schema default: 'KDE;GNOME;'
NotShowIn={{ not_show_in | default('KDE;GNOME;') }}

# LXQt-specific setting.
# If true, the LXQt panel will attempt to place this application in the
# system tray area.
# Schema default: 'true'
X-LXQt-Need-Tray={{ lxqt_need_tray | default(true) | lower }}
