#
# List Directors who are permitted to contact this File daemon
#
Director {
  Name = {{ director_name }}
  Password = "{{ director_password }}"
}

#
# Restricted Director, used by tray-monitor to get the
#   status of the file daemon
#
Director {
  Name = {{ monitor_name }}
  Password = "{{ monitor_password }}"
  Monitor = yes
}

#
# "Global" File daemon configuration specifications
#
FileDaemon {                          # this is me
  Name = {{ fd_name }}
  FDport = {{ fd_port }}                  # where we listen for the director
  WorkingDirectory = {{ fd_working_directory }}
  Pid Directory = {{ fd_pid_directory }}
  Maximum Concurrent Jobs = {{ fd_max_concurrent_jobs }}
  Plugin Directory = {{ fd_plugin_directory }}
}

# Send all messages except skipped files back to Director
Messages {
  Name = Standard
  director = {{ director_name }} = all, !skipped, !restored, !saved
}
