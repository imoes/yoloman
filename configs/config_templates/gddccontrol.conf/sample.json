{
  "debug": true,
  "log_path": "/var/log/gddccontrol.log",
  "max_log_size": 5,
  "max_log_files": 4,
  "monitors": [
    "i2c-2:0x37",
    "i2c-5:0x3f"
  ],
  "default_brightness": 60,
  "default_contrast": 70,
  "min_interval": 1,
  "auto_save": true,
  "monitor_configs": [
    {
      "id": "primary",
      "name": "Dell U2419H",
      "bus": "i2c-2",
      "address": "0x37",
      "curve": "sRGB",
      "min_brightness": 10,
      "max_brightness": 100
    },
    {
      "id": "secondary",
      "name": "LG 27UP850",
      "bus": "i2c-5",
      "address": "0x3f",
      "curve": "gamma",
      "gamma": 2.4,
      "min_brightness": 5,
      "max_brightness": 90
    }
  ],
  "triggers": [
    {
      "id": "log-brightness",
      "description": "Log every brightness change to a file",
      "event": "brightness-change",
      "command": "/usr/local/bin/log-brightness.sh"
    }
  ]
}
