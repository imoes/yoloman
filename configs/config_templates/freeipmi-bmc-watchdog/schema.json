{
  "timer_use": {
    "type": "number",
    "default": 4,
    "description": "Timer use: 1=BIOS FRB2, 2=BIOS POST, 3=OS_LOAD, 4=SMS OS, 5=OEM"
  },
  "pre_timeout_interrupt": {
    "type": "number",
    "default": 0,
    "description": "Pre-timeout interrupt: 0=None, 1=SMI, 2=NMI, 3=Message Interrupt"
  },
  "timeout_action": {
    "type": "number",
    "default": 1,
    "description": "Timeout action: 0=No action, 1=Hard Reset, 2=Power Down, 3=Power Cycle"
  },
  "initial_countdown": {
    "type": "number",
    "default": 900,
    "description": "Initial countdown in seconds"
  },
  "reset_period": {
    "type": "number",
    "default": 60,
    "description": "Time interval to wait before resetting timer (seconds)"
  }
}
