## Mail specific settings, set SMTP_FROM and either SMTP_HOST or USE_SENDMAIL to enable the mail service.
## To make sure the email links are pointing to the correct host, set the DOMAIN variable.
## Note: if SMTP_USERNAME is specified, SMTP_PASSWORD is mandatory
{% if vaultwarden_smtp_host is defined and vaultwarden_smtp_host is not none and (vaultwarden_smtp_host is number or vaultwarden_smtp_host is boolean or vaultwarden_smtp_host | length > 0) %}SMTP_HOST={{ vaultwarden_smtp_host }}{% else %}# SMTP_HOST=smtp.domain.tld{% endif %}
{% if vaultwarden_smtp_from is defined and vaultwarden_smtp_from is not none and (vaultwarden_smtp_from is number or vaultwarden_smtp_from is boolean or vaultwarden_smtp_from | length > 0) %}SMTP_FROM={{ vaultwarden_smtp_from }}{% else %}# SMTP_FROM=vaultwarden@domain.tld{% endif %}
{% if vaultwarden_smtp_from_name is defined and vaultwarden_smtp_from_name is not none and (vaultwarden_smtp_from_name is number or vaultwarden_smtp_from_name is boolean or vaultwarden_smtp_from_name | length > 0) %}SMTP_FROM_NAME={{ vaultwarden_smtp_from_name }}{% else %}# SMTP_FROM_NAME=Vaultwarden{% endif %}
{% if vaultwarden_smtp_username is defined and vaultwarden_smtp_username is not none and (vaultwarden_smtp_username is number or vaultwarden_smtp_username is boolean or vaultwarden_smtp_username | length > 0) %}SMTP_USERNAME={{ vaultwarden_smtp_username }}{% else %}# SMTP_USERNAME=username{% endif %}
{% if vaultwarden_smtp_password is defined and vaultwarden_smtp_password is not none and (vaultwarden_smtp_password is number or vaultwarden_smtp_password is boolean or vaultwarden_smtp_password | length > 0) %}SMTP_PASSWORD={{ vaultwarden_smtp_password }}{% else %}# SMTP_PASSWORD=password{% endif %}
{% if vaultwarden_smtp_timeout is defined and vaultwarden_smtp_timeout is not none and (vaultwarden_smtp_timeout is number or vaultwarden_smtp_timeout is boolean or vaultwarden_smtp_timeout | length > 0) %}SMTP_TIMEOUT={{ vaultwarden_smtp_timeout }}{% else %}# SMTP_TIMEOUT=15{% endif %}

## Choose the type of secure connection for SMTP. The default is "starttls".
## The available options are:
## - "starttls": The default port is 587.
## - "force_tls": The default port is 465.
## - "off": The default port is 25.
## Ports 587 (submission) and 25 (smtp) are standard without encryption and with encryption via STARTTLS (Explicit TLS). Port 465 (submissions) is used for encrypted submission (Implicit TLS).
{% if vaultwarden_smtp_security is defined and vaultwarden_smtp_security is not none and (vaultwarden_smtp_security is number or vaultwarden_smtp_security is boolean or vaultwarden_smtp_security | length > 0) %}SMTP_SECURITY={{ vaultwarden_smtp_security }}{% else %}# SMTP_SECURITY=starttls{% endif %}
{% if vaultwarden_smtp_port is defined and vaultwarden_smtp_port is not none and (vaultwarden_smtp_port is number or vaultwarden_smtp_port is boolean or vaultwarden_smtp_port | length > 0) %}SMTP_PORT={{ vaultwarden_smtp_port }}{% else %}# SMTP_PORT=587{% endif %}

# Whether to send mail via the `sendmail` command
{% if vaultwarden_use_sendmail is defined and vaultwarden_use_sendmail is not none and (vaultwarden_use_sendmail is number or vaultwarden_use_sendmail is boolean or vaultwarden_use_sendmail | length > 0) %}USE_SENDMAIL={{ vaultwarden_use_sendmail }}{% else %}# USE_SENDMAIL=false{% endif %}
# Which sendmail command to use. The one found in the $PATH is used if not specified.
{% if vaultwarden_sendmail_command is defined and vaultwarden_sendmail_command is not none and (vaultwarden_sendmail_command is number or vaultwarden_sendmail_command is boolean or vaultwarden_sendmail_command | length > 0) %}SENDMAIL_COMMAND={{ vaultwarden_sendmail_command }}{% else %}# SENDMAIL_COMMAND="/path/to/sendmail"{% endif %}

## Defaults for SSL is "Plain" and "Login" and nothing for Non-SSL connections.
## Possible values: ["Plain", "Login", "Xoauth2"].
## Multiple options need to be separated by a comma ','.
{% if vaultwarden_smtp_auth_mechanism is defined and vaultwarden_smtp_auth_mechanism is not none and (vaultwarden_smtp_auth_mechanism is number or vaultwarden_smtp_auth_mechanism is boolean or vaultwarden_smtp_auth_mechanism | length > 0) %}SMTP_AUTH_MECHANISM={{ vaultwarden_smtp_auth_mechanism }}{% else %}# SMTP_AUTH_MECHANISM={% endif %}

## Server name sent during the SMTP HELO
## By default this value should be the machine's hostname,
## but might need to be changed in case it trips some anti-spam filters
{% if vaultwarden_helo_name is defined and vaultwarden_helo_name is not none and (vaultwarden_helo_name is number or vaultwarden_helo_name is boolean or vaultwarden_helo_name | length > 0) %}HELO_NAME={{ vaultwarden_helo_name }}{% else %}# HELO_NAME={% endif %}

## Embed images as email attachments
{% if vaultwarden_smtp_embed_images is defined and vaultwarden_smtp_embed_images is not none and (vaultwarden_smtp_embed_images is number or vaultwarden_smtp_embed_images is boolean or vaultwarden_smtp_embed_images | length > 0) %}SMTP_EMBED_IMAGES={{ vaultwarden_smtp_embed_images }}{% else %}# SMTP_EMBED_IMAGES=true{% endif %}

## SMTP debugging
## When set to true this will output very detailed SMTP messages.
## WARNING: This could contain sensitive information like passwords and usernames! Only enable this during troubleshooting!
{% if vaultwarden_smtp_debug is defined and vaultwarden_smtp_debug is not none and (vaultwarden_smtp_debug is number or vaultwarden_smtp_debug is boolean or vaultwarden_smtp_debug | length > 0) %}SMTP_DEBUG={{ vaultwarden_smtp_debug }}{% else %}# SMTP_DEBUG=false{% endif %}

## Accept Invalid Certificates
## DANGEROUS: This option introduces significant vulnerabilities to man-in-the-middle attacks!
## Only use this as a last resort if you are not able to use a valid certificate.
## If the Certificate is valid but the hostname doesn't match, please use SMTP_ACCEPT_INVALID_HOSTNAMES instead.
{% if vaultwarden_smtp_accept_invalid_certs is defined and vaultwarden_smtp_accept_invalid_certs is not none and (vaultwarden_smtp_accept_invalid_certs is number or vaultwarden_smtp_accept_invalid_certs is boolean or vaultwarden_smtp_accept_invalid_certs | length > 0) %}SMTP_ACCEPT_INVALID_CERTS={{ vaultwarden_smtp_accept_invalid_certs }}{% else %}# SMTP_ACCEPT_INVALID_CERTS=false{% endif %}

## Accept Invalid Hostnames
## DANGEROUS: This option introduces significant vulnerabilities to man-in-the-middle attacks!
## Only use this as a last resort if you are not able to use a valid certificate.
{% if vaultwarden_smtp_accept_invalid_hostnames is defined and vaultwarden_smtp_accept_invalid_hostnames is not none and (vaultwarden_smtp_accept_invalid_hostnames is number or vaultwarden_smtp_accept_invalid_hostnames is boolean or vaultwarden_smtp_accept_invalid_hostnames | length > 0) %}SMTP_ACCEPT_INVALID_HOSTNAMES={{ vaultwarden_smtp_accept_invalid_hostnames }}{% else %}# SMTP_ACCEPT_INVALID_HOSTNAMES=false{% endif %}

