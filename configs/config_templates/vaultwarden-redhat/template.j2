## Regex for additional trusted Id token audience (by default only the client_id is trusted).
{% if vaultwarden_sso_audience_trusted is defined and vaultwarden_sso_audience_trusted is not none and (vaultwarden_sso_audience_trusted is number or vaultwarden_sso_audience_trusted is boolean or vaultwarden_sso_audience_trusted | length > 0) %}SSO_AUDIENCE_TRUSTED={{ vaultwarden_sso_audience_trusted }}{% else %}# SSO_AUDIENCE_TRUSTED='^$'{% endif %}

## Set your Client ID and Client Key
{% if vaultwarden_sso_client_id is defined and vaultwarden_sso_client_id is not none and (vaultwarden_sso_client_id is number or vaultwarden_sso_client_id is boolean or vaultwarden_sso_client_id | length > 0) %}SSO_CLIENT_ID={{ vaultwarden_sso_client_id }}{% else %}# SSO_CLIENT_ID=11111{% endif %}
{% if vaultwarden_sso_client_secret is defined and vaultwarden_sso_client_secret is not none and (vaultwarden_sso_client_secret is number or vaultwarden_sso_client_secret is boolean or vaultwarden_sso_client_secret | length > 0) %}SSO_CLIENT_SECRET={{ vaultwarden_sso_client_secret }}{% else %}# SSO_CLIENT_SECRET=AAAAAAAAAAAAAAAAAAAAAAAA{% endif %}

## Optional Master password policy (minComplexity=[0-4]), `enforceOnLogin` is not supported at the moment.
{% if vaultwarden_sso_master_password_policy is defined and vaultwarden_sso_master_password_policy is not none and (vaultwarden_sso_master_password_policy is number or vaultwarden_sso_master_password_policy is boolean or vaultwarden_sso_master_password_policy | length > 0) %}SSO_MASTER_PASSWORD_POLICY={{ vaultwarden_sso_master_password_policy }}{% else %}# SSO_MASTER_PASSWORD_POLICY='{"enforceOnLogin":false,"minComplexity":3,"minLength":12,"requireLower":false,"requireNumbers":false,"requireSpecial":false,"requireUpper":false}'{% endif %}

## Use sso only for authentication not the session lifecycle
{% if vaultwarden_sso_auth_only_not_session is defined and vaultwarden_sso_auth_only_not_session is not none and (vaultwarden_sso_auth_only_not_session is number or vaultwarden_sso_auth_only_not_session is boolean or vaultwarden_sso_auth_only_not_session | length > 0) %}SSO_AUTH_ONLY_NOT_SESSION={{ vaultwarden_sso_auth_only_not_session }}{% else %}# SSO_AUTH_ONLY_NOT_SESSION=false{% endif %}

## Client cache for discovery endpoint. Duration in seconds (0 to disable).
{% if vaultwarden_sso_client_cache_expiration is defined and vaultwarden_sso_client_cache_expiration is not none and (vaultwarden_sso_client_cache_expiration is number or vaultwarden_sso_client_cache_expiration is boolean or vaultwarden_sso_client_cache_expiration | length > 0) %}SSO_CLIENT_CACHE_EXPIRATION={{ vaultwarden_sso_client_cache_expiration }}{% else %}# SSO_CLIENT_CACHE_EXPIRATION=0{% endif %}

