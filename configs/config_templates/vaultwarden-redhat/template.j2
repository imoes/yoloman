# shellcheck disable=SC2034,SC2148
## Vaultwarden Configuration File
## Uncomment any of the following lines to change the defaults
##
## Be aware that most of these settings will be overridden if they were changed
## in the admin interface. Those overrides are stored within DATA_FOLDER/config.json .
##
## By default, Vaultwarden expects for this file to be named ".env" and located
## in the current working directory. If this is not the case, the environment
## variable ENV_FILE can be set to the location of this file prior to starting
## Vaultwarden.

####################
### Data folders ###
####################

## Main data folder
## This can be a path to local folder or a path to an external location
## depending on features enabled at build time. Possible external locations:
##
## - AWS S3 Bucket (via `s3` feature): s3://bucket-name/path/to/folder
##
## When using an external location, make sure to set TMP_FOLDER,
## TEMPLATES_FOLDER, and DATABASE_URL to local paths and/or a remote database
## location.
{% if vaultwarden_data_folder is defined and vaultwarden_data_folder is not none and (vaultwarden_data_folder is number or vaultwarden_data_folder is boolean or vaultwarden_data_folder | length > 0) %}DATA_FOLDER={{ vaultwarden_data_folder }}{% else %}# DATA_FOLDER=/var/lib/vaultwarden{% endif %}

## Individual folders, these override %DATA_FOLDER%
{% if vaultwarden_rsa_key_filename is defined and vaultwarden_rsa_key_filename is not none and (vaultwarden_rsa_key_filename is number or vaultwarden_rsa_key_filename is boolean or vaultwarden_rsa_key_filename | length > 0) %}RSA_KEY_FILENAME={{ vaultwarden_rsa_key_filename }}{% else %}# RSA_KEY_FILENAME=data/rsa_key{% endif %}
{% if vaultwarden_icon_cache_folder is defined and vaultwarden_icon_cache_folder is not none and (vaultwarden_icon_cache_folder is number or vaultwarden_icon_cache_folder is boolean or vaultwarden_icon_cache_folder | length > 0) %}ICON_CACHE_FOLDER={{ vaultwarden_icon_cache_folder }}{% else %}# ICON_CACHE_FOLDER=data/icon_cache{% endif %}
{% if vaultwarden_attachments_folder is defined and vaultwarden_attachments_folder is not none and (vaultwarden_attachments_folder is number or vaultwarden_attachments_folder is boolean or vaultwarden_attachments_folder | length > 0) %}ATTACHMENTS_FOLDER={{ vaultwarden_attachments_folder }}{% else %}# ATTACHMENTS_FOLDER=data/attachments{% endif %}
{% if vaultwarden_sends_folder is defined and vaultwarden_sends_folder is not none and (vaultwarden_sends_folder is number or vaultwarden_sends_folder is boolean or vaultwarden_sends_folder | length > 0) %}SENDS_FOLDER={{ vaultwarden_sends_folder }}{% else %}# SENDS_FOLDER=data/sends{% endif %}

## Temporary folder used for storing temporary file uploads
## Must be a local path.
{% if vaultwarden_tmp_folder is defined and vaultwarden_tmp_folder is not none and (vaultwarden_tmp_folder is number or vaultwarden_tmp_folder is boolean or vaultwarden_tmp_folder | length > 0) %}TMP_FOLDER={{ vaultwarden_tmp_folder }}{% else %}# TMP_FOLDER=data/tmp{% endif %}

## HTML template overrides data folder
## Must be a local path.
{% if vaultwarden_templates_folder is defined and vaultwarden_templates_folder is not none and (vaultwarden_templates_folder is number or vaultwarden_templates_folder is boolean or vaultwarden_templates_folder | length > 0) %}TEMPLATES_FOLDER={{ vaultwarden_templates_folder }}{% else %}# TEMPLATES_FOLDER=data/templates{% endif %}
## Automatically reload the templates for every request, slow, use only for development
{% if vaultwarden_reload_templates is defined and vaultwarden_reload_templates is not none and (vaultwarden_reload_templates is number or vaultwarden_reload_templates is boolean or vaultwarden_reload_templates | length > 0) %}RELOAD_TEMPLATES={{ vaultwarden_reload_templates }}{% else %}# RELOAD_TEMPLATES=false{% endif %}

## Web vault settings
{% if vaultwarden_web_vault_folder is defined and vaultwarden_web_vault_folder is not none and (vaultwarden_web_vault_folder is number or vaultwarden_web_vault_folder is boolean or vaultwarden_web_vault_folder | length > 0) %}WEB_VAULT_FOLDER={{ vaultwarden_web_vault_folder }}{% else %}# WEB_VAULT_FOLDER=/usr/share/vaultwarden-web{% endif %}
{% if vaultwarden_web_vault_enabled is defined and vaultwarden_web_vault_enabled is not none and (vaultwarden_web_vault_enabled is number or vaultwarden_web_vault_enabled is boolean or vaultwarden_web_vault_enabled | length > 0) %}WEB_VAULT_ENABLED={{ vaultwarden_web_vault_enabled }}{% else %}# WEB_VAULT_ENABLED=true{% endif %}

#########################
### Database settings ###
#########################

## Database URL
## When using SQLite, this is the path to the DB file, and it defaults to
## %DATA_FOLDER%/db.sqlite3. If DATA_FOLDER is set to an external location, this
## must be set to a local sqlite3 file path.
{% if vaultwarden_database_url is defined and vaultwarden_database_url is not none and vaultwarden_database_url != '' %}DATABASE_URL={{ vaultwarden_database_url }}{% else %}# DATABASE_URL=data/db.sqlite3{% endif %}

## Enable WAL for the DB
## Set to false to avoid enabling WAL during startup.
## Note that if the DB already has WAL enabled, you will also need to disable WAL in the DB,
## this setting only prevents Vaultwarden from automatically enabling it on start.
## Please read project wiki page about this setting first before changing the value as it can
## cause performance degradation or might render the service unable to start.
{% if vaultwarden_enable_db_wal is defined and vaultwarden_enable_db_wal is not none and (vaultwarden_enable_db_wal is number or vaultwarden_enable_db_wal is boolean or vaultwarden_enable_db_wal | length > 0) %}ENABLE_DB_WAL={{ vaultwarden_enable_db_wal }}{% else %}# ENABLE_DB_WAL=true{% endif %}

## Database connection retries
## Number of times to retry the database connection during startup, with 1 second delay between each retry, set to 0 to retry indefinitely
{% if vaultwarden_db_connection_retries is defined and vaultwarden_db_connection_retries is not none and (vaultwarden_db_connection_retries is number or vaultwarden_db_connection_retries is boolean or vaultwarden_db_connection_retries | length > 0) %}DB_CONNECTION_RETRIES={{ vaultwarden_db_connection_retries }}{% else %}# DB_CONNECTION_RETRIES=15{% endif %}

## Database timeout
## Timeout when acquiring database connection
{% if vaultwarden_database_timeout is defined and vaultwarden_database_timeout is not none and (vaultwarden_database_timeout is number or vaultwarden_database_timeout is boolean or vaultwarden_database_timeout | length > 0) %}DATABASE_TIMEOUT={{ vaultwarden_database_timeout }}{% else %}# DATABASE_TIMEOUT=30{% endif %}

## Database idle timeout
## Timeout in seconds before idle connections to the database are closed.
{% if vaultwarden_database_idle_timeout is defined and vaultwarden_database_idle_timeout is not none and (vaultwarden_database_idle_timeout is number or vaultwarden_database_idle_timeout is boolean or vaultwarden_database_idle_timeout | length > 0) %}DATABASE_IDLE_TIMEOUT={{ vaultwarden_database_idle_timeout }}{% else %}# DATABASE_IDLE_TIMEOUT=600{% endif %}

## Database min connections
## Define the minimum size of the connection pool used for connecting to the database.
{% if vaultwarden_database_min_conns is defined and vaultwarden_database_min_conns is not none and (vaultwarden_database_min_conns is number or vaultwarden_database_min_conns is boolean or vaultwarden_database_min_conns | length > 0) %}DATABASE_MIN_CONNS={{ vaultwarden_database_min_conns }}{% else %}# DATABASE_MIN_CONNS=2{% endif %}

## Database max connections
## Define the maximum size of the connection pool used for connecting to the database.
{% if vaultwarden_database_max_conns is defined and vaultwarden_database_max_conns is not none and (vaultwarden_database_max_conns is number or vaultwarden_database_max_conns is boolean or vaultwarden_database_max_conns | length > 0) %}DATABASE_MAX_CONNS={{ vaultwarden_database_max_conns }}{% else %}# DATABASE_MAX_CONNS=10{% endif %}

## Database connection initialization
## Allows SQL statements to be run whenever a new database connection is created.
## This is mainly useful for connection-scoped pragmas.
## If empty, a database-specific default is used:
## - SQLite: "PRAGMA busy_timeout = 5000; PRAGMA synchronous = NORMAL;"
## - MySQL: ""
## - PostgreSQL: ""
{% if vaultwarden_database_conn_init is defined and vaultwarden_database_conn_init is not none and (vaultwarden_database_conn_init is number or vaultwarden_database_conn_init is boolean or vaultwarden_database_conn_init | length > 0) %}DATABASE_CONN_INIT={{ vaultwarden_database_conn_init }}{% else %}# DATABASE_CONN_INIT=""{% endif %}

#################
### WebSocket ###
#################

## Enable websocket notifications
{% if vaultwarden_enable_websocket is defined and vaultwarden_enable_websocket is not none and (vaultwarden_enable_websocket is number or vaultwarden_enable_websocket is boolean or vaultwarden_enable_websocket | length > 0) %}ENABLE_WEBSOCKET={{ vaultwarden_enable_websocket }}{% else %}# ENABLE_WEBSOCKET=true{% endif %}

##########################
### Push notifications ###
##########################

## Enables push notifications (requires key and id from https://bitwarden.com/host)
## Details about mobile client push notification:
## - https://github.com/dani-garcia/vaultwarden/wiki/Enabling-Mobile-Client-push-notification
{% if vaultwarden_push_enabled is defined and vaultwarden_push_enabled is not none and (vaultwarden_push_enabled is number or vaultwarden_push_enabled is boolean or vaultwarden_push_enabled | length > 0) %}PUSH_ENABLED={{ vaultwarden_push_enabled }}{% else %}# PUSH_ENABLED=false{% endif %}
{% if vaultwarden_push_installation_id is defined and vaultwarden_push_installation_id is not none and (vaultwarden_push_installation_id is number or vaultwarden_push_installation_id is boolean or vaultwarden_push_installation_id | length > 0) %}PUSH_INSTALLATION_ID={{ vaultwarden_push_installation_id }}{% else %}# PUSH_INSTALLATION_ID=CHANGEME{% endif %}
{% if vaultwarden_push_installation_key is defined and vaultwarden_push_installation_key is not none and (vaultwarden_push_installation_key is number or vaultwarden_push_installation_key is boolean or vaultwarden_push_installation_key | length > 0) %}PUSH_INSTALLATION_KEY={{ vaultwarden_push_installation_key }}{% else %}# PUSH_INSTALLATION_KEY=CHANGEME{% endif %}

# WARNING: Do not modify the following settings unless you fully understand their implications!
# Default Push Relay and Identity URIs
{% if vaultwarden_push_relay_uri is defined and vaultwarden_push_relay_uri is not none and vaultwarden_push_relay_uri != '' %}PUSH_RELAY_URI={{ vaultwarden_push_relay_uri }}{% else %}# PUSH_RELAY_URI=https://push.bitwarden.com{% endif %}
{% if vaultwarden_push_identity_uri is defined and vaultwarden_push_identity_uri is not none and vaultwarden_push_identity_uri != '' %}PUSH_IDENTITY_URI={{ vaultwarden_push_identity_uri }}{% else %}# PUSH_IDENTITY_URI=https://identity.bitwarden.com{% endif %}

#####################
### Schedule jobs ###
#####################

## Job scheduler settings
##
## Job schedules use a cron-like syntax (as parsed by https://crates.io/crates/cron),
## and are always in terms of UTC time (regardless of your local time zone settings).
##
## The schedule format is a bit different from crontab as crontab does not contains seconds.
## You can test the format here: https://crontab.guru, but remove the first digit!
## SEC  MIN   HOUR   DAY OF MONTH    MONTH   DAY OF WEEK
## "0   30   9,12,15     1,15       May-Aug  Mon,Wed,Fri"
## "0   30     *          *            *          *     "
## "0   30     1          *            *          *     "
##
## How often (in ms) the job scheduler thread checks for jobs that need running.
## Set to 0 to globally disable scheduled jobs.
{% if vaultwarden_job_poll_interval_ms is defined and vaultwarden_job_poll_interval_ms is not none and (vaultwarden_job_poll_interval_ms is number or vaultwarden_job_poll_interval_ms is boolean or vaultwarden_job_poll_interval_ms | length > 0) %}JOB_POLL_INTERVAL_MS={{ vaultwarden_job_poll_interval_ms }}{% else %}# JOB_POLL_INTERVAL_MS=30000{% endif %}
##
## Cron schedule of the job that checks for Sends past their deletion date.
## Defaults to hourly (5 minutes after the hour). Set blank to disable this job.
{% if vaultwarden_send_purge_schedule is defined and vaultwarden_send_purge_schedule is not none and (vaultwarden_send_purge_schedule is number or vaultwarden_send_purge_schedule is boolean or vaultwarden_send_purge_schedule | length > 0) %}SEND_PURGE_SCHEDULE={{ vaultwarden_send_purge_schedule }}{% else %}# SEND_PURGE_SCHEDULE="0 5 * * * *"{% endif %}
##
## Cron schedule of the job that checks for trashed items to delete permanently.
## Defaults to daily (5 minutes after midnight). Set blank to disable this job.
{% if vaultwarden_trash_purge_schedule is defined and vaultwarden_trash_purge_schedule is not none and (vaultwarden_trash_purge_schedule is number or vaultwarden_trash_purge_schedule is boolean or vaultwarden_trash_purge_schedule | length > 0) %}TRASH_PURGE_SCHEDULE={{ vaultwarden_trash_purge_schedule }}{% else %}# TRASH_PURGE_SCHEDULE="0 5 0 * * *"{% endif %}
##
## Cron schedule of the job that checks for incomplete 2FA logins.
## Defaults to once every minute. Set blank to disable this job.
{% if vaultwarden_incomplete_2fa_schedule is defined and vaultwarden_incomplete_2fa_schedule is not none and (vaultwarden_incomplete_2fa_schedule is number or vaultwarden_incomplete_2fa_schedule is boolean or vaultwarden_incomplete_2fa_schedule | length > 0) %}INCOMPLETE_2FA_SCHEDULE={{ vaultwarden_incomplete_2fa_schedule }}{% else %}# INCOMPLETE_2FA_SCHEDULE="30 * * * * *"{% endif %}
##
## Cron schedule of the job that sends expiration reminders to emergency access grantors.
## Defaults to hourly (3 minutes after the hour). Set blank to disable this job.
{% if vaultwarden_emergency_notification_reminder_schedule is defined and vaultwarden_emergency_notification_reminder_schedule is not none and (vaultwarden_emergency_notification_reminder_schedule is number or vaultwarden_emergency_notification_reminder_schedule is boolean or vaultwarden_emergency_notification_reminder_schedule | length > 0) %}EMERGENCY_NOTIFICATION_REMINDER_SCHEDULE={{ vaultwarden_emergency_notification_reminder_schedule }}{% else %}# EMERGENCY_NOTIFICATION_REMINDER_SCHEDULE="0 3 * * * *"{% endif %}
##
## Cron schedule of the job that grants emergency access requests that have met the required wait time.
## Defaults to hourly (7 minutes after the hour). Set blank to disable this job.
{% if vaultwarden_emergency_request_timeout_schedule is defined and vaultwarden_emergency_request_timeout_schedule is not none and (vaultwarden_emergency_request_timeout_schedule is number or vaultwarden_emergency_request_timeout_schedule is boolean or vaultwarden_emergency_request_timeout_schedule | length > 0) %}EMERGENCY_REQUEST_TIMEOUT_SCHEDULE={{ vaultwarden_emergency_request_timeout_schedule }}{% else %}# EMERGENCY_REQUEST_TIMEOUT_SCHEDULE="0 7 * * * *"{% endif %}
##
## Cron schedule of the job that cleans old events from the event table.
## Defaults to daily. Set blank to disable this job. Also without EVENTS_DAYS_RETAIN set, this job will not start.
{% if vaultwarden_event_cleanup_schedule is defined and vaultwarden_event_cleanup_schedule is not none and (vaultwarden_event_cleanup_schedule is number or vaultwarden_event_cleanup_schedule is boolean or vaultwarden_event_cleanup_schedule | length > 0) %}EVENT_CLEANUP_SCHEDULE={{ vaultwarden_event_cleanup_schedule }}{% else %}# EVENT_CLEANUP_SCHEDULE="0 10 0 * * *"{% endif %}
## Number of days to retain events stored in the database.
## If unset (the default), events are kept indefinitely and the scheduled job is disabled!
{% if vaultwarden_events_days_retain is defined and vaultwarden_events_days_retain is not none and (vaultwarden_events_days_retain is number or vaultwarden_events_days_retain is boolean or vaultwarden_events_days_retain | length > 0) %}EVENTS_DAYS_RETAIN={{ vaultwarden_events_days_retain }}{% else %}# EVENTS_DAYS_RETAIN={% endif %}
##
## Cron schedule of the job that cleans old auth requests from the auth request.
## Defaults to every minute. Set blank to disable this job.
{% if vaultwarden_auth_request_purge_schedule is defined and vaultwarden_auth_request_purge_schedule is not none and (vaultwarden_auth_request_purge_schedule is number or vaultwarden_auth_request_purge_schedule is boolean or vaultwarden_auth_request_purge_schedule | length > 0) %}AUTH_REQUEST_PURGE_SCHEDULE={{ vaultwarden_auth_request_purge_schedule }}{% else %}# AUTH_REQUEST_PURGE_SCHEDULE="30 * * * * *"{% endif %}
##
## Cron schedule of the job that cleans expired Duo contexts from the database. Does nothing if Duo MFA is disabled or set to use the legacy iframe prompt.
## Defaults to every minute. Set blank to disable this job.
{% if vaultwarden_duo_context_purge_schedule is defined and vaultwarden_duo_context_purge_schedule is not none and (vaultwarden_duo_context_purge_schedule is number or vaultwarden_duo_context_purge_schedule is boolean or vaultwarden_duo_context_purge_schedule | length > 0) %}DUO_CONTEXT_PURGE_SCHEDULE={{ vaultwarden_duo_context_purge_schedule }}{% else %}# DUO_CONTEXT_PURGE_SCHEDULE="30 * * * * *"{% endif %}
#
## Cron schedule of the job that cleans sso auth from incomplete flow
## Defaults to daily (20 minutes after midnight). Set blank to disable this job.
{% if vaultwarden_purge_incomplete_sso_auth is defined and vaultwarden_purge_incomplete_sso_auth is not none and (vaultwarden_purge_incomplete_sso_auth is number or vaultwarden_purge_incomplete_sso_auth is boolean or vaultwarden_purge_incomplete_sso_auth | length > 0) %}PURGE_INCOMPLETE_SSO_AUTH={{ vaultwarden_purge_incomplete_sso_auth }}{% else %}# PURGE_INCOMPLETE_SSO_AUTH="0 20 0 * * *"{% endif %}

########################
### General settings ###
########################

## Domain settings
## The domain must match the address from where you access the server
## It's recommended to configure this value, otherwise certain functionality might not work,
## like attachment downloads, email links and U2F.
## For U2F to work, the server must use HTTPS, you can use Let's Encrypt for free certs
## To use HTTPS, the recommended way is to put Vaultwarden behind a reverse proxy
## Details:
## - https://github.com/dani-garcia/vaultwarden/wiki/Enabling-HTTPS
## - https://github.com/dani-garcia/vaultwarden/wiki/Proxy-examples
## For development
{% if vaultwarden_domain is defined and vaultwarden_domain is not none and vaultwarden_domain != '' %}DOMAIN={{ vaultwarden_domain }}{% else %}# DOMAIN=http://localhost{% endif %}
## Controls whether users are allowed to create Bitwarden Sends.
## This setting applies globally to all users.
## To control this on a per-org basis instead, use the "Disable Send" org policy.
{% if vaultwarden_sends_allowed is defined and vaultwarden_sends_allowed is not none and (vaultwarden_sends_allowed is number or vaultwarden_sends_allowed is boolean or vaultwarden_sends_allowed | length > 0) %}SENDS_ALLOWED={{ vaultwarden_sends_allowed }}{% else %}# SENDS_ALLOWED=true{% endif %}

## HIBP Api Key
## HaveIBeenPwned API Key, request it here: https://haveibeenpwned.com/API/Key
{% if vaultwarden_hibp_api_key is defined and vaultwarden_hibp_api_key is not none and (vaultwarden_hibp_api_key is number or vaultwarden_hibp_api_key is boolean or vaultwarden_hibp_api_key | length > 0) %}HIBP_API_KEY={{ vaultwarden_hibp_api_key }}{% else %}# HIBP_API_KEY={% endif %}

## Per-organization attachment storage limit (KB)
## Max kilobytes of attachment storage allowed per organization.
## When this limit is reached, organization members will not be allowed to upload further attachments for ciphers owned by that organization.
{% if vaultwarden_org_attachment_limit is defined and vaultwarden_org_attachment_limit is not none and (vaultwarden_org_attachment_limit is number or vaultwarden_org_attachment_limit is boolean or vaultwarden_org_attachment_limit | length > 0) %}ORG_ATTACHMENT_LIMIT={{ vaultwarden_org_attachment_limit }}{% else %}# ORG_ATTACHMENT_LIMIT={% endif %}
## Per-user attachment storage limit (KB)
## Max kilobytes of attachment storage allowed per user.
## When this limit is reached, the user will not be allowed to upload further attachments.
{% if vaultwarden_user_attachment_limit is defined and vaultwarden_user_attachment_limit is not none and (vaultwarden_user_attachment_limit is number or vaultwarden_user_attachment_limit is boolean or vaultwarden_user_attachment_limit | length > 0) %}USER_ATTACHMENT_LIMIT={{ vaultwarden_user_attachment_limit }}{% else %}# USER_ATTACHMENT_LIMIT={% endif %}
## Per-user send storage limit (KB)
## Max kilobytes of send storage allowed per user.
## When this limit is reached, the user will not be allowed to upload further sends.
{% if vaultwarden_user_send_limit is defined and vaultwarden_user_send_limit is not none and (vaultwarden_user_send_limit is number or vaultwarden_user_send_limit is boolean or vaultwarden_user_send_limit | length > 0) %}USER_SEND_LIMIT={{ vaultwarden_user_send_limit }}{% else %}# USER_SEND_LIMIT={% endif %}

## Number of days to wait before auto-deleting a trashed item.
## If unset (the default), trashed items are not auto-deleted.
## This setting applies globally, so make sure to inform all users of any changes to this setting.
{% if vaultwarden_trash_auto_delete_days is defined and vaultwarden_trash_auto_delete_days is not none and (vaultwarden_trash_auto_delete_days is number or vaultwarden_trash_auto_delete_days is boolean or vaultwarden_trash_auto_delete_days | length > 0) %}TRASH_AUTO_DELETE_DAYS={{ vaultwarden_trash_auto_delete_days }}{% else %}# TRASH_AUTO_DELETE_DAYS={% endif %}

## Number of minutes to wait before a 2FA-enabled login is considered incomplete,
## resulting in an email notification. An incomplete 2FA login is one where the correct
## master password was provided but the required 2FA step was not completed, which
## potentially indicates a master password compromise. Set to 0 to disable this check.
## This setting applies globally to all users.
{% if vaultwarden_incomplete_2fa_time_limit is defined and vaultwarden_incomplete_2fa_time_limit is not none and (vaultwarden_incomplete_2fa_time_limit is number or vaultwarden_incomplete_2fa_time_limit is boolean or vaultwarden_incomplete_2fa_time_limit | length > 0) %}INCOMPLETE_2FA_TIME_LIMIT={{ vaultwarden_incomplete_2fa_time_limit }}{% else %}# INCOMPLETE_2FA_TIME_LIMIT=3{% endif %}

## Disable icon downloading
## Set to true to disable icon downloading in the internal icon service.
## This still serves existing icons from $ICON_CACHE_FOLDER, without generating any external
## network requests. $ICON_CACHE_TTL must also be set to 0; otherwise, the existing icons
## will be deleted eventually, but won't be downloaded again.
{% if vaultwarden_disable_icon_download is defined and vaultwarden_disable_icon_download is not none and (vaultwarden_disable_icon_download is number or vaultwarden_disable_icon_download is boolean or vaultwarden_disable_icon_download | length > 0) %}DISABLE_ICON_DOWNLOAD={{ vaultwarden_disable_icon_download }}{% else %}# DISABLE_ICON_DOWNLOAD=false{% endif %}

## Controls if new users can register
{% if vaultwarden_signups_allowed is defined and vaultwarden_signups_allowed is not none and (vaultwarden_signups_allowed is number or vaultwarden_signups_allowed is boolean or vaultwarden_signups_allowed | length > 0) %}SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed }}{% else %}# SIGNUPS_ALLOWED=true{% endif %}

## Controls if new users need to verify their email address upon registration
## On new client versions, this will require the user to verify their email at signup time.
## On older clients, it will require the user to verify their email before they can log in.
## The welcome email will include a verification link, and login attempts will periodically
## trigger another verification email to be sent.
{% if vaultwarden_signups_verify is defined and vaultwarden_signups_verify is not none and (vaultwarden_signups_verify is number or vaultwarden_signups_verify is boolean or vaultwarden_signups_verify | length > 0) %}SIGNUPS_VERIFY={{ vaultwarden_signups_verify }}{% else %}# SIGNUPS_VERIFY=false{% endif %}

## If SIGNUPS_VERIFY is set to true, this limits how many seconds after the last time
## an email verification link has been sent another verification email will be sent
{% if vaultwarden_signups_verify_resend_time is defined and vaultwarden_signups_verify_resend_time is not none and (vaultwarden_signups_verify_resend_time is number or vaultwarden_signups_verify_resend_time is boolean or vaultwarden_signups_verify_resend_time | length > 0) %}SIGNUPS_VERIFY_RESEND_TIME={{ vaultwarden_signups_verify_resend_time }}{% else %}# SIGNUPS_VERIFY_RESEND_TIME=3600{% endif %}

## If SIGNUPS_VERIFY is set to true, this limits how many times an email verification
## email will be re-sent upon an attempted login.
{% if vaultwarden_signups_verify_resend_limit is defined and vaultwarden_signups_verify_resend_limit is not none and (vaultwarden_signups_verify_resend_limit is number or vaultwarden_signups_verify_resend_limit is boolean or vaultwarden_signups_verify_resend_limit | length > 0) %}SIGNUPS_VERIFY_RESEND_LIMIT={{ vaultwarden_signups_verify_resend_limit }}{% else %}# SIGNUPS_VERIFY_RESEND_LIMIT=6{% endif %}

## Controls if new users from a list of comma-separated domains can register
## even if SIGNUPS_ALLOWED is set to false
{% if vaultwarden_signups_domains_whitelist is defined and vaultwarden_signups_domains_whitelist is not none and (vaultwarden_signups_domains_whitelist is number or vaultwarden_signups_domains_whitelist is boolean or vaultwarden_signups_domains_whitelist | length > 0) %}SIGNUPS_DOMAINS_WHITELIST={{ vaultwarden_signups_domains_whitelist }}{% else %}# SIGNUPS_DOMAINS_WHITELIST=example.com,example.net,example.org{% endif %}

## Controls whether event logging is enabled for organizations
## This setting applies to organizations.
## Disabled by default. Also check the EVENT_CLEANUP_SCHEDULE and EVENTS_DAYS_RETAIN settings.
{% if vaultwarden_org_events_enabled is defined and vaultwarden_org_events_enabled is not none and (vaultwarden_org_events_enabled is number or vaultwarden_org_events_enabled is boolean or vaultwarden_org_events_enabled | length > 0) %}ORG_EVENTS_ENABLED={{ vaultwarden_org_events_enabled }}{% else %}# ORG_EVENTS_ENABLED=false{% endif %}

## Controls which users can create new orgs.
