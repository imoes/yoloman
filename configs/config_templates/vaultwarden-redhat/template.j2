########################
### MFA/2FA settings ###
########################

## Yubico (Yubikey) Settings
## Set your Client ID and Secret Key for Yubikey OTP
## You can generate it here: https://upgrade.yubico.com/getapikey/
## You can optionally specify a custom OTP server
{% if vaultwarden_yubico_client_id is defined and vaultwarden_yubico_client_id is not none and (vaultwarden_yubico_client_id is number or vaultwarden_yubico_client_id is boolean or vaultwarden_yubico_client_id | length > 0) %}YUBICO_CLIENT_ID={{ vaultwarden_yubico_client_id }}{% else %}# YUBICO_CLIENT_ID=11111{% endif %}
{% if vaultwarden_yubico_secret_key is defined and vaultwarden_yubico_secret_key is not none and (vaultwarden_yubico_secret_key is number or vaultwarden_yubico_secret_key is boolean or vaultwarden_yubico_secret_key | length > 0) %}YUBICO_SECRET_KEY={{ vaultwarden_yubico_secret_key }}{% else %}# YUBICO_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAA{% endif %}
{% if vaultwarden_yubico_server is defined and vaultwarden_yubico_server is not none and (vaultwarden_yubico_server is number or vaultwarden_yubico_server is boolean or vaultwarden_yubico_server | length > 0) %}YUBICO_SERVER={{ vaultwarden_yubico_server }}{% else %}# YUBICO_SERVER=http://yourdomain.com/wsapi/2.0/verify{% endif %}

## Duo Settings
## You need to configure the DUO_IKEY, DUO_SKEY, and DUO_HOST options to enable global Duo support.
## Otherwise users will need to configure it themselves.
## Create an account and protect an application as mentioned in this link (only the first step, not the rest):
## https://help.bitwarden.com/article/setup-two-step-login-duo/#create-a-duo-security-account
## Then set the following options, based on the values obtained from the last step:
{% if vaultwarden_duo_ikey is defined and vaultwarden_duo_ikey is not none and (vaultwarden_duo_ikey is number or vaultwarden_duo_ikey is boolean or vaultwarden_duo_ikey | length > 0) %}DUO_IKEY={{ vaultwarden_duo_ikey }}{% else %}# DUO_IKEY=<Client ID>{% endif %}
{% if vaultwarden_duo_skey is defined and vaultwarden_duo_skey is not none and (vaultwarden_duo_skey is number or vaultwarden_duo_skey is boolean or vaultwarden_duo_skey | length > 0) %}DUO_SKEY={{ vaultwarden_duo_skey }}{% else %}# DUO_SKEY=<Client Secret>{% endif %}
{% if vaultwarden_duo_host is defined and vaultwarden_duo_host is not none and (vaultwarden_duo_host is number or vaultwarden_duo_host is boolean or vaultwarden_duo_host | length > 0) %}DUO_HOST={{ vaultwarden_duo_host }}{% else %}# DUO_HOST=<API Hostname>{% endif %}
## After that, you should be able to follow the rest of the guide linked above,
## ignoring the fields that ask for the values that you already configured beforehand.
##
## If you want to attempt to use Duo's 'Traditional Prompt' (deprecated, iframe based) set DUO_USE_IFRAME to 'true'.
## Duo no longer supports this, but it still works for some integrations.
## If you aren't sure, leave this alone.
{% if vaultwarden_duo_use_iframe is defined and vaultwarden_duo_use_iframe is not none and (vaultwarden_duo_use_iframe is number or vaultwarden_duo_use_iframe is boolean or vaultwarden_duo_use_iframe | length > 0) %}DUO_USE_IFRAME={{ vaultwarden_duo_use_iframe }}{% else %}# DUO_USE_IFRAME=false{% endif %}

## Email 2FA settings
## Email token size
## Number of digits in an email 2FA token (min: 6, max: 255).
## Note that the Bitwarden clients are hardcoded to mention 6 digit codes regardless of this setting!
{% if vaultwarden_email_token_size is defined and vaultwarden_email_token_size is not none and (vaultwarden_email_token_size is number or vaultwarden_email_token_size is boolean or vaultwarden_email_token_size | length > 0) %}EMAIL_TOKEN_SIZE={{ vaultwarden_email_token_size }}{% else %}# EMAIL_TOKEN_SIZE=6{% endif %}
##
## Token expiration time
## Maximum time in seconds a token is valid. The time the user has to open email client and copy token.
{% if vaultwarden_email_expiration_time is defined and vaultwarden_email_expiration_time is not none and (vaultwarden_email_expiration_time is number or vaultwarden_email_expiration_time is boolean or vaultwarden_email_expiration_time | length > 0) %}EMAIL_EXPIRATION_TIME={{ vaultwarden_email_expiration_time }}{% else %}# EMAIL_EXPIRATION_TIME=600{% endif %}
##
## Maximum attempts before an email token is reset and a new email will need to be sent.
{% if vaultwarden_email_attempts_limit is defined and vaultwarden_email_attempts_limit is not none and (vaultwarden_email_attempts_limit is number or vaultwarden_email_attempts_limit is boolean or vaultwarden_email_attempts_limit | length > 0) %}EMAIL_ATTEMPTS_LIMIT={{ vaultwarden_email_attempts_limit }}{% else %}# EMAIL_ATTEMPTS_LIMIT=3{% endif %}
##
## Setup email 2FA on registration regardless of any organization policy
{% if vaultwarden_email_2fa_enforce_on_verified_invite is defined and vaultwarden_email_2fa_enforce_on_verified_invite is not none and (vaultwarden_email_2fa_enforce_on_verified_invite is number or vaultwarden_email_2fa_enforce_on_verified_invite is boolean or vaultwarden_email_2fa_enforce_on_verified_invite | length > 0) %}EMAIL_2FA_ENFORCE_ON_VERIFIED_INVITE={{ vaultwarden_email_2fa_enforce_on_verified_invite }}{% else %}# EMAIL_2FA_ENFORCE_ON_VERIFIED_INVITE=false{% endif %}
## Automatically setup email 2FA as fallback provider when needed
{% if vaultwarden_email_2fa_auto_fallback is defined and vaultwarden_email_2fa_auto_fallback is not none and (vaultwarden_email_2fa_auto_fallback is number or vaultwarden_email_2fa_auto_fallback is boolean or vaultwarden_email_2fa_auto_fallback | length > 0) %}EMAIL_2FA_AUTO_FALLBACK={{ vaultwarden_email_2fa_auto_fallback }}{% else %}# EMAIL_2FA_AUTO_FALLBACK=false{% endif %}

## Other MFA/2FA settings
## Disable 2FA remember
## Enabling this would force the users to use a second factor to login every time.
## Note that the checkbox would still be present, but ignored.
{% if vaultwarden_disable_2fa_remember is defined and vaultwarden_disable_2fa_remember is not none and (vaultwarden_disable_2fa_remember is number or vaultwarden_disable_2fa_remember is boolean or vaultwarden_disable_2fa_remember | length > 0) %}DISABLE_2FA_REMEMBER={{ vaultwarden_disable_2fa_remember }}{% else %}# DISABLE_2FA_REMEMBER=false{% endif %}
##
## Authenticator Settings
## Disable authenticator time drifted codes to be valid.
## TOTP codes of the previous and next 30 seconds will be invalid
##
## According to the RFC6238 (https://tools.ietf.org/html/rfc6238),
## we allow by default the TOTP code which was valid one step back and one in the future.
## This can however allow attackers to be a bit more lucky with their attempts because there are 3 valid codes.
## You can disable this, so that only the current TOTP Code is allowed.
## Keep in mind that when a sever drifts out of time, valid codes could be marked as invalid.
## In any case, if a code has been used it can not be used again, also codes which predates it will be invalid.
{% if vaultwarden_authenticator_disable_time_drift is defined and vaultwarden_authenticator_disable_time_drift is not none and (vaultwarden_authenticator_disable_time_drift is number or vaultwarden_authenticator_disable_time_drift is boolean or vaultwarden_authenticator_disable_time_drift | length > 0) %}AUTHENTICATOR_DISABLE_TIME_DRIFT={{ vaultwarden_authenticator_disable_time_drift }}{% else %}# AUTHENTICATOR_DISABLE_TIME_DRIFT=false{% endif %}

