[DEFAULT]
# The name of the node running this conductor service
#host = {{ host }}

# The RPC backend used for communication between services
#transport_url = {{ transport_url }}

# Logging configuration
#debug = {{ debug | lower }}
#verbose = {{ verbose | lower }}

# Path to the logging configuration file
#log_file = {{ log_file }}
#log_dir = {{ log_dir }}

# API configuration
[api]
# Host to bind the API to
#host = {{ api.host }}

# Port to bind the API to
#port = {{ api.port }}

# Enable or disable API authentication (for testing only!)
#auth_strategy = {{ api.auth_strategy }}

# Database connection string
[database]
# The SQLAlchemy database connection string
#connection = {{ database.connection }}

# Backend for resource providers
[resource_provider]
# The name of the resource provider driver
#driver = {{ resource_provider.driver }}

# Authentication configuration (keystone)
[keystone_authtoken]
# Auth URI (Keystone endpoint)
#auth_uri = {{ keystone_authtoken.auth_uri }}

# Project domain name
#project_domain_name = {{ keystone_authtoken.project_domain_name }}

# User domain name
#user_domain_name = {{ keystone_authtoken.user_domain_name }}

# Project name
#project_name = {{ keystone_authtoken.project_name }}

# Username
#username = {{ keystone_authtoken.username }}

# Password
#password = {{ keystone_authtoken.password }}

# Auth URL (Keystone admin endpoint)
#auth_url = {{ keystone_authtoken.auth_url }}

# Oslo messaging configuration
[oslo_messaging_rabbit]
# RabbitMQ host
#host = {{ oslo_messaging_rabbit.host }}

# RabbitMQ port
#port = {{ oslo_messaging_rabbit.port }}

# RabbitMQ user
#user = {{ oslo_messaging_rabbit.user }}

# RabbitMQ password
#password = {{ oslo_messaging_rabbit.password }}

# RabbitMQ virtual host
#virtual_host = {{ oslo_messaging_rabbit.virtual_host }}

# RPC worker threads
[conductor]
# Number of RPC workers
#workers = {{ conductor.workers }}

# Accelerator drivers to enable
# NOTE: Typically loaded dynamically, but may be preconfigured
[accelerators]
# List of enabled accelerator drivers (comma-separated)
#enabled_drivers = {{ enabled_drivers | join(', ') }}