{
  "host": "cyborg-conductor-01",
  "transport_url": "rabbit://cyborg:secretrabbit@controller:5672/",
  "debug": false,
  "verbose": true,
  "log_file": "/var/log/cyborg/conductor.log",
  "log_dir": "/var/log/cyborg",
  "api": {
    "host": "0.0.0.0",
    "port": 6666,
    "auth_strategy": "keystone"
  },
  "database": {
    "connection": "mysql+pymysql://cyborg:cyborg_db_pass@controller/cyborg?charset=utf8"
  },
  "resource_provider": {
    "driver": "cyborg.accelerator.driver.fpga.intel.FPGADriver"
  },
  "keystone_authtoken": {
    "auth_uri": "http://controller:5000",
    "project_domain_name": "Default",
    "user_domain_name": "Default",
    "project_name": "service",
    "username": "cyborg",
    "password": "CYBORG_SERVICE_PASSWORD",
    "auth_url": "http://controller:35357"
  },
  "memcached_servers": [
    "controller:11211"
  ],
  "oslo_messaging_rabbit": {
    "host": "controller",
    "port": 5672,
    "user": "cyborg",
    "password": "secretrabbit",
    "virtual_host": "/"
  },
  "conductor": {
    "workers": 2,
    "api_workers": 2
  },
  "enabled_drivers": [
    "fpga.intel"
  ]
}
