{
  "interface": "eth0",
  "filter": "tcp port 80 and host 192.168.1.10",
  "max_packets": 10000,
  "output_mode": "text",
  "verbose_data": false,
  "snaplen": 1500,
  "timestamp_format": "full",
  "include_link_layer": true,
  "rotate_size_mb": 50,
  "rotate_count": 5,
  "output_file": "/var/log/ipgrab/packets.log",
  "daemonize": true,
  "pid_file": "/var/run/ipgrab/ipgrab.pid",
  "extra_interfaces": [
    "wlan0"
  ],
  "use_buffering": true,
  "buffer_size": 5000,
  "buffer_timeout_ms": 200,
  "use_priority_filter": false,
  "min_priority": 0
}
