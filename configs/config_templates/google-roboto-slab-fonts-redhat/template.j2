<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Fontconfig alias configuration for Google Roboto Slab fonts. -->
<!-- This file defines the font family aliases for the 'serif' group and the 'Roboto Slab' specific family. -->
<fontconfig>
  <!-- Alias definition for the generic 'serif' font family. -->
  <alias>
    <!-- The target family name that applications requesting 'serif' will receive. -->
    <family>serif</family>
    <!-- The preferred font family to use when 'serif' is requested. -->
    <default>
      <!-- The primary font family to use for the serif alias. Default: Roboto Slab. -->
      <family>{{ font_default_family | default('Roboto Slab') }}</family>
    </default>
  </alias>

  <!-- Alias definition for the specific 'Roboto Slab' font family. -->
  <alias>
    <!-- The specific font family name being aliased. -->
    <family>Roboto Slab</family>
    <!-- The fallback font family to use if 'Roboto Slab' is not installed or fails. -->
    <default>
      <!-- The fallback font family for the Roboto Slab alias. Default: serif. -->
      <family>{{ font_fallback_family | default('serif') }}</family>
    </default>
  </alias>
</fontconfig>
