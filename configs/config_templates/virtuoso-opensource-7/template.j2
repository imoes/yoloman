# Defaults for the virtuoso initscript, from virtuoso-opensource
# This file is used by the init system to pass defaults to the Virtuoso SPARQL server.
# It is primarily consumed by the systemd service or SysV init script.

# # The directory from where the database files are placed, defined by a relative path in the configfile.
# # Schema field: db_path (string)
# # Default: /var/lib/virtuoso-opensource-7/db
DBPATH={{ db_path | default('/var/lib/virtuoso-opensource-7/db') }}

# # Daemonic options for the Virtuoso server.
# # The +wait flag ensures the daemon waits for database initialization.
# # The +configfile flag points to the main configuration file (virtuoso.ini).
# # WARNING: Removing the +wait flag breaks the init script!
# # This is a static configuration derived from package defaults; users should edit
# # /etc/virtuoso-opensource-7/virtuoso.ini for runtime configuration.
DAEMON_OPTS="+wait +configfile /etc/virtuoso-opensource-7/virtuoso.ini"

# # Security Reminder:
# # Remember to change passwords right after startup.
# # Read README.Debian for information on how to do so.