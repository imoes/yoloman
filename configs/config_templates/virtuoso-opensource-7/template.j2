# Defaults for the virtuoso initscript, from virtuoso-opensource
#
# This file configures the basic startup environment for Virtuoso Open Source.
# Most functional tuning is done in /etc/virtuoso-opensource-7/virtuoso.ini.

# ==============================================================================
# Database Path Configuration
# ==============================================================================
# Description: The directory from where the database files are placed.
#              Note: The underlying virtuoso.ini treats this as a relative path
#              from the configuration file's directory, but in this init script
#              context, it is often used to define the working directory or
#              absolute base path for data storage depending on the wrapper.
#              Default: /var/lib/virtuoso-opensource-7/db
DBPATH={{ db_path | default('/var/lib/virtuoso-opensource-7/db') }}

# ==============================================================================
# Daemon Startup Options
# ==============================================================================
# Description: Options passed to the Virtuoso daemon at startup.
#              +wait: Ensures the daemon waits for connections before exiting
#                       (critical for init scripts to detect startup success).
#              +configfile: Explicitly points to the main INI configuration file.
DAEMON_OPTS="{{ '+wait +configfile /etc/virtuoso-opensource-7/virtuoso.ini' }}"

# ==============================================================================
# Security and Maintenance Notes
# ==============================================================================
# WARNING: Remember to change passwords right after startup.
#          Default credentials are often weak.
#          Read /usr/share/doc/virtuoso-opensource-7/README.Debian for
#          detailed information on security hardening and password changes.
