# ==============================================================================
# PCP (Performance Co-Pilot) Configuration Template
# ==============================================================================
# This file configures the core PCP daemons: PMCD (Collector), PMLOGGER (Archiver),
# PMIE (Inference Engine), and PMWEBD (Web UI).
# ==============================================================================

# ------------------------------------------------------------------------------
# PMCD (Performance Metrics Collector Daemon) Configuration
# ------------------------------------------------------------------------------

# TCP port used by the Performance Metrics Collector Daemon (PMCD).
pmcd_port={{ (pcp | default({})).pmcd_port | default(44322) }}

# Start the PMCD daemon at system boot.
# true = enabled, false = disabled
pmcd_start={{ (pcp | default({})).pmcd_start | default(true) }}

# Directory where PMCD stores its runtime logs.
pmcd_logdir={{ (pcp | default({})).pmcd_logdir | default('/var/log/pcp/pmcd') }}

# Maximum size (KB) of a PMCD log file before rotation.
pmcd_log_max_size={{ (pcp | default({})).pmcd_log_max_size | default(10240) }}

# Number of old PMCD log files to keep after rotation.
pmcd_log_history={{ (pcp | default({})).pmcd_log_history | default(5) }}

# Seconds to wait before declaring a client connection dead.
pmcd_timeout={{ (pcp | default({})).pmcd_timeout | default(30) }}

# List of hostnames or IP addresses allowed to connect to PMCD.
# Empty list allows only local connections; use ['*'] to allow all (not recommended).
{% if (pcp | default({})).pmcd_allow | default([]) | length > 0 %}
# Allowed hosts:
{% for host in (pcp | default({})).pmcd_allow | default([]) %}
pmcd_allow={{ host }}
{% endfor %}
{% else %}
# No specific hosts allowed; default local-only access.
pmcd_allow=localhost
{% endif %}

# ------------------------------------------------------------------------------
# PMLOGGER (Archive Logging) Configuration
# ------------------------------------------------------------------------------

# Start pmlogger (archive logging) at system boot.
# true = enabled, false = disabled
pmlogger_start={{ (pcp | default({})).pmlogger_start | default(true) }}

# Base directory for archived metric logs (used by pmlogger).
pmlogger_logdir={{ (pcp | default({})).pmlogger_logdir | default('/var/log/pcp/logs') }}

# Rotation frequency for archived logs (e.g., 'daily', 'weekly', 'monthly').
pmlogger_interval={{ (pcp | default({})).pmlogger_interval | default('daily') }}

# Maximum size (MB) per archive file before forced rotation.
pmlogger_max_size={{ (pcp | default({})).pmlogger_max_size | default(500) }}

# List of custom pmlogger instances for collecting metrics from remote hosts.
# Each item in the list typically represents a remote host or instance name.
{% if (pcp | default({})).pmlogger_instances | default([]) | length > 0 %}
# Custom pmlogger instances:
{% for instance in (pcp | default({})).pmlogger_instances | default([]) %}
pmlogger_instance={{ instance }}
{% endfor %}
{% endif %}

# ------------------------------------------------------------------------------
# PMIE (Performance Metrics Inference Engine) Configuration
# ------------------------------------------------------------------------------

# Start the Performance Metrics Inference Engine (pmie) for rule-based alerting.
# true = enabled, false = disabled
pmie_start={{ (pcp | default({})).pmie_start | default(false) }}

# Directory for pmie logs and rule configuration.
pmie_logdir={{ (pcp | default({})).pmie_logdir | default('/var/log/pcp/pmie') }}

# ------------------------------------------------------------------------------
# PMWEBD (HTTP Server for Browser-based Metric Visualization) Configuration
# ------------------------------------------------------------------------------

# Enable the pmwebd HTTP server for browser-based metric visualization.
# true = enabled, false = disabled
pmwebd_start={{ (pcp | default({})).pmwebd_start | default(false) }}

# HTTP port for the pmwebd service.
pmwebd_port={{ (pcp | default({})).pmwebd_port | default(44323) }}

# List of allowed hosts for pmwebd.
# Empty = local only; ['*'] = all (use cautiously).
{% if (pcp | default({})).pmwebd_allow | default([]) | length > 0 %}
# Allowed hosts:
{% for host in (pcp | default({})).pmwebd_allow | default([]) %}
pmwebd_allow={{ host }}
{% endfor %}
{% else %}
# No specific hosts allowed; default local-only access.
pmwebd_allow=localhost
{% endif %}

# ------------------------------------------------------------------------------
# PMDA Tracepoint Configuration
# ------------------------------------------------------------------------------
# BCC PMDA tracepoint hits module config file - see pmdabcc(1) and perf-list(1)
# List of tracepoints to enable.
{% if (pcp | default({})).bcc_tracepoints | default([]) | length > 0 %}
{% for tracepoint in (pcp | default({})).bcc_tracepoints | default([]) %}
{{ tracepoint }}
{% endfor %}
{% else %}
# Default tracepoints if none provided:
random:urandom_read
tlb:tlb_flush
{% endif %}