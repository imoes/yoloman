#
# Performance Co-Pilot (PCP) Configuration
# Auto-generated by Ansible. Do not edit manually.
# This file configures the PMCD daemon, pmlogger, pmie, and pmwebd.
#

###############################################################################
# PMCD (Performance Metrics Collector Daemon) Configuration
###############################################################################

# TCP port used by the Performance Metrics Collector Daemon (PMCD).
PMCD_PORT={{ pcp_pmcd_port | default(44322) }}

# Start the PMCD daemon at system boot.
PMCD_START={{ pcp_pmcd_start | default(true) | ternary('yes', 'no') }}

# Directory where PMCD stores its runtime logs.
PMCD_LOGDIR={{ pcp_pmcd_logdir | default('/var/log/pcp/pmcd') }}

# Maximum size (KB) of a PMCD log file before rotation.
PMCD_LOG_MAX_SIZE={{ pcp_pmcd_log_max_size | default(10240) }}

# Number of old PMCD log files to keep after rotation.
PMCD_LOG_HISTORY={{ pcp_pmcd_log_history | default(5) }}

# Seconds to wait before declaring a client connection dead.
PMCD_TIMEOUT={{ pcp_pmcd_timeout | default(30) }}

# List of hostnames or IP addresses allowed to connect to PMCD.
# Empty list allows only local connections; use ['*'] to allow all.
{% if pcp_pmcd_allow | default([]) | length > 0 %}
PMCD_ALLOW={{ pcp_pmcd_allow | default([]) | join(' ') }}
{% else %}
PMCD_ALLOW=127.0.0.1
{% endif %}

###############################################################################
# PMLOGGER (Archive Logging) Configuration
###############################################################################

# Start pmlogger (archive logging) at system boot.
PMLOGGER_START={{ pcp_pmlogger_start | default(true) | ternary('yes', 'no') }}

# Base directory for archived metric logs (used by pmlogger).
PMLOGGER_LOGDIR={{ pcp_pmlogger_logdir | default('/var/log/pcp/logs') }}

# Rotation frequency for archived logs (e.g., 'daily', 'weekly', 'monthly').
PMLOGGER_INTERVAL={{ pcp_pmlogger_interval | default('daily') }}

# Maximum size (MB) per archive file before forced rotation.
PMLOGGER_MAX_SIZE={{ pcp_pmlogger_max_size | default(500) }}

# List of custom pmlogger instances for collecting metrics from remote hosts.
{% for instance in pcp_pmlogger_instances | default([]) %}
# Instance: {{ instance.name | default('unnamed') }}
# Host: {{ instance.host | default('localhost') }}
# Service: {{ instance.service | default('pmcd') }}
# Port: {{ instance.port | default(44322) }}
PMLOGGER_INSTANCES={{ pcp_pmlogger_instances | default([]) | length | string }}
{% endfor %}
# Note: In a real PMLOGGER config, each instance would be a separate block or entry.
# Here we just count them for simplicity if no detailed schema is provided for the list items.
# If items are complex, this template assumes a simple list of dicts with 'name', 'host', 'service', 'port'.
# For robustness, we generate a placeholder if the list is populated.
{% if pcp_pmlogger_instances | default([]) | length > 0 %}
PMLOGGER_INSTANCE_COUNT={{ pcp_pmlogger_instances | default([]) | length }}
{% endif %}

###############################################################################
# PMIE (Performance Metrics Inference Engine) Configuration
###############################################################################

# Start the Performance Metrics Inference Engine (pmie) for rule-based alerting.
PMIE_START={{ pcp_pmie_start | default(false) | ternary('yes', 'no') }}

# Directory for pmie logs and rule configuration.
PMIE_LOGDIR={{ pcp_pmie_logdir | default('/var/log/pcp/pmie') }}

###############################################################################
# PMWEBD (HTTP Server for Metric Visualization) Configuration
###############################################################################

# Enable the pmwebd HTTP server for browser-based metric visualization.
PMWEBD_START={{ pcp_pmwebd_start | default(false) | ternary('yes', 'no') }}

# HTTP port for the pmwebd service.
PMWEBD_PORT={{ pcp_pmwebd_port | default(44323) }}

# List of allowed hosts for pmwebd. Empty = local only; ['*'] = all.
{% if pcp_pmwebd_allow | default([]) | length > 0 %}
PMWEBD_ALLOW={{ pcp_pmwebd_allow | default([]) | join(' ') }}
{% else %}
PMWEBD_ALLOW=127.0.0.1
{% endif %}