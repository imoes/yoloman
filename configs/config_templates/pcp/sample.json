{
  "pcp_pmcd_port": 44322,
  "pcp_pmcd_start": true,
  "pcp_pmcd_logdir": "/var/log/pcp/pmcd",
  "pcp_pmcd_log_max_size": 10240,
  "pcp_pmcd_log_history": 3,
  "pcp_pmcd_timeout": 60,
  "pcp_pmcd_allow": [
    "localhost",
    "192.168.1.10"
  ],
  "pcp_pmlogger_start": true,
  "pcp_pmlogger_logdir": "/var/log/pcp/logs",
  "pcp_pmlogger_interval": "daily",
  "pcp_pmlogger_max_size": 250,
  "pcp_pmie_start": true,
  "pcp_pmie_logdir": "/var/log/pcp/pmie",
  "pcp_pmwebd_start": true,
  "pcp_pmwebd_port": 44323,
  "pcp_pmwebd_allow": [],
  "pcp_pmlogger_instances": [
    {
      "name": "webserver",
      "host": "web1.example.com",
      "logdir": "/var/log/pcp/logs/web1"
    },
    {
      "name": "database",
      "host": "db1.example.com",
      "logdir": "/var/log/pcp/logs/db1"
    }
  ]
}
