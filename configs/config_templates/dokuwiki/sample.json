{
  "wiki_title": "Acme Engineering Wiki",
  "wiki_lang": "en",
  "wiki_license": "cc-by-sa",
  "wiki_baseurl": "https://wiki.acme.example.com",
  "savedir": "/var/lib/dokuwiki/data",
  "wiki_start": "start",
  "wiki_template": "dokuwiki",
  "wiki_tagline": "Internal knowledge base for the engineering team",
  "wiki_sidebar": "sidebar",
  "max_section_depth": 4,
  "use_heading": 1,
  "sneaky_index": true,
  "hidden_pages": "(^wiki:(syntax|welcome|sandbox)|^playground:)",
  "use_acl": true,
  "superuser": "@admin",
  "manager": "@manager",
  "open_register": false,
  "email_confirm": true,
  "disabled_actions": [
    "register"
  ],
  "cache_time": 86400,
  "lock_time": 600,
  "recent_count": 30,
  "max_file_size": 10485760,
  "jpg_quality": 80,
  "im_convert": "/usr/bin/convert",
  "mail_from": "wiki@acme.example.com",
  "smtp_host": "smtp.acme.example.com",
  "smtp_port": 587,
  "smtp_user": "wiki@acme.example.com",
  "smtp_pass": "S3cr3tSMTPpass!",
  "smtp_secure": "tls",
  "extra_conf": [
    {
      "key": "indexdelay",
      "value": "0",
      "description": "Index newly created pages immediately without any delay"
    },
    {
      "key": "mailguard",
      "value": "hex",
      "description": "Obfuscate email addresses in page content to reduce spam harvesting"
    }
  ]
}
