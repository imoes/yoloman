{
  "log_level": "INFO",
  "bind_address": "10.0.0.5",
  "port": 53,
  "max_response_size": 4096,
  "workers": 4,
  "doh_enabled": true,
  "doh_bind_address": "10.0.0.5",
  "doh_port": 8443,
  "tls_cert_file": "/etc/ssl/certs/mdns.example.com.crt",
  "tls_key_file": "/etc/ssl/private/mdns.example.com.key",
  "doh_max_conns": 2048,
  "upstream_dns_servers": [
    "192.168.1.1",
    "8.8.8.8#53"
  ],
  "enable_dnssec_validation": true,
  "trust_anchor_file": "/etc/bind/root.key",
  "axfr_rate_limit": 10,
  "max_axfr_concurrent": 5,
  "allowed_axfr_range": "192.168.10.0/24, 10.0.0.0/8",
  "enable_pool_monitoring": true,
  "pool_monitor_interval": 60,
  "pool_id": "default",
  "service_enabled": true,
  "rpc_topic": "designate_messenger",
  "rpc_port": 5454,
  "neg_ttl": 60,
  "soa_ttl": 7200,
  "soa_minimum": 1200,
  "soa_retry": 1800,
  "soa_expire": 604800,
  "soa_refresh": 43200,
  "soa_primary_ns": "ns1.example.com.",
  "soa_email": "admin.example.com.",
  "soa_additional_ns": [
    "ns2.example.com.",
    "ns3.example.com."
  ],
  "api_endpoint": "https://designate.example.com:9001/v2",
  "auth_type": "keystone",
  "keystone_auth_url": "https://keystone.example.com/identity",
  "project_name": "project-dns",
  "username": "designate",
  "password": "secret-pass",
  "region_name": "RegionOne",
  "api_tls_verify": true,
  "api_tls_ca_file": "/etc/ssl/certs/keystone-ca.crt"
}
