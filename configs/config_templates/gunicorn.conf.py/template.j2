# Gunicorn Configuration Template
# Generated by Ansible Jinja2
# This configuration controls the Gunicorn WSGI HTTP Server.

# Network interface to bind to, either as host:port (e.g., '0.0.0.0:8000') or a Unix socket path (e.g., '/run/gunicorn.sock').
bind = "{{ bind | default('127.0.0.1:8000') }}"

# Number of worker processes. Typically 2–4 × number of CPU cores.
workers = {{ workers | default(3) }}

# Type of worker to use (e.g., 'sync', 'gevent', 'tornado', 'uvicorn.workers.UvicornWorker').
worker_class = "{{ worker_class | default('sync') }}"

# Seconds before worker is killed and restarted if no response.
timeout = {{ timeout | default(30) }}

# Path to access log file, or '-' to log to stdout.
accesslog = "{{ accesslog | default('-') }}"

# Path to error log file, or '-' to log to stderr.
errorlog = "{{ errorlog | default('-') }}"

# Logging level: debug, info, warning, error, or critical.
loglevel = "{{ loglevel | default('info') }}"

# Number of threads per worker (used only with 'gthread' or 'sync' workers).
threads = {{ threads | default(1) }}

# Maximum number of requests a worker handles before graceful restart (0 = disabled).
max_requests = {{ max_requests | default(0) }}

# Seconds to wait for workers to finish in-flight requests before force-kill.
graceful_timeout = {{ graceful_timeout | default(30) }}

# Path to write PID file (optional; leave blank to disable).
{% if pidfile | default('') | trim | length > 0 %}
pidfile = "{{ pidfile | default('') }}"
{% endif %}

# Unix username to drop privileges to after binding (requires root; optional).
{% if user | default('') | trim | length > 0 %}
user = "{{ user | default('') }}"
{% endif %}

# Unix group to drop privileges to after binding (requires root; optional).
{% if group | default('') | trim | length > 0 %}
group = "{{ group | default('') }}"
{% endif %}

# List of environment variables to set for worker processes (as key-value pairs).
{% for item in (env | default([]) | list) %}
{{ item }}
{% endfor %}

# Additional command-line style arguments as key-value pairs (e.g., {'--preload': true}).
{% for item in (extra_args | default([]) | list) %}
{{ item }}
{% endfor %}

# SSL/TLS configuration for HTTPS. Provide certfile and keyfile at minimum.
{% if ssl | default(None) is mapping %}
certfile = "{{ (ssl | default({})).certfile | default('') }}"
keyfile = "{{ (ssl | default({})).keyfile | default('') }}"
{% if (ssl | default({})).ca_certs | default('') | trim | length > 0 %}
ca_certs = "{{ (ssl | default({})).ca_certs | default('') }}"
{% endif %}
{% if (ssl | default({})).ciphers | default('') | trim | length > 0 %}
ciphers = "{{ (ssl | default({})).ciphers | default('') }}"
{% endif %}
{% endif %}

# Maximum number of queued connections (socket backlog).
backlog = {{ backlog | default(2048) }}

# Seconds to keep idle connections open (0 = disabled).
{% if keepalive | default(2) != 0 %}
keepalive = {{ keepalive | default(2) }}
{% endif %}

# Process name prefix shown in process lists (e.g., 'myapp:gunicorn').
proc_name = "{{ proc_name | default('gunicorn') }}"

# Optional Python code for a pre_load() hook (called before app load, e.g., 'pass' or 'import mymodule').
{% if pre_load | default('') | trim | length > 0 %}
# Note: This generates a function definition. Ensure the content is valid Python.
def pre_load(app):
    {{ pre_load | default('') | indent(4) }}
{% endif %}