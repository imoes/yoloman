# MediaConch Configuration Template
# Note: MediaConch is primarily a CLI/GUI/WebUI tool that does not use a persistent daemon config file.
# This template generates a wrapper script or environment configuration for batch processing
# as suggested by the documentation's batch-level capabilities.

#!/bin/bash
# Wrapper script for MediaConch batch processing
# Generated by gonja Jinja2 template

# Set default verbosity/reporting mode
# Options: mc (Mediaconch), mi (Mediainfo), mt (Mediatrace)
REPORT_MODE="{{ report_mode | default('mc') }}"

# Set output format
# Options: text, xml, maxml, html
OUTPUT_FORMAT="{{ output_format | default('text') }}"

# Apply policy file
# Path to XSL or Schematron policy file
POLICY_FILE="{{ policy_file | default('') }}"

# Apply display transformation (XSL)
DISPLAY_FILE="{{ display_file | default('') }}"

# Input files to check
# List of file paths to process
INPUT_FILES="{% for f in input_files %}{{ f }} {% endfor %}"

# Command construction
cmd="mediaconch"

{% if report_mode == 'mi' %}
cmd="{{ cmd }} --Mediainfo"
{% elif report_mode == 'mt' %}
cmd="{{ cmd }} --Mediatrace"
{% else %}
cmd="{{ cmd }} --Mediaconch"
{% endif %}

{% if output_format == 'xml' %}
cmd="{{ cmd }} --Format=xml"
{% elif output_format == 'maxml' %}
cmd="{{ cmd }} --Format=maxml"
{% elif output_format == 'html' %}
cmd="{{ cmd }} --Format=html"
{% endif %}

{% if policy_file != '' %}
cmd="{{ cmd }} --Policy={{ policy_file }}"
{% endif %}

{% if display_file != '' %}
cmd="{{ cmd }} --Display={{ display_file }}"
{% endif %}

# Execute command
echo "Running: {{ cmd }} {{ INPUT_FILES }}"
{{ cmd }} {{ INPUT_FILES }}