# Configuration for libsrecord utility behavior
# Global output format for EPROM files
# Supported formats include intel-ih, motorola-srec, bin, etc.
# See srecord(3) for the full list of supported formats.
srecord.default_output_format = {{ default_output_format | default('intel-ih') }}

# Enable verbose error reporting
# Controls whether the library prints detailed error messages to stderr.
# Useful for debugging file processing issues.
srecord.verbose_errors = {{ verbose_errors | default(False) | ternary('true', 'false') }}