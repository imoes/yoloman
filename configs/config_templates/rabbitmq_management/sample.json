{
  "management_http_port": 15672,
  "management_bind_address": "0.0.0.0",
  "management_ssl_enabled": true,
  "management_https_port": 15671,
  "management_ssl_cacertfile": "/etc/rabbitmq/ssl/cacert.pem",
  "management_ssl_certfile": "/etc/rabbitmq/ssl/cert.pem",
  "management_ssl_keyfile": "/etc/rabbitmq/ssl/key.pem",
  "management_ssl_verify": "verify_peer",
  "management_agent": "rabbit_mgmt_user_pass",
  "management_num_tcp_acceptors": 16,
  "management_http_timeout": 60000,
  "management_disable_guest_login": true,
  "management_metrics": [
    {
      "key": "collectors.rates.mode",
      "value": "basic"
    },
    {
      "key": "collectors.node_statistics.mode",
      "value": "detailed"
    },
    {
      "key": "collectors.connection_statistics.mode",
      "value": "none"
    }
  ],
  "management_log_levels": [
    "warning",
    "error"
  ],
  "management_path_prefix": "/",
  "management_rate_limiting_enabled": true,
  "management_rate_limit_threshold": 50,
  "management_rate_limit_interval_ms": 5000,
  "management_cluster_name": "prod-rabbitmq-cluster",
  "management_ppi_enabled": false
}
