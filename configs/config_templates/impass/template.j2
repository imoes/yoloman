# Sway Window Manager Configuration for Impass
# This template configures Sway to handle the 'impass' application correctly.

# Window Rules for Impass
# Ensures that sway shows the impass popup dialog appropriately.
# The app_id is constructed from the prefix and suffix defined in the schema.
for_window [app_id="^{{ (app_id_prefix | default('net')) }}\.{{ (app_id_suffix | default('cmrg.impass')) }}$" ] {
   # Enable floating behavior for the popup
   floating enable
   # Keep the popup on top of other windows
   sticky enable
}

# Keybinding Configuration
# Add a default keybinding to launch the GUI.
# Binds Mod+p to execute the impass GUI command.
# Note: The original template had 'exec exec' which is likely redundant in Sway
# as 'exec' handles the execution. However, to preserve exact intent if 'exec'
# is a wrapper script or specific requirement, we keep the variable expansion.
# Standard Sway usage is 'exec binary_name args'.
bindsym $mod+p exec {{ (binary_name | default('impass')) }} gui
