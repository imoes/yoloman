{
  "log_level": "info",
  "data_sources": [
    {
      "name": "network",
      "enabled": true,
      "timeout": 25,
      "priority": 1
    },
    {
      "name": "gps",
      "enabled": true,
      "timeout": 45,
      "priority": 2
    }
  ],
  "default_accuracy": "medium",
  "privacy_mode": true,
  "max_clients": 8,
  "polling_interval": 60,
  "allowed_countries": [
    "US",
    "CA",
    "GB",
    "DE"
  ],
  "location_cache_ttl": 180,
  "geoclue_service": "org.freedesktop.GeoClue2",
  "geoclue_provider": "org.freedesktop.GeoClue2.Providers.Network"
}
