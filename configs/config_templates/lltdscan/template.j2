# /etc/default/lltdscan
# Configuration file for lltdscan (Link Layer Topology Discovery scanner).
# This file is auto-generated by Ansible. Do not edit manually.

# Network interface to send LLTD broadcasts on.
# Default: eth0
INTERFACE="{{ interface | default('eth0') }}"

# Timeout in milliseconds to wait for responses.
# Default: 5000
TIMEOUT={{ timeout | default(5000) }}

# Enable UTF-8 display for machine names.
# Default: False
UTF8={{ utf8 | default(False) }}

# Verbosity level. 0 for quiet, 1 for standard, 2 for debug.
# Default: 0
VERBOSE={{ verbose | default(0) }}

# Specific MAC address to scan for. Leave empty to scan all.
# Default: (empty)
TARGET_MAC="{{ target_mac | default('') }}"