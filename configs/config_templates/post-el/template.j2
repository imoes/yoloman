;; -*-emacs-lisp-*-
;;
;; Emacs startup file for post-el package
;;
;; Shamelessly stolen from the emacs-goodies-el package.
;;
;; This configuration file sets up the load path for the post-el package
;; and optionally registers post-mode in Emacs' auto-mode-alist to handle
;; mail/newss composition files automatically.
;;
;; Variables:
;; - site_lisp_path: Relative path under /usr/share/ where post-el is installed.
;; - post_insert_auto_mode_default: Whether to auto-register post-mode on load.

;; We have to add this to the load-path:
;; This block checks for a Debian-specific helper function. If available,
;; it uses it to construct the load path; otherwise, it manually prepends the path.
(if (fboundp 'debian-pkg-add-load-path-item)
    (setq load-path (debian-pkg-add-load-path-item
                     (concat "/usr/share/"
                             (symbol-name debian-emacs-flavor)
                             "/{{ site_lisp_path | default('site-lisp') }}/post-el")) )
  (setq load-path (cons (concat "/usr/share/"
                                (symbol-name debian-emacs-flavor)
                                "/{{ site_lisp_path | default('site-lisp') }}/post-el") load-path)))

; load for now, fix it for autoloading later
;(load "post")

(autoload 'post-mode "post" "Major mode for composing email or news with an external agent.
To customize it, type \\[[customize]] and select [Applications] [Mail] [Post].
When you finish editing this message, type \\[[post-save-current-buffer-and-exit]] to save and exit Emacs.

\\{post-mode-map}" t)

(defgroup post nil
  "Composing e-mail messages with Post.
Emacs can run as an external editor for Mutt, the spiffy Unix mail reader
du jour, or slrn, the spiffy Unix news reader du jour.  You can get
Mutt from http://www.mutt.org/."
  :group 'mail)

(defcustom post-mail-message "\(mutt-[a-zA-Z0-9-.]+-[0-9]+-[0-9]+\(-[a-fA-F0-9]+\)?\|mutt[a-zA-Z0-9._-]\{6\}\)\'"
  "*Regular expression which matches your mailer's temporary files."
  :type 'regexp
  :group 'post)

(defcustom post-news-posting "\.\\(followup\\|letter\\|article\)$"
  "*Regular expression which matches your news reader's composition files"
  :type 'string
  :group 'post)

;; post-insert-to-auto-mode-alist-on-load
;; Description: Whether to automatically insert post-mode into auto-mode-alist on load.
;; Type: boolean
;; Default: t (True)
(defcustom post-insert-to-auto-mode-alist-on-load {{ post_insert_auto_mode_default | default(true) | lower }}
  "Automatically insert post-mode with post-mail-message to auto-mode-alist"
  :type 'boolean
  :group 'post)

;; When the auto-registration feature is enabled, this block ensures that
;; post-mode is added to auto-mode-alist if not already present. This allows
;; Emacs to automatically switch to post-mode for files matching the
;; post-mail-message or post-news-posting regular expressions.
(when post-insert-to-auto-mode-alist-on-load
  (unless (assq post-mail-message auto-mode-alist)
    (setq auto-mode-alist
	  (cons (cons post-mail-message 'post-mode)
		auto-mode-alist)))
  (unless (assq post-news-posting auto-mode-alist)
    (setq auto-mode-alist
	  (cons (cons post-news-posting 'post-mode)
		auto-mode-alist))))