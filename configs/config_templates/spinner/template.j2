# Spinner anti-idle configuration
# Path to the PID file
pid_file: {{ pid_file | default('~/.spinner.pid') }}

# If true, do not create a pid file
pid_file_disabled: {{ pid_file_disabled | default(false) | lower }}

# Use inverse video for spinner
inverse_video: {{ inverse_video | default(true) | lower }}

# Path to log file. Empty or 'off' disables logging.
log_file: {{ log_file | default('') }}

# Send null characters (no visible output)
null_output: {{ null_output | default(false) | lower }}

# Process priority (nice value)
priority: {{ priority | default(10) }}

# If true, do not change process priority
priority_disabled: {{ priority_disabled | default(false) | lower }}

# Reset terminal on quit
reset_term_on_quit: {{ reset_term_on_quit | default(false) | lower }}

# Reset terminal and quit immediately
reset_and_quit: {{ reset_and_quit | default(false) | lower }}

# TTY path to write to. Empty uses default.
tty_path: {{ tty_path | default('') }}

# Ignore incompatible TERM environment variable
ignore_incompatible_term: {{ ignore_incompatible_term | default(false) | lower }}

# Delay is in microseconds instead of seconds
microseconds_delay: {{ microseconds_delay | default(false) | lower }}

# Enable verbose mode
verbose: {{ verbose | default(false) | lower }}