{
  "pid_file": {
    "type": "string",
    "default": "~/.spinner.pid",
    "description": "Path to the PID file"
  },
  "pid_file_disabled": {
    "type": "bool",
    "default": false,
    "description": "If true, do not create a pid file"
  },
  "inverse_video": {
    "type": "bool",
    "default": true,
    "description": "Use inverse video for spinner"
  },
  "log_file": {
    "type": "string",
    "default": "",
    "description": "Path to log file. Empty or 'off' disables logging."
  },
  "null_output": {
    "type": "bool",
    "default": false,
    "description": "Send null characters (no visible output)"
  },
  "priority": {
    "type": "number",
    "default": 10,
    "description": "Process priority (nice value)"
  },
  "priority_disabled": {
    "type": "bool",
    "default": false,
    "description": "If true, do not change process priority"
  },
  "reset_term_on_quit": {
    "type": "bool",
    "default": false,
    "description": "Reset terminal on quit"
  },
  "reset_and_quit": {
    "type": "bool",
    "default": false,
    "description": "Reset terminal and quit immediately"
  },
  "tty_path": {
    "type": "string",
    "default": "",
    "description": "TTY path to write to. Empty uses default."
  },
  "ignore_incompatible_term": {
    "type": "bool",
    "default": false,
    "description": "Ignore incompatible TERM environment variable"
  },
  "microseconds_delay": {
    "type": "bool",
    "default": false,
    "description": "Delay is in microseconds instead of seconds"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose mode"
  }
}
