<?xml version='{{ xml_version | default("1.0") }}' encoding='{{ xml_encoding | default("UTF-8") }}'?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- SPDX-License-Identifier: {{ spdx_id | default("MIT") }} -->
<fontconfig>
  <!-- Match target="scan": First font match -->
  <match target="scan">
    <!-- Test fullname attribute against full name -->
    <test name="fullname">
      <!-- Full name for first font match -->
      <string>{{ fullname_1 | default("Droid Serif Bold") }}</string>
    </test>
    <!-- Test family attribute against family name -->
    <test name="family">
      <!-- Family name for first font match -->
      <string>{{ family_1 | default("Droid Serif") }}</string>
    </test>
    <!-- Test style attribute against style -->
    <test name="style">
      <!-- Style for first font match -->
      <string>{{ style_1 | default("Bold") }}</string>
    </test>
    <!-- Edit fontversion attribute -->
    <edit name="fontversion">
      <!-- Font version for first match -->
      <int>{{ fontversion_1 | default(2) }}</int>
    </edit>
  </match>

  <!-- Match target="scan": Second font match -->
  <match target="scan">
    <!-- Test fullname attribute against full name -->
    <test name="fullname">
      <!-- Full name for second font match -->
      <string>{{ fullname_2 | default("Droid Serif Bold Italic") }}</string>
    </test>
    <!-- Test family attribute against family name -->
    <test name="family">
      <!-- Family name for second font match -->
      <string>{{ family_2 | default("Droid Serif") }}</string>
    </test>
    <!-- Test style attribute against style -->
    <test name="style">
      <!-- Style for second font match -->
      <string>{{ style_2 | default("Bold Italic") }}</string>
    </test>
    <!-- Edit fontversion attribute -->
    <edit name="fontversion">
      <!-- Font version for second match -->
      <int>{{ fontversion_2 | default(2) }}</int>
    </edit>
  </match>

  <!-- Match target="scan": Third font match -->
  <match target="scan">
    <!-- Test fullname attribute against full name -->
    <test name="fullname">
      <!-- Full name for third font match -->
      <string>{{ fullname_3 | default("Droid Serif Italic") }}</string>
    </test>
    <!-- Test family attribute against family name -->
    <test name="family">
      <!-- Family name for third font match -->
      <string>{{ family_3 | default("Droid Serif") }}</string>
    </test>
    <!-- Test style attribute against style -->
    <test name="style">
      <!-- Style for third font match -->
      <string>{{ style_3 | default("Italic") }}</string>
    </test>
    <!-- Edit fontversion attribute -->
    <edit name="fontversion">
      <!-- Font version for third match -->
      <int>{{ fontversion_3 | default(2) }}</int>
    </edit>
  </match>

  <!-- Match target="scan": Fourth font match -->
  <match target="scan">
    <!-- Test fullname attribute against full name -->
    <test name="fullname">
      <!-- Full name for fourth font match -->
      <string>{{ fullname_4 | default("Droid Serif") }}</string>
    </test>
    <!-- Test family attribute against family name -->
    <test name="family">
      <!-- Family name for fourth font match -->
      <string>{{ family_4 | default("Droid Serif") }}</string>
    </test>
    <!-- Test style attribute against style -->
    <test name="style">
      <!-- Style for fourth font match -->
      <string>{{ style_4 | default("Regular") }}</string>
    </test>
    <!-- Edit fontversion attribute -->
    <edit name="fontversion">
      <!-- Font version for fourth match -->
      <int>{{ fontversion_4 | default(2) }}</int>
    </edit>
  </match>

  <!-- Match target="scan": Fifth font match -->
  <match target="scan">
    <!-- Test fullname attribute against full name -->
    <test name="fullname">
      <!-- Full name for fifth font match -->
      <string>{{ fullname_5 | default("Droid Arabic Naskh Bold") }}</string>
    </test>
    <!-- Test family attribute against family name -->
    <test name="family">
      <!-- Family name for fifth font match -->
      <string>{{ family_5 | default("Droid Arabic Naskh") }}</string>
    </test>
    <!-- Test style attribute against style -->
    <test name="style">
      <!-- Style for fifth font match -->
      <string>{{ style_5 | default("Bold") }}</string>
    </test>
    <!-- Edit fullname attribute with prepend mode -->
    <edit name="fullname" mode="prepend">
      <!-- Prepended fullname for fifth match -->
      <string>{{ fullname_alias_5 | default("Droid Serif Bold") }}</string>
    </edit>
    <!-- Edit family attribute with prepend mode -->
    <edit name="family" mode="prepend">
      <!-- Prepended family for fifth match -->
      <string>{{ family_alias_5 | default("Droid Serif") }}</string>
    </edit>
    <!-- Edit fontversion attribute -->
    <edit name="fontversion">
      <!-- Font version for fifth match -->
      <int>{{ fontversion_5 | default(1) }}</int>
    </edit>
  </match>

  <!-- Match target="scan": Sixth font match -->
  <match target="scan">
    <!-- Test fullname attribute against full name -->
    <test name="fullname">
      <!-- Full name for sixth font match -->
      <string>{{ fullname_6 | default("Droid Arabic Naskh") }}</string>
    </test>
    <!-- Test family attribute against family name -->
    <test name="family">
      <!-- Family name for sixth font match -->
      <string>{{ family_6 | default("Droid Arabic Naskh") }}</string>
    </test>
    <!-- Test style attribute against style -->
    <test name="style">
      <!-- Style for sixth font match -->
      <string>{{ style_6 | default("Regular") }}</string>
    </test>
    <!-- Edit fullname attribute with prepend mode -->
    <edit name="fullname" mode="prepend">
      <!-- Prepended fullname for sixth match -->
      <string>{{ fullname_alias_6 | default("Droid Serif") }}</string>
    </edit>
    <!-- Edit family attribute with prepend mode -->
    <edit name="family" mode="prepend">
      <!-- Prepended family for sixth match -->
      <string>{{ family_alias_6 | default("Droid Serif") }}</string>
    </edit>
    <!-- Edit fontversion attribute -->
    <edit name="fontversion">
      <!-- Font version for sixth match -->
      <int>{{ fontversion_6 | default(1) }}</int>
    </edit>
  </match>

  <!-- Alias binding block 1 -->
  <alias binding="{{ alias_binding_1 | default("same") }}">
    <!-- Target family for first alias block -->
    <family>{{ alias_family_1 | default("Droid Serif") }}</family>
    <accept>
      <!-- First accepted family in first alias block -->
      <family>{{ alias_accept_1_1 | default("Noto Serif") }}</family>
      <!-- Second accepted family in first alias block -->
      <family>{{ alias_accept_1_2 | default("Droid Naskh Shift Alt") }}</family>
      <!-- Third accepted family in first alias block -->
      <family>{{ alias_accept_1_3 | default("serif") }}</family>
    </accept>
  </alias>

  <!-- Alias binding block 2 -->
  <alias binding="{{ alias_binding_2 | default("same") }}">
    <!-- Target family for second alias block -->
    <family>{{ alias_family_2 | default("Noto Serif") }}</family>
    <accept>
      <!-- Accepted family in second alias block -->
      <family>{{ alias_accept_2_1 | default("Droid Serif") }}</family>
    </accept>
  </alias>

  <!-- Alias binding block 3 -->
  <alias binding="{{ alias_binding_3 | default("same") }}">
    <!-- Target family for third alias block -->
    <family>{{ alias_family_3 | default("Droid Naskh Shift Alt") }}</family>
    <accept>
      <!-- Accepted family in third alias block -->
      <family>{{ alias_accept_3_1 | default("Droid Serif") }}</family>
    </accept>
  </alias>

  <!-- Alias binding block 4 (empty implies default) -->
  <alias binding="{{ alias_binding_4 | default("same") }}">
    <!-- Target family for fourth alias block -->
    <family>{{ alias_family_4 | default("serif") }}</family>
    <prefer>
      <!-- Preferred family in fourth alias block -->
      <family>{{ alias_prefer_4_1 | default("Droid Serif") }}</family>
    </prefer>
  </alias>
</fontconfig>
