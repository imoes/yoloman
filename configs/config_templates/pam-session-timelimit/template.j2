# Per-user time limits for login sessions via PAM/systemd.
#
# This file is consumed by pam_systemd to enforce `systemd.max_runtime_sec`
# for specific users upon login. The syntax for time limits follows systemd.time(7)
# (e.g., "5h30s", "infinity", "30").
#
# Format: <username><TAB><time_limit>
# The last matching entry takes precedence.
#
# --- Configuration for User 1 ---
# User: {{ user1_name | default('vorlon') }}
# Description: The first username to apply a time limit to.
# Time Limit: {{ user1_time_limit | default('5h30s') }}
#
# This user is restricted to {{ user1_time_limit | default('5h30s') }} of session time.
{{ user1_name | default('vorlon') }}	{{ user1_time_limit | default('5h30s') }}

# --- Configuration for User 2 ---
# User: {{ user2_name | default('"shane"') }}
# Description: The second username to apply a time limit to.
# Time Limit: {{ user2_time_limit | default('infinity') }}
#
# This user has no time limit ({{ user2_time_limit | default('infinity') }}).
{{ user2_name | default('"shane"') }}	{{ user2_time_limit | default('infinity') }}

# --- Configuration for User 3 ---
# User: {{ user3_name | default('lynn') }}
# Description: The third username to apply a time limit to.
# Time Limit: {{ user3_time_limit | default('30') }}
#
# This user is restricted to {{ user3_time_limit | default('30') }} seconds of session time.
{{ user3_name | default('lynn') }}	{{ user3_time_limit | default('30') }}
