# =============================================================================
# GlusterFS CLI Bash Completion Script
# =============================================================================
# This script provides command-line tab completion for the `gluster` CLI tool.
# It is auto-generated or maintained to reflect the available subcommands and
# options for volumes, peers, and quota operations.
#
# Usage:
#   source /path/to/gluster-completion.sh
#
# Dependencies:
#   - glusterfs-cli package must be installed.
#   - glusterd service should be running for dynamic list completion (volumes/hosts).
# =============================================================================

#!/usr/bin/bash

# --- Dynamic Option Discovery ---
# Checks if the gluster daemon is running. If so, it queries `gluster volume set`
# to discover available volume options dynamically. This ensures completion
# matches the installed GlusterFS version.

if pidof glusterd > /dev/null 2>&1; then
    # Extract option names from gluster volume set help output
    # Format expected: "Option: <name>"
    GLUSTER_SET_OPTIONS="
    $(for token in `gluster volume set help 2>/dev/null | grep "^Option:" | cut -d ' ' -f 2`
    do
        echo "{$token},"
    done)
    "
    # Reset options mirror the set options
    GLUSTER_RESET_OPTIONS="$GLUSTER_SET_OPTIONS"
else
    # Fallback empty options if daemon is not running
    GLUSTER_SET_OPTIONS=""
    GLUSTER_RESET_OPTIONS=""
fi

# --- Top-Level Suboptions (Performance/Top Commands) ---
# Used by gluster volume top commands (read, write, etc.)

GLUSTER_TOP_SUBOPTIONS1="
        {nfs},
        {brick},
        {list-cnt}
"

# Extended suboptions for performance counters (read-perf, write-perf)
GLUSTER_TOP_SUBOPTIONS2="
        {bs
                {__SIZE
                        {count}
                }
        },
        {brick},
        {list-cnt}
"

# --- Top Options Mapping ---
# Maps performance actions to their specific suboptions.

GLUSTER_TOP_OPTIONS="
        {open
                [ $GLUSTER_TOP_SUBOPTIONS1 ]
        },
        {read
                [ $GLUSTER_TOP_SUBOPTIONS1 ]
        },
        {write
                [ $GLUSTER_TOP_SUBOPTIONS1 ]
        },
        {opendir
                [ $GLUSTER_TOP_SUBOPTIONS1 ]
        },
        {readdir
                [ $GLUSTER_TOP_SUBOPTIONS1 ]
        },
        {clear
                [ $GLUSTER_TOP_SUBOPTIONS1 ]
        },
        {read-perf
                [ $GLUSTER_TOP_SUBOPTIONS2 ]
        },
        {write-perf
                [ $GLUSTER_TOP_SUBOPTIONS2 ]
        }
"

# --- Quota Suboptions ---
# Available commands for gluster volume quota management.

GLUSTER_QUOTA_OPTIONS="
        {enable},
        {disable},
        {list},
        {remove},
        {default-soft-limit},
        {limit-usage},
        {alert-time},
        {soft-timeout},
        {hard-timeout}
"

# --- Profile Suboptions ---
# Available commands for gluster volume profile statistics.

GLUSTER_PROFILE_OPTIONS="
        {start},
        {info [
                {peek},
                {incremental
                        {peek}
                },
                {cumulative},
                {clear},
              ]
        },
        {stop}
"

# --- Barrier Suboptions ---
# Available commands for gluster volume barrier management.

GLUSTER_BARRIER_OPTIONS="
        {enable},
        {disable}
"

# --- Geo-Replication Suboptions ---
# Sub-commands for gluster volume geo-replication.

GLUSTER_GEO_REPLICATION_SUBOPTIONS="
"

# --- Geo-Replication Options Tree ---
# Defines the command tree for geo-replication operations (create, start, status, etc.)

GLUSTER_GEO_REPLICATION_OPTIONS="
        {__VOLNAME [
                {__SLAVEURL [
                        {create [
                                {push-pem
                                        {force}
                                },
                                {force}
                                ]
                        },
                        {start {force} },
                        {status {detail} },
                        {config},
                        {pause {force} },
                        {resume {force} },
                        {stop {force} },
                        {delete {force} }
                            ]
                },
                {status}
                   ]
        },
        {status}
"

# --- Volume Options Tree ---
# The main command tree for `gluster volume <action>` operations.

GLUSTER_VOLUME_OPTIONS="
        {volume [
                {add-brick
                        {__VOLNAME}
                },
                {barrier
                        {__VOLNAME
                                [ $GLUSTER_BARRIER_OPTIONS ]
                        }
                },
                {clear-locks
                        {__VOLNAME}
                },
                {create},
                {delete
                        {__VOLNAME}
                },
                {geo-replication
                        [ $GLUSTER_GEO_REPLICATION_OPTIONS ]
                },
                {heal
                        {__VOLNAME}
                },
                {help},
                {info
                        {__VOLNAME}
                },
                {list},
                {log
                        {__VOLNAME}
                },
                {profile
                        {__VOLNAME
                                [ $GLUSTER_PROFILE_OPTIONS ]
                        }
                },
                {quota
                        {__VOLNAME
                                [ $GLUSTER_QUOTA_OPTIONS ]
                        }
                },
                {rebalance
                        {__VOLNAME}
                },
                {remove-brick
                        {__VOLNAME}
                },
                {replace-brick
                        {__VOLNAME}
                },
                {reset
