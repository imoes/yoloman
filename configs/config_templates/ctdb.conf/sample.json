{
 "base_path": "/var/lib/ctdb",
 "client_connect_limit": 1000,
 "client_timeout": 30,
 "event_script_dirs": [
  "/etc/ctdb/events.d",
  "/opt/ha/scripts/events"
 ],
 "event_scripts_enable": true,
 "event_scripts_max": 12,
 "ip_allocation_method": "static",
 "ip_allocations": [
  {
   "address": "10.0.0.100",
   "node": "192.168.1.10"
  },
  {
   "address": "10.0.0.101",
   "node": "192.168.1.11"
  },
  {
   "address": "10.0.0.102",
   "node": "192.168.1.12"
  }
 ],
 "lock_file": "/var/lib/ctdb/ctdb.lock",
 "log_file_path": "/var/log/ctdb/ctdb.log",
 "log_level": "NOTICE",
 "log_subsystems": [
  "lcp",
  "notify",
  "dmaster"
 ],
 "node_hints": [
  {
   "node": "192.168.1.10",
   "priority": 100,
   "weight": 2
  },
  {
   "node": "192.168.1.11",
   "priority": 90
  },
  {
   "node": "192.168.1.12",
   "priority": 80
  }
 ],
 "nodes": [
  "192.168.1.10",
  "192.168.1.11",
  "192.168.1.12"
 ],
 "public_addresses_file": "/etc/ctdb/public_ips",
 "recovery_blackout_period": 300,
 "recovery_grace_period": 60,
 "recovery_lock_file": "/var/lib/ctdb/recovery.lock"
}
