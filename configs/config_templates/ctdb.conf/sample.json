{
  "nodes": [
    "192.168.1.10",
    "192.168.1.11",
    "192.168.1.12"
  ],
  "public_addresses_file": "/etc/ctdb/public_ips",
  "base_path": "/var/lib/ctdb",
  "lock_file": "/var/lib/ctdb/ctdb.lock",
  "recovery_lock_file": "/var/lib/ctdb/recovery.lock",
  "recovery_grace_period": 60,
  "recovery_blackout_period": 300,
  "ip_allocation_method": "static",
  "ip_allocations": [
    {
      "node": "192.168.1.10",
      "address": "10.0.0.100"
    },
    {
      "node": "192.168.1.11",
      "address": "10.0.0.101"
    },
    {
      "node": "192.168.1.12",
      "address": "10.0.0.102"
    }
  ],
  "log_level": "NOTICE",
  "log_subsystems": [
    "lcp",
    "notify",
    "dmaster"
  ],
  "log_file_path": "/var/log/ctdb/ctdb.log",
  "event_scripts_max": 12,
  "client_connect_limit": 1000,
  "client_timeout": 30,
  "event_scripts_enable": true,
  "event_script_dirs": [
    "/etc/ctdb/events.d",
    "/opt/ha/scripts/events"
  ],
  "node_hints": [
    {
      "node": "192.168.1.10",
      "priority": 100,
      "weight": 2
    },
    {
      "node": "192.168.1.11",
      "priority": 90
    },
    {
      "node": "192.168.1.12",
      "priority": 80
    }
  ]
}
