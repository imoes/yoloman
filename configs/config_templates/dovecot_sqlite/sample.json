{
  "protocols": [
    "imap",
    "pop3"
  ],
  "listen": [
    "*"
  ],
  "mail_location": "maildir:~/Maildir",
  "auth_mechanisms": [
    "plain",
    "login"
  ],
  "sql_passdb_config_path": "/etc/dovecot/dovecot-sql.conf.ext",
  "sql_userdb_config_path": "/etc/dovecot/dovecot-sql.conf.ext",
  "log_path": "/var/log/dovecot.log",
  "syslog_facility": "mail",
  "ssl": "required",
  "ssl_cert": "/etc/ssl/certs/dovecot.crt",
  "ssl_key": "/etc/ssl/private/dovecot.key",
  "mail_max_userip_connections": 20,
  "imap_max_connections": 1024,
  "pop3_max_connections": 512,
  "login_greeting": "Dovecot ready.",
  "mail_plugins": [
    "quota"
  ],
  "quota_enabled": true,
  "quota_storage_limit_mb": 2048,
  "quota_warning_percent": 80,
  "imap_port": 143,
  "ssl_imap_port": 993,
  "pop3_port": 110,
  "ssl_pop3_port": 995,
  "mail_user": "vmail",
  "mail_group": "vmail"
}
