{
  "pid_file": "/var/run/mimedefang/mimedefang.pid",
  "socket_dir": "/var/run/mimedefang",
  "user": "mailnull",
  "group": "mailnull",
  "temp_dir": "/var/spool/mimedefang",
  "max_children": 15,
  "min_children": 2,
  "min_spare_children": 2,
  "max_spare_children": 8,
  "max_requests_per_child": 500,
  "socket_perms": "0660",
  "socket_owner": "root",
  "socket_group": "mta",
  "timeout": 600,
  "connect_timeout": 120,
  "idle_timeout": 900,
  "transaction_timeout": 600,
  "syslog_facility": "LOCAL0",
  "syslog_level": "info",
  "log_to_file": true,
  "log_file": "/var/log/mimedefang/mimedefang.log",
  "log_pid": true,
  "log_timestamps": true,
  "log_level_verbose": false,
  "action": "accept",
  "quarantine_action": "quarantine",
  "quarantine_dir": "/var/spool/mimedefang/quarantine",
  "quarantine_prefix": "mdq",
  "quarantine_compress": true,
  "quarantine_owner": "mailnull",
  "quarantine_group": "mailnull",
  "quarantine_perms": "0600",
  "replace_bad_headers": true,
  "strip_attachments": false,
  "strip_extensions": true,
  "strip_extensions_list": [
    "exe",
    "bat",
    "com",
    "pif",
    "scr",
    "js",
    "vbs",
    "hta",
    "msi"
  ],
  "virus_action": "quarantine",
  "spam_action": "accept",
  "spam_tag_level": 2.0,
  "spam_tag2_level": 5.0,
  "spam_kill_level": 12.0,
  "clamd_socket": "unix:/var/run/clamav/clamd.sock",
  "freshclam_pidfile": "/var/run/clamav/freshclam.pid",
  "spamd_socket": "unix:/var/run/spamd/spamd.sock",
  "spamd_host": "127.0.0.1",
  "spamd_port": 783,
  "spamd_user": "spamd",
  "spamd_timeout": 30,
  "filter": [
    "/etc/mimedefang/filter",
    "/etc/mimedefang/custom.pl"
  ],
  "disable_milter": false,
  "milter_socket": "unix:/var/run/mimedefang/mimedefang.sock",
  "milter_socket_owner": "mailnull",
  "milter_socket_group": "mta",
  "milter_socket_perms": "0660",
  "milter_timeout": 300,
  "use_ipv6": true,
  "dns_timeout": 10,
  "dns_retries": 3,
  "rate_limit": true,
  "rate_limit_by": "client_ip",
  "rate_limit_log": true,
  "rate_limit_log_file": "/var/log/mimedefang/ratelimit.log",
  "db_path": "/var/lib/mimedefang",
  "db_type": "sqlite",
  "db_user": "",
  "db_pass": "",
  "db_name": "/var/lib/mimedefang/mimedefang.db",
  "db_host": "",
  "db_port": 0
}
