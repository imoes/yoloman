# mimedefang.conf — Main configuration file for MIMEDefang mail filter
# This file controls MIMEDefang's behavior: how it processes mail, what actions it takes, and how it integrates with MTA (e.g., Sendmail or Postfix).
# The format is INI-style: key = value (case-insensitive keys, no quotes required)
# Comments start with # or ;

# General settings
mpd_pid_file = {{ pid_file }}
mpd_socket_dir = {{ socket_dir }}
mpd_user = {{ user }}
mpd_group = {{ group }}
mpd_temp_dir = {{ temp_dir }}
mpd_max_children = {{ max_children }}
mpd_min_children = {{ min_children }}
mpd_min_spare_children = {{ min_spare_children }}
mpd_max_spare_children = {{ max_spare_children }}
mpd_max_requests_per_child = {{ max_requests_per_child }}
mpd_socket_perms = {{ socket_perms }}
mpd_socket_owner = {{ socket_owner }}
mpd_socket_group = {{ socket_group }}

# Timeout settings (seconds)
mpd_timeout = {{ timeout }}
mpd_connect_timeout = {{ connect_timeout }}
mpd_idle_timeout = {{ idle_timeout }}
mpd_transaction_timeout = {{ transaction_timeout }}

# Logging
mpd_syslog_facility = {{ syslog_facility }}
mpd_syslog_level = {{ syslog_level }}
mpd_log_to_file = {{ log_to_file }}
mpd_log_file = {{ log_file }}
mpd_log_pid = {{ log_pid }}
mpd_log_timestamps = {{ log_timestamps }}
mpd_log_level_verbose = {{ log_level_verbose }}

# Filtering behavior
mpd_action = {{ action }}
mpd_quarantine_action = {{ quarantine_action }}
mpd_quarantine_dir = {{ quarantine_dir }}
mpd_quarantine_prefix = {{ quarantine_prefix }}
mpd_quarantine_compress = {{ quarantine_compress }}
mpd_quarantine_owner = {{ quarantine_owner }}
mpd_quarantine_group = {{ quarantine_group }}
mpd_quarantine_perms = {{ quarantine_perms }}
mpd_replace_bad_headers = {{ replace_bad_headers }}
mpd_strip_attachments = {{ strip_attachments }}
mpd_strip_extensions = {{ strip_extensions }}
mpd_strip_extensions_list = {{ strip_extensions_list }}
mpd_virus_action = {{ virus_action }}
mpd_spam_action = {{ spam_action }}
mpd_spam_tag_level = {{ spam_tag_level }}
mpd_spam_tag2_level = {{ spam_tag2_level }}
mpd_spam_kill_level = {{ spam_kill_level }}

# AV/AS integration
mpd_clamd_socket = {{ clamd_socket }}
mpd_freshclam_pidfile = {{ freshclam_pidfile }}
mpd_spamd_socket = {{ spamd_socket }}
mpd_spamd_host = {{ spamd_host }}
mpd_spamd_port = {{ spamd_port }}
mpd_spamd_user = {{ spamd_user }}
mpd_spamd_timeout = {{ spamd_timeout }}

# Perl filter paths (semicolon-separated list)
mpd_filter = {{ filter }}

# Additional options
mpd_disable_milter = {{ disable_milter }}
mpd_milter_socket = {{ milter_socket }}
mpd_milter_socket_owner = {{ milter_socket_owner }}
mpd_milter_socket_group = {{ milter_socket_group }}
mpd_milter_socket_perms = {{ milter_socket_perms }}
mpd_milter_timeout = {{ milter_timeout }}
mpd_use_ipv6 = {{ use_ipv6 }}
mpd_dns_timeout = {{ dns_timeout }}
mpd_dns_retries = {{ dns_retries }}

# Rate limiting
mpd_rate_limit = {{ rate_limit }}
mpd_rate_limit_by = {{ rate_limit_by }}
mpd_rate_limit_log = {{ rate_limit_log }}
mpd_rate_limit_log_file = {{ rate_limit_log_file }}

# Database (optional; for persistent state)
mpd_db_path = {{ db_path }}
mpd_db_type = {{ db_type }}
mpd_db_user = {{ db_user }}
mpd_db_pass = {{ db_pass }}
mpd_db_name = {{ db_name }}
mpd_db_host = {{ db_host }}
mpd_db_port = {{ db_port }}
