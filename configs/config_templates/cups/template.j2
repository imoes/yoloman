#
# SNMP configuration file for CUPS.  See "man cups-snmp.conf" for a complete
# description of this file.
#

# SNMP address for CUPS SNMP monitoring (typically '@LOCAL' for local SNMP agent, or an IP address)
Address {{ snmp_address | default('@LOCAL') }}

# SNMP community string used for polling (usually 'public' for read-only access)
Community {{ snmp_community | default('public') }}