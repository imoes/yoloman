{
  "port": 631,
  "listen_addresses": [
    "192.168.1.10:631"
  ],
  "allow_remote_admin": true,
  "allow_browsing": true,
  "require_auth": true,
  "log_level": "warn",
  "log_file": "/var/log/cups/error_log",
  "access_rules": [
    {
      "comment": "Allow local administrative access",
      "allowed_network": "127.0.0.0/8",
      "auth_required": true,
      "allowed_user": "@SYSTEM"
    },
    {
      "comment": "Allow trusted office LAN to submit jobs",
      "allowed_network": "10.1.2.0/24",
      "auth_required": false
    }
  ],
  "share_printers": true,
  "printcap_file": "/etc/cups/printcap",
  "max_job_size": 104857600,
  "idle_timeout": 300,
  "server_name": "printserver.example.com",
  "default_language": "en",
  "default_charset": "utf-8",
  "max_clients": 200,
  "max_clients_per_host": 20,
  "preserve_job_files": true,
  "preserve_job_history": true
}
