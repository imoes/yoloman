# Configuration file for boxbackup-server (bbstored)
# Generated by BoxBackup configuration manager

[Store]
# Directory where backup data will be stored
Root = {{ store_root }}

# User and group under which the server process runs
User = {{ server_user }}
Group = {{ server_group }}

# PID file path
PidFile = {{ pid_file }}

# Logging configuration
[Logging]
# Log to syslog (true/false)
SysLog = {{ logging_syslog | default(true) | lower }}

# Log to file (if enabled, specify path)
{% if logging_file_enabled %}
File = {{ logging_file_path }}
{% endif %}

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
Level = {{ logging_level }}

# Network and security settings
[Server]
# Address to bind to (e.g., 0.0.0.0 for all interfaces)
Address = {{ server_address }}

# Port to listen on
Port = {{ server_port }}

# SSL/TLS configuration
{% if ssl_enabled %}
SSLCertFile = {{ ssl_cert_file }}
SSLKeyFile = {{ ssl_key_file }}
{% if ssl_ca_file %}
SSLCAFile = {{ ssl_ca_file }}
{% endif %}
{% endif %}

# Authentication method: Password (file-based) or Certificate
AuthMethod = {{ auth_method }}

{% if auth_method == 'Password' %}
# Path to password file for clients
PasswordFile = {{ password_file }}
{% endif %}

{% if auth_method == 'Certificate' %}
# Require client certificates (true/false)
RequireCertificate = {{ require_certificate | default(true) | lower }}
{% endif %}

# Resource limits and performance tuning
[ Limits ]
# Maximum size of a single backup file (in bytes)
MaxFileLength = {{ max_file_length }}

# Maximum number of concurrent connections
MaxConnections = {{ max_connections }}

# Maximum time (in seconds) a client can be idle before disconnection
IdleTimeout = {{ idle_timeout }}

# Account storage and overhead configuration
[Accounting]
# Block size for storage (in bytes); must be power of two
BlockSize = {{ block_size }}

# Overhead factor (extra space reserved per account, in bytes)
OverheadFactor = {{ overhead_factor }}

# Encryption settings
[Encryption]
# Enable encryption for stored data (true/false)
{% if encryption_enabled %}
EncryptData = true
{% else %}
EncryptData = false
{% endif %}

# Cipher to use (if encryption enabled)
{% if encryption_enabled %}
Cipher = {{ encryption_cipher }}
{% endif %}

# Client access configuration
{% for client in clients %}
[Account {{ client.name | upper }}]
# Description/label for the account
{% if client.description %}
Comment = {{ client.description }}
{% endif %}

# Quota (in bytes); 0 means unlimited
Quota = {{ client.quota }}

# Password hash (SHA256) for password auth (if used)
{% if client.password_hash and auth_method == 'Password' %}
Password = {{ client.password_hash }}
{% endif %}

# Client certificate fingerprint (SHA256) for cert auth
{% if client.cert_fingerprint and auth_method == 'Certificate' %}
CertificateFingerprint = {{ client.cert_fingerprint }}
{% endif %}

# Allow client to delete backups? (true/false)
AllowDelete = {{ client.allow_delete | default(false) | lower }}

{% endfor %}
