      "name": "workstation1",
      "description": "Main office workstation",
      "quota": 53687091200,
      "password_hash": "a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456",
      "allow_delete": false
    },
    {
      "name": "server_db",
      "description": "Database backup server",
      "quota": 0,
      "password_hash": "deadbeef1234567890abcdef1234567890abcdef1234567890abcdef123456",
      "allow_delete": false
    }
  ]
}
