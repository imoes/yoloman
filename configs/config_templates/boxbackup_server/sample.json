{
  "store_root": "/var/lib/boxbackup/store",
  "server_user": "backup",
  "server_group": "backup",
  "pid_file": "/run/boxbackup/bbstored.pid",
  "logging_syslog": true,
  "logging_file_enabled": false,
  "logging_file_path": "/var/log/boxbackup/bbstored.log",
  "logging_level": "INFO",
  "server_address": "0.0.0.0",
  "server_port": 8080,
  "ssl_enabled": true,
  "ssl_cert_file": "/etc/boxbackup/bbstored.crt",
  "ssl_key_file": "/etc/boxbackup/bbstored.key",
  "ssl_ca_file": "/etc/boxbackup/ca.crt",
  "auth_method": "Password",
  "password_file": "/etc/boxbackup/passwords.conf",
  "require_certificate": true,
  "max_file_length": 10737418240,
  "max_connections": 50,
  "idle_timeout": 900,
  "block_size": 4096,
  "overhead_factor": 2048,
  "encryption_enabled": true,
  "encryption_cipher": "AES-256-CBC",
  "clients": [
