# kbdd configuration file
# See kbdd(1) man page
#
# kbdd (Keyboard LED Daemon) manages keyboard LEDs based on XKB state.
# This template provides self-documenting configuration for kbdd.

# Run kbdd in foreground (nodaemon) mode
# If true, run kbdd in the foreground instead of detaching as a daemon.
# Useful for debugging or systemd exec_start.
# Default: False
nodaemon={{ nodaemon | default(False) }}

# Initial keyboard layout group to set on startup
# The keyboard layout group index (0-based) to activate upon startup.
# Corresponds to the uint32 argument in dbus set_layout(uint32).
# Default: 0
initial_group={{ initial_group | default(0) }}