{
  "main": {
    "enabled": true,
    "check_interval": 10,
    "min_free_kbytes": 20480,
    "log_level": "warning",
    "log_file": "/var/log/low-memory-monitor.log"
  },
  "notifications": {
    "enabled": true,
    "notify_script": "/opt/notify/lowmem.sh",
    "email_recipients": [
      "admin@example.com",
      "ops@example.com"
    ],
    "min_free_kbytes_threshold": 8192
  },
  "actions": {
    "kill_process": true,
    "kill_process_pattern": "^nobody$|^www-data$",
    "kill_process_min_age_sec": 120
  },
  "monitor": {
    "monitor_processes": [
      {
        "name": "sshd"
      },
      {
        "name": "systemd"
      },
      {
        "name": "cron"
      }
    ]
  }
}
