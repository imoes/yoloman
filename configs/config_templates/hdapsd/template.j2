# HDAPS daemon configuration
# Device to monitor (usually sda or sdb)
device={{ device }}

# Polling interval in milliseconds
poll_interval={{ poll_interval }}

# Sensitivity threshold: movement above this triggers unload
sensitivity={{ sensitivity }}

# Enable or disable automatic unmounting of filesystems
unmount_enabled={{ unmount_enabled | lower }}

# Filesystems to protect (space-separated list)
# Format: mountpoint:device (e.g., /home:/dev/sda2)
protected_mounts={{ protected_mounts | join(' ') }}

# Optional: Additional kernel modules to check for (e.g., thinkpad_acpi)
kernel_modules={{ kernel_modules | join(' ') if kernel_modules else '' }}

# Enable debug logging to syslog
debug={{ debug | lower }}
