# kickpass configuration
# This file configures the default environment and behaviors for kickpass.
# Note: kickpass is primarily a CLI tool; these settings influence its default actions.
# Generated by Ansible Jinja2. Self-documenting: every variable is described inline
# and uses a safe default to prevent render failures when the variable is unset.

# The user's login directory used to compute kickpass workspace path.
# Default: '/root'
export HOME="{{ home_dir | default('/root') }}"

# The preferred utility to edit text files/safe metadata.
# Default: 'nano'
export EDITOR="{{ editor | default('nano') }}"

# Path to the socket used to communicate with kickpass agent.
# Default: '/tmp/kickpass.sock'
export KP_AGENT_SOCK="{{ agent_sock | default('/tmp/kickpass.sock') }}"

# Default length for generated random passwords.
# Default: 32
export KP_DEFAULT_PASSWORD_LENGTH="{{ default_password_length | default(32) }}"

# Whether to use generated random passwords by default when creating safes.
# Default: False
export KP_AUTO_GENERATE="{{ auto_generate_password | default(False) | ternary('yes', 'no') }}"

# Timeout in seconds for the opened safe in the kickpass agent.
# Default: 3600
export KP_AGENT_TIMEOUT="{{ agent_timeout_seconds | default(3600) }}"

# List of safe names/paths to be initialized in the workspace.
# Default: []
{% for safe in init_safes | default([]) %}
# Safe: {{ safe }}
{% endfor %}