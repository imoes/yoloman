# dracut log rotation configuration
# Managed by Ansible - do not edit manually
#
# Controls how dracut-initramfs log files are rotated and retained.
# See man logrotate(8) for directive syntax.

/var/log/dracut.log {
  # rotate_count: Number of rotated log files to keep
  rotate {{ rotate_count | default(12) }}
  monthly
  compress
  missingok
  notifempty
}