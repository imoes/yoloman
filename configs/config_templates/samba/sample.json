{
  "workgroup": "MYCORP",
  "server_string": "File Server",
  "security_mode": "ads",
  "map_to_guest": "Bad User",
  "log_level": 2,
  "log_file": "/var/log/samba/log.%m",
  "max_log_size": 10000,
  "socket_options": "TCP_NODELAY IPTOS_LOWDELAY",
  "tcp_nodelay": true,
  "read_raw": true,
  "write_raw": true,
  "load_printers": false,
  "printcap_name": "/dev/null",
  "idmap_range": "100000-200000",
  "winbind_enum_users": false,
  "winbind_enum_groups": false,
  "winbind_use_default_domain": true,
  "time_server": true,
  "unix_extensions": true,
  "hide_unreadable": false,
  "create_mask": "0660",
  "directory_mask": "0770",
  "printers": [
    {
      "name": "printer_hp",
      "comment": "HP LaserJet in Finance",
      "path": "/var/spool/samba",
      "browseable": true,
      "read_only": false,
      "guest_ok": false,
      "printer_driver": "HP LaserJet P4010 Series PCL 6",
      "printer_driver_location": "//fileserver/drivers/hp"
    }
  ],
  "shares": [
    {
      "name": "data",
      "comment": "Shared project data",
      "path": "/mnt/storage/data",
      "browseable": true,
      "read_only": false,
      "guest_ok": false,
      "valid_users": [
        "@engineers",
        "@managers"
      ],
      "force_group": "projects"
    },
    {
      "name": "public",
      "comment": "Public read-only share",
      "path": "/mnt/storage/public",
      "browseable": true,
      "read_only": true,
      "guest_ok": true,
      "create_mask": "0444"
    }
  ]
}
