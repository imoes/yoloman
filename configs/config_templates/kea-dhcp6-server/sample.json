{
  "control_socket_name": "/run/kea/dhcp6-ctrl.sock",
  "lease_database_type": "memfile",
  "lease_database_name": "/var/lib/kea/kea-dhcp6.leases",
  "lease_database_user": "kea",
  "lease_database_password": "secret123",
  "lease_database_host": "localhost",
  "lease_database_port": 5432,
  "lease_database_lfc_interval": 3600,
  "lease_database_max_reclaim_leases": 1000,
  "lease_database_max_reclaim_time": 250,
  "lease_database_unwarned_reclaim_cycles": 3,
  "hooks_libraries": [
    {
      "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so",
      "parameters": {}
    }
  ],
  "loggers": [
    {
      "name": "kea-dhcp6",
      "output_options": [
        {
          "output": "/var/log/kea/kea-dhcp6.log",
          "maxsize": 10485760,
          "maxver": 5
        }
      ],
      "severity": "INFO",
      "debuglevel": 0
    }
  ],
  "subnets": [
    {
      "id": 1,
      "subnet": "2001:db8:1::/64",
      "interface": "eth0",
      "pools": [
        {
          "pool": "2001:db8:1::100-2001:db8:1::200"
        }
      ],
      "option_data": [
        {
          "name": "dns-servers",
          "data": "2001:db8::1"
        }
      ],
      "reservations": [
        {
          "duid": "00:01:00:01:2b:12:34:56:aa:bb:cc:dd:ee:ff",
          "hostname": "printer1",
          "ip_address": "2001:db8:1::150",
          "option_data": []
        }
      ]
    }
  ],
  "shared_networks": [],
  "interfaces": "eth0",
  "interfaces_config_re_detect": true,
  "server_id_type": "LLT",
  "server_id_identifier": "00:01:02:03:04:05",
  "preferred_lifetime": 3000,
  "valid_lifetime": 6000,
  "renew_timer": 1800,
  "rebind_timer": 3600,
  "ip_realloc": {},
  "dhcpv4_interop_info_only": false
}
