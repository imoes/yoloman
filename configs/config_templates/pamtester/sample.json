{
  "service": "login",
  "user": "root",
  "verbose": true,
  "extra_items": [
    {
      "key": "tty",
      "value": "/dev/tty1"
    },
    {
      "key": "ruser",
      "value": "admin"
    }
  ],
  "extra_envs": [
    {
      "key": "LANG",
      "value": "en_US.UTF-8"
    }
  ],
  "operation": "authenticate",
  "options": "PAM_SILENT"
}
