{
  "init_d_path": "/etc/init.d",
  "default_runlevel": "2",
  "debug": false,
  "extra_init_dirs": [
    "/usr/local/etc/init.d"
  ],
  "dependency_overrides": [
    {
      "script": "network",
      "dependency": "$local_fs",
      "action": "+add"
    },
    {
      "script": "ssh",
      "dependency": "network",
      "action": "*replace"
    }
  ],
  "ignore_missing_tags": false,
  "database_path": "/var/lib/insserv/runlevel.db",
  "max_depth": 150
}
