{# OpenSSL Configuration File Template #}
{# This file is parsed by OpenSSL's CONF library. It defines global settings, #}
{# module selectors (providers, engines, random), and specific subsystem configs. #}

# --- Global pragmas (control parsing behavior) ---

# Enables diagnostic output: configuration errors will fail initialization instead of being silently ignored
# Default: 0 (silent failures)
config_diagnostics = {{ config_diagnostics | default(0) }}

# Points to the initialization section containing module configuration definitions
# Default: 'openssl_init'
openssl_conf = {{ openssl_conf | default('openssl_init') }}

# Optional: include additional config fragments
# Default: [] (empty list)
{% for include_path in (includes | default([])) %}
# Includes an external configuration file or directory (if path points to a directory, all .cnf/.conf files are included)
.include = {{ include_path }}
{% endfor %}

# --- Default section (global settings & fallbacks) ---

# Default values for environment variable fallbacks (e.g., for paths)
# Default: {} (empty map)
{% for varname, value in (env_defaults | default({}) | dict2items) %}
# Default value for environment variable {{ varname }}
{{ varname }} = {{ value }}
{% endfor %}

# --- Initialization section (module selectors) ---

# Section named by `openssl_conf` above: maps OpenSSL subsystems to their configuration sections
[{{ openssl_conf | default('openssl_init') }}]

# Section containing custom ASN.1 Object Identifiers (OIDs)
# Default: '' (empty, no custom OID section)
{% if oid_section | default('') %}
oid_section = {{ oid_section | default('') }}
{% endif %}

# Section defining cryptographic providers (e.g., default, fips)
# Default: '' (empty, no providers section)
{% if providers | default('') %}
providers = {{ providers | default('') }}
{% endif %}

# Section defining EVP algorithm properties (e.g., default_properties)
# Default: '' (empty, no alg section)
{% if alg_section | default('') %}
alg_section = {{ alg_section | default('') }}
{% endif %}

# Section containing named SSL/TLS configurations (e.g., server, client, system_default)
# Default: '' (empty, no ssl config section)
{% if ssl_conf | default('') %}
ssl_conf = {{ ssl_conf | default('') }}
{% endif %}

# Section defining ENGINE configurations (legacy hardware acceleration modules)
# Default: '' (empty, no engines section)
{% if engines | default('') %}
engines = {{ engines | default('') }}
{% endif %}

# Section defining random number generator settings
# Default: '' (empty, no random section)
{% if random | default('') %}
random = {{ random | default('') }}
{% endif %}

# --- Custom OIDs section (if defined) ---
{% if oid_section | default('') %}
[{{ oid_section | default('') }}]
{% for oid_name, oid_value in (oids | default({}) | dict2items) %}
# ASN.1 Object Identifier: short name {{ oid_name }} maps to value {{ oid_value }}
{{ oid_name }} = {{ oid_value }}
{% endfor %}
{% endif %}

# --- Providers section (if defined) ---
{% if providers | default('') %}
[{{ providers | default('') }}]
{% for provider_name, provider_section in (providers_config | default({}) | dict2items) %}
# Declares provider {{ provider_name }} and points to its configuration section
{{ provider_name }} = {{ provider_section }}
{% endfor %}

# Provider-specific configuration blocks
{% for provider_name, provider_section in (providers_config | default({}) | dict2items) %}
[{{ provider_section }}]

{% set p_id = provider_identities | default({}) %}
{% if p_id.get(provider_name) is defined %}
# Overrides the default name for provider {{ provider_name }}
identity = {{ p_id[provider_name] }}
{% endif %}

{% set p_mod = provider_modules | default({}) %}
{% if p_mod.get(provider_name) is defined %}
# Specifies path to shared library for provider {{ provider_name }}
module = {{ p_mod[provider_name] }}
{% endif %}

{% set p_act = provider_activated | default({}) %}
{% if p_act.get(provider_name) is defined %}
# Activates provider {{ provider_name }} (value is ignored)
activate = {{ p_act[provider_name] | lower if p_act[provider_name] is string else '' }}
{% endif %}

{% set p_ext = provider_extra | default({}) %}
{% if p_ext.get(provider_name) is mapping and p_ext.get(provider_name) %}
# Additional provider-specific parameters
{% for key, value in (p_ext[provider_name] | default({}) | dict2items) %}
{{ key }} = {{ value }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# --- EVP properties section (if defined) ---
{% if alg_section | default('') %}
[{{ alg_section | default('') }}]
# Default cryptographic properties query string (e.g., for FIPS mode)
{% if evp_default_properties | default('') %}
default_properties = {{ evp_default_properties | default('') }}
{% endif %}
{% endif %}

# --- SSL/TLS configuration section (if defined) ---
{% if ssl_conf | default('') %}
[{{ ssl_conf | default('') }}]

{% for conf_name, conf_section in (ssl_configs | default({}) | dict2items) %}
# Named SSL/TLS configuration: {{ conf_name }} maps to section {{ conf_section }}
{{ conf_name }} = {{ conf_section }}
{% endfor %}

# Per-configuration blocks (e.g., [server_tls_config], [client_tls_config], [tls_system_default])
{% for conf_name, conf_section in (ssl_configs | default({}) | dict2items) %}
[{{ conf_section }}]

{% if conf_section == 'tls_system_default' and ((min_proto_tls | default('')) or (min_proto_dtls | default(''))) %}
# Applies minimum protocol versions globally (applied at SSL_CTX creation time)
{% if min_proto_tls | default('') %}
MinProtocol = TLSv{{ min_proto_tls | default('') }}
{% endif %}
{% if min_proto_dtls | default('') %}
MinProtocol = DTLSv{{ min_proto_dtls | default('') }}
{% endif %}
{% endif %}

{% set sc = server_certs | default({}) %}
{% if sc.get(conf_name) is mapping and sc.get(conf_name) %}
# Server certificate loading (multiple key types supported)
{% for cert_type, cert_file in (sc[conf_name] | default({}) | dict2items) %}
# Load {{ cert_type }} certificate from {{ cert_file }}
{{ cert_type }}.Certificate = {{ cert_file }}
{% endfor %}
{% endif %}

{% set exo = extra_ssl_opts | default({}) %}
{% if exo.get(conf_section) is mapping and exo.get(conf_section) %}
# Additional SSL_CONF_cmd directives
{% for cmd, val in (exo[conf_section] | default({}) | dict2items) %}
{{ cmd }} = {{ val }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# --- Engine configuration section (if defined) ---
{% if engines | default('') %}
[{{ engines | default('') }}]

{% for engine_name, engine_section in (engines_config | default({}) | dict2items) %}
# Declares engine {{ engine_name }} and points to its config section
{{ engine_name }} = {{ engine_section }}
{% endfor %}

# Engine-specific configuration blocks
{% for engine_name, engine_section in (engines_config | default({}) | dict2items) %}
[{{ engine_section }}]

{% set eid = engine_ids | default({}) %}
{% if eid.get(engine_name) is defined %}
# Overrides the default engine ID for {{ engine_name }}
engine_id = {{ eid[engine_name] }}
{% endif %}

{% set epath = engine_paths | default({}) %}
{% if epath.get(engine_name) is defined %}
# Loads dynamic engine from the specified shared library path
# Equivalent to dynamic.so_path + LIST_ADD + LOAD commands
{% if epath[engine_name] %}
dynamic_path = {{ epath[engine_name] }}
{% endif %}
{% endif %}

{% set einit = engine_inits | default({}) %}
{% if einit.get(engine_name) is defined %}
# Controls initialization: 1 = immediate init, 0 = defer
init = {{ einit[engine_name] }}
{% endif %}

{% set eda = engine_default_algs | default({}) %}
{% if eda.get(engine_name) is defined %}
# Sets default algorithms for the engine
{% if eda[engine_name] %}
default_algorithms = {{ eda[engine_name] }}
{% endif %}
{% endif %}

{% set ectr = engine_ctrls | default({}) %}
{% if ectr.get(engine_name) is mapping and ectr.get(engine_name) %}
# Additional ENGINE ctrl commands
{% for cmd, val in (ectr[engine_name] | default({}) | dict2items) %}
# Send ctrl command {{ cmd }} with value {{ val }}
{{ cmd }} = {{ val }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# --- Random configuration section (if defined) ---
{% if random | default('') %}
[{{ random | default('') }}]

{% if rng_type | default('') %}
# Specifies the random bit generator algorithm
random = {{ rng_type | default('') }}
{% endif %}

{% if rng_cipher | default('') and rng_type | default('') == 'CTR-DRBG' %}
# Cipher to use for CTR-DRBG (ignored by HASH/HMAC-DRBG)
cipher = {{ rng_cipher | default('') }}
{% endif %}

{% if rng_digest | default('') and rng_type | default('') in ['HASH-DRBG', 'HMAC-DRBG'] %}
# Digest to use for HASH/HMAC-DRBG (ignored by CTR-DRBG)
digest = {{ rng_digest | default('') }}
{% endif %}

{% if rng_properties | default('') %}
# Property query string for RNG and underlying algorithms
properties = {{ rng_properties | default('') }}
{% endif %}

{% if rng_seed | default('') %}
# Randomness source (e.g., /dev/urandom)
seed = {{ rng_seed | default('') }}
{% endif %}

{% if rng_seed_properties | default('') %}
# Property query for the randomness source
seed_properties = {{ rng_seed_properties | default('') }}
{% endif %}
{% endif %}