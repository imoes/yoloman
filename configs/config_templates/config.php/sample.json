{
  "config_diagnostics": 1,
  "openssl_conf": "openssl_init",
  "includes": [
    "/etc/openssl/conf.d"
  ],
  "env_defaults": {
    "TMP": "/tmp",
    "OPENSSL_ETC": "/etc/ssl"
  },
  "oid_section": "oids",
  "oids": {
    "newoid1": "new OID, 1.2.3.4.1",
    "testoid": "test, 1.2.3.5"
  },
  "providers": "providers",
  "providers_config": {
    "default": "default_provider",
    "fips": "fips_provider"
  },
  "provider_identities": {
    "fips": "my_fips"
  },
  "provider_modules": {
    "default": "",
    "fips": "/usr/lib/ssl/fips.so"
  },
  "provider_activated": {
    "fips": true
  },
  "provider_extra": {
    "fips": {
      "fips_mode": "1"
    }
  },
  "alg_section": "evp_properties",
  "evp_default_properties": "fips=yes",
  "ssl_conf": "ssl_configuration",
  "ssl_configs": {
    "system_default": "tls_system_default",
    "server": "server_tls_config"
  },
  "server_certs": {
    "RSA": "/etc/ssl/certs/server-rsa.pem",
    "ECDSA": "/etc/ssl/certs/server-ecdsa.pem"
  },
  "extra_ssl_opts": {
    "server_tls_config": {
      "Options": "-Compat",
      "VerifyMode": "Peer"
    }
  },
  "min_proto_tls": "1.2",
  "min_proto_dtls": "1.2",
  "engines": "engines",
  "engines_config": {
    "dynamic": "dynamic_engine"
  },
  "engine_ids": {
    "dynamic": "dynamic"
  },
  "engine_paths": {
    "dynamic": "/usr/lib/engines/engine_dynamic.so"
  },
  "engine_inits": {
    "dynamic": 1
  },
  "engine_default_algs": {
    "dynamic": "ALL"
  },
  "engine_ctrls": {
    "dynamic": {
      "SO_PATH": "/usr/lib/engines/engine_capi.so",
      "LIST_ADD": "1"
    }
  },
  "random": "random",
  "rng_type": "CTR-DRBG",
  "rng_cipher": "AES-256-CTR",
  "rng_seed": "/dev/urandom"
}