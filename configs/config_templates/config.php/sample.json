{
 "alg_section": "evp_properties",
 "config_diagnostics": 1,
 "engine_ctrls": {
  "dynamic": {
   "LIST_ADD": "1",
   "SO_PATH": "/usr/lib/engines/engine_capi.so"
  }
 },
 "engine_default_algs": {
  "dynamic": "ALL"
 },
 "engine_ids": {
  "dynamic": "dynamic"
 },
 "engine_inits": {
  "dynamic": 1
 },
 "engine_paths": {
  "dynamic": "/usr/lib/engines/engine_dynamic.so"
 },
 "engines": "engines",
 "engines_config": {
  "dynamic": "dynamic_engine"
 },
 "env_defaults": {
  "OPENSSL_ETC": "/etc/ssl",
  "TMP": "/tmp"
 },
 "evp_default_properties": "fips=yes",
 "extra_ssl_opts": {
  "server_tls_config": {
   "Options": "-Compat",
   "VerifyMode": "Peer"
  }
 },
 "includes": [
  "/etc/openssl/conf.d"
 ],
 "min_proto_dtls": "1.2",
 "min_proto_tls": "1.2",
 "oid_section": "oids",
 "oids": {
  "newoid1": "new OID, 1.2.3.4.1",
  "testoid": "test, 1.2.3.5"
 },
 "openssl_conf": "openssl_init",
 "provider_activated": {
  "fips": true
 },
 "provider_extra": {
  "fips": {
   "fips_mode": "1"
  }
 },
 "provider_identities": {
  "fips": "my_fips"
 },
 "provider_modules": {
  "default": "",
  "fips": "/usr/lib/ssl/fips.so"
 },
 "providers": "providers",
 "providers_config": {
  "default": "default_provider",
  "fips": "fips_provider"
 },
 "random": "random",
 "rng_cipher": "AES-256-CTR",
 "rng_seed": "/dev/urandom",
 "rng_type": "CTR-DRBG",
 "server_certs": {
  "ECDSA": "/etc/ssl/certs/server-ecdsa.pem",
  "RSA": "/etc/ssl/certs/server-rsa.pem"
 },
 "ssl_conf": "ssl_configuration",
 "ssl_configs": {
  "server": "server_tls_config",
  "system_default": "tls_system_default"
 }
}
