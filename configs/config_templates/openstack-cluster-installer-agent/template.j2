# Logrotate configuration for openstack-cluster-installer-agent
# Managed by Ansible - Do not edit manually

/var/log/openstack-cluster-installer-agent.log {
    # Rotate logs daily
    daily

    # Do not fail if the log file is missing
    missingok

    # Compress rotated log files using gzip
    compress

    # Delay compression of the most recent rotated log file
    delaycompress

    # Copy the log file and then truncate the original, ensuring the daemon keeps writing to the same file descriptor
    copytruncate

    # Path to the PID file for the oci-agent-daemon (used for signal handling or state management if needed)
    # {{ pidfile | default('/var/run/oci-agent-daemon.pid') }}
}
