{
  "allow_root": "false",
  "thread_pool_size": "8",
  "idle_listener_sleep_duration": "10",
  "log_level": "warn",
  "log_timestamp": "false",
  "body_len_limit": "1048576",
  "log_error_details": "false",
  "buffer_size_limit": "1048576",
  "allow_deprecated": "false",
  "listener_type": "DomainSocket",
  "timeout": "200",
  "socket_path": "/run/parsec/parsec.sock",
  "auth_type": "UnixPeerCredentials",
  "workload_endpoint": "unix:///run/spire/sockets/agent.sock",
  "key_manager_name": "sqlite-manager",
  "key_manager_type": "SQLite",
  "key_manager_store_path": "/var/lib/parsec/kim-mappings/sqlite/sqlite-key-info-manager.sqlite3",
  "provider_mbed_name": "mbed-crypto-provider",
  "provider_mbed_type": "MbedCrypto",
  "provider_mbed_key_info_manager": "sqlite-manager"
}
