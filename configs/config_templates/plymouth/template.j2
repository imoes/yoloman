# Plymouth boot splash screen configuration.
# This file overrides the default theme and delays for the boot splash.
# See `plymouth-set-default-theme` and the themes available in /usr/share/plymouth/themes/

[Daemon]

# The theme to use for the splash screen.
# If left empty, Plymouth uses the default theme configured system-wide.
# The theme name must correspond to a directory in /usr/share/plymouth/themes/.
Theme={{ (plymouth_theme | default('')) | string | trim }}

# The number of seconds to delay the splash screen.
# This can be useful for debugging boot issues or waiting for specific services.
# If left empty, no delay is applied (immediate show).
ShowDelay={{ (plymouth_show_delay | default('')) | string | trim }}
