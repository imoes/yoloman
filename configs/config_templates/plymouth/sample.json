{
  "plymouth_service_name": "plymouth",
  "plymouth_required_start": "udev $remote_fs $all",
  "plymouth_required_stop": "$remote_fs",
  "plymouth_should_start": "$x-display-manager",
  "plymouth_should_stop": "$x-display-manager",
  "plymouth_default_start": "2 3 4 5",
  "plymouth_default_stop": "0 6",
  "plymouth_short_description": "Stop plymouth during boot and start it on shutdown",
  "plymouth_path": "/sbin:/bin:/usr/sbin:/usr/bin",
  "plymouth_name": "plymouth",
  "plymouth_desc": "Boot splash manager",
  "plymouth_splash_default": true
}
