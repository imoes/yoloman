[DEFAULT]
# Main worker configuration section

# Maximum number of worker processes to spawn
workers = {{ worker_count }}

# Number of API requests to handle concurrently per worker
api_workers = {{ api_worker_count }}

# Logging configuration
log_dir = {{ log_dir }}
log_file = {{ log_file }}

# Debug mode
# Enable debug logging for detailed diagnostics
debug = {{ debug_mode }}

# Verbose logging
# Increase verbosity of logs for troubleshooting
verbose = {{ verbose_logging }}

# Audit logging
# Enable audit logging for compliance and forensics
audit_log = {{ audit_logging_enabled }}

# Health check listener
# Port for the internal health check endpoint
healthcheck_port = {{ healthcheck_port }}

# Network binding
# Host address the health check listener binds to
healthcheck_host = {{ healthcheck_host }}

# Driver configuration
# Backend amphora driver to use (e.g., 'amphora_haproxy_rest_driver')
amp_driver = {{ amp_driver }}

# Provider driver (e.g., 'amphora', 'ovn')
provider_driver = {{ provider_driver }}

[health_manager]
# Interval (seconds) between health checks
# How often health checks are sent to amphorae
heartbeat_interval = {{ health_heartbeat_interval }}

# Timeout (seconds) before marking amphora dead
# How long to wait for an amphora heartbeat before considering it failed
heartbeat_timeout = {{ health_heartbeat_timeout }}

# Interval (seconds) between health update batches
# How often health status updates are synced with database
health_update_interval = {{ health_update_interval }}

# Controller heartbeat interval
# Time between controller heartbeats for self-monitoring
controller_heartbeat = {{ controller_heartbeat }}

# Number of failed heartbeats before marking amphora dead
# Max missed heartbeats before amphora is evicted
amp_failover_heartbeat_threshold = {{ amp_failover_heartbeat_threshold }}

[database]
# Database connection string
# SQLAlchemy-compatible connection URI for Octavia DB
connection = {{ db_connection }}

# Maximum number of DB connections per worker
# Max pool size for database connections
max_retries = {{ db_max_retries }}

# Retry interval (seconds) for DB connection failures
retry_interval = {{ db_retry_interval }}

[oslo_messaging]
# RabbitMQ topic for RPC communication
# Topic used to communicate with controller and amphora agents
rpc_topic = {{ rpc_topic }}

# Notification driver for events
# Driver to publish Octavia events (e.g., 'messagingv2')
notification_driver = {{ notification_driver }}

# Notifications on for load balancer lifecycle events
# Enable publishing of events (e.g., loadbalancer.create, amphora.create)
notify_on_changes = {{ notify_on_changes }}

[rpc_callback]
# Timeout (seconds) for RPC callback responses
# How long to wait for response from controller during worker-task callbacks
timeout = {{ rpc_callback_timeout }}

[keystone_authtoken]
# Identity service (Keystone) authentication configuration
auth_type = {{ keystone_auth_type }}
auth_url = {{ keystone_auth_url }}
project_domain_name = {{ keystone_project_domain }}
project_name = {{ keystone_project_name }}
user_domain_name = {{ keystone_user_domain }}
username = {{ keystone_username }}
password = {{ keystone_password }}

# Insecure TLS (disable certificate verification)
# Disable TLS certificate verification (only for testing)
insecure = {{ keystone_insecure }}

[certificates]
# Certificate and key paths for amphora communication
ca_certificate = {{ ca_certificate_path }}
server_certificate = {{ server_certificate_path }}

# Private key for server certificate
private_key = {{ server_private_key_path }}

# Certificate expiration warning threshold (days)
# Days before expiry to generate warning
expiring_cert_warning_days = {{ cert_expiry_warning_days }}

[controller_worker]
# Worker process configuration for amphora lifecycle management
# Number of concurrent amphora creation/deletion operations
concurrent_process_group = {{ concurrent_process_group }}

# Number of retries for amphora provisioning
# Max attempts to create or update an amphora before failing
amp_boot_timeout = {{ amp_boot_timeout }}

# Timeout for amphora image build (seconds)
amp_image_timeout = {{ amp_image_timeout }}

# Minimum wait between amphora image builds (seconds)
amp_image_retry_interval = {{ amp_image_retry_interval }}

# Worker threads for async tasks
# Parallel threads for background worker operations (e.g., health update)
amp_threads = {{ amp_threads }}

# Worker thread pool size
# Max threads for RPC and task handling
pool_size = {{ pool_size }}

# Client timeout for amphora API calls (seconds)
client_timeout = {{ client_timeout }}

[service_auth]
# Authentication for service-to-service calls (e.g., Nova, Neutron)
auth_type = {{ service_auth_type }}
auth_url = {{ service_auth_url }}
project_domain_name = {{ service_project_domain }}
project_name = {{ service_project_name }}
user_domain_name = {{ service_user_domain }}
username = {{ service_username }}
password = {{ service_password }}

# Insecure TLS (disable certificate verification)
insecure = {{ service_insecure }}

[networking]
# Network configuration for amphora placement
# Name of the network for amphora management traffic
amphora_network = {{ amphora_network }}

# Subnet for amphora management traffic
amphora_subnet = {{ amphora_subnet }}

# Floating IP pool for public access (if applicable)
# Pool name for amphora floating IPs (leave blank if not used)
amp_floating_ip_pool = {{ amp_floating_ip_pool }}

# Security group for amphora management
# Name or ID of security group applied to amphora management interfaces
amphora_security_groups = {% for sg in amphora_security_groups %}{{ sg }}{% if not loop.last %}, {% endif %}{% endfor %}

# HA network for amphorae (used in active/standby mode)
ha_network_id = {{ ha_network_id }}
ha_network_name = {{ ha_network_name }}
ha_subnet_id = {{ ha_subnet_id }}
ha_subnet_name = {{ ha_subnet_name }}

# Compute driver for amphora provisioning (e.g., 'nova')
compute_driver = {{ compute_driver }}

[vithoria]
# (Optional) Vithoria plugin configuration if enabled
# Only present if using Vithoria plugin for advanced features
{% if vithoria_enabled %}
vithoria_enabled = true
vithoria_url = {{ vithoria_url }}
vithoria_token = {{ vithoria_token }}
{% endif %}
