{
  "worker_count": 4,
  "api_worker_count": 4,
  "log_dir": "/var/log/octavia",
  "log_file": "octavia-worker.log",
  "debug_mode": false,
  "verbose_logging": false,
  "audit_logging_enabled": false,
  "healthcheck_port": 8888,
  "healthcheck_host": "127.0.0.1",
  "amp_driver": "amphora_haproxy_rest_driver",
  "provider_driver": "amphora",
  "health_heartbeat_interval": 10,
  "health_heartbeat_timeout": 10,
  "health_update_interval": 30,
  "controller_heartbeat": 10,
  "amp_failover_heartbeat_threshold": 3,
  "db_connection": "mysql+pymysql://octavia:secretpass@10.0.0.10/octavia?charset=utf8",
  "db_max_retries": 60,
  "db_retry_interval": 1,
  "rpc_topic": "octavia",
  "notification_driver": "messagingv2",
  "notify_on_changes": "error,warning,info,debug",
  "rpc_callback_timeout": 60,
  "keystone_auth_type": "password",
  "keystone_auth_url": "http://10.0.0.20:5000/v3",
  "keystone_project_domain": "Default",
  "keystone_project_name": "service",
  "keystone_user_domain": "Default",
  "keystone_username": "octavia",
  "keystone_password": "octavia_pass",
  "keystone_insecure": false,
  "ca_certificate_path": "/etc/octavia/certs/ca_01.pem",
  "server_certificate_path": "/etc/octavia/certs/server.pem",
  "server_private_key_path": "/etc/octavia/certs/private/server_key.pem",
  "cert_expiry_warning_days": 30,
  "concurrent_process_group": 2,
  "amp_boot_timeout": 120,
  "amp_image_timeout": 600,
  "amp_image_retry_interval": 30,
  "amp_threads": 4,
  "pool_size": 10,
  "client_timeout": 60,
  "service_auth_type": "password",
  "service_auth_url": "http://10.0.0.20:5000/v3",
  "service_project_domain": "Default",
  "service_project_name": "service",
  "service_user_domain": "Default",
  "service_username": "octavia",
  "service_password": "octavia_pass",
  "service_insecure": false,
  "amphora_network": "amphora-mgmt-net",
  "amphora_subnet": "amphora-mgmt-subnet",
  "amp_floating_ip_pool": "floatingips-pool",
  "amphora_security_groups": [
    "amphora-sec-grp",
    "allow-healthcheck"
  ],
  "ha_network_id": "",
  "ha_network_name": "octavia-ha-net",
  "ha_subnet_id": "",
  "ha_subnet_name": "octavia-ha-subnet",
  "compute_driver": "nova",
  "vithoria_enabled": true,
  "vithoria_url": "http://10.0.0.30:9090",
  "vithoria_token": "vithoria-token-secret"
}
