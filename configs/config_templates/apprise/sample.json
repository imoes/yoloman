{
  "debug": false,
  "timeout": 15,
  "retry_attempts": 2,
  "retry_delay": 3,
  "log_level": "info",
  "services": [
    {
      "url": "discord://1234567890/abcdefghijklmnopqrstuvwx?username=Apprise&avatar_url=https://example.com/logo.png",
      "tags": [
        "prod",
        "critical"
      ],
      "comment": "Production Discord channel for critical alerts"
    },
    {
      "url": "mailgun://api@domain.com?to=admin@company.com",
      "tags": [
        "dev"
      ],
      "comment": "Development team email via Mailgun"
    },
    {
      "url": "slack://T12345678/B12345678/abcdefghijklmnopqrstuvwx?icon_url=https://example.com/bot.png&channel=%23alerts",
      "tags": [
        "prod"
      ],
      "comment": "General Slack alerts channel"
    }
  ],
  "tags": {
    "prod": "Production environment alerts",
    "dev": "Development/test environment alerts",
    "critical": "Urgent/system-down alerts"
  },
  "inline_services": [],
  "webhook_defaults": {
    "content_type": "application/json",
    "method": "POST"
  },
  "disable_ssl_verification": false
}
