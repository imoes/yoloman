     "type": "string"
    },
    "group": {
     "default": "",
     "description": "Group override for this pool (defaults to global).",
     "type": "string"
    },
    "listen": {
     "default": "",
     "description": "Socket or IP:port for this pool (required).",
     "type": "string"
    },
    "listen_group": {
     "default": "",
     "description": "Socket group (defaults to global).",
     "type": "string"
    },
    "listen_mode": {
     "default": "",
     "description": "Socket permissions (defaults to global).",
     "type": "string"
    },
    "listen_owner": {
     "default": "",
     "description": "Socket owner (defaults to global).",
     "type": "string"
    },
    "log_level": {
     "default": "",
     "description": "Optional per-pool log level.",
     "type": "string"
    },
    "name": {
     "default": "www",
     "description": "Pool name (must be unique).",
     "type": "string"
    },
    "php_admin_flags": {
     "default": {},
     "description": "PHP ini `php_admin_flag` directives (on/off, cannot be overridden, per-pool).",
     "type": "object"
    },
    "php_admin_values": {
     "default": {},
     "description": "PHP ini `php_admin_value` directives (cannot be overridden by script, per-pool).",
     "type": "object"
    },
    "php_flags": {
     "default": {},
     "description": "PHP ini `php_flag` directives (on/off, per-pool).",
     "type": "object"
    },
    "php_values": {
     "default": {},
     "description": "PHP ini `php_value` directives (runtime-override, per-pool).",
     "type": "object"
    },
    "pid_file": {
     "default": "",
     "description": "Optional per-pool PID file.",
     "type": "string"
    },
    "pm_max_children": {
     "default": 10,
     "description": "Max children (static or dynamic mode).",
     "type": "number"
    },
    "pm_max_requests": {
     "default": 500,
     "description": "Requests before respawn.",
     "type": "number"
    },
    "pm_max_spare_servers": {
     "default": 5,
     "description": "Max idle servers (dynamic mode).",
     "type": "number"
    },
    "pm_min_spare_servers": {
     "default": 2,
     "description": "Min idle servers (dynamic mode).",
     "type": "number"
    },
    "pm_process_idle_timeout": {
     "default": 10,
     "description": "Idle timeout (ondemand mode).",
     "type": "number"
    },
    "pm_start_servers": {
     "default": 5,
     "description": "Start servers (dynamic mode).",
     "type": "number"
    },
    "process_manager": {
     "default": "",
     "description": "Optional per-pool process manager (overrides global if set).",
     "type": "string"
    },
    "request_slowlog_timeout": {
     "default": 5,
     "description": "Slow request threshold (seconds).",
     "type": "number"
    },
    "request_terminate_timeout": {
     "default": 30,
     "description": "Max execution time per request (seconds).",
     "type": "number"
    },
    "slowlog": {
     "default": "/var/log/php/php-fpm-slowlog.log",
     "description": "Path to the slow log file.",
     "type": "string"
    },
    "status_allowed_clients": {
     "default": [
      "127.0.0.1"
     ],
     "description": "IPs allowed to access this pool's status endpoint.",
     "type": "list"
    },
    "status_path": {
     "default": "/status",
     "description": "Path for pool status endpoint.",
     "type": "string"
    },
    "user": {
     "default": "",
     "description": "User override for this pool (defaults to global).",
     "type": "string"
    }
   },
   "type": "object"
  },
  "type": "list"
 },
 "process_manager": {
  "default": "dynamic",
  "description": "Process manager mode: static, dynamic, or ondemand.",
  "enum": [
   "static",
   "dynamic"
  ],
  "type": "string"
 },
 "status_allowed_clients": {
  "default": [
   "127.0.0.1",
   "::1"
  ],
  "description": "List of IPs allowed to access the global status endpoint.",
  "type": "list"
 },
 "syslog_facility": {
  "default": "daemon",
  "description": "Syslog facility (e.g., daemon, local0).",
  "enum": [
   "kern",
   "user",
   "daemon"
  ],
  "type": "string"
 },
 "syslog_ident": {
  "default": "php-fpm",
  "description": "Prefix for syslog entries.",
  "type": "string"
 },
 "user": {
  "default": "www-data",
  "description": "User account under which FPM processes run.",
  "type": "string"
 }
}
