{
 "env_vars": {
  "description": "Environment variables passed to PHP processes (key/value map).",
  "type": "object"
 },
 "error_log": {
  "default": "/var/log/php8.4-fpm.log",
  "description": "Path to the global error log file.",
  "type": "string"
 },
 "group": {
  "default": "www-data",
  "description": "Group under which FPM processes run.",
  "type": "string"
 },
 "listen": {
  "default": "/run/php/php-fpm.sock",
  "description": "Socket or IP:port to listen on (e.g., `/run/php/php-fpm.sock` or `127.0.0.1:9000`).",
  "type": "string"
 },
 "listen_group": {
  "default": "www-data",
  "description": "Group of Unix socket (if applicable).",
  "type": "string"
 },
 "listen_mode": {
  "default": "0660",
  "description": "Permissions (octal) for Unix socket.",
  "type": "string"
 },
 "listen_owner": {
  "default": "www-data",
  "description": "Owner of Unix socket (if applicable).",
  "type": "string"
 },
 "log_level": {
  "default": "notice",
  "description": "Logging verbosity: debug, notice, warning, error, or critical.",
  "type": "string"
 },
 "php_admin_error_log": {
  "default": "/var/log/php/php-fpm-error.log",
  "description": "Path to PHP error log (via `php_admin_value`).",
  "type": "string"
 },
 "php_admin_log_errors": {
  "default": true,
  "description": "Enable PHP internal error logging (`php_admin_flag`).",
  "type": "bool"
 },
 "pid_file": {
  "default": "/run/php/php-fpm.pid",
  "description": "Absolute path to the main FPM PID file.",
  "type": "string"
 },
 "pm_max_children": {
  "default": 10,
  "description": "Maximum number of child processes (used for static and dynamic pools).",
  "type": "number"
 },
 "pm_max_children_dynamic": {
  "default": 10,
  "description": "Maximum number of child processes in dynamic mode (same as `pm_max_children`, but for clarity).",
  "type": "number"
 },
 "pm_max_children_ondemand": {
  "default": 10,
  "description": "Maximum number of child processes in ondemand mode.",
  "type": "number"
 },
 "pm_max_requests": {
  "default": 500,
  "description": "Number of requests after which a child process is respawned.",
  "type": "number"
 },
 "pm_max_spare_servers": {
  "default": 5,
  "description": "Maximum idle servers in dynamic mode.",
  "type": "number"
 },
 "pm_min_spare_servers": {
  "default": 2,
  "description": "Minimum idle servers in dynamic mode.",
  "type": "number"
 },
 "pm_process_idle_timeout": {
  "default": 10,
  "description": "Seconds before idle processes terminate (ondemand only).",
  "type": "number"
 },
 "pm_start_servers": {
  "default": 5,
  "description": "Initial number of child processes in dynamic mode.",
  "type": "number"
 },
 "pools": {
  "default": [
   {
    "listen": "/run/php/php-fpm-www.sock",
    "name": "www",
    "php_admin_flags": {
     "expose_php": "off"
    },
    "php_admin_values": {
     "upload_max_filesize": "20M"
    },
    "php_flags": {
     "display_errors": "off"
    },
    "php_values": {
     "memory_limit": "256M"
    },
    "pm_max_children": 10,
    "request_slowlog_timeout": 5,
    "request_terminate_timeout": 30,
    "slowlog": "/var/log/php/php-fpm-slowlog.log"
   }
  ],
  "items": {
   "fields": {
