{
  "mailcap_entries": [
    {
      "content_type": "text/plain",
      "command": "cat %s",
      "flags": [],
      "description": "Display plain text using cat"
    },
    {
      "content_type": "text/html",
      "command": "lynx -dump %s",
      "flags": [
        "needsterminal",
        "copiousoutput"
      ],
      "description": "Display HTML as plain text using Lynx, requiring terminal and producing copious output"
    },
    {
      "content_type": "image/*",
      "command": "display %s",
      "flags": [
        "needsterminal"
      ],
      "description": "Display all image types using the display command, requiring a terminal window"
    }
  ]
}
