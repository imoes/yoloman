{
  "logtarget": "/var/log/fail2ban.log",
  "syslogsocket": "auto",
  "backend": "inotify",
  "banaction": "iptables-multiport",
  "banaction_allports": "iptables-allports",
  "findtime": 600,
  "bantime": 600,
  "bantime_increment": true,
  "bantime_rndtime": 300,
  "bantime_maxtime": 86400,
  "maxretry": 5,
  "maxretry_local": 3,
  "action": "action_mwl",
  "jails": [
    {
      "name": "sshd",
      "enabled": true,
      "service": "SSH server",
      "port": [
        "ssh"
      ],
      "filter": "sshd",
      "logpath": [
        "/var/log/auth.log",
        "/var/log/secure"
      ],
      "maxretry": 5,
      "findtime": 600,
      "bantime": "10m",
      "banaction": "iptables-multiport",
      "destemail": "admin@example.com",
      "sender": "fail2ban@example.com",
      "mta": "mail",
      "ignoreip": [
        "127.0.0.1/8",
        "::1"
      ]
    },
    {
      "name": "nginx-http-auth",
      "enabled": true,
      "service": "Nginx HTTP Basic Auth",
      "port": [
        "http",
        "https"
      ],
      "filter": "nginx-http-auth",
      "logpath": [
        "/var/log/nginx/error.log"
      ],
      "maxretry": 3,
      "bantime": "1h",
      "ignoreip": [
        "192.168.1.0/24"
      ]
    },
    {
      "name": "proftpd",
      "enabled": false,
      "service": "ProFTPD server",
      "port": [
        "21",
        "ftp"
      ],
      "filter": "proftpd",
      "logpath": [
        "/var/log/proftpd/proftpd.log"
      ]
    }
  ]
}
