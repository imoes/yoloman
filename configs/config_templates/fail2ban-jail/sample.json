{
 "action": "action_mwl",
 "backend": "inotify",
 "banaction": "iptables-multiport",
 "banaction_allports": "iptables-allports",
 "bantime": 600,
 "bantime_increment": true,
 "bantime_maxtime": 86400,
 "bantime_rndtime": 300,
 "findtime": 600,
 "jails": [
  {
   "banaction": "iptables-multiport",
   "bantime": "10m",
   "destemail": "admin@example.com",
   "enabled": true,
   "filter": "sshd",
   "findtime": 600,
   "ignoreip": [
    "127.0.0.1/8",
    "::1"
   ],
   "logpath": [
    "/var/log/auth.log",
    "/var/log/secure"
   ],
   "maxretry": 5,
   "mta": "mail",
   "name": "sshd",
   "port": [
    "ssh"
   ],
   "sender": "fail2ban@example.com",
   "service": "SSH server"
  },
  {
   "bantime": "1h",
   "enabled": true,
   "filter": "nginx-http-auth",
   "ignoreip": [
    "192.168.1.0/24"
   ],
   "logpath": [
    "/var/log/nginx/error.log"
   ],
   "maxretry": 3,
   "name": "nginx-http-auth",
   "port": [
    "http",
    "https"
   ],
   "service": "Nginx HTTP Basic Auth"
  },
  {
   "enabled": false,
   "filter": "proftpd",
   "logpath": [
    "/var/log/proftpd/proftpd.log"
   ],
   "name": "proftpd",
   "port": [
    "21",
    "ftp"
   ],
   "service": "ProFTPD server"
  }
 ],
 "logtarget": "/var/log/fail2ban.log",
 "maxretry": 5,
 "maxretry_local": 3,
 "syslogsocket": "auto"
}
