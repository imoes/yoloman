{
  "server_name": "cups.printserver.local",
  "default_user": "admin",
  "encryption": "Required",
  "validate_certs": true,
  "trust_on_first_use": false,
  "allow_any_root": false,
  "allow_expired_certs": false,
  "digest_options": "DenyMD5",
  "gss_service_name": "host",
  "user_agent_tokens": "Minimal",
  "ssloptions": [
    "MinTLS1.2",
    "MaxTLS1.3",
    "DenyCBC"
  ]
}
