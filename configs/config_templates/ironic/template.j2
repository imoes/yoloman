# Fence agent for OpenStack Ironic: provides fencing via the Ironic API
# Authentication and endpoint details for Ironic
auth_type = "{{ auth_type }}"
auth_url = "{{ auth_url }}"
username = "{{ username }}"
password = "{{ password }}"
tenant_name = "{{ tenant_name }}"
region_name = "{{ region_name }}"

# Ironic-specific options
api_endpoint = "{{ api_endpoint }}"
odebug = {{ debug | lower }}
cafile = "{{ cafile | default('') }}"
insecure = {{ insecure | lower }}

# Node selection (how to identify the target node to fence)
node_id = "{{ node_id | default('') }}"
node_name = "{{ node_name | default('') }}"

# Fencing action and behavior
retry = {{ retry }}
retry_wait = {{ retry_wait }}
action = "{{ action }}"

# Optional: power off mode (graceful vs immediate)
power_off_mode = "{{ power_off_mode }}"

# Timeout settings (seconds)
login_timeout = {{ login_timeout }}
command_timeout = {{ command_timeout }}

# Extra options (e.g., domain name if using keystone v3)
{% if domain_name %}domain_name = "{{ domain_name }}"
{% endif %}{% if project_domain_name %}project_domain_name = "{{ project_domain_name }}"
{% endif %}