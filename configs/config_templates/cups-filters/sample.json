{
  "font_embedding": true,
  "font_dir": "/usr/local/share/fonts",
  "ghostscript_path": "/usr/local/bin/gs",
  "ghostscript_options": "-q -dBATCH -dSAFER -dNOPAUSE -r1200x1200 -sDEVICE=ps2write",
  "max_filter_processes": 8,
  "default_raster_format": "rgb",
  "ipp_everywhere": true,
  "ppd_path": "/opt/cups/ppd",
  "pdf_optimize": true,
  "pdf_rendering_engine": "poppler",
  "raster_scaling": false,
  "raster_dpi_list": [
    600,
    1200
  ],
  "http_proxy_host": "proxy.example.com",
  "http_proxy_port": 3128,
  "log_level": "debug",
  "log_path": "/var/log/cups/cupsfilters.log",
  "dnssd_discovery": true,
  "extra_mime_types": [
    "image/pwg-raster",
    "application/vnd.hp-PCLxl"
  ],
  "filter_mappings": [
    {
      "app_type": "application/vnd.hp-PCLxl",
      "filter": "hp-pclxl",
      "priority": 10
    },
    {
      "app_type": "application/postscript",
      "filter": "pstops",
      "priority": 20
    }
  ],
  "filter_timeout": 600,
  "color_management": true,
  "icc_profile_paths": [
    "/usr/share/color/icc",
    "/opt/icc"
  ],
  "default_rgb_profile": "/opt/icc/AdobeRGB1998.icc",
  "default_cmyk_profile": "/opt/icc/Fogra39L_coated.icc"
}
