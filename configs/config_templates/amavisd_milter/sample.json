{
  "milter_enabled": true,
  "milter_socket_type": "unix",
  "milter_socket_path": "/var/spool/postfix/amavis/amavisd.sock",
  "milter_bind_address": "127.0.0.1",
  "milter_bind_port": 55555,
  "milter_max_procs": 6,
  "milter_timeout": 180,
  "milter_allow_overload": false,
  "milter_allowed_clients": [
    "127.0.0.0/8",
    "::1"
  ],
  "milter_fail_action": "tempfail",
  "milter_add_headers": [
    {
      "header": "X-Amavis-Alert",
      "value": "%%ALERT%%"
    },
    {
      "header": "X-Amavis-Score",
      "value": "%%SCORE%%"
    }
  ],
  "milter_debug": 2,
  "milter_name": "amavisd-milter",
  "milter_strip_whitespace": true,
  "milter_preserve_envelope": false
}
