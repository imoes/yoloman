# =============================================================================
# Autopsy Configuration Template
# =============================================================================
# This file configures the Autopsy forensic analysis platform.
# It defines paths to binaries, data directories, and server timeout behavior.
# All variables are populated from Ansible facts/vars with safe defaults.
# =============================================================================

# ------------------------------------------------------------------------------
# BASEDIR: Directory where cases and forensic images are located.
# This is the root storage location for all Autopsy case data.
# ------------------------------------------------------------------------------
BASEDIR={{ BASEDIR | default('/var/lib/autopsy') }}

# ------------------------------------------------------------------------------
# TSKDIR: Directory where The Sleuth Kit binaries are located.
# Autopsy relies on The Sleuth Kit (TSK) for low-level disk image parsing.
# ------------------------------------------------------------------------------
TSKDIR={{ TSKDIR | default('/usr/bin') }}

# ------------------------------------------------------------------------------
# NSRLDB: Location of the NIST National Software Reference Library database.
# Used for file hashing to identify known benign software during analysis.
# ------------------------------------------------------------------------------
NSRLDB={{ NSRLDB | default('/var/lib/nsrl') }}

# ------------------------------------------------------------------------------
# INSTALLDIR: Directory where Autopsy was installed.
# Points to the core application files and plugins.
# ------------------------------------------------------------------------------
INSTALLDIR={{ INSTALLDIR | default('/usr/share/autopsy') }}

# ------------------------------------------------------------------------------
# GREP_EXE: Path to grep(1) binary.
# Used by Autopsy for text search within evidence files.
# ------------------------------------------------------------------------------
GREP_EXE={{ GREP_EXE | default('grep') }}

# ------------------------------------------------------------------------------
# STRINGS_EXE: Path to strings(1) binary.
# Used to extract printable strings from binary files for analysis.
# ------------------------------------------------------------------------------
STRINGS_EXE={{ STRINGS_EXE | default('strings') }}

# ------------------------------------------------------------------------------
# USE_STIMEOUT: When true, server exits after STIMEOUT seconds of inactivity.
# Controls whether the Autopsy Web Service remains idle or shuts down.
# Accepted values: true/false (boolean) or 1/0 (integer).
# ------------------------------------------------------------------------------
USE_STIMEOUT={{ USE_STIMEOUT | default(false) }}

# ------------------------------------------------------------------------------
# STIMEOUT: Inactivity timeout in seconds (used only if USE_STIMEOUT=true).
# Specifies the duration of silence before the server process terminates.
# ------------------------------------------------------------------------------
STIMEOUT={{ STIMEOUT | default(3600) }}