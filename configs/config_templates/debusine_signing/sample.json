{
  "bind_address": "0.0.0.0",
  "port": 443,
  "workers": 2,
  "keyring_path": "/etc/debusine/keyring",
  "default_key_id": "F1A2B3C4D5E6F789",
  "timeout": 60,
  "debug": false,
  "hmac_secret": "supersecretsharedkey",
  "trusted_clients": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "signing_policies": [
    {
      "name": "Debian packages",
      "pattern": "*.deb",
      "description": "Automatically sign all Debian binary packages"
    },
    {
      "name": "APT repositories",
      "pattern": "dists/*/InRelease",
      "key_id": "A1B2C3D4E5F6G789"
    }
  ],
  "log_max_size_mb": 20,
  "log_rotate_count": 3
}
