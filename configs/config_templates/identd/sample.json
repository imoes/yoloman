{
  "port": 113,
  "bind_address": "0.0.0.0",
  "user": "nobody",
  "group": "nogroup",
  "pid_file": "/var/run/ident2.pid",
  "timeout": 30,
  "max_connections": 50,
  "os_type": "UNIX",
  "use_syslog": true,
  "log_file": "/var/log/ident2.log",
  "log_level": "info",
  "response_mode": "masquerade",
  "masquerade_name": "UNKNOWN",
  "enable_ipv6": true,
  "deny_rules": [
    {
      "network": "0.0.0.0/0"
    }
  ],
  "allow_rules": [
    {
      "network": "192.168.0.0/16"
    },
    {
      "network": "172.16.0.0/12"
    }
  ]
}
