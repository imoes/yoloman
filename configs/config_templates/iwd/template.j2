[General]
# Enable or disable the use of the internal DHCP client
# Set to true to enable, false to disable
UseInternalDHCClient={{ use_internal_dhcp_client | lower }}

# Enable or disable the use of the internal DNS resolver
# Set to true to enable, false to disable
UseInternalDNSServer={{ use_internal_dns_server | lower }}

# Set the network backend to use ('none', 'internal', 'ofono', 'connman')
NetworkConfigurationProvider={{ network_configuration_provider }}

# Enable or disable IPv6 support
# Set to true to enable, false to disable
EnableIPv6={{ enable_ipv6 | lower }}

# Set the maximum number of concurrent connections
# Limits the number of networks that can be connected simultaneously
MaxConnectedNetworks={{ max_connected_networks }}

# Set the timeout (in seconds) for network scanning
# The daemon will wait this long before considering a scan complete
ScanInterval={{ scan_interval }}

# Set the timeout (in seconds) for association attempts
# Time to wait for a network to associate before giving up
AssociationTimeout={{ association_timeout }}

# Set the timeout (in seconds) for DHCP configuration
# Time to wait for DHCP to complete before failing
DHCPTimeout={{ dhcp_timeout }}

# Set the timeout (in seconds) for DNS configuration
# Time to wait for DNS to resolve before failing
DNSTimeout={{ dns_timeout }}

# Set the MAC address randomization mode ('disabled', 'network', 'always')
MACAddressRandomization={{ mac_address_randomization }}

# Set the path to the certificates directory for EAP-TLS
# Must contain ca.pem, client.pem, and client.key (or symlinks)
# Leave empty to disable EAP-TLS
EAPTLSCertificatePath={{ eap_tls_certificate_path | default('') }}

# Set the path to the private key password (for EAP-TLS client key)
# Leave empty if the key is not encrypted
EAPTLSPrivateKeyPassword={{ eap_tls_private_key_password | default('') }}

{% for network in networks %}
[Network {{ network.name }}]
# Name of the network (used as identifier)
# Must be unique and match the SSID for hidden networks
Name={{ network.name }}

# Set the security type ('open', 'psk', 'sae', '8021x')
Security={{ network.security }}

# Set the pre-shared key (WPA2/WPA3-PSK)
# Leave empty if not applicable
Password={{ network.password | default('') }}

# Set the SAE password (WPA3-Personal)
# Leave empty if not using SAE
SAEPassword={{ network.sae_password | default('') }}

# Set the EAP method for 802.1x authentication
# e.g., 'PEAP', 'TTLS', 'TLS'
EAPMethod={{ network.eap_method | default('') }}

# Set the identity (for PEAP/TTLS)
# Leave empty if not required
Identity={{ network.identity | default('') }}

# Set the anonymous identity (for PEAP/TTLS)
AnonymousIdentity={{ network.anonymous_identity | default('') }}

# Set the CA certificate path (for PEAP/TTLS/TLS)
# Leave empty if no CA cert verification needed
CACertificate={{ network.ca_certificate | default('') }}

# Set the client certificate path (for TLS)
ClientCertificate={{ network.client_certificate | default('') }}

# Set the client private key path (for TLS)
ClientPrivateKey={{ network.client_private_key | default('') }}

# Enable or disable background scanning for this network
# Set to false to prevent background reconnection attempts
BackgroundScan={{ network.background_scan | lower }}

# Set the preferred frequency band ('any', '2ghz', '5ghz')
FrequencyBand={{ network.frequency_band | default('any') }}

{% endfor %}