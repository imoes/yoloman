{
  "use_internal_dhcp_client": true,
  "use_internal_dns_server": true,
  "network_configuration_provider": "internal",
  "enable_ipv6": true,
  "max_connected_networks": 8,
  "scan_interval": 300,
  "association_timeout": 15,
  "dhcp_timeout": 20,
  "dns_timeout": 10,
  "mac_address_randomization": "network",
  "eap_tls_certificate_path": "",
  "eap_tls_private_key_password": "",
  "networks": [
    {
      "name": "HomeWiFi",
      "security": "sae",
      "sae_password": "MySuperSecretPassword123!",
      "background_scan": true,
      "frequency_band": "any"
    },
    {
      "name": "Hidden:Corporate",
      "security": "8021x",
      "eap_method": "PEAP",
      "identity": "john.doe@company.com",
      "anonymous_identity": "anonymous@company.com",
      "ca_certificate": "/etc/ssl/certs/company-ca.pem",
      "background_scan": true,
      "frequency_band": "5ghz"
    },
    {
      "name": "GuestAP",
      "security": "psk",
      "password": "GuestPassword!",
      "background_scan": false,
      "frequency_band": "2ghz"
    }
  ]
}
