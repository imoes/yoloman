{
  "url": {
    "type": "string",
    "default": "http://some.somecomputer.somewhere/squidtaild",
    "description": "URL where squidtaild will reference its files."
  },
  "htmldir": {
    "type": "string",
    "default": "/my/directory/for/squidtaild/",
    "description": "Directory where violation HTML files are generated."
  },
  "squidlog": {
    "type": "string",
    "default": "/var/log/squid/access.log",
    "description": "Path to the Squid access log file."
  },
  "incremental": {
    "type": "string",
    "default": "yes",
    "description": "Enable incremental processing mode."
  },
  "truncate_url": {
    "type": "string",
    "default": "yes",
    "description": "Enable truncation of URLs."
  },
  "url_length": {
    "type": "number",
    "default": 50,
    "description": "Maximum length of truncated URLs in characters."
  },
  "refresh": {
    "type": "number",
    "default": 60,
    "description": "Status page refresh interval in seconds."
  },
  "dnslookups": {
    "type": "string",
    "default": "yes",
    "description": "Enable DNS lookups for IP addresses."
  },
  "mailreport": {
    "type": "string",
    "default": "yes",
    "description": "Enable mail reporting of violations."
  },
  "mailstyle": {
    "type": "string",
    "default": "html",
    "description": "Format of mail reports: 'text' or 'html'.",
    "enum": [
      "text",
      "html"
    ]
  },
  "sendmail": {
    "type": "string",
    "default": "/usr/sbin/sendmail",
    "description": "Path to the sendmail executable."
  },
  "mailrecipient": {
    "type": "string",
    "default": "somebody@somewhere.com",
    "description": "Email address to receive violation reports."
  },
  "possible": {
    "type": "string",
    "default": "/etc/squidtaild/filters/possible",
    "description": "Path to the 'possible' filter file."
  },
  "probable": {
    "type": "string",
    "default": "/etc/squidtaild/filters/probable",
    "description": "Path to the 'probable' filter file."
  },
  "definite": {
    "type": "string",
    "default": "/etc/squidtaild/filters/definite",
    "description": "Path to the 'definite' filter file."
  },
  "excludes": {
    "type": "string",
    "default": "/etc/squidtaild/filters/excludes",
    "description": "Path to the 'excludes' filter file."
  },
  "winpopups": {
    "type": "string",
    "default": "no",
    "description": "Enable Windows popup notifications."
  },
  "smbclient": {
    "type": "string",
    "default": "/usr/bin/smbclient",
    "description": "Path to the smbclient executable."
  },
  "winpopup_users": {
    "type": "string",
    "default": "no",
    "description": "Send winpopup notifications to users."
  },
  "user_msg": {
    "type": "string",
    "default": "You have violated our policy!",
    "description": "Message displayed in user winpopup notifications."
  },
  "winpopup_admin": {
    "type": "string",
    "default": "no",
    "description": "Send winpopup notifications to admin."
  },
  "admin_msg": {
    "type": "string",
    "default": "A policy violation has just occurred!",
    "description": "Message displayed in admin winpopup notifications."
  },
  "admin_computer": {
    "type": "string",
    "default": "admin_machine",
    "description": "NetBIOS name of the admin computer to send popups to."
  }
}
