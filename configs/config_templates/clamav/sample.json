{
  "listen_host": "",
  "listen_port": 3310,
  "socket_path": "/var/run/clamav/clamd.ctl",
  "scan_user": "clamav",
  "max_threads": 8,
  "scan_timeout": 120,
  "read_timeout": 30,
  "max_recursion": 16,
  "max_files": 5000,
  "enable_compression_scan": true,
  "max_scan_size_mb": 100,
  "max_archive_size_mb": 250,
  "enable_heuristic_scan": true,
  "enable_pua_scan": false,
  "log_file": "/var/log/clamav/clamd.log",
  "log_verbose": 0,
  "log_rotate": true,
  "log_rotate_max_size_mb": 10,
  "pid_file": "/var/run/clamav/clamd.pid",
  "database_directory": "/var/lib/clamav",
  "enable_local_update": true,
  "pua_categories": [],
  "exclude_paths": [
    "/proc",
    "/sys",
    "/dev",
    "/run"
  ],
  "include_paths": [
    "/home",
    "/var/www"
  ],
  "enable_mail_scan": true,
  "enable_embedded_urls": false,
  "enable_archive_scan": true,
  "enable_broken_scan": true,
  "enable_bytecode": true,
  "trust_bytecode": "signed",
  "extra_signatures_path": "",
  "enable_pe_scan": true,
  "enable_elf_scan": true,
  "enable_pdf_scan": true,
  "enable_html_scan": true,
  "enable_office_scan": true,
  "enable_swf_scan": true,
  "enable_hwp_scan": false
}
