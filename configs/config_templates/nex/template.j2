# =============================================================================
# Nex (nvi) Editor Configuration Template
# =============================================================================
# This file corresponds to $HOME/.nexrc (user-specific) or /etc/vi.exrc (system-wide).
# It configures the behavior of the nvi editor, including screen dimensions,
# indentation, shell interaction, backup strategies, and search options.
#
# Self-documenting: Every directive is preceded by its schema description.
# All variables use defaults to ensure valid output even when variables are undefined.
# =============================================================================

# Set the number of columns in the screen (co). Default 80.
set columns={{ columns | default(80) }}

# Set the number of lines in the screen (li). Default 24.
set lines={{ lines | default(24) }}

# Set tab width for the editor display (ts). Default 8.
set tabstop={{ tabstop | default(8) }}

# Autoindent and shift command indentation width (sw). Default 8.
set shiftwidth={{ shiftwidth | default(8) }}

# The shell used by the editor (sh). Default /bin/sh.
# Note: Ensure the specified shell is installed on the system.
set shell={{ shell | default('/bin/sh') }}

# Backup files before they are overwritten. If empty, backups are disabled.
# Common values: '.bak', '~', or empty string to disable.
set backup={{ backup | default('') }}

# The directory where temporary files are created (dir). Default /tmp.
# Ensure the specified directory is writable by the editor user.
set directory={{ directory | default('/tmp') }}

# The directory where recovery files are stored (recdir). Default /var/tmp/vi.recover.
# Used for crash recovery; ensure this directory exists and is accessible.
set recdir={{ recdir | default('/var/tmp/vi.recover') }}

# List of tags files to search for tag lookups (tag).
# Items are flat strings representing file paths.
set tags={{ tags | default(['tags', '/var/db/libc.tags', '/sys/kern/tags']) | join(' ') }}

# Ignore case differences in regular expressions (ic). Default False.
# When on, search patterns match both upper and lower case.
set ignorecase={{ ignorecase | default(False) | ternary('on', 'off') }}

# Automatically indent new lines (ai). Default False.
# Preserves the indentation level of the previous line.
set autoindent={{ autoindent | default(False) | ternary('on', 'off') }}

# Display the current editor mode and a modified flag (smd). Default False.
# Shows visual feedback like "-- INSERT --" or "-- VISUAL --".
set showmode={{ showmode | default(False) | ternary('on', 'off') }}

# Precede each line displayed with its current line number (nu). Default False.
# Enables numbered lines in the editor buffer view.
set number={{ number | default(False) | ternary('on', 'off') }}