# /etc/default/rbldnsd
# Configuration file for rbldnsd instances.
# See rbldnsd(8) for descriptions of options.
#
# This file sets the RBLDNSD variable, which should contain a multiline
# list of all instances of rbldnsd to start. Each line consists of a
# key (used for the PID file basename) and the rbldnsd command line arguments.
#
# For a single instance, the key is typically a dash (-).
# The format is:
# RBLDNSD="- -r <data_dir> -b <listen_addr> <zone_spec> ..."

# Main variable holding the command line definition(s) for rbldnsd instances.
RBLDNSD="- \
-r/var/lib/rbldns \
-b{{ (listen_addresses | default([])) | first | default('0.0.0.0') }} \
{% for zone in (zones | default([])) %}
  {{ zone.name }}:ip4set:{{ zone.key }} \
{% endfor %}
"
