{
  "dnsbl_version": "rbldnsd-0.92",
  "log_file": "/var/log/rbldnsd/rbldnsd.log",
  "pid_file": "/run/rbldnsd/rbldnsd.pid",
  "service_user": "rbldnsd",
  "service_group": "rbldnsd",
  "listen_addresses": [
    "127.0.0.1",
    "192.168.1.10"
  ],
  "listen_port": 53,
  "zones": [
    {
      "name": "bl.example.com",
      "type": "file",
      "file": "/var/lib/rbldnsd/bl.example.com.zone",
      "rrttl": 3600,
      "default_ttl": 7200,
      "max_ttl": 86400,
      "min_ttl": 60,
      "soa_serial": 2024060101,
      "soa_refresh": 3600,
      "soa_retry": 600,
      "soa_expire": 604800,
      "soa_minimum": 600,
      "soa_primary": "ns1.example.com",
      "soa_responsible": "hostmaster.example.com"
    },
    {
      "name": "dbl.example.com",
      "type": "data",
      "data_file": "/var/lib/rbldnsd/dbl.example.com.data",
      "data_format": "cidr",
      "rrttl": 1800,
      "default_ttl": 3600,
      "max_ttl": 43200,
      "min_ttl": 60,
      "soa_serial": 2024060102,
      "soa_refresh": 7200,
      "soa_retry": 900,
      "soa_expire": 1209600,
      "soa_minimum": 300,
      "soa_primary": "ns2.example.com",
      "soa_responsible": "dns-admin.example.com"
    }
  ],
  "extra_zones": []
}
