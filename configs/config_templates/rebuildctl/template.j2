# Configuration file for rebuildctl worker
# See rebuildctl(5) for full documentation

# Top-level configuration container for rebuildctl settings. Note: This template uses a flat structure for simplicity in schema definition, bu
{% set config = config | default({}) %}

# rebuilderd endpoint URI to talk to
# The full URI of the rebuilderd service that this worker connects to.
endpoint = "{{ (config | default({})).endpoint | default('http://127.0.0.1:8080') }}"

# Verbosity level (0=quiet, 1=normal, 2=verbose)
# Controls the amount of log output generated by the worker.
verbose = {{ (config | default({})).verbose | default(0) }}

# Use color output regardless of TTY detection
# When true, forces colorized output even if stderr is not a TTY.
color = {{ (config | default({})).color | default(true) }}

# Directory for package builds
# The working directory where source packages are unpacked and built.
workdir = "{{ (config | default({})).workdir | default('/var/lib/rebuilderd/worker') }}"

# Number of parallel build jobs
# Maximum number of concurrent build processes allowed.
jobs = {{ (config | default({})).jobs | default(1) }}

# Maximum number of retries for failed builds
# How many times to retry a build before marking it as permanently failed.
retries = {{ (config | default({})).retries | default(3) }}

# Path to the repository of build dependencies
# Directory containing pre-built dependency packages required for compilation.
depsdir = "{{ (config | default({})).depsdir | default('/var/lib/rebuilderd/deps') }}"

# Path to the repository of built packages
# Directory where successfully built .deb (or other format) packages are stored.
outdir = "{{ (config | default({})).outdir | default('/var/lib/rebuilderd/out') }}"

# List of architectures to build for
# Architectures that this worker is responsible for building packages for.
{% for arch in (config | default({})).architectures | default(['amd64', 'i386']) %}
arch = "{{ arch }}"
{% endfor %}

# List of suites to monitor
# Debian-style suites (e.g., stable, testing, unstable) that this worker tracks.
{% for suite in (config | default({})).suites | default(['stable']) %}
suite = "{{ suite }}"
{% endfor %}

# Enable/disable signing of built packages
# Whether to cryptographically sign the generated packages after build.
sign = {{ (config | default({})).sign | default(false) }}

# GPG key ID for signing
# The GPG key fingerprint or ID used to sign packages when 'sign' is true.
signing_key = "{{ (config | default({})).signing_key | default('') }}"

# Path to the log file
# The absolute path to the log file where worker events are recorded.
log = "{{ (config | default({})).log | default('/var/log/rebuilderd/worker.log') }}"