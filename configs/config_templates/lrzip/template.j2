# lrzip configuration file
# Self-documenting template generated for Ansible.
# See lrzip(1) for details on each setting.

# Compression level for lzma, bzip2, or gzip. Range 1-9. Default 7.
# Corresponds to -L <level>
level = {{ level | default(7) }}

# Nice value for process scheduling. Range -20 to 19. Default 19.
# Corresponds to -N <value>
nice_level = {{ nice_level | default(19) }}

# Number of processor threads to use. Overrides auto-detection.
# 0 means auto-detect based on available CPUs.
# Corresponds to -p <value>
threads = {{ threads | default(0) }}

# Maximum available RAM in hundreds of MB. Overrides detected amount.
# 0 means auto-detect based on system memory.
# Corresponds to -m <size>
maxram = {{ maxram | default(0) }}

# Maximum compression window size in hundreds of MB.
# 0 uses heuristic to determine optimal window size.
# Corresponds to -w <size>
window = {{ window | default(0) }}

# Compression backend algorithm.
# Options: lzma (default), bzip2, gzip, lzo, zpaq, none.
# Corresponds to -b (bzip2), -g (gzip), -l (lzo), -z (zpaq), -n (none)
backend = {{ backend | default('lzma') }}

# Enable integrity checking of files written to disk on decompression.
# Corresponds to -c
check = {{ check | default(false) | lower }}

# Delete source file after successful compression or decompression.
# Corresponds to -D
delete_source = {{ delete_source | default(false) | lower }}

# Force overwrite of existing files.
# Corresponds to -f
force = {{ force | default(false) | lower }}

# Keep broken or damaged output files instead of deleting them.
# Corresponds to -k
keep_broken = {{ keep_broken | default(false) | lower }}

# Disable LZ4 compressibility testing for slower back-ends.
# Corresponds to -T
threshold_disable = {{ threshold_disable | default(false) | lower }}

# Use unlimited window size (sliding mmap) beyond ramsize.
# Corresponds to -U
unlimited_window = {{ unlimited_window | default(false) | lower }}

# Output suffix for compressed files. Default '.lrz'.
# Corresponds to -S <suffix>
suffix = {{ suffix | default('.lrz') }}

# Temporary directory for storage of temporary files.
# Overrides TMP environment variable. If empty, lrzip uses TMP env var.
tmpdir = {{ tmpdir | default('') }}