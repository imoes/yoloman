# ==============================================================================
# Wavemon Configuration Template
# ==============================================================================
# This template configures wavemon, a monitor for wireless network interfaces.
# It generates a user-specific configuration file (typically ~/.wavemonrc).
# All fields are self-documented with their schema defaults to ensure safe reuse.
# ==============================================================================

# ------------------------------------------------------------------------------
# Wireless Interface Configuration
# ------------------------------------------------------------------------------
# interface = eth0
# Description: Wireless interface to monitor. Leave empty for autodetection.
# Type: string
# ------------------------------------------------------------------------------
interface = {{ interface | default('', true) }}

# ------------------------------------------------------------------------------
# Screen Toggling Keys (Single Character Keys)
# ------------------------------------------------------------------------------

# level_key = "l"
# Description: Single character key to toggle the level histogram screen.
# Type: string (single char)
# ------------------------------------------------------------------------------
level_key = "{{ level_key | default('l', true) }}"

# scan_key = "s"
# Description: Single character key to toggle the scan window screen.
# Type: string (single char)
# ------------------------------------------------------------------------------
scan_key = "{{ scan_key | default('s', true) }}"

# info_key = "i"
# Description: Single character key to toggle the info screen.
# Type: string (single char)
# ------------------------------------------------------------------------------
info_key = "{{ info_key | default('i', true) }}"

# ------------------------------------------------------------------------------
# Scan Window Sorting Behavior
# ------------------------------------------------------------------------------

# sort_order = "signal"
# Description: Sorting criterion for the scan window.
# Options: essid, signal, channel, mac, open.
# Type: string
# ------------------------------------------------------------------------------
sort_order = "{{ sort_order | default('signal', true) }}"

# sort_ascending = 1
# Description: Sort scan results in ascending order.
# Type: boolean
# ------------------------------------------------------------------------------
sort_ascending = {{ sort_ascending | default(true, true) }}

# scan_interval = 5
# Description: Interval in seconds between scans in the scan window.
# Type: integer
# ------------------------------------------------------------------------------
scan_interval = {{ scan_interval | default(5, true) }}

# ------------------------------------------------------------------------------
# Display and Refresh Settings
# ------------------------------------------------------------------------------

# color = 1
# Description: Enable color display if the terminal supports it.
# Type: boolean
# ------------------------------------------------------------------------------
color = {{ color | default(true, true) }}

# update_interval = 100
# Description: Refresh rate of the main interface in centiseconds.
# 100 centiseconds = 1 second.
# Type: integer
# ------------------------------------------------------------------------------
update_interval = {{ update_interval | default(100, true) }}