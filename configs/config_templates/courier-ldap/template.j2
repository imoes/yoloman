#
# ldapaddressbook created from ldapaddressbook.dist by sysconftool
#
# Do not alter lines that begin with ##, they are used when upgrading
# this configuration.
#
# This is a global list of LDAP address books provided to Courier IMAP/POP3 clients.
# Each line defines one address book using <tab> as the delimiter.
#
# Format per line:
# LABEL \t HOST \t PORT \t BASEDN \t SEARCHBASE
#
# Example:
# YourOrganizationName	ldap.example.com	389	ou=member_directory,o=example.com	ou=people,o=example.com
#
# Field descriptions:
# LABEL         - Human-readable name for the address book shown in the client.
# HOST          - The hostname or IP address of the LDAP server.
# PORT          - The TCP port number on which the LDAP server listens.
# BASEDN        - The Base DN for the LDAP search scope.
# SEARCHBASE    - The specific subtree (RDN) within the Base DN to search for entries.

##NAME: ldapaddressbook:0

{#
  Iterate over the list of LDAP address book entries provided by the user.
  Expected variable: ldap_address_books
  Type: List of Maps/Dictionaries.
  Expected keys in each map: label, host, port, basedn, searchbase
  If the variable is undefined, output nothing (empty list).
#}
{% for abook in (ldap_address_books | default([])) %}
# Label: Human-readable name for the address book shown in the client.
# Host: The hostname or IP address of the LDAP server.
# Port: The TCP port number on which the LDAP server listens.
# Basedn: The Base DN for the LDAP search scope.
# Searchbase: The specific subtree (RDN) within the Base DN to search for entries.
{{ abook.label | default('') }}	{{ abook.host | default('localhost') }}	{{ abook.port | default(389) }}	{{ abook.basedn | default('') }}	{{ abook.searchbase | default('') }}
{% endfor %}