{
  "url": {
    "type": "string",
    "default": "",
    "description": "The URL to capture (required)"
  },
  "output": {
    "type": "string",
    "default": "",
    "description": "The target file path (e.g., screenshot.png)"
  },
  "out_format": {
    "type": "string",
    "default": "png",
    "description": "Output format override (e.g., png, svg, pdf)",
    "enum": [
      "png",
      "svg",
      "pdf",
      "ps",
      "jpeg",
      "tiff",
      "gif",
      "bmp"
    ]
  },
  "min_width": {
    "type": "number",
    "default": 800,
    "description": "Minimal width for the image"
  },
  "min_height": {
    "type": "number",
    "default": 600,
    "description": "Minimal height for the image"
  },
  "max_wait": {
    "type": "number",
    "default": 90000,
    "description": "Maximum waiting time in milliseconds (0 = infinite)"
  },
  "delay": {
    "type": "number",
    "default": 0,
    "description": "Additional delay after successful load in milliseconds"
  },
  "user_style_path": {
    "type": "string",
    "default": "",
    "description": "Path to user style sheet file"
  },
  "user_style_string": {
    "type": "string",
    "default": "",
    "description": "Inline CSS user style rules"
  },
  "headers": {
    "type": "list",
    "default": [],
    "description": "List of HTTP request headers to send; each item must have 'name' and 'value' fields"
  },
  "method": {
    "type": "string",
    "default": "get",
    "description": "HTTP request method",
    "enum": [
      "get",
      "post",
      "put"
    ]
  },
  "body_string": {
    "type": "string",
    "default": "",
    "description": "Unencoded request body"
  },
  "body_base64": {
    "type": "string",
    "default": "",
    "description": "Base64-encoded request body"
  },
  "app_name": {
    "type": "string",
    "default": "",
    "description": "Application name for User-Agent"
  },
  "app_version": {
    "type": "string",
    "default": "",
    "description": "Application version for User-Agent"
  },
  "user_agent": {
    "type": "string",
    "default": "",
    "description": "Full User-Agent string override"
  },
  "javascript": {
    "type": "bool",
    "default": true,
    "description": "Enable JavaScript execution"
  },
  "java": {
    "type": "bool",
    "default": false,
    "description": "Enable Java execution (unknown by default)"
  },
  "plugins": {
    "type": "bool",
    "default": false,
    "description": "Enable plugin execution (unknown by default)"
  },
  "private_browsing": {
    "type": "bool",
    "default": false,
    "description": "Enable private browsing mode (unknown by default)"
  },
  "auto_load_images": {
    "type": "bool",
    "default": true,
    "description": "Enable automatic image loading"
  },
  "js_can_open_windows": {
    "type": "bool",
    "default": false,
    "description": "Allow scripts to open windows (unknown by default)"
  },
  "js_can_access_clipboard": {
    "type": "bool",
    "default": false,
    "description": "Allow scripts to access clipboard (unknown by default)"
  },
  "print_backgrounds": {
    "type": "bool",
    "default": false,
    "description": "Include backgrounds in PDF/PS output"
  },
  "zoom_factor": {
    "type": "number",
    "default": 0,
    "description": "Page zoom factor (0 = no zoom)"
  },
  "zoom_text_only": {
    "type": "bool",
    "default": false,
    "description": "Zoom text only"
  },
  "http_proxy": {
    "type": "string",
    "default": "",
    "description": "HTTP proxy server URL"
  }
}
