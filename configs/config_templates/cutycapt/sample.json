{
  "url": "https://example.com/",
  "output": "/var/cache/cutycapt/screenshot.png",
  "out_format": "png",
  "min_width": 1024,
  "min_height": 768,
  "max_wait": 60000,
  "delay": 1000,
  "headers": [
    {
      "name": "Accept-Language",
      "value": "en-US,en;q=0.9"
    },
    {
      "name": "User-Agent",
      "value": "CutyCapt/1.0 (Debian)"
    }
  ],
  "method": "get",
  "javascript": true,
  "auto_load_images": true,
  "print_backgrounds": true,
  "http_proxy": "http://proxy.example.com:3128"
}
