{
  "PROJECT_NAME": {
    "type": "string",
    "default": "ceilometer",
    "description": "OpenStack project name"
  },
  "SYSTEM_USER": {
    "type": "string",
    "default": "ceilometer",
    "description": "System user to run the service"
  },
  "SYSTEM_GROUP": {
    "type": "string",
    "default": "ceilometer",
    "description": "System group to run the service"
  },
  "CONFIG_FILE": {
    "type": "string",
    "default": "/etc/ceilometer/ceilometer.conf",
    "description": "Path to main configuration file"
  },
  "LOGFILE": {
    "type": "string",
    "default": "/var/log/ceilometer/ceilometer-polling.log",
    "description": "Path to log file"
  },
  "PIDFILE": {
    "type": "string",
    "default": "/var/run/ceilometer/ceilometer-polling.pid",
    "description": "Path to PID file"
  },
  "DAEMON": {
    "type": "string",
    "default": "/usr/bin/ceilometer-polling",
    "description": "Path to executable daemon"
  },
  "SCRIPTNAME": {
    "type": "string",
    "default": "/etc/init.d/ceilometer-polling",
    "description": "Path to init script"
  }
}
