# Configuration file for Progress Linux system integration
# See progress-linux(7) for details

# The official homepage URL for the Progress Linux project
# Default: https://progress-linux.org/
HOMEPAGE = "{{ (homepage | default('https://progress-linux.org/')) }}"

# The distribution codename (e.g., trixie, testing)
# This helps tools identify the specific derivative variant
# Default: trixie
CODENAME = "{{ (codename | default('trixie')) }}"

# The primary contact for the distribution maintenance
# Used for administrative purposes and bug reports
# Default: Daniel Baumann <daniel.baumann@progress-linux.org>
MAINTAINER = "{{ (maintainer | default('Daniel Baumann <daniel.baumann@progress-linux.org>')) }}"

# Boolean flag to enable extended system integration features
# Specific to the Progress Linux derivative
# Default: true
ENABLE_INTEGRATION = {{ enable_integration | default(true) | lower }}