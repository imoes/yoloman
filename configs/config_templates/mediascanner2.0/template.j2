# AppArmor profile for mediascanner-service-2.0
# This profile restricts the application's system calls and file access.
# It is designed to run in 'attach_disconnected' mode (unconfined execution
# with strict file/network rules), typical for Android/system services.

#include <tunables/global>

{{ mediascanner_binary_path | default('/usr/bin/mediascanner-service-2.0') }} (attach_disconnected) {
  # Base abstractions: Common system access patterns
  #include <abstractions/base>
  #include <abstractions/audio>
  #include <abstractions/bash>
  #include <abstractions/consoles>
  #include <abstractions/dbus-session>
  #include <abstractions/dbus-strict>
  #include <abstractions/nameservice>
  #include <abstractions/private-files-strict>
  #include <abstractions/user-tmp>

  # Prevent access to cgroup controls which are not needed for this service
  deny /dev/cpuctl/apps/tasks w,
  deny /dev/cpuctl/apps/bg_non_interactive/tasks w,

  # Allow reading process information for debugging/monitoring
  @{PROC}/interrupts r,
  @{PROC}/cmdline r,
  owner @{PROC}/[0-9]*/auxv r,
  owner @{PROC}/[0-9]*/fd/ r,
  owner @{PROC}/[0-9]*/status r,
  owner @{PROC}/[0-9]*/task/ r,
  owner @{PROC}/[0-9]*/task/[0-9]*/ r,
  owner @{PROC}/[0-9]*/cmdline r,

  # Read udev configuration
  /etc/udev/udev.conf r,
  deny /run/udev/data/** r,

  # Allow ptrace to attach to the process itself for debugging
  ptrace (read) peer=@{profile_name},

  # Android specific socket access
  # attach_disconnected path
  /{,dev/}socket/property_service rw,

  # Android logging triggers: Deny direct writes to log devices as logging
  # is handled via logd/logcat subsystems.
  # Can safely deny
  deny /dev/log_main w,
  deny /dev/log_radio w,
  deny /dev/log_events w,
  deny /dev/log_system w,

  # Allow execution of the mediascanner binary
  {{ mediascanner_binary_path | default('/usr/bin/mediascanner-service-2.0') }} r,

  # Allow read access to all directories (structure traversal)
  # Allow read on all directories
  /**/ r,

  # Allow read on click install directories, removable media and files in
  # /usr/local/share.
  /usr/share/** r,
  /usr/local/share/** r,
  /{media,mnt,opt,srv}/** r,

  # Allow reading files in non-hidden directories in the user's home
  owner @{HOME}/[^.]*    rk,
  owner @{HOME}/[^.]*/   rk,
  owner @{HOME}/[^.]*/** rk,

  # Allow reading files in XDG directories (ie, where apps are allowed to
  # write)
  owner @{HOME}/.config/user-dirs.dirs r,
  owner @{HOME}/.cache/**       rk,
  owner @{HOME}/.local/share/** rk,
  owner /{,var/}run/user/[0-9]*/** rk,

  # Write out the database files (media cache/database)
  owner @{HOME}/.cache/mediascanner-2.0/   rw,
  owner @{HOME}/.cache/mediascanner-2.0/** rwkl,

  # Allow communication with udisksd for storage device management
  dbus (send)
       bus=system
       path="/org/freedesktop/UDisks2*"
       interface="org.freedesktop.DBus.ObjectManager"
       member=GetManagedObjects,
  dbus (send)
       bus=system
       path="/org/freedesktop/UDisks2*"
       interface="org.freedesktop.DBus.Properties"
       member={Get,GetAll},
  dbus (receive)
       bus=system
       interface="org.freedesktop.DBus.ObjectManager",
  dbus (receive)
       bus=system
       interface="org.freedesktop.DBus.Properties",
  dbus (receive)
       bus=system
       interface="org.freedesktop.DBus.UDisks2*",

  # Site-specific additions and overrides. See local/README for details.
  #include <local/usr.bin.mediascanner-service-2.0>
}
