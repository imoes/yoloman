# AppArmor profile for mediascanner-service-2.0
# This template generates a hardened AppArmor profile for the Android
# mediascanner service. It restricts file access to media directories,
# cache locations, and specific system paths required for udisks and
# hardware info. No network or database capabilities are required
# for this leaf service.

#include <tunables/global>

/usr/bin/mediascanner-service-2.0 (attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/audio>
  #include <abstractions/bash>
  #include <abstractions/consoles>
  #include <abstractions/dbus-session>
  #include <abstractions/dbus-strict>
  #include <abstractions/nameservice>
  #include <abstractions/private-files-strict>
  #include <abstractions/user-tmp>

  # Deny access to CPU controller task files to prevent manipulation
  # of process priorities by the service itself.
  deny /dev/cpuctl/apps/tasks w,
  deny /dev/cpuctl/apps/bg_non_interactive/tasks w,

  # Allow reading process status and command lines for self-monitoring
  # or debugging, but only for the service's own PID range.
  @{PROC}/interrupts r,
  @{PROC}/cmdline r,
  owner @{PROC}/[0-9]*/auxv r,
  owner @{PROC}/[0-9]*/fd/ r,
  owner @{PROC}/[0-9]*/status r,
  owner @{PROC}/[0-9]*/task/ r,
  owner @{PROC}/[0-9]*/task/[0-9]*/ r,
  owner @{PROC}/[0-9]*/cmdline r,

  # Read udev configuration for device management rules
  /etc/udev/udev.conf r,

  # Deny reading udev data directly; use udisks/DBus instead
  deny /run/udev/data/** r,

  # Allow ptrace to debug or inspect peers with the same profile name
  ptrace (read) peer=@{profile_name},

  # Allow access to Android property service socket for attach_disconnected
  /{,dev/}socket/property_service rw,

  # Deny writing to Android logging devices; logs are triggered by
  # the platform, not the service itself.
  deny /dev/log_main w,
  deny /dev/log_radio w,
  deny /dev/log_events w,
  deny /dev/log_system w,

  # Allow executing the mediascanner binary itself
  /usr/bin/mediascanner-service-2.0 r,

  # Allow reading all directory entries (needed for recursive scanning)
  /**/ r,

  # Allow reading media files from standard locations:
  # - System share directories
  # - Removable media mounts (/media, /mnt, /opt, /srv)
  # - Local user share data
  /usr/share/** r,
  /usr/local/share/** r,
  /{media,mnt,opt,srv}/** r,

  # Allow reading and opening files in non-hidden user directories
  # (rk = read + open)
  owner @{HOME}/[^.]*    rk,
  owner @{HOME}/[^.]*/   rk,
  owner @{HOME}/[^.]*/** rk,

  # Allow reading XDG user directory configuration and caches
  # where applications are permitted to write/read data
  owner @{HOME}/.config/user-dirs.dirs r,
  owner @{HOME}/.cache/**       rk,
  owner @{HOME}/.local/share/** rk
  owner /{,var/}run/user/[0-9]*/** rk,

  # Allow the service to read/write its own cache database files
  # used for indexing media metadata
  owner @{HOME}/.cache/mediascanner-2.0/   rw,
  owner @{HOME}/.cache/mediascanner-2.0/** rwkl,

  # Allow D-Bus communication with udisksd for removable media detection
  # and device property queries
  dbus (send)
       bus=system
       path="/org/freedesktop/UDisks2*"
       interface="org.freedesktop.DBus.ObjectManager"
       member=GetManagedObjects,
  dbus (send)
       bus=system
       path="/org/freedesktop/UDisks2*"
       interface="org.freedesktop.DBus.Properties"
       member={Get,GetAll},
  dbus (receive)
       bus=system
       interface="org.freedesktop.DBus.ObjectManager",
  dbus (receive)
       bus=system
       interface="org.freedesktop.DBus.Properties",
  dbus (receive)
       bus=system
       interface="org.freedesktop.DBus.Properties",

  # Site-specific additions and overrides. See local/README for details.
  #include <local/usr.bin.mediascanner-service-2.0>
}