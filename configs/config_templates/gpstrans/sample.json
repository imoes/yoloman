{
  "gpsdev": "/dev/ttyUSB0",
  "datum": "WGS84",
  "format": "mxmap",
  "tzoffset": -300,
  "actions": [
    {
      "type": "w",
      "file": "/etc/gps/waypoints.wpt",
      "mode": "download"
    },
    {
      "type": "t",
      "file": "/var/log/gps/track.trk",
      "mode": "upload"
    }
  ]
}
