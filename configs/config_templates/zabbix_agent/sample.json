{
  "server": "10.0.0.10,10.0.0.11",
  "server_active": "10.0.0.10",
  "hostname": "web01.prod.example.com",
  "enable_active_checks": true,
  "refresh_active_checks": 120,
  "buffer_send": 30,
  "buffer_size": 200,
  "max_connections": 50,
  "timeout": 5,
  "include_dir": "/etc/zabbix/zabbix_agentd.d",
  "log_remote_commands": 1,
  "enable_remote_commands": false,
  "tls_enable": true,
  "psk_identity": "PSK web01",
  "psk_file": "/etc/zabbix/psk/zabbix_agentd.psk",
  "user_parameters": [
    {
      "enabled": true,
      "name": "Apache Status",
      "description": "Check Apache server-status page",
      "key": "apache.status",
      "command": "/usr/bin/curl -s http://localhost/server-status?auto"
    },
    {
      "enabled": true,
      "name": "Nginx Status",
      "description": "Check Nginx stub_status",
      "key": "nginx.status",
      "command": "/usr/bin/curl -s http://localhost/nginx_status"
    }
  ],
  "debug_level": null,
  "listen_port": 10050,
  "listen_ip": "0.0.0.0",
  "start_agents": 3
}
