# fcitx-imlist configuration file
# This template generates the configuration for fcitx input method lists.
# It defines which input methods are available and which one is selected by default.

# Input Methods List
# Ordered list of input method names to configure (e.g., 'us', 'jp', 'mozc').
# Must be valid fcitx input method names as per fcitx-imlist(1).
# Each method is added to the INPUT_METHODS variable in the resulting config.
{% for im in input_methods | default(['us']) %}INPUT_METHODS="{{ im }}"
{% endfor %}

# Default Input Method
# Name of the default input method (must be present in input_methods).
# If empty or not specified, defaults to the first item in the input_methods list.
# If the list is empty, defaults to 'us'.
{% set _input_methods = input_methods | default(['us']) %}
DEFAULT_INPUT_METHOD="{{ default_input_method | default(_input_methods[0]) }}"