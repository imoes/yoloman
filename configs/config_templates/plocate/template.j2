#! /bin/sh
#
# plocate updatedb wrapper script
# ================================
# This script is sourced/configured by the plocate package to control how
# `updatedb.plocate` runs. It automatically detects available optimization
# tools (ionice, nocache, on_ac_power) and adjusts the execution accordingly.
#
# Variables:
#   IONICE      - Command prefix to run updatedb with low I/O priority.
#   NOCACHE     - Command prefix to run updatedb avoiding page cache pollution.
#
# Configuration is driven by the following Ansible/Jinja2 variables:
#   IONICE_DEFAULT - Fallback value when ionice is unavailable.
#   IONICE_CMD     - Full ionice command when available.
#   NOCACHE_CMD    - Full nocache command when available.

set -e

UPDATEDB=/usr/sbin/updatedb.plocate

# Skip if systemd timer is available.
if [ -d /run/systemd/system ]; then
    exit 0
fi

[ -x $UPDATEDB ] || exit 0

if which on_ac_power >/dev/null 2>&1; then
    ON_BATTERY=0
    on_ac_power >/dev/null 2>&1 || ON_BATTERY=$?
    if [ "$ON_BATTERY" -eq 1 ]; then
        exit 0
    fi
fi

# See ionice(1).
# Default value for the IONICE variable if ionice is not available or fails the check.
IONICE={{ IONICE_DEFAULT | default('') }}
if [ -x /usr/bin/ionice ] &&
    /usr/bin/ionice -c3 true 2>/dev/null; then
    # The full ionice command string to use if ionice is available and supports -c3.
    IONICE="{{ IONICE_CMD | default('/usr/bin/ionice -c3') }}"
fi

# See nocache(1).
# The full nocache command string to use if nocache is available. Usually empty if not desired or not installed.
NOCACHE={{ NOCACHE_CMD | default('') }}
if [ -x /usr/bin/nocache ]; then
    NOCACHE="{{ NOCACHE_CMD | default('') }}"
fi

flock --nonblock /run/plocate.daily.lock $NOCACHE $IONICE nice $UPDATEDB