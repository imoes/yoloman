[Desktop Entry]
# The command to execute for the Budgie-Extras background service daemon.
Exec={{ exec_command | default('budgie-extras-daemon') }}

# Whether the application should be run in a terminal window.
Terminal={{ terminal | default(false) | lower }}

# Desktop entry categories, semicolon-separated.
Categories={{ categories | default('GNOME;GTK;System;Core;') }}

# Whether the application should be hidden from the menu.
NoDisplay={{ no_display | default(true) | lower }}

# Whether startup notification should be enabled.
StartupNotify={{ startup_notify | default(true) | lower }}

# Whether the daemon should auto-restart on failure.
X-GNOME-AutoRestart={{ auto_restart | default(true) | lower }}

# OnlyShowIn=Budgie
OnlyShowIn=Budgie