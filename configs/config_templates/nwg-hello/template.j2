# nwg-hello configuration instructions
#
# This template provides shell commands for setting up user-specific overrides.
# nwg-hello is a simple GUI hello widget and does not use a traditional long-running
# service configuration format. Instead, users must copy the default configuration
# files to their home directory and edit them.

# The default configuration file shipped by the package.
# Variable: nwg_hello_config_default
# Default: nwg-hello-default.json
#
# Action: Copy this default file to the user-defined config location.
# Command: cp {{ nwg_hello_config_default | default('nwg-hello-default.json') }} {{ nwg_hello_config_file | default('nwg-hello.json') }}

# The user-defined configuration file name.
# Variable: nwg_hello_config_file
# Default: nwg-hello.json

# The default CSS stylesheet shipped by the package.
# Variable: nwg_hello_css_default
# Default: nwg-hello-default.css
#
# Action: Copy this default CSS file to the user-defined CSS location.
# Command: cp {{ nwg_hello_css_default | default('nwg-hello-default.css') }} {{ nwg_hello_css_file | default('nwg-hello.css') }}

# The user-defined CSS stylesheet file name.
# Variable: nwg_hello_css_file
# Default: nwg-hello.css

# Instructions for the user:
# Do not edit *-default.* files. To define own settings and the style sheet, copy files to:
#
# # cp {{ nwg_hello_config_default | default('nwg-hello-default.json') }} {{ nwg_hello_config_file | default('nwg-hello.json') }}
# # cp {{ nwg_hello_css_default | default('nwg-hello-default.css') }} {{ nwg_hello_css_file | default('nwg-hello.css') }}
#
# and edit copies.
