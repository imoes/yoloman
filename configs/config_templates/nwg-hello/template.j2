{#
  nwg-hello configuration file
  ============================
  This file defines the behavior and appearance of nwg-hello, a simple application launcher
  for wlroots-based Wayland compositors (such as Sway).

  nwg-hello is a standalone utility; it does not connect to any external services.
  It relies solely on local configuration values defined in this schema.
#}

{#
  The filename of the user-defined configuration file.
  By default, nwg-hello looks for this file in the current directory or ~/.config/nwg-hello/.
#}
"config_file": "{{ nwg_hello_config_file | default('nwg-hello.json') }}"

{#
  The filename of the user-defined CSS stylesheet.
  This file controls the visual appearance (layout, colors, fonts) of the launcher.
#}
"css_file": "{{ nwg_hello_css_file | default('nwg-hello.css') }}"