{
  "libvirt_unix_sock_group": "libvirt",
  "libvirt_unix_sock_ro_perms": "0777",
  "libvirt_unix_sock_rw_perms": "0770",
  "libvirt_unix_sock_admin_perms": "0700",
  "libvirt_unix_sock_dir": "/run/libvirt",
  "libvirt_auth_unix_ro": "polkit",
  "libvirt_auth_unix_rw": "polkit",
  "libvirt_access_drivers": "polkit",
  "libvirt_sasl_allowed_username_list": "joe@EXAMPLE.COM",
  "libvirt_max_clients": 5000,
  "libvirt_max_queued_clients": 1000,
  "libvirt_max_anonymous_clients": 20,
  "libvirt_min_workers": 5,
  "libvirt_max_workers": 20,
  "libvirt_prio_workers": 5,
  "libvirt_max_client_requests": 5,
  "libvirt_admin_min_workers": 1,
  "libvirt_admin_max_workers": 5,
  "libvirt_admin_max_clients": 5,
  "libvirt_admin_max_queued_clients": 5,
  "libvirt_admin_max_client_requests": 5,
  "libvirt_log_level": 3,
  "libvirt_log_filters": "1:qemu 1:libvirt 4:object 4:json 4:event 1:util",
  "libvirt_log_outputs": "3:syslog:virtnodedevd",
  "libvirt_audit_level": 2,
  "libvirt_audit_logging": 1,
  "libvirt_host_uuid": "00000000-0000-0000-0000-000000000000",
  "libvirt_host_uuid_source": "smbios",
  "libvirt_keepalive_interval": 5,
  "libvirt_keepalive_count": 5,
  "libvirt_keepalive_required": 1,
  "libvirt_admin_keepalive_required": 1,
  "libvirt_admin_keepalive_interval": 5,
  "libvirt_admin_keepalive_count": 5,
  "libvirt_ovs_timeout": 5
}
