{
  "libvirt_unix_sock_group": {
    "type": "string",
    "default": null,
    "description": "UNIX domain socket group ownership for management access."
  },
  "libvirt_unix_sock_ro_perms": {
    "type": "string",
    "default": null,
    "description": "Permissions for the read-only UNIX socket."
  },
  "libvirt_unix_sock_rw_perms": {
    "type": "string",
    "default": null,
    "description": "Permissions for the read-write UNIX socket."
  },
  "libvirt_unix_sock_admin_perms": {
    "type": "string",
    "default": null,
    "description": "Permissions for the admin interface UNIX socket."
  },
  "libvirt_unix_sock_dir": {
    "type": "string",
    "default": null,
    "description": "Directory where UNIX sockets are created."
  },
  "libvirt_auth_unix_ro": {
    "type": "string",
    "default": null,
    "description": "Authentication scheme for UNIX read-only sockets.",
    "enum": [
      "none",
      "sasl",
      "polkit"
    ]
  },
  "libvirt_auth_unix_rw": {
    "type": "string",
    "default": null,
    "description": "Authentication scheme for UNIX read-write sockets.",
    "enum": [
      "none",
      "sasl",
      "polkit"
    ]
  },
  "libvirt_access_drivers": {
    "type": "string",
    "default": null,
    "description": "Access control driver for API access.",
    "enum": [
      "nop",
      "polkit"
    ]
  },
  "libvirt_sasl_allowed_username_list": {
    "type": "string",
    "default": null,
    "description": "First entry of the allowed SASL username list."
  },
  "libvirt_max_clients": {
    "type": "string",
    "default": null,
    "description": "Maximum concurrent client connections."
  },
  "libvirt_max_queued_clients": {
    "type": "string",
    "default": null,
    "description": "Maximum length of connection queue."
  },
  "libvirt_max_anonymous_clients": {
    "type": "string",
    "default": null,
    "description": "Maximum length of unauthenticated client queue."
  },
  "libvirt_min_workers": {
    "type": "string",
    "default": null,
    "description": "Initial number of worker threads."
  },
  "libvirt_max_workers": {
    "type": "string",
    "default": null,
    "description": "Maximum number of worker threads."
  },
  "libvirt_prio_workers": {
    "type": "string",
    "default": null,
    "description": "Number of priority worker threads."
  },
  "libvirt_max_client_requests": {
    "type": "string",
    "default": null,
    "description": "Limit on concurrent requests per client."
  },
  "libvirt_admin_min_workers": {
    "type": "string",
    "default": null,
    "description": "Minimum admin interface worker threads."
  },
  "libvirt_admin_max_workers": {
    "type": "string",
    "default": null,
    "description": "Maximum admin interface worker threads."
  },
  "libvirt_admin_max_clients": {
    "type": "string",
    "default": null,
    "description": "Maximum admin interface client connections."
  },
  "libvirt_admin_max_queued_clients": {
    "type": "string",
    "default": null,
    "description": "Maximum admin interface connection queue."
  },
  "libvirt_admin_max_client_requests": {
    "type": "string",
    "default": null,
    "description": "Limit on concurrent requests per admin client."
  },
  "libvirt_log_level": {
    "type": "string",
    "default": null,
    "description": "Global logging level (4 errors, 3 warnings, 2 info, 1 debug)."
  },
  "libvirt_log_filters": {
    "type": "string",
    "default": null,
    "description": "Logging filters string.",
    "enum": [
      "1:qemu",
      "1:libvirt",
      "4:object",
      "4:json",
      "4:event",
      "1:util"
    ]
  },
  "libvirt_log_outputs": {
    "type": "string",
    "default": null,
    "description": "Logging outputs string.",
    "enum": [
      "stderr",
      "syslog",
      "file",
      "journald"
    ]
  },
  "libvirt_audit_level": {
    "type": "string",
    "default": "",
    "description": "Auditing level (0 disable, 1 enable if host supports, 2 enable or exit)."
  },
  "libvirt_audit_logging": {
    "type": "string",
    "default": null,
    "description": "Enable audit messages in libvirt logging infrastructure."
  },
  "libvirt_host_uuid": {
    "type": "string",
    "default": null,
    "description": "Host UUID."
  },
  "libvirt_host_uuid_source": {
    "type": "string",
    "default": null,
    "description": "Source for fetching host UUID.",
    "enum": [
      "smbios",
      "machine-id"
    ]
  },
  "libvirt_keepalive_interval": {
    "type": "string",
    "default": null,
    "description": "Keepalive interval in seconds."
  },
  "libvirt_keepalive_count": {
    "type": "string",
    "default": null,
    "description": "Keepalive count before disconnect."
  },
  "libvirt_keepalive_required": {
    "type": "string",
    "default": null,
    "description": "Legacy keepalive required setting."
  },
  "libvirt_admin_keepalive_required": {
    "type": "string",
    "default": null,
    "description": "Legacy admin keepalive required setting."
  },
  "libvirt_admin_keepalive_interval": {
    "type": "string",
    "default": null,
    "description": "Admin interface keepalive interval."
  },
  "libvirt_admin_keepalive_count": {
    "type": "string",
    "default": null,
    "description": "Admin interface keepalive count."
  },
  "libvirt_ovs_timeout": {
    "type": "string",
    "default": null,
    "description": "Timeout for Open vSwitch calls."
  }
}
