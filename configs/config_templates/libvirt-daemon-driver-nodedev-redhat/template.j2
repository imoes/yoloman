{% if libvirt_audit_logging is defined and libvirt_audit_logging is not none and (libvirt_audit_logging is number or libvirt_audit_logging is boolean or libvirt_audit_logging | length > 0) %}audit_logging = {{ libvirt_audit_logging | default('') }}{% else %}#audit_logging = 1{% endif %}


