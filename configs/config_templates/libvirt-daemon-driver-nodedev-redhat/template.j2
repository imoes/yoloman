{% if libvirt_keepalive_count is defined and libvirt_keepalive_count is not none and (libvirt_keepalive_count is number or libvirt_keepalive_count is boolean or libvirt_keepalive_count | length > 0) %}keepalive_count = {{ libvirt_keepalive_count | default('') }}{% else %}#keepalive_count = 5{% endif %}

