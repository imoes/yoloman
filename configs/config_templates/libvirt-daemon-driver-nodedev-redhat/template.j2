{% if libvirt_host_uuid is defined and libvirt_host_uuid is not none and (libvirt_host_uuid is number or libvirt_host_uuid is boolean or libvirt_host_uuid | length > 0) %}host_uuid = "{{ libvirt_host_uuid | default('') }}"{% else %}#host_uuid = "00000000-0000-0000-0000-000000000000"{% endif %}
