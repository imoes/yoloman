{
  "logger_severity": "INFO",
  "logger_debuglevel": 0,
  "control_socket_path": "/run/kea/dhcp6-ctrl.sock",
  "server_id_type": "LLT",
  "server_id_enterprise_id": 0,
  "server_id_hardware_type": 1,
  "server_id_identifier": "auto",
  "reconfigure_wait_seconds": 30,
  "interfaces": [
    "eth0"
  ],
  "interfaces_re_detect": true,
  "lease_database_type": "memfile",
  "lease_database_memfile_name": "/var/lib/kea/kea-dhcp6.leases",
  "lease_database_memfile_persist": true,
  "lease_database_memfile_lfc_interval": 3600,
  "lease_database_host": "localhost",
  "lease_database_name": "kea_dhcp6",
  "lease_database_password": "",
  "lease_database_port": 5432,
  "lease_database_user": "kea_user",
  "subnets": [
    {
      "id": 1,
      "subnet": "2001:db8:1::/64",
      "pools": [
        {
          "pool": "2001:db8:1::100 - 2001:db8:1::fff"
        }
      ],
      "option_data": [
        {
          "name": "dns-servers",
          "data": "2001:db8::1,2001:db8::2"
        },
        {
          "name": "domain-search",
          "data": "example.com"
        }
      ],
      "reservation_mode": "out-of-pool",
      "preferred_lifetime": 1800,
      "valid_lifetime": 3600,
      "declined_leases_detection": true
    }
  ],
  "dhcp_ddns_enable_updates": false,
  "dhcp_ddns_qualifying_suffix": "example.com",
  "dhcp_ddns_server_ip": "127.0.0.1",
  "dhcp_ddns_server_port": 53,
  "dhcp_ddns_dns_regions": [],
  "hooks_libraries": [
    {
      "library": "/usr/lib/kea/hooks/libdhcp_lease_cmds.so",
      "parameters": "{}"
    }
  ],
  "user_context_comment": "Sample production config for internal LAN"
}
