{
  "webserver_enabled": true,
  "webserver_cert_hostname": "puppet.internal.example.com",
  "puppet_server_hostname": "puppet-01.internal.example.com",
  "ca_enabled": true,
  "ca_name": "Puppet CA: prod-datacenter-1",
  "ca_max_serial_numbers": 2000000,
  "api_v1_services_enabled": false,
  "auth_rules": [
    {
      "name": "puppetdb admin access",
      "match_request": {
        "path": "/puppetdb/",
        "method": "GET, POST, PUT, DELETE"
      },
      "permissions": [
        "read",
        "write"
      ],
      "sort_order": 100
    },
    {
      "name": "metrics read-only",
      "match_request": {
        "path": "/metrics/",
        "method": "GET"
      },
      "permissions": [
        "read"
      ]
    }
  ],
  "jvm_heap_init": "3g",
  "jvm_heap_max": "6g",
  "jvm_metaspace_max": "1g",
  "jvm_java_home": "/usr/lib/jvm/java-17-openjdk",
  "log_level": "warn"
}
