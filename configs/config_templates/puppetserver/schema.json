{
  "gem_home": {
    "type": "string",
    "default": "/var/lib/puppetserver/jruby-gems",
    "description": "Where JRuby will install gems"
  },
  "server_conf_dir": {
    "type": "string",
    "default": "/etc/puppet",
    "description": "Path to puppet conf dir"
  },
  "server_code_dir": {
    "type": "string",
    "default": "/etc/puppet/code",
    "description": "Path to puppet code dir"
  },
  "server_var_dir": {
    "type": "string",
    "default": "/var/lib/puppetserver",
    "description": "Path to puppet var dir"
  },
  "server_run_dir": {
    "type": "string",
    "default": "/run/puppetserver",
    "description": "Path to puppet run dir"
  },
  "server_log_dir": {
    "type": "string",
    "default": "/var/log/puppetserver",
    "description": "Path to puppet log dir"
  },
  "reportdir": {
    "type": "string",
    "default": "/var/lib/puppet/reports",
    "description": "Path to the Puppet report directory to be cleaned up by the cron job"
  }
}
