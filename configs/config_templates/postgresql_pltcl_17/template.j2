# Load PL/Tcl procedural language
# Enables PL/Tcl functions within PostgreSQL
shared_preload_libraries = '{{ shared_preload_libraries | default('') | join(", ") | default('') }}'
#PL/Tcl-specific settings

# Enable PL/Tcl procedural language (must be set before shared_preload_libraries takes effect)
# Adds 'pltcl' to the list of available procedural languages
# (Note: This is handled automatically on first CREATE LANGUAGE pltcl, but explicitly setting it improves clarity)
pltcl.conf = '{{ pltcl_conf_path | default("/etc/postgresql/17/main/pltcl.conf") }}'
