# Capstats Configuration Template
# Auto-generated by Ansible Role
# This template renders command-line options for the `capstats` tool.
# Each variable uses | default() to ensure safe rendering even if the role variable is undefined.

# --- Network Interface ---
# Network interface to monitor (required); e.g., eth0
# The -i flag specifies the interface capstats will sniff.
-i {{ (interface | default('')) | string }}

# --- DAG Support ---
# Use native DAG API if capstats was built with DAG support
# The -d flag enables Digital Attack Grid (DAG) card support.
{% if dag | default(False) %}
-d
{% endif %}

# --- BPF Filter ---
# Berkeley Packet Filter (BPF) expression to filter captured traffic
# The -f flag allows filtering packets before processing.
{% set bpf = (bpf_filter | default('')) | string %}
{% if bpf %}
-f {{ bpf }}
{% endif %}

# --- Logging Interval ---
# Stats logging interval in seconds
# The -I flag sets how often statistics are printed.
-I {{ interval | default(1) | int }}

# --- Syslog Logging ---
# Log to syslog instead of printing to stderr
# The -l flag redirects output to the system logger.
{% if use_syslog | default(False) %}
-l
{% endif %}

# --- Stop Condition (Count) ---
# Stop after outputting this many intervals
# The -n flag limits the number of stat updates to generate.
{% if stop_after is defined and stop_after is not none %}
-n {{ stop_after | int }}
{% endif %}

# --- Payload Verification ---
# Verify that packet payloads consist entirely of this byte value (0–255)
# The -p flag checks packet content against a single byte value.
{% if payload_byte is defined and payload_byte is not none %}
-p {{ payload_byte | int }}
{% endif %}

# --- Quiet Threshold ---
# Suppress output; exit with success (0) if at least this many packets received
# The -q flag sets a minimum packet count to consider the run successful.
{% if quiet_threshold is defined and quiet_threshold is not none %}
-q {{ quiet_threshold | int }}
{% endif %}

# --- Expected Packet Size ---
# Verify that packets match this exact size in bytes
# The -S flag expects packets of a specific length.
{% if expected_size is defined and expected_size is not none %}
-S {{ expected_size | int }}
{% endif %}

# --- Snapshot Length ---
# Set pcap snapshot length (bytes); default depends on libpcap
# The -s flag controls how much of each packet is captured.
{% if snaplen is defined and snaplen is not none %}
-s {{ snaplen | int }}
{% endif %}

# --- Output File ---
# Write captured packets to this file in pcap format
# The -w flag specifies a pcap file for raw packet storage.
{% set wf = (write_file | default('')) | string %}
{% if wf %}
-w {{ wf }}
{% endif %}