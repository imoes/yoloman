# ==============================================================================
# Razor Configuration Template
# ==============================================================================
# Razor is a distributed spam detection system.
# This configuration file controls the behavior of the Razor client.
#
# Self-documentation: Every directive below includes its source description.
# Variables default to schema defaults if not provided by the Ansible role.
# ==============================================================================

# ------------------------------------------------------------------------------
# Logging and Debugging
# ------------------------------------------------------------------------------

# LogDebugLevel: Razor debug/log level. 0=errors only, 3=verbose debug.
# Determines the verbosity of Razor's log output.
# Accepted values: 0 (errors only), 1 (warnings), 2 (info), 3 (debug/verbose).
LogDebugLevel={{ LogDebugLevel | default(2) }}
