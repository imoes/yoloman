{
 "checkpoints": {
  "checkpoint_interval": 600,
  "checkpoint_size": 1073741824
 },
 "config_version": "",
 "consistency.frequency": {
  "archives": "weekly",
  "repository": "monthly"
 },
 "hooks": {
  "after_backup": [
   "systemctl restart borgmatic-reporter.service"
  ],
  "before_backup": [
   "sudo -u postgres pg_dumpall | borg create --stdin-name=pg_dumpall {{ repositories[0].path }}::{{ 'pgdump-' + now('%Y%m%d-%H%M%S') }}"
  ]
 },
 "log_json": true,
 "log_level": "info",
 "omit": "",
 "one_file_system": true,
 "progress": true,
 "repositories": [
  {
   "encryption_mode": "repokey",
   "path": "/backup/borg"
  },
  {
   "encryption_mode": "authenticated",
   "path": "backup@example.com:/remote/borg"
  }
 ],
 "retention": {
  "keep_daily": 7,
  "keep_hourly": 24,
  "keep_monthly": 6,
  "keep_weekly": 4,
  "keep_within": "30d",
  "keep_yearly": 1
 },
 "source_directories": [
  "/home",
  "/etc",
  "/var/www",
  "/var/lib/postgresql"
 ],
 "stats": true,
 "storage": {
  "compression": "zstd"
 }
}
