{
  "recursive": true,
  "backup_dir": "/var/backups/maildir_deleted",
  "backup_tree": true,
  "bzip2_path": "/usr/bin/bzip2",
  "gzip_path": "",
  "maildirsync_bin": "/usr/bin/maildirsync.pl",
  "rsh_path": "ssh",
  "destination_os": "lin",
  "verbose_level": 2,
  "algorithm": "md5",
  "delete_before": false,
  "exclude_patterns": [
    "^/Trash",
    "^/Spam"
  ],
  "exclude_source_patterns": [],
  "exclude_target_patterns": [],
  "rename_expr": "",
  "source_path": "desktop:Maildir",
  "destination_path": "/home/user/Maildir",
  "state_file_path": "/var/lib/maildirsync/sync_desk.bz2"
}
