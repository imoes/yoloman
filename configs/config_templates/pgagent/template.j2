# PostgreSQL Job Scheduler (pgagent) configuration file
# Connection string to the PostgreSQL database
PGDATABASE="{{ db_name }}"
PGHOST="{{ db_host }}"
PGPORT="{{ db_port }}"
PGUSER="{{ db_user }}"
{% if db_password %}# Password for the database user (if required)
PGPASSWORD="{{ db_password }}"{% endif %}
{% if db_sslmode %}# SSL mode for database connection (e.g., prefer, require, verify-full)
PGSSLMODE="{{ db_sslmode }}"{% endif %}
# Log level (0=quiet, 1=error, 2=warning, 3=info, 4=debug)
LOGLEVEL="{{ log_level }}"
# Path to the log file (empty or '-' for stdout)
{% if log_file %}LOGFILE="{{ log_file }}"{% else %}LOGFILE="-"{% endif %}
# PID file path
PIDFILE="{{ pid_file }}"
# Number of job worker threads
{% if worker_threads %}JOBTHREADS="{{ worker_threads }}"{% endif %}
# Hostname to use for this agent (defaults to system hostname)
{% if hostname %}HOSTNAME="{{ hostname }}"{% endif %}
# Additional connection options (e.g., connect_timeout=5)
{% if extra_conn_opts %}PGOPTIONS="{{ extra_conn_opts }}"{% endif %}
# Disable background daemonization (set to 'false' to run in foreground)
DAEMON="{{ daemonize | lower }}"
# Poll interval (seconds) for job checking (default 10)
{% if poll_interval %}POLLCYCLE="{{ poll_interval }}"{% endif %}
# Timeout (seconds) for idle connection cleanup
{% if conn_timeout %}IDLE_TIMEOUT="{{ conn_timeout }}"{% endif %}
# Retry period (seconds) after connection abort (>=10, default 30)
{% if retry_period %}RETRY_PERIOD="{{ retry_period }}"{% endif %}
