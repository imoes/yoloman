{
  "openvpn_auth_ldap_url": {
    "type": "string",
    "default": "ldap://ldap1.example.org",
    "description": "LDAP server URL"
  },
  "openvpn_auth_ldap_bind_dn": {
    "type": "string",
    "default": null,
    "description": "Bind DN for LDAP authentication"
  },
  "openvpn_auth_ldap_password": {
    "type": "string",
    "default": null,
    "description": "Bind Password for LDAP authentication"
  },
  "openvpn_auth_ldap_timeout": {
    "type": "number",
    "default": 15,
    "description": "Network timeout in seconds"
  },
  "openvpn_auth_ldap_tls_enable": {
    "type": "string",
    "default": "yes",
    "description": "Enable Start TLS",
    "enum": [
      "yes",
      "no",
      "true",
      "false",
      "1",
      "0"
    ]
  },
  "openvpn_auth_ldap_follow_referrals": {
    "type": "string",
    "default": "yes",
    "description": "Follow LDAP Referrals",
    "enum": [
      "yes",
      "no",
      "true",
      "false",
      "on",
      "off",
      "1",
      "0"
    ]
  },
  "openvpn_auth_ldap_tls_ca_cert_file": {
    "type": "string",
    "default": "/usr/local/etc/ssl/ca.pem",
    "description": "TLS CA Certificate File"
  },
  "openvpn_auth_ldap_tls_ca_cert_dir": {
    "type": "string",
    "default": "/etc/ssl/certs",
    "description": "TLS CA Certificate Directory"
  },
  "openvpn_auth_ldap_tls_cert_file": {
    "type": "string",
    "default": "/usr/local/etc/ssl/client-cert.pem",
    "description": "Client TLS Certificate File"
  },
  "openvpn_auth_ldap_tls_key_file": {
    "type": "string",
    "default": "/usr/local/etc/ssl/client-key.pem",
    "description": "Client TLS Key File"
  },
  "openvpn_auth_ldap_authorization_base_dn": {
    "type": "string",
    "default": "\"ou=People,dc=example,dc=com\"",
    "description": "Base DN for user authorization"
  },
  "openvpn_auth_ldap_authorization_search_filter": {
    "type": "string",
    "default": "\"(&(uid=%u)(accountStatus=active))\"",
    "description": "User Search Filter"
  },
  "openvpn_auth_ldap_authorization_require_group": {
    "type": "string",
    "default": "false",
    "description": "Require Group Membership",
    "enum": [
      "yes",
      "no",
      "true",
      "false",
      "1",
      "0"
    ]
  },
  "openvpn_auth_ldap_authorization_password_is_cr": {
    "type": "string",
    "default": "false",
    "description": "Support OpenVPN Challenge/Response",
    "enum": [
      "yes",
      "no",
      "true",
      "false",
      "1",
      "0"
    ]
  },
  "openvpn_auth_ldap_authorization_group_base_dn": {
    "type": "string",
    "default": "\"ou=Groups,dc=example,dc=com\"",
    "description": "Base DN for group authorization"
  },
  "openvpn_auth_ldap_authorization_group_search_filter": {
    "type": "string",
    "default": "\"(|(cn=developers)(cn=artists))\"",
    "description": "Group Search Filter"
  },
  "openvpn_auth_ldap_authorization_group_member_attribute": {
    "type": "string",
    "default": "uniqueMember",
    "description": "Member Attribute for group membership"
  }
}
