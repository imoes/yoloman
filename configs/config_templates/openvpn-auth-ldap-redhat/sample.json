{
  "openvpn_auth_ldap_url": "ldap://ldap1.example.org",
  "openvpn_auth_ldap_bind_dn": "uid=Manager,ou=People,dc=example,dc=com",
  "openvpn_auth_ldap_password": "SecretPassword",
  "openvpn_auth_ldap_timeout": 15,
  "openvpn_auth_ldap_tls_enable": "yes",
  "openvpn_auth_ldap_follow_referrals": "yes",
  "openvpn_auth_ldap_tls_ca_cert_file": "/usr/local/etc/ssl/ca.pem",
  "openvpn_auth_ldap_tls_ca_cert_dir": "/etc/ssl/certs",
  "openvpn_auth_ldap_tls_cert_file": "/usr/local/etc/ssl/client-cert.pem",
  "openvpn_auth_ldap_tls_key_file": "/usr/local/etc/ssl/client-key.pem",
  "openvpn_auth_ldap_authorization_base_dn": "ou=People,dc=example,dc=com",
  "openvpn_auth_ldap_authorization_search_filter": "(&(uid=%u)(accountStatus=active))",
  "openvpn_auth_ldap_authorization_require_group": "false",
  "openvpn_auth_ldap_authorization_password_is_cr": "false",
  "openvpn_auth_ldap_authorization_group_base_dn": "ou=Groups,dc=example,dc=com",
  "openvpn_auth_ldap_authorization_group_search_filter": "(|(cn=developers)(cn=artists))",
  "openvpn_auth_ldap_authorization_group_member_attribute": "uniqueMember"
}
