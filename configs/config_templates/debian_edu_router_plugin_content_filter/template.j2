# ==============================================================================
# Debian Edu Router Plugin: Content Filtering Configuration
# ==============================================================================
#
# This template configures the content filtering layer for the Debian Edu Router.
# It manages policy enforcement via backend proxies (Squid/SquidGuard),
# defining allowed/blocked content categories, SSL inspection, bandwidth limits,
# and logging behavior.
#
# ==============================================================================

# --------------------------------------------------------------------------
# Global Switch: Enable or Disable the Content Filtering Plugin
# --------------------------------------------------------------------------
# When set to false, all filtering rules are ignored, and traffic passes freely.
# Use this for emergency bypasses or testing non-filtered configurations.
ENABLED={{ enabled | default(True) | lower }}

# --------------------------------------------------------------------------
# Backend Selection: Choose the Filtering Engine
# --------------------------------------------------------------------------
# 'squid': Uses basic URL filtering capabilities directly via Squid ACLs.
# 'squidguard': Uses SquidGuard for advanced, category-based filtering with
#                database-backed rules (recommended for granular control).
BACKEND={{ backend | default('squidguard') }}

# --------------------------------------------------------------------------
# Squid Proxy Backend Configuration
# --------------------------------------------------------------------------
# Only relevant if backend is 'squid' or if the system relies on a Squid
# instance for HTTP interception.

# Listening port for the Squid proxy service.
SQUID_PORT={{ (squid | default({})).port | default(3128) }}

# Path to the main Squid configuration file.
SQUID_CONF={{ (squid | default({})).conf_path | default('/etc/squid/squid.conf') }}

# --------------------------------------------------------------------------
# SquidGuard Backend Configuration
# --------------------------------------------------------------------------
# Detailed settings for the SquidGuard filtering engine.
# These paths are critical for the engine to find its rule databases and config.

# Path to the directory containing the SquidGuard category databases.
SQUIDGUARD_DB={{ (squidguard | default({})).db_path | default('/var/lib/squidguard/db') }}

# Path to the SquidGuard main configuration file.
SQUIDGUARD_CONF={{ (squidguard | default({})).conf_path | default('/etc/squidguard/squidGuard.conf') }}

# Timeout (in seconds) for checking/updating URLs during filtering checks.
URL_TIMEOUT={{ (squidguard | default({})).url_timeout | default(5) }}

# Refresh interval (in seconds) for the SquidGuard category databases.
DB_REFRESH={{ (squidguard | default({})).db_refresh | default(3600) }}

# --------------------------------------------------------------------------
# Filtering Policy: Categories to Block
# --------------------------------------------------------------------------
# A comma-separated list of categories defined in the SquidGuard DB.
# Traffic matching these categories will be blocked.
# Common categories: 'adult', 'malware', 'phishing', 'social', 'violence'.
FILTER_CATEGORIES={{ categories | default(['adult', 'malware', 'phishing', 'social']) | join(', ') }}

# --------------------------------------------------------------------------
# HTTPS Traffic Inspection (SSL/MITM)
# --------------------------------------------------------------------------
# Enable HTTPS inspection to filter encrypted traffic.
# WARNING: This requires installing a custom CA certificate on all client
# devices. It may break sites with certificate pinning and raises privacy
# considerations.
SSL_INSPECTION={{ ssl_inspection | default(False) | lower }}

# --------------------------------------------------------------------------
# Allowlist: Domains Explicitly Permitted
# --------------------------------------------------------------------------
# These domains are exempt from filtering, regardless of their category.
# Typically used for educational resources or internal tools.
{% for domain in (allowlist | default({'domains': ['edu.jisc.ac.uk', 'nationaleducation.fr'] })).domains %}ALLOW_DOMAIN={{ domain }}
{% endfor %}

# --------------------------------------------------------------------------
# Blocklist: Domains Explicitly Denied
# --------------------------------------------------------------------------
# These domains are always blocked, overriding allowlists or category rules.
# Use this for known malicious or non-productive sites.
{% for domain in (blocklist | default({'domains': []})).domains %}BLOCK_DOMAIN={{ domain }}
{% endfor %}

# --------------------------------------------------------------------------
# Exception Groups: Users/Groups Exempt from Filtering
# --------------------------------------------------------------------------
# Unix groups (e.g., 'teachers', 'admins') whose members bypass filtering.
# Requires an authentication helper (e.g., PAM, LDAP) configured in the router.
{% for group in exception_groups | default([]) %}EXCEPT_GROUP={{ group }}
{% endfor %}

# --------------------------------------------------------------------------
# Logging Configuration
# --------------------------------------------------------------------------

# Log level for the content filter.
# 0: None, 1: Critical, 2: Error, 3: Warning, 4: Notice, 5: Info, 6: Debug
LOG_LEVEL={{ (log | default({'level': 2})).level | default(2) }}

# Path to the log file for content filtering events.
LOG_FILE={{ (log | default({'file_path': '/var/log/debian-edu-router/content-filter.log'})).file_path | default('/var/log/debian-edu-router/content-filter.log') }}

# --------------------------------------------------------------------------
# Bandwidth Throttling & Limits
# --------------------------------------------------------------------------
# Controls resource usage to prevent network saturation by heavy users.

# Maximum bandwidth per user (in KB/s).
# Set to 0 for no limit.
MAX_BANDWIDTH_KBPS={{ (bandwidth | default({'max_kbps': 0, 'max_connections': 8})).max_kbps | default(0) }}

# Maximum concurrent connections per client IP.
# Prevents a single user from monopolizing connections.
MAX_CONNECTIONS={{ (bandwidth | default({'max_kbps': 0, 'max_connections': 8})).max_connections | default(8) }}

# --------------------------------------------------------------------------
# Upstream Proxy Chaining
# --------------------------------------------------------------------------
# Optional: Route filtered traffic through another upstream proxy (e.g., for
# additional caching or geo-restriction handling).

{% if (upstream_proxy | default({'enabled': False})).enabled | default(False) %}
# Upstream proxy is enabled and configured.
UPSTREAM_PROXY={{ (upstream_proxy | default({'host': 'cache.example.org', 'port': 3128})).host }}:{{ (upstream_proxy | default({'host': 'cache.example.org', 'port': 3128})).port }}
{% else %}
# Upstream proxy is disabled; direct internet access (filtered by local backend).
UPSTREAM_PROXY=none
{% endif %}