{
  "enabled": true,
  "backend": "squidguard",
  "squid": {
    "port": 3128,
    "conf_path": "/etc/squid/squid.conf"
  },
  "squidguard": {
    "db_path": "/var/lib/squidguard/db",
    "conf_path": "/etc/squidguard/squidGuard.conf",
    "url_timeout": 3,
    "db_refresh": 7200
  },
  "categories": [
    "adult",
    "malware",
    "phishing",
    "gambling",
    "social"
  ],
  "ssl_inspection": false,
  "allowlist": {
    "domains": [
      "edu.jisc.ac.uk",
      "nationaleducation.fr",
      "gov.uk"
    ]
  },
  "blocklist": {
    "domains": [
      "badads.example.com",
      "tracker.malware.net"
    ]
  },
  "exception_groups": [
    "teachers",
    "school-admin"
  ],
  "log": {
    "level": 3,
    "file_path": "/var/log/debian-edu-router/content-filter.log"
  },
  "bandwidth": {
    "max_kbps": 0,
    "max_connections": 12
  },
  "upstream_proxy": {
    "enabled": true,
    "host": "cache.academy.local",
    "port": 3128
  }
}
