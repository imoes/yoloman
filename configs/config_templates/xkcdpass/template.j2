# xkcdpass configuration file
# Self-documented template for xkcdpass

# Number of words to generate (Default: 6). Corresponds to --numwords.
num_words: {{ num_words | default(6) }}

# Minimum word count (Default: 5). Corresponds to --min.
min_length: {{ min_length | default(5) }}

# Maximum word count (Default: 9). Corresponds to --max.
max_length: {{ max_length | default(9) }}

# Number of passphrases to output (Default: 1). Corresponds to --count.
count: {{ count | default(1) }}

# Separator between words in a single passphrase (Default: ' '). Corresponds to --delimiter.
delimiter: "{{ delimiter | default(' ') }}"

# Separator between multiple passphrases (Default: newline). Corresponds to --separator.
separator: "{{ separator | default('\\n') }}"

# Case style: alternating, upper, lower, first, random. Corresponds to --case.
case: "{{ case | default('lower') }}"

# Path to the wordlist file. Corresponds to --wordfile.
wordfile: "{{ wordfile | default('/usr/share/xkcdpass/dict/eff_large.txt') }}"

# Regex pattern to filter words. Empty string means no filtering. Corresponds to --valid-chars.
valid_chars: "{{ valid_chars | default('') }}"

# Acrostic string to match. Empty string disables acrostic mode. Corresponds to --acrostic.
acrostic: "{{ acrostic | default('') }}"