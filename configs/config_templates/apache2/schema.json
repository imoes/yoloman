{
  "server_root": {
    "type": "string",
    "default": {
      "type": "string",
      "value": "/etc/apache2"
    },
    "description": "Apache server root directory"
  },
  "timeout": {
    "type": "number",
    "default": {
      "type": "number",
      "value": 300
    },
    "description": "Timeout value in seconds"
  },
  "keepalive": {
    "type": "string",
    "default": {
      "type": "string",
      "value": "On"
    },
    "description": "Whether KeepAlive is enabled (On/Off)"
  },
  "max_keepalive_requests": {
    "type": "number",
    "default": {
      "type": "number",
      "value": 100
    },
    "description": "Maximum requests per KeepAlive connection"
  },
  "keepalive_timeout": {
    "type": "number",
    "default": {
      "type": "number",
      "value": 5
    },
    "description": "KeepAlive timeout in seconds"
  },
  "user": {
    "type": "string",
    "default": {
      "type": "string",
      "value": "www-data"
    },
    "description": "User account Apache runs as"
  },
  "group": {
    "type": "string",
    "default": {
      "type": "string",
      "value": "www-data"
    },
    "description": "Group Apache runs as"
  },
  "log_level": {
    "type": "string",
    "default": {
      "type": "string",
      "value": "warn"
    },
    "description": "Apache log level"
  },
  "listen_port": {
    "type": "number",
    "default": {
      "type": "number",
      "value": 80
    },
    "description": "Port to listen on (for global Listen directive)"
  },
  "virtual_hosts": {
    "type": "list",
    "default": {
      "type": "list",
      "value": []
    },
    "description": "List of VirtualHost configurations"
  }
}
