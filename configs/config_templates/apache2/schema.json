{
  "server_root": {
    "type": "string",
    "default": null,
    "description": "Apache server root directory"
  },
  "timeout": {
    "type": "number",
    "default": 300,
    "description": "Timeout value in seconds"
  },
  "keepalive": {
    "type": "string",
    "default": "On",
    "description": "Whether KeepAlive is enabled (On/Off)",
    "enum": [
      "On",
      "Off"
    ]
  },
  "max_keepalive_requests": {
    "type": "number",
    "default": 100,
    "description": "Maximum requests per KeepAlive connection"
  },
  "keepalive_timeout": {
    "type": "number",
    "default": 5,
    "description": "KeepAlive timeout in seconds"
  },
  "user": {
    "type": "string",
    "default": "www-data",
    "description": "User account Apache runs as"
  },
  "group": {
    "type": "string",
    "default": "www-data",
    "description": "Group Apache runs as"
  },
  "log_level": {
    "type": "string",
    "default": "warn",
    "description": "Apache log level",
    "enum": [
      "trace8",
      "trace1",
      "debug",
      "info",
      "notice",
      "warn",
      "error",
      "crit",
      "alert",
      "emerg"
    ]
  },
  "listen_port": {
    "type": "number",
    "default": 80,
    "description": "Port to listen on (for global Listen directive)"
  },
  "virtual_hosts": {
    "type": "list",
    "default": [],
    "description": "List of VirtualHost configurations"
  },
  "error_log": {
    "type": "string",
    "default": "${APACHE_LOG_DIR}/error.log",
    "description": "Server-wide error log (ErrorLog). The Debian default resolves ${APACHE_LOG_DIR} from /etc/apache2/envvars."
  }
}
