{
  "server_root": "/etc/apache2",
  "timeout": 300,
  "keepalive": "On",
  "max_keepalive_requests": 100,
  "keepalive_timeout": 5,
  "user": "www-data",
  "group": "www-data",
  "log_level": "warn",
  "listen_port": 80,
  "virtual_hosts": [
    {
      "port": 80,
      "server_name": "www.example.com",
      "document_root": "/var/www/html",
      "error_log": "${APACHE_LOG_DIR}/error.log",
      "custom_log": "${APACHE_LOG_DIR}/access.log",
      "log_format": "combined"
    }
  ]
}