# pcs snmp agent configuration file
# Self-documenting Jinja2 template for pcs-snmp agent settings.

# Enable logging of debugging messages for the pcs snmp agent.
# Expected type: boolean (true/false).
# Default: False.
pcs_snmp_agent_debug={{ pcs_snmp_agent_debug | default(False) | lower }}

# Data update interval in seconds for the pcs snmp agent.
# Expected type: integer > 0.
# Default: 30.
pcs_snmp_agent_update_interval={{ pcs_snmp_agent_update_interval | default(30) | int }}