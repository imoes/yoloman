{
  "enable_responder": true,
  "enable_querier": true,
  "interfaces": [
    "eth0",
    "wlan0"
  ],
  "hostname": "",
  "ttl": 120,
  "multicast_ttl": 255,
  "max_queries": 100,
  "hide_local_services": false,
  "allow_services": [],
  "deny_services": [
    "_daap._tcp",
    "_ftp._tcp"
  ],
  "txt_records": [
    {
      "name": "MyWebServer",
      "type": "_http._tcp",
      "data": {
        "path": "/",
        "version": "2.4"
      }
    },
    {
      "name": "Printer1",
      "type": "_ipp._tcp",
      "data": {
        "TLS": "1",
        "Priority": "10"
      }
    }
  ],
  "log_level": "info",
  "pidfile": "/run/mdnsd.pid"
}
