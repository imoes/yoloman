{
  "reporter": {
    "type": "string",
    "default": "spec",
    "description": "Specify reporter to use",
    "enum": [
      "spec",
      "list",
      "json",
      "html"
    ]
  },
  "ui": {
    "type": "string",
    "default": "bdd",
    "description": "Specify user interface"
  },
  "timeout": {
    "type": "number",
    "default": 2000,
    "description": "Specify test timeout threshold (in milliseconds)"
  },
  "slow": {
    "type": "number",
    "default": 75,
    "description": "Specify 'slow' test threshold (in milliseconds)"
  },
  "colors": {
    "type": "bool",
    "default": false,
    "description": "Force-enable color output"
  },
  "requires": {
    "type": "list",
    "default": [],
    "description": "Require module before running tests"
  },
  "files": {
    "type": "list",
    "default": [],
    "description": "Specify file(s) to be loaded prior to root suite execution"
  },
  "extensions": {
    "type": "list",
    "default": [
      "js",
      "cjs",
      "mjs"
    ],
    "description": "File extension(s) to load"
  },
  "ignores": {
    "type": "list",
    "default": [],
    "description": "Ignore file(s) or glob pattern(s)"
  },
  "node_options": {
    "type": "list",
    "default": [],
    "description": "Node or V8 option (no leading '--')"
  },
  "reporter_options": {
    "type": "list",
    "default": [],
    "description": "Reporter-specific options (k=v)"
  },
  "globals": {
    "type": "list",
    "default": [],
    "description": "List of allowed global variables"
  },
  "grep": {
    "type": "string",
    "default": "",
    "description": "Only run tests matching this string or regexp"
  },
  "invert": {
    "type": "bool",
    "default": false,
    "description": "Inverts --grep and --fgrep matches"
  },
  "fgrep": {
    "type": "string",
    "default": "",
    "description": "Only run tests containing this string"
  },
  "bail": {
    "type": "bool",
    "default": false,
    "description": "Abort ('bail') after first test failure"
  },
  "parallel": {
    "type": "bool",
    "default": false,
    "description": "Run tests in parallel"
  },
  "jobs": {
    "type": "number",
    "default": 0,
    "description": "Number of concurrent jobs for --parallel; use 1 to run in serial. 0 means auto"
  },
  "retries": {
    "type": "number",
    "default": 0,
    "description": "Retry failed tests this many times"
  },
  "exit": {
    "type": "bool",
    "default": false,
    "description": "Force Mocha to quit after tests complete"
  },
  "async_only": {
    "type": "bool",
    "default": false,
    "description": "Require all tests to use a callback (async) or return a Promise"
  },
  "check_leaks": {
    "type": "bool",
    "default": false,
    "description": "Check for global variable leaks"
  },
  "fail_zero": {
    "type": "bool",
    "default": false,
    "description": "Fail test run if no test(s) encountered"
  },
  "forbid_only": {
    "type": "bool",
    "default": false,
    "description": "Fail if exclusive test(s) encountered"
  },
  "forbid_pending": {
    "type": "bool",
    "default": false,
    "description": "Fail if pending test(s) encountered"
  },
  "full_trace": {
    "type": "bool",
    "default": false,
    "description": "Display full stack traces"
  },
  "inline_diffs": {
    "type": "bool",
    "default": false,
    "description": "Display actual/expected differences inline within each string"
  },
  "diff": {
    "type": "bool",
    "default": true,
    "description": "Show diff on failure"
  },
  "sort": {
    "type": "bool",
    "default": false,
    "description": "Sort test files"
  },
  "recursive": {
    "type": "bool",
    "default": true,
    "description": "Look for tests in subdirectories"
  },
  "pass_on_failing_test_suite": {
    "type": "bool",
    "default": false,
    "description": "Not fail test run if tests were failed"
  },
  "allow_uncaught": {
    "type": "bool",
    "default": false,
    "description": "Allow uncaught errors to propagate"
  },
  "delay": {
    "type": "bool",
    "default": false,
    "description": "Delay initial execution of root suite"
  },
  "dry_run": {
    "type": "bool",
    "default": false,
    "description": "Report tests without executing them"
  },
  "watch": {
    "type": "bool",
    "default": false,
    "description": "Watch files in the current working directory for changes"
  },
  "watch_files": {
    "type": "list",
    "default": [],
    "description": "List of paths or globs to watch"
  },
  "watch_ignores": {
    "type": "list",
    "default": [
      "node_modules",
      ".git"
    ],
    "description": "List of paths or globs to exclude from watching"
  },
  "specs": {
    "type": "list",
    "default": [
      "test"
    ],
    "description": "One or more files, directories, or globs to test"
  }
}
