#!/usr/bin/env bash
# =============================================================================
# Mocha Test Runner Wrapper Script
# =============================================================================
# This script generates a command-line invocation for Mocha based on Ansible
# variables. It is self-documenting: every flag corresponds to a schema field
# with its default value and description clearly commented.
#
# Generated by Ansible Jinja2 template. Do not edit manually.
# =============================================================================

# --- Basic Configuration ---

# Specify reporter to use (e.g., spec, json, tap). Default: spec
REPORTER="{{ reporter | default('spec') }}"

# Specify user interface (bdd, tdd, qunit). Default: bdd
UI="{{ ui | default('bdd') }}"

# Specify test timeout threshold (in milliseconds). Default: 2000
TIMEOUT="{{ timeout | default(2000) }}"

# Specify 'slow' test threshold (in milliseconds). Default: 75
SLOW="{{ slow | default(75) }}"

# --- Optional Flags ---

# Force-enable color output. Default: False
{% if colors | default(false) | bool %}
COLOR_FLAG="--color"
{% else %}
COLOR_FLAG=""
{% endif %}

# --- List/Repeatable Options ---

# Require module before running tests (multiple allowed). Default: []
{% set _requires = requires | default([]) %}
{% if _requires %}
REQUIRE_FLAGS=""
{% for req in _requires %}
REQUIRE_FLAGS="${REQUIRE_FLAGS} --require {{ req }}"
{% endfor %}
{% else %}
REQUIRE_FLAGS=""
{% endif %}

# Specify file(s) to be loaded prior to root suite execution. Default: []
{% set _files = files | default([]) %}
{% if _files %}
FILE_FLAGS=""
{% for file in _files %}
FILE_FLAGS="${FILE_FLAGS} --file {{ file }}"
{% endfor %}
{% else %}
FILE_FLAGS=""
{% endif %}

# File extension(s) to load. Default: ['js', 'cjs', 'mjs']
{% set _extensions = extensions | default(['js', 'cjs', 'mjs']) %}
{% if _extensions %}
EXTENSION_FLAGS=""
{% for ext in _extensions %}
EXTENSION_FLAGS="${EXTENSION_FLAGS} --extension {{ ext }}"
{% endfor %}
{% else %}
EXTENSION_FLAGS=""
{% endif %}

# Ignore file(s) or glob pattern(s). Default: []
{% set _ignores = ignores | default([]) %}
{% if _ignores %}
IGNORE_FLAGS=""
{% for ignore in _ignores %}
IGNORE_FLAGS="${IGNORE_FLAGS} --ignore {{ ignore }}"
{% endfor %}
{% else %}
IGNORE_FLAGS=""
{% endif %}

# Node or V8 option (no leading '--'). Default: []
{% set _node_options = node_options | default([]) %}
{% if _node_options %}
NODE_OPT_FLAGS=""
{% for node_opt in _node_options %}
NODE_OPT_FLAGS="${NODE_OPT_FLAGS} --node-option {{ node_opt }}"
{% endfor %}
{% else %}
NODE_OPT_FLAGS=""
{% endif %}

# Reporter-specific options (k=v). Default: []
{% set _reporter_options = reporter_options | default([]) %}
{% if _reporter_options %}
REPORTER_OPT_FLAGS=""
{% for opt in _reporter_options %}
REPORTER_OPT_FLAGS="${REPORTER_OPT_FLAGS} --reporter-option {{ opt }}"
{% endfor %}
{% else %}
REPORTER_OPT_FLAGS=""
{% endif %}

# List of allowed global variables. Default: []
{% set _globals = globals | default([]) %}
{% if _globals %}
GLOBAL_FLAGS=""
{% for global_var in _globals %}
GLOBAL_FLAGS="${GLOBAL_FLAGS} --globals {{ global_var }}"
{% endfor %}
{% else %}
GLOBAL_FLAGS=""
{% endif %}

# --- Filter Flags ---

# Only run tests matching this string or regexp. Default: ''
{% set _grep = grep | default('') %}
{% if _grep %}
GREP_FLAG="--grep {{ _grep }}"
{% else %}
GREP_FLAG=""
{% endif %}

# Inverts --grep and --fgrep matches. Default: False
{% if invert | default(false) | bool %}
INVERT_FLAG="--invert"
{% else %}
INVERT_FLAG=""
{% endif %}

# Only run tests containing this string. Default: ''
{% set _fgrep = fgrep | default('') %}
{% if _fgrep %}
FGREP_FLAG="--fgrep {{ _fgrep }}"
{% else %}
FGREP_FLAG=""
{% endif %}

# --- Execution Control Flags ---

# Abort ('bail') after first test failure. Default: False
{% if bail | default(false) | bool %}
BAIL_FLAG="--bail"
{% else %}
BAIL_FLAG=""
{% endif %}

# Run tests in parallel. Default: False
{% if parallel | default(false) | bool %}
PARALLEL_FLAG="--parallel"
{% else %}
PARALLEL_FLAG=""
{% endif %}

# Number of concurrent jobs for --parallel; use 1 to run in serial. 0 means auto. Default: 0
{% set _jobs = jobs | default(0) %}
{% if _jobs %}
JOBS_FLAG="--jobs {{ _jobs }}"
{% else %}
JOBS_FLAG=""
{% endif %}

# Retry failed tests this many times. Default: 0
{% set _retries = retries | default(0) %}
{% if _retries > 0 %}
RETRY_FLAG="--retries {{ _retries }}"
{% else %}
RETRY_FLAG=""
{% endif %}

# Force Mocha to quit after tests complete. Default: False
{% if exit | default(false) | bool %}
EXIT_FLAG="--exit"
{% else %}
EXIT_FLAG=""
{% endif %}

# Require all tests to use a callback (async) or return a Promise. Default: False
{% if async_only | default(false) | bool %}
ASYNC_FLAG="--async-only"
{% else %}
ASYNC_FLAG=""
{% endif %}

# Check for global variable leaks. Default: False
{% if check_leaks | default(false) | bool %}
LEAKS_FLAG="--check-leaks"
{% else %}
LEAKS_FLAG=""
{% endif %}

# Fail test run if no test(s) encountered. Default: False
{% if fail_zero | default(false) | bool %}
FAIL_ZERO_FLAG="--fail-zero"
{% else %}
FAIL_ZERO_FLAG=""
{% endif %}

# Fail if exclusive test(s) encountered. Default: False
{% if forbid_only | default(false) | bool %}
FORBID_ONLY_FLAG="--forbid-only"
{% else %}
FORBID_ONLY_FLAG=""
{% endif %}

# Fail if pending test(s) encountered. Default: False
{% if forbid_pending | default(false) | bool %}
FORBID_PENDING_FLAG="--forbid-pending"
{% else %}
FORBID_PENDING_FLAG=""
{% endif %}

# Display full stack traces. Default: False
{% if full_trace | default(false) | bool %}
FULL_TRACE_FLAG="--full-trace"
{% else %}
FULL_TRACE_FLAG=""
{% endif %}

# Display actual/expected differences inline within each string. Default: False
{% if inline_diffs | default(false) | bool %}
INLINE_DIFFS_FLAG="--inline-diffs"
{% else %}
INLINE_DIFFS_FLAG=""
{% endif %}

# Show diff on failure. Default: True
{% if diff | default(true) | bool %}
DIFF_FLAG="--diff"
{% else %}
DIFF_FLAG=""
{% endif %}

# Sort test files. Default: False
{% if sort | default(false) | bool %}
SORT_FLAG="--sort"
{% else %}
SORT_FLAG=""
{% endif %}

# Look for tests in subdirectories. Default: True
{% if recursive | default(true) | bool %}
RECURSIVE_FLAG="--recursive"
{% else %}
RECURSIVE_FLAG=""
{% endif %}

# Not fail test run if tests were failed. Default: False
{% if pass_on_failing_test_suite | default(false) | bool %}
PASS_ON_FAIL_FLAG="--pass-on-failing-test-suite"
{% else %}
PASS_ON_FAIL_FLAG=""
{% endif %}

# Allow uncaught errors to propagate. Default: False
{% if allow_uncaught | default(false) | bool %}
ALLOW_UNCAUGHT_FLAG="--allow-uncaught"
{% else %}
ALLOW_UNCAUGHT_FLAG=""
{% endif %}

# Delay initial execution of root suite. Default: False
{% if delay | default(false) | bool %}
DELAY_FLAG="--delay"
{% else %}
DELAY_FLAG=""
{% endif %}

# Report tests without executing them. Default: False
{% if dry_run | default(false) | bool %}
DRY_RUN_FLAG="--dry-run"
{% else %}
DRY_RUN_FLAG=""
{% endif %}

# Watch files in the current working directory for changes. Default: False
{% if watch | default(false) | bool %}
WATCH_FLAG="--watch"
{% else %}
WATCH_FLAG=""
{% endif %}

# List of paths or globs to watch. Default: []
{% set _watch_files = watch_files | default([]) %}
{% if _watch_files %}
WATCH_FILE_FLAGS=""
{% for wfile in _watch_files %}
WATCH_FILE_FLAGS="${WATCH_FILE_FLAGS} --watch-files {{ wfile }}"
{% endfor %}
{% else %}
WATCH_FILE_FLAGS=""
{% endif %}

# List of paths or globs to exclude from watching. Default: ['node_modules', '.git']
{% set _watch_ignores = watch_ignores | default(['node_modules', '.git']) %}
{% if _watch_ignores %}
WATCH_IGNORE_FLAGS=""
{% for wignore in _watch_ignores %}
WATCH_IGNORE_FLAGS="${WATCH_IGNORE_FLAGS} --watch-ignore {{ wignore }}"
{% endfor %}
{% else %}
WATCH_IGNORE_FLAGS=""
{% endif %}

# One or more files, directories, or globs to test. Default: ['test']
{% set _specs = specs | default(['test']) %}
{% if _specs %}
SPEC_FLAGS=""
{% for spec in _specs %}
SPEC_FLAGS="${SPEC_FLAGS} {{ spec }}"
{% endfor %}
{% else %}
SPEC_FLAGS=""
{% endif %}

# --- Execution ---

# Construct the final command and execute
# Note: Some flags are repeated in the command line to ensure Mocha receives them
# in the correct order (global flags, then UI/Timeout/Slow/Reporter specific flags).
echo "Running Mocha with the following configuration:"
echo "Reporter: ${REPORTER}"
echo "UI: ${UI}"
echo "Timeout: ${TIMEOUT}"
echo "Slow: ${SLOW}"
echo "Command: mocha ${COLOR_FLAG} ${REQUIRE_FLAGS} ${FILE_FLAGS} ${EXTENSION_FLAGS} ${IGNORE_FLAGS} ${NODE_OPT_FLAGS} ${REPORTER_OPT_FLAGS} ${GLOBAL_FLAGS} ${GREP_FLAG} ${INVERT_FLAG} ${FGREP_FLAG} ${BAIL_FLAG} ${PARALLEL_FLAG} ${JOBS_FLAG} ${RETRY_FLAG} ${EXIT_FLAG} ${ASYNC_FLAG} ${LEAKS_FLAG} ${FAIL_ZERO_FLAG} ${FORBID_ONLY_FLAG} ${FORBID_PENDING_FLAG} ${FULL_TRACE_FLAG} ${INLINE_DIFFS_FLAG} ${DIFF_FLAG} ${SORT_FLAG} ${RECURSIVE_FLAG} ${PASS_ON_FAIL_FLAG} ${ALLOW_UNCAUGHT_FLAG} ${DELAY_FLAG} ${DRY_RUN_FLAG} ${WATCH_FLAG} ${WATCH_FILE_FLAGS} ${WATCH_IGNORE_FLAGS} --ui ${UI} --timeout ${TIMEOUT} --slow ${SLOW} --reporter ${REPORTER} ${SPEC_FLAGS}"

exec mocha ${COLOR_FLAG} ${REQUIRE_FLAGS} ${FILE_FLAGS} ${EXTENSION_FLAGS} ${IGNORE_FLAGS} ${NODE_OPT_FLAGS} ${REPORTER_OPT_FLAGS} ${GLOBAL_FLAGS} ${GREP_FLAG} ${INVERT_FLAG} ${FGREP_FLAG} ${BAIL_FLAG} ${PARALLEL_FLAG} ${JOBS_FLAG} ${RETRY_FLAG} ${EXIT_FLAG} ${ASYNC_FLAG} ${LEAKS_FLAG} ${FAIL_ZERO_FLAG} ${FORBID_ONLY_FLAG} ${FORBID_PENDING_FLAG} ${FULL_TRACE_FLAG} ${INLINE_DIFFS_FLAG} ${DIFF_FLAG} ${SORT_FLAG} ${RECURSIVE_FLAG} ${PASS_ON_FAIL_FLAG} ${ALLOW_UNCAUGHT_FLAG} ${DELAY_FLAG} ${DRY_RUN_FLAG} ${WATCH_FLAG} ${WATCH_FILE_FLAGS} ${WATCH_IGNORE_FLAGS} --ui ${UI} --timeout ${TIMEOUT} --slow ${SLOW} --reporter ${REPORTER} ${SPEC_FLAGS}