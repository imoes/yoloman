{
  "reporter": "nyan",
  "ui": "bdd",
  "timeout": 5000,
  "slow": 100,
  "colors": true,
  "requires": [
    "@babel/register"
  ],
  "files": [
    "test/setup.js"
  ],
  "extensions": [
    "js"
  ],
  "ignores": [
    "test/fixtures/**/*"
  ],
  "node_options": [
    "max-old-space-size=4096"
  ],
  "reporter_options": [
    "reporter-option=icon=true"
  ],
  "globals": [
    "expect",
    "chai"
  ],
  "grep": "login",
  "invert": false,
  "fgrep": "",
  "bail": false,
  "parallel": true,
  "jobs": 4,
  "retries": 2,
  "exit": true,
  "async_only": false,
  "check_leaks": true,
  "fail_zero": false,
  "forbid_only": false,
  "forbid_pending": true,
  "full_trace": false,
  "inline_diffs": false,
  "diff": true,
  "sort": false,
  "recursive": true,
  "pass_on_failing_test_suite": false,
  "allow_uncaught": false,
  "delay": false,
  "dry_run": false,
  "watch": false,
  "watch_files": [],
  "watch_ignores": [
    "node_modules",
    ".git"
  ],
  "specs": [
    "test/**/*.spec.js"
  ]
}
