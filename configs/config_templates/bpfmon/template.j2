# BPF-based visual packet rate monitor configuration
# This template generates the runtime configuration file for bpfmon.
# Each variable uses its schema default to ensure safe rendering even if
# the variable is undefined in the Ansible play.

# Network interface to monitor (e.g., eth0, enp0s3)
DEVICE={{ device | default('eth0') }}

# BPF filter expression to select packets
BPF_FILTER='{{ bpf_filter | default('ip') }}'

# Display mode; must be one of: ascii, utf8, text, horizontal, vertical, history, legend, inverse, normal
MODE={{ mode | default('utf8') }}

# iptables table name when using iptables/ip6tables source
TABLE={{ table | default('filter') }}

# iptables chain name when using iptables/ip6tables source
CHAIN={{ chain | default('INPUT') }}

# Rule number (1-indexed) in the chain
RULENUM={{ rulenum | default(1) }}

# iptables variant: 'iptables' (IPv4) or 'ip6tables' (IPv6)
IPTABLES_TYPE={{ iptables_type | default('iptables') }}

# Empty string or 'select'/'select6' for interactive rule selection mode
SELECT_RULE={{ select_rule | default('') }}