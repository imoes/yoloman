; =============================================================================
; qpxtool Configuration Template
; =============================================================================
; This template configures the qpxtool GUI frontends.
; It controls the default backend command-line tool used for CD/DVD operations
; and the initial geometry of the application window.
; =============================================================================

[General]
; Default CLI engine to use for CD/DVD operations.
; Valid values: qscan, cdvdcontrol
; The command-line interface tool used by qpxtool (e.g., qscan or cdvdcontrol).
default_backend={{ default_backend | default('qscan') }}

; Initial window width in pixels.
; Default width of the application window in pixels.
window_width={{ window_width | default(800) }}

; Initial window height in pixels.
; Default height of the application window in pixels.
window_height={{ window_height | default(600) }}

; Enable verbose logging to stdout.
; If true, enables verbose output for debugging.
verbose={{ verbose | default(false) | lower }}

; Path to the preferred CD/DVD device.
; Path to the CD/DVD drive device file.
device_path={{ device_path | default('/dev/cdrom') }}