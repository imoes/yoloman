# xdg-dbus-proxy configuration
# Generated by Ansible Jinja2 template
# This file controls the xdg-dbus-proxy daemon, which sits between client applications
# and the D-Bus system/session bus, enforcing security policies (SEE/TALK/OWN) and
# filtering rules.

# ==============================================================================
# Global Options
# ==============================================================================

# --fd FD: File descriptor to write readiness to when proxies are set up.
# If not provided or empty, the --fd flag is omitted.
{% if fd is defined and fd %}
--fd={{ fd }}
{% endif %}

# ==============================================================================
# Proxy Instances
# ==============================================================================
# Each entry in 'proxies' defines a proxy listener.
# Syntax per proxy: ADDRESS PATH [--filter] [--log] [--sloppy-names]
#
# ADDRESS: The D-Bus daemon address to forward traffic to (e.g. unix:path=/run/dbus/system_bus_socket).
# PATH: The Unix domain socket path where xdg-dbus-proxy will listen for client connections.

{% for proxy in (proxies | default([])) %}

# --------------------------------------------------------------------------
# Proxy Instance Configuration
# Source Index: {{ loop.index0 }}
# --------------------------------------------------------------------------

# ADDRESS: D-Bus address to proxy connections to.
# Example: 'unix:path=/run/dbus/system_bus_socket' or 'unix:path=/run/user/1000/bus'
# Default: '' (empty string, usually overridden by schema)
{{ proxy.address | default('') }}

# PATH: Unix domain socket path where the proxy will listen for client connections.
# Default: '' (empty string, usually overridden by schema)
{{ proxy.path | default('') }}

# OPTIONS: Flags modifying proxy behavior.

# --filter: Enable filtering mode.
# If true, only messages matching the policies below are forwarded.
# If false/null, all messages are forwarded unfiltered.
{% if proxy.filter is defined and proxy.filter %}
--filter
{% endif %}

# --log: Turn on logging for this proxy instance.
# Useful for debugging policy enforcement issues.
{% if proxy.log is defined and proxy.log %}
--log
{% endif %}

# --sloppy-names: Make all unique names visible regardless of policy.
# This disables strict name visibility checks in introspection.
{% if proxy.sloppy_names is defined and proxy.sloppy_names %}
--sloppy-names
{% endif %}

# --------------------------------------------------------------------------
# SEE Policy (Visibility)
# Corresponds to: --see=NAME
# Defines well-known names that are visible in ListNames, ListActivatableNames, and NameHasOwner.
# --------------------------------------------------------------------------
{% if proxy.see is defined and proxy.see %}
{% for name in proxy.see %}
--see={{ name }}
{% endfor %}
{% endif %}

# --------------------------------------------------------------------------
# TALK Policy (Communication)
# Corresponds to: --talk=NAME
# Allows the client to send method calls/signals to and receive broadcasts from these well-known names.
# --------------------------------------------------------------------------
{% if proxy.talk is defined and proxy.talk %}
{% for name in proxy.talk %}
--talk={{ name }}
{% endfor %}
{% endif %}

# --------------------------------------------------------------------------
# OWN Policy (Ownership)
# Corresponds to: --own=NAME
# Allows the client to request (RequestName) and release (ReleaseName) ownership of these well-known names.
# --------------------------------------------------------------------------
{% if proxy.own is defined and proxy.own %}
{% for name in proxy.own %}
--own={{ name }}
{% endfor %}
{% endif %}

# --------------------------------------------------------------------------
# Call Rules (Method Restriction)
# Corresponds to: --call=NAME=EXPRESSION
# Restricts allowed method calls on a specific well-known name.
# EXPRESSION format: [METHOD][@PATH]
# Examples:
#   '*'                      -> Allow all methods on all paths
#   'Get@/org/freedesktop/Properties' -> Allow only 'Get' method on path '/org/freedesktop/Properties'
# --------------------------------------------------------------------------
{% if proxy.call_rules is defined and proxy.call_rules %}
{% for rule in proxy.call_rules %}
--call={{ rule.rule_name | default('') }}={{ rule.rule_expression | default('') }}
{% endfor %}
{% endif %}

# --------------------------------------------------------------------------
# Broadcast Rules (Signal Restriction)
# Corresponds to: --broadcast=NAME=EXPRESSION
# Restricts allowed broadcast signals (emitted signals) from a specific well-known name.
# EXPRESSION format: [METHOD][@PATH]
# --------------------------------------------------------------------------
{% if proxy.broadcast_rules is defined and proxy.broadcast_rules %}
{% for rule in proxy.broadcast_rules %}
--broadcast={{ rule.rule_name | default('') }}={{ rule.rule_expression | default('') }}
{% endfor %}
{% endif %}

{% endfor %}