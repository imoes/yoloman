{
  "fd": 26,
  "proxies": [
    {
      "address": "unix:path=/run/user/1000/bus",
      "path": "/run/user/1000/.dbus-proxy/session-bus-proxy",
      "filter": true,
      "log": false,
      "sloppy_names": false,
      "see": [],
      "talk": [
        "ca.desrt.dconf",
        "org.freedesktop.DBus"
      ],
      "own": [
        "org.gnome.ghex.*"
      ],
      "call_rules": [
        {
          "name": "org.freedesktop.portal.*",
          "rule": "*"
        }
      ],
      "broadcast_rules": [
        {
          "name": "org.freedesktop.portal.*",
          "rule": "@/org/freedesktop/portal/*"
        }
      ]
    }
  ]
}
