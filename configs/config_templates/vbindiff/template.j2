# ==============================================================================
# vbindiff Configuration Template
# ==============================================================================
# This file configures default preferences for the vbindiff binary diff viewer.
# It is self-documented: every directive is preceded by a comment explaining
# its purpose and valid values, sourced from the schema.
# ==============================================================================

# DISPLAY_MODE: The display format for binary data.
# Valid values: 'hex' (hexadecimal representation), 'binary' (raw binary representation).
# Default: hex
DISPLAY_MODE = {{ display_mode | default('hex') }}

# CHARACTER_SET: The character encoding to use for the text column.
# Valid values: 'ascii', 'ebcdic'.
# Default: ascii
CHARACTER_SET = {{ character_set | default('ascii') }}

# FONT_SIZE: The font size in points used for the main display window.
# Must be an integer.
# Default: 12
FONT_SIZE = {{ font_size | default(12) }}

# HIGHLIGHT_INVERT: When true, differences are highlighted by inverting colors;
# when false, they use a solid block color.
# Default: false
HIGHLIGHT_INVERT = {{ highlight_invert | default(false) }}

# COLOR_THEME_FILE: Path to a custom color theme file.
# Leave empty to use the built-in default theme.
COLOR_THEME_FILE = {{ color_theme_file | default('') }}

# EDITOR_CMD: Command to invoke as the external text editor when the user presses 'E'.
# Leave empty to use the default system editor.
EDITOR_CMD = {{ editor_cmd | default('') }}