# IPMI Simulator Configuration Template
# This template generates configuration for ipmi_sim to simulate a Baseboard
# Management Controller (BMC). It sets up the main management controller,
# sensors (watchdog, temperature, memory presence), and a satellite MC.

# -----------------------------------------------------------------------------
# BMC Address Configuration
# The IPMI BMC address (MC address) for the main management controller.
# -----------------------------------------------------------------------------

{% if BMC_ADDRESS is defined and BMC_ADDRESS is not none and (BMC_ADDRESS is number or BMC_ADDRESS is boolean or BMC_ADDRESS | length > 0) %}
# The BMC is the MC at address {{ BMC_ADDRESS }}
{% else %}
# The BMC is the MC at address 20
{% endif %}

# Set the BMC address for the main controller.
# Default: 32 (0x20)
mc_setbmc {{ BMC_ADDRESS | default(32) }}

# Add the main BMC device.
mc_add {{ BMC_ADDRESS | default(32) }} 0 no-device-sdrs 0x23 9 8 0x9f 0x1291 0xf02 persist_sdr

# Enable the SEL (System Event Log) for the BMC.
sel_enable {{ BMC_ADDRESS | default(32) }} 1000 0x0a

# -----------------------------------------------------------------------------
# Watchdog Sensor
# This must be sensor zero for the watchdog functionality.
# -----------------------------------------------------------------------------

# Add the watchdog sensor at index 0.
sensor_add {{ BMC_ADDRESS | default(32) }} 0 0 35 0x6f event-only

# Configure event support for the watchdog sensor.
sensor_set_event_support {{ BMC_ADDRESS | default(32) }} 0 0 enable scanning per-state \
	000000000001111 000000000000000 \
	000000000001111 000000000000000

# -----------------------------------------------------------------------------
# Temperature Sensor
# Adds a temperature sensor at index 1.
# -----------------------------------------------------------------------------

# Add a temperature sensor and its SDR. Note that sensor 0 is already
# taken as the watchdog sensor.
sensor_add {{ BMC_ADDRESS | default(32) }} 0 1 0x01 0x01

# Start with the value set to 0x60
sensor_set_value {{ BMC_ADDRESS | default(32) }} 0 1 0x60 0

# Set just the upper thresholds with the values 0x70, 0x90, and 0xa0
sensor_set_threshold {{ BMC_ADDRESS | default(32) }} 0 1 settable 111000 0xa0 0x90 0x70 00 00 00

# Enable all upper threshold events events
sensor_set_event_support {{ BMC_ADDRESS | default(32) }} 0 1 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000

# -----------------------------------------------------------------------------
# Memory Module Presence Sensor
# Adds a sensor at index 2 to detect memory module presence.
# -----------------------------------------------------------------------------

# Add a memory module presence sensor.
sensor_add {{ BMC_ADDRESS | default(32) }} 0 2 37 0x6f

# Clear bit settings for the memory sensor.
sensor_set_bit_clr_rest {{ BMC_ADDRESS | default(32) }} 0 2 1 1

{% if BMC_ADDRESS is defined and BMC_ADDRESS is not none and (BMC_ADDRESS is number or BMC_ADDRESS is boolean or BMC_ADDRESS | length > 0) %}
sensor_set_bit_clr_rest {{ BMC_ADDRESS }} 0 2 0 1
{% else %}
#sensor_set_bit_clr_rest 0x20 0 2 0 1
{% endif %}

# Enable events for the memory presence sensor.
sensor_set_event_support {{ BMC_ADDRESS | default(32) }} 0 2 enable scanning per-state \
	000000000000011 000000000000011 \
	000000000000011 000000000000011

# -----------------------------------------------------------------------------
# FRU Data
# FRU (Field Replaceable Unit) data for entity 8.2.
# -----------------------------------------------------------------------------

mc_add_fru_data 0x30 3 128 data 0

# -----------------------------------------------------------------------------
# Satellite Management Controller
# Adds a secondary/satellite MC to the simulation.
# -----------------------------------------------------------------------------

# Add a satellite MC.
mc_add 0x30 2 no-device-sdrs 0x98 0x10 1 0xa0 0x1291 0xf03

# Add a temperature sensor to the satellite MC.
sensor_add 0x30 0 1 0x01 0x01

# Uncomment the following and comment the preceding to read the value
# from the given file. You can modify the file contents.
#sensor_add 0x30 0 1 0x01 0x01 poll 1000 file "/tmp/file1.ipm"

# Set thresholds for the satellite MC's temperature sensor.
sensor_set_threshold 0x30 0 1 settable 111000 0xa0 0x90 0x70 00 00 00

# Enable events for the satellite MC's temperature sensor.
sensor_set_event_support 0x30 0 1 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000

# Enable the satellite MC.
mc_enable 0x30

# -----------------------------------------------------------------------------
# Finalization
# Turn on the main BMC.
# -----------------------------------------------------------------------------

mc_enable {{ BMC_ADDRESS | default(32) }}
