#!/usr/bin/sh
#
# resolv.conf merge hook for rdnssd
#
# This script is a hook used by rdnssd (Recursive DNS Server Daemon) to
# merge IPv6 nameserver addresses (RDNSS) found in router advertisements
# with the existing /etc/resolv.conf. It ensures that the total number
# of nameserver entries does not exceed the system limit (MAXNS), prioritizing
# the management of IPv6 entries while preserving existing IPv4 nameservers.
#
# Copyright © 2007-2009, 2017 Pierre Ynard.
# Licensed under GNU General Public License v2 or v3.

set -e

PATH=/sbin:/bin

# *************************************************************************
# *  Copyright © 2007-2009, 2017 Pierre Ynard.                            *
# *  This program is free software: you can redistribute and/or modify    *
# *  it under the terms of the GNU General Public License as published by *
# *  the Free Software Foundation, versions 2 or 3 of the license.        *
# *                                                                       *
# *  This program is distributed in the hope that it will be useful,      *
# *  but WITHOUT ANY WARRANTY; without even the implied warranty of       *
# *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the        *
# *  GNU General Public License for more details.                         *
# *                                                                       *
# *  You should have received a copy of the GNU General Public License    *
# *  along with this program. If not, see <http://www.gnu.org/licenses/>. *
# *************************************************************************

# Max number of nameserver options taken into account.
# Default: 3 (typical limit in <resolv.h>)
# Should match the system's maximum supported nameservers.
MAXNS={{ maxns | default('3') }}

# This script tries to share available nameserver slots with IPv4
# entries, for example to allow fallback to IPv4 if IPv6 fails. If
# there is not enough room for all IPv6 and IPv4 entries, this script
# will limit the IPv6 entries it adds to $RDNSS_LIMIT only.
# Calculated as MAXNS minus 1 to reserve at least one slot for IPv4 if needed.
RDNSS_LIMIT=$(($MAXNS - 1))

# System configuration directory.
# Default: /etc
sysconfdir='{{ sysconfdir | default('/etc') }}'

# Local state directory.
# Default: /var
localstatedir='{{ localstatedir | default('/var') }}'

# Paths for resolv.conf management
resolvconf="$sysconfdir/resolv.conf"
myresolvconf="$localstatedir/run/rdnssd/resolv.conf"

# These should be POSIX-compliant BREs

# Regex for IPv4 nameserver entries
# Matches lines like: nameserver 192.168.1.1
RE_NSV4='^nameserver  *\([0-9]\{1,3\}\.\)\{3,3\}[0-9]\{1,3\} *$'

# Regex for IPv4 or IPv6 nameserver entries
# Matches standard IPv4 or IPv6 addresses (with optional zone ID)
RE_NSV4OR6='^nameserver  *[a-fA-F0-9:\.]\{1,46\}\(%[a-zA-Z0-9]\{1,\}\)\{0,1\} *$'

# Count how many IPv6 nameservers we can fit

# Start with the calculated limit for IPv6 entries
limit=$RDNSS_LIMIT

# Count existing IPv4 nameservers in the main resolv.conf
# The `|| [ $? -le 1 ]` pattern handles the case where grep finds 0 matches (exit code 1)
# without failing the script due to `set -e`.
nnsv4=`grep -c "$RE_NSV4" $resolvconf || [ $? -le 1 ]`

# Calculate available room for nameservers after accounting for existing IPv4 entries
room=$(($MAXNS - $nnsv4))

# Ensure the limit for IPv6 entries does not exceed the available room
if [ $limit -lt $room ]; then
	limit=$room
fi

# Merge and write the result. Let rdnssd assume ownership of all IPv6
# nameservers, and remove extraneous IPv6 entries as expired. However
# DHCPv4 most often sets up search list entries, and rdnssd cannot
# clobber these lest it causes counterintuitive breakage. There is no
# easy way to properly merge and manage DNSSL entries here, so just drop
# them.

# Strategy:
# 1. Remove ALL existing IPv4/IPv6 nameserver lines from the current resolv.conf.
# 2. Add back up to `limit` IPv4/IPv6 nameserver lines from rdnssd's managed state
#    (which contains the freshly discovered RDNSS entries).
# 3. Append the original IPv4 nameserver entries (preserving DHCP-set IPv4 DNS).
# The result is written to a temp file and atomically moved into place.

{
	# Remove existing nameserver entries (both IPv4 and IPv6)
	sed -e "/$RE_NSV4OR6/d" < $resolvconf
	
	# Add up to `limit` nameserver entries from rdnssd's managed file
	# This prioritizes the newly discovered IPv6/RDNSS entries
	grep -m $limit "$RE_NSV4OR6" < $myresolvconf || [ $? -le 1 ]
	
	# Append existing IPv4 nameservers from the original config
	# This ensures DHCP-provided IPv4 DNS is not lost
	sed -ne "/$RE_NSV4/p" < $resolvconf
} > $resolvconf.tmp

# Atomically replace the configuration file
mv -f $resolvconf.tmp $resolvconf
