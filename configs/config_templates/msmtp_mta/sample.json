{
  "default_account": "gmail",
  "log_file": "/var/log/msmtp.log",
  "tls_enabled": true,
  "tls_starttls": true,
  "tls_trust_file": "/etc/ssl/certs/ca-certificates.crt",
  "accounts": [
    {
      "name": "gmail",
      "host": "smtp.gmail.com",
      "port": 587,
      "from_addr": "user@gmail.com",
      "auth_method": "login",
      "user": "user@gmail.com",
      "password": "app-password-here",
      "tls": true,
      "tls_starttls": true
    },
    {
      "name": "outlook",
      "host": "smtp.office365.com",
      "port": 587,
      "from_addr": "user@company.com",
      "auth_method": "login",
      "user": "user@company.com",
      "password": "secret-password",
      "tls": true,
      "tls_trust_file": "/etc/ssl/certs/microsoft-ca.pem"
    }
  ]
}
