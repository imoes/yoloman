{
  "hosts": [
    "127.0.0.1"
  ],
  "port": 8000,
  "unix_socket": "",
  "unix_socket_perms": 384,
  "backlog": 1024,
  "static_routes": [
    {
      "path": "/static",
      "directory": "/var/www/static"
    }
  ],
  "static_cors": "*",
  "script_name": "/myapp",
  "url_scheme": "http",
  "threads": 8,
  "inbuf_overflow": 524288,
  "max_request_body_size": 1073741824,
  "shutdown_timeout": 60.0,
  "verbose": 1,
  "quiet": 0,
  "app_module": "wsgiapp:main"
}
