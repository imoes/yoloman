{
  "global_settings": "[global]\n  log_level = INFO\n  cache_dir = /var/entangle/cache\n  database_url = sqlite:///var/entangle/entangle.db",
  "renderers": [
    {
      "name": "gpu-render-1",
      "host": "render1.example.com",
      "port": 18888,
      "workers": 8,
      "output_dir": "/data/render/gpu-render-1",
      "use_gpu": true,
      "timeout": 7200,
      "env_vars": {
        "CUDA_VISIBLE_DEVICES": "0,1"
      }
    },
    {
      "name": "cpu-render-1",
      "host": "render2.example.com",
      "port": 18888,
      "workers": 4,
      "output_dir": "/data/render/cpu-render-1",
      "use_gpu": false,
      "timeout": 3600
    }
  ],
  "notifications": [
    {
      "type": "slack",
      "endpoint": "https://hooks.slack.com/services/T00/B00/xxx"
    },
    {
      "type": "email",
      "endpoint": "ops@example.com"
    }
  ]
}
