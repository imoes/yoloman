[Desktop Entry]
Name={{ name | default('Network Configurator') }}
Comment={{ comment | default('Configure and monitor your network connections') }}
Exec={{ exec | default('dhcpcd-gtk') }}
Icon={{ icon | default('dhcpcd') }}
Terminal={{ terminal | default('false') }}
Type={{ type | default('Application') }}
Categories={{ categories | default('GTK;System;TrayIcon;') }}
X-GNOME-Autostart-enabled={{ x_gnome_autostart_enabled | default('true') }}
OnlyShowIn={{ only_show_in | default('GNOME;LXDE;MATE;XFCE;ROX;Cinnamon;') }}
