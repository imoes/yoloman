# ==============================================================================
# dhcpcd-gtk Desktop Entry Configuration
# ==============================================================================
# This template generates a .desktop file for the dhcpcd-gtk application.
# It allows customizing the command execution, icon, and visibility across
# various Desktop Environments (DEs).

# --- General Section ---

# The display name of the application shown in menus and launchers.
Name=Network Configurator

# A short description of the application's purpose.
Comment=Configure and monitor your network connections

# ==============================================================================
# exec: Command to execute when launching the application
# Default: 'dhcpcd-gtk'
# ==============================================================================
# This field specifies the exact command that the desktop environment will run
# to start dhcpcd-gtk. It is typically just the binary name if it is in PATH,
# or a full path if required.
Exec={{ exec | default('dhcpcd-gtk') }}

# Icon name or path used for the application
# Default: 'dhcpcd'
# ==============================================================================
# Specifies the icon to display in menus and launchers. This can be a theme
# icon name (e.g., 'network-wired') or a full path to an image file.
Icon={{ icon | default('dhcpcd') }}

# Indicates whether to run the application in a terminal window.
# Desktop entry standard: 'false' for GUI apps.
Terminal=false

# The type of this desktop entry. 'Application' indicates a standalone program.
Type=Application

# A semicolon-separated list of categories for the application.
# Used by desktop environments to organize entries in menus.
Categories=GTK;System;TrayIcon;

# Enables autostart for GNOME-based desktop environments.
X-GNOME-Autostart-enabled=true

# ==============================================================================
# only_show_in: Semicolon-separated list of desktop environments in which
#                this entry should be displayed
# Default: 'GNOME;LXDE;MATE;XFCE;ROX;Cinnamon'
# ==============================================================================
# This field controls the visibility of the desktop entry. If specified, the
# entry will ONLY appear in the listed desktop environments. If you want the
# entry to appear everywhere, you can omit this or set it to a wildcard.
# This is useful for GTK-specific tools that may not behave well on Qt-only
# or other non-GTK environments.
OnlyShowIn={{ only_show_in | default('GNOME;LXDE;MATE;XFCE;ROX;Cinnamon') }}