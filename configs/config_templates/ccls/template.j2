# ===========================================================================
# ccls Configuration Template
# ---------------------------------------------------------------------------
# ccls is a language server for C/C++. This file must be valid JSON.
# Each top-level key corresponds to a command-line flag of `ccls`.
#
# This template is self-documenting: every variable reference carries its
# schema default so the file renders correctly even when no extra variables
# are provided by Ansible.
# ===========================================================================

{
    # index: Root directory to index in standalone mode; corresponds to -index=<root>
    "index": "{{ (config_json | default({})).index | default('') | tojson }}",

    # init: Extra initialization options in JSON string format; corresponds to -init=<string>
    "init": "{{ (config_json | default({})).init | default('') | tojson }}",

    # log_file: Path to log file; stderr if empty. Corresponds to -log-file=<file>
    "log_file": "{{ (config_json | default({})).log_file | default('') | tojson }}",

    # log_file_append: Whether to append to log file instead of truncating; corresponds to -log-file-append
    "log_file_append": "{{ (config_json | default({})).log_file_append | default(false) | tojson }}",

    # test_index: Run index tests on given directory; corresponds to -test-index=<string>
    "test_index": "{{ (config_json | default({})).test_index | default('') | tojson }}",

    # verbosity: Verbosity level, from -3 (fatal) to 2 (verbose); corresponds to -v=<int>
    "verbosity": "{{ (config_json | default({})).verbosity | default(0) | tojson }}"
}