{
 "allow_tcp_forwarding": "no",
 "authorized_keys_file": ".ssh/authorized_keys",
 "challenge_response_authentication": "no",
 "host_keys": [
  "/etc/ssh/ssh_host_rsa_key",
  "/etc/ssh/ssh_host_ecdsa_key",
  "/etc/ssh/ssh_host_ed25519_key"
 ],
 "listen_addresses": [
  "0.0.0.0",
  "::"
 ],
 "log_level": "VERBOSE",
 "login_grace_time": "30",
 "max_auth_tries": 3,
 "max_sessions": 20,
 "password_authentication": "no",
 "permit_empty_passwords": "no",
 "permit_root_login": "no",
 "print_motd": "no",
 "pubkey_authentication": "yes",
 "sftp_groups": [
  {
   "chroot_dir": "/srv/sftp",
   "name": "sftpusers",
   "sftp_log_level": "VERBOSE"
  },
  {
   "chroot_dir": "/srv/sftp-partners",
   "name": "sftppartners",
   "sftp_log_level": ""
  }
 ],
 "sftp_subsystem": "internal-sftp",
 "sftp_users": [
  {
   "chroot_dir": "/srv/sftp-backup",
   "name": "backup-agent",
   "sftp_log_level": ""
  }
 ],
 "ssh_port": 22,
 "strict_modes": "yes",
 "syslog_facility": "AUTH",
 "use_pam": "yes",
 "x11_forwarding": "no"
}
