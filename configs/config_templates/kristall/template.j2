# Kristall Browser Configuration
# This file configures the 'kristall' cross-platform graphical small-internet client.
# Note: Kristall primarily uses a GUI settings dialog (about:settings).
# This template represents a canonical structure for its internal configuration file
# (typically found in the user's config directory), reflecting the documented settings.

[Generic]
# Start Page: The URL loaded for new tabs and windows.
StartPage = {{ start_page | default('about:favourites') }}

# Search Engine: Search engine URL template with %1 placeholder.
SearchEngine = {{ search_engine | default('gemini://geminisearch.org/search/%1') }}

# UI Theme: UI Theme: Light, Dark, or OS Default.
UITheme = {{ ui_theme | default('OS Default') }}

# UI Density: UI Density: Compact or Classic.
UIDensity = {{ ui_density | default('Classic') }}

# Max Redirections: Maximum number of redirections allowed. 0 disables redirections.
MaxRedirections = {{ max_redirections | default(5) }}

# Network Timeout: Network timeout in seconds.
NetworkTimeout = {{ network_timeout | default(30) }}

[EnabledProtocols]
# Enable Gemini protocol.
Gemini = {{ enable_gemini | default(true) }}

# Enable HTTP protocol.
HTTP = {{ enable_http | default(true) }}

# Enable Gopher protocol.
Gopher = {{ enable_gopher | default(false) }}

[Cache]
# Total cache size limit in KiB. 0 disables caching.
TotalCacheSize = {{ cache_total_size | default(512) }}

# Max size of a single cached item in KiB.
CachedItemSizeThreshold = {{ cache_item_size_threshold | default(400) }}

# Cached item life in minutes. -1 for unlimited item life.
CachedItemLife = {{ cache_item_life | default(-1) }}

[Display]
# Toggle rendering of emojis.
RenderEmojis = {{ render_emojis | default(true) }}

# Text rendering mode: Fancy or Always plain text.
TextRendering = {{ text_rendering | default('Fancy') }}

# Use typographer's quotes.
UseTypographersQuotes = {{ use_typographers_quotes | default(false) }}

# Handling of ANSI escape sequences: Ignore, Interpret (preformatted text only), Strip.
AnsiEscapeSequences = {{ ansi_escape_sequences | default('Ignore') }}

# Enable text highlights (bold/underline) in gemtext.
EnableTextHighlights = {{ enable_text_highlights | default(true) }}

# Gopher map display style: Iconized or Textual.
GopherMapStyle = {{ gopher_map_style | default('Iconized') }}

# Show hidden files in local file:// directories.
ShowHiddenFiles = {{ show_hidden_files | default(false) }}

# Strip <nav> tags from HTML pages.
StripNavFromHTML = {{ strip_nav_from_html | default(false) }}

[Style]
# Default font family for standard text.
StandardFont = {{ standard_font | default('Sans Serif') }}

# Background color in hex format.
BackgroundColor = {{ background_color | default('#ffffff') }}

# Indent size in pixels.
IndentSize = {{ indent_size | default(15) }}

[TrustGemini]
# Gemini trust level: TOFU, Everything, or Manual.
TrustLevel = {{ trust_level_gemini | default('TOFU') }}

# Use local certificate authorities for Gemini.
UseLocalCAs = {{ use_local_cas_gemini | default(true) }}

[TrustHTTPS]
# HTTPS trust level: TOFU, Everything, or Manual.
TrustLevel = {{ trust_level_https | default('TOFU') }}

# Use local certificate authorities for HTTPS.
UseLocalCAs = {{ use_local_cas_https | default(true) }}