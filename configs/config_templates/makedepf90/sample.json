{
  "help": false,
  "version": false,
  "warnings": true,
  "warn_confused": false,
  "format_string": "%f.o",
  "ignore_modules": [],
  "depend_on_file": null,
  "default_rule": "\t$(FC) -c $(FFLAGS) $<",
  "special_rules": [
    {
      "pattern": "*.f",
      "rule": "\tcoco $*; $(FC) -c $(FFLAGS) $*.f90"
    }
  ],
  "fixed_format": false,
  "free_format": false,
  "executable_output": "myprogram",
  "link_rule": "$(FC) -o $@ $(FFLAGS) $(LDFLAGS) $(FOBJ) $(LIBS)",
  "use_coco": false,
  "defines": [],
  "objects_in_path": null,
  "objects_same_structure_path": null,
  "include_paths": [
    "/usr/include/fortran",
    "/opt/lib/include"
  ],
  "nosrc": false
}
