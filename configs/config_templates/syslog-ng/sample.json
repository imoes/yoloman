{
  "options": {
    "long_hostnames": false,
    "flush_lines": 100,
    "time_reopen": 10,
    "use_dns": true,
    "use_fqdn": true,
    "add_host_name": "yes",
    "use_time_recvd": false,
    "perm": "0640",
    "dir_perm": "0755",
    "owner": "syslog",
    "group": "adm"
  },
  "sources": [
    {
      "name": "src_syslog",
      "type": "syslog",
      "ip": "0.0.0.0",
      "port": 514,
      "flags": [
        "no-parse",
        "validate-utf8"
      ]
    },
    {
      "name": "src_file",
      "type": "file",
      "path": "/var/log/messages",
      "flags": [
        "no-parse"
      ]
    },
    {
      "name": "src_local",
      "type": "unix-stream",
      "path": "/dev/log"
    }
  ],
  "destinations": [
    {
      "name": "dst_file",
      "type": "file",
      "path": "/var/log/syslog-ng/messages.log",
      "owner": "syslog",
      "group": "adm",
      "template": "${ISODATE} ${HOST} ${MSGHDR}${MSG}\n"
    },
    {
      "name": "dst_remote",
      "type": "tcp",
      "ip": "192.168.1.100",
      "port": 6514,
      "transport": "tls",
      "template": "${ISODATE} ${HOST} ${MSGHDR}${MSG}\n"
    }
  ],
  "logs": [
    {
      "name": "all_messages",
      "source": "src_syslog",
      "destination": "dst_file"
    },
    {
      "name": "messages_with_errors",
      "source": "src_local",
      "destination": "dst_file",
      "filters": [
        {
          "name": "f_errors",
          "expr": "match(\"error|fail|critical\" value(\"MESSAGE\"))"
        }
      ]
    }
  ],
  "config_fragments": [
    "/etc/syslog-ng/conf.d/ssl.conf",
    "/etc/syslog-ng/conf.d/custom-rules.conf"
  ]
}
