# Default configuration for nullidentd (RFC 1413 IDENT protocol daemon)
# Listen on this IP address (use 0.0.0.0 for all interfaces)
# Set to empty string to disable explicit binding and use system default
HOST="{{ host }}"

# Listen on this port (113 is the standard IDENT port)
PORT="{{ port }}"

# Run as this user (typically 'nobody' for security)
USER="{{ user }}"

# Maximum number of connections (0 = no limit)
MAXCONN="{{ maxconn }}"

# Log to syslog? Set to 'yes' to enable, 'no' to disable
LOG_TO_SYSLOG="{{ log_to_syslog }}"

# Optional: respond with static identity string (if empty, returns 'UNKNOWN')
STATIC_ID="{{ static_id }}"

# Optional: respond with static username (if empty, uses system username if available)
STATIC_USER="{{ static_user }}"

# Optional: deny connections from these IP subnets (comma-separated, e.g., '127.0.0.1/8,10.0.0.0/8')
DENY_FROM="{{ deny_from | default('') }}"

# Optional: allow only these IP subnets (comma-separated); if empty, all are allowed unless denied
ALLOW_ONLY="{{ allow_only | default('') }}"

# Optional: respond to IDENT queries with custom format
# Available placeholders: {remote_ip}, {local_ip}, {remote_port}, {local_port}, {user}, {system_user}
RESPONSE_FORMAT="{{ response_format }}"