# default: off
# description:	Minimal identd server implementing the auth protocol (RFC 1413).
# need to set a user
service auth
{
	disable		= {{ disable }}
	flags		= NODELAY
	socket_type	= stream
	protocol	= tcp
	wait		= no
	server		= /usr/sbin/nullidentd
	server_args	= {{ server_args_user }}
	user		= {{ user }}
}
