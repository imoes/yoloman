{#
  sauce (Spam Awareness and User Communication Engine)
  
  This package handles the automated generation and delivery of
  "blacklist notification" messages to users whose addresses were
  forged by spammers. It is primarily a text-generation and mail-sending
  subsystem.
  
  Configuration focuses on the administrative contact address that
  bypasses the blacklist for legitimate communication, and the sender
  identity used in the notifications.
#}

# Administrative local-part. Default: 'sauce-admin'
# This variable holds the user part of the admin email address.
admin_local_part = {{ admin_address | default('sauce-admin') }}

# Mail domain for local-parts. Default: 'localhost'
# This variable holds the domain part of the email addresses.
mail_domain = {{ mail_domain | default('localhost') }}

# Full admin address constructed from parts.
# Combines admin_local_part and mail_domain.
admin_address = {{ admin_address | default('sauce-admin') }}@{{ mail_domain | default('localhost') }}

# The sender local-part used for the blacklist notification emails.
# This is the address that gets blacklisted if it is a "spambait" address.
# Schema default: 'sauce-daemon'
sender_local_part = {{ sender_address | default('sauce-daemon') }}

# Full sender address constructed from parts.
# Combines sender_local_part and mail_domain.
sender_address = {{ sender_address | default('sauce-daemon') }}@{{ mail_domain | default('localhost') }}

# Path to the FAQ template or text block embedded in notifications.
# If empty or omitted, a default built-in FAQ is used.
# Schema default: '' (empty string)
faq_file = {{ faq_file | default('') }}

# Maximum age of a blacklist entry in seconds before automatic expiry.
# Schema default: 86400 (24 hours)
blacklist_ttl = {{ blacklist_ttl | default(86400) }}
