# =============================================================================
# sauce Log Rotation Configuration (logrotate-style)
# This file defines how the 'sauce' application rotates its log files.
# It manages two distinct logging contexts:
# 1. General operational logs (dbreasons, notice, error, reject, fatal)
# 2. Debug logs (debug)
# =============================================================================

# ------------------------------------------------------------------------------
# General Sauce Logs
# Applies to: dbreasons.log, notice.log, error.log, reject.log, fatal.log
# ------------------------------------------------------------------------------

/var/log/sauce/dbreasons.log
/var/log/sauce/notice.log
/var/log/sauce/error.log
/var/log/sauce/reject.log
/var/log/sauce/fatal.log {
    # Number of rotated log files to keep for general sauce logs.
    rotate {{ log_rotate_count | default(7) }}

    # Permissions, owner, and group for newly created log files.
    # Mode 0644 is standard for general logs to allow reading by specific groups if needed,
    # though the default template specifies 'mail mail'.
    create 0644 {{ log_owner | default('mail') }} {{ log_group | default('mail') }}

    # Frequency of log rotation for general sauce logs (dbreasons, notice, error, reject, fatal).
    {{ log_rotation_period | default('weekly') }}

    # If the log file is missing, don't throw an error.
    missingok

    # Compress rotated log files.
    compress

    # Action to perform after rotation.
    lastaction
        # Reopen log files via sauceadmin if the command exists.
        if test -x /usr/sbin/sauceadmin; then
            sauceadmin reopenlogs
        fi
    endscript
}

# ------------------------------------------------------------------------------
# Debug Sauce Logs
# Applies to: debug.log
# ------------------------------------------------------------------------------

/var/log/sauce/debug.log {
    # Number of rotated log files to keep for debug logs.
    # Inherits the general count setting.
    rotate {{ log_rotate_count | default(7) }}

    # Permissions, owner, and group for the debug.log file.
    # More restrictive permissions (0640) are applied here via debug_log_perms.
    create {{ debug_log_perms | default('0640') }} {{ log_owner | default('mail') }} {{ log_group | default('mail') }}

    # Frequency of log rotation for debug.log.
    # Typically more frequent than general logs (daily).
    {{ debug_log_rotation_period | default('daily') }}

    # If the log file is missing, don't throw an error.
    missingok

    # Compress rotated log files.
    compress

    # Action to perform after rotation.
    lastaction
        # Reopen log files via sauceadmin if the command exists.
        if test -x /usr/sbin/sauceadmin; then
            sauceadmin reopenlogs
        fi
    endscript
}