#!/bin/sh -e

# Tripwire Integrity Checker Initialization Script
# This script is generated by Ansible to configure and invoke Tripwire.
# It sets up the environment and runs the integrity check with the configured reporting options.

# Path to the Tripwire binary
tripwire=/usr/sbin/tripwire

# Ensure the binary exists and is executable before proceeding
[ -x $tripwire ] || exit 0

# Set strict umask to ensure key files and logs are not world-readable
umask 027

# Run the integrity check with the following configuration:
# --check: Perform the file integrity check.
# --quiet: Suppress standard output, rely on reports/emails.
# --email-report: Enable email reporting of results.
# --email-to: Recipients from {{ email_recipients | default(['root@localhost']) }}
# --email-level: Detail level from {{ email_report_level | default(3) }}

$tripwire \
    --check \
    --quiet \
    --email-report \
    --email-to {{ email_recipients | default(['root@localhost']) | join(', ') }} \
    --email-level {{ email_report_level | default(3) }}