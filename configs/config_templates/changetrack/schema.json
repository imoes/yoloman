{
  "tracked_files": {
    "type": "list",
    "default": [
      "#/boot/grub/menu.lst",
      "#/etc/aliases",
      "#/etc/apt/preferences",
      "#/etc/default/*",
      "#/etc/fetchmailrc",
      "#/etc/hosts",
      "#/etc/lprfilter",
      "#/etc/modprobe.d/blacklist",
      "#/etc/network/*",
      "#/etc/news/leafnode/config",
      "#/etc/pam.d/*",
      "#/etc/printcap",
      "#/etc/samba/smb.conf",
      "#/etc/snort/snort.debian.conf",
      "#/etc/squid/squid.conf",
      "#/etc/ssh/sshd_config",
      "#/etc/sudoers",
      "#/root/.bash*",
      "#/root/.profile"
    ],
    "description": "List of files/directories to track with optional email recipients (commented out by default). Each line may include file paths with wildcards, optionally followed by ':' and email addresses."
  }
}
