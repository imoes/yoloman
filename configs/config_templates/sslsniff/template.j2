# sslsniff configuration template
# Self-documenting: every directive is preceded by its schema description and safe defaults.

# Mode of operation: 'authority' or 'targeted'.
# 'authority' uses cert_source as a CA keypair; 'targeted' uses cert_source as a directory of certs.
mode: {{ mode | default('authority', true) }}

# Path to CA cert/key file or directory containing certificates.
# Used as the source of truth for interception certificates depending on 'mode'.
cert_source: {{ cert_source | default('/usr/share/sslsniff/certs/wildcard', true) }}

# Port to listen on for SSL interception.
# Traffic sent to this port will be intercepted and decrypted.
ssl_port: {{ ssl_port | default(4433, true) }}

# File to log activity to.
# Logs interception events, browser fingerprints, and errors.
log_file: {{ log_file | default('/tmp/sslsniff.log', true) }}

# Location of any Firefox XML update files.
# Optional. If provided, sslsniff can intercept/modify Firefox update checks.
firefox_update_location: {{ firefox_update_location | default('', true) }}

# Location of any intermediary certificates.
# Optional. Path to a file or directory containing intermediate CA certs to inject into the chain.
intermediary_certificates: {{ intermediary_certificates | default('', true) }}

# Port to listen on for HTTP interception. Set to 0 to disable.
# If enabled, plain HTTP traffic can also be fingerprinted or intercepted.
# A value of 0 effectively turns this feature off.
http_port: {{ http_port | default(0, true) }}

# Comma-separated list of browsers to intercept (ff,ie,safari,opera).
# Restricts interception logic to specific browser user-agents or fingerprints.
# Empty string means all supported browsers.
intercept_browsers: {{ intercept_browsers | default('', true) }}

# Deny OCSP requests for our certificates.
# If true, sslsniff will block outgoing OCSP stapling/requests to prevent clients from validating the
# interception certificate against the original CA, forcing reliance on trust or self-signed status.
ocsp_deny: {{ ocsp_deny | default(False, true) | lower }}

# Only log HTTP POSTs.
# If true, reduces log verbosity by recording only POST requests instead of all HTTP traffic.
log_only_post: {{ log_only_post | default(False, true) | lower }}

# URL to intercept Mozilla Addon Updates.
# Optional. If specified, sslsniff will intercept requests to this URL to inject a modified addon.
intercept_addon_update: {{ intercept_addon_update | default('', true) }}

# The sha256sum value of the addon to inject.
# Used in conjunction with intercept_addon_update to ensure the injected addon matches the expected hash.
# This helps in verifying the integrity of the injected payload.
addon_sha256: {{ addon_sha256 | default('', true) }}