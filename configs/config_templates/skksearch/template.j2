# SKK Dictionary Configuration Template
# This file configures the paths to SKK (Simple Kankaku Henkan) dictionary files.
# SKK is a Japanese input method tool. The compiled dictionary (CDB) is used for fast lookup,
# while plain text dictionaries can be added for additional vocabulary.

# Path to the compiled SKK dictionary CDB file.
# The CDB (Coincidence Database) format provides efficient hash-based lookups.
cdb:{{ skk_cdb_path | default('/usr/share/skk/SKK-JISYO.cdb') }}

# Path to the plain text SKK dictionary file.
# Plain text dictionaries are loaded in addition to the CDB file.
# Multiple plain dictionaries can be specified in the 'skk_plain_path' variable as a list.
# This block generates a directive for each path in the list.
# If skk_plain_path is a string, it is treated as a single path.
{% set plain_paths = skk_plain_path | default('/usr/share/skk/SKK-JISYO') %}
{% if plain_paths is string %}
#plain:{{ plain_paths }}
{% elif plain_paths is iterable %}
{% for path in plain_paths %}
#plain:{{ path }}
{% endfor %}
{% endif %}

# Additional SKK Dictionary Extras
