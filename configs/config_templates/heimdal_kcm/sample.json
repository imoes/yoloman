{
  "verbose": false,
  "pidfile": "/var/run/heimdal-kcm/kcm.pid",
  "socket_path": "/var/run/heimdal-kcm/kcm.sock",
  "max_connections": 128,
  "worker_threads": 8,
  "default_realm": "ATHENA.MIT.EDU",
  "dns_lookup_realm": true,
  "dns_lookup_kdc": true,
  "kdc_list": [
    "kdc1.athena.mit.edu",
    "kdc2.athena.mit.edu:88"
  ],
  "kadmin_list": [
    "kdc1.athena.mit.edu:749"
  ],
  "tcp_hint_kdc": true,
  "max_ticket_lifetime": 43200,
  "max_renewable_lifetime": 604800,
  "clockskew": 300,
  "logging_destination": "SYSLOG",
  "logging_file": "/var/log/heimdal-kcm.log",
  "logging_level": 2,
  "db_type": "none",
  "sql_conn_str": "sqlite:///var/lib/heimdal-kcm/kcm.db",
  "sql_schema_version": 1,
  "mutual_auth_required": false,
  "enforce_preauth": true,
  "validate_pac": true
}
