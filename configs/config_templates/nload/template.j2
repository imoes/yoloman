# System-wide configuration file for nload
# /etc/nload.conf

{# Length in seconds of the time window for average calculation. #}
auto_scale_period={{ auto_scale_period | default(300) }}

{# Maximum scaling for incoming bandwidth graph in kBit/s. #}
in_max_scaling={{ in_max_scaling | default(10240) }}

{# Maximum scaling for outgoing bandwidth graph in kBit/s. #}
out_max_scaling={{ out_max_scaling | default(10240) }}

{# Refresh interval of the display in milliseconds. #}
refresh_interval={{ refresh_interval | default(500) }}

{# Unit type for traffic numbers display.
   Options: h (human readable), b (Bit/s), k (kBit/s), m (MBit/s), g (GBit/s).
   Upper case letters mean Bytes instead of Bits. #}
traffic_unit={{ traffic_unit | default('k') }}

{# Unit type for total amount of data display.
   Options: h, H, b, B, k, K, m, M, g, G. #}
traffic_data_unit={{ traffic_data_unit | default('M') }}

{# Comma-separated list of network devices to monitor.
   Default is all auto-detected devices.
   Example: eth0,wlp1s0 #}
devices="{{ devices | default([]) | join(',') }}"