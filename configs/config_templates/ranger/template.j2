# =============================================================================
# Ranger configuration template (rc.conf)
# This template generates the user configuration file for the Ranger file manager.
# It is self-documenting: every configurable option is commented with its
# schema description and has a safe default value.
# =============================================================================

# --- Display & Sorting Options ---

# The sorting mechanism to use for file lists.
# Valid values include: atime, basename, ctime, extension, mtime, natural, type, size, random.
set sort {{ sort_method | default('basename') }}

# Whether to show hidden files (files starting with a dot) in the file list.
set show_hidden {{ show_hidden | default(False) }}

# Whether to use an external script (preview_script) for generating file previews.
set use_preview_script {{ use_preview_script | default(True) }}

# The name of the colorscheme to use.
# Built-in options include default, jungle, snow.
set colorscheme {{ colorscheme | default('default') }}

# The default linemode for displaying files.
# Options include filename, fileinfo, mtime, humanreadablemtime, sizemtime, humanreadablesizemtime.
set default_linemode {{ default_linemode | default('permissions') }}

# --- Key Mappings ---

# Key to open the editor command
map E edit %f

# Key to reload the current directory
map <C-r> reload

# Key to quit ranger
map q quit

# Key to open a shell in the current directory
map S shell $SHELL

# Key to delete marked files
map d delete

# Key to copy marked files
map y copy

# Key to cut marked files
map dd cut

# Key to paste files
map p paste

# Key to mark all files in current directory
map v mark *