  <!-- Alias block: Droid Sans primary family -->
  <alias binding="same">
    <!-- Family name in the first alias block -->
    <family>{{ droid_sans_alias_family | default('Droid Sans') }}</family>
    <accept>
      <!-- First accepted family in the Droid Sans alias accept list -->
      <family>{{ droid_sans_arabic_alias | default('Droid Sans Arabic') }}</family>
      <!-- Second accepted family in the Droid Sans alias accept list -->
      <family>{{ noto_sans_alias | default('Noto Sans') }}</family>
      <!-- Third accepted family in the Droid Sans alias accept list -->
      <family>{{ open_sans_alias | default('Open Sans') }}</family>
      <!-- Fourth accepted family in the Droid Sans alias accept list -->
      <family>{{ sans_serif_alias | default('sans-serif') }}</family>
    </accept>
  </alias>

  <!-- Alias block: Droid Sans Arabic -->
  <alias binding="same">
    <!-- Family name in the Droid Sans Arabic alias block -->
    <family>{{ droid_sans_arabic_alias_family | default('Droid Sans Arabic') }}</family>
    <accept>
      <!-- Accepted family in the Droid Sans Arabic, Noto Sans, and Open Sans alias blocks -->
      <family>{{ droid_sans_alias_accept | default('Droid Sans') }}</family>
    </accept>
  </alias>

  <!-- Alias block: Noto Sans -->
  <alias binding="same">
    <!-- Family name in the Noto Sans alias block -->
    <family>{{ noto_sans_alias_family | default('Noto Sans') }}</family>
    <accept>
      <!-- Accepted family in the Droid Sans Arabic, Noto Sans, and Open Sans alias blocks -->
      <family>{{ droid_sans_alias_accept | default('Droid Sans') }}</family>
