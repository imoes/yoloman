  </alias>

  <!-- Alias block: sans-serif preference -->
  <alias>
    <!-- Family name in the sans-serif alias block -->
    <family>{{ sans_serif_alias_family | default('sans-serif') }}</family>
    <prefer>
      <!-- Preferred family in the sans-serif alias block -->
      <family>{{ droid_sans_prefer | default('Droid Sans') }}</family>
    </prefer>
