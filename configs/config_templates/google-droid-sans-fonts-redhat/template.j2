<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- SPDX-License-Identifier: MIT -->
<fontconfig>
  <!--
    Configuration for google-droid-sans-fonts-redhat.
    This template generates a Fontconfig XML file that sets font metadata
    (fullnames, families, styles, versions) for various Droid Sans variants.
  -->

  <!-- Match Droid Sans Bold variant -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name string for Droid Sans Bold font match -->
      <string>{{ droid_sans_bold_fullname | default('Droid Sans Bold') }}</string>
    </test>
    <test name="family">
      <!-- Family name for base Droid Sans fonts -->
      <string>{{ droid_sans_family | default('Droid Sans') }}</string>
    </test>
    <test name="style">
      <!-- Style string for Droid Sans Bold -->
      <string>{{ droid_sans_bold_style | default('Bold') }}</string>
    </test>
    <edit name="fontversion">
      <!-- Font version integer for Droid Sans Bold -->
      <int>{{ droid_sans_bold_version | default(11) }}</int>
    </edit>
  </match>

