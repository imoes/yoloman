{
  "mode": true,
  "no_ssh_id": false,
  "ports": [
    80,
    443,
    3128
  ],
  "scanners": [
    "http-proxy",
    "socks5"
  ],
  "socks_proxies": [
    "10.0.0.1:1080",
    "proxy.example.com:9050"
  ],
  "exclude_file": "/var/lib/scanssh/exclude.txt",
  "exit_on_exclude_missing": true,
  "ignore_exclude_random": false,
  "targets": [
    "10.0.0.0/24",
    "random(100,12345)/192.168.1.0/24"
  ]
}
