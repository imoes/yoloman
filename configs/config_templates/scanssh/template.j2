# scanssh configuration file
# Auto-generated by Ansible Jinja2 template.
# See the schema descriptions below for each directive.

# --- Boolean Settings ---

# Set to true to operate as a proxy detector (-p).
# Default is false (standard SSH/version scan).
MODE: {{ mode | default(false) | ternary('true', 'false') }}

# Set to true to not send a SSH identification string (-I).
NO_SSH_ID: {{ no_ssh_id | default(false) | ternary('true', 'false') }}

# Exit if exclude file not found (-E).
# If true, exit if the exclude file cannot be found.
EXIT_ON_EXCLUDE_MISSING: {{ exit_on_exclude_missing | default(false) | ternary('true', 'false') }}

# Ignore excluded addresses when using random (-R).
# If true, ignore excluded addresses when addresses are generated at random.
IGNORE_EXCLUDE_RANDOM: {{ ignore_exclude_random | default(false) | ternary('true', 'false') }}

# --- List/Collection Settings ---

# List of port numbers to scan (-n).
# Default is [22].
PORTS: {{ ports | default([22]) | join(',') }}

# List of scanners to run (-s).
# Options: ssh, socks5, socks4, http-proxy, http-connect, telnet-proxy.
# Default is ['ssh'].
SCANNERS: {{ scanners | default(['ssh']) | join(',') }}

# List of SOCKS proxy host:port strings to use for scanning (-u).
# Default is empty.
SOCKS_PROXIES: {{ socks_proxies | default([]) | join(',') }}

# --- Path Settings ---

# Path to the file containing addresses to exclude from the scan (-e).
EXCLUDE_FILE: {{ exclude_file | default('/etc/scanssh/exclude') }}

# --- Target Settings ---

# List of target networks or IPs (-t implied by structure).
# Can include CIDR, single IPs, or complex expressions like 'random(n,seed)/split(s,e)/address'.
TARGETS:
{% for target in targets | default(['192.168.0.0/24']) %}
- {{ target }}
{% endfor %}