{
  "target_url": "http://10.10.10.10/admin",
  "word_list_path": "/usr/share/dirb/wordlists/big.txt",
  "max_tasks": 24,
  "output_file": "/var/log/turbosearch/results.txt",
  "extensions": [
    "html",
    "xml",
    "php",
    "txt"
  ],
  "restore": false,
  "ignore_restore": false,
  "double_path": false,
  "proxy_url": "http://127.0.0.1:8080",
  "report_proxy": "",
  "deep_search": true,
  "verbose": false,
  "full_log": false,
  "no_forward_location": false,
  "ignore_result_filter": "302",
  "find_text": [
    "Welcome",
    "Login"
  ],
  "http_method": "GET",
  "random_agent": true,
  "headers": [
    "Cookie: sessionid=abc123",
    "X-Forwarded-For: 10.10.10.10"
  ],
  "case_insensitive": true,
  "stats_db": false,
  "no_robots": false,
  "md5_search": false,
  "sha1_search": false,
  "sha256_search": false,
  "hash_upper": false,
  "no_dupcheck": false
}
