#!/usr/bin/env python3
# ==============================================================================
# Turbosearch Configuration Template
# ==============================================================================
# This file is auto-generated by Ansible. Do not edit manually.
# It configures the 'turbosearch' wordlist directory brute-forcing tool.
#
# Schema Variables:
#   target_url        : str  - The target URL to scan
#   word_list_path    : str  - Path to the word list file
#   max_tasks         : int  - Number of concurrent connections per host
#   output_file       : str  - Output file path (empty for stdout)
#   extensions        : list - List of extensions to append
#   extensions_items  : str  - Single extension item (fallback/default item)
#   restore           : bool - Restore previous session
#   ignore_restore    : bool - Ignore existing restore file
#   double_path       : bool - Search 2 path levels
#   proxy_url         : str  - Proxy URL for requests
#   report_proxy      : str  - Proxy URL for reporting only
#   deep_search       : bool - Look for URLs inside HTML
#   verbose           : bool - Verbose output
#   full_log          : bool - Print full URLs
#   no_forward_location: bool - Disable Location forwarding
#   ignore_result_filter: str - Filter by code/size
#   find_text         : list - Text strings to find
#   find_text_items   : str  - Single text item (fallback/default item)
#   http_method       : str  - HTTP method (GET, POST, etc.)
#   random_agent      : bool - Random User-Agent
#   headers           : list - List of header dicts
#   headers_items     : str  - Single header item (fallback/default item)
#   case_insensitive  : bool - Case insensitive search
#   stats_db          : bool - Use SQLite stats DB
#   no_robots         : bool - Ignore robots.txt
#   md5_search        : bool - MD5 hash search
#   sha1_search       : bool - SHA1 hash search
#   sha256_search     : bool - SHA256 hash search
#   hash_upper        : bool - Uppercase hash search
#   no_dupcheck       : bool - Skip duplicate checks
# ==============================================================================

# Target URL to scan (ex: http://10.10.10.10/path)
# The base URL that turbosearch will probe.
target_url = "{{ target_url | default('http://10.10.10.10/') }}"

# Path to the word list file to be tested
# Local file path to the dictionary/wordlist used for fuzzing.
word_list_path = "{{ word_list_path | default('/usr/share/dirb/wordlists/big.txt') }}"

# Number of concurrent connections per host
# Limits parallelism to avoid overwhelming the target.
max_tasks = {{ max_tasks | default(16) }}

# Output file to save results to disk (set to None for stdout)
# If empty, results are printed to standard output.
output_file = "{{ output_file | default('') }}"

# Comma-separated extensions to append to each word (ex: html,xml,php)
# Appends extensions to each word in the wordlist.
# Uses 'extensions' list if provided, otherwise 'extensions_items'.
extensions = "{{ (extensions | default([])) | default([extensions_items | default('html')]) | join(',') }}"

# Enable restore functionality for aborted sessions
# If true, turbosearch attempts to resume a previous run.
restore = {{ restore | default(False) | lower }}

# Ignore existing restore file (skip wait time)
# If true, does not wait if a restore file exists.
ignore_restore = {{ ignore_restore | default(False) | lower }}

# Multiply payload set to search 2 path levels
# If true, searches both /path and /path/path structures.
double_path = {{ double_path | default(False) | lower }}

# Target proxy URL for requests (ex: http://127.0.0.1:8080)
# Proxy server used for all outgoing requests.
proxy_url = "{{ proxy_url | default('') }}"

# Target proxy URL to report only successful requests
# Optional separate proxy for reporting.
report_proxy = "{{ report_proxy | default('') }}"

# Deep search: Look for URLs inside HTML results
# If true, extracts links from HTML responses to follow.
deep_search = {{ deep_search | default(False) | lower }}

# Verbose output mode
# If true, prints detailed logs and commands.
verbose = {{ verbose | default(False) | lower }}

# Print full requested URLs in logs
# If true, logs the complete URL for every request.
full_log = {{ full_log | default(False) | lower }}

# Disable forward to Location response address
# If true, ignores HTTP 3xx Location headers.
no_forward_location = {{ no_forward_location | default(False) | lower }}

# Ignore results by result code or/and size (ex: 302 or 302:172 or 405,302:172)
# Filters out responses matching these criteria.
ignore_result_filter = "{{ ignore_result_filter | default('') }}"

# Text to find in content or header (comma-separated values)
# Only reports responses containing these text strings.
find_text = "{{ (find_text | default([])) | default([find_text_items | default('error')]) | join(',') }}"

# HTTP method to use (GET, POST, PUT, PATCH, HEAD, OPTIONS, or all)
http_method = "{{ http_method | default('GET') }}"

# Use randomly selected HTTP User-Agent header
# If true, rotates User-Agent strings per request.
random_agent = {{ random_agent | default(False) | lower }}

# JSON-formatted header key/value pairs (stored as list of dicts)
# Custom headers to include in requests.
# Iterates over the 'headers' list, formatting each dict entry.
# If headers is empty, defaults to headers_items.
{% set hdr_list = headers | default([]) %}
{% if hdr_list is not none and hdr_list | length > 0 %}
{% for hdr in hdr_list %}
# Header Entry: {{ hdr | default({}) }}
{% endfor %}
custom_headers = {{ hdr_list | tojson }}
{% else %}
# No custom headers defined (using default item)
custom_headers = {{ [headers_items | default('Key: Value')] | tojson }}
{% endif %}

# Case insensitive search: put all wordlist in lower case
# If true, converts wordlist entries to lowercase before testing.
case_insensitive = {{ case_insensitive | default(False) | lower }}

# Save reported URI at SQLite local database called stats.db
# If true, persists results to stats.db for later analysis.
stats_db = {{ stats_db | default(False) | lower }}

# Not look for robots.txt
# If true, skips checking and respecting robots.txt.
no_robots = {{ no_robots | default(False) | lower }}

# Search for a MD5 Hash version of each word
# If true, also appends MD5(word) to requests.
md5_search = {{ md5_search | default(False) | lower }}

# Search for a SHA1 Hash version of each word
# If true, also appends SHA1(word) to requests.
sha1_search = {{ sha1_search | default(False) | lower }}

# Search for a SHA256 Hash version of each word
# If true, also appends SHA256(word) to requests.
sha256_search = {{ sha256_search | default(False) | lower }}

# In case of Hash Search be enabled, also search by Uppercase of Hash Hex Text
# If true, uses uppercase hex representation for hash searches.
hash_upper = {{ hash_upper | default(False) | lower }}

# Do not check duplicate words in wordlist
# If true, skips deduplication of the wordlist.
no_dupcheck = {{ no_dupcheck | default(False) | lower }}