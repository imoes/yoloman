# Configuration for PMDA-Mounts (Performance Co-Pilot metrics agent for mount points).
# Specifies the list of mount points that the agent should monitor.
# If a mount point listed here is not present on the system, the agent may report errors
# or skip it depending on configuration.
#
# Schema Field: mounts
# Description: List of mount points to monitor.
# Default: ['/']
#
{% set mounts_list = mounts | default(['/']) %}
{% for mount in mounts_list %}
{{ mount | trim }}
{% endfor %}