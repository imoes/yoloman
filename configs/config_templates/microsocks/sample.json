{
  "bind_addr": "0.0.0.0",
  "port": 1080,
  "threads": 4,
  "loglevel": 2,
  "pidfile": "/run/microsocks/microsocks.pid",
  "udp_enabled": false,
  "authmode": "userpass",
  "users": [
    {
      "username": "proxyuser",
      "password": "secretpass123"
    },
    {
      "username": "readonly",
      "password": "readonlypass"
    }
  ],
  "user_rules": [
    {
      "user": "proxyuser",
      "destinations": [
        "*",
        "10.0.0.0/8",
        "192.168.0.0/16:443"
      ]
    },
    {
      "user": "readonly",
      "destinations": [
        "*.internal.example.com",
        "api.example.com:443"
      ]
    }
  ],
  "chroot": "/var/empty",
  "user_after_bind": "microsocks"
}
