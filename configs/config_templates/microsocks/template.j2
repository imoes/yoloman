# Listen on this IP address (0.0.0.0 for all interfaces)
bind_addr {{ bind_addr }}

# Listen on this port
port {{ port }}

# Number of worker threads (0 = auto-detect CPU count)
threads {{ threads }}

# Log level: 0=quiet, 1=errors, 2=warnings, 3=info, 4=debug
loglevel {{ loglevel }}

# Path to PID file (leave empty to disable PID file)
pidfile {{ pidfile }}

# Enable UDP relay (requires -u support in microsocks build)
{% if udp_enabled %}
udp
{% endif %}

# Require authentication: none, userpass, or both (comma-separated: none,userpass)
authmode {{ authmode }}

# List of allowed username:password pairs (only if authmode includes userpass)
{% for user in users %}
user {{ user.username }}:{{ user.password }}
{% endfor %}

# Per-user allowed destination hosts (host or host:port, one per line)
# Format: user: allowed_host1 allowed_host2 ...
{% for rule in user_rules %}
rule {{ rule.user }}: {{ rule.destinations | join(' ') }}
{% endfor %}

# Chroot directory (empty to disable chroot)
chroot {{ chroot }}

# Drop privileges to this user after binding ports
user {{ user_after_bind }}
