{
  "out_file": {
    "type": "string",
    "default": "",
    "description": "Path to write output instead of stdout"
  },
  "scatter": {
    "type": "bool",
    "default": false,
    "description": "Run scatter read test"
  },
  "scatter_order": {
    "type": "number",
    "default": 0,
    "description": "Scatter across 2^N blocks (N = scatter_order)"
  },
  "scatter_span": {
    "type": "number",
    "default": 0,
    "description": "Span each write across N blocks"
  },
  "find_fat": {
    "type": "bool",
    "default": false,
    "description": "Analyse first few erase blocks (FAT)"
  },
  "fat_nr": {
    "type": "number",
    "default": 6,
    "description": "Look through first N erase blocks"
  },
  "open_au": {
    "type": "bool",
    "default": false,
    "description": "Find number of open erase blocks"
  },
  "open_au_nr": {
    "type": "number",
    "default": 0,
    "description": "Try N open erase blocks"
  },
  "offset": {
    "type": "number",
    "default": 0,
    "description": "Start at position N (bytes)"
  },
  "random": {
    "type": "bool",
    "default": false,
    "description": "Use pseudorandom access with erase block granularity"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Increase verbosity of output"
  },
  "count": {
    "type": "number",
    "default": 8,
    "description": "Run each test N times"
  },
  "blocksize": {
    "type": "number",
    "default": 16384,
    "description": "Use a blocksize of N bytes (default 16K)"
  },
  "erasesize": {
    "type": "number",
    "default": 4194304,
    "description": "Use an erasesize of N bytes (default 4M)"
  },
  "device": {
    "type": "string",
    "default": "",
    "description": "Device path (e.g., /dev/mmcblk0p1)"
  }
}
