# This file configures the MariaDB/MySQL server to load the Spider storage engine plugin.
# The Spider engine allows database sharding and partitioning across multiple MariaDB/MySQL servers.
# See the MariaDB documentation for details on configuring and using the Spider engine.

[mariadb]
# The Spider storage engine plugin to load.
# This directive specifies the shared library file (or full path) of the Spider plugin.
# Default is 'ha_spider.so', which is usually found in the server's plugin directory.
# If the plugin is already built-in or loaded via other means, this can be left empty or removed.
plugin-load-add = {{ plugin_load_add | default('ha_spider.so') }}