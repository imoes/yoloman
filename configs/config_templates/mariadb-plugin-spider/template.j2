# MariaDB Spider Storage Engine Plugin Configuration
# This template configures the MariaDB server to load the Spider storage engine,
# enabling distributed database capabilities across multiple MariaDB instances.

[mariadb]
# plugin_load_add: The Spider storage engine plugin to load.
# Default is 'ha_spider.so'. Ensure this file exists in the MariaDB plugin directory
# (usually /usr/lib64/mysql/plugin or /usr/lib/mysql/plugin) on the target host.
plugin-load-add={{ plugin_load_add | default('ha_spider.so') }}
