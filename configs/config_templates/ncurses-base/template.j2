# ncurses-base configuration: terminfo search directories.
# This file defines the fallback paths for terminal capability database files.
# Search order enforced by ncurses:
#   1. ${HOME}/.terminfo (user-specific)
#   2. {{ etc_terminfo_dir | default('/etc/terminfo') }} (system-local)
#   3. {{ lib_terminfo_dir | default('/lib/terminfo') }} (library-level)
#   4. {{ usr_share_terminfo_dir | default('/usr/share/terminfo') }} (user-level/fallback)
#
# NOTE: The search order is fixed by ncurses and cannot be reordered.
# These variables only control *where* each stage of the lookup lives on disk.

# === etc_terminfo_dir ===
# The path to the system-local terminfo directory searched after user's home terminfo.
# Type: string | Default: /etc/terminfo
{{ etc_terminfo_dir | default('/etc/terminfo') }}

# === lib_terminfo_dir ===
# The path to the library-level terminfo directory searched after the etc terminfo directory.
# Type: string | Default: /lib/terminfo
{{ lib_terminfo_dir | default('/lib/terminfo') }}

# === usr_share_terminfo_dir ===
# The path to the user-level terminfo directory searched last.
# Type: string | Default: /usr/share/terminfo
{{ usr_share_terminfo_dir | default('/usr/share/terminfo') }}