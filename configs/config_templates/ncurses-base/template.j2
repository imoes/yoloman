# This directory is for system-local terminfo descriptions.
#
# ncurses searches terminfo directories in the following order:
# 1. ${HOME}/.terminfo (user-level, checked first)
# 2. {{ etc_terminfo_dir | default('/etc/terminfo') }} (system-local, checked second)
# 3. {{ lib_terminfo_dir | default('/lib/terminfo') }} (library-level, checked third)
# 4. {{ usr_share_terminfo_dir | default('/usr/share/terminfo') }} (user-level, checked last)

# Path to the system-local terminfo directory.
# This is the primary location for system-wide terminal definitions
# that are not part of the base library installation.
etc_terminfo_dir = {{ etc_terminfo_dir | default('/etc/terminfo') }}

# Path to the library-level terminfo directory.
# This location is used as a fallback for terminal definitions
# included with the ncurses library package.
lib_terminfo_dir = {{ lib_terminfo_dir | default('/lib/terminfo') }}

# Path to the user-level terminfo directory.
# This is the final fallback location in the search path,
# typically containing terminal definitions from the package manager.
usr_share_terminfo_dir = {{ usr_share_terminfo_dir | default('/usr/share/terminfo') }}
