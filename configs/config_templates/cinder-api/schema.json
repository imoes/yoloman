{
  "service_name": {
    "type": "string",
    "default": "cinder-api",
    "description": "The service name used for init script and process identification"
  },
  "service_description": {
    "type": "string",
    "default": "OpenStack Cinder Api",
    "description": "Human-readable description of the service"
  },
  "project_name": {
    "type": "string",
    "default": "cinder",
    "description": "The OpenStack project (service) name"
  },
  "uwsgi_port": {
    "type": "number",
    "default": 8776,
    "description": "Port on which the uWSGI server listens"
  }
}
