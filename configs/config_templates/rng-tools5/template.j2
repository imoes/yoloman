# rng-tools5 (rngd) configuration template
# This package provides hardware random number generation support by feeding
# entropy from hardware sources into the Linux kernel's random pool (/dev/random).
# It is a leaf service with no network configuration, users, or databases.
# No external services are provided or required.

### BEGIN INIT INFO
# Provides:          rngd
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: entropy gathering daemon (rngd)
# Description:       increase entropy available to /dev/random
### END INIT INFO

# Author: Michael Stone <mstone@debian.org>

DESC="entropy gathering daemon (rngd)"
DAEMON=/usr/sbin/rngd

if [ true != "$INIT_D_SCRIPT_SOURCED" ] ; then
    set "$0" "$@"; INIT_D_SCRIPT_SOURCED=true . /lib/init/init-d-script
fi