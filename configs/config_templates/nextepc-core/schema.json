{
  "db_uri": {
    "type": "string",
    "default": "mongodb://localhost/nextepc",
    "description": "MongoDB connection URI for NextEPC database."
  },
  "logger_file": {
    "type": "string",
    "default": "/var/log/nextepc/nextepc.log",
    "description": "Path to the log file."
  },
  "logger_trace_app": {
    "type": "number",
    "default": 1,
    "description": "Trace level for application logs."
  },
  "logger_trace_s1ap": {
    "type": "number",
    "default": 1,
    "description": "Trace level for S1AP logs."
  },
  "logger_trace_nas": {
    "type": "number",
    "default": 1,
    "description": "Trace level for NAS logs."
  },
  "logger_trace_diameter": {
    "type": "number",
    "default": 1,
    "description": "Trace level for Diameter logs."
  },
  "logger_trace_gtpv2": {
    "type": "number",
    "default": 1,
    "description": "Trace level for GTPv2 logs."
  },
  "logger_trace_gtp": {
    "type": "number",
    "default": 1,
    "description": "Trace level for GTP logs."
  },
  "parameter_no_ipv6": {
    "type": "bool",
    "default": true,
    "description": "Disable use of IPv6 addresses (only IPv4)."
  },
  "mme_freeDiameter": {
    "type": "string",
    "default": "mme.conf",
    "description": "FreeDiameter configuration file for MME."
  },
  "gummei_plmn_id_mcc": {
    "type": "string",
    "default": "001",
    "description": "Mobile Country Code for GUMMEI."
  },
  "gummei_plmn_id_mnc": {
    "type": "string",
    "default": "01",
    "description": "Mobile Network Code for GUMMEI."
  },
  "gummei_mme_gid": {
    "type": "number",
    "default": 2,
    "description": "MME Group ID."
  },
  "gummei_mme_code": {
    "type": "number",
    "default": 1,
    "description": "MME Code."
  },
  "tai_plmn_id_mcc": {
    "type": "string",
    "default": "001",
    "description": "Mobile Country Code for TAI."
  },
  "tai_plmn_id_mnc": {
    "type": "string",
    "default": "01",
    "description": "Mobile Network Code for TAI."
  },
  "tai_tac": {
    "type": "number",
    "default": 12345,
    "description": "Tracking Area Code."
  },
  "security_integrity_order": {
    "type": "list",
    "default": [
      "EIA1",
      "EIA2",
      "EIA0"
    ],
    "description": "Order of integrity protection algorithms."
  },
  "security_ciphering_order": {
    "type": "list",
    "default": [
      "EEA0",
      "EEA1",
      "EEA2"
    ],
    "description": "Order of ciphering algorithms."
  },
  "network_name_full": {
    "type": "string",
    "default": "NextEPC",
    "description": "Full name of the network."
  },
  "hss_freeDiameter": {
    "type": "string",
    "default": "hss.conf",
    "description": "FreeDiameter configuration file for HSS."
  },
  "sgw_gtpc_addr": {
    "type": "string",
    "default": "127.0.0.2",
    "description": "SGW GTP-C address."
  },
  "pgw_freeDiameter": {
    "type": "string",
    "default": "pgw.conf",
    "description": "FreeDiameter configuration file for PGW."
  },
  "pgw_gtpc_addr_0": {
    "type": "string",
    "default": "127.0.0.3",
    "description": "PGW GTP-C address 0."
  },
  "pgw_gtpc_addr_1": {
    "type": "string",
    "default": "::1",
    "description": "PGW GTP-C address 1."
  },
  "pgw_gtpu_addr_0": {
    "type": "string",
    "default": "127.0.0.3",
    "description": "PGW GTP-U address 0."
  },
  "pgw_gtpu_addr_1": {
    "type": "string",
    "default": "::1",
    "description": "PGW GTP-U address 1."
  },
  "ue_pool_0_addr": {
    "type": "string",
    "default": "45.45.0.1/16",
    "description": "UE Pool address 0."
  },
  "ue_pool_1_addr": {
    "type": "string",
    "default": "cafe::1/64",
    "description": "UE Pool address 1."
  },
  "dns_0": {
    "type": "string",
    "default": "8.8.8.8",
    "description": "DNS server 0."
  },
  "dns_1": {
    "type": "string",
    "default": "8.8.4.4",
    "description": "DNS server 1."
  },
  "dns_2": {
    "type": "string",
    "default": "2001:4860:4860::8888",
    "description": "DNS server 2."
  },
  "dns_3": {
    "type": "string",
    "default": "2001:4860:4860::8844",
    "description": "DNS server 3."
  },
  "pcrf_freeDiameter": {
    "type": "string",
    "default": "pcrf.conf",
    "description": "FreeDiameter configuration file for PCRF."
  }
}
