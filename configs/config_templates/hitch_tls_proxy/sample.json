{
  "frontend_host": "*",
  "frontend_port": 443,
  "upstreams": [
    {
      "name": "app-primary",
      "host": "127.0.0.1",
      "port": 8080
    },
    {
      "name": "app-secondary",
      "host": "10.0.1.5",
      "port": 8080
    }
  ],
  "ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384",
  "prefer_server_ciphers": true,
  "worker_processes": 0,
  "log_file": "/var/log/hitch/hitch.log",
  "log_level": "notice",
  "ssl_session_cache_enabled": true,
  "ssl_session_cache_size": 50000,
  "ocsp_responder_urls": [],
  "certificates": [
    {
      "name": "main-cert",
      "pem_path": "/etc/hitch/certs/main.pem",
      "sni_names": [
        "example.com",
        "www.example.com"
      ]
    },
    {
      "name": "api-cert",
      "pem_path": "/etc/hitch/certs/api.pem",
      "sni_names": [
        "api.example.com"
      ]
    }
  ],
  "health_check_interval": 10,
  "ssl_options": [
    "no-sslv3",
    "single-dh-use"
  ],
  "tcp_keepalive_enabled": true,
  "tcp_keepalive_interval": 60,
  "shutdown_timeout": 5,
  "use_system_tls_engine": false
}
