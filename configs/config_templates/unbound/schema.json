{
  "name": {
    "type": "string",
    "default": "unbound",
    "description": "Name of the service/daemon."
  },
  "desc": {
    "type": "string",
    "default": "DNS server",
    "description": "Description of the service."
  },
  "daemon": {
    "type": "string",
    "default": "/usr/sbin/unbound",
    "description": "Path to the unbound daemon binary."
  },
  "pidfile": {
    "type": "string",
    "default": "/run/unbound.pid",
    "description": "Path to the PID file for the unbound daemon."
  },
  "helper": {
    "type": "string",
    "default": "/usr/libexec/unbound-helper",
    "description": "Path to the unbound helper script."
  }
}
