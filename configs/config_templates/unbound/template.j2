# Unbound DNS Resolver Configuration
#
# This configuration is managed by Ansible. Do not edit manually.
# See unbound.conf(5) for full documentation.

# Include additional configuration snippets from the conf.d directory.
# These files can override or extend the settings defined below.
include-toplevel: "/etc/unbound/unbound.conf.d/*.conf"

server:
    # List of IP addresses to bind the DNS resolver interface(s).
    # Use 127.0.0.1 for localhost, 0.0.0.0 for all IPv4, :: for all IPv6.
{% for addr in interfaces | default(['127.0.0.1']) %}
    interface: {{ addr }}
{% endfor %}

    # Local port on which the resolver listens for DNS queries.
    port: {{ server_port | default(53) }}

    # Enable IPv4 support for DNS queries and responses.
{% if do_ip4 | default('') %}
    do-ip4: yes
{% endif %}

    # Enable IPv6 support for DNS queries and responses.
{% if do_ip6 | default('') %}
    do-ip6: yes
{% endif %}

    # Enable UDP transport for DNS queries and responses.
{% if do_udp | default('') %}
    do-udp: yes
{% endif %}

    # Enable TCP transport for DNS queries (required for large DNSSEC responses).
{% if do_tcp | default('') %}
    do-tcp: yes
{% endif %}

    # Maximum number of TCP connections allowed per upstream server.
    tcp-upstream: {{ tcp_upstream | default(10) }}

    # Maximum number of TCP connections allowed per local interface.
    tcp-downstream: {{ tcp_downstream | default(100) }}

    # Number of worker threads. Set to 0 to auto-detect CPU count.
{% if num_threads | default(0) > 0 %}
    num-threads: {{ num_threads | default(0) }}
{% endif %}

    # EDNS buffer size in bytes (must be ≥ 512 and ≤ 4096 for best compatibility).
    edns-buffer-size: {{ edns_buffer_size | default(1232) }}

    # Size of the message cache. Supports suffixes like 'kb', 'mb', 'gb'.
    msg-cache-size: {{ msg_cache_size | default('4mb') }}

    # Number of slabs in the message cache (power of two recommended for performance).
    msg-cache-slabs: {{ msg_cache_slabs | default(1) }}

    # Size of the DNSSEC key cache.
    key-cache-size: {{ key_cache_size | default('4mb') }}

    # Number of slabs in the key cache.
    key-cache-slabs: {{ key_cache_slabs | default(1) }}

    # Size of the RRSET (resource record set) cache.
    rrset-cache-size: {{ rrset_cache_size | default('8mb') }}

    # Number of slabs in the RRSET cache.
    rrset-cache-slabs: {{ rrset_cache_slabs | default(1) }}

    # TTL for infrastructure cache entries (e.g., RTT info, hints), in seconds.
    infra-cache-ttl: {{ infra_cache_ttl | default(900) }}

    # Number of slabs in the infrastructure cache.
    infra-cache-slabs: {{ infra_cache_slabs | default(1) }}

    # Log every incoming query (debugging use only; can generate large logs).
{% if log_queries | default('') %}
    log-queries: yes
{% endif %}

    # Log every outgoing reply (debugging use only).
{% if log_replies | default('') %}
    log-replies: yes
{% endif %}

    # Prefix log lines with thread number and time in ISO 8601 format.
{% if log_tag | default('') %}
    log-tag: yes
{% endif %}

    # Use human-readable ASCII timestamp in logs (instead of Unix epoch).
{% if log_time_ascii | default('') %}
    log-time-ascii: yes
{% endif %}

    # Access control list entries in format: `<subnet> <action>` (e.g., '192.168.1.0/24 allow_sld').
    # Default allows localhost and denies all others.
{% for acl in access_control | default(['127.0.0.0/8 allow', '::1/128 allow', '0.0.0.0/0 deny']) %}
    access-control: {{ acl }}
{% endfor %}

    # List of forwarding zones. Each zone forwards queries for a domain suffix
    # to upstream resolvers.
{% for fwd in forward_upstream | default([]) %}
{% set parts = fwd.split(' ') %}
{% set domain = parts[0] %}
{% set servers = parts[1:] | join(' ') %}
    forward-zone:
        name: "{{ domain }}"
        forward-addr: {{ servers }}
{% endfor %}