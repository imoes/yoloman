{
  "interfaces": [
    "127.0.0.1"
  ],
  "server_port": 53,
  "do_ip4": true,
  "do_ip6": false,
  "do_udp": true,
  "do_tcp": true,
  "tcp_upstream": 10,
  "tcp_downstream": 100,
  "num_threads": 0,
  "edns_buffer_size": 1232,
  "msg_cache_size": "4mb",
  "msg_cache_slabs": 1,
  "key_cache_size": "4mb",
  "key_cache_slabs": 1,
  "rrset_cache_size": "8mb",
  "rrset_cache_slabs": 1,
  "infra_cache_ttl": 900,
  "infra_cache_slabs": 1,
  "log_queries": false,
  "log_replies": false,
  "log_tag": true,
  "log_time_ascii": true,
  "access_control": [
    "127.0.0.0/8 allow",
    "::1/128 allow",
    "0.0.0.0/0 deny"
  ],
  "forward_upstream": []
}
