<?xml version="1.0" encoding="UTF-8"?>
<!-- Fontconfig configuration for Noto Sans Tamil UI -->
<!-- Generated by Ansible Jinja2 template -->
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!-- Match fonts requested for Tamil language and generic sans-serif family -->
  <match>
    <!-- Test if the target font's language tag contains the specified language code -->
    <test name="lang" compare="contains">
      <string>{{ lang | default('ta') }}</string>
    </test>
    <!-- Test if the target font family matches the specified generic family -->
    <test name="family">
      <string>{{ family | default('sans-serif') }}</string>
    </test>
    <!-- Prepend the specific Noto Sans Tamil UI font to the family list -->
    <edit name="family" mode="prepend">
      <string>{{ font_name | default('Noto Sans Tamil UI') }}</string>
    </edit>
    <!-- Append boolean value to fonthashint to disable hinting (typically 'false') -->
    <edit name="fonthashint" mode="append">
      <bool>{{ fonthashint | default('false') }}</bool>
    </edit>
  </match>

  <!-- Alias the specific font name to a generic family target -->
  <alias>
    <!-- The font family name to be aliased -->
    <family>{{ font_name | default('Noto Sans Tamil UI') }}</family>
    <!-- The target generic family for aliases -->
    <default>
      <family>{{ alias_target | default('sans-serif') }}</family>
    </default>
  </alias>
</fontconfig>
