# Global settings for the email-reminder service
[main]
log_level = {{ log_level }}
log_file = {{ log_file }}
pid_file = {{ pid_file }}

# SMTP server configuration
[smtp]
host = {{ smtp.host }}
port = {{ smtp.port }}
use_tls = {{ smtp.use_tls }}
use_ssl = {{ smtp.use_ssl }}
user = {{ smtp.user }}
password = {{ smtp.password }}
from_address = {{ smtp.from_address }}

# Email template settings
[templates]
default_subject = {{ templates.default_subject }}
default_body = {{ templates.default_body }}

# Time before event to send reminder (in minutes)
[reminders]
default_lead_time = {{ reminders.default_lead_time }}
max_lead_time = {{ reminders.max_lead_time }}

# Event sources (each source is an entry in this list)
{% for source in event_sources %}
[source:{{ source.name }}]
enabled = {{ source.enabled }}
type = {{ source.type }}
url = {{ source.url }}
interval_minutes = {{ source.interval_minutes }}
{% if source.query %}query = {{ source.query }}{% endif %}
{% endfor %}

# Recipient groups (each group sends to all listed recipients)
{% for group in recipient_groups %}
[recipient_group:{{ group.name }}]
recipients = {{ group.recipients | join(', ') }}
{% endfor %}
