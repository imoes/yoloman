{
 "event_sources": [
  {
   "enabled": true,
   "interval_minutes": 15,
   "name": "work-calendar",
   "query": "",
   "type": "google",
   "url": "https://calendar.google.com/calendar/ical/abc%40group.calendar.google.com/public/basic.ics"
  },
  {
   "enabled": true,
   "interval_minutes": 60,
   "name": "personal-ics",
   "type": "ics",
   "url": "/etc/email-reminder/personal.ics"
  }
 ],
 "log_file": "/var/log/email-reminder/email-reminder.log",
 "log_level": "INFO",
 "pid_file": "/run/email-reminder/email-reminder.pid",
 "recipient_groups": [
  {
   "name": "dev-team",
   "recipients": [
    "alice@example.com",
    "bob@example.com"
   ]
  },
  {
   "name": "managers",
   "recipients": [
    "manager@example.com"
   ]
  }
 ],
 "reminders": {
  "default_lead_time": 30,
  "max_lead_time": 1440
 },
 "smtp": {
  "from_address": "reminders@example.com",
  "host": "smtp.gmail.com",
  "password": "REDACTED_SECURELY",
  "port": 587,
  "use_ssl": false,
  "use_tls": true,
  "user": "reminders@example.com"
 },
 "templates": {
  "default_body": "Hi,\n\nThis is a reminder about your upcoming event:\n\nEvent: {{ event.title }}\nWhen: {{ event.start_time | format_datetime('medium') }}\nWhere: {{ event.location or 'TBD' }}\n\nYou’re receiving this because you subscribed via Email Reminder.\n\n— Your friendly reminder bot",
  "default_subject": "Reminder: {{ event.title }} is starting soon!"
 }
}
