{
  "swish": {
    "index_file": "/var/lib/swish-e/mysearch.index",
    "search_files": "/var/www/site-content",
    "title_prop_name": "Title",
    "description_prop_name": "Description",
    "date_prop_name": "Last-Modified",
    "char_set": "UTF-8",
    "min_word_length": 3,
    "max_word_length": 50,
    "verbose": 1,
    "index_dirs": [
      "html",
      "htm",
      "txt",
      "xml"
    ],
    "system": "files",
    "phrase_stop_list": [
      "the",
      "and",
      "is",
      "are",
      "was",
      "were"
    ]
  }
}
