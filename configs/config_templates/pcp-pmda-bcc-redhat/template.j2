# BCC PMDA tracepoint configuration for PCP.
# This file defines which kernel tracepoints the BCC (BPF Compiler Collection)
# Performance Co-Pilot (PCP) PMDA should monitor.
# Format: Each line must be 'name:tracepoint'.
# 'name' is the metric name prefix in PCP, 'tracepoint' is the kernel tracepoint.
#
# Example: random:urandom_read means the PCP metric 'bcc.random.urandom_read'
# will track the 'urandom_read' tracepoint.

# List of BCC PMDA tracepoint mappings to enable, one per line in the format 'name:tracepoint'.
# This replaces the static content of the config file.
# Default: 'random:urandom_read\ntlb:tlb_flush'
{{ (pcp_bcc_pmda_tracepoints | default('random:urandom_read\ntlb:tlb_flush')) | indent(0) }}
