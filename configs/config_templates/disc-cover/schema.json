{
  "config_version_config": {
    "type": "string",
    "default": "1.4.1",
    "description": "Configuration version string"
  },
  "config_casetype": {
    "type": "string",
    "default": "jewel",
    "description": "CD case type (e.g., jewel, digipak, slimline)",
    "enum": [
      "jewel",
      "slim",
      "x-slim",
      "tevion-slim",
      "letter-slim"
    ]
  },
  "config_output_format": {
    "type": "string",
    "default": "ps",
    "description": "Output format (e.g., ps, pdf)",
    "enum": [
      "ps",
      "pdf",
      "tex",
      "dvi",
      "txt",
      "cddb",
      "lbl",
      "html"
    ]
  },
  "config_device": {
    "type": "string",
    "default": "/dev/cdrom",
    "description": "Device path to the CD-ROM drive"
  },
  "config_tmp_dir": {
    "type": "string",
    "default": "/tmp",
    "description": "Temporary directory for intermediate files"
  },
  "config_homedir": {
    "type": "string",
    "default": "",
    "description": "Home directory override (empty string uses $ENV{HOME})"
  },
  "latex_user_packages": {
    "type": "string",
    "default": "inputenc",
    "description": "Comma-separated list of LaTeX packages to load"
  },
  "flag_genre": {
    "type": "number",
    "default": 0,
    "description": "Enable genre display in output (0 = disabled, 1 = enabled)"
  },
  "flag_with_extended_track_info": {
    "type": "number",
    "default": 0,
    "description": "Include extended track information (0 = disabled, 1 = enabled)"
  },
  "flag_various_artist_cd": {
    "type": "number",
    "default": 0,
    "description": "Treat CD as various-artist compilation (0 = disabled, 1 = enabled)"
  },
  "flag_double_disc_cdtitle": {
    "type": "number",
    "default": 1,
    "description": "Use double-disc title formatting (0 = disabled, 1 = enabled)"
  },
  "flag_picture_use_allmusic": {
    "type": "number",
    "default": 0,
    "description": "Use AllMusic for cover art (0 = disabled, 1 = enabled)"
  },
  "flag_uppercase_fix": {
    "type": "number",
    "default": 0,
    "description": "Apply uppercase title/artist fix (0 = disabled, 1 = enabled)"
  },
  "flag_verbose": {
    "type": "number",
    "default": 0,
    "description": "Enable verbose output (0 = disabled, 1 = enabled)"
  },
  "flag_remove_temporary_files": {
    "type": "number",
    "default": 0,
    "description": "Remove temporary files after processing (0 = yes, remove; 1 = no, keep)"
  },
  "latex_global_oddsidemargin": {
    "type": "string",
    "default": "-25pt",
    "description": "LaTeX oddsidemargin setting"
  },
  "latex_global_evenside_margin": {
    "type": "string",
    "default": "-25pt",
    "description": "LaTeX evenside_margin setting"
  },
  "latex_global_voffset": {
    "type": "string",
    "default": "-100pt",
    "description": "LaTeX voffset setting"
  },
  "latex_global_footskip": {
    "type": "string",
    "default": "0pt",
    "description": "LaTeX footskip setting"
  },
  "latex_global_textheight": {
    "type": "string",
    "default": "780pt",
    "description": "LaTeX textheight setting"
  },
  "latex_global_textwidth": {
    "type": "string",
    "default": "170mm",
    "description": "LaTeX textwidth setting"
  }
}
