{
  "mounts": [
    {
      "mount_point": "/mnt/afuse-auto",
      "mount_template": "sshfs %r:%m %m -o identityfile=~/.ssh/id_rsa",
      "unmount_template": "fusermount -u -z %m",
      "fuse_options": [
        "allow_other",
        "default_permissions",
        "entry_timeout=60",
        "attr_timeout=60"
      ]
    }
  ]
}
