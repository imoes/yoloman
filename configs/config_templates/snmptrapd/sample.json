{
  "snmptrapd": {
    "listen_addresses": [
      "127.0.0.1",
      "::1"
    ],
    "listen_ports": [
      162
    ],
    "communities": [
      {
        "name": "public"
      }
    ],
    "v3_users": [],
    "handlers": [],
    "log_output": "/var/log/snmptrapd.log",
    "drop_privileges": true,
    "priv_user": "nobody",
    "debug": false
  },
  "trapd_opts": "-LSwd -p /run/snmptrapd.pid"
}
