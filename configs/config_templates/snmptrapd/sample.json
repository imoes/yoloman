{
  "snmptrapd": {
    "listen_addresses": [
      "0.0.0.0"
    ],
    "listen_ports": [
      162
    ],
    "communities": [
      {
        "name": "public"
      },
      {
        "name": "private"
      }
    ],
    "v3_users": [
      {
        "name": "trapuser",
        "auth": "SHA",
        "priv": "AES"
      }
    ],
    "handlers": [
      {
        "oid": "1.3.6.1.4.1.9.9.41.1.1.1",
        "script": "/usr/local/bin/handle-cisco-trap.sh"
      },
      {
        "oid": "1.3.6.1.6.3.1.1.4.1.0.1.3.6.1.4.1.2021.11",
        "script": "/usr/local/bin/handle-load-trap.sh"
      }
    ],
    "log_output": "syslog",
    "drop_privileges": true,
    "priv_user": "snmp",
    "debug": false
  }
}
