{
  "snmptrapd": {
    "type": "object",
    "description": "Top-level configuration block for snmptrapd",
    "properties": {
      "listen_addresses": {
        "type": "list",
        "default": [
          "127.0.0.1",
          "::1"
        ],
        "description": "IP addresses to listen on for incoming SNMP traps. Use empty list to listen on all interfaces.",
        "items": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$|^[0-9a-fA-F:]+$"
        }
      },
      "listen_ports": {
        "type": "list",
        "default": [
          162
        ],
        "description": "UDP ports to listen on for SNMP traps. Standard trap port is 162.",
        "items": {
          "type": "number",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "communities": {
        "type": "list",
        "default": [
          {
            "name": "public"
          }
        ],
        "description": "List of SNMPv1/v2c community names accepted for trap authentication.",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "SNMP community string (e.g., 'public', 'private').",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "v3_users": {
        "type": "list",
        "default": [],
        "description": "List of SNMPv3 users with authentication/privacy support.",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "SNMPv3 username.",
              "minLength": 1
            },
            "auth": {
              "type": "string",
              "description": "Authentication protocol: 'MD5' or 'SHA'. Leave blank to disable auth.",
              "enum": [
                "",
                "MD5",
                "SHA"
              ],
              "default": ""
            },
            "priv": {
              "type": "string",
              "description": "Privacy (encryption) protocol: 'DES' or 'AES'. Leave blank to disable privacy.",
              "enum": [
                "",
                "DES",
                "AES"
              ],
              "default": ""
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "handlers": {
        "type": "list",
        "default": [],
        "description": "List of trap handlers \u2014 external scripts triggered on matching trap OIDs.",
        "items": {
          "type": "object",
          "properties": {
            "oid": {
              "type": "string",
              "description": "SNMP OID prefix to match (e.g., '1.3.6.1.4.1.9.9.41', '.1.3.6.1.6.3.1.1.4.1.0').",
              "minLength": 1
            },
            "script": {
              "type": "string",
              "description": "Absolute path to the script to execute when a matching trap arrives.",
              "minLength": 1
            }
          },
          "required": [
            "oid",
            "script"
          ]
        }
      },
      "log_output": {
        "type": "string",
        "default": "/var/log/snmptrapd.log",
        "description": "Path to the log file. Use 'syslog' to send logs to system logger."
      },
      "drop_privileges": {
        "type": "boolean",
        "default": true,
        "description": "Whether to drop root privileges after binding to ports. Recommended for security."
      },
      "priv_user": {
        "type": "string",
        "default": "nobody",
        "description": "User to drop to if drop_privileges is true.",
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "debug": {
        "type": "boolean",
        "default": false,
        "description": "Enable verbose debugging output (not for production use)."
      }
    }
  }
}
