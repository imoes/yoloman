# ============================================================================
# mtail Configuration Template
# ============================================================================
# This file defines how mtail tails log files, extracts metrics via regex
# patterns, and exposes them via an HTTP endpoint.
#
# NOTE on mtail's config format:
# mtail natively uses a binary protobuf or Go-source-based program format.
# This template generates a simplified, human-readable DSL that mirrors
# mtail's conceptual structure (programs, tails, output settings).
# If your deployment requires the official binary/proto format, this
# template serves as a source-of-truth for the logical configuration
# which must then be compiled by an external build step or cli tool.
# ============================================================================

# ---------------------------------------------------------------------------
# Program Definitions
# ---------------------------------------------------------------------------
# List of mtail program definitions (regex patterns + metric rules + code).
# Each program consists of:
#   - match: a regex to select lines
#   - labels: static key-value labels to attach
#   - metrics: definitions of metrics to emit (counter, gauge, histogram)
#   - program: optional Go-like code block for custom logic
# ---------------------------------------------------------------------------
{% if programs | default([]) | length > 0 %}
# === Program Definitions ===
{% for prog in programs %}
# --- Program: {{ prog.name | default('unnamed') }} ---
# Description for this program: {{ prog.description | default('No description provided.') }}

# Match regex: lines matching this pattern trigger the program logic.
{% if prog.match %}
match {{ prog.match }}
{% endif %}

# Static labels attached to all metrics from this program.
{% if prog.labels | default({}) %}
labels {
{% for label_name, label_value in prog.labels | default({}) | dict2items %}
  {{ label_name | default('') }} = {{ label_value | default('') }}
{% endfor %}
}
{% endif %}

# Metric definitions generated by this program.
{% if prog.metrics | default([]) | length > 0 %}
metrics {
{% for metric in prog.metrics | default([]) %}
  # Metric: {{ metric.name | default('unnamed') }} (type: {{ metric.type | default('counter') }})
  {% if metric.type | default('counter') == 'counter' %}
  counter {{ metric.name | default('unnamed') }}
  {% elif metric.type | default('counter') == 'gauge' %}
  gauge {{ metric.name | default('unnamed') }}
  {% elif metric.type | default('counter') == 'histogram' %}
  histogram {{ metric.name | default('unnamed') }} buckets {{ metric.buckets | default([1, 5, 10, 25, 50, 100, 250, 500, 1000]) | join(', ') }}
  {% endif %}
{% endfor %}
}
{% endif %}

# Optional custom program code (Go-like syntax supported by mtail).
{% if prog.program | default('') %}
program {
{{ prog.program | default('') | indent(2) }}
}
{% endif %}

{% endfor %}
{% else %}
# No programs defined. mtail will run without any tailing or metric extraction.
# To enable functionality, add entries to the 'programs' list in the schema.
{% endif %}

# ---------------------------------------------------------------------------
# Log Patterns (Tail Sources)
# ---------------------------------------------------------------------------
# List of glob patterns for log files to tail.
# mtail will open and read these files, feeding matching lines to programs.
# ---------------------------------------------------------------------------
{% if log_patterns | default(['/var/log/*.log']) | length > 0 %}
# === Log Tail Sources ===
{% for pattern in log_patterns | default(['/var/log/*.log']) %}
tail {{ pattern | default('/var/log/*.log') }}
{% endfor %}
{% else %}
# Default log path if none specified.
tail /var/log/*.log
{% endif %}

# ---------------------------------------------------------------------------
# HTTP Output Settings
# ---------------------------------------------------------------------------
# Configuration for the metrics HTTP server endpoint.
# ---------------------------------------------------------------------------

# Output path for collected metrics (e.g., /metrics).
# This is the HTTP path where Prometheus scrapers will fetch data.
{% if output_path | default('/metrics') %}
output_path {{ output_path | default('/metrics') }}
{% else %}
output_path /metrics
{% endif %}

# Server port for the metrics endpoint.
# The port where the HTTP server listens for scraping requests.
{% if server_port | default(3903) %}
server_port {{ server_port | default(3903) }}
{% else %}
server_port 3903
{% endif %}

# Log level (debug, info, warn, error).
# Verbosity of mtail's own internal logs.
{% if log_level | default('warn') %}
log_level {{ log_level | default('warn') }}
{% else %}
log_level warn
{% endif %}