{
  "use_lvmetad": true,
  "pidfile": "/run/lvmetad.pid",
  "socket": "/run/lvmetad.socket",
  "max_pending_connections": 20,
  "max_cache_size_kb": 20480,
  "cache_metadata": true,
  "cache_devices": true,
  "polling_interval": 1,
  "validate_metadata": true,
  "log_verbose": false,
  "log_overwrite": false,
  "log_level": 3,
  "log_file": "/var/log/lvmetad.log",
  "syslog_facility": "daemon",
  "activation_min_initial_size_percent": 10,
  "auto_activation_volume_list": [
    "VG1/*",
    "VG2/data_lv"
  ],
  "monitoring": true,
  "nice": -18
}
