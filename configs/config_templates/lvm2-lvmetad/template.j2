# Enable use of lvmetad (LVM metadata cache daemon)
# Set to 1 to enable lvmetad; 0 to disable
use_lvmetad = {{ use_lvmetad | lower }}

# Directory where lvmetad stores its PID file
pidfile = "{{ pidfile }}"

# Path to the lvmetad socket for communication with LVM tools
socket = "{{ socket }}"

# Maximum number of pending connections to the lvmetad socket
max_pending_connections = {{ max_pending_connections }}

# Maximum size (in KB) of the metadata cache before forced refresh
max_cache_size_kb = {{ max_cache_size_kb }}

# Enable or disable caching of PV/VG/LV metadata
cache_metadata = {{ cache_metadata | lower }}

# Enable or disable caching of device state
cache_devices = {{ cache_devices | lower }}

# Enable or disable polling for device changes (used if cache_devices=1)
# Set to 0 to disable polling (e.g., if using udev instead)
polling_interval = {{ polling_interval }}

# Enable or disable validation of metadata against on-disk state
validate_metadata = {{ validate_metadata | lower }}

# LVM log settings (applies to lvmetad too when run in foreground/debug)
log {
    verbose = {{ log_verbose | lower }}
    overwrite = {{ log_overwrite | lower }}
    # Log level: 0=none, 1=error, 2=important, 3=info, 4=debug
    level = {{ log_level }}
    # Paths to log files; if empty, logs go to syslog
    file = "{{ log_file }}"
    # Syslog facility to use if not logging to file
    syslog = {{ syslog_facility }}
}

# Global settings affecting all LVM components, including lvmetad
# These are inherited by lvmetad at startup
activation {
    # Minimum free space (in % of VG) required to activate LVs
    # lvmetad does not enforce this, but it respects it when reading config
    min_initial_size_percent = {{ activation_min_initial_size_percent }}

    # Enable or disable LV auto-activation on device arrival
    auto_activation_volume_list = [ {% for item in auto_activation_volume_list %}"{{ item }}"{% if not loop.last %}, {% endif %}{% endfor %} ]
}

# DMEVENTD monitoring settings (optional; lvmetad does not start dmeventd)
# Set to false if dmeventd is not used or should not be monitored
monitoring = {{ monitoring | lower }}

# Process priority (nice value) for lvmetad when started by lvm2 packages
nice = {{ nice }}
