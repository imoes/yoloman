{
  "disable_root": true,
  "ssh_pwauth": false,
  "preserve_hostname": false,
  "ssh_deletekeys": true,
  "ssh_genkeytypes": [
    "rsa",
    "ecdsa",
    "ed25519"
  ],
  "syslog_fix_perms": null,
  "disable_vmware_customization": false,
  "distro": "almalinux",
  "default_user_name": "almalinux",
  "default_user_lock_passwd": true,
  "default_user_gecos": "almalinux Cloud User",
  "default_user_groups": [
    "adm",
    "systemd-journal"
  ],
  "default_user_sudo": [
    "ALL=(ALL) NOPASSWD:ALL"
  ],
  "default_user_shell": "/bin/bash",
  "network_renderers": [
    "sysconfig",
    "eni",
    "netplan",
    "network-manager",
    "networkd"
  ],
  "cloud_dir": "/var/lib/cloud/",
  "templates_dir": "/etc/cloud/templates/",
  "ssh_svcname": "sshd"
}
