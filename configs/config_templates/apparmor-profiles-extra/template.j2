# AppArmor profile for irssi.
# This profile applies to the irssi binary to restrict its system access.
#
# Schema Field: profile_path
# Default: '/usr/bin/irssi'
# Description: Absolute path to the binary the AppArmor profile applies to.
{{ profile_path | default('/usr/bin/irssi') }} flags=(complain) {
  # Include global tunables and standard abstractions.

  # Base system abstractions (libc, etc.)
  #include <abstractions/base>

  # DNS and network name resolution abstractions
  #include <abstractions/nameservice>

  # Perl interpreter abstractions (for irssi scripts)
  #include <abstractions/perl>

  # SSL certificate access abstractions
  #include <abstractions/ssl_certs>

  # Read access to irssi theme files
  /usr/share/irssi/themes/*.theme r,

  # Read access to irssi help files
  /usr/share/irssi/help/* r,

  # Enable system wide scripts
  # Read access to irssi scripts in /usr/share
  /usr/share/irssi/scripts/* r,

  # Read access to CA certificates for TLS/SSL verification
  /usr/share/ca-certificates/** r,

  # Read process uptime from procfs
  @{PROC}/uptime r,

  # Allow execution of dash shell (needed for script execution)
  /{usr/,}bin/dash ix,

  # for screen_away module
  # Include utmp/wtmp abstractions for screen status
  #include <abstractions/wutmp>

  # Allow execution of screen
  /usr/bin/screen ix,

  # Read access to screen socket directories
  owner /{,var/}run/screen/** r,

  # Write access to screen socket files (dynamic names)
  owner /{,var/}run/screen/S-[a-zA-Z0-9]*/[0-9]* w,

  # Read access to process stats for uptime calculation
  @{PROC}/[0-9]*/stat r,

  # for /uptime command
  # Allow execution of gawk
  /usr/bin/gawk ix,
  # Allow execution of expr
  /usr/bin/expr ix,
  # Allow execution of date
  /{usr/,}bin/date ix,

  # for /calc command
  # Allow execution of bc
  /usr/bin/bc ix,
  # Allow execution/reading of which
  /{usr/,}bin/which ixr,

  # Config files, etc

  # Read access to global irssi configuration
  /etc/irssi.conf r,

  # Read access to user irssi directory
  owner @{HOME}/.irssi/ r,

  # Read access to files within user irssi directory
  owner @{HOME}/.irssi/** r,

  # Write access to away log
  owner @{HOME}/.irssi/away.log wk,

  # Write access to config and autosave files
  owner @{HOME}/.irssi/config{,.autosave} wk,

  # Write access to user themes
  owner @{HOME}/.irssi/*.theme wk,

  # for IRC logs
  # Read access to irclogs directory (in home or .irssi)
  owner @{HOME}/{.irssi/,}irclogs/ r,
  # Read/Write/Kill access to log files in irclogs
  owner @{HOME}/{.irssi/,}irclogs/** rwk,

  # for fnotify module
  # Read/Write/Kill access to fnotify socket
  owner @{HOME}/.irssi/fnotify rwk,

  # Site-specific additions and overrides. See local/README for details.
  #include <local/usr.bin.irssi>
}
