## Description: Pixel size of the large icons (e.g., '128'). Defaults to 128 if not specified.
# This file enables the download of large {{ (icon_size | default(128)) }}x{{ (icon_size | default(128)) }}px
{% if software_center_1 | default('GNOME Software') is not none and (software_center_1 | default('GNOME Software') is string and software_center_1 | default('GNOME Software') | length > 0) %}
## icons for use in software centers like {{ software_center_1 | default('GNOME Software') }}
{% else %}
## icons for use in software centers like GNOME Software
{% endif %}## and {{ software_center_2 | default('Plasma Discover') }}.
##
## The icons speed up usage of the software centers,
## and would otherwise be downloaded on-deman for each user.

Acquire::IndexTargets {
    deb::DEP-11-icons-large  {
        # Description: Whether DEP-11 large icons are enabled by default.
        DefaultEnabled "{{ default_enabled | default('true') }}";
    };
};
