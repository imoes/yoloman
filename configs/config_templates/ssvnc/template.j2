# ~/.ssvncrc - SSVNC (Secure VNC) Global Configuration
#
# This file configures the SSVNC client's default connection behavior,
# tunneling preferences, security certificates, and predefined profiles.
# It is sourced automatically by ssvnc on startup.
#
# Generated by Ansible Jinja2 Engine - Self-Documenting Template

# =============================================================================
# Global Connection Mode
#
# Determines the primary tunneling protocol for VNC connections.
# Options:
#   - 'sslvnc': Use SSL/TLS tunneling (default if available).
#   - 'sshvnc': Use SSH tunneling.
#   - 'tsvnc':  Use TightVNC native encryption (if applicable).
#
# See: SSVNC documentation, FILES section, Help panel Tips.
# =============================================================================
mode={{ mode | default('sslvnc') }}

# =============================================================================
# SSH Tunneling Preference
#
# If set to true, SSVNC attempts to create an SSH tunnel for the VNC session.
# SSH generally offers robust compression and security if SSH keys are configured.
# This setting can override SSL behavior depending on the 'mode' selected.
#
# See: SSVNC documentation, DESCRIPTION, URL NOTATION.
# =============================================================================
use_ssh={{ use_ssh | default(true) }}

# =============================================================================
# SSL Tunneling Preference
#
# If set to true, SSVNC attempts to create an SSL/TLS tunnel.
# This is effective when 'use_ssh' is false or if the 'mode' forces sslvnc.
# Ensure valid certificates are provided via 'mycert', 'cacert', and 'crl'.
#
# See: SSVNC documentation, DESCRIPTION, URL NOTATION.
# =============================================================================
use_ssl={{ use_ssl | default(true) }}

# =============================================================================
# Client SSL Certificate
#
# Path to the client's SSL certificate file in PEM format.
# Required for two-way SSL authentication if the VNC server demands it.
# Leave empty for server-only verification (one-way SSL).
#
# See: SSVNC OPTIONS (-mycert).
# =============================================================================
mycert={{ mycert | default('') }}

# =============================================================================
# CA Certificate for Verification
#
# Path to the Certificate Authority (CA) certificate file.
# Used to verify the identity of the remote VNC server's certificate.
# Prevents man-in-the-middle attacks by ensuring the server cert is trusted.
#
# See: SSVNC OPTIONS (-cacert).
# =============================================================================
cacert={{ cacert | default('') }}

# =============================================================================
# Certificate Revocation List (CRL)
#
# Path to a CRL file containing revoked certificates.
# SSVNC will reject connections if the server presents a certificate found in this list.
# Leave empty if CRL checking is not desired or managed elsewhere.
#
# See: SSVNC OPTIONS (-crl).
# =============================================================================
crl={{ crl | default('') }}

# =============================================================================
# Default GUI Font
#
# Specifies the default font for rendering text in the VNC GUI.
# Format is typically "font_name size" (e.g., 'helvetica -12').
# '-12' indicates a default logical size scaling.
#
# See: SSVNC FONTS section, environment variable SSVNC_FONT_DEFAULT.
# =============================================================================
font_default={{ font_default | default('helvetica -12') }}

# =============================================================================
# Fixed-Width GUI Font
#
# Specifies the default monospaced font for fixed-width text in the VNC GUI.
# Useful for terminal windows or code editing within VNC sessions.
# Format is typically "font_name size" (e.g., 'courier -12').
#
# See: SSVNC FONTS section, environment variable SSVNC_FONT_FIXED.
# =============================================================================
font_fixed={{ font_fixed | default('courier -12') }}

# =============================================================================
# Port Knocking Enablement
#
# If set to true, enables port knocking.
# Port knocking is a security technique where the client sends a sequence
# of connection attempts to closed ports to "open" a specific port (like SSH/VNC)
# for the connecting IP before attempting the actual service connection.
#
# See: SSVNC Feature List.
# =============================================================================
port_knocking={{ port_knocking | default(false) }}

# =============================================================================
# Port Knocking Sequence
#
# Comma-separated list of ports to knock in order.
# Example: '1000,2000,3000' knocks port 1000, then 2000, then 3000.
# This is only effective if 'port_knocking' is true.
#
# See: SSVNC Feature List.
# =============================================================================
port_knock_sequence={{ port_knock_sequence | default('') }}

# =============================================================================
# VNC Profiles
#
# List of predefined VNC connection profiles.
# Each string should be in the format: 'profile_name=host:display'
# or 'profile_name=host:port' depending on the connection method.
# These allow quick selection of common servers within the SSVNC GUI or CLI.
#
# Example: ['office=192.168.1.10:0', 'home=203.0.113.5:5901']
#
# See: SSVNC Profile documentation.
# =============================================================================
profiles={{ profiles | default([]) | join(', ') }}