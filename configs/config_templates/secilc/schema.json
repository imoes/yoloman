{
  "input_file": {
    "type": "string",
    "default": "policy.cil",
    "description": "The input CIL policy file to compile."
  },
  "output_file": {
    "type": "string",
    "default": "policy.31",
    "description": "The output binary policy file path."
  },
  "filecontext_file": {
    "type": "string",
    "default": "file_contexts",
    "description": "The output file contexts file path."
  },
  "target_type": {
    "type": "string",
    "default": "selinux",
    "description": "Target architecture: selinux or xen.",
    "enum": [
      "selinux",
      "xen"
    ]
  },
  "mls_mode": {
    "type": "bool",
    "default": false,
    "description": "Build an MLS policy."
  },
  "policy_version": {
    "type": "string",
    "default": "31",
    "description": "SELinux policy version number."
  },
  "handle_unknown_action": {
    "type": "string",
    "default": "deny",
    "description": "Action for unknown classes/permissions: deny, allow, or reject.",
    "enum": [
      "deny",
      "allow",
      "reject"
    ]
  },
  "disable_dontaudit": {
    "type": "bool",
    "default": false,
    "description": "Do not add dontaudit rules."
  },
  "preserve_tunables": {
    "type": "bool",
    "default": false,
    "description": "Treat tunables as booleans."
  },
  "qualified_names": {
    "type": "bool",
    "default": false,
    "description": "Allow qualified names."
  },
  "multiple_decls": {
    "type": "bool",
    "default": false,
    "description": "Allow re-declaration of statements."
  },
  "disable_neverallow": {
    "type": "bool",
    "default": false,
    "description": "Do not check neverallow rules."
  },
  "expand_generated": {
    "type": "bool",
    "default": false,
    "description": "Expand and remove auto-generated attributes."
  },
  "optimize_policy": {
    "type": "bool",
    "default": true,
    "description": "Optimize final policy."
  },
  "verbose_level": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level (0=off, >0=on)."
  }
}
