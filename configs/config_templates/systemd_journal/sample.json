{
  "persistent": true,
  "data_directory": "/var/log/journal",
  "system_max_use": "500M",
  "system_max_free_space": "200M",
  "system_max_file_size": "50M",
  "system_keep_free": "10%",
  "max_file_lifetime": "90days",
  "volatile_max_file_lifetime": "3days",
  "compress": true,
  "compress_threshold": "60s",
  "rate_limit_interval": "30s",
  "rate_limit_burst": 5000,
  "timestamp": "realtime",
  "forward_to_syslog": false,
  "syslog_socket": "/run/systemd/journal/syslog",
  "forward_to_kmsg": false,
  "forward_to_console": true,
  "console_device": "/dev/console",
  "console_level": "warning",
  "max_lines": 2000,
  "show_catalog": true,
  "header": true,
  "extra_fields": [
    {
      "name": "ENVIRONMENT",
      "value": "production"
    },
    {
      "name": "NODE_ID",
      "value": "node-01"
    }
  ],
  "namespace": "",
  "exclude_units": [
    "auditd.service",
    "systemd-resolved.service"
  ]
}
