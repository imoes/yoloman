# Configuration for srp_daemon (iSER/SRP initiator daemon)
# This template is self-documenting: every directive is preceded by its schema description.
# Use Ansible variables: retries, log_path, ports.

# How often srp_daemon should rescan the fabric in seconds.
# Default: 60
RETRIES={{ retries | default(60) }}

# Path where srp_daemon should log.
# Default: /var/log/srp_daemon.log
LOG={{ log_path | default('/var/log/srp_daemon.log') }}

# Ports srp_daemon should be started on.
# Format is CA:port. Can be ALL, NONE, or a space-separated list of CA:port pairs.
# Default: NONE
PORTS={{ ports | default('NONE') }}
#PORTS=ALL
#PORTS="mthca0:1 mlx4_0:2"