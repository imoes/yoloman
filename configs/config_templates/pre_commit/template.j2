# pre-commit configuration for Git hook management
# Define repositories and hooks to run on commit
repos:
{% for repo in repos %}
  - repo: {{ repo.repo }}
{% if repo.rev %}    rev: {{ repo.rev }}
{% endif %}{% if repo.hooks %}    hooks:
{% for hook in repo.hooks %}{% if hook.id %}      - id: {{ hook.id }}
{% endif %}{% if hook.name %}        name: {{ hook.name }}
{% endif %}{% if hook.entry %}        entry: {{ hook.entry }}
{% endif %}{% if hook.args %}        args: {{ hook.args | tojson }}
{% endif %}{% if hook.files %}        files: {{ hook.files | tojson }}
{% endif %}{% if hook.exclude %}        exclude: {{ hook.exclude }}
{% endif %}{% if hook.types %}        types: {{ hook.types | tojson }}
{% endif %}{% if hook.language %}        language: {{ hook.language }}
{% endif %}{% if hook.always_run %}        always_run: {{ hook.always_run | string | lower }}
{% endif %}{% if hook.pass_filenames %}        pass_filenames: {{ hook.pass_filenames | string | lower }}
{% endif %}{% if hook.description %}        description: {{ hook.description }}
{% endif %}
{% endfor %}{% endif %}
{% endfor %}
# Default configuration options
fail_fast: {{ fail_fast | string | lower }}

# Skip hooks matching these patterns
skip:
{% for skip_hook in skip %}  - {{ skip_hook }}
{% endfor %}

# Default language version (applied if not overridden per hook)
default_language_version:
{% for lang, version in default_language_version.items() %}  {{ lang }}: {{ version }}
{% endfor %}

# Default config for hooks that use `additional_dependencies`
default_additional_dependencies: {{ default_additional_dependencies | tojson }}

# Minimum pre-commit version required
minimum_pre_commit_version: {{ minimum_pre_commit_version }}

# Show tracebacks on errors
show_diff_on_failure: {{ show_diff_on_failure | string | lower }}
