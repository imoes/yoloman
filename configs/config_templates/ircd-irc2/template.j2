# ==============================================================================
# IRCd-IRC2 Configuration Template
# Managed by Ansible. Do not edit manually.
# ==============================================================================

# ------------------------------------------------------------------------------
# Global Daemon Settings
# ------------------------------------------------------------------------------

# Path to the ircd binary executable.
# Used to verify the daemon location or for helper scripts.
# Default: /usr/sbin/ircd
# Variable: ircd_binary
# {{ ircd_binary | default('/usr/sbin/ircd') }}

# Name of the ircd service process.
# Used by systemd/init scripts to identify the service.
# Default: ircd
# Variable: ircd_service_name
# {{ ircd_service_name | default('ircd') }}

# User under which the ircd daemon runs.
# The daemon drops privileges to this user after binding ports.
# Default: irc
# Variable: daemon_user
# {{ daemon_user | default('irc') }}

# ------------------------------------------------------------------------------
# PID File Management
# ------------------------------------------------------------------------------

# Full path to the PID file for the ircd daemon.
# The daemon writes its process ID here.
# Default: /var/run/ircd/ircd.pid
# Variable: pid_file_path
# {{ pid_file_path | default('/var/run/ircd/ircd.pid') }}

# Directory where the PID file is stored.
# Ensures the parent directory exists and has correct ownership before startup.
# Default: /var/run/ircd
# Variable: pid_dir_path
# {{ pid_dir_path | default('/var/run/ircd') }}

# User owner of the PID directory.
# Ensures correct filesystem permissions for the daemon user.
# Default: irc
# Variable: pid_dir_user
# {{ pid_dir_user | default('irc') }}

# Group owner of the PID directory.
# Ensures correct filesystem permissions for the daemon group.
# Default: irc
# Variable: pid_dir_group
# {{ pid_dir_group | default('irc') }}

# ------------------------------------------------------------------------------
# Connection & Security Policies
# ------------------------------------------------------------------------------

# If iauth timeouts, then reject user.
# When external authentication (iauth) is used, fail closed on timeout.
# This is a directive with no parameters.
# Default: notimeout (if commented out, auth allows timeout; uncommented rejects)
# Note: In the original template, this line is present. We keep it active as per schema intent
# unless explicitly overridden. Since there is no boolean schema field, we assume
# the presence of this line represents the desired security posture (Reject on Timeout).
notimeout

# This makes the IRC server require that iauth performs the authentication
# in order for a new user connection to be accepted.
# If this line is present, all clients must authenticate via the iauth mechanism.
# Default: required (active)
required

# ------------------------------------------------------------------------------
# Modules
# ------------------------------------------------------------------------------

# Perform ident lookups.
# Loads the rfc931 module to resolve remote usernames via the Ident protocol (RFC 931).
# Default: module rfc931 (active)
# Variable: (no specific control field, structural directive)
module rfc931

# ------------------------------------------------------------------------------
# Delayed Execution Mode
# ------------------------------------------------------------------------------

# Modules below this keyword will work in delayed execution mode.
# This means client will be allowed to enter irc and if any module below
# decides it shouldn't have, this client will be removed.
# To enable this feature, uncomment the line 'delayed' below.
# Default: disabled (commented out)
# #delayed

# ------------------------------------------------------------------------------
# Proxy Rejection Modules (Optional)
# ------------------------------------------------------------------------------

# Check and reject open SOCKS proxies
# Uncomment and configure to block SOCKS proxies.
# Default: commented out
#
# module socks
#   port = 1080
#   option = reject,paranoid
#   reason = Denied access (insecure proxy found)

# Check and reject HTTP CONNECT proxies on port 8080
# Uncomment and configure to block HTTP CONNECT proxies on standard proxy port.
# Default: commented out
#
# module webproxy
#   port = 8080
#   option = reject
#   reason = Denied access (insecure proxy found)

# Check and reject HTTP CONNECT proxies on port 3128
# Uncomment and configure to block HTTP CONNECT proxies on Squid default port.
# Default: commented out
#
# module webproxy
#   port = 3128
#   option = reject,careful
#   reason = Denied access (insecure proxy found)
