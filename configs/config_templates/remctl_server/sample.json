{
  "listen_addr": "0.0.0.0:8080",
  "keytab_path": "/etc/remctl/remctl.keytab",
  "service_name": "remctl",
  "debug": true,
  "root_dir": "",
  "maxconn": 50,
  "acls": [
    {
      "principal": "admin@EXAMPLE.COM",
      "commands": [
        "status",
        "restart",
        "deploy"
      ]
    },
    {
      "principal": "user1@EXAMPLE.COM",
      "commands": [
        "status",
        "check"
      ]
    },
    {
      "principal": "host/webserver@EXAMPLE.COM",
      "commands": [
        "health-check"
      ]
    }
  ]
}
