# PowerDNS Bind Backend Configuration
# This template generates the configuration file for pdns-backend-bind.
# It manages the inclusion of supermaster definitions and slave zone configurations.

# Base directory for PowerDNS zone files and configuration.
# This directory is used to resolve relative paths for zone files.
include "{{ (zone_directory | default('/var/lib/powerdns')) }}/supermaster.conf";

# Example for a manually configured slave zone.
# The masters directive specifies the IP address of the Bind master
# from which this PowerDNS instance should pull slave zone updates.
#
# zone "example.net" {
#   file "{{ zone_directory | default('/var/lib/powerdns') }}/zones.slave.d/example.net.zone";
#   type slave;
#   masters { {{ (bind_master_ip | default('192.0.2.53')) }}; };
# };