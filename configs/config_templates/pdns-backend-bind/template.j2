{# PowerDNS Bind Backend Configuration #}
{# This file configures the bind-backend module for PowerDNS. #}
{# It defines where zone files are stored and how slave zones communicate with their master. #}

# Base directory for PowerDNS zone files and configuration.
# Default: {{ zone_directory | default('/var/lib/powerdns') }}
include "{{ zone_directory | default('/var/lib/powerdns') }}/supermaster.conf";

# Example configuration for a manually defined slave zone.
# To enable this, uncomment the block below and adjust the zone name and IP addresses.
#
# zone "example.net" {
#   # Path to the specific zone file for this slave zone.
#   file "{{ zone_directory | default('/var/lib/powerdns') }}/zones.slave.d/example.net.zone";
#   type slave;
#   # The IP address of the Bind master server to pull zone data from.
#   # Default: {{ bind_master_ip | default('192.0.2.53') }}
#   masters { {{ bind_master_ip | default('192.0.2.53') }}; };
# };
