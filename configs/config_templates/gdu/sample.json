{
  "ignore_dirs": [
    "/proc",
    "/dev",
    "/sys",
    "/run"
  ],
  "ignore_dirs_pattern": [
    "\\.cache",
    "\\.git"
  ],
  "log_file": "/var/log/gdu.log",
  "max_cores": 4,
  "no_color": true,
  "no_cross": true,
  "no_hidden": true,
  "sequential": true,
  "show_apparent_size": false,
  "show_item_count": true,
  "show_mtime": true,
  "show_relative_size": false,
  "si": false,
  "no_unicode": true,
  "max_age": "7d",
  "min_age": "30d",
  "exclude_type": [
    "log",
    "tmp"
  ],
  "include_type": [
    "yaml",
    "json"
  ],
  "enable_gc": false,
  "enable_profiling": false,
  "interactive": false,
  "read_from_storage": false,
  "reverse_sort": false,
  "sorting_by": "size",
  "sorting_order": "desc"
}
