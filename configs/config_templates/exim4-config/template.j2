# /etc/email-addresses
# This file maps local system users to their full email addresses for outgoing mail.
# Lines follow the format: local_part: full_email_address
# If a local part is not listed here, Exim will qualify it using the configured domain.

# List of email address aliases mapping local user names to their full email addresses.
# Default is an empty dictionary if no aliases are provided.
{% set aliases = email_addresses | default({}) %}

# Iterate over the provided email address aliases safely.
# Uses dict2items to convert the mapping to a list of key-value pairs without calling Python methods.
{% for item in aliases | dict2items %}
# {{ item.key }}: Email alias for the local user '{{ item.key }}'
{{ item.key }}: {{ item.value }}
{% endfor %}