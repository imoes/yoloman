# /etc/email-addresses - Exim4 alias file
# This file maps local system usernames to real email addresses for
# outgoing mail sent by the exim Mail Transfer Agent (MTA).
#
# Format: <local_user>: <email_address>
# Any local part (username) not present in this file will be qualified
# by the system domain (e.g., user@hostname) as per standard exim behavior.

# Email address for the system administrator.
# This address is used for outgoing mail from local users who do not have
# an explicit mapping defined here or in other exim alias files.
# Schema: admin_email
{{ 'root' }}: {{ admin_email | default('admin@example.com') }}

# Email address for the postmaster.
# This address is used for outgoing mail from other local users without
# explicit mappings. Postmaster is a standard system account.
# Schema: postmaster_email
{{ 'postmaster' }}: {{ postmaster_email | default('postmaster@example.com') }}