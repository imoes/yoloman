{
  "debug": {
    "type": "string",
    "default": "True",
    "description": "Enable debug mode"
  },
  "max_ram_cached_tiles": {
    "type": "number",
    "default": 1024,
    "description": "Maximum number of tiles to cache in RAM"
  },
  "tiles_cache": {
    "type": "string",
    "default": "/var/cache/twms/tiles",
    "description": "Path where to put cache"
  },
  "install_path": {
    "type": "string",
    "default": "/usr/share/twms",
    "description": "Path where to look for broken tiles and other stuff"
  },
  "gpx_cache": {
    "type": "string",
    "default": "/var/cache/twms/traces",
    "description": "Path where to store cached OSM GPX files"
  },
  "deadline": {
    "type": "number",
    "default": 45,
    "description": "Number of seconds given to make up an image"
  },
  "default_max_zoom": {
    "type": "number",
    "default": 18,
    "description": "Default maximum zoom level, can be overridden per layer"
  },
  "geometry_color_LINESTRING": {
    "type": "string",
    "default": "#ff0000",
    "description": "Default color for LINESTRING vectors"
  },
  "geometry_color_POLYGON": {
    "type": "string",
    "default": "#0000ff",
    "description": "Default color for POLYGON vectors"
  },
  "geometry_color_POINT": {
    "type": "string",
    "default": "#00ff00",
    "description": "Default color for POINT vectors"
  },
  "geometry_color_TEXT": {
    "type": "string",
    "default": "#000000",
    "description": "Default color for TEXT vectors"
  },
  "linestring_width": {
    "type": "number",
    "default": 3,
    "description": "Width of linestrings"
  },
  "cairo_font": {
    "type": "string",
    "default": "Sans 25",
    "description": "Default font for Cairo rendering"
  },
  "pil_font_path": {
    "type": "string",
    "default": "/usr/share/fonts/truetype/freefont/FreeSans.ttf",
    "description": "Path to TTF file for PIL rendering"
  },
  "pil_font_size": {
    "type": "number",
    "default": 25,
    "description": "Size for PIL font"
  },
  "default_layers": {
    "type": "string",
    "default": "",
    "description": "Layer(s) to show when no layers given explicitly. if False, overview is shown."
  },
  "max_height": {
    "type": "number",
    "default": 4095,
    "description": "Maximal image height in pixels"
  },
  "max_width": {
    "type": "number",
    "default": 4095,
    "description": "Maximal image width in pixels"
  },
  "output_quality": {
    "type": "number",
    "default": 75,
    "description": "Output image quality (matters for JPEG)"
  },
  "output_progressive": {
    "type": "string",
    "default": "True",
    "description": "Should image be progressive? (matters for JPEG)"
  },
  "output_optimize": {
    "type": "string",
    "default": "False",
    "description": "Should image be optimized? (matters for PNG)"
  },
  "default_background": {
    "type": "string",
    "default": "#ffffff",
    "description": "Default background color for empty space"
  },
  "default_vector_renderer": {
    "type": "string",
    "default": "cairo",
    "description": "Vector renderer to use: 'PIL' or 'cairo'",
    "enum": [
      "cairo",
      "PIL"
    ]
  },
  "service_url": {
    "type": "string",
    "default": "http://localhost:8080",
    "description": "URL service is installed at"
  },
  "wms_name": {
    "type": "string",
    "default": "twms based web map service",
    "description": "Name of the WMS service"
  },
  "default_bbox_min_lon": {
    "type": "number",
    "default": -180.0,
    "description": "Minimum longitude for default bounding box"
  },
  "default_bbox_min_lat": {
    "type": "number",
    "default": -85.0511287798,
    "description": "Minimum latitude for default bounding box"
  },
  "default_bbox_max_lon": {
    "type": "number",
    "default": 180.0,
    "description": "Maximum longitude for default bounding box"
  },
  "default_bbox_max_lat": {
    "type": "number",
    "default": 85.0511287798,
    "description": "Maximum latitude for default bounding box"
  },
  "default_format": {
    "type": "string",
    "default": "image/jpeg",
    "description": "Default image format",
    "enum": [
      "image/jpeg",
      "image/png"
    ]
  },
  "contact_person_mail": {
    "type": "string",
    "default": "",
    "description": "Contact person email address"
  },
  "contact_person_real_name": {
    "type": "string",
    "default": "",
    "description": "Contact person real name"
  },
  "contact_person_organization": {
    "type": "string",
    "default": "",
    "description": "Contact person organization"
  },
  "cache_tile_responses_base3857_jpg_path": {
    "type": "string",
    "default": "/disk/base3857/",
    "description": "Cache path for EPSG:3857 JPEG base tiles"
  },
  "cache_tile_responses_base3857_jpg_ext": {
    "type": "string",
    "default": "jpg",
    "description": "Cache extension for EPSG:3857 JPEG base tiles"
  },
  "cache_tile_responses_base3857_png_path": {
    "type": "string",
    "default": "/disk/base3857/",
    "description": "Cache path for EPSG:3857 PNG base tiles"
  },
  "cache_tile_responses_base3857_png_ext": {
    "type": "string",
    "default": "png",
    "description": "Cache extension for EPSG:3857 PNG base tiles"
  },
  "yhsat_ext": {
    "type": "string",
    "default": "jpg",
    "description": "Yahoo Satellite tile image extension"
  },
  "yhsat_scalable": {
    "type": "string",
    "default": "False",
    "description": "Whether Yahoo Satellite tiles can be scaled"
  },
  "yhsat_remote_url": {
    "type": "string",
    "default": "http://aerial.maps.yimg.com/ximg?v=1.8&t=a&s=256&r=1&x=%s&y=%s&z=%s",
    "description": "Yahoo Satellite remote URL template"
  },
  "yhsat_dead_tile": {
    "type": "string",
    "default": "yahoo_nxt.jpg",
    "description": "Filename of the dead tile for Yahoo Satellite"
  },
  "yhsat_min_zoom": {
    "type": "number",
    "default": 2,
    "description": "Minimum zoom level for Yahoo Satellite"
  },
  "yhsat_max_zoom": {
    "type": "number",
    "default": 18,
    "description": "Maximum zoom level for Yahoo Satellite"
  },
  "yhsat_proj": {
    "type": "string",
    "default": "EPSG:3857",
    "description": "Projection for Yahoo Satellite"
  },
  "yasat_ext": {
    "type": "string",
    "default": "jpg",
    "description": "Yandex Satellite tile image extension"
  },
  "yasat_scalable": {
    "type": "string",
    "default": "False",
    "description": "Whether Yandex Satellite tiles can be scaled"
  },
  "yasat_remote_url": {
    "type": "string",
    "default": "http://sat01.maps.yandex.net/tiles?l=sat&v=1.22.0&x=%s&y=%s&z=%s",
    "description": "Yandex Satellite remote URL template"
  },
  "yasat_dead_tile": {
    "type": "string",
    "default": "yandex_nxt.jpg",
    "description": "Filename of the dead tile for Yandex Satellite"
  },
  "yasat_proj": {
    "type": "string",
    "default": "EPSG:3395",
    "description": "Projection for Yandex Satellite"
  },
  "osm_ext": {
    "type": "string",
    "default": "png",
    "description": "OpenStreetMap tile image extension"
  },
  "osm_scalable": {
    "type": "string",
    "default": "False",
    "description": "Whether OSM tiles can be scaled"
  },
  "osm_remote_url": {
    "type": "string",
    "default": "http://c.tile.openstreetmap.org/%s/%s/%s.png",
    "description": "OpenStreetMap remote URL template"
  },
  "osm_proj": {
    "type": "string",
    "default": "EPSG:3857",
    "description": "Projection for OpenStreetMap"
  },
  "osm_empty_color": {
    "type": "string",
    "default": "#F1EEE8",
    "description": "Color for empty tiles in OSM layer"
  },
  "osm_cache_ttl": {
    "type": "number",
    "default": 864000,
    "description": "Cache TTL for OSM tiles in seconds"
  },
  "osm_be_remote_url": {
    "type": "string",
    "default": "http://tile.latlon.org/tiles/%s/%s/%s.png",
    "description": "OpenStreetMap Belarus remote URL template"
  },
  "osm_be_proj": {
    "type": "string",
    "default": "EPSG:3857",
    "description": "Projection for OpenStreetMap Belarus"
  },
  "osm_be_empty_color": {
    "type": "string",
    "default": "#f2efe9",
    "description": "Color for empty tiles in OSM Belarus layer"
  },
  "osm_be_bbox_min_lon": {
    "type": "number",
    "default": 23.16722,
    "description": "Minimum longitude for OSM Belarus bounding box"
  },
  "osm_be_bbox_min_lat": {
    "type": "number",
    "default": 51.2593,
    "description": "Minimum latitude for OSM Belarus bounding box"
  },
  "osm_be_bbox_max_lon": {
    "type": "number",
    "default": 32.82244,
    "description": "Maximum longitude for OSM Belarus bounding box"
  },
  "osm_be_bbox_max_lat": {
    "type": "number",
    "default": 56.18162,
    "description": "Maximum latitude for OSM Belarus bounding box"
  },
  "landsat_ext": {
    "type": "string",
    "default": "jpg",
    "description": "Landsat tile image extension"
  },
  "landsat_remote_url": {
    "type": "string",
    "default": "http://onearth.jpl.nasa.gov/wms.cgi?request=GetMap&layers=global_mosaic&styles=&format=image/jpeg&",
    "description": "Landsat remote URL template"
  },
  "landsat_max_zoom": {
    "type": "number",
    "default": 14,
    "description": "Maximum zoom level for Landsat"
  },
  "landsat_proj": {
    "type": "string",
    "default": "EPSG:4326",
    "description": "Projection for Landsat"
  },
  "landsat_wms_proj": {
    "type": "string",
    "default": "EPSG:4326",
    "description": "Projection to ask from WMS for Landsat"
  },
  "latlonsat_ext": {
    "type": "string",
    "default": "jpg",
    "description": "LatLonSat tile image extension"
  },
  "latlonsat_remote_url": {
    "type": "string",
    "default": "http://dev.latlon.org/cgi-bin/ms?FORMAT=image/jpeg&VERSION=1.1.1&SERVICE=WMS&REQUEST=GetMap&Layers=sat,plane&",
    "description": "LatLonSat remote URL template"
  },
  "latlonsat_max_zoom": {
    "type": "number",
    "default": 19,
    "description": "Maximum zoom level for LatLonSat"
  },
  "latlonsat_proj": {
    "type": "string",
    "default": "EPSG:3857",
    "description": "Projection for LatLonSat"
  },
  "latlonsat_wms_proj": {
    "type": "string",
    "default": "EPSG:3857",
    "description": "Projection to ask from WMS for LatLonSat"
  }
}
