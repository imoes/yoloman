# Matrox Video Output Configuration
# Generated by matroxset configuration template

# Path to the frame buffer device to manipulate (e.g., /dev/fb0, /dev/fb1).
# Corresponds to: -f DEVICE
FB_DEVICE={{ fb_device | default('/dev/fb1') }}

# The output head to configure (0 is primary, 1 is secondary).
# Corresponds to: -o OUTPUT
OUTPUT_HEAD={{ output_head | default(1) }}

# The video output mode value (128=Monitor, 1=PAL TV, 2=NTSC TV).
# Corresponds to: -o OUTPUT VALUE
OUTPUT_MODE={{ output_mode | default(128) }}

# Bitmask of outputs to connect (0=None, 1=Primary, 2=Secondary, 4=Digital Flat Panel).
# Corresponds to: -m VALUE
OUTPUT_MAP={{ output_map | default(1) }}

# If true, enables control value get/set mode (-c).
# Corresponds to: -c
ENABLE_CONTROL={{ enable_control | default(False) | lower }}

# If true, lists available controls (-l).
# Corresponds to: -l
LIST_CONTROLS={{ list_controls | default(False) | lower }}

# If true, displays information about blanking (-p).
# Corresponds to: -p
SHOW_BLANKING={{ show_blank_info | default(False) | lower }}