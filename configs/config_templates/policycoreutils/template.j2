# policycoreutils configuration
# This file defines system-level paths for core utilities and processes
# managed or referenced by the policycoreutils package.

[files]
# Path to the system password database file
{{ passwd_file | default('/etc/passwd') }}
# Path to the system shadow password file (requires root privileges)
{{ shadow_file | default('/etc/shadow') }}
# Path to the GNU Bash shell executable
{{ bash_path | default('/bin/bash') }}
# Path to the login program used for console access
{{ login_path | default('/bin/login') }}
# Path to the POSIX shell executable (often symlinked to bash or dash)
{{ sh_path | default('/bin/sh') }}
# Path to the getty program for handling physical console logins
{{ agetty_path | default('/sbin/agetty') }}
# Path to the system init process (PID 1)
{{ init_path | default('/sbin/init') }}
# Path to the mingetty program (legacy console login handler)
{{ mingetty_path | default('/sbin/mingetty') }}
# Path to the OpenSSH secure shell daemon binary
{{ sshd_path | default('/usr/sbin/sshd') }}
# Path to the GNU C Library shared object
{{ libc_so_path | default('/lib/libc.so.6') }}
# Path to the 32-bit ELF dynamic linker/loader
{{ ld_linux_so2_path | default('/lib/ld-linux.so.2') }}
# Path to the Solaris-style dynamic linker loader
{{ ld_so1_path | default('/lib/ld.so.1') }}

[process]
# Default process name/command for mingetty instances
{{ mingetty_process | default('/sbin/mingetty') }}
# Default process name/command for agetty instances
{{ agetty_process | default('/sbin/agetty') }}
# Default process name/command for sshd instances
{{ sshd_process | default('/usr/sbin/sshd') }}
