[files]
# Path to the passwd file (contains user account information)
{{ passwd_file | default('/etc/passwd') }}

# Path to the shadow file (contains encrypted password hashes)
{{ shadow_file | default('/etc/shadow') }}

# Path to bash (the Bourne Again SHell interpreter)
{{ bash_path | default('/bin/bash') }}

# Path to login (the program that logs users in on the console)
{{ login_path | default('/bin/login') }}

# Path to sh (the POSIX-compliant shell interpreter)
{{ sh_path | default('/bin/sh') }}

# Path to agetty (the program that manages getty processes for console login)
{{ agetty_path | default('/sbin/agetty') }}

# Path to init (the first process started by the kernel during boot)
{{ init_path | default('/sbin/init') }}

# Path to mingetty (a simplified getty for text-mode login)
{{ mingetty_path | default('/sbin/mingetty') }}

# Path to sshd (the OpenSSH server daemon)
{{ sshd_path | default('/usr/sbin/sshd') }}

# Path to libc.so.6 (the standard C library shared object)
{{ libc_so_path | default('/lib/libc.so.6') }}

# Path to ld-linux.so.2 (the dynamic linker/loader for ELF i386 binaries)
{{ ld_linux_so2_path | default('/lib/ld-linux.so.2') }}

# Path to ld.so.1 (the dynamic linker/loader for ELF sparc/sparc64 binaries)
{{ ld_so1_path | default('/lib/ld.so.1') }}

[process]
# Path to the mingetty process
{{ mingetty_process | default('/sbin/mingetty') }}

# Path to the agetty process
{{ agetty_process | default('/sbin/agetty') }}

# Path to the sshd process
{{ sshd_process | default('/usr/sbin/sshd') }}