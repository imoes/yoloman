{
  "bind_address": "127.0.0.1",
  "port": 10041,
  "max_connections": 512,
  "n_workers": 4,
  "db_path": "/var/lib/groonga/db",
  "log": true,
  "log_level": "warn",
  "log_path": "/var/log/groonga/groonga.log",
  "compression": true,
  "ssl": true,
  "ssl_cert_path": "/etc/ssl/certs/groonga.crt",
  "ssl_key_path": "/etc/ssl/private/groonga.key",
  "ssl_ca_cert_path": "/etc/ssl/certs/ca-chain.crt",
  "extra_args": [
    "--plugin-dir=/usr/lib/groonga/plugins",
    "--enable-plugin=logger"
  ]
}
