# Listen address for GQTP server
bind_address {{ bind_address }}

# Listen port for GQTP server
port {{ port }}

# Maximum number of connections
max_connections {{ max_connections }}

# Number of worker threads
n_workers {{ n_workers }}

# Root directory for database storage
db_path {{ db_path }}

# Enable/disable logging
log {{ log }}

# Log level (debug, info, notice, warn, error)
log_level {{ log_level }}

# Log file path (empty string disables file logging)
log_path {{ log_path }}

# Enable/disable compression
compression {{ compression }}

# Enable/disable SSL/TLS (requires groonga with SSL support)
ssl {{ ssl }}

# SSL certificate file path
ssl_cert_path {{ ssl_cert_path }}

# SSL private key file path
ssl_key_path {{ ssl_key_path }}

# SSL CA certificate chain file path (optional)
{% if ssl_ca_cert_path %}
ssl_ca_cert_path {{ ssl_ca_cert_path }}
{% endif %}

# Additional command-line arguments passed to groonga_server_gqtp
{% for arg in extra_args %}
{{ arg }}
{% endfor %}