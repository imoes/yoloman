{
  "databases": [
    {
      "name": "myapp",
      "host": "10.0.1.10",
      "port": 5432,
      "dbname": "production",
      "auth_user": "myapp_pooler"
    },
    {
      "name": "analytics",
      "host": "10.0.1.20",
      "port": 5432,
      "dbname": "analytics_db"
    }
  ],
  "listen_addr": "0.0.0.0",
  "listen_port": 6432,
  "unix_socket_dir": "/var/run/pgbouncer",
  "unix_socket_mode": "0770",
  "auth_type": "scram-sha-256",
  "auth_file": "/etc/pgbouncer/userlist.txt",
  "auth_user": "",
  "pool_mode": "transaction",
  "max_client_conn": 200,
  "default_pool_size": 10,
  "min_pool_size": 2,
  "max_server_conn": 50,
  "server_idle_timeout": 600,
  "log_connections": true,
  "log_disconnections": true,
  "log_pooler_errors": true,
  "admin_users": [
    "postgres",
    "admin"
  ],
  "stats_users": [
    "stats_user"
  ],
  "log_file": "",
  "pidfile": "/var/run/pgbouncer/pgbouncer.pid",
  "server_reset_query_always": true,
  "server_reset_query": "DISCARD ALL",
  "server_check_query": "SELECT 1",
  "server_check_delay": 30,
  "query_timeout": 60,
  "connect_timeout": 15,
  "client_idle_timeout": 0,
  "max_query_count": 10000,
  "delayed_client_start": "5s",
  "reserve_pool_size": 5,
  "reserve_pool_timeout": 2,
  "resolve_conf": false,
  "tcp_fastopen": false,
  "tls_mode": "prefer",
  "tls_cert": "/etc/pgbouncer/pgbouncer.pem",
  "tls_key": "/etc/pgbouncer/pgbouncer.key",
  "tls_ca": "/etc/pgbouncer/ca.pem",
  "tls_crl": "",
  "server_tls_mode": "verify-full",
  "server_tls_cert": "/etc/pgbouncer/server.pem",
  "server_tls_key": "/etc/pgbouncer/server.key",
  "server_tls_ca": "/etc/pgbouncer/server_ca.pem",
  "server_tls_crl": ""
}
