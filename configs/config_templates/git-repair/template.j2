# git-repair(1) configuration file
# This file is sourced as a shell script by git-repair(1).
# Ensure the variables are exported or sourced correctly in your shell environment.

# force: If true, enables --force mode to rewrite history when standard repair fails.
#         Never touches tags.
#         Default: false
{% if force | default(false) %}FORCE=1{% else %}FORCE=0{% endif %}

# numtests: Number of random corruption tests to perform in self-test mode (--test).
#           Default: 10
NUMTESTS={{ numtests | default(10) }}

# retry: Number of retries for each self-test in case of transient failure (--test).
#        Default: 3
RETRY={{ retry | default(3) }}