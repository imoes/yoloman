# Mokutil Shim Configuration
# This file configures the UEFI Secure Boot MOK (Machine Owner Key) management behavior.
# It maps to mokutil command-line flags for setting persistent UEFI variables.

# Sets SHIM_VERBOSE environment variable. Corresponds to --set-verbosity.
# Values: true, false
SHIM_VERBOSE={{ shim_verbose | default('false') }}

# Sets FALLBACK_VERBOSE environment variable. Corresponds to --set-fallback-verbosity.
# Values: true, false
FALLBACK_VERBOSE={{ fallback_verbose | default('false') }}

# Sets FB_NO_REBOOT environment variable. Corresponds to --set-fallback-noreboot.
# Values: true, false
FB_NO_REBOOT={{ fallback_noreboot | default('false') }}

# Sets SbatPolicy UEFI Variable. Corresponds to --set-sbat-policy.
# Values: latest, automatic, delete
SBAT_POLICY={{ sbat_policy | default('latest') }}

# Sets SspPolicy UEFI Variable. Corresponds to --set-ssp-policy.
# Values: latest, automatic, delete
SSP_POLICY={{ ssp_policy | default('latest') }}

# Sets the timeout for MOK prompt in seconds. Corresponds to --timeout.
# Range: -1 to 32767 (0x7fff)
MOK_TIMEOUT={{ mok_timeout | default('5') }}

# Tells shim to not use keys in db to verify EFI images. Corresponds to --ignore-db.
# Values: true, false
IGNORE_DB={{ ignore_db | default('false') }}