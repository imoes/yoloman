{
  "ldap_uris": [
    "ldap://ldap.example.com/",
    "ldap://ldap-backup.example.com/"
  ],
  "ldap_base": "dc=example,dc=com",
  "ldap_version": 3,
  "ldap_bind_dn": "cn=admin,dc=example,dc=com",
  "ldap_bind_pw": "secret",
  "sasl_mech": "",
  "sasl_authzid": "",
  "tls_cacert": "/etc/ssl/certs/ca-certificates.crt",
  "tls_cert": "",
  "tls_key": "",
  "tls_reqcert": "demand",
  "ssl_mode": "start_tls",
  "reconnect_retry": 60,
  "nslcd_threads": 8,
  "min_uid": 1000,
  "max_uid": 65534,
  "user_maps": [
    {
      "name": "passwd",
      "map_passwd": "uid uidNumber cn homeDirectory loginShell gidNumber gecos shadowLastChange",
      "map_shadow": "uid userPassword shadowLastChange shadowMax shadowWarning shadowInactive shadowExpire shadowFlag",
      "map_group": "cn gidNumber memberUid",
      "filter": "(objectClass=posixAccount)"
    }
  ],
  "group_maps": [
    {
      "name": "group",
      "ldap_attr": "cn",
      "local_attr": "cn"
    }
  ],
  "pam_maps": [
    {
      "name": "login",
      "filter": "(objectClass=posixAccount)",
      "login_attr": "uid",
      "ssh_authz_attr": "uid"
    }
  ],
  "base_time": 3600,
  "reconnect_time": 60,
  "daemon_uid": "nslcd",
  "daemon_gid": "nslcd",
  "listen_addr": "/var/run/nslcd/nslcd.ctl",
  "pidfile": "/run/nslcd.pid",
  "debug": true
}
