{
  "ldap_uris": [
    "ldap://localhost/"
  ],
  "ldap_base": "dc=example,dc=com",
  "ldap_version": 3,
  "ldap_bind_dn": "",
  "ldap_bind_pw": "",
  "sasl_mech": "",
  "sasl_authzid": "",
  "tls_cacert": "",
  "tls_cert": "",
  "tls_key": "",
  "tls_reqcert": "demand",
  "ssl_mode": "",
  "reconnect_retry": 60,
  "nslcd_threads": 5,
  "min_uid": 1000,
  "max_uid": 65534,
  "user_maps": [
    {
      "name": "passwd",
      "map_passwd": "uid uidNumber cn homeDirectory loginShell gidNumber gecos shadowLastChange",
      "map_shadow": "uid userPassword shadowLastChange shadowMax shadowWarning shadowInactive shadowExpire shadowFlag",
      "map_group": "cn gidNumber memberUid",
      "filter": "(objectClass=posixAccount)"
    },
    {
      "name": "shadow",
      "filter": "(objectClass=posixAccount)"
    }
  ],
  "group_maps": [
    {
      "name": "group",
      "ldap_attr": "cn",
      "local_attr": "cn"
    }
  ],
  "k5start_start": "",
  "k5start_bin": "/usr/bin/k5start",
  "k5start_keytab": "/etc/krb5.keytab",
  "k5start_ccrefresh": 60,
  "k5start_principal": "host/$(hostname -f)"
}
