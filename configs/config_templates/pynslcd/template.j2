# ============================================================
# nslcd (NSLCD Daemon) Configuration Template
# ============================================================
# This file configures the nslcd init script defaults, specifically
# focusing on Kerberos ticket management via k5start.
# nslcd uses these settings to automatically obtain and renew
# Kerberos tickets for GSSAPI/SASL authentication with directory servers.
#
# Self-Documentation:
# Every variable below uses | default(...) to ensure safe rendering even
# if the variable is undefined in the Ansible play.
# Comments above each directive describe the schema field's purpose.
# ============================================================

# ---------------------------------------------------------------------------
# Section: k5start Activation
# ---------------------------------------------------------------------------
# k5start_start: Whether to force starting k5start: "yes" to enable, empty
# (or any other value) to disable. Default empty (disabled unless auto-detected).
# ---------------------------------------------------------------------------
{% if k5start_start is defined and k5start_start is not none and (k5start_start is number or k5start_start is boolean or k5start_start | length > 0) %}K5START_START="{{ k5start_start | default('') }}"{% else %}#K5START_START="yes"{% endif %}

# ---------------------------------------------------------------------------
# Section: k5start Execution Options
# ---------------------------------------------------------------------------

# k5start_bin: Path to k5start binary.
# ---------------------------------------------------------------------------
{% if k5start_bin is defined and k5start_bin is not none and (k5start_bin is number or k5start_bin is boolean or k5start_bin | length > 0) %}K5START_BIN={{ k5start_bin | default('/usr/bin/k5start') }}{% else %}#K5START_BIN=/usr/bin/k5start{% endif %}

# k5start_keytab: Path to Kerberos keytab file for k5start.
# ---------------------------------------------------------------------------
{% if k5start_keytab is defined and k5start_keytab is not none and (k5start_keytab is number or k5start_keytab is boolean or k5start_keytab | length > 0) %}K5START_KEYTAB={{ k5start_keytab | default('/etc/krb5.keytab') }}{% else %}#K5START_KEYTAB=/etc/krb5.keytab{% endif %}

# k5start_ccrefresh: Seconds between Kerberos ticket refresh by k5start.
# ---------------------------------------------------------------------------
{% if k5start_ccrefresh is defined and k5start_ccrefresh is not none and (k5start_ccrefresh is number or k5start_ccrefresh is boolean or k5start_ccrefresh | length > 0) %}K5START_CCREFRESH={{ k5start_ccrefresh | default(60) }}{% else %}#K5START_CCREFRESH=60{% endif %}

# k5start_principal: Kerberos principal for k5start.
# ---------------------------------------------------------------------------
{% if k5start_principal is defined and k5start_principal is not none and (k5start_principal is number or k5start_principal is boolean or k5start_principal | length > 0) %}K5START_PRINCIPAL="{{ k5start_principal | default('host/$(hostname -f)') }}"{% else %}#K5START_PRINCIPAL="host/$(hostname -f)"{% endif %}
