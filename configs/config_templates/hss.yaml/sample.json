{
  "log_level": "info",
  "log_file": "/var/log/nextepc/hss.log",
  "mongodb_host": "127.0.0.1",
  "mongodb_port": 27017,
  "mongodb_name": "nextepc",
  "mongodb_username": "",
  "mongodb_password": "",
  "hss_realm": "open5gs.org",
  "hss_fqdn": "hss.open5gs.org",
  "hss_cc": "001",
  "hss_mnc": "01",
  "s6a_listen_addr": "0.0.0.0",
  "s6a_listen_port": 3868,
  "s6a_tls_enabled": true,
  "s6a_tls_cert": "/etc/nextepc/certs/hss.crt",
  "s6a_tls_key": "/etc/nextepc/certs/hss.key",
  "s6a_tls_ca": "/etc/nextepc/certs/ca.crt",
  "s6a_peers": [
    {
      "name": "mme1",
      "hostname": "mme1.open5gs.org",
      "dest_host": "mme1.open5gs.org",
      "dest_realm": "open5gs.org"
    },
    {
      "name": "mme2",
      "hostname": "mme2.open5gs.org",
      "dest_host": "mme2.open5gs.org",
      "dest_realm": "open5gs.org"
    }
  ],
  "max_subscriptions_per_imsi": 10,
  "default_apn": "internet",
  "default_qci": 9,
  "default_ambr_uplink_mbps": 100,
  "default_ambr_downlink_mbps": 200,
  "enable_sdr": false,
  "sdr_interval_sec": 300,
  "send_ulr_on_registration": true
}
