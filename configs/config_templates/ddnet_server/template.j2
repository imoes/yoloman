# Server listen address (IP:port or hostname:port)
bind = {{ bind_address }}

# TCP port to listen on (ignored if bind includes port)
port = {{ port }}

# Game password (empty = no password required)
password = "{{ password }}"

# RCON password (for remote administration)
rcon_password = "{{ rcon_password }}"

# Server name displayed in server list
server_name = "{{ server_name }}"

# Server message of the day (shown on connect)
motd = "{{ motd }}"

# Max players (0 = unlimited, but system limits apply)
max_clients = {{ max_clients }}

# Max players per IP (0 = unlimited)
max_clients_per_ip = {{ max_clients_per_ip }}

# Enable spectator mode
spectator_mode = {{ spectator_mode | lower }}

# Max spectators
max_spectators = {{ max_spectators }}

# Game mode (e.g., "ddrace", "ddnet", "standard")
game_type = "{{ game_type }}"

# Map to load at startup (empty = random from mapgroup)
map = "{{ map }}"

# Default map group (if map is empty)
map_group = "{{ map_group }}"

# Enable voting system
vote_enabled = {{ vote_enabled | lower }}

# Allow votes for map change
vote_kick = {{ vote_kick | lower }}

# Allow votes for map restart
vote_restart = {{ vote_restart | lower }}

# Allow votes for spectator mode
vote_spectator = {{ vote_spectator | lower }}

# Kick timeout after vote passes (seconds)
vote_kick_timeout = {{ vote_kick_timeout }}

# Time between map changes (seconds, 0 = manual)
map_change_interval = {{ map_change_interval }}

# Time between map group rotations (seconds, 0 = manual)
map_group_rotation_interval = {{ map_group_rotation_interval }}

# Log file path (empty = no file logging)
log_file = "{{ log_file }}"

# Enable debug logging
debug = {{ debug | lower }}

# Admin accounts (one per line; use "name" or "name:ip" or "ip")
{% for admin in admins %}admin = "{{ admin.name }}"{% if admin.ip %}#{{ admin.ip }}{% endif %}
{% endfor %}

# Rate limit for connections (0 = disabled)
rate_limit = {{ rate_limit }}

# Enable IPv6 (if supported and bind includes IPv6)
ipv6 = {{ ipv6 | lower }}

# Enable DDNet-specific features (e.g., double-jump, hook-collision)
ddnet_compat = {{ ddnet_compat | lower }}

# Allow clients to send custom skin data
allow_custom_skins = {{ allow_custom_skins | lower }}

# Path to custom skins directory (if allow_custom_skins = true)
skins_dir = "{{ skins_dir }}"

# Enable DDRace-style teams
ddrace_teams = {{ ddrace_teams | lower }}

# Minimum time (seconds) between client connections from same IP
anti_flood = {{ anti_flood }}

# Enable server announcement to master list
announce = {{ announce | lower }}

# Master server announce address (optional; defaults to official DDNet master)
{% if announce_master %}announce_master = "{{ announce_master }}"{% endif %}

# Server version string (optional; leave empty for auto)
version = "{{ version }}"

# Server region code (e.g., "us", "eu")
region = "{{ region }}"

# Server country code (ISO 3166-1 alpha-2)
country = "{{ country }}"

# Server location (user-facing string, e.g., "New York, USA")
location = "{{ location }}"

# Enable TLS for webadmin (if webadmin enabled)
webadmin_tls = {{ webadmin_tls | lower }}

# Webadmin port (0 = disabled)
webadmin_port = {{ webadmin_port }}

# Webadmin bind address
webadmin_bind = "{{ webadmin_bind }}"
