# Ayatana Indicator Notifications desktop entry configuration
# This file defines the application entry for the notification indicator service.
# It is typically placed in /usr/share/applications or similar XDG directories.

# Type of entry; must be Application for executable programs.
Type=Application

# Human-readable display name of the application.
Name=Ayatana Indicator Notifications

# Command line to execute.
# Uses service_dir to locate the binary under /usr/libexec.
# The binary name is expected to match the service directory name.
Exec=/usr/libexec/{{ service_dir | default('ayatana-indicator-notifications') }}/{{ service_dir | default('ayatana-indicator-notifications') }}-service

# Desktop environments where this application should be shown.
# Semicolon-separated list.
OnlyShowIn=Unity;MATE;XFCE;

# Whether the application should be hidden from application menus.
# true hides it from the main menu, though it may still appear in panels/indicators.
NoDisplay=true

# Whether to send startup notification events to the window manager.
# false disables this, as indicators usually don't need it.
StartupNotify=false

# Whether to open the application in a terminal window.
# false runs it in the background.
Terminal=false
