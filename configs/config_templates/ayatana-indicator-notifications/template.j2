# Desktop entry configuration for Ayatana Indicator Notifications
# This file defines the notification daemon as a background application
# for desktop environments like Unity, MATE, and XFCE.

[Desktop Entry]

# Type of the desktop entry; must be Application for a daemon/service
Type=Application

# Display name of the application
Name=Ayatana Indicator Notifications

# Execution command for the service
# Uses the service_dir variable to locate the binary under /usr/libexec
Exec=/usr/libexec/{{ service_dir | default('ayatana-indicator-notifications') }}/ayatana-indicator-notifications-service

# Desktop environments in which this application should appear
# Semicolon-separated list
OnlyShowIn=Unity;MATE;XFCE;

# Do not display this entry in application menus
# It is a background service, not a user-invoked app
NoDisplay=true

# Do not request startup notification from the window manager
StartupNotify=false

# Do not open a terminal window for this application
Terminal=false