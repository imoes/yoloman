# hd-idle configuration file
# Each line defines a disk to manage and its idle timeout (in seconds)
# Syntax: -a <device> -i <idle_time> [-t] [-u <user>] [-p <pidfile>]
{% for disk in disks %}-a {{ disk.device }} -i {{ disk.idle_time }}{% if disk.spin_down_test is defined %} -t{% endif %}{% if disk.user is defined %} -u {{ disk.user }}{% endif %}{% if disk.pidfile is defined %} -p {{ disk.pidfile }}{% endif %}
{% endfor %}