{
  "rules": [
    {
      "type": "group",
      "condition": "*",
      "group": "users",
      "description": "Assign all users to the 'users' group by default",
      "comment": "base membership"
    },
    {
      "type": "group",
      "condition": "root",
      "group": "root",
      "description": "Ensure root is in the root group",
      "comment": "system requirement"
    },
    {
      "type": "group",
      "condition": "wheel",
      "group": "sudo",
      "description": "Members of 'wheel' user group get sudo access"
    },
    {
      "type": "group",
      "condition": "lp",
      "group": "lpadmin",
      "description": "Allow printer operators to manage printers"
    },
    {
      "type": "time",
      "condition": "* !Al0000-0800",
      "group": "restricted",
      "description": "Outside business hours, assign users to 'restricted' group"
    }
  ]
}
