{#
  btscanner.conf - Configuration for btscanner Bluetooth scanner
  This template generates a configuration file based on the schema definitions.
  The output is an XML-style configuration structure that btscanner expects.
#}

{# --- File Definitions --- #}
<!--
  files: The list of configuration/resource files used by btscanner.
-->
<files>

  {#
  * log: Path to the log file
  * Default: /var/log/btscanner.log
  #}
  <log>{{ log_file | default('/var/log/btscanner.log') }}</log>

  {#
  * oui: Path to the OUI (Organizationally Unique Identifier) database file.
  * Default: /usr/share/btscanner/oui.txt
  #}
  <oui>{{ oui_file | default('/usr/share/btscanner/oui.txt') }}</oui>

  {#
  * store: Path to the store file where discovered device details are saved.
  * Default: /var/lib/btscanner/store.db
  #}
  <store>{{ store_file | default('/var/lib/btscanner/store.db') }}</store>

</files>

{# --- Scan Range Definitions --- #}
<!--
  rangedef: Defines a scan range.
  Attributes:
    start: Start MAC address of the scan range.
    end:   End MAC address of the scan range.

  If rangedef_start and rangedef_end are both empty strings, no range definition
  is emitted. If only one is provided, the behavior is undefined by this template
  (best practice is to provide both).
#}
{% if (rangedef_start | default('')) and (rangedef_end | default('')) %}
<rangedef start="{{ rangedef_start | default('') }}" end="{{ rangedef_end | default('') }}">

  {#
  * vulnerabilities: Comma-separated list of vulnerability checks to perform.
  * Default: '' (empty)
  #}
  <vulnerabilities>{{ vulnerabilities | default('') }}</vulnerabilities>

  {#
  * name: Whether to query and record device names.
  * Default: False
  #}
  {% if (name | default(False) | bool) %}<name/>
  {% endif %}

  {#
  * hci: Whether to query HCI (Host Controller Interface) information.
  * Default: False
  #}
  {% if (hci | default(False) | bool) %}<hci/>
  {% endif %}

  {#
  * rssi: Whether to query RSSI (Received Signal Strength Indicator) values.
  * Default: False
  #}
  {% if (rssi | default(False) | bool) %}<rssi/>
  {% endif %}

  {#
  * lq: Whether to query link quality.
  * Default: False
  #}
  {% if (lq | default(False) | bool) %}<lq/>
  {% endif %}

  {#
  * txpwr: Whether to query transmit power.
  * Default: False
  #}
  {% if (txpwr | default(False) | bool) %}<txpwr/>
  {% endif %}

  {#
  * sdp: Whether to perform SDP (Service Discovery Protocol) service discovery.
  * Default: False
  #}
  {% if (sdp | default(False) | bool) %}<sdp/>
  {% endif %}

</rangedef>
{% endif %}