{
  "server": {
    "type": "object",
    "properties": {
      "host_name": {
        "type": "string",
        "default": "",
        "description": "Custom mDNS host name to publish (leave empty to use system hostname)"
      },
      "domain_name": {
        "type": "string",
        "default": "local",
        "description": "Domain suffix to use for mDNS names (typically 'local')"
      },
      "config_dir": {
        "type": "string",
        "default": "/etc/avahi",
        "description": "Directory where Avahi expects its configuration files"
      }
    },
    "default": {}
  },
  "reflector": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable DNS-SD service reflection across subnets (required only for multi-subnet discovery)"
      }
    },
    "default": {}
  },
  "discovery": {
    "type": "object",
    "properties": {
      "enabled_services": {
        "type": "list",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Service name (e.g., '_http._tcp', '_ipp._tcp')"
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable publishing of this service (e.g., '_ipp._tcp' for CUPS printer sharing)"
            }
          },
          "required": [
            "name",
            "enabled"
          ]
        },
        "default": [
          {
            "name": "_http._tcp",
            "enabled": true
          },
          {
            "name": "_ipp._tcp",
            "enabled": true
          },
          {
            "name": "_printer._tcp",
            "enabled": true
          },
          {
            "name": "_uscan._tcp",
            "enabled": true
          },
          {
            "name": "_cups._tcp",
            "enabled": true
          }
        ],
        "description": "List of services to enable for publishing via mDNS/DNS-SD"
      },
      "allow_interfaces": {
        "type": "list",
        "items": {
          "type": "string",
          "description": "Network interface name (e.g., 'eth0', 'wlan0')"
        },
        "default": [
          "eth0"
        ],
        "description": "List of interfaces Avahi will use for mDNS/DNS-SD discovery (use empty list to allow all)"
      }
    },
    "default": {}
  }
}
