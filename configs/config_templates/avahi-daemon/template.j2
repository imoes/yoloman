# ============================================================================
# Avahi mDNS/DNS-SD Daemon Configuration
# ============================================================================
# This file configures the avahi-daemon service, which implements
# Multicast DNS (mDNS) and DNS Service Discovery (DNS-SD). It allows
# your Linux host to be discovered on the local network without a
# central DNS server.
#
# Reference: avahi-daemon.conf(5)
# ============================================================================

[server]
# ============================================================================
# [server] Section: Core mDNS Server Settings
# ============================================================================

# Custom mDNS host name to publish (leave empty to use system hostname)
# If left empty, the system's default hostname is used.
host-name={{ (server | default({})).host_name | default('') }}

# Domain suffix to use for mDNS names (typically 'local')
# Services published here will be accessible as <name>.<domain-name>
domain-name={{ (server | default({})).domain_name | default('local') }}

# Whether to use IPv4 for mDNS traffic
use-ipv4=yes

# Whether to use IPv6 for mDNS traffic
use-ipv6=yes

# List of interfaces Avahi will use for mDNS/DNS-SD discovery
# Use empty list (commented out) to allow all interfaces.
# To restrict, specify interfaces like: allow-interfaces=eth0,eth1
{% if (discovery | default({})).allow_interfaces | default([]) | length > 0 %}
allow-interfaces={{ (discovery | default({})).allow_interfaces | default([]) | join(',') }}
{% endif %}

# Rate limiting for mDNS responses to prevent broadcast storms
ratelimit-interval-usec=1000000
ratelimit-burst=1000

[wide-area]
# ============================================================================
# [wide-area] Section: Wide-Area mDNS
# ============================================================================

# Enable wide-area mDNS (forwarding mDNS across routers)
# Generally discouraged for security/performance reasons on large networks.
enable-wide-area=yes

[publish]
# ============================================================================
# [publish] Section: Service Publication Settings
# ============================================================================

# Publish the system's HINFO record (Hardware/Software info)
# Disabled by default to avoid leaking system details.
publish-hinfo=no

# Publish the system as a workstation service
# Disabled by default.
publish-workstation=no

[reflector]
# ============================================================================
# [reflector] Section: DNS-SD Service Reflection
# ============================================================================

# Enable DNS-SD service reflection across subnets
# Required only for multi-subnet discovery where routers do not forward mDNS.
enable-reflector={{ (reflector | default({})).enabled | default(False) | lower }}

[rlimits]
# ============================================================================
# [rlimits] Section: Resource Limits
# ============================================================================
# Leave commented out to use system defaults.
# Uncomment and adjust if you encounter "too many files" or memory issues.
#
# rlimit-as=
# rlimit-core=0
# rlimit-data=8388608
# rlimit-fsize=0
# rlimit-nofile=768
# rlimit-stack=8388608
# rlimit-nproc=3