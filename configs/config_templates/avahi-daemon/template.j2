# ==============================================================================
# Avahi Daemon Configuration Template
# ==============================================================================
# This template generates the avahi-daemon.conf file.
# It is self-documenting: every variable is sourced from the role's schema
# with explicit defaults, and comments explain the purpose of each setting.
#
# See avahi-daemon.conf(5) for upstream documentation.
# ==============================================================================

[server]
# Custom mDNS host name to publish (leave empty to use system hostname)
host-name={{ (server | default({})).host_name | default('') }}

# Domain suffix to use for mDNS names (typically 'local')
domain-name={{ (server | default({})).domain_name | default('local') }}

# Browse domains for service discovery
# browse-domains=0pointer.de, zeroconf.org

# Enable IPv4 mDNS support
use-ipv4=yes

# Enable IPv6 mDNS support
use-ipv6=yes

# List of interfaces Avahi will use for mDNS/DNS-SD discovery (use empty list to allow all)
# If empty, Avahi uses all available interfaces.
# To restrict, provide a list like: ["eth0", "wlan0"]
allow-interfaces={{ (discovery | default({})).allow_interfaces | default([]) | join(', ') }}

# Deny specific interfaces from Avahi operation
# deny-interfaces=eth1

# Check response TTL for stale entries
# check-response-ttl=no

# Only use interfaces that are running (up)
# use-iff-running=no

# Enable D-Bus interface
# enable-dbus=yes

# Allow other DNS stacks (like systemd-resolved) to coexist
# disallow-other-stacks=no

# Allow point-to-point interfaces
# allow-point-to-point=no

# Maximum number of cached entries
# cache-entries-max=4096

# Maximum number of connected clients
# clients-max=4096

# Maximum objects per client
# objects-per-client-max=1024

# Maximum entries per entry group
# entries-per-entry-group-max=32

# Rate limiting: interval in microseconds between allowed messages
ratelimit-interval-usec=1000000

# Rate limiting: burst size allowed before dropping messages
ratelimit-burst=100

[wide-area]
# Enable wide-area mDNS discovery across the internet or large networks
enable-wide-area=yes

[publish]
# Enable general service publishing
# disable-publishing=no

# Disable publishing of user services (e.g., from systemd)
# disable-user-service-publishing=no

# Add a cookie to published services for uniqueness
# add-service-cookie=no

# Publish local IP addresses in PTR records
# publish-addresses=yes

# Publish HINFO records (CPU/OS info)
publish-hinfo=no

# Publish workstation service records
publish-workstation=no

# Publish domain service records
# publish-domain=yes

# Publish DNS servers from resolv.conf
# publish-dns-servers=192.168.50.1, 192.168.50.2
# publish-resolv-conf-dns-servers=yes

# Publish AAAA records even when IPv4 is used
# publish-aaaa-on_ipv4=yes

# Publish A records even when IPv6 is used
# publish-a-on_ipv6=no

[reflector]
# Enable DNS-SD service reflection across subnets (required only for multi-subnet discovery)
enable-reflector={{ (reflector | default({})).enabled | default(false) | lower }}

# Reflect IPv6 traffic
# reflect-ipv=no

# Filters for reflected services (e.g., _airplay._tcp.local,_raop._tcp.local)
# reflect-filters=

[rlimits]
# Address space limit (0 = unlimited)
# rlimit-as=

# Core dump size limit (0 = disabled)
# rlimit-core=0

# Data segment size limit (8 MB)
# rlimit-data=83888608

# File size limit (0 = unlimited)
# rlimit-fsize=0

# Open files limit (768)
# rlimit-nofile=768

# Stack size limit (8 MB)
# rlimit-stack=83888608

# Max processes limit (3 = typically very low, usually set higher)
# rlimit-nproc=3
