{
  "server": {
    "host_name": "",
    "domain_name": "local",
    "config_dir": "/etc/avahi"
  },
  "reflector": {
    "enabled": false
  },
  "discovery": {
    "enabled_services": [
      {
        "name": "_http._tcp",
        "enabled": true
      },
      {
        "name": "_ipp._tcp",
        "enabled": true
      },
      {
        "name": "_printer._tcp",
        "enabled": true
      },
      {
        "name": "_uscan._tcp",
        "enabled": false
      },
      {
        "name": "_cups._tcp",
        "enabled": true
      }
    ],
    "allow_interfaces": [
      "eth0",
      "wlan0"
    ]
  }
}
