{
 "allowed_clients": [
  "10.0.0.0/8",
  "192.168.42.10"
 ],
 "bind_address": "0.0.0.0",
 "bind_port": 2222,
 "extra_init_args": {
  "pin": "123456",
  "slot": "1"
 },
 "log_level": "warn",
 "max_sessions": 200,
 "pid_file": "/run/pkcs11-daemon/pkcs11-daemon.pid",
 "pkcs11_module_path": "/usr/lib/softhsm/libsofthsm2.so",
 "timeout_seconds": 45,
 "tls_cert_file": "/etc/pkcs11-daemon/tls.crt",
 "tls_enabled": true,
 "tls_key_file": "/etc/pkcs11-daemon/tls.key",
 "use_syslog": true
}
