#
# ALSA library configuration file for alsactl tool
# (/usr/share/alsa tree is not necessary for alsactl)
#

# Default ALSA hardware card number to be used by alsactl.
# Defaults to '0' if not specified in the role variables.
ctl.hw {
	@args [ CARD ]
	@args.CARD {
		type string
		default "{{ default_card | default('0') }}"
	}
	type hw
	card $CARD
}
