# imapproxy.conf — Main configuration file for imapproxy
# Listen address and port for the IMAP proxy
listen_addr = {{ listen_addr }}
listen_port = {{ listen_port }}

# Backend IMAP server(s) to which to proxy
{% for backend in backends %}
server_host = {{ backend.host }}
server_port = {{ backend.port }}
{% endfor %}

# Authentication backend (none, ldap, sql)
auth_method = {{ auth_method }}

# LDAP-specific options (used only if auth_method = ldap)
{% if auth_method == 'ldap' %}
ldap_uri = {{ ldap_uri }}
ldap_base_dn = {{ ldap_base_dn }}
ldap_bind_dn = {{ ldap_bind_dn }}
ldap_bind_password = {{ ldap_bind_password }}
ldap_filter = {{ ldap_filter }}
{% endif %}

# SQL-specific options (used only if auth_method = sql)
{% if auth_method == 'sql' %}
sql_driver = {{ sql_driver }}
sql_host = {{ sql_host }}
sql_port = {{ sql_port }}
sql_user = {{ sql_user }}
sql_password = {{ sql_password }}
sql_database = {{ sql_database }}
sql_query = {{ sql_query }}
{% endif %}

# Caching settings
use_cache = {{ use_cache | lower }}
cache_dir = {{ cache_dir }}
cache_size = {{ cache_size }}

# Logging settings
log_level = {{ log_level }}
log_facility = {{ log_facility }}
log_file = {{ log_file }}

# SSL/TLS options
ssl_enabled = {{ ssl_enabled | lower }}
ssl_cert_file = {{ ssl_cert_file }}
ssl_key_file = {{ ssl_key_file }}
ssl_protocols = {{ ssl_protocols }}
ssl_ciphers = {{ ssl_ciphers }}

# Connection pool and timeouts
max_connections = {{ max_connections }}
client_timeout = {{ client_timeout }}
server_timeout = {{ server_timeout }}

# Other operational flags
transparent_proxy = {{ transparent_proxy | lower }}
use_starttls = {{ use_starttls | lower }}
