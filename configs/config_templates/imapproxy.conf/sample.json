{
  "listen_addr": "0.0.0.0",
  "listen_port": 143,
  "backends": [
    {
      "host": "imap1.example.com",
      "port": 143
    },
    {
      "host": "imap2.example.com",
      "port": 143
    }
  ],
  "auth_method": "none",
  "use_cache": true,
  "cache_dir": "/var/spool/imapproxy/cache",
  "cache_size": 100000,
  "log_level": "info",
  "log_facility": "daemon",
  "log_file": "/var/log/imapproxy.log",
  "ssl_enabled": false,
  "ssl_cert_file": "/etc/ssl/certs/imapproxy.crt",
  "ssl_key_file": "/etc/ssl/private/imapproxy.key",
  "ssl_protocols": "TLSv1.2 TLSv1.3",
  "ssl_ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "max_connections": 1000,
  "client_timeout": 300,
  "server_timeout": 120,
  "transparent_proxy": false,
  "use_starttls": true
}
