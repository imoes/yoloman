{
  "rgb_database_file": {
    "type": "string",
    "default": "/etc/X11/rgb.txt",
    "description": "Path to the file holding X-windows colour definitions."
  },
  "x_display": {
    "type": "string",
    "default": "",
    "description": "The X display to connect to, in the format host:dpy."
  },
  "app_name": {
    "type": "string",
    "default": "xcolmix",
    "description": "The application name used for resource lookups."
  },
  "visual_class": {
    "type": "string",
    "default": "TrueColor",
    "description": "The visual class to use (e.g., TrueColor, PseudoColor).",
    "enum": [
      "TrueColor",
      "PseudoColor"
    ],
    "enum_open": true
  },
  "visual_depth": {
    "type": "number",
    "default": 0,
    "description": "Visual depth in bits."
  },
  "use_private_colourmap": {
    "type": "bool",
    "default": false,
    "description": "Force a private colourmap."
  },
  "use_shared_colourmap": {
    "type": "bool",
    "default": false,
    "description": "Force a shared colourmap."
  },
  "use_standard_colourmap": {
    "type": "bool",
    "default": false,
    "description": "Force a standard colourmap."
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Level of debugging information to print."
  },
  "sync_mode": {
    "type": "bool",
    "default": false,
    "description": "Force synchronous mode."
  }
}
