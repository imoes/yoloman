# ==============================================================================
# xcolmix Configuration Template
# Self-documented for Ansible reuse.
# ==============================================================================

# Path to the file holding X-windows colour definitions.
# Default: /etc/X11/rgb.txt
rgb_database_file = {{ rgb_database_file | default('/etc/X11/rgb.txt') | string }}

# The X display to connect to, in the format host:dpy.
# Default: '' (uses environment DISPLAY)
x_display = {{ x_display | default('') | string }}

# The application name used for resource lookups.
# Default: xcolmix
app_name = {{ app_name | default('xcolmix') | string }}

# The visual class to use (e.g., TrueColor, PseudoColor).
# Default: TrueColor
visual_class = {{ visual_class | default('TrueColor') | string }}

# Visual depth in bits.
# Default: 0
visual_depth = {{ visual_depth | default(0) | int }}

# Force a private colourmap.
# Default: false
use_private_colourmap = {{ use_private_colourmap | default(false) | lower }}

# Force a shared colourmap.
# Default: false
use_shared_colourmap = {{ use_shared_colourmap | default(false) | lower }}

# Force a standard colourmap.
# Default: false
use_standard_colourmap = {{ use_standard_colourmap | default(false) | lower }}

# Level of debugging information to print.
# Default: 0
debug_level = {{ debug_level | default(0) | int }}

# Force synchronous mode.
# Default: false
sync_mode = {{ sync_mode | default(false) | lower }}