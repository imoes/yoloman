{
  "log_level": "info",
  "home_dir": "/var/lib/multispeech",
  "default_engine": "flite",
  "default_voice": "en-us",
  "default_rate": 170,
  "default_pitch": 50,
  "default_volume": 80,
  "threaded_render": true,
  "max_jobs": 3,
  "job_timeout": 25,
  "engines": {
    "flite": {
      "enabled": true,
      "binary": "/usr/bin/flite",
      "voices": [
        "en-us",
        "en-gb",
        "cmu-rms"
      ]
    },
    "mbrola": {
      "enabled": false,
      "binary": "/usr/bin/mbrola",
      "voice_dir": "/usr/share/mbrola",
      "voices": [
        "fr1",
        "de4",
        "us1"
      ]
    },
    "pico": {
      "enabled": true,
      "binary": "/usr/bin/pico2wave",
      "default_lang": "en-US",
      "langs": [
        "en-US",
        "en-GB",
        "fr-FR",
        "de-DE"
      ]
    },
    "festival": {
      "enabled": false,
      "server_binary": "/usr/bin/festival_server",
      "config_dir": "/etc/festival",
      "server_host": "127.0.0.1",
      "server_port": 1314,
      "voices": [
        "us1",
        "us2",
        "kal_diphone"
      ]
    }
  },
  "voice_aliases": {
    "en-male": "flite+cmu-rms",
    "en-female": "flite+en-us",
    "fr-male": "mbrola+fr1",
    "de-female": "mbrola+de4"
  }
}
