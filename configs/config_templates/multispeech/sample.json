{
 "default_engine": "flite",
 "default_pitch": 50,
 "default_rate": 170,
 "default_voice": "en-us",
 "default_volume": 80,
 "engines": {
  "festival": {
   "config_dir": "/etc/festival",
   "enabled": false,
   "server_binary": "/usr/bin/festival_server",
   "server_host": "127.0.0.1",
   "server_port": 1314,
   "voices": [
    "us1",
    "us2",
    "kal_diphone"
   ]
  },
  "flite": {
   "binary": "/usr/bin/flite",
   "enabled": true,
   "voices": [
    "en-us",
    "en-gb",
    "cmu-rms"
   ]
  },
  "mbrola": {
   "binary": "/usr/bin/mbrola",
   "enabled": false,
   "voice_dir": "/usr/share/mbrola",
   "voices": [
    "fr1",
    "de4",
    "us1"
   ]
  },
  "pico": {
   "binary": "/usr/bin/pico2wave",
   "default_lang": "en-US",
   "enabled": true,
   "langs": [
    "en-US",
    "en-GB",
    "fr-FR",
    "de-DE"
   ]
  }
 },
 "home_dir": "/var/lib/multispeech",
 "job_timeout": 25,
 "log_level": "info",
 "max_jobs": 3,
 "threaded_render": true,
 "voice_aliases": {
  "de-female": "mbrola+de4",
  "en-female": "flite+en-us",
  "en-male": "flite+cmu-rms",
  "fr-male": "mbrola+fr1"
 }
}
