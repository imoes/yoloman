{
  "master_host": "mfsmaster.local",
  "master_port": 9421,
  "data_path": "/var/lib/mfs",
  "exports_file": "/etc/mfs/mfsexports.cfg",
  "meta_logging": true,
  "max_open_files": 0,
  "worker_processes": 4,
  "heartbeat_timeout": 600,
  "heartbeat_interval": 60,
  "access_logging": false,
  "metadata_replicas": [
    {
      "host": "mfsmeta1.local",
      "port": 9421,
      "weight": 1
    },
    {
      "host": "mfsmeta2.local",
      "port": 9421
    }
  ],
  "garbage_collection": true,
  "trash_expire_time": 86400,
  "balancing": true,
  "min_free_space_mb": 1024,
  "max_chunk_size_mb": 64,
  "stats_http_enabled": true,
  "stats_http_host": "127.0.0.1",
  "stats_http_port": 9420,
  "stats_http_password_file": "/etc/mfs/mfsstats.pass",
  "secure_mode": false,
  "read_only_mode": false
}
