            Control="{{ (viewport_move_up | default({})).Control | default(1) }}"
            Shift="{{ (viewport_move_up | default({})).Shift | default(1) }}"
            AltMeta="{{ (viewport_move_up | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_move_up | default({})).key | default('Up') }}" />

  <!-- Action: Move viewport up (Numpad binding) -->
  <!-- viewport_move_up_2.Control: Control key modifier for viewport_move_up action (KP) -->
  <!-- viewport_move_up_2.Shift: Shift key modifier for viewport_move_up action (KP) -->
  <!-- viewport_move_up_2.AltMeta: AltMeta key modifier for viewport_move_up action (KP) -->
  <!-- viewport_move_up_2.key: Key for viewport_move_up action -->
  <keystroke action="viewport_move_up"
            Control="{{ (viewport_move_up_2 | default({})).Control | default(1) }}"
            Shift="{{ (viewport_move_up_2 | default({})).Shift | default(1) }}"
            AltMeta="{{ (viewport_move_up_2 | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_move_up_2 | default({})).key | default('KP_Up') }}" />

  <!-- Action: Move viewport right (primary binding) -->
  <!-- viewport_move_right.Control: Control key modifier for viewport_move_right action -->
  <!-- viewport_move_right.Shift: Shift key modifier for viewport_move_right action -->
  <!-- viewport_move_right.AltMeta: AltMeta key modifier for viewport_move_right action -->
  <!-- viewport_move_right.key: Key for viewport_move_right action -->
  <keystroke action="viewport_move_right"
            Control="{{ (viewport_move_right | default({})).Control | default(1) }}"
            Shift="{{ (viewport_move_right | default({})).Shift | default(1) }}"
            AltMeta="{{ (viewport_move_right | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_move_right | default({})).key | default('Right') }}" />

  <!-- Action: Move viewport right (Numpad binding) -->
