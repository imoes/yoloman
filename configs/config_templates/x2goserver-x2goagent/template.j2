<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE NXKeystrokes>
<!--
  X2Go Agent Keystroke Configuration Template
  ---------------------------------------------
  This configuration defines key combinations for various X2Go client actions.
  It is self-documenting: every variable uses a default value matching the
  schema definition, so the config renders correctly even if a variable is
  missing from the playbook/host vars.
-->
<keystrokes>
  <!--
    Action: close_session
    Description: Close the current X2Go session
  -->
  <!-- Control: Control key modifier for close_session action -->
  <keystroke
    action="close_session"
    Control="{{ (close_session | default({})).Control | default(1) }}"
    AltMeta="{{ (close_session | default({})).AltMeta | default(1) }}"
    key="{{ (close_session | default({})).key | default('t') }}"
  />

  <!--
    Action: switch_all_screens
    Description: Switch all virtual screens
  -->
  <!-- Control: Control key modifier for switch_all_screens action -->
  <keystroke
    action="switch_all_screens"
    Control="{{ (switch_all_screens | default({})).Control | default(1) }}"
    AltMeta="{{ (switch_all_screens | default({})).AltMeta | default(1) }}"
    key="{{ (switch_all_screens | default({})).key | default('f') }}"
  />

  <!--
    Action: fullscreen
    Description: Toggle fullscreen mode
  -->
  <!-- Control: Control key modifier for fullscreen action -->
  <!-- Shift: Shift key modifier for fullscreen action -->
  <keystroke
    action="fullscreen"
    Control="{{ (fullscreen | default({})).Control | default(1) }}"
    Shift="{{ (fullscreen | default({})).Shift | default(1) }}"
    AltMeta="{{ (fullscreen | default({})).AltMeta | default(1) }}"
    key="{{ (fullscreen | default({})).key | default('f') }}"
  />

  <!--
    Action: minimize
    Description: Minimize the X2Go session window
  -->
  <!-- Control: Control key modifier for minimize action -->
  <keystroke
    action="minimize"
    Control="{{ (minimize | default({})).Control | default(1) }}"
    AltMeta="{{ (minimize | default({})).AltMeta | default(1) }}"
    key="{{ (minimize | default({})).key | default('m') }}"
  />

  <!--
    Action: defer
    Description: Defer screen updates
  -->
  <!-- Control: Control key modifier for defer action -->
  <keystroke
    action="defer"
    Control="{{ (defer | default({})).Control | default(1) }}"
    AltMeta="{{ (defer | default({})).AltMeta | default(1) }}"
    key="{{ (defer | default({})).key | default('e') }}"
  />

  <!--
    Action: force_synchronization
    Description: Force screen synchronization
  -->
  <!-- Control: Control key modifier for force_synchronization action -->
  <keystroke
    action="force_synchronization"
    Control="{{ (force_synchronization | default({})).Control | default(1) }}"
    AltMeta="{{ (force_synchronization | default({})).AltMeta | default(1) }}"
    key="{{ (force_synchronization | default({})).key | default('j') }}"
  />

  <!--
    Action: resize
    Description: Resize the remote screen
  -->
  <!-- Control: Control key modifier for resize action -->
  <keystroke
    action="resize"
    Control="{{ (resize | default({})).Control | default(1) }}"
    AltMeta="{{ (resize | default({})).AltMeta | default(1) }}"
    key="{{ (resize | default({})).key | default('r') }}"
  />

  <!--
    Action: viewport_move_left
    Description: Move viewport to the left
  -->
  <!-- Control: Control key modifier for viewport_move_left action -->
  <!-- Shift: Shift key modifier for viewport_move_left action -->
  <keystroke
    action="viewport_move_left"
    Control="{{ (viewport_move_left | default({})).Control | default(1) }}"
    Shift="{{ (viewport_move_left | default({})).Shift | default(1) }}"
    AltMeta="{{ (viewport_move_left | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_move_left | default({})).key | default('Left') }}"
  />

  <!--
    Action: viewport_move_left (KeyPad variant)
    Description: Move viewport to the left using keypad
  -->
  <!-- Control: Control key modifier for viewport_move_left action (KP) -->
  <!-- Shift: Shift key modifier for viewport_move_left action (KP) -->
  <keystroke
    action="viewport_move_left"
    Control="{{ (viewport_move_left_2 | default({})).Control | default(1) }}"
    Shift="{{ (viewport_move_left_2 | default({})).Shift | default(1) }}"
    AltMeta="{{ (viewport_move_left_2 | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_move_left_2 | default({})).key | default('KP_Left') }}"
  />

  <!--
    Action: viewport_move_up
    Description: Move viewport up
  -->
  <!-- Control: Control key modifier for viewport_move_up action -->
  <!-- Shift: Shift key modifier for viewport_move_up action -->
  <keystroke
    action="viewport_move_up"
    Control="{{ (viewport_move_up | default({})).Control | default(1) }}"
    Shift="{{ (viewport_move_up | default({})).Shift | default(1) }}"
    AltMeta="{{ (viewport_move_up | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_move_up | default({})).key | default('Up') }}"
  />

  <!--
    Action: viewport_move_up (KeyPad variant)
    Description: Move viewport up using keypad
  -->
  <!-- Control: Control key modifier for viewport_move_up action (KP) -->
  <!-- Shift: Shift key modifier for viewport_move_up action (KP) -->
  <keystroke
    action="viewport_move_up"
    Control="{{ (viewport_move_up_2 | default({})).Control | default(1) }}"
    Shift="{{ (viewport_move_up_2 | default({})).Shift | default(1) }}"
    AltMeta="{{ (viewport_move_up_2 | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_move_up_2 | default({})).key | default('KP_Up') }}"
  />

  <!--
    Action: viewport_move_right
    Description: Move viewport to the right
  -->
  <!-- Control: Control key modifier for viewport_move_right action -->
  <!-- Shift: Shift key modifier for viewport_move_right action -->
  <keystroke
    action="viewport_move_right"
    Control="{{ (viewport_move_right | default({})).Control | default(1) }}"
    Shift="{{ (viewport_move_right | default({})).Shift | default(1) }}"
    AltMeta="{{ (viewport_move_right | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_move_right | default({})).key | default('Right') }}"
  />

  <!--
    Action: viewport_move_right (KeyPad variant)
    Description: Move viewport to the right using keypad
  -->
  <!-- Control: Control key modifier for viewport_move_right action (KP) -->
  <!-- Shift: Shift key modifier for viewport_move_right action (KP) -->
  <keystroke
    action="viewport_move_right"
    Control="{{ (viewport_move_right_2 | default({})).Control | default(1) }}"
    Shift="{{ (viewport_move_right_2 | default({})).Shift | default(1) }}"
    AltMeta="{{ (viewport_move_right_2 | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_move_right_2 | default({})).key | default('KP_Right') }}"
  />

  <!--
    Action: viewport_move_down
    Description: Move viewport down
  -->
  <!-- Control: Control key modifier for viewport_move_down action -->
  <!-- Shift: Shift key modifier for viewport_move_down action -->
  <keystroke
    action="viewport_move_down"
    Control="{{ (viewport_move_down | default({})).Control | default(1) }}"
    Shift="{{ (viewport_move_down | default({})).Shift | default(1) }}"
    AltMeta="{{ (viewport_move_down | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_move_down | default({})).key | default('Down') }}"
  />

  <!--
    Action: viewport_move_down (KeyPad variant)
    Description: Move viewport down using keypad
  -->
  <!-- Control: Control key modifier for viewport_move_down action (KP) -->
  <!-- Shift: Shift key modifier for viewport_move_down action (KP) -->
  <keystroke
    action="viewport_move_down"
    Control="{{ (viewport_move_down_2 | default({})).Control | default(1) }}"
    Shift="{{ (viewport_move_down_2 | default({})).Shift | default(1) }}"
    AltMeta="{{ (viewport_move_down_2 | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_move_down_2 | default({})).key | default('KP_Down') }}"
  />

  <!--
    Action: viewport_scroll_left
    Description: Scroll viewport to the left
  -->
  <!-- Control: Control key modifier for viewport_scroll_left action -->
  <keystroke
    action="viewport_scroll_left"
    Control="{{ (viewport_scroll_left | default({})).Control | default(1) }}"
    AltMeta="{{ (viewport_scroll_left | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_scroll_left | default({})).key | default('Left') }}"
  />

  <!--
    Action: viewport_scroll_left (KeyPad variant)
    Description: Scroll viewport to the left using keypad
  -->
  <!-- Control: Control key modifier for viewport_scroll_left action (KP) -->
  <keystroke
    action="viewport_scroll_left"
    Control="{{ (viewport_scroll_left_2 | default({})).Control | default(1) }}"
    AltMeta="{{ (viewport_scroll_left_2 | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_scroll_left_2 | default({})).key | default('KP_Left') }}"
  />

  <!--
    Action: viewport_scroll_up
    Description: Scroll viewport up
  -->
  <!-- Control: Control key modifier for viewport_scroll_up action -->
  <keystroke
    action="viewport_scroll_up"
    Control="{{ (viewport_scroll_up | default({})).Control | default(1) }}"
    AltMeta="{{ (viewport_scroll_up | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_scroll_up | default({})).key | default('Up') }}"
  />

  <!--
    Action: viewport_scroll_up (KeyPad variant)
    Description: Scroll viewport up using keypad
  -->
  <!-- Control: Control key modifier for viewport_scroll_up action (KP) -->
  <keystroke
    action="viewport_scroll_up"
    Control="{{ (viewport_scroll_up_2 | default({})).Control | default(1) }}"
    AltMeta="{{ (viewport_scroll_up_2 | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_scroll_up_2 | default({})).key | default('KP_Up') }}"
  />

  <!--
    Action: viewport_scroll_right
    Description: Scroll viewport to the right
  -->
  <!-- Control: Control key modifier for viewport_scroll_right action -->
  <keystroke
    action="viewport_scroll_right"
    Control="{{ (viewport_scroll_right | default({})).Control | default(1) }}"
    AltMeta="{{ (viewport_scroll_right | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_scroll_right | default({})).key | default('Right') }}"
  />

  <!--
    Action: viewport_scroll_right (KeyPad variant)
    Description: Scroll viewport to the right using keypad
  -->
  <!-- Control: Control key modifier for viewport_scroll_right action (KP) -->
  <keystroke
    action="viewport_scroll_right"
    Control="{{ (viewport_scroll_right_2 | default({})).Control | default(1) }}"
    AltMeta="{{ (viewport_scroll_right_2 | default({})).AltMeta | default(1) }}"
