  <!-- Control: Control key modifier for viewport_scroll_down action -->
  <keystroke
    action="viewport_scroll_down"
    Control="{{ (viewport_scroll_down | default({})).Control | default(1) }}"
    AltMeta="{{ (viewport_scroll_down | default({})).AltMeta | default(1) }}"
