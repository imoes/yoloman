<?xml version="1.0" encoding="UTF-8"?>
<!--
  X2Go Agent Keystroke Configuration
  ==================================
  This file defines the global hotkey bindings for the X2Go agent.
  Each <keystroke> element maps a specific agent action (e.g., closing a session, toggling fullscreen)
  to a combination of physical keys defined by the schema variables.

  Structure:
  - action: The internal X2Go event to trigger.
  - Control: Modifier key (usually Ctrl, value 1 enabled, 0 disabled).
  - AltMeta: Modifier key (Alt on Linux, Meta on macOS, value 1 enabled, 0 disabled).
  - Shift: Modifier key (value 1 enabled, 0 disabled).
  - key: The base key identifier (e.g., 't', 'f', 'KP_Left').

  Self-documenting: Read the comments below each directive to understand the mapping.
-->
<!DOCTYPE NXKeystroke>
<keystrokes>
  <!-- Action: Close the current X2Go session -->
  <!-- close_session.Control: Control key modifier for close_session action -->
  <!-- close_session.AltMeta: AltMeta key modifier for close_session action -->
  <!-- close_session.key: Key for close_session action -->
  <keystroke action="close_session"
            Control="{{ (close_session | default({})).Control | default(1) }}"
            AltMeta="{{ (close_session | default({})).AltMeta | default(1) }}"
            key="{{ (close_session | default({})).key | default('t') }}" />

  <!-- Action: Switch to all screens (multi-monitor toggle) -->
  <!-- switch_all_screens.Control: Control key modifier for switch_all_screens action -->
  <!-- switch_all_screens.AltMeta: AltMeta key modifier for switch_all_screens action -->
  <!-- switch_all_screens.key: Key for switch_all_screens action -->
  <keystroke action="switch_all_screens"
            Control="{{ (switch_all_screens | default({})).Control | default(1) }}"
            AltMeta="{{ (switch_all_screens | default({})).AltMeta | default(1) }}"
            key="{{ (switch_all_screens | default({})).key | default('f') }}" />

  <!-- Action: Toggle fullscreen mode -->
  <!-- fullscreen.Control: Control key modifier for fullscreen action -->
  <!-- fullscreen.Shift: Shift key modifier for fullscreen action -->
  <!-- fullscreen.AltMeta: AltMeta key modifier for fullscreen action -->
  <!-- fullscreen.key: Key for fullscreen action -->
  <keystroke action="fullscreen"
            Control="{{ (fullscreen | default({})).Control | default(1) }}"
            Shift="{{ (fullscreen | default({})).Shift | default(1) }}"
            AltMeta="{{ (fullscreen | default({})).AltMeta | default(1) }}"
            key="{{ (fullscreen | default({})).key | default('f') }}" />

  <!-- Action: Minimize the X2Go window -->
  <!-- minimize.Control: Control key modifier for minimize action -->
  <!-- minimize.AltMeta: AltMeta key modifier for minimize action -->
  <!-- minimize.key: Key for minimize action -->
  <keystroke action="minimize"
            Control="{{ (minimize | default({})).Control | default(1) }}"
            AltMeta="{{ (minimize | default({})).AltMeta | default(1) }}"
            key="{{ (minimize | default({})).key | default('m') }}" />

  <!-- Action: Defer the session (pause/suspend display updates) -->
  <!-- defer.Control: Control key modifier for defer action -->
  <!-- defer.AltMeta: AltMeta key modifier for defer action -->
  <!-- defer.key: Key for defer action -->
  <keystroke action="defer"
            Control="{{ (defer | default({})).Control | default(1) }}"
            AltMeta="{{ (defer | default({})).AltMeta | default(1) }}"
            key="{{ (defer | default({})).key | default('e') }}" />

  <!-- Action: Force synchronization of the X2Go session state -->
  <!-- force_synchronization.Control: Control key modifier for force_synchronization action -->
  <!-- force_synchronization.AltMeta: AltMeta key modifier for force_synchronization action -->
  <!-- force_synchronization.key: Key for force_synchronization action -->
  <keystroke action="force_synchronization"
            Control="{{ (force_synchronization | default({})).Control | default(1) }}"
            AltMeta="{{ (force_synchronization | default({})).AltMeta | default(1) }}"
            key="{{ (force_synchronization | default({})).key | default('j') }}" />

  <!-- Action: Resize the remote display area -->
  <!-- resize.Control: Control key modifier for resize action -->
  <!-- resize.AltMeta: AltMeta key modifier for resize action -->
  <!-- resize.key: Key for resize action -->
  <keystroke action="resize"
            Control="{{ (resize | default({})).Control | default(1) }}"
            AltMeta="{{ (resize | default({})).AltMeta | default(1) }}"
            key="{{ (resize | default({})).key | default('r') }}" />

  <!-- Action: Move viewport left (primary binding) -->
  <!-- viewport_move_left.Control: Control key modifier for viewport_move_left action -->
  <!-- viewport_move_left.Shift: Shift key modifier for viewport_move_left action -->
  <!-- viewport_move_left.AltMeta: AltMeta key modifier for viewport_move_left action -->
  <!-- viewport_move_left.key: Key for viewport_move_left action -->
  <keystroke action="viewport_move_left"
            Control="{{ (viewport_move_left | default({})).Control | default(1) }}"
            Shift="{{ (viewport_move_left | default({})).Shift | default(1) }}"
            AltMeta="{{ (viewport_move_left | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_move_left | default({})).key | default('Left') }}" />

  <!-- Action: Move viewport left (Numpad binding) -->
  <!-- viewport_move_left_2.Control: Control key modifier for viewport_move_left action (KP) -->
  <!-- viewport_move_left_2.Shift: Shift key modifier for viewport_move_left action (KP) -->
  <!-- viewport_move_left_2.AltMeta: AltMeta key modifier for viewport_move_left action (KP) -->
  <!-- viewport_move_left_2.key: Key for viewport_move_left action -->
  <keystroke action="viewport_move_left"
            Control="{{ (viewport_move_left_2 | default({})).Control | default(1) }}"
            Shift="{{ (viewport_move_left_2 | default({})).Shift | default(1) }}"
            AltMeta="{{ (viewport_move_left_2 | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_move_left_2 | default({})).key | default('KP_Left') }}" />

  <!-- Action: Move viewport up (primary binding) -->
  <!-- viewport_move_up.Control: Control key modifier for viewport_move_up action -->
  <!-- viewport_move_up.Shift: Shift key modifier for viewport_move_up action -->
  <!-- viewport_move_up.AltMeta: AltMeta key modifier for viewport_move_up action -->
  <!-- viewport_move_up.key: Key for viewport_move_up action -->
