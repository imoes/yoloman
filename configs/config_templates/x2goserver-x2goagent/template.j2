  <!-- viewport_move_right_2.Shift: Shift key modifier for viewport_move_right action (KP) -->
  <!-- viewport_move_right_2.AltMeta: AltMeta key modifier for viewport_move_right action (KP) -->
  <!-- viewport_move_right_2.key: Key for viewport_move_right action -->
  <keystroke action="viewport_move_right"
            Control="{{ (viewport_move_right_2 | default({})).Control | default(1) }}"
            Shift="{{ (viewport_move_right_2 | default({})).Shift | default(1) }}"
            AltMeta="{{ (viewport_move_right_2 | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_move_right_2 | default({})).key | default('KP_Right') }}" />

  <!-- Action: Move viewport down (primary binding) -->
  <!-- viewport_move_down.Control: Control key modifier for viewport_move_down action -->
  <!-- viewport_move_down.Shift: Shift key modifier for viewport_move_down action -->
  <!-- viewport_move_down.AltMeta: AltMeta key modifier for viewport_move_down action -->
  <!-- viewport_move_down.key: Key for viewport_move_down action -->
  <keystroke action="viewport_move_down"
            Control="{{ (viewport_move_down | default({})).Control | default(1) }}"
            Shift="{{ (viewport_move_down | default({})).Shift | default(1) }}"
            AltMeta="{{ (viewport_move_down | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_move_down | default({})).key | default('Down') }}" />

  <!-- Action: Move viewport down (Numpad binding) -->
  <!-- viewport_move_down_2.Control: Control key modifier for viewport_move_down action (KP) -->
  <!-- viewport_move_down_2.Shift: Shift key modifier for viewport_move_down action (KP) -->
  <!-- viewport_move_down_2.AltMeta: AltMeta key modifier for viewport_move_down action (KP) -->
  <!-- viewport_move_down_2.key: Key for viewport_move_down action -->
  <keystroke action="viewport_move_down"
            Control="{{ (viewport_move_down_2 | default({})).Control | default(1) }}"
            Shift="{{ (viewport_move_down_2 | default({})).Shift | default(1) }}"
            AltMeta="{{ (viewport_move_down_2 | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_move_down_2 | default({})).key | default('KP_Down') }}" />

  <!-- Action: Scroll viewport left (primary binding) -->
  <!-- viewport_scroll_left.Control: Control key modifier for viewport_scroll_left action -->
  <!-- viewport_scroll_left.AltMeta: AltMeta key modifier for viewport_scroll_left action -->
  <!-- viewport_scroll_left.key: Key for viewport_scroll_left action -->
  <keystroke action="viewport_scroll_left"
            Control="{{ (viewport_scroll_left | default({})).Control | default(1) }}"
            AltMeta="{{ (viewport_scroll_left | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_scroll_left | default({})).key | default('Left') }}" />

  <!-- Action: Scroll viewport left (Numpad binding) -->
  <!-- viewport_scroll_left_2.Control: Control key modifier for viewport_scroll_left action (KP) -->
  <!-- viewport_scroll_left_2.AltMeta: AltMeta key modifier for viewport_scroll_left action (KP) -->
  <!-- viewport_scroll_left_2.key: Key for viewport_scroll_left action -->
  <keystroke action="viewport_scroll_left"
            Control="{{ (viewport_scroll_left_2 | default({})).Control | default(1) }}"
