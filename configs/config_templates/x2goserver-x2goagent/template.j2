            key="{{ (viewport_scroll_left_2 | default({})).key | default('KP_Left') }}" />

  <!-- Action: Scroll viewport up (primary binding) -->
  <!-- viewport_scroll_up.Control: Control key modifier for viewport_scroll_up action -->
  <!-- viewport_scroll_up.AltMeta: AltMeta key modifier for viewport_scroll_up action -->
  <!-- viewport_scroll_up.key: Key for viewport_scroll_up action -->
  <keystroke action="viewport_scroll_up"
            Control="{{ (viewport_scroll_up | default({})).Control | default(1) }}"
            AltMeta="{{ (viewport_scroll_up | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_scroll_up | default({})).key | default('Up') }}" />

  <!-- Action: Scroll viewport up (Numpad binding) -->
  <!-- viewport_scroll_up_2.Control: Control key modifier for viewport_scroll_up action (KP) -->
  <!-- viewport_scroll_up_2.AltMeta: AltMeta key modifier for viewport_scroll_up action (KP) -->
  <!-- viewport_scroll_up_2.key: Key for viewport_scroll_up action -->
  <keystroke action="viewport_scroll_up"
            Control="{{ (viewport_scroll_up_2 | default({})).Control | default(1) }}"
            AltMeta="{{ (viewport_scroll_up_2 | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_scroll_up_2 | default({})).key | default('KP_Up') }}" />

  <!-- Action: Scroll viewport right (primary binding) -->
  <!-- viewport_scroll_right.Control: Control key modifier for viewport_scroll_right action -->
  <!-- viewport_scroll_right.AltMeta: AltMeta key modifier for viewport_scroll_right action -->
  <!-- viewport_scroll_right.key: Key for viewport_scroll_right action -->
  <keystroke action="viewport_scroll_right"
            Control="{{ (viewport_scroll_right | default({})).Control | default(1) }}"
            AltMeta="{{ (viewport_scroll_right | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_scroll_right | default({})).key | default('Right') }}" />

  <!-- Action: Scroll viewport right (Numpad binding) -->
  <!-- viewport_scroll_right_2.Control: Control key modifier for viewport_scroll_right action (KP) -->
  <!-- viewport_scroll_right_2.AltMeta: AltMeta key modifier for viewport_scroll_right action (KP) -->
  <!-- viewport_scroll_right_2.key: Key for viewport_scroll_right action -->
  <keystroke action="viewport_scroll_right"
            Control="{{ (viewport_scroll_right_2 | default({})).Control | default(1) }}"
            AltMeta="{{ (viewport_scroll_right_2 | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_scroll_right_2 | default({})).key | default('KP_Right') }}" />

  <!-- Action: Scroll viewport down (primary binding) -->
  <!-- viewport_scroll_down.Control: Control key modifier for viewport_scroll_down action -->
  <!-- viewport_scroll_down.AltMeta: AltMeta key modifier for viewport_scroll_down action -->
  <!-- viewport_scroll_down.key: Key for viewport_scroll_down action -->
  <keystroke action="viewport_scroll_down"
            Control="{{ (viewport_scroll_down | default({})).Control | default(1) }}"
            AltMeta="{{ (viewport_scroll_down | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_scroll_down | default({})).key | default('Down') }}" />

  <!-- Action: Scroll viewport down (Numpad binding) -->
  <!-- viewport_scroll_down_2.Control: Control key modifier for viewport_scroll_down action (KP) -->
  <!-- viewport_scroll_down_2.AltMeta: AltMeta key modifier for viewport_scroll_down action (KP) -->
  <!-- viewport_scroll_down_2.key: Key for viewport_scroll_down action -->
  <keystroke action="viewport_scroll_down"
            Control="{{ (viewport_scroll_down_2 | default({})).Control | default(1) }}"
            AltMeta="{{ (viewport_scroll_down_2 | default({})).AltMeta | default(1) }}"
            key="{{ (viewport_scroll_down_2 | default({})).key | default('KP_Down') }}" />

  <!-- Action: Reread/Reload keystroke configuration -->
  <!-- reread_keystrokes.Control: Control key modifier for reread_keystrokes action -->
  <!-- reread_keystrokes.AltMeta: AltMeta key modifier for reread_keystrokes action -->
  <!-- reread_keystrokes.key: Key for reread_keystrokes action -->
  <keystroke action="reread_keystrokes"
            Control="{{ (reread_keystrokes | default({})).Control | default(1) }}"
            AltMeta="{{ (reread_keystrokes | default({})).AltMeta | default(1) }}"
            key="{{ (reread_keystrokes | default({})).key | default('k') }}" />

  <!-- Action: Autograb mouse/keyboard input -->
  <!-- autograb.Control: Control key modifier for autograb action -->
  <!-- autograb.AltMeta: AltMeta key modifier for autograb action -->
  <!-- autograb.key: Key for autograb action -->
  <keystroke action="autograb"
            Control="{{ (autograb | default({})).Control | default(1) }}"
            AltMeta="{{ (autograb | default({})).AltMeta | default(1) }}"
            key="{{ (autograb | default({})).key | default('g') }}" />

  <!-- Action: Dump clipboard contents (for debugging) -->
  <!-- dump_clipboard.Control: Control key modifier for dump_clipboard action -->
  <!-- dump_clipboard.Shift: Shift key modifier for dump_clipboard action -->
  <!-- dump_clipboard.AltMeta: AltMeta key modifier for dump_clipboard action -->
  <!-- dump_clipboard.key: Key for dump_clipboard action -->
  <keystroke action="dump_clipboard"
            Control="{{ (dump_clipboard | default({})).Control | default(1) }}"
            Shift="{{ (dump_clipboard | default({})).Shift | default(1) }}"
            AltMeta="{{ (dump_clipboard | default({})).AltMeta | default(1) }}"
            key="{{ (dump_clipboard | default({})).key | default('c') }}" />
</keystrokes>