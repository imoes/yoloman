  />

  <!--
    Action: viewport_scroll_down (KeyPad variant)
    Description: Scroll viewport down using keypad
  -->
  <!-- Control: Control key modifier for viewport_scroll_down action (KP) -->
  <keystroke
    action="viewport_scroll_down"
    Control="{{ (viewport_scroll_down_2 | default({})).Control | default(1) }}"
    AltMeta="{{ (viewport_scroll_down_2 | default({})).AltMeta | default(1) }}"
    key="{{ (viewport_scroll_down_2 | default({})).key | default('KP_Down') }}"
  />

  <!--
    Action: reread_keystrokes
    Description: Re-read keystroke configuration
  -->
  <!-- Control: Control key modifier for reread_keystrokes action -->
  <keystroke
    action="reread_keystrokes"
    Control="{{ (reread_keystrokes | default({})).Control | default(1) }}"
    AltMeta="{{ (reread_keystrokes | default({})).AltMeta | default(1) }}"
    key="{{ (reread_keystrokes | default({})).key | default('k') }}"
  />

  <!--
    Action: autograb
    Description: Enable/Disable autograb mode
  -->
  <!-- Control: Control key modifier for autograb action -->
  <keystroke
    action="autograb"
    Control="{{ (autograb | default({})).Control | default(1) }}"
    AltMeta="{{ (autograb | default({})).AltMeta | default(1) }}"
    key="{{ (autograb | default({})).key | default('g') }}"
  />

  <!--
    Action: dump_clipboard
    Description: Dump clipboard contents to log
  -->
  <!-- Control: Control key modifier for dump_clipboard action -->
  <!-- Shift: Shift key modifier for dump_clipboard action -->
  <keystroke
    action="dump_clipboard"
    Control="{{ (dump_clipboard | default({})).Control | default(1) }}"
    Shift="{{ (dump_clipboard | default({})).Shift | default(1) }}"
    AltMeta="{{ (dump_clipboard | default({})).AltMeta | default(1) }}"
    key="{{ (dump_clipboard | default({})).key | default('c') }}"
  />
</keystrokes>
