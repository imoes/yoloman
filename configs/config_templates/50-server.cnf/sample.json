{
  "bind_address": "0.0.0.0",
  "port": 3306,
  "basedir": "/usr",
  "datadir": "/var/lib/mysql",
  "tmpdir": "/var/tmp/mysql",
  "lc_messages_dir": "/usr/share/mysql",
  "character_set_server": "utf8mb4",
  "collation_server": "utf8mb4_unicode_ci",
  "innodb_buffer_pool_size": "2G",
  "innodb_log_file_size": "512M",
  "innodb_flush_log_at_trx_commit": 1,
  "innodb_file_per_table": true,
  "query_cache_size": 0,
  "query_cache_type": false,
  "max_connections": 300,
  "max_allowed_packet": "128M",
  "thread_cache_size": 32,
  "general_log": false,
  "general_log_file": "/var/log/mysql/query.log",
  "slow_query_log": true,
  "slow_query_log_file": "/var/log/mysql/slow-query.log",
  "long_query_time": 1.0,
  "server_id": 1,
  "log_bin": "/var/log/mysql/mysql-bin",
  "log_bin_index": "/var/log/mysql/mysql-bin.index",
  "ssl_enabled": true,
  "ssl_cert_path": "/etc/mysql/ssl/server-cert.pem",
  "ssl_key_path": "/etc/mysql/ssl/server-key.pem",
  "key_buffer_size": "32M",
  "read_buffer_size": "16M",
  "read_rnd_buffer_size": "8M",
  "sort_buffer_size": "4M",
  "join_buffer_size": "4M",
  "thread_stack": "256K",
  "timeout_connect": 10,
  "timeout_interactive": 28800,
  "timeout_slave": 3600,
  "wait_timeout": 28800,
  "interactive_timeout": 28800,
  "replicas": [
    {
      "name": "replica-2",
      "enabled": true,
      "report_host": "db-replica-2.internal.example.com",
      "report_user": "repl_user",
      "auto_position": true
    }
  ],
  "default_storage_engine": "InnoDB",
  "local_infile_enabled": false,
  "max_heap_table_size": "128M",
  "tmp_table_size": "128M",
  "open_files_limit": 2048,
  "table_open_cache": 1024
}
