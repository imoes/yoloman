[mysqld]
# Basic server identification and general settings
bind-address = {{ bind_address }}
user = mysql
pid-file = /run/mysqld/mysqld.pid
socket = /run/mysqld/mysqld.sock
port = {{ port }}
basedir = {{ basedir }}
datadir = {{ datadir }}
tmpdir = {{ tmpdir }}
lc-messages-dir = {{ lc_messages_dir }}

# Character set and collation
character-set-server = {{ character_set_server }}
collation-server = {{ collation_server }}

# InnoDB settings
innodb_buffer_pool_size = {{ innodb_buffer_pool_size }}
innodb_log_file_size = {{ innodb_log_file_size }}
innodb_flush_log_at_trx_commit = {{ innodb_flush_log_at_trx_commit }}
innodb_file_per_table = {{ innodb_file_per_table }}

# Query cache (deprecated in MariaDB 10.1+, but may be used for compatibility)
{% if query_cache_size > 0 %}
query_cache_size = {{ query_cache_size }}
query_cache_type = {{ 'ON' if query_cache_type else 'OFF' }}
{% else %}
# Query cache disabled
{% endif %}

# Connection handling
max_connections = {{ max_connections }}
max_allowed_packet = {{ max_allowed_packet }}
thread_cache_size = {{ thread_cache_size }}

# Logging
{% if general_log %}
general_log = 1
general_log_file = {{ general_log_file }}
{% else %}
general_log = 0
{% endif %}

{% if slow_query_log %}
slow_query_log = 1
slow_query_log_file = {{ slow_query_log_file }}
long_query_time = {{ long_query_time }}
{% else %}
slow_query_log = 0
{% endif %}

# Binary logging for replication
{% if server_id > 0 %}
server-id = {{ server_id }}
log_bin = {{ log_bin }}
log_bin_index = {{ log_bin_index }}
{% else %}
# Binary logging disabled (server-id <= 0)
{% endif %}

# TLS/SSL support
{% if ssl %}
ssl = {{ 'ON' if ssl_enabled else 'OFF' }}
ssl_cert = {{ ssl_cert_path }}
ssl_key = {{ ssl_key_path }}
{% else %}
# SSL disabled
{% endif %}

# Memory and performance tuning
key_buffer_size = {{ key_buffer_size }}
read_buffer_size = {{ read_buffer_size }}
read_rnd_buffer_size = {{ read_rnd_buffer_size }}
sort_buffer_size = {{ sort_buffer_size }}
join_buffer_size = {{ join_buffer_size }}
thread_stack = {{ thread_stack }}

# Timeouts
timeout_connect = {{ timeout_connect }}
timeout_interactive = {{ timeout_interactive }}
timeout_slave = {{ timeout_slave }}
wait_timeout = {{ wait_timeout }}
interactive_timeout = {{ interactive_timeout }}

# Replication (standalone master settings)
{% for replica in replicas %}
# Replica: {{ replica.name }}
{% if replica.enabled %}
report_host = {{ replica.report_host }}
report_user = {{ replica.report_user }}
{% if replica.auto_position %}
master_auto_position = 1
{% else %}
master_log_file = {{ replica.log_file }}
master_log_pos = {{ replica.log_pos }}
{% endif %}
{% endif %}
{% endfor %}

# Storage engine default
default_storage_engine = {{ default_storage_engine }}

# Security: disable local infile unless needed
disable_local_infile = {{ not local_infile_enabled }}

# Table and temporary table limits
max_heap_table_size = {{ max_heap_table_size }}
tmp_table_size = {{ tmp_table_size }}
open_files_limit = {{ open_files_limit }}
table_open_cache = {{ table_open_cache }}
