{
  "protocols": [
    "imap",
    "sieve"
  ],
  "managesieve_port": 4190,
  "managesieve_ssl_port": 4191,
  "managesieve_max_clients": 200,
  "sieve_script_path": "~/.dovecot.sieve",
  "sieve_default_script": "dovecot.sieve",
  "sieve_global_dir": "/var/lib/dovecot/sieve-global/",
  "sieve_extensions": [
    "fileinto",
    "envelope",
    " vacation",
    "date",
    "reject",
    "imapsieve"
  ],
  "sieve_before": [
    "/var/lib/dovecot/sieve-before/spam.sieve",
    "/var/lib/dovecot/sieve-before/authors.sieve"
  ],
  "sieve_after": [
    "/var/lib/dovecot/sieve-after/archive.sieve"
  ],
  "managesieve_logout_format": "bytes=%i/%o, time=%r",
  "managesieve_ssl": "yes",
  "ssl_cert_path": "/etc/ssl/certs/dovecot.crt",
  "ssl_key_path": "/etc/ssl/private/dovecot.key",
  "ssl_min_protocol": "TLSv1.2",
  "auth_mechanisms": [
    "plain",
    "login",
    "cram-md5"
  ]
}
