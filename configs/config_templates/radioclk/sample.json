{
  "msf": {
    "enabled": true,
    "device": "/dev/ttyUSB0"
  },
  "wwvb": {
    "enabled": false,
    "device": "/dev/wwvb0"
  },
  "dcf77": {
    "enabled": false,
    "device": "/dev/dcf770"
  },
  "min_snr": 15,
  "min_signal_strength": 25,
  "max_offset_ms": 75,
  "log_level": 2,
  "device_params": [
    {
      "param": "agc_timeout",
      "value": "30",
      "description": "Automatic gain control timeout in seconds"
    },
    {
      "param": "pulse_width",
      "value": "100",
      "description": "Sync pulse width in milliseconds"
    }
  ],
  "fallback_ntp": [
    "0.uk.pool.ntp.org",
    "time.google.com"
  ],
  "serial": {
    "baud": 9600,
    "parity": "N",
    "stopbits": 1
  },
  "pps": {
    "enabled": true,
    "device": "/dev/pps0"
  },
  "debug": {
    "dump_file": "/var/log/radioclk/raw_dump.txt"
  },
  "nice": 10
}
