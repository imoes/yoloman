# Rover configuration file
# Configuration directives for the Rover application.
# This file is self-documenting: comments explain the purpose and default values
# for each setting, derived from the role's variable schema.

# [search]
# Default regex or substring expression for searching alternatives.
# If empty or unset, Rover may use a fallback or require user input.
search_expression={{ search_expression | default('') }}

# [logging]
# Enable verbose logging output.
# When true, Rover emits detailed diagnostic information to stdout or log files.
verbose={{ verbose | default(False) | bool | lower }}

# [interface]
# Command to launch when editing alternative links.
# The command is executed in the user's environment. Common values include 'nano', 'vim', 'emacs'.
editor_command="{{ editor_command | default('nano') }}"

# [interface]
# Key binding to quit the rover interface.
# Typically a single character like 'q' or 'Esc'.
quit_key="{{ quit_key | default('q') }}"