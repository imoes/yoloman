{
  "input_mode": "vmx",
  "input_uri": "vpx://vcenter.example.com/Datacenter/esxi",
  "output_mode": "rhv-upload",
  "output_storage": "ovirt-data",
  "guest_source": "vmware_guest",
  "output_guest_name": "kvm_guest_01",
  "bridge_mappings": [
    "default:ovirtmgmt"
  ],
  "mac_mappings": [
    "52:54:00:12:34:56:network:management"
  ],
  "bandwidth_limit": "10M",
  "disk_format": "qcow2",
  "allocation_mode": "sparse",
  "compressed": true,
  "customizations": [
    "--hostname kvm_guest_01.example.com",
    "--firstboot-command 'yum update -y'"
  ],
  "verbose": false,
  "quiet": true
}
