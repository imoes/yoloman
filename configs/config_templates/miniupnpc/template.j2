# ============================================================================
# miniupnpc Configuration Template
# ============================================================================
# This template generates the configuration file for the miniupnpc UPnP client library.
# miniupnpc is used to discover and configure UPnP Internet Gateway Devices (IGD)
# to automate port forwarding and NAT traversal.
# ============================================================================

# ---------------------------------------------------------------------------
# Delay: Maximum time in milliseconds to wait for UPnP IGD device responses
# during the discovery phase.
# ---------------------------------------------------------------------------
DELAY: {{ (delay | default(1000)) }}

# ---------------------------------------------------------------------------
# Multicast Interface: Network interface to use for sending SSDP discover packets.
# Leave empty to use the default interface.
# ---------------------------------------------------------------------------
MULTICAST_IF: {{ (multicast_if | default('')) | string | trim }}

# ---------------------------------------------------------------------------
# MiniSSDPd Socket: Path to the MiniSSDPd socket to use pre-gathered device data.
# Leave empty to use default path.
# ---------------------------------------------------------------------------
MINISSDPDSOCK: {{ (minissdpd_sock | default('')) | string | trim }}

# ---------------------------------------------------------------------------
# Local Port: Source port for SSDP packets.
# 0 for system-assigned, 1900 (UPNP_LOCAL_PORT_SAME) for same as dest,
# or specific port number.
# ---------------------------------------------------------------------------
LOCAL_PORT: {{ (local_port | default(0)) | int }}

# ---------------------------------------------------------------------------
# IPv6: Enable IPv6 for the UPnP discovery process.
# 1: Enable IPv6, 0: Disable IPv6.
# ---------------------------------------------------------------------------
IPV6: {{ (ipv6 | default(false)) | bool | ternary(1, 0) }}

# ---------------------------------------------------------------------------
# Root Description URL: Direct URL to the UPnP IGD root description XML,
# bypassing the discovery process.
# Leave empty to allow standard discovery.
# ---------------------------------------------------------------------------
ROOTDESCURL: {{ (rootdescurl | default('')) | string | trim }}

# ---------------------------------------------------------------------------
# LAN Address: LAN address for the UPnP interface.
# Leave empty for auto-detection.
# ---------------------------------------------------------------------------
LAN_ADDR: {{ (lan_addr | default('')) | string | trim }}

# ---------------------------------------------------------------------------
# WAN Address: WAN address for the UPnP interface.
# Leave empty for auto-detection.
# ---------------------------------------------------------------------------
WAN_ADDR: {{ (wan_addr | default('')) | string | trim }}