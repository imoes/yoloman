# Enable the indicator-datetime service
enabled: {{ enabled }}

# Timezone to use (e.g., 'America/New_York' or 'UTC')
timezone: {{ timezone }}

# Format for date display in the panel (strftime-compatible)
format_date: '{{ format_date }}'

# Format for time display in the panel (strftime-compatible)
format_time: '{{ format_time }}'

# Whether to show seconds in the time display
show_seconds: {{ show_seconds }}

# Whether to display a 24-hour clock
show_24h: {{ show_24h }}

# Whether to automatically detect and apply locale settings
auto_locale: {{ auto_locale }}

# List of additional date/time formats for custom display (e.g., secondary clock)
formats:
{% for fmt in formats %}  - type: '{{ fmt.type }}'
    pattern: '{{ fmt.pattern }}'
{% endfor %}

# Path to custom calendar file (for holidays, events, etc.)
calendar_file: {{ calendar_file }}

# Whether to enable event notifications from calendar
event_notifications: {{ event_notifications }}

# Path to custom font file (optional; for locale-specific glyphs)
font_path: {{ font_path }}

# List of custom holidays (ISO 8601 date strings or names like 'Easter')
holidays:
{% for holiday in holidays %}  - {{ holiday | quote }}
{% endfor %}