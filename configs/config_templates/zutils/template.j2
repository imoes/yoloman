#
#                 Runtime Configuration file for Zutils
#
# Zutils looks for this file in:
#	1 - $XDG_CONFIG_HOME/zutils.conf
#	2 - ${sysconfdir}/zutils.conf
# XDG_CONFIG_HOME defaults to $HOME/.config

# This file sets the compressor and options to be used for each format.
# The command-line options override compressors specified in this file.
# Syntax: <format> = <compressor> [options]
# Uncomment each line you want to take effect.

# bz2_compressor: Compressor command and options for bz2 format
{% if bz2_compressor is defined and bz2_compressor is not none and (bz2_compressor is number or bz2_compressor is boolean or bz2_compressor | length > 0) %}bz2 = {{ bz2_compressor | default('lbzip2 -n2') }}
{% else %}#	bz2 = lbzip2 -n2
{% endif %}
# gz_compressor: Compressor command and options for gz format
{% if gz_compressor is defined and gz_compressor is not none and (gz_compressor is number or gz_compressor is boolean or gz_compressor | length > 0) %}gz = {{ gz_compressor | default('pigz -p2') }}
{% else %}#	gz = pigz -p2
{% endif %}
# lz_compressor: Compressor command and options for lz format
{% if lz_compressor is defined and lz_compressor is not none and (lz_compressor is number or lz_compressor is boolean or lz_compressor | length > 0) %}lz = {{ lz_compressor | default('plzip -n2') }}
{% else %}#	lz = plzip -n2
{% endif %}
# xz_compressor: Compressor command and options for xz format
{% if xz_compressor is defined and xz_compressor is not none and (xz_compressor is number or xz_compressor is boolean or xz_compressor | length > 0) %}xz = {{ xz_compressor | default('pixz -p2') }}
{% else %}#	xz = pixz -p2
{% endif %}
# zst_compressor: Compressor command and options for zst format
{% if zst_compressor is defined and zst_compressor is not none and (zst_compressor is number or zst_compressor is boolean or zst_compressor | length > 0) %}zst = {{ zst_compressor | default('zstd -T2') }}
{% else %}#	zst = zstd -T2
{% endif %}