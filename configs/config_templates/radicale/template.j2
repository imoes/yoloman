# Radicale configuration file — main configuration for the server
[server]
# Host and port to bind to
hosts = {{ server.hosts | join(', ') }}
port = {{ server.port }}
# SSL/TLS configuration (optional)
{% if server.ssl.enabled %}
certificate = {{ server.ssl.certificate }}
key = {{ server.ssl.key }}
{% else %}
ssl = false
{% endif %}
# Debugging
# Set to `true` to enable verbose debug logging
debug = {{ server.debug | string | lower }}

# Authentication backend
[auth]
# Supported types: `None`, `htpasswd`, `LDAP`, `PAM`, etc.
type = {{ auth.type }}
{% if auth.type == 'htpasswd' %}
# Path to htpasswd file
htpasswd_filename = {{ auth.htpasswd_filename }}
htpasswd_encryption = {{ auth.htpasswd_encryption }}
{% elif auth.type == 'LDAP' %}
# LDAP-specific settings (example minimal config)
url = {{ auth.ldap_url }}
base = {{ auth.ldap_base }}
bind_user = {{ auth.ldap_bind_user }}
bind_password = {{ auth.ldap_bind_password }}
{% endif %}

# Storage backend
[storage]
# Core storage backend type (e.g., `filesystem`, `multifilesystem`)
type = {{ storage.type }}
{% if storage.type == 'filesystem' %}
# Root directory for CalDAV/CardDAV data
filesystem_folder = {{ storage.filesystem_folder }}
{% elif storage.type == 'multifilesystem' %}
filesystem_folder = {{ storage.filesystem_folder }}
# Optional locking (prevents concurrent writes)
{% if storage.locking %}
lock_file = {{ storage.locking.lock_file }}
{% else %}
lock_file =
{% endif %}
{% endif %}

# Rights management (ACLs)
[rights]
# Supported: `owner_only`, `owner_write`, `authenticated`, `from_file`, etc.
type = {{ rights.type }}
{% if rights.type == 'from_file' %}
file = {{ rights.from_file.path }}
{% endif %}

# Logging configuration
[logging]
# Log level: `DEBUG`, `INFO`, `WARNING`, `ERROR`, `CRITICAL`
level = {{ logging.level }}
# Path to log file (empty = stderr)
{% if logging.file %}
file = {{ logging.file }}
{% else %}
file =
{% endif %}

# Custom headers and response tweaks
[headers]
# Optional HTTP headers to add to responses
{% for key, value in headers.items() %}
{{ key }} = {{ value }}
{% endfor %}

# MIME types and content handling (rarely changed)
[types]
# Default MIME type for unknown extensions
default = {{ types.default }}
