{
  "server": {
    "hosts": [
      "localhost:5232"
    ],
    "port": 5232,
    "ssl": {
      "enabled": false,
      "certificate": "/etc/ssl/certs/radicale.pem",
      "key": "/etc/ssl/private/radicale.key"
    },
    "debug": false
  },
  "auth": {
    "type": "None",
    "htpasswd_filename": "/etc/radicale/users",
    "htpasswd_encryption": "bcrypt",
    "ldap_url": "ldap://localhost",
    "ldap_base": "ou=users,dc=example,dc=com",
    "ldap_bind_user": "cn=admin,dc=example,dc=com",
    "ldap_bind_password": ""
  },
  "storage": {
    "type": "filesystem",
    "filesystem_folder": "/var/lib/radicale/collections",
    "locking": {
      "lock_file": "/var/lib/radicale/lock"
    }
  },
  "rights": {
    "type": "owner_only",
    "from_file": {
      "path": "/etc/radicale/rights"
    }
  }
}
