{
  "server": {
    "hosts": [
      "localhost:5232"
    ],
    "port": 5232,
    "ssl": {
      "enabled": false
    },
    "debug": false
  },
  "auth": {
    "type": "htpasswd",
    "htpasswd_filename": "/etc/radicale/users",
    "htpasswd_encryption": "bcrypt"
  },
  "storage": {
    "type": "filesystem",
    "filesystem_folder": "/var/lib/radicale/collections",
    "locking": {
      "lock_file": "/var/lib/radicale/lock"
    }
  },
  "rights": {
    "type": "owner_only"
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/radicale/radicale.log"
  },
  "headers": {
    "Access-Control-Allow-Origin": "*",
    "X-Frame-Options": "DENY"
  },
  "types": {
    "default": "text/calendar; charset=utf-8"
  }
}
