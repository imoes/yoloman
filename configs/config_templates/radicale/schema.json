{
  "server": {
    "type": "object",
    "default": null,
    "description": "Server configuration (port, hosts, SSL, debug mode)."
  },
  "auth": {
    "type": "object",
    "default": null,
    "description": "Authentication backend configuration."
  },
  "storage": {
    "type": "object",
    "default": null,
    "description": "Storage backend configuration."
  },
  "rights": {
    "type": "object",
    "default": null,
    "description": "Rights management configuration."
  },
  "server.hosts": {
    "type": "list",
    "default": [
      "localhost:5232"
    ],
    "description": "List of host:port bindings."
  },
  "server.port": {
    "type": "number",
    "default": 5232,
    "description": "Default port (used if not embedded in hosts)."
  },
  "server.ssl.enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable SSL/TLS encryption."
  },
  "server.ssl.certificate": {
    "type": "string",
    "default": "/etc/ssl/certs/radicale.pem",
    "description": "Path to SSL certificate file (PEM format)."
  },
  "server.ssl.key": {
    "type": "string",
    "default": "/etc/ssl/private/radicale.key",
    "description": "Path to SSL private key file."
  },
  "server.debug": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose debug logging."
  },
  "auth.type": {
    "type": "string",
    "default": "None",
    "description": "Authentication backend type."
  },
  "auth.htpasswd_filename": {
    "type": "string",
    "default": "/etc/radicale/users",
    "description": "Path to htpasswd file."
  },
  "auth.htpasswd_encryption": {
    "type": "string",
    "default": "bcrypt",
    "description": "Password hashing method.",
    "enum": [
      "bcrypt",
      "sha256",
      "md5",
      "plain",
      "autodetect"
    ]
  },
  "auth.ldap_url": {
    "type": "string",
    "default": "ldap://localhost",
    "description": "LDAP server URL."
  },
  "auth.ldap_base": {
    "type": "string",
    "default": "ou=users,dc=example,dc=com",
    "description": "LDAP base DN."
  },
  "auth.ldap_bind_user": {
    "type": "string",
    "default": "cn=admin,dc=example,dc=com",
    "description": "LDAP bind DN."
  },
  "auth.ldap_bind_password": {
    "type": "string",
    "default": "",
    "description": "LDAP bind password."
  },
  "storage.type": {
    "type": "string",
    "default": "filesystem",
    "description": "Storage backend type."
  },
  "storage.filesystem_folder": {
    "type": "string",
    "default": "/var/lib/radicale/collections",
    "description": "Root directory for storing collections."
  },
  "storage.locking.lock_file": {
    "type": "string",
    "default": "/var/lib/radicale/lock",
    "description": "Path to lock file."
  },
  "rights.type": {
    "type": "string",
    "default": "owner_only",
    "description": "Rights management policy."
  },
  "rights.from_file.path": {
    "type": "string",
    "default": "/etc/radicale/rights",
    "description": "Path to rights configuration file."
  }
}
