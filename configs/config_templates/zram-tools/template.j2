# ==============================================================================
# ZRAM Tools Configuration Template
# ==============================================================================
# This template configures the zram-swap service. ZRAM creates a compressed
# block device in RAM, which is often faster and more space-efficient than
# traditional disk-based swap.
# ==============================================================================

# -----------------------------------------------------------------------------
# Compression algorithm selection
# -----------------------------------------------------------------------------
# Description: Compression algorithm to use for zram (e.g., lz4, zstd).
#              The default config ships with 'lz4'. The comment notes that
#              availability depends on the kernel configuration.
# Note:        Common algorithms include 'lz4' (fast) and 'zstd' (better
#              compression ratio). Check /sys/block/zram0/comp_algorithm to
#              see what is supported on your specific kernel.
# -----------------------------------------------------------------------------
ALGO={{ ALGO | default('lz4') }}

# -----------------------------------------------------------------------------
# RAM usage percentage
# -----------------------------------------------------------------------------
# Description: Percentage of total RAM to use for zram swap.
#              Takes precedence over SIZE if set. The config uses this as an
#              integer value directly in the assignment.
# Note:        If PERCENT is not 0, SIZE is ignored.
# -----------------------------------------------------------------------------
PERCENT={{ PERCENT | default('50') }}

# -----------------------------------------------------------------------------
# Static RAM size (MiB)
# -----------------------------------------------------------------------------
# Description: Static amount of RAM (in MiB) to use for zram devices.
#              Ignored if PERCENT is set. The config uses this as an integer
#              value directly in the assignment.
# Note:        Used only if PERCENT is effectively 0 or unset (depending on
#              the specific service implementation logic, but per schema,
#              PERCENT takes precedence).
# -----------------------------------------------------------------------------
SIZE={{ SIZE | default('512') }}

# -----------------------------------------------------------------------------
# Swap priority
# -----------------------------------------------------------------------------
# Description: Priority for the zram swap devices. Higher number means higher
#              priority. The config uses this as an integer value directly in
#              the assignment.
# Note:        According to swapon(2), higher priority devices are used first.
#              This should probably be higher than hdd/ssd swaps to ensure
#              RAM-backed swap is preferred.
# -----------------------------------------------------------------------------
PRIORITY={{ PRIORITY | default('100') }}
