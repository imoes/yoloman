# Connection speed for serial devices (in baud)
speed = {{ speed }}
# Model of the phone/modem — leave empty for autodetect
# model = {{ model }}
# Use this to override autodetected phone model (e.g., 'AT', 'Nokia5110')
# model = {{ model }}

[smsd]
# Path to the SMS log file
logfile = {{ logfile }}
# Log level: 0 = none, 1 = errors only, 2 = errors and info, 3 = debug
loglevel = {{ loglevel }}

# How many seconds to wait before sending the next SMS (rate limiting)
sendsmsretryinterval = {{ sendsmsretryinterval }}
# How many times to retry sending a failed SMS
sendsmsretries = {{ sendsmsretries }}

# Where to store sent SMS (archive folder)
sentfolder = {{ sentfolder }}
# Where to store unsent SMS (inbox folder)
inboxfolder = {{ inboxfolder }}
# Where to store SMS errors for later review
errorfolder = {{ errorfolder }}

# Whether to use PC-Suite mode for Nokia phones
# (disabled by default, only for older Nokia models)
# pcsuite = {{ pcsuite }}

# Enable or disable SMSD service on startup
# Not a config directive — use systemd/unit file or similar
# service_start = {{ service_start }}

# Method to send SMS: smsd, gammu, file
# 'file' writes to spool directory instead of sending immediately
# method = {{ method }}

# Database connection settings (optional, for MySQL/PostgreSQL)
{% if database_driver %}
# Use database to store SMS queue and logs
{
  database_driver = {{ database_driver }}
  database_host = {{ database_host }}
  database_user = {{ database_user }}
  database_password = {{ database_password | default('', true) }}
  database = {{ database_name }}
  database_port = {{ database_port }}
}
{% endif %}

# List of phone devices for redundancy/failover (advanced)
{% if devices %}
# Additional devices — format: deviceN = path, speed, model (optional)
{% for d in devices %}
device{{ loop.index }} = {{ d.path }}, {{ d.speed }}{% if d.model %}, {{ d.model }}{% endif %}
{% endfor %}
{% endif %}

# Security: run SMSD as different user/group (if supported by OS/service manager)
# user = {{ user }}
# group = {{ group }}
