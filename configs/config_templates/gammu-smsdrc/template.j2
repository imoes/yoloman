# Configuration file for Gammu SMS Daemon

# Gammu library configuration, see gammurc(5)
[gammu]
# Please configure this!
port = {{ port | default('/dev/null') }}
connection = {{ connection | default('at') }}
# Debugging
#logformat = textall

# SMSD configuration, see gammu-smsdrc(5)
[smsd]
service = {{ service | default('files') }}
logfile = {{ logfile | default('syslog') }}
# Increase for debugging information
debuglevel = {{ debuglevel | default(0) }}

# Paths where messages are stored
inboxpath = {{ inboxpath | default('/var/spool/gammu/inbox/') }}
outboxpath = {{ outboxpath | default('/var/spool/gammu/outbox/') }}
sentsmspath = {{ sentsmspath | default('/var/spool/gammu/sent/') }}
errorsmspath = {{ errorsmspath | default('/var/spool/gammu/error/') }}
