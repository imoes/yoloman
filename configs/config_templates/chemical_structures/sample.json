{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "max_connections": 256,
    "use_tls": true
  },
  "ssl": {
    "certfile": "/etc/letsencrypt/live/chem.example.com/fullchain.pem",
    "keyfile": "/etc/letsencrypt/live/chem.example.com/privkey.pem"
  },
  "database": {
    "type": "postgresql",
    "path": "",
    "connection_string": "postgresql://chemuser:secret123@db.internal:5432/chemdb"
  },
  "cache": {
    "enabled": true,
    "type": "redis",
    "redis_url": "redis://redis-cache.internal:6379/1",
    "max_size": null
  },
  "workers": {
    "count": 8,
    "request_timeout": 90
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/chemical-structures/chemweb.log"
  },
  "services": {
    "pubchem_enabled": false,
    "service_timeout": 20
  },
  "cors.origins": [
    {
      "host": "https://portal.example.com"
    },
    {
      "host": "https://staging-portal.example.com"
    },
    {
      "host": "http://localhost",
      "port": 3000
    }
  ]
}
