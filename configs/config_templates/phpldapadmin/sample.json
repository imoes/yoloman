{
  "ldap_server_host": "ldap.example.com",
  "ldap_server_port": 636,
  "ldap_use_tls": false,
  "ldap_base_dn": "dc=example,dc=com",
  "bind_auth_type": "config",
  "bind_dn": "cn=admin,dc=example,dc=com",
  "bind_password": "secretpass123",
  "friendly_attrs": [
    "uid",
    "cn",
    "mail",
    "displayName"
  ],
  "required_attrs": [
    "objectClass",
    "uid"
  ],
  "search_list_filter": "(|(objectClass=inetOrgPerson)(objectClass=groupOfNames))",
  "search_read_filter": "(objectClass=*)",
  "search_write_filter": "(objectClass=*)",
  "ldap_verify_peer": true,
  "ldap_verify_peer_name": true,
  "ldap_allow_self_signed": false,
  "schema_attr_order": [
    "objectClass",
    "cn",
    "uid",
    "mail"
  ],
  "schema_attr_display": [
    "objectClass: Object Classes",
    "cn: Common Name",
    "uid: Username",
    "mail: Email"
  ],
  "default_server_id": 1,
  "default_tree_dn": "dc=example,dc=com",
  "default_session_dn": "ou=People,dc=example,dc=com",
  "default_language": "en_US",
  "ui_theme": "phpldapadmin",
  "debug_enabled": false,
  "additional_servers": [
    {
      "name": "dev_ldap",
      "host": "dev-ldap.example.com",
      "port": 389,
      "tls": true,
      "bind_auth_type": "bind",
      "bind_dn": "",
      "bind_password": "",
      "base_dn": "dc=dev,dc=example,dc=com"
    }
  ],
  "allow_anonymous_bind": false,
  "session_timeout": 1800
}
