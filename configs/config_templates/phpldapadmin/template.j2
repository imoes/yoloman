<?php
/* phpldapadmin configuration file — generated by template */

/* Enable or disable debug mode */
{{# if debug_enabled }}
\$config = array('server' => array(
{{ else }}
$single_server = array(
{{/ if }}

  /* LDAP server hostname or IP address */
  'host' => '{{ ldap_server_host }}',

  /* LDAP server port */
  'port' => {{ ldap_server_port }},

  /* Use TLS for connections */
  'tls' => {{ ldap_use_tls | lower }},

  /* Base DN for the directory */
  'base' => array('{{ ldap_base_dn }}'),

  /* Bind DN for anonymous or authenticated access */
  'login' => array(
    'auth_type' => '{{ bind_auth_type }}',
    'bind_dn' => '{{ bind_dn | default('') }}',
    'bind_pass' => '{{ bind_password | default('') }}'
  ),

  /* User-specific search settings */
  'appearance' => array(
    'friendly_attrs' => array({{ friendly_attrs | map('"' + "'" + "'" | join("'", "'")") | join(', ') | default('') }}),
    'required_attrs' => array({{ required_attrs | map('"' + "'" + "'" | join("'", "'")") | join(', ') | default('') }})
  ),

  /* Optional custom filters for searches */
  'filters' => array(
    'list' => '{{ search_list_filter }}',
    'read' => '{{ search_read_filter }}',
    'write' => '{{ search_write_filter }}'
  ),

  /* Enable or disable SSL verification */
  'ssl' => array(
    'verify_peer' => {{ ldap_verify_peer | lower }},
    'verify_peer_name' => {{ ldap_verify_peer_name | lower }},
    'allow_self_signed' => {{ ldap_allow_self_signed | lower }}
  ),

  /* Optional custom LDAP schema extensions */
  'schema' => array(
    'attr_order' => array({{ schema_attr_order | map('"' + "'" + "'" | join("'", "'")") | join(', ') | default('') }}),
    'attr_display' => array({{ schema_attr_display | map("'{}': '{}'".format | join(", ") | default('') }})
  ),

  /* Custom UI settings */
  'ui' => array(
    'default_server' => {{ default_server_id }},
    'default_tree' => '{{ default_tree_dn }}',
    'default_session' => '{{ default_session_dn }}',
    'language' => '{{ default_language }}',
    'theme' => '{{ ui_theme }}'
  )
);

/* Additional servers can be added here via $servers->addServer() */
{{# if additional_servers }}
{{# for server in additional_servers }}
{{ server.name }} = array(
  'host' => '{{ server.host }}',
  'port' => {{ server.port }},
  'tls' => {{ server.tls | lower }},
  'base' => array('{{ server.base_dn }}'),
  'login' => array(
    'auth_type' => '{{ server.bind_auth_type }}',
    'bind_dn' => '{{ server.bind_dn | default('') }}',
    'bind_pass' => '{{ server.bind_password | default('') }}'
  )
);
{{ endfor }}
{{ endif }}

/* Define servers array (only needed if using multiple servers) */
{{# if additional_servers }}
$servers = new Datastore();
{{# for server in additional_servers }}
$servers->addServer('{{ server.name }}', {{ server.name }});
{{ endfor }}
{{ endif }}

/* Enable/disable anonymous bind fallback */
{{# if allow_anonymous_bind }}
\$config['login']['anon_bind'] = true;
{{ else }}
\$config['login']['anon_bind'] = false;
{{/ if }}

/* Custom session timeout in seconds */
\$session_timeout = {{ session_timeout }};
