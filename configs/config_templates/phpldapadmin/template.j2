# ==============================================================================
# phpldapadmin Apache VirtualHost Configuration Template
# ==============================================================================
# This template configures Apache for phpLDAPadmin. It provides both an Alias
# (default) and an optional VirtualHost block.
#
# Schema Variables:
#   - ldap_server_hostname: Hostname for the LDAP server (used in VHost and logs)
#   - admin_email:          Administrator email for the VirtualHost
# ==============================================================================

# --- Alias Configuration ---
# Define /phpldapadmin alias, this is the default.
# This allows access to phpldapadmin at http://<host>/phpldapadmin
<IfModule mod_alias.c>
    # Alias directive mapping the URL path to the physical directory.
    Alias /phpldapadmin /usr/share/phpldapadmin/htdocs
</IfModule>

# --- VirtualHost Configuration (Optional/Commented Out) ---
# You can also use phpLDAPadmin as a dedicated VirtualHost.
# Uncomment the block below and adjust ServerName to enable this mode.
# <VirtualHost *:*>
#     # The hostname used in this VirtualHost and log filenames.
#     # Defaults to 'ldap.example.com' if not specified in variables.
#     ServerName {{ ldap_server_hostname | default('ldap.example.com') }}
#
#     # Administrator email address for server alerts.
#     # Defaults to 'root@example.com' if not specified in variables.
#     ServerAdmin {{ admin_email | default('root@example.com') }}
#
#     # Document root for phpLDAPadmin.
#     DocumentRoot /usr/share/phpldapadmin
#
#     # Error log filename, incorporating the hostname for differentiation.
#     # Example: ldap.example.com-error.log
#     ErrorLog logs/{{ ldap_server_hostname | default('ldap.example.com') }}-error.log
#
#     # Access log filename, incorporating the hostname for differentiation.
#     # Example: ldap.example.com-access.log
#     CustomLog logs/{{ ldap_server_hostname | default('ldap.example.com') }}-access.log common
# </VirtualHost>

# --- Directory Security and PHP Configuration ---
# Secure the phpLDAPadmin htdocs directory.
<Directory /usr/share/phpldapadmin/htdocs/>

    # Specify the default index file.
    DirectoryIndex index.php

    # Enable symbolic link following for better flexibility in asset linking.
    Options +FollowSymLinks

    # Disable .htaccess overrides for security and performance.
    AllowOverride None

    # ------------------------------------------------------------------
    # Limit PHP execution to necessary paths for security.
    # We restrict open_basedir to prevent PHP scripts from reading
    # arbitrary files on the system outside of these allowed paths.
    # ------------------------------------------------------------------

    # PHP 7 Configuration Block
    # Activates only if mod_php7 is loaded by Apache.
    <IfModule mod_php7.c>
        php_admin_value open_basedir /tmp:/usr/share/phpldapadmin/:/usr/share/doc/phpldapadmin:/etc/phpldapadmin/
    </IfModule>

    # PHP 8+ Configuration Block
    # Activates only if mod_php (generic/mod_php8) is loaded by Apache.
    <IfModule mod_php.c>
        php_admin_value open_basedir /tmp:/usr/share/phpldapadmin/:/usr/share/doc/phpldapadmin:/etc/phpldapadmin/
    </IfModule>

</Directory>
