# phpLDAPadmin Apache configuration
#
# This template configures the Apache Web Server to host the phpLDAPadmin web application.
# It defines the URL alias, sets up the directory permissions, and configures PHP-specific
# security directives (open_basedir) to restrict PHP file access to the necessary paths.
#
# Variables used:
#   - ldap_server_hostname: Used in VirtualHost examples (commented out by default)
#   - admin_email: Used in VirtualHost examples (commented out by default)

# Define /phpldapadmin alias, this is the default
# Maps the URL path /phpldapadmin to the physical directory where phpLDAPadmin is installed.
<IfModule mod_alias.c>
    Alias /phpldapadmin /usr/share/phpldapadmin/htdocs
</IfModule>

# You can also use phpLDAPadmin as a VirtualHost
# Uncomment the block below to run phpLDAPadmin as a dedicated VirtualHost.
# Note: Ensure the 'ldap_server_hostname' and 'admin_email' variables are set correctly.
# <VirtualHost *:*>
#     # The hostname used in the VirtualHost block and log filenames (e.g., ldap.example.com)
#     ServerName {{ ldap_server_hostname | default('ldap.example.com') }}
#
#     # Administrator email address for the VirtualHost
#     ServerAdmin {{ admin_email | default('root@example.com') }}
#
#     # The document root for the phpLDAPadmin application
#     DocumentRoot /usr/share/phpldapadmin
#
#     # Error log filename, incorporating the hostname for easy identification
#     ErrorLog logs/{{ ldap_server_hostname | default('ldap.example.com') }}-error.log
#
#     # Access log filename, incorporating the hostname for easy identification
#     CustomLog logs/{{ ldap_server_hostname | default('ldap.example.com') }}-access.log common
# </VirtualHost>

# Directory configuration for the phpLDAPadmin htdocs folder
<Directory /usr/share/phpldapadmin/htdocs/>

    # Specify the index file to serve when a directory is requested
    DirectoryIndex index.php

    # Follow symbolic links within this directory
    Options +FollowSymLinks

    # Disable .htaccess overrides for security and performance
    AllowOverride None

    # limit libapache2-mod-php to the necessary files and directories
    # Restricts PHP's open_basedir to prevent script access to sensitive system files.

    # PHP 7 specific configuration
    <IfModule mod_php7.c>
        # Set open_basedir for PHP 7: allows access only to tmp, the application directory, docs, and config
        php_admin_value open_basedir /tmp:/usr/share/phpldapadmin/:/usr/share/doc/phpldapadmin:/etc/phpldapadmin/
    </IfModule>

    # PHP 8+ specific configuration
    <IfModule mod_php.c>
        # Set open_basedir for PHP 8+: allows access only to tmp, the application directory, docs, and config
        php_admin_value open_basedir /tmp:/usr/share/phpldapadmin/:/usr/share/doc/phpldapadmin:/etc/phpldapadmin/
    </IfModule>

</Directory>