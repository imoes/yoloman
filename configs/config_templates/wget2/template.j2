# Wget2 global configuration file
# Generated by configuration management system

# Global config file location (default: /usr/local/etc/wget2rc)
# System-wide defaults can be overridden by user config

# Set the directory prefix where files will be saved (default: .)
directory-prefix = {{ directory_prefix }}

