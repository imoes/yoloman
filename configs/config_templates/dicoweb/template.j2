# Passenger configuration for dicoweb
# This block disables the handler for the favicon to prevent unnecessary processing or errors
<Location "/favicon.ico">
    # Disable the handler for favicon.ico requests
    SetHandler None
</Location>

# Conditional block for Passenger module directives
<IfModule mod_passenger.c>
    # Enable Passenger for this context
    PassengerEnabled On

    # Specify the Python interpreter binary used by Passenger
    # Default: /usr/bin/python3
    PassengerPython /usr/bin/python3

    # Directory block for the Passenger-managed application root
    # The path is defined by the passenger_root variable
    <Directory "{{ passenger_root | default('/var/lib/dicoweb/passenger') }}">
        # Grant access to all users for the application directory
        Require all granted
    </Directory>
</IfModule>
