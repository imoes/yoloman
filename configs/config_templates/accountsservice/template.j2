# /etc/accountsservice/users/<username>
# User account metadata file for accountsservice
# Generated automatically by accountsservice; do not edit manually
# See `man 5 users` for format documentation

[User]
# Full name displayed in greeter and tools
Username={{ username }}
# Full display name
RealName={{ real_name }}
# Path to user's avatar image (PNG or XPM; should be world-readable)
Icon={{ icon_path }}
# Account type: `standard` (default), `administrator`
AccountType={{ account_type }}
# Password hint (optional; blank to hide)
PasswordHint={{ password_hint | default('') }}
# Location of password hint (deprecated; ignored by modern accountsservice)
PasswordMode={{ password_mode | default('') }}
# Language code (e.g., `en_US`); blank to inherit from system
Language={{ language | default('') }}
# Session type (e.g., `gnome`, `plasma`, `xfce`); blank for default
Session={{ session | default('') }}
# Login frequency: `never`, `recent`, `always`
LoginFrequency={{ login_frequency | default('recent') }}
# Last login time (epoch seconds; auto-updated)
LastLogin={{ last_login | default(0) }}
# Number of failed login attempts
LoginFailed={{ login_failed | default(0) }}
# Automatic login enabled?
AutomaticLogin={{ 'true' if automatic_login else 'false' }}
# Auto-login without password prompt (insecure)
AutomaticLoginWhileLocked={{ 'true' if automatic_login_while_locked else 'false' }}
# Password expiry (epoch seconds); 0 = never
PasswordExpiry={{ password_expiry | default(0) }}
# Password changed time (epoch seconds)
PasswordChanged={{ password_changed | default(0) }}
# System account flag (true for UID < 1000, usually hidden from greeter)
SystemAccount={{ 'true' if system_account else 'false' }}
# Custom fields (e.g., `PolicyKitIdentity=unix-user:{{ username }}`)
{% for key, value in custom_fields.items() %}
{{ key }}={{ value }}
{% endfor %}
