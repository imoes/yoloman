#	   exec chmod 600 `dirname $TODODB`/.todo.html
#}

# Verbosity Settings
# Make the tool verbose during specific actions to show prompts.
on add verbose
on edit verbose
on title verbose

# Default Priority
# Use default priority when editing, adding, or grafting items.
# This suppresses interactive prompting for priority if a default is configured.
#priority default