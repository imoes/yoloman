# Module: ejabberd_mod_post_log — HTTP POST message logger
# Enables logging of all end-to-end messages via HTTP POST requests to a remote endpoint.
mod_post_log:
  # HTTP endpoint to receive logged messages
  http_endpoint: "{{ http_endpoint }}"
  # HTTP method used for POST requests
  http_method: "{{ http_method }}"
  # Optional HTTP headers to include in requests
{% for header in http_headers %}  # {{ header.key }}: {{ header.value }}
{% endfor %}  http_headers:
{% for header in http_headers %}    - "{{ header.key }}: {{ header.value }}"
{% endfor %}  # Maximum number of queued log messages before dropping (0 = unlimited)
  queue_size: {{ queue_size }}
  # Maximum batch size (messages per POST request)
  batch_size: {{ batch_size }}
  # Timeout for HTTP requests (seconds)
  timeout: {{ timeout }}
  # Retry attempts on failure
  retry_attempts: {{ retry_attempts }}
  # Delay between retries (seconds)
  retry_delay: {{ retry_delay }}
  # Enable SSL/TLS verification (set to false only in dev/test)
  ssl_verify: {{ ssl_verify }}
  # Optional client certificate and key for mutual TLS (paths are relative to ejabberd config dir or absolute)
{% if cert_file %}  cert_file: "{{ cert_file }}"
{% endif %}{% if keyfile %}  keyfile: "{{ keyfile }}"
{% endif %}