{
  "http_endpoint": "https://logs.example.com/ejabberd/messages",
  "http_method": "POST",
  "http_headers": [
    {
      "key": "Authorization",
      "value": "Bearer secret-token-123"
    },
    {
      "key": "X-Source",
      "value": "ejabberd-cluster-a"
    }
  ],
  "queue_size": 2048,
  "batch_size": 100,
  "timeout": 10,
  "retry_attempts": 5,
  "retry_delay": 3,
  "ssl_verify": true,
  "cert_file": "/etc/ejabberd/client.crt",
  "keyfile": "/etc/ejabberd/client.key"
}
