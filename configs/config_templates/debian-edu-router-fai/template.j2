# ==============================================================================
# debian-edu-router-fai configuration template
# ==============================================================================
# This file configures the FAI (Fully Automatic Installation) environment for
# the Debian Edu Router installer.
#
# Self-Documentation:
# - fai_logserver: The hostname (FQDN) of the FAI server. Used for pushing
#                  installation logs via savelog. If empty, savelog is disabled.
# - fai_loguser:   The system user account on the FAI server used for SSH-based
#                  log transfer. Must exist and have SSH access configured.
# - supported_locales: Space-separated list of UTF-8 locales available in the
#                      installer environment.
# - default_locale:  The default locale selected by the installer if the user
#                    does not choose one explicitly.

# -----------------------------------------------------------------------------
# FAI Logging Configuration
# -----------------------------------------------------------------------------

# FAI server hostname (FQDN) for savelog feature.
# If left empty, logs are not pushed to a central FAI server.
# Example: 'fai.example.com'
{{ fai_logserver | default('') }}

# FAI system user for savelog.
# This user must exist on the FAI server and have SSH key-based access configured.
# Example: 'fai'
{{ fai_loguser | default('') }}

# -----------------------------------------------------------------------------
# Localization Settings
# -----------------------------------------------------------------------------

# Supported locales for the Debian Edu Router installer.
# Space-separated list of valid UTF-8 locale identifiers.
# Default includes English (C) and German (de_DE).
# Example: 'C.UTF-8 en_US.UTF-8 de_DE.UTF-8 fr_FR.UTF-8'
{{ supported_locales | default('C.UTF-8 de_DE.UTF-8') }}

# Default locale for the installer.
# This locale is used if the user does not explicitly select one during installation.
# Must be included in `supported_locales`.
# Example: 'en_US.UTF-8'
{{ default_locale | default('C.UTF-8') }}

# -----------------------------------------------------------------------------
# Placeholder / Future Configuration (Commented Out)
# -----------------------------------------------------------------------------
# The following settings are currently commented out or handled by the installer
# script logic. Uncomment and adjust if specific customization is required.

# Deployment server URL (inherits from fai_logserver if configured).
# deployment_server={{ fai_logserver | default('') }}

# APT mirror URL for package installation.
# mirrorurl=http://deb.debian.org/debian

# TFTP directory for boot files.
# tftpdir=/srv/tftp

# List of Debian codenames to build FAI installers for.
# codenames="bookworm trixie"

# Default codename for iPXE boot menu.
# default_codename="bookworm"

# FAI chroot architectures (e.g., amd64, i386).
# archs="amd64"

# Default architecture for iPXE boot menu.
# default_arch="amd64"

# Root password for FAI-installed devices (MD5 hash).
# rootpw='<pwhash>'

# School tag identifier.
# school_tag='SKOLE'
