# ethstatus configuration file
# This configuration monitors the link status and throughput of a specific network interface.
# It uses curses (NCurses) for display, so it is suitable for terminal-based monitoring.

# Ethernet interface to monitor (e.g., eth0, ens33).
# Must correspond to a real network interface on the system.
# If the interface is down, ethstatus will report it as such.
interface = {{ interface|default('eth0') }}

# Video mode for the curses display.
# Valid values:
#   - 'vga': Color display (default).
#   - 'mono': Monochrome display (for older terminals).
videomode = {{ videomode|default('vga') }}

# Maximum network speed in bits per second.
# Use an optional suffix for convenience: 'k' (kilobits), 'm' (megabits), 'g' (gigabits).
# Examples: '100m', '1g', '1000000000'.
# Leave empty (default) to omit this constraint, allowing ethstatus to detect speed
# dynamically or use its internal defaults based on the interface capabilities.
speed_bps = {{ speed_bps|default('') }}

# Maximum network speed using legacy numeric values.
# This field is provided strictly for backward compatibility.
# Valid values: '10', '100', '64', '128', '256', '768', '1540'.
# If `speed_bps` is set, this field is ignored.
# Leave empty to omit.
speed_legacy = {{ speed_legacy|default('') }}