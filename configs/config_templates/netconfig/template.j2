# Netconfig - RPC transport configuration for libtirpc
# This file configures the default RPC transport settings for the system.
# It is used by programs such as NFS clients, NIS, and other RPC-based services.
# Format: key value (space- or tab-separated)
# The 'netconfig' file defines protocol families, protocols, and their properties.
{% for entry in entries %}# {{ entry.comment | default('') }}
{% if entry.comment %}{{ entry.key }}{{ ' ' if not entry.key[-1].isspace() else '' }}{{ entry.value }}{% else %}{{ entry.key }} {{ entry.value }}{% endif %}
{% endfor %}