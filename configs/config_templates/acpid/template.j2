# Options to pass to acpid
#
# OPTIONS are appended to the acpid command-line
{% if options is defined and options is not none and (options is number or options is boolean or options | length > 0) %}OPTIONS={{ options }}
{% else %}#OPTIONS=""
{% endif %}
# Linux kernel modules to load before starting acpid
#
# MODULES is a space separated list of modules to load, or "all" to load all
# acpi drivers, or commented out to load no module
{% if modules is defined and modules is not none and (modules is number or modules is boolean or modules | length > 0) %}MODULES={{ modules }}
{% else %}#MODULES="battery ac processor button fan thermal video"
{% endif %}#MODULES="all"
