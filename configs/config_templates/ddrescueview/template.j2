# ==============================================================================
# ddrescueview configuration file
#
# This configuration file controls the initial window state, grid settings,
# and operational modes for ddrescueview.
#
# Self-documented: Each directive is preceded by its schema description.
# All variables use safe defaults to allow reuse without prior variable definition.
# ==============================================================================

# X position of window on screen, in pixels.
-x {{ (window_x | default(0)) }}

# Y position of window on screen, in pixels.
-y {{ (window_y | default(0)) }}

# Client width of window, in pixels.
-w {{ (window_width | default(800)) }}

# Client height of window, in pixels.
-h {{ (window_height | default(600)) }}

# Grid size on start (allowed values: 4,6,8,10,12,14,16,20,24).
-gs {{ (grid_size | default(8)) }}

# Set refresh interval (allowed values: off,5s,10s,30s,1m,2m,5m).
-r {{ (refresh_interval | default('off')) }}

# Use binary unit prefixes instead of decimal.
# If true, output sizes will use KiB, MiB, etc. instead of KB, MB.
{% if use_binary_units | default(False) | bool %}-ub{% endif %}

# Show log panel at bottom on start.
# If true, the log output area will be visible immediately.
{% if show_log_panel | default(False) | bool %}-lp{% endif %}

# Turn off optimizations (safe mode).
# If true, disables potentially risky optimizations in the GUI rendering.
{% if safe_mode | default(False) | bool %}-safe{% endif %}