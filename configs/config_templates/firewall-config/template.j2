# ==============================================================================
# firewalld configuration file (/etc/firewalld/firewalld.conf)
# ==============================================================================
# This file is auto-generated by Ansible. Do not edit manually.
#
# Reference: firewalld.conf(5)
# ==============================================================================

# The default zone applied to new interfaces and connections if no other zone matches.
# Default zone: {{ default_zone | default('public') }}
DefaultZone={{ default_zone | default('public') }}

# If true, only load rules required for the active zones on firewalld start.
# This reduces the rule set at startup to only what is actively used.
MinimizeRules={{ minimize_rules | default(false) | ternary('yes', 'no') }}

# Enable logging of denied packets: 'off', 'unicast', 'broadcast', 'multicast', or 'all'.
# Use 'all' to log denied traffic from all zones, 'unicast' for unicast only, etc.
# Default logging level: {{ log_denied | default('off') }}
LogDenied={{ log_denied | default('off') | lower }}

# If true, log rich language rules separately.
# Rich logging provides more detailed information about matched rules.
RichLogging={{ rich_logging | default(false) | ternary('yes', 'no') }}

# If true, enable connection tracking (required for stateful packet inspection).
# Most modern firewalls require this for proper handling of established connections.
Conntrack={{ conntrack | default(true) | ternary('yes', 'no') }}

# If true, enable IPv4 masquerading (NAT) in the default zone.
# Masquerading allows internal clients to access external networks via the firewall's IP.
Masquerade={{ masquerade | default(false) | ternary('yes', 'no') }}

# If true, enable IPv4 packet forwarding between zones.
# Required if the firewall is routing traffic between different network segments.
Forward={{ forward | default(false) | ternary('yes', 'no') }}

# If true, enable IPv6 packet forwarding between zones.
# Same as Forward, but for IPv6 traffic.
ForwardIPv6={{ forward_ipv6 | default(false) | ternary('yes', 'no') }}

# List of allowed services in the default zone.
# Each service name corresponds to a service file in /usr/lib/firewalld/services/
# or /etc/firewalld/services/.
# Example services: ssh, http, https, dhcpv6-client
{% if services is defined and services %}
# --- Allowed Services ---
{% for service in services %}
# Service: {{ service | string }}
{% endfor %}
{% endif %}

# List of interface names that should be treated as trusted.
# Trusted interfaces bypass firewall rules; all traffic on them is allowed.
# Multiple interfaces are space-separated.
# Example: TrustedInterfaces="eth0 lo"
TrustedInterfaces={{ trusted_interfaces | default([]) | join(' ') }}

# If true, forward DNS queries to configured DNS servers.
# Requires DnsForwardServer entries to be populated.
DnsForward={{ dns_forward | default(false) | ternary('yes', 'no') }}

# List of DNS servers to which DNS queries are forwarded when DnsForward is enabled.
# Each server is specified on its own line as DnsForwardServer=IP.
{% if dns_servers is defined and dns_servers %}
# --- DNS Forward Servers ---
{% for server in dns_servers %}
DnsForwardServer={{ server | string }}
{% endfor %}
{% endif %}

# If true, apply rate limiting to ICMPv4 traffic.
# Helps mitigate ICMP-based floods or ping sweeps.
IcmpRateLimit={{ icmp_rate_limit | default(true) | ternary('yes', 'no') }}

# If true, apply rate limiting to ICMPv6 traffic.
# Helps mitigate IPv6 Neighbor Discovery floods.
Icmpv6RateLimit={{ icmpv6_rate_limit | default(true) | ternary('yes', 'no') }}