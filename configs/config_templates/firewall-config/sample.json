{
  "default_zone": "internal",
  "minimize_rules": true,
  "log_denied": "unicast",
  "rich_logging": true,
  "conntrack": true,
  "masquerade": true,
  "forward": true,
  "forward_ipv6": false,
  "services": [
    "ssh",
    "dhcpv6-client",
    "mdns",
    "samba-client"
  ],
  "trusted_interfaces": [
    "lo",
    "virbr0"
  ],
  "dns_forward": true,
  "dns_servers": [
    "127.0.0.53",
    "8.8.8.8"
  ],
  "icmp_rate_limit": true,
  "icmpv6_rate_limit": true
}
