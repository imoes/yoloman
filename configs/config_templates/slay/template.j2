# Slay configuration file (/etc/slay_mode)
# This file controls the behavior of the 'slay' command.
# It accepts two types of keywords: Mode (mean/nice) and Message Style (butthead/normal).

# Sets the privilege enforcement mode.
# 'mean': Punishes non-root users attempting to slay others (default).
# 'nice': Allows non-root users to slay without punishment.
{{ slay_mode | default('mean') }}

# Sets the output message style.
# 'butthead': Displays humorous/aggressive messages.
# 'normal': Displays standard messages (default).
{{ slay_message_style | default('normal') }}