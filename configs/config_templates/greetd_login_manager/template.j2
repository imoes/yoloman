# grettd main configuration
# This file is parsed by greetd as TOML.

# Terminal device to use for the login session (e.g., VT or TTY)
terminal = {{ terminal }}

# Path to the greeter executable (must support the greetd protocol)
greeter = "{{ greeter_path }}"

# Optional: arguments passed to the greeter on startup
greeter_args = {{ greeter_args | to_json }}

# Session command template — `{{ user }}` and `{{ session_cmd }}` are substituted
session_cmd = "{{ session_cmd_template }}"

# Maximum number of concurrent sessions allowed
max_sessions = {{ max_sessions }}

# Whether to automatically start a session after a timeout (in seconds)
auto_login = {{ auto_login | to_json }}

# Optional: user to auto-login (only used if auto_login is enabled)
auto_login_user = {{ auto_login_user | to_json }}

# Timeout (in seconds) for auto-login; 0 = disable timeout
auto_login_timeout = {{ auto_login_timeout }}

# Optional: seat to manage (default: "seat0")
seat = "{{ seat }}"

# Optional: list of additional TTYs to use (e.g., ["tty2", "tty3"])
ttys = {{ ttys | to_json }}

# Optional: custom PAM service name (default: "greetd")
pam_service = "{{ pam_service }}"

# Optional: session environment variables to export to sessions
# Note: greetd currently does not support per-session env vars natively; this is a placeholder for documentation
# env = {{ env | to_json }}
