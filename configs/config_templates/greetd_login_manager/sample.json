{
  "terminal": "/dev/tty1",
  "greeter_path": "/usr/bin/greetd-gtk-greeter",
  "greeter_args": [
    "--theme",
    "adw-gtk3"
  ],
  "session_cmd_template": "exec /bin/sh -c 'exec -- $0 \"$@\"' -- {{ session_cmd }}",
  "max_sessions": 10,
  "auto_login": true,
  "auto_login_user": "alice",
  "auto_login_timeout": 5,
  "seat": "seat0",
  "ttys": [],
  "pam_service": "greetd"
}
