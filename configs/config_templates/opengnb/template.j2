# OpenGNB Address Configuration
#
# This file defines the GNBTorrent Index Nodes for the OpenGNB network.
# Format per line: |<attrib>|<nodeid>|<ipv4/ipv6>|<port>
#
# Attributes:
#   i  = Index Node (Primary/Secondary)
#   if = Index Node (Failover/Redundant)
#   n  = Node (Regular tracker/node)
#
# The 'network.public_index_nodes' variable should contain a list of lists,
# where each inner list is [host: str, port: int].
# If this list is empty or undefined, no public index nodes will be configured.

# -----------------------------------------------------------------------------
# Public Index Nodes
# -----------------------------------------------------------------------------
# List of public gnb index nodes provided by volunteers.
# These public gnb index nodes may change; please visit
# https://github.com/gnbdev/opengnb/blob/master/README_EN.md and
# https://github.com/gnbdev/opengnb/blob/master/examples/node_config_example/address.conf
# to get the newest public gnb index nodes info.
# OpenGNB will take effect if at least one of these nodes exists when you don't
# setup your own index node.
#
# Note: The specific IPs below are the schema defaults. In production, these
# are typically updated by the upstream maintainers or overridden via Ansible vars.

# Iterate through the configured public index nodes.
# Default schema provides two entries, but we handle arbitrary length safely.
# Using direct list iteration to safely access index-based data without Python method calls.
{% for idx_info in (network | default({})).public_index_nodes | default([['101.32.178.3', 9001], ['45.78.14.231', 9001]]) %}
{%   set host = idx_info[0] | default('') %}
{%   set port = idx_info[1] | default(9001) %}
{%   if host and host is string and host | length > 0 %}
i|0|{{ host }}|{{ port }}
{%   endif %}
{% endfor %}

# You may also setup your own gnb index node and use it.
# To add custom nodes, append lines in the same format:
# i|1|<custom-host>|<custom-port>
# or use the Ansible variable `network.custom_index_nodes` if supported by your role.
