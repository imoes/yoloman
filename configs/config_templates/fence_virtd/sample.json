{
  "listen_interfaces": [
    {
      "name": "virbr0",
      "address": "192.168.122.1",
      "port": 1229
    },
    {
      "name": "eth0",
      "address": "10.0.0.5",
      "port": 1229
    }
  ],
  "key_file": "/etc/cluster/fence_xvm.key",
  "backends": [
    {
      "name": "libvirt",
      "timeout": 60
    },
    {
      "name": "xen",
      "timeout": 45
    }
  ],
  "log_level": 4,
  "log_facility": "daemon",
  "ipv6": true,
  "max_connections": 50,
  "tls_enabled": true,
  "tls_cert": "/etc/cluster/fence_virt.crt",
  "tls_key": "/etc/cluster/fence_virt.key",
  "tls_ca_cert": "/etc/cluster/fence_virt_ca.crt",
  "socket_path": "/var/run/fence_virt.sock",
  "default_timeout": 45
}
