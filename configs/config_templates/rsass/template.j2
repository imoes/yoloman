# Rsass CLI compilation configuration
# Generated from Ansible schema for package: rsass
# See rsass-cli(1) man page for full documentation.

# =============================================================================
# Input Files
# =============================================================================
# List of SCSS input files to compile.
# Each entry in the 'inputs' list becomes a separate file argument.
{% for input in inputs | default([], true) %}
# Input: {{ input }}
{{ input }}
{% endfor %}

# =============================================================================
# Output Style
# =============================================================================
# CSS output format. Must be one of: expanded, compressed.
# 'expanded' makes it easy to read by using one line per declaration.
# 'compressed' removes unnecessary whitespace for smaller file size.
# --style {{ output_style | default('expanded', true) }}

# =============================================================================
# Number Precision
# =============================================================================
# Number of digits of precision for decimal numbers in the output CSS.
# Higher precision results in more accurate colors and measurements but larger files.
# --precision {{ precision | default(5, true) | int }}

# =============================================================================
# Load Paths
# =============================================================================
# Directories to search for included resources (files imported via @import/@use).
# Multiple paths can be specified to allow modular SCSS imports from different locations.
{% for item in load_paths | default([], true) %}
# Load path: {{ item.path }}
# --load-path {{ item.path }}
{{ item.path }}
{% endfor %}