{
  "bot": {
    "type": "object",
    "default": {},
    "description": "Core bot identity and connection settings",
    "items": {
      "nick": {
        "type": "string",
        "default": "limnoria",
        "description": "IRC nickname the bot will use"
      },
      "user": {
        "type": "string",
        "default": "limnoria",
        "description": "IRC username (ident) the bot will use"
      },
      "realname": {
        "type": "string",
        "default": "Limnoria bot",
        "description": "IRC realname/GECOS field"
      },
      "server": {
        "type": "string",
        "default": "irc.libera.chat",
        "description": "IRC server hostname or IP"
      },
      "port": {
        "type": "number",
        "default": 6697,
        "description": "IRC server port (6697 for SSL, 6667 for plain)"
      },
      "password": {
        "type": "string",
        "default": "",
        "description": "Server password (if required), leave blank if none"
      },
      "use_ssl": {
        "type": "bool",
        "default": true,
        "description": "Enable TLS/SSL for connection"
      },
      "use_proxy": {
        "type": "bool",
        "default": false,
        "description": "Route connection through SOCKS5 proxy"
      },
      "proxy_host": {
        "type": "string",
        "default": "",
        "description": "Proxy hostname or IP"
      },
      "proxy_port": {
        "type": "number",
        "default": 0,
        "description": "Proxy port (0 = omit)"
      },
      "proxy_user": {
        "type": "string",
        "default": "",
        "description": "Proxy authentication username (if any)"
      },
      "proxy_password": {
        "type": "string",
        "default": "",
        "description": "Proxy authentication password (if any)"
      }
    }
  },
  "channels": {
    "type": "list",
    "default": [],
    "description": "List of channels the bot will auto-join on connect",
    "items": {
      "type": "object",
      "items": {
        "name": {
          "type": "string",
          "default": "#limnoria",
          "description": "Channel name (e.g., '#mychannel')"
        },
        "key": {
          "type": "string",
          "default": "",
          "description": "Channel key/password (if required), leave blank if none"
        }
      }
    }
  },
  "admins": {
    "type": "list",
    "default": [],
    "description": "List of IRC hostmasks (e.g., user!*@host) with full administrative access",
    "items": {
      "type": "string",
      "default": "user!*@*"
    }
  },
  "command_prefix": {
    "type": "string",
    "default": "!",
    "description": "Prefix used to invoke bot commands (e.g., '!help')"
  },
  "timezone": {
    "type": "string",
    "default": "UTC",
    "description": "Default timezone (IANA name, e.g., 'America/New_York', or 'UTC')"
  },
  "logging": {
    "type": "object",
    "default": {},
    "description": "Logging configuration",
    "items": {
      "enabled": {
        "type": "bool",
        "default": true,
        "description": "Enable logging"
      },
      "path": {
        "type": "string",
        "default": "/var/log/limnoria",
        "description": "Directory to store log files"
      },
      "format": {
        "type": "string",
        "default": "{time} [{level}] {message}",
        "description": "Log message format (supports {time}, {level}, {message} placeholders)"
      },
      "level": {
        "type": "string",
        "default": "INFO",
        "description": "Minimum log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)"
      }
    }
  },
  "plugins": {
    "type": "list",
    "default": [],
    "description": "List of plugins to load and their activation status",
    "items": {
      "type": "object",
      "items": {
        "name": {
          "type": "string",
          "default": "admin",
          "description": "Plugin name (case-sensitive)"
        },
        "enabled": {
          "type": "bool",
          "default": true,
          "description": "Load and enable this plugin"
        },
        "config": {
          "type": "object",
          "default": {},
          "description": "Per-plugin configuration (if supported)",
          "items": {}
        }
      }
    }
  },
  "limits": {
    "type": "object",
    "default": {},
    "description": "Rate limiting and flood control settings",
    "items": {
      "flood_rate": {
        "type": "number",
        "default": 2.0,
        "description": "Flood rate threshold: messages per second"
      },
      "flood_burst": {
        "type": "number",
        "default": 10,
        "description": "Maximum burst (messages) before flood control triggers"
      },
      "max_messages_per_minute": {
        "type": "number",
        "default": 60,
        "description": "Maximum messages per minute per channel/user"
      }
    }
  },
  "database": {
    "type": "object",
    "default": {},
    "description": "Database connection settings",
    "items": {
      "url": {
        "type": "string",
        "default": "sqlite:///var/lib/limnoria/limnoria.db",
        "description": "Database URL (SQLAlchemy style)"
      }
    }
  },
  "language": {
    "type": "string",
    "default": "en_US",
    "description": "Bot interface language (locale code)"
  },
  "debug": {
    "type": "object",
    "default": {},
    "description": "Debug mode settings",
    "items": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "Enable debug mode (verbose output, stack traces)"
      }
    }
  }
}
