{
  "bot": {
    "nick": "mybot",
    "user": "mybot",
    "realname": "My Limnoria Bot",
    "server": "irc.libera.chat",
    "port": 6697,
    "password": "",
    "use_ssl": true,
    "use_proxy": false,
    "proxy_host": "",
    "proxy_port": 0,
    "proxy_user": "",
    "proxy_password": ""
  },
  "channels": [
    {
      "name": "#mychannel",
      "key": ""
    },
    {
      "name": "#mychannel2",
      "key": "secretkey"
    }
  ],
  "admins": [
    "admin!*@*.example.com",
    "op!*@*.example.com"
  ],
  "command_prefix": "!",
  "timezone": "America/New_York",
  "logging": {
    "enabled": true,
    "path": "/var/log/limnoria",
    "format": "{time} [{level}] {message}",
    "level": "INFO"
  },
  "plugins": [
    {
      "name": "admin",
      "enabled": true,
      "config": {}
    },
    {
      "name": "irc",
      "enabled": true,
      "config": {
        "autoJoin": true
      }
    },
    {
      "name": "config",
      "enabled": false,
      "config": {}
    }
  ],
  "limits": {
    "flood_rate": 2.0,
    "flood_burst": 10,
    "max_messages_per_minute": 60
  },
  "database": {
    "url": "sqlite:///var/lib/limnoria/limnoria.db"
  },
  "language": "en_US",
  "debug": {
    "enabled": false
  }
}
