{
  "services": [
    {
      "name": "replica",
      "type": "cmd",
      "command": "cyrus replicator",
      "args": [
        "-C",
        "/etc/imapd.conf"
      ]
    },
    {
      "name": "replicator-manager",
      "type": "cmd",
      "command": "cyrus replicator-manager",
      "args": []
    }
  ],
  "tls_enabled": true,
  "tls_ca_file": "/etc/ssl/certs/ca-bundle.crt",
  "tls_cert_file": "/etc/pki/cyrus/tls/replica.crt",
  "tls_key_file": "/etc/pki/cyrus/tls/replica.key",
  "debug_enabled": false
}
