{
  "rtr_listen_addr": "0.0.0.0",
  "rtr_listen_port": 3323,
  "enable_rtr": true,
  "max_clients": 100,
  "poll_interval": 1800,
  "max_retries": 5,
  "request_timeout": 45,
  "local_cache_dir": "/var/lib/fort-validator/cache",
  "ca_cert_bundle": "/etc/ssl/certs/ca-certificates.crt",
  "repositories": [
    {
      "uri": "https://rpki.ripe.net/ta/",
      "enabled": true
    },
    {
      "uri": "https://rpki.afrinic.net/rpki/repository/",
      "enabled": true
    },
    {
      "uri": "https://rpki.apnic.net/",
      "headers": {
        "X-API-Key": "secret-token-123"
      },
      "enabled": true
    },
    {
      "uri": "https://rpkica.example.org/repository/",
      "enabled": false
    }
  ],
  "log_level": "info",
  "log_format": "text",
  "log_file": "/var/log/fort-validator/validator.log"
}
