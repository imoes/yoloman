{
  "server_root": "/etc/httpd",
  "listen_port": "80",
  "user": "apache",
  "group": "apache",
  "server_admin": "root@localhost",
  "document_root": "/var/www/html",
  "document_root_parent": "/var/www",
  "directory_index": "index.html",
  "log_level": "warn",
  "cgi_bin_dir": "/var/www/cgi-bin/",
  "default_charset": "UTF-8",
  "enable_sendfile": "on"
}
