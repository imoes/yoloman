{
  "default_lang": "auto",
  "host": "localhost",
  "port": 5432,
  "sslmode": "allow",
  "defaultdb": "template1",
  "pg_dump_path": "/usr/bin/pg_dump",
  "pg_dumpall_path": "/usr/bin/pg_dumpall",
  "autocomplete": "default on",
  "extra_session_security": true,
  "extra_login_security": true,
  "owned_only": false,
  "show_comments": true,
  "show_advanced": false,
  "show_system": false,
  "min_password_length": 1,
  "left_width": 200,
  "theme": "default",
  "show_oids": false,
  "max_rows": 30,
  "max_chars": 50,
  "use_xhtml_strict": false,
  "help_base": "http://www.postgresql.org/docs/%s/interactive/",
  "ajax_refresh": 3,
  "plugins": []
}
