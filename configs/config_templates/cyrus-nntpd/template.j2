# PAM configuration file for Cyrus NNTP service
#
# If you want to use Cyrus in a setup where users don't have
# accounts on the local machine, you'll need to make sure
# you use something like pam_permit for account checking.
#
# Remember that SASL (and therefore Cyrus) accesses PAM
# modules through saslauthd, and that SASL can only deal with
# plaintext passwords if PAM is used.
#

# PAM include file for authentication.
# Specifies the PAM module stack to use for verifying user credentials.
# Default: common-auth
# @include {{ common_auth_include | default('common-auth') }}

# PAM include file for account management.
# Specifies the PAM module stack to use for checking account validity/access.
# Default: common-account
# @include {{ common_account_include | default('common-account') }}