{
  "bind_address": "0.0.0.0",
  "port": 79,
  "max_connections": 50,
  "timeout": 45,
  "verbose": false,
  "log_file": "/var/log/efingerd.log",
  "response_prefix": "[Company Internal] ",
  "enable_user_enumeration": false,
  "backend_module": "unix",
  "backend_passwd_file": "/etc/passwd",
  "backend_group_file": "/etc/group",
  "backend_shell_file": "/etc/shells",
  "ldap_uri": "",
  "ldap_base_dn": "",
  "ldap_bind_dn": "",
  "ldap_bind_password": "",
  "ldap_user_filter": "",
  "custom_handlers": [
    {
      "name": "status",
      "command": "/usr/local/bin/finger-status.sh",
      "enabled": true
    },
    {
      "name": "projects",
      "command": "/usr/local/bin/finger-projects.sh",
      "enabled": false
    }
  ],
  "rate_limits": [
    {
      "name": "office_subnet",
      "ip": "192.168.10.0/24",
      "max_per_minute": 60
    }
  ],
  "tls_enabled": false,
  "tls_cert_file": "/etc/efingerd/tls.crt",
  "tls_key_file": "/etc/efingerd/tls.key"
}
