# efingerd backend script template
# This script is executed by efingerd to generate dynamic responses based on the
# requesting user and host. It mimics the behavior of the legacy /etc/efingerd/log
# shell script.

# Source the backend logging configuration/script if it exists and is defined.
# This allows for custom logging or pre-processing logic before the main response logic.
{% if backend_script is defined and backend_script %}
. {{ backend_script | default('/etc/efingerd/log') }}  # do some logging
{% endif %}

echo

# Check if the requesting user matches the "Vanya" special user.
# If so, send a specific response and exit without showing user listings.
{% if special_user_vanya is defined %}
if [ "$1" = "{{ special_user_vanya | default('vanya') }}" ]; then      # special action if vanya wants to finger us
  echo "{{ vanya_response | default('What do you want?????') }}" # from any computer
  echo "{{ vanya_exit_msg | default('Go away') }}"
  exit 0                       # and finish without telling him who is logged
fi
{% endif %}

# Check if the requesting user matches the "Jzatko" special user.
# Sends a longer greeting but continues to the user listing.
{% if special_user_jzatko is defined %}
if [ "$1" = "{{ special_user_jzatko | default('jzatko') }}" ]; then  # not so special action if jzatko wants to finger us
  echo "{{ jzatko_greeting | default('Hellooooooooooooooo') }}"
  echo
fi
{% endif %}

# Check if the requesting user matches "Matos".
# Executes a custom command for a short listing and then exits.
{% if special_user_matos is defined %}
if [ "$1" = "{{ special_user_matos | default('matos') }}" ]; then  # this user likes short listings
  {{ matos_command | default('who -q') }}
  exit 0
fi
{% endif %}

# Check if the requesting host matches the blocked computer.
# Denies access entirely with a custom message.
{% if blocked_computer is defined %}
if [ "$2" = "{{ blocked_computer | default('pascal.fmph.uniba.sk') }}" ]; then # ban the whole computer pascal
  echo "{{ block_computer_response | default('Sorry, we do not want you to know who is here.') }}"
  exit 0
fi
{% endif %}

# Check for a very specific combination of user and host.
# Triggers a special output block (often used for humor or specific alerts).
{% if special_occasion_user is defined and special_occasion_host is defined %}
if [ "$1@$2" = "{{ special_occasion_user | default('linus') }}@{{ special_occasion_host | default('transmeta.com') }}" ]; then  
# a very special occasion
# you should put here site specific action
# this here is just an example:
cat <<EOM
{{ special_occasion_output | default('Unable to handle kernel paging request at virtual address c8848ffc\ncurrent->tss.cr3 = 00ff1000, %cr3 = 00ff1000\n*pde = 0009e067\n*pte = 00000000\nOops: 0000\nCPU:    0\nEIP:    0010:[<0018596b>]\nEFLAGS: 00010297\neax: 08848ffc   ebx: ffffffff   ecx: 08848ffc   edx: fffffffe\nesi: ffffffff   edi: 07230073   ebp: 00000000   esp: 07150ed4\nds: 0018   es: 0018   fs: 002b   gs: 002b   ss: 0018\nProcess cat (pid: 526, process nr: 35, stackpage=07150000)\nStack: 00389ad8 00000062 00000007 07230000 00000000 00000061 00000004 ffffffff\n       0000001b 00000001 00185b14 07230062 0018641e 07150f28 0010ca43 07230062\n       00186410 00000007 00000001 00000020 08848ffc 00000000 07150f90 00001000\nCall Trace: [<00185b14>] [<0010ca43>] [<08848ffc>] [<0015c9b6>] [<0015cc26>] [<001236e0>] [<0010a8a9>]\nCode: 80 38 00 74 07 40 4a 83 fa ff 75 f4 29 c8 89 c6 f7 c5 10 00') }}
EOM
exit 0
fi
{% endif %}

# Default greeting logic:
# If the username is unknown (null), greet by hostname only.
# Otherwise, greet by "user@host".
if [ "$1" = "(null)" ]; then
  echo Hello "$2",      # we do not know who it is - does not run ident
else 
  echo Hello "$1@$2",  # else greet him
fi

echo users currently logged in are:
echo

# Display the primary user list command output.
# This is the main informational part of the finger response.
{{ user_list_command | default('who -uHw') }}        # and display the user listing in readable form
                 # or:
# {{ alternative_user_list_1 | default('finger') }}         # classical alternative
                 # or:
# {{ alternative_user_list_2 | default('ps aux') }}         # this reveals too much - do not use this command, unless 
                 # you trust people who finger you
echo
