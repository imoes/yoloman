{
  "label": "Bootable floppy",
  "alignment": 512,
  "align_patterns": [
    {
      "pattern": "/..",
      "alignment": 2048
    },
    {
      "pattern": "*.boot",
      "alignment": 4096
    }
  ],
  "exclude_patterns": [
    "CVS",
    "*~"
  ],
  "source_dir": "root",
  "output_file": "/dev/fd0",
  "verbose": true
}
