{
  "directory": "/home/user/GOG Games",
  "threads": 6,
  "timeout": 30,
  "retries": 5,
  "limit_rate": 10240,
  "platform": "l,w+m",
  "language": "de,en+fr",
  "include": "basegame_installers,dlc",
  "subdir_installers": "%platform%/%gamename%",
  "subdir_extras": "extras",
  "subdir_patches": "patches",
  "subdir_language_packs": "languages",
  "subdir_dlc": "dlc/%dlcname%",
  "subdir_game": "%gamename%",
  "cache_valid": 1440,
  "xml_directory": "/var/cache/lgogdownloader/xml",
  "cloud_whitelist": [
    "saves/AutoSave-0",
    "saves/AutoSave-1/screenshot.png"
  ],
  "cloud_blacklist": [
    "saves/Temp"
  ],
  "cloud_force": true,
  "blacklist_path": "/home/user/.config/lgogdownloader/blacklist.txt",
  "ignorelist_path": "/home/user/.config/lgogdownloader/ignorelist.txt",
  "no_remote_xml": false,
  "insecure": false,
  "cacert": "/etc/ssl/certs/ca-certificates.crt",
  "report_path": "/home/user/lgogdownloader-report.log",
  "verbosity": 1,
  "no_subdirectories": false,
  "no_duplicate_handling": false,
  "include_hidden_products": false,
  "check_free_space": true,
  "size_only": false,
  "no_fast_status_check": false,
  "trust_api_for_extras": false,
  "no_platform_detection": false,
  "galaxy_mode": false,
  "galaxy_game_regex": "",
  "galaxy_platform": "w",
  "galaxy_language": "en",
  "galaxy_arch": "x64",
  "galaxy_subdir": "%install_dir%"
}
