  "include": {
    "type": "string",
    "default": "all",
    "description": "Select what to download/list/repair. Examples: basegame_installers, dlc, all, bi+be.",
    "enum": [
      "bi",
      "basegame_installers",
      "be",
      "basegame_extras",
      "bp",
      "basegame_patches",
      "bl",
      "basegame_languagepacks",
      "basegame_langpacks",
      "di",
      "dlc_installers",
      "de",
      "dlc_extras",
      "dp",
