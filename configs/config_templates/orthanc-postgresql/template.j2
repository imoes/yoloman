{
    /**
     * Configuration to use PostgreSQL instead of the default SQLite
     * back-end of Orthanc. You will to install the
     * "orthanc-postgresql" package to take advantage of this feature.
     * Have a look at "/usr/share/doc/orthanc-postgresql/README.Debian"
     * for a tutorial.
     **/
    "PostgreSQL" : {
        {# Enable the use of PostgreSQL to store the Orthanc index #}
        "EnableIndex" : {{ enable_index | default('false') }},

        {# Enable the use of PostgreSQL to store the DICOM files #}
        "EnableStorage" : {{ enable_storage | default('false') }},

        {# Option 1: Specify explicit authentication parameters #}
        {# PostgreSQL server hostname or IP address #}
        "Host" : "{{ postgresql_host | default('localhost') }}",

        {# PostgreSQL server port #}
        "Port" : {{ postgresql_port | default(5432) }},

        {# Name of the PostgreSQL database to use #}
        "Database" : "{{ postgresql_database | default('orthanc_db') }}",

        {# PostgreSQL username for authentication #}
        "Username" : "{{ postgresql_username | default('orthanc_user') }}",

        {# PostgreSQL password for authentication #}
        "Password" : "{{ postgresql_password | default('my_password') }}",

        {# Option 2: Authenticate using PostgreSQL connection URI
         * "ConnectionUri" : "postgresql://orthanc_user:my_password@localhost:5432/orthanc_db", #}

        {# Whether to enable the locking of the PostgreSQL database #}
        "Lock" : {{ enable_lock | default('true') }},

        {# Whether to connect to PostgreSQL using SSL (new in 3.0) #}
        "EnableSsl" : {{ enable_ssl | default('false') }},

        {# Number of retries when connecting to PostgreSQL or when concurrent transactions cannot be serialized (new in 3.0) #}
        "MaximumConnectionRetries" : {{ maximum_connection_retries | default(10) }},

        {# Number of seconds between two attempts when opening a connection to PostgreSQL (new in 3.0) #}
        "ConnectionRetryInterval" : {{ connection_retry_interval | default(5) }},

        {# Number of connections to PostgreSQL in the connection pool of the index back-end (new in 4.0) #}
        "IndexConnectionsCount" : {{ index_connections_count | default(1) }}
    }
}
