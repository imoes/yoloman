#
# S3D (Sven's 3D Printer Daemon / dot_mcp wrapper) configuration script.
# This script invokes the s3d/dot_mcp binary.
#
# Configuration variable: s3d_binary
#   Path to the s3d/dot_mcp binary executable.
#   Default: /usr/bin/dot_mcp
#   Type: string

#!/bin/sh
# Execute the s3d binary, ensuring a default path if the variable is undefined.
{{ s3d_binary | default('/usr/bin/dot_mcp') }}