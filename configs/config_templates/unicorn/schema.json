{
  "timeout": {
    "type": "number",
    "default": 60,
    "description": "Default timeout until child process is killed during server upgrade"
  },
  "config_rb": {
    "type": "string",
    "default": "/path/to/your/web/application/unicorn.conf.rb",
    "description": "Path to Server's config.rb file"
  },
  "pid": {
    "type": "string",
    "default": "/run/unicorn.pid",
    "description": "Path to store the PID file"
  },
  "unicorn_opts": {
    "type": "string",
    "default": "-E production",
    "description": "Additional arguments passed to unicorn"
  }
}
