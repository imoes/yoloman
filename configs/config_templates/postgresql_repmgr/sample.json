{
 "auto_follow": true,
 "auto_registration": true,
 "data_directory": "/var/lib/postgresql/17/main",
 "events": [
  {
   "name": "post_promote",
   "script": "/usr/local/bin/notify-promotion.sh"
  }
 ],
 "failover": "automatic",
 "failover_targets": [
  {
   "host": "db3.example.com",
   "node_id": 3,
   "port": 5432
  },
  {
   "host": "db4.example.com",
   "node_id": 4,
   "port": 5432
  }
 ],
 "follow_command": "repmgr standby follow -f /etc/repmgr/17/repmgr.conf --log-level=INFO --upstream-node-id=%n",
 "log_facility": "LOG_LOCAL0",
 "log_file": "/var/log/postgresql/repmgr.log",
 "log_level": "NOTICE",
 "monitoring_interval_secs": 5,
 "node_id": 2,
 "node_name": "node2",
 "pg_basebackup_options": "-c fast -X stream -P",
 "postgresql_parameters": {
  "max_connections": "200",
  "shared_buffers": "256MB"
 },
 "primary_host": "db1.example.com",
 "primary_port": 5432,
 "promote_command": "repmgr standby promote -f /etc/repmgr/17/repmgr.conf --log-level=INFO",
 "replication_password": "r3pl1cat10n_p4ss",
 "replication_user": "replication",
 "repmgr_database": "repmgr",
 "repmgr_password": "s3cur3_r3pmgr_p4ss",
 "repmgr_user": "repmgr",
 "service_start_command": "pg_ctlcluster 17 main start",
 "service_status_command": "pg_ctlcluster 17 main status",
 "service_stop_command": "pg_ctlcluster 17 main stop -m fast",
 "upstream_node": 1
}
