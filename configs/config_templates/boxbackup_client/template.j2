# BoxBackup client configuration file (bbackupd.conf)
# Generated by Jinja2 from template

# Path to the directory where backup data will be stored locally
# (i.e., where changes will be scanned for backup)
BackupLocation {
  Path = {{ backup_location.path }}

  # Maximum size of a single file to back up (in bytes)
  # Files larger than this will be skipped with a warning
  # Set to 0 for unlimited
  MaxFilesize = {{ backup_location.max_filesize }}

  # Skip files matching these patterns (shell-style wildcards, case-sensitive)
{% for pattern in backup_location.skip_patterns %}  SkipPattern = {{ pattern }}
{% endfor %}

  # Skip files with these extended attributes (if supported)
  # Leave empty to skip none
{% if backup_location.skip_xattrs %}
{% for attr in backup_location.skip_xattrs %}  SkipXAttr = {{ attr }}
{% endfor %}
{% else %}  SkipXAttr =
{% endif %}
}

# Interval (in seconds) between directory scans for changes
ScanInterval = {{ scan_interval }}

# Enable or disable automatic upload of changed files
AutoUpload = {{ auto_upload }}

# Maximum number of bytes to upload per scan (0 = unlimited)
MaxUploadRate = {{ max_upload_rate }}

# Path to the configuration file that contains server connection details
# Typically points to /etc/boxbackup/bbackupd-locations.conf or similar
# Here we assume the server address & auth info is embedded or external;
# if external, this section may be commented out or omitted
# (but BoxBackup requires *some* server config; we include minimal defaults)
Server {
  # Hostname or IP of the BoxBackup store server
  Address = {{ server.address }}

  # Port used for backup protocol (default 10025)
  Port = {{ server.port }}

  # Path to the certificate used to verify the server (PEM format)
  # Required if server uses SSL/TLS (recommended)
  CertificateFile = {{ server.certificate_file }}

  # Path to the private key (optional if embedded in cert file)
  # CertificateKeyFile = /etc/boxbackup/bbackupd.key

  # Path to file containing RSA encryption public key of the store
  # Used to encrypt upload data; required for encryption
  StorePublicKeyFile = {{ server.store_public_key_file }}

  # Path to file containing RSA private key of this client (for decryption)
  # ClientPrivateKeyFile = /etc/boxbackup/bbackupd.priv
}

# Account identifier used by the server to locate the correct backup store
# Typically an account number assigned by the server admin
AccountNumber = {{ account_number }}

# Path to PID file for the daemon
PIDFile = {{ pid_file }}

# Path to log file; use '-' for stdout
LogFile = {{ log_file }}

# Verbosity of logging: 0=errors only, 1=normal, 2=verbose, 3=debug
# Note: debug level may expose sensitive paths
LogVerbosity = {{ log_verbosity }}

# Enable or disable file encryption (requires public/private key pair)
# If true, all uploads are encrypted before sending
Encrypted = {{ encrypted }}

# Maximum age (in days) of a backup before it is considered stale
# Set to 0 to disable age-based alerts
WarningAge = {{ warning_age }}

# Command to run after successful backup completion (e.g., to notify)
# Leave empty to disable post-backup hook
{% if post_backup_command %}AfterBackupCommand = {{ post_backup_command }}
{% else %}AfterBackupCommand =
{% endif %}
