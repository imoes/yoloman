{
  "backup_location": {
    "path": "/home",
    "max_filesize": 1073741824,
    "skip_patterns": [
      "*.tmp",
      "*.log",
      "*cache*",
      "*/.npm/*",
      "*/node_modules/*"
    ],
    "skip_xattrs": []
  },
  "scan_interval": 300,
  "auto_upload": true,
  "max_upload_rate": 0,
  "server": {
    "address": "backup.example.com",
    "port": 10025,
    "certificate_file": "/etc/boxbackup/server.crt",
    "store_public_key_file": "/etc/boxbackup/storepubkey.pem"
  },
  "account_number": "12345678",
  "pid_file": "/var/run/bbackupd.pid",
  "log_file": "/var/log/boxbackup/bbackupd.log",
  "log_verbosity": 1,
  "encrypted": true,
  "warning_age": 7,
  "post_backup_command": "/usr/local/bin/notify-backup-complete.sh"
}
