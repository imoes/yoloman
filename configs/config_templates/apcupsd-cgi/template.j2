; apcupsd-cgi: CGI script configuration for APCUPSd
; This file controls the visual appearance (CSS-like styles) of the APCUPSd web interface.
; Each directive is mapped to a variable with a schema default for safety and reusability.

body {
	; Text color for the body element.
	color: {{ body_color | default('black') }};
	; Background color for the body element.
	background: {{ body_background | default('white') }};
}

div.Center {
	text-align: center;
}

img {
	; Border style for images.
	border-style: {{ img_border_style | default('none') }};
}

pre {
	; Text alignment for preformatted text.
	text-align: {{ pre_text_align | default('left') }};
}

strong {
	; Color for strong/emphasized text.
	color: {{ strong_color | default('red') }};
}

table.Outer {
	; Text color for the outer table.
	color: {{ table_outer_color | default('black') }};
	; Background color for the outer table.
	background: {{ table_outer_background | default('#60a0a0') }};
	; Visibility of empty cells in the outer table.
	empty-cells: {{ table_outer_empty_cells | default('show') }};
	; Border color for the outer table.
	border: solid {{ table_outer_border_color | default('#60a0a0') }}
}

th.Outer {
	; Text color for outer table headers.
	color: {{ th_outer_color | default('black') }};
	; Background color for outer table headers.
	background: {{ th_outer_background | default('#60b0b0') }}
}

.Title {
	; Font size for the Title class.
	font-size: {{ title_font_size | default('18pt') }};
}

.SubTitle {
	; Font size for the SubTitle class.
	font-size: {{ subtitle_font_size | default('12pt') }};
}

.Empty {
	; Text color for empty status indicators.
	color: {{ empty_color | default('black') }};
	; Background color for empty status indicators.
	background: {{ empty_background | default('aqua') }};
}

.Fault {
	; Text color for fault status indicators.
	color: {{ fault_color | default('black') }};
	; Background color for fault status indicators.
	background: {{ fault_background | default('red') }};
}

.Label {
	; Text color for label indicators.
	color: {{ label_color | default('black') }};
	; Background color for label indicators.
	background: {{ label_background | default('aqua') }};
}

.Normal {
	; Text color for normal status indicators.
	color: {{ normal_color | default('black') }};
	; Background color for normal status indicators.
	background: {{ normal_background | default('lime') }};
}

.Warning {
	; Text color for warning status indicators.
	color: {{ warning_color | default('black') }};
	; Background color for warning status indicators.
	background: {{ warning_background | default('yellow') }};
}