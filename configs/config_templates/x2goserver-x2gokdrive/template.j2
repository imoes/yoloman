# ============================================================================
# X2Go KDrive Configuration Template
# ============================================================================
# This template configures default options for the X2Go KDrive session agent.
# It is designed to be self-documenting: every variable is annotated with
# its source description and a safe default.
#
# IMPORTANT:
# - The variable X2GO_X2GOKDRIVE_DEFAULT_OPTIONS accumulates flags.
#   Each uncommented line appends to this variable.
# - The variable X2GO_NXOPTIONS provides additional comma-separated options for nxagent.
# ============================================================================

# ---------------------------------------------------------------------------
# Default Options String
# ---------------------------------------------------------------------------
# Schema Description: Default options string passed to x2gokdrive.
# Schema Default: ""
#
# This variable sets the baseline options for x2gokdrive. It is initialized
# to an empty string by default. Users or playbooks should set this variable
# in their inventory or group_vars to override this empty default.
X2GO_X2GOKDRIVE_DEFAULT_OPTIONS="{{ X2GO_X2GOKDRIVE_DEFAULT_OPTIONS | default('') }}"

# ---------------------------------------------------------------------------
# Disable GLX Extension (Optional)
# ---------------------------------------------------------------------------
# Schema Description: (Inherited from X2GO_X2GOKDRIVE_DEFAULT_OPTIONS)
#
# Uncomment the line below to disable the GLX extension. This can be useful
# if the old Mesa GLX implementation causes issues, such as breaking the
# GNOME 3 control center.
# Note: This is currently commented out as compatibility with X2Go KDrive
# requires verification.
#
# X2GO_X2GOKDRIVE_DEFAULT_OPTIONS+="{{ X2GO_X2GOKDRIVE_DEFAULT_OPTIONS | default('') }}" -extension GLX"

# ---------------------------------------------------------------------------
# Network Listener Configuration
# ---------------------------------------------------------------------------
# Schema Description: (Inherited from X2GO_X2GOKDRIVE_DEFAULT_OPTIONS)
#
# Launch X2Go's X-server (x2goagent) with option "-nolisten tcp".
# This is the RECOMMENDED default setting. X2Go developers advise against
# changing this. Disabling TCP listening improves security by ensuring
# connections are only made over the encrypted SSH tunnel.
#
# DO NOT COMMENT OUT THIS LINE UNLESS YOU UNDERSTAND THE SECURITY IMPLICATIONS.
X2GO_X2GOKDRIVE_DEFAULT_OPTIONS+="{{ X2GO_X2GOKDRIVE_DEFAULT_OPTIONS | default('') }}" -nolisten tcp"

# ---------------------------------------------------------------------------
# Clipboard Behaviour (Optional)
# ---------------------------------------------------------------------------
# Schema Description: (Inherited from X2GO_X2GOKDRIVE_DEFAULT_OPTIONS)
#
# Enforce global clipboard behaviour in X2Go sessions.
# Possible values:
#   - both:   Bidirectional clipboard sharing (default if commented out)
#   - server: Server-to-client only
#   - client: Client-to-server only
#   - none:   Disable clipboard sharing
#
# If this line is commented out, connecting clients can choose their own
# clipboard behaviour. Uncomment to enforce a strict policy.
#
# X2GO_X2GOKDRIVE_DEFAULT_OPTIONS+="{{ X2GO_X2GOKDRIVE_DEFAULT_OPTIONS | default('') }}" -clipboard both"

# ---------------------------------------------------------------------------
# Disable BIG-REQUESTS Extension (Optional)
# ---------------------------------------------------------------------------
# Schema Description: (Inherited from X2GO_X2GOKDRIVE_DEFAULT_OPTIONS)
#
# BIG-REQUESTS can cause crashes with older versions of nx-libs that do
# not implement this extension correctly. Newer versions handle it better,
# but if you experience weird crashes, uncomment this line to disable the
# extension.
#
# X2GO_X2GOKDRIVE_DEFAULT_OPTIONS+="{{ X2GO_X2GOKDRIVE_DEFAULT_OPTIONS | default('') }}" -extension BIG-REQUESTS"

# ---------------------------------------------------------------------------
# Extra nxagent Options
# ---------------------------------------------------------------------------
# Schema Description: Extra nxagent nx/nx options, separated by commas.
# Schema Default: ""
#
# Pass additional comma-separated options to the nxagent process.
# Example: "sleep=0,compositing=1"
X2GO_NXOPTIONS="{{ X2GO_NXOPTIONS | default('') }}"
