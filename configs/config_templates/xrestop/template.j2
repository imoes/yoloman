# xrestop configuration template
# Self-documenting configuration for xrestop, an X11 client resource monitoring tool.
# This template generates a script that monitors X11 display activity and outputs resource usage statistics.

# The X11 display address to monitor.
# Default is the primary local display (:0).
DISPLAY="{{ display | default(':0') }}"

# Time in seconds between taking samples.
# Controls the frequency of data collection.
# Default is 2 seconds.
DELAY="{{ delay_time | default(2) }}"

# Number of times to gather and display results.
# A value of 0 means continuous monitoring until interrupted.
# Default is 0 (continuous).
MAX_SAMPLES="{{ max_samples | default(0) }}"

# Run command in batch mode for stdout streaming.
# The variables are quoted to ensure proper shell handling.
xrestop --display "$DISPLAY" --batch --delay-time "$DELAY" --max-samples "$MAX_SAMPLES"