# ==============================================================================
# todotxt-cli Configuration Template
# ==============================================================================
# This file configures the behavior and appearance of the todotxt CLI tool.
# It exports environment variables that the tool reads at runtime.
# ==============================================================================

# --- FILE LOCATIONS ---

# TODO_DIR_DEFAULT: The commented-out default example path for TODO_DIR.
# This variable is used as a fallback or reference if TODO_DIR is not explicitly set elsewhere.
# export TODO_DIR="{{ (TODO_DIR_DEFAULT | default('/Users/gina/Documents/todo')) }}"

# TODO_DIR: The absolute or home-relative path to the todo.txt directory.
# This is the root directory where all todo.txt files are stored.
# We quote the value to handle spaces in paths safely.
export TODO_DIR="{{ (TODO_DIR | default('~/.todo-txt')) }}"

# --- FILE NAMES ---

# TODO_FILENAME: The filename for the active tasks.
# Combined with TODO_DIR to form the full path to the main task list.
export TODO_FILE="$TODO_DIR/{{ (TODO_FILENAME | default('todo.txt')) }}"

# DONE_FILENAME: The filename for completed tasks.
# Combined with TODO_DIR to form the full path to the completed tasks list.
export DONE_FILE="$TODO_DIR/{{ (DONE_FILENAME | default('done.txt')) }}"

# REPORT_FILENAME: The filename for reports.
# Combined with TODO_DIR to form the full path to the reports file.
export REPORT_FILE="$TODO_DIR/{{ (REPORT_FILENAME | default('report.txt')) }}"

# --- ACTIONS DIRECTORY ---

# TODO_ACTIONS_DIR: The directory location for custom action scripts.
# These are shell scripts executed by todo.txt actions.
# Quote to handle spaces in paths.
export TODO_ACTIONS_DIR="{{ (TODO_ACTIONS_DIR | default('$HOME/.todo.actions.d')) }}"

# --- COLOR CONFIGURATION ---

# ==============================================================================
# Text coloring and formatting is done by inserting ANSI escape codes.
# If you have re-mapped your color codes, or use the todo.txt
# output in another output system (like Conky), you may need to
# override by uncommenting and editing these defaults.
# If you change any of these here, you also need to uncomment
# the defaults in the COLORS section below. Otherwise, todo.txt
# will still use the defaults!
# ==============================================================================

# PRI_A: ANSI color variable or code for A priority.
# A priorities are typically critical/high-importance tasks.
export PRI_A="{{ (PRI_A | default('$YELLOW')) }}"

# PRI_B: ANSI color variable or code for B priority.
# B priorities are typically important but not critical.
export PRI_B="{{ (PRI_B | default('$GREEN')) }}"

# PRI_C: ANSI color variable or code for C priority.
# C priorities are standard tasks.
export PRI_C="{{ (PRI_C | default('$LIGHT_BLUE')) }}"

# PRI_D: ANSI color variable or code for D priority.
# D priorities are usually low priority or "someday" tasks.
export PRI_D="{{ (PRI_D | default('...')) }}"

# PRI_X: ANSI color variable or code for default/uncategorized priority.
# Used for tasks without an explicit priority tag.
export PRI_X="{{ (PRI_X | default('$WHITE')) }}"

# COLOR_DONE: ANSI color variable or code for done tasks not yet archived.
# Visual distinction for completed items before they are moved to done.txt.
export COLOR_DONE="{{ (COLOR_DONE | default('$LIGHT_GREY')) }}"

# COLOR_PROJECT: ANSI color variable or code for project identifiers.
# Highlights tasks belonging to a specific project context.
export COLOR_PROJECT="{{ (COLOR_PROJECT | default('$RED')) }}"

# COLOR_CONTEXT: ANSI color variable or code for context identifiers.
# Highlights tasks associated with a specific context (e.g., @home, @work).
export COLOR_CONTEXT="{{ (COLOR_CONTEXT | default('$RED')) }}"

# --- BEHAVIOR ---

# ==============================================================================
# customize list output
# ==============================================================================

# TODOTXT_SORT_COMMAND will filter after line numbers are
# inserted, but before colorization, and before hiding of
# priority, context, and project.
# This allows custom sorting logic via standard Unix tools.
export TODOTXT_SORT_COMMAND="{{ (TODOTXT_SORT_COMMAND | default("'env LC_COLLATE=C sort -f -k2'")) }}"

# TODOTXT_FINAL_FILTER will filter list output after colorization,
# priority hiding, context hiding, and project hiding. That is,
# just before the list output is displayed.
# Useful for post-processing the visual output stream.
export TODOTXT_FINAL_FILTER="{{ (TODOTXT_FINAL_FILTER | default("'cat'")) }}"
