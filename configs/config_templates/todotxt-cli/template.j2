# ==============================================================================
# todotxt-cli Configuration Template
# ==============================================================================
# This template generates a shell script environment for the todotxt CLI tool.
# It exports variables that control file locations, color coding, and sorting behavior.
#
# To use this template in Ansible, ensure all variables are defined in your
# inventory or group_vars. Defaults are provided inline for each variable.
# ==============================================================================

# --- File Locations ---

# The commented-out default example path for TODO_DIR.
# This is provided for reference but is not active.
# export TODO_DIR="{{ TODO_DIR_DEFAULT | default('/Users/gina/Documents/todo') }}"

# The absolute or home-relative path to the todo.txt directory.
# This is the primary directory where task files are stored.
export TODO_DIR="{{ TODO_DIR | default('~/.todo-txt') }}"

# --- Task File Definitions ---

# Your todo/done/report.txt locations
# The filename for the active tasks.
export TODO_FILE="$TODO_DIR/{{ TODO_FILENAME | default('todo.txt') }}"

# The filename for completed tasks.
export DONE_FILE="$TODO_DIR/{{ DONE_FILENAME | default('done.txt') }}"

# The filename for reports.
export REPORT_FILE="$TODO_DIR/{{ REPORT_FILENAME | default('report.txt') }}"

# --- Custom Actions ---

# You can customize your actions directory location
# The directory location for custom action scripts.
# export TODO_ACTIONS_DIR="{{ TODO_ACTIONS_DIR | default('$HOME/.todo.actions.d') }}"

# --- Color Map (Reference) ---
# Text coloring and formatting is done by inserting ANSI escape codes.
# If you have re-mapped your color codes, or use the todo.txt
# output in another output system (like Conky), you may need to
# over-ride by uncommenting and editing these defaults.
# If you change any of these here, you also need to uncomment
# the defaults in the COLORS section below. Otherwise, todo.txt
# will still use the defaults!
#
# export BLACK='\033[0;30m'
# export RED='\033[0;31m'
# export GREEN='\033[0;32m'
# export BROWN='\033[0;33m'
# export BLUE='\033[0;34m'
# export PURPLE='\033[0;35m'
# export CYAN='\033[0;36m'
# export LIGHT_GREY='\033[0;37m'
# export DARK_GREY='\033[1;30m'
# export LIGHT_RED='\033[1;31m'
# export LIGHT_GREEN='\033[1;32m'
# export YELLOW='\033[1;33m'
# export LIGHT_BLUE='\033[1;34m'
# export LIGHT_PURPLE='\033[1;35m'
# export LIGHT_CYAN='\033[1;36m'
# export WHITE='\033[1;37m'
# export DEFAULT='\033[0m'

# --- Priority and Object Colors ---

## Uncomment and edit to override these defaults.
## Reference the constants from the color map above,
## or use $NONE to disable highlighting.

# Priorities can be any upper-case letter.
# A,B,C are highlighted; you can add coloring for more.

# ANSI color variable or code for A priority.
# export PRI_A={{ PRI_A | default('$YELLOW') }}

# ANSI color variable or code for B priority.
# export PRI_B={{ PRI_B | default('$GREEN') }}

# ANSI color variable or code for C priority.
# export PRI_C={{ PRI_C | default('$LIGHT_BLUE') }}

# ANSI color variable or code for D priority.
# export PRI_D={{ PRI_D | default('...') }}

# ANSI color variable or code for default/uncategorized priority.
# export PRI_X={{ PRI_X | default('$WHITE') }}

# There is highlighting for tasks that have been done,
# but haven't been archived yet.
# ANSI color variable or code for done tasks not yet archived.
# export COLOR_DONE={{ COLOR_DONE | default('$LIGHT_GREY') }}

# There is highlighting for projects and contexts.
# ANSI color variable or code for project identifiers.
# export COLOR_PROJECT={{ COLOR_PROJECT | default('$RED') }}

# ANSI color variable or code for context identifiers.
# export COLOR_CONTEXT={{ COLOR_CONTEXT | default('$RED') }}

# --- Behavior / Sorting ---

## customize list output

# TODOTXT_SORT_COMMAND will filter after line numbers are
# inserted, but before colorization, and before hiding of
# priority, context, and project.
# The shell command used to sort the task list.
# export TODOTXT_SORT_COMMAND={{ TODOTXT_SORT_COMMAND | default("'env LC_COLLATE=C sort -f -k2'" ) }}

# TODOTXT_FINAL_FILTER will filter list output after colorization,
# priority hiding, context hiding, and project hiding. That is,
# just before the list output is displayed.
# The final shell filter applied to the list output before display.
# export TODOTXT_FINAL_FILTER={{ TODOTXT_FINAL_FILTER | default("'cat'" ) }}