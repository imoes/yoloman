# fangfrisch configuration file
# See fangfrisch(1) man page for details
#
# This file is generated by Ansible. Do not edit manually.
# All variables use explicit defaults to ensure idempotent rendering.

[general]
# Directory where signature files are stored
data_dir = {{ data_dir | default('/var/lib/fangfrisch') }}

# Log level: debug, info, warning, error, critical
loglevel = {{ loglevel | default('info') }}

# Path to the ClamAV database directory (optional override)
# clamav_db_dir = /var/lib/clamav

[refresh]
# How often to check for updates (in hours)
refresh_interval = {{ refresh_interval | default(6) }}

# Maximum number of retries before giving up
max_retries = {{ max_retries | default(3) }}

# Delay between retries (in seconds)
retry_delay = {{ retry_delay | default(60) }}

# Time to wait for network operations (in seconds)
connection_timeout = {{ connection_timeout | default(30) }}

# Force refresh even if signatures appear unchanged
force_refresh = {{ force_refresh | default(false) | lower }}

# List of providers to use (regex filters applied if non-empty); if empty, all providers are used
# Note: The upstream config format expects a comma-separated string of regexes.
{% if providers is defined and providers | length > 0 %}
providers = {{ providers | join(', ') }}
{% endif %}

# Provider-specific settings are handled dynamically in the [general] or specific sections if needed.
# For now, we document the structure expected by fangfrisch for provider overrides.
{% if providers is defined and providers | length > 0 %}
# Provider-specific settings
{% for provider in providers %}
# [provider:{{ provider }}]
# url = https://example.com/signatures/{{ provider }}.crd
# key = {{ provider }}_public_key
{% endfor %}
{% endif %}

[verify]
# Whether to verify signatures (requires public keys)
verify_signatures = {{ verify_signatures | default(true) | lower }}

# Directory containing public keys
key_dir = {{ key_dir | default('/etc/fangfrisch/keys') }}

# How often to verify signatures (in hours)
verify_interval = {{ verify_interval | default(24) }}

# Whether to run verification automatically after refresh
auto_verify = {{ auto_verify | default(true) | lower }}