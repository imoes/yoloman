{
  "bind_address": "0.0.0.0",
  "bind_port": 3050,
  "max_connections": 10,
  "use_ssl": false,
  "ssl_cert": "/etc/iiod/ssl/server.crt",
  "ssl_key": "/etc/iiod/ssl/server.key",
  "devices": [],
  "transports": [
    {
      "name": "ip",
      "options": "family=ipv4"
    }
  ],
  "auth_mode": "none",
  "passwd_file": "/etc/iiod/passwd",
  "log_level": "info",
  "log_file": ""
}
