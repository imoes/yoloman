{
  "bind_address": "0.0.0.0",
  "bind_port": 3050,
  "max_connections": 5,
  "use_ssl": true,
  "ssl_cert": "/etc/iiod/ssl/server.crt",
  "ssl_key": "/etc/iiod/ssl/server.key",
  "devices": [
    {
      "name": "iio:device0",
      "description": "ADC sensor"
    },
    {
      "name": "iio:device1",
      "description": "Temperature sensor"
    }
  ],
  "transports": [
    {
      "name": "ip",
      "options": "family=ipv4"
    },
    {
      "name": "usb",
      "options": "bus=1"
    }
  ],
  "auth_mode": "passwd",
  "passwd_file": "/etc/iiod/passwd",
  "log_level": "warn",
  "log_file": "/var/log/iiod.log"
}
