# Configuration file for the input service (bluez)
# This file configures the Bluetooth protocol stack's behavior regarding input devices (HID) and general connectivity.

# This section contains options which are not specific to any
# particular interface
[General]

# IdleTimeout: Set idle timeout (in seconds) before the connection will be disconnected and the input device is removed.
# 0 means disabled (keep connection alive indefinitely).
# Source variable: IdleTimeout | default: 0
IdleTimeout={{ IdleTimeout | default(0) }}

# UserspaceHID: Enable HID protocol handling in userspace input profile.
# Possible values:
#  - 'persist': UHID persistent mode (keyboard only)
#  - 'true': UHID enabled
#  - 'false': Use kernel HIDP
# Source variable: UserspaceHID | default: 'true'
UserspaceHID={{ UserspaceHID | default('true') | string }}

# ClassicBondedOnly: Limit HID connections to bonded devices.
# For security, defaults to true.
# The value must be quoted in the config file if it is a string to ensure correct parsing by BlueZ.
# Source variable: ClassicBondedOnly | default: 'true'
ClassicBondedOnly={{ ClassicBondedOnly | default('true') | string }}

# LEAutoSecurity: Enable automatic LE security upgrades if required.
# Defaults to true for compatibility.
# The value must be quoted in the config file if it is a string to ensure correct parsing by BlueZ.
# Source variable: LEAutoSecurity | default: 'true'
LEAutoSecurity={{ LEAutoSecurity | default('true') | string }}