# Configuration for uapevent
# See uapevent(1) for details.

# Command-line option: -v
# If true, the '-v' flag is active, causing uapevent to print its version and exit.
VERSION_ENABLED = {{ enabled_version_display | default(false) | lower }}

# Command-line option: -h
# If true, the '-h' flag is active, causing uapevent to print a summary of options and exit.
HELP_ENABLED = {{ enabled_help_display | default(false) | lower }}