#!/usr/bin/env bash
# Wrapper script for s3dfm
# This script invokes the s3dfm binary with the configured S3D server URL.

# Path to the s3dfm executable.
# Default: /usr/bin/s3dfm
BINARY="{{ binary_path | default('/usr/bin/s3dfm') }}"

# The S3D server URL to connect to directly, bypassing environment auto-discovery.
# Default: http://localhost:3564
S3D_URL="{{ s3d_url | default('http://localhost:3564') }}"

exec "${BINARY}" --s3d-url "${S3D_URL}"