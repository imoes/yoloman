# RNG Daemon Configuration for rng-tools (Debian/Ubuntu)
#
# This file is sourced by the systemd unit file (rng-tools.service)
# or legacy init scripts. It configures the rngd daemon.
#
# Self-documenting: Each variable defaults are defined inline to
# ensure robustness if Ansible variables are undefined.

# -------------------------------------------------------
# HRNGDEVICE: Path to the hardware random number generator device.
#
# Defaults to '/dev/hwrng' (standard Linux HWRNG interface).
# Can be set to '/dev/null' to disable hardware RNG input (not recommended).
# Can be left empty for auto-detection by the daemon.
#
# Allowed values:
#   /dev/hwrng  - Hardware RNG device
#   /dev/null   - Disabled (software only fallback)
#   <empty>     - Auto-detect
# -------------------------------------------------------
HRNGDEVICE={{ hrngdevice | default('/dev/hwrng') }}

# -------------------------------------------------------
# HRNGSELECT: Specific RNG selector identifier.
#
# Used for certain virtualized environments or specific kernel RNG modules.
# Example: 'virtio_rng.0' for QEMU/KVM virtio RNG devices.
# Leave empty for standard device selection.
# -------------------------------------------------------
HRNGSELECT={{ hrngselect | default('') }}

# -------------------------------------------------------
# RNGDOPTIONS: Additional command-line options to pass to rngd.
#
# These options are appended to the rngd command line.
# DO NOT include --hrng or --rng-device here; use the HRNGDEVICE
# variable above for the device path.
# Common options might include --foreground, --pidfile, etc.,
# though these are usually handled by the systemd unit file.
# -------------------------------------------------------
RNGDOPTIONS={{ rngdoptions | default('') }}
