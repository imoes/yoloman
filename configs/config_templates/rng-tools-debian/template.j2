# Configuration for rng-tools-debian (rngd daemon)
#
# This template configures the hardware random number generator daemon.
# It is self-documenting: every variable maps directly to a schema field
# with its default value and description provided in the comments below.

# HRNGDEVICE: Path to the hardware random number generator device.
# Supported devices include /dev/hwrng, /dev/null (for viapadlock),
# or leave empty for auto-detection.
# Schema default: /dev/hwrng
HRNGDEVICE={{ (hrngdevice | default('/dev/hwrng')) | string }}

# RNGDOPTIONS: Additional command-line options to pass to the rngd daemon.
# Do NOT specify -r/--rng-device here; use the HRNGDEVICE field instead.
# Schema default: (empty string)
RNGDOPTIONS={{ (rngdoptions | default('')) | string }}

# HRNGSELECT: Specific RNG selector identifier for virtualized environments
# (e.g., virtio_rng.0). Leave empty if not needed.
# Schema default: (empty string)
HRNGSELECT={{ (hrngselect | default('')) | string }}