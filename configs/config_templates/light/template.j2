# /etc/light configuration file
# This file is used by the 'light' utility when run in SUID root mode.
# It defines the default target device and verbose logging level.

# The sysfs path to the backlight controller device.
# Typically something like /sys/class/backlight/intel_backlight or acpi_video0.
# See 'light -L' to list available devices on the system.
# Variable: device
DEVICE={{ (device | default('/sys/class/backlight/intel_backlight')) }}

# Log verbosity level (0-3).
# 0 = Read values (silent operation for changes)
# 1 = Errors
# 2 = Warnings
# 3 = Notices (most verbose)
# Variable: verbosity
VERBOSITY={{ (verbosity | default(0)) }}

# Minimum brightness value to prevent complete blackness.
# Setting a floor ensures the screen is never entirely off,
# which can be useful for remote management or debugging.
# Variable: min_brightness
MIN_BRIGHTNESS={{ (min_brightness | default(10)) }}