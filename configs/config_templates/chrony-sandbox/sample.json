{
  "servers": [
    {
      "host": "0.pool.ntp.org",
      "options": [
        "iburst",
        "prefer"
      ],
      "pool": true
    },
    {
      "host": "time.google.com",
      "options": [
        "iburst",
        "minpoll 4"
      ]
    }
  ],
  "clients": [
    {
      "subnet": "127.0.0.0/8",
      "name": "localhost"
    },
    {
      "subnet": "192.168.1.0/24",
      "name": "internal-network"
    }
  ],
  "logging": {
    "dir": "/var/log/chrony",
    "file": "",
    "levels": [
      "Changes",
      "Stats",
      "Sources"
    ]
  },
  "leapsecmode": "slew",
  "leapseconds": {
    "timezone": "UTC"
  },
  "initsteps": [
    "slew",
    "0.pool.ntp.org",
    "1.pool.ntp.org"
  ],
  "makestep": {
    "threshold": 1.0
  },
  "maxsamples": 10,
  "minsamples": 3,
  "maxdistance": 16.0,
  "enable_hwtimestamp": false,
  "ntpsec_compatible": false
}
