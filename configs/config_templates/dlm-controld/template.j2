# DLM_CONTROLD_OPTS -- set command line options for dlm_controld
# Description: Passes custom command line arguments to the Distributed Lock Manager control daemon.
# Common options include:
#   -D      : Run in foreground (useful for debugging or systemd Type=notify)
#   -p PORT : Listen on a specific port (default is usually dynamic or standard)
#   -v      : Verbose logging
# Reference: man dlm_controld for the full list of supported options.
DLM_CONTROLD_OPTS="{{ dlm_controld_opts | default('') | trim }}"