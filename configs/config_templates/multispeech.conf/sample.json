{
  "log_level": "info",
  "max_workers": 8,
  "timeout_ms": 15000,
  "max_buffer_size": 2097152,
  "backend": {
    "host": "192.168.1.50",
    "port": 8080
  },
  "speech": {
    "engine": "coqui",
    "default_language": "en",
    "voices": [
      {
        "name": "vits_en",
        "lang": "en",
        "gender": "neutral",
        "stability": 0.75,
        "similarity_boost": 0.9
      },
      {
        "name": "vits_es",
        "lang": "es",
        "gender": "female",
        "stability": 0.8,
        "similarity_boost": 0.85
      }
    ]
  },
  "audio": {
    "sample_rate": 24000,
    "output_format": "wav",
    "enable_denoising": true
  },
  "logging": {
    "file": "/var/log/multispeech/multispeech.log",
    "max_size_mb": 100,
    "max_backup_count": 3
  }
}
