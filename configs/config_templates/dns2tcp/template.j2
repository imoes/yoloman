# dns2tcp server configuration
# This file configures the dns2tcp daemon, a tunneling service that encapsulates TCP streams within DNS queries.

# IP address to listen on for incoming DNS2TCP connections.
# Default: 127.0.0.1 (localhost only, secure for local clients)
listen = {{ listen_address | default('127.0.0.1') }}

# Port number to listen on for incoming DNS2TCP connections.
# DNS2TCP uses standard DNS port by default to bypass firewall restrictions.
# Default: 53
port = {{ listen_port | default('53') }}

# User account under which the dns2tcp server process should run.
# Changing this value requires updating the USER variable in /etc/default/dns2tcpd as well.
# Default: nobody (unprivileged user for security isolation)
user = {{ run_as_user | default('nobody') }}

# Directory to chroot into for security isolation.
# Limits the process's view of the filesystem to this directory.
# Default: /tmp
chroot = {{ chroot_dir | default('/tmp') }}

# The domain name used for the DNS2TCP tunneling service.
# DNS queries will be sent to this domain to reach the tunnel endpoints.
# Default: your.domain.tld
domain = {{ domain | default('your.domain.tld') }}

# Comma-separated list of resources to proxy.
# Format: name:host:port
# Example: ssh:127.0.0.1:22 , smtp:127.0.0.1:25
# These resources will be exposed via DNS TXT records and queried through the tunnel.
# Default: ssh:127.0.0.1:22 , smtp:127.0.0.1:25
resources = {{ resources | default('ssh:127.0.0.1:22 , smtp:127.0.0.1:25') }}
