# Configuration for ipmctl log rotation.
# Manages where ipmctl logs are stored and how many rotated copies are retained.

/var/log/ipmctl/{{ log_directory | default('*') }}log {
    # Number of rotated log files to keep.
    # Default: 4
    rotate {{ log_rotation_count | default('4') }}
    
    # Do not error if the log file is missing.
    missingok
    
    # Do not rotate the log if it is empty.
    notifempty
    
    # Rotate logs once a month.
    monthly
}
