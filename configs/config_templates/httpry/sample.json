{
  "daemon": true,
  "interface": "ens192",
  "output_file": "/var/log/httpry/access.log",
  "pid_file": "/var/run/httpry/httpry.pid",
  "user": "httpry",
  "capture_filter": "tcp port 80",
  "output_format": "ip,method,url,host,status_code",
  "http_methods": [
    "GET",
    "POST"
  ],
  "quiet": false,
  "no_buffering": true,
  "packet_count": 0,
  "ethernet_offset": 0,
  "pcap_output": "",
  "capture_file": ""
}
