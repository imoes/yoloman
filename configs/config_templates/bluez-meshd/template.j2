[General]

# Default setting for whether secure network beaconing is enabled for unconfigured nodes
# Valid values: true, false
# Defaults to true
{% if Beacon is defined and Beacon is not none and (Beacon is number or Beacon is boolean or Beacon | length > 0) %}Beacon = {{ Beacon | default(true) }}{% else %}#Beacon = true{% endif %}

# Default setting for whether relay feature can be configured for local nodes
# Valid values: true, false
# Defaults to true
{% if Relay is defined and Relay is not none and (Relay is number or Relay is boolean or Relay | length > 0) %}Relay = {{ Relay | default(true) }}{% else %}#Relay = true{% endif %}

# Default setting for whether Friendship feature can be configured for local nodes
# Valid values: true, false
# Defaults to true
{% if Friendship is defined and Friendship is not none and (Friendship is number or Friendship is boolean or Friendship | length > 0) %}Friendship = {{ Friendship | default(true) }}{% else %}#Friendship = true{% endif %}

# Default depth of replay protection list (valid range 1-65535)
# Defaults to 100
{% if CRPL is defined and CRPL is not none and (CRPL is number or CRPL is boolean or CRPL | length > 0) %}CRPL = {{ CRPL | default(100) }}{% else %}#CRPL = 100{% endif %}

# Default size of friend queue: number of messages each Friend node can store for Low Power node (valid range 0-32)
# Defaults to 32
{% if FriendQueueSize is defined and FriendQueueSize is not none and (FriendQueueSize is number or FriendQueueSize is boolean or FriendQueueSize | length > 0) %}FriendQueueSize = {{ FriendQueueSize | default(32) }}{% else %}#FriendQueueSize = 32{% endif %}

# Provisioning timeout in seconds (0 means no timeout)
# Defaults to 60
{% if ProvTimeout is defined and ProvTimeout is not none and (ProvTimeout is number or ProvTimeout is boolean or ProvTimeout | length > 0) %}ProvTimeout = {{ ProvTimeout | default(60) }}{% else %}#ProvTimeout = 60{% endif %}
