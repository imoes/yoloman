[General]

# Default setting for whether secure network beaconing is enabled for unconfigured nodes.
# Applies to newly provisioned, created, or imported nodes that have not yet been
# configured by a configuration client.
# Valid values: true, false.
# Defaults to true.
Beacon = {{ Beacon | default(true) | lower }}

# Default setting for whether the relay feature can be configured for local nodes.
# If true, a configuration client can enable or disable the relay feature per local node.
# If false, the relay feature is disabled for all local nodes and cannot be enabled.
# Valid values: true, false.
# Defaults to true.
Relay = {{ Relay | default(true) | lower }}

# Default setting for whether the Friendship feature can be configured for local nodes.
# If true, a configuration client can enable or disable the Friendship feature per local node.
# If false, the Friendship feature is disabled for all local nodes and cannot be enabled.
# Valid values: true, false.
# Defaults to true.
Friendship = {{ Friendship | default(true) | lower }}

# Default depth of the replay protection list (CRPL).
# This setting applies to each individual node and limits the number of messages
# the node can store for replay protection.
# Valid range: 1-65535.
# Defaults to 100.
CRPL = {{ CRPL | default(100) }}

# Default size of the friend queue.
# Specifies the number of messages that each Friend node can store for a Low Power node.
# Valid range: 0-32.
# Defaults to 32.
FriendQueueSize = {{ FriendQueueSize | default(32) }}

# Provisioning timeout in seconds.
# The maximum time allowed for the provisioning process to complete.
# Setting this value to zero disables the timeout (infinite wait).
# Defaults to 60.
ProvTimeout = {{ ProvTimeout | default(60) }}