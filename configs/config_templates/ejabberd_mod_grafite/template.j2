# ejabberd_mod_grafite module configuration
# Enable the Grafite metrics module
ejabberd_modules:
  grafite:
    host: "{{ grafite_host }}"
    port: {{ grafite_port }}
    prefix: "{{ grafite_prefix }}"
    interval: {{ grafite_interval }}
    tags:
{% for tag in grafite_tags %}      - "{{ tag }}"
{% endfor %}    enabled_stats:
{% for stat in grafite_enabled_stats %}      - "{{ stat }}"
{% endfor %}
