{
  "grafite_host": "graphite.example.com",
  "grafite_port": 2003,
  "grafite_prefix": "ejabberd.prod.dc1",
  "grafite_interval": 30,
  "grafite_tags": [
    "env=production",
    "dc=dc1",
    "service=xmpp"
  ],
  "grafite_enabled_stats": [
    "active_users",
    "sessions",
    "messages_sent",
    "messages_received",
    "roster_items",
    "online_nodes",
    "auth_attempts"
  ]
}
