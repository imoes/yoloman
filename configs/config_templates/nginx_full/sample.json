{
  "nginx_user": "www-data",
  "nginx_group": "www-data",
  "nginx_error_log": "/var/log/nginx/error.log",
  "nginx_pid": "/run/nginx.pid",
  "nginx_worker_connections": 1024,
  "nginx_event_method": "epoll",
  "nginx_access_log": "/var/log/nginx/access.log",
  "nginx_sendfile": true,
  "nginx_tcp_nopush": true,
  "nginx_tcp_nodelay": true,
  "nginx_keepalive_timeout": 65,
  "nginx_keepalive_requests": 1000,
  "nginx_gzip": true,
  "nginx_gzip_vary": true,
  "nginx_gzip_proxied": "any",
  "nginx_gzip_types": [
    "text/plain",
    "text/css",
    "application/json",
    "application/javascript",
    "text/xml",
    "application/xml",
    "application/xml+rss",
    "text/javascript"
  ],
  "nginx_gzip_min_length": 256,
  "nginx_client_max_body_size": "10m",
  "nginx_hide_version": true,
  "nginx_enable_stream": true,
  "nginx_stream_error_log": "/var/log/nginx/stream_error.log",
  "nginx_stream_listen_port": 8000,
  "nginx_stream_upstream_name": "backend_tcp",
  "nginx_upstreams": [
    {
      "name": "backend_http",
      "servers": [
        {
          "address": "10.0.0.10",
          "port": 8080,
          "weight": 1,
          "max_fails": 3,
          "fail_timeout": "30s"
        },
        {
          "address": "10.0.0.11",
          "port": 8080,
          "weight": 1,
          "max_fails": 3,
          "fail_timeout": "30s"
        },
        {
          "address": "10.0.0.12",
          "port": 8080,
          "weight": 1,
          "max_fails": 3,
          "fail_timeout": "30s"
        }
      ]
    }
  ]
}
