# /etc/nginx/nginx.conf — main configuration file
# Global settings
user {{ nginx_user }} {{ nginx_group }};
worker_processes auto;
error_log {{ nginx_error_log }};
pid {{ nginx_pid }};

# Event handling model
events {
    worker_connections {{ nginx_worker_connections }};
    use {{ nginx_event_method }};
}

# HTTP core module settings
http {
    # Include mime types and default settings
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    access_log {{ nginx_access_log }};

    # Performance tuning
    sendfile {{ 'on' if nginx_sendfile else 'off' }};
    tcp_nopush {{ 'on' if nginx_tcp_nopush else 'off' }};
    tcp_nodelay {{ 'on' if nginx_tcp_nodelay else 'off' }};

    # Keepalive settings
    keepalive_timeout {{ nginx_keepalive_timeout }};
    keepalive_requests {{ nginx_keepalive_requests }};

    # Gzip compression
    gzip {{ 'on' if nginx_gzip else 'off' }};
    gzip_vary {{ 'on' if nginx_gzip_vary else 'off' }};
    gzip_proxied {{ nginx_gzip_proxied }};
    gzip_types {{ nginx_gzip_types | join(', ') }};
    gzip_min_length {{ nginx_gzip_min_length }};

    # Client body settings
    client_max_body_size {{ nginx_client_max_body_size }};

    # Server tokens (hide version info if disabled)
    server_tokens {{ 'off' if nginx_hide_version else 'on' }};

    # Include additional configuration files
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}

# Optional stream module for TCP/UDP load balancing (if enabled)
{% if nginx_enable_stream %}stream {
    # Log level and path for stream module
    error_log {{ nginx_stream_error_log }};
    {
{% for upstream in nginx_upstreams %}        upstream {{ upstream.name }} {
{% for server in upstream.servers %}            server {{ server.address }}:{{ server.port }}{% if server.weight %} weight={{ server.weight }}{% endif %}{% if server.max_fails %} max_fails={{ server.max_fails }}{% endif %}{% if server.fail_timeout %} fail_timeout={{ server.fail_timeout }}{% endif %};
{% endfor %}        }
{% endfor %}        server {
            listen {{ nginx_stream_listen_port }};
            proxy_pass {{ nginx_stream_upstream_name }};
        }
    }
{% endif %}