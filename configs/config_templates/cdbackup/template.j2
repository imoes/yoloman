# cdbackup configuration file
# Generated by Jinja2 template
# Each line corresponds to a cdbackup(1) option.
# NOTE: This is NOT a runtime config file; cdbackup reads options from command line only.
# This template describes the command-line arguments used to invoke cdbackup.
# It is meant for documentation/automation of backup scripts using cdbackup.

# Device to read media info from (required for auto-detection)
# cdbackup -d <device>
{%- if device is defined %}
-d {{ device | default('/dev/burner') }}
{%- endif %}

# SCSI device passed to cdrecord(1) as dev= (format: scsibus,target,lun)
# cdbackup -r scsibus,target,lun
{%- if scsi_device is defined %}
-r {{ scsi_device }}
{%- endif %}

# Writing speed (passed to cdrecord(1) as speed=)
# cdbackup -s <speed>
{%- if speed is defined %}
-s {{ speed }}
{%- endif %}

# Padding in 2048-byte sectors (passed to cdrecord(1) as padsize=)
# cdbackup -p <num>
{%- if padding is defined %}
-p {{ padding }}
{%- endif %}

# Enable CDROM XA2 mode (default is CDROM mode 1)
# cdbackup -X
{%- if xa2_mode | default(false) %}
-X
{%- endif %}

# Enable DVD writing mode
# cdbackup -R
{%- if dvd_mode | default(false) %}
-R
{%- endif %}

# Alternate cdrecord executable
# cdbackup -E <path>
{%- if cdrecord_exec is defined %}
-E {{ cdrecord_exec }}
{%- endif %}

# Enable virtual image mode with specified image path
# cdbackup -i <image>
{%- if image_path is defined %}
-i {{ image_path }}
{%- endif %}

# Media size (required for virtual image mode; auto-detected otherwise)
# cdbackup -l <size> (e.g., 700, 4488m, 350000s)
{%- if media_size is defined %}
-l {{ media_size }}
{%- endif %}

# Disable CRC checksum creation (not recommended)
# cdbackup -C
{%- if disable_crc | default(false) %}
-C
{%- endif %}

# Backup label (first 32 chars saved with backup)
# cdbackup -a <label>
-a {{ label | default('CDBackup Track') }}

# External media-change command (multi-disk mode)
# cdbackup -c <command>
{%- if media_change_cmd is defined %}
-c {{ media_change_cmd }}
{%- endif %}

# Enable multi-disk mode (continue on next media)
# cdbackup -m
{%- if multi_disk | default(false) %}
-m
{%- endif %}

# Verbose mode
# cdbackup -v
{%- if verbose | default(false) %}
-v
{%- endif %}

# Debug mode (rarely needed)
# cdbackup -D
{%- if debug | default(false) %}
-D
{%- endif %}

# Extra options passed directly to cdrecord(1)
# cdbackup -- <cdrecord-options>
{%- if cdrecord_extra_opts is defined %}
-- {{ cdrecord_extra_opts | join(' ') }}
{%- endif %}
