# Enable the XML packet logging module
{% if enabled %}
modules:
  mod_logxml:
    # Base directory for log files
    log_dir: "{{ log_dir }}"
    # Log filename pattern (supports strftime formatting)
    log_file: "{{ log_file }}"
    # Maximum size (in bytes) before rotating log files
    max_size: {{ max_size }}
    # Maximum number of rotated log files to keep
    keep: {{ keep }}
    # Include full stanza (IQ, message, presence) content in logs
    full_stanza: {{ full_stanza | lower }}
    # Log direction: 'in', 'out', or 'both'
    direction: "{{ direction }}"
{% endif %}