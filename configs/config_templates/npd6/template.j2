// npd6 config file
// Configuration for npd6: a proxy NDP/NDP6 daemon.
// See `man npd6` for full documentation of all options.

//***************************************************
// Core Routing Configuration
//***************************************************

// The IPv6 prefix portion that npd6 will match on for neighbor solicitations.
// Format: A standard IPv6 prefix (e.g., 2001:db8::/32).
// Supports unlimited prefix/interface pairs in this file.
prefix = {{ prefix | default('2222:1111:2222:3333:') }}

// The network interface to monitor and use for the neighbor proxy.
// Must be an active interface on the host.
interface = {{ interface | default('eth0') }}

//***************************************************
// Router Advertisement (RA) Handling
//***************************************************

// Enable Router Advertisement logging.
// 'on': logs prefix info at INFO level.
// 'off': minimal logging (default).
ralogging = {{ ralogging | default('off') }}

//***************************************************
// Neighbor Solicitation (NS) Filtering (Black/White Lists)
//***************************************************

// List type for filtering NS requests.
// 'none': Accept all NS matching the prefix (default).
// 'black': Accept all NS EXCEPT those in the address list.
// 'white': Accept ONLY NS present in the address list.
listtype = {{ listtype | default('none') }}

// Enable logging of list matches when using black or white lists.
// If 'on', matches against the allow/deny lists are logged.
// Note: Debug mode logs these regardless of this setting.
listlogging = {{ listlogging | default('off') }}

//***************************************************
// Advanced Options
// NOTE: These options are typically left at defaults unless
// specific troubleshooting or advanced tuning is required.
//***************************************************

// Number of targets to collect target data for.
// 0 to disable data collection entirely.
// Data can be dumped via USR2 signal.
collectTargets = {{ collectTargets | default('100') }}

// Set to true to enable target link-layer option on replies
// to unicasted Neighbor Solicitations.
linkOption = {{ linkOption | default('false') }}

// If true, ignore NS for the local interface addresses and let
// the kernel reply directly.
ignoreLocal = {{ ignoreLocal | default('true') }}

// If true, set the ROUTER flag in outbound Neighbor Advertisements.
routerNA = {{ routerNA | default('true') }}

// Maximum number of hops for Neighbor Advertisements.
// Should usually remain 255 to ensure propagation.
maxHops = {{ maxHops | default('255') }}

// Number of consecutive poll errors before terminating the process.
// Useful for detecting permanent interface failures.
pollErrorLimit = {{ pollErrorLimit | default('20') }}

// End of configuration.
// $Id: npd6.conf $
