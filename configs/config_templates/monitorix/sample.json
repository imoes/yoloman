{
  "hostname": "monitor-server-01",
  "base_url": "/monitorix",
  "lang": "en",
  "cgi_buffer": true,
  "time_zone": "UTC",
  "ipv6_enabled": false,
  "lock_file": "/var/run/monitorix/monitorix.lock",
  "log_level": 1,
  "server_type": "internal",
  "port": 8080,
  "host": "0.0.0.0",
  "server_exe": "/usr/share/monitorix/monitorix-cgi",
  "pid_file": "/var/run/monitorix/monitorix.pid",
  "cgi_path": "/cgi-bin/monitorix-cgi",
  "run_as_user": "monitorix",
  "run_as_group": "monitorix",
  "tmp_dir": "/var/lib/monitorix",
  "bg_color": "#F9F9F9",
  "fg_color": "#333333",
  "border_color": "#CCCCCC",
  "font_family": "sans",
  "graph_width": 750,
  "graph_height": 220,
  "default_time_range": 86400,
  "rrd_base_dir": "/var/lib/monitorix",
  "rrd_step": 30,
  "rrd_heartbeat": 60,
  "enabled_system": true,
  "uptime_cmd": "/usr/bin/uptime",
  "enabled_disks": true,
  "disks_to_monitor": [
    "sda",
    "nvme0n1"
  ],
  "enabled_network": true,
  "interfaces_to_monitor": [
    "eth0",
    "wlan0"
  ],
  "enabled_processes": true,
  "enabled_users": true,
  "enabled_ports": true,
  "ss_cmd": "/usr/bin/ss",
  "enabled_mail": true,
  "smtp_server": "smtp.example.com",
  "smtp_port": 587,
  "smtp_tls": true,
  "smtp_user": "monitorix@example.com",
  "smtp_pass": "secret123",
  "from_addr": "monitorix@example.com",
  "to_addrs": [
    "admin@example.com",
    "ops@example.com"
  ],
  "cpu_alert_threshold": 90,
  "mem_alert_threshold": 85,
  "load_alert_threshold": 4,
  "enabled_alert": false,
  "alert_cmd": "",
  "enabled_apache": true,
  "apache_status_url": "http://localhost/server-status?auto",
  "apache_auth_user": "monitor",
  "apache_auth_pass": "monitorpass",
  "enabled_mysql": true,
  "mysql_host": "localhost",
  "mysql_user": "monitorix",
  "mysql_password": "",
  "enabled_nginx": false,
  "nginx_status_url": "http://localhost/nginx_status",
  "enabled_logwatch": true,
  "logwatch_config": "",
  "log_files_to_monitor": [
    "/var/log/auth.log",
    "/var/log/syslog",
    "/var/log/kern.log"
  ]
}
