# Monitorix configuration file - main settings
# http://www.monitorix.org/

[global]
# Hostname to display in web interface (auto-detected if empty)
hostname = {{ hostname }}

# Base URL path for the web interface (e.g., /monitorix)
base_url = {{ base_url }}

# Default language for web UI
lang = {{ lang }}

# Enable/disable CGI output buffering (improves performance)
cgi_buffer = {{ cgi_buffer|lower }}

# Time zone (e.g., UTC, Europe/Berlin)
time_zone = {{ time_zone }}

# Use IPv6 for listening (true/false)
ipv6_enabled = {{ ipv6_enabled|lower }}

# Path to lockfile
lock_file = {{ lock_file }}

# Log level: 0 = quiet, 1 = normal, 2 = verbose, 3 = debug
log_level = {{ log_level }}

[server]
# HTTP server implementation: 'internal' or 'external'
server_type = {{ server_type }}

# Port to listen on (used only for internal server)
port = {{ port }}

# Host to bind to (empty = all interfaces)
host = {{ host }}

# Path to internal server executable (if using internal server)
server_exe = {{ server_exe }}

# Path to PID file for the internal server
pid_file = {{ pid_file }}

# Path to the CGI script (for external server setups)
cgi_path = {{ cgi_path }}

# User to drop privileges to (must be non-root for security)
run_as_user = {{ run_as_user }}

# Group to drop privileges to
run_as_group = {{ run_as_group }}

# Directory for temporary files (must be writable by run_as_user)
tmp_dir = {{ tmp_dir }}

[colors]
# Background color for graphs (hex)
bg_color = {{ bg_color }}
# Foreground/text color (hex)
fg_color = {{ fg_color }}
# Border color (hex)
border_color = {{ border_color }}
# Font family
font_family = {{ font_family }}

[graph]
# Default graph width in pixels
graph_width = {{ graph_width }}
# Default graph height in pixels
graph_height = {{ graph_height }}
# Default graph time window in seconds (e.g., 3600=1h, 86400=1d)
default_time_range = {{ default_time_range }}

[rrd]
# Path to RRD files
base_dir = {{ rrd_base_dir }}
# Step interval in seconds (default: 30)
step = {{ rrd_step }}
# Heartbeat interval (default: 60)
heartbeat = {{ rrd_heartbeat }}

[system]
# Enable/disables system metrics collection (cpu, memory, load, etc.)
enabled = {{ enabled_system|lower }}
# Command to get uptime
uptime_cmd = {{ uptime_cmd }}

[disks]
# Enable disk I/O and space monitoring
enabled = {{ enabled_disks|lower }}
# List of disks to monitor (empty = auto-detect)
monitored_disks = {{ disks_to_monitor | join(', ') | default('') }}

[network]
# Enable network interface monitoring
enabled = {{ enabled_network|lower }}
# List of interfaces to monitor (empty = auto-detect)
monitored_interfaces = {{ interfaces_to_monitor | join(', ') | default('') }}

[processes]
# Enable process count & resource monitoring
enabled = {{ enabled_processes|lower }}

[users]
# Enable logged-in users monitoring
enabled = {{ enabled_users|lower }}

[ports]
# Enable listening port monitoring
enabled = {{ enabled_ports|lower }}
# Path to netstat/ss command for port detection
ss_cmd = {{ ss_cmd }}

[mail]
# Enable email notifications
enabled = {{ enabled_mail|lower }}
# SMTP server
smtp_server = {{ smtp_server }}
# SMTP port
smtp_port = {{ smtp_port }}
# Use TLS/SSL for SMTP
smtp_tls = {{ smtp_tls|lower }}
# SMTP username (if auth required)
smtp_user = {{ smtp_user }}
# SMTP password (if auth required)
smtp_pass = {{ smtp_pass }}
# Sender email address
from_addr = {{ from_addr }}
# Comma-separated list of recipient email addresses
to_addrs = {{ to_addrs | join(', ') | default('') }}
# Threshold for high CPU usage alert (%)
cpu_alert_threshold = {{ cpu_alert_threshold }}
# Threshold for high memory usage alert (%)
mem_alert_threshold = {{ mem_alert_threshold }}
# Threshold for high load alert (system-dependent)
load_alert_threshold = {{ load_alert_threshold }}

[alert]
# Enable alerting via script or command
enabled = {{ enabled_alert|lower }}
# Command/script to run on alert (receives alert message via stdin)
alert_cmd = {{ alert_cmd }}

[apache]
# Enable Apache metrics (if installed & configured)
enabled = {{ enabled_apache|lower }}
# URL to Apache server-status (requires mod_status)
status_url = {{ apache_status_url }}
# HTTP Basic Auth credentials (if required)
auth_user = {{ apache_auth_user }}
auth_pass = {{ apache_auth_pass }}

[mysql]
# Enable MySQL metrics (if installed & configured)
enabled = {{ enabled_mysql|lower }}
# MySQL socket path or host:port
host = {{ mysql_host }}
user = {{ mysql_user }}
password = {{ mysql_password }}

[nginx]
# Enable Nginx metrics (if installed & configured)
enabled = {{ enabled_nginx|lower }}
# URL to Nginx stub_status
status_url = {{ nginx_status_url }}

[logwatch]
# Enable log monitoring
enabled = {{ enabled_logwatch|lower }}
# Path to logwatch config (optional)
config = {{ logwatch_config }}
# List of log files to monitor
log_files = {% for lf in log_files_to_monitor %}{{ lf }}
{% endfor %}
