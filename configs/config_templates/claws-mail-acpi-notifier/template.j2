# Claws Mail acpi_notifier plugin configuration
# ==========================
# This file configures the acpi_notifier plugin for Claws Mail.
# It enables mail notification using the laptop's hardware LED (ACPI).
#
# Schema:
#   enabled              : bool   - Enable the acpi_notifier plugin (must be true for plugin to load)
#   newmail_mode         : str    - LED behavior when new mail is received ('on', 'blink', or 'off')
#   user_interaction_mode: str    - LED behavior when user interaction is required ('blink', 'on', or 'off')
# ==========================

[general]
# Enable or disable the plugin.
# Must be set to 'true' for the plugin to load and function.
# Defaults to False (disabled).
enabled={{ enabled|default(false)|lower }}

# LED behavior when new mail arrives.
# Valid values: 'on', 'blink', or 'off'.
# Defaults to 'blink'.
newmail_mode={{ newmail_mode|default('blink') }}

# LED behavior when user interaction is required (e.g., user needs to address a message).
# Valid values: 'blink', 'on', or 'off'.
# Defaults to 'blink'.
user_interaction_mode={{ user_interaction_mode|default('blink') }}