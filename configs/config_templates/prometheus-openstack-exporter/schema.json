{
  "listen_port": {
    "type": "number",
    "default": 9183,
    "description": "Port on which the exporter listens for metrics."
  },
  "cache_refresh_interval": {
    "type": "number",
    "default": 300,
    "description": "Cache refresh interval in seconds."
  },
  "cache_file": {
    "type": "string",
    "default": "/var/cache/prometheus-openstack-exporter/mycloud",
    "description": "Path to the cache file."
  },
  "openstack_cloud_name": {
    "type": "string",
    "default": "mycloud",
    "description": "Name of the OpenStack cloud configuration to use."
  },
  "openstack_allocation_ratio_vcpu": {
    "type": "number",
    "default": 2.5,
    "description": "VCPU allocation ratio for OpenStack."
  },
  "openstack_allocation_ratio_ram": {
    "type": "number",
    "default": 1.1,
    "description": "RAM allocation ratio for OpenStack."
  },
  "openstack_allocation_ratio_disk": {
    "type": "number",
    "default": 1.0,
    "description": "Disk allocation ratio for OpenStack."
  },
  "log_level": {
    "type": "string",
    "default": "INFO",
    "description": "Logging level (e.g., DEBUG, INFO, WARNING, ERROR).",
    "enum": [
      "INFO",
      "ERROR"
    ],
    "enum_open": true
  },
  "enabled_collectors": {
    "type": "list",
    "default": [
      "cinder",
      "neutron",
      "nova",
      "swift"
    ],
    "description": "List of enabled collectors."
  },
  "schedulable_instance_size_ram_mbs": {
    "type": "number",
    "default": 4096,
    "description": "RAM size in MB for schedulable instance size."
  },
  "schedulable_instance_size_vcpu": {
    "type": "number",
    "default": 2,
    "description": "VCPU count for schedulable instance size."
  },
  "schedulable_instance_size_disk_gbs": {
    "type": "number",
    "default": 20,
    "description": "Disk size in GB for schedulable instance size."
  },
  "swift_hosts": {
    "type": "list",
    "default": [
      "host1.example.com",
      "host2.example.com"
    ],
    "description": "List of Swift hosts."
  },
  "keystone_tenants_map_path": {
    "type": "string",
    "default": "",
    "description": "Path to the file mapping tenant names to IDs."
  },
  "reseller_prefix": {
    "type": "string",
    "default": "AUTH_",
    "description": "Reseller prefix for Swift middleware."
  },
  "ring_path": {
    "type": "string",
    "default": "/etc/swift",
    "description": "Path to the Swift rings directory."
  },
  "hash_path_prefix": {
    "type": "string",
    "default": "",
    "description": "Hash path prefix for Swift."
  },
  "hash_path_suffix": {
    "type": "string",
    "default": "",
    "description": "Hash path suffix for Swift."
  }
}
