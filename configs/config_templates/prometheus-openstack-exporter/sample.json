{
  "listen_port": 9183,
  "cache_refresh_interval": 300,
  "cache_file": "/var/cache/prometheus-openstack-exporter/mycloud",
  "openstack_cloud_name": "mycloud",
  "openstack_allocation_ratio_vcpu": 2.5,
  "openstack_allocation_ratio_ram": 1.1,
  "openstack_allocation_ratio_disk": 1.0,
  "log_level": "INFO",
  "enabled_collectors": [
    "cinder",
    "neutron",
    "nova",
    "swift"
  ],
  "schedulable_instance_size_ram_mbs": 4096,
  "schedulable_instance_size_vcpu": 2,
  "schedulable_instance_size_disk_gbs": 20,
  "swift_hosts": [
    "host1.example.com",
    "host2.example.com"
  ],
  "keystone_tenants_map_path": "",
  "reseller_prefix": "AUTH_",
  "ring_path": "/etc/swift",
  "hash_path_prefix": "",
  "hash_path_suffix": ""
}
