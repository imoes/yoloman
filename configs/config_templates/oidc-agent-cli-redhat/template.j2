# =============================================================================
# oidc-agent-cli configuration template
# =============================================================================
# This template generates a JSON configuration file for the oidc-agent-cli suite.
# It covers settings for oidc-agent (core), oidc-gen (account generation),
# oidc-add (account addition), and oidc-token (token retrieval).
#
# Source: https://www.lists.kit.edu/sympa/subscribe/oidc-agent-user
# =============================================================================

{
  "oidc-agent": {
    {# Path to the default cert bundle file if not found automatically. #}
    {# Type: string or null. #}
    "cert-path": {{ oidc_agent_cert_path | default('null') }},

    {# Bind address for the webserver. #}
    {# Type: string or null. #}
    "bind_address": {{ oidc_agent_bind_address | default('null') }},

    {# Whether to confirm actions. #}
    {# Type: boolean. #}
    "confirm": {{ oidc_agent_confirm | default('false') }},

    {# Whether to autoload accounts. #}
    {# Type: boolean. #}
    "autoload": {{ oidc_agent_autoload | default('true') }},

    {# Whether to auto-reauthenticate. #}
    {# Type: boolean. #}
    "auto-reauthenticate": {{ oidc_agent_auto_reauthenticate | default('true') }},

    {# Whether to auto-generate accounts. #}
    {# Type: boolean. #}
    "auto-gen": {{ oidc_agent_auto_gen | default('true') }},

    {# Scope mode for auto-gen. Possible values are "max", "exact". #}
    {# Type: string. #}
    "auto-gen-scope-mode": {{ oidc_agent_auto_gen_scope_mode | default('"max"') }},

    {# Whether to use custom URI scheme. #}
    {# Type: boolean. #}
    "custom-uri-scheme": {{ oidc_agent_custom_uri_scheme | default('true') }},

    {# Whether to enable the webserver. #}
    {# Type: boolean. #}
    "webserver": {{ oidc_agent_webserver | default('true') }},

    {# Lifetime setting. #}
    {# Type: integer. #}
    "lifetime": {{ oidc_agent_lifetime | default('0') }},

    {# Group setting. #}
    {# Type: string or null. #}
    "group": {{ oidc_agent_group | default('null') }},

    {# Whether to enable debug logging. #}
    {# Type: boolean. #}
    "debug_logging": {{ oidc_agent_debug_logging | default('false') }},

    {# If 'stats_collect_local' is true statistics are collected #}
    {# Type: boolean. #}
    "stats_collect_local": {{ oidc_agent_stats_collect_local | default('false') }},

    {# If 'stats_collect_share' and 'stats_collect_local' are true statistics are collected and send to stats server #}
    {# Type: boolean. #}
    "stats_collect_share": {{ oidc_agent_stats_collect_share | default('true') }},

    {# If 'stats_collect_location' is true and statistics are collected it includes your country #}
    {# Type: boolean. #}
    "stats_collect_location": {{ oidc_agent_stats_collect_location | default('true') }}
  },

  "oidc-gen": {
    {# CNID setting. #}
    {# Type: string or null. #}
    "cnid": {{ oidc_gen_cnid | default('null') }},

    {# Whether to auto-open URL. #}
    {# Type: boolean. #}
    "auto-open-url": {{ oidc_gen_auto_open_url | default('true') }},

    {# If set, gpg encryption is used for new account configurations with the specified gpg key #}
    {# Type: string or null. #}
    "default_gpg_key": {{ oidc_gen_default_gpg_key | default('null') }},

    {# Prompt setting. #}
    {# Type: string. #}
    "prompt": {{ oidc_gen_prompt | default('"cli"') }},

    {# Password prompt setting. #}
    {# Type: string. #}
    "pw-prompt": {{ oidc_gen_pw_prompt | default('"cli"') }},

    {# If set, all confirmation prompts are answered according to the specified policy; possible values are 'default' (uses the default option), 'no', and 'yes' #}
    {# Type: string or null. #}
    "answer-confirm-prompts": {{ oidc_gen_answer_confirm_prompts | default('null') }},

    {# Default mytoken server URL. #}
    {# Type: string. #}
    "default_mytoken_server": {{ oidc_gen_default_mytoken_server | default('"https://mytoken.data.kit.edu"') }},

    {# The 'default_mytoken_profile' is only for the oidc-gen #}
    {# Type: string. #}
    "default_mytoken_profile": {{ oidc_gen_default_mytoken_profile | default('agent') }},

    {# Whether to prefer mytoken over OIDC. #}
    {# Type: boolean. #}
    "prefer_mytoken_over_oidc": {{ oidc_gen_prefer_mytoken_over_oidc | default('false') }},

    {# Whether to enable debug logging for oidc-gen. #}
    {# Type: boolean. #}
    "debug_logging": {{ oidc_gen_debug_logging | default(false) }}
  },

  "oidc-add": {
    {# Whether to store password. #}
    {# Type: boolean. #}
    "store-pw": {{ oidc_add_store_pw | default('false') }},

    {# Prompt setting. #}
    {# Type: string. #}
    "prompt": {{ oidc_add_prompt | default('"cli"') }},

    {# Password prompt setting. #}
    {# Type: string. #}
    "pw-prompt": {{ oidc_add_pw_prompt | default('"cli"') }},

    {# Whether to enable debug logging for oidc-add. #}
    {# Type: boolean. #}
    "debug_logging": {{ oidc_add_debug_logging | default(false) }}
  },

  "oidc-token": {
    {# Default value for the -t option #}
    {# Type: integer. #}
    "default_min_lifetime": {{ oidc_token_default_min_lifetime | default('0') }},

    {# Default profile if a mytoken is requested but no profile given #}
    {# Type: string. #}
    "default_mytoken_profile": {{ oidc_token_default_mytoken_profile | default('web-default') }},

    {# Whether to enable debug logging for oidc-token. #}
    {# Type: boolean. #}
    "debug_logging": {{ oidc_token_debug_logging | default(false) }}
  }
}
