# Psensor command-line configuration
# URL of the psensor-server to connect to (e.g., http://hostname:3131)
# Default: http://localhost:3131
--url={{ psensor_url | default('http://localhost:3131') }}

# Debug level, integer between 0 and 3
# Default: 0
--debug={{ psensor_debug_level | default(0) }}

# Force the creation of a new Psensor application instance
# Default: False
{% if psensor_new_instance | default(False) | bool %}
--new-instance
{% endif %}