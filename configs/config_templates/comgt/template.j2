# =============================================================================
# comgt script files configuration
# =============================================================================
#
# This directory contains scripts for execution by the comgt utility.
# Refer to `man comgt` for more information on script syntax and usage.
#
# The scripts provided by this package:
#
# - command   : Provides an interactive session to let the user send AT commands manually.
# - dump      : Prints the result of AT&V to the console - useful for debugging device configurations.
# - sigmon    : Continuously monitors the signal strength - `man sigmon` for more info.
# - operator  : Gets a list of operators and allows the user to do a manual selection -
#               useful for roaming abroad.
#
# Copyright (C) 2006  Paul Hardwick <paul@peck.org>
# =============================================================================

# The directory where comgt script files are placed.
# Default: /etc/comgt
# This variable defines the target path for the configuration directory.
config_directory = {{ config_directory | default('/etc/comgt') }}