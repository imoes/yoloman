{
  "enabled": true,
  "interfaces": [
    "eth0",
    "eth1"
  ],
  "transport": "l2",
  "clock_identity": "a0:b1:c2:d3:e4:f5:00:01",
  "domain_number": 0,
  "primary": true,
  "log_level": 7,
  "log_file": "/var/log/linuxptp/ptp2.log",
  "announce_interval": 0,
  "sync_interval": -1,
  "delay_req_timeout": 4,
  "delay_req_interval": -2,
  "faulty_path_timeout": 60,
  "watchdog_timeout": 300,
  "allow_multiple_domains": false,
  "fallback_to_generic_phc": true,
  "initial_offset_ns": 0,
  "extra_options": [
    "-s"
  ],
  "interface_overrides": [
    {
      "name": "eth0",
      "transport": "l2",
      "priority1": 248,
      "priority2": 248,
      "clock_class": 6,
      "clock_accuracy": 10,
      "offset_scaled_log_variance": 12000,
      "master_offset": 0,
      "log_sync_interval": -3,
      "log_announce_interval": 1,
      "log_delay_req_interval": -2
    },
    {
      "name": "eth1",
      "transport": "udp",
      "priority1": 248,
      "priority2": 248,
      "clock_class": 248,
      "clock_accuracy": 255,
      "offset_scaled_log_variance": 65535,
      "master_offset": 500,
      "log_sync_interval": -1,
      "log_announce_interval": 0,
      "log_delay_req_interval": 0
    }
  ]
}
