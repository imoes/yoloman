{
  "daemon": true,
  "interface": "eth0",
  "filter": "src 192.168.1.2",
  "log_file": "/var/log/nast_report.log",
  "log_data_file": "/var/log/nast_payload.txt",
  "ascii_data": false,
  "ascii_hex_data": false,
  "disable_promisc": false,
  "check_promisc": "all",
  "host_list": true,
  "tcp_stream": [],
  "find_gateway": false,
  "reset_connection": [],
  "port_scanner": [
    {
      "host": "192.168.1.100",
      "range": "1-100"
    }
  ],
  "multi_port_scanner": false,
  "find_link": false,
  "daemon_banner": false,
  "check_arp_poisoning": true,
  "byte_counting": "any",
  "ncurses": false
}
