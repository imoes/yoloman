{
  "server_user": {
    "type": "string",
    "default": "nscd",
    "description": "User to run the nscd server as."
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Debug level for nscd."
  },
  "paranoia": {
    "type": "string",
    "default": "no",
    "description": "Enable paranoia mode (yes/no).",
    "enum": [
      "yes",
      "no"
    ]
  },
  "threads": {
    "type": "number",
    "default": 4,
    "description": "Initial number of threads to use."
  },
  "max_threads": {
    "type": "number",
    "default": 32,
    "description": "Maximum number of threads to use."
  },
  "reload_count": {
    "type": "number",
    "default": 5,
    "description": "Reload count for configuration."
  },
  "restart_interval": {
    "type": "number",
    "default": 3600,
    "description": "Restart interval in seconds."
  },
  "passwd_enable_cache": {
    "type": "string",
    "default": "yes",
    "description": "Enable passwd cache.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "passwd_positive_time_to_live": {
    "type": "number",
    "default": 600,
    "description": "Positive time to live for passwd cache in seconds."
  },
  "passwd_negative_time_to_live": {
    "type": "number",
    "default": 20,
    "description": "Negative time to live for passwd cache in seconds."
  },
  "passwd_suggested_size": {
    "type": "number",
    "default": 211,
    "description": "Suggested size for passwd cache database."
  },
  "passwd_check_files": {
    "type": "string",
    "default": "yes",
    "description": "Check files for passwd cache.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "passwd_persistent": {
    "type": "string",
    "default": "yes",
    "description": "Make passwd cache persistent.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "passwd_shared": {
    "type": "string",
    "default": "yes",
    "description": "Make passwd cache shared.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "passwd_max_db_size": {
    "type": "number",
    "default": 33554432,
    "description": "Max database size for passwd cache in bytes."
  },
  "passwd_auto_propagate": {
    "type": "string",
    "default": "yes",
    "description": "Auto propagate passwd cache.",
    "enum": [
      "yes",
      "no"
    ]
  },
