{
  "name": {
    "type": "string",
    "default": "hpsockd",
    "description": "The name of the service/daemon."
  },
  "desc": {
    "type": "string",
    "default": "HP SOCKS daemon",
    "description": "The description of the service."
  },
  "pid_dir": {
    "type": "string",
    "default": "/var/run",
    "description": "The directory where the PID file is stored."
  },
  "config_path": {
    "type": "string",
    "default": "/etc/hpsockd.conf",
    "description": "The path to the configuration file."
  },
  "daemon_path": {
    "type": "string",
    "default": "/usr/sbin/hpsockd",
    "description": "The path to the daemon executable."
  },
  "shell_path": {
    "type": "string",
    "default": "/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin",
    "description": "The PATH variable for the init script."
  }
}
