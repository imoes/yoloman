#! /bin/sh

# ===========================================================================
# Init script for hpsockd (HP SOCKS daemon)
#
# This script manages the hpsockd service using start-stop-daemon.
# It is intended to be placed in /etc/init.d/ and linked from runlevels.
#
# Managed variables are drawn from the Ansible role variables, with safe
# defaults provided via Jinja2 `default` filters.
# ===========================================================================

### BEGIN INIT INFO
# Provides:          hpsockd
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: start and stop the HP Socks daemon
# Description:       hpsockd is a Socks Daemon
### END INIT INFO

# ---------------------------------------------------------------------------
# PATH: Standard system paths for locating utilities.
# Default: '/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin'
# ---------------------------------------------------------------------------
PATH={{ shell_path | default('/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin') }}

# ---------------------------------------------------------------------------
# DAEMON: Path to the actual daemon executable.
# Default: '/usr/sbin/hpsockd'
# ---------------------------------------------------------------------------
DAEMON={{ daemon_path | default('/usr/sbin/hpsockd') }}

# ---------------------------------------------------------------------------
# NAME: The short name of the service/daemon.
# Default: 'hpsockd'
# ---------------------------------------------------------------------------
NAME={{ name | default('hpsockd') }}

# ---------------------------------------------------------------------------
# DESC: A human-readable description of the service.
# Default: 'HP SOCKS daemon'
# ---------------------------------------------------------------------------
DESC="{{ desc | default('HP SOCKS daemon') }}"

# ---------------------------------------------------------------------------
# PID_DIR: Directory where the PID file will be stored.
# Default: '/var/run'
# ---------------------------------------------------------------------------
PID_DIR={{ pid_dir | default('/var/run') }}

# ---------------------------------------------------------------------------
# CONFIG_PATH: Path to the configuration file used by the daemon.
# Default: '/etc/hpsockd.conf'
# ---------------------------------------------------------------------------
CONFIG_PATH={{ config_path | default('/etc/hpsockd.conf') }}

# ---------------------------------------------------------------------------
# SHELL_PATH: Redundant alias for PATH, preserved for legacy compatibility.
# Default: '/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin'
# ---------------------------------------------------------------------------
SHELL_PATH={{ shell_path | default('/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin') }}

# Check if the daemon binary actually exists; exit silently if not.
test -f $DAEMON_PATH || exit 0

# Exit immediately on any error.
set -e

case "$1" in
  start)
    # Start the service only if the configuration file exists.
    if [ -f {{ config_path | default('/etc/hpsockd.conf') }} ]; then
        echo -n "Starting $DESC: "
        start-stop-daemon --start --quiet --pidfile {{ pid_dir | default('/var/run') }}/$NAME.pid \
            --exec $DAEMON_PATH
        echo "$NAME."
    else
        echo "Not starting $DESC: no config file."
    fi
    ;;
  stop)
    echo -n "Stopping $DESC: "
    start-stop-daemon --stop --quiet --pidfile {{ pid_dir | default('/var/run') }}/$NAME.pid \
        --exec $DAEMON_PATH
    echo "$NAME."
    ;;
  reload|force-reload)
    echo "Reloading $DESC configuration files."
    /usr/sbin/sdc reload
  ;;
  restart)
    echo -n "Restarting $DESC: "
    # Stop the daemon
    start-stop-daemon --stop --quiet --pidfile \
        {{ pid_dir | default('/var/run') }}/$NAME.pid --exec $DAEMON_PATH
    sleep 1
    # Start the daemon again
    start-stop-daemon --start --quiet --pidfile \
        {{ pid_dir | default('/var/run') }}/$NAME.pid --exec $DAEMON_PATH
    echo "$NAME."
    ;;
  *)
    N=/etc/init.d/$NAME
    echo "Usage: $N {start|stop|restart|reload|force-reload}" >&2
    exit 1
    ;;
esac

exit 0