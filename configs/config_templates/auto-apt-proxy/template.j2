# auto-apt-proxy configuration
# This file configures APT to use auto-apt-proxy for automatic proxy
# detection and management.

# Path to the auto-apt-proxy executable.
# Specifies the location of the binary responsible for detecting
# and managing the system's HTTP/HTTPS proxy settings.
Acquire::http::Proxy-Auto-Detect "{{ auto_apt_proxy_path | default('/usr/bin/auto-apt-proxy') }}";

# Enable debugging output from auto-apt-proxy (yes/no).
# When set to 'yes', auto-apt-proxy will emit detailed diagnostic
# messages to standard error, useful for troubleshooting proxy issues.
auto-apt-proxy::Debug "{{ auto_apt_proxy_debug | default('no') }}";