{
  "log_level": "info",
  "mode": "resolver",
  "doh_enabled": true,
  "doh_address": "0.0.0.0:443",
  "doh_cert_path": "/etc/hickory-dns/certs/doh.crt",
  "doh_key_path": "/etc/hickory-dns/certs/doh.key",
  "dot_enabled": true,
  "dot_address": "0.0.0.0:853",
  "dot_cert_path": "/etc/hickory-dns/certs/dot.crt",
  "dot_key_path": "/etc/hickory-dns/certs/dot.key",
  "tcp_address": "127.0.0.1:53",
  "tcp_idle_timeout": 300,
  "udp_address": "127.0.0.1:53",
  "udp_max_message_size": 4096,
  "upstreams": [
    "9.9.9.9:53",
    "149.112.112.112:53"
  ],
  "recursor_query_timeout": 10,
  "recursor_max_concurrent_queries": 4096,
  "recursor_validate": true,
  "root_ksk_path": "/etc/hickory-dns/root.key",
  "zones": [
    {
      "name": "example.com",
      "file": "/etc/hickory-dns/zones/example.com.zone",
      "type": "primary"
    },
    {
      "name": "10.in-addr.arpa",
      "file": "/etc/hickory-dns/zones/10.zone",
      "type": "secondary",
      "axfr_source": "10.0.0.1"
    }
  ],
  "rrld_enabled": true,
  "rrld_max_responses": 20,
  "drop_quietly": true,
  "server_id": "hickory-primary",
  "soa_mname": "ns1.example.com."
}
