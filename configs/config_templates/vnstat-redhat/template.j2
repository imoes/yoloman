# vnStat configuration file for systemd service
#
# This file is generated by Ansible.
# Format: `DirectiveName Value` (uncommented/active) or `;DirectiveName Value` (commented/default).
# To activate a directive, remove the leading semicolon and/or update the value.
#
# For detailed descriptions of every option, see the vnstat.conf(5) manpage.

###############################################################################
# Global Settings
###############################################################################

# Default interface name to monitor.
# Leave empty for automatic selection by the daemon.
# If set, vnstatd will only monitor this specific interface.
{% if vnstat_interface is defined and vnstat_interface|length > 0 %}
Interface "{{ vnstat_interface }}"
{% else %}
;Interface ""
{% endif %}

# Location of the vnStat database directory.
# The daemon must have read/write permissions here.
{% if vnstat_database_dir is defined and vnstat_database_dir|length > 0 %}
DatabaseDir "{{ vnstat_database_dir }}"
{% else %}
;DatabaseDir "/var/lib/vnstat"
{% endif %}

# Locale to use for output formatting (LC_ALL).
# Use '-' for the system default locale.
{% if vnstat_locale is defined and vnstat_locale|length > 0 %}
Locale "{{ vnstat_locale }}"
{% else %}
;Locale "-"
{% endif %}

# Unit prefix mode for traffic volume.
# 0 = IEC standard (KiB, MiB, GiB)
# 1 = Old Binary (KB, MB, GB)
# 2 = SI Decimal (kB, MB, GB)
{% if vnstat_unit_mode is defined and vnstat_unit_mode|length > 0 %}
UnitMode {{ vnstat_unit_mode }}
{% else %}
;UnitMode 0
{% endif %}

# Rate unit (0 = Bytes/s, 1 = Bits/s).
# Most common setting is 1 (bits) for network interfaces.
{% if vnstat_rate_unit is defined and vnstat_rate_unit|length > 0 %}
RateUnit {{ vnstat_rate_unit }}
{% else %}
;RateUnit 1
{% endif %}

# Rate unit prefix mode when RateUnit is 1 (Bits).
# 0 = IEC binary (Kibit/s)
# 1 = SI decimal (kbit/s)
{% if vnstat_rate_unit_mode is defined and vnstat_rate_unit_mode|length > 0 %}
RateUnitMode {{ vnstat_rate_unit_mode }}
{% else %}
;RateUnitMode 1
{% endif %}

# Output style for text-based queries (vnstat command).
# 0 = minimal, narrow
# 1 = bar column visible
# 2 = bar + rate in summary
# 3 = rate column visible
{% if vnstat_output_style is defined and vnstat_output_style|length > 0 %}
OutputStyle {{ vnstat_output_style }}
{% else %}
;OutputStyle 3
{% endif %}

# Whether the estimate bar is visible in list outputs.
# 0 = disabled, 1 = enabled
{% if vnstat_estimate_bar_visible is defined and vnstat_estimate_bar_visible|length > 0 %}
EstimateBarVisible {{ vnstat_estimate_bar_visible }}
{% else %}
;EstimateBarVisible 1
{% endif %}

# Number of decimal places for default output formats.
{% if vnstat_default_decimals is defined and vnstat_default_decimals|length > 0 %}
DefaultDecimals {{ vnstat_default_decimals }}
{% else %}
;DefaultDecimals 2
{% endif %}

# Number of decimal places for hourly output formats.
{% if vnstat_hourly_decimals is defined and vnstat_hourly_decimals|length > 0 %}
HourlyDecimals {{ vnstat_hourly_decimals }}
{% else %}
;HourlyDecimals 1
{% endif %}

# Spacer style for hourly sections in hourly output.
# 0 = none, 1 = '|', 2 = '][', 3 = '[ ]'
{% if vnstat_hourly_section_style is defined and vnstat_hourly_section_style|length > 0 %}
HourlySectionStyle {{ vnstat_hourly_section_style }}
{% else %}
;HourlySectionStyle 2
{% endif %}

# Sampling time in seconds for real-time tracking (-tr option).
{% if vnstat_sampletime is defined and vnstat_sampletime|length > 0 %}
Sampletime {{ vnstat_sampletime }}
{% else %}
;Sampletime 5
{% endif %}

# Default query mode for vnstat.
# 0 = normal, 1 = days, 2 = months, 3 = top, 5 = short, 7 = hours
# 8 = xml, 9 = one line, 10 = json
{% if vnstat_query_mode is defined and vnstat_query_mode|length > 0 %}
QueryMode {{ vnstat_query_mode }}
{% else %}
;QueryMode 0
{% endif %}

# Limits for list output entries (0 = all entries).
# List5Mins: Limit for 5-minute list entries
{% if vnstat_list5_mins is defined and vnstat_list5_mins|length > 0 %}
List5Mins      {{ vnstat_list5_mins }}
{% else %}
;List5Mins      24
{% endif %}

# ListHours: Limit for hourly list entries
{% if vnstat_list_hours is defined and vnstat_list_hours|length > 0 %}
ListHours      {{ vnstat_list_hours }}
{% else %}
;ListHours      24
{% endif %}

# ListDays: Limit for daily list entries
{% if vnstat_list_days is defined and vnstat_list_days|length > 0 %}
ListDays       {{ vnstat_list_days }}
{% else %}
;ListDays       30
{% endif %}

# ListMonths: Limit for monthly list entries
{% if vnstat_list_months is defined and vnstat_list_months|length > 0 %}
ListMonths     {{ vnstat_list_months }}
{% else %}
;ListMonths     12
{% endif %}

# ListYears: Limit for yearly list entries
{% if vnstat_list_years is defined and vnstat_list_years|length > 0 %}
ListYears      {{ vnstat_list_years }}
{% else %}
;ListYears      0
{% endif %}

# ListTop: Limit for top list entries (top interfaces/hosts)
{% if vnstat_list_top is defined and vnstat_list_top|length > 0 %}
ListTop        {{ vnstat_list_top }}
{% else %}
;ListTop        10
{% endif %}

# Interface matching method for database lookup.
# 0 = case-sensitive exact match to interface name
# 1 = case-sensitive exact match of alias
# 2 = case-insensitive exact match of alias
# 3 = case-insensitive beginning match of alias
{% if vnstat_interface_match_method is defined and vnstat_interface_match_method|length > 0 %}
InterfaceMatchMethod {{ vnstat_interface_match_method }}
{% else %}
;InterfaceMatchMethod 3
{% endif %}

###############################################################################
# Daemon Settings (vnstatd)
###############################################################################

# User to switch to when vnstatd runs as root.
# Set to empty string or leave commented to disable switching.
{% if vnstat_daemon_user is defined and vnstat_daemon_user|length > 0 %}
DaemonUser "{{ vnstat_daemon_user }}"
{% else %}
;DaemonUser ""
{% endif %}

# Group to switch to when vnstatd runs as root.
# Set to empty string or leave commented to disable switching.
{% if vnstat_daemon_group is defined and vnstat_daemon_group|length > 0 %}
DaemonGroup "{{ vnstat_daemon_group }}"
{% else %}
;DaemonGroup ""
{% endif %}

# Enable automatic bandwidth detection for interfaces.
# 0 = disabled, 1 = enabled.
# Helps adjust counters for interfaces capable of higher speeds.
{% if vnstat_bandwidth_detection is defined and vnstat_bandwidth_detection|length > 0 %}
BandwidthDetection {{ vnstat_bandwidth_detection }}
{% else %}
;BandwidthDetection 1
{% endif %}

# Maximum bandwidth in Mbit for all interfaces (fallback).
# 0 = disabled. Used when interface-specific limits are not set.
{% if vnstat_max_bandwidth is defined and vnstat_max_bandwidth|length > 0 %}
MaxBandwidth {{ vnstat_max_bandwidth }}
{% else %}
;MaxBandwidth 1000
{% endif %}

# Data retention duration for 5-minute intervals (in hours).
# -1 = unlimited, 0 = disabled (remove data immediately after hourly rotation).
{% if vnstat_5_minute_hours is defined and vnstat_5_minute_hours|length > 0 %}
5MinuteHours   {{ vnstat_5_minute_hours }}
{% else %}
;5MinuteHours   48
{% endif %}

# Data retention duration for hourly intervals (in days).
# 0 = disabled.
{% if vnstat_hourly_days is defined and vnstat_hourly_days|length > 0 %}
HourlyDays     {{ vnstat_hourly_days }}
{% else %}
;HourlyDays     4
{% endif %}

# Data retention duration for daily intervals (in days).
# 0 = disabled.
{% if vnstat_daily_days is defined and vnstat_daily_days|length > 0 %}
DailyDays      {{ vnstat_daily_days }}
{% else %}
;DailyDays      62
{% endif %}

# Data retention duration for monthly intervals (in months).
# 0 = disabled.
{% if vnstat_monthly_months is defined and vnstat_monthly_months|length > 0 %}
MonthlyMonths  {{ vnstat_monthly_months }}
{% else %}
;MonthlyMonths  25
{% endif %}

# Data retention duration for yearly intervals (in years).
# -1 = unlimited, 0 = disabled.
{% if vnstat_yearly_years is defined and vnstat_yearly_years|length > 0 %}
YearlyYears    {{ vnstat_yearly_years }}
{% else %}
;YearlyYears    -1
{% endif %}

# Number of top day entries to keep in the database.
{% if vnstat_top_day_entries is defined and vnstat_top_day_entries|length > 0 %}
TopDayEntries  {{ vnstat_top_day_entries }}
{% else %}
;TopDayEntries  20
{% endif %}

# Interval in seconds to update interface data from the kernel.
{% if vnstat_update_interval is defined and vnstat_update_interval|length > 0 %}
UpdateInterval {{ vnstat_update_interval }}
{% else %}
;UpdateInterval 20
{% endif %}

# Interval in seconds to check for interface status changes (up/down).
{% if vnstat_poll_interval is defined and vnstat_poll_interval|length > 0 %}
PollInterval   {{ vnstat_poll_interval }}
{% else %}
;PollInterval   5
{% endif %}

# Interval in minutes to save data to the database on disk.
{% if vnstat_save_interval is defined and vnstat_save_interval|length > 0 %}
SaveInterval   {{ vnstat_save_interval }}
{% else %}
;SaveInterval   5
{% endif %}

# Interval in minutes to save data when all monitored interfaces are offline.
{% if vnstat_offline_save_interval is defined and vnstat_offline_save_interval|length > 0 %}
OfflineSaveInterval {{ vnstat_offline_save_interval }}
{% else %}
;OfflineSaveInterval 30
{% endif %}

# Rescan database for new interfaces after saving data.
# 0 = disabled, 1 = enabled.
{% if vnstat_rescan_database_on_save is defined and vnstat_rescan_database_on_save|length > 0 %}
RescanDatabaseOnSave {{ vnstat_rescan_database_on_save }}
{% else %}
;RescanDatabaseOnSave 1
{% endif %}

# Automatically add new interfaces not found in the database to monitoring.
# 0 = disabled, 1 = enabled.
{% if vnstat_always_add_new_interfaces is defined and vnstat_always_add_new_interfaces|length > 0 %}
AlwaysAddNewInterfaces {{ vnstat_always_add_new_interfaces }}
{% else %}
;AlwaysAddNewInterfaces 0
{% endif %}

# Day of the month when monthly data rotation occurs (1-31).
{% if vnstat_month_rotate is defined and vnstat_month_rotate|length > 0 %}
MonthRotate    {{ vnstat_month_rotate }}
{% else %}
;MonthRotate    1
{% endif %}

# Whether month rotation affects yearly data accumulation.
# 0 = disabled, 1 = enabled.
{% if vnstat_month_rotate_affects_years is defined and vnstat_month_rotate_affects_years|length > 0 %}
MonthRotateAffectsYears {{ vnstat_month_rotate_affects_years }}
{% else %}
;MonthRotateAffectsYears 0
{% endif %}

# Enable filesystem disk space check before writing to database.
# 0 = disabled, 1 = enabled.
{% if vnstat_check_disk_space is defined and vnstat_check_disk_space|length > 0 %}
CheckDiskSpace {{ vnstat_check_disk_space }}
{% else %}
;CheckDiskSpace 1
{% endif %}

# Allowed boot time variation in seconds between updates.
# Helps handle clock jumps after suspend/boot.
{% if vnstat_boot_variation is defined and vnstat_boot_variation|length > 0 %}
BootVariation  {{ vnstat_boot_variation }}
{% else %}
;BootVariation  15
{% endif %}

# Create database entries for interfaces with no traffic.
# 0 = disabled, 1 = enabled.
{% if vnstat_trafficless_entries is defined and vnstat_trafficless_entries|length > 0 %}
TrafficlessEntries {{ vnstat_trafficless_entries }}
{% else %}
;TrafficlessEntries 1
{% endif %}

# Minutes to wait for system clock sync during startup if time is in future.
{% if vnstat_time_sync_wait is defined and vnstat_time_sync_wait|length > 0 %}
TimeSyncWait   {{ vnstat_time_sync_wait }}
{% else %}
;TimeSyncWait   5
{% endif %}

# Interval in minutes for bandwidth detection checks.
# 0 = disabled.
{% if vnstat_bandwidth_detection_interval is defined and vnstat_bandwidth_detection_interval|length > 0 %}
BandwidthDetectionInterval {{ vnstat_bandwidth_detection_interval }}
{% else %}
;BandwidthDetectionInterval 5
{% endif %}

# Force data save to database when interface status changes.
# 0 = disabled, 1 = enabled.
{% if vnstat_save_on_status_change is defined and vnstat_save_on_status_change|length > 0 %}
SaveOnStatusChange {{ vnstat_save_on_status_change }}
{% else %}
;SaveOnStatusChange 1
{% endif %}

# Logging method.
# 0 = disabled, 1 = logfile, 2 = syslog.
{% if vnstat_use_logging is defined and vnstat_use_logging|length > 0 %}
UseLogging     {{ vnstat_use_logging }}
{% else %}
;UseLogging     2
{% endif %}

# Create necessary directories (database dir, log dir, pid dir) if they don't exist.
# 0 = disabled, 1 = enabled.
{% if vnstat_create_dirs is defined and vnstat_create_dirs|length > 0 %}
CreateDirs     {{ vnstat_create_dirs }}
{% else %}
;CreateDirs     1
{% endif %}

# Update file ownership of database/log files if needed.
# 0 = disabled, 1 = enabled.
{% if vnstat_update_file_owner is defined and vnstat_update_file_owner|length > 0 %}
UpdateFileOwner {{ vnstat_update_file_owner }}
{% else %}
;UpdateFileOwner 1
{% endif %}

# Path to the log file if UseLogging is set to 1.
{% if vnstat_log_file is defined and vnstat_log_file|length > 0 %}
LogFile        "{{ vnstat_log_file }}"
{% else %}
;LogFile        "/var/log/vnstat/vnstat.log"
{% endif %}

# Path to the daemon PID/lock file.
{% if vnstat_pid_file is defined and vnstat_pid_file|length > 0 %}
PidFile        "{{ vnstat_pid_file }}"
{% else %}
;PidFile        "/var/run/vnstat/vnstat.pid"
{% endif %}

# Counter size mode.
# 1 = 64-bit, 0 = 32-bit, -1 = old logic, -2 = auto.
{% if vnstat_64bit_interface_counters is defined and vnstat_64bit_interface_counters|length > 0 %}
64bitInterfaceCounters {{ vnstat_64bit_interface_counters }}
{% else %}
;64bitInterfaceCounters -2
{% endif %}

# Use SQLite Write-Ahead Logging (WAL) mode for the database.
# 0 = disabled, 1 = enabled. Improves concurrency.
{% if vnstat_database_write_ahead_logging is defined and vnstat_database_write_ahead_logging|length > 0 %}
DatabaseWriteAheadLogging {{ vnstat_database_write_ahead_logging }}
{% else %}
;DatabaseWriteAheadLogging 0
{% endif %}

# SQLite synchronous flag.
# -1 = auto, 0 = off, 1 = normal, 2 = full, 3 = extra.
# 'normal' is usually sufficient for vnstat.
{% if vnstat_database_synchronous is defined and vnstat_database_synchronous|length > 0 %}
DatabaseSynchronous {{ vnstat_database_synchronous }}
{% else %}
;DatabaseSynchronous -1
{% endif %}

# Use UTC for database timestamps instead of local timezone.
# 0 = disabled, 1 = enabled. Recommended for servers.
{% if vnstat_use_utc is defined and vnstat_use_utc|length > 0 %}
UseUTC         {{ vnstat_use_utc }}
{% else %}
;UseUTC         0
{% endif %}

###############################################################################
# vnstati Settings (Image Generation)
###############################################################################

# Show rates with hours in vnstati output.
# 0 = disabled, 1 = enabled.
{% if vnstat_hourly_rate is defined and vnstat_hourly_rate|length > 0 %}
HourlyRate     {{ vnstat_hourly_rate }}
{% else %}
;HourlyRate     1
{% endif %}

# Show rate in summary section of vnstati output.
# 0 = disabled, 1 = enabled.
{% if vnstat_summary_rate is defined and vnstat_summary_rate|length > 0 %}
SummaryRate    {{ vnstat_summary_rate }}
{% else %}
;SummaryRate    1
{% endif %}

# Use transparent background in vnstati generated images.
# 0 = disabled, 1 = enabled.
{% if vnstat_transparent_bg is defined and vnstat_transparent_bg|length > 0 %}
TransparentBg  {{ vnstat_transparent_bg }}
{% else %}
;TransparentBg  0
{% endif %}

# Use large fonts in vnstati images.
# 0 = disabled, 1 = enabled.
{% if vnstat_large_fonts is defined and vnstat_large_fonts|length > 0 %}
LargeFonts     {{ vnstat_large_fonts }}
{% else %}
;LargeFonts     0
{% endif %}

# Adjust line spacing in vnstati images.
{% if vnstat_line_spacing_adjustment is defined and vnstat_line_spacing_adjustment|length > 0 %}
LineSpacingAdjustment {{ vnstat_line_spacing_adjustment }}
{% else %}
;LineSpacingAdjustment 0
{% endif %}

# Image scale percentage for vnstati output.
{% if vnstat_image_scale is defined and vnstat_image_scale|length > 0 %}
ImageScale     {{ vnstat_image_scale }}
{% else %}
;ImageScale     100
{% endif %}

# Number of 5-minute results in 5-minute graphs.
{% if vnstat_5_minute_graph_result_count is defined and vnstat_5_minute_graph_result_count|length > 0 %}
5MinuteGraphResultCount {{ vnstat_5_minute_graph_result_count }}
{% else %}
;5MinuteGraphResultCount 576
{% endif %}

# Height in pixels for 5-minute graphs.
{% if vnstat_5_minute_graph_height is defined and vnstat_5_minute_graph_height|length > 0 %}
5MinuteGraphHeight {{ vnstat_5_minute_graph_height }}
{% else %}
;5MinuteGraphHeight 300
{% endif %}

# Hourly graph mode.
# 0 = 24h sliding window, 1 = from midnight.
{% if vnstat_hourly_graph_mode is defined and vnstat_hourly_graph_mode|length > 0 %}
HourlyGraphMode {{ vnstat_hourly_graph_mode }}
{% else %}
;HourlyGraphMode 0
{% endif %}

# Summary graph orientation.
# 0 = hours, 1 = 5 minutes.
{% if vnstat_summary_graph is defined and vnstat_summary_graph|length > 0 %}
SummaryGraph   {{ vnstat_summary_graph }}
{% else %}
;SummaryGraph   0
{% endif %}

# Traffic estimate bar style.
# 0 = not shown, 1 = continuation of existing bar, 2 = separate bar.
{% if vnstat_estimate_style is defined and vnstat_estimate_style|length > 0 %}
EstimateStyle  {{ vnstat_estimate_style }}
{% else %}
;EstimateStyle  1
{% endif %}

# Show rate in bar column if OutputStyle is 3.
# 0 = disabled, 1 = enabled.
{% if vnstat_bar_column_shows_rate is defined and vnstat_bar_column_shows_rate|length > 0 %}
BarColumnShowsRate {{ vnstat_bar_column_shows_rate }}
{% else %}
;BarColumnShowsRate 0
{% endif %}

# Image Colors (Hex Codes) for vnstati.

# Background color
{% if vnstat_cbackground is defined and vnstat_cbackground|length > 0 %}
CBackground    "{{ vnstat_cbackground }}"
{% else %}
;CBackground    "FFFFFF"
{% endif %}

# Edge color
{% if vnstat_cedge is defined and vnstat_cedge|length > 0 %}
CEdge          "{{ vnstat_cedge }}"
{% else %}
;CEdge          "AEAEAE"
{% endif %}

# Header background color
{% if vnstat_cheader is defined and vnstat_cheader|length > 0 %}
CHeader        "{{ vnstat_cheader }}"
{% else %}
;CHeader        "606060"
{% endif %}

# Header title text color
{% if vnstat_cheader_title is defined and vnstat_cheader_title|length > 0 %}
CHeaderTitle   "{{ vnstat_cheader_title }}"
{% else %}
;CHeaderTitle   "FFFFFF"
{% endif %}

# Header date text color
{% if vnstat_cheader_date is defined and vnstat_cheader_date|length > 0 %}
CHeaderDate    "{{ vnstat_cheader_date }}"
{% else %}
;CHeaderDate    "FFFFFF"
{% endif %}

# Main text color
{% if vnstat_ctext is defined and vnstat_ctext|length > 0 %}
CText          "{{ vnstat_ctext }}"
{% else %}
;CText          "000000"
{% endif %}

# Line color (traffic bars)
{% if vnstat_cline is defined and vnstat_cline|length > 0 %}
CLine          "{{ vnstat_cline }}"
{% else %}
;CLine          "B0B0B0"
{% endif %}

# Light line color (grid/axes)
{% if vnstat_cline_l is defined and vnstat_cline_l|length > 0 %}
CLineL         "{{ vnstat_cline_l }}"
{% else %}
;CLineL         "-"
{% endif %}

# RX traffic color (Receive)
{% if vnstat_crx is defined and vnstat_crx|length > 0 %}
CRx            "{{ vnstat_crx }}"
{% else %}
;CRx            "92CF00"
{% endif %}

# TX traffic color (Transmit)
{% if vnstat_ctx is defined and vnstat_ctx|length > 0 %}
CTx            "{{ vnstat_ctx }}"
{% else %}
;CTx            "606060"
{% endif %}

# RX dotted line color
{% if vnstat_crxd is defined and vnstat_crxd|length > 0 %}
CRxD           "{{ vnstat_crxd }}"
{% else %}
;CRxD           "-"
{% endif %}

# TX dotted line color
{% if vnstat_ctxd is defined and vnstat_ctxd|length > 0 %}
CTxD           "{{ vnstat_ctxd }}"
{% else %}
;CTxD           "-"
{% endif %}