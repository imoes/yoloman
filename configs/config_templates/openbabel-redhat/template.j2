# OpenBabel environment configuration generated by Ansible
# This file sets the default library and data directories for OpenBabel tools.

# Path to the OpenBabel library directory.
# Used to locate shared libraries (e.g., plugins) at runtime.
# Default: /usr/lib64/openbabel3
setenv BABEL_LIBDIR {{ babel_libdir | default('/usr/lib64/openbabel3') }}

# Path to the OpenBabel data directory.
# Used to locate chemical data files (formats, atom types, etc.).
# Default: /usr/share/openbabel
setenv BABEL_DATADIR {{ babel_datadir | default('/usr/share/openbabel') }}
