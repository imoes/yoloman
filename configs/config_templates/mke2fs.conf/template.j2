# mke2fs.conf - Configuration file for mke2fs (mkfs.ext2/3/4)
# This file controls default filesystem parameters used by mke2fs.
# See mke2fs(8) and mke2fs.conf(5) for full documentation.

[defaults]
{% if enable_plugins is defined and enable_plugins %}# Enable optional plugins for extended features
{% endif %}{{ 'base_features = ' + defaults.base_features | default('has_journal,extent,huge_file,flex_bg,uninit_bg,dir_nlink,extra_isize') | to_json }}
{% if defaults.block_size is defined %}# Block size in bytes (default: 4096)
block_size = {{ defaults.block_size }}
{% endif %}{{ 'default_mntopts = ' + defaults.default_mntopts | default('acl,user_xattr') | to_json }}
# Enable user ACLs and extended attributes by default in mount options

[fs_types]
# Filesystem type configurations — customize per use case
{% for fs_type in fs_types %}[fs_types.{{ fs_type.name }}]
# Configuration for {{ fs_type.name }} filesystem type
{% if fs_type.features is defined %}features = {{ fs_type.features | to_json }}
{% endif %}{{ 'block_size = ' + fs_type.block_size | default(0) | to_json }}
{{ 'inode_size = ' + fs_type.inode_size | default(0) | to_json }}
{{ 'inode_ratio = ' + fs_type.inode_ratio | default(0) | to_json }}
{% if fs_type.fragment_size is defined %}fragment_size = {{ fs_type.fragment_size }}
{% endif %}{{ 'reserve_ratio = ' + fs_type.reserve_ratio | default(5) | to_json }}
{% if fs_type.journal_size is defined %}journal_size = {{ fs_type.journal_size }}
{% endif %}
{% endfor %}

[options]
# Optional tuning parameters
{{ 'journal_dev = ' + options.journal_dev | default('') | to_json }}
{{ 'root_dir = ' + options.root_dir | default('') | to_json }}
# For filesystems where root directory should be pre-populated from a template tree
