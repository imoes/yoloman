{
  "approx_cache_root": "/var/cache/approx",
  "compress_downloads": true,
  "log_level": 1,
  "allowed_networks": [
    "127.0.0.0/8",
    "10.0.0.0/8"
  ],
  "mirrors": [
    {
      "type": "deb",
      "suite": "stable",
      "url": "http://deb.debian.org/debian"
    },
    {
      "type": "deb",
      "suite": "stable-updates",
      "url": "http://deb.debian.org/debian"
    },
    {
      "type": "deb",
      "suite": "security",
      "url": "http://security.debian.org/debian-security"
    }
  ],
  "upstream_proxy": "",
  "local_hostname": "",
  "disabled_architectures": [],
  "stale_age": 86400,
  "cache_size_limit_mb": 102400,
  "listen_addresses": [
    "127.0.0.1",
    "::1"
  ],
  "listen_port": 9999
}
