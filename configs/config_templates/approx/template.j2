# Default timeout (seconds) for connections to upstream mirrors
Timeout 30

# Maximum number of simultaneous connections to upstream
MaxConnections 10

# Default prefix for cached archives (usually /var/cache/approx)
Root {{ approx_cache_root }}

# Enable/disable compression of downloaded files (gzip)
{{ 'Compress' if compress_downloads else '#Compress' }}

# Log level: 0=quiet, 1=normal, 2=verbose, 3=debug
LogLev {{ log_level }}

# Local network(s) allowed to use this proxy (CIDR or IP)
{% for net in allowed_networks %}Allow {{ net }}
{% endfor %}

# Upstream Debian mirrors to use — each entry maps a suite/type to a mirror URL
{% for mirror in mirrors %}{{ mirror.type | upper }} {{ mirror.suite }} {{ mirror.url }}
{% endfor %}

# Optional: Upstream proxy for outgoing HTTP/HTTPS traffic (if needed)
{% if upstream_proxy %}Proxy {{ upstream_proxy }}
{% endif %}

# Optional: Local hostname to advertise in HTTP headers (for reverse proxy setups)
{% if local_hostname %}Host {{ local_hostname }}
{% endif %}

# Optional: Disable certain architectures to save disk space
{% for arch in disabled_architectures %}NoArch {{ arch }}
{% endfor %}

# Optional: Maximum age (in seconds) for stale cache entries before refresh
{% if stale_age %}StaleAge {{ stale_age }}
{% endif %}

# Optional: Cache size limit (in MB); 0 = unlimited
{% if cache_size_limit_mb is defined %}MaxCache {{ cache_size_limit_mb }}
{% endif %}

# Optional: Listen address(es) and port
{% for addr in listen_addresses %}Listen {{ addr }}:{{ listen_port }}
{% endfor %}
