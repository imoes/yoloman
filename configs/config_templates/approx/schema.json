{
  "approx_cache_root": {
    "type": "string",
    "default": "/var/cache/approx",
    "description": "Top-level directory where Approx stores cached Debian packages."
  },
  "approx_interval": {
    "type": "number",
    "default": 60,
    "description": "Interval (in seconds) between cache refresh attempts."
  },
  "approx_max_rate": {
    "type": "string",
    "default": "unlimited",
    "description": "Maximum download rate (e.g., '100k', '1m') or 'unlimited'."
  },
  "approx_max_redirects": {
    "type": "number",
    "default": 5,
    "description": "Maximum number of HTTP redirects to follow."
  },
  "approx_user": {
    "type": "string",
    "default": "approx",
    "description": "User under which Approx runs."
  },
  "approx_group": {
    "type": "string",
    "default": "approx",
    "description": "Group under which Approx runs."
  },
  "approx_syslog": {
    "type": "string",
    "default": "daemon",
    "description": "Syslog facility to use."
  },
  "approx_pdiffs": {
    "type": "bool",
    "default": true,
    "description": "Use pdiffs (patch diffs) when available."
  },
  "approx_offline": {
    "type": "bool",
    "default": false,
    "description": "If true, do not attempt network access (use cached data only)."
  },
  "approx_max_wait": {
    "type": "number",
    "default": 10,
    "description": "Maximum time (in seconds) to wait for a lock."
  },
  "approx_curl_path": {
    "type": "string",
    "default": "/usr/bin/curl",
    "description": "Path to the curl binary."
  },
  "approx_verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose logging."
  },
  "approx_debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug logging."
  }
}
