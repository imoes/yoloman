{
 "global_options": {
  "bootfile_name": "coredhcp.pxe",
  "vendor_class_id": "CoreDHCP-Server"
 },
 "leases": {
  "backend": "file",
  "path": "/var/lib/coredhcp/leases.dat"
 },
 "plugins": [
  "builtin:dns",
  "builtin:ntp",
  "builtin:file"
 ],
 "server": {
  "address": ":67",
  "ipv6_enabled": true,
  "log_level": "info"
 },
 "subnets": [
  {
   "dns_servers": [
    "10.0.0.2",
    "8.8.8.8"
   ],
   "gateway": "10.0.0.1",
   "network": "10.0.0.0",
   "ntp_servers": [
    "10.0.0.3"
   ],
   "options": {
    "bootfile_name": "pxelinux.0",
    "vendor_class_id": "PXEClient"
   },
   "prefix": 24,
   "range": {
    "end": "10.0.0.200",
    "start": "10.0.0.100"
   }
  },
  {
   "gateway": "192.168.42.1",
   "network": "192.168.42.0",
   "range": {
    "end": "192.168.42.250",
    "start": "192.168.42.10"
   }
  }
 ]
}
