# EDAC (Error Detection And Correction) Utils Configuration
# This template configures the EDAC utils service, specifically controlling which driver
# is manually loaded when the automatic detection fails.
#
# Schema Field: EDAC_DRIVER
# Description: Desired EDAC driver to be manually loaded by the init.d script when auto-loading fails.
# Default: '' (empty string, meaning no specific driver is forced)

# EDAC Motherboard DIMM labels Database file.
#
# $Id$
#
#  Vendor-name and model-name are found from the program 'dmidecode'
#  labels are found from the silk screen on the motherboard.
#
#Vendor: <vendor-name>
#  Model: <model-name>
#    <label>:  <mc>.<row>.<channel>
#
# Load the specified driver if automatic loading fails.
# If empty, no manual driver loading is attempted.
{{ EDAC_DRIVER | default('') }}