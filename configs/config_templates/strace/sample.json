{
  "command": "/usr/bin/nginx -g 'daemon off;'",
  "follow_forks": true,
  "daemonize": false,
  "attach_pids": [],
  "output_file": "/tmp/nginx_trace.log",
  "output_append": false,
  "output_separately": false,
  "trace_set": [
    "network",
    "read",
    "write"
  ],
  "string_limit": 128,
  "syscall_limit": 0,
  "kill_on_exit": true,
  "quiet": false,
  "run_as_user": "www-data",
  "environment_vars": [
    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin",
    "LD_PRELOAD=/usr/lib/debug.so"
  ]
}
