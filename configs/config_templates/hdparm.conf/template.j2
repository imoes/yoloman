# hdparm.conf — Debian configuration for disk power management and tuning
# This file is processed by udev and/or /lib/udev/hdparm to apply hdparm options
# to block devices on boot or when devices are inserted.
#
# Options defined *outside* any 'DEV {...}' block apply to *all* drives.
# Options defined *inside* a 'DEV {...}' block apply only to that specific device.
#
# Each line must contain a single option (directive) with optional value.
# Lines with only whitespace or starting with # are ignored.
# No inline comments supported; avoid trailing comments.
#
# Example structure:
#   global_option value
#   DEV {
#     device_specific_option value
#   }
#
# IMPORTANT: Misconfigured hdparm options may cause data loss or hardware instability.

# Enable acoustic management (AAM) — controls acoustic noise by reducing drive head movement speed.
# Value: 0–254 (0 = disable, 1–127 = quiet, 128–254 = performance); default 128.
acoustic = {{ acoustic_management | default(128) }}

# Enable Advanced Power Management (APM) — reduces power consumption by spinning down or idling.
# Value: 1–254 (1 = minimum, 254 = maximum); 255 = disable. Default 128 on many systems.
apm = {{ apm_level | default(128) }}

# Enable disk write-caching — improves performance but may increase data loss risk on power failure.
# Value: on/off or 1/0. Enabled by default on most drives unless explicitly disabled.
write_cache = {{ write_cache | default('on') }}

# Enable/disable aggressive idle spindown (standby) — puts drive into low-power mode after inactivity.
# Value: seconds (0–240 or multiples up to 7200 via special encodings); 0 = disabled.
# Note: Long delays (>240s) require encoding like `240:7200` or use `standby` via udev rules instead.
standby = {{ standby_timeout | default(60) }}

# Set the I/O scheduler queue depth — adjusts number of queued requests for better throughput.
# Not all devices support this; typically only for SATA/SCSI. Value: 1–256.
# Usually left at driver default unless tuning for specific workloads.
deep = {{ deep_sleep | default(0) }}

# Set the number of sectors for read-ahead — improves sequential read performance.
# Value: number of 512-byte sectors (e.g., 256 = 128KB); 0 = system default.
# Modern kernels often auto-tune; only adjust for workloads with known access patterns.
readahead = {{ read_ahead_sectors | default(256) }}

# Enable/disable DMA — Direct Memory Access allows faster data transfer without CPU involvement.
# Value: on/off or 1/0. Should usually be `on`; disabling is only for troubleshooting.
dma = {{ dma_enabled | default('on') }}

# Enable multi-sector I/O — allows reading/writing multiple sectors in one command.
# Value: 1–16 sectors. Higher values improve throughput for large I/O but may increase latency.
# Modern drives often use larger values (e.g., 16), but older drives may only support up to 4.
multi_count = {{ multi_sector_io | default(16) }}

