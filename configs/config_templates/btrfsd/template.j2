#
# Configuration for Btrfsd
#
# Self-documenting template: every variable is sourced from Ansible facts/vars
# with explicit defaults matching the schema. See the Ansible role's defaults
# or group_vars for the actual values.
#
# Settings can be adjusted per mountpoint,
# if no settings are defined for a mountpoint,
# the ones from the "default" section are used.
# Check man btrfsd(8) for more informtion.

[default]
# Email address to send filesystem error notifications to.
# Schema default: '' (empty string).
mail_address={{ mail_address | default('') }}

# Approximate interval for statistics collection (e.g., 1h, 1d).
# Schema default: '1h'. Allowed: '1h', 'never'.
stats_interval={{ stats_interval | default('1h') }}

# Approximate interval for scrub operations (e.g., 1M = once per month).
# Schema default: '1M'. Allowed: '1M', '2M', 'never'.
scrub_interval={{ scrub_interval | default('1M') }}

# Approximate interval for balance operations (e.g., never, 1w).
# Schema default: 'never'. Allowed: 'never', '3M'.
balance_interval={{ balance_interval | default('never') }}