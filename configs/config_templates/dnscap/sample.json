{
  "debug": false,
  "sandbox": true,
  "daemonize": true,
  "pid_file": "/run/dnscap/dnscap.pid",
  "user": "dnscap",
  "group": "dnscap",
  "only_read_files": false,
  "start_time": "",
  "stop_time": "",
  "interfaces": [
    "any"
  ],
  "vlan_filter": "",
  "vlan_inclusive": "",
  "input_file": "",
  "no_promisc": false,
  "monitor_mode": false,
  "immediate_mode": false,
  "pcap_buffer_size": 1048576,
  "use_layers": true,
  "diagnostic_output": false,
  "dump_format": "pcap",
  "dump_base": "/var/lib/dnscap/capture",
  "dump_suffix": ".pcap.gz",
  "flush_per_packet": false,
  "time_interval": 1800,
  "packet_limit": 0,
  "byte_limit": 0,
  "post_rotate_cmd": "/usr/local/bin/dnscap-upload",
  "bpf_filter": "port 53",
  "bpf_hosts_all": false,
  "suppress_ipv6_filter": false,
  "capture_fragments": false,
  "capture_tcp": false,
  "capture_icmp": false,
  "defrag_ipv4": false,
  "defrag_ipv6": false,
  "max_ipv4_frags": 1024,
  "max_ipv4_frags_per_pkt": 4,
  "max_ipv6_frags": 1024,
  "max_ipv6_frags_per_pkt": 4,
  "parse_ongoing_tcp": true,
  "allow_reset_tcpstate": false,
  "reassemble_tcp": false,
  "tcp_fault_reset": 2,
  "reassemble_tcp_bfb": false,
  "dns_port": 53,
  "msg_types": "q",
  "response_errors": "n",
  "hide_party": "i",
  "direction": "",
  "initiators": [],
  "responders": [],
  "not_initiators": [],
  "not_responders": [],
  "drop_responders": [],
  "qname_patterns": [],
  "exclude_patterns": [],
  "qtype_include": "",
  "qtype_exclude": "",
  "plugins": [
    {
      "plugin_path": "/usr/lib/x86_64-linux-gnu/dnscap/anonmask.so"
    },
    {
      "plugin_path": "/usr/lib/x86_64-linux-gnu/dnscap/eventlog.so"
    }
  ],
  "cbor_chunk_size": 65536,
  "cds_cbor_size": 65536,
  "cds_msg_size": 65536,
  "cds_max_rlabels": 100000,
  "cds_min_rlabel_size": 4,
  "cds_use_rdata_index": true,
  "cds_rdata_index_min_size": 8,
  "cds_use_rdata_rindex": true,
  "cds_rdata_rindex_size": 50000,
  "cds_rdata_rindex_min_size": 8
}
