{
  "output_dir": {
    "type": "string",
    "default": "/output",
    "description": "Top-level directory where recovered files are written"
  },
  "log_file": {
    "type": "string",
    "default": "/foremost.log",
    "description": "Path to the log file (relative or absolute); empty string disables logging"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Suppress all non-error output"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Print detailed information about recovery process"
  },
  "recursive": {
    "type": "bool",
    "default": true,
    "description": "Whether to recursively scan subdirectories in the input source"
  },
  "max_size_kb": {
    "type": "number",
    "default": 0,
    "description": "Maximum size (in KB) for recovered files; 0 means unlimited"
  },
  "offset_bytes": {
    "type": "number",
    "default": 0,
    "description": "Number of bytes to skip before searching for file signatures (for aligned recovery)"
  },
  "file_types": {
    "type": "list",
    "default": [
