    "description": "List of file type definitions to recover. Each entry maps an extension to metadata needed for signature-based recovery.",
    "items": {
      "ext": {
        "type": "string",
        "description": "File extension (e.g., 'jpg')"
      },
      "desc": {
        "type": "string",
        "description": "Human-readable description (e.g., 'JPEG image')"
      },
      "sig": {
        "type": "string",
        "description": "Hex-encoded signature (magic bytes) for file detection; use '*' for wildcard (e.g., 'FFD8FF' or '*')"
      },
      "len": {
        "type": "number",
        "description": "Expected file length in bytes; 0 means variable/unlimited length"
      },
      "start": {
        "type": "number",
        "description": "Offset in bytes where the signature begins (e.g., 0 for start of file, 257 for tar)"
      }
    }
  }
