{
  "base_dir": "/var/lib/mlmmj",
  "web_user": "mlmmj",
  "web_group": "mlmmj",
  "sendmail_path": "/usr/sbin/sendmail",
  "default_lang": "en",
  "default_charset": "utf-8",
  "default_moderated": false,
  "default_sub_policy": "confirm",
  "default_digest_mode": "normal",
  "default_digest_freq": 1,
  "max_attach_size": 5242880,
  "num_workers": 3,
  "sanitize_html": true,
  "html_sanitization_rules_path": "/etc/mlmmj/html-sanitize.rules",
  "log_level": 1,
  "log_dir": "/var/log/mlmmj",
  "archive": true,
  "archive_dir": "archive",
  "subscriber_confirm": true,
  "welcome": true,
  "farewell": true,
  "reject_notice": true,
  "admin_notify": true,
  "verify_sender": false,
  "verify_recipient": false,
  "hide_list": false,
  "auto_create": true,
  "hostname": "lists.myorg.org",
  "web_url": "https://lists.myorg.org",
  "archive_url": "https://lists.myorg.org/archives",
  "default_bounce_handling": "notify",
  "max_bounces": 5,
  "bounce_hold": 172800,
  "mime_digest": true,
  "daily_digest": false,
  "digest_include_msgid": true,
  "digest_include_headers": false,
  "extra_headers": [
    {
      "header": "List-Unsubscribe",
      "value": "<mailto:mlmmj-unsubscribe@lists.myorg.org>"
    },
    {
      "header": "List-Help",
      "value": "<mailto:mlmmj-help@lists.myorg.org>"
    }
  ],
  "allowed_domains": [
    "myorg.org",
    "myorg.net"
  ],
  "banned_senders": [
    "^bounce.*@spam-russian\\.com$",
    "spam@.*"
  ],
  "allowed_attachment_types": [
    "application/pdf",
    "image/png",
    "image/jpeg"
  ],
  "disabled_commands": [
    "subscribe",
    "unsubscribe"
  ]
}
