# deluge-web configuration
# Generated from deluge-web(1) man page
# Site-specific configuration values are parameterized below
[web]
interface = {{ interface|default('127.0.0.1') }}
port = {{ port|default(8112) }}
base_path = {{ base_path|default('') }}
ssl = {{ 'true' if ssl else 'false' }}

[logging]
level = {{ log_level|default('error') }}
logfile = {{ logfile|default('') }}
rotate = {{ 'true' if log_rotate else 'false' }}
max_log_size = {{ max_log_size|default('2M') }}

[process]
pidfile = {{ pidfile|default('') }}
user = {{ user|default('') }}
group = {{ group|default('') }}
do_not_daemonize = {{ 'true' if do_not_daemonize else 'false' }}
