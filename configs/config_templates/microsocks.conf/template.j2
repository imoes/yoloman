[# microsocks configuration file — INI-style, supports comments with #
]
# listen address — IP or hostname to bind the SOCKS5 proxy to
listen_addr = {{ listen_addr }}

# listen port — TCP port for incoming SOCKS5 connections
listen_port = {{ listen_port }}

# workers — number of worker threads (0 = automatic based on CPU cores)
workers = {{ workers }}

# daemonize — whether to run as a background process (true/false)
daemonize = {{ daemonize | lower }}

# pidfile — path to write PID file when daemonized
pidfile = {{ pidfile }}

# loglevel — logging verbosity: 0=error, 1=warn, 2=info, 3=debug
loglevel = {{ loglevel }}

# logstream — output log to 'stderr', 'syslog', or a file path (e.g., /var/log/microsocks.log)
logstream = {{ logstream }}

{% if auth_enabled %}
# authentication — credentials for SOCKS5 user/password auth
auth = {{ auth_users | join(',') }}
{% endif %}

# timeout — idle connection timeout in seconds
timeout = {{ timeout }}

# maxconn — maximum number of simultaneous connections (0 = no limit)
maxconn = {{ maxconn }}

# allow_ipv4 — allow IPv4 connections (true/false)
allow_ipv4 = {{ allow_ipv4 | lower }}

# allow_ipv6 — allow IPv6 connections (true/false)
allow_ipv6 = {{ allow_ipv6 | lower }}

# bind_out — IP to bind outgoing connections to (empty = auto)
bind_out = {{ bind_out }}

# chroot — chroot directory (empty = no chroot)
chroot = {{ chroot }}

# user — drop privileges to this user after startup (empty = keep running user)
user = {{ user }}

# group — drop privileges to this group after startup (empty = keep running group)
group = {{ group }}
