{
  "listen_addr": "0.0.0.0",
  "listen_port": 1080,
  "workers": 4,
  "daemonize": true,
  "pidfile": "/run/microsocks/microsocks.pid",
  "loglevel": 2,
  "logstream": "/var/log/microsocks/microsocks.log",
  "auth_enabled": true,
  "auth_users": [
    "alice:secretpass",
    "bob:anotherpass"
  ],
  "timeout": 120,
  "maxconn": 1000,
  "allow_ipv4": true,
  "allow_ipv6": false,
  "bind_out": "",
  "chroot": "/var/lib/microsocks",
  "user": "microsocks",
  "group": "microsocks"
}
