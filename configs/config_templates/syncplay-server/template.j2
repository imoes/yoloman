# Configuration file for SyncPlay server certificate handling (Certbot hook)
#
# This setting is primarily used by external scripts (such as Certbot hooks)
# to identify which domain this server is configured for. This is useful for
# automatically renewing TLS certificates for the SyncPlay web interface.
#
# Note: SyncPlay itself does not typically serve web content directly; this
# domain value is informational for automation purposes.
DOMAIN={{ DOMAIN | default('') }}
