# Policy configuration for policy-rcd declarative deny-all.
# This file controls which packages/services are allowed to start their services
# during package installation or upgrade.
# Format: <package_regex>	<service_regex>	<action>
# For details, see service-policy.d(5).

# Regular expression matching package names to apply the policy to.
# Default: '.*' (all packages)
{{ policy_regex | default('.*') }}	{# policy_regex #}

# Regular expression matching service names to apply the policy to.
# Default: '.*' (all services)
{{ sub_regex | default('.*') }}	{# sub_regex #}

# Action to take: allow, deny, or force-reload.
# Default: 'deny'
{{ action | default('deny') }}	{# action #}
