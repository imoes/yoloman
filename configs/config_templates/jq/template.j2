# Jq Configuration
# The jq filter expression to apply to input JSON.
filter: "{{ filter | default('.') }}"

# Output formatting

# If true, disables compact output (--compact-output is false), allowing pretty-printing.
compact_output: {{ compact_output | default(false) | lower }}

# If true, enables raw output (--raw-output) for string values.
raw_output: {{ raw_output | default(false) | lower }}

# If true, uses tabs for indentation (--tab).
tab_indent: {{ tab_indent | default(false) | lower }}

# Number of spaces for indentation (1-7) when using --indent.
indent_spaces: {{ indent_spaces | default(2) }}

# If true, sorts object keys in output (--sort-keys).
sort_keys: {{ sort_keys | default(false) | lower }}

# If true, forces ASCII output (--ascii-output).
ascii_output: {{ ascii_output | default(false) | lower }}

# If true, forces color output (--color-output).
color_output: {{ color_output | default(false) | lower }}

# If true, disables color output (--monochrome-output).
monochrome_output: {{ monochrome_output | default(false) | lower }}

# If true, slurps all input into a single array (--slurp).
slurp: {{ slurp | default(false) | lower }}

# If true, reads input as raw strings instead of JSON (--raw-input).
raw_input: {{ raw_input | default(false) | lower }}

# If true, reads no input and runs filter on null (--null-input).
null_input: {{ null_input | default(false) | lower }}

# List of arguments to pass to the jq program via --arg or --argjson.
{% for arg in (args | default([])) %}
arg_{{ loop.index0 }}:
  name: "{{ arg.name | default('') }}"
  value: "{{ arg.value | default('') }}"
{% endfor %}