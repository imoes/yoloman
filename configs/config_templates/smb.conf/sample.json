{
  "workgroup": "WORKGROUP",
  "server_string": "Samba Server",
  "security_mode": "user",
  "passdb_backend": "tdbsam",
  "log_level": 1,
  "log_file_path": "/var/log/samba/log.%m",
  "max_log_size_kb": 5000,
  "bind_interfaces_only": true,
  "interfaces": [
    "lo",
    "eth0"
  ],
  "hosts_allow": [
    "127.0.0.1"
  ],
  "hosts_deny": [
    "all"
  ],
  "server_min_protocol": "SMB2",
  "server_max_protocol": "SMB3",
  "max_connections": 100,
  "max_open_files": 16384,
  "socket_options": [
    "SO_RCVBUF=65536",
    "SO_SNDBUF=65536",
    "TCP_NODELAY"
  ],
  "time_server": false,
  "timezone": "UTC",
  "shares": [
    {
      "name": "homes",
      "path": "/home",
      "description": "Home directories",
      "browsable": true,
      "read_only": false,
      "guest_ok": false,
      "valid_users": [
        "%S"
      ],
      "create_mask": "0640",
      "directory_mask": "0750",
      "force_user": "%U",
      "force_group": "%U"
    }
  ],
  "nmbd_options": ""
}
