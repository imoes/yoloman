[global]
# Global server identification and security settings
workgroup = {{ workgroup }}
server string = {{ server_string }}
security = {{ security_mode }}
{% if security_mode in ['user', 'domain'] %}
# User authentication backend
passdb backend = {{ passdb_backend }}
{% endif %}
# Logging configuration
log level = {{ log_level }}
log file = {{ log_file_path }}
max log size = {{ max_log_size_kb }}

# Network and protocol settings
bind interfaces only = {{ bind_interfaces_only | lower }}
{% if bind_interfaces_only %}
interfaces = {{ interfaces | join(' ') }}
{% endif %}
hosts allow = {{ hosts_allow | join(', ') }}
hosts deny = {{ hosts_deny | join(', ') }}
{% if server_min_protocol %}
server min protocol = {{ server_min_protocol }}
{% endif %}
{% if server_max_protocol %}
server max protocol = {{ server_max_protocol }}
{% endif %}

# Performance tuning
max connections = {{ max_connections }}
{% if max_open_files is defined %}
max open files = {{ max_open_files }}
{% endif %}
socket options = {{ socket_options | join(' ') }}

# Time and timezone settings
time server = {{ time_server | lower }}
{% if timezone is defined %}
timezone = {{ timezone }}
{% endif %}

{% for share in shares %}
# {{ share.name }}: {{ share.description }}
[{{ share.name }}]
path = {{ share.path }}
comment = {{ share.description }}
browsable = {{ share.browsable | lower }}
read only = {{ share.read_only | lower }}
{% if share.guest_ok is defined %}
guest ok = {{ share.guest_ok | lower }}
{% endif %}
{% if share.valid_users %}
valid users = {{ share.valid_users | join(', ') }}
{% endif %}
{% if share.write_list %}
write list = {{ share.write_list | join(', ') }}
{% endif %}
{% if share.create_mask is defined %}
create mask = {{ share.create_mask }}
{% endif %}
{% if share.directory_mask is defined %}
directory mask = {{ share.directory_mask }}
{% endif %}
{% if share.force_user is defined %}
force user = {{ share.force_user }}
{% endif %}
{% if share.force_group is defined %}
force group = {{ share.force_group }}
{% endif %}
{% if share.vfs_objects %}
vfs objects = {{ share.vfs_objects | join(' ') }}
{% endif %}
{% for vfs_opt_name, vfs_opt_val in share.vfs_options.items() %}
{{ vfs_opt_name }} = {{ vfs_opt_val }}
{% endfor %}
{% endfor %}
