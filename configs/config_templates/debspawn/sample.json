{
  "OSTemplatesDir": "/var/lib/debspawn/images",
  "ResultsDir": "/var/lib/debspawn/results",
  "APTCacheDir": "/var/cache/debspawn/apt",
  "InjectedPkgsDir": "/var/lib/debspawn/injected-pkgs",
  "TempDir": "/var/tmp/debspawn",
  "DefaultBootstrapVariant": "buildd",
  "SyscallFilter": [
    "compat"
  ],
  "AllowUnsafePermissions": false,
  "CachePackages": true,
  "BootstrapTool": "mmdebstrap"
}
