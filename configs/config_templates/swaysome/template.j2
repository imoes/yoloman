# ==============================================================================
# SwaySome: Auto-generated Sway configuration for workspace management.
# ==============================================================================
# This file provides bindings for focusing and moving containers between workspaces,
# managing workspace groups, and initializing workspaces for all outputs.
#
# Schema: swaysome
# Description: Helper utility for managing workspaces in the Sway Wayland compositor.
# Note: This package has no network service and no external dependencies.
# ==============================================================================

{% set mod = mod | default("Mod4") %}

# ------------------------------------------------------------------------------
# Change focus between workspaces
# Bindings allow switching to specific workspaces by number (1-10, where 10 is 0).
# The --no-warn flag suppresses errors for bindings that might not exist in all
# default configurations or are added dynamically.
# ------------------------------------------------------------------------------

# Focus workspace 1
bindsym --no-warn {{ mod }}+1 exec "swaysome focus 1"
# Focus workspace 2
bindsym --no-warn {{ mod }}+2 exec "swaysome focus 2"
# Focus workspace 3
bindsym --no-warn {{ mod }}+3 exec "swaysome focus 3"
# Focus workspace 4
bindsym --no-warn {{ mod }}+4 exec "swaysome focus 4"
# Focus workspace 5
bindsym --no-warn {{ mod }}+5 exec "swaysome focus 5"
# Focus workspace 6
bindsym --no-warn {{ mod }}+6 exec "swaysome focus 6"
# Focus workspace 7
bindsym --no-warn {{ mod }}+7 exec "swaysome focus 7"
# Focus workspace 8
bindsym --no-warn {{ mod }}+8 exec "swaysome focus 8"
# Focus workspace 9
bindsym --no-warn {{ mod }}+9 exec "swaysome focus 9"
# Focus workspace 10 (bound to 0 key)
bindsym --no-warn {{ mod }}+0 exec "swaysome focus 0"

# ------------------------------------------------------------------------------
# Move containers between workspaces
# These bindings move the currently focused container to the target workspace.
# ------------------------------------------------------------------------------

# Move container to workspace 1
bindsym --no-warn {{ mod }}+Shift+1 exec "swaysome move 1"
# Move container to workspace 2
bindsym --no-warn {{ mod }}+Shift+2 exec "swaysome move 2"
# Move container to workspace 3
bindsym --no-warn {{ mod }}+Shift+3 exec "swaysome move 3"
# Move container to workspace 4
bindsym --no-warn {{ mod }}+Shift+4 exec "swaysome move 4"
# Move container to workspace 5
bindsym --no-warn {{ mod }}+Shift+5 exec "swaysome move 5"
# Move container to workspace 6
bindsym --no-warn {{ mod }}+Shift+6 exec "swaysome move 6"
# Move container to workspace 7
bindsym --no-warn {{ mod }}+Shift+7 exec "swaysome move 7"
# Move container to workspace 8
bindsym --no-warn {{ mod }}+Shift+8 exec "swaysome move 8"
# Move container to workspace 9
bindsym --no-warn {{ mod }}+Shift+9 exec "swaysome move 9"
# Move container to workspace 10
bindsym --no-warn {{ mod }}+Shift+0 exec "swaysome move 0"

# ------------------------------------------------------------------------------
# Focus workspace groups
# These bindings switch focus to a specific "group" of workspaces.
# Workspace groups are a logical container for organizing related workspaces.
# ------------------------------------------------------------------------------

# Focus workspace group 1
bindsym {{ mod }}+Alt+1 exec "swaysome focus-group 1"
# Focus workspace group 2
bindsym {{ mod }}+Alt+2 exec "swaysome focus-group 2"
# Focus workspace group 3
bindsym {{ mod }}+Alt+3 exec "swaysome focus-group 3"
# Focus workspace group 4
bindsym {{ mod }}+Alt+4 exec "swaysome focus-group 4"
# Focus workspace group 5
bindsym {{ mod }}+Alt+5 exec "swaysome focus-group 5"
# Focus workspace group 6
bindsym {{ mod }}+Alt+6 exec "swaysome focus-group 6"
# Focus workspace group 7
bindsym {{ mod }}+Alt+7 exec "swaysome focus-group 7"
# Focus workspace group 8
bindsym {{ mod }}+Alt+8 exec "swaysome focus-group 8"
# Focus workspace group 9
bindsym {{ mod }}+Alt+9 exec "swaysome focus-group 9"
# Focus workspace group 10
bindsym {{ mod }}+Alt+0 exec "swaysome focus-group 0"

# ------------------------------------------------------------------------------
# Move containers to other workspace groups
# These bindings move the focused container into the target workspace group.
# ------------------------------------------------------------------------------

# Move container to workspace group 1
bindsym {{ mod }}+Alt+Shift+1 exec "swaysome move-to-group 1"
# Move container to workspace group 2
bindsym {{ mod }}+Alt+Shift+2 exec "swaysome move-to-group 2"
# Move container to workspace group 3
bindsym {{ mod }}+Alt+Shift+3 exec "swaysome move-to-group 3"
# Move container to workspace group 4
bindsym {{ mod }}+Alt+Shift+4 exec "swaysome move-to-group 4"
# Move container to workspace group 5
bindsym {{ mod }}+Alt+Shift+5 exec "swaysome move-to-group 5"
# Move container to workspace group 6
bindsym {{ mod }}+Alt+Shift+6 exec "swaysome move-to-group 6"
# Move container to workspace group 7
bindsym {{ mod }}+Alt+Shift+7 exec "swaysome move-to-group 7"
# Move container to workspace group 8
bindsym {{ mod }}+Alt+Shift+8 exec "swaysome move-to-group 8"
# Move container to workspace group 9
bindsym {{ mod }}+Alt+Shift+9 exec "swaysome move-to-group 9"
# Move container to workspace group 10
bindsym {{ mod }}+Alt+Shift+0 exec "swaysome move-to-group 0"

# ------------------------------------------------------------------------------
# Move focused container to next/previous output (monitor)
# ------------------------------------------------------------------------------

# Move focused container to the next output
bindsym {{ mod }}+o exec "swaysome next-output"
# Move focused container to the previous output
bindsym {{ mod }}+Shift+o exec "swaysome prev-output"

# ------------------------------------------------------------------------------
# Move focused workspace group to next/previous output (monitor)
# ------------------------------------------------------------------------------

# Move focused workspace group to the next output
bindsym {{ mod }}+Alt+o exec "swaysome workspace-group-next-output"
# Move focused workspace group to the previous output
bindsym {{ mod }}+Alt+Shift+o exec "swaysome workspace-group-prev-output"

# ------------------------------------------------------------------------------
# Initialize workspaces for every screen
# This ensures that swaysome has created the initial workspace structures
# for all connected outputs.
# ------------------------------------------------------------------------------

exec "swaysome init 1"