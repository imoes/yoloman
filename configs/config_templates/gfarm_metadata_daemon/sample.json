{
  "listen_address": "0.0.0.0",
  "listen_port": 15345,
  "metadata_db_dir": "/var/lib/gfarm2/meta",
  "worker_threads": 12,
  "max_connections": 2048,
  "max_metadata_cache_size_mb": 512,
  "replication_enabled": true,
  "replication_targets": [
    {
      "host": "gfmd2.example.com",
      "port": 15345
    },
    {
      "host": "gfmd3.example.com",
      "port": 15345
    }
  ],
  "auth_method": "gssapi",
  "kerberos_keytab": "/etc/gfarm2/gfmd.keytab",
  "default_quota_mb": 10240,
  "access_log_enabled": true,
  "access_log_file": "/var/log/gfarm2/gfmd_access.log",
  "log_level": "notice",
  "log_file": "/var/log/gfarm2/gfmd.log",
  "ssl_enabled": true,
  "ssl_cert_file": "/etc/gfarm2/ssl/fullchain.pem",
  "ssl_key_file": "/etc/gfarm2/ssl/privkey.pem",
  "acl_enabled": true,
  "quota_enabled": true,
  "xattr_enabled": true
}
