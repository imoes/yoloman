{
  "DEBUG": {
    "type": "string",
    "default": "yes",
    "description": "Whether to enable debug mode (set -e)",
    "enum": [
      "yes",
      "no"
    ]
  },
  "OPENSTACK_CREDENTIALS": {
    "type": "string",
    "default": "/etc/oci-poc/openstack-credentials",
    "description": "Path to the OpenStack credentials file"
  },
  "SSH_KEY_PATH": {
    "type": "string",
    "default": "/etc/oci-poc/id_rsa",
    "description": "Path to the ssh public key for the deployment"
  },
  "AUTHORIZED_KEY_PATH": {
    "type": "string",
    "default": "/etc/oci-poc/authorized_keys",
    "description": "Path to the authorized keys file"
  },
  "CLUSTER_NAME": {
    "type": "string",
    "default": "cl1",
    "description": "Name of the cluster"
  },
  "DOMAIN_NAME": {
    "type": "string",
    "default": "example.com",
    "description": "Domain name"
  },
  "DUMMYNET_IFNAME_PREFIX": {
    "type": "string",
    "default": "ocidm",
    "description": "Prefix for dummy network interface names"
  },
  "DUMMYNET_BRIDGE_NAME": {
    "type": "string",
    "default": "br-oci",
    "description": "Name of the dummy network bridge"
  },
  "EXT_NETWORK_PREFIX": {
    "type": "string",
    "default": "192.168.200",
    "description": "Prefix for the external network"
  },
  "EXT_NETWORK_FIRST_IP": {
    "type": "string",
    "default": "200",
    "description": "First IP in the external network range"
  },
  "EXT_NETWORK_LAST_IP": {
    "type": "string",
    "default": "249",
    "description": "Last IP in the external network range"
  },
  "FLAVOR_PXE": {
    "type": "string",
    "default": "cpu2-ram6-disk20",
    "description": "Flavor for OCI PXE server"
  },
  "FLAVOR_CTRL": {
    "type": "string",
    "default": "cpu8-ram24-disk20",
    "description": "Flavor for CI controller roles"
  },
  "FLAVOR_MON": {
    "type": "string",
    "default": "cpu2-ram6-disk10",
    "description": "Flavor for CI mon roles"
  },
  "FLAVOR_OSD": {
    "type": "string",
    "default": "cpu2-ram6-disk10",
    "description": "Flavor for CI OSD roles"
  },
  "FLAVOR_COMP": {
    "type": "string",
    "default": "cpu8-ram24-disk40",
    "description": "Flavor for CI compute roles"
  },
  "NET_PUB_NAME": {
    "type": "string",
    "default": "bdb-clint-pub01",
    "description": "Network name for the VM that will host OCI"
  },
  "ROUTER_GW_PUB_NAME": {
    "type": "string",
    "default": "bdb-clint-pub01",
    "description": "Router gateway public name"
  },
  "PXE_SERVER_NAME": {
    "type": "string",
    "default": "oci",
    "description": "Name of the OCI VM"
  },
  "KEYPAIR_NAME": {
    "type": "string",
    "default": "oci-keypair",
    "description": "Keypair name"
  },
  "NET_PRIV_NAME": {
    "type": "string",
    "default": "oci-boot-network",
    "description": "Name of the private network for VM boot-up"
  },
  "SUBNET_PRIV_NAME": {
    "type": "string",
    "default": "oci-boot-subnet",
    "description": "Name of the private subnet"
  },
  "SUBNET_PRIV_PREFIX": {
    "type": "string",
    "default": "192.168.100",
    "description": "Prefix for the private subnet"
  },
  "SUBNET_PRIV_RANGE": {
    "type": "string",
    "default": "192.168.100.0",
    "description": "Range of the private subnet"
  },
  "SUBNET_PRIV_CIDR": {
    "type": "string",
    "default": "24",
    "description": "CIDR mask for the private subnet"
  },
  "SUBNET_PRIV_ROUTER_NAME": {
    "type": "string",
    "default": "oci-boot-router",
    "description": "Name of the private subnet router"
  },
  "SUBNET_PRIV_DNS_SERVER": {
    "type": "string",
    "default": "9.9.9.9",
    "description": "DNS server for the private subnet"
  },
  "SUBNET_PRIV_ROUTER_PORT": {
    "type": "string",
    "default": "oci-router-privnet-port",
    "description": "Name of the private subnet router port"
  },
  "SUBNET_PRIV_ROUTER_PORT_IP": {
    "type": "string",
    "default": "192.168.100.10",
    "description": "IP address of the private subnet router port"
  },
  "OCI_PXE_SERVER_IP_LAST_DIGIT": {
    "type": "string",
    "default": "4",
    "description": "Last digit of the OCI PXE server IP"
  },
  "OCI_PXE_IP": {
    "type": "string",
    "default": "192.168.100.4",
    "description": "IP address of the OCI PXE server"
  },
  "OCI_PXE_PORT_NAME": {
    "type": "string",
    "default": "oci-pxe-port",
    "description": "Name of the OCI PXE port"
  },
  "OCI_API_SUFIX_START": {
    "type": "string",
    "default": "90",
    "description": "Starting suffix for OCI API ports"
  },
  "OCI_CLUSTER_SUFFIX_START": {
    "type": "string",
    "default": "100",
    "description": "Starting suffix for OCI cluster ports"
  },
  "DEBIAN_MIRROR_ADDRESS": {
    "type": "string",
    "default": "http://deb.debian.org/debian",
    "description": "Address of the Debian mirror"
  },
  "DEBIAN_SECURITY_MIRROR_ADDRESS": {
    "type": "string",
    "default": "http://security.debian.org/debian-security",
    "description": "Address of the Debian security mirror"
  },
  "PXE_SERVER_IMAGE_NAME": {
    "type": "string",
    "default": "debian-bullseye-11.1.0-amd64.qcow2",
    "description": "Name of the image to use for booting"
  },
  "OS_RELEASE": {
    "type": "string",
    "default": "xena",
    "description": "OpenStack release name"
  },
  "SYSTEM_HDD_SIZE": {
    "type": "string",
    "default": "20",
    "description": "Size of the system HDDs in GB"
  },
  "DATA_HDD_SIZE": {
    "type": "string",
    "default": "40",
    "description": "Size of the additional volume for roles in GB"
  },
  "VM_IMAGE_FILENAME": {
    "type": "string",
    "default": "cirros-0.5.1-x86_64-disk.img",
    "description": "Filename of the VM image to download"
  },
  "VM_IMAGE_URL": {
    "type": "string",
    "default": "http://download.cirros-cloud.net/0.5.1/cirros-0.5.1-x86_64-disk.img",
    "description": "URL to download the VM image from"
  },
  "IMAGE_SSH_USER": {
    "type": "string",
    "default": "cirros",
    "description": "Name of the ssh user in the image"
  },
  "OCI_COMPUTE_NODES": {
    "type": "string",
    "default": "yes",
    "description": "Whether to provision compute nodes",
    "enum": [
      "yes",
      "no"
    ]
  },
  "OCI_NETWORK_NODES": {
    "type": "string",
    "default": "yes",
    "description": "Whether to provision network nodes",
    "enum": [
      "yes",
      "no"
    ]
  },
  "OCI_VOLUME_NODES": {
    "type": "string",
    "default": "yes",
    "description": "Whether to provision volume nodes",
    "enum": [
      "yes",
      "no"
    ]
  },
  "OCI_SWIFT_NODES": {
    "type": "string",
    "default": "no",
    "description": "Whether to provision Swift nodes",
    "enum": [
      "yes",
      "no"
    ]
  },
  "OCI_CEPH_NODES": {
    "type": "string",
    "default": "no",
    "description": "Whether to provision Ceph nodes",
    "enum": [
      "yes",
      "no"
    ]
  },
  "OCI_MESSAGING_NODES": {
    "type": "string",
    "default": "no",
    "description": "Whether to provision messaging nodes",
    "enum": [
      "yes",
      "no"
    ]
  },
  "OCI_BILLCEPH_NODES": {
    "type": "string",
    "default": "no",
    "description": "Whether to provision BillCeph nodes",
    "enum": [
      "yes",
      "no"
    ]
  },
  "OCI_TEMPEST_NODES": {
    "type": "string",
    "default": "yes",
    "description": "Whether to provision Tempest nodes",
    "enum": [
      "yes",
      "no"
    ]
  }
}
