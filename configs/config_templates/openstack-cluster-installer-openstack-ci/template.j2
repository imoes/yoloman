{#
    ========================================================================
    OpenStack Cluster Installer Configuration
    ========================================================================
    This file configures the `openstack-cluster-installer` tool. It defines
    network topology, VM flavors, image sources, and which OpenStack
    services/components to provision in the CI environment.

    All variables are drawn from the Ansible playbook/role defaults.
    Each setting is documented with its schema description.
    ========================================================================
#}

{# --------------------------------------------------------------- #}
{# DEBUG: Whether to enable debug mode (set -e)                    #}
{# --------------------------------------------------------------- #}
DEBUG={{ DEBUG | default('yes') }}

{# --------------------------------------------------------------- #}
{# OPENSTACK_CREDENTIALS: Path to the OpenStack credentials file  #}
{# --------------------------------------------------------------- #}
OPENSTACK_CREDENTIALS={{ OPENSTACK_CREDENTIALS | default('/etc/oci-poc/openstack-credentials') }}

{# --------------------------------------------------------------- #}
{# SSH_KEY_PATH: Path to the ssh public key for the deployment    #}
{# --------------------------------------------------------------- #}
SSH_KEY_PATH={{ SSH_KEY_PATH | default('/etc/oci-poc/id_rsa') }}

{# --------------------------------------------------------------- #}
{# AUTHORIZED_KEY_PATH: Path to the authorized keys file          #}
{# --------------------------------------------------------------- #}
AUTHORIZED_KEY_PATH={{ AUTHORIZED_KEY_PATH | default('/etc/oci-poc/authorized_keys') }}

{# --------------------------------------------------------------- #}
{# CLUSTER_NAME: Name of the cluster                              #}
{# --------------------------------------------------------------- #}
CLUSTER_NAME={{ CLUSTER_NAME | default('cl1') }}

{# --------------------------------------------------------------- #}
{# DOMAIN_NAME: Domain name                                       #}
{# --------------------------------------------------------------- #}
DOMAIN_NAME={{ DOMAIN_NAME | default('example.com') }}

{# --------------------------------------------------------------- #}
{# DUMMYNET_IFNAME_PREFIX: Prefix for dummy network interface names #}
{# --------------------------------------------------------------- #}
DUMMYNET_IFNAME_PREFIX={{ DUMMYNET_IFNAME_PREFIX | default('ocidm') }}

{# --------------------------------------------------------------- #}
{# DUMMYNET_BRIDGE_NAME: Name of the dummy network bridge         #}
{# --------------------------------------------------------------- #}
DUMMYNET_BRIDGE_NAME={{ DUMMYNET_BRIDGE_NAME | default('br-oci') }}

{# --------------------------------------------------------------- #}
{# EXT_NETWORK_PREFIX: Prefix for the external network            #}
{# --------------------------------------------------------------- #}
EXT_NETWORK_PREFIX={{ EXT_NETWORK_PREFIX | default('192.168.200') }}

{# --------------------------------------------------------------- #}
{# EXT_NETWORK_FIRST_IP: First IP in the external network range   #}
{# --------------------------------------------------------------- #}
EXT_NETWORK_FIRST_IP={{ EXT_NETWORK_FIRST_IP | default('200') }}

{# --------------------------------------------------------------- #}
{# EXT_NETWORK_LAST_IP: Last IP in the external network range     #}
{# --------------------------------------------------------------- #}
EXT_NETWORK_LAST_IP={{ EXT_NETWORK_LAST_IP | default('249') }}

{# --------------------------------------------------------------- #}
{# FLAVOR_PXE: Flavor for OCI PXE server                          #}
{# --------------------------------------------------------------- #}
FLAVOR_PXE={{ FLAVOR_PXE | default('cpu2-ram6-disk20') }}

{# --------------------------------------------------------------- #}
{# FLAVOR_CTRL: Flavor for CI controller roles                    #}
{# --------------------------------------------------------------- #}
FLAVOR_CTRL={{ FLAVOR_CTRL | default('cpu8-ram24-disk20') }}

{# --------------------------------------------------------------- #}
{# FLAVOR_MON: Flavor for CI mon roles                            #}
{# --------------------------------------------------------------- #}
FLAVOR_MON={{ FLAVOR_MON | default('cpu2-ram6-disk10') }}

{# --------------------------------------------------------------- #}
{# FLAVOR_OSD: Flavor for CI OSD roles                            #}
{# --------------------------------------------------------------- #}
FLAVOR_OSD={{ FLAVOR_OSD | default('cpu2-ram6-disk10') }}

{# --------------------------------------------------------------- #}
{# FLAVOR_COMP: Flavor for CI compute roles                       #}
{# --------------------------------------------------------------- #}
FLAVOR_COMP={{ FLAVOR_COMP | default('cpu8-ram24-disk40') }}

{# --------------------------------------------------------------- #}
{# NET_PUB_NAME: Network name for the VM that will host OCI       #}
{# --------------------------------------------------------------- #}
NET_PUB_NAME={{ NET_PUB_NAME | default('bdb-clint-pub01') }}

{# --------------------------------------------------------------- #}
{# ROUTER_GW_PUB_NAME: Router gateway public name                 #}
{# --------------------------------------------------------------- #}
ROUTER_GW_PUB_NAME={{ ROUTER_GW_PUB_NAME | default('bdb-clint-pub01') }}

{# --------------------------------------------------------------- #}
{# PXE_SERVER_NAME: Name of the OCI VM                            #}
{# --------------------------------------------------------------- #}
PXE_SERVER_NAME={{ PXE_SERVER_NAME | default('oci') }}

{# --------------------------------------------------------------- #}
{# KEYPAIR_NAME: Keypair name                                     #}
{# --------------------------------------------------------------- #}
KEYPAIR_NAME={{ KEYPAIR_NAME | default('oci-keypair') }}

{# --------------------------------------------------------------- #}
{# NET_PRIV_NAME: Name of the private network for VM boot-up      #}
{# --------------------------------------------------------------- #}
NET_PRIV_NAME={{ NET_PRIV_NAME | default('oci-boot-network') }}

{# --------------------------------------------------------------- #}
{# SUBNET_PRIV_NAME: Name of the private subnet                   #}
{# --------------------------------------------------------------- #}
SUBNET_PRIV_NAME={{ SUBNET_PRIV_NAME | default('oci-boot-subnet') }}

{# --------------------------------------------------------------- #}
{# SUBNET_PRIV_PREFIX: Prefix for the private subnet              #}
{# --------------------------------------------------------------- #}
SUBNET_PRIV_PREFIX={{ SUBNET_PRIV_PREFIX | default('192.168.100') }}

{# --------------------------------------------------------------- #}
{# SUBNET_PRIV_RANGE: Range of the private subnet                 #}
{# Note: This uses shell-style variable expansion for the .0 suffix #}
{# --------------------------------------------------------------- #}
SUBNET_PRIV_RANGE=${SUBNET_PRIV_PREFIX}.0

{# --------------------------------------------------------------- #}
{# SUBNET_PRIV_CIDR: CIDR mask for the private subnet             #}
{# --------------------------------------------------------------- #}
SUBNET_PRIV_CIDR={{ SUBNET_PRIV_CIDR | default('24') }}

{# --------------------------------------------------------------- #}
{# SUBNET_PRIV_ROUTER_NAME: Name of the private subnet router     #}
{# --------------------------------------------------------------- #}
SUBNET_PRIV_ROUTER_NAME={{ SUBNET_PRIV_ROUTER_NAME | default('oci-boot-router') }}

{# --------------------------------------------------------------- #}
{# SUBNET_PRIV_DNS_SERVER: DNS server for the private subnet      #}
{# --------------------------------------------------------------- #}
SUBNET_PRIV_DNS_SERVER={{ SUBNET_PRIV_DNS_SERVER | default('9.9.9.9') }}

{# --------------------------------------------------------------- #}
{# SUBNET_PRIV_ROUTER_PORT: Name of the private subnet router port #}
{# --------------------------------------------------------------- #}
SUBNET_PRIV_ROUTER_PORT={{ SUBNET_PRIV_ROUTER_PORT | default('oci-router-privnet-port') }}

{# --------------------------------------------------------------- #}
{# SUBNET_PRIV_ROUTER_PORT_IP: IP address of the private subnet    #}
{# router port. Uses prefix + .10                                   #}
{# --------------------------------------------------------------- #}
SUBNET_PRIV_ROUTER_PORT_IP=${SUBNET_PRIV_PREFIX}.10

{# --------------------------------------------------------------- #}
{# OCI_PXE_SERVER_IP_LAST_DIGIT: Last digit of the OCI PXE server #}
{# IP address                                                       #}
{# --------------------------------------------------------------- #}
OCI_PXE_SERVER_IP_LAST_DIGIT={{ OCI_PXE_SERVER_IP_LAST_DIGIT | default('4') }}

{# --------------------------------------------------------------- #}
{# OCI_PXE_IP: IP address of the OCI PXE server (derived)         #}
{# Derived from SUBNET_PRIV_PREFIX and OCI_PXE_SERVER_IP_LAST_DIGIT #}
{# --------------------------------------------------------------- #}
OCI_PXE_IP=${SUBNET_PRIV_PREFIX}.${OCI_PXE_SERVER_IP_LAST_DIGIT}

{# --------------------------------------------------------------- #}
{# OCI_PXE_PORT_NAME: Port name for the OCI PXE server            #}
{# --------------------------------------------------------------- #}
OCI_PXE_PORT_NAME={{ OCI_PXE_PORT_NAME | default('oci-pxe-port') }}

{# --------------------------------------------------------------- #}
{# OCI_API_SUFIX_START: Start suffix for API endpoints            #}
{# --------------------------------------------------------------- #}
OCI_API_SUFIX_START={{ OCI_API_SUFIX_START | default('90') }}

{# --------------------------------------------------------------- #}
{# OCI_CLUSTER_SUFFIX_START: Start suffix for cluster endpoints   #}
{# --------------------------------------------------------------- #}
OCI_CLUSTER_SUFFIX_START={{ OCI_CLUSTER_SUFFIX_START | default('100') }}

{# --------------------------------------------------------------- #}
{# DEBIAN_MIRROR_ADDRESS: Debian mirror address                   #}
{# --------------------------------------------------------------- #}
DEBIAN_MIRROR_ADDRESS={{ DEBIAN_MIRROR_ADDRESS | default('http://deb.debian.org/debian') }}

{# --------------------------------------------------------------- #}
{# DEBIAN_SECURITY_MIRROR_ADDRESS: Debian security mirror address #}
{# --------------------------------------------------------------- #}
DEBIAN_SECURITY_MIRROR_ADDRESS={{ DEBIAN_SECURITY_MIRROR_ADDRESS | default('http://security.debian.org/debian-security') }}

{# --------------------------------------------------------------- #}
{# PXE_SERVER_IMAGE_NAME: Name of the image to use for booting    #}
{# --------------------------------------------------------------- #}
PXE_SERVER_IMAGE_NAME={{ PXE_SERVER_IMAGE_NAME | default('debian-bullseye-11.1.0-amd64.qcow2') }}

{# --------------------------------------------------------------- #}
{# OS_RELEASE: OpenStack release name                             #}
{# --------------------------------------------------------------- #}
OS_RELEASE={{ OS_RELEASE | default('xena') }}

{# --------------------------------------------------------------- #}
{# SYSTEM_HDD_SIZE: Size of the system HDDs in GB                 #}
{# --------------------------------------------------------------- #}
SYSTEM_HDD_SIZE={{ SYSTEM_HDD_SIZE | default('20') }}

{# --------------------------------------------------------------- #}
{# DATA_HDD_SIZE: Size of the additional volume for roles         #}
{# Roles: compute, cephosd, billosd, volume, swiftstore           #}
{# --------------------------------------------------------------- #}
DATA_HDD_SIZE={{ DATA_HDD_SIZE | default('40') }}

{# --------------------------------------------------------------- #}
{# VM_IMAGE_FILENAME: Filename of the VM image                    #}
{# --------------------------------------------------------------- #}
VM_IMAGE_FILENAME={{ VM_IMAGE_FILENAME | default('cirros-0.5.1-x86_64-disk.img') }}

{# --------------------------------------------------------------- #}
{# VM_IMAGE_URL: URL to download the VM image                     #}
{# --------------------------------------------------------------- #}
VM_IMAGE_URL={{ VM_IMAGE_URL | default('http://download.cirros-cloud.net/0.5.1/cirros-0.5.1-x86_64-disk.img') }}

{# --------------------------------------------------------------- #}
{# IMAGE_SSH_USER: Name of the ssh user in the image              #}
{# --------------------------------------------------------------- #}
IMAGE_SSH_USER={{ IMAGE_SSH_USER | default('cirros') }}

{# --------------------------------------------------------------- #}
{# OCI_COMPUTE_NODES: Provision compute nodes                     #}
{# --------------------------------------------------------------- #}
OCI_COMPUTE_NODES={{ OCI_COMPUTE_NODES | default('yes') }}

{# --------------------------------------------------------------- #}
{# OCI_NETWORK_NODES: Provision network nodes                     #}
{# --------------------------------------------------------------- #}
OCI_NETWORK_NODES={{ OCI_NETWORK_NODES | default('yes') }}

{# --------------------------------------------------------------- #}
{# OCI_VOLUME_NODES: Provision volume nodes                       #}
{# --------------------------------------------------------------- #}
OCI_VOLUME_NODES={{ OCI_VOLUME_NODES | default('yes') }}

{# --------------------------------------------------------------- #}
{# OCI_SWIFT_NODES: Provision Swift nodes                         #}
{# --------------------------------------------------------------- #}
OCI_SWIFT_NODES={{ OCI_SWIFT_NODES | default('no') }}

{# --------------------------------------------------------------- #}
{# OCI_CEPH_NODES: Provision Ceph nodes                           #}
{# --------------------------------------------------------------- #}
OCI_CEPH_NODES={{ OCI_CEPH_NODES | default('no') }}

{# --------------------------------------------------------------- #}
{# OCI_MESSAGING_NODES: Provision Messaging nodes                 #}
{# --------------------------------------------------------------- #}
OCI_MESSAGING_NODES={{ OCI_MESSAGING_NODES | default('no') }}

{# --------------------------------------------------------------- #}
{# OCI_BILLCEPH_NODES: Provision BillCeph nodes                   #}
{# --------------------------------------------------------------- #}
OCI_BILLCEPH_NODES={{ OCI_BILLCEPH_NODES | default('no') }}

{# --------------------------------------------------------------- #}
{# OCI_TEMPEST_NODES: Always leave a tempest node                 #}
{# Required for running functional tests (tempest)                #}
{# --------------------------------------------------------------- #}
OCI_TEMPEST_NODES={{ OCI_TEMPEST_NODES | default('yes') }}
