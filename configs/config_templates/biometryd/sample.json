{
  "debug": false,
  "log_level": "warn",
  "pid_file": "/run/biometryd/biometryd.pid",
  "socket_path": "/run/biometryd/biometryd.sock",
  "worker_threads": 6,
  "device_timeout": 10,
  "client_timeout": 25,
  "io_buffer_size": 131072,
  "max_sessions": 256,
  "max_retries": 5,
  "retry_delay_ms": 750,
  "tls_enabled": true,
  "tls_cert_path": "/etc/biometryd/tls/biometryd.crt",
  "tls_key_path": "/etc/biometryd/tls/biometryd.key",
  "ca_cert_path": "/etc/biometryd/tls/ca.pem",
  "allowed_clients": [
    "127.0.0.1/32",
    "10.0.0.0/8"
  ],
  "drivers": [
    {
      "name": "fingerprint-scanner-3000",
      "enabled": true,
      "config_path": "/etc/biometryd/drivers/fingerprint-scanner-3000.conf",
      "extra_options": {
        "baud_rate": "115200",
        "poll_interval_ms": "200"
      }
    },
    {
      "name": "face-recognition-v2",
      "enabled": true,
      "config_path": "/etc/biometryd/drivers/face-recognition-v2.conf",
      "extra_options": {
        "min_confidence": "0.85",
        "enable_anti_spoof": "true"
      }
    },
    {
      "name": "legacy-irises",
      "enabled": false,
      "config_path": "/etc/biometryd/drivers/legacy-irises.conf",
      "extra_options": {}
    }
  ],
  "metrics_enabled": true,
  "metrics_endpoint": "/metrics",
  "metrics_auth_token": "secret-metrics-token-xyz"
}
