{
  "optimize": {
    "type": "bool",
    "default": true,
    "description": "Enable automatic DC bias adjust and normalization (set false to disable)"
  },
  "raw_params": {
    "type": "object",
    "default": null,
    "description": "Raw PCM file parameters (omit if WAV file)"
  },
  "raw_params.frequency": {
    "type": "number",
    "default": 44100,
    "description": "Sample frequency in Hz (e.g., 44100)"
  },
  "raw_params.channels": {
    "type": "number",
    "default": 1,
    "description": "Number of channels (1=mono, 2=stereo)"
  },
  "raw_params.bits": {
    "type": "number",
    "default": 16,
    "description": "Bits per sample (8, 16, 24, or 32)"
  },
  "debug_dump_file": {
    "type": "string",
    "default": "",
    "description": "Path to dump handled samples (for debugging)"
  },
  "dsp_params": {
    "type": "object",
    "default": null,
    "description": "Custom DSP parameters (key = param name, value = numeric setting)"
  },
  "dsp_params.DTMF_OPTIMIZED_VALUE": {
    "type": "number",
    "default": 102.0,
    "description": "DTMF optimized value threshold"
  },
  "dsp_params.DTMF_THRESHOLD": {
    "type": "number",
    "default": 800000000.0,
    "description": "DTMF detection threshold"
  },
  "dsp_params.DTMF_NORMAL_TWIST": {
    "type": "number",
    "default": 6.3,
    "description": "DTMF normal twist ratio"
  },
  "dsp_params.DTMF_RELATIVE_PEAK_ROW": {
    "type": "number",
    "default": 6.3,
    "description": "DTMF row relative peak sensitivity"
  },
  "dsp_params.DTMF_RELATIVE_PEAK_COL": {
    "type": "number",
    "default": 6.3,
    "description": "DTMF column relative peak sensitivity"
  },
  "dsp_params.BELL_MF_THRESHOLD": {
    "type": "number",
    "default": 800000000.0,
    "description": "Bell MF detection threshold"
  },
  "dsp_params.BELL_MF_TWIST": {
    "type": "number",
    "default": 4.0,
    "description": "Bell MF twist ratio"
  },
  "dsp_params.BELL_MF_RELATIVE_PEAK": {
    "type": "number",
    "default": 12.6,
    "description": "Bell MF relative peak sensitivity"
  },
  "files": {
    "type": "list",
    "default": [],
    "description": "Input audio files (WAV or raw PCM if raw_params provided)"
  }
}
