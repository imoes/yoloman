{
  "patterns": [
    "(?i)urgent",
    "(support|help)"
  ],
  "mailboxes": [
    "/var/mail/user",
    "/home/user/Mail/sent",
    "/home/user/Mail/inbox"
  ],
  "output_header_only": false,
  "output_body_only": false,
  "output_minimal_headers": true,
  "output_quiet": false,
  "output_report": false,
  "output_filenames_only": false,
  "output_line_numbers": false,
  "output_unique": true,
  "output_invert": false,
  "output_mailfolder": true,
  "search_case_insensitive": true,
  "search_word_boundary": false,
  "search_ignore_signature": true,
  "search_ignore_mime_attachments": true,
  "search_force": false,
  "search_follow_links": true,
  "search_header_pattern": false,
  "status_flags": "ar",
  "date_spec": "since yesterday",
  "size_spec": "2000-5000",
  "expression": "",
  "signature_pattern": "^-- $",
  "header_search_pattern": "^TO:|^FROM_DAEMON:",
  "cache_file": "/home/user/.cache/grepmail/cache",
  "debug": false
}
