{
  "max_servers": {
    "type": "number",
    "default": 2,
    "description": "Num of pre-forked children"
  },
  "daemon_user": {
    "type": "string",
    "default": "amavis",
    "description": "User running the daemon"
  },
  "daemon_groups": {
    "type": "string",
    "default": "amavis",
    "description": "Groups for the daemon user"
  },
  "mydomain": {
    "type": "string",
    "default": "example.com",
    "description": "A convenient default for other settings"
  },
  "myhome": {
    "type": "string",
    "default": "/var/spool/amavisd",
    "description": "Working directory root"
  },
  "lock_file": {
    "type": "string",
    "default": "/run/amavisd/amavisd.lock",
    "description": "Lock file path"
  },
  "pid_file": {
    "type": "string",
    "default": "/run/amavisd/amavisd.pid",
    "description": "PID file path"
  },
  "log_level": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level"
  },
  "do_syslog": {
    "type": "number",
    "default": 1,
    "description": "Log via syslogd"
  },
  "syslog_facility": {
    "type": "string",
    "default": "mail",
    "description": "Syslog facility"
  },
  "enable_db": {
    "type": "number",
    "default": 1,
    "description": "Enable BerkeleyDB"
  },
  "nanny_details_level": {
    "type": "number",
    "default": 2,
    "description": "Nanny verbosity level"
  },
  "enable_dkim_verification": {
    "type": "number",
    "default": 1,
    "description": "Enable DKIM verification"
  },
  "enable_dkim_signing": {
    "type": "number",
    "default": 1,
    "description": "Enable DKIM signing"
  },
  "unix_socketname": {
    "type": "string",
    "default": "/run/amavisd/amavisd.sock",
    "description": "Unix socket path"
  },
  "inet_socket_port": {
    "type": "number",
    "default": 10024,
    "description": "Listening TCP port"
  },
  "sa_tag_level_deflt": {
    "type": "number",
    "default": 2.0,
    "description": "Spam info headers threshold"
  },
  "sa_tag2_level_deflt": {
    "type": "number",
    "default": 6.2,
    "description": "Spam detected headers threshold"
  },
  "sa_kill_level_deflt": {
    "type": "number",
    "default": 6.9,
    "description": "Spam evasive actions threshold"
  },
  "sa_dsn_cutoff_level": {
    "type": "number",
    "default": 10,
    "description": "DSN suppression threshold"
  },
  "sa_crediblefrom_dsn_cutoff_level": {
    "type": "number",
    "default": 18,
    "description": "DSN suppression threshold for valid From"
  },
  "penpals_bonus_score": {
    "type": "number",
    "default": 8,
    "description": "Penpals bonus score"
  },
  "bounce_killer_score": {
    "type": "number",
    "default": 100,
    "description": "Bounce killer score"
  },
  "sa_mail_body_size_limit": {
    "type": "string",
    "default": "400*1024",
    "description": "Max mail body size for SA in bytes"
  },
  "sa_local_tests_only": {
    "type": "number",
    "default": 0,
    "description": "Only local tests for SA"
  },
  "maxlevels": {
    "type": "number",
    "default": 14,
    "description": "Max expansion levels"
  },
  "maxfiles": {
    "type": "number",
    "default": 3000,
    "description": "Max expansion files"
  },
  "min_expansion_quota": {
    "type": "string",
    "default": "100*1024",
    "description": "Min expansion quota in bytes"
  },
  "max_expansion_quota": {
    "type": "string",
    "default": "500*1024*1024",
    "description": "Max expansion quota in bytes"
  },
  "sa_spam_subject_tag": {
    "type": "string",
    "default": "***Spam*** ",
    "description": "Spam subject tag"
  },
  "defang_virus": {
    "type": "number",
    "default": 1,
    "description": "Defang viruses"
  },
  "defang_banned": {
    "type": "number",
    "default": 1,
    "description": "Defang banned files"
  },
  "defang_by_ccat_badh_3": {
    "type": "number",
    "default": 1,
    "description": "Defang NUL/CR in headers"
  },
  "defang_by_ccat_badh_5": {
    "type": "number",
    "default": 1,
    "description": "Defang long header lines"
  },
  "defang_by_ccat_badh_6": {
    "type": "number",
    "default": 1,
    "description": "Defang header syntax errors"
  },
  "defang_by_ccat_uncheked_3": {
    "type": "number",
    "default": 1,
    "description": "Defang ambiguous content"
  }
}
