{
  "max_servers": 2,
  "daemon_user": "amavis",
  "daemon_groups": "amavis",
  "mydomain": "example.com",
  "myhome": "/var/spool/amavisd",
  "lock_file": "/run/amavisd/amavisd.lock",
  "pid_file": "/run/amavisd/amavisd.pid",
  "log_level": 0,
  "do_syslog": 1,
  "syslog_facility": "mail",
  "enable_db": 1,
  "nanny_details_level": 2,
  "enable_dkim_verification": 1,
  "enable_dkim_signing": 1,
  "unix_socketname": "/run/amavisd/amavisd.sock",
  "inet_socket_port": 10024,
  "sa_tag_level_deflt": 2.0,
  "sa_tag2_level_deflt": 6.2,
  "sa_kill_level_deflt": 6.9,
  "sa_dsn_cutoff_level": 10,
  "sa_crediblefrom_dsn_cutoff_level": 18,
  "penpals_bonus_score": 8,
  "bounce_killer_score": 100,
  "sa_mail_body_size_limit": 409600,
  "sa_local_tests_only": 0,
  "maxlevels": 14,
  "maxfiles": 3000,
  "min_expansion_quota": 102400,
  "max_expansion_quota": 524288000,
  "sa_spam_subject_tag": "***Spam*** ",
  "defang_virus": 1,
  "defang_banned": 1,
  "defang_by_ccat_badh_3": 1,
  "defang_by_ccat_badh_5": 1,
  "defang_by_ccat_badh_6": 1,
  "defang_by_ccat_uncheked_3": 1
}
