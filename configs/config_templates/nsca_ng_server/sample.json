{
  "bind_address": "127.0.0.1:5667",
  "connection_timeout": 30,
  "packet_timeout": 5,
  "max_connections": 50,
  "enable_tls": true,
  "tls_certificate_file": "/etc/nsca-ng/tls/server.crt",
  "tls_private_key_file": "/etc/nsca-ng/tls/server.key",
  "tls_ca_file": "/etc/nsca-ng/tls/ca.crt",
  "pid_file": "/run/nsca-ng/nsca-ng.pid",
  "log_file": "-",
  "log_level": 3,
  "run_as_user": "nsca",
  "run_as_group": "nsca",
  "command_pipe": "/var/spool/nagios/cmd/nagios.cmd",
  "enable_include_dir": true,
  "include_dir": "/etc/nsca-ng/conf.d",
  "allowed_clients": [
    {
      "name": "icinga2-primary",
      "host": "192.168.1.10",
      "password": "supersecretpw",
      "encryption": "aes256"
    },
    {
      "name": "nagios-backup",
      "host": "192.168.1.11",
      "password": "anotherpw",
      "encryption": "none"
    }
  ]
}
