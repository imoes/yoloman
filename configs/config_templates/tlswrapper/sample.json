{
  "prog": "/usr/local/bin/myapp",
  "verbose": "v",
  "cert_files": [
    "/etc/tlswrapper/server.pem"
  ],
  "cert_dirs": [
    "/etc/tlswrapper/snibased"
  ],
  "client_auth_anchor": "/etc/tlswrapper/ca-bundle.pem",
  "extract_user_from_cert": "commonName",
  "ciphers": [
    "CHACHA20_POLY1305_SHA256",
    "AES_256_GCM_SHA384"
  ],
  "ephemeral_algorithms": [
    "x25519",
    "secp384r1"
  ],
  "min_tls_version": "tls12",
  "max_tls_version": "tls13",
  "network_timeout": 120,
  "tls_handshake_timeout": 15,
  "run_user": "www-data",
  "jail_directory": "/var/lib/tlswrapper/myapp_chroot",
  "jail_user": "tlswrapper",
  "enforce_server_preferences": true,
  "don_t_enforce_server_preferences": false,
  "enable_delayed_encryption": false,
  "don_t_disable_delayed_encryption": true,
  "proxy_protocol_version": "2"
}
