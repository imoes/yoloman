#!/usr/bin/env python
# sockperf configuration script generated by gonja
# This script generates command-line arguments for sockperf based on configuration values.
#
# Self-documenting: Every argument corresponds to a schema field.
# Defaults are applied via Jinja2 `default` filter to ensure safe rendering
# even when variables are undefined in the playbook context.

import sys
import os

def main():
    # Configuration values
    # mode: The mode of operation: server, ping-pong, throughput, under-load, or playback.
    mode = "{{ mode | default('ping-pong') }}"
    
    # role: The role of the sockperf instance: server or client.
    role = "{{ role | default('client') }}"
    
    # Construct the base command: 'sockperf <role>'
    args = ["sockperf", "{{ role | default('client') }}"]
    
    # --- Basic Network Settings ---
    # ip: The IP address to listen on or send to. Leave empty for default.
    {% set ip_val = ip | default('') %}
    {% if ip_val %}
    args.extend(["-i", "{{ ip_val }}"])
    {% endif %}
    
    # port: The port number to listen on or connect to.
    args.extend(["-p", "{{ port | default(11111) }}"])
    
    # --- Protocol Settings ---
    # tcp: Use TCP protocol instead of UDP.
    {% if tcp | default(False) %}
    args.append("--tcp")
    {% endif %}
    
    # --- I/O Multiplexing Settings ---
    # iomux_type: Type of multiple file descriptors handle: s/select, p/poll, e/epoll, r/recvfrom, x/socketxtreme.
    {% set iomux = iomux_type | default('epoll') %}
    {% if iomux != 'default' %}
    args.extend(["-F", "{{ iomux }}"])
    {% endif %}
    
    # --- Timeout Settings ---
    # timeout: Set select/poll/epoll timeout in milliseconds.
    {% set timeout_val = timeout | default(10) %}
    {% if timeout_val != 10 %}
    args.extend(["--timeout", "{{ timeout_val }}"])
    {% endif %}
    
    # --- Buffer and Socket Settings ---
    # buffer_size: Set total socket receive/send buffer size in bytes. 0 for system default.
    {% set buffer_size_val = buffer_size | default(0) %}
    {% if buffer_size_val != 0 %}
    args.extend(["--buffer-size", "{{ buffer_size_val }}"])
    {% endif %}
    
    # nonblocked: Open non-blocked sockets.
    {% if nonblocked | default(False) %}
    args.append("--nonblocked")
    {% endif %}
    
    # recv_looping_num: Loop over recvfrom() until EAGAIN or N good received packets. -1 for infinite.
    {% set recv_looping_num_val = recv_looping_num | default(1) %}
    {% if recv_looping_num_val != 1 %}
    args.extend(["--recv-looping-num", "{{ recv_looping_num_val }}"])
    {% endif %}
    
    # --- Warmup Settings ---
    # dontwarmup: Don't send warm up messages on start.
    {% if dontwarmup | default(False) %}
    args.append("--dontwarmup")
    {% endif %}
    
    # pre_warmup_wait: Time to wait before sending warm up messages in seconds.
    {% set pre_warmup_wait_val = pre_warmup_wait | default(0) %}
    {% if pre_warmup_wait_val != 0 %}
    args.extend(["--pre-warmup-wait", "{{ pre_warmup_wait_val }}"])
    {% endif %}
    
    # --- Server Specific Settings ---
    {% if role | default('client') == 'server' %}
        # threads_num: Run N threads on server side (requires '-f' option).
        {% set threads_num_val = threads_num | default(1) %}
        {% if threads_num_val != 1 %}
        args.extend(["--threads-num", "{{ threads_num_val }}"])
        {% endif %}
    
        # cpu_affinity: Set threads affinity to the given core ids in list format.
        {% set cpu_affinity_val = cpu_affinity | default([]) %}
        {% if cpu_affinity_val is iterable and (cpu_affinity_val | length) > 0 %}
        args.extend(["--cpu-affinity", "{{ cpu_affinity_val | join(',') }}"])
        {% endif %}
    
        # msg_size_server: Maximum message size that the server can receive in bytes. 0 for default.
        {% set msg_size_server_val = msg_size_server | default(0) %}
        {% if msg_size_server_val != 0 %}
        args.extend(["-m", "{{ msg_size_server_val }}"])
        {% endif %}
    
        # gap_detection: Enable gap-detection.
        {% if gap_detection | default(False) %}
        args.append("--gap-detection")
        {% endif %}
    
        # force_unicast_reply: Force server to reply via unicast.
        {% if force_unicast_reply | default(False) %}
        args.append("--force-unicast-reply")
        {% endif %}
    
        # dont_reply: Server won't reply to the client messages.
        {% if dont_reply | default(False) %}
        args.append("--dont-reply")
        {% endif %}
    {% endif %}
    
    # --- Client Specific Settings ---
    {% if role | default('client') == 'client' %}
        # Determine client mode action based on 'mode'
        {% if mode | default('ping-pong') == 'ping-pong' %}
        args.append("ping-pong")
        {% elif mode | default('ping-pong') == 'throughput' %}
        args.append("throughput")
        {% elif mode | default('ping-pong') == 'under-load' %}
        args.append("under-load")
        {% elif mode | default('ping-pong') == 'playback' %}
            # playback_file: Path to the playback file if mode is playback.
            args.extend(["playback", "--playback-file", "{{ playback_file | default('') }}"])
        {% endif %}
    
        # time: Run for N seconds.
        {% set time_val = time | default(1) %}
        {% if time_val != 1 %}
        args.extend(["-t", "{{ time_val }}"])
        {% endif %}
    
        # msg_size_client: Use messages of size N bytes. 0 for default.
        {% set msg_size_client_val = msg_size_client | default(0) %}
        {% if msg_size_client_val != 0 %}
        args.extend(["-m", "{{ msg_size_client_val }}"])
        {% endif %}
    
        # burst: Control the client's number of messages sent in every burst. 0 for default.
        {% set burst_val = burst | default(0) %}
        {% if burst_val != 0 %}
        args.extend(["-b", "{{ burst_val }}"])
        {% endif %}
    
        # mps: Set number of messages-per-second. 0 for default (max for ping-pong/throughput).
        {% set mps_val = mps | default(0) %}
        {% if mps_val != 0 %}
        args.extend(["--mps", "{{ mps_val }}"])
        {% endif %}
    
        # range_size: Randomly change the messages size in range: <size> +- N.
        {% set range_size_val = range_size | default(0) %}
        {% if range_size_val != 0 %}
        args.extend(["-r", "{{ range_size_val }}"])
        {% endif %}
    
        # srv_num: Set num of servers the client works with to N.
        {% set srv_num_val = srv_num | default(1) %}
        {% if srv_num_val != 1 %}
        args.extend(["--srv-num", "{{ srv_num_val }}"])
        {% endif %}
    
        # sender_affinity: Set sender thread affinity to the given core ids in list format.
        {% set sender_affinity_val = sender_affinity | default([]) %}
        {% if sender_affinity_val is iterable and (sender_affinity_val | length) > 0 %}
        args.extend(["--sender-affinity", "{{ sender_affinity_val | join(',') }}"])
        {% endif %}
    
        # receiver_affinity: Set receiver thread affinity to the given core ids in list format.
        {% set receiver_affinity_val = receiver_affinity | default([]) %}
        {% if receiver_affinity_val is iterable and (receiver_affinity_val | length) > 0 %}
        args.extend(["--receiver-affinity", "{{ receiver_affinity_val | join(',') }}"])
        {% endif %}
    
        # full_log: Dump full log of all messages send/receive time to the given file in CSV format.
        {% if full_log | default(False) %}
            # full_log_file: Path to the full log file if full_log is enabled.
            args.extend(["--full-log", "{{ full_log_file | default('') }}"])
        {% endif %}
    
        # client_port: Force the client side to bind to a specific port. 0 for default.
        {% set client_port_val = client_port | default(0) %}
        {% if client_port_val != 0 %}
        args.extend(["--client-port", "{{ client_port_val }}"])
        {% endif %}
    
        # client_ip: Force the client side to bind to a specific ip address. Empty for default.
        {% set client_ip_val = client_ip | default('') %}
        {% if client_ip_val %}
        args.extend(["--client-ip", "{{ client_ip_val }}"])
        {% endif %}
    {% endif %}
    
    # --- Common Options ---
    # tcp_avoid_nodelay: Stop/Start delivering TCP Messages Immediately (Enable/Disable Nagle).
    {% if tcp_avoid_nodelay | default(False) %}
    args.append("--tcp-avoid-nodelay")
    {% endif %}
    
    # tcp_skip_blocking_send: Enables non-blocking send operation.
    {% if tcp_skip_blocking_send | default(False) %}
    args.append("--tcp-skip-blocking-send")
    {% endif %}
    
    # daemonize: Run as daemon.
    {% if daemonize | default(False) %}
    args.append("--daemonize")
    {% endif %}
    
    # no_rdtsc: Don't use register when taking time; instead use monotonic clock.
    {% if no_rdtsc | default(False) %}
    args.append("--no-rdtsc")
    {% endif %}
    
    # debug: Print extra debug information.
    {% if debug | default(False) %}
    args.append("--debug")
    {% endif %}
    
    print(" ".join(args))

if __name__ == "__main__":
    main()