{#
  Duply Profile Configuration Template
  ====================================
  This template generates a `profile_name` script (usually located at
  /etc/duply/<profile_name>/profile) which is sourced by the `duply` command.
  All variables below must be exported as shell variables.
#}

{# -------------------------------------------------------------------------- #}
{# Profile Identification                                                     #}
{# -------------------------------------------------------------------------- #}

{# Name of the duply profile. This is also the directory name under /etc/duply/. #}
PROFILE_NAME='{{ profile_name | default('default') }}'

{# -------------------------------------------------------------------------- #}
{# Backup Source & Target                                                     #}
{# -------------------------------------------------------------------------- #}

{# Top-level directory or file to back up. #}
SOURCE='{{ source_dir | default('/home') }}'

{# Backup target URL (e.g., s3://my-bucket/duply, file:///mnt/backup). Required. #}
TARGET='{{ target_url | default('') }}'

{# -------------------------------------------------------------------------- #}
{# Encryption & Authentication (GnuPG)                                        #}
{# -------------------------------------------------------------------------- #}

{#
  GnuPG key ID to use for encryption/decryption (e.g., 0x1234ABCD).
  Note: The variable name in duply is GPG_KEY_ID.
#}
GPG_KEY_ID='{{ gpg_key_id | default('') }}'

{#
  GPG passphrase (plaintext). Use only in secure, local deployments.
  Prefer `gpg_passphrase_file` instead for better security.
#}
GPG_PASSPHRASE='{{ gpg_passphrase | default('') }}'

{#
  Absolute path to a file containing only the GPG passphrase (more secure).
#}
GPG_PASSPHRASE_FILE='{{ gpg_passphrase_file | default('') }}'

{# -------------------------------------------------------------------------- #}
{# Retention Policies                                                         #}
{# -------------------------------------------------------------------------- #}

{#
  Maximum age of backups to retain (e.g., '1Y' for one year, '3M' for three months).
  Empty string = no automatic cleanup based on age.
#}
MAX_AGE='{{ max_age | default('') }}'

{#
  Maximum number of backup sets to keep.
  Empty string = no limit on count.
#}
MAX_COUNT='{{ max_count | default('') }}'

{# -------------------------------------------------------------------------- #}
{# Performance & Parallelism                                                  #}
{# -------------------------------------------------------------------------- #}

{#
  Maximum size (in MB) of each volume in a multipart backup.
  Example: '200' results in 200 MB volumes.
  Empty = default duplicity behavior.
#}
VOLSIZE='{{ volsize | default('') }}'

{#
  Number of parallel file operations for cloud backends.
  0 = auto-detect.
#}
MAX_PARALLEL='{{ max_parallel | default('') }}'

{# -------------------------------------------------------------------------- #}
{# Logging & Verbosity                                                        #}
{# -------------------------------------------------------------------------- #}

{#
  Duply/duplicity log verbosity level (0–9).
  Recommended: 3 (info) or 4 (debug).
#}
VERBOSITY='{{ verbosity | default('3') }}'

{# -------------------------------------------------------------------------- #}
{# Include/Exclude Patterns                                                   #}
{# -------------------------------------------------------------------------- #}

{#
  Space-separated duplicity include/exclude patterns.
  Uses duplicity's native syntax: '+ /etc', '- /proc', etc.
  See: https://duplicity.nongnu.org/duplicity.1.html
#}
DUPLICITY_INCLUDE='{{ duplicity_include | default('') }}'
DUPLICITY_EXCLUDE='{{ duplicity_exclude | default('') }}'

{#
  List of file/directory patterns to exclude using glob-style wildcards.
  Each pattern becomes a separate `--exclude` argument in the command line.
#}
{% if exclude_patterns | default([]) | length > 0 %}
# Dynamically generated exclude arguments
DUPLICITY_EXCLUDE_ARGS='--exclude {{ exclude_patterns | default([]) | join(' --exclude ') }}'
{% else %}
DUPLICITY_EXCLUDE_ARGS=''
{% endif %}

{# -------------------------------------------------------------------------- #}
{# Hooks (Pre/Post Commands)                                                  #}
{# -------------------------------------------------------------------------- #}

{# Shell command to run before backup starts (e.g., flush caches, sync DBs). #}
PRE='{{ pre_backup_cmd | default('') }}'

{# Shell command to run after backup completes (e.g., send notification). #}
POST='{{ post_backup_cmd | default('') }}'

{# -------------------------------------------------------------------------- #}
{# Backup Mode & Verification                                                 #}
{# -------------------------------------------------------------------------- #}

{#
  If 'true', skip backup and run only cleanup actions (e.g., for cron-based cleanup only).
#}
CLEANUP_ONLY='{{ cleanup_only | default(false) | ternary('true', 'false') }}'

{#
  If 'true', force a full backup (overrides automatic incremental logic).
#}
FULL_BACKUP='{{ full_backup | default(false) | ternary('true', 'false') }}'

{#
  Force a full backup every N days (if not already done).
#}
FULL_BACKUP_DAYS='{{ full_backup_days | default('30') }}'

{#
  If 'true', disable automatic full backups — only incrementals.
#}
NO_FULL='{{ no_full | default(false) | ternary('true', 'false') }}'

{#
  If 'true', verify the last backup before running cleanup.
#}
VERIFY='{{ verify | default(false) | ternary('true', 'false') }}'

{# -------------------------------------------------------------------------- #}
{# Advanced Options                                                           #}
{# -------------------------------------------------------------------------- #}

{#
  Path to a file with additional duplicity options (one option per line).
  Example: /etc/duply/options.conf
#}
DUPLICITY_OPTIONS_FILE='{{ duplicity_options_file | default('') }}'

{#
  Optional environment variables to export before backup runs.
  Useful for cloud provider credentials (AWS, GCP, etc.).
#}
{% for key, value in env_vars | default({}) | dict2items %}export {{ key.key }}='{{ value.value }}'
{% endfor %}

{#
  Additional duplicity command-line options (e.g., '--no-encryption --allow-source-mismatch').
#}
DUPLICITY_EXTRA_OPTS='{{ duplicity_extra_opts | default('') }}'