{
  "profile_name": "www_backup",
  "target_url": "s3://backup-bucket/duply/www",
  "source_dir": "/var/www",
  "gpg_key_id": "0xABCDEF1234567890",
  "gpg_passphrase_file": "/etc/duply/.passphrase",
  "max_age": "6M",
  "max_count": "12",
  "volsize": "250",
  "max_parallel": "0",
  "verbosity": "3",
  "duplicity_include": "+ /var/www/html - /var/www/tmp",
  "duplicity_exclude": "- /var/www/cache - /var/www/logs",
  "exclude_patterns": [
    "*.tmp",
    "*.log",
    "/var/www/.git/*",
    "/var/www/backup"
  ],
  "pre_backup_cmd": "/usr/local/bin/backup-pre.sh",
  "post_backup_cmd": "systemctl restart logrotate.service",
  "cleanup_only": false,
  "full_backup": false,
  "full_backup_days": "30",
  "no_full": false,
  "verify": true,
  "duplicity_options_file": "",
  "env_vars": {
    "AWS_ACCESS_KEY_ID": "AKIAIOSFODNN7EXAMPLE",
    "AWS_SECRET_ACCESS_KEY": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
    "AWS_DEFAULT_REGION": "us-east-1"
  },
  "duplicity_extra_opts": "--s3-use-multiprocessing"
}
