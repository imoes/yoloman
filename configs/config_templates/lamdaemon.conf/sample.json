{
  "daemon_port": 2020,
  "daemon_host": "127.0.0.1",
  "log_level": "info",
  "log_file": "/var/log/lamdaemon/lamdaemon.log",
  "pid_file": "/run/lamdaemon.pid",
  "worker_count": 4,
  "ldap_servers": [
    "ldap://ldap1.example.org",
    "ldap://ldap2.example.org"
  ],
  "ldap_basedn": "ou=People,dc=example,dc=com",
  "ldap_binddn": "cn=lamdaemon,cn=Users,dc=example,dc=com",
  "ldap_bindpw": "secret-password",
  "ldap_starttls": true,
  "ldap_cacert": "/etc/ssl/certs/ca-certificates.crt",
  "db_driver": "sqlite",
  "db_file": "/var/lib/lamdaemon/lamdaemon.db",
  "ssl_enabled": true,
  "ssl_cert_path": "/etc/ssl/certs/lamdaemon.example.org.crt",
  "ssl_key_path": "/etc/ssl/private/lamdaemon.example.org.key",
  "cache_ttl_seconds": 300,
  "request_logging": true,
  "request_log_file": "/var/log/lamdaemon/requests.log"
}
