{
 "backend_options": {
  "Bus": "4",
  "Columns": "20",
  "D4": "22",
  "D5": "23",
  "D6": "24",
  "D7": "25",
  "E": "18",
  "Model": "HD44780",
  "RS": "17",
  "Rows": "4"
 },
 "general": {
  "backend": "HD44780",
  "device": "/dev/lcd0",
  "flip_y": false,
  "font": "fixed",
  "height": 4,
  "update_interval": 1000,
  "width": 20
 },
 "layout": {
  "extra_rows": [],
  "row1": "$hostname",
  "row2": "$time $date",
  "row3": "CPU: $cpu% Mem: $mem%",
  "row4": "$ip eth0 $load"
 },
 "widgets": [
  {
   "align": "left",
   "driver": "HD44780",
   "format": "%.0f",
   "name": "cpu_widget",
   "source": "cpu.usage",
   "type": "Text"
  },
  {
   "align": "left",
   "driver": "HD44780",
   "format": "%.0f",
   "name": "mem_widget",
   "source": "memory.used_percent",
   "type": "Text"
  },
  {
   "driver": "HD44780",
   "format": "%d",
   "max": 1440,
   "name": "uptime_bar",
   "source": "uptime_minutes",
   "type": "Bar",
   "width": 20
  }
 ]
}
