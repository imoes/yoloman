{
  "general": {
    "backend": "HD44780",
    "device": "/dev/lcd0",
    "width": 20,
    "height": 4,
    "font": "fixed",
    "update_interval": 1000,
    "flip_y": false
  },
  "layout": {
    "row1": "$hostname",
    "row2": "$time $date",
    "row3": "CPU: $cpu% Mem: $mem%",
    "row4": "$ip eth0 $load",
    "extra_rows": []
  },
  "widgets": [
    {
      "name": "cpu_widget",
      "type": "Text",
      "driver": "HD44780",
      "align": "left",
      "source": "cpu.usage",
      "format": "%.0f"
    },
    {
      "name": "mem_widget",
      "type": "Text",
      "driver": "HD44780",
      "align": "left",
      "source": "memory.used_percent",
      "format": "%.0f"
    },
    {
      "name": "uptime_bar",
      "type": "Bar",
      "driver": "HD44780",
      "width": 20,
      "source": "uptime_minutes",
      "format": "%d",
      "max": 1440
    }
  ],
  "backend_options": {
    "Model": "HD44780",
    "Rows": "4",
    "Columns": "20",
    "Bus": "4",
    "RS": "17",
    "E": "18",
    "D4": "22",
    "D5": "23",
    "D6": "24",
    "D7": "25"
  }
}
