# generic HD44780 display (LCD4Linux wiring)
Display HD44780-generic {
    Driver 'HD44780'
    Model 'generic'
    # Port for HD44780-generic.
    Port '{{ hd44780_generic_port | default("/dev/parports/0") }}'
    # Size for HD44780-generic.
    Size '{{ hd44780_generic_size | default("8x2") }}'
    # asc255bug for HD44780-generic.
    asc255bug {{ hd44780_generic_asc255bug | default(0) }}
    # GPOs for HD44780-generic.
    GPOs {{ hd44780_generic_gpos | default('8') }}
    Wire {
        # RW wire for HD44780-generic.
        RW '{{ hd44780_generic_wire_rw | default("GND") }}'
        # RS wire for HD44780-generic.
        RS '{{ hd44780_generic_wire_rs | default("AUTOFD") }}'
        # ENABLE wire for HD44780-generic.
        ENABLE '{{ hd44780_generic_wire_enable | default("STROBE") }}'
        # ENABLE2 wire for HD44780-generic.
        ENABLE2 '{{ hd44780_generic_wire_enable2 | default("GND") }}'
        # GPO wire for HD44780-generic.
        GPO '{{ hd44780_generic_wire_gpo | default("INIT") }}'
        # POWER wire for HD44780-generic.
        POWER '{{ hd44780_generic_wire_power | default("GND") }}'
    }
}

# generic HD44780 display (WinAmp wiring)
Display HD44780-winamp {
    Driver 'HD44780'
    Model 'generic'
    # UseBusy for HD44780-winamp.
    UseBusy {{ hd44780_winamp_use_busy | default(1) }}
    # Port for HD44780-winamp.
    Port '{{ hd44780_winamp_port | default("/dev/parports/0") }}'
    # Size for HD44780-winamp.
    Size '{{ hd44780_winamp_size | default("20x4") }}'
    # asc255bug for HD44780-winamp.
    asc255bug {{ hd44780_winamp_asc255bug | default(1) }}
    Wire {
        # RW wire for HD44780-winamp.
        RW '{{ hd44780_winamp_wire_rw | default("AUTOFD") }}'
        # RS wire for HD44780-winamp.
        RS '{{ hd44780_winamp_wire_rs | default("INIT") }}'
        # ENABLE wire for HD44780-winamp.
        ENABLE '{{ hd44780_winamp_wire_enable | default("STROBE") }}'
        # ENABLE2 wire for HD44780-winamp.
        ENABLE2 '{{ hd44780_winamp_wire_enable2 | default("GND") }}'
        # GPO wire for HD44780-winamp.
        GPO '{{ hd44780_winamp_wire_gpo | default("GND") }}'
        # POWER wire for HD44780-winamp.
        POWER '{{ hd44780_winamp_wire_power | default("GND") }}'
    }
    Timing {
        # fuzz timings by value (100 = no change)
        # Fuzz timing for HD44780-winamp.
        fuzz {{ hd44780_winamp_timing_fuzz | default('100') }}
        # low-level communication [ns]
        # CY timing for HD44780-winamp.
        CY {{ hd44780_winamp_timing_cy | default('1000') }}  # Enable cycle time
        # PW timing for HD44780-winamp.
        PW {{ hd44780_winamp_timing_pw | default('450') }}  # Enable pulse width
        # AS timing for HD44780-winamp.
        AS {{ hd44780_winamp_timing_as | default('140') }}  # Address setup time
        # AH timing for HD44780-winamp.
        AH {{ hd44780_winamp_timing_ah | default(' 20') }}  # Address hold time
        # HD44780 execution timings [us]
        # INIT1 timing for HD44780-winamp.
        INIT1 {{ hd44780_winamp_timing_init1 | default('4100') }}  # first init sequence: 4.1 msec
        # INIT2 timing for HD44780-winamp.
        INIT2 {{ hd44780_winamp_timing_init2 | default('100') }}  # second init sequence: 100 usec
        # EXEC timing for HD44780-winamp.
        EXEC {{ hd44780_winamp_timing_exec | default('80') }}  # normal execution time
        # WRCG timing for HD44780-winamp.
        WRCG {{ hd44780_winamp_timing_wr_cg | default('120') }}  # CG RAM Write
        # CLEAR timing for HD44780-winamp.
        CLEAR {{ hd44780_winamp_timing_clear | default('2250') }}  # Clear Display
        # HOME timing for HD44780-winamp.
        HOME {{ hd44780_winamp_timing_home | default('2250') }}  # Return Cursor Home
        # ONOFF timing for HD44780-winamp.
        ONOFF {{ hd44780_winamp_timing_onoff | default('2250') }}  # Display On/Off Control
        # GPO timing [ns]
        # GPO_ST timing for HD44780-winamp.
        GPO_ST {{ hd44780_winamp_timing_gpo_st | default('20') }}  # 74HCT573 set-up time
        # GPO_PW timing for HD44780-winamp.
        GPO_PW {{ hd44780_winamp_timing_gpo_pw | default('230') }}  # 74HCT573 enable pulse width
        # Power supply timing [ms]
        # POWER timing for HD44780-winamp.
        POWER {{ hd44780_winamp_timing_power | default('500') }}  # power-on delay
    }
}

