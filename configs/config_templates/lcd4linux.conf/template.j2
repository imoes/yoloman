# lcd4linux configuration file
# This file configures the lcd4linux daemon, managing various LCD drivers,
# plugins (MySQL, POP3, DBus, Seti), and widget layouts.
#
# Variables define global timing and default values for displays.

Variables {
    # Global update interval in milliseconds (variable tick).
    tick {{ (general | default({})).update_interval | default(500) }}
    # Tack interval variable.
    tack {{ tack_default | default('100') }}
    # Minute interval variable.
    minute {{ minute_default | default('60000') }}
}

# Display: ACool (serdisplib driver)
# This is a sample display configuration using serdisplib.
Display ACool {
    Driver 'serdisplib'
    Port 'USB:060c/04eb'
    Model 'ALPHACOOL'
}

# Display: G15 (Logitech G15 LCD)
# Configures the Logitech G15 gaming keyboard LCD.
Display G15 {
    Driver 'G-15'
    # Font for G15 display.
    Font '{{ g15_font | default("6x8") }}'
    # Contrast for G15 display.
    Contrast {{ g15_contrast | default(10) }}
    # Inverted setting for G15.
    Inverted {{ g15_inverted | default(0) }}
    # UInput device path for G15.
    UInput '{{ g15_uinput | default("/dev/input/uinput") }}'
    # Single key press setting for G15.
    SingleKeyPress {{ g15_single_key_press | default('1') }}
}

# Display: SerDispLib (Generic serdisplib device)
# Configures a display using the serdisplib library.
Display SerDispLib {
    Driver 'serdisplib'
    # Port for serdisplib display.
    Port '{{ serdisplib_port | default("PAR:/dev/parports/0") }}'
    # Alternative port for serdisplib.
    Port '{{ serdisplib_port_alternative | default("") }}'
    Model 'OPTREX323'
    # Options for serdisplib.
    Options '{{ serdisplib_options | default("") }}'
}

# Display: TeakLCM
# Configures a TeakLCM display.
Display TeakLCM {
    Driver 'TeakLCM'
    # Size for TeakLCM.
    Size '{{ teaklcm_size | default("20x2") }}'
    # Port for TeakLCM.
    Port '{{ teaklcm_port | default("/dev/ttyS1") }}'
