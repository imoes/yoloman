{
  "service_port": {
    "type": "number",
    "default": 62505,
    "description": "Base port for inetsim services (unless overridden per service)."
  },
  "bind_address": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Local IP address to bind all services to (e.g., '0.0.0.0' for all interfaces)."
  },
  "enable_dns": {
    "type": "bool",
    "default": true,
    "description": "Whether to enable DNS simulation (port 53)."
  },
  "enable_ftp": {
    "type": "bool",
    "default": false,
    "description": "Whether to enable FTP simulation (port 21)."
  },
  "enable_http": {
    "type": "bool",
    "default": true,
    "description": "Whether to enable HTTP simulation (port 80)."
  },
  "enable_https": {
    "type": "bool",
    "default": false,
    "description": "Whether to enable HTTPS simulation (port 443). Requires valid SSL cert and key."
  },
  "enable_smtp": {
    "type": "bool",
    "default": true,
    "description": "Whether to enable SMTP simulation (port 25)."
  },
  "enable_ssh": {
    "type": "bool",
    "default": false,
    "description": "Whether to enable SSH simulation (port 22)."
  },
  "enable_telnet": {
    "type": "bool",
    "default": false,
    "description": "Whether to enable Telnet simulation (port 23)."
  },
  "ssl_cert": {
    "type": "string",
    "default": "/etc/inetsim/cert.pem",
    "description": "Path to SSL certificate file for HTTPS."
  },
  "ssl_key": {
    "type": "string",
    "default": "/etc/inetsim/key.pem",
    "description": "Path to SSL private key file for HTTPS."
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/inetsim/inetsim.log",
    "description": "Path to log file (use '-' to log to stdout)."
  },
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Log verbosity level. Options: debug, info, notice, warning, error."
  },
  "www_directory": {
    "type": "string",
    "default": "/usr/share/inetsim/www",
    "description": "Directory containing simulated HTTP/FTP content."
  },
  "user_agent": {
    "type": "string",
    "default": "Mozilla/5.0 (compatible; inetsim)",
    "description": "Default User-Agent string returned by HTTP server."
  },
  "tcp_services": {
    "type": "list",
    "default": [
      {
        "port": 21,
        "service": "ftp"
      },
      {
        "port": 22,
        "service": "ssh"
      },
      {
        "port": 23,
        "service": "telnet"
      },
      {
        "port": 25,
        "service": "smtp"
      },
      {
        "port": 80,
        "service": "http"
      },
      {
        "port": 443,
        "service": "https"
      },
      {
        "port": 53,
        "service": "dns"
      },
      {
        "port": 110,
        "service": "pop3"
      },
      {
        "port": 143,
        "service": "imap"
      },
      {
        "port": 993,
        "service": "imaps"
      },
      {
        "port": 995,
        "service": "pop3s"
      }
    ],
    "description": "List of TCP services to run, each specifying a port and service type.",
    "items": {
      "port": {
        "type": "number",
        "description": "TCP port number to bind."
      },
      "service": {
        "type": "string",
        "description": "Service type (e.g., 'http', 'smtp', 'ssh')."
      }
    }
  },
  "udp_services": {
    "type": "list",
    "default": [
      {
        "port": 53,
        "service": "dns"
      }
    ],
    "description": "List of UDP services to run.",
    "items": {
      "port": {
        "type": "number",
        "description": "UDP port number to bind."
      },
      "service": {
        "type": "string",
        "description": "Service type (currently only 'dns' is supported)."
      }
    }
  },
  "dns_simulation": {
    "type": "string",
    "default": "internal",
    "description": "DNS resolution behavior: 'internal' (mocks DNS) or 'external' (forwards to real resolver)."
  },
  "dns_server": {
    "type": "string",
    "default": "8.8.8.8",
    "description": "Upstream DNS server to use when dns_simulation=external."
  },
  "randomize_port": {
    "type": "bool",
    "default": false,
    "description": "Whether to randomize service ports (useful for testing multiple instances)."
  },
  "close_timeout": {
    "type": "number",
    "default": 300,
    "description": "Idle timeout in seconds before closing a connection."
  },
  "max_connections": {
    "type": "number",
    "default": 100,
    "description": "Maximum number of concurrent connections allowed."
  }
}
