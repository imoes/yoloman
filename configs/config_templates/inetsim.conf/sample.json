{
  "service_port": 62505,
  "bind_address": "0.0.0.0",
  "enable_dns": true,
  "enable_ftp": false,
  "enable_http": true,
  "enable_https": false,
  "enable_smtp": true,
  "enable_ssh": false,
  "enable_telnet": false,
  "ssl_cert": "/etc/inetsim/cert.pem",
  "ssl_key": "/etc/inetsim/key.pem",
  "log_file": "/var/log/inetsim/inetsim.log",
  "log_level": "notice",
  "www_directory": "/usr/share/inetsim/www",
  "user_agent": "inetsim/1.0",
  "tcp_services": [
    {
      "port": 80,
      "service": "http"
    },
    {
      "port": 25,
      "service": "smtp"
    }
  ],
  "udp_services": [
    {
      "port": 53,
      "service": "dns"
    }
  ],
  "dns_simulation": "external",
  "dns_server": "1.1.1.1",
  "randomize_port": false,
  "close_timeout": 300,
  "max_connections": 50
}
