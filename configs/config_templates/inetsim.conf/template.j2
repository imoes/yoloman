#
# Syntax: redirect_icmp_timestamp [ms|sec|no]
#
# Default: ms
#
{% if redirect_icmp_timestamp is defined and redirect_icmp_timestamp is not none and (redirect_icmp_timestamp is number or redirect_icmp_timestamp is boolean or redirect_icmp_timestamp | length > 0) %}redirect_icmp_timestamp {{ redirect_icmp_timestamp }}
{% else %}#redirect_icmp_timestamp sec
