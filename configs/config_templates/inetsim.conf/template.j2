#############################################################
#
# INetSim configuration file
#
#############################################################


#############################################################
# Main configuration
#############################################################

#########################################
# start_service
#
# The services to start
#
# Syntax: start_service <service name>
#
# Default: none
#
# Available service names are:
# dns, http, smtp, pop3, tftp, ftp, ntp, time_tcp,
# time_udp, daytime_tcp, daytime_udp, echo_tcp,
# echo_udp, discard_tcp, discard_udp, quotd_tcp,
# quotd_udp, chargen_tcp, chargen_udp, finger,
# ident, syslog, dummy_tcp, dummy_udp, smtps, pop3s,
# ftps, irc, https
#
start_service dns
start_service http
start_service https
start_service smtp
start_service smtps
start_service pop3
start_service pop3s
start_service ftp
start_service ftps
start_service tftp
start_service irc
start_service ntp
start_service finger
start_service ident
start_service syslog
start_service time_tcp
start_service time_udp
start_service daytime_tcp
start_service daytime_udp
start_service echo_tcp
start_service echo_udp
start_service discard_tcp
start_service discard_udp
start_service quotd_tcp
start_service quotd_udp
start_service chargen_tcp
start_service chargen_udp
start_service dummy_tcp
start_service dummy_udp


#########################################
# service_bind_address
#
# IP address to bind services to
#
# Syntax: service_bind_address <IP address>
#
# Default: 127.0.0.1
#
{% if bind_address is defined and bind_address is not none and (bind_address is number or bind_address is boolean or bind_address | length > 0) %}service_bind_address {{ bind_address }}
{% else %}#service_bind_address 10.10.10.1
{% endif %}

#########################################
# service_run_as_user
#
# User to run services
#
# Syntax: service_run_as_user <username>
#
# Default: inetsim
#
{% if service_run_as_user is defined and service_run_as_user is not none and (service_run_as_user is number or service_run_as_user is boolean or service_run_as_user | length > 0) %}service_run_as_user {{ service_run_as_user }}
{% else %}#service_run_as_user nobody
{% endif %}

#########################################
# service_max_childs
#
# Maximum number of child processes (parallel connections)
# for each service
#
# Syntax: service_max_childs [1..30]
#
# Default: 10
#
{% if service_max_childs is defined and service_max_childs is not none and (service_max_childs is number or service_max_childs is boolean or service_max_childs | length > 0) %}service_max_childs {{ service_max_childs }}
{% else %}#service_max_childs 15
{% endif %}

#########################################
# service_timeout
#
# If a client does not send any data for the number of seconds
# given here, the corresponding connection will be closed.
#
# Syntax: service_timeout [1..600]
#
# Default: 120
#
{% if service_timeout is defined and service_timeout is not none and (service_timeout is number or service_timeout is boolean or service_timeout | length > 0) %}service_timeout {{ service_timeout }}
{% else %}#service_timeout 60
{% endif %}

#########################################
# create_reports
#
# Create report with a summary of connections
# for the session on shutdown
#
# Syntax: create_reports [yes|no]
#
# Default: yes
#
{% if create_reports is defined and create_reports is not none and (create_reports is number or create_reports is boolean or create_reports | length > 0) %}create_reports {{ create_reports }}
{% else %}#create_reports no
{% endif %}

#########################################
# report_language
#
# Set language for reports
# Note: Currently only languages 'en' and 'de' are supported
#
# Syntax: report_language <language>
#
# Default: en
#
{% if report_language is defined and report_language is not none and (report_language is number or report_language is boolean or report_language | length > 0) %}report_language {{ report_language }}
{% else %}#report_language de
{% endif %}

#############################################################
# Faketime
#############################################################

#########################################
# faketime_init_delta
#
# Initial number of seconds (positive or negative)
# relative to current date/time for fake time used by all services 
#
# Syntax: faketime_init_delta <number of seconds>
#
# Default: 0  (use current date/time) 
#
{% if faketime_init_delta is defined and faketime_init_delta is not none and (faketime_init_delta is number or faketime_init_delta is boolean or faketime_init_delta | length > 0) %}faketime_init_delta {{ faketime_init_delta }}
{% else %}#faketime_init_delta 1000
{% endif %}

#########################################
# faketime_auto_delay
#
# Number of seconds to wait before incrementing fake time
# by value specified with 'faketime_auto_increment'.
# Setting to '0' disables this option.
#
# Syntax: faketime_auto_delay [0..86400]
#
# Default: 0  (disabled)
#
{% if faketime_auto_delay is defined and faketime_auto_delay is not none and (faketime_auto_delay is number or faketime_auto_delay is boolean or faketime_auto_delay | length > 0) %}faketime_auto_delay {{ faketime_auto_delay }}
{% else %}#faketime_auto_delay 1000
{% endif %}

#########################################
# faketime_auto_increment
#
# Number of seconds by which fake time is incremented at
# regular intervals specified by 'faketime_auto_delay'.
# This option only takes effect if 'faketime_auto_delay'
# is enabled (not set to '0').
#
# Syntax: faketime_auto_increment [-31536000..31536000]
#
# Default: 3600
#
{% if faketime_auto_increment is defined and faketime_auto_increment is not none and (faketime_auto_increment is number or faketime_auto_increment is boolean or faketime_auto_increment | length > 0) %}faketime_auto_increment {{ faketime_auto_increment }}
{% else %}#faketime_auto_increment 86400
{% endif %}

