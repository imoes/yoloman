{
  "server": {
    "bind_address": "0.0.0.0",
    "port": 80,
    "max_workers": 8,
    "https_enabled": true,
    "ssl_cert_path": "/etc/ssl/micro-httpd/cert.pem",
    "ssl_key_path": "/etc/ssl/micro-httpd/key.pem",
    "docroot": "/var/www/html",
    "index_files": [
      "index.html",
      "index.htm"
    ]
  },
  "logging": {
    "verbose": false,
    "level": "warn",
    "path": "/var/log/micro-httpd/access.log"
  },
  "security": {
    "max_request_size": 5242880,
    "allowed_origins": [
      "https://example.com",
      "https://app.example.com"
    ],
    "auth_enabled": true,
    "auth_file": "/etc/micro-httpd/.htpasswd"
  },
  "limits": {
    "connection_timeout": 60,
    "max_connections": 1024,
    "rate_limit": 200
  }
}
