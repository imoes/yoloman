{
  "max_tracking_cas": 10,
  "state_dir": "/var/lib/certmonger",
  "ca_cert_dir": "/var/lib/certmonger/cas",
  "intermediate_cert_dir": "/var/lib/certmonger/intermediates",
  "enable_tracking_daemon": true,
  "enable_autorenew": true,
  "renewal_window": 30,
  "debug": false,
  "cas": [
    {
      "name": "internal-ca",
      "type": "dogtag",
      "url": "https://pki.example.com/ca/ee",
      "ca_cert": "/etc/pki/ca-trust/source/anchors/internal-ca.crt",
      "nickname": "Internal CA",
      "trust_flags": "CT,,"
    },
    {
      "name": "external-ca",
      "type": "simple",
      "url": "https://acme.example.com/directory",
      "ca_cert": "/etc/ssl/certs/acme-root.crt",
      "skip_verification": false
    }
  ]
}
