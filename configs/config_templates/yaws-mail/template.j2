# ============================================================================
# yaws-mail Configuration Template
# ============================================================================
# This file configures the yaws-mail service, a virtual server for webmail access.
# It defines where the BEAM (Erlang) code lives and exposes a web interface
# on a specific port and address.
#
# Self-documenting: every directive is preceded by its schema description.
# ============================================================================

# Path to the directory where the mail beam code is placed.
# The daemon will add this directory to its search path.
# Default: /usr/lib/yaws-mail/ebin
ebin_dir = {{ ebin_dir | default('/usr/lib/yaws-mail/ebin') }}

# ============================================================================
# Virtual Server Definition
# ============================================================================
# Uncomment and configure the server block below to enable the webmail application.
# The server is named 'mail'.
#
# port: Port number for the virtual server webmail application.
#       Default: 8080
# listen: IP address to listen on for the virtual server.
#         Default: 0.0.0.0
# docroot: Document root for the virtual server webmail application.
#          Default: /usr/share/yaws-mail/www
# ============================================================================

#<server mail>
# port = {{ port | default(8080) }}
# listen = {{ listen | default('0.0.0.0') }}
# docroot = {{ docroot | default('/usr/share/yaws-mail/www') }}
#</server>