# Configuration file for yaws-mail
#
# This template configures the YAWS-Mail application. It defines the location
# of the Erlang beam files and optionally enables a webmail virtual server.

# ==============================================================================
# Path to the directory where the mail beam code is placed.
# The daemon will add this directory to its search path.
# ==============================================================================
# Path to the directory where the mail beam code is placed.
ebin_dir = {{ ebin_dir | default('/usr/lib/yaws-mail/ebin') }}

# ==============================================================================
# Virtual Server Definition for Webmail Application
#
# To enable the webmail application, configure the port, listen address, and docroot below.
# If all are omitted or null, the virtual server block is omitted entirely.
# ==============================================================================

# IP address to listen on for the virtual server.
{% if listen is defined and listen is not none and (listen is number or listen is boolean or listen | length > 0) %}listen = {{ listen | default('0.0.0.0') }}{% else %}# listen = 0.0.0.0{% endif %}

# Document root for the virtual server webmail application.
{% if docroot is defined and docroot is not none and (docroot is number or docroot is boolean or docroot | length > 0) %}docroot = {{ docroot | default('/usr/share/yaws-mail/www') }}{% else %}# docroot = /usr/share/yaws-mail/www{% endif %}

# Port number for the virtual server webmail application.
{% if port is defined and port is not none and (port is number or port is boolean or port | length > 0) %}port = {{ port | default(8080) }}{% else %}# port = 8080{% endif %}
