# colord system configuration
# Enables/disables automatic color profile installation for new devices
{% if enable_profiling | default(true) %}#EnableProfiling=true{% else %}#EnableProfiling=false{% endif %}
EnableProfiling={{ enable_profiling | default(true) | lower }}

# Path where user color profiles are stored (per-user)
UserProfileDir={{ user_profile_dir | default('/var/lib/color-manager') }}

# Path where system-wide color profiles are stored (read-only)
SystemProfileDir={{ system_profile_dir | default('/usr/share/color/icc') }}

# Path to the device database (used for device matching and calibration)
DeviceDB={{ device_db | default('/var/lib/color-manager/devices.xml') }}

# Enable/disables the use of internal hardware calibration support
{% if enable_hardware_calibration | default(true) %}#EnableHardwareCalibration=true{% else %}#EnableHardwareCalibration=false{% endif %}
EnableHardwareCalibration={{ enable_hardware_calibration | default(true) | lower }}

# Enable/disables support for vendor-specific color profile formats
{% if enable_vendor_profiles | default(false) %}#EnableVendorProfiles=true{% else %}#EnableVendorProfiles=false{% endif %}
EnableVendorProfiles={{ enable_vendor_profiles | default(false) | lower }}

# Maximum number of color profiles kept per device (0 = unlimited)
MaxProfilesPerDevice={{ max_profiles_per_device | default(10) }}

# Comma-separated list of device types to ignore during profiling
# Valid types: monitor, projector, scanner, printer, camera, webcam, display, tablet
IgnoreDevices={{ ignore_devices | default([]) | join(', ') }}

# Comma-separated list of device vendor:product IDs to ignore (e.g., "046d:c077,15d9:0a0d")
IgnoreDeviceIDs={{ ignore_device_ids | default([]) | join(', ') }}

# Enable/disable logging of debugging messages to syslog
{% if enable_debug | default(false) %}#EnableDebug=true{% else %}#EnableDebug=false{% endif %}
EnableDebug={{ enable_debug | default(false) | lower }}

# Enable/disable logging of verbose messages to syslog
{% if enable_verbose | default(false) %}#EnableVerbose=true{% else %}#EnableVerbose=false{% endif %}
EnableVerbose={{ enable_verbose | default(false) | lower }}

# Maximum size of the internal cache (in MB); 0 = unlimited
CacheMaxSizeMB={{ cache_max_size_mb | default(50) }}
