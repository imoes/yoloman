{
  "enable_profiling": true,
  "user_profile_dir": "/var/lib/color-manager",
  "system_profile_dir": "/usr/share/color/icc",
  "device_db": "/var/lib/color-manager/devices.xml",
  "enable_hardware_calibration": true,
  "enable_vendor_profiles": false,
  "max_profiles_per_device": 10,
  "ignore_devices": [
    "scanner",
    "webcam"
  ],
  "ignore_device_ids": [
    "046d:c077",
    "15d9:0a0d"
  ],
  "enable_debug": false,
  "enable_verbose": false,
  "cache_max_size_mb": 50
}
