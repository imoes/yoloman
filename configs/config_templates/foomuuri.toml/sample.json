{
 "instance_id": "foomuuri-prod-us-east-1a",
 "log_level": "info",
 "metrics": {
  "enabled": true,
  "endpoint": "/metrics",
  "port": 9090
 },
 "pid_file": "/run/foomuuri.pid",
 "queue": {
  "backends": [
   {
    "config": {
     "db": "0",
     "host": "redis-primary.internal",
     "password": "REDACTED",
     "port": "6379"
    },
    "name": "primary"
   },
   {
    "config": {
     "db": "1",
     "host": "redis-backup.internal",
     "password": "REDACTED",
     "port": "6379",
     "retry_on_timeout": "true"
    },
    "name": "backup"
   }
  ],
  "type": "redis"
 },
 "server": {
  "bind_host": "0.0.0.0",
  "bind_port": 8080,
  "max_connections": 2000,
  "server_cert": "/etc/foomuuri/tls/fullchain.pem",
  "server_key": "/etc/foomuuri/tls/privkey.pem",
  "tls_enabled": true,
  "tls_min_version": "TLSv1.3"
 },
 "worker": {
  "graceful_timeout": 60,
  "max_jobs_per_worker": 15000,
  "memory_limit_mb": 1024,
  "process_count": 4
 },
 "working_dir": "/var/lib/foomuuri"
}
