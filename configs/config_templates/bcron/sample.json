{
  "jobs": [
    {
      "minute": "0",
      "hour": "2",
      "day": "*",
      "month": "*",
      "dow": "*",
      "user": "root",
      "command": "/usr/local/bin/rotate-logs.sh",
      "comment": "Rotate application logs daily at 2:00 AM"
    },
    {
      "minute": "*/15",
      "hour": "*",
      "day": "*",
      "month": "*",
      "dow": "*",
      "user": "www-data",
      "command": "/usr/bin/php /var/www/app/artisan schedule:run",
      "comment": "Run Laravel scheduler every 15 minutes"
    },
    {
      "minute": "30",
      "hour": "3",
      "day": "*",
      "month": "*",
      "dow": "0",
      "user": "backup",
      "command": "/usr/local/bin/weekly-backup.sh",
      "comment": "Full backup every Sunday at 3:30 AM"
    }
  ]
}
