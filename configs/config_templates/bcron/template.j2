# /etc/bcron/spool/crontab — main crontab for Bruce Cron System
# Each line defines a scheduled job: minute hour day month weekday user command
# Fields: minute hour day_of_month month day_of_week user command
{% for job in jobs %}
# {{ job.comment | default('No comment') }}
{{ job.minute | default('*') }} {{ job.hour | default('*') }} {{ job.day | default('*') }} {{ job.month | default('*') }} {{ job.dow | default('*') }} {{ job.user | required }} {{ job.command | required }}
{% endfor %}
