{
 "delivery": {
  "method": "smtp",
  "smtp_servers": [
   {
    "host": "mx1.company.com",
    "port": 587
   },
   {
    "host": "mx2.company.com",
    "port": 587
   }
  ]
 },
 "headers": {
  "add_date": true,
  "add_received": true,
  "replace_from": "archive@company.com"
 },
 "imap": {
  "fetch_batch_size": 200,
  "host": "imap.company.com",
  "mailbox": "archive",
  "password": "{{ vault('secrets/mail/archive_imap') }}",
  "port": 993,
  "ssl": true,
  "username": "archive@company.com"
 },
 "limits": {
  "max_concurrent_jobs": 5,
  "max_message_size": 10485760,
  "rate_limit_per_minute": 30
 },
 "logging": {
  "facility": "mail",
  "level": "info",
  "log_file": "/var/log/pullimap/pullimap.log"
 },
 "main": {
  "group": "mail",
  "user": "mail"
 },
 "tls": {
  "ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "client_cert": "",
  "client_key": "",
  "enable": true
 }
}
