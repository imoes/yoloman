# =============================================================================
# xymonq — Configuration template for Xymon client/query tools
# =============================================================================
# This file is sourced by Bash. Use standard Bash variable assignment syntax.
# All variables are provided with safe defaults derived from the schema.

# Path and command name for the `xymon` binary.
# Default: 'xymon'
XYMON_CMD="{{ (xymon_cmd | default('xymon')) }}"

# Where to find the Xymon server: IP:PORT (recommended) or HOSTNAME:PORT.
# Default: '127.0.0.1:1984'
XYMON_SRV="{{ (xymon_srv | default('127.0.0.1:1984')) }}"

# The default query to execute.
# Valid options: clientlog, xymondboard, hostinfo, xymondlog, ghostlist, config, ping, version.
# Default: '' (empty string)
QUERYTYPE="{{ (query_type | default('')) }}"

# The test to use for selecting hosts or printing with xymondlog.
# Default: 'info'
TEST="{{ (test_name | default('info')) }}"

# The fields to print for xymondboard.
# If empty, uses xymon(1) defaults.
# Default: '' (empty string)
FIELDS="{{ (fields | default('')) }}"

# Section(s) to print for clientlog.
# Multiple sections are joined with commas in the final config.
# Default: [] (empty list, results in empty string)
SECTION="{{ (sections | default([])) | join(',') }}"