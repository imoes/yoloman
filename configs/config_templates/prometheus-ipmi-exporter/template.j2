# prometheus-ipmi-exporter service configuration
# This template generates the command-line arguments for the exporter service.

# Path to FreeIPMI executables.
# Default: /usr/sbin
# Description: Path to FreeIPMI executables.
ARGS="--config.file=/etc/prometheus/ipmi_remote.yml --freeipmi.path={{ freeipmi_path | default('/usr/sbin') }} --log.level={{ log_level | default('info') }} --log.format={{ log_format | default('logfmt') }} --web.listen-address={{ web_listen_address | default(':9290') }}"
