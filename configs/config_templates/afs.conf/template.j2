# AFS (Andrew File System) client configuration
# This file configures the AFS client on this host.
# See afs(8) and openafs-client(7) for details.
# Generated by Ansible Jinja2 template.

# The default AFS cell this client belongs to.
# Used when no explicit cell is specified in paths.
Cell: {{ cell | default('example.com') }}

# List of known cells with their authentication URLs.
# These are additional cells recognized by the client.
{% for cell_entry in cellinfo | default([]) %}
# Cell: {{ cell_entry.name }} {{ cell_entry.url }}
CellInfo: {{ cell_entry.name }} {{ cell_entry.url }}
{% endfor %}

# Directory where the AFS client stores cached files and metadata.
# Adjust based on available disk space and workload.
{% if cache_dir | default('/var/cache/afs') %}
# AFS cache directory
CacheDir: {{ cache_dir | default('/var/cache/afs') }}
{% endif %}

# Size of the AFS cache in kilobytes (KB).
# Adjust based on available disk space and workload.
{% if cache_size | default(102400) %}
# Size of AFS cache (in KB)
CacheSize: {{ cache_size | default(102400) }}
{% endif %}

# Local authentication (if no AFS Kerberos setup).
# Disable in production if using Kerberos.
{% if local_auth | default(False) %}
LocalAuth: yes
{% else %}
LocalAuth: no
{% endif %}

# Enable kernel module support (recommended for performance).
{% if kernel_module | default(True) %}
KernelModule: yes
{% else %}
KernelModule: no
{% endif %}

# Number of threads used for cleaning stale cache entries.
# Default is 2.
# Cache cleaning threads
CacheCleanerThreads: {{ cache_cleaner_threads | default(2) }}

# Maximum number of threads for background I/O (e.g., cache writes, prefetching).
# Default is 4.
# Maximum number of background file I/O threads
BkgIOThreads: {{ bkg_io_threads | default(4) }}

# Network interfaces to bind to.
# Leave empty (commented out) to use all interfaces.
# Only use specified interfaces
{% for iface in bind_interfaces | default([]) %}
Interface: {{ iface }}
{% endfor %}

# Authentication timeout in seconds for network-based authentication services.
# Default is 60 seconds.
# Authentication timeout (in seconds)
AuthTimeout: {{ auth_timeout | default(60) }}

# Enable verbose/debug logging to help troubleshoot issues.
# Enable verbose logging (debugging)
{% if verbose | default(False) %}
LogDebug: yes
{% else %}
LogDebug: no
{% endif %}

# Syslog facility to use when logging (e.g., 'daemon', 'local0', 'user').
# Syslog facility
SyslogFacility: {{ syslog_facility | default('daemon') }}

# Path to the per-cell server list file.
# Usually managed automatically; override only for custom setups.
# Path to AFS cell server list file (usually /etc/afs/ThisCell)
{% if cell_server_list | default('/etc/afs/ThisCell') %}
CellServerList: {{ cell_server_list | default('/etc/afs/ThisCell') }}
{% endif %}

# Path to the CellServDB file containing server addresses for all known cells.
# Path to AFS local cell file (usually /etc/afs/CellServDB)
{% if cell_servdb | default('/etc/afs/CellServDB') %}
CellServDB: {{ cell_servdb | default('/etc/afs/CellServDB') }}
{% endif %}