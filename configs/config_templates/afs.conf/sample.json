{
  "cell": "myorg.edu",
  "cellinfo": [
    {
      "name": "myorg.edu",
      "url": "http://afs.myorg.edu/auth"
    },
    {
      "name": "openafs.org",
      "url": "http://afs.openafs.org/auth"
    }
  ],
  "cache_dir": "/var/cache/afs",
  "cache_size": 204800,
  "local_auth": false,
  "kernel_module": true,
  "cache_cleaner_threads": 2,
  "bkg_io_threads": 6,
  "bind_interfaces": [
    "eth0"
  ],
  "auth_timeout": 45,
  "verbose": false,
  "syslog_facility": "local0",
  "cell_server_list": "/etc/afs/ThisCell",
  "cell_servdb": "/etc/afs/CellServDB"
}
