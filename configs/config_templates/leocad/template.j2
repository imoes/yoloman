# LeoCAD Configuration File
# Located at ~/.config/LeoCAD Software/LeoCAD.conf
# This template generates a subset of configuration relevant to the command-line interface and rendering options.
#
# Variables:
#   lib_path          : Path to the LDraw parts library. Can also be set via the LEOCAD_LIB environment variable.
#   stud_style        : Stud style ID: 0=Plain, 1=Thin Lines Logo, 2=Outline Logo, 3=Sharp Top Logo,
#                       4=Rounded Top Logo, 5=Flattened Logo, 6=High Contrast, 7=High Contrast with Logo
#   shading_mode      : Shading mode for rendering: wireframe, flat, default, or full.
#   fov               : Vertical field of view in degrees used for rendering images.
#   near_clip         : Near clipping plane distance for rendering (must be >= 1).
#   far_clip          : Far clipping plane distance for rendering (must be > near_clip).
#   aa_samples        : Anti-Aliasing sample size: 1, 2, 4, or 8.
#   fade_steps_color  : Color to use for rendering parts from prior steps when faded (#AARRGGBB).
#   highlight_color   : Color to use to highlight parts in the steps they appear (#AARRGGBB).
#   auto_edge_color   : Enable automatically adjusted edge colors (-aec).
#   line_width        : Width of the edge lines.
#   light_dark_value  : Value to indicate a light or dark color for shading/lighting calculations.
#   color_contrast    : Color contrast setting for rendering.
#   stud_cylinder_color: High contrast stud cylinder color (#AARRGGBB).
#   edge_color        : High contrast edge color (#AARRGGBB).
#   black_edge_color  : High contrast edge color for black parts (#AARRGGBB).
#   dark_edge_color   : High contrast edge color for dark color parts (#AARRGGBB).

[LeoCAD]
# Sets the parts library location (can also be set via LEOCAD_LIB env var)
LibPath={{ lib_path | default('/usr/share/leocad/ldraw') }}

[Preferences]
# Sets the stud style: 0=Plain, 1=Thin Lines Logo, ..., 7=High Contrast with Logo
StudStyle={{ stud_style | default(0) }}

[Render]
# Sets the shading mode: wireframe, flat, default, full
Shading={{ shading_mode | default('default') }}

# Sets the vertical field of view in degrees
FOV={{ fov | default(45.0) }}

# Sets the near and far clipping planes for rendering
NearClip={{ near_clip | default(1.0) }}
FarClip={{ far_clip | default(10000.0) }}

# Anti-Aliasing sample size: 1, 2, 4, or 8
AASamples={{ aa_samples | default(1) }}

# Color to use for rendering faded parts (#AARRGGBB)
FadeStepsColor={{ fade_steps_color | default('#80808080') }}

# Color to use to highlight parts in the steps they appear (#AARRGGBB)
HighlightColor={{ highlight_color | default('#FFFF00FF') }}

# Enable automatically adjusted edge colors
AutoEdgeColor={{ auto_edge_color | default(false) }}

# Set the near and far clipping planes used for image rendering (deprecated in some contexts, kept for CLI -zplanes)
# Note: In CLI, -zplanes takes 'near far'. Here we store them separately for template flexibility.
NearClipRender={{ near_clip | default(1.0) }}
FarClipRender={{ far_clip | default(10000.0) }}

# Set the width of the edge lines
LineWidth={{ line_width | default(1) }}

# Set the value to indicate a light or dark color for shading calculations
LightDarkValue={{ light_dark_value | default(0.5) }}

# Set the color contrast
ColorContrast={{ color_contrast | default(1.0) }}

# High contrast stud cylinder color (#AARRGGBB)
StudCylinderColor={{ stud_cylinder_color | default('#FFFFFFFF') }}

# High contrast edge color (#AARRGGBB)
EdgeColor={{ edge_color | default('#FF000000') }}

# High contrast edge color for black parts (#AARRGGBB)
BlackEdgeColor={{ black_edge_color | default('#FF000000') }}

# High contrast edge color for dark color parts (#AARRGGBB)
DarkEdgeColor={{ dark_edge_color | default('#FF000000') }}