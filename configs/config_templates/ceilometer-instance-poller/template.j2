[DEFAULT]

#
# From cipopts
#

# Path where to store the cache of instance polled information.
# Type: string
# Default: '' (empty, uses application default or environment variable)
{% if instance_info_cache_path is defined and instance_info_cache_path is not none and (instance_info_cache_path is number or instance_info_cache_path is boolean or instance_info_cache_path | length > 0) %}instance_info_cache_path = {{ instance_info_cache_path | default('') }}{% else %}#instance_info_cache_path = /var/cache/ceilometer-instance-poller{% endif %}

# Time in minutes for the instance information cache expiration.
# Type: integer
# Default: '' (empty, uses application default)
{% if instance_info_cache_expiration is defined and instance_info_cache_expiration is not none and (instance_info_cache_expiration is number or instance_info_cache_expiration is boolean or instance_info_cache_expiration | length > 0) %}instance_info_cache_expiration = {{ instance_info_cache_expiration | default('') }}{% else %}#instance_info_cache_expiration = 60{% endif %}

# Time in minutes to randomly add to instance_info_cache_expiration to avoid polling all instances at the same time.
# Type: integer
# Default: '' (empty, uses application default)
{% if instance_info_cache_fuzzing is defined and instance_info_cache_fuzzing is not none and (instance_info_cache_fuzzing is number or instance_info_cache_fuzzing is boolean or instance_info_cache_fuzzing | length > 0) %}instance_info_cache_fuzzing = {{ instance_info_cache_fuzzing | default('') }}{% else %}#instance_info_cache_fuzzing = 30{% endif %}

#
# From oslo.log
#

# Base directory used for relative log_file paths.
# Type: string
# Default: '/var/log/ceilometer-instance-poller'
log_dir = {{ log_dir | default('/var/log/ceilometer-instance-poller') }}
