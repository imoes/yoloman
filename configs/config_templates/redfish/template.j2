# Redfish fencing agent configuration for fence_redfish
# Each entry defines a redfish node for fencing operations
{% for node in nodes %}
# Redfish node: {{ node.name }}
{
  "name": "{{ node.name }}",
  "ipaddr": "{{ node.ipaddr }}",
  "login": "{{ node.login }}",
  "passwd": "{{ node.passwd }}",
  "port": "{{ node.port }}",
  "secure": {{ node.secure | string | lower }},
  "action": "{{ node.action | default('on') }}",
  "timeout": {{ node.timeout | default(20) }}
}
{% endfor %}