{
  "strict_host_key_checking": "auto",
  "log_level": "ERROR",
  "forward_agent": false,
  "forward_x11": false,
  "connect_timeout": 10,
  "password_authentication": false,
  "preferred_authentications": [
    "publickey",
    "keyboard-interactive",
    "password"
  ],
  "server_alive_interval": 60,
  "server_alive_count_max": 3,
  "compression": false,
  "protocol": 2,
  "tcp_keepalive": true,
  "host_configs": []
}
