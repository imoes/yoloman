{
  "strict_host_key_checking": "auto",
  "log_level": "ERROR",
  "forward_agent": false,
  "forward_x11": false,
  "connect_timeout": 10,
  "password_authentication": false,
  "preferred_authentications": [
    "publickey",
    "keyboard-interactive"
  ],
  "server_alive_interval": 60,
  "server_alive_count_max": 3,
  "compression": false,
  "protocol": 2,
  "tcp_keepalive": true,
  "host_configs": [
    {
      "pattern": "*.corp.local",
      "comment": "Internal corporate servers",
      "user": "admin",
      "strict_host_key_checking": "yes",
      "identity_file": [
        "/home/user/.ssh/id_corp"
      ]
    },
    {
      "pattern": "prod-*",
      "comment": "Production servers via jump host",
      "proxy_jump": [
        "jump.corp.local"
      ],
      "forward_agent": true,
      "forward_x11": false,
      "port": 2222
    }
  ]
}
