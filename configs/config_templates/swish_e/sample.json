{
  "indexed_dirs": [
    "/var/www/html/docs",
    "/srv/reports"
  ],
  "file_extensions": [
    "html",
    "pdf",
    "txt"
  ],
  "case_sensitive": false,
  "max_word_length": 80,
  "min_word_length": 2,
  "stemming": "snowball",
  "stopwords_file": "/etc/swish-e/stopwords.txt",
  "meta_config_file": "/etc/swish-e/meta.conf",
  "meta_fields": [
    {
      "name": "title",
      "index_number": 1
    },
    {
      "name": "date",
      "index_number": 2
    },
    {
      "name": "author",
      "index_number": 3
    }
  ],
  "index_file": "/var/lib/swish-e/enterprise.swish-e",
  "log_file": "/var/log/swish-e/index.log",
  "rotate_index_files": 5000,
  "max_index_file_size": 104857600,
  "description_field": "title",
  "index_name": "enterprise_search",
  "header_config_file": "/etc/swish-e/headers.conf",
  "default_description": "No description provided.",
  "parallel_workers": 4,
  "verbosity": 2
}
