{
  "listen_addr": "0.0.0.0",
  "listen_port": 4242,
  "entropy_source_path": "/dev/hwrng",
  "max_concurrent_requests": 2048,
  "tls_enabled": true,
  "tls_cert_file": "/etc/pollen/certs/server.crt",
  "tls_key_file": "/etc/pollen/certs/server.key",
  "worker_count": 8,
  "worker_type": "threaded",
  "rate_limit_enabled": true,
  "rate_limit_rps": 120,
  "rate_limit_burst": 200,
  "log_level": "info",
  "log_format": "json",
  "log_destination": "file:/var/log/pollen/server.log",
  "cors_origins": [
    "https://dashboard.example.com",
    "https://admin.example.com"
  ],
  "health_endpoint_path": "/healthz",
  "metrics_endpoint_path": "/metrics",
  "timeout_connect": 3,
  "timeout_read": 15,
  "timeout_write": 10,
  "cache_enabled": true,
  "cache_ttl": 300,
  "cache_max_entries": 50000
}
