{
  "http_port": 42080,
  "https_port": 42443,
  "device_path": "/dev/random",
  "bytes": 64,
  "tls_cert_file": "/etc/pollen/cert.pem",
  "tls_key_file": "/etc/pollen/key.pem",
  "listen_addr": "0.0.0.0",
  "listen_port": 4242,
  "entropy_source_path": "/dev/hwrng",
  "max_concurrent_requests": 1024,
  "worker_count": 4,
  "worker_type": "threaded",
  "rate_limit_enabled": true,
  "rate_limit_rps": 60,
  "rate_limit_burst": 100,
  "log_level": "info",
  "log_format": "json",
  "log_destination": "file:/var/log/pollen/server.log",
  "cors_origins": [],
  "health_endpoint_path": "/health",
  "metrics_endpoint_path": "/metrics",
  "timeout_connect": 5,
  "timeout_read": 10,
  "timeout_write": 5,
  "cache_enabled": false,
  "cache_ttl": 60,
  "cache_max_entries": 10000
}
