{
  "server": {
    "type": "object",
    "default": {
      "host": "0.0.0.0",
      "port": 8080,
      "max_connections": 1024,
      "ssl_enabled": false,
      "ssl_cert_path": "/etc/eflite/ssl/cert.pem",
      "ssl_key_path": "/etc/eflite/ssl/key.pem"
    },
    "description": "HTTP server configuration: listening address, port, and TLS settings.",
    "items": {
      "host": {
        "type": "string",
        "default": "0.0.0.0",
        "description": "IP address or hostname to bind the HTTP listener to."
      },
      "port": {
        "type": "number",
        "default": 8080,
        "description": "TCP port for the HTTP server."
      },
      "max_connections": {
        "type": "number",
        "default": 1024,
        "description": "Maximum number of simultaneous client connections allowed."
      },
      "ssl_enabled": {
        "type": "bool",
        "default": false,
        "description": "Enable or disable HTTPS (TLS) support."
      },
      "ssl_cert_path": {
        "type": "string",
        "default": "/etc/eflite/ssl/cert.pem",
        "description": "Path to the SSL certificate file (required if SSL is enabled)."
      },
      "ssl_key_path": {
        "type": "string",
        "default": "/etc/eflite/ssl/key.pem",
        "description": "Path to the SSL private key file (required if SSL is enabled)."
      }
    }
  },
  "worker": {
    "type": "object",
    "default": {
      "processes": 2,
      "threads": 4
    },
    "description": "Worker process configuration for concurrency.",
    "items": {
      "processes": {
        "type": "number",
        "default": 2,
        "description": "Number of worker processes to spawn."
      },
      "threads": {
        "type": "number",
        "default": 4,
        "description": "Number of threads per worker process."
      }
    }
  },
  "paths": {
    "type": "object",
    "default": {
      "base_dir": "/var/lib/eflite",
      "log_dir": "/var/log/eflite",
      "cache_dir": "/var/cache/eflite"
    },
    "description": "Filesystem paths used by Eflite for data, logs, and caches.",
    "items": {
      "base_dir": {
        "type": "string",
        "default": "/var/lib/eflite",
        "description": "Root directory for persistent data storage."
      },
      "log_dir": {
        "type": "string",
        "default": "/var/log/eflite",
        "description": "Directory where Eflite writes log files."
      },
      "cache_dir": {
        "type": "string",
        "default": "/var/cache/eflite",
        "description": "Directory for temporary cache files."
      }
    }
  },
  "logging": {
    "type": "object",
    "default": {
      "level": "info",
      "access_log": true
    },
    "description": "Logging verbosity and behavior settings.",
    "items": {
      "level": {
        "type": "string",
        "default": "info",
        "description": "Minimum log level to record (debug, info, warning, error)."
      },
      "access_log": {
        "type": "bool",
        "default": true,
        "description": "Enable or disable HTTP access logging."
      }
    }
  },
  "security": {
    "type": "object",
    "default": {
      "rate_limiting_enabled": true,
      "rate_limit_max": 100,
      "rate_limit_window": 60
    },
    "description": "Security and rate-limiting controls.",
    "items": {
      "rate_limiting_enabled": {
        "type": "bool",
        "default": true,
        "description": "Enable per-client request rate limiting."
      },
      "rate_limit_max": {
        "type": "number",
        "default": 100,
        "description": "Maximum number of requests allowed per window per client."
      },
      "rate_limit_window": {
        "type": "number",
        "default": 60,
        "description": "Time window for rate limiting, in seconds."
      }
    }
  },
  "upstreams": {
    "type": "list",
    "default": [],
    "description": "List of backend services to proxy requests to (upstreams).",
    "items": {
      "type": "object",
      "items": {
        "name": {
          "type": "string",
          "default": "",
          "description": "Unique identifier for this upstream (e.g., 'api', 'webapp')."
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Hostname or IP address of the upstream server."
        },
        "port": {
          "type": "number",
          "default": 8000,
          "description": "Port of the upstream server."
        },
        "weight": {
          "type": "number",
          "default": 1,
          "description": "Load balancing weight (higher = more traffic)."
        },
        "check_path": {
          "type": "string",
          "default": "/health",
          "description": "HTTP path used for upstream health checks (optional)."
        },
        "check_interval": {
          "type": "number",
          "default": 10,
          "description": "Seconds between health checks (optional)."
        }
      }
    }
  },
  "features": {
    "type": "object",
    "default": {
      "experimental_features": [],
      "debug_mode": false
    },
    "description": "Feature toggles for advanced or experimental capabilities.",
    "items": {
      "experimental_features": {
        "type": "list",
        "default": [],
        "description": "List of experimental feature names to enable.",
        "items": {
          "type": "string"
        }
      },
      "debug_mode": {
        "type": "bool",
        "default": false,
        "description": "Enable verbose debugging output (affects log verbosity and adds debug headers)."
      }
    }
  }
}
