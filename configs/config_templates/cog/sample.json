{
  "url": "https://example.com/kiosk",
  "background_color": "#FFFFFF00",
  "scale": 1.2,
  "device_scale": 1.5,
  "doc_viewer": true,
  "webprocess_failure": "restart",
  "platform": "wl",
  "platform_params": [
    "enable-sandbox",
    "disable-gpu"
  ],
  "dir_handlers": [
    {
      "scheme": "app",
      "path": "/opt/cog-app"
    },
    {
      "scheme": "assets",
      "path": "/usr/share/cog-assets"
    }
  ],
  "web_extensions_dir": "/usr/lib/cog-webextensions",
  "content_filter": "/etc/cog/content-filter.json"
}
