[Network]
# Enable or disable LLMNR (Link-Local Multicast Name Resolution)
# Set to 'no' to disable, 'resolve' to enable only resolution, 'true' for both
LLMNR={{ llmnr }}

# Enable or disable mDNS (Multicast DNS)
MDNS={{ mdns }}

# Default DNSOverTLS mode: off, Opportunistic, or Strict
DNSOverTLS={{ dns_over_tls }}

# Default DNSSEC mode: false, true, allow-downgrade, or verify
DNSSEC={{ dnssec }}

# Whether to accept RDNSS (Router Advertisement DNS) information
# Set to 'false' to ignore RDNSS entries
AcceptRDNSS={{ accept_rdnss }}

# Whether to emit nss-systemd as a DNS resolver (e.g., for /etc/resolv.conf)
# Set to 'no' to disable
EmitDNS={{ emit_dns }}

# Number of DNS servers to keep in /etc/resolv.conf (0 = all)
# Set to 0 to include all servers
DNS={{ max_dns_servers }}

# Number of NTP servers to include (0 = all)
NTP={{ max_ntp_servers }}

# DNS server fallback servers (space- or comma-separated list of IPs)
# Not exposed as a list variable in schema to keep template simple; use literal in config
# FallbackDNS={{ fallback_dns }}

# DNS search domains (space- or comma-separated list)
# Not exposed as a list variable in schema to keep template simple; use literal in config
# DNSSearch={{ dns_search }}

# Default route for DNS/LLMNR/mDNS on interfaces
# Set to 'false' to disable default route usage
DefaultRoute={{ default_route }}

# IPv6 route priority offset (negative = higher priority)
IPv6RoutePriority={{ ipv6_route_priority }}

# Link-local address generation mode: none, yes, or both
# 'both' enables both IPv4LL and IPv6SL
LinkLocalAddressing={{ link_local_addressing }}

# IPv6 link-local address generation mode: none, yes, or both
# Note: deprecated in favor of LinkLocalAddressing in newer systemd
# IPv6LinkLocalAddressing={{ ipv6_link_local_addressing }}

# IPv6 hop limit for routing announcements (0 = default)
IPv6HopLimit={{ ipv6_hop_limit }}

# MTU override for interfaces (0 = use default)
MTUBytes={{ mtu_bytes }}

# Maximum number of addresses per interface
# Set to 0 to disable limit
MaximumRoutes={{ max_routes }}

# Whether to carry over existing network configuration on restart
# Set to 'true' to preserve configuration
 CarryOverMACAddress={{ carry_over_mac }}

# Whether to enable DHCPv4 on interfaces that support it
# 'true', 'false', or 'ipv6' (DHCPv4 only when no IPv6 config exists)
DHCP={{ dhcp }}

# Whether to send hostname to DHCP server
SendHostname={{ send_hostname }}

# Whether to send vendor class identifier (vendor class string)
SendVendorClass={{ send_vendor_class }}

# Whether to request specific DHCP options (comma-separated option numbers)
RequestOptions={{ request_options }}

# Whether to emit NTP via DHCP
EmitNTP={{ emit_ntp }}

# Whether to emit DNS via DHCP
EmitDNS={{ emit_dns }}

# Whether to emit Router Discovery (RA) info
EmitRouter={{ emit_router }}

# Whether to emit Timezone via DHCP
EmitTimezone={{ emit_timezone }}

# Whether to use NTP servers received via DHCP
UseNTP={{ use_ntp }}

# Whether to use DNS servers received via DHCP
UseDNS={{ use_dns }}

# Whether to use domain names received via DHCP
UseDomains={{ use_domains }}

# Whether to use time zone received via DHCP
UseTimezone={{ use_timezone }}

[Link]
# MAC address to assign to interfaces matching [Match] (if specified)
MACAddress={{ link_mac }}

# MTU to assign to interfaces matching [Match] (0 = default)
MTUBytes={{ link_mtu }}

# Name assigned to interfaces matching [Match] (e.g., 'lan0')
Name={{ link_name }}

# MAC address type: permanent, random, stable
MACAddressPolicy={{ mac_policy }}

# Whether to bring link up/down automatically
# Set to 'false' to leave link administratively down
ActivationPolicy={{ activation_policy }}

[DHCPv4]
# Whether to request default route via DHCPv4
UseDefaultRoute={{ dhcpv4_default_route }}

# Whether to request hostname via DHCPv4
SendHostname={{ dhcpv4_send_hostname }}

# Whether to use NTP servers received via DHCPv4
UseNTP={{ dhcpv4_use_ntp }}

# Whether to use DNS servers received via DHCPv4
UseDNS={{ dhcpv4_use_dns }}

# Whether to use domain names received via DHCPv4
UseDomains={{ dhcpv4_use_domains }}

# Whether to use time zone received via DHCPv4
UseTimezone={{ dhcpv4_use_timezone }}

[DHCPv6]
# Whether to use DHCPv6 for address assignment
UseAddress={{ dhcpv6_use_address }}

# Whether to use DHCPv6 for prefix delegation
UsePrefix={{ dhcpv6_use_prefix }}

# Whether to use DNS servers received via DHCPv6
UseDNS={{ dhcpv6_use_dns }}

# Whether to use NTP servers received via DHCPv6
UseNTP={{ dhcpv6_use_ntp }}

# Whether to use domain names received via DHCPv6
UseDomains={{ dhcpv6_use_domains }}

[IPv6AcceptRA]
# Whether to accept IPv6 Router Advertisements
# Set to 'false' to disable RA processing
Enabled={{ ipv6_accept_ra_enabled }}

# Whether to configure addresses from RA
UseAddress={{ ipv6_accept_ra_use_address }}

# Whether to configure default routes from RA
UseDefaultRoute={{ ipv6_accept_ra_default_route }}

# Whether to configure DNS from RA
UseDNS={{ ipv6_accept_ra_use_dns }}

# Whether to configure MTU from RA
UseMTU={{ ipv6_accept_ra_use_mtu }}

# Whether to configure NTP from RA
UseNTP={{ ipv6_accept_ra_use_ntp }}

# Whether to configure domain search list from RA
UseDomains={{ ipv6_accept_ra_use_domains }}

# Whether to configure hop limit from RA
UseHopLimit={{ ipv6_accept_ra_use_hop_limit }}

# Route table to use for RA routes (0 = default)
RouteTable={{ ipv6_accept_ra_route_table }}

# Route metric for RA routes (0 = default)
RouteMetric={{ ipv6_accept_ra_route_metric }}
