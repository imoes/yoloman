{
  "clear_default_bindings": true,
  "daemonize": false,
  "macro_record_key": "q",
  "macro_file_path": "~/.keynav_macros",
  "macro_playback_key": "shift+at",
  "start_keybinding": "ctrl+semicolon",
  "mouse_click_key": "space",
  "enter_click_key": "Return",
  "custom_command_binding": "v",
  "custom_command_action": "sh \"xdotool key shift+Insert\",end"
}
