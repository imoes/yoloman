<?xml version="1.0"?>
<!DOCTYPE catalog
  PUBLIC "-//OASIS//DTD Entity Resolution XML Catalog V1.0//EN"
  "http://www.oasis-open.org/committees/entity/release/1.0/catalog.dtd">
<!--
  Mallard XML Catalog Configuration
  Manages entity resolution for Mallard documentation resources (1.0 and 1.1).
  This file maps URI prefixes to local filesystem paths.
-->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">

  {# Mallard 1.0 Resources #}
  {# Filesystem path prefix for Mallard 1.0 documentation resources #}
  <rewriteSystem systemIdStartString="http://projectmallard.org/1.0/"
                 rewritePrefix="{{ mallard_1_0_path | default('/usr/share/xml/mallard/1.0') }}/"/>
  <rewriteURI uriStartString="http://projectmallard.org/1.0/"
              rewritePrefix="{{ mallard_1_0_path | default('/usr/share/xml/mallard/1.0') }}/"/>

  {# Mallard 1.1 Resources #}
  {# Filesystem path prefix for Mallard 1.1 documentation resources #}
  <rewriteSystem systemIdStartString="http://projectmallard.org/1.1/"
                 rewritePrefix="{{ mallard_1_1_path | default('/usr/share/xml/mallard/1.1') }}/"/>
  <rewriteURI uriStartString="http://projectmallard.org/1.1/"
              rewritePrefix="{{ mallard_1_1_path | default('/usr/share/xml/mallard/1.1') }}/"/>

  {# Mallard 1.0 Cache Resources #}
  {# Filesystem path prefix for Mallard 1.0 cache resources #}
  <rewriteSystem systemIdStartString="http://projectmallard.org/cache/1.0/"
                 rewritePrefix="{{ mallard_cache_1_0_path | default('/usr/share/xml/mallard/cache/1.0') }}/"/>
  <rewriteURI uriStartString="http://projectmallard.org/cache/1.0/"
              rewritePrefix="{{ mallard_cache_1_0_path | default('/usr/share/xml/mallard/cache/1.0') }}/"/>

  {# Mallard 1.1 Cache Resources #}
  {# Filesystem path prefix for Mallard 1.1 cache resources #}
  <rewriteSystem systemIdStartString="http://projectmallard.org/cache/1.1/"
                 rewritePrefix="{{ mallard_cache_1_1_path | default('/usr/share/xml/mallard/cache/1.1') }}/"/>
  <rewriteURI uriStartString="http://projectmallard.org/cache/1.1/"
              rewritePrefix="{{ mallard_cache_1_1_path | default('/usr/share/xml/mallard/cache/1.1') }}/"/>

  {# Mallard 1.0 IF Resources #}
  {# Filesystem path prefix for Mallard 1.0 IF resources #}
  <rewriteSystem systemIdStartString="http://projectmallard.org/if/1.0/"
                 rewritePrefix="{{ mallard_if_1_0_path | default('/usr/share/xml/mallard/if/1.0') }}/"/>
  <rewriteURI uriStartString="http://projectmallard.org/if/1.0/"
              rewritePrefix="{{ mallard_if_1_0_path | default('/usr/share/xml/mallard/if/1.0') }}/"/>

</catalog>
