# Darkplaces Server Configuration File
# Generated by Jinja2 template engine — DO NOT EDIT MANUALLY

# Server hostname displayed in server browser and to clients
hostname = {{ hostname }}

# Server port for gameplay (UDP)
port = {{ port }}

# Query port for server browser and status (UDP, usually same as port)
queryport = {{ queryport }}

# Maximum number of players allowed on the server
maxplayers = {{ maxplayers }}

# Map cycle list: maps rotated automatically
mapcyclefile = {{ mapcyclefile }}

# Enable dedicated mode (required for multiplayer servers)
dedicated = {{ dedicated }}

# Enable LAN-only mode (hide from public server browser)
lanserver = {{ lanserver }}

# RCON password for remote administration
rcon_password = {{ rcon_password }}

# Enable or disable player chat logging
log_chat = {{ log_chat }}

# Log file path for server console output
logfile = {{ logfile }}

# Time in seconds before an inactive player is auto-kicked
idlekick = {{ idlekick }}

# Time in seconds between server console output updates (0 = off)
timeleft = {{ timeleft }}

# Default map on server start (if mapcyclefile empty or failed)
defaultmap = {{ defaultmap }}

# Voice chat support
sv_voiceenable = {{ sv_voiceenable }}

# Voice codec quality (0 = low, 1 = high)
voice_codec = {{ voice_codec }}

# Rate at which voice packets are sent (ms)
voice_rate = {{ voice_rate }}

# Max number of voice clients (must be ≥ maxplayers)
maxclients = {{ maxclients }}

# Server rules (shown in server browser; multiple lines supported)
{% for rule in server_rules %}
# {{ rule.name }}
{% if rule.value %}{{ rule.key }} = {{ rule.value }}{% endif %}
{% endfor %}

# Server commands to run on map change
{% for cmd in map_change_commands %}
# {{ cmd.comment }}
addtoconinfo "{{ cmd.key }}" "{{ cmd.value }}"
{% endfor %}

# Additional cvars (user-defined or mod-specific)
{% for cvar in extra_cvars %}
{% if cvar.comment %}# {{ cvar.comment }}{% endif %}
{% if cvar.value %}{{ cvar.key }} = {{ cvar.value }}{% endif %}
{% endfor %}

# Whitelist file (optional: list of steamids or IPs allowed to join)
{% if whitelist_file %}whitelist_file = {{ whitelist_file }}{% endif %}
