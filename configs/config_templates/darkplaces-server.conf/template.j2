# Darkplaces Server Configuration File
# Generated by Ansible/Jinja2 — DO NOT EDIT MANUALLY
# This file configures the Darkplaces QuakeWorld/FitzQuake engine server.

# Server hostname displayed in server browser and to clients
# Schema: hostname (string, default='Darkplaces Server')
hostname = {{ hostname | default('Darkplaces Server') }}

# Server port for gameplay traffic (UDP)
# Schema: port (int, default=27500)
# Must be open in the host firewall for clients to connect.
port = {{ port | default(27500) }}

# Maximum number of concurrent players allowed on the server
# Schema: maxplayers (int, default=16)
maxplayers = {{ maxplayers | default(16) }}

# Map cycle list file: defines the rotation of maps
# Schema: mapcyclefile (string, default='mapcycle.txt')
# Paths are relative to the server root directory.
mapcyclefile = {{ mapcyclefile | default('mapcycle.txt') }}

# Run the server in dedicated mode (no local GUI client)
# Schema: dedicated (bool, default=True)
# Required for standard multiplayer server operation.
dedicated = {{ dedicated | default(True) | lower }}

# Server rules: cvars exposed to the server browser and clients
# Schema: server_rules (list of dicts with 'key', 'value', optional 'comment')
# Renders as `key = value` pairs. If a comment is provided, it appears above the line.
{% for rule in server_rules | default([]) %}
{%- if rule.comment is defined %}
# {{ rule.comment }}
{%- endif %}
{%- if rule.key is defined and rule.value is defined %}
{{ rule.key }} = {{ rule.value }}
{%- endif %}
{% endfor %}

# Commands to execute automatically on every map change
# Schema: map_change_commands (list of dicts with 'key', 'value', optional 'comment')
# Uses the `addtoconinfo` engine directive to inject commands into the map cycle.
{% for cmd in map_change_commands | default([]) %}
{%- if cmd.comment is defined %}
# {{ cmd.comment }}
{%- endif %}
{%- if cmd.key is defined and cmd.value is defined %}
addtoconinfo "{{ cmd.key }}" "{{ cmd.value }}"
{%- endif %}
{% endfor %}

# Additional/Extra configuration overrides
# Schema: extra_cvars (list of dicts with 'key', 'value', optional 'comment')
# Allows setting arbitrary engine cvars not covered by the primary fields.
{% for cvar in extra_cvars | default([]) %}
{%- if cvar.comment is defined %}
# {{ cvar.comment }}
{%- endif %}
{%- if cvar.key is defined and cvar.value is defined %}
{{ cvar.key }} = {{ cvar.value }}
{%- endif %}
{% endfor %}