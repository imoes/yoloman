# Revision number limit for triggering osc shell completion setup scripts.
# If the current revision number exceeds this value and the release is greater than 1,
# shell completion directives are installed.
onintr -
if (! $?prompt || ! $?tcsh) goto end
if ($tcsh == 1) goto end
set rev=$tcsh:r
set rel=$rev:e
set pat=$tcsh:e
set rev=$rev:r
if ($rev > {{ osc_completion_rev_limit | default(5) }} && $rel > 1) then
    if ( -s /usr/share/osc/complete ) complete osc 'p@*@`\/usr/share/osc/complete`@'
    if ( -s /usr/lib64/osc/complete ) complete osc 'p@*@`\/usr/lib64/osc/complete`@'
    if ( -s /usr/lib/osc/complete   ) complete osc 'p@*@`\/usr/lib/osc/complete`@'
endif
end:
    onintr