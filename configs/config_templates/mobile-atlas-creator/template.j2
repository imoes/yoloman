{# mobile-atlas-creator Configuration Template #}
{# ========================================== #}
{# This template generates the main configuration file for mobile-atlas-creator (MobAC). #}
{# MobAC typically uses Java properties or XML for map sources, but the core directories #}
{# are controlled via environment variables or system-wide defaults in this deployment. #}
{# #}
{# Directory Structure: #}
{# - config_dir: Per-user configuration files (typically ~/.config/mobac). #}
{# - cache_dir: Per-user cache data (typically ~/.mobac). #}
{# #}
{# This template sets the default directories for the application instance. #}

{# ======================================================================== #}
{# Directory for cache data.                                                #}
{# Default: /var/cache/mobac                                                #}
{# Documentation: ${HOME}/.mobac is the standard per-user cache directory.  #}
{# This setting overrides the default location for deployed configurations. #}
{# ======================================================================== #}
cache_dir={{ (values | default({})).cache_dir | default('/var/cache/mobac') }}

{# ======================================================================== #}
{# Directory for configuration files.                                       #}
{# Default: /etc/mobac                                                      #}
{# Documentation: ${HOME}//.config/mobac is the standard per-user config     #}
{# directory. This setting allows system-wide deployment of defaults.       #}
{# ======================================================================== #}
config_dir={{ (values | default({})).config_dir | default('/etc/mobac') }}

{# ======================================================================== #}
{# NOTE: mobile-atlas-creator is primarily a GUI application.               #}
{# Most configuration is stored in XML/JSON files within the config_dir     #}
{# (e.g., maps/mobac.xml) and managed via the UI. The properties above       #}
{# represent the high-level directory defaults which can be enforced via     #}
{# environment variables or wrapper scripts in automated deployments.        #}
{# ======================================================================== #}