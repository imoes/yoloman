{
  "interactive": false,
  "editor": "vim",
  "pager": "less",
  "shell": "bash",
  "history": true,
  "timeout": 120,
  "noconfirm": true,
  "color": true,
  "backupdir": "/var/lib/pacemaker/backup",
  "plugins": [
    {
      "name": "nagios",
      "options": {}
    },
    {
      "name": "sbd",
      "options": {
        "auto_disk": true,
        "timeout_watchdog": 30
      }
    }
  ],
  "cluster_name": "my-cluster",
  "crm_cibsh": "live",
  "crm_logfile_level": 3
}
