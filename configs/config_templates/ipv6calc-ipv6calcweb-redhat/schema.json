{
  "ipv6calcweb_document_root": {
    "type": "string",
    "default": "/var/www/ipv6calcweb",
    "description": "Document root directory for the ipv6calcweb CGI application."
  },
  "ipv6calcweb_mode": {
    "type": "string",
    "default": "info",
    "description": "Mode of CGI: info (default), form (display a form for user input), mixed (both).",
    "enum": [
      "info",
      "form",
      "mixed"
    ]
  },
  "ipv6calcweb_info_server": {
    "type": "string",
    "default": "0",
    "description": "Server information included: 0 (default), 1 (show information about server).",
    "enum": [
      "0",
      "1"
    ]
  },
  "ipv6calcweb_debug": {
    "type": "string",
    "default": "0",
    "description": "Debug to error log: 0 (default, disable), 1 (enable)."
  },
  "ipv6calc_bin_ipv6calc": {
    "type": "string",
    "default": "/usr/local/bin/ipv6calc-beta",
    "description": "Path to ipv6calc binary (optional)."
  },
  "ipv6calc_lib_ipv6calc": {
    "type": "string",
    "default": "/usr/local/lib64",
    "description": "Path to ipv6calc library (optional)."
  },
  "ipv6calc_db_ip2location_dir": {
    "type": "string",
    "default": "/var/local/share/IP2Location",
    "description": "IP2Location database directory (optional)."
  },
  "ipv6calc_db_geoip_dir": {
    "type": "string",
    "default": "/var/local/share/GeoIP",
    "description": "GeoIP database directory (optional)."
  },
  "ipv6calc_db_dbip_dir": {
    "type": "string",
    "default": "/var/local/share/DBIP/",
    "description": "DBIP database directory (optional)."
  },
  "ipv6calc_db_external_dir": {
    "type": "string",
    "default": "/var/local/share/ipv6calc/db/",
    "description": "External database directory (optional)."
  },
  "ipv6calc_username_geonamesorg": {
    "type": "string",
    "default": "demo",
    "description": "Username for link to geonames.org API (optional)."
  },
  "ipv6calc_db_geoip2": {
    "type": "string",
    "default": "1",
    "description": "General DB usage for GeoIP2: 1 (enable), 0 (disable).",
    "enum": [
      "0",
      "1"
    ]
  },
  "ipv6calc_db_dbip2": {
    "type": "string",
    "default": "1",
    "description": "General DB usage for DBIP2: 1 (enable), 0 (disable).",
    "enum": [
      "0",
      "1"
    ]
  },
  "ipv6calc_db_ip2location": {
    "type": "string",
    "default": "1",
    "description": "General DB usage for IP2Location: 1 (enable), 0 (disable).",
    "enum": [
      "0",
      "1"
    ]
  },
  "ipv6calc_db_ip2location2": {
    "type": "string",
    "default": "1",
    "description": "General DB usage for IP2Location2: 1 (enable), 0 (disable).",
    "enum": [
      "0",
      "1"
    ]
  },
  "ipv6calc_db_external": {
    "type": "string",
    "default": "0",
    "description": "General DB usage for External: 1 (enable), 0 (disable).",
    "enum": [
      "0",
      "1"
    ]
  }
}
