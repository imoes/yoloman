# pagemon configuration file
# This template configures pagemon, a tool to monitor a process's page map usage.
# It generates a static configuration file with defaults for all options.

# pid: The process ID or name of the process to monitor. If a name is given,
# pagemon monitors the first matching process.
pid: {{ pid | default('1') }}

# delay: Delay in microseconds between data refreshes.
delay: {{ delay | default(10000) }}

# zoom: Default zoom level on page view. Higher values increase the zoom level
# so more pages are represented.
zoom: {{ zoom | default(1) }}

# ticks: Ticks between dirty page checks. Larger values mean longer time
# between checks.
ticks: {{ ticks | default(60) }}

# auto_zoom: Enable automatic zoom mode to show the entire page map.
auto_zoom: {{ auto_zoom | default(false) | lower }}

# vm_info: Enable VM information view.
vm_info: {{ vm_info | default(false) | lower }}

# read_pages: Force all pages in the process to be read into physical memory.
read_pages: {{ read_pages | default(false) | lower }}