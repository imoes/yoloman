# Desktop entry configuration for the Chatty daemon service.
# This file defines how the system launches and identifies the Chatty application in daemon mode.

# Name=Chats (daemon)
# Description: The display name shown in desktop menus and application launchers.
# This is a static label; no variable substitution needed here.
[Desktop Entry]

# Exec=
# Description: The command to execute for the Chatty daemon service.
# Uses the chatty_exec variable, defaulting to 'chatty --gapplication-service'.
Exec={{ chatty_exec | default('chatty --gapplication-service') }}

# Icon=
# Description: The icon identifier for the Chatty desktop entry.
# Uses the chatty_icon variable, defaulting to 'sm.puri.Chatty'.
Icon={{ chatty_icon | default('sm.puri.Chatty') }}

# Comment=
# Description: Description comment for the Chatty desktop entry.
# Uses the chatty_comment variable, defaulting to 'SMS/MMS, Matrix and XMPP chat application (daemon mode)'.
Comment={{ chatty_comment | default('SMS/MMS, Matrix and XMPP chat application (daemon mode)') }}

