# Terminal=
# Description: Indicates if the application requires a terminal to run.
# Set to false as this is a daemon/application service.
Terminal=false

# Type=
# Description: Specifies the type of desktop entry.
# Set to Application.
Type=Application

# Categories=
# Description: Categories in which the application should be listed.
# Set to Network and Chat-related categories.
Categories=Network;GNOME;GTK;Chat;InstantMessaging;

# NoDisplay=
# Description: If true, the application will not be displayed in the menu system.
# Set to true for the daemon entry.
NoDisplay=true

# X-GNOME-AutoRestart=
# Description: If true, GNOME will automatically restart the application if it quits.
# Set to true for the daemon.
X-GNOME-AutoRestart=true