# /etc/chrpath/chrpath — chrpath default configuration
#
# This file lists the binaries that chrpath should process.
# Each line must contain an absolute path to a valid executable
# that currently has an RPATH/RUNPATH entry.
#
# The list is provided by the 'binaries' variable.

# Iterate over the list of binaries to configure chrpath for.
# Defaults to an empty list if not provided.
{% for binary in (binaries | default([])) %}# Binary: {{ binary | string }}
{{ binary | string }}

{% endfor %}