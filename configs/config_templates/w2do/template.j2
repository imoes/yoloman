# ==============================================================================
# Configuration file for w2do (text-based todo manager)
#
# This file is auto-generated by an Ansible Jinja2 template.
# It serves as a persistent configuration or a wrapper script definition
# for the `w2do` CLI tool.
#
# For manual usage, refer to the w2do(1) man page.
# ==============================================================================

# --------------------------------------------------------------------------
# Core Settings
# --------------------------------------------------------------------------

# W2DO_SAVEFILE: Path to the w2do save file.
# Defaults to ~/.w2do. This file stores all tasks.
savefile: {{ savefile|default('~/.w2do') }}

# W2DO_WIDTH: Line width for output display.
# Minimal value is 75. Defaults to 80.
width: {{ width|default(80) }}

# --------------------------------------------------------------------------
# Display Settings
# --------------------------------------------------------------------------

# W2DO_COLOUR: Enable coloured output.
# If true, uses --colour/-C. If false, uses plain text.
# Defaults to false.
colour: {{ colour|default(false) | lower }}

# W2DO_BARE: Do not display table header and group separators.
# If true, uses --bare/-b. Useful for scripting/parsing.
# Defaults to false.
bare: {{ bare|default(false) | lower }}

# W2DO_WITH_ID: Display ID column in listings.
# If true, uses --with-id/-I. If false, uses --no-id.
# Defaults to true.
with_id: {{ with_id|default(true) | lower }}

# W2DO_WITH_GROUP: Display group column in listings.
# If true, uses --with-group/-G. If false, uses --no-group.
# Defaults to true.
with_group: {{ with_group|default(true) | lower }}

# W2DO_WITH_DATE: Display due date column in listings.
# If true, uses --with-date/-D. If false, uses --no-date.
# Defaults to true.
with_date: {{ with_date|default(true) | lower }}

# W2DO_WITH_PRIORITY: Display priority column in listings.
# If true, uses --with-priority/-P. If false, uses --no-priority.
# Defaults to true.
with_priority: {{ with_priority|default(true) | lower }}

# W2DO_WITH_STATE: Display state column in listings.
# If true, uses --with-state/-S. If false, uses --no-state.
# Defaults to true.
with_state: {{ with_state|default(true) | lower }}

# W2DO_VERBOSE: Display all messages (verbose mode).
# If true, uses -V/--verbose. If false, uses -q/--quiet.
# Defaults to true.
verbose: {{ verbose|default(true) | lower }}