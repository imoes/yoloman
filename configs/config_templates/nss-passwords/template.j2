# nss-passwords configuration file
# Self-documented and safe for Ansible reuse.
# Each directive is preceded by its schema description and uses explicit defaults.

# Directory path to the Mozilla Firefox/Thunderbird profile containing the keyrings.
# Corresponds to the -d option.
profile_dir = {{ profile_dir | default('/home/user/.mozilla/firefox/default') }}

# Path to the pinentry program used for authentication.
# Corresponds to the -p option.
pinentry_prog = {{ pinentry_prog | default('/usr/bin/pinentry') }}