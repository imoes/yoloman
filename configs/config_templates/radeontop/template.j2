# /etc/default/radeontop
# Configuration file for radeontop

# Bus number of the specific GPU to monitor (e.g., 1 from lspci output 01:00.0)
# Corresponds to: -b, --bus
BUS={{ bus }}

# Enable colorized output
# Corresponds to: -c, --color
COLOR={{ color | lower }}

# Dump mode: path to file to append data to, or '-' for stdout
# Corresponds to: -d, --dump
DUMP_FILE={{ dump_file }}

# Number of seconds to wait between data output
# Corresponds to: -i, --dump-interval
DUMP_INTERVAL={{ dump_interval }}

# Quit after dumping limit lines (only valid in dump mode)
# Corresponds to: -l, --limit
LIMIT={{ limit }}

# Force use of /dev/mem path for memory info
# Corresponds to: -m, --mem
USE_MEM={{ use_mem | lower }}

# DRM device node path (e.g., /dev/dri/card0)
# Corresponds to: -p, --path
DRM_PATH={{ drm_path }}

# Sampling frequency in ticks (times per second)
# Corresponds to: -t, --ticks
TICKS={{ ticks }}

# Combine all options into command-line flags
{% if bus is not none %}--bus {{ bus }} {% endif %}{% if color %}--color {% endif %}{% if dump_file is not none %}--dump {{ dump_file }} {% endif %}{% if dump_interval is not none %}--dump-interval {{ dump_interval }} {% endif %}{% if limit is not none %}--limit {{ limit }} {% endif %}{% if use_mem %}--mem {% endif %}{% if drm_path is not none %}--path {{ drm_path }} {% endif %}{% if ticks is not none %}--ticks {{ ticks }} {% endif %}
