# Jcal configuration template
# Self-documenting: all fields use their schema defaults and descriptions.

# The year (1-9999) to display. Must be fully specified.
year: {{ year | default(1403) }}

# The month (1-12) to display. Ignored if yearly is true.
month: {{ month | default(1) }}

# Enable Julian dates output (-j flag).
julian: {{ julian | default(false) }}

# Enable Farsi numbers and names (-p flag).
farsi: {{ farsi | default(false) }}

# Display year based on Pahlavi epoch (-P flag).
pahlavi: {{ pahlavi | default(false) }}

# Display English names for weekdays (-e flag).
english: {{ english | default(false) }}

# Display a calendar for the entire year (-y flag).
yearly: {{ yearly | default(false) }}

# Display previous, current, and next month output (-3 flag).
three_month: {{ three_month | default(false) }}