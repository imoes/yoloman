{
  "XFaces.soundPath": {
    "type": "string",
    "default": "/usr/sounds:/usr/demo/SOUND/sounds",
    "description": "Colon-separated path list where xfaces looks for sound files."
  },
  "XFaces.imagePath": {
    "type": "string",
    "default": "/usr/share/xfaces/images",
    "description": "Path where xfaces looks for image files."
  },
  "XFaces.facedbPath": {
    "type": "string",
    "default": "/usr/share/picons/:/usr/share/picons/users:/usr/share/picons/domains:/usr/share/picons/unknown",
    "description": "Colon-separated path list for the facedb (face database) search paths."
  },
  "XFaces.annotationCount": {
    "type": "number",
    "default": 2,
    "description": "Number of different annotations."
  },
  "XFaces.unknownAnnotationCount": {
    "type": "number",
    "default": 2,
    "description": "Number of annotations for unknown faces."
  },
  "XFaces.Annotation.font": {
    "type": "string",
    "default": "-*-helvetica-*-r-*--10-*",
    "description": "Font used for annotations."
  },
  "XFaces.annotation1.x": {
    "type": "number",
    "default": 2,
    "description": "X coordinate for annotation 1."
  },
  "XFaces.annotation1.y": {
    "type": "number",
    "default": -2,
    "description": "Y coordinate for annotation 1."
  },
  "XFaces.unknownAnnotation1.x": {
    "type": "number",
    "default": 2,
    "description": "X coordinate for unknown annotation 1."
  },
  "XFaces.unknownAnnotation1.y": {
    "type": "number",
    "default": -2,
    "description": "Y coordinate for unknown annotation 1."
  },
  "XFaces.annotation2.x": {
    "type": "number",
    "default": -2,
    "description": "X coordinate for annotation 2."
  },
  "XFaces.annotation2.y": {
    "type": "number",
    "default": -2,
    "description": "Y coordinate for annotation 2."
  },
  "XFaces.unknownAnnotation2.x": {
    "type": "number",
    "default": -2,
    "description": "X coordinate for unknown annotation 2."
  },
  "XFaces.unknownAnnotation2.y": {
    "type": "number",
    "default": -2,
    "description": "Y coordinate for unknown annotation 2."
  },
  "XFaces.mail.annotation1": {
    "type": "string",
    "default": "user",
    "description": "Content of annotation 1 for mail messages."
  },
  "XFaces.mail.annotation2": {
    "type": "string",
    "default": "count",
    "description": "Content of annotation 2 for mail messages."
  },
  "XFaces.mail.unknownAnnotation1": {
    "type": "string",
    "default": "user",
    "description": "Content of unknown annotation 1 for mail messages."
  },
  "XFaces.mail.unknownAnnotation2": {
    "type": "string",
    "default": "count",
    "description": "Content of unknown annotation 2 for mail messages."
  },
  "XFaces.xpm.filterCount": {
    "type": "number",
    "default": 1,
    "description": "Number of XPM conversion filters."
  },
  "XFaces.xpmFilter.name": {
    "type": "string",
    "default": "gif",
    "description": "Name of the XPM conversion filter."
  },
  "XFaces.xpmFilter.filter": {
    "type": "string",
    "default": "giftopnm %s | ppmtoxpm",
    "description": "Command used for XPM conversion filter."
  },
  "XFaces.xpmFilter.extension": {
    "type": "string",
    "default": ".gif",
    "description": "File extension handled by the XPM conversion filter."
  },
  "XFaces.noMailImage": {
    "type": "string",
    "default": "nomail",
    "description": "Image displayed when there is no mail."
  },
  "XFaces.noMailSound": {
    "type": "string",
    "default": "NoMail",
    "description": "Sound played when there is no mail."
  },
  "XFaces.volume": {
    "type": "number",
    "default": 50,
    "description": "Volume level for sound playback."
  },
  "XFaces.fromField": {
    "type": "string",
    "default": "From:",
    "description": "RFC822 header field used for the From address."
  },
  "weather.listCommand": {
    "type": "string",
    "default": "wx.faces",
    "description": "Command to use for the 'weather' instance instead of builtin mail check."
  },
  "weather.facedbPath": {
    "type": "string",
    "default": "/usr/lib/picon/weather",
    "description": "Path for the facedb for the 'weather' instance."
  },
  "weather.compressImages": {
    "type": "bool",
    "default": false,
    "description": "Whether to compress images for the 'weather' instance."
  },
  "weather.keepOrder": {
    "type": "bool",
    "default": true,
    "description": "Whether to keep order for the 'weather' instance."
  },
  "weather.shapeExtra": {
    "type": "bool",
    "default": false,
    "description": "Shape extra for the 'weather' instance."
  },
  "weather.update": {
    "type": "number",
    "default": 900,
    "description": "Update interval for the 'weather' instance."
  },
  "XFaces.allowShellResize": {
    "type": "bool",
    "default": true,
    "description": "Allow shell resize for XFaces."
  },
  "XFaces.frame.tileWidth": {
    "type": "number",
    "default": 64,
    "description": "Tile width for frames."
  },
  "XFaces.frame.tileHeight": {
    "type": "number",
    "default": 64,
    "description": "Tile height for frames."
  },
  "XFaces.frame.horizSpacing": {
    "type": "number",
    "default": 4,
    "description": "Horizontal spacing in frames."
  },
  "XFaces.frame.vertSpacing": {
    "type": "number",
    "default": 4,
    "description": "Vertical spacing in frames."
  },
  "XFaces.frame.internalWidth": {
    "type": "number",
    "default": 2,
    "description": "Internal width of frames."
  },
  "XFaces.frame.internalHeight": {
    "type": "number",
    "default": 2,
    "description": "Internal height of frames."
  },
  "XFaces.frame.borderWidth": {
    "type": "number",
    "default": 0,
    "description": "Border width of frames."
  },
  "XFaces.frame.maxWidth": {
    "type": "number",
    "default": 4,
    "description": "Max width of frames."
  },
  "XFaces.frame.Label.width": {
    "type": "number",
    "default": 64,
    "description": "Width of frame labels."
  },
  "XFaces.frame.Label.height": {
    "type": "number",
    "default": 64,
    "description": "Height of frame labels."
  },
  "XFaces.frame.Label.internalWidth": {
    "type": "number",
    "default": 0,
    "description": "Internal width of frame labels."
  },
  "XFaces.frame.Label.internalHeight": {
    "type": "number",
    "default": 0,
    "description": "Internal height of frame labels."
  },
  "XFaces.frame.Label.borderWidth": {
    "type": "number",
    "default": 2,
    "description": "Border width of frame labels."
  },
  "XFaces.frame.translations": {
    "type": "string",
    "default": "<Btn2Up>:CheckMail()\n",
    "description": "Translations for the frame widget."
  },
  "XFaces.image.mailer_daemon": {
    "type": "string",
    "default": "mailer-daemon",
    "description": "Image name for mailer-daemon."
  },
  "XFaces.sound.mailer_daemon": {
    "type": "string",
    "default": "bong",
    "description": "Sound name for mailer-daemon."
  },
  "XFaces.image.uucp": {
    "type": "string",
    "default": "uucp",
    "description": "Image name for uucp mail."
  },
  "XFaces.sound.uucp": {
    "type": "string",
    "default": "computer",
    "description": "Sound name for uucp mail."
  },
  "XFaces.image.root": {
    "type": "string",
    "default": "root",
    "description": "Image name for root mail."
  },
  "XFaces.sound.root": {
    "type": "string",
    "default": "busy",
    "description": "Sound name for root mail."
  }
}
