# slurmrestd configuration generated by Ansible
#
# This file configures slurmrestd, the REST daemon for Slurm.
# It controls network listening, plugin loading, concurrency, security context, and verbose/debug modes.
# See slurmrestd(8) for detailed documentation of each option.

# List of host:port pairs or unix:/path/to/socket strings to listen on.
# Example: ["unix:/var/run/slurm/restd.sock", "0.0.0.0:6820"]
# Corresponds to: <[host]:port|unix:/path/to/socket>...
# See: slurmrestd(8) SYNOPSIS
LISTEN={{ (listen_addresses | default([])) | join(", ") }}

# Comma-delimited list of authentication plugins to load.
# Example: ["rest_auth/local", "rest_auth/jwt"]
# Corresponds to: -a <plugin>[,plugin]...
# See: slurmrestd(8) OPTIONS -a
AUTH_PLUGINS={{ (auth_plugins | default(['rest_auth/local'])) | join(", ") }}

# Comma-delimited list of data_parser plugins to load.
# Example: ["v0.0.42", "latest"]
# Corresponds to: -d <plugin>[,plugin]...
# See: slurmrestd(8) OPTIONS -d
DATA_PARSER_PLUGINS={{ (data_parser_plugins | default(['v0.0.42'])) | join(", ") }}

# Comma-delimited list of OpenAPI plugins to load.
# Example: ["slurmctld", "slurmdbd"]
# Corresponds to: -s <plugin>[,plugin]...
# See: slurmrestd(8) OPTIONS -s
OPENAPI_PLUGINS={{ (openapi_plugins | default(['slurmctld', 'slurmdbd'])) | join(", ") }}

# Maximum number of connections to process at any one time.
# Corresponds to: --max-connections <count>
# Default: 124
# See: slurmrestd(8) OPTIONS --max-connections
MAX_CONNECTIONS={{ max_connections | default(124) }}

# Number of threads to use to process client connections.
# Corresponds to: -t <THREAD COUNT>
# Default: 20
# See: slurmrestd(8) OPTIONS -t
THREAD_COUNT={{ thread_count | default(20) }}

# User ID to change to before processing client request.
# Leave empty to keep default user.
# Note: Must not be root or SlurmUser
# Corresponds to: -u <user id>
# See: slurmrestd(8) OPTIONS -u
USER_ID={{ user_id | default('') }}

# Group ID to change to before processing client request.
# Leave empty to keep default group.
# Note: Must not be root or SlurmUser's group
# Corresponds to: -g <group id>
# See: slurmrestd(8) OPTIONS -g
GROUP_ID={{ group_id | default('') }}

# Enable verbose operation (-v flag).
# Corresponds to: -v
# See: slurmrestd(8) OPTIONS -v
VERBOSE={{ verbose | default(false) | lower }}

# Debug flags for slurmrestd.
# Overrides SLURM_DEBUG_FLAGS. Example: 'partition,jobstep'
# Corresponds to: SLURM_DEBUG_FLAGS env var
# See: slurmrestd(8) ENVIRONMENT VARIABLES SLURM_DEBUG_FLAGS
DEBUG_FLAGS={{ debug_flags | default('') }}

# Security functionality controls.
# Values: become_user, disable_unshare_files, disable_unshare_sysv, disable_user_check.
# Example: ["disable_unshare_files", "disable_user_check"]
# Corresponds to: SLURMRESTD_SECURITY env var
# See: slurmrestd(8) ENVIRONMENT VARIABLES SLURMRESTD_SECURITY
SECURITY={{ (security | default([])) | join(", ") }}

# Path to the Slurm configuration file.
# Overrides SLURM_CONF environment variable.
# Corresponds to: -f <file>
# See: slurmrestd(8) OPTIONS -f
SLURM_CONF={{ slurm_conf | default('/etc/slurm/slurm.conf') }}