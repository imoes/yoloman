{
 "auth_plugins": [
  "rest_auth/local",
  "rest_auth/jwt"
 ],
 "data_parser_plugins": [
  "v0.0.42"
 ],
 "debug_flags": "partition,jobstep",
 "group_id": "slurm",
 "listen_addresses": [
  "unix:/var/run/slurm/restd.sock",
  "10.0.0.1:6820"
 ],
 "max_connections": 200,
 "openapi_plugins": [
  "slurmctld",
  "slurmdbd"
 ],
 "security": [
  "disable_user_check"
 ],
 "slurm_conf": "/etc/slurm/slurm.conf",
 "thread_count": 50,
 "user_id": "slurm",
 "verbose": false
}
