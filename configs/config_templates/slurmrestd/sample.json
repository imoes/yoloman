{
  "listen_addresses": [
    "unix:/var/run/slurm/restd.sock",
    "10.0.0.1:6820"
  ],
  "auth_plugins": [
    "rest_auth/local",
    "rest_auth/jwt"
  ],
  "data_parser_plugins": [
    "v0.0.42"
  ],
  "openapi_plugins": [
    "slurmctld",
    "slurmdbd"
  ],
  "max_connections": 200,
  "thread_count": 50,
  "user_id": "slurm",
  "group_id": "slurm",
  "verbose": false,
  "debug_flags": "partition,jobstep",
  "security": [
    "disable_user_check"
  ],
  "slurm_conf": "/etc/slurm/slurm.conf"
}
