{
  "scan_root": "/home/user",
  "index_file": "/var/cache/agedu/agedu.dat",
  "listen_address": "127.0.0.1",
  "port": 48638,
  "auth_mode": "magic",
  "cross_fs": false,
  "dir_atime": true,
  "mtime": false,
  "progress": true,
  "prune": [
    "*.tmp",
    "*.old"
  ],
  "prune_path": [
    "/tmp/*",
    "/var/cache/*"
  ],
  "exclude": [
    "*.log"
  ],
  "exclude_path": [
    "/var/log/*"
  ],
  "include": [
    "*.mp3"
  ],
  "include_path": [
    "/music/*"
  ],
  "age_range": "6m",
  "files": false,
  "depth": 1,
  "output_dir": "",
  "numeric_names": false,
  "launch": "browse",
  "no_eof": false,
  "tty_progress": false,
  "auth_file": ""
}
