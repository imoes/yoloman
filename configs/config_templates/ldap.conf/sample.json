{
  "uri": "ldap://ldap1.example.com ldap://ldap2.example.com",
  "base_dn": "dc=example,dc=com",
  "ldap_version": 3,
  "timelimit": 10,
  "sizelimit": 1000,
  "tls_ca_cert_path": "/etc/ssl/certs/ca-certificates.crt",
  "tls_reqcert": "demand",
  "sasl_enabled": false,
  "sasl_mech": "GSSAPI",
  "sasl_realm": "EXAMPLE.COM",
  "sasl_authcid": "ldap/admin",
  "referrals": "follow",
  "bind_dn": "cn=admin,dc=example,dc=com",
  "bind_pw": "secret",
  "extra_options": [
    {
      "key": "NCSA_AUTH",
      "value": "yes",
      "comment": "Enable NCSA-style authentication"
    },
    {
      "key": "TLS_CIPHER_SUITE",
      "value": "HIGH:MEDIUM:+TLSv1",
      "comment": "Permitted cipher suites for TLS"
    }
  ]
}
