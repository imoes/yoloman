{
  "backspace": "indent,eol,start",
  "viminfo_size": 20,
  "viminfo_registers": 50,
  "history": 50,
  "ttimeoutlen": 100,
  "scrolloff": 5,
  "swap_directories": "~/tmp,/var/tmp,/tmp",
  "cscope_binary": "/usr/bin/cscope",
  "c_comment_strings": true,
  "terminal_type": "xterm",
  "terminal_colors": 8,
  "local_config_file": "/etc/vimrc.local"
}
