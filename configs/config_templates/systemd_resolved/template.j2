# /etc/systemd/resolved.conf — systemd-resolved DNS stub resolver configuration
# Enable LLMNR (Link-Local Multicast Name Resolution)
# LLMNR allows hostname resolution on the local network segment without a DNS server.
LLMNR=yes

# Enable mDNS (multicast DNS, e.g., for .local domains)
# Set to 'resolve' to allow mDNS queries to be forwarded, 'resolve' to answer locally, or 'no' to disable.
MulticastDNS=yes

# DNSOverTLS mode: 'no', 'opportunistic', or 'yes'
# 'opportunistic' uses TLS when available but falls back to plain DNS; 'yes' enforces TLS.
DNSOverTLS=opportunistic

# DNSSEC mode: 'no', 'true', 'allow-downgrade', or 'force'
# Controls validation of DNSSEC records. 'true' requires validation; 'allow-downgrade' falls back if validation fails.
DNSSEC=allow-downgrade

# DNSSEC Negative Trust Anchors (comma-separated domain list)
# Domains for which DNSSEC validation is disabled (e.g., for legacy or private zones).
DNSSecNegativeTrustAnchors=

# Default DNS servers for this system
# Replace with actual upstream DNS resolvers (IP addresses or hostnames).
DNS=

# Default DNS domains for search resolution
# Domains appended to unqualified hostnames during resolution.
Domains=

# DNS stub listener on loopback (127.0.0.53)
# If 'yes', systemd-resolved listens on 127.0.0.53:53 for local queries.
DNSStubListener=yes

# DNSStubListenerExtra (list of extra addresses for DNS stub listener)
# Additional IPs (e.g., for IPv6 or multi-homed hosts) to bind DNS stub listener to.
DNSStubListenerExtra=

# Read resolv.conf (yes/no)
# If 'yes', systemd-resolved reads /etc/resolv.conf and merges it with its own DNS config.
ReadResolvConf=yes

# Cache size (positive integer or 'no')
# Number of entries in the DNS cache. Set to 'no' to disable caching.
Cache=yes

# DNSMaxPackeSize — maximum DNS packet size (512–65535)
# Adjust for EDNS0 support or large responses. Default is 4096.
DNSMaxPacketSize=4096

# Fallback DNS servers — used when no DNS is configured via other means
# Typically reserved for link-local or private use when upstream DNS is unavailable.
FallbackDNS=

# Link-local Multicast Resolver port (1-65535)
# Port for mDNS/LLMNR listener; only change if port conflict occurs.
LLMNRPort=5353
MulticastDNSPort=5353

# LLMNR timeout in milliseconds (100–30000)
# How long to wait for LLMNR responses before giving up.
LLMNRTimeoOut=2500

# mDNS timeout in milliseconds (100–30000)
# How long to wait for mDNS responses before giving up.
MulticastDNSTimeoOut=2500
