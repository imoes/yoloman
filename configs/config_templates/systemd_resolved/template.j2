# /etc/systemd/resolved.conf — systemd-resolved DNS stub resolver configuration
# This template is self-documenting: every directive is preceded by its schema description.
# All variables use explicit defaults to ensure safe rendering even when variables are undefined.

[Resolve]

# Enable or disable Link-Local Multicast Name Resolution (LLMNR). Use 'yes' to allow local hostname resolution via broadcast/multicast.
LLMNR={{ LLMNR | default('yes') }}

# Enable or disable mDNS. Accepts 'yes' (respond to local queries), 'resolve' (forward queries to mDNS), or 'no' (disable).
MulticastDNS={{ MulticastDNS | default('yes') }}

# DNS-over-TLS mode. 'opportunistic' prefers encryption but falls back to plain DNS; 'yes' enforces TLS; 'no' disables DoT.
DNSOverTLS={{ DNSOverTLS | default('opportunistic') }}

# DNSSEC validation mode. 'allow-downgrade' validates unless upstream doesn’t support it; 'true' requires validation; 'no' disables it.
DNSSEC={{ DNSSEC | default('allow-downgrade') }}

# List of domains for which DNSSEC validation is explicitly disabled (e.g., internal zones without DNSSEC support).
# Joined by space as per systemd-resolved.conf syntax.
DNSSecNegativeTrustAnchors={{ DNSSecNegativeTrustAnchors | default([]) | join(' ') }}

# Upstream DNS servers to use (IP addresses or resolvable hostnames). Systemd will prefer these over DHCP-provided servers unless overridden.
# Joined by space.
DNS={{ DNS | default([]) | join(' ') }}

# Search domains appended to unqualified hostnames during DNS lookups.
# Joined by space.
Domains={{ Domains | default([]) | join(' ') }}

# If true, systemd-resolved provides a stub resolver at 127.0.0.53:53 for local services to query.
DNSStubListener={{ DNSStubListener | default(True) }}

# Additional IPs (e.g., IPv6 addresses or container IPs) where the DNS stub listener should bind. Useful in containerized environments.
# Joined by space.
DNSStubListenerExtra={{ DNSStubListenerExtra | default([]) | join(' ') }}

# If true, systemd-resolved reads and merges /etc/resolv.conf. Disable if you want systemd-resolved to fully manage DNS without legacy config
ReadResolvConf={{ ReadResolvConf | default(True) }}

# DNS caching behavior. Set to 'yes' to enable (default size), or 'no' to disable caching.
Cache={{ Cache | default('yes') }}

# Maximum DNS packet size (including EDNS0). Increase to 65535 if you rely on large DNS responses (e.g., DNSSEC with many records).
DNSMaxPacketSize={{ DNSMaxPacketSize | default(4096) }}

# Fallback DNS servers used when no other DNS configuration is available (e.g., during early boot or without DHCP). Often used for private/res
# Joined by space.
FallbackDNS={{ FallbackDNS | default([]) | join(' ') }}

# UDP port used for LLMNR traffic. Only change if port 5353 is unavailable.
LLMNRPort={{ LLMNRPort | default(5353) }}

# UDP port used for mDNS traffic. Only change if port 5353 is unavailable.
MulticastDNSPort={{ MulticastDNSPort | default(5353) }}

# Time in milliseconds to wait for LLMNR responses before giving up. Higher values improve reliability on slow networks.
LLMNRTimeoOut={{ LLMNRTimeoOut | default(2500) }}

# Time in milliseconds to wait for mDNS responses before giving up. Higher values improve reliability on slow networks.
MulticastDNSTimeoOut={{ MulticastDNSTimeoOut | default(2500) }}