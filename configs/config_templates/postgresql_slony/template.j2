# =============================================================================
# Slony-I Configuration File
# Generated by Ansible Jinja2 Template
#
# This file configures the Slony-I replication cluster.
# It defines cluster identity, database connection details, logging,
# node topology, replication paths, and schema objects (tables/sequences).
#
# IMPORTANT: The 'clustername' MUST be identical on all participating nodes.
# =============================================================================

# --- Cluster Identity ---

# Name of the Slony-I replication cluster — must be identical on all nodes.
clustername = '{{ cluster_name | default("slony_cluster") }}';

# Directory where Slony-I daemon logs are stored.
logdir = '{{ log_dir | default("/var/log/slony1") }}';

# --- Primary Database Connection ---

# Connection string for the primary PostgreSQL server.
# Contains: database name, host, port, and replication user.
conn_info = 'dbname={{ database_name | default("slony1") }} host={{ primary_host | default("localhost") }} port={{ primary_port | default(5432) }} user={{ slony_user | default("slony") }}';

# --- Daemon Behavior & Logging ---

# Seconds between health checks and replication heartbeat polling.
# default: 60
pollinterval = {{ poll_interval | default(60) }};

# Seconds to wait before retrying a failed connection to a node.
# default: 15
retry_timeout = {{ retry_timeout | default(15) }};

# Number of connection retries before marking a node as failed.
# default: 3
retry_count = {{ retry_count | default(3) }};

# Enable verbose logging for debugging (true/false).
# default: false
verbose = {{ verbose | default(false) | lower }};

# Path to the Slony-I daemon PID file.
# default: /run/slony1/slony.pid
pidfile = '{{ pidfile_path | default("/run/slony1/slony.pid") }}';

# --- Node Definitions ---

# List of PostgreSQL nodes in the Slony-I cluster (primary and replicas).
# Each node block defines the connection parameters for that specific node.
{% for node in nodes | default([]) %}
# Node {{ loop.index }}: {{ node.name | default('node_' ~ loop.index) }} (id = {{ node.id | default(loop.index) }})
# Description: Defines a PostgreSQL server participating in the replication cluster.
{{ node.name | default('node_' ~ loop.index) }} = {
  # Unique integer ID for this node within the cluster.
  id = {{ node.id | default(loop.index) }};
  # Human-readable alias for this node.
  alias = '{{ node.alias | default("") }}';
  # Hostname or IP address of this PostgreSQL node.
  host = '{{ node.host | default("localhost") }}';
  # Port number for the PostgreSQL instance.
  port = {{ node.port | default(primary_port | default(5432)) }};
  # Database user with replication privileges.
  user = '{{ node.user | default(slony_user | default("slony")) }}';
  # Password for the replication user.
  password = '{{ node.password | default("") }}';
  # Name of the Slony-I admin database on this node.
  dbname = '{{ node.dbname | default(database_name | default("slony1")) }}';
};
{% endfor %}

# --- Replication Paths ---

# List of replication paths (source → target) between nodes.
# A path defines how data flows from one node to another.
{% for path in paths | default([]) %}
# Replication path {{ loop.index }}: {{ path.source | default(0) }} → {{ path.target | default(0) }}
# Description: Defines the route for replication events between two nodes.
path_{{ path.source | default(0) }}_to_{{ path.target | default(0) }} = {
  # ID of the source node (where data originates).
  source = {{ path.source | default(0) }};
  # ID of the target node (where data is received).
  target = {{ path.target | default(0) }};
  # Forwarder node (if intermediate node is used); null if direct.
{% if path.forwarder is defined and path.forwarder != None and path.forwarder | default(0) | int != 0 %}
  forwarder = {{ path.forwarder | default(0) }};
{% else %}
  forwarder = 0;
{% endif %}
  # Acknowledgment mode: 0 = none, 1 = sync (block), 2 = async (non-blocking).
  # default: 1
  acknowledge = {{ path.ack_mode | default(1) }};
};
{% endfor %}

# --- Managed Sequences ---

# Optional list of PostgreSQL sequences to be managed by Slony-I.
# Sequences are often used for auto-incrementing primary keys.
{% for seq in sequences | default([]) %}
# Sequence {{ seq.name | default('unknown') }} in schema {{ seq.schema | default('public') }}
# Description: Registers a sequence with Slony-I for replication.
sequence_{{ seq.schema | default('public') }}_{{ seq.name | default('unknown') }} = {
  # Unique integer ID for this sequence object (internally managed).
  id = {{ seq.id | default(0) }};
  # Schema name where this sequence resides.
  schemaname = '{{ seq.schema | default("public") }}';
  # Name of the sequence.
  sequencename = '{{ seq.name | default("") }}';
  # Owner of the sequence.
  owner = '{{ seq.owner | default("") }}';
  # Optional comment for documentation.
  comment = '{{ seq.comment | default("") }}';
};
{% endfor %}

# --- Managed Tables ---

# Optional list of PostgreSQL tables to be replicated.
{% for table in tables | default([]) %}
# Table {{ table.schema | default('public') }}.{{ table.name | default('unknown') }} (id = {{ table.id | default(0) }})
# Description: Registers a table with Slony-I for replication.
table_{{ table.schema | default('public') }}_{{ table.name | default('unknown') }} = {
  # Unique integer ID for this table object (internally managed).
  id = {{ table.id | default(0) }};
  # Schema name where this table resides.
  schemaname = '{{ table.schema | default("public") }}';
  # Name of the table.
  tablename = '{{ table.name | default("") }}';
  # Owner of the table.
  owner = '{{ table.owner | default("") }}';
  # Optional comment for documentation.
  comment = '{{ table.comment | default("") }}';
  # Primary key column name (required for row-based replication).
  pk_column = '{{ table.pk_column | default("") }}';
{% if table.pk_sequence is defined and table.pk_sequence != None %}
  # Optional: sequence used for PK generation (for auto-increment).
  pk_sequence = '{{ table.pk_sequence | default("") }}';
{% endif %}
{% if table.columns is defined and table.columns | length > 0 %}
  # Columns to replicate (null or empty = all columns).
  columns = [{{ table.columns | join(', ') }}];
{% else %}
  # No specific columns listed; all columns will be replicated.
  columns = [];
{% endif %}
};
{% endfor %}

# --- Event Retention ---

# Retention period (in seconds) for Slony-I event logs.
# Default: 86400 seconds (1 day).
# Events older than this interval are purged to manage storage.
retention_interval = {{ retention_interval | default(86400) }};