# Slony-I configuration file — generated by Jinja2 template
# Global Slony-I cluster configuration

# Cluster name (must match across all nodes)
clustername = '{{ cluster_name }}';

# Path to Slony-I log directory
logdir = '{{ log_dir }}';

# Connection timeout (in seconds) for internal operations
conn_info = 'dbname={{ database_name }} host={{ primary_host }} port={{ primary_port }} user={{ slony_user }}';

# polling interval for replication heartbeat (in seconds)
# default: 60
pollinterval = {{ poll_interval }};

# retry timeout for failed connections (in seconds)
# default: 15
retry_timeout = {{ retry_timeout }};

# maximum number of retries before failing a node
# default: 3
retry_count = {{ retry_count }};

# Enable/disable verbose logging (true/false)
# default: false
verbose = {{ verbose | lower }};

# Slony-I daemon PID file location
pidfile = '{{ pidfile_path }}';

# List of Slony-I nodes in the cluster (primary and replicas)
{% for node in nodes %}
# Node {{ loop.index }}: {{ node.name }} (id = {{ node.id }})
{{ node.name }} = {
  id = {{ node.id }};
  alias = '{{ node.alias }}';
  host = '{{ node.host }}';
  port = {{ node.port }};
  user = '{{ node.user }}';
  password = '{{ node.password }}';
  dbname = '{{ node.dbname }}';
};
{% endfor %}

# List of replication paths (source → target) between nodes
{% for path in paths %}
# Replication path {{ loop.index }}: {{ path.source }} → {{ path.target }}
path_{{ path.source }}_to_{{ path.target }} = {
  source = {{ path.source }};
  target = {{ path.target }};
  # forwarder node (if intermediate node is used); null if direct
{% if path.forwarder is defined and path.forwarder != None %}
  forwarder = {{ path.forwarder }};
{% else %}
  forwarder = 0;
{% endif %}
  # acknowledgment mode: 0 = none, 1 = sync (block), 2 = async (non-blocking)
  acknowledge = {{ path.ack_mode | default(1) }};
};
{% endfor %}

# Optional: replication sequences to be managed by Slony-I
{% for seq in sequences %}
# Sequence {{ seq.name }} in schema {{ seq.schema }}
sequence_{{ seq.schema }}_{{ seq.name }} = {
  id = {{ seq.id }};
  schemaname = '{{ seq.schema }}';
  sequencename = '{{ seq.name }}';
  owner = '{{ seq.owner }}';
  comment = '{{ seq.comment | default('') }}';
};
{% endfor %}

# Optional: replication tables
{% for table in tables %}
# Table {{ table.schema }}.{{ table.name }} (id = {{ table.id }})
table_{{ table.schema }}_{{ table.name }} = {
  id = {{ table.id }};
  schemaname = '{{ table.schema }}';
  tablename = '{{ table.name }}';
  owner = '{{ table.owner }}';
  comment = '{{ table.comment | default('') }}';
  # primary key column name
  pk_column = '{{ table.pk_column }}';
{% if table.pk_sequence is defined and table.pk_sequence != None %}
  # optional: sequence used for PK generation (for auto-increment)
  pk_sequence = '{{ table.pk_sequence }}';
{% endif %}
{% if table.columns is defined and table.columns | length > 0 %}
  # columns to replicate (null or empty = all columns)
  columns = [{{ table.columns | join(', ') | default('') | safe }}];
{% endif %}
};
{% endfor %}

# Slony-I event retention policy (in days)
retention_interval = {{ retention_interval }};
