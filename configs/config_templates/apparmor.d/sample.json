{
 "abi_version": "2.9",
 "allow_all": false,
 "attach_path": "/usr/sbin/nginx",
 "audit_rules": [
  "capability net_bind_service"
 ],
 "capabilities": [
  "net_bind_service"
 ],
 "change_profile_rules": [
  {
   "target": "/usr/lib/nginx/modules/*"
  }
 ],
 "dbus_rules": [
  {
   "access": "send",
   "bus": "system",
   "interface": "org.freedesktop.DBus.Introspectable",
   "member": "Introspect"
  },
  {
   "access": "send",
   "bus": "system",
   "name": "org.freedesktop.systemd1"
  }
 ],
 "debug": false,
 "file_rules": [
  {
   "access": "rw",
   "owner": true,
   "path": "/var/log/nginx/*",
   "type": "file"
  },
  {
   "access": "r",
   "path": "/etc/nginx/*",
   "type": "file"
  },
  {
   "access": "r",
   "path": "/usr/share/nginx/*",
   "type": "file"
  },
  {
   "access": "mrw",
   "owner": true,
   "path": "/var/www/**",
   "type": "file"
  },
  {
   "access": "rw",
   "owner": true,
   "path": "/run/nginx.pid",
   "type": "file"
  },
  {
   "access": "rw",
   "owner": true,
   "path": "/var/cache/nginx/*",
   "type": "file"
  }
 ],
 "include_common": true,
 "includes": [
  "tunables/home"
 ],
 "mode": "enforce",
 "mount_rules": [],
 "network_rules": [
  {
   "access": "stream tcp",
   "domain": "inet",
   "local": "port=80"
  },
  {
   "access": "stream tcp",
   "domain": "inet",
   "local": "port=443"
  },
  {
   "access": "stream",
   "domain": "unix",
   "local": "addr=@/run/php/php-fpm.sock"
  }
 ],
 "profile_name": "nginx",
 "rlimit_rules": [
  {
   "resource": "nofile",
   "value": "65536"
  },
  {
   "resource": "cpu",
   "value": "10s"
  }
 ],
 "signal_rules": [
  {
   "access": "send",
   "peer": "unconfined"
  }
 ],
 "unix_rules": [
  {
   "access": "connect",
   "local": "addr=@/var/run/dbus/system_bus_socket"
  }
 ]
}
