{
  "default_realm": "example.com",
  "kerberos_server": "dc1.example.com",
  "use_fully_qualified_names": true,
  "log_level": "info",
  "automatic_imap": true,
  "automatic_ldap": true,
  "automatic_dns": true,
  "computer_ou": "OU=Linux,OU=Servers,DC=example,DC=com",
  "os_name": "Fedora",
