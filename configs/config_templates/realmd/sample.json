  "disable_dns_sites": false,
  "preferred_ad_site": "US-East",
  "discover": [
    "ldap",
    "kerberos",
    "srv"
  ],
  "kerberos_realm_mappings": [
    {
      "name": "legacy.local",
      "kerberos_realm": "LEGACY.LOCAL",
