    }
  ],
  "domains": [
    {
      "name": "child.example.com",
      "server_software": "active-directory",
      "member_of": "EXAMPLE.COM",
      "preferred_ad_site": "US-West"
    },
    {
      "name": "ipa.example.com",
      "server_software": "freeipa",
      "kerberos_server": "ipa1.ipa.example.com",
      "preferred_ad_site": ""
    }
  ]
}
