{
  "daemon_interval": 1800,
  "logfacility": "LOG_LOCAL0",
  "emailaddr": [
    "admin@example.com",
    "ops@example.com"
  ],
  "mailcmd": "/usr/local/bin/smartmail.sh",
  "configdir": "/etc/smartd.conf.d",
  "devices": [
    {
      "dev": "/dev/sda",
      "description": "Primary OS disk",
      "type": "sat",
      "temperature": "c",
      "autoinit": "on",
      "automaint": true,
      "saway": true,
      "test": "s",
      "email": [
        "disk-alerts@example.com"
      ],
      "logfile": "/var/log/smartd/sda.log",
      "comment": "High-priority server boot disk"
    },
    {
      "dev": "/dev/sdb",
      "description": "Data array disk 2",
      "type": "scsi",
      "autoinit": "off",
      "automaint": false,
      "onoff": "off",
      "healthcheck": "off",
      "nopowersave": true,
      "exec": "/usr/local/bin/sdb-notify.sh"
    },
    {
      "dev": "/dev/nvme0n1",
      "description": "NVMe system disk",
      "type": "nvme",
      "autoinit": "on",
      "saway": true,
      "healthcheck": "on",
      "email": [
        "nvme-alerts@example.com"
      ],
      "comment": "Enterprise NVMe \u2014 check firmware updates regularly"
    },
    {
      "dev": "/dev/sdc",
      "description": "Backup archive disk",
      "ignore": true,
      "ignore_comment": "Archival only \u2014 not critical for real-time monitoring"
    }
  ]
}
