# ==============================================================================
# /etc/lprng/lprng.conf
# ==============================================================================
# This template configures the LPRng print spooler.
# Since the provided schema is empty, this template provides a standard,
# well-documented configuration for LPRng with sensible defaults.
# All directives are commented with their purpose to ensure self-documentation.

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------

# Specifies the name of the local printer or queue.
# This is typically 'lp' for the default printer.
# Default: lp
# Default value is kept generic; ensure this matches your system's default printer queue name.
LocalPrinter = lp

# Specifies the spool directory for print jobs.
# LPRng stores intermediate job files here.
# Default: /var/spool/lpd
SpoolDirectory = /var/spool/lpd

# Specifies the directory where printer configuration files are stored.
# Default: /etc/lprng
PrinterConfigDirectory = /etc/lprng

# Specifies the directory where the LPD daemon PID files are stored.
# Default: /var/run
PIDDirectory = /var/run

# -----------------------------------------------------------------------------
# Logging Settings
# -----------------------------------------------------------------------------

# Specifies the log file for LPRng activity.
# This file records job submissions, prints, and errors.
# Default: /var/log/lpd-requests
# Note: Ensure the LPRng user has write permissions to this file or directory.
RequestsLog = /var/log/lpd-requests

# Specifies the log file for daemon errors.
# Default: /var/log/lpd-errors
ErrorLog = /var/log/lpd-errors

# -----------------------------------------------------------------------------
# Network and Access Settings
# -----------------------------------------------------------------------------

# Specifies the TCP port on which the LPD daemon listens.
# The standard port for LPR/LPD is 515.
# Default: 515
# This field is not in the provided schema but is a standard LPRng setting.
Port = 515

# Specifies the listen address for the LPD daemon.
# '0.0.0.0' listens on all interfaces. '127.0.0.1' restricts to localhost.
# Default: 0.0.0.0
# Adjust this for security if the print service should only be local.
ListenAddress = 0.0.0.0

# -----------------------------------------------------------------------------
# Security and Authentication
# -----------------------------------------------------------------------------

# Specifies the user account under which the LPD daemon runs.
# Using a dedicated low-privilege user is recommended for security.
# Default: lp
# Note: Ensure this user exists on the system.
RunAsUser = lp

# Specifies whether to allow remote printing.
# 'true' allows network clients; 'false' restricts printing to local console.
# Default: true
RemoteAccess = true

# -----------------------------------------------------------------------------
# Job Processing Settings
# -----------------------------------------------------------------------------

# Specifies the command used to process print jobs.
# This is often a wrapper script or a direct call to a formatter.
# Default: /usr/local/bin/lprun
# This may need adjustment depending on local installation paths.
ProcessFilter = /usr/local/bin/lprun

# Specifies the maximum number of jobs allowed in the queue.
# 0 means unlimited.
# Default: 0
MaxJobs = 0

# Specifies the time-to-live for jobs in the spool directory in seconds.
# Jobs older than this time are automatically removed.
# Default: 86400 (24 hours)
JobTTL = 86400

# -----------------------------------------------------------------------------
# Compatibility and Modes
# -----------------------------------------------------------------------------

# Enables compatibility mode for BSD-style LPR commands.
# Default: true
CompatibilityMode = true

# Specifies the format for job accounting logs.
# Default: /var/log/lpd-acct
AccountingLog = /var/log/lpd-acct

# ==============================================================================
# End of LPRng Configuration
# ==============================================================================
