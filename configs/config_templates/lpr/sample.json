{
  "max_jobs": 15,
  "printcap_path": "/etc/printcap",
  "log_job": "yes",
  "hosts_allowed": "localhost,192.168.1.0/24",
  "spool_root": "/var/spool/lpd",
  "conn_timeout": 30,
  "write_timeout": 900,
  "max_retries": 3,
  "daemon_restart": "no",
  "queues": [
    {
      "name": "lp0",
      "description": "Local PostScript laser printer",
      "lpd_path": "/dev/lpt0",
      "spool_dir": "/var/spool/lpd/lp0",
      "filter_path": "/usr/local/bin/lpif-ps",
      "accounting_file": "/var/log/lpd/lp0.account",
      "max_jobs": 10,
      "remote_host": "",
      "remote_queue": ""
    },
    {
      "name": "network-lp",
      "description": "Network HP LaserJet via JetDirect",
      "lpd_path": "network",
      "filter_path": "/usr/libexec/lpr/lpif",
      "accounting_file": "/var/spool/lpd/network-lp/accounting",
      "max_jobs": 0,
      "remote_host": "hp-lj4.local",
      "remote_queue": "lp"
    }
  ]
}
