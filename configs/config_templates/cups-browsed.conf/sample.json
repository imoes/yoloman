{
  "local_only": true,
  "timeout": 30,
  "max_retries": 3,
  "retry_interval": 60,
  "browse_remote_protocols": [
    "cups",
    "ipp",
    "dnssd"
  ],
  "browse_local_protocols": [
    "dnssd"
  ],
  "create_remote_ppds": true,
  "default_options": [
    "media=a4",
    "sides=two-sided-long-edge"
  ],
  "printers": [
    {
      "name": "lobby-printer",
      "description": "Lobby Multifunction Device",
      "uri": "ipp://192.168.1.50/ipp/print",
      "location": "Lobby, Front Desk",
      "make_and_model": "Canon, iR-ADV C7570/7575 UFR II",
      "options": [
        "media=legal",
        "color=true"
      ]
    }
  ],
  "convertpcltops": false,
  "create_ipp_printer_queues": true,
  "cups_local_server": "127.0.0.1",
  "log_level": "info",
  "log_file": "/var/log/cups-browsed.log"
}
