{
  "site_bundlesequence": [
    "common",
    "site_baseline",
    "site_packages",
    "site_users",
    "site_services",
    "site_monitoring"
  ],
  "site_include_paths": [
    "/var/cfengine/inputs/core.cf",
    "/var/cfengine/inputs/lib.cf",
    "/var/cfengine/inputs/packages.cf"
  ],
  "site_cfengine_control_host": "any",
  "site_cfengine_control_vars": "edit_defaults::\n  always_rotate::\n    rotate_size => \"2000000\";\n    rotate_count => 5;\n  default::\n    timeout => \"60\";",
  "site_trusted_servers": "10.0.0.5,10.0.0.6",
  "site_trusted_users": "cfengine,root",
  "site_trusted_groups": "",
  "site_policy_server_key": "/var/cfengine/ppkeys/10.0.0.5.pub",
  "site_execd_timeout": "600",
  "site_execd_max_processes": 10,
  "site_cf_serverd_port": 5308,
  "site_cf_execd_port": 5309,
  "site_cf_monitord_port": 5310,
  "site_policy_server_host": "policy.example.com",
  "site_policy_server_dir": "/var/cfengine/masterfiles",
  "site_log_dir": "/var/log/cfengine",
  "site_log_rotate_count": 7,
  "site_log_size_limit": 5000000,
  "site_verbose": false,
  "site_packages_enabled": true,
  "site_packages_policy": "apt",
  "site_packages_list": [
    "curl",
    "vim",
    "rsync",
    "netcat-openbsd",
    "nmap"
  ],
  "site_monitored_services": [
    {
      "name": "sshd",
      "restart": "immediate",
      "start": "systemctl",
      "stop": "systemctl"
    },
    {
      "name": "nginx",
      "restart": "delayed",
      "start": "systemctl",
      "stop": "systemctl"
    }
  ]
}
