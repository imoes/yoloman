# Unison file synchronization profile
# Path to root directories to synchronize
root = {{ roots[0] }}
root = {{ roots[1] }}

# Logging
log = {{ log | lower }}
logfile = {{ logfile }}

# Verbosity level: 0 (quiet) to 4 (debug)
verbose = {{ verbose }}

# Safety: avoid overwriting newer files
prefer = {{ prefer }}

# Conflict resolution: newer (default), newerbytime, newerbysize, newerbycontent, oldest, oldestbytime, oldestbysize, oldestbycontent, error, never
copier = {{ copier }}

# Use fast checksums (MD5) for large files
fastcheck = {{ fastcheck | lower }}

# Do not follow symlinks
follow = {{ follow }}

# Use this ssh command for remote connections
sshcmd = {{ sshcmd }}

# Use this ssh port (for remote hosts)
port = {{ port }}

# Paths to exclude (use multiple `path =` lines)
{% for item in excludes %}# Exclude path: {{ item }}
path = {{ item }}
{% endfor %}

# Paths to explicitly include (override excludes)
{% for item in includes %}# Include path: {{ item }}
path = {{ item }}
{% endfor %}

# File patterns to ignore (regex, case-insensitive by default)
{% for pattern in ignorepatterns %}# Ignore pattern: {{ pattern }}
ignore = Name {{ pattern }}
{% endfor %}

# Retain timestamps and permissions
perms = {{ perms | lower }}

# Force batch (non-interactive) mode
batch = {{ batch | lower }}

# Retry connection on network errors
retry = {{ retry }}

# Preserve modification times (default true)
times = {{ times | lower }}

# Do not delete files on the receiving side that are absent on the sending side (if bidirectional: safer default)
delete = {{ delete }}
