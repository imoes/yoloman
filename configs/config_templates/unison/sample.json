{
  "roots": [
    "/home/user/sync/local",
    "ssh://alice@backup.example.com//backup/sync"
  ],
  "log": true,
  "logfile": "/var/log/unison/default.log",
  "verbose": 2,
  "prefer": "newer",
  "copier": "newer",
  "fastcheck": true,
  "follow": "false",
  "sshcmd": "ssh -p 2222",
  "port": 2222,
  "excludes": [
    ".git",
    "__pycache__",
    ".cache",
    ".local/share/Trash"
  ],
  "includes": [],
  "ignorepatterns": [
    "*.tmp",
    "*.log",
    "*.swp",
    "*.pyc",
    "Thumbs.db"
  ],
  "perms": false,
  "batch": true,
  "retry": 5,
  "times": true,
  "delete": "nonroot"
}
