# ============================================================================
# pmtools Configuration Template
# ============================================================================
# This file configures pmtools (Perl Module Tools), a suite of command-line
# utilities for inspecting and managing Perl modules (e.g., pmdesc, pmpath, pmvers).
# It is self-documenting: every setting is described above its directive.
# Generated by Ansible Jinja2.
# ============================================================================

# --------------------------------------------------------------------------
# default_modules
# --------------------------------------------------------------------------
# Description: List of Perl module names to be processed by pmtools by default
#              (e.g., CGI, IO::Socket). These are the modules that
#              pmdesc/pmpath/pmvers will inspect when no specific modules
#              are passed as arguments on the command line.
# Type: list of strings
# Default: [] (empty list)
# --------------------------------------------------------------------------
# Format: Space-separated list of module names
{% set _default_modules = default_modules | default([]) %}
{% if _default_modules | length > 0 %}
DEFAULT_MODULES={{ _default_modules | join(' ') }}
{% else %}
DEFAULT_MODULES=
{% endif %}

# --------------------------------------------------------------------------
# search_path
# --------------------------------------------------------------------------
# Description: Optional custom base directory to prepend to Perl library paths
#              for module resolution. When set, pmtools will look in this
#              directory first, before falling back to standard @INC paths
#              determined by the Perl interpreter.
# Type: string
# Default: '' (empty string, use standard @INC)
# --------------------------------------------------------------------------
SEARCH_PATH={{ search_path | default('') }}