# iptables rules.v4 — IPv4 packet filter and NAT rules persistence
# Generated by iptables-persistent; edit template and re-render instead of editing directly
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Accept loopback traffic
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# Allow established and related connections
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# Allow SSH (configure port and source restrictions via template variables)
{% for rule in ssh_rules %}
# {{ rule.description | default('SSH rule') }}
-A INPUT -p tcp --dport {{ rule.port | default(22) }} -s {{ rule.source | default('0.0.0.0/0') }} -j {{ rule.target | default('ACCEPT') }}
{% endfor %}

# Allow ICMP (optional; toggle via icmp_enabled)
{% if icmp_enabled %}
-A INPUT -p icmp --icmp-type echo-request -j ACCEPT
-A OUTPUT -p icmp --icmp-type echo-reply -j ACCEPT
{% endif %}

# Allow specific ports (defined dynamically)
{% for port_rule in allow_ports %}
# {{ port_rule.description | default('Allow port ' + port_rule.port | string) }}
-A INPUT -p {{ port_rule.protocol | default('tcp') }} --dport {{ port_rule.port }} -s {{ port_rule.source | default('0.0.0.0/0') }} -j {{ port_rule.target | default('ACCEPT') }}
{% endfor %}

# Masquerade outgoing traffic (optional NAT; toggle via nat_enabled)
{% if nat_enabled %}
# NAT for outbound traffic (e.g., for gateway servers)
-A POSTROUTING -t nat -o {{ nat_interface | default('eth0') }} -j MASQUERADE

# Allow forwarding for NAT (if firewall allows FORWARD, as per policy)
-A FORWARD -i {{ nat_interface | default('eth0') }} -o {{ nat_internal_interface | default('eth1') }} -j ACCEPT
-A FORWARD -i {{ nat_internal_interface | default('eth1') }} -o {{ nat_interface | default('eth0') }} -m state --state ESTABLISHED,RELATED -j ACCEPT
{% endif %}

COMMIT

# Custom user-defined chains (optional)
{% for chain in custom_chains %}
# Chain: {{ chain.name }} — {{ chain.description | default('User-defined chain') }}
-N {{ chain.name }}
{% endfor %}

# Jump to user-defined chains (if any rules reference them)
{% for jump in custom_jumps %}
# {{ jump.description }}
{% if jump.chain %}
-A INPUT -j {{ jump.chain }}
{% endif %}
{% endfor %}

# End of rules.v4 — do NOT edit manually; regenerate via template system
