# iptables rules.v4 — IPv4 packet filter and NAT rules persistence
# Generated by iptables-persistent; edit template and re-render instead of editing directly
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Accept loopback traffic
# Description: Allow all traffic on the loopback interface (localhost communication).
# Critical for local services to communicate.
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# Allow established and related connections
# Description: Permit return traffic for connections initiated by this host.
# Improves security by blocking unsolicited inbound traffic.
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# SSH Access Rules
# Description: Define allowed SSH access. Each rule specifies port, source CIDR, target action, and description.
# Default: Allow SSH (port 22) from any source.
{% for rule in ssh_rules | default([{'port': 22, 'source': '0.0.0.0/0', 'target': 'ACCEPT', 'description': 'Allow SSH from anywhere'}]) %}
# {{ rule.description | default('SSH rule') }}
-A INPUT -p tcp --dport {{ rule.port | default(22) }} -s {{ rule.source | default('0.0.0.0/0') }} -j {{ rule.target | default('ACCEPT') }}
{% endfor %}

# Allow ICMP (optional; toggle via icmp_enabled)
# Description: Enable basic ICMP echo (ping) requests and replies.
# Useful for network diagnostics.
{% if icmp_enabled | default(true) %}
-A INPUT -p icmp --icmp-type echo-request -j ACCEPT
-A OUTPUT -p icmp --icmp-type echo-reply -j ACCEPT
{% endif %}

# Allow specific ports (defined dynamically)
# Description: List of port/protocol rules to allow inbound (e.g., web servers, databases).
# Each item should have port, protocol, source, target, and description.
{% for port_rule in allow_ports | default([]) %}
# {{ port_rule.description | default('Allow port ' + port_rule.port | string) }}
-A INPUT -p {{ port_rule.protocol | default('tcp') }} --dport {{ port_rule.port }} -s {{ port_rule.source | default('0.0.0.0/0') }} -j {{ port_rule.target | default('ACCEPT') }}
{% endfor %}

# Masquerade outgoing traffic (optional NAT; toggle via nat_enabled)
# Description: Enable NAT (masquerading) on outbound interface (required for gateway/router roles).
# Requires nat_enabled=true, nat_interface, and nat_internal_interface.
{% if nat_enabled | default(false) %}
# NAT for outbound traffic (e.g., for gateway servers)
# Note: -t nat is often implicit in raw iptables commands but explicit here for clarity if needed by wrapper.
# Standard iptables-save syntax does not use -t in rules, but this is a config file.
# We stick to standard rule syntax: -A POSTROUTING ...
-A POSTROUTING -o {{ nat_interface | default('eth0') }} -j MASQUERADE

# Allow forwarding for NAT (if firewall allows FORWARD, as per policy)
# Allows traffic to flow from internal to external and return.
-A FORWARD -i {{ nat_interface | default('eth0') }} -o {{ nat_internal_interface | default('eth1') }} -j ACCEPT
-A FORWARD -i {{ nat_internal_interface | default('eth1') }} -o {{ nat_interface | default('eth0') }} -m state --state ESTABLISHED,RELATED -j ACCEPT
{% endif %}

COMMIT

# Custom user-defined chains (optional)
# Description: List of user-defined chains to create (must be referenced by jumps).
# Each item should have name and description.
{% for chain in custom_chains | default([]) %}
# Chain: {{ chain.name }} — {{ chain.description | default('User-defined chain') }}
-N {{ chain.name }}
{% endfor %}

# Jump to user-defined chains (if any rules reference them)
# Description: Rules that jump to user-defined chains (optional).
# Each item should have chain name and description.
{% for jump in custom_jumps | default([]) %}
# {{ jump.description | default('Custom jump rule') }}
{% if jump.chain %}
-A INPUT -j {{ jump.chain }}
{% endif %}
{% endfor %}

