#!/bin/sh
# =============================================================================
# runit: System one-time initialization tasks
#
# This script initializes the runit service supervisor environment during boot.
# It sets up the PATH, executes boot-time tasks, migrates SysV-style init scripts
# if necessary, and prepares control files in the /run directory.
# =============================================================================

# --- Environment Setup --------------------------------------------------------
# Sets the default PATH for the initialization script.
# Schema field: default_path (string, default: '/usr/sbin:/sbin:/usr/bin:/bin')
PATH={{ default_path | default('/usr/sbin:/sbin:/usr/bin:/bin') }}
export PATH

# --- Boot Tasks Execution -----------------------------------------------------
# Executes native runit boot scripts or falls back to SysV-style init scripts.
# Condition: Runs if the native boot runscript exists OR the $bootrun variable is set,
# AND the /etc/runit/boot-run directory exists.
if [ -f /etc/runit/native.boot.run -o -n "$bootrun" ] && [ -d /etc/runit/boot-run ]; then
    # Iterate over all .sh scripts in the native boot directory
    for f in /etc/runit/boot-run/*.sh; do
        # Source the script if it is readable
        [ -r "$f" ] && . "$f"
    done
else
    # Fallback: Start SysV-style init scripts from /etc/rcS.d/
    for script in /etc/rcS.d/S* ; do
        # Skip non-executable scripts
        [ ! -x "$script" ] && continue
        
        # Get the real path to avoid issues with symlinks
        path=$(realpath "$script")
        
        # Extract the filename for override checking
        name=${path##*/}
        
        # Check for override blocks that prevent this service from starting
        [ -e /etc/runit/override-sysv.d/"$name".block ] && continue
        [ -e /etc/runit/override-sysv.d/"$name".pkgblock ] && continue
        
        # Start the service
        "$script" start
    done

    # Log the boot event to wtmpdb if available
    if ! /usr/bin/wtmpdb boot ; then
        echo "warning: failed to write a wtmpdb boot entry"
    fi
fi

# --- Runit Control File Preparation -------------------------------------------
# Creates control files in the runit run directory.
# Schema field: run_path (string, default: '/run')
#
# These files are used by runit to manage the daemon's lifecycle (stop/reboot signals).
# install -m000 creates an empty file with no permissions, acting as a sentinel.
install -m000 /dev/null {{ run_path | default('/run') }}/runit.stopit
install -m000 /dev/null {{ run_path | default('/run') }}/runit.reboot

# =============================================================================
# Notes:
# - Services without specific runscripts are handled via the SysV fallback above.
# - This approach ensures that daemons hanging during stage1 do not block the boot.
# - /run is assumed to be mounted before this script runs.
# =============================================================================
