# Shamir Secret-Sharing Configuration
# This file controls parameters for generating and recovering Shamir mnemonic sets.
#
# The Shamir Secret Sharing scheme splits a secret into multiple parts (shares) such that
# a minimum number of shares (threshold) is required to reconstruct the original secret.
# This is commonly used in cryptocurrency wallet recovery (e.g., BIP-39 mnemonic codes).

[shamir]

# Total number of shares to generate for the secret.
# All shares are required to be generated, though only 'threshold' of them are needed for reconstruction.
# Default: 5
shares = {{ (shares | default(5)) }}

# Minimum number of shares required to reconstruct the secret.
# This value must be less than or equal to 'shares'.
# Default: 3
threshold = {{ (threshold | default(3)) }}

# The word list format to use for mnemonic codes.
# Supported formats typically include 'bip39' for standard 12/15/18/21/24 word mnemonics,
# or 'custom' for proprietary formats.
# Default: bip39
format = {{ (format | default('bip39')) }}

# The language for the mnemonic word list.
# This determines which BIP-39 word list is used to encode the shares.
# Common values: english, spanish, french, italian, chinese_simplified, chinese_traditional, japanese, korean.
# Default: english
language = {{ (language | default('english')) }}

# Flag to enable verbose logging/output.
# When true, the tool may print additional details about the generation and recovery process.
# Default: false
verbose = {{ (verbose | default(false)) | lower }}