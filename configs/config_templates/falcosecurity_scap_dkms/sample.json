{
  "kernel_module_params": {
    "buffers_per_cpu": 256,
    "prealloc_events": 512,
    "capture_payloads": true,
    "max_payload_size": 16384,
    "max_concurrent_syscalls": 256,
    "enable_tracepoints": false,
    "excluded_syscalls": [
      "getuid",
      "getgid",
      "geteuid",
      "getegid"
    ],
    "enable_dedup": true,
    "strict_mode": true
  }
}
