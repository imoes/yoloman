# pinentry-curses configuration template
# This file configures the pinentry-curses interface used by GnuPG
# to prompt for passphrases in a terminal-based environment.

# debug: default=False
# Turn on some debugging. Note that this may reveal sensitive information like the entered pass phrase.
# Only enable this during troubleshooting.
{% if debug | default(False) %}
--debug yes
{% endif %}

# enhanced: default=False
# Ask for timeouts and insurance, too. Note that this is currently not fully supported.
# Enable to get additional interactive security checks (e.g. confirmation prompts).
{% if enhanced | default(False) %}
--enhanced yes
{% endif %}

# no_global_grab: default=False
# Grab the keyboard only when the window is focused. Use this option if you are debugging software using
# pinentry-curses; otherwise you may no[te that it prevents the curses interface from grabbing the entire
# keyboard, reducing usability but improving compatibility with terminal multiplexers].
{% if no_global_grab | default(False) %}
--no-global-grab yes
{% endif %}