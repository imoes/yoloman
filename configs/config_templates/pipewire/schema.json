  "description": "Node factory defaults.",
  "properties": {
   "args": {
    "additionalProperties": {
     "type": "string"
    },
    "default": {},
    "description": "Node factory arguments.",
    "properties": {
     "node.description": {
      "description": "Default description for created nodes",
      "type": "string"
     },
     "node.name": {
      "description": "Default name pattern for nodes",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "paths": {
  "description": "File system paths for modules and SPA plugins.",
  "properties": {
   "default_module_path": {
    "default": "/usr/lib/pipewire-0.3",
    "description": "Default path where pipewire modules are installed.",
    "type": "string"
   },
   "module_paths": {
    "default": [
     "/usr/lib/pipewire-0.3",
     "/usr/local/lib/pipewire-0.3"
    ],
    "description": "List of directories to search for pipewire modules.",
    "items": {
     "description": "Path to a module directory.",
     "type": "string"
    },
    "type": "list"
   }
  },
  "type": "object"
 },
 "policy": {
  "description": "Audio policy engine settings (auto routing, suspend behavior).",
  "properties": {
   "auto_connect": {
    "default": true,
    "description": "Automatically connect new nodes to matching endpoints.",
    "type": "boolean"
   },
   "auto_suspend": {
    "default": true,
    "description": "Suspend inactive nodes after timeout.",
    "type": "boolean"
   },
   "default_route": {
    "default": "",
    "description": "Default route profile (e.g., 'output:analog-stereo').",
    "type": "string"
   }
  },
  "type": "object"
 },
 "protocols": {
  "description": "Protocol module (native/remote) settings.",
  "properties": {
   "args": {
    "additionalProperties": {
     "type": "string"
    },
    "default": {},
    "description": "Native protocol arguments.",
    "properties": {
     "auth.anonymous.uuid": {
      "description": "Anonymous auth UUID",
      "type": "string"
     },
     "auth.cookie.enable": {
      "description": "Enable cookie-based auth",
      "type": "boolean"
     },
     "protocol.native.max-buffers": {
      "description": "Max shared buffers per stream",
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "pulse": {
  "description": "PulseAudio compatibility bridge configuration.",
  "properties": {
   "frag_size": {
    "default": 4096,
    "description": "Size of each fragment in bytes.",
    "type": "number"
   },
   "nfrags": {
    "default": 16,
    "description": "Number of fragments in buffer.",
    "type": "number"
   },
   "server_name": {
    "default": "pipewire-pulse",
    "description": "PulseAudio server name.",
    "type": "string"
   },
   "server_path": {
    "default": "/run/user/1000/pipewire-pulse",
    "description": "Socket path for PulseAudio server.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "resample_filters": {
  "default": [
   {
    "length": 32,
    "name": "default",
    "quality": 1,
    "taps": 64
   }
  ],
  "description": "Resampler configuration blocks (one per filter preset).",
  "items": {
   "properties": {
    "length": {
     "description": "Filter length in samples (higher = better quality, slower).",
     "type": "number"
    },
    "name": {
     "description": "Resampler profile name (e.g., 'default', 'high', 'low').",
     "type": "string"
    },
    "quality": {
     "description": "Quality level (1–3, where 3 is highest).",
     "type": "number"
    },
    "taps": {
     "description": "Number of filter taps (must be multiple of 8).",
     "type": "number"
    }
   },
   "required": [
    "name",
    "length",
    "taps"
   ],
   "type": "object"
  },
  "type": "list"
 },
 "rtkit": {
  "description": "RTKit real-time scheduling settings (requires rtkit package).",
  "properties": {
   "nice_value": {
    "default": -11,
    "description": "Nice value for non-RT processes.",
    "type": "number"
   },
   "rt_prio": {
    "default": 88,
    "description": "Real-time priority (max 99).",
    "type": "number"
   },
   "rt_timeouts": {
    "default": false,
    "description": "Enable RT time limits (may prevent lockups).",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "settings": {
  "description": "Core settings: log level, timing, and period limits.",
  "properties": {
   "default_timer_quantum": {
    "default": 1024,
    "description": "Default timer quantum (samples/frame); controls buffer size and scheduling.",
    "type": "number"
   },
   "log_level": {
    "default": 2,
    "description": "Verbosity of logging: 0=error, 1=warn, 2=info (default), 3=debug.",
    "type": "number"
   },
   "max_periods": {
    "default": 4,
    "description": "Maximum periods per node (affects latency and stability).",
    "type": "number"
   }
  },
  "type": "object"
 },
