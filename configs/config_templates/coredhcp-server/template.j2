# CoreDHCP configuration (YAML)
#
# This template configures the CoreDHCP server for both DHCPv6 and DHCPv4 services.
# Each section corresponds to a specific protocol version and its associated plugins.
# All variable references use defaults derived from the schema to ensure idempotency
# and safe reuse within Ansible roles.

# ==============================================================================
# DHCPv6 Configuration
# ==============================================================================
# Server6 defines the DHCPv6 server parameters and plugins.
server6:
    # plugins is a mandatory section, which defines how requests are handled.
    # It is a list of maps, matching plugin names to their arguments.
    # The order is meaningful, as incoming requests are handled by each plugin
    # in turn. There is no default value for a plugin configuration, and a
    # plugin that is not mentioned will not be loaded at all.
    plugins:
        # server_id is mandatory for RFC-compliant operation.
        # It configures the DUID (DHCP Unique Identifier) using the Link-Local (LL) type.
        # - server_id: LL <MAC address>
        # MAC address format: XX:XX:XX:XX:XX:XX
        # Default: 00:de:ad:be:ef:00
        - server_id: LL {{ server6_server_id_mac | default('00:de:ad:be:ef:00') }}

        # file serves leases defined in a static file, matching link-layer addresses to IPs.
        # - file: <file path> [autorefresh]
        # The file format is one lease per line: "<hw address> <IPv6>"
        # When the 'autorefresh' argument is given, the plugin will try to refresh
        # the lease mapping during runtime whenever the lease file is updated.
        # Default: /var/lib/coredhcp/leases.txt
        - file: "{{ server6_file_leases_path | default('/var/lib/coredhcp/leases.txt') }}"

        # dns adds information about available DNS resolvers to the responses.
        # - dns: <resolver IP> <... resolver IPs>
        # Default: ['2001:4860:4860::8888', '2001:4860:4860::8844']
        - dns: {{ server6_dns_resolvers | default(['2001:4860:4860::8888', '2001:4860:4860::8844']) }}

        # nbp can add information about the location of a network boot program.
        # - nbp: <NBP URL>
        # Default: http://[2001:db8:a::1]/nbp
        - nbp: "{{ server6_nbp_url | default('http://[2001:db8:a::1]/nbp') }}"

        # prefix provides prefix delegation for IPv6 networks.
        # - prefix: <prefix> <allocation size>
        # prefix is the prefix pool from which the allocations will be carved.
        # allocation size is the maximum size for prefixes that will be allocated to clients.
        # EG for allocating /64 or smaller prefixes within 2001:db8::/48 :
        # Default: 2001:db8::/48 64
        - prefix: {{ server6_prefix_delegation_prefix | default('2001:db8::/48') }} {{ server6_prefix_delegation_size | default(64) }}

    # server6_listen_port: DHCPv6 server port to listen on
    # Default: 547
    # The port on which the DHCPv6 server will listen for incoming requests.
    listen_port: {{ server6_listen_port | default(547) }}

    # server6_listen_interface: Interface to bind DHCPv6 server to (optional, empty = all interfaces)
    # Default: ''
    # The network interface to bind the DHCPv6 server to. An empty string binds to all interfaces.
    listen_interface: "{{ server6_listen_interface | default('') }}"

# ==============================================================================
# DHCPv4 Configuration
# ==============================================================================
# Server4 defines the DHCPv4 server parameters and plugins.
server4:
    # plugins is a mandatory section, which defines how requests are handled.
    # It is a list of maps, matching plugin names to their arguments.
    # The order is meaningful, as incoming requests are handled by each plugin
    # in turn. There is no default value for a plugin configuration, and a
    # plugin that is not mentioned will not be loaded at all.
    plugins:
        # lease_time sets the default lease time for advertised leases.
        # - lease_time: <duration>
        # The duration can be given in any format understood by go's
        # "ParseDuration": https://golang.org/pkg/time/#ParseDuration
        # Default: 3600s
        - lease_time: {{ server4_lease_time | default('3600s') }}

        # server_id advertises a DHCP Server Identifier, to help resolve
        # situations where there are multiple DHCP servers on the network.
        # - server_id: <IP address>
        # The IP address should be one address where this server is reachable.
        # Default: 10.10.10.1
        - server_id: {{ server4_server_id | default('10.10.10.1') }}

        # dns advertises DNS resolvers usable by the clients on this network.
        # - dns: <IP address> <...IP addresses>
        # Default: ['8.8.8.8', '8.8.4.4']
        - dns: {{ server4_dns_resolvers | default(['8.8.8.8', '8.8.4.4']) }}

        # router is mandatory, and advertises the address of the default router
        # for this network.
        # - router: <IP address>
        # Default: 192.168.1.1
        - router: {{ server4_router | default('192.168.1.1') }}

        # netmask advertises the network mask for the IPs assigned through this
        # server.
        # - netmask: <network mask>
        # Default: 255.255.255.0
        - netmask: {{ server4_netmask | default('255.255.255.0') }}

        # range allocates leases within a range of IPs.
        # - range: <lease file> <start IP> <end IP> <lease duration>
        # * the lease file is an initially empty file where the leases that are
        # allocated to clients will be stored across server restarts
        # * lease duration can be given in any format understood by go's
        # "ParseDuration": https://golang.org/pkg/time/#ParseDuration
        # Defaults:
        #   lease file: leases.txt
        #   start IP: 10.10.10.100
        #   end IP: 10.10.10.200
        #   duration: 60s
        - range: {{ server4_range_lease_file | default('leases.txt') }} {{ server4_range_start | default('10.10.10.100') }} {{ server4_range_end | default('10.10.10.200') }} {{ server4_range_duration | default('60s') }}

        # staticroute advertises additional routes the client should install in
        # its routing table as described in RFC3442.
        # - staticroute: <destination>,<gateway> [<destination>,<gateway> ...]
        # where destination should be in CIDR notation and gateway should be
        # the IP address of the router through which the destination is reachable.
        # Default: 10.20.20.0/24,10.10.10.1
        - staticroute: {{ server4_static_route_dest | default('10.20.20.0') }}/{{ server4_static_route_prefixlen | default(24) }},{{ server4_static_route_gateway | default('10.10.10.1') }}

    # server4_listen_port: DHCPv4 server port to listen on
    # Default: 67
    # The port on which the DHCPv4 server will listen for incoming requests.
    listen_port: {{ server4_listen_port | default(67) }}

    # server4_listen_interface: Interface to bind DHCPv4 server to (optional, empty = all interfaces)
    # Default: ''
    # The network interface to bind the DHCPv4 server to. An empty string binds to all interfaces.
    listen_interface: "{{ server4_listen_interface | default('') }}"

    # server4_listen_address: Address to bind DHCPv4 server to (empty = wildcard 0.0.0.0)
    # Default: ''
    # The specific IP address to bind the DHCPv4 server to. An empty string binds to all interfaces.
    listen_address: "{{ server4_listen_address | default('') }}"
