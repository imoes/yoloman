{
  "listen_address": "127.0.0.1",
  "listen_port": 9000,
  "paths_work_dir": "/var/lib/kxd/work",
  "paths_state_dir": "/var/lib/kxd/state",
  "paths_log_dir": "/var/log/kxd",
  "limits_max_memory_mb": 512,
  "limits_max_cpu_time_sec": 30,
  "limits_max_open_files": 64,
  "limits_max_processes": 8,
  "workers_count": 8,
  "workers_gc_interval_sec": 600,
  "security_allow_network": false,
  "security_sandbox_fs": true,
  "security_allowed_images": [
    {
      "name": "alpine",
      "path": "/opt/kxd/images/alpine.tar",
      "read_only": true
    },
    {
      "name": "debian-slim",
      "path": "/opt/kxd/images/debian.tar",
      "read_only": true
    }
  ],
  "log_level": "info"
}
