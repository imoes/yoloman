{
  "prefix": "/usr",
  "exec_prefix": "/usr",
  "syslocale": ". /etc/environment",
  "path": "/usr/bin:/bin:/usr/bin:/usr/local/bin",
  "shell": "/bin/sh",
  "dsntoauthaddr": "0",
  "dynamicdeliveries": "1",
  "defaultdelivery": "./Maildir",
  "maildropdefault": "./Maildir",
  "esmtp_cork": "1",
  "esmtp_blockbackscatter": "smtp/dsn",
  "uuxflags": "-j -g C",
  "esmtp_use_starttls": "1",
  "courier_tls_path": "/usr/bin/couriertls",
  "esmtp_tls_verify_domain": "0",
  "esmtp_prefer_ipv6_mx": "1",
  "tls_trustcerts": "/etc/ssl/certs/ca-certificates.crt",
  "tls_verifypeer": "NONE"
}
