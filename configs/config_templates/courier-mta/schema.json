{
  "prefix": {
    "type": "string",
    "default": "/usr",
    "description": "Installation prefix directory"
  },
  "exec_prefix": {
    "type": "string",
    "default": "/usr",
    "description": "Executable installation prefix directory"
  },
  "syslocale": {
    "type": "string",
    "default": ". /etc/environment",
    "description": "Source command to set system locale environment"
  },
  "path": {
    "type": "string",
    "default": "/usr/bin:/bin:/usr/bin:/usr/local/bin",
    "description": "Default PATH for Courier processes"
  },
  "shell": {
    "type": "string",
    "default": "/bin/sh",
    "description": "Default shell for Courier processes"
  },
  "dsntoauthaddr": {
    "type": "string",
    "default": "0",
    "description": "Send bounces to authenticated address (0 or 1)"
  },
  "dynamicdeliveries": {
    "type": "string",
    "default": "1",
    "description": "Enable dynamic delivery instructions (0 or 1)"
  },
  "defaultdelivery": {
    "type": "string",
    "default": "./Maildir",
    "description": "Default local mail delivery instruction"
  },
  "maildropdefault": {
    "type": "string",
    "default": "./Maildir",
    "description": "Default mailbox location for maildrop"
  },
  "esmtp_cork": {
    "type": "string",
    "default": "1",
    "description": "Enable ESMTP corking for Linux kernels >2.2 (0 or 1)"
  },
  "esmtp_blockbackscatter": {
    "type": "string",
    "default": "smtp/dsn",
    "description": "Backscatter bounces handling setting",
    "enum": [
      "smtp/dsn",
      "smtp/dsn,authsmtp/dsn"
    ]
  },
  "uuxflags": {
    "type": "string",
    "default": "-j -g C",
    "description": "Additional flags to pass to uux"
  },
  "esmtp_use_starttls": {
    "type": "string",
    "default": "1",
    "description": "Use STARTTLS for ESMTP client connections (0 or 1)"
  },
  "courier_tls_path": {
    "type": "string",
    "default": "/usr/bin/couriertls",
    "description": "Path to the couriertls binary"
  },
  "esmtp_tls_verify_domain": {
    "type": "string",
    "default": "0",
    "description": "Verify domain in remote server's certificate (0 or 1)"
  },
  "esmtp_prefer_ipv6_mx": {
    "type": "string",
    "default": "1",
    "description": "Prefer IPv6 MX hosts over IPv4 (0 or 1)"
  },
  "tls_trustcerts": {
    "type": "string",
    "default": "/etc/ssl/certs/ca-certificates.crt",
    "description": "Path to trusted certificate authorities file"
  },
  "tls_verifypeer": {
    "type": "string",
    "default": "NONE",
    "description": "TLS verification mode for server certificates (NONE, PEER, REQUIREPEER)",
    "enum": [
      "NONE",
      "PEER",
      "REQUIREPEER"
    ]
  }
}
