{
 "api_bind_host": "0.0.0.0",
 "api_bind_port": 5665,
 "command_endpoint": "director-global",
 "enable_api": true,
 "enable_notifications": true,
 "endpoints": [
  {
   "host": "icinga-master.example.com",
   "name": "master",
   "port": 5665
  },
  {
   "host": "icinga-slave1.example.com",
   "name": "slave1",
   "port": 5665
  }
 ],
 "event_buffer_max_age": 172800,
 "event_buffer_max_items": 10000,
 "features": {
  "Graphite": false,
  "IDO": true,
  "InfluxDB": false,
  "Syslog": true
 },
 "log_level": "3",
 "macros": [
  {
   "name": "environment",
   "value": "production"
  },
  {
   "name": "location",
   "value": "us-east-1"
  },
  {
   "name": "cluster_role",
   "value": "master"
  }
 ],
 "zones": [
  {
   "endpoints": [],
   "name": "global-templates",
   "parent_zone": ""
  },
  {
   "endpoints": [
    "master",
    "slave1"
   ],
   "name": "master-zone",
   "parent_zone": ""
  },
  {
   "endpoints": [
    "slave1"
   ],
   "name": "slave-zone",
   "parent_zone": "master-zone"
  }
 ]
}
