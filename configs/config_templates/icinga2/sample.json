{
  "log_level": "3",
  "enable_api": true,
  "api_bind_host": "0.0.0.0",
  "api_bind_port": 5665,
  "enable_notifications": true,
  "command_endpoint": "director-global",
  "event_buffer_max_age": 172800,
  "event_buffer_max_items": 10000,
  "zones": [
    {
      "name": "global-templates",
      "parent_zone": "",
      "endpoints": []
    },
    {
      "name": "master-zone",
      "parent_zone": "",
      "endpoints": [
        "master",
        "slave1"
      ]
    },
    {
      "name": "slave-zone",
      "parent_zone": "master-zone",
      "endpoints": [
        "slave1"
      ]
    }
  ],
  "endpoints": [
    {
      "name": "master",
      "host": "icinga-master.example.com",
      "port": 5665
    },
    {
      "name": "slave1",
      "host": "icinga-slave1.example.com",
      "port": 5665
    }
  ],
  "macros": [
    {
      "name": "environment",
      "value": "production"
    },
    {
      "name": "location",
      "value": "us-east-1"
    },
    {
      "name": "cluster_role",
      "value": "master"
    }
  ],
  "features": {
    "IDO": true,
    "Graphite": false,
    "InfluxDB": false,
    "Syslog": true
  }
}
