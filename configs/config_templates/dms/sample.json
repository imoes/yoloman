{
 "cache_dir": "/var/cache/anacrolix-dms/transcode",
 "db": "/var/lib/anacrolix-dms/db.sqlite3",
 "device_model_name": "Anacrolix dms",
 "device_model_url": "https://github.com/anacrolix/dms",
 "device_name": "Home Media Server",
 "file_filters_exclude": [
  ".*",
  "*.tmp",
  "*.part",
  "*.log"
 ],
 "http": 7890,
 "interface": "192.168.1.5",
 "log_file": "/var/log/dms.log",
 "log_level": "info",
 "mime_types": {
  "mkv": "video/x-matroska",
  "mov": "video/quicktime"
 },
 "root": "/mnt/media",
 "ssdp_enabled": true,
 "ssdp_port": 1900,
 "thumbnails_enabled": true,
 "thumbnails_height": 135,
 "thumbnails_width": 240,
 "transcode_enabled": true,
 "transcode_extra_args": [
  "-preset",
  "fast",
  "-crf",
  "23"
 ],
 "transcode_max_cores": 2,
 "transcode_profile": "h264"
}
