# shotman configuration file
# Managed by Ansible. See shotman(1) man page for full details.

[capture]
# The screenshot capture target: 'window', 'region', or 'output'. Defaults to 'region'.
target = {{ capture_target | default('region') }}

# If true, automatically copy the screenshot to the clipboard upon capture.
copy = {{ copy | default(false) | lower }}

# The anchor position for the floating thumbnail window. Common values: 'top-left', 'top-right', 'bottom-left', 'bottom-right'.
anchor = {{ anchor | default('top-left') }}

# If true, enable verbose logging output.
verbose = {{ verbose | default(false) | lower }}

[paths]
# Custom directory to save screenshots. If empty, shotman uses environment variables $XDG_SCREENSHOTS_DIR or $XDG_PICTURES_DIR/screenshots.
savedir = {{ savedir | default('') }}

[editor]
# The command or path to the image editor used for the 'Edit' function. Defaults to 'gimp'.
image_editor = {{ image_editor | default('gimp') }}

[wayland]
# The WAYLAND_DISPLAY socket name to connect to. If empty, uses the default compositor socket.
display = {{ wayland_display | default('') }}