{
  "server": {
    "name": "irc.example.net",
    "description": "Example Net IRC Server",
    "id": "E0000001"
  },
  "admin": {
    "name": "Jane Doe",
    "email": "irc-admin@example.net"
  },
  "operclasses": [
    {
      "name": "NetAdmin",
      "users": "1",
      "maxclasses": "1",
      "maxtargets": "50",
      "maxchannels": "10"
    },
    {
      "name": "Opers",
      "users": "10",
      "maxclasses": "3",
      "maxtargets": "10",
      "maxchannels": "0"
    }
  ],
  "opers": [
    {
      "name": "JaneDoe",
      "password": "$6$rounds=656000$example$hashedpassword",
      "host": "*@*.edu",
      "class": "NetAdmin",
      "flags": [
        "n",
        "N",
        "o",
        "O",
        "k",
        "K",
        "l",
        "L",
        "s",
        "S",
        "z",
        "Z",
        "d",
        "D",
        "g",
        "G",
        "h",
        "H",
        "x",
        "X",
        "w",
        "W",
        "Y",
        "y",
        "r",
        "R",
        "t",
        "T",
        "u",
        "U",
        "v",
        "V",
        "e",
        "E",
        "b",
        "B",
        "m",
        "M",
        "P",
        "p",
        "f",
        "F",
        "a",
        "A",
        "I",
        "i",
        "M",
        "m",
        "d",
        "D",
        "G",
        "g"
      ],
      "snomask": "cFf"
    }
  ],
  "listen_ports": [
    {
      "host": "*",
      "port": 6667,
      "ssl": false
    },
    {
      "host": "*",
      "port": 6697,
      "ssl": true,
      "ssl_options": [
        "no_sslv2",
        "no_sslv3",
        "cipher_server_preference"
      ]
    }
  ],
  "connect_allow": [
    "*",
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "connect": {
    "hspeed": 100000,
    "fspeed": 100000,
    "maxclients": 1,
    "sendq": 524288,
    "recvq": 8192,
    "thrashes": 0,
    "banthreshold": 3,
    "floodcount": 4,
    "floodtime": 60,
    "throttle": true
  },
  "ssl": {
    "enabled": true,
    "cert_file": "/etc/inspircd/ssl/server.crt",
    "key_file": "/etc/inspircd/ssl/server.key",
    "chain_file": "/etc/inspircd/ssl/chain.pem"
  },
  "logging": [
    {
      "target": "/var/log/inspircd/inspircd.log",
      "type": [
        "errors",
        "die",
        "restart",
        "connect",
        "kill",
        "server",
        "oper",
        "snotes",
        "svsnote"
      ],
      "mask": ""
    }
  ],
  "modules": [
    {
      "name": "m_ircv3_capab.so",
      "options": []
    },
    {
      "name": "m_ircv3_ctctags.so",
      "options": []
    },
    {
      "name": "m_svshold.so",
      "options": [
        "enable_nick_holds"
      ]
    },
    {
      "name": "m_spanningtree.so",
      "options": []
    }
  ],
  "channel": {
    "default_name": "default",
    "limit": 0,
    "key": "",
    "mode": [
      "m",
      "n",
      "t",
      "p",
      "s"
    ]
  },
  "services": {
    "host": "127.0.0.1",
    "port": 7000,
    "name": "services.example.net",
    "username": "services",
    "password": "secret",
    "send_password": "secret",
    "recv_password": "secret",
    "max_connections": 1
  },
  "options": {
    "max_clients": 500,
    "dns_timeout": 30,
    "host_lookups": true,
    "namesx": true,
    "operspy_unloc": false,
    "antiflood": true,
    "ident": true,
    "operchmode": true,
    "operchname": true,
    "operchpar": true,
    "operchdesc": true,
    "operchmodes": true
  }
}
