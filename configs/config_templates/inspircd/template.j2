{# InspIRCd Configuration Template #}
{# Generated by Ansible. See https://docs.inspircd.org/ for documentation. #}

{#
  Server Identity Block
  Defines the server's name, description, and network affiliation.
#}
<server name="{{ (ircd_server_name | default('irc.local')) | string }}"
        description="{{ (ircd_server_description | default('Local IRC Server')) | string }}"
        network="{{ (ircd_network_name | default('Localnet')) | string }}">

    {#
      Administrator Contact Block
      Defines who to contact for server administration issues.
    #}
    <admin name="{{ (ircd_admin_name | default('Root Penguin')) | string }}"
           description="{{ (ircd_admin_description | default('Nick')) | string }}"
           email="{{ (ircd_admin_email | default('root@localhost')) | string }}">

        {#
          DNS Server Configuration
          Specifies the DNS resolver IP for hostname lookups.
        #}
        <dns server="{{ (ircd_dns_server | default('127.0.0.1')) | string }}" timeout="5">


{#
  InspIRCd tags stand alone — <tag key="value" ...> with no closing tag (the shipped file has none);
  closing tags made InspIRCd find no <bind> block at all.
#}
{#
  Client Listener Bind Address
  The IP address and port where the IRC server accepts client connections.
#}
<bind address="{{ (ircd_bind_address | default('127.0.0.1')) | string }}"
      port="{{ (ircd_bind_port | default(6667)) | int }}"
      type="clients">


{#
  Oper (Operator) Type Definitions
  Defines the privilege classes available for IRC operators.
#}

{#
  NetAdmin Type
  Host mask allowed to become NetAdmin operators.
#}
<type name="NetAdmin"
      classes="OperChat BanControl HostCloak Shutdown ServerLink"
      host="{{ (ircd_oper_type_host_netadmin | default('netadmin.omega.org.za')) | string }}">


{#
  GlobalOp Type
  Host mask allowed to become GlobalOp operators.
#}
<type name="GlobalOp"
      classes="OperChat BanControl HostCloak ServerLink"
      host="{{ (ircd_oper_type_host_globalop | default('ircop.omega.org.za')) | string }}">


{#
  Helper Type
  Host mask allowed to become Helper operators.
#}
<type name="Helper"
      classes="HostCloak"
      host="{{ (ircd_oper_type_host_helper | default('helper.omega.org.za')) | string }}">


{#
  Root Operator Definition
  Defines the initial root operator account for administrative access.
#}
<oper name="{{ (ircd_oper_root_name | default('root')) | string }}"
      password="{{ (ircd_oper_root_password | default('12345')) | string }}"
      host="{{ (ircd_oper_root_host | default('*@localhost')) | string }}"
      type="{{ (ircd_oper_root_type | default('NetAdmin')) | string }}"
      maxchans="{{ (ircd_oper_root_maxchans | default('60')) | int }}">


{#
  Connect Block (Server Links)
  Defines how this server connects to other servers in the network.
  Note: This is a minimal default config. Add <connect> tags for uplinks.
#}
<connect allow="*"
         timeout="60"
         threshold="10"
         pingfreq="120"
         hardsendq="262144"
         softsendq="8192"
         recvq="8192"
         localmax="3"
         globalmax="3"
         maxchans="20">


{#
  Command Classes
  Groups commands that can be restricted by operator classes.
#}

{#
  Shutdown Class
  Commands for restarting, reloading, or shutting down the daemon.
#}
<class name="Shutdown"
       commands="DIE RESTART REHASH LOADMODULE UNLOADMODULE RELOADMODULE">


{#
  ServerLink Class
  Commands for linking/squiting to other servers.
#}
<class name="ServerLink"
       commands="CONNECT SQUIT RCONNECT RSQUIT MKPASSWD">


{#
  BanControl Class
  Commands for issuing global/local bans (K/G/Z/Q/Eline).
#}
<class name="BanControl"
       commands="KILL GLINE KLINE ZLINE QLINE ELINE">


{#
  OperChat Class
  Commands for operator-wide messaging (Wallops/Globops).
#}
<class name="OperChat"
       commands="WALLOPS GLOBOPS SETIDLE SPYLIST SPYNAMES">


{#
  HostCloak Class
  Commands for hiding/changing user hostnames.
#}
<class name="HostCloak"
       commands="SETHOST SETIDENT CHGNAME CHGHOST CHGIDENT">


{#
  Server Files Configuration
  Paths to static files like MOTD, bans, etc.
#}
<files motd="{{ (ircd_files_motd_path | default('/etc/inspircd/inspircd.motd')) | string }}">


{#
  Global Options
  Behavioral tweaks for the IRC protocol handling.
#}
<options prefixquit="{{ (ircd_options_prefixquit | default('Quit: ')) | string }}"
         syntaxhints="{{ (ircd_options_syntaxhints | default('no')) | string }}"
         announcets="{{ (ircd_options_announcets | default('yes')) | string }}"
         hostintopic="{{ (ircd_options_hostintopic | default('yes')) | string }}"
         pingwarning="{{ (ircd_options_pingwarning | default('15')) | string }}"
         splitwhois="{{ (ircd_options_splitwhois | default('no')) | string }}"
         exemptchanops="{{ (ircd_options_exemptchanops | default('')) | string }}">


{#
  Security Settings
  Hideserver info, limits, and topology options.
#}
<security hideserver="{{ (ircd_security_hideserver | default('')) | string }}"
          userstats="{{ (ircd_security_userstats | default('Pu')) | string }}"
          customversion="{{ (ircd_security_customversion | default('')) | string }}"
          flatlinks="{{ (ircd_security_flatlinks | default('no')) | string }}"
          hidesplits="{{ (ircd_security_hidesplits | default('no')) | string }}"
          hideulines="{{ (ircd_security_hideulines | default('no')) | string }}"
          hidebans="{{ (ircd_security_hidebans | default('no')) | string }}"
          maxtargets="{{ (ircd_security_maxtargets | default('20')) | int }}">


{#
  Performance Tuning
  Connection limits and buffer sizes.
#}
<performance quietbursts="{{ (ircd_performance_quietbursts | default('yes')) | string }}"
             softlimit="{{ (ircd_performance_softlimit | default('1024')) | int }}"
             somaxconn="{{ (ircd_performance_somaxconn | default('128')) | int }}"
             netbuffersize="{{ (ircd_performance_netbuffersize | default('10240')) | int }}">


{#
  Whowas Cache Configuration
  Controls how long nick history is retained.
#}
<whowas groupsize="{{ (ircd_whowas_groupsize | default('10')) | int }}"
        maxgroups="{{ (ircd_whowas_maxgroups | default('100000')) | int }}"
        maxkeep="{{ (ircd_whowas_maxkeep | default('3d')) | string }}">


{#
  Reserved Badnicks
  Prevents users from registering these specific nicknames.
#}
<badnick nick="ChanServ" reason="Reserved For Services">

<badnick nick="NickServ" reason="Reserved For Services">

<badnick nick="OperServ" reason="Reserved For Services">

<badnick nick="MemoServ" reason="Reserved For Services">

