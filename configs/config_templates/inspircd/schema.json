{
  "server": {
    "type": "object",
    "default": {
      "name": "irc.example.net",
      "description": "My InspIRCd Server",
      "id": "12345678"
    },
    "description": "Server identification \u2014 name must match DNS or be a valid hostname, ID is unique per server in a network"
  },
  "admin": {
    "type": "object",
    "default": {
      "name": "Server Admin",
      "email": "admin@example.net"
    },
    "description": "Administrative contact for the server"
  },
  "operclasses": {
    "type": "list",
    "default": [
      {
        "name": "NetAdmin",
        "users": "1",
        "maxclasses": "1",
        "maxtargets": "50",
        "maxchannels": "10"
      },
      {
        "name": "Opers",
        "users": "5",
        "maxclasses": "3",
        "maxtargets": "10",
        "maxchannels": "0"
      }
    ],
    "items": {
      "name": "string",
      "users": "number",
      "maxclasses": "number",
      "maxtargets": "number",
      "maxchannels": "number"
    },
    "description": "Operator classes define resource limits for different operator types"
  },
  "opers": {
    "type": "list",
    "default": [
      {
        "name": "NetAdmin",
        "password": "$6$rounds=656000$...$hashed",
        "host": "*@*.edu",
        "class": "NetAdmin",
        "flags": [
          "n",
          "N",
          "o",
          "O",
          "k",
          "K",
          "l",
          "L",
          "j",
          "J",
          "c",
          "C",
          "q",
          "Q",
          "s",
          "S",
          "z",
          "Z",
          "d",
          "D",
          "g",
          "G",
          "h",
          "H",
          "x",
          "X",
          "w",
          "W",
          "Y",
          "y",
          "r",
          "R",
          "t",
          "T",
          "u",
          "U",
          "v",
          "V",
          "e",
          "E",
          "b",
          "B",
          "m",
          "M",
          "P",
          "p",
          "f",
          "F",
          "a",
          "A",
          "I",
          "i",
          "M",
          "m",
          "d",
          "D",
          "G",
          "g"
        ],
        "snomask": "cFf"
      }
    ],
    "items": {
      "name": "string",
      "password": "string",
      "host": "string",
      "class": "string",
      "flags": "list",
      "snomask": "string"
    },
    "description": "IRC operators (opers) with full server control \u2014 each must match a defined class"
  },
  "listen_ports": {
    "type": "list",
    "default": [
      {
        "host": "*",
        "port": 6667,
        "ssl": false
      },
      {
        "host": "*",
        "port": 6697,
        "ssl": true,
        "ssl_options": [
          "no_sslv2",
          "no_sslv3",
          "cipher_server_preference"
        ]
      }
    ],
    "items": {
      "host": "string",
      "port": "number",
      "ssl": "bool",
      "ssl_options": "list"
    },
    "description": "TCP ports and hosts to listen on \u2014 one block per port/SSL configuration"
  },
  "connect_allow": {
    "type": "list",
    "default": [
      "*"
    ],
    "description": "CIDR or host globs allowed to connect (e.g., ['*', '192.168.0.0/16', '10.*'])"
  },
  "connect": {
    "type": "object",
    "default": {
      "hspeed": 100000,
      "fspeed": 100000,
      "maxclients": 1,
      "sendq": 524288,
      "recvq": 8192,
      "thrashes": 0,
      "banthreshold": 3,
      "floodcount": 4,
      "floodtime": 60,
      "throttle": true
    },
    "description": "Default connection class \u2014 controls bandwidth, flood protection, and resource limits"
  },
  "ssl": {
    "type": "object",
    "default": {
      "enabled": false,
      "cert_file": "/etc/inspircd/ssl/server.crt",
      "key_file": "/etc/inspircd/ssl/server.key",
      "chain_file": ""
    },
    "description": "SSL/TLS configuration for secure connections"
  },
  "logging": {
    "type": "list",
    "default": [
      {
        "target": "/var/log/inspircd/inspircd.log",
        "type": [
          "errors",
          "die",
          "restart",
          "connect",
          "kill",
          "server",
          "oper",
          "chanserv",
          "modes",
          "snotes",
          "svsnote",
          "svsjoin",
          "svspart",
          "svsmode",
          "svskick",
          "svswhois",
          "svsmode",
          "svsjoin",
          "svspart",
          "svsnote",
          "svsoper",
          "svslogout",
          "svswhois",
          "svsmode",
          "svskick",
          "svsjoin",
          "svspart",
          "svsnote",
          "svsoper",
          "svslogout"
        ],
        "mask": ""
      }
    ],
    "items": {
      "target": "string",
      "type": "list",
      "mask": "string"
    },
    "description": "Logging destinations \u2014 target file, log types (comma-separated), optional mask for filtering"
  },
  "modules": {
    "type": "list",
    "default": [
      {
        "name": "m_ircv3_ctctags.so",
        "options": []
      },
      {
        "name": "m_ircv3_capab.so",
        "options": []
      },
      {
        "name": "m_svshold.so",
        "options": [
          "enable_nick_holds"
        ]
      },
      {
        "name": "m_spanningtree.so",
        "options": []
      }
    ],
    "items": {
      "name": "string",
      "options": "list"
    },
    "description": "Modules to load \u2014 usually required for protocol extensions or services"
  },
  "channel": {
    "type": "object",
    "default": {
      "default_name": "default",
      "limit": 0,
      "key": "",
      "mode": [
        "m",
        "n",
        "t",
        "p",
        "s"
      ]
    },
    "description": "Default channel properties \u2014 mode flags, name, key, and user limit"
  },
  "services": {
    "type": "object",
    "default": {
      "host": "",
      "port": 7000,
      "name": "services.irc.example.net",
      "username": "services",
      "password": "secret",
      "send_password": "secret",
      "recv_password": "secret",
      "max_connections": 1
    },
    "description": "Services link configuration \u2014 set host to empty string to disable services linking"
  },
  "options": {
    "type": "object",
    "default": {
      "max_clients": 500,
      "dns_timeout": 30,
      "host_lookups": true,
      "namesx": true,
      "operspy_unloc": false,
      "antiflood": true,
      "ident": true,
      "operchmode": true,
      "operchname": true,
      "operchpar": true,
      "operchdesc": true,
      "operchmodes": true
    },
    "description": "Global server options \u2014 tuning behavior for DNS, oper privs, protocol extensions"
  }
}
