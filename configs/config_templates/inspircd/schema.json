{
  "ircdargs": {
    "type": "string",
    "default": "",
    "description": "Additional command-line arguments for the inspircd daemon. Must retain pre-existing IRCDARGS values."
  },
  "ircd_server_name": {
    "type": "string",
    "default": "irc.local",
    "description": "The hostname of the local IRC server."
  },
  "ircd_server_description": {
    "type": "string",
    "default": "Local IRC Server",
    "description": "Description string for the server."
  },
  "ircd_network_name": {
    "type": "string",
    "default": "Localnet",
    "description": "Name of the IRC network this server belongs to."
  },
  "ircd_admin_name": {
    "type": "string",
    "default": "Root Penguin",
    "description": "Nickname of the server administrator contact."
  },
  "ircd_admin_description": {
    "type": "string",
    "default": "Nick",
    "description": "Description of the administrator contact."
  },
  "ircd_admin_email": {
    "type": "string",
    "default": "root@localhost",
    "description": "Email address for the administrator contact."
  },
  "ircd_bind_address": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address to bind the client listener to."
  },
  "ircd_bind_port": {
    "type": "number",
    "default": 6667,
    "description": "Port number to bind the client listener to."
  },
  "ircd_oper_type_host_netadmin": {
    "type": "string",
    "default": "netadmin.omega.org.za",
    "description": "Host mask for the NetAdmin oper type."
  },
  "ircd_oper_type_host_globalop": {
    "type": "string",
    "default": "ircop.omega.org.za",
    "description": "Host mask for the GlobalOp oper type."
  },
  "ircd_oper_type_host_helper": {
    "type": "string",
    "default": "helper.omega.org.za",
    "description": "Host mask for the Helper oper type."
  },
  "ircd_oper_root_name": {
    "type": "string",
    "default": "root",
    "description": "Name of the root operator."
  },
  "ircd_oper_root_password": {
    "type": "string",
    "default": "12345",
    "description": "Password for the root operator."
  },
  "ircd_oper_root_host": {
    "type": "string",
    "default": "*@localhost",
    "description": "Host mask allowed to connect as root operator."
  },
  "ircd_oper_root_type": {
    "type": "string",
    "default": "NetAdmin",
    "description": "Oper type class for the root operator.",
    "enum": [
      "NetAdmin",
      "GlobalOp",
      "Helper",
      "Shutdown",
      "ServerLink",
      "BanControl",
      "OperChat",
      "HostCloak"
    ]
  },
  "ircd_oper_root_maxchans": {
    "type": "number",
    "default": 60,
    "description": "Maximum channels the root operator can join."
  },
  "ircd_files_motd_path": {
    "type": "string",
    "default": "/etc/inspircd/inspircd.motd",
    "description": "Path to the Message of the Day file."
  },
  "ircd_dns_server": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "DNS server IP address to use for lookups."
  },
  "ircd_options_prefixquit": {
    "type": "string",
    "default": "Quit: ",
    "description": "Prefix added to quit messages."
  },
  "ircd_options_syntaxhints": {
    "type": "string",
    "default": "no",
    "description": "Enable syntax hints for commands."
  },
  "ircd_options_announcets": {
    "type": "string",
    "default": "yes",
    "description": "Announce timestamp in channels."
  },
  "ircd_options_hostintopic": {
    "type": "string",
    "default": "yes",
    "description": "Show host in channel topic."
  },
  "ircd_options_pingwarning": {
    "type": "number",
    "default": 15,
    "description": "Seconds before warning a client for ping timeout."
  },
  "ircd_options_splitwhois": {
    "type": "string",
    "default": "no",
    "description": "Enable split whois."
  },
  "ircd_options_exemptchanops": {
    "type": "string",
    "default": "",
    "description": "List of exempt channel operators."
  },
  "ircd_security_hideserver": {
    "type": "string",
    "default": "",
    "description": "Hide server information in whois."
  },
  "ircd_security_userstats": {
    "type": "string",
    "default": "Pu",
    "description": "User stats flags to hide.",
    "enum": [
      "P",
      "u",
      "Pu"
    ]
  },
  "ircd_security_customversion": {
    "type": "string",
    "default": "",
    "description": "Custom version string to hide."
  },
  "ircd_security_flatlinks": {
    "type": "string",
    "default": "no",
    "description": "Use flat links topology."
  },
  "ircd_security_hidesplits": {
    "type": "string",
    "default": "no",
    "description": "Hide split information."
  },
  "ircd_security_hideulines": {
    "type": "string",
    "default": "no",
    "description": "Hide U-lines."
  },
  "ircd_security_hidebans": {
    "type": "string",
    "default": "no",
    "description": "Hide ban details."
  },
  "ircd_security_maxtargets": {
    "type": "number",
    "default": 20,
    "description": "Maximum targets for a single command."
  },
  "ircd_performance_quietbursts": {
    "type": "string",
    "default": "yes",
    "description": "Quiet bursts."
  },
  "ircd_performance_softlimit": {
    "type": "number",
    "default": 1024,
    "description": "Soft limit for connections."
  },
  "ircd_performance_somaxconn": {
    "type": "number",
    "default": 128,
    "description": "SOMAXCONN value for the listen socket."
  },
  "ircd_performance_netbuffersize": {
    "type": "number",
    "default": 10240,
    "description": "Network buffer size."
  },
  "ircd_whowas_groupsize": {
    "type": "number",
    "default": 10,
    "description": "Group size for whowas cache."
  },
  "ircd_whowas_maxgroups": {
    "type": "number",
    "default": 100000,
    "description": "Maximum number of whowas groups."
  },
  "ircd_whowas_maxkeep": {
    "type": "string",
    "default": "3d",
    "description": "Maximum keep time for whowas entries."
  }
}
