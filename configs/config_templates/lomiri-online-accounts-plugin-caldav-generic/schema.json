{
  "profile_name": {
    "type": "string",
    "default": "lomiri-generic-caldav",
    "description": "The name of the main profile."
  },
  "profile_type": {
    "type": "string",
    "default": "sync",
    "description": "The type of the main profile.",
    "enum": [
      "sync",
      "client"
    ]
  },
  "category": {
    "type": "string",
    "default": "calendar",
    "description": "The category of the account."
  },
  "remote_service_name": {
    "type": "string",
    "default": "lomiri-generic-caldav",
    "description": "The remote service name identifier."
  },
  "destinationtype": {
    "type": "string",
    "default": "online",
    "description": "The destination type for the account.",
    "enum": [
      "online",
      "local"
    ]
  },
  "enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether the profile is enabled by default."
  },
  "hidden": {
    "type": "bool",
    "default": false,
    "description": "Whether the profile is hidden in UI."
  },
  "use_accounts": {
    "type": "bool",
    "default": true,
    "description": "Whether to use system accounts."
  },
  "client_profile_type": {
    "type": "string",
    "default": "client",
    "description": "The type of the client profile."
  },
  "client_profile_name": {
    "type": "string",
    "default": "caldav",
    "description": "The name of the client profile."
  },
  "sync_direction": {
    "type": "string",
    "default": "two-way",
    "description": "The synchronization direction."
  },
  "sync_direction_name": {
    "type": "string",
    "default": "Sync Direction",
    "description": "The key name for the sync direction setting."
  },
  "sync_protocol": {
    "type": "string",
    "default": "caldav",
    "description": "The synchronization protocol."
  },
  "sync_protocol_name": {
    "type": "string",
    "default": "Sync Protocol",
    "description": "The key name for the sync protocol setting."
  },
  "sync_transport": {
    "type": "string",
    "default": "HTTP",
    "description": "The synchronization transport layer."
  },
  "sync_transport_name": {
    "type": "string",
    "default": "Sync Transport",
    "description": "The key name for the sync transport setting."
  },
  "conflictpolicy": {
    "type": "string",
    "default": "prefer remote",
    "description": "The conflict resolution policy."
  },
  "conflictpolicy_name": {
    "type": "string",
    "default": "conflictpolicy",
    "description": "The key name for the conflict policy setting."
  },
  "schedule_enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether the schedule is enabled."
  },
  "schedule_interval": {
    "type": "string",
    "default": "",
    "description": "The synchronization interval."
  },
  "schedule_days": {
    "type": "string",
    "default": "1,2,3,4,5,6,7",
    "description": "The days on which synchronization occurs."
  },
  "schedule_syncconfiguredtime": {
    "type": "string",
    "default": "",
    "description": "The sync configured time override."
  },
  "schedule_time": {
    "type": "string",
    "default": "05:00:00",
    "description": "The scheduled time for synchronization."
  }
}
