{
  "xfer_max_redirections": 10,
  "ssl_verify_certificate": false,
  "ftp_passive_mode": true,
  "net_timeout": 30,
  "net_reconnect_interval_base": 1,
  "ftp_reconnect_interval": 2,
  "ftp_reconnect_retries": 5,
  "sftp_connect_retries": 3,
  "ftp_conn_limit": 0,
  "http_conn_limit": 0,
  "ftp_passive_limit": 0,
  "net_socket_buffer": 0,
  "file_charset": "utf-8",
  "ftp_preserve_mtime": false,
  "ftp_use_list_options": "-a",
  "ftp_debug": false,
  "http_debug": false,
  "sftp_debug": false,
  "default_alias_cd": "ls -la",
  "default_alias_get": "mget -c",
  "default_alias_put": "mput -c",
  "default_mirror_dir": "/",
  "default_site_url": "ftp://anonymous@ftp.example.com",
  "sites": []
}
