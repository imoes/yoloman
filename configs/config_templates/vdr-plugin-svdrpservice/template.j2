#
# svdrpservice VDR plugin arguments
#
# Configuration for the VDR (Video Disk Recorder) svdrpservice plugin.
# This plugin provides an HTTP interface to VDR's SVDRP (Simple VDR Protocol).
#
# The [svdrpservice] section defines connection parameters for the HTTP server
# that exposes the SVDRP interface, allowing external control of VDR.
#
# 'host': The network interface address to bind the HTTP server to.
#         Default is '127.0.0.1' (localhost-only) for security. Use '0.0.0.0' to allow external access.
host = {{ host | default('127.0.0.1') }}

# 'port': The TCP port number for the HTTP server.
#         Default is 6419, which is the standard SVDRP port (though usually raw TCP, this plugin wraps it in HTTP).
port = {{ port | default(6419) }}
#
# [svdrpservice]
# Note: The 'host' and 'port' directives above are the primary configuration items
# expected by most VDR plugins of this type. Further options like authentication
# or specific SVDRP command restrictions are often handled via VDR's global plugins.conf
# or separate plugin-specific config files if supported by the specific plugin version.
# If this plugin supports additional key-value pairs in this section, they would follow here.
#
# Example for future expansion (if supported):
# # 'ssl': Enable SSL/TLS for the HTTP interface (true/false).
# ssl = {{ ssl | default(false) | lower }}
#
# # 'ssl_cert': Path to the SSL certificate file.
# ssl_cert = {{ ssl_cert | default('/etc/vdr/ssl/cert.pem') }}
#
# # 'ssl_key': Path to the SSL private key file.
# ssl_key = {{ ssl_key | default('/etc/vdr/ssl/key.pem') }}
#
# # 'auth_user': Username for HTTP Basic Authentication.
# auth_user = {{ auth_user | default('') }}
#
# # 'auth_pass': Password for HTTP Basic Authentication.
# auth_pass = {{ auth_pass | default('') }}
#
# # 'allowed_ips': Comma-separated list of IPs allowed to connect (if empty, all allowed).
# allowed_ips = {{ allowed_ips | default('') }}