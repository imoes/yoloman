# Select build method from sbuild, xdeb, pdebuild (pdebuild-cross)
buildmethod={{ buildmethod | default('sbuild') }}

# Base directory for buildd operations
base={{ base | default('/srv/buildd') }}

# Choose arch to build for
arch={{ arch | default('armhf') }}

# Filename of list of packages to build
buildlist=${base}/buildlist-debian-minimal

# If cleanbuild is set then each build will be done in a clean chroot
# this is recommended for repeatable builds
# unset it to disable
cleanbuild={{ cleanbuild | default(true) }}

# Configure chroot used for clean builds - must match schroot config
distro={{ distro | default('testing') }}

chrootname={{ chrootname | default('testing-amd64-sbuild') }}
