# ============================================================
# tj3 — TaskJuggler 3 Configuration
# This file configures the behavior of the tj3 (TaskJuggler 3)
# report generator. Each directive is self-documented below.
# ============================================================

# taskjuggler_data_path: Override the path to the TaskJuggler data folder
# containing CSS stylesheets, icons and scripts used by generated reports.
# Default: /usr/share/taskjuggler
taskjuggler_data_path: {{ taskjuggler_data_path|default('/usr/share/taskjuggler') }}

# output_dir: Directory where tj3 writes its generated reports.
# Default: output
output_dir: {{ output_dir|default('output') }}

# max_cores: Maximum number of CPU cores tj3 will use for scheduling
# calculations to parallelize work.
# Default: 4
max_cores: {{ max_cores|default(4) }}

# silent: When true, suppress program and progress information
# output to stdout, keeping only essential results or errors.
# Default: false
silent: {{ silent|default(false)|bool }}

# no_color: When true, disable ANSI color control sequences in
# terminal output, making it suitable for log files.
# Default: false
no_color: {{ no_color|default(false)|bool }}

# debug: Enable Ruby debug mode, which activates verbose internal
# debugging output useful for troubleshooting.
# Default: false
debug: {{ debug|default(false)|bool }}

# debug_level: Verbosity level for debug output (integer, typically 0-9).
# Higher values produce more detailed logs.
# Default: 0
debug_level: {{ debug_level|default(0) }}

# debug_modules: Restrict debug output to a specific comma-separated
# list of modules (e.g., 'parser,reporter'). Empty means all modules.
# Default: []
debug_modules: {{ debug_modules|default([])|join(', ') }}

# warn_ts_deltas: Turn on warnings when requested changes in time
# sheets (timesheet delta) are detected.
# Default: false
warn_ts_deltas: {{ warn_ts_deltas|default(false)|bool }}

# abort_on_warnings: If true, abort the program execution upon
# encountering warnings, treating them as fatal errors.
# Default: false
abort_on_warnings: {{ abort_on_warnings|default(false)|bool }}

# force_reports: Force generation of reports even if scheduling
# errors were encountered during analysis.
# Default: false
force_reports: {{ force_reports|default(false)|bool }}

# add_trace: Append the current data set to all trace reports,
# allowing historical comparison or auditing.
# Default: false
add_trace: {{ add_trace|default(false)|bool }}

# freezedate: Use a different date than the current moment as the
# cut-off date for the booking file. Leave empty to use current date.
# Default: '' (empty string means current date)
freezedate: {{ freezedate|default('') }}

# freezebytask: When using a freeze, group the bookings in the
# generated booking file by task instead of by resource.
# Default: false
freezebytask: {{ freezebytask|default(false)|bool }}