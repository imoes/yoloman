{
  "taskjuggler_data_path": "/usr/local/share/taskjuggler",
  "output_dir": "/var/taskjuggler/reports",
  "max_cores": 8,
  "silent": false,
  "no_color": true,
  "debug": false,
  "debug_level": 2,
  "debug_modules": [
    "parser",
    "scheduler"
  ],
  "warn_ts_deltas": true,
  "abort_on_warnings": false,
  "force_reports": true,
  "add_trace": false,
  "freezedate": "2026-12-31",
  "freezebytask": false
}
