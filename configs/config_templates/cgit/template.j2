# =============================================================================
# CGit Apache Configuration Template
# =============================================================================
# This template generates the Apache virtual host or snippet configuration
# required to serve the CGit web interface. CGit is a fast web-based
# interface for Git repositories.
#
# Variables used:
#   cgit_url_path      - URL path prefix for the CGit interface (default: 'cgit')
#   cgit_cgi_path      - Filesystem path to the CGit CGI executable (default: '/usr/lib/cgit')
#   cgit_css_url_path  - URL path prefix for CSS/static assets (default: 'cgit-css')
#   cgit_css_path      - Filesystem path to static assets directory (default: '/usr/share/cgit')
# =============================================================================

# Define the URL path where CGit will be accessible.
# Example: If set to 'cgit', the interface is at http://host/cgit/
{% set url_path = cgit_url_path | default('cgit') %}

# Define the filesystem path to the CGit CGI script directory.
# This is typically where the compiled cgit binary resides.
{% set cgi_path = cgit_cgi_path | default('/usr/lib/cgit') %}

# Define the URL path prefix for static assets (CSS, images, etc.).
# These are served directly by Apache for performance.
{% set css_url_path = cgit_css_url_path | default('cgit-css') %}

# Define the filesystem path to the static assets directory.
# This contains the CSS files and images referenced by the CGit interface.
{% set css_path = cgit_css_path | default('/usr/share/cgit') %}

# ScriptAlias maps a URL path to a directory containing CGI scripts.
# Requests to {{ url_path }}/ will be handled by the CGI script in {{ cgi_path }}.
# The trailing slash in the path and the argument are significant.
ScriptAlias /{{ url_path }}/ "{{ cgi_path }}/"

# RedirectMatch ensures that accessing the base URL (without trailing slash)
# redirects to the URL with the trailing slash, preventing mixed content issues.
# Matches: http://host/{{ url_path }}
# Redirects to: http://host/{{ url_path }}/
RedirectMatch ^/{{ url_path }}$ /{{ url_path }}/

# Alias maps a URL path to a filesystem directory for static files.
# Requests to {{ css_url_path }} will serve files from {{ css_path }}.
Alias /{{ css_url_path }} "{{ css_path }}/"

# <Directory> block configures access control and execution permissions
# for the directory containing the CGI scripts.
<Directory "{{ cgi_path }}/">
    # AllowOverride None: Prevent .htaccess files from overriding these settings.
    AllowOverride None

    # Options:
    #   ExecCGI: Allow execution of CGI scripts in this directory.
    #   FollowSymlinks: Allow the server to follow symbolic links.
    Options ExecCGI FollowSymlinks

    # Require all granted: Allow access to all users (assuming authentication
    # is handled by the application or other means, or if the repo list
    # is public).
    Require all granted
</Directory>
