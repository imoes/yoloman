{
  "ldap_uris": [
    "ldaps://dc1.example.com",
    "ldaps://dc2.example.com"
  ],
  "base_dn": "dc=edusite,dc=local",
  "bind_dn": "CN=ldap-bind,CN=Users,DC=edusite,DC=local",
  "bind_password": "",
  "bind_password_file": "/etc/debian-edu-router/.ldap-passwd",
  "ssl_mode": "starttls",
  "ca_cert_file": "/etc/ssl/certs/edusite-ca.crt",
  "client_cert_file": "/etc/debian-edu-router/ldap-client.crt",
  "client_key_file": "/etc/debian-edu-router/ldap-client.key",
  "user_search_base": "OU=Users,DC=edusite,DC=local",
  "group_search_base": "OU=Groups,DC=edusite,DC=local",
  "user_filter": "(&(objectClass=user)(sAMAccountName={{username}}))",
  "group_filter": "(&(objectClass=group)(sAMAccountName={{groupname}}))",
  "user_attrs": [
    "sAMAccountName",
    "uidNumber",
    "gidNumber",
    "cn",
    "unixHomeDirectory",
    "loginShell"
  ],
  "group_attrs": [
    "sAMAccountName",
    "gidNumber",
    "member"
  ],
  "nested_groups": true,
  "cache_ttl": 600,
  "cache_enabled": true,
  "min_uid": 2000,
  "min_gid": 2000,
  "max_uid": 1000000000,
  "max_gid": 1000000000,
  "home_dir_template": "/home/%u",
  "shell_template": "%s",
  "sudo_search_base": "OU=SUDOers,OU=Services,DC=edusite,DC=local",
  "sudo_filter": "(&(objectClass=sudoRole)(sudoUser=%u))",
  "sudo_cmd_attr": "sudoCommand",
  "sudo_runas_attr": "sudoRunAsUser",
  "sudo_enabled": true,
  "timeout": 15,
  "sizelimit": 500,
  "alias_dereference": "always",
  "log_level": "warn",
  "log_file": "/var/log/ldap-connector.log",
  "sasl_principal": "host/router.edusite.local@EDUSITE.LOCAL",
  "keytab_file": "/etc/krb5.keytab",
  "sasl_mech": "GSSAPI",
  "referral_mode": "follow"
}
