{
  "action": "c",
  "filename": "backup_2023.xar",
  "compression": "gzip",
  "compression_level": 9,
  "extract_dir": "/opt/data/restore",
  "toc_cksum": "sha256",
  "file_cksum": "sha256",
  "rsize": 524288,
  "exclude_patterns": [
    "\\.git$",
    "node_modules/"
  ],
  "no_compress_patterns": [
    "\\.jpg$",
    "\\.png$"
  ],
  "stay_local": true,
  "set_ownership_uid": false,
  "set_ownership_symbolic": false,
  "verbose": true,
  "keep_existing": false,
  "coalesce_heap": false,
  "link_same": false,
  "keep_setuid": false,
  "prop_include": [
    "name",
    "type",
    "mode",
    "data",
    "uid",
    "gid"
  ],
  "prop_exclude": [
    "ctime"
  ],
  "distribution_safe": false
}
