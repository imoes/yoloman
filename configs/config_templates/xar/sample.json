{
 "action": "c",
 "coalesce_heap": false,
 "compression": "gzip",
 "compression_level": 9,
 "distribution_safe": false,
 "exclude_patterns": [
  "\\.git$",
  "node_modules/"
 ],
 "ext_dir": "",
 "extract_dir": "/opt/data/restore",
 "file_cksum": "sha256",
 "filename": "backup_2023.xar",
 "keep_existing": false,
 "keep_setuid": false,
 "link_same": false,
 "no_compress_patterns": [
  "\\.jpg$",
  "\\.png$"
 ],
 "prop_exclude": [
  "ctime"
 ],
 "prop_include": [
  "name",
  "type",
  "mode",
  "data",
  "uid",
  "gid"
 ],
 "rsize": 524288,
 "set_ownership_symbolic": false,
 "set_ownership_uid": false,
 "stay_local": true,
 "toc_cksum": "sha256",
 "verbose": true
}
