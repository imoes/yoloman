# Remove users from groups upon user deletion
# Default: yes — whether to automatically remove users from secondary groups on user removal
# (This affects behavior of `deluser --remove-user` or `deluser user group`)
remove_user_from_groups: {{ remove_user_from_groups }}

# Default: yes — whether to remove the user's home directory when deleting the user
# Note: Home removal is *not* done by default in `deluser` unless explicitly requested
remove_home: {{ remove_home }}

# Default: no — whether to remove the user's mail spool file (e.g., /var/mail/username)
remove_mail_spool: {{ remove_mail_spool }}

# Default: /var/backups — directory to store backup tarballs of home directories (if enabled)
backup_to: {{ backup_to }}

# Default: yes — whether to create a backup tarball of the user's home directory before removal
backup: {{ backup }}

# Default: none — list of additional groups from which to *not* remove the user (even if remove_user_from_groups = yes)
# Each group is specified as a string; use `[]` for empty list
# Example: ['cdrom', 'dialout']
keep_groups: [{% for group in keep_groups %}{% if not loop.first %}, {% endif %}'{{ group }}'{% endfor %}]
