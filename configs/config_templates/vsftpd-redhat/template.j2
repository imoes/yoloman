# Example config file /etc/vsftpd/vsftpd.conf
#
# The default compiled in settings are fairly paranoid. This sample file
# loosens things up a bit, to make the ftp daemon more usable.
# Please see vsftpd.conf.5 for all compiled in defaults.
#
# READ THIS: This example file is NOT an exhaustive list of vsftpd options.
# Please read the vsftpd.conf.5 manual page to get a full idea of vsftpd's
# capabilities.
#
# Allow anonymous FTP? (Beware - allowed by default if you comment this out).
anonymous_enable={{ anonymous_enable | default('NO') }}
#
# Uncomment this to allow local users to log in.
local_enable={{ local_enable | default('YES') }}
#
# Uncomment this to enable any form of FTP write command.
write_enable={{ write_enable | default('YES') }}
#
# Default umask for local users is 077. You may wish to change this to 022,
# if your users expect that (022 is used by most other ftpd's)
local_umask={{ local_umask | default('022') }}
#
# Uncomment this to allow the anonymous FTP user to upload files. This only
# has an effect if the above global write enable is activated. Also, you will
# obviously need to create a directory writable by the FTP user.
# When SELinux is enforcing check for SE bool allow_ftpd_anon_write, allow_ftpd_full_access
{% if anon_upload_enable is defined and anon_upload_enable is not none and (anon_upload_enable is number or anon_upload_enable is boolean or anon_upload_enable | length > 0) %}anon_upload_enable={{ anon_upload_enable }}
{% else %}#anon_upload_enable=YES
{% endif %}#
# Uncomment this if you want the anonymous FTP user to be able to create
# new directories.
{% if anon_mkdir_write_enable is defined and anon_mkdir_write_enable is not none and (anon_mkdir_write_enable is number or anon_mkdir_write_enable is boolean or anon_mkdir_write_enable | length > 0) %}anon_mkdir_write_enable={{ anon_mkdir_write_enable }}
{% else %}#anon_mkdir_write_enable=YES
{% endif %}#
# Activate directory messages - messages given to remote users when they
# go into a certain directory.
dirmessage_enable={{ dirmessage_enable | default('YES') }}
#
# Activate logging of uploads/downloads.
xferlog_enable={{ xferlog_enable | default('YES') }}
#
# Make sure PORT transfer connections originate from port 20 (ftp-data).
connect_from_port_20={{ connect_from_port_20 | default('YES') }}
#
# If you want, you can arrange for uploaded anonymous files to be owned by
# a different user. Note! Using "root" for uploaded files is not
# recommended!
{% if chown_uploads is defined and chown_uploads is not none and (chown_uploads is number or chown_uploads is boolean or chown_uploads | length > 0) %}chown_uploads={{ chown_uploads }}
{% else %}#chown_uploads=YES
{% endif %}{% if chown_username is defined and chown_username is not none and (chown_username is number or chown_username is boolean or chown_username | length > 0) %}chown_username={{ chown_username }}
{% else %}#chown_username=whoever
{% endif %}#
# You may override where the log file goes if you like. The default is shown
# below.
{% if xferlog_file is defined and xferlog_file is not none and (xferlog_file is number or xferlog_file is boolean or xferlog_file | length > 0) %}xferlog_file={{ xferlog_file }}
{% else %}#xferlog_file=/var/log/xferlog
{% endif %}#
# If you want, you can have your log file in standard ftpd xferlog format.
# Note that the default log file location is /var/log/xferlog in this case.
xferlog_std_format={{ xferlog_std_format | default('YES') }}
#
# You may change the default value for timing out an idle session.
{% if idle_session_timeout is defined and idle_session_timeout is not none and (idle_session_timeout is number or idle_session_timeout is boolean or idle_session_timeout | length > 0) %}idle_session_timeout={{ idle_session_timeout }}
{% else %}#idle_session_timeout=600
{% endif %}#
# You may change the default value for timing out a data connection.
{% if data_connection_timeout is defined and data_connection_timeout is not none and (data_connection_timeout is number or data_connection_timeout is boolean or data_connection_timeout | length > 0) %}data_connection_timeout={{ data_connection_timeout }}
{% else %}#data_connection_timeout=120
{% endif %}#
# It is recommended that you define on your system a unique user which the
# ftp server can use as a totally isolated and unprivileged user.
{% if nopriv_user is defined and nopriv_user is not none and (nopriv_user is number or nopriv_user is boolean or nopriv_user | length > 0) %}nopriv_user={{ nopriv_user }}
{% else %}#nopriv_user=ftpsecure
{% endif %}#
# Enable this and the server will recognise asynchronous ABOR requests. Not
# recommended for security (the code is non-trivial). Not enabling it,
# however, may confuse older FTP clients.
{% if async_abor_enable is defined and async_abor_enable is not none and (async_abor_enable is number or async_abor_enable is boolean or async_abor_enable | length > 0) %}async_abor_enable={{ async_abor_enable }}
{% else %}#async_abor_enable=YES
{% endif %}#
# By default the server will pretend to allow ASCII mode but in fact ignore
# the request. Turn on the below options to have the server actually do ASCII
# mangling on files when in ASCII mode. The vsftpd.conf(5) man page explains
# the behaviour when these options are disabled.
# Beware that on some FTP servers, ASCII support allows a denial of service
# attack (DoS) via the command "SIZE /big/file" in ASCII mode. vsftpd
# predicted this attack and has always been safe, reporting the size of the
# raw file.
# ASCII mangling is a horrible feature of the protocol.
{% if ascii_upload_enable is defined and ascii_upload_enable is not none and (ascii_upload_enable is number or ascii_upload_enable is boolean or ascii_upload_enable | length > 0) %}ascii_upload_enable={{ ascii_upload_enable }}
{% else %}#ascii_upload_enable=YES
{% endif %}{% if ascii_download_enable is defined and ascii_download_enable is not none and (ascii_download_enable is number or ascii_download_enable is boolean or ascii_download_enable | length > 0) %}ascii_download_enable={{ ascii_download_enable }}
{% else %}#ascii_download_enable=YES
{% endif %}#
# You may fully customise the login banner string:
{% if ftpd_banner is defined and ftpd_banner is not none and (ftpd_banner is number or ftpd_banner is boolean or ftpd_banner | length > 0) %}ftpd_banner={{ ftpd_banner }}
{% else %}#ftpd_banner=Welcome to blah FTP service.
{% endif %}#
# You may specify a file of disallowed anonymous e-mail addresses. Apparently
# useful for combatting certain DoS attacks.
{% if deny_email_enable is defined and deny_email_enable is not none and (deny_email_enable is number or deny_email_enable is boolean or deny_email_enable | length > 0) %}deny_email_enable={{ deny_email_enable }}
{% else %}#deny_email_enable=YES
{% endif %}# (default follows)
{% if banned_email_file is defined and banned_email_file is not none and (banned_email_file is number or banned_email_file is boolean or banned_email_file | length > 0) %}banned_email_file={{ banned_email_file }}
{% else %}#banned_email_file=/etc/vsftpd/banned_emails
{% endif %}#
# You may specify an explicit list of local users to chroot() to their home
# directory. If chroot_local_user is YES, then this list becomes a list of
# users to NOT chroot().
# (Warning! chroot'ing can be very dangerous. If using chroot, make sure that
# the user does not have write access to the top level directory within the
# chroot)
{% if chroot_local_user is defined and chroot_local_user is not none and (chroot_local_user is number or chroot_local_user is boolean or chroot_local_user | length > 0) %}chroot_local_user={{ chroot_local_user }}
{% else %}#chroot_local_user=YES
{% endif %}{% if chroot_list_enable is defined and chroot_list_enable is not none and (chroot_list_enable is number or chroot_list_enable is boolean or chroot_list_enable | length > 0) %}chroot_list_enable={{ chroot_list_enable }}
{% else %}#chroot_list_enable=YES
{% endif %}# (default follows)
{% if chroot_list_file is defined and chroot_list_file is not none and (chroot_list_file is number or chroot_list_file is boolean or chroot_list_file | length > 0) %}chroot_list_file={{ chroot_list_file }}
{% else %}#chroot_list_file=/etc/vsftpd/chroot_list
{% endif %}#
# You may activate the "-R" option to the builtin ls. This is disabled by
# default to avoid remote users being able to cause excessive I/O on large
# sites. However, some broken FTP clients such as "ncftp" and "mirror" assume
# the presence of the "-R" option, so there is a strong case for enabling it.
{% if ls_recurse_enable is defined and ls_recurse_enable is not none and (ls_recurse_enable is number or ls_recurse_enable is boolean or ls_recurse_enable | length > 0) %}ls_recurse_enable={{ ls_recurse_enable }}
{% else %}#ls_recurse_enable=YES
{% endif %}#
# When "listen" directive is enabled, vsftpd runs in standalone mode and
# listens on IPv4 sockets. This directive cannot be used in conjunction
# with the listen_ipv6 directive.
listen={{ listen | default('NO') }}
#
# This directive enables listening on IPv6 sockets. By default, listening
# on the IPv6 "any" address (::) will accept connections from both IPv6
# and IPv4 clients. It is not necessary to listen on *both* IPv4 and IPv6
# sockets. If you want that (perhaps because you want to listen on specific
# addresses) then you must run two copies of vsftpd with two configuration
# files.
# Make sure, that one of the listen options is commented !!
listen_ipv6={{ listen_ipv6 | default('YES') }}

pam_service_name={{ pam_service_name | default('vsftpd') }}
userlist_enable={{ userlist_enable | default('YES') }}
