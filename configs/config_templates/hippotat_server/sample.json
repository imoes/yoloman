{
  "base_url": "https://hippo.example.org/",
  "listen": "0.0.0.0",
  "port": 443,
  "max_connections": 50,
  "max_response_size": 32768,
  "ssl_enabled": true,
  "ssl_cert": "/etc/hippotat/ssl/hippo.crt",
  "ssl_key": "/etc/hippotat/ssl/hippo.key",
  "client_subnets": [
    "192.168.10.0/24",
    "192.168.20.0/24"
  ],
  "ip_pool": "10.255.0.0/24",
  "dns_servers": [
    "1.1.1.1",
    "9.9.9.9"
  ],
  "syslog_enabled": true,
  "log_level": "info",
  "log_file": "/var/log/hippotat/server.log",
  "request_timeout": 20,
  "workers": 4,
  "state_file": "/var/lib/hippotat/state.json",
  "debug_verbose": false,
  "mtu": 1400,
  "client_config_template": "/etc/hippotat/client.conf.j2"
}
