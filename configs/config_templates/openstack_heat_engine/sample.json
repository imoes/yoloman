{
  "debug": false,
  "log_level": "INFO",
  "log_file": "/var/log/heat/heat-engine.log",
  "rootwrap_config": "/etc/heat/rootwrap.conf",
  "workers": 2,
  "transport_url": "rabbit://openstack:secretrabbit@controller:5672/",
  "connection": "mysql+pymysql://heat:secretdb@controller/heat",
  "auth_uri": "http://controller:5000/v3",
  "auth_url": "http://controller:35357/v3",
  "auth_type": "password",
  "project_domain_name": "Default",
  "project_name": "service",
  "user_domain_name": "Default",
  "username": "heat",
  "password": "heat_secret_password",
  "trusts_delegated": false,
  "stack_user_domain_name": "heat_stack_domain",
  "stack_user_domain_id": "",
  "heat_api_uri": "http://controller:8004/v1/%(project_id)s",
  "ssl_ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "ssl_cert_file": "",
  "ssl_key_file": "",
  "verify_ssl_for_instances": true,
  "rpc_response_timeout": 60,
  "stack_operation_timeout": 7200,
  "enable_stack_adopt": false,
  "enable_stack_rollback": true,
  "enable_stack_abandon": false,
  "max_resources_per_stack": 500,
  "max_nested_stack_depth": 3,
  "region_name": "RegionOne",
  "convergence_engine": true,
  "db_idle_timeout": 3600,
  "db_min_pool_size": 2,
  "db_max_overflow": 10,
  "notifications_driver": "messagingv2",
  "notifications_storage_enabled": false,
  "trustee_client": "heat",
  "clients_timeout": 60,
  "skip_ssl_verify_endpoints": []
}
