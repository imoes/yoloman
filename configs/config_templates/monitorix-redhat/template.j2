# SYSTEM graph
# -----------------------------------------------------------------------------
<system>
	<alerts>
		loadavg_enabled = {{ system_alerts_loadavg_enabled }}
		loadavg_timeintvl = {{ system_alerts_loadavg_timeintvl }}
		loadavg_threshold = {{ system_alerts_loadavg_threshold }}
		loadavg_script = {{ system_alerts_loadavg_script }}
	</alerts>
	rigid = {{ system_rigid }}
	limit = {{ system_limit }}
</system>


# KERN graph
# -----------------------------------------------------------------------------
<kern>
	graph_mode = {{ kern_graph_mode }}
	<list>
		user	= {{ kern_list_user }}
		nice	= {{ kern_list_nice }}
		sys	= {{ kern_list_sys }}
		iow	= {{ kern_list_iow }}
		irq	= {{ kern_list_irq }}
		sirq	= {{ kern_list_sirq }}
		steal	= {{ kern_list_steal }}
		guest	= {{ kern_list_guest }}
	</list>
	rigid = {{ kern_rigid }}
	limit = {{ kern_limit }}
</kern>


# PROC graph
# -----------------------------------------------------------------------------
<proc>
	max = {{ proc_max }}
	graphs_per_row = {{ proc_graphs_per_row }}
	size = {{ proc_size }}
	data = {{ proc_data }}
	rigid = {{ proc_rigid }}
	limit = {{ proc_limit }}
</proc>

# AMD power consumption graph
# -----------------------------------------------------------------------------
<amdenergy>
	<list>
		0 = {{ amdenergy_list_0 }}
	</list>
	<map>
		{{ amdenergy_map }}
	</map>
	<number_of_cores>
		{{ amdenergy_number_of_cores }}
	</number_of_cores>
