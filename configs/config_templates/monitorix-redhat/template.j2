# Monitorix - configuration file
#
# See monitorix.conf(5) manpage for a detailed description of each option.
#

title = {{ title }}
hostname = {{ hostname }}
theme_color = {{ theme_color }}
refresh_rate = {{ refresh_rate }}
iface_mode = {{ iface_mode }}
enable_zoom = {{ enable_zoom }}
netstats_in_bps = {{ netstats_in_bps }}
netstats_mode = {{ netstats_mode }}
disable_javascript_void = {{ disable_javascript_void }}
temperature_scale = {{ temperature_scale }}
show_gaps = {{ show_gaps }}
global_zoom = {{ global_zoom }}
max_historic_years = {{ max_historic_years }}
accept_selfsigned_certs = {{ accept_selfsigned_certs }}
image_format = {{ image_format }}
enable_parallelizing = {{ enable_parallelizing }}
enable_rrd_lock = {{ enable_rrd_lock }}
include_dir = {{ include_dir }}

base_dir = {{ base_dir }}
base_lib = {{ base_lib }}
base_url = {{ base_url }}
base_cgi = {{ base_cgi }}

<httpd_builtin>
	enabled = {{ builtin_enabled }}
	host = {{ builtin_host }}
	port = {{ builtin_port }}
	user = {{ builtin_user }}
	group = {{ builtin_group }}
	log_file = {{ builtin_log_file }}
	hosts_deny = {{ builtin_hosts_deny }}
	hosts_allow = {{ builtin_hosts_allow }}
	autocheck_responsiveness = {{ builtin_autocheck_responsiveness }}
	<auth>
		enabled = {{ auth_enabled }}
		hosts_deny = {{ auth_hosts_deny }}
		msg = {{ auth_msg }}
		htpasswd = {{ auth_htpasswd }}
	</auth>
</httpd_builtin>


# Log files pathnames
# -----------------------------------------------------------------------------
log_file	= {{ log_file }}
mail_log	= {{ mail_log }}
milter_gl	= {{ milter_gl }}
ftp_log		= {{ ftp_log }} # Check monitorix.conf(5) manpage how to edit your ProFTPD server.
fail2ban_log	= {{ fail2ban_log }}
spamassassin_log	= {{ spamassassin_log }}
clamav_log	= {{ clamav_log }}
squid_log	= {{ squid_log }}

<piwik_tracking>
	enabled = {{ piwik_enabled }}
	url = {{ piwik_url }}
	sid = {{ piwik_sid }}
	img = {{ piwik_img }}
</piwik_tracking>


# Graphs (de)activation
# -----------------------------------------------------------------------------
