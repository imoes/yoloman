	</desc>
	rigid = {{ amdenergy_rigid }}
	limit = {{ amdenergy_limit }}
	use_nan_for_missing_data = {{ amdenergy_use_nan_for_missing_data }}
	gap_on_all_nan = {{ amdenergy_gap_on_all_nan }}
</amdenergy>


# INTELRAPL graph
# -----------------------------------------------------------------------------
