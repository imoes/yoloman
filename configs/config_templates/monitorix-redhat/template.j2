	gensens		= {{ graph_enable_gensens }}
	ipmi		= {{ graph_enable_ipmi }}
	ambsens		= {{ graph_enable_ambsens }}
	amdgpu		= {{ graph_enable_amdgpu }}
	nvidiagpu	= {{ graph_enable_nvidiagpu }}
	nvidia		= {{ graph_enable_nvidia }}
	disk		= {{ graph_enable_disk }}
	nvme		= {{ graph_enable_nvme }}
	fs		= {{ graph_enable_fs }}
	zfs		= {{ graph_enable_zfs }}
	ru		= {{ graph_enable_du }}
	net		= {{ graph_enable_net }}
	netstat		= {{ graph_enable_netstat }}
	tinyproxy	= {{ graph_enable_tinyproxy }}
	tc		= {{ graph_enable_tc }}
	libvirt		= {{ graph_enable_libvirt }}
	process		= {{ graph_enable_process }}
	serv		= {{ graph_enable_serv }}
	mail		= {{ graph_enable_mail }}
	port		= {{ graph_enable_port }}
	user		= {{ graph_enable_user }}
	ftp		= {{ graph_enable_ftp }}
