# tnftp configuration file
# Generated by Ansible Jinja2 template.
# This file configures the behavior of the tnftp (Taylor's Net Free Passive FTP) client.
# Directives correspond to command-line options but are persisted here for automation.

# ---------------------------------------------------------------------------
# General Settings
# ---------------------------------------------------------------------------

# ftp_mode: Default operation mode: active, passive, auto, or gate.
# Default: auto
set ftpmode {{ ftp_mode | default('auto') }}

# anon_password: Password sent for anonymous FTP transfers.
# Default: ${USER}@
# Note: The literal '${USER}' syntax is preserved as-is for the shell/tnftp
# to resolve at runtime.
set anonpass {{ anon_password | default('${USER}@') }}

# prompt: Command line prompt displayed in interactive mode.
# Default: 'ftp> '
set prompt {{ prompt | default('ftp> ') }}

# rprompt: Right-side prompt displayed in interactive mode.
# Default: ''
set rprompt {{ rprompt | default('') }}

# verbose: Enable verbose mode to show server responses and stats.
# Default: true
set verbose {{ verbose | default(true) | lower }}

# sslnoverify: Disable SSL certificate verification for HTTPS/FTPES.
# Default: false
set sslnoverify {{ sslnoverify | default(false) | lower }}

# auto_login: Attempt to automatically log in using .netrc or credentials.
# Default: true
set auto-login {{ auto_login | default(true) | lower }}

# prompt_off: Disable interactive prompting during multiple file transfers.
# Default: false
set prompt-off {{ prompt_off | default(false) | lower }}

# hash: Print hash signs (#) for each block of data transferred.
# Default: false
set hash {{ hash | default(false) | lower }}

# ---------------------------------------------------------------------------
# Performance & Buffer Settings
# ---------------------------------------------------------------------------

# max_rate: Maximum transfer rate in bytes per second. 0 disables throttling.
# Default: 0
rate {{ max_rate | default(0) }}

# xferbuf_size: Size of the socket send and receive buffers for transfers in bytes.
# Default: 4096
xferbuf {{ xferbuf_size | default(4096) }}

# ---------------------------------------------------------------------------
# Initial Commands
# ---------------------------------------------------------------------------

# initial_commands: List of tnftp commands to execute on startup or connection initialization.
# Default: []
{% for cmd in initial_commands | default([]) %}
{{ cmd }}
{% endfor %}