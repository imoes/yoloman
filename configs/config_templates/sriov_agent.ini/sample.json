{
  "max_physical_networks": 16,
  "physnets": [
    {
      "name": "physnet1",
      "interface": "enp1s0f0"
    },
    {
      "name": "physnet2",
      "interface": "enp1s0f1"
    }
  ],
  "pci_passthrough_whitelist": [
    "0000:03:00.0",
    "0000:03:00.1",
    "0000:04:00.0"
  ],
  "debug": false,
  "log_dir": "/var/log/neutron",
  "log_file": "sriov_agent.log",
  "interface_driver": "neutron.agent.linux.interface.BridgeInterfaceDriver",
  "device_driver": "vfio-pci",
  "polling_interval": 2,
  "use_netlink": true,
  "workers": 2
}
