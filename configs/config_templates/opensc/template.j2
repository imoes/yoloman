# OpenSC (Open Smart Card) configuration file.
# This template configures the OpenSC application's debug output behavior.

[app]
# Default configuration block for OpenSC settings.

# Debug level for OpenSC application. Controls the verbosity of log messages (0-9, default is 3).
# 3 = informational/debugging details.
debug = {{ debug | default('3') }}

# File path for OpenSC debug output. The location of the file where debug logs are written.
debug_file = {{ debug_file | default('opensc-debug.txt') }}