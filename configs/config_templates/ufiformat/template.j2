# /etc/default/ufiformat
#
# This file contains configuration parameters for the ufiformat utility.
# It is sourced as an environment file or used to pass arguments to wrapper scripts.
# Each variable is clearly commented with its purpose and schema description.
# Variables are safely defaulted to prevent errors if not defined in the Ansible inventory.

# Verbosity: Enable verbose output for logging/debugging
# Default: false
UFIFORMAT_VERBOSE={{ (ufiformat | default({})).verbose | default(false) }}

# Inquire mode: Set true to just show device info instead of formatting
# Default: false
UFIFORMAT_INQUIRE={{ (ufiformat | default({})).inquire | default(false) }}

# Force mode: Set true to bypass safety checks
# Default: false
UFIFORMAT_FORCE={{ (ufiformat | default({})).force | default(false) }}

# Quiet mode: Suppress minor diagnostics (overrides verbose if true)
# Default: false
UFIFORMAT_QUIET={{ (ufiformat | default({})).quiet | default(false) }}

# Format size: Capacity in KB (e.g., 1440, 1232, 720). Omit for default media size
# Default: '' (empty string)
UFIFORMAT_FORMAT_SIZE={{ (ufiformat | default({})).format_size | default('') }}

# Verify post-format: Set true to verify the medium after formatting
# Default: false
UFIFORMAT_VERIFY={{ (ufiformat | default({})).verify | default(false) }}

# Device path: Target USB floppy device (e.g., /dev/sda)
# Default: /dev/sda
UFIFORMAT_DEVICE={{ (ufiformat | default({})).device | default('/dev/sda') }}