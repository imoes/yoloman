{
  "theme_bg": "#1a1a1a",
  "theme_fg": "#e0e0e0",
  "theme_font": "Liberation Sans",
  "theme_font_size": 20,
  "enable_transitions": true,
  "transition_duration": 0.5,
  "input_file": "my_slides.txt",
  "verbose_mode": true,
  "show_slide_numbers": false,
  "aspect_ratio": 16,
  "image_dir": "./assets",
  "remote_port": 8080,
  "enable_remote": true,
  "custom_fonts_list": [
    "/usr/share/fonts/custom/myfont.ttf"
  ],
  "supported_image_extensions": [
    ".png",
    ".jpg",
    ".svg"
  ]
}
