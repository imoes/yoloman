# UPnP/IGD and PCP/NAT-PMP daemon configuration
# Interface for external (WAN) traffic
external_iface={{ external_iface }}

# Interface for internal (LAN) traffic
# May be specified multiple times for multi-homed LANs
{% for iface in internal_ifaces %}internal_iface={{ iface.name }}{% if iface.cidr %} {{ iface.cidr }}{% endif %}
{% endfor %}

# Network address and mask for internal network(s)
# Deprecated in newer versions — prefer internal_iface with CIDR above
{% if legacy_networks %}{% for net in legacy_networks %}network={{ net.address }}/{{ net.prefix }}
{% endfor %}{% endif %}

# Enable UPnP IGD functionality
enable_upnp={{ enable_upnp | lower }}

# Enable PCP (Port Control Protocol) support
enable_pcp={{ enable_pcp | lower }}

# Enable NAT-PMP support (legacy, less flexible than PCP)
enable_natpmp={{ enable_natpmp | lower }}

# Logical interface name for external (WAN) device
# Used by iptables backend to create rules
# Must match actual interface name (e.g., eth0, ppp0)
ifname={{ ifname }}

# Enable secure mode — restricts port forwarding to internal hosts only
secure_mode={{ secure_mode | lower }}

# Enable system update notifications (UPnP SSDP NOTIFY)
system_update={{ system_update | lower }}

# UPnP presentation URL (e.g., for web UI of gateway)
# Set to empty string to disable
presentation_url={{ presentation_url }}

# Friendly name advertised via SSDP
# May be overridden per-IGD by UPnP client
friendly_name={{ friendly_name }}

# UUID of the device (must be unique, typically generated from MAC or stable ID)
# If empty, auto-generated from system ID
uuid={{ uuid }}

# Serial number advertised in SSDP & XML
serial={{ serial }}

# Model name and number
model_name={{ model_name }}
model_number={{ model_number }}

# Lease file for dynamic mappings (for persistence across restarts)
# Set to empty to disable
lease_file={{ lease_file }}

# UPnP port range — limits allowed forwarded ports
# Use 0 for no restriction
upnp_port_min={{ upnp_port_min }}
upnp_port_max={{ upnp_port_max }}

# Enable logging of UPnP/PCP/NAT-PMP operations
# Level 1=errors, 2=warnings, 3=info, 4=debug
logfile={{ logfile }}
log_verbosity={{ log_verbosity }}

# Enable logging to syslog (true/false)
log_syslog={{ log_syslog | lower }}

# Enable NAT-PMP external port range (if enabled)
natpmp_port_min={{ natpmp_port_min }}
natpmp_port_max={{ natpmp_port_max }}

# Allow control of specific port mappings (permissive by default)
# Set to empty to allow all
# Format: port:protocol:internal_ip[:internal_port] (wildcard * allowed)
allow_port={{ allow_ports | join('\nallow_port=') }}
{% if allow_ports %}
{% endif %}

# Deny port mappings (deny list takes precedence over allow list)
deny_port={{ deny_ports | join('\ndeny_port=') }}
{% if deny_ports %}
{% endif %}

# Enable incremental lease update (avoid full write on each change)
incremental_lease_update={{ incremental_lease_update | lower }}

# Enable IPv6 support (if compiled with IPv6 and kernel supports it)
enable_ipv6={{ enable_ipv6 | lower }}

# SSDP broadcast interval in seconds
ssdp_broadcast_interval={{ ssdp_broadcast_interval }}

# SSDP alive timeout (seconds) — how long responses are considered valid
ssdp_alive_time={{ ssdp_alive_time }}

# Minimim TTL for SSDP messages (default 1800 seconds)
ssdp_ttl={{ ssdp_ttl }}

# UPnP device type for IGDv1 (default: urn:schemas-upnp-org:device:InternetGatewayDevice:1)
igd_device_type={{ igd_device_type }}

# Enable or disable content filtering (not implemented in iptables backend, kept for compatibility)
enable_content_filtering={{ enable_content_filtering | lower }}

# Optional: custom startup/stop hooks (script paths)
# These are not part of standard miniupnpd.conf but sometimes used via wrapper
# kept only for completeness in templating
{% if start_script %}start_script={{ start_script }}
{% endif %}{% if stop_script %}stop_script={{ stop_script }}
{% endif %}
