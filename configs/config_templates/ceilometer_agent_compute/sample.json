{
  "log_dir": "/var/log/ceilometer",
  "log_file": "/var/log/ceilometer/ceilometer-agent-compute.log",
  "log_level": "INFO",
  "pollsters": [
    "compute.instance.disk",
    "compute.instance.cpu",
    "compute.instance.memory"
  ],
  "polling_interval": 600,
  "polling_interval_resource": 86400,
  "compute_driver": "libvirt.LibvirtDriver",
  "instance_discovery_method": "libvirt_events",
  "libvirt": {
    "virt_type": "qemu",
    "user": "root"
  },
  "libvirt_connection_username": "",
  "libvirt_connection_password": "",
  "inspector_uri": "qemu://localhost/system",
  "inspector_type": "libvirt",
  "notification_topics": [
    "notifications",
    "compute"
  ],
  "rabbit_host": "192.168.1.10",
  "rabbit_port": 5672,
  "rabbit_user": "ceilometer",
  "rabbit_password": "ceilometer_pass",
  "rabbit_virtual_host": "/",
  "auth_strategy": "keystone",
  "endpoint_type": "internalURL",
  "auth_ssl_verify": true,
  "auth_ssl_ca_cert": "/etc/ssl/certs/ca-certificates.crt",
  "service_credentials": {
    "os_username": "ceilometer",
    "os_password": "ceilometer_pass",
    "os_project_name": "service",
    "os_user_domain_name": "Default",
    "os_project_domain_name": "Default",
    "os_auth_url": "http://192.168.1.5:5000/v3"
  },
  "transport_url": "",
  "pipeline_cfg_file": "/etc/ceilometer/pipeline.yaml",
  "transform_cfg_file": "/etc/ceilometer/transform.yaml",
  "credential_refresh_interval": 300,
  "use_local": false,
  "cpu_polling_enabled": true,
  "network_polling_enabled": true,
  "disk_polling_enabled": true,
  "memory_polling_enabled": true,
  "instance_disk_polling_enabled": true,
  "instance_network_polling_enabled": true,
  "polling_workers": 4,
  "polling_timeout": 30,
  "polling_retries": 3,
  "polling_retry_delay": 2,
  "instance_discovery_enabled": true,
  "instance_discovery_interval": 600,
  "libvirt_event_callback_timeout": 120,
  "libvirt_event_callback_retries": 5,
  "libvirt_event_callback_retry_delay": 1,
  "libvirt_event_callback_buffer_size": 1000,
  "libvirt_event_callback_max_events": 100,
  "additional_settings": {
    "keystone_authtoken": {
      "auth_url": "http://192.168.1.5:5000/v3",
      "project_domain_name": "Default",
      "user_domain_name": "Default",
      "project_name": "service",
      "username": "ceilometer",
      "password": "ceilometer_pass"
    }
  }
}
