# Ceilometer Compute Agent Configuration
# Generated by Ansible Jinja2 Template
# This file configures the ceilometer-compute-agent, responsible for collecting
# telemetry metrics (CPU, memory, disk, network) from the compute hypervisor
# and sending them to the Ceilometer collector via the message queue.

[DEFAULT]

# Directory where log files are stored.
# Default: /var/log/ceilometer
log_dir = {{ log_dir | default('/var/log/ceilometer') }}

# Path to the compute agent log file.
# Default: /var/log/ceilometer/ceilometer-agent-compute.log
log_file = {{ log_file | default('/var/log/ceilometer/ceilometer-agent-compute.log') }}

# Verbosity level for logging (e.g., DEBUG, INFO, WARNING, ERROR).
# Default: INFO
log_level = {{ log_level | default('INFO') }}

# List of pollster names to enable for metering. Each pollster collects a specific metric.
# Default: ['compute.instance.disk', 'compute.instance.cpu', 'compute.instance.memory', 'compute.instance.network.incoming.bytes', 'compute.instance.network.outgoing.bytes']
pollsters = {{ pollsters | default(['compute.instance.disk', 'compute.instance.cpu', 'compute.instance.memory', 'compute.instance.network.incoming.bytes', 'compute.instance.network.outgoing.bytes']) | join(', ') }}

# Interval (in seconds) between polling cycles for metrics.
# Default: 600
polling_interval = {{ polling_interval | default(600) }}

# Hypervisor driver to use (e.g., libvirt.LibvirtDriver, vmwareapi.VMwareVCDriver).
# Default: libvirt.LibvirtDriver
compute_driver = {{ compute_driver | default('libvirt.LibvirtDriver') }}

# URI for connecting to the hypervisor inspector (e.g., qemu://localhost/system).
# Default: ''
inspector_uri = {{ inspector_uri | default('') }}

# Inspector type: libvirt, nova, xenapi, or vmwareapi.
# Default: libvirt
inspector_type = {{ inspector_type | default('libvirt') }}

# List of topics to subscribe for notifications from other OpenStack services.
# Default: ['notifications', 'compute', 'image', 'volume', 'network']
notification_topics = {{ notification_topics | default(['notifications', 'compute', 'image', 'volume', 'network']) | join(', ') }}

# Message bus connection settings (RabbitMQ).
# If transport_url is set, these individual fields may be overridden by higher-priority
# configuration mechanisms or explicitly ignored in favor of transport_url.

# Hostname or IP of RabbitMQ server.
# Default: localhost
rabbit_host = {{ rabbit_host | default('localhost') }}

# Port of RabbitMQ server.
# Default: 5672
rabbit_port = {{ rabbit_port | default(5672) }}

# Username to authenticate to RabbitMQ.
# Default: guest
rabbit_user = {{ rabbit_user | default('guest') }}

# Password to authenticate to RabbitMQ.
# Default: guest
rabbit_password = {{ rabbit_password | default('guest') }}

# Virtual host to use in RabbitMQ.
# Default: /
rabbit_virtual_host = {{ rabbit_virtual_host | default('/') }}

# Authentication strategy: keystone or none.
# Default: keystone
auth_strategy = {{ auth_strategy | default('keystone') }}

# Endpoint type for Nova/Keystone services: publicURL, internalURL, or adminURL.
# Default: publicURL
endpoint_type = {{ endpoint_type | default('publicURL') }}

# Whether to verify SSL certificates when connecting to Keystone.
# Default: True
auth_ssl_verify = {{ auth_ssl_verify | default(True) | lower }}

# Path to CA certificate bundle for Keystone SSL verification (optional).
# Default: ''
auth_ssl_ca_cert = {{ auth_ssl_ca_cert | default('') }}

# Keystone service credentials (e.g., os_username, os_password, os_project_name, etc.).
# These are flattened into the DEFAULT section if provided.
# Default: {}
{% set creds = service_credentials | default({}) %}
{% if creds is mapping and creds | length > 0 %}
{% for item in creds | dict2items %}{{ item.key }} = {{ item.value | default('') }}
{% endfor %}
{% endif %}

# Message bus transport URL (e.g., 'rabbit://user:pass@host:5672/'). Overrides rabbit_* settings.
# Default: ''
transport_url = {{ transport_url | default('') }}

# Path to pipeline configuration file defining meters and sources.
# Default: /etc/ceilometer/pipeline.yaml
pipeline_cfg_file = {{ pipeline_cfg_file | default('/etc/ceilometer/pipeline.yaml') }}

# Path to sample transformation configuration file (optional).
# Default: /etc/ceilometer/transform.yaml
transform_cfg_file = {{ transform_cfg_file | default('/etc/ceilometer/transform.yaml') }}

# Interval (in seconds) to refresh authentication credentials.
# Default: 300
credential_refresh_interval = {{ credential_refresh_interval | default(300) }}

# Additional unstructured configuration sections (e.g., 'keystone_authtoken').
# Default: {}
{% set extra = additional_settings | default({}) %}
{% if extra is mapping and extra | length > 0 %}
{% for section in extra | dict2items %}
[{{ section.key }}]
{% for item in section.value | default({}) | dict2items %}{{ item.key }} = {{ item.value | default('') }}
{% endfor %}
{% endfor %}
{% endif %}