# ==============================================================================
# BIRD Configuration Template (bird-redhat)
# ==============================================================================
# This template generates a self-documenting BIRD configuration file.
# BIRD is a dynamic IP routing daemon designed for efficient routing.
#
# Global settings are defined at the top, followed by protocol instances.
# All variables use the 'default()' filter to ensure the configuration
# renders safely even if variables are undefined in the Ansible playbook.
# ==============================================================================

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Configure logging to syslog. The 'all' keyword logs all message classes.
# To log to a file instead, uncomment the line below and adjust the path/levels.
log syslog all;
# log "/var/log/bird.log" { debug, trace, info, remote, warning, error, auth, fatal, bug };

# ------------------------------------------------------------------------------
# Router ID
# ------------------------------------------------------------------------------
# The unique router ID for BIRD, typically an IPv4 address.
# It is recommended to configure this explicitly to ensure stability.
{% if BIRD_ROUTER_ID is defined and BIRD_ROUTER_ID is not none and (BIRD_ROUTER_ID is number or BIRD_ROUTER_ID is boolean or BIRD_ROUTER_ID | length > 0) %}router id {{ BIRD_ROUTER_ID | default('198.51.100.1') }};{% else %}# router id 198.51.100.1;{% endif %}

# ------------------------------------------------------------------------------
# Global Debugging (Optional)
# ------------------------------------------------------------------------------
# Turn on global debugging of all protocols. Uncomment to enable.
# debug protocols all;
# debug protocols { events, states };

# ------------------------------------------------------------------------------
# Internal Watchdog (Optional)
# ------------------------------------------------------------------------------
# Turn on internal watchdog to detect daemon issues.
# watchdog warning 5 s;
# watchdog timeout 30 s;

# ------------------------------------------------------------------------------
# User-Defined Constants (Optional)
# ------------------------------------------------------------------------------
# You can define your own constants for use in filters or policies.
# define my_asn = 65000;
# define my_addr = {{ BIRD_ROUTER_ID | default('198.51.100.1') }};

# ------------------------------------------------------------------------------
# Routing Tables
# ------------------------------------------------------------------------------
# Tables master4 and master6 are defined by default in BIRD.
# Define more tables below if needed for policy routing or MRIB.
# ipv4 table mrib4;
# ipv6 table mrib6;

# ==============================================================================
# Protocol Instances
# ==============================================================================

# ------------------------------------------------------------------------------
# Device Protocol
# ------------------------------------------------------------------------------
# The Device protocol is not a real routing protocol.
# It serves as a module for getting information about network interfaces from the kernel.
# It is necessary in almost any configuration.
protocol device {
}

# ------------------------------------------------------------------------------
# Direct Protocol
# ------------------------------------------------------------------------------
# The direct protocol automatically generates direct routes to all network interfaces.
# It is disabled by default in this template to avoid unwanted route injection.
protocol direct {
	disabled;		# Disable by default
	ipv4;			# Connect to default IPv4 table
	ipv6;			# ... and to default IPv6 table
}

# ------------------------------------------------------------------------------
# Kernel Protocol (IPv4)
# ------------------------------------------------------------------------------
# The Kernel protocol synchronizes BIRD routing tables with the OS kernel.
# This instance handles IPv4.
protocol kernel {
    ipv4 {
        # Connect protocol to IPv4 table by channel
#	      table master4;	# Default IPv4 table is master4
#	      import all;	# Import to table, default is import all
	      export all;	# Export to protocol. default is export none
    };
#	learn;			# Learn alien routes from the kernel
#	kernel table 10;	# Kernel table to synchronize with (default: main)
}

# ------------------------------------------------------------------------------
# Kernel Protocol (IPv6)
# ------------------------------------------------------------------------------
# Another instance for IPv6, skipping default options.
protocol kernel {
    ipv6 { export all; };
}

# ------------------------------------------------------------------------------
# Static Protocol
# ------------------------------------------------------------------------------
# Static routes protocol. Allows manual definition of static routes.
# There can be multiple instances for different address families.
protocol static {
	ipv4;			# Again, IPv4 channel with default options

    # Example static route: Default route via the configured gateway.
    # Uncomment the following line to activate the default route.
    route 0.0.0.0/0 via {{ BIRD_STATIC_GATEWAY | default('198.51.100.10') }};

    # Other static route examples (commented out):
#	route 192.0.2.0/24 blackhole;
#	route 10.0.0.0/8 unreachable;
#	route 10.2.0.0/24 via "eth0";
#	route 10.1.1.0/24 via 198.51.100.3 { rip_metric = 3; };
#	route 10.1.2.0/24 via 198.51.100.3 { ospf_metric1 = 100; };
#	route 10.1.3.0/24 via 198.51.100.4 { ospf_metric2 = 100; };
}

