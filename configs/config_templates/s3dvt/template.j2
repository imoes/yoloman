# s3dvt configuration
# This file configures the s3dvt tool to connect to a specific S3D environment.
#
# The tool normally detects the environment automatically. To override this and
# connect to a specific S3D environment, provide the full URL below.
# If this field is left empty, the tool uses its default environment logic.

# --s3d-url url
# Description: URL of the S3D environment to connect to. If empty, the default
# environment logic is used.
S3D_URL={{ s3d_url | default('') }}