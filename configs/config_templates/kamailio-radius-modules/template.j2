#
# $Id$
#
# Kamailio RADIUS Modules Attribute Definition File
#
# This file defines custom and mapped RADIUS attributes
# for Kamailio's rdb_radius / rdb_radiusauth modules.
# It is intended to be used as the attribute dictionary
# for radiusclient-ng or freeradius-client libraries.
#
# Standard (IANA registered) attributes are defined in
# the default dictionary of the radiusclient-ng library;
# this file only adds the proprietary/SIP-specific extensions.
#

#### Attributes ###

# Attribute ID for Sip-Uri-User (Proprietary, used by auth_radius module)
ATTRIBUTE Sip-Uri-User         {{ sip_uri_user_attr_id | default(208) }}  string     # Proprietary, auth_radius

# Attribute ID for Sip-Group (Proprietary, used by group_radius module)
ATTRIBUTE Sip-Group            {{ sip_group_attr_id | default(211) }}  string     # Proprietary, group_radius

# Attribute ID for Sip-Rpid (Proprietary, used by auth_radius module)
ATTRIBUTE Sip-Rpid             {{ sip_rpid_attr_id | default(213) }}  string     # Proprietary, auth_radius

# Attribute ID for SIP-AVP (Proprietary, used by avp_radius module)
ATTRIBUTE SIP-AVP              {{ sip_avp_attr_id | default(225) }}  string     # Proprietary, avp_radius

### Acct-Status-Type Values ###
# VALUE Acct-Status-Type   Failed           15   # RFC2866, acc

### Service-Type Values ###
# Value for Group-Check Service Type (Proprietary, used by group_radius)
VALUE Service-Type       {{ service_type_group_check_name | default('Group-Check') }}      {{ service_type_group_check_id | default(12) }}   # Proprietary, group_radius
## VALUE Service-Type       Sip-Session      15   # Schulzrinne, acc, auth_radius

# Value for SIP-Caller-AVPs Service Type (Proprietary, used by avp_radius)
VALUE Service-Type       {{ service_type_sip_caller_avps_name | default('SIP-Caller-AVPs') }}  {{ service_type_sip_caller_avps_id | default(30) }}   # Proprietary, avp_radius

# Value for SIP-Callee-AVPs Service Type (Proprietary, used by avp_radius)
VALUE Service-Type       {{ service_type_sip_callee_avps_name | default('SIP-Callee-AVPs') }}  {{ service_type_sip_callee_avps_id | default(31) }}   # Proprietary, avp_radius

### Sip-Method Values ###
# Maps SIP methods to numeric values for RADIUS attribute encoding

# Value for Undefined SIP Method
VALUE Sip-Method         {{ sip_method_undefined_name | default('Undefined') }}      {{ sip_method_undefined_id | default(0) }}

# Value for INVITE SIP Method
VALUE Sip-Method         {{ sip_method_invite_name | default('Invite') }}         {{ sip_method_invite_id | default(1) }}

# Value for CANCEL SIP Method
VALUE Sip-Method         {{ sip_method_cancel_name | default('Cancel') }}         {{ sip_method_cancel_id | default(2) }}

# Value for ACK SIP Method
VALUE Sip-Method         {{ sip_method_ack_name | default('Ack') }}            {{ sip_method_ack_id | default(4) }}

# Value for BYE SIP Method
VALUE Sip-Method         {{ sip_method_bye_name | default('Bye') }}            {{ sip_method_bye_id | default(8) }}

# Value for INFO SIP Method
VALUE Sip-Method         {{ sip_method_info_name | default('Info') }}           {{ sip_method_info_id | default(16) }}

# Value for OPTIONS SIP Method
VALUE Sip-Method         {{ sip_method_options_name | default('Options') }}        {{ sip_method_options_id | default(32) }}

# Value for UPDATE SIP Method
VALUE Sip-Method         {{ sip_method_update_name | default('Update') }}         {{ sip_method_update_id | default(64) }}

# Value for REGISTER SIP Method
VALUE Sip-Method         {{ sip_method_register_name | default('Register') }}       {{ sip_method_register_id | default(128) }}

# Value for MESSAGE SIP Method
VALUE Sip-Method         {{ sip_method_message_name | default('Message') }}        {{ sip_method_message_id | default(256) }}

# Value for SUBSCRIBE SIP Method
VALUE Sip-Method         {{ sip_method_subscribe_name | default('Subscribe') }}      {{ sip_method_subscribe_id | default(512) }}

# Value for NOTIFY SIP Method
VALUE Sip-Method         {{ sip_method_notify_name | default('Notify') }}         {{ sip_method_notify_id | default(1024) }}

# Value for PRACK SIP Method
VALUE Sip-Method         {{ sip_method_prack_name | default('Prack') }}          {{ sip_method_prack_id | default(2048) }}

# Value for REFER SIP Method
VALUE Sip-Method         {{ sip_method_refer_name | default('Refer') }}          {{ sip_method_refer_id | default(4096) }}

# Value for Other/Unknown SIP Method
VALUE Sip-Method         {{ sip_method_other_name | default('Other') }}          {{ sip_method_other_id | default(8192) }}