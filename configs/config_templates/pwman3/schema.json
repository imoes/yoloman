{
  "database": {
    "type": "string",
    "default": "~/.pwman3/db",
    "description": "Path to the SQLite database file."
  },
  "encryption": {
    "type": "string",
    "default": "AES",
    "description": "Encryption algorithm (AES, ARC2, ARC4, Blowfish, CAST, DES, DES3, IDEA, RC5).",
    "enum": [
      "AES",
      "ARC2",
      "ARC4",
      "Blowfish",
      "CAST",
      "DES",
      "DES3",
      "IDEA",
      "RC5"
    ]
  },
  "master_password": {
    "type": "string",
    "default": "",
    "description": "The master password used to encrypt/decrypt the database."
  },
  "output_format": {
    "type": "string",
    "default": "text",
    "description": "Default output format for commands."
  },
  "auto_convert": {
    "type": "bool",
    "default": false,
    "description": "Automatically convert old database formats."
  }
}
