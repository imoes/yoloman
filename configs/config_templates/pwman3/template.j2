# pwman3 configuration file
# See pwman3(1) for details.
#
# This template is self-documenting. Every directive includes its description
# and uses a safe default to prevent render failures if the variable is undefined.

# Path to the SQLite database file storing passwords. [d]efaults to ~/.pwman3/db
database = {{ database | default('~/.pwman3/db') }}

# Encryption algorithm to use for the database content. [e]nsure this matches what is used in the DB. [e]nsure one of: AES, ARC2, ARC4, Blowfish, CAST, DES, DES3, IDEA, RC5. [a]llowed values are documented in the man page.
encryption = {{ encryption | default('AES') }}

# Master password for the database. [k]eep this secret. Note: In a real scenario, this might be handled via environment variables or secure storage, but the config file can store it. [k]ey is the master password.
password = {{ master_password | default('') }}

# Default output format for commands like 'get'. [o]utput can be json, text, etc. [d]efault is usually text or interactive.
output = {{ output_format | default('text') }}

# If set to true, auto-convert the database if it is in old format. [c]onvert on access.
# Note: Jinja renders booleans as lowercase 'true'/'false', which pwman3 expects.
convert = {{ auto_convert | default(false) | lower }}