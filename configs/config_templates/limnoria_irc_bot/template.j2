# Limnoria IRC bot main configuration file
# Generated by template — DO NOT EDIT MANUALLY without updating the template

# Server settings for connecting to an IRC network
server.host: {{ server.host }}
server.port: {{ server.port }}
{% if server.ssl %}server.ssl: true
{% else %}server.ssl: false
{% endif %}server.password: {{ server.password }}
server.nickserv_password: {{ server.nickserv_password }}

# Bot identity
bot.nick: {{ bot.nick }}
bot.user: {{ bot.user }}
bot.name: {{ bot.name }}
{% if bot.vhost %}bot.vhost: {{ bot.vhost }}
{% endif %}

# Channel configuration — auto-join on startup
{% for channel in channels %}channel: {{ channel.name }}
channel.key: {{ channel.key }}
{% endfor %}

# Administrative options
admin.enabled: {% if admin.enabled %}true{% else %}false{% endif %}
admin.users: {% for user in admin.users %}{{ user }}{% if not loop.last %}, {% endif %}{% endfor %}

# Logging
log.enabled: {% if log.enabled %}true{% else %}false{% endif %}
log.path: {{ log.path }}
log.format: {{ log.format }}

# Plugin configuration
plugin.enabled: {% for plugin in plugin.enabled %}{{ plugin }}{% if not loop.last %}, {% endif %}{% endfor %}
plugin.disabled: {% for plugin in plugin.disabled %}{{ plugin }}{% if not loop.last %}, {% endif %}{% endfor %}

# Command prefix
prefix: {{ prefix }}

# Timeout settings
timeout.connect: {{ timeout.connect }}
timeout.read: {{ timeout.read }}

# Fallback nick (if primary nick is in use)
nickFallback: {{ nick_fallback }}
