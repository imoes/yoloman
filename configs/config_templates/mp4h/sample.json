{
  "safety_level": 2,
  "include_dirs": [
    "/usr/local/lib/mp4h",
    "./macros"
  ],
  "defines": [
    "VERSION=1.3.1",
    "OUTPUT_DIR=/var/www/html"
  ],
  "caseless": 3,
  "encoding": "utf8",
  "expansion": 3114,
  "hashsize": 509,
  "nesting_limit": 250,
  "debug_flags": "",
  "error_output": "/var/log/mp4h_debug.log",
  "synclines": true,
  "fatal_warnings": false,
  "quiet": false,
  "input_files": [
    "index.html",
    "about.html",
    "contact.html"
  ]
}
