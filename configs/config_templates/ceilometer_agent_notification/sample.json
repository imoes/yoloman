{
  "log_file": "/var/log/ceilometer/agent-notification.log",
  "debug": false,
  "verbose": true,
  "workers": 2,
  "transport_url": "rabbit://ceilometer:secrete@rabbitmq.example.com:5672/",
  "sources": [
    "compute",
    "image",
    "volume",
    "network"
  ],
  "topics": [
    "notifications",
    "notifications.error",
    "notifications.warn"
  ],
  "rate_limit": 100,
  "batch_size": 50,
  "storage_url": "mongodb://ceilometer:secretpw@mongo.example.com:27017/ceilometer",
  "enable_ttl": true,
  "time_to_live": 2592000,
  "keystone_auth_url": "https://keystone.example.com:5000/v3",
  "keystone_auth_type": "password",
  "keystone_project_domain": "Default",
  "keystone_project_name": "services",
  "keystone_user_domain": "Default",
  "keystone_username": "ceilometer",
  "keystone_password": "secretpw123"
}
