{
  "bind_host": "0.0.0.0",
  "bind_port": 9419,
  "data_path": "/var/lib/mfs",
  "working_dir": "/var/lib/mfs",
  "spool_dir": "/var/lib/mfs/spool",
  "dump_interval": 3600,
  "max_entries": 500,
  "max_age": 86400,
  "debug_mode": false,
  "master_servers": [
    {
      "host": "mfsmaster1.example.com",
      "port": 9419,
      "priority": 1
    },
    {
      "host": "mfsmaster2.example.com",
      "port": 9419,
      "priority": 2
    }
  ],
  "master_timeout": 60,
  "master_use_ssl": false,
  "master_ssl_cert": "",
  "master_ssl_key": "",
  "master_ssl_ca": "",
  "pid_file": "/var/run/mfs/mfsmetalogger.pid",
  "log_level": 4,
  "log_file": "/var/log/mfs/mfsmetalogger.log"
}
