# MooseFS Metalogger configuration file
# This file is automatically generated — do not edit manually
# Listen address for incoming connections from master servers
BIND_HOST = {{ bind_host }}
# TCP port for incoming connections from master servers
BIND_PORT = {{ bind_port }}
# Path to the data directory for storing metadata changelog files
DATA_PATH = {{ data_path }}
# Path to the working (meta) directory
WORKING_DIR = {{ working_dir }}
# Path to the spool directory for metadata dumps (if used)
SPOOL_DIR = {{ spool_dir }}
# Number of seconds between metadata dumps to spool
DUMP_INTERVAL = {{ dump_interval }}
# Maximum number of changelog entries to keep before rotation
MAX_ENTRIES = {{ max_entries }}
# Maximum age (in seconds) of a changelog file before rotation
MAX_AGE = {{ max_age }}
# Whether to enable logging to stdout (true/false)
DEBUG_MODE = {{ debug_mode }}
# List of master servers to connect to for metadata replication
MASTER_SERVERS =
{% for master in master_servers %}# {{ master.host }}:{{ master.port }} (priority: {{ master.priority }})
MASTER_SERVER = {{ master.host }}:{{ master.port }}:{{ master.priority }}
{% endfor %}
# Network timeout for communication with master servers (in seconds)
MASTER_TIMEOUT = {{ master_timeout }}
# Whether to enable SSL/TLS for communication with master servers
MASTER_USE_SSL = {{ master_use_ssl }}
# Path to SSL certificate file (if SSL enabled)
MASTER_SSL_CERT = {{ master_ssl_cert }}
# Path to SSL key file (if SSL enabled)
MASTER_SSL_KEY = {{ master_ssl_key }}
# Path to CA certificate file for verifying master certs (if SSL enabled)
MASTER_SSL_CA = {{ master_ssl_ca }}
# Path to PID file
PID_FILE = {{ pid_file }}
# Log level (0=silent, 1=fatal, 2=error, 3=warn, 4=info, 5=debug)
LOG_LEVEL = {{ log_level }}
# Path to log file (empty string = no file logging)
LOG_FILE = {{ log_file }}
