# iSCSI node session parameters
session.initial_cmdsn = {{ session_initial_cmdsn }}
session.cmds_max = {{ session_cmds_max }}
session.queue_depth = {{ session_queue_depth }}

# iSCSI connection parameters
connection.max_recv_dlength = {{ connection_max_recv_dlength }}
connection.first_burst_length = {{ connection_first_burst_length }}
connection.max_burst_length = {{ connection_max_burst_length }}

# Authentication
node.session.auth.authmethod = {{ node_session_auth_authmethod }}
node.session.auth.username = {{ node_session_auth_username | default('') }}
node.session.auth.password = {{ node_session_auth_password | default('') }}
node.session.auth.username_in = {{ node_session_auth_username_in | default('') }}
node.session.auth.password_in = {{ node_session_auth_password_in | default('') }}

# Discovery parameters
discovery.sendtargets.auth.authmethod = {{ discovery_sendtargets_auth_authmethod }}
discovery.sendtargets.auth.username = {{ discovery_sendtargets_auth_username | default('') }}
discovery.sendtargets.auth.password = {{ discovery_sendtargets_auth_password | default('') }}
discovery.sendtargets.auth.username_in = {{ discovery_sendtargets_auth_username_in | default('') }}
discovery.sendtargets.auth.password_in = {{ discovery_sendtargets_auth_password_in | default('') }}

# Interface binding (if using multiple NICs)
{% for iface in interfaces %}
# Interface: {{ iface.name }}
node.session.iface.initiatorname = {{ iface.initiatorname | default('') | quote }}
node.session.iface.ipaddress = {{ iface.ipaddress | default('') | quote }}
node.session.iface.netdev = {{ iface.netdev | default('') | quote }}
node.session.iface.mac = {{ iface.mac | default('') | quote }}
node.session.iface.header_digest = {{ iface.header_digest | default('') | quote }}
node.session.iface.data_digest = {{ iface.data_digest | default('') | quote }}
node.session.iface.max_recv_dlength = {{ iface.max_recv_dlength | default('') | quote }}
node.session.iface.port = {{ iface.port | default('') | quote }}
node.session.iface.state = {{ iface.state | default('') | quote }}
{% endfor %}

# Logging level
node.conn.log_auth = {{ node_conn_log_auth }}
node.conn.log_iscsi = {{ node_conn_log_iscsi }}
node.conn.log_nvme = {{ node_conn_log_nvme }}
node.conn.log_isns = {{ node_conn_log_isns }}
node.conn.log_tcp = {{ node_conn_log_tcp }}

# Session recovery and timeouts
node.session.timeo.replacement_timeout = {{ node_session_timeo_replacement_timeout }}
node.session.timeo.err_timeo = {{ node_session_timeo_err_timeo }}
node.session.timeo.abort_timeout = {{ node_session_timeo_abort_timeout }}
node.session.timeo.login_timeout = {{ node_session_timeo_login_timeout }}
node.session.timeo.logout_timeout = {{ node_session_timeo_logout_timeout }}
node.session.timeo.noop_out_interval = {{ node_session_timeo_noop_out_interval }}
node.session.timeo.noop_out_timeout = {{ node_session_timeo_noop_out_timeout }}

# I/O tuning
node.conn.scan = {{ node_conn_scan }}
node.session.err_timeo.action = {{ node_session_err_timeo_action }}
node.session.isns.enabled = {{ node_session_isns_enabled }}
node.session.isns.port = {{ node_session_isns_port }}
node.session.isns.server = {{ node_session_isns_server | default('') | quote }}

# Startup control
node.startup = {{ node_startup }}
discovery.sendtargets.auto_node_discovery = {{ discovery_sendtargets_auto_node_discovery }}
