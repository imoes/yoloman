{
 "args": [
  "-config",
  "/etc/81voltd/config.yaml"
 ],
 "cpu_limit": "0.5",
 "dependencies": [
  "redis",
  "postgresql"
 ],
 "environment": [
  "LOG_LEVEL=info",
  "DATA_DIR=/data/81voltd"
 ],
 "executable": "/usr/bin/81voltd",
 "health_check_interval": 30,
 "liveness_probe": "/usr/bin/81voltd --check-alive",
 "log_directory": "/var/log/81voltd",
 "log_file_pattern": "81voltd-%Y%m%d.log",
 "memory_limit": "1G",
 "mounts": [
  {
   "destination": "/etc/81voltd",
   "options": "ro",
   "source": "/etc/81voltd"
  },
  {
   "destination": "/data",
   "options": "rw",
   "source": "/data/81voltd"
  }
 ],
 "port": [
  8181,
  8443
 ],
 "readiness_probe": "/usr/bin/81voltd --check-ready",
 "restart_policy": "on-failure",
 "restart_retries": 5,
 "service_group": "81voltd",
 "service_user": "81voltd",
 "working_directory": "/var/lib/81voltd"
}
