% KeePass2 Configuration
% =============================================================================
% This file contains the user-specific configuration for KeePass2.
% It is managed by Ansible. Do not edit manually.
% =============================================================================

# -----------------------------------------------------------------------------
# Database file path
# Description: The file path to the KeePass database (.kdbx) to be used by default.
# -----------------------------------------------------------------------------
database_path: {{ db_path | default('/home/user/Documents/Passwords.kdbx') }}

# -----------------------------------------------------------------------------
# Clipboard auto-clear delay
# Description: Number of seconds to wait before automatically clearing the clipboard
#              after copying a password.
# -----------------------------------------------------------------------------
clipboard_clear_seconds: {{ clipboard_clear | default(8) }}

# -----------------------------------------------------------------------------
# Global Auto-Type Hotkey
# Description: The global hotkey combination to trigger KeePass auto-type.
# -----------------------------------------------------------------------------
auto_type_hotkey: {{ auto_type_key | default('Ctrl+Alt+A') }}

# -----------------------------------------------------------------------------
# Language Translation File
# Description: Path to a specific language translation file (.kpll/.kppx).
#              Leave empty to use the default English language.
# -----------------------------------------------------------------------------
language_file: {{ language_file | default('') }}

# -----------------------------------------------------------------------------
# Plugins Directory
# Description: The system directory path where KeePass2 expects to find installed plugins.
# -----------------------------------------------------------------------------
plugins_directory: {{ plugins_dir | default('/usr/lib/keepass2/plugins') }}