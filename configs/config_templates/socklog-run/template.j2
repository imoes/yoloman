#!/bin/sh
#
# socklog-run: Start the socklog inet daemon.
# This script is managed by Ansible. Do not edit manually.
#
# Variables:
#   log_port: UDP port for syslog messages.
#   max_queue_size: In-memory queue depth.

exec 2>&1
exec chpst -U _socklog-inet socklog inet {{ log_port | default(0) }} {{ max_queue_size | default(514) }}