{
  "tabsize": 4,
  "keytimeout_ms": 250,
  "tabs_to_spaces": true,
  "dos": false,
  "no_color": false,
  "syntax_include_paths": [
    "/usr/share/nano/*.nanorc",
    "/etc/nano/nanorc.d/*.nanorc"
  ],
  "custom_keybindings": [
    {
      "key": "^R",
      "action": "redo"
    },
    {
      "key": "M-u",
      "action": "undo",
      "mode": "all"
    }
  ]
}
