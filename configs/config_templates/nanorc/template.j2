# Enable syntax highlighting
set syntax

# Enable mouse support
set mouse

# Show position and line numbers
set number
set tabstospaces

# Enable soft wrapping
set softwrap

# Set tab size (in spaces)
set tabsize {{ tabsize }}

# Set keytimeout in milliseconds (how long to wait for escape sequences)
set keytimeout {{ keytimeout_ms }}

# Auto-indent new lines
set autoindent

# Back up existing files before overwriting
set backup

# Use blank line after paragraph (for formatting)
set parabreak

# Indent with tabs instead of spaces if set to false
set tabstospaces {{ tabs_to_spaces }}

# Prefer system locale for line endings
set dos
{% if dos %}
# When DOS mode is on, use CRLF line endings
{% endif %}

# Follow symlinks when opening files
set followSymlinks

# Don’t truncate long lines; wrap instead
set nowrap

# Disable color if terminal is not color-capable
{% if no_color %}
set no color
{% endif %}

# Include syntax highlighting definitions from system or custom paths
{% for path in syntax_include_paths %}
include "{{ path }}"
{% endfor %}

# Custom keybindings (example: bind ^R redo in case missing)
{% for keydef in custom_keybindings %}
bind {{ keydef.key }} {{ keydef.action }} {{ keydef.mode | default('all', true) }}
{% endfor %}