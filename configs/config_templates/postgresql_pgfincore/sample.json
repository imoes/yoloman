{
  "pin_pages": 20000,
  "pin_on_first_access": true,
  "pin_tables": [
    "public.*",
    "analytics.sessions"
  ],
  "min_free_memory_mb": 128,
  "max_pages_per_table": 100000,
  "log_level": "LOG",
  "unpin_on_checkpoint": false,
  "exclude_tables": [
    "pg_catalog.*",
    "information_schema.*",
    "system_metrics.*"
  ],
  "shared_preload_libraries": [
    "pgfincore"
  ]
}
