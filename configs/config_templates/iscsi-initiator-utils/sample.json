{
  "discovery_start": true,
  "timeout_login_timeout": 15,
  "timeout_logout_timeout": 10,
  "auth_retry": 3,
  "discovery_auth_method": "CHAP",
  "discovery_auth_username": "myinitiator",
  "discovery_auth_password": "mypassword",
  "discovery_auth_username_in": "mytarget",
  "discovery_auth_password_in": "mytargetsecret",
  "targets": [
    {
      "name": "iqn.2003-01.org.example.mynode:storage.lun1",
      "portal": "10.0.0.50",
      "port": 3260,
      "chap": {
        "enabled": true,
        "method": "Mutual CHAP",
        "username": "initiator-user",
        "password": "initiator-secret",
        "username_in": "target-user",
        "password_in": "target-secret"
      }
    }
  ],
  "iface_transport_name": "tcp",
  "iface_hwaddress": "00:11:22:33:44:55",
  "iface_header_digest": "CRC32C",
  "iface_data_digest": "NONE",
  "session_max_connections": 1,
  "node_session_initial_login_retry_max": 8,
  "node_session_cmds_max": 32,
  "node_conn_max_xmit_data_length": 262144,
  "node_conn_max_recv_data_length": 262144,
  "iscsi_offload": false,
  "node_session_err_timeo_abort_timeout": 15,
  "node_session_err_timeo_reset_timeout": 30,
  "node_session_err_timeo_fast_io_fail_timeout": 5,
  "node_session_recovery_tmo": 120
}
