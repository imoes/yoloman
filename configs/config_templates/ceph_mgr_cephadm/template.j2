[global]
# Unique cluster identifier (UUID). Required for new deployments; empty string if not yet generated.
fsid = {{ fsid | default('') }}

# Additional arbitrary key-value global options for ceph.conf.
{% for key, value in (global_opts | default({})) | dict2items %}
{{ key }} = {{ value }}
{% endfor %}

[mon]
# List of initial monitor hostnames or IPs, used during bootstrapping or as fallback.
# Defaults to an empty list; join produces an empty string if no monitors are defined.
mon_host = {{ mon_host | default([]) | join(', ') }}

# List of monitor names that constitute the initial quorum.
mon_initial_members = {{ mon_initial_members | default([]) | join(', ') }}

[mgr]
# List of ceph-mgr modules to enable. The 'cephadm' module is essential for orchestrator functionality.
# Defaults to ['dashboard', 'restful']. Empty list disables all extra modules.
{% if (mgr_modules_enabled | default(['dashboard', 'restful'])) | length > 0 %}
mgr_modules = {{ mgr_modules_enabled | default(['dashboard', 'restful']) | join(',') }}
{% endif %}

[mds]
# Path template for the Metadata Server (MDS) data directory.
# The '$id' variable is resolved by Ceph at runtime to the specific MDS daemon ID.
mds_data = {{ mds_data | default('/var/lib/ceph/mds/ceph-$id') }}

[osd]
# Journal size in MB for legacy filestore OSDs; ignored if using bluestore (the default).
osd_journal_size = {{ osd_journal_size | default(5120) }}

# Filesystem type for OSD creation. 'bluestore' is the modern default; 'filestore' is legacy.
osd_mkfs_type = {{ osd_mkfs_type | default('bluestore') }}

# Extra options passed to mkfs.xfs when creating OSD block devices with the XFS filesystem.
osd_mkfs_options_xfs = {{ osd_mkfs_options_xfs | default('-f -i size=2048') }}

# Mount options for XFS filesystems used by OSDs to optimize performance and durability.
osd_mount_options_xfs = {{ osd_mount_options_xfs | default('rw,noatime,inode64') }}

[client]
# Enable RBD (RADOS Block Device) client-side caching. Values: 'enabled' or 'disabled'.
rbd_cache = {{ rbd_cache | default('enabled') | lower }}

# If true, use writethrough mode until the first flush operation occurs.
rbd_cache_writethrough_until_flush = {{ rbd_cache_writethrough_until_flush | default('true') | lower }}

[orchestrator]
# Name of the orchestrator module to activate. 'cephadm' enables cluster management via cephadm.
orchestrator = cephadm

# When true, cephadm automatically places daemons (mon, mgr, osd, etc.) on hosts based on constraints.
orchestrator_enable_daemon_placement = {{ orchestrator_enable_daemon_placement | default(true) | lower }}

# Seconds between inventory scans of hosts. Set to 0 to disable periodic inventory refresh.
orchestrator_inventory_refresh_interval = {{ orchestrator_inventory_refresh_interval | default(300) }}

# Seconds between refresh of scheduled service specs (e.g., daemon definitions). Set to 0 to disable.
orchestrator_service_spec_refresh_interval = {{ orchestrator_service_spec_refresh_interval | default(60) }}

# Base container image used by cephadm for deploying Ceph daemons.
orchestrator_container_image_base = {{ orchestrator_container_image_base | default('docker.io/ceph/ceph:v18') }}

# Enable secure TLS for the built-in monitoring stack (Prometheus, Grafana, Alertmanager).
orchestrator_secure_monitoring_stack = {{ orchestrator_secure_monitoring_stack | default(true) | lower }}

# Optional external Alertmanager URL for alerting integration.
{% if prometheus_alertmanager_url | default('') %}
orchestrator_alertmanager_url = {{ prometheus_alertmanager_url | default('') }}
{% endif %}

# Basic auth username for the Alertmanager endpoint (if used).
{% if prometheus_alertmanager_basic_user | default('') %}
orchestrator_alertmanager_basic_user = {{ prometheus_alertmanager_basic_user | default('') }}
{% endif %}

# Basic auth password for the Alertmanager endpoint (if used).
{% if prometheus_alertmanager_basic_password | default('') %}
orchestrator_alertmanager_basic_password = {{ prometheus_alertmanager_basic_password | default('') }}
{% endif %}

# Custom inventory and spec polling sources for advanced cephadm configurations.
{% if (orchestrator_inventory_sources | default([])) | length > 0 %}
[orchestrator:inventory_sources]
{% for src in orchestrator_inventory_sources | default([]) %}
{{ src.name }} = {{ src.path }}
{% endfor %}
{% endif %}