{
  "fsid": "a0b1c2d3-e4f5-6789-0abc-def123456789",
  "global_opts": {
    "log_file": "/var/log/ceph/$cluster-$name.log",
    "mon_osd_report_timeout": 300,
    "osd_pool_default_size": "3",
    "osd_pool_default_min_size": "2"
  },
  "mon_host": [
    "mon1.ceph",
    "mon2.ceph",
    "mon3.ceph"
  ],
  "mon_initial_members": [
    "mon1",
    "mon2",
    "mon3"
  ],
  "mgr_modules_enabled": [
    "cephadm",
    "dashboard",
    "restful",
    "prometheus"
  ],
  "mds_data": "/var/lib/ceph/mds/ceph-$id",
  "osd_journal_size": 5120,
  "osd_mkfs_type": "bluestore",
  "osd_mkfs_options_xfs": "-f -i size=2048",
  "osd_mount_options_xfs": "rw,noatime,inode64",
  "rbd_cache": "enabled",
  "rbd_cache_writethrough_until_flush": "true",
  "orchestrator_enable_daemon_placement": true,
  "orchestrator_inventory_refresh_interval": 300,
  "orchestrator_service_spec_refresh_interval": 60,
  "orchestrator_container_image_base": "docker.io/ceph/ceph:v18",
  "orchestrator_secure_monitoring_stack": true,
  "prometheus_alertmanager_url": "https://alertmanager.ceph.example.com",
  "prometheus_alertmanager_basic_user": "admin",
  "prometheus_alertmanager_basic_password": "supersecret",
  "orchestrator_inventory_sources": [
    {
      "name": "static_hosts",
      "path": "/etc/ceph/inventory.yml"
    },
    {
      "name": "vmware",
      "path": "/etc/ceph/vmware_inventory.json"
    }
  ]
}
