# Configuration file for ereandel (v0.26.0+)
# See ereandel(1) man page for details.
# This file is managed by Ansible. Do not edit manually.

# margin: Number of spaces to use as margin when rendering Gemini content
# Default: 8
margin={{ margin | default(8) }}

# homepage: Default homepage URL
# Default: 'gemini.circumlunar.space/'
homepage="{{ homepage | default('gemini.circumlunar.space/') }}"

# sty_header1: ANSI escape sequence for level-1 headers
# Default: '\033[35;7;1m'
sty_header1='{{ sty_header1 | default("\033[35;7;1m") }}'

# sty_header2: ANSI escape sequence for level-2 headers
# Default: '\033[35;4;1m'
sty_header2='{{ sty_header2 | default("\033[35;4;1m") }}'

# sty_header3: ANSI escape sequence for level-3 headers
# Default: '\033[35;4m'
sty_header3='{{ sty_header3 | default("\033[35;4m") }}'

# sty_quote: ANSI escape sequence for quoted text
# Default: '\033[2;3m '
sty_quote='{{ sty_quote | default("\033[2;3m ") }}'

# sty_linkb: ANSI escape sequence for link bullet marker
# Default: '\033[35m'
sty_linkb='{{ sty_linkb | default("\033[35m") }}'

# sty_linkt: ANSI escape sequence prefix for link text
# Default: ' => \033[36;3m '
sty_linkt='{{ sty_linkt | default(" => \033[36;3m ") }}'

# sty_listb: ANSI escape sequence for list item bullet
# Default: '\033[35;1m •'
sty_listb='{{ sty_listb | default("\033[35;1m \u2022") }}'

# sty_listt: ANSI escape sequence to reset list rendering
# Default: '\033[0m'
sty_listt='{{ sty_listt | default("\033[0m") }}'

# openkey: Key to open an address
# Default: 'o'
openkey='{{ openkey | default("o") }}'

# openlocalkey: Key to open a local file
# Default: 'O'
openlocalkey='{{ openlocalkey | default("O") }}'

# gokey: Key to go to a link
# Default: 'g'
gokey='{{ gokey | default("g") }}'

# refreshkey: Key to reload current page
# Default: 'r'
refreshkey='{{ refreshkey | default("r") }}'

# backkey: Key to go back one page
# Default: 'b'
backkey='{{ backkey | default("b") }}'

# quitkey: Key to quit
# Default: 'q'
quitkey='{{ quitkey | default("q") }}'

# markkey: Key to add a bookmark
# Default: 'm'
markkey='{{ markkey | default("m") }}'

# gomarkkey: Key to go to a bookmark
# Default: 'M'
gomarkkey='{{ gomarkkey | default("M") }}'

# delmarkkey: Key to remove bookmark for current URL
# Default: 'K'
delmarkkey='{{ delmarkkey | default("K") }}'

# goupkey: Key to go up one path segment
# Default: 'u'
goupkey='{{ goupkey | default("u") }}'

# homekey: Key to go to homepage
# Default: 'H'
homekey='{{ homekey | default("H") }}'

# savekey: Key to save current page
# Default: 's'
savekey='{{ savekey | default("s") }}'