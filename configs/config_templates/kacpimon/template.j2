# kacpimon configuration file
# Source of ACPI events to monitor
# Accepted values: proc, netlink, input
# Default: proc
# kacpimon can monitor multiple sources simultaneously.
sources:
{% for src in (sources | default(['proc'])) %}
  - {{ src }}
{% endfor %}

# Verbose mode output to stderr
# When true, enables detailed logging of events and internal state.
# Default: false
verbose: {{ verbose | default(false) | lower }}

# Output format
# 'text' for human-readable output, 'json' for machine-parsable output.
# Default: text
output_format: {{ output_format | default('text') }}