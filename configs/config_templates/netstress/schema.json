{
  "mode": {
    "type": "string",
    "default": "master",
    "description": "Instance role: master or slave",
    "enum": [
      "master",
      "slave"
    ]
  },
  "iface": {
    "type": "string",
    "default": "eth0",
    "description": "Network interface to stress test"
  },
  "host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Host or IP address for connection"
  },
  "port": {
    "type": "number",
    "default": 5678,
    "description": "Port number to use (default 5678)"
  },
  "seed": {
    "type": "number",
    "default": 12345,
    "description": "Random number seed for reproducibility (master only)"
  },
  "report_mode": {
    "type": "string",
    "default": "elapsed",
    "description": "Time reporting mode: 'time' for current time, 'elapsed' for elapsed time",
    "enum": [
      "elapsed",
      "time"
    ]
  },
  "report_interval": {
    "type": "number",
    "default": 5,
    "description": "Interval in seconds between reports (default 5)"
  },
  "report_count": {
    "type": "number",
    "default": 3,
    "description": "Number of reports before stopping (default 3)"
  },
  "unit": {
    "type": "string",
    "default": "mb",
    "description": "Benchmark unit: 'mb' (megabits/sec), 'kb' (kilobits/sec), 'mbps' (megabytes/sec), 'kbs' (kilobytes/sec), 'bps' (bytes/sec), 'b' (bits)"
  },
  "direction": {
    "type": "string",
    "default": "rw",
    "description": "Test direction: 'rw' (read/write), 'mw' (master write), 'mr' (master read)"
  },
  "real_random": {
    "type": "bool",
    "default": false,
    "description": "Enable real random test instead of pseudo-random"
  },
  "fast_mode": {
    "type": "bool",
    "default": false,
    "description": "Enable fast mode (no checking, disables real_random)"
  },
  "verbosity": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level (multiples increase level, 0-3)"
  },
  "debug": {
    "type": "number",
    "default": 0,
    "description": "Debug level (multiples increase level, 0-3)"
  }
}
