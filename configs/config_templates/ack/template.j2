# ack configuration file (.ackrc)
# One option per line; lines starting with # are comments

{% if options.sort_files %}# Sort files lexicographically
--sort-files{% endif %}
{% if options.ignore_dir %}{% for dir in options.ignore_dir %}# Ignore directory: {{ dir }}
--ignore-dir={{ dir }}{% endfor %}{% endif %}
{% if options.ignore_file %}{% for filter in options.ignore_file %}# Ignore files matching filter: {{ filter }}
--ignore-file={{ filter }}{% endfor %}{% endif %}
{% if options.color %}# Always color output
--color{% endif %}
{% if options.color_filename %}# Custom filename color
--color-filename={{ options.color_filename }}{% endif %}
{% if options.color_match %}# Custom match color
--color-match={{ options.color_match }}{% endif %}
{% if options.color_linenumber %}# Custom line number color
--color-lineno={{ options.color_linenumber }}{% endif %}
{% if options.color_columnnumber %}# Custom column number color
--color-colno={{ options.color_columnnumber }}{% endif %}
{% if options.pager %}# Use pager program
--pager={{ options.pager }}{% endif %}
{% if options.context %}# Context lines around matches
--context={{ options.context }}{% endif %}
{% if options.after_context %}# Lines of trailing context
--after-context={{ options.after_context }}{% endif %}
{% if options.before_context %}# Lines of leading context
--before-context={{ options.before_context }}{% endif %}
{% if options.max_count %}# Maximum matches per file
--max-count={{ options.max_count }}{% endif %}
{% if options.output %}# Custom output format
--output={{ options.output }}{% endif %}
{% if options.range_start %}# Range start pattern
--range-start={{ options.range_start }}{% endif %}
{% if options.range_end %}# Range end pattern
--range-end={{ options.range_end }}{% endif %}
{% if options.types.include %}{% for type in options.types.include %}# Include type: {{ type }}
--type={{ type }}{% endfor %}{% endif %}
{% if options.types.exclude %}{% for type in options.types.exclude %}# Exclude type: {{ type }}
--type=no{{ type }}{% endfor %}{% endif %}
{% if options.types.add %}{% for t in options.types.add %}# Add extension to type: {{ t.type }}
--type-add={{ t.type }}:{{ t.filter }}:{{ t.args | join(',') }}{% endfor %}{% endif %}
{% if options.types.set %}{% for t in options.types.set %}# Set new type: {{ t.type }}
--type-set={{ t.type }}:{{ t.filter }}:{{ t.args | join(',') }}{% endfor %}{% endif %}
{% if options.types.delete %}{% for type in options.types.delete %}# Delete type: {{ type }}
--type-del={{ type }}{% endfor %}{% endif %}
{% if options.literal %}# Treat pattern as literal
--literal{% endif %}
{% if options.word_regexp %}# Match whole words only
--word-regexp{% endif %}
{% if options.ignore_case %}# Case-insensitive search
--ignore-case{% endif %}
{% if options.smart_case %}# Smart case (ignore case if pattern is lowercase)
--smart-case{% endif %}
{% if options.invert_match %}# Invert match
--invert-match{% endif %}
{% if options.only_matching %}# Show only matching part
--only-matching{% endif %}
{% if options.passthru %}# Print all lines but highlight matches
--passthru{% endif %}
{% if options.column %}# Show column numbers
--column{% endif %}
{% if options.group %}# Group output by file
--group{% endif %}
{% if options.underline %}# Underline matches with ^^^
--underline{% endif %}
{% if options.break %}# Print break between files
--break{% endif %}
{% if options.heading %}# Print filename headings
--heading{% endif %}
{% if options.color == false %}# Disable color
--nocolor{% endif %}
{% if options.flush %}# Flush output immediately
--flush{% endif %}
{% if options.follow %}# Follow symlinks
--follow{% endif %}
{% if options.filter %}# Force pipe mode
--filter{% endif %}
# End of ack configuration