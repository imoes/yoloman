{
  "options": {
    "sort_files": true,
    "ignore_dir": [
      "data",
      "vendor"
    ],
    "ignore_file": [
      "ext:log",
      "is:.DS_Store"
    ],
    "color": true,
    "color_filename": "bold red on_yellow",
    "color_match": "bold green",
    "color_linenumber": "bold yellow",
    "color_columnnumber": "bold yellow",
    "pager": "less -r",
    "context": 2,
    "after_context": 0,
    "before_context": 0,
    "max_count": 0,
    "output": "$f:$.:$&",
    "range_start": "^sub \\w+",
    "range_end": "^}",
    "types": {
      "include": [
        "perl",
        "html"
      ],
      "exclude": [
        "backup"
      ],
      "add": [
        {
          "type": "perl",
          "filter": "ext",
          "args": [
            "xs",
            "t"
          ]
        }
      ],
      "set": [
        {
          "type": "cobol",
          "filter": "ext",
          "args": [
            "cbl",
            "cob"
          ]
        }
      ],
      "delete": [
        "backup"
      ]
    },
    "literal": false,
    "word_regexp": false,
    "ignore_case": false,
    "smart_case": true,
    "invert_match": false,
    "only_matching": false,
    "passthru": false,
    "column": true,
    "group": true,
    "underline": false,
    "break": true,
    "heading": true,
    "flush": true,
    "follow": false,
    "filter": false
  }
}
