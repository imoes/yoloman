{
  "server": {
    "type": "string",
    "default": "localhost",
    "description": "Default server hostname or IP address."
  },
  "port": {
    "type": "string",
    "default": "sieve(4190)",
    "description": "Port specification, supports service name with numeric fallback."
  },
  "user": {
    "type": "string",
    "default": "",
    "description": "Authentication user ID."
  },
  "authzid": {
    "type": "string",
    "default": "",
    "description": "Authorization ID for SASL."
  },
  "auth_mech": {
    "type": "string",
    "default": "",
    "description": "Forced SASL authentication mechanism."
  },
  "realm": {
    "type": "string",
    "default": "",
    "description": "Authentication realm."
  },
  "local_sieve": {
    "type": "string",
    "default": "",
    "description": "Path to the local sieve script file."
  },
  "remote_sieve": {
    "type": "string",
    "default": "",
    "description": "Name of the remote sieve script on the server."
  },
  "action": {
    "type": "string",
    "default": "",
    "description": "Action to perform: upload, download, list, delete, checkscript, edit, activate, deactivate, exec.",
    "enum": [
      "upload",
      "download",
      "list",
      "delete",
      "edit",
      "exec"
    ]
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug traces."
  },
  "notlsverify": {
    "type": "bool",
    "default": false,
    "description": "Disable TLS certificate verification."
  },
  "clearchan": {
    "type": "bool",
    "default": false,
    "description": "Force cleartext channel fallback."
  },
  "use_ipv4": {
    "type": "bool",
    "default": false,
    "description": "Coerce IPv4 connection."
  },
  "use_ipv6": {
    "type": "bool",
    "default": false,
    "description": "Coerce IPv6 connection."
  },
  "nosrv": {
    "type": "bool",
    "default": false,
    "description": "Disable SRV record lookup."
  },
  "ignore_server_version": {
    "type": "bool",
    "default": false,
    "description": "Ignore server VERSION capability."
  },
  "client_key": {
    "type": "string",
    "default": "",
    "description": "Path to the TLS client private key file."
  },
  "client_cert": {
    "type": "string",
    "default": "",
    "description": "Path to the TLS client certificate file."
  },
  "tls_ca_file": {
    "type": "string",
    "default": "",
    "description": "Path to the TLS CA certificate file."
  },
  "tls_ca_path": {
    "type": "string",
    "default": "",
    "description": "Path to the TLS CA certificate directory."
  },
  "tls_hostname": {
    "type": "string",
    "default": "",
    "description": "Override TLS hostname for verification and SNI."
  }
}
