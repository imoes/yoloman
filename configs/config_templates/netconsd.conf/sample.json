{
  "listen_addr": "0.0.0.0",
  "listen_port": 2055,
  "interface": "eth0",
  "enable_ipv6": false,
  "max_message_size": 65535,
  "workers": 4,
  "log_level": "info",
  "pid_file": "/run/netconsd.pid",
  "enable_syslog": true,
  "log_file": "/var/log/netconsd/netconsd.log",
  "output_format": "json",
  "output_dir": "/var/log/netconsd/output",
  "enable_rate_limit": true,
  "rate_limit_max": 500,
  "rate_limit_burst": 1000,
  "drop_duplicates": true,
  "duplicate_window": 15,
  "persist_state": false,
  "state_file": "/var/lib/netconsd/state.json",
  "allowed_sources": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "blocked_sources": [
    "127.0.0.0/8",
    "::1/128"
  ]
}
