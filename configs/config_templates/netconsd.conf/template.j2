# netconsd main configuration file
# Listen address and port
listen = {{ listen_addr }}:{{ listen_port }}

# Network interface to bind to (empty = all)
interface = {{ interface }}

# Enable/Disable IPv6
ipv6 = {{ enable_ipv6 }}

# Maximum size of received message (bytes)
max_message_size = {{ max_message_size }}

# Number of worker threads
workers = {{ workers }}

# Log level: debug, info, warn, error, fatal
log_level = {{ log_level }}

# Path to PID file
pid_file = {{ pid_file }}

# Enable/Disable syslog logging
syslog = {{ enable_syslog }}

# Path to log file (if syslog = false)
log_file = {{ log_file }}

# Output format: json, plain, syslog
output_format = {{ output_format }}

# Output directory for plain/log files
output_dir = {{ output_dir }}

# Enable/Disable rate limiting
rate_limit = {{ enable_rate_limit }}

# Max messages per second (0 = unlimited)
rate_limit_max = {{ rate_limit_max }}

# Rate limit burst size
rate_limit_burst = {{ rate_limit_burst }}

# Enable/Disable dropping of duplicate messages
# (only effective for same message from same source within time window)
drop_duplicates = {{ drop_duplicates }}

# Duplicate detection window (seconds)
duplicate_window = {{ duplicate_window }}

# Enable/Disable persistence of state (e.g., duplicate cache)
persist_state = {{ persist_state }}

# Path to state file (used if persist_state = true)
state_file = {{ state_file }}

# List of allowed source CIDR blocks (empty = allow all)
{% for cidr in allowed_sources %}allowed_source = {{ cidr }}
{% endfor %}

# List of blocked source CIDR blocks (empty = block none)
{% for cidr in blocked_sources %}blocked_source = {{ cidr }}
{% endfor %}
