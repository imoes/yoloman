{
  "paths": {
    "database_home": "/var/lib/gnunet",
    "config_home": "/etc/gnunet",
    "dht_data_dir": "/var/lib/gnunet/dht",
    "zonekey_dir": "/var/lib/gnunet/gns"
  },
  "services": {
    "resolver": {
      "enabled": true
    },
    "nat": {
      "enabled": true,
      "force_local": false
    },
    "peerinfo": {
      "enabled": true
    },
    "ats": {
      "enabled": true
    },
    "vpn": {
      "enabled": false
    },
    "tun": {
      "enabled": false
    },
    "consensus": {
      "enabled": true
    },
    "dht": {
      "enabled": true
    },
    "fs": {
      "enabled": true
    },
    "identity": {
      "enabled": true
    },
    "revocation": {
      "enabled": false
    },
    "set": {
      "enabled": true
    },
    "gns": {
      "enabled": true
    },
    "nse": {
      "enabled": true
    },
    "statistics": {
      "enabled": true
    }
  },
  "peerinfo": {
    "trusted_peers": []
  },
  "transport": {
    "plugins": [
      "tcp",
      "udp",
      "http",
      "https"
    ],
    "plugin_configs": {
      "tcp": {
        "port": 2086,
        "listen": true,
        "bind_to": "0.0.0.0"
      },
      "udp": {
        "port": 2086,
        "listen": true,
        "bind_to": null
      },
      "http": {
        "port": 2087,
        "listen": true,
        "bind_to": "127.0.0.1"
      },
      "https": {
        "port": 2088,
        "listen": true,
        "bind_to": "0.0.0.0"
      }
    }
  },
  "ats": {
    "wan_quota_in": 102400,
    "wan_quota_out": 102400
  },
  "dht": {
    "debug_no_disk": false
  },
  "fs": {
    "default_namespace": "public",
    "search_timeout_ms": 30000,
    "max_concurrent_searches": 5
  },
  "identity": {
    "default_name": "alice"
  },
  "gns": {
    "cache_enabled": true
  }
}
