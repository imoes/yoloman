{
  "source_dir": {
    "type": "string",
    "default": "/usr/src/linux",
    "description": "Specify kernel source directory"
  },
  "config_file": {
    "type": "string",
    "default": "/boot/config-$(uname -r)",
    "description": "Specify kernel config file"
  },
  "vmlinux": {
    "type": "string",
    "default": "/usr/lib/debug/lib/modules/$(uname -r)/vmlinux",
    "description": "Specify original vmlinux"
  },
  "jobs": {
    "type": "number",
    "default": 4,
    "description": "Specify the number of make jobs"
  },
  "module_name": {
    "type": "string",
    "default": "my-kpatch",
    "description": "Specify the name of the kpatch module"
  },
  "output_dir": {
    "type": "string",
    "default": ".",
    "description": "Specify output folder"
  },
  "patch_file": {
    "type": "string",
    "default": "patch.ko.patch",
    "description": "The patch file to apply"
  },
  "arch_version": {
    "type": "string",
    "default": "",
    "description": "Specify the kernel arch version"
  },
  "source_rpm": {
    "type": "string",
    "default": "",
    "description": "Specify kernel source RPM"
  },
  "oot_module": {
    "type": "bool",
    "default": false,
    "description": "Enable patching out-of-tree module"
  },
  "oot_module_src": {
    "type": "string",
    "default": "",
    "description": "Specify out-of-tree module source directory"
  },
  "non_replace": {
    "type": "bool",
    "default": false,
    "description": "Disable replace flag of KLP"
  },
  "skip_cleanup": {
    "type": "bool",
    "default": false,
    "description": "Skip post-build cleanup"
  },
  "skip_compiler_check": {
    "type": "bool",
    "default": false,
    "description": "Skips check that ensures that the system compiler version and the compiler version that built the kernel match"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Keep scratch files in /tmp"
  }
}
