{
  "paths.working_dir": "/var/lib/heat",
  "logging.log_file": "/var/log/heat/heat.log",
  "logging.level": "INFO",
  "region.name": "RegionOne",
  "debug": false,
  "verbose": false,
  "database.connection": "mysql+pymysql://heat:heat_pass@db.example.com/heat",
  "database.max_retries": 20,
  "database.retry_interval": 5,
  "notifications.driver": "messagingv2",
  "rabbit.host": "rabbitmq.example.com",
  "rabbit.port": 5672,
  "rabbit.user": "heat",
  "rabbit.password": "rabbit_secret",
  "rabbit.virtual_host": "/heat",
  "rabbit.ha_queues": true,
  "rabbit.connection_retry_timeout": 60,
  "keystone.auth_url": "https://keystone.example.com:5000/v3",
  "keystone.project_name": "service",
  "keystone.username": "heat",
  "keystone.password": "heat_secret",
  "keystone.user_domain_name": "Default",
  "keystone.project_domain_name": "Default",
  "keystone.insecure": false,
  "keystone.service_token_roles_required": true,
  "keystone.interface": "internal",
  "cors.enabled": true,
  "cors.allowed_origin": [
    "https://console.example.com"
  ],
  "policy.file": "/etc/heat/policy.json",
  "conductor.host": "",
  "conductor.workers": 4,
  "api.bind_host": "0.0.0.0",
  "api.bind_port": 8004,
  "api.api_bind_engine": "heat",
  "api.enable_cfn_api": true,
  "api.enable_heat_api": true,
  "api.workers": 4,
  "api.api_rate_limit": 100,
  "engine.host": "heat-engine-01.example.com",
  "engine.workers": 4,
  "engine.stack_action_timeout": 7200,
  "engine.signal_receiver_use_cfn": false
}
