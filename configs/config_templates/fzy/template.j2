{# ============================================================================== #}
{# fzy terminal fuzzy selector configuration                                     #}
{# This is the per-user fzy configuration file (typically ~/.config/fzy/config)  #}
{# Format: key: value                                                            #}
{# ============================================================================== #}

{# Input prompt string displayed to the left of the search field.                #}
prompt: {{ (prompt | default('> ')) }}

{# Number of lines of items to display in the menu. Must be a positive integer.  #}
lines: {{ (lines | default(10)) }}

{# Whether to show the match score for each item.                                #}
show_scores: {{ show_scores | default(false) | ternary('true', 'false') }}

{# Non-interactive mode: print matches for this query instead of entering        #}
{# interactive mode. If empty, fzy runs in interactive mode.                     #}
show_matches: {{ (show_matches | default('')) }}

{# Initial search query to pre-fill when starting fzy.                           #}
query: {{ (query | default('')) }}

{# Note: tty selection is not configurable in this user config file;           #}
{# use the -t CLI flag instead.                                                #}