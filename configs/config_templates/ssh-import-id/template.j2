# Configuration for ssh-import-id
# Protocol and user IDs to import keys from. If empty, defaults to lp: (Launchpad).
# Format: space-separated strings, e.g. "lp:admin gh:developer"

# The 'protocols' list contains strings like 'lp:user' or 'gh:user'.
# If this list is empty, ssh-import-id defaults to launching the default protocol (Launchpad).
# We join the list items with a space for the configuration file format.
{% set protocols_list = protocols | default([], true) %}
{% if protocols_list | length > 0 %}
{{ protocols_list | join(' ') }}
{% endif %}