# /etc/host.conf: Host-specific network configuration for hostname resolution
# Controls the behavior of the gethostbyname() and gethostbyaddr() system calls
# Order of hostname lookups: 'bind' (DNS), 'files' (/etc/hosts), or mixed
order {{ order | default('files,bind') }}

# If 'multi' is set, allow multiple IP addresses per hostname in /etc/hosts
# If unset, only the first IP is used (standard behavior)
{{ 'multi' if multi | default(false) else '' }}

# Timeout (in seconds) for DNS queries before falling back to next resolver
# Set to 0 to disable timeout (not recommended)
timeout {{ timeout | default(3) }}

# Number of retries for DNS queries
retries {{ retries | default(3) }}

# Maximum number of entries in the DNS cache (if nscd is not used)
cache 2048

# Enable DNSSEC validation? (requires DNSSEC-capable resolver like systemd-resolved or bind)
# Note: Only honored by modern resolvers; ignored by older libc implementations
{{ 'dnssec' if dnssec | default(false) else '' }}

# For compatibility: legacy setting to prefer IPv4 over IPv6 (rarely needed)
# Set to 'on' only if IPv6 misconfiguration causes issues
{{ 'ip4_first' if ip4_first | default(false) else '' }}