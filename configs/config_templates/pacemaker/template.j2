# Pacemaker cluster configuration file
# Generated by Jinja2 from template
# WARNING: Manual edits may be overwritten; use `crm configure` for runtime changes

# Global cluster options
global {
  # Cluster name (must be identical across all nodes)
  cluster-name: {{ cluster_name }};
  
  # DC election timeout in milliseconds
  dc-deadtime: {{ dc_deadtime }};
  
  # Enable or disableSTONITH (required for production)
  start-standby: {{ start_standby }};
  
  # Enable STONITH (_fence devices_) when true
  stonith-enabled: {{ stonith_enabled }};
  
  # Whether to allow resource management when not all nodes are online
  no-quorum-policy: {{ no_quorum_policy }};
}

# Resource defaults (applied unless overridden per resource)
resourceDefaults {
  # Failure timeout before attempting recovery
  migration-threshold: {{ resource_defaults.migration_threshold }};
  
  # Resource operation timeout in seconds
  op-timeout: {{ resource_defaults.op_timeout }}s;
  
  # Minimum time between repeated operations of same type
  interval-origin: {{ resource_defaults.interval_origin }};
  
  # Whether to monitor resources when they are stopped
  resource-failure-stickiness: {{ resource_defaults.resource_failure_stickiness }};
}

# Location constraints: where resources can/should run
{% for constraint in location_constraints %}
location {{ constraint.id }} {
  # Description (optional)
{% if constraint.comment %}  # {{ constraint.comment }}
{% endif %}  # Node preference: higher = preferred
  {{ constraint.resource }} {{ constraint.score }}: {{ constraint.node }};
}
{% endfor %}

# Colocation constraints: which resources must/want run together
{% for constraint in colocation_constraints %}
colocation {{ constraint.id }} {{ constraint.score }}:
{% for res in constraint.resources %}  {{ res }}{% if not loop.last %} with{% endif %}
{% endfor %};
{% endfor %}

# Ordering constraints: which resources must start before others
{% for constraint in ordering_constraints %}
order {{ constraint.id }} {{ constraint.kind }} {
{% for res in constraint.resources %}  {{ res }}{% if not loop.last %} then{% endif %}
{% endfor %};
}
{% endfor %}

# Resource definitions
{% for res in resources %}
# Resource: {{ res.id }}
{% if res.comment %}# {{ res.comment }}
{% endif %}primitive {{ res.id }} {{ res.class }}:{{ res.type }} \
  {{ res.op_defaults | join(' \
  ') | indent(2) }}
  {{ res.params | join(' \
  ') | indent(2) }}
{% endfor %}

# Grouped resources
{% for grp in groups %}
group {{ grp.id }} \
{% for res in grp.members %}  {{ res }}{% if not loop.last %}, {% endif %}
{% endfor %};
{% endfor %}

# Clone resources (for stateful resources like DLM, STONITH)
{% for clone in clones %}
clone {{ clone.id }} {{ clone.resource }} \
{% if clone.params %}
  {{ clone.params | join(' \
  ') | indent(2) }}
{% endif %}
;
{% endfor %}

# Clone global options
cloneDefaults {
  globally-unique: {{ clone_defaults.globally_unique }};
}

# Monitor defaults for all resources
opDefaults {
  timeout: {{ op_defaults.timeout }}s;
  interval: {{ op_defaults.interval }}s;
  record-pending: {{ op_defaults.record_pending }};
}
