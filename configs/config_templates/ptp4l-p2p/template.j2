[global]
# PTP clock identity: 16-hex-digit string (e.g., '001B44FFFE5A3B12') or 'auto' to derive from MAC.
# Derived from schema field: clock_identity (default: 'auto')
clock_identity = {{ clock_identity | default('auto') }}

# Network interface to use for PTP peer-to-peer communication.
# Must support hardware timestamping for best results.
# Derived from schema field: interface (default: 'eth0')
interface = {{ interface | default('eth0') }}

# Priority1 field for best master clock selection (0–255).
# Lower value = higher priority. Recommended: 248 for ordinary clock.
# Derived from schema field: priority1 (default: 248)
priority1 = {{ priority1 | default(248) }}

# Clock class (0–255), indicating clock quality.
# Lower is better (0=primary reference, 6=ordinary clock).
# Derived from schema field: clock_class (default: 6)
clock_class = {{ clock_class | default(6) }}

# Manual frequency offset in parts per billion (ppb).
# Range: ±1,000,000. Use to calibrate oscillator. 0 = no offset.
# Derived from schema field: frequency_offset (default: 0)
frequency_offset = {{ frequency_offset | default(0) }}

# Verbosity of logging (0–7).
# 7 = debug, 3 = info, 0 = quiet.
# Derived from schema field: log_level (default: 7)
log_level = {{ log_level | default(7) }}

# P2P delay request interval as exponent of 2 (s).
# Value = 2^(-n). n=0 → 1s, n=-1 → 2s.
# Derived from schema field: p2p_delay_req_interval (default: 0)
p2p_delay_req_interval = {{ p2p_delay_req_interval | default(0) }}

# Enable hardware timestamping for precise timing (sub-100ns accuracy).
# Derived from schema field: hw_timestamping (default: True)
{% if hw_timestamping | default(true) is sameas true %}hw_timestamping = 1
{% endif %}