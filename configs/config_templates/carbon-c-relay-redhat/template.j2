# ==============================================================================
# Carbon-C-Relay Configuration
# ==============================================================================
# This file is managed by Ansible. Do not edit manually.
# Generated for: carbon-c-relay-redhat

# --------------------------------------------------------------------------
# Cluster Definition
# --------------------------------------------------------------------------
# Defines the destination cluster to which metrics are forwarded.
# The name of this cluster is referenced by 'match' statements.
cluster {{ cluster_name | default('local_carbon') }}
  forward
    # Host and port of the Carbon collector (e.g., Carbon-Relay, Graphite-Carbon).
    # Format: <hostname_or_ip>:<port>
    {{ carbon_host | default('127.0.0.1') }}:{{ carbon_port | default(2013) }}
  ;

# --------------------------------------------------------------------------
# Matching Rules
# --------------------------------------------------------------------------
# Defines how received metrics are routed.
# 'match *' applies to all metrics not matched by earlier rules.
# 'send to <cluster>' forwards the metric to the specified cluster.
# 'stop' prevents the metric from matching further rules.
match *
  send to {{ cluster_name | default('local_carbon') }}
  stop
  ;

