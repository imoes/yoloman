{
  "ports": [
    {
      "number": 4242,
      "bind_ip": null
    },
    {
      "number": 4243,
      "bind_ip": "127.0.0.1"
    }
  ],
  "model_dir": "/var/lib/mbtserver/models",
  "dict_file": "/usr/share/mbtserver/dict.bin",
  "threads": 8,
  "max_connections": 1024,
  "connection_timeout": 60,
  "verbose": false,
  "log_file": "/var/log/mbtserver/server.log",
  "extra_headers": {
    "X-Server": "mbtserver",
    "X-Version": "2.1.0"
  },
  "allowed_subnets": [
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "disabled_features": [
    "nbest"
  ]
}
