{
  "driver": "alsa",
  "device": "hw:0",
  "rate": 48000,
  "period": 512,
  "nperiods": 3,
  "input_channels": 2,
  "output_channels": 2,
  "realtime_priority": 10,
  "extra_args": [
    "--sync"
  ],
  "start_delay": 2,
  "auto_connect": false,
  "post_start_commands": [
    "jack_connect qjackctl:system_in_1 system:playback_1",
    "jack_connect qjackctl:system_in_2 system:playback_2",
    "jack_connect system:capture_1 qjackctl:system_in_1",
    "jack_connect system:capture_2 qjackctl:system_in_2"
  ]
}
