# /etc/freedombox/plinth-config.yaml — Main FreedomBox configuration
# Enable or disable the web interface
enable_web_interface: {{ enable_web_interface }}

# Hostname exposed to the internet via dynamic DNS (if enabled)
hostname: "{{ hostname }}"

# Network interface to use for the main web service
interface: "{{ interface }}"

# Port for the main FreedomBox web interface (Plinth)
port: {{ port }}

# Time zone setting for system logs and services
timezone: "{{ timezone }}"

# Enable or disable automatic security updates
automatic_security_updates: {{ automatic_security_updates }}

# List of enabled services (each with its own config block below)
services:
{% for service in services %}
  - name: "{{ service.name }}"
    enabled: {{ service.enabled }}
{% if service.enabled %}
{% if service.name == 'nextcloud' %}
    # Nextcloud-specific settings
    nextcloud_admin_user: "{{ service.admin_user }}"
    nextcloud_admin_password: "{{ service.admin_password }}"
    nextcloud_data_directory: "{{ service.data_directory }}"
    nextcloud_domain: "{{ service.domain }}"
    nextcloud_database_type: "{{ service.database_type }}"
    nextcloud_db_host: "{{ service.db_host }}"
    nextcloud_db_name: "{{ service.db_name }}"
    nextcloud_db_user: "{{ service.db_user }}"
    nextcloud_db_password: "{{ service.db_password }}"
{% endif %}
{% if service.name == 'matrix' %}
    # Synapse (Matrix) settings
    matrix_domain: "{{ service.domain }}"
    matrix_admin_user: "{{ service.admin_user }}"
    matrix_admin_password: "{{ service.admin_password }}"
    matrix_database_type: "{{ service.database_type }}"
    matrix_db_host: "{{ service.db_host }}"
    matrix_db_name: "{{ service.db_name }}"
    matrix_db_user: "{{ service.db_user }}"
    matrix_db_password: "{{ service.db_password }}"
{% endif %}
{% if service.name == 'tor' %}
    # Tor hidden service settings
    tor_onion_services: {% for onion in service.onion_services %}{{ loop.index > 1 | ternary(', ', '') }}{{ onion }}{% endfor %}
{% endif %}
{% if service.name == 'mail' %}
    # Mail service (Dovecot/Postfix) configuration
    mail_domain: "{{ service.domain }}"
    mail_admin_email: "{{ service.admin_email }}"
    mail_smtp_relay: "{{ service.smtp_relay }}"
    mail_smtp_port: {{ service.smtp_port }}
    mail_smtp_user: "{{ service.smtp_user }}"
    mail_smtp_password: "{{ service.smtp_password }}"
{% endif %}
{% if service.name == 'xmpp' %}
    # Jabber/XMPP service (Prosody) configuration
    xmpp_domain: "{{ service.domain }}"
    xmpp_admin_jid: "{{ service.admin_jid }}"
{% endif %}
{% if service.name == 'print' %}
    # CUPS print server configuration
    cups_browsing: {{ service.cups_browsing }}
{% endif %}
{% if service.name == 'mediawiki' %}
    # MediaWiki service configuration
    mediawiki_domain: "{{ service.domain }}"
    mediawiki_admin_user: "{{ service.admin_user }}"
    mediawiki_admin_password: "{{ service.admin_password }}"
{% endif %}
{% if service.name == 'git' %}
    # Git service (Gitea) configuration
    git_domain: "{{ service.domain }}"
    git_admin_user: "{{ service.admin_user }}"
    git_admin_password: "{{ service.admin_password }}"
{% endif %}
{% if service.name == 'blog' %}
    # Blog service (WordPress) configuration
    blog_domain: "{{ service.domain }}"
    blog_admin_user: "{{ service.admin_user }}"
    blog_admin_password: "{{ service.admin_password }}"
{% endif %}
{% if service.name == 'notes' %}
    # Notes service (Joplin Server) configuration
    notes_domain: "{{ service.domain }}"
    notes_admin_user: "{{ service.admin_user }}"
    notes_admin_password: "{{ service.admin_password }}"
{% endif %}
{% if service.name == 'feeds' %}
    # RSS/Atom feeds aggregator (Ttrss or Miniflux) configuration
    feeds_domain: "{{ service.domain }}"
    feeds_admin_user: "{{ service.admin_user }}"
    feeds_admin_password: "{{ service.admin_password }}"
{% endif %}
{% if service.name == 'bookmarks' %}
    # Bookmarks manager (Shaarli) configuration
    bookmarks_domain: "{{ service.domain }}"
    bookmarks_admin_user: "{{ service.admin_user }}"
    bookmarks_admin_password: "{{ service.admin_password }}"
{% endif %}
{% if service.name == 'calendar' %}
    # Calendar/contacts (Radicale) configuration
    calendar_domain: "{{ service.domain }}"
    calendar_admin_user: "{{ service.admin_user }}"
{% endif %}
{% if service.name == 'disk_usage_monitor' %}
    # Disk usage alerting thresholds (in percent)
    disk_usage_warning_percent: {{ service.warning_percent }}
    disk_usage_critical_percent: {{ service.critical_percent }}
{% endif %}
{% endif %}{# service.enabled #}
{% endfor %}

# Reverse proxy settings for HTTPS termination (via Apache/Nginx)
reverse_proxy:
  enabled: {{ reverse_proxy.enabled }}
  backend_port: {{ reverse_proxy.backend_port }}
  ssl_cert_path: "{{ reverse_proxy.ssl_cert_path }}"
  ssl_key_path: "{{ reverse_proxy.ssl_key_path }}"

# Backup configuration
backup:
  enabled: {{ backup.enabled }}
  destination: "{{ backup.destination }}"
  schedule: "{{ backup.schedule }}"
  retention_days: {{ backup.retention_days }}
  exclude_patterns: [{% for pattern in backup.exclude_patterns %}{{ loop.index > 1 | ternary(', ', '') }}"{{ pattern }}"{% endfor %}]
