{
  "enable_web_interface": true,
  "hostname": "home.example.com",
  "interface": "eth0",
  "port": 80,
  "timezone": "America/New_York",
  "automatic_security_updates": true,
  "services": [
    {
      "name": "nextcloud",
      "enabled": true,
      "admin_user": "admin",
      "admin_password": "SecurePass123!",
      "data_directory": "/var/lib/nextcloud",
      "domain": "cloud.home.example.com",
      "database_type": "sqlite"
    },
    {
      "name": "matrix",
      "enabled": true,
      "domain": "chat.home.example.com",
      "admin_user": "admin",
      "admin_password": "MatrixPass456!",
      "database_type": "postgres",
      "db_host": "localhost",
      "db_name": "synapse",
      "db_user": "synapse",
      "db_password": "SynapsePass789!"
    },
    {
      "name": "mail",
      "enabled": true,
      "domain": "mail.home.example.com",
      "admin_email": "admin@home.example.com",
      "smtp_relay": "smtp-relay.gmail.com",
      "smtp_port": 587,
      "smtp_user": "myuser@gmail.com",
      "smtp_password": "AppPass12345!"
    },
    {
      "name": "disk_usage_monitor",
      "enabled": true,
      "warning_percent": 80,
      "critical_percent": 90
    }
  ],
  "reverse_proxy": {
    "enabled": true,
    "backend_port": 80,
    "ssl_cert_path": "/etc/ssl/certs/freedombox.crt",
    "ssl_key_path": "/etc/ssl/private/freedombox.key"
  },
  "backup": {
    "enabled": true,
    "destination": "/mnt/backup/freedombox",
    "schedule": "30 1 * * *",
    "retention_days": 14,
    "exclude_patterns": [
      "*.log",
      "*/cache/*",
      "*/.cache/*"
    ]
  }
}
