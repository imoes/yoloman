{
  "ikev2_psk_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable global Pre-Shared Key (PSK) authentication."
  },
  "psk_secret": {
    "type": "string",
    "default": "",
    "description": "Shared secret for PSK authentication. Required if PSK is enabled."
  },
  "ikev2_cert_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable certificate-based authentication."
  },
  "local_cert_path": {
    "type": "string",
    "default": "/etc/ssl/iked/local-cert.pem",
    "description": "Path to the local IKE certificate (PEM format)."
  },
  "local_key_path": {
    "type": "string",
    "default": "/etc/ssl/iked/local-key.pem",
    "description": "Path to the local IKE private key (optional if embedded in cert)."
  },
  "ca_cert_path": {
    "type": "string",
    "default": "/etc/ssl/iked/ca-cert.pem",
    "description": "Path to the CA certificate used to verify peer certificates."
  },
  "ikev2_dpd_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable Dead Peer Detection (DPD) to detect failed peers."
  },
  "dpd_delay": {
    "type": "number",
    "default": 10,
    "description": "Interval (in seconds) between DPD checks."
  },
  "dpd_maxfail": {
    "type": "number",
    "default": 5,
    "description": "Number of failed DPD probes before the peer is declared dead."
  },
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Logging verbosity level."
  },
  "ikev2_debug": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose debugging output (use only when troubleshooting)."
  },
  "peers": {
    "type": "list",
    "default": [],
    "description": "List of IKEv2 peers (site-to-site or client endpoints).",
    "items": {
      "name": {
        "type": "string",
        "default": "",
        "description": "Peer label (human-readable identifier)."
      },
      "address": {
        "type": "string",
        "default": "",
        "description": "Peer IP address or FQDN."
      },
      "psk": {
        "type": "string",
        "default": "",
        "description": "Per-peer PSK (overrides global PSK if set)."
      },
      "cert_subject": {
        "type": "string",
        "default": "",
        "description": "X.509 certificate subject (CN) to match for peer identification."
      },
      "ike_phase1_algo": {
        "type": "list",
        "default": [
          "aes-gcm-256",
          "sha256",
          "curve25519"
        ],
        "description": "Phase 1 (IKE) algorithms: encryption, integrity, DH group.",
        "items": {
          "type": "string",
          "enum": [
            "aes-gcm-128",
            "aes-gcm-256",
            "aes-cbc",
            "3des",
            "chacha20-poly1305",
            "sha256",
            "sha384",
            "sha512",
            "curve25519",
            "curve448",
            "modp2048",
            "modp4096"
          ]
        }
      },
      "esp_phase2_algo": {
        "type": "list",
        "default": [
          "aes-gcm-256",
          "sha256"
        ],
        "description": "Phase 2 (IPsec ESP) algorithms: encryption, integrity.",
        "items": {
          "type": "string",
          "enum": [
            "aes-gcm-128",
            "aes-gcm-256",
            "aes-cbc",
            "3des",
            "chacha20-poly1305",
            "sha256",
            "sha384",
            "sha512",
            "none"
          ]
        }
      },
      "local_subnet": {
        "type": "string",
        "default": "10.0.0.0/24",
        "description": "Local network subnet (for site-to-site)."
      },
      "remote_subnets": {
        "type": "list",
        "default": [
          "192.168.1.0/24"
        ],
        "description": "List of remote subnets behind the peer.",
        "items": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/\\d+$"
        }
      },
      "pfs_group": {
        "type": "string",
        "default": "modp2048",
        "enum": [
          "modp1024",
          "modp2048",
          "modp4096",
          "modp8192",
          "curve25519",
          "curve448"
        ],
        "description": "Perfect Forward Secrecy (PFS) DH group for Phase 2."
      },
      "keepalive": {
        "type": "bool",
        "default": true,
        "description": "Send IKEv2 informational exchanges to keep the SA alive."
      }
    }
  },
  "ikev2_mobike_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable Mobile IKE (MOBIKE) for handling changing IP addresses."
  },
  "ikev2_pool_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable virtual IP pool for roadwarrior (IKEv2 client) support."
  },
  "pool_name": {
    "type": "string",
    "default": "clients",
    "description": "Name of the virtual IP pool."
  },
  "pool_subnets": {
    "type": "list",
    "default": [
      "10.0.1.0/24"
    ],
    "description": "CIDR subnets from which to assign virtual IPs to clients.",
    "items": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/\\d+$"
    }
  },
  "pool_dns": {
    "type": "string",
    "default": "10.0.0.1",
    "description": "DNS server(s) pushed to clients (comma-separated if multiple)."
  },
  "pool_domain": {
    "type": "string",
    "default": "vpn.example.com",
    "description": "Search domain to push to clients."
  },
  "ikev2_proposals": {
    "type": "list",
    "default": [],
    "description": "Optional explicit Phase 1 & 2 proposal blocks (for legacy or fine-grained control).",
    "items": {
      "name": {
        "type": "string",
        "default": "",
        "description": "Proposal block name."
      },
      "ike_algo": {
        "type": "list",
        "default": [],
        "description": "IKE Phase 1 algorithms (encryption,integrity,DH).",
        "items": {
          "type": "string",
          "enum": [
            "aes-gcm-128",
            "aes-gcm-256",
            "aes-cbc",
            "3des",
            "chacha20-poly1305",
            "sha256",
            "sha384",
            "sha512",
            "curve25519",
            "curve448",
            "modp2048",
            "modp4096"
          ]
        }
      },
      "esp_algo": {
        "type": "list",
        "default": [],
        "description": "ESP Phase 2 algorithms (encryption,integrity).",
        "items": {
          "type": "string",
          "enum": [
            "aes-gcm-128",
            "aes-gcm-256",
            "aes-cbc",
            "3des",
            "chacha20-poly1305",
            "sha256",
            "sha384",
            "sha512",
            "none"
          ]
        }
      }
    }
  }
}
