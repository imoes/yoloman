{
 "database": {
  "dsn": "",
  "rrd_dir": "/var/lib/cricket/rrd",
  "rrd_step": 300,
  "table_prefix": "",
  "type": "rrd"
 },
 "hosts": [
  {
   "community": "private",
   "hostname": "router1.example.com",
   "targets": [
    {
     "description": "WAN interface",
     "ds_type": "gauge",
     "ifDescr": "eth0",
     "name": "wan0",
     "thresholds": {
      "critical": 95000,
      "warning": 80000
     },
     "type": "ifDescr"
    },
    {
     "description": "CPU usage (percent)",
     "ds_type": "gauge",
     "name": "CPU",
     "oid": "1.3.6.1.4.1.9.9.109.1.1.1.1.5.1",
     "thresholds": {
      "critical": 90,
      "warning": 70
     },
     "type": "custom"
    }
   ],
   "version": 2
  },
  {
   "auth_passphrase": "secureauth",
   "auth_protocol": "SHA",
   "hostname": "switch1.example.com",
   "priv_passphrase": "securepriv",
   "priv_protocol": "AES",
   "security_level": "authPriv",
   "targets": [
    {
     "description": "Port Gi1/0/1 in/out octets",
     "ds_type": "counter",
     "ifDescr": "GigabitEthernet1/0/1",
     "name": "Gi1/0/1",
     "type": "ifDescr"
    }
   ],
   "version": 3
  }
 ],
 "log_file": "/var/log/cricket.log",
 "max_snmp_queries": 100,
 "poll_interval": 300,
 "snmp_retries": 2,
 "snmp_timeout": 3,
 "thresholds": {
  "critical_percent": 90,
  "warning_percent": 70,
  "window": 300
 },
 "verbose_logging": false,
 "web": {
  "base_url": "/",
  "bind_address": "0.0.0.0",
  "port": 8080,
  "tls_cert_file": "",
  "tls_enabled": false,
  "tls_key_file": ""
 },
 "worker_threads": 8
}
