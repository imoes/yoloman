# ==============================================================================
# Liquid Prompt Configuration Template
# Generated for Ansible role management
# ==============================================================================
#
# This file configures `liquidprompt`, a highly customizable prompt for Bash and Zsh.
# All variables are drawn from the Ansible inventory or role defaults.
# If a variable is not provided, safe defaults are applied automatically.
#
# See the liquidprompt documentation for more details:
# https://liquidprompt.readthedocs.io/
# ==============================================================================

# --------------------------------------------------------------------------
# Service Identification
# --------------------------------------------------------------------------
# The name of the service/package being configured.
# Used for identification and logging purposes if necessary.
#
# Schema Field: service_name
# Default: 'liquidprompt'
# --------------------------------------------------------------------------
# LP_SERVICE_NAME='{{ service_name | default('liquidprompt') }}'


# --------------------------------------------------------------------------
# Shell Compatibility Flags
# --------------------------------------------------------------------------
# Liquid Prompt detects the shell automatically, but you can force specific
# modes here if auto-detection fails or for clarity.
#
# Schema Field: shell
# Default: 'bash'
# Allowed values: 'bash', 'zsh'
# --------------------------------------------------------------------------
{% set shell_val = shell | default('bash') %}

# Force Liquid Prompt to assume it is being used with Bash.
# See: https://liquidprompt.readthedocs.io/en/stable/compatibility.html
{% if shell_val == 'bash' %}
LP_USE_BASH=1
{% endif %}

# Force Liquid Prompt to assume it is being used with Zsh.
# See: https://liquidprompt.readthedocs.io/en/stable/compatibility.html
{% if shell_val == 'zsh' %}
LP_USE_ZSH=1
{% endif %}


# --------------------------------------------------------------------------
# Prompt Appearance: End Character
# --------------------------------------------------------------------------
# The character string displayed at the very end of the prompt.
# Common choices include '❯', '>', '➜', or ':'.
#
# Schema Field: lp_end_of_prompt
# Default: '❯'
# --------------------------------------------------------------------------
LP_END_OF_PROMPT='{{ lp_end_of_prompt | default('❯') }}'


# --------------------------------------------------------------------------
# Prompt Appearance: Color Scheme
# --------------------------------------------------------------------------
# The color scheme for the prompt.
# - 'auto': Detects if the terminal supports color and uses a suitable theme.
# - 'dark': Forces a theme optimized for dark backgrounds.
# - 'light': Forces a theme optimized for light backgrounds.
# - 'none': Disables all color coding (plain text).
#
# Schema Field: lp_color
# Default: 'auto'
# Allowed values: 'auto', 'dark', 'light', 'none'
# --------------------------------------------------------------------------
LP_COLOR='{{ lp_color | default('auto') }}'


# --------------------------------------------------------------------------
# Prompt Appearance: Segment Separator
# --------------------------------------------------------------------------
# The text or character used to separate different segments of the prompt.
# Common choices include ' | ', '/', '·', or '›'.
#
# Schema Field: lp_separator
# Default: ' | '
# --------------------------------------------------------------------------
LP_SEPARATOR='{{ lp_separator | default(' | ') }}'


# --------------------------------------------------------------------------
# Prompt Content: VCS Status
# --------------------------------------------------------------------------
# Boolean flag to enable showing Git/SVN status indicators in the prompt.
# When enabled, the prompt may show dirty state, staged changes, etc.
#
# Schema Field: lp_vcs_show_status
# Default: True
# --------------------------------------------------------------------------
LP_VCS_SHOW_STATUS='{{ lp_vcs_show_status | default(true) | lower }}'


# --------------------------------------------------------------------------
# Prompt Content: User@Host Width
# --------------------------------------------------------------------------
# The maximum width of the user@host segment.
# If the user@host string exceeds this width, it will be truncated.
# Set to 0 to disable truncation.
#
# Schema Field: lp_user_host_width
# Default: 20
# --------------------------------------------------------------------------
LP_USER_HOST_WIDTH='{{ lp_user_host_width | default(20) }}'


# --------------------------------------------------------------------------
# Prompt Content: Current Working Directory
# --------------------------------------------------------------------------
# Boolean flag to enable displaying the current working directory.
# If disabled, the directory segment will not appear in the prompt.
#
# Schema Field: lp_show_pwd
# Default: True
# --------------------------------------------------------------------------
LP_SHOW_PWD='{{ lp_show_pwd | default(true) | lower }}'


# --------------------------------------------------------------------------
# Prompt Content: VCS Branch Name
# --------------------------------------------------------------------------
# Boolean flag to enable displaying the VCS (Git/SVN) branch name.
# When enabled, the current branch name is shown inside the prompt.
#
# Schema Field: lp_vcs_branch
# Default: True
# --------------------------------------------------------------------------
LP_VCS_BRANCH='{{ lp_vcs_branch | default(true) | lower }}'