# =============================================================================
# MangoHud Global Configuration
# =============================================================================
# This configuration file controls the global behavior of the MangoHud overlay.
# See https://github.com/flightlessmango/MangoHud for full documentation.
# =============================================================================

# --- Global Settings ---

# Global toggle to enable or disable MangoHud overlay.
enabled = {{ enabled | default(false) }}

# --- Displayed Metrics ---

# Display FPS counter.
fps = {{ fps | default(true) }}

# Display CPU usage percentage.
cpu_usage = {{ cpu_usage | default(true) }}

# Display GPU usage percentage.
gpu_usage = {{ gpu_usage | default(true) }}

# Display system RAM usage.
ram_usage = {{ ram_usage | default(true) }}

# Display CPU/GPU temperatures.
temperature = {{ temperature | default(true) }}

# Display Vsync status.
vsync = {{ vsync | default(false) }}

# Display frame timing graph.
frame_timing = {{ frame_timing | default(false) }}

# Display GPU core clock frequency.
gpu_clock = {{ gpu_clock | default(true) }}

# Display CPU core clock frequency.
cpu_clock = {{ cpu_clock | default(false) }}

# --- Appearance ---

# Font size for the overlay text in pixels.
font_size = {{ font_size | default(12) }}

# Text color in hex format (RGB).
font_color = {{ font_color | default("ffffff") }}

# Background color in hex format (RGB).
background_color = {{ background_color | default("000000") }}

# Position of the overlay on screen.
position = {{ position | default("bottom-right") }}

# --- Advanced Settings ---

# Path to a preset configuration file.
preset_file = {{ preset_file | default("") }}

# Enable logging performance data to a file.
log_file = {{ log_file | default(false) }}

# File path to write log data.
log_path = {{ log_path | default("") }}

# Enable D-Bus integration for media keybindings.
dbus = {{ dbus | default(true) }}

# Enable NVIDIA NVML support for metrics.
nvml = {{ nvml | default(true) }}

# Enable X11 NVControl support for older NVIDIA GPUs.
xnvctrl = {{ xnvctrl | default(true) }}

# Enable Wayland support for keybindings and metrics.
wayland = {{ wayland | default(true) }}

# Enable X11 support for keybindings.
x11 = {{ x11 | default(true) }}

# Comma-separated configuration overrides (e.g., gpu_stats=0,font_size=12).
config_string = {{ config_string | default("") }}