{
  "enabled": {
    "type": "bool",
    "default": false,
    "description": "Global toggle to enable or disable MangoHud overlay."
  },
  "fps": {
    "type": "bool",
    "default": true,
    "description": "Display FPS counter."
  },
  "cpu_usage": {
    "type": "bool",
    "default": true,
    "description": "Display CPU usage percentage."
  },
  "gpu_usage": {
    "type": "bool",
    "default": true,
    "description": "Display GPU usage percentage."
  },
  "ram_usage": {
    "type": "bool",
    "default": true,
    "description": "Display system RAM usage."
  },
  "temperature": {
    "type": "bool",
    "default": true,
    "description": "Display CPU/GPU temperatures."
  },
  "vsync": {
    "type": "bool",
    "default": false,
    "description": "Display Vsync status."
  },
  "frame_timing": {
    "type": "bool",
    "default": false,
    "description": "Display frame timing graph."
  },
  "gpu_clock": {
    "type": "bool",
    "default": true,
    "description": "Display GPU core clock frequency."
  },
  "cpu_clock": {
    "type": "bool",
    "default": false,
    "description": "Display CPU core clock frequency."
  },
  "font_size": {
    "type": "number",
    "default": 12,
    "description": "Font size for the overlay text in pixels."
  },
  "font_color": {
    "type": "string",
    "default": "ffffff",
    "description": "Text color in hex format (RGB)."
  },
  "background_color": {
    "type": "string",
    "default": "000000",
    "description": "Background color in hex format (RGB)."
  },
  "position": {
    "type": "string",
    "default": "bottom-right",
    "description": "Position of the overlay on screen."
  },
  "preset_file": {
    "type": "string",
    "default": "",
    "description": "Path to a preset configuration file."
  },
  "log_file": {
    "type": "bool",
    "default": false,
    "description": "Enable logging performance data to a file."
  },
  "log_path": {
    "type": "string",
    "default": "",
    "description": "File path to write log data."
  },
  "dbus": {
    "type": "bool",
    "default": true,
    "description": "Enable D-Bus integration for media keybindings."
  },
  "nvml": {
    "type": "bool",
    "default": true,
    "description": "Enable NVIDIA NVML support for metrics."
  },
  "xnvctrl": {
    "type": "bool",
    "default": true,
    "description": "Enable X11 NVControl support for older NVIDIA GPUs."
  },
  "wayland": {
    "type": "bool",
    "default": true,
    "description": "Enable Wayland support for keybindings and metrics."
  },
  "x11": {
    "type": "bool",
    "default": true,
    "description": "Enable X11 support for keybindings."
  },
  "config_string": {
    "type": "string",
    "default": "",
    "description": "Comma-separated configuration overrides (e.g., gpu_stats=0,font_size=12). Takes priority over file settings."
  }
}
