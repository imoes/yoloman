# clatd(8) configuration file
# This file configures clatd (Client-side Translator for IPv6 to IPv4).
# It controls the TUN interface, routing, DNS64/PREF64 behavior, and IPv4 connectivity checks.
# For per-interface configurations, use /etc/clatd/INTERFACE.conf.

### Network device control
# Tun interface name. Defaults to 'tun0' if left empty or unspecified.
# Schema: tun_name (str, default='tun0')
{% if tun_name is defined and tun_name is not none and (tun_name is number or tun_name is boolean or tun_name | length > 0) %}clat-dev={{ tun_name | default('tun0') }}{% else %}# clat-dev=clat			# TUN interface name to use{% endif %}

# PLAT-facing network device (e.g., eth0). If empty, clatd attempts auto-detection.
# Schema: plat_dev (str, default='')
{% if plat_dev is defined and plat_dev is not none and (plat_dev is number or plat_dev is boolean or plat_dev | length > 0) %}plat-dev={{ plat_dev | default('') }}{% else %}# plat-dev=			# PLAT-facing device. Detected if unset.{% endif %}

### IPv4 connectivity check parameters
# If enabled (1), clatd exits if an IPv4 default route already exists to prevent conflicts.
# 0=disabled, 1=enabled.
# Schema: v4_conncheck_enable (int, default=1)
{% if v4_conncheck_enable is defined and v4_conncheck_enable is not none and (v4_conncheck_enable is number or v4_conncheck_enable is boolean or v4_conncheck_enable | length > 0) %}v4-conncheck-enable={{ v4_conncheck_enable | default(1) }}{% else %}# v4-conncheck-enable=1		# exit if there's already a defroute{% endif %}

# Delay in seconds before performing the IPv4 connectivity check.
# Schema: v4_conncheck_delay (int, default=10)
{% if v4_conncheck_delay is defined and v4_conncheck_delay is not none and (v4_conncheck_delay is number or v4_conncheck_delay is boolean or v4_conncheck_delay | length > 0) %}v4-conncheck-delay={{ v4_conncheck_delay | default(10) }}{% else %}# v4-conncheck-delay=10		# seconds before checking for v4 conn.{% endif %}

### Kernel IPv6 forwarding settings
# Enable kernel IPv6 forwarding required for CLAT operation.
# 0=disabled, 1=enabled.
# Schema: forwarding_enable (int, default=1)
{% if forwarding_enable is defined and forwarding_enable is not none and (forwarding_enable is number or forwarding_enable is boolean or forwarding_enable | length > 0) %}forwarding-enable={{ forwarding_enable | default(1) }}{% else %}# forwarding-enable=1		# enable ipv6 forwarding?{% endif %}

### Addressing configuration
# IPv4 address to assign to the internal CLAT interface.
# Must be within 192.0.0.0/24 per RFC 6877.
# Schema: clat_ipv4 (str, default='192.0.0.1')
{% if clat_ipv4 is defined and clat_ipv4 is not none and (clat_ipv4 is number or clat_ipv4 is boolean or clat_ipv4 | length > 0) %}clat-v4-addr={{ clat_ipv4 | default('192.0.0.1') }}{% else %}# clat-v4-addr=192.0.0.1	# from RFC 7335{% endif %}

# IPv4 address for the ER (External Router) internal-facing interface.
# Used for downstream IPv4 clients.
# Schema: er_ipv4_int (str, default='192.0.0.2')
{% if er_ipv4_int is defined and er_ipv4_int is not none and (er_ipv4_int is number or er_ipv4_int is boolean or er_ipv4_int | length > 0) %}tayga-v4-addr={{ er_ipv4_int | default('192.0.0.2') }}{% else %}# tayga-v4-addr=192.0.0.2	# from RFC 7335{% endif %}

# clat-v6-addr=shared
# route-table=0xc1a7

### PLAT prefix and DNS64 configuration
# List of custom DNS server addresses (IPv4 or IPv6) to override system defaults.
# If empty, the system resolver's DNS servers are used.
# Schema: dns_servers (list, default=[])
{% if dns_servers is defined and dns_servers is not none and (dns_servers is number or dns_servers is boolean or dns_servers | length > 0) %}dns64-servers={{ dns_servers | default([]) | join(' ') }}{% else %}# dns64-servers=		# system resolver by default{% endif %}

# plat-prefix=
# plat-fallback-prefix=

### IPv4 default route parameters
# v4-defaultroute-enable=1
# v4-defaultroute-replace=0
# v4-defaultroute-metric=2048

# MTU for the IPv4 default route.
# 0 means auto-detect (recommended).
# Schema: mtu (int, default=0)
{% if mtu is defined and mtu is not none and (mtu is number or mtu is boolean or mtu | length > 0) %}v4-defaultroute-mtu={{ mtu | default(0) }}{% else %}# v4-defaultroute-mtu=1260	# MTU for the IPv4 defaultroute{% endif %}

# v4-defaultroute-advmss=0

### Script hooks
# script-up=
# script-down=

### Logging configuration
# quiet=0
{% if loglevel is defined and loglevel is not none and (loglevel is number or loglevel is boolean or loglevel | length > 0) %}debug={{ loglevel | default(0) }}
{% else %}# debug=0			# debugging output level
{% endif %}# Note: loglevel is passed via CLI arguments to the service,
# not directly configured in this specific config file section.
# 0=error, 1=warn, 2=info, 3=debug, 4=trace.
# Schema: loglevel (int, default=0)
{% if loglevel is defined and loglevel is not none and (loglevel is number or loglevel is boolean or loglevel | length > 0) %}debug={{ loglevel | default(0) }}{% else %}# debug=0			# debugging output level{% endif %}

### Override implementation details
# ctmark=
# proxynd-enable=

### Override conffile
# tayga-conffile=

### Override commands
# cmd-ip=ip
# cmd-networkctl=networkctl
# cmd-nft=nft
# cmd-tayga=tayga
# cmd-ufw=ufw
