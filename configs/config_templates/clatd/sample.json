{
  "mode": "clat",
  "pidfile": "/run/clatd/clatd.pid",
  "loglevel": 2,
  "clat_ipv4": "192.0.0.2",
  "br_ipv6": "2001:db8:1::100",
  "er_ipv4_prefix": "",
  "er_ipv6_ext": "",
  "er_ipv4_int": "",
  "mtu": 0,
  "dns_suffix": "v4v6.example.org",
  "dns_servers": [
    "2001:db8::53",
    "192.0.2.53"
  ],
  "search_domains": [
    "home.lan",
    "office.example.org"
  ],
  "rate_limit_pps": 1000,
  "strict_mode": true,
  "tun_name": "clat0",
  "run_as_user": "clatd",
  "run_as_group": "clatd",
  "extra_syscalls": [
    "socket",
    "bind",
    "connect",
    "sendto",
    "recvfrom",
    "setsockopt",
    "getsockopt",
    "close"
  ]
}
