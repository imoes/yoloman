# ==============================================================================
# prometheus-nextcloud-exporter configuration template
# ==============================================================================
# This file configures the Prometheus exporter for Nextcloud.
# It uses YAML format.
# ==============================================================================

# -----------------------------------------------------------------------------
# Nextcloud Server Connection Settings
# -----------------------------------------------------------------------------

# URL to the Nextcloud server instance.
# Schema: nextcloud_server_url (default: 'https://cloud.example.org')
server: "{{ nextcloud_server_url | default('https://cloud.example.org') }}"

# Authentication Token (Optional)
# -----------------------------------------------------------------------------
# If using token authentication instead of username/password, uncomment and set below.
# The token can also be read from a file by prefixing with '@'.
# Example: authToken: "my-secret-token"
# Example: authToken: @/path/to/tokenfile
# authToken: ""

# Username for Nextcloud API authentication.
# Schema: nextcloud_username (default: 'example')
# Note: Required if not using authToken.
username: "{{ nextcloud_username | default('example') }}"

# Password for Nextcloud API authentication.
# Schema: nextcloud_password (default: 'example')
# Note: Required if not using authToken.
# The password can also be read from a file by prefixing with '@'.
# Example: password: "my-secret-password"
# Example: password: @/path/to/passwordfile
password: "{{ nextcloud_password | default('example') }}"

# -----------------------------------------------------------------------------
# Exporter Network & Timeout Settings
# -----------------------------------------------------------------------------

# Address and port for the Prometheus exporter to listen on.
# Schema: exporter_listen_address (default: ':9205')
listenAddress: "{{ exporter_listen_address | default(':9205') }}"

# Timeout for HTTP requests to the Nextcloud server.
# Schema: exporter_timeout (default: '5s')
timeout: "{{ exporter_timeout | default('5s') }}"

# Skip TLS certificate verification when connecting to Nextcloud.
# Schema: exporter_tls_skip_verify (default: False)
# Set to true if using self-signed certificates or for testing environments.
tlsSkipVerify: {{ exporter_tls_skip_verify | default(false) | lower }}

# -----------------------------------------------------------------------------
# Metrics Collection Options
# -----------------------------------------------------------------------------

# info:
  # Enable gathering of apps-related metrics.
  # Schema: exporter_info_apps_enabled (default: False)
  # When enabled, metrics about installed Nextcloud apps are collected.
  apps: {{ exporter_info_apps_enabled | default(false) | lower }}

  # Enable gathering of system update-related metrics.
  # Schema: exporter_info_update_enabled (default: False)
  # When enabled, metrics regarding system updates are collected.
  update: {{ exporter_info_update_enabled | default(false) | lower }}
