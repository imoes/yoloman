{
  "forwarders": [
    "8.8.8.8",
    "8.8.4.4"
  ],
  "dnssec_enabled": true,
  "dns_port": 53,
  "listen_on": [
    "127.0.0.1",
    "10.0.0.1"
  ],
  "listen_on_v6": [
    "::1",
    "fd00::1"
  ],
  "allow_query": [
    "any"
  ],
  "allow_transfer": [
    "none"
  ],
  "recursion_enabled": true,
  "max_cache_size": "512M",
  "ratelimit_enabled": true,
  "ratelimit_rps": 10,
  "ratelimit_window": 60,
  "edns_enabled": true,
  "working_dir": "/var/cache/bind",
  "pid_file": "/run/named/named.pid"
}
