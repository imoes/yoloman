# field value.  Trailing spaces are prohibited.


##NAME: LOCATION:0
#
# Path to SQLite database file.
# You must create this database beforehand, and create
# the users table, as defined below.

SQLITE_DATABASE		{{ sqlite_database | default('/var/lib/courier/users.db') }}

##NAME: SQLITE_USER_TABLE:0
#
# Name of the user table in the SQLite database.
#
# Suggested format of the table specified by SQLITE_USER_TABLE:
#
# CREATE TABLE passwd (
#        id                    text not null primary key,
#        crypt                 text,   # Either...
#        clear                 text,   # ...
#        name                  text,
#        uid                   int,
#        gid                   int,
#        home                  text not null,
#        maildir               text,
#        defaultdelivery       text,
#        quota                 text,
#        options               text);
#
# Use either crypt or clear, to specify whether cleartext or crypted passwords
# get used (and define either SQLITE_CRYPT_PWFIELD or SQLITE_CLEAR_PWFIELD,
# below, accordingly).

SQLITE_USER_TABLE	{{ sqlite_user_table | default('passwd') }}

##NAME: SQLITE_CRYPT_PWFIELD:0
#
# Field name for encrypted passwords in the user table.
# Either SQLITE_CRYPT_PWFIELD or SQLITE_CLEAR_PWFIELD must be defined.  Both
# are OK too. crypted passwords go into SQLITE_CRYPT_PWFIELD, cleartext
# passwords go into SQLITE_CLEAR_PWFIELD.  Cleartext passwords allow
# CRAM-MD5 authentication to be implemented.

SQLITE_CRYPT_PWFIELD	{{ sqlite_crypt_pwfield | default('crypt') }}

##NAME: SQLITE_CLEAR_PWFIELD:0
#
# Field name for cleartext passwords in the user table.

{% if sqlite_clear_pwfield is defined and sqlite_clear_pwfield is not none and (sqlite_clear_pwfield is number or sqlite_clear_pwfield is boolean or sqlite_clear_pwfield | length > 0) %}SQLITE_CLEAR_PWFIELD	{{ sqlite_clear_pwfield | default('clear') }}{% else %}# SQLITE_CLEAR_PWFIELD	clear{% endif %}

##NAME: SQLITE_DEFAULT_DOMAIN:0
#
# Default domain to append to usernames if no domain is provided.
# If DEFAULT_DOMAIN is defined, and someone tries to log in as 'user',
# we will search for 'user@DEFAULT_DOMAIN' instead.

SQLITE_DEFAULT_DOMAIN	{{ sqlite_default_domain | default('') }}

##NAME: SQLITE_UID_FIELD:0
#
# Field name for user ID in the user table.
# Other fields in the sqlite table:
# SQLITE_UID_FIELD - contains the numerical userid of the account

SQLITE_UID_FIELD		{{ sqlite_uid_field | default('uid') }}

##NAME: SQLITE_GID_FIELD:0
#
# Field name for group ID in the user table.
# Numerical groupid of the account

SQLITE_GID_FIELD	{{ sqlite_gid_field | default('	gid') }}

##NAME: SQLITE_LOGIN_FIELD:0
#
# Field name used as the login identifier.
# The login id, default is id.  Basically the query is:
#
#  SELECT SQLITE_UID_FIELD, SQLITE_GID_FIELD, ... WHERE id='loginid'

SQLITE_LOGIN_FIELD	{{ sqlite_login_field | default('id') }}

##NAME: SQLITE_HOME_FIELD:0
#
# Field name for user's home directory.

SQLITE_HOME_FIELD	{{ sqlite_home_field | default('home') }}

##NAME: SQLITE_NAME_FIELD:0
#
# Field name for user's full name.
# The user's name (optional)

SQLITE_NAME_FIELD	{{ sqlite_name_field | default('name') }}

##NAME: SQLITE_MAILDIR_FIELD:0
#
# Field name for maildir path.
# This is an optional field, and can be used to specify an arbitrary
# location of the maildir for the account, which normally defaults to
# $HOME/Maildir (where $HOME is read from SQLITE_HOME_FIELD).
#
# You still need to provide a SQLITE_HOME_FIELD, even if you uncomment this
# out.

{% if sqlite_maildir_field is defined and sqlite_maildir_field is not none and (sqlite_maildir_field is number or sqlite_maildir_field is boolean or sqlite_maildir_field | length > 0) %}SQLITE_MAILDIR_FIELD	{{ sqlite_maildir_field | default('maildir') }}{% else %}# SQLITE_MAILDIR_FIELD	maildir{% endif %}

##NAME: SQLITE_DEFAULTDELIVERY:0
#
# Field name for custom mail delivery instructions.
# Courier mail server only: optional field specifies custom mail delivery
# instructions for this account (if defined) -- essentially overrides
# DEFAULTDELIVERY from ${sysconfdir}/courierd

{% if sqlite_defaultdelivery is defined and sqlite_defaultdelivery is not none and (sqlite_defaultdelivery is number or sqlite_defaultdelivery is boolean or sqlite_defaultdelivery | length > 0) %}SQLITE_DEFAULTDELIVERY	{{ sqlite_defaultdelivery | default('defaultdelivery') }}{% else %}# SQLITE_DEFAULTDELIVERY defaultdelivery{% endif %}

##NAME: SQLITE_QUOTA_FIELD:0
#
# Field name for maildir quota.
# Define SQLITE_QUOTA_FIELD to be the name of the field that can optionally
# specify a maildir quota.  See README.maildirquota for more information

{% if sqlite_quota_field is defined and sqlite_quota_field is not none and (sqlite_quota_field is number or sqlite_quota_field is boolean or sqlite_quota_field | length > 0) %}SQLITE_QUOTA_FIELD	{{ sqlite_quota_field | default('quota') }}{% else %}# SQLITE_QUOTA_FIELD	quota{% endif %}

##NAME: SQLITE_AUXOPTIONS:0
#
# Field name for auxiliary account options.
# Auxiliary options.  The SQLITE_AUXOPTIONS field should be a char field that
# contains a single string consisting of comma-separated "ATTRIBUTE=NAME"
# pairs.  These names are additional attributes that define various per-account
# "options", as given in INSTALL's description of the "Account OPTIONS"
# setting.

SQLITE_AUXOPTIONS_FIELD	{{ sqlite_auxoptions_field | default('options') }}

##NAME: SQLITE_WHERE_CLAUSE:0
#
# Custom WHERE clause to append to authentication queries.
# This is optional, SQLITE_WHERE_CLAUSE can be basically set to an arbitrary
# fixed string that is appended to the WHERE clause of our query

{% if sqlite_where_clause is defined and sqlite_where_clause is not none and (sqlite_where_clause is number or sqlite_where_clause is boolean or sqlite_where_clause | length > 0) %}SQLITE_WHERE_CLAUSE	{{ sqlite_where_clause | default('') }}{% else %}# SQLITE_WHERE_CLAUSE	server='mailhost.example.com'{% endif %}

##NAME: SQLITE_SELECT_CLAUSE:0
#
# Custom SELECT clause for authentication queries (overrides other field mappings if set).
# This is optional, SQLITE_SELECT_CLAUSE can be set when you have a database,
# which is structuraly different from the proposed layout. The fixed string will
# be used to do a SELECT operation on database, which should return fields
# in order specified bellow:
#
# username, cryptpw, clearpw, uid, gid, home, maildir, quota, fullname, options
#
# The username field should include the domain (see example below).
#
# Enabling this option causes ignorance of any other field-related
# options, excluding default domain.
#
# There are two variables, which you can use. Substitution will be made
# for them, so you can put entered username (local part) and domain name
# in the right place of your query. These variables are:
#	 	$(local_part), $(domain), $(service)
#
# If a $(domain) is empty (not given by the remote user) the default domain
# name is used in its place.
#
# $(service) will expand out to the service being authenticated: imap, imaps,
# pop3 or pop3s.  Courier mail server only: service will also expand out to
# "courier", when searching for local mail account's location.  In this case,
# if the "maildir" field is not empty it will be used in place of
# DEFAULTDELIVERY.  Courier mail server will also use esmtp when doing
# authenticated ESMTP.

{% if sqlite_select_clause is defined and sqlite_select_clause is not none and (sqlite_select_clause is number or sqlite_select_clause is boolean or sqlite_select_clause | length > 0) %}SQLITE_SELECT_CLAUSE	{{ sqlite_select_clause | default('') }}{% else %}# SQLITE_SELECT_CLAUSE	SELECT popbox.local_part || '@' || popbox.domain_name,\{% endif %}

##NAME: SQLITE_ENUMERATE_CLAUSE:1
#
# Custom SQL query for enumerating accounts (used by authenumerate).
# Optional custom SQL query used to enumerate accounts for authenumerate,
# in order to compile a list of accounts for shared folders.  The query
# should return the following fields: name, uid, gid, homedir, maildir, options

{% if sqlite_enumerate_clause is defined and sqlite_enumerate_clause is not none and (sqlite_enumerate_clause is number or sqlite_enumerate_clause is boolean or sqlite_enumerate_clause | length > 0) %}SQLITE_ENUMERATE_CLAUSE	{{ sqlite_enumerate_clause | default('') }}{% else %}# SQLITE_ENUMERATE_CLAUSE SELECT popbox.local_part || '@' || popbox.domain_name, \{% endif %}

##NAME: SQLITE_CHPASS_CLAUSE:0
#
# Custom UPDATE clause for password changes.
# This is optional, SQLITE_CHPASS_CLAUSE can be set when you have a database,
# which is structuraly different from proposed. The fixed string will
# be used to do an UPDATE operation on database. In other words, it is
# used, when changing passwords. This is used by sqwebmail/Courier webmail.
#
# There are four variables, which you can use. Substitution will be made
# for them, so you can put entered username (local part) and domain name
# in the right place of your query. There variables are:
# 	$(local_part) , $(domain) , $(newpass) , $(newpass_crypt)
#
# If a $(domain) is empty (not given by the remote user) the default domain
# name is used in its place.
# $(newpass) contains plain password
# $(newpass_crypt) contains its crypted form

{% if sqlite_chpass_clause is defined and sqlite_chpass_clause is not none and (sqlite_chpass_clause is number or sqlite_chpass_clause is boolean or sqlite_chpass_clause | length > 0) %}SQLITE_CHPASS_CLAUSE	{{ sqlite_chpass_clause | default('') }}{% else %}# SQLITE_CHPASS_CLAUSE	UPDATE	popbox					\{% endif %}

##NAME: MARKER:0
