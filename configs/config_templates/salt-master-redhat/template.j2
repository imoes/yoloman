##### Primary configuration settings #####
##########################################
# Per default, the master will automatically include all config files
# from master.d/*.conf (master.d is a directory in the same directory
# as the main master config file).
default_include: {{ default_include | default('master.d/*.conf') }}

# The address of the interface to bind to.
interface: {{ interface | default('0.0.0.0') }}

# Whether the master should listen for IPv6 connections.
ipv6: {{ ipv6 | default('False') }}

# The tcp port used by the publisher.
publish_port: {{ publish_port | default('4505') }}

# The user under which the salt master will run.
user: {{ user | default('root') }}

# Tell the master to also use salt-ssh when running commands against minions.
enable_ssh_minions: {{ enable_ssh_minions | default('False') }}

# The port used by the communication interface (ret port).
ret_port: {{ ret_port | default('4506') }}

# Specify the location of the daemon process ID file.
pidfile: {{ pidfile | default('/var/run/salt-master.pid') }}

# The root directory prepended to these options: pki_dir, cachedir, sock_dir, log_file, autosign_file, autoreject_file, extension_modules, key.
root_dir: {{ root_dir | default('/') }}

# The path to the master's configuration file.
conf_file: {{ conf_file | default('/etc/salt/master') }}

# Directory used to store public key data.
pki_dir: {{ pki_dir | default('/etc/salt/pki/master') }}

# Key cache. Increases master speed for large numbers of accepted keys.
key_cache: {{ key_cache | default('') }}

# Directory to store job and cache data.
cachedir: {{ cachedir | default('/var/cache/salt/master') }}

# Directory for custom modules.
extension_modules: {{ extension_modules | default('/var/cache/salt/master/extmods') }}

# Like 'extension_modules' but can take an array of paths.
module_dirs: {{ module_dirs | default('[]') }}

# Verify and set permissions on configuration directories at startup.
verify_env: {{ verify_env | default('True') }}

# Set the number of hours to keep old job information in the job cache.
keep_jobs: {{ keep_jobs | default('24') }}

# The number of seconds to wait when the client is requesting information about running jobs.
gather_job_timeout: {{ gather_job_timeout | default('10') }}

# Set the default timeout for the salt command and api.
timeout: {{ timeout | default('5') }}

# The loop_interval option controls the seconds for the master's maintenance process check cycle.
loop_interval: {{ loop_interval | default('60') }}

# Set the default outputter used by the salt command.
output: {{ output | default('nested') }}

# Set a list of additional directories to search for salt outputters.
outputter_dirs: {{ outputter_dirs | default('[]') }}

# Set the default output file used by the salt command.
output_file: {{ output_file | default('None') }}

# Return minions that timeout when running commands like test.ping.
show_timeout: {{ show_timeout | default('True') }}

# Tell the client to display the jid when a job is published.
show_jid: {{ show_jid | default('False') }}

# By default, output is colored.
color: {{ color | default('True') }}

# Do not strip off the colored output from nested results and state outputs.
strip_colors: {{ strip_colors | default('False') }}

# To display a summary of the number of minions targeted, the number of minions returned, and the number of minions that did not return.
cli_summary: {{ cli_summary | default('False') }}

# Set the directory used to hold unix sockets.
sock_dir: {{ sock_dir | default('/var/run/salt/master') }}

# Enable if you want to see GPU hardware data for your master.
enable_gpu_grains: {{ enable_gpu_grains | default('False') }}

# The master maintains a job cache.
job_cache: {{ job_cache | default('True') }}

# Cache minion grains, pillar and mine data via the cache subsystem in the cachedir or a database.
minion_data_cache: {{ minion_data_cache | default('True') }}

# Cache subsystem module to use for minion data cache.
cache: {{ cache | default('localfs') }}

# Enables a fast in-memory cache booster and sets the expiration time.
memcache_expire_seconds: {{ memcache_expire_seconds | default('0') }}

# Set a memcache limit in items (bank + key) per cache storage (driver + driver_opts).
memcache_max_items: {{ memcache_max_items | default('1024') }}

# Each time a cache storage got full cleanup all the expired items not just the oldest one.
memcache_full_cleanup: {{ memcache_full_cleanup | default('False') }}

# Enable collecting the memcache stats and log it on `debug` log level.
memcache_debug: {{ memcache_debug | default('False') }}

# Store all returns in the given returner.
event_return: {{ event_return | default('mysql') }}

# On busy systems, enabling event_returns can cause a considerable load on the storage system for returners.
event_return_queue: {{ event_return_queue | default('0') }}

# Setting this to a reasonable value (1-30 seconds) will cause the queue to be flushed when the oldest event is older than `event_return_queue_max_seconds`.
event_return_queue_max_seconds: {{ event_return_queue_max_seconds | default('0') }}

# Passing very large events can cause the minion to consume large amounts of memory.
max_event_size: {{ max_event_size | default('1048576') }}

# Windows platforms lack posix IPC and must rely on slower TCP based inter-process communications.
ipc_mode: {{ ipc_mode | default('ipc') }}

# Overwrite the default tcp ports used by the minion when ipc_mode is set to 'tcp'.
tcp_master_pub_port: {{ tcp_master_pub_port | default('4510') }}

# Overwrite the default tcp ports used by the minion when ipc_mode is set to 'tcp'.
tcp_master_pull_port: {{ tcp_master_pull_port | default('4511') }}

# To tell the master to ping all minions immediately after an AES key refresh.
ping_on_rotate: {{ ping_on_rotate | default('False') }}

# By default, the master deletes its cache of minion data when the key for that minion is removed.
preserve_minion_cache: {{ preserve_minion_cache | default('False') }}

# Allow or deny minions from requesting their own key revocation.
allow_minion_key_revoke: {{ allow_minion_key_revoke | default('True') }}

# If max_minions is used in large installations, the master might experience high-load situations.
con_cache: {{ con_cache | default('False') }}

# The master can include configuration from other files.
include: {{ include | default('/etc/salt/extra_config') }}

# Max open files.
max_open_files: {{ max_open_files | default('100000') }}

# The number of worker threads to start.
worker_threads: {{ worker_threads | default('5') }}

# The listen queue size / backlog.
zmq_backlog: {{ zmq_backlog | default('1000') }}

# The publisher interface ZeroMQPubServerChannel.
pub_hwm: {{ pub_hwm | default('1000') }}

# Value: In bytes. Set to 'dynamic' to have Salt select a value for you. Default is disabled.
ipc_write_buffer: {{ ipc_write_buffer | default('dynamic') }}

# These two batch settings, batch_safe_limit and batch_safe_size, are used to automatically switch to a batch mode execution.
batch_safe_limit: {{ batch_safe_limit | default('100') }}

# These two batch settings, batch_safe_limit and batch_safe_size, are used to automatically switch to a batch mode execution.
batch_safe_size: {{ batch_safe_size | default('8') }}

# Master stats enables stats events to be fired from the master at close to the defined interval.
master_stats: {{ master_stats | default('False') }}

# Master stats enables stats events to be fired from the master at close to the defined interval.
master_stats_event_iter: {{ master_stats_event_iter | default('60') }}


#####        Security settings       #####
##########################################
# Enable passphrase protection of the Master signing_key.
master_sign_pubkey: {{ master_sign_pubkey | default('True') }}

# Enable "open mode", this mode still maintains encryption, but turns off authentication.
open_mode: {{ open_mode | default('False') }}

# Enable auto_accept, this setting will automatically accept all incoming public keys from the minions.
auto_accept: {{ auto_accept | default('False') }}

# The size of key that should be generated when creating new keys.
keysize: {{ keysize | default('2048') }}

# Time in minutes that an incoming public key with a matching name found in pki_dir/minion_autosign/keyid is automatically accepted.
autosign_timeout: {{ autosign_timeout | default('120') }}

# If the autosign_file is specified, incoming keys specified in the autosign_file will be automatically accepted.
autosign_file: {{ autosign_file | default('/etc/salt/autosign.conf') }}

# Works like autosign_file, but instead allows you to specify minion IDs for which keys will automatically be rejected.
autoreject_file: {{ autoreject_file | default('/etc/salt/autoreject.conf') }}

# If the autosign_grains_dir is specified, incoming keys from minions with grain values matching those defined in files in this directory will be accepted automatically.
autosign_grains_dir: {{ autosign_grains_dir | default('/etc/salt/autosign_grains') }}

# Enable permissive access to the salt keys.
permissive_pki_access: {{ permissive_pki_access | default('False') }}

# Check the list of configured users in client ACL against users on the system and throw errors if they do not exist.
client_acl_verify: {{ client_acl_verify | default('True') }}

# Enforce publisher_acl & publisher_acl_blacklist when users have sudo access to the salt command.
sudo_acl: {{ sudo_acl | default(False) }}

# Time (in seconds) for a newly generated token to live. Default: 12 hours.
token_expire: {{ token_expire | default('43200') }}

# Allow eauth users to specify the expiry time of the tokens they generate.
token_expire_user_override: {{ token_expire_user_override | default('False') }}

# Set to True to enable keeping the calculated user's auth list in the token file.
keep_acl_in_token: {{ keep_acl_in_token | default('False') }}

# Auth subsystem module to use to get authorized access list for a user.
eauth_acl_module: {{ eauth_acl_module | default('django') }}

# Allow minions to push files to the master.
file_recv: {{ file_recv | default('False') }}

# Set a hard-limit on the size of the files that can be pushed to the master.
file_recv_max_size: {{ file_recv_max_size | default('100') }}

# Signature verification on messages published from the master.
sign_pub_messages: {{ sign_pub_messages | default('False') }}

# Signature verification on messages published from minions.
require_minion_sign_messages: {{ require_minion_sign_messages | default('False') }}

# The below will drop messages when their signatures do not validate.
drop_messages_signature_fail: {{ drop_messages_signature_fail | default('False') }}


#####     Salt-SSH Configuration     #####
##########################################
# Define the default salt-ssh roster module to use.
roster: {{ roster | default('flat') }}

# Pass in an alternative location for the salt-ssh `flat` roster file.
roster_file: {{ roster_file | default('/etc/salt/roster') }}

# The ssh password to log in with.
ssh_passwd: {{ ssh_passwd | default('') }}

# The target system's ssh port number.
ssh_port: {{ ssh_port | default('22') }}

# Comma-separated list of ports to scan.
ssh_scan_ports: {{ ssh_scan_ports | default('22') }}

# Scanning socket timeout for salt-ssh.
ssh_scan_timeout: {{ ssh_scan_timeout | default('0.01') }}

# Boolean to run command via sudo.
ssh_sudo: {{ ssh_sudo | default('False') }}

# Boolean to run ssh_pre_flight script defined in roster.
ssh_run_pre_flight: {{ ssh_run_pre_flight | default('True') }}

# Number of seconds to wait for a response when establishing an SSH connection.
ssh_timeout: {{ ssh_timeout | default('60') }}

# The user to log in as.
ssh_user: {{ ssh_user | default('root') }}

# The log file of the salt-ssh command.
ssh_log_file: {{ ssh_log_file | default('/var/log/salt/ssh') }}

# Set this to True to default to using ~/.ssh/id_rsa for salt-ssh authentication with minions.
ssh_use_home_key: {{ ssh_use_home_key | default('False') }}

# Set this to True to default salt-ssh to run with ``-o IdentitiesOnly=yes``.
ssh_identities_only: {{ ssh_identities_only | default('False') }}

# List-only nodegroups for salt-ssh.
ssh_list_nodegroups: {{ ssh_list_nodegroups | default('{}') }}

# salt-ssh has the ability to update the flat roster file if a minion is not found in the roster.
ssh_update_roster: {{ ssh_update_roster | default('False') }}


#####    Master Module Management    #####
