# Global defaults
# compress: compress rotated log files using gzip(1)
compress
# dateext: append date extension to rotated log file names
# dateformat: format string for date extension; %Y%m%d%H%M%S is used by default if unspecified
# dateext: true
# dateformat: "-" + "%Y%m%d"
# daterotate: use date extension instead of sequence number for rotation numbering
# nocompress: false
# delaycompress: do not compress the most recent rotated log; only compress logs from previous rotation
# sharedscripts: run postrotate script only once for all logs in a block
# missingok: do not issue an error if a log file is missing
# notifempty: do not rotate if the log file is empty
# weekly: rotate weekly (default weekday: Sunday)
# rotate: number of rotated logs to keep (0 = remove immediately)
# size: max size before forced rotation (mutually exclusive with time-based rotation unless preceded by time-based and appears later)
# maxsize: rotate when exceeding this size, even before time-based interval
# minsize: rotate only after exceeding this size AND at least one time interval has passed
# maxage: remove rotated logs older than this many days
# minage: do not rotate logs younger than this many days
# create: create new log file with given mode, owner, and group after rotation
# copy: make a copy of the log file instead of moving it (implies noolddir unless olddir + copytruncate)
# copytruncate: truncate original file in place instead of moving it (useful for programs that don’t close log files)
# olddir: move rotated logs to this directory (must be on same device unless copy/copytruncate/renamecopy is used)
# su: rotate logs as this user/group instead of root (required for non-root owned directories)
# taboopext/taboopat: list of file extensions/patterns to ignore during glob expansion

# Default settings
compress
compresscmd /bin/gzip
uncompresscmd /bin/gunzip
compressext .gz
dateext

# Global rotation defaults (can be overridden per-block)
weekly
dateformat -%Y%m%d
rotate 4
create
missingok
notifempty

# Example: system logs
# /var/log/messages: rotate weekly, keep 4 versions, run HUP on syslog daemon after rotation
# postrotate script: reloads rsyslog/syslogd via killall -HUP; used to ensure new log file is used
# This block overrides global 'compress' → but global is already set; redundant in practice
/var/log/messages {
    weekly
    rotate 4
    missingok
    notifempty
    create 0640 root adm
    sharedscripts
    # postrotate: runs once after all logs in block are rotated; reloads rsyslog
    postrotate
        /usr/bin/killall -HUP rsyslogd 2>/dev/null || true
    endscript
}

# Example: multiple logs with shared config (access & error logs)
# Rotates on size > 100k, mails old logs to admin@example.com, keeps 5 versions
# sharedscripts ensures only one postrotate run despite two logs
"/var/log/httpd/access.log" /var/log/httpd/error.log {
    size 100k
    rotate 5
    mail admin@example.com
    missingok
    notifempty
    sharedscripts
    # postrotate: reloads httpd (apache2) to pick up new log file
    postrotate
        /usr/bin/killall -HUP httpd 2>/dev/null || true
    endscript
}

# Example: news logs with custom directory and no compression
# olddir: rotated files go here; missingok prevents errors if file missing
# nocompress: disables compression (useful for logs read by live processes)
/var/log/news/* {
    monthly
    rotate 2
    missingok
    notifempty
    nocompress
    # olddir: stores rotated news logs in separate directory
    olddir /var/log/news/old
    # createolddir: ensure olddir is created if missing
    createolddir 0755 news news
    # postrotate: reloads INN news server via HUP
    postrotate
        /bin/kill -HUP $(/bin/cat /var/run/inn.pid) 2>/dev/null || true
    endscript
}

# Example: per-user logs in home dirs (tilde expansion required)
# This block rotates all .log files in user home dir weekly, no compression
# noolddir (default): logs rotated in-place
~/logs/*.log {
    weekly
    rotate 1
    missingok
    notifempty
    nocompress
}

# Example: hourly rotation for high-volume logs (requires cron/systemd override)
# hourly: rotate every hour — only works if logrotate is run hourly
/var/log/audit/audit.log {
    hourly
    rotate 12
    size 100M
    compress
    missingok
    notifempty
    create 0600 root root
    maxage 7
}

# Example: secure deletion of old logs using shred (non-default)
# shred: securely deletes old rotated logs; overrides default unlink()
# shredcycles: number of overwrite passes (default is 3)
/var/log/secure_audit/* {
    monthly
    rotate 3
    missingok
    notifempty
    create 0640 root adm
    shred
    shredcycles 3
}
