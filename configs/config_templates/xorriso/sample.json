{
  "xorriso": {
    "indev": "",
    "outdev": "/tmp/my_backup.iso",
    "volid": "BACKUP_2023",
    "joliet": true,
    "out_charset": "UTF-8",
    "volume_date": "default",
    "speed": "4x",
    "padding": "300k",
    "fs_mb": 8,
    "source_files": [
      "/home/user/documents",
      "/home/user/photos/image1.jpg"
    ],
    "directories": [
      "/backup/docs",
      "/backup/photos"
    ],
    "permissions": [
      {
        "mode": "0755",
        "path": "/backup"
      },
      {
        "mode": "0644",
        "path": "/backup/photos/image1.jpg"
      }
    ]
  }
}
