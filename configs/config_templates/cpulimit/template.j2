{# cpulimit service configuration #}
[Service]
Type=simple
# Target selection: specify exactly one of pid, exe, or path
{% if values.target.pid is defined %}
ExecStart=/usr/bin/cpulimit -p {{ values.target.pid | default(0) }} {% if values.limit is defined %}-l {{ values.limit }} {% endif %}{% if values.cpu_cores is defined %} -c {{ values.cpu_cores }}{% endif %}{% if values.signal is defined %} -s {{ values.signal }}{% endif %}{% if values.verbose is defined and values.verbose %} -v{% endif %}{% if values.quiet is defined and values.quiet %} -q{% endif %}{% if values.kill is defined and values.kill %} -k{% endif %}{% if values.lazy is defined and values.lazy %} -z{% endif %}{% if values.monitor_forks is defined and values.monitor_forks %} -m{% endif %}{% if values.foreground is defined and values.foreground %} -f{% endif %}{% if values.background is defined and values.background %} -b{% endif %}
{% elif values.target.exe is defined %}
ExecStart=/usr/bin/cpulimit -e {{ values.target.exe }} {% if values.limit is defined %}-l {{ values.limit }} {% endif %}{% if values.cpu_cores is defined %} -c {{ values.cpu_cores }}{% endif %}{% if values.signal is defined %} -s {{ values.signal }}{% endif %}{% if values.verbose is defined and values.verbose %} -v{% endif %}{% if values.quiet is defined and values.quiet %} -q{% endif %}{% if values.kill is defined and values.kill %} -k{% endif %}{% if values.lazy is defined and values.lazy %} -z{% endif %}{% if values.monitor_forks is defined and values.monitor_forks %} -m{% endif %}{% if values.foreground is defined and values.foreground %} -f{% endif %}{% if values.background is defined and values.background %} -b{% endif %}
{% elif values.target.path is defined %}
ExecStart=/usr/bin/cpulimit -P {{ values.target.path }} {% if values.limit is defined %}-l {{ values.limit }} {% endif %}{% if values.cpu_cores is defined %} -c {{ values.cpu_cores }}{% endif %}{% if values.signal is defined %} -s {{ values.signal }}{% endif %}{% if values.verbose is defined and values.verbose %} -v{% endif %}{% if values.quiet is defined and values.quiet %} -q{% endif %}{% if values.kill is defined and values.kill %} -k{% endif %}{% if values.lazy is defined and values.lazy %} -z{% endif %}{% if values.monitor_forks is defined and values.monitor_forks %} -m{% endif %}{% if values.foreground is defined and values.foreground %} -f{% endif %}{% if values.background is defined and values.background %} -b{% endif %}
{% endif %}
# Launch and limit an external command (optional) #
{% if values.launch_command is defined %}
# When launching a command, cpulimit becomes the launcher and limits the launched program
ExecStart=/usr/bin/cpulimit {% if values.limit is defined %}-l {{ values.limit }} {% endif %}{% if values.cpu_cores is defined %} -c {{ values.cpu_cores }}{% endif %}{% if values.signal is defined %} -s {{ values.signal }}{% endif %}{% if values.verbose is defined and values.verbose %} -v{% endif %}{% if values.quiet is defined and values.quiet %} -q{% endif %}{% if values.kill is defined and values.kill %} -k{% endif %}{% if values.lazy is defined and values.lazy %} -z{% endif %}{% if values.monitor_forks is defined and values.monitor_forks %} -m{% endif %}{% if values.foreground is defined and values.foreground %} -f{% endif %}{% if values.background is defined and values.background %} -b{% endif %} -- {% for arg in values.launch_command %}{{ arg | default('') }} {% endfor %}
{% endif %}
