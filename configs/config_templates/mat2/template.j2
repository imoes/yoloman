# ==============================================================================
# MAT2 Configuration Template
#
# This template generates the configuration file for MAT2 (Metadata Anonymisation
# Toolkit), a tool to remove metadata from various file types.
#
# Generated by Ansible Jinja2 engine. All variables use safe defaults to ensure
# the configuration is valid and self-documenting.
# ==============================================================================

# --- General Policy Settings ---

# unknown_members_policy
# Controls how MAT2 handles unknown members (files/entries) within archive-style
# containers (like ZIP or TAR).
# Valid values:
#   - 'abort': Stop processing and fail if an unknown member is encountered.
#   - 'omit':  Skip the unknown member (default).
#   - 'keep':  Leave the unknown member untouched.
unknown-members-policy: {{ unknown_members_policy | default('omit') }}

# lightweight
# If set to true, enables 'lightweight' cleaning mode.
# This mode removes some metadata but not all, aiming to preserve file quality
# where full cleaning would cause unacceptable degradation.
# Note: This is a boolean value.
lightweight: {{ lightweight | default(false) | lower }}

# no_sandbox
# If set to true, disables the bubblewrap sandboxing environment.
# WARNING: Disabling the sandbox reduces security isolation. It is recommended
# to keep this false (sandbox enabled) unless debugging or in a trusted
# environment where sandboxing is already handled externally.
no-sandbox: {{ no_sandbox | default(false) | lower }}

# --- Execution Behavior ---

# inplace
# If set to true, MAT2 will clean files in-place, overwriting the original
# content. If false (default), it creates a backup file with the '.cleaned'
# suffix (e.g., 'file.pdf' -> 'file.pdf.cleaned').
# Use with caution.
inplace: {{ inplace | default(false) | lower }}

# verbose
# If set to true, enables verbose status information and detailed logging
# during execution. Useful for debugging or monitoring what MAT2 is doing.
verbose: {{ verbose | default(false) | lower }}

# --- Output Configuration ---

# output_dir
# Specifies the directory where cleaned files are saved.
# - If set to '.' (default), cleaned files are saved in the current working
#   directory of the process.
# - Can be set to an absolute or relative path.
output-dir: {{ output_dir | default('.') }}

# --- File Selection ---

# file_patterns
# A list of glob-style patterns used to select files for processing.
# - Empty list or ['*'] implies processing all files in the provided context/directory.
# - Example: ['*.pdf', '*.docx', '*.jpg'] to target specific types.
# The list is rendered as one pattern per line for MAT2's CLI or config parser.
# If the variable is undefined or null, it defaults to ['*'].
file-patterns: {{ file_patterns | default(['*']) | to_json | join('\n') }}