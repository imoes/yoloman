# Maliit Framework Input Method Configuration
# This template configures the system-wide environment variables to enable
# the Maliit software keyboard/input method framework.

# Enable XIM (X Input Method) protocol support.
# Set to 'none' if relying solely on Qt/GTK native IM integration,
# or 'maliit' if the Maliit server should act as an XIM input method.
# Reference: System XIM configuration
XIM=none

# The executable path for the XIM program.
# This specifies the binary that handles XIM requests if XIM is enabled above.
# Reference: XIM Program Path
XIM_PROGRAM=/usr/bin/maliit-server

# Arguments passed to the XIM program.
# Reference: XIM Arguments
XIM_ARGS=

# Environment variable for GTK applications.
# Tells GTK-based applications to use the specified input method module.
# Default: 'maliit' ensures GTK apps route input to the Maliit framework.
# Reference: GTK Input Method Module
GTK_IM_MODULE={{ gtk_im_module | default('maliit') }}

# Environment variable for Qt applications.
# Tells Qt-based applications to use the specified input method module.
# Default: 'maliit' ensures Qt apps route input to the Maliit framework.
# Reference: Qt Input Method Module
QT_IM_MODULE={{ qt_im_module | default('maliit') }}

# Dependency declaration.
# Indicates that the Maliit framework package is required for this configuration to function.
# Reference: Package Dependencies
DEPENDS="maliit-framework"
