{
  "dirmngr_local_stream_socket": "-1",
  "dirmngr_ldap_port": 389,
  "dirmngr_ldap_server_pool": true,
  "dirmngr_ldap_servers": [
    {
      "url": "ldap://pgp.mit.edu"
    },
    {
      "url": "ldaps://ldap.keyserver.de"
    }
  ],
  "dirmngr_http_proxy": "auto",
  "dirmngr_no_allow_dns_cert": false,
  "dirmngr_no_allow_ldap": false,
  "dirmngr_connection_timeout": 30,
  "dirmngr_max_connections": 10,
  "dirmngr_cache_validity": 7200,
  "dirmngr_ocsp": true,
  "dirmngr_ocsp_responders": [
    {
      "url": "https://ocsp.int-x3.letsencrypt.org"
    }
  ],
  "dirmngr_use_standard_resolver": true,
  "dirmngr_log_file": "/var/log/dirmngr.log",
  "dirmngr_verbose": 1
}
