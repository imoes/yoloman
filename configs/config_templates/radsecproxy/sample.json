{
  "clients": [
    "10.0.0.0/8 secret",
    "192.168.1.0/24 another-secret"
  ],
  "udp_servers": [
    "radius1.internal:1812 secret",
    "radius2.internal:1812 secret"
  ],
  "tcp_servers": [
    "radsec.example.com:2083 tcp:radsec.example.com:2083:radsec-secret::/etc/radsecproxy/ca.pem"
  ],
  "debug": false,
  "log_level": 2,
  "log_file": "",
  "stats_port": 1813,
  "listen_addr": "0.0.0.0",
  "use_tls": true,
  "ca_cert_file": "/etc/radsecproxy/ca.pem",
  "server_cert_file": "/etc/radsecproxy/server.crt",
  "server_key_file": "/etc/radsecproxy/server.key",
  "client_cert_file": "/etc/radsecproxy/client.crt",
  "client_key_file": "/etc/radsecproxy/client.key",
  "tls_cipher_list": "HIGH:!aNULL:!3DES:!MD5",
  "tls_verify_cert": true,
  "default_realm": "example.com",
  "fallback_realm": "fallback.example.com",
  "timeout": 5,
  "retries": 2,
  "realms": [
    "example.com = radsec.example.com:2083",
    "other.net = radius1.other.net:1812 other-secret"
  ]
}
