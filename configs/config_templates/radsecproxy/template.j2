# RADIUS clients to forward requests to (local or remote)
{% for client in clients %}{{ client.name }}
{% endfor %}

# UDP servers to forward Access-Request and Accounting-Request
{% for server in udp_servers %}{{ server.name }}
{% endfor %}

# TCP/TLS (RadSec) servers to forward requests
{% for server in tcp_servers %}{{ server.name }}
{% endfor %}

# Global options
{% if debug %}# Enable debug logging
Debug
{% endif %}
{# Logging #}
{% if log_level %}# Log level: 0=none, 1=error, 2=warn, 3=info, 4=debug
LogLevels {{ log_level }}
{% endif %}
{% if log_file %}# Log to file (default: syslog)
LogFile {{ log_file }}
{% endif %}

{# Global statistics and status #}
{% if stats_port %}# Statistics server port (UDP)
StatsPort {{ stats_port }}
{% endif %}
{% if listen_addr %}# Local address to bind to (default: 0.0.0.0)
Listen {{ listen_addr }}
{% endif %}

{# Certificate and TLS configuration #}
{% if use_tls %}# TLS settings (RadSec)
CACertFile {{ ca_cert_file }}
{% if server_cert_file %}ServerCertFile {{ server_cert_file }}{% endif %}
{% if server_key_file %}ServerKeyFile {{ server_key_file }}{% endif %}
{% if client_cert_file %}ClientCertFile {{ client_cert_file }}{% endif %}
{% if client_key_file %}ClientKeyFile {{ client_key_file }}{% endif %}
{% if tls_cipher_list %}TLSCipherList {{ tls_cipher_list }}{% endif %}
{% if tls_verify_cert %}VerifyCertificates{% endif %}
{% endif %}

{# Default realm and fallback behavior #}
{% if default_realm %}# Default realm to use for unqualified usernames
DefaultRealm {{ default_realm }}
{% endif %}
{% if fallback_realm %}# Realm to use if no matching realm or client found
FallbackRealm {{ fallback_realm }}
{% endif %}

{# Timeouts and retries #}
{% if timeout %}# Request timeout in seconds (default: 3)
Timeout {{ timeout }}
{% endif %}
{% if retries %}# Max number of retries per request (default: 3)
Retries {{ retries }}
{% endif %}

{# Weighted server selection #}
{% for server in tcp_servers %}{{ server.name }}
{% endfor %}
{% for server in udp_servers %}{{ server.name }}
{% endfor %}

# Realm definitions (optional, but commonly present)
{% for realm in realms %}{{ realm.name }}
{% endfor %}
