{
  "web_listen_address": "0.0.0.0:9130",
  "mail_servers": [
    {
      "label": "Gmail INBOX",
      "connection_string": "imaps://user@gmail.com:app_password@imap.gmail.com:993"
    },
    {
      "label": "Work Mail",
      "connection_string": "imaps://user@company.com:secret@imap.company.com:993"
    }
  ],
  "check_interval": "60s",
  "timeout": "15s",
  "max_messages": 500,
  "skip_tls_verify": false,
  "starttls": true,
  "log_level": "info",
  "imap_flags": [
    "UNSEEN",
    "FLAGGED",
    "ANSWERED",
    "DRAFT"
  ],
  "web_basic_auth_user": "metrics",
  "web_basic_auth_password": "secure_password_here",
  "metric_prefix": "mailexporter"
}
