{
  "module": "app:app",
  "virtualenv": "/var/www/myflaskapp/venv",
  "home": "",
  "uid": "www-data",
  "gid": "www-data",
  "chdir": "/var/www/myflaskapp",
  "socket": "/run/uwsgi/myflaskapp.sock",
  "http": "",
  "processes": 4,
  "threads": 1,
  "master": true,
  "lazy_apps": true,
  "reload_mercy": 8,
  "worker_reload_mercy": 8,
  "max_requests": 5000,
  "logto": "/var/log/uwsgi/myflaskapp.log",
  "logfile": "",
  "logto_syslog": "",
  "log_level": 2,
  "emperor": "",
  "stats": "127.0.0.1:9191",
  "vacuum": true,
  "post_buffering": 8192,
  "virtualhost": false,
  "thunder_lock": true,
  "buffer_size": 65535,
  "py-path": "/var/www/myflaskapp/libs",
  "callable": "app",
  "harakiri": 30,
  "harakiri_verbose": true,
  "lazy_config": false,
  "graceful-timeout": 30,
  "limit_as": 512,
  "env_vars": [
    "PYTHONUNBUFFERED=1",
    "FLASK_ENV=production",
    "SECRET_KEY=supersecretkey"
  ],
  "plugins": "python3",
  "plugin_python3": "python39",
  "lazy_exec": false,
  "reload_on_rss": 0
}
