{
  "verbose": "yes",
  "print_confnames": "no",
  "inherited_config": "/usr/share/uwsgi/conf/default.ini",
  "module": "app:application",
  "virtualenv": "/var/www/myapp/venv",
  "home": "",
  "uid": "www-data",
  "gid": "www-data",
  "chdir": "/var/www/myapp",
  "socket": "/run/uwsgi/app.sock",
  "http": "",
