# client.conf — CUPS client configuration file
# This file configures the CUPS client behavior, such as server address,
# TLS/encryption settings, authentication options, and user agent info.
# Each line may contain a directive, comment (starting with '#'), or blank line.

# AllowAnyRoot — controls whether TLS connections are permitted using certificates
# not signed by a trusted CA. Default is 'Yes'.
{% if values.allow_any_root is defined %}AllowAnyRoot {{ values.allow_any_root }}{% endif %}

# AllowExpiredCerts — controls whether TLS connections are permitted using expired certificates.
# Default is 'No'.
{% if values.allow_expired_certs is defined %}AllowExpiredCerts {{ values.allow_expired_certs }}{% endif %}

# DigestOptions — sets HTTP Digest authentication behavior.
# 'DenyMD5' disables the legacy MD5 hash algorithm; 'None' uses default settings.
{% if values.digest_options is defined %}DigestOptions {{ values.digest_options }}{% endif %}

# Encryption — defines the required TLS encryption level.
# 'IfRequested' (default): only encrypt if server requests it.
# 'Never': never encrypt.
# 'Required': always require encryption.
{% if values.encryption is defined %}Encryption {{ values.encryption }}{% endif %}

# GSSServiceName — specifies the Kerberos service principal name used for authentication.
# Common values: 'host', 'http', or 'ipp'. CUPS appends the remote hostname automatically.
# Default is 'http'.
{% if values.gss_service_name is defined %}GSSServiceName {{ values.gss_service_name }}{% endif %}

# ServerName — specifies the CUPS server address (hostname/IP[:port]) or Unix domain socket path.
# Optionally supports URI suffixes like '/version=1.1' for older servers.
# This directive is not supported on macOS 10.7 and later.
{% if values.server_name is defined %}ServerName {{ values.server_name }}{% endif %}

# SSLOptions — fine-tunes TLS protocol and cipher suite behavior.
# Allow* options weaken security; Deny* options strengthen it.
# Example: 'DenyTLS1.0' sets minimum TLS version to 1.1.
{% if values.ssl_options is defined %}SSLOptions {{ values.ssl_options | join(' ') }}{% endif %}

# TrustOnFirstUse — controls whether new TLS certificates are automatically trusted on first connect.
# Default is 'Yes' (trust-on-first-use). Set to 'No' to require manual trust or CA-signed certs.
{% if values.trust_on_first_use is defined %}TrustOnFirstUse {{ values.trust_on_first_use }}{% endif %}

# User — sets the default username for authenticated client requests.
{% if values.user is defined %}User {{ values.user }}{% endif %}

# UserAgentTokens — controls the verbosity of the User-Agent HTTP header sent to servers.
# Options: 'None' (no header), 'ProductOnly', 'Major', 'Minor', 'Minimal' (default),
# 'OS', or 'Full' (includes OS and architecture info).
{% if values.user_agent_tokens is defined %}UserAgentTokens {{ values.user_agent_tokens }}{% endif %}

# ValidateCerts — controls whether the client enforces that the TLS certificate's common name
# matches the server hostname. Default is 'No' (no strict validation).
{% if values.validate_certs is defined %}ValidateCerts {{ values.validate_certs }}{% endif %}
