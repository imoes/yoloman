# client.conf — CUPS client configuration file
#
# This file configures the CUPS client behavior, controlling how the local
# system connects to a CUPS printing server. It covers server address,
# TLS/encryption levels, authentication mechanisms, and HTTP user-agent
# identification.
#
# Each non-empty line is a directive. Comments start with '#' and are
# ignored by CUPS but preserved here for self-documentation.

# AllowAnyRoot — Whether to allow TLS with non-CA-signed certificates.
# 'Yes' allows connections to servers with self-signed or untrusted certs.
# 'No' requires a trusted CA. Default is 'Yes'.
AllowAnyRoot {{ allow_any_root | default('Yes') }}

# AllowExpiredCerts — Whether to allow TLS with expired certificates.
# 'Yes' permits expired certs; 'No' rejects them. Default is 'No'.
AllowExpiredCerts {{ allow_expired_certs | default('No') }}

# DigestOptions — HTTP Digest auth option(s).
# 'DenyMD5' disables the insecure MD5 hash; 'None' uses defaults.
DigestOptions {{ digest_options | default('None') }}

# Encryption — Encryption level for the connection.
# 'IfRequested': encrypt only if server asks.
# 'Never': no encryption.
# 'Required': always require TLS. Default is 'IfRequested'.
Encryption {{ encryption | default('IfRequested') }}

# GSSServiceName — Kerberos service principal name for GSSAPI auth.
# Common values: 'host', 'http', or 'ipp'. CUPS appends the server
# hostname automatically. Default is 'http'.
GSSServiceName {{ gss_service_name | default('http') }}

# ServerName — CUPS server address (hostname:port, IP:port, or
# Unix socket path). Supports URI suffixes like '/version=1.1' for
# older servers. Not supported on macOS 10.7+. Default is localhost.
ServerName {{ server_name | default('localhost') }}

# SSLOptions — List of fine-grained TLS protocol/cipher directives.
# Allow* weakens security; Deny* strengthens it.
# Example: 'DenyTLS1.0' forces minimum TLS 1.1. Default is empty [].
{% set _ssl_opts = ssl_options | default([]) %}
{% if _ssl_opts | length > 0 %}
SSLOptions {{ _ssl_opts | join(' ') }}
{% endif %}

# TrustOnFirstUse — Auto-trust new TLS certificates on first connect.
# 'Yes' enables trust-on-first-use; 'No' requires manual trust.
# Default is 'Yes'.
TrustOnFirstUse {{ trust_on_first_use | default('Yes') }}

# User — Default username for authenticated requests.
# Leave empty ('') to use the current user or prompt.
User {{ user | default('') }}

# UserAgentTokens — User-Agent header verbosity level.
# Options: 'None', 'ProductOnly', 'Major', 'Minor', 'Minimal' (default),
# 'OS', or 'Full'.
UserAgentTokens {{ user_agent_tokens | default('Minimal') }}

# ValidateCerts — Enforce CN/SAN matches server hostname.
# 'Yes' strict validation; 'No' skips hostname check. Default is 'No'.
ValidateCerts {{ validate_certs | default('No') }}