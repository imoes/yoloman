{
  "allow_any_root": {
    "type": "string",
    "default": "Yes",
    "description": "Whether to allow TLS with non-CA-signed certificates ('Yes' or 'No')\n",
    "enum": [
      "Yes",
      "No"
    ]
  },
  "allow_expired_certs": {
    "type": "string",
    "default": "No",
    "description": "Whether to allow TLS with expired certificates ('Yes' or 'No')",
    "enum": [
      "Yes",
      "No"
    ]
  },
  "digest_options": {
    "type": "string",
    "default": "None",
    "description": "HTTP Digest auth option(s); e.g., 'DenyMD5' or 'None'",
    "enum": [
      "DenyMD5",
      "None"
    ],
    "enum_open": true
  },
  "encryption": {
    "type": "string",
    "default": "IfRequested",
    "description": "Encryption level: 'IfRequested', 'Never', or 'Required'",
    "enum": [
      "IfRequested",
      "Never",
      "Required"
    ]
  },
  "gss_service_name": {
    "type": "string",
    "default": "http",
    "description": "Kerberos service principal name: 'host', 'http', or 'ipp'",
    "enum": [
      "host",
      "http",
      "ipp"
    ]
  },
  "server_name": {
    "type": "string",
    "default": "localhost",
    "description": "CUPS server address (hostname:port), IP:port, or socket path"
  },
  "ssl_options": {
    "type": "list",
    "default": [],
    "description": "List of SSLOptions directives (e.g., ['DenyTLS1.0'])"
  },
  "trust_on_first_use": {
    "type": "string",
    "default": "Yes",
    "description": "Whether to auto-trust new TLS certificates on first connect ('Yes' or 'No')",
    "enum": [
      "Yes",
      "No"
    ]
  },
  "user": {
    "type": "string",
    "default": "",
    "description": "Default username for authenticated requests"
  },
  "user_agent_tokens": {
    "type": "string",
    "default": "Minimal",
    "description": "User-Agent header verbosity level",
    "enum": [
      "None",
      "ProductOnly",
      "Major",
      "Minor",
      "Minimal",
      "OS",
      "Full"
    ]
  },
  "validate_certs": {
    "type": "string",
    "default": "No",
    "description": "Whether to enforce CN matches server hostname ('Yes' or 'No')",
    "enum": [
      "Yes",
      "No"
    ]
  }
}
