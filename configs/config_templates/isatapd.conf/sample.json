{
  "enabled": true,
  "interface": "eth0",
  "isatap_router_ipv4": "192.0.2.1",
  "isatap_ipv6_prefix": "2001:db8:1::/64",
  "router_advert_lifetime": 1800,
  "router_advert_interval": 600,
  "mtu_discovery": true,
  "trusted_hosts": [
    "192.0.2.2",
    "192.0.2.3"
  ],
  "log_level": "WARNING",
  "log_file": "/var/log/isatapd.log",
  "ipv6_forwarding": true,
  "zones": [
    {
      "name": "main",
      "prefix": "2001:db8:1::/64",
      "router": "192.0.2.1"
    },
    {
      "name": "dmz",
      "prefix": "2001:db8:2::/64",
      "router": "192.0.2.10"
    }
  ]
}
