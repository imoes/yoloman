<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- SPDX-License-Identifier: MIT -->
<!--
  PT Sans Font Configuration
  ==========================
  This XML file configures Fontconfig to recognize PT Sans font families,
  set version numbers, handle Narrow/Condensed aliases, and manage
  font substitution (aliasing) with system defaults like Myriad Pro and sans-serif.
-->
<fontconfig>
  <!--
    Regular Style
    -------------
    Maps the Regular font variant (Full Name: PT Sans, Style: Regular)
    to version 2.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name for the Regular style -->
      <string>{{ pt_sans_fullname_regular | default('PT Sans') }}</string>
    </test>
    <test name="family">
      <!-- Primary family name for PT Sans -->
      <string>{{ pt_sans_family | default('PT Sans') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Regular variant -->
      <string>{{ pt_sans_style_regular | default('Regular') }}</string>
    </test>
    <edit name="fontversion">
      <!-- Font version for standard PT Sans variants -->
      <int>{{ pt_sans_version | default(2) }}</int>
    </edit>
  </match>

  <!--
    Italic Style
    ------------
    Maps the Italic font variant (Full Name: PT Sans Italic, Style: Italic)
    to version 2.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name for the Italic style -->
      <string>{{ pt_sans_fullname_italic | default('PT Sans Italic') }}</string>
    </test>
    <test name="family">
      <!-- Primary family name for PT Sans -->
      <string>{{ pt_sans_family | default('PT Sans') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Italic variant -->
      <string>{{ pt_sans_style_italic | default('Italic') }}</string>
    </test>
    <edit name="fontversion">
      <!-- Font version for standard PT Sans variants -->
      <int>{{ pt_sans_version | default(2) }}</int>
    </edit>
  </match>

  <!--
    Bold Style
    ----------
    Maps the Bold font variant (Full Name: PT Sans Bold, Style: Bold)
    to version 2.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name for the Bold style -->
      <string>{{ pt_sans_fullname_bold | default('PT Sans Bold') }}</string>
    </test>
    <test name="family">
      <!-- Primary family name for PT Sans -->
      <string>{{ pt_sans_family | default('PT Sans') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Bold variant -->
      <string>{{ pt_sans_style_bold | default('Bold') }}</string>
    </test>
    <edit name="fontversion">
      <!-- Font version for standard PT Sans variants -->
      <int>{{ pt_sans_version | default(2) }}</int>
    </edit>
  </match>

  <!--
    Bold Italic Style
    -----------------
    Maps the Bold Italic font variant (Full Name: PT Sans Bold Italic,
    Style: Bold Italic) to version 2.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name for the Bold Italic style -->
      <string>{{ pt_sans_fullname_bold_italic | default('PT Sans Bold Italic') }}</string>
    </test>
    <test name="family">
      <!-- Primary family name for PT Sans -->
      <string>{{ pt_sans_family | default('PT Sans') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Bold Italic variant -->
      <string>{{ pt_sans_style_bold_italic | default('Bold Italic') }}</string>
    </test>
    <edit name="fontversion">
      <!-- Font version for standard PT Sans variants -->
      <int>{{ pt_sans_version | default(2) }}</int>
    </edit>
  </match>

  <!--
    Narrow / Condensed Styles (Regular)
    ------------------------------------
    Configures the Narrow family (PT Sans Narrow) and adds
    "PT Sans Condensed" as a prepend alias for the full name and style.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name for the Narrow Regular style -->
      <string>{{ pt_sans_narrow_fullname_regular | default('PT Sans Narrow') }}</string>
    </test>
    <test name="family">
      <!-- Family name for the Narrow (Condensed) variants -->
      <string>{{ pt_sans_narrow_family | default('PT Sans Narrow') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Narrow Regular variant -->
      <string>{{ pt_sans_narrow_style_regular | default('Regular') }}</string>
    </test>
    <edit name="fullname" mode="prepend">
      <!-- Prepended fullname alias for Narrow Regular -->
      <string>{{ pt_sans_condensed_fullname | default('PT Sans Condensed') }}</string>
    </edit>
    <edit name="family" mode="prepend">
      <!-- Primary family name (aliased) -->
      <string>{{ pt_sans_family | default('PT Sans') }}</string>
    </edit>
    <edit name="style" mode="prepend">
      <!-- Prepended style alias for Narrow Regular -->
      <string>{{ pt_sans_condensed_style | default('Condensed') }}</string>
    </edit>
    <edit name="fontversion">
      <!-- Font version for Narrow/Condensed variants -->
      <int>{{ pt_sans_narrow_version | default(1) }}</int>
    </edit>
  </match>

  <!--
    Narrow / Condensed Styles (Bold)
    --------------------------------
    Configures the Narrow family (PT Sans Narrow Bold) and adds
    "PT Sans Condensed Bold" as a prepend alias.
  -->
  <match target="scan">
    <test name="fullname">
      <!-- Full name for the Narrow Bold style -->
      <string>{{ pt_sans_narrow_fullname_bold | default('PT Sans Narrow Bold') }}</string>
    </test>
    <test name="family">
      <!-- Family name for the Narrow (Condensed) variants -->
      <string>{{ pt_sans_narrow_family | default('PT Sans Narrow') }}</string>
    </test>
    <test name="style">
      <!-- Style name for the Narrow Bold variant -->
      <string>{{ pt_sans_narrow_style_bold | default('Bold') }}</string>
    </test>
    <edit name="fullname" mode="prepend">
      <!-- Prepended fullname alias for Narrow Bold -->
      <string>{{ pt_sans_condensed_bold_fullname | default('PT Sans Condensed Bold') }}</string>
    </edit>
    <edit name="family" mode="prepend">
      <!-- Primary family name (aliased) -->
      <string>{{ pt_sans_family | default('PT Sans') }}</string>
    </edit>
    <edit name="style" mode="prepend">
      <!-- Prepended style alias for Narrow Bold -->
      <string>{{ pt_sans_condensed_bold_style | default('Condensed Bold') }}</string>
    </edit>
    <edit name="fontversion">
      <!-- Font version for Narrow/Condensed variants -->
      <int>{{ pt_sans_narrow_version | default(1) }}</int>
    </edit>
  </match>

  <!--
    Aliasing: PT Sans <-> Myriad Pro
    --------------------------------
    Makes PT Sans and Myriad Pro interchangeable in the same binding group.
  -->
  <alias binding="same">
    <family>{{ pt_sans_family | default('PT Sans') }}</family>
    <accept>
      <!-- The font family to alias/accept in place of PT Sans and vice versa -->
      <family>{{ pt_sans_alias_preferred | default('Myriad Pro') }}</family>
      <family>sans-serif</family>
    </accept>
  </alias>

  <!--
    Aliasing: Myriad Pro <-> PT Sans
    --------------------------------
    Makes Myriad Pro accept PT Sans as an alternative.
  -->
  <alias binding="same">
    <family>{{ pt_sans_alias_preferred | default('Myriad Pro') }}</family>
    <accept>
      <family>{{ pt_sans_family | default('PT Sans') }}</family>
    </accept>
  </alias>

  <!--
    Alias: sans-serif prefers PT Sans
    ---------------------------------
    Sets PT Sans as the preferred font for the generic 'sans-serif' family.
  -->
  <alias>
    <family>sans-serif</family>
    <prefer>
      <family>{{ pt_sans_family | default('PT Sans') }}</family>
    </prefer>
  </alias>

  <!--
    Caption Threshold
    -----------------
    If the requested font size is <= 8.0 points, use PT Sans Caption
    instead of the standard PT Sans family.
  -->
  <match>
    <test name="family">
      <string>{{ pt_sans_family | default('PT Sans') }}</string>
    </test>
    <test name="size" compare="less_eq">
      <!-- Size threshold (in points) below which PT Sans Caption is used instead of PT Sans -->
      <double>{{ pt_sans_caption_threshold | default('8.0') }}</double>
    </test>
    <edit name="family" mode="prepend" binding="same">
      <!-- Family name for the Caption variant -->
      <string>{{ pt_sans_caption_family | default('PT Sans Caption') }}</string>
    </edit>
  </match>

  <!--
    Aliasing: Caption <-> Standard
    ------------------------------
    Makes PT Sans Caption and PT Sans interchangeable.
  -->
  <alias binding="same">
    <family>{{ pt_sans_caption_family | default('PT Sans Caption') }}</family>
    <accept>
      <family>{{ pt_sans_family | default('PT Sans') }}</family>
    </accept>
  </alias>
  <alias binding="same">
    <family>{{ pt_sans_family | default('PT Sans') }}</family>
    <accept>
      <family>{{ pt_sans_caption_family | default('PT Sans Caption') }}</family>
    </accept>
  </alias>
</fontconfig>
