# NIS client/server startup options
NISDOMAIN={{ nis_domain }}

# NIS server: set to yes to enable the NIS server
NISSERVER={{ nis_server | lower }}

# NIS client: set to yes to enable NIS lookups (typically always yes when NISDOMAIN is set)
NISCLIENT={{ nis_client | lower }}

# Path to the NIS server(s); colon-separated for fallback servers
NISSERVERS="{{ nis_servers | join(':') }}"

# Options passed to ypserv (NIS server daemon)
YPSERVOPTS="{{ ypserv_opts }}"

# Options passed to yppasswdd (NIS password daemon)
YPPASSWDDOPTS="{{ yppasswdd_opts }}"

# Options passed to rpc.ybind (RPC binding daemon)
RPCBINDOPTS="{{ rpcbind_opts }}"

# Set to yes to enable NIS+ compatibility (deprecated)
NISPLUS={{ nisplus_enabled | lower }}

# Timeout (in seconds) for NIS lookups
NISTIMEOUT={{ nis_timeout }}

# Retries for NIS lookups
NISRETRIES={{ nis_retries }}
