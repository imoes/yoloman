{
  "port": 6789,
  "device": "/dev/ttyS0",
  "wpm": 25,
  "weight": 50,
  "parallel": false,
  "serial": true,
  "minspace": 30,
  "maxspace": 120,
  "maxwordspace": 300,
  "allowed_clients": [
    "127.0.0.1",
    "192.168.1.0/24"
  ],
  "denied_clients": [
    "10.0.0.0/8"
  ],
  "user": "cwdaemon",
  "pidfile": "/run/cwdaemon/cwdaemon.pid",
  "loglevel": 2,
  "logfile": "/var/log/cwdaemon.log",
  "invert_key": false,
  "use_dtr": false
}
