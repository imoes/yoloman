# /etc/default/cwdaemon
# Configuration defaults for cwdaemon (CW keyer daemon)
# This file is sourced by the init system or systemd unit.

# Device node for the key interface (serial or parallel port).
# Must be specified without /dev/ prefix (e.g., ttyS0, parport0).
# Use 'null' for no port keying (software-only or other mechanism).
DEVICE="{{ device | default('parport0') }}"

# UDP port on which cwdaemon listens for client connections.
UDPPORT="{{ port | default('6789') }}"

# Morse code transmit speed in words per minute (WPM).
SPEED="{{ wpm | default('24') }}"

# PTT (push-to-talk) delay in milliseconds.
PTTDELAY="{{ ptt_delay | default('0') }}"

# Audio output gain (0–100), only applicable if cwdaemon is built with audio support.
VOLUME="{{ audio_gain | default('70') }}"

# Dit/dah timing weight (50 = straight key; lower = faster dits, higher = slower dits).
WEIGHT="{{ weight | default('0') }}"