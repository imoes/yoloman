{
  "ltsp_image_root": "/opt/ltsp",
  "arch": "amd64",
  "dhcp_enabled": true,
  "dhcp_range_start": "10.0.0.100",
  "dhcp_range_end": "10.0.0.200",
  "dhcp_gateway": "10.0.0.1",
  "dhcp_dns": [
    "10.0.0.1",
    "8.8.8.8"
  ],
  "dhcp_broadcast": "10.0.0.255",
  "dhcp_next_server": "10.0.0.1",
  "dhcp_filename": "ltsp/amd64/pxelinux.0",
  "dhcp_extra_options": {},
  "nfs_export_enabled": true,
  "nfs_export_path": "/opt/ltsp",
  "nfs_export_options": "ro,no_root_squash,async,no_subtree_check",
  "tftp_root": "/var/lib/tftpboot",
  "tftp_enabled": true,
  "log_level": 4,
  "log_file": "/var/log/ltsp-server.log",
  "nfs_no_root_squash": true,
  "https_enabled": false,
  "https_port": 8443,
  "client_ssh_enabled": false,
  "client_env": {
    "XSERVER": "xorg",
    "XMODE": "1024x768",
    "LANG": "en_US.UTF-8"
  },
  "client_overrides": [
    {
      "hostname": "00:11:22:33:44:55",
      "xmode": "1920x1080",
      "locale": "de_DE.UTF-8"
    },
    {
      "hostname": "printer-client",
      "xserver": "xvfb",
      "nosound": "true"
    }
  ]
}
