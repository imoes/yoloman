# xml2 filter configuration wrapper
# Note: xml2 is a filter utility (stdin->stdout) and does not typically have a persistent configuration file.
# This template represents a hypothetical 'wrapper config' for an xml2 service wrapper,
# allowing deployment scripts or environment files to set default behaviors and logging.

# The log level for the wrapper script or service managing xml2 invocations.
# Accepted values typically include: debug, info, warning, error, critical.
LOG_LEVEL={{ log_level | default('warning') }}

# Optional path to an XSLT stylesheet to be used in conjunction with xml2 if used in an XSLT pipeline.
# If left empty, xml2 will operate without XSLT transformation.
XSLT_STYLESHEET={{ xslt_stylesheet | default('') }}

# The default input format for the xml2 filter.
# Common values: xml, html, csv. Determines how the input stream is parsed.
INPUT_FORMAT={{ input_format | default('xml') }}

# The default output format for the xml2 filter.
# Common values: flat, xml, html, csv. Determines the structure of the output stream.
OUTPUT_FORMAT={{ output_format | default('flat') }}