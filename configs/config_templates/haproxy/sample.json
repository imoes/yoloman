{
  "maxconn": 2000,
  "user": "haproxy",
  "group": "haproxy",
  "log_level": "global",
  "mode": "http",
  "timeout_connect": "5000ms",
  "timeout_client": "50000ms",
  "timeout_server": "50000ms",
  "http_port": 80,
  "tls_enabled": true,
  "https_port": 443,
  "ssl_cert_pem": "/etc/haproxy/certs/site.pem",
  "ssl_min_version": "TLSv1.2",
  "ssl_ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305",
  "redirect_to_https": true,
  "hsts": true,
  "backend_name": "web_servers",
  "balance_algorithm": "roundrobin",
  "backend_servers": [
    { "name": "web1", "address": "10.0.0.1", "port": 8080, "check": true },
    { "name": "web2", "address": "10.0.0.2", "port": 8080, "check": true }
  ]
}
