{
  "maxconn": 2000,
  "user": "haproxy",
  "group": "haproxy",
  "log_level": "global",
  "mode": "http",
  "timeout_connect": "5000ms",
  "timeout_client": "50000ms",
  "timeout_server": "50000ms",
  "http_port": 80,
  "backend_name": "web_servers",
  "balance_algorithm": "roundrobin",
  "backend_servers": [
    {
      "name": "web1",
      "address": "10.0.0.1",
      "port": 8080,
      "check": true
    },
    {
      "name": "web2",
      "address": "10.0.0.2",
      "port": 8080,
      "check": true
    }
  ]
}