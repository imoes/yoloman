# Configuration for DEP-11 HiDPI Icon Acquisition via APT
# This file controls the download of large (HiDPI) icons for software
# centers like GNOME Software and Plasma Discover.

# Pixel dimension of icons (e.g., '128' for 128x128px)
# Default: 128
Acquire::IndexTargets {
    deb::DEP-11-icons-hidpi {
        # Whether to enable DEP-11 HiDPI icon downloads by default
        # Valid values: "true" or "false" (string type required for APT config)
        # Default: true
        DefaultEnabled "{{ default_enabled | default('true') }}";
    };
};