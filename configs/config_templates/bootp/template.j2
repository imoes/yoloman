# /etc/bootptab: Configuration database for the bootp server (/usr/sbin/bootpd)
#
# This file maps bootp clients to their boot parameters.
# Each line represents a client entry. The first field is the hostname
# (tab-separated from the options). Options are key=value pairs.
#
# See bootptab(5) for details on option codes and format.

{{ hostname | default('clienthost') }}\ths={{ hardware_type | default('et') }}\tha={{ hardware_address | default('01:02:03:04:05:06') }}\tip={{ client_ip | default('192.168.1.100') }}\tsa={{ boot_server_address | default('192.168.1.1') }}\tsm={{ subnet_mask | default('255.255.255.0') }}\tbf={{ bootfile | default('boot.img') }}\tdn={{ domain_name | default('example.com') }}\tds={{ domain_name_servers | default('192.168.1.2,192.168.1.3') }}\tgw={{ gateways | default('192.168.1.1') }}\trp={{ root_path | default('/srv/nfs/root') }}\ttd={{ tftp_directory | default('/srv/tftp') }}\tbn={{ broadcast_flag | default('0') }}