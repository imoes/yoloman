; priority=25
; Extension: php8.4-http
;
; This directive loads the PHP HTTP extension module (pecl_http) into the PHP interpreter.
; It is typically used for advanced HTTP-related features in PHP applications.
; See also: http://php.net/manual/en/book.http.php
;
; extension_name: The name of the PHP extension module to load.
extension={{ extension_name | default('http') }}.so