# Netplan configuration (YAML v2)
# Declarative network configuration for systemd-networkd or NetworkManager backends.
# This template generates a valid netplan configuration file.
# Each field is documented with its schema description and default value.

network:
  # Network configuration version (fixed by netplan schema)
  version: 2

  # Network backend renderer to use. Options: 'systemd-networkd', 'NetworkManager'.
  # Leave empty for auto-selection. Default: 'systemd-networkd'
  renderer: "{{ renderer | default('systemd-networkd') }}"

{% if ethernets | default([]) | length > 0 %}
  # List of Ethernet interfaces to configure
  ethernets:
{% for eth in ethernets | default([]) %}
    # Ethernet interface configuration
    "{{ eth.id | default('') }}":
{% if eth.match | default({}) %}
      # Match criteria for identifying the interface (e.g. MAC address)
      match:
        {{ eth.match | default({}) | to_nice_yaml(indent=6, width=1000) | indent(6, true) | replace('\n', '\n      ') | replace(': ', ':') | replace('  -', '    -') }}
{% endif %}
{% if eth.set_name | default(false) %}
      # Rename the interface to the specified name
      set-name: "{{ eth.set_name }}"
{% endif %}
{% if eth.dhcp4 | default(true) %}
      # Enable DHCPv4
      dhcp4: {{ eth.dhcp4 | default(true) | tojson }}
{% endif %}
{% if eth.dhcp6 | default(false) %}
      # Enable DHCPv6
      dhcp6: {{ eth.dhcp6 | default(false) | tojson }}
{% endif %}
{% if eth.dhcp4_overrides | default({}) or eth.dhcp6_overrides | default({}) %}
      # DHCP overrides configuration
      dhcp-overrides:
{% if eth.dhcp4_overrides | default({}) %}
        # DHCPv4 overrides
        route-metric: {{ (eth.dhcp4_overrides | default({})).route_metric | default(100) }}
{% if (eth.dhcp4_overrides | default({})).use_dns | default(false) %}
        use-dns: {{ (eth.dhcp4_overrides | default({})).use_dns | default(false) | tojson }}
{% endif %}
{% if (eth.dhcp4_overrides | default({})).use_ntp | default(false) %}
        use-ntp: {{ (eth.dhcp4_overrides | default({})).use_ntp | default(false) | tojson }}
{% endif %}
{% if (eth.dhcp4_overrides | default({})).use_routes | default(true) %}
        use-routes: {{ (eth.dhcp4_overrides | default({})).use_routes | default(true) | tojson }}
{% endif %}
{% endif %}
{% if eth.dhcp6_overrides | default({}) %}
        # DHCPv6 overrides
        route-metric: {{ (eth.dhcp6_overrides | default({})).route_metric | default(100) }}
{% if (eth.dhcp6_overrides | default({})).use_dns | default(false) %}
        use-dns: {{ (eth.dhcp6_overrides | default({})).use_dns | default(false) | tojson }}
{% endif %}
{% if (eth.dhcp6_overrides | default({})).use_ntp | default(false) %}
        use-ntp: {{ (eth.dhcp6_overrides | default({})).use_ntp | default(false) | tojson }}
{% endif %}
{% if (eth.dhcp6_overrides | default({})).use_routes | default(true) %}
        use-routes: {{ (eth.dhcp6_overrides | default({})).use_routes | default(true) | tojson }}
{% endif %}
{% endif %}
{% endif %}
{% if eth.addresses | default([]) %}
      # Static IP addresses
      addresses:
{% for addr in eth.addresses | default([]) %}
        - "{{ addr }}"
{% endfor %}
{% endif %}
{% if eth.gateway4 | default('') %}
      # Default gateway for IPv4
      gateway4: "{{ eth.gateway4 }}"
{% endif %}
{% if eth.gateway6 | default('') %}
      # Default gateway for IPv6
      gateway6: "{{ eth.gateway6 }}"
{% endif %}
{% if eth.nameservers | default({}) %}
      # DNS server configuration
      nameserver:
{% if (eth.nameservers | default({})).addresses | default([]) %}
        addresses:
{% for addr in (eth.nameservers | default({})).addresses | default([]) %}
          - "{{ addr }}"
{% endfor %}
{% endif %}
{% if (eth.nameservers | default({})).search | default([]) %}
        search:
{% for domain in (eth.nameservers | default({})).search | default([]) %}
          - "{{ domain }}"
{% endfor %}
{% endif %}
{% endif %}
{% if eth.routings | default([]) %}
      # Static routes
      routes:
{% for route in eth.routings | default([]) %}
        - to: "{{ route.to | default('') }}"
{% if route.via | default('') %}
          via: "{{ route.via }}"
{% endif %}
{% if route.metric | default(0) %}
          metric: {{ route.metric | default(0) }}
{% endif %}
{% if route.from | default('') %}
          from: "{{ route.from }}"
{% endif %}
{% if route.table | default(0) %}
          table: {{ route.table | default(0) }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

{% if bridges | default([]) | length > 0 %}
  # List of Linux bridges to configure
  bridges:
{% for br in bridges | default([]) %}
    # Bridge interface configuration
    "{{ br.id | default('') }}":
      interfaces:
{% for iface in br.interfaces | default([]) %}
        - "{{ iface }}"
{% endfor %}
{% if br.parameters | default({}) %}
      # Bridge parameters
      parameters:
{% if (br.parameters | default({})).stp | default(true) %}
        stp: {{ (br.parameters | default({})).stp | default(true) | tojson }}
{% endif %}
{% if (br.parameters | default({})).forward_delay | default(15) %}
        forward-delay: {{ (br.parameters | default({})).forward_delay | default(15) }}
{% endif %}
{% if (br.parameters | default({})).ageing_time | default(300) %}
        ageing-time: {{ (br.parameters | default({})).ageing_time | default(300) }}
{% endif %}
{% if (br.parameters | default({})).hello_time | default(2) %}
        hello-time: {{ (br.parameters | default({})).hello_time | default(2) }}
{% endif %}
{% if (br.parameters | default({})).max_age | default(20) %}
        max-age: {{ (br.parameters | default({})).max_age | default(20) }}
{% endif %}
{% if (br.parameters | default({})).priority | default(128) %}
        priority: {{ (br.parameters | default({})).priority | default(128) }}
{% endif %}
{% endif %}
{% if br.dhcp4 | default(true) %}
      dhcp4: {{ br.dhcp4 | default(true) | tojson }}
{% endif %}
{% if br.dhcp6 | default(false) %}
      dhcp6: {{ br.dhcp6 | default(false) | tojson }}
{% endif %}
{% if br.addresses | default([]) %}
      addresses:
{% for addr in br.addresses | default([]) %}
        - "{{ addr }}"
{% endfor %}
{% endif %}
{% if br.gateway4 | default('') %}
      gateway4: "{{ br.gateway4 }}"
{% endif %}
{% if br.gateway6 | default('') %}
      gateway6: "{{ br.gateway6 }}"
{% endif %}
{% if br.nameservers | default({}) %}
      nameserver:
{% if (br.nameservers | default({})).addresses | default([]) %}
        addresses:
{% for addr in (br.nameservers | default({})).addresses | default([]) %}
          - "{{ addr }}"
{% endfor %}
{% endif %}
{% if (br.nameservers | default({})).search | default([]) %}
        search:
{% for domain in (br.nameservers | default({})).search | default([]) %}
          - "{{ domain }}"
{% endfor %}
{% endif %}
{% endif %}
{% if br.routings | default([]) %}
      routes:
{% for route in br.routings | default([]) %}
        - to: "{{ route.to | default('') }}"
{% if route.via | default('') %}
          via: "{{ route.via }}"
{% endif %}
{% if route.metric | default(0) %}
          metric: {{ route.metric | default(0) }}
{% endif %}
{% if route.from | default('') %}
          from: "{{ route.from }}"
{% endif %}
{% if route.table | default(0) %}
          table: {{ route.table | default(0) }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

{% if vlans | default([]) | length > 0 %}
  # List of VLAN interfaces
  vlans:
{% for vlan in vlans | default([]) %}
    # VLAN interface configuration
    "{{ vlan.id | default('') }}":
      id: {{ vlan.vlan_id | default(0) }}
      link: "{{ vlan.link | default('') }}"
{% if vlan.addresses | default([]) %}
      addresses:
{% for addr in vlan.addresses | default([]) %}
        - "{{ addr }}"
{% endfor %}
{% endif %}
{% if vlan.gateway4 | default('') %}
      gateway4: "{{ vlan.gateway4 }}"
{% endif %}
{% if vlan.gateway6 | default('') %}
      gateway6: "{{ vlan.gateway6 }}"
{% endif %}
{% if vlan.dhcp4 | default(true) %}
      dhcp4: {{ vlan.dhcp4 | default(true) | tojson }}
{% endif %}
{% if vlan.dhcp6 | default(false) %}
      dhcp6: {{ vlan.dhcp6 | default(false) | tojson }}
{% endif %}
{% if vlan.nameservers | default({}) %}
      nameserver:
{% if (vlan.nameservers | default({})).addresses | default([]) %}
        addresses:
{% for addr in (vlan.nameservers | default({})).addresses | default([]) %}
          - "{{ addr }}"
{% endfor %}
{% endif %}
{% if (vlan.nameservers | default({})).search | default([]) %}
        search:
{% for domain in (vlan.nameservers | default({})).search | default([]) %}
          - "{{ domain }}"
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

{% if wifis | default([]) | length > 0 %}
  # List of Wi-Fi interfaces (requires NetworkManager backend)
  wifis:
{% for wifi in wifis | default([]) %}
    # Wi-Fi interface configuration
    "{{ wifi.id | default('') }}":
      access-points:
{% for ap in wifi.access_points | default([]) %}
        "{{ ap.ssid | default('') }}":
          password: "{{ ap.password | default('') }}"
{% if ap.hidden | default(false) %}
          hidden: {{ ap.hidden | default(false) | tojson }}
{% endif %}
{% if ap.band | default('') %}
          band: "{{ ap.band }}"
{% endif %}
{% if ap.channel | default(0) %}
          channel: {{ ap.channel | default(0) }}
{% endif %}
{% endfor %}
{% if wifi.dhcp4 | default(true) %}
      dhcp4: {{ wifi.dhcp4 | default(true) | tojson }}
{% endif %}
{% if wifi.dhcp6 | default(false) %}
      dhcp6: {{ wifi.dhcp6 | default(false) | tojson }}
{% endif %}
{% if wifi.addresses | default([]) %}
      addresses:
{% for addr in wifi.addresses | default([]) %}
        - "{{ addr }}"
{% endfor %}
{% endif %}
{% if wifi.gateway4 | default('') %}
      gateway4: "{{ wifi.gateway4 }}"
{% endif %}
{% if wifi.gateway6 | default('') %}
      gateway6: "{{ wifi.gateway6 }}"
{% endif %}
{% if wifi.nameservers | default({}) %}
      nameserver:
{% if (wifi.nameservers | default({})).addresses | default([]) %}
        addresses:
{% for addr in (wifi.nameservers | default({})).addresses | default([]) %}
          - "{{ addr }}"
{% endfor %}
{% endif %}
{% if (wifi.nameservers | default({})).search | default([]) %}
        search:
{% for domain in (wifi.nameservers | default({})).search | default([]) %}
          - "{{ domain }}"
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}