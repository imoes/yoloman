{
  "renderer": "systemd-networkd",
  "ethernets": [
    {
      "id": "eth0",
      "match": {
        "macaddress": "52:54:00:ab:cd:ef"
      },
      "set_name": "mgmt",
      "dhcp4": false,
      "addresses": [
        "192.168.1.10/24"
      ],
      "gateway4": "192.168.1.1",
      "nameservers": {
        "addresses": [
          "8.8.8.8",
          "1.1.1.1"
        ],
        "search": [
          "example.com",
          "internal.lan"
        ]
      },
      "routings": [
        {
          "to": "10.0.0.0/8",
          "via": "192.168.1.1",
          "metric": 100
        }
      ]
    },
    {
      "id": "eth1",
      "match": {
        "name": "enp1s0"
      },
      "dhcp4": true,
      "dhcp6": true,
      "dhcp4_overrides": {
        "route_metric": 200
      },
      "nameservers": {
        "addresses": [],
        "search": []
      }
    }
  ],
  "bridges": [
    {
      "id": "br0",
      "interfaces": [
        "eth2",
        "eth3"
      ],
      "parameters": {
        "stp": true,
        "forward_delay": 10
      },
      "addresses": [
        "10.0.0.1/24"
      ],
      "dhcp4": false
    }
  ],
  "vlans": [],
  "wifis": [
    {
      "id": "wlan0",
      "access_points": [
        {
          "ssid": "CorporateWiFi",
          "password": "supersecret",
          "band": "5",
          "channel": 36
        }
      ],
      "dhcp4": true,
      "dhcp6": true
    }
  ]
}
