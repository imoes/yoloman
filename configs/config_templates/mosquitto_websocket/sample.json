{
  "websocket_port": 1883,
  "websocket_bind_address": "0.0.0.0",
  "max_websocket_connections": 200,
  "websocket_keepalive": 60,
  "websocket_idle_timeout": 300,
  "enable_tls": true,
  "tls_version": "tlsv1.2",
  "tls_cert_file": "/etc/letsencrypt/live/mqtt.example.com/fullchain.pem",
  "tls_key_file": "/etc/letsencrypt/live/mqtt.example.com/privkey.pem",
  "tls_ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "require_auth": true,
  "password_file": "/etc/mosquitto/passwd",
  "allow_anonymous": false,
  "log_file": "/var/log/mosquitto/websocket.log",
  "persistence_dir": "/var/lib/mosquitto"
}
