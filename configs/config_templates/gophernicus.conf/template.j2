# =============================================================================
# Gophernicus Server Configuration Template
# =============================================================================
# This file configures the Gophernicus Gopher server daemon.
# It is generated by Ansible. Do not edit manually.
# =============================================================================

# -----------------------------------------------------------------------------
# Network Listener Configuration
# -----------------------------------------------------------------------------

# The TCP port on which the Gophernicus server listens for incoming connections.
# Default: 70 (standard Gopher port)
PORT={{ port | default(70) }}

# The local IP address or hostname the server binds to.
# Use '0.0.0.0' to listen on all interfaces.
# Default: '0.0.0.0'
HOST={{ host | default('0.0.0.0') }}

# -----------------------------------------------------------------------------
# Filesystem & Serving Configuration
# -----------------------------------------------------------------------------

# The filesystem path to the directory served as the Gopher root.
# Default: '/var/gopher'
ROOT={{ root | default('/var/gopher') }}

# If true, automatically generate directory listings for browsable Gopher directories.
# Default: True
DIRINDEX={{ dirindex | default(True) }}

# If true, suppress directory listings even when DIRINDEX is enabled.
# This overrides DIRINDEX if set to true.
# Default: False
NO_DIRLIST={{ no_dirlist | default(False) }}

# If true, hide files and directories whose names start with a dot (.) in directory listings.
# This is a security/usability feature to prevent exposure of hidden config files.
# Default: True
HIDE_DOTFILES={{ hide_dotfiles | default(True) }}

# -----------------------------------------------------------------------------
# Connection Limits & Timeouts
# -----------------------------------------------------------------------------

# Maximum number of simultaneous client connections.
# Set to 0 for no limit.
# Default: 0
MAXCONN={{ maxconn | default(0) }}

# Session timeout in seconds.
# The man page specifies a default of 1800.
# Default: 1800
TIMEOUT={{ timeout | default(1800) }}

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# If true, log messages to the system syslog daemon.
# The config file usually enables logging by default unless explicitly disabled via -ns.
# Default: True
SYSLOG={{ syslog | default(True) }}

# If true, write access logs to a file.
# The man page states logging to file is disabled by default (-l).
# If false, logs are sent to syslog (if SYSLOG is true) or discarded.
# Default: False
LOG_TO_FILE={{ log_to_file | default(False) }}

# Path to the log file used when log_to_file is enabled.
# Ensure the directory exists and is writable by the Gopher server user.
# Default: '/var/log/gophernicus/access.log'
LOGFILE={{ logfile | default('/var/log/gophernicus/access.log') }}

# If true, include client IP addresses in log output.
# Useful for auditing and access control analysis.
# Default: True
LOG_IP={{ log_ip | default(True) }}

# -----------------------------------------------------------------------------
# Server Identity & Description
# -----------------------------------------------------------------------------

# List of user-facing server descriptions (shown in server info page).
# These appear on the info.gopher entry point.
{% for desc in server_descriptions | default(['Welcome to my Gopher server!', 'Public domain content available here.']) %}
{{ desc }}
{% endfor %}

# The public name of this Gopher server (used in banners, info pages, and server responses).
# Mapped to -D in man page.
# Default: 'Gophernicus Server'
SERVERNAME={{ servername | default('Gophernicus Server') }}

# -----------------------------------------------------------------------------
# File Type Handling
# -----------------------------------------------------------------------------

# Default gopher filetype setting (-t).
# The man page default is 0.
# Values: 0=none, 1=text, 2=hex, 3=csync, 4=telnet, 5=ftp, 6=mailto
# Note: The previous value of 1 (automatic gophermap generation) is not a
# standard filetype code in modern Gophernicus; 0 is the safe default.
# Default: 0
GMAPMODE={{ gmapmode | default(0) }}

# Virtual host prefix (e.g., 'gopher.example.com/') if supported by compiled version.
# Leave empty to disable.
# Default: ''
VHOSTPREFIX={{ vhostprefix | default('') }}

# List of file extension → MIME type mappings for custom type handling.
# Mapped to -e ext=type in the man page.
# Format per line: MIME_<extension>=<mime_type>
# Example: MIME_html=text/html
{% for rule in mime_overrides | default([{'ext': 'html', 'mime': 'text/html'}, {'ext': 'txt', 'mime': 'text/plain'}, {'ext': 'png', 'mime': 'image/png'}]) %}
MIME_{{ rule.ext | replace('.', '_') | default('') }}={{ rule.mime | default('') }}
{% endfor %}

# MIME type assigned to files without a known extension or override.
# Default: 'text/plain'
DEFAULT_MIME={{ default_mime | default('text/plain') }}

# -----------------------------------------------------------------------------
# Access Control (IP Filtering)
# -----------------------------------------------------------------------------

# List of IP addresses or CIDR ranges to block from accessing the server.
# These IPs are explicitly denied unless WHITELIST_MODE is active (see below).
{% for ip in banned_ips | default([]) %}
BANIP={{ ip }}
{% endfor %}

# If true, block all IPs EXCEPT those explicitly listed in 'banned_ips'.
# In this mode, 'banned_ips' acts as a WHITELIST of allowed addresses.
# If false (default), 'banned_ips' acts as a BLACKLIST of denied addresses.
# Default: False
WHITELIST_MODE={{ whitelist_mode | default(False) }}