{
  "port": 70,
  "host": "0.0.0.0",
  "root": "/var/gopher",
  "maxconn": 50,
  "timeout": 60,
  "syslog": true,
  "log_to_file": true,
  "logfile": "/var/log/gophernicus/access.log",
  "dirindex": true,
  "server_descriptions": [
    "Welcome to the Gopher Archive!",
    "Free software and public documents."
  ],
  "servername": "GopherArchive",
  "gmapmode": 1,
  "vhostprefix": "",
  "mime_overrides": [
    {
      "ext": "html",
      "mime": "text/html"
    },
    {
      "ext": "txt",
      "mime": "text/plain"
    },
    {
      "ext": "png",
      "mime": "image/png"
    }
  ],
  "default_mime": "text/plain",
  "banned_ips": [
    "203.0.113.5",
    "198.51.100.0/24"
  ],
  "whitelist_mode": false,
  "no_dirlist": false,
  "hide_dotfiles": true,
  "log_ip": true
}
