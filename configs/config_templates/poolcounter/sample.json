{
  "listeners": [
    {
      "type": "unix",
      "path": "/run/poolcounter/poolcounter.sock"
    },
    {
      "type": "tcp",
      "host": "0.0.0.0",
      "port": 7900
    }
  ],
  "max_backlog": 256,
  "num_workers": 4,
  "max_reqs_per_worker": 50,
  "log_level": "info",
  "log_dest": "/var/log/poolcounter.log",
  "client_timeout": 60,
  "enable_stats": true,
  "stats_host": "127.0.0.1",
  "stats_port": 9100,
  "unix_socket_perms": "0666",
  "allowed_networks": [
    "127.0.0.0/8",
    "10.0.0.0/8"
  ],
  "pid_file": "/run/poolcounter/poolcounter.pid"
}
