###########################################################################
# This is a very simple sample configuration file sufficient to start an  #
{% if xrootd_port is defined and xrootd_port is not none and (xrootd_port is number or xrootd_port is boolean or xrootd_port | length > 0) %}xrootd data server using the default port {{ xrootd_port | default(1094) }} and its companion cmsd.  #
{% else %}# xrootd data server using the default port 1094 and its companion cmsd.  #
{% endif %}# Trying to use the xrootd will cause the client to simply wait because   #
# there is no redirector and this configuration file is insufficient to   #
# start one. Consult the reference manuals on how to create a usable      #
# configuration file to completely describe a functional xrootd cluster.  #
#                                                                         #
# On start-up the xrootd will complain about not connecting to the pipe   #
{% if xrootd_admin_path is defined and xrootd_admin_path is not none and (xrootd_admin_path is number or xrootd_admin_path is boolean or xrootd_admin_path | length > 0) %}named '{{ xrootd_admin_path | default("/var/spool/xrootd") }}/.olb/olbd.admin'. This will continue until the #
{% else %}# named '/var/spool/xrootd/.olb/olbd.admin'. This will continue until the #
{% endif %}# cmsd starts. When the cmsd start is will say ' Waiting for primary      #
# server to login.' Once xrootd is started and connects to the cmsd, the  #
# cmsd will complain 'Unable to connect socket to {{ xrootd_manager_host | default("localhost") }}' because      #
# there is no redirector. However, this shows that xrootd and cmsd have   #
# been correctly installed.                                               #
#                                                                         #
# Note: You should always create a *single* configuration file and use it #
# when starting each daemon that you need to run in the cluster!          #
###########################################################################

# The export directive indicates which paths are to be exported. While the
{% if xrootd_export_path is defined and xrootd_export_path is not none and (xrootd_export_path is number or xrootd_export_path is boolean or xrootd_export_path | length > 0) %}default is '{{ xrootd_export_path | default("/tmp") }}', we indicate it anyway and add the 'stages attribute
{% else %}# default is '/tmp', we indicate it anyway and add the 'stages attribute
{% endif %}{% if xrootd_export_path is defined and xrootd_export_path is not none and (xrootd_export_path is number or xrootd_export_path is boolean or xrootd_export_path | length > 0) %}to allow you to start the frm_xfrd to bring in missing files into '{{ xrootd_export_path | default("/tmp") }}'.
{% else %}# to allow you to start the frm_xfrd to bring in missing files into '/tmp'.
{% endif %}# Remove this attribute if you don't want to enable this feature.
#
all.export {{ xrootd_export_path | default("/tmp") }} stage

# The role directive tells xrootd to run as a data server as part of a
# cluster. The causes the xrootd to try to contact the local cmsd which
# needs to started as part of of initialization. As a side note, a
# redirector would have a manager role.
#
all.role server

# The cmsd running on a data server node needs to know where the redirector
# (i.e. manager) is running. In this generic config we simply say that it
# is on this host to allow initialization to succeed. However, the final
# result is not practically usable.
#
all.manager {{ xrootd_manager_host | default("localhost") }} {{ xrootd_manager_port | default(3121) }}

# The copycmd directive tells the frm_xfrd what to use to copy files into
# an exported path with the 'stage' attribute. Here we just say this will
{% if xrootd_copycmd_copy is defined and xrootd_copycmd_copy is not none and (xrootd_copycmd_copy is number or xrootd_copycmd_copy is boolean or xrootd_copycmd_copy | length > 0) %}be '{{ xrootd_copycmd_copy | default("/bin/cp") }}' to allow the frm_xfrd to actual start to show that it works.
{% else %}# be '/bin/cp' to allow the frm_xfrd to actual start to show that it works.
{% endif %}{% if xrootd_export_path is defined and xrootd_export_path is not none and (xrootd_export_path is number or xrootd_export_path is boolean or xrootd_export_path | length > 0) %}Here missing files are created in {{ xrootd_export_path | default("/tmp") }} as zero-length files.
{% else %}# Here missing files are created in /tmp as zero-length files.
{% endif %}#
frm.xfr.copycmd {{ xrootd_copycmd_copy | default("/bin/cp") }} /dev/null $PFN

# The adminpath and pidpath variables indicate where the pid and various
# IPC files should be placed
#
all.adminpath {{ xrootd_admin_path | default("/var/spool/xrootd") }}
all.pidpath {{ xrootd_pid_path | default("/run/xrootd") }}

# More configuration files can be added in /etc/xrootd/config.d/
# For example /etc/xrootd/config.d/10-mygrid.cfg and
# /etc/xrootd/config.d/98-mysite-specifics.cfg
#
continue /etc/xrootd/config.d/
