{
  "zones": [
    {
      "name": "example",
      "domain": "example.com",
      "file": "/var/lib/dnss/zones/example.com.db"
    },
    {
      "name": "internal",
      "domain": "internal.lan",
      "file": "/var/lib/dnss/zones/internal.lan.db"
    }
  ],
  "listen": [
    {
      "host": "0.0.0.0",
      "port": 53
    },
    {
      "host": "::",
      "port": 53
    }
  ],
  "forwarders": [
    {
      "address": "1.1.1.1",
      "port": 53
    },
    {
      "address": "9.9.9.9",
      "port": 53
    }
  ],
  "rate_limit": {
    "enabled": true,
    "max_queries_per_second": 50,
    "burst_size": 75
  },
  "cache": {
    "enabled": true,
    "size_mb": 128,
    "ttl_min": 30,
    "ttl_max": 43200
  },
  "logging": {
    "level": "warn",
    "file": "/var/log/dnss/dnss.log",
    "max_size_mb": 100,
    "max_backups": 3
  },
  "security": {
    "recursion": true,
    "dnssec_validation": true,
    "allow_query": [
      "any"
    ],
    "allow_transfer": [
      "none"
    ]
  }
}
