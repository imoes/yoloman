{
  "database_dir": "/var/lib/htdig",
  "document_dir": "/var/lib/htdig/docs",
  "log_file": "/var/log/htdig/htdig.log",
  "work_dir": "/var/tmp/htdig",
  "connection_timeout": 30,
  "max_hops": 5,
  "max_documents": 50000,
  "max_doc_size": 262144,
  "min_word_length": 3,
  "max_word_length": 100,
  "case_insensitive": true,
  "stemming": true,
  "fuzzy": false,
  "synonyms": false,
  "stem_language": "english",
  "user_agent": "htdig/3.2.0b6 (mysearch@example.org)",
  "result_template": "default",
  "result_template_file": "/etc/htdig/htdig.html",
  "results_per_page": 20,
  "default_sort_by": "score",
  "allowed_urls": [
    "^https?://example\\.com/[^admin]"
  ],
  "disallowed_urls": [
    "^https?://admin\\.example\\.com/",
    "^https?://.*\\.(cgi|php)$"
  ],
  "excluded_extensions": [
    "gif",
    "jpg",
    "png",
    "css",
    "js",
    "zip",
    "pdf"
  ],
  "server_host": "0.0.0.0",
  "server_port": 8080,
  "debug": false,
  "verbose": false,
  "fetchers": 8,
  "fetch_delay": 2,
  "retry_count": 5,
  "use_robots": true
}
