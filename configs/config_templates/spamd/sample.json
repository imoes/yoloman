{
  "bind_address": "127.0.0.1",
  "port": 783,
  "user": "spamd",
  "group": "spamd",
  "max_children": 20,
  "daemonize": false,
  "timeout_remote": 300,
  "timeout_local": 30,
  "max_children_idle": 5,
  "syslog_facility": "mail",
  "log_packets": false,
  "local_rules_dir": "/etc/spamd/local.rules.d",
  "rules_dir": "/etc/spamassassin",
  "bayes_backend": "DB_File",
  "bayes_path": "/var/lib/spamd/.spamassassin/bayes",
  "auto_whitelist_path": "/var/lib/spamd/.spamassassin/auto-whitelist",
  "whitelist_file": "/etc/spamd/whitelist",
  "blacklist_file": "/etc/spamd/blacklist",
  "extra_args": [
    "--pidfile=/run/spamd.pid",
    "--save-prefs"
  ]
}
