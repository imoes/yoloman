{
  "max_children": 5,
  "daemonize": false,
  "pidfile": "/run/spamd.pid",
  "bind_address": "127.0.0.1",
  "port": 783,
  "user": "spamd",
  "group": "spamd",
  "timeout_remote": 300,
  "timeout_local": 30,
  "max_children_idle": 5,
  "syslog_facility": "mail",
  "log_packets": false,
  "local_rules_dir": "/etc/spamd/local.rules.d",
  "rules_dir": "/etc/spamassassin",
  "bayes_backend": "DB_File",
  "bayes_path": "/var/lib/spamd/.spamassassin/bayes",
  "auto_whitelist_path": "/var/lib/spamd/.spamassassin/auto-whitelist",
  "whitelist_file": null,
  "blacklist_file": null,
  "extra_args": []
}
