{
  "service_name": "krb5",
  "server_principal": "host/webserver.example.com@EXAMPLE.COM",
  "socket_path": "/var/run/gssproxy.sock",
  "keytab": "/etc/gssproxy/http.keytab",
  "mechanism": "1.2.840.113554.1.2.2",
  "cred_store": "FILE:/run/gssproxy/%u.ccache",
  "allow_root": false,
  "allowed_euids": [
    0,
    498
  ],
  "allowed_gids": [
    0,
    986
  ],
  "debug": true,
  "extra_services": [
    {
      "name": "ldap",
      "server_principal": "ldap/ldap.example.com@EXAMPLE.COM",
      "keytab": "/etc/gssproxy/ldap.keytab",
      "cred_store": "MEMORY",
      "allowed_euids": [
        0,
        389
      ]
    }
  ],
  "hostname": "webserver.example.com",
  "realm": "EXAMPLE.COM"
}
