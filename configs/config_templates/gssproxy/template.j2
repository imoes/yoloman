# /etc/gssproxy/gssproxy.conf — GSSAPI Privilege Separation Daemon configuration
[service/krb5]
  # Service name — identifies this service block
  name = {{ service_name }}

  # Server principal — the SPN this service will accept
  server_principal = {{ server_principal }}

  # Socket path — where gssproxy listens for client connections
  socket_path = {{ socket_path }}

  # Keytab path — path to keytab file with credentials
  keytab = {{ keytab }}

  # Mechanism — GSSAPI mechanism OID or alias (e.g., '1.2.840.113554.1.2.2' or 'kerberos')
  mechanism = {{ mechanism }}

  # Credential cache type — 'FILE' or 'MEMORY'
  cred_store = {{ cred_store }}

  # Allow root to use this service
  allow_root = {{ 'true' if allow_root else 'false' }}

  # Allowed euid list — list of numeric UIDs allowed to use this service
{% for uid in allowed_euids %}  allowed_euid = {{ uid }}
{% endfor %}

  # Allowed gid list — list of numeric GIDs allowed to use this service
{% for gid in allowed_gids %}  allowed_gid = {{ gid }}
{% endfor %}

  # Enable debugging output
  debug = {{ 'true' if debug else 'false' }}

# Optional additional service blocks — repeat for multiple services
{% for svc in extra_services %}[service/{{ svc.name }}]
  name = {{ svc.name }}
  server_principal = {{ svc.server_principal }}
  socket_path = {{ svc.socket_path }}
  keytab = {{ svc.keytab }}
  mechanism = {{ svc.mechanism }}
  cred_store = {{ svc.cred_store }}
{% if svc.allow_root is defined %}  allow_root = {{ 'true' if svc.allow_root else 'false' }}
{% endif %}
{% if svc.allowed_euids is defined %}{% for uid in svc.allowed_euids %}  allowed_euid = {{ uid }}
{% endfor %}{% endif %}
{% if svc.allowed_gids is defined %}{% for gid in svc.allowed_gids %}  allowed_gid = {{ gid }}
{% endfor %}{% endif %}
{% if svc.debug is defined %}  debug = {{ 'true' if svc.debug else 'false' }}
{% endif %}
{% endfor %}
