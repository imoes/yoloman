# ==============================================================================
# ukopp Job Configuration File
# Generated by Ansible Jinja2 Template
#
# This file defines a backup/copy job for the ukopp utility.
# It specifies where to copy data, from where, how to manage old versions,
# and how to verify the copy integrity.
# ==============================================================================

# ------------------------------------------------------------------------------
# Command line mode: 'edit' for GUI job file editing, 'run' for batch execution.
# Note: -nogui is implicit when mode is 'run' unless explicitly disabled.
# ukopp primarily relies on CLI args, but this config serves as the persistent job file.
# ------------------------------------------------------------------------------

# Destination mount point or device path of the USB stick or disk-like device
# to copy files to. If the device is not mounted, ukopp may attempt to mount it
# or require it to be mounted beforehand depending on system configuration.
DESTINATION={{ destination | default('/mnt/usb-stick') }}

# List of source directories or files to include in the backup job.
# Each source path is defined by a SOURCE= directive below.
# The order of sources generally matters for some utilities (first match wins, etc.),
# but for ukopp, it typically defines the set of items to process.

{% for item in sources | default([{'path': '/home/user/documents'}, {'path': '/home/user/pictures'}]) %}
# Source path: {{ item.path | default('') }}
SOURCE={{ item.path | default('') }}
{% endfor %}

# Retention policy: The number of old file versions to keep on the destination
# media before overwriting or removing older versions.
# If the destination supports versioning, only the newest `retention_count`
# versions of any modified file will be retained.
RETENTION_COUNT={{ retention_count | default(3) }}

# Verification mode: The media verification mode to use after copying.
# Valid values are:
#   - 'full':    Verify every byte of every file against the source.
#   - 'incremental': Only verify files that have changed since the last copy.
#   - 'compare': Compare file metadata (size, date) and optionally content hashes.
# This ensures data integrity and detects silent corruption.
VERIFY_MODE={{ verify_mode | default('incremental') }}

# Preserve file owners and permissions on the copy media, even if it is a
# Microsoft file system (FAT32, NTFS, exFAT) which typically does not support
# Unix-style permissions. When enabled, ukopp may store this metadata in
# extended attributes or a sidecar file if the filesystem supports it,
# or simply ignore unsupported permission bits gracefully.
# Using lowercase 'true'/'false' is standard for most config parsers.
PRESERVE_PERMS={{ preserve_perms | default(true) | lower }}