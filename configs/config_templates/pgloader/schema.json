{
  "logfile": {
    "type": "string",
    "default": "/var/log/pgloader/pgloader.log",
    "description": "Filename where to send the logs."
  },
  "log_min_messages": {
    "type": "string",
    "default": "notice",
    "description": "Filter logs seen in the logfile (default: notice).",
    "enum": [
      "debug",
      "notice",
      "warning"
    ]
  },
  "client_min_messages": {
    "type": "string",
    "default": "warning",
    "description": "Filter logs seen at the console (default: warning).",
    "enum": [
      "debug",
      "notice",
      "warning"
    ]
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Be quiet."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Be verbose."
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Display debug level information."
  },
  "dry_run": {
    "type": "bool",
    "default": false,
    "description": "Only check database connections, don't load anything."
  },
  "on_error_stop": {
    "type": "bool",
    "default": false,
    "description": "Refrain from handling errors properly."
  },
  "no_ssl_cert_verification": {
    "type": "bool",
    "default": false,
    "description": "Instruct OpenSSL to bypass verifying certificates."
  },
  "root_dir": {
    "type": "string",
    "default": "/tmp/pgloader/",
    "description": "Output root directory."
  },
  "summary": {
    "type": "string",
    "default": "/tmp/pgloader/summary.txt",
    "description": "Filename where to copy the summary."
  },
  "encoding": {
    "type": "string",
    "default": "UTF8",
    "description": "Source expected encoding."
  },
  "type": {
    "type": "string",
    "default": "",
    "description": "Force input source type."
  },
  "field": {
    "type": "string",
    "default": "",
    "description": "Source file fields specification."
  },
  "cast": {
    "type": "string",
    "default": "",
    "description": "Specific cast rules."
  },
  "with_options": {
    "type": "list",
    "default": [],
    "description": "List of load options (e.g., 'csv fields terminated by \\\\t'). Items are strings."
  },
  "set_options": {
    "type": "list",
    "default": [],
    "description": "List of PostgreSQL options (e.g., 'search_path=public'). Items are strings."
  },
  "context": {
    "type": "string",
    "default": "",
    "description": "Command Context Variables."
  },
  "load_lisp_file": {
    "type": "list",
    "default": [],
    "description": "List of paths to Lisp files to load."
  },
  "before": {
    "type": "string",
    "default": "",
    "description": "SQL script to run before loading the data."
  },
  "after": {
    "type": "string",
    "default": "",
    "description": "SQL script to run after loading the data."
  },
  "upgrade_config": {
    "type": "bool",
    "default": false,
    "description": "Output the command(s) corresponding to .conf file for v2.x."
  },
  "list_encodings": {
    "type": "bool",
    "default": false,
    "description": "List pgloader known encodings and exit."
  },
  "self_upgrade": {
    "type": "string",
    "default": "",
    "description": "Path to pgloader newer sources."
  },
  "regress": {
    "type": "bool",
    "default": false,
    "description": "Drive regression testing."
  },
  "source": {
    "type": "string",
    "default": "",
    "description": "Source database or file URI."
  },
  "target": {
    "type": "string",
    "default": "",
    "description": "Target PostgreSQL database URI."
  },
  "command_file": {
    "type": "list",
    "default": [],
    "description": "List of command lines to execute in the pgloader command file."
  }
}
