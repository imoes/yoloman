{
  "logfile": "/var/log/pgloader/migration.log",
  "log_min_messages": "warning",
  "client_min_messages": "info",
  "quiet": false,
  "verbose": true,
  "debug": false,
  "dry_run": false,
  "on_error_stop": false,
  "no_ssl_cert_verification": false,
  "root_dir": "/var/lib/pgloader/",
  "summary": "/var/lib/pgloader/summary.txt",
  "encoding": "UTF8",
  "type": "",
  "field": "",
  "cast": "",
  "with_options": [
    "trim spaces",
    "csv fields terminated by ','"
  ],
  "set_options": [
    "search_path=public"
  ],
  "context": "mode=full",
  "load_lisp_file": [],
  "before": "TRUNCATE TABLE target_table;",
  "after": "",
  "upgrade_config": false,
  "list_encodings": false,
  "self_upgrade": "",
  "regress": false,
  "source": "mysql://user:pass@localhost/source_db",
  "target": "postgresql://user:pass@localhost/target_db",
  "command_file": [
    "LOAD CSV",
    "FROM '/data/input.csv'",
    "INTO postgresql://user:pass@localhost/target_db.public.target_table",
    "WITH truncate, create no tables, create no indexes",
    "FIELDS TERMINATED BY ','",
    "ENCODING UTF8"
  ]
}
