# =============================================================================
# pgloader command-line configuration
# =============================================================================
# This file is auto-generated by Ansible from the pgloader schema.
# It contains the command-line flags passed to pgloader(1).
#
# pgloader is a command-line utility, not a long-running daemon.
# It does not listen on any port and does not host network services.
# Therefore, this template only generates invocation arguments.
# =============================================================================

{# -----------------------------------------------------------------------------
   Section: Global Logging & Verbosity Options
   ----------------------------------------------------------------------------- #}

{# Logfile: Destination file for pgloader's log output. #}
{% if logfile is defined or logfile is not none %}
--logfile {{ logfile | default('/var/log/pgloader/pgloader.log') }}
{% endif %}

{# Log minimum messages: Filter log levels written to the logfile.
   Default is 'notice'. Valid levels: debug, info, notice, warning, error, fatal. #}
{% if log_min_messages is defined or log_min_messages is not none %}
--log-min-messages {{ log_min_messages | default('notice') }}
{% endif %}

{# Client minimum messages: Filter log levels displayed at the console.
   Default is 'warning'. #}
{% if client_min_messages is defined or client_min_messages is not none %}
--client-min-messages {{ client_min_messages | default('warning') }}
{% endif %}

{# Quiet mode: Suppress informational output to stdout.
   Default is False. #}
{% if quiet is defined or quiet is not none %}
{% if quiet | default(False) | bool %}
--quiet
{% endif %}
{% endif %}

{# Verbose mode: Output detailed processing information.
   Default is False. #}
{% if verbose is defined or verbose is not none %}
{% if verbose | default(False) | bool %}
--verbose
{% endif %}
{% endif %}

{# Debug mode: Output debug-level information for troubleshooting.
   Default is False. #}
{% if debug is defined or debug is not none %}
{% if debug | default(False) | bool %}
--debug
{% endif %}
{% endif %}

{# -----------------------------------------------------------------------------
   Section: Execution Control & Error Handling
   ----------------------------------------------------------------------------- #}

{# Dry run: Connect to source and target databases to verify connectivity,
   but do not actually load any data.
   Default is False. #}
{% if dry_run is defined or dry_run is not none %}
{% if dry_run | default(False) | bool %}
--dry-run
{% endif %}
{% endif %}

{# On error stop: If set, pgloader stops immediately upon encountering an error
   instead of skipping problematic rows/commands.
   Default is False. #}
{% if on_error_stop is defined or on_error_stop is not none %}
{% if on_error_stop | default(False) | bool %}
--on-error-stop
{% endif %}
{% endif %}

{# No SSL cert verification: Instruct OpenSSL to bypass verification of
   server certificates. Dangerous; use only for testing or self-signed certs.
   Default is False. #}
{% if no_ssl_cert_verification is defined or no_ssl_cert_verification is not none %}
{% if no_ssl_cert_verification | default(False) | bool %}
--no-ssl-cert-verification
{% endif %}
{% endif %}

{# -----------------------------------------------------------------------------
   Section: Output & Diagnostics
   ----------------------------------------------------------------------------- #}

{# Root directory: Root path for output files (e.g., CSV dumps, logs).
   Default is '/tmp/pgloader/'. #}
{% if root_dir is defined or root_dir is not none %}
--root-dir {{ root_dir | default('/tmp/pgloader/') }}
{% endif %}

{# Summary file: Path to the file where pgloader will copy the loading summary.
   Default is '/tmp/pgloader/summary.txt'. #}
{% if summary is defined or summary is not none %}
--summary {{ summary | default('/tmp/pgloader/summary.txt') }}
{% endif %}

{# -----------------------------------------------------------------------------
   Section: Source Configuration
   ----------------------------------------------------------------------------- #}

{# Encoding: Force the source expected encoding.
   Default is 'UTF8'. #}
{% if encoding is defined or encoding is not none %}
--encoding {{ encoding | default('UTF8') }}
{% endif %}

{# Type: Force the input source type (e.g., csv, mysql, postgres).
   If empty, pgloader autodetects. #}
{% if type is defined or type is not none %}
{% if type | default('') | trim | length > 0 %}
--type {{ type | default('') | trim }}
{% endif %}
{% endif %}

{# Field: Source file fields specification (e.g., for CSV parsing).
   If empty, pgloader uses defaults or autodetection. #}
{% if field is defined or field is not none %}
{% if field | default('') | trim | length > 0 %}
--field {{ field | default('') | trim }}
{% endif %}
{% endif %}

{# Cast: Specific cast rules for data conversion.
   If empty, no specific casts are forced via this flag. #}
{% if cast is defined or cast is not none %}
{% if cast | default('') | trim | length > 0 %}
--cast {{ cast | default('') | trim }}
{% endif %}
{% endif %}

{# With options: List of load options (e.g., 'csv fields terminated by \t').
   Items are strings. #}
{% if with_options is defined or with_options is not none %}
{% for opt in with_options | default([]) %}
--with {{ opt }}
{% endfor %}
{% endif %}

{# Set options: List of PostgreSQL session options (e.g., 'search_path=public').
   Items are strings. #}
{% if set_options is defined or set_options is not none %}
{% for opt in set_options | default([]) %}
--set {{ opt }}
{% endfor %}
{% endif %}

{# Context: Command Context Variables for dynamic loading logic.
   If empty, no context variables are set. #}
{% if context is defined or context is not none %}
{% if context | default('') | trim | length > 0 %}
--context {{ context | default('') | trim }}
{% endif %}
{% endif %}

{# Load Lisp file: List of paths to Lisp files to load for custom logic.
   Items are strings. #}
{% if load_lisp_file is defined or load_lisp_file is not none %}
{% for file in load_lisp_file | default([]) %}
--load-lisp-file {{ file }}
{% endfor %}
{% endif %}

{# Before: SQL script to run before loading the data.
   If empty, no pre-load script is executed. #}
{% if before is defined or before is not none %}
{% if before | default('') | trim | length > 0 %}
--before "{{ before | default('') }}"
{% endif %}
{% endif %}

{# After: SQL script to run after loading the data.
   If empty, no post-load script is executed. #}
{% if after is defined or after is not none %}
{% if after | default('') | trim | length > 0 %}
--after "{{ after | default('') }}"
{% endif %}
{% endif %}

{# -----------------------------------------------------------------------------
   Section: Maintenance & Utilities
   ----------------------------------------------------------------------------- #}

{# Upgrade config: Output the command(s) corresponding to .conf file for v2.x.
   Useful for migrating configurations.
   Default is False. #}
{% if upgrade_config is defined or upgrade_config is not none %}
{% if upgrade_config | default(False) | bool %}
--upgrade-config
{% endif %}
{% endif %}

{# List encodings: List pgloader known encodings and exit.
   Default is False. #}
{% if list_encodings is defined or list_encodings is not none %}
{% if list_encodings | default(False) | bool %}
--list-encodings
{% endif %}
{% endif %}

{# Self upgrade: Path to pgloader newer sources for self-upgrade check.
   If empty, no self-upgrade is attempted. #}
{% if self_upgrade is defined or self_upgrade is not none %}
{% if self_upgrade | default('') | trim | length > 0 %}
--self-upgrade {{ self_upgrade | default('') | trim }}
{% endif %}
{% endif %}

{# Regress: Drive regression testing.
   Default is False. #}
{% if regress is defined or regress is not none %}
{% if regress | default(False) | bool %}
--regress
{% endif %}
{% endif %}

{# -----------------------------------------------------------------------------
   Section: Source and Target Definitions
   ----------------------------------------------------------------------------- #}

{# Source: Source database or file URI (e.g., postgres://user@host/db).
   If empty, pgloader expects it from command line or context. #}
{% if source is defined or source is not none %}
{% if source | default('') | trim | length > 0 %}
SOURCE {{ source | default('') | trim }}
{% endif %}
{% endif %}

{# Target: Target PostgreSQL database URI (e.g., postgres://user@host/db).
   If empty, pgloader expects it from command line or context. #}
{% if target is defined or target is not none %}
{% if target | default('') | trim | length > 0 %}
TARGET {{ target | default('') | trim }}
{% endif %}
{% endif %}

{# Command file: List of command lines to execute in the pgloader command file.
   Items are strings. #}
{% if command_file is defined or command_file is not none %}
{% for cmd in command_file | default([]) %}
{{ cmd }}
{% endfor %}
{% endif %}