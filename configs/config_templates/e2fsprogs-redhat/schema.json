{
  "base_features": {
    "type": "string",
    "default": "sparse_super,large_file,filetype,resize_inode,dir_index,ext_attr",
    "description": "Comma-separated list of default filesystem features."
  },
  "default_mntopts": {
    "type": "string",
    "default": "acl,user_xattr",
    "description": "Default mount options."
  },
  "enable_periodic_fsck": {
    "type": "string",
    "default": "0",
    "description": "Enable periodic filesystem check (0 or 1).",
    "enum": [
      "0",
      "1"
    ]
  },
  "blocksize": {
    "type": "number",
    "default": 4096,
    "description": "Default filesystem block size."
  },
  "inode_size": {
    "type": "number",
    "default": 256,
    "description": "Default inode size."
  },
  "inode_ratio": {
    "type": "number",
    "default": 16384,
    "description": "Default inode ratio (bytes per inode)."
  },
  "ext4_features": {
    "type": "string",
    "default": "has_journal,extent,huge_file,flex_bg,metadata_csum,64bit,dir_nlink,extra_isize",
    "description": "Comma-separated list of features for ext4 filesystem type."
  },
  "rhel6_ext4_features": {
    "type": "string",
    "default": "has_journal,extent,huge_file,flex_bg,uninit_bg,dir_nlink,extra_isize",
    "description": "Comma-separated list of features for RHEL6 ext4 filesystem type."
  },
  "rhel6_ext4_inode_size": {
    "type": "number",
    "default": 256,
    "description": "Inode size for RHEL6 ext4 filesystem type."
  },
  "rhel6_ext4_enable_periodic_fsck": {
    "type": "string",
    "default": "1",
    "description": "Enable periodic fsck for RHEL6 ext4 (0 or 1).",
    "enum": [
      "0",
      "1"
    ]
  },
  "rhel6_ext4_default_mntopts": {
    "type": "string",
    "default": "",
    "description": "Default mount options for RHEL6 ext4."
  },
  "rhel7_ext4_features": {
    "type": "string",
    "default": "has_journal,extent,huge_file,flex_bg,uninit_bg,dir_nlink,extra_isize,64bit",
    "description": "Comma-separated list of features for RHEL7 ext4 filesystem type."
  },
  "rhel7_ext4_inode_size": {
    "type": "number",
    "default": 256,
    "description": "Inode size for RHEL7 ext4 filesystem type."
  },
  "rhel8_ext4_features": {
    "type": "string",
    "default": "has_journal,extent,huge_file,flex_bg,metadata_csum,64bit,dir_nlink,extra_isize",
    "description": "Comma-separated list of features for RHEL8 ext4 filesystem type."
  },
  "rhel8_ext4_inode_size": {
    "type": "number",
    "default": 256,
    "description": "Inode size for RHEL8 ext4 filesystem type."
  },
  "small_blocksize": {
    "type": "number",
    "default": 1024,
    "description": "Block size for 'small' filesystem type."
  },
  "small_inode_ratio": {
    "type": "number",
    "default": 4096,
    "description": "Inode ratio for 'small' filesystem type."
  },
  "floppy_blocksize": {
    "type": "number",
    "default": 1024,
    "description": "Block size for 'floppy' filesystem type."
  },
  "floppy_inode_ratio": {
    "type": "number",
    "default": 8192,
    "description": "Inode ratio for 'floppy' filesystem type."
  },
  "big_inode_ratio": {
    "type": "number",
    "default": 32786,
    "description": "Inode ratio for 'big' filesystem type."
  },
  "huge_inode_ratio": {
    "type": "number",
    "default": 65536,
    "description": "Inode ratio for 'huge' filesystem type."
  },
  "news_inode_ratio": {
    "type": "number",
    "default": 4096,
    "description": "Inode ratio for 'news' filesystem type."
  },
  "largefile_inode_ratio": {
    "type": "number",
    "default": 1048576,
    "description": "Inode ratio for 'largefile' filesystem type."
  },
  "largefile_blocksize": {
    "type": "number",
    "default": -1,
    "description": "Block size for 'largefile' filesystem type."
  },
  "largefile4_inode_ratio": {
    "type": "number",
    "default": 4194304,
    "description": "Inode ratio for 'largefile4' filesystem type."
  },
  "largefile4_blocksize": {
    "type": "number",
    "default": -1,
    "description": "Block size for 'largefile4' filesystem type."
  },
  "hurd_blocksize": {
    "type": "number",
    "default": 4096,
    "description": "Block size for 'hurd' filesystem type."
  },
  "hurd_inode_size": {
    "type": "number",
    "default": 128,
    "description": "Inode size for 'hurd' filesystem type."
  },
  "hurd_warn_y2038_dates": {
    "type": "string",
    "default": "0",
    "description": "Warn about Y2038 dates for 'hurd' filesystem type (0 or 1).",
    "enum": [
      "0",
      "1"
    ]
  }
