{
  "include_cwd": true,
  "include_env": false,
  "flat_output": false,
  "resolve_full_path": true,
  "suppress_args": true,
  "show_exit_status": true,
  "show_user": false,
  "output_file": "/var/log/extrace.log",
  "trace_pid": 1,
  "trace_cmd": [
    "/bin/bash",
    "-c",
    "sleep 3600"
  ]
}
