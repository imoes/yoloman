{
  "include_cwd": {
    "type": "bool",
    "default": false,
    "description": "Print current working directory of new process (-d)"
  },
  "include_env": {
    "type": "bool",
    "default": false,
    "description": "Print environment of process (-e)"
  },
  "flat_output": {
    "type": "bool",
    "default": false,
    "description": "Generate flat output without indentation (-f)"
  },
  "resolve_full_path": {
    "type": "bool",
    "default": false,
    "description": "Resolve full path of executable (-l)"
  },
  "suppress_args": {
    "type": "bool",
    "default": false,
    "description": "Suppress printing of exec(3) arguments (-q)"
  },
  "show_exit_status": {
    "type": "bool",
    "default": false,
    "description": "Display process exit status and duration (-t)"
  },
  "show_user": {
    "type": "bool",
    "default": false,
    "description": "Display user running the process (-u)"
  },
  "output_file": {
    "type": "string",
    "default": "",
    "description": "Redirect trace output to file (-o file)"
  },
  "trace_pid": {
    "type": "number",
    "default": 0,
    "description": "Only trace descendants of pid (-p pid)"
  },
  "trace_cmd": {
    "type": "list",
    "default": [],
    "description": "Command to run and trace its descendants (cmd ...)"
  }
}
