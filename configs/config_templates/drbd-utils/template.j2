# Drbd-utils configuration template
# Includes global common settings and per-resource definitions from the specified directory.

# Path to the directory containing drbd configuration includes
# (global_common.conf and *.res files).
# Default: 'drbd.d'
include "{{ drbd_include_path | default('drbd.d') }}/global_common.conf";

# Include all resource definition files in the specified directory.
# Default: 'drbd.d'
include "{{ drbd_include_path | default('drbd.d') }}/*.res";