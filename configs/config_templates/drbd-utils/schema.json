{
  "global_section": {
    "type": "object",
    "default": {},
    "description": "Global settings affecting DRBD behavior cluster-wide.",
    "properties": {
      "usage-count": {
        "type": "boolean",
        "default": true,
        "description": "Enable sending anonymous usage statistics to the DRBD project."
      },
      "user-pri": {
        "type": "boolean",
        "default": false,
        "description": "Allow userspace to set primary status via 'drbdsetup primary' (not recommended for production)."
      }
    }
  },
  "common_section": {
    "type": "object",
    "default": {
      "startup": {
        "wfc_timeout": 30,
        "degr_wfc_timeout": 120
      },
      "disk": {
        "on_io_error": "pass_on",
        "fencing": "resource-only",
        "disk-barrier": true,
        "disk-flushes": true,
        "disk-drain": true
      },
      "net": {
        "protocol": "C",
        "cram-hmac-alg": "sha1",
        "shared-secret": "drbdsecret"
      }
    },
    "description": "Settings inherited by all resources unless overridden. Includes startup, disk, and net subsections."
  },
  "resources": {
    "type": "list",
    "default": [
      {
        "name": "r0",
        "devices": [
          {
            "minor": 0
          }
        ],
        "hosts": [
          {
            "hostname": "node1",
            "ipv4": "10.0.0.1",
            "port": 7788,
            "data": "/dev/sdb1",
            "meta": "internal"
          },
          {
            "hostname": "node2",
            "ipv4": "10.0.0.2",
            "port": 7788,
            "data": "/dev/sdb1",
            "meta": "internal"
          }
        ],
        "nets": [
          {
            "protocol": "C",
            "cram-hmac-alg": "sha1",
            "shared-secret": "drbdsecret",
            "max-buffers": 2048,
            "unplug-watermark": 128,
            "sndbuf-size": 0,
            "ping-int": 10,
            "ping-timeout": 5,
            "timeout": 60,
            "connect-int": 10,
            "on-error": "detach"
          }
        ],
        "syncer": {
          "rate": "100M",
          "al_extents": 3833
        },
        "disks": [
          {
            "on_io_error": "pass_on",
            "fencing": "resource-only",
            "disk-barrier": true,
            "disk-flushes": true,
            "disk-drain": true,
            "md-flushes": true,
            "resync-rate": "100M"
          }
        ]
      }
    ],
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": "r0",
          "description": "Name of the DRBD resource (must be unique)."
        },
        "socket_dir": {
          "type": "string",
          "default": null,
          "description": "Directory for DRBD control sockets (e.g., '/var/run/drbd'). Leave empty to use default."
        },
        "devices": {
          "type": "list",
          "default": [
            {
              "minor": 0
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "minor": {
                "type": "integer",
                "default": 0,
                "description": "DRBD minor number (0\u2013255). Default 0."
              }
            }
          }
        },
        "hosts": {
          "type": "list",
          "minItems": 2,
          "maxItems": 2,
          "default": [
            {
              "hostname": "node1",
              "ipv4": "10.0.0.1",
              "port": 7788,
              "data": "/dev/sdb1",
              "meta": "internal"
            },
            {
              "hostname": "node2",
              "ipv4": "10.0.0.2",
              "port": 7788,
              "data": "/dev/sdb1",
              "meta": "internal"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "hostname": {
                "type": "string",
                "description": "Fully qualified hostname or short name of this node."
              },
              "address": {
                "type": "string",
                "default": null,
                "description": "Explicit address:port string (e.g., '10.0.0.1:7788' or '[2001:db8::1]:7788'). If provided, overrides ipv4/ipv6/port."
              },
              "ipv4": {
                "type": "string",
                "default": null,
                "description": "IPv4 address for replication traffic (required if address omitted)."
              },
              "ipv6": {
                "type": "string",
                "default": null,
                "description": "IPv6 address for replication traffic (preferred when present)."
              },
              "port": {
                "type": "integer",
                "default": 7788,
                "description": "DRBD peer port (1024\u201365535). Default 7788."
              },
              "data": {
                "type": "string",
                "default": "/dev/sdb1",
                "description": "Underlying block device (partition, LV, or file-backed file)."
              },
              "meta": {
                "type": "string",
                "default": "internal",
                "description": "Meta-disk type ('internal' or 'external:<device>'), or 'none' for file-backed."
              }
            }
          }
        },
        "nets": {
          "type": "list",
          "default": [
            {
              "protocol": "C",
              "cram-hmac-alg": "sha1",
              "shared-secret": "drbdsecret",
              "max-buffers": 2048,
              "unplug-watermark": 128,
              "sndbuf-size": 0,
              "ping-int": 10,
              "ping-timeout": 5,
              "timeout": 60,
              "connect-int": 10,
              "on-error": "detach"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "protocol": {
                "type": "string",
                "default": "C",
                "enum": [
                  "A",
                  "B",
                  "C"
                ],
                "description": "Replication protocol: A (async), B (semi-sync), C (sync)."
              },
              "cram-hmac-alg": {
                "type": "string",
                "default": "sha1",
                "description": "Algorithm used for authentication (e.g., 'sha1', 'md5')."
              },
              "shared-secret": {
                "type": "string",
                "default": "drbdsecret",
                "description": "Pre-shared secret for authentication between nodes."
              },
              "max-buffers": {
                "type": "integer",
                "default": 2048,
                "description": "Maximum number of buffers for network communication."
              },
              "unplug-watermark": {
                "type": "integer",
                "default": 128,
                "description": "Number of queued buffers that triggers network unplug."
              },
              "sndbuf-size": {
                "type": "integer",
                "default": 0,
                "description": "TCP send buffer size in bytes (0 = auto)."
              },
              "ping-int": {
                "type": "integer",
                "default": 10,
                "description": "Interval (seconds) between TCP keep-alive probes."
              },
              "ping-timeout": {
                "type": "integer",
                "default": 5,
                "description": "Seconds to wait for ping response before declaring connection dead."
              },
              "timeout": {
                "type": "integer",
                "default": 60,
                "description": "Seconds to wait for network replies (e.g., acks)."
              },
              "connect-int": {
                "type": "integer",
                "default": 10,
                "description": "Seconds between connection attempts when peer is down."
              },
              "on-error": {
                "type": "string",
                "default": "detach",
                "enum": [
                  "detach",
                  "pass_on",
                  "call-local-io-error"
                ],
                "description": "Action on persistent I/O error (detaches disk by default)."
              }
            }
          }
        },
        "syncer": {
          "type": "object",
          "default": {
            "rate": "100M",
            "al_extents": 3833
          },
          "properties": {
            "rate": {
              "type": "string",
              "default": "100M",
              "description": "Initial resync speed (e.g., '50M', '1G', '1000K')."
            },
            "al_extents": {
              "type": "integer",
              "default": 3833,
              "description": "Size of the Allocation Log (must be prime, \u2264 65533). Default 3833."
            },
            "csums-alg": {
              "type": "string",
              "default": null,
              "description": "Checksum algorithm used for resync verification (e.g., 'sha1')."
            }
          }
        },
        "disks": {
          "type": "list",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "on_io_error": {
                "type": "string",
                "default": "pass_on",
                "enum": [
                  "pass_on",
                  "call-local-io-error",
                  "detach",
                  "io-error"
                ],
                "description": "Action on I/O error (per-disk override of common)."
              },
              "fencing": {
                "type": "string",
                "default": "resource-only",
                "enum": [
                  "resource-only",
                  "resource-and-stonith",
                  "dont-fence"
                ],
                "description": "Fencing strategy when peer is unreachable."
              },
              "disk-barrier": {
                "type": "boolean",
                "default": true,
                "description": "Enable disk barriers (ensures disk flush ordering)."
              },
              "disk-flushes": {
                "type": "boolean",
                "default": true,
                "description": "Enable disk flushes for data integrity."
              },
              "disk-drain": {
                "type": "boolean",
                "default": true,
                "description": "Drain in-flight writes before resync to avoid stalls."
              },
              "md-flushes": {
                "type": "boolean",
                "default": true,
                "description": "Flush meta-disk before allowing write operations."
              },
              "resync-rate": {
                "type": "string",
                "default": null,
                "description": "Override syncer rate (e.g., '50M')."
              }
            }
          }
        }
      }
    }
  },
  "include_dir": {
    "type": "string",
    "default": null,
    "description": "Optional directory with extra .conf files to include (e.g., '/etc/drbd.d')."
  }
}
