{
  "global_section": {
    "usage-count": true,
    "user-pri": false
  },
  "common_section": {
    "startup": {
      "wfc_timeout": 30,
      "degr_wfc_timeout": 120
    },
    "disk": {
      "on_io_error": "pass_on",
      "fencing": "resource-only",
      "disk-barrier": true,
      "disk-flushes": true,
      "disk-drain": true,
      "md-flushes": true
    },
    "net": {
      "protocol": "C",
      "cram-hmac-alg": "sha1",
      "shared-secret": "drbdsecret",
      "ping-int": 10,
      "ping-timeout": 5,
      "timeout": 60,
      "connect-int": 10,
      "on-error": "detach"
    }
  },
  "resources": [
    {
      "name": "data",
      "socket_dir": "/var/run/drbd",
      "devices": [
        {
          "minor": 0
        }
      ],
      "hosts": [
        {
          "hostname": "node1.example.com",
          "ipv4": "192.168.10.1",
          "port": 7789,
          "data": "/dev/vg0/data-lv",
          "meta": "internal"
        },
        {
          "hostname": "node2.example.com",
          "ipv4": "192.168.10.2",
          "port": 7789,
          "data": "/dev/vg0/data-lv",
          "meta": "internal"
        }
      ],
      "nets": [
        {
          "protocol": "C",
          "cram-hmac-alg": "sha1",
          "shared-secret": "drbdsecret",
          "max-buffers": 2048,
          "unplug-watermark": 128,
          "sndbuf-size": 0,
          "ping-int": 10,
          "ping-timeout": 5,
          "timeout": 60,
          "connect-int": 10,
          "on-error": "detach"
        }
      ],
      "syncer": {
        "rate": "200M",
        "al_extents": 3833
      },
      "disks": []
    }
  ],
  "include_dir": "/etc/drbd.d"
}
