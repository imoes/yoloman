#!/bin/sh
#
# ==============================================================================
# Init script for unattended-upgrades shutdown check service.
# ==============================================================================
# This script is used by the init system (SysVinit) to manage the
# `unattended-upgrades-shutdown` service. Its primary purpose is to check
# if unattended package upgrades are currently running and wait for them
# to finish before proceeding with system shutdown or reboot.
# ==============================================================================

### BEGIN INIT INFO
# Required-Start:    $local_fs $remote_fs
# Required-Stop:     $local_fs $remote_fs
# Provides:          unattended-upgrade-shutdown-check
# Default-Start:     2 3 4 5
# Default-Stop:      0 6
# Short-Description: Check if unattended upgrades are being applied
# Description:       Check if unattended upgrades are being applied
#                    and wait for them to finish
### END INIT INFO

set -e

# Path to executables
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# --------------------------------------------------------------------------
# Service identification and configuration
# --------------------------------------------------------------------------

# The base name of the init script service.
# Defaults to 'unattended-upgrades-shutdown' if not specified in the playbook.
NAME="{{ name | default('unattended-upgrades-shutdown') }}"

# Human-readable description of the service, used in logs and status messages.
# Defaults to 'unattended package upgrades shutdown'.
DESC="{{ description | default('unattended package upgrades shutdown') }}"

# The script name derived from the service name, used for locating logs and helpers.
SCRIPTNAME="/etc/init.d/$NAME"

# Path to the Python script that checks for running unattended upgrades.
# This script determines if upgrades are active and waits if necessary.
# Defaults to '/usr/share/unattended-upgrades/unattended-upgrade-shutdown'.
SHUTDOWN_HELPER="{{ shutdown_helper | default('/usr/share/unattended-upgrades/unattended-upgrade-shutdown') }}"

# --------------------------------------------------------------------------
# Python interpreter detection
# --------------------------------------------------------------------------

# Determine which Python 3 interpreter to use.
# Tries python3 first, falls back to python if python3 is unavailable.
if [ -x /usr/bin/python3 ]; then
    PYTHON=python3
else
    PYTHON=python
fi

# --------------------------------------------------------------------------
# System environment and logging functions
# --------------------------------------------------------------------------

# Load the VERBOSE setting and other rcS variables to control log verbosity.
. /lib/init/vars.sh

# Define LSB log_* functions.
# Depend on lsb-base (>= 3.2-14) to ensure that this file is present.
# These functions provide standardized logging for init scripts.
. /lib/lsb/init-functions

# --------------------------------------------------------------------------
# Service actions
# --------------------------------------------------------------------------

case "$1" in
    start|restart|force-reload|status)
        # These actions require no specific logic for this service.
        # They exist primarily to keep update-rc.d happy and allow standard
        # service management commands without errors.
        # See Debian bug #630732 for context.
        ;;
    stop)
        if [ -e $SHUTDOWN_HELPER ]; then
            # Log the start of the shutdown check if verbose mode is enabled.
            [ "$VERBOSE" != "no" ] && log_action_begin_msg "Checking for running $DESC"

            # Execute the shutdown helper script.
            # This script checks for running unattended upgrades and waits
            # for them to complete if they are.
            $PYTHON $SHUTDOWN_HELPER

            # Log the result of the shutdown check.
            [ "$VERBOSE" != "no" ] && log_action_end_msg $? "$NAME"
        fi
        ;;
    *)
        # Display usage instructions for unsupported commands.
        echo "Usage: $SCRIPTNAME {start|stop|status|restart|force-reload}" >&2
        exit 3
        ;;
esac
: