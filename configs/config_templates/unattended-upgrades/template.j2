#!/bin/sh
# Path to the Python script that checks for running unattended upgrades.
# Default: /usr/share/unattended-upgrades/update-motd-unattended-upgrades
if [ -x {{ shutdown_helper | default('/usr/share/unattended-upgrades/update-motd-unattended-upgrades') }} ]; then
    exec {{ shutdown_helper | default('/usr/share/unattended-upgrades/update-motd-unattended-upgrades') }}
fi
