{
  "name": "etcd-1",
  "initial_cluster": [
    "etcd-1=http://10.0.1.10:2380",
    "etcd-2=http://10.0.1.11:2380",
    "etcd-3=http://10.0.1.12:2380"
  ],
  "initial_cluster_state": "new",
  "initial_cluster_token": "etcd-prod-cluster",
  "advertise_client_urls": [
    "https://etcd1.example.com:2379",
    "https://etcd1.internal.example.com:2379"
  ],
  "initial_advertise_peer_urls": [
    "http://10.0.1.10:2380"
  ],
  "listen_client_urls": [
    "https://0.0.0.0:2379"
  ],
  "listen_peer_urls": [
    "http://0.0.0.0:2380",
    "http://10.0.1.10:2380"
  ],
  "data_dir": "/var/lib/etcd",
  "snapshot_count": 100000,
  "election_timeout": 1000,
  "heartbeat_interval": 100,
  "max_requests_per_second": 10000,
  "enable_v2": false,
  "enable_trace": false,
  "enable_pprof": false,
  "metrics": "extensive",
  "log_level": "info",
  "log_format": "json",
  "client_cert_auth": true,
  "trusted_ca_file": "/etc/ssl/etcd/ca.crt",
  "cert_file": "/etc/ssl/etcd/server.crt",
  "key_file": "/etc/ssl/etcd/server.key",
  "peer_client_cert_auth": true,
  "peer_trusted_ca_file": "/etc/ssl/etcd/ca.crt",
  "peer_cert_file": "/etc/ssl/etcd/peer.crt",
  "peer_key_file": "/etc/ssl/etcd/peer.key",
  "auto_compaction_retention": "2h",
  "auto_compaction_mode": "periodic",
  "quota_backend_bytes": 8589934592,
  "snapshot_count_max": 10,
  "debug": false
}
