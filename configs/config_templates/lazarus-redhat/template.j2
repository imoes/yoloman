<?xml version="1.0"?>
<CONFIG>
  <!-- EnvironmentOptions: Container for Lazarus IDE environment settings -->
  <EnvironmentOptions>
    <!-- Version: Lazarus IDE version identifier -->
    <Version Value="110" Lazarus="2.2.6"/>
    
    <!-- LazarusDirectory: The base directory for Lazarus IDE installation. -->
    <LazarusDirectory Value="{{ (lazarus_directory | default('/usr/lib64/lazarus')) | string | trim }}/">
      <!-- History: Stores recent paths for auto-completion/suggestions -->
      <History Count="1">
        <Item1 Value="/usr/lib/lazarus/"/>
      </History>
    </LazarusDirectory>
    
    <!-- CompilerFilename: Path to the Free Pascal Compiler executable. -->
    <CompilerFilename Value="{{ (compiler_filename | default('/usr/bin/fpc')) | string | trim }}">
      <!-- History: Stores recent paths for auto-completion/suggestions -->
      <History Count="3">
        <Item1 Value="/usr/local/bin/fpc"/>
        <Item2 Value="/usr/bin/fpc"/>
        <Item3 Value="/opt/fpc/fpc"/>
      </History>
    </CompilerFilename>
    
    <!-- FPCSourceDirectory: Path to the Free Pascal Compiler source code directory. -->
    <FPCSourceDirectory Value="{{ (fpc_source_directory | default('/usr/share/fpcsrc')) | string | trim }}/">
      <!-- History: Stores recent paths for auto-completion/suggestions -->
      <History Count="2">
        <Item1 Value="/usr/share/fpcsrc/"/>
        <!-- Note: $(FPCVER) is a runtime variable expansion, not a Jinja variable -->
        <Item2 Value="/usr/share/fpcsrc/$(FPCVER)/"/>
      </History>
    </FPCSourceDirectory>
    
    <!-- MakeFilename: Path to the make utility (no configurable variable in schema, uses hardcoded history) -->
    <MakeFilename>
      <!-- History: Stores recent paths for auto-completion/suggestions -->
      <History Count="1">
        <Item1 Value="/usr/bin/make"/>
      </History>
    </MakeFilename>
    
    <!-- TestBuildDirectory: Directory used for test builds, relative to user home or absolute path. -->
    <TestBuildDirectory Value="{{ (test_build_directory | default('~/tmp')) | string | trim }}/">
      <!-- History: Stores recent paths for auto-completion/suggestions -->
      <History Count="2">
        <Item1 Value="/tmp/"/>
        <Item2 Value="/var/tmp/"/>
      </History>
    </TestBuildDirectory>
    
    <!-- Debugger: Debugger configuration block -->
    <Debugger>
      <Configs>
        <!-- Config: FpDebug debugger configuration -->
        <Config ConfigName="FpDebug" ConfigClass="TFpDebugDebugger" Active="True"/>
        <!-- Config: GDB debugger configuration -->
        <Config ConfigName="Gdb" ConfigClass="TGDBMIDebugger" DebuggerFilename="/usr/bin/gdb"/>
      </Configs>
    </Debugger>
  </EnvironmentOptions>
</CONFIG>
