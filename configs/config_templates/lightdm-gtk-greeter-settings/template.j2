[greeter]
# Full path to the background image for the greeter screen.
# Schema: greeter.background
background={{ (greeter | default({})).background | default('/usr/share/backgrounds/default.jpg') }}

# Full path to the image to use as the user avatar. Leave empty for default.
# Schema: greeter.user_icon
user-icon={{ (greeter | default({})).user_icon | default('') }}

# If true, hides the user list from the greeter.
# Schema: greeter.hide_userlist
hide-userlist={{ (greeter | default({})).hide_userlist | default(false) | lower }}

# If true, allows logging in by typing the username directly.
# Schema: greeter.allow_hidden_user
allow-hidden-user={{ (greeter | default({})).allow_hidden_user | default(false) | lower }}

# GTK+ theme name to use for the greeter interface.
# Schema: greeter.theme_name
theme-name={{ (greeter | default({})).theme_name | default('Adwaita') }}

# Icon theme name to use for the greeter interface.
# Schema: greeter.icon_theme_name
icon-theme-name={{ (greeter | default({})).icon_theme_name | default('Adwaita') }}

# Font family name to use in the greeter.
# Schema: greeter.font_name
font-name={{ (greeter | default({})).font_name | default('Sans') }}

# Locale code (e.g., en_US.UTF-8) for the greeter. Leave empty for system default.
# Schema: greeter.locale
locale={{ (greeter | default({})).locale | default('') }}

# Idle timeout in seconds before the screensaver starts. 0 means disabled.
# Schema: greeter.idle_timeout
idle-timeout={{ (greeter | default({})).idle_timeout | default(0) }}

# Command to run for the screensaver. Leave empty for default.
# Schema: greeter.screensaver_command
screensaver-command={{ (greeter | default({})).screensaver_command | default('') }}

# Whether to lock the screen when the screensaver starts.
# Schema: greeter.screensaver_locked
screensaver-locked={{ (greeter | default({})).screensaver_locked | default(true) | lower }}

# Text layout direction: 'ltr' for left-to-right or 'rtl' for right-to-left.
# Schema: greeter.layout_direction
layout-direction={{ (greeter | default({})).layout_direction | default('ltr') }}

# If true, enables debug logging for the greeter.
# Schema: greeter.log
log={{ (greeter | default({})).log | default(false) | lower }}