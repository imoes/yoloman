# Path to the SGE (Sun Grid Engine) installation root directory.
# Set to 'undefined' to let the job manager auto-detect the root location.
sge_root={{ sge_root | default('undefined') }}

# Name of the SGE cell to interact with.
# Set to 'undefined' to let the job manager auto-detect the cell name.
sge_cell={{ sge_cell | default('undefined') }}

# Path to the file containing SGE_CELL and SGE_ROOT definitions.
# This file is sourced to determine environment variables if auto-detection fails.
sge_config="{{ sge_config | default('/etc/default/gridengine') }}"

# Path to the qsub binary, used to submit jobs to the Grid Engine LRM.
qsub={{ qsub | default('/usr/bin/qsub') }}

# Path to the qstat binary, used to check job status.
qstat={{ qstat | default('/usr/bin/qstat') }}

# Path to the qdel binary, used to cancel jobs.
qdel={{ qdel | default('/usr/bin/qdel') }}

# Path to the qconf binary, used for SGE configuration management.
qconf={{ qconf | default('/usr/bin/qconf') }}

# Path to the mpirun command specifically for Sun Grid Engine MPI jobs.
# Set to 'no' to disable usage of a specialized Sun mpirun.
sun_mprun={{ sun_mprun | default('no') }}

# Path to the generic mpirun command.
# Used if sun_mprun is set to 'no'. Set to 'no' to disable MPI job launching via mpirun.
mpirun={{ mpirun | default('no') }}

# Whether to validate parallel environments (yes/no).
# If yes, jobs requesting an unknown parallel environment will be rejected.
validate_pes={{ validate_pes | default('no') }}

# Whether to validate queues (yes/no).
# If yes, jobs requesting an unknown queue will be rejected.
validate_queues={{ validate_queues | default('no') }}