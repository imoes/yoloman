{
  "storage.filesystem.rootdirectory": "/var/lib/registry",
  "storage.delete.enabled": true,
  "http.addr": "0.0.0.0:5000",
  "http.tls.enabled": true,
  "http.tls.certificate": "/etc/registry/certs/server.crt",
  "http.tls.key": "/etc/registry/certs/server.key",
  "http.debug.enabled": false,
  "auth.htpasswd.realm": "Docker Registry",
  "auth.htpasswd.path": "/etc/registry/htpasswd",
  "log.level": "info",
  "log.formatter": "json",
  "log.fields.service": "docker-registry",
  "health": [
    {
      "enabled": true,
      "interval": "30s",
      "threshold": 3
    }
  ]
}
