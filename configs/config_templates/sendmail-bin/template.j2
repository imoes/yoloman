#!/bin/sh
set +e;

#------------------------------------------------------------------------------
# Autoconf variables - in a form suitable for sh, perl
# Generated automatically from autoconf.sh.in by configure.
#
# This script provides shell-accessible variables for the Sendmail installation
# layout. Each variable is documented with its source description from the
# package schema to ensure self-documentation and safe reuse in Ansible roles.
#------------------------------------------------------------------------------

# Variables for, and by, Autoconf (Don't touch these! edit config step)

# The installation prefix directory for Sendmail.
PACKAGE_NAME="Sendmail";
PACKAGE_VERSION="8.18.1";

# The installation prefix directory for Sendmail.
# Default: /usr
prefix="{{ prefix | default('/usr') }}";

# The installation execution prefix directory.
# Default: /usr
exec_prefix="{{ exec_prefix | default('/usr') }}";

# The directory for user-executable binaries.
# Default: /usr/bin
bindir="{{ bindir | default('/usr/bin') }}";

# The directory for system administrator binaries.
# Default: /usr/sbin
sbindir="{{ sbindir | default('/usr/sbin') }}";

# The directory for non-user-invokable libraries and programs.
# Default: /usr/libexec/sendmail
libexecdir="{{ libexecdir | default('/usr/libexec/sendmail') }}";

# The read-only architecture-independent data directory.
# Default: /usr/share
datadir="{{ datadir | default('/usr/share') }}";

# The read-only single-machine data directory for configuration files.
# Default: /etc
sysconfdir="{{ sysconfdir | default('/etc') }}";

# The directory for modifiable architecture-independent data.
# Default: /usr/com
sharedstatedir="{{ sharedstatedir | default('/usr/com') }}";

# The directory for modifiable single-machine data (logs, spool, etc.).
# Default: /var
localstatedir="{{ localstatedir | default('/var') }}";

# The directory for object code libraries.
# Default: /usr/lib/x86_64-linux-gnu
libdir="{{ libdir | default('/usr/lib/x86_64-linux-gnu') }}";

# The directory for C header files.
# Default: /usr/include
includedir="{{ includedir | default('/usr/include') }}";

# The directory for Info documentation.
# Default: /usr/share/info
infodir="{{ infodir | default('/usr/share/info') }}";

# The directory for man page documentation.
# Default: /usr/share/man
mandir="{{ mandir | default('/usr/share/man') }}";

# The directory for package documentation.
# Default: /usr/share/doc
docdir="{{ docdir | default('/usr/share/doc') }}";

# Source directory placeholder.
srcdir=".";

# Number of backup copies to retain for sendmail configuration files.
# Default: 2
copies={{ copies | default(2) }};

# backup "/etc/mail/sendmail.mc"
if [ -f ${sysconfdir}/mail/sendmail.mc ]; then
	if [ ! -f ${localstatedir}/backups/sendmail.mc.bak ]; then
		cp -pf ${sysconfdir}/mail/sendmail.mc \
			${localstatedir}/backups/sendmail.mc.bak;
		;
	if ! cmp -s ${localstatedir}/backups/sendmail.mc.bak \
		${sysconfdir}/mail/sendmail.mc ; then
		cd ${localstatedir}/backups;
		/usr/bin/savelog -p -c $copies sendmail.mc.bak > /dev/null;
		cp -pf ${sysconfdir}/mail/sendmail.mc \
			${localstatedir}/backups/sendmail.mc.bak;
		;
	;

# backup "/etc/mail/submit.mc"
if [ -f ${sysconfdir}/mail/submit.mc ]; then
	if [ ! -f ${localstatedir}/backups/submit.mc.bak ]; then
		cp -pf ${sysconfdir}/mail/submit.mc \
			${localstatedir}/backups/submit.mc.bak;
		;
	if ! cmp -s ${localstatedir}/backups/submit.mc.bak \
		${sysconfdir}/mail/submit.mc ; then
		cd ${localstatedir}/backups;
		/usr/bin/savelog -p -c $copies submit.mc.bak > /dev/null;
		cp -pf ${sysconfdir}/mail/submit.mc \
			${localstatedir}/backups/submit.mc.bak;
		;
	;

# while we're here, might as well do sendmail.cf
if [ -f ${sysconfdir}/mail/sendmail.cf ]; then
	if [ ! -f ${localstatedir}/backups/sendmail.cf.bak ]; then
		cp -pf ${sysconfdir}/mail/sendmail.cf \
			${localstatedir}/backups/sendmail.cf.bak;
		;
	if ! cmp -s ${localstatedir}/backups/sendmail.cf.bak \
		${sysconfdir}/mail/sendmail.cf ; then
		cd ${localstatedir}/backups;
		# save previous generation only if differences are significant
		diff -bBwI "^\\#\\#\\#\\#\\# " \
			${localstatedir}/backups/sendmail.cf.bak \
			${sysconfdir}/mail/sendmail.cf > /dev/null;
		if [ $? -ne 0 ]; then
			/usr/bin/savelog -p -c $copies sendmail.cf.bak \
				> /dev/null;
			;
		cp -pf ${sysconfdir}/mail/sendmail.cf \
			${localstatedir}/backups/sendmail.cf.bak;
		;
	;

# while we're here, might as well do submit.cf
if [ -f ${sysconfdir}/mail/submit.cf ]; then
	if [ ! -f ${localstatedir}/backups/submit.cf.bak ]; then
		cp -pf ${sysconfdir}/mail/submit.cf \
			${localstatedir}/backups/submit.cf.bak;
		;
	if ! cmp -s ${localstatedir}/backups/submit.cf.bak \
		${sysconfdir}/mail/submit.cf ; then
		cd ${localstatedir}/backups;
		# save previous generation only if differences are significant
		diff -bBwI "^\\#\\#\\#\\#\\# " \
			${localstatedir}/backups/submit.cf.bak \
			${sysconfdir}/mail/submit.cf > /dev/null;
		if [ $? -ne 0 ]; then
			/usr/bin/savelog -p -c $copies submit.cf.bak \
				> /dev/null;
			;
		cp -pf ${sysconfdir}/mail/submit.cf \
			${localstatedir}/backups/submit.cf.bak;
		;
	;