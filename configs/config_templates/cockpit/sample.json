{
  "max_startups": 10,
  "login_title": "Acme Linux Console",
  "allowed_origins": [
    "https://console.acme.example.com"
  ],
  "protocol_header": "X-Forwarded-Proto",
  "allow_unencrypted": false,
  "url_root": "",
  "compression": true,
  "client_cert_auth": false,
  "login_banner": "/etc/cockpit/login-notice.txt",
  "session_idle_timeout": 30,
  "session_banner": "/etc/cockpit/motd.txt",
  "log_fatal": "stderr",
  "oauth_enabled": false,
  "oauth_url": ""
}
