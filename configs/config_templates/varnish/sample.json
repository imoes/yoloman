{
  "backends": [
    {
      "name": "web1",
      "host": "127.0.0.1",
      "port": "8080"
    }
  ],
  "directors": [],
  "default_ttl": 3600,
  "error_ttl": 60,
  "debug_headers": false,
  "add_x_varnish_headers": true,
  "add_age_header": false,
  "serve_stale_on_error": true,
  "purge_acl": [
    "127.0.0.1",
    "::1"
  ],
  "logrotate_log_file": "/var/log/varnish/varnishncsa.log"
}
