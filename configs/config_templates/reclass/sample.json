{
 "cache": {
  "enabled": true,
  "path": "/var/cache/reclass",
  "ttl": 7200
 },
 "default_node_class": "_global_defaults",
 "diagnostics": {
  "show_missing_nodes": true
 },
 "external_data": {
  "aws": "{\"region\": \"eu-west-1\", \"account_id\": \"123456789012\"}",
  "gcp": "{\"project_id\": \"prod-project\", \"zone\": \"europe-west1-b\"}"
 },
 "interpolation": {
  "enabled": true
 },
 "logging": {
  "file": "/var/log/reclass.log",
  "level": "INFO"
 },
 "max_inheritance_depth": 10,
 "merge_strategy": {
  "dicts": "deep",
  "lists": "append"
 },
 "metadata": {
  "uri": "http://metadata.local:8080"
 },
 "name": "production-reclass",
 "naming": {
  "class_name_pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$",
  "node_name_pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
 },
 "node_name_transform": {
  "type": "strip-domain"
 },
 "output": {
  "allowed_types": [
   "yaml",
   "json"
  ],
  "format": "json"
 },
 "path_prefix": "/reclass/prod",
 "sources": [
  {
   "path": "/etc/reclass/nodes"
  },
  {
   "path": "/etc/reclass/classes"
  }
 ],
 "storage": {
  "path": "/var/lib/reclass"
 },
 "timezone": "UTC",
 "uri_encoding": "percent",
 "yaml": {
  "width": 120
 }
}
