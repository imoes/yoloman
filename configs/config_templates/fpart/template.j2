{# fpart configuration file - generated via Ansible/Jinja2 #}
# This file controls the `fpart` utility, which partitions lists of files/directories.
# It generates command-line arguments based on the provided schema variables.

# ==============================================================================
# Partitioning Strategy
# ==============================================================================
{# Partitioning method: 'count' (use num_parts), 'files_per_part' (use max_files_per_part), or 'size_per_part' (use max_size_per_part) #}
{%- set method = partition_method | default('count') %}

{%- if method == 'count' %}
# Create exactly this many partitions (option -n); used only when partition_method == 'count'
-n {{ num_parts | default(1) }}
{%- elif method == 'files_per_part' %}
# Max files per partition (option -f); used only when partition_method == 'files_per_part'
-f {{ max_files_per_part | default(0) }}
{%- elif method == 'size_per_part' %}
# Max size per partition (option -s); human suffixes allowed (k,m,g,t,p); used only when partition_method == 'size_per_part'
-s {{ max_size_per_part | default('0') }}
{%- endif %}

# ==============================================================================
# Input Control
# ==============================================================================
{# Read file list from this file (option -i); if empty and input_arbitrary is false, uses command-line args #}
{%- set input_file = input_file | default('') %}
{# If true, treat input as arbitrary (option -a); requires input_file to be empty #}
{%- set input_arbitrary = input_arbitrary | default(False) %}

{%- if input_file != '' %}
# Read file list from this file (option -i); if empty and input_arbitrary is false, uses command-line args
-i {{ input_file }}
{%- else %}
    {%- if input_arbitrary %}
# If true, treat input as arbitrary (option -a); requires input_file to be empty
-a
    {%- endif %}
{%- endif %}

# ==============================================================================
# Output Control
# ==============================================================================
{# Output template for partitions (option -o); '-' prints to stdout #}
-o {{ output_template | default('-') }}
{# End filenames with null characters (option -0) #}
{%- if output_null_terminated | default(False) %}
-0
{%- endif %}
{# Add trailing slash to directories (option -e) #}
{%- if add_trailing_slash | default(False) %}
-e
{%- endif %}
{# Add parent directories at end of each partition (option -P) #}
{%- if add_parent_dirs | default(False) %}
-P
{%- endif %}
{# Verbose mode (option -v) #}
{%- if verbose | default(False) %}
-v
{%- endif %}

# ==============================================================================
# Filesystem Crawling Control
# ==============================================================================
{# Follow symbolic links (option -l) #}
{%- if follow_symlinks | default(False) %}
-l
{%- endif %}
{# Do not cross filesystem boundaries (option -b) #}
{%- if no_cross_fs | default(False) %}
-b
{%- endif %}

# Include patterns (option -y); may be specified multiple times
{%- for pattern in include_patterns | default([]) %}
-y {{ pattern }}
{%- endfor %}

# Exclude patterns (option -x); may be specified multiple times
{%- for pattern in exclude_patterns | default([]) %}
-x {{ pattern }}
{%- endfor %}

# ==============================================================================
# Directory Handling
# ==============================================================================
{# Pack empty directories (option -z) #}
{%- if pack_empty_dirs | default(False) %}
-z
{%- endif %}
{# Treat unreadable directories as empty (option -zz) #}
{%- if treat_unreadable_as_empty | default(False) %}
-zz
{%- endif %}
{# Pack all directories as empty entries (option -zzz) #}
{%- if pack_all_dirs | default(False) %}
-zzz
{%- endif %}
{# Pack erroneous directories in dedicated partitions (option -Z); requires live_mode and treat_unreadable_as_empty or pack_all_dirs #}
{%- if pack_erroneous_dirs_separately | default(False) %}
-Z
{%- endif %}
{# After this depth, pack directories instead of files (option -d); 0 means disabled #}
{%- if depth_limit | default(0) != 0 %}
-d {{ depth_limit | default(0) }}
{%- endif %}
{# Pack leaf directories only (option -D); implies pack_empty_dirs #}
{%- if leaf_dirs_only | default(False) %}
-D
{%- endif %}
{# Pack directories only, no files (option -E); implies leaf_dirs_only #}
{%- if dirs_only | default(False) %}
-E
{%- endif %}

# ==============================================================================
# Live Mode & Size Handling
# ==============================================================================
{# Enable live mode (option -L); cannot be used with partition_method == 'count' #}
{%- if live_mode | default(False) %}
-L
{%- endif %}
{# Skip files bigger than max_size_per_part in live mode (option -S); requires live_mode and max_size_per_part > 0 #}
{%- if skip_big_files | default(False) %}
-S
{%- endif %}

{# Preload each partition with this many bytes (option -p); human suffixes allowed (k,m,g,t,p) #}
{%- set preload = preload_bytes | default('0') %}
{%- if preload | int != 0 %}
-p {{ preload }}
{%- endif %}

{# Overload each file size with this many bytes (option -q); human suffixes allowed (k,m,g,t,p) #}
{%- set overload = overload_bytes | default('0') %}
{%- if overload | int != 0 %}
-q {{ overload }}
{%- endif %}

{# Round each file size up to next multiple of this many bytes (option -r); human suffixes allowed (k,m,g,t,p) #}
{%- set round = round_bytes | default('0') %}
{%- if round | int != 0 %}
-r {{ round }}
{%- endif %}

# ==============================================================================
# Hook Commands
# ==============================================================================
{# Execute this command before each partition (option -w) #}
{%- if pre_part_cmd | default('') != '' %}
-w {{ pre_part_cmd | default('') }}
{%- endif %}

{# Execute this command after each partition (option -W) #}
{%- if post_part_cmd | default('') != '' %}
-W {{ post_part_cmd | default('') }}
{%- endif %}

{# Execute this command after running (option -R) #}
{%- if post_run_cmd | default('') != '' %}
-R {{ post_run_cmd | default('') }}
{%- endif %}

# ==============================================================================
# Input Files/Dirs (Positional Arguments)
# ==============================================================================
# Filesystem paths to process (positional arguments)
{%- for arg in args | default([]) %}
{{ arg }}
{%- endfor %}