{
  "partition_method": "files_per_part",
  "num_parts": 3,
  "max_files_per_part": 1000,
  "max_size_per_part": "4g",
  "input_file": "",
  "input_arbitrary": false,
  "output_template": "/var/lib/fpart/parts-{{ part }}",
  "output_null_terminated": false,
  "add_trailing_slash": true,
  "add_parent_dirs": true,
  "verbose": true,
  "follow_symlinks": false,
  "no_cross_fs": true,
  "include_patterns": [
    "*.jpg",
    "*.png"
  ],
  "exclude_patterns": [
    "*.tmp"
  ],
  "pack_empty_dirs": true,
  "treat_unreadable_as_empty": true,
  "pack_all_dirs": false,
  "pack_erroneous_dirs_separately": false,
  "depth_limit": 0,
  "leaf_dirs_only": false,
  "dirs_only": false,
  "live_mode": true,
  "skip_big_files": true,
  "preload_bytes": "1m",
  "overload_bytes": "1k",
  "round_bytes": "4k",
  "pre_part_cmd": "/usr/local/bin/pre-part-hook",
  "post_part_cmd": "/usr/local/bin/post-part-hook",
  "post_run_cmd": "/usr/local/bin/post-run-hook",
  "args": [
    "/data/images",
    "/data/docs"
  ]
}
