{
  "log_paths": [
    "/var/log/nginx/access.log",
    "/var/log/nginx/error.log"
  ],
  "progs": [
    "/etc/mtail/progs"
  ],
  "http_endpoint": ":3903",
  "labels": {
    "service": "webserver",
    "env": "production"
  },
  "timezone": "UTC",
  "verbose": true,
  "store_memory": true,
  "pushgateway": {
    "url": "http://pushgateway.monitoring.svc:9091",
    "job_name": "mtail-web",
    "interval": 30
  }
}
