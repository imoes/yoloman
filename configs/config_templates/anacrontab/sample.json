{
  "shell": "/bin/sh",
  "home": "/root",
  "logname": "root",
  "jobs": [
    {
      "period": "1",
      "delay": 5,
      "name": "cron.daily",
      "command": "run-parts --report /etc/cron.daily"
    },
    {
      "period": "7",
      "delay": 10,
      "name": "cron.weekly",
      "command": "run-parts --report /etc/cron.weekly"
    },
    {
      "period": "@monthly",
      "delay": 15,
      "name": "cron.monthly",
      "command": "run-parts --report /etc/cron.monthly"
    }
  ]
}