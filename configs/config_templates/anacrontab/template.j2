# /etc/anacrontab: configuration file for anacron
#
# See anacron(8) and anacrontab(5) for details.
#
# This template is self-documenting. Each directive is preceded by its
# schema description to ensure clarity without external references.

# SHELL: The shell to use for executing commands
SHELL={{ (anacrontab | default({})).shell | default('/bin/sh') }}

# PATH: Search path for commands executed by anacron
PATH={{ (anacrontab | default({})).path | default('/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin') }}

# HOME: Home directory for the user running the jobs (usually root)
HOME={{ (anacrontab | default({})).home | default('/root') }}

# LOGNAME: Username under which the jobs are executed
LOGNAME={{ (anacrontab | default({})).logname | default('root') }}

# -----------------------------------------------------------------------------
# Job Definitions
# Each job follows the format:
# period delay identifier command
#
# period:   Period in days or special marker (e.g., '1', '7', 'monthly')
# delay:    Delay in minutes before running the job after anacron starts
# identifier: Unique name for the job (used as identifier and timestamp file name)
# command:  Command to execute (full path recommended)
# -----------------------------------------------------------------------------

{% if jobs | default([]) | length > 0 %}
# These replace cron's entries
{% for job in jobs %}
# Job: {{ job.name | default('unnamed') | default('') }}
# Period: {{ job.period | default('1') | string }} days
# Delay: {{ job.delay | default(0) | int }} minutes
# Command: {{ job.command | default('') | string }}
{{ job.period | default('1') }}	{{ job.delay | default(0) | int }}	{{ job.name | default('') }}	{{ job.command | default('') }}
{% endfor %}
{% else %}
# No jobs defined. Add job entries to the 'jobs' list in the schema.
{% endif %}