{
  "ipv6calc_default_active": {
    "type": "string",
    "default": "on",
    "description": "Activate ipv6calc module by default (can be overridden by environment variables).",
    "enum": [
      "on",
      "off"
    ]
  },
  "ipv6calc_action_anonymize": {
    "type": "string",
    "default": "on",
    "description": "Set IPV6CALC_CLIENT_IP_ANON environment variable.",
    "enum": [
      "on",
      "off"
    ]
  },
  "ipv6calc_action_countrycode": {
    "type": "string",
    "default": "on",
    "description": "Set IPV6CALC_CLIENT_COUNTRYCODE environment variable.",
    "enum": [
      "on",
      "off"
    ]
  },
  "ipv6calc_action_asn": {
    "type": "string",
    "default": "on",
    "description": "Set IPV6CALC_CLIENT_ASN environment variable.",
    "enum": [
      "on",
      "off"
    ]
  },
  "ipv6calc_action_registry": {
    "type": "string",
    "default": "on",
    "description": "Set IPV6CALC_CLIENT_REGISTRY environment variable.",
    "enum": [
      "on",
      "off"
    ]
  },
  "ipv6calc_action_geonameid": {
    "type": "string",
    "default": "on",
    "description": "Set IPV6CALC_CLIENT_GEONAMEID environment variable.",
    "enum": [
      "on",
      "off"
    ]
  },
  "ipv6calc_option_anonymize_preset": {
    "type": "string",
    "default": "keep-type-asn-cc",
    "description": "Anonymization preset method (e.g., keep-type-asn-cc, zeroize, anonymize).",
    "enum": [
      "keep-type-asn-cc",
      "zeroize",
      "anonymize"
    ]
  },
  "ipv6calc_cgi_path": {
    "type": "string",
    "default": "/var/www/ipv6calc/cgi-bin/ipv6calc.cgi",
    "description": "Path to the ipv6calc CGI script used for rewriting and directory access control."
  },
  "ipv6calc_cgi_dir": {
    "type": "string",
    "default": "/var/www/ipv6calc/cgi-bin",
    "description": "Directory path for the ipv6calc CGI script, used for access control directives."
  }
}
