# utrans-rc configuration
# This file configures the utrans-rc service which converts systemd units.
# It is not a systemd unit itself, but a configuration for the utility.

# Backend to use for utrans. If unset, utrans-rc will auto-detect.
# Corresponds to -b <BACKEND>
backend = "{{ values.backend | default('auto') }}"

# Output directory for generated unit files.
# If unset, files are managed via sudo/ucf in /etc.
# Corresponds to -o <OUTPUT_DIR>
output_dir = "{{ values.output_dir | default('') }}"

# Source directories to scan for systemd units.
# If unset, [/usr]/lib/systemd/system is scanned.
# Corresponds to <SOURCE_DIR>.. (can be multiple)
sources = {% for src in values.sources %}
- {{ src }}{% endfor %}

# Enable dry run mode (no action, show what would be done).
# Corresponds to -n
dry_run = {{ values.dry_run | default(false) | lower }}

# Enable update-only mode (only check for changes, ignore if output/source specified).
# Corresponds to -u
update_only = {{ values.update_only | default(false) | lower }}