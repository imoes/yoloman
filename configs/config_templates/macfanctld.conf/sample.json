{
  "syslog_facility": "daemon",
  "log_level": 2,
  "read_interval": 5,
  "min_fan_speed": 20,
  "max_fan_speed": 100,
  "passive_cooling": false,
  "force_fan_control": false,
  "sensors": [
    {
      "name": "TC0D",
      "fan": "F0Ac"
    },
    {
      "name": "TB0T",
      "fan": "F1Ac"
    }
  ],
  "zones": [
    {
      "name": "normal",
      "thresholds": [
        45,
        55,
        65
      ],
      "fans": [
        "F0Ac",
        "F1Ac"
      ]
    },
    {
      "name": "critical",
      "thresholds": [
        75
      ],
      "fans": [
        "F0Ac",
        "F1Ac"
      ]
    }
  ],
  "overrides": []
}
