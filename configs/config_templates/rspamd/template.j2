# Rspamd main configuration file
# This file is auto-generated by Ansible. Do not edit manually;
# changes should be made in the role variables and re-provisioned.
#
# Override structure:
#   - $LOCAL_CONFDIR/rspamd.conf.local.override : redefine top-level parameters
#   - $LOCAL_CONFDIR/rspamd.conf.local : add new top-level parameters
#   - $LOCAL_CONFDIR/local.d/rspamd.conf : add/rewrite module options
#   - $LOCAL_CONFDIR/override.d/rspamd.conf : override defaults
# See https://rspamd.com/doc/developers/writing_rules.html for details

# Include common configuration
.include "$CONFDIR/common.conf"

# Global options (PID file, includes, etc.)
options {
    # Path to the PID file for the Rspamd process
    pidfile = "$RUNDIR/rspamd.pid";

    # Include default options
    .include "$CONFDIR/options.inc"

    # Include local overrides for options (priority 1, merged)
    .include(try=true; priority=1,duplicate=merge) "$LOCAL_CONFDIR/local.d/options.inc"

    # Include override directives for options (priority 10)
    .include(try=true; priority=10) "$LOCAL_CONFDIR/override.d/options.inc"
}

# Language detection module configuration
lang_detection {
    # Include default language detection settings
    .include "$CONFDIR/lang_detection.inc"

    # Include local language detection overrides (priority 1, merged)
    .include(try=true; priority=1,duplicate=merge) "$LOCAL_CONFDIR/local.d/lang_detection.inc"

    # Include override directives for language detection (priority 10)
    .include(try=true; priority=10) "$LOCAL_CONFDIR/override.d/lang_detection.inc"
}

# CGP (Counter Greylisting Plugin) includes
# Include default CGP settings (merged on duplicate)
.include(try=true; duplicate=merge) "$CONFDIR/cgp.inc"

# Include local CGP overrides (priority 1, merged)
.include(try=true; priority=1,duplicate=merge) "$LOCAL_CONFDIR/local.d/cgp.inc"

# Logging configuration
logging {
    # Logging type (file, syslog, etc.)
    type = "file";

    # Path to the log file
    filename = "$LOGDIR/rspamd.log";

    # Include default logging settings
    .include "$CONFDIR/logging.inc"

    # Include local logging overrides (priority 1, merged)
    .include(try=true; priority=1,duplicate=merge) "$LOCAL_CONFDIR/local.d/logging.inc"

    # Include override directives for logging (priority 10)
    .include(try=true; priority=10) "$LOCAL_CONFDIR/override.d/logging.inc"
}

# Normal worker: processes mail for scoring and filtering
worker "normal" {
    # Bind address and port for the Rspamd normal worker.
    # Default: localhost:11333
    bind_socket = "{{ (rspamd_normal_bind | default('localhost:11333')) }}";

    # Include default normal worker settings
    .include "$CONFDIR/worker-normal.inc"

    # Include local normal worker overrides (priority 1, merged)
    .include(try=true; priority=1,duplicate=merge) "$LOCAL_CONFDIR/local.d/worker-normal.inc"

    # Include override directives for normal worker (priority 10)
    .include(try=true; priority=10) "$LOCAL_CONFDIR/override.d/worker-normal.inc"
}

# Controller worker: provides HTTP API and web interface for management
worker "controller" {
    # Bind address and port for the Rspamd controller worker.
    # Default: localhost:11334
    bind_socket = "{{ (rspamd_controller_bind | default('localhost:11334')) }}";

    # Include default controller worker settings
    .include "$CONFDIR/worker-controller.inc"

    # Include local controller worker overrides (priority 1, merged)
    .include(try=true; priority=1,duplicate=merge) "$LOCAL_CONFDIR/local.d/worker-controller.inc"

    # Include override directives for controller worker (priority 10)
    .include(try=true; priority=10) "$LOCAL_CONFDIR/override.d/worker-controller.inc"
}

# Proxy worker: listens for incoming mail submissions and forwards to normal worker
worker "rspamd_proxy" {
    # Bind address and port for the Rspamd proxy worker.
    # Default: localhost:11332
    bind_socket = "{{ (rspamd_proxy_bind | default('localhost:11332')) }}";

    # Include default proxy worker settings
    .include "$CONFDIR/worker-proxy.inc"

    # Include local proxy worker overrides (priority 1, merged)
    .include(try=true; priority=1,duplicate=merge) "$LOCAL_CONFDIR/local.d/worker-proxy.inc"

    # Include override directives for proxy worker (priority 10)
    .include(try=true; priority=10) "$LOCAL_CONFDIR/override.d/worker-proxy.inc"
}

# Fuzzy worker: handles fuzzy hashing for duplicate/similar message detection
# Local fuzzy storage is disabled by default
worker "fuzzy" {
    # Bind address and port for the Rspamd fuzzy worker.
    # Default: localhost:11335
    bind_socket = "{{ (rspamd_fuzzy_bind | default('localhost:11335')) }}";

    # Number of worker processes. -1 disables the fuzzy storage locally.
    # See issue #4677 for details.
    count = -1;

    # Include default fuzzy worker settings
    .include "$CONFDIR/worker-fuzzy.inc"

    # Include local fuzzy worker overrides (priority 1, merged)
    .include(try=true; priority=1,duplicate=merge) "$LOCAL_CONFDIR/local.d/worker-fuzzy.inc"

    # Include override directives for fuzzy worker (priority 10)
    .include(try=true; priority=10) "$LOCAL_CONFDIR/override.d/worker-fuzzy.inc"
}