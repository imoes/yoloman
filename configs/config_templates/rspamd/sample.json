{
  "worker_type": "worker",
  "worker_bind_socket": "127.0.0.1:11333",
  "worker_count": 4,
  "fuzzy_storage_path": "/var/lib/rspamd/fuzzy",
  "learning_path": "/var/lib/rspamd/learning",
  "stat_driver": "file",
  "tokenizer_name": "ngram",
  "bayes_min_tokens": 200,
  "bayes_min_learns": 200,
  "learn_mode": "auto",
  "redis_servers": [],
  "clustering_servers": [],
  "symbols_config": [
    {
      "name": "MY_CUSTOM_RULE",
      "score": 2.5,
      "description": "Matches messages containing 'Free Money!' in subject",
      "group": "RULES",
      "priority": -10
    },
    {
      "name": "RBL_SPAMHAUS",
      "score": 1.5,
      "group": "REPUTATION"
    }
  ],
  "whitelist": [
    "10.0.0.0/8",
    "192.168.1.0/24"
  ],
  "blacklist": [
    "198.51.100.0/24"
  ],
  "max_message_size": 0,
  "max_recipients": 100,
  "scan_timeout": 60.0,
  "dns_servers": [
    "127.0.0.1"
  ],
  "controller_auth": {
    "hash": "$6$rounds=5000$example$salt$hashvalue..."
  },
  "log_type": "syslog",
  "log_level": "info",
  "log_debug_modules": [],
  "modules_disabled": [
    "milter"
  ],
  "confdir_local": "/etc/rspamd/local.d",
  "confdir_override": "/etc/rspamd/override.d"
}
