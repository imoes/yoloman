# Server description displayed in the official server list.
server_description = {{ server_description | default('Luanti server powered by Debian') }}

# Whether to register the server in the official server list.
server_announce = {{ server_announce | default('false') }}

# Enable IPv6 support for the server.
ipv6_server = {{ ipv6_server | default('true') }}

# Message of the Day displayed to connecting players.
motd = {{ motd | default('Welcome to Luanti. Enjoy your stay!') }}

# Enable player vs player combat.
enable_pvp = {{ enable_pvp | default('false') }}
