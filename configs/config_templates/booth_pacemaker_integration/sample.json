{
  "booth_config": "/etc/booth/booth-site.conf",
  "booth_port": 9999,
  "booth_auth": "file",
  "booth_authfile": "/etc/booth/authfile",
  "booth_timeout": 5000,
  "booth_retry": 3,
  "sites": [
    {
      "name": "cluster1",
      "addr": "10.0.1.10",
      "priority": 200
    },
    {
      "name": "cluster2",
      "addr": "10.0.2.10",
      "priority": 150
    }
  ],
  "arbitrators": [
    {
      "addr": "10.0.0.5"
    }
  ],
  "resource_name": "booth",
  "resource_timeout": 30,
  "resource_start_delay": 5,
  "resource_monitor_interval": 60,
  "quorum_loss_action": "stop"
}
