{# envstore(1) configuration #}
{# envstore_file: File path used to store environment variables. #}
{# Default is /tmp/envstore-EUID where EUID is replaced by the effective user ID. #}
{% if envstore_file is defined %}
ENVSTORE_FILE={{ (envstore_file | default('/tmp/envstore-' + (euid | default('')))) | string }}
{% endif %}