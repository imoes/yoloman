#!/bin/sh
# =============================================================================
# sscg Certificate Generation Script
# Generated by Ansible Jinja2 template.
# This script executes the `sscg` utility to generate a self-signed certificate
# suitable for use in development or testing environments.
#
# Parameters are derived from the `sscg` role variables. Empty optional fields
# (State, Locality, etc.) are omitted from the command line to keep the
# generated script clean.
# =============================================================================

sscg \
  # Certificate lifetime in days.
  --lifetime={{ lifetime | default(398) }} \
  # Certificate DN: Country (C).
  --country={{ country | default('US') }} \
  # Certificate DN: State or Province (ST).
  {% if state | default('') != '' %}--state={{ state | default('') }} \{% endif %}
  # Certificate DN: Locality (L).
  {% if locality | default('') != '' %}--locality={{ locality | default('') }} \{% endif %}
  # Certificate DN: Organization (O).
  --organization={{ organization | default('Unspecified') }} \
  # Certificate DN: Organizational Unit (OU).
  {% if organizational_unit | default('') != '' %}--organizational-unit={{ organizational_unit | default('') }} \{% endif %}
  # Certificate DN: Email Address.
  {% if email | default('') != '' %}--email={{ email | default('') }} \{% endif %}
  # The valid hostname of the certificate. Must be an FQDN.
  --hostname={{ hostname | default('localhost') }} \
  # Strength of the certificate private keys in bits.
  --key-strength={{ key_strength | default(2048) }} \
  # Hashing algorithm to use for signing.
  --hash-alg={{ hash_alg | default('sha256') }} \
  # Cipher to use for encrypting key files.
  --cipher-alg={{ cipher_alg | default('aes-256-cbc') }} \
  # Path where the public CA certificate will be stored.
  --ca-file={{ ca_file | default('./ca.crt') }} \
  # File mode of the created CA certificate (e.g., 0644).
  {% if ca_mode | default('') != '' %}--ca-mode={{ ca_mode | default('') }} \{% endif %}
  # Path where the CA's private key will be stored. Leave empty to destroy key after creation.
  {% if ca_key_file | default('') != '' %}--ca-key-file={{ ca_key_file | default('') }} \{% endif %}
  # File mode of the created CA key.
  {% if ca_key_mode | default('') != '' %}--ca-key-mode={{ ca_key_mode | default('') }} \{% endif %}
  # Password for CA key file. Visible in process table; use passfile or prompt for production.
  {% if ca_key_password | default('') != '' %}--ca-key-password={{ ca_key_password | default('') }} \{% endif %}
  # File containing password to encrypt CA key file.
  {% if ca_key_passfile | default('') != '' %}--ca-key-passfile={{ ca_key_passfile | default('') }} \{% endif %}
  # Prompt to enter a password for the CA key file.
  {% if ca_key_password_prompt | default(False) %}--ca-key-password-prompt \{% endif %}
  # Path where an empty Certificate Revocation List file will be created.
  {% if crl_file | default('') != '' %}--crl-file={{ crl_file | default('') }} \{% endif %}
  # File mode of the created Certificate Revocation List.
  {% if crl_mode | default('') != '' %}--crl-mode={{ crl_mode | default('') }} \{% endif %}
  # Path where the public service certificate will be stored.
  --cert-file={{ cert_file | default('./service.pem') }} \
  # File mode of the created certificate.
  {% if cert_mode | default('') != '' %}--cert-mode={{ cert_mode | default('') }} \{% endif %}
  # Path where the service's private key will be stored.
  --cert-key-file={{ cert_key_file | default('service-key.pem') }} \
  # File mode of the certificate key.
  {% if cert_key_mode | default('') != '' %}--cert-key-mode={{ cert_key_mode | default('') }} \{% endif %}
  # Password for service key file. Visible in process table; use passfile or prompt for production.
  {% if cert_key_password | default('') != '' %}--cert-key-password={{ cert_key_password | default('') }} \{% endif %}
  # File containing password to encrypt service key file.
  {% if cert_key_passfile | default('') != '' %}--cert-key-passfile={{ cert_key_passfile | default('') }} \{% endif %}
  # Prompt to enter a password for the service key file.
  {% if cert_key_password_prompt | default(False) %}--cert-key-password-prompt \{% endif %}
  # Path where a client authentication certificate will be stored.
  {% if client_file | default('') != '' %}--client-file={{ client_file | default('') }} \{% endif %}
  # File mode of the client certificate.
  {% if client_mode | default('') != '' %}--client-mode={{ client_mode | default('') }} \{% endif %}
  # Path where the client's private key will be stored.
  {% if client_key_file | default('') != '' %}--client-key-file={{ client_key_file | default('') }} \{% endif %}
  # File mode of the client key.
  {% if client_key_mode | default('') != '' %}--client-key-mode={{ client_key_mode | default('') }} \{% endif %}
  # Password for client key file. Visible in process table; use passfile or prompt for production.
  {% if client_key_password | default('') != '' %}--cert-key-password={{ client_key_password | default('') }} \{% endif %}
  # File containing password to encrypt client key file.
  {% if client_key_passfile | default('') != '' %}--cert-key-passfile={{ client_key_passfile | default('') }} \{% endif %}
  # Prompt to enter a password for the client key file.
  {% if client_key_password_prompt | default(False) %}--cert-key-password-prompt \{% endif %}
  # A file to contain a set of Diffie-Hellman parameters.
  {% if dhparams_file | default('') != '' %}--dhparams-file={{ dhparams_file | default('') }} \{% endif %}
  # Output well-known DH parameters. E.g., ffdhe2048, ffdhe3072.
  {% if dhparams_named_group | default('ffdhe4096') != '' %}--dhparams-named-group={{ dhparams_named_group | default('ffdhe4096') }} \{% endif %}
  # Length of prime number to generate for dhparams in bits. 0 to use named group.
  {% if dhparams_prime_len | default(0) != 0 %}--dhparams-prime-len={{ dhparams_prime_len | default(0) }} \{% endif %}
  # Generator value for dhparams. 0 to use default (2).
  {% if dhparams_generator | default(0) != 0 %}--dhparams-generator={{ dhparams_generator | default(0) }} \{% endif %}
  # Optional additional valid hostnames/IPs for the certificate.
  {% for san in subject_alt_names | default([]) %}--subject-alt-name={{ san }} \
{% endfor %}
  # Enable logging of debug messages.
  {% if debug | default(False) %}-d \{% endif %}
  # Display progress messages.
  {% if verbose | default(False) %}-v \{% endif %}
  # Display no output unless there is an error.
  {% if quiet | default(False) %}-q \{% endif %}
  # Overwrite any pre-existing files in the requested locations.
  {% if force | default(False) %}-f{% endif %}
;