{# conjugar configuration file - parameters passed at invocation time #}

# Use ANSI escape codes to colorize output
# Default: False
{% if color | default(False) %}--color
{% endif %}

# Output conjugation results with XML tags
# Default: False
{% if xml | default(False) %}--xml
{% endif %}

# Conjugate verbs using most common Brazilian usage instead of normative grammar
# Default: False
{% if common | default(False) %}--common
{% endif %}

# List of verbs to conjugate in batch mode (used with -t flag); each item is a verb infinitive in UTF-8
# Default: []
{% for v in verbs | default([]) %}{{ v }}
{% endfor %}