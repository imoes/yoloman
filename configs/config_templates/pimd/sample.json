{
  "debug": true,
  "debug_level": " 2",
  "vrid": 10,
  "pimsm_enabled": true,
  "pimdm_enabled": false,
  "boundaries": [
    {
      "interface": "eth1",
      "acl": "mcast_boundary_in"
    }
  ],
  "rp_address": "192.168.10.1",
  "bsr_enabled": true,
  "cp_threshold": 1,
  "static_routes": [
    {
      "group": "239.100.0.0/24",
      "next_hop": "10.10.10.1",
      "interface": "eth2"
    }
  ],
  "interfaces": [
    {
      "name": "eth0",
      "mode": "sm",
      "hello_interval": 30,
      "dr_priority": 100,
      "pim_disabled": false,
      "igmp_querier": true
    },
    {
      "name": "eth1",
      "mode": "sm",
      "hello_interval": 60,
      "dr_priority": 1,
      "pim_disabled": false,
      "igmp_querier": false
    },
    {
      "name": "eth2",
      "mode": "dm",
      "hello_interval": 30,
      "dr_priority": 1,
      "pim_disabled": false,
      "igmp_querier": false
    }
  ],
  "access_lists": [
    {
      "name": "mcast_acl",
      "pattern": "239.0.0.0/8"
    },
    {
      "name": "mcast_boundary_in",
      "pattern": "239.100.0.0/24"
    }
  ],
  "boundary_outgoing": [
    {
      "interface": "tun0",
      "acl": "mcast_boundary_out"
    }
  ]
}
