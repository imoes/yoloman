# ==============================================================================
# pimd Configuration Template
# ==============================================================================
# This file configures pimd (PIM Sparse Mode daemon).
# The order of directives is critical for pimd's parser.
#
# Global defaults must appear before phyint (interface) specific directives.
#
# Variable Mapping:
#   default_route_distance : Admin distance for PIM Assert messages
#   default_route_metric   : Metric for PIM Assert messages
#   hello_interval         : PIM Hello packet interval (seconds)
#   bsr_candidate_priority : Priority for Bootstrap Router election
#   rp_candidate_time      : RP advertisement interval (seconds)
#   rp_candidate_priority  : RP election priority
#   spt_threshold_packets  : Packets to trigger Shortest Path Tree switch
#   spt_threshold_interval : SPT threshold test interval (seconds)
# ==============================================================================

# --------------------------------------------------------------------------
# Global Defaults
# --------------------------------------------------------------------------
# Default admin distance for PIM Assert messages.
# Lower value = higher priority. 101 is commonly recommended to prefer
# Cisco/GateD asserts over pimd asserts if they have higher values.
# Range: 1-255
{% if default_route_distance | default('') != '' %}
default-route-distance {{ default_route_distance }}
{% else %}
#default-route-distance 101
{% endif %}

# Default metric for PIM Assert messages.
# Used in PIM Assert elections if distances are equal.
# Range: 1-1024
{% if default_route_metric | default('') != '' %}
default-route-metric {{ default_route_metric }}
{% else %}
#default-route-metric 1024
{% endif %}

# PIM Hello interval in seconds.
# Controls how often PIM Hello messages are sent to neighbors.
# Do not set lower than 30 seconds to avoid excessive control plane traffic.
# Range: 30-18724
{% if hello_interval | default('') != '' %}
hello-interval {{ hello_interval }}
{% else %}
#hello-interval 30
{% endif %}

# --------------------------------------------------------------------------
# Interface Defaults (phyint)
# --------------------------------------------------------------------------
# The following section defines default behaviors for all PIM-enabled
# physical interfaces (phyint). Specific interface overrides can be
# added below if needed.
#
# By default, PIM is enabled on all non-loopback multicast-capable interfaces.
# To disable PIM on a specific interface, use:
# phyint <interface_name> disable
#
# To enable PIM on a loopback or specific interface, use:
# phyint <interface_name> enable
#
# Note: phyint directives must follow the global defaults above.

# --------------------------------------------------------------------------
# Bootstrap Router (BSR) Configuration
# --------------------------------------------------------------------------
# The BSR mechanism dynamically distributes RP (Rendezvous Point) information.
# This router can act as a candidate BSR.
#
# bsr-candidate [local-addr | ifname] [priority <0-255>]
#   local-addr/ifname: Optional. If omitted, the highest local IP is used.
#   priority:          Higher value = higher priority to become the active BSR.
#                      Default is usually 5.
bsr-candidate priority {{ bsr_candidate_priority | default('5') }}

# --------------------------------------------------------------------------
# Rendezvous Point (RP) Candidate Configuration
# --------------------------------------------------------------------------
# This router can act as a candidate RP for multicast groups.
#
# rp-candidate [local-addr | ifname] [priority <0-255>] [time <10-16383>]
#   local-addr/ifname: Optional. If omitted, the highest local IP is used.
#   priority:          Lower value = higher priority to become the RP.
#   time:              Interval in seconds to advertise RP candidacy.
#                      Smaller values mean faster convergence but more traffic.
#
# group-prefix <group-addr>[/masklen]
#   Defines the range of multicast groups this router is offering as RP.
#   Multiple group-prefix lines can be specified.

# Advertise RP candidacy for the IPv4 multicast range (224.0.0.0/4)
# Time interval in seconds between RP announcements.
# Default/Recommended: 30
rp-candidate time {{ rp_candidate_time | default(30) }} priority {{ rp_candidate_priority | default(20) }}
group-prefix 224.0.0.0 masklen 4

# Static RP Configuration (Optional)
# If you do not want to use BSR, you can statically define RPs.
# Uncomment and modify the line below if using static RP.
# rp-address <rp-ip> <group-addr>[/masklen]
# Example:
# rp-address 192.168.1.1 224.0.0.0/4

# --------------------------------------------------------------------------
# Shortest Path Tree (SPT) Threshold
# --------------------------------------------------------------------------
# By default, receivers switch from the Shared Tree (RPT) to the
# Shortest Path Tree (SPT) when they receive the first packet.
# This can cause unnecessary tree switches for low-bandwidth streams.
#
# spt-threshold [packets <N> | rate <KBPS> | infinity] [interval <SEC>]
#   packets: Number of packets received before switching to SPT.
#            0 means switch immediately after the first packet.
#   rate:    Switch if bandwidth exceeds this rate (kbps).
#   infinity: Never switch to SPT (stay on RPT).
#   interval: Time in seconds to re-evaluate the threshold.

# Switch to SPT after receiving the first packet (0).
# Re-evaluate the threshold every 100 seconds.
spt-threshold packets {{ spt_threshold_packets | default(0) }} interval {{ spt_threshold_interval | default(100) }}
