{
  "database_path": "/var/lib/fossil/fossil.db",
  "root_name": "home",
  "port": 443,
  "host": "0.0.0.0",
  "webui": true,
  "ssl": true,
  "ssl_cert_path": "/etc/ssl/fossil/fullchain.pem",
  "ssl_key_path": "/etc/ssl/fossil/privkey.pem",
  "auto_create": false,
  "max_connections": 100,
  "auth_method": "form",
  "allowed_ips": [
    "10.0.0.0/8",
    "192.168.1.*"
  ],
  "default_access": "reader",
  "users": [
    {
      "name": "admin",
      "password_hash": "$fossil$1$sha1$abc123...",
      "access": "admin",
      "comment": "Site administrator"
    },
    {
      "name": "dev",
      "password_hash": "$fossil$1$sha1$def456...",
      "access": "committer",
      "comment": "Core developer"
    }
  ],
  "hsts": true,
  "log_file": "/var/log/fossil/fossil.log",
  "log_level": "info",
  "base_url": "https://fossil.example.com/",
  "local_auth": false,
  "repository_root": "/var/lib/fossil/repos",
  "cgi": false,
  "cgi_path": "/usr/lib/fossil/fossil.cgi",
  "proxy": true,
  "timeout": 300,
  "compression": true,
  "cache": true,
  "cache_size_kb": 204800,
  "replication": false,
  "debug": false
}
