{
  "name": "Google",
  "icon": "account-google",
  "services": [
    {
      "id": "calendar",
      "name": "Calendar",
      "scopes": [
        "https://www.googleapis.com/auth/calendar.readonly"
      ],
      "discovery_url": "https://www.googleapis.com/discovery/v1/apis/calendar/v3/rest",
      "resource_auth": false
    },
    {
      "id": "contacts",
      "name": "Contacts",
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile"
      ],
      "discovery_url": "https://people.googleapis.com/$discovery/rest?version=v1",
      "resource_auth": true,
      "default_permissions": "read"
    },
    {
      "id": "drive",
      "name": "Drive",
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly"
      ],
      "discovery_url": "https://www.googleapis.com/discovery/v1/apis/drive/v3/rest",
      "resource_auth": true,
      "default_permissions": "read"
    }
  ],
  "auth_client_id": "123456789-abc123xyz.apps.googleusercontent.com",
  "auth_client_secret": "GOCSPX-abcdefghijk",
  "auth_redirect_uri": "urn:ietf:wg:oauth:2.0:oob",
  "auth_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
  "token_endpoint": "https://oauth2.googleapis.com/token",
  "revoke_endpoint": "https://oauth2.googleapis.com/revoke",
  "auth_refresh_mode": "auto",
  "auth_use_pkce": true,
  "allow_auto_provision": true,
  "sync_max_concurrent": 3,
  "sync_min_interval": 300,
  "sync_default_interval": 3600,
  "sync_enable_background": true,
  "sync_wifi_only": false
}
