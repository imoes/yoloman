{
  "database": "/var/cache/duc.db",
  "apparent_size": true,
  "ls_recursive": true,
  "ls_classify": true,
  "ls_color": true,
  "ls_levels": 3,
  "ui_no_color": true,
  "graph_format": "png",
  "graph_size": 1024,
  "graph_dpi": 150,
  "graph_palette": "rainbow",
  "cgi_css_url": "/static/duc.css",
  "cgi_header": "/etc/duc/header.html",
  "cgi_footer": "/etc/duc/footer.html",
  "index_fs_exclude": "proc,sysfs",
  "index_progress": true,
  "index_one_file_system": true,
  "index_max_depth": 5,
  "index_hide_file_names": true
}
