# Nutanix AHV fence agent configuration
# This file configures the fence agent for Nutanix AHV (Acropolis Hypervisor)
# Required for cluster fencing via Nutanix Prism API

# API endpoint for Nutanix Prism (required)
{% if prism_host %}ipaddr={{ prism_host }}{% endif %}

# API port for Nutanix Prism (default: 9440 for HTTPS)
{% if prism_port %}port={{ prism_port }}{% endif %}

# Username for authentication to Prism (required)
{% if username %}login={{ username }}{% endif %}

# Password or password file for authentication (password or password_script)
{% if password %}password={{ password }}{% endif %}
{% if password_script %}password_script={{ password_script }}{% endif %}

# Optional: use insecure SSL (skip certificate verification)
{% if insecure %}ssl_insecure=1{% endif %}

# Optional: use HTTP instead of HTTPS (not recommended; defaults to HTTPS)
{% if use_ssl is same as false %}ssl=0{% endif %}

# Optional: API version (e.g., v1, v2, v3, v4); defaults to latest supported
{% if api_version %}api_version={{ api_version }}{% endif %}

# Optional: Prism element UUID or cluster UUID for multi-cluster setups
{% if cluster_uuid %}cluster_uuid={{ cluster_uuid }}{% endif %}

# Optional: VM UUID or VM name (if not passed at runtime)
{% if vm_uuid %}vm_uuid={{ vm_uuid }}{% endif %}
{% if vm_name %}vm_name={{ vm_name }}{% endif %}

# Optional: Retry count and delay between retries
{% if retries %}retries={{ retries }}{% endif %}
{% if retry_sleep %}retry_sleep={{ retry_sleep }}{% endif %}
