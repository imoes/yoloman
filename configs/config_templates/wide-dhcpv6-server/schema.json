{
  "DHCP6SBIN": {
    "type": "string",
    "default": "/usr/sbin/dhcp6s",
    "description": "Path to the dhcp6s binary"
  },
  "DHCP6SPIDBASE": {
    "type": "string",
    "default": "/var/run/dhcp6s",
    "description": "Base path for PID files"
  },
  "NAME": {
    "type": "string",
    "default": "dhcp6s",
    "description": "Service name"
  },
  "DESC": {
    "type": "string",
    "default": "WIDE DHCPv6 server",
    "description": "Service description"
  },
  "STOP_RETRY_SCHEDULE": {
    "type": "string",
    "default": "TERM/20/forever/KILL/1",
    "description": "Stop retry schedule for start-stop-daemon"
  }
}
