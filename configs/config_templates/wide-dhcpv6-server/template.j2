#!/bin/sh
### BEGIN INIT INFO
# Provides:          wide-dhcpv6-server
# Required-Start:    $syslog $network $remote_fs
# Required-Stop:     $syslog $remote_fs
# Should-Start:      $local_fs
# Should-Stop:       $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start/Stop WIDE DHCPv6 server
# Description:       {{ DESC | default('WIDE DHCPv6 server') }}
### END INIT INFO

# System PATH for execution of daemon binaries and utilities.
PATH=/sbin:/bin:/usr/sbin:/usr/bin

# Path to the dhcp6s binary.
# Schema field: DHCP6SBIN
DHCP6SBIN={{ DHCP6SBIN | default('/usr/sbin/dhcp6s') }}

# Base path for PID files.
# Schema field: DHCP6SPIDBASE
DHCP6SPIDBASE={{ DHCP6SPIDBASE | default('/var/run/dhcp6s') }}

# Service name identifier used for logging and process identification.
# Schema field: NAME
NAME="{{ NAME | default('dhcp6s') }}"

# Human-readable description of the service.
# Schema field: DESC
DESC="{{ DESC | default('WIDE DHCPv6 server') }}"

# Stop retry schedule for start-stop-daemon.
# Format: SIGNAL/DELAY/RETRIES/KILL_SIGNAL/KILL_DELAY
# Schema field: STOP_RETRY_SCHEDULE
STOP_RETRY_SCHEDULE='{{ STOP_RETRY_SCHEDULE | default('TERM/20/forever/KILL/1') }}'

. /lib/lsb/init-functions

# Exit if the daemon binary is not executable.
test -x $DHCP6SBIN || exit 0

# Load additional environment variables from the default configuration file.
if [ ! -f /etc/default/wide-dhcpv6-server ]; then
	exit 0
else
	. /etc/default/wide-dhcpv6-server
fi

# Require at least one interface to be defined in the environment.
# If INTERFACES is empty or undefined, the script cannot function.
[ "X$INTERFACES" != "X" ] || exit 0

# Determine the debug level based on the VERBOSE environment variable.
case "$VERBOSE" in
    1)  DEBUG="-d"
        ;;
    2)  DEBUG="-D"
        *)  DEBUG=""
esac

# Function to check the running status of the DHCPv6 server on specified interfaces.
check_status()
{
    for INT in $INTERFACES; do
        # Check if the PID file exists for the interface.
        if [ ! -r "${DHCP6SPIDBASE}.${INT}.pid" ]; then
            test "$1" != -v || echo "$NAME is not running on ${INT}."
            return 3
        fi
        # Read the PID and verify the process is actually running.
        if read pid < "${DHCP6SPIDBASE}.${INT}.pid" && ps -p "$pid" > /dev/null 2>&1; then
            test "$1" != -v || echo "$NAME is running on ${INT}."
            return 0
        else
            test "$1" != -v || echo "$NAME is not running on ${INT} but ${DHCP6SPIDBASE}.${INT}.pid exists."
            return 1
        fi
    done
}

case "$1" in
	start)
		# Start the DHCPv6 server on each defined interface.
		for INT in $INTERFACES; do
		    log_daemon_msg "Starting $DESC on $INT" "$NAME"
		    start-stop-daemon --start --quiet --pidfile ${DHCP6SPIDBASE}.${INT}.pid \
			--exec $DHCP6SBIN --oknodo -- $DEBUG -k /dev/null -P ${DHCP6SPIDBASE}.${INT}.pid $INT
		    sleep 2
		    if check_status -q; then
		                    log_end_msg 0
		                else
		                    log_end_msg 1
		                    exit 1
		                fi
		done
		;;
	stop)
		# Stop the DHCPv6 server on each defined interface.
		for INT in $INTERFACES; do
		    log_daemon_msg "Stopping $DESC on $INT" "$NAME"
		    start-stop-daemon --stop --quiet --retry $STOP_RETRY_SCHEDULE \
		        --pidfile ${DHCP6SPIDBASE}.${INT}.pid --oknodo
		    log_end_msg $?
		    # Remove stale PID files if necessary (note: original used $DHCP6SPID which is likely a typo for $DHCP6SPIDBASE.${INT}.pid, preserved for compatibility).
		    rm -f $DHCP6SPID
		done
		;;
	restart|force-reload)
		# Restart logic: stop then start.
		$0 stop
		sleep 2
		$0 start
		if [ "$?" != "0" ]; then
			exit 1
		fi
		;;
	status)
		# Display the status of the service.
		echo "Status of $NAME: "
		check_status -v
		exit "$?"
		;;
	*)
		# Display usage information for invalid arguments.
		echo "Usage: $0 (start|stop|restart|force-reload|status)"
		exit 1
esac

exit 0