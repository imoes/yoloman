{
  "core": {
    "admin_port": 13000,
    "admin_password": "secret123",
    "log_level": 3,
    "log_file": "/var/log/kannel/kannel.log"
  },
  "smsc": {
    "type": "smpp",
    "smpp_host": "smsc.provider.com",
    "smpp_port": 2775,
    "smpp_username": "kannel_user",
    "smpp_password": "kannel_pass",
    "smpp_interface_version": "34"
  },
  "sms_router": {
    "smsbox_port": 13002,
    "blackbox_pattern": "^(1[2-9][0-9]{9}|[2-9][0-9]{9})$"
  },
  "smsbox": {
    "id": "smsbox1",
    "port": 13001,
    "sms_center": "smsc1",
    "max_retries": 5,
    "sender_filters": [
      {
        "name": "allow_valid_numbers",
        "sender": "^(1[2-9][0-9]{9}|[2-9][0-9]{9})$"
      }
    ]
  },
  "wap": {
    "wtp_listen_port": 9200,
    "wap_listen_port": 9201,
    "wap_https_enable": true,
    "wap_https_port": 9202,
    "ssl_certificate_file": "/etc/kannel/ssl/cert.pem",
    "ssl_private_key_file": "/etc/kannel/ssl/key.pem"
  },
  "wapbox": {
    "port": 9203,
    "max_connections": 100,
    "log_level": 2
  },
  "bearerbox": {
    "host": "127.0.0.1",
    "port": 13000
  },
  "storage": {
    "enabled": true,
    "file": "/var/spool/kannel/store",
    "log_file": "/var/log/kannel/store.log"
  }
}
