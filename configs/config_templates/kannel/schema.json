{
  "core": {
    "type": "object",
    "default": {},
    "description": "Core Kannel service settings",
    "items": {
      "admin_port": {
        "type": "number",
        "default": 13000,
        "description": "TCP port for the admin HTTP interface"
      },
      "admin_password": {
        "type": "string",
        "default": "x",
        "description": "Password for the admin interface (should be changed in production)"
      },
      "log_level": {
        "type": "number",
        "default": 3,
        "description": "Logging verbosity (0 = critical, 4 = debug)"
      },
      "log_file": {
        "type": "string",
        "default": "/var/log/kannel/kannel.log",
        "description": "Path to the main log file"
      }
    }
  },
  "smsc": {
    "type": "object",
    "default": {
      "type": "smpp"
    },
    "description": "SMS Center (SMSC) connection settings",
    "items": {
      "type": {
        "type": "string",
        "default": "smpp",
        "description": "SMSC interface type ('smpp' or 'http')"
      },
      "smpp_host": {
        "type": "string",
        "description": "SMSC host (required if type = 'smpp')"
      },
      "smpp_port": {
        "type": "number",
        "default": 2775,
        "description": "SMSC port (required if type = 'smpp')"
      },
      "smpp_system_type": {
        "type": "string",
        "default": "CPE",
        "description": "System type for SMPP binding"
      },
      "smpp_bind": {
        "type": "string",
        "default": "transceiver",
        "description": "SMPP bind mode: 'transmitter', 'receiver', or 'transceiver'"
      },
      "smpp_username": {
        "type": "string",
        "description": "SMPP system ID/username"
      },
      "smpp_password": {
        "type": "string",
        "description": "SMPP password"
      },
      "smpp_interface_version": {
        "type": "string",
        "default": "34",
        "description": "SMPP protocol version (e.g., '33', '34')"
      },
      "http_port": {
        "type": "number",
        "description": "HTTP SMSC listen port (required if type = 'http')"
      },
      "http_host": {
        "type": "string",
        "default": "0.0.0.0",
        "description": "HTTP SMSC listen host (optional)"
      }
    }
  },
  "sms_router": {
    "type": "object",
    "default": {},
    "description": "SMS router configuration",
    "items": {
      "smsbox_port": {
        "type": "number",
        "default": 13002,
        "description": "Port used by SMSBOX to connect to the router"
      },
      "blackbox_pattern": {
        "type": "string",
        "default": ".*",
        "description": "Regex pattern for blackbox routing (optional)"
      }
    }
  },
  "smsbox": {
    "type": "object",
    "default": {
      "id": "smsbox1",
      "port": 13001
    },
    "description": "SMSBOX instance configuration (handles SMS delivery)",
    "items": {
      "id": {
        "type": "string",
        "default": "smsbox1",
        "description": "Unique identifier for this SMSBOX"
      },
      "port": {
        "type": "number",
        "default": 13001,
        "description": "HTTP port for this SMSBOX instance"
      },
      "sms_center": {
        "type": "string",
        "default": "smsc1",
        "description": "Name of the SMS center this SMSBOX connects to"
      },
      "max_retries": {
        "type": "number",
        "default": 3,
        "description": "Maximum number of delivery retries per SMS"
      },
      "log_level": {
        "type": "number",
        "default": 3,
        "description": "SMSBOX log verbosity"
      },
      "log_file": {
        "type": "string",
        "default": "/var/log/kannel/smsbox.log",
        "description": "Path to SMSBOX log file"
      },
      "sender_filters": {
        "type": "list",
        "default": [],
        "description": "ACL rules to restrict SMS senders",
        "items": {
          "name": {
            "type": "string",
            "default": "rule0",
            "description": "Name of the filter rule"
          },
          "sender": {
            "type": "string",
            "default": ".",
            "description": "Regex pattern for allowed sender addresses"
          }
        }
      }
    }
  },
  "wap": {
    "type": "object",
    "default": {
      "wtp_listen_port": 9200,
      "wap_listen_port": 9201,
      "wap_https_enable": false
    },
    "description": "WAP gateway settings",
    "items": {
      "wtp_listen_port": {
        "type": "number",
        "default": 9200,
        "description": "WTP (Wireless Transaction Protocol) listen port"
      },
      "wap_listen_port": {
        "type": "number",
        "default": 9201,
        "description": "WAP (Wireless Application Protocol) HTTP listen port"
      },
      "wap_https_enable": {
        "type": "boolean",
        "default": false,
        "description": "Enable HTTPS for WAP access"
      },
      "wap_https_port": {
        "type": "number",
        "default": 9202,
        "description": "WAP HTTPS port (required if HTTPS enabled)"
      },
      "ssl_certificate_file": {
        "type": "string",
        "description": "Path to SSL certificate file (required if HTTPS enabled)"
      },
      "ssl_private_key_file": {
        "type": "string",
        "description": "Path to SSL private key file (required if HTTPS enabled)"
      }
    }
  },
  "wapbox": {
    "type": "object",
    "default": {
      "port": 9203,
      "max_connections": 50,
      "log_level": 2,
      "log_file": "/var/log/kannel/wapbox.log"
    },
    "description": "WAP box configuration (handles WAP sessions)",
    "items": {
      "port": {
        "type": "number",
        "default": 9203,
        "description": "HTTP port for WAPBOX administration"
      },
      "max_connections": {
        "type": "number",
        "default": 50,
        "description": "Maximum concurrent WAP connections"
      },
      "log_level": {
        "type": "number",
        "default": 2,
        "description": "WAPBOX log verbosity"
      },
      "log_file": {
        "type": "string",
        "default": "/var/log/kannel/wapbox.log",
        "description": "Path to WAPBOX log file"
      }
    }
  },
  "bearerbox": {
    "type": "object",
    "default": {
      "host": "localhost",
      "port": 13000
    },
    "description": "Bearerbox (core routing engine) configuration",
    "items": {
      "host": {
        "type": "string",
        "default": "localhost",
        "description": "Bearerbox host address"
      },
      "port": {
        "type": "number",
        "default": 13000,
        "description": "Bearerbox internal port for inter-process communication"
      }
    }
  },
  "storage": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "Message store configuration (optional, for store-and-forward)",
    "items": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable persistent message storage"
      },
      "file": {
        "type": "string",
        "default": "/var/spool/kannel/store/box",
        "description": "Base path for stored messages (if enabled)"
      },
      "log_file": {
        "type": "string",
        "default": "/var/log/kannel/store.log",
        "description": "Log file path for the storage service"
      },
      "log_level": {
        "type": "number",
        "default": 1,
        "description": "Storage log verbosity (1 = critical, 4 = debug)"
      }
    }
  }
}
