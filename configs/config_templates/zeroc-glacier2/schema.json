{
  "instance_name": {
    "type": "string",
    "default": "DemoGlacier2Router",
    "description": "The instance name for the Glacier2 router daemon."
  },
  "client_endpoints": {
    "type": "string",
    "default": "tcp -p 4063 -h localhost",
    "description": "The client-visible endpoint configuration (insecure TCP). Should be secure for production."
  },
  "client_endpoints_ssl": {
    "type": "string",
    "default": "ssl -p 4064 -h localhost",
    "description": "The client-visible endpoint configuration (secure SSL), commented out by default."
  },
  "server_endpoints": {
    "type": "string",
    "default": "tcp -h localhost",
    "description": "The server-visible endpoint configuration, used if callbacks are needed."
  },
  "permissions_verifier": {
    "type": "string",
    "default": "DemoGlacier2Router/NullPermissionsVerifier",
    "description": "The permissions verifier string. NullPermissionsVerifier allows any user-id/password."
  },
  "session_timeout": {
    "type": "number",
    "default": 30,
    "description": "The timeout for inactive sessions in seconds."
  },
  "use_systemd_journal": {
    "type": "string",
    "default": "1",
    "description": "Enable use of systemd journal for logging.",
    "enum": [
      "0",
      "1"
    ]
  },
  "trace_client_request": {
    "type": "string",
    "default": "1",
    "description": "Trace client requests.",
    "enum": [
      "0",
      "1"
    ]
  },
  "trace_server_request": {
    "type": "string",
    "default": "1",
    "description": "Trace server requests.",
    "enum": [
      "0",
      "1"
    ]
  },
  "trace_client_override": {
    "type": "string",
    "default": "1",
    "description": "Trace client overrides.",
    "enum": [
      "0",
      "1"
    ]
  },
  "trace_server_override": {
    "type": "string",
    "default": "1",
    "description": "Trace server overrides.",
    "enum": [
      "0",
      "1"
    ]
  },
  "trace_client_reject": {
    "type": "string",
    "default": "1",
    "description": "Trace client rejections.",
    "enum": [
      "0",
      "1"
    ]
  },
  "trace_session": {
    "type": "string",
    "default": "1",
    "description": "Trace session events.",
    "enum": [
      "0",
      "1"
    ]
  },
  "trace_routing_table": {
    "type": "string",
    "default": "1",
    "description": "Trace routing table events.",
    "enum": [
      "0",
      "1"
    ]
  },
  "warn_connections": {
    "type": "string",
    "default": "1",
    "description": "Warn about connection exceptions.",
    "enum": [
      "0",
      "1"
    ]
  }
}
