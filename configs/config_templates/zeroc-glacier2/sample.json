{
  "instance_name": "DemoGlacier2Router",
  "client_endpoints": "tcp -p 4063 -h localhost",
  "client_endpoints_ssl": "ssl -p 4064 -h localhost",
  "server_endpoints": "tcp -h localhost",
  "permissions_verifier": "DemoGlacier2Router/NullPermissionsVerifier",
  "session_timeout": 30,
  "use_systemd_journal": "1",
  "trace_client_request": "1",
  "trace_server_request": "1",
  "trace_client_override": "1",
  "trace_server_override": "1",
  "trace_client_reject": "1",
  "trace_session": "1",
  "trace_routing_table": "1",
  "warn_connections": "1"
}
