# /etc/tasksel/tasksel.conf
# tasksel configuration file

{# List of task names to be installed automatically on new installs (e.g., ['server']). #}
{# Rendered as a space-separated list. Empty list results in an empty string. #}
auto_install {{ auto_install_tasks | default([]) | join(' ') }}

{# List of task names to exclude from installation. #}
{# Rendered as a space-separated list. Empty list results in an empty string. #}
exclude_tasks {{ exclude_tasks | default([]) | join(' ') }}

{# Debconf password for tasksel, if required. #}
{# Used for non-interactive installs. Note: storing passwords in plain text config
   is generally insecure; ensure this file has restrictive permissions (e.g. 600). #}
debconf_password {{ debconf_password | default('') }}