# =============================================================================
# qBittorrent Enhanced WebUI Configuration Template
# =============================================================================
# This configuration file controls the Web UI behavior of qBittorrent.
# All variables must be provided via Ansible variables with sane defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# webui_port: Port number for the Web UI (corresponds to --webui-port=x)
# Default: 8080
# -----------------------------------------------------------------------------
WEBUI_PORT = {{ webui_port | default(8080) }}

# -----------------------------------------------------------------------------
# no_splash: Whether to disable the splash screen on startup (corresponds to --no-splash)
# Default: True
# -----------------------------------------------------------------------------
NO_SPLASH = {{ no_splash | default(True) | lower }}

# -----------------------------------------------------------------------------
# webui_address: IP address to bind the Web UI to
# Default: 0.0.0.0
# -----------------------------------------------------------------------------
WEBUI_ADDRESS = {{ webui_address | default('0.0.0.0') }}

# -----------------------------------------------------------------------------
# webui_base_path: Base path for Web UI API requests
# Default: /
# -----------------------------------------------------------------------------
WEBUI_BASE_PATH = {{ webui_base_path | default('/') }}

# -----------------------------------------------------------------------------
# webui_secure: Whether to enable HTTPS for the Web UI
# Default: False
# -----------------------------------------------------------------------------
WEBUI_SECURE = {{ webui_secure | default(False) | lower }}

# -----------------------------------------------------------------------------
# webui_cert_path: Path to the HTTPS certificate file
# Only used if webui_secure is enabled.
# Default: /etc/qbittorrent/cert.pem
# -----------------------------------------------------------------------------
WEBUI_CERT_PATH = {{ webui_cert_path | default('/etc/qbittorrent/cert.pem') }}

# -----------------------------------------------------------------------------
# webui_key_path: Path to the HTTPS private key file
# Only used if webui_secure is enabled.
# Default: /etc/qbittorrent/key.pem
# -----------------------------------------------------------------------------
WEBUI_KEY_PATH = {{ webui_key_path | default('/etc/qbittorrent/key.pem') }}

# -----------------------------------------------------------------------------
# webui_auth_method: Authentication method for Web UI: 'http' or 'local'
# Default: local
# -----------------------------------------------------------------------------
WEBUI_AUTH_METHOD = {{ webui_auth_method | default('local') }}

# -----------------------------------------------------------------------------
# webui_username: Username for local Web UI authentication
# Only used if webui_auth_method is 'local'.
# Default: admin
# -----------------------------------------------------------------------------
WEBUI_USERNAME = {{ webui_username | default('admin') }}

# -----------------------------------------------------------------------------
# webui_password: Password for local Web UI authentication (typically stored hashed)
# Only used if webui_auth_method is 'local'.
# Default: adminadmin
# -----------------------------------------------------------------------------
WEBUI_PASSWORD = {{ webui_password | default('adminadmin') }}

# -----------------------------------------------------------------------------
# alternative_download_location: Alternative default download location path
# If empty, uses the default download location defined in qBittorrent.
# Default: '' (empty string)
# -----------------------------------------------------------------------------
ALTERNATIVE_DOWNLOAD_LOCATION = {{ alternative_download_location | default('') }}