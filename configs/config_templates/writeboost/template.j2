## WriteBoost device-mapper target mapping configuration
## This file defines the mapping for the dm-writeboost target.
## See writeboosttab(5) for details on the format:
## <target_name> <hdd_device> <ssd_device> [options]

## The name of the service as referenced in log messages and script paths.
## Used as the prefix for the device-mapper target name (e.g., writeboost_hdd).
{# Determine the service name, defaulting to 'writeboost' if not provided #}
{%- set svc_name = name | default('writeboost') %}

## <target_name> <hdd_device> <ssd_device> [options]
## hdd_device: The block device path for the cached storage (e.g., HDD).
## ssd_device: The block device path for the caching storage (e.g., SSD).
## options: Comma-separated options for the writeboost target.
{{ svc_name }}_hdd     {{ hdd_device | default('/dev/disk/by-uuid/2e8260bc-024c-4252-a695-a73898c974c7') }}    {{ ssd_device | default('/dev/disk/by-partuuid/43372b68-3407-45fa-9b2f-61afe9c26a68') }}    {{ options | default('writeback_threshold=70,sync_data_interval=3600') }}
