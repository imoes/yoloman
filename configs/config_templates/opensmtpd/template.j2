#	$OpenBSD: smtpd.conf,V 1.10 2018-05-24 11:40:17 gilles Exp $

# This is the smtpd server system-wide configuration file.
# See smtpd.conf(5) for more information.

# Table mapping local recipient aliases to final delivery addresses.
# The aliases file must exist and contain standard alias definitions
# (e.g., root: user1, user2).
table aliases file:/etc/aliases

# =============================================================================
# Listener Configuration
# =============================================================================
# Define the network interfaces and ports smtpd listens on for incoming SMTP
# connections.
#
# Schema Field: smtpd_listen_address
# Description: The address and port smtpd listens on for incoming connections.
#              Common values include 'localhost', '0.0.0.0', or '::'.
# Default: 'localhost'
#
# Note: In OpenBSD smtpd.conf, 'listen on' expects an address. If a port is
# needed, it is typically specified as 'listen on <addr> port <port>' or by
# relying on the default port (25). However, this schema provides a single
# string value. We assume the user provides the full address specification or
# the default port behavior is sufficient.
#
# To accept external mail over IPv4, use: listen on 0.0.0.0
# To accept external mail over IPv6, use: listen on ::
# To listen on localhost only (default): listen on localhost

listen on {{ smtpd_listen_address | default('localhost') }}

# =============================================================================
# Actions
# =============================================================================
# Define how mail is handled once received.

# Action "local": Delivers mail to the Maildir format in the user's home directory,
# resolving aliases via the <aliases> table defined above.
action "local" maildir alias <aliases>

# Action "relay": Relays the mail to the next hop (upstream SMTP server) or
# delivers it directly if no relay is configured in the rules.
action "relay" relay

# =============================================================================
# Matching Rules
# =============================================================================
# Rules determine which actions are applied based on sender, recipient, and domain.

# Uncomment the following to accept external mail for specific domains.
# Example: match from any for domain "example.org" action "local"

# Default rule: Accept all mail for local domains and deliver it locally.
match for local action "local"

# Default rule: Relay all other mail (non-local domains) to the upstream relay.
# This handles outbound mail sent from this server or forwarded mail.
match from local for any action "relay"
