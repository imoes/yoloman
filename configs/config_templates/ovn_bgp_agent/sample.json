{
  "debug": false,
  "log_file": "/var/log/ovn/ovn-bgp-agent.log",
  "log_date_format": "%Y-%m-%d %H:%M:%S",
  "log_max_size": 100,
  "log_backup_count": 5,
  "ovsdb_socket": "unix:/run/openvswitch/db.sock",
  "bgp_speaker_type": "go-bgp",
  "bgp_as": 64512,
  "bgp_router_id": "auto",
  "bgp_graceful_restart": true,
  "bgp_hold_time": 90,
  "bgp_keepalive_interval": 30,
  "route_advertise_delay": 10,
  "advertise_node_local_ip": true,
  "advertise_external_ip": true,
  "bgp_neighbors": [
    {
      "name": "peer1",
      "address": "192.168.10.1",
      "remote_as": 64513,
      "password": "supersecret",
      "local_address": "192.168.10.2"
    },
    {
      "name": "peer2",
      "address": "2001:db8::1",
      "remote_as": 64514
    }
  ],
  "sr_iov_enabled": false,
  "sr_iov_pci_addresses": [],
  "ovn_nb_db": "tcp:10.0.0.5:6641",
  "ovn_sb_db": "tcp:10.0.0.5:6642",
  "ssl_ca_file": "/etc/ovn/ovn-bgp-agent-ca.crt",
  "ssl_cert_file": "/etc/ovn/ovn-bgp-agent.crt",
  "ssl_key_file": "/etc/ovn/ovn-bgp-agent.key",
  "ovs_bridge": "br-ex",
  "snmp_enabled": false,
  "snmp_listen": "0.0.0.0:161",
  "snmp_community": "public",
  "metrics_port": 9100,
  "healthcheck_enabled": true
}
