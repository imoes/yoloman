[DEFAULT]

{# Enables verbose debugging output for troubleshooting. Set to true for detailed logs. #}
debug = {{ debug | default(false) | ternary('true', 'false') }}

{# Path to the agent log file on disk. #}
log_file = {{ log_file | default('/var/log/ovn/ovn-bgp-agent.log') }}

{# Logging format string used by the Python logging module. #}
log_format = {{ log_format | default('%(asctime)s %(levelname)s %(name)s %(message)s') }}

{# Date/time format string used in log entries (Python strftime format). #}
log_date_format = {{ log_date_format | default('%Y-%m-%d %H:%M:%S') }}

{# Maximum size (in MiB) per log file before rotation occurs. #}
log_max_size = {{ log_max_size | default(100) }}

{# Number of rotated log files to retain on disk. #}
log_backup_count = {{ log_backup_count | default(5) }}

{# Path to the OVSDB management socket for local OVS interaction. #}
ovsdb_socket = {{ ovsdb_socket | default('unix:/run/openvswitch/db.sock') }}

{# BGP implementation to use; choose from 'go-bgp', 'frr', 'bird'. #}
bgp_speaker_type = {{ bgp_speaker_type | default('go-bgp') }}

{# Local autonomous system number for BGP. #}
bgp_as = {{ bgp_as | default(64512) }}

{# BGP router ID (IPv4 address); set to 'auto' to auto-detect. #}
bgp_router_id = {{ bgp_router_id | default('auto') }}

{# Enable BGP graceful restart support (RFC 4724). #}
bgp_graceful_restart = {{ bgp_graceful_restart | default(true) | ternary('true', 'false') }}

{# BGP hold timer in seconds (must be >= 3). #}
bgp_hold_time = {{ bgp_hold_time | default(90) }}

{# BGP keepalive interval in seconds (recommended: 1/3 hold_time). #}
bgp_keepalive_interval = {{ bgp_keepalive_interval | default(30) }}

{# Seconds to wait before advertising routes after BGP session establishment. #}
route_advertise_delay = {{ route_advertise_delay | default(10) }}

{# Advertise local node tunnel IPs (e.g., geneve/vxlan IPs) to BGP peers. #}
advertise_node_local_ip = {{ advertise_node_local_ip | default(true) | ternary('true', 'false') }}

{# Advertise external/subnet gateway IPs to BGP peers. #}
advertise_external_ip = {{ advertise_external_ip | default(true) | ternary('true', 'false') }}

{# List of BGP peers (neighbors) to connect to. Each neighbor generates a [bgp_neighbor:<name>] section. #}
{% for neighbor in bgp_neighbors | default([]) %}
[bgp_neighbor:{{ neighbor.name }}]
# BGP peer address (IPv4 or IPv6)
address = {{ neighbor.address }}
# BGP peer AS number
remote_as = {{ neighbor.remote_as }}
# Optional: password for BGP authentication (MD5)
{% if neighbor.password is defined %}password = {{ neighbor.password }}{% endif %}
# Optional: local address to use as source for BGP session
{% if neighbor.local_address is defined %}local_address = {{ neighbor.local_address }}{% endif %}
{% endfor %}

{# OVN Northbound database connection string. #}
ovn_nb_db = {{ ovn_nb_db | default('tcp:127.0.0.1:6641') }}

{# OVN Southbound database connection string. #}
ovn_sb_db = {{ ovn_sb_db | default('tcp:127.0.0.1:6642') }}

{# Path to CA certificate for secure DB connections (TLS). #}
ssl_ca_file = {{ ssl_ca_file | default('/etc/ovn/ovn-bgp-agent-ca.crt') }}

{# Path to client certificate for DB TLS. #}
ssl_cert_file = {{ ssl_cert_file | default('/etc/ovn/ovn-bgp-agent.crt') }}

{# Path to client private key for DB TLS. #}
ssl_key_file = {{ ssl_key_file | default('/etc/ovn/ovn-bgp-agent.key') }}

{# Name of the OVS bridge to use for external port IP discovery. #}
ovs_bridge = {{ ovs_bridge | default('br-ex') }}