# Main nginx configuration file
# Global settings: user, worker processes, PID file, logging
user {{ user }};
worker_processes {{ worker_processes }};
pid {{ pid_file }};
error_log {{ error_log_path }} level {{ error_log_level }};

# Event-driven configuration: connection handling, worker limits
events {
    worker_connections {{ worker_connections }};
    use {{ event_use }};
    multi_accept {{ 'on' if multi_accept else 'off' }};
}

# HTTP block: main HTTP server behavior
http {
    # Include MIME types and basic settings
    include {{ mime_types_file }};
    default_type {{ default_type }};

    # Logging
    access_log {{ access_log_path }} {{ access_log_format }};

    # Performance tuning
    sendfile {{ 'on' if sendfile else 'off' }};
    tcp_nopush {{ 'on' if tcp_nopush else 'off' }};
    tcp_nodelay {{ 'on' if tcp_nodelay else 'off' }};
    keepalive_timeout {{ keepalive_timeout }};
    types_hash_max_size {{ types_hash_max_size }};

    # Gzip compression
    gzip {{ 'on' if gzip_enabled else 'off' }};
    gzip_vary {{ 'on' if gzip_vary else 'off' }};
    gzip_proxied {{ gzip_proxied }};
    gzip_types {{ gzip_types | join(' ') }};
    gzip_comp_level {{ gzip_comp_level }};

    # Server block configuration (virtual hosts)
    {% for server in servers %}
    # Server: {{ server.name }}
    server {
        listen {{ server.listen }};
        server_name {{ server.server_name | join(' ') }};

        # Root and index files
        root {{ server.root }};
        index {{ server.index_files | join(' ') }};

        # SSL/TLS (optional)
        {% if server.ssl %}
        ssl_certificate {{ server.ssl_certificate }};
        ssl_certificate_key {{ server.ssl_certificate_key }};
        ssl_protocols {{ server.ssl_protocols | join(' ') }};
        ssl_ciphers {{ server.ssl_ciphers }};
        ssl_prefer_server_ciphers {{ 'on' if server.ssl_prefer_server_ciphers else 'off' }};
        {% endif %}

        # Location blocks
        {% for location in server.locations %}
        location {{ location.path }} {
            {% if location.type == 'proxy' %}
            proxy_pass {{ location.target }};
            proxy_set_header Host {{ location.host | default('host') }};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout {{ location.proxy_timeout | default(60) }};
            {% elif location.type == 'static' %}
            try_files {{ location.try_files }};
            {% elif location.type == 'redirect' %}
            return {{ location.status | default(301) }} {{ location.target }};
            {% elif location.type == 'rewrite' %}
            rewrite {{ location.regex }} {{ location.target }} {{ location.rewrite_flags | default('last') }};
            {% elif location.type == 'static_with_headers' %}
            try_files $uri $uri/ =404;
            {% for header in location.headers %}
            add_header {{ header.name }} {{ header.value }};
            {% endfor %}
            {% endif %}

            {% if location.extra_config %}
            # Extra configuration
            {{ location.extra_config | trim }}
            {% endif %}
        }
        {% endfor %}

        # Error pages (optional)
        {% if server.error_pages %}
        error_page {{ server.error_pages | map(attribute='code') | join(' ') }} {{ server.error_pages | map(attribute='path') | join(' ') }};
        {% endif %}

        # Custom configuration block (if provided)
        {% if server.extra_config %}
        # Custom config block
        {{ server.extra_config | trim }}
        {% endif %}
    }
    {% endfor %}

    # Optional: upstream definitions
    {% for upstream in upstreams %}
    # Upstream group: {{ upstream.name }}
    upstream {{ upstream.name }} {
        {% for server_addr in upstream.servers %}
        server {{ server_addr }}{% if server_addr.weight %} weight={{ server_addr.weight }}{% endif %}{% if server_addr.backup %} backup{% endif %};
        {% endfor %}
        {% if upstream.hash %}
        hash {{ upstream.hash.key }}{% if upstream.hash.consistent %} consistent{% endif %};
        {% endif %}
    }
    {% endfor %}

    # HTTP include additional configs (e.g., sites-enabled)
    include {{ http_include_path }};
}