{
  "pmacct_user": "pmacct",
  "pmacct_group": "pmacct",
  "log_file": "/var/log/pmacct/pmacctd.log",
  "log_level": 4,
  "daemonize": true,
  "pidfile": "/run/pmacct/pmacctd.pid",
  "interface": "any",
  "promisc": true,
  "snaplen": 1500,
  "plugins": [
    "sql",
    "syslog"
  ],
  "aggregate": "src_host, dst_host, src_port, dst_port, proto",
  "memory_limit": "512M",
  "accounting_interval": 60,
  "sql_enabled": true,
  "sql_db": "pmacct",
  "sql_user": "pmacct",
  "sql_pass": "secretpass123",
  "sql_host": "db.internal",
  "sql_port": 5432,
  "sql_table": "flows_v2",
  "sql_refresh_time": 30,
  "syslog_enabled": true,
  "syslog_facility": "local1",
  "syslog_priority": "info",
  "bgp_daemon": false,
  "bgp_peer_as": 64512,
  "bgp_local_as": 64512,
  "bgp_router_id": "192.168.1.1",
  "netflow_enabled": true,
  "netflow_port": 2055,
  "netflow_addr": "0.0.0.0",
  "sflow_enabled": false,
  "sflow_port": 6343,
  "sflow_addr": "10.0.0.1",
  "ipfix_enabled": false,
  "ipfix_port": 4739,
  "telemetry_enabled": false,
  "telemetry_port": 50051,
  "telemetry_proto": "telemetry_v2",
  "custom_fields": [
    {
      "name": "app_id",
      "value": "src_as:65001"
    },
    {
      "name": "vlan",
      "value": "src_ip:192.168.*"
    }
  ],
  "sampling_rate": 100,
  "aggregation_map": "/etc/pmacct/maps/aggregation.map",
  "prefix_file": "/usr/share/geoip/asn.mmdb"
}
