{
  "nfacctd_conf": "nfacctd.conf",
  "log_file": "/var/log/pmacct/pmacctd.log",
  "log_level": 3,
  "daemonize": true,
  "pidfile": "/run/pmacct/pmacctd.pid",
  "interface": "any",
  "promisc": true,
  "snaplen": 1500,
  "aggregate": "src_host, dst_host",
  "memory_limit": "1024M",
  "accounting_interval": 60,
  "plugins": [
    "memory"
  ],
  "sql_enabled": false,
  "sql_db": "pmacct",
  "sql_user": "pmacct",
  "sql_pass": "",
  "sql_host": "localhost",
  "sql_port": 5432,
  "sql_table": "acct",
  "sql_refresh_time": 60,
  "kafka_enabled": false,
  "kafka_topic": "pmacct",
  "kafka_brokers": "localhost:9092"
}
