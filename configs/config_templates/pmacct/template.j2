# ============================================================================
# nfacctd Configuration Enrichment Template
# ============================================================================
# This template generates the configuration file for pmacct's nfacctd daemon.
# It handles general daemon settings, capture parameters, aggregation keys,
# and conditional output plugins (SQL and Kafka).
# ============================================================================

# ---------------------------------------------------------------------------
# General Daemon Settings
# ---------------------------------------------------------------------------

# Relative filename of the nfacctd configuration file under /etc/pmacct/.
# Usually this refers to the file being parsed itself, but in this context
# it is stored as a variable for service management scripts.
# Default: 'nfacctd.conf'
nfacctd_conf = {{ nfacctd_conf | default('nfacctd.conf') }}

# Path to the main log file. Set to 'syslog' or '' for syslog-only logging.
# Default: '/var/log/pmacct/pmacctd.log'
log_file = {{ log_file | default('/var/log/pmacct/pmacctd.log') }}

# Logging verbosity: 0=quiet, 1=critical, 2=error, 3=warn, 4=info, 5=debug.
# Default: 3
log_level = {{ log_level | default(3) }}

# Run pmacctd as a background daemon (true) or foreground (false).
# Default: true
daemonize = {{ daemonize | default(true) | lower }}

# Path to PID file for daemon control.
# Default: '/run/pmacct/pmacctd.pid'
pidfile = {{ pidfile | default('/run/pmacct/pmacctd.pid') }}

# ---------------------------------------------------------------------------
# Capture Settings
# ---------------------------------------------------------------------------

# Network interface (e.g., eth0) or 'any' to capture on all interfaces.
# Default: 'any'
interface = {{ interface | default('any') }}

# Enable promiscuous mode to capture all traffic on the interface.
# Default: true
promisc = {{ promisc | default(true) | lower }}

# Maximum number of bytes to capture per packet (min 96, max 65535).
# Default: 1500
snaplen = {{ snaplen | default(1500) }}

# ---------------------------------------------------------------------------
# Aggregation Settings
# ---------------------------------------------------------------------------

# Key fields used to aggregate flows (comma-separated, e.g., src_host, dst_host, src_port).
# Default: 'src_host, dst_host'
aggregate = {{ aggregate | default('src_host, dst_host') }}

# Maximum memory to use for internal accounting tables (e.g., '256M', '1G').
# Default: '1024M'
memory_limit = {{ memory_limit | default('1024M') }}

# Time (in seconds) between exports/flushes of accounting data.
# Default: 60
accounting_interval = {{ accounting_interval | default(60) }}

# ---------------------------------------------------------------------------
# Output Plugins
# ---------------------------------------------------------------------------

# List of output plugins to use (e.g., memory, sql, kafka, syslog, bgp).
# Default: ['memory']
# Note: In the legacy config style, these are often specified via 'output' directives.
# Here we list them for internal reference or if the template expands to specific blocks.
plugins = {{ plugins | default(['memory']) | join(', ') }}

{# ----------------------------------------------------------------------- #}
{# SQL Output Plugin Configuration                                         #}
{# ----------------------------------------------------------------------- #}

# Enable SQL output plugin (PostgreSQL or MySQL/MariaDB).
# Default: false
{% if sql_enabled | default(false) %}
# SQL Output Plugin is ENABLED.
output = sql

# SQL server hostname or IP.
# Default: 'localhost'
sql_host = {{ sql_host | default('localhost') }}

# SQL server port (5432 for PostgreSQL, 3306 for MySQL).
# Default: 5432
sql_port = {{ sql_port | default(5432) }}

# Name of the SQL database for accounting data.
# Default: 'pmacct'
sql_db = {{ sql_db | default('pmacct') }}

# SQL username.
# Default: 'pmacct'
sql_user = {{ sql_user | default('pmacct') }}

# SQL password (empty if using peer/auth or keyring).
# Default: ''
sql_pass = {{ sql_pass | default('') }}

# Table name to store accounting data.
# Default: 'acct'
sql_table = {{ sql_table | default('acct') }}

# Seconds between SQL table updates.
# Default: 60
sql_refresh_time = {{ sql_refresh_time | default(60) }}
{% else %}
# SQL Output Plugin is DISABLED.
{% endif %}

{# ----------------------------------------------------------------------- #}
{# Kafka Output Plugin Configuration                                       #}
{# ----------------------------------------------------------------------- #}

# Enable Kafka output plugin.
# Default: false
{% if kafka_enabled | default(false) %}
# Kafka Output Plugin is ENABLED.
output = kafka

# Kafka topic name for accounting messages.
# Default: 'pmacct'
kafka_topic = {{ kafka_topic | default('pmacct') }}

# Comma-separated list of Kafka broker addresses.
# Default: 'localhost:9092'
kafka_brokers = {{ kafka_brokers | default('localhost:9092') }}
{% else %}
# Kafka Output Plugin is DISABLED.
{% endif %}

{# ----------------------------------------------------------------------- #}
{# Legacy Daemon Options (for initscript/systemd compatibility)            #}
{# ----------------------------------------------------------------------- #}

# Location of the configuration file
NFACCTD_CONF={{ nfacctd_conf | default('nfacctd.conf') }}

# Additional options that are passed to nfacctd.
# This block is generated for compatibility with legacy initscripts.
# It constructs the command-line arguments dynamically based on the config values.
DAEMON_OPTS="{{ log_file | default('/var/log/pmacct/pmacctd.log') }} --log-level={{ log_level | default(3) }} --daemonize={{ daemonize | default(true) | lower }} --pidfile={{ pidfile | default('/run/pmacct/pmacctd.pid') }} --interface={{ interface | default('any') }} --promisc={{ promisc | default(true) | lower }} --snaplen={{ snaplen | default(1500) }} --aggregate={{ aggregate | default('src_host, dst_host') }} --memory_limit={{ memory_limit | default('1024M') }} --accounting_interval={{ accounting_interval | default(60) }}{{ plugins | default(['memory']) | join(', ') }}"