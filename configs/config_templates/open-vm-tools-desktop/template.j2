# open-vm-tools-desktop configuration template
# This file configures the desktop daemons that open-vm-tools-desktop will start
# upon session initialization.
#
# The 'daemons_list' variable defines which desktop environment components
# (e.g., panels, window managers) are managed and started by this service.
# Ensure all listed daemons are installed on the system before enabling this configuration.

{% set daemons = daemons_list | default(['gnome-panel', 'ksmserver', 'startkde', 'kwrapper', 'panel', 'xfce4-panel', 'mate-panel']) %}

# List of desktop environment components/daemons to start with open-vm-tools-desktop.
# This is a list of daemon names.
{{ daemons | join('\n') }}