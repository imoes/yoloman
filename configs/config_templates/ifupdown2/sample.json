  "link_master_slave": 1,
  "delay_admin_state_change": 0,
  "ifreload_down_changed": 0,
  "addr_config_squash": 0,
  "ifaceobj_squash": 0,
  "adjust_logical_dev_mtu": 1,
  "state_dir": "/var/tmp/network/"
