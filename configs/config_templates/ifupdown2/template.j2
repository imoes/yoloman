#
# ifupdown2 configuration file
#
# This file contains default settings for ifupdown2.
# It is auto-generated by Ansible. Do not edit manually.
#
# All variables use the `default()` filter to ensure safe rendering
# even if specific values are not provided in the inventory/vars.

# Enable ifupdown2d daemon mode.
# Valid values: yes, no.
# Default: no
use_daemon={{ use_daemon | default('no') }}

# Enable template processing.
# Valid values: 0, 1.
# Default: 1
template_enable={{ template_enable | default('1') }}

# Default template engine to use.
# Currently only mako is supported.
# Default: mako
template_engine={{ template_engine | default('mako') }}

# Directory path where templates are looked up during rendering.
# Default: /etc/network/ifupdown2/templates
template_lookuppath={{ template_lookuppath | default('/etc/network/ifupdown2/templates') }}

# Path to the default network interfaces configuration file.
# This is the file parsed by ifupdown2 instead of /etc/network/interfaces.
# Default: /etc/network/interfaces
default_interfaces_configfile={{ default_interfaces_configfile | default('/etc/network/interfaces') }}

# Disable the -i interfacefile CLI option to reduce security issues.
# This prevents users from specifying arbitrary config files via CLI,
# mitigating risks from pre- and post-up/down commands in untrusted configs.
# Valid values: 0, 1.
# Default: 0
disable_cli_interfacesfile={{ disable_cli_interfacesfile | default('0') }}

# Enable Python addon module syntax checking.
# Python addon modules register a dictionary of supported attributes.
# The syntax checker uses this dictionary for validation.
# Note: Mixed use of scripts and modules may produce false warnings.
# Valid values: 0, 1.
# Default: 0
addon_syntax_check={{ addon_syntax_check | default('0') }}

# Support executing of ifupdown style scripts.
# Note: Python addon modules override scripts with the same name.
# Valid values: 0, 1.
# Default: 1
addon_scripts_support={{ addon_scripts_support | default('1') }}

# Enable python addons support.
# Valid values: 0, 1.
# Default: 1
addon_python_modules_support={{ addon_python_modules_support | default('1') }}

# Support multiple vlan filtering bridges.
# By default ifupdown2 only supports a single vlan filtering bridge.
# Set this to 1 to enable support for multiple.
# Valid values: 0, 1.
# Default: 0
multiple_vlan_aware_bridge_support={{ multiple_vlan_aware_bridge_support | default('0') }}

# String displayed for successful ifquery checks.
# Used by `ifquery --check`.
# Default: pass
ifquery_check_success_str={{ ifquery_check_success_str | default('pass') }}

# String displayed for failed ifquery checks.
# Used by `ifquery --check`.
# Default: fail
ifquery_check_error_str={{ ifquery_check_error_str | default('fail') }}

# String displayed for unknown ifquery check status.
# Used by `ifquery --check`.
# Default: empty string
ifquery_check_unknown_str={{ ifquery_check_unknown_str | default('') }}

# Control iface/vlan range expansions in ifquery default output.
# Valid values: 0, 1.
# Default: 0
ifquery_ifacename_expand_range={{ ifquery_ifacename_expand_range | default('0') }}

# Let link master (bridges, bonds) own the link state of slaves.
# If enabled, the state of slave interfaces is determined by the master.
# Valid values: 0, 1.
# Default: 1
link_master_slave={{ link_master_slave | default('1') }}

# Delay admin state change till the end.
# Useful for ensuring all interfaces are configured before changing admin state.
# Valid values: 0, 1.
# Default: 0
delay_admin_state_change={{ delay_admin_state_change | default('0') }}

# ifreload down behavior.
# If 0: down interfaces that were deleted only.
# If 1: down interfaces that were changed as well.
# Valid values: 0, 1.
# Default: 0
ifreload_down_changed={{ ifreload_down_changed | default('0') }}

# Squash all addr config when processing the first interface.
# Valid values: 0, 1.
# Default: 0
addr_config_squash={{ addr_config_squash | default('0') }}

# Squash iface config into one when having multiple iface stanzas.
# Prevents duplicate configuration errors.
# Valid values: 0, 1.
# Default: 0
ifaceobj_squash={{ ifaceobj_squash | default('0') }}

# Adjust logical devices MTU based on physical interface.
# If enabled, logical interfaces (like VLANs) inherit/adjust MTU from the parent.
# Valid values: 0, 1.
# Default: 1
adjust_logical_dev_mtu={{ adjust_logical_dev_mtu | default('1') }}

# Directory where the state file is stored.
# ifupdown2 will create this directory if it doesn't exist.
# If creation fails or variable is empty, it defaults to /var/tmp/network/.
# Default: /var/tmp/network/
state_dir={{ state_dir | default('/var/tmp/network/') }}
