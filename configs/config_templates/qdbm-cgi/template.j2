# QDBM CGI Configuration Template
#
# This file configures the QDBM CGI application. It is a simple key-value
# store interface.
#
# Variables are expected to come from Ansible host/group variables or defaults.
# Each directive is documented below with its schema description and default value.

# Character encoding for the CGI output
# Default: 'UTF-8'
encoding: {{ encoding | default('UTF-8') }}

# Language code for the interface
# Default: 'en'
lang: {{ lang | default('en') }}

# Title displayed in the browser window
# Default: 'Administration CGI'
title: {{ title | default('Administration CGI') }}

# Directory path for storing data files
# Default: 'qadmdir'
datadir: {{ datadir | default('qadmdir') }}

# Whether to chop/truncate long keys
# Default: True
keychop: {{ keychop | default(True) }}

# Whether to chop/truncate long values
# Default: False
valchop: {{ valchop | default(False) }}