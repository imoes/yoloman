{
  "encoding": {
    "type": "string",
    "default": "UTF-8",
    "description": "Character encoding for the CGI output"
  },
  "lang": {
    "type": "string",
    "default": "en",
    "description": "Language code for the interface"
  },
  "title": {
    "type": "string",
    "default": "Administration CGI",
    "description": "Title displayed in the browser window"
  },
  "datadir": {
    "type": "string",
    "default": "qadmdir",
    "description": "Directory path for storing data files"
  },
  "keychop": {
    "type": "bool",
    "default": true,
    "description": "Whether to chop/truncate long keys"
  },
  "valchop": {
    "type": "bool",
    "default": false,
    "description": "Whether to chop/truncate long values"
  }
}
