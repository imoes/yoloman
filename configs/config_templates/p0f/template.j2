; The default OS classes to match against (comma-separated list).
p0f_classes = {{ p0f_classes | default('win,unix,other') }}

; ==============
; MTU signatures
; ==============
; Defines Maximum Transmission Unit signatures for various link layer technologies.

[mtu]

; The most common values, used by Ethernet-homed systems, PPP over POTS, PPPoA DSL, etc.
; MTU signature for Ethernet or modem (first value).
label = Ethernet or modem
sig   = {{ mtu_ethernet_1 | default(576) }}

; MTU signature for Ethernet or modem (second value).
sig   = {{ mtu_ethernet_2 | default(1500) }}

; Common DSL-specific values (1492 is canonical for PPPoE, but ISPs tend to
; horse around a bit).
; MTU signature for DSL (first value).
label = DSL
sig   = {{ mtu_dsl_1 | default(1452) }}

; MTU signature for DSL (second value).
sig   = {{ mtu_dsl_2 | default(1454) }}

; MTU signature for DSL (third value).
sig   = {{ mtu_dsl_3 | default(1492) }}

; Miscellaneous tunnels (including VPNs, IPv6 tunneling, etc).
; MTU signature for GIF tunnel (first value).
label = GIF
sig   = {{ mtu_gif_1 | default(1240) }}

; MTU signature for GIF tunnel (second value).
sig   = {{ mtu_gif_2 | default(1280) }}

; MTU signature for generic tunnel or VPN (first value).
label = generic tunnel or VPN
sig   = {{ mtu_tunnel_1 | default(1300) }}

; MTU signature for generic tunnel or VPN (second value).
sig   = {{ mtu_tunnel_2 | default(1400) }}

; MTU signature for generic tunnel or VPN (third value).
sig   = {{ mtu_tunnel_3 | default(1420) }}

; MTU signature for generic tunnel or VPN (fourth value).
sig   = {{ mtu_tunnel_4 | default(1440) }}

; MTU signature for generic tunnel or VPN (fifth value).
sig   = {{ mtu_tunnel_5 | default(1450) }}

; MTU signature for generic tunnel or VPN (sixth value).
sig   = {{ mtu_tunnel_6 | default(1460) }}

; MTU signature for IPSec or GRE.
label = IPSec or GRE
sig   = {{ mtu_ipsec | default(1476) }}

; MTU signature for IPIP or SIT.
label = IPIP or SIT
sig   = {{ mtu_ipip | default(1480) }}

; MTU signature for PPTP.
label = PPTP
sig   = {{ mtu_pptp | default(1490) }}

; Really exotic stuff.
; MTU signature for AX.25 radio modem.
label = AX.25 radio modem
sig   = {{ mtu_ax25 | default(256) }}

; MTU signature for SLIP.
label = SLIP
sig   = {{ mtu_slip | default(552) }}

; MTU signature for Google.
label = Google
sig   = {{ mtu_google | default(1470) }}

; MTU signature for VLAN.
label = VLAN
sig   = {{ mtu_vlan | default(1496) }}

; MTU signature for Ericsson HIS modem.
label = Ericsson HIS modem
sig   = {{ mtu_ericsson | default(1656) }}

; MTU signature for jumbo Ethernet.
label = jumbo Ethernet
sig   = {{ mtu_jumbo | default(9000) }}

; Loopback interfaces on Linux and other systems.
; MTU signature for loopback (first value).
label = loopback
sig   = {{ mtu_loopback_1 | default(3924) }}

; MTU signature for loopback (second value).
sig   = {{ mtu_loopback_2 | default(16384) }}

; MTU signature for loopback (third value).
sig   = {{ mtu_loopback_3 | default(16436) }}

; ==================
; TCP SYN signatures
; ==================
; Signatures for the initial TCP SYN packet.

[tcp:request]

; -----
; Linux
; -----

; TCP SYN signature for Linux 3.11 and newer (first variant).
label = s:unix:Linux:3.11 and newer
sig   = {{ sig_linux_3_11_1 | default('*:64:0:*:mss*20,10:mss,sok,ts,nop,ws:df,id+:0') }}

; TCP SYN signature for Linux 3.11 and newer (second variant).
sig   = {{ sig_linux_3_11_2 | default('*:64:0:*:mss*20,7:mss,sok,ts,nop,ws:df,id+:0') }}

; TCP SYN signature for Linux 3.1-3.10 (first variant).
