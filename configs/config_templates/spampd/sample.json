{
  "bind_address": "127.0.0.1",
  "bind_port": 10025,
  "spamc_host": "127.0.0.1",
  "spamc_port": 783,
  "connect_timeout": 30,
  "read_timeout": 60,
  "log_level": "info",
  "log_file": "/var/log/spampd/spampd.log",
  "user": "spampd",
  "group": "spampd",
  "pid_file": "/run/spampd/spampd.pid",
  "max_children": 10,
  "skip_scanning_domains": [
    "localhost",
    "127.0.0.1"
  ],
  "custom_rules": [
    {
      "comment": "Lower required score for internal testing",
      "type": "option",
      "name": "required_hits",
      "value": "5.0"
    },
    {
      "comment": "Increase penalty for suspicious PDFs",
      "type": "score",
      "rule_name": "HAS_PDF_ATTACHMENT",
      "value": "2.0"
    }
  ],
  "whitelist_senders": [
    "postmaster@example.com",
    "noreply@example.org"
  ],
  "blacklist_senders": [
    "*.phishing.net",
    "spam@bad.com"
  ]
}
