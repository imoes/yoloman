# /etc/default/keyboard — System keyboard layout configuration
# This file is read by keyboard-setup init scripts during boot or manually via 'setupcon'

# XKB (X Keyboard Extension) layout — primary layout(s)
# Use comma-separated list for multiple layouts (e.g., 'us,ru')
XKB_LAYOUT={{ layout }}

# XKB variant — optional variant(s) per layout
# Leave empty or use comma-separated variants matching the layout order
XKB_VARIANT={{ variant | default('') | trim }}

# XKB options — additional layout/behavior options
# Examples: 'grp:alt_shift_toggle', 'caps:swapescape'
XKB_OPTIONS={{ options | default('') | trim }}

# Keyboard model — physical keyboard model (e.g., 'pc105', 'logiink360')
# Most systems use 'pc105' for standard 105-key keyboards
XKB_MODEL={{ model | default('pc105') }}

# Keyboard rule — rule set used (usually 'base' or 'evdev')
# 'base' is standard for most Linux distributions
XKB_RULES={{ rules | default('base') }}

# Keyboard device to reconfigure (optional, leave empty to apply system-wide)
# Typically left blank unless configuring a specific input device
KEYBOARD_DEVICE={{ device | default('') | trim }}
