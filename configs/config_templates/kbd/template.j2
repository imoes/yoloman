# /etc/default/keyboard — System keyboard layout configuration
# =============================================================================
# This file is read by keyboard-setup init scripts during boot or manually via 'setupcon'.
# It configures the X Keyboard Extension (XKB) for the system console and X/Wayland sessions.
#
# Schema Source: kbd
# =============================================================================

# XKB Layout
# ------------
# Primary keyboard layout(s).
# Use comma-separated values for multilingual setups (e.g., 'us,ru').
# Default: 'us'
XKB_LAYOUT={{ layout | default('us') }}

# XKB Variant
# ------------
# Optional layout variant(s) corresponding to each layout.
# Leave empty if using default variant(s).
# Default: ''
XKB_VARIANT={{ variant | default('') | trim }}

# XKB Options
# ------------
# XKB options to customize behavior (e.g., switching layout with Alt+Shift, swapping Caps Lock and Ctrl).
# Examples: 'grp:alt_shift_toggle', 'caps:swapescape'
# Leave empty for defaults.
# Default: ''
XKB_OPTIONS={{ options | default('') | trim }}

# Keyboard Model
# ---------------
# Physical keyboard model.
# 'pc105' is standard for most PCs. Other common values include 'pc104', 'pc102', 'sun5'.
# Default: 'pc105'
XKB_MODEL={{ model | default('pc105') }}

# Keyboard Rules
# ---------------
# XKB ruleset.
# 'base' works for most distributions; 'evdev' is used on some systems for better hardware support.
# Default: 'base'
XKB_RULES={{ rules | default('base') }}

# Keyboard Device
# ----------------
# Optional input device path to apply layout only to a specific keyboard.
# Leave blank to configure all keyboards system-wide.
# Example: '/dev/input/event0'
# Default: ''
KEYBOARD_DEVICE={{ device | default('') | trim }}