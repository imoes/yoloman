# Debian Bug Tracking System (debbugs) Web Interface Configuration
# This template generates the HTML access page for the debbugs web interface.
# It defines the project metadata, navigation links, and helper text.

$gAccessHtml = <<HTML_END
<!doctype html public "-//W3C//DTD HTML 4.0 Transitional//EN">
<html>
<head>
  {# Project name used in the browser tab title #}
  <title>{{ (gProject | default('Debian')) }} {{ (gBugs | default('$gBugs')) }} - Accessing the logs</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# Contact email for the bug tracking system maintainers #}
  <link rev="made" href="mailto:{{ (gMaintainerEmail | default('$gMaintainerEmail')) }}">
  {# Base path where the bug web interface CSS files are located #}
  <link rel="stylesheet" href="{{ (gWebHostBugDir | default('$gWebHostBugDir')) }}/css/bugs.css" type="text/css">
</head>
<body>

<h1><a name="developers">Accessing {{ (gBug | default('$gBug')) }} reports in the tracking system
logs</a></h1>

<p>Each message received at or sent by the {{ (gBug | default('$gBug')) }} processing system is
logged and made available in a number of ways.

{# HTML snippet listing ways to access logs — typically includes links to index pages. #}
{{ (gHTMLCopies | default('<p>Here are some ways to access the logs:\n<ul>\n  <li><a href="db/ix/full.html">Full list of outstanding and recent $gBug reports.</a>\n  <li><a href="db/ix/packages.html">Packages with $gBug reports.</a>\n  <li><a href="db/ix/maintainers.html">Maintainers of packages with $gBug reports.</a>\n</ul>')) }}

<p>There is a <a href="server-request.html">mailserver</a> which can send
{{ (gBug | default('$gBug')) }} reports as plain text on request.  To use it send the word
<code>help</code> as the sole contents of an email to
<code>request</code> (the <code>Subject</code> of the
message is ignored), or read the instructions on the World Wide Web or
in the file <code>bug-log-mailserver.txt</code>.

<hr>

<p>Other pages:
<ul>
  <li><a href="./">{{ (gBug | default('$gBug')) }} tracking system main contents page.</a>
  <li><a href="Reporting.html">Instructions for reporting {{ (gBugs | default('$gBugs')) }}.</a>
  <li><a href="Developer.html">Developers' information regarding the {{ (gBug | default('$gBug')) }} processing system.</a>
  <li><a href="db/ix/full.html">Full list of outstanding and recent {{ (gBug | default('$gBug')) }} reports.</a>
  <li><a href="db/ix/packages.html">Packages with {{ (gBug | default('$gBug')) }} reports.</a>
  <li><a href="db/ix/maintainers.html">Maintainers of packages with {{ (gBug | default('$gBug')) }} reports.</a>
  {# Extra HTML list items appended to the 'Other pages' list. Empty in the default config. #}
{{ (gHTMLOtherPageList | default('')) }}
</ul>

{# Trailing HTML snippet appended before the closing tags. #}
{{ (gHTMLTail | default('<p>For further information, please refer to the <a href="doc/index.html">documentation</a>.\n')) }}

HTML_END
