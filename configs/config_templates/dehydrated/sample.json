{
  "contact_email": "admin@example.com",
  "base_dir": "/var/lib/dehydrated",
  "wellknown_dir": "/var/www/html/.well-known/acme-challenge",
  "key_algo": "ecdsa",
  "key_size": 256,
  "pfs": "ec-256",
  "ca": "letsencrypt-staging",
  "hooks": [
    "/usr/local/bin/deploy-certs.sh",
    "/usr/local/bin/reload-nginx.sh"
  ],
  "dns_hooks": [
    "/usr/local/bin/dns-cloudflare.sh"
  ],
  "standalone_enabled": true,
  "standalone_port": 80,
  "san_domains": [
    "www.example.com",
    "mail.example.com"
  ],
  "challenge_type": "http-01",
  "no_renewal_check": false,
  "user_agent": "dehydrated/0.7.0 (example.com deployment)",
  "ca_bundle": ""
}
