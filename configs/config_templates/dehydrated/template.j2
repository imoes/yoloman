#############################################################
# This is the main config file for dehydrated               #
#                                                           #
# This is the default configuration for the Debian package. #
# To see a more comprehensive example, see                  #
# /usr/share/doc/dehydrated/examples/config                 #
#                                                           #
# For details please read:                                  #
# /usr/share/doc/dehydrated/README.Debian                   #
#############################################################

# Directory containing additional configuration files (conf.d style)
# Default: /etc/dehydrated/conf.d
CONFIG_D={{ config_d | default('/etc/dehydrated/conf.d') }}

# Base directory for dehydrated state and challenge files
# Default: /var/lib/dehydrated
BASEDIR={{ base_dir | default('/var/lib/dehydrated') }}

# Well-known directory for ACME challenges, resolved relative to BASEDIR
# Uses the shell variable expansion syntax literal, not Jinja
WELLKNOWN="${BASEDIR}/acme-challenges"

# Path to file listing domains and their aliases
# Default: /etc/dehydrated/domains.txt
DOMAINS_TXT="{{ domains_txt | default('/etc/dehydrated/domains.txt') }}"