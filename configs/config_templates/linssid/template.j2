# Configuration for linssid (graphical wireless scanner)
# This file controls the default behavior and device selection for linssid.

[General]
# Default interface to scan on (e.g., wlan0)
def_interface = {{ interface | default('wlan0') }}

# Enable or disable monitoring mode on the interface
enable_monitor_mode = {{ enable_monitor | default(true) | lower }}

# Set the refresh rate of the scan in seconds
scan_interval = {{ scan_interval | default(5) }}

[Display]
# Show hidden networks in the scan results
show_hidden = {{ show_hidden | default(false) | lower }}

# Enable or disable the channel graph visualization
show_channel_graph = {{ show_channel_graph | default(true) | lower }}

# Set the default zoom level for the graph (0-100)
graph_zoom = {{ graph_zoom | default(50) }}

[Advanced]
# Custom command to execute before scanning (e.g., for setting country code)
pre_scan_command = {{ pre_scan_command | default('') }}

# Custom command to execute after scanning
post_scan_command = {{ post_scan_command | default('') }}