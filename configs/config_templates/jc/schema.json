{
  "force_color": {
    "type": "bool",
    "default": false,
    "description": "Force color output even when using pipes"
  },
  "output_format": {
    "type": "string",
    "default": "json",
    "description": "Output format, either json or yaml",
    "enum": [
      "json",
      "yaml"
    ]
  },
  "pretty_print": {
    "type": "bool",
    "default": false,
    "description": "Pretty print output"
  },
  "monochrome": {
    "type": "bool",
    "default": false,
    "description": "Monochrome output"
  },
  "meta_out": {
    "type": "bool",
    "default": false,
    "description": "Add metadata to output"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Suppress parser warning messages"
  },
  "raw_output": {
    "type": "bool",
    "default": false,
    "description": "Provide raw/literal output"
  },
  "slurp": {
    "type": "bool",
    "default": false,
    "description": "Slurp multiple lines into an array"
  },
  "unbuffer": {
    "type": "bool",
    "default": false,
    "description": "Unbuffer output for streaming parsers"
  },
  "jc_colors": {
    "type": "list",
    "default": [
      "default",
      "default",
      "default",
      "default"
    ],
    "description": "Custom colors for key, keyword, number, and string in format [keyname, keyword, number, string]"
  },
  "line_slice": {
    "type": "string",
    "default": "",
    "description": "Line slice syntax for input processing (e.g., '1:-1')"
  },
  "default_parser": {
    "type": "string",
    "default": "",
    "description": "Default parser to use if not explicitly specified"
  }
}
