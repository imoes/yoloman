# jc (JSON Convert) configuration file.
# This template manages the global configuration for the `jc` command-line utility.
# It converts output from *nix commands/scripts into structured data (JSON/YAML).
#
# All variables map directly to the schema fields. Each directive is commented
# with its original schema description for self-documentation.

# Force color output even when using pipes
FORCE_COLOR: {{ force_color | default(False) | lower }}

# Output format, either json or yaml
OUTPUT_FORMAT: {{ output_format | default('json') }}

# Pretty print output
PRETTY_PRINT: {{ pretty_print | default(False) | lower }}

# Monochrome output
MONOCHROME: {{ monochrome | default(False) | lower }}

# Add metadata to output including timestamp, parser name, etc.
META_OUT: {{ meta_out | default(False) | lower }}

# Quiet mode. Suppresses parser warning messages
QUIET: {{ quiet | default(False) | lower }}

# Raw output. Provides more literal output
RAW_OUTPUT: {{ raw_output | default(False) | lower }}

# Slurp multiple lines into an array
SLURP: {{ slurp | default(False) | lower }}

# Unbuffer output for streaming parsers
UNBUFFER: {{ unbuffer | default(False) | lower }}

# Custom colors for key, keyword, number, and string in format [keyname, keyword, number, string]
# Outputs a comma-separated list of color names.
JC_COLORS: {{ jc_colors | default(['default', 'default', 'default', 'default']) | join(',') }}

# Line slice syntax for input processing (e.g., '1:-1')
LINE_SLICE: {{ line_slice | default('') }}

# Default parser to use if not explicitly specified
DEFAULT_PARSER: {{ default_parser | default('') }}