{
 "auth": {},
 "db_interval": 3600,
 "hooks_libraries": [
  {
   "library": "/usr/lib/kea/hooks/libdhcp_stat_cmds.so",
   "parameters": {}
  },
  {
   "library": "/usr/lib/kea/hooks/libdhcp_lease_cmds.so",
   "parameters": {
    "control-socket": {
     "name": "/var/run/kea/dhcp4-lease-cmds.sock",
     "socket-type": "unix"
    }
   }
  }
 ],
 "lease_database_lfc_interval": 600,
 "lease_database_name": "/var/lib/kea/kea-leases4.csv",
 "lease_database_persist": true,
 "loggers": [
  {
   "debuglevel": 0,
   "flush": true,
   "max_size": 10485760,
   "max_versions": 5,
   "name": "kea-dhcp4",
   "output": "/var/log/kea/kea-dhcp4.log",
   "severity": "INFO"
  },
  {
   "debuglevel": 0,
   "name": "kea-dhcp4.dhcpsrv",
   "output": "stderr",
   "severity": "WARN"
  }
 ],
 "reconnect_wait_time": 0
}
