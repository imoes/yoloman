<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  Font configuration for Amiri Quran.
  This template sets up font aliases for the 'serif' family to prefer 'Amiri Quran'.
-->
<fontconfig>
    <!--
      Alias: serif
      Description: Defines the preferred font for the generic 'serif' family alias.
      Schema field: serif_prefer_family (default: 'Amiri Quran')
    -->
    <alias>
        <family>serif</family>
        <prefer>
            <!-- The font family name to prefer for the 'serif' alias. -->
            <family>{{ serif_prefer_family | default('Amiri Quran') }}</family>
        </prefer>
    </alias>

    <!--
      Alias: Amiri Quran
      Description: Ensures the specific font family falls back to 'serif' if not explicitly matched elsewhere.
    -->
    <alias>
        <!-- The font family name being configured. -->
        <family>{{ serif_prefer_family | default('Amiri Quran') }}</family>
        <default>
            <family>serif</family>
        </default>
    </alias>
</fontconfig>
