# ytcc configuration file
# See ytcc(1) man page for details
#
# This file is auto-generated by Ansible. Do not edit manually.
# All variables are explicitly defaulted to schema values to prevent
# rendering failures when a role does not supply them.

# loglevel: Default log level for ytcc operations. Options: critical, info, debug.
loglevel = {{ loglevel | default('info') }}

# output: Default output format for commands. Options: json, table, xsv, rss, plain.
output = {{ output | default('table') }}

# separator: Delimiter used in XSV output format.
separator = "{{ separator | default(',') }}"

# truncate: Table truncation setting. Options: max, no, or an integer N.
truncate = "{{ truncate | default('max') }}"

# subscriptions: List of playlist subscriptions to track.
# Each subscription is an object with fields: name, url, reverse.
# If this list is empty, no subscription blocks are emitted.
{% for sub in subscriptions | default([]) %}
[[subscriptions]]
# name: The display name for this subscription.
name = "{{ sub.name | default('') }}"

# url: The RSS/Atom feed URL for the playlist.
url = "{{ sub.url | default('') }}"

# reverse: Whether to process items in reverse chronological order.
# Defaults to false if not specified in the schema.
{% if sub.reverse | default(false) %}
reverse = true
{% endif %}

{% endfor %}