{
  "default_server": "whois.arin.net",
  "whois_servers": [
    {
      "regex": "\\.com$",
      "server": "whois.verisign-grs.com"
    },
    {
      "regex": "\\.de$",
      "server": "whois.denic.de"
    },
    {
      "regex": "\\.jp$",
      "server": "whois.jprs.jp"
    },
    {
      "regex": "^AS",
      "server": "whois.arin.net"
    }
  ]
}
