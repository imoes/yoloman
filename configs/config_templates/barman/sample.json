{
  "barman_home": "/var/lib/barman",
  "barman_locks": "/var/lib/barman",
  "barman_log_file": "/var/log/barman/barman.log",
  "log_level": "INFO",
  "wal_retention_policy": 7,
  "compression": "lz4",
  "compression_filter": "lz4 -z",
  "parallel_jobs": 2,
  "ssh_command": "ssh -o BatchMode=yes -o StrictHostKeyChecking=no",
  "rsync_ssh_command": "ssh -o BatchMode=yes -o StrictHostKeyChecking=no",
  "servers": [
    {
      "name": "main_db",
      "description": "Production PostgreSQL primary server",
      "conninfo_host": "pg01.example.com",
      "conninfo_user": "barman",
      "conninfo_dbname": "postgres",
      "conninfo_port": 5432,
      "pg_data_directory": "/var/lib/postgresql/14/main",
      "pg_bin_directory": "/usr/lib/postgresql/14/bin",
      "pg_config_directory": "/etc/postgresql/14/main",
      "base_backup_method": "postgres",
      "streaming_archiver": "on",
      "streaming_conninfo_host": "pg01.example.com",
      "streaming_conninfo_user": "repl",
      "streaming_conninfo_port": 5432,
      "wal_archive_method": "barman_wal_archive",
      "archive_timeout": 300,
      "min_wal_size_to_keep": "8GB",
      "max_wal_size_to_keep": "40GB",
      "backup_method": "rsync",
      "archive_directory": "/var/lib/barman/main_db/wals",
      "check_postgreSQL": true,
      "check_wal_archive": true,
      "check_min_wal_size": true,
      "check_archiver": true,
      "check_backup": true,
      "check_wal_archive_latency": true
    },
    {
      "name": "analytics_db",
      "description": "Analytics PostgreSQL replica",
      "conninfo_host": "pg02.example.com",
      "conninfo_user": "barman",
      "conninfo_dbname": "postgres",
      "conninfo_port": 5432,
      "ssh_command": "ssh -o BatchMode=yes -o IdentityFile=/etc/barman/id_rsa_analytics",
      "pg_data_directory": "/var/lib/postgresql/15/main",
      "pg_bin_directory": "/usr/lib/postgresql/15/bin",
      "pg_config_directory": "/etc/postgresql/15/main",
      "base_backup_method": "postgres",
      "streaming_archiver": "off",
      "wal_archive_method": "barman_wal_archive",
      "archive_timeout": 0,
      "min_wal_size_to_keep": "4GB",
      "max_wal_size_to_keep": "20GB",
      "backup_method": "pg_basebackup",
      "compression": "gzip",
      "compression_filter": "gzip -6",
      "archive_directory": "",
      "check_postgreSQL": true,
      "check_wal_archive": false,
      "check_min_wal_size": false,
      "check_archiver": false,
      "check_backup": true,
      "check_wal_archive_latency": false
    }
  ]
}
