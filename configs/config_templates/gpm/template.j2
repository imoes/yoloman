#!/bin/sh
# GPM (General Purpose Mouse) Suspend/Resume Hook
# This script is designed to be called by systemd or pm-utils during suspend/resume cycles.
# It manages the gpm service to ensure mouse support is available in the console.

case "${1}" in
suspend)
    # Stop the GPM service before suspending to prevent state corruption.
    # The service name is configurable via the service_name variable.
    invoke-rc.d {{ service_name | default('gpm') }} stop >/dev/null
    ;;
resume)
    # Start the GPM service after resuming to restore mouse functionality.
    # The service name is configurable via the service_name variable.
    invoke-rc.d {{ service_name | default('gpm') }} start >/dev/null
    ;;
esac

exit 0
