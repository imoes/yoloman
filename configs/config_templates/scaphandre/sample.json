{
  "command": "prometheus",
  "verbosity": 1,
  "no_header": true,
  "sensor": "rapl",
  "sensor_buffer_per_domain_max_kb": 2,
  "sensor_buffer_per_socket_max_kb": 4,
  "vm": false,
  "prometheus_bind_address": "127.0.0.1",
  "prometheus_port": 9200,
  "pushgateway_url": "http://localhost:9091",
  "pushgateway_job": "scaphandre",
  "json_output_path": "",
  "qemu_metrics_path": "/var/run/scaphandre/qemu-metrics"
}
