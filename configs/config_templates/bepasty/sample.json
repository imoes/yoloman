{
  "base_url": "https://paste.example.com",
  "upload_dir": "/var/lib/bepasty/uploads",
  "secret_key": "supersecretkey123!@#",
  "public_enabled": true,
  "listing_enabled": false,
  "default_expiration": 604800,
  "max_file_size": 52428800,
  "max_uploads_per_ip_per_day": 50,
  "rate_limit_enabled": true,
  "allowed_mime_types": [
    "text/plain",
    "text/x-python",
    "text/markdown",
    "image/png",
    "image/jpeg",
    "application/pdf"
  ],
  "inline_mime_types": [
    "text/plain",
    "text/x-python",
    "image/png",
    "image/jpeg"
  ],
  "database_url": "sqlite:////var/lib/bepasty/bepasty.db",
  "session_cookie_secure": true,
  "session_cookie_samesite": "Strict",
  "workers": 4,
  "bind_address": "0.0.0.0",
  "port": 8080,
  "log_level": "INFO",
  "log_file": "/var/log/bepasty/bepasty.log",
  "admin_enabled": true,
  "admins": [
    "admin@example.com"
  ],
  "password_protection_enabled": true,
  "min_password_length": 10,
  "cleanup_expired_enabled": true,
  "cleanup_unclaimed_enabled": true,
  "cleanup_unclaimed_after_seconds": 7200,
  "captcha_enabled": true,
  "captcha_provider": "recaptcha-v2",
  "recaptcha_site_key": "6LcZ...public",
  "recaptcha_secret_key": "6LcZ...private",
  "registration_enabled": true,
  "email_verification_enabled": true,
  "smtp_server": "smtp.example.com",
  "smtp_port": 587,
  "smtp_use_tls": true,
  "smtp_from": "bepasty-noreply@example.com"
}
