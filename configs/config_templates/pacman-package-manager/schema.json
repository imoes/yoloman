{
  "db_path": {
    "type": "string",
    "default": "/var/lib/pacman/",
    "description": "Database path for pacman metadata."
  },
  "cache_dir": {
    "type": "string",
    "default": "/var/cache/pacman/pkg/",
    "description": "Directory where downloaded packages are cached."
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/pacman.log",
    "description": "Path to the pacman log file."
  },
  "gpg_dir": {
    "type": "string",
    "default": "/etc/pacman.d/gnupg/",
    "description": "Directory for GPG keys used by pacman."
  },
  "hook_dir": {
    "type": "string",
    "default": "/etc/pacman.d/hooks/",
    "description": "Directory for pacman hooks."
  },
  "architecture": {
    "type": "string",
    "default": "auto",
    "description": "Target architecture for package downloads."
  },
  "parallel_downloads": {
    "type": "number",
    "default": 5,
    "description": "Maximum number of simultaneous mirror downloads."
  }
}
