{
  "globus_home": "/var/lib/globus",
  "service_name": "globus-gridftp",
  "bind_interface": "",
  "control_port": 2811,
  "data_port_min": 50000,
  "data_port_max": 55000,
  "tls_enabled": true,
  "tls_cert_path": "/etc/grid-security/hostcert.pem",
  "tls_key_path": "/etc/grid-security/hostkey.pem",
  "tls_protocol": "1.2",
  "client_cert_verify": false,
  "ca_cert_path": "/etc/grid-security/certificates/",
  "max_connections": 100,
  "max_threads": 16,
  "rfc3540_enabled": true,
  "log_level": 3,
  "log_path": "/var/log/globus/gridftp.log",
  "tcp_nodelay": true,
  "auth_methods": [
    "gridftp",
    "userpass"
  ],
  "authz_rules": [
    "permit user=* action=*"
  ],
  "chroot_dirs": [],
  "allowed_groups": [
    "griduser"
  ],
  "timeout_idle": 600,
  "timeout_data": 300
}
