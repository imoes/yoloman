<?xml version="1.0" encoding="UTF-8"?>
<!--
  Globus GridFTP Server Configuration
  ===================================
  Self-documenting Jinja2 template for Ansible.
  All variables use schema defaults to ensure safe rendering even when
  optional variables are omitted in the play.
-->
<Configuration>
  {# GlobusHome: Base directory for Globus runtime files, certificates, and temporary data. #}
  <GlobusHome>{{ globus_home | default('/var/lib/globus') }}</GlobusHome>

  {# Interface: Network interface to bind the control listener to (e.g., 'eth0').
     Leave empty to bind to all interfaces. #}
  <Interface>{{ bind_interface | default('') }}</Interface>

  {# Port: TCP port used for GridFTP control connections. #}
  <Port>{{ control_port | default(2811) }}</Port>

  {# DataPortMin: Lowest TCP port available for passive data connections. #}
  <DataPortMin>{{ data_port_min | default(50000) }}</DataPortMin>

  {# DataPortMax: Highest TCP port available for passive data connections. #}
  <DataPortMax>{{ data_port_max | default(55000) }}</DataPortMax>

  {# TLS: Enable TLS encryption for control and data channels. #}
  <TLS>{{ tls_enabled | default(True) | lower }}</TLS>

  {# CertificateFile: Path to the server’s TLS certificate (PEM format).
     Required if TLS is enabled. #}
  <CertificateFile>{{ tls_cert_path | default('/etc/grid-security/hostcert.pem') }}</CertificateFile>

  {# KeyFile: Path to the server’s TLS private key (PEM format, unencrypted).
     Required if TLS is enabled. #}
  <KeyFile>{{ tls_key_path | default('/etc/grid-security/hostkey.pem') }}</KeyFile>

  {# TLSProtocol: Supported TLS protocol versions (e.g., '1.2', '1.2:1.3').
     Avoid insecure protocols like SSLv3 or TLS 1.0. #}
  <TLSProtocol>{{ tls_protocol | default('1.2') }}</TLSProtocol>

  {# VerifyClient: Require and verify client TLS certificates (mTLS).
     Use with GridFTP GSI authentication. #}
  <VerifyClient>{{ client_cert_verify | default(False) | lower }}</VerifyClient>

  {# CACertificateFile: Path to CA certificate bundle or directory for verifying
     client certificates. Required if `client_cert_verify` is true. #}
  <CACertificateFile>{{ ca_cert_path | default('/etc/grid-security/certificates/') }}</CACertificateFile>

  {# MaxConnections: Maximum number of concurrent client connections allowed. #}
  <MaxConnections>{{ max_connections | default(100) }}</MaxConnections>

  {# MaxThreads: Maximum number of worker threads handling I/O operations. #}
  <MaxThreads>{{ max_threads | default(16) }}</MaxThreads>

  {# RFC3540: Enable RFC 3540 extensions (e.g., MLSD, MFMT) for modern FTP clients. #}
  <RFC3540>{{ rfc3540_enabled | default(True) | lower }}</RFC3540>

  {# LogLevel: Logging verbosity: 0=none, 1=error, 2=warn, 3=info, 4=debug, up to 10. #}
  <LogLevel>{{ log_level | default(3) }}</LogLevel>

  {# LogPath: File path for server logs. If empty, logs go to system syslog. #}
  <LogPath>{{ log_path | default('') }}</LogPath>

  {# TCPNoDelay: Disable Nagle’s algorithm for lower latency data transfers. #}
  <TCPNoDelay>{{ tcp_nodelay | default(True) | lower }}</TCPNoDelay>

  {# AuthMethods: Ordered list of supported authentication mechanisms. #}
  <AuthMethods>
    {% for method in auth_methods | default(['gridftp', 'userpass']) %}
    <AuthMethod>{{ method }}</AuthMethod>
    {% endfor %}
  </AuthMethods>

  {# Authorization: GSI-based authorization rules for fine-grained access control. #}
  <Authorization>
    {% for rule in authz_rules | default(['permit all']) %}
    <Rule>{{ rule }}</Rule>
    {% endfor %}
  </Authorization>

  {# ChrootDirs: List of chroot directories to restrict users’ filesystem access. #}
  <ChrootDirs>
    {% for dir in chroot_dirs | default([]) %}
    <Directory>{{ dir }}</Directory>
    {% endfor %}
  </ChrootDirs>

  {# AllowedGroups: List of groups whose members may authenticate and use the service. #}
  <AllowedGroups>
    {% for group in allowed_groups | default([]) %}
    <Group>{{ group }}</Group>
    {% endfor %}
  </AllowedGroups>

  {# Timeouts: Connection timeout configuration. #}
  <Timeouts>
    {# IdleTimeout: Seconds of inactivity before the server closes a control connection. #}
    <IdleTimeout>{{ timeout_idle | default(600) }}</IdleTimeout>

    {# DataTimeout: Seconds of inactivity before the server closes a data connection. #}
    <DataTimeout>{{ timeout_data | default(300) }}</DataTimeout>
  </Timeouts>
</Configuration>