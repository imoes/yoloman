{
  "nbd_root_path": "/var/lib/nbd/root",
  "nbd_enabled": true,
  "tftp_root_path": "/var/lib/tftpboot",
  "tftp_enabled": true,
  "dns_domain": "ltsp.school.local",
  "default_gateway": "10.10.0.1",
  "dhcp_enabled": true,
  "dhcp_start": "10.10.0.50",
  "dhcp_end": "10.10.0.150",
  "subnet_mask": "24",
  "nameserver": "10.10.0.1",
  "nameservers": [
    "8.8.8.8",
    "1.1.1.1"
  ],
  "locale": "en_US.UTF-8",
  "keyboard": "us",
  "timezone": "America/New_York",
  "pulseaudio_enabled": true,
  "xorg_autodetect": true,
  "client_kernel_modules": [
    "nbd",
    "squashfs",
    "overlay"
  ],
  "client_packages": [
    "ltsp-client-core",
    "xserver-xorg",
    "lightdm",
    "xfce4",
    "firefox",
    "libreoffice"
  ],
  "ltsp_image_path": "/opt/ltsp",
  "ltsp_compress": true,
  "nbd_compress": "gzip",
  "local_login": false,
  "allow_root_login": false,
  "session_type": "xfce",
  "kernel_params": [
    "quiet",
    "splash",
    "loglevel=0"
  ],
  "ltsp_build_scripts_dir": "/etc/ltsp/build-hooks.d",
  "ssh_enabled": true,
  "ssh_port": 2222,
  "ssh_authorized_keys": [
    "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ... admin@server"
  ],
  "usb_redirect_enabled": false,
  "printer_redirect_enabled": true,
  "audio_redirect_enabled": false,
  "serial_redirect_enabled": false,
  "hw_accel_enabled": true,
  "persistence_enabled": true,
  "persistence_root_path": "/var/lib/ltsp/persistence",
  "auto_image_update": true,
  "secure_boot_enabled": true,
  "uefi_bootloader_path": "/usr/lib/shim/shim.efi.signed"
}
