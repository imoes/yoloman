## Configuration file for the GFAL2 Mock Plugin.
##
## This plugin simulates data transfers with configurable delays and signal
## generation to facilitate testing of grid middleware components.
##
## Section header defining the plugin type.
[MOCK PLUGIN]

## Maximum time (in seconds) a transfer is allowed to take in the mock plugin.
## If the simulated transfer takes longer than this, it may be considered failed.
MAX_TRANSFER_TIME={{ max_transfer_time | default(5) }}

## Minimum time (in seconds) a transfer is allowed to take in the mock plugin.
## The mock will delay the transfer to ensure it does not complete faster than this.
MIN_TRANSFER_TIME={{ min_transfer_time | default(5) }}

## Number of signals to simulate during transfer in the mock plugin.
## Non-zero values cause the plugin to send intermediate signals (e.g., for progress tracking).
SIGNALS={{ signals | default(0) }}