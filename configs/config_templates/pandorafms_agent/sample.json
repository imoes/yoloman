{
  "server_ip": "pandora-server.example.com",
  "server_port": 41121,
  "agent_name": "webserver-01",
  "plugin_directory": "/opt/pandora/plugins",
  "temp_directory": "/var/spool/pandora/data_in",
  "interval": 300,
  "debug_mode": false,
  "remote_config": true,
  "modules": [
    {
      "description": "Monitor disk usage",
      "name": "mod_disk",
      "param": "/",
      "interval": 600
    },
    {
      "description": "Check Apache status",
      "name": "mod_apache_status",
      "param": "http://localhost/server-status?auto"
    },
    {
      "description": "CPU load monitoring",
      "name": "mod_cpu"
    }
  ],
  "network_discovery": {
    "enabled": true,
    "network": "10.0.0.0/24",
    "interval": 43200,
    "timeout": 1,
    "threads": 20
  },
  "ssh_scan": {
    "enabled": true,
    "user": "monitoring",
    "key_file": "/var/lib/pandora/.ssh/id_rsa",
    "timeout": 5
  },
  "proxy": {
    "enabled": false
  },
  "ssl": {
    "enabled": true,
    "cert_file": "/etc/pandora/ssl/agent_cert.pem",
    "key_file": "/etc/pandora/ssl/agent_key.pem",
    "ca_file": "/etc/pandora/ssl/ca_chain.pem",
    "verify": true
  },
  "log_file": "/var/log/pandora/webserver-01.log",
  "log_level": "warning"
}
