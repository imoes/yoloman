{
  "server_ip": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address or hostname of the Pandora FMS Server"
  },
  "server_port": {
    "type": "number",
    "default": 41121,
    "description": "Port used to connect to the Pandora FMS Server"
  },
  "agent_name": {
    "type": "string",
    "default": "pandora_agent",
    "description": "Unique name of this agent (used to identify it on the server)"
  },
  "plugin_directory": {
    "type": "string",
    "default": "/var/lib/pandora/plugins",
    "description": "Directory containing custom plugins"
  },
  "temp_directory": {
    "type": "string",
    "default": "/var/spool/pandora/data_in",
    "description": "Directory used for temporary data storage"
  },
  "interval": {
    "type": "number",
    "default": 300,
    "description": "Interval (in seconds) between monitoring cycles"
  },
  "debug_mode": {
    "type": "boolean",
    "default": false,
    "description": "Enable verbose debug logging"
  },
  "remote_config": {
    "type": "boolean",
    "default": false,
    "description": "Allow server-side remote configuration updates"
  },
  "modules": {
    "type": "list",
    "default": [],
    "description": "List of monitoring modules to run",
    "items": {
      "name": {
        "type": "string",
        "description": "Name of the module (must match installed module file)"
      },
      "param": {
        "type": "string",
        "default": "",
        "description": "Optional parameter for the module"
      },
      "description": {
        "type": "string",
        "default": "",
        "description": "Human-readable description (used in comments)"
      },
      "interval": {
        "type": "number",
        "default": null,
        "description": "Override global interval for this module only (in seconds)"
      }
    }
  },
  "network_discovery": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "Enable network discovery for automatic inventory",
    "items": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "network": {
        "type": "string",
        "default": "192.168.1.0/24",
        "description": "Network CIDR to scan (e.g., 192.168.1.0/24)"
      },
      "interval": {
        "type": "number",
        "default": 86400,
        "description": "Interval (in seconds) between scans"
      },
      "timeout": {
        "type": "number",
        "default": 2,
        "description": "Timeout (in seconds) per host"
      },
      "threads": {
        "type": "number",
        "default": 25,
        "description": "Number of concurrent scanning threads"
      }
    }
  },
  "ssh_scan": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "Enable SSH credential-based scanning for inventory",
    "items": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "user": {
        "type": "string",
        "default": "",
        "description": "SSH username for scanning"
      },
      "password": {
        "type": "string",
        "default": "",
        "description": "SSH password (optional; prefer key-based auth)",
        "sensitive": true
      },
      "key_file": {
        "type": "string",
        "default": "",
        "description": "Path to SSH private key file (e.g., /root/.ssh/id_rsa)"
      },
      "timeout": {
        "type": "number",
        "default": 5,
        "description": "SSH connection timeout (in seconds)"
      }
    }
  },
  "proxy": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "HTTP/S proxy for agent-to-server communication",
    "items": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "server": {
        "type": "string",
        "default": "",
        "description": "Proxy server hostname or IP"
      },
      "port": {
        "type": "number",
        "default": 8080,
        "description": "Proxy server port"
      }
    }
  },
  "ssl": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "Secure TLS communication with server",
    "items": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "cert_file": {
        "type": "string",
        "default": "/etc/pandora/agent_cert.pem",
        "description": "Path to agent's X.509 certificate"
      },
      "key_file": {
        "type": "string",
        "default": "/etc/pandora/agent_key.pem",
        "description": "Path to agent's private key"
      },
      "ca_file": {
        "type": "string",
        "default": "/etc/pandora/ca_cert.pem",
        "description": "Path to CA certificate for server verification"
      },
      "verify": {
        "type": "boolean",
        "default": true,
        "description": "Enforce server certificate verification"
      }
    }
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/pandora/pandora_agent.log",
    "description": "Path to agent log file"
  },
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Minimum logging level"
  }
}
