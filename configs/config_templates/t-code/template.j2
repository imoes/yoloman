;;; 50t-code.el --- Debian t-code startup file -*-mode: emacs-lisp;-*-

;;
;; Configuration file for the `t-code' Lisp package.
;; This file is automatically generated by Ansible from the role's schema.
;; It sets up the load path for the t-code Emacs Lisp extensions.
;;

;;; Code:

(let ((lispdir (concat "/usr/share/{{ t_code_flavor | default('t-code') }}" "/site-lisp/t-code")))
  ;; Check if MULE support is available and if the main package file exists.
  (when (and (featurep 'mule) (file-exists-p (concat lispdir "/tc.elc")))
    ;; Use the Debian-specific load-path helper if available (Debian policy compliance).
    (if (fboundp 'debian-pkg-add-load-path-item)
	(debian-pkg-add-load-path-item lispdir)
      ;; Fallback for non-Debian or older Emacs: manually prepend to load-path.
      (setq load-path (cons lispdir load-path)))
    ;;
    ;; Load the setup module for t-code.
    (require 'tc-setup)
    ;;
    ))

;;; 50t-code.el ends here