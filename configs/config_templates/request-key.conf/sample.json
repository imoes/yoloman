{
  "config_rules": [
    {
      "keytype": "user",
      "description_pattern": "*",
      "flags": "-c",
      "action_script": "/usr/sbin/cifscreds",
      "args": [
        "upcall"
      ]
    },
    {
      "keytype": "dns_resolver",
      "description_pattern": "*",
      "flags": "-c",
      "action_script": "/sbin/request-key",
      "args": [
        "@c",
        "dns_resolver"
      ]
    },
    {
      "keytype": "asymmetric",
      "description_pattern": "*",
      "flags": "-c",
      "action_script": "/sbin/request-key",
      "args": [
        "@c",
        "asymmetric"
      ]
    },
    {
      "keytype": "logon",
      "description_pattern": "*",
      "flags": "-c",
      "action_script": "/bin/false",
      "description": "Disable logon key type (common in minimal setups)"
    }
  ]
}
