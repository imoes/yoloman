# /etc/request-key.conf — Global request-key configuration
# Each line defines a key type, description pattern, and an action script
# Format: <keytype> <description> <flags> <program> [args...]
{% for rule in config_rules %}# {{ rule.description | default('No description') }}
{{ rule.keytype }} {{ rule.description_pattern }} {{ rule.flags | default('-c') }} {{ rule.action_script }}{% if rule.args %} {{ rule.args | join(' ') }}{% endif %}
{% endfor %}