{
 "server.bindnow_default": {
  "default": "1",
  "description": "Enable bindnow hardening for the directory server process",
  "type": "string"
 },
 "server.host": {
  "default": "0.0.0.0",
  "description": "Hostname or IP address to bind to",
  "type": "string"
 },
 "server.id": {
  "default": "localhost",
  "description": "Unique identifier for the Directory Server instance",
  "type": "string"
 },
 "server.inst": {
  "default": "dirsrv",
  "description": "Instance directory name",
  "type": "string"
 },
 "server.logging.accesslog": {
  "default": "/var/log/dirsrv/slapd-{{ server.id }}/access",
  "description": "Path to access log file",
  "type": "string"
 },
 "server.logging.auditfaillog": {
  "default": "/var/log/dirsrv/slapd-{{ server.id }}/audit-fail",
  "description": "Path to audit failure log file",
  "type": "string"
 },
 "server.logging.auditlog": {
  "default": "/var/log/dirsrv/slapd-{{ server.id }}/audit",
  "description": "Path to audit log file (successful operations)",
  "type": "string"
 },
 "server.logging.errorlog": {
  "default": "/var/log/dirsrv/slapd-{{ server.id }}/errors",
  "description": "Path to error log file",
  "type": "string"
 },
 "server.logging.loglevel": {
  "default": 0,
  "description": "Logging verbosity level (0-255)",
  "type": "number"
 },
 "server.port": {
  "default": 389,
  "description": "LDAP port number",
  "type": "number"
 },
 "server.replication": {
  "default": null,
  "description": "Replication configuration",
  "type": "object"
 },
 "server.replication.agreements": {
  "default": [],
  "description": "List of replication agreements",
  "type": "list"
 },
 "server.replication.replica_id": {
  "default": 1,
  "description": "Replica ID (1-9999)",
  "type": "number"
 },
 "server.root": {
  "default": "/usr",
  "description": "Top-level directory for the installation",
  "type": "string"
 },
 "server.secure_port": {
  "default": 636,
  "description": "LDAPS port number",
  "type": "number"
 },
 "server.ssl.cacertdir": {
  "default": "/etc/dirsrv/slapd-{{ server.id }}",
  "description": "Directory containing CA certificates for client verification",
  "type": "string"
 },
 "server.ssl.certfile": {
  "default": "/etc/dirsrv/slapd-{{ server.id }}/cert9.db",
  "description": "Path to the server certificate file",
  "type": "string"
 },
 "server.ssl.keyfile": {
  "default": "/etc/dirsrv/slapd-{{ server.id }}/key9.db",
  "description": "Path to the server private key file",
  "type": "string"
 }
}
