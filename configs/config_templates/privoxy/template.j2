# =============================================================================
# Privoxy Default Actions Template
# =============================================================================
#
# This file defines the default filtering rules and actions for Privoxy.
# It is structured to allow variable injection for advanced configurations
# while preserving the standard Privoxy action file syntax.
#
# IMPORTANT: Do not edit this file directly. Use the Ansible role variables
# to customize behavior. Local overrides should be placed in user.action.
# =============================================================================

# =============================================================================
# Version Requirement
# =============================================================================
# Specifies the minimum Privoxy version required for this configuration.
# Privoxy v3.0.11+ is required due to syntax changes in action parsing.
for-privoxy-version=3.0.11

# =============================================================================
# Settings / Advanced Configuration
# =============================================================================
# Allows injection of advanced action settings defined by Ansible variables.
# Common use cases include enabling HTTPS inspection certificates or custom filtering profiles.
# If `settings` is defined, it is rendered here.
{% if settings | default('') %}
{{ settings | default('') }}
{% endif %}

# =============================================================================
# Aliases
# =============================================================================
# Allows injection of custom action aliases defined by Ansible variables.
# Aliases simplify complex action strings.
# If `alias` is defined, it is rendered here.
{% if alias | default('') %}
{{ alias | default('') }}
{% endif %}

# =============================================================================
# Default Aliases (Standard Privoxy)
# =============================================================================
# These aliases save typing for common action combinations.

# Cookie handling aliases
+crunch-all-cookies = +crunch-incoming-cookies +crunch-outgoing-cookies
-crunch-all-cookies = -crunch-incoming-cookies -crunch-outgoing-cookies
allow-all-cookies   = -crunch-all-cookies -session-cookies-only

# Popup handling aliases
allow-popups       = -filter{all-popups} -filter{unsolicited-popups}

# Image blocking aliases
+block-as-image    = +block{Blocked image request.} +handle-as-image
-block-as-image    = -block

# =============================================================================
# Profile Aliases (Standard Privoxy)
# =============================================================================
# These aliases define combinations of actions for specific site types.

# "fragile" profile: Safe for most sites, low privacy protection
fragile = -block -crunch-all-cookies -filter -fast-redirects -hide-referer

# "shop" profile: Allows cookies/popups for shopping carts
shop      = -crunch-all-cookies allow-popups

# "myfilters" profile: Aggressive filtering (example user blend)
myfilters = +filter{html-annoyances} +filter{js-annoyances} +filter{all-popups}\
            +filter{webbugs} +filter{banners-by-size}

# "allow-ads" profile: Permits ads for specific trusted sites
allow-ads   = -block -filter{banners-by-size} -filter{banners-by-link}

# =============================================================================
# Cautious Settings (Safe for all sites)
# =============================================================================
# These settings are safe for all sites but offer little privacy protection.
{ \
+change-x-forwarded-for{block} \
+client-header-tagger{css-requests} \
+client-header-tagger{image-requests} \
+client-header-tagger{range-requests} \
+hide-from-header{block} \
+set-image-blocker{pattern} \
}
standard.Cautious

# =============================================================================
# Medium Settings (Reasonable protection)
# =============================================================================
# Safe for most sites, with a reasonable protection/damage tradeoff.
{ \
+change-x-forwarded-for{block} \
+client-header-tagger{css-requests} \
+client-header-tagger{image-requests} \
+client-header-tagger{range-requests} \
+deanimate-gifs{last} \
+filter{refresh-tags} \
+filter{img-reorder} \
+filter{banners-by-size} \
+filter{webbugs} \
+filter{jumping-windows} \
+filter{ie-exploits} \
+hide-from-header{block} \
+hide-referrer{conditional-block} \
+session-cookies-only \
+set-image-blocker{pattern} \
}
standard.Medium

# =============================================================================
# Advanced Settings (High privacy)
# =============================================================================
# Reasonable privacy protection but require exceptions for trusted sites
# (often due to cookies or SSL). Also serves as a testing ground for new options.
# CAUTION: These settings can be subverted by misconfigured clients.
{ \
+change-x-forwarded-for{block} \
+client-header-tagger{css-requests} \
+client-header-tagger{image-requests} \
+client-header-tagger{range-requests} \
+crunch-if-none-match \
+crunch-outgoing-cookies \
+crunch-incoming-cookies \
+deanimate-gifs{last} \
+fast-redirects{check-decoded-url} \
+filter{html-annoyances} \
+filter{content-cookies} \
+filter{refresh-tags} \
+filter{img-reorder} \
+filter{banners-by-size} \
+filter{banners-by-link} \
+filter{webbugs} \
+filter{jumping-windows} \
+filter{frameset-borders} \
+filter{quicktime-kioskmode} \
+hide-if-modified-since{-60} \
+hide-from-header{block} \
+hide-referrer{conditional-block} \
+limit-connect{,} \
+overwrite-last-modified{randomize} \
+set-image-blocker{pattern} \
}
standard.Advanced

# =============================================================================
# Image Handling Rules
# =============================================================================
# Rules to treat images correctly (disable filtering for image files)

# These belong to images: Enable image handling, disable content filters
{+handle-as-image -filter}
# Match common image extensions
/.*\.(gif|jpe?g|png|bmp|ico)($|\?)

# These don't: Explicitly mark non-images to avoid image-specific actions
{-handle-as-image}
# Match common non-image extensions
/.*\.(js|php|css|.?html?)

# =============================================================================
# Multimedia Exceptions
# =============================================================================
# Some media players (e.g., Firefox) request partial media files.
# Disable filtering and deanimation for these to prevent playback issues.

{-filter -deanimate-gifs}
# Match Ogg video/audio formats
/.*\.og[gv]$

