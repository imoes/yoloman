{
  "listen_address": "127.0.0.1",
  "port": 8118,
  "socks5_host": "localhost",
  "socks5_port": 1080,
  "socks5_local": ".local",
  "socks4a_host": "",
  "socks4a_port": 1080,
  "socks4a_local": "",
  "socks4_host": "",
  "socks4_port": 1080,
  "socks4_local": "",
  "forwards": [
    {
      "scheme": "https:",
      "target": "localhost:3128"
    },
    {
      "scheme": "ftp:",
      "target": "localhost:21"
    }
  ],
  "enable_acl": true,
  "acls": [
    {
      "action": "allow",
      "source": "127.0.0.1"
    },
    {
      "action": "deny",
      "source": "0.0.0.0/0"
    }
  ],
  "filters": [
    {
      "name": "block-google-analytics",
      "pattern": "google-analytics\\.com"
    },
    {
      "name": "strip-tracking-params",
      "pattern": "utm_[a-z]+"
    }
  ],
  "actionsfile_path": "/etc/privoxy/user.action",
  "extra_actionsfiles": [
    {
      "path": "/etc/privoxy/default.action"
    },
    {
      "path": "/etc/privoxy/custom.action"
    }
  ],
  "obfuscate_user_agent": true,
  "remove_server_headers": false,
  "enable_https": true,
  "https_port": 8443,
  "ssl_cert_file": "/etc/ssl/certs/privoxy.crt",
  "ssl_key_file": "/etc/ssl/private/privoxy.key",
  "confdir": "/etc/privoxy",
  "optdir": "/etc/privoxy",
  "template_dir": ""
}
