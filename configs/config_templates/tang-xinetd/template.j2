# xinetd configuration for the Tang encryption key server (tangd)
# Generated from schema: tang-xinetd

service tangd
{
    # The TCP port number for the tangd service.
    port            = {{ port | default('8888') }}

    # Arguments passed to the server, typically the directory for key storage.
    server_args     = {{ server_args | default('/var/lib/tang') }}

    # Path to the tangd executable.
    server          = {{ server | default('/usr/libexec/tangdw') }}

    # The socket type (stream for TCP, dgram for UDP).
    socket_type     = {{ socket_type | default('stream') }}

    # The user account under which the service runs.
    user            = {{ user | default('_tang') }}

    # The group account under which the service runs.
    group           = {{ group | default('_tang') }}

    # Whether xinetd waits for the server process to terminate (yes) or handles multiple connections (no).
    wait            = {{ wait | default('no') }}

    # Flags for logging successful connections.
    log_on_success  += {{ log_on_success | default('USERID') }}

    # Flags for logging failed connections.
    log_on_failure  += {{ log_on_failure | default('USERID') }}

    # Whether the service is disabled (yes) or enabled (no).
    disable         = {{ disable | default('no') }}

    # Service type indicator for xinetd.
    type            = {{ type | default('UNLISTED') }}
}
