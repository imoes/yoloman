# Tang-xinetd logrotate configuration
# Generated from Ansible schema for tang-xinetd

/var/log/{{ log_file | default('tangd.log') }} {
    # Number of days to keep rotated log files.
    rotate {{ log_rotate_count | default(7) }}
    
    # Rotate the log file daily.
    daily
    
    # Do not report an error if the log file is missing.
    missingok
    
    # Create new (replaced) log file after rotating old ones, with specified permissions and owner/group.
    # Octal permissions for the log file.
    create {{ log_file_permissions | default('640') }} _tang _tang
}