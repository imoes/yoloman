# =============================================================================
# QNapi CLI Configuration Template
# =============================================================================
# This template generates a configuration file for QNapi, a Polish subtitles
# downloader CLI tool. It allows setting default languages, output formats,
# and download behavior (console/quiet modes).
# =============================================================================

# -----------------------------------------------------------------------------
# Language Settings
# -----------------------------------------------------------------------------

# Preferred subtitles language code (ISO 639-2/3).
# Corresponds to: -l, --lang [code]
LANG = {{ (qnapi | default({})).lang | default('pol') }}

# Alternative subtitles language code if the primary language is not found.
# Corresponds to: -lb, --lang-backup [code]
LANG_BACKUP = {{ (qnapi | default({})).lang_backup | default('eng') }}

# -----------------------------------------------------------------------------
# Output Format Settings
# -----------------------------------------------------------------------------

# Target subtitles file format (mDVD, MPL2, SRT, TMP).
# Corresponds to: -f, --format [format]
FORMAT = {{ (qnapi | default({})).format | default('SRT') }}

# Target subtitles file extension.
# Corresponds to: -e, --extension [ext]
EXTENSION = {{ (qnapi | default({})).extension | default('.srt') }}

# -----------------------------------------------------------------------------
# Download Mode Settings
# -----------------------------------------------------------------------------

# Enable console mode download.
# Corresponds to: -c, --console
# Note: Boolean values should be True or False as per QNapi's parsing.
CONSOLE = {{ (qnapi | default({})).console | default(true) }}

# Download quietly without messages or windows.
# Corresponds to: -q, --quiet
# Note: If true, implies console mode.
QUIET = {{ (qnapi | default({})).quiet | default(false) }}

# Show list of subtitles (works only with console mode).
# Corresponds to: -s, --show-list
SHOW_LIST = {{ (qnapi | default({})).show_list | default(false) }}

# Do not show list of subtitles (overrides show_list).
# Corresponds to: -d, --dont-show-list
DONT_SHOW_LIST = {{ (qnapi | default({})).dont_show_list | default(false) }}