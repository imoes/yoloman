# Ceph OSD Global Configuration
# This template generates the [global] and [osd.*] sections of Ceph's main configuration file.
# It handles cluster identity, networking, authentication, logging, and per-OSD instance definitions.

[global]

# Unique cluster identifier (UUID). Must be identical across all nodes in the cluster.
fsid = {{ fsid | default('') }}

# List of CIDR notation networks for public (client-facing) communication.
public_network = {{ (public_network | default(['10.0.0.0/24'])) | join(', ') }}

# List of CIDR notation networks for internal cluster traffic (replication, heartbeats).
cluster_network = {{ (cluster_network | default(['192.168.10.0/24'])) | join(', ') }}

# Authentication required for daemon-to-daemon communication (e.g., osd, mon, mds).
auth_cluster_required = {{ auth_cluster_required | default('cephx') }}

# Authentication required for client-to-daemon communication (services like MDS/RBD).
auth_service_required = {{ auth_service_required | default('cephx') }}

# Authentication required for client access to the cluster (e.g., rbd, rgw).
auth_client_required = {{ auth_client_required | default('cephx') }}

# IP addresses or hostnames of monitor nodes. Used during bootstrap if monitors aren't auto-discovered.
mon_host = {{ (mon_host | default(['10.0.0.10', '10.0.0.11', '10.0.0.12'])) | join(', ') }}

# If true, log to stderr (useful when running under systemd). Otherwise logs go to 'log file'.
log to stderr = {{ log_to_stderr | default(false) | ternary('true', 'false') }}

# Path to the main Ceph log file (used when log_to_stderr is false).
log file = {{ log_file | default('/var/log/ceph/ceph.log') }}

# Maximum number of backfill operations per OSD.
osd max backfills = {{ osd_max_backfills | default(1) }}

# Maximum number of true sync (full replica repair) operations per OSD.
osd max truesyncs = {{ osd_max_truesyncs | default(1) }}

# Number of threads for handling client requests per OSD.
osd op threads = {{ osd_op_threads | default(2) }}

# Number of threads for recovery/backfill operations per OSD.
osd recovery op threads = {{ osd_recovery_op_threads | default(1) }}

# Whether to automatically discover devices (e.g., via udev).
osd auto discover = {{ osd_auto_discover | default(true) | ternary('true', 'false') }}

# Size (in MiB) of the journal for filestore OSDs (ignored for bluestore).
osd journal size = {{ osd_journal_size | default(512) }}

{% if osds is defined and osds | length > 0 %}
# Per-OSD section configuration
{% for osd in osds %}
[osd.{{ osd.id | default('unknown') }}]

# Object store type identifier or internal key.
key = {{ osd.key | default('') }}

# Data device path (e.g., /dev/sdb, /dev/nvme0n1).
osd data = {{ osd.data_path | default('') }}

{% if osd.journal_path is defined and osd.journal_path %}
# Optional: journal device path (for filestore only).
osd journal = {{ osd.journal_path }}
{% endif %}

{% if osd.block_path is defined and osd.block_path %}
# Optional: block path for bluestore OSDs.
block = {{ osd.block_path }}
{% endif %}

{% if osd.block_db_path is defined and osd.block_db_path %}
# Optional: block.db path for bluestore OSDs.
block.db = {{ osd.block_db_path }}
{% endif %}

{% if osd.block_wal_path is defined and osd.block_wal_path %}
# Optional: block.wal path for bluestore OSDs.
block.wal = {{ osd.block_wal_path }}
{% endif %}

{% if osd.hostname is defined and osd.hostname %}
# Hostname for topology awareness (optional but recommended).
host = {{ osd.hostname }}
{% endif %}

{% endfor %}
{% endif %}