# Socket to send NMEA location data to
# Path to the Unix domain socket used to send NMEA location data.
socket="{{ socket | default('/var/run/gnss-share.sock') }}"

# Group to set as owner for the socket
# Group to set as owner for the socket.
group="{{ group | default('geoclue') }}"

# GPS device driver to use
# GPS device driver to use. Supported values: stm, stm_serial, mm.
device_driver="{{ device_driver | default('stm') }}"

# Path to GPS device to use
# Path to GPS device to use.
device_path="{{ device_path | default('/dev/gnss0') }}"

# Baud rate for GPS serial device
# Baud rate for GPS serial device.
device_baud_rate={{ device_baud_rate | default(9600) }}

# Directory to load/store almanac and ephemeris data
# Directory to load/store almanac and ephemeris data.
agps_directory="{{ agps_directory | default('/var/cache/gnss-share') }}"