{
  "server": {
    "host": "irc.libera.chat",
    "port": 6697,
    "use_ssl": true,
    "password": "my_secret_password"
  },
  "identity": {
    "username": "dircproxy",
    "nick": "dircproxy_bot",
    "realname": "dircproxy proxy service",
    "usermode": "i"
  },
  "channel": {
    "join_on_connect": true,
    "default_channels": [
      "#linux",
      "#irc"
    ],
    "auto_rejoin": true,
    "rejoin_delay": 5
  },
  "log": {
    "enabled": true,
    "directory": "/var/log/dircproxy",
    "format": "%Y%m%d"
  },
  "buffer": {
    "lines": 500,
    "scrollback_lines": 1000
  },
  "connection": {
    "timeout": 300,
    "reconnect_delay": 10,
    "max_reconnect_attempts": 10
  },
  "dns": {
    "enabled": true,
    "server": ""
  },
  "aliases": {
    "bot": "msg $1 I'm listening!",
    "ping": "msg $1 pong"
  },
  "channel_overrides": [
    {
      "name": "#security",
      "auto_join": false,
      "user_modes": "+v"
    }
  ]
}
