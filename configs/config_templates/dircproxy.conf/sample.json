{
 "aliases": {
  "bot": "msg $1 I'm listening!",
  "ping": "msg $1 pong"
 },
 "buffer": {
  "lines": 500,
  "scrollback_lines": 1000
 },
 "channel": {
  "auto_rejoin": true,
  "default_channels": [
   "#linux",
   "#irc"
  ],
  "join_on_connect": true,
  "rejoin_delay": 5
 },
 "channel_overrides": [
  {
   "auto_join": false,
   "name": "#security",
   "user_modes": "+v"
  }
 ],
 "connection": {
  "max_reconnect_attempts": 10,
  "reconnect_delay": 10,
  "timeout": 300
 },
 "dns": {
  "enabled": true,
  "server": ""
 },
 "identity": {
  "nick": "dircproxy_bot",
  "realname": "dircproxy proxy service",
  "usermode": "i",
  "username": "dircproxy"
 },
 "log": {
  "directory": "/var/log/dircproxy",
  "enabled": true,
  "format": "%Y%m%d"
 },
 "server": {
  "host": "irc.libera.chat",
  "password": "my_secret_password",
  "port": 6697,
  "use_ssl": true
 }
}
