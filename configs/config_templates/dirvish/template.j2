# /etc/cron.d/dirvish: crontab fragment for Dirvish backup automation.
# This file is managed by Ansible. Do not edit manually.

# {# schedule_minute: default=4 | desc=Minute of the hour when the Dirvish backup cron job runs (0-59) #}
# Schedule the backup to run at the specified minute of the hour.
{{ schedule_minute | default('4') }}

# {# schedule_hour: default=22 | desc=Hour of the day (0-23) when the Dirvish backup cron job runs #}
# Schedule the backup to run at the specified hour of the day (24h format).
{{ schedule_hour | default('22') }}

# Day of month, Month, Day of week: run every day, every month, every weekday.
* * *

# User: root is required as dirvish needs elevated privileges for backups.
root

# Command: Execute the main dirvish cronjob script.
/etc/dirvish/dirvish-cronjob