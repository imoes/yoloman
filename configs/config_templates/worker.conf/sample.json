{
  "worker_id": "worker-bullseye-amd64-01",
  "max_jobs": 4,
  "work_dir": "/var/lib/debci",
  "package_cache_dir": "/var/cache/debci/packages",
  "coordinator_url": "https://ci.debian.net",
  "api_token_file": "/etc/debci/worker-token",
  "retry_delay": 15,
  "max_retries": 2,
  "verbose": true,
  "debug": false,
  "supported_architectures": [
    "amd64",
    "arm64"
  ],
  "supported_releases": [
    "bullseye",
    "bookworm"
  ],
  "environment": {
    "TZ": "UTC",
    "DEBEMAIL": "ci@debian.net"
  },
  "job_limits": {
    "cpu_quota": 25000,
    "memory_limit": "1G"
  },
  "job_timeout": 1800,
  "cleanup_enabled": true,
  "cleanup_age_days": 3,
  "pre_test_hook": "/etc/debci/hooks/pre-test",
  "post_test_hook": "/etc/debci/hooks/post-test",
  "lxc_enabled": true,
  "lxc_template": "debian",
  "lxc_distribution": "debian",
  "lxc_release": "bookworm",
  "lxc_architecture": "amd64"
}
