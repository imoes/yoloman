# Amavisd-new SpamAssassin cron jobs
# This template generates the cron entries for amavisd-new's SpamAssassin synchronization and cleaning tasks.
# The 'amavis' user account runs these jobs as specified by the system's cron daemon.

# Schedule for SpamAssassin rule synchronization (sa-sync).
# This job downloads the latest virus/spam signature updates to keep amavisd-new effective.
# cron_minute: Minute of the hour when the sa-sync cron job runs (0-59). Default: 18
# cron_hour:   Hour(s) when the sa-sync cron job runs (e.g., */3 for every 3 hours). Default: */3
{{ cron_minute | default('18') }} {{ cron_hour | default('*/3') }}	* * *	amavis	test -e /usr/sbin/amavisd-new-cronjob && /usr/sbin/amavisd-new-cronjob sa-sync

# Schedule for SpamAssassin bayes database and state cleaning (sa-clean).
# This job removes stale entries from the SpamAssassin Bayesian database and temporary files,
# preventing disk space growth and maintaining performance.
# clean_cron_minute: Minute of the hour when the sa-clean cron job runs (0-59). Default: 24
# clean_cron_hour:   Hour of the day when the sa-clean cron job runs (0-23). Default: 1
{{ clean_cron_minute | default('24') }} {{ clean_cron_hour | default('1') }}	* * *	amavis	test -e /usr/sbin/amavisd-new-cronjob && /usr/sbin/amavisd-new-cronjob sa-clean