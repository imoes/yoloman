# virtualgps configuration template
# This file defines the default GPS coordinates used by the virtualgps simulation.

[default]
# Default latitude coordinate for the virtual GPS simulation.
# Must be a numeric value between -90 and 90.
latitude  = {{ latitude | default(52.13791) }}

# Default longitude coordinate for the virtual GPS simulation.
# Must be a numeric value between -180 and 180.
longitude = {{ longitude | default(21.00704) }}

# Default elevation in meters for the virtual GPS simulation.
# Must be a numeric value.
elevation = {{ elevation | default(100.0) }}