{
  "bot": {
    "type": "object",
    "default": null,
    "description": "Bot identification settings"
  },
  "bot.nickname": {
    "type": "string",
    "default": "iroffer_bot",
    "description": "The nickname the bot uses on IRC."
  },
  "bot.realname": {
    "type": "string",
    "default": "IROFFER DCC File Server",
    "description": "The real name (user info) of the bot."
  },
  "irc": {
    "type": "object",
    "default": null,
    "description": "IRC connection settings"
  },
  "irc.server": {
    "type": "string",
    "default": "irc.libera.chat",
    "description": "Hostname or IP of the IRC server."
  },
  "irc.port": {
    "type": "number",
    "default": 6667,
    "description": "Port number for the IRC connection."
  },
  "irc.ssl": {
    "type": "bool",
    "default": false,
    "description": "Whether to use SSL/TLS for the connection."
  },
  "irc.channels": {
    "type": "list",
    "default": [
      "#iroffer"
    ],
    "description": "List of channels the bot should join."
  },
  "irc.channel_key": {
    "type": "string",
    "default": "",
    "description": "Password for protected channels."
  },
  "irc.server_password": {
    "type": "string",
    "default": "",
    "description": "Password for server authentication (e.g., NickServ)."
  },
  "auth": {
    "type": "object",
    "default": null,
    "description": "Authentication credentials for users."
  },
  "auth.username": {
    "type": "string",
    "default": "user",
    "description": "Username required for DCC access."
  },
  "auth.password": {
    "type": "string",
    "default": "password",
    "description": "Password required for DCC access. Should be encrypted."
  },
  "files": {
    "type": "object",
    "default": null,
    "description": "File serving configuration."
  },
  "files.paths": {
    "type": "list",
    "default": [
      "/srv/iroffer/public"
    ],
    "description": "List of directories to serve files from."
  },
  "files.max_size": {
    "type": "number",
    "default": 1073741824,
    "description": "Maximum file size in bytes to serve (default 1GB)."
  },
  "logging": {
    "type": "object",
    "default": null,
    "description": "Logging configuration."
  },
  "logging.verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose logging output."
  },
  "logging.file": {
    "type": "string",
    "default": "iroffer.log",
    "description": "Path to the log file."
  },
  "daemon": {
    "type": "object",
    "default": null,
    "description": "Daemon/Background process settings."
  },
  "daemon.background": {
    "type": "bool",
    "default": false,
    "description": "Run in background mode."
  },
  "daemon.pidfile": {
    "type": "string",
    "default": "/var/run/iroffer.pid",
    "description": "Path to the PID file."
  },
  "acl": {
    "type": "object",
    "default": null,
    "description": "Access Control List rules."
  },
  "acl.rules": {
    "type": "list",
    "default": [
      "allow *!*@*"
    ],
    "description": "List of ACL rules (e.g., 'allow *!*@example.com')."
  }
}
