{
  "bot": {
    "nickname": "FileBot",
    "realname": "DCC File Server"
  },
  "irc": {
    "server": "irc.oftc.net",
    "port": 6697,
    "ssl": true,
    "channels": [
      "#files"
    ],
    "channel_key": "",
    "server_password": "encrypted_password_hash_here"
  },
  "auth": {
    "username": "admin",
    "password": "encrypted_user_pass_hash_here"
  },
  "files": {
    "paths": [
      "/srv/iroffer/music",
      "/srv/iroffer/videos"
    ],
    "max_size": 5368709120
  },
  "logging": {
    "verbose": true,
    "file": "/var/log/iroffer.log"
  },
  "daemon": {
    "background": false,
    "pidfile": "/run/iroffer.pid"
  },
  "acl": {
    "rules": [
      "allow *!*@*.trusted-network.com",
      "deny *!*@*"
    ]
  }
}
