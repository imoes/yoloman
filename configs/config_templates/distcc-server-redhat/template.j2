# distccd(8) allow list configuration
#
# This file defines which clients are permitted to connect to the distcc
# compiler server. Entries correspond to the --allow (-a) command-line
# option. See the distccd man page for details.
#
# SECURITY WARNING: Any user on an allowed host can potentially execute
# arbitrary commands as the user running the distccd service. Only allow
# trusted hosts. If security is a concern, consider using SSH mode instead
# of TCP mode, though TCP offers better performance.
#
# Format:
#   IP_ADDRESS          - Allows a single host
#   IP_ADDRESS/MASK     - Allows a subnet (CIDR notation)

# Single IP address allowed to connect to distccd.
# Default: 192.168.1.100
{{ allow_ip | default('192.168.1.100') }}

# Network CIDR allowed to connect to distccd.
# Example: 192.168.2.0/8 allows all IPs in the 192.x.x.x range.
# Default: 192.168.2.0/8
{{ allow_network | default('192.168.2.0/8') }}

# Example CIDR mask length shown in comments.
# This variable is primarily for documentation/examples but is available
# if you wish to explicitly define the mask length in other contexts.
# Default: 192.168.0.0/24
{{ allow_network_cidr | default('192.168.0.0/24') }}

# Default commented-out localhost entry for local testing.
# Uncomment this line if you need to compile locally via distccd.
# Default: 127.0.0.1
# {{ allow_ip_default | default('127.0.0.1') }}
