!
! OsmoHLR example configuration
!
log stderr
 logging filter all 1
 logging color 1
 logging print category-hex 0
 logging print category 1
 logging timestamp 0
 logging print file basename last
 logging print level 1
 logging level main {{ log_level_main | default('notice') }}
 logging level db {{ log_level_db | default('notice') }}
 logging level auc {{ log_level_auc | default('notice') }}
 logging level ss {{ log_level_ss | default('notice') }}
 logging level linp {{ log_level_linp | default('error') }}
!
line vty
 bind {{ bind_vty_ip | default('127.0.0.1') }}
ctrl
 bind {{ bind_ctrl_ip | default('127.0.0.1') }}
hlr
 gsup
  bind ip {{ bind_gsup_ip | default('127.0.0.1') }}
 ussd route prefix *#100# internal own-msisdn
 ussd route prefix *#101# internal own-imsi
 ps
  pdp-profiles default
   profile 1
    apn {{ apn_1 | default('internet') }}
   profile 2
    apn {{ apn_2 | default('*') }}
