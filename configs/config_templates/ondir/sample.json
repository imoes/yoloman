{
  "umask_default": "077",
  "rules": [
    {
      "name": "public_html_umask_change",
      "entries": [
        {
          "type": "enter",
          "path": "/home/user/public_html",
          "final": true,
          "body": "umask 022"
        },
        {
          "type": "leave",
          "path": "/home/user/public_html",
          "final": true,
          "body": "umask 077"
        }
      ]
    },
    {
      "name": "project_path_addition",
      "entries": [
        {
          "type": "enter",
          "path": "/home/user/projects/myproject",
          "final": false,
          "body": "PATH=$PATH:$CWD/bin"
        },
        {
          "type": "leave",
          "path": "/home/user/projects/myproject",
          "final": false,
          "body": "PATH=`echo $PATH | sed -e \"s,:$CWD/bin,,g\"`"
        }
      ]
    }
  ]
}
