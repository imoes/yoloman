{
  "ovs_logdir": {
    "type": "string",
    "default": "/var/log/openvswitch-vtep",
    "description": "Log directory for openvswitch-vtep"
  },
  "ovs_rundir": {
    "type": "string",
    "default": "/run/openvswitch-vtep",
    "description": "Runtime directory for openvswitch-vtep"
  },
  "ovs_pkgdatadir": {
    "type": "string",
    "default": "/usr/share/openvswitch",
    "description": "Package data directory containing OVSSchemas"
  },
  "ovs_dbdir": {
    "type": "string",
    "default": "/etc/openvswitch-vtep",
    "description": "Configuration and database directory for openvswitch-vtep"
  }
}
