#!/bin/sh

# Short-Description: Open vSwitch VTEP emulator
# Description:       Initializes the Open vSwitch VTEP emulator
#
# This script configures and starts the Open vSwitch VTEP (Virtual Tunnel End Point)
# emulator. It sets up environment variables pointing to critical directories for
# logs, runtime state, package data, and the database configuration.
#
# Variables are sourced from the Ansible role defaults or user overrides.
# If any variable is undefined, the schema default is applied automatically.

# Log directory for openvswitch-vtep
# Default: /var/log/openvswitch-vtep
export OVS_LOGDIR="{{ ovs_logdir | default('/var/log/openvswitch-vtep') }}"

# Runtime directory for openvswitch-vtep
# Default: /run/openvswitch-vtep
export OVS_RUNDIR="{{ ovs_rundir | default('/run/openvswitch-vtep') }}"

# Package data directory containing OVSSchemas
# Default: /usr/share/openvswitch
export OVS_PKGDATADIR="{{ ovs_pkgdatadir | default('/usr/share/openvswitch') }}"

# Configuration and database directory for openvswitch-vtep
# Default: /etc/openvswitch-vtep
export OVS_DBDIR="{{ ovs_dbdir | default('/etc/openvswitch-vtep') }}"

# Local alias for the database directory to simplify script logic
etcdir="{{ ovs_dbdir | default('/etc/openvswitch-vtep') }}"

. /usr/share/openvswitch/scripts/ovs-lib

start () {
    # Check if ovs-vswitchd is already running in this namespace
    ovs-dpctl dump-dps 2>&1 | grep ovs-system > /dev/null
    rc=$?
    if [ $rc -eq 0 ]; then
        cat << EOF >&2
An already running copy of ovs-vswitchd detected in current namespace.

Running multiple instances of ovs-vswitchd in the same namespace is not
supported.
EOF
        exit 1
    fi

    # Create the logical switch database if it does not exist
    # Uses the schema from OVS_PKGDATADIR
    if [ ! -e "$etcdir/conf.db" ]; then
        ovsdb-tool create $etcdir/conf.db $OVS_PKGDATADIR/vswitch.ovsschema
    fi

    # Create the VTEP database if it does not exist
    # Uses the schema from OVS_PKGDATADIR
    if [ ! -e "$etcdir/vtep.db" ]; then
        ovsdb-tool create $etcdir/vtep.db $OVS_PKGDATADIR/vtep.ovsschema
    fi

    # Generate client certificates if they do not exist
    # Ensures secure communication between components
    if [ ! -e "$etcdir/ovsclient-cert.pem" ]; then
        export RANDFILE="/root/.rnd"
        cd $etcdir && ovs-pki req ovsclient && ovs-pki self-sign ovsclient
    fi

    # Ensure the runtime directory exists with correct permissions
    if [ ! -d $OVS_RUNDIR ]; then
        install -d -m 755 -o root -g root $OVS_RUNDIR
    fi

    # Start the OVSDB server
    # Listens on a Unix socket for local communication
    # Manages the logical switch and VTEP databases
    ovsdb-server --pidfile --detach --log-file --remote \
        unix:$OVS_RUNDIR/db.sock \
        --remote=db:hardware_vtep,Global,managers \
        --private-key=$etcdir/ovsclient-privkey.pem \
        --certificate=$etcdir/ovsclient-cert.pem \
        --bootstrap-ca-cert=$etcdir/vswitchd.cacert \
        $etcdir/conf.db $etcdir/vtep.db

    # Load the Open vSwitch kernel module
    modprobe openvswitch

    # Start the vswitchd daemon
    # Connects to the OVSDB server via the Unix socket
    ovs-vswitchd --pidfile --detach --log-file \
        unix:$OVS_RUNDIR/db.sock
}

stop () {
    stop_daemon ovs-vswitchd
    stop_daemon ovsdb-server
}

case $1 in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|force-reload)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload}" >&2
        exit 1
        ;;
esac

exit 0
