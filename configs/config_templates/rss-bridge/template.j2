; ==============================================================================
; RSS-Bridge Configuration Template
; ==============================================================================
; This file contains host-specific overrides for RSS-Bridge.
; It is self-documenting: every setting explains its purpose and default value.
; Variables are sourced from Ansible facts or playbook variables.
; ==============================================================================

[cache]

; Allow users to specify custom timeout for specific requests.
; true  = enabled
; false = disabled (default)
; Schema Default: false
custom_timeout = {{ rss_bridge_cache_custom_timeout | default('false') }}

[proxy]

; Sets the proxy url (i.e. "tcp://192.168.0.0:32").
; Empty string means proxy is disabled.
; Schema Default: (empty)
url = "{{ rss_bridge_proxy_url | default('') }}"

; Sets the proxy name that is shown on the bridge interface instead of the raw proxy url.
; This provides a user-friendly label for the proxy configuration.
; Schema Default: Hidden proxy name
name = "{{ rss_bridge_proxy_name | default('Hidden proxy name') }}"

; Allow users to disable proxy usage for specific requests/bridges.
; true  = enabled (users can opt-out of proxy per request)
; false = disabled (proxy is forced if URL is set)
; Schema Default: false
by_bridge = {{ rss_bridge_proxy_by_bridge | default('false') }}

[authentication]

; Enables basic authentication for all requests to this RSS-Bridge instance.
; Warning: You'll have to upgrade existing feeds after enabling this option!
; true  = enabled
; false = disabled (default)
; Schema Default: false
enable = {{ rss_bridge_auth_enable | default('false') }}

; The username for authentication. Insert this name when prompted for login.
; Must be set along with rss_bridge_auth_password when enable=true.
; Schema Default: (empty)
username = "{{ rss_bridge_auth_username | default('') }}"

; The password for authentication. Insert this password when prompted for login.
; Use a strong password to prevent others from guessing your login!
; Schema Default: (empty)
password = "{{ rss_bridge_auth_password | default('') }}"
