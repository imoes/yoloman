# Configuration for the delay(1) command-line utility
# This file controls the behavior of the `delay` command.

# buffer_size: Maximum buffer size in bytes; supports k/M/G suffixes (e.g., '10m' for 10 MB)
# This parameter defines the maximum amount of data the delay command will buffer before processing.
# If left empty or unset, it defaults to '0' (no buffering limit specified).
buffer_size: {{ (buffer_size | default('0')) | string }}

# delay_time: Delay duration; supports s/m/h suffixes (e.g., '5s' for 5 seconds)
# This parameter sets the delay duration.
# If left empty or unset, it defaults to '0' (immediate execution).
delay_time: {{ (delay_time | default('0')) | string }}