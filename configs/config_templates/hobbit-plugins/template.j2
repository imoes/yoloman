# This file is sourced by /sbin/dphys-config and used by the dphys-init script.
# It sets configuration variables for the disk management.

# MOUNT_POINTS is a list of mount points that shall be monitored.
# If this is empty, no automatic handling is done.
# Example: MOUNT_POINTS="/tmp /var/log"
# Default: ['/tmp', '/var/log']
MOUNT_POINTS="{{ mount_points | default(['/tmp', '/var/log']) | join(' ') }}"

# MOUNT_OPT is a list of mount options for the tmpfs mounts.
# Example: MOUNT_OPT="mode=1777,nosuid,nodev,noexec,noatime"
# Default: 'mode=1777,nosuid,nodev,noexec,noatime'
MOUNT_OPT="{{ mount_opt | default('mode=1777,nosuid,nodev,noexec,noatime') }}"

# RAMFS_SIZE is the size of the tmpfs mounts in Megabytes.
# If 0, it defaults to 50% of RAM.
# Example: RAMFS_SIZE=512
# Default: 0
RAMFS_SIZE="{{ ramfs_size | default(0) }}"

# RAMFS_LIMIT is the maximum size of files in the tmpfs mounts in Megabytes.
# If 0, there is no limit.
# Example: RAMFS_LIMIT=1024
# Default: 0
RAMFS_LIMIT="{{ ramfs_limit | default(0) }}"

# CONF_SWAPSIZE is the size of the swap file in Megabytes.
# If 0, no swap file is created/adjusted.
# Example: CONF_SWAPSIZE=512
# Default: 0
CONF_SWAPSIZE="{{ conf_swapsize | default(0) }}"

# CONF_SWAPFILE is the path of the swap file.
# Example: CONF_SWAPFILE=/var/cache/swap/swapfile
# Default: '/var/cache/swap/swapfile'
CONF_SWAPFILE="{{ conf_swapfile | default('/var/cache/swap/swapfile') }}"

# CONF_MAXSWAP is the maximum size of the swap file in Megabytes.
# If 0, there is no limit.
# Example: CONF_MAXSWAP=2048
# Default: 0
CONF_MAXSWAP="{{ conf_maxswap | default(0) }}"
