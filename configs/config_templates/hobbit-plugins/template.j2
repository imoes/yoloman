# dphys-config
#
# Configuration file for dphys-swapfile
#
# This template is self-documenting. Each variable is defined with its
# schema default and a descriptive comment derived from the role's schema.
#

# Directory where to store swap files
# Default: /var/swap
# (must be on a filesystem that supports sparse files)
# Jinja2 expression: {{ CONF_SWAPFILE | default('/var/swap') }}
CONF_SWAPFILE={{ CONF_SWAPFILE | default('/var/swap') }}

# Max size of the swap file in MB
# Default: 100
# 0 means: use a default calculation based on RAM size
# Jinja2 expression: {{ CONF_SWAPSIZE | default(100) }}
CONF_SWAPSIZE={{ CONF_SWAPSIZE | default(100) }}

# If you want to keep swapfiles even when not enabled, set this to yes
# Default: False (rendered as 'no' in config)
# Jinja2 expression: {{ 'yes' if CONF_SWAP_KEEP | default(False) else 'no' }}
CONF_SWAP_KEEP={{ 'yes' if CONF_SWAP_KEEP | default(False) else 'no' }}

# Path to the disk check utility
# Default: /usr/bin/disk-check
# Jinja2 expression: {{ DISKCHECK | default('/usr/bin/disk-check') }}
DISKCHECK={{ DISKCHECK | default('/usr/bin/disk-check') }}