# =============================================================================
# incus-agent Configuration Template
# =============================================================================
# This template generates the effective configuration for the incus-agent daemon.
# incus-agent is a lightweight agent that facilitates communication between
# Incus containers/virtual machines and the Incus server.
#
# Most operational settings for incus-agent are controlled via command-line
# flags (--debug, --verbose, etc.). This configuration file reflects the
# effective state derived from those flags for logging and audit purposes.
#
# Variables:
#   debug (bool): Enables debug logging. Defaults to False.
#   verbose (bool): Enables verbose (info-level) logging. Defaults to False.
# =============================================================================

# -----------------------------------------------------------------------------
# Global Logging Flags
# -----------------------------------------------------------------------------
# Debug mode: enables verbose debug logging (--debug flag)
# When enabled, the agent outputs detailed debug information to stderr/logs.
DEBUG: {{ debug | default(false) | lower }}

# Verbose mode: enables informational message logging (--verbose flag)
# When enabled, the agent outputs standard informational messages.
VERBOSE: {{ verbose | default(false) | lower }}

# -----------------------------------------------------------------------------
# Effective Configuration Summary
# -----------------------------------------------------------------------------
# The following section mirrors the active flags. incus-agent primarily uses
# these flags for runtime behavior; this file serves as a persistent record
# of the active configuration state.

Effective Debug: {{ debug | default(false) | lower }}
Effective Verbose: {{ verbose | default(false) | lower }}