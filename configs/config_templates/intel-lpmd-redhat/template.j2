<?xml version="1.0"?>
<!--
    Specifies the configuration data
    for Intel Energy Optimizer (LPMD) daemon
    This template configures the Intel Low Power Mode Daemon (LPMD).
    Variables must be provided via Ansible inventory or role defaults.
-->

<Configuration>
    <!--
        CPU format example: 1,2,4..6,8-10
        Specifies which CPUs are eligible for Low Power Mode.
        If empty, the daemon may apply default logic or all CPUs depending on version.
    -->
    <lp_mode_cpus>{{ lp_mode_cpus | default('') }}</lp_mode_cpus>

    <!--
        Mode values:
        0: Cgroup v2
        1: Cgroup v2 isolate
        2: CPU idle injection
        Sets the operational mode for the LPMD daemon.
    -->
    <Mode>{{ mode | default('0') }}</Mode>

    <!--
        Default behavior when Performance power setting is used:
        -1: force off (Never enter Low Power Mode)
         1: force on (Always stay in Low Power Mode)
         0: auto (opportunistic Low Power Mode enter/exit)
    -->
    <PerformanceDef>{{ performance_def | default('-1') }}</PerformanceDef>

    <!--
        Default behavior when Balanced power setting is used:
        -1: force off (Never enter Low Power Mode)
         1: force on (Always stay in Low Power Mode)
         0: auto (opportunistic Low Power Mode enter/exit)
    -->
    <BalancedDef>{{ balanced_def | default('-1') }}</BalancedDef>

    <!--
        Default behavior when Power saver setting is used:
        -1: force off (Never enter Low Power Mode)
         1: force on (Always stay in Low Power Mode)
         0: auto (opportunistic Low Power Mode enter/exit)
    -->
    <PowersaverDef>{{ powersaver_def | default('-1') }}</PowersaverDef>

    <!--
        Use HFI LPM hints:
        0: No
        1: Yes
        Enables or disables Low Power Mode hints from Hardware Feedback Interface (HFI).
    -->
    <HfiLpmEnable>{{ hfi_lpm_enable | default('0') }}</HfiLpmEnable>

    <!--
        Use HFI SUV hints:
        0: No
        1: Yes
        Enables or disables SUV (Speed-Up Value) hints from Hardware Feedback Interface (HFI).
    -->
    <HfiSuvEnable>{{ hfi_suv_enable | default('0') }}</HfiSuvEnable>

    <!--
        System utilization threshold to enter LP mode from 0 - 100.
        Clear both util_entry_threshold and util_exit_threshold to disable util monitor.
    -->
    <util_entry_threshold>{{ util_entry_threshold | default('10') }}</util_entry_threshold>

    <!--
        System utilization threshold to exit LP mode from 0 - 100.
        Clear both util_entry_threshold and util_exit_threshold to disable util monitor.
    -->
    <util_exit_threshold>{{ util_exit_threshold | default('95') }}</util_exit_threshold>

    <!--
        Entry delay. Minimum delay in non Low Power mode to enter LPM mode.
        Value is in milliseconds.
    -->
    <EntryDelayMS>{{ entry_delay_ms | default('0') }}</EntryDelayMS>

    <!--
        Exit delay. Minimum delay in Low Power mode to exit LPM mode.
        Value is in milliseconds.
    -->
    <ExitDelayMS>{{ exit_delay_ms | default('0') }}</ExitDelayMS>

    <!--
        Lowest hysteresis average in-LP-mode time in msec to enter LP mode.
        0: to disable hysteresis support.
        Prevents rapid toggling of LP mode based on transient load spikes.
    -->
    <EntryHystMS>{{ entry_hyst_ms | default('0') }}</EntryHystMS>

    <!--
        Lowest hysteresis average out-of-LP-mode time in msec to exit LP mode.
        0: to disable hysteresis support.
        Prevents rapid toggling of LP mode based on transient load drops.
    -->
    <ExitHystMS>{{ exit_hyst_ms | default('0') }}</ExitHystMS>

    <!--
        Ignore ITMT setting during LP-mode enter/exit:
        0: disable ITMT upon LP-mode enter and re-enable ITMT upon LP-mode exit
        1: do not touch ITMT (Intel Thread-Mesher and Slicer) setting during LP-mode enter/exit
    -->
    <IgnoreITMT>{{ ignore_itmt | default('0') }}</IgnoreITMT>

</Configuration>
