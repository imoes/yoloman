# ==============================================================================
# ClamAssassin Configuration Template
# ==============================================================================
# This template generates the configuration file for ClamAssassin, a perl-based
# wrapper for ClamAV used primarily with spamassassin to perform virus scanning
# on e-mail messages.
#
# All variables are sourced from the Ansible role defaults or host/group vars.
# Each setting is self-documented below with its schema description and default.
# ==============================================================================

# ------------------------------------------------------------------------------
# Subject header prefix to prepend to subject lines.
# Must include trailing space if desired; empty string disables subject rewriting.
# ------------------------------------------------------------------------------
{% if SUBJECTHEAD is defined and SUBJECTHEAD is not none and (SUBJECTHEAD is number or SUBJECTHEAD is boolean or SUBJECTHEAD | length > 0) %}SUBJECTHEAD="{{ SUBJECTHEAD | default('') }}"{% else %}#SUBJECTHEAD=""{% endif %}

# ------------------------------------------------------------------------------
# Full path to clamscan or clamdscan binary.
# ------------------------------------------------------------------------------
{% if CLAMSCAN is defined and CLAMSCAN is not none and (CLAMSCAN is number or CLAMSCAN is boolean or CLAMSCAN | length > 0) %}CLAMSCAN="{{ CLAMSCAN | default('clamscan') }}"{% else %}#CLAMSCAN=clamscan{% endif %}

# ------------------------------------------------------------------------------
# Command-line options passed to the clamscanner binary.
# ------------------------------------------------------------------------------
{% if CLAMSCANOPT is defined and CLAMSCANOPT is not none and (CLAMSCANOPT is number or CLAMSCANOPT is boolean or CLAMSCANOPT | length > 0) %}CLAMSCANOPT="{{ CLAMSCANOPT | default('--no-summary --stdout') }}"{% else %}#CLAMSCANOPT="--no-summary --stdout"{% endif %}

# ------------------------------------------------------------------------------
# Whether to add scanner name/version to the X-Virus-Scanned header.
# ------------------------------------------------------------------------------
{% if ADDSCANNERFLAG is defined and ADDSCANNERFLAG is not none and (ADDSCANNERFLAG is number or ADDSCANNERFLAG is boolean or ADDSCANNERFLAG | length > 0) %}ADDSCANNERFLAG="{{ ADDSCANNERFLAG | default(True) | lower }}"{% else %}#ADDSCANNERFLAG=1{% endif %}

# ------------------------------------------------------------------------------
# Whether to add virus signature version to the X-Virus-Signature header.
# Default: off for ClamAV >= 0.80, otherwise on.
# ------------------------------------------------------------------------------
{% if SIGVERSFLAG is defined and SIGVERSFLAG is not none and (SIGVERSFLAG is number or SIGVERSFLAG is boolean or SIGVERSFLAG | length > 0) %}SIGVERSFLAG="{{ SIGVERSFLAG | default(False) | lower }}"{% else %}#SIGVERSFLAG=0{% endif %}
