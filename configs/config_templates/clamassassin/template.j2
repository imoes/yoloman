# ==============================================================================
# ClamAssassin Configuration Template
# ==============================================================================
# This template generates the configuration file for ClamAssassin, a perl-based
# wrapper for ClamAV used primarily with spamassassin to perform virus scanning
# on e-mail messages.
#
# All variables are sourced from the Ansible role defaults or host/group vars.
# Each setting is self-documented below with its schema description and default.
# ==============================================================================

# ------------------------------------------------------------------------------
# Subject header prefix to prepend to subject lines.
# Must include trailing space if desired; empty string disables subject rewriting.
# ------------------------------------------------------------------------------
SUBJECTHEAD="{{ SUBJECTHEAD | default('') }}"

# ------------------------------------------------------------------------------
# Full path to clamscan or clamdscan binary.
# ------------------------------------------------------------------------------
CLAMSCAN="{{ CLAMSCAN | default('clamscan') }}"

# ------------------------------------------------------------------------------
# Command-line options passed to the clamscanner binary.
# ------------------------------------------------------------------------------
CLAMSCANOPT="{{ CLAMSCANOPT | default('--no-summary --stdout') }}"

# ------------------------------------------------------------------------------
# Whether to add scanner name/version to the X-Virus-Scanned header.
# ------------------------------------------------------------------------------
ADDSCANNERFLAG="{{ ADDSCANNERFLAG | default(True) }}"

# ------------------------------------------------------------------------------
# Whether to add virus signature version to the X-Virus-Signature header.
# Default: off for ClamAV >= 0.80, otherwise on.
# ------------------------------------------------------------------------------
SIGVERSFLAG="{{ SIGVERSFLAG | default(False) }}"