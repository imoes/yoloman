# Defaults for cfengine3 initscript
# Sourced by /etc/init.d/cfengine3
# Installed at /etc/default/cfengine3 by maintainer scripts
#
# This file is a POSIX shell fragment. Variables here are consumed
# by the SysV/init script to determine which CFEngine daemons to start
# and what command-line arguments to pass to them.
#
# Daemons:
#   cfmonitord — Configuration monitoring daemon
#   cfservd    — Policy server daemon
#   cfexecd    — Policy execution daemon
#

# ---------------------------------------------------------------------------
# Daemon Control
# Set to 1 to start the daemon; 0 otherwise.
# ---------------------------------------------------------------------------

# cfmonitord: monitors configuration changes.
# Variable: RUN_CFMONITORD
# Default: 0 (do not start)
RUN_CFMONITORD={{ run_cfmonitord | default(0) }}

# cfservrd (cfservd): the policy server that distributes policies.
# Variable: RUN_CFSERVERD
# Default: 0 (do not start)
RUN_CFSERVERD={{ run_cfservrd | default(0) }}

# cfexecd: executes promised actions on the agent.
# Variable: RUN_CFEXECD
# Default: 0 (do not start)
RUN_CFEXECD={{ run_cfexecd | default(0) }}

# ---------------------------------------------------------------------------
# Daemon Arguments
# Additional command-line options passed to the respective daemons.
# These are typically used for debugging, logging, or custom paths.
# ---------------------------------------------------------------------------

# Arguments for cfmonitord.
# Variable: CFMONITORD_ARGS
# Default: '' (empty — no extra options)
CFMONITORD_ARGS="{{ cfmonitord_args | default('') }}"

# Arguments for cfservrd (cfservd).
# Variable: CFSERVERD_ARGS
# Default: '' (empty — no extra options)
CFSERVERD_ARGS="{{ cfserverd_args | default('') }}"

# Arguments for cfexecd.
# Variable: CFEXECD_ARGS
# Default: '' (empty — no extra options)
CFEXECD_ARGS="{{ cfexecd_args | default('') }}"