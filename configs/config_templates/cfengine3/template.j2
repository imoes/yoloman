# Defaults for cfengine initscript
# sourced by /etc/init.d/cfengine3
# installed at /etc/default/cfengine3 by the maintainer scripts

# This file is a POSIX shell fragment.
# It controls which Cfengine daemons are started by the init script.
# Each daemon requires a valid promises.cf in /var/lib/cfengine3/inputs/ to function correctly.

# -------------------------------------------------------------------------
# Daemon Control Flags
# -------------------------------------------------------------------------

# Set to 1 to start the cfmonitord daemon; 0 otherwise.
# cfmonitord monitors the system state and triggers updates if changes are detected.
RUN_CFMONITORD={{ run_cfmonitord | default('0') }}

# Set to 1 to start the cfservrd daemon; 0 otherwise.
# cfservrd is the server daemon that accepts incoming connections from clients (cfservd).
# In a typical Cfengine setup, this is the central hub.
RUN_CFSERVERD={{ run_cfservrd | default('0') }}

# Set to 1 to start the cfexecd daemon; 0 otherwise.
# cfexecd is the execution agent that runs the policies (promises.cf) on a schedule.
# It connects to the policy server (cfservrd) to download and apply policies.
RUN_CFEXECD={{ run_cfexecd | default('0') }}

# -------------------------------------------------------------------------
# Daemon Arguments
# -------------------------------------------------------------------------

# Additional command-line options passed to cfmonitord.
# Example: '--verbose --log --no-fork'
# Note: Cfengine daemons may require specific flags to operate in a containerized or chroot environment.
CFMONITORD_ARGS="{{ cfmonitord_args | default('') }}"

# Additional command-line options passed to cfservrd (the server daemon).
# Example: '--log --verbose'
# These options override or supplement the default server configuration.
CFSERVERD_ARGS="{{ cfserverd_args | default('') }}"

# Additional command-line options passed to cfexecd (the executor daemon).
# Example: '--verbose --no-fork'
# Useful for debugging or controlling the execution frequency and logging level.
CFEXECD_ARGS="{{ cfexecd_args | default('') }}"
