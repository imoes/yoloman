# Caja package file list for RHEL/CentOS.
# This list ensures the package manager tracks the main binary,
# its extensions library, and associated utility scripts.

# The main Caja file manager executable.
# Source: caja_bind_dir (default: /usr/bin)
-b {{ caja_bindir | default('/usr/bin') }}/caja

# Utility to handle autorun configuration for software/media.
# Source: caja_bindir (default: /usr/bin)
-b {{ caja_bindir | default('/usr/bin') }}/caja-autorun-software

# Utility to configure server connection protocols (SMB, FTP, etc.).
# Source: caja_bindir (default: /usr/bin)
-b {{ caja_bindir | default('/usr/bin') }}/caja-connect-server

# GUI properties dialog for file management settings.
# Source: caja_bindir (default: /usr/bin)
-b {{ caja_bindir | default('/usr/bin') }}/caja-file-management-properties

# The shared library containing Caja extension logic.
# Source: caja_lib_dir (default: /usr/lib64)
-b {{ caja_lib_dir | default('/usr/lib64') }}/libcaja-extension.so.*

# Helper binary for converting metadata formats.
# Source: caja_libexec_dir (default: /usr/libexec)
-b {{ caja_libexec_dir | default('/usr/libexec') }}/caja-convert-metadata
