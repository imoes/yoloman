{
  "version_check": {
    "type": "string",
    "default": "off",
    "description": "Whether to perform version checks",
    "enum": [
      "on",
      "off"
    ]
  },
  "block_size": {
    "type": "number",
    "default": 0,
    "description": "Block size for compression (0 = auto)"
  },
  "exclude_algo": {
    "type": "number",
    "default": 0,
    "description": "Algorithm ID to exclude (0 = none)"
  },
  "use_urls": {
    "type": "string",
    "default": "on",
    "description": "Whether to enable URL-based features",
    "enum": [
      "on",
      "off"
    ]
  },
  "color_ui": {
    "type": "string",
    "default": "off",
    "description": "Whether to enable colored UI output",
    "enum": [
      "on",
      "off"
    ]
  },
  "network_access": {
    "type": "string",
    "default": "on",
    "description": "Whether network access is permitted",
    "enum": [
      "on",
      "off"
    ]
  },
  "binary_check": {
    "type": "string",
    "default": "off",
    "description": "Whether to perform binary format checks",
    "enum": [
      "on",
      "off"
    ]
  },
  "module_load_all": {
    "type": "string",
    "default": "off",
    "description": "Whether to load all modules automatically",
    "enum": [
      "on",
      "off"
    ]
  }
}
