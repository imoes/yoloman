# -----------------------------------------------------------------------------
# Package: dact
# -----------------------------------------------------------------------------
# Self-documented Jinja2 configuration template for 'dact'.
# Each directive is preceded by its schema description.
# Variables use the 'default' filter to ensure safe rendering even when
# the corresponding variable is undefined in the Ansible playbook.
# -----------------------------------------------------------------------------

# version_check: default='off'
# Desc: Whether to perform version checks
version_check    {{ version_check | default('off') }}

# block_size: default=0
# Desc: Block size for compression (0 = auto)
# Note: If the target application requires a numeric value without spaces,
# ensure the default is emitted as a bare integer.
{% if block_size is defined and block_size is not none and (block_size is number or block_size is boolean or block_size | length > 0) %}block_size       {{ block_size | default(0) }}{% else %}#block_size      0{% endif %}

# exclude_algo: default=0
# Desc: Algorithm ID to exclude (0 = none)
{% if exclude_algo is defined and exclude_algo is not none and (exclude_algo is number or exclude_algo is boolean or exclude_algo | length > 0) %}exclude_algo     {{ exclude_algo | default(0) }}{% else %}#exclude_algo    0{% endif %}

# use_urls: default='on'
# Desc: Whether to enable URL-based features
use_urls         {{ use_urls | default('on') }}

# color_ui: default='off'
# Desc: Whether to enable colored UI output
color_ui         {{ color_ui | default('off') }}

# network_access: default='on'
# Desc: Whether network access is permitted
network_access   {{ network_access | default('on') }}

# binary_check: default='off'
# Desc: Whether to perform binary format checks
binary_check     {{ binary_check | default('off') }}

# module_load_all: default='off'
# Desc: Whether to load all modules automatically
module_load_all  {{ module_load_all | default('off') }}
