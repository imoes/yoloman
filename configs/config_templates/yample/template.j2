# Yample configuration file
# See yample(1) for documentation

# Base directory for mail storage (prepended to destinations)
# Default: /home/yample/Maildir/
mailbase={{ mailbase | default('/home/yample/Maildir') }}

# Path to the logfile
# Default: /home/yample/.yample/log
logfile={{ logfile | default('/home/yample/.yample/log') }}

# Loglevel (0-4)
# 4 - Debug, 3 - info, 2 - warnings, 1 - errors, 0 - nothing
# Default: 2
loglevel={{ loglevel | default(2) }}

# Load Mail::Spamassassin and run the mail through it
# Default: false
spamassassin={{ spamassassin | default(false) | lower }}

# Run the message through spamc instead of loading the module
# Default: false
spamc={{ spamc | default(false) | lower }}

# Path to spamc executable (only used if spamc is true)
# Default: '' (empty, relies on PATH)
spamc_path={{ spamc_path | default('') }}

# Path to the message id database for duplicate suppression
# Default: /home/yample/.yample/dupdb
dubdb={{ dubdb | default('/home/yample/.yample/dupdb') }}