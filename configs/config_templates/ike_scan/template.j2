# ike-scan configuration for IPsec VPN server discovery and fingerprinting
# Scan targets: single host, CIDR subnet, or file of hosts (one per line)
# Use --desthost to specify target(s); supports wildcards and ranges
# Use --interface to bind to a specific network interface
# Use --timeout and --retries to tune response handling
# Use --transid to set transaction ID (for testing or bypassing simple filters)
# Use --vendor to enable vendor string extraction and fingerprinting
# Use --verbose for detailed output (includes all IKE proposals, transforms)
# Use --nats to detect NAT-T (IKE NAT traversal)
# Use --options to specify additional command-line options as a space-separated string

{% for target in scan_targets %}# Target: {{ target }}
{% endfor %}
# Interface: {{ interface }}
# Timeout (ms): {{ timeout_ms }}
# Retries: {{ retries }}
# Transaction ID (hex, 8 chars): {{ transid | default('00000000') }}
# Enable vendor fingerprinting: {{ vendor_fingerprint | string | lower }}
# Enable NAT-T detection: {{ nat_t_detection | string | lower }}
# Verbose output: {{ verbose | string | lower }}
# Extra CLI options: {{ extra_options | default('') | trim | replace('\n', ' ') }}