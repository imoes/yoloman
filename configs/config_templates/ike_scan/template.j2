# =============================================================================
# ike-scan Configuration Template
# =============================================================================
# This template generates a configuration file for ike-scan, a tool used for
# discovering and fingerprinting IPsec VPN servers.
#
# Generated by Ansible Jinja2 engine.
# All variables are provided with safe defaults to prevent render failures.
# =============================================================================

# Scan targets: List of IP addresses, CIDR subnets, or hostnames to scan.
# Supports wildcards (e.g., 192.168.*.*) and ranges (e.g., 10.0.0.1-10.0.0.5).
# One target per line in the output file.
# Corresponds to multiple --desthost arguments or input file entries.
{% for target in scan_targets | default(['192.168.1.0/24']) %}
# Target: {{ target }}
{% endfor %}

# Network interface to bind to (e.g., eth0, enp3s0).
# If empty, ike-scan uses the default route interface.
# Corresponds to --interface flag.
# Interface: {{ interface | default('') }}

# Per-packet timeout in milliseconds before retransmitting.
# Corresponds to --timeout flag.
# Timeout (ms): {{ timeout_ms | default(1000) }}

# Number of times to retransmit a packet if no response received.
# Corresponds to --retries flag.
# Retries: {{ retries | default(3) }}

# Transaction ID (8-hex-char string) for IKE Main Mode exchanges.
# Useful for testing or evading simple stateless filters.
# Corresponds to --transid flag.
# Transaction ID (hex, 8 chars): {{ transid | default('00000000') }}

# Enable vendor fingerprinting by extracting and comparing vendor IDs
# in IKE responses against a local database.
# Corresponds to --vendor flag.
# Enable vendor fingerprinting: {{ vendor_fingerprint | default(True) | string | lower }}

# Enable verbose output to display detailed IKE proposals, transforms,
# and payload contents.
# Corresponds to --verbose flag.
# Verbose output: {{ verbose | default(True) | string | lower }}

# Additional ike-scan CLI options as a single space-separated string.
# Example: '--quiet --plainpsk --p1unit'
# Corresponds to passing extra arguments directly to the binary.
# Extra CLI options: {{ extra_options | default('') | trim | replace('\n', ' ') }}