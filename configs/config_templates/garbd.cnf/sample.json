{
  "vgroup": "garbd",
  "vaddress": "gcomm://",
  "vlib_path": "/usr/lib64/galera-4/libgalera.so",
  "cluster_name": "my_wsrep_cluster",
  "ssl_enabled": true,
  "ssl_ca_path": "/etc/mysql/ssl/ca.pem",
  "ssl_cert_path": "/etc/mysql/ssl/client-cert.pem",
  "ssl_key_path": "/etc/mysql/ssl/client-key.pem",
  "log_level": 2,
  "log_file": "/var/log/garbd.log",
  "recovery_timeout": 45,
  "bootstrap": false
}
