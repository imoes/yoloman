{
  "defaults": {
    "html_dir": "/var/cache/munin/www",
    "lib_dir": "/var/lib/munin",
    "log_dir": "/var/log/munin",
    "run_dir": "/var/run/munin",
    "user": "munin",
    "group": "munin",
    "interval": 5,
    "html_strategy": "static",
    "rrd_strategy": "daily"
  },
  "contact_groups": {
    "alerts": {
      "command": "mail -s 'Munin alert' root",
      "contacts": []
    }
  }
}
