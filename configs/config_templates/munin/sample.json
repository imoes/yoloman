{
  "defaults": {
    "html_dir": "/var/cache/munin/www",
    "lib_dir": "/var/lib/munin",
    "log_dir": "/var/log/munin",
    "run_dir": "/var/run/munin",
    "user": "munin",
    "group": "munin",
    "interval": 5,
    "html_strategy": "static",
    "rrd_strategy": "daily"
  },
  "contact_groups": {
    "alerts": {
      "command": "curl -X POST -H 'Content-type: application/json' --data '{\"text\":\"Munin alert: {{contact}}: {{message}}\"}' https://hooks.slack.com/services/XXX/YYY/ZZZ",
      "contacts": [
        {
          "name": "ops_slack",
          "value": "ops-channel"
        }
      ]
    }
  },
  "nodes": [
    {
      "name": "web1",
      "address": "10.0.1.10",
      "port": 4949,
      "group": "webservers",
      "use_node_name": "yes",
      "labels": {
        "env": "prod",
        "location": "us-east-1"
      }
    },
    {
      "name": "web2",
      "address": "10.0.1.11",
      "port": 4949,
      "group": "webservers",
      "use_node_name": "yes"
    },
    {
      "name": "db1",
      "address": "10.0.2.10",
      "port": 4949,
      "group": "databases",
      "use_node_name": "yes",
      "labels": {
        "role": "primary"
      }
    }
  ],
  "node_groups": [
    {
      "name": "webservers",
      "nodes": [
        "web1",
        "web2"
      ]
    },
    {
      "name": "databases",
      "nodes": [
        "db1"
      ]
    }
  ]
}
