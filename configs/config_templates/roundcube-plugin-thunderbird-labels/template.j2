<?php
// =============================================================================
// Roundcube Plugin: Thunderbird Labels (thunderbird_labels)
// =============================================================================
// This plugin allows Roundcube to recognize and sync labels created in
// Mozilla Thunderbird. It does NOT configure the mail backend, database,
// or web server itself. It is a configuration snippet for a PHP plugin.
// =============================================================================

// -----------------------------------------------------------------------------
// Plugin: Enable or disable the thunderbird_labels plugin.
// If set to false, the plugin is ignored even if listed in 'plugins'.
// -----------------------------------------------------------------------------
$config['plugin']['thunderbird_labels'] = array(
    // 'enabled' is implicitly true if this array exists and is non-empty in
    // many Roundcube setups, but explicit is better.
    'enabled' => true,

    // -------------------------------------------------------------------------
    // Label Prefix: Thunderbird often uses a specific namespace prefix for
    // custom labels to avoid conflicts with standard IMAP flags.
    // If your Thunderbird profile uses a custom prefix, set it here.
    // Default is usually no prefix or a specific one defined by the plugin.
    // -------------------------------------------------------------------------
    // 'prefix' => 'THUNDERBIRD_',

    // -------------------------------------------------------------------------
    // Sync Direction: Whether to push Roundcube label changes to the IMAP
    // server or just read them. Usually 'both' or 'readonly'.
    // -------------------------------------------------------------------------
    // 'sync' => 'both',
);

// Note: To enable this plugin, ensure 'thunderbird_labels' is included in
// the global $config['plugins'] array in your main Roundcube config:
// $config['plugins'] = array('...', 'thunderbird_labels');
?>