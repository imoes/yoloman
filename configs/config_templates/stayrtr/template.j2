# stayrtr (RTR Server for RPKI) configuration template
#
# This file generates command-line arguments for the stayrtr binary.
# Refer to 'man stayrtr' or 'stayrtr -h' for detailed option descriptions.

# The network address and port for the RTR server to bind to.
# Defaults to ':323' if not specified.
STAYRTR_ARGS=-bind {{ bind_address | default(':323') }} -cache {{ cache_dir | default('/var/lib/rpki-client/json') }}