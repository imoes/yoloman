# Listen address (IP or hostname) for incoming connections
listen_addresses = '{{ listen_addresses }}'

# Port number for PostgreSQL
port = {{ port }}

# Maximum number of concurrent connections
max_connections = {{ max_connections }}

# Shared memory buffer size for PostgreSQL
shared_buffers = '{{ shared_buffers }}'

# WAL buffer size
wal_buffers = '{{ wal_buffers }}'

# Checkpoint completion target (0.1–1.0)
checkpoint_completion_target = {{ checkpoint_completion_target }}

# Size of each WAL segment (typically 16MB, adjust only if necessary)
wal_segment_size = '{{ wal_segment_size }}'

# Logging collector: enable log collection
logging_collector = {{ logging_collector | lower }}

# Directory for log files (must exist and be writable by postgres user)
log_directory = '{{ log_directory }}'

# Log filename pattern (supports % placeholders like %Y, %m, %d)
log_filename = '{{ log_filename }}'

# Minimum log level to record
log_min_messages = '{{ log_min_messages }}'

# Minimum statement duration to log (ms)
log_min_duration_statement = {{ log_min_duration_statement }}

# Timezone for log timestamps
log_timezone = '{{ log_timezone }}'

# Default database encoding
lc_messages = '{{ lc_messages }}'
lc_monetary = '{{ lc_monetary }}'
lc_numeric = '{{ lc_numeric }}'
lc_time = '{{ lc_time }}'

# Default text search configuration
default_text_search_config = '{{ default_text_search_config }}'

{% if extra_settings %}
# Additional custom settings
{% for key, value in extra_settings.items() %}{{ key }} = '{{ value }}'
{% endfor %}{% endif %}

# Authentication method definitions (pg_hba.conf is separate, not templated here)
# (This config only covers postgresql.conf; pg_hba.conf must be managed separately)
