[DEFAULT]
# Logging configuration
log_file = {{ log_file }}
log_dir = {{ log_dir }}
use_syslog = {{ use_syslog }}
syslog_log_facility = {{ syslog_log_facility }}

# Logging level
log_level = {{ log_level }}

# RPC / messaging backend
transport_url = {{ transport_url }}

# Authentication
auth_url = {{ auth_url }}
project_domain_name = {{ project_domain_name }}
project_name = {{ project_name }}
user_domain_name = {{ user_domain_name }}
username = {{ username }}
password = {{ password }}

# Monitoring interval and behavior
segment_heartbeat_interval = {{ segment_heartbeat_interval }}
notification_driver = {{ notification_driver }}

# Host and instance monitoring
host_monitor_enabled = {{ host_monitor_enabled }}
instance_monitor_enabled = {{ instance_monitor_enabled }}
instance_monitor_retry_interval = {{ instance_monitor_retry_interval }}
instance_monitor_max_retries = {{ instance_monitor_max_retries }}

# Recovery behavior
auto_recover = {{ auto_recover }}
recover_method = {{ recover_method }}
notification_endpoint = {{ notification_endpoint }}

# Health check endpoint (optional)
# Health check endpoint for instance monitoring
# health_check_uri = {{ health_check_uri }}

{% for host in hosts %}
[{{ host.name }}]
# Host-specific monitoring configuration for: {{ host.name }}
host = {{ host.name }}
enabled = {{ host.enabled }}
segment_id = {{ host.segment_id }}
monitoring_uri = {{ host.monitoring_uri }}
{% endfor %}
