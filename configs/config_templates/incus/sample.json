{
  "listen_addr": "0.0.0.0:8443",
  "socket_path": "/var/lib/incus/incus.sock",
  "remote_api_enabled": true,
  "metrics_enabled": true,
  "metrics_interval": 60,
  "trust_password": "",
  "storage_backend": "zfs",
  "storage_pool": "incus",
  "storage_dir": "/var/lib/incus/storage",
  "logging_level": "info",
  "logging_format": "text",
  "log_path": "/var/log/incus/daemon.log",
  "max_instances": 50,
  "instance_limits": [
    {
      "type": "cpu",
      "name": "max-cpus",
      "value": "8"
    },
    {
      "type": "memory",
      "name": "max-memory",
      "value": "8GiB"
    }
  ],
  "image_aliases": [
    {
      "name": "ubuntu-lts",
      "target": "images:ubuntu/22.04"
    },
    {
      "name": "debian-bookworm",
      "target": "images:debian/bookworm"
    }
  ],
  "allowed_image_protocols": [
    "https"
  ],
  "allowed_storage_backends": [
    "zfs",
    "dir"
  ],
  "allowed_image_servers": [
    {
      "name": "LXC Images",
      "url": "https://images.linuxcontainers.org"
    }
  ],
  "features": {
    "network_zones": {
      "enabled": true
    },
    "storage_buckets": {
      "enabled": false
    }
  },
  "cluster_server": "",
  "cluster_role": "",
  "cluster_certificate": "",
  "cluster_key": "",
  "default_profiles": [
    "default",
    "nested"
  ]
}
