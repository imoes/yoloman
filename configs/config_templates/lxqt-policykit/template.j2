# LXQt PolicyKit Desktop Entry Template
# This template generates a .desktop file for the LXQt PolicyKit agent.
# It is used by LXQt to handle authentication requests via PolicyKit.

# Desktop Entry Standard Specification
[Desktop Entry]

# Type: Fixed value. This indicates the entry is an application launcher.
Type=Application

# TryExec: Path to the executable binary to verify before launching.
# The desktop environment checks if this path exists and is executable.
# If it doesn't, this entry is hidden/disabled.
# Default: 'lxqt-policykit-agent'
TryExec={{ try_exec | default('lxqt-policykit-agent') }}

# Exec: The command to execute when the user launches this application.
# In this context, it launches the LXQt PolicyKit authentication agent.
# Default: 'lxqt-policykit-agent'
Exec={{ exec | default('lxqt-policykit-agent') }}

# OnlyShowIn: Defines which desktop environments this entry should be visible in.
# Semicolon-separated list of desktop environment names.
# Default: 'LXQt;' ensures it primarily shows in LXQt sessions.
OnlyShowIn={{ only_show_in | default('LXQt;') }}

# X-LXQt-Module: LXQt-specific flag indicating this is an internal LXQt module.
# True means it is managed/integrated within the LXQt environment.
# Default: True
X-LXQt-Module={{ x_lxqt_module | default(true) }}

# Display Name
# The canonical name of the application.
Name=PolicyKit Handler

