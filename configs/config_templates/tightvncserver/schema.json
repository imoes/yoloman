{
  "geometry": {
    "type": "string",
    "default": "1024x768",
    "description": "Desktop geometry in WIDTHxHEIGHT format"
  },
  "depth": {
    "type": "number",
    "default": 24,
    "description": "Color depth in bits per pixel"
  },
  "desktop_name": {
    "type": "string",
    "default": "X",
    "description": "X desktop name"
  },
  "vnc_classes": {
    "type": "string",
    "default": "/usr/local/vnc/classes",
    "description": "Directory containing the Java viewer applet"
  },
  "vnc_user_dir": {
    "type": "string",
    "default": "$ENV{HOME}/.vnc",
    "description": "User-specific directory for TightVNC files"
  },
  "font_path": {
    "type": "string",
    "default": "unix/:7100",
    "description": "X font path configuration"
  },
  "color_path": {
    "type": "string",
    "default": "/usr/lib/X11/rgb",
    "description": "Optional path to X colors database"
  }
}
