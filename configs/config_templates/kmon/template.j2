# ==============================================================================
# kmon (Kernel Monitor) Configuration Template
# ==============================================================================
# This template configures the kmon terminal UI. It accepts boolean flags for
# optional features and scalar values for appearance and performance tuning.
# All variables use schema defaults to ensure safe rendering in Ansible.
# ==============================================================================

# --------------------------------------------------------------------------
# accent_color: Set the accent color using hex code or standard color name.
# Example: 'white', '#FF0000'
# --------------------------------------------------------------------------
--accent-color={{ accent_color | default('white') }}

# --------------------------------------------------------------------------
# color: Set the main color using hex code or standard color name.
# Example: 'darkgray', '#333333'
# --------------------------------------------------------------------------
--color={{ color | default('darkgray') }}

# --------------------------------------------------------------------------
# tickrate: Set the refresh rate of the terminal in milliseconds.
# Lower values = faster updates but higher CPU usage.
# --------------------------------------------------------------------------
--tickrate={{ tickrate | default(250) }}

# --------------------------------------------------------------------------
# reverse: Reverse the order of the kernel module list.
# When true, appends the '--reverse' flag to the config.
# --------------------------------------------------------------------------
{% if reverse | default(false) %}--reverse{% endif %}

# --------------------------------------------------------------------------
# unicode: Enable Unicode symbols for block titles.
# When true, appends the '--unicode' flag to the config.
# --------------------------------------------------------------------------
{% if unicode | default(false) %}--unicode{% endif %}