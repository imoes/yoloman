#!/bin/sh
# krb5-config wrapper script configuration
# Generated by Jinja2 engine
#
# This script configures the Heimdal krb5-config wrapper by setting
# installation prefixes, library selection, and output flags.
# It acts as a thin wrapper around the actual heimdal-krb5-config binary.

# The installation prefix directory for Heimdal libraries.
# Used for the --prefix option.
# Schema default: '/usr/local'
PREFIX='{{ prefix | default("/usr/local") }}'

# The execution prefix directory for Heimdal binaries/libraries.
# Used for the --exec-prefix option.
# Schema default: '/usr/local/bin'
EXEC_PREFIX='{{ exec_prefix | default("/usr/local/bin") }}'

# List of Heimdal libraries to request flags for.
# Supported values: krb5, gssapi, kadm-client, kadm-server.
# Joined by spaces for the command line.
# Schema default: ['krb5']
LIBS='{{ libs | default(["krb5"]) | join(" ") }}'

# If true, output C compiler flags (--cflags).
# Schema default: True
CFLAGS='{{ cflags | default("true") }}'

# If true, output linker library flags (--libs).
# Schema default: True
LINK_LIBS='{{ link_libs | default("true") }}'

# Main configuration logic: invoke the underlying heimdal-krb5-config binary.
# Passes the configured prefix, exec_prefix, and optionally cflags/libs.
# The variables ${PREFIX} and ${EXEC_PREFIX} are shell variables set above.
exec /usr/bin/heimdal-krb5-config \
    --prefix="${PREFIX}" \
    --exec-prefix="${EXEC_PREFIX}" \
    {% if cflags | default(true) %}--cflags{% endif %} \
    {% if link_libs | default(true) %}--libs{% endif %} \
    {{ libs | default(["krb5"]) | join(" ") }}