{
  "enable_config": true,
  "compile_commands_dir": "/home/user/myproject/build",
  "query_driver": [
    "/usr/bin/clang-*",
    "/usr/bin/clang++-*",
    "/usr/bin/gcc-*",
    "/usr/bin/g++-*"
  ],
  "background_index": true,
  "background_index_persist": "CacheDirectory",
  "background_index_priority": "low",
  "clang_tidy": true,
  "all_scopes_completion": true,
  "completion_style": "detailed",
  "function_arg_placeholders": true,
  "header_insertion": "iwyu",
  "header_insertion_decorators": true,
  "import_insertions": true,
  "limit_references": 0,
  "limit_results": 0,
  "rename_file_limit": 100,
  "path_mappings": [
    "/home/user/project=/workspace/project",
    "/opt/include=/home/user/include"
  ],
  "remote_index_address": "localhost:50051",
  "log": "info",
  "offset_encoding": "utf-8",
  "j": 8,
  "malloc_trim": true,
  "pch_storage": "disk",
  "experimental_modules_support": false,
  "fallback_style": "Google",
  "project_root": "/home/user/project"
}
