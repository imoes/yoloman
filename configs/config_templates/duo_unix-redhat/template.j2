[duo]
; Duo integration key used to identify this application with the Duo service.
; Default is an empty string, which is invalid and will cause authentication failure.
ikey = {{ ikey | default('') }}

; Duo secret key (HMAC secret) used to sign requests. Must be kept confidential.
; Default is an empty string, which is invalid.
skey = {{ skey | default('') }}

; The Duo API host (e.g., api-12345.duosecurity.com).
; Default is an empty string, which is invalid.
host = {{ host | default('') }}

; Controls behavior when Duo servers are unreachable or errors occur.
; 'safe': Allows login to proceed without 2FA if Duo is unavailable.
; 'secure': Denies login if Duo is unavailable, potentially locking out users.
; Default is 'safe'.
failmode = {{ failmode | default('safe') }}
