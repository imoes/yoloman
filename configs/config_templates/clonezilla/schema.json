{
  "ocsmgrd_port": {
    "type": "string",
    "default": "6461",
    "description": "Port for OCS Manager (clonezilla server)"
  },
  "vol_limit_default": {
    "type": "string",
    "default": "0",
    "description": "Default image split volume size (MB). 0 means no splitting."
  },
  "vol_limit_in_interactive": {
    "type": "string",
    "default": "0",
    "description": "Image split volume size in interactive mode (MB). 0 means no splitting."
  },
  "split_suf_len": {
    "type": "string",
    "default": "2",
    "description": "Suffix length for split image files (e.g., 2 => aa, ab, ...). Must be >= 2."
  },
  "multicast_all_addr": {
    "type": "string",
    "default": "224.0.0.1",
    "description": "Multicast control address for client/server discovery"
  },
  "multicast_port": {
    "type": "string",
    "default": "2232",
    "description": "Multicast port"
  },
  "time_to_live_opt": {
    "type": "string",
    "default": "--ttl 1",
    "description": "Multicast TTL option"
  },
  "udp_sender_extra_opt_default": {
    "type": "string",
    "default": "",
    "description": "Extra options for udp-sender"
  },
  "udp_receiver_extra_opt_default": {
    "type": "string",
    "default": "",
    "description": "Extra options for udp-receiver"
  },
  "part_prepare_time": {
    "type": "string",
    "default": "30",
    "description": "Wait time before next partition starts (seconds)"
  },
  "sleep_time_after_part_cloned": {
    "type": "string",
    "default": "15",
    "description": "Sleep time after partition cloning (seconds)"
  },
  "time_to_wait_default": {
    "type": "string",
    "default": "120",
    "description": "Default wait time (seconds)"
  },
  "max_time_to_wait_default": {
    "type": "string",
    "default": "300",
    "description": "Maximum wait time (seconds)"
  },
  "bt_port_init": {
    "type": "string",
    "default": "6969",
    "description": "BitTorrent tracker port"
  },
  "metainfo_creator_def": {
    "type": "string",
    "default": "ezio-ptcl",
    "description": "Default tool for creating torrent metainfo files",
    "enum": [
      "ezio-ptcl",
      "mktorrent",
      "ctorrent",
      "transmission-create"
    ]
  },
  "p_length_ctorrent": {
    "type": "string",
    "default": "16777216",
    "description": "Piece length for ctorrent (bytes)"
  },
  "p_length_mktorrent": {
    "type": "string",
    "default": "24",
    "description": "Piece length exponent for mktorrent (2^N bytes)"
  },
  "p_length_transmission": {
    "type": "string",
    "default": "16384",
    "description": "Piece length for transmission-create (KB)"
  },
  "bt_client_def": {
    "type": "string",
    "default": "ezio",
    "description": "Default BitTorrent client",
    "enum": [
      "ezio",
      "ctorrent",
      "aria2c",
      "lftp",
      "btdownloadheadless"
    ]
  },
  "ctorrent_extra_opt": {
    "type": "string",
    "default": "-M 4 -m 4",
    "description": "Extra options for ctorrent"
  },
  "aria2c_extra_opt": {
    "type": "string",
    "default": "--bt-max-peers 4",
    "description": "Extra options for aria2c"
  },
  "partclone_make_slice_opt": {
    "type": "string",
    "default": "extract",
    "description": "Method to create slices for ezio",
    "enum": [
      "extract",
      "fusecopy",
      "fusemount"
    ]
  },
  "bt_buffer_size": {
    "type": "string",
    "default": "16777216",
    "description": "Buffer size for partclone (bytes)"
  },
  "partclone_dd_bs": {
    "type": "string",
    "default": "16777216",
    "description": "Block size for partclone.dd (bytes)"
  },
  "dd_buffer_size": {
    "type": "string",
    "default": "1048576",
    "description": "Buffer size for dd (bytes)"
  },
  "default_partimage_save_opt": {
    "type": "string",
    "default": "-M -f3 -o -d -b -c -z0 --volume=0",
    "description": "Default partimage save options"
  },
  "default_partimage_restore_opt": {
    "type": "string",
    "default": "-M -f3 -b",
    "description": "Default partimage restore options"
  }
}
