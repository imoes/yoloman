{#
  guider configuration template
  ============================
  Self-documenting Jinja2 template for the 'guider' system monitor/profiler.
  Every setting is commented with its schema description and carries a safe default.
#}

[guider]
# Log verbosity level (debug, info, warn, error)
log_level = {{ log_level | default('info') }}

# Path to the guider log file
log_file = {{ log_file | default('/var/log/guider.log') }}

[monitoring]
# Interval in seconds between resource monitoring samples
interval = {{ monitoring_interval | default(5) }}

# Enable or disable continuous resource monitoring
enabled = {{ monitoring_enabled | default(true) }}

[profiling]
# Enable or disable CPU/memory profiling
enabled = {{ profiling_enabled | default(false) }}

# Directory to store profiling output files
output_dir = {{ profiling_output_dir | default('/tmp/guider-profiles') }}

[tracing]
# Enable or disable system call/function tracing
enabled = {{ tracing_enabled | default(false) }}

# Timeout in seconds for tracing operations
trace_timeout = {{ tracing_timeout | default(30) }}

[visualization]
# HTTP port for the visualization web interface
web_port = {{ visualization_port | default(9090) }}

# Bind address for the visualization web interface
web_host = {{ visualization_host | default('127.0.0.1') }}

[control]
# Path to the Unix domain socket for control commands
control_socket_path = {{ control_socket_path | default('/run/guider/control.sock') }}

[logging]
# Maximum size in MB of each log file before rotation
max_size_mb = {{ logging_max_size_mb | default(100) }}

# Maximum number of rotated log files to retain
max_files = {{ logging_max_files | default(5) }}

[networking]
# Network address to bind for networked features
listen_address = {{ networking_listen_address | default('0.0.0.0') }}

# Network port to bind for networked features
listen_port = {{ networking_listen_port | default(8080) }}

[testing]
# Enable testing mode (disables some safety checks)
enabled = {{ testing_enabled | default(false) }}

[utilities]
# Directory for utility output data and state files
output_dir = {{ utilities_output_dir | default('/var/lib/guider') }}