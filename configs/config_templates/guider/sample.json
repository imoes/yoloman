{
  "log_level": "warn",
  "log_file": "/var/log/guider/system.log",
  "monitoring_interval": 10,
  "monitoring_enabled": true,
  "profiling_enabled": true,
  "profiling_output_dir": "/var/log/guider/profiles",
  "tracing_enabled": true,
  "tracing_timeout": 60,
  "visualization_port": 9999,
  "visualization_host": "0.0.0.0",
  "control_socket_path": "/run/guider/control.sock",
  "logging_max_size_mb": 50,
  "logging_max_files": 10,
  "networking_listen_address": "192.168.1.100",
  "networking_listen_port": 8080,
  "testing_enabled": false,
  "utilities_output_dir": "/var/lib/guider"
}
