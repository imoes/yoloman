{
  "log_dir": "/var/log/squid",
  "report_dir": "/var/lib/lightsquid/report",
  "base_url": "http://proxy.example.com/lightsquid",
  "timezone": "America/New_York",
  "lang": "en",
  "user_detail": true,
  "url_detail": false,
  "ext_detail": false,
  "user_bandwidth": true,
  "site_bandwidth": false,
  "time_report": true,
  "max_days": 60,
  "log_format": "squid",
  "custom_log_format": "",
  "access_log_path": "/var/log/squid/access.log*",
  "ignore_errors": true,
  "db_timeout": 30,
  "syslog": false,
  "db_type": "sqlite",
  "db_path": "/var/lib/lightsquid/lightsquid.db",
  "db_host": "localhost",
  "db_port": 3306,
  "db_name": "lightsquid",
  "db_user": "lightsquid",
  "db_password": "secret123",
  "web_enable": false,
  "web_bind_ip": "127.0.0.1",
  "web_port": 8080,
  "web_root": "/usr/share/lightsquid",
  "web_auth_enabled": false,
  "web_htpasswd_file": "/etc/lightsquid/htpasswd",
  "plugins": [
    "top_user",
    "top_site"
  ],
  "plugins_config": [
    {
      "name": "top_user",
      "options": {
        "max_users": 20,
        "sort_by": "bytes"
      }
    },
    {
      "name": "top_site",
      "options": {
        "max_sites": 30,
        "sort_by": "hits",
        "exclude_internal": "true"
      }
    }
  ]
}
