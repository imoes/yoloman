{
  "device": "/dev/sr0",
  "speed": 4000,
  "buffer_size": 16,
  "force_overwrite": false,
  "volume_label": "BACKUP_2024",
  "use_joliet": true,
  "use_rock_ridge": true,
  "multisession": false,
  "sources": [
    "/home/user/backups/data",
    "/home/user/backups/scripts",
    "/etc/cdw/cdw.conf"
  ],
  "iso_output": "/tmp/backup_2024.iso",
  "mode": "disk-at-once",
  "pre_gap": 0,
  "audio_mode": false,
  "eject": true,
  "log_level": "normal"
}
