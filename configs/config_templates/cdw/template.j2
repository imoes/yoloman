# Device used for CD burning (device path, e.g., /dev/sr0)
device = {{ device }}

# Default write speed (0 = auto, otherwise integer in KB/s × 1000, e.g., 4000 for ~4x)
speed = {{ speed }}

# Maximum buffer size in MB (prevents underflow; typical: 8–32)
buffer_size = {{ buffer_size }}

# Overwrite existing files in ISO image without prompt (true/false)
force_overwrite = {{ force_overwrite | lower }}

# ISO9660 volume label (up to 32 chars); default: CDROM
volume_label = {{ volume_label }}

# Joliet extension support (true/false)
use_joliet = {{ use_joliet | lower }}

# Rock Ridge extension support (true/false)
use_rock_ridge = {{ use_rock_ridge | lower }}

# Enable multisession support (true/false)
multisession = {{ multisession | lower }}

# Paths of data directories/files to include in ISO image
{% for item in sources %}source = {{ item }}
{% endfor %}

# Output ISO image path (if empty, burn directly without creating image)
{% if iso_output %}output_iso = {{ iso_output }}
{% endif %}

# Burn mode: 'disk-at-once' (DAO) or 'track-at-once' (TAO)
mode = {{ mode }}

# Pre-gap length in frames (only for audio mode; 0–150)
pre_gap = {{ pre_gap }}

# Enable audio mode (true = burn audio CD, false = data CD)
audio_mode = {{ audio_mode | lower }}

# Eject CD after successful burn (true/false)
eject = {{ eject | lower }}

# Log level: quiet, normal, verbose, debug
log_level = {{ log_level }}
