{#
  openstack-debian-images-build-farm configuration template
  This file drives the automated image build service scripts.
  All variables are sourced from the Ansible role's variables/defaults.
  Defaults are applied inline to ensure the template is idempotent and safe.
#}

# ==========================================================================
# Daily Automation
# ==========================================================================

# Enable daily image updates. If not 'yes', the script exits without doing anything.
# Valid values: 'yes' or 'no' (default: no)
DAILY_IMAGE_UPDATES={{ DAILY_IMAGE_UPDATES | default('no') }}

# ==========================================================================
# Mirror Configuration
# ==========================================================================

# URL of your mirror. Note this URL also be used in sources.list of the images.
# Must be a valid HTTP/HTTPS URL.
DEB_MIRROR={{ DEB_MIRROR | default('http://deb.debian.org/debian') }}

# Address of the debian-security mirror.
# Must be a valid HTTP/HTTPS URL.
SECURITY_MIRROR={{ SECURITY_MIRROR | default('http://security.debian.org/debian-security') }}

# ==========================================================================
# Release Selection
# ==========================================================================

# List Debian releases to build.
# Comma-separated list of codenames (e.g., stretch,buster,bullseye,bookworm,unstable).
RELEASE_LIST={{ RELEASE_LIST | default('stretch,buster,bullseye,bookworm,unstable') }}

# List of Debian rescue image to build.
# Comma-separated list of codenames (e.g., stretch,buster,bullseye,bookworm,sid).
RESCUE_LIST={{ RESCUE_LIST | default('stretch,buster,bullseye,bookworm,sid') }}

# ==========================================================================
# OpenStack Component Images
# ==========================================================================

# Should we also generate images for Octavia? List here images using the
# format:
#   <debian-release>-<openstack-release>
#
# If <openstack-release> is ommited, the OpenStack release shipped with
# Debian is used. Otherwise, extrepo is installed, and use to setup the
# OpenStack unofficial backport repository, with <openstack-release> as the
# OpenStack release name.
# Default: buster-train,buster-ussuri,bullseye,bullseye-wallaby
OCTAVIA_IMAGES={{ OCTAVIA_IMAGES | default('buster-train,buster-ussuri,bullseye,bullseye-wallaby') }}

# Should we also generate images for Manila? List here the image using
# the format:
#   <debian-release>
# Default: bullseye
MANILA_IMAGES={{ MANILA_IMAGES | default('bullseye') }}

# ==========================================================================
# Output Configuration
# ==========================================================================

# Where should we generate images?
# Path to the web-accessible directory where images are stored.
IMAGE_DEST={{ IMAGE_DEST | default('/var/www/html/openstack-debian-images') }}
