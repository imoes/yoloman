# Fcitx Configuration Template
# This template configures the Fcitx Input Method Framework.
# It sets the global XIM compatibility settings and IM module names for GTK/Qt applications.

# Name of the X Input Method to use
XIM={{ XIM | default('fcitx') }}

# Path to the XIM server executable
XIM_PROGRAM={{ XIM_PROGRAM | default('/usr/bin/fcitx') }}

# Additional arguments for the XIM server
# Note: Quotes are included in the default to ensure valid shell syntax if passed directly.
XIM_ARGS={{ XIM_ARGS | default('""') }}

# IM module for GTK applications
GTK_IM_MODULE={{ GTK_IM_MODULE | default('fcitx') }}

# IM module for Qt applications
QT_IM_MODULE={{ QT_IM_MODULE | default('fcitx') }}

# Package dependency declaration
# This field is informational for role dependencies; not a runtime config directive for fcitx itself.
DEPENDS={{ DEPENDS | default('"fcitx"') }}