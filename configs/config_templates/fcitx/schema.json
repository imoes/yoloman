{
  "XIM": {
    "type": "string",
    "default": "fcitx",
    "description": "Name of the X Input Method to use"
  },
  "XIM_PROGRAM": {
    "type": "string",
    "default": "/usr/bin/fcitx",
    "description": "Path to the XIM server executable"
  },
  "XIM_ARGS": {
    "type": "string",
    "default": "\"\"",
    "description": "Additional arguments for the XIM server"
  },
  "GTK_IM_MODULE": {
    "type": "string",
    "default": "fcitx",
    "description": "IM module for GTK applications",
    "enum": [
      "fcitx",
      "xim"
    ]
  },
  "QT_IM_MODULE": {
    "type": "string",
    "default": "fcitx",
    "description": "IM module for Qt applications",
    "enum": [
      "fcitx",
      "xim"
    ]
  },
  "DEPENDS": {
    "type": "string",
    "default": "\"fcitx\"",
    "description": "Package dependency declaration"
  }
}
