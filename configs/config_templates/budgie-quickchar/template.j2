# Budgie QuickChar Autostart Configuration Template
# This template generates a Desktop Entry (.desktop) file for the QuickChar helper.
# It configures the autostart behavior using GSettings to check if the feature is enabled.

[Desktop Entry]
# Type of entry; must be Application for desktop autostart
Type=Application

# Display name of the application
Name=QuickChar

# Description displayed by desktop environments
Comment=Helper process to manage displaying matching typed characters

# Command to execute the QuickChar helper process
# Default: quickchar
Exec={{ quickchar_exec | default('quickchar') }}

# Hide from application menus; show only in autostart
NoDisplay=true

# Autostart condition: Checks GSettings key before launching
# Format: AutostartCondition=GSettings <schema> <key>
# If the key evaluates to true, the application starts.
# Default Schema: org.ubuntubudgie.quickchar
# Default Key: enable-quickchar
AutostartCondition=GSettings {{ gsettings_schema | default('org.ubuntubudgie.quickchar') }} {{ gsettings_key | default('enable-quickchar') }}

# MATE desktop environment restart hint
X-MATE-AutoRestart=true

# GNOME desktop environment restart hint
X-GNOME-AutoRestart=true
