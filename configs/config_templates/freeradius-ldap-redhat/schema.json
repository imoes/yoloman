{
  "ldap_server": {
    "type": "string",
    "default": "localhost",
    "description": "LDAP server hostname or URI"
  },
  "ldap_identity": {
    "type": "string",
    "default": "cn=admin,dc=example,dc=org",
    "description": "Administrator DN for searching/modifying"
  },
  "ldap_password": {
    "type": "string",
    "default": "mypass",
    "description": "Password for the administrator account"
  },
  "ldap_base_dn": {
    "type": "string",
    "default": "dc=example,dc=org",
    "description": "Base DN for all searches"
  },
  "ldap_sasl_realm": {
    "type": "string",
    "default": "example.org",
    "description": "SASL realm for Kerberos authentication"
  },
  "ldap_group_filter": {
    "type": "string",
    "default": "(objectClass=posixGroup)",
    "description": "LDAP filter for group objects"
  },
  "ldap_membership_attribute": {
    "type": "string",
    "default": "memberOf",
    "description": "Attribute in user objects containing group memberships"
  },
  "ldap_client_ipattr": {
    "type": "string",
    "default": "radiusClientIdentifier",
    "description": "LDAP attribute for client IP address"
  },
  "ldap_client_secretattr": {
    "type": "string",
    "default": "radiusClientSecret",
    "description": "LDAP attribute for RADIUS shared secret"
  },
  "ldap_res_timeout": {
    "type": "number",
    "default": 10,
    "description": "Seconds to wait for LDAP query to finish"
  },
  "ldap_srv_timelimit": {
    "type": "number",
    "default": 3,
    "description": "Server-side time limit for query processing"
  },
  "ldap_net_timeout": {
    "type": "number",
    "default": 1,
    "description": "Seconds to wait for server response (network failures)"
  },
  "ldap_idle": {
    "type": "number",
    "default": 60,
    "description": "Keepalive idle seconds"
  },
  "ldap_probes": {
    "type": "number",
    "default": 3,
    "description": "Number of keepalive probes"
  },
  "ldap_interval": {
    "type": "number",
    "default": 3,
    "description": "Keepalive probe interval seconds"
  },
  "ldap_ldap_debug": {
    "type": "string",
    "default": "0x0028",
    "description": "Debug flag for LDAP SDK (hex value)",
    "enum": [
      "0x0000",
      "0x0028"
    ]
  },
  "ldap_pool_retry_delay": {
    "type": "number",
    "default": 30,
    "description": "Seconds to wait before retrying connection failure"
  },
  "ldap_pool_idle_timeout": {
    "type": "number",
    "default": 60,
    "description": "Idle timeout for connection pool in seconds"
  }
}
