{
  "cell_name": "mit.edu",
  "cache_path": "/var/cache/afs",
  "cache_size_mb": 512,
  "cache_threads": 4,
  "servers": [
    "afs1.mit.edu",
    "afs2.mit.edu",
    "afs3.mit.edu"
  ],
  "enable_client": true,
  "enable_dynamic_root": true,
  "dynamic_root_mount_point": "/afs",
  "kernel_params": [
    "log_level=1",
    "prefetch=1",
    "use_flock=1"
  ]
}
