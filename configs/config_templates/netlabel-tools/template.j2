# =============================================================================
# NetLabel Configuration Template
# =============================================================================
# This file contains commands for the `netlabelctl` utility.
# Each line is an individual command executed sequentially.
#
# For documentation, see: netlabel-config(8), netlabelctl(8)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Define CIPSO DOI for Loopback Interface
# -----------------------------------------------------------------------------
# Schema Description: CIPSO DOI value used for loopback interface security labels.
# If defined and not empty, this adds a CIPSO DOI mapping for the local loopback.
# Default: None (commented out)

{% if netlabel_loopback_cipso_doi is defined and netlabel_loopback_cipso_doi is not none and (netlabel_loopback_cipso_doi is number or netlabel_loopback_cipso_doi is boolean or netlabel_loopback_cipso_doi | length > 0) %}
# Enable CIPSO DOI for loopback traffic with the specified DOI value.
cipso add doi:{{ netlabel_loopback_cipso_doi }} local
{% else %}
# No loopback CIPSO DOI defined. Commented out.
# cipso add doi:9999 local
{% endif %}

# -----------------------------------------------------------------------------
# 2. Clear Default Mappings
# -----------------------------------------------------------------------------
# Remove any existing default unlabeled mappings before applying new ones.
# This ensures a clean slate for the configuration below.
# map del default

# -----------------------------------------------------------------------------
# 3. Define IPv4 Unlabeled Traffic Mapping
# -----------------------------------------------------------------------------
# Schema Description: IPv4 CIDR prefix for unlabeled traffic mapping.
# Maps all traffic matching this CIDR to the 'unlbl' protocol.
# Default: 0.0.0.0
map add default address:{{ netlabel_ipv4_unlabeled_cidr | default('0.0.0.0') }}/0 protocol:unlbl

# -----------------------------------------------------------------------------
# 4. Define IPv6 Unlabeled Traffic Mapping
# -----------------------------------------------------------------------------
# Schema Description: IPv6 CIDR prefix for unlabeled traffic mapping.
# Maps all traffic matching this CIDR to the 'unlbl' protocol.
# Default: :::0
map add default address:{{ netlabel_ipv6_unlabeled_cidr | default(':::0') }}/0 protocol:unlbl

# -----------------------------------------------------------------------------
# 5. Define Loopback Specific Mapping (Optional/Conditional)
# -----------------------------------------------------------------------------
# This rule overrides the default mapping for the loopback interface (127.0.0.1)
# to use CIPSO labeling if a loopback DOI was defined above.
# If no loopback DOI is set, this line remains commented out to rely on the
# general unlabeled mapping for loopback.
#
# Format: map add default address:<ip> protocol:cipso,<doi>

{% if netlabel_loopback_cipso_doi is defined and netlabel_loopback_cipso_doi is not none and (netlabel_loopback_cipso_doi is number or netlabel_loopback_cipso_doi is boolean or netlabel_loopback_cipso_doi | length > 0) %}
# Apply CIPSO labeling to loopback traffic using the configured DOI.
map add default address:127.0.0.1 protocol:cipso,{{ netlabel_loopback_cipso_doi }}
{% else %}
# No CIPSO DOI defined for loopback. Loopback traffic falls back to unlabeled.
# map add default address:127.0.0.1 protocol:cipso,<doi>
{% endif %}