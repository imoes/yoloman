# See fai.conf(5) for detailed information.
# This file configures the FAI (Fully Automatic Installation) client.
# It defines system-level settings for the FAI client daemon.

# System user account used for saving log files and calling fai-chboot.
# This setting is specific to the local FAI client configuration.
# For client-side log transfer configuration, see /srv/fai/config/class/FAIBASE.var on the FAI server.
LOGUSER={{ LOGUSER | default('fai') }}