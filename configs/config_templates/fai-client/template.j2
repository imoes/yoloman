# ============================================================================
# FAI Client Configuration Template
# ============================================================================
# This file configures the FAI (Fully Automatic Installation) client.
# It is generated by Ansible using Jinja2.
#
# For detailed information about these settings, see the manual page: fai.conf(5)
# ============================================================================

# --------------------------------------------------------------------------
# LOGUSER: System user account used for saving log files and calling fai-chboot.
# --------------------------------------------------------------------------
# The FAI client uses this user to write installation logs to persistent storage
# and to invoke the fai-chboot utility for reboots/post-install tasks.
# This setting is local to the FAI server's configuration management;
# for FAI clients, log transfer is typically handled via class variables
# in /srv/fai/config/class/FAIBASE.var on the FAI server.
#
# Default: 'fai'
LOGUSER={{ LOGUSER | default('fai') }}
