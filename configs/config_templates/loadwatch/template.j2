# ============================================================================
# loadwatch configuration for managing background processes based on system load
# ============================================================================
# This file controls the behavior of loadwatch, a daemon that suspends and resumes
# background processes depending on the system's load average.
# ============================================================================

# Path to the program to control. If controlled_pid is 0, loadwatch will spawn this executable.
# Default: /usr/bin/example_worker
program_path: {{ program_path | default('/usr/bin/example_worker') }}

# High load average limit. When the system load average exceeds this value, the child process is suspended.
# Type: Decimal
# Default: 1.25
high_limit: {{ high_limit | default(1.25) }}

# Low load average limit. When the system load average falls below this value, the child process is resumed.
# Type: Decimal
# Default: 0.25
low_limit: {{ low_limit | default(0.25) }}

# Delay in seconds between load average checks.
# Type: Integer
# Default: 10
delay: {{ delay | default(10) }}

# Number of copies of the program to run simultaneously.
# Type: Integer
# Default: 1
copies: {{ copies | default(1) }}

# Path to create a UNIX domain socket file for use by lw-ctl.
# If empty, socket creation is disabled.
# Default: '' (disabled)
socket_path: {{ socket_path | default('') }}

# The PID of an existing process to control.
# If 0, loadwatch spawns the program specified in program_path instead.
# Default: 0
controlled_pid: {{ controlled_pid | default(0) }}