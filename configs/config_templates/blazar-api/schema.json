{
  "service_name": {
    "type": "string",
    "default": "blazar-api",
    "description": "Service name (for init header and script name)"
  },
  "service_desc": {
    "type": "string",
    "default": "Blazar API",
    "description": "Short description in init header"
  },
  "service_long_desc": {
    "type": "string",
    "default": "Blazar OpenStack Reservation API server",
    "description": "Long description in init header"
  },
  "maintainer": {
    "type": "string",
    "default": "Thomas Goirand <zigo@debian.org>",
    "description": "Author/maintainer of the init script"
  },
  "desc": {
    "type": "string",
    "default": "OpenStack Blazar API (blazar-api-wsgi)",
    "description": "DESC variable value"
  },
  "project_name": {
    "type": "string",
    "default": "blazar",
    "description": "PROJECT_NAME and base for paths/paths/urls"
  },
  "uwsgi_port": {
    "type": "number",
    "default": 8004,
    "description": "UWSGI listening port"
  },
  "uwsgi_ini_path": {
    "type": "string",
    "default": "/etc/blazar/blazar-api-uwsgi.ini",
    "description": "Path to uWSGI config INI file"
  },
  "uwsgi_ini_app": {
    "type": "string",
    "default": "/usr/bin/blazar-api-wsgi",
    "description": "Path to the WSGI app executable"
  }
}
