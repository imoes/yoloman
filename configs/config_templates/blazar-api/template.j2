[uwsgi]
############################
### Generic UWSGI config ###
############################
# uWSGI configuration for Blazar API (WSGI application)

# uWSGI is an application server/container manager for Python WSGI applications.
# This section handles basic server behavior and plugin loading.

# Override the default size for headers from the 4k default to handle large metadata.
# Schema: buffer-size (fixed value)
buffer-size = 65535

# This avoids error 104: "Connection reset by peer" by stripping Content-Length headers
# which can cause issues with some HTTP clients/proxies.
# Schema: rem-header (fixed value)
rem-header = Content-Length

# This is running standalone (not behind a proxy like nginx/apache yet).
# master process manages the workers.
# Schema: master (fixed value)
master = true

# uwsgi recommends this to prevent thundering herd on accept.
# Only one worker accepts new connections at a time.
# Schema: thunder-lock (fixed value)
thunder-lock = true

# Enable the Python 3 plugin to run WSGI applications.
# Schema: plugins (fixed value)
plugins = python3

# This ensures that file descriptors aren't shared between the WSGI application processes.
# This is important for proper isolation of worker processes and memory management.
# Schema: lazy-apps (fixed value)
lazy-apps = true

# Log from the wsgi application: needs python3-pastescript as runtime depends.
# Enables Paste's logging framework if available.
# Schema: paste-logger (fixed value)
paste-logger = true

# automatically kill workers if master dies
# Prevents orphaned worker processes if the master process crashes.
# Schema: no-orphans (fixed value)
no-orphans = true

# exit instead of brutal reload on SIGTERM
# Ensures clean shutdown on service stop/restart.
# Schema: die-on-term (fixed value)
die-on-term = true

# Avoid memcached connections to remain opened
# Closes file descriptors on exec to prevent connection leaks.
# Schema: close-on-exec (fixed value)
close-on-exec = true
# Schema: close-on-exec2 (fixed value)
close-on-exec2 = true

##########################
### Performance tuning ###
##########################
# Threads and processes configuration.

# Enable threads within uWSGI workers for concurrent request handling.
# Schema: enable-threads (fixed value)
enable-threads = true

# Number of uWSGI worker processes.
# Adjust based on CPU cores and memory availability.
# Schema: uwsgi_processes_default
processes = {{ uwsgi_processes_default | default('8') }}

# Number of threads per uWSGI worker.
# Higher values increase concurrency per worker.
# Schema: uwsgi_threads_default
threads = {{ uwsgi_threads_default | default('32') }}

# This is the number of sockets in the queue.
# It improves a lot performances. This is comparable
# to the Apache ServerLimit/MaxClients option.
# Schema: uwsgi_listen_default
listen = {{ uwsgi_listen_default | default('100') }}

##################################
### OpenStack service specific ###
##################################
# Environment variables for the WSGI application.

# Set the OS_OSL0_MESSAGING_RABBIT__PROCESSNAME environment variable
# for RabbitMQ messaging identification.
# Schema: service_name
env OS_OSLO_MESSAGING_RABBIT__PROCESSNAME={{ service_name | default('blazar-api') }}

# Path to the log file for this service instance.
# Logs are stored in /var/log/blazar/.
# Schema: service_name
logto = /var/log/blazar/{{ service_name | default('blazar-api') }}.log

# The name of this uWSGI server instance.
# Used for identification in logs and status.
# Schema: service_name
name = {{ service_name | default('blazar-api') }}

# The Linux user to run the worker processes as.
# Running as a dedicated user enhances security.
# Schema: project_name
uid = {{ project_name | default('blazar') }}

# The Linux group to run the worker processes as.
# Schema: project_name
gid = {{ project_name | default('blazar') }}

# The working directory for the WSGI application.
# This is the base directory for relative paths in the app.
# Schema: project_name
chdir = /var/lib/{{ project_name | default('blazar') }}

# The WSGI application entry point file.
# Points to the WSGI callable script.
# Schema: uwsgi_ini_app
wsgi-file = {{ uwsgi_ini_app | default('/usr/bin/blazar-api-wsgi') }}

# This is controled by the init script using the --http-socket
# or using the --https thing. https will be activated if a file
# /etc/blazar/ssl/private/*.pem is found. In both case, port 9292
# on all IPs will be used.
# The partern to search for the private key file is:
# find /etc/blazar/ssl/private -type f -iname '*.pem' | head -n 1
# and for the certificate:
# find /etc/blazar/ssl/private -type f -iname '*.crt' | head -n 1
# just drop files there and restart the daemon, and you will have
# SSL up and running.
#http-socket = :1234
#https-socket = 0.0.0.0:1234,foobar.crt,foobar.key

# HTTP socket for the WSGI application.
# By default, the service listens on:
# Schema: uwsgi_port
{% if uwsgi_port is defined and uwsgi_port is not none and (uwsgi_port is number or uwsgi_port is boolean or uwsgi_port | length > 0) %}http-socket = 0.0.0.0:{{ uwsgi_port | default(8004) }}{% else %}#http-socket = :1234{% endif %}
