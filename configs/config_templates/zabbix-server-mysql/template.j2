# Zabbix Server Logrotate Configuration
# Managed by Ansible - Do not edit manually

# Configuration for rotating the Zabbix server log file.
# See man logrotate(8) for details on the directives used below.

/var/log/zabbix-server/{{ zabbix_log_dir | default('zabbix-server') }}/{{ zabbix_server_log_file | default('zabbix_server.log') }} {
    # Rotate log files weekly
    weekly

    # Keep the specified number of rotated log files.
    # Default: 7
    rotate {{ zabbix_log_rotate_count | default('7') }}

    # Compress old log files using gzip to save disk space.
    compress

    # Delay compression of the most recent rotated file by one rotation cycle.
    # This allows processes to finish writing to the compressed file if any.
    delaycompress

    # Do not error out if the log file is missing.
    missingok

    # Do not rotate the log if it is empty.
    notifempty

    # Create new log files with the specified permissions and ownership.
    # Format: create mode owner group
    # Default permissions: 0640
    # Default owner: zabbix
    # Default group: zabbix
    create {{ zabbix_log_file_permissions | default('0640') }} {{ zabbix_log_user | default('zabbix') }} {{ zabbix_log_group | default('zabbix') }}

    # Run all scripts in the group as a single script, rather than one per log file.
    sharedscripts
}
