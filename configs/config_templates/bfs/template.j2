# =============================================================================
# BFS Command-Line Configuration
#
# This template generates the command-line arguments passed to the bfs(1)
# binary (the "BFS" filesystem browser).
#
# The `command_line` variable is a list of single-token shell arguments.
# Ensure no argument contains spaces; split them into separate list items.
# =============================================================================

# --- command_line ---
# Description: List of command-line arguments passed directly to bfs(1).
#              Each element must be a single shell-argument token
#              (no spaces inside tokens).
#              Default: [] (empty list, runs bfs with no extra args)
#
{% for arg in (command_line | default([])) %}\
{{ arg }}
{% endfor %}