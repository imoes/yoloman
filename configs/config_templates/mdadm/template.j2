# mdadm configuration file
# See the mdadm.conf(5) man page for details.

# Whether to automatically scan for arrays.
# If true, the SCAN directive is uncommented. If false, it remains commented out.
{%- if scan_enabled | default(False) | bool %}
SCAN=yes
{%- else %}
# SCAN=no
{%- endif %}

# List of devices or patterns to scan for arrays (e.g., 'partitions containers', '/dev/sd*').
# Default: partitions containers
DEVICE {{ device_list | default('partitions containers') }}

# Automatically assemble arrays?
# This directive controls automatic assembly at boot/initramfs time.
# The homehost is appended as +homehost=<value>.
{%- if auto_assemble | default(False) | bool %}
AUTO +homehost={{ homehost | default('auto') }}
{%- else %}
# AUTO=no
{%- endif %}

# Array definitions
# Each entry in the 'arrays' list defines an MD RAID array to monitor or create.
# The structure of each item corresponds to the schema properties for an array entry.
{%- for array_def in arrays | default([]) %}
# Definition for array index {{ loop.index0 }}
# Based on schema properties for array items.
{%- if array_def.device is defined %}
ARRAY {{ array_def.device }}
{%- endif %}
{%- if array_def.metadata is defined %}
metadata={{ array_def.metadata }}
{%- endif %}
{%- if array_def.name is defined %}
name={{ array_def.name }}
{%- endif %}
{%- if array_def.udev is defined %}
udev={{ array_def.udev }}
{%- endif %}
{%- if array_def.spares is defined %}
spares={{ array_def.spares }}
{%- endif %}
{# Note: If multiple properties exist, they may need to be on one line or subsequent lines depending on mdadm syntax.
   mdadm.conf usually expects: ARRAY <device> <param>=<val> <param>=<val>
   Here we assume each defined property adds a parameter to the same ARRAY line. #}
{%- endfor %}

# If no arrays were defined, provide a comment indicating no arrays are configured.
{%- if arrays | default([]) | length == 0 %}
# No MD RAID arrays are currently configured.
{%- endif %}
