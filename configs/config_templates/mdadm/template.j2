# /etc/mdadm/mdadm.conf - MD RAID configuration for mdadm daemon and tools

# Device map for assembled arrays (AUTO entries handled automatically by mdadm; manual mappings override)
DEVICE /dev/disk/by-id/*

# Device map can be restricted to specific partitions (e.g., /dev/sda1) if needed
#DEVICE /dev/sda1 /dev/sdb1

# Metadata format: defaults to '1.2' (modern, supports UUIDs and spin-disk tracking)
# Use '1.0', '1.1', '1.2', 'ddf', or 'imsm' depending on compatibility needs
DEVICE_MDADM_METADATA="1.2"

# Auto-assemble arrays at boot? (set to 'yes' or 'no'; typically 'yes')
MAILADDR root@localhost

# Email address for alert notifications (comma-separated list if multiple)
#MAILADDR admin@example.com, ops@example.com

MAILADDR="admin@example.com"

# Program to invoke when an event occurs (e.g., mail, logger -t mdadm, /usr/local/bin/raid-alert.sh)
PROGRAM="/usr/local/bin/raid-alert.sh"

# Monitor mode: 'yes' enables daemon-based monitoring; 'no' disables it
MONITOR="yes"

# Interval (in seconds) between health checks when monitoring is enabled
CHECK_INTERVAL=60

# Delay (in seconds) before triggering a rebuild after a disk failure (prevents flapping)
SPARE_DELAY=30

# Number of spare disks to keep in reserve per array (0 = none; -1 = auto)
SPARE_GROUPS=1

# Udev rules to create symlinks for arrays? (typically 'yes')
CREATE_SYMLINKS="yes"

# Device naming scheme for arrays: 'device', 'name', or 'uuid'
DEVICE_NAMING="device"

# Default ownership/permissions for arrays (set via sysfs if needed)
#OWNER="root:disk"
#MODE="0660"

# List of arrays to manage manually (not auto-assembled)
{% for array in arrays %}
# Array: {{ array.name }} — level={{ array.level }}, UUID={{ array.uuid }}, devices=[{{ array.devices | join(', ') }}]
ARRAY {{ array.name }} metadata={{ array.metadata | default('1.2') }} UUID={{ array.uuid }} devices={{ array.devices | join(', ') }}
{% endfor %}

# Optional: homehost settings for cluster-aware deployments
# HOMEHOST <hostname|any|none>
HOMEHOST="any"

# Scan mode: 'all', 'md', 'part', or 'none'
SCAN="all"

# Scan timeouts and retries (for slow or network-attached disks)
#SCAN_TIMEOUT=5
#SCAN_RETRIES=3
