{
 "bandwidth_limits": {
  "global_download_limit": 10000,
  "global_upload_limit": 5000,
  "user_limits": [
   {
    "download_limit": 2000,
    "upload_limit": 1000,
    "user_name": "alice"
   }
  ]
 },
 "chroot_path": "/home/sftp",
 "directory_acls": [
  {
   "description": "Allow alice to read/write logs directory",
   "inherit": true,
   "path": "logs",
   "permissions": "RL",
   "user": "alice"
  },
  {
   "description": "Group access: developers can upload to shared dir",
   "inherit": false,
   "path": "shared",
   "permissions": "RWL",
   "user": "sftp-devs"
  }
 ],
 "enable_acl": true,
 "enable_compression": false,
 "idle_timeout": 600,
 "listen_address": "192.168.1.10",
 "log_level": "NOTICE",
 "log_path": "/var/log/mysecureshell.log",
 "max_sessions": 20,
 "port": 2222,
 "tls_cert_file": "/etc/mysecureshell/tls/sftp.example.com.crt",
 "tls_key_file": "/etc/mysecureshell/tls/sftp.example.com.key",
 "umask": "027",
 "use_pam": true,
 "use_tls": true,
 "virtual_users": [
  {
   "chroot_path": "alice",
   "ip_whitelist": [
    "192.168.1.0/24"
   ],
   "max_upload_size": 1024,
   "name": "alice",
   "password_hash": "{SHA512}$6$rounds=5000$salt$hashed",
   "permissions": "RWL",
   "shell": "/bin/false"
  },
  {
   "chroot_path": "bob",
   "ip_whitelist": [],
   "max_upload_size": 0,
   "name": "bob",
   "password_hash": "",
   "permissions": "RL",
   "shell": "/bin/false"
  }
 ]
}
