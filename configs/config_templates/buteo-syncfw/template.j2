<?xml version="1.0"?>
<dbus>
    <!-- D-Bus service name for the synchronizer daemon (e.g., com.meego.msyncd) -->
    <service>{{ service_name | default('com.meego.msyncd') }}</service>

    <!-- D-Bus interface name used by the synchronizer daemon (typically matches service_name) -->
    <interface>{{ interface_name | default('com.meego.msyncd') }}</interface>

    <!-- D-Bus object path for the synchronizer daemon (the endpoint consumers call) -->
    <path>{{ path | default('/synchronizer') }}</path>
</dbus>