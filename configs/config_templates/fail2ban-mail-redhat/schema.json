{
  "debug": {
    "type": "number",
    "default": 0,
    "description": "Debug level for internal transformations"
  },
  "norestored": {
    "type": "number",
    "default": 1,
    "description": "Bypass ban/unban for restored tickets"
  },
  "mail_from": {
    "type": "string",
    "default": "info@abusix.com",
    "description": "Email address used in the notification message footer"
  },
  "mailcmd": {
    "type": "string",
    "default": "mail -E 'set escape' -s",
    "description": "Command used to send emails"
  },
  "mailargs": {
    "type": "string",
    "default": "",
    "description": "Additional arguments to pass to the mail command"
  }
}
