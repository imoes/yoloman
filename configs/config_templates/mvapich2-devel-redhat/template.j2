# Self-documenting template for mvapich2-devel-redhat
# This template generates shell script snippets for loading and unloading the mvapich2 MPI module.
# It ensures variables are defined with their schema defaults to prevent rendering errors.

%_mvapich2_load \
 . /etc/profile.d/modules.sh; \
 module load {{ mvapich2_module_path | default('mpi/mvapich2-i386') }};
%_mvapich2_unload \
 . /etc/profile.d/modules.sh; \
 module unload {{ mvapich2_module_path | default('mpi/mvapich2-i386') }};
