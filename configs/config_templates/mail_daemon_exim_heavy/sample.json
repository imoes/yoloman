{
  "hostname": "mail.example.com",
  "local_domains": [
    "example.com",
    "example.org",
    "example.net"
  ],
  "local_domains_extra": [],
  "relay_domains": [],
  "relay_hosts": [
    "127.0.0.1",
    "::1",
    "192.168.1.0/24"
  ],
  "daemon_interfaces": [
    "127.0.0.1",
    "::1"
  ],
  "smtp_port": 25,
  "submission_port": 587,
  "tls_enable": true,
  "tls_certificate": "/etc/letsencrypt/live/mail.example.com/fullchain.pem",
  "tls_private_key": "/etc/letsencrypt/live/mail.example.com/privkey.pem",
  "tls_ca_certificates": "/etc/ssl/certs/ca-certificates.crt",
  "tls_min_protocol": "tls1_2",
  "auth_sasl_plaintext": false,
  "auth_mechanisms": [
    "cram-md5",
    "login",
    "plain"
  ],
  "local_delivery": "maildir_format",
  "maildir_path_template": "%h/Maildir/",
  "mbox_path": "/var/mail/%n",
  "smart_host": "",
  "dns_routing": true,
  "max_parallel_inbound": 30,
  "msg_per_conn": 50,
  "smtp_timeout": 300,
  "queue_interval": 300,
  "acl_enable": true,
  "content_scan_enable": true,
  "clamd_socket": "localhost:3310",
  "spamc_socket": "localhost:783",
  "spam_score_high": 12,
  "spam_score_low": 5,
  "log_level": 1,
  "log_file_path": "/var/log/exim4",
  "main_log_path": "mainlog",
  "reject_log_path": "rejectlog",
  "panic_log_path": "paniclog",
  "exim_user": "Debian-exim",
  "exim_group": "Debian-exim",
  "message_size_limit": 52428800,
  "queue_max": 100000,
  "deferred_expiry": 604800,
  "custom_settings": [
    {
      "name": "LOG_SELECTOR",
      "value": "+all_address_rewrite +all_parents"
    },
    {
      "name": "REQUIRE_PROTOCOL",
      "value": "smtp"
    }
  ]
}
