{
 "allow_other": true,
 "bucket": "my-production-data",
 "connect_timeout": 300,
 "dbglevel": "warn",
 "default_acl": "private",
 "endpoint": "eu-west-1",
 "ensure_diskfree": 1024,
 "free_space_ratio": 10,
 "fuse_opts": "defaults,nodev,nosuid,allow_other",
 "host": "https://s3.amazonaws.com",
 "iam_role": "s3fs-role",
 "logfile": "/var/log/s3fs/s3fs.log",
 "max_stat_cache_size": 100000,
 "max_thread_count": 5,
 "mountpoint": "/mnt/s3-data",
 "multipart_size": 10,
 "multipart_threshold": 25,
 "no_check_certificate": false,
 "nomultipart": false,
 "parallel_count": 5,
 "passwd_file": "/etc/passwd-s3fs",
 "profile": "default",
 "proxy": "",
 "readwrite_timeout": 120,
 "requester_pays": false,
 "retries": 5,
 "sigv4": true,
 "stat_cache_expire": 900,
 "storage_class": "standard_ia",
 "streamupload": false,
 "tmpdir": "/var/cache/s3fs",
 "umask": "0022",
 "use_cache": "/var/cache/s3fs/cache",
 "use_path_request_style": false,
 "use_sse": ""
}
