# cloud-init main configuration — /etc/cloud/cloud.cfg

# Disable direct root login via SSH and console
disable_root: {{ disable_root }}

# Honor an existing hostname; skip the datasource-provided value
preserve_hostname: {{ preserve_hostname }}

# Rewrite /etc/hosts on each boot to reflect the current instance hostname
manage_etc_hosts: {{ manage_etc_hosts }}

# Allow password-based SSH logins (false enforces key-only access)
ssh_pwauth: {{ ssh_pwauth }}

# Delete pre-baked SSH host keys and regenerate them on first boot
ssh_deletekeys: {{ ssh_deletekeys }}

# SSH host key algorithms to generate on first boot
ssh_genkeytypes:
{% for kt in ssh_genkeytypes %}
  - {{ kt }}
{% endfor %}

# System locale — sets LANG and related LC_* variables
locale: {{ locale }}

# System timezone — tz database identifier (timedatectl list-timezones)
timezone: {{ timezone }}

# Grow the root filesystem to fill the partition after growpart expands it
resize_rootfs: {{ resize_rootfs }}

# Partition growth backend: auto (detect tool), growpart, gpart, or off
growpart:
  mode: {{ growpart_mode }}
  devices:
    - /

# Run a full package upgrade on first boot (adds latency; ensures day-0 patches)
package_upgrade: {{ package_upgrade }}

# Additional packages to install on first boot via the distro package manager
packages:
{% if packages %}
{% for pkg in packages %}
  - {{ pkg }}
{% endfor %}
{% else %}
  []
{% endif %}

# NTP daemon configuration
ntp:
  enabled: true
  servers:
{% for srv in ntp_servers %}
    - {{ srv }}
{% endfor %}

# Users to create on first boot; first entry becomes the primary administrative user
users:
  - name: {{ admin_user.name }}
    # GECOS / human-readable display name
    gecos: {{ admin_user.gecos }}
    # Default login shell
    shell: {{ admin_user.shell }}
    # Supplementary Unix groups (comma-separated)
    groups: {{ admin_user.groups | join(', ') }}
    # Sudoers rule — quoted to handle empty-string (no sudo) safely
    sudo: "{{ admin_user.sudo }}"
    # Lock the Unix password slot to prevent password-based logins
    lock_passwd: {{ admin_user.lock_passwd }}
{% if admin_user.ssh_authorized_keys %}
    # SSH public keys pre-authorized for this user
    ssh_authorized_keys:
{% for key in admin_user.ssh_authorized_keys %}
      - {{ key }}
{% endfor %}
{% endif %}
{% for u in extra_users %}
  - name: {{ u.name }}
    gecos: {{ u.gecos }}
    shell: {{ u.shell }}
    groups: {{ u.groups | join(', ') }}
    sudo: "{{ u.sudo }}"
    lock_passwd: {{ u.lock_passwd }}
{% if u.ssh_authorized_keys %}
    ssh_authorized_keys:
{% for key in u.ssh_authorized_keys %}
      - {{ key }}
{% endfor %}
{% endif %}
{% endfor %}

# Datasource probe order — restrict to your cloud provider to cut first-boot time
datasource_list:
{% for ds in datasource_list %}
  - {{ ds }}
{% endfor %}

# Per-datasource tunables
datasource:
  Ec2:
    # Seconds to wait for the IMDSv2 token endpoint per attempt
    timeout: {{ ec2_metadata_timeout }}
    # Total seconds to retry EC2 metadata before abandoning the datasource
    max_wait: {{ ec2_metadata_max_wait }}

# Distro and path defaults — normally set by the cloud-init distribution package
system_info:
  default_user:
    name: {{ admin_user.name }}
    lock_passwd: {{ admin_user.lock_passwd }}
    gecos: {{ admin_user.gecos }}
    groups:
{% for g in admin_user.groups %}
      - {{ g }}
{% endfor %}
    sudo: "{{ admin_user.sudo }}"
    shell: {{ admin_user.shell }}
  # Distro identifier used to select the package manager and conventions
  distro: {{ distro }}
  paths:
    cloud_dir: /var/lib/cloud/
    templates_dir: /etc/cloud/templates/
  # systemd unit name for the SSH daemon (ssh on Debian/Ubuntu, sshd on RHEL/CentOS)
  ssh_svcname: {{ ssh_svcname }}

# Stage 1 — network-up, filesystem, early user and SSH setup
cloud_init_modules:
  - migrator
  - seed_random
  - bootcmd
  - write-files
  - growpart
  - resizefs
  - disk_setup
  - mounts
  - set_hostname
  - update_hostname
  - update_etc_hosts
  - ca-certs
  - rsyslog
  - users-groups
  - ssh

# Stage 2 — package repositories, locale, timezone, NTP, runcmd
cloud_config_modules:
  - snap
  - ssh-import-id
  - keyboard
  - locale
  - set-passwords
  - grub-dpkg
  - apt-pipelining
  - apt-configure
  - ntp
  - timezone
  - runcmd

# Stage 3 — software installation, per-instance and per-boot scripts
cloud_final_modules:
  - package-update-upgrade-install
  - write-files-deferred
  - scripts-vendor
  - scripts-per-once
  - scripts-per-boot
  - scripts-per-instance
  - scripts-user
  - ssh-authkey-fingerprints
  - keys-to-console
  - final-message
  - power-state-change

# Message written to console and /var/log/cloud-init-output.log when all stages complete
final_message: {{ final_message }}
