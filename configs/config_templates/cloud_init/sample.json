{
  "disable_root": true,
  "preserve_hostname": false,
  "manage_etc_hosts": true,
  "ssh_pwauth": false,
  "ssh_deletekeys": true,
  "ssh_genkeytypes": [
    "rsa",
    "ecdsa",
    "ed25519"
  ],
  "locale": "en_US.UTF-8",
  "timezone": "Europe/Berlin",
  "resize_rootfs": true,
  "growpart_mode": "auto",
  "package_upgrade": true,
  "packages": [
    "curl",
    "htop",
    "jq",
    "unattended-upgrades",
    "ca-certificates"
  ],
  "ntp_servers": [
    "169.254.169.123",
    "0.pool.ntp.org",
    "1.pool.ntp.org"
  ],
  "admin_user": {
    "name": "deploy",
    "gecos": "Deployment User",
    "shell": "/bin/bash",
    "groups": [
      "adm",
      "sudo",
      "netdev",
      "users"
    ],
    "sudo": "ALL=(ALL) NOPASSWD:ALL",
    "lock_passwd": true,
    "ssh_authorized_keys": [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyForDocumentationOnly ops@example.com"
    ]
  },
  "extra_users": [
    {
      "name": "monitor",
      "gecos": "Monitoring Agent",
      "shell": "/usr/sbin/nologin",
      "groups": [
        "netdev"
      ],
      "sudo": "",
      "lock_passwd": true,
      "ssh_authorized_keys": []
    }
  ],
  "datasource_list": [
    "Ec2",
    "None"
  ],
  "ec2_metadata_timeout": 50,
  "ec2_metadata_max_wait": 120,
  "distro": "ubuntu",
  "ssh_svcname": "ssh",
  "final_message": "cloud-init $VERSION finished at $TIMESTAMP. Instance up $UPTIME seconds."
}
