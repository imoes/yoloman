{#
  NagVis Permissions Configuration (perms.db)
  ============================================
  This template generates a JSON configuration file used by the NagVis
  CoreAuthorisationModGroups module. It maps Icinga/Nagios contact groups
  to NagVis permission levels (admin, view, edit).

  The resulting JSON structure allows granular control:
  - "admin": 1 grants full superuser access.
  - "view": ["*"] grants read-only access to all maps.
  - "edit": ["*"] grants read/write access to all maps.
  - "view"/"edit" with specific map names restricts access to those maps only.
#}
{
{# Administrators: Full access to all NagVis features and maps #}
{# Schema: admins_group (default: 'admins') #}
  "{{ admins_group | default('admins') }}": {
    "admin": 1
  },
{# First Level Support: View-only access to all maps #}
{# Schema: first_level_support_group (default: 'first_level_support') #}
  "{{ first_level_support_group | default('first_level_support') }}": {
    "view": [ "*" ]
  },
{# Power Users: View and edit access to all maps #}
{# Schema: power_users_group (default: 'power_users') #}
  "{{ power_users_group | default('power_users') }}": {
    "view": [ "*" ],
    "edit": [ "*" ]
  },
{# Oracle Admins: View and edit access restricted to a specific map #}
{# Schema: oracle_admins_group (default: 'oracle_admins') #}
{# Schema: oracle_map_name (default: 'oracle_servers') #}
  "{{ oracle_admins_group | default('oracle_admins') }}": {
    "view": [ "{{ oracle_map_name | default('oracle_servers') }}" ],
    "edit": [ "{{ oracle_map_name | default('oracle_servers') }}" ]
  }
}
