{
  "enable_config": true,
  "compile_commands_dir": "/home/user/project/build",
  "query_driver": [
    "/usr/bin/clang-*",
    "/usr/bin/clang++-*"
  ],
  "all_scopes_completion": true,
  "background_index": true,
  "background_index_priority": "normal",
  "clang_tidy": true,
  "completion_style": "detailed",
  "fallback_style": "LLVM",
  "function_arg_placeholders": true,
  "header_insertion": "iwyu",
  "header_insertion_decorators": true,
  "import_insertions": true,
  "limit_references": 1000,
  "limit_results": 100,
  "project_root": "/home/user/project",
  "remote_index_address": "https://index.example.com:1234",
  "rename_file_limit": 100,
  "log": "info",
  "offset_encoding": "utf-8",
  "path_mappings": [
    "/home/user/project=/work/project",
    "/opt/include=/home/user/clangd-includes"
  ],
  "pch_storage": "disk",
  "malloc_trim": true,
  "workers": 4,
  "check": ""
}
