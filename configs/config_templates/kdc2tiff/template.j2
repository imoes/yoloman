# kdc2tiff configuration template
#
# This configuration file controls the behavior of the kdc2tiff utility,
# which converts Kodak Photo-CD images to standard TIFF format.
# All settings below correspond to command-line options.

# Output image width in pixels.
# Corresponds to the -W <width> option.
output_width: {{ output_width | default(1200) }}

# Output image height in pixels.
# Corresponds to the -H <height> option.
output_height: {{ output_height | default(1600) }}

# Absolute gamma correction factor.
# Applies a gamma correction based on an absolute gamma value.
# Corresponds to the -a <gamma> option.
abs_gamma: {{ abs_gamma | default(1.0) }}

# Relative gamma correction factor.
# Applies a gamma correction relative to the input image's gamma.
# Corresponds to the -r <gamma> option.
rel_gamma: {{ rel_gamma | default(1.0) }}

# Enable grain reduction (+G or +GG).
# Reduces visible film grain in the output image.
# Corresponds to the +G or +GG option.
grain_reduction: {{ grain_reduction | default(false) }}

# Enable advanced contrast enhancement (+E).
# Enhances contrast using an advanced algorithm.
# Corresponds to the +E option.
advanced_contrast: {{ advanced_contrast | default(false) }}

# Disable contrast enhancement (-e).
# Turns off any automatic contrast adjustments.
# Corresponds to the -e option.
no_contrast: {{ no_contrast | default(false) }}

# Colour of light source (-W).
# Specifies the color temperature or name of the light source used for scanning.
# Corresponds to the -W <colour> option.
light_source_colour: {{ light_source_colour | default('') }}

# Force square pixels (+s).
# Ensures the output image has square pixels, correcting for aspect ratio.
# Corresponds to the +s option.
square_pixels: {{ square_pixels | default(true) }}

# Enable fast processing (+f).
# Uses faster, potentially lower-quality algorithms for rendering.
# Corresponds to the +f option.
fast_processing: {{ fast_processing | default(false) }}

# Crop image if necessary.
# If true, crops the image to fit dimensions. If false (-p), preserves full aspect.
# Default is +p (crop enabled implicitly if needed, but this flag controls strict behavior).
# Corresponds to the +p / -p option.
crop_image: {{ crop_image | default(true) }}

# Rotate image clockwise (+R).
# Rotates the output image 90 degrees clockwise.
# Corresponds to the +R option.
rotate_cw: {{ rotate_cw | default(false) }}

# Rotate image counter-clockwise (+B).
# Rotates the output image 90 degrees counter-clockwise.
# Corresponds to the +B option.
rotate_ccw: {{ rotate_ccw | default(false) }}

# Copy note copyright in output file (-C).
# Copies copyright information from the input Photo-CD file to the TIFF.
# Corresponds to the -C option.
copy_copyright: {{ copy_copyright | default(false) }}

# TIFF compression scheme (-c).
# Specifies the compression method for the resulting TIFF file.
# Corresponds to the -c <scheme> option.
compression_scheme: {{ compression_scheme | default('deflate') }}

# TIFF rows per strip setting (-r).
# Defines the number of rows per strip in the TIFF output, affecting compression efficiency.
# Corresponds to the -r <rows> option.
rows_per_strip: {{ rows_per_strip | default(8) }}