{
  "output_width": {
    "type": "number",
    "default": 1200,
    "description": "Output image width in pixels."
  },
  "output_height": {
    "type": "number",
    "default": 1600,
    "description": "Output image height in pixels."
  },
  "abs_gamma": {
    "type": "number",
    "default": 1.0,
    "description": "Absolute gamma correction factor."
  },
  "rel_gamma": {
    "type": "number",
    "default": 1.0,
    "description": "Relative gamma correction factor."
  },
  "grain_reduction": {
    "type": "bool",
    "default": false,
    "description": "Enable grain reduction (+G or +GG)."
  },
  "advanced_contrast": {
    "type": "bool",
    "default": false,
    "description": "Enable advanced contrast enhancement (+E)."
  },
  "no_contrast": {
    "type": "bool",
    "default": false,
    "description": "Disable contrast enhancement (-e)."
  },
  "light_source_colour": {
    "type": "string",
    "default": "",
    "description": "Colour of light source (-W)."
  },
  "square_pixels": {
    "type": "bool",
    "default": true,
    "description": "Force square pixels (+s)."
  },
  "fast_processing": {
    "type": "bool",
    "default": false,
    "description": "Enable fast processing (+f)."
  },
  "crop_image": {
    "type": "bool",
    "default": true,
    "description": "Crop image if necessary (-p disables, default is +p)."
  },
  "rotate_cw": {
    "type": "bool",
    "default": false,
    "description": "Rotate image clockwise (+R)."
  },
  "rotate_ccw": {
    "type": "bool",
    "default": false,
    "description": "Rotate image counter-clockwise (+B)."
  },
  "copy_copyright": {
    "type": "bool",
    "default": false,
    "description": "Copy note copyright in output file (-C)."
  },
  "compression_scheme": {
    "type": "string",
    "default": "deflate",
    "description": "TIFF compression scheme (-c)."
  },
  "rows_per_strip": {
    "type": "number",
    "default": 8,
    "description": "TIFF rows per strip setting (-r)."
  }
}
