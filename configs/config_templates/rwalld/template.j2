# =============================================================================
# rpc.rwalld Configuration Template
# =============================================================================
# This template configures the RPC.RWALLD (Remote Wall Daemon) service.
# RPC.RWALLD allows system administrators to send messages to users' terminals
# (similar to 'wall' or 'write') via RPC, typically used in Unix/Linux clusters.
#
# Configuration file: /etc/default/rpc.rwalld
# Managed by: Ansible Role
# =============================================================================

# ------------------------------------------------------------------------------
# Service Activation
# ------------------------------------------------------------------------------
# enable: default=True
# Whether to start the rpc.rwalld daemon. Set to false to disable the service.
RPC_Rwalld_ENABLE={{ enable | default(true) }}

# ------------------------------------------------------------------------------
# Network Binding
# ------------------------------------------------------------------------------
# ip: default=''
# IP address to bind the rpc.rwalld service to.
# - If left empty (default), the service binds to all available network interfaces.
# - To restrict access, specify a specific IP (e.g., '192.168.1.100').
RPC_Rwalld_IP={{ ip | default("") }}