# Tasksh Configuration
# This configuration file is appended to or used in conjunction with .taskrc.
# See man page tasksh(1) and taskrc(5) for details.

# tasksh.autoclear: If true, clears the screen before each command is executed in tasksh.
# Value: 1 (enabled) or 0 (disabled).
# Defaults to 'False' if not specified.
{% set _autoclear = autoclear | default(False) %}
{% if _autoclear %}tasksh.autoclear=1
{% else %}tasksh.autoclear=0
{% endif %}