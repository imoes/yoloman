# csvtool configuration
# Generated by csvtool service
#
# This configuration file controls the parsing and formatting behavior of csvtool.
# It is a simple key-value format. Each setting is documented below with its
# schema description and the default value applied if the variable is undefined.

# Single-character separator between fields in the CSV (e.g., comma, semicolon, tab)
# Default: ','
FieldSeparator: {{ field_separator|default(',') }}

# Single-character used to quote fields containing separators or newlines
# Default: '"'
TextQualifier: {{ text_qualifier|default('"') }}

# When true, preserve empty fields instead of collapsing them
# Default: False
EmptyFields: {{ empty_fields|default(false) | lower }}

# Enable extra diagnostic output to stderr
# Default: False
Verbose: {{ verbose|default(false) | lower }}

# List of 1-based column indices to include in output; if empty, all columns are included
# If the 'columns' list is not empty, emit the Columns directive with space-separated indices
# Default: [] (empty, meaning all columns)
{% if columns|default([]) %}
Columns: {{ columns|default([])|join(' ') }}
{% endif %}

# Number of leading lines to skip before processing
# Default: 0
SkipLines: {{ skip_lines|default(0) }}