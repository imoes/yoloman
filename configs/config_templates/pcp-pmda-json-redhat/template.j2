{
    # JSON array of directories to monitor for JSON metrics. Default: ['/var/lib/pcp/tmp/json'].
    "directory_list" : [
        {{ directory_list | default(["/var/lib/pcp/tmp/json"]) | tojson }}
    ],
    # JSON array of trusted directories. Default: [] (empty).
    "trusted_directory_list" : [
        {{ trusted_directory_list | default([]) | tojson }}
    ]
}
