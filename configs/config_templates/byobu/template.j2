# ==============================================================================
# byobu configuration
#
# This file configures the Byobu terminal multiplexer's default backend.
# Byobu acts as a user-friendly wrapper around either GNU Screen or Tmux.
#
# Variable: BYOBU_BACKEND
# Description: Backend to use; currently supported values are "screen" or "tmux".
# ==============================================================================

# Set the terminal multiplexer backend.
# Valid values: "screen", "tmux"
# If unset, defaults to "tmux" as per schema.
BYOBU_BACKEND="{{ BYOBU_BACKEND | default('tmux') }}"