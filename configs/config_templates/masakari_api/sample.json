{
  "log_dir": "/var/log/masakari",
  "log_file": "masakari-api.log",
  "debug": false,
  "transport_url": "rabbit://openstack:secretrabbit@controller:5672/",
  "api_paste_config": "/etc/masakari/api-paste.ini",
  "host": "0.0.0.0",
  "port": 8080,
  "ssl_enabled": false,
  "ssl_cert_file": "/etc/ssl/certs/masakari.crt",
  "ssl_key_file": "/etc/ssl/private/masakari.key",
  "database": {
    "connection": "mysql+pymysql://masakari:MasakariDbPass@controller/masakari"
  },
  "keystone_authtoken": {
    "auth_type": "password",
    "project_domain_name": "Default",
    "project_name": "service",
    "user_domain_name": "Default",
    "username": "masakari",
    "password": "MasakariPass",
    "auth_url": "https://controller:5000/v3"
  },
  "notifications": {
    "driver": "masakari.notifications.api.APINotification"
  },
  "lock_path": "/var/lib/masakari/lock",
  "workers": 4,
  "endpoints": [
    {
      "name": "event_api",
      "enabled": true
    },
    {
      "name": "process_manager",
      "enabled": false
    }
  ]
}
