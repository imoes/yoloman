# [DEFAULT] General settings
[DEFAULT]
# Logging configuration
log_dir = {{ log_dir }}
log_file = {{ log_file }}
# Enable debug logging
debug = {{ debug }}
# RPC backend for messaging
transport_url = {{ transport_url }}

# [api] API server settings
api_paste_config = {{ api_paste_config }}
# Host and port the API server listens on
host = {{ host }}
port = {{ port }}
# Enable SSL/TLS for API
ssl_enabled = {{ ssl_enabled }}
ssl_cert_file = {{ ssl_cert_file }}
ssl_key_file = {{ ssl_key_file }}

# [database] Database connection
connection = {{ database.connection }}

# [keystone_authtoken] Identity service (Keystone) integration
auth_type = {{ keystone_authtoken.auth_type }}
project_domain_name = {{ keystone_authtoken.project_domain_name }}
project_name = {{ keystone_authtoken.project_name }}
user_domain_name = {{ keystone_authtoken.user_domain_name }}
username = {{ keystone_authtoken.username }}
password = {{ keystone_authtoken.password }}
auth_url = {{ keystone_authtoken.auth_url }}

# [notifications] Notification settings
driver = {{ notifications.driver }}

# [oslo_concurrency] Lock path for concurrent access
lock_path = {{ lock_path }}

# [process_launcher] Process management
workers = {{ workers }}

{% for endpoint in endpoints %}
# [endpoint:{{ endpoint.name }}] Custom endpoint configuration
{{ endpoint.name }}_enabled = {{ endpoint.enabled }}
{% endfor %}