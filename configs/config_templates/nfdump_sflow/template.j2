# sFlow collector daemon (nfdump_sflow/nfcapd) configuration
# Listen on UDP port for sFlow/NetFlow v5/v9/IPFIX samples
listen: {{ listen_port }}

# IP address to bind to (empty = all interfaces)
bind: {{ bind_address }}

# Enable IPv6 support
ipv6: {{ enable_ipv6 }}

# Input format: sflow, netflow, ipfix, or auto
input: {{ input_format }}

# Output directory for flow files (must exist, owned by daemon user)
outdir: {{ output_dir }}

# Rotate flow files after N seconds
rotate: {{ rotate_interval }}

# Retention period: keep files for N seconds (0 = keep forever)
retention: {{ retention_period }}

# User to drop privileges to (commonly 'nobody' or 'nfdump')
user: {{ daemon_user }}

# Group to drop privileges to
#group: {{ daemon_group }}

# Enable verbose logging to syslog
verbose: {{ verbose_logging }}

# Set maximum file size for rotation (bytes); overrides rotate if >0
maxsize: {{ max_file_size }}

# Enable flow compression with gzip
compress: {{ compress_flows }}

# Enable live streaming via netcat (host:port)
#stream: {{ stream_target }}

# Enable extended NetFlow v9/IPFIX option parsing
extended: {{ extended_nf9 }}

# List of source IP subnets to accept flows from (empty = accept all)
{% if allow_sources %}allow-from:
{% for src in allow_sources %}  {{ src }}{% if loop.last %}
{% endif %}{% endfor %}{% endif %}

# Disable flow aggregation (useful for debugging)
noflowagg: {{ no_flow_aggregation }}