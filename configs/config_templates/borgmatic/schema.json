{
  "repository": {
    "type": "string",
    "default": {
      "value": "/path/to/borg/repo"
    }
  },
  "verification": {
    "type": "string",
    "default": {
      "value": "integrity"
    }
  },
  "pruning": {
    "type": "bool",
    "default": {
      "value": true
    }
  },
  "retention_keep_daily": {
    "type": "number",
    "default": {
      "value": 7
    }
  },
  "retention_keep_weekly": {
    "type": "number",
    "default": {
      "value": 4
    }
  },
  "retention_keep_monthly": {
    "type": "number",
    "default": {
      "value": 6
    }
  },
  "retention_keep_yearly": {
    "type": "number",
    "default": {
      "value": 2
    }
  },
  "retention_prefix": {
    "type": "string",
    "default": {
      "value": "{hostname}-"
    }
  },
  "source_directories": {
    "type": "list",
    "default": {
      "value": [
        "/home",
        "/etc",
        "/var"
      ]
    },
    "description": "List of directories to include in backups."
  },
  "excludes": {
    "type": "list",
    "default": {
      "value": [
        "*.tmp",
        "*.log",
        "/tmp/*",
        "/var/cache/*"
      ]
    },
    "description": "List of file/directory patterns to exclude from backups."
  },
  "extra_borg_create_options": {
    "type": "list",
    "default": {
      "value": []
    },
    "description": "Additional command-line flags passed to `borg create`."
  },
  "pre_backup": {
    "type": "list",
    "default": {
      "value": []
    },
    "description": "Shell commands to run before each backup (e.g., service freeze, fsync)."
  },
  "post_backup": {
    "type": "list",
    "default": {
      "value": []
    },
    "description": "Shell commands to run after each backup (e.g., service thaw, notifications)."
  },
  "on_error": {
    "type": "list",
    "default": {
      "value": []
    },
    "description": "Shell commands to run if backup fails (e.g., alerting scripts)."
  },
  "storage_encryption": {
    "type": "string",
    "default": {
      "value": "repokey"
    }
  },
  "storage_chunker_params": {
    "type": "string",
    "default": {
      "value": "default"
    }
  },
  "storage_compression": {
    "type": "string",
    "default": {
      "value": "lz4"
    }
  },
  "storage_archive_name_format": {
    "type": "string",
    "default": {
      "value": "{hostname}-{now:%Y-%m-%dT%H:%M:%S}"
    }
  },
  "storage_relimit": {
    "type": "object",
    "default": {
      "value": null
    },
    "description": "Optional read/write rate limits for backup speed control."
  },
  "monitoring_monitors": {
    "type": "list",
    "default": {
      "value": []
    },
    "description": "List of monitoring services to ping (e.g., Uptime Kuma, PagerDuty)."
  },
  "log_level": {
    "type": "string",
    "default": {
      "value": "INFO"
    }
  },
  "log_json": {
    "type": "bool",
    "default": {
      "value": false
    }
  }
}
