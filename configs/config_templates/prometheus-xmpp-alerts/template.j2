# ============================================================================
# prometheus-xmpp-alerts Configuration
# ============================================================================
# This file configures the prometheus-xmpp-alerts bridge service, which
# receives alerts from Prometheus (via webhooks) and forwards them via XMPP.
# ============================================================================

# --- XMPP Authentication & Destination ---

# The JID (Jabber ID) used by the XMPP client to authenticate and send alerts.
# Default: 'alertmanager@example.com'
jid: '{{ jid | default("alertmanager@example.com") }}'

# The password for the JID used to authenticate with the XMPP server.
# Default: 'PASSWORD'
password: '{{ password | default("PASSWORD") }}'

# The destination JID (Jabber ID) where alerts should be sent.
# Default: 'jelmer@example.com'
to_jid: '{{ to_jid | default("jelmer@example.com") }}'

# --- Webhook Listener ---

# The IP address on which the service listens for incoming Prometheus webhooks.
# Default: '127.0.0.1'
listen_address: '{{ listen_address | default("127.0.0.1") }}'

# The port on which the service listens for incoming Prometheus webhooks.
# Default: 9199
listen_port: {{ listen_port | default(9199) }}