# Configuration for prometheus-xmpp-alerts
# This file defines the XMPP (Jabber) settings for sending alerts to Prometheus Alertmanager,
# and the local listening interface for receiving webhook notifications.

# The JID (Jabber ID) used by the XMPP client to authenticate and send alerts.
# This identity is used to log in to the XMPP server and identify outgoing messages.
jid: '{{ jid | default("alertmanager@example.com") }}'

# The password for the JID used to authenticate with the XMPP server.
# Keep this secure; consider using Ansible vault or a secrets manager in production.
password: '{{ password | default("PASSWORD") }}'

# The destination JID (Jabber ID) where alerts should be sent.
# All alerts forwarded via this plugin will be directed to this single recipient.
to_jid: '{{ to_jid | default("jelmer@example.com") }}'

# The IP address on which the service listens for incoming Prometheus webhooks.
# Typically bound to localhost to accept alerts from the local Prometheus instance.
listen_address: '{{ listen_address | default("127.0.0.1") }}'

# The port on which the service listens for incoming Prometheus webhooks.
# Prometheus Alertmanager will POST alerts to this port.
listen_port: {{ listen_port | default(9199) }}
