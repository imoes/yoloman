// This file is used in the chroot environment from install_packages
//
// Configuration for FAI (Fully Automatic Installation) to control
// the behavior of apt-get during the NFS root image creation.
//
// The APT block maps directly to apt-get command-line options.
// Boolean options are passed as "true" or "false" strings.

APT
{
    // Options for apt-get
    Get
    {
        // Whether apt-get should automatically assume yes for prompts.
        // Equivalent to: apt-get -y
        // Default: true
        Assume-Yes "{{ assume_yes | default(true) }}";

        // Whether apt-get should continue even if some packages are missing.
        // Equivalent to: apt-get --fix-missing
        // Default: true
        Fix-Missing "{{ fix_missing | default(true) }}";

        // Whether apt-get should show packages that are upgraded.
        // Equivalent to: apt-get --show-upgraded
        // Default: true
        Show-Upgraded "{{ show_upgraded | default(true) }}";

        // Whether apt-get should purge packages, removing config files as well.
        // Equivalent to: apt-get --purge
        // Default: true
        Purge "{{ purge | default(true) }}";

        // Whether apt-get should clean up the package lists.
        // Equivalent to: apt-get --clean
        // Default: true
        List-Cleanup "{{ list_cleanup | default(true) }}";

        // Whether apt-get should reinstall packages.
        // Equivalent to: apt-get --reinstall
        // Default: false
        ReInstall "{{ reinstall | default(false) }}";
    };
};

// Dpkg configuration block
// Ensures that when configuration files are updated, the default
// action is to keep the current configuration if no specific
// override is provided, preventing interactive prompts during automation.
DPkg
{
    Options {
        "--force-confdef";
    };
};
