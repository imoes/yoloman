{
  "pool_name": "api",
  "listen_address": "/run/php/php8.2-fpm-api.sock",
  "user": "www-data",
  "group": "www-data",
  "listen_owner": "www-data",
  "listen_group": "www-data",
  "listen_mode": "0660",
  "process_manager": "dynamic",
  "pm_max_children": 20,
  "pm_start_servers": 5,
  "pm_min_spare_servers": 2,
  "pm_max_spare_servers": 10,
  "pm_request_terminate_timeout": 60,
  "pm_log_level": "warning",
  "access_log_path": "/var/log/php8.2-fpm-api.access.log",
  "access_format": "%R - %u %t \"%m %r %V\" %s",
  "slowlog_path": "/var/log/php8.2-fpm-api.slow.log",
  "request_slowlog_timeout": 5,
  "php_admin_values": {
    "error_reporting": "E_ALL & ~E_DEPRECATED & ~E_STRICT",
    "display_errors": "Off",
    "log_errors": "On",
    "memory_limit": "512M",
    "upload_max_filesize": "128M",
    "post_max_size": "128M"
  },
  "php_values": {
    "date.timezone": "UTC",
    "session.gc_probability": "1",
    "session.gc_divisor": "1000"
  },
  "php_env_vars": [
    {
      "name": "APP_ENV",
      "value": "production"
    },
    {
      "name": "DB_PASSWORD",
      "value": "{{ env.DB_PASSWORD }}"
    }
  ],
  "chdir": "/var/www/api",
  "process_priority": "10",
  "process_prefix": "api:",
  "rlimit_files": "262144",
  "rlimit_core": "unlimited",
  "disable_functions": "exec,passthru,system,shell_exec,proc_open",
  "disable_classes": "",
  "open_basedir": "/var/www/api:/tmp:/var/log/php8.2-fpm-api.log",
  "catch_workers_output": "yes"
}
