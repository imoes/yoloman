# fastd configuration file
# This template generates a self-documenting fastd (Fast Daemon) configuration.
# fastd is a secure, lightweight VPN daemon that creates TAP/TUN interfaces.

# Name of the TAP interface to create.
# Default: 'fastd0'
interface = "{{ interface | default('fastd0') }}"

# Operational mode: client (outgoing only), server (incoming only), or hybrid (both).
# Default: 'server'
mode = "{{ mode | default('server') }}"

# Authentication and key exchange method.
# Default: 'handshake'
method = "{{ method | default('handshake') }}"

# Directory containing peer public key files.
# Required for 'manual' and 'password' methods.
# Default: '/etc/fastd/peers'
peers_dir = "{{ peers_dir | default('/etc/fastd/peers') }}"

# Path to file with pre-shared keys.
# Required for 'psk' method.
# Default: '/etc/fastd/pre_shared_keys.txt'
pre_shared_key_file = "{{ pre_shared_key_file | default('/etc/fastd/pre_shared_keys.txt') }}"

# Directory containing secret key files.
# Required for 'handshake' method.
# Default: '/etc/fastd/secrets'
secrets_dir = "{{ secrets_dir | default('/etc/fastd/secrets') }}"

# Local IP address to bind the UDP socket.
# Empty string means bind to all interfaces.
# Default: ''
bind_address = "{{ bind_address | default('') }}"

# UDP port to listen on.
# Only used in server/hybrid mode.
# Default: 9696
port = {{ port | default(9696) }}

# Maximum transmission unit for the VPN interface.
# Default: 1426
mtu = {{ mtu | default(1426) }}

# Verbosity of logging output.
# Levels: debug, info, notice, warning, error, critical, alert, emergency.
# Default: 'notice'
log_level = "{{ log_level | default('notice') }}"

# System user to drop privileges to after startup.
# Default: 'fastd'
user = "{{ user | default('fastd') }}"

# System group to drop privileges to after startup.
# Default: 'fastd'
group = "{{ group | default('fastd') }}"

# List of DNS servers to push to connecting peers.
# Only used in server/hybrid mode.
# Default: []
{% if dns_servers | default([]) | length > 0 %}
dns_servers = [{{ dns_servers | default([]) | map('quote') | join(', ') }}]
{% endif %}

# List of allowed IP subnets for peer traffic.
# Only used in server/hybrid mode.
# Default: ['10.255.0.0/24']
{% if allowed_ips | default(['10.255.0.0/24']) | length > 0 %}
allowed_ips = [{{ allowed_ips | default(['10.255.0.0/24']) | map('quote') | join(', ') }}]
{% endif %}

# Seconds between keep-alive packets.
# 0 disables keep-alive.
# Default: 10
keepalive_interval = {{ keepalive_interval | default(10) }}

# Seconds to wait before aborting a handshake.
# Default: 60
handshake_timeout = {{ handshake_timeout | default(60) }}

# List of trusted peers with static configuration.
{% for peer in peers | default([]) %}
# Peer block for ID: {{ peer.id }}
# Public key of the peer
["{{ peer.id }}"]
  public_key = "{{ peer.public_key }}"

  # Optional: Fixed IP address assigned to this peer
  {% if peer.ip is defined %}
  ip = "{{ peer.ip }}"
  {% endif %}

  # Optional: Hostname or IP:port for outgoing connections
  # Only in client/hybrid mode
  {% if peer.address is defined %}
  address = "{{ peer.address }}"
  {% endif %}

  # Optional: Pre-shared key for this peer
  # Only for 'psk' method
  {% if peer.psk is defined %}
  pre_shared_key = "{{ peer.psk }}"
  {% endif %}

{% endfor %}