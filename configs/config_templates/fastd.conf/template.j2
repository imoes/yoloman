# fastd configuration file — manages VPN peers, protocols, and interface settings

# Interface name for the VPN tunnel
interface = "{{ interface }}"

# Operating mode: client, server, or hybrid
mode = "{{ mode }}"

# Method used for peer authentication and key exchange
method = "{{ method }}"

# Path to the directory containing peer public keys (for 'manual' or 'password' method)
{% if peers_dir is defined %}peers_dir = "{{ peers_dir }}"{% endif %}

# Path to the file containing pre-shared keys (for 'psk' method)
{% if pre_shared_key_file is defined %}pre_shared_key_file = "{{ pre_shared_key_file }}"{% endif %}

# Path to the directory containing peer secret keys (for 'handshake' method)
{% if secrets_dir is defined %}secrets_dir = "{{ secrets_dir }}"{% endif %}

# Optional: local IP address to bind to (e.g., for bind_address)
{% if bind_address is defined %}bind_address = "{{ bind_address }}"{% endif %}

# Optional: UDP port to listen on (only in server/hybrid mode)
{% if port is defined %}port = {{ port }}{% endif %}

# Optional: upper MTU for the tunnel interface
{% if mtu is defined %}mtu = {{ mtu }}{% endif %}

# Optional: log level: debug, info, notice, warning, error, critical, alert, emergency
{% if log_level is defined %}log_level = "{{ log_level }}"{% endif %}

# Optional: runtime user to drop privileges to
{% if user is defined %}user = "{{ user }}"{% endif %}

# Optional: runtime group to drop privileges to
{% if group is defined %}group = "{{ group }}"{% endif %}

# Optional: DNS servers to push to peers (only in server/hybrid mode)
{% if dns_servers is defined %}dns_servers = [{{ dns_servers | map('quote') | join(', ') }}]{% endif %}

# Optional: Allowed IP ranges for peers (only in server/hybrid mode)
{% if allowed_ips is defined %}allowed_ips = [{{ allowed_ips | map('quote') | join(', ') }}]{% endif %}

# Optional: Keep-alive interval in seconds (0 disables keep-alive)
{% if keepalive_interval is defined %}keepalive_interval = {{ keepalive_interval }}{% endif %}

# Optional: Handshake timeout in seconds
{% if handshake_timeout is defined %}handshake_timeout = {{ handshake_timeout }}{% endif %}

# Optional: Peer-specific configuration blocks
{% for peer in peers %}# Peer: {{ peer.name }} — configured with ID {{ peer.id }}
["{{ peer.id }}"]
  # Public key of the peer
  public_key = "{{ peer.public_key }}"

  # Optional: Fixed IP address assigned to this peer
  {% if peer.ip is defined %}ip = "{{ peer.ip }}"{% endif %}

  # Optional: Hostname or IP:port for outgoing connections (only in client/hybrid mode)
  {% if peer.address is defined %}address = "{{ peer.address }}"{% endif %}

  # Optional: Pre-shared key for this peer (for 'psk' method)
  {% if peer.psk is defined %}pre_shared_key = "{{ peer.psk }}"{% endif %}

{% endfor %}
