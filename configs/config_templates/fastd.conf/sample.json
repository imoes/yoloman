{
  "interface": "vpn0",
  "mode": "server",
  "method": "handshake",
  "secrets_dir": "/etc/fastd/secrets",
  "bind_address": "0.0.0.0",
  "port": 9696,
  "mtu": 1420,
  "log_level": "warning",
  "user": "fastd",
  "group": "fastd",
  "dns_servers": [
    "10.255.0.1"
  ],
  "allowed_ips": [
    "10.255.0.0/24"
  ],
  "keepalive_interval": 15,
  "handshake_timeout": 90,
  "peers": [
    {
      "id": "abc123",
      "name": "branch-office",
      "public_key": "jv76t...[truncated]",
      "ip": "10.255.0.2",
      "address": "branch.example.com:9696"
    },
    {
      "id": "def456",
      "name": "remote-user",
      "public_key": "kx92b...[truncated]",
      "ip": "10.255.0.3"
    }
  ]
}
