#
# Tempest CI Live Booter Apache Configuration
#
# This configuration serves the static content for the Tempest CI Live Booter.
# It is auto-generated from the package defaults.

# Document root directory for the Tempest CI live booter web interface.
# Default: /var/lib/tempest-live-booter
Alias /tempest-ci {{ tempest_booter_docroot | default('/var/lib/tempest-live-booter') }}

<Directory {{ tempest_booter_docroot | default('/var/lib/tempest-live-booter') }}>
    # Allow access to all resources in this directory
    Require all granted
</Directory>
