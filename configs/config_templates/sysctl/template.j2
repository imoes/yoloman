# Disable IPv6 if requested
{% if disable_ipv6 %}net.ipv6.conf.all.disable_ipv6 = 1
{% endif %}
# Disable IPv6 for loopback
{% if disable_ipv6 %}net.ipv6.conf.lo.disable_ipv6 = 1
{% endif %}
# Disable source routing
net.ipv4.conf.all.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
# Disable ICMP redirect acceptance
net.ipv4.conf.all.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
# Disable ICMP redirects (send)
net.ipv4.conf.all.send_redirects = 0
# Disable IP spoofing protection
net.ipv4.conf.all.rp_filter = 1
# Enable TCP SYN cookie protection
net.ipv4.tcp_syncookies = 1
# Enable kernel logging of suspicious packets (log_suspicious)
{% if log_suspicious_packets %}net.ipv4.conf.all.log_martians = 1
{% endif %}
# Ignore ICMP broadcasts
net.ipv4.icmp_echo_ignore_broadcasts = 1
# Ignore bad ICMP errors
net.ipv4.icmp_ignore_bogus_error_responses = 1
# Enable RFC 1337 fix (time-wait assassination)
net.ipv4.tcp_rfc1337 = 1
# Limit core dumps (prevents info leakage)
{% if core_pattern %}kernel.core_pattern = {{ core_pattern }}
{% endif %}# Disable core dumps by default (security hardening)
{% if disable_core_dumps %}fs.suid_dumpable = 0
{% endif %}
# Restrict kernel log access
kernel.dmesg_restrict = 1
# Enable STIG-compliant SELinux/AppArmor enforcement hints
{% if enforce_selinux %}security.selinux = 1
{% endif %}
# Prevent non-root user processes from ptracing init
kernel.yama.ptrace_scope = 1
# Enable memory protection (ASLR + stack guard)
{% if harden_memory %}vm.mmap_min_addr = 65536
vm.mmap_rnd_bits = 32
{% endif %}
# Rate-limit kernel messages
kernel.printk = 4 4 1 7
# Hide kernel symbols
kernel.kptr_restrict = 2
# Restrict user namespaces (prevents container escape vulnerabilities)
{% if disable_userns %}user.max_user_namespaces = 0
{% endif %}
# Enable stack protector hardening
{% if stack_protector %}kernel.stack_protector = 1
{% endif %}
# Protect against time-wait assassination
{% if tcp_tw_reuse %}net.ipv4.tcp_tw_reuse = 0
{% else %}net.ipv4.tcp_tw_reuse = 1
{% endif %}
# Max SYN backlog (mitigates SYN flood)
net.ipv4.tcp_max_syn_backlog = 2048
# SYN cookies threshold (threshold before enabling SYN cookies)
net.ipv4.tcp_synack_retries = 2
# Reduce FIN timeout to limit DoS window
net.ipv4.tcp_fin_timeout = 15
# Reduce keepalive time to detect dead connections faster
net.ipv4.tcp_keepalive_time = 600
# Enable BPF JIT hardening (if available)
{% if bpf_jit_harden %}net.core.bpf_jit_harden = 2
{% endif %}
# Restrict KEXEC (kernel loading)
kernel.kexec_load_disabled = 1