# Configuration for ultimateultimateguitar CLI

# Number of semitones to transpose chords. Supports positive (up) or negative (down) integers.
# Defaults to 0 (no transpose) if not specified.
transpose = {{ transpose | default(0) }}

# URL of a specific song to load immediately. If not provided, the tool enters interactive search mode.
# Defaults to an empty string (absent) if not specified.
initial_url = {{ initial_url | default('') }}