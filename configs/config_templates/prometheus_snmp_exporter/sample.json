{
  "scan_interval": 60,
  "timeout": 15,
  "retries": 2,
  "modules": [
    {
      "name": "generic",
      "version": "2c",
      "community": "public",
      "mibs": [
        "IF-MIB",
        "IP-MIB"
      ],
      "walk": [
        "1.3.6.1.2.1"
      ]
    },
    {
      "name": "cisco",
      "version": "2c",
      "community": "ro_snmp",
      "mibs": [
        "CISCO-PROCESS-MIB",
        "CISCO-STACK-MIB"
      ],
      "walk": [
        "1.3.6.1.4.1.9"
      ]
    },
    {
      "name": "linux",
      "version": "2c",
      "community": "public",
      "mibs": [
        "UCD-SNMP-MIB",
        "HOST-RESOURCES-MIB"
      ],
      "walk": [
        "1.3.6.1.4.1.2021",
        "1.3.6.1.2.1.25"
      ]
    },
    {
      "name": "snmpv3_device",
      "version": "3",
      "auth_level": "authPriv",
      "auth_name": "snmpuser",
      "priv_name": "snmpuser",
      "auth_protocol": "SHA",
      "priv_protocol": "AES",
      "mibs": [
        "IF-MIB"
      ],
      "walk": [
        "1.3.6.1.2.1"
      ]
    }
  ]
}
