# PAM access control configuration
# Format: {permission}:{users}:{origins}
# Permission: '+' for allow, '-' for deny
# Users: usernames, group names (prefixed with '@'), or special values like 'ALL', 'LOCAL', 'REMOTE'
# Origins: hostnames, IP addresses/networks (CIDR or dotted), or special values like 'ALL', 'LOCAL', 'REMOTE', 'NONE'
#
# Order matters: first matching rule wins
{% for rule in rules %}# {{ rule.comment | default('') | trim | replace('
', ' ') }}
{{ '+' if rule.allow else '-' }}: {{ rule.users | join(', ') }}: {{ rule.origins | join(', ') }}{% endfor %}