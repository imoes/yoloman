{
  "rules": [
    {
      "comment": "Allow root login only from console (local)",
      "allow": true,
      "users": [
        "root"
      ],
      "origins": [
        "LOCAL"
      ]
    },
    {
      "comment": "Deny all access for users in 'nologin' group",
      "allow": false,
      "users": [
        "@nologin"
      ],
      "origins": [
        "ALL"
      ]
    },
    {
      "comment": "Allow system administrators from internal network",
      "allow": true,
      "users": [
        "@admin",
        "backup",
        "monitor"
      ],
      "origins": [
        "10.0.0.0/8",
        "192.168.1.0/24",
        "localhost"
      ]
    },
    {
      "allow": false,
      "users": [
        "ALL"
      ],
      "origins": [
        "ALL"
      ]
    }
  ]
}
