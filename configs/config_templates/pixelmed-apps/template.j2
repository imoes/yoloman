# ==============================================================================
# DicomImageViewer Configuration Properties
# ==============================================================================
# This file configures the PixelMed DicomImageViewer application.
# It is a standard Java properties file.
#
# Location:
#   - Windows 2000:   C:\Documents and Settings\username\
#   - Windows 98:     C:\Windows\
#   - Mac OS X:       /Users/username (i.e. ~/)
#   - Solaris:        ~/
#   - Linux:          ~/
#
# File Name:
#   .com.pixelmed.display.DicomImageViewer.properties
#
# ==============================================================================

# Network.DynamicConfigurationDebugLevel
# Debug level for network dynamic configuration. 0 for silent, >0 for verbose.
Network.DynamicConfigurationDebugLevel={{ network_dynamic_configuration_debug_level | default('0') }}

# Application.DatabaseFileName
# Path where database support files are stored.
Application.DatabaseFileName={{ application_database_file_name | default('/tmp/testserverdb') }}

# Application.SavedImagesFolderName
# Path where images stored in the database are saved.
Application.SavedImagesFolderName={{ application_saved_images_folder_name | default('/tmp/testserverimages') }}

# Application.DatabaseServerName
# Name used for external TCP access to the database.
Application.DatabaseServerName={{ application_database_server_name | default('testserverdb') }}

# Display.FullScreen
# True if full-screen rather than tiled window mode.
Display.FullScreen={{ display_full_screen | default('false') }}

# Dicom.StorageSCUCompressionLevel
# Compression level for DICOM storage SCU. 0=none, 1=deflate, 2=deflate+bzip2.
Dicom.StorageSCUCompressionLevel={{ dicom_storage_scu_compression_level | default('2') }}

# Dicom.ListeningPort
# Port for the DicomImageViewer application to listen on for incoming associations.
Dicom.ListeningPort={{ dicom_listening_port | default('4006') }}

# Dicom.CalledAETitle
# AE Title the application calls itself when accepting an association.
Dicom.CalledAETitle={{ dicom_called_ae_title | default('LOCALHOST') }}

# Dicom.CallingAETitle
# AE Title the application calls itself when initiating an association.
Dicom.CallingAETitle={{ dicom_calling_ae_title | default('LOCALHOST') }}

# Dicom.PrimaryDeviceType
# Type of the primary device (e.g., WSD, ARCHIVE).
Dicom.PrimaryDeviceType={{ dicom_primary_device_type | default('WSD') }}

# Dicom.RemoteAEs
# Space or comma separated list of all available remote AE names.
# Each name in this list corresponds to a block of configuration below (e.g., Dicom.RemoteAEs.<name>.*).
Dicom.RemoteAEs={{ dicom_remote_aes | default('localhost remote1 remote2') }}

# Dicom.CurrentlySelectedStorageTargetAE
# Default storage target AE name.
Dicom.CurrentlySelectedStorageTargetAE={{ dicom_currently_selected_storage_target_ae | default('remote1') }}

# Dicom.CurrentlySelectedQueryTargetAE
# Default remote query target AE name.
Dicom.CurrentlySelectedQueryTargetAE={{ dicom_currently_selected_query_target_ae | default('remote1') }}

# ==============================================================================
# Remote AE Configurations
# ==============================================================================
# For each AE name listed in Dicom.RemoteAEs, define the following properties:
#   - CalledAETitle
#   - HostNameOrIPAddress
#   - Port
#   - QueryModel (optional, default STUDYROOT)

# --- Remote AE: localhost ---
# Called AE Title for the 'localhost' remote AE entry.
Dicom.RemoteAEs.localhost.CalledAETitle={{ dicom_remote_aes_localhost_called_ae_title | default('LOCALHOST') }}
# Hostname or IP Address for the 'localhost' remote AE entry.
Dicom.RemoteAEs.localhost.HostNameOrIPAddress={{ dicom_remote_aes_localhost_hostname_or_ip_address | default('127.0.0.1') }}
# Port for the 'localhost' remote AE entry.
Dicom.RemoteAEs.localhost.Port={{ dicom_remote_aes_localhost_port | default('4006') }}
# QueryModel for localhost (default STUDYROOT).
Dicom.RemoteAEs.localhost.QueryModel=STUDYROOT

# --- Remote AE: remote1 ---
# Called AE Title for the 'remote1' remote AE entry.
Dicom.RemoteAEs.remote1.CalledAETitle={{ dicom_remote_aes_remote1_called_ae_title | default('REMOTE1') }}
# Hostname or IP Address for the 'remote1' remote AE entry.
Dicom.RemoteAEs.remote1.HostNameOrIPAddress={{ dicom_remote_aes_remote1_hostname_or_ip_address | default('10.217.142.23') }}
# Port for the 'remote1' remote AE entry.
Dicom.RemoteAEs.remote1.Port={{ dicom_remote_aes_remote1_port | default('3010') }}
# QueryModel for remote1 (default STUDYROOT).
Dicom.RemoteAEs.remote1.QueryModel=STUDYROOT

# --- Remote AE: remote2 ---
# Called AE Title for the 'remote2' remote AE entry.
Dicom.RemoteAEs.remote2.CalledAETitle={{ dicom_remote_aes_remote2_called_ae_title | default(' REMOTE2') }}
# Hostname or IP Address for the 'remote2' remote AE entry.
Dicom.RemoteAEs.remote2.HostNameOrIPAddress={{ dicom_remote_aes_remote2_hostname_or_ip_address | default('remote2.organization.com') }}
# Port for the 'remote2' remote AE entry.
Dicom.RemoteAEs.remote2.Port={{ dicom_remote_aes_remote2_port | default('4006') }}
# QueryModel for remote2 (default STUDYROOT).
Dicom.RemoteAEs.remote2.QueryModel=STUDYROOT
