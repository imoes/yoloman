{
  "general": {
    "enabled": true,
    "pidfile": "/run/mailnag/mailnag.pid",
    "enable_notifications": true,
    "enable_sounds": true,
    "sound_file": "/usr/share/sounds/mailnag/newmail.ogg",
    "check_interval": 180,
    "max_accounts": 5
  },
  "accounts": [
    {
      "name": "personal_gmail",
      "type": "imap",
      "hostname": "imap.gmail.com",
      "port": 993,
      "use_ssl": true,
      "use_starttls": false,
      "username": "user@example.com",
      "password_backend": "keyring",
      "folder": "INBOX",
      "enabled": true,
      "icon": "/usr/share/icons/personal.svg"
    },
    {
      "name": "work_mail",
      "type": "imap",
      "hostname": "imap.company.com",
      "port": 993,
      "use_ssl": true,
      "use_starttls": false,
      "username": "john.doe@company.com",
      "password_backend": "keyring",
      "folder": "INBOX",
      "enabled": true,
      "icon": "/usr/share/icons/work.svg"
    }
  ]
}
