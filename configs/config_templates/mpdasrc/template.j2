[mpd]
# Hostname or IP address of MPD server
host = {{ mpd_host }}
# Port MPD server listens on
port = {{ mpd_port }}
# MPD password (leave empty if none)
password = {{ mpd_password }}

# Path to MPD music directory (optional; used for cover art lookup)
# music_directory = {{ mpd_music_directory }}

[mpd]
# Time (in seconds) to wait for connection to MPD server
connection_timeout = {{ connection_timeout }}

[mpd]
# Maximum number of songs to fetch from MPD history
max_history_songs = {{ max_history_songs }}

[mpd]
# Whether to show song progress in status line
show_progress = {{ show_progress }}

[mpd]
# Whether to automatically start playback on track change (if supported by player)
auto_play = {{ auto_play }}

[mpd]
# Whether to suppress output when MPD is paused
mute_on_pause = {{ mute_on_pause }}

[mpd]
# List of output devices to track (e.g., for notifications)
{% for output in outputs %}output_{{ loop.index0 }}_name = {{ output.name }}
output_{{ loop.index0 }}_type = {{ output.type }}
{% endfor %}