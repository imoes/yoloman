# ==============================================================================
# ifupdown-extra: Static Route Configuration
# ==============================================================================
#
# This file configures static routes for the ifupdown-extra package.
# It is read by:
#   - /etc/network/if-up.d/20static-routes (per-interface routing)
#   - /etc/init.d/networking-routes (global/all-interface routing)
#
# FORMAT:
#   <network> <netmask> <gateway> <interface>
#
# NOTES:
#   - DO NOT configure default gateway routes here; use the 'gateway'
#     directive in /etc/network/interfaces instead.
#   - Use 'any' as the interface name to apply routes to all interfaces.
#   - Use 'reject' as the gateway to install a blackhole/reject route.
#
# ==============================================================================

{% if routes is defined and routes is iterable %}
{#
  routes: List of static route definitions.
  Each item is a dictionary with keys: network, netmask, gateway, interface.
#}
{% for route in routes %}
{# Network address/subnet (e.g., 192.168.1.0) #}
{{ route.network | default('') }}
{# Subnet mask (e.g., 255.255.255.0 or CIDR notation depending on parser, but this script expects mask) #}
{{ route.netmask | default('255.255.255.0') }}
{# Gateway IP or action (e.g., 10.0.0.1 or 'reject') #}
{{ route.gateway | default('') }}
{# Target interface (e.g., eth0 or 'any') #}
{{ route.interface | default('any') }}
{% endfor %}
{% else %}
{# No routes defined #}
# No static routes configured.
{% endif %}