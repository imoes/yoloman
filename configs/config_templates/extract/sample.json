{
  "libraries": [
    "jpeg",
    "png",
    "mp3",
    "pdf"
  ],
  "use_only_specified_libraries": true,
  "output_format": "grep",
  "verbosity": 2,
  "include_keyword_types": [
    "comment",
    "mimetype"
  ],
  "exclude_keyword_types": [
    "author"
  ],
  "in_process": false,
  "in_memory": false
}
