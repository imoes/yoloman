{
  "producer": {
    "queue_topic": "designate",
    "workers": 2,
    "max_messages": 1000,
    "heartbeat_interval": 10,
    "rpc_conn_timeout": 60,
    "rabbit_hosts": [
      "rm1.example.com",
      "rm2.example.com"
    ],
    "rabbit_port": 5672,
    "rabbit_user": "designate",
    "rabbit_password": "secret123",
    "rabbit_virtual_host": "/designate",
    "rabbit_use_ssl": false,
    "rabbit_retry_interval": 1,
    "rabbit_retry_backoff": 2,
    "rabbit_retry_max_delay": 30,
    "storage_driver": "sqlalchemy",
    "database_connection": "postgresql+psycopg2://designate:supersecret@db.example.com/designate",
    "database_pool": true,
    "database_pool_size": 20,
    "database_pool_min_size": 5,
    "database_pool_timeout": 45,
    "database_pool_recycle": 7200,
    "log_level": "INFO",
    "log_format": "%(asctime)s %(levelname)s [%(name)s] %(message)s",
    "log_date_format": "%Y-%m-%d %H:%M:%S",
    "log_file": "/var/log/designate/producer.log"
  }
}
