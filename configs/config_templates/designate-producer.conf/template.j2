[producer]
# Queue topic for receiving messages to be processed
queue_topic = {{ producer.queue_topic }}

# Number of workers for processing messages
workers = {{ producer.workers | default(1) }}

# Maximum number of messages to process before worker restart
max_messages = {{ producer.max_messages | default(0) }}

# Heartbeat interval in seconds (0 = disable)
heartbeat_interval = {{ producer.heartbeat_interval | default(10) }}

# RPC connection timeout in seconds
rpc_conn_timeout = {{ producer.rpc_conn_timeout | default(60) }}

# RabbitMQ host(s) for message queue (comma-separated)
rabbit_hosts = {{ producer.rabbit_hosts | join(', ') }}

# RabbitMQ port
rabbit_port = {{ producer.rabbit_port }}

# RabbitMQ user
rabbit_user = {{ producer.rabbit_user }}

# RabbitMQ password
rabbit_password = {{ producer.rabbit_password }}

# RabbitMQ virtual host
rabbit_virtual_host = {{ producer.rabbit_virtual_host | default('/') }}

# Enable SSL for RabbitMQ connection
rabbit_use_ssl = {{ producer.rabbit_use_ssl | string | lower }}

# Retry interval for failed connections (seconds)
rabbit_retry_interval = {{ producer.rabbit_retry_interval | default(1) }}

# Maximum number of connection retries (0 = unlimited)
rabbit_retry_backoff = {{ producer.rabbit_retry_backoff | default(2) }}

# Maximum retry delay (seconds)
rabbit_retry_max_delay = {{ producer.rabbit_retry_max_delay | default(30) }}

# Storage driver to use (e.g., 'sqlalchemy')
storage_driver = {{ producer.storage_driver }}

# Database connection string (SQLAlchemy format)
database_connection = {{ producer.database_connection }}

# Enable database pooling
 database_pool = {{ producer.database_pool | default(false) | string | lower }}

# Maximum database pool size
 database_pool_size = {{ producer.database_pool_size | default(10) }}

# Minimum database pool size
 database_pool_min_size = {{ producer.database_pool_min_size | default(2) }}

# Pool timeout in seconds
 database_pool_timeout = {{ producer.database_pool_timeout | default(30) }}

# Pool recycle interval in seconds (0 = disable)
 database_pool_recycle = {{ producer.database_pool_recycle | default(3600) }}

# Logging configuration
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
log_level = {{ producer.log_level | default('INFO') }}

# Log format string
log_format = {{ producer.log_format | default('%(asctime)s %(levelname)s [%(name)s] %(message)s') }}

# Log date format
log_date_format = {{ producer.log_date_format | default('%Y-%m-%d %H:%M:%S') }}

# Log file path (empty = stderr)
log_file = {{ producer.log_file | default('') }}
