# Configuration for /etc/init.d/amule-daemon
#
# This file is managed by Ansible. Do NOT edit manually.
# It provides the runtime environment variables for the amule-daemon init script.
#
# Variables defined here:
#   AMULED_USER - System user account under which the amule-daemon process runs.
#   AMULED_HOME - Alternative home directory for the daemon's configuration and data.

# AMULED_USER: User account under which the amule-daemon service should run.
# Must be non-empty for the init.d script to start the service.
# If empty, the init script will refuse to start the daemon for security reasons.
AMULED_USER="{{ AMULED_USER | default('') }}"

# AMULED_HOME: Alternative home directory for the amule daemon.
# The daemon will use $AMULED_HOME/.aMule as its data directory.
# Leave empty to use the default location (typically /var/lib/amule or similar,
# depending on the package defaults).
AMULED_HOME="{{ AMULED_HOME | default('') }}"