# Configuration for /etc/init.d/amule-daemon
# This script controls the aMule daemon service.
# Variables are sourced by the init.d script to configure the daemon's runtime environment.

# User account under which the amule-daemon service should run.
# Must be non-empty for the init.d script to start the service.
# Default: amule
AMULED_USER="{{ AMULED_USER | default('amule') }}"

# Alternative home directory for the amule daemon.
# The daemon will use $AMULED_HOME/.aMule as its data directory.
# Default: /var/lib/amule
AMULED_HOME="{{ AMULED_HOME | default('/var/lib/amule') }}"
