# Beanstalkd Configuration Template
# Managed by Ansible — do not edit manually.
# This template configures the beanstalkd job queue daemon.
# It is self-documenting: every setting is described in the comments above.

## Listen address for beanstalkd
# The IP address or hostname for the primary listen socket.
# Set to '0.0.0.0' to listen on all interfaces, or '127.0.0.1' for localhost only.
BEANSTALKD_LISTEN_ADDR={{ listen_host | default('127.0.0.1') }}

## Listen port for beanstalkd
# The TCP port number for the primary listen socket.
# Standard beanstalkd port is 11300.
BEANSTALKD_LISTEN_PORT={{ listen_port | default(11300) }}

# Additional beanstalkd options can be passed via this variable.
# Uncomment and edit the line below to enable features like job persistence.
# For example, to enable disk-based job storage:
#
# Data directory for persistent job storage
# Directory to persist jobs to disk (enables durability).
# Empty string disables persistence.
#BEANSTALKD_EXTRA="-b {{ data_dir | default('/var/lib/beanstalkd') }}"