# Listen on the specified host and port
LISTEN={{ listen_host }}:{{ listen_port }}

# Maximum size (in bytes) of a job payload
MAX-JOB-SIZE={{ max_job_size }}

# Run as the specified user (must exist)
USER={{ user }}

# Maximum number of connections allowed (0 = unlimited)
MAX-CONNECTIONS={{ max_connections }}

# Timeout (in seconds) for job operations
TIMEOUT={{ timeout }}

# PID file location (set to empty string to disable PID file)
PIDFILE={{ pidfile }}

# Log to the specified file (or use '-' for stdout)
LOG={{ log_file }}

# Use the specified data directory for persistence (empty = disable persistence)
DATA-DIR={{ data_dir }}

# Enable or disable binary protocol
USE-BINARY-PROTOCOL={{ use_binary_protocol | lower }}

# Use the specified slab size for memory allocation
SLAB-INCREMENT={{ slab_increment }}

{% if watch_listens %}
# Listen on additional addresses (one per line)
{% for listen in watch_listens %}# Listen on {{ listen.host }}:{{ listen.port }}
LISTEN={{ listen.host }}:{{ listen.port }}
{% endfor %}
{% endif %}
