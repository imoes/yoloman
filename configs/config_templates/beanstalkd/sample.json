{
  "listen_host": "0.0.0.0",
  "listen_port": 11300,
  "max_job_size": 65535,
  "user": "beanstalkd",
  "max_connections": 2048,
  "timeout": 60,
  "pidfile": "/run/beanstalkd/beanstalkd.pid",
  "log_file": "/var/log/beanstalkd.log",
  "data_dir": "/var/lib/beanstalkd",
  "use_binary_protocol": false,
  "slab_increment": 50,
  "watch_listens": [
    {
      "host": "::",
      "port": 11300
    }
  ]
}
