{
  "output_file": {
    "type": "string",
    "default": "",
    "description": "Output PDF file path. Leave empty to use stdout."
  },
  "input_files": {
    "type": "list",
    "default": [],
    "description": "List of input image file paths to convert."
  },
  "pdfa_enabled": {
    "type": "bool",
    "default": false,
    "description": "Output a PDF/A-1b compliant document."
  },
  "page_size": {
    "type": "string",
    "default": "A4",
    "description": "Page size in format LxL (e.g., 210mmx297mm) or shorthand (e.g., A4, Letter^T)."
  },
  "fit_mode": {
    "type": "string",
    "default": "into",
    "description": "Fit strategy: into, fill, exact, shrink, enlarge.",
    "enum": [
      "into",
      "fill",
      "exact",
      "shrink",
      "enlarge"
    ]
  },
  "border": {
    "type": "string",
    "default": "0pt",
    "description": "Minimal border between image and page border (e.g., 2cm or 2cm:2.5cm)."
  },
  "rotation": {
    "type": "string",
    "default": "auto",
    "description": "Image rotation: auto, none, 0, 90, 180, 270, ifvalid.",
    "enum": [
      "auto",
      "none",
      "0",
      "90",
      "180",
      "270",
      "ifvalid"
    ]
  },
  "colorspace": {
    "type": "string",
    "default": "",
    "description": "Force PIL colorspace (e.g., RGB, L, CMYK). Leave empty for auto-detection.",
    "enum": [
      "RGB",
      "L",
      "1",
      "CMYK",
      "CMYK;I"
    ]
  },
  "title": {
    "type": "string",
    "default": "",
    "description": "PDF metadata title."
  },
  "author": {
    "type": "string",
    "default": "",
    "description": "PDF metadata author."
  },
  "subject": {
    "type": "string",
    "default": "",
    "description": "PDF metadata subject."
  },
  "keywords": {
    "type": "list",
    "default": [],
    "description": "List of keywords for PDF metadata."
  },
  "creationdate": {
    "type": "string",
    "default": "",
    "description": "PDF metadata creation date."
  },
  "moddate": {
    "type": "string",
    "default": "",
    "description": "PDF metadata modification date."
  },
  "viewer_initial_page": {
    "type": "number",
    "default": 1,
    "description": "Page number to initially display (1-based)."
  },
  "viewer_magnification": {
    "type": "string",
    "default": "",
    "description": "Zoom level: fit, fith, fitbh, or float value.",
    "enum": [
      "fit",
      "fith",
      "fitbh"
    ]
  },
  "viewer_page_layout": {
    "type": "string",
    "default": "",
    "description": "Page layout: single, onecolumn, twocolumnright, twocolumnleft, twopageright, twopageleft.",
    "enum": [
      "single",
      "onecolumn",
      "twocolumnright",
      "twocolumnleft",
      "twopageright",
      "twopageleft"
    ]
  },
  "include_thumbnails": {
    "type": "bool",
    "default": false,
    "description": "Include thumbnails as separate pages for multi-frame images."
  },
  "nodate": {
    "type": "bool",
    "default": false,
    "description": "Suppress timestamps in output for determinism."
  },
  "engine": {
    "type": "string",
    "default": "internal",
    "description": "PDF engine to use: internal, pikepdf, pdfrw.",
    "enum": [
      "internal",
      "pikepdf",
      "pdfrw"
    ]
  },
  "pillow_limit_break": {
    "type": "bool",
    "default": false,
    "description": "Disable Pillow's max pixel limit safety check."
  },
  "auto_orient": {
    "type": "bool",
    "default": false,
    "description": "Swap page dimensions to match image orientation if both are fixed."
  },
  "crop_border": {
    "type": "string",
    "default": "",
    "description": "CropBox border from MediaBox."
  },
  "bleed_border": {
    "type": "string",
    "default": "",
    "description": "BleedBox border from MediaBox."
  },
  "trim_border": {
    "type": "string",
    "default": "",
    "description": "TrimBox border from MediaBox."
  },
  "art_border": {
    "type": "string",
    "default": "",
    "description": "ArtBox border from MediaBox."
  },
  "viewer_panes": {
    "type": "string",
    "default": "",
    "description": "Side panes to show: outlines or thumbs.",
    "enum": [
      "outlines",
      "thumbs"
    ]
  },
  "viewer_center_window": {
    "type": "bool",
    "default": false,
    "description": "Center the PDF viewer window."
  },
  "viewer_fullscreen": {
    "type": "bool",
    "default": false,
    "description": "Open PDF in fullscreen mode."
  },
  "viewer_fit_window": {
    "type": "bool",
    "default": false,
    "description": "Resize viewer window to fit page size."
  },
  "first_frame_only": {
    "type": "bool",
    "default": false,
    "description": "Only convert the first frame of multi-frame images."
  },
  "producer": {
    "type": "string",
    "default": "",
    "description": "PDF metadata producer. Empty uses default."
  },
  "creator": {
    "type": "string",
    "default": "",
    "description": "PDF metadata creator."
  }
}
