#!/bin/sh

#
# Self-documenting template for the installation-birthday script.
# Variable: verbosity (default: 0)
# Description: Verbosity level for the installation-birthday command (0=normal, higher values increase logging detail).
#

# Check if the installation-birthday binary exists and is executable;
# exit silently if not to allow idempotent runs.
[ -x /usr/bin/installation-birthday ] || exit 0

# Execute the installation-birthday command with the configured verbosity.
exec /usr/bin/installation-birthday --verbosity={{ verbosity | default(0) }}