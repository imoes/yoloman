#
# This file controls which servers may be managed by the cachemgr.cgi script.
# It lists allowed hostnames or addresses for cache management access.
#
# Format: One entry per line. Each entry can be a hostname (with optional :port)
# or an IP address.
# Examples:
#   localhost
#   192.168.1.100
#   cache.example.com:3128
#
# Wildcards (*) are supported in hostnames.
# Specifying :port is optional; if omitted, the default proxy port is assumed.
# :all or :* can be used to match any port on the target server.

{% for host in allowed_hosts | default(['localhost']) %}
{{ host }}
{% endfor %}