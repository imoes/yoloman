{
  "port": 9090,
  "target": "/var/servefile/uploads",
  "list_dir": true,
  "upload": true,
  "max_upload_size": 51200,
  "ssl": true,
  "ssl_key": "/etc/servefile/key.pem",
  "ssl_cert": "/etc/servefile/cert.pem",
  "auth": "admin:secret",
  "realm": "Servefile Admin",
  "tar": false,
  "tar_compression": "none",
  "ipv4_only": true,
  "ipv6_only": false
}
