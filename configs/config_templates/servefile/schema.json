{
  "port": {
    "type": "number",
    "default": 8080,
    "description": "Port to listen on"
  },
  "target": {
    "type": "string",
    "default": "/tmp/servefile",
    "description": "The file or directory to serve"
  },
  "list_dir": {
    "type": "bool",
    "default": false,
    "description": "Show directory indexes and allow access to all subdirectories"
  },
  "upload": {
    "type": "bool",
    "default": false,
    "description": "Enable uploads to a given directory"
  },
  "max_upload_size": {
    "type": "number",
    "default": 10240,
    "description": "Limit upload size in kB"
  },
  "ssl": {
    "type": "bool",
    "default": false,
    "description": "Enable SSL"
  },
  "ssl_key": {
    "type": "string",
    "default": "",
    "description": "Key file to use for SSL"
  },
  "ssl_cert": {
    "type": "string",
    "default": "",
    "description": "Certfile to use for SSL"
  },
  "auth": {
    "type": "string",
    "default": "",
    "description": "Set user and password for HTTP basic authentication (user:password)"
  },
  "realm": {
    "type": "string",
    "default": "Restricted",
    "description": "Set a realm for HTTP basic authentication"
  },
  "tar": {
    "type": "bool",
    "default": false,
    "description": "Enable on the fly tar creation"
  },
  "tar_compression": {
    "type": "string",
    "default": "gzip",
    "description": "Compression method for tar (none, gzip, bzip2, xz)",
    "enum": [
      "none",
      "gzip",
      "bzip2",
      "xz"
    ]
  },
  "ipv4_only": {
    "type": "bool",
    "default": false,
    "description": "Listen on IPv4 only"
  },
  "ipv6_only": {
    "type": "bool",
    "default": false,
    "description": "Listen on IPv6 only"
  }
}
