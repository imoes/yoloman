# Servefile Configuration Template
# Generated by Ansible. See servefile(1) for full documentation.
# This file configures the servefile simple HTTP file server.

###############################################################################
# Network & Service Binding
###############################################################################

# Port to listen on. The TCP port where servefile accepts incoming HTTP connections.
# Default: 8080
port = {{ port | default(8080) }}

# Listen on IPv4 only. If true, the server binds exclusively to IPv4 addresses, ignoring IPv6 sockets.
# Default: false
ipv4_only = {{ ipv4_only | default(false) | lower }}

# Listen on IPv6 only. If true, the server binds exclusively to IPv6 addresses, ignoring IPv4 sockets.
# Default: false
ipv6_only = {{ ipv6_only | default(false) | lower }}

###############################################################################
# File Serving & Storage
###############################################################################

# The file or directory to serve. The local filesystem path that servefile exposes via HTTP.
# If pointing to a directory, it serves its contents; if a file, it serves that file.
# Default: /tmp/servefile
target = {{ target | default('/tmp/servefile') }}

# Show directory indexes and allow access to all subdirectories.
# When true, if the target is a directory, servefile generates an HTML index
# listing all files and subdirectories, allowing users to browse and download them.
# Default: false
list_dir = {{ list_dir | default(false) | lower }}

# Enable uploads to a given directory.
# When true, allows clients to upload files to the specified target directory.
# Ensure permissions are configured correctly on the host filesystem to allow writes.
# Default: false
upload = {{ upload | default(false) | lower }}

# Limit upload size in kB. Limits the size of individual upload requests in kilobytes.
# Requests exceeding this limit will be rejected.
# Default: 10240
max_upload_size = {{ max_upload_size | default(10240) }}

###############################################################################
# Security & Authentication
###############################################################################

# Enable SSL. When true, enables HTTPS support. Requires ssl_key and ssl_cert to be set.
# Default: false
ssl = {{ ssl | default(false) | lower }}

# Key file to use for SSL. The filesystem path to the private key file for SSL/TLS termination.
# Must be readable by the servefile process.
# Default: ''
ssl_key = {{ ssl_key | default('') }}

# Certfile to use for SSL. The filesystem path to the public certificate file for SSL/TLS termination.
# Default: ''
ssl_cert = {{ ssl_cert | default('') }}

# Set user and password for HTTP basic authentication (user:password).
# Sets HTTP Basic Authentication credentials. Format must be 'username:password'.
# If empty, no authentication is required for access.
# Default: ''
auth = {{ auth | default('') }}

# Set a realm for HTTP basic authentication. The authentication realm string presented
# to the client during the auth challenge. Typically used to identify the protected area to the user.
# Default: 'Restricted'
realm = {{ realm | default('Restricted') }}

###############################################################################
# Archive Features
###############################################################################

# Enable on the fly tar creation. When true, allows clients to request a tarball
# of the directory contents, which is generated dynamically by the server.
# Default: false
tar = {{ tar | default(false) | lower }}

# Compression method for tar (none, gzip, bzip2, xz). Specifies the compression
# algorithm used when generating on-the-fly tar archives.
# Default: 'gzip'
tar_compression = {{ tar_compression | default('gzip') }}