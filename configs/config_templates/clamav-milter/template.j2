#
# ClamAV Milter configuration
#
# This file is generated from clamav-milter package.
#
# NOTE: The 'Example' directive is a legacy lock. If set to 'yes',
# ClamAV ignores all other settings. Ensure it is disabled ('no')
# when providing actual configuration values.

# [Example] Internal flag indicating example config is still active.
# enum: [true, yes, 1, false, no, 0]
# If 'yes', this config is ignored by ClamAV. Set to 'no' to use below settings.
Example {{Example | default('yes')}}

# [Foreground] Whether to run in foreground mode (useful for debugging).
# enum: [true, yes, 1, false, no, 0]
Foreground {{Foreground | default('no')}}

# [User] User under which the milter runs.
User {{User | default('clamav')}}

# [PidFile] Path to PID file.
PidFile {{PidFile | default('/var/run/clamav/clamav-milter.pid')}}

# [MilterSocket] Socket specification for the milter connection.
# Format: 'local:/path/to/socket' for Unix sockets or 'inet:port@host' for TCP.
MilterSocket {{MilterSocket | default('local:/var/run/clamav/clamav-milter.sock')}}

# [DataBaseDirectory] Directory where virus database files are stored.
# The milter expects freshclam to have updated the DB here.
DatabaseDirectory {{DataBaseDirectory | default('/var/run/clamav')}}

# Additional options can be added below.
# For example, to enable logging:
# LogSyslog yes
# LogVerbose yes
# LogClean yes
