#############################################################################
#
# OpenSLP registration file
#
# This file registers services for legacy applications that do not use
# the SLP APIs to register for themselves.
#
# Format and contents conform to specification in IETF RFC 2614.
# In OpenSLP, SLPD operates as an Service Agent (SA) and Directory Agent (DA).
# The SLP User Agent (UA) functionality is encapsulated by the libslp library.
#
#############################################################################

#
# Configuration Directive: slp_testing_host
# Description: Hostname or IP address for the OpenSLP testing service.
# Default: 192.168.100.1
#
#service:test.openslp://{{ slp_testing_host | default('192.168.100.1') }},en,65535
#scopes=test1,test2
#description=OpenSLP Testing Service
#authors=mpeterson,jcarey

#
# Configuration Directive: slp_ssh_host
# Description: Hostname or IP address for the SSH service.
# Default: 192.168.100.1
#
#service:ssh.openslp://{{ slp_ssh_host | default('192.168.100.1') }},en,65535
#use default scopes
#description="Secure Shell"

#
# Configuration Directive: slp_telnet_host
# Description: Hostname or IP address for the Telnet service.
# Default: 192.168.100.1
#
#service:telnet.myorg://{{ slp_telnet_host | default('192.168.100.1') }},en,65535
#use default scopes

#
# Configuration Directive: slp_vnc_host
# Description: Hostname or IP address for the VNC service.
# Default: 192.168.100.1
#
# Configuration Directive: slp_vnc_port
# Description: Port number for the VNC service.
# Default: 1
#
#service:remotedesktop.kde:vnc://{{ slp_vnc_host | default('192.168.100.1') }}:{{ slp_vnc_port | default(1) }},en,65535
#attrid=(type=shared),(username=joe),(fullname=Joe User),(serviceid=1235456)
#description=KDE remote login
