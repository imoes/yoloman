# Munge configuration file
# Munge is used for authentication and credential delegation in HPC clusters.

# num_workers: Number of worker threads to handle credential requests. Increase for high-throughput environments.
# Default: 4
num_workers {{ num_workers | default(4) }}

# key_path: Path to the symmetric secret key file (binary format). Must be readable only by the munge user (mode 0400).
# Default: /etc/munge/munge.key
key_path {{ key_path | default('/etc/munge/munge.key') }}

# Log rotation configuration for munge daemon logs.
# This section defines how /var/log/munge/munged.log is managed by logrotate.
/var/log/munge/munged.log {
    # rotate: Keep this many rotated log files.
    # Default: 1
    rotate {{ rotate | default(1) }}

    # size: Rotate when the log file reaches this size.
    # Default: 100k
    size {{ size | default('100k') }}

    # copytruncate: Copy the log file and then truncate it to zero length, instead of moving and restarting the daemon.
    # This is safer for daemons that hold file descriptors open and cannot be easily signaled to reopen logs.
    copytruncate

    # compress: Compress rotated log files using gzip.
    compress

    # nodelaycompress: Do not delay compression of the most recent rotated file; compress it immediately.
    nodelaycompress

    # missingok: Do not issue an error if the log file is missing.
    missingok
}
