# Daemon configuration for munged — the Munge authentication service
# Enable debug mode for verbose logging (optional)
{% if debug | default(false) %}DEBUG=yes{% else %}#DEBUG=no{% endif %}

# Path to the PID file for the daemon
RUNDIR=/run/munge

# Path to the log file
LOGFILE=/var/log/munge/munged.log

# Maximum number of log entries to retain (rotated logs)
{% if log_max_entries | default(10) %}LOGDIR_MAX_ENTRIES={{ log_max_entries }}{% endif %}

# Number of worker threads to handle credential requests
{% if num_workers | default(4) %}NUM_WORKERS={{ num_workers }}{% endif %}

# Time-to-live for credentials (in seconds)
{% if cred_ttl | default(600) %}CRED_TTL={{ cred_ttl }}{% endif %}

# Time-to-live for credentials in cache (in seconds)
{% if cred_cache_ttl | default(300) %}CRED_CACHE_TTL={{ cred_cache_cache_ttl }}{% endif %}

# Hostnames or IP addresses of other munge nodes (for cluster-wide auth)
{% if peers | default([]) | length > 0 %}PEERS={{ peers | join(', ') }}{% else %}#PEERS=localhost{% endif %}

# Restrict clients to UID/GID range (optional, e.g., 0:0 or 1000-1999:1000-1999)
{% if restrict_clients | default('') %}RESTRICT_CLIENTS={{ restrict_clients }}{% endif %}

# Listen only on specified IPv4/IPv6 addresses or hostnames (comma-separated)
{% if bind_addr | default('0.0.0.0') %}BIND_ADDR={{ bind_addr }}{% endif %}

# Port to listen on for incoming connections
{% if port | default(8737) %}PORT={{ port }}{% endif %}

# Enable SSL/TLS for inter-node communication (requires valid certs)
{% if ssl_enabled | default(false) %}SSL=yes{% else %}#SSL=no{% endif %}

# Path to the server’s SSL certificate
{% if ssl_cert | default('/etc/munge/munge.crt') %}SSL_CERT={{ ssl_cert }}{% endif %}

# Path to the server’s SSL private key
{% if ssl_key | default('/etc/munge/munge.key') %}SSL_KEY={{ ssl_key }}{% endif %}

# Path to the CA certificate bundle (for verifying peer certs)
{% if ssl_ca_cert | default('/etc/munge/munge.ca') %}SSL_CA_CERT={{ ssl_ca_cert }}{% endif %}

# Enforce strict hostname verification for SSL
{% if ssl_strict_hostname | default(false) %}SSL_STRICT_HOSTNAME=yes{% else %}#SSL_STRICT_HOSTNAME=no{% endif %}

# Enable key rotation (auto-generate new keys periodically)
{% if key_rotation_enabled | default(false) %}KEY_ROTATION=yes{% else %}#KEY_ROTATION=no{% endif %}

# Key rotation interval (in seconds)
{% if key_rotation_interval | default(86400) %}KEY_ROTATION_INTERVAL={{ key_rotation_interval }}{% endif %}

# Path to the key file (must be readable only by munge user)
{% if key_path | default('/etc/munge/munge.key') %}KEY_PATH={{ key_path }}{% endif %}

# Permission mode for the socket file (octal)
{% if socket_mode | default('0700') %}SOCKET_MODE={{ socket_mode }}{% endif %}

# Path to the Unix domain socket
{% if socket_path | default('/run/munge/munged.sock') %}SOCKET_PATH={{ socket_path }}{% endif %}
