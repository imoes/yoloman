{
  "debug": false,
  "log_max_entries": 10,
  "num_workers": 4,
  "cred_ttl": 600,
  "cred_cache_ttl": 300,
  "peers": [
    "node1.example.com",
    "node2.example.com",
    "node3.example.com"
  ],
  "restrict_clients": "0:0,1000-1999:1000-1999",
  "bind_addr": "0.0.0.0",
  "port": 8737,
  "ssl_enabled": true,
  "ssl_cert": "/etc/munge/munge.crt",
  "ssl_key": "/etc/munge/munge.key",
  "ssl_ca_cert": "/etc/munge/munge.ca",
  "ssl_strict_hostname": true,
  "key_rotation_enabled": true,
  "key_rotation_interval": 604800,
  "key_path": "/etc/munge/munge.key",
  "socket_mode": "0700",
  "socket_path": "/run/munge/munged.sock"
}
