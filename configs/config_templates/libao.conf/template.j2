# libao.conf — Global configuration for libao, the cross-platform audio output library
# Each line sets a driver and its options in 'driver=option1=value1,option2=value2' format
# See `man 5 libao` or `libao.conf(5)` for driver-specific options
{% for driver_config in drivers %}{{ driver_config.driver }}={{ driver_config.options | join(', ') }}{% if not loop.last %}
{% endif %}{% endfor %}