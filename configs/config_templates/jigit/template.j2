# /etc/jigit.conf
# Configuration file for Jigit (JIGit) - A tool for creating Debian installer images.

# Base URL of the jigit update site.
# This URL is used to fetch updates and metadata for the Debian installation sources.
HOST={{ host | default('http://http.us.debian.org/debian') }}

# Where jigit should store its temporary files.
# This directory is used for storing temporary files during download and ISO construction.
TMPDIR={{ tmpdir | default('/tmp') }}