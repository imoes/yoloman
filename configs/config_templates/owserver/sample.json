{
  "server.bind": "0.0.0.0",
  "server.port": 4304,
  "server.allow": [
    "127.0.0.1",
    "192.168.1.10"
  ],
  "buses": [
    {
      "name": "Main USB Bus",
      "type": "usb",
      "device": "/dev/ttyUSB0"
    },
    {
      "name": "Remote Bus",
      "type": "network",
      "server": "10.0.0.50"
    }
  ],
  "features": {
    "cache": true,
    "allow_set": false,
    "allow_write": false
  },
  "timeouts": {
    "connection": 5,
    "read": 2,
    "write": 2
  },
  "logging": {
    "level": "notice",
    "file": "/var/log/owserver.log"
  },
  "fuse": {
    "mount_point": "/mnt/1wire",
    "allow_other": true,
    "default_permissions": true
  }
}
