{
  "server.bind": "0.0.0.0",
  "server.port": 4304,
  "server.allow": [
    "127.0.0.1"
  ],
  "buses": [
    {
      "name": "main",
      "type": "usb",
      "device": "/dev/ttyUSB0"
    }
  ],
  "features.cache": true,
  "features.allow_set": false,
  "features.allow_write": false,
  "timeouts.connection": 5,
  "timeouts.read": 2,
  "timeouts.write": 2,
  "logging.level": "warning",
  "logging.file": "",
  "fuse.mount_point": "",
  "fuse.allow_other": true
}
