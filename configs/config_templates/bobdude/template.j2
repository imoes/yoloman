#------------------------------------------------------------
# ft2232h_jtag
#------------------------------------------------------------

# FT2232H based generic JTAG programmer.
# Uses JTAG signals (TCK, TDI, TDO, TMS).
programmer # ft2232h_jtag
    id                     = "ft2232h_jtag";
    desc                   = "FT2232H based generic JTAG programmer";
    type                   = "avrftdi_jtag";
    prog_modes             = PM_JTAG;
    connection_type        = usb;
    usbvid                 = 0x0403;
    usbpid                 = 0x6010;
    usbdev                 = "{{ default_ft2232h_jtag_usbdev | default('A') }}";
    tck                    = 0; # AD0 (TCK)
    tdi                    = 1; # AD1 (TDI)
    tdo                    = 2; # AD2 (TDO)
    tms                    = 3; # AD3 (TMS)
;

