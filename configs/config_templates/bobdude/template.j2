#------------------------------------------------------------
# uncompatino
#------------------------------------------------------------

# uncompatino with all pairs of pins shorted.
# ATmega328P kit PCB allowing ISP via on-board FT232R.
programmer # uncompatino
    id                     = "uncompatino";
    desc                   = "uncompatino with all pairs of pins shorted";
    type                   = "ftdi_syncbb";
    prog_modes             = PM_TPI | PM_ISP;
    connection_type        = usb;
    reset                  = 7; # ri
    sck                    = 5; # dsr
    sdo                    = 6; # dcd
    sdi                    = 3; # cts
;

#------------------------------------------------------------
# ttl232r
#------------------------------------------------------------

# FTDI TTL232R-5V with ICSP adapter.
programmer # ttl232r
    id                     = "ttl232r";
    desc                   = "FTDI TTL232R-5V with ICSP adapter";
    type                   = "ftdi_syncbb";
    prog_modes             = PM_TPI | PM_ISP;
    connection_type        = usb;
    reset                  = 0; # txd
    sck                    = 1; # rxd
    sdo                    = 3; # cts
    sdi                    = 2; # rts
;

#------------------------------------------------------------
# usbasp
#------------------------------------------------------------

# USBasp ISP and TPI programmer.
# From http://www.fischl.de/usbasp
# USB in-circuit programmer for Atmel AVR controllers.
programmer # usbasp
    id                     = "usbasp";
    desc                   = "USBasp ISP and TPI programmer";
    type                   = "usbasp";
    prog_modes             = PM_TPI | PM_ISP;
    connection_type        = usb;
;