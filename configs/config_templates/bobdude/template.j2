# $Id$ -*- text -*-
#
# AVRDUDE Configuration File
#
# Self-documenting template for AVRDUDE.
# All user-configurable defaults are injected below.
# See schema fields for descriptions of each setting.

# AVRDUDE configuration file version
avrdude_conf_version = "{{ avrdude_conf_version | default('7.3') }}";

# Overall avrdude defaults; suitable for ~/.config/avrdude/avrdude.rc
#
# Default parallel port device
default_parallel   = "{{ default_parallel | default('/dev/parport0') }}";

# Default serial port device
default_serial     = "{{ default_serial | default('/dev/ttyS0') }}";

# Default SPI device (empty string by default)
default_spi        = "{{ default_spi | default('') }}";

# Default Linux GPIO chip name
default_linuxgpio  = "{{ default_linuxgpio | default('gpiochip0') }}";

# Whether to allow subshells (no by default)
allow_subshells    = {{ allow_subshells | default(False) | lower }};


#
# PROGRAMMER DEFINITIONS
#
# The following programmer definitions are provided as defaults.
# They define hardware pinouts and communication protocols for
# various AVR programmers (USB, Serial, Parallel, JTAG, etc.).

#------------------------------------------------------------
# dryrun
#------------------------------------------------------------

# Emulates programming without a programmer.
# Useful for testing command-line syntax and logic without
# connecting physical hardware.
programmer # dryrun
    id                     = "dryrun";
    desc                   = "Emulates programming without a programmer";
    type                   = "dryrun";
    prog_modes             = PM_TPI | PM_ISP | PM_PDI | PM_UPDI | PM_HVSP | PM_HVPP | PM_aWire;
;

#------------------------------------------------------------
# dryboot
#------------------------------------------------------------

# Emulates bootloader programming without a programmer.
# Specifically for communicating to bootloaders (PM_SPM).
# Allows exploring bootloader behavior (page erasure before write).
programmer # dryboot
    id                     = "dryboot";
    desc                   = "Emulates bootloader programming without a programmer";
    type                   = "dryrun";
    prog_modes             = PM_SPM;
;

#------------------------------------------------------------
# wiring
#------------------------------------------------------------

# Wiring for bootloader using STK500 v2 protocol.
# Based on the Wiring embedded programming environment.
programmer # wiring
    id                     = "wiring";
    desc                   = "Wiring for bootloader using STK500 v2 protocol";
    type                   = "wiring";
    prog_modes             = PM_SPM;
    connection_type        = serial;
;

#------------------------------------------------------------
# arduino
#------------------------------------------------------------

# Arduino for bootloader using STK500 v1 protocol.
# Serves optiboot bootloaders and others.
# Superseded by 'urclock' for modern use cases but kept for compatibility.
programmer # arduino
    id                     = "arduino";
    desc                   = "Arduino for bootloader using STK500 v1 protocol";
    type                   = "arduino";
    prog_modes             = PM_SPM;
    connection_type        = serial;
;

#------------------------------------------------------------
# urclock
#------------------------------------------------------------

# Urclock programmer for urboot bootloaders using urprotocol.
# Supports vector bootloaders and automatic reset via RTS/DTR.
# See https://github.com/stefanrueger/urboot
programmer # urclock
    id                     = "urclock";
    desc                   = "Urclock programmer for urboot bootloaders using urprotocol";
    type                   = "urclock";
    prog_modes             = PM_SPM;
    connection_type        = serial;
;

#------------------------------------------------------------
# xbee
#------------------------------------------------------------

# XBee for Series 2 Over-The-Air (XBeeBoot) bootloader using STK500 v1 protocol.
# See https://github.com/davidsainty/xbeeboot
programmer # xbee
    id                     = "xbee";
    desc                   = "XBee for Series 2 Over-The-Air (XBeeBoot) bootloader using STK500 v1 protocol";
    type                   = "xbee";
    prog_modes             = PM_SPM;
    connection_type        = serial;
;

#------------------------------------------------------------
# ft2232h (base)
#------------------------------------------------------------

# FT2232H/D based generic programmer.
# Uses FTDI Multi-Protocol Synchronous Serial Engine (MPSSE).
# Default USB interface device string.
programmer # avrftdi
    id                     = "avrftdi", "2232h";
    desc                   = "FT2232H/D based generic programmer";
    type                   = "avrftdi";
    prog_modes             = PM_TPI | PM_ISP;
    connection_type        = usb;
    usbvid                 = 0x0403;
    usbpid                 = 0x6010;
    usbdev                 = "{{ default_ft2232h_usbdev | default('A') }}";
    reset                  = 3; # AD3 (TMS)
    sck                    = 0; # AD0 (TCK)
    sdo                    = 1; # AD1 (TDI)
    sdi                    = 2; # AD2 (TDO)
;

#------------------------------------------------------------
# ft2232h (parent)
#------------------------------------------------------------

# Parent definition for ft2232h-based programmers.
programmer parent "2232h" # ft2232h
    id                     = "ft2232h";
    is_serialadapter       = yes;
;

#------------------------------------------------------------
# 2232hio
#------------------------------------------------------------

# 2232hio based on FT2232H with buffer and LEDs.
programmer parent "2232h" # 2232hio
    id                     = "2232hio";
    desc                   = "2232hio based on FT2232H with buffer and LEDs";
    buff                   = ~4;
    errled                 = ~11;
    rdyled                 = ~14;
    pgmled                 = ~13;
    vfyled                 = ~12;
;

#------------------------------------------------------------
# tigard
#------------------------------------------------------------

# Tigard interface board (FT2232H based).
# See https://github.com/tigard-tools/tigard
programmer parent "2232h" # tigard
    id                     = "tigard";
    desc                   = "Tigard interface board";
    usbdev                 = "{{ tigard_usbdev | default('B') }}";
    reset                  = 5; # BD5 (GPIOL1)
;

