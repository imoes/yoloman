# Log rotation configuration for gnokii-smsd log files.
# This block configures logrotate to manage /var/log/gnokii-smsd logs.
/var/log/gnokii-smsd {
    # Do not rotate if the log file is missing.
    missingok
    # Do not create a new empty log file if the old one is missing or empty.
    notifempty
    # Create the new log file with the specified octal permission bits,
    # owned by the specified user, and owned by the specified group.
    create {{ log_file_permissions | default('0640') }} {{ log_file_owner | default('gnokii') }} {{ log_file_group | default('gnokii') }}
}
