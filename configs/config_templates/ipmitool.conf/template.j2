# ipmitool configuration file
# Controls default behavior of ipmitool commands

# Default BMC IP address (overrides environment variable IPMI_HOST)
# Set to 'localhost' for local BMC access via kernel IPMI
# Set to 'ipmi://user:pass@host:port' for remote BMC access via IPMI-LAN
#host = localhost

# Default BMC username (overrides environment variable IPMI_USERNAME)
#username = admin

# Default BMC password (overrides environment variable IPMI_PASSWORD)
#password = password

# Default BMC interface type
# Supported: 'open', 'imb', 'lan', 'lanplus', 'kcs', 'bt'
#interface = lan

# Default RMCP+ cipher suite (used only with 'lanplus' interface)
# Cipher 0 = no encryption/auth; 1 = hmac-sha1; 3 = aes-cbc-128; 6 = hmac-sha256
#ciphersuite = 3

# Default RMCP+ authentication type (used only with 'lanplus' interface)
# 1 = none, 2 = md2, 3 = md5, 6 = hmac-sha1, 7 = hmac-sha256, 8 = aes-cmac-128, 9 = hmac-sha384, 10 = hmac-sha512
#authlevel = 6

# Default RMCP+ session timeout in milliseconds
#timeout = 1500

# Default RMCP+ retry count
#retries = 3

# Enable verbose output (same as '-v' flag)
#verbose = false

# Default payload mode for SOL (Serial-over-LAN)
# Supported: 'raw', 'rfu', 'serial', 'bridge'
#payload_mode = raw

# Default SOL payload port number (for 'bridge' payload mode)
#sol_port = 0

# Enable SOL session keep-alive (send periodic keep-alive packets)
#sol_keepalive = true

# Default SOL idle timeout in seconds
#sol_idle_timeout = 30

# Default SOL character size in bits
#sol_char_size = 8

# Default SOL stop bits
#sol_stop_bits = 1

# Default SOL parity
# Supported: 'none', 'odd', 'even', 'mark', 'space'
#sol_parity = none

# Default SOL baud rate divisor
#sol_baud_rate = 9600

# Default local device path (for kernel IPMI interface)
#device = /dev/ipmi0

# Enable local device locking (use flock on device file)
#local_locking = true

# Enable use of environment variables for credentials (if not set above)
#use_env = true
