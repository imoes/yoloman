# ipmitool configuration file
# Controls default behavior of ipmitool commands
#
# This template is self-documenting. Each setting is commented with its
# schema description and source default. Variables use `default()` to
# ensure safe rendering even if the Ansible role does not pass them.

# ==============================================================================
# BMC Access & Authentication
# ==============================================================================

# BMC hostname/IP or IPMI URI for remote access (e.g., 'ipmi://user:pass@192.168.1.10:623')
# Defaults to 'localhost' for local BMC access via kernel IPMI.
# If set to an IPMI URI, it overrides username/password/interface settings in many drivers.
#host = {{ host | default('localhost') }}

# BMC username for authentication (leave blank to use environment variable or prompt)
#username = {{ username | default('') }}

# BMC password for authentication (leave blank to use environment variable or prompt)
#password = {{ password | default('') }}

# ==============================================================================
# Network Interface Settings
# ==============================================================================

# IPMI interface type to use (e.g., 'lanplus' for IPMI 2.0 over LAN)
# Supported: 'open', 'imb', 'lan', 'lanplus', 'kcs', 'bt'
#interface = {{ interface | default('lan') }}

# ==============================================================================
# IPMI 2.0 / LANplus Security
# ==============================================================================

# RMCP+ cipher suite number for 'lanplus' interface (17 = AES-CBC-128 with SHA256)
# Cipher 0 = no encryption/auth; 1 = hmac-sha1; 3 = aes-cbc-128; 6 = hmac-sha256
# Note: This setting is primarily used when interface='lanplus'.
ciphersuite = {{ ciphersuite | default(17) }}

# RMCP+ authentication level (6 = HMAC-SHA1) for 'lanplus' interface
# 1 = none, 2 = md2, 3 = md5, 6 = hmac-sha1, 7 = hmac-sha256, 8 = aes-cmac-128, 9 = hmac-sha384, 10 = hmac-sha512
# Note: This setting is primarily used when interface='lanplus'.
#authlevel = {{ authlevel | default(6) }}

# ==============================================================================
# Connection Reliability
# ==============================================================================

# RMCP+ session timeout in milliseconds
#timeout = {{ timeout | default(1500) }}

# Number of RMCP+ packet retries before failing
#retries = {{ retries | default(3) }}

# ==============================================================================
# Output & Debugging
# ==============================================================================

# Enable verbose debug output (equivalent to '-v' command-line flag)
#verbose = {{ verbose | default(false) }}

# ==============================================================================
# Serial Over LAN (SOL)
# ==============================================================================

# Enable periodic keep-alive packets during SOL sessions
#sol_keepalive = {{ sol_keepalive | default(true) }}

# ==============================================================================
# Local Device Access
# ==============================================================================

# Local IPMI device path (used with kernel interface like 'kcs', 'bt')
#device = {{ device | default('/dev/ipmi0') }}

# Enable file locking on the local device path for safe concurrent access
#local_locking = {{ local_locking | default(true) }}

# Allow credentials and settings to be overridden via environment variables
#use_env = {{ use_env | default(true) }}