<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lomiri Online Accounts Plugin - OwnCloud CalDAV Profile Configuration
  ==========================================
  This template generates an XML profile for the Lomiri online-accounts-plugin
  to connect to an OwnCloud CalDAV service.

  It describes the profile metadata, synchronization behavior, and schedule settings.
  All variable references include sensible defaults derived from the schema to ensure
  the configuration is safe to deploy without explicit variable definition for every field.
-->
<profile name="{{ profile_name | default('lomiri-owncloud-caldav') }}" type="sync" >
    <!-- The category of the service. -->
    <key value="{{ category | default('calendar') }}" name="category"/>
    
    <!-- The remote service name identifier. -->
    <key value="{{ remote_service_name | default('lomiri-owncloud-caldav') }}" name="remote_service_name"/>
    
    <!-- The type of destination (e.g., online, local). -->
    <key name="destinationtype" value="{{ destinationtype | default('online') }}"/>
    
    <!-- Whether the profile is enabled by default. -->
    <key name="enabled" value="{{ enabled | default(False) }}"/>
    
    <!-- Whether the profile is hidden from the user interface. -->
    <key name="hidden" value="{{ hidden | default(False) }}"/>
    
    <!-- Whether to use system accounts. -->
    <key name="use_accounts" value="{{ use_accounts | default(True) }}"/>

    <!-- Sub-profile for CalDAV client-specific settings. -->
    <profile type="client" name="caldav">
        <!-- The sync direction (e.g., two-way, one-way). -->
        <key value="{{ sync_direction | default('two-way') }}" name="Sync Direction"/>
        
        <!-- The protocol used for synchronization. -->
        <key value="{{ sync_protocol | default('caldav') }}" name="Sync Protocol"/>
        
        <!-- The transport layer used for synchronization. -->
        <key value="{{ sync_transport | default('HTTP') }}" name="Sync Transport"/>
        
        <!-- The policy for handling conflicts during sync. -->
        <key value="{{ conflictpolicy | default('prefer remote') }}" name="conflictpolicy" />
    </profile>

    <!-- Schedule settings for automatic synchronization. -->
    <!--
        enabled: Whether the schedule is active.
        interval: Interval string for scheduling.
        days: Comma-separated list of days the schedule applies to.
        syncconfiguredtime: Time for sync configured events.
        time: The time of day for the schedule.
    -->
    <schedule enabled="{{ schedule_enabled | default(False) }}" interval="{{ schedule_interval | default('') }}" days="{{ schedule_days | default('1,2,3,4,5,6,7') }}" syncconfiguredtime="{{ schedule_syncconfiguredtime | default('') }}" time="{{ schedule_time | default('05:00:00') }}" />
</profile>