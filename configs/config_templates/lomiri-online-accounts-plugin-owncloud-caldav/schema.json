{
  "profile_name": {
    "type": "string",
    "default": "lomiri-owncloud-caldav",
    "description": "The name of the profile."
  },
  "category": {
    "type": "string",
    "default": "calendar",
    "description": "The category of the service."
  },
  "remote_service_name": {
    "type": "string",
    "default": "lomiri-owncloud-caldav",
    "description": "The remote service name identifier."
  },
  "destinationtype": {
    "type": "string",
    "default": "online",
    "description": "The type of destination (e.g., online, local)."
  },
  "enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether the profile is enabled by default."
  },
  "hidden": {
    "type": "bool",
    "default": false,
    "description": "Whether the profile is hidden from the user interface."
  },
  "use_accounts": {
    "type": "bool",
    "default": true,
    "description": "Whether to use system accounts."
  },
  "sync_direction": {
    "type": "string",
    "default": "two-way",
    "description": "The sync direction (e.g., two-way, one-way)."
  },
  "sync_protocol": {
    "type": "string",
    "default": "caldav",
    "description": "The protocol used for synchronization."
  },
  "sync_transport": {
    "type": "string",
    "default": "HTTP",
    "description": "The transport layer used for synchronization.",
    "enum": [
      "HTTP",
      "HTTPS"
    ]
  },
  "conflictpolicy": {
    "type": "string",
    "default": "prefer remote",
    "description": "The policy for handling conflicts during sync."
  },
  "schedule_enabled": {
    "type": "bool",
    "default": false,
    "description": "Whether the schedule is enabled."
  },
  "schedule_interval": {
    "type": "string",
    "default": "",
    "description": "The interval string for scheduling."
  },
  "schedule_days": {
    "type": "string",
    "default": "1,2,3,4,5,6,7",
    "description": "Comma-separated list of days the schedule applies to."
  },
  "schedule_syncconfiguredtime": {
    "type": "string",
    "default": "",
    "description": "Time for sync configured events."
  },
  "schedule_time": {
    "type": "string",
    "default": "05:00:00",
    "description": "The time of day for the schedule."
  }
}
