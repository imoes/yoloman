{
  "bind_address": "127.0.0.1",
  "port": 6667,
  "logfile": "/var/log/dircproxy/dircproxy.log",
  "daemon": true,
  "max_clients": 3,
  "max_channels": 10,
  "default_nick": "guest",
  "default_user": "dircproxy",
  "default_realname": "dircproxy IRC proxy",
  "client_timeout": 300,
  "server_timeout": 600,
  "reconnect_delay": 10,
  "max_reconnects": 5,
  "ssl": false,
  "ssl_cert": "/etc/dircproxy/ssl/client.crt",
  "ssl_key": "/etc/dircproxy/ssl/client.key",
  "ssl_cafile": "/etc/dircproxy/ssl/ca.crt",
  "server_password": "",
  "servers": [
    {
      "host": "irc.libera.chat",
      "port": 6697,
      "ssl": true,
      "ssl_verify": true,
      "ssl_cafile": "/etc/dircproxy/ssl/ca.crt",
      "autojoin": [
        "#dircproxy",
        "#help"
      ]
    },
    {
      "host": "irc.oftc.net",
      "port": 6667,
      "ssl": false,
      "ssl_verify": false,
      "autojoin": [
        "#debian",
        "#ubuntu"
      ]
    }
  ],
  "allow_clients": [
    {
      "host": "127.0.0.1",
      "password": ""
    },
    {
      "host": "192.168.1.0/24",
      "password": "secret123"
    }
  ],
  "admin_password": "adminpass456",
  "log_channels": true,
  "log_privates": true
}
