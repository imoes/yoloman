# NATS Server Configuration — generated by operator
# Listen on specified host and port for client connections
listen: {{ listen_host }}:{{ listen_port }}

# HTTP monitoring endpoint (for /varz, /connz, etc.)
{% if http_monitoring.enabled %}
http: {{ http_monitoring.host }}:{{ http_monitoring.port }}
{% endif %}

# Prometheus metrics endpoint
{% if prometheus.enabled %}
metrics: {{ prometheus.host }}:{{ prometheus.port }}
{% endif %}

# Cluster configuration for high availability
{% if cluster.enabled %}
cluster {
  name: {{ cluster.name | default('') }}
  host: {{ cluster.host }}
  port: {{ cluster.port }}
  {% if cluster.routes %}
  routes = [
    {% for route in cluster.routes %}
    "nats://{{ route.host }}:{{ route.port }}"
    {% endfor %}
  ]
  {% endif %}
}
{% endif %}

# Authorization configuration
{% if auth.type == 'token' %}
authorization {
  token: {{ auth.token }}
}
{% elif auth.type == 'users' %}
authorization {
  users = [
    {% for user in auth.users %}
    {
      user: "{{ user.username }}"
      password: "{{ user.password }}"
      {% if user.permissions %}
      permissions {
        {% if user.permissions.subscribe %}
        subscribe: [
          {% for sub in user.permissions.subscribe %}
          "{{ sub }}"
          {% endfor %}
        ]
        {% endif %}
        {% if user.permissions.publish %}
        publish: [
          {% for pub in user.permissions.publish %}
          "{{ pub }}"
          {% endfor %}
        ]
        {% endif %}
      }
      {% endif %}
    }
    {% endfor %}
  ]
}
{% endif %}

# Logging configuration
log_file: {{ log.file | default('') }}
{% if debug %}
trace: true
{% endif %}

# Max connections and memory limits
max_connections: {{ limits.max_connections }}
max_payload: {{ limits.max_payload | default('64K') }}
max_control_line: {{ limits.max_control_line | default('256') }}

# JetStream configuration (optional)
{% if jetstream.enabled %}
jetstream {
  store_dir: {{ jetstream.store_dir }}
  max_mem: {{ jetstream.max_mem | default('1G') }}
  max_file: {{ jetstream.max_file | default('10G') }}
}
{% endif %}

# Leaf node configuration (for edge connectivity)
{% if leafnodes.enabled %}
leafnodes {
  host: {{ leafnodes.host }}
  port: {{ leafnodes.port }}
  {% if leafnodes.remotes %}
  remotes = [
    {% for remote in leafnodes.remotes %}
    {
      urls: [
        {% for url in remote.urls %}
        "{{ url }}"
        {% endfor %}
      ]
      {% if remote.local_account %}
      account: "{{ remote.local_account }}"
      {% endif %}
    }
    {% endfor %}
  ]
  {% endif %}
}
{% endif %}

# Websocket support
{% if websocket.enabled %}
websocket {
  host: {{ websocket.host }}
  port: {{ websocket.port }}
  {% if websocket.tls.enabled %}
  tls {
    cert_file: "{{ websocket.tls.cert_file }}"
    key_file: "{{ websocket.tls.key_file }}"
    ca_file: "{{ websocket.tls.ca_file | default('') }}"
  }
  {% endif %}
}
{% endif %}

# TLS configuration for client connections
{% if tls.enabled %}
tls {
  cert_file: "{{ tls.cert_file }}"
  key_file: "{{ tls.key_file }}"
  ca_file: "{{ tls.ca_file | default('') }}"
  timeout: {{ tls.timeout | default(2) }}
}
{% endif %}

# Cluster TLS
{% if cluster.enabled and cluster.tls %}
cluster {
  {% if cluster.tls.enabled %}
  tls {
    cert_file: "{{ cluster.tls.cert_file }}"
    key_file: "{{ cluster.tls.key_file }}"
    ca_file: "{{ cluster.tls.ca_file }}"
  }
  {% endif %}
}
{% endif %}

# Lame duck mode timeout (for graceful shutdown)
ldm_grace_period: {{ ldm_grace_period | default('5s') }}
