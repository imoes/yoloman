# ============================================================================
# NATS Server Configuration
# Generated by Ansible — edit the variable definitions, not this file.
# ============================================================================

# Network interface and port for client connections.
# listen_host: Network interface to listen on for NATS client connections.
# listen_port: Port to listen on for client NATS connections.
listen: {{ (listen_host | default('0.0.0.0')) }}:{{ (listen_port | default(4222)) }}

# ============================================================================
# HTTP Monitoring Endpoint
# Enables /varz, /connz, /healthz introspection URLs.
# ============================================================================
# http_monitoring.enabled: Enable HTTP monitoring server.
{% if ((http_monitoring | default({})).enabled | default(false)) %}
# http_monitoring.host: Host for HTTP monitoring endpoint.
# http_monitoring.port: Port for HTTP monitoring endpoint.
http: {{ ((http_monitoring | default({})).host | default('0.0.0.0')) }}:{{ ((http_monitoring | default({})).port | default(8222)) }}
{% endif %}

# ============================================================================
# Prometheus Metrics Endpoint
# Provides a /metrics HTTP endpoint compatible with Prometheus scraping.
# ============================================================================
# prometheus.enabled: Enable Prometheus metrics endpoint.
{% if ((prometheus | default({})).enabled | default(false)) %}
# prometheus.host: Host for Prometheus metrics endpoint.
# prometheus.port: Port for Prometheus metrics endpoint.
metrics: {{ ((prometheus | default({})).host | default('0.0.0.0')) }}:{{ ((prometheus | default({})).port | default(7777)) }}
{% endif %}

# ============================================================================
# Cluster Configuration
# Enables node-to-node communication for high availability and replication.
# ============================================================================
# cluster.enabled: Enable cluster mode.
{% if ((cluster | default({})).enabled | default(false)) %}
cluster {
  # cluster.name: Optional cluster name for multi-cluster topologies.
  name: {{ ((cluster | default({})).name | default('')) }}
  # cluster.host: Host for cluster node-to-node communication.
  # cluster.port: Port for cluster node-to-node communication.
  host: {{ ((cluster | default({})).host | default('0.0.0.0')) }}
  port: {{ ((cluster | default({})).port | default(6222)) }}

  # cluster.routes: List of seed cluster node URLs for initial discovery.
  # Each route must have 'host' and 'port'.
  {% if ((cluster | default({})).routes | default([])) %}
  routes = [
    {% for route in ((cluster | default({})).routes | default([])) %}
    "nats://{{ route.host }}:{{ route.port }}"
    {% endfor %}
  ]
  {% endif %}

  # Cluster TLS settings (if enabled)
  # cluster.tls.enabled: Enable TLS for cluster connections.
  {% if (((cluster | default({})).tls | default({})).enabled | default(false)) %}
  tls {
    # cluster.tls.cert_file: Path to cluster TLS certificate.
    cert_file: "{{ ((cluster | default({})).tls | default({})).cert_file | default('') }}"
    # cluster.tls.key_file: Path to cluster TLS private key.
    key_file: "{{ ((cluster | default({})).tls | default({})).key_file | default('') }}"
    # cluster.tls.ca_file: Path to CA certificate for cluster TLS verification.
    ca_file: "{{ ((cluster | default({})).tls | default({})).ca_file | default('') }}"
  }
  {% endif %}
}
{% endif %}

# ============================================================================
# Authorization / Authentication
# Supports 'none', 'token', or 'users' modes.
# ============================================================================
# auth.type: Authentication mode: none, token, or users.
{% if ((auth | default({})).type | default('none')) == 'token' %}
authorization {
  # auth.token: Shared authorization token when auth.type is 'token'.
  token: {{ ((auth | default({})).token | default('')) }}
}
{% elif ((auth | default({})).type | default('none')) == 'users' %}
authorization {
  users = [
  # auth.users: List of users for username/password authentication.
  # Each user must have 'username' and 'password', optional 'permissions'.
  {% for user in ((auth | default({})).users | default([])) %}
    {
      user: "{{ user.username }}"
      password: "{{ user.password }}"
      {% if user.permissions %}
      permissions {
        {% if user.permissions.subscribe %}
        subscribe: [
        {% for sub in user.permissions.subscribe %}
          "{{ sub }}"
        {% endfor %}
        ]
        {% endif %}
        {% if user.permissions.publish %}
        publish: [
        {% for pub in user.permissions.publish %}
          "{{ pub }}"
        {% endfor %}
        ]
        {% endif %}
      }
      {% endif %}
    }
  {% endfor %}
  ]
}
{% endif %}

# ============================================================================
# Logging Configuration
# ============================================================================
# log.file: Path to log file. Leave empty to log to stdout/stderr.
log_file: {{ ((log | default({})).file | default('')) }}

# debug: Enable verbose debug logging (trace-level).
{% if ((debug | default(false)) | bool) %}
trace: true
{% endif %}

# ============================================================================
# Connection and Payload Limits
# ============================================================================
# limits.max_connections: Maximum number of simultaneous client connections.
max_connections: {{ ((limits | default({})).max_connections | default(65536)) }}

# limits.max_payload: Maximum size of a single message payload (e.g., '64K').
max_payload: {{ ((limits | default({})).max_payload | default('64K')) }}

# limits.max_control_line: Maximum length (in bytes) of a single protocol control line.
max_control_line: {{ ((limits | default({})).max_control_line | default(256)) }}

# ============================================================================
# JetStream Configuration
# Enables persistent, streaming, and durable queue groups.
# ============================================================================
# jetstream.enabled: Enable JetStream functionality.
{% if ((jetstream | default({})).enabled | default(false)) %}
jetstream {
  # jetstream.store_dir: Directory to store JetStream data.
  store_dir: {{ ((jetstream | default({})).store_dir | default('/var/lib/nats/jetstream')) }}
  # jetstream.max_mem: Maximum memory allocation for JetStream streams.
  max_mem: {{ ((jetstream | default({})).max_mem | default('1G')) }}
  # jetstream.max_file: Maximum disk usage for JetStream streams.
  max_file: {{ ((jetstream | default({})).max_file | default('10G')) }}
}
{% endif %}

# ============================================================================
# Leaf Node Configuration
# For connecting to remote clusters or hubs.
# ============================================================================
# leafnodes.enabled: Enable leaf node connectivity mode.
{% if ((leafnodes | default({})).enabled | default(false)) %}
leafnodes {
  # leafnodes.host: Host for accepting leaf node connections.
  # leafnodes.port: Port for accepting leaf node connections.
  host: {{ ((leafnodes | default({})).host | default('0.0.0.0')) }}
  port: {{ ((leafnodes | default({})).port | default(7422)) }}

  # leafnodes.remotes: Remote leaf node endpoints to connect to.
  {% if ((leafnodes | default({})).remotes | default([])) %}
  remotes = [
    {% for remote in ((leafnodes | default({})).remotes | default([])) %}
    {
      urls: [
      {% for url in remote.urls %}
        "{{ url }}"
      {% endfor %}
      ]
      {% if remote.local_account %}
      account: "{{ remote.local_account }}"
      {% endif %}
    }
    {% endfor %}
  ]
  {% endif %}
}
{% endif %}

# ============================================================================
# WebSocket Support
# Enables browser and lightweight clients via WebSocket.
# ============================================================================
# websocket.enabled: Enable WebSocket server.
{% if ((websocket | default({})).enabled | default(false)) %}
websocket {
  # websocket.host: Host to bind WebSocket server to.
  # websocket.port: Port for WebSocket connections.
  host: {{ ((websocket | default({})).host | default('0.0.0.0')) }}
  port: {{ ((websocket | default({})).port | default(8080)) }}

  # websocket.tls.enabled: Use TLS for WebSocket connections (wss://).
  {% if (((websocket | default({})).tls | default({})).enabled | default(false)) %}
  tls {
    # websocket.tls.cert_file: Path to WebSocket TLS certificate.
    cert_file: "{{ ((websocket | default({})).tls | default({})).cert_file | default('') }}"
    # websocket.tls.key_file: Path to WebSocket TLS private key.
    key_file: "{{ ((websocket | default({})).tls | default({})).key_file | default('') }}"
    # websocket.tls.ca_file: Path to CA certificate for WebSocket client verification.
    ca_file: "{{ ((websocket | default({})).tls | default({})).ca_file | default('') }}"
  }
  {% endif %}
}
{% endif %}

# ============================================================================
# TLS Configuration for Client Connections
# ============================================================================
# tls.enabled: Enable TLS for NATS client connections.
{% if ((tls | default({})).enabled | default(false)) %}
tls {
  # tls.cert_file: Path to TLS certificate (for client connections).
  cert_file: "{{ ((tls | default({})).cert_file | default('')) }}"
  # tls.key_file: Path to TLS private key (for client connections).
  key_file: "{{ ((tls | default({})).key_file | default('')) }}"
  # tls.ca_file: Path to CA certificate for client TLS verification.
  ca_file: "{{ ((tls | default({})).ca_file | default('')) }}"
  # tls.timeout: TLS handshake timeout (seconds).
  timeout: {{ ((tls | default({})).timeout | default(2)) }}
}
{% endif %}

# ============================================================================
# Lame Duck Mode
# Grace period before forced shutdown during rolling restarts.
# ============================================================================
# ldm_grace_period: Lame duck mode grace period before forced shutdown (e.g., '5s').
ldm_grace_period: {{ ldm_grace_period | default('5s') }}