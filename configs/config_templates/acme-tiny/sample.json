{
  "account_key": "/etc/ssl/acme/account.key",
  "csr": "/etc/ssl/acme/example.com.csr",
  "acme_dir": "/var/www/example.com/.well-known/acme-challenge",
  "directory_url": "https://acme-v02.api.letsencrypt.org/directory",
  "quiet": true,
  "disable_check": false,
  "contact": [
    "mailto:admin@example.com"
  ],
  "output_file": "/etc/ssl/acme/example.com.crt",
  "log_file": "/var/log/acme-tiny/example.com.log"
}
