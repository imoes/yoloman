{
  "access_log": {
    "type": "string",
    "default": "/var/log/squid/access.log",
    "description": "Path to the Squid access log file."
  },
  "graphs": {
    "type": "bool",
    "default": true,
    "description": "Enable graphics generation."
  },
  "graph_days_bytes_bar_color": {
    "type": "string",
    "default": "orange",
    "description": "Color for the bar graph.",
    "enum": [
      "blue",
      "green",
      "yellow",
      "orange",
      "brown",
      "red"
    ]
  },
  "graph_font": {
    "type": "string",
    "default": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "description": "Path to TTF font file for graphs."
  },
  "title": {
    "type": "string",
    "default": "Squid User Access Reports",
    "description": "Title for the HTML page."
  },
  "font_face": {
    "type": "string",
    "default": "Tahoma,Verdana,Arial",
    "description": "Font face for HTML page."
  },
  "header_color": {
    "type": "string",
    "default": "darkblue",
    "description": "Header color."
  },
  "header_bgcolor": {
    "type": "string",
    "default": "blanchedalmond",
    "description": "Header background color."
  },
  "font_size": {
    "type": "string",
    "default": "9px",
    "description": "Text font size."
  },
  "header_font_size": {
    "type": "string",
    "default": "9px",
    "description": "Header font size."
  },
  "title_font_size": {
    "type": "string",
    "default": "11px",
    "description": "Title font size."
  },
  "background_color": {
    "type": "string",
    "default": "white",
    "description": "HTML page background color."
  },
  "text_color": {
    "type": "string",
    "default": "#000000",
    "description": "HTML page text color."
  },
  "text_bgcolor": {
    "type": "string",
    "default": "lavender",
    "description": "HTML page text background color."
  },
  "title_color": {
    "type": "string",
    "default": "green",
    "description": "HTML page title color."
  },
  "logo_image": {
    "type": "string",
    "default": "none",
    "description": "Logo image path."
  },
  "logo_text": {
    "type": "string",
    "default": "",
    "description": "Logo text."
  },
  "logo_text_color": {
    "type": "string",
    "default": "#000000",
    "description": "Logo text color."
  },
  "logo_image_size_width": {
    "type": "number",
    "default": 80,
    "description": "Logo image width."
  },
  "logo_image_size_height": {
    "type": "number",
    "default": 45,
    "description": "Logo image height."
  },
  "background_image": {
    "type": "string",
    "default": "none",
    "description": "Background image path."
  },
  "password": {
    "type": "string",
    "default": "none",
    "description": "User password file for Squid auth."
  },
  "temporary_dir": {
    "type": "string",
    "default": "/tmp",
    "description": "Temporary directory for work files."
  },
  "output_dir_default": {
    "type": "string",
    "default": "/var/www/html/squid-reports",
    "description": "Default output directory if not overridden."
  },
  "output_dir": {
    "type": "string",
    "default": "/var/lib/sarg",
    "description": "Directory where reports are saved."
  },
  "output_email": {
    "type": "string",
    "default": "none",
    "description": "Email address to send reports."
  },
  "resolve_ip": {
    "type": "bool",
    "default": true,
    "description": "Convert IP address to DNS name."
  },
  "user_ip": {
    "type": "string",
    "default": "no",
    "description": "Use IP Address instead userid in reports.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "topuser_sort_field_field": {
    "type": "string",
    "default": "BYTES",
    "description": "Sort field for Topuser Report."
  },
  "topuser_sort_field_order": {
    "type": "string",
    "default": "reverse",
    "description": "Sort order for Topuser Report."
  },
  "user_sort_field_field": {
    "type": "string",
    "default": "BYTES",
    "description": "Sort field for User Report."
  },
  "user_sort_field_order": {
    "type": "string",
    "default": "reverse",
    "description": "Sort order for User Report."
  },
  "exclude_users": {
    "type": "string",
    "default": "/etc/sarg/exclude_users",
    "description": "File containing users to exclude."
  },
  "exclude_hosts": {
    "type": "string",
    "default": "/etc/sarg/exclude_hosts",
    "description": "File containing hosts to exclude."
  },
  "useragent_log": {
    "type": "string",
    "default": "none",
    "description": "Useragent log file path."
  },
  "date_format": {
    "type": "string",
    "default": "u",
    "description": "Date format in reports (e, u, w).",
    "enum": [
      "e",
      "u",
      "w"
    ]
  },
  "per_user_limit": {
    "type": "string",
    "default": "none",
    "description": "Limit file and size for per user."
  },
  "lastlog": {
    "type": "number",
    "default": 0,
    "description": "Number of report files to keep."
  },
  "remove_temp_files": {
    "type": "string",
    "default": "yes",
    "description": "Remove temporary files after report generation.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "index": {
    "type": "string",
    "default": "yes",
    "description": "Generate main index.html.",
    "enum": [
      "yes",
      "no",
      "only"
    ]
  },
  "index_tree": {
    "type": "string",
    "default": "file",
    "description": "How to generate the index (date or file).",
    "enum": [
      "date",
      "file"
    ]
  },
  "overwrite_report": {
    "type": "string",
    "default": "yes",
    "description": "Overwrite existing reports.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "records_without_userid": {
    "type": "string",
    "default": "ip",
    "description": "Handling of records without user id (ignore, ip, everybody).",
    "enum": [
      "ignore",
      "ip",
      "everybody"
    ]
  },
  "use_comma": {
    "type": "string",
    "default": "yes",
    "description": "Use comma instead point in reports.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "mail_utility": {
    "type": "string",
    "default": "mailx",
    "description": "Mail command to use.",
    "enum": [
      "mail",
      "mailx"
    ]
  },
  "topsites_num": {
    "type": "number",
    "default": 100,
    "description": "Number of sites in topsites report."
  },
  "topsites_sort_order_field": {
    "type": "string",
    "default": "CONNECT",
    "description": "Sort field for topsites report."
  },
  "topsites_sort_order_order": {
    "type": "string",
    "default": "D",
    "description": "Sort order for topsites report (A/D)."
  },
  "index_sort_order": {
    "type": "string",
    "default": "D",
    "description": "Sort order for index.html (A/D).",
    "enum": [
      "A",
      "D"
    ]
  },
  "exclude_codes": {
    "type": "string",
    "default": "/etc/sarg/exclude_codes",
    "description": "File containing HTTP codes to exclude."
  },
  "replace_index": {
    "type": "string",
    "default": "<?php echo str_replace(\".\", \"_\", $REMOTE_ADDR); echo \".html\"; ?>",
    "description": "String to replace index.html."
  },
  "max_elapsed": {
    "type": "number",
    "default": 28800000,
    "description": "Max elapsed time in milliseconds."
  },
  "report_type": {
    "type": "string",
    "default": "topusers topsites sites_users users_sites date_time denied auth_failures site_user_time_date downloads",
    "description": "Types of reports to generate."
  },
  "usertab": {
    "type": "string",
    "default": "/etc/sarg/usertab",
    "description": "User mapping file path."
  },
  "LDAPHost": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "LDAP server hostname or IP."
  },
  "LDAPPort": {
    "type": "number",
    "default": 389,
    "description": "LDAP server port."
  },
  "LDAPBindDN": {
    "type": "string",
    "default": "cn=proxy,dc=mydomain,dc=local",
    "description": "LDAP Bind DN."
  },
  "LDAPBindPW": {
    "type": "string",
    "default": "secret",
    "description": "LDAP Bind Password."
  },
  "LDAPBaseSearch": {
    "type": "string",
    "default": "ou=users,dc=mydomain,dc=local",
    "description": "LDAP search base."
  },
  "LDAPFilterSearch": {
    "type": "string",
    "default": "uid=%s",
    "description": "LDAP user search filter."
  },
  "LDAPTargetAttr": {
    "type": "string",
    "default": "cn",
    "description": "LDAP attribute for user name."
  },
  "long_url": {
    "type": "string",
    "default": "no",
    "description": "Show full URL in reports.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "date_time_by": {
    "type": "string",
    "default": "bytes",
    "description": "What to show in Date/Time reports (bytes, elap).",
    "enum": [
      "bytes",
      "elap"
    ]
  },
  "charset": {
    "type": "string",
    "default": "Latin1",
    "description": "Character set for reports.",
    "enum": [
      "Latin1",
      "Latin2",
      "Latin3",
      "Latin4",
      "Cyrillic",
      "Arabic",
      "Greek",
      "Hebrew",
      "Latin5",
      "Latin6",
      "Windows-1251",
      "Japan",
      "Koi8-r",
      "UTF-8"
    ]
  },
  "user_invalid_char": {
    "type": "string",
    "default": "&/",
    "description": "Invalid characters in userid to ignore."
  },
  "privacy": {
    "type": "string",
    "default": "no",
    "description": "Enable privacy mode.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "privacy_string": {
    "type": "string",
    "default": "***.***.***.***",
    "description": "String to replace URLs in privacy mode."
  },
  "privacy_string_color": {
    "type": "string",
    "default": "blue",
    "description": "Color for privacy string."
  },
  "include_users": {
    "type": "string",
    "default": "none",
    "description": "List of users to include."
  },
  "exclude_string": {
    "type": "string",
    "default": "none",
    "description": "List of strings to exclude from access log."
  },
  "show_successful_message": {
    "type": "string",
    "default": "no",
    "description": "Show success message.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "show_read_statistics": {
    "type": "string",
    "default": "no",
    "description": "Show read statistics.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "topuser_fields": {
    "type": "string",
    "default": "NUM DATE_TIME USERID CONNECT BYTES %BYTES IN-CACHE-OUT USED_TIME MILISEC %TIME TOTAL AVERAGE",
    "description": "Fields to include in Topuser report."
  },
  "user_report_fields": {
    "type": "string",
    "default": "CONNECT BYTES %BYTES IN-CACHE-OUT USED_TIME MILISEC %TIME TOTAL AVERAGE",
    "description": "Fields to include in User report."
  },
  "bytes_in_sites_users_report": {
    "type": "string",
    "default": "no",
    "description": "Include bytes in Site & Users report.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "topuser_num": {
    "type": "number",
    "default": 0,
    "description": "Number of users in topsites report."
  },
  "datafile": {
    "type": "string",
    "default": "none",
    "description": "File to save report results."
  },
  "datafile_delimiter": {
    "type": "string",
    "default": ";",
    "description": "Delimiter for datafile."
  },
  "datafile_fields": {
    "type": "string",
    "default": "user;date;time;url;connect;bytes;in_cache;out_cache;elapsed",
    "description": "Fields to include in datafile."
  },
  "datafile_url": {
    "type": "string",
    "default": "ip",
    "description": "Save URL as ip or name in datafile.",
    "enum": [
      "ip",
      "name"
    ]
  },
  "dansguardian_conf": {
    "type": "string",
    "default": "none",
    "description": "DansGuardian config file path."
  },
  "dansguardian_filter_out_date": {
    "type": "string",
    "default": "on",
    "description": "Filter DansGuardian records by date."
  },
  "squidguard_conf": {
    "type": "string",
    "default": "none",
    "description": "SquidGuard config file path."
  },
  "redirector_log": {
    "type": "string",
    "default": "/usr/local/squidGuard/var/logs/urls.log",
    "description": "Redirector log file path."
  },
  "redirector_filter_out_date": {
    "type": "string",
    "default": "on",
    "description": "Filter redirector records by date."
  },
  "redirector_log_format": {
    "type": "string",
    "default": "#year#-#mon#-#day# #hour# #tmp#/#list#/#tmp#/#tmp#/#url#/#tmp# #ip#/#tmp# #user# #end#",
    "description": "Format string for redirector logs."
  },
  "show_sarg_info": {
    "type": "string",
    "default": "yes",
    "description": "Show Sarg info in report.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "show_sarg_logo": {
    "type": "string",
    "default": "yes",
    "description": "Show Sarg logo in report.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "parsed_output_log": {
    "type": "string",
    "default": "none",
    "description": "Directory for parsed output log."
  },
  "parsed_output_log_compress": {
    "type": "string",
    "default": "/bin/gzip",
    "description": "Command to compress parsed output log."
  },
  "displayed_values": {
    "type": "string",
    "default": "bytes",
    "description": "How values are displayed (bytes or abbreviation).",
    "enum": [
      "bytes",
      "abbreviation"
    ]
  },
  "authfail_report_limit": {
    "type": "number",
    "default": 10,
    "description": "Limit for auth fail reports."
  },
  "denied_report_limit": {
    "type": "number",
    "default": 10,
    "description": "Limit for denied reports."
  },
  "siteusers_report_limit": {
    "type": "number",
    "default": 0,
    "description": "Limit for site users reports."
  },
  "squidguard_report_limit": {
    "type": "number",
    "default": 10,
    "description": "Limit for squidguard reports."
  },
  "dansguardian_report_limit": {
    "type": "number",
    "default": 10,
    "description": "Limit for dansguardian reports."
  },
  "user_report_limit": {
    "type": "number",
    "default": 10,
    "description": "Limit for user reports."
  },
  "user_report_limit_2": {
    "type": "number",
    "default": 50,
    "description": "Secondary limit for user reports."
  },
  "www_document_root": {
    "type": "string",
    "default": "/var/www/html",
    "description": "Web DocumentRoot directory."
  },
  "block_it": {
    "type": "string",
    "default": "none",
    "description": "URL for blocking module."
  },
  "external_css_file": {
    "type": "string",
    "default": "none",
    "description": "Path to external CSS file."
  },
  "user_authentication": {
    "type": "string",
    "default": "no",
    "description": "Enable user authentication in reports.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "AuthUserTemplateFile": {
    "type": "string",
    "default": "sarg_htaccess",
    "description": "Template for .htaccess file."
  },
  "download_suffix": {
    "type": "string",
    "default": "zip,arj,bzip,gz,ace,doc,iso,adt,bin,cab,com,dot,drv$,lha,lzh,mdb,mso,ppt,rtf,src,shs,sys,exe,dll,mp3,avi,mpg,mpeg",
    "description": "Suffixes considered as downloads."
  },
  "ulimit": {
    "type": "number",
    "default": 20000,
    "description": "Maximum number of open file descriptors."
  },
  "ntlm_user_format": {
    "type": "string",
    "default": "domainname+username",
    "description": "Format for NTLM users.",
    "enum": [
      "username",
      "domainname+username"
    ]
  },
  "realtime_refresh_time": {
    "type": "number",
    "default": 3,
    "description": "Refresh time for realtime report."
  },
  "realtime_access_log_lines": {
    "type": "number",
    "default": 1000,
    "description": "Number of last lines to get for realtime."
  },
  "realtime_types": {
    "type": "string",
    "default": "GET,PUT,CONNECT",
    "description": "Types of records for realtime report."
  },
  "realtime_unauthenticated_records": {
    "type": "string",
    "default": "show",
    "description": "Handling of unauthenticated records in realtime.",
    "enum": [
      "ignore",
      "show"
    ]
  },
  "byte_cost_value": {
    "type": "string",
    "default": "0.01",
    "description": "Cost per byte."
  },
  "byte_cost_no_cost_limit": {
    "type": "number",
    "default": 50000000,
    "description": "Bytes with no cost."
  },
  "squid24": {
    "type": "string",
    "default": "off",
    "description": "Compatibility with Squid <= 2.4."
  }
}
