{% if LDAPFilterSearch is defined and LDAPFilterSearch is not none and (LDAPFilterSearch is number or LDAPFilterSearch is boolean or LDAPFilterSearch | length > 0) %}LDAPFilterSearch {{ LDAPFilterSearch }}
{% else %}#LDAPFilterSearch uid=%s
