#
{% if LDAPBaseSearch is defined and LDAPBaseSearch is not none and (LDAPBaseSearch is number or LDAPBaseSearch is boolean or LDAPBaseSearch | length > 0) %}LDAPBaseSearch {{ LDAPBaseSearch }}
