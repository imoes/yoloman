#
{% if LDAPTargetAttr is defined and LDAPTargetAttr is not none and (LDAPTargetAttr is number or LDAPTargetAttr is boolean or LDAPTargetAttr | length > 0) %}LDAPTargetAttr {{ LDAPTargetAttr }}
{% else %}#LDAPTargetAttr cn
