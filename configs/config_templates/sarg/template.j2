# TAG: parsed_output_log directory
#      Saves the processed log in a sarg format after parsing the squid log file.
#      This is a way to dump all of the data structures out, after parsing from 
#      the logs (presumably this data will be much smaller than the log files themselves),
#      and pull them back in for later processing and merging with data from previous logs.
#
{% if parsed_output_log is defined and parsed_output_log is not none and (parsed_output_log is number or parsed_output_log is boolean or parsed_output_log | length > 0) %}parsed_output_log {{ parsed_output_log }}
{% else %}#parsed_output_log none
{% endif %}
# TAG: parsed_output_log_compress /bin/gzip|/usr/bin/bzip2|nocompress
