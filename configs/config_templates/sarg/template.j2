#      Note the change of parameter value compared with the old options.
#      'off' use the record even if its date is outside of the range found in the input log file.
#      'on'  use the record only if its date is in the range found in the input log file.
#
{% if redirector_filter_out_date is defined and redirector_filter_out_date is not none and (redirector_filter_out_date is number or redirector_filter_out_date is boolean or redirector_filter_out_date | length > 0) %}redirector_filter_out_date {{ redirector_filter_out_date }}
