#      SQUIDGUARD  #year#-#mon#-#day# #hour# #tmp#/#list#/#tmp#/#tmp#/#url#/#tmp# #ip#/#tmp# #user# #end#
#
{% if redirector_log_format is defined and redirector_log_format is not none and (redirector_log_format is number or redirector_log_format is boolean or redirector_log_format | length > 0) %}redirector_log_format {{ redirector_log_format }}
