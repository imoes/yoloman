{% else %}#output_dir /var/www/html/squid-reports
{% endif %}output_dir {{ output_dir }}

# TAG:  output_email
#       Email address to send the reports. If you use this tag, no html reports will be generated.
#       sarg -e email
#
{% if output_email is defined and output_email is not none and (output_email is number or output_email is boolean or output_email | length > 0) %}output_email {{ output_email }}
{% else %}#output_email none
{% endif %}
# TAG:  resolve_ip yes/no
#       Convert ip address to dns name
#       sarg -n
resolve_ip {{ resolve_ip | lower }}

# TAG:  user_ip yes/no
#       Use Ip Address instead userid in reports.
#       sarg -p
user_ip {{ user_ip | lower }}

# TAG:  topuser_sort_field field normal/reverse
#       Sort field for the Topuser Report.
#       Allowed fields: USER CONNECT BYTES TIME
#
topuser_sort_field {{ topuser_sort_field_field }} {{ topuser_sort_field_order }}

# TAG:  user_sort_field field normal/reverse
#       Sort field for the User Report.
#       Allowed fields: SITE CONNECT BYTES TIME
#
user_sort_field {{ user_sort_field_field }} {{ user_sort_field_order }}

# TAG:  exclude_users file
#       users within the file will be excluded from reports.
#       you can use indexonly to have only index.html file.
#
exclude_users {{ exclude_users }}

# TAG:  exclude_hosts file
#       Hosts, domains or subnets will be excluded from reports.
#
#       Eg.: 192.168.10.10   - exclude ip address only
#            192.168.10.0/24 - exclude full C class
#            s1.acme.foo     - exclude hostname only
#            *.acme.foo      - exclude full domain name
#
exclude_hosts {{ exclude_hosts }}

# TAG:  useragent_log file
#       useragent.log file patch to generate useragent report.
#
{% if useragent_log is defined and useragent_log is not none and (useragent_log is number or useragent_log is boolean or useragent_log | length > 0) %}useragent_log {{ useragent_log }}
{% else %}#useragent_log none
{% endif %}
# TAG:  date_format
#       Date format in reports: e (European=dd/mm/yy), u (American=mm/dd/yy), w (Weekly=yy.ww)
#       
date_format {{ date_format }}

# TAG:  per_user_limit file MB
#       Saves userid on file if download exceed n MB.
#       This option allow you to disable user access if user exceed a download limit.
#       
{% if per_user_limit is defined and per_user_limit is not none and (per_user_limit is number or per_user_limit is boolean or per_user_limit | length > 0) %}per_user_limit {{ per_user_limit }}
{% else %}#per_user_limit none
{% endif %}
# TAG: lastlog n
#      How many reports files must be keept in reports directory.
#      The oldest report file will be automatically removed.
#      0 - no limit.
#
lastlog {{ lastlog }}

# TAG: remove_temp_files yes
#      Remove temporary files: geral, usuarios, top, periodo from root report directory.
#
remove_temp_files {{ remove_temp_files | lower }}

# TAG: index yes|no|only
#      Generate the main index.html.
#      only - generate only the main index.html
#
index {{ index }}

# TAG: index_tree date|file
#      How to generate the index.
#
index_tree {{ index_tree }}

# TAG: overwrite_report yes|no
#      yes - if report date already exist then will be overwrited.
#       no - if report date already exist then will be renamed to filename.n, filename.n+1
#
overwrite_report {{ overwrite_report | lower }}

# TAG: records_without_userid ignore|ip|everybody
#      What can I do with records without user id (no authentication) in access.log file ?
#
#      ignore - This record will be ignored.
#          ip - Use ip address instead. (default)
#   everybody - Use "everybody" instead.
#
records_without_userid {{ records_without_userid }}

# TAG: use_comma no|yes
#      Use comma instead point in reports.
#      Eg.: use_comma yes => 23,450,110
#           use_comma no  => 23.450.110
#
use_comma {{ use_comma | lower }}

# TAG: mail_utility mail|mailx
#      Mail command to use to send reports via SMTP
#
mail_utility {{ mail_utility }}

# TAG: topsites_num n
#      How many sites in topsites report.
#
topsites_num {{ topsites_num }}

# TAG: topsites_sort_order CONNECT|BYTES A|D
#      Sort for topsites report, where A=Ascendent, D=Descendent
#
topsites_sort_order {{ topsites_sort_order_field }} {{ topsites_sort_order_order }}

# TAG: index_sort_order A/D
#      Sort for index.html, where A=Ascendent, D=Descendent
#
index_sort_order {{ index_sort_order }}

# TAG: exclude_codes file
#      Ignore records with these codes. Eg.: NONE/400
#      Write one code per line. Lines starting with a # are ignored.
#      Only codes matching exactly one of the line is rejected. The
#      comparison is not case sensitive.
#
exclude_codes {{ exclude_codes }}

# TAG: replace_index string
#      Replace "index.html" in the main index file with this string
#      If null "index.html" is used 
#
{% if replace_index is defined and replace_index is not none and (replace_index is number or replace_index is boolean or replace_index | length > 0) %}replace_index {{ replace_index }}
{% else %}#replace_index <?php echo str_replace(".", "_", $REMOTE_ADDR); echo ".html"; ?>
{% endif %}
# TAG: max_elapsed milliseconds
#      If elapsed time is recorded in log is greater than max_elapsed use 0 for elapsed time.
#      Use 0 for no checking 
#
max_elapsed {{ max_elapsed }}
# 8 Hours

# TAG: report_type type
#      What kind of reports to generate.
#      topusers            - users, sites, times, bytes, connects, links to accessed sites, etc
#      topsites		   - site, connect and bytes report
#      sites_users	   - users and sites report
#      users_sites	   - accessed sites by the user report
#      date_time	   - bytes used per day and hour report
#      denied		   - denied sites with full URL report
#      auth_failures       - autentication failures report
#      site_user_time_date - sites, dates, times and bytes report
#      downloads           - downloads per user report
#
#      Eg.: report_type topsites denied 
#
{% if report_type is defined and report_type is not none and (report_type is number or report_type is boolean or report_type | length > 0) %}report_type {{ report_type }}
{% else %}#report_type topusers topsites sites_users users_sites date_time denied auth_failures site_user_time_date downloads
{% endif %}
# TAG: usertab filename
#      You can change the "userid" or the "ip address" to be a real user name on the reports.
#      If resolve_ip is active, the ip address is resolved before being looked up into this
#      file. That is, if you want to map the ip address, be sure to set resolv_ip to no or
#      the resolved name will be looked into the file instead of the ip address. Note that
#      it can be used to resolve any ip address known to the dns and then map the unresolved
#      ip addresses to a name found in the usertab file.
#      Table syntax:
# 		userid name   or   ip address name
#      Eg:
#		SirIsaac Isaac Newton
#		vinci Leonardo da Vinci
#		192.168.10.1 Karol Wojtyla
#
#      Each line must be terminated with '\n'
#      If usertab have value "ldap" (case ignoring), user names
#      will be taken from LDAP server. This method as approaches for reception
#      of usernames from Active Didectory
#
usertab {{ usertab }}

# TAG: LDAPHost hostname
#	FQDN or IP address of host with LDAP service or AD DC
#	default is '127.0.0.1'
#
{% if LDAPHost is defined and LDAPHost is not none and (LDAPHost is number or LDAPHost is boolean or LDAPHost | length > 0) %}LDAPHost {{ LDAPHost }}
{% else %}#LDAPHost 127.0.0.1
{% endif %}
# TAG: LDAPPort port
#       LDAP service port number
#	default is '389'
#
{% if LDAPPort is defined and LDAPPort is not none and (LDAPPort is number or LDAPPort is boolean or LDAPPort | length > 0) %}LDAPPort {{ LDAPPort }}
{% else %}#LDAPPort 389
{% endif %}
# TAG: LDAPBindDN CN=username,OU=group,DC=mydomain,DC=com
