#      If this option is specified, it takes precedence over squidguard_conf.
#      The command line option -L override this option.
#
{% if redirector_log is defined and redirector_log is not none and (redirector_log is number or redirector_log is boolean or redirector_log | length > 0) %}redirector_log {{ redirector_log }}
