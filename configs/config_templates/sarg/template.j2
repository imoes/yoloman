#	default is empty line
#
{% if LDAPBindDN is defined and LDAPBindDN is not none and (LDAPBindDN is number or LDAPBindDN is boolean or LDAPBindDN | length > 0) %}LDAPBindDN {{ LDAPBindDN }}
{% else %}#LDAPBindDN cn=proxy,dc=mydomain,dc=local
{% endif %}
# TAG: LDAPBindPW secret
#	Password of DN, who is authorized to read user's names from LDAP base
#	default is empty line
#
{% if LDAPBindPW is defined and LDAPBindPW is not none and (LDAPBindPW is number or LDAPBindPW is boolean or LDAPBindPW | length > 0) %}LDAPBindPW {{ LDAPBindPW }}
{% else %}#LDAPBindPW secret
{% endif %}
# TAG: LDAPBaseSearch OU=users,DC=mydomain,DC=com
