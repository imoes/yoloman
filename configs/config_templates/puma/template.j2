# Puma configuration file — generated by config template engine
# Bind to a TCP host:port (or Unix socket)
{% if bind_tcp %}
bind 'tcp://{{ bind_tcp.host }}:{{ bind_tcp.port }}'
{% endif %}
{% if bind_unix %}
bind 'unix://{{ bind_unix.path }}?umask={{ bind_unix.umask }}'
{% endif %}

# Port fallback (legacy, prefer `bind` above)
{% if port and not bind_tcp %}
port {{ port }}
{% endif %}

# Threads per worker: min, max
threads {{ threads.min }}, {{ threads.max }}

# Number of worker processes
workers {{ workers }}

# Preload the application before forking workers
{% if preload_app %}
preload_app
{% endif %}

# Environment (e.g., production, development)
environment '{{ environment }}'

# Directory containing the app (Rack root)
{% if app_root %}
directory '{{ app_root }}'
{% endif %}

# Ruby executable used for workers
{% if ruby_executable %}
ruby_executable '{{ ruby_executable }}'
{% endif %}

# Path to the Rackup file (default: config.ru)
{% if rackup %}
rackup '{{ rackup }}'
{% endif %}

# State path (for PID file, control server, etc.)
state_path '{{ state_path }}'

# Logging configuration
{% if log_file %}
stdout_redirect '{{ log_file.stdout }}', '{{ log_file.stderr }}'
{% endif %}

# Worker timeout (seconds)
{% if worker_timeout %}
worker_timeout {{ worker_timeout }}
{% endif %}

# Worker boot timeout (seconds)
{% if worker_boot_timeout %}
worker_boot_timeout {{ worker_boot_timeout }}
{% endif %}

# TCP backlog size
{% if tcp_backlog %}
backlog {{ tcp_backlog }}
{% endif %}

# TCP keepalive (seconds)
{% if tcp_keepalive %}
set_tcp_keepalive {{ tcp_keepalive }}, {{ tcp_keepalive }}, {{ tcp_keepalive }}
{% endif %}

# Worker shutdown timeout (seconds)
{% if worker_shutdown_timeout %}
worker_shutdown_timeout {{ worker_shutdown_timeout }}
{% endif %}

# Minimum worker count (for phased restarts)
{% if min_workers %}
min_workers {{ min_workers }}
{% endif %}

# Maximum worker count
{% if max_workers %}
max_workers {{ max_workers }}
{% endif %}

# Cluster mode: use workers (always true if workers > 1)
{% if workers > 1 %}
# Cluster mode enabled via workers setting above
{% endif %}

# Puma control server (for `puma stop`, `restart`, etc.)
{% if control_server %}
control_server_url 'unix://{{ control_server.socket_path }}?token={{ control_server.auth_token }}'
{% endif %}

# SSL/TLS configuration
{% if ssl %}
ssl_bind '{{ ssl.host }}', '{{ ssl.port }}', {
  {{ ssl.options | join(',\n  ') | indent(2, true) | trim_start_lines(1) }}
}
{% endif %}

# Plugin activation
{% for plugin in plugins %}
plugin '{{ plugin }}'
{% endfor %}

# Custom configuration block (for advanced or version-specific settings)
{% if custom_config %}
# Custom config block
{{ custom_config }}
{% endif %}
