# ---------------------------------------------------------------------------
# Puma configuration file — self-documented
# Generated by Ansible Jinja2 template engine
#
# This template configures Puma, a Ruby web server. It supports TCP binding,
# process management, SSL, and various runtime options. All variables are
# provided with safe defaults to ensure idempotent rendering even if the
# caller omits specific fields.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Networking / Bind Address
# ---------------------------------------------------------------------------

# Bind to a specific TCP host and port.
# Schema: bind_tcp (map), items (map - alias), host (string), port (int)
# Note: `items` is treated as an alias for `bind_tcp` to support legacy naming conventions.
{% set bind_tcp = bind_tcp | default(items | default({})) %}
{% if bind_tcp is mapping and bind_tcp %}
# Bind to a specific TCP host and port.
# `host` and `port` are required if `bind_tcp` is used.
# Overrides the legacy `port` directive.
bind 'tcp://{{ bind_tcp.host | default("0.0.0.0") | string }}:{{ bind_tcp.port | default(8080) | string }}'
{% endif %}

# Bind to a Unix domain socket.
# `path` is required. `umask` defaults to 007.
# Note: `bind_unix` is not in schema, but preserved for backwards compatibility if present.
{% if bind_unix is defined and bind_unix is mapping and bind_unix %}
bind 'unix://{{ bind_unix.path | default("/var/run/puma/puma.sock") | string }}?umask={{ bind_unix.umask | default(7) | string }}'
{% endif %}

# Legacy port fallback.
# Only used if `bind_tcp` is NOT provided.
# Specifies the TCP port Puma listens on.
# Schema: port (int)
# Note: This block is skipped if `bind_tcp` is defined and non-empty, as `bind_tcp` overrides `port`.
{% if not bind_tcp or not (bind_tcp is mapping and bind_tcp) %}
{% if port is defined %}
port {{ port | default(8080) | int }}
{% endif %}
{% endif %}

# ---------------------------------------------------------------------------
# Process Management
# ---------------------------------------------------------------------------

# Number of threads per worker process.
# Format: threads min, max
# Defaults to 1 min, 1 max if not specified.
# Note: `threads` is not in schema, but preserved if present in vars.
{% set threads_cfg = threads | default({'min': 1, 'max': 1}) %}
{% if threads_cfg is mapping %}
threads {{ threads_cfg.min | default(1) | int }}, {{ threads_cfg.max | default(1) | int }}
{% else %}
# threads directive requires a map with min/max keys
{% endif %}

# Number of worker processes (forks).
# Set to 1 for single-process mode, >1 for cluster mode.
# Default is 2.
# Note: `workers` is not in schema, but preserved if present in vars.
workers {{ workers | default(2) | int }}

# Preload the application code before forking workers.
# Recommended for production to save memory via Copy-on-Write.
# Only applies if `workers` > 1.
# Note: `preload_app` is not in schema, but preserved if present in vars.
{% if preload_app is defined and preload_app | bool %}
preload_app
{% endif %}

# ---------------------------------------------------------------------------
# Application Context
# ---------------------------------------------------------------------------

# Environment name (e.g., production, development, test).
# Used for environment-specific configuration.
# Defaults to 'production'.
# Note: `environment` is not in schema, but preserved if present in vars.
environment '{{ environment | default("production") | string }}'

# Root directory of the application (Rack root).
# Puma will chdir to this directory.
# Note: `app_root` is not in schema, but preserved if present in vars.
{% if app_root is defined %}
directory '{{ app_root | string }}'
{% endif %}

# Path to the Ruby executable to use for worker processes.
# Useful if multiple Ruby versions are installed.
# Note: `ruby_executable` is not in schema, but preserved if present in vars.
{% if ruby_executable is defined %}
ruby_executable '{{ ruby_executable | string }}'
{% endif %}

# Path to the Rackup file (usually config.ru).
# Specifies the entry point for the Rack application.
# Note: `rackup` is not in schema, but preserved if present in vars.
{% if rackup is defined %}
rackup '{{ rackup | string }}'
{% endif %}

# ---------------------------------------------------------------------------
# State and Logging
# ---------------------------------------------------------------------------

# Path to the state file.
# Used for PID storage and control server coordination.
# Defaults to './tmp/pids/pida.pid' if not specified,
# but often explicitly set in containerized envs to /dev/null or tmpfs.
# Note: `state_path` is not in schema, but preserved if present in vars.
state_path '{{ state_path | default("/dev/null") | string }}'

# Logging configuration.
# Redirects stdout and stderr to files.
# `stdout` and `stderr` fields in `log_file` map to output files.
# Note: `log_file` is not in schema, but preserved if present in vars.
{% if log_file is defined and log_file is mapping and log_file %}
stdout_redirect '{{ log_file.stdout | default("/dev/stdout") | string }}', '{{ log_file.stderr | default("/dev/stderr") | string }}'
{% endif %}

# ---------------------------------------------------------------------------
# Timeouts
# ---------------------------------------------------------------------------

# Worker timeout (seconds).
# Workers exceeding this time are killed and respawned.
# Default is 60 seconds.
# Note: `worker_timeout` is not in schema, but preserved if present in vars.
{% if worker_timeout is defined %}
worker_timeout {{ worker_timeout | default(60) | int }}
{% endif %}

# Worker boot timeout (seconds).
# Time allowed for a worker to start up and become ready.
# Default is 60 seconds.
# Note: `worker_boot_timeout` is not in schema, but preserved if present in vars.
{% if worker_boot_timeout is defined %}
worker_boot_timeout {{ worker_boot_timeout | default(60) | int }}
{% endif %}

# ---------------------------------------------------------------------------
# TCP Options
# ---------------------------------------------------------------------------

# TCP backlog size.
# Maximum number of pending connections in the kernel listen queue.
# Default is determined by the OS, often 1024 or 4096.
# Note: `tcp_backlog` is not in schema, but preserved if present in vars.
{% if tcp_backlog is defined %}
backlog {{ tcp_backlog | default(1024) | int }}
{% endif %}

# TCP keepalive settings.
# Sets socket keepalive parameters: interval, time, count.
# Example: set_tcp_keepalive 60, 10, 5
# Note: `tcp_keepalive` is not in schema, but preserved if present in vars.
{% if tcp_keepalive is defined %}
{% if tcp_keepalive is iterable and not tcp_keepalive is mapping %}
set_tcp_keepalive {{ tcp_keepalive | join(', ') }}
{% else %}
set_tcp_keepalive {{ tcp_keepalive | default(60) | int }}, {{ tcp_keepalive | default(60) | int }}, {{ tcp_keepalive | default(60) | int }}
{% endif %}
{% endif %}

# Worker shutdown timeout (seconds).
# Time allowed for workers to finish processing current requests
# before being forcibly terminated during restart/stop.
# Default is 15 seconds.
# Note: `worker_shutdown_timeout` is not in schema, but preserved if present in vars.
{% if worker_shutdown_timeout is defined %}
worker_shutdown_timeout {{ worker_shutdown_timeout | default(15) | int }}
{% endif %}

# ---------------------------------------------------------------------------
# Dynamic Worker Scaling (Cluster Mode)
# ---------------------------------------------------------------------------

# Minimum number of worker processes.
# Used for phased restarts to ensure availability.
# Must be less than or equal to max_workers.
# Note: `min_workers` is not in schema, but preserved if present in vars.
{% if min_workers is defined %}
min_workers {{ min_workers | default(0) | int }}
{% endif %}

# Maximum number of worker processes.
# Puma can scale up to this number based on load.
# Note: `max_workers` is not in schema, but preserved if present in vars.
{% if max_workers is defined %}
max_workers {{ max_workers | default(0) | int }}
{% endif %}

# ---------------------------------------------------------------------------
# Control Server
# ---------------------------------------------------------------------------

# Control server URL.
# Allows external tools (e.g., `puma restart`) to control the server.
# Typically uses a Unix socket for local control.
# Note: `control_server` is not in schema, but preserved if present in vars.
{% if control_server is defined and control_server is mapping and control_server %}
control_server_url 'unix://{{ control_server.socket_path | default("/run/puma/puma.sock") | string }}?token={{ control_server.auth_token | default("secret") | string }}'
{% endif %}

# ---------------------------------------------------------------------------
# SSL/TLS Configuration
# ---------------------------------------------------------------------------

# SSL/TLS bind configuration.
# Enables HTTPS on the specified host and port.
# `options` is a list of SSL options (e.g., 'SSLv3', 'TLSv1_2').
# Note: `ssl` is not in schema, but preserved if present in vars.
{% if ssl is defined and ssl is mapping and ssl %}
ssl_bind '{{ ssl.host | default("0.0.0.0") | string }}', '{{ ssl.port | default(9292) | string }}', {
  {% if ssl.options is defined and ssl.options is iterable %}
  {{ ssl.options | join(', ') }}
  {% endif %}
}
{% endif %}

# ---------------------------------------------------------------------------
# Plugins
# ---------------------------------------------------------------------------

# Activate Puma plugins.
# Plugins extend Puma's functionality (e.g., statsd, systemd).
# Note: `plugins` is not in schema, but preserved if present in vars.
{% if plugins is defined and plugins is iterable %}
{% for plugin in plugins %}
plugin '{{ plugin | string }}'
{% endfor %}
{% endif %}

# ---------------------------------------------------------------------------
# Custom Configuration
# ---------------------------------------------------------------------------

# Custom configuration block.
# Allows arbitrary Puma configuration directives not covered by
# the standard schema fields. Use with caution.
# Note: `custom_config` is not in schema, but preserved if present in vars.
{% if custom_config is defined and custom_config %}
# Custom config block
{{ custom_config | string }}
{% endif %}