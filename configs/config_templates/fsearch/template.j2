# /etc/fsearch.conf - Configuration file for fsearch
# This file manages the configuration for the fsearch tool.
# Each line consists of a key=value pair.
# Options are defined by the 'options' variable, which must be a list of dictionaries
# containing 'key' and 'value' fields. An optional 'description' can be provided
# for documentation purposes in the generated file.

# Iterate over the list of configuration options provided by the user.
# Default to an empty list if 'options' is not defined.
{% for item in options | default([], true) %}
# {{ item.description | default('Configuration option: ' + item.key) }}
{{ item.key }}={{ item.value }}
{% endfor %}