# /etc/security/pwhistory.conf — PAM module configuration for password history enforcement
# Enables password history tracking using pam_pwhistory.so
# Controls how many old passwords are remembered to prevent reuse
# Sets the minimum number of changes required before a password may be reused
# Configures the location of the password history file (default: /etc/security/opasswd)
# Enables/disables logging of password change events
# Controls whether root bypasses history checks

# pam_pwhistory options
remember = {{ values.remember }}
retry_count = {{ values.retry_count }}
file = {{ values.file }}
enable_audit = {% if values.enable_audit %}yes{% else %}no{% endif %}
root_min_delay = {{ values.root_min_delay }}

{% for rule in values.rules %}
# Custom rule {{ loop.index }}: {{ rule.description or 'No description' }}
{{ rule.name }} = {{ rule.value }}
{% endfor %}