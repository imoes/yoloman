#!/bin/sh
# Updates information whenever a network interface is brought up.
# This script is part of the wide-dhcpv6-client service configuration.
# It reads environment variables from /etc/default/wide-dhcpv6-client
# and controls the dhcp6c client process.

# Skip loopback interface to avoid unnecessary processing
[ "$IFACE" = "lo" ] && exit 0

# Ensure the default configuration file exists and is readable
# This file typically contains MODE, INTERFACES, VERBOSITY, etc.
[ -r /etc/default/wide-dhcpv6-client ] || exit 0

# Check if the dhcp6c binary is executable at the configured path.
# Path is configurable via dhcp6c_bin field.
# Default: /usr/sbin/dhcp6ctl
[ -x {{ dhcp6c_bin | default('/usr/sbin/dhcp6ctl') }} ] || exit 0

# Determine the service name to check for existing processes.
# If dhcp6c_name is defined and non-empty, use it; otherwise default to 'dhcp6c'.
# This allows overriding the process name identifier if needed.
{% if dhcp6c_name is defined and dhcp6c_name is not none and (dhcp6c_name is string and dhcp6c_name | length > 0) %}
# Check if {{ dhcp6c_name | default('dhcp6c') }} is running
{% else %}
# Check if dhcp6c is running
{% endif %}
{% set service_name = dhcp6c_name | default('dhcp6c') %}
pidof {{ service_name }} > /dev/null 2>&1 ; [ $? -eq 1 ] && exit 0

# Source the default configuration file to load MODE, INTERFACES, VERBOSITY, etc.
. /etc/default/wide-dhcpv6-client

case $MODE in
    start|stop)
        # Iterate over the configured interfaces
        for i in $INTERFACES ; do
            if [ "$IFACE" = "$i" ] ; then
                # Execute the dhcp6c command with the current mode (start/stop)
                # and the interface name
                {{ dhcp6c_bin | default('/usr/sbin/dhcp6ctl') }} $MODE interface $IFACE
                exit 0
            fi
        done
    ;;
    *)
        # Handle unknown modes with verbosity check
        if [ "$VERBOSITY" = "1" ] ; then
            echo "dhcp6c-ifupdown: unknown mode \"$MODE\""
        fi
        exit 1
    ;;
esac
