#!/bin/sh
### BEGIN INIT INFO
# Provides:          wide-dhcpv6-client
# Required-Start:    $syslog $network $remote_fs
# Required-Stop:     $syslog $remote_fs
# Should-Start:      $local_fs
# Should-Stop:       $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start/Stop WIDE DHCPv6 client
# Description:       {{ dhcp6c_desc | default('WIDE DHCPv6 client') }}
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin

# Path to the dhcp6c binary executable
DHCP6CBIN={{ dhcp6c_bin | default('/usr/sbin/dhcp6c') }}

# Path to the PID file for the dhcp6c daemon
DHCP6CPID={{ dhcp6c_pid_file | default('/var/run/dhcp6c.pid') }}

# Name identifier for the service
NAME="{{ dhcp6c_name | default('dhcp6c') }}"

# Human-readable description of the service
DESC="{{ dhcp6c_desc | default('WIDE DHCPv6 client') }}"

# Retry schedule for stopping the daemon (signal/delay/count/signal/delay)
STOP_RETRY_SCHEDULE='{{ stop_retry_schedule | default('TERM/20/forever/KILL/1') }}'

. /lib/lsb/init-functions

test -x $DHCP6CBIN || exit 0

if [ ! -f /etc/default/wide-dhcpv6-client ]; then
    exit 0
else
    . /etc/default/wide-dhcpv6-client
fi

# Ensure INTERFACES is defined; exit if not provided
[ "X$INTERFACES" != "X" ] || exit 0

# Determine debug flags based on verbosity level
case "$VERBOSE" in
    1)  DEBUG="-d"
        ;;
    2)  DEBUG="-D"
        ;;
    *)  DEBUG=""
esac

# single arg is -v for messages, -q for none
check_status()
{
    if [ ! -r "$DHCP6CPID" ]; then
        test "$1" != -v || echo "$NAME is not running."
        return 3
    fi
    if read pid < "$DHCP6CPID" && ps -p "$pid" > /dev/null 2>&1; then
        test "$1" != -v || echo "$NAME is running."
        return 0
    else
        test "$1" != -v || echo "$NAME is not running but $DHCP6CPID exists."
        return 1
    fi
}

case "$1" in
	start)
		log_daemon_msg "Starting $DESC" "$NAME"
		start-stop-daemon --start --quiet --pidfile $DHCP6CPID \
			--oknodo --exec $DHCP6CBIN -- $DEBUG -Pdefault $INTERFACES
		sleep 2
		if check_status -q; then
			log_end_msg 0
		else
			log_end_msg 1
			exit 1
		fi
		;;
	stop)
		log_daemon_msg "Stopping $DESC" "$NAME"
		start-stop-daemon --stop --quiet --retry $STOP_RETRY_SCHEDULE \
                    --pidfile $DHCP6CPID --oknodo
		log_end_msg $?
		rm -f $DHCP6CPID
		;;
	restart|force-reload)
		$0 stop
		sleep 2
		$0 start
		if [ "$?" != "0" ]; then
			exit 1
		fi
		;;
	status)
		echo "Status of $NAME: "
		check_status -v
		exit "$?"
		;;
	*)
		echo "Usage: $0 (start|stop|restart|force-reload|status)"
		exit 1
esac

exit 0