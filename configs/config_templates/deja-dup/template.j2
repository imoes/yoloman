#
# Self-documenting template for Deja Dup Monitor Desktop Entry.
# This file creates a standard .desktop entry used by the desktop environment
# to launch and manage the Deja Dup backup monitor service.
#
# All variable references use the `default()` filter to ensure safe rendering
# even if specific variables are not defined in the Ansible inventory.

[Desktop Entry]

# Display name of the desktop entry.
# Schema default: 'Backup Monitor'
Name={{ name | default('Backup Monitor') }}

# Description/comment of the desktop entry.
# Schema default: 'Schedules backups at regular intervals'
Comment={{ comment | default('Schedules backups at regular intervals') }}

# Icon name or path for the desktop entry.
# Schema default: 'org.gnome.DejaDup'
Icon={{ icon | default('org.gnome.DejaDup') }}

# Command to execute when launching the application.
# Schema default: '/usr/libexec/deja-dup/deja-dup-monitor'
Exec={{ exec | default('/usr/libexec/deja-dup/deja-dup-monitor') }}

# Delay (in seconds) before starting the autostart application.
# Schema default: 120
X-GNOME-Autostart-Delay={{ autostart_delay | default(120) }}

# Whether to send startup notification.
# Schema default: False (converted to string 'false')
StartupNotify={{ startup_notify | default(False) | ternary('true', 'false') }}

# Whether to hide the desktop entry from menus.
# Schema default: True (converted to string 'true')
NoDisplay={{ no_display | default(True) | ternary('true', 'false') }}

# Type of desktop entry.
# Schema default: 'Application'
Type={{ type | default('Application') }}

# Categories in which this desktop entry should appear.
# Schema default: 'Utility;Archiving'
Categories={{ categories | default('Utility;Archiving') }}