# =============================================================================
# htmlmin configuration file
# Generated by Ansible Jinja2 template
# https://htmlmin.readthedocs.io/en/latest/
#
# This configuration file controls how the htmlmin tool processes HTML input.
# It determines which whitespace, comments, and optional quotes are removed,
# and how special tags are handled.
# =============================================================================

# Remove HTML comments from the output.
# Comments starting with '<!--!' (e.g., IE conditional comments) are preserved.
remove_comments: {{ remove_comments | default(false) | lower }}

# Remove empty whitespace between tags only if a newline occurs within that space.
# This preserves intentional spacing that isn't just a single newline.
remove_empty_space: {{ remove_empty_space | default(false) | lower }}

# Remove ALL empty space between tags, regardless of newlines.
# Use with caution as it may break content in preformatted or inline contexts.
remove_all_empty_space: {{ remove_all_empty_space | default(false) | lower }}

# Keep optional quotes on attributes even if they are not strictly required by HTML spec.
# E.g., keeps <input disabled="disabled"> as is, rather than minifying to <input disabled>.
keep_optional_attribute_quotes: {{ keep_optional_attribute_quotes | default(false) | lower }}

# Treat the input document as an HTML fragment located specifically within the <head> section.
# This may affect how certain head-specific minifications are applied.
in_head: {{ in_head | default(false) | lower }}

# Keep the proprietary 'pre' attribute in the final output if it was present in the input.
# This allows downstream tools or browsers to recognize pre-minification blocks.
keep_pre_attr: {{ keep_pre_attr | default(false) | lower }}

# Name of the attribute that marks HTML blocks to be excluded from minification.
# Elements possessing this attribute will have their content preserved exactly as-is.
pre_attr: {{ pre_attr | default('pre') }}

# List of tag names whose content should not be minified.
# Script and style tags are ALWAYS excluded from minification regardless of this list.
# The list is joined with commas in the final configuration.
# Note: The template renders this as a comma-separated string because htmlmin's INI-style config expects that format.
# Ensure the input variable 'pre_tags' is a list of strings.
pre_tags: {{ pre_tags | default(['pre', 'textarea']) | join(', ') }}

# Character encoding used for reading input and writing output files.
# Common values: 'utf-8', 'iso-8859-1', 'ascii'.
encoding: {{ encoding | default('utf-8') }}