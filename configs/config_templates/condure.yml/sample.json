{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080,
      "tls": null
    },
    {
      "address": "0.0.0.0",
      "port": 8443,
      "tls": {
        "cert_file": "/etc/condure/tls/cert.pem",
        "key_file": "/etc/condure/tls/key.pem"
      }
    }
  ],
  "trusted_proxies": [
    "127.0.0.1",
    "::1",
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "http2": {
    "enabled": true,
    "max_concurrent_streams": 200
  },
  "websocket": {
    "ping_interval": 45,
    "idle_timeout": 900,
    "max_frame_size": 131072
  },
  "log": {
    "level": "warn",
    "format": "text",
    "output": "/var/log/condure/condure.log"
  },
  "rate_limit": {
    "requests_per_second": 200,
    "burst_size": 400,
    "connections_per_ip": 100
  }
}
