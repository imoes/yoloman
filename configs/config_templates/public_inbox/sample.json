{
  "inboxes": [
    {
      "name": "linux-kernel",
      "directory": "/var/lib/public-inbox/linux-kernel",
      "address": "linux-kernel@vger.kernel.org",
      "owner": "torvalds@linux-foundation.org",
      "version": 2,
      "feed": true,
      "feedmaxitems": 50
    },
    {
      "name": "debian-user",
      "directory": "/var/lib/public-inbox/debian-user",
      "address": "debian-user@lists.debian.org",
      "feed": false
    }
  ],
  "config.http": {
    "bind": "0.0.0.0",
    "port": 8080,
    "ssl": {
      "cert": "/etc/ssl/certs/public-inbox.crt",
      "key": "/etc/ssl/private/public-inbox.key"
    }
  },
  "config.nntp": {
    "enable": true,
    "bind": "0.0.0.0",
    "port": 119
  },
  "config.script_alias": "/archives"
}
