# Defaults for icecast2 initscript
# sourced by /etc/init.d/icecast2
# installed at /etc/default/icecast2 by the maintainer scripts

#
# This is a POSIX shell fragment
#

# Full path to the Icecast server configuration file.
# Defines where icecast2 looks for its main XML configuration (listeners, sources, relay info, etc.).
CONFIGFILE="{{ icecast_config_file | default('/etc/icecast2/icecast.xml') }}"

# Name of the user account under which the Icecast daemon should run.
# Using a dedicated unprivileged user improves security by isolating the streaming process.
USERID={{ icecast_user | default('icecast2') }}

# Name of the group under which the Icecast daemon should run.
# Typically matches the user for file permission consistency.
GROUPID={{ icecast_group | default('icecast') }}