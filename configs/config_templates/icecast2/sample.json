{
  "location": "New York, USA",
  "admin": "admin@radio.example.com",
  "hostname": "radio.example.com",
  "bind_address": "0.0.0.0",
  "port": 8000,
  "ssl_sockets": [
    {
      "bind_address": "0.0.0.0",
      "port": 8443,
      "ssl_certificate": "/etc/ssl/certs/icecast.pem",
      "ssl_private_key": ""
    }
  ],
  "webroot": "/usr/share/icecast2/web",
  "adminroot": "/usr/share/icecast2/admin",
  "admin_username": "admin",
  "admin_password": "s3cur3adm1n!",
  "source_password": "s0urceP@ss!",
  "relay_password": "r3layP@ss!",
  "relays": [
    {
      "server": "backup.example.com",
      "port": 8000,
      "mount": "/main",
      "local_mount": "/relay/main",
      "relay_shoutcast_metadata": true
    }
  ],
  "basedir": "/var/icecast2",
  "logdir": "/var/log/icecast2",
  "pidfile": "/run/icecast2/icecast2.pid",
  "alias": "/",
  "accessformat": "%h %t %r %s %b",
  "errorformat": "[%Y-%m-%d %H:%M:%S] %s",
  "loglevel": "3",
  "logsize": 50000,
  "chroot": true,
  "changeowner_user": "icecast2",
  "changeowner_group": "icecast2",
  "maxclients": 200,
  "maxclientpulls": 20,
  "maxqueueSize": 131072,
  "queueoutgoing": 32768,
  "timeout": 45,
  "fallbacks": [
    {
      "mount": "/live",
      "fallback_mount": "/fallback",
      "fallback_override": false,
      "fallback_when_full": true
    }
  ],
  "mount_public": true,
  "mount_stream_name": "MyRadio 24/7",
  "mount_stream_description": "Non-stop music and talk",
  "mount_stream_url": "https://radio.example.com",
  "mount_genre": "Mixed",
  "mount_bitrate": 192,
  "mount_type": "audio/mpeg",
  "mount_hidden": false,
  "mount_burst_size": 32768,
  "mount_mp3_meta_interval": 16000,
  "mount_audio_info": {
    "samplerate": "44100",
    "channels": "2"
  },
  "mount_overrides": [
    {
      "mount_name": "/jazz",
      "public": false,
      "stream_name": "Jazz Only",
      "stream_description": "Smooth jazz 24/7",
      "stream_url": "https://radio.example.com/jazz",
      "genre": "Jazz",
      "bitrate": 128,
      "type": "audio/mpeg",
      "hidden": true,
      "burst_size": 16384,
      "mp3_meta_interval": 16000
    }
  ]
}
