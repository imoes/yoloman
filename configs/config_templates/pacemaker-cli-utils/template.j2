#
# Configuration file for pacemaker-cli-utils.
#
# This file allows setting default command-line options for all
# pacemaker command-line tools (pcs, crmsh, etc.).
# Refer to the manual page (`man pcs` or `man crmsh`) for detailed options.
#

# Global options variable.
# Default value defined in schema: ''
# If empty, the tool may use its own internal defaults or none.
#
{% if (options | default('')) | length > 0 %}
OPTIONS="{{ options | default('') }}"
{% else %}
#OPTIONS="-d"
{% endif %}