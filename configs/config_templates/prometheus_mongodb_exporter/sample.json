{
  "mongodb_uri": "mongodb://admin:secret@mongo1.example.com:27017,mongo2.example.com:27017,mongo3.example.com:27017/?replicaSet=rs0&authSource=admin",
  "mongodb_db": "admin",
  "disabled_metrics": [
    "collection",
    "top"
  ],
  "enable_diagnostics": true,
  "metrics_timeout": 15,
  "enable_tls": true,
  "tls_ca_file": "/etc/pki/tls/certs/ca-bundle.crt",
  "tls_cert_file": "/etc/pki/tls/certs/mongoserver.crt",
  "tls_key_file": "/etc/pki/tls/private/mongoserver.key",
  "tls_insecure_skip_verify": false,
  "web_listen_address": "127.0.0.1:9216",
  "mongodb_user": "",
  "mongodb_password": "",
  "mongodb_auth_db": "admin",
  "collect_hidden": false,
  "secondary_only": true,
  "extra_labels": [
    {
      "key": "env",
      "value": "production"
    },
    {
      "key": "region",
      "value": "us-west-2"
    }
  ],
  "max_connections": 4,
  "enable_profiling": false
}
