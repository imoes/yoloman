{
  "workers": 2,
  "trust_anchors_path": "/etc/knot-resolver/roots.txt",
  "cache_size": "256M",
  "log_level": "warning",
  "listen_addresses": [
    {
      "address": "127.0.0.1",
      "port": 53,
      "net": "udp"
    },
    {
      "address": "192.168.1.1",
      "port": 53,
      "net": "udp"
    },
    {
      "address": "::1",
      "port": 53,
      "net": "udp"
    }
  ],
  "upstream_resolvers": [
    {
      "hostname": "9.9.9.9",
      "protocol": "udp"
    },
    {
      "hostname": "2001:4860:4860::8888",
      "protocol": "udp"
    }
  ],
  "policy_rules": [
    {
      "domain": "*.malware.example",
      "action": "block"
    }
  ],
  "doh_enabled": false,
  "doh_listen_address": "127.0.0.1",
  "doh_port": 443,
  "doh_cert_path": "/etc/knot-resolver/doh.crt",
  "doh_key_path": "/etc/knot-resolver/doh.key",
  "dot_enabled": true,
  "dot_listen_address": "127.0.0.1",
  "dot_port": 853,
  "dot_cert_path": "/etc/knot-resolver/dot.crt",
  "dot_key_path": "/etc/knot-resolver/dot.key",
  "query_log": true,
  "query_log_format": "json",
  "net_timeout": 3,
  "net_max_queries_per_client": 30,
  "neg_ttl": 7200,
  "dnssec_enabled": true,
  "local_data_entries": [
    {
      "name": "local.example",
      "ttl": 60,
      "class": "IN",
      "type": "A",
      "data": "192.0.2.5"
    }
  ],
  "prefetch_enabled": true,
  "stale_ttl": 172800,
  "cache_purge_interval": 1800,
  "random_seed": true,
  "experimental": false,
  "http_api_enabled": true,
  "http_api_listen": "127.0.0.1",
  "http_api_port": 9443,
  "http_api_token": "secret-token-12345"
}
