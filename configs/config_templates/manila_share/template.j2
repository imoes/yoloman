# OpenStack Manila Share Service Configuration
# Auto-generated by Ansible Jinja2 template.
# All variables are populated with schema defaults if not provided by the role.

[DEFAULT]
# Unique identifier for this service instance
service_name = {{ service_name | default('manila-share') }}

# RPC transport backend (RabbitMQ)
rpc_backend = {{ rpc_backend | default('rabbit') }}

# Database connection string
# Format: dialect+driver://user:password@host/dbname
connection = {{ db_connection | default('mysql+pymysql://' + (db_user | default('manila')) + ':' + (db_password | default('')) + '@' + (db_host | default('127.0.0.1')) + '/' + (db_name | default('manila'))) }}

# Authentication strategy used by Manila
auth_strategy = {{ auth_strategy | default('keystone') }}

[oslo_messaging_rabbit]
# RabbitMQ server hostname or IP
rabbit_host = {{ rabbit_host | default('127.0.0.1') }}

# RabbitMQ server port
rabbit_port = {{ rabbit_port | default(5672) }}

# RabbitMQ username
rabbit_user = {{ rabbit_user | default('guest') }}

# RabbitMQ password
rabbit_password = {{ rabbit_password | default('guest') }}

# Enable SSL/TLS for RabbitMQ connection
{% if rabbit_use_ssl | default(False) | bool %}
rabbit_use_ssl = true

# SSL/TLS version to use
rabbit_ssl_version = {{ rabbit_ssl_version | default('TLSv1_2') }}
{% endif %}

# Logging configuration
[logging]
# Path to the log file. Use empty string for stdout.
log_file = {{ log_file | default('/var/log/manila/share.log') }}

# Minimum log level to record
log_level = {{ log_level | default('INFO') }}

# Share driver and general settings
[DEFAULT]
# Driver for GlusterFS native shares
share_driver = {{ share_driver | default('manila.share.drivers.glusterfs.GlusterfsNativeShareDriver') }}

# Whether Manila manages share servers directly
driver_handles_share_servers = {{ driver_handles_share_servers | default(True) | lower }}

# GlusterFS backend configuration
[glusterfs]
# Driver for volume operations
volume_driver = {{ volume_driver | default('manila.share.drivers.glusterfs.GlusterfsNativeShareDriver') }}

# Name of the backend for reporting in the API
volume_backend_name = {{ glusterfs_backend_name | default('glusterfs_native') }}

# Name of the GlusterFS volume to export
glusterfs_volume = {{ glusterfs_volume | default('manila-share') }}

# Password for GlusterFS server root user
glusterfs_server_password = {{ glusterfs_server_password | default('') }}

# List of GlusterFS server hosts
{% for host in glusterfs_hosts | default(['10.0.0.1']) %}
glusterfs_server_{{ loop.index }} = {{ host }}
{% endfor %}

# Network and Share Type configuration
[DEFAULT]
# UUID of the default share network. Leave blank for auto-selection.
default_share_network = {{ default_share_network | default('') }}

# Default share type to use when none is specified
{% if default_share_type | default('') %}
default_share_type = {{ default_share_type | default('') }}
{% endif %}

# Security service type (ldap, kerberos, or empty)
{% if security_service_type | default('') %}
security_service_type = {{ security_service_type | default('') }}
{% endif %}

# CIDR range for share server IPs
{% if share_server_ip_pool | default('') %}
share_server_ip_pool = {{ share_server_ip_pool | default('') }}
{% endif %}

# Maximum request body size in bytes
max_request_size = {{ max_request_size | default(104857600) }}

# Maximum size for API request headers/body in bytes
max_api_request_size = {{ max_api_request_size | default(1048576) }}

# Timeout in seconds for RPC responses
rpc_response_timeout = {{ rpc_response_timeout | default(60) }}

# Path to API paste configuration
api_paste_config = {{ api_paste_config | default('/etc/manila/api-paste.ini') }}

# Number of worker processes for RPC handling
# If a list is provided, the last value is used as the primary worker count
{% for worker in share_workers | default([1]) %}
workers = {{ worker }}
{% endfor %}

# Hostname to report this service instance as. Defaults to FQDN.
{% if service_host | default('') %}
host = {{ service_host | default('') }}
{% endif %}

# RabbitMQ topic for share RPC messages
topic = {{ service_topic | default('manila-share') }}

# Interval in seconds between service state reports
report_interval = {{ report_interval | default(60) }}

# Delete share servers even when instances are attached
{% if delete_share_server_with_instances | default(True) | bool %}
delete_share_server_with_instances = {{ delete_share_server_with_instances | default(True) }}
{% endif %}

[keystone_authtoken]
# Keystone authentication URL (v3 API)
auth_url = {{ keystone_auth_url | default('http://controller:5000/v3') }}

# Keystone project domain name
project_domain_name = {{ keystone_project_domain_name | default('Default') }}

# Keystone user domain name
user_domain_name = {{ keystone_user_domain_name | default('Default') }}

# Keystone project (tenant) name
project_name = {{ keystone_project_name | default('service') }}

# Keystone username
username = {{ keystone_username | default('manila') }}

# Keystone password
password = {{ keystone_password | default('') }}

# Token cache expiry time in seconds (0 to disable)
{% if keystone_token_cache_time | default(300) %}
token_cache_time = {{ keystone_token_cache_time | default(300) }}
{% endif %}

# Keystone TLS verification settings
{% if keystone_verify_certs | default(True) | bool %}
# Validate Keystone certificates using CA bundle
cafile = {{ keystone_cafile | default('/etc/ssl/certs/ca-certificates.crt') }}
{% else %}
# Allow insecure connections (no certificate validation)
insecure = true
{% endif %}

[oslo_messaging_notifications]
# Notification backend driver (messagingv2 recommended)
{% if notifications_driver | default('messagingv2') %}
driver = {{ notifications_driver | default('messagingv2') }}
{% endif %}

# Enable per-project API rate limiting
api_rate_limit = {{ api_rate_limit | default(True) | lower }}