{
  "ui": {
    "show_pin_entry": true,
    "pin_entry_timeout": 45,
    "pin_entry_echo": false
  },
  "storage": {
    "storage_dir": "~/.local/share/gcr",
    "enable_storage": true,
    "secure_erase": true
  },
  "logging": {
    "level": 2,
    "log_file": "/var/log/gcr.log",
    "log_to_journal": true
  },
  "trust": {
    "auto_trust": false,
    "default_ca_trust": "none"
  },
  "daemon": {
    "enabled": true,
    "auto_start_services": [
      "pkcs11",
      "openssh"
    ],
    "max_concurrent": 8
  },
  "ssh": {
    "enabled": true,
    "socket_path": "",
    "import_keys": [
      "SHA256:abc123...",
      "SHA256:def456..."
    ]
  }
}
