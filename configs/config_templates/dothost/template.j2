{# dothost: DNS lookup utility configuration #}
{# dothost is a CLI utility; it has no persistent config file. #}
{# All settings are passed via command-line arguments or stdin. #}
{# This template serves as a documentation placeholder for the 'addresses' parameter. #}
{# The 'addresses' field defines the list of DNS hostnames or IP addresses to resolve. #}
{# Each item in the list is a string representing a hostname or IP. #}

{# Example usage in a playbook task: #}
{# - name: Resolve hosts #}
{#   command: dothost {{ addresses | default([]) | join(' ') }} #}

{# List of addresses to look up #}
addresses: {{ addresses | default([]) }}