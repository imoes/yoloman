# ===========================================================================
# GFork Configuration Template
# Self-documenting template for the globus-gfork-progs service.
# Every directive below is annotated with its schema description and default value.
# Use this template as-is in Ansible; all variables have safe defaults.
# ===========================================================================

# Main configuration for GFork

# Port number for the GFork service
# Default: 8080
port = {{ port | default(8080) }}

# Hostname or IP address to bind to
# Default: 0.0.0.0
host = {{ host | default('0.0.0.0') }}

# Document root for static files
# Default: /var/www/gfork
document_root = {{ document_root | default('/var/www/gfork') }}

# Path to the log file
# Default: /var/log/gfork/gfork.log
log_file = {{ log_file | default('/var/log/gfork/gfork.log') }}

# Maximum size of the log file in MB before rotation
# Default: 10
max_log_size = {{ max_log_size | default(10) }}

# Number of worker processes
# Default: 4
workers = {{ workers | default(4) }}

# Enable or disable debugging mode
# Default: false
debug = {{ debug | default(false) | lower }}