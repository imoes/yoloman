{
  "port": {
    "type": "number",
    "default": 8080,
    "description": "Port number for the GFork service"
  },
  "host": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "Hostname or IP address to bind to"
  },
  "document_root": {
    "type": "string",
    "default": "/var/www/gfork",
    "description": "Document root for static files"
  },
  "log_file": {
    "type": "string",
    "default": "/var/log/gfork/gfork.log",
    "description": "Path to the log file"
  },
  "max_log_size": {
    "type": "number",
    "default": 10,
    "description": "Maximum size of the log file in MB before rotation"
  },
  "workers": {
    "type": "number",
    "default": 4,
    "description": "Number of worker processes"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable or disable debugging mode"
  }
}
