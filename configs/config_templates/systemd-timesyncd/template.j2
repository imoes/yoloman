[Time]
# Enable NTP time synchronization with specified servers
NTP={{ ntp_servers | join(' ') }}
# Fallback NTP servers used when primary servers are unreachable
FallbackNTP={{ fallback_ntp_servers | join(' ') }}
# Root distance max (in microseconds) — servers with higher root delay are rejected
RootDistanceMaxSec={{ root_distance_max_sec }}
# Interval between polling the same server (in seconds); 0 uses systemd default (typically 64–1024)
PollIntervalMinSec={{ poll_interval_min_sec }}
PollIntervalMaxSec={{ poll_interval_max_sec }}
# Allow time steps larger than this threshold (in seconds); if exceeded, log and step (default: 180)
MaxStepsThresholdSec={{ max_steps_threshold_sec }}
# If true, step the system clock immediately on large offsets instead of slewing
StepBackward=true
# If true, step backward when clock drifts ahead of reference (use with caution)
StepBackward={{ step_backward }}
# Preserve system clock during reboot by saving/restoring time (requires state directory)
PreserveSystemClock=true
# If true, preserve system clock across reboots (enabled by default on most distros)
PreserveSystemClock={{ preserve_system_clock }}
# Server polynomial interpolation order (2 = quadratic, default for small deployments)
ServerPollIntervalDampening={{ server_poll_interval_dampening }}