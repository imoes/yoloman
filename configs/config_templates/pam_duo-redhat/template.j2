[duo]
; Duo integration key provided by the user or inventory.
; This key identifies the Duo application to the Duo API service.
ikey = {{ ikey | default('') }}

; Duo secret key provided by the user or inventory.
; This secret is used to sign requests sent to the Duo API service.
skey = {{ skey | default('') }}

; Duo API host provided by the user or inventory.
; The hostname of the Duo API endpoint (e.g., api-12345.duosecurity.com).
host = {{ host | default('') }}

; Fail mode for Duo authentication (safe or secure).
; `failmode = safe`: In the event of errors with this configuration file or connection to the Duo service,
; this mode will allow login without 2FA.
; `failmode = secure`: This mode will deny access in the above cases. Misconfigurations with this setting
; enabled may result in you being locked out of your system.
failmode = {{ failmode | default('safe') }}

; Send command for Duo Push authentication (currently commented out).
;pushinfo = yes
