# /etc/curlftpfs/config — Configuration for curlftpfs
# This file defines the FTP server connection details and mount parameters.
# Generated by Ansible. See man curlftpfs(1) for option details.

# FTP server hostname or IP address.
# This is the remote server that curlftpfs will connect to.
# Required field; defaults to empty string (no mount configured).
# If host is provided, add username/password fields to 'requires' in capabilities.json if schema supports it.
{% if (host | default('')) | length > 0 %}
host={{ host | default('') }}
{% endif %}

# Local mount point path.
# The directory on the local system where the FTP file system will be mounted.
# The directory must exist before mounting.
# Required field; defaults to empty string (no mount configured).
{% if (path | default('')) | length > 0 %}
path={{ path | default('') }}
{% endif %}

# Additional mount options.
# Comma-separated list of curlftpfs/FUSE options (e.g., 'ssl,uid=1000,gid=1000,retry=3').
# These are passed to the mount command as -o arguments.
# Defaults to an empty list (no extra options).
{% if (ftp_opts | default([])) | length > 0 %}
-o {{ ftp_opts | default([]) | join(',') }}
{% endif %}