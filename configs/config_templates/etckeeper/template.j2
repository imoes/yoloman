# etckeeper configuration file (/etc/etckeeper/etckeeper.conf)
#
# This file controls the behavior of etckeeper, a tool to keep /etc in a
# version control system (git, hg, bzr).
#
# Global settings for etckeeper are defined here. The shell script
# /etc/etckeeper/daily uses these variables to decide whether to
# automatically commit changes to /etc on a daily basis.

# avoid_daily_autocommits
# If set to "1", skips running /etc/etckeeper/daily automatically
# (e.g., by cron). Default is empty string (i.e., autocommits are enabled).
#
# Valid values:
#   "1"  - Disable automatic daily autocommits.
#   ""   - Enable automatic daily autocommits (default).
AVOID_DAILY_AUTOCOMMITS="{{ avoid_daily_autocommits | default('') }}"