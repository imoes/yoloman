# Enable the PostGIS extension by loading its shared library
shared_preload_libraries = '{{ shared_preload_libraries }}'

# Set the PostGIS schema search path (ensure 'postgis' is first for unqualified references)
schema_search_path = '{{ schema_search_path }}'

# Optional: limit memory usage for geospatial operations (e.g., GEOS, GDAL, PROJ internal buffers)
# Adjust based on typical query complexity and system resources
work_mem = '{{ work_mem }}'

# Optional: enable parallel execution for spatial operations (PostgreSQL 14+)
# Note: PostGIS itself doesn’t directly control parallelism, but PostgreSQL’s planner uses this
max_parallel_workers_per_gather = '{{ max_parallel_workers_per_gather }}'

# Optional: configure temporary directory for spatial operations (e.g., during raster processing)
temp_directory = '{{ temp_directory }}'

# Optional: enable verbose logging for PostGIS functions
# (helpful for debugging spatial queries, but may increase log volume)
log_min_messages = '{{ log_min_messages }}'

# Optional: register PostGIS in new databases by default (via template1)
# Not configurable in postgresql.conf — done via SQL in post-installation or init scripts
# See: CREATE EXTENSION postgis;
