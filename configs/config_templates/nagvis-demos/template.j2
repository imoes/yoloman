# NagVis Global Map Definition
# This section defines the global properties for a NagVis map, including its data source, appearance, and layout.

[global]

# The source type for NagVis maps, typically automap for dynamic topology discovery.
sources={{ sources | default('automap') }}

# Human-readable alias name for the NagVis map definition.
alias={{ alias | default('Demo: 6 Automap') }}

# Parent map ID this map belongs to, used for hierarchical navigation.
parent_map={{ parent_map | default('demo-overview') }}

# Icon set style to use for hosts and services in the map.
iconset={{ iconset | default('std_big') }}

# Size of icons in pixels.
icon_size={{ icon_size | default(22) }}

# ID of the backend configuration used to fetch status data.
backend_id={{ backend_id | default('demo') }}

# Whether to show labels for objects (1=true, 0=false).
label_show={{ label_show | default('1') }}

# Border style for labels (e.g., transparent, white, etc.).
label_border={{ label_border | default('transparent') }}

# [Automap specific parameters]

# Rendering mode for automap, e.g., directed or undirected.
render_mode={{ render_mode | default('directed') }}

# Direction of graph layout: TB (top-bottom), BT (bottom-top), LR (left-right), or RL (right-left).
rankdir={{ rankdir | default('TB') }}

# Default width of the map canvas in pixels.
width={{ width | default(500) }}

# Default height of the map canvas in pixels.
height={{ height | default(300) }}