{
  "shell": "bash",
  "warmup": 2,
  "min_runs": 10,
  "max_runs": 50,
  "runs": 0,
  "setup": "",
  "reference": "",
  "prepare": "sync; echo 3 > /proc/sys/vm/drop_caches",
  "conclude": "",
  "cleanup": "rm -f /tmp/benchmark_output.dat",
  "ignore_failure": false,
  "style": "full",
  "sort": "mean-time",
  "time_unit": "second",
  "export_asciidoc": "",
  "export_csv": "",
  "export_json": "results.json",
  "export_markdown": "",
  "export_orgmode": "",
  "show_output": false,
  "output": "null",
  "input": "null",
  "command_names": [
    "Method A",
    "Method B"
  ],
  "commands": [
    "sleep 1 && echo test_a",
    "sleep 2 && echo test_b"
  ],
  "parameter_scan": {
    "vars": [
      {
        "name": "threads",
        "min": 1,
        "max": 4
      }
    ],
    "step_size": 1
  },
  "parameter_list": {
    "vars": [
      {
        "name": "compiler",
        "values": "gcc,clang"
      }
    ]
  }
