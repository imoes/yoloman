# swtpm-tools (swtpm-localca) configuration
# This file configures the Local CA component of swtpm-tools, which handles
# certificate issuance for TPM-backed virtual machines.

# statedir
# Directory where TPM state and certificates are stored.
# Default: /var/lib/swtpm-localca
statedir = {{ statedir | default('/var/lib/swtpm-localca') }}

# signingkey
# Path to the private key used for signing certificates.
# Default: /var/lib/swtpm-localca/signkey.pem
signingkey = {{ signingkey | default('/var/lib/swtpm-localca/signkey.pem') }}

# issuercert
# Path to the issuer certificate.
# Default: /var/lib/swtpm-localca/issuercert.pem
issuercert = {{ issuercert | default('/var/lib/swtpm-localca/issuercert.pem') }}

# certserial
# Path to the file storing the certificate serial number.
# Default: /var/lib/swtpm-localca/certserial
certserial = {{ certserial | default('/var/lib/swtpm-localca/certserial') }}