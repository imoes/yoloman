    "description": "DHCP option codes to request, as list of integers or ranges"
  },
  "fuzz": {
    "type": "bool",
    "default": false,
    "description": "Enable random packet fuzzing"
  },
  "threads": {
    "type": "number",
    "default": 1,
    "description": "Number of sending threads"
  },
  "show_arp": {
    "type": "bool",
    "default": false,
    "description": "Enable detection and print ARP who_has requests"
  },
  "show_icmp": {
    "type": "bool",
    "default": false,
    "description": "Enable detection and print ICMP requests"
  },
  "show_options": {
    "type": "bool",
    "default": false,
    "description": "Print lease options info"
  },
  "show_lease_confirm": {
    "type": "bool",
    "default": false,
    "description": "Detect and print DHCP replies"
  },
  "neighbors_attack_garp": {
    "type": "bool",
    "default": false,
    "description": "Knock neighbors offline using gratuitous ARP"
  },
  "neighbors_attack_release": {
    "type": "bool",
    "default": false,
    "description": "Release all neighbor IPs via DHCPRELEASE"
  },
  "neighbors_scan_arp": {
    "type": "bool",
    "default": false,
    "description": "Enable ARP-based neighbor scanning"
  },
  "timeout_threads": {
    "type": "number",
    "default": 0.4,
    "description": "Thread spawn timer in seconds"
  },
  "timeout_dos": {
    "type": "number",
    "default": 8,
    "description": "DOS timeout \u2014 wait time between gratuitous ARP bursts"
  },
  "timeout_dhcprequest": {
    "type": "number",
    "default": 2,
    "description": "DHCP request timeout in seconds"
  },
  "color": {
    "type": "bool",
    "default": false,
    "description": "Enable colored terminal output"
  }
}
