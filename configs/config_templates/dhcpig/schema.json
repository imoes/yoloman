{
  "interface": {
    "type": "string",
    "default": "eth0",
    "description": "Network interface to use for DHCP exhaustion attack"
  },
  "verbosity": {
    "type": "number",
    "default": 10,
    "description": "Verbosity level: 0 (none), 1 (minimal), 10 (default), 99 (debug)"
  },
  "ipv6": {
    "type": "bool",
    "default": false,
    "description": "Enable IPv6 (DHCPv6); otherwise use IPv4 (DHCP)"
  },
  "v6_rapid_commit": {
    "type": "bool",
    "default": false,
    "description": "Enable DHCPv6 Rapid Commit (2-way handshake)"
  },
  "client_src": {
    "type": "list",
    "default": [],
    "description": "List of client MAC addresses to use; empty list means random"
  },
