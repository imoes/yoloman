{# ciso(1) configuration template for ISO/CSO compression/decompression #}
# ciso(1) - PSP ISO compression tool
# Usage: ciso level infile outfile
# level: 0 = decompress, 1-9 = compression level (1=fast/large, 9=small/slow)
# This config defines default behavior for automated ciso operations.

# Default compression level (0 for decompress, 1–9 for compress). 5 is a common balanced default.
DEFAULT_LEVEL={{ default_level | default(5) }}

# List of source files to process with the default level
{% for item in file_pairs | default([]) %}
# Input file: {{ item.input }} → Output file: {{ item.output }}
{{ item.input }} {{ item.output }}
{% endfor %}