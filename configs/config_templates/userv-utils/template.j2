# userv-utils configuration template
# This file manages user creation policies for the userv-utils suite.
# It controls minimum identifiers, UID ranges, and display preferences.

# Enable user creation functionality.
# Allowed values: true, false
# Default: True
user-create {{ user_create_enabled | default(True) }}

# Minimum length for the local part of the user's username.
# Used to enforce valid username lengths during creation.
# Default: 4
user-create-minunameu {{ user_create_min_uname_len | default(4) }}

# Minimum UID for newly created users.
# Defines the lower bound of the UID pool available for new accounts.
# Default: 5000
user-create-min {{ user_create_uid_min | default(5000) }}

# Maximum UID for newly created users.
# Defines the upper bound of the UID pool available for new accounts.
# Default: 8999
user-create-max {{ user_create_uid_max | default(8999) }}

# Include the user's full name in the title/header of user pages.
# When enabled, the full name is displayed in the UI header.
# Allowed values: true, false
# Default: True
user-create-nameintitle {{ user_create_name_in_title | default(True) }}

# Maximum number of users a single administrator can create.
# Limits the blast radius of an admin account and prevents resource exhaustion.
# Default: 5
user-create-maxperu {{ user_create_max_per_user | default(5) }}