# userv-utils configuration
# Self-documenting template for userv-utils user creation subsystem.

# Enable user creation functionality.
# Valid values are typically 'yes' or 'no'.
user-create {{ user_create_enabled | default('yes') }}

# Minimum length for the local part of the user's username.
# Ensures usernames are not trivially short.
user-create-minunameu {{ user_create_min_uname_len | default('4') }}

# Minimum UID for newly created users.
# UIDs below this value are reserved for system accounts.
user-create-min {{ user_create_uid_min | default('5000') }}

# Maximum UID for newly created users.
# Prevents allocation of UIDs in the system range.
user-create-max {{ user_create_uid_max | default('8999') }}

# Include the user's full name in the title/header of user pages.
# Affects the HTML output of the user directory/index.
user-create-nameintitle {{ user_create_name_in_title | default('yes') }}

# Maximum number of users a single administrator can create.
# Limits the blast radius if an admin account is compromised.
user-create-maxperu {{ user_create_max_per_user | default('5') }}
