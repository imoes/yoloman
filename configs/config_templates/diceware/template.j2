# Configuration for diceware
# See diceware(1) man page for details.
# Values here are overridden by user config (~/.diceware.ini, XDG config dirs), then CLI args override all.

[diceware]
# Number of words in passphrase
# Default: 6
num = {{ (diceware | default({})).num | default(6) }}

# Word separator string
# Default: "" (empty string, no separator)
delimiter = {{ (diceware | default({})).delimiter | default('') }}

# Number of special characters to insert
# Default: 0
specials = {{ (diceware | default({})).specials | default(0) }}

# Capitalization mode: true=capitalize, false=no-capitalize
# Default: true
caps = {{ (diceware | default({})).caps | default(true) }}

# Random source: 'system' or 'realdice'
# Default: 'system'
randomsource = {{ (diceware | default({})).randomsource | default('system') }}

# Dice sides (only used if randomsource=realdice)
# Default: 6
dice_sides = {{ (diceware | default({})).dice_sides | default(6) }}

# Wordlist name(s) to use (comma-separated if multiple)
# Must match wordlist_<NAME>.txt files or built-in names
# Default: 'en_eff'
# Note: The default value 'en_eff' is a single string. If a list is passed, it is joined by commas.
# If a list with a single item is passed, the join produces that item. If a non-list/string is passed,
# it is converted to string.
wordlist = {{ ((diceware | default({})).wordlist | default(['en_eff'])) | join(',') }}

# Verbose output
# Default: false
verbose = {{ (diceware | default({})).verbose | default(false) }}