[uwsgi]
############################
### Generic UWSGI config ###
############################

# Override the default size for headers from the 4k default.
buffer-size = 65535

# This avoids error 104: "Connection reset by peer"
rem-header = Content-Length

# This is running standalone
master = true

# uwsgi recommends this to prevent thundering herd on accept.
thunder-lock = true

plugins = python3

# This ensures that file descriptors aren't shared between the WSGI application processes.
lazy-apps = true

# Log from the wsgi application: needs python3-pastescript as runtime depends.
paste-logger = true

# automatically kill workers if master dies
no-orphans = true

# exit instead of brutal reload on SIGTERM
die-on-term = true

# Avoid memcached connections to remain opened
close-on-exec = true
close-on-exec2 = true

##########################
### Performance tuning ###
##########################
# Threads and processes

# Number of uWSGI worker processes.
processes = {{ (PROCESSES | default('8')) }}

# Number of threads per uWSGI worker process.
threads = {{ (THREADS | default('32')) }}

# This is the number of sockets in the queue.
# It improves a lot performances. This is comparable
# to the Apache ServerLimit/MaxClients option.
listen = 100

##################################
### OpenStack service specific ###
##################################
# Set environment variable for Oslo messaging process name.
env = OS_OSLO_MESSAGING_RABBIT__PROCESSNAME=aodh-api

# This is needed, otherwise connections stay open
add-header = Connection: close

# Important stuff...
paste = config:/etc/{{ (PROJECT_NAME | default('aodh')) }}/api-paste.ini

# Logging destination for the API log file.
logto = /var/log/{{ (PROJECT_NAME | default('aodh')) }}/{{ (PROJECT_NAME | default('aodh')) }}-api.log

# Service name identifier.
name = {{ (PROJECT_NAME | default('aodh')) }}-api

# OS user to run the worker processes as (OpenStack project user).
uid = {{ (PROJECT_NAME | default('aodh')) }}

# OS group to run the worker processes as (OpenStack project group).
gid = {{ (PROJECT_NAME | default('aodh')) }}

# Working directory for the application.
chdir = /var/lib/{{ (PROJECT_NAME | default('aodh')) }}

# Main WSGI application file.
wsgi-file = /usr/share/{{ (PROJECT_NAME | default('aodh')) }}-common/app.wsgi

# TCP port for uWSGI to bind to.
# Configures both HTTP and HTTPS sockets on all IPv6 interfaces.
# SSL certificates are expected in /etc/<project>/ssl/private/
{% if (UWSGI_PORT | default(8042)) is defined and (UWSGI_PORT | default(8042)) %}
http-socket = [::]:{{ (UWSGI_PORT | default(8042)) }}
# Placeholder SSL configuration; replace foobar.crt/foobar.key with actual paths.
https-socket = [::]:{{ (UWSGI_PORT | default(8042)) }},foobar.crt,foobar.key
{% else %}
# No HTTP/HTTPS socket configured (port not defined or empty).
# http-socket = [::]:8042
# https-socket = [::]:8042,foobar.crt,foobar.key
{% endif %}