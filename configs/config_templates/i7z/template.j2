# ==============================================================================
# i7z Configuration Template
# ==============================================================================
# This configuration file controls the behavior of i7z, a CPU frequency
# monitoring tool. It supports logging frequency stats to a file and
# configuring the display layout for multi-socket systems.
# ==============================================================================

# ------------------------------------------------------------------------------
# Logging Mode
# ------------------------------------------------------------------------------
# Defines how i7z handles the log file:
#   'a' : Append new entries to the existing log file.
#   'l' : Overwrite (replace) the log file entirely on startup.
# Corresponds to the -w / --write command-line option.
logging_mode={{ logging_mode | default('a') }}

# ------------------------------------------------------------------------------
# Log File Path
# ------------------------------------------------------------------------------
# The absolute or relative path to the log file where CPU frequency data is
# written. Ensure the i7z process has write permissions for this path and its
# parent directories.
# Corresponds to the -l / --logfile command-line option.
log_file={{ log_file | default('cpu_freq_log.txt') }}

# ------------------------------------------------------------------------------
# Top View Socket ID
# ------------------------------------------------------------------------------
# The socket number (CPU package ID) to display in the top half of the i7z
# interactive interface. Useful for focusing on a specific processor in
# multi-socket servers.
# Accepts integer socket IDs (typically 0 or 1).
# Corresponds to the --socket0 command-line option.
socket0={{ socket0 | default(0) }}

# ------------------------------------------------------------------------------
# Bottom View Socket ID
# ------------------------------------------------------------------------------
# The socket number (CPU package ID) to display in the bottom half of the i7z
# interactive interface. Complements socket0 to allow comparison between
# different processors.
# Accepts integer socket IDs (typically 0 or 1).
# Corresponds to the --socket1 command-line option.
socket1={{ socket1 | default(1) }}

# ------------------------------------------------------------------------------
# Disable GUI Mode
# ------------------------------------------------------------------------------
# When set to true, i7z disables the ncurses-based interactive GUI and runs
# in a pure text/log mode. This is ideal for cron jobs, scripts, or
# environments where no terminal emulator is available.
# Corresponds to the --nogui command-line option.
nogui={{ nogui | default(false) }}