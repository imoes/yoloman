{
  "host": "mail.example.com",
  "port": 504,
  "datadir": "/var/lib/citadel",
  "configdir": "/etc/citadel",
  "logfile": "/var/log/citadel/client.log",
  "verbose": false,
  "ssl_enabled": true,
  "ssl_ca_file": "/etc/ssl/certs/ca-certificates.crt",
  "ssl_client_cert": "/etc/citadel/client.crt",
  "ssl_client_key": "/etc/citadel/client.key",
  "default_domain": "example.com",
  "allow_anonymous": false,
  "auth_backends": [
    "local",
    "ldap"
  ],
  "auth_backend_options": [
    {
      "name": "ldap",
      "options": {
        "uri": "ldap://ldap.example.com",
        "binddn": "cn=binduser,dc=example,dc=com",
        "base": "ou=users,dc=example,dc=com",
        "timeout": 5,
        "starttls": true
      }
    }
  ],
  "connect_timeout": 15,
  "read_timeout": 45,
  "max_retries": 3,
  "auto_reconnect": true,
  "default_charset": "UTF-8",
  "compression_enabled": true,
  "trusted_subnets": [
    "127.0.0.0/8",
    "10.0.0.0/8"
  ],
  "trusted_hosts": []
}
