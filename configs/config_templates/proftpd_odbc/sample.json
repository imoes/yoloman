{
 "allow_override_enabled": false,
 "allow_reconnect": true,
 "allow_reconnect_on": "same_ip",
 "auth_modules": [
  "mod_auth_file.c",
  "mod_auth_odbc.c"
 ],
 "chroot_enabled": true,
 "custom_directives": [
  "LoadModule mod_ldap.c",
  "LDAPServer ldap://ldap.example.com",
  "LDAPDefaultUID 1001",
  "LDAPDefaultGID 1001"
 ],
 "default_dir": "/srv/ftp",
 "default_dir_allowed_user": "ftp",
 "default_dir_umask": "022",
 "default_umask": "022",
 "global_access_control": [
  {
   "allow": true,
   "host": "10.0.0.0/8"
  },
  {
   "allow": true,
   "host": "192.168.1.0/24"
  },
  {
   "allow": false,
   "host": "all"
  }
 ],
 "ident_name": "proftpd",
 "listen_address": "0.0.0.0",
 "listen_port": 21,
 "log_level": "info",
 "max_clients": 50,
 "max_clients_per_host": 5,
 "max_hosts_per_user": 2,
 "max_login_attempts": 4,
 "max_user_per_host": 3,
 "odbc_default_gid": 65534,
 "odbc_default_uid": 65534,
 "odbc_dsn": "proftpd",
 "odbc_enabled": true,
 "odbc_get_group_info_query": "SELECT groupname, gid, members FROM ftp_groups WHERE groupname='%G'",
 "odbc_get_user_info_query": "SELECT username, password, uid, gid, shell, homedir FROM ftp_users WHERE username='%U'",
 "odbc_homedir_query": "SELECT homedir FROM ftp_users WHERE username='%U'",
 "odbc_pass": "",
 "odbc_password": "secretpass123",
 "odbc_username": "proftpd",
 "pid_file_path": "/run/proftpd.pid",
 "server_name": "MyCompany Secure FTP Server",
 "server_type": "standalone",
 "system_log_path": "/var/log/proftpd/proftpd.log",
 "timeout_idle": 900,
 "timeout_linger": 120,
 "timeout_no_transfer": 300,
 "tls_ca": "",
 "tls_ca_cert_file": "/etc/ssl/certs/ca.crt",
 "tls_cert_file": "/etc/ssl/certs/proftpd.crt",
 "tls_cipher_suite": "HIGH:!aNULL:!MD5",
 "tls_enabled": true,
 "tls_key_file": "/etc/ssl/private/proftpd.key",
 "tls_protocol": [
  "TLSv1.2",
  "TLSv1.3"
 ],
 "tls_required": false,
 "transfer_log_enabled": true,
 "transfer_log_path": "/var/log/proftpd/xferlog",
 "virtual_hosts": [
  {
   "address": "192.168.1.10",
   "anonymous_allowed_group": "anonymous",
   "anonymous_chroot_upload": true,
   "anonymous_enabled": true,
   "anonymous_group": "nogroup",
   "anonymous_path": "/srv/ftp/anonymous",
   "anonymous_user": "nobody",
   "chroot": "/chroot/ftp/%U",
   "hostname": "ftp.example.com",
   "name": "Example Corp FTP"
  },
  {
   "address": "",
   "anonymous_enabled": false,
   "hostname": "secure.example.com",
   "name": "Secure FTP"
  }
 ]
}
