# ==============================================================================
# Debusine Server Nginx Upstream Configuration
# ==============================================================================
# This configuration proxies requests to the Debusine application runtime
# (Daphne, an ASGI server) via a Unix socket. It also handles static files
# and WebSocket upgrades for the API.
# ==============================================================================

# ------------------------------------------------------------------------------
# Location: / (General Web Requests)
# ------------------------------------------------------------------------------
location / {
    # Forward the original Host header so the backend knows the requested domain.
    proxy_set_header Host $http_host;

    # Forward the original protocol (http/https) so the backend can generate
    # correct absolute URLs.
    proxy_set_header X-Forwarded-Proto $scheme;

    # proxy_pass: Forwards traffic to the Debusine application runtime socket.
    # The socket path is defined by the 'socket_path' schema field.
    # Default: /var/lib/debusine/server/daphne.sock
    proxy_pass http://unix:{{ socket_path | default('/var/lib/debusine/server/daphne.sock') }};

    # client_max_body_size: Maximum allowed size of client request body.
    # Prevents clients from uploading excessively large payloads.
    # Defined by the 'client_max_body_size' schema field.
    # Default: 100M
    client_max_body_size {{ client_max_body_size | default('100M') }};

    # Gzip compression settings for static content and responses.
    gzip on;
    gzip_vary on;

    # Specify MIME types to compress.
    gzip_types text/plain text/markdown application/json;
}

# ------------------------------------------------------------------------------
# Location: /api/ws (WebSocket Endpoints)
# ------------------------------------------------------------------------------
location /api/ws {
    # Forward the Host header for WebSocket connections as well.
    proxy_set_header Host $http_host;

    # Proxy WebSocket traffic to the same upstream socket as regular HTTP.
    # The socket path is defined by the 'socket_path' schema field.
    # Default: /var/lib/debusine/server/daphne.sock
    proxy_pass http://unix:{{ socket_path | default('/var/lib/debusine/server/daphne.sock') }};

    # Upgrade the connection to WebSocket protocol.
    proxy_http_version 1.1;

    # Pass the Upgrade header from the client to the upstream server.
    proxy_set_header Upgrade $http_upgrade;

    # Set the Connection header to "upgrade" to establish the WebSocket handshake.
    # If no Upgrade header is present from the client, this ensures standard HTTP behavior.
    proxy_set_header Connection "upgrade";
}

# ------------------------------------------------------------------------------
# Location: /static/ (Static Assets)
# ------------------------------------------------------------------------------
location /static/ {
    # Serve static files directly from the filesystem path defined by
    # the 'static_root' schema field, bypassing the application runtime.
    # Default: /var/lib/debusine/server/static/
    alias {{ static_root | default('/var/lib/debusine/server/static/') }};
}
