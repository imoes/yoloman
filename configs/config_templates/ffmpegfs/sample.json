{
 "audiobitrate": "256K",
 "audiochannels": 2,
 "audiocodec": "AAC",
 "audiosamplerate": "48000",
 "autocopy": "MATCH",
 "cache_maintenance": "30m",
 "cachepath": "/var/cache/ffmpegfs",
 "decoding_errors": true,
 "deinterlace": true,
 "desttype": "mp4",
 "enablescript": true,
 "expiry_time": "2d",
 "hide_extensions": [
  "jpg",
  "png",
  "cue"
 ],
 "hwaccel_dec": "VAAPI",
 "hwaccel_dec_blocked": [
  "H264"
 ],
 "hwaccel_dec_device": "/dev/dri/renderD128",
 "hwaccel_enc": "VAAPI",
 "hwaccel_enc_device": "/dev/dri/renderD128",
 "include_extensions": [
  "mp4",
  "mkv",
  "webm"
 ],
 "level": "HQ",
 "log_maxlevel": "DEBUG",
 "log_stderr": true,
 "logfile": "/var/log/ffmpegfs.log",
 "max_cache_size": "50G",
 "max_inactive_abort": "20s",
 "max_inactive_suspend": "10s",
 "max_threads": 16,
 "noalbumarts": true,
 "prebuffer_size": "200K",
 "prebuffer_time": "2s",
 "profile": "Safari",
 "prune_cache": true,
 "segment_duration": "5.0",
 "videobitrate": "2M",
 "videocodec": "H264",
 "videowidth": 1920
}
