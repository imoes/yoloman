{
  "desttype": "mp4",
  "audiocodec": "AAC",
  "videocodec": "H264",
  "autocopy": "MATCH",
  "profile": "Safari",
  "level": "HQ",
  "include_extensions": [
    "mp4",
    "mkv",
    "webm"
  ],
  "hide_extensions": [
    "jpg",
    "png",
    "cue"
  ],
  "audiobitrate": "256K",
  "audiosamplerate": "48000",
  "audiochannels": 2,
  "videobitrate": "2M",
  "videowidth": 1920,
  "deinterlace": true,
  "segment_duration": "5.0",
  "hwaccel_enc": "VAAPI",
  "hwaccel_dec_blocked": [
    "H264"
  ],
  "hwaccel_enc_device": "/dev/dri/renderD128",
  "hwaccel_dec": "VAAPI",
  "hwaccel_dec_device": "/dev/dri/renderD128",
  "noalbumarts": true,
  "enablescript": true,
  "expiry_time": "2d",
  "max_inactive_suspend": "10s",
  "max_inactive_abort": "20s",
  "prebuffer_time": "2s",
  "prebuffer_size": "200K",
  "max_cache_size": "50G",
  "cachepath": "/var/cache/ffmpegfs",
  "cache_maintenance": "30m",
  "prune_cache": true,
  "max_threads": 16,
  "decoding_errors": true,
  "log_maxlevel": "DEBUG",
  "log_stderr": true,
  "logfile": "/var/log/ffmpegfs.log"
}
