{
  "install_dir": "/usr/sbin",
  "check_interval_days": 7,
  "quiet_mode": true,
  "enable_checks": [
    {
      "name": "chkutmp",
      "enabled": true
    },
    {
      "name": "chklastlog",
      "enabled": true
    },
    {
      "name": "chkwtmp",
      "enabled": true
    },
    {
      "name": "chkproc",
      "enabled": true
    },
    {
      "name": "chkrootkit",
      "enabled": false
    }
  ],
  "use_selective_checking": false,
  "debug_mode": false,
  "log_file": "/var/log/chkrootkit.log",
  "mail_to": [
    "admin@example.com",
    "ops@example.com"
  ],
  "mail_subject": "[Security] chkrootkit scan results for webserver01",
  "email_threshold": 1,
  "extra_args": [
    "-d"
  ],
  "hostname": "webserver01"
}
