# APT source list configuration for the Mobian operating system repository.
# This file is managed by Ansible. Do not edit manually.

# List of repository types to enable.
# Valid values are 'deb' for binary packages and 'deb-src' for source packages.
Type: {{ types | default(['deb', 'deb-src']) | join(' ') }}

# List of repository URIs.
# These are the base URLs from which the package lists are fetched.
URI: {{ uris | default(['https://repo.mobian.org/']) | join(' ') }}

# List of repository suites.
# The suite name corresponds to the Debian release codename (e.g., trixie, bookworm).
Suite: {{ suites | default(['trixie']) | join(' ') }}

# List of repository components.
# Components define the sections of the repository (e.g., main, contrib, non-free).
Component: {{ components | default(['main']) | join(' ') }}

# Path to the GPG keyring file used to sign the repository.
# This key is used to verify the authenticity of the package lists.
Signed-By: {{ signed_by | default('/usr/share/keyrings/mobian-archive-keyring.gpg') }}
