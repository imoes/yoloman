# mobian-archive-keyring configuration
# This file defines the trusted APT repositories and their signing keys for the Mobian distribution.
# It is consumed by scripts or APT sources management tools to ensure package integrity and availability.

# Types: default=['deb', 'deb-src']  desc='List of repository types (e.g., deb, deb-src).'
# Defines which types of package lists (binary and source) to retrieve.
Types: {{ types | default(['deb', 'deb-src']) }}

# URIs: default=['https://repo.mobian.org/']  desc='List of repository URIs.'
# The base URLs where the package repositories are hosted.
URIs: {{ uris | default(['https://repo.mobian.org/']) }}

# Suites: default=['trixie']  desc='List of repository suites (e.g., trixie, bookworm).'
# The distribution codenames/suites to track within the repository URIs.
Suites: {{ suites | default(['trixie']) }}

# Components: default=['main']  desc='List of repository components (e.g., main, contrib, non-free).'
# The repository components (sections) to enable within the suites.
Components: {{ components | default(['main']) }}

# Signed-By: default='/usr/share/keyrings/mobian-archive-keyring.gpg'  desc='Path to the GPG keyring file used to sign the repository.'
# Path to the GPG keyring file containing the public keys used to verify repository signatures.
Signed-By: {{ signed_by | default('/usr/share/keyrings/mobian-archive-keyring.gpg') }}