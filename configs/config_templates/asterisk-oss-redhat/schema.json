{
  "device": {
    "type": "string",
    "default": "/dev/dsp",
    "description": "Device to use for I/O (e.g., /dev/dsp, /dev/dsp1)"
  },
  "mixer": {
    "type": "string",
    "default": null,
    "description": "Optional mixer command to run upon startup"
  },
  "boost": {
    "type": "string",
    "default": null,
    "description": "Software mic volume booster/attenuator in dB (-20.0 to +20.0)"
  },
  "callerid": {
    "type": "string",
    "default": null,
    "description": "Caller ID for outgoing calls (e.g., John Doe <555-1234>)"
  },
  "autoanswer": {
    "type": "string",
    "default": null,
    "description": "Enable autoanswer on call"
  },
  "autohangup": {
    "type": "string",
    "default": null,
    "description": "Hangup when other party closes"
  },
  "extension": {
    "type": "string",
    "default": null,
    "description": "Default extension to call"
  },
  "context": {
    "type": "string",
    "default": null,
    "description": "Default context for outgoing calls"
  },
  "language": {
    "type": "string",
    "default": null,
    "description": "Default language"
  },
  "overridecontext": {
    "type": "string",
    "default": null,
    "description": "Interpret whole dial string as extension (no/yes)"
  },
  "queuesize": {
    "type": "number",
    "default": null,
    "description": "Frames in device driver"
  },
  "frags": {
    "type": "number",
    "default": null,
    "description": "Argument to SETFRAGMENT"
  },
  "jbenable": {
    "type": "string",
    "default": null,
    "description": "Enable jitterbuffer on receiving OSS channel (yes/no)"
  },
  "jbmaxsize": {
    "type": "number",
    "default": null,
    "description": "Max length of the jitterbuffer in milliseconds"
  },
  "jbresyncthreshold": {
    "type": "number",
    "default": null,
    "description": "Jump in frame timestamps over which jitterbuffer is resynchronized"
  },
  "jbimpl": {
    "type": "string",
    "default": null,
    "description": "Jitterbuffer implementation (fixed/adaptive)",
    "enum": [
      "fixed",
      "adaptive"
    ]
  },
  "jbtargetextra": {
    "type": "number",
    "default": null,
    "description": "Milliseconds by which adaptive jitter buffer pads its size"
  },
  "jblog": {
    "type": "string",
    "default": null,
    "description": "Enable jitterbuffer frame logging (yes/no)"
  },
  "my_video_section": {
    "type": "string",
    "default": "my_video",
    "description": "Section name for video configuration"
  },
  "videodevice": {
    "type": "string",
    "default": "/dev/video0",
    "description": "Video device path (e.g., /dev/video0)"
  },
  "videodevice_x11": {
    "type": "string",
    "default": "X11",
    "description": "X11 grabber identifier"
  },
  "videocodec": {
    "type": "string",
    "default": "h263\t\t; also h261, h263p, h264, mpeg4, ...",
    "description": "Video codec (h261, h263p, h264, mpeg4, etc.)",
    "enum": [
      "h261",
      "h263",
      "h263p",
      "h264",
      "mpeg4"
    ]
  },
  "video_size": {
    "type": "string",
    "default": "352x288",
    "description": "Video geometry WIDTHxHEIGHT"
  },
  "video_size_cif": {
    "type": "string",
    "default": "cif",
    "description": "Standard video size alias (sqcif, qcif, cif, qvga, vga)",
    "enum": [
      "qcif",
      "cif",
      "qvga",
      "vga"
    ]
  },
  "camera_size": {
    "type": "string",
    "default": "cif",
    "description": "Camera size alias",
    "enum": [
      "qcif",
      "cif",
      "qvga",
      "vga"
    ]
  },
  "remote_size": {
    "type": "string",
    "default": "cif",
    "description": "Remote display size alias",
    "enum": [
      "qcif",
      "cif",
      "qvga",
      "vga"
    ]
  },
  "local_size": {
    "type": "string",
    "default": "qcif",
    "description": "Local display size alias",
    "enum": [
      "qcif",
      "cif",
      "qvga",
      "vga"
    ]
  },
  "bitrate": {
    "type": "number",
    "default": "60000             ; rate told to ffmpeg.",
    "description": "Bitrate told to ffmpeg"
  },
  "fps": {
    "type": "number",
    "default": "5                     ; frames per second from the source.",
    "description": "Frames per second from source"
  },
  "qmin": {
    "type": "number",
    "default": null,
    "description": "Quantizer value passed to the encoder"
  },
  "my_skin_section": {
    "type": "string",
    "default": "my_skin",
    "description": "Section name for keypad skin configuration"
  },
  "keypad_path": {
    "type": "string",
    "default": "/tmp/keypad.jpg",
    "description": "Path to keypad image file"
  },
  "skin2_section": {
    "type": "string",
    "default": "skin2",
    "description": "Section name for second skin configuration"
  },
  "keypad2_path": {
    "type": "string",
    "default": "/tmp/kpad2.jpg",
    "description": "Path to second keypad image file"
  },
  "keypad_font_path": {
    "type": "string",
    "default": "/tmp/font.png",
    "description": "Path to keypad font file"
  }
}
