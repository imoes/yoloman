{# MPTCP daemon global configuration #}
{% if log_level is defined and log_level != '' %}log_level: {{ log_level }}
{% endif %}{# log level: debug, info, warn, error, critical #}

{% if log_file is defined and log_file != '' %}log_file: {{ log_file }}
{% endif %}{# path to log file #}

{% if pid_file is defined and pid_file != '' %}pid_file: {{ pid_file }}
{% endif %}{# path to PID file #}

{% if run_dir is defined and run_dir != '' %}run_dir: {{ run_dir }}
{% endif %}{# directory for runtime files (e.g., sockets) #}

{% if default_subflow_timeout is defined %}default_subflow_timeout: {{ default_subflow_timeout }}
{% endif %}{# seconds before unused subflow is removed #}

{% if auto_create_subflows is defined %}auto_create_subflows: {{ auto_create_subflows | lower }}
{% endif %}{# enable automatic subflow creation on new connections #}

{% if address_auto_add is defined %}address_auto_add: {{ address_auto_add | lower }}
{% endif %}{# automatically announce local addresses via MPTCP DUMP #}

{% if address_auto_delete is defined %}address_auto_delete: {{ address_auto_delete | lower }}
{% endif %}{# automatically withdraw local addresses when they are removed #}

{% if allowed_interfaces is defined and allowed_interfaces | length > 0 %}# allow subflows only on these interfaces
allowed_interfaces:
{% for iface in allowed_interfaces %}  - {{ iface }}
{% endfor %}{% endif %}

{% if blocked_interfaces is defined and blocked_interfaces | length > 0 %}# disallow subflows on these interfaces
blocked_interfaces:
{% for iface in blocked_interfaces %}  - {{ iface }}
{% endfor %}{% endif %}

{% if endpoints is defined and endpoints | length > 0 %}# static MPTCP endpoints (optional, overrides auto detection)
endpoints:
{% for ep in endpoints %}  - address: {{ ep.address }}
    {% if ep.port is defined %}    port: {{ ep.port }}
    {% endif %}
    {% if ep.interface is defined %}    interface: {{ ep.interface }}
    {% endif %}
    {% if ep.priority is defined %}    priority: {{ ep.priority }}
    {% endif %}
    {% if ep.backup is defined %}    backup: {{ ep.backup | lower }}
    {% endif %}
{% endfor %}{% endif %}

{% if kernel_limits is defined %}# kernel-level limits (optional, leave empty to use system defaults)
kernel_limits:
  {% if kernel_limits.max_subflows is defined %}max_subflows: {{ kernel_limits.max_subflows }}
  {% endif %}
  {% if kernel_limits.token_max is defined %}token_max: {{ kernel_limits.token_max }}
  {% endif %}
{% endif %}
