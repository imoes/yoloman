{
  "log_level": "info",
  "log_file": "/var/log/mptcpd.log",
  "pid_file": "/run/mptcpd.pid",
  "run_dir": "/run/mptcpd",
  "default_subflow_timeout": 60,
  "auto_create_subflows": true,
  "address_auto_add": true,
  "address_auto_delete": true,
  "allowed_interfaces": [
    "eth0",
    "wlan0"
  ],
  "blocked_interfaces": [
    "lo"
  ],
  "endpoints": [
    {
      "address": "192.168.1.10",
      "priority": 255,
      "backup": false
    },
    {
      "address": "fd00::1",
      "interface": "eth0",
      "priority": 200
    }
  ],
  "kernel_limits": {
    "max_subflows": 4,
    "token_max": 512
  }
}
