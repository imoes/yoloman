# daxctl configuration file
# This file is placed in {{ sysconfdir | default('/etc') }}/daxctl.conf.d/ and is parsed by daxctl.
# All files with the .conf suffix under {{ sysconfdir | default('/etc') }}/daxctl.conf.d/ are valid config files.
# Lines beginning with a '#' are treated as comments and ignored.
#
# The (section-name, subsection-name) tuple must be unique across all config files.
# The subsection name here is: {{ subsection_name | default('unique_identifier_foo') }}

# [reconfigure-device {{ subsection_name | default('unique_identifier_foo') }}]
# This section instructs daxctl to automatically reconfigure an NVDIMM namespace.
# Uncomment the lines below to activate the reconfiguration.

# nvdimm.uuid = {{ nvdimm_uuid | default('ed93e918-e165-49d8-921d-383d7b9660c5') }}
# UUID of the NVDIMM device to reconfigure.

# mode = {{ mode | default('system-ram') }}
# Target mode for the NVDIMM namespace (e.g., 'devdax', 'system-ram').

# online = {{ online | default('omit') | lower }}
# If set, specifies whether the namespace should be onlineed after reconfiguration.

# movable = {{ movable | default('omit') | lower }}
# If set, specifies whether the namespace should be movable after reconfiguration.