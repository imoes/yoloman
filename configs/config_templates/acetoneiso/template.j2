# acetoneiso (1) — feature-rich graphical application to mount and manage CD/DVD images
#
# Note: acetoneiso is a GUI application and does not typically use a system-wide
# configuration file. Settings are usually managed via the application's interface
# or passed as command-line arguments. This template provides a configuration
# structure for environments where default behaviors need to be enforced
# programmatically or where a drop-in configuration is supported by the packaging.
#
# Usage:
#   acetoneiso [--help] [FILE]

# help_flag: Whether to print help and exit (equivalent to --help flag)
# Set to 'true' to force help output on startup. Defaults to False.
help_flag={{ acetoneiso_help_flag | default(False) | lower }}

# mount_file: Path to CD/DVD image file to mount on startup (optional)
# If provided, acetoneiso will attempt to mount this image immediately upon launch.
# Leave empty to start without mounting.
mount_file={{ acetoneiso_mount_file | default('') }}

# supported_formats: List of image formats supported by acetoneiso (case-insensitive; based on GUI features described in man page)
# Defines the file extensions the application recognizes and can handle.
# Default: ['iso', 'bin', 'nrk', 'mdf', 'img', 'nrg']
supported_formats={{ acetoneiso_supported_formats | default(['iso', 'bin', 'nrk', 'mdf', 'img', 'nrg']) | join(', ') }}