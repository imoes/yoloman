{
  "section_name": "main",
  "port": 8443,
  "worker_count": 8,
  "log_level": "WARNING",
  "log_dir": "/var/log/gross",
  "data_dir": "/var/lib/gross",
  "use_tls": true,
  "allowed_origins": [
    "https://dashboard.example.com",
    "https://admin.example.com"
  ],
  "hostname": "gross.internal.example.com",
  "timeout": 45,
  "max_upload_size": 256,
  "extra_sections": [
    {
      "name": "metrics",
      "options": {
        "enabled": "true",
        "endpoint": "/metrics",
        "interval": "15"
      }
    },
    {
      "name": "cache",
      "options": {
        "backend": "redis",
        "ttl": "3600",
        "host": "redis.local"
      }
    }
  ]
}
