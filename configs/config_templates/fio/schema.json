{
  "provides": {
    "type": "string",
    "default": "fio",
    "description": "Service name provided by this init script"
  },
  "short_description": {
    "type": "string",
    "default": "Flexible I/O Tester as service",
    "description": "Short description of the service"
  },
  "description": {
    "type": "string",
    "default": "Runs fio as a service to that fio clients can connect to it",
    "description": "Detailed description of the service"
  },
  "author": {
    "type": "string",
    "default": "Martin Steigerwald <martin.steigerwald@proact.de>",
    "description": "Author of the init script"
  },
  "desc": {
    "type": "string",
    "default": "Flexible I/O Tester as service",
    "description": "Service description (DEBCONF/DESC)"
  },
  "daemon_path": {
    "type": "string",
    "default": "/usr/bin/fio",
    "description": "Path to the fio daemon binary"
  },
  "daemon_args": {
    "type": "string",
    "default": "--server --daemonize /run/fio.pid",
    "description": "Arguments passed to the fio daemon on startup"
