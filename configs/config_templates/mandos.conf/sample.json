{
  "server": "mandos.example.com",
  "client_port": 11211,
  "timeout": 45,
  "max_retries": 3,
  "reboot_delay": 5,
  "keydir": "/var/lib/mandos",
  "tmpdir": "/run/mandos",
  "loglevel": "notice",
  "logfile": "/var/log/mandos.log",
  "gnupghome": "/etc/mandos/gnupghome",
  "gpg_keys": [
    "A1B2C3D4E5F6A1B2C3D4E5F6A1B2C3D4E5F6A1B2",
    "FEDCBA9876543210FEDCBA9876543210FEDCBA98"
  ],
  "verify_signatures": true,
  "trusted_fingerprints": [],
  "enable_ipv6": true,
  "bind_interfaces": [
    "eth0"
  ],
  "allowed_networks": [
    "127.0.0.0/8",
    "192.168.1.0/24"
  ],
  "mdns_enable": true,
  "mdns_service_name": "_mandos._tcp",
  "journal_socket": "/run/systemd/journal/stdout",
  "systemd_integration": "auto"
}
