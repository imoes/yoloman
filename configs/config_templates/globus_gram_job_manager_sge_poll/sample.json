{
  "enabled": true,
  "poll_interval": 60,
  "max_jobs_per_poll": 100,
  "qmaster_host": "sge-qmaster.example.org",
  "cell_name": "mycell",
  "sgeroot": "/opt/sge",
  "sge_bin": "/opt/sge/bin/lx-amd64",
  "qstat_path": "/opt/sge/bin/lx-amd64/qstat",
  "qacct_path": "/opt/sge/bin/lx-amd64/qacct",
  "exec_hosts": [
    "exec-01",
    "exec-02",
    "exec-03"
  ],
  "verbose_job_status": true,
  "job_state_cache_file": "/var/lib/globus/job_state_cache.xml",
  "job_state_cache_ttl": 300,
  "use_pe_info": true,
  "resource_limits": [
    {
      "name": "h_vmem",
      "type": "integer",
      "globus_attr": "Memory"
    },
    {
      "name": "h_cpu",
      "type": "integer",
      "globus_attr": "CPUTime"
    }
  ],
  "enable_cleanup": false,
  "max_concurrent_polls": 3
}
