{
  "server": [
    "http://glpi.example.com/glpi/plugins/fusioninventory/front/plugin_fusioninventory.communication.php"
  ],
  "delaytime": 1800,
  "lazy": true,
  "force": false,
  "no_task": [],
  "tasks": [
    "inventory",
    "deploy",
    "..."
  ],
  "no_category": [
    "virtualmachine"
  ],
  "scan_homedirs": false,
  "scan_profiles": false,
  "html": false,
  "backend_collect_timeout": 45,
  "additional_content": "/etc/fusioninventory/additional-content.xml",
  "no_p2p": false,
  "proxy": "http://proxy.example.com:3128",
  "user": "fusioninventory",
  "password": "secret123",
  "ca_cert_dir": "/etc/ssl/certs",
  "ca_cert_file": "",
  "no_ssl_check": false,
  "no_compression": false,
  "timeout": 120,
  "no_httpd": false,
  "httpd_ip": "127.0.0.1",
  "httpd_port": 62354,
  "httpd_trust": [
    "192.168.0.0/24",
    "10.0.0.5"
  ],
  "listen": false,
  "logger": [
    "file",
    "syslog"
  ],
  "logfile": "/var/log/fusioninventory-agent/fusioninventory-agent.log",
  "logfile_maxsize": 10,
  "logfacility": "LOG_LOCAL0",
  "color": false,
  "config_backend": "file",
  "conf_file": "/etc/fusioninventory/agent.cfg",
  "conf_reload_interval": 300,
  "wait": 60,
  "daemon": true,
  "no_fork": false,
  "pidfile": "/run/fusioninventory-agent.pid",
  "tag": "prod-server-01",
  "debug": 0
}
