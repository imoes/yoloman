{
  "netscript.interface": {
    "type": "string",
    "default": "eth0",
    "description": "Primary network interface for service communication"
  },
  "netscript.host": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "Service host address"
  },
  "netscript.port": {
    "type": "number",
    "default": 8080,
    "description": "Service listening port"
  },
  "netscript.debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug logging"
  },
  "netscript.log_file": {
    "type": "string",
    "default": "/var/log/netscript/netscript.log",
    "description": "Log file path"
  },
  "netscript.allowed_origins": {
    "type": "list",
    "default": [
      "http://localhost"
    ],
    "description": "Allowed origins for CORS"
  },
  "netscript.workers.count": {
    "type": "number",
    "default": 4,
    "description": "Number of worker processes"
  },
  "netscript.workers.timeout": {
    "type": "number",
    "default": 30,
    "description": "Worker timeout in seconds"
  },
  "netscript.ssl.enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable SSL"
  },
  "netscript.ssl.cert_path": {
    "type": "string",
    "default": "/etc/ssl/netscript/cert.pem",
    "description": "Path to SSL certificate"
  },
  "netscript.ssl.key_path": {
    "type": "string",
    "default": "/etc/ssl/netscript/key.pem",
    "description": "Path to SSL private key"
  },
  "netscript.database.driver": {
    "type": "string",
    "default": "sqlite3",
    "description": "Database driver"
  },
  "netscript.database.dsn": {
    "type": "string",
    "default": "/var/lib/netscript/data.db",
    "description": "Database connection string or path"
  },
  "netscript.health_check.enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable health check"
  },
  "netscript.health_check.path": {
    "type": "string",
    "default": "/health",
    "description": "Path for health check"
  }
}
