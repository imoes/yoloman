{
  "netscript": {
    "interface": "ens33",
    "host": "192.168.1.100",
    "port": 9090,
    "debug": true,
    "log_file": "/var/log/netscript/app.log",
    "allowed_origins": [
      "http://localhost:3000",
      "https://example.com"
    ],
    "workers": {
      "count": 8,
      "timeout": 60
    },
    "ssl": {
      "enabled": true,
      "cert_path": "/etc/ssl/certs/netscript.crt",
      "key_path": "/etc/ssl/private/netscript.key"
    },
    "database": {
      "driver": "postgres",
      "dsn": "host=localhost port=5432 user=netscript password=secret dbname=netscript"
    },
    "health_check": {
      "enabled": true,
      "path": "/api/health"
    }
  }
}
