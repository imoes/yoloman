<?xml version="1.0"?> <!--*-nxml-*-->
<!--
  D-Bus Bus Configuration for TCMU (Target Configurable Userspace)
  This file defines access policies for the TCMU D-Bus service.
  It allows the configured user to own the service and grants
  broad access to the service methods for other local users.
-->
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
    <!--
      Policy for the specific user allowed to own the D-Bus service.
      This restricts 'own' (creating the service name) to a single privileged user.
    -->
    <policy user="{{ user | default('root') }}">
        <!-- Allow this user to claim the primary service name -->
        <allow own="{{ service_name | default('org.kernel.TCMUService1') }}"/>
    </policy>

    <!--
      Default Policy: Defines what other users/roles can do.
      The 'default' context applies to any user not matched by specific policies above.
    -->
    <policy context="default">
        <!-- Allow clients to send method calls to the TCMU service name -->
        <allow send_destination="{{ service_name | default('org.kernel.TCMUService1') }}"/>

        <!--
          Allow any client to own services under this prefix.
          This permits handler plugins to register their own D-Bus names
          derived from the main service name.
        -->
        <allow own_prefix="{{ handler_prefix | default('org.kernel.TCMUService1.HandlerManager1') }}"/>

        <!-- Allow clients to send messages to interfaces matching the service name -->
        <allow send_interface="{{ service_name | default('org.kernel.TCMUService1') }}"/>
    </policy>
</busconfig>
