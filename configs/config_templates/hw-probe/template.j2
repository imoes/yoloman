# =============================================================================
# hw-probe Configuration Template
#
# This configuration file drives the hw-probe hardware inventory tool.
# It is generated by Ansible and is self-documenting.
# See schema fields for descriptions and defaults.
# =============================================================================

# Logging level: minimal, default, or maximal. Corresponds to --log-level.
# Values: minimal, default, maximal
LOG_LEVEL = {{ log_level | default('default') }}

# List of log types to enable in addition to log level. Corresponds to --enable.
# Space-separated list of log type identifiers.
ENABLED_LOGS = {{ enabled_logs | default([]) | join(' ') }}

# List of log types to disable. Corresponds to --disable.
# Space-separated list of log type identifiers.
DISABLED_LOGS = {{ disabled_logs | default([]) | join(' ') }}

# Path to the hwinfo binary. Corresponds to --hwinfo-path.
HWINFO_PATH = {{ hwinfo_path | default('/usr/sbin/hwinfo') }}

# Outgoing proxy address:port. Corresponds to --proxy.
# Format: http://host:port or https://host:port
PROXY = {{ proxy | default('') }}

# Inventory ID for the probe. Corresponds to -i.
# Used to tag the resulting hardware inventory record.
INVENTORY_ID = {{ inventory_id | default('') }}

# Email address for notifications. Corresponds to --email.
# The probe tool may send email status reports to this address.
EMAIL = {{ email | default('') }}

# Description or name of the probe. Corresponds to --id.
# A human-readable label for this specific probe run.
ID = {{ id | default('') }}

# Path to PCI IDs file. Corresponds to --pci-ids.
PCI_IDS_PATH = {{ pci_ids_path | default('/usr/share/hwdata/pci.ids') }}

# Path to USB IDs file. Corresponds to --usb-ids.
USB_IDS_PATH = {{ usb_ids_path | default('/usr/share/hwdata/usb.ids') }}

# Path to SDIO IDs file. Corresponds to --sdio-ids.
SDIO_IDS_PATH = {{ sdio_ids_path | default('/usr/share/hwdata/sdio.ids') }}

# Path to PNP IDs file. Corresponds to --pnp-ids.
PNP_IDS_PATH = {{ pnp_ids_path | default('/usr/share/hwdata/pnp.ids') }}

# Perform extended checks (CPU, memory, GPU, drive performance). Corresponds to --check-extended.
# Values: true or false
CHECK_EXTENDED = {{ check_extended | default(false) | lower }}

# Check devices operability. Corresponds to --check.
# Values: true or false
CHECK = {{ check | default(false) | lower }}

# Upload result to hardware database. Corresponds to --upload.
# Values: true or false
UPLOAD = {{ upload | default(false) | lower }}

# Start monitoring of the node. Corresponds to --start.
# Values: true or false
MONITOR_START = {{ monitor_start | default(false) | lower }}

# Stop monitoring of the node. Corresponds to --stop.
# Values: true or false
MONITOR_STOP = {{ monitor_stop | default(false) | lower }}

# Directory to save probe package (local save mode). Corresponds to --save.
# If UPLOAD is false, the probe result is saved here instead of sent remotely.
SAVE_DIR = {{ save_dir | default('/var/lib/hw-probe/queue') }}

# Path to existing probe to upload. Corresponds to --src.
# Use an existing probe file instead of running a new probe.
SRC_PATH = {{ src_path | default('') }}

# Path to update device info in probe. Corresponds to --fix.
# Fix/update device information in an existing probe file.
FIX_PATH = {{ fix_path | default('') }}

# Directory to import probes. Corresponds to --import.
# Directory from which to import previously saved probe packages.
IMPORT_DIR = {{ import_dir | default('/var/lib/hw-probe/import') }}