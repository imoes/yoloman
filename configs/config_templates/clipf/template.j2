# clim configuration
#
# Configuration file for clipf (clipboard/file utility framework).
#
# clipf tries to import configuration from these files in order of precedence:
# 1. System-wide config at /etc/clipf.conf
# 2. User-level config at ~/clipf.conf
# 3. DB-specific config at <conf_path>/clipf.conf

# default_account: Default account ID used for new operations.
# If not set, clipf will default to account '00'.
{% if default_account is defined %}
{% if default_account is defined and default_account is not none and (default_account is number or default_account is boolean or default_account | length > 0) %}opt.acc='{{ default_account }}'{% else %}#opt.acc='00'{% endif %}
{% else %}
#opt.acc='00'
{% endif %}

# max_lines: Maximum number of output lines before piping to 'less'.
# This limits the volume of data displayed on the terminal before paging.
# If not set, clipf defaults to 40 lines.
{% if max_lines is defined %}
{% if max_lines is defined and max_lines is not none and max_lines != '' %}opt.max_lines={{ max_lines }}{% else %}#opt.max_lines=40{% endif %}
{% else %}
#opt.max_lines=40
{% endif %}

# terminal_encoding: Encoding expected for terminal input (fallback if sys.stdin.encoding fails).
# This ensures correct handling of special characters in the terminal.
# If not set, it falls back to 'sys.stdin.encoding' or 'UTF-8'.
{% if terminal_encoding is defined %}
{% if terminal_encoding is defined and terminal_encoding is not none and (terminal_encoding is number or terminal_encoding is boolean or terminal_encoding | length > 0) %}opt.term_enc='{{ terminal_encoding }}'{% else %}#opt.term_enc=sys.stdin.encoding or 'UTF-8'{% endif %}
{% else %}
#opt.term_enc='UTF-8'
{% endif %}

# database_encoding: Encoding of data files used by clipf.
# This defines the character set for reading/writing persistent data files.
# If not set, clipf defaults to 'UTF-8'.
{% if database_encoding is defined %}
{% if database_encoding is defined and database_encoding is not none and (database_encoding is number or database_encoding is boolean or database_encoding | length > 0) %}opt.db_enc='{{ database_encoding }}'{% else %}#opt.db_enc='UTF-8'{% endif %}
{% else %}
#opt.db_enc='UTF-8'
{% endif %}

