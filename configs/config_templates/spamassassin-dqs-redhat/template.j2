# Spamhaus Dynamic Query Service (DQS) configuration for SpamAssassin
# Requires the SpamAssassin SH plugin (Mail::SpamAssassin::Plugin::SH)
#
# This template configures various Spamhaus blocklists (AuthBL, ZEN, SBL, CSS, XBL, PBL, DBL, ZRD)
# to be queried via the authenticated DQS API endpoint.

ifplugin Mail::SpamAssassin::Plugin::SH

  # Header rule: Check if the connecting IP is in the Spamhaus AuthBL (Authenticated Senders Blocklist)
  # The query format is: <key>.authbl.dq.spamhaus.net.
  header	__RCVD_IN_AUTHBL	eval:check_rbl('authbl', '{{ (dqs_key | default("your_DQS_key")) }}.authbl.dq.spamhaus.net.')
  tflags	__RCVD_IN_AUTHBL	net
  meta		RCVD_IN_AUTHBL		__RCVD_IN_AUTHBL
  describe	RCVD_IN_AUTHBL		Received via a relay in Spamhaus AuthBL

  # Header rule: Check if the connecting IP is in the Spamhaus ZEN (Combined Blocklist)
  # The query format is: <key>.zen.dq.spamhaus.net.
  header	__RCVD_IN_ZEN	eval:check_rbl('zendqs', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.')
  tflags	__RCVD_IN_ZEN	net

  # Header rule: Check the last untrusted relay IP against ZEN with specific regex for private IP ranges
  # The query format is: <key>.zen.dq.spamhaus.net.
  header	__RCVD_IN_ZEN_LASTEXTERNAL	eval:check_rbl('zendqs-lastexternal', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.', '^127\.0\.0\.([2-9]|10|11)$')
  tflags	__RCVD_IN_ZEN_LASTEXTERNAL	net
  priority	__RCVD_IN_ZEN_LASTEXTERNAL	-200
  meta		RCVD_IN_ZEN_LASTEXTERNAL	__RCVD_IN_ZEN_LASTEXTERNAL
  describe	RCVD_IN_ZEN_LASTEXTERNAL	The last untrusted relay is listed in Spamhaus ZEN

  ifplugin Mail::SpamAssassin::Plugin::Shortcircuit  
    # Short-circuit evaluation: If the last external relay is in ZEN, mark as spam immediately
    shortcircuit	RCVD_IN_ZEN_LASTEXTERNAL	spam
  endif # Mail::SpamAssassin::Plugin::Shortcircuit

  # Header rule: Check IP against ZEN for SBL matches (127.0.0.2)
  header	__RCVD_IN_SBL		eval:check_rbl('zendqs', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.', '^127\.0\.0\.2$')
  meta		RCVD_IN_SBL		__RCVD_IN_SBL

  # Header rule: Check IP against ZEN for CSS matches (127.0.0.3)
  header	__RCVD_IN_SBL_CSS	eval:check_rbl('zendqs', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.', '^127\.0\.0\.3$')
  meta		RCVD_IN_SBL_CSS		__RCVD_IN_SBL_CSS

  # Header rule: Check IP against ZEN for DROP matches (127.0.0.9)
  header	__RCVD_IN_SBL_DROP	eval:check_rbl('zendqs', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.', '^127\.0\.0\.9$')
  meta		RCVD_IN_SBL_DROP	__RCVD_IN_SBL_DROP

#  score		RCVD_IN_XBL		0
  # Header rule: Check IP against ZEN for XBL matches (127.0.0.4-7)
  header	RCVD_IN_XBL		eval:check_rbl('zendqs', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.', '^127\.0\.0\.[4567]$')
  tflags	RCVD_IN_XBL		net

  # Header rule: Check IP against ZEN for PBL matches (127.0.0.10-11)
  header	__RCVD_IN_PBL		eval:check_rbl('zendqs', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.', '^127\.0\.0\.1[01]$')
  tflags	__RCVD_IN_PBL		net
  meta		RCVD_IN_PBL		__RCVD_IN_PBL

  ifplugin Mail::SpamAssassin::Plugin::URIDNSBL
    # URI DNS Blacklist: SBL (Spamhaus Block List) - Standard match (127.0.0.2)
    uridnssub URIBL_SBL             {{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net. A 127.0.0.2

    # URI DNS Blacklist: DBL (Domain Block List) - Spam matches (127.0.1.2)
    urirhssub URIBL_DBL_SPAM        {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.2

    # URI DNS Blacklist: DBL - Phishing matches (127.0.1.4)
    urirhssub URIBL_DBL_PHISH       {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.4

    # URI DNS Blacklist: DBL - Malware matches (127.0.1.5)
    urirhssub URIBL_DBL_MALWARE     {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.5

    # URI DNS Blacklist: DBL - Botnet Command & Control matches (127.0.1.6)
    urirhssub URIBL_DBL_BOTNETCC    {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.6

    # URI DNS Blacklist: DBL - Abused domains (Spam) (127.0.1.102)
    urirhssub URIBL_DBL_ABUSE_SPAM  {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.102

    # URI DNS Blacklist: DBL - Abused domains (Redirection) (127.0.1.103)
    urirhssub URIBL_DBL_ABUSE_REDIR {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.103

    # URI DNS Blacklist: DBL - Abused domains (Phishing) (127.0.1.104)
    urirhssub URIBL_DBL_ABUSE_PHISH {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.104

    # URI DNS Blacklist: DBL - Abused domains (Malware) (127.0.1.105)
    urirhssub URIBL_DBL_ABUSE_MALW  {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.105

    # URI DNS Blacklist: DBL - Abused domains (Botnet C&C) (127.0.1.106)
    urirhssub URIBL_DBL_ABUSE_BOTCC {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.106

    # URI DNS Blacklist: DBL - Error/Reserved (127.0.1.255)
    urirhssub URIBL_DBL_ERROR       {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net. A 127.0.1.255

    if can(Mail::SpamAssassin::Plugin::URIDNSBL::has_tflags_domains_only)
      # URI DNS Blacklist: ZRD (Zero Day Reputation Database) - Domains only tflag
      urirhsbl  URIBL_ZRD             {{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net. A
      body      URIBL_ZRD             eval:check_uridnsbl('URIBL_ZRD')
      describe  URIBL_ZRD             Contains a URL listed in the Spamhaus ZRD blocklist
      tflags    URIBL_ZRD             net domains_only
    endif # if can

    # URI DNS Blacklist: CSS (Spamhaus CSS - Spam and Spyware) (127.0.0.3)
    uridnssub URIBL_CSS             {{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net. A 127.0.0.3

    if can(Mail::SpamAssassin::Plugin::URIDNSBL::has_uridnsbl_for_a)
      # URI DNS Blacklist: SBL with 'a' tflag
      uridnssub URIBL_SBL_A         {{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net. A 127.0.0.2
      body            URIBL_SBL_A      eval:check_uridnsbl('URIBL_SBL_A')
      tflags          URIBL_SBL_A      net a
      reuse           URIBL_SBL_A  

      # URI DNS Blacklist: CSS with 'a' tflag
      uridnssub URIBL_CSS_A         {{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net. A 127.0.0.3
      body            URIBL_CSS_A      eval:check_uridnsbl('URIBL_CSS_A')
      tflags          URIBL_CSS_A      net a
      reuse           URIBL_CSS_A
    endif # if can
  endif   # Mail::SpamAssassin::Plugin::URIDNSBL

  # Body rule: Check URIs in body against SBL
  body		SH_BODYURI_REVERSE_SBL	eval:check_sh_bodyuri_a('{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net', '^127\.0\.0\.2$')
  priority	SH_BODYURI_REVERSE_SBL	-100
  describe	SH_BODYURI_REVERSE_SBL The corresponding A record of an URI contained in the body is listed in SBL

  # Body rule: Check URIs in body against CSS
  body		SH_BODYURI_REVERSE_CSS	eval:check_sh_bodyuri_a('{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net', '^127\.0\.0\.3$')
  priority	SH_BODYURI_REVERSE_CSS	-100
  describe	SH_BODYURI_REVERSE_CSS  The corresponding A record of an URI contained in the body is listed in CSS

  # Body rule: Check URIs in body against DROP
  body		SH_BODYURI_REVERSE_DROP	eval:check_sh_bodyuri_a('{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net', '^127\.0\.0\.9$')
  priority	SH_BODYURI_REVERSE_DROP	-100
  describe	SH_BODYURI_REVERSE_DROP  The corresponding A record of an URI contained in the body is listed in DROP

  # Body rule: Check URIs in body against XBL
  body		SH_BODYURI_REVERSE_XBL	eval:check_sh_bodyuri_a('{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net', '^127\.0\.0\.4$')
  priority	SH_BODYURI_REVERSE_XBL	-100
  describe	SH_BODYURI_REVERSE_XBL  The corresponding A record of an URI contained in the body is listed in XBL

  # Body rule: Check email addresses in body against DBL
  body		SH_DBL_BODY	eval:check_sh_bodyemail('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.[2-6]$')
  priority	SH_DBL_BODY	-100
  describe	SH_DBL_BODY	The domain of an email address found in body is listed in DBL

  # Body rule: Check email addresses in body against DBL Abused
  body		SH_DBL_BODY_ABUSED	eval:check_sh_bodyemail('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.10[2-6]$')
  priority	SH_DBL_BODY_ABUSED	-100
  describe	SH_DBL_BODY_ABUSED	The domain of an email address found in body is listed in DBL as an abused domain

  # Body rule: Check email addresses in body against ZRD (Very Fresh: 0-4 hours)
  body		SH_ZRD_BODY_VERY_FRESH	eval:check_sh_bodyemail('{{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net', '^127\.0\.2\.[2-4]$')
  priority	SH_ZRD_BODY_VERY_FRESH	-100 
  describe	SH_ZRD_BODY_VERY_FRESH	The domain of an email address found in body is listed in ZRD and the domain age is between 0 and 4 hours

  # Body rule: Check email addresses in body against ZRD (Fresh: 5-24 hours)
  body		SH_ZRD_BODY_FRESH	eval:check_sh_bodyemail('{{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net', '^127\.0\.2\.([5-9]|1[0-9]|2[0-4])$')
  priority	SH_ZRD_BODY_FRESH	-100 
  describe	SH_ZRD_BODY_FRESH	The domain of an email address found in body is listed in ZRD and the domain age is between 5 and 24 hours

  # Header rule: Check email headers (mail from, reply-to etc..) against DBL
  header	SH_DBL_HEADERS	eval:check_sh_headers('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.[2-6]$')
  priority	SH_DBL_HEADERS	-100 
  describe	SH_DBL_HEADERS	A domain found in headers (mail from, reply-to etc..) is listed in DBL

  # Header rule: Check email headers against DBL Abused
  header	SH_DBL_HEADERS_ABUSED	eval:check_sh_headers('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.10[2-6]$')
  priority	SH_DBL_HEADERS_ABUSED	-100 
  describe	SH_DBL_HEADERS_ABUSED	A domain found in headers (mail from, reply-to etc..) is listed in DBL as an abused domain

  # Header rule: Check email headers against ZRD (Very Fresh: 0-4 hours)
  header	SH_ZRD_HEADERS_VERY_FRESH	eval:check_sh_headers('{{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net', '^127\.0\.2\.[2-4]$')
  priority	SH_ZRD_HEADERS_VERY_FRESH	-100 
  describe	SH_ZRD_HEADERS_VERY_FRESH	A domain found in headers (mail from, reply-to etc..) is listed in ZRD and the domain age is between 0 and 4 hours

  # Header rule: Check email headers against ZRD (Fresh: 5-24 hours)
  header	SH_ZRD_HEADERS_FRESH	eval:check_sh_headers('{{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net', '^127\.0\.2\.([5-9]|1[0-9]|2[0-4])$')
  priority	SH_ZRD_HEADERS_FRESH	-100 
  describe	SH_ZRD_HEADERS_FRESH	A domain found in headers (mail from, reply-to etc..) is listed in ZRD and the domain age is between 5 and 24 hours

  # Header rule: Check HELO string against DBL
  header	SH_HELO_DBL	eval:check_sh_helo('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.[2-6]$')
  priority	SH_HELO_DBL	-100
  describe	SH_HELO_DBL	The domain used in the HELO string is listed in DBL

  # Header rule: Check HELO string against DBL Abused
  header	SH_HELO_DBL_ABUSED	eval:check_sh_helo('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.10[2-6]$')
  priority	SH_HELO_DBL_ABUSED	-100
  describe	SH_HELO_DBL_ABUSED	The domain used in the HELO string is listed in DBL as an abused domain

  # Header rule: Check HELO string against ZRD (Very Fresh: 0-4 hours)
  header	SH_HELO_ZRD_VERY_FRESH	eval:check_sh_helo('{{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net', '^127\.0\.2\.[2-4]$')
  priority	SH_HELO_ZRD_VERY_FRESH	-100
  describe	SH_HELO_ZRD_VERY_FRESH	The domain used in the HELO string is listed in ZRD and the domain age is between 0 and 4 hours

  # Header rule: Check HELO string against ZRD (Fresh: 5-24 hours)
  header	SH_HELO_ZRD_FRESH	eval:check_sh_helo('{{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net', '^127\.0\.2\.([5-9]|1[0-9]|2[0-4])$')
  priority	SH_HELO_ZRD_FRESH	-100
  describe	SH_HELO_ZRD_FRESH	The domain used in the HELO string is listed in ZRD and the domain age is between 5 and 24 hours

  # Header rule: Check reverse DNS of last untrusted relay against DBL
  header	SH_REVERSE_DBL	eval:check_sh_reverse('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.[2-6]$')
  priority	SH_REVERSE_DBL	-100
  describe	SH_REVERSE_DBL  The RDNS of last untrusted relay's IP is listed in DBL

  # Header rule: Check reverse DNS of last untrusted relay against DBL Abused
  header	SH_REVERSE_DBL_ABUSED	eval:check_sh_reverse('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.10[2-6]$')
  priority	SH_REVERSE_DBL_ABUSED	-100
  describe	SH_REVERSE_DBL_ABUSED  The RDNS of last untrusted relay's IP is listed in DBL as an abused domain

  # Header rule: Check reverse DNS of last untrusted relay against ZRD (Very Fresh: 0-4 hours)
  header	SH_REVERSE_ZRD_VERY_FRESH	eval:check_sh_reverse('{{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net', '^127\.0\.2\.[2-4]$')
  priority	SH_REVERSE_ZRD_VERY_FRESH	-100
  describe	SH_REVERSE_ZRD_VERY_FRESH	The RDNS of last untrusted relay's IP is listed in ZRD and the domain age is between 0 and 4 hours

  # Header rule: Check reverse DNS of last untrusted relay against ZRD (Fresh: 5-24 hours)
  header	SH_REVERSE_ZRD_FRESH	eval:check_sh_reverse('{{ (dqs_key | default("your_DQS_key")) }}.zrd.dq.spamhaus.net', '^127\.0\.2\.([5-9]|1[0-9]|2[0-4])$')
  priority	SH_REVERSE_ZRD_FRESH	-100
  describe	SH_REVERSE_ZRD_FRESH	The RDNS of last untrusted relay's IP is listed in ZRD and the domain age is between 5 and 24 hours

  # Meta rule: Combine AuthBL IP and DBL Abused URI
  meta		SH_AUTHBL_AND_DBL_ABUSED	URIBL_DBL_ABUSE_SPAM && RCVD_IN_AUTHBL
  describe	SH_AUTHBL_AND_DBL_ABUSED	Sender IP listed in AuthBL and body contains an abused url

  # Redefining these rules even if they will -never- fire on a DQS installation.
  # This is needed because queries to the public mirrors will go underway even if the rules are zeroed

  # Block public mirror queries for DBL
  urirhssub       URIBL_DBL_BLOCKED_OPENDNS  {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net.       A   127.255.255.254
  urirhssub       URIBL_DBL_BLOCKED  {{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net.       A   127.255.255.255

  # Block public mirror queries for ZEN
  uridnssub URIBL_ZEN_BLOCKED_OPENDNS  {{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.       A   127.255.255.254
  uridnssub URIBL_ZEN_BLOCKED  {{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.       A   127.255.255.255

  # Header rule: Detect blocked opendns queries for ZEN
  header RCVD_IN_ZEN_BLOCKED_OPENDNS    eval:check_rbl('zendqs-lastexternal', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.', '^127\.255\.255\.254$')
  header RCVD_IN_ZEN_BLOCKED    eval:check_rbl('zendqs-lastexternal', '{{ (dqs_key | default("your_DQS_key")) }}.zen.dq.spamhaus.net.', '^127\.255\.255\.255$')

  # Body rule: Check hostnames in body against DBL Abused
  body		SH_DBL_ABUSED_FULLHOST	eval:check_sh_hostname('{{ (dqs_key | default("your_DQS_key")) }}.dbl.dq.spamhaus.net', '^127\.0\.1\.10[2-6]$')
  priority	SH_DBL_ABUSED_FULLHOST	-100 
  describe	SH_DBL_ABUSED_FULLHOST	A hostname found in the email body is listed in DBL as abused_legit

endif # Mail::SpamAssassin::Plugin::SH
