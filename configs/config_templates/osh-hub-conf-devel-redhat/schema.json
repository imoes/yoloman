{
  "DEBUG": {
    "type": "string",
    "default": "True",
    "description": "Enable Django debug mode."
  },
  "SECRETS_DIR": {
    "type": "string",
    "default": ".secrets",
    "description": "Directory where API keys and secrets are stored."
  },
  "ADMINS_EMAIL": {
    "type": "string",
    "default": "kdudka@redhat.com",
    "description": "Email address of the admin user (Kamil Dudka)."
  },
  "DATABASE_NAME": {
    "type": "string",
    "default": "openscanhub",
    "description": "Name of the PostgreSQL database."
  },
  "DATABASE_USER": {
    "type": "string",
    "default": "openscanhub",
    "description": "Username for the PostgreSQL database."
  },
  "DATABASE_PASSWORD": {
    "type": "string",
    "default": "velryba",
    "description": "Default password for the PostgreSQL database if get_secret fails."
  },
  "DATABASE_HOST": {
    "type": "string",
    "default": "db",
    "description": "Hostname of the PostgreSQL database server."
  },
  "DATABASE_PORT": {
    "type": "string",
    "default": "5432",
    "description": "Port of the PostgreSQL database server."
  },
  "DATABASE_TEST_NAME": {
    "type": "string",
    "default": "openscanhub-test",
    "description": "Name of the test database."
  },
  "LOG_FILENAME": {
    "type": "string",
    "default": "/var/tmp/osh.hub.log",
    "description": "Path to the log file."
  },
  "LOG_MAX_BYTES": {
    "type": "number",
    "default": 10485760,
    "description": "Maximum size of the log file in bytes (10 MB)."
  },
  "LOG_BACKUP_COUNT": {
    "type": "number",
    "default": 14,
    "description": "Number of backup log files to keep."
  },
  "TIME_ZONE": {
    "type": "string",
    "default": "Europe/Prague",
    "description": "Timezone for the application."
  },
  "EMAIL_PORT": {
    "type": "number",
    "default": 8025,
    "description": "Port for the email server."
  },
  "BZ_URL": {
    "type": "string",
    "default": "https://bugzilla.stage.redhat.com",
    "description": "URL for Bugzilla integration."
  },
  "JIRA_URL": {
    "type": "string",
    "default": "https://issues.stage.redhat.com",
    "description": "URL for Jira integration."
  },
  "ET_URL": {
    "type": "string",
    "default": "https://errata-web-01.host.stage.eng.bos.redhat.com",
    "description": "URL for Errata Tool integration."
  },
  "UMB_BROKER_1": {
    "type": "string",
    "default": "amqps://umb-broker01.stage.api.redhat.com:5671",
    "description": "First UMB broker URL."
  },
  "UMB_BROKER_2": {
    "type": "string",
    "default": "amqps://umb-broker02.stage.api.redhat.com:5671",
    "description": "Second UMB broker URL."
  },
  "UMB_BROKER_3": {
    "type": "string",
    "default": "amqps://umb-broker03.stage.api.redhat.com:5671",
    "description": "Third UMB broker URL."
  },
  "UMB_BROKER_4": {
    "type": "string",
    "default": "amqps://umb-broker04.stage.api.redhat.com:5671",
    "description": "Fourth UMB broker URL."
  },
  "UMB_BROKER_5": {
    "type": "string",
    "default": "amqps://umb-broker05.stage.api.redhat.com:5671",
    "description": "Fifth UMB broker URL."
  },
  "UMB_BROKER_6": {
    "type": "string",
    "default": "amqps://umb-broker06.stage.api.redhat.com:5671",
    "description": "Sixth UMB broker URL."
  },
  "UMB_CLIENT_CERT": {
    "type": "string",
    "default": "/etc/osh/hub/msg-client-osh.pem",
    "description": "Path to the UMB client certificate."
  },
  "UMB_TOPIC_PREFIX": {
    "type": "string",
    "default": "topic://VirtualTopic.eng.openscanhub.scan",
    "description": "Prefix for UMB topics."
  },
  "SEND_BUS_MESSAGE_KAFKA": {
    "type": "string",
    "default": "False",
    "description": "Enable sending bus messages via Kafka."
  },
  "KAFKA_BROKER_1": {
    "type": "string",
    "default": "b-3.itsandbox.642qp2.c5.kafka.us-east-1.amazonaws.com:9096",
    "description": "First Kafka broker URL."
  },
  "KAFKA_BROKER_2": {
    "type": "string",
    "default": "b-1.itsandbox.642qp2.c5.kafka.us-east-1.amazonaws.com:9096",
    "description": "Second Kafka broker URL."
  },
  "KAFKA_BROKER_3": {
    "type": "string",
    "default": "b-2.itsandbox.642qp2.c5.kafka.us-east-1.amazonaws.com:9096",
    "description": "Third Kafka broker URL."
  },
  "KAFKA_USERNAME": {
    "type": "string",
    "default": "openscanhub_sandbox",
    "description": "Username for Kafka authentication."
  },
  "KAFKA_TOPIC_PREFIX": {
    "type": "string",
    "default": "dev.eng.openscanhub.scan",
    "description": "Prefix for Kafka topics."
  },
  "NOTIFICATION_EMAIL_ADDRESS": {
    "type": "string",
    "default": "no-reply@example.org",
    "description": "Email address used in the From: field of notifications."
  },
  "DEVEL_EMAIL_ADDRESS": {
    "type": "string",
    "default": "no-reply@example.org",
    "description": "Email address for notifications about failed/cancelled tasks."
  },
  "DEFAULT_EMAIL_DOMAIN": {
    "type": "string",
    "default": "example.org",
    "description": "Default email domain for user notifications."
  },
  "NOTIFICATION_EMAIL_FOOTER": {
    "type": "string",
    "default": "This is a test footer.",
    "description": "Footer text for notification emails."
  },
  "ENABLE_SINGLE_USE_WORKERS": {
    "type": "string",
    "default": "False",
    "description": "Enable single-use workers."
  },
  "MAX_SINGLE_USE_WORKERS": {
    "type": "number",
    "default": 8,
    "description": "Maximum number of single-use workers."
  },
  "SINGLE_USE_WORKER_SSH_USER": {
    "type": "string",
    "default": "",
    "description": "SSH user for connecting to newly created workers."
  },
  "SINGLE_USE_WORKER_SSH_PRIVATE_KEY": {
    "type": "string",
    "default": "",
    "description": "SSH private key for connecting to newly created workers."
  },
  "SINGLE_USE_WORKER_OSH_HUB_URL": {
    "type": "string",
    "default": "",
    "description": "URL used to dynamically generate worker configuration files."
  }
}
