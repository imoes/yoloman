{
  "var_dir": "/var/lib/mailman3",
  "log_dir": "/var/log/mailman3",
  "queue_dir": "/var/spool/mailman3",
  "lock_dir": "/run/lock/mailman3",
  "pickle_dir": "/var/lib/mailman3/pickle",
  "pid_file": "/run/mailman3/master.pid",
  "config_file": "/etc/mailman3/mailman.cfg",
  "default_language": "en",
  "outgoing_charset": "utf-8",
  "email_host": "lists.example.com",
  "web_host": "lists.example.com",
  "list_max_members": 10000,
  "max_message_size": 10485760,
  "subscription_policy": "confirm",
  "post_hold_policy": "moderate",
  "auto_subscribe": false,
  "require_subject": true,
  "footer_msg": "",
  "api_rate_limit": 100,
  "password_reset_timeout": 86400,
  "smtp_host": "localhost",
  "smtp_port": 587,
  "smtp_user": "",
  "smtp_pass": "",
  "smtp_use_tls": true
}
