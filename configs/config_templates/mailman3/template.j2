# Core mailman.cfg configuration for Mailman 3
# Path to the Mailman data directory
var_dir = {{ var_dir }}

# Path to the Mailman logs directory
log_dir = {{ log_dir }}

# Path to the Mailman queue directory
queue_dir = {{ queue_dir }}

# Path to the Mailman lock directory
lock_dir = {{ lock_dir }}

# Path to the Mailman pickle directory (for inter-process communication)
pickle_dir = {{ pickle_dir }}

# Path to the Mailman PID file
pid_file = {{ pid_file }}

# Path to the Mailman configuration file (used for self-reference)
config_file = {{ config_file }}

# Default language for new users and list messages
default_language = {{ default_language }}

# Default character set for outgoing messages
outgoing_charset = {{ outgoing_charset }}

# Default email address suffix for list addresses
email_host = {{ email_host }}

# Default URL hostname for web UI
web_host = {{ web_host }}

# Maximum number of members per list
list_max_members = {{ list_max_members }}

# Maximum message size (in bytes) accepted from posters
max_message_size = {{ max_message_size }}

# Whether to require approval for new list subscriptions
subscription_policy = {{ subscription_policy }}

# Whether to hold posts from non-members for approval
post_hold_policy = {{ post_hold_policy }}

# Whether to automatically subscribe poster's email if not already a member
auto_subscribe = {{ auto_subscribe }}

# Whether to reject messages without a subject line
require_subject = {{ require_subject }}

# Whether to append a footer to list messages
footer_msg = {{ footer_msg }}

# Maximum concurrent HTTP requests to the REST API per minute (for rate limiting)
api_rate_limit = {{ api_rate_limit }}

# Maximum age (in seconds) of a password reset token
password_reset_timeout = {{ password_reset_timeout }}

# SMTP server for outgoing mail
smtp_host = {{ smtp_host }}
smtp_port = {{ smtp_port }}
smtp_user = {{ smtp_user }}
smtp_pass = {{ smtp_pass }}
smtp_use_tls = {{ smtp_use_tls }}
smtp_use_ssl = {{ smtp_use_ssl }}
smtp_local_domain = {{ smtp_local_domain }}

# IMAP/POP server for incoming mail (optional, if using mail-in via IMAP/POP)
{% for backend in mail_in_backends %}
# Mail-in backend: {{ backend.name }}
[{{ backend.name }}]
# Hostname or IP of the IMAP/POP server
host = {{ backend.host }}
# Port (IMAP: 143/993, POP3: 110/995)
port = {{ backend.port }}
# Username template (supports {user}, {domain}, etc.)
user = {{ backend.user }}
# Password (preferably stored in a secret manager — use placeholder here)
password = {{ backend.password }}
# Use TLS?
use_tls = {{ backend.use_tls }}
# Use SSL?
use_ssl = {{ backend.use_ssl }}
{% endfor %}

# List of MTA (Mail Transfer Agent) backends (postfix, sendmail, etc.)
{% for mta in mta_backends %}
# MTA backend: {{ mta.name }}
[{{ mta.name }}]
# Path to the MTA command binary
path = {{ mta.path }}
# Extra arguments for the MTA command
args = {{ mta.args | join(' ') }}
{% endfor %}

# Database connection (default is SQLite; use PostgreSQL in production)
[database]
class = {{ db_class }}
# SQLite path (if using SQLite)
{% if db_class == 'mailman.database.sqlite.SQLiteDatabase' %}
url = sqlite:///{{ db_url }}
{% elif db_class == 'mailman.database.postgres.PostgresDatabase' %}
# PostgreSQL connection string (e.g., postgresql://user:pass@host/db)
url = {{ db_url }}
{% endif %}

# REST API configuration (Mailman Core’s HTTP interface)
[rest]
endpoint = http://{{ rest_endpoint }}
api_key = {{ rest_api_key }}

# MTA configuration (Mailman Core → MTA integration)
[mta]
incoming = {{ mta_incoming }}
outgoing = {{ mta_outgoing }}

# Logging configuration
[logging]
# Default log level: debug, info, warning, error, critical
default = {{ log_level }}
# Syslog facility (if syslog logging is used)
syslog_facility = {{ syslog_facility }}

# HTTP server for web UI (Hyperkitty integration)
[archiver.hyperkitty]
class = mailman_hyperkitty.Hyperkitty
enable = {{ hyperkitty_enable }}
endpoint = {{ hyperkitty_endpoint }}
api_key = {{ hyperkitty_api_key }}

# Archiver for list archives (e.g., mailman.archiver.mbox)
[archiver.mbox]
class = mailman.archiver.mbox.MaildirArchiver
enable = {{ mbox_archiver_enable }}
path = {{ mbox_archiver_path }}
{% if mbox_archiver_compress %}
compress = True
{% else %}
compress = False
{% endif %}

# Cookie and session settings (for web UI)
[web]
# Base URL for the web UI
base_url = http://{{ web_host }}
# Secret key for session signing
secret_key = {{ secret_key }}
# Whether to require SSL for cookies
secure_cookies = {{ secure_cookies }}
