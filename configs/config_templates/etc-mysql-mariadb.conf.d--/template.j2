[client]
# Default client connection settings
# Port to connect on (default: 3306)
port = {{ client_port }}
# Unix socket for local connections
socket = {{ client_socket }}
# Default character set for client-server communication
default-character-set = {{ client_default_character_set }}
{% if client_ssl_enabled %}
# Enable SSL for client connections
ssl = 1
# Path to SSL CA certificate file
ssl-ca = {{ client_ssl_ca }}
# Path to SSL certificate file
ssl-cert = {{ client_ssl_cert }}
# Path to SSL key file
ssl-key = {{ client_ssl_key }}
{% endif %}
{% if client_additional_options %}
# Additional client options (key=value pairs)
{% for option, value in client_additional_options.items() %}{{ option }} = {{ value }}{% endfor %}
{% endif %}

[mysql]
# Settings specific to the `mysql` command-line client
no-auto-rehash
# Enable pager for output (optional)
{% if mysql_pager_enabled %}pager = {{ mysql_pager }}{% endif %}
# Enable vertical output by default
{% if mysql_vertical_output_enabled %}vertical{% endif %}
