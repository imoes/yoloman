{
  "client_port": 3306,
  "client_socket": "/run/mysqld/mysqld.sock",
  "client_default_character_set": "utf8mb4",
  "client_ssl_enabled": false,
  "client_ssl_ca": "/etc/ssl/certs/ca-certificates.crt",
  "client_ssl_cert": "/etc/mysql/ssl/client-cert.pem",
  "client_ssl_key": "/etc/mysql/ssl/client-key.pem",
  "client_additional_options": {
    "connect_timeout": "30",
    "max_allowed_packet": "64M"
  },
  "mysql_pager_enabled": true,
  "mysql_pager": "less -n -i -r",
  "mysql_vertical_output_enabled": false
}
