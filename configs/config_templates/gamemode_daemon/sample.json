{
  "enabled": true,
  "governor": "performance",
  "max_cpus": 0,
  "allowlist": [
    "/usr/bin/",
    "/opt/games/"
  ],
  "denylist": [
    "/usr/lib/",
    "/usr/share/",
    "/snap/"
  ],
  "use_pstate": true,
  "enable_gpu_boost": true,
  "gpu_boost_freq": 1800,
  "idle_timeout": 15,
  "proc_priority": -10,
  "gpu_configs": [
    {
      "device_path": "/sys/class/drm/card0/device",
      "boost_freq": 1750,
      "pstate_mode": true
    },
    {
      "device_path": "/sys/class/drm/card1/device",
      "boost_freq": 0,
      "pstate_mode": false
    }
  ]
}
