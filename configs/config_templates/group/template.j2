# /etc/iproute2/group: Map group names to numeric group IDs for use with routing rules
# Format: GROUP_NAME GROUP_ID
# Each line defines a mapping from a human-readable group name to a numeric group ID
# Group names may contain letters, digits, underscores, and hyphens, but must start with a letter or underscore
# Group IDs are unsigned 32-bit integers (0–4294967295); use 0 for default/automatic assignment
{% for item in groups %}{{ item.name }} {{ item.id }}{% endfor %}