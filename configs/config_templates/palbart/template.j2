# ===========================================================================
# palbart configuration file
# ===========================================================================
#
# This file configures the palbart assembler, a tool for compiling PDP/8
# assembly source files (.pal) into binary formats (BIN or RIM).
# It is typically used by wrapper scripts or CI pipelines rather than
# being run directly by end-users.
#
# Each directive corresponds to a specific command-line flag for palbart.
# See the palbart(1) man page for detailed descriptions of these flags.
# ===========================================================================

# -------------------------------------------------------------------------
# Input Source File
# -------------------------------------------------------------------------
# Specifies the path to the PDP/8 assembly source file to be assembled.
# This can be a relative path (relative to the project root or working directory)
# or an absolute path.
# Corresponds to the implicit first argument or -i flag in some wrappers.
source_file = {{ source_file | default('main.pal') }}

# -------------------------------------------------------------------------
# Output Binary Format
# -------------------------------------------------------------------------
# Defines the format of the generated output binary file.
# - 'bin': DEC BIN format (standard binary). This is the default behavior.
# - 'rim': DEC RIM format (Relocatable Image Format).
# Corresponds to the -r flag: use '-r' if output_format is 'rim', otherwise omitted.
output_format = {{ output_format | default('bin') }}

# -------------------------------------------------------------------------
# Permanent Symbol Table
# -------------------------------------------------------------------------
# If true, instructs the assembler to generate a .prm file containing
# the permanent symbol table. This is useful for linking multiple object files.
# Corresponds to the -p flag.
perm_symtable = {{ perm_symtable | default(false) }}

# -------------------------------------------------------------------------
# Extended Features
# -------------------------------------------------------------------------
# If true, enables non-PAL8 compatible extended features such as the
# TITLE and BANK pseudo-operations. Use this if the source code relies
# on these extensions.
# Corresponds to the -a flag.
extended_features = {{ extended_features | default(false) }}

# -------------------------------------------------------------------------
# Show Symbol Table
# -------------------------------------------------------------------------
# If true, causes the assembler to display the symbol table at the end
# of the assembly listing output. Useful for debugging symbol resolution.
# Corresponds to the -d flag.
show_symtable = {{ show_symtable | default(false) }}

# -------------------------------------------------------------------------
# Strict Linking
# -------------------------------------------------------------------------
# If true, generates an error if the assembler detects that link
# instructions (such as those generated by certain pseudo-ops) would
# be created in the output. Enforces stricter adherence to single-file
# assembly constraints.
# Corresponds to the -e flag.
strict_links = {{ strict_links | default(false) }}

# -------------------------------------------------------------------------
# Allow Links and Literals
# -------------------------------------------------------------------------
# If true (default), allows the generation of links and literals within
# the assembled code. If false, these are prohibited.
# Corresponds to the -l flag (active when true).
allow_links = {{ allow_links | default(true) }}

# -------------------------------------------------------------------------
# No Redefinition of Permanent Symbols
# -------------------------------------------------------------------------
# If true, prevents the redefinition of permanent symbols. This ensures
# that once a symbol is defined as permanent, it cannot be overwritten,
# which helps catch namespace collisions.
# Corresponds to the -n flag.
no_redef_perm = {{ no_redef_perm | default(false) }}

# -------------------------------------------------------------------------
# No End-of-File Dollar Sign Requirement
# -------------------------------------------------------------------------
# If true, the assembler will not require a '$' character at the end
# of the source file to mark the end of the program. Some older PAL8
# conventions required this; disabling the check allows for more flexible
# source files.
# Corresponds to the -$ flag.
no_end_dollar = {{ no_end_dollar | default(false) }}

# -------------------------------------------------------------------------
# Cross-Reference Generation
# -------------------------------------------------------------------------
# If true, generates a cross-reference listing (concordance) of all
# user-defined symbols. This maps symbol names to their addresses
# and usage locations, aiding in reverse engineering or code analysis.
# Corresponds to the -x flag.
gen_crossref = {{ gen_crossref | default(false) }}

# -------------------------------------------------------------------------
# Tab Stops
# -------------------------------------------------------------------------
# Sets the column width for tab stops in the assembly listing output.
# Determines how tabs are expanded in the printed/assembled listing.
# Corresponds to the -t N flag.
tab_stops = {{ tab_stops | default(8) }}