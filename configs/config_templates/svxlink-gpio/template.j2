###############################################################################
#
# Configuration file for the SvxLink server GPIO Pins
#
# This configuration defines the GPIO pins and access permissions for SvxLink
# to interact with hardware buttons, LEDs, and keyers on various single-board
# computers (Raspberry Pi, Orange Pi, etc.).
#
# Self-documenting: Every variable reference below includes its default value
# as specified in the schema, ensuring the template is safe to reuse even if
# the variable is not explicitly passed from Ansible.
#
###############################################################################

# GPIO system pin path.
# Typical values: /sys/class/gpio (RPi/odroid/nanopi/pine64) or /sys/class/gpio_sw (Orange Pi).
# The service uses this base path to locate GPIO device nodes.
GPIO_PATH={{ gpio_path | default('/sys/class/gpio') }}

# Space separated list of GPIO pins that point IN and have an Active HIGH state.
# (3.3v = ON, 0v = OFF). Use this for buttons that pull the line high when pressed.
# Example: "17 27"
GPIO_IN_HIGH="{{ gpio_in_high | default('') }}"

# Space separated list of GPIO pins that point IN and have an Active LOW state.
# (0v = ON, 3.3v = OFF). Use this for buttons that pull the line low (ground) when pressed.
# Example: "2 3"
GPIO_IN_LOW="{{ gpio_in_low | default('') }}"

# Space separated list of GPIO pins that point OUT and have an Active HIGH state.
# (3.3v = ON, 0v = OFF). Use this for LEDs or relays that activate on high voltage.
# Example: "4 5"
GPIO_OUT_HIGH="{{ gpio_out_high | default('') }}"

# Space separated list of GPIO pins that point OUT and have an Active LOW state.
# (0v = ON, 3.3v = OFF). Use this for LEDs or relays that activate on ground/low voltage.
# Example: "12 13"
GPIO_OUT_LOW="{{ gpio_out_low | default('') }}"

# User that should own the GPIO device files.
# This user must have permission to access /sys/class/gpio exports.
GPIO_USER="{{ gpio_user | default('svxlink') }}"

# Group for the GPIO device files.
# Members of this group will also be able to access the GPIO pins.
GPIO_GROUP="{{ gpio_group | default('svxlink') }}"

# File access mode for the GPIO device files.
# Standard octal permission string. 0664 allows owner read/write, group read.
GPIO_MODE="{{ gpio_mode | default('0664') }}"
