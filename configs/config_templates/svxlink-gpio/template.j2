###############################################################################
#
# SvxLink GPIO Configuration Template
#
# This template configures the GPIO interface for SvxLink. It controls which
# GPIO pins are monitored (inputs) and which are controlled (outputs), along
# with their electrical characteristics (active high/low) and file system
# permissions for the device nodes.
#
# Self-Documenting: Every variable reference includes a safe default to
# prevent render errors and provide sensible fallbacks. Comments above each
# directive reflect the schema description.
#
###############################################################################

# GPIO system pin path.
# RPi/odroid/nanopi/pine64 = /sys/class/gpio, orangpi = /sys/class/gpio_sw
GPIO_PATH={{ gpio_path | default('/sys/class/gpio') }}

# Space separated list of GPIO pins that point IN and have an Active HIGH state (3.3v = ON, 0v = OFF).
# Example: "2 3 4"
GPIO_IN_HIGH="{{ gpio_in_high | default('') }}"

# Space separated list of GPIO pins that point IN and have an Active LOW state (0v = ON, 3.3v = OFF).
# Example: "17 27"
GPIO_IN_LOW="{{ gpio_in_low | default('') }}"

# Space separated list of GPIO pins that point OUT and have an Active HIGH state (3.3v = ON, 0v = OFF).
# Example: "22 23"
GPIO_OUT_HIGH="{{ gpio_out_high | default('') }}"

# Space separated list of GPIO pins that point OUT and have an Active LOW state (0v = ON, 3.3v = OFF).
# Example: "18 19"
GPIO_OUT_LOW="{{ gpio_out_low | default('') }}"

# User that should own the GPIO device files.
# Typically the service user running SvxLink.
GPIO_USER="{{ gpio_user | default('svxlink') }}"

# Group for the GPIO device files.
# Allows group members to access GPIO nodes.
GPIO_GROUP="{{ gpio_group | default('svxlink') }}"

# File access mode for the GPIO device files.
# Octal permission string (e.g. '0664' allows read/write for user/group).
GPIO_MODE="{{ gpio_mode | default('0664') }}"