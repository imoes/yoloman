# apt-config-auto-update: Configuration for automatic APT package updates
# This template configures the frequency of periodic tasks managed by
# `apt-listchanges` or the systemd timer `apt-daily.timer` / `apt-daily-upgrade.timer`.
# See `man 5 apt.conf` for details on APT::Periodic directives.

# APT::Periodic::Update-Package-Lists
# Frequency (in days) to run apt-get update. 0 disables it.
APT::Periodic::Update-Package-Lists "{{ update_package_lists | default('1') }}";

# APT::Periodic::Download-Upgradeable-Packages
# Frequency (in days) to download upgradeable packages. 0 disables it.
APT::Periodic::Download-Upgradeable-Packages "{{ download_upgradeable_packages | default('1') }}";

# APT::Periodic::AutocleanInterval
# Frequency (in days) to run apt-get autoclean. 0 disables it.
APT::Periodic::AutocleanInterval "{{ autoclean_interval | default('0') }}";
