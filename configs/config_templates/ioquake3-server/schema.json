{
  "profile_name": {
    "type": "string",
    "default": "ioq3ded",
    "description": "The name of the AppArmor profile."
  },
  "binary_path": {
    "type": "string",
    "default": "/usr/lib/ioquake3/ioq3ded",
    "description": "The path to the ioquake3 server binary."
  },
  "etcdirs": {
    "type": "string",
    "default": "{openarena,quake3}-server",
    "description": "Directory patterns for /etc configuration paths."
  },
  "libdirs": {
    "type": "string",
    "default": "{ioquake3,quake3,openarena,openarena-server}",
    "description": "Directory patterns for /usr/lib paths containing binaries/libraries."
  },
  "share_dirs": {
    "type": "string",
    "default": "{quake3*,openarena}",
    "description": "Directory patterns for /usr/share/games paths."
  },
  "home_dirs": {
    "type": "string",
    "default": "{openarena,q3a}",
    "description": "Directory patterns for user home directories containing game data."
  },
  "var_dirs": {
    "type": "string",
    "default": "{openarena,quake3}-server",
    "description": "Directory patterns for /var/games paths."
  }
}
