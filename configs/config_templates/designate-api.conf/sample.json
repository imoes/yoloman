{
  "log_level": "INFO",
  "bind_host": "0.0.0.0",
  "bind_port": 9001,
  "max_request_body_size": 1048576,
  "policy_file": "/etc/designate/policy.json",
  "keystone_auth_uri": "https://identity.example.com:5000",
  "project_domain_name": "Default",
  "user_domain_name": "Default",
  "project_name": "service",
  "username": "designate",
  "password": "designate_secret_password",
  "keystone_auth_url": "https://identity.example.com:35357",
  "memcached_servers": [
    "10.0.0.10:11211",
    "10.0.0.11:11211"
  ],
  "keystone_insecure": false,
  "keystone_cafile": "/etc/ssl/certs/designate-ca.pem",
  "api_workers": 4,
  "enable_api_v2": true,
  "enable_api_v1": false,
  "auth_strategy": "keystone",
  "endpoints": [
    {
      "name": "admin",
      "enabled": true,
      "host": "127.0.0.1",
      "port": 9002,
      "tls_enabled": false
    }
  ]
}
