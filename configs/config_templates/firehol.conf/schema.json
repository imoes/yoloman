{
  "default_policy_in": {
    "type": "string",
    "default": "drop",
    "description": "Default policy for incoming traffic: 'drop', 'reject', or 'drop with log'.",
    "enum": [
      "drop",
      "reject"
    ]
  },
  "default_policy_out": {
    "type": "string",
    "default": "accept",
    "description": "Default policy for outgoing traffic: 'accept' or 'drop'."
  },
  "interfaces": {
    "type": "list",
    "default": [
      {
        "name": "eth0",
        "direction": "inout",
        "mode": "router",
        "policy": "client",
        "routed": true,
        "dns": true,
        "https": true,
        "http": true,
        "services": [
          {
            "name": "ssh",
            "action": "accept"
          },
          {
            "name": "http",
            "action": "accept"
          },
          {
            "name": "https",
            "action": "accept"
          }
        ]
      }
    ],
    "items": {
      "name": {
        "type": "string",
        "default": "",
        "description": "Interface name (e.g., eth0, lan)."
      },
      "direction": {
        "type": "string",
        "default": "inout",
        "description": "Traffic direction: 'in', 'out', or 'inout'."
      },
      "comment": {
        "type": "string",
        "default": "",
        "description": "Optional human-readable description of this interface rule."
      },
      "mode": {
        "type": "string",
        "default": "router",
        "description": "FireHOL mode: 'router', 'transparent', 'standalone', 'client', or 'server'."
      },
      "policy": {
        "type": "string",
        "default": "client",
        "description": "FireHOL policy: 'client' (allow established outbound) or 'server' (allow inbound only if explicitly defined)."
      },
      "routed": {
        "type": "bool",
        "default": true,
        "description": "Allow routed traffic through this interface?"
      },
      "dns": {
        "type": "bool",
        "default": true,
        "description": "Allow DNS queries through this interface?"
      },
      "http": {
        "type": "bool",
        "default": false,
        "description": "Allow HTTP (port 80) inbound on this interface?"
      },
      "https": {
        "type": "bool",
        "default": false,
        "description": "Allow HTTPS (port 443) inbound on this interface?"
      },
      "services": {
        "type": "list",
        "default": [],
        "description": "List of custom or built-in services to allow/deny.",
        "items": {
          "name": {
            "type": "string",
            "default": "",
            "description": "Service name (e.g., ssh, http, ftp, or a custom name defined under 'services')."
          },
          "action": {
            "type": "string",
            "default": "accept",
            "description": "Action: 'accept' or 'drop'."
          }
        }
      }
    }
  },
  "services": {
    "type": "list",
    "default": [],
    "description": "List of custom server/service definitions (used when built-in service names are insufficient).",
    "items": {
      "name": {
        "type": "string",
        "default": "",
        "description": "Unique service identifier (e.g., custom-web)."
      },
      "protocol": {
        "type": "string",
        "default": "tcp",
        "description": "Protocol: 'tcp' or 'udp'."
      },
      "ports": {
        "type": "list",
        "default": [],
        "description": "List of port numbers or ranges (e.g., ['8080', '9000-9100']).",
        "items": {
          "type": "string"
        }
      },
      "src": {
        "type": "string",
        "default": "any",
        "description": "Source restriction: 'any' or CIDR (e.g., '192.168.1.0/24')."
      },
      "comment": {
        "type": "string",
        "default": "",
        "description": "Optional description for this service rule."
      }
    }
  },
  "ipsets": {
    "type": "list",
    "default": [],
    "description": "IP sets for efficient IP or network blocking/allowing.",
    "items": {
      "name": {
        "type": "string",
        "default": "",
        "description": "Name of the IP set (must be alphanumeric and underscores only)."
      },
      "type": {
        "type": "string",
        "default": "hash:ip",
        "description": "IP set type: 'hash:ip', 'hash:net', 'hash:ip,port', etc."
      },
      "comment": {
        "type": "string",
        "default": "",
        "description": "Optional description."
      },
      "entries": {
        "type": "list",
        "default": [],
        "description": "IPs or networks to add to the set (e.g., ['10.0.0.1', '192.168.1.0/24']).",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "log_level": {
    "type": "string",
    "default": "info",
    "description": "Logging verbosity: 'quiet', 'info', 'medium', 'full'."
  },
  "ip_forward": {
    "type": "bool",
    "default": false,
    "description": "Enable system IP packet forwarding (required for router/gateway roles)."
  },
  "extra_lines": {
    "type": "list",
    "default": [],
    "description": "List of raw FireHOL directives to append literally (e.g., 'drop_established', 'client_mode').",
    "items": {
      "type": "string"
    }
  }
}
