# FireHOL - IPv4 stateful packet filter for Linux
# Defines interface rules, allowed services, and security policies

# Global: Default policy for incoming traffic: 'drop', 'reject', or 'drop with log'.
# Default: drop
# Note: 'start client' sets the default client mode (incoming to local machine).
# The specific default policy is configured below.
start client

# Global: Default policy for outgoing traffic: 'accept' or 'drop'.
# Default: accept
# Note: 'start server' sets the default server mode (incoming to local services).
# The specific default policy is configured below.
start server accept

# Global: Logging verbosity: 'quiet', 'info', 'medium', 'full'.
# Default: info
log_level {{ log_level | default('info') }}

# Global: Enable system IP packet forwarding (required for router/gateway roles).
# Default: false
ip_forward {{ 'yes' if (ip_forward | default(False)) else 'no' }}

# Global: Advanced rules - explicit service definitions
# Default: [] (empty list)
{% for svc in (services | default([], true)) %}
# Custom service: {{ svc.name | default('unnamed') }}
# Protocol: {{ svc.protocol | default('tcp') }}, Ports: {{ svc.ports | default([]) | join(', ') }}
{% if svc.comment | default(None) is not none and svc.comment %}# Comment: {{ svc.comment }}
{% endif %}
start
server {{ svc.name | default('unnamed') }} accept src {{ svc.src | default('any') }} port {{ svc.ports | default([]) | join(', ') }} proto {{ svc.protocol | default('tcp') }}

{% endfor %}

# Global: Advanced rules - IP sets for efficient IP or network blocking/allowing.
# Default: [] (empty list)
{% for ipset in (ipsets | default([], true)) %}
# IP set: {{ ipset.name | default('unnamed') }}
# Type: {{ ipset.type | default('hash:ip') }}
{% if ipset.comment | default(None) is not none and ipset.comment %}# Comment: {{ ipset.comment }}
{% endif %}
start
ipset --type {{ ipset.type | default('hash:ip') }} {{ ipset.name | default('unnamed') }}
{% for entry in (ipset.entries | default([], true)) %}
ipset add {{ ipset.name | default('unnamed') }} {{ entry }}
{% endfor %}

{% endfor %}

# Global: Advanced rules - Additional raw FireHOL directives.
# Default: [] (empty list)
{% for line in (extra_lines | default([], true)) %}
# {{ line }}
{% endfor %}
{% for line in (extra_lines | default([], true)) %}
{{ line }}
{% endfor %}

# Global: Advanced rules - Interfaces configuration.
# Default: [{'name': 'eth0', 'direction': 'inout', 'mode': 'router', 'policy': 'client', 'routed': True, 'dns': True, 'https': True, 'http': True, 'services': [{'name': 'ssh', 'action': 'accept'}, {'name': 'http', 'action': 'accept'}, {'name': 'https', 'action': 'accept'}]}]
{% for iface in (interfaces | default([{'name': 'eth0', 'direction': 'inout', 'mode': 'router', 'policy': 'client', 'routed': True, 'dns': True, 'https': True, 'http': True, 'services': [{'name': 'ssh', 'action': 'accept'}, {'name': 'http', 'action': 'accept'}, {'name': 'https', 'action': 'accept'}]}], true)) %}
# Interface: {{ iface.name | default('eth0') }}
# Traffic direction: {{ iface.direction | default('inout') }}
{% if iface.comment | default(None) is not none and iface.comment %}# Comment: {{ iface.comment }}
{% endif %}
start
interface {{ iface.direction | default('inout') }} {{ iface.name | default('eth0') }} {
{% if iface.mode | default(None) is not none %}
  mode "{{ iface.mode | default('router') }}"
{% endif %}
{% if iface.policy | default(None) is not none %}
  policy {{ iface.policy | default('client') }}
{% endif %}
{% if iface.routed | default(None) is not none %}
  routed {{ 'yes' if (iface.routed | default(True)) else 'no' }}
{% endif %}
{% if iface.dns | default(None) is not none and (iface.dns | default(True)) %}
  dns accept
{% endif %}
{% if iface.https | default(None) is not none and (iface.https | default(True)) %}
  https accept
{% endif %}
{% if iface.http | default(None) is not none and (iface.http | default(True)) %}
  http accept
{% endif %}
{% for service in (iface.services | default([], true)) %}
  service {{ service.name | default('') }} {{ service.action | default('accept') }}
{% endfor %}
}

{% endfor %}