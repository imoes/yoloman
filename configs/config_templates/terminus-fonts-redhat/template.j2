<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "/usr/share/xml/fontconfig/fonts.dtd">
<!--
  Fontconfig configuration for Terminus fonts (Red Hat package).
  This template generates a font alias file that makes the 'monospace'
  font family resolve to the Terminus font family.
-->
<fontconfig>
  <!--
    Alias definition: 'monospace'
    Makes the generic 'monospace' font family prefer the Terminus font.
    Schema field: terminus_font_family
    Default: 'Terminus'
  -->
  <alias>
    <family>monospace</family>
    <prefer>
      <family>{{ terminus_font_family | default('Terminus') }}</family>
    </prefer>
  </alias>

  <!--
    Alias definition: 'Terminus'
    Sets 'monospace' as the default fallback for the Terminus font family.
    Schema field: terminus_font_family
    Default: 'Terminus'
  -->
  <alias>
    <family>{{ terminus_font_family | default('Terminus') }}</family>
    <default>
      <family>monospace</family>
    </default>
  </alias>
</fontconfig>
