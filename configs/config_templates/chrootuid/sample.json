{
  "entries": [
    {
      "name": "example daemon",
      "newroot": "/chroot/example",
      "newuser": "nobody",
      "interactive": false,
      "command": [
        "/usr/bin/example-daemon",
        "--foreground"
      ]
    },
    {
      "name": "debug session",
      "newroot": "/chroot/debug",
      "newuser": "root",
      "interactive": true,
      "command": [
        "/bin/sh",
        "-l"
      ]
    }
  ]
}
