# =============================================================================
# Configuration file for pqconnect (Post-Quantum Internet security layer)
# Managed by configuration management. Do not edit manually.
# =============================================================================
#
# Self-documenting template: every directive is preceded by its schema description.
# All variables use explicit defaults to prevent render failures.
#
# =============================================================================
# addr: Local IPv4 address to bind the UDP socket.
# =============================================================================
# The address the service listens on. '0.0.0.0' binds to all available interfaces.
ADDR={{ addr | default('0.0.0.0') }}

# =============================================================================
# port: UDP listening port for the PQConnect service (0-65535).
# =============================================================================
# The UDP port number for incoming PQConnect traffic.
PORT={{ port | default(9000) }}

# =============================================================================
# mask: Netmask for the private network in CIDR notation (8-24).
# =============================================================================
# CIDR prefix length defining the size of the private tunnel network.
MASK={{ mask | default(16) }}

# =============================================================================
# interface_name: Name of the network interface for the PQConnect tunnel.
# =============================================================================
# The name assigned to the virtual network interface created for the tunnel.
INTERFACE={{ interface_name | default('pqconnect0') }}

# =============================================================================
# host_ip: IP address where decrypted traffic should arrive. Leave empty if not required.
# =============================================================================
# Destination IP for decrypted payloads. Empty string means traffic stays local.
HOST_IP={{ host_ip | default('') }}

# =============================================================================
# verbose: Enable verbose logging.
# =============================================================================
# Boolean flag to increase log detail level.
VERBOSE={{ verbose | default(false) | lower }}

# =============================================================================
# very_verbose: Enable very verbose logging.
# =============================================================================
# Boolean flag to enable debug-level logging (overrides verbose if true).
VERY_VERBOSE={{ very_verbose | default(false) | lower }}