# ============================================================================
# ZCHUNK CONFIGURATION HEADER (C Preprocessor)
# ============================================================================
# Generated by Ansible Jinja2 template for libczmq/zchunk tuning.
# This file defines compile-time constants and macros for the zchunk class
# within the CZMQ library. It is NOT a standalone daemon configuration.
#
# Variables used:
#   zchunk_max_size: int, max chunk size in bytes (0=dynamic/heap-limited)
#   zchunk_default_init_size: int, initial allocation size for new chunks
#   zchunk_draft_enabled: bool, enable draft API methods
#   zchunk_debug_options: list of dicts with 'name' and 'value' keys
# ============================================================================

#ifndef ZCHUNK_CONFIG_H
#define ZCHUNK_CONFIG_H

// ---------------------------------------------------------------------------
// Field: zchunk_max_size
// Default: 0
// Description: Maximum size in bytes for a zchunk. If 0, size is dynamic
//              limited only by heap. Corresponds to zchunk_resize/max_size
//              logic.
// ---------------------------------------------------------------------------
#define ZCHUNK_MAX_SIZE {{ (zchunk_max_size | default(0)) | int }}

// ---------------------------------------------------------------------------
// Field: zchunk_default_init_size
// Default: 1024
// Description: Initial allocation size for empty chunks created with
//              zchunk_new(NULL, size). Corresponds to zchunk_new.
// ---------------------------------------------------------------------------
#define ZCHUNK_DEFAULT_INIT_SIZE {{ (zchunk_default_init_size | default(1024)) | int }}

// ---------------------------------------------------------------------------
// Field: zchunk_draft_enabled
// Default: False
// Description: Whether to enable draft methods like zchunk_frommem and
//              zchunk_packx. Corresponds to CZMQ_BUILD_DRAFT_API.
// ---------------------------------------------------------------------------
// Render as 1 for true, 0 for false to match C boolean convention
#define CZMQ_DRAFT_ENABLED {{ zchunk_draft_enabled | default(false) | ternary(1, 0) }}

// ---------------------------------------------------------------------------
// Field: ZCHUNK_HEX_PREFIX (Static)
// Description: Hex encoding prefix for debugging/dump output. Documented
//              via zchunk_strhex. Used in application code to format chunk
//              dumps. This value is static in this template.
// ---------------------------------------------------------------------------
#define ZCHUNK_HEX_PREFIX "0x"

// ---------------------------------------------------------------------------
// Field: zchunk_debug_options
// Default: None (empty list)
// Description: List of debug/dumping configuration flags used in application
//              code interacting with zchunk. Rendered as individual #define
//              macros. Iterates over a list of mappings containing 'name'
//              and 'value'.
// ---------------------------------------------------------------------------
{% if zchunk_debug_options is defined and zchunk_debug_options %}
{% for item in zchunk_debug_options %}
// {{ item.description | default('Debug flag: ' ~ item.name) }}
#define ZCHUNK_{{ item.name | upper }} {{ item.value }}

{% endfor %}
{% endif %}

#endif /* ZCHUNK_CONFIG_H */