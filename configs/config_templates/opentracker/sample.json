{
  "listen_ipv4": "0.0.0.0:6969",
  "listen_ipv6": "[::]:6969",
  "bind_address": "",
  "max_connections_per_ip": 100,
  "max_peers_per_torrent": 50,
  "data_dir": "/var/lib/opentracker",
  "acl_file": "",
  "announce_interval": 1800,
  "min_announce_interval": 1200,
  "scramble_peers": true,
  "compact_list": true,
  "partial_peers": false,
  "scrape_enabled": true,
  "ssl_enabled": false,
  "ssl_cert": "",
  "ssl_key": "",
  "log_level": 2,
  "log_file": "/var/log/opentracker/opentracker.log",
  "allowed_announce_urls": [
    "https://example-tracker.example.com/announce"
  ],
  "announce_rate_limit": 2
}
