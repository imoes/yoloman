{
  "consoles": [
    {
      "name": "server1-console",
      "host": "console.example.com",
      "port": 23,
      "protocol": "telnet",
      "baud": 9600,
      "log": true
    },
    {
      "name": "router1-console",
      "host": "192.168.1.5",
      "port": 22,
      "protocol": "ssh",
      "username": "admin",
      "password": "secret123"
    },
    {
      "name": "local-serial",
      "host": "localhost",
      "port": 0,
      "protocol": "direct",
      "args": "/dev/ttyS0"
    }
  ],
  "defaults": {
    "timeout": 30,
    "rshpath": "/usr/bin/rsh",
    "sshpath": "/usr/bin/ssh",
    "maxlogdays": 7
  }
}
