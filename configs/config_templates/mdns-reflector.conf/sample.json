{
  "interface": "eth0",
  "record_ttl": 120,
  "max_cache_size": 1000,
  "reflect_ptr": true,
  "reflect_a_aaaa": true,
  "forward_domains": [
    "local"
  ],
  "suppress_domains": [
    "internal.local"
  ],
  "rate_limit_qps": 10,
  "max_qps": 100,
  "log_level": "info",
  "log_file": "/var/log/mdns-reflector.log"
}
