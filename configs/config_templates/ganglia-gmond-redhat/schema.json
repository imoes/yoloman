{
  "user": {
    "type": "string",
    "default": "ganglia",
    "description": "The user account under which the gmond daemon runs."
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Debug level for gmond output."
  },
  "max_udp_msg_len": {
    "type": "number",
    "default": 1472,
    "description": "Maximum UDP message length."
  },
  "mute": {
    "type": "string",
    "default": "no",
    "description": "Whether to mute metrics."
  },
  "deaf": {
    "type": "string",
    "default": "no",
    "description": "Whether to deaf metrics."
  },
  "allow_extra_data": {
    "type": "string",
    "default": "yes",
    "description": "Whether to allow extra data in messages."
  },
  "host_dmax": {
    "type": "number",
    "default": 86400,
    "description": "Host expiration time in seconds."
  },
  "host_tmax": {
    "type": "number",
    "default": 20,
    "description": "Host timeout in seconds."
  },
  "cleanup_threshold": {
    "type": "number",
    "default": 300,
    "description": "Cleanup threshold in seconds."
  },
  "gexec": {
    "type": "string",
    "default": "no",
    "description": "Whether to enable gexec."
  },
  "send_metadata_interval": {
    "type": "number",
    "default": 0,
    "description": "Interval for sending metadata in seconds."
  },
  "cluster_name": {
    "type": "string",
    "default": "unspecified",
    "description": "Name of the cluster."
  },
  "cluster_owner": {
    "type": "string",
    "default": "unspecified",
    "description": "Owner of the cluster."
  },
  "cluster_latlong": {
    "type": "string",
    "default": "unspecified",
    "description": "Latitude and longitude of the cluster."
  },
  "cluster_url": {
    "type": "string",
    "default": "unspecified",
    "description": "URL of the cluster."
  },
  "host_location": {
    "type": "string",
    "default": "unspecified",
    "description": "Location of the host."
  },
  "mcast_join_send": {
    "type": "string",
    "default": "239.2.11.71",
    "description": "Multicast join address for sending UDP metrics."
  },
  "port_send": {
    "type": "number",
    "default": 8649,
    "description": "Port for sending UDP metrics."
  },
  "ttl_send": {
    "type": "number",
    "default": 1,
    "description": "Time to live for sending UDP metrics."
  },
  "mcast_join_recv": {
    "type": "string",
    "default": "239.2.11.71",
    "description": "Multicast join address for receiving UDP metrics."
  },
  "port_recv": {
    "type": "number",
    "default": 8649,
    "description": "Port for receiving UDP metrics."
  },
  "bind_recv": {
    "type": "string",
    "default": "239.2.11.71",
    "description": "Bind address for receiving UDP metrics."
  },
  "retry_bind": {
    "type": "string",
    "default": "true",
    "description": "Whether to retry binding for receiving UDP metrics."
  },
  "port_accept": {
    "type": "number",
    "default": 8649,
    "description": "Port for accepting TCP connections."
  },
  "gzip_output": {
    "type": "string",
    "default": "no",
    "description": "Whether to gzip XML output."
  }
}
