# logtools configuration
# This file defines default domain suffixes and country codes used by the logtools package.
# Format: <level>:<value>
# Level 2 entries are domain suffixes.
# Level 3 entries are country codes.

# Default first domain suffix
2:{{ default_domain_suffix | default('com') }}

# Default second domain suffix
2:{{ default_domain_suffix_2 | default('net') }}

# Default third domain suffix
2:{{ default_domain_suffix_3 | default('org') }}

# Default fourth domain suffix
2:{{ default_domain_suffix_4 | default('nl') }}

# Default country code
3:{{ default_country_code | default('au') }}

# Default second country code
3:{{ default_country_code_2 | default('uk') }}