# Logtools configuration template
# This file contains default domain and country suffixes used for log parsing or categorization.
# Each line is prefixed with a numeric tag indicating its category:
# 2 = Domain Suffixes
# 3 = Country Codes

# Default first domain suffix
# Schema: default_domain_suffix (string, default='com')
2:{{ (default_domain_suffix | default('com')) | string }}

# Default second domain suffix
# Schema: default_domain_suffix_2 (string, default='net')
2:{{ (default_domain_suffix_2 | default('net')) | string }}

# Default third domain suffix
# Schema: default_domain_suffix_3 (string, default='org')
2:{{ (default_domain_suffix_3 | default('org')) | string }}

# Default fourth domain suffix
# Schema: default_domain_suffix_4 (string, default='nl')
2:{{ (default_domain_suffix_4 | default('nl')) | string }}

# Default country code
# Schema: default_country_code (string, default='au')
3:{{ (default_country_code | default('au')) | string }}

# Default second country code
# Schema: default_country_code_2 (string, default='uk')
3:{{ (default_country_code_2 | default('uk')) | string }}
