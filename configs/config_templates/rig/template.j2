# /etc/rig.conf
# Configuration for RIG (Random Identity Generator)
# See rig(6) for details.

# Path to the directory containing RIG's index data files (locdata.idx, street.idx, etc.).
# Defaults to /usr/share/rig if not specified.
data_dir = {{ data_dir | default('/usr/share/rig') }}

# The number of random identities to generate in a single run.
# Defaults to 1.
identity_count = {{ identity_count | default(1) }}

# Gender constraint for generated names: 'male', 'female', or 'both'.
# If 'both', names are mixed randomly. 'male' restricts to male names,
# 'female' restricts to female names.
gender = {{ gender | default('both') }}

# Output format: 'plain' (whitespace separated), 'csv', or 'json'.
# Determines the delimiter and structure of the output.
output_format = {{ output_format | default('plain') }}