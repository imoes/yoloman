# Main configuration file for Nagios Core

# Paths and binaries
nagios_user={{ nagios_user }}
nagios_group={{ nagios_group }}
nagios_binary={{ nagios_binary }}

# Paths to various components
nagios_cfg_file={{ nagios_cfg_file }}
resource_file={{ resource_file }}
status_file={{ status_file }}
queue_file={{ queue_file }}

# Log and archive paths
log_file={{ log_file }}
log_archive_path={{ log_archive_path }}

# Configuration file directories
cfg_dir={{ cfg_dir | join('\ncfg_dir=') | trim }}

# Temp and lock files
temp_file={{ temp_file }}
temp_path={{ temp_path }}
lock_file={{ lock_file }}

# External command options
check_external_commands={{ check_external_commands }}
command_check_interval={{ command_check_interval }}
command_file={{ command_file }}

# Time options
default_contactgroup_members={{ default_contactgroup_members | join(',') }}
default_host_notification_period={{ default_host_notification_period }}
default_service_notification_period={{ default_service_notification_period }}

# Notification options
notification_timeout={{ notification_timeout }}

# Event handler options
enable_event_handlers={{ enable_event_handlers }}

# Logging options
log_rotation_method={{ log_rotation_method }}
log_archive_path={{ log_archive_path }}
log_level={{ log_level }}

# Performance data options
process_performance_data={{ process_performance_data }}

# Notification options
deprecated_options={{ deprecated_options }}

# System options
check_for_updates={{ check_for_updates }}
bare_update_check={{ bare_update_check }}

# Low-level tuning
max_debug_file_size={{ max_debug_file_size }}

# Object caching
object_cache_file={{ object_cache_file }}
precached_object_file={{ precached_object_file }}

# Retention file
retention_file={{ retention_file }}

# Sleep time
sleep_time={{ sleep_time }}

# Service/Host check options
service_check_timeout={{ service_check_timeout }}
host_check_timeout={{ host_check_timeout }}

# Notification options
notification_interval={{ notification_interval }}

# Stale service/host checks
stale_service_checks={{ stale_service_checks }}
stale_host_checks={{ stale_host_checks }}

# Passive checks options
passive_service_checks_default={{ passive_service_checks_default }}
passive_host_checks_default={{ passive_host_checks_default }}

# Event broker modules (loaded as list)
{% for module in event_broker_modules %}broker_module={{ module }}{% endfor %}

# Logging options for daemon
daemon_dumps_core={{ daemon_dumps_core }}

# Stats log
stats_log_file={{ stats_log_file }}
stats_availability_days={{ stats_availability_days }}

# Logging options
use_syslog={{ use_syslog }}
log_notifications={{ log_notifications }}
log_service_retries={{ log_service_retries }}
log_host_retries={{ log_host_retries }}
log_event_handlers={{ log_event_handlers }}
log_external_commands={{ log_external_commands }}
log_passive_checks={{ log_passive_checks }}
sleep_time={{ sleep_time }}
