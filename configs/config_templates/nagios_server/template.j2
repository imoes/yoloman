# ==============================================================================
# Main configuration file for Nagios Core
# Generated by Ansible from schema 'nagios_server'
# ==============================================================================

# --- Paths and binaries ---
# nagios_user: User account under which Nagios runs.
nagios_user={{ nagios_user | default('nagios') }}

# nagios_group: Group under which Nagios runs.
nagios_group={{ nagios_group | default('nagios') }}

# nagios_binary: Full path to the Nagios binary.
nagios_binary={{ nagios_binary | default('/usr/sbin/nagios') }}

# --- Paths to various components ---
# nagios_cfg_file: Main Nagios configuration file (usually self-referential).
nagios_cfg_file={{ nagios_cfg_file | default('/etc/nagios4/nagios.cfg') }}

# resource_file: Path to the resource file containing macro definitions.
resource_file={{ resource_file | default('/etc/nagios4/resource.cfg') }}

# status_file: Path to the file storing runtime status data.
status_file={{ status_file | default('/var/log/nagios4/status.dat') }}

# queue_file: Path to the command queue file.
queue_file={{ queue_file | default('/var/spool/nagios4/nagios.qh') }}

# --- Log and archive paths ---
# log_file: Path to the main Nagios log file.
log_file={{ log_file | default('/var/log/nagios4/nagios.log') }}

# log_archive_path: Directory where old log files are archived.
log_archive_path={{ log_archive_path | default('/var/log/nagios4/archives') }}

# --- Configuration file directories ---
# cfg_dir: List of directories containing object configuration files.
{% for d in (cfg_dir | default(['/etc/nagios4/objects'])) %}cfg_dir={{ d }}
{% endfor %}

# --- Temp and lock files ---
# temp_file: Temporary file used during status updates.
temp_file={{ temp_file | default('/var/log/nagios4/nagios.tmp') }}

# temp_path: Directory for temporary files.
temp_path={{ temp_path | default('/var/log/nagios4') }}

# lock_file: PID file for the Nagios daemon.
lock_file={{ lock_file | default('/var/run/nagios4/nagios.pid') }}

# --- External command options ---
# check_external_commands: Whether to check the external command file for commands.
check_external_commands={{ check_external_commands | default(true) | lower }}

# command_check_interval: Interval (in seconds) between checks of the external command file.
command_check_interval={{ command_check_interval | default(1) }}

# command_file: Path to the external command file.
command_file={{ command_file | default('/var/spool/nagios4/cmd/nagios.cmd') }}

# --- Time options ---
# default_contactgroup_members: Default members for contact groups if none specified (comma-separated).
default_contactgroup_members={{ (default_contactgroup_members | default([])) | join(',') }}

# default_host_notification_period: Default notification time period for hosts.
default_host_notification_period={{ default_host_notification_period | default('24x7') }}

# default_service_notification_period: Default notification time period for services.
default_service_notification_period={{ default_service_notification_period | default('24x7') }}

# --- Notification options ---
# notification_timeout: Timeout (in seconds) for sending notifications.
notification_timeout={{ notification_timeout | default(60) }}

# --- Event handler options ---
# enable_event_handlers: Enable event handlers for hosts and services.
enable_event_handlers={{ enable_event_handlers | default(true) | lower }}

# --- Logging options ---
# log_rotation_method: Log rotation method: 'd' = daily, 'w' = weekly, 'm' = monthly.
log_rotation_method={{ log_rotation_method | default('d') }}

# log_archive_path: Directory where old log files are archived.
log_archive_path={{ log_archive_path | default('/var/log/nagios4/archives') }}

# log_level: Logging verbosity: 0 = errors only, 1 = warnings, 2 = info, 3 = debug.
log_level={{ log_level | default('0') }}

# --- Performance data options ---
# process_performance_data: Enable processing of performance data (e.g., for graphing).
process_performance_data={{ process_performance_data | default(false) | lower }}

# --- Deprecated options ---
# deprecated_options: Path to file listing deprecated options (empty = none).
deprecated_options={{ deprecated_options | default('') }}

# --- System options ---
# check_for_updates: Check for Nagios updates at startup.
check_for_updates={{ check_for_updates | default(true) | lower }}

# bare_update_check: Only check for updates without installing.
bare_update_check={{ bare_update_check | default(false) | lower }}

# --- Low-level tuning ---
# max_debug_file_size: Max size (in MB) of debug log files.
max_debug_file_size={{ max_debug_file_size | default(1) }}

# --- Object caching ---
# object_cache_file: Path to the object cache file.
object_cache_file={{ object_cache_file | default('/var/log/nagios4/objects.cache') }}

# precached_object_file: Path to the precached object file.
precached_object_file={{ precached_object_file | default('/var/log/nagios4/objects.precache') }}

# --- Retention file ---
# retention_file: Path to the retention data file (state across restarts).
retention_file={{ retention_file | default('/var/log/nagios4/retention.dat') }}

# --- Sleep time ---
# sleep_time: Amount of time (in seconds) Nagios sleeps between checks.
sleep_time={{ sleep_time | default(0.25) }}

# --- Service/Host check options ---
# service_check_timeout: Timeout (in seconds) for service checks.
service_check_timeout={{ service_check_timeout | default(60) }}

# host_check_timeout: Timeout (in seconds) for host checks.
host_check_timeout={{ host_check_timeout | default(30) }}

# --- Notification options ---
# notification_interval: Interval (in minutes) between re-notification for same problem state.
notification_interval={{ notification_interval | default(30) }}

# --- Stale service/host checks ---
# stale_service_checks: Enable stale service check processing.
stale_service_checks={{ stale_service_checks | default(true) | lower }}

# stale_host_checks: Enable stale host check processing.
stale_host_checks={{ stale_host_checks | default(true) | lower }}

# --- Passive checks options ---
# passive_service_checks_default: Enable passive service checks by default for newly defined services.
passive_service_checks_default={{ passive_service_checks_default | default(true) | lower }}

# passive_host_checks_default: Enable passive host checks by default for newly defined hosts.
passive_host_checks_default={{ passive_host_checks_default | default(true) | lower }}

# --- Event broker modules (loaded as list) ---
# event_broker_modules: List of event broker modules to load at startup.
{% for module in (event_broker_modules | default([])) %}broker_module={{ module }}
{% endfor %}

# --- Daemon options ---
# daemon_dumps_core: Whether to dump core on daemon crash (for debugging).
daemon_dumps_core={{ daemon_dumps_core | default(true) | lower }}

# --- Stats log ---
# stats_log_file: Path to the stats log file.
stats_log_file={{ stats_log_file | default('/var/log/nagios4/stats.log') }}

# stats_availability_days: Number of days to retain availability data in stats file.
stats_availability_days={{ stats_availability_days | default(30) }}

# --- Logging options ---
# use_syslog: Log to syslog in addition to log file.
use_syslog={{ use_syslog | default(false) | lower }}

# log_notifications: Log notifications to main log file.
log_notifications={{ log_notifications | default(true) | lower }}

# log_service_retries: Log service check retries.
log_service_retries={{ log_service_retries | default(false) | lower }}

# log_host_retries: Log host check retries.
log_host_retries={{ log_host_retries | default(false) | lower }}

# log_event_handlers: Log event handler execution.
log_event_handlers={{ log_event_handlers | default(true) | lower }}

# log_external_commands: Log external command execution.
log_external_commands={{ log_external_commands | default(false) | lower }}

# log_passive_checks: Log passive check results.
log_passive_checks={{ log_passive_checks | default(false) | lower }}