{
  "nagios_user": "nagios",
  "nagios_group": "nagios",
  "nagios_binary": "/usr/sbin/nagios",
  "nagios_cfg_file": "/etc/nagios4/nagios.cfg",
  "resource_file": "/etc/nagios4/resource.cfg",
  "status_file": "/var/log/nagios4/status.dat",
  "queue_file": "/var/spool/nagios4/nagios.qh",
  "log_file": "/var/log/nagios4/nagios.log",
  "log_archive_path": "/var/log/nagios4/archives",
  "cfg_dir": [
    "/etc/nagios4/objects"
  ],
  "temp_file": "/var/log/nagios4/nagios.tmp",
  "temp_path": "/var/log/nagios4",
  "lock_file": "/var/run/nagios4/nagios.pid",
  "check_external_commands": true,
  "command_check_interval": 1,
  "command_file": "/var/spool/nagios4/cmd/nagios.cmd",
  "default_contactgroup_members": [],
  "default_host_notification_period": "24x7",
  "default_service_notification_period": "24x7",
  "notification_timeout": 60,
  "enable_event_handlers": true,
  "log_rotation_method": "d",
  "log_level": "0",
  "process_performance_data": true,
  "deprecated_options": "",
  "check_for_updates": true,
  "bare_update_check": false,
  "max_debug_file_size": 1,
  "object_cache_file": "/var/log/nagios4/objects.cache",
  "precached_object_file": "/var/log/nagios4/objects.precache",
  "retention_file": "/var/log/nagios4/retention.dat",
  "sleep_time": 0.25,
  "service_check_timeout": 60,
  "host_check_timeout": 30,
  "notification_interval": 30,
  "stale_service_checks": true,
  "stale_host_checks": true,
  "passive_service_checks_default": true,
  "passive_host_checks_default": true,
  "event_broker_modules": [
    "/usr/lib/nagios/plugins/objectbroker/mod_python.so"
  ],
  "daemon_dumps_core": true,
  "stats_log_file": "/var/log/nagios4/stats.log",
  "stats_availability_days": 30,
  "use_syslog": false,
  "log_notifications": true,
  "log_service_retries": false,
  "log_host_retries": false,
  "log_event_handlers": true,
  "log_external_commands": true,
  "log_passive_checks": false
}
