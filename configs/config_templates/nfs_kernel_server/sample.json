{
  "exports": [
    {
      "path": "/srv/nfs/home",
      "client": "10.0.0.0/24",
      "options": [
        "rw",
        "sync",
        "no_subtree_check",
        "no_root_squash"
      ]
    },
    {
      "path": "/srv/nfs/shared",
      "client": "*",
      "options": [
        "ro",
        "secure",
        "no_subtree_check"
      ]
    },
    {
      "path": "/srv/nfs/backup",
      "client": "backup-server.local",
      "options": [
        "rw",
        "sync",
        "no_root_squash",
        "wdelay"
      ]
    }
  ]
}
