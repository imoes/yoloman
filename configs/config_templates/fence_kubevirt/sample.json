{
  "auth_type": "basic",
  "api_url": "https://kubernetes.default.svc",
  "kubeconfig": "/etc/fence_agents/kubevirt/kubeconfig",
  "token_file": "",
  "namespace": "openshiftVirtualization",
  "verify_ssl": true,
  "ca_cert": "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
  "retry": 3,
  "timeout": 90,
  "extra_headers": [
    {
      "name": "X-Forwarded-For",
      "value": "192.168.1.100"
    }
  ],
  "log_level": "info",
  "log_file": "/var/log/fence_agents/kubevirt.log"
}
