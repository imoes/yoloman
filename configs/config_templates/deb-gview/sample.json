{
  "terminal": "xterm",
  "preview_groups": [
    {
      "group_name": "manual pages",
      "pattern": "./usr/share/man/man*/*",
      "viewer": "man",
      "use_terminal": true,
      "binary_file": false,
      "file_suffix": ""
    },
    {
      "group_name": "HTML",
      "pattern": "*.html",
      "viewer": "sensible-browser",
      "use_terminal": false,
      "binary_file": false,
      "file_suffix": "html"
    },
    {
      "group_name": "PNG",
      "pattern": "*.png",
      "viewer": "qiv",
      "use_terminal": false,
      "binary_file": true,
      "file_suffix": "png"
    },
    {
      "group_name": "text",
      "pattern": "*",
      "viewer": "gedit",
      "use_terminal": false,
      "binary_file": false,
      "file_suffix": ""
    }
  ]
}
