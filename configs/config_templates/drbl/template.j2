# ==============================================================================
# DRBL (Diskless Remote Boot in Linux) Configuration
#
# This file configures the DRBL server environment. It controls paths for
# diskless clients, PXE boot resources, package management for various Linux
# distributions, and server-side service definitions.
#
# IMPORTANT: Variables defined here are referenced by DRBL setup scripts.
# Do not modify variable names; use defaults or override via Ansible variables.
# ==============================================================================

# --------------------------------------------------------------------------
# Paths and Directories
# --------------------------------------------------------------------------

# DRBL root directory for client-specific files.
# Default: /tftpboot/nodes
drblroot="{{ drblroot | default('/tftpboot/nodes') }}"

# DRBL common root directory shared by all clients.
# Default: /tftpboot/node_root
drbl_common_root="{{ drbl_common_root | default('/tftpboot/node_root') }}"

# Base URL for downloading syslinux/pxelinux binaries.
# Default: http://free.nchc.org.tw/syslinux
syslinux_binsrc_url="{{ syslinux_binsrc_url | default('http://free.nchc.org.tw/syslinux') }}"

# EFI boot loader option for live systems: 'syslinux' or 'grub'.
# Default: grub
live_efi_boot_loader="{{ live_efi_boot_loader | default('grub') }}"

# Prefix URL for DRBL-related resources and documentation.
# Default: http://free.nchc.org.tw
url_prefix="{{ url_prefix | default('http://free.nchc.org.tw') }}"

# Clonezilla image directory (must NOT end with '/').
# Default: /home/partimag
ocsroot="{{ ocsroot | default('/home/partimag') }}"

# --------------------------------------------------------------------------
# System Accounts and Authentication
# --------------------------------------------------------------------------

# Administrator account ID used for MS Windows remote management.
# Different Windows languages may require different IDs (e.g., Administrator, Administrateur).
# Default: Administrator
mswin_admin_id="{{ mswin_admin_id | default('Administrator') }}"

# --------------------------------------------------------------------------
# Localization and Timeouts
# --------------------------------------------------------------------------

# Default language code: 0=English, 1=Traditional Chinese (Big5), 2=Traditional Chinese (UTF-8).
# Default: 0
default_language="{{ default_language | default('0') }}"

# Default PXE menu timeout in 1/10 seconds.
# Default: 70
default_pxe_timeout="{{ default_pxe_timeout | default('70') }}"

# --------------------------------------------------------------------------
# User and Password Policies
# --------------------------------------------------------------------------

# Minimum UID for normal users (UIDs >= this value).
# Default: 500
uid_begin_default="{{ uid_begin_default | default('500') }}"

# Default GDM timeout in seconds.
# Default: 30
timed_gdm_time_default="{{ timed_gdm_time_default | default('30') }}"

# Default LightDM timeout in seconds.
# Default: 30
timed_lightdm_time_default="{{ timed_lightdm_time_default | default('30') }}"

# Default minimum password length.
# Default: 8
passwd_length_default="{{ passwd_length_default | default('8') }}"

# Time (in seconds) before deleting old auto_login_id_passwd.txt.
# Default: 1200
time_2_kill="{{ time_2_kill | default('1200') }}"

# --------------------------------------------------------------------------
# Disk and RAM Configuration
# --------------------------------------------------------------------------

# Default max swap file size (MB).
# Default: 1024
maxswapsize_default="{{ maxswapsize_default | default('1024') }}"

# Default RAM disk size for PXE/NBI initrd (MB).
# Default: 9600
default_ramdisk_size="{{ default_ramdisk_size | default('9600') }}"

# Buffer ratio for disk space calculations (client filesystem).
# Default: 1.5
buffer_ratio_for_client_space="{{ buffer_ratio_for_client_space | default('1.5') }}"

# --------------------------------------------------------------------------
# Network Services and DHCP/DNS
# --------------------------------------------------------------------------

# Path to dnsmasq configuration file.
# Default: /etc/dnsmasq.conf
dnsmasq_cfg="{{ dnsmasq_cfg | default('/etc/dnsmasq.conf') }}"

# Whether to use existing DHCP service when only one network interface exists.
# Default: no
use_existing_dhcp_srv="{{ use_existing_dhcp_srv | default('no') }}"

# --------------------------------------------------------------------------
# XFS Font Server
# --------------------------------------------------------------------------

# XFS font server ratio.
# Default: 1.2
xfs_ratio="{{ xfs_ratio | default('1.2') }}"

# XFS font server port.
# Default: 7100
fs_port="{{ fs_port | default('7100') }}"

# --------------------------------------------------------------------------
# Rsync and File Exclusions
# --------------------------------------------------------------------------

# Directories in /etc excluded when rsyncing to clients (must end with '/' except trailing).
# Default: /etc/selinux/targeted/ /etc/netplan/
etc_exclude_dirs="{{ etc_exclude_dirs | default('/etc/selinux/targeted/ /etc/netplan/') }}"

# Symbolic files in /var to handle specially (space-separated).
# Default: run lock
symbolic_files_in_var_chklist="{{ symbolic_files_in_var_chklist | default('run lock') }}"

# Directories in /lib excluded from being copied to common root.
# Default: modules live/mount
lib_NOT_2_be_copied_2_common_root="{{ lib_NOT_2_be_copied_2_common_root | default('modules live/mount') }}"

# --------------------------------------------------------------------------
# Graphical Boot
# --------------------------------------------------------------------------

# Enable graphical boot (e.g., rhgb) for Fedora-style clients.
# Default: no
graphical_boot="{{ graphical_boot | default('no') }}"

# ==============================================================================
# DYNAMIC SERVICE DETECTION (OS-specific)
# The following block detects the operating system and sets appropriate
# service names, paths, and package query commands.
# ==============================================================================

{% if '/etc/debian_version' is string and '/etc/debian_version' in ['/etc/debian_version'] %}
{# Debian #}
  SYSCONF_PATH="/etc/default/"
  # From Debian Squeeze, isc-dhcp-server is used, no more dhcp3-server
  if [ -x "/usr/sbin/dhcpd3" ]; then
    DHCPDCONF_DIR="/etc/dhcp3"
    DHCP_SRV_NAME="dhcp3-server"
  else
    DHCPDCONF_DIR="/etc/dhcp"
    DHCP_SRV_NAME="isc-dhcp-server"
  fi
  # DHCPDLEASE_DIR is got from get_dhcpdlease_dir() in drbl-functions
  NFS_SRV_NAME="nfs-kernel-server"
  YP_SRV_NAME="nis"
  # Now GDM_CFG, FAC_GDM_CFG and KDM_CFG are got in drbl-functions.
  RCX_ROOTDIR="/etc"
  # The releative path between init.d and rcx.d, for Debian, it's same, so
  # in when working dir is in rc.d, service is in ../init.d/
  RCX_REL_INITD="../init.d"
  query_allpkgs_cmd="dpkg --get-selections"
  query_pkglist_cmd="dpkg -L"
  # instead of using dpkg -s, we use dpkg -L, since dpkg -s will give the wrong
  # return code if a package is installed but removed later.
  query_pkglist_exist_cmd="dpkg -L"
{% elif '/etc/SuSE-release' is string and '/etc/SuSE-release' in ['/etc/SuSE-release'] %}
{# SuSE #}
  SYSCONF_PATH="/etc/sysconfig/"
  DHCPDCONF_DIR="/etc"
  # DHCPDLEASE_DIR is got from get_dhcpdlease_dir() in drbl-functions
  DHCP_SRV_NAME="dhcpd"
  NFS_SRV_NAME="nfs"
  YP_SRV_NAME="ypserv"
  # Now GDM_CFG, FAC_GDM_CFG and KDM_CFG are got in drbl-functions.
  RCX_ROOTDIR="/etc/init.d"
  # The releative path between init.d and rcx.d, for SuSE, it's not same,
  # rcx.d is under init.d. So in when working dir is in rc.d, service is in ../
  RCX_REL_INITD="../"
  query_allpkgs_cmd="rpm -qa"
  query_pkglist_cmd="rpm -ql"
  query_pkglist_exist_cmd="rpm -q"
{% else %}
{# RH-like #}
  SYSCONF_PATH="/etc/sysconfig/"
  # From Fedora 11, the dhcpd config dir is in /etc/dhcp
  if [ -d "/etc/dhcp" ]; then
    DHCPDCONF_DIR="/etc/dhcp"
  else
    DHCPDCONF_DIR="/etc"
  fi
  # DHCPDLEASE_DIR is got from get_dhcpdlease_dir() in drbl-functions
  DHCP_SRV_NAME="dhcpd"
  # From Mandriva 2008.0, the nfs server name is changed to nfs-server.
  nfs_srv_name_chklist="nfs nfs-server"
  NFS_SRV_NAME=""
  for i in $nfs_srv_name_chklist; do
     if [ -e /etc/init.d/$i -o -e "/lib/systemd/system/$i.service" ]; then
        NFS_SRV_NAME="$i"
        break
     fi
  done
  YP_SRV_NAME="ypserv"
  # Now GDM_CFG, FAC_GDM_CFG and KDM_CFG are got in drbl-functions.
  RCX_ROOTDIR="/etc"
  # The releative path between init.d and rcx.d, for RH-like, it's same, so
  # in when working dir is in rc.d, service is in ../init.d/
  RCX_REL_INITD="../init.d"
  query_allpkgs_cmd="rpm -qa"
  query_pkglist_cmd="rpm -ql"
  query_pkglist_exist_cmd="rpm -q"
{% endif %}

