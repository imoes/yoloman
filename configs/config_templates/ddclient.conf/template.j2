# ddclient configuration file
# Generated from template for ddclient
#
# Run ddclient as daemon: set to 'true' to enable background polling
use_syslog = yes

# Log file for ddclient; leave blank to use syslog only
log_file = {{ log_file }}

# Daemon interval in seconds between updates
daemon = {{ daemon_interval }}

# Protocol to use for dynamic DNS updates
protocol = {{ protocol }}

# Default server to connect to (can be overridden per account)
server = {{ default_server }}

# Use SSL/TLS for connections (if supported by protocol)
use_ssl = {{ use_ssl | lower }}

# Login and password for default account (if no per-host credentials defined)
login = {{ default_login }}
password = {{ default_password }}

# List of hosts to update
{% for host in hosts %}
# Hostname: {{ host.hostname }}
#  - IP source: {{ host.ip_source }}
{% if host.login is defined and host.login != '' %}login = {{ host.login }}{% endif %}
{% if host.password is defined and host.password != '' %}password = {{ host.password }}{% endif %}
{% if host.server is defined and host.server != '' %}server = {{ host.server }}{% endif %}
{% if host.protocol is defined and host.protocol != '' %}protocol = {{ host.protocol }}{% endif %}
{{ host.hostname }}{% if host.ip_source == 'web' or host.ip_source == 'if' %},{{ host.ip_source | replace('if:', 'if=') }}{% endif %}
{% endfor %}
