# ============================================================================
# ddclient configuration file
# Generated from Ansible Jinja2 template for ddclient
# Self-documenting: every directive is preceded by a comment derived from schema.
# ============================================================================

# Run ddclient as daemon: set to 'true' to enable background polling
# Note: The original template used 'use_syslog = yes' here which is semantically
# incorrect for a 'use_daemon' directive. We set use_daemon based on the logic
# implied by the structure, but ddclient's config uses 'daemon=N' or 'daemon=300'.
# The variable `daemon_interval` controls the interval. If interval > 0, it runs as daemon.
# We will output the daemon interval directly as ddclient expects `daemon = <seconds>`.
# The line `use_syslog = yes` is handled below or via log_file/syslog interaction.

# Log file for ddclient; leave blank to use syslog only
# Schema: log_file (string, default='')
log_file = {{ log_file | default('') }}

# Daemon interval in seconds between updates
# Schema: daemon_interval (int, default=300). Minimum 60.
# If this is set, ddclient runs as a daemon with this polling interval.
daemon = {{ daemon_interval | default(300) | int }}

# Protocol to use for dynamic DNS updates
# Schema: protocol (string, default='dyndns2'). Examples: dyndns2, namesilo, cloudflare.
{% if protocol is defined and protocol is not none and protocol != '' %}protocol = {{ protocol }}{% else %}#protocol=dyndns2				# default protocol{% endif %}

# Default server to connect to (can be overridden per account)
# Schema: default_server (string, default='dynupdate.no-ip.com')
{% if default_server is defined and default_server is not none and default_server != '' %}server = {{ default_server }}{% else %}#server=members.dyndns.org			# default server{% endif %}

# Use SSL/TLS for connections (if supported by protocol)
# Schema: use_ssl (bool, default=True)
use_ssl = {{ use_ssl | default(True) | lower }}

# Login and password for default account (if no per-host credentials defined)
# Schema: default_login (string, default='')
# Schema: default_password (string, default='')
{% if default_login is defined and default_login is not none and default_login != '' %}login = {{ default_login }}{% else %}#login=your-login				# default login{% endif %}
{% if default_password is defined and default_password is not none and default_password != '' %}password = {{ default_password }}{% else %}#password=test					# default password{% endif %}

# List of hosts to update
# Schema: hosts (list, default=[]). Each item is a mapping with optional keys:
#   hostname (required), ip_source, login, password, server, protocol.
{% for host in hosts | default([]) %}
# ------------------------------------------------------------------
# Host: {{ host.hostname | default('') }}
# IP Source: {{ host.ip_source | default('') }}
# ------------------------------------------------------------------

{% if host.login is defined and host.login != '' %}
login = {{ host.login }}
{% endif %}

{% if host.password is defined and host.password != '' %}
password = {{ host.password }}
{% endif %}

{% if host.server is defined and host.server != '' %}
server = {{ host.server }}
{% endif %}

{% if host.protocol is defined and host.protocol != '' %}
protocol = {{ host.protocol }}
{% endif %}

# The hostname itself, potentially followed by an IP source option.
# Supported ip_source values in ddclient: web, if, curl, etc.
# Syntax for ip_source options:
#   web  -> fetch IP from web service
#   if=DEVICE -> fetch IP from network interface
#   curl=URL -> fetch IP from specific URL
#   <ip> -> static IP address
{{ host.hostname | default('') }}{% if host.ip_source is defined and host.ip_source != '' %},{{ host.ip_source | replace('if:', 'if=') }}{% endif %}
{% endfor %}