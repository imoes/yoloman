{
  "daemon_interval": 300,
  "log_file": "/var/log/ddclient.log",
  "protocol": "dyndns2",
  "default_server": "www.dyndns.com",
  "use_ssl": true,
  "default_login": "myuser@example.com",
  "default_password": "mysecretpassword",
  "hosts": [
    {
      "hostname": "myhome.example.com",
      "ip_source": "web",
      "login": "",
      "password": "",
      "server": "",
      "protocol": ""
    },
    {
      "hostname": "backup.example.com",
      "ip_source": "if=eth0",
      "login": "backupuser@example.com",
      "password": "backupsecretpassword",
      "server": "dyndns.customprovider.net",
      "protocol": "dyndns1"
    }
  ]
}
