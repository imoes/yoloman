{
  "directory": "/var/lib/gnupg/wks",
  "from": "webkey@example.net",
  "headers": [
    {
      "name": "X-WKS-Loop",
      "value": "webkey.example.net"
    }
  ],
  "domains": [
    {
      "name": "example.net",
      "submission_address": "key-submission@example.net"
    }
  ],
  "procmail_recipe": ":0\n* !^From: webkey@example.net\n* !^X-WKS-Loop: webkey.example.net\n|gpg-wks-server -v --receive --header X-WKS-Loop=webkey.example.net --from webkey@example.net --send"
}
