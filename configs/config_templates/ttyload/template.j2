# ttyload configuration file
# This file configures the ttyload utility, which displays system load statistics
# in a terminal-based graph.

{% if monochrome | default(false) %}
# Monochrome mode (no ANSI color escapes)
# When enabled, disables colored output for terminals that do not support ANSI colors.
-m
{% endif %}

# Number of columns for the graph display
# Defines the width of the ttyload output in screen columns.
-c {{ cols | default(80) }}

# Number of rows for the graph display
# Defines the height of the ttyload output in screen rows.
-r {{ rows | default(24) }}

# Refresh interval in seconds
# Sets the number of seconds between screen updates.
-i {{ interval | default(4) }}