# =============================================================================
# /etc/default/wipe
# Configuration for the secure file wiping utility (wipe).
# This file sets default options that can be overridden by command-line flags.
# =============================================================================

# Enable secure wiping.
# When true, the wipe operation is active. If false, the tool may act as a no-op or
# perform only metadata checks depending on implementation.
# Type: boolean
enable_wipe={{ enable_wipe | default(True) | lower }}

# Path to the random device or command used to seed the PRNG.
# Common values: /dev/random, /dev/urandom, /dev/hwrandom.
# For command-based seeding, specify the command string.
# Type: string
random_source={{ random_source | default('/dev/random') }}

# Random seed method: Single character indicating how the seed is obtained.
#   r = Read from a file or device (default for /dev/random etc.)
#   c = Hash the output of a command
#   p = Hash environment variables or /proc entries
# Type: string (single char)
random_method={{ random_method | default('r') }}

# PRNG algorithm: Single character indicating the pseudo-random number generator.
#   l = Use libc's rand() or random() functions
#   a = Use Arcfour (RC4) algorithm
#   r = Use RC6 algorithm (often considered strongest available)
# Type: string (single char)
prng_algorithm={{ prng_algorithm | default('r') }}

# Force mode: Disable interactive confirmation query.
# When true, wipe proceeds without asking for user confirmation.
# Type: boolean
force_mode={{ force_mode | default(True) | lower }}

# Recursive mode: Recurse into subdirectories.
# When true, if a path is a directory, all contained files and subdirs are wiped.
# Type: boolean
recursive_mode={{ recursive_mode | default(False) | lower }}

# Quick wipe mode: Use fewer passes for faster operation.
# When true, reduces the number of overwrite passes (see quick_passes).
# Type: boolean
quick_mode={{ quick_mode | default(False) | lower }}

# Number of passes for quick wipe.
# Used when quick_mode is enabled. Specifies how many times to overwrite data.
# Type: integer
quick_passes={{ quick_passes | default(4) }}

# Keep files: Do not unlink files after overwriting.
# Useful for block devices where you only want to overwrite data, not destroy
# the file system structure. Implies skip_name_wipe.
# Type: boolean
keep_files={{ keep_files | default(False) | lower }}

# Dereference symlinks: Follow symlinks to their targets.
# When true, the content of the file pointed to by the symlink is wiped,
# not the symlink itself.
# Type: boolean
dereference_symlinks={{ dereference_symlinks | default(False) | lower }}

# Verbose mode: Enable informational/verbose output to stdout.
# When true, provides detailed logs of the wiping process.
# Type: boolean
verbose_mode={{ verbose_mode | default(False) | lower }}

# Silent mode: Suppress all output except errors.
# When true, only errors are printed; standard progress/info messages are hidden.
# Type: boolean
silent_mode={{ silent_mode | default(False) | lower }}

# Abort on error: Exit with failure status on non-fatal error.
# When true, the tool stops immediately if it encounters an error it cannot recover from.
# Type: boolean
abort_on_error={{ abort_on_error | default(False) | lower }}

# Skip size wipe: Do not try to wipe file sizes by repeatedly halving.
# Some filesystems store size metadata separately; this option controls whether
# to zero-out size indicators.
# Type: boolean
skip_size_wipe={{ skip_size_wipe | default(False) | lower }}

# Skip name wipe: Do not try to wipe file names by renaming.
# Overwrites directory entry names with random or zero data to hide filenames.
# Type: boolean
skip_name_wipe={{ skip_name_wipe | default(False) | lower }}

# Exact size: Use exact file size without rounding up to last block.
# When false, the last block might be padded or rounded. When true, only exact
# data bytes are overwritten.
# Type: boolean
exact_size={{ exact_size | default(False) | lower }}

# List of file or block device paths to wipe.
# Each path listed below will be processed by the wipe utility.
# Type: list of strings
{% for path in wipe_paths | default([]) %}
target_path={{ path }}
{% endfor %}