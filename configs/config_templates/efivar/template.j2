# efivar command-line arguments configuration
# This template generates the command-line flags for the `efivar` utility,
# which manages UEFI variables stored in NVRAM.
# Each flag corresponds to a specific action (list, print, write, import, export, etc.)
# and is only emitted if the associated schema field is enabled or provided.

{# list_variables: default=False desc='List current UEFI variables (corresponds to -l/--list)' #}
{% if list_variables | default(false) %}--list{% endif %}

{# print_variable: default=False desc='Print variable specified by --name (corresponds to -p/--print)' #}
{% if print_variable | default(false) %}--print{% endif %}

{# name: default='' desc='Variable name in GUID-Name format, e.g., 8be4df61-93ca-11d2-aa0d-00e098032b8c-Boot0000 (corresponds to -n/--name)' #}
{% if name | default('') %}-n {{ name | default('') }}{% endif %}

{# append: default=False desc='Append data to variable specified by --name (corresponds to -a/--append)' #}
{% if append | default(false) %}--append{% endif %}

{# datafile: default='' desc='File to load or save variable contents from/to (corresponds to -f/--datafile)' #}
{% if datafile | default('') %}-f {{ datafile | default('') }}{% endif %}

{# export_file: default='' desc='File to export variable to (corresponds to -e/--export)' #}
{% if export_file | default('') %}-e {{ export_file | default('') }}{% endif %}

{# import_file: default='' desc='File to import variable from (corresponds to -i/--import)' #}
{% if import_file | default('') %}-i {{ import_file | default('') }}{% endif %}

{# attributes: default='' desc='UEFI attributes as comma-separated flags (e.g., Boot, Runtime, Authenticated); empty string disables flag (corresponds to -A/--attributes)' #}
{% if attributes | default('') %}-A {{ attributes | default('') }}{% endif %}

{# dmpstore: default=False desc='Use DMPSTORE format when exporting (corresponds to -D/--dmpstore)' #}
{% if dmpstore | default(false) %}--dmpstore{% endif %}

{# print_decimal: default=False desc='Print variable in decimal format (corresponds to -d/--print-decimal)' #}
{% if print_decimal | default(false) %}--print-decimal{% endif %}

{# list_guids: default=False desc='Show internal GUID list (corresponds to -L/--list-guids)' #}
{% if list_guids | default(false) %}--list-guids{% endif %}

{# write: default=False desc='Write to variable specified by --name (corresponds to -w/--write)' #}
{% if write | default(false) %}--write{% endif %}