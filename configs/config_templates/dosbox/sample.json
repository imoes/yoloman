{
  "dosbox_language": "english",
  "dosbox_machine": "vgaonly",
  "dosbox_memsize": 32,
  "renderer_scaler": "none",
  "renderer_forcescaler": "",
  "mouse_focused": true,
  "mouse_emulate": true,
  "mixer_nosound": false,
  "mixer_rate": 48000,
  "mixer_blocksize": 2048,
  "midi_type": "opl3",
  "midi_device": "/dev/midi0",
  "serial_ports": [
    {
      "port": 1,
      "type": "direct"
    },
    {
      "port": 2,
      "type": "dummy"
    }
  ],
  "dos_himem": true,
  "dos_hma": true,
  "dos_dosdir": "C",
  "autoexec_commands": [
    "mount c /home/user/dosgames",
    "c:",
    "cd mygame",
    "mygame.exe"
  ]
}
