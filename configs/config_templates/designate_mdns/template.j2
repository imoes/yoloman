[DEFAULT]
# Log level for designate-mdns
log_level = {{ log_level }}

# Base directory for logging
log_dir = {{ log_dir }}

# Listen address for the mDNS service
bind_host = {{ bind_host }}

# Listen port for the mDNS service
bind_port = {{ bind_port }}

# Number of worker processes
workers = {{ workers }}

# Maximum number of concurrent requests per worker
max_request_body_size = {{ max_request_body_size }}

# RPC transport URL (e.g., rabbitmq://user:pass@host:5672/)
rpc_backend = {{ rpc_backend }}
rabbit_host = {{ rabbit_host }}
rabbit_port = {{ rabbit_port }}
rabbit_user = {{ rabbit_user }}
rabbit_password = {{ rabbit_password }}
rabbit_virtual_host = {{ rabbit_virtual_host }}

# Keystone authentication endpoint
auth_strategy = keystone

# Path to the SSL certificate (optional)
# ssl_cert_file = {{ ssl_cert_file }}
# ssl_key_file = {{ ssl_key_file }}

[storage]
# Backend driver for storage (only 'sql' is used in designate-mdns)
driver = {{ storage_driver }}

# SQLAlchemy connection string for MySQL/PostgreSQL
connection = {{ sql_connection }}

[service:mdns]
# Enable/Disable mdns service
enabled = {{ mdns_enabled }}

# Comma-separated list of zone IDs to allow as allowed zones (empty = all)
# allowed_zones = {{ allowed_zones }}

# Comma-separated list of zone IDs to explicitly deny (overrides allowed_zones)
# denied_zones = {{ denied_zones }}

# Maximum number of responses per request (RFC 1035 limits this to 255)
max_responses = {{ max_responses }}

# TTL for negative responses (NXDOMAIN, etc.)
negative_ttl = {{ negative_ttl }}

# Enable EDNS support
edns = {{ edns_enabled }}

# Enable DNS over HTTPS (DoH) support
# doh_enabled = {{ doh_enabled }}
# doh_bind_host = {{ doh_bind_host }}
# doh_bind_port = {{ doh_bind_port }}
# doh_cert_file = {{ doh_cert_file }}
# doh_key_file = {{ doh_key_file }}
