{
  "log_level": "INFO",
  "log_dir": "/var/log/designate",
  "bind_host": "127.0.0.1",
  "bind_port": 5355,
  "workers": 2,
  "max_request_body_size": 65535,
  "rpc_backend": "rabbit",
  "rabbit_host": "192.168.1.10",
  "rabbit_port": 5672,
  "rabbit_user": "designate",
  "rabbit_password": "secret_rabbit_pass",
  "rabbit_virtual_host": "/designate",
  "storage_driver": "sql",
  "sql_connection": "mysql+pymysql://designate:db_secret@192.168.1.20/designate?charset=utf8mb4",
  "mdns_enabled": true,
  "max_responses": 100,
  "negative_ttl": 60,
  "edns_enabled": true,
  "ssl_cert_file": "/etc/ssl/certs/designate-mdns.crt",
  "ssl_key_file": "/etc/ssl/private/designate-mdns.key"
}
