# This file configures `rpmdevtools` commands (e.g., `rpmdev-bumpspec`, `rpmdev-setversion`)
# to allow operations on unsigned RPM packages.
#
# Setting this to 'yes' enables the --insecure flag globally for all rpmdevtools commands,
# allowing them to bypass GPG signature verification. This is useful for development
# environments where packages are not signed, or for testing purposes.
#
# WARNING: Enabling this reduces security as it allows the installation or processing
# of RPM packages that have not been verified by a trusted GPG key.
insecure=yes
