{
 "charset_file": {
  "default": "charset.lst",
  "description": "Path to external charset.lst file — used with -f",
  "enum": [
   "charset.lst",
   "unicode_test.lst"
  ],
  "type": "string"
 },
 "charset_name": {
  "default": "mixalpha-numeric-all-space",
  "description": "Name of charset in external file (e.g., 'mixalpha-numeric-all-space')",
  "enum": [
   "mixalpha-numeric-all-space",
   "symbols",
   "lower",
   "upper",
   "hex-lower",
   "hex-upper"
  ],
  "type": "string"
 },
 "charset_string": {
  "default": [
   "+",
   "+",
   "+",
   "+"
  ],
  "description": "Ordered character sets: lowercase, uppercase, digits, symbols. Use '+' for unused set.",
  "type": "list"
 },
 "compression": {
  "description": "Compression format: 'gzip', 'bzip2', 'lzma', or '7z'",
  "enum": [
   "gzip",
   "bzip2",
   "lzma",
   "7z"
  ],
  "type": "string"
 },
 "duplicate_limits": {
  "default": [],
  "description": "List of duplicate limits (e.g., ['2@', '3%'])",
  "type": "list"
 },
 "file_size_limit": {
  "default": "mb",
  "description": "File size limit for auto-split (e.g., '100mb', '500kb') — used with -o START",
  "enum": [
   "kb",
   "mb",
   "gb",
   "kib",
   "mib",
   "gib"
  ],
  "type": "string"
 },
 "invert": {
  "default": false,
  "description": "Invert output order (vertical permutation)",
  "type": "bool"
 },
 "line_count_limit": {
  "default": null,
  "description": "Max lines per file when auto-splitting — used with -o START",
  "type": "number"
 },
 "literals": {
  "description": "Literal mask matching pattern length to preserve symbols like @,%^",
  "enum": [
   "@",
   ",",
   "%",
   "^"
  ],
  "type": "string"
 },
 "max_len": {
  "default": 8,
  "description": "Maximum word length",
  "type": "number"
 },
 "min_len": {
  "default": 1,
  "description": "Minimum word length",
  "type": "number"
 },
 "output_file": {
  "default": "",
  "description": "Output filename when output_mode is 'file'",
  "type": "string"
 },
 "output_mode": {
  "default": "screen",
  "description": "Output mode: 'screen', 'file', or 'start' (auto-split)",
  "enum": [
   "screen",
   "file",
   "START"
  ],
  "type": "string"
 },
 "pattern": {
  "description": "Pattern string (e.g., '@@god@@@') for fixed positions",
  "enum": [
   "@",
   ",",
   "%",
   "^"
  ],
  "type": "string"
 },
 "permutation": {
  "default": false,
  "description": "Generate permutations (no repeats, factorial output)",
  "type": "bool"
 },
 "permute_file": {
  "default": "",
  "description": "File of words to permute (used with -q)",
  "type": "string"
 },
 "silent": {
  "default": false,
  "description": "Disable progress percentage output (use -u)",
  "type": "bool"
 },
 "start_string": {
  "default": "",
  "description": "Starting string to resume or override first word",
  "type": "string"
 },
 "stop_string": {
  "default": "",
  "description": "Early stop string — stops generation at this word",
  "type": "string"
 }
}
