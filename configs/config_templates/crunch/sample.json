{
  "min_len": 4,
  "max_len": 6,
  "charset_string": [
    "abcdefghijklmnopqrstuvwxyz",
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "0123456789",
    "!@#$%"
  ],
  "output_mode": "start",
  "file_size_limit": "20mb",
  "compression": "bzip2",
  "pattern": "@@god@@@",
  "start_string": "cbdogaaa",
  "stop_string": " dog ",
  "duplicate_limits": [
    "2@"
  ],
  "invert": false,
  "permutation": false,
  "silent": true
}
