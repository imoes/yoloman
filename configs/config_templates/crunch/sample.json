{
 "charset_string": [
  "abcdefghijklmnopqrstuvwxyz",
  "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
  "0123456789",
  "!@#$%"
 ],
 "compression": "bzip2",
 "duplicate_limits": [
  "2@"
 ],
 "file_size_limit": "20mb",
 "invert": false,
 "max_len": 6,
 "min_len": 4,
 "output_mode": "start",
 "pattern": "@@god@@@",
 "permutation": false,
 "silent": true,
 "start_string": "cbdogaaa",
 "stop_string": " dog "
}
