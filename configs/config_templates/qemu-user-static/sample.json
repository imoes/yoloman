{
  "architectures": [
    {
      "name": "aarch64",
      "machine_type": ":MM",
      "endianness": ":L:",
      "flags": ":PFOE",
      "interpreter": "/usr/bin/qemu-aarch64-static"
    },
    {
      "name": "arm",
      "machine_type": ":MM",
      "endianness": ":L:",
      "flags": ":PFOE",
      "interpreter": "/usr/bin/qemu-arm-static"
    },
    {
      "name": "x86_64",
      "machine_type": ":MM",
      "endianness": ":L:",
      "flags": ":PFOE",
      "interpreter": "/usr/bin/qemu-x86_64-static"
    }
  ],
  "register": true,
  "qemu_user_static_path": "/usr/bin/qemu-user-static",
  "max_instances": 4
}
