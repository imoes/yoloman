# /etc/ftpchroot: list of users who need to be chrooted into their home directory by inetutils-ftpd.
# See ftpchroot(5) and in.ftpd(8) for details.
# Format: one username per line, or space-separated on a single line.
# Default includes 'root' if no other users are specified.
{% for user in (users | default(['root'])) %}
{{ user }}
{% endfor %}