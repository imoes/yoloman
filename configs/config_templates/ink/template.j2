# Ink Configuration Template
# Generated for gnustep-examples Ink text editor
# This template provides default settings for the Ink plain-text editor.

# The default font family used for plain text and RTF documents.
FONT_FAMILY={{ font_family | default('Courier New') }}

# The default font size in points.
FONT_SIZE={{ font_size | default(12) }}

# The default text color.
TEXT_COLOR={{ text_color | default('black') }}

# The default background color.
BG_COLOR={{ bg_color | default('white') }}

# Auto-save interval in seconds. Set to 0 to disable.
AUTO_SAVE_INTERVAL={{ auto_save_interval | default(300) }}

# List of file extensions recognized as valid text documents.
VALID_EXTENSIONS={{ valid_extensions | default(['.txt', '.rtf']) | join(', ') }}

# Whether word wrap is enabled by default.
WORD_WRAP={{ word_wrap | default(true) }}

# List of supported line ending styles.
LINE_ENDINGS={{ line_endings | default(['LF', 'CRLF']) | join(', ') }}