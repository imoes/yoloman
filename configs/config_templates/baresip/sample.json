{
  "interface": "eth0",
  "ua": {
    "regint": 300,
    "aor": "sip:alice@example.com",
    "dispname": "Alice Johnson",
    "rport": "yes",
    "contact": "<sip:alice@192.168.1.100:5060;transport=udp>",
    "cuser": "alice",
    "expires": 300
  },
  "audio": {
    "ausrc": "alsa",
    "auenc": "opus",
    "audec": "opus",
    "aubuf": "20ms:30ms",
    "srcfmt": "s16",
    "encfmt": "s16",
    "playfmt": "s16",
    "srate": 48000,
    "channels": 1
  },
  "video": {
    "src": "v4l2",
    "disp": "x11",
    "size": "640x480",
    "bitrate": 512000,
    "fps": 25.0
  },
  "net_if": {
    "ipv4": "true",
    "use": "eth0"
  },
  "dns": {
    "server": "8.8.8.8",
    "timeout": 5
  },
  "sip_trace": true,
  "modules": [
    "alsa",
    "opus",
    "uuid",
    "menu",
    "vidloop"
  ],
  "log_level": 4,
  "audiopath": "/usr/share/baresip/audio"
}
