# RS Configuration File
# This file configures the default behavior for the `rs` array reshaping utility.
# Note: `rs` is primarily a command-line filter. This configuration applies
# to wrapper scripts or environments where `rs` defaults are needed.
#
# All variables use `| default(...)` to ensure safe rendering when the
# variable is not defined in the Ansible play/role scope.

# The width of the display in characters, corresponding to the -w option.
# Default: 80
rs_display_width: {{ rs_display_width | default(80) }}

# The single character used to delimit input columns, corresponding to the -c option.
# Default: \t (tab)
# Note: Escaped for YAML-safe string rendering.
rs_input_delimiter: "{{ rs_input_delimiter | default('\t') }}"

# The single character used to delimit output columns, corresponding to the -C option.
# Default: \t (tab)
# Note: Escaped for YAML-safe string rendering.
rs_output_delimiter: "{{ rs_output_delimiter | default('\t') }}"

# The desired number of rows in the output array.
# 0 means auto-calculate.
# Corresponds to: -rN
rs_output_rows: {{ rs_output_rows | default(0) }}

# The desired number of columns in the output array.
# 0 means auto-calculate.
# Corresponds to: -cN
rs_output_cols: {{ rs_output_cols | default(0) }}

# The gutter width (inter-column space) as a percentage of the maximum column width,
# corresponding to the -G option.
# Default: 0
rs_gutter_percent: {{ rs_gutter_percent | default(0) }}

# The number of initial input lines to ignore, corresponding to the -k option.
# Default: 0
rs_skip_lines: {{ rs_skip_lines | default(0) }}

# Right-adjust entries within columns, corresponding to the -j option.
# Default: false
rs_right_align: {{ rs_right_align | default(false) | lower }}

# Consider each character of input as an array entry, corresponding to the -E option.
# Default: false
rs_char_mode: {{ rs_char_mode | default(false) | lower }}

# Consider each line of input as an array entry, corresponding to the -e option.
# Default: false
rs_line_mode: {{ rs_line_mode | default(false) | lower }}

# Transpose the input (fill output rows using input columns), corresponding to the -t option.
# Default: false
rs_transpose: {{ rs_transpose | default(false) | lower }}

# Print the shape of the input array and do nothing else, corresponding to the -h option.
# Default: false
rs_print_shape: {{ rs_print_shape | default(false) | lower }}

# Use null entries to pad out lines with fewer entries than the first,
# corresponding to the -n option.
# Default: false
rs_pad_nulls: {{ rs_pad_nulls | default(false) | lower }}

# Pad the output by recycling the input from the beginning,
# corresponding to the -y option.
# Default: false
rs_recycle_input: {{ rs_recycle_input | default(false) | lower }}

# Shrink column widths to fit the largest entries, corresponding to the -z option.
# Default: false
rs_shrink_widths: {{ rs_shrink_widths | default(false) | lower }}

# Do not trim excess delimiters from the ends of the output array,
# corresponding to the -m option.
# Default: false
rs_no_trim: {{ rs_no_trim | default(false) | lower }}