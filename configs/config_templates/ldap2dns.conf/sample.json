{
 "dns": {
  "backend": "bind9",
  "bind9": {
   "key_algorithm": "hmac-sha256",
   "key_file": "/etc/bind/rndc.key",
   "key_name": "rndc-key",
   "server": "127.0.0.1",
   "zone_dir": "/var/cache/ldap2dns"
  }
 },
 "ldap": {
  "base_dn": "ou=DNS,dc=example,dc=com",
  "bind_dn": "cn=ldap2dns,ou=System,dc=example,dc=com",
  "bind_password": "SECRET",
  "search_depth": 1,
  "search_filter": "objectClass=dnsZone",
  "tls": {
   "ca_cert_file": "/etc/ldap2dns/ca.crt",
   "cert_file": "/etc/ldap2dns/client.crt",
   "key_file": "/etc/ldap2dns/client.key"
  },
  "uri": "ldaps://ldap.example.com"
 },
 "log": {
  "format": "json",
  "level": "info"
 },
 "rate_limit": {
  "burst_size": 5,
  "max_updates_per_minute": 30
 },
 "zones": [
  {
   "base_dn": "dc=example,dc=com",
   "name": "example.com"
  },
  {
   "base_dn": "dc=sub,dc=example,dc=com",
   "name": "sub.example.com",
   "template": "/etc/ldap2dns/templates/sub-zone.j2"
  }
 ]
}
