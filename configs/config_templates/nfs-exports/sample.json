{
  "exports": [
    {
      "path": "/srv/nfs/home",
      "clients": [
        "192.168.1.0/24(rw,sync,no_root_squash,no_subtree_check)",
        "10.0.0.5(rw,no_root_squash)"
      ]
    },
    {
      "path": "/srv/nfs/public",
      "clients": [
        "*(ro,sync,no_subtree_check)",
        "trusted.local(rw,no_root_squash)"
      ]
    },
    {
      "path": "/srv/nfs/backups",
      "clients": [
        "backup-server.internal(rw,no_subtree_check,async)"
      ]
    }
  ]
}
