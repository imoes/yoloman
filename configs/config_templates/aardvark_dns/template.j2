# Aardvark DNS configuration
# Self-documenting: every directive is preceded by its schema description.

# listen_addr: default='127.0.0.1'
# desc='IP address to bind the DNS server to. Use 0.0.0.0 for all interfaces.'
listen_addr: "{{ (listen_addr | default('127.0.0.1')) | string }}"

# listen_port: default=53
# desc='Port to listen on for DNS queries.'
listen_port: {{ (listen_port | default(53)) | int }}

# max_udp_size: default=4096
# desc='Maximum UDP payload size (RFC 6891 EDNS0 buffer size). Set to 512 for strict compatibility.'
max_udp_size: {{ (max_udp_size | default(4096)) | int }}

# tcp_enabled: default=True
# desc='Enable TCP support (required for DNS over TCP, large responses, and DoH/DoQ).'
tcp_enabled: {{ (tcp_enabled | default(True)) | bool | lower }}

# upstream_servers: default=['1.1.1.1', '8.8.8.8']
# desc='List of upstream DNS servers to forward queries to by default.'
upstream_servers:
{% for server in (upstream_servers | default(['1.1.1.1', '8.8.8.8'])) %}  - "{{ server }}"
{% endfor %}

# forward_zones: default=[]
# desc='Domain-specific forwarding rules. Queries matching the domain suffix use the specified upstreams.'
forward_zones:
{% for zone in (forward_zones | default([])) %}  - domain: "{{ zone.domain }}"
    upstreams:
{% for up in (zone.upstreams | default([])) %}      - "{{ up }}"
{% endfor %}
{% endfor %}

# local_records: default=[]
# desc='Static DNS records served locally (bypass upstream). Useful for container hostnames or internal services.'
local_records:
{% for rec in (local_records | default([])) %}  - domain: "{{ rec.domain }}"
    type: "{{ rec.type }}"
    data: "{{ rec.data }}"
{% endfor %}

# default_ttl: default=600
# desc='Default TTL (seconds) for cacheable responses from local records or forwarders.'
default_ttl: {{ (default_ttl | default(600)) | int }}

# cache_size: default=10000
# desc='Maximum number of DNS cache entries. Set to 0 to disable caching.'
cache_size: {{ (cache_size | default(10000)) | int }}

# log_level: default='info'
# desc='Verbosity of logs emitted to stderr or log_file.'
log_level: "{{ (log_level | default('info')) | string }}"

# log_file: default=''
# desc='Path to file where access logs are written. If empty, logs go to stdout.'
log_file: "{{ (log_file | default('')) | string }}"

# dnssec_enabled: default=False
# desc='Enable DNSSEC validation of responses. Requires upstream DNSSEC support.'
dnssec_enabled: {{ (dnssec_enabled | default(False)) | bool | lower }}

# trust_anchor_file: default='/etc/aardvark-dns/root-ksk-2017.json'
# desc='Path to DNSSEC trust anchor file (e.g., ICANN KSK-2017).'
trust_anchor_file: "{{ (trust_anchor_file | default('/etc/aardvark-dns/root-ksk-2017.json')) | string }}"

# dns_ecs_enabled: default=False
# desc="Enable EDNS Client Subnet (ECS) — allows upstream resolvers to see client's subnet for geo-aware responses."
dns_ecs_enabled: {{ (dns_ecs_enabled | default(False)) | bool | lower }}

# allow_from: default=['0.0.0.0/0']
# desc='List of allowed networks (CIDR) permitted to query this server.'
allow_from:
{% for cidr in (allow_from | default(['0.0.0.0/0'])) %}  - "{{ cidr }}"
{% endfor %}