# listen address and port for the DNS server (UDP/TCP)
listen_addr: "{{ listen_addr }}"
listen_port: {{ listen_port }}

# maximum UDP packet size (RFC 1035 recommends 512)
max_udp_size: {{ max_udp_size }}

# enable TCP fallback (required for large responses, DOH/DOQ)
tcp_enabled: {{ tcp_enabled }}

# upstream DNS servers to forward queries to
upstream_servers:
{% for server in upstream_servers %}  - "{{ server }}"
{% endfor %}

# domain → upstream servers mapping (split-horizon or per-domain routing)
# Each entry specifies a domain suffix and optional fallback upstream servers
forward_zones:
{% for zone in forward_zones %}  - domain: "{{ zone.domain }}"
    upstreams:
{% for up in zone.upstreams | default([]) %}      - "{{ up }}"
{% endfor %}
{% endfor %}

# local record overrides (static responses for specific domains)
# Useful for internal services, containers, or development
local_records:
{% for rec in local_records %}  - domain: "{{ rec.domain }}"
    type: "{{ rec.type }}"
    data: "{{ rec.data }}"
{% endfor %}

# TTL (in seconds) for cached and local responses
default_ttl: {{ default_ttl }}

# cache size (number of entries); 0 disables caching
cache_size: {{ cache_size }}

# logging level: debug, info, warn, error
log_level: "{{ log_level }}"

# file path for access logs (empty = stdout)
log_file: "{{ log_file }}"

# enable DNSSEC validation (requires upstream supporting DNSSEC)
dnssec_enabled: {{ dnssec_enabled }}

# path to trusted anchor file (e.g., KSK-2017.json for ICANN root)
trust_anchor_file: "{{ trust_anchor_file }}"

# enable EDNS Client Subnet (ECS) support
dns_ecs_enabled: {{ dns_ecs_enabled }}

# optional: restrict queries to these networks (CIDR list)
allow_from:
{% for cidr in allow_from %}  - "{{ cidr }}"
{% endfor %}
