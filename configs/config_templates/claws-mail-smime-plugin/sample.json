{
  "verify_signed_on_recv": true,
  "decrypt_on_recv": true,
  "ca_dir": "/usr/share/ca-certificates",
  "cert_dir": "~/.claws-mail/certs",
  "extra_cert_dirs": [
    "/etc/ssl/certs/java",
    "/usr/local/share/certs"
  ],
  "show_cert_info": false,
  "ldap_cert_lookup": false,
  "ldap_url": "ldap://ldap.example.com:389/o=Example%20Org,c=US?certificateRevocationList,cACertificate?sub?(&(objectClass=certificationAuthority)(certificateRevocationList=*))"
}
