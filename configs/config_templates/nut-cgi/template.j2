# Network UPS Tools: hosts.conf for CGI programs (upsstats, upsimage, upsset)
#
# This file defines the UPS systems that the NUT CGI scripts are allowed to
# monitor. Each entry consists of a MONITOR directive followed by the system
# identifier (name@host) and a human-readable description in quotes.
#
# Syntax: MONITOR <system_identifier> "<host_description>"
#
# <system_identifier> is typically formatted as <ups_name>@<ups_host>.

# MONITOR entry for the primary/local UPS system.
# {{ ups_system | default('myups@localhost') }} is the system identifier.
MONITOR {{ ups_system | default('myups@localhost') }} "{{ ups_host_description | default('Local UPS') }}"

# MONITOR entry for the secondary UPS system (e.g., finance department).
# {{ ups_system_2 | default('su2200@10.64.1.1') }} is the system identifier.
MONITOR {{ ups_system_2 | default('su2200@10.64.1.1') }} "{{ ups_host_description_2 | default('Finance department') }}"

# MONITOR entry for the tertiary UPS system (e.g., school data room).
# {{ ups_system_3 | default('matrix@shs-server.example.edu') }} is the system identifier.
MONITOR {{ ups_system_3 | default('matrix@shs-server.example.edu') }} "{{ ups_host_description_3 | default('Sierra High School data room #1') }}"