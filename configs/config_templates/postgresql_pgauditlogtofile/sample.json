{
  "log_directory": "/var/log/postgresql/pgaudit",
  "log_filename": "pgaudit-%Y%m%d_%H%M%S_%U.log",
  "log_rotation_age": 86400,
  "log_rotation_size": 10240,
  "log_rotation_max_files": 7,
  "log_compression": true,
  "min_messages": "LOG",
  "debug_redirector": false,
  "audit_events": [
    "read",
    "write",
    "ddl",
    "function",
    "role"
  ],
  "exclude_roles": [
    "rds_admin",
    "cloud_admin"
  ],
  "exclude_schemas": [
    "pg_catalog",
    "information_schema"
  ],
  "log_file_mode": 420,
  "log_file_owner": "postgres",
  "log_file_group": "postgres",
  "max_log_writers": 2,
  "enabled": true
}
