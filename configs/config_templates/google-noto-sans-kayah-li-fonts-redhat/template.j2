<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  Fontconfig configuration for Noto Sans Kayah Li.
  This template injects the specific font as the preferred replacement for
  the generic sans-serif family and optionally enables font hinting.
-->
<fontconfig>
  <!--
    Match block: Intercepts font requests for the generic sans-serif family.
    Prioritizes the Noto Sans Kayah Li font above all others.
  -->
  <match>
    <test name="family">
      <!-- The generic font family alias to intercept (default: sans-serif) -->
      <string>{{ sans_serif_family | default('sans-serif') }}</string>
    </test>
    <edit name="family" mode="prepend">
      <!-- The specific font family name to be prioritized (default: Noto Sans Kayah Li) -->
      <string>{{ font_family_name | default('Noto Sans Kayah Li') }}</string>
    </edit>
    <edit name="fonthashint" mode="append">
      <!-- Enable font hinting to improve readability at small sizes (default: false) -->
      <bool>{{ fonthashint_value | default('false') }}</bool>
    </edit>
  </match>

  <!--
    Alias block: Defines the font substitution order.
    If Noto Sans Kayah Li is not installed, it falls back to the generic sans-serif.
  -->
  <alias>
    <family>{{ font_family_name | default('Noto Sans Kayah Li') }}</family>
    <default>
      <family>{{ sans_serif_family | default('sans-serif') }}</family>
    </default>
  </alias>
</fontconfig>
