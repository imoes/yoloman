# GDB Remote Server configuration file
# ================================
# This template configures `gdbserver`, the GNU Debugger remote server.
# It allows a local or remote debugger (gdb) to connect to a target process
# for debugging purposes.
#
# Variables used:
#   - host: Address to bind the listener.
#   - port: Port number for the listener.
#   - extended_remote: Mode of operation (extended remote protocol).
#   - attach_pid: PID to attach to instead of exec-ing a new program.
#   - processes: List of processes for multi-mode debugging.
#   - extra_args: Additional CLI flags for gdbserver.

# IP address or hostname to bind the gdbserver to.
# Use '0.0.0.0' to listen on all interfaces (not recommended for untrusted networks).
# Default: '127.0.0.1'
bind_address: {{ host | default('127.0.0.1') }}

# TCP port number for gdbserver to listen on.
# Must be between 1 and 65535.
# Default: 2345
port: {{ port | default(2345) }}

# Enable extended-remote mode.
# Allows the debugger to attach/detach without restarting the target.
# Recommended for most debugging scenarios.
# Default: True
extended_remote: {{ extended_remote | default(true) | lower }}

# Process ID (PID) to attach to instead of launching a new program.
# If set, the 'program' argument is ignored.
# Set to null or omit to launch a new program.
# Note: Using 'omit' as a string value in a YAML key-value pair is invalid;
# we conditionally emit the key only if a value is provided.
{% if attach_pid is defined and attach_pid is not none %}
attach_pid: {{ attach_pid | default(omit) }}
{% endif %}

# List of processes to manage or attach to in multi-mode (for advanced orchestration).
# Each entry specifies a process by name and optional PID.
# Default: [] (empty list)
{% if processes is defined and processes is iterable and (processes | length) > 0 %}
processes:
{% for proc in processes %}
  # Process: {{ proc.name | default('unnamed') }}
  # PID: {{ proc.pid | default('auto') }}
  - name: {{ proc.name | default('unnamed') }}
{%   if proc.pid is defined and proc.pid is not none %}
    pid: {{ proc.pid | default(omit) }}
{%   endif %}
{% endfor %}
{% endif %}

# Optional: extra command-line arguments to pass directly to gdbserver.
# Examples: '--no-stop' (do not stop at entry), '--wrapper' (use an interpreter).
# Default: [] (empty list)
{% if extra_args is defined and extra_args is iterable and (extra_args | length) > 0 %}
extra_args:
{% for arg in extra_args %}
  # Arg: {{ arg }}
  - {{ arg }}
{% endfor %}
{% endif %}