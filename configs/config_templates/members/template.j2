# Members group membership configuration
# This template manages group membership settings for a Unix/Linux group.
# It handles both primary and secondary (extra) members of the group.
#
# Schema Notes:
# - `primary_members`: List of primary group members. Default is empty.
# - `secondary_members`: List of secondary/extra group members. Default is empty.
# These fields are typically used by tools like `chfn` or group management scripts.
# The rendered output is a plain list of usernames, one per line.

# Primary members of the group
# Each member listed in `primary_members` will appear here.
{% for member in primary_members | default([]) %}
{{ member }}
{% endfor %}

# Secondary members of the group
# Each member listed in `secondary_members` will appear here.
{% for member in secondary_members | default([]) %}
{{ member }}
{% endfor %}