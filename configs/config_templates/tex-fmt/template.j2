# Configuration file for tex-fmt (LaTeX formatter)
# Path to the configuration file itself is passed via --config flag

# Line length for wrapping long lines (default: 80)
# Corresponds to -l, --wraplen
wraplen: {{ wraplen | default(80) }}

# Number of characters to use as tab size (default: 2)
# Corresponds to -t, --tabsize
tabsize: {{ tabsize | default(2) }}

# Use tabs instead of spaces for indentation (default: False)
# Corresponds to --usetabs
usetabs: {{ usetabs | default(False) | lower }}

# Do not wrap long lines (default: False)
# Corresponds to -n, --nowrap
nowrap: {{ nowrap | default(False) | lower }}

# Show info messages (default: False)
# Corresponds to -v, --verbose
verbose: {{ verbose | default(False) | lower }}

# Hide warning messages (default: False)
# Corresponds to -q, --quiet
quiet: {{ quiet | default(False) | lower }}

# Show trace messages (default: False)
# Corresponds to --trace
trace: {{ trace | default(False) | lower }}

# List of files or patterns to format
# Corresponds to [files] positional arguments
# Note: This template generates the config structure; the actual file list
# is typically passed on the command line or handled by the invoking script.
# Based on standard CLI tools, target files are arguments, not config keys.
# Therefore, we exclude 'files' from the config file as per typical conventions.