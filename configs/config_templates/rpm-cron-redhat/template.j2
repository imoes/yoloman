# Log rotation configuration for rpmpkgs log files
# Managed by rpm-cron-redhat role
#
# This block defines how /var/log/rpmpkgs is rotated.
# See logrotate.conf(5) for directive details.

/var/log/rpmpkgs {
    # Rotation frequency: How often the log file is rotated.
    # Valid values: daily, weekly, monthly, yearly.
    # Default: weekly
    {{ rotation_frequency | default('weekly') }}

    # Do not rotate if the log file is empty.
    notifempty

    # Do not produce an error if the log file is missing.
    missingok
}
