# PDN-GW (PGW) configuration for nextepc-pgw
# Auto-generated by Ansible. Do not edit manually.

# =============================================================================
# Logging configuration
# =============================================================================
log:
  # Log verbosity level. Use DEBUG for troubleshooting, INFO for normal operation.
  level: "{{ pgw_log_level | default('INFO') }}"
  # Path to PGW log file, or 'stdout' to log to console.
  file: "{{ pgw_log_file | default('/var/log/nextepc/pgw.log') }}"

# =============================================================================
# PGW identity and realm
# =============================================================================
identity:
  # Fully Qualified Domain Name (FQDN) of the PGW used in Diameter messages.
  fqdn: "{{ pgw_identity_fqdn | default('pgw.mnc001.mcc001.3gppnetwork.org') }}"
  # Diameter realm of the PGW (typically same as MNC/MCC domain).
  realm: "{{ pgw_identity_realm | default('mnc001.mcc001.3gppnetwork.org') }}"

# =============================================================================
# MME/SGW peer configuration — S5/S8 to SGW (used for handover and session management)
# =============================================================================
mme:
  # List of MMEs/SGWs to connect to (via S5/S8).
  peers:
    {% for peer in pgw_mme_peers | default([]) %}
    - fqdn: "{{ peer.fqdn | default('') }}"
      address: "{{ peer.address | default('') }}"
      {% if peer.ipv6_address is defined and peer.ipv6_address %}
      ipv6_address: "{{ peer.ipv6_address }}"
      {% endif %}
    {% endfor %}

# =============================================================================
# APN configuration — list of supported APNs
# =============================================================================
apn:
  {% for apn in pgw_apn_list | default([]) %}
  - name: "{{ apn.name | default('') }}"
    # QoS profile for this APN (used for defaultbearer and dedicatedbearers)
    qos:
      # QoS Class Identifier (QCI)
      qci: {{ apn.qos.qci | default(9) }}
      # Allocation and Retention Priority (ARP)
      arp:
        # Priority level (1-15, lower is higher priority)
        priority_level: {{ apn.qos.arp.priority_level | default(10) }}
        # Preemption capability (enabled/disabled)
        preemption_cap: {{ apn.qos.arp.preemption_cap | default('enabled') | lower }}
        # Preemption vulnerability (enabled/disabled)
        preemption_vuln: {{ apn.qos.arp.preemption_vuln | default('enabled') | lower }}
    # UE address pool configuration
    {% if apn.ue is defined and apn.ue is mapping %}
    ue:
      {% if apn.ue.ipv4 is defined and apn.ue.ipv4 %}
      # IPv4 subnet to assign to users
      ipv4: "{{ apn.ue.ipv4 }}"
      {% endif %}
      {% if apn.ue.ipv6_prefix is defined and apn.ue.ipv6_prefix %}
      # IPv6 prefix to assign to users
      ipv6_prefix: "{{ apn.ue.ipv6_prefix }}"
      {% endif %}
    {% else %}
    # No UE address pool defined
    ue: {}
    {% endif %}
    # Optional: DNS server(s) for this APN
    {% if apn.dns is defined and apn.dns is mapping %}
    dns:
      {% if apn.dns.primary is defined and apn.dns.primary %}
      primary: "{{ apn.dns.primary }}"
      {% endif %}
      {% if apn.dns.secondary is defined and apn.dns.secondary %}
      secondary: "{{ apn.dns.secondary }}"
      {% endif %}
    {% endif %}
    # Optional: MTU (default: 1500)
    {% if apn.mtu is defined and apn.mtu %}
    mtu: {{ apn.mtu }}
    {% endif %}
  {% endfor %}

# =============================================================================
# Charging configuration (Gx/Gy)
# =============================================================================
charging:
  # Gx interface to PCRF (Policy and Charging Rules Function)
  {% if pgw_charging_gx_enabled | default(true) %}
  gx:
    # Diameter realm of the PCRF
    destination_realm: "{{ pgw_charging_gx_destination_realm | default('mnc001.mcc001.3gppnetwork.org') }}"
    # Diameter host (FQDN) of the PCRF
    destination_host: "{{ pgw_charging_gx_destination_host | default('pcrf.mnc001.mcc001.3gppnetwork.org') }}"
  {% endif %}
  # Gy interface to AAAR (Online Charging System)
  {% if pgw_charging_gy_enabled | default(false) %}
  gy:
    # Diameter realm of the AAAR
    destination_realm: "{{ pgw_charging_gy_destination_realm | default('mnc001.mcc001.3gppnetwork.org') }}"
    # Diameter host (FQDN) of the AAAR
    destination_host: "{{ pgw_charging_gy_destination_host | default('aaar.mnc001.mcc001.3gppnetwork.org') }}"
  {% endif %}

# =============================================================================
# System-wide limits
# =============================================================================
limits:
  # Maximum number of concurrent PDN connections (sessions) the PGW can handle.
  max_sessions: {{ pgw_limits_max_sessions | default(10000) }}
  # Maximum number of bearer connections allowed per UE (standard: 11).
  max_bearers_per_ue: {{ pgw_limits_max_bearers_per_ue | default(11) }}
  # Interval (seconds) for GTP-U echo requests; set to 0 to disable echo.
  gtpu_echo_interval: {{ pgw_limits_gtpu_echo_interval | default(30) }}