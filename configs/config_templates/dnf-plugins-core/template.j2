# ==============================================================================
# DNF Plugins Core - Fedora Copr Repository Configuration
# ==============================================================================
# This template configures the 'fedora-copr' plugin for DNF. It defines the
# connection parameters for the Fedora Copr hub where user-built RPM packages
# are hosted.
#
# Self-documenting fields (derived from schema defaults):
#   fedora_hostname: The domain name of the Copr instance.
#   fedora_protocol: The URL scheme (https or http).
#   fedora_port:     The network port for the API/Web server.
# ==============================================================================

[fedora]
# Hostname of the Fedora Copr hub
# Schema description: Hostname of the Fedora Copr hub
hostname = {{ fedora_hostname | default('copr.fedorainfracloud.org') }}

# Protocol used to connect to the Fedora Copr hub
# Schema description: Protocol used to connect to the Fedora Copr hub
protocol = {{ fedora_protocol | default('https') }}

# Port used to connect to the Fedora Copr hub
# Schema description: Port used to connect to the Fedora Copr hub
port = {{ fedora_port | default(443) }}

# ==============================================================================
# Adding Additional Copr Hubs
# ==============================================================================
# To add another Copr hub (e.g., a private instance or a different project),
# copy the section below, rename it to [your-hub-name], and adjust the values.
# Note: protocol and port are optional in the underlying config; if omitted,
# the defaults defined above (https, 443) are used.
#
# [name-of-hub]
# hostname = hub-hostname.example.com
# protocol = https
# port = 443
# ==============================================================================