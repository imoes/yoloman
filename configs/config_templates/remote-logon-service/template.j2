# ==============================================================================
# Remote Logon Service Configuration Template
# ==============================================================================
# This template generates the configuration for the Remote Logon Service,
# which acts as a client to a Session Broker. It defines which broker servers
# to connect to and provides metadata about the connection.
# ==============================================================================

[Remote Logon Service]
# Comma-separated list of server identifiers to connect to.
# Default: 'Session Broker'
Servers = {{ servers | default('Session Broker') }}

[Server Session Broker]
# Human-readable name for the session broker server.
# Default: 'Remote Logon'
Name = {{ name | default('Remote Logon') }}

# The URI endpoint for the Session Broker's ini file service.
# Default: 'http://localhost:8080/uccs/inifile/'
URI = {{ uri | default('http://localhost:8080/uccs/inifile/') }}