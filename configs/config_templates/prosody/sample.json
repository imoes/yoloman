{
  "bind_address": "*",
  "ports": [
    {
      "number": 5222
    },
    {
      "number": 5269
    },
    {
      "number": 5280,
      "address": "0.0.0.0"
    },
    {
      "number": 5281,
      "address": "127.0.0.1"
    }
  ],
  "ssl_protocol": "tlsv1_2+",
  "ssl_verify": true,
  "ssl_cafile": "/etc/prosody/certs/ca.pem",
  "virtual_hosts": [
    {
      "hostname": "example.com",
      "enabled": true
    },
    {
      "hostname": "chat.example.com",
      "enabled": true
    }
  ],
  "authentication": {
    "type": "internal",
    "passwords_path": "/var/lib/prosody/prosody.sqlite"
  },
  "data_path": "/var/lib/prosody",
  "log_levels": [
    {
      "name": "debug",
      "target": "/var/log/prosody/debug.log"
    },
    {
      "name": "info",
      "target": "info"
    },
    {
      "name": "warn",
      "target": "warn"
    },
    {
      "name": "error",
      "target": "error"
    }
  ],
  "modules_enabled": [
    {
      "name": "roster"
    },
    {
      "name": "saslauth"
    },
    {
      "name": "tls"
    },
    {
      "name": "dialback"
    },
    {
      "name": "disco"
    },
    {
      "name": "admin_shell",
      "options": {
        "allowed_users": [
          "admin@example.com"
        ],
        "allow_from": [
          "127.0.0.1"
        ]
      }
    },
    {
      "name": "muc",
      "options": {
        "default_room_history_length": 20
      }
    }
  ],
  "allow_registration": false,
  "max_idle_time": 300,
  "max_stanza_size": 65536,
  "s2s_ports": [
    {
      "number": 5269
    }
  ],
  "s2s_require_encryption": true,
  "s2s_ssl": {
    "protocol": "tlsv1_2+",
    "verify": false
  },
  "trusted_proxies": [
    "10.0.0.5",
    "192.168.1.0/24"
  ]
}
