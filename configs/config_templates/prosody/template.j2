# Listen on all interfaces for incoming connections
bind_address = "{{ bind_address }}"

# Port configuration for clients (XMPP, HTTP, etc.)
ports = [
{% for port in ports %}  {{ port.number }}{% if port.address %}{{ "@" + port.address }}{% endif %}
{% endfor %}]

# Enable or disable legacy SSL/TLS (not recommended; use starttls instead)
ssl = {
  protocol = "{{ ssl_protocol }}",
  verify = {% if ssl_verify %}true{% else %}false{% endif %},
  cafile = "{{ ssl_cafile }}"
}

# Virtual host definitions (each is an instance of an XMPP domain)
VirtualHost "{{ virtual_hosts[0].hostname }}"{% if virtual_hosts[0].enabled %}
{% else %}
  -- disabled
{% endif %}
{% for host in virtual_hosts[1:] %}
VirtualHost "{{ host.hostname }}"{% if host.enabled %}
{% else %}
  -- disabled
{% endif %}
{% endfor %}

# Authentication backend and credentials storage
authentication = "{{ authentication.type }}"

# If using external auth, specify auth parameters
{% if authentication.type == "cram-md5" or authentication.type == "plain" or authentication.type == "digest-md5" %}
passwords_path = "{{ authentication.passwords_path }}"
{% endif %}

# Data storage directory
data_path = "{{ data_path }}"

# Logging configuration
log = {
  levels = {
{% for level in log_levels %}    ["{{ level.name }}"] = "{{ level.target }}"{% if not loop.last %},{% endif %}
{% endfor %}  }
}

# Module loading and configuration
modules_enabled = [
{% for module in modules_enabled %}  "{{ module.name }}"{% if module.options %}
    -- Options:
    -- {% for key, val in module.options | dictsort %}{{ key }} = {{ val | tojson }}{% if not loop.last %}, {% endif %}
    -- {% endfor %}
{% endif %}
{% endfor %}]

# Module-specific configuration
{% for module in modules_enabled %}{% if module.options %}
modules_{{ module.name }} = {
{% for key, val in module.options | dictsort %}  {{ key }} = {{ val | tojson }}{% if not loop.last %},{% endif %}
{% endfor %}
}
{% endif %}{% endfor %}

# Allow or deny specific IP ranges (optional, default: all)
allow_registration = {% if allow_registration %}true{% else %}false{% endif %}

# Max idle time (in seconds) for client connections
max_idle_time = {{ max_idle_time }}

# Max stanzas in queue per connection
max_stanza_size = {{ max_stanza_size }}

# Server-to-server (S2S) communication settings
s2s = {
  ports = [
{% for port in s2s_ports %}    {{ port.number }}{% if port.address %}{{ "@" + port.address }}{% endif %}
{% endfor %}  ],
  require_encryption = {% if s2s_require_encryption %}true{% else %}false{% endif %},
  ssl = {
    protocol = "{{ s2s_ssl.protocol }}",
    verify = {% if s2s_ssl.verify %}true{% else %}false{% endif %}
  }
}

# Trusted IPs (e.g., for MUC service or external components)
trusted_proxies = [
{% for proxy in trusted_proxies %}  "{{ proxy }}"{% if not loop.last %},{% endif %}
{% endfor %}]
