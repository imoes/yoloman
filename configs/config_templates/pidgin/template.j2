# Pidgin Configuration Template
# This template generates a simplified INI-style representation of Pidgin's XML-based configuration.
# It is intended for automation and configuration management of Pidgin preferences and accounts.
# Note: Real Pidgin uses XML files (prefs.xml, accounts.xml) in the config directory.

[global]
# The directory where Pidgin stores its configuration files (e.g., ~/.purple)
config_dir = {{ config_dir | default('/home/user/.purple') }}

# Print debugging messages to stdout for troubleshooting
debug_enabled = {{ debug_enabled | default(false) | lower }}

# Try to be online even if the network is reported to be unavailable
force_online = {{ force_online | default(false) | lower }}

# Allow multiple instances of Pidgin to run simultaneously
multiple_instances = {{ multiple_instances | default(false) | lower }}

# Don't automatically login when Pidgin starts
no_autologin = {{ no_autologin | default(false) | lower }}

[interface]
# Show a Pidgin icon in the notification area (system tray)
show_system_tray = {{ show_system_tray | default(true) | lower }}

# Hide new IM messages until the user explicitly views them
hide_new_im = {{ hide_new_im | default(false) | lower }}

# Show IM and chat sessions in windows with multiple tabs
tabbed_windows = {{ tabbed_windows | default(true) | lower }}

# Show close buttons on conversation tabs
show_close_buttons = {{ show_close_buttons | default(true) | lower }}

[conversations]
# Enable animation for buddy icons if they are animated
enable_buddy_animation = {{ enable_buddy_animation | default(true) | lower }}

# Notify buddies that you are typing to them
typing_notifications = {{ typing_notifications | default(true) | lower }}

[logging]
# Specify how to log messages ('html' or 'text')
log_format = {{ log_format | default('html') }}

# Log all instant messages
log_all_im = {{ log_all_im | default(true) | lower }}

# Log all chat conversations
log_all_chats = {{ log_all_chats | default(false) | lower }}

# Log all status changes to the system log
log_status_changes = {{ log_status_changes | default(true) | lower }}

[accounts]
# List of account configurations managed by Pidgin
{% for account in accounts | default([]) %}
# Account: {{ account.protocol | default('unknown') }} - {{ account.username | default('unknown') }}
account_{{ loop.index }}_protocol = {{ account.protocol | default('unknown') }}
account_{{ loop.index }}_username = {{ account.username | default('unknown') }}
account_{{ loop.index }}_enabled = {{ account.enabled | default(true) | lower }}
account_{{ loop.index }}_remember_password = {{ account.remember_password | default(false) | lower }}
{% endfor %}