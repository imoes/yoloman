# Bash auto-completion script written for lv2info and lv2jack.
# Could be adapted to any other program that takes an
# LV2 plugin URI as parameter.

# {# lilv_completion_email: Email address of the Lilv updater in the comment header. #}
# {# lilv_completion_date: Date of the Lilv update in the comment header. #}
{% if lilv_completion_email is defined and lilv_completion_email is not none and (lilv_completion_email is number or lilv_completion_email is boolean or lilv_completion_email | length > 0) %}
# Updated for Lilv by David Robillard <{{ lilv_completion_email }} on {{ lilv_completion_date | default('2012-01-08') }}.
{% else %}
# Updated for Lilv by David Robillard <d@drobilla.net> on 2012-01-08.
{% endif %}

# {# lilv_completion_author_email: Email address of the original author in the comment header. #}
# {# lilv_completion_author_date: Date of the original author in the comment header. #}
{% if lilv_completion_author_email is defined and lilv_completion_author_email is not none and (lilv_completion_author_email is number or lilv_completion_author_email is boolean or lilv_completion_author_email | length > 0) %}
# Written by Lars Luthman <{{ lilv_completion_author_email }} on {{ lilv_completion_author_date | default('2009-10-12') }}.
{% else %}
# Written by Lars Luthman <lars.luthman@gmail.com> on 2009-10-12.
{% endif %}
# No copyright claimed for this script. Do what you want with it.

# For some reason Bash splits the command line not only at whitespace
# but also at ':' signs before putting the parts into COMP_WORDS.
# Since ':' is used in all URIs, which are what we want to complete,
# we have to put the URI back together before we can complete it
# and then cut off the parts we prepended from the completions.
# It probably breaks in some special cases but for most common uses
# it should work fine.

function _lv2info() {
    local uri cur opts w wn raw_reply len type
    opts=`lv2ls | xargs -n1 echo -n " "`
    
    # This is the last "word", as split by Bash.
    cur="${COMP_WORDS[COMP_CWORD]}"
    w="$cur"
    
    # Add the previous word while it or this one is a word break character
    for i in `seq $(( $COMP_CWORD - 1 )) -1 1`; do
	wn="${COMP_WORDS[i]}"
	if expr "$COMP_WORDBREAKS" : ".*$wn" > /dev/null; then
	    if expr "$COMP_WORDBREAKS" : ".*$w" > /dev/null; then
		break
	    fi
	fi
	w="$wn"
	uri="$w$uri"
    done
    
    # Check the length of the words we prepend
    len=${#uri}
	uri="$uri$cur"
    raw_reply="$(compgen -W "${opts}" -- ${uri})"
    
    # If we are listing alternatives, just print the full URIs.
    type=`echo $COMP_TYPE | awk '{ printf "%c", $1 }'`
    if expr "?!@%" : ".*$type" > /dev/null; then
	COMPREPLY=( $raw_reply )
	return 0
    fi
    
    # Otherwise, strip the prepended words from all completion suggestions.
    COMPREPLY=()
    for i in $raw_reply; do
	COMPREPLY=( ${COMPREPLY[@]} ${i:len} )
    done
}

# {# lilv_completion_cmd1: First command name to complete. #}
complete -F _lv2info {{ lilv_completion_cmd1 | default('lv2info') }}

# {# lilv_completion_cmd2: Second command name to complete. #}
{% if lilv_completion_cmd2 is defined and lilv_completion_cmd2 is not none and (lilv_completion_cmd2 is number or lilv_completion_cmd2 is boolean or lilv_completion_cmd2 | length > 0) %}
And the same for {{ lilv_completion_cmd2 }}.
{% else %}
# And the same for lv2jack.
{% endif %}
complete -F _lv2info {{ lilv_completion_cmd2 | default('lv2jack') }}
