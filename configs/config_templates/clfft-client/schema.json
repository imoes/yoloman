{
  "device": {
    "type": "string",
    "default": "none",
    "description": "Device selection: 'gpu', 'cpu', 'all', or 'none' (auto-select)",
    "enum": [
      "gpu",
      "cpu",
      "all",
      "none"
    ]
  },
  "precision": {
    "type": "string",
    "default": "single",
    "description": "Transform precision: 'single' or 'double'",
    "enum": [
      "single",
      "double"
    ]
  },
  "direction": {
    "type": "string",
    "default": "forward",
    "description": "Transform direction: 'forward' or 'backward'",
    "enum": [
      "forward",
      "backward"
    ]
  },
  "placement": {
    "type": "string",
    "default": "inplace",
    "description": "Transform placement: 'inplace' or 'outofplace'",
    "enum": [
      "inplace",
      "outofplace"
    ]
  },
  "dump_kernels": {
    "type": "bool",
    "default": false,
    "description": "Whether to dump generated OpenCL kernels to disk"
  },
  "layout": {
    "type": "object",
    "default": null,
    "description": "Input and output data layout (interleaved, planar, etc.)"
  },
  "layout.input": {
    "type": "string",
    "default": "interleaved",
    "description": "Input layout: 'interleaved', 'planar', 'hermitian_interleaved', 'hermitian_planar', or 'real'",
    "enum": [
      "interleaved",
      "planar",
      "hermitian_interleaved",
      "hermitian_planar",
      "real"
    ]
  },
  "layout.output": {
    "type": "string",
    "default": "interleaved",
    "description": "Output layout: 'interleaved', 'planar', 'hermitian_interleaved', 'hermitian_planar', or 'real'",
    "enum": [
      "interleaved",
      "planar",
      "hermitian_interleaved",
      "hermitian_planar",
      "real"
    ]
  },
  "dimensions.size": {
    "type": "object",
    "default": null,
    "description": "FFT dimension sizes (x, y, z)"
  },
  "dimensions.size.x": {
    "type": "number",
    "default": 1024,
    "description": "Length of the 1st dimension (default: 1024)"
  },
  "dimensions.size.y": {
    "type": "number",
    "default": 1,
    "description": "Length of the 2nd dimension (default: 1)"
  },
  "dimensions.size.z": {
    "type": "number",
    "default": 1,
    "description": "Length of the 3rd dimension (default: 1)"
  },
  "dimensions.input_stride": {
    "type": "object",
    "default": null,
    "description": "Input stride for x, y, z dimensions"
  },
  "dimensions.input_stride.x": {
    "type": "number",
    "default": 1,
    "description": "Input stride of 1st dimension (default: 1)"
  },
  "dimensions.input_stride.y": {
    "type": "number",
    "default": 0,
    "description": "Input stride of 2nd dimension (default: 0)"
  },
  "dimensions.input_stride.z": {
    "type": "number",
    "default": 0,
    "description": "Input stride of 3rd dimension (default: 0)"
  },
  "dimensions.output_stride": {
    "type": "object",
    "default": null,
    "description": "Output stride for x, y, z dimensions"
  },
  "dimensions.output_stride.x": {
    "type": "number",
    "default": 1,
    "description": "Output stride of 1st dimension (default: 1)"
  },
  "dimensions.output_stride.y": {
    "type": "number",
    "default": 0,
    "description": "Output stride of 2nd dimension (default: 0)"
  },
  "dimensions.output_stride.z": {
    "type": "number",
    "default": 0,
    "description": "Output stride of 3rd dimension (default: 0)"
  },
  "dimensions.distance": {
    "type": "object",
    "default": null,
    "description": "Batch distances (input and output)"
  },
  "dimensions.distance.input": {
    "type": "number",
    "default": 0,
    "description": "Input batch distance (default: 0)"
  },
  "dimensions.distance.output": {
    "type": "number",
    "default": 0,
    "description": "Output batch distance (default: 0)"
  },
  "batch_size": {
    "type": "number",
    "default": 1,
    "description": "Number of transforms in a batch (default: 1)"
  },
  "profiling": {
    "type": "number",
    "default": 0,
    "description": "Number of runs to profile (0 = profiling off, default: 1 in CLI, 0 for config)"
  }
}
