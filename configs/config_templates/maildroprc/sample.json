{
  "default_home": "/home",
  "default_quota": "1073741824",
  "syslog_logfile": "/var/log/maildrop.log",
  "syslog_logging": true,
  "verbose": false,
  "max_message_size": 52428800,
  "max_recipients": 50,
  "filter_pre": "/usr/bin/clamdscan --fdpass -",
  "filter_post": "/usr/bin/spamc -f",
  "trusted_ips": [
    {
      "ip": "127.0.0.1",
      "description": "Localhost"
    },
    {
      "ip": "10.0.0.0/8",
      "description": "Internal LAN"
    },
    {
      "ip": "::1",
      "description": "IPv6 localhost"
    }
  ],
  "relay_hosts": [
    {
      "host": "smtp.example.com",
      "port": 587,
      "use_tls": true,
      "auth_user": "maildrop",
      "auth_pass": "secret"
    },
    {
      "host": "backup-smtp.example.org",
      "port": 25,
      "use_tls": false
    }
  ],
  "delivery_method": "maildir",
  "maildir_path": ".maildir",
  "maildirpp_enabled": true,
  "mbox_path": "/var/spool/mail/{user}",
  "custom_delivery_path": "",
  "delivery_timeout": 600,
  "retry_max": 4,
  "retry_delay": 120,
  "dns_lookup": true,
  "dns_fallback": "mail.example.com"
}
