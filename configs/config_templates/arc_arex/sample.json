{
  "server_hostname": "arc.example.org",
  "server_port": 443,
  "rest_enabled": true,
  "websocket_enabled": false,
  "max_jobs": 5000,
  "job_state_path": "/var/lib/arc/jobstate",
  "job_output_path": "/var/spool/arc/joboutput",
  "worker_threads": 32,
  "auth_method": "gcc",
  "gridftp_enabled": true,
  "gridftp_ports": [
    2811,
    50000,
    51000
  ],
  "job_managers": [
    {
      "name": "local_fork",
      "resource": "localhost",
      "manager": "fork",
      "queue": ""
    },
    {
      "name": "slurm_cluster",
      "resource": "scheduler.cluster.local",
      "manager": "slurm",
      "queue": "batch",
      "workdir": "/tmp/arc_slurm"
    }
  ],
  "log_level": "info"
}
