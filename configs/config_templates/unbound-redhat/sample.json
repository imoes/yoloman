{
  "verbosity": 1,
  "statistics_interval": 0,
  "statistics_cumulative": false,
  "extended_statistics": true,
  "num_threads": 4,
  "interface_automatic": false,
  "outgoing_port_permit": "32768-60999",
  "outgoing_port_avoid_1": "0-32767",
  "outgoing_port_avoid_2": "61000-65535",
  "so_reuseport": true,
  "ip_transparent": true,
  "max_udp_size": 3072,
  "edns_tcp_keepalive": true,
  "chroot": "",
  "username": "unbound",
  "directory": "/etc/unbound",
  "log_time_ascii": true,
  "pidfile": "/var/run/unbound/unbound.pid",
  "harden_glue": true,
  "harden_dnssec_stripped": true,
  "harden_below_nxdomain": true,
  "harden_referral_path": true,
  "qname_minimisation": true,
  "aggressive_nsec": true,
  "unwanted_reply_threshold": 10000000,
  "prefetch": true,
  "prefetch_key": true,
  "deny_any": true,
  "rrset_roundrobin": true,
  "minimal_responses": true,
  "module_config": "ipsecmod validator iterator",
  "trust_anchor_signaling": true,
  "root_key_sentinel": true,
  "trusted_keys_file": "/etc/unbound/keys.d/*.key",
  "auto_trust_anchor_file": "/var/lib/unbound/root.key",
  "val_clean_additional": true,
  "val_permissive_mode": false,
  "serve_expired": true,
  "serve_expired_ttl": 14400,
  "val_log_level": 1,
  "tls_ciphers": "\"PROFILE=SYSTEM\"",
  "ipsecmod_enabled": false,
  "ipsecmod_hook": "/usr/libexec/ipsec/_unbound-hook",
  "control_enable": true
}
