{
  "verbosity": {
    "type": "number",
    "default": 1,
    "description": "Verbosity level."
  },
  "statistics_interval": {
    "type": "number",
    "default": 0,
    "description": "Interval for statistics to log. 0 to disable."
  },
  "statistics_cumulative": {
    "type": "string",
    "default": "no",
    "description": "Enable cumulative statistics."
  },
  "extended_statistics": {
    "type": "string",
    "default": "yes",
    "description": "Enable extended statistics."
  },
  "num_threads": {
    "type": "number",
    "default": 4,
    "description": "Number of threads."
  },
  "interface_automatic": {
    "type": "string",
    "default": "no",
    "description": "Enable automatic interface selection."
  },
  "outgoing_port_permit": {
    "type": "string",
    "default": "32768-60999",
    "description": "Permit outgoing port range."
  },
  "outgoing_port_avoid_1": {
    "type": "string",
    "default": "0-32767",
    "description": "Avoid outgoing port range 1."
  },
  "outgoing_port_avoid_2": {
    "type": "string",
    "default": "61000-65535",
    "description": "Avoid outgoing port range 2."
  },
  "so_reuseport": {
    "type": "string",
    "default": "yes",
    "description": "Enable SO_REUSEPORT."
  },
  "ip_transparent": {
    "type": "string",
    "default": "yes",
    "description": "Enable IP_TRANSPARENT."
  },
  "max_udp_size": {
    "type": "number",
    "default": 3072,
    "description": "Maximum UDP response size."
  },
  "edns_tcp_keepalive": {
    "type": "string",
    "default": "yes",
    "description": "Enable EDNS TCP keepalive."
  },
  "chroot": {
    "type": "string",
    "default": "",
    "description": "Chroot directory. Empty string means no chroot."
  },
  "username": {
    "type": "string",
    "default": "unbound",
    "description": "User to drop privileges to."
  },
  "directory": {
    "type": "string",
    "default": "/etc/unbound",
    "description": "Working directory."
  },
  "log_time_ascii": {
    "type": "string",
    "default": "yes",
    "description": "Print UTC timestamp in ASCII."
  },
  "pidfile": {
    "type": "string",
    "default": "/var/run/unbound/unbound.pid",
    "description": "PID file path."
  },
  "harden_glue": {
    "type": "string",
    "default": "yes",
    "description": "Harden against out of zone rrsets."
  },
  "harden_dnssec_stripped": {
    "type": "string",
    "default": "yes",
    "description": "Harden against receiving dnssec-stripped data."
  },
  "harden_below_nxdomain": {
    "type": "string",
    "default": "yes",
    "description": "Harden against queries under dnssec-signed nxdomain names."
  },
  "harden_referral_path": {
    "type": "string",
    "default": "yes",
    "description": "Harden the referral path."
  },
  "qname_minimisation": {
    "type": "string",
    "default": "yes",
    "description": "Enable QNAME minimisation."
  },
  "aggressive_nsec": {
    "type": "string",
    "default": "yes",
    "description": "Enable aggressive NSEC."
  },
  "unwanted_reply_threshold": {
    "type": "number",
    "default": 10000000,
    "description": "Threshold for unwanted replies."
  },
  "prefetch": {
    "type": "string",
    "default": "yes",
    "description": "Enable prefetching of expired entries."
  },
  "prefetch_key": {
    "type": "string",
    "default": "yes",
    "description": "Enable prefetching of key lookups."
  },
  "deny_any": {
    "type": "string",
    "default": "yes",
    "description": "Deny ANY queries."
  },
  "rrset_roundrobin": {
    "type": "string",
    "default": "yes",
    "description": "Rotate RRSet order."
  },
  "minimal_responses": {
    "type": "string",
    "default": "yes",
    "description": "Minimize responses."
  },
  "module_config": {
    "type": "string",
    "default": "ipsecmod validator iterator",
    "description": "Module configuration string."
  },
  "trust_anchor_signaling": {
    "type": "string",
    "default": "yes",
    "description": "Enable trust anchor signaling."
  },
  "root_key_sentinel": {
    "type": "string",
    "default": "yes",
    "description": "Enable root key trust anchor sentinel."
  },
  "trusted_keys_file": {
    "type": "string",
    "default": "/etc/unbound/keys.d/*.key",
    "description": "Path to trusted keys file."
  },
  "auto_trust_anchor_file": {
    "type": "string",
    "default": "/var/lib/unbound/root.key",
    "description": "Path to auto trust anchor file."
  },
  "val_clean_additional": {
    "type": "string",
    "default": "yes",
    "description": "Clean additional section from unsecure data."
  },
  "val_permissive_mode": {
    "type": "string",
    "default": "no",
    "description": "Enable permissive mode."
  },
  "serve_expired": {
    "type": "string",
    "default": "yes",
    "description": "Serve expired responses."
  },
  "serve_expired_ttl": {
    "type": "number",
    "default": 14400,
    "description": "TTL limit for expired responses."
  },
  "val_log_level": {
    "type": "number",
    "default": 1,
    "description": "Validator log level."
  },
  "tls_ciphers": {
    "type": "string",
    "default": "\"PROFILE=SYSTEM\"",
    "description": "TLS ciphers configuration."
  },
  "ipsecmod_enabled": {
    "type": "string",
    "default": "no",
    "description": "Enable ipsecmod."
  },
  "ipsecmod_hook": {
    "type": "string",
    "default": "/usr/libexec/ipsec/_unbound-hook",
    "description": "Path to ipsecmod hook executable."
  },
  "control_enable": {
    "type": "string",
    "default": "yes",
    "description": "Enable remote control."
  }
}
