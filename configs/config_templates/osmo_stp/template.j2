# Osmocom SIGTRAN STP Configuration
# Generated by Ansible — see https://osmocom.org/projects/osmo-stp
# This template is self-documenting: every directive is preceded by a comment
# explaining its purpose and default value.

# === Global Settings ===

# Global timeout in seconds for signaling messages and link maintenance.
timeout {{ timeout | default(30) }}

# === Logging Configuration ===

# Absolute path to the log file. Ensure the osmocom user has write permissions.
log file {{ log_file_path | default('/var/log/osmo-stp.log') }}

  # Verbosity level of logging (e.g., debug, notice, error).
  level {{ log_level | default('debug') }}

  # Enable ANSI color codes in terminal output.
  # 1 = enabled, 0 = disabled.
  color {{ log_color | default(true) | ternary('1', '0') }}

  # Prefix log lines with timestamps.
  # 1 = enabled, 0 = disabled.
  timestamp {{ log_timestamp | default(true) | ternary('1', '0') }}

  # Custom prefix for each log line (e.g., subsystem tag).
  # Leave empty to use defaults.
  line_prefix {{ log_line_prefix | default('') }}

# === MTP3 User Part (SAP) Configuration ===
# This block configures the local Signaling Point Code (SPC) and Network Indicator.

mtp3-userpart {
  # SCCP user part (SAP) instance
  sccp-userpart {
    # Local Signaling Point Code (SPC) for this STP.
    # Must be unique in the network.
    local-spc {{ local_spc | default(1) }}

    # Mask for the local SPC.
    # Often 0xFF (255) for 8-bit SPCs, 0x3FFF for 14-bit.
    local-spc-mask {{ local_spc_mask | default(255) }}

    # Network Indicator (NI) per ITU-T Q.704:
    # 0=ISDN, 1=non-ISDN, 2=public, 3=private.
    network-indicator {{ network_indicator | default(2) }}
  }
}

# === SS7 Signaling Links Configuration ===

ss7 {
  # Point-to-point or point-to-multipoint.
  # If true: point-to-point links only.
  # If false: point-to-multipoint (multiple DPCs per linkset).
  {{ 'point-to-point' if point_to_point | default(true) else 'point-to-multipoint' }}

  # List of SS7 link sets (collections of links with shared routing context).
  {% for link_set in link_sets | default([]) %}
  linkset {{ link_set.id }} {
    # Name of the link set (for display only).
    name "{{ link_set.name | default('linkset-' + (link_set.id | default('unknown')) | string) }}"

    # Routing context (0 for standard use).
    routing-context {{ link_set.routing_context | default(0) }}

    # MTP3 destination point codes for this linkset.
    {% for dpc in link_set.dest_points | default([]) %}
    dest-point-code {{ dpc }}
    {% endfor %}

    # Individual links within this linkset.
    {% for link in link_set.links | default([]) %}
    link {{ link.id }} {
      # Name of the link.
      name "{{ link.name | default('link-' + (link.id | default('unknown')) | string) }}"

      # Local and remote IP/port for IP-based links.

      # Local IP address.
      local-ip {{ link.local_ip | default('0.0.0.0') }}

      # Local port.
      # If not specified, derives from link_set index or defaults to 3000 + offset.
      local-port {{ link.local_port | default(3000 + (loop.index0 | int) * 100) }}

      # Remote IP address.
      # Note: Assuming it is provided by the role logic.
      remote-ip {{ link.remote_ip | default('127.0.0.1') }}

      # Remote port.
      remote-port {{ link.remote_port | default(3000) }}

      # Link set ID (must match parent linkset.id).
      linkset {{ link_set.id }}

      # Link priority (for load sharing).
      priority {{ link.priority | default(1) }}

      # Payload type (MTP3 or ASP, typically MTP3 for STP).
      payload mtp3

      # Mode: client/server.
      # client = connects to remote; server = listens.
      mode {{ link.mode | default('client') }}
    }
    {% endfor %}
  }
  {% endfor %}
}

# === SCTP Association Configuration ===
# For IP-based signaling. Optional if using legacy SS7.

sctp {
  # Enable TCP fallback for SCTP.
  # Not recommended for SS7 interoperability, but sometimes used in hybrid deployments.
  tcp-fallback {{ 'true' if tcp_fallback | default(false) else 'false' }}
}

# === H.248/MEGACO Support ===
# Enable H.248/Megaco media gateway control support.
# Rarely needed for pure STP.
{% if h248_enabled | default(false) %}
# h248
{% else %}
# no-h248
{% endif %}

# === Statistics and Monitoring ===

stats {
  # Enable real-time statistics collection (MTP3/SCCP message counters).
  enable {{ 'true' if stats_enabled | default(true) else 'false' }}

  # Interval (seconds) between statistics dumps to log.
  interval {{ stats_interval | default(60) }}

  # Optional path to write periodic stats in JSON format.
  # If empty, stats are only in the main log.
  {% if stats_file | default('') %}
  file {{ stats_file }}
  {% endif %}
}

# === Management Interface (CTRL) ===
# TCP port for the control interface (used by osmo-stp-ctrl for runtime config and monitoring).

ctrl {
  # TCP port for CTRL interface.
  port {{ ctrl_port | default(4237) }}

  # Bind address for the control interface.
  # Use '0.0.0.0' only if secure access is guaranteed.
  bind {{ ctrl_bind | default('127.0.0.1') }}
}

# === IPA (IP Access) Support ===
# Used for BTS identification in OsmoBTS integration.

ipa {
  # IPA unit ID (used for BTS identification).
  unit-id {{ ipa_unit_id | default(1) }}

  # IPA clock identifier.
  # 0x21=33 (E1), 0x20=32 (PCM), per IPA spec.
  clock-id {{ ipa_clock_id | default(33) }}
}

# === NAT and Routing Rules ===
# Enable NAT-aware routing rules (advanced use; rarely needed).
{% if nat_rules_enabled | default(false) %}
# nat-rules
{% else %}
# no-nat-rules
{% endif %}

# End of configuration