# Osmocom SIGTRAN STP Configuration
# Generated by template — see https://osmocom.org/projects/osmo-stp

# Global settings
timeout {% if timeout %}{{ timeout }}{% else %}30{% endif %}

# Logging configuration
log file {{ log_file_path | default('/var/log/osmo-stp.log') }}
  level {{ log_level | default('debug') }}
  color {{ log_color | default('1') }}
  timestamp {{ log_timestamp | default('1') }}
  line_prefix {{ log_line_prefix | default('1') }}

# MTP3 user part (SAP) configuration
mtp3-userpart {
  # SCCP user part (SAP) instance
  sccp-userpart {
    # Local signaling point code (LSPC)
    local-spc {{ local_spc | default(1) }}
    
    # Local signaling point code mask (LSPC mask)
    local-spc-mask {{ local_spc_mask | default(255) }}
    
    # Network indicator for SCCP
    network-indicator {{ network_indicator | default(2) }}
  }
}

# SS7 signaling links
ss7 {
  # Point-to-point or point-to-multipoint (optional)
  {{ 'point-to-point' if point_to_point else 'point-to-multipoint' }}
  
  # Link sets
  {% for link_set in link_sets %}
  linkset {{ link_set.id }} {
    # Name (for display only)
    name "{{ link_set.name | default('linkset-' + link_set.id | string) }}"
    
    # Routing context (0 for standard use)
    routing-context {{ link_set.routing_context | default(0) }}
    
    # MTP3 destination point codes for this linkset
    {% for dpc in link_set.dest_points %}
    dest-point-code {{ dpc }}
    {% endfor %}
    
    # Links in this linkset
    {% for link in link_set.links %}
    link {{ link.id }} {
      name "{{ link.name | default('link-' + link.id | string) }}"
      
      # Local and remote IP/port for IP-based links (E1/T1 not yet supported in this template)
      local-ip {{ link.local_ip | default('0.0.0.0') }}
      local-port {{ link.local_port | default(3000 + loop.parent.loop.index0 * 100 }}
      remote-ip {{ link.remote_ip }}
      remote-port {{ link.remote_port | default(3000) }}
      
      # Link set ID (must match parent linkset.id)
      linkset {{ link_set.id }}
      
      # Link priority (for load sharing)
      priority {{ link.priority | default(1) }}
      
      # Payload (MTP3 or ASP, typically MTP3 for STP)
      payload mtp3
      
      # Mode: client/server (client = connects to remote; server = listens)
      mode {{ link.mode | default('client') }}
    }
    {% endfor %}
  }
  {% endfor %}
}

# SCTP association (for IP-based signaling; optional if using legacy SS7)
sctp {
  # Enable TCP fallback? (not recommended for SS7, but sometimes used in hybrid deployments)
  tcp-fallback {{ 'false' if not tcp_fallback else 'true' }}
}

# H.248/MEGACO support (optional; used in some media gateway control scenarios)
{{ '# h248' if h248_enabled else '# no-h248' }}

# Statistics and monitoring
stats {
  # Enable statistics collection
  enable {{ 'true' if stats_enabled else 'false' }}
  
  # Stats interval in seconds
  interval {{ stats_interval | default(60) }}
  
  # Stats output file (optional)
  {% if stats_file %}
  file {{ stats_file }}
  {% endif %}
}

# Management interface (OsmoMSC-style MTP / MGCP / IPA / CTRL)
ctrl {
  # TCP port for CTRL interface
  port {{ ctrl_port | default(4237) }}
  
  # Bind address
  bind {{ ctrl_bind | default('127.0.0.1') }}
}

# IPA (IP Access) support (e.g., for BTS integration)
ipa {
  # IPA unit ID (for BTS identification)
  unit-id {{ ipa_unit_id | default(1) }}
  
  # IPA clock ID (for sync, e.g., 0x21 = E1, 0x20 = PCM)
  clock-id {{ ipa_clock_id | default(33) }}
}

# NAT and routing rules (optional advanced use)
{{ '# nat-rules' if nat_rules_enabled else '# no-nat-rules' }}

# End of configuration
