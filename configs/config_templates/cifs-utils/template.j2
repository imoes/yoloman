# /etc/cifs.idmap
# This file is managed by Ansible.
#
# The `credentials` field specifies a list of CIFS credential entries.
# These are typically used in conjunction with mount points that require
# specific SMB/CIFS usernames and passwords for authentication.
# Note: cifs.idmap itself does not read credentials files directly; this
# configuration is often stored here for reference or consumed by a
# wrapper script/service that performs the mount.
#
# Example entry in a credentials file:
#   username=myuser
#   password=mypass

# List of CIFS credential entries.
{% set creds = credentials | default([]) %}
{% if creds %}
# Credentials configuration generated from schema field 'credentials'
{% for cred in creds %}
# --- Start Credential Entry ---
# Description: Credentials for a specific CIFS share authentication.
{% if cred.username is defined %}username={{ cred.username }}{% endif %}
{% if cred.password is defined %}password={{ cred.password }}{% endif %}
{% if cred.domain is defined %}domain={{ cred.domain }}{% endif %}
# --- End Credential Entry ---

{% endfor %}
{% else %}
# No credentials configured.
{% endif %}