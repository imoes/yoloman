{# ============================================================================== #}
{# doschk stdin input template                                                       #}
{#                                                                              #}
{# This template provides the list of files and directories to check to `doschk`. #}
{# `doschk` does NOT use a configuration file; it reads paths from stdin.         #}
{# Each path is emitted on its own line.                                          #}
{# ============================================================================== #}

{# List of file and directory paths to check.                                   #}
{# Default: empty list.                                                         #}
{% set _paths = paths | default([]) %}
{% if _paths | length > 0 %}
{%- for item in _paths %}
{{ item }}
{%- endfor %}
{% endif %}