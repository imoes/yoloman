# Configuration for ohcount
# See ohcount(1) for documentation.

# Output mode: 'summary' (default), 'annotate', 'detect', 'individual', 'license', or 'raw'
# Corresponds to -s, -a, -d, -i, -l, -re flags.
mode = {{ mode | default('summary') }}

# Paths to analyze. If empty, defaults to current directory.
{% for path in paths | default([]) %}
path = {{ path }}
{% endfor %}