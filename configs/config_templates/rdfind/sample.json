{
  "paths_to_scan": [
    "/data/photos",
    "/mnt/backup/photos"
  ],
  "ignore_empty": false,
  "min_size": 1024,
  "max_size": 104857600,
  "follow_symlinks": true,
  "remove_ident_inode": true,
  "checksum_algorithm": "sha256",
  "deterministic": true,
  "make_symlinks": false,
  "make_hardlinks": false,
  "make_results_file": true,
  "results_file_name": "duplicates_report.txt",
  "delete_duplicates": false,
  "sleep_ms": 10,
  "dry_run": true
}
