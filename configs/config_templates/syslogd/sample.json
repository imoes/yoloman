{
  "hostname": "webserver01.example.com",
  "log_dir": "/var/log",
  "include_kern_log": true,
  "include_mail_log": true,
  "include_daemon_log": true,
  "include_cron_log": true,
  "include_syslog_log": true,
  "include_messages": true,
  "debug_log_enabled": false,
  "emergency_wall": true,
  "remote_logging_enabled": true,
  "remote_host": "syslog.example.com",
  "remote_port": 514,
  "remote_protocol": "udp",
  "extra_rules": [
    {
      "selector": "local0.*",
      "action": "/var/log/app.log",
      "comment": "Application messages routed via the local0 facility"
    },
    {
      "selector": "local1.err",
      "action": "/var/log/app-errors.log",
      "comment": "Application error-level messages routed via the local1 facility"
    }
  ]
}
