Name[x-test]=xxGlobal Shortcutsxx
Name[zh_CN]=全局快捷键
Name[zh_TW]=全域快捷鍵

# Exec path to the kglobalacceld binary.
# This specifies the executable that runs when the entry is invoked.
# Default is the standard path for 64-bit Linux systems.
Exec={{ exec_path | default('/usr/lib/x86_64-linux-gnu/libexec/kglobalacceld') }}

# NoDisplay flag.
# If true, this application entry will not be shown in application menus or launchers.
# kglobalacceld is a background daemon, so it is typically hidden from user menus.
NoDisplay={{ node_display | default('true') }}

# OnlyShowIn.
# A semicolon-separated list of desktop environments where this application should appear.
# Restricts this entry to KDE-based environments.
OnlyShowIn={{ only_show_in | default('KDE;') }}

# X-systemd-skip flag.
# If true, systemd will skip loading this unit file.
# This is a KDE-specific extension to control systemd integration behavior.
X-systemd-skip={{ x_systemd_skip | default('true') }}
