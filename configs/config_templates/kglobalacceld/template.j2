# kglobalacceld.desktop
# Configuration file for the KDE Global Accels Daemon desktop entry.
# This file defines the application metadata and behavior for the system-wide
# keyboard shortcut handler in KDE Plasma.

[Desktop Entry]

# The full path to the kglobalacceld executable binary.
# Default: /usr/lib/x86_64-linux-gnu/libexec/kglobalacceld
Exec={{ exec_path | default('/usr/lib/x86_64-linux-gnu/libexec/kglobalacceld') }}

# If true, the application will not be shown in application menus.
# This is a daemon, so it typically should not appear in user menus.
# Default: true
NoDisplay={{ node_display | default(true) }}

# A semicolon-separated list of desktop environments where this application should appear.
# Since this is a KDE-specific component, it defaults to KDE only.
# Default: KDE
OnlyShowIn={{ only_show_in | default(['KDE']) | join(';') }}

# If true, systemd will skip this entry during initialization checks.
# Daemons often set this to true to avoid systemd treating the desktop file as a service unit.
# Default: true
X-systemd-skip={{ x_systemd_skip | default(true) }}