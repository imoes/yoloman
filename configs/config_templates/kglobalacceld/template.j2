# Global Shortcuts Service Desktop Entry
# This file registers the kglobalacceld component as an application entry in the desktop environment.
# It is primarily used by KDE Plasma to manage global keyboard shortcuts.

[Desktop Entry]

# Type of the desktop file. Always 'Application' for standard apps/services with UI/shell interaction.
Type=Application

# Name of the application in English.
# This is the fallback name if no localized translation is found.
Name=Global Shortcuts

# Localized names for the application in various languages.
# These are used by the desktop environment to display the name in the user's preferred language.
Name[ar]=اختصارات عامة
Name[ast]=Atayos globales
Name[bg]=Глобални клавишни комбинации
Name[ca]=Dreceres globals
Name[ca@valencia]=Dreceres globals
Name[cs]=Globální zkratky
Name[de]=Globale Kurzbefehle
Name[en_GB]=Global Shortcuts
Name[eo]=Ĉieaj Ŝparvojoj
Name[es]=Atajo de teclado globales
Name[eu]=Lasterbide globalak
Name[fa]=میان‌بر های چهانی
Name[fi]=Työpöydänlaajuiset pikanäppäimet
Name[fr]=Raccourcis globaux
Name[gl]=Atallos globales
Name[he]=קיצורי מקשים כללי
Name[hi]=वैश्विक शॉर्टकट
Name[hu]=Globális gyorsbillentyűk
Name[ia]=Vias Breve Global
Name[is]=Víðværir flýtilyklar
Name[it]=Scorciatoie globali
Name[ka]=გლობალური მალსახმობები
