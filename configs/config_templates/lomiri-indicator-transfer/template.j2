# Lomiri Indicator Transfer Desktop Entry
# This template generates a .desktop file for the Lomiri Indicator Transfer service.
# It configures the application's visibility, execution path, and autostart behavior.

[Desktop Entry]
# Type=Application
# Specifies that this entry represents a standard application.
Type=Application

# Name=Lomiri Indicator Transfer
# The display name of the application.
Name=Lomiri Indicator Transfer

# Exec=/usr/libexec/lomiri-indicator-transfer/lomiri-indicator-transfer-service
# Path to the service executable.
Exec={{ executible_path | default('/usr/libexec/lomiri-indicator-transfer/lomiri-indicator-transfer-service') }}

# OnlyShowIn=Unity;GNOME;
# Semicolon-separated list of desktop environments where the application should appear.
OnlyShowIn={{ only_show_in | default('Unity;GNOME;') }}

# NoDisplay=True
# Whether the entry should be hidden from menus.
NoDisplay={{ nodisplay | default(True) }}

# StartupNotify=False
# Whether to show startup notification.
StartupNotify={{ startup_notify | default(False) }}

# Terminal=False
# Whether the application should be run in a terminal.
Terminal={{ terminal | default(False) }}

# AutostartCondition=GNOME3 unless-session gnome
# Conditions under which the application should autostart.
AutostartCondition={{ autostart_condition | default('GNOME3 unless-session gnome') }}