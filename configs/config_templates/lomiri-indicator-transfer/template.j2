# Lomiri Indicator Transfer Autostart Configuration
# This file defines the desktop entry for the Lomiri file transfer indicator.
# It is automatically generated by Ansible based on the provided schema.

[Desktop Entry]

# Type of the desktop entry.
# Describes the nature of this entry (Application, Link, Directory, etc.).
Type={{ type | default('Application') }}

# Display name of the application.
Name=Lomiri Indicator Transfer

# Executable path and arguments for the application.
# Defines the command to execute when launching this application.
Exec={{ executible_path | default('/usr/libexec/lomiri-indicator-transfer/lomiri-indicator-transfer-service') }}

# Desktop environments where this application should appear.
# A semicolon-separated list of desktop environment identifiers.
# Example: 'Unity;GNOME;'
OnlyShowIn={{ only_show_in | default('Unity;GNOME;') }}

# Whether the entry should be hidden from menus.
# If true, the application will not appear in standard application menus.
NoDisplay={{ nodisplay | default('true') }}

# Whether to show startup notification.
# Controls whether the cursor changes or a notification is shown while the app starts.
StartupNotify={{ startup_notify | default('false') }}

# Whether the application should be run in a terminal.
# If true, a terminal emulator window is opened to run the application.
Terminal={{ terminal | default('false') }}

# Conditions under which the application should autostart.
# Allows for conditional autostarting based on session or environment variables.
# Example: 'GNOME3 unless-session gnome'
AutostartCondition={{ autostart_condition | default('GNOME3 unless-session gnome') }}
