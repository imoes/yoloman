{
  "all": {
    "type": "bool",
    "default": false,
    "description": "show all mount points"
  },
  "color": {
    "type": "string",
    "default": "auto",
    "description": "whether to have styles and colors; [auto, yes, no]",
    "enum": [
      "auto",
      "yes",
      "no"
    ]
  },
  "ascii": {
    "type": "bool",
    "default": false,
    "description": "use only ASCII characters for table rendering"
  },
  "remote_stats": {
    "type": "string",
    "default": "auto",
    "description": "fetch stats of remote volumes; [auto, yes, no]",
    "enum": [
      "auto",
      "yes",
      "no"
    ]
  },
  "list_cols": {
    "type": "bool",
    "default": false,
    "description": "list the column names which can be used in -s, -f, or -c"
  },
  "cols": {
    "type": "string",
    "default": "fs+type+disk+used+use+free+size+mp",
    "description": "columns to display, e.g., 'fs+type+disk+used+use+free+size+mp'"
  },
  "filter_expr": {
    "type": "string",
    "default": "",
    "description": "filter expression, e.g., '(size<35G | remote=false) & type=xfs'"
  },
  "sort": {
    "type": "string",
    "default": "size",
    "description": "sort key, e.g., 'inodes', 'type-desc', or 'size-asc'"
  },
  "units": {
    "type": "string",
    "default": "SI",
    "description": "units for display; [SI, binary, bytes]",
    "enum": [
      "SI",
      "binary",
      "bytes"
    ]
  },
  "json": {
    "type": "bool",
    "default": false,
    "description": "output as JSON"
  },
  "csv": {
    "type": "bool",
    "default": false,
    "description": "output as CSV"
  },
  "csv_separator": {
    "type": "string",
    "default": ",",
    "description": "CSV field separator"
  },
  "path": {
    "type": "string",
    "default": "",
    "description": "if provided, only the device holding this path will be shown"
  }
}
