# Gambas HTTP Server configuration file
# Generated by Jinja2; do not edit manually

# Root directory for served content
{{ htdocs_dir }}

# Address to bind the server to
{{ bind_addr }}

# Port to listen on
{{ port }}

# Maximum number of simultaneous connections
{{ max_connections }}

# Maximum number of worker threads
{{ max_workers }}

# Default index file(s) when directory is requested
{{ index_files | join(', ') }}

# Enable or disable directory listing
{% if enable_dirlist %}dirlist on{% else %}dirlist off{% endif %}

# Enable or disable GZIP compression
{% if enable_gzip %}gzip on{% else %}gzip off{% endif %}

# MIME types for known extensions (custom mappings)
{% for ext, mime in custom_mime_types %}mime {{ ext }} {{ mime }}
{% endfor %}

# Access log file (empty string disables logging)
{% if access_log %}access_log {{ access_log }}{% else %}# access_log disabled{% endif %}

# Error log file (empty string disables logging)
{% if error_log %}error_log {{ error_log }}{% else %}# error_log disabled{% endif %}

# Virtual host configurations
{% for vhost in vhosts %}
# Virtual host: {{ vhost.name }}
{% if vhost.server_name %}server_name {{ vhost.server_name }}{% endif %}
{% if vhost.document_root %}document_root {{ vhost.document_root }}{% endif %}
{% if vhost.index_files %}index {{ vhost.index_files | join(', ') }}{% endif %}
{% if vhost.enable_dirlist is defined %}dirlist {% if vhost.enable_dirlist %}on{% else %}off{% endif %}{% endif %}
{% endfor %}

# TLS/SSL configuration (optional)
{% if ssl_enabled %}
# TLS certificate file
ssl_cert {{ ssl_cert_path }}

# TLS private key file
ssl_key {{ ssl_key_path }}
{% endif %}
