{
  "htdocs_dir": "/var/www/gambas_httpd",
  "bind_addr": "0.0.0.0",
  "port": 8080,
  "max_connections": 128,
  "max_workers": 2,
  "index_files": [
    "index.html",
    "index.gambas"
  ],
  "enable_dirlist": false,
  "enable_gzip": true,
  "custom_mime_types": [
    {
      "ext": ".gambas",
      "mime": "text/x-gambas-source"
    },
    {
      "ext": ".svg",
      "mime": "image/svg+xml"
    }
  ],
  "access_log": "/var/log/gambas_httpd/access.log",
  "error_log": "/var/log/gambas_httpd/error.log",
  "vhosts": [
    {
      "name": "admin",
      "server_name": "admin.example.com",
      "document_root": "/var/www/admin",
      "index_files": [
        "admin.html"
      ],
      "enable_dirlist": false
    },
    {
      "name": "api",
      "server_name": "api.example.com",
      "document_root": "/var/www/api",
      "index_files": [],
      "enable_dirlist": true
    }
  ],
  "ssl_enabled": true,
  "ssl_cert_path": "/etc/ssl/certs/gambas_httpd.crt",
  "ssl_key_path": "/etc/ssl/private/gambas_httpd.key"
}
