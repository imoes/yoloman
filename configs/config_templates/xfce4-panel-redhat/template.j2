<?xml version="1.0" encoding="UTF-8"?>
<!--
  Xfce4 Panel Configuration Template
  This template generates the xfce4-panel configuration XML.
-->
<channel name="xfce4-panel" version="1.0">
  <!-- Configuration version number -->
  <property name="configver" type="int" value="{{ configver | default('2') }}"/>
  
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <value type="int" value="2"/>
    <!-- Whether to use dark mode for the panel -->
    <property name="dark-mode" type="bool" value="{{ dark_mode | default('true') }}"/>
    
    <property name="panel-1" type="empty">
      <!-- Position string for panel 1 -->
      <property name="position" type="string" value="{{ panel_1_position | default('p=6;x=0;y=0') }}"/>
      <!-- Length percentage for panel 1 -->
      <property name="length" type="uint" value="{{ panel_1_length | default(100) }}"/>
      <!-- Whether panel 1 position is locked -->
      <property name="position-locked" type="bool" value="{{ panel_1_position_locked | default('true') }}"/>
      <!-- Icon size for panel 1 -->
      <property name="icon-size" type="uint" value="{{ panel_1_icon_size | default('16') }}"/>
      <!-- Size for panel 1 -->
      <property name="size" type="uint" value="{{ panel_1_size | default(26) }}"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
        <value type="int" value="10"/>
        <value type="int" value="11"/>
        <value type="int" value="12"/>
        <value type="int" value="13"/>
        <value type="int" value="14"/>
      </property>
    </property>
    
    <property name="panel-2" type="empty">
      <!-- Autohide behavior for panel 2 -->
      <property name="autohide-behavior" type="uint" value="{{ panel_2_autohide_behavior | default('1') }}"/>
      <!-- Position string for panel 2 -->
      <property name="position" type="string" value="{{ panel_2_position | default('p=10;x=0;y=0') }}"/>
      <!-- Length percentage for panel 2 -->
      <property name="length" type="uint" value="{{ panel_2_length | default(1) }}"/>
      <!-- Whether panel 2 position is locked -->
      <property name="position-locked" type="bool" value="{{ panel_2_position_locked | default('true') }}"/>
      <!-- Size for panel 2 -->
      <property name="size" type="uint" value="{{ panel_2_size | default(48) }}"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="15"/>
        <value type="int" value="16"/>
        <value type="int" value="17"/>
        <value type="int" value="18"/>
        <value type="int" value="19"/>
        <value type="int" value="20"/>
        <value type="int" value="21"/>
        <value type="int" value="22"/>
      </property>
    </property>
  </property>
  
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="applicationsmenu"/>
    <property name="plugin-2" type="string" value="tasklist">
      <!-- Grouping behavior for tasklist plugin -->
      <property name="grouping" type="uint" value="{{ tasklist_grouping | default('1') }}"/>
    </property>
    <property name="plugin-3" type="string" value="separator">
      <!-- Whether separator 3 expands -->
      <property name="expand" type="bool" value="{{ separator_3_expand | default('true') }}"/>
      <!-- Style for separator 3 -->
      <property name="style" type="uint" value="{{ separator_3_style | default('0') }}"/>
    </property>
    <property name="plugin-4" type="string" value="pager"/>
    <property name="plugin-5" type="string" value="separator">
      <!-- Style for separator 5 -->
      <property name="style" type="uint" value="{{ separator_5_style | default('0') }}"/>
    </property>
    <property name="plugin-6" type="string" value="systray">
      <!-- Whether systray icons are square -->
      <property name="square-icons" type="bool" value="{{ systray_square_icons | default('true') }}"/>
    </property>
    <property name="plugin-8" type="string" value="pulseaudio">
      <!-- Enable keyboard shortcuts for pulseaudio plugin -->
      <property name="enable-keyboard-shortcuts" type="bool" value="{{ pulseaudio_enable_keyboard_shortcuts | default('true') }}"/>
      <!-- Show notifications for pulseaudio plugin -->
      <property name="show-notifications" type="bool" value="{{ pulseaudio_show_notifications | default('true') }}"/>
    </property>
    <property name="plugin-9" type="string" value="power-manager-plugin"/>
    <property name="plugin-10" type="string" value="notification-plugin"/>
    <property name="plugin-11" type="string" value="separator">
      <!-- Style for separator 11 -->
      <property name="style" type="uint" value="{{ separator_11_style | default('0') }}"/>
    </property>
    <property name="plugin-12" type="string" value="clock"/>
    <property name="plugin-13" type="string" value="separator">
      <!-- Style for separator 13 -->
      <property name="style" type="uint" value="{{ separator_13_style | default('0') }}"/>
    </property>
    <property name="plugin-14" type="string" value="actions"/>
    <property name="plugin-15" type="string" value="showdesktop"/>
    <property name="plugin-16" type="string" value="separator"/>
    <property name="plugin-17" type="string" value="launcher">
      <property name="items" type="array">
        <!-- Launcher item for terminal -->
        <value type="string" value="{{ terminal_launcher_item | default('xfce4-terminal-emulator.desktop') }}"/>
      </property>
    </property>
    <property name="plugin-18" type="string" value="launcher">
      <property name="items" type="array">
        <!-- Launcher item for file manager -->
        <value type="string" value="{{ file_manager_launcher_item | default('xfce4-file-manager.desktop') }}"/>
      </property>
    </property>
    <property name="plugin-19" type="string" value="launcher">
      <property name="items" type="array">
        <!-- Launcher item for web browser -->
        <value type="string" value="{{ web_browser_launcher_item | default('xfce4-web-browser.desktop') }}"/>
      </property>
    </property>
    <property name="plugin-20" type="string" value="launcher">
      <property name="items" type="array">
        <!-- Launcher item for application finder -->
        <value type="string" value="{{ app_finder_launcher_item | default('xfce4-appfinder.desktop') }}"/>
      </property>
    </property>
    <property name="plugin-21" type="string" value="separator"/>
    <property name="plugin-22" type="string" value="directorymenu"/>
  </property>
</channel>
