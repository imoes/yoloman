# Configuration file for mypager
# Generated by Jinja2 template

# Text style for integer (or float) types. Possible styles documented in Term::ANSIColor.
# Default: green
style-int = {{ style_int | default('green') }}

# Text style for the NULL value. Possible styles documented in Term::ANSIColor.
# Default: cyan
style-null = {{ style_null | default('cyan') }}

# Text style for datetimes (and date) values. Possible styles documented in Term::ANSIColor.
# Default: yellow
style-nudatell = {{ style_nudatell | default('yellow') }}

# Text style for row headers. Possible styles documented in Term::ANSIColor.
# Default: underline
style-header = {{ style_header | default('underline') }}

# Text style for row header when mysql is used with the '\G' flag.
# Possible styles documented in Term::ANSIColor. Default: magenta
style-row = {{ style_row | default('magenta') }}

# Defaults to 1. When 1, switches to less on long lines.
# When 0, only checks height.
long_lines_to_less = {{ long_lines_to_less | default(1) }}

# Options passed to the 'less' executable.
# Default: -S
less_options = "{{ less_options | default('-S') }}"

# Defaults to 0. Set to 1 to override the $LESS environment variable options.
less_options_overrides_env = {{ less_options_overrides_env | default(0) }}

# Determine when mypager will use the less executable.
# Valid options: 'auto', 'always', 'never'.
use_less = {{ use_less | default('auto') }}

# Use to 'fix' broken MySQL client UTF-8 output. Defaults to 0 (disabled).
fix_utf8 = {{ fix_utf8 | default(0) }}