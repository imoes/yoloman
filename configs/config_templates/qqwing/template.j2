# qqwing puzzle generator configuration
# This template generates a script that invokes the qqwing binary with the specified parameters.

# Number of puzzles to generate.
# Corresponds to the --generate flag.
# Default: 1
qqwing \
  --generate {{ (number | default(1)) }} \
  --symmetry {{ (symmetry | default('rotate180')) }} \
  --difficulty {{ (difficulty | default('any')) }} \
  --{{ (format | default('readable')) }}