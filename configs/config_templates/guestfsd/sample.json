{
  "enabled": true,
  "user": "guestfs",
  "group": "guestfs",
  "virtio_path": "/dev/virtio-ports/org.guestfsd.main",
  "max_mounts": 8,
  "log_level": 2,
  "mount_opts": [
    "nosuid",
    "nodev"
  ],
  "allowed_host_paths": [
    "/mnt/data",
    "/var/lib/guests"
  ],
  "systemd_env_dir": ""
}
