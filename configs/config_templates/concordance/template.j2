{# ============================================================================= #}
{# Concordance Configuration File (CLI Arguments)                                #}
{# This template generates the command-line arguments for the `concordance` tool, #}
{# which is used to program and interact with Logitech Harmony remote controls.   #}
{# Each section corresponds to a specific operation mode or flag defined by the   #}
{# tool's CLI interface.                                                         #}
{# ============================================================================= #}

{# --- Dump Configuration --- #}
{# -c [filename] : Dump the current configuration of the remote.              #}
{#                 If filename is empty, defaults to 'config.EZHex'.          #}
{% if mode_dump_config is defined %}-c{{ mode_dump_config.filename | default('') }}
{% endif %}

{# --- Write Configuration --- #}
{# -C filename   : Write configuration from a file to the remote.             #}
{% if mode_write_config is defined %}-C {{ mode_write_config.filename | default('') }}
{% endif %}

{# --- Dump Firmware --- #}
{# -f [filename] : Dump the current firmware from the remote.                 #}
{#                 If filename is empty, defaults to 'firmware.EZUp'.         #}
{% if mode_dump_firmware is defined %}-f{{ mode_dump_firmware.filename | default('') }}
{% endif %}

{# --- Write Firmware --- #}
{# -F filename   : Write firmware from a file to the remote.                  #}
{% if mode_write_firmware is defined %}-F {{ mode_write_firmware.filename | default('') }}
{% endif %}

{# --- Print Remote Info --- #}
{# -i            : Print detailed information about the connected remote.     #}
{% if mode_print_remote_info is defined and mode_print_remote_info | default(False) %}-i
{% endif %}

{# --- Get Time from Remote --- #}
{# -k            : Get the current time from the remote device.               #}
{% if mode_get_time is defined and mode_get_time | default(False) %}-k
{% endif %}

{# --- Set Time on Remote --- #}
{# -K            : Set the time on the remote device to the system time.      #}
{% if mode_set_time is defined and mode_set_time | default(False) %}-K
{% endif %}

{# --- Learn IR Command --- #}
{# -l filename   : Learn an IR command from the remote and save to file.      #}
{% if mode_learn_ir is defined %}-l {{ mode_learn_ir.filename | default('') }}
{% endif %}

{# --- Reset Remote (Power Cycle) --- #}
{# -r            : Reset (power-cycle) the remote device.                     #}
{% if mode_reset is defined and mode_reset | default(False) %}-r
{% endif %}

{# --- Dump Safemode Firmware --- #}
{# -s [filename] : Dump the safemode firmware from the remote.                #}
{#                 If filename is empty, defaults to 'safe.bin'.              #}
{% if mode_dump_safemode is defined %}-s{{ mode_dump_safemode.filename | default('') }}
{% endif %}

{# --- Connectivity Test --- #}
{# -t filename   : Perform a connectivity test and save results to file.      #}
{% if mode_connectivity_test is defined %}-t {{ mode_connectivity_test.filename | default('') }}
{% endif %}

{# --- Binary Only --- #}
{# -b            : Dump/write the binary-only blob (raw data).                #}
{% if mode_binary_only is defined and mode_binary_only | default(False) %}-b
{% endif %}

{# --- Force Operation --- #}
{# --force       : Force operation without file-type detection.               #}
{% if mode_force is defined and mode_force | default(False) %}--force
{% endif %}

{# --- No Reset --- #}
{# -R            : Do not reboot the remote after config/firmware update.     #}
{% if mode_no_reset is defined and mode_no_reset | default(False) %}-R
{% endif %}

{# --- Verbose Output --- #}
{# -v            : Enable verbose output for debugging.                       #}
{% if mode_verbose is defined and mode_verbose | default(False) %}-v
{% endif %}

{# --- No Web --- #}
{# -w            : Do not contact the Logitech website.                       #}
{% if mode_no_web is defined and mode_no_web | default(False) %}-w
{% endif %}

{# --- Help --- #}
{# -h            : Print help message and exit.                               #}
{% if mode_help is defined and mode_help | default(False) %}-h
{% endif %}

{# --- Version --- #}
{# -V            : Print version and exit.                                    #}
{% if mode_version is defined and mode_version | default(False) %}-V
{% endif %}