{
  "shell": {
    "type": "string",
    "default": "/bin/sh",
    "description": "Shell used to execute cron jobs"
  },
  "path": {
    "type": "string",
    "default": "",
    "description": "Optional PATH override; leave empty to inherit environment PATH"
  },
  "jobs": {
    "type": "list",
    "default": [],
    "description": "List of cron job definitions"
  },
  "jobs[].minute": {
    "type": "string",
    "default": "*",
    "description": "Minute field (0\u201359 or *)"
  },
  "jobs[].hour": {
    "type": "string",
    "default": "*",
    "description": "Hour field (0\u201323 or *)"
  },
  "jobs[].day": {
    "type": "string",
    "default": "*",
    "description": "Day of month field (1\u201331 or *)"
  },
  "jobs[].month": {
    "type": "string",
    "default": "*",
    "description": "Month field (1\u201312 or *)"
  },
  "jobs[].dow": {
    "type": "string",
    "default": "*",
    "description": "Day of week field (0\u20136 or *)"
  },
  "jobs[].user": {
    "type": "string",
    "default": "root",
    "description": "User to run the command as"
  },
  "jobs[].command": {
    "type": "string",
    "default": "",
    "description": "Command to execute"
  }
}