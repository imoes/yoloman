{
  "fasd_data": "$HOME/.fasd-data",
  "fasd_blacklist": [
    "--help",
    "-h",
    "man",
    "info"
  ],
  "fasd_shift": [
    "sudo",
    "su",
    "env"
  ],
  "fasd_ignore": [
    "fasd",
    "ls",
    "echo",
    "cd"
  ],
  "fasd_track_pwd": false,
  "fasd_awk": "gawk",
  "fasd_sink": "$HOME/.fasd.log",
  "fasd_max": 1000,
  "fasd_shell": "dash",
  "fasd_backends": [
    "viminfo",
    "recently-used"
  ],
  "fasd_ro": true,
  "fasd_fuzzy": 0,
  "fasd_viminfo": "/home/user/.viminfo",
  "fasd_recently_used_xbel": "/home/user/.local/share/recently-used.xbel"
}
