{
  "defaults_tls": true,
  "defaults_tls_certcheck": true,
  "defaults_auth": "on",
  "defaults_timeout": 180,
  "defaults_delivery_method": "mbox",
  "defaults_delivery_args": [
    "/var/mail/admin"
  ],
  "defaults_keep": false,
  "defaults_only_new": true,
  "defaults_uidls_file": "~/.mpop_uidls/%U_at_%H",
  "accounts": [
    {
      "name": "work_pop",
      "host": "pop.work.example.com",
      "user": "admin",
      "passwordeval": "gpg2 --no-tty -q -d ~/.gnupg/work_pass.gpg",
      "tls": "on",
      "tls_trust_file": "/etc/ssl/certs/work_ca.pem"
    },
    {
      "name": "personal_pop",
      "host": "pop.gmail.com",
      "port": 995,
      "user": "admin@gmail.com",
      "passwordeval": "gpg2 --no-tty -q -d ~/.gnupg/personal_pass.gpg",
      "tls": "on",
      "keep": "off",
      "delivery_method": "maildir",
      "delivery_args": [
        "/home/admin/Mail/personal"
      ]
    }
  ]
}
