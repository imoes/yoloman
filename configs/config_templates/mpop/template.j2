# mpop configuration file
# Generated by automation. Do not edit manually.

# defaults section: applies to all accounts unless overridden
defaults

# Enable TLS/SSL for all accounts by default.
tls {{ defaults_tls | default(true) | lower }}

# Enable server certificate verification by default.
tls_certcheck {{ defaults_tls_certcheck | default(true) | lower }}

# Default authentication method selection strategy (e.g., 'on' for auto, 'plain', 'scram-sha-256').
tls_auth {{ defaults_auth | default('on') }}

# Default network timeout in seconds.
# Only rendered if not the default value of 180 to keep config clean.
{% if defaults_timeout | default(180) != 180 %}
timeout {{ defaults_timeout | default(180) }}
{% endif %}

# Default mail delivery method: 'mbox', 'maildir', 'mda', or 'exchange'.
# Options: mda, maildir, mbox, exchange
{% if defaults_delivery_method | default('mbox') != 'mbox' %}
delivery {{ defaults_delivery_method | default('mbox') }} {{ defaults_delivery_args | default([]) | join(' ') }}
{% endif %}

# Set default mail keeping behavior: keep mails on the server by default.
keep {{ defaults_keep | default(false) | lower }}

# Set default only-new behavior: process only new messages by default.
only_new {{ defaults_only_new | default(true) | lower }}

# Default file to store UIDLs in.
# %U is replaced by username, %H by hostname.
# Only rendered if not the default value to keep config clean.
{% if defaults_uidls_file | default('~/.mpop_uidls/%U_at_%H') != '~/.mpop_uidls/%U_at_%H' %}
uidls_file {{ defaults_uidls_file | default('~/.mpop_uidls/%U_at_%H') }}
{% endif %}

# Iterate over each account defined in the accounts list.
{% for account in accounts | default([]) %}
# Account: {{ account.name }}
account {{ account.name | default('unnamed') }}

# POP3 server hostname.
host {{ account.host | default('localhost') }}

# POP3 server port (default 110 or 995 based on tls).
{% if account.port is defined %}
port {{ account.port | default(110) }}
{% endif %}

# Authentication method for this account.
# Falls back to defaults_auth if not specified, but usually explicit per account.
tls_auth {{ account.auth | default('on') }}

# Username for authentication.
user {{ account.user | default('') }}

# Password method: 'passwordeval' for command-based, 'password' for plaintext.
{% if account.passwordeval is defined %}
passwordeval {{ account.passwordeval }}
{% elif account.password is defined %}
password {{ account.password }}
{% endif %}

# Per-account TLS setting (overrides default).
{% if account.tls is defined %}
tls {{ account.tls | default(true) | lower }}
{% endif %}

# Per-account TLS trust file (optional).
{% if account.tls_trust_file is defined %}
tls_trust_file {{ account.tls_trust_file }}
{% endif %}

# Per-account TLS fingerprint (optional, overrides trust_file).
{% if account.tls_fingerprint is defined %}
tls_fingerprint {{ account.tls_fingerprint }}
{% endif %}

# Per-account delivery method.
{% if account.delivery_method is defined %}
delivery {{ account.delivery_method }} {{ account.delivery_args | default([]) | join(' ') }}
{% endif %}

# Per-account keep setting.
{% if account.keep is defined %}
keep {{ account.keep | default(false) | lower }}
{% endif %}

# Per-account UIDLS file (optional).
{% if account.uidls_file is defined %}
uidls_file {{ account.uidls_file }}
{% endif %}

{% endfor %}

# Set default account if multiple are defined.
# The first account is implicitly used as default if multiple exist unless explicitly set here.
# Note: The original logic `accounts | join(', ')` is syntactically incorrect for mpop's `account default :` directive.
# mpop expects a single account name after the colon. We select the first account name.
{% if (accounts | default([])) | length > 1 %}
account default : {{ (accounts | default([]))[0].name }}
{% endif %}