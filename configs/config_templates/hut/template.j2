# Hut instance configuration file
#
# This template generates the configuration for a Hut instance.
# Hut is a suite of developer tools by srid.ca (sr.ht).
#
# Variables used:
# - instance_name: The identifier/name for this Hut instance.
# - access_token: Static OAuth2 access token string.
# - access_token_cmd: Shell command to dynamically retrieve the access token.
# - meta_origin: The origin URL for the meta.sr.ht service.
# - services: A list of service configuration maps.

instance "{{ instance_name | default('sr.ht') }}" {
	# Access token for authentication (Static)
	# Provide a static token here if you do not use a dynamic retrieval command.
	access-token "{{ access_token | default('') }}"

{% if access_token_cmd is defined and access_token_cmd is not none %}
	# Command to retrieve access token dynamically
	# Use this if the token is generated by an external tool (e.g., pass, gopass, vault).
	# If both access_token and access_token_cmd are provided, hut prefers the command.
	access-token-cmd "{{ access_token_cmd }}"
{% endif %}

	# Meta service configuration
	meta {
		# Origin URL for the meta service
		# Points to the central meta.sr.ht instance or a custom meta service.
		origin "{{ meta_origin | default('https://meta.sr.ht') }}"
	}

	# Configuration for each sub-service
	# Iterates over the 'services' list provided in the schema.
{% if services is defined and services is iterable %}
{% for service in services %}
	{{ service.name }} {
{% for key, value in service | dict2items %}
		# {{ key.key }} setting: {{ key.value | default('') }}
		{{ key.key }} "{{ key.value | default('') }}"
{% endfor %}
	}
{% endfor %}
{% endif %}
}