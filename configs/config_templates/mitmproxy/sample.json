{
  "host": "127.0.0.1",
  "port": 8080,
  "http2": true,
  "ssl_insecure": false,
  "cert_gen": "~/.mitmproxy",
  "mode": "normal",
  "reverse_upstreams": [
    {
      "name": "API Backend",
      "match": "/api",
      "upstream": "http://backend.local:8000"
    }
  ],
  "server_replay": false,
  "client_replay": false,
  "web_host": "127.0.0.1",
  "web_port": 8081,
  "web_debug": false,
  "log_level": "info",
  "save_stream_file": "",
  "transparent_proxy": true,
  "bypass_hosts": [
    "169.254.169.254",
    "127.0.0.1"
  ],
  "addons": [
    "anticache",
    "stickyauth"
  ],
  "connection_timeout": 120
}
