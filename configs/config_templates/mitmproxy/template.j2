# ==============================================================================
# mitmproxy Configuration Template
# ==============================================================================
# This Jinja2 template generates a `mitmproxy` YAML configuration file.
# It is designed to be used within an Ansible role to manage mitmproxy instances.
#
# Schema Reference:
# - host: Interface to bind the proxy to (e.g., '127.0.0.1' for local-only, '0.0.0.0' for all interfaces).
# - port: TCP port on which the proxy listens for client connections.
# - http2: Enable or disable HTTP/2 protocol support (recommended to leave enabled).
# - ssl_insecure: If true, skip validation of upstream server TLS certificates (useful for testing with self-signed certs, but not recommended in production).
# - cert_gen: Directory where dynamically generated TLS certificates (for HTTPS MITM) are stored.
# - mode: Proxy mode. 'normal' = standard HTTP proxy (requires client proxy config), 'transparent' = intercepts transparently (requires OS routing rules).
# - reverse_upstreams: List of reverse proxy targets. Each entry forwards requests matching a pattern to an upstream URL.
# - server_replay: If true, serve responses from previously captured flows instead of contacting the real server (useful for deterministic testing).
# - client_replay: If true, replay recorded client requests against the upstream server (e.g., for load simulation).
# - web_host: Interface for the web UI (mitmweb). Set to '0.0.0.0' to expose it externally (with caution).
# - web_port: Port for the web UI (mitmweb).
# - web_debug: Enable verbose debugging in the web UI (e.g., show full request/response headers).
# - log_level: Verbosity of console logs. 'error' (minimal), 'warn', 'info' (recommended), 'debug' (detailed), 'trace' (extreme detail).
# - save_stream_file: Path to a file where all intercepted flows are streamed in real-time (e.g., for offline analysis or integration with other tools).
# - transparent_proxy: For 'transparent' mode only — overrides automatic detection of transparency support (e.g., for OSes like Linux with netfilter).
# - bypass_hosts: List of hostnames or IP addresses to exclude from HTTPS interception (e.g., ['169.254.169.254'] to avoid metadata services like AWS EC IMDS).
# - addons: List of built-in or custom addons to load (e.g., ['anticache', 'stickyauth', 'stream_large_bodies']).
# - connection_timeout: Timeout (in seconds) for establishing connections to upstream servers. Increase for slow endpoints.
# ==============================================================================

# --- Main Listener Configuration ---

# Interface to bind the proxy to (e.g., '127.0.0.1' for local-only, '0.0.0.0' for all interfaces).
# Defaults to 'localhost' if not specified.
host: {{ host | default('localhost') }}

# TCP port on which the proxy listens for client connections.
# Defaults to 8080 if not specified.
port: {{ port | default(8080) }}

# --- Protocol & SSL Settings ---

# Enable or disable HTTP/2 protocol support (recommended to leave enabled).
# Defaults to True if not specified.
http2: {{ http2 | default(true) | lower }}

# If true, skip validation of upstream server TLS certificates (useful for testing with self-signed certs, but not recommended in production).
# Defaults to False if not specified.
ssl_insecure: {{ ssl_insecure | default(false) | lower }}

# Directory where dynamically generated TLS certificates (for HTTPS MITM) are stored.
# Defaults to '~/.mitmproxy' if not specified.
cert_gen: {{ cert_gen | default('~/.mitmproxy') }}

# --- Proxy Mode ---

# Proxy mode. 'normal' = standard HTTP proxy (requires client proxy config), 'transparent' = intercepts transparently (requires OS routing rules).
# Options: 'normal', 'transparent', 'socks5', 'reverse', 'local'.
# Defaults to 'normal' if not specified.
mode: {{ mode | default('normal') }}

# --- Reverse Proxy Configuration ---

# List of reverse proxy targets. Each entry forwards requests matching a pattern to an upstream URL.
# Each item in the list is a dict with 'match' and 'upstream' keys.
# Defaults to an empty list if not specified.
{% set upstreams = reverse_upstreams | default([]) %}
{% if upstreams | length > 0 %}
# Reverse proxy upstreams
upstreams:
  {% for upstream in upstreams %}
  # Reverse proxy target for pattern: {{ upstream.match | default('') }} -> {{ upstream.upstream }}
  - match: {{ upstream.match | default('') | tojson }}
    url: {{ upstream.upstream | default('') | tojson }}
  {% endfor %}
{% endif %}

# --- Replay Options ---

# If true, serve responses from previously captured flows instead of contacting the real server (useful for deterministic testing).
# Defaults to False if not specified.
server_replay: {{ server_replay | default(false) | lower }}

# If true, replay recorded client requests against the upstream server (e.g., for load simulation).
# Defaults to False if not specified.
client_replay: {{ client_replay | default(false) | lower }}

# --- Web UI Configuration ---

# Interface for the web UI (mitmweb). Set to '0.0.0.0' to expose it externally (with caution).
# Defaults to 'localhost' if not specified.
web_host: {{ web_host | default('localhost') }}

# Port for the web UI (mitmweb).
# Defaults to 8081 if not specified.
web_port: {{ web_port | default(8081) }}

# Enable verbose debugging in the web UI (e.g., show full request/response headers).
# Defaults to False if not specified.
web_debug: {{ web_debug | default(false) | lower }}

# --- Logging ---

# Verbosity of console logs. 'error' (minimal), 'warn', 'info' (recommended), 'debug' (detailed), 'trace' (extreme detail).
# Defaults to 'info' if not specified.
log_level: {{ log_level | default('info') }}

# --- Flow Storage ---

# Path to a file where all intercepted flows are streamed in real-time (e.g., for offline analysis or integration with other tools).
# If empty, no file is saved.
# Defaults to '' (empty) if not specified.
save_stream_file: {{ save_stream_file | default('') | tojson }}

# --- Transparency ---

# For 'transparent' mode only — overrides automatic detection of transparency support (e.g., for OSes like Linux with netfilter).
# Defaults to True if not specified.
transparent_proxy: {{ transparent_proxy | default(true) | lower }}

# --- Bypass Hosts ---

# List of hostnames or IP addresses to exclude from HTTPS interception (e.g., ['169.254.169.254'] to avoid metadata services like AWS EC IMDS).
# Defaults to an empty list if not specified.
{% set bypass = bypass_hosts | default([]) %}
{% if bypass | length > 0 %}
bypass_hosts:
  {% for h in bypass %}
  - {{ h | tojson }}
  {% endfor %}
{% endif %}

# --- Addons ---

# List of built-in or custom addons to load (e.g., ['anticache', 'stickyauth', 'stream_large_bodies']). See full list at https://docs.mitmproxy.org/stable/addons-overview/
# Defaults to an empty list if not specified.
{% set addons_list = addons | default([]) %}
{% if addons_list | length > 0 %}
addons:
  {% for addon in addons_list %}
  - {{ addon | tojson }}
  {% endfor %}
{% endif %}

# --- Timeouts ---

# Timeout (in seconds) for establishing connections to upstream servers. Increase for slow endpoints.
# Defaults to 120 if not specified.
connection_timeout: {{ connection_timeout | default(120) }}