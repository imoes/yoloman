{
  "host": "0.0.0.0",
  "port": 70,
  "gopher_root": "/var/gopher",
  "user": "gopher",
  "group": "gopher",
  "directory_index": true,
  "syslog": true,
  "max_connections": 50,
  "timeout": 60,
  "charset": "UTF-8",
  "gophermap_fallback": "text",
  "path_prefix": "",
  "log_client_ip": true,
  "mime_overrides": {
    "pdf": "application/pdf",
    "txt": "text/plain",
    "html": "text/html"
  },
  "access_rules": [
    "ALLOW:0.0.0.0/0",
    "DENY:127.0.0.1/32"
  ],
  "virtual_hosts": [
    {
      "host": "gopher.example.com",
      "root": "/var/gopher/example"
    },
    {
      "host": "archive.example.com",
      "root": "/var/gopher/archive"
    }
  ]
}
