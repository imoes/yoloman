# Dante SOCKS Proxy Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY
# This template generates the socks.conf file for the Dante proxy server.
# Each configuration directive is documented below with its schema description and default value.

# -----------------------------------------------------------------------------
# Global Settings
# -----------------------------------------------------------------------------

# Debug level (1 to enable).
# Default: '1'
# Enable debugging output. Setting to 1 enables debug logging.
{% if debug | default('1') == '1' %}
debug: {{ debug | default('1') }}
{% endif %}

# Log output destination.
# Default: 'stdout'
# Specifies where log messages should be sent (e.g., stdout, syslog, stderr).
logoutput: {{ logoutput | default('stdout') }}

# Protocol for resolving hostnames (udp, tcp, or fake).
# Default: 'udp'
# Defines the protocol Dante uses to resolve DNS queries.
# - udp: Standard UDP DNS resolution.
# - tcp: TCP-based DNS resolution (useful if UDP is blocked).
# - fake: Uses a local fake DNS resolver (no network traffic).
resolveprotocol: {{ resolveprotocol | default('udp') }}

# -----------------------------------------------------------------------------
# Routes and Proxy Definitions
# -----------------------------------------------------------------------------
# Routes define how traffic is forwarded. The general syntax is:
# route {
#     from: [source]   to: [destination]   via: [next_hop]
#     command: [bind|connect]
#     protocol: [tcp|udp]
#     proxyprotocol: [socks_v4|socks_v5|http]
# }
#
# The following routes are configured based on the provided schema defaults.

# Route 1: DNS Resolution via Direct Connection
# Purpose: Ensures that DNS queries for the configured DNS server are sent
# directly, avoiding potential circular dependencies where the proxy needs DNS
# to resolve its own address.
# Note: This assumes the DNS server is reachable directly from the host.
#dns_server: {{ dns_server | default('10.1.1.1') }}
#dns_subnet: {{ dns_subnet | default('32') }}
#
# Uncomment the block below to route DNS traffic directly.
#route {
#    from: 0.0.0.0/0   to: {{ dns_server | default('10.1.1.1') }}/{{ dns_subnet | default('32') }} port = domain via: direct
#}

