# /etc/ferm/ferm.conf — Main firewall configuration for Ferm (Filter Engine for Netfilter)
# Do NOT edit this file directly — it is managed by configuration management

# Define input and output interfaces (e.g., eth0, lo) as lists for later use
{% for ifname in input_interfaces %}INPUT_IF={{ ifname }}
{% endfor %}
{% for ifname in output_interfaces %}OUTPUT_IF={{ ifname }}
{% endfor %}

# Set default policies for built-in chains
{% if default_input_policy == 'DROP' %}@DEFAULT_INPUT=DROP
{% elif default_input_policy == 'ACCEPT' %}@DEFAULT_INPUT=ACCEPT
{% else %}@DEFAULT_INPUT=DROP
{% endif %}
{% if default_output_policy == 'DROP' %}@DEFAULT_OUTPUT=DROP
{% elif default_output_policy == 'ACCEPT' %}@DEFAULT_OUTPUT=ACCEPT
{% else %}@DEFAULT_OUTPUT=ACCEPT
{% endif %}
{% if default_forward_policy == 'DROP' %}@DEFAULT_FORWARD=DROP
{% elif default_forward_policy == 'ACCEPT' %}@DEFAULT_FORWARD=ACCEPT
{% else %}@DEFAULT_FORWARD=DROP
{% endif %}

# Load kernel modules (e.g., ip_conntrack, nf_conntrack) if needed
{% for mod in kernel_modules %}# Load kernel module: {{ mod }}
{{ mod }}
{% endfor %}

# Define common port ranges and protocols as macros (Ferm supports Perl-style macros)
# Allow established and related connections
{% macro allow_established() %}
  # Allow established and related connections
  @MODULE=conntrack
  daddr 0/0  saddr 0/0  proto tcp  state (ESTABLISHED|RELATED)  ACCEPT;
  daddr 0/0  saddr 0/0  proto udp  state ESTABLISHED              ACCEPT;
{% endmacro %}
{{ allow_established() }}

# Define loopback interface rules
# Allow all traffic on loopback interface
  daddr 127.0.0.0/8  saddr 127.0.0.0/8  ACCEPT;

# Allow ICMP ping (optional, controlled by toggle)
{% if icmp_allow %}
# Allow ICMP ping (echo-request)
  proto icmp  icmp-type echo-request  ACCEPT;
  proto icmp  icmp-type echo-reply    ACCEPT;
{% endif %}

# Allow SSH access (port 22) from trusted networks or all (if enabled)
{% for rule in ssh_rules %}
  # SSH access rule: {{ rule.description }}
  daddr 0/0  saddr {{ rule.source }}  proto tcp  dport {{ rule.port | default(22) }}  ACCEPT;
{% endfor %}

# Allow HTTP/HTTPS from all (if enabled)
{% if http_enabled %}
# Allow HTTP traffic (TCP port 80)
  daddr 0/0  saddr 0/0  proto tcp  dport 80  ACCEPT;
# Allow HTTPS traffic (TCP port 443)
  daddr 0/0  saddr 0/0  proto tcp  dport 443  ACCEPT;
{% endif %}

# Custom service rules (e.g., database, app ports)
{% for svc in services %}
# Service: {{ svc.name }}
{% if svc.protocol == 'tcp' %}
{%   for port in svc.ports %}
  daddr 0/0  saddr {{ svc.allowed_sources | default('0/0') }}  proto tcp  dport {{ port }}  ACCEPT;
{%   endfor %}
{% elif svc.protocol == 'udp' %}
{%   for port in svc.ports %}
  daddr 0/0  saddr {{ svc.allowed_sources | default('0/0') }}  proto udp  dport {{ port }}  ACCEPT;
{%   endfor %}
{% endif %}
{% endfor %}

# Drop all remaining traffic by default (final rule to enforce deny-by-default)
# Drop all other traffic
  daddr 0/0  saddr 0/0  DROP;
