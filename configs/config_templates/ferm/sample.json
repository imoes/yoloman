{
  "input_interfaces": [
    "eth0",
    "br0"
  ],
  "output_interfaces": [
    "eth0"
  ],
  "default_input_policy": "DROP",
  "default_output_policy": "ACCEPT",
  "default_forward_policy": "DROP",
  "kernel_modules": [
    "ip_conntrack",
    "ipt_state"
  ],
  "icmp_allow": true,
  "http_enabled": false,
  "ssh_rules": [
    {
      "description": "Allow SSH from office subnet",
      "source": "10.20.30.0/24",
      "port": 22
    },
    {
      "description": "Emergency SSH from jump host",
      "source": "192.168.1.50",
      "port": 2222
    }
  ],
  "services": [
    {
      "name": "PostgreSQL",
      "protocol": "tcp",
      "ports": [
        5432
      ],
      "allowed_sources": "10.10.0.0/16"
    },
    {
      "name": "Redis",
      "protocol": "tcp",
      "ports": [
        6379
      ],
      "allowed_sources": "10.10.0.0/16"
    },
    {
      "name": "NTP",
      "protocol": "udp",
      "ports": [
        123
      ],
      "allowed_sources": "0/0"
    }
  ]
}
