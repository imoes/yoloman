{
  "listen_address": "0.0.0.0",
  "port": 8080,
  "workers": 4,
  "artifacts_dir": "/var/lib/debci/collector/artifacts",
  "max_artifact_size_mb": 512,
  "max_connections": 2000,
  "compress_artifacts": true,
  "relays": [
    {
      "host": "debci-relay.example.com",
      "port": 443,
      "use_tls": true
    },
    {
      "host": "debci-relay.backup.example.org",
      "port": 80,
      "use_tls": false
    }
  ],
  "log_level": "info",
  "log_file": "/var/log/debci/collector.log",
  "metrics_enabled": true,
  "metrics_port": 9102,
  "health_endpoint": "/healthz"
}
