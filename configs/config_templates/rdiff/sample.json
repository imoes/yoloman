{
  "storage_dir": "/var/backups/mydata",
  "remote_user": "backup_user",
  "ssh_port": 2222,
  "compression_level": 9,
  "max_age_days": 60,
  "source_dirs": [
    {
      "src": "/etc",
      "dest": "etc_backup"
    },
    {
      "src": "/home/user/docs",
      "dest": "home_docs"
    }
  ],
  "extra_options": [
    "--force",
    "--remote-schema",
    "ssh -p 2222 ssh %s rdiff --server"
  ]
}
