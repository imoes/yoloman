{
  "verbosity_var": "verbosity",
  "verbosity": 2,
  "hook_d": "/etc/needrestart/hook.d",
  "notify_d": "/etc/needrestart/notify.d",
  "restart_d": "/etc/needrestart/restart.d",
  "sendnotify": false,
  "has_pam_systemd": false,
  "restart": "i",
  "ui": "NeedRestart::UI::stdio",
  "defno": false,
  "ui_mode": "e",
  "systemctl_combine": true,
  "perlcache": "/var/cache/needrestart/perl_scandeps_cache",
  "skip_mapfiles": -1,
  "kernelhints": -1,
  "kernelfilter": "kernel7\\.img",
  "ucodehints": false
}
