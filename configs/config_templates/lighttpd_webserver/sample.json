{
  "modules": [
    "mod_access",
    "mod_alias",
    "mod_accesslog",
    "mod_compress",
    "mod_dirlisting",
    "mod_staticfile",
    "mod_rewrite"
  ],
  "document_root": "/var/www/myapp",
  "bind_address": "0.0.0.0",
  "port": 80,
  "pid_file": "/run/lighttpd.pid",
  "error_log": "/var/log/lighttpd/error.log",
  "access_log": "/var/log/lighttpd/access.log",
  "max_connections": 2048,
  "event_handler": "linux-sysepoll",
  "network_backend": "sendfile",
  "mimetypes": {
    ".html": "text/html",
    ".css": "text/css",
    ".js": "application/javascript",
    ".json": "application/json",
    ".png": "image/png",
    ".jpg": "image/jpeg"
  },
  "dir_listing": false,
  "compress_cache_dir": "/var/cache/lighttpd/compress",
  "compress_filetypes": [
    "text/plain",
    "text/html",
    "text/css",
    "application/javascript"
  ],
  "vhosts": [
    {
      "domain": "example\\.com$",
      "root": "/var/www/example"
    },
    {
      "domain": "api\\.example\\.com$",
      "root": "/var/www/api"
    }
  ],
  "log_request_header": false,
  "log_response_header": false,
  "log_timeout_requests": false,
  "errorlog_use_syslog": false,
  "ssl_enabled": true,
  "ssl_bind": "0.0.0.0",
  "ssl_port": 443,
  "ssl_pemfile": "/etc/ssl/private/lighttpd.pem",
  "ssl_cipher_list": "ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "fastcgi_enabled": true,
  "fastcgi_socket": "/run/php/php-fpm.sock",
  "fastcgi_bin_path": "",
  "fastcgi_max_procs": 4,
  "static_exclude_extensions": [
    ".php",
    ".pl",
    ".fcgi",
    ".py"
  ],
  "index_files": [
    "index.html",
    "index.php"
  ],
  "errorfile_prefix": "/usr/share/lighttpd/servers/"
}
