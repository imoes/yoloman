version: 0.1
log:
  fields:
    service: registry
storage:
  cache:
    blobdescriptor: inmemory
  filesystem:
    rootdirectory: {{ root_directory }}
  delete:
    enabled: true
http:
  addr: {{ http_addr }}
  headers:
    X-Content-Type-Options: [nosniff]
auth:
  htpasswd:
    realm: {{ auth_htpasswd_realm }}
    path: {{ auth_htpasswd_path }}
health:
  storagedriver:
    enabled: {{ health_storagedriver_enabled | lower }}
    interval: {{ health_storagedriver_interval }}
    threshold: {{ health_storagedriver_threshold }}
