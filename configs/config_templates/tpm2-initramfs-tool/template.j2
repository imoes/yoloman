# ==============================================================================
# tpm2-initramfs-tool Configuration Template
# ==============================================================================
# This configuration file is generated by Ansible for the tpm2-initramfs-tool package.
# It controls the behavior of the initramfs hook regarding TPM (Trusted Platform Module)
# operations, such as sealing and unsealing encryption keys.
#
# The settings here define:
#   - Which TPM device interface is used.
#   - Which PCR (Platform Configuration Register) indices are measured and sealed.
#   - Which hash algorithms (banks) are used for those measurements.
#   - Whether to store the sealed key persistently in TPM NVRAM.
#
# For detailed options, consult: man tpm2-initramfs-tool(1)
# ==============================================================================

# ------------------------------------------------------------------------------
# TPM Device Interface
# ------------------------------------------------------------------------------
# Specifies the path to the TPM device interface.
# Use /dev/tpm0 for direct hardware TPM access or /dev/tpmrm0 for the TPM Resource Manager
# (recommended for most virtualized or multi-user environments).
# Variable: tpm_device
# ------------------------------------------------------------------------------
TPM_DEVICE={{ tpm_device | default('/dev/tpmrm0') }}

# ------------------------------------------------------------------------------
# PCR Indices Policy
# ------------------------------------------------------------------------------
# Comma-separated list of PCR indices used in the sealing policy.
# These indices track the boot process integrity. PCR7 is commonly used for OS boot state.
# Examples: '0,2,4,7' for full boot measurement, or '7' for minimal OS boot verification.
# Variable: pcr_indices
# ------------------------------------------------------------------------------
PCR_INDICES={{ pcr_indices | default('7') }}

# ------------------------------------------------------------------------------
# PCR Hash Algorithms (Banks)
# ------------------------------------------------------------------------------
# Comma-separated list of hashing banks (algorithms) used to compute PCR values.
# Ensure the TPM supports these banks. SHA256 is the modern standard and is recommended.
# Examples: 'SHA1,SHA256' for legacy compatibility, or 'SHA256' for modern systems.
# Variable: pcr_banks
# ------------------------------------------------------------------------------
PCR_BANKS={{ pcr_banks | default('SHA256') }}

# ------------------------------------------------------------------------------
# Persistent Object Address
# ------------------------------------------------------------------------------
# Hexadecimal address in the TPM Non-Volatile RAM (NVRAM) where the sealed key object
# is stored. If set to '0' (default), the tool creates an ephemeral object or uses
# default persistence behavior, which may not survive TPM resets.
# To store persistently, provide a valid NV index address (e.g., '0x81000004').
# Variable: persistent_object_address
# ------------------------------------------------------------------------------
PERSISTENT_OBJECT_ADDRESS={{ persistent_object_address | default('0') }}