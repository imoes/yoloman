;; -*-emacs-lisp-;-
;;
;; Emacs startup file for the Debian GNU/Linux cmake package

(if (file-exists-p "{{ emacs_site_lisp_path }}/ferret.el")
 (progn
 (debian-pkg-add-load-path-item "{{ emacs_site_lisp_path }}")
  (autoload 'ferret-mode "ferret"
   "Major mode for editing Ferret journal files." t)
  (setq auto-mode-alist
   (append '( ("\\.jnl\\'" . ferret-mode))
    auto-mode-alist)))
 (message "{{ package_name }} removed but not purged, skipping setup"))
