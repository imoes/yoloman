{
  "kdc_db_dir": "/var/lib/heimdal-kdc",
  "kdc_db_mode": "kdc",
  "kdc_port": 88,
  "kdc_realm": "EXAMPLE.COM",
  "kdc_enable_audit": true,
  "kdc_enable_http": true,
  "kdc_enable_hprop": true,
  "kdc_enable_hpropd": true,
  "kdc_enable_kadmin": true,
  "kdc_enable_kadmin_local": true,
  "kdc_acl_file": "/etc/heimdal/kdc.acl",
  "kdc_keytab_file": "/etc/heimdal/kdc.keytab",
  "kdc_log_file": "/var/log/heimdal-kdc.log",
  "kdc_max_life": 86400,
  "kdc_max_renewable_life": 604800,
  "kdc_preauth_types": [
    "pa-etype-info2"
  ],
  "kdc_default_flags": [
    "pre-auth",
    "forwardable",
    "renewable"
  ],
  "kdc_listen": [
    {
      "interface": "eth0",
      "address": "192.168.1.10",
      "port": 88,
      "protocol": "both"
    },
    {
      "address": "127.0.0.1",
      "port": 88,
      "protocol": "udp"
    }
  ],
  "kdc_realm_configs": [
    {
      "name": "EXAMPLE.COM",
      "max_life": 43200,
      "max_renewable_life": 86400
    },
    {
      "name": "INTERNAL.EXAMPLE.COM",
      "database": "/var/lib/heimdal-kdc/internal.kdc.db",
      "default_flags": [
        "pre-auth"
      ]
    }
  ],
  "kdc_hpropd": {
    "enabled": true,
    "port": 754,
    "listen_address": "192.168.1.10",
    "ssl": true,
    "ssl_key": "/etc/heimdal/hpropd.key",
    "ssl_cert": "/etc/heimdal/hpropd.crt"
  },
  "kdc_http": {
    "enabled": true,
    "port": 749,
    "listen_address": "192.168.1.10",
    "ssl_key": "/etc/heimdal/kdc-http.key",
    "ssl_cert": "/etc/heimdal/kdc-http.crt"
  },
  "kdc_kadmin": {
    "enabled": true,
    "port": 749,
    "listen_address": "0.0.0.0",
    "acl_file": "/etc/heimdal/kadmin.acl"
  },
  "kdc_kadmin_local": {
    "enabled": true,
    "acl_file": "/etc/heimdal/kadmin.local.acl"
  },
  "kdc_hprop": {
    "enabled": true,
    "source": "/var/lib/heimdal-kdc/kdc.database",
    "destinations": [
      "replica1.example.com",
      "replica2.example.com"
    ]
  }
}
