# Leafnode NNTP Server Configuration
# This file is auto-generated by Ansible. Do not edit manually.

# Verbosity/debug level. 0=off, higher values for more verbose logging.
verbosity
{{ debug | default(0) }}

# Enable NNTPS (NNTP over TLS/SSL) service on a dedicated port.
nntps_enabled
{{ nntps_enabled | default(False) }}

{% if nntps_enabled | default(False) %}
# Port for NNTPS (NNTP over TLS). Standard port is 563.
nntps_port
{{ nntps_port | default(563) }}

{% endif %}
# IP address to bind to. Use '127.0.0.1' for loopback-only, or '0.0.0.0' for all interfaces.
listen_address
{{ listen_address | default('0.0.0.0') }}

# NNTP service port. Standard unencrypted NNTP port is 119.
port
{{ port | default(119) }}

# Maximum number of concurrent client connections allowed.
max_connections
{{ max_connections | default(50) }}

# Maximum number of articles to retain per newsgroup (0 = keep all).
max_articles
{{ max_articles | default(10000) }}

# Maximum age of articles in days (0 = keep forever). Older articles are expired.
max_age
{{ max_age | default(30) }}

# Directory where NNTP articles and metadata are stored.
spool_directory
{{ spool_directory | default('/var/spool/news') }}

# Directory for configuration files (e.g., active, newsgroups).
config_directory
{{ config_directory | default('/etc/leafnode') }}

# Enable interactive mode (used for batch article imports or maintenance tasks).
interactive
{{ interactive | default(False) }}

# Enable serving of articles to clients (required for NNTP server mode).
server
{{ server | default(True) }}

# Fully qualified domain name this server advertises. Must resolve to this server's public IP.
fqdn
{{ fqdn | default('localhost.localdomain') }}

# List of upstream NNTP peers to fetch articles from.
{% for peer in peers | default([]) %}
peer
{{ peer }}

{% endfor %}

# List of IP addresses or CIDR subnets allowed to read articles (subscribe, fetch, etc.).
{% for ip in allow_read | default(['127.0.0.0/8', '::1/128']) %}
allow_read
{{ ip }}

{% endfor %}

# List of IP addresses or CIDR subnets allowed to post articles to this server.
{% for ip in allow_post | default(['127.0.0.0/8']) %}
allow_post
{{ ip }}

{% endfor %}

# Default newsgroup to show when user visits root newsgroup list (optional).
default_group
{{ default_group | default('') }}

# Path to Debian-specific config file sourced by cron scripts.
debian_config_path
{{ debian_config_path | default('/etc/news/leafnode/debian-config') }}

# Path to file listing newsgroups to touch (mark as read).
touch_groups_file
{{ touch_groups_file | default('/etc/news/leafnode/touch_groups') }}

# Directory where failed postings are queued for retry.
failed_postings_dir
{{ failed_postings_dir | default('/var/spool/news/failed.postings') }}
