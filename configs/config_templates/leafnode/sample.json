{
  "fqdn": "localhost.localdomain",
  "listen_address": "0.0.0.0",
  "port": 119,
  "nntps_enabled": false,
  "nntps_port": 563,
  "max_connections": 50,
  "max_articles": 10000,
  "max_age": 30,
  "spool_directory": "/var/spool/news",
  "config_directory": "/etc/leafnode",
  "interactive": false,
  "server": true,
  "debug": false,
  "peers": [],
  "allow_read": [
    "127.0.0.0/8",
    "::1/128"
  ],
  "allow_post": [
    "127.0.0.0/8"
  ],
  "default_group": "",
  "debian_config_path": "/etc/news/leafnode/debian-config",
  "touch_groups_file": "/etc/news/leafnode/touch_groups",
  "failed_postings_dir": "/var/spool/news/failed.postings"
}
