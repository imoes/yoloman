{
  "enable_dhcp_source": true,
  "interface": "eth0",
  "allow_local_client": true,
  "allow_lan_clients": true,
  "lan_subnets": [
    "192.168.1.0/24",
    "10.0.0.0/24"
  ],
  "log_dir": "/var/log/chrony",
  "max_log_lines": 12,
  "drift_file": "/var/lib/chrony/chrony.drift",
  "makestep_threshold": 1.0,
  "max_steps": 10,
  "keyfile_path": "/etc/chrony/chrony.keys",
  "enable_hwtimestamp": false,
  "static_servers": [
    {
      "host": "time.google.com",
      "options": [
        "iburst"
      ]
    },
    {
      "host": "0.pool.ntp.org",
      "options": [
        "iburst",
        "prefer"
      ]
    }
  ]
}
