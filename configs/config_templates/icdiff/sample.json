{
  "cols": 120,
  "encoding": "utf-8",
  "exclude_lines": [
    "^\\s*$",
    "^#"
  ],
  "head": 0,
  "highlight": false,
  "labels": [
    "source.py",
    "dest.py"
  ],
  "line_numbers": true,
  "no_bold": false,
  "no_headers": false,
  "output_encoding": "utf-8",
  "recursive": false,
  "report_identical_files": false,
  "show_all_spaces": false,
  "show_no_spaces": false,
  "tabsize": 4,
  "truncate": false,
  "patch": false,
  "unified_numlines": 5,
  "whole_file": false,
  "permissions": false,
  "strip_trailing_cr": true,
  "color_map": "",
  "is_git_diff": false,
  "exclude_patterns": [
    "*.log",
    "tmp/*"
  ]
}
