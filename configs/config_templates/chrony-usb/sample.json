{
  "ntp_servers": [
    {
      "host": "0.pool.ntp.org"
    },
    {
      "host": "1.pool.ntp.org"
    },
    {
      "host": "2.pool.ntp.org"
    }
  ],
  "allow_ntp_clients": true,
  "allow_ntp_clients_subnet": "10.0.0.0/24",
  "enable_hwtimestamp": false,
  "log_dir": "/var/log/chrony",
  "max_log_age_hours": 24,
  "init_stepslew_threshold": 10,
  "init_stepslew_servers": [
    "0.pool.ntp.org",
    "1.pool.ntp.org"
  ],
  "rti_interval": 120,
  "makestep_threshold": 1.0,
  "max_steps": 3,
  "keyfile_path": "/etc/chrony/chrony.keys",
  "command_key": 1,
  "command_port": 323,
  "drift_file_path": "/var/lib/chrony/chrony.drift",
  "rtc_file_path": "/var/lib/chrony/chrony.rtc",
  "leap_seconds_tz": "UTC"
}
