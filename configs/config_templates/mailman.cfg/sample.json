{
  "core.hostname": "lists.example.org",
  "core.spool_dir": "/var/lib/mailman3",
  "core.log_dir": "/var/log/mailman3",
  "core.default_language": "en",
  "core.outgoing_charset": "utf-8",
  "core.max_recipients": 100,
  "database.scheme": "sqlite",
  "database.host": "",
  "database.port": 0,
  "database.name": "/var/lib/mailman3/mailman.db",
  "database.user": "",
  "database.password": "",
  "mta.config": "mailmanMTA:postfix",
  "mta.max_message_size": 20480,
  "mta.incoming_port": 8024,
  "mta.smtp_host": "smtp.example.org",
  "mta.smtp_port": 587,
  "mta.smtp_tls": true,
  "mta.smtp_user": "mailman-smtp",
  "mta.smtp_password": "secret123",
  "mta.additional_hostnames": [
    "lists.sub.example.org",
    "mailinglists.example.net"
  ],
  "archiver.enable": true,
  "api.endpoint": "http://localhost:8001/3.1",
  "api.user": "restadmin",
  "api.password": "supersecret_api_token",
  "logging.level": "INFO",
  "logging.path": "/var/log/mailman3/mailman.log",
  "logging.format": "%(asctime)s (%(process)d) %(levelname)s %(name)s: %(message)s",
  "logging.rotate": true,
  "logging.max_bytes": 10485760,
  "logging.backup_count": 3
}
