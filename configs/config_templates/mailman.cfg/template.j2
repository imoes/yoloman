[core]
# The unique identifier for this Mailman instance
hostname: {{ core.hostname }}

# Path to the Mailman spool directory
spool_dir: {{ core.spool_dir }}

# Path to the Mailman log directory
log_dir: {{ core.log_dir }}

# The default language for new list creation
default_language: {{ core.default_language }}

# The default charset used in outbound email
outgoing_charset: {{ core.outgoing_charset }}

# The maximum number of recipients per message
max_recipients: {{ core.max_recipients }}

[database]
# Database engine (e.g., sqlite, postgresql)
scheme: {{ database.scheme }}

# Database host (empty for sqlite)
host: {{ database.host }}

# Database port (0 for sqlite)
port: {{ database.port }}

# Database name (file path for sqlite)
name: {{ database.name }}

# Database username (ignored for sqlite)
user: {{ database.user }}

# Database password (ignored for sqlite)
password: {{ database.password }}

[mta]
# Path to the Mailman configuration module
config: {{ mta.config }}

# Maximum number of messages processed per cycle
max_message_size: {{ mta.max_message_size }}

# Incoming SMTP port
incoming_port: {{ mta.incoming_port }}

# Outgoing SMTP host
smtp_host: {{ mta.smtp_host }}

# Outgoing SMTP port
smtp_port: {{ mta.smtp_port }}

# Enable SMTP TLS encryption
smtp_tls: {{ mta.smtp_tls }}

# SMTP authentication user (optional)
smtp_user: {{ mta.smtp_user }}

# SMTP authentication password (optional)
smtp_password: {{ mta.smtp_password }}

# List of additional hostnames this instance handles
additional_hostnames:
{% for hostname in mta.additional_hostnames %}    {{ hostname }}
{% endfor %}

[archiver]
# Enable/disable the public archive archiver
enable: {{ archiver.enable }}

[api]
# REST API endpoint base URL
endpoint: {{ api.endpoint }}

# API authentication user
user: {{ api.user }}

# API authentication password
password: {{ api.password }}

[logging]
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
level: {{ logging.level }}

# Path to the main log file
path: {{ logging.path }}

# Log format string
format: {{ logging.format }}

# Enable rotation of log files
rotate: {{ logging.rotate }}

# Maximum size (in bytes) of a log file before rotation
max_bytes: {{ logging.max_bytes }}

# Number of rotated log files to keep
backup_count: {{ logging.backup_count }}
