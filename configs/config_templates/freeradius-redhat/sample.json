{
 "cleanup_delay": 5,
 "correct_escapes": true,
 "exec_prefix": "/usr",
 "hostname_lookups": "no",
 "libdir": "/usr/lib64/freeradius",
 "localstatedir": "/var",
 "log_auth": false,
 "log_auth_badpass": false,
 "log_auth_goodpass": false,
 "log_colourise": true,
 "log_destination": "files",
 "log_stripped_names": false,
 "log_syslog_facility": "daemon",
 "max_request_time": 30,
 "max_requests": 16384,
 "name": "radiusd",
 "prefix": "/usr",
 "proxy_requests": true,
 "sbindir": "/usr/sbin",
 "security_allow_core_dumps": false,
 "security_group": "radiusd",
 "security_limit_proxy_state": "auto",
 "security_max_attributes": 200,
 "security_reject_delay": 1,
 "security_require_message_authenticator": "auto",
 "security_status_server": true,
 "security_user": "radiusd",
 "sysconfdir": "/etc",
 "thread_pool_auto_limit_acct": false,
 "thread_pool_max_requests_per_server": 0,
 "thread_pool_max_servers": 32,
 "thread_pool_max_spare_servers": 10,
 "thread_pool_min_spare_servers": 3,
 "thread_pool_start_servers": 5
}
