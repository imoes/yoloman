# ==============================================================================
# tcpreplay Configuration Template
#
# This template generates a configuration file for tcpreplay, a tool used to
# replay network packet captures (PCAPs) to test network performance and behavior.
#
# Variables are sourced from Ansible variables defined in your role/playbook.
# All variables have sensible defaults based on the tcpreplay application schema.
# ==============================================================================

# ------------------------------------------------------------------------------
# Debugging and Output Control
# ------------------------------------------------------------------------------

# Debug verbosity level (0-5). 0 disables debugging.
# Corresponds to: --dbug=<number>
debug_level = {{ debug_level | default(0) }}

# Quiet mode: Print nothing except final statistics.
# Corresponds to: -q / --quiet
quiet_mode = {{ quiet_mode | default(False) }}

# Verbose mode: Print decoded packets via tcpdump.
# Corresponds to: -v / --verbose
verbose_mode = {{ verbose_mode | default(False) }}

# Additional arguments to pass to the tcpdump decoder.
# Corresponds to: -A <string> / --decode=<string>
# Example: "-axxx" to include ascii hex dump.
tcpdump_args = "{{ tcpdump_args | default('') }}"

# ------------------------------------------------------------------------------
# Timing and Performance
# ------------------------------------------------------------------------------

# Packet timing method: select, ioport, gtod, or nano.
# Corresponds to: -T <string> / --timer=<string>
timer_mode = "{{ timer_mode | default('gtod') }}"

# Preload packets into RAM before sending to reduce I/O latency.
# Corresponds to: -K / --preload-pcap
preload_pcap = {{ preload_pcap | default(False) }}

# Cache file for splitting traffic across two interfaces.
# Corresponds to: -c <string> / --cachefile=<string>
cachefile = "{{ cachefile | default('') }}"

# ------------------------------------------------------------------------------
# Network Interfaces
# ------------------------------------------------------------------------------

# Primary network interface for sending traffic.
# Corresponds to: -i <string> / --intf1=<string>
intf1 = "{{ intf1 | default('eth0') }}"

# Secondary network interface for bi-directional replay.
# Corresponds to: -I <string> / --intf2=<string>
intf2 = "{{ intf2 | default('') }}"

# Replay two files simultaneously from a network tap.
# Corresponds to: -2 / --dualfile
# Note: Mutually exclusive with cachefile.
dualfile = {{ dualfile | default(False) }}

# ------------------------------------------------------------------------------
# Loop and Duration Controls
# ------------------------------------------------------------------------------

# Number of times to loop through the capture file.
# Corresponds to: -l <number> / --loop=<number>
loop_count = {{ loop_count | default(1) }}

# Delay in milliseconds between loop iterations.
# Corresponds to: --loopdelay-ms=<number>
loop_delay_ms = {{ loop_delay_ms | default(0) }}

# Delay in nanoseconds between loop iterations.
# Corresponds to: --loopdelay-ns=<number>
loop_delay_ns = {{ loop_delay_ns | default(0) }}

# Maximum number of packets to send. -1 sends all.
# Corresponds to: -L <number> / --limit=<number>
packet_limit = {{ packet_limit | default(-1) }}

# Maximum duration in seconds. -1 sends for all time.
# Corresponds to: --duration=<number>
duration_seconds = {{ duration_seconds | default(-1) }}

# ------------------------------------------------------------------------------
# Speed and Rate Controls
# ------------------------------------------------------------------------------

# Replay speed multiplier (e.g., '2.0'). Mutually exclusive with pps/mbps/topspeed.
# Corresponds to: -x <string> / --multiplier=<string>
speed_multiplier = "{{ speed_multiplier | default('') }}"

# Packets per second rate. Mutually exclusive with multiplier/mbps/topspeed.
# Corresponds to: -p <string> / --pps=<string>
pps_rate = "{{ pps_rate | default('') }}"

# Megabits per second rate. Mutually exclusive with multiplier/pps/topspeed.
# Corresponds to: -M <string> / --mbps=<string>
mbps_rate = "{{ mbps_rate | default('') }}"

# Replay at maximum hardware speed.
# Corresponds to: -t / --topspeed
topspeed = {{ topspeed | default(False) }}

# ------------------------------------------------------------------------------
# Advanced Options
# ------------------------------------------------------------------------------

# Replay one packet at a time, waiting for user input.
# Corresponds to: -o / --oneatatime
oneatatime = {{ oneatatime | default(False) }}

# Number of packets to send per interval for high pps rates.
# Corresponds to: --pps-multi=<number>
pps_multi = {{ pps_multi | default(1) }}

# Modify IPs each loop to generate unique flows.
# Corresponds to: --unique-ip
unique_ip = {{ unique_ip | default(False) }}

# Number of loops before assigning new unique IP (requires unique_ip).
# Corresponds to: --unique-ip-loops=<string>
unique_ip_loops = "{{ unique_ip_loops | default('1') }}"

# Enable netmap support for direct adapter access.
# Corresponds to: --netmap
netmap = {{ netmap | default(False) }}

# Netmap startup delay in seconds.
# Corresponds to: --nm-delay=<number>
nm_delay = {{ nm_delay | default(10) }}

# Suppress flow statistics collection and printing.
# Corresponds to: --no-flow-stats
no_flow_stats = {{ no_flow_stats | default(False) }}

# Flow expiry time in seconds (0 for no expiry).
# Corresponds to: --flow-expiry=<number>
flow_expiry = {{ flow_expiry | default(0) }}

# Print statistics every X seconds (0 for every loop).
# Corresponds to: --stats=<number>
stats_interval = {{ stats_interval | default(0) }}

# Suppress printing of warning messages.
# Corresponds to: -W / --suppress-warnings
suppress_warnings = {{ suppress_warnings | default(False) }}

# Enable AF_XDP support for direct adapter access.
# Corresponds to: --xdp
xdp = {{ xdp | default(False) }}

# Maximum packets submitted to AF_XDP TX ring at once.
# Corresponds to: --xdp-batch-size=<number>
xdp_batch_size = {{ xdp_batch_size | default(25) }}

# ------------------------------------------------------------------------------
# Input Files
# ------------------------------------------------------------------------------

# List of PCAP files or directories to replay.
# Corresponds to: <pcap_file(s)> argument
# Format: space-separated list of paths.
pcap_files = {{ pcap_files | default([]) | join(' ') }}