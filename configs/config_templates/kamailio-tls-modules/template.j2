#
# Kamailio TLS Modules Configuration
#
# This template configures TLS server and client profiles for Kamailio.
# It defines default profiles for incoming (server) and outgoing (client)
# connections, along with example profiles for loopback, specific SIP
# endpoints, and SNI-based domain matching.
#
# Security Note: By default, public-facing server profiles disable
# client certificate verification to avoid blocking standard SIP clients,
# but enforce TLSv1.2+. Loopback and specific internal profiles may
# enforce stricter verification.
#

# ---
# Default Server Profile
# Used for all incoming TLS connections that do not match any other
# server domain defined below.
# Enforces TLSv1.2+ for public internet security.
#
[server:default]
# Protocol method: Enforce TLS 1.2 and higher
method = TLSv1.2+
# Whether to verify the certificate of the peer server in this profile.
# Default 'no' allows connections without strict peer cert validation,
# suitable for standard SIP clients that may not present certs.
verify_certificate = {{ verify_certificate_server_default | default('no') }}
# Whether to require the peer to present a certificate.
# Default 'no' means the peer can connect without a client certificate.
require_certificate = {{ require_certificate_server_default | default('no') }}
# Path to the private key file for the server's identity.
# Must be readable by the Kamailio process user.
private_key = {{ tls_server_default_private_key | default('/etc/kamailio/kamailio-selfsigned.key') }}
# Path to the certificate file for the server's identity.
certificate = {{ tls_server_default_certificate | default('/etc/kamailio/kamailio-selfsigned.pem') }}
# Path to the CA list file used to verify peer certificates (if enabled).
ca_list = {{ tls_server_default_ca_list | default('/etc/kamailio/tls/cacert.pem') }}
# Path to the CRL (Certificate Revocation List) file.
crl = {{ tls_server_default_crl | default('/etc/kamailio/tls/crl.pem') }}

# ---
# Default Client Profile
# Used for all outgoing TLS connections that do not match any other
# client domain defined below.
#
[client:default]
# Protocol method: Uses system default or inherits from global config.
# Typically TLSv1.2+ is recommended.
#method = TLSv1.2+
# Whether to verify the certificate of the remote server.
# Default 'yes' ensures we connect only to trusted servers.
verify_certificate = {{ verify_certificate_client_default | default('yes') }}
# Whether to require the remote server to present a certificate.
# Default 'yes' prevents connections to servers without valid certs.
require_certificate = {{ require_certificate_client_default | default('yes') }}

# ---
# Loopback Server Profile
# Specific settings for TLS connections received from the loopback interface.
# Allows TLSv1.2+, does not require client certs by default, but validates
# them if present. Uses dedicated local certificates.
#
#[server:127.0.0.1:5061]
#method = TLSv1.2+
#verify_certificate = yes
#require_certificate = no
# Path to the private key for the loopback server identity.
private_key = {{ tls_server_loopback_private_key | default('/etc/kamailio/tls/local_key.pem') }}
# Path to the certificate for the loopback server identity.
certificate = {{ tls_server_loopback_certificate | default('/etc/kamailio/tls/local_cert.pem') }}
#verify_depth = 3
# Path to the CA list for validating loopback peer certificates.
ca_list = {{ tls_server_loopback_ca_list | default('/etc/kamailio/tls/local_ca.pem') }}
# Path to the CRL for loopback peer validation.
crl = {{ tls_server_loopback_crl | default('/etc/kamailio/tls/local_crl.pem') }}
#server_name = kamailio.org
#server_id = kamailio.org

# ---
# Example Client Profile
# Special settings for connecting to an external SIP server (example.sip / 1.2.3.4).
# Demonstrates configuration for a server that uses SSL client certificate
# authentication.
# NOTE: verify_certificate is disabled here as per the original example's
# intent (expired certs on external server), but this is INSECURE for production.
#
#[client:1.2.3.4:5061]
#verify_certificate = no
# Path to the private key for authenticating as the client.
private_key = {{ tls_client_example_private_key | default('/etc/kamailio/tls/example_key.pem') }}
# Path to the client certificate used for authentication.
certificate = {{ tls_client_example_certificate | default('/etc/kamailio/tls/example_cert.pem') }}
# Path to the CA list used to verify the remote server's certificate.
ca_list = {{ tls_client_example_ca_list | default('/etc/kamailio/tls/example_ca.pem') }}
# Path to the CRL for verifying the remote server's certificate revocation status.
crl = {{ tls_client_example_crl | default('/etc/kamailio/tls/example_crl.pem') }}
#server_name = example.sip
#server_id = example.sip

# ---
# Any-Domain Server Profile
# Example server profile for listening on any IP/port using SNI (Server Name Indication).
# Matches domain and subdomains (server_name_mode = 1).
# Requires 'server_name' to match the SNI extension from the client.
#
#[server:any]
#method = TLSv1.2+
#verify_certificate = yes
#require_certificate = no
# Path to the private key for the any-domain server identity.
private_key = {{ tls_server_any_domain_private_key | default('/etc/kamailio/tls/mysipserver_org_key.pem') }}
# Path to the certificate for the any-domain server identity.
certificate = {{ tls_server_any_domain_certificate | default('/etc/kamailio/tls/mysipserver_org_cert.pem') }}
#verify_depth = 3
# Path to the CA list for validating peers in this profile.
ca_list = {{ tls_server_any_domain_ca_list | default('/etc/kamailio/tls/mysipserver_org_ca.pem') }}
# Path to the CRL for this profile.
crl = {{ tls_server_any_domain_crl | default('/etc/kamailio/tls/mysipserver_org_crl.pem') }}
#server_name = mysipserver.org
#server_name_mode = 1
#server_id = mysipserver.org

# ---
# Any-Subdomain Server Profile
# Example server profile for listening on any IP/port using SNI.
# Matches ONLY subdomains (server_name_mode = 2).
#
#[server:any]
#method = TLSv1.2+
#verify_certificate = yes
#require_certificate = no
# Path to the private key for the any-subdomain server identity.
private_key = {{ tls_server_any_subdomain_private_key | default('/etc/kamailio/tls/mysipserver_net_key.pem') }}
# Path to the certificate for the any-subdomain server identity.
certificate = {{ tls_server_any_subdomain_certificate | default('/etc/kamailio/tls/mysipserver_net_cert.pem') }}
#verify_depth = 3
# Path to the CA list for validating peers in this profile.
ca_list = {{ tls_server_any_subdomain_ca_list | default('/etc/kamailio/tls/mysipserver_net_ca.pem') }}
# Path to the CRL for this profile.
crl = {{ tls_server_any_subdomain_crl | default('/etc/kamailio/tls/mysipserver_net_crl.pem') }}
#server_name = mysipserver.net
#server_name_mode = 2
#server_id = mysipserver.net
