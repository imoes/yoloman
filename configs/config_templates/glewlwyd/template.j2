# Logrotate configuration for glewlwyd daemon logs.
# This file is managed by Ansible. Do not edit manually.

/var/log/glewlwyd.log {
    # Rotate logs daily to prevent unbounded log growth.
    daily

    # Keep the 7 most recent rotated log files.
    rotate {{ rotate | default(7) }}

    # Do not return an error if the log file is missing.
    missingok

    # Create new log files with specified permissions and ownership.
    # Owner: The system user running the glewlwyd daemon.
    # Group: 'nogroup' (or 'nogroup' equivalent on the target system).
    create {{ create_mode | default('640') }} {{ init_user | default('glewlwyd') }} nogroup

    # Compress rotated log files to save disk space.
    compress
}
