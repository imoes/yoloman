{
  "bind_address": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "Network interface to bind the server to (e.g., '127.0.0.1' for localhost only)."
  },
  "port": {
    "type": "number",
    "default": 8080,
    "description": "HTTP port on which the server listens."
  },
  "db": {
    "type": "object",
    "default": {
      "type": "sqlite",
      "sqlite": {
        "path": "/var/lib/glewlwyd/glewlwyd.db"
      }
    },
    "description": "Database backend configuration. One of: sqlite, postgresql, mongodb, ldap.",
    "items": {
      "type": {
        "type": "string",
        "enum": [
          "sqlite",
          "postgresql",
          "mongodb",
          "ldap"
        ]
      },
      "sqlite": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path to SQLite database file."
          }
        }
      },
      "postgresql": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "description": "PostgreSQL hostname"
          },
          "port": {
            "type": "number",
            "description": "PostgreSQL port (typically 5432)"
          },
          "name": {
            "type": "string",
            "description": "Database name"
          },
          "user": {
            "type": "string",
            "description": "Database user"
          },
          "password": {
            "type": "string",
            "description": "Database password",
            "secret": true
          },
          "ssl_mode": {
            "type": "string",
            "enum": [
              "disable",
              "allow",
              "prefer",
              "require"
            ],
            "description": "SSL mode for PostgreSQL connection"
          }
        }
      },
      "mongodb": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "MongoDB connection URI"
          },
          "database": {
            "type": "string",
            "description": "MongoDB database name"
          }
        }
      },
      "ldap": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "LDAP server URI (ldap:// or ldaps://)"
          },
          "base_dn": {
            "type": "string",
            "description": "Base DN for user/group searches"
          },
          "bind_dn": {
            "type": "string",
            "description": "DN to bind for searches"
          },
          "bind_password": {
            "type": "string",
            "description": "Password for bind DN",
            "secret": true
          },
          "user_search_base": {
            "type": "string",
            "description": "Search base for user entries"
          },
          "user_search_filter": {
            "type": "string",
            "description": "LDAP filter for users (e.g., '(objectClass=person)')"
          },
          "group_search_base": {
            "type": "string",
            "description": "Search base for group entries"
          },
          "group_search_filter": {
            "type": "string",
            "description": "LDAP filter for groups"
          }
        }
      },
      "schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "glewlwyd",
              "keycloak",
              "custom"
            ],
            "description": "Schema type"
          },
          "path": {
            "type": "string",
            "description": "Path to custom schema JSON file (if type=custom)"
          }
        }
      }
    }
  },
  "jwt": {
    "type": "object",
    "default": {
      "secret": "CHANGE_ME_SECRET",
      "algorithm": "HS256",
      "expiration": 3600,
      "refresh_expiration": 86400,
      "issuer": "https://sso.example.com",
      "audience": ""
    },
    "description": "JWT token configuration. Replace 'secret' with a secure, random string in production."
  },
  "oauth2": {
    "type": "object",
    "default": {
      "authorization_endpoint": "/oauth2/authorize",
      "token_endpoint": "/oauth2/token",
      "userinfo_endpoint": "/oauth2/userinfo",
      "jwks_uri": "/oauth2/jwks",
      "response_types_supported": [
        "code",
        "id_token",
        "token"
      ],
      "grant_types_supported": [
        "authorization_code",
        "refresh_token",
        "password"
      ],
      "subject_types_supported": [
        "public",
        "pairwise"
      ],
      "id_token_signing_alg_values_supported": [
        "RS256",
        "HS256"
      ],
      "scopes_supported": [
        "openid",
        "profile",
        "email",
        "offline_access"
      ],
      "claims_supported": [
        "sub",
        "name",
        "email",
        "picture",
        "groups"
      ]
    },
    "description": "OAuth2 / OpenID Connect provider metadata exposed via .well-known/openid-configuration."
  },
  "ui": {
    "type": "object",
    "default": {
      "enabled": true,
      "path": "/ui",
      "theme": "light",
      "logo": ""
    },
    "description": "Web-based admin and user UI configuration."
  },
  "auth_sources": {
    "type": "list",
    "default": [
      {
        "name": "local",
        "type": "password",
        "priority": 1,
        "password": {
          "hash_algorithm": "bcrypt",
          "min_length": 10
        },
        "mandatory": true
      }
    ],
    "description": "List of authentication sources (e.g., local password, LDAP, OAuth2). Evaluated in priority order.",
    "items": {
      "name": {
        "type": "string",
        "description": "Unique name for the source"
      },
      "type": {
        "type": "string",
        "enum": [
          "password",
          "ldap",
          "oauth2",
          "oidc"
        ],
        "description": "Source type"
      },
      "priority": {
        "type": "number",
        "description": "Priority (lower = first tried)"
      },
      "mandatory": {
        "type": "boolean",
        "description": "If true, user must authenticate via this source",
        "default": false
      },
      "optional_fields": {
        "type": "list",
        "description": "User attributes that may be optional (e.g., ['email'])",
        "default": []
      },
      "profile_mapping": {
        "type": "object",
        "description": "Mapping of source attributes to internal user fields",
        "default": {}
      },
      "password": {
        "type": "object",
        "description": "Password source config",
        "items": {
          "hash_algorithm": {
            "type": "string",
            "enum": [
              "bcrypt",
              "scrypt",
              "argon2",
              "pbkdf2"
            ],
            "description": "Hash algorithm"
          },
          "min_length": {
            "type": "number",
            "description": "Minimum password length"
          }
        }
      },
      "ldap": {
        "type": "object",
        "description": "LDAP source config",
        "items": {
          "bind_dn": {
            "type": "string"
          },
          "bind_password": {
            "type": "string",
            "secret": true
          },
          "uri": {
            "type": "string"
          },
          "base_dn": {
            "type": "string"
          },
          "user_filter": {
            "type": "string"
          },
          "group_filter": {
            "type": "string"
          },
          "group_name_attr": {
            "type": "string",
            "default": "cn"
          },
          "user_name_attr": {
            "type": "string",
            "default": "uid"
          },
          "user_mail_attr": {
            "type": "string",
            "default": "mail"
          },
          "start_tls": {
            "type": "boolean",
            "default": false
          },
          "verify_certificate": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "oauth2": {
        "type": "object",
        "description": "OAuth2 source config",
        "items": {
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string",
            "secret": true
          },
          "authorization_url": {
            "type": "string"
          },
          "token_url": {
            "type": "string"
          },
          "userinfo_url": {
            "type": "string"
          },
          "scope": {
            "type": "list",
            "items": {
              "type": "string"
            }
          },
          "user_id_attr": {
            "type": "string"
          },
          "user_name_attr": {
            "type": "string"
          },
          "user_mail_attr": {
            "type": "string"
          },
          "login_color": {
            "type": "string"
          },
          "login_text": {
            "type": "string"
          }
        }
      },
      "oidc": {
        "type": "object",
        "description": "OIDC source config",
        "items": {
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string",
            "secret": true
          },
          "issuer": {
            "type": "string"
          },
          "authorization_url": {
            "type": "string"
          },
          "token_url": {
            "type": "string"
          },
          "userinfo_url": {
            "type": "string"
          },
          "jwks_url": {
            "type": "string"
          },
          "scope": {
            "type": "list",
            "items": {
              "type": "string"
            }
          },
          "user_id_attr": {
            "type": "string"
          },
          "user_name_attr": {
            "type": "string"
          },
          "user_mail_attr": {
            "type": "string"
          },
          "login_color": {
            "type": "string"
          },
          "login_text": {
            "type": "string"
          }
        }
      }
    }
  },
  "mfa": {
    "type": "object",
    "default": {
      "enabled": true,
      "methods": [
        {
          "name": "totp",
          "type": "totp",
          "totp": {
            "issuer": "Glewlwyd SSO",
            "period": 30,
            "digits": 6
          }
        },
        {
          "name": "email_otp",
          "type": "email",
          "email": {
            "smtp_host": "smtp.example.com",
            "smtp_port": 587,
            "smtp_user": "otp@example.com",
            "smtp_password": "CHANGE_ME",
            "from_address": "noreply@example.com",
            "subject": "Your login code",
            "body": "Your one-time code is: {{ code }}"
          }
        }
      ],
      "required_for_users_with_mfa": false
    },
    "description": "Multi-factor authentication configuration.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable MFA globally"
      },
      "methods": {
        "type": "list",
        "items": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "totp",
              "sms",
              "email",
              "webauthn"
            ]
          },
          "totp": {
            "type": "object",
            "items": {
              "issuer": {
                "type": "string"
              },
              "period": {
                "type": "number"
              },
              "digits": {
                "type": "number",
                "enum": [
                  6,
                  8
                ]
              }
            }
          },
          "sms": {
            "type": "object",
            "items": {
              "provider": {
                "type": "string"
              },
              "account_sid": {
                "type": "string",
                "secret": true
              },
              "auth_token": {
                "type": "string",
                "secret": true
              },
              "from": {
                "type": "string"
              }
            }
          },
          "email": {
            "type": "object",
            "items": {
              "smtp_host": {
                "type": "string"
              },
              "smtp_port": {
                "type": "number"
              },
              "smtp_user": {
                "type": "string"
              },
              "smtp_password": {
                "type": "string",
                "secret": true
              },
              "from_address": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          },
          "webauthn": {
            "type": "object",
            "items": {
              "rp_name": {
                "type": "string"
              },
              "rp_id": {
                "type": "string"
              },
              "timeout": {
                "type": "number"
              },
              "attestation": {
                "type": "string",
                "enum": [
                  "none",
                  "direct"
                ]
              },
              "user_verification": {
                "type": "string",
                "enum": [
                  "required",
                  "preferred",
                  "discouraged"
                ]
              }
            }
          }
        }
      },
      "required_for_users_with_mfa": {
        "type": "boolean",
        "description": "If true, users with MFA configured must use it on every login"
      }
    }
  },
  "logging": {
    "type": "object",
    "default": {
      "level": "info",
      "format": "json",
      "file": "/var/log/glewlwyd/glewlwyd.log",
      "stdout": true
    },
    "description": "Logging configuration. Format 'json' is recommended for log aggregation."
  },
  "security": {
    "type": "object",
    "default": {
      "csp_enabled": true,
      "csp_policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none';",
      "hsts_enabled": true,
      "hsts_max_age": 31536000,
      "x_frame_options": "DENY",
      "x_content_type_options": "nosniff"
    },
    "description": "Security headers and CSP configuration for the web interface."
  },
  "session": {
    "type": "object",
    "default": {
      "timeout": 28800,
      "idle_timeout": 900,
      "cookie_secure": true,
      "cookie_httponly": true,
      "cookie_samesite": "Strict"
    },
    "description": "Session cookie configuration."
  },
  "rate_limit": {
    "type": "object",
    "default": {
      "enabled": true,
      "max_requests": 100,
      "window_seconds": 60
    },
    "description": "Global rate limiting (requests per window) to prevent abuse."
  },
  "cors": {
    "type": "object",
    "default": {
      "allowed_origins": [
        "https://app.example.com"
      ],
      "allowed_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allowed_headers": [
        "Authorization",
        "Content-Type",
        "X-Requested-With"
      ],
      "expose_headers": [
        "WWW-Authenticate"
      ],
      "max_age": 86400,
      "allow_credentials": true
    },
    "description": "CORS settings for API access. Restrict 'allowed_origins' to trusted domains."
  }
}
