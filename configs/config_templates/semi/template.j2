;;; 51semi.el --- Debian semi startup file  -*-mode: emacs-lisp;-*-
;;
;; Self-documenting configuration for the `semi` package in Emacs.
;; This script is automatically generated by Ansible. Do not edit manually.
;;
;; Description:
;;   Configures the semi package's Emacs flavor name during Debian package
;;   installation and initialization.
;;
;; Dependencies:
;;   - Requires the `emacsen-common` infrastructure to be installed.
;;   - Relies on Debian-specific Emacs hooks (`debian-pkg-add-load-path-item`).
;;
;; Variables:
;;   {{ flavor_name_default | default('emacs') }} : The default Emacs flavor
;;   name (e.g., 'emacs', 'emacs24') used if `debian-emacs-flavor` is not
;;   explicitly bound by the caller.

(let* ((pkg "semi")
       ;; Determine the Emacs flavor name.
       ;; If the variable `debian-emacs-flavor` is set in the Emacs environment,
       ;; use it; otherwise, fall back to the configured default.
       (flavor-name (if (boundp 'debian-emacs-flavor)
                        (symbol-name debian-emacs-flavor)
                      "{{ flavor_name_default | default('emacs') }}"))
       
       ;; Path to the Debian emacsen-common package installer script for this package.
       (pkg-inst (concat "/usr/lib/emacsen-common/packages/install/" pkg))
       
       ;; Directory where the package's Emacs Lisp files reside for this flavor.
       (elc-dir (concat "/usr/share/" flavor-name "/site-lisp/" pkg)))

  ;; Check if the required directories and scripts exist before proceeding.
  (when (and (file-exists-p elc-dir)
             (file-exists-p pkg-inst))
    
    ;; Add the package's Lisp directory to Emacs' load path so it can be found.
    (if (fboundp 'debian-pkg-add-load-path-item)
        ;; Use the Debian-specific helper if available (Debian Emacs packages).
        (debian-pkg-add-load-path-item elc-dir)
      
      ;; Fallback for standard Emacs installations: manually cons the path onto load-path.
      (setq load-path (cons elc-dir load-path)))
    
    ;; Note: The original template had a comment here indicating the end of
    ;; the installation logic block. The `semi` package installer script
    ;; (`pkg-inst`) is triggered by emacsen-common, not explicitly here.
    ))

;;; 51semi.el ends here
