# Desktop entry for the Ayatana Indicator Keyboard service.
# This file defines how the application appears in desktop environments
# that support Unity, MATE, or XFCE panels.

[Desktop Entry]
# Type of desktop file. Must be Application for standard apps.
Type=Application

# Display name of the application in the GUI.
Name=Ayatana Indicator Keyboard

# Command to execute. Uses the configured subdirectory and executable name.
# Path construction: /usr/libexec/<service_subdir>/<executable_name>
Exec=/usr/libexec/{{ service_subdir | default('ayatana-indicator-keyboard') }}/{{ executable_name | default('ayatana-indicator-keyboard-service') }}

# Semicolon-separated list of desktop environments where this app is shown.
# Includes Unity, MATE, and XFCE.
OnlyShowIn=Unity;MATE;XFCE;

# Hide the application from application menus; only show in indicators/panels.
NoDisplay=true

# Do not show a startup notification dialog.
StartupNotify=false

# Do not open a terminal window for this application.
Terminal=false
