# Desktop entry for the Ayatana Indicator Keyboard service.
# This file installs the application launcher and service handler.
[Desktop Entry]
# Type of entry; must be Application for services launched via Desktop entries.
Type=Application
# Display name shown in menus and launchers.
Name=Ayatana Indicator Keyboard
# Path to the executable. The service_subdir defaults to the package name to avoid collisions.
Exec=/usr/libexec/{{ service_subdir | default('ayatana-indicator-keyboard') }}/{{ executable_name | default('ayatana-indicator-keyboard-service') }}
# Comma-separated list of desktop environments where this entry should appear.
OnlyShowIn=Unity;MATE;XFCE;
# Hide the entry from standard application menus (used for background services).
NoDisplay=true
# Prevent startup notification dialogs from appearing for this service.
StartupNotify=false
# Do not open a terminal window for this application.
Terminal=false