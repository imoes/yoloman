{
 "allow_plaintext_credentials": false,
 "auth_method": "Basic",
 "auto_sync": true,
 "collection_path": "",
 "collections": [
  {
   "display_name": "Personal Calendar",
   "mime_type": "text/calendar",
   "name": "default"
  },
  {
   "display_name": "Work Calendar",
   "mime_type": "text/calendar",
   "name": "work"
  }
 ],
 "custom_headers": [
  {
   "name": "X-Client-Name",
   "value": "Lomiri Online Accounts"
  },
  {
   "name": "X-Device-Name",
   "value": "{{ username }}-mobile"
  }
 ],
 "display_name": "Nextcloud CalDAV",
 "enable_discovery": true,
 "request_timeout": 25,
 "server_url_template": "https://cloud.example.com/remote.php/dav/",
 "sync_interval": 1800,
 "use_ssl": true,
 "username": ""
}
