# Main configuration for the generic CalDAV plugin for Lomiri Online Accounts
# Enables support for generic CalDAV servers (e.g., self-hosted calendars)

[General]
# Plugin identifier — must match the package name
PluginName=caldav-generic

# Human-readable display name shown in account setup UI
DisplayName={{ display_name }}

# URL template for the CalDAV server — {{ username }} is substituted at runtime
ServerURL={{ server_url_template }}

# Whether to use SSL/TLS for connection (true recommended)
UseSSL={{ use_ssl }}

# Whether to attempt WebDAV discovery (e.g., /.well-known/caldav) before using ServerURL
EnableDiscovery={{ enable_discovery }}

# Optional: path prefix for CalDAV collections (e.g., /calendars/users/{{ username }}/)
CollectionPath={{ collection_path | default('') }}

# Authentication method: Basic, OAuth2, or Token (if supported by server)
AuthMethod={{ auth_method }}

# Whether to store credentials in plaintext (dangerous — only if secure storage unavailable)
Allow plaintext storage
AllowPlaintextCredentials={{ allow_plaintext_credentials | default(false) }}

# Timeout (seconds) for HTTP requests to the server
RequestTimeout={{ request_timeout }}

# Whether to auto-sync calendar changes (true recommended)
AutoSync={{ auto_sync }}

# Sync interval (seconds); 0 disables periodic sync (manual-only)
SyncInterval={{ sync_interval }}

# Supported calendar collections to display in UI
{% for collection in collections %}
# {{ collection.display_name }} — MIME type: {{ collection.mime_type | default('text/calendar') }}
[Collection {{ loop.index }}]
Name={{ collection.name }}
DisplayName={{ collection.display_name }}
{% if collection.mime_type %}MIMEType={{ collection.mime_type }}{% endif %}
{% endfor %}

# Optional: custom headers (e.g., for proxy auth or special headers)
{% for header in custom_headers %}
# Custom HTTP header: {{ header.name }} = {{ header.value | replace('\n', ' ') | replace('\r', '') }}
{% endfor %}
{% if custom_headers %}[CustomHeaders]
{% for header in custom_headers %}{{ header.name }}={{ header.value | replace('\n', ' ') | replace('\r', '') }}
{% endfor %}{% endif %}