# =============================================================================
# VNCDoTool Command Script Configuration
# =============================================================================
# This template generates a script of VNC commands for vncdotool.
# It iterates over a list of actions defined in the 'actions' variable.
# Each action must be a map containing:
#   - command: The VNC command to execute (e.g., 'key', 'type', 'move', 'click')
#   - args: A list of arguments for that command.
# =============================================================================

{% for action in actions | default([]) %}
# Action: {{ action.command | default('unknown') }}
# Arguments: {{ action.args | default([]) | join(' ') }}
{{ action.command }}{% for arg in action.args | default([]) %} {{ arg }}{% endfor %}
{% endfor %}