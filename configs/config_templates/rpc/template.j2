# /etc/rpc: Service port mappings for RPC-based network services
# Format: service_name port_number/protocol [aliases...]
# Lines starting with '#' are comments

# RPC port assignments registered with IANA
{% for service in services %}{{ service.name }}	{{ service.port }}/{{ service.protocol }}{% if service.aliases %} #{{ service.aliases | join(', ') }}{% endif %}{% endfor %}

