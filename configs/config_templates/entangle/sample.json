{
  "autostart": true,
  "log_level": 2,
  "image_dir": "/var/lib/entangle/images",
  "device_timeout": 15,
  "max_queue_size": 30,
  "camera_models": [
    {
      "name": "Canon EOS R5",
      "model": "Canon EOS R5",
      "driver": "gphoto2",
      "port": "/dev/bus/usb/001/014"
    },
    {
      "name": "Nikon D850",
      "model": "Nikon D850",
      "driver": "gphoto2",
      "port": "/dev/ttyACM0",
      "baudrate": 38400
    }
  ],
  "trigger": {
    "timed_capture": true,
    "timed_capture_interval": 60,
    "external_trigger": true,
    "external_trigger_pin": 23
  },
  "export": {
    "format": "jpeg",
    "quality": 95,
    "post_process_cmd": "exiftool -overwrite_original -Artist='Entangle Capture' $FILE",
    "delete_raw_after_export": false
  },
  "web": {
    "bind": "0.0.0.0",
    "port": 8080,
    "enabled": true,
    "auth_user": "admin"
  }
}
