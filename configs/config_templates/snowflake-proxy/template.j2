# Configuration file for snowflake-proxy
# Managed by configuration management system

# URL for the Snowflake broker to discover clients.
# Specifies the endpoint the proxy contacts to find available Tor clients.
broker: {{ broker_url | default('https://snowflake-broker.torproject.net/') }}

# Maximum number of concurrent WebRTC client connections.
# Limits resource usage by capping simultaneous peer connections.
capacity: {{ capacity | default(10) }}

# Path to the log file. Use "" for stdout.
# If empty, logs are written to standard output; otherwise to the specified file.
log: {{ log_file | default('') }}

# URL of the websocket relay server.
# Used for forwarding traffic between clients and the Tor network.
relay: {{ relay_url | default('wss://snowflake.torproject.net/') }}

# URL of the STUN server for NAT traversal.
# Used by WebRTC to discover public IP addresses and ports.
stun: {{ stun_url | default('stun:stun.l.google.com:19302') }}

# Enable logging of sensitive data (unsafe).
# If true, sensitive information may appear in logs. Keep false in production.
unsafe_logging: {{ unsafe_logging | default(false) }}