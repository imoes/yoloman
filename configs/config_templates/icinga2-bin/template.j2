# Icinga2 Bin: Initscript Configuration Template
#
# This template configures the default arguments for the Icinga2 daemon,
# specifically pointing the error log to the configured file path.
# It is designed for use within an Ansible role managing Icinga2 binaries or services.

# Path to the Icinga2 error log file.
# Default: /var/log/icinga2/icinga2.err
# The daemon arguments string includes the -e flag followed by this path.
DAEMON_ARGS="-e {{ icinga2_log_file | default('/var/log/icinga2/icinga2.err') }}"