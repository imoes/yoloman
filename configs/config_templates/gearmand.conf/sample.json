{
  "bind_address": "127.0.0.1",
  "bind_port": 4730,
  "log_file": "/var/log/gearmand.log",
  "log_level": "WARNING",
  "worker_timeout": 30,
  "max_threads": 4,
  "queue_type": "sqlite",
  "queue_size": 10000,
  "sqlite_db": "/var/lib/gearmand/gearmand.db",
  "sqlite_queue_table": "gearman_queue",
  "pid_file": "/run/gearmand.pid",
  "foreground": false,
  "workers": [
    {
      "executable": "/opt/gearman-workers/worker.sh",
      "function": "reverse"
    },
    {
      "executable": "/opt/gearman-workers/image-resizer.py"
    }
  ]
}
