# ===========================================================================
# Irssi Configuration Template
# This file configures servers, chatnets, channels, aliases, and statusbars
# for the Irssi IRC client.
# ===========================================================================

# ---------------------------------------------------------------------------
# Server Definitions
# Each server block defines an IRC/SILC connection.
# ---------------------------------------------------------------------------

# List of servers to connect to
servers = (

# --- DALnet Server ---
# Address for DALnet server
  { address = "{{ server_0_address | default('irc.dal.net') }}";
    chatnet = "DALnet";
    # Port for DALnet server
    port = "{{ server_0_port | default('6667') }}";
  },

# --- EFNet Server ---
# Address for EFNet server
  { address = "{{ server_1_address | default('ssl.efnet.org') }}";
    chatnet = "EFNet";
    # Port for EFNet server
    port = "{{ server_1_port | default('9999') }}";
    # Whether to use TLS for EFNet server
    use_tls = "{{ server_1_use_tls | default('yes') }}";
    # Whether to verify TLS for EFNet server
    tls_verify = "{{ server_1_tls_verify | default('no') }}";
  },

