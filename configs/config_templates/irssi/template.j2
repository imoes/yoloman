# ---------------------------------------------------------------------------
# Alias Definitions
# Defines command aliases for faster typing.
# ---------------------------------------------------------------------------

aliases = {

# Window/Server Management
  ATAG        = "WINDOW SERVER";
  ADDALLCHANS = "SCRIPT EXEC foreach my \\$channel (Irssi::channels()) { Irssi::command(\"CHANNEL ADD -auto \\$channel->{visible_name} \\$channel->{server}->{tag} \\$channel->{key}\")\\;}";

# Ban/Unban/Kick
  B           = "BAN";
  BANS        = "BAN";
  KB          = "KICKBAN";

# Away/Quit
  BACK        = "AWAY";
  BYE         = "QUIT";
  EXIT        = "QUIT";
  SIGNOFF     = "QUIT";

# Clear/Highlight
  C           = "CLEAR";
  HIGHLIGHT   = "HILIGHT";
  HL          = "HILIGHT";
  DEHIGHLIGHT = "DEHILIGHT";
  DHL         = "DEHILIGHT";

# Command Execution
  CALC        = "EXEC - if command -v bc >/dev/null 2>&1\\; then printf '%s=' '$*'\\; echo '$*' | bc -l\\; else echo bc was not found\\; fi";

# DCC
  CHAT        = "DCC CHAT";

# CS/NS/OS Commands
  CS          = "QUOTE CS";
  NS          = "QUOTE NS";
  OS          = "QUOTE OS";

# Misc Commands
  DATE        = "TIME";
  DESCRIBE    = "ACTION";
  EXEMPTLIST  = "MODE $C +e";
  GOTO        = "SCROLLBACK GOTO";
  HOST        = "USERHOST";
  INVITELIST  = "MODE $C +I";
  J           = "JOIN";
  K           = "KICK";
  KN          = "KNOCKOUT";
  LAST        = "LASTLOG";
  LEAVE       = "PART";
  M           = "MSG";
  MS          = "QUOTE MS";
  MUB         = "UNBAN *";
  N           = "NAMES";
  NMSG        = "^MSG";
  P           = "PART";
  Q           = "QUERY";
  RESET       = "SET -default";
  RUN         = "SCRIPT LOAD";
  SAY         = "MSG *";
  SB          = "SCROLLBACK";
  SBAR        = "STATUSBAR";
  SHELP       = "QUOTE HELP";
  SV          = "MSG * Irssi $J ($V) - https://irssi.org";
  T           = "TOPIC";
  UB          = "UNBAN";
  UMODE       = "MODE $N";
  UNSET       = "SET -clear";
  W           = "WHO";
  WC          = "WINDOW CLOSE";
  WG          = "WINDOW GOTO";
  WJOIN       = "JOIN -window";
  WI          = "WHOIS";
  WII         = "WHOIS $0 $0";
  WL          = "WINDOW LIST";
  WN          = "WINDOW NEW HIDDEN";
  WQUERY      = "QUERY -window";
  WW          = "WHOWAS";
};

# ---------------------------------------------------------------------------
# Statusbar Definitions
# Configures the visual statusbar elements.
# ---------------------------------------------------------------------------

statusbar = {

  items = {

    # Statusbar start/end markers
    barstart = "{sbstart}";
    barend   = "{sbend}";

    # Topic statusbar start/end markers
    topicbarstart = "{topicsbstart}";
    topicbarend   = "{topicsbend}";

    # Time display
    time = "{sb $Z}";

    # User nick/mode/away display
    user = "{sb {sbnickmode $cumode}$N{sbmode $usermode}{sbaway $A}}";

    # Window display (active)
    window       = "{sb $winref:$tag/$itemname{sbmode $M}}";

    # Window display (empty/hidden)
    window_empty = "{sb $winref{sbservertag $tag}}";

    # Prompt display (active window)
    prompt       = "{prompt $[.15]itemname}";

    # Prompt display (empty window)
    prompt_empty = "{prompt $winname}";

    # Topic display (active)
    topic       = " $topic";

    # Topic display (empty)
    topic_empty = " Irssi v$J - https://irssi.org";

    # Lag display
    lag  = "{sb Lag: $0-}";

    # Activity display
    act  = "{sb Act: $0-}";

    # More prompt
    more = "-- more --";
  };

  default = {

    # Active Window Statusbar
    window = {

      disabled  = "no";
      type      = "window";
      placement = "bottom";
      position  = "1";
      visible   = "active";

      items = {
        barstart     = { priority = "100"; };
        time         = { };
        user         = { };
        window       = { };
        window_empty = { };
        lag          = { priority = "-1"; };
        act          = { priority = "10"; };
        more         = { priority = "-1";  alignment = "right"; };
        barend       = { priority = "100"; alignment = "right"; };
      };
    };

    # Inactive Window Statusbar
    window_inact = {

      type      = "window";
      placement = "bottom";
      position  = "1";
      visible   = "inactive";

      items = {
        barstart     = { priority = "100"; };
        window       = { };
        window_empty = { };
        more         = { priority = "-1";  alignment = "right"; };
        barend       = { priority = "100"; alignment = "right"; };
      };
    };

    # Prompt Statusbar
    prompt = {

      type      = "root";
      placement = "bottom";
      position  = "100";
      visible   = "always";

      items = {
        prompt       = { priority = "-1"; };
        prompt_empty = { priority = "-1"; };
        input        = { priority = "10"; };
      };
    };

    # Topic Statusbar
    topic = {

      type      = "root";
      placement = "top";
      position  = "1";
      visible   = "always";

      items = {
        topicbarstart = { priority = "100"; };
        topic         = { };
        topic_empty   = { };
        topicbarend   = { priority = "100"; alignment = "right"; };
      };
    };
  };
};