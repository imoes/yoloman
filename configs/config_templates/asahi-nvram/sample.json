{
  "device": "/dev/nvram",
  "operations": [
    {
      "type": "read",
      "variables": [
        {
          "partition": "system",
          "name": "csr-active-config"
        },
        {
          "partition": "common",
          "name": "boot-args"
        }
      ]
    },
    {
      "type": "write",
      "assignments": [
        {
          "partition": "common",
          "name": "boot-args",
          "value": "-v keepdark=1"
        }
      ]
    },
    {
      "type": "delete",
      "variables": [
        {
          "partition": "system",
          "name": "diagnostics-active"
        }
      ]
    }
  ]
}
