{
  "browse_remote_protocols": [
    "ipp",
    "https"
  ],
  "browse_local_protocols": [
    "cups",
    "dnssd"
  ],
  "timeout": 600,
  "max_queued_printers": 100,
  "create_remote_ipp_queue": true,
  "create_ipp_printer": true,
  "server_name": "cups-server.local",
  "listen_address": "*",
  "port": 8631,
  "debug_logging": 1,
  "filter_pattern": "HP_LaserJet",
  "browse_dnssd": true,
  "auto_install": true,
  "default_attrs": [
    {
      "key": "printer-is-shared",
      "value": "false"
    },
    {
      "key": "printer-error-policy",
      "value": "abort-job"
    }
  ],
  "printer_rules": [
    {
      "mode": "Allow",
      "pattern": ".*@office\\..*"
    },
    {
      "mode": "Deny",
      "pattern": ".*Test.*"
    }
  ],
  "max_connections": 20,
  "ipv6": true,
  "discovery_time": 180,
  "ppd_search": [
    "/usr/share/cups/ppd",
    "/usr/local/share/ppd"
  ]
}
