{
  "input": {
    "type": "string",
    "default": "-",
    "description": "Input file, FIFO path, or '-' for stdin."
  },
  "hist_spec": {
    "type": "string",
    "default": "60x24",
    "description": "History specification (e.g., 60x24 for 60s window, 24min history)."
  },
  "counting_mode": {
    "type": "string",
    "default": "a",
    "description": "Counting mode: a (absolute), i (incremental), d (differential). Prefix with N for multiple graphs.",
    "enum": [
      "a",
      "i",
      "d"
    ]
  },
  "format_type": {
    "type": "string",
    "default": "a",
    "description": "Input format: a (ASCII), f (float), d (double), s (short), i (int), l (long).",
    "enum": [
      "a",
      "f",
      "d",
      "s",
      "i",
      "l"
    ]
  },
  "low": {
    "type": "number",
    "default": 0,
    "description": "Lower Y-axis limit for disabling auto-scaling."
  },
  "high": {
    "type": "number",
    "default": 100,
    "description": "Upper Y-axis limit for disabling auto-scaling."
  },
  "polling_rate": {
    "type": "number",
    "default": 1000,
    "description": "Polling rate in Hz for updating the history buffer."
  },
  "labels": {
    "type": "list",
    "default": [],
    "description": "Labels for multiple graphs. Flat string values."
  },
  "trend_colours": {
    "type": "list",
    "default": [
      "#0000FF"
    ],
    "description": "Colours for trend lines. Hex RGB (#RRGGBB). One per graph."
  },
  "background_colour": {
    "type": "string",
    "default": "#000000",
    "description": "Background colour in hex RGB."
  },
  "text_colour": {
    "type": "string",
    "default": "#FFFFFF",
    "description": "Text/Values colour in hex RGB."
  },
  "grid_colour": {
    "type": "string",
    "default": "#404040",
    "description": "Grid colour in hex RGB."
  },
  "marker_colour": {
    "type": "string",
    "default": "#FFFF00",
    "description": "Marker colour in hex RGB."
  },
  "examiner_colour": {
    "type": "string",
    "default": "#00FF00",
    "description": "Interactive examiner colour in hex RGB."
  },
  "edit_colour": {
    "type": "string",
    "default": "#FF00FF",
    "description": "Edit mode colour in hex RGB."
  },
  "zeros": {
    "type": "list",
    "default": [
      "0"
    ],
    "description": "Y-axis zero position(s). Comma-separated in CLI."
  },
  "grid_spec": {
    "type": "string",
    "default": "",
    "description": "Grid resolution spec (e.g., 1x10+5)."
  },
  "title": {
    "type": "string",
    "default": "trend",
    "description": "Window title."
  },
  "dimmed": {
    "type": "bool",
    "default": false,
    "description": "Enable dimmed shading mode."
  },
  "distribution": {
    "type": "bool",
    "default": false,
    "description": "Enable distribution graph."
  },
  "anti_aliasing": {
    "type": "bool",
    "default": false,
    "description": "Enable anti-aliasing."
  },
  "scrolling": {
    "type": "bool",
    "default": false,
    "description": "Enable scrolling mode instead of wrap-around."
  },
  "visible_values": {
    "type": "bool",
    "default": false,
    "description": "Show visible values."
  },
  "visible_latency": {
    "type": "bool",
    "default": false,
    "description": "Show visual/max sync latency."
  },
  "visible_marker": {
    "type": "bool",
    "default": false,
    "description": "Show marker."
  },
  "filling": {
    "type": "bool",
    "default": false,
    "description": "Enable filling."
  },
  "visible_grid": {
    "type": "bool",
    "default": true,
    "description": "Show grid."
  },
  "show_undefined": {
    "type": "bool",
    "default": false,
    "description": "Show undefined values."
  },
  "escape_sequences": {
    "type": "bool",
    "default": false,
    "description": "Enable escape sequences."
  }
}
