# ==============================================================================
# Desktop Entry: Notify OSD
# ==============================================================================
# This template generates a `.desktop` file for the notify-osd service.
# It is used by desktop environments (like GNOME) to manage autostart and
# execution of the notification daemon.

[Desktop Entry]

# Name=Notify OSD
# Short descriptive name of the desktop entry.
Name=Notify OSD

# Comment=Display notifications
# Brief description of the service's function.
Comment=Display notifications

# Comment[zh_CN]=显示通知
# Localized comment for Simplified Chinese users.
Comment[zh_CN]=显示通知

# Exec={{ (exec_path | default('/usr/libexec/notify-osd')) }}
# Path to the executable that implements the notification service.
Exec={{ exec_path | default('/usr/libexec/notify-osd') }}

# Terminal={{ (terminal | default(false)) | ternary('true', 'false') }}
# Whether to run the application in a terminal window.
# Note: Desktop entries for background daemons should typically be false.
Terminal={{ (terminal | default(false)) | ternary('true', 'false') }}

# Type={{ (type | default('Application')) | upper }}
# The type of this desktop entry. 'Application' is standard for executables.
Type={{ (type | default('Application')) | upper }}

# NotShowIn={{ notshowin | default(['KDE']) | join(';') }}
# List of desktop environments where this entry should NOT be shown.
# Prevents the notification daemon from appearing in environments like KDE Plasma.
NotShowIn={{ notshowin | default(['KDE']) | join(';') }}

# X-GNOME-Autostart-enabled={{ (autostart_enabled | default(false)) | ternary('true', 'false') }}
# Controls whether GNOME's autostart mechanism should launch this entry.
X-GNOME-Autostart-enabled={{ (autostart_enabled | default(false)) | ternary('true', 'false') }}