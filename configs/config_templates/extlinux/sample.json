{
  "install_dir": "/boot/extlinux",
  "default_label": "linux",
  "timeout": 100,
  "global_append": "root=UUID=a1b2c3d4-e5f6-7890-1234-567890abcdef ro quiet splash",
  "menu_labels": [
    {
      "name": "linux",
      "kernel": "/vmlinuz-linux",
      "initrd": "/initramfs-linux.img"
    },
    {
      "name": "fallback",
      "kernel": "/vmlinuz-linux",
      "initrd": "/initramfs-linux-fallback.img",
      "append": "root=UUID=a1b2c3d4-e5f6-7890-1234-567890abcdef ro"
    },
    {
      "name": "rescue",
      "kernel": "/vmlinuz-linux",
      "initrd": "/initramfs-linux-fallback.img",
      "append": "single",
      "text_help": "Boot into single-user rescue mode"
    }
  ]
}
