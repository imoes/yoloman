{
  "services": [
    {
      "name": "nntp",
      "type": "inet",
      "command": "/usr/lib/cyrus/bin/nntpd",
      "args": [
        "-p",
        "119",
        "-a"
      ]
    },
    {
      "name": "nntp-ssl",
      "type": "inet",
      "command": "/usr/lib/cyrus/bin/nntpd",
      "args": [
        "-p",
        "563",
        "-a",
        "-s"
      ]
    }
  ],
  "enable_nntppost": true,
  "sieve_enabled": true,
  "tls_enabled": true
}
