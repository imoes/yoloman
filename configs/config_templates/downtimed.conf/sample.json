{
  "log_level": "info",
  "pid_file": "/var/run/downtimed/downtimed.pid",
  "log_file": "/var/log/downtimed/downtimed.log",
  "max_sessions": 15,
  "check_interval": 20,
  "down_threshold": 3,
  "up_threshold": 2,
  "enable_email": true,
  "email_to": "ops@example.com",
  "smtp_server": "smtp.example.com",
  "smtp_port": 587,
  "smtp_tls": true,
  "smtp_user": "monitor",
  "smtp_pass": "secret",
  "services": [
    {
      "name": "web",
      "host": "web.example.com",
      "port": 443,
      "proto": "tcp",
      "timeout": 10,
      "interval": 30,
      "down_after": 2
    },
    {
      "name": "db",
      "host": "db.example.com",
      "port": 5432,
      "proto": "tcp",
      "timeout": 15,
      "interval": 60
    },
    {
      "name": "dns",
      "host": "1.1.1.1",
      "port": 53,
      "proto": "udp"
    }
  ]
}
