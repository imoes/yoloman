{
  "server_socket_path": "/tmp/osui.sock",
  "daemon_log_file": "/var/log/opensnitchd.log",
  "default_action": "allow",
  "default_duration": "once",
  "intercept_unknown": false,
  "proc_monitor_method": "ebpf",
  "log_level": 2,
  "log_utc": true,
  "log_micro": false,
  "firewall_backend": "nftables",
  "daemon.rules_path": "/etc/opensnitchd/rules/",
  "stats_max_events": 150,
  "stats_max_stats": 25,
  "stats_workers": 6,
  "internal_gc_percent": 100,
  "internal_flush_conns_on_start": false,
  "pid_dir": "/var/run/opensnitchd"
}
