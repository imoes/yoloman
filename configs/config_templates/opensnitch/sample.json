{
  "daemon": {
    "enabled": true,
    "pidfile": "/var/run/opensnitchd.pid",
    "log_level": "INFO",
    "log_file": "/var/log/opensnitch/opensnitchd.log",
    "socket_path": "unix:///var/run/opensnitchd.sock",
    "enable_grpc": true,
    "grpc_address": "localhost:50051",
    "default_action": "deny",
    "enable_stats": true,
    "stats_path": "/var/lib/opensnitchd/opensnitch.sqlite3",
    "notifications_enabled": true,
    "notification_timeout": 10,
    "db_compact": true,
    "db_compact_after_days": 30,
    "prompt_system_processes": false,
    "prompt_inbound": true,
    "prompt_localhost": false,
    "local_procs": [
      "systemd",
      "systemd-resolved",
      "dbus-daemon"
    ],
    "outbound_local_procs": [],
    "dns_lookup": true,
    "custom_ca_bundle": "",
    "grpc_use_tls": false,
    "grpc_tls_cert": "/etc/opensnitchd/cert.pem",
    "grpc_tls_key": "/etc/opensnitchd/key.pem",
    "grpc_verify_client": false,
    "grpc_client_ca_cert": ""
  },
  "ui": {
    "server_address": "localhost:50052",
    "use_tls": false,
    "server_cert": "/etc/opensnitchd/ui-cert.pem",
    "server_key": "/etc/opensnitchd/ui-key.pem"
  },
  "stats": {
    "enabled": true,
    "path": "/var/lib/opensnitchd/opensnitch.sqlite3",
    "retention_days": 30
  },
  "alerts": {
    "enabled": true,
    "outbound_enabled": true,
    "inbound_enabled": true,
    "localhost_enabled": false,
    "system_process_enabled": false,
    "auto_allow_timeout_ms": 0
  }
}
