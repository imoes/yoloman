{
  "server_socket_path": {
    "type": "string",
    "default": "/tmp/osui.sock",
    "description": "Unix socket path for the OpenSnitch UI gRPC connection"
  },
  "daemon_log_file": {
    "type": "string",
    "default": "/var/log/opensnitchd.log",
    "description": "Path to the daemon log file"
  },
  "default_action": {
    "type": "string",
    "default": "allow",
    "description": "Default action for connections not matching any rule (allow, drop, ask)"
  },
  "default_duration": {
    "type": "string",
    "default": "once",
    "description": "Duration of default actions (once, always)"
  },
  "intercept_unknown": {
    "type": "string",
    "default": "false",
    "description": "Whether to intercept connections not recognized by the system"
  },
  "proc_monitor_method": {
    "type": "string",
    "default": "ebpf",
    "description": "Method to monitor processes (ebpf, procfs)"
  },
  "log_level": {
    "type": "number",
    "default": 2,
    "description": "Log level (0-4, where 2 is info)"
  },
  "log_utc": {
    "type": "string",
    "default": "true",
    "description": "Use UTC for timestamps"
  },
  "log_micro": {
    "type": "string",
    "default": "false",
    "description": "Use microsecond precision in logs"
  },
  "firewall_backend": {
    "type": "string",
    "default": "nftables",
    "description": "Firewall backend to use (iptables, nftables)"
  },
  "daemon.rules_path": {
    "type": "string",
    "default": "/etc/opensnitchd/rules",
    "description": "Path to the rules directory used by opensnitchd"
  },
  "stats_max_events": {
    "type": "number",
    "default": 150,
    "description": "Maximum number of events to keep in stats history"
  },
  "stats_max_stats": {
    "type": "number",
    "default": 25,
    "description": "Maximum number of stats entries to keep"
  },
  "stats_workers": {
    "type": "number",
    "default": 6,
    "description": "Number of workers for stats processing"
  },
  "internal_gc_percent": {
    "type": "number",
    "default": 100,
    "description": "Garbage collection target percentage"
  },
  "internal_flush_conns_on_start": {
    "type": "string",
    "default": "false",
    "description": "Flush connections on daemon start"
  },
  "pid_dir": {
    "type": "string",
    "default": "/var/run/opensnitchd",
    "description": "Directory where the daemon's PID file is stored"
  }
}
