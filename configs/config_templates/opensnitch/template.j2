# OpenSnitch Daemon Configuration File (JSON format)
# This file configures the OpenSnitch intrusion prevention system daemon.
# It controls logging, firewall backend selection, process monitoring,
# and the communication socket for the OpenSnitch UI.

{
    # ======================================================================
    # Server Configuration: gRPC Socket and Logging
    # ======================================================================
    "Server":
    {
        # Unix socket path for the OpenSnitch UI gRPC connection.
        # The UI client connects here to send requests and receive alerts.
        "Address": "unix://{{ server_socket_path | default('/tmp/osui.sock') }}",

        # Path to the daemon log file.
        # All operational logs will be written to this file.
        "LogFile": "{{ daemon_log_file | default('/var/log/opensnitchd.log') }}"
    },

    # ======================================================================
    # Default Action Configuration
    # ======================================================================
    # DefaultAction sets the behavior for connections that do not match
    # any specific rule defined in the rules directory.
    # Valid values: "allow", "drop", "ask"
    "DefaultAction": "{{ default_action | default('allow') }}",

    # DefaultDuration specifies how long the DefaultAction applies.
    # Valid values: "once" (applies to this connection only), "always" (permanent exception)
    "DefaultDuration": "{{ default_duration | default('once') }}",

    # InterceptUnknown determines if the firewall should intercept
    # connections that are not recognized by the system (e.g., if process info is missing).
    # Values: true, false
    "InterceptUnknown": {{ intercept_unknown | default(false) | lower }},

    # ======================================================================
    # Monitoring and Firewall Backend Configuration
    # ======================================================================
    # ProcMonitorMethod defines how the daemon monitors processes to identify
    # the binary/executable associated with network traffic.
    # Valid values: "ebpf" (eBPF-based, requires kernel support), "procfs" (legacy /proc scanning)
    "ProcMonitorMethod": "{{ proc_monitor_method | default('ebpf') }}",

    # LogLevel sets the verbosity of the log output.
    # Range: 0 (emergency) to 4 (debug), with 2 being info (standard).
    "LogLevel": {{ log_level | default(2) }},

    # LogUTC forces timestamps to be logged in UTC instead of local time.
    # Values: true, false
    "LogUTC": {{ log_utc | default(true) | lower }},

    # LogMicro enables microsecond precision in log timestamps.
    # Useful for high-throughput debugging.
    # Values: true, false
    "LogMicro": {{ log_micro | default(false) | lower }},

    # Firewall specifies the backend firewall technology to use for rules enforcement.
    # Valid values: "iptables" (legacy, slower), "nftables" (modern, faster)
    "Firewall": "{{ firewall_backend | default('nftables') }}",

    # ======================================================================
    # Rules Configuration
    # ======================================================================
    "Rules": {
        # Path to the directory containing rule definition files (JSON/YAML).
        # Rules are loaded from files in this directory at startup and on reload.
        "Path": "{{ daemon_rules_path | default('/etc/opensnitchd/rules') }}/"
    },

    # ======================================================================
    # Stats Configuration
    # ======================================================================
    "Stats": {
        # Maximum number of individual events to keep in stats history before pruning.
        "MaxEvents": {{ stats_max_events | default(150) }},

        # Maximum number of stats entries (summaries/aggregations) to keep.
        "MaxStats": {{ stats_max_stats | default(25) }},

        # Number of workers used for asynchronous processing of stats.
        "Workers": {{ stats_workers | default(6) }}
    },

    # ======================================================================
    # Internal Daemon Configuration
    # ======================================================================
    "Internal": {
        # Garbage collection target percentage.
        # Controls the Go runtime's GC aggressiveness. Lower values trigger
        # more frequent GC at the cost of CPU; 100 is the Go default.
        "GCPercent": {{ internal_gc_percent | default(100) }},

        # FlushConnsOnStart forces the daemon to flush existing connection
        # records upon startup, preventing stale rules from affecting new sessions immediately.
        # Values: true, false
        "FlushConnsOnStart": {{ internal_flush_conns_on_start | default(false) | lower }}
    },

    # ======================================================================
    # Daemon Runtime Configuration
    # ======================================================================
    # PIDDir specifies the directory where the daemon's PID file is stored.
    # This allows systemd or other supervisors to track the daemon process.
    "PIDDir": "{{ pid_dir | default('/var/run/opensnitchd') }}"
}
