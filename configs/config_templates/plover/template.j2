#!/usr/bin/env python
# Plover Stenography Engine Configuration
# Generated by Ansible Jinja2 template
#
# This file configures the Plover stenography engine. It controls logging,
# GUI selection, remote control interface, dictionary loading, hardware
# emulation settings, and plugin loading.

# The logging level for plover. Options: debug, info, warning, error.
log_level = "{{ log_level | default('info') }}"

# The GUI toolkit to use. Options: wx, gtk, qt5, or 'auto' to let plover choose.
gui = "{{ gui | default('auto') }}"

# The IP address for the remote control interface.
interface_host = "{{ interface_host | default('127.0.0.1') }}"

# The port number for the remote control interface.
interface_port = {{ interface_port | default(5050) }}

# A list of file paths to Plover JSON dictionaries to load at startup.
dictionary_paths = {{ dictionary_paths | default([]) | tojson }}

# Path to a specific user profile file (.json). Empty string uses the default.
profile_path = "{{ profile_path | default('') }}"

# Whether to emulate a hardware steno machine. If false, uses keyboard input.
hardware_emulation = {{ hardware_emulation | default(False) | lower }}

# The device path for the hardware steno interface (e.g., /dev/ttyUSB0).
steno_port = "{{ steno_port | default('') }}"

# A list of plugin module names to load. Example: ['plover_dictionary_manager'].
plugin_list = {{ plugin_list | default([]) | tojson }}