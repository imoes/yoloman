{
  "provides": {
    "type": "string",
    "default": "tlp",
    "description": "Service name provided by this init script."
  },
  "required_start": {
    "type": "string",
    "default": "$remote_fs",
    "description": "LSB required start services."
  },
  "required_stop": {
    "type": "string",
    "default": "$remote_fs",
    "description": "LSB required stop services."
  },
  "default_start": {
    "type": "string",
    "default": "2 3 4 5",
    "description": "LSB default start runlevels."
  },
  "default_stop": {
    "type": "string",
    "default": "0 1 6",
    "description": "LSB default stop runlevels."
  },
  "short_description": {
    "type": "string",
    "default": "tlp start/stop script",
    "description": "Short description of the service."
  },
  "description": {
    "type": "string",
    "default": "Initialize tlp",
    "description": "Long description of the service."
  },
  "tlp_path": {
    "type": "string",
    "default": "/usr/sbin/tlp",
    "description": "Path to the tlp executable."
  }
}
