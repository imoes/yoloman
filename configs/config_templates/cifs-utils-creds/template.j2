# CIFS credential helper configuration
# Defines per-host credentials used by the CIFS mount helper for Kerberos and NTLMSSP authentication
# Each line: <host> <username> <password> [domain]
# Lines starting with # are comments
{% for entry in credentials %}
{{ entry.host }} {{ entry.username }} {{ entry.password }}{% if entry.domain is defined %} {{ entry.domain }}{% endif %}
{% endfor %}