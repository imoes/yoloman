# ==============================================================================
# esekeyd Daemon Configuration Defaults
# ==============================================================================
# This template generates the default configuration file for the `esekeyd` service.
# It controls whether the service starts automatically and specifies the path
# to the main daemon configuration file.
#
# Variables used:
#   - start_esekeyd (bool): Whether to start the esekeyd service on boot.
#   - daemon_opts   (str): Path to the esekeyd configuration file.

# ------------------------------------------------------------------------------
# Service Startup Control
# ------------------------------------------------------------------------------
# Description: Whether to start the esekeyd service on boot.
# Default: false
# Type: boolean
START_ESEKEYD={{ start_esekeyd | default(false) }}

# ------------------------------------------------------------------------------
# Daemon Options
# ------------------------------------------------------------------------------
# Description: Path to the esekeyd configuration file.
# Default: /etc/esekeyd.conf
# Type: string
DAEMON_OPTS={{ daemon_opts | default('/etc/esekeyd.conf') }}