{
  "authbind_enabled": true,
  "authbind_helper_path": "/usr/lib/authbind/authbind-helper",
  "authbind_ports": [
    80,
    443
  ],
  "authbind_access_entries": [
    {
      "file_type": "byport",
      "port": 80
    },
    {
      "file_type": "byaddr",
      "addr": "0.0.0.0",
      "port": 8080
    },
    {
      "file_type": "byaddr",
      "addr": "::",
      "port": 443
    }
  ],
  "authbind_depth": 2,
  "authbind_lib_path": "/usr/lib/authbind/libauthbind.so.1.0"
}
