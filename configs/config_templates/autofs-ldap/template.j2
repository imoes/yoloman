<?xml version="1.0" ?>
<!--
autofs_ldap_auth.conf(5) - SASL configuration for autofs LDAP lookup.
This file configures how the autofs daemon connects to an LDAP directory
service (e.g., OpenLDAP, 389-ds, Samba AD, FreeIPA) for user/group maps.

See autofs_ldap_auth.conf(5) for authoritative documentation.
-->

<autofs_ldap_sasl_conf
	<!-- usetls: Whether to wrap the LDAP connection in TLS.
	     Schema default: False -->
	usetls="{{ usetls | default(False) | ternary('yes', 'no') }}"

	<!-- tlsrequired: Whether the connection must use TLS.
	          If True, autofs aborts if TLS cannot be established (fail closed).
	          Schema default: False -->
	tlsrequired="{{ tlsrequired | default(False) | ternary('yes', 'no') }}"

	<!-- authrequired: Whether SASL authentication is mandatory for the connection.
	               Schema default: False -->
	authrequired="{{ authrequired | default(False) | ternary('yes', 'no') }}"
/>