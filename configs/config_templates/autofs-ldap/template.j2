<?xml version="1.0" ?>
<!--
This files contains a single entry with multiple attributes tied to it.
See autofs_ldap_auth.conf(5) for more information.
-->

<autofs_ldap_sasl_conf
	<!-- Whether to use TLS for LDAP connections. Defaults to 'no'. -->
	usetls="{{ usetls | default('no') }}"
	<!-- Whether TLS is required (abort if TLS cannot be established). Defaults to 'no'. -->
	tlsrequired="{{ tlsrequired | default('no') }}"
	<!-- Whether SASL authentication is required. Defaults to 'no'. -->
	authrequired="{{ authrequired | default('no') }}"
/>
