#! /bin/sh

# Ansible-managed cron script to update the `locatedb' database.
# Generated by Ansible role. Do not edit manually.

# Exit immediately if any command fails.
set -e

# ---------------------------------------------------------------------------
# Cron script to update the `locatedb' database.
#
# Written by Ian A. Murdock <imurdock@debian.org> and
#            Kevin Dalley <kevin@aimnet.com>
#
# Please consult updatedb(1) and /usr/share/doc/locate/README.Debian
# ---------------------------------------------------------------------------

# Check that the findutils binary exists; if not, nothing to do.
[ -e /usr/bin/updatedb.findutils ] || exit 0

# Skip in favour of systemd timer if called from cron.daily and not explicitly
# requested to run via systemd-timer argument.
if [ -d /run/systemd/system ] && [ "$1" != "systemd-timer" ]; then
	exit 0
fi

# Ensure this script runs as root.
if [ "$(id -u)" != "0" ]; then
	echo "You must be root."
	exit 1
fi
 
# ---------------------------------------------------------------------------
# Global options for invocations of find(1)
# ---------------------------------------------------------------------------

# Race condition handling option for find.
FINDOPTIONS='-ignore_readdir_race'

# Space-separated list of filesystem types to prune from the updatedb database.
# These filesystems are typically virtual, temporary, or network-mounted and
# not worth indexing for local file location.
PRUNEFS="{{ PRUNEFS | default('NFS nfs nfs4 afs binfmt_misc proc smbfs autofs iso9660 ncpfs coda devpts ftpfs devfs mfs shfs sysfs cifs lustre_lite tmpfs usbfs udf ocfs2') }}"

# Space-separated list of paths to prune from the updatedb database.
# These directories contain temporary files, caches, or mount points that
# should be excluded from the locate database to keep it small and relevant.
PRUNEPATHS="{{ PRUNEPATHS | default('/tmp /usr/tmp /var/tmp /afs /amd /alex /var/spool /sfs /media /var/lib/schroot/mount') }}"

# Netpaths which are added (empty by default).
NETPATHS=""

# ---------------------------------------------------------------------------
# Execution user and priority settings
# ---------------------------------------------------------------------------

# User under which the find command is run.
# Typically 'nobody' or 'root'; 'nobody' reduces risk if find is exploited.
LOCALUSER="{{ LOCALUSER | default('nobody') }}"

# Cron.daily/find: run at this priority.
# Higher number means lower priority. This is relative to the default cron
# priority (usually +5). Valid range is typically 0-19 (lower = higher priority).
NICE={{ NICE | default(10) }}

# ---------------------------------------------------------------------------
# I/O priority settings (uses ionice)
# ---------------------------------------------------------------------------

# I/O scheduling class: 1 for real time, 2 for best-effort, 3 for idle.
# Class 3 ("idle") only works when the process has no other I/O priority set.
# Using idle class ensures locate doesn't interfere with other I/O-heavy tasks.
IONICE_CLASS={{ IONICE_CLASS | default(3) }}

# I/O scheduling priority (0-7, only valid for classes 1 and 2).
# 0=highest priority, 7=lowest. Ignored for class 3.
IONICE_PRIORITY={{ IONICE_PRIORITY | default(7) }}

# allow keeping local customizations in a separate file
if [ -r /etc/updatedb.findutils.cron.local ] ; then
	. /etc/updatedb.findutils.cron.local
fi

# Export variables for use by any sourced scripts or subshells.
export FINDOPTIONS PRUNEFS PRUNEPATHS NETPATHS LOCALUSER

# ---------------------------------------------------------------------------
# Set the task to run with desired I/O priority if possible
# Linux supports io scheduling priorities and classes since
# 2.6.13 with the CFQ io scheduler
# Skip if running from systemd-timer, there are native settings there.
# ---------------------------------------------------------------------------

if [ -x /usr/bin/ionice ] && [ "${UPDATDB_NO_IONICE}" = "" ] && \
	[ "$1" != "systemd-timer" ]; then
	# don't run ionice if kernel version < 2.6.13
	KVER=$(uname -r)
	case "$KVER" in
		2.[012345]*) ;;
		2.6.[0-9]) ;;
		2.6.[0-9].*) ;;
		2.6.1[012]*) ;;
		*)
		# Avoid providing "-n" when IONICE_CLASS isn't 1 or 2
		case "$IONICE_CLASS" in
			1|2) priority="-n ${IONICE_PRIORITY:-{{ IONICE_PRIORITY | default(7) }}}" ;;
			*) priority="" ;;
		esac
		ionice -c $IONICE_CLASS $priority -p $$ > /dev/null 2>&1 || true
		;;
	esac
fi

# Run updatedb.findutils as LOCALUSER if the user exists.
# Otherwise, error out.
if getent passwd $LOCALUSER > /dev/null ; then
  cd / && nice -n ${NICE:-{{ NICE | default(10) }}} updatedb.findutils 2>/dev/null
else
  echo "User $LOCALUSER does not exist."
  exit 1
fi