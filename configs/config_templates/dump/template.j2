# /etc/dump.conf
# dump configuration file
#
# This file configures the `dump` utility for backup operations.
# Environment variables can override some of these settings at runtime.
# See `man dump.conf` for details.

{# Default dump device (overridden by -f and TAPE environment) #}
DEFAULT_DUMP_DEVICE={{ default_dump_device | default('/dev/st0') }}

{# Path to file storing dump level/date records #}
DUMPDATES_FILE={{ dumpdates_file | default('/var/lib/dumpdates') }}

{# Path to remote rmt(8) program (overridden by RMT env) #}
RMT_PATH={{ remote_rmt_path | default('/etc/rmt') }}

{# Remote shell command for remote backups (overridden by RSH env) #}
RSH_CMD={{ rsh_command | default('rsh') }}

{# Tape length in feet for size estimation (used with -s) #}
TAPE_LENGTH={{ tape_length | default(2300) }}

{# Tape density in BPI (overrides end-of-media detection) #}
TAPE_DENSITY={{ tape_density | default(1600) }}

{# Maximum blocksize in kilobytes per dump record (max 1024) #}
MAX_BLOCKSIZE={{ max_blocksize | default(10) }}

{# Number of read errors to ignore before prompting operator #}
MAX_READ_ERRORS={{ max_read_errors | default(32) }}

{# Honor UF_NODUMP inode flag only for dump levels >= this #}
HONOR_NODUMP_LEVEL={{ honor_nodump_level | default(1) }}