{
  "watchdog_enabled": true,
  "device_path": "/dev/avr_evtd",
  "timeout_seconds": 60,
  "heartbeat_seconds": 25,
  "log_level": "info",
  "syslog_facility": "daemon",
  "pre_ping_command": "/usr/local/bin/check-network.sh",
  "post_reset_command": "",
  "run_as_user": "nobody",
  "run_as_group": "nogroup",
  "monitored_files": [
    {
      "path": "/etc/network/interfaces",
      "trigger": "close_write"
    },
    {
      "path": "/etc/avr-evtd.conf",
      "trigger": "modify"
    }
  ],
  "monitored_services": [
    {
      "name": "dropbear",
      "timeout": 5
    },
    {
      "name": "nginx",
      "timeout": 3
    }
  ],
  "no_auto_restart": false
}
