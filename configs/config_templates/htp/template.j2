# ==============================================================================
# Configuration for htp (HTML Preprocessor)
# ==============================================================================
# This file controls command-line defaults for the htp binary.
# It is self-documenting: every option is explained below the comment header.
# Generated from Ansible role variables.

# ------------------------------------------------------------------------------
# Option: delimit_type
# ------------------------------------------------------------------------------
# Description: The character set used to surround htp markup tags.
#              Must be one of: HTML, CURLY, SQUARE.
# Default: HTML
# Manpage: DELIM
# ------------------------------------------------------------------------------
DELIM={{ delimit_type | default('HTML') }}

# ------------------------------------------------------------------------------
# Option: imgxy
# ------------------------------------------------------------------------------
# Description: Whether to automatically add width and height attributes to IMG tags.
#              Useful for web compatibility, but can be disabled for raw HTML.
# Default: true
# Manpage: IMGXY
# ------------------------------------------------------------------------------
IMGXY={{ imgxy | default(true) }}

# ------------------------------------------------------------------------------
# Option: depend
# ------------------------------------------------------------------------------
# Description: Whether to check file dependencies (input/include changes) before processing.
#              If disabled, htp may process stale content if dependencies changed.
# Default: true
# Manpage: DEPEND
# ------------------------------------------------------------------------------
DEPEND={{ depend | default(true) }}

# ------------------------------------------------------------------------------
# Option: condense
# ------------------------------------------------------------------------------
# Description: Whether to strip all linefeeds from the output HTML to reduce file size.
#              Useful for production deployments where whitespace matters less.
# Default: false
# Manpage: CONDENSE
# ------------------------------------------------------------------------------
CONDENSE={{ condense | default(false) }}

# ------------------------------------------------------------------------------
# Option: quiet
# ------------------------------------------------------------------------------
# Description: Whether to suppress informational messages and only show warnings/errors.
#              Set to true to minimize log noise during automated builds.
# Default: false (Verbose by default)
# Manpage: QUIET / VERBOSE
# ------------------------------------------------------------------------------
QUIET={{ quiet | default(false) }}

# ------------------------------------------------------------------------------
# Option: precious
# ------------------------------------------------------------------------------
# Description: Whether to retain incomplete output files if processing fails.
#              If false, htp will delete partial outputs to avoid serving broken HTML.
# Default: false
# Manpage: PRECIOUS
# ------------------------------------------------------------------------------
PRECIOUS={{ precious | default(false) }}

# ------------------------------------------------------------------------------
# Option: response_file
# ------------------------------------------------------------------------------
# Description: Path to a response file listing input/output pairs and sub-responses.
#              Leave empty for direct input/output processing via command-line arguments.
# Default: '' (empty)
# Manpage: @<response file>
# ------------------------------------------------------------------------------
RESPONSE_FILE={{ response_file | default('') }}