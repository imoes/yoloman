{
  "use_lvmlockd": true,
  "pidfile": "/run/lvmlockd.pid",
  "locking_type": "sanlock",
  "lockspace_dir": "/run/lvm/lockspace",
  "worker_threads": 8,
  "lock_timeout": 60,
  "max_lock_resources": 8192,
  "auto_recover": true,
  "sanlock_resources": [
    {
      "name": "vg1",
      "path": "/dev/sdb1",
      "offset": 0
    },
    {
      "name": "vg2",
      "path": "/dev/sdc1",
      "offset": 1048576
    }
  ],
  "log_level": 2
}
