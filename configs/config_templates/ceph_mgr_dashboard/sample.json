{
  "enable_dashboard": true,
  "dashboard_host": "0.0.0.0",
  "dashboard_port": 8443,
  "ssl": true,
  "ssl_cert": "/etc/ceph/ssl/dashboard.crt",
  "ssl_key": "/etc/ceph/ssl/dashboard.key",
  "auth_mode": "internal",
  "api_prefix": "/api",
  "modules": [
    "dashboard",
    "prometheus"
  ],
  "dashboard_pool": "cephfs_data"
}
