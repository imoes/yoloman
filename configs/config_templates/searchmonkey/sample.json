{
  "search_dir": "/var/log",
  "file_name_regex": "\\.log$",
  "content_regex": "ERROR|CRITICAL",
  "match_case": false,
  "use_regex": true,
  "use_dos_glob": false,
  "invert": false,
  "recurse_subdirs": true,
  "min_size_kb": 1,
  "max_size_kb": 10240,
  "date_from": "2023-01-01",
  "date_to": "2023-12-31",
  "word_wrap": true,
  "show_toolbar": true,
  "show_status_bar": true,
  "one_phase": true,
  "text_editor": "/usr/bin/vim",
  "file_browser": "/usr/bin/thunar",
  "extra_search_dirs": [
    "/var/log/nginx",
    "/var/log/apache2"
  ]
}
