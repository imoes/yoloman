# ==============================================================================
# SearchMonkey Configuration Template
# ==============================================================================
# This file configures the SearchMonkey desktop application.
# It is managed by Ansible. Do not edit manually.
# ==============================================================================

# The root directory from which the search begins.
SearchMonkey.SearchDir={{ search_dir | default('/home') }}

# Regular expression pattern for matching file names.
SearchMonkey.FileNameRegex={{ file_name_regex | default('.*') }}

# Regular expression pattern for matching text content within files.
SearchMonkey.ContentRegex={{ content_regex | default('.*') }}

# Enable case-sensitive matching for file names and content.
SearchMonkey.MatchCase={{ match_case | default(False) | lower }}

# Enable regular expression matching mode.
SearchMonkey.UseRegex={{ use_regex | default(True) | lower }}

# Enable DOS-style glob matching (wildcards * and ?) for file names.
SearchMonkey.UseDosGlob={{ use_dos_glob | default(False) | lower }}

# Invert the search criteria to find files/content that do NOT match the patterns.
SearchMonkey.Invert={{ invert | default(False) | lower }}

# Recurse into subdirectories when searching.
SearchMonkey.RecurseSubdirs={{ recurse_subdirs | default(True) | lower }}

# Minimum file size in Kilobytes. 0 means no minimum.
SearchMonkey.MinSizeKB={{ min_size_kb | default(0) }}

# Maximum file size in Kilobytes. 0 means no maximum.
SearchMonkey.MaxSizeKB={{ max_size_kb | default(0) }}

# Search for files modified on or after this date (YYYY-MM-DD).
SearchMonkey.DateFrom={{ date_from | default('') }}

# Search for files modified on or before this date (YYYY-MM-DD).
SearchMonkey.DateTo={{ date_to | default('') }}

# Enable word wrap in the results text pane.
SearchMonkey.WordWrap={{ word_wrap | default(False) | lower }}

# Show the toolbar in the application window.
SearchMonkey.ShowToolbar={{ show_toolbar | default(True) | lower }}

# Show the status bar in the application window.
SearchMonkey.ShowStatusBar={{ show_status_bar | default(True) | lower }}

# Display content matches immediately as files are found (Phase 1 behavior).
SearchMonkey.OnePhase={{ one_phase | default(False) | lower }}

# Path to the executable for the preferred text editor.
SearchMonkey.TextEditor={{ text_editor | default('/usr/bin/nano') }}

# Path to the executable for the preferred file browser.
SearchMonkey.FileBrowser={{ file_browser | default('/usr/bin/nautilus') }}

# Additional directories to include in the search scope besides search_dir.
{% for folder in extra_search_dirs | default([]) %}
SearchMonkey.AdditionalDir={{ folder }}
{% endfor %}