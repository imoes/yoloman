# Namespace configuration for PAM module pam_namespace
# Enable or disable namespace polyinstantiation
polyinstantiation {{ polyinstantiation_enabled | lower }}

# Directory to use for polyinstantiated tmp directories
polyinstance_dir {{ polyinstance_dir }}

# Template for polyinstantiated home directories
home_template {{ home_template }}

# List of directories to polyinstantiate, with their modes and template paths
{% for item in poly_dirs %}
# Polyinstantiate {{ item.path }} with mode {{ item.mode }} and template {{ item.template }}
{{ item.path }} {{ item.mode }} {{ item.template }}
{% endfor %}
