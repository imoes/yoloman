# =============================================================================
# Configuration file for yaws-yapp
# =============================================================================
# This file configures the Yaws Application Server (yapp) daemon.
# It defines where compiled beam code is found, which modules to load,
# and the network parameters for the virtual server.
# =============================================================================

# --- General Settings ---

# Path to the directory where yapp beam code is placed.
# The daemon will add this directory to its search path for loading modules.
ebin_dir = {{ ebin_dir | default('/usr/lib/yapp/ebin') }}

# Module to start yapp at startup.
# This specifies the main module that the application server will load and execute.
runmod = {{ runmod | default('yapp') }}

# --- Virtual Server Definition ---

# The following block defines the virtual server configuration for yapp.
# Uncomment the block below to enable the web-GUI for listing, adding,
# and removing Yaws applications.
