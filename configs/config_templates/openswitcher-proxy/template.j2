{# OpenSwitcher Proxy Configuration File #}
{# This file is generated by Ansible. Do not edit manually. #}
{# Config file reference (for documentation purposes): {{ config_file | default('/etc/openswitcher-proxy/config.json') }} #}

{
  {# IP address for the proxy to listen on for incoming connections. #}
  "listen_address": "{{ listen_address | default('127.0.0.1') }}",

  {# Port number for the proxy to listen on. #}
  "listen_port": {{ listen_port | default(8080) }},

  {# Authentication settings for incoming proxy connections. #}
  "authentication": {
    {# Whether to enable authentication for incoming proxy connections. #}
    "enabled": {{ auth_enabled | default(true) | lower }},

    {# Username for authenticating incoming proxy connections. #}
    "username": "{{ auth_username | default('admin') }}",

    {# Password for authenticating incoming proxy connections. #}
    "password": "{{ auth_password | default('changeme') }}"
  },

  {# Connection settings for the Blackmagic ATEM switcher. #}
  "atem_connection": {
    {# IP address or hostname of the Blackmagic ATEM switcher. #}
    "host": "{{ atem_host | default('192.168.1.100') }}",

    {# Port number of the ATEM switcher's control protocol. #}
    "port": {{ atem_port | default(9912) }},

    {# Interval in seconds to retry connection to the ATEM switcher. #}
    "retry_interval": {{ atem_retry_interval | default(5) }}
  },

  {# MQTT integration settings. #}
  "mqtt": {
    {# Whether to enable MQTT integration. #}
    "enabled": {{ mqtt_enabled | default(false) | lower }},

    {# Address of the MQTT broker. #}
    "broker": "{{ mqtt_broker | default('127.0.0.1:1883') }}",

    {# Prefix for MQTT topics. #}
    "topic_prefix": "{{ mqtt_topic_prefix | default('openswitcher') }}",

    {# Quality of Service level for MQTT messages. #}
    "qos": {{ mqtt_qos | default(0) }}
  },

  {# MIDI integration settings. #}
  "midi": {
    {# Whether to enable MIDI integration. #}
    "enabled": {{ midi_enabled | default(false) | lower }},

    {# Path to the MIDI device or port name. #}
    "port": "{{ midi_port | default('/dev/midi') }}",

    {# Name of the virtual MIDI device. #}
    "device_name": "{{ midi_device_name | default('OpenSwitcherMIDI') }}"
  }
}