{
  "provides": {
    "type": "string",
    "default": "stompserver",
    "description": "Service name provided by the init script"
  },
  "required_start": {
    "type": "string",
    "default": "$network $remote_fs",
    "description": "LSB Required-Start dependencies"
  },
  "required_stop": {
    "type": "string",
    "default": "$network $remote_fs",
    "description": "LSB Required-Stop dependencies"
  },
  "default_start": {
    "type": "string",
    "default": "2 3 4 5",
    "description": "LSB Default-Start runlevels"
  },
  "default_stop": {
    "type": "string",
    "default": "0 1 6",
    "description": "LSB Default-Stop runlevels"
  },
  "short_description": {
    "type": "string",
    "default": "a stomp messaging server implemented in Ruby",
    "description": "Short description for LSB header"
  },
  "description": {
    "type": "string",
    "default": "this script starts or stops the stomp messaging server in daemon mode.",
    "description": "Long description for LSB header"
  },
  "copyright_year": {
    "type": "string",
    "default": "2009",
    "description": "Copyright year"
  },
  "copyright_holder": {
    "type": "string",
    "default": "Joshua Timberman",
    "description": "Copyright holder name"
  },
  "copyright_email": {
    "type": "string",
    "default": "joshua@opscode.com",
    "description": "Copyright holder email"
  },
  "name": {
    "type": "string",
    "default": "stompserver",
    "description": "Service name, used for DAEMON, PIDFILE, and paths"
  },
  "start_time": {
    "type": "number",
    "default": "2",
    "description": "Seconds to wait after starting"
  },
  "die_time": {
    "type": "number",
    "default": "2",
    "description": "Seconds to wait during force stop"
  },
  "daemon_user": {
    "type": "string",
    "default": "stompserver",
    "description": "User and group owning the PID directory"
  }
}
