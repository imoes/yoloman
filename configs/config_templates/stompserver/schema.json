{
  "daemon": {
    "type": "bool",
    "default": true,
    "description": "Run stompserver as a daemon process"
  },
  "working_dir": {
    "type": "string",
    "default": "/var/lib/stompserver",
    "description": "Working directory for the stompserver process"
  },
  "logdir": {
    "type": "string",
    "default": "/var/log/stompserver",
    "description": "Directory for stompserver log files"
  },
  "pidfile": {
    "type": "string",
    "default": "/var/run/stompserver/pid",
    "description": "Path to the PID file"
  },
  "storage": {
    "type": "string",
    "default": "/var/lib/stompserver/storage",
    "description": "Directory for queue storage backend data"
  },
  "etcdir": {
    "type": "string",
    "default": "/etc/stompserver",
    "description": "Configuration directory"
  },
  "queue": {
    "type": "string",
    "default": "memory",
    "description": "Queue backend type (e.g., memory, file, redis)"
  },
  "auth": {
    "type": "bool",
    "default": false,
    "description": "Enable authentication for STOMP connections"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug logging"
  },
  "group": {
    "type": "string",
    "default": "stompserver",
    "description": "Group running the stompserver daemon"
  },
  "user": {
    "type": "string",
    "default": "stompserver",
    "description": "User running the stompserver daemon"
  },
  "host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "Host address to bind the STOMP server to"
  },
  "port": {
    "type": "number",
    "default": 61613,
    "description": "Port number for the STOMP server"
  }
}
