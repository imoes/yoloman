#! /bin/sh
### BEGIN INIT INFO
# Provides:          {{ (provides | default('stompserver')) }}
# Required-Start:    {{ (required_start | default('$network $remote_fs')) }}
# Required-Stop:     {{ (required_stop | default('$network $remote_fs')) }}
# Default-Start:     {{ (default_start | default('2 3 4 5')) }}
# Default-Stop:      {{ (default_stop | default('0 1 6')) }}
# Short-Description: {{ (short_description | default('a stomp messaging server implemented in Ruby')) }}
# Description:       {{ (description | default('this script starts or stops the stomp messaging server in daemon mode.')) }}
### END INIT INFO
#
# Copyright (c) {{ (copyright_year | default('2009')) }} {{ (copyright_holder | default('Joshua Timberman')) }}, <{{ (copyright_email | default('joshua@opscode.com')) }}>
#
# stompserver         Startup script for stompserver
# chkconfig: - 80 20
# description: starts up stompserver in daemon mode.

# DAEMON: Path to the executable binary
DAEMON=/usr/bin/{{ (name | default('stompserver')) }}

# NAME: Service name used for PIDFILE and paths
NAME={{ (name | default('stompserver')) }}

# DEFAULT: Path to the default configuration variables file
DEFAULT=/etc/default/$NAME

# DESC: Description used in log messages
DESC={{ (name | default('stompserver')) }}

# PIDFILE: Path to the process ID file
PIDFILE=/var/run/$NAME/pid

# STARTTIME: Seconds to wait after starting to verify status
STARTTIME={{ (start_time | default('2')) }}

# DIETIME: Seconds to wait during force stop before killing
DIETIME={{ (die_time | default('2')) }}

# Check if the daemon binary exists and is executable
test -x $DAEMON || exit 0

# Source LSB init functions library
. /lib/lsb/init-functions

# Create PID directory if it does not exist
if [ ! -d /var/run/{{ (name | default('stompserver')) }} ]; then
  mkdir -p /var/run/{{ (name | default('stompserver')) }}
fi

# Read configuration variable file if it is present
[ -r $DEFAULT ] && . $DEFAULT

# Set ownership of the PID directory to the daemon user
chown {{ (daemon_user | default('stompserver')) }}:{{ (daemon_user | default('stompserver')) }} /var/run/{{ (name | default('stompserver')) }}

# Additional options to pass to the daemon
DAEMON_OPTS="-C /etc/stompserver/stompserver.conf"

running() {                                                                     
  # Check if PID file exists; if not, process is not running
  [ ! -f "$PIDFILE" ] && return 1
  status="0"
  # Check if the process is running using pidofproc
  pidofproc -p $PIDFILE $NAME >/dev/null || status="$?"
  if [ "$status" = "0" ]; then
    return 0
  else
    return 1
  fi
}

start_server() {                                                                 
  # Start the daemon with the PID file
  start_daemon -p $PIDFILE $DAEMON $DAEMON_OPTS                       
  errcode=$?
  return $errcode                                                          
}

stop_server() {                                                                  
  # Stop the daemon, optionally as a specific user
  if [ -z "$DAEMONUSER" ] ; then                                           
    killproc -p $PIDFILE $DAEMON                                        
    errcode=$?
  else
    start-stop-daemon --stop --quiet --pidfile $PIDFILE \               
      --user $DAEMONUSER \ 
      --exec $DAEMON
    errcode=$?  
  fi  
  return $errcode                                                          
}

reload_server() {                                                                
  # Reload the daemon configuration (SIGHUP)
  [ ! -f "$PIDFILE" ] && return 1                                              
  pid=pidofproc $PIDFILE # This is the daemon's pid                           
  kill -1 $pid
  return $?
}

force_stop() {
  # Forcefully stop the daemon if it doesn't respond to standard stop
  [ ! -e "$PIDFILE" ] && return
  if running ; then
    # Send SIGTERM first
    kill -15 $pid
    sleep "$DIETIME"s
    # If still running, send SIGKILL
    if running ; then
      kill -9 $pid
      sleep "$DIETIME"s
      # If still running after SIGKILL, exit with error
      if running ; then
        echo "Cannot kill $NAME (pid=$pid)!"
        exit 1
      fi
    fi
  fi
  # Remove the PID file
  rm -f $PIDFILE
}

case "$1" in
  start)
    log_daemon_msg "Starting $DESC " "$NAME"
    if running ;  then
        log_progress_msg "apparently already running"
        log_end_msg 0
        exit 0
    fi
    if start_server ; then
        [ -n "$STARTTIME" ] && sleep $STARTTIME # Wait some time 
        if  running ;  then
            log_end_msg 0
        else
            log_end_msg 1
        fi
    else
        log_end_msg 1
    fi
    ;;
  stop)
    log_daemon_msg "Stopping $DESC" "$NAME"
    if running ; then
      errcode=0
      stop_server || errcode=$?
      log_end_msg $errcode
    else
      log_progress_msg "apparently not running"
      log_end_msg 0
      exit 0
    fi
    ;;
  force-stop)
    $0 stop
    if running; then
      log_daemon_msg "Stopping (force) $DESC" "$NAME"
      errcode=0
      force_stop || errcode=$?
      log_end_msg $errcode
    fi
    ;;
  restart|force-reload)
    log_daemon_msg "Restarting $DESC" "$NAME"
    errcode=0
    stop_server || errcode=$?
    [ -n "$DIETIME" ] && sleep $DIETIME
    start_server || errcode=$?
    [ -n "$STARTTIME" ] && sleep $STARTTIME
    running || errcode=$?
    log_end_msg $errcode
    ;;
  status)
    status_of_proc -p $PIDFILE $DAEMON "stompserver" && exit 0 || exit $?
    ;;
  reload)
    log_warning_msg "Reloading $NAME daemon: not implemented, as the daemon"
    log_warning_msg "cannot re-read the config file (use restart)."
    ;;
  *)
    N=/etc/init.d/$NAME
    echo "Usage: $N {start|stop|force-stop|restart|force-reload|status}" >&2
    exit 1
    ;;
esac

exit 0