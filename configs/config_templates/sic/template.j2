# sic simple IRC client configuration
#
# This file configures the 'sic' (Simple Internet Chat) client.
# It defines connection parameters and nickname authentication for an IRC network.
# Each setting corresponds to a role field in the Ansible schema.

# Overrides the default host.
# Specifies the hostname or IP address of the IRC server to connect to.
host={{ host | default('irc6.oftc.net') }}

# Overrides the default port.
# Specifies the TCP port on which the IRC server is listening.
port={{ port | default(6667) }}

# Override the default nick.
# Specifies the nickname to use. If left empty, sic defaults to the current system user's login name.
nick={{ nick | default('') }}

# Specifies the keyword to authenticate your nick on the host.
# Used for NICKSERV authentication; leave empty if no authentication is required.
keyword={{ keyword | default('') }}