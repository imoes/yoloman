{
  "defaults_inventory": "/etc/ansible/inventory/prod.yml",
  "defaults_gathering": "explicit",
  "defaults_timeout": 15,
  "defaults_remote_user": "deploy",
  "defaults_connection": "ssh",
  "defaults_pipelining": true,
  "defaults_fact_caching": "jsonfile",
  "defaults_fact_caching_connection": "/var/cache/ansible/facts",
  "defaults_log_path": "/var/log/ansible.log",
  "defaults_callback_whitelist": [
    "timer",
    "profile_tasks"
  ],
  "privilege_escalation_become_method": "sudo",
  "privilege_escalation_become_user": "root",
  "privilege_escalation_become_ask_pass": false,
  "ssh_connection_control_path": "/tmp/ansible-ssh-%h-%p-%r",
  "ssh_connection_retries": 3,
  "inventory_enable_plugins": [
    "yaml",
    "ini"
  ],
  "inventory_host_key_checking": true,
  "inventory_timeout": 60,
  "galaxy_server_list": [
    "https://galaxy.ansible.com",
    "https://cloud.redhat.com/api/v2/external-resources/"
  ]
}
