# udev configuration file
# Settings applied when udevd starts; modify only if needed
# See `man udev.conf` for details

# Path to the udev database (run-time state)
{{ db_path }}

# Path to the directory where udev populates /dev
{{ dev_dir }}

# Path to the directory where firmware files are searched for
{{ firmware_path }}

# Default file permissions for devices created by udev
{{ default_mode }}

# Default ownership (user:group) for devices created by udev
{{ default_owner }}

# Maximum number of events handled per second
{{ event_timeout }}

# Enable or disable logging to syslog
{{ logging }}

# Syslog priority for logging
{{ logging_priority }}

# Enable or disable the built-in rule engine
{{ rule_engine }}

# Number of worker threads
{{ workers }}