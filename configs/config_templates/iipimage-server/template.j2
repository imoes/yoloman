# ==============================================================================
# IIPImage Server (iipsrv) Apache Configuration Template
# ==============================================================================
# This template configures the Apache web server to serve the IIPImage FastCGI
# application. It handles script aliasing, location-based access control,
# environment variable injection for the IIP server, and FastCGI process
# management settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Script Alias Configuration
# ------------------------------------------------------------------------------
# Maps a URL path to the filesystem location of the IIP server CGI/FCGI script.
# Directive: ScriptAlias
# Source: iipimage_location_path (URL prefix), iipimage_script_alias_path (filesystem path)

ScriptAlias {{ iipimage_location_path | default('/iipsrv') | trim('/') | regex_replace('/$', '') }}/ \
    "{{ iipimage_script_alias_path | default('/usr/lib/iipimage-server/') }}"

# ------------------------------------------------------------------------------
# Location Block: Access Control and Handler Definition
# ------------------------------------------------------------------------------
# Defines how Apache handles requests matching the IIP server URL path.
# Source: iipimage_location_path

<Location "{{ iipimage_location_path | default('/iipsrv') | trim('/') | regex_replace('/$', '') }}/">
    # AllowOverride: Prevents .htaccess files from overriding these settings.
    AllowOverride None

    # Options: Disable directory listing and other dangerous Apache features.
    Options None

    # Version-dependent Access Control
    <IfModule mod_version.c>
        # Apache 2.2 style access control (Legacy)
        <IfVersion < 2.4>
            Order allow,deny
            Allow from all
        </IfVersion>

        # Apache 2.4 style access control (Modern)
        <IfVersion >= 2.4>
            Require all granted
        </IfVersion>
    </IfModule>

    # FCGI Handler
    # Tells Apache to treat files with the .fcgi extension as FastCGI scripts.
    AddHandler fcgid-script .fcgi
</Location>

# ------------------------------------------------------------------------------
# IIP Server Environment Variables
# ------------------------------------------------------------------------------
# These variables are passed to the IIP server process via FcgidInitialEnv.
# They configure the internal behavior of the iipsrv binary.

# Verbosity level for the IIP server logs (e.g., 0=quiet, 1=info, 2=debug).
# Source: iipimage_verbosity
FcgidInitialEnv VERBOSITY "{{ iipimage_verbosity | default('1') }}"

# Path to the log file for the IIP server.
# Source: iipimage_logfile
FcgidInitialEnv LOGFILE "{{ iipimage_logfile | default('/var/log/iipsrv.log') }}"

# Maximum number of images to keep in the cache.
# Source: iipimage_max_image_cache_size
FcgidInitialEnv MAX_IMAGE_CACHE_SIZE "{{ iipimage_max_image_cache_size | default('10') }}"

# JPEG output quality level (0-100). Higher values mean better quality but larger files.
# Source: iipimage_jpeg_quality
FcgidInitialEnv JPEG_QUALITY "{{ iipimage_jpeg_quality | default('90') }}"

# Maximum width or height of an image in pixels for processing.
# Prevents processing of excessively large images.
# Source: iipimage_max_cvt
FcgidInitialEnv MAX_CVT "{{ iipimage_max_cvt | default('5000') }}"

# Comma-separated list of memcached servers for caching.
# Source: iipimage_memcached_servers
FcgidInitialEnv MEMCACHED_SERVERS "{{ iipimage_memcached_servers | default('localhost') }}"

# ------------------------------------------------------------------------------
# FastCGI Process Management
# ------------------------------------------------------------------------------
# Controls how Apache manages the FastCGI child processes.

# Idle timeout for FCGI processes in seconds.
# 0 means unlimited (processes never die due to idle time).
# Source: iipimage_fcgid_idle_timeout
FcgidIdleTimeout {{ iipimage_fcgid_idle_timeout | default('0') }}

# Maximum number of FCGI processes per class.
# Source: iipimage_fcgid_max_processes_per_class
FcgidMaxProcessesPerClass {{ iipimage_fcgid_max_processes_per_class | default('1') }}
