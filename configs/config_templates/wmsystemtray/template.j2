# Configuration file for wmsystemtray
# Generated by Ansible Jinja2 template. Self-documenting: every directive is preceded
# by a comment explaining the schema field's purpose and constraints. All variable
# references include a safe default via the `default()` filter to prevent render failures
# when an upstream role omits the variable.

# Name of the X display to use. Default is ':0' (local display).
# Schema field: display (string)
DISPLAY={{ display | default(':0') }}

# Verbose logging. When true, wmsystemtray prints more informational messages to the console.
# Schema field: verbose (boolean)
VERBOSE={{ verbose | default(false) | lower }}

# Quiet mode. When true, suppresses most output (overrides verbose if both are set).
# Schema field: quiet (boolean)
QUIET={{ quiet | default(false) | lower }}

# Use 16x16 tray icons instead of the default 24x24 size. Useful for compact docks.
# Schema field: small_icons (boolean)
SMALL_ICONS={{ small_icons | default(false) | lower }}

# Number of dock windows to open at startup.
# Schema field: window_count (integer)
WINDOW_COUNT={{ window_count | default(1) }}

# Show window index numbers (ID-windows) on the dock interface for debugging/identification.
# Schema field: show_window_ids (boolean)
SHOW_WINDOW_IDS={{ show_window_ids | default(false) | lower }}

# Fill the top row of each dock window completely before placing any icons in the second row.
# Schema field: fill_rows (boolean)
FILL_ROWS={{ fill_rows | default(false) | lower }}

# Placement of scrolling arrows within the dock window. Valid values: 'both', 'horizontal', or 'vertical'.
# Schema field: arrow_placement (string)
ARROW_PLACEMENT={{ arrow_placement | default('both') }}

# Color for the page indicator and --id-windows indicators. Must be a valid XParseColor string
# (e.g., 'black', 'red', '#FFFFFF').
# Schema field: foreground_color (string)
FOREGROUND_COLOR={{ foreground_color | default('black') }}

# Color for the window background in non-Window Maker mode. If left empty (default),
# the parent window's background (ParentRelative) is used.
# Schema field: background_color (string)
BACKGROUND_COLOR={{ background_color | default('') }}

# Activate non-Window Maker mode. Use this if wmsystemtray is running under a WM other
# than Window Maker to ensure correct window decoration and placement.
# Schema field: non_wmaker (boolean)
NON_WMAKER={{ non_wmaker | default(false) | lower }}