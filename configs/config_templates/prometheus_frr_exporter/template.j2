# /etc/default/prometheus-frr-exporter
# Environment variables for the prometheus-frr-exporter service

# The user to run the exporter as (default: 'frr')
FRR_EXPORTER_USER="{{ user }}"

# The group to run the exporter as (default: 'frr')
FRR_EXPORTER_GROUP="{{ group }}"

# Address and port the exporter listens on (default: '127.0.0.1:9342')
FRR_EXPORTER_LISTEN="{{ listen_address }}:{{ listen_port }}"

# Path to FRR's vty socket (default: '/run/frr/vty.sock')
FRR_VTY_SOCKET="{{ vty_socket_path }}"

# Path to FRR's daemons config (optional, for per-daemon metrics)
# FRR_DAEMONS_CONFIG="{{ daemons_config_path }}"

# Enable verbose logging (true/false; default: false)
FRR_EXPORTER_DEBUG="{{ debug | string | lower }}"

# Comma-separated list of FRR daemons to scrape (e.g., 'bgp,isis,ospf6'; default: all enabled)
FRR_EXPORTER_DAEMONS="{{ daemons | join(',') }}"

# Timeout for connections to FRR vty socket (in seconds; default: 5)
FRR_EXPORTER_TIMEOUT="{{ timeout }}"

# Enable TLS for the exporter endpoint (true/false; default: false)
FRR_EXPORTER_TLS="{{ tls_enabled | string | lower }}"

# Path to TLS certificate file (required if TLS enabled)
# FRR_EXPORTER_TLS_CERT="{{ tls_cert_path }}"

# Path to TLS private key file (required if TLS enabled)
# FRR_EXPORTER_TLS_KEY="{{ tls_key_path }}"
