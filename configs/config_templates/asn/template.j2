# ASN (Asynchronous Scanner/Network) server configuration
# Generated by Ansible Jinja2 template.
# All variable references use the 'default' filter with schema-specified defaults
# to ensure safe rendering even when variables are undefined.

{# IP address (IPv4 or IPv6) to bind the server to. Default: 127.0.0.1 (IPv4) or ::1 (IPv6). #}
BIND_ADDRESS={{ (values | default({})).bind_address | default('127.0.0.1') }}

{# TCP port to bind the server to. #}
BIND_PORT={{ (values | default({})).bind_port | default(49200) }}

{# List of hosts (IPs or CIDR ranges) allowed to connect, comma-separated in rendered output. #}
{% if (values | default({})).allow_hosts is defined and (values | default({})).allow_hosts %}
# allowed hosts (comma-separated)
--allow={{ (values | default({})).allow_hosts | join(',') }}
{% endif %}

{# Path to a file containing allowed hosts (one per line or comma/whitespace-separated). #}
{% if (values | default({})).allow_file is defined and (values | default({})).allow_file %}
# file listing allowed hosts
--allowfile={{ (values | default({})).allow_file }}
{% endif %}

{# List of hosts (IPs or CIDR ranges) denied from connecting, comma-separated in rendered output. #}
{% if (values | default({})).deny_hosts is defined and (values | default({})).deny_hosts %}
# denied hosts (comma-separated)
--deny={{ (values | default({})).deny_hosts | join(',') }}
{% endif %}

{# Path to a file containing denied hosts. #}
{% if (values | default({})).deny_file is defined and (values | default({})).deny_file %}
# file listing denied hosts
--denyfile={{ (values | default({})).deny_file }}
{% endif %}

{# Maximum number of simultaneous connections accepted. Default: 100. #}
{% if (values | default({})).max_connections is defined %}
# maximum simultaneous connections
--max-conns={{ (values | default({})).max_connections }}
{% endif %}

{# Enable verbose output and debug logging to $HOME/asndebug.log. #}
{% if (values | default({})).verbose is defined and (values | default({})).verbose %}
# enable debug output
-v
{% endif %}