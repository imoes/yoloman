# Defaults for ums2net initscript
# sourced by /etc/init.d/ums2net

#
# This is a POSIX shell fragment
#

# System-wide ums2net conffile. The initscripts
# are triggered by the presence of this file.
# Path to the main ums2net configuration file.
CONFFILE="{{ conffile_path | default('/etc/ums2net.conf') }}"

# Default options. These take precedence over anything
# configured by CONFFILE above, so if you like to have
# any of them specified in CONFFILE, remove them from
# the line below.
# OPTIONS="{{ default_options | default('') }}"