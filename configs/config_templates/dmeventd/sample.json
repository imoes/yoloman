{
  "poll_interval": 10,
  "dbus_socket": "",
  "max_workers": 4,
  "log_level": 2,
  "pid_file": "/run/dmeventd.pid",
  "log_file": "/var/log/dmeventd.log",
  "background_processing": true,
  "targets": [
    {
      "name": "lvm2-logical-volume",
      "path": "/dev/mapper/*-*",
      "polling_enabled": true,
      "event_types": [
        "ERROR",
        "THRESHOLD",
        "STATUS"
      ]
    },
    {
      "name": "thin-pool",
      "path": "/dev/mapper/vg-pool",
      "polling_enabled": false,
      "event_types": [
        "THRESHOLD",
        "STATUS"
      ]
    },
    {
      "name": "snapshot",
      "path": "/dev/mapper/vg-snap",
      "polling_enabled": true,
      "event_types": [
        "ERROR",
        "STATUS"
      ]
    }
  ]
}
