# Path (relative or absolute) to the .local include file for persistent customization.
# This allows users to override or extend Firejail profiles without modifying the main config.
include {{ include_allow_bin_sh_local | default('allow-bin-sh.local') }}

# Disable blacklisting for standard shell paths.
# This ensures that bash, dash, and sh are accessible within the sandboxed environment.
noblacklist ${PATH}/bash
noblacklist ${PATH}/dash
noblacklist ${PATH}/sh