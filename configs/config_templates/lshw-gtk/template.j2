# ==============================================================================
# lshw-gtk Configuration Template
# ==============================================================================
# This template generates a wrapper script or environment configuration for
# launching lshw-gtk, as the application itself relies on GTK preferences
# (gsettings/dconf) and command-line arguments rather than a dedicated config file.
#
# Self-documenting: Every variable usage is prefixed with a comment describing
# its schema definition and default value.
# ==============================================================================

# --------------------------------------------------------------------------
# Variable: lshw_gtk_quiet
# Schema Default: False
# Description: Whether to suppress non-essential output or run in a background mode.
# --------------------------------------------------------------------------
LSHW_GTK_QUIET={{ lshw_gtk_quiet | default(false) }}

# --------------------------------------------------------------------------
# Variable: lshw_output_format
# Schema Default: 'html'
# Description: Default output format for lshw if exported from the GUI, one of: html, xml, json, short.
# --------------------------------------------------------------------------
LSHW_OUTPUT_FORMAT={{ lshw_output_format | default('html') }}

# --------------------------------------------------------------------------
# Variable: lshw_log_file
# Schema Default: '/var/log/lshw-gtk.log'
# Description: Path to a log file for capturing application output or errors.
# --------------------------------------------------------------------------
LSHW_LOG_FILE={{ lshw_log_file | default('/var/log/lshw-gtk.log') }}

# --------------------------------------------------------------------------
# Variable: lshw_save_state
# Schema Default: True
# Description: Whether to remember the last viewed hardware state or window geometry.
# --------------------------------------------------------------------------
LSHW_SAVE_STATE={{ lshw_save_state | default(true) }}

# --------------------------------------------------------------------------
# Variable: lshw_classes
# Schema Default: []
# Description: List of hardware classes to filter display for. Empty list shows all.
# --------------------------------------------------------------------------
LSHW_CLASSES={{ lshw_classes | default([]) | tojson }}