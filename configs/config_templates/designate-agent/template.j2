#!/bin/sh
### BEGIN INIT INFO
# Provides:          {{ service_name | default('designate-agent') }}
# Required-Start:    $network $local_fs $remote_fs $syslog
# Required-Stop:     $remote_fs
# Should-Start:      postgresql mysql keystone rabbitmq-server ntp
# Should-Stop:       postgresql mysql keystone rabbitmq-server ntp
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: OpenStack Designate DNS Agent
# Description:       Frontend Designate Agent server for DNSaaS
### END INIT INFO

# Author: Thomas Goirand <zigo@debian.org>

# Description of the running service instance
# Schema field: service_name
DESC="OpenStack Designate DNS Agent ({{ service_name | default('designate-agent') }})"

# Project/OS service name, used for constructing paths, user/group names
# Schema field: project_name
PROJECT_NAME={{ project_name | default('designate') }}

# Base name for the executable and PID files
NAME=${PROJECT_NAME}-agent

# Environment variable for Oslo messaging process name
# Schema field: service_name
export OS_OSLO_MESSAGING_RABBIT_PROCESSNAME={{ service_name | default('designate-agent') }}

# ==============================================================================
# The content after this line is standardized by openstack-pkg-tools
# It handles uWSGI integration, daemon detection, and startup logic.
# ==============================================================================

# Author: Thomas Goirand <zigo@debian.org>
# Author: Ondřej Nový <novy@ondrej.org>

# PATH should only include /usr/* if it runs after the mountnfs.sh script
PATH=/sbin:/usr/sbin:/bin:/usr/bin

# --- uWSGI Integration Logic ---
# Checks if uWSGI-specific environment variables are set.
# If so, configures the daemon to run via uWSGI instead of directly.
# Schema field: uwsgi_port
# Schema field: uwsgi_ini_path
# Schema field: uwsgi_ini_app
if [ -n "${UWSGI_PORT}" ] && [ -n "${UWSGI_INI_PATH}" ] && [ -n "${UWSGI_INI_APP}" ] ; then
	# If the app-specific INI file does not exist, skip uWSGI startup
	if ! [ -f "${UWSGI_INI_APP}" ] ; then
		exit 0
	fi

	# SSL/TLS Configuration: Locate private key and public certificate
	if [ -d /etc/${PROJECT_NAME}/ssl/private ] ; then
		KEY_FILE=$(find /etc/${PROJECT_NAME}/ssl/private -type f -iname '*.pem' 2>/dev/null | head -n 1)
	fi

	# Handle certificate distribution (puppet vs local)
	if [ -e /usr/local/share/ca-certificates/puppet_openstack.crt ] ; then
		CERT_FILE=/usr/local/share/ca-certificates/puppet_openstack.crt
	else
		if [ -d /etc/${PROJECT_NAME}/ssl/public ] ; then
			CERT_FILE=$(find /etc/${PROJECT_NAME}/ssl/public -type f -iname '*.crt' 2>/dev/null | head -n 1)
		fi
	fi

	# Daemon Binary Detection
	# Try to find the specific uwsgi_python binary version available on the system
	# Versions 3 through 3.19 are checked
	for i in 3 35 36 37 38 39 310 311 312 313 314 315 316 317 318 319 ; do
		if [ -x /usr/bin/uwsgi_python${i} ] ; then
			DAEMON=/usr/bin/uwsgi_python${i}
		fi
	done

	# Configuration Binding Logic
	# If explicit bind configuration directives are provided, use pkgos_func to parse them
	if [ -n "${UWSGI_BIND_CONFIG_FILE}" ] && [ -r "${UWSGI_BIND_CONFIG_FILE}" ] && [ -n "${UWSGI_BIND_CONFIG_SECTION}" ] && [ -n "${UWSGI_BIND_CONFIG_IP_DIRECTIVE}" ] && [ -n "${UWSGI_BIND_CONFIG_PORT_DIRECTIVE}" ] && [ -r /usr/share/openstack-pkg-tools/pkgos_func ] ; then
		. /usr/share/openstack-pkg-tools/pkgos_func

		# Get Bind IP
		pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_IP_DIRECTIVE}
        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
			UWSGI_BIND_IP=${RET}
		fi

		# Get Bind Port
		pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_PORT_DIRECTIVE}
        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
			UWSGI_PORT=${RET}
		fi

		# Get Number of Workers/Processes
		if [ -n "${UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE}" ] ; then
			pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} ${UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE}
	        if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
				UWSGI_PROCESSES=" --processes ${RET}"
			else
				# Fallback: half the number of available CPUs
				UWSGI_PROCESSES=" --processes "$(( $(nproc) / 2 ))
			fi
		fi

		# Special case for Swift Object Server: Multiple ports per device
		if [ "${UWSGI_BIND_CONFIG_FILE}" = "/etc/swift/object-server.conf" ] ; then
			pkgos_inifile get ${UWSGI_BIND_CONFIG_FILE} ${UWSGI_BIND_CONFIG_SECTION} devices
			if [ -n "${RET}" ] && [ ! "${RET}" = "NOT_FOUND" ] ; then
				DEVICES_PATH=${RET}
				NUM_DEVICES=$(ls ${DEVICES_PATH} | wc -l)
				COUNT=0
				while [ "${COUNT}" != "${NUM_DEVICES}" ] ; do
					CUR_PORT=$(( ${UWSGI_PORT} + ${COUNT} ))
					BIND_PARAMS="${BIND_PARAMS} --http-socket ${UWSGI_BIND_IP}:${CUR_PORT}"
					COUNT=$(( ${COUNT} + 1 ))
				done
			fi
		fi
	else
		# Default Bind IP is empty (listens on all interfaces or uses explicit env var)
		UWSGI_BIND_IP=""
	fi

	# Construct Daemon Arguments
	if [ -n "${BIND_PARAMS}" ] ; then
		DAEMON_ARGS="${BIND_PARAMS}${UWSGI_PROCESSES}"
	else
		# Determine HTTP or HTTPS socket based on SSL presence
		# Schema field: uwsgi_bind_ip
		# Schema field: uwsgi_port
		if [ -n "${KEY_FILE}" ] && [ -n "${CERT_FILE}" ] ; then
			DAEMON_ARGS="--https-socket ${UWSGI_BIND_IP}:${uwsgi_port | default(9001)},${CERT_FILE},${KEY_FILE}${UWSGI_PROCESSES}"
		else
			DAEMON_ARGS="--http-socket ${UWSGI_BIND_IP}:${uwsgi_port | default(9001)}${UWSGI_PROCESSES}"
		fi
	fi

	# Append INI file path to arguments
	# Schema field: uwsgi_ini_path
	DAEMON_ARGS="${DAEMON_ARGS} --ini ${uwsgi_ini_path | default('/etc/designate/designate-agent.ini')}"
	
	# Flags to disable default OpenStack config/logfile injection
	NO_OPENSTACK_CONFIG_FILE_DAEMON_ARG=yes
	NO_OPENSTACK_LOGFILE_DAEMON_ARG=yes
fi

# --- Daemon Binary Default ---
# If uWSGI wasn't used or didn't set DAEMON, default to the direct executable
if [ -z "${DAEMON}" ] ; then
	DAEMON=/usr/bin/${NAME}
fi

# --- Path and User Configuration ---

# PID File Location
# Project-specific subdirectory: /var/run/{project_name}/{name}.pid
# Schema field: pid_file_dir (used for context, actual path logic is hardcoded in script)
PIDFILE=/var/run/${PROJECT_NAME}/${NAME}.pid

# Script Name (used for help messages and default paths)
if [ -z "${SCRIPTNAME}" ] ; then
	SCRIPTNAME=/etc/init.d/${NAME}
fi

# System User and Group for Daemon Execution
# Defaults to the project name if not explicitly set
# Schema field: system_user
if [ -z "${SYSTEM_USER}" ] ; then
	SYSTEM_USER={{ system_user | default('designate') }}
fi

# Schema field: system_group
if [ -z "${SYSTEM_GROUP}" ] ; then
	SYSTEM_GROUP={{ system_group | default('designate') }}
fi

# Prepare chuid argument if not running as root
if [ "${SYSTEM_USER}" != "root" ] ; then
	STARTDAEMON_CHUID="--chuid ${SYSTEM_USER}:${SYSTEM_GROUP}"
fi

# Configuration File Path
# Defaults to /etc/{project_name}/{project_name}.conf
# Schema field: config_file
if [ -z "${CONFIG_FILE}" ] ; then
	CONFIG_FILE={{ config_file | default('/etc/designate/designate.conf') }}
fi

# Log File Path
# Defaults to /var/log/{project_name}/{name}.log
# Schema field: log_file (used for context)
LOGFILE=/var/log/${PROJECT_NAME}/${NAME}.log

# Inject config-file arg unless uWSGI manages it internally
if [ -z "${NO_OPENSTACK_CONFIG_FILE_DAEMON_ARG}" ] ; then
	DAEMON_ARGS="--config-file=${CONFIG_FILE} ${DAEMON_ARGS}"
fi

# --- Pre-flight Checks ---

# Exit if the daemon binary is not executable
[ -x $DAEMON ] || exit 0

# Create required directory structure if run as root
# Creates /var/lock/{project}, /var/run/{project}, /var/cache/{project}
if [ `whoami` = "root" ] ; then
	for i in lock run cache ; do
		mkdir -p /var/$i/${PROJECT_NAME}
		chown ${SYSTEM_USER}:${SYSTEM_GROUP} /var/$i/${PROJECT_NAME}
	done
fi

# Import LSB logging functions
. /lib/lsb/init-functions

RET=0

# --- Logging Configuration ---
# Source global openstack defaults and service-specific defaults
[ -r /etc/default/openstack ] && . /etc/default/openstack
[ -r /etc/default/$NAME ] && . /etc/default/$NAME

# Add syslog argument if USE_SYSLOG is set to 'yes'
# Schema field: use_syslog
[ "x$USE_SYSLOG" = "xyes" ] && DAEMON_ARGS="$DAEMON_ARGS --use-syslog"

# Add logfile argument if NO_OPENSTACK_LOGFILE flag is not set and USE_LOGFILE is not 'no'
# Schema field: use_logfile
# Schema field: log_file
if [ -z "${NO_OPENSTACK_LOGFILE_DAEMON_ARG}" ] ; then
	[ "x$USE_LOGFILE" != "xno" ] && DAEMON_ARGS="$DAEMON_ARGS --log-file={{ log_file | default('/var/log/designate/designate-agent.log') }}"
fi

# --- Start Function (SysV Init) ---
do_start() {
	start-stop-daemon \
		--start \
		--quiet \
		--background ${STARTDAEMON_CHUID} \
		--make-pidfile --pidfile ${PIDFILE} \
		--chdir /var/lib/${PROJECT_NAME} \
		--startas $DAEMON \
		--test > /dev/null \
		|| return 1
	
	# Schema field: pyargv
	if [ -n "${PYARGV}" ] ; then
		start-stop-daemon \
			--start \
			--quiet \
			--background ${STARTDAEMON_CHUID} \
			--make-pidfile --pidfile ${PIDFILE} \
			--chdir /var/lib/${PROJECT_NAME} \
			--startas $DAEMON \
			-- $DAEMON_ARGS --pyargv "${PYARGV}" \
			|| return 2
	else
		start-stop-daemon \
			--start \
			--quiet \
			--background ${STARTDAEMON_CHUID} \
			--make-pidfile --pidfile ${PIDFILE} \
			--chdir /var/lib/${PROJECT_NAME} \
			--startas $DAEMON \
			-- $DAEMON_ARGS \
			|| return 2
	fi
}

# --- Stop Function ---
do_stop() {
	start-stop-daemon \
		--stop \
		--quiet \
		--retry=TERM/30/KILL/5 \
		--pidfile $PIDFILE
	RETVAL=$?
	rm -f $PIDFILE
	return "$RETVAL"
}

# --- Systemd Start Helper ---
# Used by systemd drop-in units to exec the daemon directly with correct args
# Sets umask 0022 to ensure log files are 0644
do_systemd_start() {
	umask 0022
	# Schema field: pyargv
	if [ -n "${PYARGV}" ] ; then
		exec $DAEMON $DAEMON_ARGS --pyargv "${PYARGV}"
	else
		exec $DAEMON $DAEMON_ARGS
	fi
}

# --- Case Statement for Service Commands ---
case "$1" in
start)
	log_daemon_msg "Starting $DESC" "$NAME"
	do_start
	case $? in
		0|1) log_end_msg 0 ; RET=$? ;;
		2)   log_end_msg 1 ; RET=$? ;;
	esac
;;
stop)
	log_daemon_msg "Stopping $DESC" "$NAME"
	do_stop
	case $? in
		0|1) log_end_msg 0 ; RET=$? ;;
		2)   log_end_msg 1 ; RET=$? ;;
	esac
;;
status)
	status_of_proc "$DAEMON" "$NAME"
	RET=$?
;;
systemd-start)
	do_systemd_start
;;  
show-args)
	if [ -n "${PYARGV}" ] ; then
		echo $DAEMON $DAEMON_ARGS --pyargv \"${PYARGV}\"
	else
		echo $DAEMON $DAEMON_ARGS
	fi
;;
restart|force-reload)
	log_daemon_msg "Restarting $DESC" "$NAME"
	do_stop
	case $? in
		0|1)
			do_start
			case $? in
				0) log_end_msg 0 ; RET=$? ;;
				1) log_end_msg 1 ; RET=$? ;;
				*) log_end_msg 1 ; RET=$? ;;
			esac
		;;
		*) log_end_msg 1 ; RET=$? ;;
	esac
;;
*)
	echo "Usage: $SCRIPTNAME {start|stop|status|restart|force-reload|systemd-start}" >&2
	RET=3
;;
esac

exit $RET