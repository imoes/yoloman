# Ansible-generated init defaults for yadifa
# This file is sourced by the SysV init script /etc/init.d/yadifa.
# It sets the location of the main configuration file and daemon arguments.

# Path to the main YADIFA daemon configuration file (yadifad.conf).
# This file contains zones, logging, and network settings for the DNS server.
# YADIFA_CONF: Specifies the absolute path to the primary configuration file loaded by the daemon.
YADIFA_CONF="{{ (yadifa_conf | default('/etc/yadifa/yadifad.conf')) }}"

# Additional options passed to the Daemon.
# The default includes '-d' (daemonize) and '-c' (config file).
# The $CONFIG_FILE variable is expected to be set by the init script itself
# using the value defined above.
# DAEMON_ARGS: Command-line arguments forwarded to the yadifad binary.
DAEMON_ARGS="-d -c $CONFIG_FILE"