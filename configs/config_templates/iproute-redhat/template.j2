# ==============================================================================
# iproute2 Default Configuration
# ==============================================================================
# This file configures default behaviors for the iproute2 suite (ip, iproute,
# etc.). It is managed by Ansible. User modifications should be placed in
# /etc/iproute2/ or handled via this template's variables.
#
# All variables must use the exact names defined in the schema to ensure
# correct mapping. Missing variables will fall back to the defaults specified
# in the comments below.
# ==============================================================================

# ------------------------------------------------------------------------------
# Default Gateway and Routing Policies
# ------------------------------------------------------------------------------

# Default metric for routes
# This value is used when no metric is explicitly specified for a route.
# Lower metrics are preferred.
# Type: integer
# Default: 0
DEFAULT_METRIC={{ DEFAULT_METRIC | default(0) }}

# Default table for routing
# The routing table number to use if no table is specified.
# Table 253 is often reserved for 'default' or 'main' contexts in some
# distributions, but standard Linux uses 253 for 'default' in many iproute2
# configurations.
# Type: integer
# Default: 253
DEFAULT_TABLE={{ DEFAULT_TABLE | default(253) }}

# Default scope for routes
# Defines the scope of routes by default. 'universe' means reachable anywhere.
# Other valid scopes: 'host' (local host), 'link' (link-local), 'site' (site-local).
# Type: string
# Default: universe
DEFAULT_SCOPE={{ DEFAULT_SCOPE | default('universe') }}

# Default protocol for routes
# The protocol identifier for routes created without explicit protocol.
# 5 corresponds to 'static' routing protocol in iproute2.
# Type: integer
# Default: 5
DEFAULT_PROTOCOL={{ DEFAULT_PROTOCOL | default(5) }}

# ------------------------------------------------------------------------------
# Interface Settings
# ------------------------------------------------------------------------------

# Default link local address prefix length
# Used for IPv6 link-local addresses (::168.112.x.x) if not explicitly set.
# Type: integer
# Default: 64
DEFAULT_LL_PREFIX={{ DEFAULT_LL_PREFIX | default(64) }}

# ------------------------------------------------------------------------------
# Neighbor Discovery Settings (IPv6)
# ------------------------------------------------------------------------------

# Default reachable time in milliseconds
# The time a neighbor entry is considered valid after receiving a reachability
# confirm. 0 means to use the value from the router advertisement or default
# kernel calculation.
# Type: integer
# Default: 0
DEFAULT_REACHABLE_TIME={{ DEFAULT_REACHABLE_TIME | default(0) }}

# Default retransmit time in milliseconds
# The time between neighbor solicitation retransmissions.
# Type: integer
# Default: 0
DEFAULT_RETRANSMIT_TIME={{ DEFAULT_RETRANSMIT_TIME | default(0) }}

# Default base reachable time in milliseconds
# The base time for computing reachable time from Neighbor Advertisements.
# Type: integer
# Default: 0
DEFAULT_BASE_REACHABLE_TIME={{ DEFAULT_BASE_REACHABLE_TIME | default(0) }}

# Default max reachable time in milliseconds
# Maximum reachable time, used to cap the computed reachable time.
# Type: integer
# Default: 0
DEFAULT_MAX_REACHABLE_TIME={{ DEFAULT_MAX_REACHABLE_TIME | default(0) }}

# Default delay first probe time in milliseconds
# Delay before sending the first neighbor solicitation probe.
# Type: integer
# Default: 5
DEFAULT_DELAY_FIRST_PROBE_TIME={{ DEFAULT_DELAY_FIRST_PROBE_TIME | default(5) }}

# Default max number of unicast probes
# Maximum number of unicast Neighbor Solicitations to send before marking a
# neighbor as unreachable.
# Type: integer
# Default: 0
DEFAULT_MAX_UNICAST_PROBES={{ DEFAULT_MAX_UNICAST_PROBES | default(0) }}

# Default max anycast response delay in milliseconds
# Maximum delay for anycast responses (e.g., from multiple routers).
# Type: integer
# Default: 0
DEFAULT_MAX_ANYCAST_RESPONSE_DELAY={{ DEFAULT_MAX_ANYCAST_RESPONSE_DELAY | default(0) }}

# Default max multicast response delay in milliseconds
# Maximum delay for multicast responses (e.g., from multiple neighbors).
# Type: integer
# Default: 0
DEFAULT_MAX_MULTICAST_RESPONSE_DELAY={{ DEFAULT_MAX_MULTICAST_RESPONSE_DELAY | default(0) }}

# Default max unicast response delay in milliseconds
# Maximum delay for unicast responses.
# Type: integer
# Default: 0
DEFAULT_MAX_UNICAST_RESPONSE_DELAY={{ DEFAULT_MAX_UNICAST_RESPONSE_DELAY | default(0) }}
