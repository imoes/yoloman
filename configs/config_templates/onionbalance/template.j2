# OnionBalance logrotate configuration
# Manages rotation of OnionBalance daemon logs located in the log directory.

{{ log_directory | default('/var/log/onionbalance') }}/*log {
    # Enable compression of rotated log files to save disk space.
    compress

    # Create new log files after rotation with specified permissions, owner, and group.
    # Owner is the system user running the OnionBalance daemon.
    # Group is 'adm' to allow system administrators to read logs.
    create 0640 {{ daemon_user | default('onionbalance') }} adm

    # Rotate logs daily.
    daily

    # Delay compression of the most recently rotated file until the next rotation cycle.
    # This ensures that any ongoing write operations to the rotated file are completed
    # before it is compressed, preventing potential data loss or corruption during compression.
    delaycompress

    # Do not return an error if the log directory or log files do not exist.
    # This prevents errors during rotation if the service has not started or logs have been manually removed.
    missingok

    # Do not rotate the log file if it is empty.
    # This prevents creation of empty rotated log files (e.g., app.log.1.gz) which serve no purpose.
    notifempty

    # Keep the 14 most recent rotated log files. Older files will be deleted.
    # This balances disk space usage with the ability to diagnose issues from recent history.
    rotate 14

    # Run all scripts (prerotate, postrotate) only once for the whole group of matching files.
    # Since we are rotating all *.log files in the directory, this ensures the service is signaled
    # only once (e.g., via USR1 or SIGHUP) to reopen log files, rather than once per file.
    sharedscripts
}
