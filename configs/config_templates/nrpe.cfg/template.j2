# NRPE daemon configuration
[nrpe]
# The port NRPE should listen on
port = {{ nrpe_port }}

# IP address(es) allowed to connect to this NRPE daemon (comma-separated, or `all` for unrestricted)
allowed_hosts = {{ allowed_hosts | join(',') }}

# User and group under which NRPE runs
user = {{ nrpe_user }}
group = {{ nrpe_group }}

# Log file path
logfile = {{ nrpe_logfile }}

# Log level: 0 = none, 1 = errors, 2 = warnings, 3 = info, 4 = debug
log_level = {{ nrpe_log_level }}

# Timeout (seconds) for command execution
command_timeout = {{ command_timeout }}

# Connection timeout (seconds)
connection_timeout = {{ connection_timeout }}

# Enable SSL (true/false)
ssl = {{ nrpe_ssl | lower }}

# SSL certificate and key paths (required if ssl = true)
{% if nrpe_ssl %}
ssl_cert_file = {{ nrpe_ssl_cert_file }}
ssl_key_file = {{ nrpe_ssl_key_file }}
ssl_ca_cert_file = {{ nrpe_ssl_ca_cert_file | default('') }}
ssl_check_peer = {{ nrpe_ssl_check_peer | lower }}
ssl_check_host = {{ nrpe_ssl_check_host | lower }}
{% endif %}

# Include additional command definitions from external files
{% for cmd_def_path in include_cmd_def_paths %}
include_dir = {{ cmd_def_path }}
{% endfor %}

# Predefined command definitions (override or supplement included ones)
{% for cmd in custom_commands %}
command[{{ cmd.name }}] = {{ cmd.executable }} {{ cmd.arguments | default('') | join(' ') }}
{% endfor %}
