{
  "nrpe_port": 5666,
  "allowed_hosts": [
    "127.0.0.1",
    "::1"
  ],
  "nrpe_user": "nagios",
  "nrpe_group": "nagios",
  "nrpe_logfile": "/var/log/nrpe.log",
  "command_timeout": 60,
  "connection_timeout": 300,
  "nrpe_ssl": true,
  "nrpe_ssl_cert_file": "/etc/nagios/nrpe.pem",
  "nrpe_ssl_key_file": "/etc/nagios/nrpe.key",
  "nrpe_ssl_ca_cert_file": "",
  "nrpe_ssl_check_peer": false,
  "include_cmd_def_paths": [
    "/etc/nagios/nrpe.d"
  ],
  "custom_commands": []
}
