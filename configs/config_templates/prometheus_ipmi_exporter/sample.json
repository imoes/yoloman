{
  "bind_address": "0.0.0.0:9484",
  "ipmi_config_file": "/etc/prometheus-ipmi-exporter/devices.yml",
  "ipmi_over_lan": true,
  "ipmi_user": "admin",
  "ipmi_password": "secret123",
  "ipmi_timeout": 10,
  "ipmi_retries": 3,
  "ipmi_tls_insecure": false,
  "ipmi_devices": [
    {
      "hostname": "192.168.1.10",
      "username": "ipmi_admin",
      "password": "securepass",
      "interface": "lanplus",
      "privilege": "admin"
    },
    {
      "hostname": "192.168.1.20",
      "username": "monitor",
      "password": "monitorpass",
      "interface": "lan",
      "privilege": "operator"
    }
  ],
  "blacklisted_sensors": [
    "PSU Redundancy",
    "System Board Fan 1 Fault"
  ],
  "collect_sensor_readings": true,
  "collect_sel": true,
  "collect_sdr": true,
  "collect_fru": false,
  "max_concurrent_requests": 15
}
