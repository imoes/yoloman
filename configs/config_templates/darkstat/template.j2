# Enable darkstat (yes/no)
START_DARKSTAT={{ start_enabled | string | lower }}

# Interface(s) to monitor (space-separated); use 'any' for all interfaces
INTERFACE="{{ interfaces | join(' ') }}"

# IP address to bind the web interface to (0.0.0.0 = all interfaces)
BIND_ADDRESS="{{ bind_address }}"

# TCP port for the web UI
PORT={{ port }}

# Path to store persistent data (usage stats, hosts, etc.)
DB_DIR="{{ db_dir }}"

# Directory to store daily graphs (if enabled)
GRAPH_DIR="{{ graph_dir }}"

# Enable daily graph generation (yes/no)
ENABLE_GRAPHING={{ enable_graphing | string | lower }}

# Retention period for daily graphs (in days)
GRAPH_RETENTION={{ graph_retention_days }}

# Maximum number of hosts to track
MAX_HOSTS={{ max_hosts }}

# Maximum number of ports to track per host
MAX_PORTS={{ max_ports }}

# Enable compression for HTTP responses (yes/no)
COMPRESSION={{ enable_compression | string | lower }}

# Enable DNS reverse lookups (yes/no) — may impact performance
DNS_LOOKUPS={{ enable_dns_lookups | string | lower }}

# Additional command-line options (e.g., --no-macs to disable MAC lookups)
EXTRA_OPTS="{{ extra_options }}"