{
  "start_enabled": true,
  "interfaces": [
    "eth0"
  ],
  "bind_address": "127.0.0.1",
  "port": 667,
  "db_dir": "/var/lib/darkstat",
  "graph_dir": "/var/lib/darkstat/graphs",
  "enable_graphing": true,
  "graph_retention_days": 30,
  "max_hosts": 1000,
  "max_ports": 1000,
  "enable_compression": true,
  "enable_dns_lookups": false,
  "extra_options": ""
}
