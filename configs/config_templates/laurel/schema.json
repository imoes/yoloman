{
  "active": {
    "type": "string",
    "default": "yes",
    "description": "Whether the service is active (yes/no)",
    "enum": [
      "yes",
      "no"
    ]
  },
  "direction": {
    "type": "string",
    "default": "out",
    "description": "The direction of the event stream (out/in/out-in)",
    "enum": [
      "out",
      "in"
    ]
  },
  "type": {
    "type": "string",
    "default": "always",
    "description": "The type of process (always/on-demand)"
  },
  "format": {
    "type": "string",
    "default": "string",
    "description": "The format of the output (string/json)",
    "enum": [
      "string",
      "json"
    ]
  },
  "path": {
    "type": "string",
    "default": "/usr/sbin/laurel",
    "description": "The path to the laurel binary"
  }
}
