# Debusine Client Configuration
# This file configures the behavior of the debusine client tool.
# It defines allowed operations, valid Debian distributions (codenames),
# and permitted command sets.

{
    # allow_dcut: Whether to allow DCUT (Debian Copy-Under Test) builds.
    # Type: Boolean-like string ('true' or 'false')
    # Default: 'false'
    "allow_dcut": "{{ allow_dcut | default('false') }}",

    # codenames: Comma-separated list of Debian codenames the client should consider valid.
    # This restricts which release streams the client interacts with.
    # Default: 'debian'
    "codenames": "{{ codenames | default('debian') }}",

    # hooks: List of pre-defined hooks executed during workflow operations.
    # These are internal to debusine and typically static, but included for completeness.
    "hooks": [
        "debusine-check-workflow",
        "checksum",
        "suite-mismatch",
        "gpg",
        "debusine-create-workflow"
    ],

    # valid_commands: List of valid commands for the debusine client.
    # This restricts the CLI interface to specific subcommands for security or policy reasons.
    # Default: Empty list []
    "valid_commands": {{ valid_commands | default([]) | tojson }}
}
