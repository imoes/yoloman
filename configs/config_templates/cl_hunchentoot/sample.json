{
  "host": "0.0.0.0",
  "port": 8080,
  "document_root": "/var/www/hunchentoot",
  "default_content_type": "text/html; charset=utf-8",
  "enable_ssl": true,
  "ssl_certificate_file": "/etc/hunchentoot/ssl/server.crt",
  "ssl_key_file": "/etc/hunchentoot/ssl/server.key",
  "ssl_port": 8443,
  "max_threads": 64,
  "max_connections": 256,
  "request_timeout": 60,
  "log_level": "warn",
  "custom_log_file": "/var/log/hunchentoot/access.log",
  "extra_mime_types": [
    {
      "extension": ".wasm",
      "mime_type": "application/wasm"
    },
    {
      "extension": ".avif",
      "mime_type": "image/avif"
    }
  ],
  "directory_template": "nil",
  "routes": [
    {
      "path": "/api",
      "handler": "my-app::handle-api-request"
    },
    {
      "path": "/admin",
      "handler": "my-app::admin-handler"
    }
  ],
  "library_paths": [
    "/usr/share/common-lisp/source/hunchentoot/hunchentoot.lisp",
    "/usr/local/share/common-lisp/systems/cl-who.asd"
  ]
}
