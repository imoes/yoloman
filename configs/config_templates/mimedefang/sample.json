{
  "enabled": true,
  "socket_path": "/var/spool/sendmail/mimedefang.sock",
  "user": "defang",
  "group": "defang",
  "num_workers": 4,
  "max_message_size": 20971520,
  "scan_timeout": 300,
  "temp_dir": "/var/spool/mimedefang",
  "perl_lib_paths": [
    "/usr/lib/perl5/site_perl",
    "/usr/local/lib/perl5/site_perl"
  ],
  "action_replace_subject_prefix": "[SPAM]",
  "action_quarantine_dir": "/var/spool/mimedefang/quarantine",
  "action_replace_sender": "postmaster@localhost",
  "action_replace_recipients": "postmaster@localhost",
  "action_quarantine_compress": true,
  "log_facility": "mail",
  "log_level": 6,
  "log_syslog": true,
  "log_stderr": false,
  "filters": [
    {
      "name": "virus_scan",
      "type": "message",
      "path": "/etc/mimedefang/filters/virus_filter.pl",
      "args": []
    },
    {
      "name": "spam_tag",
      "type": "recipient",
      "path": "/etc/mimedefang/filters/spam_tag_filter.pl",
      "args": [
        "SPAM"
      ]
    }
  ],
  "whitelist_dir": "/etc/mimedefang/whitelist",
  "blacklist_dir": "/etc/mimedefang/blacklist",
  "block_executables": true,
  "block_executable_extensions": [
    "exe",
    "bat",
    "com",
    "pif",
    "scr",
    "cmd",
    "reg",
    "msi",
    "vbs",
    "js",
    "ps1"
  ],
  "use_spamassassin": true,
  "spamassassin_socket": "unix:/var/run/spamd.sock",
  "spamassassin_user": "spamd",
  "spamassassin_timeout": 60
}
