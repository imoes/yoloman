{
  "enabled": true,
  "socket_path": "/var/spool/sendmail/mimedefang.sock",
  "user": "defang",
  "group": "defang",
  "num_workers": 4,
  "max_message_size": 0,
  "scan_timeout": 300,
  "temp_dir": "/var/spool/mimedefang",
  "perl_lib_paths": [
    "/usr/lib/perl5/site_perl"
  ],
  "action_replace_subject_prefix": "[SPAM]",
  "action_quarantine_dir": "/var/spool/mimedefang/quarantine",
  "action_replace_sender": "postmaster@localhost",
  "action_replace_recipients": "postmaster@localhost",
  "action_quarantine_compress": false,
  "log_facility": "mail",
  "log_level": 6,
  "log_syslog": true,
  "log_stderr": false,
  "filters": [],
  "whitelist_dir": null,
  "blacklist_dir": null,
  "block_executables": true
}
