# --- Single-child mode ---
# desc="Run in single-child mode, forwarding signals only to the direct child. Derived from '-c/--single-child' option."
# {% if single_child | default(False) | bool %}
# Run in single-child mode
# Run in single-child mode, forwarding signals only to the direct child. Derived from '-c/--single-child' option.
-c
# {% endif %}

# --- Verbose mode ---
# desc="Print debugging information to stderr. Derived from '-v/--verbose' option."
# {% if verbose | default(False) | bool %}
# Enable verbose output
# Print debugging information to stderr. Derived from '-v/--verbose' option.
-v
# {% endif %}