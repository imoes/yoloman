# dumb-init configuration / command-line arguments template
# This template generates the command-line flags for the dumb-init entrypoint wrapper.
# Self-documenting: every variable and block is commented with its schema description.

# --- Signal rewrite rules ---
# desc="List of signal rewrite rules in format 'old_signal:new_signal'. Example: '10:15' to rewrite SIGUSR1 to SIGUSR2. Use ':0' to ignore a signal."
# render_rule: macro to format a single rewrite rule into a dumb-init flag
{% macro render_rule(rule) %}
--rewrite {{ rule }}
{% endmacro %}

