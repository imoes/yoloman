{
  "gatekeeper_port": 2811,
  "gatekeeper_cert_path": "/etc/grid-security/hostcert.pem",
  "gatekeeper_key_path": "/etc/grid-security/hostkey.pem",
  "trusted_ca_dir": "/etc/grid-security/certificates",
  "max_workers": 20,
  "bind_host": "0.0.0.0",
  "debug": false,
  "enable_ssl": true,
  "allowed_hosts": [
    "login.example.edu",
    "10.0.0.5"
  ],
  "allowed_networks": [
    "192.168.1.0/24",
    "10.10.0.0/16"
  ],
  "log_file_path": "/var/log/globus/gatekeeper.log",
  "log_max_size": 52428800,
  "log_backup_count": 10,
  "tcp_keepalive": true,
  "tcp_keepidle": 120,
  "tcp_keepintvl": 15,
  "tcp_keepcnt": 5
}
