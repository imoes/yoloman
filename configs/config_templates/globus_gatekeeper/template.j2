# Gatekeeper service configuration for Globus Grid Community Toolkit
# Enables the gatekeeper to accept incoming gridFTP and data transfer requests
# Port on which the gatekeeper listens for incoming connections
GLOBUS_GATEKEEPER_PORT={{ gatekeeper_port }}

# Path to the gatekeeper's certificate chain
GLOBUS_GATEKEEPER_CERT={{ gatekeeper_cert_path }}

# Path to the gatekeeper's private key
GLOBUS_GATEKEEPER_KEY={{ gatekeeper_key_path }}

# Path to the CA certificate directory for trust validation
GLOBUS_GATEKEEPER_TRUSTED_CA_DIR={{ trusted_ca_dir }}

# Maximum number of concurrent gatekeeper worker threads
GLOBUS_GATEKEEPER_MAX_WORKERS={{ max_workers }}

# Hostname or IP to bind the gatekeeper to (empty string means all interfaces)
GLOBUS_GATEKEEPER_BIND_HOST={{ bind_host }}

# Enable or disable debug logging
GLOBUS_GATEKEEPER_DEBUG={{ debug | lower }}

# Enable or disable SSL/TLS
GLOBUS_GATEKEEPER_SSL={{ enable_ssl | lower }}

# List of allowed source hosts (empty = allow all)
{% for host in allowed_hosts %}GLOBUS_GATEKEEPER_ALLOWED_HOST={{ host }}
{% endfor %}

# List of allowed source networks in CIDR notation (empty = allow all)
{% for net in allowed_networks %}GLOBUS_GATEKEEPER_ALLOWED_NETWORK={{ net }}
{% endfor %}

# Path to the log file for gatekeeper events
GLOBUS_GATEKEEPER_LOG_FILE={{ log_file_path }}

# Maximum log file size in bytes before rotation (0 = disable rotation)
GLOBUS_GATEKEEPER_LOG_MAX_SIZE={{ log_max_size }}

# Number of rotated log files to keep
GLOBUS_GATEKEEPER_LOG_BACKUP_COUNT={{ log_backup_count }}

# Enable or disable TCP keepalive on accepted connections
GLOBUS_GATEKEEPER_TCP_KEEPALIVE={{ tcp_keepalive | lower }}

# TCP keepalive idle time (seconds)
GLOBUS_GATEKEEPER_TCP_KEEPIDLE={{ tcp_keepidle }}

# TCP keepalive interval (seconds)
GLOBUS_GATEKEEPER_TCP_KEEPINTVL={{ tcp_keepintvl }}

# TCP keepalive probe count
GLOBUS_GATEKEEPER_TCP_KEEPCNT={{ tcp_keepcnt }}
