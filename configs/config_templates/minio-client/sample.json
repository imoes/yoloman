{
  "alias_name": "my-minio",
  "server_url": "https://s3.internal.example.com",
  "access_key": "s3-access-key-123",
  "secret_key": "s3-secret-key-456",
  "api": "S3v4",
  "lookup": "dns",
  "insecure": false,
  "quiet": true,
  "json": false,
  "debug": false,
  "no_color": true,
  "resolve": "",
  "limit_upload": "50MiB/s",
  "limit_download": "50MiB/s",
  "custom_headers": [
    "X-Request-ID: {{ request_id }}",
    "Authorization: Bearer token123"
  ]
}
