{
  "timeout": 120,
  "listen_addr": "0.0.0.0",
  "listen_port": 3000,
  "work_dir": "/var/lib/myapp",
  "user": "myapp",
  "group": "myapp",
  "nofile_limit": 102400,
  "nproc_limit": 8192,
  "env_vars": [
    {
      "key": "NODE_ENV",
      "value": "production"
    },
    {
      "key": "MAX_CONNECTIONS",
      "value": "512"
    }
  ],
  "extra_args": [
    "--config",
    "/etc/myapp/config.json"
  ],
  "selinux_context": "",
  "restart_policy": "on-failure",
  "restart_sec": 3
}
