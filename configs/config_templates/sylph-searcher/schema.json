{
  "dbname": {
    "type": "string",
    "default": "sylph_search",
    "description": "Database name for the full-text search index."
  },
  "hostname": {
    "type": "string",
    "default": "localhost",
    "description": "Hostname of the PostgreSQL database server."
  },
  "port": {
    "type": "number",
    "default": 5432,
    "description": "Port number of the PostgreSQL database server."
  },
  "username": {
    "type": "string",
    "default": "sylph_user",
    "description": "Username for database authentication."
  },
  "password": {
    "type": "string",
    "default": "changeme",
    "description": "Password for database user authentication."
  },
  "mecab_encoding": {
    "type": "string",
    "default": "EUC-JP",
    "description": "Encoding of MeCab dictionary. Default: Unix: EUC-JP / Win32: Shift_JIS.",
    "enum": [
      "EUC-JP",
      "Shift_JIS"
    ]
  },
  "no_remove": {
    "type": "bool",
    "default": false,
    "description": "Don't remove nonexist messages from the index."
  },
  "recursive": {
    "type": "bool",
    "default": false,
    "description": "Enable recursive query."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output."
  }
}
