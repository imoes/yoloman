# ============================================================
# sylph-searcher configuration
# This file parametrizes the command-line invocation of sylph-searcher.
# Variables correspond to documented CLI options in sylph-searcher(1).
# ============================================================

# Database name for the full-text search index.
dbname = {{ (dbname | default('sylph_search')) | string }}

# Hostname of the PostgreSQL database server.
hostname = {{ (hostname | default('localhost')) | string }}

# Port number of the PostgreSQL database server.
port = {{ (port | default(5432)) | int }}

# Username for database authentication.
username = {{ (username | default('sylph_user')) | string }}

# Password for database user authentication.
password = {{ (password | default('changeme')) | string }}

# Encoding of MeCab dictionary. Default: Unix: EUC-JP / Win32: Shift_JIS.
mecab-encoding = {{ (mecab_encoding | default('EUC-JP')) | string }}

# Don't remove nonexist messages from the index.
no-remove = {{ (no_remove | default(False) | ternary('true', 'false')) | string }}

# Enable recursive query.
recursive = {{ (recursive | default(False) | ternary('true', 'false')) | string }}

# Enable verbose output.
verbose = {{ (verbose | default(False) | ternary('true', 'false')) | string }}