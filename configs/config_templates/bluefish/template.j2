# Bluefish Editor: Startup Command-Line Options
#
# This section configures the command-line arguments passed to the Bluefish
# text editor upon initialization. These options allow customization of
# the editor's behavior, such as window management or file opening modes.
# See bluefish(1) for the list of supported options.

{% if command_options is defined and command_options | length > 0 %}
# Command-line options for bluefish
{% for opt in command_options %}{{ opt }}
{% endfor %}
{% else %}
# No command-line options configured. Bluefish will start with default settings.
{% endif %}