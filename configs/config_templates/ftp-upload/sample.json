{
  "uploads": [
    {
      "host": "ftp.debian.org",
      "user": "anonymous",
      "passive": true,
      "chdirs": [
        "incoming"
      ],
      "tmp_mode": "format",
      "tmp_format": "upload.%s",
      "transfers": [
        {
          "src": "/tmp/report.csv",
          "as": "report.csv"
        },
        {
          "src": "/tmp/changelog.txt",
          "mode": "ascii",
          "ls": true
        }
      ]
    },
    {
      "host": "backup.internal",
      "user": "backup",
      "password_stdin": true,
      "full_path": true,
      "transfers": [
        {
          "src": "/etc/hosts",
          "as": "etc/hosts"
        },
        {
          "src": "/var/log/syslog.1",
          "mode": "binary",
          "ls": false
        }
      ]
    },
    {
      "host": "ftp.example.com",
      "user": "user1",
      "account": "acct1",
      "passive": false,
      "chdirs": [
        "..",
        "uploads"
      ],
      "tmp_mode": "samedir",
      "transfers": [
        {
          "src": "/data/file.tar.gz",
          "ls": true
        }
      ]
    }
  ]
}
