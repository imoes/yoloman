# =============================================================================
# Graphite-Web Django Configuration Template
# =============================================================================
# This file generates the webapp.conf Django settings for Graphite-Web.
# It is self-documenting: every variable has a default and a descriptive comment.
# See: https://graphite.readthedocs.io/en/latest/config-webapp.html
# =============================================================================

# --- General Django Settings ---

# Enable Django debug mode (show detailed error pages).
# Should be false in production.
# Default: False
{% if (debug | default(False)) %}DEBUG = True
{% else %}DEBUG = False
{% endif %}

# Allow unauthenticated users to view dashboards, graphs, and metrics.
# Default: True
ALLOW_ANONYMOUS_VIEW = {{ allow_anonymous_view | default(True) | lower }}

# Require authentication for *all* access to the Graphite UI.
# Overrides 'allow_anonymous_view' if set to True.
# Default: False
LOGIN_REQUIRED = {{ login_required | default(False) | lower }}

# Time zone used for displaying timestamps and graph intervals (e.g., 'America/New_York', 'UTC').
# Default: 'UTC'
TIME_ZONE = '{{ timezone | default("UTC") }}'

# Default language for the UI (e.g., 'en-us', 'de-de').
# Default: 'en-us'
LANGUAGE_CODE = '{{ language_code | default("en-us") }}'

# Django secret key — generate a new unique key (e.g., via 'openssl rand -hex 32').
# Required in production. Empty default allows variable override or explicit setting.
# Default: ''
SECRET_KEY = '{{ secret_key | default("") }}'

# --- Database Configuration ---
# Default backend is SQLite3 using a local file.
# For PostgreSQL or MySQL, provide host, port, user, and password below.
DATABASES = {
    'default': {
        # Database backend: 'sqlite3' (local file), 'postgresql', or 'mysql'.
        'ENGINE': 'django.db.backends.{{ db_engine | default("sqlite3") }}',
        # Path to SQLite DB file, or name of PostgreSQL/MySQL database.
        'NAME': '{{ db_name | default("/var/lib/graphite/graphite.db") }}',
        {% set db_is_sqlite = (db_engine | default("sqlite3")) == "sqlite3" %}
        {% if not db_is_sqlite %}
        # Database user for PostgreSQL/MySQL.
        'USER': '{{ db_user | default("graphite") }}',
        # Password for database user (use secrets manager in production).
        'PASSWORD': '{{ db_password | default("") }}',
        # Database server hostname or IP for PostgreSQL/MySQL.
        'HOST': '{{ db_host | default("localhost") }}',
        # Database server port (e.g., 5432 for PostgreSQL, 3306 for MySQL).
        'PORT': '{{ db_port | default(5432) }}',
        {% endif %}
    }
}

# --- Cache Configuration ---
# Django cache backend: 'locmem' (local memory), 'filebased', 'redis', or 'dummy' (no caching).
CACHES = {
    'default': {
        'BACKEND': 'django.core.cache.backends.{{ cache_backend | default("locmem") }}',
        # Location for cache (e.g., path for filebased, '127.0.0.1:6379' for Redis).
        'LOCATION': '{{ cache_location | default("") }}',
        {% set cache_is_filebased = (cache_backend | default("locmem")) == "filebased" %}
        {% if cache_is_filebased %}
        # Cache timeout in seconds (only used for filebased cache).
        'TIMEOUT': {{ cache_timeout | default(86400) }},
        {% endif %}
    }
}

# --- Authentication Backends ---
# Ordered list of Django authentication backends.
AUTHENTICATION_BACKENDS = [
    {% for backend in (auth_backends | default(['django_auth_ldap.backend.LDAPBackend', 'django.contrib.auth.backends.ModelBackend'])) %}
    '{{ backend }}',
    {% endfor %}
]

# --- LDAP Authentication (Optional) ---
# Enable LDAP authentication via django-auth-ldap.
# Default: False
{% if ldap_enabled | default(False) %}
import ldap
from django_auth_ldap.config import LDAPSearch, GroupOfNamesType

# LDAP server URL (e.g., 'ldap://ldap.example.com' or 'ldaps://ldap.example.com').
AUTH_LDAP_SERVER_URI = '{{ ldap_server_uri | default("ldap://ldap.example.com") }}'

# Bind DN for initial LDAP connection (used for user/group search).
AUTH_LDAP_BIND_DN = '{{ ldap_bind_dn | default("cn=admin,dc=example,dc=com") }}'

# Password for LDAP bind DN.
AUTH_LDAP_BIND_PASSWORD = '{{ ldap_bind_password | default("") }}'

# Construct the user search filter using configured attributes.
AUTH_LDAP_USER_SEARCH = LDAPSearch(
    '{{ ldap_user_base_dn | default("ou=users,dc=example,dc=com") }}',
    ldap.SCOPE_SUBTREE,
    '(&({{ ldap_user_obj_class | default("inetOrgPerson") }}={{ ldap_user_cn_attr | default("cn") }})({{ ldap_user_uid_attr | default("uid") }}={{ ldap_user_uid_attr | default("uid") }}))'
)

# Map LDAP attributes to Django user fields.
AUTH_LDAP_USER_ATTR_MAP = {
    'first_name': '{{ ldap_user_first_name_attr | default("givenName") }}',
    'last_name': '{{ ldap_user_last_name_attr | default("sn") }}',
    'email': '{{ ldap_user_email_attr | default("mail") }}',
}

# Search for group membership.
AUTH_LDAP_GROUP_SEARCH = LDAPSearch(
    '{{ ldap_group_base_dn | default("ou=groups,dc=example,dc=com") }}',
    ldap.SCOPE_SUBTREE,
    '(objectClass={{ ldap_group_obj_class | default("groupOfNames") }})'
)
AUTH_LDAP_GROUP_TYPE = GroupOfNamesType()

# Flags for staff and superuser status based on LDAP group membership.
AUTH_LDAP_USER_FLAGS_BY_GROUP = {
    'is_staff': '{{ ldap_staff_group | default("") }}',
    'is_superuser': '{{ ldap_superuser_group | default("") }}',
}
{% endif %}

# --- Email Configuration ---
# Django email backend class (e.g., SMTP backend).
EMAIL_BACKEND = '{{ email_backend | default("django.core.mail.backends.smtp.EmailBackend") }}'

# SMTP server hostname.
EMAIL_HOST = '{{ email_host | default("localhost") }}'

# SMTP server port (e.g., 587 for TLS, 465 for SSL).
EMAIL_PORT = {{ email_port | default(587) }}

# SMTP authentication username.
EMAIL_HOST_USER = '{{ email_host_user | default("") }}'

# SMTP authentication password.
EMAIL_HOST_PASSWORD = '{{ email_host_password | default("") }}'

# Use STARTTLS for SMTP connection.
EMAIL_USE_TLS = {{ email_use_tls | default(True) | lower }}

# Sender email address for outgoing notifications.
DEFAULT_FROM_EMAIL = '{{ default_from_email | default("graphite@example.com") }}'

# --- Graphite-Specific Settings ---

# Graphite storage backend configuration (Whisper, Ceres, etc.)
# Carbon host and port for metric ingestion/querying (default: local).
GRAPHITE_UI_CONFIG = {
    'carbon': {
        # Hostname/IP of Carbon cache or aggregator to query for metric data.
        'host': '{{ carbon_host | default("127.0.0.1") }}',
        # Carbon line-receiver or query port (default 7002 for line-receiver, 7002/7004 for query service).
        'port': {{ carbon_port | default(7002) }},
    }
}

# Directory containing Whisper data files (if using local Whisper storage).
STORAGE_DIR = '{{ storage_dir | default("/var/lib/graphite/whisper") }}'

# Maximum retention period in seconds for rendered metrics (1 year = 31536000 sec).
MAX_RETENTION = {{ max_retention | default(31536000) }}

# Minimum retention (smallest resolution step) in seconds (e.g., 60 for 1-minute data).
MIN_RETENTION = {{ min_retention | default(60) }}

# Maximum number of data points to return per metric in API/graph queries.
MAX_VALUES_PER_METRIC = {{ max_values_per_metric | default(10000) }}

# Allow metrics from private IP ranges (e.g., 127.0.0.1, 10.x.x.x) to be rendered by the web interface.
ALLOW_PRIVATE_IPS = {{ allow_private_ips | default(True) | lower }}

# --- Logging ---

# Log performance info for graph rendering.
LOG_RENDERING_PERFORMANCE = {{ log_rendering_performance | default(False) | lower }}

# Log cache performance metrics.
LOG_CACHE_PERFORMANCE = {{ log_cache_performance | default(False) | lower }}

# Log every metric fetch operation (useful for debugging).
LOG_METRICS = {{ log_metrics | default(False) | lower }}

# --- Security Settings ---

# Set CSRF cookie as Secure (only sent over HTTPS).
# Enabled only if HTTPS is used.
{% if enable_csrf_cookie_secure | default(False) %}CSRF_COOKIE_SECURE = True
{% else %}CSRF_COOKIE_SECURE = False
{% endif %}

# Set session cookie as Secure (only sent over HTTPS).
{% if enable_session_cookie_secure | default(False) %}SESSION_COOKIE_SECURE = True
{% else %}SESSION_COOKIE_SECURE = False
{% endif %}

# Seconds to include in Strict-Transport-Security (HSTS) header.
# Set to 0 to disable.
SECURE_HSTS_SECONDS = {{ secure_hsts_seconds | default(0) }}

# Set X-Content-Type-Options: nosniff header.
SECURE_CONTENT_TYPE_NOSNIFF = {{ secure_content_type_nosniff | default(True) | lower }}

# Set X-XSS-Protection header (legacy but still useful).
SECURE_BROWSER_XSS_FILTER = {{ secure_browser_xss_filter | default(True) | lower }}

# URL prefix for the app (e.g., '/graphite' if behind proxy at that prefix).
{% if url_prefix | default("") %}URL_PREFIX = '{{ url_prefix | default("") }}'
{% endif %}