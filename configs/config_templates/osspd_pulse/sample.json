{
  "backend": "pulse",
  "oss_socket": "/dev/dsp",
  "log_level": 3,
  "max_clients": 4,
  "sample_rate": 48000,
  "channels": 2,
  "buffer_size_ms": 40,
  "auto_detect": true,
  "device": "default",
  "resample": true,
  "acls": [
    {
      "desc": "Allow all local clients",
      "pattern": "allow *"
    },
    {
      "desc": "Block remote untrusted clients",
      "pattern": "deny 10.0.0.0/8"
    }
  ],
  "pa_properties": [
    {
      "prop": "device.description",
      "value": "OSS Proxy Output"
    },
    {
      "prop": "stream.description",
      "value": "OSS-to-PulseAudio Bridge"
    }
  ]
}
