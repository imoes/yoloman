# PID file location for the nsca daemon
pid_file={{ pid_file }}

# Port on which nsca listens for incoming encrypted checks
server_port={{ server_port }}

# IP address(es) nsca binds to (empty string = all interfaces)
bind_to_address={{ bind_to_address }}

# Maximum number of concurrent connections
max_connections={{ max_connections }}

# Command file (Nagios external command pipe)
command_file={{ command_file }}

# Decryption password (shared with nagios server; must match sender config)
password={{ password }}

# Decryption method: 0 = simple XOR, 1 = DES (deprecated), 2 = AES-256-CBC
encryption_method={{ encryption_method }}

# Number of seconds to wait before dropping a connection (0 = no timeout)
connection_timeout={{ connection_timeout }}

# Number of seconds to wait before reaping dead children (0 = disabled)
child_timeout={{ child_timeout }}

# Enable or disable daemon mode (1 = daemonize, 0 = run in foreground)
daemonize={{ daemonize }}

# Log level: 0 = none, 1 = errors, 2 = warnings, 3 = info, 4 = debug
debug_level={{ debug_level }}

# Log file path (empty = syslog)
log_file={{ log_file }}

# Allow multiple instances on same host (1 = allow, 0 = disallow)
allow_multiple_instances={{ allow_multiple_instances }}

{% if additional_hosts %}
# Additional allowed sender hosts (comma-separated IPs or hostnames)
allowed_hosts={{ additional_hosts | join(',') }}
{% endif %}

# User to drop privileges to (empty = run as current user)
run_as_user={{ run_as_user }}

# Group to drop privileges to (empty = run as current group)
run_as_group={{ run_as_group }}

# Set umask for created files
umask={{ umask }}
