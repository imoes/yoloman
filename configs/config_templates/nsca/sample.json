{
  "pid_file": "/var/run/nsca/nsca.pid",
  "server_port": 5667,
  "bind_to_address": "127.0.0.1",
  "max_connections": 50,
  "command_file": "/var/spool/nagios/cmd/nagios.cmd",
  "password": "mysecretpass123",
  "encryption_method": 2,
  "connection_timeout": 60,
  "child_timeout": 30,
  "daemonize": true,
  "debug_level": 1,
  "log_file": "/var/log/nsca/nsca.log",
  "allow_multiple_instances": false,
  "additional_hosts": [
    "10.0.0.5",
    "monitoring.internal.example.com"
  ],
  "run_as_user": "nagios",
  "run_as_group": "nagios",
  "umask": "027"
}
