{
  "assume_color": {
    "type": "string",
    "default": "",
    "description": "Toggle for assume_color directive. Empty string means the line '-assume_color' remains."
  },
  "baud": {
    "type": "number",
    "default": 9600,
    "description": "Baud rate setting."
  },
  "dopadding": {
    "type": "bool",
    "default": true,
    "description": "Toggle for dopadding directive."
  },
  "pg": {
    "type": "number",
    "default": 2,
    "description": "Page size setting."
  },
  "lmsg": {
    "type": "string",
    "default": "\\i%k%T%*\\b%n\\b%R",
    "description": "Left message format string."
  },
  "rmsg": {
    "type": "string",
    "default": "R%r<%l C%c\\u%o|%O\\i\\b%a|%A\\b\\i\\u %u",
    "description": "Right message format string."
  },
  "hmsg": {
    "type": "string",
    "default": "\\i\\f\\b^J = Help\\b\\f",
    "description": "Help message format string."
  },
  "crlf": {
    "type": "bool",
    "default": true,
    "description": "Toggle for crlf directive."
  },
  "french": {
    "type": "bool",
    "default": true,
    "description": "Toggle for french directive."
  },
  "hex": {
    "type": "bool",
    "default": true,
    "description": "Toggle for hex directive."
  },
  "indentc": {
    "type": "number",
    "default": 9,
    "description": "Indentation character width."
  },
  "istep": {
    "type": "number",
    "default": 1,
    "description": "Indentation step."
  },
  "lmargin": {
    "type": "number",
    "default": 1,
    "description": "Left margin."
  },
  "rmargin": {
    "type": "number",
    "default": 73,
    "description": "Right margin."
  },
  "tab": {
    "type": "number",
    "default": 8,
    "description": "Tab width."
  },
  "tab_py": {
    "type": "number",
    "default": 4,
    "description": "Python tab width."
  },
  "indentc_py": {
    "type": "number",
    "default": 32,
    "description": "Python indentation character width."
  },
  "istep_py": {
    "type": "number",
    "default": 4,
    "description": "Python indentation step."
  },
  "tab_py2": {
    "type": "number",
    "default": 4,
    "description": "Python tab width (script). "
  },
  "indentc_py2": {
    "type": "number",
    "default": 32,
    "description": "Python indentation character width (script)."
  },
  "istep_py2": {
    "type": "number",
    "default": 4,
    "description": "Python indentation step (script)."
  },
  "tab_py3": {
    "type": "number",
    "default": 4,
    "description": "Python tab width (env script)."
  },
  "indentc_py3": {
    "type": "number",
    "default": 32,
    "description": "Python indentation character width (env script)."
  },
  "istep_py3": {
    "type": "number",
    "default": 4,
    "description": "Python indentation step (env script)."
  }
}
