{
  "log_file": "/var/log/nagios4/nagios.log",
  "config_dir": "/etc/nagios4/conf.d",
  "resource_file": "/etc/nagios4/resource.cfg",
  "object_cache_file": "/var/cache/nagios4/objects.cache",
  "status_file": "/var/log/nagios4/status.dat",
  "command_file": "/var/lib/nagios4/rw/nagios.cmd",
  "pid_file": "/var/run/nagios4/nagios4.pid",
  "log_rotation_method": "d",
  "log_archive_path": "/var/log/nagios4/archives",
  "use_aggressive_host_checking": true,
  "interval_length": 60,
  "check_for_updates": true,
  "binary_plugins_path": "/usr/lib/nagios4/plugins",
  "icon_image": "/nagios4/images/nagios-logo.png",
  "icon_image_small": "/nagios4/images/nagios-logo.png",
  "statusmap_background_image": "/nagios4/images/smbackground.png",
  "statusmap_transparency_index": "eeffff",
  "default_contact_groups": "nagiosadmins",
  "check_external_commands": true,
  "command_file_permissions": 600,
  "external_command_interval": 1,
  "max_check_result_retrieval_age": 3600,
  "max_concurrent_checks": 0,
  "enable_event_handlers": true,
  "enable_host_events": true,
  "enable_service_events": true,
  "enable_flap_detection": true,
  "low_flap_threshold": 5.0,
  "high_flap_threshold": 20.0,
  "process_performance_data": false,
  "host_perfdata_file": "/var/lib/nagios4/host-perfdata.out",
  "service_perfdata_file": "/var/lib/nagios4/service-perfdata.out",
  "retain_status_information": true,
  "retain_program_status": true,
  "retain_contact_information": true,
  "notification_interval": 60,
  "notification_timeout": 30,
  "perfdata_host_items": [
    {
      "name": "execution_time",
      "metric": "EXECUTION_TIME",
      "value": "{{host.execution_time}}"
    },
    {
      "name": "latency",
      "metric": "LATENCY",
      "value": "{{host.latency}}"
    }
  ],
  "perfdata_service_items": [
    {
      "name": "execution_time",
      "metric": "EXECUTION_TIME",
      "value": "{{service.execution_time}}"
    },
    {
      "name": "latency",
      "metric": "LATENCY",
      "value": "{{service.latency}}"
    },
    {
      "name": "check_duration",
      "metric": "CHECK_DURATION",
      "value": "{{service.check_duration}}"
    }
  ]
}
