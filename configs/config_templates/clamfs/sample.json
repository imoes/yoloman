{
  "clamd_socket": "/var/run/clamav/clamd.sock",
  "mount_point": "/mnt/vault",
  "source_dir": "/home",
  "cache_ttl": 600,
  "cache_size": 5000,
  "scan_archives": true,
  "email_alert": true,
  "email_to": "security@example.com",
  "smtp_server": "mail.example.com",
  "exclude_patterns": [
    "\\.gpg$",
    "\\.enc$",
    "\\.bak$"
  ],
  "log_file": "/var/log/clamfs.log"
}
