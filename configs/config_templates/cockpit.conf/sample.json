{
  "ws_address": "127.0.0.1",
  "ws_port": 9090,
  "ws_tls": true,
  "ws_tls_cert": "/etc/cockpit/ws-certs.d/0-self-signed.cert",
  "ws_tls_key": "/etc/cockpit/ws-certs.d/0-self-signed.cert",
  "ws_cors_domains": [
    "https://cockpit.example.com",
    "https://admin.internal.local:8080"
  ],
  "login_banner": true,
  "login_banner_text": "\u26a0\ufe0f Authorized personnel only \u2014 all activity is monitored.",
  "session_timeout_minutes": 120,
  "session_idle_timeout_minutes": 30,
  "session_max_per_user": 3,
  "session_recording_path": "/var/log/cockpit/sessions",
  "session_recording_exclude_users": [
    "root",
    "backup"
  ]
}
