# smb-nat configuration template
# Generated by Ansible Jinja2

# Debug level (0-3), mapped to -d flag
# Controls verbosity of output; higher values provide more detailed logging.
smb-nat -d {{ debug_level | default(0) }} \

# Output file path for results, mapped to -o flag.
# If empty, stdout is used.
{% if output_file | default('') | trim != '' %}
-o {{ output_file | default('') }} \
{% endif %}

# Path to file containing usernames for brute-force, mapped to -u flag.
-u {{ userlist | default('/usr/share/smb-nat/userlist.txt') }} \

# Path to file containing passwords for brute-force, mapped to -p flag.
-p {{ passlist | default('/usr/share/smb-nat/passlist.txt') }} \

# List of target addresses or hostnames.
# These are joined with commas for the final command argument.
{% for target in targets | default(['127.0.0.1']) | list %}
{% if not loop.first %},{% endif %}{{ target }}
{% endfor %}