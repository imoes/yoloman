# Baloo File Indexer Desktop Entry
# This template generates an XDG autostart entry for the Baloo file indexing daemon.
# It is primarily used by system packagers or roles to ensure the service is registered
# with the desktop environment's startup manager.

# Type of the entry. Must be "Application" for desktop files.
Type=Application

# The command to execute. Uses the target architecture to locate the correct binary path.
Exec=/usr/lib/{{ architecture | default('x86_64-linux-gnu') }}/libexec/kf6/baloo_file

# Disable startup notification. Baloo starts silently in the background.
X-KDE-StartupNotify=false

# Condition for autostart: checks if indexing is enabled in the user's baloo file config.
X-KDE-autostart-condition=baloofilerc:Basic Settings:Indexing-Enabled:true

# Autostart phase. 0 means start early, before the user session is fully active.
X-KDE-autostart-phase=0

# GNOME compatibility flag.
X-GNOME-Autostart-enabled=true

# Prevent systemd from managing this service (handled by KDE/Plasma session management).
X-systemd-skip=true

# Only show in specified desktop environments.
OnlyShowIn=KDE;GNOME;Unity;XFCE

# Do not show in application menus or dockers.
NoDisplay=true

# Display name (English).
Name=Baloo File Daemon

