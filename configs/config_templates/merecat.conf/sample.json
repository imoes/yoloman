{
  "host": "0.0.0.0",
  "port": 8080,
  "root": "/var/www/mysite",
  "log_file": "/var/log/merecat/access.log",
  "log_level": "info",
  "mime_file": "/etc/mime.types",
  "index_files": [
    "index.html",
    "index.htm",
    "default.html"
  ],
  "user": "www-data",
  "group": "www-data",
  "allow_symlink": false,
  "allow_dir_listing": true,
  "threads": 4,
  "ssl_enabled": true,
  "ssl_cert": "/etc/ssl/certs/mysite.crt",
  "ssl_key": "/etc/ssl/private/mysite.key",
  "server_headers": [
    {
      "name": "X-Content-Type-Options",
      "value": "nosniff"
    },
    {
      "name": "X-Frame-Options",
      "value": "DENY"
    }
  ],
  "allowed_ips": [],
  "error_404": "/errors/404.html",
  "error_50x": "/errors/50x.html",
  "read_timeout": 20,
  "write_timeout": 20
}
