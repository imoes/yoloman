{
  "config_path": "/etc/backintime/myprofile.conf",
  "share_path": "/var/lib/backintime/myprofile",
  "profile_name": "DailyBackup",
  "use_checksum": true,
  "local_backup": true,
  "only_new": false,
  "delete": false,
  "keep_mount": false,
  "no_crontab": false,
  "shutdown_after_backup": true,
  "extra_args": [
    "--quiet",
    "--debug"
  ]
}
