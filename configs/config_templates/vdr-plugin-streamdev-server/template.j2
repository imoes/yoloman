#
# Configuration for the streamdev-server VDR plugin
# This plugin allows VideoDiskRecorder (VDR) to stream video over the network
# to other VDR instances or clients.
#

[streamdev-server]

# IP address or hostname the server should bind to.
# Defaults to '0.0.0.0' which listens on all interfaces.
# Set to a specific IP (e.g., '192.168.1.10') to restrict access to a specific network interface.
# Schema field: streamdev_server_address
address = {{ streamdev_server_address | default('0.0.0.0') }}

# TCP port number for the streamdev-server service.
# Defaults to 3000. This is the standard port for VDR streamdev protocol.
# Ensure this port is open in your firewall for allowed clients.
# Schema field: streamdev_server_port
port = {{ streamdev_server_port | default(3000) }}

# Enable or disable the streamdev-server plugin.
# Defaults to true (enabled). Set to false to disable streaming functionality.
# Schema field: streamdev_server_enabled
enabled = {{ streamdev_server_enabled | default(true) | lower }}

# Maximum number of simultaneous streams allowed.
# Defaults to 1. Limit this value to prevent resource exhaustion on the VDR host.
# Schema field: streamdev_server_max_streams
max_streams = {{ streamdev_server_max_streams | default(1) }}

# Timezone setting for stream metadata.
# Defaults to 'local'. Use 'utc' if your clients expect UTC timestamps.
# Schema field: streamdev_server_timezone
timezone = {{ streamdev_server_timezone | default('local') }}

# URL base path for the stream.
# Defaults to '/stream'. Clients connect to this path on the server's address and port.
# Schema field: streamdev_server_url
url = {{ streamdev_server_url | default('/stream') }}