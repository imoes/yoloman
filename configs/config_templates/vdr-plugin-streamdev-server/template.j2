# Configuration for the VDR streamdev-server plugin.
# This section defines the network binding address and port for the streaming service.

[streamdev-server]
# IP address or hostname to bind the streamdev-server to.
# Defaults to 0.0.0.0 to listen on all available interfaces.
host = {{ host | default('0.0.0.0') }}

# TCP port number for the streamdev-server service.
# Defaults to 3000.
port = {{ port | default(3000) }}
