# pktstat configuration file
# Manages packet statistics abbreviation rules.
# Each line defines a shorthand for a long network pattern.

# List of abbreviation rules for pktstat.
# Each item is a map with 'abbrev' and 'pattern'.
# If 'abbrev' is omitted or empty, the pattern text itself is used.
# Default is an empty list, meaning no abbreviations are defined.
{% for item in (abbreviations | default([])) %}
  {# The abbreviation tag. Defaults to '*' if not provided, acting as a wildcard or placeholder. #}
  {# The pattern string to be abbreviated. #}
  {{ item.abbrev | default('*') }} {{ item.pattern }}
{% endfor %}