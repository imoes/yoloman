# SELinux mode: 'enforcing' (active enforcement), 'permissive' (logs only), 'disabled' (no MAC)
SELINUX={{ selinux_mode }}

# SELinux policy type: defines the base policy used (e.g., targeted, minimum, mls)
SELINUXTYPE={{ selinux_policy_type }}

# Optional: Unconfined domains policy (Debian-specific tuning)
# Enables/disables unconfined_t domain (allowing processes to run without labeling)
# Not present in all distros; included here only if explicitly set
{% if unconfined_policy is defined %}UNCONFINED={{ 'yes' if unconfined_policy else 'no' }}
{% endif %}