# Command executed to start the daemon with the PKCS#11 component.
Exec=/usr/bin/gnome-keyring-daemon --start --components=pkcs11

# Desktop environments in which this application should appear.
OnlyShowIn=GNOME;Unity;MATE;

# Do not display this entry in the application menus.
NoDisplay=true

# Autostart phase: runs before the display server starts.
X-GNOME-Autostart-Phase=PreDisplayServer

# Do not auto-restart the daemon if it crashes.
X-GNOME-AutoRestart=false

# Send autostart notification to the session manager.
X-GNOME-Autostart-Notify=true