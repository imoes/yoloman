# Configuration file for obfuscate
# See obfuscate(1) for details.

# Default tool to use for censinging (blur or fill)
# blur: adds a blurred transparent overlay
# fill: blacks out the area
DEFAULT_MODE={{ default_mode | default('fill') }}

# Default blur radius if using 'blur' mode
# Only applies if DEFAULT_MODE is 'blur'
BLUR_RADIUS={{ blur_radius | default(10) }}

# List of file extensions to consider as images
# The tool currently only supports images, not PDFs.
IMAGE_EXTENSIONS=[ {{ extensions | default(['jpg', 'png', 'gif']) | join(', ') }} ]