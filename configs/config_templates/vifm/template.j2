" vim: filetype=vifm :

" This is Vifm's default color scheme for terminals that support 256 colors.
"
" This file last updated: 6 September, 2024

" Clear any previously defined highlight groups to ensure a clean slate.
highlight clear

" Window frame colors
" Foreground color for the window frame.
hi Win          cterm=none                    ctermfg={{ win_ctermfg | default('white') }}    ctermbg={{ win_ctermbg | default('232') }}
" Foreground color for other windows.
hi OtherWin     cterm=none                    ctermfg={{ otherwin_ctermfg | default('default') }}  ctermbg={{ otherwin_ctermbg | default('default') }}
" Foreground color for auxiliary window.
hi AuxWin       cterm=none                    ctermfg={{ auxwin_ctermfg | default('default') }}  ctermbg={{ auxwin_ctermbg | default('233') }}
" Foreground color for odd lines.
hi OddLine      cterm=none                    ctermfg={{ oddline_ctermfg | default('default') }}  ctermbg={{ oddline_ctermbg | default('default') }}

" Top line colors
" Foreground color for the top line.
hi TopLine      cterm=none                    ctermfg={{ topline_ctermfg | default('black') }}    ctermbg={{ topline_ctermbg | default('white') }}
" Foreground color for the selected top line.
hi TopLineSel   cterm=bold                    ctermfg={{ toplinesel_ctermfg | default('16') }}  ctermbg={{ toplinesel_ctermbg | default('default') }}

" Tab line colors
" Foreground color for the tab line.
hi TabLine      cterm=none                    ctermfg={{ tabline_ctermfg | default('white') }}    ctermbg={{ tabline_ctermbg | default('black') }}
" Foreground color for the selected tab line.
hi TabLineSel   cterm=bold,reverse            ctermfg={{ tablinesel_ctermfg | default('default') }}  ctermbg={{ tablinesel_ctermbg | default('default') }}

" Job and Status line colors
" Foreground color for the job line.
hi JobLine      cterm=bold                    ctermfg={{ jobline_ctermfg | default('white') }}    ctermbg={{ jobline_ctermbg | default('238') }}
" Foreground color for the status line.
hi StatusLine   cterm=none                    ctermfg={{ statusline_ctermfg | default('black') }}    ctermbg={{ statusline_ctermbg | default('white') }}

" Border color
" Foreground color for the border.
hi Border       cterm=none                    ctermfg={{ border_ctermfg | default('white') }}    ctermbg={{ border_ctermbg | default('232') }}

" Current and Other line colors
" Foreground color for the current line.
hi CurrLine     cterm=bold,reverse            ctermfg={{ currline_ctermfg | default('default') }}  ctermbg={{ currline_ctermbg | default('default') }}
" Foreground color for other lines.
hi OtherLine    cterm=reverse                 ctermfg={{ otherline_ctermfg | default('234') }}      ctermbg={{ otherline_ctermbg | default('white') }}
" Foreground color for line numbers.
hi LineNr       cterm=none                    ctermfg={{ linenr_ctermfg | default('default') }}  ctermbg={{ linenr_ctermbg | default('default') }}

" Selected item and Command line colors
" Foreground color for selected items.
hi Selected     cterm=bold                    ctermfg={{ selected_ctermfg | default('213') }}      ctermbg={{ selected_ctermbg | default('default') }}
" Foreground color for command line mismatch.
hi CmpMismatch  cterm=bold                    ctermfg={{ cmpmismatch_ctermfg | default('white') }}    ctermbg={{ cmpmismatch_ctermbg | default('88') }}
" Foreground color for command line unmatched.
hi CmpUnmatched cterm=bold                    ctermfg={{ cmpunmatched_ctermfg | default('white') }}    ctermbg={{ cmpunmatched_ctermbg | default('28') }}
" Foreground color for command line blank.
hi CmpBlank     cterm=none                    ctermfg={{ cmpblank_ctermfg | default('default') }}  ctermbg={{ cmpblank_ctermbg | default('default') }}

" Suggestion and Wild menu colors
" Foreground color for the suggestion box.
hi SuggestBox   cterm=bold,reverse            ctermfg={{ suggestbox_ctermfg | default('cyan') }}     ctermbg={{ suggestbox_ctermbg | default('232') }}
" Foreground color for the wild menu.
hi WildMenu     cterm=underline,bold,reverse  ctermfg={{ wildmenu_ctermfg | default('yellow') }}   ctermbg={{ wildmenu_ctermbg | default('black') }}

" Command line and Error message colors
" Foreground color for the command line.
hi CmdLine      cterm=bold                    ctermfg={{ cmdline_ctermfg | default('white') }}    ctermbg={{ cmdline_ctermbg | default('232') }}
" Foreground color for error messages.
hi ErrorMsg     cterm=bold                    ctermfg={{ errormsg_ctermfg | default('white') }}    ctermbg={{ errormsg_ctermbg | default('red') }}

" File type specific colors
" Foreground color for directories.
hi Directory    cterm=bold                    ctermfg={{ directory_ctermfg | default('123') }}      ctermbg={{ directory_ctermbg | default('default') }}
" Foreground color for executable files.
hi Executable   cterm=bold                    ctermfg={{ executable_ctermfg | default('119') }}      ctermbg={{ executable_ctermbg | default('default') }}
" Foreground color for sockets.
hi Socket       cterm=bold,reverse            ctermfg={{ socket_ctermfg | default('182') }}      ctermbg={{ socket_ctermbg | default('default') }}
" Foreground color for device files.
hi Device       cterm=bold,reverse            ctermfg={{ device_ctermfg | default('204') }}      ctermbg={{ device_ctermbg | default('default') }}
" Foreground color for FIFOs.
hi Fifo         cterm=bold,reverse            ctermfg={{ fifo_ctermfg | default('50') }}       ctermbg={{ fifo_ctermbg | default('default') }}
" Foreground color for symlinks.
hi Link         cterm=bold                    ctermfg={{ link_ctermfg | default('229') }}      ctermbg={{ link_ctermbg | default('default') }}
" Foreground color for broken symlinks.
hi BrokenLink   cterm=bold                    ctermfg={{ brokenlink_ctermfg | default('209') }}      ctermbg={{ brokenlink_ctermbg | default('default') }}
" Foreground color for hard links.
hi HardLink     cterm=bold                    ctermfg={{ hardlink_ctermfg | default('221') }}      ctermbg={{ hardlink_ctermbg | default('default') }}

" Powerline-like statusline user-defined colors
" Background color for User1 highlight group (statusline).
highlight User1 ctermbg={{ user1_ctermbg | default('white') }}
" Background color for User2 highlight group (statusline).
highlight User2 ctermbg={{ user2_ctermbg | default('240') }} ctermfg={{ user2_ctermfg | default('231') }} cterm={{ user2_cterm | default('bold') }}
" Background color for User3 highlight group (statusline).
highlight User3 ctermbg={{ user3_ctermbg | default('240') }} ctermfg={{ user3_ctermfg | default('white') }}
" Background color for User4 highlight group (statusline).
highlight User4 ctermbg={{ user4_ctermbg | default('white') }} ctermfg={{ user4_ctermfg | default('240') }}

" Build system files (Makefiles, CMake, etc.)
" Foreground color for build system files.
highlight {Makefile,Makefile.am,Makefile.in,Makefile.win,*.mak,*.mk,*.m4,*.ac,
          \configure,CMakeLists.txt,*.cmake,*.pro,*.pri,*.sln,meson.build,
          \meson_options.txt}
        \ cterm=none ctermfg={{ buildsys_ctermfg | default('121') }} ctermbg={{ buildsys_ctermbg | default('default') }}

" Archives (compression formats)
" Foreground color for archives.
highlight {*.7z,*.ace,*.arj,*.bz2,*.cpio,*.deb,*.dz,*.gz,*.jar,*.lzh,*.lzma,
          \*.rar,*.rpm,*.rz,*.tar,*.taz,*.tb2,*.tbz,*.tbz2,*.tgz,*.tlz,*.trz,
          \*.txz,*.tz,*.tz2,*.tzst,*.xz,*.z,*.zip,*.zoo,*.apk,*.gzip,*.lz,
          \*.zstd}
        \ cterm=none ctermfg={{ archives_ctermfg | default('215') }} ctermbg={{ archives_ctermbg | default('default') }}

" Configuration and other readable textual formats
" Foreground color for configuration and readable textual formats.
highlight {*.css,*.less,*.scss,*.markdown,*.md,*.mkd,*.org,*.pandoc,*.pdc,*.tex,
          \*.txt,*.xml,*.log,*.rss,*.xul,*.json,*.yaml,*.yml,*.csv,*.plist,
          \*.ini,*.cfg,*.rc,*.conf,*.spec,*.qrc,*.description,*.list,*.log.old,
          \*.log.1,*.log.2,*.log.3,*.log.4,*.log.5,*.log.6,*.log.7,*.log.8,
          \syslog,syslog.1,*.xsd,*.toml,*.rst}
        \ cterm=none ctermfg={{ text_ctermfg | default('217') }} ctermbg={{ text_ctermbg | default('default') }}

" Still text files, but keeping this unoptimizable glob separately
" Foreground color for other text files.
highlight {*[^0-9].[1-9]}
        \ cterm=none ctermfg={{ text2_ctermfg | default('217') }} ctermbg={{ text2_ctermbg | default('default') }}

" Documents and text-based formats that need special handling
" Foreground color for documents and text-based formats requiring special handling.
highlight {*.doc,*.docx,*.xls,*.xlsm,*.xlsx,*.mobi,*.rtf,*.ppt,*.pptx,*.pdf,
          \*.epub,*.fb2,*.djvu,*.djv,*.htm,*.html,*.shtml,*.xhtml,*.desktop,
          \*.odg,*.odt,*.ods}
        \ cterm=none ctermfg={{ docs_ctermfg | default('218') }} ctermbg={{ docs_ctermbg | default('default') }}

" Audio files
" Foreground color for audio files.
highlight {*.aac,*.ac3,*.anx,*.ape,*.asf,*.au,*.axa,*.cue,*.flac,*.m2a,*.m4a,
          \*.mid,*.midi,*.mka,*.mp3,*.mpc,*.mpga,*.oga,*.ogg,*.ogx,*.ra,*.ram,
          \*.spx,*.wav,*.wma}
        \ cterm=none ctermfg={{ audio_ctermfg | default('79') }} ctermbg={{ audio_ctermbg | default('default') }}

" Multimedia/video files
" Foreground color for multimedia/video files.
highlight {*.avi,*.axv,*.divx,*.flv,*.m2v,*.m4v,*.mp4,*.m4p,*.mp4v,*.mpeg,*.mpg,
          \*.mkv,*.mov,*.nuv,*.ogv,*.qt,*.rm,*.ts,*.vob,*.webm,*.wmv,*.xvid,
          \*.unknown_video}
        \ cterm=none ctermfg={{ video_ctermfg | default('49') }} ctermbg={{ video_ctermbg | default('default') }}

" Image files
" Foreground color for image files.
highlight {*.bmp,*.gif,*.jpeg,*.jpg,*.ico,*.png,*.ppm,*.svg,*.svgz,*.tga,*.tif,
          \*.tiff,*.xbm,*.xcf,*.xpm,*.xspf,*.xwd,*.ai,*.pbm,*.pgm,*.webp}
        \ cterm=none ctermfg={{ image_ctermfg | default('117') }} ctermbg={{ image_ctermbg | default('default') }}

" Executable files (scripts, binaries)
" Foreground color for executable files.
highlight {*.sh,*.bash,*.zsh,*.bat,*.btm,*.cmd,*.com,*.dll,*.exe,*.run,*.msu,
          \*.msi,*.fish,*.AppImage}
        \ cterm=none ctermfg={{ executable_file_ctermfg | default('77') }} ctermbg={{ executable_file_ctermbg | default('default') }}

" Source code files
" Foreground color for source code files.
highlight {*.patch,*.diff,*.py,*.cpp,*.hpp,*.c,*.h,*.cpp,*.hpp,*.cc,*.hh,*.ld,
          \*.hs,*.php,*.lua,*.vim,*.vifm,*.asm,*.s,*.java,*.cxx,*.c++,*.go,
          \*.pl,*.pm,*.t,*.cs,*.asp,*.dart,*.js,*.rb,*.scala,*.ts,*.coffee,
          \*.ml,*.mli,*.rs,*.sql,*.qml,vifmrc,vimrc,.vimrc,*.flex,*.ypp,*.S,
          \*.robot}
        \ cterm=none ctermfg={{ source_ctermfg | default('193') }} ctermbg={{ source_ctermbg | default('default') }}

" Software documentation files (README, LICENSE, etc.)
" Foreground color for software documentation files.
highlight {COPYRIGHT,COPYING*,BUGS,ChangeLog*,FAQ,INSTALL*,LICENCE,LICENSE,NEWS,
          \README,README.*,AUTHORS,TODO,THANKS}
        \ cterm=none ctermfg={{ docfile_ctermfg | default('187') }} ctermbg={{ docfile_ctermbg | default('default') }}