{
  "service_name": "nginx",
  "rotate_enabled": true,
  "sync_enabled": false,
  "use_iso8601": true,
  "tag_enabled": true,
  "dedup_enabled": true,
  "filter_patterns": [
    {
      "regex": "^\\[debug\\]",
      "mode": "exclude"
    },
    {
      "regex": "error|fatal|panic",
      "mode": "include"
    }
  ]
}
