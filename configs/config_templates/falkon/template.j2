# ==============================================================================
# Falkon Web Browser Configuration
# ==============================================================================
# This file configures the Falkon web browser. It is written in INI format
# and is consumed by Falkon at runtime.
#
# This template is auto-generated by Ansible. Do not edit manually unless
# necessary. Changes will be overwritten on the next playbook run.
#
# Variable Mapping:
#   - privacy_* : Privacy and security policies
#   - browser_* : General browsing behavior and engine features
#   - downloads_* : Download manager behavior
#   - search_* : Search engine defaults
#   - ssl_* : SSL/TLS validation policies
#   - webengine_* : QtWebEngine rendering and font settings
#   - network_* : Proxy and protocol support settings
#   - storage_* : Cache and profile path configuration
# ==============================================================================

[General]
{# privacy_private_browsing: Start Falkon in private browsing mode by default. #}
{# Value: true (enabled) or false (disabled). #}
PrivateBrowsing={{ privacy_private_browsing|default(false) | lower }}

{# browser_javascript_enabled: Enable or disable JavaScript execution globally. #}
{# Value: true (enabled) or false (disabled). Disabling breaks many modern sites. #}
JavaScriptEnabled={{ browser_javascript_enabled|default(true) | lower }}

{# browser_plugins_enabled: Enable or disable browser plugins. #}
{# Value: true (enabled) or false (disabled). Plugins are largely deprecated. #}
PluginsEnabled={{ browser_plugins_enabled|default(false) | lower }}

{# browser_images_enabled: Enable or disable image loading. #}
{# Value: true (enabled) or false (disabled). Useful for low-bandwidth or accessibility. #}
ImagesEnabled={{ browser_images_enabled|default(true) | lower }}

{# browser_user_agent: Custom user agent string. #}
{# Value: String. Empty string ('') lets Falkon auto-generate a standard UA. #}
UserAgent={{ browser_user_agent|default('') }}

{# privacy_adblock_enabled: Enable the built-in ad blocker. #}
{# Value: true (enabled) or false (disabled). #}
AdBlockEnabled={{ privacy_adblock_enabled|default(true) | lower }}

{# privacy_cookies_enabled: Enable cookie handling. #}
{# Value: true (enabled) or false (disabled). Disabling may break session-based sites. #}
CookiesEnabled={{ privacy_cookies_enabled|default(true) | lower }}

{# privacy_do_not_track: Send 'Do Not Track' HTTP header. #}
{# Value: true (enabled) or false (disabled). #}
SendDoNotTrack={{ privacy_do_not_track|default(true) | lower }}

{# privacy_location_permission: Location permission policy. #}
{# Value: 'allow' (always permit), 'deny' (always block), or 'ask' (prompt user). #}
LocationPermission={{ privacy_location_permission|default('ask') }}

[DownloadManager]
{# downloads_directory: Default directory for downloaded files. #}
{# Value: String path. Empty string ('') uses the system default (~Downloads). #}
DownloadDirectory={{ downloads_directory|default('') }}

{# downloads_auto_open: Automatically open downloaded files of safe types. #}
{# Value: true (enabled) or false (disabled). Be cautious: auto-opening executables is risky. #}
AutoOpenDownloads={{ downloads_auto_open|default(false) | lower }}

[Search]
{# search_default_engine: Default search engine name. #}
{# Value: String. Examples: 'DuckDuckGo', 'Google', 'Bing'. Must match installed engines. #}
DefaultSearchEngine={{ search_default_engine|default('DuckDuckGo') }}

[Java]
{# browser_java_enabled: Enable Java applet execution. #}
{# Value: true (enabled) or false (disabled). STRONGLY DISCOURAGED due to security risks. #}
JavaEnabled={{ browser_java_enabled|default(false) | lower }}

[SSL]
{# ssl_certificate_check: Validate SSL certificates. #}
{# Value: true (enabled) or false (disabled). NEVER disable in production; it enables MITM attacks. #}
SSLCertificateCheck={{ ssl_certificate_check|default(true) | lower }}

[WebEngine]
{# browser_default_zoom: Default zoom factor. #}
{# Value: Float. 1.0 = 100%. 1.5 = 150%, 0.8 = 80%. #}
DefaultZoomFactor={{ browser_default_zoom|default(1.0) }}

{# browser_webgl_enabled: Enable WebGL rendering. #}
{# Value: true (enabled) or false (disabled). Required for interactive 3D graphics on web. #}
WebGLEnabled={{ browser_webgl_enabled|default(true) | lower }}

{# font_family_standard: Standard font family. #}
{# Value: String. Used for general text rendering. #}
FontFamilyStandard={{ font_family_standard|default('DejaVu Sans') }}

{# font_family_serif: Serif font family. #}
{# Value: String. Used for text elements styled with 'serif'. #}
FontFamilySerif={{ font_family_serif|default('DejaVu Serif') }}

{# font_family_sans_serif: Sans-serif font family. #}
{# Value: String. Used for text elements styled with 'sans-serif'. #}
FontFamilySansSerif={{ font_family_sans_serif|default('DejaVu Sans') }}

{# font_family_monospace: Monospace font family. #}
{# Value: String. Used for code blocks and preformatted text. #}
FontFamilyMonospace={{ font_family_monospace|default('DejaVu Sans Mono') }}

{# font_size_standard: Standard font size in points. #}
{# Value: Integer. Base size for 'standard' font. #}
FontSizeStandard={{ font_size_standard|default(16) }}

{# font_size_fixed: Fixed-width font size in points. #}
{# Value: Integer. Base size for 'monospace' font. #}
FontSizeFixed={{ font_size_fixed|default(13) }}

[Network]
{# network_use_system_proxy: Use system proxy settings. #}
{# Value: true (enabled) or false (disabled). If false, manual proxy below is used. #}
UseSystemProxy={{ network_use_system_proxy|default(true) | lower }}

{# network_proxy_host: HTTP proxy host. #}
{# Value: String. Only used if UseSystemProxy is false. #}
ProxyHost={{ network_proxy_host|default('') }}

{# network_proxy_port: HTTP proxy port. #}
{# Value: Integer. Only used if UseSystemProxy is false. #}
ProxyPort={{ network_proxy_port|default(8080) }}

{# network_ftp_enabled: Enable FTP protocol support. #}
{# Value: true (enabled) or false (disabled). Disabled by default for security. #}
FtpEnabled={{ network_ftp_enabled|default(false) | lower }}

[Storage]
{# storage_cache_size: Maximum cache size in MB. #}
{# Value: Integer. 0 = automatic management by the browser. #}
CacheSize={{ storage_cache_size|default(0) }}

{# storage_profile_path: Path to custom profile directory. #}
{# Value: String path. Useful for portable installs or multi-user setups. #}
ProfilePath={{ storage_profile_path|default('') }}