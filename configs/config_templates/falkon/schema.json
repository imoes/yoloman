{
  "privacy_private_browsing": {
    "type": "bool",
    "default": false,
    "description": "Start Falkon in private browsing mode"
  },
  "browser_javascript_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable or disable JavaScript execution globally"
  },
  "browser_plugins_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable or disable browser plugins"
  },
  "browser_images_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable or disable image loading"
  },
  "browser_user_agent": {
    "type": "string",
    "default": "",
    "description": "Custom user agent string (empty = auto-generated)"
  },
  "privacy_adblock_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable built-in ad blocker"
  },
  "privacy_cookies_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable cookie handling"
  },
  "privacy_do_not_track": {
    "type": "bool",
    "default": true,
    "description": "Send 'Do Not Track' HTTP header"
  },
  "privacy_location_permission": {
    "type": "string",
    "default": "ask",
    "description": "Location permission policy: 'allow', 'deny', or 'ask'"
  },
  "downloads_directory": {
    "type": "string",
    "default": "",
    "description": "Default download directory (empty = system default)"
  },
  "downloads_auto_open": {
    "type": "bool",
    "default": false,
    "description": "Automatically open downloaded files of safe types"
  },
  "search_default_engine": {
    "type": "string",
    "default": "DuckDuckGo",
    "description": "Default search engine name"
  },
  "browser_java_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable Java applet execution (strongly discouraged)"
  },
  "ssl_certificate_check": {
    "type": "bool",
    "default": true,
    "description": "Validate SSL certificates"
  },
  "browser_default_zoom": {
    "type": "number",
    "default": 1.0,
    "description": "Default zoom factor (1.0 = 100%)"
  },
  "browser_webgl_enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable WebGL rendering"
  },
  "font_family_standard": {
    "type": "string",
    "default": "DejaVu Sans",
    "description": "Standard font family"
  },
  "font_family_serif": {
    "type": "string",
    "default": "DejaVu Serif",
    "description": "Serif font family"
  },
  "font_family_sans_serif": {
    "type": "string",
    "default": "DejaVu Sans",
    "description": "Sans-serif font family"
  },
  "font_family_monospace": {
    "type": "string",
    "default": "DejaVu Sans Mono",
    "description": "Monospace font family"
  },
  "font_size_standard": {
    "type": "number",
    "default": 16,
    "description": "Standard font size in points"
  },
  "font_size_fixed": {
    "type": "number",
    "default": 13,
    "description": "Fixed-width font size in points"
  },
  "network_use_system_proxy": {
    "type": "bool",
    "default": true,
    "description": "Use system proxy settings"
  },
  "network_proxy_host": {
    "type": "string",
    "default": "",
    "description": "HTTP proxy host (only if UseSystemProxy = false)"
  },
  "network_proxy_port": {
    "type": "number",
    "default": 8080,
    "description": "HTTP proxy port (only if UseSystemProxy = false)"
  },
  "network_ftp_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable FTP protocol support (disabled by default)"
  },
  "storage_cache_size": {
    "type": "number",
    "default": 0,
    "description": "Maximum cache size in MB (0 = automatic)"
  },
  "storage_profile_path": {
    "type": "string",
    "default": "",
    "description": "Path to custom profile directory (for portable installs)"
  }
}
