# iSNS server configuration file — generated by Jinja2 template
# Listen address and port for iSNS server
listen_address = {{ isns.listen_address }}
listen_port = {{ isns.listen_port }}

# Log level: 0 (quiet) to 9 (verbose)
log_level = {{ isns.log_level }}

# Path to log file (empty for stdout/stderr)
log_file = {{ isns.log_file | default('', true) }}

# Authentication mode: none, psk, cert
auth_mode = {{ isns.auth_mode }}

# Pre-shared key (used only if auth_mode = psk)
{% if isns.auth_mode == 'psk' %}
psk_file = {{ isns.psk_file }}
{% endif %}

# Certificate paths (used only if auth_mode = cert)
{% if isns.auth_mode == 'cert' %}
server_cert = {{ isns.server_cert }}
server_key = {{ isns.server_key }}
ca_cert = {{ isns.ca_cert }}
{% endif %}

# Maximum number of concurrent sessions
max_sessions = {{ isns.max_sessions }}

# Maximum number of registered targets
max_targets = {{ isns.max_targets }}

# Maximum number of registered initiators
max_initiators = {{ isns.max_initiators }}

# Database persistence path
{% if isns.persistence_enabled %}
persist_file = {{ isns.persist_file }}
{% else %}
# Persistence disabled — no persist file
# persist_file = (disabled)
{% endif %}

# Database sync interval (seconds, 0 = disabled)
sync_interval = {{ isns.sync_interval }}

# List of allowed initiator IQNs (empty = allow all)
{% for iqn in isns.allowed_initiators %}
# Allowed initiator: {{ iqn }}
{% endfor %}
{% if isns.allowed_initiators | length == 0 %}
# No allowed initiators — all IQNs permitted
{% endif %}

# List of allowed target IQNs (empty = allow all)
{% for iqn in isns.allowed_targets %}
# Allowed target: {{ iqn }}
{% endfor %}
{% if isns.allowed_targets | length == 0 %}
# No allowed targets — all IQNs permitted
{% endif %}
