{
  "isns": {
    "listen_address": "0.0.0.0",
    "listen_port": 3205,
    "log_level": 4,
    "log_file": "/var/log/isnsd.log",
    "auth_mode": "none",
    "psk_file": "/etc/isnsd.psk",
    "server_cert": "/etc/isnsd.crt",
    "server_key": "/etc/isnsd.key",
    "ca_cert": "/etc/isns-ca.crt",
    "max_sessions": 256,
    "max_targets": 128,
    "max_initiators": 128,
    "max_portals": 512,
    "max_nodes": 256,
    "persistence_enabled": true,
    "persist_file": "/var/lib/isns/isnsdb.dat",
    "sync_interval": 300,
    "allowed_initiators": [],
    "allowed_targets": [
      "iqn.2003-01.org.example:storage01",
      "iqn.2003-01.org.example:storage02"
    ],
    "heartbeat_interval": 60,
    "discovery_domains_enabled": true,
    "cluster_name": "isns-primary"
  }
}
