# Balboa configuration template
# This file configures the command-line arguments for the Balboa service.
# It is consumed by a service manager (systemd, supervisord, etc.) that
# launches the Balboa binary with these arguments.

# Path to the Balboa log file.
# Specifies where Balboa should write its runtime logs.
# Default: /var/log/balboa.log
# Note: Ensure the target directory exists and is writable by the Balboa process user.
BALBOA_ARGS=-f /etc/balboa/feeders.yaml -l {{ log_file | default('/var/log/balboa.log') }}