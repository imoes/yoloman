# ==============================================================================
# ario configuration file
# ==============================================================================
# ario is a graphical client for Music Player Daemon (MPD).
# This file is typically placed at ~/.ario/ario.conf or /etc/ario/ario.conf.
# It defines connection parameters for MPD and UI preferences.
# ==============================================================================

[mpd]
# ==============================================================================
# Music Player Daemon Connection Settings
# ==============================================================================

# Hostname or IP address of the Music Player Daemon server
# If using a local instance, 'localhost' is standard.
host = {{ mpd_host | default('localhost') }}

# TCP port of the MPD server
# The default MPD port is 6600.
port = {{ mpd_port | default(6600) }}

# MPD password for authentication
# Leave empty if the server does not require a password.
password = {{ mpd_password | default('') }}

[ario]
# ==============================================================================
# ario UI / Application Settings
# ==============================================================================

# Initial window width in pixels
# Controls the default width of the main application window on launch.
window_width = {{ window_width | default(800) }}

# Initial window height in pixels
# Controls the default height of the main application window on launch.
window_height = {{ window_height | default(600) }}

# Show elapsed time in playlist view
# If true, displays the time elapsed for the current track in the playlist.
show_elapsed = {{ show_elapsed | default(true) | lower }}

# Sort playlist items by filename
# If true, sorts playlist entries alphabetically by filename.
# If false, sorts by metadata (title, artist, etc.).
sort_by_filename = {{ sort_by_filename | default(false) | lower }}

# Directory used to cache cover art images
# Path to the local directory where album art is stored to speed up rendering.
cache_dir = {{ cache_dir | default('~/.ario/cache') }}