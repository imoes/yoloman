# ==============================================================================
# youtube-dl Configuration Template
# ==============================================================================
# This template configures youtube-dl, a command-line program to download videos
# from YouTube.com and a few other sites.
#
# Self-Documenting: All settings are derived from schema fields with explicit
# defaults and descriptions.
# ==============================================================================

# [--prefer-free-formats]
# Prefer to download the free format over the encoded one, when both are available.
# This is a boolean flag. If true, youtube-dl will prioritize formats that do not
# require proprietary encoding/decoding if possible (though most modern video/audio
# is encoded). Default is usually false in raw config, but often enabled via CLI.
{% set prefer_free_formats = (schema | default({})).prefer_free_formats | default(false) %}
{% if prefer_free_formats is boolean and prefer_free_formats %}
--prefer-free-formats
{% endif %}

# [--output]
# Specify the template for output filenames.
# Default: '%(title)s-%(id)s.%(ext)s'
{% set output_template = (schema | default({})).output | default('%(title)s-%(id)s.%(ext)s') %}
-o {{ output_template | quote }}

# [--output-thumbnail]
# Specify the template for thumbnail filenames.
# Default: '%(title)s-%(id)s.%(ext)s'
{% set output_thumbnail_template = (schema | default({})).output_thumbnail | default('%(title)s-%(id)s.%(ext)s') %}
--output-thumbnail {{ output_thumbnail_template | quote }}

# [--write-description]
# Write the video description to a .description file.
# Default: false
{% set write_description = (schema | default({})).write_description | default(false) %}
{% if write_description is boolean and write_description %}
--write-description
{% endif %}

# [--write-info-json]
# Write the video info.json to a .info.json file.
# Default: false
{% set write_info_json = (schema | default({})).write_info_json | default(false) %}
{% if write_info_json is boolean and write_info_json %}
--write-infojson
{% endif %}

# [--write-annotations]
