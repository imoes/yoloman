{
  "daemon_mode": true,
  "memory_mb": 1024,
  "max_connections": 2048,
  "tcp_port": 11211,
  "udp_port": 0,
  "listen_ip": "0.0.0.0",
  "daemonize": true,
  "pid_file": "/run/memcached/memcached.pid",
  "run_as_user": "memcache",
  "max_item_size_mb": 2,
  "verbosity": 1,
  "timeout": 60,
  "slab_growth_factor": 1.25,
  "slab_page_size_mb": 1,
  "disable_locking": false,
  "enable_sasl": true,
  "storage_dirs": [
    {
      "path": "/dev/shm/memcached1",
      "size_mb": 512
    },
    {
      "path": "/dev/shm/memcached2",
      "size_mb": 512
    }
  ],
  "extra_args": [
    "-k",
    "-o",
    "hash_algorithm=xxhash64"
  ]
}
