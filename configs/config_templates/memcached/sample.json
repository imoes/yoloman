{
  "enable_memcached": "yes",
  "daemon_mode": false,
  "memory_mb": 64,
  "max_connections": 1024,
  "tcp_port": 11211,
  "udp_port": 0,
  "listen_ip": "127.0.0.1",
  "daemonize": false,
  "pid_file": "/var/run/memcached/memcached.pid",
  "run_as_user": "memcache",
  "max_item_size_mb": 1,
  "verbosity": 0,
  "timeout": 30,
  "slab_growth_factor": 1.25,
  "slab_page_size_mb": 1,
  "disable_locking": false,
  "enable_sasl": false,
  "storage_dirs": [],
  "extra_args": []
}
