# memcached default configuration
# Run memcached as a daemon
-m {{ daemon_mode | default(false) }}
# Memory to use for cache (in MB)
-m {{ memory_mb | default(64) }}
# Maximum number of simultaneous connections (default: 1024)
-c {{ max_connections | default(1024) }}
# TCP port to listen on
-p {{ tcp_port | default(11211) }}
# UDP port to listen on (0 disables UDP)
-U {{ udp_port | default(0) }}
# Interface(s) to bind to (comma-separated, or 'all')
-l {{ listen_ip | default('127.0.0.1') }}
# Daemonize and run as a background process
-d {{ daemonize | default(false) }}
# PID file
-pid {{ pid_file | default('/var/run/memcached/memcached.pid') }}
# Username to run as (if started as root)
u {{ run_as_user | default('memcache') }}
# Maximum size of an individual item (in MB)
-I {{ max_item_size_mb | default(1) }}
# Verbosity level (0=quiet, 1=normal, 2=verbose)
-v {{ verbosity | default(0) }}
# Timeout for idle connections (in seconds)
-t {{ timeout | default(30) }}
# Growth factor for slab allocation
-f {{ slab_growth_factor | default(1.25) }}
# Slab page size (in MB)
-S {{ slab_page_size_mb | default(1) }}
# Disable slab memory reassignment
-nolock {{ disable_locking | default(false) }}
# Enable SASL authentication
-SASL {{ enable_sasl | default(false) }}
{% if storage_dirs | default([]) %}
# Custom storage directories (e.g., for tmpfs-backed caching)
{% for dir in storage_dirs %}
# {{ dir.path }} ({{ dir.size_mb }} MB)
-s {{ dir.size_mb }}
{% endfor %}
{% endif %}
# Extra arguments passed directly to the memcached binary
{% for arg in extra_args %}
{{ arg }}
{% endfor %}