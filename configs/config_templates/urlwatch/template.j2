# urlwatch configuration template
# Generated by Ansible. This file configures urlwatch, a lightweight job-based website monitor.
# It manages URL monitoring jobs, caching results, and sending notifications via email (SMTP).

# === Global Settings ===

# Path to the SQLite cache database file.
# This database stores the history of URL checks to detect changes.
# Default: ~/.cache/urlwatch/cache.db
cache:
  db_file: "{{ cache_db_file | default('~/.cache/urlwatch/cache.db') }}"

# === Reporter Configuration ===

# List of reporters to use for notifications.
# urlwatch supports multiple reporters; here we configure the SMTP (email) reporter.
reporters:
  # --- SMTP Email Reporter ---
  # Configures how urlwatch sends email notifications when a monitored URL changes.
  - type: mail
    
    # SMTP server hostname.
    # The address of the mail server to connect to.
    # Default: localhost
    smtp_host: "{{ smtp_host | default('localhost') }}"
    
    # SMTP server port.
    # The TCP port for the SMTP connection (e.g., 587 for STARTTLS).
    # Default: 587
    smtp_port: {{ smtp_port | default(587) }}
    
    # SMTP authentication login.
    # Username for authenticating with the SMTP server. Leave empty if no auth.
    # Default: ''
    smtp_login: "{{ smtp_login | default('') }}"
    
    # SMTP password.
    # Password for SMTP authentication.
    # NOTE: It is recommended to store this in a system keyring rather than plain text.
    # Default: ''
    smtp_password: "{{ smtp_password | default('') }}"
    
    # Sender email address.
    # The address used in the 'From:' header of notification emails.
    # Default: urlwatch@localhost
    sender: "{{ smtp_sender | default('urlwatch@localhost') }}"
    
    # List of recipient email addresses.
    # Array of email addresses to send notifications to.
    # Default: []
    recipients: {{ smtp_recipients | default([]) | tojson }}