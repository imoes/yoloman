{
 "append_archive": {
  "default": false,
  "description": "Append to existing archive (-A/--append).",
  "type": "bool"
 },
 "archive_file": {
  "default": "",
  "description": "Path to archive file (empty string = stdin/stdout).",
  "type": "string"
 },
 "block_size": {
  "default": 10,
  "description": "I/O block size in 512-byte units (cpio -B = 5120 bytes = block_size 10).",
  "type": "number"
 },
 "dereference": {
  "default": false,
  "description": "Dereference symbolic links (-L/--dereference).",
  "type": "bool"
 },
 "extract_only": {
  "default": true,
  "description": "Extract (default) vs. list-only (implies -t).",
  "type": "bool"
 },
 "files": {
  "default": [],
  "description": "List of file paths to archive (copy-out) or extract (copy-in/pass-through).",
  "type": "list"
 },
 "format": {
  "default": "newc",
  "description": "Archive format. Valid values: bin, odc, newc, crc, tar, ustar, hpbin, hpodc.",
  "enum": [
   "bin",
   "odc",
   "newc",
   "crc",
   "tar",
   "ustar",
   "hpbin",
   "hpodc"
  ],
  "type": "string"
 },
 "ignore_devno": {
  "default": false,
  "description": "Store 0 in device number (--ignore-devno).",
  "type": "bool"
 },
 "ignore_dirnlink": {
  "default": false,
  "description": "Store 2 in directory nlink (--ignore-dirnlink).",
  "type": "bool"
 },
 "io_size": {
  "default": 0,
  "description": "I/O block size in bytes (overrides block_size if non-zero).",
  "type": "number"
 },
 "link": {
  "default": false,
  "description": "Link instead of copy (-l/--link) in pass-through mode.",
  "type": "bool"
 },
 "make_directories": {
  "default": false,
  "description": "Create leading directories (-d/--make-directories).",
  "type": "bool"
 },
 "mode": {
  "description": "Operation mode: 'create', 'extract', or 'pass-through'. Required.",
  "enum": [
   "create",
   "extract",
   "pass-through"
  ],
  "type": "string"
 },
 "no_absolute_filenames": {
  "default": false,
  "description": "Strip leading path components (--no-absolute-filenames).",
  "type": "bool"
 },
 "no_preserve_owner": {
  "default": false,
  "description": "Do not change ownership (--no-preserve-owner).",
  "type": "bool"
 },
 "non_matching": {
  "default": false,
  "description": "Extract only non-matching files (-f/--nonmatching).",
  "type": "bool"
 },
 "null_delimited": {
  "default": false,
  "description": "Filenames delimited by nulls (-0/--null).",
  "type": "bool"
 },
 "numeric_uid_gid": {
  "default": false,
  "description": "Show numeric UID/GID in listing (-n/--numeric-uid-gid).",
  "type": "bool"
 },
 "only_verify_crc": {
  "default": false,
  "description": "Only verify CRC in CRC-format archives (--only-verify-crc).",
  "type": "bool"
 },
 "owner": {
  "default": "",
  "description": "Owner specification in USER[:.]GROUP format (copy-in/pass-through modes).",
  "type": "string"
 },
 "pattern_file": {
  "default": "",
  "description": "Path to file with additional extract patterns (-E/--pattern-file).",
  "type": "string"
 },
 "pattern_file_delimiter": {
  "default": "",
  "description": "Delimiter for pattern_file (empty = newline).",
  "type": "string"
 },
 "preserve_modification_time": {
  "default": false,
  "description": "Retain modification times (-m/--preserve-modification-time).",
  "type": "bool"
 },
 "quiet": {
  "default": false,
  "description": "Suppress block count summary (--quiet).",
  "type": "bool"
 },
 "rename": {
  "default": false,
  "description": "Rename files interactively (-r/--rename).",
  "type": "bool"
 },
 "renumber_inodes": {
  "default": false,
  "description": "Renumber inodes (--renumber-inodes).",
  "type": "bool"
 },
 "reproducible": {
  "default": false,
  "description": "Create reproducible archive (--device-independent).",
  "type": "bool"
 },
 "reset_access_time": {
  "default": false,
  "description": "Reset file access time after reading (-a/--reset-access-time).",
  "type": "bool"
 },
 "sparse": {
  "default": false,
  "description": "Write large zero blocks as sparse files (--sparse).",
  "type": "bool"
 },
 "swap_bytes": {
  "default": false,
  "description": "Swap bytes of halfwords (-s/--swap-bytes) in copy-in mode.",
  "type": "bool"
 },
 "swap_halfwords": {
  "default": false,
  "description": "Swap halfwords of words (-S/--swap-halfwords) in copy-in mode.",
  "type": "bool"
 },
 "to_stdout": {
  "default": false,
  "description": "Extract files to stdout (--to-stdout).",
  "type": "bool"
 },
 "unconditional": {
  "default": false,
  "description": "Replace all files unconditionally (-u/--unconditional).",
  "type": "bool"
 },
 "verbose": {
  "default": false,
  "description": "Enable verbose listing of processed files (-v).",
  "type": "bool"
 }
}
