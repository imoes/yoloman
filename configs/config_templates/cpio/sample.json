{
 "append_archive": false,
 "archive_file": "/var/backups/archive.cpio",
 "block_size": 10,
 "dereference": false,
 "extract_only": true,
 "files": [
  "etc/",
  "etc/hostname",
  "var/www/"
 ],
 "format": "newc",
 "ignore_devno": false,
 "ignore_dirnlink": false,
 "io_size": 0,
 "link": false,
 "make_directories": true,
 "mode": "extract",
 "no_absolute_filenames": false,
 "no_preserve_owner": false,
 "non_matching": false,
 "null_delimited": false,
 "numeric_uid_gid": false,
 "only_verify_crc": false,
 "owner": "root:root",
 "pattern_file": "/etc/cpio/include.list",
 "pattern_file_delimiter": "",
 "preserve_modification_time": true,
 "quiet": false,
 "rename": false,
 "renumber_inodes": false,
 "reproducible": false,
 "reset_access_time": false,
 "sparse": true,
 "swap_bytes": false,
 "swap_halfwords": false,
 "to_stdout": false,
 "unconditional": false,
 "verbose": true
}
