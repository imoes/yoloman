{
  "basexhome": "/opt/basex",
  "database_dir": "/var/lib/basex/data",
  "server_port": 8984,
  "timeout": 60000,
  "http_server": true,
  "webapp_server": true,
  "default_parser": "auto",
  "html_options": [
    "method=html",
    "nons=true"
  ],
  "fulltext_index": true,
  "query_cache": true,
  "max_cache_size": 256,
  "disk_index": true,
  "compression": true,
  "jvm_opts": [
    "-Xms512m",
    "-Xmx4g"
  ],
  "log_level": "INFO"
}
