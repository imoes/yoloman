# =============================================================================
# tracker-extract Desktop Entry / Autostart Configuration
# =============================================================================
#
# This template generates a .desktop file for the Tracker File System Miner,
# which crawls and processes files on the local file system for full-text
# indexing. It is typically managed by the desktop environment or systemd.
#
# Variables:
#   - tracker_name: The display name of the application.
#   - tracker_comment: A short description of the application's function.
#   - tracker_exec: The executable path to launch the miner.
#   - tracker_terminal: Whether to launch a terminal window (boolean).
#   - tracker_type: The type of desktop entry (usually 'Application').
#   - tracker_categories: Semicolon-separated list of categories.
#   - tracker_autostart_enabled: Whether the autostart feature is active.
#   - tracker_hidden_systemd: Whether the service is hidden under systemd.
#   - kde_autostart_after_panel: Whether to start after the panel (KDE specific).
#   - kde_startup_notify: Whether to send startup notifications (KDE specific).
#   - kde_unique_applet: Whether the applet is unique (KDE specific).
#   - no_display: Whether to hide the application from menus.
#   - only_show_in: Semicolon-separated list of desktop environments where this
#                   entry should appear.
#   - systemd_skip: Whether to skip systemd integration for this entry.
# =============================================================================

[Desktop Entry]
# Name=Tracker File System Miner
Name={{ tracker_name | default('Tracker File System Miner') }}

# Comment=Crawls and processes files on the file system
Comment={{ tracker_comment | default('Crawls and processes files on the file system') }}

# Exec=/usr/libexec/localsearch-3
Exec={{ tracker_exec | default('/usr/libexec/localsearch-3') }}

# Terminal=false
Terminal={{ tracker_terminal | default(false) | lower }}

# Type=Application
Type={{ tracker_type | default('Application') }}

# Categories=Utility;
Categories={{ tracker_categories | default('Utility;') }}

# X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-enabled={{ tracker_autostart_enabled | default(true) | lower }}

# X-GNOME-HiddenUnderSystemd=true
X-GNOME-HiddenUnderSystemd={{ tracker_hidden_systemd | default(true) | lower }}

# X-KDE-autostart-after=panel
X-KDE-autostart-after={{ kde_autostart_after_panel | default('panel') }}

# X-KDE-StartupNotify=false
X-KDE-StartupNotify={{ kde_startup_notify | default(false) | lower }}

# X-KDE-UniqueApplet=true
X-KDE-UniqueApplet={{ kde_unique_applet | default(true) | lower }}

# NoDisplay=true
NoDisplay={{ no_display | default(true) | lower }}

# OnlyShowIn=GNOME;KDE;XFCE;X-IVI;Unity;
OnlyShowIn={{ only_show_in | default('GNOME;KDE;XFCE;X-IVI;Unity;') }}

# X-systemd-skip=true
X-systemd-skip={{ systemd_skip | default(true) | lower }}