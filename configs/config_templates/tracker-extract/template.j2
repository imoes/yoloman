# ==============================================================================
# Desktop Entry for Tracker File System Miner
#
# This template generates a .desktop file for the Tracker service, which crawls
# and processes files on the local file system to build search indexes.
# ==============================================================================

[Desktop Entry]

# The display name of the desktop entry.
Name={{ name | default('Tracker File System Miner') }}

# Description of what the application does.
Comment={{ comment | default('Crawls and processes files on the file system') }}

# The executable path for the service.
Exec={{ exec_path | default('/usr/libexec/localsearch-3') }}

# Whether the application requires a terminal window.
Terminal={{ terminal | default('false') }}

# The type of the desktop entry.
Type={{ type | default('Application') }}

# Semicolon-separated list of categories.
Categories={{ categories | default('Utility;') }}

# ==============================================================================
# Desktop Environment Specific Extensions
# ==============================================================================

# Whether GNOME autostart is enabled.
X-GNOME-Autostart-enabled={{ gnome_autostart_enabled | default('true') }}

# Whether the entry is hidden under systemd.
X-GNOME-HiddenUnderSystemd={{ gnome_hidden_under_systemd | default('true') }}

# KDE autostart order (e.g., panel).
X-KDE-autostart-after={{ kde_autostart_after | default('panel') }}

# Whether KDE startup notify is enabled.
X-KDE-StartupNotify={{ kde_startup_notify | default('false') }}

# Whether the applet is unique in KDE.
X-KDE-UniqueApplet={{ kde_unique_applet | default('true') }}

# Whether the entry should be hidden from menus.
NoDisplay={{ no_display | default('true') }}

# Semicolon-separated list of desktop environments where this entry should appear.
OnlyShowIn={{ only_show_in | default('GNOME;KDE;XFCE;X-IVI;Unity;') }}

# Whether to skip systemd integration.
X-systemd-skip={{ x_systemd_skip | default('true') }}
