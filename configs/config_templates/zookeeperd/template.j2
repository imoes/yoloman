# by default we allow local JMX connections
{% if jmxlocalonly %}JMXLOCALONLY={{ jmxlocalonly }}{% else %}#JMXLOCALONLY=true{% endif %}

{% if java_opts %}JAVA_OPTS="{{ java_opts }}"{% else %}#JAVA_OPTS=""{% endif %}
