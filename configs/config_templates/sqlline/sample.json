{
  "java_home": "/usr/lib/jvm/java-11-openjdk-amd64",
  "sqlline_jar": "/opt/sqlline/sqlline.jar",
  "jdbc_url": "jdbc:mysql://localhost:3306/mydb",
  "username": "admin",
  "password": "secret",
  "driver_class": "com.mysql.cj.jdbc.Driver",
  "use_color": true,
  "show_headers": true,
  "header_interval": 50,
  "fast_connect": false,
  "auto_commit": false,
  "verbose": true,
  "show_warnings": true,
  "force": true,
  "max_width": 100,
  "max_column_width": 40,
  "silent": false,
  "autosave": true,
  "output_format": "csv",
  "isolation_level": "serializable",
  "script_file": "/etc/sqlline/init.sql"
}
