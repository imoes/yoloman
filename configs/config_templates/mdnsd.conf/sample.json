{
  "enabled": true,
  "hostname": "mydevice",
  "domain": "local",
  "interface": "eth0",
  "port": 5353,
  "nsec_cache": false,
  "log_level": 3,
  "log_file": "/var/log/mdnsd.log",
  "services": [
    {
      "type": "_http._tcp",
      "name": "Web Server",
      "description": "HTTP service for local web admin",
      "metadata": {
        "path": "/",
        "ui": "true"
      }
    },
    {
      "type": "_ssh._tcp",
      "name": "SSH",
      "description": "SSH access",
      "metadata": {}
    },
    {
      "type": "_workstation._tcp",
      "name": "Workstation",
      "description": "Network browser entry",
      "metadata": {}
    }
  ]
}
