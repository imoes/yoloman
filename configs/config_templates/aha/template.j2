{# aha configuration template: self-documenting #}
{# Each boolean option is only emitted if explicitly True; false/undefined defaults emit nothing. #}
{# String options use their schema default (usually empty) when not provided. #}

{# black: default=False #}
{# Style HTML output to use a black background with white text. #}
{% if black | default(False) %}-b
{% endif -%}

{# css_file: default='' #}
{# Path to CSS file to link in HTML header. #}
{% if css_file | default('') %}-c {{ css_file | default('') }}
{% endif -%}

{# input_file: default='' #}
{# Input file instead of stdin. #}
{% if input_file | default('') %}-f {{ input_file | default('') }}
{% endif -%}

{# iso_encoding: default=1 #}
{# ISO-8899-X encoding (X: 1–16) instead of UTF-8. #}
{% if iso_encoding | default(1) %}-i {{ iso_encoding | default(1) }}
{% endif -%}

{# line_fix: default=False #}
{# Fix inputs using control sequences to change cursor position. #}
{% if line_fix | default(False) %}-l
{% endif -%}

{# lang: default='en' #}
{# ISO-639-1 language code for HTML lang attribute. #}
{% if lang | default('en') %}-L {{ lang | default('en') }}
{% endif -%}

{# no_header: default=False #}
{# Do not enclose HTML in <html>, <head>, and <body> tags. #}
{% if no_header | default(False) %}-n
{% endif -%}

{# pink: default=False #}
{# Style HTML output to use a pink background. #}
{% if pink | default(False) %}-p
{% endif -%}

{# ignore_cr: default=False #}
{# Ignore carriage-returns (\r). #}
{% if ignore_cr | default(False) %}-r
{% endif -%}

{# stylesheet: default=False #}
{# Use external stylesheet instead of inline styles. #}
{% if stylesheet | default(False) %}-s
{% endif -%}

{# title: default='stdin' #}
{# HTML document title. #}
{% if title | default('stdin') %}-t {{ title | default('stdin') }}
{% endif -%}

{# word_wrap: default=False #}
{# Wrap long lines in HTML output (CSS3). #}
{% if word_wrap | default(False) %}-w
{% endif -%}

{# no_xml: default=False #}
{# Use <!DOCTYPE html> instead of XML declaration. #}
{% if no_xml | default(False) %}-x
{% endif -%}

{# style: default='' #}
{# Inline <body> style string. #}
{% if style | default('') %}-y {{ style | default('') }}
{% endif -%}