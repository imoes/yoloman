{
  "runtime_path": "/var/lib/monado",
  "ipc_socket_path": "/run/monado/monado-ipc",
  "log_level": "WARN",
  "verbose_logging": false,
  "worker_threads": 4,
  "input_devices": [
    {
      "type": "openxr",
      "name": "quest2",
      "enabled": true,
      "config": {
        "timeout_ms": 500,
        "hand_tracking": true
      }
    },
    {
      "type": "keyboard",
      "name": "virtual-menu",
      "enabled": false
    }
  ],
  "compositor_layers": [
    {
      "name": "status-indicator",
      "enabled": true,
      "type": "overlay",
      "options": {
        "opacity": 0.85,
        "text": "XR Ready"
      }
    }
  ],
  "backends": [
    {
      "name": "openxr-ovr",
      "enabled": true,
      "config": {
        "display_refresh_rate": 72,
        "render_resolution": [
          1832,
          1920
        ]
      }
    },
    {
      "name": "openxr-sim",
      "enabled": false
    }
  ]
}
