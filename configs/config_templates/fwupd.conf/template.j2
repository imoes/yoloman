# Enable or disable firmware updates from remote sources
{% if remote_enabled %}
RemoteLayout=https://fwupd.org/downloads/firmware.xml.gz
{% else %}
# RemoteLayout is disabled
{% endif %}

# Path to local metadata (if overriding remote)
{% if metadata_path %}MetadataDir={{ metadata_path }}{% else %}# MetadataDir=/var/lib/fwupd{% endif %}

# Path to local firmware blobs
{% if firmware_dir %}FirmwareDir={{ firmware_dir }}{% else %}# FirmwareDir=/var/lib/fwupd/firmware{% endif %}

# Enable or disable automatic downloads of firmware
{% if auto_download %}AutoDownload=always{% elif auto_download is none %}# AutoDownload=report{% else %}AutoDownload=manual{% endif %}

# Enable or disable automatic installation of firmware
{% if auto_install %}AutoInstall=always{% elif auto_install is none %}# AutoInstall=report{% else %}AutoInstall=manual{% endif %}

# Minimum battery percentage required for updates
{% if min_battery is not none %}MinBattery={{ min_battery }}{% else %}# MinBattery=50{% endif %}

# Timeout (in seconds) for firmware downloads
{% if download_timeout is not none %}DownloadTimeout={{ download_timeout }}{% else %}# DownloadTimeout=300{% endif %}

# List of allowed remote URLs (if strict verification enabled)
{% for remote in allowed_remotes %}AllowedRemotes={{ remote }}
{% endfor %}

# Enable or disable testing firmware (use with caution)
{% if test_firmware %}TestFirmware=true{% else %}# TestFirmware=false{% endif %}

# Enable or disable firmware lock (prevents flashing without user confirmation)
{% if firmware_lock %}FirmwareLock=true{% else %}# FirmwareLock=false{% endif %}

# List of firmware versions to ignore (skip updates for specific versions)
{% for version in ignore_versions %}IgnoreVersion={{ version }}
{% endfor %}

# Path to additional configuration fragments
{% if conf_dir %}ConfDir={{ conf_dir }}{% else %}# ConfDir=/etc/fwupd.conf.d{% endif %}

# Enable or disable network usage (for offline systems)
{% if offline_updates %}OfflineUpdates=true{% else %}# OfflineUpdates=false{% endif %}

# Enable or disable UI hints (e.g., desktop notifications)
{% if ui_hints %}UIGroups=system-ui;user-ui{% else %}# UIGroups=system-ui{% endif %}

# Disable specific device types (e.g., 'device:usb', 'device:pc-dai')
{% for device_type in disabled_device_types %}DisabledDevices={{ device_type }}
{% endfor %}

# Enable specific device types (whitelist)
{% for device_type in enabled_device_types %}EnabledDevices={{ device_type }}
{% endfor %}

# Enable verbose logging
{% if debug %}Debug=true{% else %}# Debug=false{% endif %}

# Log level: 'info', 'debug', 'trace'
{% if log_level %}LogLevel={{ log_level }}{% else %}# LogLevel=info{% endif %}

# Path to custom CA bundle
{% if ca_bundle %}CaBundle={{ ca_bundle }}{% else %}# CaBundle=/etc/ssl/certs/ca-certificates.crt{% endif %}

# Enable or disable signature verification
{% if verification %}Verification=true{% else %}# Verification=false{% endif %}

# Path to vendor metadata (if using custom metadata)
{% if vendor_metadata_path %}VendorMetadataDir={{ vendor_metadata_path }}{% else %}# VendorMetadataDir=/var/lib/fwupd/vendor-metadata{% endif %}

# Enable or disable local firmware cache
{% if local_cache %}LocalCache=true{% else %}# LocalCache=false{% endif %}

# Maximum number of concurrent downloads
{% if max_concurrent_downloads is not none %}MaxConcurrentDownloads={{ max_concurrent_downloads }}{% else %}# MaxConcurrentDownloads=3{% endif %}

# Enable or disable firmware checksum verification
{% if checksum_verification %}ChecksumVerification=true{% else %}# ChecksumVerification=false{% endif %}
