{
  "remote_enabled": true,
  "metadata_path": "",
  "firmware_dir": "/var/lib/fwupd/firmware",
  "auto_download": true,
  "auto_install": true,
  "min_battery": 20,
  "download_timeout": 600,
  "allowed_remotes": [
    "https://fwupd.org/downloads/firmware.xml.gz",
    "https://custom-vendor.example.com/firmware.xml.gz"
  ],
  "test_firmware": false,
  "firmware_lock": true,
  "ignore_versions": [
    "1.0.0",
    "1.1.0"
  ],
  "conf_dir": "/etc/fwupd.conf.d",
  "offline_updates": false,
  "ui_hints": true,
  "disabled_device_types": [
    "device:tpm",
    "device:acpi"
  ],
  "enabled_device_types": [],
  "debug": false,
  "log_level": "info",
  "ca_bundle": "/etc/ssl/certs/ca-certificates.crt",
  "verification": true,
  "vendor_metadata_path": "/var/lib/fwupd/vendor-metadata",
  "local_cache": true,
  "max_concurrent_downloads": 5,
  "checksum_verification": true
}
