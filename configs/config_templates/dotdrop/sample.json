{
  "cfg_dotfiles_dir": "dotfiles",
  "cfg_dotpath": "dotfiles",
  "cfg_verbose": true,
  "cfg_nobanner": false,
  "cfg_workers": 4,
  "cfg_profiles": [
    {
      "profile_name": "laptop",
      "dotfiles": [
        "zshrc",
        "vimrc",
        "gitconfig"
      ],
      "config": {}
    },
    {
      "profile_name": "workstation",
      "dotfiles": [
        "zshrc",
        "vimrc",
        "gitconfig",
        "bashrc"
      ],
      "config": {
        "theme": "dark"
      }
    }
  ],
  "cfg_dotfiles": [
    {
      "src": "zsh/.zshrc",
      "dst": "~/.zshrc",
      "link": "relative",
      "preserve_mode": true,
      "ignore": [
        "*.bak"
      ],
      "trans_install": "zsh_env_filter"
    },
    {
      "src": "vim/.vimrc",
      "dst": "~/.vimrc"
    },
    {
      "src": "git/.gitconfig",
      "dst": "~/.gitconfig",
      "action": "gitconfig_setup"
    }
  ],
  "cfg_transformations": [
    {
      "cmd": "echo \"# Generated from template on $(date)\\n$(cat)\"",
      "cond": "dotfile_key == 'zshrc'"
    }
  ],
  "cfg_flags": [
    {
      "theme": "default"
    }
  ],
  "cfg_ignore_patterns": [
    "*.swp",
    ".DS_Store",
    "*.log"
  ]
}
