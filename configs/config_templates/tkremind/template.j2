# TkRemind Configuration File
# Generated by Ansible Jinja2 engine. This file configures the TkRemind reminder utility.
# All variables are sourced directly from the variable namespace with safe defaults.

# If true, TkRemind starts up iconified (minimized to system tray).
# Schema: startup_iconified (bool, default: False)
set STARTUP_ICONIFIED {{ startup_iconified | default(false) | lower }}

# If true, shows a text window with reminders on startup.
# Schema: show_todays_reminders (bool, default: True)
set SHOW_TODAY_REMINDERS {{ show_todays_reminders | default(true) | lower }}

# If true, prompts to confirm when quitting.
# Schema: confirm_quit (bool, default: True)
set CONFIRM_QUIT {{ confirm_quit | default(true) | lower }}

# If true, automatic pop-up reminders close after one minute.
# Schema: auto_close_popups (bool, default: False)
set AUTO_CLOSE_POPUPS {{ auto_close_popups | default(false) | lower }}

# If true, uses desktop system notifications for reminders.
# Schema: use_system_notifications (bool, default: False)
set USE_SYSTEM_NOTIFICATIONS {{ use_system_notifications | default(false) | lower }}

# If true, beeps the terminal bell on reminder.
# Schema: beep_on_reminder (bool, default: False)
set BEEP_ON_REMINDER {{ beep_on_reminder | default(false) | lower }}

# If true, restores the main window when a reminder pops up.
# Schema: deiconify_on_reminder (bool, default: True)
set DEICONIFY_ON_REMINDER {{ deiconify_on_reminder | default(true) | lower }}

# Shell command to execute when a background reminder triggers.
# Schema: popup_command (string, default: '')
set POPUP_COMMAND {{ popup_command | default('') | string }}

# If true, pipes the reminder text to the popup command's stdin.
# Schema: feed_popup_to_command (bool, default: False)
set FEED_POPUP_TO_COMMAND {{ feed_popup_to_command | default(false) | lower }}

# Email address to send reminders to if the user does not dismiss the popup.
# Schema: email_on_undismissed (string, default: '')
set EMAIL_ON_UNDISMISSED {{ email_on_undismissed | default('') | string }}

# IP address or hostname of the SMTP server for email notifications.
# Schema: smtp_server (string, default: '')
set SMTP_SERVER {{ smtp_server | default('') | string }}

# Command for the text editor to edit reminder files. Use %s for file and %d for line number.
# Schema: text_editor (string, default: 'gedit')
set TEXT_EDITOR {{ text_editor | default('gedit') | string }}

# Additional arguments to pass directly to the 'remind' binary.
# Schema: extra_remind_args (string, default: '')
set EXTRA_REMIND_ARGS {{ extra_remind_args | default('') | string }}