{
  "system_identifier": "raspi4b-001",
  "device_compatible": "raspberrypi,4-model-b",
  "statefile": "/var/lib/rauc/statfile",
  "guile_enabled": false,
  "db_backend": "sqlite",
  "db_path": "/var/lib/rauc/rauc.db",
  "api_host": "0.0.0.0",
  "api_port": 3000,
  "tls_enabled": true,
  "tls_cert_path": "/etc/rauc/certs/service.crt",
  "tls_key_path": "/etc/rauc/private/service.key",
  "tls_ca_path": "/etc/rauc/certs/ca.crt",
  "allowed_signers": [
    "RAUC Example CA",
    "sha256/f83e1a4b7c2d5e8f0a9c1b2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f"
  ],
  "max_bundle_size": 1073741824,
  "idle_timeout": 600,
  "autoupdater_enabled": true,
  "check_interval": 1800,
  "boot_check_delay": 90,
  "recovery_boot": "try-rollback",
  "update_providers": [
    {
      "description": "Production Updates",
      "url": "https://updates.example.com/v2/",
      "tls_cert": "/etc/rauc/certs/client.crt",
      "tls_key": "/etc/rauc/private/client.key",
      "tls_ca": "/etc/rauc/certs/production-ca.crt",
      "ca_name": "updates.example.com"
    },
    {
      "description": "Staging Updates",
      "url": "https://staging.example.com/v2/",
      "slot_name": "rootfs.1"
    }
  ]
}
