{
  "bind_address": "0.0.0.0",
  "bind_port": 8443,
  "private_key_path": "/etc/kxd/keys/server.key",
  "certificate_path": "/etc/kxd/keys/server.crt",
  "max_connections": 500,
  "connection_timeout": 60,
  "mtls_enabled": true,
  "log_level": "info",
  "log_file": "/var/log/kxd/kxd.log",
  "cipher_suites": [
    "TLS_AES_256_GCM_SHA384",
    "TLS_CHACHA20_POLY1305_SHA256",
    "ECDHE-RSA-AES128-GCM-SHA256"
  ],
  "trusted_ca_certs": [
    "/etc/kxd/ca/client-ca.crt"
  ],
  "client_hostname_whitelist": [
    "client1.internal",
    "client2.internal"
  ],
  "psk_enabled": false,
  "psk_identity": "",
  "psk_secret_path": "",
  "session_timeout": 1800,
  "rate_limit_rpm": 30,
  "experimental_key_rotation": false,
  "experimental_pfs_only": true
}
