{# gotd.conf: Main configuration for the Game of Trees (gotd) server #}
# Listen on the specified address and port
Listen {{ listen_addr }}:{{ listen_port }}

# Base path for repository storage
Root {{ root_path }}

# Maximum number of simultaneous connections (0 = unlimited)
MaxConnections {{ max_connections }}

# Enable or disable anonymous read access
{% if anonymous_read %}AnonymousRead yes{% else %}AnonymousRead no{% endif %}

# Enable or disable anonymous write access (typically disabled for security)
{% if anonymous_write %}AnonymousWrite yes{% else %}AnonymousWrite no{% endif %}

# Optional: TLS configuration
{% if tls.enabled %}
# Enable TLS with the specified certificate and key
CertFile {{ tls.cert_file }}
KeyFile {{ tls.key_file }}
{% endif %}

# Optional: SSH host key (required for SSH transport)
{% if ssh_host_key %}
# SSH host key file for git-over-ssh
HostKey {{ ssh_host_key }}
{% endif %}

# Optional: Rate limiting (in bytes/sec, 0 = disabled)
{% if rate_limit.enabled %}
RateLimit {{ rate_limit.bytes_per_sec }}
{% endif %}

# Optional: Authentication backends
{% for auth_backend in auth_backends %}
# {{ auth_backend.description }}
{% if auth_backend.type == 'file' %}
AuthFile {{ auth_backend.path }}
{% elif auth_backend.type == 'ldap' %}
LDAPURI {{ auth_backend.ldap.uri }}
LDAPBaseDN {{ auth_backend.ldap.basedn }}
LDAPBindDN {{ auth_backend.ldap.binddn }}
LDAPBindPassword {{ auth_backend.ldap.bind_password }}
LDAPUserFilter {{ auth_backend.ldap.user_filter }}
{% elif auth_backend.type == 'http' %}
AuthHTTP {{ auth_backend.http.endpoint }}
{% endif %}
{% endfor %}

# Optional: Per-repository access control (ACLs)
{% if acls %}
# Access control rules (applied in order)
{% for acl in acls %}
{% if acl.type == 'user' %}
AllowUser {{ acl.user }} {% for path in acl.paths %}{{ path }}{% if not loop.last %} {% endif %}{% endfor %}
{% elif acl.type == 'group' %}
AllowGroup {{ acl.group }} {% for path in acl.paths %}{{ path }}{% if not loop.last %} {% endif %}{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# Optional: Logging configuration
{% if logging.level %}
# Log level: debug, info, notice, warn, error
Log {{ logging.level }}
{% endif %}

# Optional: Chroot directory (e.g., for jails/sandboxes)
{% if chroot %}
Chroot {{ chroot }}
{% endif %}
