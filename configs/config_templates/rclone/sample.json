{
  "remotes": [
    {
      "name": "my-s3-bucket",
      "comment": "Production S3 bucket for backups",
      "type": "s3",
      "options": {
        "provider": "AWS",
        "region": "us-east-1",
        "bucket": "company-backups-prod",
        "acl": "private",
        "upload_cutoff": "100Mi",
        "chunk_size": "50Mi",
        "enable_md5": "true"
      }
    },
    {
      "name": "gdrive-backups",
      "comment": "Google Drive for user document backups",
      "type": "drive",
      "options": {
        "client_id": "123456789-abc.apps.googleusercontent.com",
        "client_secret": "GOCSPX-XXXXXX",
        "scope": "drive",
        "root_folder_id": "0ABXXXXXX",
        "use_mimetype_hint": "true"
      }
    },
    {
      "name": "local-archive",
      "type": "local",
      "options": {
        "path": "/mnt/archive",
        "no_check": "false"
      }
    }
  ]
}
