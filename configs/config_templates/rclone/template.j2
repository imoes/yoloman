# rclone configuration file — generated by template
# Each section defines a remote (cloud storage backend instance)
# Syntax: [name]
#         type = backend_type
#         key = value
# See https://rclone.org/ for full list of backend options

{% for remote in remotes %}[{{ remote.name }}]
{% if remote.comment %}# {{ remote.comment }}
{% endif %}type = {{ remote.type }}
{% for key, value in remote.options.items() %}{{ key }} = {{ value }}
{% endfor %}
{% endfor %}
