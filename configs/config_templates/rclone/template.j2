# rclone configuration file — generated by Ansible
# This file defines named "remotes" which are instances of cloud storage backends
# (e.g. S3, Google Drive, Dropbox). Each section corresponds to one remote.
# Syntax per section:
#   [name]
#   type = <backend_type>
#   <option_key> = <option_value>
#   ...
#
# To add a new remote, provide an entry in the 'remotes' variable:
#   remotes:
#     - name: my-s3
#       type: s3
#       options:
#         provider: AWS
#         region: us-east-1

{% for remote in (remotes | default([])) %}
# Remote: {{ remote.name | default('unnamed') }}
# Type: {{ remote.type | default('unknown') }}
# {% if remote.comment is defined and remote.comment %}# {{ remote.comment }}{% endif %}
[{{ remote.name | default('unnamed') }}]
type = {{ remote.type | default('local') }}

{% for k, v in (remote.options | default({})) | dict2items %}
# {{ k }}
{{ k }} = {{ v }}
{% endfor %}
{% endfor %}