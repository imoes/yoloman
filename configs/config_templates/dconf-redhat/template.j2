# dconf configuration file
#
# This file controls the behavior of the dconf database.
#
# The format is simple: key=value pairs.
#
# dconf is a configuration system for storing application preferences.
# It uses a binary database format for efficiency.

# Path to the user's private database.
# Default location: /var/lib/dconf/user (system-wide managed) or
# ~/.local/share/glib-2.0/dconf/user (per-user).
# If undefined, dconf uses standard paths.
# Note: In many containerized or managed environments, this might be omitted
# or pointed to a specific volume mount.
# {{ 'user-db:' + (user_db | default('/var/lib/dconf/user')) }}

# Path to the system-wide local configuration database.
# This file is typically managed by the package maintainer or Ansible.
# Default location: /etc/dconf/local
# {{ 'system-db:' + (system_db_local | default('/etc/dconf/local')) }}

# Path to the site-wide configuration database.
# Used for policies enforced by the organization/domain.
# Default location: /etc/dconf/site
# {{ 'system-db:' + (system_db_site | default('/etc/dconf/site')) }}

# Path to the distribution-wide configuration database.
# Contains default settings provided by the OS vendor.
# Default location: /etc/dconf/distro
# {{ 'system-db:' + (system_db_distro | default('/etc/dconf/distro')) }}
