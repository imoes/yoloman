{
  "bind_host": "0.0.0.0",
  "api_workers": 1,
  "maxdhcpdevices": 16,
  "enable_isolated_metadata": false,
  "enable_metadata_proxy": true,
  "dhcp_leasefs": "/var/lib/neutron/dhcp",
  "dhcp_leasefile": "/var/lib/neutron/dhcp/leases",
  "domain": "openstack.local",
  "dhcp_broadcast": true,
  "enable_dnsmasq_dns": true,
  "mtu_set": false,
  "dns_servers": [
    "10.0.0.1",
    "8.8.8.8"
  ],
  "extra_dhcp_opts": [
    "tag:pxe,6,10.0.0.1",
    "tag:pxe,3,10.0.0.1"
  ],
  "dnsmasq_config_dir": "/etc/neutron/dnsmasq.d",
  "enable_dnsmasq_cache": true,
  "log_level": "INFO",
  "log_dir": "/var/log/neutron",
  "heartbeat_interval": 30,
  "dhcp_driver": "neutron.agent.linux.dnsmasq.Dnsmasq",
  "use_external_dhcp": false,
  "metadata_port": 80,
  "gateway_in_dns": true,
  "host_routes_in_dns": true,
  "domain_in_dns": true,
  "mtu_in_dns": false,
  "ntp_servers_in_dns": false,
  "static_routes_in_dns": true,
  "lease_time": "86400",
  "subnet_mask_in_dns": true,
  "broadcast_in_dns": true,
  "router_in_dns": true,
  "classless_route_in_dns": true,
  "vendor_class_in_dns": false,
  "user_class_in_dns": false,
  "firmware_in_dns": false,
  "location_in_dns": false,
  "vendor_specific_in_dns": false,
  "netboot_in_dns": false,
  "pxeserver_in_dns": false,
  "pxeboot_in_dns": false,
  "tftp_in_dns": false,
  "bootfile_in_dns": false,
  "initfile_in_dns": false,
  "rootpath_in_dns": false
}
