[DEFAULT]
# The host IP address to bind the DHCP agent to (listen address)
# Set to 0.0.0.0 to listen on all interfaces
bind_host = {{ bind_host }}

# The port to bind the DHCP agent API server to
# Set to 0 to disable the API server
api_workers = {{ api_workers }}

# Maximum number of DHCP agents that can serve a given network
maxdhcpdevices = {{ maxdhcpdevices }}

# Enable or disable metadata proxy (required for instances to access metadata services)
enable_isolated_metadata = {{ enable_isolated_metadata | string | lower }}

# Enable or disable metadata proxy on shared networks
enable_metadata_proxy = {{ enable_metadata_proxy | string | lower }}

# Base directory for DHCP leases (used by dnsmasq)
dhcp_leasefs = {{ dhcp_leasefs }}

# Path to the dnsmasq lease file
dhcp_leasefile = {{ dhcp_leasefile }}

# DNS domain for instances (e.g., openstack.local)
domain = {{ domain }}

# Enable or disable use of DHCP broadcast address
# Set to True for compatibility with older clients
dhcp_broadcast = {{ dhcp_broadcast | string | lower }}

# Enable or disable use of DNS in dnsmasq
enable_dnsmasq_dns = {{ enable_dnsmasq_dns | string | lower }}

# Enable or disable use of MTU setting in dnsmasq (requires dnsmasq >= 2.67)
# Note: Some older dnsmasq versions do not support --mtu-set
mtu_set = {{ mtu_set | string | lower }}

# DNS servers to provide to instances (list of IPs)
# If empty, uses DNS servers from the subnet
{% for dns_server in dns_servers %}dns_server = {{ dns_server }}{% endfor %}

# Extra DHCP options to pass to dnsmasq
# Format: tag:<tag>,<option>,<value>
{% for extra_dhcp_opt in extra_dhcp_opts %}extra_dhcp_opt = {{ extra_dhcp_opt }}{% endfor %}

# Path to the dnsmasq config directory (per-network configs)
dnsmasq_config_dir = {{ dnsmasq_config_dir }}

# Enable or disable use of dnsmasq cache
enable_dnsmasq_cache = {{ enable_dnsmasq_cache | string | lower }}

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
log_level = {{ log_level }}

# Logging directory
log_dir = {{ log_dir }}

[AGENT]
# Periodic interval (seconds) to send heartbeats to the server
# Set to 0 to disable heartbeats
heartbeat_interval = {{ heartbeat_interval }}

# DHCP driver to use (e.g., 'neutron.agent.linux.dnsmasq.Dnsmasq')
dhcp_driver = {{ dhcp_driver }}

# Enable or disable use of external DHCP (e.g., for multi-tenant isolated networks)
use_external_dhcp = {{ use_external_dhcp | string | lower }}

# Metadata port used by instances to access metadata services
metadata_port = {{ metadata_port }}

# Enable or disable use of gateway IP in DNS responses
gateway_in_dns = {{ gateway_in_dns | string | lower }}

# Enable or disable use of host routes in DNS responses
host_routes_in_dns = {{ host_routes_in_dns | string | lower }}

# Enable or disable use of DNS domain in responses
domain_in_dns = {{ domain_in_dns | string | lower }}

# Enable or disable use of MTU in DNS responses
mtu_in_dns = {{ mtu_in_dns | string | lower }}

# Enable or disable use of NTP servers in DNS responses
ntp_servers_in_dns = {{ ntp_servers_in_dns | string | lower }}

# Enable or disable use of static routes in DNS responses
static_routes_in_dns = {{ static_routes_in_dns | string | lower }}

# Enable or disable use of search domains in DNS responses
search_domains_in_dns = {{ search_domains_in_dns | string | lower }}

# Enable or disable use of lease time in DHCP responses
lease_time = {{ lease_time }}

# Enable or disable use of subnet mask in DNS responses
subnet_mask_in_dns = {{ subnet_mask_in_dns | string | lower }}

# Enable or disable use of broadcast address in DNS responses
broadcast_in_dns = {{ broadcast_in_dns | string | lower }}

# Enable or disable use of router option in DNS responses
router_in_dns = {{ router_in_dns | string | lower }}

# Enable or disable use of classless static route option in DNS responses
classless_route_in_dns = {{ classless_route_in_dns | string | lower }}

# Enable or disable use of vendor class option in DNS responses
vendor_class_in_dns = {{ vendor_class_in_dns | string | lower }}

# Enable or disable use of user class option in DNS responses
user_class_in_dns = {{ user_class_in_dns | string | lower }}

# Enable or disable use of firmware option in DNS responses
firmware_in_dns = {{ firmware_in_dns | string | lower }}

# Enable or disable use of location option in DNS responses
location_in_dns = {{ location_in_dns | string | lower }}

# Enable or disable use of vendor-specific info option in DNS responses
vendor_specific_in_dns = {{ vendor_specific_in_dns | string | lower }}

# Enable or disable use of netboot option in DNS responses
netboot_in_dns = {{ netboot_in_dns | string | lower }}

# Enable or disable use of pxeserver option in DNS responses
pxeserver_in_dns = {{ pxeserver_in_dns | string | lower }}

