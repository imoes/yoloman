# air-quality-sensor configuration
# ==========================================
# Global verbosity
# Description: Enable verbose output (equivalent to -v CLI flag).
# If true, extra diagnostic messages are printed for every sensor read.
# Default: False
{% if verbose | default(False) %}
verbose
{% endif %}

# Global timeout for sensor reads (seconds)
# Description: Global timeout for sensor reads in seconds. Applies to all sensors unless overridden per-sensor.
# Default: 5
timeout {{ timeout | default(5) }}

# Output format
# Description: Output format for sensor readings. Valid values: plain (human-readable), json (structured JSON), csv (comma-separated).
# Default: plain
format {{ format | default('plain') }}