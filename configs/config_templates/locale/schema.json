{
  "aliases": {
    "type": "list",
    "default": [],
    "description": "List of locale alias mappings, each with a legacy/alternative locale name and its canonical form",
    "items": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string",
          "default": "",
          "description": "Legacy or alternative locale name (e.g., 'en_US.UTF-8@euro')"
        },
        "canonical": {
          "type": "string",
          "default": "",
          "description": "Canonical locale identifier (e.g., 'en_US.UTF-8')"
        }
      },
      "required": [
        "alias",
        "canonical"
      ]
    }
  }
}
