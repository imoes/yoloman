#!/bin/sh

# /etc/X11/xinit/xinitrc
#
# Global xinitrc file, used by all X sessions started by xinit (startx).
# This template is self-documenting: variable defaults are derived from the schema.

# Invoke the global X session script.
. /etc/X11/Xsession

{% set xinitrc_session_script = xinitrc_session_script | default('') %}
{% if xinitrc_session_script | length > 0 %}
# Additional session script to source after /etc/X11/Xsession.
# Source the specified script if one is defined.
. {{ xinitrc_session_script }}
{% endif %}

{% set xinitrc_startup_commands = xinitrc_startup_commands | default([]) %}
# List of commands to execute at the end of the xinitrc script.
{% for cmd in xinitrc_startup_commands %}
# Command: {{ cmd }}
{{ cmd }}
{% endfor %}