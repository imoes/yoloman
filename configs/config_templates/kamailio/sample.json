{
  "db_engine": "mysql",
  "db_url": "mysql://kam:secret@127.0.0.1/kamailio",
  "port_sip": 5060,
  "port_sips": 5061,
  "listen_addr": "192.168.1.10",
  "workers": 4,
  "fork_mode": "1",
  "log_level": 3,
  "enable_tls": true,
  "tls_cert": "/etc/kamailio/tls/myserver.example.com.crt",
  "tls_key": "/etc/kamailio/tls/myserver.example.com.key",
  "tls_ca_list": "/etc/kamailio/tls/ca-bundle.crt",
  "tls_method": "TLSv1_2",
  "enable_mysql": true,
  "enable_pgsql": false,
  "enable_ldap": false,
  "auth_realm": "sip.example.com",
  "extra_modules": [
    "nathelper",
    "location",
    "rls"
  ],
  "trace_destination": "file:///var/log/kamailio/kamailio_trace.log",
  "trace_local": false,
  "rport_header": "X-RPort",
  "rport_value": "rport"
}
