{
  "services": [
    {
      "name": "web-lb",
      "type": "lb",
      "proto": "tcp",
      "listen_ip": "0.0.0.0",
      "listen_port": 80,
      "backends": [
        {
          "ip": "10.0.0.10",
          "port": 80,
          "weight": 3
        },
        {
          "ip": "10.0.0.11",
          "port": 80,
          "weight": 2
        },
        {
          "ip": "10.0.0.12",
          "port": 80,
          "weight": 1
        }
      ],
      "health_check": {
        "type": "http",
        "path": "/health"
      },
      "options": {
        "sched": "wrr",
        "persistence": "300"
      }
    },
    {
      "name": "dns-udp",
      "type": "lb",
      "proto": "udp",
      "listen_ip": "192.168.1.1",
      "listen_port": 53,
      "backends": [
        {
          "ip": "8.8.8.8",
          "port": 53
        },
        {
          "ip": "1.1.1.1",
          "port": 53
        }
      ]
    }
  ],
  "global_settings": {
    "log_level": "info",
    "persistence_default": 120
  }
}
