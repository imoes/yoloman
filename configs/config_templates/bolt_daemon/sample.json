{
  "acl_policy": "deny",
  "state_dir": "/var/lib/bolt",
  "max_devices": 50,
  "log_level": "info",
  "device_timeout": 20,
  "auto_auth_trusted": false,
  "auto_auth_pci_bdfs": [
    "00:02.0",
    "00:14.0"
  ],
  "auth_groups": [
    "wheel",
    "plugdev"
  ],
  "auth_users": [
    "thunderbolt-admin"
  ],
  "udev_dir": "",
  "enable_legacy_enumeration": true
}
