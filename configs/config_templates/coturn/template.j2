# Enable automatic systemd service startup of coturn.
# Set to 'true' or '1' to start the turnserver daemon on boot, 'false' or '0' to disable it.
{% if turnserver_enabled is defined and turnserver_enabled is not none and (turnserver_enabled is number or turnserver_enabled is boolean or turnserver_enabled | length > 0) %}TURNSERVER_ENABLED={{ turnserver_enabled|default(false)|bool|int }}{% else %}#TURNSERVER_ENABLED=1{% endif %}
