{
  "bind": "127.0.0.1:2628",
  "maxconn": 128,
  "loglevel": "notice",
  "dictdir": "/usr/share/dictd",
  "clienttimeout": 300,
  "defaultdb": "wordnet,enwiktionary",
  "databases": [
    {
      "name": "wordnet",
      "title": "WordNet (r) 2.0"
    },
    {
      "name": "enwiktionary",
      "title": "English Wiktionary"
    }
  ],
  "access_rules": [
    {
      "action": "allow",
      "pattern": "10.0.0.0/8"
    },
    {
      "action": "deny",
      "pattern": "192.168.99.*"
    }
  ],
  "rate_limit": {
    "enabled": true,
    "max_queries": 20,
    "window": 60
  },
  "motd": "Welcome to the campus dictionary server. Query via 'define' commands."
}
