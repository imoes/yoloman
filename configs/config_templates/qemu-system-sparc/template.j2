# QEMU System SPARC Configuration Template
# Generated by Ansible Jinja2 engine.
# This file represents the command-line arguments and parameters for launching
# a QEMU emulator instance targeting the SPARC architecture.
#
# Each variable below corresponds to a QEMU CLI flag. Defaults are applied
# inline to ensure the configuration renders correctly even if upstream
# Ansible variables are undefined.

# Emulated machine type. For SPARC, common types are 'sun4m' (legacy 32-bit),
# 'sun4u' (UltraSPARC 64-bit), or 'leon3' (embedded).
# QEMU Flag: -machine type={{ machine_type | default('sun4m') }}
machine={{ machine_type | default('sun4m') }}

# Accelerator backend. 'tcg' is the default software translator. 'kvm' requires
# specific host kernel support for the emulated machine type.
# QEMU Flag: -accel {{ accelerator | default('tcg') }}
accelerator={{ accelerator | default('tcg') }}

# Guest RAM size. Accepts numeric values with suffixes like 'M' (megabytes) or
# 'G' (gigabytes).
# QEMU Flag: -m {{ memory | default('128M') }}
memory={{ memory | default('128M') }}

# Number of virtual CPUs to simulate. Note that support for SMP (Symmetric
# Multi-Processing) depends on the chosen machine type.
# QEMU Flag: -smp cpus={{ cpus | default(1) }}
cpus={{ cpus | default(1) }}

# Boot device order string. Letters correspond to devices: 'd' is usually CD-ROM,
# 'c' is Hard Disk.
# QEMU Flag: -boot order={{ boot_order | default('d') }}
boot_order={{ boot_order | default('d') }}

# Path to the hard disk image file for the first IDE drive (hda).
# QEMU Flag: -hda {{ hda_image | default('') }}
hda_image={{ hda_image | default('') }}

# Path to the CD-ROM/DVD image file.
# QEMU Flag: -cdrom {{ cdrom_image | default('') }}
cdrom_image={{ cdrom_image | default('') }}

# OpenBIOS PROM environment variables. This is a list of strings in 'key=value'
# format. They are emitted as separate -prom-env arguments.
# QEMU Flag: -prom-env <each item in prom_envs>
{% for env_var in prom_envs | default([]) %}
# QEMU Flag: -prom-env {{ env_var }}
prom_env_{{ loop.index }}={{ env_var }}
{% endfor %}
{% if (prom_envs | default([])) | length == 0 %}
# No custom PROM environment variables specified.
prom_envs_empty=true
{% endif %}

# Enable/Disable USB emulation. Note: sun4m machines might not have on-board
# USB controllers by default; enabling this may require specific machine configs.
# QEMU Flag: -usb
{% if usb_enabled | default(False) | bool %}
usb_enabled=true
{% else %}
# USB emulation disabled by default for sun4m compatibility.
usb_enabled=false
{% endif %}

# VNC display port for remote graphical access. A value of 0 disables VNC.
# The actual VNC server listens on port 5900 + display_number.
# QEMU Flag: -vnc :{{ (vnc_port | default(0)) - 5900 }}
# Note: The config file stores the explicit port requested.
vnc_port={{ vnc_port | default(0) }}

# Kernel command line arguments for direct kernel boot mode.
# QEMU Flag: -append {{ kernel_cmdline | default('') }}
kernel_cmdline={{ kernel_cmdline | default('') }}

# Path to the kernel image file for direct boot.
# QEMU Flag: -kernel {{ kernel_image | default('') }}
kernel_image={{ kernel_image | default('') }}

# Path to the initial RAM disk (initrd) for direct boot.
# QEMU Flag: -initrd {{ initrd_image | default('') }}
initrd_image={{ initrd_image | default('') }}

# Path to the Device Tree Blob (DTB) image. Often required for SPARC64 or
# leon3 direct kernel boots.
# QEMU Flag: -dtb {{ dtb_image | default('') }}
dtb_image={{ dtb_image | default('') }}

# If true, disables all default devices (serial, parallel, VGA, sound, etc.).
# Useful for minimal headless VMs where only specified devices are needed.
# QEMU Flag: -nodefaults
{% if nodefaults | default(False) | bool %}
nodefaults=true
{% else %}
nodefaults=false
{% endif %}

# Serial console destination. 'stdio' connects to standard input/output of the
# QEMU process.
# QEMU Flag: -serial {{ serial_console | default('stdio') }}
serial_console={{ serial_console | default('stdio') }}

# Network interface card (NIC) model. 'lance' (Am7990) is standard for sun4m.
# 'ne2k_pci' is often used for sun4u. The network backend is 'user' (NAT) by
# default in this simplified config.
# QEMU Flag: -nic model={{ net_model | default('lance') }},netdev=user.0
net_model={{ net_model | default('lance') }}

# MAC address for the primary network interface. If empty, QEMU generates a
# random one.
# QEMU Flag: -nic mac={{ net_mac | default('') }}
net_mac={{ net_mac | default('') }}