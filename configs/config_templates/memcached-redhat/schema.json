{
  "port": {
    "type": "number",
    "default": 11211,
    "description": "TCP port to listen on (PORT)."
  },
  "memcached_user": {
    "type": "string",
    "default": "memcached",
    "description": "User the daemon runs as (USER)."
  },
  "max_connections": {
    "type": "number",
    "default": 1024,
    "description": "Maximum simultaneous connections (MAXCONN)."
  },
  "max_memory_mb": {
    "type": "number",
    "default": 64,
    "description": "Memory for item storage, in megabytes (CACHESIZE)."
  },
  "bind_address": {
    "type": "string",
    "default": "127.0.0.1,::1",
    "description": "Interface(s) to listen on, comma-separated (-l in OPTIONS)."
  },
  "extra_options": {
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    },
    "description": "Further memcached options appended to OPTIONS."
  }
}
