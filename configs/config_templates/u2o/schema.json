{
  "workid": {
    "type": "string",
    "default": "MYWORK",
    "description": "The work id to use for the OSIS file."
  },
  "files": {
    "type": "list",
    "default": [],
    "description": "File or files to process (wildcards allowed). Each item is a path string."
  },
  "output_file": {
    "type": "string",
    "default": "",
    "description": "Specify output file. If empty, output goes to stdout."
  },
  "encoding": {
    "type": "string",
    "default": "",
    "description": "Set encoding to use for USFM files. If empty, defaults are used."
  },
  "lang": {
    "type": "string",
    "default": "und",
    "description": "Specify language code (default: und)."
  },
  "sort": {
    "type": "string",
    "default": "canonical",
    "description": "Sort order. Options: canonical, none.",
    "enum": [
      "canonical",
      "none"
    ]
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug mode."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output."
  },
  "no_validation": {
    "type": "bool",
    "default": false,
    "description": "Disable OSIS validation and reformatting."
  },
  "no_nfc": {
    "type": "bool",
    "default": false,
    "description": "Disable unicode NFC normalization."
  }
}
