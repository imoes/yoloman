# ==============================================================================
# USFM to OSIS XML Converter (u2o) Configuration Template
# ==============================================================================
# This template generates the configuration file for the u2o tool, which converts
# USFM (Unified Standard Format Manager) files to OSIS (Open Scripture Interface
# Standard) XML format.
#
# Each configuration directive is documented below with its source description
# and applied default values to ensure safe rendering even when variables are
# undefined in the Ansible context.
# ==============================================================================

# workid: The work id to use for the OSIS file.
# Default: 'MYWORK'
WORKID = {{ workid | default('MYWORK') }}

# files: File or files to process (wildcards allowed). Each item is a path string.
# Default: [] (empty list)
# Note: In a service context, this is typically handled by the command invocation,
# but can be defaulted here if a specific processing queue is expected.
FILES = {{ files | default([]) | join(' ') }}

# output_file: Specify output file. If empty, output goes to stdout.
# Default: '' (empty string)
OUTPUT_FILE = {{ output_file | default('') }}

# encoding: Set encoding to use for USFM files. If empty, defaults are used.
# Default: '' (empty string)
ENCODING = {{ encoding | default('') }}

# lang: Specify language code (default: und).
# Default: 'und' (undetermined)
LANG = {{ lang | default('und') }}

# sort: Sort order. Options: canonical, none.
# Default: 'canonical'
SORT = {{ sort | default('canonical') }}

# debug: Enable debug mode.
# Default: False
DEBUG = {% if debug | default(False) %}1{% else %}0{% endif %}

# verbose: Enable verbose output.
# Default: False
VERBOSE = {% if verbose | default(False) %}1{% else %}0{% endif %}

# no_validation: Disable OSIS validation and reformatting.
# Default: False
NO_VALIDATION = {% if no_validation | default(False) %}1{% else %}0{% endif %}

# no_nfc: Disable unicode NFC normalization.
# Default: False
NO_NFC = {% if no_nfc | default(False) %}1{% else %}0{% endif %}