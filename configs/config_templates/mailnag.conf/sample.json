{
  "daemon": true,
  "check_interval": 300,
  "loglevel": 1,
  "pidfile": "/run/mailnag/mailnag.pid",
  "accounts": [
    {
      "name": "Personal Gmail",
      "protocol": "oauth2",
      "hostname": "imap.gmail.com",
      "port": 993,
      "ssl": true,
      "starttls": false,
      "username": "user@gmail.com",
      "password": "",
      "folder": "INBOX",
      "oauth2": {
        "client_id": "123456789-abc.apps.googleusercontent.com",
        "client_secret": "GOCSPX-xyz",
        "refresh_token": "1//xyz",
        "scopes": [
          "https://mail.google.com/"
        ]
      }
    },
    {
      "name": "Work Outlook",
      "protocol": "imap",
      "hostname": "outlook.office365.com",
      "port": 993,
      "ssl": true,
      "starttls": false,
      "username": "user@company.com",
      "password": "AppPassword123!",
      "folder": "Inbox"
    }
  ],
  "notifications": [
    {
      "name": "desktop",
      "summary_template": "{{ count }} new message(s)",
      "body_template": "{% for msg in messages %}{{ msg.from }}: {{ msg.subject }}\n{% endfor %}",
      "icon": "/usr/share/pixmaps/mailnag/mailnag.png"
    },
    {
      "name": "sound",
      "sound_file": "/usr/share/sounds/generic.wav"
    }
  ],
  "storage_path": "~/.local/share/mailnag/mailnag.db"
}
