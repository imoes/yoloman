#!/bin/sh
#
# chkconfig: 2345 09 91
# description: init.d script for Arno's Iptables Firewall
#
# This init script manages the Arno's Iptables Firewall service.
# It is automatically generated from an Ansible role's Jinja2 template.
#
# Service Name Configuration:
#   NAME: The service identifier used in log messages and as the process identifier.
#   VERBOSE: Enable verbose output during service operations (1 to enable, 0 to disable).

### BEGIN INIT INFO
# Provides:          {{ (NAME | default('arno-iptables-firewall')) }}
# Required-Start:    $local_fs $remote_fs $network
# Required-Stop:     $local_fs $remote_fs $network
# Default-Start:     S
# Default-Stop:      0 6
# Short-Description: Setup iptables firewall configuration
### END INIT INFO

############################################################################################
# You should put this script in eg. "/etc/init.d/" .                                       #
# Furthermore make sure it's executable! -> "chmod 700" or "chmod +x" it                   #
# If you want to run it upon boot, either add an entry in your "/etc/rc.d/rc.local" or     #
# (for eg. Debian) in "/etc/rcS.d/" create a symlink to the arno-iptables-firewall script #
# ("ln -s /etc/init.d/arno-iptables-firewall script S99-arno-iptables-firewall script").  #
############################################################################################

PATH=/bin:/usr/bin:/sbin:/usr/sbin

# Service Name:
#   Identifies this specific firewall instance in logs and process listings.
#   Default: 'arno-iptables-firewall'
NAME="{{ (NAME | default('arno-iptables-firewall')) }}"

PROGRAM="/usr/sbin/arno-iptables-firewall"

# Verbose Mode:
#   Set to 1 to enable verbose logging output for start/stop/restart actions.
#   Set to 0 (default) to run silently.
VERBOSE={{ (VERBOSE | default(0)) }}

test -x $PROGRAM || exit 0

. /lib/lsb/init-functions

if [ "{{ (VERBOSE | default(0)) }}" = "0" ]; then
  case "$1" in
    start)
      log_daemon_msg "Starting Arno's Iptables Firewall({{ (NAME | default('arno-iptables-firewall')) }})" "{{ (NAME | default('arno-iptables-firewall')) }}"
    ;;

    stop)
      log_daemon_msg "Stopping Arno's Iptables Firewall({{ (NAME | default('arno-iptables-firewall')) }})" "{{ (NAME | default('arno-iptables-firewall')) }}"
    ;;

    restart)
      log_daemon_msg "Restarting Arno's Iptables Firewall({{ (NAME | default('arno-iptables-firewall')) }})" "{{ (NAME | default('arno-iptables-firewall')) }}"
    ;;

    force-reload)
      log_daemon_msg "(Forced) reloading Arno's Iptables Firewall({{ (NAME | default('arno-iptables-firewall')) }})" "{{ (NAME | default('arno-iptables-firewall')) }}"
    ;;

    status)
      $PROGRAM $*
      exit $?
    ;;

    configtest)
      $PROGRAM check-conf
      exit $?
    ;;

    *)
      $PROGRAM
      exit 1
    ;;
  esac

  # Call firewall script:
  result=`$PROGRAM $*`
  retval=$?
  log_end_msg $retval
else
  $PROGRAM $*
  retval=$?
fi

# Return value:
exit $retval