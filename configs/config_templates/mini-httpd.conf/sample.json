{
  "listen_addr": "0.0.0.0",
  "port": 8080,
  "max_connections": 512,
  "user": "www-data",
  "group": "www-data",
  "document_root": "/var/www/mini-site",
  "index_files": [
    "index.html",
    "index.php"
  ],
  "enable_directory_listings": true,
  "mime_types_file": "/etc/mini-httpd/mime.types",
  "access_log": "/var/log/mini-httpd/access.log",
  "error_log": "/var/log/mini-httpd/error.log",
  "ssl_enabled": true,
  "ssl_certificate_path": "/etc/ssl/certs/mini-httpd.crt",
  "ssl_private_key_path": "/etc/ssl/private/mini-httpd.key",
  "timeout_seconds": 45,
  "max_request_body_size": 52428800,
  "cache_enabled": true,
  "cache_dir": "/var/cache/mini-httpd/content",
  "cache_max_size": 1073741824,
  "virtual_hosts": [
    {
      "name": "Primary site",
      "hostname": "example.com",
      "document_root": "/var/www/example",
      "ssl_enabled": true,
      "ssl_certificate_path": "/etc/ssl/certs/example.crt",
      "ssl_private_key_path": "/etc/ssl/private/example.key"
    },
    {
      "name": "API service",
      "hostname": "api.example.com",
      "document_root": "/var/www/api",
      "index_files": []
    }
  ]
}
