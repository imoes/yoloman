# ksmbd main configuration file
[global]
# NetBIOS name of the server
workgroup = {{ global.workgroup }}
# NetBIOS name (defaults to hostname if omitted)
netbios name = {{ global.netbios_name | default('') | trim }}
# Server description (appears in 'net view' etc.)
server string = {{ global.server_string | default('') | trim }}
# Logging level: 0 (none) to 10 (debug)
log level = {{ global.log_level | default(1) }}
# Path for log files (if using file logging)
log file = {{ global.log_file | default('/var/log/ksmbd/ksmbd.log') }}
# Max log file size (KB), 0 = no rotation
max log size = {{ global.max_log_size | default(1024) }}
# Enable/disable printing support
printing = {{ 'cups' if global.printing else 'bsd' }}
# Path to printcap (only relevant if printing = bsd)
printcap name = {{ global.printcap_name | default('/etc/printcap') }}
# Path to lpstat (for CUPS printing)
lpstat command = {{ global.lpstat_command | default('lpstat') }}
# Path to lpr command
lpr command = {{ global.lpr_command | default('lpr') }}
# Path to lpq command
lpq command = {{ global.lpq_command | default('lpq') }}
# Path to lprm command
lprm command = {{ global.lprm_command | default('lprm') }}
# SMB protocol versions to enable
# Supported: SMB2, SMB3, SMB3.0, SMB3.0.2, SMB3.1.1
{% if global.protocols %}
server min protocol = {{ global.protocols.min | default('SMB2') }}
server max protocol = {{ global.protocols.max | default('SMB3.1.1') }}
{% else %}
server min protocol = SMB2
server max protocol = SMB3.1.1
{% endif %}
# Authentication backend
guest account = {{ global.guest_account | default('nobody') }}
# Enable/disable map to guest
guest ok = {{ 'yes' if global.guest_ok else 'no' }}
map to guest = {{ global.map_to_guest | default('Bad User') }}
# User mapping file (for Unix to SMB SID mapping)
username map = {{ global.username_map | default('/etc/ksmbd/smbusers') }}
# Password backend: tdbsam, ldapsam, smbpasswd, passdb
passdb backend = {{ global.passdb_backend | default('tdbsam') }}
# LDAP configuration (only if passdb_backend = ldapsam)
{% if global.passdb_backend == 'ldapsam' %}
ldap suffix = {{ global.ldap.suffix }}
ldap admin dn = {{ global.ldap.admin_dn | default('') }}
ldap admin password = {{ global.ldap.admin_password | default('') }}
ldap user suffix = {{ global.ldap.user_suffix | default('') }}
ldap group suffix = {{ global.ldap.group_suffix | default('') }}
ldap machine suffix = {{ global.ldap.machine_suffix | default('') }}
ldap ssl = {{ global.ldap.ssl | default('off') }}
ldap tls_cacertdir = {{ global.ldap.tls_cacertdir | default('') }}
{% endif %}
# Kerberos configuration
# For domain-joined hosts with SPN in keytab
{% if global.kerberos.enabled %}
kerberos method = {{ global.kerberos.method | default('secrets and keytab') }}
smartcard security = {{ 'yes' if global.kerberos.smartcard_security else 'no' }}
smartcard removal action = {{ global.kerberos.removal_action | default('kill') }}
{% endif %}
# Security model: user, domain, ads, share
security = {{ global.security | default('user') }}
# If security = ads (Active Directory Domain Services)
{% if global.security == 'ads' %}
domain logons = yes
realm = {{ global.realm }}
{% if global.kerberos.enabled %}
kerberos method = secrets and keytab
{% endif %}
{% endif %}
# Winbind configuration (for domain users/groups)
winbind enum users = {{ 'yes' if global.winbind_enum_users else 'no' }}
winbind enum groups = {{ 'yes' if global.winbind_enum_groups else 'no' }}
winbind nss info = {{ global.winbind_nss_info | default('template') }}
winbind trusted domains only = {{ 'yes' if global.winbind_trusted_domains_only else 'no' }}
winbind use default domain = {{ 'yes' if global.winbind_use_default_domain else 'no' }}
# Socket options for performance tuning
socket options = {{ global.socket_options | default('TCP_NODELAY IPTOS_LOWDELAY') }}
# Maximum concurrent connections
max connections = {{ global.max_connections | default(0) }}
# Interface binding (empty = all interfaces)
{% if global.interfaces %}
bind interfaces only = yes
interfaces = {% for iface in global.interfaces %}{{ iface }}{% if not loop.last %} {% endif %}{% endfor %}
{% else %}
bind interfaces only = no
{% endif %}
# Listen addresses (IP:port format); defaults to all IPv4/IPv6
{% if global.listen_addresses %}
{% for addr in global.listen_addresses %}
# Listen on specific address
{% if addr.port %}
{{ addr.ip }}:{{ addr.port }}
{% else %}
{{ addr.ip }}
{% endif %}
{% endfor %}
{% else %}
# Listen on all interfaces and ports
{% endif %}
# SMB ports (default 445, legacy 139)
{% if global.ports.smb139 %}
# Enable legacy SMB1 port
smb ports = 139 445
{% else %}
# Default: SMB2/3 only on port 445
smb ports = 445
{% endif %}

# Per-share configuration blocks
{% for share in shares %}[{{ share.name }}]
# Share description
comment = {{ share.comment | default('') | trim }}
# Path on the filesystem
path = {{ share.path }}
# Access control: read-only or read-write
read only = {{ 'yes' if share.readonly else 'no' }}
# Default file permissions (octal)
create mask = {{ share.create_mask | default('0644') }}
# Default directory permissions (octal)
directory mask = {{ share.directory_mask | default('0755') }}
# Force user/group ownership (optional)
{% if share.force_user %}
force user = {{ share.force_user }}
{% endif %}
{% if share.force_group %}
force group = {{ share.force_group }}
{% endif %}
# Guest access policy
{% if share.guest_ok %}
guest ok = yes
map to guest = Bad User
{% else %}
guest ok = no
{% endif %}
# browsable = yes/no — visible in 'net view'
browsable = {{ 'yes' if share.browsable else 'no' }}
# hide unreadable files (based on ACLs/file perms)
hide unreadable = {{ 'yes' if share.hide_unreadable else 'no' }}
# Case sensitivity (for case-sensitive filesystems)
case sensitive = {{ 'yes' if share.case_sensitive else 'auto' }}
# VFS modules (for auditing, recycle, etc.)
{% if share.vfs_modules %}
vfs objects = {% for mod in share.vfs_modules %}{{ mod }}{% if not loop.last %} {% endif %}{% endfor %}
{% endif %}
# Per-VFS module options — flattened as key=value pairs
{% for mod, opts in share.vfs_options.items() %}
{% for key, val in opts.items() %}
{{ mod }}:{{ key }} = {{ val }}
{% endfor %}
{% endfor %}
# Allow/disallow specific users or groups
{% if share.valid_users %}
valid users = {% for user in share.valid_users %}{{ user }}{% if not loop.last %} {% endif %}{% endfor %}
{% endif %}
{% if share.invalid_users %}
invalid users = {% for user in share.invalid_users %}{{ user }}{% if not loop.last %} {% endif %}{% endfor %}
{% endif %}
{% if share.write_list %}
write list = {% for user in share.write_list %}{{ user }}{% if not loop.last %} {% endif %}{% endfor %}
{% endif %}
{% if share.read_list %}
read list = {% for user in share.read_list %}{{ user }}{% if not loop.last %} {% endif %}{% endfor %}
{% endif %}
# Locking behavior
locking = {{ 'yes' if share.locking else 'no' }}
# Blocking locks (advisory or mandatory)
strict locking = {{ 'yes' if share.strict_locking else 'no' }}
#Oplocks: enable/disable opportunistic locking
oplocks = {{ 'yes' if share.oplocks else 'no' }}
level2 oplocks = {{ 'yes' if share.level2_oplocks else 'no' }}
# Caching and streaming (for macOS compatibility)
kernel oplocks = {{ 'yes' if share.kernel_oplocks else 'no' }}
{% if share.streams_xattr %}
ea support = yes
store dos attributes = yes
{% endif %}
# NT ACL support (requires 'vfs objects = acl_xattr' or similar)
{% if share.nt_acl_support %}
nt acl support = yes
nt acl display in sid = {{ 'yes' if share.nt_acl_display_in_sid else 'no' }}
{% else %}
nt acl support = no
{% endif %}
# Windows-specific features
{% if share.dos_filemode %}
dos filemode = yes
{% endif %}
# Recycle bin (if using 'recycle' VFS)
{% if share.vfs_modules and 'recycle' in share.vfs_modules %}
recycle:repository = {{ share.recycle.repository | default('.recycle') }}
recycle:versions = {{ 'yes' if share.recycle.versions else 'no' }}
recycle:keeptree = {{ 'yes' if share.recycle.keeptree else 'no' }}
recycle:touch = {{ 'yes' if share.recycle.touch else 'no' }}
recycle:exclude = {{ share.recycle.exclude | default('*.tmp,*.temp') }}
recycle:exclude_dir = {{ share.recycle.exclude_dir | default('tmp|temp') }}
{% endif %}
# Audit logging (if using 'audit' VFS)
{% if share.vfs_modules and 'audit' in share.vfs_modules %}
audit:fac = LOCAL0
{% endif %}
{% endfor %}