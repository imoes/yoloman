{
  "physical_interface_mappings": [
    "physnet1:eth1",
    "physnet2:eth2"
  ],
  "vni_ranges": [
    "1000:2000"
  ],
  "enable_vxlan": true,
  "vxlan_ttl": 64,
  "arp_responder": true,
  "vxlan_local_ip": "10.0.0.5",
  "tenant_network_types": [
    "flat",
    "vlan",
    "vxlan"
  ],
  "bridge_mappings": [
    "physnet1:br-eth1",
    "physnet2:br-eth2"
  ],
  "enable_security_group": true,
  "firewall_driver": "neutron.agent.linux.iptables_firewall.IptablesFirewallDriver",
  "enable_dhcp_options": true,
  "min_agent_rounds": 3,
  "polling_interval": 2,
  "registration_delay": 2
}
