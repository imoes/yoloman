#!/bin/sh

# ==============================================================================
# QEMU Guest Agent (qga) Filesystem Freeze Hook Script
# ==============================================================================
#
# This script is executed when a guest agent receives fsfreeze-freeze and
# fsfreeze-thaw commands. It is triggered either via the --fsfreeze-hook (-F)
# option of qemu-ga or by placing this script in the default path
# (/etc/qemu/fsfreeze-hook).
#
# Execution Context:
# - On "freeze": Issued before the filesystem is frozen.
# - On "thaw": Issued after the filesystem is thawed.
#
# Behavior:
# 1. Checks if a custom log file is writable. If not, falls back to syslog.
# 2. Iterates through executable scripts in the hook directory (fsfreeze-hook.d).
# 3. Executes each hook script, logging output or sending it to syslog.
# 4. Reports exit statuses of hook scripts.
# ==============================================================================

# -------------------------------------------------------------------------
# Log file configuration
# -------------------------------------------------------------------------
# Path to the log file for the fsfreeze hook script.
# Default: /var/log/qga-fsfreeze-hook.log
# If this file is not writable, the script will fallback to using syslog.
LOGFILE={{ log_file | default('/var/log/qga-fsfreeze-hook.log') }}

# Directory containing additional hook scripts to be executed.
# Scripts in this directory are executed in alphabetical order.
FSFREEZE_D=$(dirname -- "$0")/fsfreeze-hook.d

# -------------------------------------------------------------------------
# Helper: File Ignore Check
# -------------------------------------------------------------------------
# Check whether file $1 is a backup or rpm-generated file and should be ignored.
# Returns 0 if the file should be ignored, 1 otherwise.
is_ignored_file() {
    case "$1" in
        *~ | *.bak | *.orig | *.rpmnew | *.rpmorig | *.rpmsave | *.sample | *.dpkg-old | *.dpkg-new | *.dpkg-tmp | *.dpkg-dist | *.dpkg-bak | *.dpkg-backup | *.dpkg-remove)
            return 0 ;;
    esac
    return 1
}

# -------------------------------------------------------------------------
# Logging Configuration & Fallback Logic
# -------------------------------------------------------------------------
# Flag to determine whether to use syslog instead of the log file.
# Initialized to 0 (use log file).
USE_SYSLOG=0

# Check if the log file exists but is not writable; fallback to syslog.
[ -e "$LOGFILE" ] && [ ! -w "$LOGFILE" ] && USE_SYSLOG=1

# Try to touch (create/update) the log file to test writability.
# If this fails, fallback to syslog.
touch "$LOGFILE" >/dev/null 2>&1 || USE_SYSLOG=1

# -------------------------------------------------------------------------
# Helper: Log Message
# -------------------------------------------------------------------------
# Logs a message either to the LOGFILE or via syslog (logger command),
# depending on the USE_SYSLOG flag.
log_message() {
    if [ "$USE_SYSLOG" -eq 0 ]; then
        printf "%s: %s\n" "$(date)" "$1" >>"$LOGFILE"
    else
        logger -t qemu-ga-freeze-hook "$1"
    fi
}

# -------------------------------------------------------------------------
# Hook Execution Loop
# -------------------------------------------------------------------------
# Exit immediately if the hook directory does not exist.
[ ! -d "$FSFREEZE_D" ] && exit 0

# Iterate through all files in the fsfreeze-hook.d directory.
for file in "$FSFREEZE_D"/* ; do
    # Skip ignored backup/old files.
    is_ignored_file "$file" && continue
    
    # Skip files that are not executable.
    [ -x "$file" ] || continue

    # Log the execution start.
    log_message "Executing $file $*"
    
    if [ "$USE_SYSLOG" -eq 0 ]; then
        # Standard logging: redirect stdout/stderr to log file.
        "$file" "$@" >>"$LOGFILE" 2>&1
        STATUS=$?
    else
        # Syslog logging: pipe output to logger and capture exit status.
        # POSIX-compliant trick to capture the exit status of the left side
        # of a pipe, since PIPESTATUS is a bashism.
        # Equivalent to: "$file" "$@" 2>&1 | logger -t qemu-ga-freeze-hook
        { { { {
                "$file" "$@" 2>&1 3>&- 4>&-
                echo $? >&3
            } | logger -t qemu-ga-freeze-hook >&4
            } 3>&1
          } | { read -r xs ; exit "$xs"; }
        } 4>&1
        STATUS=$?
    fi

    # Log the result of the hook execution.
    if [ "$STATUS" -ne 0 ]; then
        log_message "Error: $file finished with status=$STATUS"
    else
        log_message "$file finished successfully"
    fi
done

exit 0
