{
  "provides": {
    "type": "string",
    "default": "qemu-guest-agent",
    "description": "The service name provided by this init script."
  },
  "required_start": {
    "type": "string",
    "default": "$remote_fs $syslog",
    "description": "Init script dependencies for start."
  },
  "required_stop": {
    "type": "string",
    "default": "$remote_fs $syslog",
    "description": "Init script dependencies for stop."
  },
  "default_start": {
    "type": "string",
    "default": "2 3 4 5",
    "description": "Runlevels for starting the service."
  },
  "default_stop": {
    "type": "string",
    "default": "0 1 6",
    "description": "Runlevels for stopping the service."
  },
  "short_description": {
    "type": "string",
    "default": "QEMU Guest Agent startup script",
    "description": "Short description for LSB init info."
  },
  "description": {
    "type": "string",
    "default": "Start the QEMU Guest Agent if we're running in a QEMU virtual machine",
    "description": "Long description for LSB init info."
  },
  "author": {
    "type": "string",
    "default": "Michael Tokarev <mjt@tls.msk.ru>",
    "description": "Author of the init script."
  },
  "desc": {
    "type": "string",
    "default": "QEMU Guest Agent",
    "description": "Description variable used by the script."
  },
  "name": {
    "type": "string",
    "default": "qemu-ga",
    "description": "Name of the daemon."
  },
  "transport": {
    "type": "string",
    "default": "virtio-serial:/dev/virtio-ports/org.qemu.guest_agent.0",
    "description": "Default transport method and path for the guest agent."
  }
}
