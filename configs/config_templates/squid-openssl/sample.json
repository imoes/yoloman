{
  "http_port": 8080,
  "icp_port": 0,
  "cache_type": "ufs",
  "cache_dir_path": "/var/spool/squid",
  "cache_size": 2048,
  "level1": 16,
  "level2": 256,
  "maximum_object_size_kb": 5120,
  "pid_filename": "/run/squid/squid.pid",
  "access_log_path": "/var/log/squid/access.log",
  "error_directory": "/usr/share/squid/errors/en",
  "cache_mgr_email": "sysadmin@internal.net",
  "visible_hostname": "squid-proxy.internal.net",
  "localnet_cidrs": [
    "192.168.1.0/24",
    "10.10.0.0/16"
  ],
  "sslcrtd_program": "/usr/lib/squid/ssl_crtd",
  "sslcrtd_children": 16,
  "sslcrtd_timeout": 2,
  "tls_outgoing_options": "SNI=on",
  "auth_basic_program": "/usr/lib/squid/basic_pam_auth",
  "auth_basic_children": 10,
  "auth_basic_realm": "Internal Proxy Login",
  "auth_basic_credentialsttl": 2
}
