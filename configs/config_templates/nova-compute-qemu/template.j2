[DEFAULT]
# The compute driver to use for managing instances.
# Default: libvirt.LibvirtDriver
compute_driver = {{ compute_driver | default('libvirt.LibvirtDriver') }}

[libvirt]
# The virtualization type used by libvirt (e.g., qemu, kvm).
# Default: qemu
virt_type = {{ virt_type | default('qemu') }}