{
  "general": {
    "db_path": "/var/lib/mpd/tag_cache",
    "log_file": "/var/log/mpd/mpd.log",
    "pid_file": "/var/run/mpd/mpd.pid",
    "state_file": "/var/lib/mpd/state",
    "sticker_file": "/var/lib/mpd/sticker.sql",
    "log_level": "default",
    "user": "mpd",
    "group": "audio",
    "bind_to_address": "0.0.0.0",
    "port": 6600,
    "timeout": 10,
    "max_connections": 20,
    "music_directory": "/music",
    "playlist_directory": "/music/playlists",
    "db_directory": "/var/lib/mpd",
    "sticker_directory": "/var/lib/mpd",
    "file_encoding": "utf-8",
    "file_system_refresh_time": 60,
    "id3v1_encoding": "utf-8",
    "follow_fifo_order": false,
    "playlist_provider": "file",
    "database_plugin": "file",
    "volume_normalization": true,
    "audio_buffer_size": 4096,
    "buffer_before_play": 0.5
  },
  "audio_output": {
    "enabled": true,
    "type": "alsa",
    "name": "HDA Intel PCH",
    "device": "hw:0",
    "format": "44100:16:2",
    "auto_resample": false,
    "auto_format": true
  },
  "replay_gain": {
    "mode": "album",
    "preamp": 0,
    "default_gain": 0,
    "limit": 6
  },
  "album_art": {
    "max_width": 500,
    "max_height": 500,
    "embed_art": true
  },
  "decoders": [
    {
      "plugin": "ffmpeg",
      "enabled": true,
      "priority": 100
    },
    {
      "plugin": "flac",
      "enabled": true,
      "priority": 90
    },
    {
      "plugin": "vorbis",
      "enabled": true,
      "priority": 80
    }
  ],
  "inputs": [
    {
      "plugin": "curl",
      "enabled": true
    },
    {
      "plugin": "sftp",
      "enabled": false
    }
  ],
  "filters": [
    {
      "plugin": "replay_gain",
      "enabled": true
    }
  ]
}
