# Music Player Daemon (MPD) configuration file
# See https://www.musicpd.org/doc/latest/config.html

# Audio output configuration
{% if audio_output.enabled %}
audio_output {
    type        "{{ audio_output.type }}"
    name        "{{ audio_output.name }}"
{% if audio_output.device is not none %}    device      "{{ audio_output.device }}"
{% endif %}{% if audio_output.format is not none %}    format      "{{ audio_output.format }}"
{% endif %}{% if audio_output.dmix_channels is not none %}    dmix_channels "{{ audio_output.dmix_channels }}"
{% endif %}{% if audio_output.samplerate is not none %}    samplerate  "{{ audio_output.samplerate }}"
{% endif %}{% if audio_output.bit_depth is not none %}    bit_depth   "{{ audio_output.bit_depth }}"
{% endif %}{% if audio_output.auto_resample is not none %}    auto_resample "{{ 'yes' if audio_output.auto_resample else 'no' }}"
{% endif %}{% if audio_output.auto_format is not none %}    auto_format   "{{ 'yes' if audio_output.auto_format else 'no' }}"
{% endif %}{% if audio_output.channels is not none %}    channels    "{{ audio_output.channels }}"
{% endif %}
}
{% endif %}

# General settings
{% if general.db_path is not none %}db_file           "{{ general.db_path }}"
{% endif %}{% if general.log_file is not none %}log_file          "{{ general.log_file }}"
{% endif %}{% if general.pid_file is not none %}pid_file          "{{ general.pid_file }}"
{% endif %}{% if general.state_file is not none %}state_file        "{{ general.state_file }}"
{% endif %}{% if general.sticker_file is not none %}sticker_file      "{{ general.sticker_file }}"
{% endif %}

# Logging configuration
{% if general.log_level is not none %}log_level         "{{ general.log_level }}"
{% endif %}{% if general.log_filter is not none %}log_filter        "{{ general.log_filter }}"
{% endif %}

# User & group
{% if general.user is not none %}user              "{{ general.user }}"
{% endif %}{% if general.group is not none %}group             "{{ general.group }}"
{% endif %}

# Network settings
{% if general.bind_to_address is not none %}bind_to_address   "{{ general.bind_to_address }}"
{% endif %}
{% if general.port is not none %}port              "{{ general.port }}"
{% endif %}
{% if general.timeout is not none %}timeout           "{{ general.timeout }}"
{% endif %}
{% if general.max_connections is not none %}max_connections   "{{ general.max_connections }}"
{% endif %}

# Password (optional, for client auth)
{% if general.password is not none %}password          "{{ general.password }}"
{% endif %}

# Replay Gain settings
{% if replay_gain.mode is not none %}replay_gain_mode  "{{ replay_gain.mode }}"
{% endif %}{% if replay_gain.preamp is not none %}replay_gain_preamp "{{ replay_gain.preamp }}"
{% endif %}{% if replay_gain.default_gain is not none %}replay_gain_default_gain "{{ replay_gain.default_gain }}"
{% endif %}{% if replay_gain.limit is not none %}replay_gain_limit "{{ replay_gain.limit }}"
{% endif %}

# Volume control range (0–100 by default)
{% if general.volume_normalization is not none %}volume_normalization  "{{ 'yes' if general.volume_normalization else 'no' }}"
{% endif %}{% if general.audio_buffer_size is not none %}audio_buffer_size "{{ general.audio_buffer_size }}"
{% endif %}

# Buffer settings
{% if general.buffer_before_play is not none %}buffer_before_play "{{ general.buffer_before_play }}"
{% endif %}

# File system settings
{% if general.music_directory is not none %}music_directory   "{{ general.music_directory }}"
{% endif %}{% if general.playlist_directory is not none %}playlist_directory "{{ general.playlist_directory }}"
{% endif %}{% if general.db_directory is not none %}db_directory      "{{ general.db_directory }}"
{% endif %}{% if general.sticker_directory is not none %}sticker_directory "{{ general.sticker_directory }}"
{% endif %}

# File encoding
{% if general.file_encoding is not none %}file_encoding     "{{ general.file_encoding }}"
{% endif %}

# Decoder plugins
{% for decoder in decoders %}decoder {
    plugin "{{ decoder.plugin }}"
{% if decoder.enabled is not none %}    enabled "{{ 'yes' if decoder.enabled else 'no' }}"
{% endif %}{% if decoder.priority is not none %}    priority "{{ decoder.priority }}"
{% endif %}
}
{% endfor %}

# Input plugins (e.g., for network streams)
{% for input in inputs %}input {
    plugin "{{ input.plugin }}"
{% if input.enabled is not none %}    enabled "{{ 'yes' if input.enabled else 'no' }}"
{% endif %}
}
{% endfor %}

# Audio filter plugins
{% for filter in filters %}audio_filter {
    plugin "{{ filter.plugin }}"
{% if filter.enabled is not none %}    enabled "{{ 'yes' if filter.enabled else 'no' }}"
{% endif %}
}
{% endfor %}

# File system watch
{% if general.file_system_refresh_time is not none %}filesystem_refresh_time "{{ general.file_system_refresh_time }}"
{% endif %}

# ID3v1 encoding fallback
{% if general.id3v1_encoding is not none %}id3v1_encoding    "{{ general.id3v1_encoding }}"
{% endif %}

# Album art settings
{% if album_art.max_width is not none %}album_art_max_width "{{ album_art.max_width }}"
{% endif %}{% if album_art.max_height is not none %}album_art_max_height "{{ album_art.max_height }}"
{% endif %}{% if album_art.embed_art is not none %}album_art_embed "{{ 'yes' if album_art.embed_art else 'no' }}"
{% endif %}

# Follow FIFO order
{% if general.follow_fifo_order is not none %}follow_fifo_order "{{ 'yes' if general.follow_fifo_order else 'no' }}"
{% endif %}

# Playlist provider
{% if general.playlist_provider is not none %}playlist_provider "{{ general.playlist_provider }}"
{% endif %}

# Database plugin (e.g., for remote DB)
{% if general.database_plugin is not none %}database_plugin "{{ general.database_plugin }}"
{% endif %}
