{
  "config_root": "/home/user/.config/direnv",
  "allow_file": "/home/user/.local/share/direnv/allow",
  "shell_integration_enabled": [
    "bash",
    "zsh",
    "fish"
  ],
  "fish_mode": "eval_after_arrow",
  "stdlib_path": [
    "/usr/share/direnv/stdlib.sh",
    "/home/user/.config/direnv/std.sh"
  ],
  "extra_lib_paths": [
    "/home/user/.config/direnv/lib"
  ],
  "log_level": "warn"
}
