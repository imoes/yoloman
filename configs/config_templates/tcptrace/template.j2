#!/usr/bin/env tcptrace
# Command-line arguments for tcptrace configuration
# This file is generated by Ansible from the tcptrace role.
# Do not edit manually; changes will be overwritten.

# output_dir: Directory where all output files are placed.
# Default is current directory.
# If left empty, tcptrace writes to the working directory.
{% if output_dir | default('') %}
--output_dir={{ output_dir | default('') }}
{% endif %}

# output_prefix: Prefix all output files with this string.
# Useful to distinguish outputs from different capture files.
{% if output_prefix | default('') %}
--output_prefix={{ output_prefix | default('') }}
{% endif %}

# xplot_title_prefix: Prefix to place in the titles of all xplot files.
# Helps identify the source of the generated graphs.
{% if xplot_title_prefix | default('') %}
--xplot_title_prefix={{ xplot_title_prefix | default('') }}
{% endif %}

# output_separator: Separator to use for long output.
# Supported values: csv, tsv. Leave empty to disable specific separator forcing.
{% if output_separator | default('') %}
--sv={{ output_separator | default('') }}
{% endif %}

# modules: List of modules to configure.
# Each module can be enabled or disabled, with optional parameters.
# Supported modules: http, tcplib, traffic, slice, rttgraph, collie, realtime.
{% for module in modules | default([]) %}
# Module-specific configuration for: {{ module.name | default('unknown') }}
{% if module.enabled | default(false) %}
--enable_{{ module.name | default('unknown') }}
{% else %}
--disable_{{ module.name | default('unknown') }}
{% endif %}
# Module options string
{% if module.options | default('') %}
{{ module.options | default('') }}
{% endif %}
{% endfor %}

# input_file: The tcpdump capture file or 'stdin' to analyze.
# This is the primary input for tcptrace.
{% if input_file | default('') %}
{{ input_file | default('') }}
{% endif %}