[# Monero daemon configuration file (monerod.conf)
# Generated by Jinja2 template engine]

# Bind to specific network interface(s) (IPv4/IPv6)
{{ bind_ip }}

# RPC server port
rpc-bind-port={{ rpc_bind_port }}

# P2P network port
p2p-bind-port={{ p2p_bind_port }}

# Maximum number of connections for incoming P2P peers
p2p-bind-max-connections={{ p2p_bind_max_connections }}

# Enable or disable RPC server
{{ 'no-rpc' if not rpc_enabled else '' }}

# Enable or disable P2P networking
{{ 'no-p2p' if not p2p_enabled else '' }}

# Data directory for blockchain and wallet storage
{{ 'data-dir=' + data_dir if data_dir else '' }}

# Log file path (empty = disable logging to file)
{{ 'log-file=' + log_file if log_file else '' }}

# Log level: 0 (info), 1 (debug), 2 (trace)
log-level={{ log_level }}

# Block target height (used for testing / pruning)
{{ 'target-block-height=' + str(target_block_height) if target_block_height else '' }}

# Enable or disable DNS seeding
{{ 'no-dns-seeding' if not dns_seeding else '' }}

# Explicit list of seed nodes to connect to (one per line)
{% for seed_node in seed_nodes %}
add-peer={{ seed_node }}
{% endfor %}

# Limit incoming/outgoing connections rate
{{ 'max-connections-per-ip=' + str(max_connections_per_ip) if max_connections_per_ip else '' }}

# Enable or disable pruning
{{ 'prune-blockchain' if prune_blockchain else '' }}

# Enable or disable limited functionality mode
{{ 'limited-rpc' if limited_rpc else '' }}

# Set maximum number of RPC workers
rpc-workers={{ rpc_workers }}

# Enable or disable automatic port mapping via UPnP
{{ 'upnp' if upnp else '' }}

# Set maximum number of incoming connections per block (for DoS mitigation)
{{ 'max-incoming-connections-per-block=' + str(max_incoming_connections_per_block) if max_incoming_connections_per_block else '' }}

# Set maximum number of blocks to cache in memory
{{ 'blocks-dir=' + blocks_dir if blocks_dir else '' }}

# Enable or disable testnet mode (if true, overrides network type)
{{ 'testnet' if network_type == 'testnet' else '' }}

# Enable or disable stagenet mode
{{ 'stagenet' if network_type == 'stagenet' else '' }}

# Enable or disable mainnet (default)
{{ '' if network_type == 'mainnet' else '' }}

# Set maximum number of peers to try when connecting
{{ 'peer-id-file=' + peer_id_file if peer_id_file else '' }}

# Disable or enable IPv6 support
{{ 'ipv6-enabled' if ipv6_enabled else 'no-ipv6' }}

# Set maximum number of threads for blockchain verification
{{ 'block-threads=' + str(block_threads) if block_threads else '' }}

# Set maximum number of threads for block verification during sync
{{ 'verify-threads=' + str(verify_threads) if verify_threads else '' }}

# Enable or disable remote node access (e.g., for public RPC)
{{ 'public-node' if public_node else '' }}

# Set allowed RPC method list (comma-separated); empty = all
{% if rpc_methods %}
rpc-allow cors=*,origins=*,methods={{ rpc_methods | join(',') }}
{% else %}
rpc-allow cors=*,origins=*,methods=*
{% endif %}

# Set CORS origin(s) for RPC
{% if rpc_cors_origins %}
rpc-allow cors=*,origins={{ rpc_cors_origins | join(',') }},methods={{ rpc_methods | join(',') if rpc_methods else '*' }}
{% endif %}

# Set rate limit (in requests per second) for RPC
{{ 'rpc-rate-limit=' + str(rpc_rate_limit) if rpc_rate_limit else '' }}

# Set maximum RPC request size (in bytes)
{{ 'rpc-max-request-size=' + str(rpc_max_request_size) if rpc_max_request_size else '' }}

# Set minimum free disk space to continue (in MB)
{{ 'free-space-min=' + str(free_space_min) if free_space_min else '' }}

# Enable or disable background mining (if enabled, also set `mining-threads`)
{% if background_mining %}
background-mining=1
mining-threads={{ mining_threads }}
{% endif %}

# Set trusted daemon for wallet (e.g., for public node use)
{% if trusted_daemon_url %}
trusted-daemon={{ trusted_daemon_url }}
{% endif %}

# Set daemon to use for wallet proxy mode (e.g., `http://127.0.0.1:18081`)
{% if daemon_url %}
daemon={{ daemon_url }}
{% endif %}

# Set daemon login (if needed)
{% if daemon_login %}
daemon-login={{ daemon_login }}
{% endif %}

# Set path to custom CA bundle for TLS verification
{{ 'trusted-ca-file=' + trusted_ca_file if trusted_ca_file else '' }}

# Enable or disable TLS for RPC
{% if rpc_enable_tls %}
rpc-enable-tls=1
{% else %}
rpc-enable-tls=0
{% endif %}

# Set path to TLS certificate and key (if TLS enabled)
{% if rpc_enable_tls %}
rpc-server-cert={{ rpc_tls_cert_path }}
rpc-server-cert-key={{ rpc_tls_key_path }}
{% endif %}

# Set max number of blocks to download at once (sync speed tuning)
{{ 'max-concurrency=' + str(max_concurrency) if max_concurrency else '' }}

# Set max number of blocks to buffer during sync
{{ 'block-download-max-size=' + str(block_download_max_size) if block_download_max_size else '' }}

# Set minimum number of blocks to keep before pruning
{{ 'prune-height=' + str(prune_height) if prune_height else '' }}

# Enable or disable block index (speeds up some queries)
{{ 'keep-blocks' if keep_blocks else '' }}

# Disable or enable peer time validation (for sync robustness)
{{ 'no-time-check' if no_time_check else '' }}

# Disable or enable strict sorting of peers
{{ 'no-strict-sort' if no_strict_sort else '' }}

# Enable or disable fast block sync (fast sync via checkpointing)
{% if fast_sync %}
fast-sync=1
{% else %}
fast-sync=0
{% endif %}

# Set number of seconds to wait before reconnection attempt
{{ 'peer-id-file=' + peer_id_file if peer_id_file else '' }}

# Set maximum number of peers to consider when selecting outbound connections
{{ 'out-peers=' + str(out_peers) if out_peers else '' }}

# Set maximum number of inbound connections allowed
{{ 'in-peers=' + str(in_peers) if in_peers else '' }}

# Enable or disable block download from trusted daemon
{% if trusted_daemon_url %}
trusted-daemon={{ trusted_daemon_url }}
{% endif %}

# Set custom configuration for block storage (e.g., `lmdb` or `flatfile`)
{{ 'blocks-storage=' + blocks_storage if blocks_storage else '' }}

# Set custom configuration for transaction storage
{{ 'txs-storage=' + txs_storage if txs_storage else '' }}

# Set custom configuration for wallet storage
{{ 'wallets-storage=' + wallets_storage if wallets_storage else '' }}

# Set custom configuration for log rotation (e.g., `size=100M,count=5`)
{{ 'log-rotate=' + log_rotate if log_rotate else '' }}

# Enable or disable verbose P2P logging
{{ 'p2p-debug' if p2p_debug else '' }}

# Enable or disable verbose RPC logging
{{ 'rpc-debug' if rpc_debug else '' }}

# Set custom path for peer database file
{{ 'peer-db=' + peer_db if peer_db else '' }}

# Set custom path for state file (e.g., for resuming sync)
{{ 'state-file=' + state_file if state_file else '' }}

# Set custom path for trusted public key file
{{ 'trusted-key-file=' + trusted_key_file if trusted_key_file else '' }}

# Set custom path for bootstrap node list
{{ 'bootstrap-file=' + bootstrap_file if bootstrap_file else '' }}

# Set custom path for trusted daemon public key
{{ 'trusted-daemon-pubkey=' + trusted_daemon_pubkey if trusted_daemon_pubkey else '' }}

# Set custom path for daemon PID file
{{ 'pidfile=' + pidfile if pidfile else '' }}
