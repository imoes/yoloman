{
  "pop3": {
    "port": 110,
    "ssl_port": 995,
    "ssl_start": true,
    "tls_cert": "/etc/courier/pop3d.pem",
    "tls_key": "/etc/courier/pop3d.pem",
    "max_daemons": 30,
    "cache_timeout": 60,
    "auth_modules": [
      "authmysql"
    ],
    "allow_plaintext_auth": false,
    "loglevel": 2,
    "require_starttls": true,
    "max_message_size_kb": 10240,
    "uidl_unique_prefix": "mail.example.com",
    "hostname": "pop.example.com"
  }
}
