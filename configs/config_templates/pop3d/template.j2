# Courier POP3 daemon configuration
# Listen address and port
PORT={{ pop3.port }}

# Use SSL/TLS
POP3DSSLSTART={{ pop3.ssl_start | lower }}
POP3DSSLPORT={{ pop3.ssl_port }}

# TLS certificate and key paths
SSLPORT={{ pop3.ssl_port }}
TLS_CERT={{ pop3.tls_cert }}
TLS_KEY={{ pop3.tls_key }}

# Maximum number of simultaneous connections
MAXDAEMONS={{ pop3.max_daemons }}

# Timeout settings (in seconds)
CACHETIMEOUT={{ pop3.cache_timeout }}

# Authentication method
AUTHMODULES="{{ pop3.auth_modules | join(' ') }}"
AUTHMODULES_ORIG="{{ pop3.auth_modules | join(' ') }}"

# Allow/disallow plaintext auth over non-SSL connections
AUTH_ALLOW_PLAINTEXT={{ pop3.allow_plaintext_auth | lower }}

# Logging verbosity
LOGLEVEL={{ pop3.loglevel }}

# Maildir path (if not using system-wide Maildir location)
# Leave empty to use default user Maildir
#MAILDIR={{ pop3.maildir }}

# Require client to issue STARTTLS before auth (if TLS enabled)
STARTTLS={{ pop3.require_starttls | lower }}

# Maximum message size (in KB); 0 = unlimited
MAXMESSAGESIZE={{ pop3.max_message_size_kb }}

# Enable/disable UIDL persistence
UIDL_UNIQUE_PREFIX={{ pop3.uidl_unique_prefix }}

# Hostname advertised in banner
HOSTNAME={{ pop3.hostname }}
