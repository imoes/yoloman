# telepathy-idle environment configuration
# This file defines environment variables for telepathy-idle.

# idle_logfile: The filename for debug output. Prepend '+' to append. Leave empty for stderr.
# Default: '' (empty, meaning stderr)
# Format: <filename> or +<filename>
IDLE_LOGFILE={{ idle_logfile | default("") }}

# idle_debug: Debug output type, e.g., 'all' for full debug.
# Default: 'all'
IDLE_DEBUG={{ idle_debug | default("all") }}