# Configuration for globus-gram-job-manager-sge-setup-poll
# This template generates the startup command/arguments for the Globus
# Grid Resource and Allocation Manager (GRAM) job manager, specifically
# configured to poll for jobs submitted to an SGE (Sun Grid Engine)
# compute resource manager.

# Command/Arguments to execute the job manager.
# sge_job_manager_bin is the path to the globus-job-manager binary.
# config_file is the path to the globus-gram-job-manager configuration file.
# -type sge specifies the job submission interface type as SGE.
# local_cred indicates local credential usage.
# stderr_log captures standard error output.

stderr_log,local_cred - {{ sge_job_manager_bin | default('/usr/sbin/globus-job-manager') }} -conf {{ config_file | default('/etc/globus/globus-gram-job-manager.conf') }} -type sge