{
  "base_dn": "dc=company,dc=local",
  "ldap_uri": "ldap://ldap.company.local:389",
  "admin_dn": "cn=admin,dc=company,dc=local",
  "admin_password": "",
  "hash_password": "SSHA",
  "default_shell": "/bin/bash",
  "default_home": "/home",
  "default_uid_start": 2000,
  "default_gid_start": 2000,
  "default_pwd_max_age": 90,
  "default_pwd_min_age": 1,
  "default_pwd_warn": 14,
  "default_inactivity": 30,
  "default_account_expire": "",
  "user_objectclass": "top person organizationalPerson inetOrgPerson posixAccount",
  "group_objectclass": "top posixGroup",
  "default_group": "employees",
  "ldapadd_bin": "/usr/bin/ldapadd",
  "ldapdelete_bin": "/usr/bin/ldapdelete",
  "ldapmodify_bin": "/usr/bin/ldapmodify",
  "ldappasswd_bin": "/usr/bin/ldappasswd",
  "ldapsearch_bin": "/usr/bin/ldapsearch",
  "ldapcompare_bin": "",
  "verbose": true,
  "debug": false,
  "ldap_opts": "-P 3",
  "admin_password_file": "/etc/ldapscripts/admin.pass",
  "starttls": true,
  "ca_cert_file": "/etc/ssl/certs/ca-ldap.pem",
  "client_cert_file": "/etc/ssl/certs/ldap-client.pem",
  "client_key_file": "/etc/ssl/private/ldap-client.key",
  "group_mappings": [
    {
      "cn": "sudo",
      "gid": 1001,
      "member_attr": "member"
    },
    {
      "cn": "dialout",
      "gid": 1002,
      "member_attr": "memberUid"
    }
  ]
}
