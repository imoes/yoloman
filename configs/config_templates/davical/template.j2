# DAViCal Apache Virtual Host / Directory Configuration Template
#
# This template generates the necessary Apache directives to serve the DAViCal
# Calendar and Address Book server. It handles the document root, security headers,
# and URL rewriting for CalDAV/CardDAV endpoints.

# Document root path for the DAViCal web application.
Alias /davical {{ davical_htdocs_path | default('/usr/share/davical/htdocs') }}

# Configuration block for the DAViCal document root directory.
# This block enforces access permissions and PHP settings for the application files.
<Directory {{ davical_htdocs_path | default('/usr/share/davical/htdocs') }}>
  # DirectoryIndex: Specifies the default file to serve when a directory is requested.
  DirectoryIndex index.php

  # AllowOverride: Disables .htaccess processing for performance and security.
  # Directives must be set in the main configuration (here).
  AllowOverride None

  # Access Control (Apache 2.4+):
  # Grants access to all clients by default.
  # For Apache < 2.4, use 'Order allow,deny' and 'Allow from all'.
  Require all granted

  # PHP Settings (Optional/Advanced):
  # The following are commented out as they are typically handled by the PHP module
  # configuration or the application's internal setup. Uncomment only if necessary.

  # AcceptPathInfo: Allows path info to be passed to the script (e.g., /caldav.php/resource).
  #AcceptPathInfo On

  # PHP Include Path: Adds the AWL (Avram Lubin's Library) include directory.
  #php_value include_path /usr/share/php/awl/inc

  # Legacy PHP Security Settings (PHP 5.x era, mostly obsolete but kept for reference):
  #php_value magic_quotes_gpc 0
  #php_value register_globals 0
  #php_value error_reporting "E_ALL & ~E_NOTICE"
  #php_value default_charset "utf-8"

  # open_basedir: Restricts PHP file access to specific directories.
  # Uncomment to restrict access to the application directories only.
  #php_admin_value open_basedir /usr/share/awl/inc/:{{ davical_htdocs_path | default('/usr/share/davical/htdocs') }}/:{{ davical_etc_path | default('/etc/davical') }}/

</Directory>

# Apache mod_rewrite Module:
# Enables URL rewriting for CalDAV/CardDAV well-known URIs and principal paths.
# This allows clients to discover calendars and address books via standard WebDAV discovery mechanisms.
<IfModule mod_rewrite.c>
  # Enable the rewriting engine.
  RewriteEngine On

  # WebDAV Discovery:
  # Redirect /.well-known URLs to the DAViCal CalDAV/CardDAV endpoint.
  # This allows clients to find the calendar server automatically.
  # PT (Passthrough) is important if using an alias, as it implies L (Last).
  RewriteRule ^/\.well-known/(.*)$ /davical/caldav.php/.well-known/$1 [NC,PT]

  # Principal Paths:
  # Redirect user and resource principal requests to the CalDAV script.
  RewriteRule ^/principals/users/(.*)$ /davical/caldav.php/$1 [NC,PT]
  RewriteRule ^/principals/resources/(.*)$ /davical/caldav.php/$1 [NC,PT]

  # Standard User Paths:
  # Redirect standard calendar and address book UUID paths to the CalDAV script.
  RewriteRule ^/calendars/__uids__/(.*)$ /davical/caldav.php/$1 [NC,PT]
  RewriteRule ^/addressbooks/__uids__/(.*)$ /davical/caldav.php/$1 [NC,PT]

  # Optional: Root Directory Rewrite
  # If you wish to host DAViCal at the domain root (e.g., http://example.com/)
  # instead of /davical/, uncomment the following lines.
  # NOTE: This may interfere with other applications if DAViCal is not the only app.
  #
  # RewriteCond %{REQUEST_URI} !^/$
  # RewriteCond %{REQUEST_URI} !^/davical/$
  # RewriteCond %{REQUEST_URI} !\.(php|html|css|js|png|gif|jpg|ico)
  # RewriteRule ^(.*)$ /davical/caldav.php$1  [NC,L]

</IfModule>

# Security Headers:
# Apply Content-Security-Policy (CSP) headers to specific DAViCal PHP scripts.
# This restricts where content can be loaded from, mitigating XSS and data injection risks.
<FilesMatch "(admin|help|iSchedule|index|metrics|public|setup|tools|upgrade).php">
  # CSP Directive:
  # - default-src 'none': Block all content by default.
  # - img-src/media-src/script-src/style-src/font-src: Allow self-sourced content.
  # - 'unsafe-inline': Required for some inline styles/scripts in the UI.
  # - connect-src: Allow AJAX/WebDAV requests to self and specific payment gateways (if used).
  # - form-action: Restrict form submissions.
  # - frame-ancestors: Prevent embedding in iframes (Clickjacking protection).
  Header set Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' data:; font-src 'self' data:; object-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self' sis.redsys.es; frame-ancestors 'self'"
</FilesMatch>