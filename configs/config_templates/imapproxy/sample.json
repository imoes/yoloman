{
  "listen_address": "127.0.0.1",
  "listen_port": 143,
  "backends": [
    {
      "host": "imap1.example.com",
      "port": 143,
      "weight": 2
    },
    {
      "host": "imap2.example.com",
      "port": 143,
      "weight": 1
    }
  ],
  "ssl_enabled": true,
  "ssl_cert_file": "/etc/ssl/certs/imapproxy.example.com.crt",
  "ssl_key_file": "/etc/ssl/private/imapproxy.example.com.key",
  "cache_size": 10000,
  "connection_cache_ttl": 600,
  "max_client_connections": 500,
  "log_level": "info",
  "log_facility": "mail",
  "chroot": "/var/chroot/imapproxy",
  "user": "imapproxy",
  "group": "imapproxy",
  "client_idle_timeout": 120,
  "backend_idle_timeout": 900,
  "enable_pipeline": true
}
