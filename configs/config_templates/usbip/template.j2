# usbipd configuration file (usbip daemon)
# Generated by Ansible Jinja2 template
# See usbipd(8) man page for detailed documentation

# -----------------------------------------------------------------------------
# Network / Listening Configuration
# -----------------------------------------------------------------------------

# The TCP port number on which the USB/IP server listens for client connections.
# Default: 3240
# Format: integer
tcp_port={{ tcp_port | default(3240) }}

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# If true, logs messages to the system syslog instead of stderr.
# Default: false
# Format: boolean (true/false)
log_to_syslog={{ log_to_syslog | default(false) | lower }}

# If true, enables verbose debug logging.
# Default: false
# Format: boolean (true/false)
debug={{ debug | default(false) | lower }}

# -----------------------------------------------------------------------------
# Auto-Bind Configuration
# -----------------------------------------------------------------------------

# List of USB bus IDs (e.g., '1-1') to automatically bind to the usbip-host
# driver and make available for export.
# These devices will be made exportable without manual intervention.
# Format: comma-separated string of bus IDs (e.g., "1-1,1-2")
# If empty, no devices are auto-bound.
auto_bind_busids={{ auto_bind_busids | default([]) | join(',') }}