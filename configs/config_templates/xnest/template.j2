#!/bin/bash
# Wrapper script to start Xnest with configured parameters.
# This file acts as the configuration entry point for the service.
# Generated by Ansible. Do not edit manually.

# Execute Xnest with the specified arguments.
Xnest \
# The display name of the real server that Xnest should connect to.
# If empty, the DISPLAY environment variable is used.
{% if display | default('') | trim != '' %}
    -display {{ display | default('') }} \
{% endif %}
# Synchronize window and graphics operations with the real server for debugging.
{% if sync | default(False) | bool %}
    -sync \
{% endif %}
# Utilize full regeneration of real server objects and reopen a new connection upon regeneration.
{% if full | default(False) | bool %}
    -full \
{% endif %}
# Default visual class of the nested server (StaticGray, GrayScale, StaticColor, PseudoColor, TrueColor, DirectColor).
{% if visual_class | default('TrueColor') | trim != '' %}
    -class {{ visual_class | default('TrueColor') }} \
{% endif %}
# Default visual depth of the nested server.
{% if depth | default(0) != 0 %}
    -depth {{ depth | default(0) }} \
{% endif %}
# Use the software screen saver instead of the hardware screen saver.
{% if software_screensaver | default(False) | bool %}
    -sss \
{% endif %}
# Geometry parameters for the top-level window (e.g., 800x600+10+10).
{% if geometry | default('') | trim != '' %}
    -geometry {{ geometry | default('') }} \
{% endif %}
# Border width of the top-level Xnest window.
{% if border_width | default(1) != 1 %}
    -bw {{ border_width | default(1) }} \
{% endif %}
# Name of the top-level Xnest window.
{% if name | default('') | trim != '' %}
    -name {{ name | default('') }} \
{% endif %}
# Number of screens to create in the nested server.
{% if num_screens | default(1) != 1 %}
    -scrns {{ num_screens | default(1) }} \
{% endif %}
# Do direct color map installation by bypassing the real window manager.
{% if install_colormap | default(False) | bool %}
    -install \
{% endif %}
# Window ID to use as the root window instead of creating a new one.
{% if parent_window | default('') | trim != '' %}
    -parent {{ parent_window | default('') }} \
{% endif %}
# The final display number argument passed to Xnest (e.g., ':1').
# Must be set if display is not explicitly passed via -display.
{{ display_name_arg | default('') }}