# UML Switch Configuration
#
# This file configures `uml_switch`, a userspace Ethernet switch for User Mode Linux (UML).
# It controls whether the service starts, how it is invoked, under which user, and where its
# control socket resides.
#

# Start uml_switch with SysV/init scripts?
# Default: false (disabled)
UML_SWITCH_START="{{ uml_switch_start | default('false') }}"

# Options to pass to uml_switch (e.g., tap setup configurations, socket arguments).
# Default: empty string
UML_SWITCH_OPTIONS="{{ uml_switch_options | default('') }}"

# User account under which uml_switch runs.
# Default: 'uml-net'
UML_SWITCH_USER="{{ uml_switch_user | default('uml-net') }}"

# Path to the control socket file for uml_switch.
# Default: /var/run/uml-utilities/uml_switch.ctl
UML_SWITCH_CTL="{{ uml_switch_ctl | default('/var/run/uml-utilities/uml_switch.ctl') }}"