# Peony File Manager Configuration
# See peony(1) for command-line options. Configuration is typically handled via GSettings/dconf in the UKUI environment.
# This template is self-documenting: every setting is described above its directive.

[Settings]

# Whether to display the Peony tray icon in the system status area.
# Type: boolean
# Default: false
ShowTrayIcon={{ show_tray_icon | default(false) }}

# The default view mode for directories.
# Common values: 'icon', 'list', 'compact'
# Type: string
# Default: 'icon'
DefaultViewMode={{ default_view_mode | default('icon') }}

# Whether to show hidden files (files starting with a dot) by default.
# Type: boolean
# Default: false
ShowHiddenFiles={{ show_hidden_files | default(false) }}

# Whether to prompt for confirmation before deleting files.
# Type: boolean
# Default: true
ConfirmDelete={{ confirm_delete | default(true) }}

# Whether to move deleted files to the trash instead of permanently deleting them.
# Type: boolean
# Default: true
UseTrash={{ use_trash | default(true) }}

# Whether to show the sidebar with locations and bookmarks by default.
# Type: boolean
# Default: true
ShowSidebar={{ show_sidebar | default(true) }}

# List of Peony plugin names to load.
# These should match the .so filenames in the plugins directory.
# Type: list of strings
# Default: empty list (no plugins)
# Note: The list is joined by commas for the configuration file format.
{% if plugins | default([]) | length > 0 %}
Plugins={{ plugins | default([]) | join(',') }}
{% endif %}