# Path to the main apt-file configuration file, relative to Dir::Etc.
Dir::Etc::apt-file-main "{{ apt_file_main_config | default('apt-file.conf') }}";

# Default for -I/--index-names (comma-separated)
# Specifies which index name types to search by default (e.g., 'deb', 'udeb', 'source').
apt-file::Index-Names "{{ apt_file_index_names | default('deb') }}";

# Set to true, if you are working with Contents files generated by
# older versions of dak or reprepro (<< 5.2.0-1~) that includes a
# descriptive header.
apt-file::Parser::Check-For-Description-Header "{{ apt_file_parser_check_description_header | default(false) }}";