# ==============================================================================
# apt-file configuration template
#
# This file configures how apt-file searches package indices.
# It is primarily used internally by apt-file to locate and download
# Contents files.
#
# Configuration fields:
#   - Dir::Etc::apt-file-main: Path to the main configuration file.
#   - apt-file::Index-Names: Default index types to search (deb, udeb, dsc).
#   - apt-file::Parser::Check-For-Description-Header: Validate header in older Contents files.
# ==============================================================================

# Path to the main apt-file configuration file, relative to Dir::Etc.
# Default: apt-file.conf
Dir::Etc::apt-file-main "{{ (apt_file_main_config | default('apt-file.conf')) | string }}";

# Comma-separated list of index name types to search by default
# (e.g., 'deb', 'udeb', 'source').
# Valid values typically include 'deb', 'dsc', 'udeb'.
# Default: deb
apt-file::Index-Names "{{ (apt_file_index_names | default('deb')) | string }}";

# Whether to expect and validate a description header in Contents files.
# Set to 'true' for older dak/reprepro output (<< 5.2.0-1~).
# Default: false
apt-file::Parser::Check-For-Description-Header "{{ (apt_file_parser_check_description_header | default('false')) | string }}";

## This file is provided by apt-file(1) to download Contents
## files, which is used by apt-file for searching.

# Configuration for downloading Contents files for deb packages.
Acquire::IndexTargets {
    deb::Contents-deb  {
        # Metadata key template for the index file.
        MetaKey "$(COMPONENT)/Contents-$(ARCHITECTURE)";
        # Short description displayed in output.
        ShortDescription "Contents-$(ARCHITECTURE)";
        # Detailed description of the content.
        Description "$(RELEASE)/$(COMPONENT) $(ARCHITECTURE) Contents (deb)";

        # Flat metadata key for simpler indexing.
        flatMetaKey "Contents-$(ARCHITECTURE)";
        # Flat description for simpler indexing.
        flatDescription "$(RELEASE) Contents (deb)";
        
        # Enable Partial Differential (PDiff) support.
        PDiffs "true";
        # Keep the file compressed on disk.
        KeepCompressed "true";
    };

    # Download Contents for source files if there is a deb-src
    # line
    deb-src::Contents-dsc  {
        MetaKey "$(COMPONENT)/Contents-source";
        ShortDescription "Contents-source";
        Description "$(RELEASE)/$(COMPONENT) source Contents (dsc)";

        flatMetaKey "Contents-source";
        flatDescription "$(RELEASE) Contents (dsc)";
        PDiffs "true";
        KeepCompressed "true";
        # Disabled by default as source contents are less commonly searched.
        DefaultEnabled "false";
    };

    # Configuration for downloading Contents files for
    # debian-installer packages (udebs).
    deb::Contents-udeb  {
        MetaKey "$(COMPONENT)/Contents-udeb-$(ARCHITECTURE)";
        ShortDescription "Contents-udeb-$(ARCHITECTURE)";
        Description "$(RELEASE)/$(COMPONENT) $(ARCHITECTURE) Contents (udeb)";

        flatMetaKey "Contents-udeb-$(ARCHITECTURE)";
        flatDescription "$(RELEASE) Contents (udeb)";
        KeepCompressed "true";
        PDiffs "true";
        # Disabled by default as udebs are niche.
        DefaultEnabled "false";
    };

    ### FALLBACKS
    # Fallback configuration for older index formats.
    deb::Contents-deb-legacy {
        MetaKey "Contents-$(ARCHITECTURE)";
        ShortDescription "Contents-$(ARCHITECTURE)";
        Description "$(RELEASE) $(ARCHITECTURE) Contents (deb)";

        PDiffs "true";
        KeepCompressed "true";
        Fallback-Of "Contents-deb";
        Identifier "Contents-deb";
    };
};
