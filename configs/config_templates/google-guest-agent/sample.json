{
  "enabled": true,
  "log_level": "INFO",
  "log_dir": "/var/log/google-guest-agent",
  "state_dir": "/var/lib/google-guest-agent",
  "daemons": [
    "guest-ssh",
    "guest-oslogin"
  ],
  "enable_scripts": true,
  "enable_oslogin": true,
  "enable_ssh_keys": true,
  "extra_args": "--metadata-server-url=https://metadata.google.internal",
  "metadata_server_url": "",
  "api_endpoint": "",
  "service_account_email": "",
  "watch_metadata_keys": [
    "guest-configs/scripts/update",
    "guest-configs/ssh-keys"
  ]
}
