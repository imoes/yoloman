{
  "enabled": true,
  "log_level": "INFO",
  "log_dir": "/var/log/google-guest-agent",
  "state_dir": "/var/lib/google-guest-agent",
  "daemons": [
    "guest-ssh",
    "guest-oslogin"
  ],
  "enable_scripts": true,
  "enable_oslogin": null,
  "enable_ssh_keys": null,
  "extra_args": "",
  "metadata_server_url": "",
  "api_endpoint": "",
  "service_account_email": "",
  "watch_metadata_keys": [],
  "groups": "adm,dip,docker,lxd,plugdev,video",
  "default_shell": "/bin/bash",
  "host_key_types": "ecdsa,ed25519,rsa",
  "deprovision_remove": false
}
