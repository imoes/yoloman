#!/bin/bash
# Generated by Ansible Jinja2 engine. Do not edit manually.

# Device file-system path containing the ext2/3/4 filesystem to process.
# Default: /dev/sda1
DEVICE="{{ device | default('/dev/sda1') }}"

# Fill value for empty blocks in decimal (0-255).
# 0 is standard zeroing; 255 (0xFF) may help SSDs.
# Default: 0
FILL_VALUE={{ fill_value | default(0) }}

# Enable verbose output showing block statistics.
# Default: false
VERBOSE={{ verbose | default(false) | lower }}

# Perform a dry run without modifying the file-system.
# Default: false
DRY_RUN={{ dry_run | default(false) | lower }}

# Ensure device is unmounted or mounted read-only before execution.
# zerofree will fail if the filesystem is mounted writable.

# Construct arguments for zerofree command.
# -n: dry run
# -v: verbose
# -f <value>: fill value

{% set args_list = [] %}
{% if dry_run | default(false) | bool %}
    {% set _ = args_list.append('-n') %}
{% endif %}
{% if verbose | default(false) | bool %}
    {% set _ = args_list.append('-v') %}
{% endif %}
{% set _ = args_list.append('-f') %}
{% set _ = args_list.append(fill_value | default(0) | string) %}

ARGS="{{ args_list | join(' ') }}"

exec zerofree $ARGS "{{ device | default('/dev/sda1') }}"