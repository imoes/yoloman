{
  "log_level": {
    "type": "number",
    "default": 1,
    "description": "Log level: 0=none, 1=minimal, 2=full"
  },
  "daemon": {
    "type": "number",
    "default": 1,
    "description": "Run as daemon (0=no, 1=yes)"
  },
  "dev": {
    "type": "string",
    "default": "/dev/video0",
    "description": "Device node for the webcam"
  },
  "width": {
    "type": "number",
    "default": 640,
    "description": "Width of the captured image"
  },
  "height": {
    "type": "number",
    "default": 480,
    "description": "Height of the captured image"
  },
  "format": {
    "type": "string",
    "default": "jpeg",
    "description": "Image format: jpeg or ppm"
  },
  "capture": {
    "type": "number",
    "default": 1,
    "description": "Number of images to take per capture cycle"
  },
  "interval": {
    "type": "number",
    "default": 60,
    "description": "Delay in seconds between captures"
  },
  "startdelay": {
    "type": "number",
    "default": 5,
    "description": "Delay in seconds before the first capture"
  },
  "localpath": {
    "type": "string",
    "default": "/var/www/webcam",
    "description": "Local directory where images are stored"
  },
  "ftp_host": {
    "type": "string",
    "default": "localhost",
    "description": "FTP server hostname"
  },
  "ftp_port": {
    "type": "number",
    "default": 21,
    "description": "FTP server port"
  },
  "ftp_user": {
    "type": "string",
    "default": "webcam",
    "description": "FTP username"
  },
  "ftp_pass": {
    "type": "string",
    "default": "webcam",
    "description": "FTP password"
  },
  "ftppath": {
    "type": "string",
    "default": "/webcam",
    "description": "Remote FTP path for uploads"
  },
  "ftp_passive": {
    "type": "number",
    "default": 1,
    "description": "Use passive FTP mode (0=no, 1=yes)"
  }
}
