# =============================================================================
# Budgie Desktop View Desktop Entry Configuration
# =============================================================================
# This template generates a `.desktop` file for the Budgie Desktop View application.
# It configures execution behavior, visibility, startup notifications, and GNOME autostart properties.
#
# Schema References:
#   exec_command         : The executable command (D-Bus name or binary path) to launch the application
#   try_exec_command     : Command used to check if the application is installed before launching
#   terminal             : Whether the application should be run in a terminal
#   no_display           : Whether to hide this entry from menus and launchers
#   startup_notify       : Whether to send startup notification events
#   startup_wm_class     : WM class to match for startup notification and taskbar association
#   gnome_autostart_notify : GNOME autostart: whether to send notify after startup
#   gnome_autostart_phase  : GNOME autostart phase (e.g., SessionInitialization, Desktop, Application)
#   gnome_autostart_startup_id : GNOME autostart unique startup ID
#   gnome_auto_restart   : GNOME autostart: whether to automatically restart the service if it exits unexpectedly
# =============================================================================

[Desktop Entry]

# Name of the application as displayed to the user.
# Note: This is hardcoded in the original template and not configurable via schema.
Name=Budgie Desktop View

# Short description of the application.
# Note: This is hardcoded in the original template and not configurable via schema.
Comment=Budgie Desktop Icon View

# Path to the icon file representing the application.
# Note: This is hardcoded in the original template and not configurable via schema.
Icon=user-desktop

# Type of the entry. Fixed for this application.
# Note: This is hardcoded in the original template and not configurable via schema.
Type=Application

# Categories this application belongs to.
# Note: This is hardcoded in the original template and not configurable via schema.
Categories=GNOME;GTK;System;Core;

# Only show in specific desktop environments.
# Note: This is hardcoded in the original template and not configurable via schema.
OnlyShowIn=Budgie;

# Executable command to launch the application.
# Default: 'org.buddiesofbudgie.budgie-desktop-view'
# Desc: The executable command (D-Bus name or binary path) to launch the application
Exec={{ exec_command | default('org.buddiesofbudgie.budgie-desktop-view') }}

# Command to verify if the application is installed.
# Default: 'org.buddiesofbudgie.budgie-desktop-view'
# Desc: Command used to check if the application is installed before launching
TryExec={{ try_exec_command | default('org.buddiesofbudgie.budgie-desktop-view') }}

# Whether to run the application in a terminal window.
# Default: 'false'
# Desc: Whether the application should be run in a terminal
Terminal={{ terminal | default('false') }}

# Whether to hide this entry from menus and launchers.
# Default: 'true'
# Desc: Whether to hide this entry from menus and launchers
NoDisplay={{ no_display | default('true') }}

# Whether to send startup notification events to the window manager.
# Default: 'false'
# Desc: Whether to send startup notification events
StartupNotify={{ startup_notify | default('false') }}

# The Window Manager class to associate with this application for taskbar/desktop integration.
# Default: 'org.buddiesofbudgie.budgie-desktop-view'
# Desc: WM class to match for startup notification and taskbar association
StartupWMClass={{ startup_wm_class | default('org.buddiesofbudgie.budgie-desktop-view') }}

# GNOME Autostart: Send a notification after the application starts.
# Default: 'false'
# Desc: GNOME autostart: whether to send notify after startup
X-GNOME-Autostart-Notify={{ gnome_autostart_notify | default('false') }}

# GNOME Autostart: The phase of the autostart process.
# Default: 'Application'
# Desc: GNOME autostart phase (e.g., SessionInitialization, Desktop, Application)
X-GNOME-Autostart-Phase={{ gnome_autostart_phase | default('Application') }}

# GNOME Autostart: Unique identifier for this startup session.
# Default: 'org.buddiesofbudgie.budgie-desktop-view'
# Desc: GNOME autostart unique startup ID
X-GNOME-Autostart-startup-id={{ gnome_autostart_startup_id | default('org.buddiesofbudgie.budgie-desktop-view') }}

# GNOME Autostart: Automatically restart the service if it crashes.
# Default: 'true'
# Desc: GNOME autostart: whether to automatically restart the service if it exits unexpectedly
X-GNOME-AutoRestart={{ gnome_auto_restart | default('true') }}
