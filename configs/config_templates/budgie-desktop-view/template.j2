[Desktop Entry]
# Desktop entry file name / human-readable display name of the application.
Name=Budgie Desktop View
# Short description or comment about the application.
Comment=Budgie Desktop Icon View
# Path to the application's icon file.
Icon=user-desktop
# The executable command (D-Bus name or binary path) to launch the application.
Exec={{ exec_command | default('org.buddiesofbudgie.budgie-desktop-view') }}
# Command used to check if the application is installed before launching.
TryExec={{ try_exec_command | default('org.buddiesofbudgie.budgie-desktop-view') }}
# Whether the application should be run in a terminal (true/false).
Terminal={{ terminal | default(false) | lower }}
# Desktop entry type; Application indicates a standard app.
Type=Application
# Semicolon-separated list of categories the application belongs to.
Categories=GNOME;GTK;System;Core;
# Whether to hide this entry from menus and launchers (true/false).
NoDisplay={{ no_display | default(true) | lower }}
# Whether to send startup notification events (true/false).
StartupNotify={{ startup_notify | default(false) | lower }}
# Semicolon-separated list of desktop environments where this entry is shown.
OnlyShowIn=Budgie;
# WM class to match for startup notification and taskbar association.
StartupWMClass={{ startup_wm_class | default('org.buddiesofbudgie.budgie-desktop-view') }}
# GNOME autostart: whether to send notify after startup (true/false).
X-GNOME-Autostart-Notify={{ gnome_autostart_notify | default(false) | lower }}
# GNOME autostart phase (e.g., SessionInitialization, Desktop, Application).
X-GNOME-Autostart-Phase={{ gnome_autostart_phase | default('Application') }}
# GNOME autostart unique startup ID.
X-GNOME-Autostart-startup-id={{ gnome_autostart_startup_id | default('org.buddiesofbudgie.budgie-desktop-view') }}
# GNOME autostart: whether to automatically restart the service if it exits unexpectedly (true/false).
X-GNOME-AutoRestart={{ gnome_auto_restart | default(true) | lower }}