# Yubico Authenticator (yubioath-desktop) Configuration
# Note: yubioath-desktop is a GUI application. It does not typically have a static system configuration file.
# The following represents a virtualized configuration structure for managing application preferences
# such as logging, which can be passed via command-line arguments or stored in user-specific state.

# Application Logging Level
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Specifies the verbosity level for application logs.
log_level: {{ log_level | default('INFO') }}

# Application Logging File
# Path to the file where logs should be written. If empty, logs are printed to standard output.
# Ensures log output is directed to a persistent file rather than the console.
log_file: {{ log_file | default('') }}

# Interface Preferences
# List of available UI themes for the desktop application.
# The original list is joined into a comma-separated string for configuration readability.
ui_themes: {{ ui_themes | default(['dark', 'light']) | join(', ') }}

# Auto-start on login
# Whether the application should start automatically upon login.
# Controls the desktop session integration for autostart.
auto_start_enabled: {{ auto_start_enabled | default(false) | lower }}