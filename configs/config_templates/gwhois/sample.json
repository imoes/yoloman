{
  "listen_address": "0.0.0.0",
  "listen_port": 43,
  "server_name": "whois.example.com",
  "server_contact": "hostmaster@example.com",
  "log_level": "info",
  "log_file": "/var/log/gwhois/gwhois.log",
  "use_file_backend": true,
  "whois_db_file": "/var/lib/gwhois/whois.db",
  "batch_mode": true,
  "batch_max_queries": 50,
  "batch_timeout": 60,
  "enable_reverse": true,
  "reverse_prefix_file": "/etc/gwhois/ip_prefix_map.txt",
  "rate_limit_enabled": true,
  "rate_limit_requests_per_ip": 5,
  "rate_limit_window_seconds": 30,
  "response_suffixes": [
    "# This is the official WHOIS server for example.com.",
    "# Usage is subject to terms at https://example.com/whois/terms."
  ],
  "domain_configs": {
    "legacy.example.net": {
      "server": "whois.iana.org",
      "port": 43,
      "query_prefix": ""
    },
    "special.example.org": {
      "server": "whois.custom.example",
      "port": 4343,
      "query_prefix": "::"
    }
  },
  "custom_header": "# Copyright (c) 2023 Example Inc. All rights reserved.",
  "verbose": true
}
