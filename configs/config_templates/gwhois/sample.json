{
  "listen_address": "0.0.0.0",
  "listen_port": 43,
  "server_name": "localhost",
  "server_contact": "admin@example.com",
  "log_level": "info",
  "log_file": "/var/log/gwhois/gwhois.log",
  "use_file_backend": true,
  "whois_db_file": "/var/lib/gwhois/whois.db",
  "batch_mode": false,
  "batch_max_queries": 100,
  "batch_timeout": 30,
  "enable_reverse": false,
  "reverse_prefix_file": "/etc/gwhois/prefix_map.txt",
  "rate_limit_enabled": false,
  "rate_limit_requests_per_ip": 10,
  "rate_limit_window_seconds": 60,
  "response_suffixes": [
    "# The Whois Service is provided by the operator.",
    "# See https://example.com/whois/terms for usage policy."
  ]
}
