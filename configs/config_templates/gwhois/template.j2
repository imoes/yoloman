#: version 20120626
#  see end of file for copyright notices and changelog
#
#  This configuration file drives gwhois, a WHOIS client.
#  It defines query redirection rules, logging, and operational parameters.

# --------------------------------------------------------------------
# Server Operational Parameters
# --------------------------------------------------------------------

# IP address the WHOIS server should bind to (e.g., '127.0.0.1' or '0.0.0.0' for all interfaces).
listen_address: {{ (listen_address | default('0.0.0.0')) }}

# Port number the WHOIS server listens on (standard WHOIS port is 43).
listen_port: {{ (listen_port | default(43)) }}

# Public hostname or identifier for this WHOIS server instance.
server_name: {{ (server_name | default('localhost')) }}

# Email address or contact info for the server operator.
server_contact: {{ (server_contact | default('admin@example.com')) }}

# Verbosity of logging: 'error', 'warn', 'info', 'debug' (gwhois uses standard syslog-like levels).
log_level: {{ (log_level | default('info')) }}

# Path to the log file for server events.
log_file: {{ (log_file | default('/var/log/gwhois/gwhois.log')) }}

# If true, use the built-in file-backed WHOIS database instead of external sources.
use_file_backend: {{ (use_file_backend | default(true)) | lower }}

# Path to the plain-text WHOIS database file (domain → contact data mapping).
whois_db_file: {{ (whois_db_file | default('/var/lib/gwhois/whois.db')) }}

# Enable batch mode to handle multiple queries in one connection (e.g., via pipelined input).
batch_mode: {{ (batch_mode | default(false)) | lower }}

# Maximum number of queries allowed per batch connection (used only if batch_mode=true).
batch_max_queries: {{ (batch_max_queries | default(100)) }}

# Timeout (seconds) for the entire batch session (used only if batch_mode=true).
batch_timeout: {{ (batch_timeout | default(30)) }}

# Enable reverse WHOIS lookup by IP prefix (e.g., for network operators).
enable_reverse: {{ (enable_reverse | default(false)) | lower }}

# Path to the IP prefix → owner mapping file (required if enable_reverse=true).
reverse_prefix_file: {{ (reverse_prefix_file | default('/etc/gwhois/prefix_map.txt')) }}

# Enable per-IP request rate limiting to prevent abuse.
rate_limit_enabled: {{ (rate_limit_enabled | default(false)) | lower }}

# Max requests allowed per IP within the rate-limit window (used only if rate_limit_enabled=true).
rate_limit_requests_per_ip: {{ (rate_limit_requests_per_ip | default(10)) }}

# Time window (seconds) for rate limiting (used only if rate_limit_enabled=true).
rate_limit_window_seconds: {{ (rate_limit_window_seconds | default(60)) }}

# List of suffix lines appended to every WHOIS response.
response_suffixes:
{% for suffix in (response_suffixes | default(['# The Whois Service is provided by the operator.', '# See https://example.com/whois/terms for usage policy.'])) %}
{{ suffix }}
{% endfor %}

# --------------------------------------------------------------------
# Redirect-Targets (for specifying query modifiers)
# --------------------------------------------------------------------
:none||
^redirect:

