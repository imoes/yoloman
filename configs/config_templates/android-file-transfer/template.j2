{# ============================================================================ #}
{# android-file-transfer configuration template                                   #}
{#                                                                                #}
{# This template generates a configuration file for android-file-transfer,       #}
{# a tool used to manage MTP (Media Transfer Protocol) devices on Linux.          #}
{#                                                                                #}
{# The output format is an INI-style configuration file.                          #}
{# ============================================================================ #}

{# -------------------------------------------------------------------------- #}
{# Global settings section                                                      #}
{# -------------------------------------------------------------------------- #}
[main]

{# Directory where the MTP device will be mounted; must exist and be writable #}
{# by the user.                                                               #}
{# Default: /media/android                                                    #}
mount_point = {{ mount_point | default('/media/android') }}

{# Enable the FUSE wrapper to expose the MTP device as a filesystem for       #}
{# instant file access.                                                       #}
{# Default: true                                                              #}
use_fuse = {{ use_fuse | default(true) | lower }}

{# Enable USB zerocopy support, reducing user/kernel data copying for         #}
{# improved performance on recent kernels.                                    #}
{# Default: true                                                              #}
use_zerocopy = {{ use_zerocopy | default(true) | lower }}

{# Automatically rename album cover files (e.g., 'cover.jpg', 'AlbumArt.jpg') #}
{# to 'albumart.jpg' for media player compatibility.                          #}
{# Default: true                                                              #}
rename_album_covers = {{ rename_album_covers | default(true) | lower }}