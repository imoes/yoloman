# VM ID (must be unique in the cluster)
vmid: {{ vmid }}

# Hostname to advertise for this VM
name: {{ name }}

# Operating system type (e.g., 'other', 'l24', 'l26', 'win10', etc.)
ostype: {{ ostype }}

# Number of virtual CPUs
cores: {{ cores }}

# Total CPU sockets (sockets × cores = total vCPUs)
sockets: {{ sockets }}

# Total memory (in MiB)
memory: {{ memory }}

# Number of NUMA nodes (set >1 for NUMA-aware scheduling)
numa: {{ numa | default(0) }}

# Boot order (e.g., 'c' = disk, 'n' = network, 'd' = CD-ROM)
boot: {{ boot }}

# Boot disk (disk used for initial boot; must be present in disk list)
bootdisk: {{ bootdisk }}

# Enable or disable ACPI
acpi: {% if acpi %}1{% else %}0{% endif %}

# Enable or disable AGP (for older Windows guests)
agp: {% if agp %}1{% else %}0{% endif %}

# Enable or disable HPET (High Precision Event Timer)
hpet: {% if hpet %}1{% else %}0{% endif %}

# Enable or disable TPM (Trusted Platform Module)
tpmstate: {% if tpmstate %}tpmstate0=size=4M,version=v2.0{% else %}{% endif %}

# Machine type (e.g., pc-q35-8.0, pc-i440fx-8.0, etc.)
machine: {{ machine }}

{% if bios %}
# BIOS implementation (seabios or ovmf)
bios: {{ bios }}
{% endif %}

{% if serial0 %}
# First serial port (e.g., socket, device, etc.)
serial0: {{ serial0 }}
{% endif %}

{% if serial1 %}
# Second serial port
serial1: {{ serial1 }}
{% endif %}

{% if parallel0 %}
# First parallel port
parallel0: {{ parallel0 }}
{% endif %}

{% if vga %}
# Graphics adapter type and resolution
vga: {{ vga }}
{% endif %}

{% if tablet %}
# Enable tablet input device
tablet: {{ tablet }}
{% endif %}

{% if keyboard %}
# Keyboard layout
keyboard: {{ keyboard }}
{% endif %}

{% for disk in disks %}
# Disk {{ loop.index }}: {{ disk.name }} ({{ disk.size }})
{{ disk.dev }}: {{ disk.storage }}:{{ disk.vol_id }},size={{ disk.size }}{% if disk.format %},format={{ disk.format }}{% endif %}{% if disk.cache %},cache={{ disk.cache }}{% endif %}{% if disk.iothread %},iothread=1{% endif %}{% if disk.ssd %},ssd=1{% endif %}{% if disk.backup %},backup={{ 'yes' if disk.backup else 'no' }}{% endif %}{% if disk.discard %},discard={{ disk.discard }}{% endif %}{% if disk.mime_type %},mime_type={{ disk.mime_type }}{% endif %}
{% endfor %}

{% for nic in nics %}
# Network interface {{ loop.index }}: {{ nic.name }} ({{ nic.model }}, MAC {{ nic.macaddr }})
{{ nic.dev }}: {{ nic.model }},macaddr={{ nic.macaddr }}{% if nic.bridge %},bridge={{ nic.bridge }}{% endif %}{% if nic.rate %},rate={{ nic.rate }}{% endif %}{% if nic queues %},queues={{ nic.queues }}{% endif %}{% if nic.mtu %},mtu={{ nic.mtu }}{% endif %}{% if nic.trunks %},trunks={{ nic.trunks | join(';') }}{% endif %}{% if nic.link_down %},link_down=1{% endif %}{% if nic.firewall %},firewall=1{% endif %}
{% endfor %}

{% if hostid %}
# Host ID (used for PCI passthrough security)
hostid: {{ hostid }}
{% endif %}

{% if searchdomain %}
# DNS search domain
searchdomain: {{ searchdomain }}
{% endif %}

{% if nameserver %}
# DNS nameserver
nameserver: {{ nameserver }}
{% endif %}

{% for rng in rng_devices %}
# Random number generator device {{ loop.index }}
rng0: {{ rng.model | default('virtio') }}{% if rng.source %},source={{ rng.source }}{% endif %}
{% endfor %}

{% if args %}
# Additional QEMU command-line arguments
args: {{ args }}
{% endif %}

{% if description %}
# Description (free-form text, often used for documentation)
description: |
{{ description | indent(width=2, indentfirst=True) }}
{% endif %}

{% if tags %}
# Tags (comma-separated or space-separated, no spaces recommended)
tags: {{ tags | join(' ') if tags is string else tags | join(' ') }}
{% endif %}

{% if hookscript %}
# Hook script path
hookscript: {{ hookscript }}
{% endif %}

{% for scsi_controller in scsi_controllers %}
# SCSI controller {{ loop.index }} ({{ scsi_controller.model }})
scsi{{ scsi_controller.index }}: {{ scsi_controller.model }}{% if scsi_controller.queues %},queues={{ scsi_controller.queues }}{% endif %}{% if scsi_controller.iothread %},iothread=1{% endif %}
{% endfor %}

{% for usb in usb_devices %}
# USB device {{ loop.index }}
usb{{ loop.index }}: {{ usb.spec }}{% if usb.volume_id %},volume={{ usb.volume_id }}{% endif %}{% if usb.type %},type={{ usb.type }}{% endif %}
{% endfor %}

{% if numa_enabled %}
{% for numa_node in numa_nodes %}
# NUMA node {{ loop.index }}
numa{{ loop.index }}: cpus={{ numa_node.cpus }},hostnodes={{ numa_node.hostnodes | join(',') }},memory={{ numa_node.memory }},policy={{ numa_node.policy | default('bind') }}{% if numa_node.discard %},discard={{ numa_node.discard }}{% endif %}
{% endfor %}
{% endif %}

# End of VM configuration
