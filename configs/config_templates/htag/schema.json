{
  "name": {
    "type": "string",
    "default": "John Doe",
    "description": "Full name of the user."
  },
  "email": {
    "type": "string",
    "default": "john@example.com",
    "description": "Email address of the user."
  },
  "nick": {
    "type": "string",
    "default": "jd",
    "description": "Nickname or handle."
  },
  "tagfile": {
    "type": "string",
    "default": "/etc/htag/tags",
    "description": "Path to the taglines file."
  },
  "random_sig": {
    "type": "bool",
    "default": false,
    "description": "Enable random signature selection."
  },
  "sig_files": {
    "type": "list",
    "default": [
      "/etc/htag/sigs/default.sig"
    ],
    "description": "List of signature file paths for random selection."
  },
  "sigfile": {
    "type": "string",
    "default": "~/.htrc/sig",
    "description": "Default signature file path."
  },
  "fido_addr": {
    "type": "string",
    "default": "",
    "description": "FidoNet address."
  },
  "newsgroups": {
    "type": "list",
    "default": [
      "comp.sys.ibm.pc.hardware"
    ],
    "description": "List of newsgroups."
  }
}
