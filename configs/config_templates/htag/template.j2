# ~/.htrc
# Configuration file for htag.pl
# See htag(1) for details.

# The user's full name for signature lines.
name = {{ name | default('John Doe') }}

# The user's email address.
email = {{ email | default('john@example.com') }}

# The user's nickname or handle.
nick = {{ nick | default('jd') }}

# Path to the tag file containing taglines.
tagfile = {{ tagfile | default('/etc/htag/tags') }}

# Whether to append a random signature from a list.
# Valid values: 0 (off), 1 (on).
random_sig = {{ random_sig | default(false) | ternary(1, 0) }}

# List of signature files to choose from if random_sig is enabled.
# Each item is a string representing a path to a signature file.
{% for sig in sig_files | default(['/etc/htag/sigs/default.sig']) %}
sig {{ loop.index0 }} = {{ sig }}
{% endfor %}

# Path to the user's primary signature file.
sigfile = {{ sigfile | default('~/.htrc/sig') }}

# The user's FidoNet address (if applicable).
fido_addr = {{ fido_addr | default('') }}

# The user's Usenet newsgroups or interests.
# Stored as a newline-separated list in the config.
newsgroups = {{ newsgroups | default(['comp.sys.ibm.pc.hardware']) | join('\n') }}