# nfct default timeout configuration
# Generated by Ansible Jinja2 template for nfct(8)
# This file configures connection tracking timeout policies.
# Each 'nfct add timeout' block defines a named policy containing
# protocol-to-state mappings, which are subsequently applied
# by iptables or nftables rules referencing this policy name.

# policies: A list of timeout policy configurations. Each policy defines
# a named set of timeouts for specific protocol states, used with iptables CT target.
# Default: empty list []

{% for policy in (policies | default([])) %}
# Policy: {{ policy.name }}
# policy.name: The unique name identifier for this timeout policy.
nfct add timeout {{ (policy.name | default('unnamed')) | string }}

# Protocol state mappings for this policy.
# Each entry maps a protocol (e.g., tcp, udp) to a list of state keywords
# that the kernel connection tracker should apply.
{% for protocol in (policy.protocols | default([])) %}
  # protocol.proto: The protocol name (e.g., tcp, udp, icmp).
  # protocol.states: List of connection states (e.g., NEW, ESTABLISHED, RELATED).
  {{ protocol.proto | default('') | string }} {{ (protocol.states | default([])) | join(' ') }}
{% endfor %}
{% endfor %}

# If no policies are defined, this file remains empty/minimal.
# To apply these, ensure nfct is invoked or your firewall rules reference
# these timeout names.