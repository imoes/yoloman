# /etc/ipsec.conf - strongSwan IPsec configuration file
# This file is processed by the charon-systemd service.
#
# This template is self-documenting. Every configurable directive is preceded
# by a comment derived from the Ansible role schema description.
# All variables use the `| default(...)` filter to ensure safe rendering even
# if the variable is undefined in the Ansible playbook.

config setup
    # Charon daemon debug logging level. Format: 'layer subsystem level' (e.g., '2 0,2 0,2 0,2 0' for default minimal verbosity). See strongSwan documentation.
    charondebug="{{ log_level | default('2 0,2 0,2 0,2 0') }}"

    # Whether to enforce unique IDs for IKE_SAs (prevents duplicate connections from same ID).
    uniqueids = {{ unique_ids | default(True) | lower }}

    # Note: Dead Peer Detection (DPD) is controlled by individual connection definitions
    # or global defaults in strongSwan. This template does not force a global dpdaction
    # unless explicitly configured via a dedicated parameter, to avoid overriding
    # connection-specific settings.

{% for conn in connections | default([]) %}
# Connection: {{ conn.name | default('unnamed') }}
conn {{ conn.name | default('unnamed') }}

    # Endpoint type
    {% if conn.type | default('tunnel') == 'tunnel' %}
    type = tunnel
    {% elif conn.type | default('tunnel') == 'transport' %}
    type = transport
    {% endif %}

    # IKE version
    {% if conn.ike_version is defined %}
    ike = {{ conn.ike_version }}
    {% endif %}

    # ESP proposal(s)
    {% if conn.esp is defined %}
    esp = {{ conn.esp | join(', ') }}
    {% endif %}

    # IKE proposal(s)
    {% if conn.ike is defined %}
    ike = {{ conn.ike | join(', ') }}
    {% endif %}

    # Authentication method
    {% if conn.auth_method | default('psk') == 'psk' %}
    authby = psk
    {% elif conn.auth_method | default('psk') == 'pubkey' %}
    authby = pubkey
    {% endif %}

    # Left side (local) parameters
    {% if conn.left is defined and conn.left is mapping %}
    {% if conn.left.type | default('host') == 'host' %}
    left = {{ conn.left.value | default('%any') }}
    {% elif conn.left.type | default('host') == '%any' %}
    left = %any
    {% elif conn.left.type | default('host') == '%defaultroute' %}
    left = %defaultroute
    {% endif %}

    {% if conn.left.id is defined %}
    leftid = {{ conn.left.id }}
    {% endif %}

    {% if conn.left.subnet is defined %}
    leftsubnet = {{ conn.left.subnet | join(', ') }}
    {% endif %}

    {% if conn.left.cert is defined %}
    leftcert = {{ conn.left.cert }}
    {% endif %}

    # Note: `left.private_key` in schema likely maps to `leftfirewall = yes`
    # or requires specific key configuration not directly representable as a simple
    # boolean flag in all strongSwan versions. Preserving original logic:
    {% if conn.left.private_key is defined %}
    leftfirewall = yes
    {% endif %}
    {% endif %}

    # Right side (remote) parameters
    {% if conn.right is defined and conn.right is mapping %}
    {% if conn.right.type | default('host') == 'host' %}
    right = {{ conn.right.value | default('%any') }}
    {% elif conn.right.type | default('host') == '%any' %}
    right = %any
    {% elif conn.right.type | default('host') == '%defaultroute' %}
    right = %defaultroute
    {% endif %}

    {% if conn.right.id is defined %}
    rightid = {{ conn.right.id }}
    {% endif %}

    {% if conn.right.subnet is defined %}
    rightsubnet = {{ conn.right.subnet | join(', ') }}
    {% endif %}

    {% if conn.right.certificate is defined %}
    rightcert = {{ conn.right.certificate }}
    {% endif %}
    {% endif %}

    # SA lifetimes
    {% if conn.life_seconds is defined %}
    lifetime = {{ conn.life_seconds }}s
    {% endif %}

    # Note: `lifeness` is likely a typo in the original template for `lifetime` (in KB).
    # strongSwan uses `lifetime` (seconds) and `juggle` or similar for other metrics.
    # However, to preserve the EXACT directive names expected by the software as per
    # enrichment rules, we output `lifeness` if defined, though it may be invalid
    # in standard strongSwan.
    {% if conn.life_kb is defined %}
    lifeness = {{ conn.life_kb }}k
    {% endif %}

    # Auto-start behavior
    {% if conn.auto | default('route') == 'start' %}
    auto = start
    {% elif conn.auto | default('route') == 'add' %}
    auto = add
    {% elif conn.auto | default('route') == 'route' %}
    auto = route
    {% endif %}

    # PFS (Perfect Forward Secrecy) group
    {% if conn.pfs_group is defined %}
    pfs = {{ conn.pfs_group }}
    {% endif %}

    # Optional comments (preserved verbatim)
    {% if conn.comments is defined %}
    {% for comment in conn.comments %}
    # {{ comment }}
    {% endfor %}
    {% endif %}

{% endfor %}# End of ipsec.conf