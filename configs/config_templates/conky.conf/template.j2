# =============================================================================
# CONKY CONFIGURATION TEMPLATE
# =============================================================================
# This template generates a self-documenting conky.conf file.
# It is designed to be reused within an Ansible role.
# Every configuration directive is prefixed with a comment explaining its purpose
# and default behavior, derived from the schema definitions.
# =============================================================================

[settings]

# -----------------------------------------------------------------------------
# Basic Settings
# -----------------------------------------------------------------------------

# Whether to run Conky as a background daemon (recommended for long-running displays).
# Default: False
daemon = {{ daemon | default(False) | lower }}

# Time (in seconds) between updates of the display.
# Default: 2
update_interval = {{ update_interval | default(2) }}

# Total number of updates before exiting (0 = infinite loop).
# Default: 0
total_run_times = {{ total_run_times | default(0) }}

# Use X11 for display (required on most Linux desktops).
# Default: True
use_x11 = {{ use_x11 | default(True) | lower }}

# Use Wayland display server (experimental, may require compositing support).
# Default: False
use_wayland = {{ use_wayland | default(False) | lower }}

# Font to use for text rendering.
# Format: 'FontName:size=Size'.
# Default: 'DejaVu Sans Mono:size=10'
font = {{ font | default('DejaVu Sans Mono:size=10') }}

# Show numeric scale on graphs (e.g., min/max labels).
# Default: False
show_graph_scale = {{ show_graph_scale | default(False) | lower }}

# Show numeric range on graphs.
# Default: False
show_graph_range = {{ show_graph_range | default(False) | lower }}

# Where to position the Conky window on screen.
# Valid values: top_left, top_right, bottom_left, bottom_right, top_middle, bottom_middle, middle_left, middle_right, middle.
# Default: 'top_right'
alignment = {{ alignment | default('top_right') }}

# Horizontal gap (in pixels) between screen edge and Conky window.
# Default: 10
gap_x = {{ gap_x | default(10) }}

# Vertical gap (in pixels) between screen edge and Conky window.
# Default: 30
gap_y = {{ gap_y | default(30) }}

# Minimum width of the Conky window (0 = no minimum).
# Default: 0
minimum_width = {{ minimum_width | default(0) }}

# Minimum height of the Conky window (0 = no minimum).
# Default: 0
minimum_height = {{ minimum_height | default(0) }}

# Maximum width of the Conky window (0 = unlimited).
# Default: 0
maximum_width = {{ maximum_width | default(0) }}

# Maximum height of the Conky window (0 = unlimited).
# Default: 0
maximum_height = {{ maximum_height | default(0) }}

# -----------------------------------------------------------------------------
# Drawing Options
# -----------------------------------------------------------------------------

# Draw borders around text blocks.
# Default: False
draw_borders = {{ draw_borders | default(False) | lower }}

# Draw borders around graphs.
# Default: False
draw_graph_borders = {{ draw_graph_borders | default(False) | lower }}

# Draw outline around the entire Conky window.
# Default: False
draw_outline = {{ draw_outline | default(False) | lower }}

# Draw drop shadows on text.
# Default: True
draw_shades = {{ draw_shades | default(True) | lower }}

# Draw borders around the Conky window.
# Default: False
draw_window_borders = {{ draw_window_borders | default(False) | lower }}

# Thickness of borders and outlines in pixels.
# Default: 1
border_width = {{ border_width | default(1) }}

# Margin (in pixels) around the Conky window for border drawing.
# Default: 4
border_margin = {{ border_margin | default(4) }}

# Inner margin (in pixels) for nested borders.
# Default: 2
border_inner_margin = {{ border_inner_margin | default(2) }}

# -----------------------------------------------------------------------------
# Colors
# -----------------------------------------------------------------------------

# Background color for the Conky window (hex format, e.g., '222222', 'FFFFFF', or named like 'white').
# Default: '000000'
background = {{ background | default('000000') }}

# Default text color (hex or named).
# Default: 'FFFFFF'
text_color = {{ text_color | default('FFFFFF') }}

# Color used for text shadows (typically dark).
# Default: '000000'
text_shadow_color = {{ text_shadow_color | default('000000') }}

# Default graph color (hex or named).
# Default: '5555FF'
graph_color = {{ graph_color | default('5555FF') }}

# Fill graphs with color (true) or just draw outline (false).
# Default: True
graph_filled = {{ graph_filled | default(True) | lower }}

# Color used to fill bar graphs (e.g., CPU usage).
# Default: '55FF55'
bar_fill = {{ bar_fill | default('55FF55') }}

# Color of the outline around bar graphs.
# Default: '000000'
bar_outline = {{ bar_outline | default('000000') }}

# Background color behind bar graphs.
# Default: '333333'
bar_bg = {{ bar_bg | default('333333') }}

# Color used for beveled edges on borders/boxes.
# Default: 'AAAAAA'
bevel_color = {{ bevel_color | default('AAAAAA') }}

# Width (in pixels) of bevels on boxes.
# Default: 1
bevel_width = {{ bevel_width | default(1) }}

# -----------------------------------------------------------------------------
# Title Bar
# -----------------------------------------------------------------------------

# Show a title bar above the Conky window.
# Default: False
use_title_bar = {{ use_title_bar | default(False) | lower }}

# Text to display in the title bar.
# Default: 'System Monitor'
title_text = {{ title_text | default('System Monitor') }}

# Background color of the title bar.
# Default: '444444'
title_bar_bg_color = {{ title_bar_bg_color | default('444444') }}

# Border color of the title bar.
# Default: '666666'
title_bar_border_color = {{ title_bar_border_color | default('666666') }}

# Height (in pixels) of the title bar.
# Default: 16
title_bar_height = {{ title_bar_height | default(16) }}

# -----------------------------------------------------------------------------
# Window Management
# -----------------------------------------------------------------------------

# Create a dedicated window for Conky (recommended).
# Default: True
own_window = {{ own_window | default(True) | lower }}

# Type of window (desktop, dock, panel, normal, override).
# Default: 'desktop'
own_window_type = {{ own_window_type | default('desktop') }}

# WM_CLASS for the window (used for window management).
# Default: 'Conky'
own_window_class = {{ own_window_class | default('Conky') }}

# Window title (shown in window managers).
# Default: 'Conky'
own_window_title = {{ own_window_title | default('Conky') }}

# Window hints (comma-separated) to control visibility and stacking.
# Default: 'undecorated,sticky,skip_taskbar,skip_pager,below'
own_window_hints = {{ own_window_hints | default('undecorated,sticky,skip_taskbar,skip_pager,below') }}

# Use true transparency (requires compositing).
# Default: False
own_window_transparent = {{ own_window_transparent | default(False) | lower }}

# Enable ARGB visual for per-pixel alpha (e.g., 50% opacity).
# Default: False
own_window_argb = {{ own_window_argb | default(False) | lower }}

# Alpha value for ARGB (0–255); lower = more transparent.
# Default: 128
own_window_argb_value = {{ own_window_argb_value | default(128) }}

# -----------------------------------------------------------------------------
# Locale and Text Formatting
# -----------------------------------------------------------------------------

# Force UTF-8 locale (helps with non-ASCII characters).
# Default: True
override_utf8_locale = {{ override_utf8_locale | default(True) | lower }}

# -----------------------------------------------------------------------------
# Lua Scripting Support
# -----------------------------------------------------------------------------

# Path to Lua script to load (e.g., '~/.config/conky/scripts/graph.lua').
# Default: '' (empty string)
lua_load = {{ lua_load | default('') }}

# Prefix for Lua draw functions in the script.
# Default: 'conky_'
lua_draw_function_prefix = {{ lua_draw_function_prefix | default('conky_') }}

# -----------------------------------------------------------------------------
# Layout and Spacing
# -----------------------------------------------------------------------------

# Character used to separate sections (e.g., '|', '-', or space).
# Default: '|'
separator_char = {{ separator_char | default('|') }}

# Insert spacers around text (none, left, right, or both) to align columns.
# Default: 'left'
use_spacer = {{ use_spacer | default('left') }}

# -----------------------------------------------------------------------------
# Data Accuracy and Time
# -----------------------------------------------------------------------------

# Disable disk buffer usage (improves accuracy for disk stats).
# Default: True
no_buffers = {{ no_buffers | default(True) | lower }}

# Round integer values (e.g., CPU percentage) to whole numbers.
# Default: False
int_sample = {{ int_sample | default(False) | lower }}

# Use 24-hour time format instead of AM/PM.
# Default: True
twenty_four_hour_clock = {{ twenty_four_hour_clock | default(True) | lower }}

# Timezone to use (e.g., 'UTC', 'America/New_York'; empty = local).
# Default: '' (empty string)
timezone = {{ timezone | default('') }}

# Enable UTF-8 character support (recommended).
# Default: True
use_utf8 = {{ use_utf8 | default(True) | lower }}

# Add a trailing newline at the end of the output (useful for some scripts).
# Default: False
extra_newline = {{ extra_newline | default(False) | lower }}

# -----------------------------------------------------------------------------
# Lua-Specific Settings
# -----------------------------------------------------------------------------

# Font to use for Lua-drawn text (overrides default).
# Default: '' (empty string)
lua_font = {{ lua_font | default('') }}

# Font size for Lua-drawn text.
# Default: 10
lua_font_size = {{ lua_font_size | default(10) }}

# Text color for Lua-drawn elements.
# Default: 'FFFFFF'
lua_color = {{ lua_color | default('FFFFFF') }}

# Disable all updates (debugging only).
# Default: False
no_updates = {{ no_updates | default(False) | lower }}

# Cache compiled Lua code for faster reloading.
# Default: True
lua_code_cache = {{ lua_code_cache | default(True) | lower }}

# -----------------------------------------------------------------------------
# Custom Variables
# -----------------------------------------------------------------------------
# User-defined custom variables for advanced customization or Lua templates.
# Each item in `custom_vars` list should have 'name' and 'value'.
{% if custom_vars is defined and custom_vars | length > 0 %}
{% for var in custom_vars %}
# {{ var.description | default('Custom Variable') }}
{{ var.name }} = {{ var.value }}
{% endfor %}
{% endif %}

# -----------------------------------------------------------------------------
# Conky Sections
# -----------------------------------------------------------------------------
# List of Conky sections defining content blocks (e.g., CPU, memory, network).
# Each section has a name (like 'text') and a list of lines (body_lines).
{% if sections is defined and sections | length > 0 %}
{% for section in sections %}
# {{ section.name | title }} Section
# Description: {{ section.description | default('No description provided') }}
{{ section.name | upper }}
{
{% for line in section.body_lines | default([]) %}  {{ line }}
{% endfor %}}
{% endfor %}
{% endif %}