{
  "daemon": false,
  "update_interval": 2,
  "total_run_times": 0,
  "use_x11": true,
  "use_wayland": false,
  "font": "DejaVu Sans Mono:size=10",
  "show_graph_scale": false,
  "show_graph_range": false,
  "alignment": "top_right",
  "gap_x": 10,
  "gap_y": 30,
  "minimum_width": 200,
  "minimum_height": 100,
  "maximum_width": 0,
  "maximum_height": 0,
  "draw_borders": true,
  "draw_graph_borders": true,
  "draw_outline": true,
  "draw_shades": true,
  "draw_window_borders": false,
  "border_width": 2,
  "border_margin": 4,
  "border_inner_margin": 2,
  "background": "222222",
  "text_color": "FFFFFF",
  "text_shadow_color": "000000",
  "graph_color": "5555FF",
  "graph_filled": true,
  "bar_fill": "55FF55",
  "bar_outline": "000000",
  "bar_bg": "333333",
  "bevel_color": "AAAAAA",
  "bevel_width": 1,
  "use_title_bar": false,
  "title_text": "System Monitor",
  "title_bar_bg_color": "444444",
  "title_bar_border_color": "666666",
  "title_bar_height": 16,
  "own_window": true,
  "own_window_type": "desktop",
  "own_window_class": "Conky",
  "own_window_title": "Conky",
  "own_window_hints": "undecorated,sticky,skip_taskbar,skip_pager,below",
  "own_window_transparent": false,
  "own_window_argb": false,
  "own_window_argb_value": 128,
  "override_utf8_locale": true,
  "lua_load": "",
  "lua_draw_function_prefix": "conky_",
  "separator_char": "|",
  "use_spacer": "left",
  "no_buffers": true,
  "int_sample": false,
  "twenty_four_hour_clock": true,
  "timezone": "",
  "use_utf8": true,
  "extra_newline": false,
  "lua_font": "",
  "lua_font_size": 10,
  "lua_color": "FFFFFF",
  "no_updates": false,
  "lua_code_cache": true,
  "custom_vars": [
    {
      "name": "my_hostname",
      "value": "$(hostname)",
      "description": "System hostname (resolved at runtime)"
    },
    {
      "name": "theme_color",
      "value": "4A90E2",
      "description": "Custom accent color for UI"
    }
  ],
  "sections": [
    {
      "name": "text",
      "description": "Main informational block",
      "body_lines": [
        "System: ${alignr}$nodename",
        "Kernel: ${alignr}$kernel",
        "Uptime: ${alignr}$uptime",
        "CPU: ${alignr}${freq} MHz",
        "CPU Usage: ${alignr}${cpu}% ${cpubar}",
        "RAM Usage: ${alignr}$mem/$memmax ${membar}",
        "Disk /: ${alignr}${fs_used /}/${fs_size /} ${fs_bar /}",
        "Network (eth0): ${alignr}Down: ${downspeed eth0}  Up: ${upspeed eth0}",
        "Date: ${alignr}${time %a %d %b %Y}",
        "Time: ${alignr}${time %H:%M:%S}"
      ]
    },
    {
      "name": "window",
      "description": "Window properties override",
      "body_lines": [
        "border_inner_margin 6",
        "border_outer_margin 0"
      ]
    }
  ]
}
