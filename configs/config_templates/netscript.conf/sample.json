{
  "base_dir": "/var/lib/netscript",
  "script_dir": "/etc/netscript/scripts",
  "debug": false,
  "max_jobs": 4,
  "timeout": 30,
  "log_to_syslog": true,
  "syslog_facility": "local0",
  "namespaces": [
    {
      "name": "dmz",
      "iface": "eth1",
      "ip": "10.0.1.1",
      "netmask": "255.255.255.0",
      "gateway": "10.0.1.254",
      "dns": [
        "8.8.8.8",
        "9.9.9.9"
      ],
      "enabled": true
    },
    {
      "name": "mgmt",
      "iface": "eth2",
      "ip": "",
      "netmask": "255.255.255.0",
      "gateway": "",
      "dns": [],
      "enabled": true
    }
  ],
  "default_dns": [
    "8.8.4.4",
    "1.1.1.1"
  ],
  "use_systemd": true,
  "cleanup_on_shutdown": true
}
