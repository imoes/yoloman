{
  "interface": {
    "type": "string",
    "default": "uap0",
    "description": "The wireless interface name to configure (e.g., uap0, wlan0)."
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Debug output level: 0 (disable), 1 (basic), 2 (verbose)."
  },
  "ssid": {
    "type": "string",
    "default": "GuestNetwork",
    "description": "The SSID (Service Set Identifier) of the wireless network."
  },
  "mac_address": {
    "type": "string",
    "default": "00:00:00:00:00:00",
    "description": "The MAC address for the access point."
  },
  "channel": {
    "type": "number",
    "default": 6,
    "description": "The radio channel (1-14 for 2.4GHz)."
  },
  "beacon_period": {
    "type": "number",
    "default": 100,
    "description": "Beacon interval in Time Units (usually TUs, where 1 TU = 1024us)."
  },
  "dtim_period": {
    "type": "number",
    "default": 1,
    "description": "DTIM (Delivery Traffic Indication Message) period."
  },
  "auth_mode": {
    "type": "string",
    "default": "open",
    "description": "Authentication mode: open, sharedkey, wpa, wpa2, etc."
  },
  "protocol": {
    "type": "string",
    "default": "wpa2",
    "description": "Security protocol: none, wpa, wpa2.",
    "enum": [
      "wpa",
      "wpa2"
    ]
  },
  "wpa_passphrase": {
    "type": "string",
    "default": "supersecretkey",
    "description": "WPA/WPA2 Pre-Shared Key passphrase."
  },
  "cipher": {
    "type": "string",
    "default": "ccmp",
    "description": "Encryption cipher: tkip, ccmp."
  },
  "group_rekey_timer": {
    "type": "number",
    "default": 3600,
    "description": "Group rekey timer in seconds."
  },
  "max_sta_num": {
    "type": "number",
    "default": 10,
    "description": "Maximum number of connected stations."
  },
  "sta_ageout_timer": {
    "type": "number",
    "default": 600,
    "description": "Station ageout timer in seconds."
  },
  "tx_power": {
    "type": "number",
    "default": 30,
    "description": "Transmit power level (units depend on driver, often dBm * 2 or similar)."
  },
  "rts_threshold": {
    "type": "number",
    "default": 2347,
    "description": "RTS (Request to Send) threshold in bytes."
  },
  "frag_threshold": {
    "type": "number",
    "default": 2346,
    "description": "Fragmentation threshold in bytes."
  },
  "retry_limit": {
    "type": "number",
    "default": 7,
    "description": "Number of retries before dropping a packet."
  },
  "preamble_ctl": {
    "type": "string",
    "default": "short",
    "description": "Preamble type: short, long."
  },
  "radio_ctl": {
    "type": "string",
    "default": "on",
    "description": "Radio state: on, off.",
    "enum": [
      "on",
      "off"
    ]
  },
  "bcast_ssid_ctl": {
    "type": "string",
    "default": "on",
    "description": "Broadcast SSID control: on, off.",
    "enum": [
      "on",
      "off"
    ]
  },
  "pkt_fwd_ctl": {
    "type": "string",
    "default": "off",
    "description": "Packet forwarding control: on, off.",
    "enum": [
      "on",
      "off"
    ]
  }
}
