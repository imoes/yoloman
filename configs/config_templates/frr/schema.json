{
  "hostname": {
    "type": "string",
    "default": "router",
    "description": "Router hostname used for identification"
  },
  "router_id": {
    "type": "string",
    "default": "",
    "description": "Global router-id (IPv4 format, e.g. 192.0.2.1); optional"
  },
  "logging.level": {
    "type": "string",
    "default": "info",
    "description": "Logging level: debug, info, notice, warning, error, crit, alert, emerg"
  },
  "logging.files.path": {
    "type": "string",
    "default": "/var/log/frr/frr.log",
    "description": "Path to FRR log file if file logging is desired"
  },
  "ipv4_unicast": {
    "type": "bool",
    "default": true,
    "description": "Enable IPv4 unicast routing in global address-family"
  },
  "ipv6_unicast": {
    "type": "bool",
    "default": false,
    "description": "Enable IPv6 unicast routing in global address-family"
  },
  "bgp": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "BGP routing configuration",
    "items": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "Enable BGP"
      },
      "asn": {
        "type": "number",
        "default": null,
        "description": "Autonomous System Number (1\u20134294967295)"
      },
      "router_id": {
        "type": "string",
        "default": "",
        "description": "BGP router-id (overrides global if set)"
      },
      "graceful_restart": {
        "type": "bool",
        "default": false,
        "description": "Enable BGP graceful restart"
      },
      "log_neighbor_changes": {
        "type": "bool",
        "default": true,
        "description": "Log BGP neighbor state changes"
      },
      "neighbors": {
        "type": "list",
        "default": [],
        "description": "BGP peers to configure",
        "items": {
          "ip": {
            "type": "string",
            "description": "Neighbor IP address or hostname"
          },
          "asn": {
            "type": "number",
            "description": "Neighbor AS number"
          },
          "description": {
            "type": "string",
            "default": "",
            "description": "Neighbor description (for documentation)"
          },
          "passive": {
            "type": "bool",
            "default": false,
            "description": "Listen only (no active connection)"
          },
          "password": {
            "type": "string",
            "default": "",
            "description": "MD5 password for TCP authentication"
          },
          "update_source": {
            "type": "string",
            "default": "",
            "description": "Source interface or IP for BGP session"
          },
          "ebgp_multihop": {
            "type": "number",
            "default": null,
            "description": "TTL for EBGP multihop (2+ when not directly connected)"
          },
          "timers": {
            "type": "object",
            "default": null,
            "items": {
              "keepalive": {
                "type": "number",
                "default": 30,
                "description": "Keepalive interval in seconds"
              },
              "holdtime": {
                "type": "number",
                "default": 90,
                "description": "Hold timer in seconds"
              }
            }
          },
          "route_map_in": {
            "type": "string",
            "default": "",
            "description": "Route-map applied to incoming routes"
          },
          "route_map_out": {
            "type": "string",
            "default": "",
            "description": "Route-map applied to outgoing routes"
          },
          "next_hop_self": {
            "type": "bool",
            "default": false,
            "description": "Set next-hop to self for EBGP peers"
          },
          "weight": {
            "type": "number",
            "default": null,
            "description": "Default weight for routes from this peer"
          }
        }
      },
      "networks": {
        "type": "list",
        "default": [],
        "description": "Statically announce networks (global level)",
        "items": {
          "type": "object",
          "items": {
            "prefix": {
              "type": "string",
              "description": "Network prefix (e.g., '192.0.2.0/24')"
            }
          }
        },
        "redistribute": {
          "type": "list",
          "default": [],
          "description": "Protocols to redistribute into BGP",
          "items": {
            "protocol": {
              "type": "string",
              "description": "Protocol name: connected, kernel, static, ospf, isis, rip"
            },
            "route_map": {
              "type": "string",
              "default": "",
              "description": "Route-map to filter/redistribute"
            }
          }
        },
        "address_families": {
          "type": "object",
          "default": {},
          "items": {
            "ipv4_unicast": {
              "type": "object",
              "default": {},
              "items": {
                "networks": {
                  "type": "list",
                  "default": [],
                  "items": {
                    "type": "object",
                    "items": {
                      "prefix": {
                        "type": "string",
                        "description": "Network prefix (e.g., '192.0.2.0/24')"
                      }
                    }
                  },
                  "redistribute": {
                    "type": "list",
                    "default": [],
                    "items": {
                      "protocol": {
                        "type": "string",
                        "description": "Protocol name"
                      },
                      "route_map": {
                        "type": "string",
                        "default": "",
                        "description": "Route-map for redistribution"
                      }
                    }
                  },
                  "neighbors": {
                    "type": "list",
                    "default": [],
                    "items": {
                      "ip": {
                        "type": "string",
                        "description": "Neighbor IP"
                      },
                      "route_map_in": {
                        "type": "string",
                        "default": "",
                        "description": "Route-map for inbound"
                      },
                      "route_map_out": {
                        "type": "string",
                        "default": "",
                        "description": "Route-map for outbound"
                      }
                    }
                  }
                }
              },
              "ipv6_unicast": {
                "type": "object",
                "default": {},
                "items": {
                  "networks": {
                    "type": "list",
                    "default": [],
                    "items": {
                      "type": "object",
                      "items": {
                        "prefix": {
                          "type": "string",
                          "description": "IPv6 prefix (e.g., '2001:db8::/32')"
                        }
                      }
                    },
                    "neighbors": {
                      "type": "list",
                      "default": [],
                      "items": {
                        "ip": {
                          "type": "string",
                          "description": "Neighbor IPv6 address"
                        },
                        "route_map_in": {
                          "type": "string",
                          "default": "",
                          "description": "Route-map for inbound"
                        },
                        "route_map_out": {
                          "type": "string",
                          "default": "",
                          "description": "Route-map for outbound"
                        }
                      }
                    }
                  }
                },
                "ipv4_mpls_labeled_unicast": {
                  "type": "object",
                  "default": {},
                  "items": {
                    "neighbors": {
                      "type": "list",
                      "default": [],
                      "items": {
                        "ip": {
                          "type": "string",
                          "description": "Neighbor IPv4 address for MPLS Labeled Unicast"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "ospf": {
          "type": "object",
          "default": {
            "enabled": false
          },
          "description": "OSPF routing configuration",
          "items": {
            "enabled": {
              "type": "bool",
              "default": false,
              "description": "Enable OSPF"
            },
            "instance_id": {
              "type": "number",
              "default": 0,
              "description": "OSPF instance ID (0\u2013255); use only if multi-instance"
            },
            "router_id": {
              "type": "string",
              "default": "",
              "description": "OSPF router-id (e.g., '192.0.2.1')"
            },
            "areas": {
              "type": "list",
              "default": [],
              "items": {
                "id": {
                  "type": "string",
                  "description": "Area ID (e.g., '0.0.0.0' or '0')"
                },
                "type": {
                  "type": "string",
                  "default": "standard",
                  "description": "Area type: standard, stub, nssa"
                }
              }
            },
            "interfaces": {
              "type": "list",
              "default": [],
              "items": {
                "name": {
                  "type": "string",
                  "description": "Interface name (e.g., 'eth0')"
                },
                "area": {
                  "type": "string",
                  "description": "OSPF area ID"
                },
                "cost": {
                  "type": "number",
                  "default": null,
                  "description": "Interface OSPF cost"
                },
                "priority": {
                  "type": "number",
                  "default": null,
                  "description": "OSPF priority (for DR election)"
                }
              }
            },
            "redistribute": {
              "type": "list",
              "default": [],
              "items": {
                "protocol": {
                  "type": "string",
                  "description": "Protocol name: connected, kernel, static, bgp, isis, rip"
                },
                "route_map": {
                  "type": "string",
                  "default": "",
                  "description": "Route-map for filtering"
                }
              }
            }
          }
        },
        "rip": {
          "type": "object",
          "default": {
            "enabled": false
          },
          "description": "RIPv2 configuration",
          "items": {
            "enabled": {
              "type": "bool",
              "default": false,
              "description": "Enable RIPv2"
            },
            "version": {
              "type": "number",
              "default": 2,
              "description": "RIP version (2 recommended)"
            },
            "default_information_originate": {
              "type": "bool",
              "default": false,
              "description": "Originate default route into RIP"
            },
            "networks": {
              "type": "list",
              "default": [],
              "items": {
                "type": "object",
                "items": {
                  "prefix": {
                    "type": "string",
                    "description": "Network prefix (e.g., '10.0.0.0/8')"
                  }
                }
              },
              "redistribute": {
                "type": "list",
                "default": [],
                "items": {
                  "protocol": {
                    "type": "string",
                    "description": "Protocol name: connected, kernel, static, bgp, ospf, isis"
                  }
                }
              }
            }
          },
          "isis": {
            "type": "object",
            "default": {
              "enabled": false
            },
            "description": "IS-IS configuration",
            "items": {
              "enabled": {
                "type": "bool",
                "default": false,
                "description": "Enable IS-IS"
              },
              "instance_id": {
                "type": "string",
                "default": "",
                "description": "Optional IS-IS instance tag"
              },
              "net": {
                "type": "string",
                "default": "",
                "description": "Network Entity Title (NET) \u2014 e.g., '49.0001.1921.6800.1001.00'"
              },
              "is_type": {
                "type": "string",
                "default": "level-1-2",
                "description": "IS type: level-1, level-1-2, level-2-only"
              },
              "metric_style": {
                "type": "string",
                "default": "narrow",
                "description": "Metric style: narrow, wide"
              },
              "area_tag": {
                "type": "string",
                "default": "1",
                "description": "Area tag used in interface configuration"
              },
              "interfaces": {
                "type": "list",
                "default": [],
                "items": {
                  "name": {
                    "type": "string",
                    "description": "Interface name"
                  },
                  "circuit_type": {
                    "type": "string",
                    "default": "level-1-2",
                    "description": "Circuit type"
                  },
                  "metric": {
                    "type": "number",
                    "default": null,
                    "description": "IS-IS interface metric"
                  }
                }
              },
              "redistribute": {
                "type": "list",
                "default": [],
                "items": {
                  "protocol": {
                    "type": "string",
                    "description": "Protocol name: connected, kernel, static, bgp, ospf, rip"
                  }
                }
              }
            }
          },
          "route_maps": {
            "type": "list",
            "default": [],
            "description": "Route maps for policy routing",
            "items": {
              "name": {
                "type": "string",
                "description": "Route-map name"
              },
              "action": {
                "type": "string",
                "description": "Action: permit, deny"
              },
              "sequence": {
                "type": "number",
                "description": "Sequence number (e.g., 10, 20)"
              },
              "description": {
                "type": "string",
                "default": "",
                "description": "Description for documentation"
              },
              "match_ip_prefix_list": {
                "type": "string",
                "default": "",
                "description": "Prefix list to match"
              },
              "match_as_path": {
                "type": "string",
                "default": "",
                "description": "AS path access list to match"
              },
              "set_local_pref": {
                "type": "number",
                "default": null,
                "description": "Local preference to set"
              },
              "set_metric": {
                "type": "number",
                "default": null,
                "description": "Metric to set"
              },
              "set_next_hop": {
                "type": "string",
                "default": "",
                "description": "Next hop IP to set"
              },
              "set_community": {
                "type": "string",
                "default": "",
                "description": "Community value(s) to set"
              }
            }
          },
          "prefix_lists": {
            "type": "list",
            "default": [],
            "description": "IP prefix lists for filtering",
            "items": {
              "name": {
                "type": "string",
                "description": "Prefix list name"
              },
              "entries": {
                "type": "list",
                "description": "List of entries (order matters)",
                "items": {
                  "action": {
                    "type": "string",
                    "description": "permit or deny"
                  },
                  "prefix": {
                    "type": "string",
                    "description": "Network prefix (e.g., '192.0.2.0/24')"
                  },
                  "ge": {
                    "type": "number",
                    "default": null,
                    "description": "Minimum prefix length"
                  },
                  "le": {
                    "type": "number",
                    "default": null,
                    "description": "Maximum prefix length"
                  }
                }
              }
            }
          },
          "as_path_lists": {
            "type": "list",
            "default": [],
            "description": "AS path access lists for BGP path filtering",
            "items": {
              "name": {
                "type": "string",
                "description": "AS path list name"
              },
              "entries": {
                "type": "list",
                "description": "List of AS path entries",
                "items": {
                  "action": {
                    "type": "string",
                    "description": "permit or deny"
                  },
                  "pattern": {
                    "type": "string",
                    "description": "AS path regex (e.g., '_65535$', '^65001_')"
                  }
                }
              }
            }
          },
          "community_lists": {
            "type": "list",
            "default": [],
            "description": "Community lists (standard or expanded) for BGP communities",
            "items": {
              "name": {
                "type": "string",
                "description": "Community list name"
              },
              "type": {
                "type": "string",
                "description": "List type: standard or expanded"
              },
              "entries": {
                "type": "list",
                "description": "List of entries",
                "items": {
                  "action": {
                    "type": "string",
                    "description": "permit or deny"
                  },
                  "value": {
                    "type": "string",
                    "description": "Community value for standard lists (e.g., '65001:100')"
                  },
                  "regex": {
                    "type": "string",
                    "description": "Regex for expanded lists (e.g., '^65001:')"
                  }
                }
              }
            }
          },
          "zebra": {
            "type": "object",
            "default": {
              "enabled": true
            },
            "description": "Zebra daemon configuration (core routing manager)",
            "items": {
              "enabled": {
                "type": "bool",
                "default": true,
                "description": "Enable Zebra daemon"
              },
              "log_changes": {
                "type": "bool",
                "default": true,
                "description": "Log routing changes"
              },
              "ipv6_unicast": {
                "type": "bool",
                "default": false,
                "description": "Enable IPv6 unicast in Zebra"
              },
              "ipv4_unicast": {
                "type": "bool",
                "default": true,
                "description": "Enable IPv4 unicast in Zebra"
              },
              "ecmp": {
                "type": "number",
                "default": null,
                "description": "Maximum ECMP paths (1\u201364)"
              },
              "vty_port": {
                "type": "bool",
                "default": true,
                "description": "Enable vtysh for CLI"
              },
              "vtysh_pager": {
                "type": "string",
                "default": "lines 0",
                "description": "Pager setting for vtysh (e.g., 'lines 0' for unlimited)"
              }
            }
          }
        },
        "sample_values": {
          "hostname": "edge-rtr-01",
          "router_id": "203.0.113.1",
          "logging": {
            "level": "info",
            "files": {
              "path": "/var/log/frr/frr.log"
            }
          },
          "ipv4_unicast": true,
          "ipv6_unicast": false,
          "bgp": {
            "enabled": true,
            "asn": 65534,
            "router_id": "203.0.113.1",
            "graceful_restart": true,
            "log_neighbor_changes": true,
            "neighbors": [
              {
                "ip": "192.0.2.2",
                "asn": 65535,
                "description": "ISP peer",
                "password": "supersecret123",
                "update_source": "lo0",
                "route_map_in": "from-isp",
                "route_map_out": "to-isp",
                "next_hop_self": true,
                "weight": 100
              },
              {
                "ip": "192.0.2.6",
                "asn": 65534,
                "description": "Internal iBGP peer",
                "passive": true,
                "update_source": "lo0",
                "timers": {
                  "keepalive": 10,
                  "holdtime": 30
                }
              }
            ],
            "networks": [
              {
                "prefix": "203.0.113.0/24"
              },
              {
                "prefix": "198.51.100.0/24"
              }
            ],
            "redistribute": [
              {
                "protocol": "static",
                "route_map": "static-to-bgp"
              },
              {
                "protocol": "connected"
              }
            ],
            "address_families": {
              "ipv4_unicast": {
                "networks": [
                  {
                    "prefix": "203.0.113.0/24"
                  }
                ],
                "redistribute": [
                  {
                    "protocol": "static",
                    "route_map": "static-to-bgp"
                  }
                ],
                "neighbors": [
                  {
                    "ip": "192.0.2.2",
                    "route_map_in": "from-isp-af",
                    "route_map_out": "to-isp-af"
                  }
                ]
              }
            }
          },
          "ospf": {
            "enabled": true,
            "router_id": "198.51.100.1",
            "areas": [
              {
                "id": "0.0.0.0",
                "type": "standard"
              }
            ],
            "interfaces": [
              {
                "name": "eth0",
                "area": "0.0.0.0",
                "cost": 10
              },
              {
                "name": "eth1",
                "area": "0.0.0.0",
                "priority": 100
              }
            ],
            "redistribute": [
              {
                "protocol": "connected",
                "route_map": "conn-to-ospf"
              }
            ]
          },
          "rip": {
            "enabled": false
          },
          "isis": {
            "enabled": true,
            "net": "49.0001.1921.6800.1001.00",
            "is_type": "level-2-only",
            "metric_style": "wide",
            "area_tag": "1",
            "interfaces": [
              {
                "name": "ge-0/0/0",
                "circuit_type": "level-2-only",
                "metric": 50
              }
            ]
          },
          "route_maps": [
            {
              "name": "from-isp",
              "action": "permit",
              "sequence": 10,
              "description": "Apply community and set local pref for ISP routes",
              "match_ip_prefix_list": "from-isp-pl",
              "set_local_pref": 150,
              "set_community": "65535:100"
            }
          ],
          "prefix_lists": [
            {
              "name": "from-isp-pl",
              "entries": [
                {
                  "action": "permit",
                  "prefix": "203.0.113.0/24"
                },
                {
                  "action": "deny",
                  "prefix": "0.0.0.0/0",
                  "ge": 0,
                  "le": 31
                }
              ]
            }
          ],
          "as_path_lists": [
            {
              "name": "peer-as",
              "entries": [
                {
                  "action": "permit",
                  "pattern": "^65535$"
                }
              ]
            }
          ],
          "community_lists": [
            {
              "name": "isp-comm",
              "type": "standard",
              "entries": [
                {
                  "action": "permit",
                  "value": "65535:100"
                }
              ]
            }
          ],
          "zebra": {
            "enabled": true,
            "ipv4_unicast": true,
            "ipv6_unicast": false,
            "ecmp": 4,
            "vty_port": true,
            "vtysh_pager": "lines 0"
          }
        }
      }
    }
  }
}
