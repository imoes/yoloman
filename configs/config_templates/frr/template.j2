# =============================================================================
# FRR (Free Routing Router) Configuration Template
# =============================================================================
# This template generates the primary configuration file for FRR (zebra, bgp,
# ospfd, etc.).
#
# IMPORTANT: FRR's configuration shell, vtysh, dynamically edits the live,
# in-memory configuration while FRR is running. When instructed, vtysh will
# persist the live configuration to this file, potentially overwriting its
# contents.
#
# To avoid this overwrite behavior:
# 1. Edit this file manually before starting FRR, OR
# 2. Instruct vtysh to write the configuration to a different file.
#
# By default, FRR logs to syslog. If you wish to change the log destination
# or level, configure it here. The system logger (e.g., rsyslog) should be
# configured to capture FRR messages (typically facility 'daemon') if
# specific log files are desired (e.g., /var/log/frr/frr.log).

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Sets the default logging level for FRR.
# Valid values: debug, info, notice, warning, error, crit, alert, emerg.
# Default: info
# -----------------------------------------------------------------------------
log syslog {{ (logging | default({})).level | default('info') }}
