<!DOCTYPE Menu
  PUBLIC '-//freedesktop//DTD Menu 1.0//EN'
  'http://standards.freedesktop.org/menu-spec/menu-1.0.dtd'>
<Menu>
	{# The top-level name of the menu (e.g., 'Applications'). #}
	<Name>{{ applications_menu_name | default('Applications') }}</Name>
	<Menu>
		{# The name of the submenu for Wine applications (e.g., 'Wine'). #}
		<Name>{{ wine_menu_name | default('wine-wine') }}</Name>
		{# The directory file associated with the Wine submenu (e.g., 'Wine.directory'). #}
		<Directory>{{ wine_menu_directory | default('Wine.directory') }}</Directory>
		<Include>
			{# The category filter for including items in the Wine submenu (e.g., 'X-Wine'). #}
			<Category>{{ wine_menu_category | default('X-Wine') }}</Category>
		</Include>
	</Menu>
</Menu>
