{
  "archive_prefix": "server-backup",
  "backup_dir": "/mnt/backup/backup2l",
  "max_full_backups": 3,
  "max_incr_backups": 7,
  "full_backup_threshold_mb": 1000,
  "compress": true,
  "verify": true,
  "include_dirs": [
    "/etc",
    "/home",
    "/var/www",
    "/var/lib/mysql"
  ],
  "exclude_patterns": [
    "*/.cache/*",
    "*.log",
    "/proc/*",
    "/sys/*",
    "/tmp/*"
  ],
  "tar_opts": [
    "--numeric-owner",
    "--ignore-failed-read",
    "--one-file-system"
  ],
  "pre_backup_script": "/usr/local/bin/mysql-dump-all.sh",
  "post_backup_script": "/usr/local/bin/backup-sync-remote.sh",
  "notify_email": "admin@example.com",
  "notify_subject_prefix": "[backup2l] server-backup",
  "notify_level": "warn",
  "log_file": "/var/log/backup2l/server.log",
  "verbosity": 2
}
