{
  "bind_host": "127.0.0.1",
  "bind_port": 9100,
  "queue_dir": "/var/lib/debci/collector/queue",
  "max_payload_size": 52428800,
  "max_workers": 8,
  "use_ssl": true,
  "ssl_cert": "/etc/debci/ssl/debci_collector.crt",
  "ssl_key": "/etc/debci/ssl/debci_collector.key",
  "log_level": "info",
  "log_file": "/var/log/debci/collector.log",
  "upstream_collectors": [
    {
      "host": "debci-master.example.org",
      "port": 9100
    },
    {
      "host": "debci-backup.example.org",
      "port": 9100
    }
  ],
  "forward_results": true,
  "archive_ttl": 2592000,
  "db_uri": "postgresql://debci:secret@db.internal/debci_collector",
  "use_db": true,
  "health_check_interval": 60,
  "health_check_path": "/health"
}
