{
  "ignore_arch": [
    "i386"
  ],
  "ignore_arch_flag": [
    "i386:-pie"
  ],
  "ignore_arch_line": [
    "armel:.*gcc.*-g0.*"
  ],
  "ignore_flag": [
    "-g"
  ],
  "ignore_line": [
    "^\\s*echo.*\\$\\(CC\\).*"
  ],
  "build_flags": [
    "-fPIE",
    "-pie",
    "-Wl,-z,now",
    "-Wl,-z,relro"
  ],
  "buildd_mode": true,
  "debian_mode": true,
  "arch": "amd64",
  "color_output": true,
  "line_numbers": true
}
