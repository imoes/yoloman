# WCC (Witchcraft Core Compiler) Configuration Template
# This template generates a configuration block representing command-line flags
# for the WCC binary. Each section corresponds to a specific compiler/linker flag.
# Variables are sourced from Ansible variables with schema-defined defaults.

# The path for the output ELF binary or relocatable object file.
# Corresponds to: -o, --output <output file>
Output: {{ output_file | default('/tmp/compiled.o') }}

# The target architecture (e.g., x86_64, i386).
# Corresponds to: -m, --march <architecture>
Architecture: {{ arch | default('x86_64') }}

# The entry point address in hexadecimal format.
# Corresponds to: -e, --entrypoint <0xaddress>
Entrypoint: {{ entrypoint | default('0x00000000') }}

# The interpreter to use for the binary.
# Corresponds to: -i, --interpreter <interpreter>
Interpreter: {{ interpreter | default('') }}

# Poison value for the binary.
# Corresponds to: -p, --poison <poison>
Poison: {{ poison | default('') }}

# Enable shared library output mode.
# Corresponds to: -s, --shared
# If true, generates a shared object linked via gcc -shared.
Shared: {{ shared | default(False) }}

# Enable compile mode to create relocatable objects.
# Corresponds to: -c, --compile
Compile: {{ compile | default(True) }}

# Enable static linking mode.
# Corresponds to: -S, --static
Static: {{ static | default(False) }}

# Enable stripping of symbols.
# Corresponds to: -x, --strip
Strip: {{ strip | default(False) }}

# Enable stripping of relocations.
# Corresponds to: -X, --sstrip
Sstrip: {{ sstrip | default(False) }}

# Enable executable output mode.
# Corresponds to: -E, --exec
Exec: {{ exec | default(False) }}

# Enable core dump mode.
# Corresponds to: -C, --core
Core: {{ core | default(False) }}

# Preserve original format.
# Corresponds to: -O, --original
Original: {{ original | default(False) }}

# Enable disassembly mode.
# Corresponds to: -D, --disasm
Disasm: {{ disasm | default(False) }}

# Enable debug output.
# Corresponds to: -d, --debug
Debug: {{ debug | default(False) }}

# Enable verbose output.
# Corresponds to: -v, --verbose
Verbose: {{ verbose | default(False) }}

# The input binary file (ELF, PE, etc.) to process.
InputFile: {{ input_file | default('/bin/ls') }}