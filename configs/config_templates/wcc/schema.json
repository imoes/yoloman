{
  "output_file": {
    "type": "string",
    "default": "/tmp/compiled.o",
    "description": "The path for the output ELF binary or relocatable object file."
  },
  "arch": {
    "type": "string",
    "default": "x86_64",
    "description": "The target architecture (e.g., x86_64, i386)."
  },
  "entrypoint": {
    "type": "string",
    "default": "0x00000000",
    "description": "The entry point address in hexadecimal format."
  },
  "interpreter": {
    "type": "string",
    "default": "",
    "description": "The interpreter to use for the binary."
  },
  "poison": {
    "type": "string",
    "default": "",
    "description": "Poison value for the binary."
  },
  "shared": {
    "type": "bool",
    "default": false,
    "description": "Enable shared library output mode."
  },
  "compile": {
    "type": "bool",
    "default": true,
    "description": "Enable compile mode to create relocatable objects."
  },
  "static": {
    "type": "bool",
    "default": false,
    "description": "Enable static linking mode."
  },
  "strip": {
    "type": "bool",
    "default": false,
    "description": "Enable stripping of symbols."
  },
  "sstrip": {
    "type": "bool",
    "default": false,
    "description": "Enable stripping of relocations."
  },
  "exec": {
    "type": "bool",
    "default": false,
    "description": "Enable executable output mode."
  },
  "core": {
    "type": "bool",
    "default": false,
    "description": "Enable core dump mode."
  },
  "original": {
    "type": "bool",
    "default": false,
    "description": "Preserve original format."
  },
  "disasm": {
    "type": "bool",
    "default": false,
    "description": "Enable disassembly mode."
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug output."
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output."
  },
  "input_file": {
    "type": "string",
    "default": "/bin/ls",
    "description": "The input binary file (ELF, PE, etc.) to process."
  }
}
