# /etc/gpgv-sq.conf — configuration for gpgv-sq(1)
#
# This file is generated by Ansible. It contains the command-line arguments
# passed to the `gpgv-sq` verification utility. Each directive is preceded
# by a comment describing its purpose and default behavior.

# Enable verbose output (maps to --verbose)
# Default: False (verbose mode is off by default)
{% if (verbose | default(False) | bool) %}
--verbose
{% endif %}

# Suppress non-essential output (maps to --quiet)
# Default: False (quiet mode is off by default)
{% if (quiet | default(False) | bool) %}
--quiet
{% endif %}

# Path to keyring file (maps to --keyring)
# Default: '' (empty string uses the system default: trustedkeys.kbx in $GNUPGHOME)
{% if (keyring | default('') | trim) %}
--keyring {{ keyring | default('') | trim | string }}
{% endif %}

# Path to write output (maps to -o)
# Default: '' (empty string writes to stdout)
{% if (output | default('') | trim) %}
-o {{ output | default('') | trim | string }}
{% endif %}

# Treat timestamp conflicts as warnings (maps to --ignore-time-conflict)
# Default: False (timestamp conflicts cause verification failure by default)
{% if (ignore_time_conflict | default(False) | bool) %}
--ignore-time-conflict
{% endif %}

# File descriptor number for status output (maps to --status-fd)
# Default: '' (empty string disables status fd output; valid FDs are usually 2, 3, etc.)
{% if (status_fd | default('') | trim) %}
--status-fd {{ status_fd | default('') | trim | string }}
{% endif %}

# List of algorithm names to reject signatures using (maps to --weak-digest ALGO...)
# Default: [] (empty list; no specific weak algorithms are rejected beyond system defaults)
# Each item in the list generates a separate --weak-digest argument.
{% if (weak_digests | default([]) | list | length > 0) %}
{% for algo in weak_digests | default([]) | list %}
--weak-digest {{ algo | string | trim }}
{% endfor %}
{% endif %}

# Absolute path to override default crypto policy file (maps to SEQUOIA_CRYPTO_POLICY env var)
# Default: '' (empty string uses the system default, typically /etc/crypto-policies/back-ends/sequoia.config)
{% if (crypto_policy_file | default('') | trim) %}
export SEQUOIA_CRYPTO_POLICY={{ crypto_policy_file | default('') | trim | string }}
{% endif %}

# Absolute path to override $GNUPGHOME (maps to GNUPGHOME env var)
# Default: '' (empty string uses the user's default: $HOME/.gnupg)
{% if (gnupghome | default('') | trim) %}
export GNUPGHOME={{ gnupghome | default('') | trim | string }}
{% endif %}