# runit configuration file
#
# This file is managed by Ansible. Do not edit directly.
# Provides the global default settings for the runit init system.

# runit is able to poweroff by itself after stage3 returns
#
# When set to true, runit will issue a poweroff command after the
# init stages (including stage3) have completed successfully.
# This is useful for single-task containers or batch jobs where
# the container should stop itself upon completion.
#
# Schema Description: Enable automatic poweroff after stage3 completion.
# Default: false
# Type: boolean
runit_poweroff_stage3={{ runit_poweroff_stage3 | default(false) | lower }}