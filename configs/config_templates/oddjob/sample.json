{
  "lib_dir": "/usr/lib/oddjob",
  "pid_file": "/run/oddjobd.pid",
  "max_threads": 10,
  "debug": false,
  "run_dir": "/run/oddjob",
  "chroot": false,
  "user": "oddjobd",
  "group": "oddjobd",
  "session_tracking": true,
  "services": [
    {
      "name": "mkhomedir",
      "path": "/usr/lib/oddjob/oddjob-mkhomedir",
      "enabled": true,
      "timeout": 5,
      "user": "root"
    },
    {
      "name": "create-home",
      "path": "/usr/lib/oddjob/oddjob-create-home",
      "enabled": true,
      "timeout": 5
    },
    {
      "name": "pam_mkhomedir",
      "path": "/usr/lib/oddjob/oddjob-mkhomedir",
      "enabled": false
    }
  ]
}
