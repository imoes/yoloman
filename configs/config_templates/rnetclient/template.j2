# Configuration for rnetclient service invocation
# Path to the declaration (report) file to be sent to Receita Federal.
# Corresponds to the -d/--declaration option.
declaration_file: {{ declaration_file | default('/home/user/irpf2024.pdf') }}

# Path to the directory where the receipt will be saved.
# Corresponds to the -o/--output-dir option.
# If empty or not specified, the receipt is saved in the current working directory.
output_dir: {{ output_dir | default('/home/user/receipts') }}