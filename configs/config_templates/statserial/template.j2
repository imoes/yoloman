#!/bin/bash
# Command to run statserial: the base executable.
EXECUTABLE=/usr/bin/statserial

# Serial device file to monitor.
# Schema description: The serial port device file to read modem status lines from.
# Default: /dev/ttyS0
DEVICE="{{ device | default('/dev/ttyS0') }}"

# Disable continuous looping (run once and exit) if true.
# Schema description: If true, statserial displays status once and exits instead of looping.
# Default: False
NO_LOOP={{ no_loop | default(False) }}

# Output decimal bitmask of modem status lines if true.
# Schema description: If true, print modem status as a decimal number.
# Default: False
DECIMAL={{ decimal | default(False) }}

# Output hexadecimal bitmask of modem status lines if true (mutually exclusive with decimal).
# Schema description: If true, print modem status as a hexadecimal number.
# Default: False
HEXA={{ hexa | default(False) }}