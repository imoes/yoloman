#!/bin/sh
# xtitle configuration script
# This script serves as a wrapper to apply xtitle settings.
# Since xtitle is a CLI tool, this template generates a helper script
# that applies the configured title and icon settings.

# Set window title
{% if title %}
TITLE_CMD="-t {{ title }}"
{% endif %}

# Set icon name
{% if icon_name %}
ICON_CMD="-i {{ icon_name }}"
{% endif %}

# Quiet mode flag
{% if quiet %}
QUIET_CMD="-q"
{% endif %}

# Execute xtitle with selected options
# If no options are selected, run xtitle without flags (default behavior)
xtitle {{ title_cmd | default('') }} {{ icon_cmd | default('') }} {{ quiet_cmd | default('') }}
