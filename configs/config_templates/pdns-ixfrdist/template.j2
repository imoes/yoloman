{#
  # ixfrdist Configuration Template
  #
  # This template generates the YAML configuration file for pdns-ixfrdist.
  # It is self-documenting: every directive is preceded by a comment
  # explaining its purpose, derived from the schema description.
  #
  # Variables are sourced from the Ansible inventory/group_vars.
  # If a variable is undefined, a safe default is used as specified
  # in the schema.
  #}

{# -------------------------------------------------------------------------- #}
{# General Settings                                                           #}
{# -------------------------------------------------------------------------- #}

# The directory where the domain data is stored.
# When unset, the current working directory is used. Note that this directory
# must be writable for the user or group ixfrdist runs as.
work_dir: '{{ work_dir | default("/var/lib/ixfrdist") }}'

# User to drop privileges to once all listen-sockets are bound.
# May be either a username or numerical ID.
uid: '{{ uid | default("_ixfrdist") }}'

# Group to drop privileges to once all listen-sockets are bound.
# May be either a username or numerical ID.
gid: '{{ gid | default("_ixfrdist") }}'

{# -------------------------------------------------------------------------- #}
{# Network & Access Control                                                   #}
{# -------------------------------------------------------------------------- #}

# Listen addresses. ixfrdist will listen on both UDP and TCP.
# When no port is specified, 53 is used. When specifying ports for IPv6, use
# the "bracket" notation (e.g., '[::1]:5353').
# By default, ixfrdist listens on local loopback addresses.
#
# Format:
#   listen:
#     - '127.0.0.1'
#     - '::1'
#     - '192.0.2.3:5300'
#     - '[2001:DB8:1234::334]:5353'
#
listen_addresses: >-
  {{ listen_addresses | default(['127.0.0.1', '::1']) | to_nice_yaml | trim }}

# Netmasks or IP addresses of hosts that are allowed to query ixfrdist.
# Hosts do not need a netmask.
# By default, only loopback addresses are allowed.
#
# Format:
#   allowed_acls:
#     - '127.0.0.0/8'
#     - '::1'
#     - '192.0.2.55'
#     - '2001:DB8:ABCD::/48'
#
allowed_acls: >-
  {{ allowed_acls | default(['127.0.0.0/8', '::1']) | to_nice_yaml | trim }}

{# -------------------------------------------------------------------------- #}
{# AXFR/IXFR Behavior                                                         #}
{# -------------------------------------------------------------------------- #}

# Maximum number of records allowed in a single zone.
# ixfrdist will abort the zone transfer from the master when more than this
# number of records have been received. A value of 0 means unlimited.
axfr_max_records: '{{ axfr_max_records | default(0) }}'

# Timeout in seconds an AXFR transaction requested by ixfrdist may take.
# Increase this when the network to the authoritative servers is slow or the
# domains are very large and you experience timeouts.
axfr_timeout: '{{ axfr_timeout | default(20) }}'

# Time in seconds between retries of the SOA query for a zone we have never
# transferred.
failed_soa_retry: '{{ failed_soa_retry | default(30) }}'

# Whether record compression should be enabled, leading to smaller answers
# at the cost of an increased CPU and memory usage.
compress: '{{ compress | default(false) }}'

# Amount of older copies/IXFR diffs to keep for every domain.
keep: '{{ keep | default(20) }}'

# Number of threads to spawn for TCP connections (AXFRs) from downstream hosts.
tcp_in_threads: '{{ tcp_in_threads | default(10) }}'

{# -------------------------------------------------------------------------- #}
{# Webserver (Monitoring)                                                     #}
{# -------------------------------------------------------------------------- #}

# The IP address and port where the webserver should listen.
# Empty string disables it.
webserver_address: '{{ webserver_address | default("") }}'

# The IP address(masks) that allowed to access the webserver.
# When not set, it defaults to 127.0.0.0/8, ::1/128.
webserver_acls: >-
  {{ webserver_acls | default(['127.0.0.0/8', '::1/128']) | to_nice_yaml | trim }}

{# -------------------------------------------------------------------------- #}
{# Domain Definitions                                                         #}
{# -------------------------------------------------------------------------- #}

# The domains to redistribute.
# The 'domain' and 'master' keys are mandatory for each entry.
# When no port is specified on the master, 53 is used.
# When specifying ports for IPv6, use the "bracket" notation:
#
# Example:
#   domains:
#     - domain: example.com
#       master: 192.0.2.15
#     - domain: rpz.example
#       master: '[2001:DB8:a34:543::53]:5353'
#
domains: >-
  {{ domains | default([]) | to_nice_yaml | trim }}
