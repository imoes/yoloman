{
  "debug_mode": false,
  "debug_log_file": "/var/log/icinga2/debug.log",
  "features": [
    {
      "name": "api",
      "enabled": true,
      "config": {
        "api_user": "icinga2",
        "api_password": ""
      }
    },
    {
      "name": "checker",
      "enabled": true,
      "config": {}
    },
    {
      "name": "notification",
      "enabled": true,
      "config": {}
    },
    {
      "name": "mainlog",
      "enabled": true,
      "config": {
        "log_file": "/var/log/icinga2/icinga2.log"
      }
    }
  ],
  "api_enabled": true,
  "api_node_name": "icinga2-node1",
  "api_zone_name": "zone-west",
  "api_host": "0.0.0.0",
  "api_port": 5665,
  "api_parent_zone": "zone-central",
  "notifications_enabled": true,
  "notification_interval": 300,
  "admin_email": "ops@example.com",
  "admin_pager": "pager@example.com",
  "notification_period": "24x7",
  "notification_types": [
    "Warning",
    "Critical",
    "Recovery"
  ],
  "hosts": [
    {
      "name": "webserver01",
      "display_name": "Web Server 01",
      "address": "192.168.1.10",
      "vars": {
        "os": "linux",
        "rack": "A2",
        "team": "infra"
      }
    },
    {
      "name": "dbserver01",
      "address": "192.168.1.20",
      "vars": {
        "os": "linux",
        "role": "database"
      }
    }
  ],
  "services": [
    {
      "host_name": "webserver01",
      "name": "HTTP",
      "check_command": "http",
      "interval": 60,
      "retry_interval": 10,
      "max_check_attempts": 3,
      "vars": {
        "http_port": 80,
        "http_ssl": false
      }
    },
    {
      "host_name": "dbserver01",
      "name": "MySQL",
      "check_command": "mysql",
      "interval": 60,
      "retry_interval": 10
    }
  ],
  "hostname": "icinga2-node1"
}
