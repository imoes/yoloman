{
  "inventory_dir": "/etc/ansible/inventory",
  "remote_user": "deploy",
  "host_key_checking": false,
  "forks": 20,
  "timeout": 30,
  "interpreter_python": "auto_silent",
  "fact_caching_enabled": true,
  "fact_caching_connection": "/var/tmp/ansible_facts",
  "fact_caching_type": "jsonfile",
  "roles_path": [
    "/etc/ansible/roles",
    "./roles"
  ],
  "log_path": "/var/log/ansible.log",
  "library_path": [
    "/usr/share/ansible/plugins/modules"
  ],
  "callbacks_enabled": [
    "profile_tasks",
    "timer",
    "log_plays"
  ],
  "retry_files_enabled": false,
  "retry_files_save_path": "",
  "gathering": "smart",
  "sudo_user": "root",
  "become": true,
  "become_method": "sudo",
  "become_user": "root",
  "ask_pass": false,
  "ask_sudo_pass": false,
  "ask_become_pass": true,
  "verbosity": 1,
  "deprecation_warnings": false,
  "show_custom_config": false,
  "transport": "ssh",
  "ssh_args": "-o ControlMaster=auto -o ControlPersist=60s",
  "paramiko_look_for_keys": false,
  "additional_host_patterns": {
    "webservers": {
      "ansible_python_interpreter": "/usr/bin/python3"
    },
    "dbservers": {
      "ansible_connection": "ssh",
      "ansible_user": "dbadmin"
    }
  },
  "sudo_command": "sudo -H -S -n %s",
  "ssh_connection_ssh_args": "-o ControlMaster=auto -o ControlPersist=60s",
  "ssh_connection_control_path": "%(directory)s/ansible-ssh-%%h-%%p-%%r",
  "ssh_connection_control_path_dir": "/tmp/ansible-ssh",
  "pipelining": true,
  "ssh_keepalive_interval": 30,
  "ssh_keepalive_timeout": 45,
  "sftp_batch_mode": true,
  "galaxy_server": "https://galaxy.ansible.com",
  "galaxy_roles_path": [
    "/etc/ansible/roles"
  ],
  "galaxy_ignore_certs": false,
  "galaxy_require_signature_to_publish": false,
  "galaxy_allow_unsigned": true,
  "galaxy_servers_list": {
    "myprivate": {
      "url": "https://galaxy.mycompany.com/api/v2",
      "username": "service_account",
      "token": "secret_token_here"
    }
  },
  "callback_whitelist": [],
  "diff_context": 5,
  "diff_always": true,
  "colors": {
    "ok": "green",
    "changed": "yellow",
    "unreachable": "red",
    "dark": "grey",
    "warn": "purple"
  }
}
