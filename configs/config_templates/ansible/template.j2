# Default settings for Ansible
[defaults]
# Directory where inventory files are stored
inventory = {{ inventory_dir }}

# Default remote user for connections
remote_user = {{ remote_user }}

# Enable/Disable host key checking
host_key_checking = {{ host_key_checking | string | lower }}

# How many parallel processes to use for task execution
forks = {{ forks }}

# Timeout for SSH connections (seconds)
timeout = {{ timeout }}

# Default command shell
interpreter_python = {{ interpreter_python }}

# Enable or disable fact caching
fact_caching = {{ fact_caching_enabled | string | lower }}

# Fact caching directory (used when caching is enabled)
fact_caching_connection = {{ fact_caching_connection }}

# Fact caching plugin type (e.g., jsonfile, redis)
fact_caching_type = {{ fact_caching_type }}

# Path to local roles directory (for dev/test)
roles_path = {{ roles_path | join(':') }}

# Default logging behavior
log_path = {{ log_path }}

# Default module path (for custom modules)
library = {{ library_path | join(':') }}

# Default callback plugins directory
callbacks_enabled = {{ callbacks_enabled | join(', ') }}

# Default retry file location (disable by leaving empty)
retry_files_enabled = {{ retry_files_enabled | string | lower }}
retry_files_save_path = {{ retry_files_save_path }}

# Default fact gathering mode: 'smart', 'explicit', or 'implicit'
gathering = {{ gathering }}

# Default sudo user
sudo_user = {{ sudo_user }}

# Default privilege escalation method
become = {{ become | string | lower }}
become_method = {{ become_method }}
become_user = {{ become_user }}

# Control whether Ansible asks for passwords interactively
ask_pass = {{ ask_pass | string | lower }}
ask_sudo_pass = {{ ask_sudo_pass | string | lower }}
ask_become_pass = {{ ask_become_pass | string | lower }}

# Control output verbosity
verbosity = {{ verbosity }}

# Enable or disable deprecation warnings
deprecation_warnings = {{ deprecation_warnings | string | lower }}

# Show all config values at runtime
show_custom_config = {{ show_custom_config | string | lower }}

# Default transport for connection
transport = {{ transport }}

# SSH arguments
ssh_args = {{ ssh_args }}

# Control parameterized connection retries
paramiko_look_for_keys = {{ paramiko_look_for_keys | string | lower }}

{% for host_pattern, pattern_config in additional_host_patterns.items() %}
# Custom settings for host pattern '{{ host_pattern }}'
[{{ host_pattern }}:vars]
{% for key, value in pattern_config.items() %}{{ key }} = {{ value }}
{% endfor %}
{% endfor %}

[privilege_escalation]
# Default sudo command format
sudo_command = {{ sudo_command }}

# Default su command format
su_command = {{ su_command }}

# Default pbrun command format
pbrun_command = {{ pbrun_command }}

# Default pfexec command format
pfexec_command = {{ pfexec_command }}

# Default doas command format
doas_command = {{ doas_command }}

# Default dzdo command format
dzdo_command = {{ dzdo_command }}

# Default ksu command format
ksu_command = {{ ksu_command }}

# Default runas command format
runas_command = {{ runas_command }}

[ssh_connection]
# SSH control path (for connection reuse)
ssh_args = {{ ssh_connection_ssh_args }}
control_path = {{ ssh_connection_control_path }}
control_path_dir = {{ ssh_connection_control_path_dir }}

# Use pipelining when possible (improves speed)
pipelining = {{ pipelining | string | lower }}

# Keep-alive interval for SSH (seconds)
ssh_keepalive_interval = {{ ssh_keepalive_interval }}

# Timeout for SSH keepalive attempts
ssh_keepalive_timeout = {{ ssh_keepalive_timeout }}

# Use sftp if available
sftp_batch_mode = {{ sftp_batch_mode | string | lower }}

[galaxy]
# Default server for galaxy role installation
server = {{ galaxy_server }}

# Path to store installed roles
galaxy_roles_path = {{ galaxy_roles_path | join(':') }}

# Skip certificate validation for galaxy
ignore_certs = {{ galaxy_ignore_certs | string | lower }}

# Require signature verification
require_signature_to_publish = {{ galaxy_require_signature_to_publish | string | lower }}

# Allow unsigned roles
allow_unsigned = {{ galaxy_allow_unsigned | string | lower }}

{% for server_name, server_details in galaxy_servers_list.items() %}
# Galaxy server configuration: {{ server_name }}
[galaxy_server.{{ server_name }}]
url = {{ server_details.url }}
username = {{ server_details.username }}
password = {{ server_details.password }}
token = {{ server_details.token }}
{% endfor %}

[callback_whitelist]
{% for callback_name in callback_whitelist %}
{{ callback_name }}
{% endfor %}

[diff]
# Show context in diffs
context = {{ diff_context }}

# Always show diff output (unless overridden)
always = {{ diff_always | string | lower }}

[colors]
# Terminal colors (optional customization)
{% for color_name, color_value in colors.items() %}
{{ color_name }} = {{ color_value }}
{% endfor %}