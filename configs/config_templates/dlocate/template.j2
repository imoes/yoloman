#!/bin/sh

# PATH environment variable used when executing update-dlocatedb.
# Defines the search path for executable commands during database update.
# Default: $PATH:/usr/bin:/bin:/usr/sbin:/sbin
PATH="{{ PATH | default('$PATH:/usr/bin:/bin:/usr/sbin:/sbin') }}"

# update databases for both files and packages.
# Checks if the update-dlocatedb utility is available before executing it.
if command -v update-dlocatedb >/dev/null; then
  # UPDATE_DLOCATEDB_CMD specifies the command executed to update the dlocate database.
  # Default: /usr/sbin/update-dlocatedb -b
  {{ UPDATE_DLOCATEDB_CMD | default('/usr/sbin/update-dlocatedb -b') }}
fi