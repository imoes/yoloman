# ==============================================================================
# PyJoke Configuration Template
#
# This template configures the PyJoke application. It manages the selection of
# joke content based on category and language preferences.
# ==============================================================================

# Category for joke selection (neutral, adult, chuck, all)
# Specifies which subset of the joke database to retrieve from.
# 'neutral' for general audience, 'adult' for mature content, 'chuck' for
# Chuck Norris jokes, 'all' for everything.
category: {{ category | default('neutral') }}

# Language for joke selection (en, de, es)
# Specifies the language in which jokes should be returned.
# Supported languages: 'en' (English), 'de' (German), 'es' (Spanish).
language: {{ language | default('en') }}