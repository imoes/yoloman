{
  "work_dir": "/var/www/mrtg",
  "default_snmp_community": "public",
  "default_snmp_version": "2c",
  "default_snmp_authname": "",
  "default_snmp_authpass": "",
  "default_snmp_privpass": "",
  "default_snmp_authproto": "md5",
  "default_snmp_privproto": "des",
  "interval": 300,
  "log_errors": true,
  "log_syslog": false,
  "enable_fast_refresh": true,
  "compress_logs": true,
  "generate_pngs": true,
  "generate_index": true,
  "debug": false,
  "html_title": "MRTG Monitor",
  "mrtg_bin": "/usr/bin/mrtg",
  "use_24_hour_time": true,
  "use_timezone": "UTC",
  "daemon_mode": false,
  "write_pid_file": "/var/run/mrtg/mrtg.pid",
  "targets": [
    {
      "name": "eth0_in",
      "label": "eth0 Inbound",
      "spec": "1.3.6.1.2.1.2.2.1.10.2:public@127.0.0.1",
      "description": "Inbound traffic on eth0 (OID 1.3.6.1.2.1.2.2.1.10.2)",
      "max_bits": 125000000,
      "growth_factor": "none",
      "traffic_unit": "bytes",
      "options": [
        "perminute",
        "gauge",
        "nosmooth"
      ],
      "title": "eth0 Inbound Traffic",
      "page_top": "<H1>eth0 Inbound Traffic</H1>"
    },
    {
      "name": "eth0_out",
      "label": "eth0 Outbound",
      "spec": "1.3.6.1.2.1.2.2.1.16.2:public@127.0.0.1",
      "max_bits": 125000000,
      "traffic_unit": "bytes",
      "options": [
        "perminute",
        "gauge",
        "nosmooth"
      ],
      "title": "eth0 Outbound Traffic",
      "page_top": "<H1>eth0 Outbound Traffic</H1>"
    }
  ]
}
