# ==============================================================================
# MRTG Configuration Template
# ==============================================================================
# This template generates a standard MRTG (Multi Router Traffic Grapher) configuration
# file. MRTG is used to monitor network traffic and generate HTML/graphic reports.
#
# Self-documenting: every directive is preceded by a comment explaining its purpose
# and mapping to the schema field description.
# ==============================================================================

# work_dir: Directory where MRTG stores generated HTML pages, graphs (PNGs), and log files.
# Must be writable by the MRTG user.
# Default: /var/www/mrtg
WorkDir: {{ work_dir | default('/var/www/mrtg') }}

# interval: Polling interval in seconds. Standard is 300 (5 minutes).
# Must match cron/daemon schedule to avoid gaps or double-sampling.
# Default: 300
Interval: {{ interval | default(300) }}

# ==============================================================================
# Logging Options
# ==============================================================================

# log_errors: If true, write errors to the log file.
# When false, error logging is disabled (commented out in the config).
# Default: true
{% if log_errors | default(true) | bool %}
# Error logging is enabled
{% else %}
# Error logging is disabled
# LogError:
{% endif %}

# log_syslog: If true, send log messages to syslog.
# Usually off unless integrating with a centralized logging system.
# Default: false
{% if log_syslog | default(false) | bool %}
# Syslog logging is enabled
{% else %}
# Syslog logging is disabled
# SyslogLog:
{% endif %}

# Combined logging status for reference
# Logging: {{ "errors" if log_errors | default(true) | bool else "" }}{{ " " if log_errors | default(true) | bool and log_syslog | default(false) | bool else "" }}{{ "syslog" if log_syslog | default(false) | bool else "" }}
{% if not log_errors | default(true) | bool and not log_syslog | default(false) | bool %}
# Logging is disabled (neither errors nor syslog)
{% endif %}

# ==============================================================================
# Debug Options
# ==============================================================================

# debug_opts: Enable debug options. The argument is a comma-separated list of debug values:
# cfg, snpo, log, dir, base, tarp, fork, time.
# Empty string disables debug output.
# Default: '' (disabled)
{% if debug_opts | default('') | length > 0 %}
# Debug options are enabled: {{ debug_opts | default('') }}
{% else %}
# Debug mode is disabled
# Debug:
{% endif %}

# ==============================================================================
# Target Definitions
# ==============================================================================
# Each target defines a network interface or resource to monitor via SNMP.
# Targets are iterated from the 'targets' list in the schema.
# ==============================================================================

{% for target in targets | default([{'name': 'eth0_in', 'label': 'eth0 Inbound', 'spec': '1.3.6.1.2.1.2.2.1.10.2:public@127.0.0.1', 'description': 'Inbound traffic on eth0 (OID 1.3.6.1.2.1.2.2.1.10.2)', 'max_bytes': 125000000, 'growth': 'none', 'traffic_unit': 'bytes', 'options': ['perminute', 'gauge', 'nosmooth'], 'title': 'eth0 Inbound Traffic', 'page_top': '<H1>eth0 Inbound Traffic</H1>'}]) %}
# ------------------------------------------------------------------------------
# Target: {{ target.label | default(target.name) }}
# Field: targets[{{ loop.index0 }}].name = {{ target.name | default('') }}
# ------------------------------------------------------------------------------

# spec: SNMP specification string. Format: <OID>:<community>@<host>
# Example: 1.3.6.1.2.1.2.2.1.10.2:public@127.0.0.1
# Description: {{ target.description | default('No description provided') }}
Target[{{ target.name | default('') }}]: {{ target.spec | default('') }}

{% if target.router | default('') | length > 0 %}
# router: Hostname or IP for RouterUp check (availability monitoring).
RouterUp[{{ target.name | default('') }}]: {{ target.router | default('') }}
{% endif %}

{% if target.snmp_community | default('') | length > 0 %}
# snmp_community: SNMP community string for authentication (optional if included in spec).
# SNMPCommunity[{{ target.name | default('') }}]: {{ target.snmp_community | default('') }}
{% endif %}

{% if target.snmp_version | default('') | length > 0 %}
# snmp_version: SNMP protocol version (e.g., '1', '2c', '3').
# SNMPVersion[{{ target.name | default('') }}]: {{ target.snmp_version | default('') }}
{% endif %}

{% if target.max_bytes | default(0) > 0 %}
# max_bytes: Maximum expected value in bytes. Used to scale the graph Y-axis.
# Prevents graph distortion if traffic spikes exceed normal ranges.
MaxBytes[{{ target.name | default('') }}]: {{ target.max_bytes | default(0) }}
{% endif %}

{% if target.growth | default('none') | length > 0 %}
# growth: Growth detection mode for counters.
# Values: 'none', 'mg', 'mgp', 'ma'. Prevents negative counter wrap issues.
Growth[{{ target.name | default('') }}]: {{ target.growth | default('none') }}
{% endif %}

{% if target.traffic_unit | default('bytes') | length > 0 %}
# traffic_unit: Unit for traffic display.
# Values: 'bytes', 'bits'. Affects how graph labels are rendered.
TrafficUnit[{{ target.name | default('') }}]: {{ target.traffic_unit | default('bytes') }}
{% endif %}

{% if target.options | default([]) | length > 0 %}
# options: List of MRTG options for this target.
# Common values: 'perminute', 'gauge', 'nosmooth', 'noinfo', 'prcap', 'noo'.
# These control how MRTG processes and displays the data.
Options[{{ target.name | default('') }}]: {{ target.options | default([]) | join(', ') }}
{% endif %}

{% if target.title | default('') | length > 0 %}
# title: Title displayed in the HTML page for this target.
Title[{{ target.name | default('') }}]: {{ target.title | default('') }}
{% endif %}

{% if target.page_top | default('') | length > 0 %}
# page_top: HTML snippet inserted at the top of the generated page for this target.
# Can include <H1>, <H2>, <P>, or other HTML elements for documentation.
PageTop[{{ target.name | default('') }}]: {{ target.page_top | default('') }}
{% endif %}

{% endfor %}