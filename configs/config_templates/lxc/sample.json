{
  "lxc_rootfs_dir": "/var/lib/lxc",
  "default_template": "/usr/share/lxc/templates/lxc-alpine",
  "bridge_name": "lxcbr0",
  "container_mac": [
    2,
    52,
    206
  ],
  "networks": [
    {
      "type": "veth",
      "link": "lxcbr0",
      "flags": "up",
      "name": "eth0",
      "ipv4_addresses": [
        "10.0.3.10/24"
      ],
      "gateway": "10.0.3.1"
    },
    {
      "type": "ipvlan",
      "link": "eth0",
      "flags": "up",
      "name": "eth1",
      "ipv4_addresses": [
        "192.168.10.50/24"
      ],
      "gateway": "192.168.10.1"
    }
  ],
  "use_cgroup_v2": true,
  "log_level": "INFO",
  "log_file": "/var/log/lxc/lxc.log"
}
