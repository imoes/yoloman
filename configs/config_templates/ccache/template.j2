# =============================================================================
# ccache configuration file (ccache.conf)
# =============================================================================
# This file configures the C compiler cache (ccache).
# Directives use the format: key = value
# Lines starting with '#' are comments.
# Environment variables can override these settings at runtime.
# See `man ccache.conf` for the full list of supported options.
# =============================================================================

# -------------------------------------------------------------------------
# Cache Size Management
# -------------------------------------------------------------------------

# Maximum size of the cache (e.g., 5G, 10G, 0 for unlimited).
# Accepts decimal suffixes (k, M, G, T) and binary suffixes (Ki, Mi, Gi, Ti).
# Override: CCACHE_MAXSIZE
# Default: 5G
max_size = {{ max_size | default('5G') }}

# Maximum number of files allowed in the cache (0 = unlimited).
# Override: CCACHE_MAXFILES
# Default: 0
max_files = {{ max_files | default(0) }}

# -------------------------------------------------------------------------
# Compression Settings
# -------------------------------------------------------------------------

# Whether to compress stored data using Zstandard (zstd).
# Enable with 'true', disable with 'false'.
# Override: CCACHE_COMPRESS / CCACHE_NOCOMPRESS
# Default: true
compression = {{ compression | default(true) | lower }}

# Zstandard compression level (0 = auto-select level 1).
# Positive values: higher = slower but better compression.
# Negative values: faster but lower compression.
# Override: CCACHE_COMPRESSLEVEL
# Default: 0
compression_level = {{ compression_level | default(0) }}

# -------------------------------------------------------------------------
# Compiler Identification
# -------------------------------------------------------------------------

# Method to identify compiler changes for cache invalidation.
# Options: 'content' (hashes the compiler binary), 'mtime' (checks timestamp),
# 'none' (always assumes same), or 'string:value' (custom string check).
# Can also be a command string executed to determine validity.
# Override: CCACHE_COMPILERCHECK
# Default: mtime
compiler_check = {{ compiler_check | default('mtime') }}

# -------------------------------------------------------------------------
# Path and Namespace Handling
# -------------------------------------------------------------------------

# Base directory for path rewriting.
# Replaces this path in cached file paths to allow sharing caches across
# different build directory locations (e.g., /home/user vs /build).
# Empty string disables rewriting.
# Override: CCACHE_BASEDIR
# Default: ''
{% if base_dir | default('') != '' %}
base_dir = {{ base_dir | default('') }}
{% endif %}

# Whether to include the current working directory in the hash for debug info.
# Useful for debug builds where paths matter, but can prevent cache hits
# if builds happen from different directories.
# Override: CCACHE_HASHDIR / CCACHE_NOHASHDIR
# Default: true
hash_dir = {{ hash_dir | default(true) | lower }}

# Optional namespace string to separate cache entries.
# Allows multiple projects or configurations to share the same cache directory
# without interfering with each other (e.g., 'project-a', 'debug', 'release').
# Override: CCACHE_NAMESPACE
# Default: ''
{% if namespace | default('') != '' %}
namespace = {{ namespace | default('') }}
{% endif %}

# -------------------------------------------------------------------------
# Compilation Mode Settings
# -------------------------------------------------------------------------

# Whether to use direct mode.
# Direct mode (default) is faster than preprocessor mode because it invokes
# the compiler directly. It requires the compiler to support the `-o` option
# correctly relative to include paths.
# Override: CCACHE_DIRECT / CCACHE_NODIRECT
# Default: true
direct_mode = {{ direct_mode | default(true) | lower }}

# Whether to use depend mode.
# Relies on dependency files (e.g., .d files) generated by the compiler.
# Can improve cache hit rates for header changes but may have portability issues.
# Override: CCACHE_DEPEND / CCACHE_NODEPEND
# Default: false
depend_mode = {{ depend_mode | default(false) | lower }}

# Whether to cache source file inode hashes.
# Speeds up repeated include hashing by caching inode numbers.
# May cause false positives on NFS if inodes are not stable across reboots/mounts.
# Override: CCACHE_INODECACHE / CCACHE_NOINODECACHE
# Default: true
inode_cache = {{ inode_cache | default(true) | lower }}

# -------------------------------------------------------------------------
# File Storage Options
# -------------------------------------------------------------------------

# Whether to use hard links instead of copying files when storing cache objects.
# Saves disk I/O and space, but requires the cache directory and build
# directories to be on the same filesystem. Not recommended for shared networks.
# Override: CCACHE_HARDLINK / CCACHE_NOHARDLINK
# Default: false
hard_link = {{ hard_link | default(false) | lower }}

# Whether to use file cloning (copy-on-write/reflinks).
# Uses filesystem features like Btrfs reflinks or ZFS clones for efficient
# storage. Faster than hard links for some workloads, but filesystem-dependent.
# Override: CCACHE_FILECLONE / CCACHE_NOFILECLONE
# Default: false
file_clone = {{ file_clone | default(false) | lower }}

# -------------------------------------------------------------------------
# Relaxations (Sloppiness)
# -------------------------------------------------------------------------

# List of settings to relax strictness for caching.
# Useful when build environments vary slightly but code is compatible.
# Allowed items: 'clang_index_store', 'file_stat_matches',
# 'file_stat_matches_ctime', 'gcno_cw'.
# Joined into a comma-separated string for the config file.
# Override: CCACHE_SLOPPINESS
# Default: [] (no relaxations)
{% set sloppiness_val = sloppiness | default([]) %}
{% if sloppiness_val | length > 0 %}
sloppiness = {{ sloppiness_val | join(',') }}
{% endif %}

# -------------------------------------------------------------------------
# Statistics and Debugging
# -------------------------------------------------------------------------

# Whether to update statistics counters.
# Disabling this can improve performance slightly in high-throughput builds.
# Override: CCACHE_STATS / CCACHE_NOSTATS
# Default: true
stats = {{ stats | default(true) | lower }}

# Path to a stats log file for per-build statistics.
# If set, ccache will append statistics to this file after each invocation.
# Override: CCACHE_STATSLOG
# Default: '' (disabled)
{% if stats_log | default('') != '' %}
stats_log = {{ stats_log | default('') }}
{% endif %}

# Whether to enable debug mode.
# Creates debug output files for each compiled object to help diagnose
# why cache hits/misses occurred. Heavy disk I/O impact.
# Override: CCACHE_DEBUG / CCACHE_NODEBUG
# Default: false
debug = {{ debug | default(false) | lower }}

# Path to the directory where debug files are written when debug mode is on.
# Override: CCACHE_DEBUGDIR
# Default: '' (alongside object file)
{% if debug_dir | default('') != '' %}
debug_dir = {{ debug_dir | default('') }}
{% endif %}

# Debug level (1 = log only key info, 2 = full verbose debug output).
# Only applies if debug mode is enabled.
# Override: CCACHE_DEBUGLEVEL
# Default: 2
debug_level = {{ debug_level | default(2) }}

# -------------------------------------------------------------------------
# Operational Modes
# -------------------------------------------------------------------------

# Whether to disable ccache completely.
# If true, ccache bypasses the cache and invokes the compiler directly every time.
# Useful for testing or one-off builds where cache overhead is unwanted.
# Override: CCACHE_DISABLE / CCACHE_NODISABLE
# Default: false
disable = {{ disable | default(false) | lower }}

# -------------------------------------------------------------------------
# Security and Permissions
# -------------------------------------------------------------------------

# Umask applied to cache files and directories.
# Controls permissions for cache storage. Common values: '022' (readable by group/others),
# '077' (owner only).
# Override: CCACHE_UMASK
# Default: 022
umask = {{ umask | default('022') }}

# -------------------------------------------------------------------------
# Temporary Files
# -------------------------------------------------------------------------

# Path to a temporary directory for ccache operations.
# If empty, ccache auto-detects a suitable temporary directory (usually /tmp).
# Useful if /tmp is mounted noexec or has insufficient space.
# Override: CCACHE_TEMPDIR
# Default: '' (auto-detected)
{% if temporary_dir | default('') != '' %}
temporary_dir = {{ temporary_dir | default('') }}
{% endif %}

# -------------------------------------------------------------------------
# Hashing Extras
# -------------------------------------------------------------------------

# List of compiler options to ignore in the cache key hash.
# Supports wildcards (*). Useful for ignoring options that change per build
# but do not affect the compiled output (e.g., -g, -O2 variations that are
# functionally equivalent for your purposes).
# Joined into a space-separated string.
# Override: CCACHE_IGNOREOPTIONS
# Default: []
{% set ignore_opts = ignore_options | default([]) %}
{% if ignore_opts | length > 0 %}
ignore_options = {{ ignore_opts | join(' ') }}
{% endif %}

# List of extra files to include in the cache hash.
# Changes in these files will invalidate cache entries.
# Colon-separated on Unix, semicolon on Windows.
# Override: CCACHE_EXTRAFILES
# Default: []
{% set extra_files = extra_files_to_hash | default([]) %}
{% if extra_files | length > 0 %}
extra_files_to_hash = {{ extra_files | join(':') }}
{% endif %}

# -------------------------------------------------------------------------
# Remote Storage
# -------------------------------------------------------------------------

# List of remote storage backend URLs.
# Supported formats: 'file:/path', 'http://host', 'https://host', 'redis://host:port'.
# Allows sharing the cache across multiple machines or backing it up centrally.
# Joined into a space-separated string for the config file.
# Override: CCACHE_REMOTE_STORAGE
# Default: [] (no remote storage)
{% set remote_stor = remote_storage | default([]) %}
{% if remote_stor | length > 0 %}
remote_storage = {{ remote_stor | join(' ') }}
{% endif %}

# Whether to use remote storage ONLY.
# If true, ccache skips the local cache entirely and communicates directly
# with the remote storage backend. Useful for headless build agents.
# Override: CCACHE_REMOTE_ONLY / CCACHE_NOREMOTE_ONLY
# Default: false
remote_only = {{ remote_only | default(false) | lower }}

# Whether to reshare cache hits to remote storage.
# If enabled, when a build fetches an object from the local cache, ccache
# uploads it to the remote storage backend to ensure availability for other nodes.
# Override: CCACHE_RESHARE / CCACHE_NORESHARE
# Default: false
reshare = {{ reshare | default(false) | lower }}