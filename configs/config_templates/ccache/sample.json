{
  "max_size": "20G",
  "max_files": 100000,
  "compression": true,
  "compression_level": 3,
  "compiler_check": "mtime",
  "base_dir": "/home/user",
  "hash_dir": true,
  "direct_mode": true,
  "depend_mode": false,
  "inode_cache": true,
  "hard_link": false,
  "file_clone": false,
  "sloppiness": [
    "time_macros",
    "locale"
  ],
  "stats": true,
  "disable": false,
  "temporary_dir": "/tmp/ccache-tmp",
  "namespace": "production-build",
  "ignore_options": [
    "-fmessage-length=*",
    "-Wno-unused-result"
  ],
  "extra_files_to_hash": [],
  "debug_dir": "",
  "debug_level": 2,
  "debug": false,
  "stats_log": "/var/log/ccache-stats.log",
  "umask": "002",
  "remote_storage": [],
  "remote_only": false,
  "reshare": false
}
