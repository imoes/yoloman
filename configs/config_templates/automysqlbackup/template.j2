#!/bin/sh
# Path to the automysqlbackup executable.
# This script checks if the executable exists and is runnable; if not, it exits silently.
# Then it executes the automysqlbackup binary to perform the backup.
test -x {{ automysqlbackup_bin | default('/usr/sbin/automysqlbackup') }} || exit 0
{{ automysqlbackup_bin | default('/usr/sbin/automysqlbackup') }}