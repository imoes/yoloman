# ============================================================================
# YAWS-WIKI CONFIGURATION FILE
# ============================================================================
# This file configures the YAWS Wiki service. It defines the path to the
# compiled Erlang beam code, and the virtual server settings (port, listen
# address, document root) for the wiki web interface.
# ============================================================================

# Path to the directory where wiki beam code is placed.
# The daemon will add this directory to its search path to locate
# the Erlang modules required for the wiki functionality.
# Default: /usr/lib/yaws-wiki/ebin
ebin_dir = {{ ebin_dir | default('/usr/lib/yaws-wiki/ebin') }}

# ============================================================================
# VIRTUAL SERVER DEFINITION
# ============================================================================
# Define the virtual server for the YAWS wiki.
# Uncomment the block below and adjust settings as needed.
#
# <server wiki>
#     port = ...
#     listen = ...
#     docroot = ...
# </server>
# ============================================================================

# Port number for the yaws wiki virtual server.
# The TCP port on which the wiki web interface will accept connections.
# Default: 8080
<server wiki>
# IP address to listen on for the yaws wiki virtual server.
# Specifies the network interface address. Use '0.0.0.0' to listen on all
# available interfaces, or a specific IP (e.g., '127.0.0.1') for local-only access.
# Default: 0.0.0.0
    listen = {{ listen | default('0.0.0.0') }}

# Port number for the yaws wiki virtual server.
# The TCP port on which the wiki web interface will accept connections.
# Default: 8080
    port = {{ port | default(8080) }}

# Document root directory for the yaws wiki virtual server.
# The base directory from which static files and wiki content are served.
# Default: /var/lib/yaws-wiki/www
    docroot = {{ docroot | default('/var/lib/yaws-wiki/www') }}
</server>