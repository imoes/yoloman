{
  "addr_file": "/etc/ibacm/ibacm_addr.cfg",
  "option_file": "/etc/ibacm/ibacm_opts.cfg",
  "daemon_mode": true,
  "route_preload": "none",
  "addr_preload": "acm_hosts",
  "addr_data_file": "/etc/ibacm/hosts",
  "log_level": "info",
  "max_retries": 3,
  "resolve_timeout": 5000,
  "systemd_socket_activation": false,
  "resolution_protocols": [
    "sa"
  ]
}
