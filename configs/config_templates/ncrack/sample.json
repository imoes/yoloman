{
  "timing_template": "aggressive",
  "connection_limit": 100,
  "output_file": "/var/log/ncrack/scan.log",
  "usernames": "/usr/share/ncrack/usernames.txt",
  "passwords": "/usr/share/ncrack/passwords.txt",
  "ssl_enabled": true,
  "targets": [
    "192.168.1.10:22",
    "192.168.1.11:22,CL=5"
  ],
  "stop_after_one": false,
  "ipv6_enabled": false,
  "proxy": "",
  "datadir": "",
  "exclude_hosts": "192.168.1.100",
  "resume_file": "",
  "append_output": false,
  "log_errors": true,
  "verbose": 1,
  "debug_level": 0,
  "pairwise": false,
  "passwords_first": false,
  "modules": [
    "ssh"
  ],
  "global_options": [
    "CL=20"
  ],
  "service_options": [
    "ssh:at=5"
  ],
  "per_host_options": []
}
