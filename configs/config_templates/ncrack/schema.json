{
  "timing_template": {
    "type": "string",
    "default": "normal",
    "description": "Timing template (paranoid, sneaky, polite, normal, aggressive, insane)",
    "enum": [
      "paranoid",
      "sneaky",
      "polite",
      "normal",
      "aggressive",
      "insane"
    ]
  },
  "connection_limit": {
    "type": "number",
    "default": 0,
    "description": "Threshold for total concurrent connections"
  },
  "output_file": {
    "type": "string",
    "default": "ncrack_output.log",
    "description": "Filename for normal output (-oN)"
  },
  "usernames": {
    "type": "string",
    "default": "",
    "description": "Path to username list file (-U)"
  },
  "passwords": {
    "type": "string",
    "default": "",
    "description": "Path to password list file (-P)"
  },
  "ssl_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable SSL globally (-g ssl=yes)"
  },
  "targets": {
    "type": "list",
    "default": [
      "192.168.1.10:22"
    ],
    "description": "List of target specifications (e.g., 'host:port', 'ssh://host:22')"
  },
  "stop_after_one": {
    "type": "bool",
    "default": false,
    "description": "Quit cracking a service after one found credential (-f)"
  },
  "ipv6_enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable IPv6 scanning (-6)"
  },
  "proxy": {
    "type": "string",
    "default": "",
    "description": "Proxy type and address (--proxy)"
  },
  "datadir": {
    "type": "string",
    "default": "",
    "description": "Custom Ncrack data directory (--datadir)"
  },
  "exclude_hosts": {
    "type": "string",
    "default": "",
    "description": "Comma-separated list of hosts to exclude (--exclude)"
  },
  "resume_file": {
    "type": "string",
    "default": "",
    "description": "File to resume a previously saved session (--resume)"
  },
  "append_output": {
    "type": "bool",
    "default": false,
    "description": "Append to output files (--append-output)"
  },
  "log_errors": {
    "type": "bool",
    "default": false,
    "description": "Log errors to normal output file (--log-errors)"
  },
  "verbose": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level (-v repeated)"
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Debug level (-d)"
  },
  "pairwise": {
    "type": "bool",
    "default": false,
    "description": "Choose usernames and passwords in pairs (--pairwise)"
  },
  "passwords_first": {
    "type": "bool",
    "default": false,
    "description": "Iterate password list for each username (--passwords-first)"
  },
  "modules": {
    "type": "list",
    "default": [],
    "description": "List of modules to use (informational, as modules are auto-detected or implied by service)"
  },
  "global_options": {
    "type": "list",
    "default": [],
    "description": "List of global service options (e.g., ['CL=10', 'at=5'])"
  },
  "service_options": {
    "type": "list",
    "default": [],
    "description": "List of per-module service options (e.g., ['ssh:CL=5', 'ftp:at=1'])"
  },
  "per_host_options": {
    "type": "list",
    "default": [],
    "description": "List of per-host options applied directly to targets in the targets list"
  }
}
