{
  "reconcile_interval": 300,
  "frr_reconcile_interval": 15,
  "expose_tenant_networks": "false",
  "advertisement_method_tenant_networks": "host",
  "require_snat_disabled_for_tenant_networks": "false",
  "expose_ipv6_gua_tenant_networks": "false",
  "driver": "ovn_bgp_driver",
  "ovsdb_connection": "unix:/usr/local/var/run/openvswitch/db.sock",
  "ovsdb_connection_timeout": 180,
  "bgp_AS": "64999",
  "bgp_router_id": null,
  "evpn_local_ip": null,
  "evpn_nic": null,
  "evpn_udp_dstport": 4789,
  "clear_vrf_routes_on_startup": "false",
  "delete_vrf_on_disconnect": "true",
  "bgp_nic": "bgp-nic",
  "bgp_vrf": "bgp-vrf",
  "bgp_vrf_table_id": 10,
  "address_scopes": null,
  "exposing_method": "underlay",
  "root_helper": "sudo",
  "use_helper_for_ns_read": "true",
  "root_helper_daemon": null,
  "ovn_nb_connection": "unix:/var/run/ovn/ovnnb_db.sock",
  "external_nics": [],
  "peer_ips": [],
  "provider_networks_pool_prefixes": [
    "192.168.0.0/16"
  ],
  "bgp_chassis_id": "bgp",
  "ovn_sb_private_key": "/etc/pki/tls/private/ovn_bgp_agent.key",
  "ovn_sb_certificate": "/etc/pki/tls/certs/ovn_bgp_agent.crt",
  "ovn_sb_ca_cert": "/etc/ipa/ca.crt",
  "ovn_sb_connection": null,
  "ovn_nb_private_key": "/etc/pki/tls/private/ovn_bgp_agent.key",
  "ovn_nb_certificate": "/etc/pki/tls/certs/ovn_bgp_agent.crt",
  "ovn_nb_ca_cert": "/etc/ipa/ca.crt",
  "ovn_nb_connection_ovn": null
}
