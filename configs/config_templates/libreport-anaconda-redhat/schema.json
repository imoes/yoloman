{
  "summary_format": {
    "type": "string",
    "default": "%reason%",
    "description": "Bug summary format string"
  },
  "description_header": {
    "type": "string",
    "default": "%bare_comment",
    "description": "Text for the 'Description of problem' section"
  },
  "version_header": {
    "type": "string",
    "default": "%bare_package",
    "description": "Text for the 'Version-Release number' section"
  },
  "additional_info_text": {
    "type": "string",
    "default": ":: %bare_description",
    "description": "Text header for the 'Additional info' section"
  },
  "attach_elements": {
    "type": "string",
    "default": "-reported_to,-comment,-reason,-event_log,-extra-cc,%multiline,\\",
    "description": "Comma-separated list of elements to attach"
  },
  "reporter_elements": {
    "type": "string",
    "default": "reporter,-pkg_arch,-pkg_epoch,-pkg_name,-pkg_release,-pkg_version,-pkg_vendor,-pkg_fingerprint,-component,-architecture,-extra-cc,-analyzer,-count,-duphash,-uuid,-abrt_version,-username,-hostname,-os_release,-last_occurrence,-ureports_counter,-time,-pid,-pwd,-backtrace,-core_backtrace,-ifcfg.log,-packaging.log,-tid,%oneline",
    "description": "Comma-separated list of elements to include in the reporter section of additional info"
  }
}
