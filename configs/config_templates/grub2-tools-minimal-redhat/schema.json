{
  "GRUB_DEFAULT": {
    "type": "string",
    "default": "saved",
    "description": "Default GRUB entry to boot"
  },
  "GRUB_TIMEOUT": {
    "type": "number",
    "default": 5,
    "description": "Timeout in seconds for the GRUB menu"
  },
  "GRUB_TIMEOUT_STYLE": {
    "type": "string",
    "default": "countdown",
    "description": "Style of the timeout display"
  },
  "GRUB_HIDDEN_TIMEOUT": {
    "type": "number",
    "default": 0,
    "description": "Hidden timeout for legacy systems"
  },
  "GRUB_HIDDEN_TIMEOUT_QUIET": {
    "type": "bool",
    "default": true,
    "description": "Whether to hide the hidden timeout count"
  },
  "GRUB_DISABLE_RECOVERY": {
    "type": "bool",
    "default": true,
    "description": "Disable recovery mode entries"
  },
  "GRUB_CMDLINE_LINUX": {
    "type": "string",
    "default": "",
    "description": "Kernel command line arguments for Linux"
  },
  "GRUB_CMDLINE_LINUX_DEFAULT": {
    "type": "string",
    "default": "quiet splash",
    "description": "Default kernel command line arguments"
  },
  "GRUB_TERMINAL_OUTPUT": {
    "type": "string",
    "default": "console",
    "description": "Terminal output device"
  },
  "GRUB_TERMINAL_INPUT": {
    "type": "string",
    "default": "console",
    "description": "Terminal input device"
  },
  "GRUB_GFXMODE": {
    "type": "string",
    "default": "auto",
    "description": "Graphics mode resolution"
  },
  "GRUB_THEME": {
    "type": "string",
    "default": "/boot/grub2/themes/system/theme.txt",
    "description": "Path to the GRUB theme file"
  },
  "GRUB_BACKGROUND": {
    "type": "string",
    "default": "/boot/grub2/themes/system/background.png",
    "description": "Path to the background image"
  },
  "GRUB_ENABLE_CRYPTODISK": {
    "type": "string",
    "default": "n",
    "description": "Enable cryptodisk support (yes/no/y/n)"
  },
  "GRUB_SAVEDEFAULT": {
    "type": "bool",
    "default": true,
    "description": "Save the last selected boot entry as default"
  },
  "GRUB_DISABLE_OS_PROBER": {
    "type": "bool",
    "default": false,
    "description": "Disable OS prober script"
  },
  "GRUB_DISABLE_LINUX_UUID": {
    "type": "bool",
    "default": true,
    "description": "Disable UUID usage in Linux kernel commands"
  },
  "GRUB_ENABLE_USB_KEYBOARD": {
    "type": "bool",
    "default": true,
    "description": "Enable USB keyboard support in GRUB"
  },
  "GRUB_SERIAL_COMMAND": {
    "type": "string",
    "default": "serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1",
    "description": "Serial console configuration command"
  },
  "GRUB_NETBOOT_ENABLED": {
    "type": "bool",
    "default": false,
    "description": "Enable network boot support"
  }
}
