# GRUB Configuration File
#
# This file is managed by grubby.
# Do NOT edit this file directly.
# Changes to GRUB configuration should be made via grubby or by editing /etc/default/grub.

# Default grub entry
GRUB_DEFAULT=saved

# Timeout for menu
GRUB_TIMEOUT=5

# Timeout style
GRUB_TIMEOUT_STYLE=countdown

# Hidden menu
GRUB_HIDDEN_TIMEOUT=0
GRUB_HIDDEN_TIMEOUT_QUIET=true

# Distro menu
GRUB_DISABLE_RECOVERY=true

# Linux command line defaults
GRUB_CMDLINE_LINUX=""
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"

# Terminal output
GRUB_TERMINAL_OUTPUT=console

# Terminal input
GRUB_TERMINAL_INPUT=console

# Graphics mode
GRUB_GFXMODE=auto

# GRUB theme
GRUB_THEME="/boot/grub2/themes/system/theme.txt"

# Background image
GRUB_BACKGROUND="/boot/grub2/themes/system/background.png"

# Enable splash screen
GRUB_ENABLE_CRYPTODISK=n

# Save default entry
GRUB_SAVEDEFAULT=true

# Disable OS-prober
GRUB_DISABLE_OS_PROBER=false

# Force MBR setup
GRUB_DISABLE_LINUX_UUID=true

# Enable USB keyboard
GRUB_ENABLE_USB_KEYBOARD=true

# Enable serial console
GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1"

# Enable netboot
GRUB_NETBOOT_ENABLED=false

# Enable crypto
GRUB_ENABLE_CRYPTODISK=false
