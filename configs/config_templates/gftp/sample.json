{
  "default_protocol": "ftp",
  "port": 21,
  "proxy_host": "proxy.example.com",
  "proxy_port": 3128,
  "transfer_mode": "binary",
  "show_local_time": true,
  "show_hidden_files": false,
  "max_transfer_history": 20,
  "bookmarks": [
    {
      "name": "backup-server",
      "protocol": "ssh",
      "host": "backup.example.com",
      "user": "backup",
      "directory": "/backups"
    },
    {
      "name": "public-ftp",
      "protocol": "ftp",
      "host": "ftp.example.org",
      "port": 2121,
      "directory": "/pub"
    }
  ]
}
