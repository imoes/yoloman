; /etc/beesu.conf
; BEESU configuration file
;
; This file controls which commands `beesu` is permitted to execute.
; Commands are listed within the <allow> ... </allow> block.
; A single '*' grants permission for all commands.
; To restrict access, remove '*' and list specific allowed commands.

<allow>
; allow_all_commands: Enable any input command. Set to '*'.
; Comment with ';*' to disable global wildcard access.
{{ allow_all_commands | default('*') }}

; allow_list: List of other allowed commands, one per line.
; Each command should be on its own line. Preceding lines can be comments
; to describe the command's purpose.
; Example:
;   # Encryption tool
;   truecrypt
;   # Disk utility
;   gfloppy
{{ allow_list | default('; List of other allowed commands, as example:\ntruecrypt\ngfloppy') }}
</allow>

; EOF
