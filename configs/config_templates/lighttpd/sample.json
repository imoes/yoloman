{
  "server": {
    "document_root": "/var/www/example.com",
    "port": 80,
    "bind_address": "0.0.0.0",
    "index_files": [
      "index.html",
      "index.php"
    ],
    "error_log": "/var/log/lighttpd/error.log",
    "access_log": "/var/log/lighttpd/access.log",
    "pid_file": "/run/lighttpd.pid",
    "modules": [
      "mod_alias",
      "mod_accesslog",
      "mod_compress",
      "mod_fastcgi"
    ]
  },
  "mimetype.assign": [
    ".html => \"text/html\"",
    ".txt => \"text/plain\"",
    ".css => \"text/css\"",
    ".js => \"application/javascript\"",
    ".json => \"application/json\"",
    ".png => \"image/png\"",
    ".jpg => \"image/jpeg\"",
    ".svg => \"image/svg+xml\"",
    ".php => \"application/x-httpd-php\""
  ],
  "auth": {
    "enabled": false
  },
  "vhosts": [
    {
      "host_pattern": "^example\\.com$",
      "document_root": "/var/www/example.com"
    },
    {
      "host_pattern": "^api\\.example\\.com$",
      "document_root": "/var/www/api.example.com"
    }
  ],
  "compression": {
    "enabled": true,
    "cache_dir": "/var/cache/lighttpd/compress",
    "filetypes": [
      "text/plain",
      "text/html",
      "text/css",
      "application/javascript"
    ]
  },
  "fastcgi": {
    "backends": [
      {
        "url_prefix": "/php",
        "socket": "unix:/run/php/php-fpm.sock",
        "bin_path": "/usr/bin/php-fpm"
      }
    ]
  },
  "ssl": {
    "enabled": true,
    "pem_file": "/etc/letsencrypt/live/example.com/fullchain.pem",
    "ca_file": "/etc/letsencrypt/live/example.com/chain.pem",
    "cipher_list": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256"
  }
}
