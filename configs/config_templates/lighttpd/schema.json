{
  "server": {
    "type": "object",
    "default": {},
    "description": "Core server runtime settings",
    "properties": {
      "document_root": {
        "type": "string",
        "default": "/var/www/html",
        "description": "Root directory for web content"
      },
      "port": {
        "type": "number",
        "default": 80,
        "description": "Port to listen on"
      },
      "bind_address": {
        "type": "string",
        "default": "0.0.0.0",
        "description": "IP address to bind to"
      },
      "index_files": {
        "type": "list",
        "default": [
          "index.html",
          "index.php",
          "index.fcgi",
          "default.html"
        ],
        "description": "Ordered list of filenames to serve as directory index"
      },
      "error_log": {
        "type": "string",
        "default": "/var/log/lighttpd/error.log",
        "description": "Path to error log file"
      },
      "access_log": {
        "type": "string",
        "default": "/var/log/lighttpd/access.log",
        "description": "Path to access log file"
      },
      "pid_file": {
        "type": "string",
        "default": "/run/lighttpd.pid",
        "description": "Path to PID file"
      },
      "modules": {
        "type": "list",
        "default": [
          "mod_access",
          "mod_alias",
          "mod_compress",
          "mod_redirect",
          "mod_accesslog"
        ],
        "description": "List of module names to load (without 'mod_' prefix)"
      }
    }
  },
  "mimetype.assign": {
    "type": "list",
    "default": [
      ".html => \"text/html\"",
      ".txt => \"text/plain\"",
      ".css => \"text/css\"",
      ".js => \"application/javascript\"",
      ".json => \"application/json\"",
      ".png => \"image/png\"",
      ".jpg => \"image/jpeg\"",
      ".svg => \"image/svg+xml\"",
      ".gif => \"image/gif\"",
      ".pdf => \"application/pdf\"",
      ".xml => \"text/xml\"",
      ".ico => \"image/x-icon\"",
      ".webp => \"image/webp\"",
      ".woff => \"font/woff\"",
      ".woff2 => \"font/woff2\""
    ],
    "description": "Map of file extensions to MIME types"
  },
  "auth": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "Basic authentication configuration",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable HTTP Basic authentication"
      },
      "backend_type": {
        "type": "string",
        "enum": [
          "plain",
          "htpasswd"
        ],
        "default": "plain",
        "description": "Authentication backend type"
      },
      "backend_plain_userfile": {
        "type": "string",
        "default": "/etc/lighttpd/lighttpd-user",
        "description": "Path to plain text user file (format: user:password)",
        "depends_on": {
          "field": "auth.backend_type",
          "value": "plain"
        }
      },
      "backend_htpasswd_userfile": {
        "type": "string",
        "default": "/etc/lighttpd/.htpasswd",
        "description": "Path to htpasswd file (format: user:encrypted_password)",
        "depends_on": {
          "field": "auth.backend_type",
          "value": "htpasswd"
        }
      }
    }
  },
  "vhosts": {
    "type": "list",
    "default": [],
    "description": "List of virtual hosts; each matches a host pattern to a document root",
    "items": {
      "type": "object",
      "properties": {
        "host_pattern": {
          "type": "string",
          "description": "Perl-compatible regex pattern for Host header matching"
        },
        "document_root": {
          "type": "string",
          "description": "Document root for this virtual host"
        }
      },
      "required": [
        "host_pattern",
        "document_root"
      ]
    }
  },
  "compression": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "Content compression (gzip) settings",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable compression"
      },
      "cache_dir": {
        "type": "string",
        "default": "/var/cache/lighttpd/compress",
        "description": "Directory for compressed cache files"
      },
      "filetypes": {
        "type": "list",
        "default": [
          "text/plain",
          "text/html",
          "text/css",
          "application/javascript",
          "application/json"
        ],
        "description": "MIME types to compress"
      }
    }
  },
  "fastcgi": {
    "type": "object",
    "default": {
      "backends": []
    },
    "description": "FastCGI backend configuration",
    "properties": {
      "backends": {
        "type": "list",
        "default": [],
        "description": "List of FastCGI backends to configure",
        "items": {
          "type": "object",
          "properties": {
            "url_prefix": {
              "type": "string",
              "description": "URL prefix to proxy to FastCGI (e.g., \"/fcgi\")"
            },
            "socket": {
              "type": "string",
              "description": "Unix socket path or host:port for backend"
            },
            "bin_path": {
              "type": "string",
              "description": "Path to FastCGI executable (for spawn mode)"
            }
          },
          "required": [
            "url_prefix",
            "socket"
          ]
        }
      }
    }
  },
  "ssl": {
    "type": "object",
    "default": {
      "enabled": false
    },
    "description": "SSL/TLS configuration",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable HTTPS"
      },
      "pem_file": {
        "type": "string",
        "default": "/etc/lighttpd/ssl/server.pem",
        "description": "Combined PEM file (certificate + private key)"
      },
      "ca_file": {
        "type": "string",
        "default": "",
        "description": "Optional CA certificate bundle for client verification"
      },
      "cipher_list": {
        "type": "string",
        "default": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384",
        "description": "SSL cipher suite list"
      }
    }
  }
}
