# Lighttpd Configuration Template
# Self-documenting: every setting below includes its source description.
# Defaults are applied inline via |default() filters to ensure safe rendering.
#
# Reference: https://wiki.lighttpd.net/

# server.document_root: The root directory from which lighttpd serves files.
server.document-root = "{{ (server | default({})).document_root | default('/var/www/html') }}"

# server.upload_dir: The base directory for lighttpd caches, including uploads subdirectory.
# Note: Lighttpd expects a list of upload directories. We append 'uploads' to the base dir.
server.upload-dirs = ( "{{ (server | default({})).upload_dir | default('/var/cache/lighttpd') }}/uploads" )

# server.error_log: The path to the error log file.
server.errorlog = "{{ (server | default({})).error_log | default('/var/log/lighttpd/error.log') }}"

# server.pid_file: The path to the PID file.
server.pid-file = "{{ (server | default({})).pid_file | default('/run/lighttpd.pid') }}"

# server.runas_user: The system user account under which lighttpd runs.
server.username = "{{ (server | default({})).runas_user | default('www-data') }}"

# server.groupname: The system group account under which lighttpd runs.
# Usually mirrors the user for permission consistency.
server.groupname = "{{ (server | default({})).runas_user | default('www-data') }}"

# server.port: The port lighttpd listens on.
server.port = {{ (server | default({})).port | default(80) }}

# Modules to load.
server.modules = (
    "mod_indexfile",
    "mod_access",
    "mod_alias",
    "mod_redirect",
)

# strict parsing and normalization of URL for consistency and security
# https://wiki.lighttpd.net/Server_http-parseoptsDetails
server.http-parseopts = (
    "header-strict"           => "enable",
    "host-strict"             => "enable",
    "host-normalize"          => "enable",
    "url-normalize-unreserved"=> "enable",
    "url-normalize-required"  => "enable",
    "url-ctrls-reject"        => "enable",
    "url-path-2f-decode"      => "enable",
    "url-path-dotseg-remove"  => "enable",
    "url-invalid-utf8-reject" => "enable",
)

index-file.names = ( "index.php", "index.html" )

url.access-deny = ( "~", ".inc" )

static-file.exclude-extensions = ( ".php", ".pl", ".fcgi" )

# Include generated mime types
include_shell "/usr/share/lighttpd/create-mime.conf.pl"

# Include additional configuration snippets from conf-enabled
include "/etc/lighttpd/conf-enabled/*.conf"

# Include IPv6 configuration if available.
# The script expects the port as an argument.
include_shell "/usr/share/lighttpd/use-ipv6.pl " + "{{ (server | default({})).port | default(80) }}"