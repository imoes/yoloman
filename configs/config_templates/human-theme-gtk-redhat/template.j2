# Human Theme GTK Redhat - Environment Variables
# This template generates a shell environment script for GTK3/GTK4 theming.
# It sets various environment variables to customize the appearance and behavior
# of GTK applications, specifically tailored for the Redhat/Human theme and
# GTK3-classic patches.

# ==============================================================================
# FreeType Font Rendering Configuration
# ==============================================================================

{# FreeType properties string for font rendering. #}
# The interpreter version controls how FreeType handles font hinting and rasterization.
export FREETYPE_PROPERTIES="{{ freetype_properties | default('truetype:interpreter-version=35') }}"

# ==============================================================================
# GTK3 Classic / Appearance Settings
# Source: https://github.com/lah7/gtk3-classic
# ==============================================================================

# --- Overlay Scrolling ---
{# Enable overlay scrolling. 0 disables it (always visible scrollbars). #}
# When set to '0', scrollbars remain visible at all times instead of disappearing
# when not in use (overlay style).
export GTK_OVERLAY_SCROLLING="{{ gtk_overlay_scrolling | default('0') }}"

# --- Backdrop State ---
{# Restore disabled backdrop state for windows. #}
# Controls whether the backdrop (inactive window) state is restored/visible.
# '1' typically restores the previous behavior where backdrop states might have
# been disabled or handled differently.
export GTK_BACKDROP="{{ gtk_backdrop | default('1') }}"

# --- Emoji Insertion ---
{# Restore disabled insert emoji menu item. #}
# Restores the ability to insert emojis via the context menu or input methods,
# which might have been disabled by certain patches or default configurations.
export GTKM_INSERT_EMOJI="{{ gtkm_insert_emoji | default('1') }}"

# --- File Size Units ---
{# Use IEC units (KiB, MiB) in open/save dialogs. #}
# Forces the display of file sizes using binary prefixes (KiB, MiB, GiB)
# instead of decimal prefixes (KB, MB, GB) in file selection dialogs.
export GTK_USE_IEC_UNITS="{{ gtk_use_iec_units | default('1') }}"

# ==============================================================================
# GTK4 Classic / Enhanced Appearance Settings
# Source: https://gist.github.com/luigifab/0fce786cdb93b5687069a82f490ea95e
# ==============================================================================

# --- Visible Focus Indicators ---
{# Restore visible focus indicators. #}
# Ensures that focus rectangles or rings are visible on interactive elements
# (like toolbar buttons) for accessibility and usability.
export GTK_FOCUS_VISIBLE="{{ gtk_focus_visible | default('1') }}"

# --- Progress Bar Text ---
{# Restore double text color for progress bars. #}
# Restores the visual style of progress bar text, often improving contrast
# or restoring the "double text" color effect used in older themes.
export GTK_PROGRESS_TEXT_INSIDE="{{ gtk_progress_text_inside | default('1') }}"

# --- Treeview Lines ---
{# Disable treeview lines. #}
# Controls the visibility of lines in tree view widgets (e.g., in GtkInspector
# or file managers). '0' disables the vertical lines between columns/nodes.
export GTK_TREEVIEW_LINES="{{ gtk_treeview_lines | default('0') }}"

# --- Scrollbar Size ---
{# Enlarges the active area for scroll bars. #}
# Increases the hit area of scrollbars, making them easier to click and drag.
# This addresses usability issues reported in MATE desktop environment.
export GTK_ENLARGE_SCROLLBAR="{{ gtk_enlarge_scrollbar | default('1') }}"
