#
#	Logrotate configuration for {{ service_name | default('squidguard') }}.
#	Designed to manage log files generated by the SquidGuard reverse-proxy plugin.
#
{{ log_path | default('/var/log/squidguard') }}/*.log {
    # Rotate log files {{ rotation_frequency | default('weekly') }}
    {{ rotation_frequency | default('weekly') }}
    # Keep the last {{ log_rotation_count | default(5) }} rotated copies
    rotate {{ log_rotation_count | default(5) }}
    # Compress old log files using gzip
    compress
    # Delay compression of the most recently rotated file
    delaycompress
    # Do not error if the log file is missing
    missingok
    # Do not rotate empty log files
    notifempty
    # Create new log files with permissions {{ log_permissions | default('640') }}
    # owned by {{ log_owner | default('proxy') }} and group {{ log_group | default('proxy') }}
    create {{ log_permissions | default('640') }} {{ log_owner | default('proxy') }} {{ log_group | default('proxy') }}
}