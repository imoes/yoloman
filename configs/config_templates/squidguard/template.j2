# Logrotate fragment for {{ (service_name | default('squidguard')) }}.
#
# This template configures log rotation for the squidguard service.
# It ensures that log files in the specified directory are rotated
# according to the defined frequency and retention policy.

{{ (log_path | default('/var/log/squidguard')) }}/*.log {
    # Rotation frequency: How often log files should be rotated.
    # Supported values: daily, weekly, monthly, yearly.
    {{ (rotation_frequency | default('weekly')) }}

    # Number of rotated log files to keep.
    rotate {{ (log_rotation_count | default('5')) }}

    # Compress old log files to save disk space.
    compress

    # Delay compression of the most recent rotated log file.
    delaycompress

    # Do not error if the log file is missing.
    missingok

    # Do not rotate the log if it is empty.
    notifempty

    # Create new log files with the specified permissions, owner, and group.
    create {{ (log_permissions | default('640')) }} {{ (log_owner | default('proxy')) }} {{ (log_group | default('proxy')) }}
}
