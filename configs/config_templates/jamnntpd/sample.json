{
  "listen_address": "0.0.0.0",
  "port": 563,
  "max_connections": 200,
  "messagebase_path": "/var/lib/jamnntpd/messagebase",
  "tls_enabled": true,
  "tls_cert_file": "/etc/jamnntpd/tls/server.crt",
  "tls_key_file": "/etc/jamnntpd/tls/server.key",
  "log_level": "info",
  "log_file": "/var/log/jamnntpd/jamnntpd.log",
  "log_max_size": 100,
  "log_retain_count": 7,
  "expire_enabled": true,
  "expire_default_days": 60,
  "access_groups": [
    {
      "name": "public",
      "allowed_hosts": [
        "all"
      ],
      "perms": [
        "read"
      ]
    },
    {
      "name": "trusted",
      "allowed_hosts": [
        "10.0.0.0/24",
        "192.168.1.0/24"
      ],
      "perms": [
        "read",
        "post"
      ]
    },
    {
      "name": "admin",
      "allowed_hosts": [
        "127.0.0.1"
      ],
      "perms": [
        "read",
        "post",
        "admin"
      ]
    }
  ],
  "server_greeting": "JAM NNTP Server v2.1 ready \u2014 news.example.org"
}
