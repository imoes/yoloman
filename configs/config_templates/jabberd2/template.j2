# Defaults for jabberd2 initscript
# sourced by /etc/init.d/jabberd2
# installed at /etc/default/jabberd2 by the maintainer scripts

# run router
# Enable running the jabberd2 router component.
ROUTER_RUN={{ (router_run | default(true)) | lower }}

# run sm
# Enable running the jabberd2 session manager (sm) component.
SM_RUN={{ (sm_run | default(true)) | lower }}

# run s2s
# Enable running the jabberd2 server-to-server (s2s) component.
S2S_RUN={{ (s2s_run | default(true)) | lower }}

# run c2s
# Enable running the jabberd2 client-to-server (c2s) component.
C2S_RUN={{ (c2s_run | default(true)) | lower }}