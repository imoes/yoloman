{
  "c2s": {
    "port": 5222,
    "bind": "0.0.0.0",
    "tls": {
      "enabled": true,
      "cert_file": "/etc/jabberd2/certs/server.crt",
      "key_file": "/etc/jabberd2/certs/server.key",
      "ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
      "verify_peer": false,
      "ca_file": "/etc/jabberd2/certs/ca.pem"
    }
  },
  "authreg": {
    "id": "authreg",
    "driver": "sql",
    "params": [
      {
        "name": "dsn",
        "value": "mysql://jabberd:pass@localhost/jabberd"
      },
      {
        "name": "password-query",
        "value": "SELECT password FROM users WHERE username = '%u'"
      },
      {
        "name": "password-format",
        "value": "crypt"
      }
    ]
  },
  "storage": {
    "id": "storage",
    "driver": "sql",
    "params": [
      {
        "name": "dsn",
        "value": "mysql://jabberd:pass@localhost/jabberd"
      },
      {
        "name": "storage-query",
        "value": "SELECT xml FROM storage WHERE username = '%u' AND namespace = '%n'"
      },
      {
        "name": "insert-storage-query",
        "value": "INSERT INTO storage (username, namespace, xml, updated) VALUES ('%u', '%n', '%x', NOW()) ON DUPLICATE KEY UPDATE xml = VALUES(xml), updated = VALUES(updated)"
      }
    ]
  },
  "sm": {
    "id": "sm",
    "log": "/var/log/jabberd2/sm.log",
    "max_packets": 100,
    "route_localname": true
  },
  "register": {
    "enabled": false,
    "set_user_password": true,
    "max_users_per_ip": 5
  },
  "limits": {
    "max_streams": 100,
    "idle_timeout": 600,
    "read_rate": 1024,
    "write_rate": 1024
  },
  "debug": {
    "level": 1,
    "file": "/var/log/jabberd2/debug.log"
  },
  "host": "chat.example.com",
  "dns_srv": true
}
