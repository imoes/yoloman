{
  "enable_deny": true,
  "deny": 5,
  "unlock_time": 300,
  "fail_interval": 600,
  "dir": "/run/faillock",
  "audit": true,
  "silent": false,
  "deny_root": false,
  "preauth": true,
  "deny_users": [
    "admin",
    "backup"
  ],
  "deny_groups": [
    "wheel",
    "sudo"
  ],
  "allow_users": [
    "service_account"
  ],
  "allow_groups": [
    "deploy"
  ]
}
