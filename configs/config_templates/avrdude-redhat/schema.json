{
  "avrdude_conf_version": {
    "type": "string",
    "default": "7.3",
    "description": "AVRDUDE configuration file version string."
  },
  "default_parallel": {
    "type": "string",
    "default": "/dev/parport0",
    "description": "Default parallel port device path."
  },
  "default_serial": {
    "type": "string",
    "default": "/dev/ttyS0",
    "description": "Default serial port device path."
  },
  "default_spi": {
    "type": "string",
    "default": "",
    "description": "Default SPI device path."
  },
  "default_linuxgpio": {
    "type": "string",
    "default": "gpiochip0",
    "description": "Default Linux GPIO chip name for linuxgpio programmer."
  },
  "allow_subshells": {
    "type": "string",
    "default": "no",
    "description": "Allow subshells in avrdude configuration."
  }
}
