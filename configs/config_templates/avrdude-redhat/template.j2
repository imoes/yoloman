# Schema: default_parallel (default: '/dev/parport0')
default_parallel   = "{{ default_parallel | default('/dev/parport0') }}";

# Default serial port device path.
# Schema: default_serial (default: '/dev/ttyS0')
default_serial     = "{{ default_serial | default('/dev/ttyS0') }}";

# Default SPI device path.
# Schema: default_spi (default: '')
default_spi        = "{{ default_spi | default('') }}";

# default_baudrate = 115200;
