; cupp.cfg
;
; This is the configuration file for cupp.py.
; The application reads this file to determine how to generate password lists.
; It does not modify the file itself.

; -----------------------------------------------------------------------------
; [years]
; Comma-separated list of years to include in password generation.
; These years are often appended to common words or names to create realistic passwords.
; -----------------------------------------------------------------------------
[years]
years = {{ years | default('2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020') }}

; -----------------------------------------------------------------------------
; [leet]
; Leet speak substitution map.
; Standard substitutions used to transform base words into leet variants (e.g., 'a' -> '4').
; These are hardcoded defaults for the tool; modify cupp.py source if deeper changes are needed.
; -----------------------------------------------------------------------------
[leet]
a=4
i=1
e=3
t=7
o=0
s=5
g=9
z=2

; -----------------------------------------------------------------------------
; [specialchars]
; Comma-separated list of special characters to include in password generation.
; These characters are inserted into words or used as suffixes/prefixes to increase entropy.
; -----------------------------------------------------------------------------
[specialchars]
chars={{ specialchars | default("!,@,'#',$,%,%,&,*") }}

; -----------------------------------------------------------------------------
; [nums]
; Random number range configuration.
; Defines the range [from, to] for random integers appended to generated words.
; Higher ranges increase the complexity and size of the output wordlist.
; -----------------------------------------------------------------------------
[nums]
from={{ nums_from | default(0) }}
to={{ nums_to | default(100) }}

; -----------------------------------------------------------------------------
; [word_length]
; Word length shaping configuration.
; Filters words from the compiled wordlist based on their character length.
; Words shorter than wcfrom or longer than wcto will be excluded.
; This helps keep the wordlist focused on realistic password lengths.
; -----------------------------------------------------------------------------
wcfrom={{ wcfrom | default(5) }}
wcto={{ wcto | default(12) }}

; -----------------------------------------------------------------------------
; [threshold]
; Threshold setting for word concatenations.
; When generating passwords by combining words (e.g., using the -w option),
; this limit prevents excessive combinatorial explosion.
; Example: with 200 base words and a threshold of 200, the tool stops generating
; combinations after producing 40,000 words (200 * 200).
; Increasing this value may cause high memory consumption; use with caution.
; -----------------------------------------------------------------------------
threshold={{ threshold | default(200) }}

; -----------------------------------------------------------------------------
; [alecto]
; External wordlist source configuration.
; URL pointing to the Alecto wordlist (a common dictionary used in penetration testing).
; -----------------------------------------------------------------------------
[alecto]
alectourl={{ alectourl | default('https://github.com/yangbh/Hammer/raw/b0446396e8d67a7d4e53d6666026e078262e5bab/lib/cupp/alectodb.csv.gz') }}

; -----------------------------------------------------------------------------
; [downloader]
; Dictionary download source configuration.
; URL pointing to a standard Unix security password dictionary.
; -----------------------------------------------------------------------------
[downloader]
dicturl={{ dicturl | default('http://ftp.funet.fi/pub/unix/security/passwd/crack/dictionaries/') }}