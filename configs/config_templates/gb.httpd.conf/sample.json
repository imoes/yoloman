{
  "httpd.listen": "0.0.0.0:80",
  "httpd.max_clients": 256,
  "httpd.max_requests_per_child": 10000,
  "httpd.timeout": 60,
  "httpd.document_root": "/var/www/html",
  "httpd.server_admin": "webmaster@example.com",
  "httpd.server_name": "web.example.com",
  "httpd.ssl_enabled": false,
  "httpd.ssl_certificate_file": "/etc/ssl/certs/web.example.com.crt",
  "httpd.ssl_private_key_file": "/etc/ssl/private/web.example.com.key",
  "httpd.log_level": 3,
  "httpd.directory_index": [
    "index.html",
    "index.php"
  ],
  "httpd.directory_configs": [
    {
      "path": "/var/www/html",
      "options": [
        "Indexes",
        "FollowSymLinks"
      ],
      "allow_override": [
        "AuthConfig"
      ],
      "require": [
        "all",
        "granted"
      ]
    },
    {
      "path": "/var/www/html/admin",
      "options": [
        "Indexes"
      ],
      "allow_override": [
        "AuthConfig"
      ],
      "require": [
        "host",
        "192.168.1.0/24"
      ]
    }
  ],
  "httpd.virtual_hosts": [
    {
      "address": "*",
      "port": 8080,
      "server_name": "api.example.com",
      "document_root": "/var/www/api",
      "ssl_enabled": true,
      "ssl_certificate_file": "/etc/ssl/certs/api.example.com.crt",
      "ssl_private_key_file": "/etc/ssl/private/api.example.com.key"
    }
  ]
}
