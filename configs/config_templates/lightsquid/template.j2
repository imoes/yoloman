# LightSquid Configuration Template
# Configures the URL alias and filesystem path for the LightSquid CGI application.

# Alias directive mapping the URL path to the CGI script directory.
# lightsquid_alias: The URL alias path for the LightSquid web interface.
# lightsquid_document_root: The filesystem path to the LightSquid CGI scripts.
Alias {{ lightsquid_alias | default('/lightsquid/') }} {{ lightsquid_document_root | default('/usr/lib/cgi-bin/lightsquid/') }}

# Location block to secure the LightSquid web interface.
# Restricts access to local connections only by default.
<Location "{{ lightsquid_alias | default('/lightsquid/') }}">
    Require local
</Location>