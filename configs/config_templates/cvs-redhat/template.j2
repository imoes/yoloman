# Set the default remote shell for CVS commands.
# This corresponds to the CVS_RSH environment variable.
# If CVS_RSH is already set in the environment, this line is skipped.
# Otherwise, it sets CVS_RSH to the value defined by cvs_rsh_default.
if ( "$?CVS_RSH" == 0 ) setenv CVS_RSH {{ cvs_rsh_default | default('ssh') }}
