{
  "dbus_allow_user_root": "root",
  "dbus_allow_user_ipaapi": "ipaapi",
  "conncheck_args": "1",
  "conncheck_prepend_user_name": "no",
  "conncheck_argument_passing_method": "cmdline",
  "trust_enable_agent_args": "1",
  "trust_enable_agent_prepend_user_name": "no",
  "trust_enable_agent_argument_passing_method": "cmdline",
  "config_enable_sid_args": "10",
  "config_enable_sid_prepend_user_name": "no",
  "config_enable_sid_argument_passing_method": "cmdline",
  "introspectable_min_uid": 0,
  "introspectable_max_uid": 0
}
