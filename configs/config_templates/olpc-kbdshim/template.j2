# ==============================================================================
# olpc-kbdshim daemon configuration
# ==============================================================================
# This template configures the command-line options passed to the olpc-kbdshim
# daemon. It specifies paths to helper binaries and socket paths for inter-process
# communication.
# ==============================================================================

# Path to the olpc-rotate binary used for screen rotation.
# Default: /usr/bin/olpc-rotate
DAEMON_OPTS="-f -l -r {{ olpc_rotate_path | default('/usr/bin/olpc-rotate') }} \
-V {{ olpc_volume_path | default('/usr/bin/olpc-volume') }} \
-b {{ olpc_brightness_path | default('/usr/bin/olpc-brightness') }} \
-R {{ command_socket_path | default('/var/run/olpc-kbdshim_command') }} \
-A {{ powerevents_socket_path | default('/var/run/powerevents') }}"