{
  "olpc_rotate_path": {
    "type": "string",
    "default": "/usr/bin/olpc-rotate",
    "description": "Path to the olpc-rotate binary"
  },
  "olpc_volume_path": {
    "type": "string",
    "default": "/usr/bin/olpc-volume",
    "description": "Path to the olpc-volume binary"
  },
  "olpc_brightness_path": {
    "type": "string",
    "default": "/usr/bin/olpc-brightness",
    "description": "Path to the olpc-brightness binary"
  },
  "command_socket_path": {
    "type": "string",
    "default": "/var/run/olpc-kbdshim_command",
    "description": "Path to the command socket for olpc-kbdshim"
  },
  "powerevents_socket_path": {
    "type": "string",
    "default": "/var/run/powerevents",
    "description": "Path to the powerevents socket"
  }
}
