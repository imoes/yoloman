##################################################
# Basic config file of BinClock 1.5 [2004-07-24]
# These defaults can be changed
# Nico Golde <{{ email | default('binclock@ngolde.de') }}>
# http://www.{{ domain | default('ngolde.de') }}
# BinClock supports the colors:
# red, white, green, cyan, magenta, blue, yellow, black
##################################################

# Color used to represent binary '1' (e.g., red, green, 1, etc.)
# Default: {{ 'red' }}
color_one={{ color_one | default('red') }}

# Color used to represent binary '0' (e.g., green, red, 0, etc.)
# Default: {{ 'green' }}
color_zero={{ color_zero | default('green') }}

# Character used to represent binary '1'
# Default: {{ '1' }}
char_one={{ char_one | default('1') }}

# Character used to represent binary '0'
# Default: {{ '0' }}
char_zero={{ char_zero | default('0') }}