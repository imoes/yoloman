{
  "gss_enabled": true,
  "gss_instances": [
    {
      "type": "GSI_AUTH",
      "name": "globus-gssapi-gsi",
      "authn_module": "/usr/libexec/globus/globus_gsi_authn_module_gsi.so",
      "authz_module": "/usr/libexec/globus/globus_gsi_authz_module_gsi.so",
      "cred_store": "/etc/grid-security/hostcert.pem"
    }
  ],
  "pbs_job_manager_executable": "/usr/libexec/globus/globus_pbs_job_manager",
  "pbs_job_manager_jobtype": "pbs",
  "pbs_job_manager_queue": "batch",
  "pbs_job_manager_account": "project123",
  "pbs_job_manager_environment": [
    {
      "name": "PATH",
      "value": "/opt/torque/bin:/usr/local/bin:/usr/bin:/bin"
    },
    {
      "name": "LD_LIBRARY_PATH",
      "value": "/opt/torque/lib64"
    }
  ],
  "gridftp_enabled": true,
  "gridftp_servers": [
    {
      "host": "gridftp.example.edu",
      "port": 2811,
      "service": "gsiftp",
      "transfer_mode": "passive",
      "certificate": "/etc/grid-security/hostcert.pem",
      "key": "/etc/grid-security/hostkey.pem",
      "trusted_ca_certs_dir": "/etc/grid-security/certificates"
    }
  ]
}
