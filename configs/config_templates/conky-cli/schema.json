{
  "font": {
    "type": "string",
    "default": "DejaVu Sans Mono:size=12",
    "description": "Font specification for Conky text"
  },
  "gap_x": {
    "type": "number",
    "default": 60,
    "description": "Horizontal gap (pixels) between screen edge and Conky window"
  },
  "gap_y": {
    "type": "number",
    "default": 60,
    "description": "Vertical gap (pixels) between screen edge and Conky window"
  },
  "update_interval": {
    "type": "number",
    "default": 1.0,
    "description": "Update interval in seconds"
  }
}
