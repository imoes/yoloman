# ==============================================================================
# Sphinx (pwdsphinx) Configuration Template
# ==============================================================================
# This template configures the Sphinx password hash oracle. It supports
# standalone client usage, a local server instance, and WebSphinx browser
# extensions.
#
# Variables are sourced from the Ansible play/role variables matching the
# schema field names. All variables have sensible defaults embedded to ensure
# idempotent rendering even if variables are undefined.
# ==============================================================================

# ------------------------------------------------------------------------------
# [client] Section
# ------------------------------------------------------------------------------
# The client section is required for the password hash generation utility.
[client]

# verbose_client: Whether to produce some output on the console for the client.
# Default: 'false'
verbose = {{ verbose_client | default('false') }}

# address_client: The IP address or hostname the client server is listening on.
# Default: '127.0.0.1'
address = "{{ address_client | default('127.0.0.1') }}"

# port_client: The port on which the client server is listening.
# Default: '2355'
port = {{ port_client | default('2355') }}

# datadir_client: The directory where the client stores its master secret.
# Default: '~/.sphinx'
datadir = "{{ datadir_client | default('~/.sphinx') }}/

# validate_password_client: Stores a check digit of 5 bits in the rule blob
# to notice typos of the master password.
# Default: 'true'
validate_password={{ validate_password_client | default('true') }}

# ------------------------------------------------------------------------------
# [server] Section
# ------------------------------------------------------------------------------
# The server section is only needed if you run the oracle yourself.
[server]

# port_server: The port on which the server is listening.
# Default: '2355'
port={{ port_server | default('2355') }}

# ssl_key_server: The path to the SSL key file.
# Default: '/etc/ssl/sphinx/server.der'
ssl_key="{{ ssl_key_server | default('/etc/ssl/sphinx/server.der') }}"

# ssl_cert_server: The path to the SSL certificate file.
# Default: '/etc/ssl/sphinx/cert.pem'
ssl_cert="{{ ssl_cert_server | default('/etc/ssl/sphinx/cert.pem') }}"

# datadir_server: The root directory where all data is stored.
# Default: '/var/lib/sphinx'
datadir= "{{ datadir_server | default('/var/lib/sphinx') }}"

# verbose_server: Whether to produce some output on the console for the server.
# Default: 'false'
verbose={{ verbose_server | default('false') }}

# rl_decay: Decay ratelimit after rl_decay seconds.
# Default: '1800'
rl_decay= {{ rl_decay | default('1800') }}

# rl_threshold: Increase hardness after rl_threshold attempts if not decaying.
# Default: '1'
rl_threshold= {{ rl_threshold | default('1') }}

# rl_gracetime: When checking freshness of puzzle solution, allow this extra
# gracetime in addition to the hardness max solution time.
# Default: 10
rl_grace_time={{ rl_gracetime | default(10) }}

# ------------------------------------------------------------------------------
# [websphinx] Section
# ------------------------------------------------------------------------------
# The websphinx section is only needed if you use the browser webextensions.
[websphinx]

# pinentry: The path of your pinentry program.
# Default: '/usr/bin/pinentry'
pinentry="{{ pinentry | default('/usr/bin/pinentry') }}"

# log_websphinx: A file where websphinx logs, this is only for dev/debug purposes.
# Default: ''
log="{{ log_websphinx | default('') }}"
