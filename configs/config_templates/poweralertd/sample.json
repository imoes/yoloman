{
  "log_level": "info",
  "pid_file": "/run/poweralertd/poweralertd.pid",
  "auto_detect": true,
  "notification_script": "/usr/local/bin/poweralert-notify.sh",
  "tick_interval": 60,
  "warning_threshold": 20,
  "critical_threshold": 10,
  "battery_device_patterns": [
    "BAT[0-9]*"
  ],
  "excluded_devices": [
    "BAT1"
  ],
  "notification_timeout": 10,
  "smtp_enabled": true,
  "smtp_server": "smtp.gmail.com",
  "smtp_port": 587,
  "smtp_user": "alert@example.com",
  "smtp_password": "app_password_here",
  "smtp_from": "poweralert@example.com",
  "smtp_to": [
    "admin@example.com",
    "ops@example.com"
  ],
  "smtp_use_tls": true,
  "webhooks_enabled": true,
  "webhooks": [
    {
      "url": "https://maker.ifttt.com/trigger/power_alert/with/key/secret",
      "method": "POST",
      "timeout": 10,
      "headers": {
        "Content-Type": "application/json"
      }
    }
  ]
}
