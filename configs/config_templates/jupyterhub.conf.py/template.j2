# JupyterHub Configuration Template
# This Jinja2 template generates a self-documenting `jupyterhub_config.py` file.
# All variables are sourced from the Ansible role variables, with explicit defaults
# matching the JupyterHub schema to ensure safe rendering and reuse.

# ==============================================================================
# Core Process Settings
# ==============================================================================

# Whether to run JupyterHub as a background daemon process.
# Default: True (runs as a daemon). Set to False if running under systemd or similar.
c.JupyterHub.daemonize = {{ daemonize | default(True) | lower }}

# Base directory for JupyterHub configuration, logs, and data files.
# Default: /etc/jupyterhub
c.JupyterHub.cwd = '{{ cwd | default("/etc/jupyterhub") }}'

# ==============================================================================
# Database Configuration
# ==============================================================================

# Database connection string.
# For single-node: sqlite:///jupyterhub.sqlite
# For production: postgresql+psycopg2://user:pass@host/db or mysql+pymysql://...
# Default: sqlite:///jupyterhub.sqlite
c.JupyterHub.db_url = '{{ db_url | default("sqlite:///jupyterhub.sqlite") }}'

# ==============================================================================
# Authenticator & Spawner Backend Selection
# ==============================================================================

# Authenticator backend class to handle user login.
# Examples: jupyterhub.auth.PAMAuthenticator, oauthenticator.GitHubOAuthenticator
# Default: jupyterhub.auth.PAMAuthenticator
c.JupyterHub.authenticator_class = '{{ authenticator_class | default("jupyterhub.auth.PAMAuthenticator") }}'

# Spawner backend to launch user servers.
# Examples: jupyterhub.spawner.LocalProcessSpawner, dockerspawner.DockerSpawner, kubespawner.KubeSpawner
# Default: jupyterhub.spawner.LocalProcessSpawner
c.JupyterHub.spawner_class = '{{ spawner_class | default("jupyterhub.spawner.LocalProcessSpawner") }}'

# ==============================================================================
# Concurrency & Resource Limits
# ==============================================================================

# Maximum number of user servers that may be spawned concurrently.
# Prevents resource exhaustion during peak login times.
# Default: 100
c.JupyterHub.concurrent_spawn_limit = {{ concurrent_spawn_limit | default(100) }}

# ==============================================================================
# Database Maintenance
# ==============================================================================

# Maximum age (in seconds) for database entries before archiving.
# Set to 0 to disable automatic archival.
# Default: 0 (disabled)
c.JupyterHub.db_archive_max_age = {{ db_archive_max_age | default(0) }}

# ==============================================================================
# Proxy Configuration (ConfigurableHTTPProxy)
# ==============================================================================

# IP address for the ConfigurableHTTPProxy's internal API.
# Usually bound to localhost or an internal network interface.
# Default: 127.0.0.1
c.ConfigurableHTTPProxy.api_ip = '{{ proxy_api_ip | default("127.0.0.1") }}'

# Port for the ConfigurableHTTPProxy's internal API.
# Default: 8001
c.ConfigurableHTTPProxy.api_port = {{ proxy_api_port | default(8001) }}

# ==============================================================================
# Hub Network Settings
# ==============================================================================

# IP address the Hub binds to.
# Typically 127.0.0.1 for local setups, or the host's internal IP for remote access.
# Default: 127.0.0.1
c.JupyterHub.hub_ip = '{{ hub_ip | default("127.0.0.1") }}'

# Port the Hub binds to for internal communication and UI.
# Default: 8081
c.JupyterHub.hub_port = {{ hub_port | default(8081) }}

# ==============================================================================
# Public URL Configuration
# ==============================================================================

# Public base URL path for the JupyterHub.
# Examples: '/' for root, '/hub/' if behind a sub-path reverse proxy.
# Default: /
c.JupyterHub.base_url = '{{ base_url | default("/") }}'

# ==============================================================================
# SSL/TLS Configuration
# ==============================================================================

# Path to the SSL certificate file.
# Leave empty string '' to disable HTTPS (use reverse proxy for SSL in production).
# Default: '' (empty, HTTPS disabled)
c.JupyterHub.certfile = '{{ ssl_certfile | default("") }}'

# Path to the SSL private key file.
# Required if SSL/TLS is enabled via certfile.
# Default: '' (empty, key disabled)
c.JupyterHub.keyfile = '{{ ssl_keyfile | default("") }}'

# ==============================================================================
# Idle Timeout Settings
# ==============================================================================

# Seconds of inactivity before an idle user server is automatically stopped.
# Set to 0 to disable idle timeout (servers run indefinitely until user logs out).
# Default: 0 (disabled)
c.JupyterHub.idle_timeout = {{ idle_timeout | default(0) }}

# ==============================================================================
# Spawner Container/Image Settings
# ==============================================================================

# Default Docker image used to spawn single-user servers.
# Only used if the spawner supports Docker (e.g., DockerSpawner).
# Default: jupyter/base-notebook
# Note: While 'docker_image' is in the schema, it is technically a Spawner config,
# but often applied at the root or specific spawner class level depending on version.
# We apply it to the spawner class instance if it supports it, or generally.
# JupyterHub root config often allows setting docker_image directly if using default spawner.
c.JupyterHub.docker_image = '{{ docker_image | default("jupyter/base-notebook") }}'

# ==============================================================================
# OAuth Configuration (Dynamic List)
# ==============================================================================

# Iterates over oauth_configs list to set specific OAuth parameters.
# Expected item structure: { config_var: "string", value: <any> }
{% for oauth in oauth_configs | default([]) %}
# OAuth Override: {{ oauth.config_var }}
c.{{ oauth.config_var }} = {{ oauth.value | tojson }}
{% endfor %}

# ==============================================================================
# Custom Services Configuration (Dynamic List)
# ==============================================================================

# Iterates over services list to register additional JupyterHub services
# (e.g., culling, metrics, custom admin tools).
# Expected item structure: { name: "string", url: "string", admin: bool, api_token: "string" }
{% for service in services | default([]) %}
# Service: {{ service.name }}
c.JupyterHub.services.append({
    'name': '{{ service.name }}',
    'url': '{{ service.url }}',
    'admin': {{ service.admin | default(False) | lower }},
    'api_token': '{{ service.api_token }}'
})
{% endfor %}