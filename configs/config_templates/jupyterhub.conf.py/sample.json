{
  "daemonize": true,
  "cwd": "/etc/jupyterhub",
  "db_url": "sqlite:///jupyterhub.sqlite",
  "authenticator_class": "jupyterhub.auth.DummyAuthenticator",
  "spawner_class": "jupyterhub.spawner.LocalProcessSpawner",
  "concurrent_spawn_limit": 50,
  "db_archive_max_age": 86400,
  "proxy_api_ip": "127.0.0.1",
  "proxy_api_port": 8001,
  "hub_ip": "127.0.0.1",
  "hub_port": 8081,
  "base_url": "/hub/",
  "ssl_certfile": "",
  "ssl_keyfile": "",
  "idle_timeout": 3600,
  "docker_image": "jupyter/minimal-notebook",
  "oauth_configs": [],
  "services": [
    {
      "name": "cull-idle",
      "url": "http://localhost:9999",
      "admin": true,
      "api_token": "cull-token-123"
    },
    {
      "name": "prometheus",
      "url": "http://localhost:8082",
      "admin": false,
      "api_token": "prom-token-456"
    }
  ]
}
