# debfoster configuration file
# See man page debfoster(1) for detailed documentation.

# install_cmd: Command used to install packages.
InstallCmd = {{ install_cmd | default('apt-get install') }}

# remove_cmd: Command used to remove packages (with purge).
RemoveCmd = {{ remove_cmd | default('apt-get --purge remove') }}

# info_cmd: Command used to display package information.
InfoCmd = {{ info_cmd | default('dpkg -s') }}

# keeper_file: Path to the file storing the list of kept/orphaned packages.
KeeperFile = {{ keeper_file | default('/var/lib/debfoster/keepers') }}

# dpkg_status: Path to dpkg's status file.
DpkgStatus = {{ dpkg_status | default('/var/lib/dpkg/status') }}

# dpkg_available: Path to dpkg's available file.
DpkgAvailable = {{ dpkg_available | default('/var/lib/dpkg/available') }}

# max_priority: Highest priority level to ask questions about.
# Possible values: required, important, standard, optional, extra, or ANY.
MaxPriority = {{ max_priority | default('standard') }}

# use_hold: Consider packages marked with 'hold' status as keepers.
UseHold = {{ use_hold | default(True) | lower }}

# use_essential: Consider packages marked 'Essential: yes' as keepers.
UseEssential = {{ use_essential | default(True) | lower }}

# use_predepends: Treat 'Pre-Depends' relationships as regular dependencies.
UsePreDepends = {{ use_predepends | default(True) | lower }}

# use_recommends: Treat 'Recommends' relationships as dependencies.
UseRecommends = {{ use_recommends | default(True) | lower }}

# use_suggests: Treat 'Suggests' relationships as dependencies.
UseSuggests = {{ use_suggests | default(False) | lower }}

# use_tasks: Treat tasksel tasks as regular packages (prefixed 'task-').
UseTasks = {{ use_tasks | default(False) | lower }}

# keep_sections: Comma-separated list of package sections to always keep.
# Example: libs,utils
KeepSections = {{ keep_sections | default('') }}

# nokeep_sections: Comma-separated list of package sections to never keep.
# Example: science
NokeepSections = {{ nokeep_sections | default('') }}

# guess_depends: Comma-separated list of suffixes to treat as dependencies of the base package name.
# Example: dev,doc
GuessDepends = {{ guess_depends | default('') }}

# negative_keepers: Whether to respect negative entries (explicit removals) in the keeper file.
NegativeKeepers = {{ negative_keepers | default(False) | lower }}

# verbose: Enable verbose output (same as -v on command line).
Verbose = {{ verbose | default(False) | lower }}

# force: Force non-interactive mode, answering 'No' to all questions (same as -f).
Force = {{ force | default(False) | lower }}

# quiet: Suppress all prompts (same as -q).
Quiet = {{ quiet | default(False) | lower }}