# Dropbear SSH Server Configuration
# This file is generated by Ansible. Do not edit manually.
# It configures the 'dropbear' SSH daemon.

# ==============================================================================
# Connection Settings
# ==============================================================================

# The port on which Dropbear listens for incoming SSH connections.
# Use 22 for standard SSH.
DROPBEAR_PORT={{ listen_port | default(22) }}

# List of IP addresses to bind to.
# Leave empty to bind to all interfaces.
{% if (listen_addresses | default([])) | length > 0 %}
DROPBEAR_ADDRESS={{ listen_addresses | default([]) | join(' ') }}
{% else %}
DROPBEAR_ADDRESS=""
{% endif %}

# ==============================================================================
# Authentication Settings
# ==============================================================================

# Allow password-based login.
# Disable for key-only authentication (recommended for security).
{% if enable_password_auth | default(False) %}
DROPBEAR_PASSWORDAUTH=1
{% else %}
DROPBEAR_PASSWORDAUTH=0
{% endif %}

# Allow public key authentication (recommended).
{% if enable_pubkey_auth | default(True) %}
DROPBEAR_PUBKEYAUTH=1
{% else %}
DROPBEAR_PUBKEYAUTH=0
{% endif %}

# ==============================================================================
# Host Keys & Forwarding
# ==============================================================================

# List of host key files to load. At least one RSA or Ed25519 key is required.
# Each key is passed to the daemon via the -r flag.
{% if host_keys | default([]) | length > 0 %}
{% for key in host_keys | default([]) %}
# Host key: {{ key }}
DROPBEAR_EXTRA_ARGS="${DROPBEAR_EXTRA_ARGS} -r {{ key }}"
{% endfor %}
{% endif %}

# Path to a file containing the pre-authentication login banner.
# Empty to disable.
{% if banner_file | default('') %}
DROPBEAR_BANNER={{ banner_file | default('') }}
{% else %}
DROPBEAR_BANNER=""
{% endif %}

# Allow local/remote TCP port forwarding (e.g., for tunneling).
# Disable if not needed for security.
{% if enable_tcp_forwarding | default(True) %}
DROPBEAR_TCPFORWARDING=1
{% else %}
DROPBEAR_TCPFORWARDING=0
{% endif %}

# Allow X11 forwarding for graphical applications.
# Enable only if using GUI over SSH.
{% if enable_x11_forwarding | default(False) %}
DROPBEAR_X11FORWARDING=1
{% else %}
DROPBEAR_X11FORWARDING=0
{% endif %}

# Allow SSH agent forwarding (use with caution; enables credential theft risk).
{% if enable_agent_forwarding | default(False) %}
DROPBEAR_AGENTFORWARDING=1
{% else %}
DROPBEAR_AGENTFORWARDING=0
{% endif %}

# ==============================================================================
# Session Limits & Protocol Options
# ==============================================================================

# Maximum authentication attempts per connection before disconnecting the client.
DROPBEAR_MAXAUTHTRIES={{ max_auth_tries | default(6) }}

# Idle session timeout in seconds.
# 0 = no timeout (sessions persist).
DROPBEAR_IDLE_TIMEOUT={{ idle_timeout | default(0) }}

# If true, disable IPv6 support (forces IPv4 only).
# Adds the -4 flag to extra args.
{% if disable_ipv6 | default(False) %}
DROPBEAR_EXTRA_ARGS="${DROPBEAR_EXTRA_ARGS} -4"
{% endif %}

# Enable legacy cryptographic methods for compatibility with old clients.
# ⚠️ Weakens security. Adds the -E flag.
{% if legacy_crypto | default(False) %}
DROPBEAR_EXTRA_ARGS="${DROPBEAR_EXTRA_ARGS} -E"
{% endif %}

# Additional command-line arguments for dropbear.
# (e.g., ['-w'] to disallow root login).
# Avoid duplicating flags set above.
{% if extra_args | default([]) | length > 0 %}
DROPBEAR_EXTRA_ARGS="${DROPBEAR_EXTRA_ARGS} {{ extra_args | default([]) | join(' ') }}"
{% endif %}