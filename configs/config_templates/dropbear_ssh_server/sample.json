{
  "listen_port": 22,
  "listen_addresses": [],
  "enable_password_auth": false,
  "enable_pubkey_auth": true,
  "host_keys": [
    {
      "path": "/etc/dropbear/dropbear_rsa_host_key",
      "type": "RSA"
    },
    {
      "path": "/etc/dropbear/dropbear_ed25519_host_key",
      "type": "Ed25519"
    }
  ],
  "banner_file": "/etc/issue.net",
  "enable_tcp_forwarding": true,
  "enable_x11_forwarding": false,
  "enable_agent_forwarding": false,
  "max_auth_tries": 4,
  "idle_timeout": 300,
  "disable_ipv6": true,
  "legacy_crypto": false,
  "extra_args": [
    "w"
  ]
}
