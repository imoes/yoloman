[core]
# Network interface that ConnMan should ignore (e.g., for manual control)
# Set to 'any' to ignore all interfaces, or a comma-separated list of interface names
# Default: empty (no interfaces ignored)
# Format: InterfaceName, anotherInterface, ...
# Example: eth0, virbr0
# IgnoredInterfaces = eth0,virbr0

# Set to true to enable offline mode (no network access, only local services)
# Default: false
# OfflineMode = false

# Name of the network technology to prioritize (e.g., ethernet, wifi, gsm, cdma)
# Used only when multiple technologies offer connectivity; higher priority technologies are preferred
# Default: empty (use built-in priority order)
# TechnologyOrder = wifi,ethernet

# Set to true to prevent automatic reconnection attempts after disconnection
# Useful in kiosk or embedded use-cases where connection is manually controlled
# Default: false
# ManualConnect = false

# Set to true to disable automatic connection to known networks
# User must explicitly connect to each network (e.g., for privacy-sensitive setups)
# Default: false
# AutoConnect = true

# Set to true to allow Wi-Fi to automatically scan and connect to known networks when in range
# Disable if Wi-Fi scanning causes excessive power drain or interference
# Default: true
# AutoConnectEnabled = true

[wifi]
# Enable or disable Wi-Fi radio globally
# Set to false to permanently disable Wi-Fi (overrides per-network settings)
# Default: true
# Enabled = true

# Set to true to allow the device to enter low-power state when idle (e.g., suspend Wi-Fi scanning)
# May delay reconnection; useful for battery-powered devices
# Default: true
# PowerSaving = true

# Set to true to enable random MAC address generation for Wi-Fi scans/connections (for privacy)
# Note: may break some networks that rely on device ID (e.g., MAC filtering)
# Default: false
# RandomizeMAC = true

# Set to true to enable Wi-Fi Direct support (e.g., for peer-to-peer connections)
# Requires hardware and driver support
# Default: true
# WFD = true

[ethernet]
# Enable or disable Ethernet technology globally
# Set to false to disable all wired connections (e.g., headless embedded systems)
# Default: true
# Enabled = true

[offlinemode]
# Set to true to automatically enter offline mode when no networks are known or reachable
# Prevents continuous connection attempts in unreachable environments
# Default: false
# Enable = false

[proxysvc]
# Enable or disable the system proxy service (used for transparent proxy support)
# Only needed if you use system-wide HTTP/HTTPS proxies
# Default: true
# Enabled = true

# Set to true to enable PAC (Proxy Auto-Configuration) support
# Requires a valid PAC URL in Proxy configuration
# Default: true
# PAC = true
