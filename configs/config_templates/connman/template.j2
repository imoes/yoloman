#!/bin/sh

# Connection Manager service init script.
# This script manages the lifecycle of the `connmand` daemon, handling start, stop, restart,
# and status checks. It sources default configurations and sets up runtime state directories
# as needed.
#
# Variables:
#   DAEMON    : Path to the connmand executable.
#   DESC      : Human-readable description of the service.
#   NAME      : Service name identifier.
#   DAEMON_OPTS: Additional command-line arguments passed to the daemon.

### BEGIN INIT INFO
# Provides:       connman
# Required-Start: $remote_fs $syslog dbus
# Required-Stop:  $remote_fs $syslog dbus
# Default-Start:  2 3 4 5
# Default-Stop:   0 1 6
# Short-Description: Connection Manager
### END INIT INFO


# Path to the connmand daemon executable.
# Default: /usr/sbin/connmand
DAEMON={{ DAEMON | default('/usr/sbin/connmand') }}

# Description of the service.
# Default: Connection Manager
DESC="{{ DESC | default('Connection Manager') }}"

# Name of the service.
# Default: connman
NAME={{ NAME | default('connman') }}

# Source LSB init functions for standard logging and status commands.
. /lib/lsb/init-functions

# Source default configuration file if it exists.
# This allows external overrides or environment-specific settings.
# Default config path: /etc/default/connman
CONNMAN_DEFAULT_CONFIG={{ CONNMAN_DEFAULT_CONFIG | default('/etc/default/connman') }}
if [ -f {{ CONNMAN_DEFAULT_CONFIG | default('/etc/default/connman') }} ] ; then
	. {{ CONNMAN_DEFAULT_CONFIG | default('/etc/default/connman') }}
fi

# Setup runtime state directory for resolv.conf symlink.
# Connman uses this directory to store the generated resolv.conf symlink.
# Default state dir: /run/connman
RUN_STATE_DIR={{ RUN_STATE_DIR | default('/run/connman') }}

# Check if the user wants to manage the resolv.conf symlink.
# This is a legacy check; modern setups might handle this differently.
# If the variable CONNMAN_RUNSTATEDIR_RESOLVCONF is not "no", we proceed.
if [ "CONNMAN_RUNSTATEDIR_RESOLVCONF" != "no" ] ; then
    mkdir -p {{ RUN_STATE_DIR | default('/run/connman') }}
    ln -sf {{ RUN_STATE_DIR | default('/run/connman') }}/resolv.conf /etc/
fi

do_start() {
	start-stop-daemon --start --oknodo --exec $DAEMON -- $DAEMON_OPTS
}

do_stop() {
	start-stop-daemon --stop --oknodo --quiet --exec $DAEMON
}

get_pid() {
	[ -n "$1" ] || return 0
	[ -S /run/dbus/system_bus_socket ] || return 0

	dbus-send --system --dest=org.freedesktop.DBus --print-reply \
		/org/freedesktop/DBus org.freedesktop.DBus.GetConnectionUnixProcessID \
		string:$1 2>/dev/null | awk '/uint32/ {print $2}'
}

case "$1" in
  start)
	log_daemon_msg "Starting $DESC"
	do_start
	log_end_msg $?
	;;
  stop)
	log_daemon_msg "Stopping $DESC"
	do_stop
	log_end_msg $?
	;;
  restart|force-reload)
	log_daemon_msg "Restarting $DESC"
	do_stop
	sleep 1
	do_start
	log_end_msg $?
	;;
  status)
	pid=$(get_pid net.connman)
	if [ -n "$pid" ]; then
		log_success_msg "$NAME is running"
		return 0
	else
		log_failure_msg "$NAME is not running"
		return 3 # LSB exit code for "program is not running"
	fi
	;;
  *)
	log_success_msg "Usage: $0 {start|stop|status|restart|force-reload}" >&2
	exit 1
	;;
esac

exit 0