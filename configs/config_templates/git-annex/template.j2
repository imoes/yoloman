# Git Annex Assistant Desktop Entry Configuration
# Generates a standard .desktop file for autostarting the git-annex assistant.
[Desktop Entry]
# Type of entry; always 'Application' for standard desktop shortcuts.
Type=Application
# Desktop Entry Specification version.
Version=1.0

# Human-readable name of the application as it appears in the desktop environment.
# Uses 'Git Annex Assistant' by default.
Name={{ desktop_name | default('Git Annex Assistant') }}

# Short comment/description for the desktop entry.
# Uses 'Autostart' by default.
Comment={{ desktop_comment | default('Autostart') }}

# Whether the application should be run in a terminal window.
# Must be 'true' or 'false'. Uses 'false' by default.
Terminal={{ terminal | default('false') }}

# Command to execute when launching the application.
# Uses '/usr/bin/git-annex assistant --autostart' by default.
Exec={{ exec_command | default('/usr/bin/git-annex assistant --autostart') }}

# Desktop entry categories (semicolon-separated list).
# Empty string is valid per desktop-entry-spec. Uses empty string by default.
Categories={{ categories | default('') }}