{# EncFS configuration file - generated by Ansible Jinja2 template #}
{# This template produces a valid EncFS XML configuration block. #}
{# All variables are sourced from the Ansible inventory/vars with safe defaults. #}

<EncFSConfig>
  {# EncFS configuration format version. Do not change unless upgrading config schema. #}
  <Version>6</Version>

  {# Key Derivation Function: Number of PBKDF2 iterations. #}
  {# Higher values increase security but slow down mount/unmount. #}
  {# Typical: 65536 (~0.5s), 393216 (~3s). #}
  <KDFIterations>{{ kdf_iterations | default(65536) }}</KDFIterations>

  {# Key Derivation Function: Base64-encoded 160-bit salt for PBKDF2. #}
  {# Must be exactly 20 bytes raw (28 chars in base64). #}
  {# This is typically generated at volume creation and stored; do not reuse. #}
  <KDFSalt>{{ kdf_salt | default('AAAAAAAAAAAAAAAAAAAAAAAA') }}</KDFSalt>

  {# Encryption cipher algorithm. #}
  {# Supported: 'AES' (128/192/256-bit) or 'Blowfish' (up to 448-bit). #}
  {# AES is recommended for performance and hardware acceleration. #}
  <Cipher>{{ cipher | default('AES') }}</Cipher>

  {# Symmetric key size in bits. #}
  {# Standard mode usually uses 192; Paranoia mode may require 256. #}
  {# Must be compatible with the selected Cipher. #}
  <KeySize>{{ key_size | default(192) }}</KeySize>

  {# Filesystem block size in bytes. #}
  {# Affects I/O granularity. 512 is v1.0 default; 1024 is recommended. #}
  {# Larger blocks reduce overhead but increase memory/latency. #}
  <BlockSize>{{ block_size | default(1024) }}</BlockSize>

  {# Pass-through for file holes (zero-filled regions). #}
  {# Recommended: true. Required for SMB/Windows compatibility. #}
  <FileHolesPassThrough>{{ file_holes_pass_through | default(true) | string | lower }}</FileHolesPassThrough>

  {# Per-directory IV chaining for filenames. #}
  {# Enabled by default to prevent filename collision analysis attacks. #}
  <FilenameIVChaining>{{ filename_iv_chaining | default(true) | string | lower }}</FilenameIVChaining>

  {# Per-file random Initialization Vectors. #}
  {# Enabled by default to prevent file-content correlation. #}
  <PerFileIV>{{ per_file_iv | default(true) | string | lower }}</PerFileIV>

  {# Chain per-file IVs using filename IV chaining. #}
  {# Increases security but breaks hardlinks and renames. #}
  {# Default false for standard mode. #}
  <ExternalIVChaining>{{ external_iv_chaining | default(false) | string | lower }}</ExternalIVChaining>

  {# Per-block Message Authentication Code headers. #}
  {# Prevents undetected tampering. #}
  {# Default false for standard mode. #}
  <BlockMACHeaders>{{ block_mac_headers | default(false) | string | lower }}</BlockMACHeaders>

  {# Filename encoding mode. #}
  {# 'stream', 'block', or 'block32'. 'block' is recommended for standard use. #}
  {# 'stream' is better for short filenames. #}
  <FilenameEncoding>{{ filename_encoding | default('block') }}</FilenameEncoding>

</EncFSConfig>