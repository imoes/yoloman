# Nitrokey App Configuration
# Path: /etc/nitrokey-app/config.yml
#
# This configuration file controls the behavior of the Nitrokey App application.
# It is managed automatically by Ansible. Do not edit manually.
# Each setting corresponds to a command-line flag (e.g., --admin, --debug).

# Enable extra administrative functions
# Matches the --admin command-line flag.
# When enabled, administrative functions (such as firmware updates or secret management)
# may be exposed. Leave false in standard deployment scenarios.
admin_enabled: {{ admin_enabled | default(false) | lower }}

# Enable debug options
# Matches the --debug command-line flag.
# Outputs basic debugging information to the standard error stream.
# Useful for troubleshooting startup or connection issues.
debug: {{ debug | default(false) | lower }}

# Enable extensive debug options
# Matches the --debugAll command-line flag.
# Outputs verbose debugging information, including internal state changes.
# Should be used sparingly as it may impact performance and exposes sensitive data in logs.
debug_all: {{ debug_all | default(false) | lower }}

# Enable hardware lock option
# Matches the --lock-hardware command-line flag.
# When enabled, the application may enforce hardware-level locking mechanisms
# to prevent unauthorized physical access or tampering with the Nitrokey device.
lock_hardware: {{ lock_hardware | default(false) | lower }}

# Start a command line session with the specified command
# Matches the --cmd command-line flag.
# Specifies a single command to execute within the Nitrokey App environment.
# If empty, the application runs in its default interactive or daemon mode.
cmd: {{ cmd | default("") }}