---
# ==============================================================================
# Origami-PDF Policy Configuration Template
#
# This template generates the policy configuration for origami-pdf, a PDF
# processing library. It defines security policies (NONE, STANDARD, STRONG,
# PARANOID) that control which PDF features are allowed.
#
# Each section corresponds to a security level. The variables used here
# (e.g., allowParserErrors_none) map directly to the schema fields.
# Default values are provided inline for safety and self-documentation.
# ==============================================================================

# ------------------------------------------------------------------------------
# POLICY_NONE: Permissive policy. Allows almost all PDF features.
# Use this for trusted environments where security constraints are not required.
# ------------------------------------------------------------------------------
POLICY_NONE:

    #
    # General features.
    # Controls core parsing and content handling behaviors.
    #

    # Allow parser errors in NONE policy (default: true)
    allowParserErrors: {{ allowParserErrors_none | default(true) }}

    # Allow attachments in NONE policy (default: true)
    allowAttachments: {{ allowAttachments_none | default(true) }}

    # Allow encryption in NONE policy (default: true)
    allowEncryption: {{ allowEncryption_none | default(true) }}

    # Allow FormCalc in NONE policy (default: true)
    allowFormCalc: {{ allowFormCalc_none | default(true) }}

    # Allow JS at opening in NONE policy (default: true)
    allowJSAtOpening: {{ allowJSAtOpening_none | default(true) }}

    # Allow JS in NONE policy (default: true)
    allowJS: {{ allowJS_none | default(true) }}

    # Allow AcroForms in NONE policy (default: true)
    allowAcroForms: {{ allowAcroForms_none | default(true) }}

    # Allow XFA Forms in NONE policy (default: true)
    allowXFAForms: {{ allowXFAForms_none | default(true) }}

    #
    # Page annotations.
    # Controls various types of annotations allowed in the PDF.
    #

    # Allow annotations in NONE policy (default: true)
    allowAnnotations: {{ allowAnnotations_none | default('true') }}

    # Allow 3D annotations in NONE policy (default: true)
    allow3DAnnotation: {{ allow3DAnnotation_none | default(true) }}

    # Allow file attachment annotations in NONE policy (default: true)
    allowFileAttachmentAnnotation: {{ allowFileAttachmentAnnotation_none | default(true) }}

    # Allow movie annotations in NONE policy (default: true)
    allowMovieAnnotation: {{ allowMovieAnnotation_none | default(true) }}

    # Allow rich media annotations in NONE policy (default: true)
    allowRichMediaAnnotation: {{ allowRichMediaAnnotation_none | default(true) }}

    # Allow screen annotations in NONE policy (default: true)
    allowScreenAnnotation: {{ allowScreenAnnotation_none | default(true) }}

    # Allow sound annotations in NONE policy (default: true)
    allowSoundAnnotation: {{ allowSoundAnnotation_none | default(true) }}

    #
    # PDF Actions.
    # Controls action triggers such as goto, launch, submit, etc.
    #

    # Allow chained actions in NONE policy (default: true)
    allowChainedActions: {{ allowChainedActions_none | default(true) }}

    # Allow open actions in NONE policy (default: true)
    allowOpenAction: {{ allowOpenAction_none | default(true) }}

    # Allow GoTo 3D actions in NONE policy (default: true)
    allowGoTo3DAction: {{ allowGoTo3DAction_none | default(true) }}

    # Allow GoTo actions in NONE policy (default: true)
    allowGoToAction: {{ allowGoToAction_none | default('true') }}

    # Allow GoTo E actions in NONE policy (default: true)
    allowGoToEAction: {{ allowGoToEAction_none | default(true) }}

    # Allow GoTo R actions in NONE policy (default: true)
    allowGoToRAction: {{ allowGoToRAction_none | default(true) }}

    # Allow import data actions in NONE policy (default: true)
    allowImportDataAction: {{ allowImportDataAction_none | default(true) }}

    # Allow JS actions in NONE policy (default: true)
    allowJSAction: {{ allowJSAction_none | default(true) }}

    # Allow launch actions in NONE policy (default: true)
    allowLaunchAction: {{ allowLaunchAction_none | default(true) }}

    # Allow movie actions in NONE policy (default: true)
    allowMovieAction: {{ allowMovieAction_none | default(true) }}

    # Allow named actions in NONE policy (default: true)
    allowNamedAction: {{ allowNamedAction_none | default(true) }}

    # Allow rendition actions in NONE policy (default: true)
    allowRenditionAction: {{ allowRenditionAction_none | default(true) }}

    # Allow rich media actions in NONE policy (default: true)
    allowRichMediaAction: {{ allowRichMediaAction_none | default(true) }}

    # Allow sound actions in NONE policy (default: true)
    allowSoundAction: {{ allowSoundAction_none | default(true) }}

    # Allow submit form actions in NONE policy (default: true)
    allowSubmitFormAction: {{ allowSubmitFormAction_none | default(true) }}

    # Allow URI actions in NONE policy (default: true)
    allowURIAction: {{ allowURIAction_none | default(true) }}

    #
    # Stream filters.
    # Controls which compression/encoding filters are allowed in PDF streams.
    #

    # Allow ASCII85 filter in NONE policy (default: true)
    allowASCII85Filter: {{ allowASCII85Filter_none | default(true) }}

    # Allow ASCII Hex filter in NONE policy (default: true)
    allowASCIIHexFilter: {{ allowASCIIHexFilter_none | default(true) }}

    # Allow CCITT Fax filter in NONE policy (default: true)
    allowCCITTFaxFilter: {{ allowCCITTFaxFilter_none | default(true) }}

    # Allow Crypt filter in NONE policy (default: true)
    allowCryptFilter: {{ allowCryptFilter_none | default(true) }}

    # Allow DCT filter in NONE policy (default: true)
    allowDCTFilter: {{ allowDCTFilter_none | default('true') }}

    # Allow Flate filter in NONE policy (default: true)
    allowFlateFilter: {{ allowFlateFilter_none | default('true') }}

    # Allow JBIG2 filter in NONE policy (default: true)
    allowJBIG2Filter: {{ allowJBIG2Filter_none | default(true) }}

    # Allow JPX filter in NONE policy (default: true)
    allowJPXFilter: {{ allowJPXFilter_none | default(true) }}

    # Allow LZW filter in NONE policy (default: true)
    allowLZWFilter: {{ allowLZWFilter_none | default(true) }}

    # Allow Run Length filter in NONE policy (default: true)
    allowRunLengthFilter: {{ allowRunLengthFilter_none | default(true) }}

# ------------------------------------------------------------------------------
# POLICY_STANDARD: Standard security policy.
# Blocks potentially dangerous features like JS, external links, and specific
# annotation types while allowing standard form interactions.
# ------------------------------------------------------------------------------
POLICY_STANDARD:

    #
    # General features.
    #

    # Allow parser errors in STANDARD policy (default: false)
    allowParserErrors: {{ allowParserErrors_standard | default(false) }}

    # Allow attachments in STANDARD policy (default: false)
    allowAttachments: {{ allowAttachments_standard | default(false) }}

    # Allow AcroForms in STANDARD policy (default: true)
    allowAcroForms: {{ allowAcroForms_standard | default(true) }}

    # Allow encryption in STANDARD policy (default: true)
    allowEncryption: {{ allowEncryption_standard | default(true) }}

    # Allow FormCalc in STANDARD policy (default: true)
    allowFormCalc: {{ allowFormCalc_standard | default(true) }}

    # Allow JS in STANDARD policy (default: true)
    allowJS: {{ allowJS_standard | default(true) }}

    # Allow JS at opening in STANDARD policy (default: false)
    allowJSAtOpening: {{ allowJSAtOpening_standard | default(false) }}

    # Allow XFA Forms in STANDARD policy (default: true)
    allowXFAForms: {{ allowXFAForms_standard | default(true) }}

    #
    # Page annotations.
    #

    # Allow annotations in STANDARD policy (default: true)
    allowAnnotations: {{ allowAnnotations_standard | default('true') }}

    # Allow 3D annotations in STANDARD policy (default: false)
    allow3DAnnotation: {{ allow3DAnnotation_standard | default(false) }}

    # Allow file attachment annotations in STANDARD policy (default: false)
    allowFileAttachmentAnnotation: {{ allowFileAttachmentAnnotation_standard | default(false) }}

    # Allow movie annotations in STANDARD policy (default: false)
    allowMovieAnnotation: {{ allowMovieAnnotation_standard | default(false) }}

    # Allow rich media annotations in STANDARD policy (default: false)
    allowRichMediaAnnotation: {{ allowRichMediaAnnotation_standard | default(false) }}

    # Allow screen annotations in STANDARD policy (default: false)
    allowScreenAnnotation: {{ allowScreenAnnotation_standard | default(false) }}

    # Allow sound annotations in STANDARD policy (default: false)
    allowSoundAnnotation: {{ allowSoundAnnotation_standard | default(false) }}

    #
    # PDF Actions.
    #

    # Allow chained actions in STANDARD policy (default: true)
    allowChainedActions: {{ allowChainedActions_standard | default(true) }}

    # Allow open actions in STANDARD policy (default: true)
    allowOpenAction: {{ allowOpenAction_standard | default(true) }}

    # Allow GoTo 3D actions in STANDARD policy (default: false)
    allowGoTo3DAction: {{ allowGoTo3DAction_standard | default(false) }}

    # Allow GoTo actions in STANDARD policy (default: true)
    allowGoToAction: {{ allowGoToAction_standard | default('true') }}

    # Allow GoTo E actions in STANDARD policy (default: false)
    allowGoToEAction: {{ allowGoToEAction_standard | default(false) }}

    # Allow GoTo R actions in STANDARD policy (default: false)
    allowGoToRAction: {{ allowGoToRAction_standard | default(false) }}

    # Allow import data actions in STANDARD policy (default: false)
    allowImportDataAction: {{ allowImportDataAction_standard | default(false) }}

    # Allow JS actions in STANDARD policy (default: true)
    allowJSAction: {{ allowJSAction_standard | default(true) }}

    # Allow launch actions in STANDARD policy (default: false)
    allowLaunchAction: {{ allowLaunchAction_standard | default(false) }}

    # Allow movie actions in STANDARD policy (default: false)
    allowMovieAction: {{ allowMovieAction_standard | default(false) }}

    # Allow named actions in STANDARD policy (default: false)
    allowNamedAction: {{ allowNamedAction_standard | default(false) }}

    # Allow rendition actions in STANDARD policy (default: false)
    allowRenditionAction: {{ allowRenditionAction_standard | default(false) }}

    # Allow rich media actions in STANDARD policy (default: false)
    allowRichMediaAction: {{ allowRichMediaAction_standard | default(false) }}

    # Allow sound actions in STANDARD policy (default: false)
    allowSoundAction: {{ allowSoundAction_standard | default(false) }}

    # Allow submit form actions in STANDARD policy (default: true)
    allowSubmitFormAction: {{ allowSubmitFormAction_standard | default(true) }}

    # Allow URI actions in STANDARD policy (default: true)
    allowURIAction: {{ allowURIAction_standard | default(true) }}

    #
    # Stream filters.
    #

    # Allow ASCII85 filter in STANDARD policy (default: false)
    allowASCII85Filter: {{ allowASCII85Filter_standard | default(false) }}

    # Allow ASCII Hex filter in STANDARD policy (default: false)
    allowASCIIHexFilter: {{ allowASCIIHexFilter_standard | default(false) }}

    # Allow CCITT Fax filter in STANDARD policy (default: true)
    allowCCITTFaxFilter: {{ allowCCITTFaxFilter_standard | default(true) }}

    # Allow Crypt filter in STANDARD policy (default: true)
    allowCryptFilter: {{ allowCryptFilter_standard | default(true) }}

    # Allow DCT filter in STANDARD policy (default: true)
    allowDCTFilter: {{ allowDCTFilter_standard | default('true') }}

    # Allow Flate filter in STANDARD policy (default: true)
    allowFlateFilter: {{ allowFlateFilter_standard | default('true') }}

    # Allow JBIG2 filter in STANDARD policy (default: false)
    allowJBIG2Filter: {{ allowJBIG2Filter_standard | default(false) }}

    # Allow JPX filter in STANDARD policy (default: false)
    allowJPXFilter: {{ allowJPXFilter_standard | default(false) }}

    # Allow LZW filter in STANDARD policy (default: false)
    allowLZWFilter: {{ allowLZWFilter_standard | default(false) }}

    # Allow Run Length filter in STANDARD policy (default: false)
    allowRunLengthFilter: {{ allowRunLengthFilter_standard | default(false) }}

