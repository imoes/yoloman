---
# origami-pdf security policy configuration
# This template generates the origami-pdf allow-list policy file.
# Each policy level (NONE, STANDARD, STRONG, PARANOID) corresponds to a
# different strictness level for handling potentially unsafe PDF features.
# All boolean values default to True unless the schema specifies otherwise.

#
# POLICY_NONE: Least restrictive. Allows almost all PDF features.
#
POLICY_NONE:

    #
    # General features.
    #

    # Allow parser errors in NONE policy
    allowParserErrors: {{ allowParserErrors_none | default(true) | lower }}

    # Allow attachments in NONE policy
    allowAttachments: {{ allowAttachments_none | default(true) | lower }}

    # Allow encryption in NONE policy
    allowEncryption: {{ allowEncryption_none | default(true) | lower }}

    # Allow FormCalc in NONE policy
    allowFormCalc: {{ allowFormCalc_none | default(true) | lower }}

    # Allow JS at opening in NONE policy
    allowJSAtOpening: {{ allowJSAtOpening_none | default(true) | lower }}

    # Allow JS in NONE policy
    allowJS: {{ allowJS_none | default(true) | lower }}

    # Allow AcroForms in NONE policy
    allowAcroForms: {{ allowAcroForms_none | default(true) | lower }}

    # Allow XFA Forms in NONE policy
    allowXFAForms: {{ allowXFAForms_none | default(true) | lower }}

    #
    # Page annotations.
    #

    # Allow annotations in NONE policy
    allowAnnotations: {{ allowAnnotations_none | default(true) | lower }}

    # Allow 3D annotations in NONE policy
    allow3DAnnotation: {{ allow3DAnnotation_none | default(true) | lower }}

    # Allow file attachment annotations in NONE policy
    allowFileAttachmentAnnotation: {{ allowFileAttachmentAnnotation_none | default(true) | lower }}

    # Allow movie annotations in NONE policy
    allowMovieAnnotation: {{ allowMovieAnnotation_none | default(true) | lower }}

    # Allow rich media annotations in NONE policy
    allowRichMediaAnnotation: {{ allowRichMediaAnnotation_none | default(true) | lower }}

    # Allow screen annotations in NONE policy
    allowScreenAnnotation: {{ allowScreenAnnotation_none | default(true) | lower }}

    # Allow sound annotations in NONE policy
    allowSoundAnnotation: {{ allowSoundAnnotation_none | default(true) | lower }}

    #
    # PDF Actions.
    #

    # Allow chained actions in NONE policy
    allowChainedActions: {{ allowChainedActions_none | default(true) | lower }}

    # Allow open actions in NONE policy
    allowOpenAction: {{ allowOpenAction_none | default(true) | lower }}

    # Allow GoTo 3D actions in NONE policy
    allowGoTo3DAction: {{ allowGoTo3DAction_none | default(true) | lower }}

    # Allow GoTo actions in NONE policy
    allowGoToAction: {{ allowGoToAction_none | default(true) | lower }}

    # Allow GoTo E actions in NONE policy
    allowGoToEAction: {{ allowGoToEAction_none | default(true) | lower }}

    # Allow GoTo R actions in NONE policy
    allowGoToRAction: {{ allowGoToRAction_none | default(true) | lower }}

    # Allow import data actions in NONE policy
    allowImportDataAction: {{ allowImportDataAction_none | default(true) | lower }}

    # Allow JS actions in NONE policy
    allowJSAction: {{ allowJSAction_none | default(true) | lower }}

    # Allow launch actions in NONE policy
    allowLaunchAction: {{ allowLaunchAction_none | default(true) | lower }}

    # Allow movie actions in NONE policy
    allowMovieAction: {{ allowMovieAction_none | default(true) | lower }}

    # Allow named actions in NONE policy
    allowNamedAction: {{ allowNamedAction_none | default(true) | lower }}

    # Allow rendition actions in NONE policy
    allowRenditionAction: {{ allowRenditionAction_none | default(true) | lower }}

    # Allow rich media actions in NONE policy
    allowRichMediaAction: {{ allowRichMediaAction_none | default(true) | lower }}

    # Allow sound actions in NONE policy
    allowSoundAction: {{ allowSoundAction_none | default(true) | lower }}

    # Allow submit form actions in NONE policy
    allowSubmitFormAction: {{ allowSubmitFormAction_none | default(true) | lower }}

    # Allow URI actions in NONE policy
    allowURIAction: {{ allowURIAction_none | default(true) | lower }}

    #
    # Stream filters.
    #

    # Allow ASCII85 filter in NONE policy
    allowASCII85Filter: {{ allowASCII85Filter_none | default(true) | lower }}

    # Allow ASCIIHex filter in NONE policy
    allowASCIIHexFilter: {{ allowASCIIHexFilter_none | default(true) | lower }}

    # Allow CCITT Fax filter in NONE policy
    allowCCITTFaxFilter: {{ allowCCITTFaxFilter_none | default(true) | lower }}

    # Allow crypt filter in NONE policy
    allowCryptFilter: {{ allowCryptFilter_none | default(true) | lower }}

    # Allow DCT filter in NONE policy
    allowDCTFilter: {{ allowDCTFilter_none | default(true) | lower }}

    # Allow Flate filter in NONE policy
    allowFlateFilter: {{ allowFlateFilter_none | default(true) | lower }}

    # Allow JBIG2 filter in NONE policy
    allowJBIG2Filter: {{ allowJBIG2Filter_none | default(true) | lower }}

    # Allow JPX filter in NONE policy
    allowJPXFilter: {{ allowJPXFilter_none | default(true) | lower }}

    # Allow LZW filter in NONE policy
    allowLZWFilter: {{ allowLZWFilter_none | default(true) | lower }}

    # Allow RunLength filter in NONE policy
    allowRunLengthFilter: {{ allowRunLengthFilter_none | default(true) | lower }}

#
# POLICY_STANDARD: Default security level. Blocks dangerous features like
# attachments, 3D annotations, and JS at opening, while allowing standard
# forms and encryption.
#
POLICY_STANDARD:

    #
    # General features.
    #

    # Allow parser errors in STANDARD policy
    allowParserErrors: {{ allowParserErrors_standard | default(false) | lower }}

    # Allow attachments in STANDARD policy
    allowAttachments: {{ allowAttachments_standard | default(false) | lower }}

    # Allow AcroForms in STANDARD policy
    allowAcroForms: {{ allowAcroForms_standard | default(true) | lower }}

    # Allow encryption in STANDARD policy
    allowEncryption: {{ allowEncryption_standard | default(true) | lower }}

    # Allow FormCalc in STANDARD policy
    allowFormCalc: {{ allowFormCalc_standard | default(true) | lower }}

    # Allow JS in STANDARD policy
    allowJS: {{ allowJS_standard | default(true) | lower }}

    # Allow JS at opening in STANDARD policy
    allowJSAtOpening: {{ allowJSAtOpening_standard | default(false) | lower }}

    # Allow XFA Forms in STANDARD policy
    allowXFAForms: {{ allowXFAForms_standard | default(true) | lower }}

    #
    # Page annotations.
    #

    # Allow annotations in STANDARD policy
    allowAnnotations: {{ allowAnnotations_standard | default(true) | lower }}

    # Allow 3D annotations in STANDARD policy
    allow3DAnnotation: {{ allow3DAnnotation_standard | default(false) | lower }}

    # Allow file attachment annotations in STANDARD policy
    allowFileAttachmentAnnotation: {{ allowFileAttachmentAnnotation_standard | default(false) | lower }}

    # Allow movie annotations in STANDARD policy
    allowMovieAnnotation: {{ allowMovieAnnotation_standard | default(false) | lower }}

    # Allow rich media annotations in STANDARD policy
    allowRichMediaAnnotation: {{ allowRichMediaAnnotation_standard | default(false) | lower }}

    # Allow screen annotations in STANDARD policy
    allowScreenAnnotation: {{ allowScreenAnnotation_standard | default(false) | lower }}

    # Allow sound annotations in STANDARD policy
    allowSoundAnnotation: {{ allowSoundAnnotation_standard | default(false) | lower }}

    #
    # PDF Actions.
    #

    # Allow chained actions in STANDARD policy
    allowChainedActions: {{ allowChainedActions_standard | default(true) | lower }}

    # Allow open actions in STANDARD policy
    allowOpenAction: {{ allowOpenAction_standard | default(true) | lower }}

    # Allow GoTo 3D actions in STANDARD policy
    allowGoTo3DAction: {{ allowGoTo3DAction_standard | default(false) | lower }}

    # Allow GoTo actions in STANDARD policy
    allowGoToAction: {{ allowGoToAction_standard | default(true) | lower }}

    # Allow GoTo E actions in STANDARD policy
    allowGoToEAction: {{ allowGoToEAction_standard | default(false) | lower }}

    # Allow GoTo R actions in STANDARD policy
    allowGoToRAction: {{ allowGoToRAction_standard | default(false) | lower }}

    # Allow import data actions in STANDARD policy
    allowImportDataAction: {{ allowImportDataAction_standard | default(false) | lower }}

    # Allow JS actions in STANDARD policy
    allowJSAction: {{ allowJSAction_standard | default(true) | lower }}

    # Allow launch actions in STANDARD policy
    allowLaunchAction: {{ allowLaunchAction_standard | default(false) | lower }}

    # Allow movie actions in STANDARD policy
    allowMovieAction: {{ allowMovieAction_standard | default(false) | lower }}

    # Allow named actions in STANDARD policy
    allowNamedAction: {{ allowNamedAction_standard | default(false) | lower }}

    # Allow rendition actions in STANDARD policy
    allowRenditionAction: {{ allowRenditionAction_standard | default(false) | lower }}

    # Allow rich media actions in STANDARD policy
    allowRichMediaAction: {{ allowRichMediaAction_standard | default(false) | lower }}

    # Allow sound actions in STANDARD policy
    allowSoundAction: {{ allowSoundAction_standard | default(false) | lower }}

    # Allow submit form actions in STANDARD policy
    allowSubmitFormAction: {{ allowSubmitFormAction_standard | default(true) | lower }}

    # Allow URI actions in STANDARD policy
    allowURIAction: {{ allowURIAction_standard | default(true) | lower }}

    #
    # Stream filters.
    #

    # Allow ASCII85 filter in STANDARD policy
    allowASCII85Filter: {{ allowASCII85Filter_standard | default(false) | lower }}

    # Allow ASCIIHex filter in STANDARD policy
    allowASCIIHexFilter: {{ allowASCIIHexFilter_standard | default(false) | lower }}

    # Allow CCITT Fax filter in STANDARD policy
    allowCCITTFaxFilter: {{ allowCCITTFaxFilter_standard | default(true) | lower }}

    # Allow crypt filter in STANDARD policy
    allowCryptFilter: {{ allowCryptFilter_standard | default(true) | lower }}

    # Allow DCT filter in STANDARD policy
    allowDCTFilter: {{ allowDCTFilter_standard | default(true) | lower }}

    # Allow Flate filter in STANDARD policy
    allowFlateFilter: {{ allowFlateFilter_standard | default(true) | lower }}

    # Allow JBIG2 filter in STANDARD policy
    allowJBIG2Filter: {{ allowJBIG2Filter_standard | default(false) | lower }}

    # Allow JPX filter in STANDARD policy
    allowJPXFilter: {{ allowJPXFilter_standard | default(false) | lower }}

    # Allow LZW filter in STANDARD policy
    allowLZWFilter: {{ allowLZWFilter_standard | default(false) | lower }}

    # Allow RunLength filter in STANDARD policy
    allowRunLengthFilter: {{ allowRunLengthFilter_standard | default(false) | lower }}

