    # Allow FormCalc in STRONG policy (default: true)
    allowFormCalc: {{ allowFormCalc_strong | default(true) }}

    # Allow JS in STRONG policy (default: false)
    allowJS: {{ allowJS_strong | default(false) }}

    # Allow JS at opening in STRONG policy (default: false)
    allowJSAtOpening: {{ allowJSAtOpening_strong | default(false) }}

    # Allow XFA Forms in STRONG policy (default: false)
    allowXFAForms: {{ allowXFAForms_strong | default(false) }}

    #
