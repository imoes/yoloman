    # Allow JS actions in STRONG policy (default: false)
    allowJSAction: {{ allowJSAction_strong | default(false) }}

    # Allow launch actions in STRONG policy (default: false)
    allowLaunchAction: {{ allowLaunchAction_strong | default(false) }}

    # Allow movie actions in STRONG policy (default: false)
    allowMovieAction: {{ allowMovieAction_strong | default(false) }}

    # Allow named actions in STRONG policy (default: false)
    allowNamedAction: {{ allowNamedAction_strong | default(false) }}

    # Allow rendition actions in STRONG policy (default: false)
    allowRenditionAction: {{ allowRenditionAction_strong | default(false) }}

    # Allow rich media actions in STRONG policy (default: false)
    allowRichMediaAction: {{ allowRichMediaAction_strong | default(false) }}

    # Allow sound actions in STRONG policy (default: false)
