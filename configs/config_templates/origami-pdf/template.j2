    # Allow CCITT Fax filter in STRONG policy (default: false)
    allowCCITTFaxFilter: {{ allowCCITTFaxFilter_strong | default(false) }}

    # Allow Crypt filter in STRONG policy (default: true)
    allowCryptFilter: {{ allowCryptFilter_strong | default(true) }}

    # Allow DCT filter in STRONG policy (default: true)
