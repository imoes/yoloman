    # Allow launch actions in STRONG policy
    allowLaunchAction: {{ allowLaunchAction_strong | default(false) | lower }}

    # Allow movie actions in STRONG policy
    allowMovieAction: {{ allowMovieAction_strong | default(false) | lower }}

    # Allow named actions in STRONG policy
    allowNamedAction: {{ allowNamedAction_strong | default(false) | lower }}

    # Allow rendition actions in STRONG policy
    allowRenditionAction: {{ allowRenditionAction_strong | default(false) | lower }}

    # Allow rich media actions in STRONG policy
    allowRichMediaAction: {{ allowRichMediaAction_strong | default(false) | lower }}

    # Allow sound actions in STRONG policy
    allowSoundAction: {{ allowSoundAction_strong | default(false) | lower }}

    # Allow submit form actions in STRONG policy
    allowSubmitFormAction: {{ allowSubmitFormAction_strong | default(false) | lower }}

