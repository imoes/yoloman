#
# POLICY_PARANOID: Maximum security. Disables almost everything except
# basic viewing and some annotations. No JS, no forms, no external actions.
#
POLICY_PARANOID:

    #
    # General features.
    #

    # Allow parser errors in PARANOID policy
    allowParserErrors: {{ allowParserErrors_paranoid | default(false) | lower }}

    # Allow attachments in PARANOID policy
    allowAttachments: {{ allowAttachments_paranoid | default(false) | lower }}

    # Allow AcroForms in PARANOID policy
