    # Allow open actions in STRONG policy (default: true)
    allowOpenAction: {{ allowOpenAction_strong | default(true) }}

    # Allow GoTo 3D actions in STRONG policy (default: false)
    allowGoTo3DAction: {{ allowGoTo3DAction_strong | default(false) }}

    # Allow GoTo actions in STRONG policy (default: true)
    allowGoToAction: {{ allowGoToAction_strong | default('true') }}

    # Allow GoTo E actions in STRONG policy (default: false)
