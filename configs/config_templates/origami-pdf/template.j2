# ------------------------------------------------------------------------------
# POLICY_PARANOID: Paranoid security policy.
# Maximally restrictive. Disables encryption, most actions, and dynamic content.
# Use only when processing untrusted PDFs in highly sensitive contexts.
# ------------------------------------------------------------------------------
POLICY_PARANOID:

    #
    # General features.
    #

    # Allow parser errors in PARANOID policy (default: false)
    allowParserErrors: {{ allowParserErrors_paranoid | default(false) }}

    # Allow attachments in PARANOID policy (default: false)
    allowAttachments: {{ allowAttachments_paranoid | default(false) }}

    # Allow AcroForms in PARANOID policy (default: false)
    allowAcroForms: {{ allowAcroForms_paranoid | default(false) }}

    # Allow encryption in PARANOID policy (default: false)
    allowEncryption: {{ allowEncryption_paranoid | default(false) }}

    # Allow FormCalc in PARANOID policy (default: false)
    allowFormCalc: {{ allowFormCalc_paranoid | default(false) }}

    # Allow JS in PARANOID policy (default: false)
    allowJS: {{ allowJS_paranoid | default(false) }}

    # Allow JS at opening in PARANOID policy (default: false)
    allowJSAtOpening: {{ allowJSAtOpening_paranoid | default(false) }}

    # Allow XFA Forms in PARANOID policy (default: false)
    allowXFAForms: {{ allowXFAForms_paranoid | default(false) }}

    #
    # Page annotations.
    #

    # Allow annotations in PARANOID policy (default: true)
    allowAnnotations: {{ allowAnnotations_paranoid | default('true') }}

    # Allow 3D annotations in PARANOID policy (default: false)
    allow3DAnnotation: {{ allow3DAnnotation_paranoid | default(false) }}

    # Allow file attachment annotations in PARANOID policy (default: false)
    allowFileAttachmentAnnotation: {{ allowFileAttachmentAnnotation_paranoid | default(false) }}

    # Allow movie annotations in PARANOID policy (default: false)
    allowMovieAnnotation: {{ allowMovieAnnotation_paranoid | default(false) }}

    # Allow rich media annotations in PARANOID policy (default: false)
    allowRichMediaAnnotation: {{ allowRichMediaAnnotation_paranoid | default(false) }}

    # Allow screen annotations in PARANOID policy (default: false)
    allowScreenAnnotation: {{ allowScreenAnnotation_paranoid | default(false) }}

    # Allow sound annotations in PARANOID policy (default: false)
    allowSoundAnnotation: {{ allowSoundAnnotation_paranoid | default(false) }}

    #
    # PDF Actions.
    #

    # Allow chained actions in PARANOID policy (default: false)
    allowChainedActions: {{ allowChainedActions_paranoid | default(false) }}

    # Allow open actions in PARANOID policy (default: false)
    allowOpenAction: {{ allowOpenAction_paranoid | default(false) }}

    # Allow GoTo 3D actions in PARANOID policy (default: false)
    allowGoTo3DAction: {{ allowGoTo3DAction_paranoid | default(false) }}

    # Allow GoTo actions in PARANOID policy (default: true)
    allowGoToAction: {{ allowGoToAction_paranoid | default('true') }}

    # Allow GoTo E actions in PARANOID policy (default: false)
    allowGoToEAction: {{ allowGoToEAction_paranoid | default(false) }}

    # Allow GoTo R actions in PARANOID policy (default: false)
    allowGoToRAction: {{ allowGoToRAction_paranoid | default(false) }}

    # Allow import data actions in PARANOID policy (default: false)
    allowImportDataAction: {{ allowImportDataAction_paranoid | default(false) }}

    # Allow JS actions in PARANOID policy (default: false)
    allowJSAction: {{ allowJSAction_paranoid | default(false) }}

    # Allow launch actions in PARANOID policy (default: false)
    allowLaunchAction: {{ allowLaunchAction_paranoid | default(false) }}

    # Allow movie actions in PARANOID policy (default: false)
    allowMovieAction: {{ allowMovieAction_paranoid | default(false) }}

    # Allow named actions in PARANOID policy (default: false)
    allowNamedAction: {{ allowNamedAction_paranoid | default(false) }}

    # Allow rendition actions in PARANOID policy (default: false)
    allowRenditionAction: {{ allowRenditionAction_paranoid | default(false) }}

    # Allow rich media actions in PARANOID policy (default: false)
    allowRichMediaAction: {{ allowRichMediaAction_paranoid | default(false) }}

    # Allow sound actions in PARANOID policy (default: false)
    allowSoundAction: {{ allowSoundAction_paranoid | default(false) }}

    # Allow submit form actions in PARANOID policy (default: false)
    allowSubmitFormAction: {{ allowSubmitFormAction_paranoid | default(false) }}

    # Allow URI actions in PARANOID policy (default: false)
    allowURIAction: {{ allowURIAction_paranoid | default(false) }}

    #
    # Stream filters.
    #

    # Allow ASCII85 filter in PARANOID policy (default: false)
    allowASCII85Filter: {{ allowASCII85Filter_paranoid | default(false) }}

    # Allow ASCII Hex filter in PARANOID policy (default: false)
    allowASCIIHexFilter: {{ allowASCIIHexFilter_paranoid | default(false) }}

    # Allow CCITT Fax filter in PARANOID policy (default: false)
    allowCCITTFaxFilter: {{ allowCCITTFaxFilter_paranoid | default(false) }}

    # Allow Crypt filter in PARANOID policy (default: false)
    allowCryptFilter: {{ allowCryptFilter_paranoid | default(false) }}

    # Allow DCT filter in PARANOID policy (default: true)
