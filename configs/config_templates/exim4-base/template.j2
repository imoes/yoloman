# Configuration for Exim4 log rotation (logrotate).
# This block configures how Exim's main log and reject log are rotated.

/var/log/exim4/mainlog /var/log/exim4/rejectlog {
    # Rotate logs daily.
    daily

    # Do not error if the log file is missing.
    missingok

    # Keep this many rotated log files.
    # Number of rotated logs to keep.
    rotate {{ exim4_paniclog_lines | default('10') }}

    # Compress rotated logs using gzip.
    compress

    # Delay compression of the most recent rotated log file.
    # This allows programs to finish writing to the old log file before it is compressed.
    delaycompress

    # Do not rotate an empty log file.
    # Rotating an empty file results in useless zero-length files.
    notifempty

    # Do not create new log files with default permissions.
    # The existing log file's permissions are retained.
    nocreate
}
