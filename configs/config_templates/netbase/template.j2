# /etc/ethertypes
#
# This file defines EtherType identifiers for Ethernet frames.
# The EtherType is a two-octet field in Ethernet frames that indicates
# which protocol is contained in the frame's payload.
#
# Format: <name> <hex_number> [alias...] # Comment
#
# This template provides a static, comprehensive list of standard EtherTypes.
# It is generally NOT configurable by role variables as these are IANA standards.
# Any modification should be carefully considered and verified against IANA assignments.
#
# Source references:
#   - https://www.iana.org/assignments/ieee-802-numbers/
#   - http://standards-oui.ieee.org/ethertype/eth.txt

# IP (IPv4)
IPv4		0800	ip ip4	# IP (IPv4)

# X25
X25		0805

# Address Resolution Protocol
ARP		0806	ether-arp # Address Resolution Protocol

# Frame Relay ARP [RFC1701]
FR_ARP		0808		# Frame Relay ARP [RFC1701]

# G8BPQ AX.25 over Ethernet
BPQ		08FF		# G8BPQ AX.25 over Ethernet

# TRILL [RFC6325]
TRILL		22F3		# TRILL [RFC6325]

# TRILL IS-IS [RFC6325]
L2-IS-IS	22F4		# TRILL IS-IS [RFC6325]

# Transparent Ethernet Bridging [RFC1701]
TEB		6558		# Transparent Ethernet Bridging [RFC1701]

# Raw Frame Relay [RFC1701]
RAW_FR		6559		# Raw Frame Relay [RFC1701]

# Reverse ARP [RFC903]
RARP		8035		# Reverse ARP [RFC903]

# Appletalk
ATALK		809B		# Appletalk

# Appletalk Address Resolution Protocol
AARP		80F3		# Appletalk Address Resolution Protocol

# VLAN tagged frame [802.1q]
802_1Q		8100	8021q 1q 802.1q	dot1q # VLAN tagged frame [802.1q]

# Novell IPX
IPX		8137		# Novell IPX

# NetBEUI
NetBEUI		8191		# NetBEUI

# IP version 6
IPv6		86DD	ip6	# IP version 6

# Slow Protocols (LACP, OAM...) [802.3ad]
SLOW		8809		# Slow Protocols (LACP, OAM...) [802.3ad]

# Point-to-Point Protocol
PPP		880B		# Point-to-Point Protocol

# MPLS [RFC5332]
MPLS		8847		# MPLS [RFC5332]

# MPLS with upstream-assigned label [RFC5332]
MPLS_MULTI	8848		# MPLS with upstream-assigned label [RFC5332]

# MultiProtocol over ATM
ATMMPOA		884C		# MultiProtocol over ATM

# PPP over Ethernet discovery stage
PPP_DISC	8863		# PPP over Ethernet discovery stage

# PPP over Ethernet session stage
PPP_SES		8864		# PPP over Ethernet session stage

# Frame-based ATM Transport over Ethernet
ATMFATE		8884		# Frame-based ATM Transport over Ethernet

# EAP over LAN [802.1x]
EAPOL		888E		# EAP over LAN [802.1x]

# [IEC 61158]
EtherCAT	88A4		# [IEC 61158]

# QinQ Service VLAN tag identifier [802.1q]
S-TAG		88A8		# QinQ Service VLAN tag identifier [802.1q]

# EAPOL Pre-Authentication [802.11i]
EAP_PREAUTH	88C7		# EAPOL Pre-Authentication [802.11i]

# Link Layer Discovery Protocol [802.1ab]
LLDP		88CC		# Link Layer Discovery Protocol [802.1ab]

# Media Access Control Security [802.1ae]
MACSEC		88E5		# Media Access Control Security [802.1ae]

# Provider Backbone Bridging [802.1ah]
PBB		88E7	macinmac # Provider Backbone Bridging [802.1ah]

# Multiple VLAN Registration Protocol
MVRP		88F5		# Multiple VLAN Registration Protocol

# Precision Time Protocol
PTP		88F7		# Precision Time Protocol

# Fibre Channel over Ethernet
FCOE		8906		# Fibre Channel over Ethernet

# FCoE Initialization Protocol
FIP		8914		# FCoE Initialization Protocol

# RDMA over Convergent Ethernet
ROCE		8915		# RDMA over Convergent Ethernet

# LoWPAN encapsulation
LoWPAN		A0ED		# LoWPAN encapsulation