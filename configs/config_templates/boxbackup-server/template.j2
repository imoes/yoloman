# BoxBackup Server (bbstored) Configuration Template
# This template generates the configuration/log-format for the BoxBackup storage daemon.
# It defines process IDs for various daemon components and network settings for incoming client connections.

# ==============================================================================
# Housekeeping Process Configuration
# ==============================================================================

# Housekeeping: Starting message
# Uses the housekeeping process ID to identify the specific daemon instance.
bbstored/hk{{ hk_process_id | default('\\[.*\\]') }}: Starting housekeeping

# Housekeeping: Finished message
# Uses the housekeeping process ID to identify the specific daemon instance.
bbstored/hk{{ hk_process_id | default('\\[.*\\]') }}: Finished housekeeping

# Housekeeping: Started message
# Uses the housekeeping process ID to identify the specific daemon instance.
bbstored/hk{{ hk_process_id | default('\\[.*\\]') }}: Housekeeping process started

# ==============================================================================
# Main Daemon Configuration
# ==============================================================================

# Daemon: Starting message
# Uses the main daemon process ID to identify the primary service instance.
bbstored{{ daemon_process_id | default('\\[.*\\]') }}: Starting daemon

# Daemon: Terminating message
# Uses the main daemon process ID to identify the primary service instance.
bbstored{{ daemon_process_id | default('\\[.*\\]') }}: Terminating daemon

# ==============================================================================
# Connection and Network Configuration
# ==============================================================================

# Connection: Incoming connection log
# Logs the remote client address, port, and the child PID handling the connection.
# remote_addr: The IP address of the connecting client.
# remote_port: The source port of the connecting client.
# child_pid: The ID of the child process created to handle this specific connection.
bbstored{{ connection_process_id | default('9012') }}: Incoming connection from{{ remote_addr | default('192.168.1.100') }}:{{ remote_port | default('49152') }} (handling in child {{ child_pid | default('1111') }})

# ==============================================================================
# SSL/TLS and Authentication Configuration
# ==============================================================================

# Daemon: Certificate Common Name verification
# Displays the Common Name (CN) from the SSL certificate presented during connection.
# cert_cn: The CN field of the server's certificate.
bbstored{{ daemon_process_id | default('\\[.*\\]') }}: Certificate CN: {{ cert_cn | default('bbstored.example.com') }}

# Authentication: Login event
# Records the client ID associated with an authentication event.
# auth_process_id: The process ID responsible for handling authentication logic.
# client_id: The unique identifier of the client attempting to log in.
bbstored{{ auth_process_id | default('3333') }}: Login: {{ client_id | default('client1') }}

# ==============================================================================
# Session Management
# ==============================================================================

# Session: Finished message
# Logs the completion of a client session using the session-specific process ID.
# session_process_id: The process ID handling session events.
bbstored{{ session_process_id | default('\\[.*\\]') }}: Session finished
