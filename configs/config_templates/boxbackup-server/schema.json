{
  "hk_process_id": {
    "type": "string",
    "default": "\\[.*\\]",
    "description": "Housekeeping process ID"
  },
  "daemon_process_id": {
    "type": "string",
    "default": "\\[.*\\]",
    "description": "Main daemon process ID"
  },
  "connection_process_id": {
    "type": "string",
    "default": "9012",
    "description": "Process ID handling incoming connections"
  },
  "remote_addr": {
    "type": "string",
    "default": "192.168.1.100",
    "description": "Remote client address"
  },
  "remote_port": {
    "type": "number",
    "default": 49152,
    "description": "Remote client port"
  },
  "child_pid": {
    "type": "string",
    "default": "1111",
    "description": "Child process ID for handling connection"
  },
  "cert_cn": {
    "type": "string",
    "default": "bbstored.example.com",
    "description": "Certificate Common Name"
  },
  "auth_process_id": {
    "type": "string",
    "default": "3333",
    "description": "Process ID for authentication events"
  },
  "client_id": {
    "type": "string",
    "default": "client1",
    "description": "Client ID for authentication"
  },
  "session_process_id": {
    "type": "string",
    "default": "\\[.*\\]",
    "description": "Process ID for session events"
  }
}
