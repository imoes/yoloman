# ============================================================================
# PCP PMDA Perfevent Configuration Template
# ============================================================================
# This file configures the Performance Co-Pilot (PCP) PMDA for hardware
# performance events (perf_event). It defines event sets for various CPU
# microarchitectures and dynamic kernel-exported PMUs.
#
# Format:
#   [PMU_SECTION]
#     EVENT_NAME [CPU_OPTION]
#
# CPU Options:
#   cpu        - Add counter to all CPUs
#   cpu_rr     - Round-robin allocation across CPUs
#   node       - Add counter to the first CPU in each NUMA node
#   node_rr    - Round-robin allocation across NUMA nodes
#   [N]        - Specific CPU index N
#
# If no CPU option is specified, it defaults to all CPUs.
# ============================================================================

# -------------------------------------------------------------------------
# Section: AMD64 Family 10h (Barcelona, Shanghai, Istanbul)
# -------------------------------------------------------------------------
# Events for amd64_fam10h_barcelona, amd64_fam10h_shanghai, amd64_fam10h_istanbul
[amd64_fam10h_barcelona amd64_fam10h_shanghai amd64_fam10h_istanbul]

{{ pmda_perf_event_amd64_fam10h_events | default('DATA_CACHE_REFILLS:SYSTEM\nRETIRED_SSE_OPERATIONS:ALL\nCPU_CLK_UNHALTED:u\n\nHYPERTRANSPORT_LINK2:COMMAND_DWORD_SENT:DATA_DWORD_SENT:BUFFER_RELEASE_DWORD_SENT:ADDRESS_EXT_DWORD_SENT:PER_PACKET_CRC_SENT node_rr\nHYPERTRANSPORT_LINK1:COMMAND_DWORD_SENT:DATA_DWORD_SENT:BUFFER_RELEASE_DWORD_SENT:ADDRESS_EXT_DWORD_SENT:PER_PACKET_CRC_SENT node_rr\nHYPERTRANSPORT_LINK0:COMMAND_DWORD_SENT:DATA_DWORD_SENT:BUFFER_RELEASE_DWORD_SENT:ADDRESS_EXT_DWORD_SENT:PER_PACKET_CRC_SENT node_rr\nDRAM_ACCESSES_PAGE:HIT:MISS:CONFLICT node_rr') }}

