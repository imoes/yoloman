# ============================================================================
# certmonger Configuration Template
# ============================================================================
#
# This file configures certmonger, a certificate tracking and renewal daemon.
# It uses an INI-style format. Keys and section names are case-sensitive.
# Whitespace around '=' is ignored. Comments start with '#'.
#
# All variables use Jinja2 defaults derived from the schema to ensure
# the template renders correctly even if the variable is undefined in
# the Ansible play.
# ============================================================================

[defaults]

# Directory where certmonger stores its state data.
# Schema: state_directory | default='/var/lib/certmonger'
state_directory = {{ state_directory | default('/var/lib/certmonger') }}

# Directory used for temporary files during certificate operations.
# Schema: tmp_directory | default='/var/tmp/certmonger'
tmp_directory = {{ tmp_directory | default('/var/tmp/certmonger') }}

# Directory where certmonger log files are stored.
# Schema: log_directory | default='/var/log/certmonger'
log_directory = {{ log_directory | default('/var/log/certmonger') }}

# Logging verbosity level. Higher values mean more verbose logging.
# Schema: log_level | default=3
log_level = {{ log_level | default(3) }}

# Maximum number of pending certificate requests.
# Schema: max_pending_requests | default=100
max_pending_requests = {{ max_pending_requests | default(100) }}

# Time-to-live for CA cache entries in seconds.
# Schema: ca_cache_ttl | default=86400
ca_cache_ttl = {{ ca_cache_ttl | default(86400) }}

# Maximum number of retries when contacting a CA.
# Schema: max_ca_retries | default=3
max_ca_retries = {{ max_ca_retries | default(3) }}

# Delay in seconds between CA retry attempts.
# Schema: ca_retry_delay | default=10
ca_retry_delay = {{ ca_retry_delay | default(10) }}

# Whether to start the renewer daemon automatically.
# Schema: start_renewer_daemon | default=True
start_renewer_daemon = {{ start_renewer_daemon | default(True) }}

# Directory containing helper scripts for certificate operations.
# Schema: helpers_directory | default='/usr/libexec/certmonger'
helpers_directory = {{ helpers_directory | default('/usr/libexec/certmonger') }}

# Whether to cache CA profiles.
# Schema: cache_ca_profiles | default=False
cache_ca_profiles = {{ cache_ca_profiles | default(False) }}