{
  "state_directory": "/var/lib/certmonger",
  "tmp_directory": "/var/tmp/certmonger",
  "log_directory": "/var/log/certmonger",
  "log_level": 3,
  "max_pending_requests": 50,
  "ca_cache_ttl": 43200,
  "max_ca_retries": 3,
  "ca_retry_delay": 15,
  "start_renewer_daemon": true,
  "helpers_directory": "/usr/libexec/certmonger",
  "ca_types": [
    {
      "name": "nss",
      "binary": "nss",
      "args": "",
      "description": "NSS database support for 389 DS and other services"
    },
    {
      "name": "http",
      "binary": "http",
      "args": "https://ca.internal.example.com:8443/ca",
      "description": "Generic HTTP CA (e.g., internal Dogtag)"
    },
    {
      "name": "pki",
      "binary": "pki",
      "args": "https://pki.example.com:8443/ca",
      "description": "Dogtag PKI CA integration"
    }
  ],
  "cache_ca_profiles": true
}
