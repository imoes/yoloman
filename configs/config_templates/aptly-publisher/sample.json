{
  "aptly_url": "http://aptly.internal:8080",
  "timeout": 60,
  "storage": "s3:aptly-bucket",
  "verbose": true,
  "debug": false,
  "default_architectures": [
    "amd64",
    "arm64"
  ],
  "publish_contents": true,
  "acquire_by_hash": true,
  "default_components": [
    "main",
    "contrib",
    "non-free"
  ],
  "default_dists": [
    "bullseye",
    "bullseye-updates"
  ],
  "only_latest": false,
  "default_source": "bullseye(/?.*)/nightly",
  "default_target": "bullseye{0}/staging",
  "show_diff": true,
  "hard_cleanup": true
}
