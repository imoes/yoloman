# Configuration file for xorriso-tcltk
# This file controls the behavior and appearance of the xorriso-tcltk GUI frontend.
# All variables use defaults matching the schema to ensure self-documentation
# and safe reuse without external context.

# Window position on screen using {+|-}X{+|-}Y format.
# +0X is left edge, -0X is right edge, +0Y is upper edge, -0Y is lower edge.
# Example: '+100+200' or '-0-0' for full screen.
geometry: {{ (values | default({})).geometry | default('+0+0') }}

# If true, disable extraction of files from ISO filesystem to hard disk.
# This prevents the GUI from allowing users to copy files out of mounted ISO images.
no_extract: {{ (values | default({})).no_extract | default(false) | lower }}

# Keyboard focus behavior for input fields and list boxes.
# 'click_to_focus': mouse click required to focus an element.
# 'auto_focus': keyboard focus follows the mouse pointer automatically.
focus_mode: {{ (values | default({})).focus_mode | default('click_to_focus') }}