# Nagios Command Definition for check_multi
# This defines a generic wrapper command that delegates execution to the
# check_multi plugin located in the standard Nagios plugins directory.
#
# The check_multi plugin allows monitoring multiple services/hosts in a
# single check, reducing NRPE/NSCA traffic and improving performance.

define command {
    # The unique name used in service definitions to invoke this check.
    command_name                    check_multi

    # The full command line to execute.
    # $ARG1$ through $ARG4$ are positional arguments passed from the service definition.
    # The default plugin directory is '/usr/lib/nagios/plugins', overridable via the
    # 'nagios_plugins_dir' variable in the Ansible inventory or role variables.
    command_line                    {{ nagios_plugins_dir | default('/usr/lib/nagios/plugins') }}/check_multi $ARG1$ $ARG2$ $ARG3$ $ARG4$
}
