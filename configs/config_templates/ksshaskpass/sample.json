{
  "ksshaskpass.ssh_sock_path": "/run/user/1000/ssh-agent.sock",
  "ksshaskpass.kde_config_db": "/home/user/.config/ksshaskpassrc",
  "ksshaskpass.enable_dialog": true,
  "ksshaskpass.timeout": 60,
  "ksshaskpass.icon_path": "/usr/share/icons/ksshaskpass.png",
  "ksshaskpass.ssh_commands": [
    "ssh-add",
    "ssh"
  ],
  "ksshaskpass.verbose": 1,
  "ksshaskpass.lock_file": "/tmp/ksshaskpass.lock"
}
