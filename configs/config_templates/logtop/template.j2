# Logtop Configuration Template
# This template generates the command-line arguments for the 'logtop' utility,
# which displays log data in a 'top'-like interface.

# Maximum number of lines to keep in memory.
# Default: 10000
-s {{ size | default(10000) }}

# If true, only display a top at exit.
# Default: False
{% if quiet | default(False) %}-q{% endif %}

# Number of results to print per line in machine-friendly format.
# Default: 10
-l {{ line_by_line | default(10) }}

# Interval between graphical updates in seconds.
# Default: 1
-i {{ interval | default(1) }}