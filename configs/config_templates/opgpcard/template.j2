# ==============================================================================
# Configuration template for opgpcard: OpenPGP Card Business Card Generator
#
# This template generates the configuration file for the 'opgpcard' utility,
# which creates printable business cards containing OpenPGP key information,
# QR codes, and vCard data.
#
# Variables are accessed directly from the root scope (not via 'values'),
# with explicit defaults to ensure safety when variables are undefined.
# ==============================================================================

# Directory where generated vcard, qr code, and printable cards are saved.
# Default: 'output/'
OUTPUTDIR: {{ outputdir | default('output/') }}

# Enable debug logging level.
# Default: False
DEBUG: {{ debug | default(False) | lower }}

# Whether to locally sign the OpenPGP key within the generated card.
# Default: True
LOCALSIGN: {{ localsign | default(True) | lower }}

# First name for the business card.
# Default: ''
FIRSTNAME: {{ firstname | default('') }}

# Last name for the business card.
# Default: ''
LASTNAME: {{ lastname | default('') }}

# Email address for the business card.
# Default: ''
MAIL: {{ mail | default('') }}

# OpenPGP key fingerprint to include in the card.
# Default: ''
FINGERPRINT: {{ fingerprint | default('') }}