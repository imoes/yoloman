#!/bin/sh
# xz-redhat configuration script
# This script is generated from the default configuration of the xz package.
#
# Self-documenting template for xz-utils aliases on Red Hat-based systems.
# Controls colorized output for xzgrep, xzfgrep, and xzegrep commands.

# Source the common grep configuration to ensure consistent behavior
. /usr/libexec/grepconf.sh -c
if ( $status == 1 ) exit

# Define aliases for xz utilities with color support.
# xzgrep: Search compressed files for patterns.
# Alias ensures colors are used if the terminal supports them.
alias xzgrep '{{ xzgrep_alias | default("xzgrep --color=auto") }}'

# xzfgrep: Search compressed files for patterns using fgrep (fixed strings).
# Alias ensures colors are used if the terminal supports them.
alias xzfgrep '{{ xzfgrep_alias | default("xzfgrep --color=auto") }}'

# xzegrep: Search compressed files for patterns using egrep (extended regex).
# Alias ensures colors are used if the terminal supports them.
alias xzegrep '{{ xzegrep_alias | default("xzegrep --color=auto") }}'
