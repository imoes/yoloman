# Register QEMU user-mode binary for foreign architecture binary format
# Each line registers one architecture using binfmt_misc kernel interface
# Format: :name:type:offset:magic:mask:interpreter:flags
{% for entry in qemu_binfmt_entries %}
:{{ entry.name }}:{{ entry.type }}:{{ entry.offset }}:{{ entry.magic | default('') }}:{{ entry.mask | default('') }}:{{ entry.interpreter }}:{{ entry.flags | default('') }}
{% endfor %}