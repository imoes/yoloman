{
  "primary_host": "pg-primary.example.com",
  "primary_port": 5432,
  "primary_user": "repl_user",
  "primary_password": "secret123",
  "primary_database": "app_db",
  "standby_host": "pg-standby.example.com",
  "standby_port": 5432,
  "standby_user": "repl_user",
  "standby_password": "secret123",
  "standby_database": "app_db",
  "replication_slots": [
    {
      "name": "ha_failover_slot",
      "plugin": "pgoutput",
      "two_phase": true
    },
    {
      "name": "analytics_slot",
      "plugin": "pgoutput",
      "two_phase": false
    }
  ],
  "check_interval": 15,
  "auto_promote": true,
  "strict_mode": false,
  "operation_timeout": 45
}
