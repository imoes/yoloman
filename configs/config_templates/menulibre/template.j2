# MenuLibre Configuration Template
# This template generates a representative application configuration context.
# Note: MenuLibre primarily edits desktop entries (`.desktop` files) in ~/.local/share/applications/ or system directories.
# It does not have a traditional persistent configuration file like /etc/menulibre.conf.
# The following variables represent the default behaviors and interface preferences
# that might be stored in user preferences (e.g., gsettings or a simple JSON/YAML config if one existed).

# Use headerbar layout (client side decorations)
# Default: {{ values.use_headerbar | default(false) | lower }}
use_headerbar={{ values.use_headerbar | default(false) | lower }}

# Use toolbar layout (server side decorations)
# Default: {{ values.use_toolbar | default(false) | lower }}
use_toolbar={{ values.use_toolbar | default(false) | lower }}

# Show debug messages (verbose mode)
# Default: {{ values.verbose | default(false) | lower }}
verbose={{ values.verbose | default(false) | lower }}

# Language for the interface
# Default: {{ values.language | default('en') }}
language={{ values.language | default('en') }}

# Default category for new application entries
# Default: {{ values.default_category | default('Utility') }}
default_category={{ values.default_category | default('Utility') }}

# List of ignored directories for menu scanning
# Default: {{ values.ignored_directories | default([]) | join(', ') }}
ignored_directories={{ values.ignored_directories | default([]) | join(', ') }}