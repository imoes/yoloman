{
  "snmp": {
    "community": "secure-snmp-v3-readonly",
    "location": "Data Center, Rack 14",
    "contact": "sysadmin@example.org",
    "log_level": 3,
    "trap_events": [
      "login",
      "logout",
      "upload",
      "download",
      "delete"
    ],
    "trap_destinations": [
      {
        "host": "monitor1.example.org",
        "port": 162,
        "community": "public-trap"
      },
      {
        "host": "10.0.1.5",
        "port": 1162,
        "community": "trap-community"
      }
    ],
    "pid_file": "/run/proftpd/proftpd-snmp.pid",
    "allowed_hosts": [
      "127.0.0.1",
      "10.0.1.0/24",
      "monitor1.example.org"
    ]
  }
}
