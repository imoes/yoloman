# vim:syntax=apparmor
#include <tunables/global>

# profile_name: The name of the AppArmor profile.
# This profile is mostly unconfined but restricts capability usage and mount rules.
# It ensures that execution permissions are inherited from this profile context.
profile {{ profile_name | default('lomiri-url-dispatcher-bad-url-helper') }} (attach_disconnected) {
  # Allow access to any network protocol/interface.
  network,

  # Allow read/write/knock (open for execute) access to root directory itself.
  / rwkl,

  # Allow read/write/lock/create/link/mmap access to all files recursively.
  # The 'k' permission allows creating and linking files.
  /** rwlkm,

  # Allow pixel access (specifically for display/graphics operations).
  /** pix,

  # Allow unrestricted D-Bus messaging.
  dbus,

  # Allow sending and receiving signals (inter-process communication).
  signal,

  # Allow ptrace operations (debugging/tracing other processes).
  ptrace,

  # Allow unrestricted Unix domain socket operations.
  unix,
}
