##
## conserver.cf - Conserver Console Server Configuration
##
## This template generates the main configuration file for the conserver
## terminal server multiplexer. It includes global defaults, terminal
## server definitions, console definitions, and user access controls.
##

#
# ============================================================================
# Global Access Defaults
# ============================================================================
#
# Define the default permissions for all consoles. 'full' grants read/write
# access to all users (*).
default full {
    rw *;
}

#
# ============================================================================
# Terminal Server Specifics
# ============================================================================
#
# Configure default parameters for specific types of terminal servers.
# portbase defines the starting port number, and portinc defines the
# increment for sequential console definitions on that server.

##
## Cisco Terminal Server Defaults
##
# Sets the base port number for Cisco-style terminal servers.
# @see cisco_portbase
default cisco {
    type host;
{% if cisco_portbase is defined and cisco_portbase is not none and (cisco_portbase is number or cisco_portbase is boolean or cisco_portbase | length > 0) %}    portbase {{ cisco_portbase | default('2000') }};{% else %}#	portbase -1;{% endif %}
    portinc 1;
}

##
## XYPLEX Terminal Server Defaults
##
# Sets the base port number for XYPLEX-style terminal servers.
# @see xyplex_portbase
default xyplex {
    type host;
{% if xyplex_portbase is defined and xyplex_portbase is not none and (xyplex_portbase is number or xyplex_portbase is boolean or xyplex_portbase | length > 0) %}    portbase {{ xyplex_portbase | default('2000') }};{% else %}#	portbase -1;{% endif %}
    portinc 100;
}

##
## IOLAN Terminal Server Defaults
##
# Sets the base port number for IOLAN-style terminal servers.
# @see iolan_portbase
default iolan {
    type host;
{% if iolan_portbase is defined and iolan_portbase is not none and (iolan_portbase is number or iolan_portbase is boolean or iolan_portbase | length > 0) %}    portbase {{ iolan_portbase | default('10000') }};{% else %}#	portbase -1;{% endif %}
    portinc 1;
}

#
# ============================================================================
# Break Sequences
# ============================================================================
#
# Define custom break signal sequences used to access boot loaders or
# console prompts.

##
## Break Sequence 4
##
# Defines the delay in seconds between characters for the break sequence 4.
# @see break_4_delay
break 4 {
    string "+\d+\d+";
    delay {{ break_4_delay | default('300') }};
}

# Break sequence 5 example (commented out in default, but structure shown)
# break 5 {
#     string "\033c";
# }

#
# ============================================================================
# Global Console Defaults
# ============================================================================
#
# These defaults apply to all consoles unless overridden by specific
# console or default blocks.

#
## Default Master Server
##
# Specifies the hostname or IP address of the default master conserver server.
# @see default_master
default * {
    #
    ## Default Log File
    ##
    # Specifies the default path for console log files.
    # The '&' character is automatically substituted with the console name.
    # @see default_logfile
    logfile {{ default_logfile | default('/var/consoles/&') }};

    #
    ## Timestamps
    ##
    # Logs timestamps every hour for activity and break events.
    timestamp 1hab;

    #
    ## Include Full Permissions
    ##
    # Inherits the 'full' default block (read/write access for all).
    include full;

    #
    ## Default Master
    ##
    # Sets the master server for these consoles.
    master {{ default_master | default('localhost') }};
}

