#
# ============================================================================
# Re-apply Global Defaults (Optional)
# ============================================================================
#
# If specific overrides were needed for a section, defaults can be
# reset here.

default * {
    logfile {{ default_logfile | default('/var/consoles/&') }};
    master {{ default_master | default('localhost') }};
}

