#
# ============================================================================
# One-Off Consoles (Local/Device Access)
# ============================================================================
#
# Consoles that do not use a remote terminal server but instead connect
# to local devices or execute local commands.

#
## Console: ttya
##
# Direct device access to /dev/ttya.
# @see ttya_baud
console ttya {
    type device;
    device /dev/ttya;
    parity none;
{% if ttya_baud is defined and ttya_baud is not none and (ttya_baud is number or ttya_baud is boolean or ttya_baud | length > 0) %}    baud {{ ttya_baud | default(9600) }};{% else %}#	baud 9600;{% endif %}
}

#
## Console: ssh
##
# Local SSH access example.
#console ssh {
#	type exec;
#	exec ssh localhost;
#	motd "just a simple ssh to localhost";
#}

#
# ============================================================================
# Cyclades Device Consoles
# ============================================================================
#
# Defines defaults for Cyclades serial port cards.

#
## Cyclades Defaults
##
# Configures defaults for /dev/ttyC0 through /dev/ttyC31.
# @see cyclades_baud
default cyclades {
    type device;
    device /dev/ttyC.;
    devicesubst .=Pd;
    portbase -1;
    portinc 1;
    host none;
{% if cyclades_baud is defined and cyclades_baud is not none and (cyclades_baud is number or cyclades_baud is boolean or cyclades_baud | length > 0) %}    baud {{ cyclades_baud | default(9600) }};{% else %}#	baud 9600;{% endif %}
    parity none;
}

