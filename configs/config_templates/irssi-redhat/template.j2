      visible   = "{{ irssi_statusbar_prompt_visible | default('always') }}";

      items = {
        # Prompt item priority in prompt statusbar: {{ irssi_statusbar_prompt_items_prompt_priority | default('-1') }}
        prompt       = { priority = "{{ irssi_statusbar_prompt_items_prompt_priority | default('-1') }}"; };
