# =============================================================================
# Statusbar Configuration
# =============================================================================
statusbar = {
  items = {
    barstart = "{sbstart}";
    barend   = "{sbend}";

    topicbarstart = "{topicsbstart}";
    topicbarend   = "{topicsbend}";

    time = "{sb $Z}";
    user = "{sb {sbnickmode $cumode}$N{sbmode $usermode}{sbaway $A{{ '}}' }}";

    window       = "{sb $winref:$tag/$itemname{sbmode $M{{ '}}' }}";
    window_empty = "{sb $winref{sbservertag $tag{{ '}}' }}";

    prompt       = "{prompt $[.15]itemname}";
    prompt_empty = "{prompt $winname}";

    topic       = " $topic";
    # URL for statusbar topic empty message: {{ irssi_statusbar_topic_empty_url | default('https://irssi.org') }}
    topic_empty = " Irssi v$J - {{ irssi_statusbar_topic_empty_url | default('https://irssi.org') }}";

    lag  = "{sb Lag: $0-}";
    act  = "{sb Act: $0-}";
    more = "-- more --";
  };

  default = {
    window = {
      # Window statusbar disabled setting: {{ irssi_statusbar_window_disabled | default('no') }}
      disabled  = "{{ irssi_statusbar_window_disabled | default('no') }}";
      type      = "window";
      # Window statusbar placement: {{ irssi_statusbar_window_placement | default('bottom') }}
      placement = "{{ irssi_statusbar_window_placement | default('bottom') }}";
      # Window statusbar position: {{ irssi_statusbar_window_position | default('1') }}
      position  = "{{ irssi_statusbar_window_position | default('1') }}";
      # Window statusbar visibility: {{ irssi_statusbar_window_visible | default('active') }}
      visible   = "{{ irssi_statusbar_window_visible | default('active') }}";

      items = {
        # Barstart item priority in window statusbar: {{ irssi_statusbar_window_items_barstart_priority | default('100') }}
        barstart     = { priority = "{{ irssi_statusbar_window_items_barstart_priority | default('100') }}"; };
        time         = { };
        user         = { };
        window       = { };
        window_empty = { };
        # Lag item priority in window statusbar: {{ irssi_statusbar_window_items_lag_priority | default('-1') }}
        lag          = { priority = "{{ irssi_statusbar_window_items_lag_priority | default('-1') }}"; };
        # Act item priority in window statusbar: {{ irssi_statusbar_window_items_act_priority | default('10') }}
        act          = { priority = "{{ irssi_statusbar_window_items_act_priority | default('10') }}"; };
        # More item priority in window statusbar: {{ irssi_statusbar_window_items_more_priority | default('-1') }}
        # More item alignment in window statusbar: {{ irssi_statusbar_window_items_more_alignment | default('right') }}
        more         = { priority = "{{ irssi_statusbar_window_items_more_priority | default('-1') }}";
                         alignment = "{{ irssi_statusbar_window_items_more_alignment | default('right') }}"; };
        # Barend item priority in window statusbar: {{ irssi_statusbar_window_items_barend_priority | default('100') }}
        # Barend item alignment in window statusbar: {{ irssi_statusbar_window_items_barend_alignment | default('right') }}
        barend       = { priority = "{{ irssi_statusbar_window_items_barend_priority | default('100') }}";
                         alignment = "{{ irssi_statusbar_window_items_barend_alignment | default('right') }}"; };
      };
    };

    window_inact = {
      type      = "window";
      # Inactive window statusbar placement: {{ irssi_statusbar_window_inact_placement | default('bottom') }}
      placement = "{{ irssi_statusbar_window_inact_placement | default('bottom') }}";
      # Inactive window statusbar position: {{ irssi_statusbar_window_inact_position | default('1') }}
      position  = "{{ irssi_statusbar_window_inact_position | default('1') }}";
      # Inactive window statusbar visibility: {{ irssi_statusbar_window_inact_visible | default('inactive') }}
