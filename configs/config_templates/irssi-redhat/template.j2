      items = {
        # Barstart item priority in inactive window statusbar: {{ irssi_statusbar_window_inact_items_barstart_priority | default('100') }}
        barstart     = { priority = "{{ irssi_statusbar_window_inact_items_barstart_priority | default('100') }}"; };
        window       = { };
        window_empty = { };
        # More item priority in inactive window statusbar: {{ irssi_statusbar_window_inact_items_more_priority | default('-1') }}
        # More item alignment in inactive window statusbar: {{ irssi_statusbar_window_inact_items_more_alignment | default('right') }}
        more         = { priority = "{{ irssi_statusbar_window_inact_items_more_priority | default('-1') }}";
                         alignment = "{{ irssi_statusbar_window_inact_items_more_alignment | default('right') }}"; };
        # Barend item priority in inactive window statusbar: {{ irssi_statusbar_window_inact_items_barend_priority | default('100') }}
        # Barend item alignment in inactive window statusbar: {{ irssi_statusbar_window_inact_items_barend_alignment | default('right') }}
        barend       = { priority = "{{ irssi_statusbar_window_inact_items_barend_priority | default('100') }}";
                         alignment = "{{ irssi_statusbar_window_inact_items_barend_alignment | default('right') }}"; };
      };
    };

    prompt = {
      type      = "root";
      # Prompt statusbar placement: {{ irssi_statusbar_prompt_placement | default('bottom') }}
      placement = "{{ irssi_statusbar_prompt_placement | default('bottom') }}";
      # Prompt statusbar position: {{ irssi_statusbar_prompt_position | default('100') }}
