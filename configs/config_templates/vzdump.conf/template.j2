# Proxmox VE backup configuration file
# This file controls global settings for vzdump (backup/restore) operations.
# Set the storage used for backups by default.
storage: {{ backup_storage }}

# Maximum number of backup jobs allowed to run in parallel.
cores: {{ backup_cores }}

# Default compression algorithm for backups.
compression: {{ backup_compression }}

# Enable or disable snapshot-based backup (requires LVM or ZFS with snapshots).
snapshot: {{ enable_snapshot }}

# Enable or disable mode that suspends VMs instead of pausing them (only for QEMU VMs).
resume: {{ enable_resume }}

# Timeout (in seconds) for the whole backup operation.
timeout: {{ backup_timeout }}

# List of storage IDs to exclude from backup (e.g., for caching or temporary data).
exclude-storage: {{ exclude_storages | join(', ') }}

# Enable or disable notification emails on backup failure.
mailnotification: {{ mail_notification }}

# Email address to send backup notifications to.
mailnotification_only_on_error: {{ mailnotification_only_on_error }}

# SMTP server to use for email notifications.
mailto: {{ mailto }}

# Email sender address.
mailfrom: {{ mailfrom }}

# Maximum number of backup files to retain per VM/CT (0 = no limit).
maxfiles: {{ backup_maxfiles }}

# Enable or disable automatic cleanup of old backups when maxfiles is exceeded.
purge: {{ enable_purge }}

# Default mode: suspend (default), shutdown, or stop.
mode: {{ backup_mode }}

# Enable or disable incremental backups (requires storage with snapshot support).
incremental: {{ incremental }}

# Number of incremental backups to keep (only applicable if incremental = 1).
incremental_keep: {{ incremental_keep }}

# Disable automatic snapshot cleanup (use with caution).
skipcleanup: {{ skipcleanup }}

# Comma-separated list of nodes (for cluster-wide backup policies).
nodes: {{ nodes | join(', ') }}

# Optional: define default proxy settings (e.g., for cloud storage).
proxy: {{ proxy_url }}

# Enable or disable TLS verification for remote storages (set to 0 for self-signed certs).
verify: {{ verify_ssl }}

# Default priority for backup jobs (1–100; higher = higher priority).
priority: {{ backup_priority }}
