{
  "backup_storage": "local-zfs",
  "backup_cores": 4,
  "backup_compression": "zstd",
  "enable_snapshot": true,
  "enable_resume": true,
  "backup_timeout": 10800,
  "exclude_storages": [
    "cache",
    "tmp"
  ],
  "mail_notification": true,
  "mailnotification_only_on_error": true,
  "mailto": "admin@example.com",
  "mailfrom": "vzdump@example.com",
  "backup_maxfiles": 7,
  "enable_purge": true,
  "backup_mode": "suspend",
  "incremental": true,
  "incremental_keep": 4,
  "skipcleanup": false,
  "nodes": [
    "pve1",
    "pve2"
  ],
  "proxy_url": "",
  "verify_ssl": true,
  "backup_priority": 80
}
