{
  "env_dir": {
    "type": "string",
    "default": "/opt/nodeenv",
    "description": "Directory path where the Node.js environment will be created"
  },
  "node_version": {
    "type": "string",
    "default": "latest",
    "description": "Node.js version to install (e.g., 'latest', '14.17.0', 'system')",
    "enum": [
      "latest",
      "system",
      "0.4.3",
      "0.6.3",
      "0.3.18"
    ],
    "enum_open": true
  },
  "npm_version": {
    "type": "string",
    "default": "latest",
    "description": "NPM version to install alongside Node.js",
    "enum": [
      "latest",
      "0.3.18"
    ]
  },
  "parallel_jobs": {
    "type": "number",
    "default": 2,
    "description": "Number of parallel jobs for compiling Node.js from source"
  },
  "load_average": {
    "type": "number",
    "default": 0,
    "description": "Maximum load average allowed before skipping parallel compilation (0 to disable)"
  },
  "make_path": {
    "type": "string",
    "default": "",
    "description": "Path to the make command used for compilation"
  },
  "use_iojs": {
    "type": "bool",
    "default": false,
    "description": "Use io.js instead of Node.js"
  },
  "without_ssl": {
    "type": "bool",
    "default": false,
    "description": "Build Node.js without SSL support"
  },
  "enable_profiling": {
    "type": "bool",
    "default": false,
    "description": "Enable profiling builds for Node.js"
  },
  "build_debug": {
    "type": "bool",
    "default": false,
    "description": "Build debug variant of Node.js"
  },
  "use_prebuilt": {
    "type": "bool",
    "default": true,
    "description": "Use prebuilt package instead of compiling from source"
  },
  "install_npm": {
    "type": "bool",
    "default": true,
    "description": "Install npm into the virtual environment"
  },
  "clean_npm": {
    "type": "bool",
    "default": true,
    "description": "Perform npm 0.x cleanup process"
  },
  "clean_src": {
    "type": "bool",
    "default": true,
    "description": "Remove source directory after installation"
  },
  "force_install": {
    "type": "bool",
    "default": false,
    "description": "Force installation into a pre-existing directory"
  },
  "use_python_virtualenv": {
    "type": "bool",
    "default": false,
    "description": "Use current Python virtualenv context"
  },
  "requirements_file": {
    "type": "string",
    "default": "",
    "description": "Path to requirements file for installing npm packages"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose mode output"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Enable quiet mode output"
  },
  "prompt_prefix": {
    "type": "string",
    "default": "",
    "description": "Alternative prompt prefix for the activated environment"
  },
  "config_file": {
    "type": "string",
    "default": "",
    "description": "Path to custom configuration file"
  }
}
