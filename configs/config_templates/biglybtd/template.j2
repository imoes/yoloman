# ==============================================================================
# BiglyBT Daemon (biglybtd) Configuration Template
# ==============================================================================
# This template generates a sudoers-style configuration snippet for the BiglyBT
# daemon. It controls GUI access aliases and the system user context for the daemon.
#
# Self-Documenting Fields:
# - jwt_gui_users: List of users permitted to interact with the BiglyBT JWT-based
#   graphical user interface. Defaults to 'put_username_here'.
# - runas_user: The operating system user account under which the BiglyBT daemon
#   process executes. Must match the systemd service definition. Defaults to 'biglybt'.
# ==============================================================================

# ------------------------------------------------------------------------------
# GUI Access Alias Definition
# ------------------------------------------------------------------------------
# Defines the sudoers alias 'BIGLYBTD_GUI'. This alias maps to the comma-separated
# list of usernames specified in `jwt_gui_users`. These users are authorized to
# display the BiglyBT JWT UI.
#
# Schema Field: jwt_gui_users
# Default: put_username_here
# ------------------------------------------------------------------------------
User_Alias      BIGLYBTD_GUI = {{ jwt_gui_users | default('put_username_here') }}

# ------------------------------------------------------------------------------
# Daemon User Alias Definition
# ------------------------------------------------------------------------------
# Defines the sudoers alias 'BIGLYBTD_USER'. This alias maps to the system user
# account specified in `runas_user`. The BiglyBT daemon and related sudo commands
# operate under this identity to ensure proper privilege separation.
#
# Schema Field: runas_user
# Default: biglybt
# ------------------------------------------------------------------------------
Runas_Alias     BIGLYBTD_USER = {{ runas_user | default('biglybt') }}

# ------------------------------------------------------------------------------
# Command Allowances for GUI Access
# ------------------------------------------------------------------------------
# Grants the users in the BIGLYBTD_GUI alias the ability to execute specific
# xauth commands as the daemon user (BIGLYBTD_USER) without a password.
# This is required for X11 forwarding and display management when running the
# daemon headless or via remote desktop.
#
# 1. Allows executing bash to merge Xauthority files.
# 2. Allows direct execution of xauth to merge Xauthority files.
# ------------------------------------------------------------------------------
BIGLYBTD_GUI    ALL=(BIGLYBTD_USER) NOPASSWD: /bin/bash -c /usr/bin/xauth -f $HOME/.Xauthority merge -
BIGLYBTD_GUI    ALL=(BIGLYBTD_USER) NOPASSWD: /usr/bin/xauth merge -

# Commented out fallback: Direct xauth execution as 'biglybt' user explicitly.
# Uncomment if the alias resolution fails or for debugging specific permission issues.
#BIGLYBTD_GUI    ALL=(biglybt) NOPASSWD: /usr/bin/xauth -f $HOME/.Xauthority merge -
