{# /etc/default/efibootmgr - Configuration for efibootmgr operations #}
# Generated by configuration management; do not edit manually
# All settings are applied as command-line arguments to efibootmgr invocations

{# Boot timeout in seconds #}
EFIBOOTMGR_TIMEOUT={{ timeout|default(30) }}

{# Boot order (comma-separated hex strings) #}
EFIBOOTMGR_ORDER="{{ order|default('')|join(',') }}"

{# Active/inactive state of specific boot entries #}
{% for entry in entries %}
{% if entry.state == 'active' %}
EFIBOOTMGR_ACTIVE_{{ '%04X'|format(entry.number) }}=1
{% elif entry.state == 'inactive' %}
EFIBOOTMGR_INACTIVE_{{ '%04X'|format(entry.number) }}=1
{% endif %}
{% endfor %}

{# New boot entry creation parameters (only when needed) #}
{% for entry in entries %}
{% if entry.create %}
# Create new entry {{ '%04X'|format(entry.number) }}
EFIBOOTMGR_CREATE_{{ '%04X'|format(entry.number) }}=1
EFIBOOTMGR_DISK_{{ '%04X'|format(entry.number) }}="{{ entry.disk|default('/dev/sda') }}"
EFIBOOTMGR_PART_{{ '%04X'|format(entry.number) }}="{{ entry.partition|default(1) }}"
EFIBOOTMGR_LOADER_{{ '%04X'|format(entry.number) }}="{{ entry.loader }}"
EFIBOOTMGR_LABEL_{{ '%04X'|format(entry.number) }}="{{ entry.label|default('Linux') }}"
{% if entry.interface %}
EFIBOOTMGR_IFACE_{{ '%04X'|format(entry.number) }}="{{ entry.interface }}"
{% endif %}
{% if entry.cmdline %}
EFIBOOTMGR_CMDLINE_{{ '%04X'|format(entry.number) }}="{{ entry.cmdline|default('') }}"
{% endif %}
{% endif %}
{% endfor %}

{# BootNext setting #}
{% if bootnext is defined %}
EFIBOOTMGR_BOOTNEXT="{{ bootnext|default('') }}"
{% endif %}

{# Remove duplicates flag #}
{% if remove_duplicates %}
EFIBOOTMGR_REMOVE_DUPS=1
{% endif %}

{# Delete timeout setting #}
{% if delete_timeout %}
EFIBOOTMGR_DELETE_TIMEOUT=1
{% endif %}

{# Delete bootorder setting #}
{% if delete_bootorder %}
EFIBOOTMGR_DELETE_BOOTORDER=1
{% endif %}

{# Delete specific boot entry flag #}
{% for entry in entries %}
{% if entry.delete %}
EFIBOOTMGR_DELETE_ENTRY_{{ '%04X'|format(entry.number) }}=1
{% endif %}
{% endfor %}

{# Quiet mode #}
{% if quiet %}
EFIBOOTMGR_QUIET=1
{% endif %}

{# Unicode handling #}
{% if unicode %}
EFIBOOTMGR_UNICODE=1
{% endif %}

{# Drive-specific flags #}
{% if full_dev_path %}
EFIBOOTMGR_FULL_DEV_PATH=1
{% endif %}
{% if file_dev_path %}
EFIBOOTMGR_FILE_DEV_PATH=1
{% endif %}
{% if reconnect %}
EFIBOOTMGR_RECONNECT=1
{% endif %}
{% if no_reconnect %}
EFIBOOTMGR_NO_RECONNECT=1
{% endif %}
{% if gpt %}
EFIBOOTMGR_GPT=1
{% endif %}
{% if write_signature %}
EFIBOOTMGR_WRITE_SIGNATURE=1
{% endif %}

{# Memory mirroring #}
{% if mirror_below_4g is defined %}
EFIBOOTMGR_MIRROR_BELOW_4G="{{ mirror_below_4g|default('f') | lower }}"
{% endif %}
{% if mirror_above_4g is defined %}
EFIBOOTMGR_MIRROR_ABOVE_4G="{{ mirror_above_4g|default('0.0') }}"
{% endif %}

{# EDD device settings (legacy) #}
{% if edd is defined %}
EFIBOOTMGR_EDD="{{ edd }}"
{% endif %}
{% if edd_device is defined %}
EFIBOOTMGR_EDD_DEVICE="{{ edd_device }}"
{% endif %}
