{
  "debug": false,
  "max_connections": 200,
  "keytab": "/etc/krb5.keytab",
  "socket_path": "/var/run/heimdal-kcm/socket",
  "persistent_cache": true,
  "max_ticket_lifetime": 43200,
  "max_renew_lifetime": 604800,
  "enctypes": [
    "aes256-cts-hmac-sha1-96",
    "aes128-cts-hmac-sha1-96"
  ],
  "allowed_groups": [
    "kcm-users",
    "wheel"
  ],
  "log_level": 2,
  "syslog_facility": "auth",
  "windows_referrals": false,
  "referrals": [
    {
      "realm": "EXTERNAL.EXAMPLE.ORG",
      "kdc": "kdc.external.example.org"
    }
  ]
}
