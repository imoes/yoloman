# Ansible-generated AppArmor profile for fwknopd (FireWalk KNock OPen Port)
# This profile confines the fwknopd daemon, granting only the minimum
# privileges required for Single Packet Authorization (SPA) operations.
#
# Generated by Ansible Jinja2 template. Do not edit manually.

include <tunables/global>

# Assumes fwknopd was built with:
#    './configure --prefix=/usr --sysconfdir=/etc --localstatedir=/run'

{{ fwknopd_binary_path | default('/usr/sbin/fwknopd') }} {
  # Include standard abstraction for base system utilities
  include <abstractions/base>
  # Include GStreamer abstraction if multimedia processing is needed
  include <abstractions/gstreamer>

  # Capability: Lock memory to prevent swapping sensitive keys/passwords
  capability ipc_lock,
  # Capability: Allow manipulation of network namespaces and firewall rules
  capability net_admin,
  # Capability: Allow creation of raw sockets for packet inspection
  capability net_raw,

  # Network permissions: Allow UDP/DGRAM and RAW packets on IPv4 and IPv6
  # fwknopd relies on UDP traffic for SPA packets.
  network inet dgram,
  network inet raw,
  network inet6 dgram,
  # Allow packet family access for advanced network operations
  network packet dgram,
  network packet raw,

  # Shell access for executing external commands (e.g., iptables calls)
  /bin/bash rix,
  /bin/dash rix,

  # Configuration files read-only access
  # Path to the fwknopd access configuration file
  {{ access_conf_path | default('/etc/fwknop/access.conf') }} r,
  # Path to the fwknopd main configuration file
  {{ fwknopd_conf_path | default('/etc/fwknop/fwknopd.conf') }} r,

  # System configuration files read-only access
  /etc/gai.conf r,
  /etc/host.conf r,
  /etc/nsswitch.conf r,
  /etc/passwd r,
  /etc/protocols r,
  /etc/resolv.conf r,
  /etc/services r,

  # GnuPG Home directory: Read, Write, Lock, Link keys and secrets
  # Path to root's GnuPG home directory used for SPA signature verification
  {{ root_gnupg_home | default('/root/.gnupg') }}/* rwlk,

  # Runtime directory: Read, Write for directories and files, Lock for state files
  # Runtime directory for fwknopd PID and state files
  {{ run_dir | default('/run/fwknop') }}/ rw,
  {{ run_dir | default('/run/fwknop') }}/* rwk,

  # Resolvconf symlink read (historical compatibility)
  /run/resolvconf/resolv.conf r,

  # Xtables lock file for exclusive access to iptables/nftables
  /run/xtables.lock rwk,

  # IPset utilities: Execute with inherit permissions
  /sbin/ipset rix,
  /sbin/xtables-legacy-multi rix,
  /sbin/xtables-multi rix,

  # GPG binary: Execute to verify SPA signatures
  /usr/bin/gpg rix,

  # fwknopd binary: Memory map and read permissions for execution
  {{ fwknopd_binary_path | default('/usr/sbin/fwknopd') }} mr,

  # Additional IPset and Xtables utilities (usr/sbin paths)
  /usr/sbin/ipset rix,
  /usr/sbin/xtables-legacy-multi rix,
  /usr/sbin/xtables-nft-multi rix,

  # NSCD (Name Service Cache Daemon) cached passwd file: Read-only
  # Path to cached passwd file from nscd to avoid repeated lookups
  {{ nscd_cache_passwd_path | default('/var/cache/nscd/passwd') }} r,

  # Procfs entry: Read IP tables names from the specific process's view
  @{PROC}/@{pid}/net/ip_tables_names r,
}
