{
  "pcap_intf": "eth0",
  "pcap_filter": "udp port 62201",
  "enable_pcap_promisc": false,
  "pcap_loop_sleep": 100000,
  "max_sniff_bytes": 1500,
  "max_spa_packet_age": 120,
  "enable_spa_packet_aging": true,
  "enable_digest_persistence": true,
  "digest_file": "/var/lib/fwknop/digest.cache",
  "enable_spa_over_http": false,
  "enable_tcp_server": false,
  "tcpserv_port": 62201,
  "gpg_home_dir": "",
  "enable_ipt_forwarding": false,
  "enable_ipt_local_nat": false,
  "enable_ipt_output": false,
  "enable_ipt_conntrack_input": true,
  "pid_file": "/var/run/fwknopd.pid",
  "syslog_identity": "fwknopd",
  "syslog_facility": "LOG_DAEMON",
  "verbose": 0
}
