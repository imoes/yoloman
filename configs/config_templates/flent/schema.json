{
  "length": {
    "type": "number",
    "default": 60,
    "description": "Base test length in seconds"
  },
  "step_size": {
    "type": "number",
    "default": 0.1,
    "description": "Measurement data point step size in seconds"
  },
  "delay": {
    "type": "number",
    "default": 0,
    "description": "Delay in seconds before test starts"
  },
  "socket_timeout": {
    "type": "number",
    "default": 0,
    "description": "Socket timeout for UDP delay measurement in seconds (0 = disabled)"
  },
  "send_size": {
    "type": "number",
    "default": 0,
    "description": "TCP send size in bytes (0 = use socket buffer size)"
  },
  "ipv4": {
    "type": "bool",
    "default": false,
    "description": "Use IPv4 for tests"
  },
  "ipv6": {
    "type": "bool",
    "default": false,
    "description": "Use IPv6 for tests"
  },
  "local_bind": {
    "type": "string",
    "default": "",
    "description": "Local hostname or IP address to bind to"
  },
  "control_host": {
    "type": "string",
    "default": "",
    "description": "Host for test control connection (default: first target host)"
  },
  "test_parameters": {
    "type": "list",
    "default": [],
    "description": "Arbitrary test parameters as key=value pairs; each item has 'key' and 'value' fields"
  },
  "test_parameters.items": {
    "type": "object",
    "description": "Single test parameter key-value pair"
  },
  "test_parameters.items.key": {
    "type": "string",
    "default": "",
    "description": "Parameter key (case-folded to lowercase)"
  },
  "test_parameters.items.value": {
    "type": "string",
    "default": "",
    "description": "Parameter value"
  },
  "marking_names": {
    "type": "list",
    "default": [],
    "description": "Symbolic marking names (key=value) for flow markings"
  },
  "marking_names.items": {
    "type": "object",
    "description": "Single marking name mapping"
  },
  "marking_names.items.name": {
    "type": "string",
    "default": "",
    "description": "Symbolic name (e.g., 'MY_MARK')"
  },
  "marking_names.items.value": {
    "type": "string",
    "default": "",
    "description": "Hex marking value (e.g., '0xb8' for EF)"
  },
  "ping_hosts": {
    "type": "list",
    "default": [],
    "description": "Extra hosts to ping during test"
  },
  "ping_local_binds": {
    "type": "list",
    "default": [],
    "description": "Local IP addresses to bind to for extra ping flows"
  },
  "ping_labels": {
    "type": "list",
    "default": [],
    "description": "Labels for extra ping flows"
  },
  "voip_host": {
    "type": "string",
    "default": "",
    "description": "VoIP test target hostname (single host)"
  },
  "voip_local_bind": {
    "type": "string",
    "default": "",
    "description": "Local IP for VoIP test"
  },
  "voip_marking": {
    "type": "string",
    "default": "",
    "description": "DiffServ marking for VoIP flow (e.g., 'EF', 'CS0')",
    "enum": [
      "AF11",
      "AF12",
      "AF13",
      "AF21",
      "AF22",
      "AF23",
      "AF31",
      "AF32",
      "AF33",
      "AF41",
      "AF42",
      "AF43",
      "CS0",
      "CS1",
      "CS2",
      "CS3",
      "CS4",
      "CS5",
      "CS6",
      "CS7",
      "EF"
    ]
  },
  "stats_hosts": {
    "type": "object",
    "default": null,
    "description": "Hosts to gather extended statistics from"
  },
  "stats_hosts.cpu": {
    "type": "string",
    "default": "",
    "description": "Comma-separated hostnames for CPU stats"
  },
  "stats_hosts.netstat": {
    "type": "string",
    "default": "",
    "description": "Comma-separated hostnames for netstat"
  },
  "stats_hosts.qdisc": {
    "type": "string",
    "default": "",
    "description": "Comma-separated hostnames for qdisc stats"
  },
  "stats_hosts.wifi": {
    "type": "string",
    "default": "",
    "description": "Comma-separated hostnames for WiFi stats"
  },
  "qdisc_stats_interfaces": {
    "type": "list",
    "default": [],
    "description": "Interfaces for qdisc stats collection (one per host)"
  },
  "wifi_stats_interfaces": {
    "type": "list",
    "default": [],
    "description": "Interfaces for WiFi stats collection (one per host)"
  },
  "wifi_stats_stations": {
    "type": "list",
    "default": [],
    "description": "MAC addresses of stations to gather WiFi stats for"
  },
  "control_hosts": {
    "type": "list",
    "default": [],
    "description": "Hostnames for control connections in fair queuing tests"
  },
  "markings": {
    "type": "list",
    "default": [],
    "description": "Flow markings for fair queuing tests"
  },
  "labels": {
    "type": "list",
    "default": [],
    "description": "Labels for data series flows"
  },
  "stream_delays": {
    "type": "list",
    "default": [],
    "description": "Per-stream delays in seconds"
  },
  "upload_streams": {
    "type": "number",
    "default": 4,
    "description": "Number of upload streams"
  },
  "download_streams": {
    "type": "number",
    "default": 4,
    "description": "Number of download streams"
  },
  "bidir_streams": {
    "type": "number",
    "default": 8,
    "description": "Number of bidirectional streams"
  },
  "tcp_cong_control": {
    "type": "string",
    "default": "",
    "description": "TCP congestion control algorithm(s) (single value or 'up,down')"
  },
  "udp_bandwidth": {
    "type": "string",
    "default": "100M",
    "description": "UDP bandwidth per stream (e.g., '20M')"
  },
  "udp_bandwidths": {
    "type": "list",
    "default": [],
    "description": "Per-stream UDP bandwidths"
  },
  "udp_pktsize": {
    "type": "number",
    "default": 1024,
    "description": "UDP packet size in bytes"
  },
  "udp_pktsizes": {
    "type": "list",
    "default": [],
    "description": "Per-stream UDP packet sizes"
  },
  "burst_length": {
    "type": "number",
    "default": 10,
    "description": "Packet burst length in seconds"
  },
  "burst_ports": {
    "type": "number",
    "default": 1,
    "description": "Number of ports for packet bursts"
  },
  "burst_psize": {
    "type": "number",
    "default": 64,
    "description": "Packet burst size in bytes"
  },
  "burst_tos": {
    "type": "number",
    "default": 0,
    "description": "TOS value for packet bursts"
  },
  "label_x": {
    "type": "string",
    "default": "",
    "description": "X-axis label override"
  },
  "label_y": {
    "type": "string",
    "default": "",
    "description": "Y-axis label override"
  },
  "invert_latency_y": {
    "type": "bool",
    "default": false,
    "description": "Invert latency Y axis"
  },
  "zero_y": {
    "type": "bool",
    "default": false,
    "description": "Force Y axis start at zero"
  },
  "log_scale": {
    "type": "string",
    "default": "",
    "description": "Logarithmic scale mode ('log2' or 'log10')",
    "enum": [
      "log2",
      "log10"
    ]
  },
  "norm_factor": {
    "type": "string",
    "default": "",
    "description": "Data normalization factor"
  },
  "bounds_x": {
    "type": "string",
    "default": "",
    "description": "X-axis bounds (e.g., '0,100' or '100' for upper)"
  },
  "bounds_y": {
    "type": "string",
    "default": "",
    "description": "Y-axis bounds"
  },
  "figure_width": {
    "type": "number",
    "default": 10,
    "description": "Figure width in inches"
  },
  "figure_height": {
    "type": "number",
    "default": 6,
    "description": "Figure height in inches"
  },
  "figure_dpi": {
    "type": "number",
    "default": 100,
    "description": "Figure DPI"
  },
  "legend_placement": {
    "type": "string",
    "default": "best",
    "description": "Legend placement ('best', 'upper right', etc.)",
    "enum": [
      "best",
      "upper left",
      "lower left",
      "lower right",
      "right",
      "center left",
      "center right",
      "lower center",
      "upper center",
      "center"
    ]
  },
  "legend_columns": {
    "type": "number",
    "default": 1,
    "description": "Number of columns in legend"
  },
  "legend_title": {
    "type": "string",
    "default": "",
    "description": "Legend title override"
  },
  "override_title": {
    "type": "string",
    "default": "",
    "description": "Plot title override"
  },
  "colours": {
    "type": "string",
    "default": "",
    "description": "Comma-separated colours for plot (e.g., '#1f77b4,#ff7f0e')"
  },
  "batch_name": {
    "type": "string",
    "default": "",
    "description": "Batch name (used with --batch-name)"
  },
  "batch_title": {
    "type": "string",
    "default": "",
    "description": "Batch title override"
  },
  "repetitions": {
    "type": "number",
    "default": 1,
    "description": "Number of batch repetitions"
  },
  "batch_resume": {
    "type": "string",
    "default": "",
    "description": "Resume directory for batch continuation"
  }
}
