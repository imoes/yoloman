[global]
# Server name (NetBIOS name) displayed to clients
netbios name = {{ netbios_name }}

# Workgroup name (must match Windows workgroup/domain)
workgroup = {{ workgroup }}

# SMB protocol version(s) to support (e.g., 2.1, 3.0, 3.1.1)
smb ports = {{ smb_ports | join(', ') }}

# Enable/disable SMB signing (security hardening)
server signing = {{ server_signing | lower }}

# Maximum concurrent connections
max connections = {{ max_connections }}

# Log level: 0 (none) to 10 (verbose)
log level = {{ log_level }}

# Path to log file (empty string disables logging to file)
{% if log_file %}
log file = {{ log_file }}
{% endif %}

# Time server behavior (NTP or time offset synchronization)
time server = {{ time_server | lower }}

# Enable/disable Unix extensions (required for Linux/macOS clients)
unix extensions = {{ unix_extensions | lower }}

# Enable/disable Winbind integration for AD auth
{% if winbind_domain %}
winbind domain = {{ winbind_domain }}
{% endif %}
{% if winbind_separator %}
winbind separator = {{ winbind_separator }}
{% endif %}
{% if winbind_enum_users %}
winbind enum users = {{ winbind_enum_users | lower }}
{% endif %}
{% if winbind_enum_groups %}
winbind enum groups = {{ winbind_enum_groups | lower }}
{% endif %}

# Default file permissions for new files/dirs
{% if default_file_permission %}
default file permission = {{ default_file_permission }}
{% endif %}
{% if default_directory_permission %}
default directory permission = {{ default_directory_permission }}
{% endif %}
{% if inherit_permissions %}
inherit permissions = {{ inherit_permissions | lower }}
{% endif %}
{% if inherit owner %}
inherit owner = {{ inherit_owner | lower }}
{% endif %}

# Idle timeout in milliseconds
{% if client idle timeout %}
client idle timeout = {{ client_idle_timeout }}
{% endif %}

{% for share in shares %}
[{{ share.name }}]
# {{ share.comment | default('Shared directory') }}
path = {{ share.path }}
read only = {{ share.read_only | lower }}
{% if share.guest_ok %}
guest ok = {{ share.guest_ok | lower }}
{% endif %}
{% if share.valid_users %}
valid users = {{ share.valid_users | join(', ') }}
{% endif %}
{% if share.write_list %}
write list = {{ share.write_list | join(', ') }}
{% endif %}
{% if share.force_user %}
force user = {{ share.force_user }}
{% endif %}
{% if share.force_group %}
force group = {{ share.force_group }}
{% endif %}
{% if share.create_mask %}
create mask = {{ share.create_mask }}
{% endif %}
{% if share.directory_mask %}
directory mask = {{ share.directory_mask }}
{% endif %}
{% if share.browsable %}
browsable = {{ share.browsable | lower }}
{% endif %}
{% if share.printable %}
printable = {{ share.printable | lower }}
{% endif %}
{% if share.hide_files %}
hide files = {{ share.hide_files | join(' / ') }}
{% endif %}
{% endfor %}

