{
  "lease_file": "/var/lib/dhcp/dhcpd.leases",
  "html_output_dir": "/var/www/dhcpd-pools/reports",
  "csv_output_dir": "/var/lib/dhcpd-pools/csv",
  "json_output_dir": "/var/lib/dhcpd-pools/json",
  "report_date_format": "%Y-%m-%d %H:%M:%S",
  "recent_days": 7,
  "stale_days": 30,
  "detailed_subnets": true,
  "exclude_subnets": [
    "10.255.0.0/24"
  ],
  "include_subnets": [],
  "thresholds": {
    "pool_warn_pct": 85,
    "pool_crit_pct": 95,
    "stale_warn_count": 5,
    "stale_crit_count": 20,
    "active_warn_count": 800,
    "active_crit_count": 1500
  },
  "reports": {
    "pool_stats": true,
    "class_stats": true,
    "host_reservations": true,
    "mac_vendor_lookup": false,
    "time_series": false
  }
}
