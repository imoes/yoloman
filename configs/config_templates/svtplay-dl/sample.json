{
  "output": "/var/lib/svtplay-dl/videos",
  "filename": "{title}.{id}.{ext}",
  "subfolder": true,
  "force": false,
  "live": false,
  "capture_time": 60,
  "silent": false,
  "silent_semi": false,
  "username": "user@example.com",
  "password": "supersecretpassword",
  "token": "",
  "thumbnail": true,
  "get_url": false,
  "dont_verify_ssl_cert": false,
  "http_header": "User-Agent=Mozilla/5.0;Accept-Language=sv-SE",
  "cookies": "session=abc123; auth=xyz789",
  "exclude": [
    "trailer",
    "promo"
  ],
  "after_date": "2023-01-01",
  "proxy": "http://127.0.0.1:8080",
  "verbose": true,
  "nfo": true,
  "force_nfo": false,
  "only_audio": false,
  "only_video": false,
  "quality": 5000,
  "flexible_quality": 1000,
  "preferred": "hls",
  "stream_priority": [
    "dash",
    "hls",
    "http"
  ],
  "format_preferred": [
    "h264"
  ],
  "audio_language": "sv",
  "video_role": "",
  "resolution": [
    1080
  ],
  "subtitle": true,
  "merge_subtitle": true,
  "force_subtitle": false,
  "require_subtitle": true,
  "all_subtitles": false,
  "raw_subtitles": false,
  "convert_subtitle_colors": false,
  "all_episodes": false,
  "all_last": 5,
  "include_clips": false,
  "reverse": false,
  "cmore_operator": "tele2",
  "no_remux": false,
  "no_merge": false,
  "no_postprocess": false,
  "keep_original": false,
  "output_format": "mkv"
}
