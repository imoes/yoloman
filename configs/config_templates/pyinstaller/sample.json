{
  "script_name": "myapp.py",
  "dist_path": "./output",
  "work_path": "./tmp_build",
  "app_name": "MyApp",
  "spec_path": ".",
  "log_level": "DEBUG",
  "onefile_mode": true,
  "upx_dir": "/usr/bin/upx",
  "clean_build": true,
  "add_data": [
    {
      "src": "config.json",
      "dest": "."
    },
    {
      "src": "assets/images",
      "dest": "assets"
    }
  ],
  "add_data_items": {
    "src": {
      "type": "string",
      "default": "",
      "description": "Source path"
    },
    "dest": {
      "type": "string",
      "default": "",
      "description": "Destination directory within bundle"
    }
  },
  "add_binaries": [
    {
      "src": "libnative.so",
      "dest": "."
    }
  ],
  "add_binary_items": {
    "src": {
      "type": "string",
      "default": "",
      "description": "Source path"
    },
    "dest": {
      "type": "string",
      "default": "",
      "description": "Destination directory within bundle"
    }
  },
  "import_paths": [
    "/opt/custom/libs",
    "/home/user/my_packages"
  ],
  "hidden_imports": [
    "xml.etree.ElementTree",
    "yaml"
  ],
  "collect_submodules": [
    "pandas",
    "sklearn"
  ],
  "collect_data": [
    "matplotlib"
  ],
  "collect_binaries": [
    "numpy"
  ],
  "collect_all": [
    "tensorflow"
  ],
  "copy_metadata": [
    "requests"
  ],
  "recursive_copy_metadata": [
    "flask"
  ],
  "hooks_dirs": [
    "/home/user/hooks"
  ],
  "runtime_hooks": [
    "/home/user/runtime_setup.py"
  ],
  "excludes": [
    "tkinter",
    "turtule"
  ],
  "optimize_level": 1,
  "python_options": [
    "W ignore"
  ],
  "strip_symbols": false,
  "no_upx": false,
  "upx_excludes": [
    "libcrypto.so"
  ],
  "windowed_mode": false,
  "icon_path": "./icon.ico",
  "debug_options": [
    "imports",
    "bootloader"
  ],
  "splash_file": "./splash.png",
  "osx_bundle_identifier": "com.example.myapp",
  "codesign_identity": "Developer ID Application: Example Inc (ABCD1234)"
}
