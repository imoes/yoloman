#!/bin/sh -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.

# The directory containing scripts to run at boot time via run-parts.
{% if rc_boot_directory | default('/etc/boot.d') is defined %}
if test -d {{ rc_boot_directory | default('/etc/boot.d') }} ; then
	run-parts {{ rc_boot_directory | default('/etc/boot.d') }}
fi
{% else %}
if test -d /etc/boot.d ; then
	run-parts /etc/boot.d
fi
{% endif %}