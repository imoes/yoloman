{
  "active": true,
  "log_file": "/var/log/audit/audit.log",
  "log_format": "raw",
  "max_log_file": 6,
  "max_log_file_action": "rotate",
  "space_left": 75,
  "space_left_action": "email",
  "use_syslog": true,
  "verbosity": 2,
  "priority_boost": 4,
  "flush": "incremental",
  "freq": 50,
  "max_retries": 3,
  "retry_timeout": 1,
  "log_group": "audit",
  "remote_log": false,
  "remote_address": "",
  "remote_port": 60,
  "local_logging": true,
  "queue_len": 0,
  "admin_space_left": 25,
  "admin_space_left_action": "single",
  "disk_full_action": "suspend",
  "pause": 0,
  "resume_after": 30,
  "capability": 0,
  "args": "-w /etc/passwd -p rwxa",
  "extra_logs": [
    {
      "path": "/var/log/audit/audit-aux.log"
    }
  ]
}
