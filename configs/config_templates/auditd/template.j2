# Default: False
# If true, remote_address and remote_port should be configured.
{% if remote_log | default(False) | bool %}
# Remote logging is ENABLED.
# Transport is set to TCP above.

# Hostname or IP of the remote audit server.
# Required if remote_log is true.
# Default: '' (empty)
