#
# This file controls the configuration of the audit daemon.
# It is auto-generated by Ansible and should not be edited by hand.
# See the auditd.conf(5) man page for detailed documentation.
#

# Enable local events recording
local_events = yes

# Enable writing of audit records to the log file
write_logs = yes

# Full path to the primary audit log file.
# Default: /var/log/audit/audit.log
log_file = {{ log_file | default('/var/log/audit/audit.log') }}

# Name of the log file group (affects permissions).
# Default: adm
log_group = {{ log_group | default('adm') }}

# Format of audit logs.
# Allowed values: ENRICHED, raw, inc.
# Default: ENRICHED
log_format = {{ log_format | default('ENRICHED') }}

# Flushing strategy.
# Default: INCREMENTAL_ASYNC
flush = INCREMENTAL_ASYNC

# Number of records to buffer before flushing.
# Used only in 'incremental' mode.
# Default: 50
freq = {{ freq | default(50) }}

# Maximum number of audit log files to retain after rotation.
# Default: 8
max_log_file = {{ max_log_file | default(8) }}

# Fixed value for this role.
num_logs = 5

# Priority to boost syslog messages.
# 0 = no boost, higher = higher priority.
# Default: 4
priority_boost = {{ priority_boost | default(4) }}

# Fixed value for this role.
name_format = NONE
##name = mydomain

# Action to take when log file rotation is needed.
# Fixed value for this role.
max_log_file_action = ROTATE

# Disk space (in MB) remaining before space_left_action is triggered.
# Default: 75
space_left = {{ space_left | default(75) }}

# Action to take when free disk space drops below space_left.
# Allowed values: SYSLOG, email, suspend, single, halt, none.
# Default: SYSLOG
space_left_action = {{ space_left_action | default('SYSLOG') }}

# Verify the email address configuration.
# Fixed value for this role.
verify_email = yes

# Email address for notifications.
# Fixed value for this role.
action_mail_acct = root

# Disk space (in MB) remaining before admin_space_left_action is triggered.
# Fixed value for this role.
admin_space_left = 50

# Action to take when admin disk space is low.
# Fixed value for this role.
admin_space_left_action = SUSPEND

# Action to take when disk is full.
# Fixed value for this role.
disk_full_action = SUSPEND

# Action to take when a disk error occurs.
# Fixed value for this role.
disk_error_action = SUSPEND

# Use libwrap for network access control.
# Fixed value for this role.
use_libwrap = yes
##tcp_listen_port = 60

# TCP listen queue size.
# Fixed value for this role.
tcp_listen_queue = 5

# Maximum number of connections per address.
# Fixed value for this role.
tcp_max_per_addr = 1
##tcp_client_ports = 1024-65535

# TCP client max idle time.
# Fixed value for this role.
tcp_client_max_idle = 0

# Transport protocol for remote logging.
# Fixed value for this role.
transport = TCP

# Kerberos 5 principal.
# Fixed value for this role.
krb5_principal = auditd
##krb5_key_file = /etc/audit/audit.key

# Distribute network connections.
# Fixed value for this role.
distribute_network = no

# Queue depth.
# Fixed value for this role.
q_depth = 2000

# Action to take on overflow.
# Fixed value for this role.
overflow_action = SYSLOG

# Maximum number of log file restarts.
# Fixed value for this role.
max_restarts = 10

# Directory for audit plugins.
# Fixed value for this role.
plugin_dir = /etc/audit/plugins.d

# Timeout for end of event processing.
# Fixed value for this role.
end_of_event_timeout = 2

# --- Remote Logging Configuration ---

