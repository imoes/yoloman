# Sudoers entry for laniakea-spark service.
# Allows the 'lkspark' user to execute the specified command without a password.
# This is required for the Spark daemon to perform privileged operations (e.g., binding to low ports or accessing specific resources) as defined by the application's security model.
_lkspark ALL=(ALL) NOPASSWD: {{ command_path | default('/usr/bin/debspawn') }}
