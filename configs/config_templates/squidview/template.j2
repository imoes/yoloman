# Squidview Configuration File
# Self-documented: every field includes its schema description as a comment above the directive.
# Generated by Jinja2 for squidview service configuration.

# Full path to the squid access.log file that squidview will monitor.
log_path: {{ log_path | default('/var/log/squid/access.log') }}

# Time in seconds between each refresh of the log display in the ncurses UI.
refresh_interval: {{ refresh_interval | default(5) }}

# Maximum number of log lines to keep in the local history buffer for scrolling.
history_lines: {{ history_lines | default(500) }}

# Color theme applied to the ncurses interface (e.g., dark, light).
color_theme: {{ color_theme | default('dark') }}

# If true, sorts log entries by timestamp in ascending order; if false, descending.
sort_ascending: {{ sort_ascending | default(false) | lower }}

# List of HTTP status codes to include in the view. Empty list means no filtering.
# Example value: [200, 404, 500]
status_codes_filter: {{ status_codes_filter | default([]) }}

# System user to switch to for reading the log file if permissions require it.
# Empty string means run as the current user.
run_user: {{ run_user | default('') }}