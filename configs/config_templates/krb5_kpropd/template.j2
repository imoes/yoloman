# kpropd.acl — ACL for Kerberos KDC propagation daemon (kpropd)
# Each line grants principal permissions to push or sync KDC database changes.
# Format: principal [permissions]
# Permissions are optional; default is full read/write (for slaves: typically 'r' for read-only sync)
{% for entry in acl_entries %}{{ entry.principal }}{% if entry.permissions is defined %} {{ entry.permissions }}{% endif %}
{% endfor %}