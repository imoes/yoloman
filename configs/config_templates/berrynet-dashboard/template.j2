# Configuration for the berrynet-dashboard web alias
# This template generates an Apache/Nginx configuration snippet to serve the
# berrynet-dashboard application files.

# Document root path for the berrynet-dashboard alias.
# Specifies the directory on the filesystem where the dashboard's HTML/JS/CSS files reside.
# Default: /usr/share/berrynet/dashboard
Alias /berrynet-dashboard {{ berrynet_dashboard_alias_path | default('/usr/share/berrynet/dashboard') }}
