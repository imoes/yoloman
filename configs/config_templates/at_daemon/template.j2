# /etc/at.allow: List of usernames allowed to submit jobs with 'at'
# If both /etc/at.allow and /etc/at.deny exist, only /etc/at.allow is consulted (atd behavior)
{% for user in allow_users %}{{ user }}
{% endfor %}

# /etc/at.deny: List of usernames denied from submitting jobs with 'at'
# Only used if /etc/at.allow does NOT exist
{% if not allow_users %}
{% for user in deny_users %}{{ user }}
{% endfor %}
{% endif %}