# Kupfer Configuration Environment Variables
# This file is sourced by the desktop entry or wrapper script to configure
# the Kupfer application behavior via environment variables.
#
# Each variable maps to a field under the `kupfer` dict in the Ansible
# inventory/host vars. If `kupfer` is not defined, safe defaults are used.

# no_custom_plugins: Set to true to only allow loading built-in plugins
# installed in the program's python package. Prevents loading of custom
# plugins from ~/.local/share/kupfer/plugins or XDG_DATA_DIRS.
KUPFER_NO_CUSTOM_PLUGINS={{ (kupfer | default({})).no_custom_plugins | default(false) | lower }}

# no_cache: Set to true to prevent loading from or writing to any source cache files.
KUPFER_NO_CACHE={{ (kupfer | default({})).no_cache | default(false) | lower }}

# no_keybinder: Set to true to disable Keybinder even if it is installed.
KUPFER_NO_KEYBINDER={{ (kupfer | default({})).no_keybinder | default(false) | lower }}

# gdk_backend: Sets the GDK_BACKEND environment variable.
# Set to 'x11' to fix window position problems on Wayland.
# Default is empty, letting GTK decide the best backend.
GDK_BACKEND={{ (kupfer | default({})).gdk_backend | default('') }}

# no_splash: Set to true to launch Kupfer without presenting the main interface.
KUPFER_NO_SPLASH={{ (kupfer | default({})).no_splash | default(false) | lower }}

# debug: Set to true to enable more verbose output for debugging operation.
KUPFER_DEBUG={{ (kupfer | default({})).debug | default(false) | lower }}