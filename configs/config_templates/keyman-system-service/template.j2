# Keyman System Service Configuration
# This file configures the Keyman system service, which manages keyboard layouts and input methods.
# It is primarily controlled by the system package and does not typically require complex network
# or external dependency configuration.

# Base directory for Keyman data and configuration
# Default: /opt/keyman
keyman_base_dir = {{ keyman_base_dir | default('/opt/keyman') }}

# Log file path for the Keyman daemon
# Default: /var/log/keyman/keyman.log
log_file = {{ log_file | default('/var/log/keyman/keyman.log') }}

# Debug mode: enables verbose logging to the log file
# Default: false
debug_mode = {{ debug_mode | default(false) }}

# Enable the Keyman system service daemon
# Default: true
enabled = {{ enabled | default(true) }}

# User to run the Keyman service as (if not running as root)
# Default: keyman
service_user = {{ service_user | default('keyman') }}

# Group to run the Keyman service as (if not running as root)
# Default: keyman
service_group = {{ service_group | default('keyman') }}