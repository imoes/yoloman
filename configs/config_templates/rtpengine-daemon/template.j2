# Path to the rtpengine configuration file.
CONFIG_FILE={{ config_file | default('/etc/rtpengine/rtpengine.conf') }}

# PID file path for the rtpengine daemon.
PIDFILE={{ pidfile | default('/run/rtpengine/rtpengine-daemon.pid') }}

# Whether rtpengine should manage iptables rules automatically.
MANAGE_IPTABLES={{ manage_iptables | default(True) | lower }}

# The user under which the rtpengine process should run.
SET_USER={{ set_user | default('rtpengine') }}

# The umask value for the rtpengine process.
SET_MASK={{ set_mask | default(0) }}