{
  "nginx_listen_port": {
    "type": "number",
    "default": 80,
    "description": "Port for HTTP listener"
  },
  "nginx_server_name": {
    "type": "string",
    "default": null,
    "description": "Server hostname for virtual host"
  },
  "nginx_ssl_port": {
    "type": "number",
    "default": 443,
    "description": "Port for HTTPS listener"
  },
  "nginx_ssl_certificate_path": {
    "type": "string",
    "default": null,
    "description": "Path to SSL certificate file"
  },
  "nginx_ssl_certificate_key_path": {
    "type": "string",
    "default": null,
    "description": "Path to SSL private key file"
  }
}
