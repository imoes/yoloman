#!/bin/bash
# Wrapper script for unalz to support configurable default options.
# This script is generated by configuration management; edit via service configuration variables.
#
# unalz usage summary (for reference):
#   -d DIR    Set the output directory for extracted files.
#   -utf8     Convert filenames to UTF-8 (default behavior).
#   -pwd PWD  Set password for encrypted ALZ archives.
#
# Variables:
#   ALZ_OUTPUT_DIR   : Directory where archive contents should be extracted.
#                      Defaults to '.' (current directory) if not specified.
#   ALZ_PASSWORD     : Password for encrypted ALZ archives. Leave empty if not required.
#   ALZ_ARCHIVE      : Path to the ALZ archive file to process.

# --- Configuration Defaults ---

# The directory where archive contents should be extracted.
# Defaults to '.' (current directory) if empty or '.'.
ALZ_OUTPUT_DIR={{ output_dir | default('.') }}

# Password for encrypted ALZ archives. Leave empty if not required.
ALZ_PASSWORD={{ password | default('') }}

# Path to the ALZ archive file to process.
ALZ_ARCHIVE={{ archive_path | default('archive.alz') }}

# --- Command Argument Construction ---

# Initialize argument array
ARGS=()

# If output directory is not the default '.', pass it to unalz.
if [ "${ALZ_OUTPUT_DIR}" != "." ]; then
    ARGS+=("-d" "${ALZ_OUTPUT_DIR}")
fi

# If a password is provided, pass it to unalz.
if [ -n "${ALZ_PASSWORD}" ]; then
    ARGS+=("-pwd" "${ALZ_PASSWORD}")
fi

# Note: UTF-8 is the default behavior of unalz, so no flag is needed unless overriding.
# If you wish to explicitly set UTF-8, uncomment the following line:
# ARGS+=('-utf8')

# --- Execution ---

# Execute unalz with the constructed arguments and the archive path.
exec unalz "${ARGS[@]}" "${ALZ_ARCHIVE}"