# Mutt Profile Manager Configuration
# This file configures the mutt-profile-manager tool (or similar wrapper)
# which manages symbolic links to mutt configuration directories.

# The directory where Mutt profile files are stored.
# Defaults to the user's home directory under .mutt.
set mutt_profile_dir = {{ mutt_dir | default("~/.mutt", true) }}

# The filename for the symbolic link that points to the currently active profile.
# This link is typically placed in the mutt_profile_dir or home directory
# and points to the actual profile directory file.
set mutt_profile_symlink = {{ symlink_name | default("profile.active", true) }}

# A Perl-compatible regular expression to filter which files in the mutt_dir
# are considered valid profiles. Only files matching this pattern will be
# listed or selectable by the profile management tool.
set mutt_profile_regex = {{ profile_regex | default(".*.mutt", true) }}