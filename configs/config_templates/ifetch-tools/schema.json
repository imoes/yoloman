{
  "name": {
    "type": "string",
    "default": "ifetch-tools",
    "description": "The name of the service/daemon."
  },
  "desc": {
    "type": "string",
    "default": "ifetch-tools",
    "description": "The description of the service."
  },
  "uid": {
    "type": "string",
    "default": "ifetch-tools",
    "description": "The user account under which the daemon runs."
  },
  "logdir": {
    "type": "string",
    "default": "/var/log/ifetch-tools",
    "description": "The directory where logs are stored."
  },
  "dodtime": {
    "type": "number",
    "default": 5,
    "description": "Time to wait for the server to die, in seconds."
  }
}
