# Configuration file for logrotate of ifetch-tools
# Generated by Ansible Jinja2 template.

# Directory where logs are stored.
# Default: ifetch-tools
/var/log/{{ logdir | default('ifetch-tools') }}/wwwifetch*.txt
{
	# File permissions for rotated logs
	# Default: 640
	create {{ (create | default(640)) | int }} root adm

	# Rotate logs weekly
	# Default: True (directive presence implies true)
	weekly

	# Do not error out if the log file is missing
	# Default: True
	missingok

	# Number of rotated logs to keep before discarding
	# Default: 10
	rotate {{ (rotate | default(10)) | int }}

	# Compress old log files using gzip
	# Default: True
	compress

	# Delay compression of the most recent rotated log file
	# Default: True
	delaycompress

	# Do not rotate if the log file is empty
	# Default: True
	notifempty

	# Run all scripts in the block after all logs are rotated
	# Default: True
	sharedscripts

	# Copy the log file and then truncate the original
	# Prevents issues with applications holding file descriptors
	# Default: True
	copytruncate
}
