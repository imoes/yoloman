{
  "listen_port": 1130,
  "bind_host": "127.0.0.1",
  "enabled": true,
  "max_connections": 100,
  "mail_spool_dir": "/var/spool/mail",
  "exec_cmd": "/usr/bin/mailnotify %s",
  "allowed_senders": [
    "example.com",
    "trusted.net"
  ],
  "user_overrides": [
    {
      "user": "admin",
      "exec_cmd": "/usr/local/bin/admin-mailhook %s"
    }
  ],
  "log_level": 2,
  "log_file": "/var/log/mailutils/comsatd.log"
}
