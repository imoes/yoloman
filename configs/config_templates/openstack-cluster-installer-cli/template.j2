{#
  openstack-cluster-installer-cli configuration template.
  Self-documenting: every field is commented with its schema description.
  All variables use | default(...) with the schema-provided default values.
  This file is a JSON manifest of OpenStack cluster installer settings.
#}
{# --- Section: machines --- #}
{# Top-level object container for machine-specific settings. #}
{# Note: In a real Ansible role, this template would likely render into a YAML or INI file.
     However, to preserve the exact directive names/paths the software expects (as per schema),
     we output valid JSON structure with Jinja2 variable resolution. #}
"machines": {
  {# Swift num object server per port: #}
  "servers_per_port": {
    {# Type constraint: integer. #}
    "type": "int",
    {# Default value: 1. #}
    "default": "{{ (servers_per_port_default | default('1')) }}",
    {# Description from schema. #}
    "description": "Swift num object server per port:",
    {# Roles list. #}
    "roles": [ "swiftstore", "swiftproxy" ]
  },
  {# Swift object network chunk size: #}
  "network_chunk_size": {
    "type": "int",
    "default": "{{ (network_chunk_size_default | default('65535')) }}",
    "description": "Swift object network chunk size:",
    "roles": [ "swiftstore", "swiftproxy" ]
  },
  {# Swift object disk chunk size: #}
  "disk_chunk_size": {
    "type": "int",
    "default": "{{ (disk_chunk_size_default | default('524288')) }}",
    "description": "Swift object disk chunk size:",
    "roles": [ "swiftstore", "swiftproxy" ]
  },
  {# Cinder LVM backend name: #}
  "lvm_backend_name": {
    "type": "string",
    "default": "{{ (lvm_backend_name_default | default('LVM_1')) }}",
    "description": "Cinder LVM backend name:",
    "roles": [ "volume" ]
  },
  {# Cinder Availability zone: #}
  "availability_zone": {
    "type": "string",
    "default": "{{ (availability_zone_default | default('nova')) }}",
    "description": "Cinder Availability zone:",
    "roles": [ "volume", "compute" ]
  },
  {# Configure dkms: #}
  "configure_dkms": {
    "type": "boolean",
    "default": "{{ (configure_dkms_default | default('no')) }}",
    "description": "Configure dkms:",
    "roles": [ "cephmon", "cephosd", "compute", "controller", "messaging", "network", "sql", "volume" ]
  },
  {# Cinder volume copy BPS limit: #}
  "volume_copy_bps_limit": {
    "type": "int",
    "default": "{{ (volume_copy_bps_limit_default | default('1073741824')) }}",
    "description": "Cinder volume copy BPS limit:",
    "roles": [ "volume" ]
  },
  {# Cinder percentage of backend capacity is reserved: #}
  "cinder_reserved_percentage": {
    "type": "int",
    "default": "{{ (cinder_reserved_percentage_default | default('10')) }}",
    "description": "Cinder percentage of backend capacity is reserved:",
    "roles": [ "volume" ]
  },
  {# Cinder over subscription ratio when thin provisioning is enabled: #}
  "cinder_max_over_subscription_ratio": {
    "type": "float",
    "default": "{{ (cinder_max_over_subscription_ratio_default | default('4.0')) }}",
    "description": "Cinder over subscription ratio when thin provisioning is enabled:",
    "roles": [ "volume" ]
  },
  {# Cinder enabled backends override: #}
  "cinder_enabled_backends": {
    "type": "string",
    "default": "{{ (cinder_enabled_backends_default | default('no-override')) }}",
    "description": "Cinder enabled backends override:",
    "roles": [ "volume" ]
  },
  {# Cinder separate volume groups: #}
  "cinder_separate_volume_groups": {
    "type": "boolean",
    "default": "{{ (cinder_separate_volume_groups_default | default('no')) }}",
    "description": "Cinder separate volume groups:",
    "roles": [ "volume" ]
  },
  {# Cinder default storage AZ: #}
  "cinder_default_storage_availability_zone": {
    "type": "string",
    "default": "{{ (cinder_default_storage_availability_zone_default | default('nova')) }}",
    "description": "Cinder default storage AZ:",
    "roles": [ "controller" ]
  },
  {# Nova virtual CPU to physical CPU allocation ratio: #}
  "cpu_allocation_ratio": {
    "type": "float",
    "default": "{{ (cpu_allocation_ratio_default | default('2.0')) }}",
    "description": "Nova virtual CPU to physical CPU allocation ratio:",
    "roles": [ "compute" ]
  },
  {# Nova virtual ram to physical ram allocation ratio: #}
  "ram_allocation_ratio": {
    "type": "float",
    "default": "{{ (ram_allocation_ratio_default | default('1.0')) }}",
    "description": "Nova virtual ram to physical ram allocation ratio:",
    "roles": [ "compute" ]
  },
  {# Nova virtual disk to physical disk allocation ratio: #}
  "disk_allocation_ratio": {
    "type": "float",
    "default": "{{ (disk_allocation_ratio_default | default('1.0')) }}",
    "description": "Nova virtual disk to physical disk allocation ratio:",
    "roles": [ "compute" ]
  },
  {# Compute is cephosd: #}
  "compute_is_cephosd": {
    "type": "boolean",
    "default": "{{ (compute_is_cephosd_default | default('no')) }}",
