    "roles": [ "compute" ]
  },
  {# Nova default schedule zone: #}
  "nova_default_schedule_zone": {
    "type": "string",
    "default": "{{ (nova_default_schedule_zone_default | default('none')) }}",
    "description": "Nova default schedule zone:",
    "roles": [ "controller" ]
  },
  {# Nova number of PCIe ports an instance will get #}
  "nova_num_pcie_ports": {
    "type": "int",
    "default": "{{ (nova_num_pcie_ports_default | default('16')) }}",
    "description": "Nova number of PCIe ports an instance will get",
    "roles": [ "compute" ]
  },
  {# Manila share install: #}
  "manila_share_install": {
    "type": "boolean",
    "default": "{{ (manila_share_install_default | default('no')) }}",
    "description": "Manila share install:",
    "roles": [ "compute" ]
  },
  {# Kernel from backports: #}
  "kernel_from_backports": {
    "type": "boolean",
    "default": "{{ (kernel_from_backports_default | default('no')) }}",
    "description": "Kernel from backports:",
    "roles": [ "all" ]
  },
  {# brex MAC address: #}
  "brex_macaddr": {
    "type": "string",
    "default": "{{ (brex_macaddr_default | default('none')) }}",
    "description": "brex MAC address:",
    "roles": [ "controller", "compute", "network" ]
  },
  {# Swift rsync IO limit: #}
  "swift_rsync_io_limit_activate": {
    "type": "boolean",
    "default": "{{ (swift_rsync_io_limit_activate_default | default('no')) }}",
    "description": "Swift rsync IO limit:",
    "roles": [ "swiftstore", "swiftproxy" ]
  },
  {# Swift rsync I/O limit value in MB: #}
  "swift_rsync_io_limit_megabytes": {
    "type": "int",
    "default": "{{ (swift_rsync_io_limit_megabytes_default | default('80')) }}",
    "description": "Swift rsync I/O limit value in MB:",
    "roles": [ "swiftstore", "swiftproxy" ]
  },
  {# Swift rsync I/O max iops: #}
  "swift_rsync_io_limit_iops": {
    "type": "int",
    "default": "{{ (swift_rsync_io_limit_iops_default | default('100')) }}",
    "description": "Swift rsync I/O max iops:",
    "roles": [ "swiftstore", "swiftproxy" ]
  },
  {# Swift override cluster reserved space: #}
  "swift_override_cluster_reserved_space": {
    "type": "boolean",
    "default": "{{ (swift_override_cluster_reserved_space_default | default('no')) }}",
    "description": "Swift override cluster reserved space:",
    "roles": [ "swiftstore", "swiftproxy" ]
  },
  {# Swift storage reserved space in GiB (stops incomming rsync): #}
  "swift_storage_reserved_space": {
    "type": "int",
    "default": "{{ (swift_storage_reserved_space_default | default('500')) }}",
    "description": "Swift storage reserved space in GiB (stops incomming rsync):",
    "roles": [ "swiftstore", "swiftproxy" ]
  },
  {# Swift storage fallocate reserved space in GiB (stop PUTs): #}
  "swift_storage_fallocate_reserved_space": {
    "type": "int",
    "default": "{{ (swift_storage_fallocate_reserved_space_default | default('300')) }}",
    "description": "Swift storage fallocate reserved space in GiB (stop PUTs):",
    "roles": [ "swiftstore", "swiftproxy" ]
