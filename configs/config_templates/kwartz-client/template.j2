# Configuration file for Kwartz-cloud
# this file should not be edited manually
# Please rather launch `dpkg-reconfigure kwartz-client`
# The last questions in the configuration dialog are useful
# to change the settings here.

# The primary server hostname or IP address for the Kwartz cloud service.
SERVER_IP={{ server_ip | default('kwartz.lyceejeanbart.fr') }}

# An alternative server hostname or IP address for the Kwartz cloud service.
ALT_IP={{ alt_ip | default('serveur.lycee.jb') }}

# The TLS port used for connecting to the Kwartz cloud service.
TLS_PORT={{ tls_port | default(8443) }}

# The WebDAV path suffix for the cloud storage service.
DAVPATH={{ davpath | default('owncloud/remote.php/webdav') }}