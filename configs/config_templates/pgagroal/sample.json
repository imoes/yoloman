{
  "host": "0.0.0.0",
  "port": 5432,
  "unix_socket_dir": "/var/run/pgagroal",
  "max_connections": 200,
  "min_connections": 10,
  "idle_timeout": 300,
  "auth_type": "scram-sha-256",
  "auth_query": "SELECT usename, passwd FROM pg_catalog.pg_auth WHERE usename = $1",
  "log_type": "file",
  "log_file": "/var/log/pgagroal/pgagroal.log",
  "log_level": "info",
  "ssl": true,
  "ssl_cert": "/etc/pgagroal/ssl/server.crt",
  "ssl_key": "/etc/pgagroal/ssl/server.key",
  "ssl_ca": "/etc/pgagroal/ssl/ca.crt",
  "ssl_crl": "",
  "pool_mode": "transaction",
  "reserved_connections": 2,
  "query_timeout": 0,
  "query_wait_timeout": 120,
  "max_client_conn": 100,
  "log_connections": true,
  "log_disconnections": true,
  "log_server_messages": false,
  "servers": [
    {
      "name": "primary",
      "host": "pg-primary.internal",
      "port": 5432,
      "role": "master",
      "authentication": ""
    },
    {
      "name": "replica1",
      "host": "pg-replica1.internal",
      "port": 5432,
      "role": "replica",
      "authentication": ""
    }
  ],
  "users": [
    {
      "name": "app_user",
      "username": "appuser",
      "password": "md5abc123def456...",
      "database": "production",
      "sslmode": "prefer",
      "pool_size": 25
    }
  ],
  "pools": [
    {
      "name": "app_pool",
      "database": "production",
      "username": "appuser",
      "pool_size": 30,
      "reserve_pool_size": 5,
      "pool_mode": "transaction",
      "server": ""
    }
  ]
}
