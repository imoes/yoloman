#
# GFAL2 XROOTD Plugin Configuration
#
# This template configures the gfal2-plugin-xrootd, which provides file transfer capabilities
# using the XRootD storage protocol for the Globus File Access Library (GFAL2).
# It handles checksums and path normalization for XRootD URIs.
#

[XROOTD PLUGIN]

# Default checksum type for third party copies.
# Supported types depend on the compiled xrootd library (e.g., ADLER32, CRC32).
# Default: ADLER32
COPY_CHECKSUM_TYPE={{ COPY_CHECKSUM_TYPE | default('ADLER32') }}

# Whether to normalize paths by turning root://host/path into root://host//path.
# Some XRootD servers require this double-slash format for proper routing.
# Default: true
NORMALIZE_PATH={{ NORMALIZE_PATH | default(true) }}

# To pass any custom flag via URL to the xrootd library, any variable that starts with XRD. will be used
# (lowercase). Example: XRD.WANTPROT=unix,gsi,krb5
# XRD.WANTPROT=unix,gsi,krb5