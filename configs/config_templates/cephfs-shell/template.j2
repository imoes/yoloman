# ============================================================================
# CephFS Shell Configuration Template
# ============================================================================
# This template generates the configuration file for `cephfs-shell`, an interactive
# shell for CephFS. It controls the user interface behavior, including prompts,
# output formatting, and scripting aids.
# ============================================================================

[cephfs-shell]

# --------------------------------------------------------------------------
# Prompt string for the interactive shell
# The string displayed before each command input in the interactive mode.
# --------------------------------------------------------------------------
prompt = {{ prompt | default('CephFS:~/>>>') }}

# --------------------------------------------------------------------------
# Continuation prompt used for multi-line input
# The string displayed when the shell expects more input to complete a command
# (e.g., during a multi-line string or open parenthesis).
# --------------------------------------------------------------------------
continuation_prompt = {{ continuation_prompt | default('>') }}

# --------------------------------------------------------------------------
# Suppress command echo in batch mode
# When true, the shell will not print the command itself before executing it
# in batch/scripted mode.
# --------------------------------------------------------------------------
quiet = {{ quiet | default(false) | lower }}

# --------------------------------------------------------------------------
# Display elapsed time after command execution
# When true, shows the execution duration after each command completes.
# --------------------------------------------------------------------------
timing = {{ timing | default(false) | lower }}

# --------------------------------------------------------------------------
# Enable colored output
# Controls whether the shell uses ANSI color codes for output highlighting.
# --------------------------------------------------------------------------
colors = {{ colors | default(true) | lower }}

# --------------------------------------------------------------------------
# Enable debug output
# When true, enables verbose debug logging to stderr/console.
# --------------------------------------------------------------------------
debug = {{ debug | default(false) | lower }}

# --------------------------------------------------------------------------
# Enable command abbreviation
# Allows users to type the shortest unique prefix of a command name.
# --------------------------------------------------------------------------
abbrev = {{ abbrev | default(false) | lower }}

# --------------------------------------------------------------------------
# Automatically run edited script after edit command
# If true, after using the 'edit' command to modify a script buffer, the
# shell will automatically execute the modified script.
# --------------------------------------------------------------------------
autorun_on_edit = {{ autorun_on_edit | default(false) | lower }}

# --------------------------------------------------------------------------
# Echo commands in batch mode
# When true, prints the command line to stdout before executing it in batch
# mode (opposite of 'quiet' for specific batch contexts).
# --------------------------------------------------------------------------
echo = {{ echo | default(false) | lower }}

# --------------------------------------------------------------------------
# Default text editor to use with 'edit' command
# The external editor invoked when the user runs the 'edit' command.
# --------------------------------------------------------------------------
editor = {{ editor | default('vim') }}

# --------------------------------------------------------------------------
# Include command output in feedback
# When true, includes the command's stdout/stderr in the shell's internal
# feedback/logging mechanisms.
# --------------------------------------------------------------------------
feedback_to_output = {{ feedback_to_output | default(false) | lower }}

# --------------------------------------------------------------------------
# Allow local variables in 'py' and 'pyscript' commands
# Controls whether Python-based commands can use local variable assignments
# without polluting the global scope.
# --------------------------------------------------------------------------
locals_in_py = {{ locals_in_py | default(true) | lower }}