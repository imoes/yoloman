# =============================================================================
# GlusterFS Log Rotation Configuration
# =============================================================================
# This file configures logrotate for GlusterFS client and server logs.
# It controls how logs are rotated, compressed, and how many archives are kept.
# =============================================================================

# -----------------------------------------------------------------------------
# Client Log Rotation Rules
# -----------------------------------------------------------------------------
# Target: /var/log/glusterfs/*.log
# Applies to general client-side operation logs generated by glusterfs processes.
/var/log/glusterfs/*.log {
    # -----------------------------------------------------------------
    # Rotation Policy
    # -----------------------------------------------------------------
    # Rotate logs on a weekly basis.
    weekly

    # -----------------------------------------------------------------
    # Size-based Rotation Limits
    # -----------------------------------------------------------------
    # Maximum size of client logs before rotation occurs.
    # If the log exceeds this size, it will be rotated immediately
    # regardless of the time-based schedule.
    maxsize {{ maxsize_client | default('10M') }}

    # Minimum size of client logs before rotation.
    # A log file smaller than this size will not be rotated
    # even if the time/size threshold is reached (unless combined
    # with maxsize behavior depending on logrotate version/config).
    minsize {{ minsize_client | default('100k') }}

    # -----------------------------------------------------------------
    # Retention Policy
    # -----------------------------------------------------------------
    # Number of rotated client log files to keep.
    # Older logs are discarded after this count is reached.
    # Default: 26 (approx 6 months of weekly logs).
    rotate {{ rotate_client | default(26) }}

    # -----------------------------------------------------------------
    # Operational Directives
    # -----------------------------------------------------------------
    # Do not complain if the log file is missing.
    missingok

    # Compress rotated log files using gzip to save disk space.
    compress

    # Delay compression of the most recently rotated log file.
    # This ensures that if a process still writes to the old file
    # during rotation, the compressed file is not corrupted.
    delaycompress

    # Do not rotate empty log files.
    notifempty

    # Scripts to run after rotation is complete.
    sharedscripts
    postrotate
        # -----------------------------------------------------------------
        # Post-rotation Actions
        # -----------------------------------------------------------------
        # Notify the GlusterFS client daemon to reopen its log file.
        # This ensures subsequent logging goes to the new file.
        # We suppress errors as the process might not be running or
        # might have exited already.
        /usr/bin/killall -HUP glusterfs > /dev/null 2>&1 || true

        # Notify the GlusterFS management daemon (glusterd) to reopen
        # its log file if it is writing to the same log stream.
        /usr/bin/killall -HUP glusterd > /dev/null 2>&1 || true
    endscript
}

# -----------------------------------------------------------------------------
# Server (Brick) Log Rotation Rules
# -----------------------------------------------------------------------------
# Target: /var/log/glusterfs/bricks/*.log
# Applies to logs generated by GlusterFS brick processes (server-side).
/var/log/glusterfs/bricks/*.log {
    # -----------------------------------------------------------------
    # Rotation Policy
    # -----------------------------------------------------------------
    # Rotate logs on a weekly basis.
    weekly

    # -----------------------------------------------------------------
    # Size-based Rotation Limits
    # -----------------------------------------------------------------
    # Maximum size of server brick logs before rotation occurs.
    maxsize {{ maxsize_server | default('10M') }}

    # Minimum size of server brick logs before rotation.
    minsize {{ minsize_server | default('100k') }}

    # -----------------------------------------------------------------
    # Retention Policy
    # -----------------------------------------------------------------
    # Number of rotated server brick log files to keep.
    # Default: 26 (approx 6 months of weekly logs).
    rotate {{ rotate_server | default(26) }}

    # -----------------------------------------------------------------
    # Operational Directives
    # -----------------------------------------------------------------
    # Do not complain if the log file is missing.
    missingok

    # Compress rotated log files.
    compress

    # Delay compression of the most recent rotation.
    delaycompress

    # Do not rotate empty log files.
    notifempty

    # Scripts to run after rotation.
    sharedscripts
    postrotate
        # -----------------------------------------------------------------
        # Post-rotation Actions
        # -----------------------------------------------------------------
        # Notify the GlusterFS brick daemon (glusterfsd) to reopen
        # its log file to ensure logging continuity.
        /usr/bin/killall -HUP glusterfsd > /dev/null 2>&1 || true
    endscript
}

# -----------------------------------------------------------------------------
# Sample Log Rotation Rules
# -----------------------------------------------------------------------------
# Target: /var/log/glusterfs/samples/*.samp
# Applies to sample or diagnostic log files.
/var/log/glusterfs/samples/*.samp {
    # Rotate daily for sample logs to prevent accumulation.
    daily

    # Number of rotated sample log files to keep.
    # Default: 3 (limited retention for samples).
    rotate {{ rotate_samples | default(3) }}

    # Run scripts once for all matched logs in this block.
    sharedscripts

    # Do not complain if the log file is missing.
    missingok

    # Compress rotated sample logs.
    compress

    # Delay compression of the most recent rotation.
    delaycompress
}
