{
  "inputs": {
    "type": "list",
    "default": [],
    "description": "List of input MRT files (supports gz/bz2); empty list means stdin (use ['-'])"
  },
  "output_mode": {
    "type": "string",
    "default": "human_multiline",
    "description": "Output format: 'human_multiline' (-H, default), 'unix_one_line' (-m), or 'human_one_line' (-M)"
  },
  "timestamp_mode": {
    "type": "string",
    "default": "dump",
    "description": "Timestamp source for RIB dumps: 'dump' (time of dump, default) or 'change' (last route modification)",
    "enum": [
      "dump",
      "change"
    ]
  },
  "show_packet_index": {
    "type": "bool",
    "default": false,
    "description": "Include packet index in -m/-M output"
  },
  "output_file": {
    "type": "string",
    "default": "",
    "description": "Output file path; empty means stdout"
  },
  "log_to_syslog": {
    "type": "bool",
    "default": true,
    "description": "Log to syslog (true) or stderr (false)"
  }
}
