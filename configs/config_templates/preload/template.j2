# Rate at which to scan the system (in seconds)
SCAN_INTERVAL={{ scan_interval }}

# Maximum number of processes to track
MAX_PROCESSES={{ max_processes }}

# Directory where readahead profiles are stored
PROFILE_DIR='{{ profile_dir }}'

# Directory where history data (process access patterns) is stored
HISTORY_DIR='{{ history_dir }}'

# Enable/disable proactive mode (preemptively load for frequent processes)
PROACTIVE={{ proactive | lower }}

# Enable/disable passive mode (only react to actual read patterns)
PASSIVE={{ passive | lower }}

# Maximum number of pages to read ahead per I/O operation (0 = use kernel default)
READAHEAD_PAGES={{ readahead_pages }}

# Minimum number of pages to consider a file 