# drool configuration - DNS Replay Tool
# This file configures drool's generic options for replay or respdiff commands.
# Auto-generated by Ansible; do not edit manually.

{% set _verbose = verbose | default(0) %}
{% if _verbose > 0 %}
# Verbose logging level: use 1-3 for increasing verbosity.
# Mirrors the -v/--verbose flag repetition.
--verbose{% if _verbose > 1 %}{% for _ in range(_verbose - 1) %} --verbose{% endfor %}{% endif %}
{% endif %}

# Output format for statistics: 'csv', 'json', or 'none' (default = no stats output).
# Must be exactly one of the allowed values.
{% set _output_format = output_format | default('none') %}
{% if _output_format == 'csv' %}--csv{% endif %}
{% if _output_format == 'json' %}--json{% endif %}

{% set _iterations = iterations | default(1) %}
{% if _iterations != 1 %}
# Number of times to replay the PCAP file.
# Use -1 for an infinite loop.
--iterations {{ _iterations }}
{% endif %}

# Additional raw command-line options for advanced use.
# Each item in the list is passed as a separate argument to the drool command.
{% if extra_args is defined and extra_args is iterable %}
# Extra arguments passed directly to drool command
{% for arg in extra_args %}{{ arg }}
{% endfor %}
{% endif %}