# /etc/default/prometheus-bird-exporter
# Configuration for the Prometheus BIRD exporter service
# This file is generated by Ansible. Do not edit manually.
# Variables map directly to schema fields: bird_socket, exporter_address, exporter_port, etc.

# Path to the BIRD control socket (typically /var/run/bird/bird.ctl or /var/run/bird/bird6.ctl for IPv6)
BIRD_SOCKET={{ (bird_socket | default('/var/run/bird/bird.ctl')) | string }}

# Network address the exporter listens on (e.g., '127.0.0.1' for localhost only)
EXPORTER_ADDRESS={{ (exporter_address | default('0.0.0.0')) | string }}

# Port number the exporter exposes metrics on
EXPORTER_PORT={{ (exporter_port | default(9324)) | string }}

# Collect metrics about BIRD routing protocols (BGP, OSPF, etc.)
METRICS_PROTOCOLS={{ (metrics_protocols | default(True)) | string | lower }}

# Collect metrics about route tables (prefixes, next hops)
METRICS_ROUTES={{ (metrics_routes | default(True)) | string | lower }}

# Collect metrics about network interfaces
METRICS_INTERFACES={{ (metrics_interfaces | default(True)) | string | lower }}

# Collect metrics about the kernel routing table
METRICS_KERNEL={{ (metrics_kernel | default(True)) | string | lower }}

# Collect metrics about route export tables
METRICS_EXPORT_TABLES={{ (metrics_export_tables | default(True)) | string | lower }}

# Verbosity of exporter logs (debug, info, warn, error)
LOG_LEVEL={{ (log_level | default('info')) | string }}

# List of additional BIRD socket paths to monitor (e.g., for multi-instance deployments)
# Leave empty to use only the default socket (BIRD_SOCKET)
# If the list is empty, we explicitly set it to empty string to avoid undefined variable issues in some shells
{% set _bird_instances = bird_instances | default([]) %}
{% if _bird_instances | length > 0 %}
BIRD_INSTANCES={{ _bird_instances | join(',') }}
{% else %}
BIRD_INSTANCES=
{% endif %}

# Timeout (in seconds) for establishing connection to BIRD socket
CONNECT_TIMEOUT={{ (connect_timeout | default(2)) | string }}