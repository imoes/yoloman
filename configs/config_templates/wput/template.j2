# wput.conf — configuration file for wput, a lightweight FTP upload tool.
# This file provides default connection parameters for the wput utility.
#
# SECURITY WARNING: Storing plaintext passwords in configuration files is insecure.
# It is strongly recommended to use interactive authentication or a system keyring
# for production environments.

# Default FTP server hostname or IP address to upload files to.
server = {{ server | default('') }}

# Default FTP server port. Standard FTP uses 21.
# Note: wput uses plain FTP. Use 22 only if your server supports SFTP and wput is
# configured to support it via flags (rare).
port = {{ port | default(21) }}

# Username for FTP authentication.
# If empty, wput will prompt interactively for a username.
user = {{ user | default('') }}

# Password for FTP authentication.
# For security, prefer interactive entry or keyring; never commit secrets to config in production.
password = {{ password | default('') }}

# Absolute path of the remote directory where files will be uploaded by default.
remote_dir = {{ remote_dir | default('/') }}

# Connection timeout in seconds before aborting the FTP connection.
connect_timeout = {{ connect_timeout | default(30) }}

# Enable passive mode FTP.
# Required in most NAT/firewall environments to allow data connections initiated by the server.
passive = {{ passive | default(True) | lower }}

# Verbosity level: 0 (quiet), 1 (normal), 2 (debug).
# Can be overridden with the -v flag on the command line.
verbosity = {{ verbosity | default(1) }}

# If true, resume partial uploads instead of restarting them.
# Useful for large files over unreliable network links.
resume = {{ resume | default(False) | lower }}

# If true, skip uploading files that already exist on the server.
# Existing files are identified based on size and/or modified time.
skip_existing = {{ skip_existing | default(True) | lower }}

# Enable FTPS (explicit FTP over TLS).
# Note: wput’s TLS support is optional and depends on compile-time options.
# Not supported by all builds of wput.
ftps = {{ ftps | default(False) | lower }}

# List of glob patterns or filenames to exclude from upload.
# Each pattern generates an 'exclude' directive.
# Example: '*.tmp', '.git/*', 'temp.dat'
{% for pattern in exclude_patterns | default([]) %}
exclude = {{ pattern | tojson }}
{% endfor %}

# List of additional wput CLI arguments to apply to every invocation.
# Each item is appended literally to the wput command.
# Example: '--retry=3', '--reconnect=5'
{% for option in extra_args | default([]) %}
extra_arg = {{ option | tojson }}
{% endfor %}