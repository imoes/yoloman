# =============================================================================
# Nginx (light) configuration template
# Generated by Ansible Jinja2 — self-documenting
#
# Schema fields used:
#   - worker_connections : Maximum number of simultaneous connections that can be opened by a worker process.
#   - keepalive_timeout  : Timeout (in seconds) for keep-alive connections between client and server.
#   - gzip_comp_level    : Gzip compression level (1–9); higher = more CPU, smaller output.
#   - gzip_types         : MIME types to compress with Gzip; must be compatible with client Accept-Encoding.
# =============================================================================

# [global] User under which the nginx worker processes run.
user nginx;

# [global] Number of worker processes. 'auto' lets nginx detect CPU count.
worker_processes auto;

# [global] Path to error log and minimum severity level.
error_log /var/log/nginx/error.log warn;

# [global] PID file path.
pid /run/nginx.pid;

events {
    # [events] Maximum number of simultaneous connections that can be opened by a worker process.
    worker_connections {{ worker_connections | default(1024) }};
}

http {
    # [http] Include MIME types definitions.
    include /etc/nginx/mime.types;

    # [http] Default content type if Content-Type header is not set.
    default_type application/octet-stream;

    # [http] Hide nginx version number in error pages and Server header.
    server_tokens off;

    # [http] Custom log format for access logs.
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    # [http] Access log path and format.
    access_log /var/log/nginx/access.log main;

    # [http] Enable efficient file transfer using sendfile().
    sendfile on;

    # [http] Enable tcp_nopush for optimizing packet sending.
    tcp_nopush on;

    # [http] Enable tcp_nodelay for disabling Nagle's algorithm.
    tcp_nodelay on;

    # [http] Timeout (in seconds) for keep-alive connections between client and server.
    keepalive_timeout {{ keepalive_timeout | default(65) }};

    # [http] Hash table size for types.
    types_hash_max_size 2048;

    # [http] Gzip compression settings --- begin
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    # [http] Gzip compression level (1–9); higher = more CPU, smaller output.
    gzip_comp_level {{ gzip_comp_level | default(4) }};
    gzip_min_length 256;
    # [http] MIME types to compress with Gzip; must be compatible with client Accept-Encoding.
    # Rendered as a space-separated list of quoted strings.
    gzip_types {{ gzip_types | default(['text/plain', 'text/css', 'application/json', 'application/javascript', 'text/xml', 'application/xml', 'application/xml+rss', 'text/javascript']) | join(' ') }};
    # Gzip compression settings --- end

    # [http] Include modular configuration files from conf.d directory.
    include /etc/nginx/conf.d/*.conf;
}