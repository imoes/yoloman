{
  "enabled": true,
  "path_manager": "fullmesh",
  "log_level": "info",
  "log_file": "/var/log/mptcpd.log",
  "allowed_interfaces": [
    {
      "name": "eth0",
      "enabled": true,
      "priority": 10,
      "addr_type": "both"
    },
    {
      "name": "eth1",
      "enabled": true,
      "priority": 5,
      "addr_type": "ipv4"
    },
    {
      "name": "wwan0",
      "enabled": false,
      "priority": 0,
      "addr_type": "ipv4"
    }
  ],
  "socket_opts": {
    "mptcp.nodelay": "1",
    "net.mptcp.enabled": "1"
  },
  "custom_paths": [
    {
      "id": "internal-net",
      "dst": "192.168.10.0/24",
      "ifname": "eth0",
      "metric": 100
    }
  ]
}
