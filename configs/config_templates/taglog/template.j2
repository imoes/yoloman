# ============================================================================
# TagLog Configuration Template
# ============================================================================
# TagLog is a lightweight, text-based logging aggregator/manager.
# This template generates the main configuration file for TagLog.
# Since the schema is empty, this template serves as a structural placeholder
# for future configuration directives or a default "empty" valid config.
# ============================================================================

# [General] General settings for the TagLog daemon.
# The root directory where TagLog stores its database and internal data.
# Default: /var/lib/taglog
base_path = {{ taglog_base_path | default('/var/lib/taglog') }}

# The user account under which the TagLog process runs.
# Default: taglog
run_as_user = {{ taglog_run_as_user | default('taglog') }}

# The group account under which the TagLog process runs.
# Default: taglog
run_as_group = {{ taglog_run_as_group | default('taglog') }}

# The PID file path for the TagLog daemon.
# Default: /var/run/taglog/taglog.pid
pid_file = {{ taglog_pid_file | default('/var/run/taglog/taglog.pid') }}

# The path to the log file for TagLog's own internal operations (debugging/errors).
# Default: /var/log/taglog/taglog.log
log_file = {{ taglog_log_file | default('/var/log/taglog/taglog.log') }}

# The verbosity level for internal logging.
# 0 = Error, 1 = Warning, 2 = Info, 3 = Debug
# Default: 2
log_level = {{ taglog_log_level | default(2) }}

# [Database] Storage backend configuration.
# TagLog uses an embedded SQLite database by default, but can be extended.
# Path to the SQLite database file.
# Default: /var/lib/taglog/taglog.db
db_path = {{ taglog_db_path | default('/var/lib/taglog/taglog.db') }}

# [Network] Network listener configuration.
# The IP address TagLog listens on for incoming log connections (if enabled).
# Default: 127.0.0.1
listen_address = {{ taglog_listen_address | default('127.0.0.1') }}

# The port TagLog listens on for incoming log connections (if enabled).
# Default: 10514
listen_port = {{ taglog_listen_port | default(10514) }}

# The protocol for network listening (tcp or udp).
# Default: udp
listen_protocol = {{ taglog_listen_protocol | default('udp') }}

# [API] REST API configuration.
# Whether to enable the built-in HTTP API for managing tags and logs.
# Default: false
api_enabled = {{ taglog_api_enabled | default(false) }}

# The IP address for the REST API listener.
# Default: 127.0.0.1
api_address = {{ taglog_api_address | default('127.0.0.1') }}

# The port for the REST API listener.
# Default: 8080
api_port = {{ taglog_api_port | default(8080) }}

# ============================================================================
# End of Configuration
# ============================================================================