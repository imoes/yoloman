# OpenStack Ironic fence agent configuration for fence_ironic
# This file is sourced by the fence_ironic agent script.
# All required parameters are key=value pairs.
# Comments begin with '#'.

# Authentication: Identity API endpoint (Keystone v3 recommended)
auth_url={{ auth_url }}

# Project/tenant name (or domain-scoped project name)
project_name={{ project_name }}

# Username to authenticate as
username={{ username }}

# Password for the user
password={{ password }}

# (Optional) Domain name for user/project (v3 only); defaults to 'Default'
domain_name={{ domain_name | default('Default') }}

# (Optional) User domain name (v3); defaults to 'Default'
user_domain_name={{ user_domain_name | default('Default') }}

# (Optional) Project domain name (v3); defaults to 'Default'
project_domain_name={{ project_domain_name | default('Default') }}

# Authentication method: 'password' (default) or 'token'
auth_type={{ auth_type | default('password') }}

# (Optional) API version for Ironic; defaults to '1'
ironic_api_version={{ ironic_api_version | default('1') }}

# (Optional) Insecure: allow connections to SSL sites without certs (true|false)
insecure={{ insecure | default('false') }}

# (Optional) Path to CA certificate bundle for SSL verification (overrides system store if set)
ca_cert={{ ca_cert | default('') }}

# (Optional) Region name (if using multi-region deployments)
region_name={{ region_name | default('') }}

# (Required) UUID or name of the target Ironic node to fence
node={{ node }}

# (Optional) Timeout in seconds per API call (default: 60)
timeout={{ timeout | default('60') }}

# (Optional) Action to perform: 'on', 'off', 'reboot', 'status', 'list', 'monitor'
# Note: The fencing agent is usually invoked with this action externally;
# this value serves as fallback or default if not specified at runtime.
default_action={{ default_action | default('reboot') }}

# (Optional) Retry count for failed operations
retry={{ retry | default('3') }}

# (Optional) Delay (seconds) between retries
retry_max_delay={{ retry_max_delay | default('5') }}

# (Optional) List of additional HTTP headers (e.g., for proxy auth or custom headers)
# Format: header1:value1;header2:value2
extra_headers={{ extra_headers | default('') }}

# (Optional) Use SSL/TLS (true|false); typically auto-detected from auth_url scheme
secure={{ secure | default('true') }}

# (Optional) List of Ironic endpoint types to prefer, in order (e.g., public,internal,admin)
endpoint_type={{ endpoint_type | default('public') }}
