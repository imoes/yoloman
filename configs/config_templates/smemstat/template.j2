# smemstat configuration file
# This template generates a configuration file for smemstat, a system monitoring tool.
# All variables are sourced from Ansible role defaults or host/group vars.
# Each directive corresponds to a command-line flag or option of the smemstat binary.

# output_unit: Unit for memory reporting. Valid values: 'k' (kilobytes), 'm' (megabytes), 'g' (gigabytes).
# Defaults to megabytes if not specified. Corresponds to -k, -m, -g flags.
output_unit: {{ output_unit | default('m') }}

# interval: Delay in seconds between updates. 0 for single snapshot.
# Corresponds to the 'delay' argument.
interval: {{ interval | default(0) }}

# count: Number of times to repeat output. 0 for indefinite.
# Corresponds to the 'count' argument.
count: {{ count | default(0) }}

# process_filter: Comma-separated list of PIDs or process names to monitor.
# If empty/null, monitors all user processes. Corresponds to -p proclist.
process_filter: {{ process_filter | default('') }}

# top_consumers: Enable top mode for top consumers of memory.
# Corresponds to -T flag.
top_consumers: {{ top_consumers | default(false) | lower }}

# top_changes: Enable top mode for top changes in memory.
# Corresponds to -t flag.
top_changes: {{ top_changes | default(false) | lower }}

# show_arrows: Show memory change arrows.
# Corresponds to -a flag.
show_arrows: {{ show_arrows | default(false) | lower }}

# show_short_cmd: Show short command information.
# Corresponds to -s flag.
show_short_cmd: {{ show_short_cmd | default(false) | lower }}

# show_long_cmd: Show long (full) command information.
# Corresponds to -l flag.
show_long_cmd: {{ show_long_cmd | default(false) | lower }}

# use_comm_field: Use process comm field for command info.
# Corresponds to -c flag.
use_comm_field: {{ use_comm_field | default(false) | lower }}

# strip_dir: Strip directory from command info.
# Corresponds to -d flag.
strip_dir: {{ strip_dir | default(false) | lower }}

# quiet: Run quietly.
# Corresponds to -q flag.
quiet: {{ quiet | default(false) | lower }}

# output_file: Path to output JSON file.
# Corresponds to -o file.
output_file: {{ output_file | default('') }}