{
  "worker_id": "worker-01",
  "server_url": "https://debusine.example.com",
  "worker_token": "secret-token-abc123",
  "worker_concurrency": 4,
  "log_level": "INFO",
  "storage_root": "/var/lib/debusine-worker",
  "build_timeout": 3600,
  "http_proxy": "",
  "https_proxy": "",
  "no_proxy": "localhost,127.0.0.1",
  "allowed_architectures": [
    "amd64",
    "arm64"
  ],
  "allowed_series": [
    "bookworm"
  ],
  "allowed_components": [
    "main",
    "contrib"
  ],
  "max_artifact_size_mb": 1024,
  "health_port": 8080,
  "metrics_port": 9090,
  "allowed_signers": [
    "ABCD 1234 EFGH 5678 IJKL 9012 MNOP 3456 7890 ABCD"
  ],
  "disable_signing": false,
  "worker_env": [
    "DEBIAN_FRONTEND=noninteractive",
    "APT_GET_INSTALL_Y=true"
  ]
}
