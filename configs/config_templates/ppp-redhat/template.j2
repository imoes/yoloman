# Secrets for authentication using CHAP
# This file is generated by Ansible. Do not edit manually.
# Format: client server secret ipaddr
#
# Variables:
# - ppp_redhat_chap_secrets: A list of dictionaries containing client, server, secret, and optional ipaddr.
#   Example:
#   ppp_redhat_chap_secrets:
#     - client: "alice"
#       server: "*"
#       secret: "password1"
#       ipaddr: "*"

{% if ppp_redhat_chap_secrets is defined %}
{% for entry in ppp_redhat_chap_secrets %}
{{ entry.client | default('') }}	{{ entry.server | default('*') }}	{{ entry.secret | default('') }}	{{ entry.ipaddr | default('*') }}
{% endfor %}
{% else %}
# No CHAP secrets configured.
{% endif %}