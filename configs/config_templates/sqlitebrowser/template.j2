# DB Browser for SQLite (sqlitebrowser) User Configuration
# This is a simplified representation of the application preferences.
# Note: sqlitebrowser primarily uses a local preferences file (~/.config/sqlitebrowser/preferences.ini) or command-line arguments.
# This template generates a wrapper script or environment configuration for automated database access.

# [DEFAULT]
# General application settings
app_name = {{ app_name | default('sqlitebrowser') }}
version = {{ version | default('3.13.0') }}

# [Paths]
# Default directory for opening/saving databases if none specified via CLI
default_db_path = {{ default_db_path | default('/var/lib/sqlitebrowser/databases') }}

# [Database]
# Default database file to open on startup (optional)
# Empty string means no default database
startup_db = {{ startup_db | default('') }}

# [SQL]
# Default SQL query to run on startup (optional, for quick previews)
# Empty string means no default query
startup_query = {{ startup_query | default('') }}

# [Interface]
# Theme setting: system, dark, light
ui_theme = {{ ui_theme | default('system') }}

# [Editor]
# Font family for the SQL editor
editor_font = {{ editor_font | default('Monospace,10,-1,5,50,0,0,0,0,0') }}

# [Plugins]
# List of enabled plugins (SQLite extensions)
# In the actual INI file, these are specific keys, but we map them here for clarity
enabled_plugins = {{ enabled_plugins | default([]) | join(',') }}