{
  "timeout": 600,
  "force_timeout": 900,
  "action": "suspend",
  "wakeup_action": "suspend",
  "activity_log": "/var/log/autosuspend.log",
  "ignore_users": [
    "root",
    "backup"
  ],
  "ignore_processes": [
    "sshd",
    "rsync"
  ],
  "ignore_devices": [
    "/dev/input/event0",
    "/dev/input/mice"
  ],
  "activity_watch_paths": [
    "/home/*/Downloads/",
    "/srv/data/*.tmp"
  ],
  "suspend_on_battery_only": true,
  "battery_min_percent": 15,
  "ignore_network_interfaces": [
    "docker0",
    "veth+"
  ],
  "pre_suspend_command": "sync; systemctl stop nginx@*.service",
  "post_suspend_command": "systemctl start nginx@www.service",
  "require_no_x11": true,
  "require_no_wayland": true,
  "require_no_console_sessions": true,
  "require_no_ssh_sessions": true,
  "require_no_vnc_sessions": true,
  "require_no_upnp_players": false,
  "require_no_printer_jobs": true,
  "require_no_media_playback": true,
  "require_no_file_transfers": true,
  "require_no_backups": true,
  "require_no_database_services": false,
  "require_no_web_services": false,
  "require_no_containers": true
}
