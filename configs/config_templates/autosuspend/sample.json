{
  "general_interval": 30,
  "general_idle_time": 900,
  "general_suspend_cmd": "/usr/bin/systemctl suspend",
  "general_wakeup_cmd": "sh -c 'echo 0 > /sys/class/rtc/rtc0/wakealarm && echo {timestamp:.0f} > /sys/class/rtc/rtc0/wakealarm'",
  "general_woke_up_file": "/var/run/autosuspend-just-woke-up",
  "general_lock_file": "/var/lock/autosuspend.lock",
  "general_lock_timeout": 30,
  "check_Ping_enabled": true,
  "check_Ping_hosts": "192.168.0.7",
  "check_Smb_enabled": false,
  "check_RemoteUsers_enabled": true,
  "check_RemoteUsers_name": ".*",
  "check_RemoteUsers_terminal": ".*",
  "check_RemoteUsers_host": "[0-9].*",
  "check_LocalUsers_enabled": true,
  "check_LocalUsers_name": ".*",
  "check_LocalUsers_terminal": ".*",
  "check_LocalUsers_host": "localhost",
  "wakeup_Calendar_enabled": true,
  "wakeup_Calendar_url": "http://example.org/test.ics"
}
