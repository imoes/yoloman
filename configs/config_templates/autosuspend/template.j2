# Ansible-enriched template for autosuspend.conf
# Self-documenting: every directive includes a comment derived from its schema description
# and a safe default value using | default().

[general]
# Seconds between activity checks
interval = {{ general_interval | default(30) }}

# Seconds of inactivity before triggering suspension (replaces 'timeout')
idle_time = {{ general_idle_time | default(900) }}

# Command to execute for suspending the system
suspend_cmd = {{ general_suspend_cmd | default('/usr/bin/systemctl suspend') }}

# Command to set up scheduled wake-up alarm before suspending
wakeup_cmd = {{ general_wakeup_cmd | default("sh -c 'echo 0 > /sys/class/rtc/rtc0/wakealarm && echo {timestamp:.0f} > /sys/class/rtc/rtc0/wakealarm'") }}

# Path to file indicating system just woke up (used to suppress immediate resuspension)
woke_up_file = {{ general_woke_up_file | default('/var/run/autosuspend-just-woke-up') }}

# Path to lock file to prevent concurrent invocations
lock_file = {{ general_lock_file | default('/var/lock/autosuspend.lock') }}

# Seconds to wait for lock before giving up
lock_timeout = {{ general_lock_timeout | default(30) }}

# Basic activity check configuration.
# The check class name is derived from the section header (Ping in this case).
# Remember to enable desired checks. They are disabled by default.
[check.Ping]
# Whether to enable the Ping-based activity check
enabled = {{ check_Ping_enabled | default(true) | lower }}

# Space-separated list of hosts to ping for network activity detection
hosts = {{ check_Ping_hosts | default('192.168.0.7') }}

# This check is disabled.
[check.Smb]
# Whether to enable the SMB-based activity check
enabled = {{ check_Smb_enabled | default(false) | lower }}

# Example for a custom check name.
# This will use the Users check with the custom name RemoteUsers.
# Custom names are necessary in case a check class is used multiple times.
# Custom names can also be used for clarification.
[check.RemoteUsers]
# Class is fixed to 'Users' in the original schema, but we leave it as is.
# If you need to change it, add a variable. Here we hardcode 'Users' as per original intent.
class = Users

# Whether to enable the custom RemoteUsers activity check
enabled = {{ check_RemoteUsers_enabled | default(true) | lower }}

# Regex pattern for usernames to consider in RemoteUsers check
name = {{ check_RemoteUsers_name | default('.*') }}

# Regex pattern for terminal types to consider in RemoteUsers check
terminal = {{ check_RemoteUsers_terminal | default('.*') }}

# Regex pattern for remote host patterns to consider in RemoteUsers check
host = {{ check_RemoteUsers_host | default('[0-9].*') }}

# Here the Users activity check is used again with different settings and a different name
[check.LocalUsers]
# Class is fixed to 'Users' in the original schema.
class = Users

# Whether to enable the custom LocalUsers activity check
enabled = {{ check_LocalUsers_enabled | default(true) | lower }}

# Regex pattern for usernames to consider in LocalUsers check
name = {{ check_LocalUsers_name | default('.*') }}

# Regex pattern for terminal types to consider in LocalUsers check
terminal = {{ check_LocalUsers_terminal | default('.*') }}

# Regex pattern for host patterns to consider in LocalUsers check
host = {{ check_LocalUsers_host | default('localhost') }}

# Checks to determine the next scheduled wakeup are prefixed with 'wakeup'.
[wakeup.Calendar]
# Whether to enable the calendar-based wake-up check
enabled = {{ wakeup_Calendar_enabled | default(true) | lower }}

# URL of calendar file (e.g., iCal) for scheduled wake-ups
url = {{ wakeup_Calendar_url | default('http://example.org/test.ics') }}

# Apart from this, wake up checks reuse the same configuration mechanism.