# -----------------------------------------------------------------------------
# slurmmd (SLURM Daemon) Configuration
# -----------------------------------------------------------------------------
# This file configures the command-line options passed to the SLURM
# compute node daemon (slurmd). These options supplement or override
# the defaults defined in slurmd.conf.

# -----------------------------------------------------------------------------
# slurm.slurmd_options
# Description: Additional command-line options passed to the slurmd daemon.
# Default: ''
# -----------------------------------------------------------------------------
# Example values: "--log-level=VERBOSE", "--debug-files"
SLURMD_OPTIONS="{{ (slurm | default({})).slurmd_options | default('') }}"
