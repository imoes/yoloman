{% else %}; avoid-resampling = false
{% endif %}{% if enable_remixing is defined and enable_remixing is not none and (enable_remixing is number or enable_remixing is boolean or enable_remixing | length > 0) %}enable-remixing = {{ enable_remixing | lower }}
