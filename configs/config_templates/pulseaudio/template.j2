## Configuration file for the PulseAudio daemon. See pulse-daemon.conf(5) for
## more information. Default values are commented out.  Use either ; or # for
## commenting.

{% if daemonize is defined and daemonize is not none and (daemonize is number or daemonize is boolean or daemonize | length > 0) %}daemonize = {{ daemonize | lower }}
{% else %}; daemonize = no
{% endif %}{% if fail is defined and fail is not none and (fail is number or fail is boolean or fail | length > 0) %}fail = {{ fail | lower }}
{% else %}; fail = yes
{% endif %}{% if allow_module_loading is defined and allow_module_loading is not none and (allow_module_loading is number or allow_module_loading is boolean or allow_module_loading | length > 0) %}allow-module-loading = {{ allow_module_loading | lower }}
{% else %}; allow-module-loading = yes
{% endif %}{% if allow_exit is defined and allow_exit is not none and (allow_exit is number or allow_exit is boolean or allow_exit | length > 0) %}allow-exit = {{ allow_exit | lower }}
{% else %}; allow-exit = yes
{% endif %}{% if use_pid_file is defined and use_pid_file is not none and (use_pid_file is number or use_pid_file is boolean or use_pid_file | length > 0) %}use-pid-file = {{ use_pid_file | lower }}
{% else %}; use-pid-file = yes
{% endif %}{% if system_instance is defined and system_instance is not none and (system_instance is number or system_instance is boolean or system_instance | length > 0) %}system-instance = {{ system_instance | lower }}
{% else %}; system-instance = no
{% endif %}{% if local_server_type is defined and local_server_type is not none and (local_server_type is number or local_server_type is boolean or local_server_type | length > 0) %}local-server-type = {{ local_server_type }}
{% else %}; local-server-type = user
{% endif %}{% if enable_shm is defined and enable_shm is not none and (enable_shm is number or enable_shm is boolean or enable_shm | length > 0) %}enable-shm = {{ enable_shm | lower }}
{% else %}; enable-shm = yes
{% endif %}{% if enable_memfd is defined and enable_memfd is not none and (enable_memfd is number or enable_memfd is boolean or enable_memfd | length > 0) %}enable-memfd = {{ enable_memfd | lower }}
{% else %}; enable-memfd = yes
{% endif %}{% if shm_size_bytes is defined and shm_size_bytes is not none and (shm_size_bytes is number or shm_size_bytes is boolean or shm_size_bytes | length > 0) %}shm-size-bytes = {{ shm_size_bytes }} # setting this 0 will use the system-default, usually 64 MiB
{% else %}; shm-size-bytes = 0 # setting this 0 will use the system-default, usually 64 MiB
{% endif %}{% if lock_memory is defined and lock_memory is not none and (lock_memory is number or lock_memory is boolean or lock_memory | length > 0) %}lock-memory = {{ lock_memory | lower }}
{% else %}; lock-memory = no
{% endif %}{% if cpu_limit is defined and cpu_limit is not none and (cpu_limit is number or cpu_limit is boolean or cpu_limit | length > 0) %}cpu-limit = {{ cpu_limit | lower }}
{% else %}; cpu-limit = no
{% endif %}
{% if high_priority is defined and high_priority is not none and (high_priority is number or high_priority is boolean or high_priority | length > 0) %}high-priority = {{ high_priority | lower }}
{% else %}; high-priority = yes
{% endif %}{% if nice_level is defined and nice_level is not none and (nice_level is number or nice_level is boolean or nice_level | length > 0) %}nice-level = {{ nice_level }}
{% else %}; nice-level = -11
{% endif %}
{% if realtime_scheduling is defined and realtime_scheduling is not none and (realtime_scheduling is number or realtime_scheduling is boolean or realtime_scheduling | length > 0) %}realtime-scheduling = {{ realtime_scheduling | lower }}
{% else %}; realtime-scheduling = yes
{% endif %}{% if realtime_priority is defined and realtime_priority is not none and (realtime_priority is number or realtime_priority is boolean or realtime_priority | length > 0) %}realtime-priority = {{ realtime_priority }}
{% else %}; realtime-priority = 5
{% endif %}
{% if exit_idle_time is defined and exit_idle_time is not none and (exit_idle_time is number or exit_idle_time is boolean or exit_idle_time | length > 0) %}exit-idle-time = {{ exit_idle_time }}
{% else %}; exit-idle-time = 20
{% endif %}{% if scache_idle_time is defined and scache_idle_time is not none and (scache_idle_time is number or scache_idle_time is boolean or scache_idle_time | length > 0) %}scache-idle-time = {{ scache_idle_time }}
{% else %}; scache-idle-time = 20
{% endif %}
; dl-search-path = (depends on architecture)

{% if load_default_script_file is defined and load_default_script_file is not none and (load_default_script_file is number or load_default_script_file is boolean or load_default_script_file | length > 0) %}load-default-script-file = {{ load_default_script_file | lower }}
{% else %}; load-default-script-file = yes
{% endif %}{% if default_script_file is defined and default_script_file is not none and (default_script_file is number or default_script_file is boolean or default_script_file | length > 0) %}default-script-file = {{ default_script_file }}
{% else %}; default-script-file = /etc/pulse/default.pa
{% endif %}
