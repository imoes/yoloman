{% if enable_deferred_volume is defined and enable_deferred_volume is not none and (enable_deferred_volume is number or enable_deferred_volume is boolean or enable_deferred_volume | length > 0) %}enable-deferred-volume = {{ enable_deferred_volume | lower }}
{% else %}; enable-deferred-volume = yes
