# Default-PA: Enable real-time scheduling for the audio server
# (This is critical for low-latency audio processing)
default-time-source = {{ default_time_source }}
# Default-PA: Sample format used by the daemon
default-sample-format = {{ default_sample_format }}
# Default-PA: Sample rate used by the daemon
# (Common values: 44100, 48000, 96000, 192000)
default-sample-rate = {{ default_sample_rate }}
# Default-PA: Alternate sample rate used for resampling
# (Set to 0 to disable alternate sample rate)
alternate-sample-rate = {{ alternate_sample_rate }}
# Default-PA: Number of seconds of silence to keep before suspending
# Set to 0 to disable auto-suspension
default-fragments = {{ default_fragments }}
# Default-PA: Size of each fragment in frames
# Total buffer size = default-fragments * default-fragment-size
# (Fragment size is typically a power of two)
default-fragment-size = {{ default_fragment_size }}
# Default-PA: Number of milliseconds of data to buffer before playback
# Affects latency; smaller = lower latency but more CPU usage
resample-method = {{ resample_method }}
# Default-PA: Enable or disable real-time priority
real-time = {{ real_time }}
# Default-PA: Real-time priority level (1–99); higher = more aggressive
# Only effective if `real-time = yes`
real-time-priority = {{ real_time_priority }}
# Default-PA: Adjust nice level for non-real-time mode (−20 to 19)
nice-level = {{ nice_level }}
