{% endif %}{% if rlimit_locks is defined and rlimit_locks is not none and (rlimit_locks is number or rlimit_locks is boolean or rlimit_locks | length > 0) %}rlimit-locks = {{ rlimit_locks }}
{% else %}; rlimit-locks = -1
{% endif %}{% if rlimit_sigpending is defined and rlimit_sigpending is not none and (rlimit_sigpending is number or rlimit_sigpending is boolean or rlimit_sigpending | length > 0) %}rlimit-sigpending = {{ rlimit_sigpending }}
{% else %}; rlimit-sigpending = -1
{% endif %}{% if rlimit_msgqueue is defined and rlimit_msgqueue is not none and (rlimit_msgqueue is number or rlimit_msgqueue is boolean or rlimit_msgqueue | length > 0) %}rlimit-msgqueue = {{ rlimit_msgqueue }}
{% else %}; rlimit-msgqueue = -1
{% endif %}{% if rlimit_nice is defined and rlimit_nice is not none and (rlimit_nice is number or rlimit_nice is boolean or rlimit_nice | length > 0) %}rlimit-nice = {{ rlimit_nice }}
{% else %}; rlimit-nice = 31
{% endif %}{% if rlimit_rtprio is defined and rlimit_rtprio is not none and (rlimit_rtprio is number or rlimit_rtprio is boolean or rlimit_rtprio | length > 0) %}rlimit-rtprio = {{ rlimit_rtprio }}
{% else %}; rlimit-rtprio = 9
{% endif %}{% if rlimit_rttime is defined and rlimit_rttime is not none and (rlimit_rttime is number or rlimit_rttime is boolean or rlimit_rttime | length > 0) %}rlimit-rttime = {{ rlimit_rttime }}
{% else %}; rlimit-rttime = 200000
{% endif %}
{% if default_sample_format is defined and default_sample_format is not none and (default_sample_format is number or default_sample_format is boolean or default_sample_format | length > 0) %}default-sample-format = {{ default_sample_format }}
{% else %}; default-sample-format = s16le
{% endif %}{% if default_sample_rate is defined and default_sample_rate is not none and (default_sample_rate is number or default_sample_rate is boolean or default_sample_rate | length > 0) %}default-sample-rate = {{ default_sample_rate }}
{% else %}; default-sample-rate = 44100
{% endif %}{% if alternate_sample_rate is defined and alternate_sample_rate is not none and (alternate_sample_rate is number or alternate_sample_rate is boolean or alternate_sample_rate | length > 0) %}alternate-sample-rate = {{ alternate_sample_rate }}
{% else %}; alternate-sample-rate = 48000
{% endif %}{% if default_sample_channels is defined and default_sample_channels is not none and (default_sample_channels is number or default_sample_channels is boolean or default_sample_channels | length > 0) %}default-sample-channels = {{ default_sample_channels }}
{% else %}; default-sample-channels = 2
{% endif %}{% if default_channel_map is defined and default_channel_map is not none and (default_channel_map is number or default_channel_map is boolean or default_channel_map | length > 0) %}default-channel-map = {{ default_channel_map }}
{% else %}; default-channel-map = front-left,front-right
{% endif %}
{% if default_fragments is defined and default_fragments is not none and (default_fragments is number or default_fragments is boolean or default_fragments | length > 0) %}default-fragments = {{ default_fragments }}
{% else %}; default-fragments = 4
{% endif %}{% if default_fragment_size_msec is defined and default_fragment_size_msec is not none and (default_fragment_size_msec is number or default_fragment_size_msec is boolean or default_fragment_size_msec | length > 0) %}default-fragment-size-msec = {{ default_fragment_size_msec }}
{% else %}; default-fragment-size-msec = 25
