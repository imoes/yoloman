{% else %}; deferred-volume-safety-margin-usec = 8000
{% endif %}{% if deferred_volume_extra_delay_usec is defined and deferred_volume_extra_delay_usec is not none and (deferred_volume_extra_delay_usec is number or deferred_volume_extra_delay_usec is boolean or deferred_volume_extra_delay_usec | length > 0) %}deferred-volume-extra-delay-usec = {{ deferred_volume_extra_delay_usec }}
{% else %}; deferred-volume-extra-delay-usec = 0
{% endif %}