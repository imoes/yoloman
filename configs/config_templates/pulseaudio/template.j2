## Configuration file for the PulseAudio daemon. See pulse-daemon.conf(5) for
## more information. Default values are commented out.  Use either ; or # for
## commenting.

; daemonize = {{ daemonize }}
; fail = {{ fail }}
; allow-module-loading = {{ allow_module_loading }}
; allow-exit = {{ allow_exit }}
; use-pid-file = {{ use_pid_file }}
; system-instance = {{ system_instance }}
; local-server-type = {{ local_server_type }}
; enable-shm = {{ enable_shm }}
; enable-memfd = {{ enable_memfd }}
; shm-size-bytes = {{ shm_size_bytes }} # setting this 0 will use the system-default, usually 64 MiB
; lock-memory = {{ lock_memory }}
; cpu-limit = {{ cpu_limit }}

; high-priority = {{ high_priority }}
; nice-level = {{ nice_level }}

; realtime-scheduling = {{ realtime_scheduling }}
; realtime-priority = {{ realtime_priority }}

; exit-idle-time = {{ exit_idle_time }}
; scache-idle-time = {{ scache_idle_time }}

; dl-search-path = (depends on architecture)

; load-default-script-file = {{ load_default_script_file }}
; default-script-file = {{ default_script_file }}

; log-target = {{ log_target }}
; log-level = {{ log_level }}
; log-meta = {{ log_meta }}
; log-time = {{ log_time }}
; log-backtrace = {{ log_backtrace }}

; resample-method = {{ resample_method }}
; avoid-resampling = {{ avoid_resampling }}
; enable-remixing = {{ enable_remixing }}
; remixing-use-all-sink-channels = {{ remixing_use_all_sink_channels }}
; remixing-produce-lfe = {{ remixing_produce_lfe }}
; remixing-consume-lfe = {{ remixing_consume_lfe }}
; lfe-crossover-freq = {{ lfe_crossover_freq }}

; flat-volumes = {{ flat_volumes }}

; rescue-streams = {{ rescue_streams }}

; rlimit-fsize = {{ rlimit_fsize }}
; rlimit-data = {{ rlimit_data }}
; rlimit-stack = {{ rlimit_stack }}
; rlimit-core = {{ rlimit_core }}
; rlimit-as = {{ rlimit_as }}
; rlimit-rss = {{ rlimit_rss }}
; rlimit-nproc = {{ rlimit_nproc }}
; rlimit-nofile = {{ rlimit_nofile }}
; rlimit-memlock = {{ rlimit_memlock }}
; rlimit-locks = {{ rlimit_locks }}
; rlimit-sigpending = {{ rlimit_sigpending }}
; rlimit-msgqueue = {{ rlimit_msgqueue }}
; rlimit-nice = {{ rlimit_nice }}
; rlimit-rtprio = {{ rlimit_rtprio }}
; rlimit-rttime = {{ rlimit_rttime }}

; default-sample-format = {{ default_sample_format }}
; default-sample-rate = {{ default_sample_rate }}
; alternate-sample-rate = {{ alternate_sample_rate }}
; default-sample-channels = {{ default_sample_channels }}
; default-channel-map = {{ default_channel_map }}

; default-fragments = {{ default_fragments }}
; default-fragment-size-msec = {{ default_fragment_size_msec }}

; enable-deferred-volume = {{ enable_deferred_volume }}
; deferred-volume-safety-margin-usec = {{ deferred_volume_safety_margin_usec }}
; deferred-volume-extra-delay-usec = {{ deferred_volume_extra_delay_usec }}