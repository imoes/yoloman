{% else %}; rlimit-data = -1
{% endif %}{% if rlimit_stack is defined and rlimit_stack is not none and (rlimit_stack is number or rlimit_stack is boolean or rlimit_stack | length > 0) %}rlimit-stack = {{ rlimit_stack }}
{% else %}; rlimit-stack = -1
{% endif %}{% if rlimit_core is defined and rlimit_core is not none and (rlimit_core is number or rlimit_core is boolean or rlimit_core | length > 0) %}rlimit-core = {{ rlimit_core }}
{% else %}; rlimit-core = -1
{% endif %}{% if rlimit_as is defined and rlimit_as is not none and (rlimit_as is number or rlimit_as is boolean or rlimit_as | length > 0) %}rlimit-as = {{ rlimit_as }}
{% else %}; rlimit-as = -1
{% endif %}{% if rlimit_rss is defined and rlimit_rss is not none and (rlimit_rss is number or rlimit_rss is boolean or rlimit_rss | length > 0) %}rlimit-rss = {{ rlimit_rss }}
{% else %}; rlimit-rss = -1
{% endif %}{% if rlimit_nproc is defined and rlimit_nproc is not none and (rlimit_nproc is number or rlimit_nproc is boolean or rlimit_nproc | length > 0) %}rlimit-nproc = {{ rlimit_nproc }}
{% else %}; rlimit-nproc = -1
{% endif %}{% if rlimit_nofile is defined and rlimit_nofile is not none and (rlimit_nofile is number or rlimit_nofile is boolean or rlimit_nofile | length > 0) %}rlimit-nofile = {{ rlimit_nofile }}
