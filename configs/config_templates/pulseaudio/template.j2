{% else %}; remixing-consume-lfe = no
{% endif %}{% if lfe_crossover_freq is defined and lfe_crossover_freq is not none and (lfe_crossover_freq is number or lfe_crossover_freq is boolean or lfe_crossover_freq | length > 0) %}lfe-crossover-freq = {{ lfe_crossover_freq }}
{% else %}; lfe-crossover-freq = 0
{% endif %}
{% if flat_volumes is defined and flat_volumes is not none and (flat_volumes is number or flat_volumes is boolean or flat_volumes | length > 0) %}flat-volumes = {{ flat_volumes | lower }}
{% else %}; flat-volumes = no
{% endif %}
{% if rescue_streams is defined and rescue_streams is not none and (rescue_streams is number or rescue_streams is boolean or rescue_streams | length > 0) %}rescue-streams = {{ rescue_streams | lower }}
{% else %}; rescue-streams = yes
{% endif %}
{% if rlimit_fsize is defined and rlimit_fsize is not none and (rlimit_fsize is number or rlimit_fsize is boolean or rlimit_fsize | length > 0) %}rlimit-fsize = {{ rlimit_fsize }}
