{
  "root_dir": "~/.aptly",
  "database_open_attempts": -1,
  "log_level": "info",
  "log_format": "default",
  "architectures": [
    "amd64",
    "i386"
  ],
  "dependency_follow_suggests": true,
  "dependency_follow_recommends": true,
  "dependency_follow_all_variants": true,
  "dependency_follow_source": true,
  "dependency_verbose_resolve": false,
  "ppa_distributor_id": "ubuntu",
  "ppa_codename": "focal",
  "skip_legacy_pool": true,
  "serve_in_api_mode": false,
  "enable_metrics_endpoint": false,
  "database_backend": {
    "type": "leveldb",
    "db_path": ""
  },
  "downloader": "default",
  "download_concurrency": 4,
  "download_speed_limit": 0,
  "download_retries": 3,
  "download_source_packages": false,
  "gpg_provider": "gpg",
  "gpg_disable_sign": false,
  "gpg_disable_verify": false,
  "skip_contents_publishing": false,
  "skip_bz2_publishing": false,
  "filesystem_publish_endpoints": {
    "local": {
      "root_dir": "/var/www/aptly",
      "link_method": "hardlink",
      "verify_method": "md5"
    }
  },
  "s3_publish_endpoints": {
    "s3-prod": {
      "region": "us-east-1",
      "bucket": "my-apt-repo",
      "endpoint": "",
      "prefix": "debs",
      "acl": "public-read",
      "aws_access_key_id": "",
      "aws_secret_access_key": "",
      "storage_class": "STANDARD",
      "encryption_method": "none",
      "plus_workaround": false,
      "disable_multi_del": false,
      "force_sig_v2": false,
      "force_virtual_hosted_style": false
    }
  },
  "swift_publish_endpoints": {},
  "azure_publish_endpoints": {},
  "package_pool_storage": {
    "type": "local",
    "path": ""
  }
}
