# aptly configuration (YAML)
# This file configures the aptly package management tool.
# See https://www.aptly.info/doc/config/ for full documentation.

# Root directory for database, package pool, and published repositories.
# All relative paths in this configuration are resolved against this directory.
# Default: ~/.aptly
rootDir: {{ root_dir | default('~/.aptly') }}

# Number of attempts to open the database if it is locked by another process.
# -1 indicates no retry (fail immediately); 0 or greater specifies the number of retries.
# Default: -1
databaseOpenAttempts: {{ database_open_attempts | default(-1) }}

# Log verbosity level. Allowed values: debug, info, warning, error.
# 'debug' provides the most detailed output, useful for troubleshooting.
# Default: info
logLevel: {{ log_level | default('info') }}

# Format of the log output. Allowed values: default (human-readable text) or json (structured JSON).
# Default: default
logFormat: {{ log_format | default('default') }}

# List of architectures to consider when processing packages.
# An empty list means all available architectures are considered.
# Default: []
architectures:
{% for arch in (architectures | default([])) %}
  - {{ arch | string }}
{% endfor %}

# Dependency resolution behavior.
# These options control how aptly resolves package dependencies during mirror updates and publishing.

# Follow 'Suggests:' dependencies when resolving package dependencies.
# Suggested packages are not required but are recommended by the maintainer.
# Default: false
dependencyFollowSuggests: {{ dependency_follow_suggests | default(false) | lower }}

# Follow 'Recommends:' dependencies when resolving package dependencies.
# Recommended packages are not required but are strongly suggested.
# Default: false
dependencyFollowRecommends: {{ dependency_follow_recommends | default(false) | lower }}

# Follow all variants in 'a | b' dependency specifications (OR dependencies).
# This ensures packages satisfying either variant are considered.
# Default: false
dependencyFollowAllVariants: {{ dependency_follow_all_variants | default(false) | lower }}

# Follow dependencies from binary packages to source packages.
# Useful if you need to track source package origins.
# Default: false
dependencyFollowSource: {{ dependency_follow_source | default(false) | lower }}

# Log additional detail during dependency resolution.
# Enables verbose logging of the dependency resolution process.
# Default: false
dependencyVerboseResolve: {{ dependency_verbose_resolve | default(false) | lower }}

# Default distributor ID used for generating PPA short URLs.
# Typically 'ubuntu' or 'debian'.
# Default: ubuntu
ppaDistributorID: {{ ppa_distributor_id | default('ubuntu') }}

# Default codename used for generating PPA short URLs (e.g., 'focal', 'jammy').
# Leave empty if not using PPA short URLs.
# Default: ''
ppaCodename: {{ ppa_codename | default('') }}

# Skip checking legacy MD5-based package pool paths.
# Set to false if you are migrating from an older aptly version using MD5 pools.
# Default: true
skipLegacyPool: {{ skip_legacy_pool | default(true) | lower }}

# Serve published repositories and the aptly API over HTTP.
# If enabled, aptly acts as a web server for the published repositories.
# Default: false
serveInAPIMode: {{ serve_in_api_mode | default(false) | lower }}

# Enable the Prometheus metrics endpoint.
# Provides system metrics for monitoring via Prometheus.
# Default: false
enableMetricsEndpoint: {{ enable_metrics_endpoint | default(false) | lower }}

# Database backend configuration.
# Supported backends: leveldb (local, fast) or etcd (distributed).
databaseBackend:
  type: {{ (database_backend | default({})).type | default('leveldb') }}
{% if (database_backend | default({})).type | default('leveldb') == 'leveldb' %}
  # Path to LevelDB files. Empty string uses rootDir/db.
  dbPath: {{ (database_backend | default({})).db_path | default('') }}
{% endif %}

# Download settings for fetching packages from repositories.

# Downloader type: 'default' (stdlib) or 'grab' (high-performance).
# Default: default
downloader: {{ downloader | default('default') }}

# Number of parallel threads for downloading packages.
# Default: 4
downloadConcurrency: {{ download_concurrency | default(4) }}

# Download speed limit in kilobytes per second.
# 0 means no limit.
# Default: 0
downloadSpeedLimit: {{ download_speed_limit | default(0) }}

# Number of retries for failed downloads.
# Default: 0
downloadRetries: {{ download_retries | default(0) }}

# Whether to download source packages by default when mirroring.
# Default: false
downloadSourcePackages: {{ download_source_packages | default(false) | lower }}

# GPG signing and verification settings.

# GPG provider: 'gpg' (external gpg command) or 'internal' (built-in).
# Default: gpg
gpgProvider: {{ gpg_provider | default('gpg') }}

# Disable signing of published repositories.
# If true, aptly will not generate Release.gpg/InRelease files.
# Default: false
gpgDisableSign: {{ gpg_disable_sign | default(false) | lower }}

# Disable signature verification of remote repositories during mirroring.
# Use with caution; disables security checks for remote repo signatures.
# Default: false
gpgDisableVerify: {{ gpg_disable_verify | default(false) | lower }}

# Publishing options for generated repository indexes.

# Skip publishing Contents files (package file lists).
# Default: false
skipContentsPublishing: {{ skip_contents_publishing | default(false) | lower }}

# Skip creating .bz2 compressed index files (Packages.bz2, Sources.bz2).
# Default: false
skipBz2Publishing: {{ skip_bz2_publishing | default(false) | lower }}

# Filesystem publishing endpoints configuration.
# Defines local directories where repositories can be published.
FileSystemPublishEndpoints:
{% for ep_name, ep_config in (filesystem_publish_endpoints | default({})) | dict2items %}
  {{ ep_name }}:
    # Directory for publishing packages and indexes
    rootDir: {{ (ep_config | default({})).root_dir | default('/opt/srv/aptly_public') }}
    # File linking method: hardlink, symlink, or copy
    linkMethod: {{ (ep_config | default({})).link_method | default('hardlink') }}
    # Verification method for copy linking: md5 or size
    verifyMethod: {{ (ep_config | default({})).verify_method | default('md5') }}
{% endfor %}

# S3 publishing endpoints configuration.
# Defines AWS S3 or S3-compatible buckets for publishing repositories.
S3PublishEndpoints:
{% for ep_name, ep_config in (s3_publish_endpoints | default({})) | dict2items %}
  {{ ep_name }}:
    # AWS region for the S3 bucket
    region: {{ (ep_config | default({})).region | default('us-east-1') }}
    # S3 bucket name
    bucket: {{ (ep_config | default({})).bucket | default('') }}
    # S3-compatible endpoint URL (leave blank for standard AWS)
    endpoint: {{ (ep_config | default({})).endpoint | default('') }}
    # Prefix path within the bucket
    prefix: {{ (ep_config | default({})).prefix | default('') }}
    # S3 ACL: private, public-read, or none
    acl: {{ (ep_config | default({})).acl | default('private') }}
    # AWS access key ID
    awsAccessKeyID: {{ (ep_config | default({})).aws_access_key_id | default('') }}
    # AWS secret access key
    awsSecretAccessKey: {{ (ep_config | default({})).aws_secret_access_key | default('') }}
    # S3 storage class (e.g., STANDARD, REDUCED_REDUNDANCY)
    storageClass: {{ (ep_config | default({})).storage_class | default('STANDARD') }}
    # Server-side encryption method
    encryptionMethod: {{ (ep_config | default({})).encryption_method | default('none') }}
    # Workaround for '+' in filenames (store twice)
    plusWorkaround: {{ (ep_config | default({})).plus_workaround | default(false) | lower }}
    # Disable MultiDel API (use for non-AWS S3 providers)
    disableMultiDel: {{ (ep_config | default({})).disable_multi_del | default(false) | lower }}
    # Force SigV2 authentication (for non-AWS S3)
    forceSigV2: {{ (ep_config | default({})).force_sig_v2 | default(false) | lower }}
    # Force virtual-hosted-style S3 access
    forceVirtualHostedStyle: {{ (ep_config | default({})).force_virtual_hosted_style | default(false) | lower }}
{% endfor %}

# Swift (OpenStack Object Storage) publishing endpoints configuration.
SwiftPublishEndpoints:
{% for ep_name, ep_config in (swift_publish_endpoints | default({})) | dict2items %}
  {{ ep_name }}:
    # Swift container name
    container: {{ (ep_config | default({})).container | default('') }}
    # Prefix path within the container
    prefix: {{ (ep_config | default({})).prefix | default('') }}
    # OpenStack username (OSNAME)
    osname: {{ (ep_config | default({})).osname | default('') }}
    # OpenStack password (OSPASSWORD)
    password: {{ (ep_config | default({})).password | default('') }}
    # OpenStack tenant name
    tenant: {{ (ep_config | default({})).tenant | default('') }}
    # OpenStack tenant ID
    tenantid: {{ (ep_config | default({})).tenantid | default('') }}
    # Keystone auth URL (including version, e.g., https://identity.example.com:5000/v2.0)
    authurl: {{ (ep_config | default({})).authurl | default('') }}
{% endfor %}

# Azure Blob Storage publishing endpoints configuration.
AzurePublishEndpoints:
{% for ep_name, ep_config in (azure_publish_endpoints | default({})) | dict2items %}
  {{ ep_name }}:
    # Azure container name
    container: {{ (ep_config | default({})).container | default('') }}
    # Prefix path within the container
    prefix: {{ (ep_config | default({})).prefix | default('') }}
    # Azure storage account name
    accountName: {{ (ep_config | default({})).account_name | default('') }}
    # Azure storage account access key
    accountKey: {{ (ep_config | default({})).account_key | default('') }}
    # Azure endpoint URL
    endpoint: {{ (ep_config | default({})).endpoint | default('') }}
{% endfor %}

# Package pool storage backend configuration.
# Defines where downloaded packages are stored.
packagePoolStorage:
  # Pool type: 'local' or 'azure'
  type: {{ (package_pool_storage | default({})).type | default('local') }}
{% if (package_pool_storage | default({})).type | default('local') == 'local' %}
  # Local pool path. Empty string defaults to rootDir/pool.
  path: {{ (package_pool_storage | default({})).path | default('') }}
{% endif %}