# Persepolis Download Manager Configuration
#
# This file configures the Persepolis GUI frontend and its connection
# to the underlying aria2c download engine via the JSON-RPC interface.
# All values must have sensible defaults to ensure the service
# starts even if no upstream role has injected specific values.

# ------------------------------------------------------------------
# download_dir: The default directory where downloaded files are saved.
# Default: '/home/user/Downloads'
# ------------------------------------------------------------------
persepolis_download_dir: {{ (persepolis | default({})).download_dir | default('/home/user/Downloads') }}

# ------------------------------------------------------------------
# aria2_rpc_secret: Secret token for authenticating with the aria2 RPC interface.
# Default: 'persepolis_secret'
# ------------------------------------------------------------------
aria2_rpc_secret: {{ (persepolis | default({})).aria2_rpc_secret | default('persepolis_secret') }}

# ------------------------------------------------------------------
# aria2_rpc_host: The hostname or IP address where aria2 RPC service is listening.
# Default: '127.0.0.1'
# ------------------------------------------------------------------
aria2_rpc_host: {{ (persepolis | default({})).aria2_rpc_host | default('127.0.0.1') }}

# ------------------------------------------------------------------
# aria2_rpc_port: The port number where aria2 RPC service is listening.
# Default: 6800
# ------------------------------------------------------------------
aria2_rpc_port: {{ (persepolis | default({})).aria2_rpc_port | default(6800) }}

# ------------------------------------------------------------------
# max_connection_per_server: Maximum number of connections to one server for each download.
# Default: 16
# ------------------------------------------------------------------
max_connection_per_server: {{ (persepolis | default({})).max_connection_per_server | default(16) }}

# ------------------------------------------------------------------
# max_concurrent_downloads: Maximum number of concurrent downloads per task.
# Default: 5
# ------------------------------------------------------------------
max_concurrent_downloads: {{ (persepolis | default({})).max_concurrent_downloads | default(5) }}

# ------------------------------------------------------------------
# user_agent: User-Agent header to send for HTTP(S) downloads.
# Default: 'Persepolis Download Manager'
# ------------------------------------------------------------------
user_agent: {{ (persepolis | default({})).user_agent | default('Persepolis Download Manager') }}

# ------------------------------------------------------------------
# split: Whether to split files into multiple connections to increase download speed.
# Default: True
# ------------------------------------------------------------------
split: {{ (persepolis | default({})).split | default(true) | lower }}

# ------------------------------------------------------------------
# check_certificate: Whether to check the certificate of HTTPS servers.
# Default: True
# ------------------------------------------------------------------
check_certificate: {{ (persepolis | default({})).check_certificate | default(true) | lower }}

# ------------------------------------------------------------------
# aria2_dir: Directory where aria2 stores session data and configuration files.
# Default: '/var/lib/persepolis/aria2'
# ------------------------------------------------------------------
aria2_dir: {{ (persepolis | default({})).aria2_dir | default('/var/lib/persepolis/aria2') }}