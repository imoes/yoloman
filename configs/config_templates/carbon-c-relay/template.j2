# example configuration scenarios.
# Refer to /usr/share/doc/carbon-c-relay/README.md.gz for additional examples!

## mirror all incoming metrics towards two destinations
# send_through_destinations: host:port list; when set, every metric is forwarded to ALL of them.
{% if send_through_destinations is defined and send_through_destinations is not none and send_through_destinations | length > 0 %}cluster send-through
  forward
{% for d in send_through_destinations %}    {{ d }}
{% endfor %}  ;

match * send to send-through;
{% else %}#cluster send-through
#  forward
#    host1:2003
#    host2:2003
#  ;
#
#match * send to send-through;
{% endif %}

## send all incoming metrics to the first responsive host
# send_to_any_one_destinations: host:port list; when set, each metric goes to ONE responsive host.
{% if send_to_any_one_destinations is defined and send_to_any_one_destinations is not none and send_to_any_one_destinations | length > 0 %}cluster send-to-any-one
  any_of {{ send_to_any_one_destinations | join(' ') }};
match * send to send-to-any-one;
{% else %}#cluster send-to-any-one
#  any_of host1:2003 host2:2003;
#match * send to send-to-any-one;
{% endif %}
