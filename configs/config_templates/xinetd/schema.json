{
  "INETD_COMPAT": {
    "type": "string",
    "default": "Yes",
    "description": "Enable xinetd Inetd compatibility mode.",
    "enum": [
      "Yes",
      "No"
    ]
  },
  "XINETD_OPTS": {
    "type": "string",
    "default": "-stayalive",
    "description": "Options to pass to xinetd.",
    "enum": [
      "-stayalive",
      "-dontfork",
      "-syslog",
      "-filelog",
      "-f",
      "-pidfile",
      "-limit",
      "-logprocs",
      "-version",
      "-inetd_compat",
      "-cc"
    ]
  }
}
