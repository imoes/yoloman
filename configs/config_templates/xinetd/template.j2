# /etc/xinetd.conf: Default settings for xinetd.
# This file is sourced by /bin/sh from /etc/init.d/xinetd
#
# This configuration is managed by Ansible. Do not edit manually.

# ---------------------------------------------------------------------------
# INETD_COMPAT
# Description: Enable xinetd Inetd compatibility mode.
# Default: 'Yes'
# ---------------------------------------------------------------------------
# If set to 'Yes', xinetd will behave more like the classic inetd,
# providing backward compatibility with older service definitions.
INETD_COMPAT={{ INETD_COMPAT | default('Yes') }}

# ---------------------------------------------------------------------------
# XINETD_OPTS
# Description: Options to pass to xinetd.
# Default: '-stayalive'
# ---------------------------------------------------------------------------
# Additional command-line options passed to the xinetd daemon at startup.
# -stayalive is the default and allows persistent services (like telnet)
# to remain open for multiple connections if configured so.
# Remove or modify this option if xinetd is expected not to start
# when no service is configured, or if different behavior is required.
XINETD_OPTS="{{ XINETD_OPTS | default('-stayalive') }}"