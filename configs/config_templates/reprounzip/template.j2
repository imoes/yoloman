# Configuration for reprounzip
# This file controls the global behavior of the reprounzip tool.

# verbosity: The verbosity level (-v flag). 0 is silent, 1 enables verbose output.
# This directive sets how much detail reprounzip prints to standard output during
# execution.
verbosity: {{ verbosity | default(0) }}

# usage_report: Whether to enable or disable anonymous usage reports.
# Valid values are 'enable' or 'disable'. When enabled, reprounzip sends
# minimal, anonymous statistics to help improve the project.
usage_report: {{ usage_report | default('disable') }}