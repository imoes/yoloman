{
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output (-v)"
  },
  "timeout": {
    "type": "number",
    "default": 1,
    "description": "Wait timeout seconds for response (-t)"
  },
  "retransmits": {
    "type": "number",
    "default": 0,
    "description": "Number of retransmits (-m)"
  },
  "use_local_port": {
    "type": "bool",
    "default": false,
    "description": "Use local port 137 for scans (-r)"
  },
  "quiet": {
    "type": "bool",
    "default": false,
    "description": "Suppress banners and error messages (-q)"
  },
  "format_hosts": {
    "type": "bool",
    "default": false,
    "description": "Format output in /etc/hosts format (-e)"
  },
  "format_lmhosts": {
    "type": "bool",
    "default": false,
    "description": "Format output in lmhosts format (-l)"
  },
  "separator": {
    "type": "string",
    "default": " ",
    "description": "Script-friendly output separator (-s)"
  },
  "human_readable": {
    "type": "bool",
    "default": false,
    "description": "Print human-readable names for services (-h)"
  },
  "bandwidth": {
    "type": "number",
    "default": 0,
    "description": "Output throttling bandwidth in bps (-b). 0 for no throttling."
  },
  "dump_packets": {
    "type": "bool",
    "default": false,
    "description": "Dump packets (-d)"
  },
  "targets": {
    "type": "list",
    "default": [],
    "description": "List of target IP ranges or addresses. Example: 192.168.1.0/24, 192.168.1.25-137"
  },
  "target_file": {
    "type": "string",
    "default": "",
    "description": "File containing IP addresses to scan (-f). Empty string means use targets list."
  }
}
