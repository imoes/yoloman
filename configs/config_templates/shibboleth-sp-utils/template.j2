# Options passed to shibd by the init script.
# These options control how the Shibboleth Service Provider daemon starts.
#
# The default options are:
#     -f -c {{ shibboleth_config_path | default('/etc/shibboleth2.xml') }} -p $PIDFILE -w {{ shibd_timeout | default(30) }}
#
# If you change the -p option, also change the $PIDFILE variable to point to
# the new location or the init script won't work.
#DAEMON_OPTS=""

# Path to the Shibboleth SP configuration file.
# Specifies the location of the main XML configuration for the Shibboleth Service Provider.
DAEMON_OPTS="{{ '-f -c ' }}{{ shibboleth_config_path | default('/etc/shibboleth2.xml') }} -p $PIDFILE -w {{ shibd_timeout | default(30) }}"
