{
  "interface": "eth0",
  "not_promiscuous": true,
  "adjunct_mode": true,
  "adjunct_max_images": 100,
  "image_prefix": "capture-",
  "temp_dir": "/tmp/driftnet",
  "capture_audio": true,
  "audio_player": [
    "mpg123",
    "-q",
    "-"
  ],
  "drop_user": "nobody",
  "http_server": true,
  "http_port": 9091,
  "filter_expr": "port 80 or port 443"
}
