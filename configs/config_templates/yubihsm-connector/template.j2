# ==============================================================================
# YubiHSM Connector Configuration
# ==============================================================================
# This template configures the yubihsm-connector, a service that provides
# remote access to YubiHSM 2 devices over a TCP socket.
# ==============================================================================

# -----------------------------------------------------------------------------
# Certificate (X.509)
# Path to the X.509 certificate file for TLS client authentication.
# If empty, TLS certificate verification may be disabled or handled differently
# depending on the connector version.
# -----------------------------------------------------------------------------
cert: "{{ cert | default('') }}"

# -----------------------------------------------------------------------------
# Certificate Key
# Path to the certificate private key file corresponding to the `cert`.
# -----------------------------------------------------------------------------
key: "{{ key | default('') }}"

# -----------------------------------------------------------------------------
# Listening Address
# The address and port on which the connector service listens for incoming
# connections from clients (e.g., HSM SDK applications).
# Format: host:port (e.g., 127.0.0.1:12345)
# -----------------------------------------------------------------------------
listen: "{{ listen | default('127.0.0.1:12345') }}"

# -----------------------------------------------------------------------------
# Device Serial Number
# The serial number of the YubiHSM device to use when multiple devices are
# present. If empty and multiple devices are detected, the connector may
# fail to start or pick the first available device depending on configuration.
# -----------------------------------------------------------------------------
serial: "{{ serial | default('') }}"

# -----------------------------------------------------------------------------
# Syslog Logging
# Enable logging to syslog/eventlog.
# Values: true, false
# -----------------------------------------------------------------------------
syslog: "{{ syslog | default('false') }}"
