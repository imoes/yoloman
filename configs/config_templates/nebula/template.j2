# Nebula is an overlay networking tool that creates secure, scalable, and intelligent networks
# Define the server (listening) address and port for this node
listen: {{ listen_addr }}

# Port on which Nebula will listen for incoming connections
port: {{ port }}

# Public IP address of this host as seen by other nodes (for NAT traversal)
ip: {{ ip }}

# CIDR mask for the overlay network (e.g., 192.168.100.1/24)
subnet: {{ subnet }}

# Maximum transmission unit (MTU) for the tun interface
mtu: {{ mtu }}

# TLS certificate and key paths for mutual authentication
cert_file: {{ cert_file }}
key_file: {{ key_file }}
ca_file: {{ ca_file }}

# Optional: Lighthouse settings for dynamic discovery (only required on lighthouse nodes)
{% if lighthouse %}
lighthouse:
  # Run as a lighthouse node (part of the discovery mesh)
  host: true
  # Interval between lighthouse beacons (in seconds)
  interval: {{ lighthouse_interval }}
  # Optional: External lighthouse addresses to query for bootstrap
  {% if lighthouse_remotes %}
  remotes:
    {% for r in lighthouse_remotes %}
    - {{ r.host }}:{{ r.port }}
    {% endfor %}
  {% endif %}
{% endif %}

# Optional: Static host mapping (for known, fixed peers)
{% if static_host_mapping %}
static_host_map:
  {% for ip, hosts in static_host_mapping.items() %}
  "{{ ip }}":
    {% for h in hosts %}
    - "{{ h }}"
    {% endfor %}
  {% endfor %}
{% endif %}

# Relay configuration (to forward traffic between peers behind symmetric NATs)
{% if relays %}
relay:
  # Enable relay mode (only on nodes intended to act as relays)
  relays: {{ relays_enabled | string | lower }}
  # Optional: List of explicit relay hosts
  {% if relay_hosts %}
  hosts:
    {% for h in relay_hosts %}
    - "{{ h }}"
    {% endfor %}
  {% endif %}
{% endif %}

# Firewall configuration: define rules for traffic between groups and hosts
firewall:
  # Direction of traffic this node should process
  outbound: {{ firewall_outbound }}
  inbound: {{ firewall_inbound }}
  # Default policy for traffic not matching any rule
  default_outbound_action: {{ firewall_default_outbound_action }}
  default_inbound_action: {{ firewall_default_inbound_action }}
  # Rules for traffic between groups/hosts
  {% if firewall_rules %}
  rules:
    {% for rule in firewall_rules %}
    - proto: {{ rule.proto | default('') }}
      port: {{ rule.port | default('') }}
      group: {{ rule.group | default('') }}
      host: {{ rule.host | default('') }}
      action: {{ rule.action }}
    {% endfor %}
  {% endif %}
{% endif %}

# Optional: Tun interface settings (Linux-specific)
{% if tun %}
tun:
  # Device name (e.g., 'nebula0')
  dev: {{ tun.dev }}
  # Disable offloading features to avoid kernel issues
  disabled_offloads: {{ tun.disabled_offloads | join(', ') }}
{% endif %}

# Logging configuration
log:
  # Level: debug, info, warn, error
  level: {{ log_level }}
  # Format: json or text
  format: {{ log_format }}
  {% if log_file %}
  # Optional: file to write logs to
  file: {{ log_file }}
  {% endif %}

# Optional: Preshared key for additional encryption (per-connection, optional)
{% if psk_file %}
psk_file: {{ psk_file }}
{% endif %}

# Optional: Control port for local management (e.g., health checks, metrics)
{% if control %}
control:
  listen: {{ control.listen }}
  {% if control_cert %}
  cert_file: {{ control_cert.cert_file }}
  key_file: {{ control_cert.key_file }}
  ca_file: {{ control_cert.ca_file }}
  {% endif %}
{% endif %}

# Optional: Prometheus metrics endpoint (if enabled)
{% if metrics %}
metrics:
  listen: {{ metrics.listen }}
{% endif %}

# Optional: Pulse configuration for node health probing
{% if pulse %}
pulse:
  enabled: {{ pulse.enabled | string | lower }}
  interval: {{ pulse.interval }}
{% endif %}

# Optional: Certificate rotation config
{% if cert_expiry %}
cert_expiry:
  warn_days: {{ cert_expiry.warn_days }}
  renew_days: {{ cert_expiry.renew_days }}
{% endif %}
