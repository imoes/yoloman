# ipgrab configuration file - generated by template
# Listen address and port for the HTTP server
listen: {{ listen_address }}:{{ listen_port }}

# Directory to store captured packets and metadata
storage_dir: {{ storage_dir }}

# Maximum number of concurrent capture sessions
max_sessions: {{ max_sessions }}

# Maximum bytes to capture per packet (0 = unlimited)
max_packet_bytes: {{ max_packet_bytes }}

# Interface(s) to capture on (space-separated list)
interfaces: {{ interfaces | join(' ') }}

# Enable packet logging to file (on/off)
log_packets: {{ log_packets }}

# Rotate log files when they exceed this size (in MB)
log_rotate_size: {{ log_rotate_size }}

# Number of rotated logs to keep
log_rotate_count: {{ log_rotate_count }}

# Comma-separated list of destination IPs to exclude (e.g., 192.168.0.0/16,10.0.0.0/8)
exclude_ips: {{ exclude_ips | join(',') }}

# Enable BPF filter for selective capture (empty = capture all)
filter_bpf: {{ filter_bpf }}

{% for host in tcp_hosts %}# TCP host monitoring entry
host: {{ host.hostname }}:{{ host.port }}
{% endfor %}

# Enable TLS for management API (on/off)
tls_api: {{ tls_api }}

# Path to TLS certificate for API
tls_cert: {{ tls_cert }}

# Path to TLS private key for API
tls_key: {{ tls_key }}

# Enable debug logging (on/off)
debug: {{ debug }}

# Syslog facility to use (e.g., daemon, local0, etc.)
syslog_facility: {{ syslog_facility }}

# Path to PID file
pid_file: {{ pid_file }}