# ipgrab configuration file
#
# This file configures the ipgrab packet capture and monitoring daemon.
# It defines network binding, storage, filtering, and monitoring parameters.

# IP address to bind the HTTP server to (e.g., 127.0.0.1 for localhost only, or 0.0.0.0 for all interfaces).
# Default: 0.0.0.0
listen: {{ (listen_address | default('0.0.0.0')) }}:{{ (listen_port | default(8080)) }}

# Directory where captured packets and metadata will be stored on disk.
# Default: /var/lib/ipgrab
storage_dir: {{ storage_dir | default('/var/lib/ipgrab') }}

# Maximum number of concurrent capture sessions allowed.
# Default: 10
max_sessions: {{ max_sessions | default(10) }}

# Maximum number of bytes to capture per packet. Set to 0 for unlimited (full packet capture).
# Default: 0
max_packet_bytes: {{ max_packet_bytes | default(0) }}

# List of network interfaces to capture traffic on.
# Rendered as a space-separated list.
# Default: ['eth0']
interfaces: {{ interfaces | default(['eth0']) | join(' ') }}

# Whether to write raw captured packets to log files.
# Rendered as a boolean string representation.
# Default: true
log_packets: {{ log_packets | default(true) | lower }}

# Size (in MB) at which packet logs are rotated.
# Default: 100
log_rotate_size: {{ log_rotate_size | default(100) }}

# Number of old log files to retain after rotation.
# Default: 5
log_rotate_count: {{ log_rotate_count | default(5) }}

# List of IP addresses or CIDR subnets to exclude from capture (e.g., internal loopback ranges).
# Rendered as a comma-separated list.
# Default: ['127.0.0.0/8', '::1/128']
exclude_ips: {{ exclude_ips | default(['127.0.0.0/8', '::1/128']) | join(',') }}

# Berkeley Packet Filter (BPF) expression to selectively capture traffic (e.g., 'tcp port 80').
# Empty string means capture all traffic.
# Default: ''
filter_bpf: {{ filter_bpf | default('') }}

# List of TCP services to monitor for connectivity (not part of packet capture, but for active health checks).
# Each entry is an object with 'hostname' and 'port' fields.
{% for host in tcp_hosts | default([]) %}# TCP host monitoring entry
host: {{ host.hostname }}:{{ host.port }}
{% endfor %}

# Enable TLS (HTTPS) for the management API endpoint.
# Default: false
tls_api: {{ tls_api | default(false) | lower }}

# Path to the TLS certificate file for the management API.
# Default: /etc/ipgrab/tls/cert.pem
tls_cert: {{ tls_cert | default('/etc/ipgrab/tls/cert.pem') }}

# Path to the TLS private key file for the management API.
# Default: /etc/ipgrab/tls/key.pem
tls_key: {{ tls_key | default('/etc/ipgrab/tls/key.pem') }}

# Enable verbose debug logging to stdout and logs.
# Default: false
debug: {{ debug | default(false) | lower }}

# Syslog facility to use when logging to the system journal (e.g., daemon, local0).
# Default: daemon
syslog_facility: {{ syslog_facility | default('daemon') }}

# Path to the PID file used to track the main process.
# Default: /run/ipgrab/ipgrab.pid
pid_file: {{ pid_file | default('/run/ipgrab/ipgrab.pid') }}