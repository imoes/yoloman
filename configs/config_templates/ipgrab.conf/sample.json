{
  "listen_address": "0.0.0.0",
  "listen_port": 8080,
  "storage_dir": "/var/lib/ipgrab",
  "max_sessions": 20,
  "max_packet_bytes": 0,
  "interfaces": [
    "eth0",
    "eth1"
  ],
  "log_packets": true,
  "log_rotate_size": 200,
  "log_rotate_count": 3,
  "exclude_ips": [
    "127.0.0.0/8",
    "192.168.0.0/16",
    "::1/128"
  ],
  "filter_bpf": "tcp port 443",
  "tcp_hosts": [
    {
      "hostname": "api.example.com",
      "port": 443
    },
    {
      "hostname": "cdn.example.net",
      "port": 80
    }
  ],
  "tls_api": true,
  "tls_cert": "/etc/ssl/ipgrab/cert.pem",
  "tls_key": "/etc/ssl/ipgrab/key.pem",
  "debug": false,
  "syslog_facility": "local0",
  "pid_file": "/run/ipgrab/ipgrab.pid"
}
