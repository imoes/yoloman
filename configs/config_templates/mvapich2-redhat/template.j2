# Module file for MVAPICH2
# This template generates an environment-modules configuration file to set up
# the MVAPICH2 HPC toolkit environment variables, library paths, and compiler
# toolchain identifiers for the current shell session.
#
# Usage: module load mvapich2
#
# Generated by Ansible Jinja2 template.

# Prevent loading multiple MPI implementations simultaneously
conflict		mpi

# Add MVAPICH2 binary directory to PATH so mpiexec, mpicc, etc. are found
prepend-path 		PATH 		{{ mvapich2_prefix | default('/usr/lib/mvapich2') }}/bin

# Add MVAPICH2 library directory to LD_LIBRARY_PATH for runtime linking
prepend-path 		LD_LIBRARY_PATH {{ mvapich2_prefix | default('/usr/lib/mvapich2') }}/lib

# Add pkg-config path so build systems can find MVAPICH2 .pc files
prepend-path 		PKG_CONFIG_PATH	{{ mvapich2_prefix | default('/usr/lib/mvapich2') }}/lib/pkgconfig

# Add MVAPICH2 Python package path to PYTHONPATH
prepend-path		PYTHONPATH	{{ python_packages_path | default('/usr/lib/python3.9/site-packages') }}/mvapich2

# Add MVAPICH2 manual page directory to MANPATH
prepend-path		MANPATH		{{ mvapich2_man_path | default('/usr/share/man/mvapich2-i386') }}

# Set environment variable pointing to MVAPICH2 binary location
setenv 			MPI_BIN		{{ mvapich2_prefix | default('/usr/lib/mvapich2') }}/bin

# Set environment variable pointing to MVAPICH2 system configuration directory
setenv			MPI_SYSCONFIG	{{ mvapich2_sysconfig | default('/etc/mvapich2-i386') }}

# Set environment variable pointing to Fortran module directory
setenv			MPI_FORTRAN_MOD_DIR	{{ mvapich2_fortran_mod_dir | default('/usr/lib/gfortran/modules/mvapich2') }}

# Set environment variable pointing to C/C++ include directory for headers
setenv			MPI_INCLUDE	{{ mvapich2_include | default('/usr/include/mvapich2-i386') }}

# Set environment variable pointing to MVAPICH2 library directory
setenv 			MPI_LIB		{{ mvapich2_prefix | default('/usr/lib/mvapich2') }}/lib

# Set environment variable pointing to MVAPICH2 man page location
setenv			MPI_MAN		{{ mvapich2_man_path | default('/usr/share/man/mvapich2-i386') }}

# Set environment variable pointing to Python 3 site-packages for MVAPICH2
setenv			MPI_PYTHON_SITEARCH	{{ mvapich2_python_sitearch | default('/usr/lib/python3.9/site-packages/mvapich2') }}

# Set environment variable pointing to Python 2 site-packages for MVAPICH2 (legacy)
setenv			MPI_PYTHON2_SITEARCH	{{ mvapich2_python2_sitearch | default('/usr/lib/python3.9/site-packages/mvapich2') }}

# Set environment variable pointing to Python 3 specific site-packages for MVAPICH2
setenv			MPI_PYTHON3_SITEARCH	{{ mvapich2_python3_sitearch | default('/usr/lib/python3.9/site-packages/mvapich2') }}

# Set environment variable identifying the MVAPICH2 compiler toolchain name
setenv			MPI_COMPILER	{{ mvapich2_compiler | default('mvapich2-i386') }}

# Set environment variable for the MVAPICH2 library suffix (used for naming .so files)
setenv			MPI_SUFFIX	_mvapich2

# Set MPI_HOME environment variable to the installation prefix
setenv 			MPI_HOME	{{ mvapich2_prefix | default('/usr/lib/mvapich2') }}
