{
  "listen_addresses": [
    {
      "host": "0.0.0.0",
      "port": 67
    },
    {
      "host": "[fe80::1]",
      "port": 67
    }
  ],
  "plugins": [
    {
      "name": "serverid",
      "args": [
        "-file",
        "/etc/coredhcp/server-id"
      ]
    },
    {
      "name": "range",
      "args": [
        "-ipv4",
        "192.168.1.10",
        "192.168.1.200",
        "24",
        "-gateway",
        "192.168.1.1",
        "-dns",
        "8.8.8.8",
        "8.8.4.4"
      ]
    },
    {
      "name": "range6",
      "args": [
        "-ipv6",
        "2001:db8:1::10",
        "2001:db8:1::100",
        "64"
      ]
    },
    {
      "name": "hosts",
      "args": [
        "-file",
        "/etc/hosts"
      ]
    }
  ],
  "static_hosts": [
    {
      "hostname": "printer1",
      "mac": "00:1a:2b:3c:4d:5e",
      "ipv4": "192.168.1.50"
    },
    {
      "hostname": "server1",
      "mac": "bc:dd:c2:33:44:55",
      "ipv4": "192.168.1.100",
      "ipv6": "2001:db8:1::1000"
    }
  ],
  "log_level": "info",
  "lease_file": "/var/lib/coredhcp/leases.dat",
  "shutdown_timeout": 5
}
