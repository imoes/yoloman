{
  "mirror_host": "ftp2.de.debian.org",
  "remote_path": "/debian",
  "local_path": "/srv/mirror/debian",
  "arch": [
    "amd64",
    "arm64"
  ],
  "dist": [
    "bookworm",
    "bookworm-updates",
    "bookworm-security"
  ],
  "section": [
    "main",
    "contrib",
    "non-free",
    "non-free-firmware"
  ],
  "proto": "http",
  "passive": true,
  "nosource": true,
  "cleanup": true,
  "i18n": true,
  "ignore_missing_info": false,
  "diff_mode": "use",
  "timeout": 300,
  "retries": 5,
  "max_batch": 0,
  "keyring": "/usr/share/keyrings/debian-archive-keyring.gpg",
  "log_file": "/var/log/debmirror.log",
  "rsync_bwlimit": 0,
  "exclude": [
    "~$"
  ],
  "postscript": ""
}
