# /etc/debmirror.conf
# Managed by Ansible -- do not edit by hand
#
# This is the configuration file for debmirror(1).
# It defines the upstream Debian mirror, the local storage location,
# which architectures/distributions/sections to pull, and network tuning.

# Hostname of the upstream Debian mirror (e.g. ftp.debian.org, ftp.de.debian.org, or a local CDN)
# See: https://www.debian.org/mirror/list
$host = "{{ mirror_host | default('ftp.debian.org') }}";

# Absolute path on the remote mirror host that forms the root of the Debian archive.
# Almost always '/debian' for official mirrors.
$inPath = "{{ remote_path | default('/debian') }}";

# Absolute local filesystem path where the mirrored package files will be stored.
# Ensure the directory exists and has sufficient free space.
$outPath = "{{ local_path | default('/var/spool/debmirror') }}";

# CPU architectures to mirror. Use 'all' to include architecture-independent packages.
# Common values: 'amd64', 'arm64', 'i386', 'all'.
@arch = (
{%- for a in (arch | default(['amd64'])) %}
    "{{ a }}"{{ "," if not loop.last else "" }}
{%- endfor %}
);

# Distribution suites to mirror (codenames or aliases like 'stable', 'bookworm-updates', 'bookworm-security').
@dist = (
{%- for d in (dist | default(['bookworm', 'bookworm-updates', 'bookworm-security'])) %}
    "{{ d }}"{{ "," if not loop.last else "" }}
{%- endfor %}
);

# Repository sections to include. 'main' is essential; 'contrib' and 'non-free*' provide additional/driver packages.
@section = (
{%- for s in (section | default(['main', 'contrib', 'non-free', 'non-free-firmware'])) %}
    "{{ s }}"{{ "," if not loop.last else "" }}
{%- endfor %}
);

# Transfer protocol: 'http' (recommended for public mirrors), 'ftp', 'hftp', or 'rsync' (fastest for sustained sync).
$proto = "{{ proto | default('http') }}";

# Enable passive FTP mode (1/0). Leave on unless the server explicitly requires active mode.
# Ignored if proto != 'ftp'.
$passive = {{ passive | default(True) | ternary(1, 0) }};

# Omit source packages (.dsc, .diff, .orig) to save ~30-40% disk space (1/0).
# Set to 0 if you need a buildable mirror.
$nosource = {{ nosource | default(False) | ternary(1, 0) }};

# Remove local files that no longer exist on the upstream mirror (1/0).
# Recommended for keeping the mirror clean and small.
$cleanup = {{ cleanup | default(True) | ternary(1, 0) }};

# Mirror i18n Translation files for non-English package descriptions (1/0).
$i18n = {{ i18n | default(True) | ternary(1, 0) }};

# Suppress fatal errors when package-info entries are missing (1/0).
# Useful for partial or unofficial mirrors.
$ignore_missing_info = {{ ignore_missing_info | default(False) | ternary(1, 0) }};

# Diff handling strategy: 'use' (apply upstream diffs), 'mirror' (store diffs), 'generate' (create locally), 'none'.
$diff_mode = "{{ diff_mode | default('use') }}";

# Seconds to wait before abandoning a stalled network connection.
$timeout = {{ timeout | default(300) }};

# Number of times to retry a failed file download.
$retries = {{ retries | default(5) }};

# Maximum number of package files to download in a single run. 0 means unlimited.
$max_batch = {{ max_batch | default(0) }};

# Path to the GPG keyring file used to verify Release file signatures.
$keyring = "{{ keyring | default('/usr/share/keyrings/debian-archive-keyring.gpg') }}";

# Path to the log file. Set to '' to send logs to stdout (useful for systemd).
$log_file = "{{ log_file | default('/var/log/debmirror.log') }}";

# Bandwidth cap in KB/s passed to rsync via --bwlimit. 0 disables the cap.
# Only used when proto is 'rsync'.
{% if proto | default('http') == "rsync" and rsync_bwlimit | default(0) > 0 %}
$rsync_extra = "--bwlimit={{ rsync_bwlimit | default(0) }}";
{% endif %}

# Perl-compatible regex patterns matched against file paths; matching files are skipped.
{% if exclude | default([]) | length > 0 %}
@exclude = (
{%- for e in exclude | default([]) %}
    "{{ e }}"{{ "," if not loop.last else "" }}
{%- endfor %}
);
{% endif %}

# Shell command or script path executed once after a successful mirror run.
{% if postscript | default('') | length > 0 %}
$postscript = "{{ postscript | default('') }}";
{% endif %}

# Required: a Perl config file included with 'do' must return a true value.
1;