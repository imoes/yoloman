# ==============================================================================
# fwknop-server configuration template
# ==============================================================================
# This file configures the Single Packet Authorization (SPA) daemon, fwknopd.
# fwknopd provides port-knocking functionality, allowing access to services
# only after a specific sequence of packets (a "knock") is received.
# ==============================================================================

# -----------------------------------------------------------------------------
# START_DAEMON
# -----------------------------------------------------------------------------
# Description: Set to 'yes' to start fwknopd at boot time.
#              Set to 'no' if you manage the daemon lifecycle externally
#              (e.g., via systemd or supervisor).
# -----------------------------------------------------------------------------
START_DAEMON="{{ START_DAEMON | default('no') }}"

# -----------------------------------------------------------------------------
# DAEMON_ARGS
# -----------------------------------------------------------------------------
# Description: Additional arguments to pass to fwknopd on startup.
#              Common options include --override-config to specify alternative
#              configuration files or --debug for verbose logging.
# Example: DAEMON_ARGS="--override-config /etc/fwknop/fwknopd.conf"
# -----------------------------------------------------------------------------
DAEMON_ARGS="{{ DAEMON_ARGS | default('') }}"