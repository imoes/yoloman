# ==============================================================================
# fwknop-server daemon configuration template
# ==============================================================================
# This template configures the startup behavior of the fwknopd (FireWall KNock Over
# Plain OPen) daemon. It manages whether the service starts at boot and passes
# additional command-line arguments to the daemon.
# ==============================================================================

{% if START_DAEMON | default('no') == 'yes' %}
# --------------------------------------------------------------------------
# START_DAEMON: Controls whether fwknopd is started automatically at boot.
# Schema Default: 'no'
# Description: Set to 'yes' to start fwknopd at boot time.
# --------------------------------------------------------------------------
START_DAEMON={{ START_DAEMON | default('no') }}
{% else %}
# --------------------------------------------------------------------------
# START_DAEMON: fwknopd will NOT start automatically at boot.
# Schema Default: 'no'
# --------------------------------------------------------------------------
START_DAEMON={{ START_DAEMON | default('no') }}
{% endif %}

# --------------------------------------------------------------------------
# DAEMON_ARGS: Additional command-line arguments passed to fwknopd on startup.
# Schema Default: '' (empty)
# Description: Additional arguments to pass to fwknopd on startup (e.g., --override-config path).
# --------------------------------------------------------------------------
DAEMON_ARGS={{ DAEMON_ARGS | default('') }}
