{
  "service_dbus_dest": {
    "type": "string",
    "default": "com.deepin.dataserver.Calendar",
    "description": "D-Bus service destination name"
  },
  "service_dbus_path": {
    "type": "string",
    "default": "com/deepin/dataserver/Calendar/AccountManager",
    "description": "D-Bus object path"
  },
  "service_dbus_interface": {
    "type": "string",
    "default": "deepin.dataserver.Calendar.AccountManager",
    "description": "D-Bus interface name (without leading 'com.' since it's prepended in template)"
  },
  "service_dbus_method": {
    "type": "string",
    "default": "updateRemindJob",
    "description": "D-Bus method name"
  },
  "name": {
    "type": "string",
    "default": "dde-calendar-service",
    "description": "Service name"
  },
  "no_display": {
    "type": "string",
    "default": "true",
    "description": "Whether to hide from desktop menus (must be 'true' or 'false' as string)",
    "enum": [
      "true",
      "false"
    ]
  },
  "terminal": {
    "type": "string",
    "default": "false",
    "description": "Whether to open in terminal (must be 'true' or 'false' as string)",
    "enum": [
      "true",
      "false"
    ]
  },
  "type": {
    "type": "string",
    "default": "Application",
    "description": "Desktop entry type"
  },
  "vendor": {
    "type": "string",
    "default": "user-custom",
    "description": "Vendor identifier for Deepin-specific extensions"
  }
}
