{
  "server": {
    "host": "ldap.example.com",
    "port": 389,
    "basedn": "dc=example,dc=com",
    "binddn": "cn=admin,dc=example,dc=com",
    "bindpw": "secretpassword",
    "tls": true,
    "ssl_verify": false
  },
  "config_dir": "/etc/ldap-account-manager/config",
  "template_dir": "/usr/share/ldap-account-manager/templates",
  "log": {
    "level": "WARN",
    "file": "/var/log/lam/lam.log"
  },
  "session": {
    "timeout": 900,
    "cookie_name": "LAMSESSID"
  },
  "auth": {
    "module": "ldap",
    "ldap_basedn": "ou=Users,dc=example,dc=com",
    "ldap_search_filter": "(&(uid=%s)(objectClass=posixAccount))"
  },
  "ui": {
    "theme": "dark",
    "language": "en",
    "show_password_policy": true
  },
  "password_policy": {
    "enabled": true,
    "min_length": 14,
    "min_lowercase": 2,
    "min_uppercase": 2,
    "min_numbers": 2,
    "min_symbols": 1
  },
  "modules": {
    "groups": [
      "posixgroup",
      "ldapgroup",
      "nisNetgroup"
    ],
    "users": [
      "posixaccount",
      "shadowAccount",
      "mailAccount"
    ],
    "hosts": [
      "posixhost",
      "nisNetgroup"
    ]
  },
  "domains": [
    {
      "name": "backup",
      "server": {
        "host": "ldap-backup.example.com",
        "port": 636,
        "basedn": "ou=Users,dc=backup,dc=com",
        "binddn": "cn=admin,dc=backup,dc=com",
        "bindpw": "backupsecret"
      }
    }
  ]
}
