{
  "mirror_base": "/mirror",
  "arches": [
    "amd64",
    "i386"
  ],
  "dists": [
    "bookworm",
    "bullseye"
  ],
  "sections": [
    "main",
    "contrib",
    "non-free"
  ],
  "method": "http",
  "remote_host": "deb.debian.org",
  "remote_dir": "/debian",
  "local_dir": "/var/www/mirror/debian",
  "arch_filter": [],
  "exclude_sections": [],
  "exclude_packages": [
    "firmware-bnx2x",
    "linux-image-686-pae"
  ],
  "include_packages": [],
  "compression": "gzip",
  "udebs": false,
  "debug": false,
  "skip_nonfree": true,
  "skip_contrib": false,
  "skip_source": true,
  "skip_translations": true,
  "rsync_options": "--progress --delete-during",
  "rsync_extra_options": "",
  "proxy_url": "http://proxy.local:3128/",
  "gzip_indices": true,
  "timeout": 300,
  "retries": 3,
  "logfile": "/var/log/debmirror.log",
  "md5sum_check": true,
  "gpg_sign": false,
  "gpg_keyring": "",
  "gpg_sign_key": ""
}
