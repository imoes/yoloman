# ============================================================
# apticron-systemd configuration
# ============================================================
# This file is sourced by the apticron systemd service. Any settings in a
# named 'apticron.conf' file in this directory will override the default
# apticron options. You may want to copy the original '/usr/lib/apticron/apticron.conf'
# in here and use it as a base.
#
# *Do not* edit the original /usr/lib/apticron/apticron.conf, or you will lose
# your local settings during the next apticron upgrade.

# The email address to which apticron will send updates.
MAIL_TO="{{ MAIL_TO | default('root') }}"

# The SMTP server to use for sending emails.
SMTP_SERVER="{{ SMTP_SERVER | default('127.0.0.1') }}"

# If set to true, only send email if there are security updates.
MINIMAL_UPDATES="{{ MINIMAL_UPDATES | default(false) | lower }}"

# Prefix for the subject line of the email.
EMAIL_SUBJECT_PREFIX="{{ EMAIL_SUBJECT_PREFIX | default('[apticron] ') }}"

# Additional text to include at the bottom of the email.
EMAIL_FOOTER="{{ EMAIL_FOOTER | default('') }}"

# If set to true, only list packages that can be upgraded.
LIST_ONLY_UPGRADES="{{ LIST_ONLY_UPGRADES | default(false) | lower }}"

# If set to true, list kernel packages separately.
SHOW_KERNES="{{ SHOW_KERNES | default(false) | lower }}"

# Path to a custom apt config file.
APT_CONFIG_FILE="{{ APT_CONFIG_FILE | default('') }}"

# Whether to run apticron via cron.daily.
CRON_DAILY_RUN="{{ CRON_DAILY_RUN | default(true) | lower }}"

# If set to true, do not list the packages in the email, just notify.
NO_LIST="{{ NO_LIST | default(false) | lower }}"