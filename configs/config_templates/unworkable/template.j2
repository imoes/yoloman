# Configuration file for unworkable BitTorrent client
#
# This template is self-documenting. Each configuration directive is preceded by a comment
# describing its purpose, sourced from the Ansible role schema. All variables are safely
# defaulted to their schema defaults to prevent rendering errors when optional values are omitted.

# Port number to run the GUI control server. Set to 0 to disable.
# Corresponds to the -g command-line option.
control_server_port = {{ control_server_port | default(0) }}

# Port number to listen for incoming BitTorrent peer connections. Set to 0 to disable.
# Corresponds to the -p command-line option.
peer_listen_port = {{ peer_listen_port | default(0) }}

# Whether to enable seed-mode (keep running and seed after download completes).
# Corresponds to the -s command-line flag.
seed_mode = {{ seed_mode | default(false) | lower }}

# Path to the file where trace execution output should be written.
# Corresponds to the -t command-line option. If empty, tracing is disabled.
trace_file = {{ trace_file | default('') }}