{
  "device_path": "/dev/input/event0",
  "sensitivity": 60,
  "enabled": true,
  "hysteresis": 250,
  "loglevel": 3,
  "protect_cmd": "/usr/sbin/sdparm --standby=1 /dev/sda",
  "relax_cmd": "/usr/sbin/sdparm --clear=STANDBY /dev/sda",
  "sample_interval": 75,
  "min_move": 8,
  "raise_count": 4,
  "fall_count": 2,
  "axes": [
    "x",
    "y"
  ]
}
