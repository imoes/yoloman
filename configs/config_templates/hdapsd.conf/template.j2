# Which device(s) should be protected by hdapsd?
# Can be either a single string (one device):
{% if device is defined and device is not none and (device is number or device is boolean or device | length > 0) %}{% if device is string %}device="{{ device }}";{% else %}device=[{% for d in device %}"{{ d }}"{{ ", " if not loop.last else "" }}{% endfor %}];{% endif %}
{% else %}#  device="sda";
{% endif %}# Or an array of strings (multiple devices):
#  device=["sda", "sdb"];
# Will be autodetected if not set.

# How sensitive should hdapsd be? Defaults to 15.
# You probably want to change this.
{% if sensitivity is defined and sensitivity is not none and sensitivity != '' %}sensitivity={{ sensitivity }};
{% else %}#  sensitivity=15;
{% endif %}
# Enables adaptive mode, where hdapsd adjusts the sensitity
# while the mouse and keyboard are used.
# You probably want to enable this.
{% if adaptive is defined and adaptive is not none and adaptive != '' %}adaptive={{ 'true' if adaptive | bool else 'false' }};
{% else %}#  adaptive=true;
{% endif %}
# Run hdapsd in background as a daemon.
{% if background is defined and background is not none and background != '' %}background={{ 'true' if background | bool else 'false' }};
{% else %}#  background=true;
{% endif %}
# Write a pid file.
{% if pidfile is defined and pidfile is not none and pidfile != '' %}pidfile="{{ pidfile }}";
{% else %}#  pidfile="/var/run/hdapsd.pid";
{% endif %}
# Enable logging to syslog.
{% if syslog is defined and syslog is not none and syslog != '' %}syslog={{ 'true' if syslog | bool else 'false' }};
{% else %}#  syslog=true;
{% endif %}