{
  "enable_cri": true,
  "state_dir": "/run/containerd",
  "snapshotter": "overlayfs",
  "default_runtime_name": "runc",
  "no_pivot": false,
  "overlayfs_native_diff": true,
  "registry_mirrors": [
    {
      "host": "docker.io",
      "endpoints": [
        "https://mirror.gcr.io"
      ]
    }
  ],
  "registry_configs": [
    {
      "host": "myprivate.registry.com",
      "username": "deploy",
      "password": "s3cr3t"
    }
  ],
  "registry_tls_configs": [
    {
      "host": "internal-registry.local",
      "ca_file": "/etc/containerd/certs/internal-ca.crt",
      "cert_file": "",
      "key_file": "",
      "insecure_skip_verify": false
    }
  ],
  "sandbox_image": "registry.k8s.io/pause:3.9",
  "image_pull_timeout": 120,
  "cni_bin_dir": "/opt/cni/bin",
  "cni_conf_dir": "/etc/cni/net.d",
  "cni_default_network": {
    "conf_file": "/etc/cni/net.d/10-flannel.conf",
    "ip_range": "10.244.0.0/16"
  },
  "stream_address": "127.0.0.1",
  "stream_port": 0,
  "max_container_log_size": 16384,
  "image_deletion": true,
  "grpc_address": "/run/containerd/containerd.sock",
  "grpc_max_recv_message_size": 16777216,
  "grpc_max_send_message_size": 16777216,
  "debug_level": "info",
  "pprof_enabled": false,
  "pprof_address": "",
  "metrics_address": "0.0.0.0:1338",
  "metrics_interval": 60,
  "root_dir": "/var/lib/containerd",
  "privileged_without_host_devices": false,
  "devmapper_pool_name": "",
  "devmapper_base_image_size": "10GB"
}
