{
  "server_name": "example.com",
  "server_aliases": [
    "www.example.com",
    "example.org"
  ],
  "document_root": "/var/www/html/example",
  "port": 80,
  "ssl_enabled": false,
  "ssl_cert_file": "",
  "ssl_cert_key_file": "",
  "ssl_chain_file": "",
  "directories": [
    {
      "path": "/var/www/html/example",
      "options": "-Indexes +FollowSymLinks",
      "allow_override": "All",
      "require": "all granted"
    },
    {
      "path": "/var/www/html/example/admin",
      "options": "+Indexes",
      "allow_override": "AuthConfig",
      "require": "ip 10.0.0.0/8"
    }
  ]
}
