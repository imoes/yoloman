{# Apache <VirtualHost> for one site. The whole file is rendered from values —
   never hand-edited. TLS terminates here when tls_enabled (needs mod_ssl; the
   snapin runs a2enmod ssl on Debian). Debian: drop in sites-available + a2ensite;
   RedHat: drop in conf.d. #}
{% if tls_enabled and redirect_to_https %}
# HTTP -> HTTPS redirect (own vhost)
<VirtualHost *:80>
    ServerName {{ server_name }}
{% if server_alias %}
    ServerAlias {{ server_alias }}
{% endif %}
    Redirect permanent / https://{{ server_name }}/
</VirtualHost>
{% endif %}
<VirtualHost *:{% if tls_enabled %}443{% else %}{{ listen_port|default(80) }}{% endif %}>
    ServerName {{ server_name }}
{% if server_alias %}
    ServerAlias {{ server_alias }}
{% endif %}
    DocumentRoot {{ document_root }}
    DirectoryIndex {{ directory_index|default('index.html') }}

    <Directory {{ document_root }}>
        Options -Indexes +FollowSymLinks
        AllowOverride {{ allow_override|default('None') }}
        Require all granted
    </Directory>
{% if proxy_pass %}
    ProxyPreserveHost On
    ProxyPass / {{ proxy_pass }}
    ProxyPassReverse / {{ proxy_pass }}
{% endif %}
{% if tls_enabled %}

    SSLEngine on
    SSLCertificateFile {{ ssl_certificate }}
    SSLCertificateKeyFile {{ ssl_certificate_key }}
    SSLProtocol {{ ssl_protocol|default('-all +TLSv1.2 +TLSv1.3') }}
{% if ssl_cipher_suite|default('') %}
    SSLCipherSuite {{ ssl_cipher_suite }}
    SSLHonorCipherOrder off
{% endif %}
{% if hsts|default(false) %}
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
{% endif %}
{% endif %}

    ErrorLog {{ error_log|default('${APACHE_LOG_DIR}/error.log') }}
    CustomLog {{ access_log|default('${APACHE_LOG_DIR}/access.log') }} combined
{% if extra_directives %}
    {{ extra_directives|indent(4) }}
{% endif %}
</VirtualHost>
