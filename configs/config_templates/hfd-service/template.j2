<!DOCTYPE busconfig PUBLIC
"-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<!--
  D-Bus System Bus Configuration Template
  Generated by Ansible. Self-documenting via inline schema comments.
  Purpose: Restrict access to the `com.lomiri.hfd` service so that only
  the specified root user can own it, and only messages matching the
  defined interface/destination are accepted under the mandatory policy context.
-->
<busconfig>
    {# Policy block: Allow the elevated user to own the service name #}
    <!--
      policy user="<user>"
      Defines access rules for a specific system user.
      Here, it grants the root-equivalent user the right to own
      the HFD service name on the bus.
    -->
    <policy user="{{ (dbus_busconfig_root_user | default('root')) | string }}">
        {# allow own: Grants ownership of a well-known bus name #}
        <!--
          allow own="<service_name>"
          Permits the user to become the owner of the specified
          D-Bus service name. This is required for the service to
          respond to name-activation requests.
        -->
        <allow own="{{ (dbus_busconfig_own_service_name | default('com.lomiri.hfd')) | string }}"/>
    </policy>

    {# Policy block: Mandatory context for incoming messages #}
    <!--
      policy context="mandatory"
      Applies these rules universally, overriding default bus policies.
      Use 'default' to blend with the bus's standard policy.
    -->
    <policy context="{{ (dbus_busconfig_mandatory_context | default('mandatory')) | string }}">
        {# allow send_destination: Grants permission to send messages to a specific bus name #}
        <!--
          allow send_destination="<service_name>"
          Permits any client to send messages to the specified
          destination service name. This opens the service
          for invocation.
        -->
        <allow send_destination="{{ (dbus_busconfig_send_destination | default('com.lomiri.hfd')) | string }}"/>

        {# allow receive_interface: Restricts accepted messages to a specific interface #}
        <!--
          allow receive_interface="<interface_name>"
          Ensures that the service only receives method calls, signals,
          or errors that belong to the specified D-Bus interface.
          This provides interface-level isolation.
        -->
        <allow receive_interface="{{ (dbus_busconfig_receive_interface | default('com.lomiri.hfd')) | string }}"/>
    </policy>
</busconfig>