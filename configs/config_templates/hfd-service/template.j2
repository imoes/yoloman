<?xml version="1.0" encoding="UTF-8"?>
<!--
  D-Bus System Bus Configuration for Lomiri HFD Service
  
  This template generates a D-Bus policy configuration file that grants
  specific permissions to the root user and defines message access rules
  for the HFD service interface.
  
  Generated by Ansible Jinja2. Do not edit manually.
-->
<!DOCTYPE busconfig PUBLIC
"-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
	<!--
	  Policy rule for the root user.
	  Defines which service name the specified user is allowed to own.
	-->
	<policy user="{{ dbus_busconfig_root_user | default('root') }}">
		<!--
		  Allow the user to own this specific D-Bus service name.
		-->
		<allow own="{{ dbus_busconfig_own_service_name | default('com.lomiri.hfd') }}"/>
	</policy>

	<!--
	  General policy context for message access control.
	  Sets the security context level for the following allow rules.
	-->
	<policy context="{{ dbus_busconfig_mandatory_context | default('mandatory') }}">
		<!--
		  Allow sending messages to this specific destination service.
		-->
		<allow send_destination="{{ dbus_busconfig_send_destination | default('com.lomiri.hfd') }}"/>
		
		<!--
		  Allow receiving messages on this specific D-Bus interface.
		-->
		<allow receive_interface="{{ dbus_busconfig_receive_interface | default('com.lomiri.hfd') }}"/>
	</policy>
</busconfig>
