# Yoyo database migration configuration
# Generated by Ansible Jinja2
# This file configures the Yoyo migration tool.

[database]
# The database connection URI used by yoyo to manage migrations.
# Example: postgresql://user:pass@host/db or mysql://user:pass@host/db
driver = {{ (database_uri | default('postgresql://localhost/yoyo')) }}

[migrations]
# The directory path where yoyo looks for migration SQL/Python files.
folder = {{ (migrations_folder | default('migrations')) }}

# Enable verbose output (--verbose / -v)
verbose = {{ (verbose | default(false) | lower) }}

# Run in batch mode, turning off all user prompts (--batch / -b)
batch = {{ (batch_mode | default(false) | lower) }}