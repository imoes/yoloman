{
  "worker_processes": {
    "type": "string",
    "default": "auto",
    "description": "Number of worker processes; 'auto' uses CPU count"
  },
  "pid": {
    "type": "string",
    "default": "/run/nginx.pid",
    "description": "File to store the PID of the main Nginx process"
  },
  "server_tokens": {
    "type": "boolean",
    "default": false,
    "description": "Hide Nginx version in HTTP headers for security"
  },
  "gzip": {
    "type": "boolean",
    "default": true,
    "description": "Enable GZIP compression for text-based responses"
  },
  "gzip_types": {
    "type": "list",
    "default": [
      "text/plain",
      "text/css",
      "application/json",
      "application/javascript",
      "text/xml",
      "application/xml",
      "application/xml+rss",
      "text/javascript"
    ],
    "description": "MIME types eligible for GZIP compression"
  },
  "upstreams": {
    "type": "list",
    "default": [],
    "description": "List of upstream (backend) server groups for load balancing",
    "items": {
      "name": {
        "type": "string",
        "required": true,
        "description": "Name of the upstream group (e.g., 'backend', 'api')"
      },
      "servers": {
        "type": "list",
        "default": [],
        "items": {
          "address": {
            "type": "string",
            "required": true,
            "description": "Backend server address (host:port or Unix socket)"
          },
          "weight": {
            "type": "number",
            "default": 1,
            "description": "Relative weight for weighted round-robin (higher = more requests)"
          },
          "max_fails": {
            "type": "number",
            "default": 1,
            "description": "Number of failed attempts before marking server as unavailable"
          },
          "fail_timeout": {
            "type": "number",
            "default": 10,
            "description": "Time (seconds) to wait before reactivating a failed server"
          }
        },
        "description": "List of backend servers in this upstream group"
      },
      "hash": {
        "type": "object",
        "default": null,
        "items": {
          "key": {
            "type": "string",
            "required": true,
            "description": "Variable to hash on (e.g., '$remote_addr', '$request_uri')"
          },
          "consistent": {
            "type": "boolean",
            "default": false,
            "description": "Use consistent hashing (e.g., for cache partitions)"
          }
        },
        "description": "Hash-based load balancing (e.g., IP hash or variable hash)"
      },
      "zone": {
        "type": "object",
        "default": null,
        "items": {
          "name": {
            "type": "string",
            "required": true,
            "description": "Shared memory zone name"
          },
          "size": {
            "type": "string",
            "required": true,
            "description": "Zone size (e.g., '64k', '1m')"
          }
        },
        "description": "Shared memory zone for shared state across workers"
      }
    }
  },
  "servers": {
    "type": "list",
    "default": [],
    "description": "List of server blocks (virtual hosts)",
    "items": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable this server block"
      },
      "name": {
        "type": "string",
        "default": "unnamed",
        "description": "Descriptive name for the server (for documentation)"
      },
      "listen": {
        "type": "list",
        "default": [],
        "items": {
          "address": {
            "type": "string",
            "default": "80",
            "description": "Address and port (e.g., '80', '443', '127.0.0.1:8080')"
          },
          "ssl": {
            "type": "boolean",
            "default": false,
            "description": "Enable SSL/TLS on this listen address"
          },
          "default": {
            "type": "boolean",
            "default": false,
            "description": "Set as default server for this port"
          }
        },
        "description": "List of addresses and ports to listen on"
      },
      "server_name": {
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "description": "Server names (hostnames) for this block; empty defaults to 'localhost'"
      },
      "root": {
        "type": "string",
        "default": "/var/www/html",
        "description": "Document root directory for static content"
      },
      "index": {
        "type": "list",
        "default": [
          "index.html",
          "index.htm"
        ],
        "items": {
          "type": "string"
        },
        "description": "Index files to serve when requesting a directory"
      },
      "ssl_cert": {
        "type": "string",
        "default": null,
        "description": "Path to SSL certificate file (PEM format); required for HTTPS"
      },
      "ssl_key": {
        "type": "string",
        "default": null,
        "description": "Path to SSL private key file (PEM format); required for HTTPS"
      },
      "ssl_protocols": {
        "type": "list",
        "default": [
          "TLSv1.2",
          "TLSv1.3"
        ],
        "items": {
          "type": "string"
        },
        "description": "Allowed SSL/TLS protocols (e.g., TLSv1.2, TLSv1.3); avoid SSLv3, TLSv1.0, TLSv1.1"
      },
      "ssl_ciphers": {
        "type": "string",
        "default": null,
        "description": "Allowed cipher suites (e.g., 'ECDHE-ECDSA-AES128-GCM-SHA256:...'); leave null for default"
      },
      "ssl_prefer_server_ciphers": {
        "type": "boolean",
        "default": true,
        "description": "Prefer server cipher order over client"
      },
      "include_path": {
        "type": "string",
        "default": null,
        "description": "Explicit path to include for this server (overrides wildcard include)"
      },
      "locations": {
        "type": "list",
        "default": [],
        "description": "List of location blocks",
        "items": {
          "path": {
            "type": "string",
            "required": true,
            "description": "Location path (e.g., '/', '/api', '/static/', '~ ^/api/.*')"
          },
          "description": {
            "type": "string",
            "default": "location block",
            "description": "Optional description for documentation"
          },
          "root": {
            "type": "string",
            "default": null,
            "description": "Per-location document root (overrides server root)"
          },
          "index": {
            "type": "list",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "Per-location index files"
          },
          "try_files": {
            "type": "list",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "Try files in order; last item is fallback (e.g., ['$uri', '$uri/', '=404'])"
          },
          "proxy_pass": {
            "type": "string",
            "default": null,
            "description": "URL to forward requests to (e.g., 'http://backend', 'http://127.0.0.1:8080')"
          },
          "proxy_set_header": {
            "type": "list",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "Headers to set for proxy requests (e.g., ['Host $host', 'X-Real-IP $remote_addr', 'X-Forwarded-For $proxy_add_x_forwarded_for'])"
          },
          "add_header": {
            "type": "list",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "HTTP headers to add to responses (e.g., ['X-Frame-Options SAMEORIGIN'])"
          },
          "limit_req_zone": {
            "type": "object",
            "default": null,
            "items": {
              "name": {
                "type": "string",
                "required": true,
                "description": "Name of the rate-limiting zone (defined in http block via limit_req_zone)"
              },
              "burst": {
                "type": "number",
                "default": 10,
                "description": "Burst size: allowed requests exceeding rate limit"
              },
              "nodelay": {
                "type": "boolean",
                "default": true,
                "description": "Do not delay excess requests in burst queue"
              }
            },
            "description": "Apply rate limiting from a pre-defined zone"
          },
          "auth_basic": {
            "type": "string",
            "default": null,
            "description": "Enable HTTP Basic Auth with realm name (e.g., 'Restricted')"
          },
          "auth_basic_user_file": {
            "type": "string",
            "default": null,
            "description": "Path to .htpasswd file containing credentials"
          },
          "return": {
            "type": "object",
            "default": null,
            "items": {
              "code": {
                "type": "number",
                "required": true,
                "description": "HTTP status code (e.g., 301, 404, 503)"
              },
              "body": {
                "type": "string",
                "default": "",
                "description": "Optional response body (e.g., 'Moved Permanently')"
              }
            },
            "description": "Return a static response without further processing"
          },
          "internal": {
            "type": "boolean",
            "default": false,
            "description": "Only allow internal redirects (client requests blocked)"
          },
          "addition_types": {
            "type": "list",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "MIME types to which the 'addition_filter' applies"
          }
        }
      },
      "error_page": {
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "description": "Custom error pages (e.g., ['404 /404.html', '500 502 503 504 /50x.html'])"
      }
    }
  }
}
