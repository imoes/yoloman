# worker_processes: Number of worker processes; auto = number of CPU cores
worker_processes auto;

# pid: File to store the PID of the main process
pid /run/nginx.pid;

# events: Configuration for worker connections
events {
  # worker_connections: Maximum number of simultaneous connections per worker
  worker_connections 768;
}

# http: Main HTTP block
http {
  # Sendfile: Use kernel's sendfile() for efficient file transfers
  sendfile on;

  # TCPnopush: Push packets immediately (not buffered until full segment)
  tcp_nopush on;

  # TCPnodelay: Disable Nagle's algorithm for low-latency response
  tcp_nodelay on;

  # keepalive_timeout: Time to keep HTTP keep-alive connections open
  keepalive_timeout 65;

  # types_hash_max_size / types_hash_bucket_size: Optimize MIME type lookup
  types_hash_max_size 2048;
  types_hash_bucket_size 128;

  # include: Load additional MIME types from /etc/nginx/mime.types
  include /etc/nginx/mime.types;

  # default_type: Default MIME type for unknown files
  default_type application/octet-stream;

  # access_log / error_log: Log file paths and format
  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log;

  # gzip: Enable compression for responses
  gzip on;

  # gzip_types: MIME types to compress
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

  # server_tokens: Hide Nginx version in headers
  server_tokens off;

  # Include server blocks from external files
{% for server in servers %}
{% if server.enabled %}
  include {{ server.include_path | default('/etc/nginx/conf.d/*.conf', true) }};
  break
{% endif %}
{% endfor %}
{% if servers | length > 0 %}
  # Included server blocks (from /etc/nginx/sites-enabled/)
{% for server in servers %}
{% if server.enabled and server.include_path %}
{% if loop.first %}  # Explicitly included server configs:
{% endif %}
  include {{ server.include_path }};
{% endif %}
{% endfor %}
{% endif %}

{% for upstream in upstreams %}
  # upstream {{ upstream.name }}: Define a group of backend servers
  upstream {{ upstream.name }} {
{% for server in upstream.servers %}
    server {{ server.address }}{{ ' weight=' ~ server.weight if server.weight }}{{ ' max_fails=' ~ server.max_fails if server.max_fails }}{{ ' fail_timeout=' ~ server.fail_timeout ~ 's' if server.fail_timeout }};
{% endfor %}
{% if upstream.hash %}
    hash {{ upstream.hash.key }} {{ 'consistent' if upstream.hash.consistent }};
{% endif %}
{% if upstream.zone %}
    zone {{ upstream.zone.name }}:{{ upstream.zone.size }};
{% endif %}
  }
{% endfor %}

{% for server in servers %}
{% if server.enabled %}
  # server block: {{ server.name | default('unnamed') }}
  server {
{% if server.listen %}
{% for listen_addr in server.listen %}
    listen {{ listen_addr.address | default('80') }}{{ ' ssl' if listen_addr.ssl }}{{ ' default_server' if listen_addr.default }};
{% endfor %}
{% else %}
    listen 80;
{% endif %}

{% if server.server_name %}
    server_name {{ server.server_name | join(', ') }};
{% else %}
    server_name localhost;
{% endif %}

{% if server.root %}
    root {{ server.root }};
{% endif %}

{% if server.index %}
    index {{ server.index | join(' ') }};
{% endif %}

{% if server.ssl_cert %}
    ssl_certificate {{ server.ssl_cert }};
{% endif %}
{% if server.ssl_key %}
    ssl_certificate_key {{ server.ssl_key }};
{% endif %}
{% if server.ssl_protocols %}
    ssl_protocols {{ server.ssl_protocols | join(' ') }};
{% endif %}
{% if server.ssl_ciphers %}
    ssl_ciphers {{ server.ssl_ciphers }};
{% endif %}
{% if server.ssl_prefer_server_ciphers %}
    ssl_prefer_server_ciphers {{ server.ssl_prefer_server_ciphers | lower }};
{% endif %}

{% for location in server.locations %}
    # location {{ location.path }}: {{ location.description | default('static file or proxy') }}
    location {{ location.path }} {
{% if location.root %}
      root {{ location.root }};
{% endif %}
{% if location.index %}
      index {{ location.index | join(' ') }};
{% endif %}
{% if location.try_files %}
      try_files {{ location.try_files | join(' ') }};
{% endif %}
{% if location.proxy_pass %}
      proxy_pass {{ location.proxy_pass }};
{% endif %}
{% if location.proxy_set_header %}
      proxy_set_header {{ location.proxy_set_header | join('\n      ') }};
{% endif %}
{% if location.add_header %}
      add_header {{ location.add_header | join('\n      ') }};
{% endif %}
{% if location.limit_req_zone %}
      limit_req zone={{ location.limit_req_zone.name }}{{ ' burst=' ~ location.limit_req_zone.burst if location.limit_req_zone.burst }}{{ ' nodelay' if location.limit_req_zone.nodelay }};
{% endif %}
{% if location.auth_basic %}
      auth_basic "{{ location.auth_basic }}";
{% endif %}
{% if location.auth_basic_user_file %}
      auth_basic_user_file {{ location.auth_basic_user_file }};
{% endif %}
{% if location.return %}
      return {{ location.return.code }}{{ ' "' ~ location.return.body ~ '"' if location.return.body }};
{% endif %}
{% if location.internal %}
      internal;
{% endif %}
{% if location.addition_types %}
      types {{ location.addition_types | join(' ') }};
{% endif %}
    }
{% endfor %}

{% if server.error_page %}
    error_page {{ server.error_page | join(' ') }};
{% endif %}
  }
{% endif %}
{% endfor %}
}
