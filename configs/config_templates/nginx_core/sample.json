{
  "worker_processes": "auto",
  "pid": "/run/nginx.pid",
  "server_tokens": false,
  "gzip": true,
  "gzip_types": [
    "text/plain",
    "text/css",
    "application/json",
    "application/javascript",
    "text/xml",
    "application/xml",
    "application/xml+rss",
    "text/javascript"
  ],
  "upstreams": [
    {
      "name": "backend",
      "servers": [
        {
          "address": "127.0.0.1:8080",
          "weight": 1,
          "max_fails": 3,
          "fail_timeout": 10
        },
        {
          "address": "127.0.0.1:8081",
          "weight": 1,
          "max_fails": 3,
          "fail_timeout": 10
        }
      ],
      "zone": {
        "name": "backend",
        "size": "64k"
      }
    }
  ],
  "servers": [
    {
      "enabled": true,
      "name": "main-site",
      "listen": [
        {
          "address": "80",
          "default": true
        },
        {
          "address": "443",
          "ssl": true
        }
      ],
      "server_name": [
        "example.com",
        "www.example.com"
      ],
      "root": "/var/www/example.com/html",
      "index": [
        "index.html",
        "index.php"
      ],
      "ssl_cert": "/etc/ssl/certs/example.com.crt",
      "ssl_key": "/etc/ssl/private/example.com.key",
      "ssl_protocols": [
        "TLSv1.2",
        "TLSv1.3"
      ],
      "ssl_ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
      "ssl_prefer_server_ciphers": true,
      "locations": [
        {
          "path": "/",
          "try_files": [
            "$uri",
            "$uri/",
            "=404"
          ]
        },
        {
          "path": "/api/",
          "proxy_pass": "http://backend",
          "proxy_set_header": [
            "Host $host",
            "X-Real-IP $remote_addr",
            "X-Forwarded-For $proxy_add_x_forwarded_for",
            "X-Forwarded-Proto $scheme"
          ]
        },
        {
          "path": "/admin",
          "auth_basic": "Admin Area",
          "auth_basic_user_file": "/etc/nginx/.htpasswd",
          "try_files": [
            "$uri",
            "$uri/",
            "/admin/index.html"
          ]
        }
      ]
    },
    {
      "enabled": true,
      "name": "redirect-http",
      "listen": [
        {
          "address": "80",
          "default": true
        }
      ],
      "server_name": [
        "redirect.example.com"
      ],
      "locations": [
        {
          "path": "/",
          "return": {
            "code": 301,
            "body": "https://$host$request_uri"
          }
        }
      ]
    }
  ]
}
