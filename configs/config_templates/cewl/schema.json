{
  "url": {
    "type": "string",
    "default": "",
    "description": "The base URL to spider (required)"
  },
  "depth": {
    "type": "number",
    "default": 2,
    "description": "Depth to spider to (0 = no recursion)"
  },
  "min_word_length": {
    "type": "number",
    "default": 3,
    "description": "Minimum word length to include in output"
  },
  "offsite": {
    "type": "bool",
    "default": false,
    "description": "Allow following external links"
  },
  "user_agent": {
    "type": "string",
    "default": "CeWL/6.2.1 (Robin Wood)",
    "description": "HTTP User-Agent string to use"
  },
  "no_words": {
    "type": "bool",
    "default": false,
    "description": "Suppress wordlist output (useful when only email/meta needed)"
  },
  "email": {
    "type": "bool",
    "default": false,
    "description": "Extract email addresses from mailto links"
  },
  "lowercase": {
    "type": "bool",
    "default": false,
    "description": "Convert all extracted words to lowercase"
  },
  "with_numbers": {
    "type": "bool",
    "default": false,
    "description": "Allow words containing digits"
  },
  "convert_umlauts": {
    "type": "bool",
    "default": false,
    "description": "Convert Latin-1 umlauts (\u00e4\u2192ae, \u00f6\u2192oe, \u00fc\u2192ue, \u00df\u2192ss)"
  },
  "meta": {
    "type": "bool",
    "default": false,
    "description": "Extract embedded metadata (e.g., EXIF, PDF)"
  },
  "count": {
    "type": "bool",
    "default": false,
    "description": "Show occurrence count for each word"
  },
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose output"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug output"
  },
  "output_file": {
    "type": "string",
    "default": "wordlist.txt",
    "description": "Path to write the wordlist"
  },
  "email_file": {
    "type": "string",
    "default": "emails.txt",
    "description": "Path to write extracted email addresses"
  },
  "meta_file": {
    "type": "string",
    "default": "metadata.txt",
    "description": "Path to write extracted metadata"
  },
  "meta_temp_dir": {
    "type": "string",
    "default": "/tmp",
    "description": "Temporary directory used by exiftool for metadata extraction"
  },
  "auth_type": {
    "type": "string",
    "default": "basic",
    "description": "Authentication type: 'basic' or 'digest'",
    "enum": [
      "basic",
      "digest"
    ]
  },
  "auth_user": {
    "type": "string",
    "default": "",
    "description": "Username for authentication"
  },
  "auth_pass": {
    "type": "string",
    "default": "",
    "description": "Password for authentication"
  },
  "proxy_host": {
    "type": "string",
    "default": "",
    "description": "Proxy host address"
  },
  "proxy_port": {
    "type": "number",
    "default": 8080,
    "description": "Proxy port"
  },
  "proxy_username": {
    "type": "string",
    "default": "",
    "description": "Username for proxy authentication"
  },
  "proxy_password": {
    "type": "string",
    "default": "",
    "description": "Password for proxy authentication"
  },
  "headers": {
    "type": "list",
    "default": [],
    "description": "List of additional HTTP headers in 'Name: value' format"
  },
  "exclude_file": {
    "type": "string",
    "default": "",
    "description": "Path to file containing paths to exclude (one per line)"
  },
  "allowed_pattern": {
    "type": "string",
    "default": "",
    "description": "Regex pattern that paths must match to be followed"
  }
}
