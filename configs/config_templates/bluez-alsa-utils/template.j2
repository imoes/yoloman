# BlueALSA integration setup
#
# This configuration file defines the default behaviors and ALSA plugin definitions
# for BlueALSA, allowing Bluetooth audio devices to be used as standard ALSA sound cards.
#
# Section 1: Global Defaults
# These directives set the default parameters for the bluealsa plugins if not
# explicitly overridden in the pcm/ctl definition blocks below.

# MAC address of the default Bluetooth device to connect to.
# If left at the default '00:00:00:00:00:00', BlueALSA will use the most recently connected device.
defaults.bluealsa.device "{{ device | default('00:00:00:00:00:00') }}"

# Default Bluetooth audio profile (e.g., a2dp, hfp).
# 'a2dp' is recommended for high-quality stereo audio streaming.
defaults.bluealsa.profile "{{ profile | default('a2dp') }}"

# Codec to use.
# 'unchanged' allows BlueALSA to negotiate the best available codec with the remote device.
defaults.bluealsa.codec "{{ codec | default('unchanged') }}"

# Whether to change the hardware volume when a PCM is opened.
# 'unchanged' preserves the current hardware volume state.
defaults.bluealsa.volume "{{ volume | default('unchanged') }}"

# Whether to modify the software volume state when a PCM is opened.
# 'unchanged' preserves the current software mixer state.
defaults.bluealsa.softvol "{{ softvol | default('unchanged') }}"

# Manual delay compensation in microseconds.
# Set to 0 to let the device report its own delay automatically.
defaults.bluealsa.delay {{ delay | default('0') }}

# D-Bus service name for BlueALSA.
# This identifies the system bus service that BlueALSA registers.
defaults.bluealsa.service "{{ service | default('org.bluealsa') }}"

# Section 2: Control Plugin Definition
# Defines the 'bluealsa' control plugin for mixer controls (e.g., volume, mute).
ctl.bluealsa {
	@args [ DEV EXT BTT DYN SRV ]
	@args.DEV {
		type string
		default {
			@func refer
			name defaults.bluealsa.ctl.device
		}
	}
	@args.EXT {
		type string
		default {
			@func refer
			name defaults.bluealsa.ctl.extended
		}
	}
	@args.BTT {
		type string
		default {
			@func refer
			name defaults.bluealsa.ctl.bttransport
		}
	}
	@args.DYN {
		type string
		default {
			@func refer
			name defaults.bluealsa.ctl.dynamic
		}
	}
	@args.SRV {
		type string
		default {
			@func refer
			name defaults.bluealsa.service
		}
	}
	type bluealsa
	device $DEV
	extended $EXT
	bttransport $BTT
	dynamic $DYN
	service $SRV
	hint {
		show {
			@func refer
			name defaults.namehint.extended
		}
		description "Bluetooth Audio Control Device"
	}
}

# Section 3: PCM Plugin Definition
# Defines the 'bluealsa' PCM plugin for audio playback/capture, wrapped in a 'plug'
# plugin to handle format conversion automatically.
pcm.bluealsa {
	@args [ DEV PROFILE CODEC VOL SOFTVOL DELAY SRV ]
	@args.DEV {
		type string
		default {
			@func refer
			name defaults.bluealsa.device
		}
	}
	@args.PROFILE {
		type string
		default {
			@func refer
			name defaults.bluealsa.profile
		}
	}
	@args.CODEC {
		type string
		default {
			@func refer
			name defaults.bluealsa.codec
		}
	}
	@args.VOL {
		type string
		default {
			@func refer
			name defaults.bluealsa.volume
		}
	}
	@args.SOFTVOL {
		type string
		default {
			@func refer
			name defaults.bluealsa.softvol
		}
	}
	@args.DELAY {
		type integer
		default {
			@func refer
			name defaults.bluealsa.delay
		}
	}
	@args.SRV {
		type string
		default {
			@func refer
			name defaults.bluealsa.service
		}
	}
	type plug
	slave.pcm {
		type bluealsa
		device $DEV
		profile $PROFILE
		codec $CODEC
		volume $VOL
		softvol $SOFTVOL
		delay $DELAY
		service $SRV
	}
	hint {
		show {
			@func refer
			name defaults.namehint.extended
		}
		description "Bluetooth Audio"
	}
}
