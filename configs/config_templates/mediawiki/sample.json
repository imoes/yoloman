{
  "sitename": "MyCompany Wiki",
  "meta_namespace": "MyCompany",
  "logo_url": "/assets/logo.svg",
  "script_path": "/wiki",
  "article_path": "/wiki/$1",
  "use_path_info": true,
  "db_type": "mysql",
  "db_server": "db.internal.example.com",
  "db_name": "mediawiki_prod",
  "db_user": "wikiadmin",
  "db_password": "s3cr3tP@ss!",
  "db_options": [
    "mysql_charset"
  ],
  "language_code": "en",
  "local_timezone": "America/Los_Angeles",
  "cache_directory": "/var/cache/mediawiki",
  "main_cache_type": "MEMCACHED",
  "memcached_servers": [
    "127.0.0.1:11211"
  ],
  "enable_markdown": true,
  "public_read": true,
  "public_edit": false,
  "public_createaccount": true,
  "user_groups": [
    {
      "name": "bot",
      "permissions": {
        "browsearchive": true,
        "edit": true,
        "delete": true
      }
    },
    {
      "name": "sysop",
      "permissions": {
        "delete": true,
        "protect": true,
        "block": true
      }
    }
  ],
  "extensions": [
    {
      "name": "VisualEditor",
      "config": {
        "wgVisualEditorParsoidHTTPPort": 8000
      }
    },
    {
      "path": "/var/www/extensions/Math/Math.php",
      "config": {
        "wgMathValidModes": [
          "texvc"
        ]
      }
    }
  ],
  "debug_log_groups": {
    "parser": "/var/log/mediawiki/parser.log",
    "api": "/var/log/mediawiki/api.log"
  },
  "debug_log_level": "info"
}
