# MediaWiki Apache VirtualHost configuration
# Generated by Ansible role - DO NOT EDIT MANUALLY
#
# This template configures Apache to serve MediaWiki.
# It sets up the document root, URL alias, and security restrictions
# for sensitive directories.

<VirtualHost *:{{ (mediawiki | default({})).port | default(80) }}>
    # Server hostname that Apache will respond to.
    # No specific schema field provided, using generic default.
    ServerName {{ (mediawiki | default({})).servername | default('localhost') }}
    # Contact email for the server administrator.
    # No specific schema field provided, using generic default.
    ServerAdmin {{ (mediawiki | default({})).serveradmin | default('webmaster@localhost') }}

    # Document root directory where MediaWiki is installed.
    # Field: mediawiki_docroot
    DocumentRoot {{ mediawiki_docroot | default('/var/lib/mediawiki') }}

    # MediaWiki URL alias
    # This defines the base path under which MediaWiki is accessible (e.g. /mediawiki)
    # Field: mediawiki_alias
    Alias {{ mediawiki_alias | default('/mediawiki') }} {{ mediawiki_docroot | default('/var/lib/mediawiki') }}

    # Directory configuration for the main document root.
    <Directory {{ mediawiki_docroot | default('/var/lib/mediawiki') }}>
        # Enable symbolic link following for easier upgrades and symlinked extensions
        Options +FollowSymLinks
        # Allow .htaccess overrides for MediaWiki's URL rewriting (index.php)
        AllowOverride All
        # Allow access to all users
        Require all granted
    </Directory>

    # Protect the config directory
    # MediaWiki creates LocalSettings.php here; it must never be web-accessible.
    <Directory {{ mediawiki_docroot | default('/var/lib/mediawiki') }}/config>
        Options -FollowSymLinks
        AllowOverride None
        <IfModule mod_php7.c>
            php_admin_flag engine off
        </IfModule>
        <IfModule php_module>
            php_admin_flag engine off
        </IfModule>
    </Directory>

    # Protect the images directory from PHP execution
    # Uploaded files must be served as static content only.
    <Directory {{ mediawiki_docroot | default('/var/lib/mediawiki') }}/images>
        Options -FollowSymLinks
        AllowOverride None
        <IfModule mod_php7.c>
            php_admin_flag engine off
        </IfModule>
        <IfModule php_module>
            php_admin_flag engine off
        </IfModule>
        <IfModule headers_module>
            Header set X-Content-Type-Options nosniff
        </IfModule>
    </Directory>

    # Protect the upload directory from PHP execution
    # Same protection as images/ but for user-uploaded content.
    <Directory {{ mediawiki_docroot | default('/var/lib/mediawiki') }}/upload>
        Options -FollowSymLinks
        AllowOverride None
        <IfModule mod_php7.c>
            php_admin_flag engine off
        </IfModule>
        <IfModule php_module>
            php_admin_flag engine off
        </IfModule>
        <IfModule headers_module>
            Header set X-Content-Type-Options nosniff
        </IfModule>
    </Directory>

    # Logging
    # Error log file path
    # No specific schema field provided, using generic default.
    ErrorLog {{ (mediawiki | default({})).errorlog | default('/var/log/apache2/mediawiki-error.log') }}
    # Access log file path
    # No specific schema field provided, using generic default.
    CustomLog {{ (mediawiki | default({})).customlog | default('/var/log/apache2/mediawiki-access.log') }} combined
</VirtualHost>