# Apache VirtualHost snippet for MediaWiki
# This template generates the necessary Apache directives to serve MediaWiki.

# MediaWiki URL alias (e.g., /mediawiki)
# Maps the URL path to the document root.
Alias {{ mediawiki_alias | default('/mediawiki') }} {{ mediawiki_docroot | default('/var/lib/mediawiki') }}

# Document root directory for MediaWiki
# Grants access to the installation directory.
<Directory {{ mediawiki_docroot | default('/var/lib/mediawiki') }}/>
    # Enable symbolic link following
    Options +FollowSymLinks
    # Allow .htaccess overrides (MediaWiki uses them for routing/security)
    AllowOverride All
    # Allow access to all
    Require all granted
</Directory>

# Configuration directory security
# Protects LocalSettings.php and other sensitive config files from direct web access.
<Directory {{ mediawiki_docroot | default('/var/lib/mediawiki') }}/config>
    # Disable symbolic link following for security
    Options -FollowSymLinks
    # Disable .htaccess overrides as we rely on this explicit block
    AllowOverride None
    # Prevent PHP execution in the config directory if mod_php7 is loaded
    <IfModule mod_php7.c>
        php_admin_flag engine off
    </IfModule>
</Directory>

# Images directory security
# Protects the images directory while allowing static content serving.
<Directory {{ mediawiki_docroot | default('/var/lib/mediawiki') }}/images>
    # Disable symbolic link following
    Options -FollowSymLinks
    # Disable .htaccess overrides
    AllowOverride None
    # Prevent PHP execution in images directory (mod_php module)
    <IfModule php_module>
        php_admin_flag engine off
    </IfModule>
    # Prevent PHP execution in images directory (mod_php7)
    <IfModule mod_php7.c>
        php_admin_flag engine off
    </IfModule>
    # Add security header to prevent MIME-type sniffing
    <IfModule headers_module>
        Header set X-Content-Type-Options nosniff
    </IfModule>
</Directory>

# Upload directory security
# Protects the upload directory, similar to images but often containing user-uploaded content.
<Directory {{ mediawiki_docroot | default('/var/lib/mediawiki') }}/upload>
    # Disable symbolic link following
    Options -FollowSymLinks
    # Disable .htaccess overrides
    AllowOverride None
    # Prevent PHP execution in upload directory (mod_php module)
    <IfModule php_module>
        php_admin_flag engine off
    </IfModule>
    # Prevent PHP execution in upload directory (mod_php7)
    <IfModule mod_php7.c>
        php_admin_flag engine off
    </IfModule>
    # Add security header to prevent MIME-type sniffing
    <IfModule headers_module>
        Header set X-Content-Type-Options nosniff
    </IfModule>
</Directory>
