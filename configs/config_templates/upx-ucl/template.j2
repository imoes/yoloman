#!/bin/bash
# UPX default environment variables and options.
# Applied before command line arguments.
# See UPX man page section: ENVIRONMENT VARIABLE.
#
# upx_defaults: List of default UPX command-line options (e.g., compression levels,
#               overlay handling) that are prefixed to every invocation.
{# Join the list of options with a space to form a valid shell string #}
UPX="{{ upx_defaults | default([]) | join(' ') }}"