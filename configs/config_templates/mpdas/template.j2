# mpdas configuration file
# Path to the MPD server (hostname or IP:port)
host: {{ host }}

# MPD port (default: 6600)
port: {{ port }}

# MPD password (leave empty if none)
password: {{ password }}

# Username for Last.fm or Libre.fm
username: {{ username }}

# Password hash for Last.fm or Libre.fm (use md5 hash, not plain text)
password_hash: {{ password_hash }}

# Scrobbler service to use: lastfm or librefm
service: {{ service }}

# Path to MPD's status file (optional, used for song duration detection)
# If empty, mpdas will read from MPD directly
mpd_status_path: {{ mpd_status_path }}

# Maximum time (in seconds) to wait before submitting a scrobble
# If song plays less than this, it won't be scrobbled
min_play_time: {{ min_play_time }}

# Enable debug logging (true/false)
debug: {{ debug | lower }}

# Path to log file (leave empty to log to stderr)
log_file: {{ log_file }}

# Disable scrobbling for tracks shorter than this (in seconds)
# Overrides global min_play_time
skip_shorter_than: {{ skip_shorter_than }}

# Track title format when artist or title is missing
# Use %a for artist, %t for title, %A for album, %n for track number
fallback_format: {{ fallback_format }}

# Enable online status (update now playing & scrobble in one go)
online_status: {{ online_status | lower }}

# List of ignored artists (case-insensitive)
{% for ignored_artist in ignored_artists %}ignore_artist: {{ ignored_artist }}
{% endfor %}

# List of ignored paths (case-sensitive, relative to music directory)
{% for ignored_path in ignored_paths %}ignore_path: {{ ignored_path }}
{% endfor %}
