{
  "enabled": true,
  "bind_host": "0.0.0.0",
  "bind_port": 3333,
  "log_file": "/var/log/sudo_logsrvd.log",
  "log_max_size": 52428800,
  "log_keep_count": 10,
  "log_compression": "gzip",
  "tls_cert": "/etc/ssl/sudo_logsrvd.crt",
  "tls_key": "/etc/ssl/sudo_logsrvd.key",
  "allowed_clients": [
    "10.0.0.5",
    "10.0.0.6",
    "log-aggregator.internal"
  ],
  "max_connections": 50,
  "log_level": "info"
}
