{#
  discover-modprobe configuration template
  This file is automatically generated by the discover role.
  It controls which device modules are loaded and which are skipped.
#}

# ==============================================================================
# types: Device types to detect
# Description: Specify which device types to detect. Use "all" to detect all
#              device types. Default is "all".
# ==============================================================================
types={{ types | default('all') }}

# ==============================================================================
# skip: Modules to skip loading
# Description: Space-separated list of modules to skip loading. These modules
#              will be commented out in the configuration.
# ==============================================================================
{%- if skip | default('') | trim -%}
# Modules explicitly skipped by configuration:
{%- for module in skip | default('') | split(' ') | select('trim') | list -%}
# {{ module }}
{%- endfor -%}
{%- else -%}
# skip="{{ skip | default('') }}"
{%- endif -%}

{#
  Lines below this point have been automatically added by
  discover-modprobe(8) to disable the loading of modules that have
  previously crashed the machine:
#}