{
  "qmaster_host": "sge-qmaster.internal.example.com",
  "qmaster_port": 6444,
  "spool_dir": "/var/spool/gridengine/execd",
  "execd_spool_dir": "/var/spool/gridengine/execd",
  "execd_java_dir": "/var/tmp/gridengine",
  "hostname": "sge-exec-01.internal.example.com",
  "execd_port": 6445,
  "max_user_jobs": 100,
  "max_ujperq": 50,
  "max_pe_jobs": 10,
  "load_thresholds": {
    "load_avg": 1.5,
    "load_mem": 0.9,
    "load_swap": 0.7
  },
  "slots": "auto",
  "packages": [
    "intel",
    "openmpi",
    "cuda"
  ],
  "cpu_affinity": "auto",
  "auto_shutdown": true,
  "auto_shutdown_delay": 600,
  "shell_start_mode": "unix:0",
  "job_env_vars": {
    "MODULEPATH": "/opt/modules:/opt/intel/oneapi/modulefiles"
  },
  "prolog": "/usr/local/bin/sge-prolog.sh",
  "epilog": "/usr/local/bin/sge-epilog.sh",
  "reporting": true,
  "loglevel": "notice",
  "logdir": "/var/log/gridengine"
}
