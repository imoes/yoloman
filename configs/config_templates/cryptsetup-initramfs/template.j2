#
# =============================================================================
# cryptsetup-initramfs configuration
# =============================================================================
#
# This configuration file controls the behavior of the cryptroot initramfs hook.
# It determines which auxiliary files (keyfiles, askpass binary) are included
# in the initial RAM filesystem image to allow for early-boot decryption.
#
# Variables in this file are read by the initramfs-tools hooks during image
# generation. Ensure that the values here match your security requirements.
#
# =============================================================================

# -----------------------------------------------------------------------------
# KEYFILE_PATTERN: Shell pattern to match key files from /etc/crypttab
# -----------------------------------------------------------------------------
#
# Type: String
# Default: None (empty string in effect, meaning no key files are copied)
#
# Description:
#   A shell glob pattern used to identify key files referenced in /etc/crypttab
#   that should be included in the initramfs image. This allows encrypted
#   volumes to be unlocked automatically at boot if the corresponding keyfile
#   is present and matches the pattern.
#
#   - If left unset or null, NO key files are copied to the initramfs.
#   - If set to an empty string "", it also means no key files are copied.
#   - Use standard glob patterns (e.g., "/etc/keys/*.key").
#
#   WARNING:
#   * If private key material is included in the initramfs, ensure the
#     initramfs image itself has restrictive permissions (e.g., UMASK=0077
#     in /etc/initramfs-tools/initramfs.conf).
#   * Keys inside the initramfs reside in memory during suspend, which may
#     defeat the security guarantees of hibernation/suspend if not handled
#     carefully.
#
#   Note: This pattern does not apply to crypttab entries using the
#   'keyscript=' option; those are passed directly to the script.

# Set KEYFILE_PATTERN only if a non-empty pattern is desired.
# Otherwise, it remains commented out (defaulting to "no key files").
{% if KEYFILE_PATTERN is defined and KEYFILE_PATTERN is not none and (KEYFILE_PATTERN is number or KEYFILE_PATTERN is boolean or KEYFILE_PATTERN | length > 0) %}KEYFILE_PATTERN={{ KEYFILE_PATTERN | string }}{% else %}#KEYFILE_PATTERN={% endif %}

# -----------------------------------------------------------------------------
# ASKPASS: [ y | n ]
# -----------------------------------------------------------------------------
#
# Type: String ('y' or 'n')
# Default: y
#
# Description:
#   Determines whether the `askpass` binary is included in the initramfs image.
#   The `askpass` utility is required for interactive passphrase prompts during
#   the early boot stage.
#
#   - y (default): Includes `askpass`. Allows interactive unlocking of volumes
#     that do not use keyfiles or keyscripts. Also includes `cryptroot-unlock`.
#   - n: Excludes `askpass` and `cryptroot-unlock`. The system will fail to
#     boot if an interactive prompt is required for any encrypted volume.
#
#   Setting this to 'n' reduces the size of the initramfs and the attack
#   surface if interactive unlocking is not needed.

# Set ASKPASS only if overriding the default.
{% if ASKPASS is defined and ASKPASS is not none and (ASKPASS is number or ASKPASS is boolean or ASKPASS | length > 0) %}ASKPASS={{ ASKPASS | string }}{% else %}#ASKPASS=y{% endif %}
