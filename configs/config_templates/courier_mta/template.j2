# Route domain to a specific MX host or direct delivery
# Format: domain: host:port, flags
# Example: example.com: mail.example.com:25
{% for route in routes %}{{ route.domain }}: {{ route.host }}{% if route.port is defined and route.port != 25 %}:{{ route.port }}{% endif %}{% if route.flags is defined %}, {{ route.flags }}{% endif %}
{% endfor %}