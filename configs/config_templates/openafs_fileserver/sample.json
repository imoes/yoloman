{
  "etc_dir": "/etc/openafs",
  "bin_dir": "/usr/lib/afs",
  "num_threads": 16,
  "max_connections": 512,
  "listen_addr": "10.0.0.5",
  "fileserver_port": 7000,
  "cmserver_port": 7001,
  "root_dir": "/afs",
  "volumes_dir": "/vicepa",
  "log_dir": "/var/log/openafs",
  "backup_dir": "/afs/.backup",
  "backup_enabled": true,
  "kerberos_principal": "afs/fileserver1.example.com@EXAMPLE.COM",
  "cell_servers": [
    "db1.example.com",
    "db2.example.com"
  ],
  "trusted_cells": [
    "othercell.example.com"
  ],
  "extra_args": [
    "-nojumbo",
    "-n"
  ],
  "debug": false
}
