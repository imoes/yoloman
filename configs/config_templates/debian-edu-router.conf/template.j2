{#
  debian-edu-router.conf.j2

  This template generates the Debian-Edu router configuration.
  The Debian-Edu router is a component responsible for network routing
  configuration within the Debian-Edu project. It typically manages
  DHCP, DNS, and routing tables for educational networks.

  This specific file acts as a loader, sourcing additional configuration
  snippets from a specified directory.

  Variables:
    - router_conf_dir: The directory containing the router configuration snippets.
#}

# Source all configuration snippets from the router configuration directory.
# This allows for modular configuration where individual files in the directory
# can define specific routing rules, interface settings, or other router parameters.
source <(cat {{ router_conf_dir | default('/etc/debian-edu/router.conf.d') }})