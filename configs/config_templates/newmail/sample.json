{
  "default_mailbox": "/var/mail/user1",
  "mailbox_list": [
    {
      "path": "/var/mail/user1",
      "prefix": "work"
    },
    {
      "path": "/home/user1/inbox.mbox",
      "prefix": "personal"
    }
  ],
  "check_interval": 30,
  "ring_bell": true,
  "run_window_app": false,
  "raw_headers": false,
  "locale": "en_US.UTF-8"
}
