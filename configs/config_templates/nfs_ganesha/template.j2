## NFS-Ganesha Configuration File
## Generated by template engine — do not edit manually

## Enable NFS protocol versions
NFS_CORE_PARAMS {
  ## Minimum supported NFS version (3 or 4)
  Protocols = {{ nfs_protocols | map(attribute='version') | join(', ') }};
  ## Enable legacy NFSv3 (required for backward compatibility)
  NFSv3 {
    ACL = {{ nfs_v3.acl.enabled | lower }};
    POSIX_ACL = {{ nfs_v3.posix_acl | lower }};
  };
  ## Enable NFSv4 with minor versions
  NFSv4 {
    Minor_Vers = {{ nfs_v4.minor_versions | map(attribute='version') | join(', ') | default('1') }};
    ## NFSv4.1 features
    DRC = {
      Size_in_Mem = {{ nfs_v4.drc.size_in_mem | default(1024) }};
      Memory_Size = {{ nfs_v4.drc.memory_size | default(16) }};
    };
    ## NFSv4.1 delegation support
    Delegation = {{ nfs_v4.delegation | lower }};
  };
}

## Export definition block — repeated per export
{% for export in exports %}
EXPORT {
  ## Unique export ID
  Export_ID = {{ export.id }};
  ## Path to export on local filesystem
  Path = {{ export.path | e }};
  ## Filesystem ID (for NFSv4 pseudo-root mapping)
  FSID = {{ export.fsid | default(export.id) }};
  ## Supported client access protocols
  Protocols = {{ export.protocols | map(attribute='version') | join(', ') | default('3,4') }};
  ## Transport protocols
  Transports = {{ export.transports | map(attribute='transport') | join(', ') | default('TCP') }};
  ## Export access permissions
  Access_Type = {{ export.access_type | default('RW') }};
  ## Root squash behavior (ROOT_SQUASH, NO_ROOT_SQUASH, ROOT_ID_SQUASH)
  Squash = {{ export.squash | default('Root_Squash') }};
  ## Required security flavor(s) for clients
  SecType = {{ export.security_flavors | map(attribute='flavor') | join(', ') | default('sys') }};
  ## Export flags
  Pseudo = {{ export.pseudo_path | e }};
  ## Readdir preference
  Require_Krb5 = {{ export.require_krb5 | lower | default('false') }};
  ## Allow client reconnection & recovery
  Enable_48_Hour_Clock = {{ export.enable_48_hour_clock | lower | default('true') }};
  
  ## Client access control — repeated per client or group
  {% if export.clients %}
 Clients {
    {% for client in export.clients %}
    {% if client.name %}## Client/group: {{ client.name }}{% endif %}
    {% if client.type == 'host' %}HOST {{ client.hostname | e }}{% elif client.type == 'network' %}NETWORK {{ client.network | e }}{% elif client.type == 'ip' %}IP {{ client.ip | e }}{% endif %} {
      Access_Type = {{ client.access_type | default(export.access_type | default('RW')) }};
      {% if client.squash is defined %}Squash = {{ client.squash | default('Root_Squash') }};{% endif %}
      {% if client.security_flavors is defined %}SecType = {{ client.security_flavors | map(attribute='flavor') | join(', ') | default(export.security_flavors | map(attribute='flavor') | join(', ') | default('sys')) }};{% endif %}
      {% if client.protocols is defined %}Protocols = {{ client.protocols | map(attribute='version') | join(', ') | default('3,4') }};{% endif %}
    };
    {% endfor %}
  };
  {% endif %}
  
  ## Export attributes
  Attributes {
    ## Default file creation mask
    Default_Perms = {{ export.default_permissions | default(0o777) }};
    ## Enable async writes
    Async_Enabled = {{ export.async_enabled | lower | default('false') }};
    ## Enable write-through caching
    Write_Through_Enabled = {{ export.write_through_enabled | lower | default('false') }};
  };
}
{% endfor %}

## Logging configuration
LOG {
  ## Default log level (DEBUG, FULL_DEBUG, TRACE, COMPRESSION, NTLM, AUTH, ACCESS, MAJOR, DEFAULT, MINOR, ERROR, FATAL)
  Level = {{ log.level | default('DEFAULT') }};
  ## Log file path (use NONE to disable file logging)
  File_Name = {{ log.file | default('/var/log/ganesha/ganesha.log') }};
  ## Enable log rotation
  Log_Purge = {{ log.purge_enabled | lower | default('true') }};
  ## Keep last N logs
  Number_Of_Logs = {{ log.max_log_files | default(7) }};
}

## Cache configuration for NFSv4 stateful operations
CACHE {
  ## Cache flush interval (seconds)
  Flush_Interval = {{ cache.flush_interval | default(5) }};
  ## Cache validity duration (seconds)
  Cache_Size = {{ cache.cache_size | default(1024) }};
  ## Enable object caching
  Enable_Object_Caching = {{ cache.object_caching | lower | default('true') }};
}

## FSAL (File System Abstraction Layer) configuration
{% for fsal in fsals %}
{% if fsal.name %}## FSAL: {{ fsal.name }}{% endif %}
FSAL {
  Name = {{ fsal.driver }};
  {% if fsal.driver == 'VFS' %}
  Path = {{ fsal.path | e }};
  {% elif fsal.driver == 'CEPH' %}
  Ceph_Conf = {{ fsal.ceph_conf | default('/etc/ceph/ceph.conf') }};
  User_ID = {{ fsal.user_id | default('client.admin') }};
  {% elif fsal.driver == 'LIO' %}
  Target_Name = {{ fsal.target_name | e }};
  {% endif %}
}
{% endfor %}

## Cluster configuration (for high availability)
{% if ha.enabled %}
CLUSTER {
  ## HA mode (HA_ENABLED, HA_DISABLE)
  HA_Mode = {{ ha.mode | default('HA_ENABLED') }};
  ## HA peers
  {% for peer in ha.peers %}
  PEER {
    Name = {{ peer.name | e }};
    Address = {{ peer.address | e }};
    Heartbeat = {
      Interval = {{ peer.heartbeat.interval | default(2) }};
      Timeout = {{ peer.heartbeat.timeout | default(6) }};
    };
  };
  {% endfor %}
}
{% endif %}

## RPC configuration
RPC {
  ## RPC transport mode (TCP, UDP, TLS)
  Transport = {{ rpc.transport | default('TCP') }};
  ## Port for NFSv3 services (mountd, statd, etc.)
  Mount_Point = {{ rpc.mount_port | default(0) }};
  ## Port for NFS service (2049)
  NFS_Port = {{ rpc.nfs_port | default(2049) }};
  ## Number of RPC threads
  Threads = {{ rpc.threads | default(16) }};
}
