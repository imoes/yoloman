{
  "host": {
    "type": "string",
    "default": "localhost",
    "description": "Hostname or IP address of the Music Player Daemon server"
  },
  "port": {
    "type": "number",
    "default": 6600,
    "description": "Port number for the MPD connection"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Password for authenticating with the MPD server"
  },
  "repeat": {
    "type": "bool",
    "default": true,
    "description": "Toggle repeat mode"
  },
  "random": {
    "type": "bool",
    "default": false,
    "description": "Toggle random mode"
  },
  "popup": {
    "type": "bool",
    "default": false,
    "description": "Enable popup song notifications (requires D-Bus)"
  },
  "start_hidden": {
    "type": "bool",
    "default": false,
    "description": "Start the app hidden in the system tray (requires systray)"
  },
  "profile": {
    "type": "number",
    "default": 0,
    "description": "Profile number to start with"
  }
}
