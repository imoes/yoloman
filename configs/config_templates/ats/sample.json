{
  "proxy_name": "edge-proxy-01",
  "server_ports": [
    "8080",
    "8443"
  ],
  "ssl_enabled": true,
  "server_ssl_port": 8443,
  "http_accept_enabled": 1,
  "http_accept_threads": 2,
  "connect_attempts_timeout": 10,
  "connect_attempts_max_retries": 3,
  "post_connect_attempts_timeout": 5,
  "transaction_no_activity_timeout_in": 90,
  "transaction_active_timeout_in": 600,
  "response_active_timeout_in": 300,
  "cache_enable_checksum": 1,
  "cache_enable_read_while_writer": 1,
  "cache_rw_parallelism": 0,
  "cache_min_average_object_size": 10000,
  "cache_threads_per_disk": 2,
  "cache_volumes": [
    {
      "size": 2147483648,
      "remap": true
    }
  ],
  "log_logging_enabled": 2,
  "log_dir": "/var/log/trafficserver",
  "log_perm": "0640",
  "log_rolling_enabled": 1,
  "log_rolling_interval_sec": 86400,
  "log_rolling_size_mb": 100,
  "enable_remap": true,
  "remap_required": 1,
  "pristine_host_hdr": 0,
  "enable_http2": true,
  "http2_enabled": 1,
  "http2_max_concurrent_streams": 128,
  "http2_min_stream_priority": 0,
  "http2_max_frame_size": 16384,
  "ssl_cert_path": "/etc/trafficserver/ssl/certs",
  "ssl_key_path": "/etc/trafficserver/ssl/private",
  "ssl_cipher_suite": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "ssl_keylog_enabled": 0,
  "ssl_client_verify_server": 0,
  "dump_config": 0,
  "diags_debug_enabled": 0,
  "diags_debug_tags": [
    "http",
    "cache"
  ],
  "exec_thread_autoconfig": true,
  "exec_thread_limit": 4,
  "exec_thread_affinity": 1,
  "ram_cache_size_mb": 2048,
  "ram_cache_algorithm": 0,
  "max_redirections": 3,
  "max_connections_in": 100000,
  "connections_throttle": 100000
}
