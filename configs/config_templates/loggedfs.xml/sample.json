{
  "mount_point": "/var/www",
  "backend": "file",
  "log_file_path": "/var/log/loggedfs/www.log",
  "verbose": 2,
  "json_output": true,
  "log_prefix": "[loggedfs]",
  "max_log_size": 52428800,
  "max_log_files": 3,
  "log_operations": [
    "write",
    "unlink",
    "rename",
    "chmod"
  ],
  "exclude_paths": [
    "/var/www/cache/*",
    "/var/www/tmp/*"
  ],
  "follow_symlinks": false,
  "log_metadata": true
}
