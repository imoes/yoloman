# ConsoleKit / ConsoleKit2 Seat Configuration
# This template generates a seat entry configuration for ConsoleKit.
# ConsoleKit is a system for defining, tracking, and managing user logins.
# While largely superseded by systemd-logind on modern Linux systems,
# some legacy environments or specific desktop environments may still reference it.
#
# Note: This template is static based on the provided schema.
# The schema provided had no dynamic fields, so the output is a fixed configuration.
# If dynamic seat management is required, this should be handled by the service manager
# (e.g., systemd) rather than a static config file.

[Seat Entry]
# Version of the seat configuration format
# Default: 1.0
Version=1.0

# Human-readable name for the seat
# Default: Primary seat
Name=Primary seat

# Whether the seat should be hidden from the login manager
# true = hidden, false = visible
# Default: false
Hidden=false

# List of devices assigned to this seat (e.g., /dev/input/event0)
# Empty list indicates default device detection or manual assignment via udev
# Default: (empty)
Devices=
