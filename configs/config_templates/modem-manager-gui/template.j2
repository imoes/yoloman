# Modem Manager GUI Configuration
# This file controls the startup arguments for modem-manager-gui.
# It is used to configure the backend modules and startup behavior of the GUI application.

# Whether to start modem-manager-gui in invisible mode without showing the main window.
# Corresponds to -i, --invisible
# Default: false (show main window)
invisible={{ invisible | default(false) | lower }}

# The modem management module backend to use (e.g., Modem Manager, oFono, or Wader).
# Corresponds to -m, --mmmodule
# Supported values: 'mm' (default), 'ofono', 'wader'
mmmodule={{ mmmodule | default('mm') }}

# The connection management module backend to use (e.g., NetworkManager, ConnMan).
# Corresponds to -c, --cmmodule
# Supported values: 'NetworkManager' (default), 'connman', 'wpa_supplicant'
cmmodule={{ cmmodule | default('NetworkManager') }}