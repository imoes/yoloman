{
  "dgroup": "users",
  "home": "/home",
  "skel": "/etc/skel",
  "first_uid": 1000,
  "last_uid": 60000,
  "first_gid": 1000,
  "last_gid": 60000,
  "usergroups_enab": true,
  "mkhomedir": true,
  "add_extra_groups": false,
  "add_extra_groups_default": [
    "audio",
    "video",
    "cdrom",
    "floppy"
  ],
  "default_home": true,
  "dir_mode": "0755",
  "setgid_home": false,
  "skeleton": "/etc/skel",
  "no_user_group": false,
  "range_config": [
    {
      "key": "SYSTEM_UID_MIN",
      "value": "100",
      "description": "First UID for system accounts (users with UID < SYSTEM_UID_MIN are considered system users)."
    },
    {
      "key": "SYSTEM_UID_MAX",
      "value": "999",
      "description": "Last UID for system accounts."
    },
    {
      "key": "SYSTEM_GID_MIN",
      "value": "100",
      "description": "First GID for system groups."
    },
    {
      "key": "SYSTEM_GID_MAX",
      "value": "999",
      "description": "Last GID for system groups."
    }
  ]
}
