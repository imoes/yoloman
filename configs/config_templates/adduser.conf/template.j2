# Default settings for adduser(8), used when creating new users interactively or via --disabled-password.
# Uncomment and modify lines below to override defaults.
# The values below are defaults unless overridden by command-line options.
# DGROUP: group to which new users are added by default (if not specified with --group)
DGROUP={{ dgroup }}

# HOME: base directory for new users' home directories
HOME={{ home }}

# SKEL: skeleton directory from which /etc/skel/ files are copied to new homes
SKEL={{ skel }}

# FIRST_UID: first UID to use for regular users (system users start at FIRST_SYSTEM_UID)
FIRST_UID={{ first_uid }}

# LAST_UID: last UID to use for regular users
LAST_UID={{ last_uid }}

# FIRST_GID: first GID to use for regular user groups
FIRST_GID={{ first_gid }}

# LAST_GID: last GID to use for regular user groups
LAST_GID={{ last_gid }}

# USERGROUPS_ENAB: if enabled, a group is created for each new user (same name as username)
USERGROUPS_ENAB={{ usergroups_enab }}

# MKHOMEDIR: if enabled, home directory is created if missing (via mkhomedir_helper)
MKHOMEDIR={{ mkhomedir }}

# ADD_EXTRA_GROUPS: if enabled, new users are added to supplementary groups listed in ADD_EXTRA_GROUPS_DEFAULT
ADD_EXTRA_GROUPS={{ add_extra_groups }}

# ADD_EXTRA_GROUPS_DEFAULT: comma-separated list of supplementary groups added when ADD_EXTRA_GROUPS is enabled
ADD_EXTRA_GROUPS_DEFAULT={{ add_extra_groups_default | join(',') }}

# DEFAULT_HOME: if enabled, home directory is always created (even if user already exists with existing home)
DEFAULT_HOME={{ default_home }}

# DIR_MODE: permission mode (octal) used when creating home directories
DIR_MODE={{ dir_mode }}

# SETGID_HOME: if enabled, new home directories inherit the group (setgid bit set)
SETGID_HOME={{ setgid_home }}

# SKELETON: same as SKEL — legacy alias (prefer SKEL)
SKELETON={{ skeleton }}

# NO_USER_GROUP: if enabled, do not create a group per user (overrides USERGROUPS_ENAB)
NO_USER_GROUP={{ no_user_group }}

# SYSTEM_UID_MIN to SYSTEM_GID_MAX: ranges for system accounts
# Note: actual ranges may depend on system configuration (/etc/login.defs)
# These are included for completeness; usually not changed manually
{% for item in range_config %}
# {{ item.description }}
{% if item.key %}{{ item.key }}={{ item.value }}
{% endif %}{% endfor %}
