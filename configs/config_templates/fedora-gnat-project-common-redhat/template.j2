# This template configures the global environment variables for GNAT (GNU Ada)
# project builds on Red Hat/Fedora systems. It ensures that build scripts and
# project files have access to the underlying hardware architecture information,
# which they cannot determine dynamically via shell-outs.

# Set the HARDWARE_PLATFORM environment variable to the machine's hardware
# architecture string (e.g., x86_64, aarch64). This is derived at runtime
# using the `uname -m` command.
setenv HARDWARE_PLATFORM `uname -m`
