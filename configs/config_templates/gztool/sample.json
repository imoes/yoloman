{
  "compression_level": 6,
  "index_span": 10,
  "verbosity": 1,
  "output_suffix": ".gz",
  "index_directory": "/var/lib/gztool/indexes",
  "index_line_info": "unix",
  "supervision_enabled": true,
  "patching_enabled": true,
  "await_time": 4,
  "files": [
    "/var/log/app.log.gz",
    "/var/log/nginx/access.log.gz"
  ]
}
