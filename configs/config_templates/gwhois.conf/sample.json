{
  "base_domain": "example.com",
  "log_level": "warning",
  "log_file": "/var/log/gwhois.log",
  "server_host": "whois.internic.net",
  "server_port": 43,
  "connect_timeout": 15,
  "ipv6_enabled": true,
  "cache_enabled": true,
  "cache_dir": "/var/cache/gwhois",
  "cache_ttl": 7200,
  "cache_max_entries": 500,
  "response_rules": [
    {
      "name": "example-com",
      "pattern": "example.com$",
      "server_host": "whois.example.com",
      "server_port": 43
    },
    {
      "name": "test-domains",
      "pattern": "^test-",
      "server_host": "whois.test.example.net",
      "timeout": 30
    }
  ]
}
