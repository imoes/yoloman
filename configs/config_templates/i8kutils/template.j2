# ============================================================================
# i8kutils Configuration Template
# ============================================================================
# This template generates the configuration file for i8kutils (i8kmon/i8kutils),
# used to control fan speeds on IBM/Lenovo ThinkPad laptops based on thermal readings.
# ============================================================================

# Status check timeout in seconds
# Controls how often the i8kmon daemon checks system status.
set config(timeout)     {{ timeout | default('2') }}

# Temperature threshold for red display
# Temperature threshold at which the temperature is displayed in red
set config(t_high)      {{ t_high | default('80') }}

# Number of temperature configurations
# Number of temperature configurations
set config(num_configs) {{ num_configs | default('5') }}

# ============================================================================
# Temperature Configuration Blocks
# ============================================================================
# Each block defines a fan speed state with associated thermal thresholds.
# Format: set config(N) {fan_speed} low_ac high_ac low_batt high_batt
# - fan_speed: Code representing fan speed state (e.g., '0 0' for off, '0 1' for low).
# - low_ac:    Low AC temperature threshold (degrees C)
# - high_ac:   High AC temperature threshold (degrees C)
# - low_batt:  Low Battery temperature threshold (degrees C)
# - high_batt: High Battery temperature threshold (degrees C)
#
# Note: The fan speed code is embedded in curly braces to survive Jinja2 parsing.

# Configuration 0: Initial/Low power state
# Low AC temperature threshold for config 0: {{ temp_0_ac_low | default(-1) }}
# High AC temperature threshold for config 0: {{ temp_0_ac_high | default(50) }}
# Low Battery temperature threshold for config 0: {{ temp_0_batt_low | default(-1) }}
# High Battery temperature threshold for config 0: {{ temp_0_batt_high | default(50) }}
set config(0)   {{ '{' }}0 0{{ '}' }}  {{ temp_0_ac_low | default(-1) }}  {{ temp_0_ac_high | default(50) }}  {{ temp_0_batt_low | default(-1) }}  {{ temp_0_batt_high | default(50) }}

# Configuration 1: Moderate load state
# Low AC temperature threshold for config 1: {{ temp_1_ac_low | default(45) }}
# High AC temperature threshold for config 1: {{ temp_1_ac_high | default(55) }}
# Low Battery temperature threshold for config 1: {{ temp_1_batt_low | default(45) }}
# High Battery temperature threshold for config 1: {{ temp_1_batt_high | default(55) }}
set config(1)   {{ '{' }}0 1{{ '}' }}  {{ temp_1_ac_low | default(45) }}  {{ temp_1_ac_high | default(55) }}  {{ temp_1_batt_low | default(45) }}  {{ temp_1_batt_high | default(55) }}

# Configuration 2: High load state
# Low AC temperature threshold for config 2: {{ temp_2_ac_low | default(50) }}
# High AC temperature threshold for config 2: {{ temp_2_ac_high | default(65) }}
# Low Battery temperature threshold for config 2: {{ temp_2_batt_low | default(50) }}
# High Battery temperature threshold for config 2: {{ temp_2_batt_high | default(65) }}
set config(2)   {{ '{' }}1 1{{ '}' }}  {{ temp_2_ac_low | default(50) }}  {{ temp_2_ac_high | default(65) }}  {{ temp_2_batt_low | default(50) }}  {{ temp_2_batt_high | default(65) }}

# Configuration 3: Critical load state
# Low AC temperature threshold for config 3: {{ temp_3_ac_low | default(60) }}
# High AC temperature threshold for config 3: {{ temp_3_ac_high | default(70) }}
# Low Battery temperature threshold for config 3: {{ temp_3_batt_low | default(60) }}
# High Battery temperature threshold for config 3: {{ temp_3_batt_high | default(70) }}
set config(3)   {{ '{' }}1 2{{ '}' }}  {{ temp_3_ac_low | default(60) }}  {{ temp_3_ac_high | default(70) }}  {{ temp_3_batt_low | default(60) }}  {{ temp_3_batt_high | default(70) }}

# Configuration 4: Maximum/Throttling state
# Low AC temperature threshold for config 4: {{ temp_4_ac_low | default(65) }}
# High AC temperature threshold for config 4: {{ temp_4_ac_high | default(128) }}
# Low Battery temperature threshold for config 4: {{ temp_4_batt_low | default(65) }}
# High Battery temperature threshold for config 4: {{ temp_4_batt_high | default(128) }}
set config(4)   {{ '{' }}2 2{{ '}' }}  {{ temp_4_ac_low | default(65) }}  {{ temp_4_ac_high | default(128) }}  {{ temp_4_batt_low | default(65) }}  {{ temp_4_batt_high | default(128) }}

# ============================================================================
# Fan Speed Status Overrides
# ============================================================================
# These values prevent i8kmon from probing fan speeds on every startup,
# improving performance and stability.

# Left fan speed values string
# Space-separated string defining RPMs for left fan states
set status(leftspeed)	"{{ status_leftspeed | default('0 2500 5000 5000') }}"

# Right fan speed values string
# Space-separated string defining RPMs for right fan states
set status(rightspeed)	"{{ status_rightspeed | default('0 2500 5000 5000') }}"

# end of file
