# Cumin configuration file — main settings for the distributed command execution framework

# Backend message bus connection details
{% if transport == 'stomp' %}
transport: stomp
{% elif transport == 'rabbitmq' %}
transport: rabbitmq
{% elif transport == 'redis' %}
transport: redis
{% else %}
transport: stomp
{% endif %}

host: {{ host }}
port: {{ port }}
user: {{ user }}
password: {{ password }}

# Optional SSL/TLS configuration
{% if ssl.enabled %}
ssl:
  certfile: {{ ssl.certfile }}
  keyfile: {{ ssl.keyfile }}
  ca_certs: {{ ssl.ca_certs }}
  cert_reqs: {{ ssl.cert_reqs }}
{% else %}
ssl: {}
{% endif %}

# Logging configuration
loglevel: {{ loglevel }}
logfile: {{ logfile }}

# Execution pool and timeout settings
execution:
  timeout: {{ execution.timeout }}
  pool_size: {{ execution.pool_size }}
  retry_interval: {{ execution.retry_interval }}
  max_retries: {{ execution.max_retries }}

# Default target (if no target specified in command)
default_target: {{ default_target }}

# List of allowed target patterns (empty list = no restriction)
{% if allowed_targets %}
allowed_targets:
{% for pattern in allowed_targets %}  - {{ pattern }}
{% endfor %}
{% else %}
allowed_targets: []
{% endif %}

# Modules to load (empty list = auto-load all known modules)
{% if modules %}
modules:
{% for module in modules %}  - {{ module }}
{% endfor %}
{% else %}
modules: []
{% endif %}

# Command whitelist (if empty, all commands allowed)
{% if command_whitelist %}
command_whitelist:
{% for cmd in command_whitelist %}  - {{ cmd }}
{% endfor %}
{% else %}
command_whitelist: []
{% endif %}

# Pre/Post command hooks (optional)
{% if hooks %}
hooks:
  pre: {{ hooks.pre }}
  post: {{ hooks.post }}
{% else %}
hooks: {}
{% endif %}

# Stats collection (Prometheus metrics endpoint)
{% if stats.enabled %}
stats:
  enabled: true
  port: {{ stats.port }}
  path: {{ stats.path }}
{% else %}
stats:
  enabled: false
  port: 9090
  path: /metrics
{% endif %}

# Debug mode (verbose output, no throttling)
debug: {{ debug }}
