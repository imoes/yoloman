{
  "listen_address": "127.0.0.1",
  "listen_port": 10041,
  "worker_processes": 4,
  "pid_file": "/run/groonga/groonga.pid",
  "log_level": "notice",
  "log_path": "/var/log/groonga/groonga.log",
  "db_path": "/var/lib/groonga/db",
  "access_log_enabled": true,
  "access_log_path": "/var/log/groonga/access.log",
  "default_db": "/var/lib/groonga/db/default.db",
  "ssl_enabled": false,
  "ssl_certificate_path": "",
  "ssl_certificate_key_path": "",
  "max_connections": 1024,
  "client_timeout": 60,
  "client_max_body_size": 10485760,
  "gzip_enabled": true,
  "gzip_types": [
    "application/json",
    "text/plain",
    "text/html"
  ],
  "server_name": "groonga.example.com",
  "maintenance_mode_enabled": false,
  "maintenance_message": "",
  "extra_options": {
    "token_filters": "TokenBigram",
    "normalizers": "NormalizerNFKC100"
  }
}
