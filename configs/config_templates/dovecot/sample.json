{
 "dovecot": {
  "auth_mechanisms": [
   "plain",
   "login",
   "cram-md5"
  ],
  "base_dir": "/var/run/dovecot",
  "global_mail_plugins": [
   "acl",
   "quota"
  ],
  "gssapi": {
   "enable": false
  },
  "info_log_path": "/var/log/dovecot-info.log",
  "lda_plugins": [
   "sieve"
  ],
  "log_path": "/var/log/dovecot.log",
  "login_trusted_networks": [
   "127.0.0.0/8",
   "::1/128"
  ],
  "mail_fsync": "optimal",
  "mail_location": "maildir:~/Maildir",
  "mail_max_userip_connections": 20,
  "namespace": {
   "inbox": true,
   "prefix": "",
   "separator": "/",
   "type": "private"
  },
  "passdb": {
   "args": "driver=mysql\nconnect = host=/var/run/mysqld/mysqld.sock dbname=mail user=mail password=secret\npassword_query = SELECT email as user, password FROM users WHERE email='%u' AND active=1\n",
   "driver": "sql"
  },
  "post_auth_script": "/usr/local/bin/log-auth-event.sh",
  "protocols": [
   "imap",
   "pop3",
   "lmtp"
  ],
  "quota": {
   "enable": true,
   "quota_grace": 10,
   "quota_max_mailbox": "10G",
   "quota_rule": "storage=5G"
  },
  "services": [
   {
    "chroot": "login",
    "listen": "",
    "max_spare": 3,
    "min_spare": 1,
    "name": "imap-login",
    "process_limit": 2,
    "user": "dovecot"
   },
   {
    "chroot": "login",
    "listen": "",
    "max_spare": 1,
    "min_spare": 0,
    "name": "pop3-login",
    "process_limit": 1,
    "user": "dovecot"
   },
   {
    "group": "vmail",
    "name": "imap",
    "process_limit": 10,
    "user": "vmail"
   },
   {
    "group": "vmail",
    "name": "pop3",
    "process_limit": 5,
    "user": "vmail"
   },
   {
    "chroot": "",
    "group": "vmail",
    "name": "lmtp",
    "user": "vmail"
   }
  ],
  "ssl_cert_path": "/etc/ssl/certs/dovecot.crt",
  "ssl_key_path": "/etc/ssl/private/dovecot.key",
  "ssl_min_protocol": "TLSv1.2",
  "ssl_mode": "required",
  "ssl_prefer_server_ciphers": true,
  "userdb": {
   "args": "driver=mysql\nconnect = host=/var/run/mysqld/mysqld.sock dbname=mail user=mail password=secret\nuser_query = SELECT maildir, 5000 AS uid, 5000 AS gid FROM users WHERE email='%u'\n",
   "driver": "sql"
  }
 }
}
