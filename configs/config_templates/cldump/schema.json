{
  "default_action": {
    "type": "string",
    "default": "active",
    "description": "Dump mode: 'active' (-d), 'data' (-D), 'meta' (-m), or 'schema' (-s)",
    "enum": [
      "active",
      "data",
      "meta",
      "schema"
    ]
  },
  "output_format": {
    "type": "string",
    "default": "none",
    "description": "Output format: 'csv' (-c), 'sql' (-S), or 'none' for meta/schema-only"
  },
  "use_mysql": {
    "type": "bool",
    "default": false,
    "description": "Enable MySQL-specific SQL syntax (backticks etc.) (-M)"
  },
  "field_separator": {
    "type": "string",
    "default": ",",
    "description": "Character used as field separator in CSV output (-f c)"
  },
  "no_memo": {
    "type": "bool",
    "default": false,
    "description": "Skip dumping memo entries (-n)"
  },
  "decrypt_slot": {
    "type": "number",
    "default": 0,
    "description": "Decryption key slot (1-4); 0 disables decryption (-x n)"
  },
  "utf8_source_charset": {
    "type": "string",
    "default": "ISO8859-1",
    "description": "Source character set for -U transcoding to UTF-8 (defaults to ISO8859-1)"
  },
  "database_files": {
    "type": "list",
    "default": [],
    "description": "List of Clarion .DAT files to process (required positional arguments)"
  }
}
