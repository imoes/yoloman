# vim:syntax=apparmor
# Application: lomiri-addressbook-app
# Description: AppArmor security profile configuration for the Lomiri Address Book application.
# Self-documented: Every directive is preceded by its schema description.

#include <tunables/global>

# profile_name: The name of the AppArmor profile to apply.
# The profile name is used to uniquely identify this security policy in the kernel.
# Default is 'lomiri-addressbook-app'.
profile {{ profile_name | default('lomiri-addressbook-app') }} (attach_disconnected) {
  # network: Allow all network operations (TCP/UDP/Unix sockets).
  # This grants broad network access suitable for an app that may communicate
  # with local services or remote servers.
  network,

  # / rwkl: Allow read, write, lock, and open on the root directory '/' directly.
  # This is a very permissive rule, typically used for temporary files or
  # specific system interactions requiring root-level directory access.
  / rwkl,

  # /** rwlkm: Allow read, write, lock, mmap, and execute on all files recursively.
  # This grants access to the entire filesystem hierarchy.
  # Note: 'pix' below handles execute permissions specifically for binaries/libraries.
  /** rwlkm,

  # /** pix: Allow read, execute, and inherit execute permissions on all files recursively.
  # 'p' stands for inherit execute, 'i' for inherit, 'x' for execute.
  # This allows the profile to execute binaries and libraries found anywhere in the filesystem.
  /** pix,

  # dbus: Allow access to the D-Bus message bus.
  # Essential for inter-process communication in Linux desktop environments.
  dbus,

  # signal: Allow sending and receiving signals (e.g., SIGTERM, SIGKILL).
  # Required for process management and handling termination requests.
  signal,

  # ptrace: Allow process tracing (e.g., debugging, profiling).
  # Often needed for development tools or system monitors attached to the app.
  ptrace,

  # unix: Allow usage of Unix domain sockets.
  # Critical for local IPC on Unix-like systems.
  unix,
}
