# NFOVIEW configuration
# Nfoview is a simple ASCII/NFO file viewer. This file controls its rendering preferences.

# The font family to use for rendering NFO files. Terminus is the standard recommended font for CP437 art.
font = {{ font|default('Terminus') }}

# The character encoding of the NFO files to be displayed. CP437 is the standard IBM PC character set used in classic NFOs.
encoding = {{ encoding|default('CP437') }}

# Whether to enable clickable hyperlink detection within NFO files.
hyperlinks = {{ hyperlinks|default(true)|bool | lower }}

# Whether to automatically resize the viewer window to fit the dimensions of the NFO file.
auto_resize = {{ auto_resize|default(true)|bool | lower }}