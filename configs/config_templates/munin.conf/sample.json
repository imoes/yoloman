{
  "web_enabled": true,
  "htmldir": "/var/www/munin",
  "vardir": "/var/lib/munin",
  "logdir": "/var/log/munin",
  "rundir": "/run/munin",
  "graph_interval": 300,
  "graph_periods": [
    "hourly",
    "daily",
    "weekly",
    "monthly",
    "yearly"
  ],
  "contact_addresses": [
    "admin@example.com",
    "ops@example.com"
  ],
  "contact_always_send": false,
  "munin_master": "/usr/bin/munin-master",
  "munin_html": "/usr/bin/munin-html",
  "munin_graph": "/usr/bin/munin-graph",
  "munin_logcheck": "/usr/bin/munin-logcheck",
  "munin_update": "/usr/bin/munin-update",
  "cron_d": "/etc/cron.d",
  "include_dir": "/etc/munin/munin-conf.d",
  "nodes": [
    {
      "name": "localhost",
      "address": "127.0.0.1",
      "port": 4949,
      "plugins": [
        "cpu",
        "df",
        "load",
        "memory",
        "processes"
      ],
      "use_node_name": false
    },
    {
      "name": "web01",
      "address": "10.0.0.10",
      "port": 4949,
      "plugins": [
        "apache_accesses",
        "apache_processes",
        "apache_requests"
      ],
      "use_node_name": true
    },
    {
      "name": "db01",
      "address": "10.0.0.20",
      "port": 4949,
      "plugins": [
        "mysql_connections",
        "mysql_qcache",
        "mysql_slowqueries"
      ],
      "use_node_name": false
    }
  ]
}
