# Enable standalone mode
{% if standalone %} echo 'yes' > /etc/pure-ftpd/conf/standalone{% endif %}
# Enable IPv6 (only in standalone mode)
{% if ipv6 %} echo 'yes' > /etc/pure-ftpd/conf/ipv6{% endif %}
# Listen address and port
{% if standalone %}echo '{{ bind_address }}:{{ port }}' > /etc/pure-ftpd/conf/Bind{% endif %}
# Maximum number of simultaneous clients
{% if standalone %}echo '{{ max_clients }}' > /etc/pure-ftpd/conf/MaxClientsNumber{% endif %}
# Maximum connections per IP (0 = unlimited)
{% if standalone %}echo '{{ max_clients_per_ip }}' > /etc/pure-ftpd/conf/MaxClientsPerIP{% endif %}
# TCP connection timeout (seconds)
{% if standalone %}echo '{{ timeout }}' > /etc/pure-ftpd/conf/TimeoutIdle{% endif %}
# Minimum UID for login (prevents root login)
{% if standalone %}echo '{{ min_uid }}' > /etc/pure-ftpd/conf/MinUID{% endif %}
# Require valid system user (not anonymous-only)
{% if require_valid_shell %}echo 'yes' > /etc/pure-ftpd/conf/ChrootEveryone{% endif %}
# Enable TLS/SSL support
{% if tls %}echo '1' > /etc/pure-ftpd/conf/TLSCipherSuite
echo '/etc/ssl/private/pure-ftpd.pem' > /etc/pure-ftpd/conf/TLSCertificate
echo 'yes' > /etc/pure-ftpd/conf/ForceTLS{% endif %}
# Passive port range (required for passive FTP through firewalls)
{% if tls %}echo '{{ passive_port_min }}:{{ passive_port_max }}' > /etc/pure-ftpd/conf/PassivePortRange{% endif %}
# Public host name (for NAT/firewall setups)
{% if tls %}echo '{{ public_host }}' > /etc/pure-ftpd/conf/ForcePassiveIP{% endif %}
# Disable anonymous login
{% if not anonymous_enabled %}echo 'no' > /etc/pure-ftpd/conf/NoAnonymous{% endif %}
# Enable Unix authentication (via PAM/system users)
{% if unix_authentication %}rm -f /etc/pure-ftpd/conf/PAMAuthentication
{% else %}echo '1' > /etc/pure-ftpd/conf/PAMAuthentication{% endif %}
# Enable LDAP authentication (if enabled)
{% for ldap_conf in ldap_configs %}echo '{{ ldap_conf.value }}' > /etc/pure-ftpd/conf/{{ ldap_conf.key }}
{% endfor %}
# Custom drop-in files (e.g., AltLog, Umask, etc.)
{% for key, value in custom_settings.items() %}echo '{{ value }}' > /etc/pure-ftpd/conf/{{ key }}
{% endfor %}