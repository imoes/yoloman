# /etc/ftpusers: list of users disallowed FTP access.
# These users are blocked from logging into the FTP server via pure-ftpd.
# Users listed here are denied access before any authentication takes place.
{% for user in (ftp_denied_users | default(['root', 'daemon', 'bin', 'sys', 'sync', 'games', 'man', 'lp', 'mail', 'news', 'uucp', 'proxy', 'majordom', 'postgres', 'www-data', 'backup', 'msql', 'operator', 'list', 'irc', 'nobody'])) %}
{{ user }}
{% endfor %}