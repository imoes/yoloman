{
  "standalone": true,
  "ipv6": false,
  "bind_address": "0.0.0.0",
  "port": 21,
  "max_clients": 25,
  "max_clients_per_ip": 3,
  "timeout": 600,
  "min_uid": 1000,
  "require_valid_shell": true,
  "tls": true,
  "tls_cipher_suite": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "tls_certificate_path": "/etc/ssl/private/pure-ftpd-fullchain.pem",
  "force_tls": true,
  "passive_port_min": 40000,
  "passive_port_max": 40050,
  "public_host": "ftp.example.com",
  "anonymous_enabled": false,
  "unix_authentication": true,
  "ldap_configs": [],
  "custom_settings": {
    "AltLog": "clf:/var/log/pure-ftpd/transfer.log",
    "Umask": "022",
    "MinDiskSpace": "512"
  }
}
