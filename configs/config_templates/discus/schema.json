{
  "color_enabled": {
    "type": "number",
    "default": 1,
    "description": "Enable/disable colored output"
  },
  "divisor": {
    "type": "number",
    "default": 1,
    "description": "Power of 1024; smallest value is 0 for KB (used when smart formatting is disabled)"
  },
  "graph_enabled": {
    "type": "number",
    "default": 1,
    "description": "Enable/disable graph display"
  },
  "graph_char": {
    "type": "string",
    "default": "*",
    "description": "Character used for graph fill"
  },
  "graph_fill": {
    "type": "string",
    "default": "-",
    "description": "Character used for graph background"
  },
  "mtab_path": {
    "type": "string",
    "default": "/etc/mtab",
    "description": "Path to mtab file (or shell command prefixed with !)"
  },
  "places": {
    "type": "number",
    "default": 1,
    "description": "Number of decimal places to display"
  },
  "skip_list": {
    "type": "list",
    "default": [
      "/dev/pts",
      "/proc",
      "/dev",
      "/proc/usb",
      "/sys"
    ],
    "description": "List of filesystems to ignore"
  },
  "smart_enabled": {
    "type": "number",
    "default": 1,
    "description": "Enable/disable smart number formatting"
  }
}
