# ==============================================================================
# WebFS Configuration Template
# Self-documenting: All variables map to schema fields. Defaults are inline.
# WebFS is a simple, non-persistent, threaded HTTP server.
# ==============================================================================

# web_root: The document root directory served by webfs.
# Default: '' (Empty string, typically requires explicit setting)
root {{ web_root | default('') }}

# web_host: The hostname or server name.
# Default: ''
host {{ web_host | default('') }}

# web_ip: The IP address to bind to.
# Default: '' (Binds to all interfaces if empty)
ip {{ web_ip | default('') }}

# web_port: The port number to listen on.
# Default: '' (Standard web port 80 if empty, but explicit is safer)
port {{ web_port | default('') }}

# web_timeout: Connection timeout value.
# Default: ''
timeout {{ web_timeout | default('') }}

# web_conn: Maximum number of connections.
# Default: ''
conn {{ web_conn | default('') }}

# web_dircache: Directory cache size.
# Default: ''
dircache {{ web_dircache | default('') }}

# web_index: Index file name.
# Default: ''
index {{ web_index | default('') }}

# web_accesslog: Path to the access log file.
# Default: ''
accesslog {{ web_accesslog | default('') }}

# web_logbuffering: Enable log buffering (true/false).
# Default: true
logbuffering {{ web_logbuffering | default('true') }}

# web_syslog: Enable syslog logging (true/false).
# Default: true
syslog {{ web_syslog | default('true') }}

# web_virtual: Enable virtual hosting (true/false).
# Default: true
virtual {{ web_virtual | default('true') }}

# web_user: User to run the webfs daemon as.
# Default: '' (Runs as current user if empty)
user {{ web_user | default('') }}

# web_group: Group to run the webfs daemon as.
# Default: '' (Runs as current group if empty)
group {{ web_group | default('') }}

# web_cgipath: Path for CGI scripts.
# Default: ''
cgipath {{ web_cgipath | default('') }}

# web_extras: Additional command line arguments.
# Default: ''
{% if web_extras | default('') %}
{{ web_extras | default('') }}
{% endif %}