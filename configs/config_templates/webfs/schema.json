{
  "web_root": {
    "type": "string",
    "default": "",
    "description": "The document root directory served by webfs."
  },
  "web_host": {
    "type": "string",
    "default": "",
    "description": "The hostname or server name."
  },
  "web_ip": {
    "type": "string",
    "default": "",
    "description": "The IP address to bind to."
  },
  "web_port": {
    "type": "string",
    "default": "",
    "description": "The port number to listen on."
  },
  "web_timeout": {
    "type": "string",
    "default": "",
    "description": "Connection timeout value."
  },
  "web_conn": {
    "type": "string",
    "default": "",
    "description": "Maximum number of connections."
  },
  "web_dircache": {
    "type": "string",
    "default": "",
    "description": "Directory cache size."
  },
  "web_index": {
    "type": "string",
    "default": "",
    "description": "Index file name."
  },
  "web_accesslog": {
    "type": "string",
    "default": "",
    "description": "Path to the access log file."
  },
  "web_logbuffering": {
    "type": "string",
    "default": "true",
    "description": "Enable log buffering (true/false)."
  },
  "web_syslog": {
    "type": "string",
    "default": "true",
    "description": "Enable syslog logging (true/false)."
  },
  "web_virtual": {
    "type": "string",
    "default": "true",
    "description": "Enable virtual hosting (true/false)."
  },
  "web_user": {
    "type": "string",
    "default": "",
    "description": "User to run the webfs daemon as."
  },
  "web_group": {
    "type": "string",
    "default": "",
    "description": "Group to run the webfs daemon as."
  },
  "web_cgipath": {
    "type": "string",
    "default": "",
    "description": "Path for CGI scripts."
  },
  "web_extras": {
    "type": "string",
    "default": "",
    "description": "Additional command line arguments."
  }
}
