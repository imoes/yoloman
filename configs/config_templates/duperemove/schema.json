{
  "files": {
    "type": "list",
    "default": [
      "/data"
    ],
    "description": "List of file or directory paths to scan (use ['-'] to read from stdin)"
  },
  "recursive": {
    "type": "bool",
    "default": true,
    "description": "Enable recursive directory traversal"
  },
  "dedupe": {
    "type": "bool",
    "default": false,
    "description": "Enable actual deduplication (requires btrfs/xfs)"
  },
  "hashfile": {
    "type": "string",
    "default": "",
    "description": "Path to hashfile for persistent storage (empty string = in-memory only)"
  },
  "block_size": {
    "type": "string",
    "default": "128K",
    "description": "Block size for hashing (e.g. '64K', '128K', '1M'); must match documented suffixes",
    "enum": [
      "64K",
      "128K"
    ],
    "enum_open": true
  },
  "hash_algo": {
    "type": "string",
    "default": "murmur3",
    "description": "Hash algorithm: 'murmur3' or 'xxhash'",
    "enum": [
      "murmur3",
      "xxhash"
    ]
  },
  "io_threads": {
    "type": "number",
    "default": null,
    "description": "Override I/O thread count (null = auto-detected)"
  },
  "cpu_threads": {
    "type": "number",
    "default": null,
    "description": "Override CPU thread count (null = auto-detected)"
  },
  "exclusions": {
    "type": "list",
    "default": [],
    "description": "List of full paths (or glob patterns) to exclude"
  },
  "dedupe_options": {
    "type": "list",
    "default": [
      "partial",
      "fiemap"
    ],
    "description": "List of dedupe options to enable (omit 'no' prefix); valid: 'partial', 'same', 'fiemap'"
  }
}
