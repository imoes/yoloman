{
  "files": [
    "/var/lib/vms",
    "/backup/images"
  ],
  "recursive": true,
  "dedupe": true,
  "hashfile": "/var/cache/duperemove/main.hash",
  "block_size": "128K",
  "hash_algo": "murmur3",
  "io_threads": null,
  "cpu_threads": null,
  "exclusions": [
    "/var/lib/vms/.snapshots",
    "/backup/images/skip-*"
  ],
  "dedupe_options": [
    "partial",
    "fiemap"
  ]
}
