{
 "addressbook_file": "~/.addressbook",
 "debug": "flush,timestamp,imap=1",
 "default_folder_collection": 1,
 "editor": "pico",
 "feature_list": "no-suspend no-threading",
 "folder_collections": [
  {
   "folders": [
    "INBOX",
    "Sent",
    "Drafts",
    "Trash"
   ],
   "name": "Main"
  }
 ],
 "folder_index_sort": "date",
 "function_keys": false,
 "imap_host": "imap.example.com",
 "imap_port": 993,
 "imap_use_ssl": true,
 "mailcap_path": "/etc/mailcap:/usr/share/mime/mailcap",
 "mime_types_file": "/etc/mime.types",
 "newmail_check_interval": 150,
 "password_cache": "~/.pine-passwd-cache",
 "restricted_mode": false,
 "sendmail_command": "/usr/sbin/sendmail -oem -t",
 "signature_file": "~/.signature",
 "smime_directory": "~/.alpine-smime",
 "smtp_host": "smtp.example.com",
 "smtp_use_ssl": false,
 "ssl_cert_verify": true,
 "suspend_allowed": false,
 "threading_enabled": true,
 "user_email": "jane.doe@example.com",
 "user_full_name": "Jane Doe",
 "xoauth2_client_id": "",
 "xoauth2_client_secret": "",
 "xoauth2_server": ""
}
