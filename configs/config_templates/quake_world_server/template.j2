# =============================================================================
# QuakeWorld Dedicated Server Configuration (mvdsv)
# =============================================================================
# This file is generated by Ansible. Do NOT edit manually.
# Each directive is accompanied by a comment derived from its schema definition.
# =============================================================================

# Server hostname displayed in server browser.
# Default: 'QuakeWorld Server'
{% set _sh = (server_hostname | default('QuakeWorld Server')) | string %}
hostname {{ _sh }}

# Admin contact email for server inquiries or issues.
# Default: '' (empty)
{% set _ae = (admin_email | default('')) | string %}
{% if _ae != '' %}
adminemail {{ _ae }}
{% endif %}

# Base directory where Quake game files (wads, models, etc.) are located.
# Default: '/usr/share/games/quake'
{% set _bd = (basedir | default('/usr/share/games/quake')) | string %}
basedir {{ _bd }}

# First map to load when the server starts (must exist in maps/ or basedir).
# Default: 'start'
{% set _sm = (start_map | default('start')) | string %}
map {{ _sm }}

# =============================================================================
# Network Settings
# =============================================================================

# TCP/UDP port the server listens on for QuakeWorld clients.
# Default: 26000
{% set _p = (port | default(26000)) | int %}
port {{ _p }}

# Maximum number of player slots (including reserved).
# Default: 16
{% set _mc = (maxclients | default(16)) | int %}
maxclients {{ _mc }}

# =============================================================================
# Server Rules
# =============================================================================

# Deathmatch mode (0 = coop, 1 = deathmatch, 2 = teamplay, 3 = arena).
# Default: 3
{% set _dm = (deathmatch | default(3)) | int %}
deathmatch {{ _dm }}

# Enable teamplay (0 = disabled, 1 = enabled).
# Default: 0
{% set _tp = (teamplay | default(0)) | int %}
teamplay {{ _tp }}

# Match ends when a player or team reaches this frag count (0 = disabled).
# Default: 0
{% set _fl = (fraglimit | default(0)) | int %}
fraglimit {{ _fl }}

# Match ends after this many minutes (0 = disabled).
# Default: 10
{% set _tl = (timelimit | default(10)) | int %}
timelimit {{ _tl }}

# =============================================================================
# Network Bandwidth and Tuning
# =============================================================================

# Maximum bytes/sec clients may download from server (0 = unlimited).
# Default: 25000
{% set _mr = (sv_maxrate | default(25000)) | int %}
sv_maxrate {{ _mr }}

# Minimum bytes/sec clients must receive (helps throttling).
# Default: 5000
{% set _mir = (sv_minrate | default(5000)) | int %}
sv_minrate {{ _mir }}

# Maximum updates per second the server sends to clients.
# Default: 20
{% set _mup = (sv_maxupdaterate | default(20)) | int %}
sv_maxupdaterate {{ _mup }}

# Minimum updates per second the server sends to clients.
# Default: 10
{% set _mip = (sv_minupdaterate | default(10)) | int %}
sv_minupdaterate {{ _mip }}

# =============================================================================
# Map List for Rotation (cycling)
# =============================================================================
# List of maps to cycle through in rotation.
# Default: ['start', 'e1m1', 'e1m2']
# Note: The first map in this list usually corresponds to the 'start' directive
# above, but mvdsv uses these map directives for cycling behavior.
{% set _ml = map_list | default(['start', 'e1m1', 'e1m2']) %}
{% for m in _ml %}
map {{ m }}
{% endfor %}

# =============================================================================
# Player Slot Reservation
# =============================================================================

# Number of slots reserved for admins or privileged players.
# Default: 0
{% set _rs = (reserved_slots | default(0)) | int %}
reserved_slots {{ _rs }}

# =============================================================================
# Spectator Settings
# =============================================================================

# Maximum number of spectator slots.
# Default: 2
{% set _msp = (maxspectators | default(2)) | int %}
maxspectators {{ _msp }}

# Whether to allow spectator connections.
# Default: True
{% set _as = allow_spectators | default(True) | bool %}
allow_spectators {{ _as }}

# =============================================================================
# Cheating Protection / Permissions
# =============================================================================

# Whether clients may download map/models from this server (required for custom content).
# Default: True
{% set _ad = allow_download | default(True) | bool %}
allow_download {{ _ad }}

# Whether clients may upload files to the server (rarely needed, security risk).
# Default: False
{% set _au = allow_upload | default(False) | bool %}
allow_upload {{ _au }}

# =============================================================================
# Log Settings
# =============================================================================

# Path to server log file. Set to empty string to disable logging.
# Default: '/var/log/mvdsv/server.log'
{% set _lf = (logfile | default('/var/log/mvdsv/server.log')) | string %}
{% if _lf != '' %}
logfile {{ _lf }}
{% endif %}

# =============================================================================
# Message of the Day (MOTD)
# =============================================================================

# Path to a text file containing the MOTD (Message of the Day). Overrides motd_lines if present.
# Default: '' (empty)
{% set _mf = (motd_file | default('')) | string %}
{% if _mf != '' %}
motd_file {{ _mf }}
{% endif %}

# Lines of text to show as the MOTD on client connect.
# Default: ['Welcome to QuakeWorld!', 'Type help for commands.']
{% set _mlines = motd_lines | default(['Welcome to QuakeWorld!', 'Type help for commands.']) %}
{% for line in _mlines %}
motd {{ line }}
{% endfor %}

# =============================================================================
# Extra Startup Commands
# =============================================================================

# Additional mvdsv-specific or plugin commands to run at startup (e.g., exec plugins.cfg).
# Default: [] (empty list)
{% set _esc = extra_startup_commands | default([]) %}
{% for cmd in _esc %}
{{ cmd }}
{% endfor %}

# =============================================================================
# Physics
# =============================================================================

# Server-side gravity value (Quake units per second²). Standard is ~800.
# Default: 800
{% set _gr = (gravity | default(800)) | int %}
gravity {{ _gr }}