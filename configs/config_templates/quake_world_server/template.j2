# QuakeWorld Dedicated Server Configuration (mvdsv)
# Server hostname displayed in server browser
{% if server_hostname %}hostname {{ server_hostname | e }}{% endif %}

# Server admin email / contact
{% if admin_email %}adminemail {{ admin_email | e }}{% endif %}

# QuakeWorld-compatible game directory
{% if basedir %}basedir {{ basedir | e }}{% endif %}

# Map rotation: first map on start
{% if start_map %}map {{ start_map | e }}{% endif %}

# Network settings
{% if port %}port {{ port }}{% endif %}
{% if hostport %}hostport {{ hostport }}{% endif %}
{% if hostname %}hostname {{ hostname | e }}{% endif %}
{% if maxclients %}maxclients {{ maxclients }}{% endif %}

# Server rules
{% if deathmatch %}deathmatch {{ deathmatch }}{% endif %}
{% if teamplay %}teamplay {{ teamplay }}{% endif %}
{% if fraglimit %}fraglimit {{ fraglimit }}{% endif %}
{% if timelimit %}timelimit {{ timelimit }}{% endif %}
{% if capturelimit %}capturelimit {{ capturelimit }}{% endif %}
{% if timelimit %}timelimit {{ timelimit }}{% endif %}
{% if pausetime %}pausetime {{ pausetime }}{% endif %}

# Network bandwidth and tuning
{% if net_ip %}net_ip {{ net_ip | e }}{% endif %}
{% if net_port %}net_port {{ net_port }}{% endif %}
{% if net_mtu %}net_mtu {{ net_mtu }}{% endif %}
{% if sv_maxrate %}sv_maxrate {{ sv_maxrate }}{% endif %}
{% if sv_minrate %}sv_minrate {{ sv_minrate }}{% endif %}
{% if sv_maxupdaterate %}sv_maxupdaterate {{ sv_maxupdaterate }}{% endif %}
{% if sv_minupdaterate %}sv_minupdaterate {{ sv_minupdaterate }}{% endif %}

# Demo recording
{% if record %}record {{ record | e }}{% endif %}

# Map list for rotation (cycling)
{% for m in map_list %}map {{ m | e }}{% endfor %}

# Player slot reservation
{% if reserved_slots %}reserved_slots {{ reserved_slots }}{% endif %}

# Spectator settings
{% if maxspectators %}maxspectators {{ maxspectators }}{% endif %}
{% if allow_spectators %}allow_spectators {{ allow_spectators }}{% endif %}

# Cheating protection
{% if allow_download %}allow_download {{ allow_download }}{% endif %}
{% if allow_upload %}allow_upload {{ allow_upload }}{% endif %}
{% if sv_cheats %}sv_cheats {{ sv_cheats }}{% endif %}

# Security & anti-spoof
{% if allow_unsecure_commands %}allow_unsecure_commands {{ allow_unsecure_commands }}{% endif %}

# Log settings
{% if logfile %}logfile {{ logfile | e }}{% endif %}

# Extra startup commands (e.g., load plugins)
{% for cmd in extra_startup_commands %}{{ cmd | e }}{% endfor %}

# Default MOTD
{% if motd_file %}motd_file {{ motd_file | e }}{% endif %}
{% for line in motd_lines %}motd {{ line | e }}{% endfor %}

# Server gravity (mvdsv-specific): physics gravity (0.0–1.0 typically)
{% if gravity %}gravity {{ gravity }}{% endif %}

# Server rate control for voice (mvdsv extension)
{% if sv_voiceenabled %}sv_voiceenabled {{ sv_voiceenabled }}{% endif %}
{% if sv_voicequality %}sv_voicequality {{ sv_voicequality }}{% endif %}
