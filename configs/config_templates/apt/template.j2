# APT log rotation configuration
# Managed by Ansible; do not edit manually.

# Number of rotated log files to keep.
/var/log/apt/term.log {
  rotate {{ rotate_count | default(12) }}
  monthly
  compress
  missingok
  notifempty
}

# Number of rotated log files to keep.
/var/log/apt/history.log {
  rotate {{ rotate_count | default(12) }}
  monthly
  compress
  missingok
  notifempty
}