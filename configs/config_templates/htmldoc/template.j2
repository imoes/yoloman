# /etc/default/htmldoc
# Default configuration for htmldoc command-line conversions.
# This file is managed by Ansible. Do not edit manually.

# Specifies the output format: html, ps, ps1, ps2, ps3, pdf, pdf11, pdf12, pdf13, pdf14, epub, htmlsep.
# Corresponds to: --format
OUTPUT_FORMAT="{{ htmldoc_output_format | default('pdf') }}"

# Specifies the input type: book (structured with headings) or webpage (unstructured).
# Corresponds to: --book or --webpage
INPUT_TYPE="{{ htmldoc_input_type | default('book') }}"

# Specifies the page size (e.g., a4, letter, legal) or dimensions.
# Corresponds to: --size
PAGE_SIZE="{{ htmldoc_page_size | default('a4') }}"

# Specifies the top margin in points.
# Corresponds to: --top
TOP_MARGIN="{{ htmldoc_top_margin | default(72) }}"

# Specifies the bottom margin in points.
# Corresponds to: --bottom
BOTTOM_MARGIN="{{ htmldoc_bottom_margin | default(72) }}"

# Specifies the left margin in points.
# Corresponds to: --left
LEFT_MARGIN="{{ htmldoc_left_margin | default(72) }}"

# Specifies the right margin in points.
# Corresponds to: --right
RIGHT_MARGIN="{{ htmldoc_right_margin | default(72) }}"

# Specifies the default font size for body text in points.
# Corresponds to: --fontsize
FONT_SIZE="{{ htmldoc_font_size | default(12) }}"

# Specifies the default typeface for body text: courier, helvetica, monospace, sans, serif, times.
# Corresponds to: --textfont
TEXT_FONT="{{ htmldoc_text_font | default('helvetica') }}"

# Specifies the typeface for headings.
# Corresponds to: --headingfont
HEADING_FONT="{{ htmldoc_heading_font | default('helvetica') }}"

# Sets the page header format string (fff notation). Leave empty to disable.
# Corresponds to: --header
HEADER_FORMAT="{{ htmldoc_header_format | default('') }}"

# Sets the page footer format string (fff notation). Leave empty to disable.
# Corresponds to: --footer
FOOTER_FORMAT="{{ htmldoc_footer_format | default('') }}"

# Specifies the output file path.
# Corresponds to: -f or --outfile
OUTPUT_FILE="{{ htmldoc_output_file | default('/tmp/output.pdf') }}"

# Specifies the input source file or directory.
# Corresponds to: positional argument
INPUT_SOURCE="{{ htmldoc_input_source | default('/var/www/html/index.html') }}"

# Enables encryption of PDF files when set to true.
# Corresponds to: --encryption
ENCRYPT_PDF="{{ htmldoc_encrypt_pdf | default(false) | lower }}"

# Specifies the user password for encrypted PDF files. Leave empty for none.
# Corresponds to: --user-password
PDF_USER_PASSWORD="{{ htmldoc_pdf_user_password | default('') }}"

# Specifies the owner password for encrypted PDF files. Leave empty for none.
# Corresponds to: --owner-password
PDF_OWNER_PASSWORD="{{ htmldoc_pdf_owner_password | default('') }}"

# Specifies document permissions for encrypted PDF files (e.g., all, none, print, no-copy).
# Corresponds to: --permissions
PDF_PERMISSIONS="{{ htmldoc_pdf_permissions | default('all') }}"

# Embeds fonts in PDF and PostScript output when set to true.
# Corresponds to: --embedfonts
EMBED_FONTS="{{ htmldoc_embed_fonts | default(true) | lower }}"

# Enables generation of table of contents when set to true.
# Corresponds to: --toc
TOC_ENABLED="{{ htmldoc_toc_enabled | default(true) | lower }}"

# Specifies the number of levels in the table of contents.
# Corresponds to: --toclevels
TOC_LEVELS="{{ htmldoc_toc_levels | default(2) }}"

# Sets the title for the table of contents.
# Corresponds to: --toctitle
TOC_TITLE="{{ htmldoc_toc_title | default('Contents') }}"

# Enables generation of a title page when set to true.
# Corresponds to: --title
TITLE_PAGE_ENABLED="{{ htmldoc_title_page_enabled | default(false) | lower }}"

# Specifies the character set for output (e.g., utf-8, iso-8859-1).
# Corresponds to: --charset
CHARSET="{{ htmldoc_charset | default('utf-8') }}"

# Enables verbose messages when set to true.
# Corresponds to: --verbose
VERBOSE="{{ htmldoc_verbose | default(false) | lower }}"

# Suppresses all messages when set to true (overrides verbose).
# Corresponds to: --quiet
QUIET="{{ htmldoc_quiet | default(false) | lower }}"

# Specifies the data directory for fonts and support files.
# Corresponds to: --datadir
DATA_DIR="{{ htmldoc_data_dir | default('/usr/share/htmldoc') }}"

# Specifies the search path for input files. Leave empty to use default.
# Corresponds to: --path
SEARCH_PATH="{{ htmldoc_search_path | default('') }}"

# Enables generation of links in PDF files when set to true.
# Corresponds to: --links
LINKS_ENABLED="{{ htmldoc_links_enabled | default(true) | lower }}"

# Disables generation of links in PDF files (if false, this takes precedence if set explicitly in a way that overrides, but here we use explicit bools)
# Corresponds to: --no-links (linked to LINKS_ENABLED)