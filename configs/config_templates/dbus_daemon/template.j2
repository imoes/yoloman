# D-Bus system bus configuration
# Loaded by dbus-daemon on startup. See dbus-daemon(1) for details.
#
# This template is self-documenting. All variables use Jinja2 defaults
# derived from the schema to prevent render failures when variables are
# undefined. Comments above each directive reflect the schema description.

# Allow root to connect (usually needed for system services)
<policy user="root">
  <allow own="*"/>
  <allow send_destination="*"/>
  <allow receive_sender="*"/>
</policy>

# Permit authenticated system services to connect and send/receive messages
<policy context="default">
  <allow send_destination="*"/>
  <allow receive_sender="*"/>
</policy>

# Max connections per user: Maximum number of simultaneous connections allowed per user.
# Higher values support more clients but increase resource usage.
<limit name="max_connections_per_user">{{ (max_connections_per_user | default(256)) }}</limit>

# Max pending activations: Maximum number of pending service activation requests per user.
# Controls concurrency of auto-started services.
<limit name="max_pending_service_activations">{{ (max_pending_activations | default(256)) }}</limit>

# Max services per user: Maximum number of uniquely named services a single user may own on the bus.
<limit name="max_services_per_user">{{ (max_services_per_user | default(128)) }}</limit>

# Max replies per connection: Maximum number of pending method call replies per connection.
# Prevents unbounded memory growth from slow clients.
<limit name="max_replies_per_connection">{{ (max_replies_per_connection | default(512)) }}</limit>

# Max match rules per connection: Maximum number of match rules (for signal filtering) per connection.
<limit name="max_match_rules_per_connection">{{ (max_match_rules_per_connection | default(256)) }}</limit>

# Max matches per rule: Maximum number of signal matches per rule.
# Prevents overly complex signal filters.
<limit name="max_matches_per_rule">{{ (max_matches_per_rule | default(1024)) }}</limit>

# Audit logging: If true, enable D-Bus audit logging via the audit subsystem (e.g., syslog with audit tags).
{% if (enable_audit | default(false) | bool) %}
<audit type="enabled"/>
{% endif %}

# Socket path: Unix filesystem path where the system bus listener socket will be bound.
<listen>unix:path={{ (socket_path | default('/var/run/dbus/system_bus_socket')) }}</listen>

# Enable systemd: If true, integrate with systemd for privileged service activation (required on most modern Linux systems).
{% if (enable_systemd | default(true) | bool) %}
<servicehelper>/usr/lib/dbus-1.0/dbus-daemon-launch-helper</servicehelper>
{% endif %}