{
  "error_reporting": 0,
  "display_errors": false,
  "db_type": "mysql",
  "db_host": "db.internal.example.com",
  "db_name": "mediawiki_prod",
  "db_user": "wikiadmin",
  "db_password": "REDACTED_SECURE_PASSWORD",
  "db_prefix": "mw_",
