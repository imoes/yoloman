{
  "error_reporting": {
    "type": "number",
    "default": 0,
    "description": "PHP error reporting level (e.g., E_ALL for development, 0 for production)"
  },
  "display_errors": {
    "type": "boolean",
    "default": false,
    "description": "Whether to display errors in the browser (set to false in production)"
  },
  "db_type": {
    "type": "string",
    "default": "mysql",
    "description": "Database type (e.g., 'mysql', 'postgres')"
  },
  "db_host": {
    "type": "string",
    "default": "localhost",
    "description": "Database server hostname or IP address"
  },
  "db_name": {
    "type": "string",
    "default": "mediawiki",
    "description": "Name of the MediaWiki database"
  },
  "db_user": {
    "type": "string",
    "default": "wikiuser",
    "description": "Database username"
  },
  "db_password": {
    "type": "string",
    "default": "",
    "description": "Database user password"
  },
  "db_prefix": {
    "type": "string",
    "default": "",
    "description": "Database table prefix (optional)"
  },
  "db_charset": {
    "type": "boolean",
    "default": false,
    "description": "Whether to use a custom character set"
  },
  "site_name": {
    "type": "string",
    "default": "MyWiki",
    "description": "Name of your wiki site"
  },
  "meta_namespace": {
    "type": "string",
    "default": "Project",
    "description": "Namespace prefix for project pages (e.g., 'Project')"
  },
  "script_path": {
    "type": "string",
    "default": "/w",
    "description": "Web-accessible path to MediaWiki scripts"
  },
  "article_path": {
    "type": "string",
    "default": "/wiki/$1",
    "description": "URL pattern for articles (must contain $1)"
  },
  "style_path": {
    "type": "string",
    "default": "/w/skins",
    "description": "Web path to skins directory"
  },
  "server_url": {
    "type": "string",
    "default": "https://wiki.example.com",
    "description": "Full base URL of the wiki (e.g., https://wiki.example.com)"
  },
  "upload_path": {
    "type": "string",
    "default": "/w/images",
    "description": "Web-accessible upload URL path"
  },
  "upload_directory": {
    "type": "string",
    "default": "/var/lib/mediawiki/images",
    "description": "Absolute filesystem path for uploaded files"
  },
  "upload_disabled": {
    "type": "boolean",
    "default": false,
    "description": "Disable user file uploads"
  },
  "allowed_upload_extensions": {
    "type": "list",
    "default": [
      "jpg",
      "jpeg",
      "png",
      "gif",
      "pdf",
      "svg"
    ],
    "description": "List of allowed file extensions for uploads"
  },
  "default_skin": {
    "type": "string",
    "default": "vector",
    "description": "Default user interface skin"
  },
  "auth_type": {
    "type": "string",
    "default": "local",
    "description": "Authentication backend: 'local' (internal) or 'ldap' (via extension)"
  },
  "cache_directory": {
    "type": "string",
    "default": "/var/cache/mediawiki",
    "description": "Directory for file-based caching (must be writable by web server)"
  },
  "main_cache_type": {
    "type": "string",
    "default": "CACHE_ACCEL",
    "description": "Main object cache (e.g., 'CACHE_ACCEL', 'CACHE_DB', 'CACHE_NONE')"
  },
  "memcached_servers": {
    "type": "list",
    "default": [],
    "description": "List of Memcached server configurations (host, port)",
    "items": {
      "type": "object",
      "fields": {
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Memcached server hostname or IP"
        },
        "port": {
          "type": "number",
          "default": 11211,
          "description": "Memcached server port"
        }
      }
    }
  },
  "log_directory": {
    "type": "string",
    "default": "/var/log/mediawiki",
    "description": "Directory for debug logs (optional)"
  },
  "log_file_prefix": {
    "type": "string",
    "default": "debug",
    "description": "Prefix for debug log filenames"
  },
  "log_queries": {
    "type": "boolean",
    "default": false,
    "description": "Log SQL queries to debug log"
  },
  "language_code": {
    "type": "string",
    "default": "en",
    "description": "Default interface language code (ISO 639-1)"
  },
  "default_language_variant": {
    "type": "string",
    "default": "",
    "description": "Default variant for language-specific content (e.g., 'zh-hant')"
  },
  "timezone": {
    "type": "string",
    "default": "UTC",
    "description": "PHP timezone identifier (e.g., 'America/New_York')"
  },
  "enable_maintenance_script": {
    "type": "boolean",
    "default": false,
    "description": "Allow direct execution of maintenance scripts via web interface (security-sensitive)"
  },
  "extensions": {
    "type": "object",
    "default": {},
    "description": "Map of extension names to configuration objects",
    "items": {
      "type": "object",
      "fields": {
        "path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to extension file (if not using wfLoadExtension)"
        },
        "options": {
          "type": "object",
          "default": {},
          "description": "Extension-specific configuration key-value pairs"
        }
      }
    }
  },
  "secret_key": {
    "type": "string",
    "default": "",
    "description": "Cryptographically random 20+ character secret for session/cookie integrity"
  },
  "upgrade_key": {
    "type": "string",
    "default": "",
    "description": "Secret key used to protect upgrade functionality"
  }
}
