{# ============================================================================ #}
{# MediaWiki LocalSettings.php Configuration Template                           #}
{# Generated by Ansible. Do not edit directly; update via configuration management. #}
{# Self-documenting: every variable is annotated and defaulted to prevent render #}
{# failures when optional fields are omitted.                                     #}
{# ============================================================================ #}

<?php
/**
 * MediaWiki configuration file.
 * Generated from template. Do not edit directly; update via configuration management.
 */

{# -------------------------------------------------------------------------- #}
{# PHP Runtime Error Handling                                                 #}
{# error_reporting: PHP error reporting level (e.g., E_ALL for development, 0 for production) #}
{# display_errors: Whether to display errors in the browser (set to false in production) #}
{# -------------------------------------------------------------------------- #}
error_reporting({{ error_reporting | default(0) }});
ini_set('display_errors', {{ display_errors | default(False) | lower }});

{# -------------------------------------------------------------------------- #}
{# Database Configuration                                                     #}
{# db_type: Database type (e.g., 'mysql', 'postgres') #}
{# db_host: Database server hostname or IP address #}
{# db_name: Name of the MediaWiki database #}
{# db_user: Database username #}
{# db_password: Database user password #}
{# db_prefix: Database table prefix (optional) #}
{# db_charset: Whether to use a custom character set #}
{# -------------------------------------------------------------------------- #}
$wgDBtype = "{{ db_type | default('mysql') }}";
$wgDBserver = "{{ db_host | default('localhost') }}";
$wgDBname = "{{ db_name | default('mediawiki') }}";
$wgDBuser = "{{ db_user | default('wikiuser') }}";
$wgDBpassword = "{{ db_password | default('') }}";
{% if db_charset | default(False) %}
$wgDBprefix = "{{ db_prefix | default('') }}";
{% endif %}

{# -------------------------------------------------------------------------- #}
{# Site Identity                                                              #}
{# site_name: Name of your wiki site #}
{# meta_namespace: Namespace prefix for project pages (e.g., 'Project') #}
{# -------------------------------------------------------------------------- #}
$wgSitename = "{{ site_name | default('MyWiki') }}";
$wgMetaNamespace = "{{ meta_namespace | default('Project') }}";

{# -------------------------------------------------------------------------- #}
{# URL Configuration                                                            #}
{# script_path: Web-accessible path to MediaWiki scripts #}
{# article_path: URL pattern for articles (must contain $1) #}
{# style_path: Web path to skins directory #}
{# server_url: Full base URL of the wiki (e.g., https://wiki.example.com) #}
{# -------------------------------------------------------------------------- #}
$wgScriptPath = "{{ script_path | default('/w') }}";
$wgScriptExtension = ".php";
$wgArticlePath = "{{ article_path | default('/wiki/$1') }}";
$wgStylePath = "{{ style_path | default('/w/skins') }}";
$wgServer = "{{ server_url | default('https://wiki.example.com') }}";

{# -------------------------------------------------------------------------- #}
{# Upload Configuration                                                       #}
{# upload_path: Web-accessible upload URL path #}
{# upload_directory: Absolute filesystem path for uploaded files #}
{# upload_disabled: Disable user file uploads #}
{# allowed_upload_extensions: List of allowed file extensions for uploads #}
{# -------------------------------------------------------------------------- #}
$wgUploadPath = "{{ upload_path | default('/w/images') }}";
$wgUploadDirectory = "{{ upload_directory | default('/var/lib/mediawiki/images') }}";
{% if upload_disabled | default(False) %}
$wgEnableUploads = false;
{% else %}
$wgEnableUploads = true;
{% endif %}

{# Loop over allowed extensions to generate comments only (as in original) #}
{% for ext in allowed_upload_extensions | default(['jpg', 'jpeg', 'png', 'gif', 'pdf', 'svg']) %}
/**
 * Allow upload extension: {{ ext }}
 */
{% endfor %}

{# -------------------------------------------------------------------------- #}
{# Skin Configuration                                                         #}
{# default_skin: Default user interface skin #}
{# -------------------------------------------------------------------------- #}
$wgDefaultSkin = "{{ default_skin | default('vector') }}";

{# -------------------------------------------------------------------------- #}
{# Authentication & Security                                                  #}
{# auth_type: Authentication backend: 'local' (internal) or 'ldap' (via extension) #}
{# -------------------------------------------------------------------------- #}
{% if auth_type | default('local') == "local" %}
$wgGroupPermissions['*']['createaccount'] = true;
$wgGroupPermissions['*']['read'] = true;
{% elif auth_type | default('local') == "ldap" %}
require_once "$IP/extensions/LdapAuthentication/LdapAuthentication.php";
$wgAuth = new LdapAuthenticationPlugin();
{% endif %}

{# -------------------------------------------------------------------------- #}
{# Cache Configuration                                                        #}
{# cache_directory: Directory for file-based caching (must be writable by web server) #}
{# main_cache_type: Main object cache (e.g., 'CACHE_ACCEL', 'CACHE_DB', 'CACHE_NONE') #}
{# memcached_servers: List of Memcached server configurations (host, port) #}
{# -------------------------------------------------------------------------- #}
$wgCacheDirectory = "{{ cache_directory | default('/var/cache/mediawiki') }}";
$wgMainCacheType = CACHE_{{ main_cache_type | default('CACHE_ACCEL') | upper }};

{% if memcached_servers | default([]) %}
$wgMemCachedServers = [
{% for server in memcached_servers | default([]) %}    "{{ server.host }}:{{ server.port }}"{% if not loop.last %},{% endif %}
{% endfor %}];
{% endif %}

{# -------------------------------------------------------------------------- #}
{# Logging Configuration                                                      #}
{# log_directory: Directory for debug logs (optional) #}
{# log_file_prefix: Prefix for debug log filenames #}
{# log_queries: Log SQL queries to debug log #}
{# -------------------------------------------------------------------------- #}
{% if log_directory | default('/var/log/mediawiki') %}
$wgDebugLogFilePath = "{{ log_directory | default('/var/log/mediawiki') }}/{{ log_file_prefix | default('debug') }}.log";
{% endif %}
$wgLogQueries = {{ log_queries | default(False) | lower }};

{# -------------------------------------------------------------------------- #}
{# Language & Locale                                                          #}
{# language_code: Default interface language code (ISO 639-1) #}
{# default_language_variant: Default variant for language-specific content (e.g., 'zh-hant') #}
{# -------------------------------------------------------------------------- #}
$wgLanguageCode = "{{ language_code | default('en') }}";
$wgDefaultLanguageVariant = "{{ default_language_variant | default('') }}";

{# -------------------------------------------------------------------------- #}
{# Timezone                                                                   #}
{# timezone: PHP timezone identifier (e.g., 'America/New_York') #}
{# -------------------------------------------------------------------------- #}
date_default_timezone_set("{{ timezone | default('UTC') }}");

{# -------------------------------------------------------------------------- #}
{# Maintenance Script Protection                                              #}
{# enable_maintenance_script: Allow direct execution of maintenance scripts via web interface (security-sensitive) #}
{# -------------------------------------------------------------------------- #}
$wgEnableMaintenanceScript = {{ enable_maintenance_script | default(False) | lower }};

{# -------------------------------------------------------------------------- #}
{# Extensions                                                                 #}
{# extensions: Map of extension names to configuration objects #}
{# -------------------------------------------------------------------------- #}
{% for ext_name, ext_config in (extensions | default({})) | dict2items %}
/**
 * Load extension: {{ ext_name }}
 */
{% if ext_config.value.path is defined and ext_config.value.path %}
require_once "{{ ext_config.value.path }}";
{% else %}
wfLoadExtension("{{ ext_name }}");
{% endif %}

{% if ext_config.value.options is mapping and ext_config.value.options %}
{% for opt_key, opt_val in ext_config.value.options | dict2items %}
$wg{{ ext_name | replace("-", "") | replace("_", "") }}{{ opt_key.value | replace("_", "") | replace("-", "") }} = {{ opt_val.value | tojson }};
{% endfor %}
{% endif %}
{% endfor %}

{# -------------------------------------------------------------------------- #}
{# Final Security Settings                                                    #}
{# secret_key: Cryptographically random 20+ character secret for session/cookie integrity #}
{# upgrade_key: Secret key used to protect upgrade functionality #}
{# -------------------------------------------------------------------------- #}
$wgSecretKey = "{{ secret_key | default('') }}";
$wgUpgradeKey = "{{ upgrade_key | default('') }}";