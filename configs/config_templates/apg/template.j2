# APG (Automated Password Generator) configuration file
# This file sets the default command-line arguments for the `apg` utility.
# Each APG_PARM line defines a password generation profile.

# Profile: Pronounceable passwords with special characters
# - Uses /dev/urandom for entropy
# - Length between apg_min_length and apg_max_length
# - Character classes: Special, Numeric, Consonant, Vowel
# - The -t flag enables testing/validation mode
APG_PARM="-c /dev/urandom -m {{ apg_min_length | default(8) }} -x {{ apg_max_length | default(14) }} -M {{ apg_char_classes | default('SNCL') }} -t"