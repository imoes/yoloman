# DavMail settings, see http://davmail.sourceforge.net/ for documentation

#############################################################
# Basic settings

# Server or workstation mode
davmail.server=true
# Exchange/Office 365 connection mode:
# - O365Modern Office 365 modern authentication (Oauth2)
# - O365Interactive Office 365 with interactive browser window, not available in headless mode (OpenJFX required)
# - O365Manual Office 365 with interactive dialog, not available in headless mode
# - O365 Office 365 EWS mode
# - EWS Exchange 2007 and later
# - WebDav Exchange 2007 and earliear WebDav mode
# - Auto WebDav mode with EWS failover
davmail.mode={{ davmail_mode }}
# base Exchange OWA or EWS url
davmail.url={{ davmail_url }}

# Listener ports
davmail.caldavPort={{ davmail_caldav_port }}
davmail.imapPort={{ davmail_imap_port }}
davmail.ldapPort={{ davmail_ldap_port }}
davmail.popPort={{ davmail_pop_port }}
davmail.smtpPort={{ davmail_smtp_port }}

#############################################################
# Network settings

# Network proxy settings
davmail.enableProxy={{ davmail_enable_proxy }}
davmail.useSystemProxies={{ davmail_use_system_proxies }}
davmail.proxyHost={{ davmail_proxy_host }}
davmail.proxyPort={{ davmail_proxy_port }}
davmail.proxyUser={{ davmail_proxy_user }}
davmail.proxyPassword={{ davmail_proxy_password }}

# proxy exclude list
davmail.noProxyFor={{ davmail_no_proxy_for }}

# allow remote connection to DavMail
davmail.allowRemote={{ davmail_allow_remote }}
# bind server sockets to a specific address
davmail.bindAddress={{ davmail_bind_address }}
# client connection timeout in seconds - default 300, 0 to disable
davmail.clientSoTimeout={{ davmail_client_so_timeout }}

# DavMail listeners SSL configuration
# systemd startup script expects keyStoreFile at /etc/davmail/keystoreFile
# (which can be a symlink).
#davmail.ssl.keystoreType=
#davmail.ssl.keystoreFile=/etc/davmail/keystoreFile
#davmail.ssl.keystorePass=
#davmail.ssl.keyPass=

# Accept specified certificate even if invalid according to trust store
davmail.server.certificate.hash={{ davmail_server_certificate_hash }}

# disable SSL for specified listeners
davmail.ssl.nosecurecaldav={{ davmail_ssl_nosecurecaldav }}
davmail.ssl.nosecureimap={{ davmail_ssl_nosecureimap }}
davmail.ssl.nosecureldap={{ davmail_ssl_nosecureldap }}
davmail.ssl.nosecurepop={{ davmail_ssl_nosecurepop }}
davmail.ssl.nosecuresmtp={{ davmail_ssl_nosecuresmtp }}

davmail.oauth.tokenFilePath={{ davmail_oauth_token_file_path }}

# disable update check
davmail.disableUpdateCheck={{ davmail_disable_update_check }}

# Send keepalive character during large folder and messages download
davmail.enableKeepAlive={{ davmail_enable_keepalive }}
# Message count limit on folder retrieval
davmail.folderSizeLimit={{ davmail_folder_size_limit }}
# Default windows domain for NTLM and basic authentication
davmail.defaultDomain={{ davmail_default_domain }}

#############################################################
# Caldav settings

# override default alarm sound
davmail.caldavAlarmSound={{ davmail_caldav_alarm_sound }}
# retrieve calendar events not older than 90 days
davmail.caldavPastDelay={{ davmail_caldav_past_delay }}
# EWS only: enable server managed meeting notifications
davmail.caldavAutoSchedule={{ davmail_caldav_auto_schedule }}
# WebDav only: force event update to trigger ActiveSync clients update
davmail.forceActiveSyncUpdate={{ davmail_force_active_sync_update }}

#############################################################
# IMAP settings

# Delete messages immediately on IMAP STORE \Deleted flag
davmail.imapAutoExpunge={{ davmail_imap_auto_expunge }}
# Enable IDLE support, set polling delay in minutes
davmail.imapIdleDelay={{ davmail_imap_idle_delay }}
# Always reply to IMAP RFC822.SIZE requests with Exchange approximate message size for performance reasons
davmail.imapAlwaysApproxMsgSize={{ davmail_imap_always_approx_msg_size }}

#############################################################
# POP settings

# Delete messages on server after 30 days
davmail.keepDelay={{ davmail_keep_delay }}
# Delete messages in server sent folder after 90 days
davmail.sentKeepDelay={{ davmail_sent_keep_delay }}
# Mark retrieved messages read on server
davmail.popMarkReadOnRetr={{ davmail_pop_mark_read_on_retr }}

#############################################################
# SMTP settings

# let Exchange save a copy of sent messages in Sent folder
davmail.smtpSaveInSent={{ davmail_smtp_save_in_sent }}

#############################################################
# Loggings settings

# log file path, leave empty for default path
davmail.logFilePath={{ davmail_log_file_path }}
# maximum log file size, use Log4J syntax, set to 0 to use an external rotation mechanism, e.g. logrotate
davmail.logFileSize={{ davmail_log_file_size }}
# log levels
log4j.logger.davmail={{ log4j_logger_davmail }}
log4j.logger.httpclient.wire={{ log4j_logger_httpclient_wire }}
log4j.logger.org.apache.commons.httpclient={{ log4j_logger_org_apache_commons_httpclient }}
log4j.rootLogger={{ log4j_root_logger }}
