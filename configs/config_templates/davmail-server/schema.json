{
  "davmail_mode": {
    "type": "string",
    "default": "EWS",
    "description": "Exchange/Office 365 connection mode (e.g., EWS, O365, WebDav)"
  },
  "davmail_url": {
    "type": "string",
    "default": "https://outlook.office365.com/EWS/Exchange.asmx",
    "description": "Base Exchange OWA or EWS URL"
  },
  "davmail_caldav_port": {
    "type": "number",
    "default": 1080,
    "description": "Port for CalDAV listener"
  },
  "davmail_imap_port": {
    "type": "number",
    "default": 1143,
    "description": "Port for IMAP listener"
  },
  "davmail_ldap_port": {
    "type": "number",
    "default": 1389,
    "description": "Port for LDAP listener"
  },
  "davmail_pop_port": {
    "type": "number",
    "default": 1110,
    "description": "Port for POP listener"
  },
  "davmail_smtp_port": {
    "type": "number",
    "default": 1025,
    "description": "Port for SMTP listener"
  },
  "davmail_enable_proxy": {
    "type": "bool",
    "default": false,
    "description": "Enable network proxy"
  },
  "davmail_use_system_proxies": {
    "type": "bool",
    "default": false,
    "description": "Use system proxies"
  },
  "davmail_proxy_host": {
    "type": "string",
    "default": "",
    "description": "Proxy host address"
  },
  "davmail_proxy_port": {
    "type": "string",
    "default": "",
    "description": "Proxy port"
  },
  "davmail_proxy_user": {
    "type": "string",
    "default": "",
    "description": "Proxy username"
  },
  "davmail_proxy_password": {
    "type": "string",
    "default": "",
    "description": "Proxy password"
  },
  "davmail_no_proxy_for": {
    "type": "string",
    "default": "",
    "description": "Proxy exclude list"
  },
  "davmail_allow_remote": {
    "type": "bool",
    "default": true,
    "description": "Allow remote connection to DavMail"
  },
  "davmail_bind_address": {
    "type": "string",
    "default": "",
    "description": "Bind server sockets to a specific address"
  },
  "davmail_client_so_timeout": {
    "type": "string",
    "default": "",
    "description": "Client connection timeout in seconds (empty for default 300)"
  },
  "davmail_server_certificate_hash": {
    "type": "string",
    "default": "",
    "description": "Certificate hash to accept even if invalid"
  },
  "davmail_ssl_nosecurecaldav": {
    "type": "bool",
    "default": false,
    "description": "Disable SSL for CalDAV listener"
  },
  "davmail_ssl_nosecureimap": {
    "type": "bool",
    "default": false,
    "description": "Disable SSL for IMAP listener"
  },
  "davmail_ssl_nosecureldap": {
    "type": "bool",
    "default": false,
    "description": "Disable SSL for LDAP listener"
  },
  "davmail_ssl_nosecurepop": {
    "type": "bool",
    "default": false,
    "description": "Disable SSL for POP listener"
  },
  "davmail_ssl_nosecuresmtp": {
    "type": "bool",
    "default": false,
    "description": "Disable SSL for SMTP listener"
  },
  "davmail_oauth_token_file_path": {
    "type": "string",
    "default": "/var/lib/davmail/tokens.properties",
    "description": "Path to OAuth token file"
  },
  "davmail_disable_update_check": {
    "type": "bool",
    "default": true,
    "description": "Disable update check"
  },
  "davmail_enable_keepalive": {
    "type": "bool",
    "default": true,
    "description": "Send keepalive character during large downloads"
  },
  "davmail_folder_size_limit": {
    "type": "number",
    "default": 0,
    "description": "Message count limit on folder retrieval"
  },
  "davmail_default_domain": {
    "type": "string",
    "default": "",
    "description": "Default windows domain for NTLM and basic authentication"
  },
  "davmail_caldav_alarm_sound": {
    "type": "string",
    "default": "",
    "description": "Override default alarm sound path"
  },
  "davmail_caldav_past_delay": {
    "type": "number",
    "default": 90,
    "description": "Retrieve calendar events not older than this many days"
  },
  "davmail_caldav_auto_schedule": {
    "type": "bool",
    "default": true,
    "description": "Enable server managed meeting notifications (EWS only)"
  },
  "davmail_force_active_sync_update": {
    "type": "bool",
    "default": false,
    "description": "Force event update to trigger ActiveSync clients update (WebDav only)"
  },
  "davmail_imap_auto_expunge": {
    "type": "bool",
    "default": true,
    "description": "Delete messages immediately on IMAP STORE \\Deleted flag"
  },
  "davmail_imap_idle_delay": {
    "type": "string",
    "default": "",
    "description": "IMAP IDLE polling delay in minutes (empty to disable)"
  },
  "davmail_imap_always_approx_msg_size": {
    "type": "string",
    "default": "",
    "description": "Always reply to IMAP RFC822.SIZE with Exchange approximate size"
  },
  "davmail_keep_delay": {
    "type": "number",
    "default": 30,
    "description": "Delete messages on server after this many days"
  },
  "davmail_sent_keep_delay": {
    "type": "number",
    "default": 90,
    "description": "Delete messages in server sent folder after this many days"
  },
  "davmail_pop_mark_read_on_retr": {
    "type": "bool",
    "default": false,
    "description": "Mark retrieved messages read on server"
  },
  "davmail_smtp_save_in_sent": {
    "type": "bool",
    "default": true,
    "description": "Let Exchange save a copy of sent messages in Sent folder"
  },
  "davmail_log_file_path": {
    "type": "string",
    "default": "/var/log/davmail/davmail.log",
    "description": "Log file path"
  },
  "davmail_log_file_size": {
    "type": "string",
    "default": "1MB",
    "description": "Maximum log file size (Log4J syntax)"
  },
  "log4j_logger_davmail": {
    "type": "string",
    "default": "WARN",
    "description": "Log level for davmail logger"
  },
  "log4j_logger_httpclient_wire": {
    "type": "string",
    "default": "WARN",
    "description": "Log level for httpclient wire logger"
  },
  "log4j_logger_org_apache_commons_httpclient": {
    "type": "string",
    "default": "WARN",
    "description": "Log level for org.apache.commons.httpclient logger"
  },
  "log4j_root_logger": {
    "type": "string",
    "default": "WARN",
    "description": "Root logger level"
  }
}
