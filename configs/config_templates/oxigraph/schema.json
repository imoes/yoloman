{
  "server.address": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address the server listens on (e.g., '0.0.0.0' for all interfaces)"
  },
  "server.port": {
    "type": "number",
    "default": 7878,
    "description": "Port number for the HTTP server"
  },
  "server.workers": {
    "type": "number",
    "default": 0,
    "description": "Number of worker threads (0 = auto-detect based on CPU cores)"
  },
  "server.max_connections_per_endpoint": {
    "type": "number",
    "default": 100,
    "description": "Maximum number of concurrent HTTP connections per endpoint"
  },
  "server.enable_cors": {
    "type": "bool",
    "default": false,
    "description": "Enable CORS headers in HTTP responses"
  },
  "server.cors_origins": {
    "type": "list",
    "default": [],
    "description": "List of allowed CORS origins (leave empty to allow all origins)",
    "items": {
      "type": "string"
    }
  },
  "server.enable_rest": {
    "type": "bool",
    "default": true,
    "description": "Enable the /rest REST API endpoint"
  },
  "storage.path": {
    "type": "string",
    "default": "/var/lib/oxigraph/data",
    "description": "Path to the directory for storing RDF data persistently"
  },
  "auth.enabled": {
    "type": "bool",
    "default": false,
    "description": "Enable authentication for the server"
  },
  "auth.type": {
    "type": "string",
    "default": "basic",
    "description": "Authentication mechanism: 'basic' or 'token'",
    "enum": [
      "basic",
      "token"
    ]
  },
  "auth.users": {
    "type": "list",
    "default": [],
    "description": "List of basic auth users (password_hash should be SHA-256 or BCrypt hash)",
    "items": {
      "name": {
        "type": "string",
        "description": "Username"
      },
      "password_hash": {
        "type": "string",
        "description": "Password hash (e.g., SHA-256 or BCrypt)"
      }
    }
  },
  "auth.tokens": {
    "type": "list",
    "default": [],
    "description": "List of token-authenticated service accounts",
    "items": {
      "name": {
        "type": "string",
        "description": "Token name/identifier"
      },
      "secret": {
        "type": "string",
        "description": "Secret token value"
      }
    }
  },
  "logging.level": {
    "type": "string",
    "default": "info",
    "description": "Logging verbosity level (error, warn, info, debug, trace)",
    "enum": [
      "error",
      "info"
    ]
  },
  "logging.format": {
    "type": "string",
    "default": "pretty",
    "description": "Log format: 'pretty' (human-readable) or 'json' (machine-readable)",
    "enum": [
      "pretty",
      "json"
    ]
  },
  "compression.enabled": {
    "type": "bool",
    "default": true,
    "description": "Enable HTTP response compression (gzip/br)"
  },
  "sparql.max_query_time_ms": {
    "type": "number",
    "default": 60000,
    "description": "Maximum SPARQL query execution time (ms)"
  },
  "sparql.max_update_time_ms": {
    "type": "number",
    "default": 120000,
    "description": "Maximum SPARQL UPDATE execution time (ms)"
  },
  "sparql.max_triples_result": {
    "type": "number",
    "default": 1000000,
    "description": "Maximum number of triples allowed in query result"
  }
}
