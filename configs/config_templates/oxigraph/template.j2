# Oxigraph RDF Database Configuration
# Generated by Ansible Jinja2 Template - Self-Documenting
#
# This configuration file controls the Oxigraph HTTP server, which serves as a
# SPARQL endpoint and RDF data store.
#
# Sections:
#   [Global] - Network and general server settings
#   [Auth]   - Authentication and authorization (optional)
#   [Logging]- Logging verbosity and format
#   [Compression] - HTTP response compression
#   [Sparql] - SPARQL query execution limits

# ============================================================================
# GLOBAL SERVER SETTINGS
# ============================================================================

# Address the server binds to for incoming connections.
# Set to '0.0.0.1' to accept connections from any interface, or '127.0.0.1'
# for localhost-only access.
# Schema: server.address
address = "{{ (server | default({})).address | default('127.0.0.1') }}"

# TCP port number the HTTP server listens on.
# Schema: server.port
port = {{ (server | default({})).port | default(7878) }}

# Path to the directory where Oxigraph stores RDF data persistently.
# Ensure this path exists and is writable by the service account.
# Schema: storage.path
storage_path = "{{ (storage | default({})).path | default('/var/lib/oxigraph/data') }}"

# Number of worker threads for handling requests.
# Set to 0 to let Oxigraph automatically detect the number of CPU cores.
# Schema: server.workers
workers = {{ (server | default({})).workers | default(0) }}

# Maximum number of concurrent HTTP connections allowed per endpoint.
# Schema: server.max_connections_per_endpoint
max_connections_per_endpoint = {{ (server | default({})).max_connections_per_endpoint | default(100) }}

# Enable or disable CORS (Cross-Origin Resource Sharing) headers.
# Schema: server.enable_cors
enable_cors = {{ (server | default({})).enable_cors | default(false) | lower }}

# List of allowed origins for CORS requests.
# If empty, all origins are allowed (provided enable_cors is true).
# Schema: server.cors_origins
# The original template failed because it accessed `cors_origins` directly without
# ensuring the parent `server` dict was present. We now default the parent map first.
{% set _cors_origins = (server | default({})).cors_origins | default([]) %}
{% if _cors_origins | length > 0 %}
cors_origins = [
{% for origin in _cors_origins %}  "{{ origin }}"{% if not loop.last %},{% endif %}
{% endfor %}]
{% else %}
cors_origins = []
{% endif %}

# Enable or disable the /rest REST API endpoint.
# Schema: server.enable_rest
enable_rest = {{ (server | default({})).enable_rest | default(true) | lower }}

# ============================================================================
# AUTHENTICATION CONFIGURATION (Optional)
# ============================================================================

{% set _auth_enabled = (auth | default({})).enabled | default(false) %}
{% if _auth_enabled %}
[auth]
# Enable authentication mechanism.
enabled = true

# Type of authentication: 'basic' (username/password) or 'token' (API keys).
# Schema: auth.type
{% set _auth_type = (auth | default({})).type | default('basic') %}
{% if _auth_type == "basic" %}
type = "basic"

# List of basic auth users.
# Schema: auth.users (List of objects with 'name' and 'password_hash')
{% for user in (auth | default({})).users | default([]) %}users."{{ user.name }}" = "{{ user.password_hash }}"
{% endfor %}
{% elif _auth_type == "token" %}
type = "token"

# List of token-authenticated service accounts.
# Schema: auth.tokens (List of objects with 'name' and 'secret')
{% for token in (auth | default({})).tokens | default([]) %}tokens."{{ token.name }}" = "{{ token.secret }}"
{% endfor %}
{% endif %}

{% else %}
[auth]
# Authentication is disabled.
enabled = false
{% endif %}

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

[logging]
# Logging verbosity level. Options: error, warn, info, debug, trace.
# Schema: logging.level
level = "{{ (logging | default({})).level | default('info') }}"

# Log output format. Options: 'pretty' (human-readable) or 'json' (machine-readable).
# Schema: logging.format
{% set _log_fmt = (logging | default({})).format | default('pretty') %}
{% if _log_fmt == "json" %}
format = "json"
{% else %}
format = "pretty"
{% endif %}

# ============================================================================
# COMPRESSION CONFIGURATION
# ============================================================================

{% set _comp_enabled = (compression | default({})).enabled | default(true) %}
{% if _comp_enabled %}
[compression]
# Enable HTTP response compression (gzip/br).
enabled = true
{% else %}
[compression]
# Disable HTTP response compression.
enabled = false
{% endif %}

# ============================================================================
# SPARQL QUERY LIMITS
# ============================================================================

[sparql]
# Maximum execution time for a SPARQL SELECT query (in milliseconds).
# Schema: sparql.max_query_time_ms
max_query_time_ms = {{ (sparql | default({})).max_query_time_ms | default(60000) }}

# Maximum execution time for a SPARQL UPDATE query (in milliseconds).
# Schema: sparql.max_update_time_ms
max_query_time_ms = {{ (sparql | default({})).max_update_time_ms | default(120000) }}

# Maximum number of triples allowed in a single query result.
# Schema: sparql.max_triples_result
max_triples_result = {{ (sparql | default({})).max_triples_result | default(1000000) }}