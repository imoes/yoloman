#CONFIGFILE=/{{ variable_path_config }}

# Errbot Configuration
# This file is automatically generated based on the default settings.

# --- Core Settings ---
BOTNAME = "{{ variable_botname }}"

# The backend to use. Common options: 'IRC', 'XMPP', 'Slack', 'Telegram', 'Discord'
BACKEND = "{{ variable_backend }}"

# --- Connection Settings ---
# Host and port for IRC backend
BOT_ADDRESS = ("{{ variable_bot_address_host }}", {{ variable_bot_address_port }})

# For XMPP backend
BOT_JID = "{{ variable_bot_jid }}"
BOT_PASSWORD = "{{ variable_bot_password }}"

# --- Identity ---
BOT_ADMINISTRATORS = ["{{ variable_bot_administrators }}"]
BOT_DATA_DIR = "{{ variable_bot_data_dir }}"
BOT_PLUGIN_DIR = "{{ variable_bot_plugin_dir }}"
BOT_EXTRA_PLUGIN_DIR = "{{ variable_bot_extra_plugin_dir }}"
BOT_LOGGING_CONFIG = "{{ variable_bot_logging_config }}"

# --- Cache/Storage Backend ---
CACHE_PLUGIN = "{{ variable_cache_plugin }}"
CACHE_PLUGIN_CONFIG = {{ variable_cache_plugin_config }}

# --- Chat Room Settings ---
BOT_ROOMS = {{ variable_bot_rooms }}

# --- Proxy Settings (Optional) ---
# If your network requires a proxy, uncomment and set the following:
# HTTP_PROXY = "{{ variable_http_proxy }}"
# HTTPS_PROXY = "{{ variable_https_proxy }}"
