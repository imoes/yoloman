# Errbot Configuration File
# This file is managed by Ansible. Do not edit manually.
# Reference: https://errbot.readthedocs.io/en/latest/

# === Core Settings ===

# The backend to use for bot communication (e.g., 'XMPP', 'Slack', 'Discord', 'IRC')
# This determines which plugin is loaded to connect to the messaging service.
BOT_BACKEND = '{{ bot_backend | default("XMPP") }}'

# The bot's unique identifier on the network (JID for XMPP, Nickname for IRC/Slack, etc.)
# This is how the bot identifies itself to the server and other users.
BOT_IDENTITY = {
    # The username or JID used to log in.
    'username': '{{ bot_username | default("errbot") }}',
    # The password for the bot's account.
    'password': '{{ bot_password | default("changeme") }}',
    # Optional: The full JID including resource/server for XMPP.
    'server': '{{ bot_server | default(None) }}',
    # Optional: Port to use if not default (5222 for XMPP, 6667 for IRC, etc.)
    'port': {{ bot_port | default("None") }},
    # Optional: Enable TLS/SSL.
    'use_tls': {{ bot_use_tls | default(True) }},
    # Optional: Verify TLS certificates.
    'verify_ssl': {{ bot_verify_ssl | default(True) }},
}

# The list of administrators who have full control over the bot.
# These users can run administrative commands like !config, !load, etc.
BOT_ADMINS = [
{% for admin in bot_admins | default(['admin@example.com']) %}
    '{{ admin }}',
{% endfor %}
]

# The directory where custom bot plugins are stored.
# This allows administrators to drop in Python files or directories to extend functionality.
PLUGIN_DIR = '{{ plugin_dir | default("/opt/errbot/plugins") }}'

# The directory where the bot stores its data (database, logs, cache).
# This path must be writable by the user running the errbot process.
BOT_DATA_DIR = '{{ bot_data_dir | default("/var/lib/errbot") }}'

# The directory where temporary files are stored.
BOT_TEMP_DIR = '{{ bot_temp_dir | default("/tmp/errbot") }}'

# The directory where the bot's log files are stored.
BOT_LOG_DIR = '{{ bot_log_dir | default("/var/log/errbot") }}'

# === Logging Configuration ===

# The log level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', or 'CRITICAL'.
BOT_LOG_LEVEL = '{{ bot_log_level | default("INFO") }}'

# Enable or disable logging to the console.
LOG_STDOUT = {{ log_stdout | default(False) }}

# The format of the log messages if logging to console or file.
LOG_FORMAT = '{{ log_format | default("%(asctime)s [%(levelname)s] %(message)s") }}'

# === XMPP Specific Settings (if BOT_BACKEND is 'XMPP') ===

# The room/join to announce the bot's presence to.
ROOM_JID = '{{ room_jid | default("conference@example.com") }}'

# === Slack Specific Settings (if BOT_BACKEND is 'Slack') ===

# The Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN = '{{ slack_bot_token | default("") }}'

# === IRC Specific Settings (if BOT_BACKEND is 'IRC') ===

# The IRC server to connect to.
IRC_SERVER = '{{ irc_server | default("irc.libera.chat") }}'

# The IRC port (usually 6697 for SSL).
IRC_PORT = {{ irc_port | default(6697) }}

# The IRC channel(s) to join.
IRC_CHANNELS = [
{% for channel in irc_channels | default(['#errbot']) %}
    '{{ channel }}',
{% endfor %}
]

# === Webserver Configuration (for REST API and Status Page) ===

# Enable the internal webserver.
WEBHOOKS = {{ webhooks | default(False) }}

# The host address for the internal webserver.
WEB_UI_ADDRESS = '{{ web_ui_address | default("127.0.0.1") }}'

# The port for the internal webserver.
WEB_UI_PORT = {{ web_ui_port | default(9005) }}

# Enable authentication for the web UI (recommended for production).
WEB_UI_AUTH = {{ web_ui_auth | default(False) }}

# The username for web UI authentication.
WEB_UI_USERNAME = '{{ web_ui_username | default("admin") }}'

# The password for web UI authentication.
WEB_UI_PASSWORD = '{{ web_ui_password | default("changeme") }}'

# === Security ===

# Enable strict mode for plugins.
STRICT = {{ strict_mode | default(True) }}

# The prefix for bot commands.
COMMAND_PREFIX = '{{ command_prefix | default("!") }}'

# === Plugin Defaults ===

# Default configuration for the 'Core' plugin group.
CORE = {
    # The name of the bot instance.
    'name': '{{ bot_name | default("Errbot") }}',
    # The description of the bot shown in help.
    'description': '{{ bot_description | default("An Errbot instance") }}',
}

# === End of Configuration ===
# Generated by Ansible for {{ ansible_hostname | default("unknown") }}
