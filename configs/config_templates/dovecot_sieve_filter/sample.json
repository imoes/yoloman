{
 "lda_enabled": false,
 "lmtp_enabled": false,
 "sieve_after_scripts": [
  "/var/lib/dovecot/sieve/global-log.sieve"
 ],
 "sieve_before_scripts": [
  "/var/lib/dovecot/sieve/global-antispam.sieve"
 ],
 "sieve_debug": false,
 "sieve_default_script": "",
 "sieve_enabled": true,
 "sieve_global_script": "global-spam.sieve",
 "sieve_global_script_dir": "/var/lib/dovecot/sieve",
 "sieve_in_lda": true,
 "sieve_in_lmtp": true,
 "sieve_max_actions": 16,
 "sieve_max_redirects": 3,
 "sieve_max_script_size": 51200,
 "sieve_plugins": {
  "envelope": true,
  "fileinto": true,
  "imapflags": true,
  "include": true,
  "notify": false,
  "reject": true,
  "relational": true,
  "vacation": true
 },
 "sieve_storage_dir": "~/.dovecot.sieve"
}
