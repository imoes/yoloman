{
  "sieve_enabled": {
    "type": "bool",
    "default": {}
  },
  "sieve_global_script_dir": {
    "type": "string",
    "default": {}
  },
  "sieve_global_script": {
    "type": "string",
    "default": {}
  },
  "sieve_plugins": {
    "type": "object",
    "default": {
      "fileinto": true,
      "reject": false,
      "envelope": false,
      "vacation": true,
      "imap4flags": true,
      "notify": false,
      "include": true
