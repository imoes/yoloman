    "description": "Enabled/disabled Sieve extensions. Each key is a plugin name (without 'sieve_' prefix), value is boolean. Note: 'vacation' controls the vacation extension, not a separate plugin. 'imapflags' is not a standard Sieve plugin name; use 'imap4flags' instead."
  },
  "sieve_in_lda": {
    "type": "bool",
    "default": {}
  },
  "sieve_in_lmtp": {
    "type": "bool",
    "default": {}
  },
  "sieve_storage_dir": {
    "type": "string",
    "default": {}
  },
  "sieve_before_scripts": {
    "type": "list",
    "default": {}
  },
  "sieve_after_scripts": {
    "type": "list",
    "default": {}
  },
  "sieve_max_script_size": {
    "type": "number",
    "default": {}
  },
  "sieve_max_actions": {
    "type": "number",
    "default": {}
  },
  "sieve_max_redirects": {
    "type": "number",
    "default": {}
