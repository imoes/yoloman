{
  "fling_config": {
    "enabled": true,
    "instances": [
      {
        "name": "receive_to_file",
        "mode": "receiver",
        "port": 12756,
        "output_file": "/var/lib/fling/received.dat",
        "verbose": true
      },
      {
        "name": "send_to_remote",
        "mode": "sender",
        "host": "receiver.internal",
        "port": 12756,
        "verbose": true,
        "progress": true
      },
      {
        "name": "ssh_auto_backup",
        "mode": "ssh_auto",
        "user": "backup",
        "host": "remote-backup.example.com",
        "output_path": "/backups/latest.dat",
        "remote_exe": "/usr/bin/fling",
        "ssh_cmd": "ssh -o StrictHostKeyChecking=no",
        "verbose": true
      }
    ]
  }
}
