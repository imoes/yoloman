# =============================================================================
# ekeyd-egd-linux Configuration Template
# =============================================================================
# This file configures the ekeyd-egd-linux daemon, which connects an entropy
# gathering daemon (EGD) to the Linux kernel's random number pool.
#
# IMPORTANT:
# - START_EKEYD_EGD_LINUX must be set to 'YES' (or 'true' if the wrapper script
#   supports it, but standard ekeyd expects 'YES') for the daemon to start.
# - All network and pool parameters below control the daemon's behavior.
# =============================================================================

# -----------------------------------------------------------------------------
# Start Control
# -----------------------------------------------------------------------------
# Whether to allow ekeyd-egd-linux to start.
# Must be set to 'YES' to enable the service.
START_EKEYD_EGD_LINUX={{ START_EKEYD_EGD_LINUX | default(False) | ternary('YES', 'NO') }}

# -----------------------------------------------------------------------------
# Network Binding
# -----------------------------------------------------------------------------
# Host address to bind/listen on.
{% if HOST is defined and HOST is not none and (HOST is number or HOST is boolean or HOST | length > 0) %}HOST={{ HOST | default('127.0.0.1') }}{% else %}# HOST=127.0.0.1{% endif %}

# Port to bind/listen on.
{% if PORT is defined and PORT is not none and (PORT is number or PORT is boolean or PORT | length > 0) %}PORT={{ PORT | default(8888) }}{% else %}# PORT=8888{% endif %}

# -----------------------------------------------------------------------------
# Entropy Pool Parameters
# -----------------------------------------------------------------------------
# Number of bits minimum in the pool, below which the daemon kicks in and
# transfers data from EGD.
{% if WATERMARK is defined and WATERMARK is not none and (WATERMARK is number or WATERMARK is boolean or WATERMARK | length > 0) %}WATERMARK={{ WATERMARK | default(1024) }}{% else %}# WATERMARK=1024{% endif %}

# Number of 1024-bit (128-byte) blocks to transfer to the kernel each time
# the pool dips below the low water mark.
{% if BLOCKS is defined and BLOCKS is not none and (BLOCKS is number or BLOCKS is boolean or BLOCKS | length > 0) %}BLOCKS={{ BLOCKS | default(3) }}{% else %}# BLOCKS=3{% endif %}

# Shannons-per-byte to claim for data pushed to the pool.
{% if SHANNONS is defined and SHANNONS is not none and (SHANNONS is number or SHANNONS is boolean or SHANNONS | length > 0) %}SHANNONS={{ SHANNONS | default(7) }}{% else %}# SHANNONS=7{% endif %}

# -----------------------------------------------------------------------------
# Connection Retry Settings
# -----------------------------------------------------------------------------
# Seconds between connection retries. Zero means do-not-retry.
RETRYTIME={{ RETRYTIME | default(128) }}
