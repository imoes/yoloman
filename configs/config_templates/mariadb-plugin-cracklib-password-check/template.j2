; This configuration file is part of the mariadb-plugin-cracklib-password-check role.
; It enables the cracklib password checking plugin for MariaDB/MySQL.
; The plugin checks user passwords against a dictionary to prevent weak passwords.

[mariadb]
; The plugin file to load for the cracklib password check plugin.
; Default: cracklib_password_check.so
plugin-load-add={{ plugin_load_add | default('cracklib_password_check.so') }}
