# MariaDB Server Configuration: cracklib-password-check Plugin
# This section configures the MariaDB server to load the cracklib plugin,
# which enforces strong password policies for database users.
# See: https://mariadb.com/kb/en/cracklib-plugin/

[mariadb]
# plugin-load-add: The plugin file to load for the cracklib password check plugin.
# Defaults to 'cracklib_password_check.so'.
plugin-load-add={{ plugin_load_add | default('cracklib_password_check.so') }}