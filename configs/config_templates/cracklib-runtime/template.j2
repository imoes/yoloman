# Cracklib Runtime Configuration
#
# Cracklib is a password checking library. The 'cracklib-runtime' package
# typically provides the utilities (like `pwdcheck` or `cracklib-check`)
# and runtime files (dictionaries) rather than a long-running daemon.
#
# This template captures runtime environment variables or configuration
# snippets that might be required by scripts or applications linking
# against libcrack, or for tuning the dictionary update process.
#
# Since there are no standard configuration files for the runtime library itself,
# this template serves as a placeholder for environment variables or
# integration points defined in an Ansible role.

# Environment variable to control verbose logging of dictionary updates
# if tools invoking cracklib are run with debug flags.
# Default: empty (no override)
CRACKLIB_VERBOSE={{ env_cracklib_verbose | default("") | string }}

# Path to custom dictionary files if extending the standard set.
# Default: empty (use system default)
CRACKLIB_DICTPATH={{ env_cracklib_dict_path | default("") | string }}

# Minimum length for passwords checked by cracklib.
# Default: 0 (use library default)
CRACKLIB_MIN_LENGTH={{ env_cracklib_min_length | default(0) | int }}

# Enable/disable checking for reverse words in passwords.
# Default: true
CRACKLIB_REVERSE={{ env_cracklib_reverse | default(true) | bool }}