{
 "fastcgi": {
  "graceful_reload": true,
  "group": "www-data",
  "pid_file": "/run/lemonldap-ng-fastcgi.pid",
  "ports": [
   9090
  ],
  "sockets": [
   "/var/run/lemonldap-ng/fastcgi.sock"
  ],
  "user": "www-data",
  "workers": 4
 },
 "logger": {
  "backend": "File",
  "file": "/var/log/lemonldap-ng/fastcgi.log",
  "format": "%d %p %m %s",
  "level": "debug"
 },
 "main": {
  "config_storage": {
   "options": {
    "filename": "/etc/lemonldap-ng/conf/lemonldap-ng.ini"
   },
   "type": "JSON"
  },
  "log_level": "info",
  "management_url": "https://manager.example.com",
  "portal_url": "https://auth.example.com",
  "request_timeout": 25,
  "session_storage": {
   "options": {
    "keyPrefix": "llng_session_",
    "servers": [
     "127.0.0.1:6379"
    ]
   },
   "type": "Redis"
  }
 }
}
