{# GPX Viewer configuration — rendered as a JavaScript object literal.
   This template is self-documenting: every field is annotated with its schema
   description and has a safe default value applied via the `default` filter.
   No field is omitted; all use explicit defaults to prevent undefined variable errors. #}
var gpxviewer_config = {{ var|default('gpxviewer_config') }} = {
  // Map backend: 'leaflet' (default, OpenStreetMap), 'google' (requires API key), or legacy 'gmap' alias.
  "mapapi": {{ mapapi|default('leaflet')|tojson }},

  // Use <color> tags from GPX file for track/route coloring if present.
  "displaycolor": {{ displaycolor|default(false)|tojson }},

  // Dynamic track coloring: 'elevation', 'speed', 'cadence', 'heartrate', 'airtemp', or 'none'.
  "trcolmod": {{ trcolmod|default('none')|tojson }},

  // Show directional markers along track segments (Leaflet-only).
  "trackmarker": {{ trackmarker|default(false)|tojson }},

  // Draw directional arrows along tracks (Leaflet-only).
  "arrowtrack": {{ arrowtrack|default(false)|tojson }},

  // Show directional markers along route segments (Leaflet-only).
  "routemarker": {{ routemarker|default(false)|tojson }},

  // Draw directional arrows along routes (Leaflet-only).
  "arrowroute": {{ arrowroute|default(false)|tojson }},

  // Target for links embedded in GPX elements: '_self', '_blank', or '_popup'.
  "linktarget": {{ linktarget|default('_blank')|tojson }},

  // Concatenate multiple tracks in graphs so distance/time axes are continuous.
  "tracks_verbinden": {{ tracks_verbinden|default(true)|tojson }},

  // Include the <desc> field in waypoint popups (in addition to <name> and <cmt>).
  "showdesc": {{ showdesc|default(false)|tojson }},

  // Window size for elevation smoothing (must be odd positive integer).
  "smooth_elevation_window": {{ smooth_elevation_window|default(5)|tojson }},

  // Maximum distance in meters between waypoints to form a cluster.
  "cluster_distance": {{ cluster_distance|default(40)|tojson }},

  // Initial map type. Leaflet options: 'OSM', 'OSMDE', 'OSM_Cycle', 'OSM_Landscape', 'OSM_Outdoors', 'Open_Topo', 'TopPlusOpen', 'Open_Sea', 'Hiking', 'Cycling', 'Keine_Karte', 'Satellit', 'Hybrid'.
  "map_type": {{ map_type|default('OSM')|tojson }},

  // API keys required for certain maps. Supported keys: 'mapbox' (for OSM_Cycle/Landscape), 'thunderforest' (for some OSM variants), 'google' (for Google Maps).
  // Rendered as a JSON object; if empty or undefined, outputs an empty object {}.
  "api_keys": {{ (api_keys|default({}))|tojson }},

  // Units for distance/speed/elevation: 'metric', 'imperial', or 'nautical' (for sailing).
  "units": {{ units|default('metric')|tojson }},

  // UI theme: 'light' or 'dark'.
  "theme": {{ theme|default('light')|tojson }},

  // Additional fields to include in graphs: 'elevation', 'speed', 'cadence', 'heartrate', 'airtemp', 'power'.
  "profile_fields": {{ profile_fields|default(['elevation','speed'])|tojson }},

  // Initial zoom level (1–19).
  "default_map_zoom": {{ default_map_zoom|default(13)|tojson }}
};