# Claws Mail Spam Report plugin configuration
#
# This file configures the spam-report plugin for Claws Mail.
# It defines a list of external services that the plugin will use to submit
# suspected spam messages for analysis (e.g., SpamAssassin, PhishTank).
#
# Format: <service_name>=<enabled_status>
#   service_name: The identifier of the reporting service as defined in the schema.
#   enabled_status: 'true' or 'false' indicating if the service is active.

# List of spam-report services to configure. Each item defines a service endpoint and whether it is enabled for spam reporting.
{% for service in (services | default([])) %}
# Service Name: The identifier for this spam reporting service.
# Default: '' (empty string if not specified in the list item)
service_name={{ service.name | default('') }}

# Service Enabled: Boolean flag to enable or disable this specific service.
# Default: false
service_enabled={{ service.enabled | default(false) | string }}
{% endfor %}

# End of Claws Mail Spam Report configuration