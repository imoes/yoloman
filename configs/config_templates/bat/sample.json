{
  "config_lines": [
    "# bat.conf \u2014 Bacula Administration Tool configuration file",
    "# See bat.conf(5) for more information",
    "",
    "# Director resource \u2014 connect to your Bacula Director",
    "Director {",
    "  Name = bacula-dir",
    "  DIRport = 9101",
    "  address = localhost",
    "  Password = \"secret-password\"",
    "}",
    "",
    "# Console resource \u2014 optional overrides",
    "Console {",
    "  Name = admin",
    "  Password = \"admin-secret\"",
    "  ACLs = {",
    "    use = \"*\"  # full access",
    "  }",
    "}",
    "",
    "# Working directory for temporary files",
    "WorkingDirectory = /var/spool/bat",
    "",
    "# Messages \u2014 how bat reports status/errors",
    "Messages = Standard",
    "",
    "# Debug level (0=none, 20=verbose) \u2014 override via -d on command line",
    "# DebugLevel = 10",
    "",
    "# NoSignals \u2014 disables signal handling (for debugging)",
    "# NoSignals = no",
    ""
  ]
}
