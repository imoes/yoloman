{# ============================================================
   bat.conf - Bacula Administration Tool (Qt4) Configuration
   ============================================================
   
   This file controls the Bacula Administration Tool (bat).
   It uses a simple key=value format without section headers.
   
   For full details, see: bat.conf(5)
   
   This template is self-documenting: every variable reference
   includes its schema description and a safe default value.
   The "config_lines" field allows injection of arbitrary
   configuration directives.
   #}

{# ------------------------------------------------------------------
   config_lines: List of configuration directive lines. Each item is
   a single-line string with key=value or comment lines (starting with #).
   Directives are processed in order.
   Default: empty list (no custom directives).
   ------------------------------------------------------------------ #}
{% for line in config_lines | default([]) %}
{{ line }}
{% endfor %}