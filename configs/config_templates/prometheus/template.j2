# Global configuration: default settings for all scrape configs and alerting
global:
  # How often to scrape targets
  scrape_interval: {{ scrape_interval | default('15s') }}
  # How long before a scrape request times out
  scrape_timeout: {{ scrape_timeout | default('10s') }}
  # Evaluation interval for rules
  evaluation_interval: {{ evaluation_interval | default('15s') }}
  # Labels to append to all metrics
  external_labels:
{% for key, value in external_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}

# Rule files: paths to .rules.yml files to load
rule_files:
{% for rule_file in rule_files %}
  - {{ rule_file }}
{% endfor %}

# Scrape configurations: define how and where to collect metrics
scrape_configs:
{% for scrape_config in scrape_configs %}
  # Scrape job: {{ scrape_config.job_name }}
  - job_name: '{{ scrape_config.job_name }}'
{% if scrape_config.metrics_path %}
    metrics_path: '{{ scrape_config.metrics_path }}'
{% endif %}
{% if scrape_config.scheme %}
    scheme: '{{ scrape_config.scheme }}'
{% endif %}
{% if scrape_config.http_sd_configs %}
    # Service discovery via HTTP endpoints
    http_sd_configs:
{% for http_sd in scrape_config.http_sd_configs %}
      - url: '{{ http_sd.url }}'
        refresh_interval: {{ http_sd.refresh_interval | default('30s') }}
{% endfor %}
{% endif %}
{% if scrape_config.static_configs %}
    # Static target configuration
    static_configs:
{% for static_config in scrape_config.static_configs %}
      - targets:
{% for target in static_config.targets %}
          - {{ target }}
{% endfor %}
{% if static_config.labels %}
        labels:
{% for key, value in static_config.labels.items() %}
          {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% if scrape_config.relabel_configs %}
    # Relabeling: modify labels before metric ingestion
    relabel_configs:
{% for relabel in scrape_config.relabel_configs %}
      # {{ relabel.source_labels | join(', ') }} → {{ relabel.target_label }} (action: {{ relabel.action | default('replace') }})
      - source_labels: [{{ relabel.source_labels | join(', ') | default('') }}]
        target_label: '{{ relabel.target_label }}'
{% if relabel.regex %}
        regex: '{{ relabel.regex }}'
{% endif %}
{% if relabel.modulus %}
        modulus: {{ relabel.modulus }}
{% endif %}
{% if relabel.replacement %}
        replacement: '{{ relabel.replacement }}'
{% endif %}
        action: '{{ relabel.action | default('replace') }}'
{% endfor %}
{% endif %}
{% if scrape_config.metric_relabel_configs %}
    # Metric relabeling: drop or transform metrics post-scrape
    metric_relabel_configs:
{% for metric_relabel in scrape_config.metric_relabel_configs %}
      # {{ metric_relabel.source_labels | join(', ') }} → {{ metric_relabel.target_label }} (action: {{ metric_relabel.action | default('drop') }})
      - source_labels: [{{ metric_relabel.source_labels | join(', ') | default('') }}]
        target_label: '{{ metric_relabel.target_label }}'
{% if metric_relabel.regex %}
        regex: '{{ metric_relabel.regex }}'
{% endif %}
{% if metric_relabel.modulus %}
        modulus: {{ metric_relabel.modulus }}
{% endif %}
{% if metric_relabel.replacement %}
        replacement: '{{ metric_relabel.replacement }}'
{% endif %}
        action: '{{ metric_relabel.action | default('drop') }}'
{% endfor %}
{% endif %}
{% if scrape_config.authorization %}
    # Authorization header for scraping
    authorization:
      type: '{{ scrape_config.authorization.type | default('Bearer') }}'
      credentials_file: '{{ scrape_config.authorization.credentials_file | default('') }}'
      credentials: '{{ scrape_config.authorization.credentials | default('') }}'
{% endif %}
{% if scrape_config.bearer_token_file %}
    # Legacy token file (deprecated but still supported)
    bearer_token_file: '{{ scrape_config.bearer_token_file }}'
{% endif %}
{% if scrape_config.basic_auth %}
    # Basic authentication
    basic_auth:
      username: '{{ scrape_config.basic_auth.username }}'
      password: '{{ scrape_config.basic_auth.password }}'
{% endif %}
{% if scrape_config.oauth2 %}
    # OAuth2 client configuration
    oauth2:
      client_id: '{{ scrape_config.oauth2.client_id }}'
      client_secret: '{{ scrape_config.oauth2.client_secret }}'
      token_url: '{{ scrape_config.oauth2.token_url }}'
{% if scrape_config.oauth2.scopes %}
      scopes:
{% for scope in scrape_config.oauth2.scopes %}
        - '{{ scope }}'
{% endfor %}
{% endif %}
{% if scrape_config.oauth2.endpoint_params %}
      endpoint_params:
{% for key, value in scrape_config.oauth2.endpoint_params.items() %}
        {{ key }}: '{{ value }}'
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}

# Storage configuration: local TSDB settings
storage:
  tsdb:
    # Path to data directory
    path: {{ storage_path | default('/var/lib/prometheus/data') }}
    # WAL segment size
    wal_compression: {{ wal_compression | default(false) | lower }}
{% if retention_size_limit %}
    # Optional: max size of the WAL before compaction
    wal_segments_max_size: {{ retention_size_limit | default('0') }}
{% endif %}

# Alertmanager configuration
alerting:
{% if alertmanagers %}
  # Alertmanager discovery
  alertmanagers:
{% for am in alertmanagers %}
    # Alertmanager: {{ am.name | default(am.static_configs[0].targets[0] if am.static_configs else 'unknown') }}
    - static_configs:
        - targets:
{% for target in am.static_configs[0].targets if am.static_configs %}
            - {{ target }}
{% endfor %}
{% if am.scheme %}
      scheme: '{{ am.scheme }}'
{% endif %}
{% if am.timeout %}
      timeout: '{{ am.timeout }}'
{% endif %}
{% if am.enable_http2 %}
      enable_http2: {{ am.enable_http2 | lower }}
{% endif %}
{% if am.basic_auth %}
      basic_auth:
        username: '{{ am.basic_auth.username }}'
        password: '{{ am.basic_auth.password }}'
{% endif %}
{% if am.authorization %}
      authorization:
        type: '{{ am.authorization.type | default('Bearer') }}'
{% if am.authorization.credentials_file %}
        credentials_file: '{{ am.authorization.credentials_file }}'
{% endif %}
{% if am.authorization.credentials %}
        credentials: '{{ am.authorization.credentials }}'
{% endif %}
{% endif %}
{% endfor %}
{% else %}
  # No alertmanagers configured
  alertmanagers: []
{% endif %}
