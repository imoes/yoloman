# ccal color configuration
#
# This file defines the ANSI color codes used by the 'ccal' (calendar) utility
# to render its output in the terminal. Each line consists of two two-character
# hex codes: <FOREGROUND> <BACKGROUND>.
#
# Color codes (00-15):
#   00=black, 01=blue, 02=green, 03=cyan, 04=red, 05=violet, 06=orange, 07=light gray
#   08=dark gray, 09=bright blue, 10=bright green, 11=bright cyan, 12=bright red,
#   13=bright violet, 14=yellow, 15=white
#
# Note: Background colors 08-15 result in flashing text (background 0-7 + flash).

# Foreground and Background color code (00-15) for month name
{{ ccal_fg_month_name | default('00') }} {{ ccal_bg_month_name | default('02') }}

# Foreground and Background color code (00-15) for weekday header
{{ ccal_fg_weekday_header | default('01') }} {{ ccal_bg_weekday_header | default('03') }}

# Foreground and Background color code (00-15) for normal calendar days
{{ ccal_fg_normal_days | default('07') }} {{ ccal_bg_normal_days | default('01') }}

# Foreground and Background color code (00-15) for Sundays
{{ ccal_fg_sundays | default('13') }} {{ ccal_bg_sundays | default('01') }}

# Foreground and Background color code (00-15) for current day
{{ ccal_fg_current_day | default('00') }} {{ ccal_bg_current_day | default('02') }}

# Foreground and Background color code (00-15) for yearly calendar background (space between months)
{{ ccal_fg_yearly_space | default('07') }} {{ ccal_bg_month_name | default('02') }}

# Foreground and Background color code (00-15) for special day descriptions
{{ ccal_fg_normal_days | default('07') }} {{ ccal_bg_normal_days | default('01') }}

