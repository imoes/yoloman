# Configuration for the prometheus-nginx-exporter service
# Sets the binary to execute
EXEC=/usr/bin/prometheus-nginx-exporter

# Sets the command-line arguments passed to the exporter
# Note: --nginx.scrape-uri must point to a valid NGINX stub_status endpoint
ARGS="{{ args | join(' ') }}"

# Optional: custom environment variables (e.g., HTTP proxy settings)
{% if env %}
# Environment variables defined in key=value format
{% for key, value in env.items() %}{{ key }}="{{ value }}"
{% endfor %}
{% endif %}