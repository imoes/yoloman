# Exim4 main configuration template — generated by mail_config_exim
# This is a split configuration file: it includes other files based on split_config
# Uncomment and adapt as needed; only the required directives are listed.

# --- Primary hostname for this mail server (used in HELO/EHLO, envelope sender, etc.) ---
primary_hostname = {{ primary_hostname }}

# --- Enable split configuration? (true = split config files in /etc/exim4/conf.d/, false = single monolithic file) ---
domainlist local_domains = {{ local_domains | join(':') }}

# --- Domains this server considers local (accept mail for) ---
{% if split_config %}
# If split config is used, local_domains is usually set via separate file: conf.d/main/01_exim4-config_listmacros
# Here we override via top-level macro for simplicity in monolithic rendering
{% endif %}

# --- Domains to relay for (authenticated or trusted hosts) ---
domainlist relay_domains = {{ relay_domains | join(':') }}

# --- Hosts allowed to relay without authentication (e.g., localhost, internal subnets) ---
hostlist allow_hosts = {{ allow_hosts | join(' ') }}

# --- Hosts allowed to relay for domains in relay_domains without auth ---
hostlist allow_relay_hosts = {{ allow_relay_hosts | join(' ') }}

# --- TLS/SSL settings ---
{% if enable_tls %}
MAIN_TLS_ENABLE = yes
# Certificate and key paths — must be readable by Debian-exim user
TLS_CERT = {{ tls_cert_path }}
TLS_KEY = {{ tls_key_path }}
{% else %}
MAIN_TLS_ENABLE = no
{% endif %}

# --- Authentication mechanisms enabled ---
{% for auth in auth_mechanisms %}
{% if auth.enabled %}
# {{ auth.driver | capitalize }} authentication support
{% endif %}
{% endfor %}
BEGIN AUTHENTICATION
{% for auth in auth_mechanisms %}
{% if auth.enabled %}
  {{ auth.driver }}:
    driver = {{ auth.driver }}
{% if auth.public_name %}
    public_name = {{ auth.public_name }}
{% endif %}
{% if auth.server_condition %}
    server_condition = {{ auth.server_condition }}
{% endif %}
{% if auth.server_set_id %}
    server_set_id = {{ auth.server_set_id }}
{% endif %}
{% if auth.client_secret %}
    client_secret = {{ auth.client_secret }}
{% endif %}
{% if auth.server_prompts %}
    server_prompts = {{ auth.server_prompts | join(' : ') }}
{% endif %}
{% if auth.server_advertise_conditions %}
    server_advertise_conditions = {{ auth.server_advertise_conditions | join(' : ') }}
{% endif %}
{% if auth.client_name %}
    client_name = {{ auth.client_name }}
{% endif %}
{% endfor %}
{% endfor %}

# --- Logging configuration ---
log_file_path = /var/log/exim4/%s.log
log_selector = +address_rewrite +all_parents +arguments +connection_reject +cpid +cwd +list_dispatch +pid +queue_run +receive_reject +sender_on_queue +smtp_confirmation +smtp_protocol +smtp_syntax_error +tls_certificate_negotiated +tls_peerdn +tls_sni +unread

# --- Queue and delivery settings ---
queue_run_timeout = {{ queue_run_timeout }}
max_message_size = {{ max_message_size }}
message_size_limit = {{ max_message_size }}

# --- Spool and log directory paths ---
spool_directory = /var/spool/exim4
log_directory = /var/log/exim4

# --- Delivery backends (local/remote) ---
{% if use_spool_directory_as_spool %}
# Use spool directory (recommended for split config)
{% else %}
# Direct spooling (monolithic config only)
{% endif %}
spool_directory = /var/spool/exim4

# --- Routers — define routing rules in order ---
{% for router in routers %}
# {{ router.name }}: {{ router.comment }}
{% if router.condition %}
{{ router.name }}:
  driver = {{ router.driver }}
  condition = {{ router.condition }}
{% else %}
{{ router.name }}:
  driver = {{ router.driver }}
{% endif %}
{% if router.transport %}
  transport = {{ router.transport }}
{% endif %}
{% if router.address_data %}
  address_data = {{ router.address_data }}
{% endif %}
{% if router.domains %}
  domains = {{ router.domains | join(':') }}
{% endif %}
{% if router.local_parts %}
  local_parts = {{ router.local_parts | join(':') }}
{% endif %}
{% if router.hosts %}
  hosts = {{ router.hosts | join(':') }}
{% endif %}
{% if router.senders %}
  senders = {{ router.senders | join(':') }}
{% endif %}
{% if router.retry_use_local_domain %}
  retry_use_local_domain = {{ 'yes' if router.retry_use_local_domain else 'no' }}
{% endif %}
{% if router.headers_add %}
  headers_add = {{ router.headers_add }}
{% endif %}
{% if router.route_data %}
  route_data = {{ router.route_data | join(' ; ') }}
{% endif %}
{% if router.ignore_target_hosts %}
  ignore_target_hosts = {{ router.ignore_target_hosts | join(':') }}
{% endif %}
{% if router.self = 'pass' %}
  self = pass
{% endif %}
{% if router.defer_ok %}
  defer_ok = true
{% endif %}
{% endfor %}

# --- Transports — how mail is actually delivered ---
{% for transport in transports %}
# {{ transport.name }}: {{ transport.comment }}
{{ transport.name }}:
  driver = {{ transport.driver }}
{% if transport.file_path %}
  file_path = {{ transport.file_path }}
{% endif %}
{% if transport.append %}
  append = {{ 'yes' if transport.append else 'no' }}
{% endif %}
{% if transport.file_mode %}
  file_mode = 0660
{% endif %}
{% if transport.file_owner %}
  file_owner = Debian-exim
{% endif %}
{% if transport.file_group %}
  file_group = mail
{% endif %}
{% if transport.delivery_date_add %}
  delivery_date_add = true
{% endif %}
{% if transport.envelope_to_add %}
  envelope_to_add = true
{% endif %}
{% if transport.headers_add %}
  headers_add = {{ transport.headers_add | join('\n  ') }}
{% endif %}
{% if transport.local_part_suffix %}
  local_part_suffix = {{ transport.local_part_suffix }}
{% endif %}
{% if transport.local_part_suffix_same_case %}
  local_part_suffix_same_case = {{ transport.local_part_suffix_same_case }}
{% endif %}
{% if transport.return_path_add %}
  return_path_add = true
{% endif %}
{% if transport.to_file %}
  to_file = true
{% endif %}
{% if transport.transport_address_data %}
  transport_address_data = {{ transport.transport_address_data }}
{% endif %}
{% if transport.unseen %}
  unseen = {{ 'yes' if transport.unseen else 'no' }}
{% endif %}
{% endfor %}

# --- ACLs — Access Control Lists (INBOUND) ---
{% for acl in inbound_acls %}
# ACL: {{ acl.name }} — {{ acl.comment }}
{% if acl.statement %}
{% for line in acl.statement.split('\n') | map('trim') | reject('equalto', '') %}
{{ line }}
{% endfor %}
{% endif %}
{% endfor %}

# --- Macros for common values ---
{% for macro in macros %}
# {{ macro.name }} = {{ macro.value }}
{{ macro.name }} = {{ macro.value }}
{% endfor %}

# --- Finalize config ---
.include if exists /etc/exim4/conf.d/main/01_exim4-config_listmacros
{% if split_config %}
# In split config mode, additional include files are loaded from conf.d/
{% else %}
# In non-split mode, everything above is part of one file.
{% endif %}
