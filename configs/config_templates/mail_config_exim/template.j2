# ==============================================================================
# Exim4 Main Configuration Template
# ==============================================================================
# Self-documenting Jinja2 template for configuring Exim4.
# All variables use explicit defaults to prevent render failures.
# Read comments carefully to understand each directive's purpose.

# --- Primary Hostname ---
# Primary domain name used for this mail server (e.g., in HELO, envelope sender, and TLS SNI).
primary_hostname = {{ primary_hostname | default('mail.example.com') }}

# --- Local Domains ---
# List of domains for which this server will accept and deliver mail locally.
# Joined by ':' as required by Exim domain lists.
domainlist local_domains = {{ local_domains | default(['example.com', 'localhost']) | join(':') }}

# --- Relay Domains ---
# Domains for which this server will relay mail (e.g., for other internal hosts).
# Empty list means no relaying for external domains by default.
domainlist relay_domains = {{ relay_domains | default([]) | join(':') }}

# --- Allowed Hosts (Local Submission) ---
# Hosts allowed to submit mail without authentication (e.g., localhost and internal network).
# Space-separated list as required by Exim host lists.
hostlist allow_hosts = {{ allow_hosts | default(['127.0.0.1']) | join(' ') }}

# --- Allowed Relay Hosts ---
# Hosts allowed to relay mail for domains listed in relay_domains (without authentication).
hostlist allow_relay_hosts = {{ allow_relay_hosts | default([]) | join(' ') }}

# --- TLS/SSL Configuration ---
# Enable TLS (STARTTLS) for SMTP connections.
{% if enable_tls | default(true) | bool %}
# TLS is ENABLED.
MAIN_TLS_ENABLE = yes
# Path to the TLS certificate file (PEM format, readable by Debian-exim).
MAIN_TLS_CERTIFICATE = {{ tls_cert_path | default('/etc/ssl/certs/mail.crt') }}
# Path to the TLS private key file (PEM format, readable by Debian-exim).
MAIN_TLS_PRIVATEKEY = {{ tls_key_path | default('/etc/ssl/private/mail.key') }}
{% else %}
# TLS is DISABLED. Not recommended for production.
MAIN_TLS_ENABLE = no
{% endif %}

# --- Authentication Mechanisms ---
# List of SASL authentication mechanisms to support.
# Only enabled mechanisms are included in config.
# The resulting string is used in the 'authenticated = ' directive of routers/transports
# or in the 'begin authenticators' section if split config is not used.
# Here we generate a comma-separated list of drivers for the main config's auth block.
# Note: In Exim, authenticators are usually defined in 'begin authenticators'.
# This block generates the list of enabled mechanism names/drivers for reference or
# for use in a 'begin authenticators' block if included.
# For the main config file, we list the enabled drivers.
# The actual 'begin authenticators' block content is generated below.

# Enabled authentication mechanisms drivers
# (Used to configure the 'authenticated' field or included in authenticators section)
enabled_auth_drivers = {{ auth_mechanisms | default([{'driver': 'login', 'enabled': False}, {'driver': 'plain', 'enabled': False}]) | selectattr('enabled', 'equalto', true) | map(attribute='driver') | join(', ') }}

# --- Authentication Drivers (Begin Authenticators Section) ---
# If split_config is false, these authenticators should be placed in a 'begin authenticators' section.
# If split_config is true, this section might be included from an external file.
# We generate the driver blocks for all ENABLED mechanisms.
# Exim Authenticator Syntax:
#   driver = <driver_name>
#   public_name = <mechanism_name>
#   server_prompts = <prompt>
#   server_condition = <test>
#   server_set_id = <user>

{% for auth in auth_mechanisms | default([{'driver': 'login', 'enabled': False}, {'driver': 'plain', 'enabled': False}]) %}
{% if auth.enabled | default(false) | bool %}
# Authenticator: {{ auth.driver | default('login') }}
# Driver for {{ auth.driver | default('login') }} authentication.
{{ auth.driver | default('login') }}:
  driver = {{ auth.driver | default('login') }}
  {% if auth.public_name is defined %}
  public_name = {{ auth.public_name }}
  {% endif %}
  {% if auth.server_prompts is defined %}
  {# server_prompts may be a list (['Username:', 'Password:']) or a string. Handle both. #}
  {% if auth.server_prompts is iterable and auth.server_prompts is not string %}
  server_prompts = {{ auth.server_prompts | join(' : ') }}
  {% else %}
  server_prompts = {{ auth.server_prompts }}
  {% endif %}
  {% else %}
  server_prompts = Username: : Password:
  {% endif %}
  {% if auth.server_condition is defined %}
  server_condition = {{ auth.server_condition }}
  {% endif %}
  {% if auth.server_set_id is defined %}
  server_set_id = {{ auth.server_set_id }}
  {% endif %}
  {% if auth.client_secret is defined %}
  # client_secret = {{ auth.client_secret }}
  {% endif %}
  {% if auth.server_advertise_conditions is defined %}
  # advertise condition for STARTTLS: {{ auth.server_advertise_conditions | join(' : ') }}
  {% endif %}

{% endif %}
{% endfor %}

# --- Logging Configuration ---
# Path template for log files. %s is replaced by the log selector.
log_file_path = /var/log/exim4/%s.log

# Log selector defines what information is logged.
log_selector = +address_rewrite +all_parents +arguments +connection_reject +cpid +cwd +list_dispatch +pid +queue_run +receive_reject +sender_on_queue +smtp_confirmation +smtp_protocol +smtp_syntax_error +tls_certificate_negotiated +tls_peerdn +tls_sni +unread

# --- Queue and Delivery Settings ---
# Maximum time (in seconds) to wait before giving up on a deferred delivery attempt.
queue_run_timeout = {{ queue_run_timeout | default(300) }}

# Maximum message size (in bytes) the server will accept (including headers and attachments).
max_message_size = {{ max_message_size | default(26214400) }}

# Aliased directive for message size limit (some Exim versions use this).
message_size_limit = {{ max_message_size | default(26214400) }}

# --- Spool and Log Directory Paths ---
# Directory where Exim stores queue files.
spool_directory = /var/spool/exim4

# Directory where Exim stores log files.
log_directory = /var/log/exim4

# --- Spool Directory Usage ---
# Whether to use the spool directory (set automatically by split_config mode).
# If true, Exim uses the spool_directory for queue storage.
{% if use_spool_directory_as_spool | default(true) | bool %}
# Using spool directory for spooling (recommended for split config).
SPOOL_DIRECTORY = /var/spool/exim4
{% else %}
# Using direct spooling (monolithic config only).
{% endif %}

# --- Routers ---
# List of routers that determine how incoming mail is handled.
# Each router is defined in a block under 'begin routers'.
{% for router in routers | default([{'name': 'dnslookup', 'comment': 'Route mail via DNS MX lookup', 'driver': 'dnslookup', 'domains': '! +local_domains', 'transport': 'remote_smtp', 'retry_use_local_domain': False}, {'name': 'local_user', 'comment': 'Deliver mail for local users', 'driver': 'accept', 'domains': '+local_domains', 'transport': 'local_delivery', 'local_parts': '!^.*\\+.*$', 'headers_add': 'X-Local: yes'}]) %}
# Router: {{ router.name | default('unnamed') }}
# Comment: {{ router.comment | default('No comment') }}
{{ router.name | default('unnamed') }}:
  driver = {{ router.driver | default('accept') }}
  {% if router.domains is defined %}
  domains = {{ router.domains }}
  {% endif %}
  {% if router.transport is defined %}
  transport = {{ router.transport }}
  {% endif %}
  {% if router.condition is defined %}
  condition = {{ router.condition }}
  {% endif %}
  {% if router.local_parts is defined %}
  local_parts = {{ router.local_parts }}
  {% endif %}
  {% if router.hosts is defined %}
  hosts = {{ router.hosts }}
  {% endif %}
  {% if router.senders is defined %}
  senders = {{ router.senders }}
  {% endif %}
  {% if router.address_data is defined %}
  address_data = {{ router.address_data }}
  {% endif %}
  {% if router.headers_add is defined %}
  headers_add = {{ router.headers_add }}
  {% endif %}
  {% if router.retry_use_local_domain is defined %}
  retry_use_local_domain = {{ 'yes' if router.retry_use_local_domain else 'no' }}
  {% endif %}
  {% if router.ignore_target_hosts is defined %}
  ignore_target_hosts = {{ router.ignore_target_hosts }}
  {% endif %}
  {% if router.route_data is defined %}
  route_data = {{ router.route_data }}
  {% endif %}
  {% if router.self is defined %}
  self = {{ router.self }}
  {% endif %}
  {% if router.defer_ok is defined %}
  defer_ok = {{ 'yes' if router.defer_ok else 'no' }}
  {% endif %}

{% endfor %}

# --- Transports ---
# List of transports that define how mail is actually delivered (to files, SMTP, etc.).
# Each transport is defined in a block under 'begin transports'.
{% for transport in transports | default([{'name': 'local_delivery', 'comment': 'Deliver to user mailbox', 'driver': 'appendfile', 'file_path': '/var/mail/$domain/$local_part', 'append': True, 'delivery_date_add': True, 'envelope_to_add': True, 'file_mode': '0660', 'file_owner': 'Debian-exim', 'file_group': 'mail'}, {'name': 'remote_smtp', 'comment': 'Deliver via SMTP to remote hosts', 'driver': 'smtp', 'max_parallel': '2', 'return_path': '${if def:sender_address{$sender_address}{}{$original_sender_address}}'}]) %}
# Transport: {{ transport.name | default('unnamed') }}
# Comment: {{ transport.comment | default('No comment') }}
{{ transport.name | default('unnamed') }}:
  driver = {{ transport.driver | default('appendfile') }}
  {% if transport.file_path is defined %}
  file_path = {{ transport.file_path }}
  {% endif %}
  {% if transport.append is defined %}
  append = {{ 'yes' if transport.append else 'no' }}
  {% endif %}
  {% if transport.file_mode is defined %}
  file_mode = {{ transport.file_mode }}
  {% endif %}
  {% if transport.file_owner is defined %}
  file_owner = {{ transport.file_owner }}
  {% endif %}
  {% if transport.file_group is defined %}
  file_group = {{ transport.file_group }}
  {% endif %}
  {% if transport.delivery_date_add is defined %}
  delivery_date_add = {{ 'yes' if transport.delivery_date_add else 'no' }}
  {% endif %}
  {% if transport.envelope_to_add is defined %}
  envelope_to_add = {{ 'yes' if transport.envelope_to_add else 'no' }}
  {% endif %}
  {% if transport.headers_add is defined %}
  headers_add = {{ transport.headers_add }}
  {% endif %}
  {% if transport.local_part_suffix is defined %}
  local_part_suffix = {{ transport.local_part_suffix }}
  {% endif %}
  {% if transport.local_part_suffix_same_case is defined %}
  local_part_suffix_same_case = {{ 'yes' if transport.local_part_suffix_same_case else 'no' }}
  {% endif %}
  {% if transport.return_path_add is defined %}
  return_path_add = {{ 'yes' if transport.return_path_add else 'no' }}
  {% endif %}
  {% if transport.to_file is defined %}
  to_file = {{ 'yes' if transport.to_file else 'no' }}
  {% endif %}
  {% if transport.transport_address_data is defined %}
  transport_address_data = {{ transport.transport_address_data }}
  {% endif %}
  {% if transport.unseen is defined %}
  unseen = {{ 'yes' if transport.unseen else 'no' }}
  {% endif %}
  {% if transport.max_parallel is defined %}
  max_parallel = {{ transport.max_parallel }}
  {% endif %}
  {% if transport.return_path is defined %}
  return_path = {{ transport.return_path }}
  {% endif %}

{% endfor %}

# --- ACLs (Access Control Lists) ---
# Inbound ACLs (Access Control Lists) applied to SMTP connections and messages.
# Each ACL is a list of statements.
# These are placed under 'begin acl' section.
{% for acl in inbound_acls | default([{'name': 'acl_inbound', 'comment': 'Basic inbound ACL — reject spam and viruses', 'statement': 'deny\n  message = This system is not configured to receive mail\n  !condition = ${if eq {$domain} {localhost} {no}{yes}}\n\n  # Reject messages from known bad IPs\n  deny\n    hosts = /etc/exim4/blacklist\n    message = Your host is blacklisted\n\n  # Reject oversized messages\n  deny\n    message = Message size exceeds maximum of 25 MB\n    condition = ${if > {$message_size}{25M}{yes}{no}}\n\n  accept'}]) %}
# ACL: {{ acl.name | default('unnamed') }}
# Comment: {{ acl.comment | default('No comment') }}
{{ acl.name | default('unnamed') }}:
  {% if acl.statement is defined %}
  {# Output the ACL statement lines, indented properly. #}
  {# The statement is a multi-line string with indentation. #}
  {{ acl.statement | indent(2) }}
  {% endif %}

{% endfor %}

# --- Macros ---
# Global macros for common values (avoid hardcoding paths, domain lists, etc.).
{% for macro in macros | default([{'name': 'LOCAL_DOMAINS', 'value': 'example.com:localhost'}, {'name': 'RELAY_DOMAINS', 'value': 'internal.example.com'}, {'name': 'MAIL_GID', 'value': 'mail'}, {'name': 'MAILDIR_OVERSIZE', 'value': 'true'}]) %}
# Macro: {{ macro.name }} = {{ macro.value }}
# Name: {{ macro.name | default('unnamed') }}
# Value: {{ macro.value | default('') }}
{{ macro.name | default('unnamed') }} = {{ macro.value | default('') }}
{% endfor %}

# --- Split Configuration Includes ---
# Use split configuration files (recommended for Debian/Ubuntu exim4-config).
# If false, all config is in this single file.
{% if split_config | default(true) | bool %}
# Split configuration mode: including external config files.
.include if exists /etc/exim4/conf.d/main/01_exim4-config_listmacros
.include if exists /etc/exim4/conf.d/main/00_exim4-config_options
.include if exists /etc/exim4/conf.d/router/000_exim4-config_listmacros
.include if exists /etc/exim4/conf.d/router/010_exim4-config_listmacros
.include if exists /etc/exim4/conf.d/transport/000_exim4-config_listmacros
.include if exists /etc/exim4/conf.d/transport/010_exim4-config_listmacros
{% else %}
# Monolithic configuration mode: all settings are in this file.
{% endif %}