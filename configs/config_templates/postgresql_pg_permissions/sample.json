{
  "audit_enabled": true,
  "log_directory": "/var/log/pg_permissions",
  "max_log_file_size": 100,
  "retained_log_files": 5,
  "conn_host": "localhost",
  "conn_port": 5432,
  "conn_database": "postgres",
  "conn_user": "pg_permissions_audit",
  "conn_sslmode": "prefer",
  "include_schemas": [
    "public",
    "app_data"
  ],
  "audit_rules": [
    {
      "schema": "public",
      "table": "users",
      "enabled": true,
      "audit_mode": "ALL"
    },
    {
      "schema": "app_data",
      "table": "secrets",
      "enabled": true,
      "audit_mode": "SELECT"
    },
    {
      "schema": "public",
      "table": "logs",
      "enabled": false,
      "audit_mode": "ALL"
    }
  ],
  "email_notifications": true,
  "email_recipients": [
    "dba@example.com",
    "security@example.com"
  ],
  "webhook_urls": [
    "https://hooks.slack.com/services/xxx/yyy/zzz"
  ]
}
