{
  "scorethreshold": {
    "type": "number",
    "default": 1.5,
    "description": "Threshold for final score that discriminates between Goodquottel and Fullquottel"
  },
  "quotechars": {
    "type": "string",
    "default": ">|#",
    "description": "Chars used for quoting"
  },
  "debug": {
    "type": "number",
    "default": 0,
    "description": "Debug option: 1 (on), 0 (off)"
  },
  "ownsigtest": {
    "type": "number",
    "default": 1,
    "description": "Turn on/off ownSigTest: 1 (on), 0 (off)"
  },
  "ownsigtestscore": {
    "type": "number",
    "default": 1.0,
    "description": "Score for ownSigTest"
  },
  "ownsigtestfile": {
    "type": "string",
    "default": "~/.signature",
    "description": "Signature file to test against"
  },
  "mstest": {
    "type": "number",
    "default": 1,
    "description": "Turn on/off msTest: 1 (on), 0 (off)"
  },
  "mstestscore": {
    "type": "number",
    "default": 1.0,
    "description": "Score for msTest"
  },
  "mstestthreshold": {
    "type": "number",
    "default": 2,
    "description": "Threshold for msTest (at or below which line a Microsoft attribution line is found)"
  },
  "quotedtoalltest": {
    "type": "number",
    "default": 1,
    "description": "Turn on/off quotedToAllTest: 1 (on), 0 (off)"
  },
  "quotedtoalltestscore": {
    "type": "number",
    "default": 1.0,
    "description": "Score for quotedToAllTest"
  },
  "quotedtoalltestfactor": {
    "type": "number",
    "default": 0,
    "description": "Factor for quotedToAllTest"
  },
  "quotedtoalltestthreshold": {
    "type": "number",
    "default": 0.5,
    "description": "Ratio threshold for activating quotedToAllTest"
  },
  "bottomquotedtoalltest": {
    "type": "number",
    "default": 1,
    "description": "Turn on/off bottomQuotedToAllTest: 1 (on), 0 (off)"
  },
  "bottomquotedtoalltestscore": {
    "type": "number",
    "default": 1.0,
    "description": "Score for bottomQuotedToAllTest"
  },
  "bottomquotedtoalltestfactor": {
    "type": "number",
    "default": 0,
    "description": "Factor for bottomQuotedToAllTest"
  },
  "bottomquotedtoalltestthreshold": {
    "type": "number",
    "default": 0.5,
    "description": "Ratio threshold for activating bottomQuotedToAllTest"
  },
  "bottomquotedtoquotedtest": {
    "type": "number",
    "default": 1,
    "description": "Turn on/off bottomQuotedToQuotedTest: 1 (on), 0 (off)"
  },
  "bottomquotedtoquotedtestscore": {
    "type": "number",
    "default": 1.0,
    "description": "Score for bottomQuotedToQuotedTest"
  },
  "bottomquotedtoquotedtestfactor": {
    "type": "number",
    "default": 0,
    "description": "Factor for bottomQuotedToQuotedTest"
  },
  "bottomquotedtoquotedtestthreshold": {
    "type": "number",
    "default": 0.5,
    "description": "Ratio threshold for activating bottomQuotedToQuotedTest"
  },
  "singlebottomquotetest": {
    "type": "number",
    "default": 1,
    "description": "Turn on/off singleBottomQuoteTest: 1 (on), 0 (off)"
  },
  "singlebottomquotetestscore": {
    "type": "number",
    "default": 1.0,
    "description": "Score for singleBottomQuoteTest"
  },
  "addattributionlines": {
    "type": "bool",
    "default": true,
    "description": "Add additional attribution lines for 'mstest'"
  },
  "attributionlines": {
    "type": "list",
    "default": [
      "-----Urspr\u00fcngliche Nachricht-----",
      "-----Original Message-----",
      "----- Urspr\u00fcngliche Nachricht -----",
      "----- Original Message -----"
    ],
    "description": "Additional attribution lines for 'mstest'"
  }
}
