# vboot-utils configuration file
#
# This file configures the Verity Boot (vboot) utilities, used to verify
# the boot chain integrity on Chrome OS and derivative systems.

# Force developer debug mode for vboot-utils.
# When enabled, this bypasses standard boot verification checks, allowing
# unsigned kernels or modified bootloaders to execute. Use with caution
# on production devices.
# Default: False
DEV_DEBUG_FORCE={{ dev_debug_force | default(false) | lower }}