# vboot-utils configuration
# Manages developer/debug mode settings for the Verified Boot utilities.

# Force developer debug mode for vboot-utils.
# When enabled, the vboot utilities may operate in a mode that bypasses certain
# security checks or provides verbose output for debugging boot verification
# processes. Default is disabled (False).
# Type: boolean
DEV_DEBUG_FORCE={{ dev_debug_force | default(False) | lower }}
