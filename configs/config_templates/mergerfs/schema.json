{
  "branches": {
    "type": "list",
    "default": [
      "/mnt/drive1",
      "/mnt/drive2"
    ],
    "description": "Colon-delimited list of branch paths to pool."
  },
  "minfreespace": {
    "type": "string",
    "default": "4G",
    "description": "Minimum free space value (e.g., 4G, 100M) used for creation policies."
  },
  "moveonenospc": {
    "type": "string",
    "default": "false",
    "description": "Move file on no space. false, true (alias mfs), or policy name.",
    "enum": [
      "false",
      "true",
      "mfs"
    ]
  },
  "inodecalc": {
    "type": "string",
    "default": "hybrid-hash",
    "description": "Inode calculation algorithm: passthrough, path-hash, devino-hash, hybrid-hash.",
    "enum": [
      "passthrough",
      "path-hash",
      "path-hash32",
      "devino-hash",
      "devino-hash32",
      "hybrid-hash",
      "hybrid-hash32"
    ]
  },
  "dropcacheonclose": {
    "type": "bool",
    "default": true,
    "description": "Drop kernel cache on close. Recommended when caching is enabled."
  },
  "symlinkify_timeout": {
    "type": "number",
    "default": 3600,
    "description": "Time in seconds to wait before symlinkifying non-writable files."
  },
  "symlinkify": {
    "type": "bool",
    "default": false,
    "description": "Enable symlinkify behavior."
  },
  "nullrw": {
    "type": "bool",
    "default": false,
    "description": "Turns reads and writes into no-ops."
  },
  "lazy_umount_mountpoint": {
    "type": "bool",
    "default": false,
    "description": "Attempt lazy umount of mountpoint before mounting."
  },
  "ignorepponrename": {
    "type": "bool",
    "default": false,
    "description": "Ignore path preservation on rename."
  },
  "export_support": {
    "type": "bool",
    "default": true,
    "description": "Sets low-level FUSE feature for NFS export support."
  },
  "security_capability": {
    "type": "bool",
    "default": true,
    "description": "Return ENOATTR for security.capability if false."
  },
  "xattr": {
    "type": "string",
    "default": "passthrough",
    "description": "Runtime control of xattrs: passthrough, noattr, nosys.",
    "enum": [
      "passthrough",
      "noattr",
      "nosys"
    ]
  },
  "link_cow": {
    "type": "bool",
    "default": false,
    "description": "Copy-on-write for hardlinks."
  },
  "statfs": {
    "type": "string",
    "default": "base",
    "description": "Statfs mode: base or full.",
    "enum": [
      "base",
      "full"
    ]
  },
  "statfs_ignore": {
    "type": "string",
    "default": "none",
    "description": "Statfs ignore mode: none, ro, nc.",
    "enum": [
      "none",
      "ro",
      "nc"
    ]
  },
  "nfsopenhack": {
    "type": "string",
    "default": "off",
    "description": "NFS open hack: off, git, all.",
    "enum": [
      "off",
      "git",
      "all"
    ]
  },
  "branches_mount_timeout": {
    "type": "number",
    "default": 0,
    "description": "Seconds to wait for branches to mount at startup."
  },
  "follow_symlinks": {
    "type": "string",
    "default": "never",
    "description": "Follow symlinks strategy: never, directory, regular, all.",
    "enum": [
      "never",
      "directory",
      "regular",
      "all"
    ]
  },
  "link_exdev": {
    "type": "string",
    "default": "passthrough",
    "description": "Link EXDEV handling: passthrough, rel-symlink, abs-base-symlink, abs-pool-symlink.",
    "enum": [
      "passthrough",
      "rel-symlink",
      "abs-base-symlink",
      "abs-pool-symlink"
    ]
  },
  "rename_exdev": {
    "type": "string",
    "default": "passthrough",
    "description": "Rename EXDEV handling: passthrough, rel-symlink, abs-symlink.",
    "enum": [
      "passthrough",
      "rel-symlink",
      "abs-symlink"
    ]
  },
  "readahead": {
    "type": "number",
    "default": 0,
    "description": "Readahead in kilobytes."
  },
  "posix_acl": {
    "type": "bool",
    "default": false,
    "description": "Enable POSIX ACL support."
  },
  "async_read": {
    "type": "bool",
    "default": true,
    "description": "Perform reads asynchronously."
  },
  "fuse_msg_size": {
    "type": "number",
    "default": 256,
    "description": "Max pages per FUSE message (1-256)."
  },
  "threads": {
    "type": "number",
    "default": 0,
    "description": "Number of threads (0=auto)."
  },
  "flush_on_close": {
    "type": "string",
    "default": "opened-for-write",
    "description": "Flush on close strategy: never, always, opened-for-write.",
    "enum": [
      "never",
      "always",
      "opened-for-write"
    ]
  },
  "scheduling_priority": {
    "type": "number",
    "default": -10,
    "description": "Scheduling priority (-20 to 19)."
  },
  "fsname": {
    "type": "string",
    "default": "",
    "description": "Filesystem name string."
  },
  "func_getattr": {
    "type": "string",
    "default": "",
    "description": "Policy for getattr function (e.g., newest, ff). Empty for default."
  },
  "func_readdir": {
    "type": "string",
    "default": "seq",
    "description": "Readdir policy: seq, cosr, cor, or cor:N.",
    "enum": [
      "seq",
      "cosr",
      "cor"
    ]
  },
  "category_action": {
    "type": "string",
    "default": "epall",
    "description": "Policy for action category.",
    "enum": [
      "epall",
      "all",
      "epff",
      "epall",
      "ff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff",
      "epff"
    ]
  },
  "category_create": {
    "type": "string",
    "default": "epmfs",
    "description": "Policy for create category.",
    "enum": [
      "epmfs",
      "mfs",
      "epff",
      "ff",
      "rand",
      "epall",
      "epmfs",
      "epff",
      "ff",
      "rand",
      "epall",
      "epmfs",
      "epff",
      "ff",
      "rand",
      "epall",
      "epmfs",
      "epff",
      "ff",
      "rand",
      "epall",
      "epmfs",
      "epff",
      "ff",
      "rand"
    ]
  },
  "category_search": {
    "type": "string",
    "default": "ff",
    "description": "Policy for search category.",
    "enum": [
      "ff",
      "newest",
      "epall",
      "all",
      "epff",
      "ff",
      "rand",
      "epall",
      "ff",
      "rand"
    ]
  },
  "cache_open": {
    "type": "number",
    "default": 0,
    "description": "Open policy cache timeout in seconds."
  },
  "cache_statfs": {
    "type": "number",
    "default": 0,
    "description": "Statfs cache timeout in seconds."
  },
  "cache_attr": {
    "type": "number",
    "default": 1,
    "description": "File attribute cache timeout in seconds."
  },
  "cache_entry": {
    "type": "number",
    "default": 1,
    "description": "File name lookup cache timeout in seconds."
  },
  "cache_negative_entry": {
    "type": "number",
    "default": 0,
    "description": "Negative file name lookup cache timeout in seconds."
  },
  "cache_files": {
    "type": "string",
    "default": "off",
    "description": "File page caching mode: libfuse, off, partial, full, auto-full, per-process.",
    "enum": [
      "off",
      "partial",
      "full",
      "auto-full",
      "libfuse",
      "per-process"
    ]
  },
  "cache_files_process_names": {
    "type": "list",
    "default": [
      "rtorrent",
      "qbittorrent-nox"
    ],
    "description": "List of process names for per-process caching."
  },
  "cache_writeback": {
    "type": "bool",
    "default": false,
    "description": "Enable kernel writeback caching."
  },
  "cache_symlinks": {
    "type": "bool",
    "default": false,
    "description": "Cache symlinks."
  },
  "cache_readdir": {
    "type": "bool",
    "default": false,
    "description": "Cache readdir."
  },
  "parallel_direct_writes": {
    "type": "bool",
    "default": false,
    "description": "Allow parallel direct writes."
  }
}
