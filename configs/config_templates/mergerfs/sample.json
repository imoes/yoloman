{
  "branches": [
    "/mnt/hdd0",
    "/mnt/hdd1"
  ],
  "minfreespace": "16G",
  "moveonenospc": "false",
  "inodecalc": "hybrid-hash",
  "dropcacheonclose": true,
  "symlinkify_timeout": 3600,
  "symlinkify": false,
  "nullrw": false,
  "lazy_umount_mountpoint": false,
  "ignorepponrename": false,
  "export_support": true,
  "security_capability": true,
  "xattr": "passthrough",
  "link_cow": false,
  "statfs": "base",
  "statfs_ignore": "none",
  "nfsopenhack": "off",
  "branches_mount_timeout": 0,
  "follow_symlinks": "never",
  "link_exdev": "passthrough",
  "rename_exdev": "passthrough",
  "readahead": 0,
  "posix_acl": false,
  "async_read": true,
  "fuse_msg_size": 256,
  "threads": 0,
  "flush_on_close": "opened-for-write",
  "scheduling_priority": -10,
  "fsname": "",
  "func_getattr": "newest",
  "func_readdir": "seq",
  "category_action": "epall",
  "category_create": "epmfs",
  "category_search": "ff",
  "cache_open": 0,
  "cache_statfs": 0,
  "cache_attr": 1,
  "cache_entry": 1,
  "cache_negative_entry": 0,
  "cache_files": "partial",
  "cache_files_process_names": [
    "rtorrent",
    "qbittorrent-nox"
  ],
  "cache_writeback": false,
  "cache_symlinks": false,
  "cache_readdir": false,
  "parallel_direct_writes": false
}
