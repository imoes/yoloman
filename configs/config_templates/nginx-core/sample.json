{
  "error_log": "/var/log/nginx/error.log warn",
  "worker_processes": "auto",
  "worker_cpu_affinity": [
    "0001",
    "0010"
  ],
  "debug_mode": false,
  "worker_connections": 1024,
  "use_epoll": true,
  "use_kqueue": false,
  "log_format_main": "$remote_addr - $remote_user [$time_local] \"$request\" $status $body_bytes_sent \"$http_referer\" \"$http_user_agent\" \"$http_x_forwarded_for\"",
  "access_log": "/var/log/nginx/access.log",
  "sendfile": true,
  "tcp_nopush": true,
  "tcp_nodelay": true,
  "keepalive_timeout": 65,
  "keepalive_requests": 1000,
  "client_max_body_size": "10m",
  "enable_gzip": true,
  "gzip_comp_level": 4,
  "gzip_min_length": 256,
  "gzip_types": [
    "text/plain",
    "text/css",
    "application/json",
    "application/javascript",
    "text/xml",
    "application/xml"
  ],
  "sites": [
    {
      "name": "api-backend",
      "description": "Public-facing API proxy",
      "include_path": "/etc/nginx/sites-enabled/api.conf"
    },
    {
      "name": "static-assets",
      "description": "Static file serving for frontend",
      "include_path": "/etc/nginx/sites-enabled/static.conf"
    }
  ],
  "upstreams": [
    {
      "name": "api_upstream",
      "description": "Application API servers",
      "servers": [
        {
          "address": "127.0.0.1",
          "port": 8080
        },
        {
          "address": "127.0.0.1",
          "port": 8081,
          "weight": 2
        },
        {
          "address": "10.0.0.5",
          "port": 8080,
          "backup": true
        }
      ]
    },
    {
      "name": "static_upstream",
      "description": "Static assets from local disk",
      "servers": [
        {
          "address": "127.0.0.1",
          "port": 9000
        }
      ]
    }
  ],
  "proxy_cache_paths": [
    {
      "name": "api_cache",
      "description": "Cache for API responses (10 min TTL)",
      "path": "/var/cache/nginx/api",
      "levels": "1:2",
      "keys_size": "10m",
      "max_size": "500m",
      "inactive": "10m",
      "use_temp_path": false
    }
  ]
}
