{
  "services": [
    {
      "name": "api-gateway",
      "host": "10.0.1.10",
      "port": 8081
    },
    {
      "name": "user-service",
      "host": "10.0.1.11",
      "port": 8082
    }
  ],
  "server": {
    "bind_address": "127.0.0.1",
    "bind_port": 8000,
    "timeout": 45,
    "max_connections": 512,
    "tls_enabled": true,
    "cert_file": "/etc/ident2/tls/server.crt",
    "key_file": "/etc/ident2/tls/server.key"
  },
  "log": {
    "level": "warn",
    "file": "/var/log/ident2/ident2.log",
    "rotate_daily": true
  }
}
