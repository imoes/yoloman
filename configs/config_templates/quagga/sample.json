{
  "interfaces": [
    {
      "name": "eth0",
      "type": "eth",
      "mtu": 1500
    },
    {
      "name": "eth1",
      "type": "eth"
    },
    {
      "name": "lo",
      "type": "loopback",
      "mtu": 65536
    }
  ],
  "loopback": true,
  "logging": {
    "destinations": {
      "log_file": "/var/log/quagga/zebra.log"
    },
    "level": "info"
  },
  "router_id": "192.0.2.1",
  "hostname": "router1.example.com",
  "redistribute": [
    {
      "type": "kernel",
      "metric": 20
    },
    {
      "type": "static",
      "route_map": "RM-STATIC-IN"
    },
    {
      "type": "connected"
    }
  ],
  "passwords": {
    "enable": "secret123",
    "vty": "vtyuser"
  },
  "vty_access": [
    {
      "hosts": [
        "127.0.0.1",
        "192.0.2.0/24"
      ]
    }
  ],
  "zebra_options": [
    "ipv6 unicast-routing",
    "no ip forward"
  ]
}
