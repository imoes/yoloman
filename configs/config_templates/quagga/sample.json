{
 "hostname": "router1.example.com",
 "interfaces": [
  {
   "mtu": 1500,
   "name": "eth0",
   "type": "eth"
  },
  {
   "name": "eth1",
   "type": "eth"
  },
  {
   "mtu": 65536,
   "name": "lo",
   "type": "loopback"
  }
 ],
 "logging": {
  "destinations": {
   "log_file": "/var/log/quagga/zebra.log"
  },
  "level": "info"
 },
 "loopback": true,
 "passwords": {
  "enable": "secret123",
  "vty": "vtyuser"
 },
 "redistribute": [
  {
   "metric": 20,
   "type": "kernel"
  },
  {
   "route_map": "RM-STATIC-IN",
   "type": "static"
  },
  {
   "type": "connected"
  }
 ],
 "router_id": "192.0.2.1",
 "vty_access": [
  {
   "hosts": [
    "127.0.0.1",
    "192.0.2.0/24"
   ]
  }
 ],
 "zebra_options": [
  "ipv6 unicast-routing",
  "no ip forward"
 ]
}
