{
 "server": {
  "auth": {
   "ldap": {
    "base_dn": "ou=People,dc=university,dc=edu",
    "bind_dn": "cn=gobby-service,ou=services,dc=university,dc=edu",
    "bind_password": "REPLACE_WITH_SECURE_SECRET",
    "filter": "(uid=%s)",
    "url": "ldap://ldap.university.edu:389",
    "user_attribute": "uid"
   },
   "method": "ldap",
   "password_file": "/etc/gobby-0.5/passwords"
  },
  "groups": [
   {
    "description": "Collaboration space for Mathematics Department",
    "members": [
     "drsmith",
     "jdoe",
     "proflee"
    ],
    "name": "math-faculty"
   },
   {
    "description": "CS capstone project workspace",
    "members": [
     "alice",
     "bob",
     "charlie"
    ],
    "name": "cs-project"
   }
  ],
  "hostname": "gobby.cs.university.edu",
  "listen_address": "0.0.0.0",
  "log_file": "/var/log/gobby-0.5/server.log",
  "log_level": "info",
  "max_connections": 100,
  "max_doc_size": 52428800,
  "persistent_storage": {
   "enabled": true,
   "path": "/var/lib/gobby-0.5/documents"
  },
  "port": 5222,
  "session_timeout": 1800,
  "ssl": {
   "certificate_path": "/etc/ssl/certs/gobby.crt",
   "enabled": true,
   "key_path": "/etc/ssl/private/gobby.key"
  },
  "websocket": {
   "enabled": true,
   "path": "/gobby"
  }
 }
}
