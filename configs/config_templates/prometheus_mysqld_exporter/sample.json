{
  "my_cnf_path": "/etc/mysql/.my.cnf",
  "user": "prometheus",
  "password": "secret123",
  "listen_address": "0.0.0.0:9104",
  "disable_collectors": [
    "slave_status",
    "user"
  ],
  "enable_collectors": [],
  "tls_cert_file": "/etc/ssl/mysqld_exporter.crt",
  "tls_key_file": "/etc/ssl/mysqld_exporter.key",
  "extra_args": [
    "--no-collect.info_schema.tables",
    "--no-collect.auto_increment.columns"
  ],
  "log_level": "warn",
  "scrape_timeout": 20,
  "disable_native_metrics": true
}
