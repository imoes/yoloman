# Path environment for the atop cron job.
PATH=/bin:/usr/bin:/sbin:/usr/sbin

# Cron schedule expression for the daily restart of atop.
# See the cron_schedule variable for the expression.
# daily restart of atop at {{ cron_schedule | default('0 0 * * *') }}
{{ cron_schedule | default('0 0 * * *') }} root [ -d "/run/systemd/system" ] || /usr/share/atop/atop.daily&