{
 "commands": [
  {
   "description": "Enable DPDK in global open_vswitch config",
   "key": "dpdk_init",
   "target": "open_vswitch .",
   "type": "set",
   "value": "true"
  },
  {
   "description": "Set DPDK socket memory",
   "key": "dpdk_socket_mem",
   "target": "open_vswitch .",
   "type": "set",
   "value": "1024,1024"
  },
  {
   "description": "Set DPDK lcore mask",
   "key": "dpdk_lcore_mask",
   "target": "open_vswitch .",
   "type": "set",
   "value": "0x3"
  },
  {
   "description": "Set DPDK PMD core mask",
   "key": "dpdk_pmd_core_mask",
   "target": "open_vswitch .",
   "type": "set",
   "value": "0xc"
  },
  {
   "description": "Set hugepage path",
   "key": "dpdk_hugepages",
   "target": "open_vswitch .",
   "type": "set",
   "value": "/mnt/hugepages_2mb"
  },
  {
   "description": "Create br0 bridge",
   "key": "name",
   "row": "Bridge",
   "target": "Bridge br0",
   "type": "create",
   "value": "br0"
  },
  {
   "collection": "ports",
   "description": "Add dpdk0 port to br0",
   "key": "name",
   "row": "Port",
   "target": "Bridge br0",
   "type": "add",
   "value": "dpdk0"
  },
  {
   "description": "Configure dpdk0 interface with dpdk driver",
   "key": "type",
   "row": "Interface",
   "target": "Interface dpdk0",
   "type": "create",
   "value": "dpdk"
  },
  {
   "collection": "interfaces",
   "description": "Attach dpdk0 interface to port",
   "key": "name",
   "row": "Interface",
   "target": "Port dpdk0",
   "type": "add",
   "value": "dpdk0"
  },
  {
   "collection": "ports",
   "description": "Add dpdk1 port to br0",
   "key": "name",
   "row": "Port",
   "target": "Bridge br0",
   "type": "add",
   "value": "dpdk1"
  },
  {
   "description": "Configure dpdk1 interface with dpdk driver",
   "key": "type",
   "row": "Interface",
   "target": "Interface dpdk1",
   "type": "create",
   "value": "dpdk"
  },
  {
   "collection": "interfaces",
   "description": "Attach dpdk1 interface to port",
   "key": "name",
   "row": "Interface",
   "target": "Port dpdk1",
   "type": "add",
   "value": "dpdk1"
  },
  {
   "description": "Set external system-id",
   "key": "system-id",
   "type": "set-external-id",
   "value": "host01"
  },
  {
   "description": "Set external hostname",
   "key": "hostname",
   "type": "set-external-id",
   "value": "node1.example.com"
  }
 ],
 "dpdk_hugepages": "/mnt/hugepages_2mb",
 "dpdk_initialized": true,
 "dpdk_lcore_mask": "0x3",
 "dpdk_mempool_size": 65536,
 "dpdk_nics": [
  {
   "interface_name": "dpdk0",
   "pci_addr": "0000:01:00.0"
  },
  {
   "interface_name": "dpdk1",
   "pci_addr": "0000:01:00.1"
  }
 ],
 "dpdk_pmd_core_mask": "0xc",
 "dpdk_rss_hash_functions": "toeplitz,ipv4,ipv4-tcp,ipv4-udp",
 "dpdk_rx_desc": 1024,
 "dpdk_rx_queues": 2,
 "dpdk_socket_mem": "1024,1024",
 "dpdk_tx_desc": 1024,
 "dpdk_tx_queues": 2,
 "external_ids": {
  "hostname": "node1.example.com",
  "system-id": "host01"
 },
 "ovs_bridge_name": "br0",
 "ovs_bridge_type": "system"
}
