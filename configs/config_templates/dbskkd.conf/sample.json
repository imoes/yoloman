{
  "listen_address": "127.0.0.1",
  "listen_port": 9389,
  "db_path": "/var/lib/dbskkd-cdb/main",
  "max_connections": 200,
  "worker_threads": 8,
  "enable_compression": true,
  "cache_size_mb": 512,
  "log_level": "warn",
  "log_file": "/var/log/dbskkd-cdb/service.log",
  "auth_method": "password",
  "password_file": "/etc/dbskkd-cdb/users.pass",
  "tls_cert": "",
  "tls_key": "",
  "access_rules": [
    {
      "network": "192.168.1.0",
      "prefix_length": 24,
      "description": "Internal LAN subnet"
    },
    {
      "network": "10.0.0.5",
      "prefix_length": 32,
      "description": "Backup monitoring host"
    }
  ],
  "idle_timeout_sec": 600,
  "query_timeout_sec": 30
}
