# GNUnet configuration file
# This file configures the GNUnet framework, specifically the ARM (Automatic Reloading Manager)
# and base directory paths.

# GNUnet base directory
# Base GNUnet home directory.
# @default /var/lib/gnunet/
[path]
GNUNET_HOME = {{ gnunet_home | default('/var/lib/gnunet/') }}

# GNUnet data directory
# GNUnet data directory.
# @default /var/lib/gnunet/data/
GNUNET_DATA_HOME = {{ gnunet_data_home | default('/var/lib/gnunet/data/') }}

# GNUnet runtime directory
# Fixed runtime directory for sockets and PID files.
GNUNET_RUNTIME_DIR = /var/run/gnunet/

[arm]
# ARM (Automatic Reloading Manager) section

# START_SYSTEM_SERVICES
# Whether ARM should start system services.
# @default YES
START_SYSTEM_SERVICES = {{ arm_start_system_services | default('YES') }}

# START_USER_SERVICES
# Whether ARM should start user services.
# @default NO
START_USER_SERVICES = {{ arm_start_user_services | default('NO') }}

# OPTIONS
# Additional options passed to the ARM daemon.
# Path to the GNUnet log file used by ARM.
# @default /var/log/gnunet.log
OPTIONS = -l {{ gnunet_log_path | default('/var/log/gnunet.log') }}