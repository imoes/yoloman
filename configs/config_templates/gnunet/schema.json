{
  "paths": {
    "type": "object",
    "default": {
      "gnunet_prefix": "/usr",
      "gnunet_home": "/var/lib/gnunet"
    },
    "description": "Base paths for GNUnet installation and runtime data.",
    "items": {
      "gnunet_prefix": {
        "type": "string",
        "description": "Installation prefix (e.g., /usr, /opt/gnunet)."
      },
      "gnunet_home": {
        "type": "string",
        "description": "Home directory for GNUnet runtime files (user data, config, logs)."
      }
    }
  },
  "peerinfo": {
    "type": "object",
    "default": {
      "uri": "gnunet://peerinfo/default",
      "nat_address": ""
    },
    "description": "How the peer presents itself to the network.",
    "items": {
      "uri": {
        "type": "string",
        "description": "Peer URI used for discovery and bootstrap. Must be unique per peer."
      },
      "nat_address": {
        "type": "string",
        "description": "Public IP/hostname to advertise for inbound connections. Leave empty for auto-detect."
      }
    }
  },
  "transport": {
    "type": "object",
    "default": {
      "plugins": [
        "tcp",
        "udp"
      ],
      "listen_address": "0.0.0.0",
      "max_connections": 100,
      "idle_timeout": 300
    },
    "description": "Network transport configuration.",
    "items": {
      "plugins": {
        "type": "list",
        "items": {
          "type": "string",
          "enum": [
            "tcp",
            "udp",
            "http",
            "https",
            "websocket",
            "nat",
            "bt"
          ]
        },
        "default": [
          "tcp",
          "udp"
        ],
        "description": "Enabled transport modules."
      },
      "listen_address": {
        "type": "string",
        "description": "IP address to bind transport listeners (e.g., 0.0.0.0, 127.0.0.1)."
      },
      "max_connections": {
        "type": "number",
        "description": "Maximum concurrent connections per transport."
      },
      "idle_timeout": {
        "type": "number",
        "description": "Seconds before closing idle connections."
      }
    }
  },
  "ats": {
    "type": "object",
    "default": {
      "enabled": true,
      "outbound_quota": 0,
      "inbound_quota": 0,
      "latency_weight": 0.5
    },
    "description": "Automatic Traffic Shaping (ATS) settings.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable bandwidth management and path selection optimization."
      },
      "outbound_quota": {
        "type": "number",
        "description": "Maximum outbound bandwidth (bytes/sec). 0 = no limit."
      },
      "inbound_quota": {
        "type": "number",
        "description": "Maximum inbound bandwidth (bytes/sec). 0 = no limit."
      },
      "latency_weight": {
        "type": "number",
        "description": "Relative importance of latency vs. throughput in routing (0.0\u20131.0)."
      }
    }
  },
  "dht": {
    "type": "object",
    "default": {
      "enabled": true,
      "replication": 5,
      "cache_size": 1000,
      "fanout": 3
    },
    "description": "Distributed Hash Table service for key-value lookup.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable DHT service for decentralized lookup."
      },
      "replication": {
        "type": "number",
        "description": "Number of peers to store each DHT key/value (higher = more redundancy)."
      },
      "cache_size": {
        "type": "number",
        "description": "Maximum local DHT entries to cache."
      },
      "fanout": {
        "type": "number",
        "description": "Number of peers to query during a DHT lookup."
      }
    }
  },
  "nse": {
    "type": "object",
    "default": {
      "enabled": false,
      "interval": 300
    },
    "description": "Network Size Estimation \u2014 estimates global peer count.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable NSE service."
      },
      "interval": {
        "type": "number",
        "description": "Seconds between network size broadcasts."
      }
    }
  },
  "statistics": {
    "type": "object",
    "default": {
      "enabled": true,
      "unixpath": "/run/gnunet/gnunet-service-statistics.sock"
    },
    "description": "Runtime statistics collection.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable statistics service."
      },
      "unixpath": {
        "type": "string",
        "description": "Unix socket path for local statistics access."
      }
    }
  },
  "vpn": {
    "type": "object",
    "default": {
      "enabled": false,
      "dns_server": "",
      "internal_subnets": [
        "10.1.0.0/16",
        "fd00::/32"
      ]
    },
    "description": "Secure VPN service \u2014 routes traffic over GNUnet overlay.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable VPN forwarding."
      },
      "dns_server": {
        "type": "string",
        "description": "DNS resolver to use for split-DNS (e.g., '127.0.0.1#5300')."
      },
      "internal_subnets": {
        "type": "list",
        "items": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]+$|^([0-9a-fA-F]*:[0-9a-fA-F]*)+/[0-9]+$"
        },
        "description": "IPv4/IPv6 subnets to route through the GNUnet VPN."
      }
    }
  },
  "dns": {
    "type": "object",
    "default": {
      "enabled": true,
      "listen_address": "127.0.0.1",
      "port": 5300
    },
    "description": "GNUnet DNS forwarder (for secure resolution).",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable DNS forwarding service."
      },
      "listen_address": {
        "type": "string",
        "description": "Local address for DNS listener."
      },
      "port": {
        "type": "number",
        "description": "Port for DNS listener."
      }
    }
  },
  "namestore": {
    "type": "object",
    "default": {
      "enabled": true,
      "max_records_per_zone": 100
    },
    "description": "Local storage for identity and zone records.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable namestore service."
      },
      "max_records_per_zone": {
        "type": "number",
        "description": "Maximum records per zone (GNS/GNU name)."
      }
    }
  },
  "gns": {
    "type": "object",
    "default": {
      "enabled": true,
      "ksk_cache_size": 1000,
      "zonefile_ttl": 3600
    },
    "description": "GNU Name System \u2014 decentralized, P2P DNS.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable GNS (GNUnet Name System)."
      },
      "ksk_cache_size": {
        "type": "number",
        "description": "Maximum KSK (key signature records) to cache."
      },
      "zonefile_ttl": {
        "type": "number",
        "description": "Seconds before regenerating zone files."
      }
    }
  },
  "revocation": {
    "type": "object",
    "default": {
      "enabled": false,
      "window": 604800
    },
    "description": "Public key revocation support.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable revocation service."
      },
      "window": {
        "type": "number",
        "description": "Revocation validity window (seconds) \u2014 how far back revocations are honored."
      }
    }
  },
  "consensus": {
    "type": "object",
    "default": {
      "enabled": true,
      "quorum": 3
    },
    "description": "Consensus protocol for distributed coordination (e.g., DHT bootstrap).",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable consensus service."
      },
      "quorum": {
        "type": "number",
        "description": "Minimum peers required to reach consensus."
      }
    }
  },
  "cadet": {
    "type": "object",
    "default": {
      "enabled": true,
      "mtu": 1200
    },
    "description": "CADet \u2014 secure, overlay-based messaging (e.g., for chat, file transfer).",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable CADet secure messaging."
      },
      "mtu": {
        "type": "number",
        "description": "Maximum transmission unit (bytes) for CADet channels."
      }
    }
  },
  "datastore": {
    "type": "object",
    "default": {
      "backend": "sqlite",
      "data_dir": "/var/lib/gnunet/datastore",
      "quota": 0
    },
    "description": "Persistent storage configuration.",
    "items": {
      "backend": {
        "type": "string",
        "enum": [
          "sqlite",
          "postgres",
          "mysql",
          "sqlite3"
        ],
        "description": "Datastore backend engine."
      },
      "data_dir": {
        "type": "string",
        "description": "Directory for data files (SQLite) or DB name (others)."
      },
      "quota": {
        "type": "number",
        "description": "Max storage in bytes. 0 = unlimited."
      }
    }
  },
  "testing": {
    "type": "object",
    "default": {
      "use_testing_topology": false,
      "network_delay": 0
    },
    "description": "Testing-specific overrides \u2014 do NOT use in production.",
    "items": {
      "use_testing_topology": {
        "type": "boolean",
        "description": "Enable simulated test topology (e.g., static peer links)."
      },
      "network_delay": {
        "type": "number",
        "description": "Simulated network delay (ms). Use only for testing."
      }
    }
  },
  "arm": {
    "type": "object",
    "default": {
      "services": [
        "core",
        "dht",
        "nse",
        "vpn",
        "dns",
        "gns"
      ],
      "restart_delay": 5
    },
    "description": "ARM \u2014 service controller configuration.",
    "items": {
      "services": {
        "type": "list",
        "items": {
          "type": "string",
          "enum": [
            "core",
            "dht",
            "nse",
            "vpn",
            "dns",
            "gns",
            "namestore",
            "revocation",
            "consensus",
            "cadet",
            "statistics",
            "resolver"
          ]
        },
        "description": "List of services to auto-start."
      },
      "restart_delay": {
        "type": "number",
        "description": "Seconds to wait before restarting a failed service."
      }
    }
  },
  "resolver": {
    "type": "object",
    "default": {
      "enabled": true
    },
    "description": "Local DNS resolution for GNS names.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable local resolver for GNS lookups."
      }
    }
  },
  "core": {
    "type": "object",
    "default": {
      "enabled": true,
      "private_key": "/var/lib/gnunet/keys/default.priv",
      "peerfile": "/var/lib/gnunet/peerinfo/default.conf"
    },
    "description": "Core service \u2014 manages peer identity and P2P connections.",
    "items": {
      "enabled": {
        "type": "boolean",
        "description": "Enable core service."
      },
      "private_key": {
        "type": "string",
        "description": "Path to peer\u2019s private key file."
      },
      "peerfile": {
        "type": "string",
        "description": "Path to peer\u2019s public identity file."
      }
    }
  }
}
