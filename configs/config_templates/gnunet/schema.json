{
  "gnunet_home": {
    "type": "string",
    "default": "/var/lib/gnunet/",
    "description": "Base GNUnet home directory."
  },
  "gnunet_data_home": {
    "type": "string",
    "default": "/var/lib/gnunet/data/",
    "description": "GNUnet data directory."
  },
  "arm_start_system_services": {
    "type": "string",
    "default": "YES",
    "description": "Whether ARM should start system services.",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "arm_start_user_services": {
    "type": "string",
    "default": "NO",
    "description": "Whether ARM should start user services.",
    "enum": [
      "YES",
      "NO"
    ]
  },
  "gnunet_log_path": {
    "type": "string",
    "default": "/var/log/gnunet.log",
    "description": "Path to the GNUnet log file used by ARM."
  }
}
