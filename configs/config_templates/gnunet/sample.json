{
  "paths": {
    "gnunet_prefix": "/usr",
    "gnunet_home": "/var/lib/gnunet"
  },
  "peerinfo": {
    "uri": "gnunet://peerinfo/a1b2c3d4",
    "nat_address": "203.0.113.42"
  },
  "transport": {
    "plugins": [
      "tcp",
      "udp"
    ],
    "listen_address": "0.0.0.0",
    "max_connections": 100,
    "idle_timeout": 300
  },
  "ats": {
    "enabled": true,
    "outbound_quota": 1048576,
    "inbound_quota": 1048576,
    "latency_weight": 0.25
  },
  "dht": {
    "enabled": true,
    "replication": 5,
    "cache_size": 2000,
    "fanout": 4
  },
  "nse": {
    "enabled": true,
    "interval": 600
  },
  "statistics": {
    "enabled": true,
    "unixpath": "/run/gnunet/gnunet-service-statistics.sock"
  },
  "vpn": {
    "enabled": false,
    "dns_server": "127.0.0.1#5300",
    "internal_subnets": [
      "10.1.0.0/16",
      "fd00:beef::/32"
    ]
  },
  "dns": {
    "enabled": true,
    "listen_address": "127.0.0.1",
    "port": 5300
  },
  "namestore": {
    "enabled": true,
    "max_records_per_zone": 50
  },
  "gns": {
    "enabled": true,
    "ksk_cache_size": 500,
    "zonefile_ttl": 7200
  },
  "revocation": {
    "enabled": true,
    "window": 86400
  },
  "consensus": {
    "enabled": true,
    "quorum": 3
  },
  "cadet": {
    "enabled": true,
    "mtu": 1200
  },
  "datastore": {
    "backend": "sqlite",
    "data_dir": "/var/lib/gnunet/datastore",
    "quota": 0
  },
  "testing": {
    "use_testing_topology": false,
    "network_delay": 0
  },
  "arm": {
    "services": [
      "core",
      "dht",
      "nse",
      "dns",
      "gns"
    ],
    "restart_delay": 5
  },
  "resolver": {
    "enabled": true
  },
  "core": {
    "enabled": true,
    "private_key": "/var/lib/gnunet/keys/default.priv",
    "peerfile": "/var/lib/gnunet/peerinfo/default.conf"
  }
}
