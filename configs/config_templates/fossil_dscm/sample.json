{
  "database_path": "/var/lib/fossil/fossil.db",
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "cgi_path": "/cgi-bin/fossil",
    "ssl": true,
    "ssl_cert": "/etc/ssl/fossil.crt",
    "ssl_key": "/etc/ssl/fossil.key",
    "max_connections": 50,
    "keep_alive_timeout": 30,
    "log_file": "/var/log/fossil/fossil.log",
    "debug": false,
    "url": "https://fossil.example.com/",
    "site_title": "My Team's Fossil Server",
    "custom_header": "<link rel='icon' href='/favicon.ico'>"
  },
  "auth": {
    "enabled": true,
    "anonymous_user": "anonymous",
    "self_register": true
  },
  "features": {
    "wiki": true,
    "tickets": true,
    "graph": true,
    "json_api": true
  },
  "repo_defaults": [
    {
      "name": "allow-wiki",
      "value": "on",
      "description": "Enable wiki editing for project admins"
    },
    {
      "name": "allow-trac",
      "value": "off",
      "description": "Disable TRAC-style URLs"
    }
  ],
  "access_rules": [
    {
      "user": "admin",
      "permission": "admin",
      "project": "*"
    },
    {
      "user": "developer1",
      "permission": "write",
      "project": "project-alpha"
    },
    {
      "user": "developer2",
      "permission": "write",
      "project": "project-beta"
    },
    {
      "user": "anonymous",
      "permission": "read",
      "project": "*"
    }
  ],
  "mail": {
    "smtp_host": "smtp.example.com",
    "smtp_port": 587,
    "smtp_starttls": true,
    "smtp_user": "fossil",
    "smtp_pass": "secret-pass-123",
    "smtp_from": "fossil@example.com"
  }
}
