# Signify Configuration Template
# Generates a .signify file for semi-random signature generation
#
# This template configures the signify utility to produce randomized email signatures.
# It defines an output width, user identity variables, weighted alternates for sign-offs,
# and an optional footer with a website link.
#
# All variables are pulled from the Ansible inventory/hostvars. Defaults are applied
# inline to ensure idempotency and safe rendering even if variables are undefined.

# The desired output width of the generated signature in characters.
# If not provided, defaults to 79 characters (standard terminal width).
% SIGWIDTH={{ sig_width | default(79) }}

# The user's email address, substituted as $email in alternates and footer.
# If not provided, defaults to user@example.com.
% $email={{ email | default('user@example.com') }}

# The user's name, substituted as $name in alternates and footer.
# If not provided, defaults to 'John Doe'.
% $name={{ name | default('John Doe') }}

# Begin the block of random alternates.
# Signify will select one of the subsequent | weight=... blocks based on their weights.
% {

# Alternate 1: Professional closing
# Weight 3: Higher probability of selection (3x more likely than formal).
# Uses the $name variable defined above.
% | weight={{ weight_professional | default(3) }}
Best regards,
$name

# Alternate 2: Casual closing
# Weight 2: Medium probability of selection (2x more likely than formal).
# Uses the $name variable defined above.
% | weight={{ weight_casual | default(2) }}
Cheers,
$name

# Alternate 3: Formal closing
# Weight 1: Base probability.
# Uses the $name variable defined above.
% | weight={{ weight_formal | default(1) }}
Sincerely,
$name

# End of the alternates block.
% }

# Optional Footer / Credits line
# Weight 0.1: Low probability, so it appears occasionally.
# Includes the $email variable and the website URL.
% | weight={{ weight_footer | default(0.1) }}
Generated by signify. Visit {{ website | default('http://www.example.com') }}

# End of the main signature block.
% }