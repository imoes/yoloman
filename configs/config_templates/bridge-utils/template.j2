# ==============================================================================
# /etc/default/bridge-utils
# Configuration for the Linux bridge utilities (bridge-utils package).
# This file is managed by Ansible. Do not edit manually.
# ==============================================================================

# Whether to automatically add ports to a bridge when they are hotplugged.
# If set to 'yes', the bridge will dynamically attach network interfaces that
# are added to the system while the bridge is active.
# Default: False
BRIDGE_HOTPLUG={{ BRIDGE_HOTPLUG | default(False) | lower }}

# Whether to disable link-local IPv6 on physical interfaces of VLAN ports.
# This prevents IPv6 link-local addresses from being assigned to the underlying
# physical interfaces when they are enslaved to a VLAN port, which can reduce
# noise in IPv6 neighbor discovery.
# Default: True
BRIDGE_DISABLE_LINKLOCAL_IPV6_ALSO_PHYS={{ BRIDGE_DISABLE_LINKLOCAL_IPV6_ALSO_PHYS | default(True) | lower }}