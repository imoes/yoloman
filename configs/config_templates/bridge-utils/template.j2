# /etc/default/bridge-utils
#
# This configuration file controls the behavior of the bridge-utils package
# regarding Linux network bridges. It is read by the bridge management scripts
# at startup or during interface events.
#

# Whether to automatically add ports to a bridge when they are hotplugged.
# Set to 'yes' if you want the system to automatically associate physical
# interfaces (like eth0) with a bridge (like br0) upon link-up events.
# Set to 'no' for manual management only.
# Default: 'no'
BRIDGE_HOTPLUG={{ BRIDGE_HOTPLUG | default('no') }}

# Whether to disable link-local IPv6 on physical interfaces of VLAN ports.
# When enabled, this prevents the creation of IPv6 link-local addresses on the
# underlying physical interfaces that are members of a VLAN interface attached
# to a bridge. This is useful to reduce noise and potential routing issues.
# Default: 'yes'
BRIDGE_DISABLE_LINKLOCAL_IPV6_ALSO_PHYS={{ BRIDGE_DISABLE_LINKLOCAL_IPV6_ALSO_PHYS | default('yes') }}
