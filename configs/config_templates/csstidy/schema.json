{
  "allow_html_in_templates": {
    "type": "bool",
    "default": false,
    "description": "Allow HTML in templates"
  },
  "case_properties": {
    "type": "bool",
    "default": false,
    "description": "Uppercase/lowercase for CSS properties"
  },
  "compress_colors": {
    "type": "bool",
    "default": true,
    "description": "Optimize color values (e.g., #000000 \u2192 #000)"
  },
  "compress_font_weight": {
    "type": "bool",
    "default": true,
    "description": "Optimize font-weight values (e.g., 'normal' \u2192 400)"
  },
  "discard_invalid_properties": {
    "type": "bool",
    "default": false,
    "description": "Remove invalid CSS properties"
  },
  "lowercase_s": {
    "type": "bool",
    "default": false,
    "description": "Convert selectors (e.g., A, SPAN) to lowercase"
  },
  "preserve_css": {
    "type": "bool",
    "default": false,
    "description": "Preserve comments and browser-specific hacks"
  },
  "remove_bslash": {
    "type": "bool",
    "default": true,
    "description": "Remove unnecessary backslashes"
  },
  "remove_last_semicolon": {
    "type": "bool",
    "default": false,
    "description": "Remove trailing semicolon before closing brace"
  },
  "silent": {
    "type": "bool",
    "default": false,
    "description": "Suppress optimization summary output"
  },
  "sort_properties": {
    "type": "bool",
    "default": false,
    "description": "Sort properties alphabetically within rules"
  },
  "sort_selectors": {
    "type": "bool",
    "default": false,
    "description": "Sort selectors (IDs first, then classes, then element names)"
  },
  "timestamp": {
    "type": "bool",
    "default": false,
    "description": "Add timestamp comment at top of output"
  },
  "merge_selectors": {
    "type": "number",
    "default": 2,
    "description": "Selector merging level: 0=none, 1=safe, 2=aggressive"
  },
  "optimise_shorthands": {
    "type": "number",
    "default": 1,
    "description": "Shorthand optimisation level: 0=none, 1=safe, 2=all"
  },
  "template_preset": {
    "type": "string",
    "default": "default",
    "description": "Predefined output formatting template: default, low, high, highest, or path to custom file",
    "enum": [
      "default",
      "low",
      "high",
      "highest"
    ]
  }
}
