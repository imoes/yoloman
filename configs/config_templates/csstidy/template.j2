# csstidy configuration file
# All options are passed directly as command-line arguments.
# This file is self-documented: each directive is preceded by its schema description.
# Boolean options emit 'true' or 'false'; numeric options emit their integer value.
# If a variable is undefined in the Ansible inventory, the schema default is used.

# Allow HTML in templates: default=False
# desc='Allow HTML in templates'
--allow_html_in_templates={{ (allow_html_in_templates | default(false)) | ternary('true', 'false') }}

# Uppercase/lowercase for CSS properties: default=False
# desc='Uppercase/lowercase for CSS properties'
--case_properties={{ (case_properties | default(false)) | ternary('true', 'false') }}

# Optimize color values (e.g., #000000 → #000): default=True
# desc='Optimize color values (e.g., #000000 → #000)'
--compress_colors={{ (compress_colors | default(true)) | ternary('true', 'false') }}

# Optimize font-weight values (e.g., 'normal' → 400): default=True
# desc="Optimize font-weight values (e.g., 'normal' → 400)"
--compress_font_weight={{ (compress_font_weight | default(true)) | ternary('true', 'false') }}

# Remove invalid CSS properties: default=False
# desc='Remove invalid CSS properties'
--discard_invalid_properties={{ (discard_invalid_properties | default(false)) | ternary('true', 'false') }}

# Convert selectors (e.g., A, SPAN) to lowercase: default=False
# desc='Convert selectors (e.g., A, SPAN) to lowercase'
--lowercase_s={{ (lowercase_s | default(false)) | ternary('true', 'false') }}

# Preserve comments and browser-specific hacks: default=False
# desc='Preserve comments and browser-specific hacks'
--preserve_css={{ (preserve_css | default(false)) | ternary('true', 'false') }}

# Remove unnecessary backslashes: default=True
# desc='Remove unnecessary backslashes'
--remove_bslash={{ (remove_bslash | default(true)) | ternary('true', 'false') }}

# Remove trailing semicolon before closing brace: default=False
# desc='Remove trailing semicolon before closing brace'
--remove_last_semicolon={{ (remove_last_semicolon | default(false)) | ternary('true', 'false') }}

# Suppress optimization summary output: default=False
# desc='Suppress optimization summary output'
--silent={{ (silent | default(false)) | ternary('true', 'false') }}

# Sort properties alphabetically within rules: default=False
# desc='Sort properties alphabetically within rules'
--sort_properties={{ (sort_properties | default(false)) | ternary('true', 'false') }}

# Sort selectors (IDs first, then classes, then element names): default=False
# desc='Sort selectors (IDs first, then classes, then element names)'
--sort_selectors={{ (sort_selectors | default(false)) | ternary('true', 'false') }}

# Add timestamp comment at top of output: default=False
# desc='Add timestamp comment at top of output'
--timestamp={{ (timestamp | default(false)) | ternary('true', 'false') }}

# Selector merging level: 0=none, 1=safe, 2=aggressive: default=2
# desc='Selector merging level: 0=none, 1=safe, 2=aggressive'
--merge_selectors={{ merge_selectors | default(2) }}

# Shorthand optimisation level: 0=none, 1=safe, 2=all: default=1
# desc='Shorthand optimisation level: 0=none, 1=safe, 2=all'
--optimise_shorthands={{ optimise_shorthands | default(1) }}

# Predefined output formatting template: default, low, high, highest, or path to custom file: default='default'
# desc='Predefined output formatting template: default, low, high, highest, or path to custom file'
--template={{ template_preset | default('default') }}