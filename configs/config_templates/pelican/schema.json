{
  "content_dir": {
    "type": "string",
    "default": "content",
    "description": "Path where to find the content files (articles, pages). Corresponds to positional argument [path] or standard convention."
  },
  "output_path": {
    "type": "string",
    "default": "output",
    "description": "Where to output the generated files. Corresponds to -o / --output."
  },
  "theme": {
    "type": "string",
    "default": "notmyidea",
    "description": "Theme name or path. Corresponds to -t / --theme-path. Defaults to built-in 'notmyidea' if not specified."
  },
  "site_name": {
    "type": "string",
    "default": "My Pelican Blog",
    "description": "Name of the website (SITE_NAME)."
  },
  "site_url": {
    "type": "string",
    "default": "http://example.com",
    "description": "URL of the website (SITEURL)."
  },
  "site_description": {
    "type": "string",
    "default": "A blog powered by Pelican.",
    "description": "Description of the website (SITEDESCRIPTION)."
  },
  "default_author": {
    "type": "string",
    "default": "Admin",
    "description": "Default author name (DEFAULT_AUTHOR)."
  },
  "article_date_format": {
    "type": "string",
    "default": "%B %d, %Y",
    "description": "Date format string for articles (DATE_FORMAT)."
  },
  "timezone": {
    "type": "string",
    "default": "UTC",
    "description": "Timezone for date processing (TIMEZONE)."
  },
  "use_relative_urls": {
    "type": "bool",
    "default": false,
    "description": "Use relative URLs in output. Corresponds to --relative-urls flag."
  },
  "cache_path": {
    "type": "string",
    "default": "cache",
    "description": "Directory to store cache files. Corresponds to --cache-path."
  },
  "log_level": {
    "type": "string",
    "default": "WARNING",
    "description": "Log level (DEBUG, INFO, WARNING, ERROR). Corresponds to --logs-dedup-min-level.",
    "enum": [
      "DEBUG",
      "INFO",
      "WARNING",
      "ERROR"
    ]
  },
  "log_handler": {
    "type": "string",
    "default": "rich",
    "description": "Log message handler (plain or rich). Corresponds to --log-handler.",
    "enum": [
      "plain",
      "rich"
    ]
  },
  "display_categories_on_sidebar": {
    "type": "bool",
    "default": true,
    "description": "Show categories in sidebar (DISPLAY_CATEGORIES_ON_SIDEBAR)."
  },
  "display_tags_on_sidebar": {
    "type": "bool",
    "default": true,
    "description": "Show tags in sidebar (DISPLAY_TAGS_ON_SIDEBAR)."
  },
  "display_archive_on_sidebar": {
    "type": "bool",
    "default": false,
    "description": "Show archive in sidebar (DISPLAY_ARCHIVE_ON_SIDEBAR)."
  }
}
