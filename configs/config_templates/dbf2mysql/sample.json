{
  "services": [
    {
      "name": "customers_import",
      "description": "Import customers.dbf into MySQL, skip Remarks, rename Order to HORDER, lowercase fields, uppercase text, and trim whitespace.",
      "input_file": "/data/dbf/customers.dbf",
      "verbose": 2,
      "lowercase_fields": true,
      "uppercase_text": "u",
      "allow_null": true,
      "include_fields": [
        "ID",
        "NAME",
        "EMAIL",
        "ORDER"
      ],
      "skip_fields": [
        [
          "REMARKS",
          ""
        ]
      ],
      "rename_fields": [
        [
          "ORDER",
          "HORDER"
        ]
      ],
      "index_fields": [
        "ID",
        "EMAIL"
      ],
      "database": "crm",
      "table": "customers",
      "create_mode": "drop_create",
      "primary_key": "ID",
      "host": "db.example.com",
      "user": "dbf2mysql",
      "password": "",
      "fixed_length": false,
      "trim_chars": true,
      "quick_mode": true,
      "local_infile": true,
      "add_rec_timestamp": true,
      "charset": "utf8mb4",
      "conversion_file": ""
    },
    {
      "name": "products_import",
      "description": "Import products.dbf with custom CHAR conversions, no table creation (append only).",
      "input_file": "/data/dbf/products.dbf",
      "verbose": 1,
      "include_fields": [
        "SKU",
        "DESCRIPTION",
        "PRICE"
      ],
      "database": "inventory",
      "table": "products",
      "create_mode": "",
      "host": "localhost",
      "user": "app_user",
      "password": "s3cr3t!",
      "fixed_length": true,
      "trim_chars": false,
      "quick_mode": false,
      "local_infile": false,
      "add_rec_timestamp": false,
      "charset": "",
      "conversion_file": "/etc/dbf2mysql/convert_products.txt"
    }
  ]
}
