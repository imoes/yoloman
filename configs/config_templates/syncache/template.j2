# /etc/default/syncache
# Configuration file for syncache-drb service.
#
# This file is auto-generated by Ansible. Do not edit manually.
# See the schema comments below for the purpose of each variable.

# enabled: Set to "1" to enable starting syncache-drb on boot, or "0" to disable it.
ENABLED={{ enabled | default('1') }}

# port: The port number for the default dRuby URI.
{% if port is defined and port | default('') | trim != '' %}
URI='druby://localhost:{{ port | default('') | trim }}'
{% else %}
#URI='druby://localhost:9000'
{% endif %}

# ttl: The default time-to-live limit for cached objects in seconds.
{% if ttl is defined and ttl | default('') | trim != '' %}
TTL={{ ttl | default('') | trim }}
{% else %}
#TTL=86400
{% endif %}

# size: The default limit on the number of cached objects.
{% if size is defined and size | default('') | trim != '' %}
SIZE={{ size | default('') | trim }}
{% else %}
#SIZE=10000
{% endif %}

# flushdelay: Minimum number of seconds between flush operations. If less time has passed since the last flush, the next one is delayed.
FLUSHDELAY={{ flushdelay | default('5') }}
