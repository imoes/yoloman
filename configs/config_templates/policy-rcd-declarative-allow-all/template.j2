# policy-rcd configuration file for declarative allow-all policy.
# This file controls which services are started automatically during package installation.
# For detailed format information, consult the man page: service-policy.d(5).
#
# Format: Each line contains three whitespace-separated fields:
#   1. A regular expression matching the package name being installed.
#   2. A regular expression matching the service name (usually 'start' or specific targets).
#   3. The action to take: 'allow', 'deny', or 'ignore'.

# Default rule: Allow all packages and services.
# regex: Regular expression matching package names. Defaults to '.*' (everything).
# action_service: Regular expression matching service names. Defaults to '.*' (all services).
# action: Action to take: allow, deny, or ignore. Defaults to 'allow'.
{{ regex | default('.*') }}	{{ action_service | default('.*') }}	{{ action | default('allow') }}