# ==============================================================================
# Policy RCD Declarative Allow All Configuration
# ==============================================================================
# This file defines the default policy for the `policy-rcd` service.
# `policy-rcd` intercepts package installation triggers to decide whether
# associated systemd/Init services should be started or stopped.
#
# Format: <package_regex> <service_regex> <action>
#
# Fields:
#   - regex: A regular expression matching the package names that this rule applies to.
#   - action_service: A regular expression matching the service names associated
#                     with the matching packages.
#   - action: The action to take when a package/service matches both patterns above.
#             Valid values are: 'allow', 'deny', or 'ignore'.
#
# See service-policy.d(5) for detailed documentation.

# Match any package name (default: '.*')
# against any service name (default: '.*')
# with the default action 'allow'.
{{ regex | default('.*') }}	{{ action_service | default('.*') }}	{{ action | default('allow') }}
