{
  "PROJECT_NAME": {
    "type": "string",
    "default": "cinder",
    "description": "Name of the OpenStack project/service"
  },
  "PIDFILE": {
    "type": "string",
    "default": "/var/run/cinder/cinder-scheduler.pid",
    "description": "Path to the PID file"
  },
  "SCRIPTNAME": {
    "type": "string",
    "default": "/etc/init.d/cinder-scheduler",
    "description": "Path to the init script"
  },
  "SYSTEM_USER": {
    "type": "string",
    "default": "cinder",
    "description": "System user to run the service under"
  },
  "SYSTEM_GROUP": {
    "type": "string",
    "default": "cinder",
    "description": "System group to run the service under"
  },
  "CONFIG_FILE": {
    "type": "string",
    "default": "/etc/cinder/cinder.conf",
    "description": "Path to the main configuration file"
  },
  "LOGFILE": {
    "type": "string",
    "default": "/var/log/cinder/cinder-scheduler.log",
    "description": "Path to the log file"
  },
  "UWSGI_BIND_CONFIG_FILE": {
    "type": "string",
    "default": "",
    "description": "UWSGI bind configuration file path"
  },
  "UWSGI_BIND_CONFIG_SECTION": {
    "type": "string",
    "default": "uwsgi",
    "description": "Section in UWSGI config for bind settings"
  },
  "UWSGI_BIND_CONFIG_IP_DIRECTIVE": {
    "type": "string",
    "default": "bind",
    "description": "IP address directive in UWSGI config"
  },
  "UWSGI_BIND_CONFIG_PORT_DIRECTIVE": {
    "type": "string",
    "default": "port",
    "description": "Port directive in UWSGI config"
  },
  "UWSGI_BIND_CONFIG_WORKERS_DIRECTIVE": {
    "type": "string",
    "default": "processes",
    "description": "Workers/processes directive in UWSGI config"
  },
  "UWSGI_PORT": {
    "type": "string",
    "default": "",
    "description": "UWSGI port to bind to"
  },
  "UWSGI_INI_PATH": {
    "type": "string",
    "default": "",
    "description": "Path to the UWSGI ini file"
  },
  "UWSGI_INI_APP": {
    "type": "string",
    "default": "",
    "description": "Path to the UWSGI app-specific ini file"
  },
  "USE_SYSLOG": {
    "type": "string",
    "default": "no",
    "description": "Set to 'yes' to enable syslog logging",
    "enum": [
      "yes",
      "no"
    ]
  },
  "USE_LOGFILE": {
    "type": "string",
    "default": "yes",
    "description": "Set to 'no' to disable logfile logging",
    "enum": [
      "yes",
      "no"
    ]
  },
  "PYARGV": {
    "type": "string",
    "default": "",
    "description": "Arguments to pass via --pyargv"
  }
}
