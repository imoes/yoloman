[EMC]
# Name of the machine (used for display and logging)
MACHINE = {{ machine_name }}

# Debug level (0 = none, 99 = very verbose)
DEBUG = {{ emc_debug_level }}

[DISPLAY]
# GUI application to use (e.g., AXIS, TK, QTVCP)
DISPLAY = {{ display_type }}

# Path to the main UI file (if applicable, e.g., for QTVCP)
{% if display_ui_path %}# UI file path
UI = {{ display_ui_path }}{% endif %}

# Cycle time (ms) for GUI updates
CYCLE_TIME = {{ display_cycle_time }}

# Maximum feed override (as fraction, e.g. 1.5 = 150%)
MAX_FEED_OVERRIDE = {{ max_feed_override }}

# Minimum spindle override (as fraction, e.g. 0.5 = 50%)
MIN_SPINDLE_OVERRIDE = {{ min_spindle_override }}

# Maximum spindle override (as fraction, e.g. 2.0 = 200%)
MAX_SPINDLE_OVERRIDE = {{ max_spindle_override }}

# Position feedback source: ACTUAL (default) or COMMANDED
POSITION_OFFSET = {{ position_offset }}

# Position feedback mode: RELATIVE (default) or MACHINE
POSITION_FEEDBACK = {{ position_feedback }}

# Default linear units: MM or INCHES
DEFAULT_LINEAR_UNITS = {{ default_linear_units }}

# Angular units: DEGREES or RADIANS
DEFAULT_ANGULAR_UNITS = {{ default_angular_units }}

# XY plane selection for G17, G18, G19
DEFAULT_ANGULAR_UNITS = {{ default_angular_units }}

[RS274NGC]
# Path to the HAL configuration (HAL file to load before RT motion)
HALFILE = {{ halfile_path }}

# Optional: additional HAL files (comma-separated list)
{% if halfile_extra %}# Extra HAL files
HALFILE = {{ halfile_extra | join(', ') }}{% endif %}

# Path to the startup G-code file (runs after HAL load)
{% if startup_gcode_path %}# Startup G-code
RUN_INI = {{ startup_gcode_path }}{% endif %}

# Subroutine path (for user-defined G-codes)
SUBROUTINE_PATH = {{ subroutine_path }}

# Error log level: LOG, WARN, ERROR
ERROR_LOG_LEVEL = {{ error_log_level }}

