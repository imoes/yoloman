<?xml version="1.0" encoding="UTF-8"?>
<!-- NX Keystroke Configuration Template -->
<!-- This file defines the keybindings for the NoMachine NX Agent. -->
<!-- It is self-documenting: each directive is preceded by its schema description. -->

<!DOCTYPE NXKeystroke>
<keystrokes>
    <!-- Control modifier key state for close_session action -->
    <keystroke action="close_session"
               Control="{{ nxagent_keys_close_session_control | default(1) }}"
               AltMeta="{{ nxagent_keys_close_session_altmeta | default(1) }}"
               key="{{ nxagent_keys_close_session_key | default('t') }}" />

