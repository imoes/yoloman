{
  "driver": {
    "type": "string",
    "default": "SQLite",
    "description": "Database driver type used by globus-gram-audit"
  },
  "database": {
    "type": "string",
    "default": "dbname=/var/lib/globus/gram-audit-database",
    "description": "Database connection string or path"
  },
  "username": {
    "type": "string",
    "default": "",
    "description": "Database username for authentication"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "Database password for authentication"
  },
  "audit_version": {
    "type": "string",
    "default": "1TG",
    "description": "Audit format version identifier"
  }
}
