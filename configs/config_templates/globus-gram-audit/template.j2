# Globus GRAM Audit Configuration
# Generated by Ansible Jinja2 Template
# This file configures the database backend for Globus GRAM audit logging.

# Database driver type used by globus-gram-audit
# Default: SQLite
# Supported values typically include: SQLite, PostgreSQL, MySQL, etc.
DRIVER:{{ (driver | default('SQLite')) | string }}

# Database connection string or path
# Default: dbname=/var/lib/globus/gram-audit-database
# For SQLite, this is usually the file path. For other databases, this may be a DSN.
DATABASE:{{ (database | default('dbname=/var/lib/globus/gram-audit-database')) | string }}

# Database username for authentication
# Default: (empty)
# If using SQLite or a local file-based DB, this may be ignored or empty.
USERNAME:{{ (username | default('')) | string }}

# Database password for authentication
# Default: (empty)
# If using SQLite or a local file-based DB, this may be ignored or empty.
PASSWORD:{{ (password | default('')) | string }}

# Audit format version identifier
# Default: 1TG
# Specifies the version of the audit log format to use.
AUDITVERSION:{{ (audit_version | default('1TG')) | string }}
