{
  "config": {
    "db_dir": "/var/lib/htdig/db",
    "common_dir": "/var/lib/htdig/common",
    "word_db_dir": "/var/lib/htdig/word.db",
    "result_dir": "/var/lib/htdig/results",
    "server_url": "http://example.com/",
    "hostname": "example.com",
    "port": 80,
    "cgi_url": "/cgi-bin/htsearch",
    "crawl_limit": 5000,
    "crawl_depth": 3,
    "crawl_url_limit": 2000,
    "crawl_delay": 2.0,
    "max_document_size": 200000,
    "number_of_workers": 3,
    "robot_enabled": true,
    "start_urls": [
      "http://example.com/",
      "http://example.com/docs/"
    ],
    "exclude_urls": [
      "http://example.com/admin/*",
      "*.pdf$",
      "*.doc$"
    ],
    "require_urls": [
      "http://example.com/"
    ],
    "cgi_extension_filter": [
      "html",
      "htm",
      "php"
    ],
    "ignore_headers": [
      "cookie",
      "x-frame-options"
    ],
    "results_per_page": 20,
    "max_matches": 500,
    "minimum_score": 20,
    "results_sort": "score",
    "stemming_enabled": true,
    "phrase_search_enabled": true,
    "fuzzy_search_enabled": true,
    "language": "en",
    "stop_words_file": "/etc/htdig/stopwords.en",
    "word_length_max": 40,
    "word_length_min": 3,
    "title_indexing": true,
    "full_indexing": true,
    "attribute_indexing": true,
    "index_attributes": [
      "alt",
      "title"
    ],
    "proximity_scoring": true,
    "title_weight": 0.5,
    "search_operator": "and",
    "truncation_enabled": true,
    "stemming_search_enabled": true
  }
}
