# Database directories for index storage, search results, and temporary files
db_dir: {{ config.db_dir }}

# Directory where compiled HTML documents and parsed documents are stored
common_dir: {{ config.common_dir }}

# Path to the word database directory
word_db_dir: {{ config.word_db_dir }}

# Where to store the final HTML output (e.g., search results)
result_dir: {{ config.result_dir }}

# URL of the server hosting the search interface (must include trailing slash)
server_url: {{ config.server_url }}

# Hostname or IP of the machine running htdig (used for generation of absolute URLs)
hostname: {{ config.hostname }}

# Port used by the Web server (if different from default, e.g., 8080)
port: {{ config.port }}

# Path to the CGI script used for search interface (relative to server_url or absolute)
cgi_url: {{ config.cgi_url }}

# Maximum number of documents to crawl
crawl_limit: {{ config.crawl_limit }}

# Maximum depth of link following during crawl (0 = no limit)
crawl_depth: {{ config.crawl_depth }}

# Maximum number of URLs to crawl before stopping (0 = no limit)
crawl_url_limit: {{ config.crawl_url_limit }}

# Time in seconds between successive requests to same host (prevents server overload)
crawl_delay: {{ config.crawl_delay }}

# Maximum size (in KB) of a document to parse (0 = unlimited)
max_document_size: {{ config.max_document_size }}

# Number of concurrent fetcher processes (workers); must be ≥ 1
number_of_workers: {{ config.number_of_workers }}

# Enable or disable automatic URL exclusion via robots.txt
robot_enabled: {{ config.robot_enabled | lower }}

# List of additional URLs to start crawling from
{% for url in config.start_urls %}
start_url: {{ url }}
{% endfor %}

# List of URLs or patterns to exclude from crawling
{% for pattern in config.exclude_urls %}
exclude_urls: {{ pattern }}
{% endfor %}

# List of URL patterns to require for inclusion (if set, only URLs matching are indexed)
{% for pattern in config.require_urls %}
require_urls: {{ pattern }}
{% endfor %}

# List of file extensions to index (others are ignored); empty = all
cgi_extension_filter: {{ config.cgi_extension_filter | join(', ') }}

# Comma-separated list of headers to ignore (case-insensitive)
ignore_headers: {{ config.ignore_headers | join(', ') }}

# Maximum number of results returned per search
results_per_page: {{ config.results_per_page }}

# Maximum number of results shown in summary list (0 = unlimited)
max_matches: {{ config.max_matches }}

# Score threshold below which results are not shown (0 = none)
minimum_score: {{ config.minimum_score }}

# Sorting method for results: 'score' or 'date'
results_sort: {{ config.results_sort }}

# Enable or disable stemming in search queries
stemming_enabled: {{ config.stemming_enabled | lower }}

# Enable or disable phrase searching
phrase_search_enabled: {{ config.phrase_search_enabled | lower }}

# Enable or disable fuzzy matching (e.g., 'cat' matches 'cats')
fuzzy_search_enabled: {{ config.fuzzy_search_enabled | lower }}

# Language for stop-word and stemming rules (e.g., 'en', 'de')
language: {{ config.language }}

# Path to custom stop-words file (optional)
stop_words_file: {{ config.stop_words_file }}

# Maximum length (in chars) of a word stored in word database
word_length_max: {{ config.word_length_max }}

# Minimum length (in chars) of a word to index
word_length_min: {{ config.word_length_min }}

# Enable or disable title indexing
title_indexing: {{ config.title_indexing | lower }}

# Enable or disable full-text indexing
full_indexing: {{ config.full_indexing | lower }}

# Enable or disable attribute indexing (e.g., alt, href)
attribute_indexing: {{ config.attribute_indexing | lower }}

# Comma-separated list of HTML attributes to index (e.g., 'alt,title')
index_attributes: {{ config.index_attributes | join(', ') }}

# Enable or disable word proximity scoring
proximity_scoring: {{ config.proximity_scoring | lower }}

# Weight for title vs body scoring (0.0–1.0); higher = more weight to titles
title_weight: {{ config.title_weight }}

# Default search operator: 'and' or 'or'
search_operator: {{ config.search_operator }}

# Enable or disable automatic truncation of search terms
truncation_enabled: {{ config.truncation_enabled | lower }}

# Enable or disable word stemming during search
stemming_search_enabled: {{ config.stemming_search_enabled | lower }}
