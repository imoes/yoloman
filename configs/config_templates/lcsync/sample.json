{
  "mode": "client",
  "interface": "eth0",
  "log_level": 2,
  "password": "",
  "keyfile": "/etc/lcsync/keyfile",
  "bw_limit": "5M",
  "hex_hashes": true,
  "recursive": true,
  "archive": true,
  "dry_run": false,
  "batch": true,
  "local_path": "/var/lib/lcsync/data",
