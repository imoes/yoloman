{
  "ldap_server": "ldaps://ldap.example.org",
  "ldap_base_dn": "ou=users,dc=example,dc=org",
  "ldap_bind_dn": "cn=pureftpd,ou=services,dc=example,dc=org",
  "ldap_bind_password": "s3cr3t_b1nd_p4ss",
  "ldap_user_filter": "(&(objectClass=posixAccount)(uid=%u)(service=ftp))",
  "ldap_uid_attribute": "uidNumber",
  "ldap_gid_attribute": "gidNumber",
  "ldap_home_attribute": "homeDirectory",
  "ldap_shell_attribute": "loginShell",
  "ldap_password_attribute": "userPassword",
  "ldap_use_tls": true,
  "ldap_ca_cert_file": "/etc/ssl/certs/example-ca.crt",
  "ldap_client_cert_file": "/etc/ssl/certs/pureftpd.crt",
  "ldap_client_key_file": "/etc/ssl/private/pureftpd.key",
  "ldap_version": 3,
  "ldap_require_cert": "demand",
  "ldap_follow_referrals": 0,
  "ldap_max_conn": 15,
  "ldap_debug": 0,
  "ldap_additional_search_bases": [
    "ou=guests,dc=example,dc=org",
    "ou=service-users,dc=example,dc=org"
  ]
