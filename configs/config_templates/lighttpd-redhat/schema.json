{
  "log_root": {
    "type": "string",
    "default": "/var/log/lighttpd",
    "description": "Base directory for log files."
  },
  "server_root": {
    "type": "string",
    "default": "/var/www",
    "description": "Base server root directory."
  },
  "state_dir": {
    "type": "string",
    "default": "/run/lighttpd",
    "description": "Directory for runtime state files (pid, sockets)."
  },
  "home_dir": {
    "type": "string",
    "default": "/var/lib/lighttpd",
    "description": "Home directory for lighttpd data."
  },
  "conf_dir": {
    "type": "string",
    "default": "/etc/lighttpd",
    "description": "Directory for configuration files."
  },
  "cache_dir": {
    "type": "string",
    "default": "/var/cache/lighttpd",
    "description": "Cache directory for mod_deflate."
  },
  "server_port": {
    "type": "number",
    "default": "80",
    "description": "Port to listen on."
  },
  "server_use_ipv6": {
    "type": "string",
    "default": "enable",
    "description": "Enable or disable IPv6 support."
  },
  "server_username": {
    "type": "string",
    "default": "lighttpd",
    "description": "Username to run the server as."
  },
  "server_groupname": {
    "type": "string",
    "default": "lighttpd",
    "description": "Groupname to run the server as."
  },
  "server_systemd_socket_activation": {
    "type": "string",
    "default": "",
    "description": "Enable systemd socket activation."
  },
  "server_core_files": {
    "type": "string",
    "default": "",
    "description": "Enable or disable core files generation."
  },
  "server_errorlog_use_syslog": {
    "type": "string",
    "default": "",
    "description": "Enable or disable logging errors to syslog."
  },
  "server_event_handler": {
    "type": "string",
    "default": "",
    "description": "Event handler for I/O multiplexing."
  },
  "server_network_backend": {
    "type": "string",
    "default": "",
    "description": "Network backend for file transfer."
  },
  "server_max_fds": {
    "type": "number",
    "default": "16384",
    "description": "Maximum number of file descriptors."
  },
  "server_listen_backlog": {
    "type": "number",
    "default": "",
    "description": "Size of the listen() backlog queue."
  },
  "server_stat_cache_engine": {
    "type": "string",
    "default": "",
    "description": "Stat() call caching engine."
  },
  "server_max_connections": {
    "type": "number",
    "default": "",
    "description": "Maximum number of connections."
  },
  "server_max_keep_alive_idle": {
    "type": "number",
    "default": "",
    "description": "Seconds to keep a keep-alive connection open."
  },
  "server_max_keep_alive_requests": {
    "type": "number",
    "default": "",
    "description": "Maximum keep-alive requests before closing."
  },
  "server_max_request_size": {
    "type": "number",
    "default": "",
    "description": "Maximum request size in kilobytes."
  },
  "server_max_read_idle": {
    "type": "number",
    "default": "",
    "description": "Seconds to read from a socket before idle."
  },
  "server_max_write_idle": {
    "type": "number",
    "default": "",
    "description": "Seconds to write to a socket before idle."
  },
  "server_kbytes_per_second": {
    "type": "number",
    "default": "",
    "description": "Traffic shaping limit per server in kB/s."
  },
  "connection_kbytes_per_second": {
    "type": "number",
    "default": "",
    "description": "Traffic shaping limit per connection in kB/s."
  },
  "server_follow_symlink": {
    "type": "string",
    "default": "",
    "description": "Follow symlinks."
  },
  "server_force_lowercase_filenames": {
    "type": "string",
    "default": "",
    "description": "Force all filenames to be lowercase."
  }
}
