{
 "cache_dir": "/var/cache/lighttpd",
 "conf_dir": "/etc/lighttpd",
 "connection_kbytes_per_second": 32,
 "home_dir": "/var/lib/lighttpd",
 "log_root": "/var/log/lighttpd",
 "server_core_files": "disable",
 "server_errorlog_use_syslog": "enable",
 "server_event_handler": "linux-sysepoll",
 "server_follow_symlink": "enable",
 "server_force_lowercase_filenames": "disable",
 "server_groupname": "lighttpd",
 "server_kbytes_per_second": 128,
 "server_listen_backlog": 128,
 "server_max_connections": 1024,
 "server_max_fds": 16384,
 "server_max_keep_alive_idle": 5,
 "server_max_keep_alive_requests": 16,
 "server_max_read_idle": 60,
 "server_max_request_size": 0,
 "server_max_write_idle": 360,
 "server_network_backend": "sendfile",
 "server_port": 80,
 "server_root": "/var/www",
 "server_stat_cache_engine": "simple",
 "server_systemd_socket_activation": "enable",
 "server_use_ipv6": "enable",
 "server_username": "lighttpd",
 "state_dir": "/run/lighttpd"
}
