{
  "realm": "EXAMPLE.COM",
  "dns_lookup_realm": false,
  "dns_lookup_kdc": false,
  "default_tkt_enctypes": [
    "aes256-cts-hmac-sha1-96",
    "aes128-cts-hmac-sha1-96"
  ],
  "default_tgs_enctypes": [
    "aes256-cts-hmac-sha1-96",
    "aes128-cts-hmac-sha1-96"
  ],
  "permitted_enctypes": [
    "aes256-cts-hmac-sha1-96",
    "aes128-cts-hmac-sha1-96"
  ],
  "max_skew": 300,
  "default_ccache_name": "FILE:/tmp/krb5cc_%{uid}",
  "realms": [
    {
      "name": "EXAMPLE.COM",
      "kdc_host": "kdc.example.com",
      "kdc_port": 88,
      "admin_port": 749,
      "default_domain": "example.com",
      "database": {
        "dbname": "/var/krb5/principal",
        "master_key_type": "aes256-cts-hmac-sha1-96",
        "master_key": "AQAAAAIAAABFAAAAQWJjZGVmMDEyMzQ1Njc4OTBhYmNkZWYxMjM0NTY3ODkw"
      },
      "acls": {
        "acl_file": "/etc/krb5kdc/kadm5.acl",
        "admin_acl": "kadmin/admin@EXAMPLE.COM",
        "kadmin_acl": "kadmin/changepw@EXAMPLE.COM kadmin/*@EXAMPLE.COM"
      }
    }
  ],
  "domain_realm": [
    {
      "domain": ".example.com",
      "realm": "EXAMPLE.COM"
    },
    {
      "domain": "example.com",
      "realm": "EXAMPLE.COM"
    }
  ],
  "log": {
    "kdc_path": "/var/log/krb5kdc.log",
    "admin_server_path": "/var/log/kadmin.log",
    "default_path": "/var/log/krb5lib.log"
  }
}
