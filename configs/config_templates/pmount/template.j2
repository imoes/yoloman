# /etc/pmount.allow
# pmount will allow users to additionally mount all devices that are
# listed here.
#
# This file controls which filesystem types are permitted to be mounted
# by unprivileged users via the pmount utility.
#
# Format:
# Each line should contain a single filesystem type (e.g., vfat, ntfs, iso9660).
# Lines starting with '#' are ignored.
# Empty lines are ignored.

# Example: Allow mounting of vfat and ntfs partitions
# vfat
# ntfs

# No specific filesystem types are defined by default in this template.
# To enable specific types, uncomment and edit the lines below.

# Allow FAT32/ExFAT
# vfat

# Allow NTFS
# ntfs

# Allow ISO 9660 (CD-ROM/DVD)
# iso9660

# Allow UDF
# udf

# Allow ext4 (usually restricted, use with caution)
# ext4

# Allow XFS
# xfs

# Allow Btrfs
# btrfs

# Allow F2FS
# f2fs

# Allow exFAT
# exfat

# Allow ntfs-3g specific tag if needed (often covered by ntfs)
# ntfs-3g

# End of pmount.allow configuration
