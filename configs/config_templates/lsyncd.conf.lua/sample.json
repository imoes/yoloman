{
  "sync_rules": [
    {
      "name": "web_assets",
      "source_dir": "/var/www/web_assets",
      "target_host": "web01.example.com",
      "target_dir": "/var/www/web_assets",
      "excludes": [
        "*.tmp",
        ".git"
      ]
    },
    {
      "name": "logs",
      "source_dir": "/var/log/app",
      "target": "/var/backups/logs"
    }
  ]
}
