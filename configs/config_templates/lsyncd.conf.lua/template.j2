-- Lsyncd configuration file — sync local directories to remote (or local) destinations
-- Generated by Jinja2 template engine

settings {
    logfile    = "{{ settings.logfile | default('/var/log/lsyncd/lsyncd.log') }}",
    statusFile = "{{ settings.statusfile | default('/var/log/lsyncd/lsyncd.status') }}",
    statusInterval = {{ settings.status_interval | default(1) }},
    maxProcesses = {{ settings.max_processes | default(1) }},
    {
{% if settings.inotify_mode | default(true) %}    inotifyMode = "Inotify",
{% else %}    inotifyMode = "Poll",
{% endif %}}
}

{% for sync_rule in sync_rules %}
-- Sync rule: {{ sync_rule.name | default('unnamed') }}
sync {
{% if sync_rule.source_dir is defined %}    default.rsync,
    source = "{{ sync_rule.source_dir }}",
{% else %}    default.rsync,
    source = "{{ sync_rule.source }}",
{% endif %}{% if sync_rule.target_host is defined %}    target = "{{ sync_rule.user | default('root') }}@{{ sync_rule.target_host }}{% if sync_rule.target_dir is defined %}:{{ sync_rule.target_dir }}{% else %}:{% endif %}",
{% else %}    target = "{{ sync_rule.target }}",
{% endif %}{% if sync_rule.excludes | length > 0 %}    exclude = {
{% for excl in sync_rule.excludes %}        "{{ excl }}",
{% endfor %}    },
{% endif %}{% if sync_rule.rsync_opts is defined %}    rsync = {
