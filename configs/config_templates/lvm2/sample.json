{
  "scan_devices": [
    "/dev"
  ],
  "device_filter": [
    "a|.*|",
    "r|/dev/sd[abc]$|"
  ],
  "global_filter": [],
  "sysfs_scan": true,
  "log_verbose": false,
  "syslog_enabled": true,
  "log_overwrite": false,
  "log_indent": true,
  "log_command_names": false,
  "log_level": 0,
  "metadata_backup": true,
  "metadata_archive": true,
  "archive_retain": 10,
  "missing_stripe_filler": "error",
  "pvmetadatacopies": 1,
  "vgmetadatacopies": "unmanaged",
  "max_extentsize": 512,
  "mirror_log_type": "disk",
  "default_mirror_count": 1
}
