{
  "log_verbose": false,
  "syslog_enabled": true,
  "log_overwrite": false,
  "log_indent": true,
  "log_command_names": false,
  "log_level": 0,
  "scan_devices": [
    "/dev"
  ],
  "device_filter": [
    "a|.*|",
    "r|/dev/sd[abc]$|"
  ],
  "global_filter": [],
  "missing_stripe_filler": "error",
  "use_udev_events": true,
  "sysfs_scan": true,
  "block_size": 2048,
  "pvmetadatacopies": 1,
  "vgmetadatacopies": "unmanaged",
  "metadata_backup": true,
  "metadata_archive": true,
  "archive_retain": 10,
  "archive_min_age": 7200,
  "alloc_pv_list": [],
  "max_extentsize": 512,
  "mirror_log_type": "disk",
  "default_mirror_count": 1,
  "default_snapshot_size": 100,
  "dmeventd_mirror_library": "/lib/dmeventd/libdevmapper-event-lvm2mirror.so"
}
