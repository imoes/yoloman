{
  "log_verbose": true,
  "syslog_enabled": true,
  "log_overwrite": false,
  "log_indent": true,
  "log_command_names": true,
  "log_level": 2,
  "scan_devices": [
    "/dev/sd[a-d]",
    "/dev/mapper/mpath*"
  ],
  "device_filter": [
    "a|/dev/sd[a-d]|",
    "r|.*|"
  ],
  "global_filter": [
    "a|/dev/disk/by-id/scsi-S.*|",
    "r|.*|"
  ],
  "missing_stripe_filler": "zero",
  "use_udev_events": true,
  "sysfs_scan": true,
  "block_size": 4096,
  "pvmetadatacopies": 1,
  "vgmetadatacopies": "any",
  "metadata_backup": true,
  "metadata_archive": true,
  "archive_retain": 5,
  "archive_min_age": 86400,
  "alloc_pv_list": [
    "/dev/sda",
    "/dev/sdb"
  ],
  "max_extentsize": 1024,
  "mirror_log_type": "disk",
  "default_mirror_count": 2,
  "default_snapshot_size": 200,
  "dmeventd_mirror_library": "liblvm2-raid-monitor.so",
  "dmeventd_raid_library": "liblvm2-raid-monitor.so",
  "dmeventd_snapshot_library": "liblvm2-snapshot-monitor.so",
  "activation_missing_stripe_filler": "zero",
  "activation_min_available_percent": 10,
  "activation_verify_metadata": true,
  "activation_retry_deactivation": 200,
  "activation_reserved_memory": 16384,
  "polling_interval": 30,
  "cache_default_mode": "writethrough",
  "cache_default_metadata_size": 256,
  "cache_default_data_size": 2048,
  "cache_default_policy": "smq",
  "cache_policy_settings": {
    "migration_threshold": 4096,
    "metadata_ratio": 16
  },
  "locking_type": 1,
  "activation_read_only": false
}
