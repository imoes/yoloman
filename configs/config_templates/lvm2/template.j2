# Configuration section metadata.
# Settings for LVM metadata.
metadata {

	# Configuration option metadata/check_pv_device_sizes.
	# Check PV device sizes against metadata.
	# This configuration option has an automatic default value.
	# check_pv_device_sizes = 1

	# Configuration option metadata/read_only.
	# Read-only metadata access.
	# This configuration option has an automatic default value.
	# read_only = 0

	# Configuration option metadata/record_lvs_history.
	# Record LV history in metadata.
	# This configuration option has an automatic default value.
	# record_lvs_history = 0

	# Configuration option metadata/record_mirror_image_faults.
	# Record mirror image faults in metadata.
	# This configuration option has an automatic default value.
	# record_mirror_image_faults = 1

	# Configuration option metadata/record_lvs_history.
	# Record LV history in metadata.
	# This configuration option has an automatic default value.
	# record_lvs_history = 0

	# Configuration option metadata/pvmetadatacopies.
	# Number of metadata copies per PV.
	# Accepted values:
	#   0
	#     No metadata copies.
	#   1
	#     First sector only.
	#   2
	#     First and second sectors.
	#
	# This configuration option has an automatic default value.
	pvmetadatacopies = {{ pvmetadatacopies }}

	# Configuration option metadata/vgmetadatacopies.
	# Number of metadata copies per VG.
	# Accepted values:
	#   unmanaged
	#     Automatic management.
	#   all
	#     All PVs in VG.
	#   any
	#     Any available PV.
	#   none
	#     No additional copies.
	#
	# This configuration option has an automatic default value.
	vgmetadatacopies = "{{ vgmetadatacopies }}"

	# Configuration option metadata/alloc.
	# Allocation policy for new LVs.
	# Accepted values:
	#   anywhere
	#     Allocate anywhere.
	#   cling
	#     Cling to existing extents.
	#   normal
	#     Normal allocation.
	#   maximisecling
	#     Maximise clinging.
	#
	# This configuration option has an automatic default value.
	# alloc = "anywhere"

	# Configuration option metadata/alloc_pv_list.
	# List of PV names/UUIDs to prefer when allocating space.
	# This configuration option has an automatic default value.
	# alloc_pv_list = [ ]

	# Configuration option metadata/max_extentsize.
	# Maximum size of a single allocation chunk in KB.
	# This configuration option has an automatic default value.
	max_extentsize = {{ max_extentsize }}

	# Configuration option metadata/mirror_log_type.
	# Default mirror log type.
	# Accepted values:
	#   disk
	#     Persistent log on disk.
	#   core
	#     In-memory log.
	#   mirrored
	#     Mirrored log.
	#
	# This configuration option has an automatic default value.
	mirror_log_type = "{{ mirror_log_type }}"

	# Configuration option metadata/default_mirror_count.
	# Default number of mirror images.
	# This configuration option has an automatic default value.
	default_mirror_count = {{ default_mirror_count }}

	# Configuration option metadata/default_snapshot_size.
	# Default snapshot size in KB.
	# This configuration option has an automatic default value.
	# default_snapshot_size = 1024
}

# Configuration section cache.
# Settings for cache.
cache {

	# Configuration option cache/writeback_mapping_threshold.
	# Writeback mapping threshold for cache.
	# This configuration option has an automatic default value.
	# writeback_mapping_threshold = 1024

	# Configuration option cache/writeback_mapping_size.
	# Writeback mapping size for cache.
	# This configuration option has an automatic default value.
	# writeback_mapping_size = 1024

	# Configuration option cache/writeback_dirty_ratio.
	# Writeback dirty ratio for cache.
	# This configuration option has an automatic default value.
	# writeback_dirty_ratio = 50

	# Configuration option cache/writeback_dirty_target_ratio.
	# Writeback dirty target ratio for cache.
	# This configuration option has an automatic default value.
	# writeback_dirty_target_ratio = 25

	# Configuration option cache/migration_threshold.
	# Migration threshold for cache.
	# This configuration option has an automatic default value.
	# migration_threshold = 1024

	# Configuration option cache/pool_chunk_size.
	# Pool chunk size for cache.
	# This configuration option does not have a default value defined.

	# Configuration option cache/pool_metadata_require_separate_pvs.
	# Pool metadata requires separate PVs for cache.
	# This configuration option has an automatic default value.
	# pool_metadata_require_separate_pvs = 0
}

# Configuration section dmeventd.
# Settings for dmeventd monitoring.
dmeventd {

	# Configuration option dmeventd/daemonize.
	# Enable or disable daemonization of dmeventd.
	# This configuration option has an automatic default value.
	# daemonize = 1

	# Configuration option dmeventd/executable.
	# The full path to the dmeventd executable.
	# This configuration option has an automatic default value.
	# executable = "/sbin/dmeventd"

	# Configuration option dmeventd/thin_executable.
	# The full path to the thin_check/thin_dump/thin_repair/thin_restore executable.
	# This configuration option has an automatic default value.
	# thin_executable = "/usr/sbin/dm-thin_check"

	# Configuration option dmeventd/thin_check_executable.
	# The full path to the thin_check command.
	# This configuration option has an automatic default value.
	# thin_check_executable = "/usr/sbin/thin_check"

	# Configuration option dmeventd/thin_dump_executable.
	# The full path to the thin_dump command.
	# This configuration option has an automatic default value.
	# thin_dump_executable = "/usr/sbin/thin_dump"

	# Configuration option dmeventd/thin_repair_executable.
	# The full path to the thin_repair command.
	# This configuration option has an automatic default value.
	# thin_repair_executable = "/usr/sbin/thin_repair"

	# Configuration option dmeventd/thin_restore_executable.
	# The full path to the thin_restore command.
	# This configuration option has an automatic default value.
	# thin_restore_executable = "/usr/sbin/thin_restore"

	# Configuration option dmeventd/thin_check_options.
	# List of options passed to the thin_check command.
	# This configuration option has an automatic default value.
	# thin_check_options = [ "-q", "--clear-needs-check-flag" ]

	# Configuration option dmeventd/thin_repair_options.
	# List of options passed to the thin_repair command.
	# This configuration option has an automatic default value.
	# thin_repair_options = [ "" ]

	# Configuration option dmeventd/thin_restore_options.
	# List of options passed to the thin_restore command.
	# This configuration option has an automatic default value.
	# thin_restore_options = [ "" ]
}
