{
  "firewall_enabled": true,
  "default_zone": "internal",
  "min_uid": 0,
  "max_uid": -1,
  "log_denied": "unicast",
  "auto_install": true,
  "backend": "nftables",
  "runtime_only": false,
  "max_connections": 2048,
  "ipv6_enabled": true,
  "direct_rules_enabled": false,
  "custom_config_paths": [
    "/etc/firewalld/zones.d",
    "/opt/security/zones"
  ],
  "runtime_config_paths": [
    "/run/firewalld/runtime.d"
  ]
}
