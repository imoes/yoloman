# KXStitch Configuration Template
#
# kxstitch is a text-based 3D modeling tool. This configuration file controls
# application behavior, interface settings, and file paths.
#
# This template is self-documenting. Every variable reference includes its
# schema default and a comment describing the field's purpose.

[general]
# The language locale for the user interface.
# Schema default: 'en'
locale = {{ locale | default('en') }}

# The path to the directory where kxstitch stores user preferences and caches.
# Schema default: '~/.kxstitch'
data_dir = {{ data_dir | default('~/.kxstitch') }}

# Enable debug logging. If true, verbose logs are written to stderr or the log file.
# Schema default: false
debug = {{ debug | default(false) }}

# The path to the log file for persistent logging. Empty or omitted disables file logging.
# Schema default: ''
log_file = {{ log_file | default('') }}

[interface]
# The window width in pixels.
# Schema default: 1024
window_width = {{ window_width | default(1024) }}

# The window height in pixels.
# Schema default: 768
window_height = {{ window_height | default(768) }}

# The theme identifier for the GUI (e.g., 'light', 'dark', 'system').
# Schema default: 'system'
theme = {{ theme | default('system') }}

# Show the startup welcome screen.
# Schema default: true
show_welcome = {{ show_welcome | default(true) }}

[rendering]
# The rendering engine backend (e.g., 'opengl', 'software').
# Schema default: 'opengl'
engine = {{ engine | default('opengl') }}

# The target frame rate for the viewport.
# Schema default: 60
target_fps = {{ target_fps | default(60) }}

# Enable anti-aliasing in the viewport.
# Schema default: true
antialiasing = {{ antialiasing | default(true) }}

[file_formats]
# List of additional file extensions to monitor or associate.
# Schema default: []
extra_extensions = {{ extra_extensions | default([]) | tojson }}

# Path to custom plugins or scripts directory.
# Schema default: ''
plugins_dir = {{ plugins_dir | default('') }}