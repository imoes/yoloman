{
  "installroot": "/",
  "debuglevel": 2,
  "errorlevel": 3,
  "logfilelevel": 9,
  "keepcache": false,
  "autocheck_running_kernel": true,
  "install_weak_deps": true,
  "clean_requirements_on_remove": true,
  "protect_running_kernel": true,
  "group_package_types": [
    "default",
    "mandatory"
  ],
  "installonlypkgs": [
    "kernel"
  ],
  "installonly_limit": 3,
  "excludepkgs": [],
  "exclude_from_weak": [],
  "exclude_from_weak_autodetect": true,
  "plugins": true,
  "assumeyes": false,
  "assumeno": false,
  "defaultyes": false,
  "exit_on_lock": false,
  "color": "auto",
  "diskspacecheck": true,
  "check_config_file_age": true,
  "zchunk": true,
  "deltarpm": true,
  "max_parallel_downloads": 3,
  "retries": 10,
  "timeout": 30,
  "minrate": "1000",
  "countme": false,
  "proxy": "",
  "proxy_auth_method": "any",
  "module_obsoletes": false,
  "module_stream_switch": false,
  "upgrade_group_objects_upgrade": true,
  "varsdir": [
    "/etc/dnf/vars"
  ],
  "reposdir": [
    "/etc/yum.repos.d"
  ],
  "repositories": [
    {
      "id": "fedora",
      "name": "Fedora 39 - x86_64",
      "enabled": true,
      "baseurl": [
        "https://download.fedoraproject.org/pub/fedora/linux/releases/39/Everything/x86_64/os/"
      ],
      "gpgkey": [
        "https://getfedora.org/static/fedora.gpg"
      ],
      "gpgcheck": true,
      "repo_gpgcheck": false,
      "priority": 10,
      "excludepkgs": []
    },
    {
      "id": "updates",
      "name": "Fedora 39 - Updates",
      "enabled": true,
      "metalink": "https://mirrors.fedoraproject.org/metalink?repo=fedora-updates-39&arch=x86_64",
      "gpgkey": [
        "https://getfedora.org/static/fedora.gpg"
      ],
      "gpgcheck": true,
      "repo_gpgcheck": false,
      "priority": 10,
      "metadata_expire": 21600,
      "skip_if_unavailable": true
    }
  ]
}
