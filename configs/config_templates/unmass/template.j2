# =============================================================================
# unmass Configuration Wrapper
# =============================================================================
#
# unmass is a CLI utility for extracting game archives (.lgp format).
# This template generates a shell script snippet or environment configuration
# that defines common defaults for unmass operations.
#
# The variables defined here act as the default context for the unmass CLI.
# =============================================================================

# -----------------------------------------------------------------------------
# Archive File Path
# The path to the game archive file to be processed by unmass.
# If a command-line argument specifies an archive, this value is overridden.
# -----------------------------------------------------------------------------
ARCHIVE_FILE: {{ archive_file|default('/var/lib/unmass/default_archive.lgp') }}

# -----------------------------------------------------------------------------
# Output Directory
# The directory where extracted files will be placed.
# Ensure this directory exists and is writable before running unmass.
# -----------------------------------------------------------------------------
OUTPUT_DIR: {{ output_dir|default('/var/lib/unmass/output') }}

# -----------------------------------------------------------------------------
# Files to Extract
# A list of specific filenames or patterns within the archive to extract.
# If this list is empty, the entire archive specified in ARCHIVE_FILE is extracted.
# Multiple items are separated by spaces when passed to the CLI.
# -----------------------------------------------------------------------------
FILES_TO_EXTRACT: {{ files_to_extract|default([])|join(' ') }}

# -----------------------------------------------------------------------------
# Verbosity Level
# Verbosity level for the unmass operation.
# 0 = quiet (errors only)
# 1 = normal (standard output)
# 2 = verbose (detailed debug information)
# -----------------------------------------------------------------------------
VERBOSE: {{ verbose|default(0) }}