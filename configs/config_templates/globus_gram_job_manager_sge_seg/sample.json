{
  "sge_enabled": true,
  "sge_qmaster_host": "sge-qmaster.example.edu",
  "sge_root": "/opt/gridengine",
  "sge_cell": "default",
  "sge_qmaster_spool_dir": "/var/lib/gridengine/spool/qmaster",
  "sge_execd_spool_dir": "/var/lib/gridengine/spool/execd",
  "job_manager_script": "/usr/libexec/globus-job-manager-sge",
  "job_manager_wrapper": "",
  "sge_allowed_queues": [
    "all.q",
    "batch.q",
    "highmem.q"
  ],
  "sge_default_queue": "batch.q",
  "sge_max_jobs_per_user": 50,
  "sge_max_walltime": 172800,
  "sge_max_cores_per_job": 128,
  "sge_use_resource_limits": true
}
