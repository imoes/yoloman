proto: amqp-rabbit
users:
  - username: {{ auth.default_user.username }}
    password: {{ auth.default_user.password_hash }} # {{ auth.default_user.username }} md5
tcp:
  ip: {{ server.listen.split(':')[0] }}
  port: {{ server.listen.split(':')[1] }}
  nodelay: false
  readBufSize: 196608
  writeBufSize: 196608
admin:
  ip: {{ server.listen.split(':')[0] }}
  port: {{ admin_port }}
queue:
  shardSize: {{ queue_shard_size }}
  maxMessagesInRam: {{ queue_max_messages_in_ram }}
db:
  defaultPath: {{ db_default_path }}
  engine: {{ db_engine }}
vhost:
  defaultPath: {{ vhosts[0].name }}
security:
  passwordCheck: {{ auth.method }}
connection:
  channelsMax: {{ connection.channels_max }}
  frameMaxSize: {{ connection.frame_max_size }}