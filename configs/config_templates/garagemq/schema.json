{
  "server": {
    "type": "object",
    "default": {
      "listen": "0.0.0.0:5672",
      "max_connections": 10000,
      "tls": {
        "enabled": false
      }
    },
    "description": "Core network server settings: listener address, max connections, and optional TLS.",
    "items": {
      "listen": {
        "type": "string",
        "default": "0.0.0.0:5672",
        "description": "IP and port to bind the AMQP listener (e.g., 127.0.0.1:5672 or [::]:5672)."
      },
      "max_connections": {
        "type": "number",
        "default": 10000,
        "description": "Maximum concurrent AMQP connections allowed."
      },
      "tls": {
        "type": "object",
        "default": {
          "enabled": false
        },
        "description": "TLS configuration for secure connections.",
        "items": {
          "enabled": {
            "type": "bool",
            "default": false,
            "description": "Enable TLS encryption for AMQP connections."
          },
          "cert_file": {
            "type": "string",
            "default": "/etc/garagemq/certs/server.crt",
            "description": "Path to the TLS certificate file (required if TLS enabled)."
          },
          "key_file": {
            "type": "string",
            "default": "/etc/garagemq/certs/server.key",
            "description": "Path to the TLS private key file (required if TLS enabled)."
          }
        }
      }
    }
  },
  "auth": {
    "type": "object",
    "default": {
      "enabled": false,
      "method": "plain",
      "password_file": "/etc/garagemq/users.yaml",
      "default_user": null
    },
    "description": "Authentication and authorization configuration.",
    "items": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "Enable authentication (required for production)."
      },
      "method": {
        "type": "string",
        "default": "plain",
        "description": "Authentication method: 'plain', 'scram-sha-256', or 'external'."
      },
      "password_file": {
        "type": "string",
        "default": "/etc/garagemq/users.yaml",
        "description": "Path to YAML file mapping usernames to password hashes (used by 'plain' and 'scram-sha-256')."
      },
      "default_user": {
        "type": "object",
        "default": null,
        "description": "Default user credentials and permissions (created automatically on first startup).",
        "items": {
          "username": {
            "type": "string",
            "default": "guest",
            "description": "Username for the default user."
          },
          "permissions": {
            "type": "object",
            "default": {
              "vhost": "/",
              "configure": ".*",
              "write": ".*",
              "read": ".*"
            },
            "description": "Permissions for the default user on the default vhost.",
            "items": {
              "vhost": {
                "type": "string",
                "default": "/",
                "description": "Target virtual host."
              },
              "configure": {
                "type": "string",
                "default": ".*",
                "description": "Regex for configure permission (e.g., '.*' for all)."
              },
              "write": {
                "type": "string",
                "default": ".*",
                "description": "Regex for write permission."
              },
              "read": {
                "type": "string",
                "default": ".*",
                "description": "Regex for read permission."
              }
            }
          }
        }
      }
    }
  },
  "vhosts": {
    "type": "list",
    "default": [
      {
        "name": "/"
      }
    ],
    "description": "List of virtual hosts (vhosts) \u2014 logical partitions for queues and exchanges.",
    "items": {
      "type": "object",
      "description": "A single vhost definition.",
      "items": {
        "name": {
          "type": "string",
          "default": "/",
          "description": "Name of the vhost (e.g., '/' for default, 'production' for isolation)."
        }
      }
    }
  },
  "log": {
    "type": "object",
    "default": {
      "level": "info",
      "output": "stdout"
    },
    "description": "Logging configuration.",
    "items": {
      "level": {
        "type": "string",
        "default": "info",
        "description": "Minimum log level: 'debug', 'info', 'warn', or 'error'."
      },
      "output": {
        "type": "string",
        "default": "stdout",
        "description": "Log output: 'stdout', 'stderr', or a file path (e.g., '/var/log/garagemq.log')."
      }
    }
  },
  "storage": {
    "type": "object",
    "default": {
      "driver": "memory",
      "path": "/var/lib/garagemq"
    },
    "description": "Persistence configuration.",
    "items": {
      "driver": {
        "type": "string",
        "default": "memory",
        "description": "Storage backend: 'memory' (ephemeral, for dev/test) or 'disk' (persistent, using BoltDB)."
      },
      "path": {
        "type": "string",
        "default": "/var/lib/garagemq",
        "description": "Directory for persistent data (used only when driver='disk')."
      }
    }
  },
  "cluster": {
    "type": "object",
    "default": {
      "enabled": false,
      "node_name": "garagemq-1",
      "peers": []
    },
    "description": "Multi-node cluster configuration (experimental).",
    "items": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "Enable clustering for high availability (requires disk storage)."
      },
      "node_name": {
        "type": "string",
        "default": "garagemq-1",
        "description": "Unique name for this node (e.g., 'garagemq-1@10.0.0.10')."
      },
      "peers": {
        "type": "list",
        "default": [],
        "description": "List of peer node addresses to form a cluster.",
        "items": {
          "type": "object",
          "items": {
            "address": {
              "type": "string",
              "default": "10.0.0.11:7946",
              "description": "Address of a cluster peer (IP:port, typically 7946 for Serf/Raft)."
            }
          }
        }
      }
    }
  },
  "metrics": {
    "type": "object",
    "default": {
      "enabled": true,
      "listen": "0.0.0.0:9090"
    },
    "description": "Prometheus-compatible metrics endpoint.",
    "items": {
      "enabled": {
        "type": "bool",
        "default": true,
        "description": "Enable metrics endpoint at /metrics."
      },
      "listen": {
        "type": "string",
        "default": "0.0.0.0:9090",
        "description": "Address to expose the /metrics endpoint (e.g., '127.0.0.1:9090' to restrict)."
      }
    }
  },
  "heartbeat": {
    "type": "number",
    "default": 60,
    "description": "AMQP heartbeat interval in seconds (server\u2192client keepalive)."
  },
  "frame_max": {
    "type": "number",
    "default": 131072,
    "description": "Maximum frame size in bytes (AMQP 0-9-1). Larger frames improve throughput but increase memory usage."
  },
  "max_channels": {
    "type": "number",
    "default": 2047,
    "description": "Maximum number of channels per connection (per client)."
  },
  "queue_ttl": {
    "type": "number",
    "default": 0,
    "description": "Default TTL (in milliseconds) for auto-delete queues (0 = no TTL)."
  }
}
