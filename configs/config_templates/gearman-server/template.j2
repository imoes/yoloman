# Defaults for gearman-server initscript
# sourced by /etc/init.d/gearman-server
# installed at /etc/default/gearman-server by the maintainer scripts

#
# This is a POSIX shell fragment
#

# Path to the PID file for the gearmand daemon.
# Default: /var/run/gearmand.pid
DAEMON_OPTS="-d --pidfile={{ pidfile | default('/var/run/gearmand.pid') }}"

# Whether to enable the gearmand server.
# Default: false
ENABLED="{{ enabled | default('false') }}"
