# glome-login configuration
# This file configures the glome-login service, which handles secure mesh authentication and session management.
# Core service behavior and authentication provider settings.
# Controls the main network interface used for glome-login.
listen_address = {{ listen_address }}
listen_port = {{ listen_port }}
# Enables or disables TLS encryption for connections.
use_tls = {{ use_tls }}
# Path to the TLS certificate chain file.
tls_cert_chain = {{ tls_cert_chain }}
# Path to the TLS private key file.
tls_private_key = {{ tls_private_key }}
# Path to the trusted CA certificate bundle for client verification.
tls_ca_bundle = {{ tls_ca_bundle }}
# Maximum number of concurrent client connections allowed.
max_connections = {{ max_connections }}
# Session timeout in seconds.
session_timeout = {{ session_timeout }}
# Number of worker threads for handling login requests.
worker_threads = {{ worker_threads }}
# Enable or disable debug logging.
debug = {{ debug }}
# Path to the log file; if empty, logs to stderr.
log_file = {{ log_file }}
# Authentication provider configuration.
# Each auth_provider block defines a backend authentication source.
{% for provider in auth_providers %}
[auth_provider]
name = {{ provider.name }}
type = {{ provider.type }}
endpoint = {{ provider.endpoint }}
# Optional: additional key=value pairs per provider.
{% for key, value in provider.options.items() %}{{ key }} = {{ value }}
{% endfor %}{% endfor %}