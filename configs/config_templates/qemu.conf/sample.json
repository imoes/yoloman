{
  "user": "qemu",
  "group": "qemu",
  "vnc_tls": true,
  "vnc_listen": "127.0.0.1",
  "spice_listen": "127.0.0.1",
  "spice_tls": true,
  "io_threads": 4,
  "migration": true,
  "migration_address": "10.0.0.5",
  "migration_port": 49152,
  "migration_ports": 128,
  "auto_memory_tune": true,
  "memory_backing": "hugepages",
  "image_paths": [
    "/var/lib/libvirt/images",
    "/mnt/ssd/images"
  ],
  "emulator": "",
  "sandbox": true,
  "use_cgroups": true,
  "max_vcpus": 128,
  "default_cpu_model": "host-passthrough",
  "hotplug": true,
  "monitor_stdin": false,
  "monitor_protocol": "json",
  "nvme_hotplug": true,
  "scsi_hotplug": true,
  "usb_hotplug": true,
  "default_video_model": "qxl",
  "numa_auto_allocation": true,
  "uefi_firmware": true,
  "uefi_firmware_paths": [
    {
      "path": "/usr/share/OVMF/OVMF_CODE.fd",
      "description": "x86_64 UEFI firmware"
    },
    {
      "path": "/usr/share/AAVMF/AAVMF_CODE.fd",
      "description": "AArch64 UEFI firmware"
    }
  ],
  "netns": true,
  "default_dns": "192.168.122.1",
  "auto_bridge": true,
  "auto_bridge_name": "virbr1",
  "seccomp_sandbox": true,
  "vhost_user": true,
  "vhost_user_socket_dir": "/var/run/vhost-user",
  "tee": false,
  "tpm": true,
  "default_tpm_backend": "emulator",
  "live_snapshot": true,
  "shared_block": false,
  "log_level": 2,
  "log_output": "file",
  "log_file": "/var/log/qemu/qemu.log"
}
