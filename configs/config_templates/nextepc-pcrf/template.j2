# NextEPC PCRF Configuration Template
# This file configures the Policy and Charging Rules Function (PCRF)
# component of the NextEPC EPC suite.

# ==============================================================================
# Database Connection Settings
# ==============================================================================

# Path to the MongoDB connection URI for NextEPC data storage.
# Includes host, port, database name, and optional authentication credentials.
db_uri: {{ db_uri | default('mongodb://localhost/nextepc') }}

# ==============================================================================
# Logging Configuration
# ==============================================================================

logger:
    # Path to the PCRF log file.
    file: {{ logger_file | default('/var/log/nextepc/pcrf.log') }}
    
    # Trace settings for detailed debugging.
    trace: 
        # Enable application-level tracing.
        # 1 = On, 0 = Off
        app: {{ logger_trace_app | default('1') }}
        
        # Enable Diameter protocol tracing.
        # 1 = On, 0 = Off
        diameter: {{ logger_trace_diameter | default('1') }}

# ==============================================================================
# General Parameters
# ==============================================================================

parameter:
    # Additional parameter placeholders can be added here as needed.
    # Currently empty in the base schema.

# ==============================================================================
# PCRF Specific Settings
# ==============================================================================

pcrf:
    # Path to the freeDiameter configuration file for PCRF.
    # This file defines the Diameter stack parameters for the PCRF.
    freeDiameter: {{ pcrf_freeDiameter | default('/etc/nextepc/freeDiameter/pcrf.conf') }}
