{
  "db_uri": {
    "type": "string",
    "default": "mongodb://localhost/nextepc",
    "description": "MongoDB connection URI for NextEPC data."
  },
  "logger_file": {
    "type": "string",
    "default": "/var/log/nextepc/pcrf.log",
    "description": "Path to the PCRF log file."
  },
  "logger_trace_app": {
    "type": "number",
    "default": 1,
    "description": "Enable application tracing (1=on, 0=off)."
  },
  "logger_trace_diameter": {
    "type": "number",
    "default": 1,
    "description": "Enable Diameter protocol tracing (1=on, 0=off)."
  },
  "pcrf_freeDiameter": {
    "type": "string",
    "default": "/etc/nextepc/freeDiameter/pcrf.conf",
    "description": "Path to the freeDiameter configuration file for PCRF."
  }
}
