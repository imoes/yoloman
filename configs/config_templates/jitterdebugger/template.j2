# JitterDebugger Configuration File
# This file defines runtime parameters for jitterdebugger.

# Verbosity: Enable live updates of measurements to STDOUT (true/false)
# Schema: verbose (bool, default: False)
verbose={{ verbose | default(False) | lower }}

# Output File: Write JSON results to this FILE path instead of STDOUT
# Schema: output_file (string, default: '/var/log/jitterdebugger/results.json')
output_file={{ output_file | default('/var/log/jitterdebugger/results.json') }}

# Run Duration: Measure for N seconds (e.g., '30s', '5m'). Omit to run until terminated.
# Schema: run_duration (string, default: '0s')
run_duration={{ run_duration | default('0s') }}

# Loop Count: Run measurements N times and terminate. Omit to run continuously.
# Schema: loop_count (int, default: 0)
loop_count={{ loop_count | default(0) }}

# Break Condition: Stop if latency >= N microseconds.
# Schema: break_latency_us (int, default: 0)
break_latency_us={{ break_latency_us | default(0) }}

# Interval: Sleep time between each measurement in microseconds.
# Schema: interval_us (int, default: 1000)
interval_us={{ interval_us | default(1000) }}

# CPU Affinity: Comma-separated list or range of CPUs (e.g., '0-3', '0,2,5').
# Empty string means all available CPUs.
# Schema: cpu_affinity (string, default: '')
cpu_affinity={{ cpu_affinity | default('') }}

# Priority: Real-time priority of measuring threads (1-98). 98 is high priority.
# Schema: priority (int, default: 98)
priority={{ priority | default(98) }}

# UDP Server: Send samples to SERVER:PORT via UDP. Empty string disables UDP.
# Schema: udp_server (string, default: '')
udp_server={{ udp_server | default('') }}

# Background Command: Start CMD in background during measurement. Empty string disables.
# Schema: background_command (string, default: '')
background_command={{ background_command | default('') }}

# Output Directory: Write binary samples.raw and metadata to DIR. Empty string disables file output.
# Schema: output_dir (string, default: '')
output_dir={{ output_dir | default('') }}