# ==============================================================================
# nghttp2_server Configuration Template
# Self-documented: Every directive includes its schema description as a comment.
# ==============================================================================

# Listen on specified IPv4/IPv6 address (e.g., 0.0.0.0 or ::1).
listen_addr = {{ (listen_addr | default('0.0.0.0')) | string }}

# Port to listen on (e.g., 8443 for HTTPS or 8080 for HTTP).
listen_port = {{ listen_port | default(8443) }}

# Number of worker processes to spawn (typically 1–2 per CPU core).
worker_processes = {{ worker_processes | default(2) }}

# Maximum simultaneous connections allowed per worker process.
max_connections = {{ max_connections | default(1024) }}

# SSL/TLS configuration block (only rendered if ssl_enabled is true).
{% if ssl_enabled | default(true) | bool %}
# Path to the SSL certificate chain file (PEM format). Only used if ssl_enabled is true.
ssl_cert_file = {{ (ssl_cert_file | default('/etc/ssl/certs/server.crt')) | string }}

# Path to the SSL private key file (PEM format). Only used if ssl_enabled is true.
ssl_key_file = {{ (ssl_key_file | default('/etc/ssl/private/server.key')) | string }}
{% endif %}

# Enable cleartext HTTP/2 (h2c) without TLS. Not recommended for production.
{% if h2c_enabled | default(false) | bool %}
# Cleartext HTTP/2 is enabled.
h2c_enabled = true
{% else %}
# Cleartext HTTP/2 is disabled.
h2c_enabled = false
{% endif %}

# Buffer size (in bytes) for incoming HTTP request headers and body.
request_buffer_size = {{ request_buffer_size | default(65536) }}

# Buffer size (in bytes) for outgoing HTTP response headers and body.
response_buffer_size = {{ response_buffer_size | default(262144) }}

# Idle connection timeout (in seconds).
timeout_idle = {{ timeout_idle | default(600) }}

# Timeout for receiving complete HTTP request headers (in seconds).
timeout_request = {{ timeout_request | default(30) }}

# Timeout for sending complete HTTP response (in seconds).
timeout_response = {{ timeout_response | default(300) }}

# Logging verbosity: debug, info, warn, error, or fatal.
log_level = {{ (log_level | default('info')) | string | lower }}

# Path to the main log file.
log_file = {{ (log_file | default('/var/log/nghttp2/nghttp2.log')) | string }}

# Optional custom access log format (e.g., combined, combined_json, or custom string). If omitted, default combined format is used.
{% if (access_log_format | default(None)) is not none %}
# Custom access log format specified.
access_log_format = {{ access_log_format | string }}
{% endif %}

# List of directories to serve as static content (e.g., for static websites or API docs).
{% if (static_dirs | default([])) | length > 0 %}
# Served static content directories.
{% for entry in static_dirs %}
# Static directory: {{ entry.path }} served at prefix {{ entry.prefix }}
static_dir = {{ entry.path }} {{ entry.prefix }}
{% endfor %}
{% endif %}

# List of backend servers to use as reverse proxy upstreams (one per group).
{% if (upstreams | default([])) | length > 0 %}
# Backend server definitions for reverse proxy.
{% for upstream in upstreams %}
# Upstream group: {{ upstream.name }} pointing to {{ upstream.host }}:{{ upstream.port }}
upstream = {{ upstream.name }} {{ upstream.host }}:{{ upstream.port }}
{% endfor %}
{% endif %}

# Name of the upstream group to use as fallback for unmatched requests. Omit for static-only mode.
{% if (default_upstream | default(None)) is not none %}
default_upstream = {{ default_upstream | string }}
{% endif %}

# Initial peer connection flow control window size (in bytes) per HTTP/2 stream.
initial_window_size = {{ initial_window_size | default(65535) }}

# Maximum size (in bytes) of an HTTP/2 frame to accept.
max_frame_size = {{ max_frame_size | default(16384) }}

# Enable HTTP/2 server push (resource preloading). Requires client support.
{% if server_push_enabled | default(false) | bool %}
# Server push is enabled.
server_push_enabled = true
{% else %}
# Server push is disabled.
server_push_enabled = false
{% endif %}