# Configuration for irqtop
# This template generates a command-line configuration snippet for irqtop,
# an interactive interrupt statistics display utility.
# Each option corresponds to a command-line flag.
# Ensure all variables are defined in your Ansible inventory or role defaults.

# Refresh interval in seconds for the display update.
# Controls how frequently the screen is refreshed with new data.
--delay={{ irqtop_delay | default(2) }}

# Display SoftIRQs only if true, otherwise show all or hardware IRQs.
# SoftIRQs are software-generated interrupts (e.g., network packets).
--softirq={{ irqtop_softirq | default(false) | lower }}

# Display hardware IRQs only (takes precedence over --softirq if both were somehow active, though mutually exclusive in logic).
# Hardware IRQs are generated by physical devices (e.g., NICs, disks).
--irq={{ irqtop_irq | default(false) | lower }}

# Enable extra Ethernet stats (from ethtool) if true.
# Requires ethtool to be installed and accessible.
--eth={{ irqtop_eth | default(false) | lower }}

# Enable display of RPS/XPS affinity if true.
# RPS (Receive Packet Steering) and XPS (Transmit Packet Steering) are kernel networking features.
--rps={{ irqtop_rps | default(false) | lower }}

# Output in table mode if true, otherwise flat top mode.
# Table mode provides a structured view of interrupt distribution.
--table={{ irqtop_table | default(true) | lower }}

# Run in batch mode (non-interactive) if true.
# In batch mode, output is printed once and exits, suitable for scripting.
--batch={{ irqtop_batch | default(false) | lower }}

# Reverse the sort order if true.
# Changes the order of interrupts from least to most frequent.
--reverse={{ irqtop_reverse | default(false) | lower }}

# Disable colors if true.
# Useful for non-color terminals or when piping output to other tools.
--nocolor={{ irqtop_nocolor | default(false) | lower }}