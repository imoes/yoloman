{
  "irqtop_delay": {
    "type": "number",
    "default": 2,
    "description": "Refresh interval in seconds"
  },
  "irqtop_softirq": {
    "type": "bool",
    "default": false,
    "description": "Select softirqs only"
  },
  "irqtop_irq": {
    "type": "bool",
    "default": false,
    "description": "Select hardware irqs only"
  },
  "irqtop_eth": {
    "type": "bool",
    "default": false,
    "description": "Show extra eth stats"
  },
  "irqtop_rps": {
    "type": "bool",
    "default": false,
    "description": "Enable display of rps/xps"
  },
  "irqtop_table": {
    "type": "bool",
    "default": true,
    "description": "Output in table mode (default)"
  },
  "irqtop_batch": {
    "type": "bool",
    "default": false,
    "description": "Output non-interactively"
  },
  "irqtop_reverse": {
    "type": "bool",
    "default": false,
    "description": "Reverse sort order"
  },
  "irqtop_nocolor": {
    "type": "bool",
    "default": false,
    "description": "Disable colors"
  }
}
