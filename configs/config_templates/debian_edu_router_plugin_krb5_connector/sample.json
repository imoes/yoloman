{
  "enabled": true,
  "krb5_conf": "/etc/krb5.conf",
  "keytab_path": "/etc/krb5kdc/router.keytab",
  "service_principal": "HTTP/debianedu-router.internal@INTERNAL.EDU",
  "realm": "INTERNAL.EDU",
  "kdcs": [
    {
      "host": "kdc1.internal.edu",
      "port": null
    },
    {
      "host": "kdc2.internal.edu",
      "port": null
    }
  ],
  "admin_server": {
    "host": "kdc1.internal.edu",
    "port": null
  },
  "default_lifetime": 24,
  "max_renewable_lifetime": 168,
  "enable_dns_realms": false,
  "canonicalize": true,
  "log_level": "INFO",
  "log_file": "/var/log/krb5-connector.log",
  "ldaps": [
    {
      "host": "ldap.internal.edu",
      "port": 389
    }
  ],
  "ldap_bind_dn": "cn=proxyuser,dc=internal,dc=edu",
  "ldap_bind_password_file": "/etc/krb5-connector/ldap_pass",
  "ldap_search_base": "dc=internal,dc=edu",
  "ldap_user_filter": "(krbPrincipalName=%u)",
  "enable_tls": true,
  "ca_cert_path": "/etc/ssl/certs/ca-certificates.crt",
  "client_cert_path": "",
  "client_key_path": "",
  "verify_tls": true,
  "max_connections": 100,
  "connect_timeout": 15,
  "request_timeout": 45,
  "retry_count": 3,
  "fallback_to_tcp": true,
  "prefer_udp": true,
  "enable_fast": true,
  "fast_armor_cache": "FILE:/run/krb5/krb5_fast_armor",
  "preauth_types": [
    "18",
    "19"
  ]
}
