{
 "bounce_sender": "bounce@company.example.com",
 "connect_timeout": 30,
 "data_timeout": 300,
 "listen_addresses": [
  "127.0.0.1:25",
  "192.168.1.10:25"
 ],
 "local_hostname": "esmtp-relay.local",
 "retry_backoff": 2,
 "retry_interval": 3600,
 "retry_max": 5,
 "routes": [
  {
   "domain": "*",
   "next_hop": "smtp-relay.example.com",
   "port": 587
  }
 ],
 "sender_maps": [
  {
   "pattern": "^(.*)@internal.local$",
   "replacement": "\\1@company.example.com"
  }
 ],
 "session_timeout": 600,
 "starttls_enabled": true,
 "tls_ca_file": "/etc/ssl/certs/ca-certificates.crt",
 "tls_cert_chain": "/etc/esmtp/tls/relay.crt",
 "tls_enabled": true,
 "tls_key": "/etc/esmtp/tls/relay.key",
 "verbosity": 1
}
