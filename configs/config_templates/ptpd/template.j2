# /etc/default/ptpd
# Configuration file for the Precision Time Protocol daemon (ptpd).
# Managed by Ansible.

# Start the PTP daemon on service startup.
# Type: boolean
# Default: true
#
# When set to 'yes', the init script or service manager will
# attempt to start the ptpd process during boot.
START_DAEMON={{ enabled | default(true) | lower }}

# Add command line options to pass to ptpd.
# Type: string
# Default: '' (empty)
#
# Use this variable to configure interface, domain, and other
# runtime flags. For example: "--interface eth0 --domain 0".
# Ensure options are space-separated within the quotes.
PTPD_OPTS="{{ PTPD_OPTS | default('') }}"