{
  "enabled": true,
  "interface": "eth1",
  "clock_id": "",
  "domain": 0,
  "mode": "auto",
  "allow_multiple_masters": true,
  "announce_interval": 1.0,
  "sync_interval": 1.0,
  "min_delay_req_interval": 0.25,
  "hardware_timestamping": true,
  "utc_offset": 37,
  "clock_device": "/dev/ptp0",
