# Configuration for makefile2graph
# This file configures makefile2graph, a tool that parses Makefiles and generates dependency graphs
# in Graphviz DOT format.

# The output graph format. makefile2graph specifically generates Graphviz DOT format.
# Allowed values depend on the Graphviz installation, but 'dot' is the standard default.
format: {{ format | default('dot') }}

# The command used to invoke GNU Make.
# This is the executable that makefile2graph will call to analyze dependencies.
make_cmd: {{ make_cmd | default('make') }}

# The path to the Makefile to parse for dependencies.
# If relative, it is relative to the current working directory at runtime.
makefile_path: {{ makefile_path | default('Makefile') }}

# If true, behaves as if all targets were remade from scratch (-B/--always-make).
# This forces a full re-evaluation of dependencies.
always_make: {{ always_make | default(false) }}

# The destination for the generated graph.
# Use 'stdout' to print the DOT output to the console, or provide a file path to save it.
output: {{ output | default('stdout') }}