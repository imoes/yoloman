{
  "machine_name": {
    "type": "string",
    "default": "my-machine",
    "description": "Unique name for this LinuxCNC instance (used in GUI and log messages)."
  },
  "debug_level": {
    "type": "number",
    "default": 0,
    "description": "Debug verbosity level (0 = no debug, higher values increase debug output). Use 0x7fff for maximum."
  },
  "display": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "default": "LinuxCNC",
        "description": "Display name shown in GUI title bar."
      },
      "editor": {
        "type": "string",
        "default": "gedit",
        "description": "Editor used for editing G-code files from the GUI."
      },
      "max_feed_override": {
        "type": "number",
        "default": 120,
        "description": "Maximum feed rate override as a percentage (e.g., 120 = 120%)."
      },
      "min_feed_override": {
        "type": "number",
        "default": 50,
        "description": "Minimum feed rate override as a percentage (e.g., 50 = 50%)."
      },
      "max_spindle_override": {
        "type": "number",
        "default": 120,
        "description": "Maximum spindle speed override as a percentage."
      },
      "min_spindle_override": {
        "type": "number",
        "default": 50,
        "description": "Minimum spindle speed override as a percentage."
      },
      "max_linear_velocity": {
        "type": "number",
        "default": 50.0,
        "description": "Maximum linear velocity allowed (units/sec)."
      },
      "default_linear_velocity": {
        "type": "number",
        "default": 5.0,
        "description": "Default linear jog speed (units/sec)."
      },
      "max_angular_velocity": {
        "type": "number",
        "default": 360.0,
        "description": "Maximum angular (rotary) jog speed (degrees/sec)."
      },
      "default_angular_velocity": {
        "type": "number",
        "default": 30.0,
        "description": "Default angular jog speed (degrees/sec)."
      },
      "open_file": {
        "type": "string",
        "default": "",
        "description": "Starting directory or file path prefix for the file selector. Empty = default location."
      },
      "tool_offset_mode": {
        "type": "number",
        "default": 1,
        "description": "Tool offset mode: 0=none, 1=relative, 2=absolute."
      },
      "units": {
        "type": "string",
        "enum": [
          "metric",
          "imperial"
        ],
        "default": "metric",
        "description": "Machine units: 'metric' (mm) or 'imperial' (inch)."
      },
      "max_zoom": {
        "type": "number",
        "default": 1000,
        "description": "Maximum zoom level (percentage)."
      },
      "min_zoom": {
        "type": "number",
        "default": 10,
        "description": "Minimum zoom level (percentage)."
      },
      "position_update": {
        "type": "number",
        "default": 10,
        "description": "GUI position update rate (Hz). Higher values increase responsiveness."
      },
      "status_update": {
        "type": "number",
        "default": 5,
        "description": "Status message update interval (Hz)."
      },
      "pyvcp_precision": {
        "type": "number",
        "default": 4,
        "description": "Decimal places for numeric displays in PyVCP panels."
      },
      "hide_mdi_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the MDI button in the GUI."
      },
      "hide_manual_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Manual button in the GUI."
      },
      "hide_auto_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Auto (Auto/MDI) button in the GUI."
      },
      "hide_setup_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Setup button."
      },
      "hide_preferences_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Preferences button."
      },
      "hide_tools_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Tools button."
      },
      "hide_statistics_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Statistics button."
      },
      "hide_diagnostics_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Diagnostics button."
      },
      "hide_help_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Help button."
      },
      "hide_system_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the System button."
      },
      "hide_utilities_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Utilities button."
      },
      "hide_settings_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Settings button."
      },
      "hide_config_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Config button."
      },
      "hide_about_button": {
        "type": "boolean",
        "default": false,
        "description": "Hide the About button."
      },
      "hide_status_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Status tab."
