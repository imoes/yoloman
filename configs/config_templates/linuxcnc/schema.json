      },
      "hide_about_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the About tab."
      },
      "hide_welcome_screen": {
        "type": "boolean",
        "default": false,
        "description": "Hide the welcome screen on startup."
      },
      "hide_splash_screen": {
        "type": "boolean",
        "default": false,
        "description": "Hide the splash screen."
      },
      "hide_tooltip": {
        "type": "boolean",
        "default": false,
        "description": "Hide tooltips in the display."
      },
      "hide_grid": {
        "type": "boolean",
        "default": false,
        "description": "Hide the coordinate grid in the view."
      },
      "hide_axes": {
        "type": "boolean",
        "default": false,
        "description": "Hide axis indicators in the view."
      },
      "hide_machine_limits": {
        "type": "boolean",
        "default": false,
        "description": "Hide machine limits bounds in the view."
      },
      "hide_workpiece_bounds": {
        "type": "boolean",
        "default": false,
        "description": "Hide workpiece bounds in the view."
      },
      "hide_tool_path_preview": {
        "type": "boolean",
        "default": false,
        "description": "Hide tool path preview in the view."
      },
      "hide_tool_length_offset_preview": {
        "type": "boolean",
        "default": false,
        "description": "Hide tool length offset preview."
      },
      "hide_coordinate_system_preview": {
        "type": "boolean",
        "default": false,
        "description": "Hide coordinate system preview."
      },
      "hide_tool_preview": {
        "type": "boolean",
        "default": false,
        "description": "Hide tool preview."
      },
      "hide_workpiece_preview": {
        "type": "boolean",
        "default": false,
        "description": "Hide workpiece preview."
      },
      "hide_machine_preview": {
        "type": "boolean",
        "default": false,
        "description": "Hide machine model preview."
      },
      "hide_simulation_preview": {
        "type": "boolean",
        "default": false,
        "description": "Hide simulation preview."
      },
      "hide_path_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide path overlay."
      },
      "hide_trajectory_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide trajectory overlay."
      },
      "hide_velocity_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide velocity overlay."
      },
      "hide_acceleration_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide acceleration overlay."
      },
      "hide_jerk_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide jerk overlay."
      },
      "hide_error_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide error overlay."
      },
      "hide_warning_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide warning overlay."
      },
      "hide_info_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide info overlay."
      },
      "hide_debug_overlay": {
        "type": "boolean",
        "default": false,
        "description": "Hide debug overlay."
      }
    }
  },
  "emcmot": {
    "type": "object",
    "properties": {
      "timeout": {
        "type": "number",
        "default": 1.0,
        "description": "Maximum time (sec) to wait for responses from the motion controller."
      },
      "base_period": {
        "type": "number",
        "default": 1000000,
        "description": "Base timing period for the motion controller (nanoseconds). Must match the HAL base period."
      },
      "motion_type": {
        "type": "number",
        "default": 1,
        "description": "Motion controller type: 0=legacy (old), 1=mk2 (current)."
      },
      "segments": {
        "type": "number",
        "default": 100,
        "description": "Number of G-code segments to buffer ahead for smoothing."
      },
      "lookahead": {
        "type": "number",
        "default": 0.1,
        "description": "Lookahead time (sec) for velocity smoothing."
      },
      "tp_type": {
        "type": "number",
        "default": 0,
        "description": "Trajectory planner type: 0=linear, 1=circular (circular requires special G-codes)."
      },
      "max_velocity": {
        "type": "number",
        "default": 100.0,
        "description": "Maximum velocity allowed (units/sec)."
      },
      "max_acceleration": {
        "type": "number",
        "default": 1000.0,
        "description": "Maximum acceleration (units/sec\u00b2)."
      },
      "default_velocity": {
        "type": "number",
        "default": 10.0,
        "description": "Default velocity for motions (units/sec)."
      },
      "default_acceleration": {
        "type": "number",
        "default": 500.0,
        "description": "Default acceleration (units/sec\u00b2)."
      }
    }
  },
  "hostmot": {
    "type": "object",
    "properties": {
      "driver": {
        "type": "string",
        "default": "hm2_pci",
        "description": "HostMot2 driver name (e.g., 'hm2_pci', 'hm2_rpspi', 'hm2_eth')."
      },
      "board": {
        "type": "string",
        "default": "0",
        "description": "Board instance number (e.g., '0' for first board)."
      },
      "config": {
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "description": "Driver-specific configuration options (e.g., ['num_encoders=4', 'num_pwms=2'])."
      },
      "ipaddr": {
        "type": "string",
        "default": "",
        "description": "IP address for Ethernet HostMot boards. Leave blank for non-Ethernet boards."
      }
    }
  },
  "hal": {
    "type": "object",
    "properties": {
      "halfiles": {
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "description": "List of HAL configuration files to load (e.g., ['core.hal', 'io.hal'])."
      },
      "postgui_halfile": {
        "type": "string",
        "default": "",
        "description": "HAL file loaded *after* GUI startup (for postgui-only components)."
      },
      "halui": {
        "type": "string",
        "default": "",
        "description": "HALUI script file (executed before postgui halfile)."
      }
    }
  },
  "rs274ngc": {
    "type": "object",
    "properties": {
      "parameter_file": {
        "type": "string",
        "default": "",
        "description": "Parameter file for RS274NGC interpreter (empty = use internal defaults)."
      },
      "subroutine_path": {
        "type": "list",
        "default": [
          "/usr/share/linuxcnc/ncfiles/subroutines"
        ],
        "items": {
          "type": "string"
        },
        "description": "List of directories to search for G-code subroutines."
      },
      "encoding": {
        "type": "string",
        "default": "utf-8",
        "description": "File encoding used for G-code files."
      },
      "log_level": {
        "type": "number",
        "default": 0,
        "description": "Log level for RS274NGC interpreter: 0=none, 1=error, 2=warning, 3=info."
      }
    }
  },
  "emcio": {
    "type": "object",
    "properties": {
      "tool_changer_type": {
        "type": "number",
        "default": 0,
        "description": "Tool changer type: 0=none, 1=carousel, 2=chain, 3=pallete."
      },
      "tool_toolkit": {
        "type": "number",
        "default": 20,
        "description": "Number of tool pockets in the magazine."
      },
      "tool_change_position": {
        "type": "list",
        "default": [
          0.0,
          0.0,
          0.0
        ],
        "items": {
          "type": "number"
        },
        "description": "X, Y, Z coordinates of tool change position (machine units)."
      },
      "tool_change_spindle_speed": {
        "type": "number",
        "default": 500,
        "description": "Spindle speed (RPM) to use during tool change."
      },
      "tool_change_approach": {
        "type": "number",
        "default": 5.0,
        "description": "Approach distance (units) before tool change."
      },
      "tool_change_retract": {
        "type": "number",
        "default": 2.0,
        "description": "Retract distance (units) after tool change."
      },
      "tool_change_wait": {
        "type": "number",
        "default": 0.0,
        "description": "Wait time (sec) after tool change before resuming motion."
      },
      "tool_change_sequence": {
        "type": "string",
        "default": "",
        "description": "Optional file defining custom tool change sequence."
      },
      "tool_table": {
        "type": "string",
        "default": "tool.tbl",
        "description": "Filename of the tool table (e.g., 'tool.tbl') in the config directory."
      }
    }
  },
  "python": {
    "type": "object",
    "properties": {
      "enable": {
        "type": "boolean",
        "default": false,
        "description": "Enable Python scripting in LinuxCNC."
      },
      "path": {
        "type": "list",
        "default": [
          "/usr/share/linuxcnc",
          "."
        ],
        "items": {
          "type": "string"
        },
        "description": "Colon-separated list of directories for Python module search path."
      },
      "preload": {
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "description": "Comma-separated list of Python modules to preload at startup."
      }
    }
  },
  "log": {
    "type": "object",
    "properties": {
      "level": {
        "type": "number",
        "default": 3,
        "description": "Log level: 0=none, 1=error, 2=warning, 3=info, 4=debug."
      },
      "file": {
        "type": "string",
        "default": "",
        "description": "Path to write log file (empty = write to stderr)."
      },
      "syslog": {
        "type": "boolean",
        "default": false,
        "description": "Send logs to system log (syslog) in addition to file/stderr."
      },
      "console": {
        "type": "boolean",
        "default": true,
        "description": "Echo logs to console (stdout) in addition to file/stderr."
      },
      "rotate": {
        "type": "number",
        "default": 10485760,
        "description": "Maximum log file size (bytes) before rotation. 0 = no rotation."
      },
      "max_rotated": {
        "type": "number",
        "default": 5,
        "description": "Maximum number of rotated log files to keep."
      }
    }
  }
}
