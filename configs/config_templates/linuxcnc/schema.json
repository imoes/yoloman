        "default": false,
        "description": "Hide the Auto tab."
      },
      "hide_setup_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Setup tab."
      },
      "hide_tools_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Tools tab."
      },
      "hide_statistics_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Statistics tab."
      },
      "hide_diagnostics_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Diagnostics tab."
      },
      "hide_help_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Help tab."
      },
      "hide_system_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the System tab."
      },
      "hide_utilities_tab": {
        "type": "boolean",
        "default": false,
        "description": "Hide the Utilities tab."
      },
      "hide_settings_tab": {
