# Hide or show preferences button (true/false)
HIDE_PREFERENCES_BUTTON = {{ '1' if display.hide_preferences_button else '0' }}

# Hide or show tools button (true/false)
HIDE_TOOLS_BUTTON = {{ '1' if display.hide_tools_button else '0' }}

# Hide or show statistics button (true/false)
HIDE_STATISTICS_BUTTON = {{ '1' if display.hide_statistics_button else '0' }}

# Hide or show diagnostics button (true/false)
HIDE_DIAGNOSTICS_BUTTON = {{ '1' if display.hide_diagnostics_button else '0' }}

