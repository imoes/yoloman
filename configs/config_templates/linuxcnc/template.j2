[EMCMOT]
# Emcmot (motion controller) section configuration.
{% set _emcmot = emcmot | default({}) %}
# Timeout for communications with motion controller (sec)
EMCMOT_TIMEOUT = {{ _emcmot.timeout | default('5') }}

# Base task period (sec) — must match HAL period
EMCMOT_BASE_PERIOD = {{ _emcmot.base_period | default('0.001') }}

# Motion controller type: 0=legacy, 1=mk2
EMCMOT_MOTION_TYPE = {{ _emcmot.motion_type | default('1') }}

# Number of motion segments to buffer
EMCMOT_SEGMENTS = {{ _emcmot.segments | default('1000') }}

# Lookahead time (sec) for smoothing
EMCMOT_LOOKAHEAD = {{ _emcmot.lookahead | default('0.1') }}

# Trajectory planner type: 0=linear, 1=circular
EMCMOT_TP_TYPE = {{ _emcmot.tp_type | default('0') }}

# Maximum velocity (units/sec)
EMCMOT_MAX_VELOCITY = {{ _emcmot.max_velocity | default('100') }}

# Maximum acceleration (units/sec²)
EMCMOT_MAX_ACCELERATION = {{ _emcmot.max_acceleration | default('1000') }}

# Default velocity (units/sec)
EMCMOT_DEFAULT_VELOCITY = {{ _emcmot.default_velocity | default('50') }}

# Default acceleration (units/sec²)
EMCMOT_DEFAULT_ACCELERATION = {{ _emcmot.default_acceleration | default('500') }}

[HOSTMOT]
# HostMot (HAL driver) section configuration.
{% set _hostmot = hostmot | default({}) %}
# HostMot driver name (e.g., 'hm2_pci', 'hm2_rpspi')
DRIVER = {{ _hostmot.driver | default('') }}

# Board name or instance (e.g., '0' for single-board systems)
BOARD = {{ _hostmot.board | default('0') }}

# Config string passed to driver (e.g., 'num_encoders=4 num_pwms=2 num_stepgen=5')
CONFIG = {{ _hostmot.config | default([]) | join(' ') }}

# IP address for Ethernet boards (e.g., '192.168.1.100')
IPADDR = {{ _hostmot.ipaddr | default('') }}

[HAL]
# HAL (Hardware Abstraction Layer) configuration.
{% set _hal = hal | default({}) %}
# HAL configuration file(s) — listed as a list, rendered as multiple lines.
{% for halfile in _hal.halfiles | default([]) %}HALFILE = {{ halfile }}
{% endfor %}
# Post-run HAL file (executed after main halfile(s))
POSTGUI_HALFILE = {{ _hal.postgui_halfile | default('') }}

# HALUI script (executed before postgui halfile)
HALUI = {{ _hal.halui | default('') }}

[RS274NGC]
# RS274NGC (G-code interpreter) section configuration.
{% set _rs274ngc = rs274ngc | default({}) %}
# Number of parameters in RS274NGC interpreter (path to parameter file)
PARAMETER_FILE = {{ _rs274ngc.parameter_file | default('') }}

# Subroutine search paths (colon-separated)
SUBROUTINE_PATH = {{ _rs274ngc.subroutine_path | default([]) | join(':') }}

# G-code file encoding (e.g., 'utf-8')
ENCODING = {{ _rs274ngc.encoding | default('utf-8') }}

# Log file for RS274NGC interpreter (level)
LOG_LEVEL = {{ _rs274ngc.log_level | default('0') }}

[EMCIO]
# EMCIO (I/O) section configuration.
{% set _emcio = emcio | default({}) %}
# Tool changer type: 0=none, 1=carousel, 2=chain, 3=pallete
TOOL_CHANGER_TYPE = {{ _emcio.tool_changer_type | default('0') }}

# Number of tool pockets in magazine (tool toolkit)
TOOL_TOOLKIT = {{ _emcio.tool_toolkit | default('0') }}

# Tool change position (X,Y,Z in machine units, space-separated)
TOOL_CHANGE_POSITION = {{ _emcio.tool_change_position | default('0 0 0') }}

# Tool change spindle speed (RPM)
TOOL_CHANGE_SPINDLE_SPEED = {{ _emcio.tool_change_spindle_speed | default('0') }}

# Tool change approach distance
TOOL_CHANGE_APPROACH = {{ _emcio.tool_change_approach | default('0') }}

# Tool change retract distance
TOOL_CHANGE_RETRACT = {{ _emcio.tool_change_retract | default('0') }}

# Tool change wait time (sec)
TOOL_CHANGE_WAIT = {{ _emcio.tool_change_wait | default('0') }}

# Tool changer sequence file (optional)
TOOL_CHANGE_SEQUENCE = {{ _emcio.tool_change_sequence | default('') }}

# Tool table file (e.g., 'tool.tbl')
TOOL_TABLE = {{ _emcio.tool_table | default('tool.tbl') }}

[PYTHON]
# Python interpreter integration section.
{% set _python = python | default({}) %}
# Enable Python support (true/false)
ENABLE = {{ _python.enable | default('false') | lower }}

# Python path (colon-separated list of directories)
PATH = {{ _python.path | default([]) | join(':') }}

# Preload modules (comma-separated)
PRELOAD = {{ _python.preload | default([]) | join(',') }}

[LOG]
# Logging configuration section.
{% set _log = log | default({}) %}
# Logging level: 0=none, 1=error, 2=warning, 3=info, 4=debug
LEVEL = {{ _log.level | default('3') }}

# Log file path (empty = stderr)
FILE = {{ _log.file | default('') }}

# Log to syslog (true/false)
SYSLOG = {{ _log.syslog | default('false') | lower }}

# Log to console (true/false)
CONSOLE = {{ _log.console | default('true') | lower }}

# Log rotation (bytes); 0 = no rotation
ROTATE = {{ _log.rotate | default('0') }}

# Max number of rotated log files
MAX_ROTATED = {{ _log.max_rotated | default('5') }}