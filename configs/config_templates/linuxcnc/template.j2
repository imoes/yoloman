[EMCMOT]
# Timeout for communications with motion controller (sec)
EMCMOT_TIMEOUT = {{ emcmot.timeout }}

# Base task period (sec) — must match HAL period
EMCMOT_BASE_PERIOD = {{ emcmot.base_period }}

# Motion controller type: 0=legacy, 1=mk2
EMCMOT_MOTION_TYPE = {{ emcmot.motion_type }}

# Number of motion segments to buffer
EMCMOT_SEGMENTS = {{ emcmot.segments }}

# Lookahead time (sec) for smoothing
EMCMOT_LOOKAHEAD = {{ emcmot.lookahead }}

# Trajectory planner type: 0=linear, 1=circular
EMCMOT_TP_TYPE = {{ emcmot.tp_type }}

# Maximum velocity (units/sec)
EMCMOT_MAX_VELOCITY = {{ emcmot.max_velocity }}

# Maximum acceleration (units/sec²)
EMCMOT_MAX_ACCELERATION = {{ emcmot.max_acceleration }}

# Default velocity (units/sec)
EMCMOT_DEFAULT_VELOCITY = {{ emcmot.default_velocity }}

# Default acceleration (units/sec²)
EMCMOT_DEFAULT_ACCELERATION = {{ emcmot.default_acceleration }}

[HOSTMOT]
# HostMot driver name (e.g., 'hm2_pci', 'hm2_rpspi')
DRIVER = {{ hostmot.driver }}

# Board name or instance (e.g., '0' for single-board systems)
BOARD = {{ hostmot.board | default('0') }}

# Config string passed to driver (e.g., 'num_encoders=4 num_pwms=2 num_stepgen=5')
CONFIG = {{ hostmot.config | join(' ') }}

# IP address for Ethernet boards (e.g., '192.168.1.100')
IPADDR = {{ hostmot.ipaddr | default('') }}

[HAL]
# HAL configuration file(s) — listed as a list, rendered as multiple lines
{% for halfile in hal.halfiles %}HALFILE = {{ halfile }}
{% endfor %}

# Post-run HAL file (executed after main halfile(s))
POSTGUI_HALFILE = {{ hal.postgui_halfile | default('') }}

# HALUI script (executed before postgui halfile)
HALUI = {{ hal.halui | default('') }}

[RS274NGC]
# Number of parameters in RS274NGC interpreter
PARAMETER_FILE = {{ rs274ngc.parameter_file | default('') }}

# Subroutine search paths
SUBROUTINE_PATH = {{ rs274ngc.subroutine_path | join(':') }}

# G-code file encoding (e.g., 'utf-8')
ENCODING = {{ rs274ngc.encoding }}

# Log file for RS274NGC interpreter
LOG_LEVEL = {{ rs274ngc.log_level }}

[EMCIO]
# Tool changer type: 0=none, 1=carousel, 2=chain, 3=pallete
TOOL_CHANGER_TYPE = {{ emcio.tool_changer_type }}

# Number of tool pockets in magazine
TOOL_TOOLKIT = {{ emcio.tool_toolkit }}

# Tool change position (X,Y,Z in machine units)
TOOL_CHANGE_POSITION = {{ emcio.tool_change_position }}

# Tool change spindle speed (RPM)
TOOL_CHANGE_SPINDLE_SPEED = {{ emcio.tool_change_spindle_speed }}

# Tool change approach distance
TOOL_CHANGE_APPROACH = {{ emcio.tool_change_approach }}

# Tool change retract distance
TOOL_CHANGE_RETRACT = {{ emcio.tool_change_retract }}

# Tool change wait time (sec)
TOOL_CHANGE_WAIT = {{ emcio.tool_change_wait }}

# Tool changer sequence file (optional)
TOOL_CHANGE_SEQUENCE = {{ emcio.tool_change_sequence | default('') }}

# Tool table file (e.g., 'tool.tbl')
TOOL_TABLE = {{ emcio.tool_table | default('tool.tbl') }}

[PYTHON]
# Enable Python support (true/false)
ENABLE = {{ python.enable }}

# Python path (colon-separated)
PATH = {{ python.path | join(':') }}

# Preload modules (comma-separated)
PRELOAD = {{ python.preload | join(',') }}

[LOG]
# Logging level: 0=none, 1=error, 2=warning, 3=info, 4=debug
LEVEL = {{ log.level }}

# Log file path (empty = stderr)
FILE = {{ log.file | default('') }}

# Log to syslog (true/false)
SYSLOG = {{ log.syslog }}

# Log to console (true/false)
CONSOLE = {{ log.console }}

# Log rotation (bytes); 0 = no rotation
ROTATE = {{ log.rotate }}

# Max number of rotated log files
MAX_ROTATED = {{ log.max_rotated }}
