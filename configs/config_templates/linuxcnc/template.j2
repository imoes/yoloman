[EMC]
# Name of the machine/instance
MACHINE = {{ machine_name }}

# Debug level (0 = none, 0x7fff = maximum)
DEBUG = {{ debug_level }}

[VERSION]
# LinuxCNC version (auto-filled by packaging)
STAMP = 1.1

[DISPLAY]
# Display name shown in title bar and GUI
DISPLAY = {{ display.name }}

# Editor used for G-code editing
EDITOR = {{ display.editor }}

# Maximum feed rate override (%)
MAX_FEED_OVERRIDE = {{ display.max_feed_override }}

# Minimum feed rate override (%)
MIN_FEED_OVERRIDE = {{ display.min_feed_override }}

# Maximum spindle override (%)
MAX_SPINDLE_OVERRIDE = {{ display.max_spindle_override }}

# Minimum spindle override (%)
MIN_SPINDLE_OVERRIDE = {{ display.min_spindle_override }}

# Maximum position override (fraction of programmed speed)
MAX_LINEAR_VELOCITY = {{ display.max_linear_velocity }}

# Default linear velocity (for jog, units/sec)
DEFAULT_LINEAR_VELOCITY = {{ display.default_linear_velocity }}

# Maximum angular velocity (degrees/sec for rotary axes)
MAX_ANGULAR_VELOCITY = {{ display.max_angular_velocity }}

# Default angular velocity (for jog)
DEFAULT_ANGULAR_VELOCITY = {{ display.default_angular_velocity }}

# Prefix for program files (empty = default location)
OPEN_FILE = {{ display.open_file | default('') }}

# Tool offset mode: 0=none, 1=relative, 2=absolute
TOOL_OFFSET_MODE = {{ display.tool_offset_mode }}

# Unit mode: 0=mm, 1=inch
USER_MODE = {{ 'mm' if display.units == 'metric' else 'inch' }}

# Maximum zoom (percentage of view)
MAX_ZOOM = {{ display.max_zoom }}

# Minimum zoom (percentage of view)
MIN_ZOOM = {{ display.min_zoom }}

# Position update rate (Hz)
POSITION_UPDATE = {{ display.position_update }}

# Status message timeout (seconds)
STATUS_UPDATE = {{ display.status_update }}

# Preview precision (digits after decimal)
PYVCP_PRECISION = {{ display.pyvcp_precision }}

# Hide or show MDI button (true/false)
HIDE_MDI_BUTTON = {{ '1' if display.hide_mdi_button else '0' }}

# Hide or show manual button (true/false)
HIDE_MANUAL_BUTTON = {{ '1' if display.hide_manual_button else '0' }}

# Hide or show auto button (true/false)
