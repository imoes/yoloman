[EMC]
# Unique name for this LinuxCNC instance (used in GUI and log messages).
MACHINE = {{ machine_name | default('my-machine') }}

# Debug verbosity level (0 = no debug, higher values increase debug output). Use 0x7fff for maximum.
DEBUG = {{ debug_level | default(0) }}

[VERSION]
# LinuxCNC version stamp (auto-filled by packaging).
STAMP = 1.1

[DISPLAY]
# Display section configuration.
{% set _display = display | default({}) %}
# Display name shown in title bar and GUI.
DISPLAY = {{ _display.name | default('') }}

# Editor used for G-code editing.
EDITOR = {{ _display.editor | default('') }}

# Maximum feed rate override (%)
MAX_FEED_OVERRIDE = {{ _display.max_feed_override | default('1.0') }}

# Minimum feed rate override (%)
MIN_FEED_OVERRIDE = {{ _display.min_feed_override | default('0.1') }}

# Maximum spindle override (%)
MAX_SPINDLE_OVERRIDE = {{ _display.max_spindle_override | default('1.0') }}

# Minimum spindle override (%)
MIN_SPINDLE_OVERRIDE = {{ _display.min_spindle_override | default('0.1') }}

# Maximum position override (fraction of programmed speed)
MAX_LINEAR_VELOCITY = {{ _display.max_linear_velocity | default('1.0') }}

# Default linear velocity (for jog, units/sec)
DEFAULT_LINEAR_VELOCITY = {{ _display.default_linear_velocity | default('0') }}

# Maximum angular velocity (degrees/sec for rotary axes)
MAX_ANGULAR_VELOCITY = {{ _display.max_angular_velocity | default('0') }}

# Default angular velocity (for jog)
DEFAULT_ANGULAR_VELOCITY = {{ _display.default_angular_velocity | default('0') }}

# Prefix for program files (empty = default location)
OPEN_FILE = {{ _display.open_file | default('') }}

# Tool offset mode: 0=none, 1=relative, 2=absolute
TOOL_OFFSET_MODE = {{ _display.tool_offset_mode | default('0') }}

# Unit mode: 0=mm, 1=inch. Map 'metric' to 'mm', otherwise 'inch'.
USER_MODE = {{ 'mm' if _display.units | default('metric') == 'metric' else 'inch' }}

# Maximum zoom (percentage of view)
MAX_ZOOM = {{ _display.max_zoom | default('100') }}

# Minimum zoom (percentage of view)
MIN_ZOOM = {{ _display.min_zoom | default('10') }}

# Position update rate (Hz)
POSITION_UPDATE = {{ _display.position_update | default('10') }}

# Status message timeout (seconds)
STATUS_UPDATE = {{ _display.status_update | default('5') }}

# Preview precision (digits after decimal)
PYVCP_PRECISION = {{ _display.pyvcp_precision | default('3') }}

# Hide or show MDI button (true/false)
HIDE_MDI_BUTTON = {{ '1' if _display.hide_mdi_button | default(false) else '0' }}

# Hide or show manual button (true/false)
HIDE_MANUAL_BUTTON = {{ '1' if _display.hide_manual_button | default(false) else '0' }}

# Hide or show auto button (true/false)
HIDE_AUTO_BUTTON = {{ '1' if _display.hide_auto_button | default(false) else '0' }}

# Hide or show setup button (true/false)
HIDE_SETUP_BUTTON = {{ '1' if _display.hide_setup_button | default(false) else '0' }}

# Hide or show preferences button (true/false)
HIDE_PREFERENCES_BUTTON = {{ '1' if _display.hide_preferences_button | default(false) else '0' }}

# Hide or show tools button (true/false)
HIDE_TOOLS_BUTTON = {{ '1' if _display.hide_tools_button | default(false) else '0' }}

# Hide or show statistics button (true/false)
HIDE_STATISTICS_BUTTON = {{ '1' if _display.hide_statistics_button | default(false) else '0' }}

# Hide or show diagnostics button (true/false)
HIDE_DIAGNOSTICS_BUTTON = {{ '1' if _display.hide_diagnostics_button | default(false) else '0' }}

# Hide or show help button (true/false)
