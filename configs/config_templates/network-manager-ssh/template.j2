<?xml version="1.0" encoding="UTF-8"?>
<!--
  NetworkManager SSH D-Bus Configuration Template
  =================================================
  This configuration file restricts access to the NetworkManager SSH
  service via D-Bus policy rules. It defines which users can own and
  communicate with the service.

  Generated by Ansible Jinja2. Do not edit manually.
-->
<!DOCTYPE busconfig PUBLIC
 "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  {#
    Policy for the privileged user allowed to own and send messages
    to the NetworkManager SSH D-Bus service.
    Schema field: root_user
  #}
  <policy user="{{ root_user | default('root') }}">
    {#
      Allow the user to own the D-Bus service name prefix.
      Schema field: nm_ssh_service_prefix
    #}
    <allow own_prefix="{{ nm_ssh_service_prefix | default('org.freedesktop.NetworkManager.ssh') }}"/>
    {#
      Allow the user to send messages to the D-Bus service name prefix.
      Schema field: nm_ssh_service_prefix
    #}
    <allow send_destination="{{ nm_ssh_service_prefix | default('org.freedesktop.NetworkManager.ssh') }}"/>
  </policy>

  {#
    Default deny policy context. Prevents unauthorized access to the
    NetworkManager SSH service for all other contexts/users.
    Schema field: default_policy_context
  #}
  <policy context="{{ default_policy_context | default('default') }}">
    {#
      Deny ownership of the service name prefix for unprivileged contexts.
      Schema field: nm_ssh_service_prefix
    #}
    <deny own_prefix="{{ nm_ssh_service_prefix | default('org.freedesktop.NetworkManager.ssh') }}"/>
    {#
      Deny sending messages to the service name prefix for unprivileged contexts.
      Schema field: nm_ssh_service_prefix
    #}
    <deny send_destination="{{ nm_ssh_service_prefix | default('org.freedesktop.NetworkManager.ssh') }}"/>
  </policy>
</busconfig>
