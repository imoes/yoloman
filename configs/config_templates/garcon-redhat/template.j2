<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
  "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">

<Menu>
    {# The display name of the menu. #}
    <Name>{{ name | default('Xfce') }}</Name>

    <DefaultAppDirs/>
    <DefaultDirectoryDirs/>

    <Include>
        {# The top-level category for inclusion. #}
        <Category>{{ top_level_category | default('X-Xfce-Toplevel') }}</Category>
    </Include>

    <Layout>
        {# The desktop file for the run command application. #}
        <Filename>{{ run_app | default('xfce4-run.desktop') }}</Filename>
        <Separator/>
        {# The desktop file for the terminal emulator. #}
        <Filename>{{ terminal_app | default('xfce4-terminal-emulator.desktop') }}</Filename>
        {# The desktop file for the file manager. #}
        <Filename>{{ file_manager_app | default('xfce4-file-manager.desktop') }}</Filename>
        {# The desktop file for the mail reader. #}
        <Filename>{{ mail_reader_app | default('xfce4-mail-reader.desktop') }}</Filename>
        {# The desktop file for the web browser. #}
        <Filename>{{ web_browser_app | default('xfce4-web-browser.desktop') }}</Filename>
        <Separator/>
        {# The name of the Settings menu entry. #}
        <Menuname>{{ settings_menu | default('Settings') }}</Menuname>
        {# The name of the Administration menu entry. #}
        <Menuname>{{ administration_menu | default('Administration') }}</Menuname>
        <Separator/>
        <Merge type="all"/>
        <Separator/>
        {# The desktop file for the about application. #}
        <Filename>{{ about_app | default('xfce4-about.desktop') }}</Filename>
        {# The desktop file for the session logout application. #}
        <Filename>{{ session_logout_app | default('xfce4-session-logout.desktop') }}</Filename>
    </Layout>

    <Menu>
        {# The name of the Settings menu entry. #}
        <Name>{{ settings_menu | default('Settings') }}</Name>
        {# The directory entry for Settings. #}
        <Directory>{{ settings_directory | default('xfce-settings.directory') }}</Directory>
        <Include>
            {# The category for Settings menu items. #}
            <Category>{{ settings_category | default('Settings') }}</Category>
        </Include>

        <Layout>
            {# The desktop file for the settings manager. #}
            <Filename>{{ settings_manager_app | default('xfce-settings-manager.desktop') }}</Filename>
            <Separator/>
            <Merge type="all"/>
        </Layout>

    </Menu>

    <Menu>
        {# The name of the Administration menu entry. #}
        <Name>{{ administration_menu | default('Administration') }}</Name>
        {# The directory entry for System Configuration. #}
        <Directory>{{ system_config_directory | default('SystemConfig.directory') }}</Directory>
        <Include>
            <And>
                {# The category for Settings menu items. #}
                <Category>{{ settings_category | default('Settings') }}</Category>
                {# The category for System items. #}
                <Category>{{ system_category | default('System') }}</Category>
                <Not>
                    {# The category to exclude from Administration. #}
                    <Category>{{ screensaver_category | default('Screensaver') }}</Category>
                </Not>
            </And>
            {# The desktop file for the package manager application. #}
            <Filename>{{ gpk_application | default('gpk-application.desktop') }}</Filename>
            {# The desktop file for the package manager update viewer. #}
            <Filename>{{ gpk_update_viewer | default('gpk-update-viewer.desktop') }}</Filename>
        </Include>
    </Menu>

    <Menu>
        {# The name of the Accessories menu entry. #}
        <Name>{{ accessories_menu | default('Accessories') }}</Name>
        {# The directory entry for Accessories. #}
        <Directory>{{ accessories_directory | default('xfce-accessories.directory') }}</Directory>
        <Include>
            <Or>
                {# The category for Accessibility items. #}
                <Category>{{ accessibility_category | default('Accessibility') }}</Category>
                {# The category for Core items. #}
                <Category>{{ core_category | default('Core') }}</Category>
                {# The category for Legacy items. #}
                <Category>{{ legacy_category | default('Legacy') }}</Category>
                {# The category for Utility items. #}
                <Category>{{ utility_category | default('Utility') }}</Category>
            </Or>
        </Include>
        <Exclude>
            <Or>
                {# The desktop file for the file manager. #}
                <Filename>{{ file_manager_app | default('xfce4-file-manager.desktop') }}</Filename>
                {# The desktop file for the terminal emulator. #}
                <Filename>{{ terminal_app | default('xfce4-terminal-emulator.desktop') }}</Filename>
                {# The desktop file for the about application. #}
                <Filename>{{ about_app | default('xfce4-about.desktop') }}</Filename>
                {# The desktop file for the run command application. #}
                <Filename>{{ run_app | default('xfce4-run.desktop') }}</Filename>
            </Or>
        </Exclude>
    </Menu>

    <Menu>
        {# The name of the Documentation menu entry. #}
        <Name>{{ documentation_menu | default('Documentation') }}</Name>
        {# The directory entry for Documentation. #}
        <Directory>{{ documentation_directory | default('Documentation.directory') }}</Directory>
        <Include>
            {# The category for Documentation items. #}
            <Category>{{ documentation_category | default('Documentation') }}</Category>
        </Include>
    </Menu>

    <Menu>
        {# The name of the Development menu entry. #}
        <Name>{{ development_menu | default('Development') }}</Name>
        {# The directory entry for Development. #}
        <Directory>{{ development_directory | default('xfce-development.directory') }}</Directory>
        <Include>
            {# The category for Development items. #}
            <Category>{{ development_category | default('Development') }}</Category>
        </Include>
    </Menu>

    <Menu>
        {# The name of the Education menu entry. #}
        <Name>{{ education_menu | default('Education') }}</Name>
        {# The directory entry for Education. #}
        <Directory>{{ education_directory | default('xfce-education.directory') }}</Directory>
        <Include>
            {# The category for Education items. #}
            <Category>{{ education_category | default('Education') }}</Category>
        </Include>
    </Menu>

    <Menu>
        {# The name of the Games menu entry. #}
        <Name>{{ games_menu | default('Games') }}</Name>
        {# The directory entry for Games. #}
        <Directory>{{ games_directory | default('xfce-games.directory') }}</Directory>
        <Include>
            {# The category for Game items. #}
            <Category>{{ game_category | default('Game') }}</Category>
        </Include>
    </Menu>

    <Menu>
        {# The name of the Graphics menu entry. #}
        <Name>{{ graphics_menu | default('Graphics') }}</Name>
        {# The directory entry for Graphics. #}
        <Directory>{{ graphics_directory | default('xfce-graphics.directory') }}</Directory>
        <Include>
            {# The category for Graphics items. #}
            <Category>{{ graphics_category | default('Graphics') }}</Category>
        </Include>
    </Menu>

    <Menu>
        {# The name of the Multimedia menu entry. #}
        <Name>{{ multimedia_menu | default('Multimedia') }}</Name>
        {# The directory entry for Multimedia. #}
        <Directory>{{ multimedia_directory | default('xfce-multimedia.directory') }}</Directory>
        <Include>
            {# The category for Audio items. #}
            <Category>{{ audio_category | default('Audio') }}</Category>
            {# The category for Video items. #}
            <Category>{{ video_category | default('Video') }}</Category>
            {# The category for AudioVideo items. #}
            <Category>{{ audio_video_category | default('AudioVideo') }}</Category>
        </Include>
    </Menu>

    <Menu>
        {# The name of the Network menu entry. #}
        <Name>{{ network_menu | default('Network') }}</Name>
        {# The directory entry for Network. #}
        <Directory>{{ network_directory | default('xfce-network.directory') }}</Directory>
        <Include>
            {# The category for Network items. #}
            <Category>{{ network_category | default('Network') }}</Category>
        </Include>
        <Exclude>
            <Or>
                {# The desktop file for the mail reader. #}
                <Filename>{{ mail_reader_app | default('xfce4-mail-reader.desktop') }}</Filename>
                {# The desktop file for the web browser. #}
                <Filename>{{ web_browser_app | default('xfce4-web-browser.desktop') }}</Filename>
            </Or>
        </Exclude>
    </Menu>

    <Menu>
        {# The name of the Office menu entry. #}
        <Name>{{ office_menu | default('Office') }}</Name>
        {# The directory entry for Office. #}
        <Directory>{{ office_directory | default('xfce-office.directory') }}</Directory>
        <Include>
            {# The category for Office items. #}
            <Category>{{ office_category | default('Office') }}</Category>
        </Include>
    </Menu>

    <Menu>
        {# The name of the Science menu entry. #}
        <Name>{{ science_menu | default('Science') }}</Name>
        {# The directory entry for Science. #}
        <Directory>{{ science_directory | default('xfce-science.directory') }}</Directory>
        <Include>
            {# The category for Science items. #}
            <Category>{{ science_category | default('Science') }}</Category>
        </Include>
    </Menu>

    <Menu>
        {# The name of the System menu entry. #}
        <Name>{{ system_menu | default('System') }}</Name>
        {# The directory entry for System. #}
        <Directory>{{ system_directory | default('xfce-system.directory') }}</Directory>
        <Include>
            <Or>
                {# The category for Emulator items. #}
                <Category>{{ emulator_category | default('Emulator') }}</Category>
                {# The category for System items. #}
                <Category>{{ system_category | default('System') }}</Category>
            </Or>
        </Include>
        <Exclude>
            <Or>
                {# The desktop file for the session logout application. #}
                <Filename>{{ session_logout_app | default('xfce4-session-logout.desktop') }}</Filename>
            </Or>
        </Exclude>
    </Menu>

    <Menu>
        {# The name of the Other menu entry. #}
        <Name>{{ other_menu | default('Other') }}</Name>
        {# The directory entry for Other. #}
        <Directory>{{ other_directory | default('xfce-other.directory') }}</Directory>
        <OnlyUnallocated/>
        <Include>
            <All/>
        </Include>
    </Menu>
    <DefaultMergeDirs/>

</Menu>
