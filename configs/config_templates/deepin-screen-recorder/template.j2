# deepin-screen-recorder configuration template
# Self-documenting: read these comments to understand every setting.

# Whether to customize the recording output directory (default: user's Desktop)
# Type: boolean
# If true, the recording_directory below will be used; otherwise, the recorder
# defaults to the user's Desktop directory as determined by the system.
{% if enable_recording_directory_customization | default(False, true) %}
  # Custom recording directory
  # Absolute path to directory where recordings are saved (only used if enable_recording_directory_customization is true)
  # Type: string
  recording_directory = {{ recording_directory | default('/home/' ~ (user | default('deepin', true)) ~ '/Desktop', true) }}
{% endif %}