{
  "director_name": "bacula-dir",
  "director_port": 9101,
  "director_query_file": "/etc/bacula/query.sql",
  "director_working_directory": "/var/spool/bacula",
  "director_pid_directory": "/var/run",
  "director_max_concurrent_jobs": 20,
  "director_password": "@@DIR_PASSWORD@@",
  "client_fd_name": "bacula-fd",
  "catalog_name": "MyCatalog",
  "restore_path": "/tmp/bacula-restores",
  "default_fileset_include": "/usr/sbin",
  "client_fd_address": "localhost",
  "client_fd_port": 9102,
  "client_fd_password": "@@FD_PASSWORD@@",
  "client_fd_file_retention": 60,
  "client_fd_job_retention": 6,
  "storage_daemon_address": "localhost",
  "storage_daemon_port": 9103,
  "storage_daemon_password": "@@SD_PASSWORD@@",
  "autochanger_max_concurrent_jobs": 10,
  "catalog_db_password": "",
  "mail_recipient": "root@localhost",
  "operator_recipient": "root@localhost",
  "log_file": "/var/log/bacula/bacula.log",
  "daemon_mail_recipient": "root@localhost",
  "pool_volume_retention": 365,
  "pool_max_volume_bytes": "50G",
  "pool_max_volumes": 100,
  "console_password": "@@MON_DIR_PASSWORD@@"
}
