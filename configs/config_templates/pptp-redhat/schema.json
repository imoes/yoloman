{
  "noauth": {
    "type": "string",
    "default": "noauth",
    "description": "Authentication option: whether to allow connections without authenticating the server."
  },
  "mppe_mode": {
    "type": "string",
    "default": "required",
    "description": "MPPE encryption mode (e.g., required, optional, 128-bit).",
    "enum": [
      "required",
      "128-bit"
    ]
  },
  "mppe_state": {
    "type": "string",
    "default": "",
    "description": "MPPE state setting (e.g., stateless, stateful)."
  }
}
