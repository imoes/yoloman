{
  "default_input_policy": "DROP",
  "default_forward_policy": "DROP",
  "default_output_policy": "ACCEPT",
  "log_drops": true,
  "log_prefix": "IPTABLES_DROP: ",
  "ssh_sources": [
    "10.0.0.1/32",
    "192.168.1.0/24"
  ],
  "http_sources": [
    "0.0.0.0/0"
  ],
  "https_sources": [
    "0.0.0.0/0"
  ],
  "custom_input_rules": [
    "-p tcp --dport 8080 -j ACCEPT",
    "-p tcp --dport 8443 -j ACCEPT"
  ],
  "custom_forward_rules": [
    "-p tcp --dport 80 -j ACCEPT"
  ],
  "masquerade_enabled": true,
  "masquerade_iface": "ppp0"
}
