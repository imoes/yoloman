{
  "verbose": {
    "type": "bool",
    "default": false,
    "description": "Enable verbose mode (default: false)"
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug mode (default: false)"
  },
  "use_syslog": {
    "type": "bool",
    "default": false,
    "description": "Use syslog in daemon mode (default: false)"
  },
  "log_file": {
    "type": "string",
    "default": "@config_dir@/Logs/daemon.log",
    "description": "Path to daemon log file (default: @config_dir@/Logs/daemon.log)"
  },
  "port": {
    "type": "number",
    "default": 3121,
    "description": "Port for XMLRPC/JSONRPC (default: 3121)"
  },
  "ip": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "IP address for XMLRPC/JSONRPC (default: 127.0.0.1)"
  },
  "pidfile": {
    "type": "string",
    "default": "",
    "description": "Path to PID file (optional; empty string means omitted)"
  },
  "config_dir": {
    "type": "string",
    "default": "~/.config/eiskaltdc++/",
    "description": "Configuration directory (default: ~/.config/eiskaltdc++/)"
  },
  "local_dir": {
    "type": "string",
    "default": "",
    "description": "Local data directory (cache, temp files); empty means use config_dir (default: '')"
  },
  "xmlrpc_log": {
    "type": "string",
    "default": "/tmp/eiskaltdcpp-daemon.xmlrpc.log",
    "description": "Path to XML-RPC log file (default: /tmp/eiskaltdcpp-daemon.xmlrpc.log)"
  },
  "uripath": {
    "type": "string",
    "default": "/eiskaltdcpp",
    "description": "XML-RPC URI path (default: /eiskaltdcpp)"
  }
}
