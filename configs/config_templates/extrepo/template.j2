# extrepo configuration template
# Generated by Ansible Jinja2 engine.
# This file configures the extrepo tool used to simplify the installation
# of third-party Debian/Ubuntu repositories and their GPG keys.

# url: URL of the extrepo-data repository
# Default: 'https://extrepo-team.pages.debian.net/extrepo-data'
url: {{ url | default('https://extrepo-team.pages.debian.net/extrepo-data') }}

# dist: Distribution name (e.g., debian, ubuntu)
# Default: 'debian'
dist: {{ dist | default('debian') }}

# version: Distribution version/codename (e.g., trixie, bullseye)
# Default: 'trixie'
version: {{ version | default('trixie') }}

# enabled_policies: List of enabled Debian policy components (e.g., main, contrib, non-free)
# Default: ['main']
# Note: 'contrib' and 'non-free' contain software that is not fully DFSG-free.
enabled_policies:
{% for policy in (enabled_policies | default(['main'])) %}
- {{ policy | string }}
{% endfor %}