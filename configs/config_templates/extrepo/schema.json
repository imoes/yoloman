{
  "url": {
    "type": "string",
    "default": "https://extrepo-team.pages.debian.net/extrepo-data",
    "description": "URL of the extrepo-data repository"
  },
  "dist": {
    "type": "string",
    "default": "debian",
    "description": "Distribution name (e.g., debian, ubuntu)"
  },
  "version": {
    "type": "string",
    "default": "trixie",
    "description": "Distribution version/codename (e.g., trixie, bullseye)"
  },
  "enabled_policies": {
    "type": "list",
    "default": [
      "main"
    ],
    "description": "List of enabled Debian policy components (e.g., main, contrib, non-free)"
  }
}
