{
  "enabled": true,
  "bind_interface": "eth0",
  "service_port": 10110,
  "stream_port": 10111,
  "log_file": "/var/log/gnss-share.log",
  "log_level": "info",
  "pid_file": "/run/gnss-share/gnss-share.pid",
  "worker_count": 0,
  "max_connections": 50,
  "client_timeout": 300,
  "allowed_clients": [
    "192.168.100.0/24",
    "10.0.0.1"
  ],
  "ssl_enabled": true,
  "ssl_cert_file": "/etc/gnss-share/ssl/cert.pem",
  "ssl_key_file": "/etc/gnss-share/ssl/key.pem",
  "gnss_sources": [
    {
      "name": "local-rtcm",
      "type": "ntrip",
      "url": "http://ntrip.example.com:2101/MOUNT1",
      "format": "rtcm3",
      "username": "user",
      "password": "secret"
    },
    {
      "name": "raw-logs",
      "type": "file",
      "url": "file:///data/gnss/rtcm.bin",
      "format": "rtcm3"
    }
  ],
  "auth_enabled": true,
  "auth_users_file": "/etc/gnss-share/users.json"
}
