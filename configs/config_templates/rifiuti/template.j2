# =============================================
# Rifiuti Configuration Template
# =============================================
# This configuration is for 'rifiuti', a tool used to parse Windows Recycle Bin
# metadata (INFO2/Recycle.bin) from disk images or mounted file systems.
# It is a standalone utility configuration and does not act as a network service,
# database, or application runtime. Therefore, it has no network dependencies
# (requires) and provides no network capabilities (provides).

# ---------------------------------------------
# Field Delimiter Setting
# ---------------------------------------------
# Description: The field delimiter character used in the output.
# Schema Field: field_delimiter
# Default: '\t' (TAB)
# Option: Corresponds to the -t option in the CLI.
# ---------------------------------------------
field_delimiter: {{ field_delimiter | default('\t') }}

# ---------------------------------------------
# Info2 File Path Setting
# ---------------------------------------------
# Description: The path to the INFO2 file to parse.
# Schema Field: info2_file
# Default: '/mnt/windows/Recycled/Info2'
# Note: This path should point to a valid INFO2 file from a Windows recycle bin.
# ---------------------------------------------
info2_file: {{ info2_file | default('/mnt/windows/Recycled/Info2') }}