{
  "daemon_enabled": true,
  "run_as_user": "alsaplayer",
  "run_as_group": "audio",
  "pidfile_path": "/run/alsaplayer/alsaplayer.pid",
  "log_level": 2,
  "log_file": "/var/log/alsaplayer/alsaplayer.log",
  "net_listen_address": "0.0.0.0",
  "http_port": 4953,
  "xmlrpc_port": 4954,
  "max_connections": 10,
  "auth_enabled": false,
  "auth_username": "",
  "auth_password": "",
  "alsa_device": "hw:0,0",
  "alsa_mixer": "Master",
  "alsa_mixer_device": "hw:0",
  "default_volume": 80,
  "audio_bitdepth": 0,
  "resample_quality": 2,
  "buffer_time": 50000,
  "prebuffer_percent": 25,
  "output_plugins": [
    {
      "name": "main",
      "enabled": true,
      "device": "hw:0,0",
      "type": "alsa"
    },
    {
      "name": "hdmi",
      "enabled": true,
      "device": "hw:0,7",
      "type": "alsa"
    }
  ],
  "decoders": [
    "ffmpeg",
    "sndfile"
  ],
  "input_plugins": [
    {
      "name": "curl",
      "enabled": true,
      "priority": 100
    },
    {
      "name": "file",
      "enabled": true,
      "priority": 50
    }
  ],
  "default_playlist_format": "m3u8",
  "autoplay": true,
  "repeat_mode": 0,
  "shuffle_enabled": false
}
