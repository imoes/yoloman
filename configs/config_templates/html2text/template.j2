{# ============================================================================ #}
{# html2text configuration template                                               #}
{#                                                                                #}
{# This template generates the system-wide configuration file for html2text.      #}
{# Each directive is self-documenting with its source description and safe        #}
{# default values using Jinja2 `default` filters to prevent rendering errors      #}
{# when variables are undefined in the Ansible context.                           #}
{#                                                                                #}
{# Schema:                                                                      #}
{# - width: int, default 79                                                       #}
{# - from_encoding: string, default ''                                            #}
{# - to_encoding: string, default 'UTF-8'                                         #}
{# - ascii: bool, default False                                                   #}
{# - indent: int, default 0                                                       #}
{# - paragraphs: int, default 1                                                   #}
{# - links: bool, default False                                                   #}
{# - tables: bool, default True                                                   #}
{# - images: bool, default False                                                  #}
{# - rules: bool, default True                                                    #}
{# - nimages: bool, default False                                                 #}
{# ============================================================================ #}

# html2text - System wide parser configuration file
# See html2text(5) for details

{# Width of the output text line in characters. #}
# Default: 79
width = {{ width | default(79) }}

{# Encoding of the input file. Empty string means auto-detect. #}
# Default: ''
from_encoding = {{ from_encoding | default('') }}

{# Encoding of the output file. Empty string means UTF-8. #}
# Default: 'UTF-8'
to_encoding = {{ to_encoding | default('UTF-8') }}

{# Whether to force ASCII output. #}
# Default: false
ascii = {{ ascii | default(false) | bool }}

{# Number of spaces to use for indentation of list items and paragraphs. #}
# Default: 0
indent = {{ indent | default(0) }}

{# Number of blank lines between paragraphs. #}
# Default: 1
paragraphs = {{ paragraphs | default(1) }}

{# Whether to render links as numbered references. #}
# Default: false
links = {{ links | default(false) | bool }}

{# Whether to render tables. #}
# Default: true
tables = {{ tables | default(true) | bool }}

{# Whether to render images with alt text. #}
# Default: false
images = {{ images | default(false) | bool }}

{# Whether to render horizontal rules. #}
# Default: true
rules = {{ rules | default(true) | bool }}

{# Whether to ignore images entirely (alias for images=false). #}
# Default: false
nimages = {{ nimages | default(false) | bool }}