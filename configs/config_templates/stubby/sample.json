{
  "upstream_servers": [
    {
      "address_data": "9.9.9.9",
      "fqdn": "dns.quad9.net"
    },
    {
      "address_data": "2620:fe::fe",
      "fqdn": "dns.quad9.net"
    },
    {
      "address_data": "1.1.1.1",
      "fqdn": "cloudflare-dns.com"
    }
  ],
  "authentication_mode": "name",
  "cacert_file_or_path": "",
  "tls_min_version": "tls1.3",
  "listen_addresses": [
    "127.0.0.1",
    "::1"
  ],
  "listen_port": 53,
  "dnssec": 2,
  "dnssec_validate": 1,
  "log_level": 2,
  "cache_size": 100,
  "cache_min_ttl": 0,
  "cache_max_ttl": 86400,
  "retry_attempts": 2,
  "timeout": 3,
  "prefer_ipv6": true,
  "round_robin_upstreams": true,
  "use_tls_session_tickets": false,
  "add_tls_query_padding_blocksize": 128
}
