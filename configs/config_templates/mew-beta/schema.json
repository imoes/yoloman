{
  "mew_icon_directory": {
    "type": "string",
    "default": "/usr/share/pixmaps/mew",
    "description": "Directory containing mew icons"
  },
  "mew_prog_ssl": {
    "type": "string",
    "default": "mewstunnel",
    "description": "Program used for SSL tunneling",
    "enum": [
      "native",
      "tunnel",
      "mewstunnel"
    ]
  },
  "mew_ssl_cert_directory": {
    "type": "string",
    "default": "/etc/ssl/certs",
    "description": "Directory containing SSL certificates"
  },
  "mew_ssl_verify_level": {
    "type": "number",
    "default": 2,
    "description": "SSL certificate verification level"
  },
  "mew_unix_browser": {
    "type": "string",
    "default": "/usr/bin/sensible-browser",
    "description": "Unix browser used by mew"
  },
  "mew_delete_temp_file": {
    "type": "bool",
    "default": false,
    "description": "Whether to delete temporary files"
  },
  "mew_prog_gpg": {
    "type": "string",
    "default": "gpg1",
    "description": "Program used for GPG operations (version 1)"
  },
  "mew_prog_gpg2": {
    "type": "string",
    "default": "gpg",
    "description": "Program used for GPG operations (version 2)"
  }
}
