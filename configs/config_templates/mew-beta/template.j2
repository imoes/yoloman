;;; 50mew-beta.el --- Debian mew-beta startup file  -*-mode: emacs-lisp;-*-

;;; Self-documenting template for mew-beta configuration.
;;; Each configuration variable is documented with its schema description
;;; and default value. Variables use Jinja2 defaults to ensure safe rendering
;;; even if the variable is undefined in the Ansible inventory.

(let* ((pkg "mew-beta")
       (pkg-sname "mew")
       (flavor-name (if (boundp 'debian-emacs-flavor)
			(symbol-name debian-emacs-flavor)
		      "emacs"))
       (pkg-inst (concat "/usr/lib/emacsen-common/packages/install/" pkg))
       (elc-dir (concat "/usr/share/" flavor-name "/site-lisp/" pkg-sname)))
  (when (and (file-exists-p elc-dir)
	     (file-exists-p pkg-inst))
    (if (fboundp 'debian-pkg-add-load-path-item)
	(debian-pkg-add-load-path-item elc-dir)
      (setq load-path (cons elc-dir load-path)))
    ;;
    (autoload 'mew-user-agent-compose "mew" nil t)
    (if (fboundp 'define-mail-user-agent)
	(define-mail-user-agent
	  'mew-user-agent
	  'mew-user-agent-compose
	  'mew-draft-send-message
	  'mew-draft-kill
	  'mew-send-hook))
    (autoload 'mew "mew" nil t)
    (autoload 'mew-send "mew" nil t)

    ;; mew-icon-directory: Directory containing mew icons
    (setq mew-icon-directory "{{ mew_icon_directory | default('/usr/share/pixmaps/mew') }}")

    ;; mew-prog-ssl: Program used for SSL tunneling
    (setq mew-prog-ssl "{{ mew_prog_ssl | default('mewstunnel') }}")

    ;;(setq mew-prog-ssl-arg "ciphers=DEFAULT:@SECLEVEL=2\nsslVersionMin=TLSv1.2\n")
    ;;(setq mew-prog-ssl-arg "ciphers=DEFAULT:@SECLEVEL=1\nsslVersionMin=TLSv1.2\nsslVersionMax=TLSv1.2\n")

    ;; mew-ssl-cert-directory: Directory containing SSL certificates
    (setq mew-ssl-cert-directory "{{ mew_ssl_cert_directory | default('/etc/ssl/certs') }}")

    ;; mew-ssl-verify-level: SSL certificate verification level
    (setq mew-ssl-verify-level {{ mew_ssl_verify_level | default(2) }})

    ;; mew-unix-browser: Unix browser used by mew
    (setq mew-unix-browser "{{ mew_unix_browser | default('/usr/bin/sensible-browser') }}")

    (setq mew-unix-browser-arg nil)

    ;; mew-delete-temp-file: Whether to delete temporary files
    (setq mew-delete-temp-file {{ mew_delete_temp_file | default('nil') }})

    ;; mew-prog-gpg: Program used for GPG operations (version 1)
    (setq mew-prog-gpg "{{ mew_prog_gpg | default('gpg1') }}")

    ;; mew-prog-gpg2: Program used for GPG operations (version 2)
    (setq mew-prog-gpg2 "{{ mew_prog_gpg2 | default('gpg') }}")

    (setq mew-prog-pgp mew-prog-gpg2)
    (setq mew-prog-passwd mew-prog-gpg2)
    (setq mew-field-comment "") ;; workaround for Gmail, cf. [mew-ja] on 2020-11-12
    (or (executable-find "pngtopam") ;; Netpbm 10.44 or later
	(setq mew-image-alist ;; Netpbm 10.0
	      '((jpeg mew-jpeg-size "jpegtopnm" "pnmtojpeg")
		(png  mew-png-size  "pngtopnm"  "pnmtopng")
		(gif  mew-png-size  "giftopnm"  "ppmtogif")
		(tiff mew-tiff-size "tifftopnm" "pnmtotiff")
		(xwd  nil           "xwdtopnm"  "pnmtoxwd")
		(xbm  nil           "xbmtopbm"  "pbmtoxbm")
		(xpm  nil           "xpmtoppm"  "ppmtoxpm")
		(bmp  mew-bmp-size  "bmptopnm"  "ppmtobmp")
		(PCX  nil           "pcxtoppm"  "ppmtopcx")
		(TGA  nil           "tgatoppm"  "ppmtotga")
		(ICO  nil           "winicontoppm" "ppmtowinicon")
		(pbm  mew-pbm-size  nil         nil)
		(PAM  mew-pbm-size  nil         nil))))
    ;;(setq mew-ssl-default 'native) ;; GnuTLS
    ;;(setq mew-ssl-default 'tunnel) ;; stunnel
    ;;
    ))

;;; 50mew-beta.el ends here
