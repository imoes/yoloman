{
  "debug_enabled": false,
  "pidfile_path": "/run/anyremote/anyremote.pid",
  "log_level": 3,
  "log_path": "/var/log/anyremote/anyremote.log",
  "http_port": 5555,
  "tcp_port": 5556,
  "ws_port": 5557,
  "bind_address": "0.0.0.0",
  "bluetooth": {
    "enabled": true,
    "device": "hci0",
    "channel": 0,
    "service_name": "anyremote",
    "allowed_devices": [
      "00:11:22:33:44:55",
      "AA:BB:CC:DD:EE:FF"
    ]
  },
  "wifi": {
    "enabled": true,
    "port": 5558,
    "allowed_ips": [
      "192.168.1.0/24",
      "10.0.0.10"
    ]
  },
  "irda": {
    "enabled": false,
    "device": "/dev/ircomm0"
  },
  "applications": [
    {
      "name": "mpv",
      "enabled": true,
      "binary": "/usr/bin/mpv",
      "command": "kill -USR1 $(pgrep mpv)",
      "keys": {
        "PLAY": "toggle",
        "STOP": "stop",
        "VOL+": "key:volume_up",
        "VOL-": "key:volume_down",
        "NEXT": "playlist_next",
        "PREV": "playlist_prev"
      }
    },
    {
      "name": "chromium",
      "enabled": false,
      "binary": "/usr/bin/chromium-browser",
      "command": "",
      "keys": {
        "PLAY": "key:F8",
        "STOP": "key:F7",
        "VOL+": "key:F10",
        "VOL-": "key:F9"
      }
    }
  ],
  "input_forwarding": {
    "enabled": true,
    "type": "both",
    "repeat_delay": 50
  }
}
