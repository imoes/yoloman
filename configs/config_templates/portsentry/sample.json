{
  "ignore_udp": false,
  "ignore_icmp": true,
  "ignore_hosts": [
    "127.0.0.1",
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "scan_mode": "both",
  "block_host": true,
  "block_time": 3600,
  "kill_cmd": "logger -p auth.warning -t portsentry \"Blocked host: %s\"",
  "tcp_ports": [
    "22",
    "80",
    "443"
  ],
  "udp_ports": [
    "53",
    "123"
  ],
  "strict_tcp_scan": true,
  "strict_udp_scan": false,
  "stealth_scan_threshold": 3,
  "detection_window": 60,
  "max_connections": 20,
  "log_file": "/var/log/portsentry/portsentry.log",
  "alert_email": [
    "security@example.com",
    "ops@example.com"
  ],
  "smtp_server": "mail.example.com",
  "from_email": "portsentry@example.com",
  "alert_subject": "[SECURITY] Portscan Alert",
  "pre_block_cmd": "/usr/local/bin/preblock.sh %s",
  "post_block_cmd": "/usr/local/bin/postblock.sh %s",
  "always_ignore": [
    "10.10.10.10"
  ],
  "tcp_conn_limit": 15,
  "udp_packet_limit": 30,
  "advanced_logging": true,
  "hosts_deny": "/etc/hosts.deny",
  "enable_ipv6": true,
  "ignore_ipv6": [
    "::1",
    "fc00::/7"
  ],
  "syslog_alert": "logger -p auth.alert -t portsentry",
  "ignore_ports": [
    "161",
    "162"
  ],
  "scan_white_list": [
    "192.168.1.1"
  ],
  "resolve_hosts": true,
  "max_threads": 4,
  "run_as_user": "nobody",
  "run_as_group": "nogroup",
  "pid_file": "/run/portsentry.pid",
  "exit_after": 0,
  "extra_args": [
    "-ignore",
    "127.0.0.1"
  ],
  "active_probe_ports": [
    "6666",
    "31337"
  ],
  "active_probe_interval": 120,
  "promisc_ports": [
    "139",
    "445"
  ],
  "listen_interfaces": [
    "eth0",
    "eth1"
  ],
  "udp_tracking": true,
  "tcp_tracking": true,
  "aggressive_mode": false
}
