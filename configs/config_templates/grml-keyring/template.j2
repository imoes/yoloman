# Grml Keyring Configuration
# This template generates the metadata file for the Grml APT keyring.
# It provides vendor identification and support contact information
# for packages signed with this keyring.

# {{ vendor_name | default('Grml') }}: Name of the vendor or distribution.
Vendor: {{ vendor_name | default('Grml') }}

# {{ vendor_url | default('http://grml.org/') }}: URL of the vendor's website.
Vendor-URL: {{ vendor_url | default('http://grml.org/') }}

# {{ vendor_description | default('Debian based Linux Live system for system administrators') }}:
# Short description of the vendor's product.
Vendor-Description: {{ vendor_description | default('Debian based Linux Live system for system administrators') }}

# {{ bugs_email | default('mailto:bugs@grml.org') }}: Email address for bug reports in mailto: URI format.
Bugs: {{ bugs_email | default('mailto:bugs@grml.org') }}