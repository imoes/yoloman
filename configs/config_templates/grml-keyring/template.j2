# Grml Keyring metadata configuration
# This template generates the metadata file for the Grml keyring package.
# It contains vendor identification and contact information used by APT/dpkg
# to identify the source of cryptographic keys.

# Name of the vendor or distribution.
# Default: 'Grml'
Vendor: {{ vendor_name | default('Grml') }}

# URL of the vendor's website.
# Default: 'http://grml.org/'
Vendor-URL: {{ vendor_url | default('http://grml.org/') }}

# Short description of the vendor's product.
# Default: 'Debian based Linux Live system for system administrators'
Vendor-Description: {{ vendor_description | default('Debian based Linux Live system for system administrators') }}

# Email address for bug reports in mailto: URI format.
# Default: 'mailto:bugs@grml.org'
Bugs: {{ bugs_email | default('mailto:bugs@grml.org') }}
