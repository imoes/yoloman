{
  "kdc": {
    "verbose": false,
    "debug": false,
    "max_connections": 200,
    "database": "/var/lib/heimdal-kdc/kdc database",
    "realm": "EXAMPLE.COM",
    "listen_addresses": [
      "0.0.0.0"
    ],
    "port": 88,
    "tcp_port": 88,
    "enable_pkinit": false,
    "enable_fast": true,
    "keytab": "/etc/heimdal-kdc/kdc.keytab",
    "require_preauth": true,
    "tgt_lifetime": 86400,
    "ticket_lifetime": 86400,
    "renewable_lifetime": 604800,
    "clockskew": 300,
    "pkinit_identity": "",
    "acl": [
      "kadmin/changepw = add, modify, delete, list, get",
      "kiprop/kdc.example.com = modify, list, get",
      "* = list"
    ],
    "policy": {
      "admin/*": {
        "min_lifetime": 0,
        "max_lifetime": 86400,
        "max_renewable": 604800
      },
      "user/*": {
        "min_lifetime": 0,
        "max_lifetime": 28800,
        "max_renewable": 604800
      }
    }
  }
}
