# =============================================================================
# Redis Configuration File
# =============================================================================
# This file is auto-generated by Ansible. Do not edit manually.
# =============================================================================

# =============================================================================
# Basic Server Settings
# =============================================================================

# IP address(es) Redis will bind to (space-separated for multiple).
# Use '0.0.0.0' to bind to all interfaces (⚠️ insecure unless firewall-protected).
bind {{ bind | default('127.0.0.1') }}

# TCP port for non-TLS connections.
# Set to 0 if only using TLS.
port {{ port | default(6379) }}

# =============================================================================
# TLS/SSL Configuration
# =============================================================================
{% if tls_enabled | default(False) %}
# When TLS is enabled, the standard port is disabled to prevent plaintext connections.
port 0

# TCP port for TLS-encrypted connections (used only if TLS is enabled).
tls-port {{ tls_port | default(6380) }}

# Path to TLS certificate file (PEM format).
tls-cert-file {{ tls_cert_file | default('/etc/redis/tls/redis.crt') }}

# Path to TLS private key file (PEM format).
tls-key-file {{ tls_key_file | default('/etc/redis/tls/redis.key') }}

# Path to CA certificate file for validating client certificates (optional).
tls-ca-cert-file {{ tls_ca_cert_file | default('/etc/redis/tls/ca.crt') }}

# Require clients to present valid certificates (mTLS) when TLS is enabled.
# 'yes' = client certificates required; 'no' = optional.
tls-auth-clients {{ 'yes' if tls_auth_clients | default(True) else 'no' }}
{% endif %}

# =============================================================================
# Daemonization & Process Management
# =============================================================================

# Run Redis as a background daemon (recommended for production).
daemonize {{ 'yes' if daemonize | default(True) else 'no' }}

# Path to PID file for process management.
# Only used if daemonize is yes.
pidfile {{ pidfile | default('/var/run/redis/redis-server.pid') }}

# =============================================================================
# Logging
# =============================================================================

# Verbosity of logs. Options: debug, verbose, notice, warning.
loglevel {{ loglevel | default('notice') }}

# Path to log file. Use '-' to log to stderr.
logfile {{ logfile | default('/var/log/redis/redis-server.log') }}

# =============================================================================
# Snapshotting (RDB Persistence)
# =============================================================================

# RDB snapshot schedule: list of [seconds, changes] pairs.
# Example: save 900 1 (save if at least 1 key changed in 900 seconds).
# Set empty list [] to disable RDB saving.
{% if save_intervals | default([[900, 1], [300, 10], [60, 10000]]) %}
{% for interval in save_intervals | default([[900, 1], [300, 10], [60, 10000]]) %}
save {{ interval[0] }} {{ interval[1] }}
{% endfor %}
{% else %}
# Explicitly disable RDB snapshots if the list is empty.
save ""
{% endif %}

# Filename for RDB snapshots.
dbfilename {{ dbfilename | default('dump.rdb') }}

# Working directory for RDB/AOF files and persistence data.
dir {{ dir | default('/var/lib/redis') }}

# =============================================================================
# Memory Management
# =============================================================================

# Maximum memory Redis can use (e.g., '2gb', '512mb', '0' = unlimited).
# Required for eviction policies to take effect.
maxmemory {{ maxmemory | default('0') }}

# Eviction policy when maxmemory is reached.
# Examples: allkeys-lru, volatile-ttl, allkeys-random, noeviction.
maxmemory-policy {{ maxmemory_policy | default('noeviction') }}

# Number of samples for LRU and TTL eviction algorithms.
# Higher = more accuracy, more CPU.
maxmemory-samples {{ maxmemory_samples | default(5) }}

# =============================================================================
# Clients
# =============================================================================

# Maximum number of simultaneous client connections.
maxclients {{ maxclients | default(10000) }}

# =============================================================================
# Security
# =============================================================================

# Password required for client authentication.
# ⚠️ Avoid in plaintext in production — use ACLs instead if possible.
{% if requirepass | default('') %}
requirepass {{ requirepass | default('') }}
{% endif %}

# Password used when authenticating to a master (for replication).
{% if masterauth | default('') %}
masterauth {{ masterauth | default('') }}
{% endif %}

# =============================================================================
# Replication
# =============================================================================

# Master node to replicate from in format 'host port'.
# Empty string = standalone/master.
{% if replicaof | default('') %}
replicaof {{ replicaof | default('') }}
{% endif %}

# Public IP to announce to clients as this replica's address (e.g., for NAT/containers).
{% if replica_announce_ip | default('') %}
replica-announce-ip {{ replica_announce_ip | default('') }}
{% endif %}

# Public port to announce as this replica's port (when replica-announce-ip is set).
{% if replica_announce_port | default(6379) %}
replica-announce-port {{ replica_announce_port | default(6379) }}
{% endif %}

# =============================================================================
# Latency Monitor
# =============================================================================

# Log events taking ≥ this many milliseconds (0 = disabled).
latency-monitor-threshold {{ latency_monitor_threshold | default(0) }}

# =============================================================================
# Slow Log
# =============================================================================

# Log commands taking ≥ this many microseconds (e.g., 10000 = 10ms).
# Set to 0 to log all commands.
slowlog-log-slower-than {{ slowlog_log_slower_than | default(10000) }}

# Maximum number of entries kept in slowlog.
slowlog-max-len {{ slowlog_max_len | default(128) }}

# =============================================================================
# Event Notification
# =============================================================================

# Enable pub/sub for key events (e.g., 'AKE' = all events).
# Empty string = disabled.
notify-keyspace-events {{ notify_keyspace_events | default('') }}

# =============================================================================
# Advanced Network Configuration
# =============================================================================

# TCP listen() backlog size (system-dependent max applies).
tcp-backlog {{ tcp_backlog | default(511) }}

# Close connection after this many seconds of inactivity (0 = no timeout).
timeout {{ timeout | default(0) }}

# Send TCP keepalive packets every N seconds (0 = disable).
tcp-keepalive {{ tcp_keepalive | default(300) }}

# =============================================================================
# AOF (Append Only File) Persistence
# =============================================================================

# Enable AOF persistence (recommended over RDB alone for durability).
appendonly {{ 'yes' if appendonly | default(False) else 'no' }}

# Filename for AOF persistence.
appendfilename {{ appendfilename | default('appendonly.aof') }}

# Sync policy: always, everysec, no. Trade-off between durability & performance.
appendfsync {{ appendfsync | default('everysec') }}

# Defer fsync during BGSAVE/AOF rewrite (improves latency but risks data loss in crash).
no-appendfsync-on-rewrite {{ 'yes' if no_appendfsync_on_rewrite | default(False) else 'no' }}

# Trigger AOF rewrite when size grows by this % over last rewrite.
auto-aof-rewrite-percentage {{ auto_aof_rewrite_percentage | default(100) }}

# Minimum AOF size required to trigger rewrite (e.g., '64mb', '128mb').
auto-aof-rewrite-min-size {{ auto_aof_rewrite_min_size | default('64mb') }}

# Load AOF even if it appears truncated (prevents startup failure on partial writes).
aof-load-truncated {{ 'yes' if aof_load_truncated | default(True) else 'no' }}

# Prefix AOF with RDB snapshot for faster load (recommended).
aof-use-rdb-preamble {{ 'yes' if aof_use_rdb_preamble | default(True) else 'no' }}

# =============================================================================
# Redis Cluster (if enabled)
# =============================================================================

# Enable Redis Cluster mode (requires multiple nodes).
{% if cluster_enabled | default(False) %}
cluster-enabled yes

# Filename for cluster configuration (auto-generated, do not edit manually).
cluster-config-file {{ cluster_config_file | default('nodes.conf') }}

# Cluster node timeout in milliseconds before marking a node as failed.
cluster-node-timeout {{ cluster_node_timeout | default(5000) }}
{% endif %}

# =============================================================================
# Redis Sentinel Mode (if enabled)
# =============================================================================

# Enable Redis Sentinel mode for high availability (monitors masters/replicas).
{% if sentinel_mode | default(False) %}
# Name of the master instance to monitor, its IP, port, and quorum.
sentinel monitor {{ sentinel_master_name | default('mymaster') }} {{ sentinel_master_ip | default('127.0.0.1') }} {{ sentinel_master_port | default(6379) }} {{ sentinel_quorum | default(2) }}

# Additional Sentinel configuration options (key-value pairs).
{% for sentinel_option in sentinel_options | default([{'key': 'down-after-milliseconds', 'value': '30000'}, {'key': 'parallel-syncs', 'value': '1'}, {'key': 'failover-timeout', 'value': '180000'}]) %}
sentinel {{ sentinel_option.key }} {{ sentinel_master_name | default('mymaster') }} {{ sentinel_option.value }}
{% endfor %}
{% endif %}

# =============================================================================
# Custom Directives
# =============================================================================

# Free-form additional config directives (for advanced tuning or vendor-specific features).
# Format: [{'key': 'directive', 'value': 'arg1 arg2'}]
{% for directive in extra_directives | default([]) %}
{{ directive.key }} {{ directive.value }}
{% endfor %}