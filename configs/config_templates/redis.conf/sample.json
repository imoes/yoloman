{
  "bind": "0.0.0.0",
  "port": 6379,
  "tls_enabled": false,
  "tls_port": 6380,
  "tls_cert_file": "/etc/redis/tls/redis.crt",
  "tls_key_file": "/etc/redis/tls/redis.key",
  "tls_ca_cert_file": "/etc/redis/tls/ca.crt",
  "tls_auth_clients": true,
  "daemonize": true,
  "pidfile": "/var/run/redis/redis-server-6379.pid",
  "loglevel": "notice",
  "logfile": "/var/log/redis/redis-server.log",
  "save_intervals": [
    [
      900,
      1
    ],
    [
      300,
      10
    ],
    [
      60,
      10000
    ]
  ],
  "dbfilename": "dump.rdb",
  "dir": "/var/lib/redis",
  "maxmemory": "256mb",
  "maxmemory_policy": "allkeys-lru",
  "maxmemory_samples": 5,
  "maxclients": 10000,
  "requirepass": "",
  "masterauth": "",
  "replicaof": "",
  "replica_announce_ip": "",
  "replica_announce_port": 6379,
  "latency_monitor_threshold": 0,
  "slowlog_log_slower_than": 10000,
  "slowlog_max_len": 128,
  "notify_keyspace_events": "AKE",
  "tcp_backlog": 511,
  "timeout": 0,
  "tcp_keepalive": 300,
  "appendonly": true,
  "appendfilename": "appendonly.aof",
  "appendfsync": "everysec",
  "no_appendfsync_on_rewrite": false,
  "auto_aof_rewrite_percentage": 100,
  "auto_aof_rewrite_min_size": "64mb",
  "aof_load_truncated": true,
  "aof_use_rdb_preamble": true,
  "cluster_enabled": false,
  "cluster_config_file": "nodes.conf",
  "cluster_node_timeout": 5000,
  "sentinel_mode": false,
  "sentinel_master_name": "mymaster",
  "sentinel_master_ip": "127.0.0.1",
  "sentinel_master_port": 6379,
  "sentinel_quorum": 2,
  "sentinel_options": [
    {
      "key": "down-after-milliseconds",
      "value": "30000"
    },
    {
      "key": "parallel-syncs",
      "value": "1"
    },
    {
      "key": "failover-timeout",
      "value": "180000"
    }
  ],
  "extra_directives": [
    {
      "key": "rename-command",
      "value": "FLUSHALL \"\""
    },
    {
      "key": "rename-command",
      "value": "CONFIG \"\""
    }
  ]
}
