{
  "wasm_file": "/var/lib/wasmedge/hello.wasm",
  "mode": "command",
  "reactor_function": "start",
  "args": [
    "hello",
    "world"
  ],
  "directories": [
    "/var/lib/wasmedge/data:/data"
  ],
  "env_vars": [
    "LANG=en_US.UTF-8"
  ],
  "force_interpreter": false,
  "forbidden_plugins": [],
  "enable_time_measuring": true,
  "enable_gas_measuring": false,
  "enable_instruction_count": false,
  "enable_all_statistics": false,
  "time_limit": 5000,
  "gas_limit": 1000000,
  "memory_page_limit": 20,
  "disable_import_export_mut_globals": false,
  "disable_non_trap_float_to_int": false,
  "disable_sign_extension_operators": false,
  "disable_multi_value": false,
  "disable_bulk_memory": false,
  "disable_reference_types": false,
  "disable_simd": false,
  "enable_multi_memory": false,
  "enable_tail_call": false,
  "enable_extended_const": false,
  "enable_threads": false,
  "enable_all": false
}
