{
  "at_spi_bus_address": "unix:path=/run/user/1000/at-spi/bus",
  "at_spi_registry": true,
  "atk_bridge_path": "/usr/lib/x86_64-linux-gnu/libatk-bridge-2.0.so",
  "qt_accessibility": true,
  "qtwebengine_chromium_flags": "--enable-accessibility --force-high-dpi-support",
  "env_overrides": [
    {
      "name": "Orca",
      "values": {
        "AT_SPI_LOGGER": "1",
        "GSK_BACKEND": "cairo"
      }
    },
    {
      "name": "JAWS (Wine)",
      "values": {
        "WINEDEBUG": "+all",
        "WINEDLLOVERRIDES": " accessibility.dll=b"
      }
    }
  ]
}
