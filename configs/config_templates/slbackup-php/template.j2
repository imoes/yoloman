# ==============================================================================
# slbackup-php Apache Configuration Template
# ==============================================================================
# This template generates the necessary Apache configuration directives to serve
# the slbackup-php application. It handles:
# 1. Automatic HTTPS redirection for the application prefix.
# 2. Filesystem aliasing of the web root.
# 3. Directory access controls for the application's web directory.
# ==============================================================================

# --------------------------------------------------------------------------
# HTTPS Redirection Block
# --------------------------------------------------------------------------
# Enforces SSL/TLS for the slbackup-php web interface.
# Only active if Apache's mod_ssl module is available.
<IfModule mod_rewrite.c>
  <IfModule mod_ssl.c>
    # Redirect all HTTP requests for the slbackup-php path to HTTPS.
    # Uses the configured URL prefix.
    <Location {{ slbackup_php_location_prefix | default('/slbackup-php') | trim }}>
      RewriteEngine on
      # Check if HTTPS is not already 'on'
      RewriteCond %{HTTPS} !^on$ [NC]
      # Redirect to the current host and URI but with HTTPS scheme
      RewriteRule . https://%{HTTP_HOST}%{REQUEST_URI}  [L]
    </Location>
  </IfModule>
</IfModule>

# --------------------------------------------------------------------------
# Web Root Alias
# --------------------------------------------------------------------------
# Maps the URL prefix to the physical filesystem location of the slbackup-php files.
# This allows Apache to serve the PHP application files.
# Note: The alias path must match the location_prefix used above for consistency.
Alias {{ slbackup_php_location_prefix | default('/slbackup-php') | trim }} "{{ slbackup_php_web_root | default('/usr/share/slbackup-php/web') }}"

# --------------------------------------------------------------------------
# Directory Access Control
# --------------------------------------------------------------------------
# Defines security and indexing settings for the physical directory holding the app.
<Directory "{{ slbackup_php_web_root | default('/usr/share/slbackup-php/web') }}">
   # Specify the default index file
   DirectoryIndex index.php
   
   # Security: Allow Indexes for debugging if needed, but FollowSymLinks is standard
   Options Indexes FollowSymLinks
   
   # Security: Disable .htaccess override processing for performance and security
   AllowOverride None

   # Access Control: Restrict access to local machine by default.
   # Adjust this line according to your security requirements (e.g., Require ip 10.0.0.0/8).
   Require local
</Directory>
