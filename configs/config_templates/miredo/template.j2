# Defaults for miredo initscript
# sourced by /etc/init.d/miredo
# installed at /etc/default/miredo by the maintainer scripts
#
# This is a POSIX shell fragment
#
# ==============================================================================
# Miredo Teredo Relay/Client Configuration
# ==============================================================================

# Whether to start miredo on system startup.
# Set to true to enable, false to disable.
# Default: True
START_MIREDO={{ start_miredo | default(true) | lower }}

# Additional command-line arguments passed to the miredo daemon.
# Use this for advanced tuning or specific relay server settings.
# Default: '' (empty string)
DAEMON_ARGS="{{ daemon_args | default('') }}"