{
  "auth_authenticator": "webroot",
  "auth_webroot_path": "/var/www/letsencrypt",
  "auth_webroot_map": [
    {
      "domain": "example.com",
      "path": "/var/www/example"
    },
    {
      "domain": "www.example.com",
      "path": "/var/www/example"
    },
    {
      "domain": "api.example.com",
      "path": "/var/www/api"
    }
  ],
  "auth_authenticator_flags": "",
  "installer_installer": "apache",
  "installer_installer_flags": "",
  "email": "admin@example.com",
  "tos": "",
  "agree_to_tos": true,
  "preferred_challenges": [
    "http-01"
  ],
  "rsa_key_size": 4096,
  "staging": false,
  "reuse_key": true,
  "renew_by_default": false,
  "install_certificate": true,
  "log_dir": "/var/log/letsencrypt",
  "work_dir": "/var/lib/letsencrypt",
  "config_dir": "/etc/letsencrypt",
  "verbosity": 2,
  "domains": [
    "example.com",
    "www.example.com",
    "api.example.com"
  ],
  "server": "https://acme-v02.api.letsencrypt.org/directory",
  "keep_logs": false,
  "disable_auto_renewal": false,
  "account": "",
  "force_interactive": false
}
