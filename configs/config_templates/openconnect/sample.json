{
  "hosts": [
    {
      "hostname": "vpn.example.com",
      "display_name": "Primary Corporate VPN",
      "authgroup": "Remote-Access",
      "cafile": "/etc/ssl/certs/example-ca.crt",
      "cert": "/etc/openconnect/client.crt",
      "key": "/etc/openconnect/client.key",
      "port": 443
    },
    {
      "hostname": "backup-vpn.example.net",
      "authgroup": "Backup",
      "proxy": "http://proxy.example.com:3128",
      "usergroup": "Remote-Contractors",
      "comment": "Fallback gateway via corporate proxy"
    },
    {
      "hostname": "test-vpn.internal",
      "proto": "http",
      "auth": "web",
      "port": 8080
    }
  ]
}
