# OpenConnect hostgroup configuration — defines VPN endpoints and credentials to use
# Each line defines a hostgroup with: hostname [display_name] [authgroup] [cafile] [cert] [key] [proxy] [usergroup] [proto] [auth]
# Format: <hostname> [display_name] [authgroup] [cafile=<path>] [cert=<path>] [key=<path>] [proxy=<url>] [usergroup=<name>] [proto=<proto>] [auth=<method>]
{% for host in hosts %}{{ host.hostname }}{% if host.display_name %} {{ host.display_name }}{% endif %}{% if host.authgroup %} {{ host.authgroup }}{% endif %}{% if host.cafile %} cafile={{ host.cafile }}{% endif %}{% if host.cert %} cert={{ host.cert }}{% endif %}{% if host.key %} key={{ host.key }}{% endif %}{% if host.proxy %} proxy={{ host.proxy }}{% endif %}{% if host.usergroup %} usergroup={{ host.usergroup }}{% endif %}{% if host.proto %} proto={{ host.proto }}{% endif %}{% if host.auth %} auth={{ host.auth }}{% endif %}{% if host.port %} :{{ host.port }}{% endif %}{% if host.comment %} # {{ host.comment }}{% endif %}
{% endfor %}