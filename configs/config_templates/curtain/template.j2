{# ============================================================================ #}
{# curtain(1) Configuration Template                                            #}
{#                                                                              #}
{# This file configures the "curtain" utility, which creates an overlay window   #}
{# (e.g., for privacy or distraction-free work).                                #}
{#                                                                              #}
{# All variables use `default()` to ensure valid output even if not provided     #}
{# by the Ansible playbook.                                                     #}
{# ============================================================================ #}

{# window_x: Initial X coordinate of the curtain window in pixels. #}
window_x {{ window_x | default(0) }}

{# window_y: Initial Y coordinate of the curtain window in pixels. #}
window_y {{ window_y | default(0) }}

{# window_width: Initial width of the curtain window in pixels. #}
window_width {{ window_width | default(1920) }}

{# window_height: Initial height of the curtain window in pixels. #}
window_height {{ window_height | default(1080) }}

{# opacity: Opacity level between 0.0 (fully transparent) and 1.0 (fully opaque). #}
opacity {{ opacity | default(0.95) }}

{# color: Background color in 6-digit hex format (e.g., #000000 for black). #}
background_color {{ color | default('#000000') }}

{# always_on_top: Whether the curtain window should stay on top of all others. #}
always_on_top {{ always_on_top | default(true) | string | lower }}

{# hide_cursor: Whether to hide the mouse cursor while the curtain is active. #}
hide_cursor {{ hide_cursor | default(true) | string | lower }}

{# auto_start: Whether to automatically start curtain on user session start. #}
auto_start {{ auto_start | default(false) | string | lower }}