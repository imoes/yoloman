{
  "command": "uptime",
  "hosts": [
    "web1.internal",
    "web2.internal",
    "db1.internal"
  ],
  "identity": "~/.ssh/id_ed25519",
  "ssh_opts": [
    "ServerAliveInterval=60",
    "ServerAliveCountMax=3"
  ],
  "timeout": 10,
  "remote_shell": "bash",
  "login": "deploy",
  "debug": 1,
  "quiet": false,
  "max_parallel": 5,
  "force_agent": false,
  "disable_agent": false,
  "block_output": true,
  "duplicate_hosts": false,
  "no_password": true,
  "proxy_host": "bastion.internal",
  "proxy_ssh_opts": [
    "StrictHostKeyChecking=no"
  ]
}
