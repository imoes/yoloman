# ==============================================================================
# mussh (MUltihost SSH) Execution Wrapper Configuration
# ==============================================================================
# This Jinja2 template generates a Bash wrapper script that invokes the `mussh`
# CLI tool with the specified multi-host SSH options.
#
# mussh executes a single command across multiple hosts concurrently.
# This script constructs the command line arguments based on the provided
# variables and executes the `mussh` binary.
#
# Self-Documentation:
# - All configuration values are sourced from Ansible variables with safe defaults.
# - Variable names in this template match the Ansible role schema exactly.
# - Comments explain the mapping between variables and `mussh` flags.
# ==============================================================================

# --- Configuration Variables ---

# Command to execute on all target hosts.
# Schema: command (string, default: 'uname -a')
COMMAND="{{ command | default('uname -a') }}"

# List of hosts to connect to.
# Accepts 'user@host' or just 'host'.
# Schema: hosts (list, default: ['server1.example.com', 'server2.example.com'])
# We build a space-separated string for the -h argument.
HOSTS=""
{% for host in (hosts | default(['server1.example.com', 'server2.example.com'])) %}
HOSTS="${HOSTS} {{ host }}"
{% endfor %}

# Path to the SSH identity file (private key).
# If empty, mussh/ssh uses the default identity (~/.ssh/id_rsa, etc.).
# Schema: identity (string, default: '')
IDENTITY="{{ identity | default('') }}"

# Timeout setting for each session in seconds.
# Schema: timeout (int, default: 30)
TIMEOUT="{{ timeout | default(30) }}"

# Path to the shell on the remote host.
# Schema: remote_shell (string, default: 'bash')
REMOTE_SHELL="{{ remote_shell | default('bash') }}"

# Login username to use when no user@host is specified in the host list.
# Schema: login (string, default: '')
LOGIN="{{ login | default('') }}"

# Debug level: 0=off, 1=basic, 2=detailed.
# Maps to the -d flag in mussh.
# Schema: debug (int, default: 0)
DEBUG="{{ debug | default(0) }}"

# No output unless necessary. Overrides -d and -v.
# Maps to the -q flag in mussh.
# Schema: quiet (bool, default: false)
QUIET="{{ quiet | default(false) | lower }}"

# Max hosts to run concurrently. 0 for infinite.
# Maps to the -m flag in mussh.
# Schema: max_parallel (int, default: 0)
MAX_PARALLEL="{{ max_parallel | default(0) }}"

# Force loading ssh-agent even if one is already loaded.
# Maps to the -a flag in mussh.
# Schema: force_agent (bool, default: false)
FORCE_AGENT="{{ force_agent | default(false) | lower }}"

# Do NOT load ssh-agent. Prompt for password/passphrase if needed.
# Maps to the -A flag in mussh (Note: mussh uses -A for disable_agent,
# while standard ssh uses -A for agent forwarding; we follow mussh's documented flags).
# Schema: disable_agent (bool, default: false)
DISABLE_AGENT="{{ disable_agent | default(false) | lower }}"

# Print each host's output in a block without mingling.
# Maps to the -b flag in mussh.
# Schema: block_output (bool, default: false)
BLOCK_OUTPUT="{{ block_output | default(false) | lower }}"

# Do NOT make the host list unique. Execute on duplicates.
# Maps to the -u flag in mussh (inverse logic: -u usually means unique,
# so we check if it's NOT false, i.e., if user wants duplicates, we might need
# a specific flag or absence of -u. However, standard mussh docs say -u is unique.
# If duplicate_hosts is True, we DO NOT pass -u. If False, we DO pass -u?
# Actually, let's look at the variable: 'duplicate_hosts: default=False'.
# If False, we want unique hosts. If True, we allow duplicates.
# Standard mussh: -u makes list unique. So if duplicate_hosts is False, we pass -u.
# If duplicate_hosts is True, we do NOT pass -u.
# Schema: duplicate_hosts (bool, default: false)
DUPLICATE_HOSTS="{{ duplicate_hosts | default(false) | lower }}"

# Do NOT fall back to passwords on any host.
# Maps to the -P flag in mussh.
# Schema: no_password (bool, default: false)
NO_PASSWORD="{{ no_password | default(false) | lower }}"

# Host to use as a proxy (bastion host). Format: [user@]host.
# Maps to the -p flag in mussh.
# Schema: proxy_host (string, default: '')
PROXY_HOST="{{ proxy_host | default('') }}"

# List of SSH options to pass to the proxy via -po.
# Schema: proxy_ssh_opts (list, default: [])
PROXY_SSH_OPTS="{{ proxy_ssh_opts | default([]) }}"

# SSH Options to pass via -o.
# Schema: ssh_opts (list, default: [])

# --- Script Generation ---

#!/bin/bash
# ==============================================================================
# Auto-generated mussh execution script
# Generated by Ansible Jinja2 Template
# ==============================================================================
set -e

# Initialize SSH arguments array
SSH_ARGS=()

# Add Identity file if specified
# Flag: -i <path>
{% if identity | default('') %}
SSH_ARGS+=("-i" "{{ identity | default('') }}")
{% endif %}

# Add SSH Options (-o) if specified
# Flags: -o <option>
{% for opt in (ssh_opts | default([])) %}
SSH_ARGS+=("-o" "{{ opt }}")
{% endfor %}

# Add Timeout
# Flag: -t <seconds>
SSH_ARGS+=("-t" "{{ timeout | default(30) }}")

# Add Login username if specified
# Flag: -l <user>
{% if login | default('') %}
SSH_ARGS+=("-l" "{{ login | default('') }}")
{% endif %}

# Add Force Agent flag if enabled
# Flag: -a
{% if force_agent | default(false) %}
SSH_ARGS+=("-a")
{% endif %}

# Add Disable Agent flag if enabled
# Flag: -A (per mussh convention for this role)
{% if disable_agent | default(false) %}
SSH_ARGS+=("-A")
{% endif %}

# Add Block Output flag if enabled
# Flag: -b
{% if block_output | default(false) %}
SSH_ARGS+=("-b")
{% endif %}

# Add Unique Hosts flag (inverse of duplicate_hosts)
# If duplicate_hosts is False (default), we pass -u to ensure unique execution.
# Flag: -u
{% if not duplicate_hosts | default(false) %}
SSH_ARGS+=("-u")
{% endif %}

# Add No Password flag if enabled
# Flag: -P
{% if no_password | default(false) %}
SSH_ARGS+=("-P")
{% endif %}

# Add Debug level
# Flag: -d or -d <level>
{% if debug | default(0) == 1 %}
SSH_ARGS+=("-d")
{% elif debug | default(0) >= 2 %}
SSH_ARGS+=("-d" "2")
{% endif %}

# Add Quiet flag if enabled
# Flag: -q
{% if quiet | default(false) %}
SSH_ARGS+=("-q")
{% endif %}

# Add Max Parallel flag if greater than 0
# Flag: -m <count>
{% if max_parallel | default(0) != 0 %}
SSH_ARGS+=("-m" "{{ max_parallel | default(0) }}")
{% endif %}

# Add Proxy Host if specified
# Flag: -p <host>
{% if proxy_host | default('') %}
SSH_ARGS+=("-p" "{{ proxy_host | default('') }}")

# Add Proxy SSH Options (-po)
# Flag: -po <option>
{% for opt in (proxy_ssh_opts | default([])) %}
SSH_ARGS+=("-po" "{{ opt }}")
{% endfor %}
{% endif %}

# ==============================================================================
# Execute mussh
# ==============================================================================

# Check if command is empty to decide between command execution or stdin
if [ -n "{{ command | default('uname -a') }}" ]; then
    # Execute the specified command on the hosts
    # Flags: -h <hosts> -c <command>
    mussh ${SSH_ARGS[@]} -h ${HOSTS} -c "{{ command | default('uname -a') }}"
else
    # If no command is provided, mussh waits for stdin or does nothing useful
    # We redirect /dev/null to simulate an empty input or immediate exit
    mussh ${SSH_ARGS[@]} -h ${HOSTS} < /dev/null
fi