{
  "log_file": "/var/log/manila/manila-api.log",
  "log_dir": "/var/log/manila",
  "debug": false,
  "bind_host": "0.0.0.0",
  "bind_port": 8786,
  "api_paste_config": "/etc/manila/api-paste.ini",
  "auth_strategy": "keystone",
  "enable_proxy_headers_parsing": true,
  "rate_limit_incoming_requests": 1000,
  "max_shares_per_tenant": 10,
  "max_snapshots_per_share": 10,
  "share_driver_list": [
    {
      "name": "GenericShareDriver",
      "section": "generic",
      "share_driver": "manila.share.drivers.generic.GenericShareDriver",
      "extra_opts": {
        "share_backend_name": "GENERIC",
        "driver_handles_share_servers": false,
        "share_fs_name": "manila_share",
        "share_fs_mount_path": "/mnt/nfs",
        "mount_path": "/mnt/nfs"
      }
    }
  ],
  "database_connection": "mysql+pymsql://manila:manila_db_pass@10.0.0.10/manila",
  "notifications_driver": "messagingv2",
  "keystone_authtoken_auth_url": "http://10.0.0.10:5000",
  "keystone_authtoken_project_domain_name": "Default",
  "keystone_authtoken_user_domain_name": "Default",
  "keystone_authtoken_project_name": "service",
  "keystone_authtoken_username": "manila",
  "keystone_authtoken_password": "manila_svc_pass",
  "lock_path": "/var/lib/manila/tmp",
  "policy_file": "/etc/manila/policy.yaml",
  "endpoint_list": []
}
