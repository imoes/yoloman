{
  "viewport_width": 1920,
  "viewport_height": 1080,
  "fullscreen": false,
  "background_color": "0d0d1a",
  "font_size": 14,
  "padding": 5,
  "gutter_width": 120,
  "paddle_mode": "vhost",
  "paddle_position": 0.5,
  "hide_paddle": false,
  "hide_url_prefix": true,
  "hide_response_code": false,
  "hide_progress": false,
  "speed": 1.0,
  "sync": true,
  "disable_auto_skip": false,
  "start_position": null,
  "stop_position": null,
  "log_format": "combined",
  "max_connects": 200,
  "label_truncation": 64,
  "output_ppm_stream": false,
  "output_framerate": 25,
  "groups": [
    {
      "regex": "\\.(jpg|jpeg|png|gif|ico|svg|webp|avif)$",
      "label": "Images",
      "color": "44aaff"
    },
    {
      "regex": "\\.(css|js|woff2?|ttf|eot)$",
      "label": "Assets",
      "color": "44ff88"
    },
    {
      "regex": "^/api/",
      "label": "API",
      "color": "ffaa00"
    },
    {
      "regex": "^/(wp-admin|admin|phpmyadmin|manager)",
      "label": "Admin",
      "color": "ff4444"
    }
  ]
}
