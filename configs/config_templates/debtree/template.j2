# /etc/debtree/skiplist
# Packages excluded entirely from dependency graphs (except with --no-skip/--show-all).
# Common examples: libc6, zlib1g. Each item is a package name.
{% for pkg in skiplist | default([]) %}{{ pkg }}
{% endfor %}
# /etc/debtree/endlist
# Packages shown in the graph without their dependencies (rendered with diamond shape).
# Each item is a package name.
{% for pkg in endlist | default([]) %}{{ pkg }}
{% endfor %}