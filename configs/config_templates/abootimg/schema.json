{
  "title": {
    "type": "string",
    "default": "",
    "description": "Optional title string for the boot image header"
  },
  "board": {
    "type": "string",
    "default": "",
    "description": "Board name as per boot image header"
  },
  "pagesize": {
    "type": "number",
    "default": 2048,
    "description": "Page size in bytes (e.g., 2048, 4096)"
  },
  "kernel_size": {
    "type": "number",
    "default": 0,
    "description": "Kernel image size in bytes"
  },
  "ramdisk_size": {
    "type": "number",
    "default": 0,
    "description": "Ramdisk image size in bytes"
  },
  "second_size": {
    "type": "number",
    "default": 0,
    "description": "Second stage image size in bytes (optional, only if present)"
  },
  "kernel_tags": {
    "type": "string",
    "default": "0x00000100",
    "description": "Kernel tags physical address (hex string)"
  },
  "cmdlinelen": {
    "type": "number",
    "default": 512,
    "description": "Maximum command line length (chars), typically 512"
  },
  "cmdline": {
    "type": "string",
    "default": "console=ttyHSL0,115200,n8 androidboot.hardware=qcom user_debug=31",
    "description": "Boot command line arguments"
  },
  "id": {
    "type": "string",
    "default": "",
    "description": "Optional image ID as hex bytes (8 \u00d7 4-byte words)"
  }
}
