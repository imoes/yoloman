# ==============================================================================
# SmokePing Configuration Template
# ==============================================================================
# This template generates the main SmokePing configuration file (slaves.conf or
# the main config depending on invocation). It is self-documenting: every
# configurable parameter is preceded by a comment derived from its schema
# description, and every Jinja2 variable reference uses a safe default.

*** General ***

# The full name of the person responsible for this SmokePing installation.
owner    = {{ owner | default('Super User') }}

# Email address for alerts and general contact.
contact  = {{ contact | default('root@localhost') }}

# Hostname or IP of the SMTP server to use for sending emails.
mailhost = {{ mailhost | default('my.mail.host') }}

# Path to the sendmail binary.
sendmail = {{ sendmail | default('/usr/sbin/sendmail') }}

# NOTE: do not put the Image Cache below cgi-bin
# since all files under cgi-bin will be executed ... this is not
# good for images.

# Directory where generated PNG images are stored.
imgcache = {{ imgcache | default('/var/lib/smokeping/images') }}

# URL path prefix for accessing the cached images.
imgurl   = {{ imgurl | default('/smokeping/images') }}

# Directory where RRDtool database files are stored.
datadir  = {{ datadir | default('/var/lib/smokeping/rrd') }}

# Directory where the PID file is stored.
piddir   = {{ piddir | default('/run/smokeping') }}

# Full URL to the SmokePing CGI script.
cgiurl   = {{ cgiurl | default('http://localhost/smokeping/sm.cgi') }}

# Path to the email template for alert notifications.
smokemail = {{ smokemail | default('/etc/smokeping/smokemail') }}

# Path to the tmail script or binary.
tmail     = {{ tmail | default('/etc/smokeping/tmail') }}

# specify this to get syslog logging
syslogfacility = {{ syslogfacility | default('local0') }}

# each probe is now run in its own process
# disable this to revert to the old behaviour
# concurrentprobes = no

*** Alerts ***

# Email address to send alert notifications to.
to = {{ alerts_to | default('root@localhost') }}

# Email address alerts are sent from.
from = {{ alerts_from | default('root@localhost') }}

+someloss
type = loss
# in percent
pattern = >0%,*12*,>0%,*12*,>0%
comment = loss 3 times  in a row

*** Database ***

# Step size in seconds for data collection.
step     = {{ database_step | default('300') }}

# Number of pings sent per step.
pings    = {{ database_pings | default('20') }}

# consfn mrhb steps total

AVERAGE  0.5   1  28800
AVERAGE  0.5  12   9600
    MIN  0.5  12   9600
    MAX  0.5  12   9600
AVERAGE  0.5 144   2400
    MAX  0.5 144   2400
    MIN  0.5 144   2400

*** Presentation ***

# Path to the HTML template file.
template = {{ presentation_template | default('/etc/smokeping/basepage.html') }}

# Whether to include the <title> tag in HTML output.
htmltitle = {{ presentation_htmltitle | default('yes') }}

# Whether to draw borders around graphs.
graphborders = {{ presentation_graphborders | default('no') }}

# If enabled, treat all filter menu queries as literal strings instead of regex.
literalsearch = {{ presentation_literalsearch | default('no') }}

+ charts

menu = Charts
title = The most interesting destinations

++ stddev
sorter = StdDev(entries=>4)
title = Top Standard Deviation
menu = Std Deviation
format = Standard Deviation %f

++ max
sorter = Max(entries=>5)
title = Top Max Roundtrip Time
menu = by Max
format = Max Roundtrip Time %f seconds

++ loss
sorter = Loss(entries=>5)
title = Top Packet Loss
menu = Loss
format = Packets Lost %f

++ median
sorter = Median(entries=>5)
title = Top Median Roundtrip Time
menu = by Median
format = Median RTT %f seconds

+ overview 

# Width of the overview charts in pixels.
width = {{ overview_width | default('600') }}

# Height of the overview charts in pixels.
height = {{ overview_height | default(50) }}

# Default time range for the overview charts.
range = {{ overview_range | default('10h') }}

+ detail

# Width of the detailed charts in pixels.
width = {{ detail_width | default('600') }}

# Height of the detailed charts in pixels.
height = {{ detail_height | default(200) }}

# Tolerance for unison alignment in seconds.
unison_tolerance = {{ detail_unison_tolerance | default('2') }}

"Last 3 Hours"    3h
"Last 30 Hours"   30h
"Last 10 Days"    10d
"Last 360 Days"   360d

#+ hierarchies
#++ owner
#title = Host Owner
#++ location
#title = Location

*** Probes ***

# Path to the fping binary used by the FPing probe.
+ FPing

binary = {{ probes_fping_binary | default('/usr/sbin/fping') }}

*** Slaves ***

# Path to the secrets file for slave authentication.
secrets={{ slaves_secrets | default('/etc/smokeping/smokeping_secrets') }}

+boomer
display_name=boomer
color=0000ff

+slave2
display_name=another
color=00ff00

*** Targets ***

#menuextra = <a target='_blank' href='/smokeping/tr.html{HOST}' class='{CLASS}' \
#               onclick="window.open(this.href,this.target, \
#               'width=800,height=500,toolbar=no,location=no,status=no,scrollbars=no'); \
#                return false;">*</a>
#
# Default probe to use for targets.
probe = {{ targets_probe | default('FPing') }}

# Menu name for the top-level target group.
menu = {{ targets_menu | default('Top') }}

# Title for the top-level target group.
title = {{ targets_title | default('Network Latency Grapher') }}

# Remark/description text for the top-level target group.
remark = {{ targets_remark | default("Welcome to the SmokePing website of <b>Insert Company Name Here</b>. ") }}

+ Ping

# Menu name for the Fedora target group.
menu = {{ targets_fedora_menu | default('Fedora') }}

# Title for the Fedora target group.
title = {{ targets_fedora_title | default('Fedora Pings') }}

++ FedoraprojectOrg

# Menu name for the fedoraproject.org target.
menu = {{ targets_fedoraprojectorg_menu | default('fedoraproject.org') }}

# Title for the fedoraproject.org target.
title = {{ targets_fedoraprojectorg_title | default('Fedora Webserver') }}

# Hostname or IP for the fedoraproject.org target.
host = {{ targets_fedoraprojectorg_host | default('fedoraproject.org') }}

++ DocsFedoraprojectOrg

# Menu name for the docs.fedoraproject.org target.
menu = {{ targets_docsfedoraprojectorg_menu | default('docs.fedoraproject.org') }}

# Title for the docs.fedoraproject.org target.
title = {{ targets_docsfedoraprojectorg_title | default('Fedora Docs Webserver') }}

# Hostname or IP for the docs.fedoraproject.org target.
host = {{ targets_docsfedoraprojectorg_host | default('docs.fedoraproject.org') }}

++ PlanetFedora

# Menu name for the planet.fedoraproject.org target.
menu = {{ targets_planetfedora_menu | default('planet.fedoraproject.org') }}

# Title for the planet.fedoraproject.org target.
title = {{ targets_planetfedora_title | default('Planet Fedora') }}

# Hostname or IP for the planet.fedoraproject.org target.
host = {{ targets_planetfedora_host | default('planet.fedoraproject.org') }}

