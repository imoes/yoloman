{
  "pid_dir": {
    "type": "string",
    "default": "/var/run/vblade/",
    "description": "Directory where vblade instance PID files are stored."
  },
  "shelf": {
    "type": "string",
    "default": "10",
    "description": "SCSI shelf address. Mandatory."
  },
  "slot": {
    "type": "string",
    "default": "3",
    "description": "SCSI slot address. Mandatory."
  },
  "netif": {
    "type": "string",
    "default": "em3",
    "description": "Network interface name. Mandatory."
  },
  "filename": {
    "type": "string",
    "default": "/dev/mapper/export",
    "description": "The name of the regular file or block device to export. Mandatory."
  },
  "options": {
    "type": "string",
    "default": "-m 11:22:33:44:55:66 -o 8",
    "description": "Other options passed to vblade."
  },
  "ionice": {
    "type": "string",
    "default": "--class best-effort --classdata 7",
    "description": "I/O scheduling class and priority string for ionice."
  }
}
