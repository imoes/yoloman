# ==============================================================================
# vblade Instance Configuration
# ==============================================================================
# This template generates a POSIX shell fragment used to configure a single
# vblade (iSCSI target) instance. vblade exports a file or block device over
# the network using the IET iSCSI target protocol (often used with iscsi-initiator-utils).
#
# Self-documenting: Each variable is described in the comment above its assignment.
# Defaults are taken from the Ansible schema to ensure safe rendering even if
# a role caller omits these variables.
# ==============================================================================

# Directory where vblade instance PID files are stored.
# Used by the init script/service wrapper to track the process.
vblade_pid_dir="{{ pid_dir | default('/var/run/vblade/') }}"

# SCSI shelf address. Mandatory.
# Identifies the shelf in the SCSI topology.
vblade_shelf="{{ shelf | default('10') }}"

# SCSI slot address. Mandatory.
# Identifies the specific slot/device on the shelf.
vblade_slot="{{ slot | default('3') }}"

# Network interface name. Mandatory.
# The network interface vblade will bind to/listen on for iSCSI traffic.
vblade_netif="{{ netif | default('em3') }}"

# The name of the regular file or block device to export. Mandatory.
# Path to the underlying storage backing the virtual SCSI device.
vblade_filename="{{ filename | default('/dev/mapper/export') }}"

# Other options passed to vblade.
# Allows passing additional flags as documented in vblade(8).
# Example default includes MAC address and offset options.
vblade_options="{{ options | default('-m 11:22:33:44:55:66 -o 8') }}"

# I/O scheduling class and priority string for ionice.
# Controls how vblade's disk I/O interacts with the host OS I/O scheduler.
vblade_ionice="{{ ionice | default('--class best-effort --classdata 7') }}"
