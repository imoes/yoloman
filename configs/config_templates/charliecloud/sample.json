{
  "debug": false,
  "build_dir": "/scratch/charliecloud/build",
  "cache_dir": "/scratch/charliecloud/cache",
  "image_dir": "/scratch/charliecloud/images",
  "tmp_dir": "/scratch/charliecloud/tmp",
  "no_cache": false,
  "jobs": 4,
  "bind_mounts": [
    "/project:/project:ro",
    "/scratch:/scratch:rw"
  ],
  "env_forward": [
    "PATH",
    "LD_LIBRARY_PATH",
    "MODULEPATH"
  ],
  "enable_userns": true,
  "fallback_builder": "/usr/bin/docker",
  "enable_fallback": true,
  "strict": false,
  "shell": "/bin/bash",
  "no_overlay": false,
  "overlay_dir": "/scratch/charliecloud/overlay",
  "enable_run_user": true,
  "fallback_run_user": true
}
