{
  "envs": [
    {
      "name": "TERM",
      "value": "xterm"
    },
    {
      "name": "LC_ALL",
      "value": "C"
    }
  ],
  "columns": 80,
  "lines": 24,
  "window_delay": 10,
  "window_min_delay": 5,
  "client": "cat",
  "client_args": [
    "/dev/stdin"
  ],
  "steps": [
    {
      "type": "send",
      "delay": 100,
      "items": [
        {
          "string": "hello",
          "min_delay": 10
        },
        {
          "string": "\\n",
          "min_delay": 5
        }
      ]
    },
    {
      "type": "expect",
      "strings": [
        "hello",
        "world"
      ]
    },
    {
      "type": "expect_exit",
      "status": 0
    }
  ]
}
