# ==============================================================================
# sntop Configuration Template
# ==============================================================================
# This template generates the sntoprc configuration file for the 'sntop' network
# topology display tool. It defines host entries to monitor, each with a display
# name, host/IP address, and a descriptive comment.
#
# The tool is a simple, ncurses-based network traffic monitor similar to 'top'
# but focused on network interfaces and hosts.
# ==============================================================================

# --- Gator Host Entry ---
# Display name for the first host entry (Gator).
# This label appears in the sntop UI to identify the host.
# Default: 'Gator'
{{ (gator_display_name | default('Gator')) | indent(0) }}

# IP address or hostname for the first host entry.
# This is the target host that sntop will monitor or display.
# Default: '192.168.23.1'
{{ (gator_host_or_ip | default('192.168.23.1')) | indent(0) }}

# Display comments for the first host entry.
# A description shown in the UI for context about the host.
# Default: 'local linux/alpha server'
{{ (gator_display_comments | default('local linux/alpha server')) | indent(0) }}

# --- Yahoo Host Entry ---
# Display name for the second host entry (Yahoo).
# This label appears in the sntop UI to identify the host.
# Default: 'Yahoo'
{{ (yahoo_display_name | default('Yahoo')) | indent(0) }}

# IP address or hostname for the second host entry.
# This is the target host that sntop will monitor or display.
# Default: 'www.yahoo.com'
{{ (yahoo_host_or_ip | default('www.yahoo.com')) | indent(0) }}

# Display comments for the second host entry.
# A description shown in the UI for context about the host.
# Default: 'something on the outside'
{{ (yahoo_display_comments | default('something on the outside')) | indent(0) }}

# --- Localhost Entry ---
# Display name for the third host entry.
# This label appears in the sntop UI to identify the host.
# Default: 'localhost'
{{ (localhost_display_name | default('localhost')) | indent(0) }}

# IP address or hostname for the third host entry.
# This is the target host that sntop will monitor or display.
# Default: '127.0.0.1'
{{ (localhost_host_or_ip | default('127.0.0.1')) | indent(0) }}

# Display comments for the third host entry.
# A description shown in the UI for context about the host.
# Default: 'does loopback even work?'
{{ (localhost_display_comments | default('does loopback even work?')) | indent(0) }}

# End of configuration