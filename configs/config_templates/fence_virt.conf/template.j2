# fence_virt configuration file
# This template generates the configuration for fence_virt, a fencing agent for HA clusters.
# It supports multiple listeners and backends, though this specific template focuses on
# the multicast listener and libvirt backend by default.

fence_virtd {
    # Listener type to use (e.g., 'multicast', 'serial', 'tcp', 'vsock').
    # Only one active listener is supported at a time by this configuration structure.
    listener = "{{ listeners | default([{'name': 'multicast'}]) | first | attr('name') | default('multicast') }}";

    # Backend plugin name to use (e.g., 'libvirt').
    backend = "{{ backends | default([{'name': 'libvirt'}]) | first | attr('name') | default('libvirt') }}";
}

listeners {
    # Iterate over defined listener blocks to generate listener-specific configuration sections.
    # Each block defines how fence_virt communicates with the cluster nodes.
    {% for listener in listeners | default([{'name': 'multicast'}]) %}
    {{ listener.name | default('multicast') }} {
        {% if listener.name == 'multicast' %}
        # Path to the shared secret key file used for authenticating fencing messages.
        key_file = "{{ listener.key_file | default('/etc/fence_virt.key') }}";

        # Multicast group address to bind to for receiving/sending fencing commands.
        address = "{{ listener.address | default('225.0.0.12') }}";

        # Network interface to bind the multicast socket to.
        # On some systems (e.g., Fedora), explicitly setting this is required for proper binding.
        interface = "{{ listener.interface | default('virbr0') }}";
        {% else %}
        # Other listener types (serial, tcp, vsock) may have different configuration options.
        # This template currently defaults to multicast settings.
        # Add specific logic here if extending support for other listener types.
        {# Placeholder for other listener types #}
        {% endif %}
    }
    {% endfor %}
}

backends {
    # Iterate over defined backend blocks to generate backend-specific configuration sections.
    # Each backend plugin handles the actual fencing operations.
    {% for backend in backends | default([{'name': 'libvirt', 'uri': 'qemu:///system'}]) %}
    {{ backend.name | default('libvirt') }} {
        # URI connection string for the backend service.
        # For libvirt, this typically points to the hypervisor connection (e.g., qemu:///system).
        uri = "{{ backend.uri | default('qemu:///system') }}";
    }
    {% endfor %}
}
