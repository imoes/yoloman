{
  "multicast": {
    "address": "239.192.148.15",
    "port": 1229,
    "interface": "br0"
  },
  "listeners": [
    {
      "type": "libvirt",
      "path": "/var/run/fence_virt.sock",
      "mode": "0660",
      "group": "libvirt",
      "timeout": 25
    }
  ],
  "auth": {
    "type": "keyfile",
    "keyfile": "/etc/fence_virt.key"
  },
  "logging": {
    "level": "info",
    "file": "syslog"
  },
  "drivers": [
    {
      "name": "libvirt",
      "timeout": 30,
      "retry": 3,
      "retry_sleep": 5
    }
  ]
}
