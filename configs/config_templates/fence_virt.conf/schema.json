{
  "listeners": {
    "type": "list",
    "default": [
      {
        "name": "multicast"
      }
    ],
    "description": "List of listener types (only one active at a time). Supported: 'multicast', 'serial', 'tcp', 'vsock'. This template supports only 'multicast' via listener_blocks."
  },
  "listener_blocks": {
    "type": "list",
    "default": [
      {
        "name": "multicast",
        "key_file": "/etc/fence_virt.key",
        "address": "225.0.0.12",
        "interface": "virbr0"
      }
    ],
    "description": "Listener-specific configuration blocks \u2014 e.g., listeners/multicast {}, listeners/serial {}, etc."
  },
  "listener_blocks[].name": {
    "type": "string",
    "default": "multicast",
    "description": "Listener name. Currently only 'multicast' supported by this template.",
    "enum": [
      "multicast",
      "serial",
      "tcp",
      "vsock"
    ]
  },
  "listener_blocks[].key_file": {
    "type": "string",
    "default": "/etc/fence_virt.key",
    "description": "Path to key file."
  },
  "listener_blocks[].address": {
    "type": "string",
    "default": "225.0.0.12",
    "description": "Multicast address to listen on."
  },
  "listener_blocks[].interface": {
    "type": "string",
    "default": "virbr0",
    "description": "Interface to bind to for multicast listener."
  },
  "backends": {
    "type": "list",
    "default": [
      {
        "name": "libvirt",
        "uri": "qemu:///system"
      }
    ],
    "description": "Backend plugins for fence_virt."
  },
  "backends[].name": {
    "type": "string",
    "default": "libvirt",
    "description": "Backend plugin name.",
    "enum": [
      "libvirt",
      "cpg"
    ]
  },
  "backends[].uri": {
    "type": "string",
    "default": "qemu:///system",
    "description": "URI for the backend connection."
  }
}
