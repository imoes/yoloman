# Directory where ISO/floppy images are stored for grub-imageboot
# This variable controls the path to the directory containing bootable
# ISO images, floppy images, or raw disk images that GRUB can chainload.
IMAGES="{{ IMAGES | default('/boot/images') }}"

# You can override the boot options for iso/floppy images here
# see http://syslinux.zytor.com/wiki/index.php/MEMDISK for details
#
# Available options typically include:
#   rawimg       - Treat the image as a raw disk image
#   iso          - Treat the image as an ISO 9660 CD-ROM image
#   memdisk      - Use Syslinux memdisk for special handling
#
# To use, uncomment and set the desired option below:
# IMAGEOPTS="rawimg"
# ISOOPTS="iso"