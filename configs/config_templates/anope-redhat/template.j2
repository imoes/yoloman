/*
 * =============================================================================
 * Anope IRC Services Configuration
 * =============================================================================
 * This configuration file controls Anope's connection to the IRC network,
 * its internal behavior, logging, mail capabilities, and database storage.
 *
 * Self-Documentation:
 * Every variable is sourced from Ansible host/group vars. If a variable is
 * not defined in Ansible, the schema default (specified in the comment above)
 * will be used.
 *
 * To override a setting, define the corresponding Ansible variable.
 * Example: services_host = "irc.mynet.example.com"
 * =============================================================================
 */

/*
 * [OPTIONAL] Defines
 *
 * Defines allow you to set values that can be reused elsewhere in the config.
 */
define
{
	name = "services.host"
	/*
	 * services_host: The hostname that Anope will be seen as and used in defines.
	 * Default: services.example.com
	 */
	value = "{{ services_host | default('services.example.com') }}"
}

/*
 * [OPTIONAL] Additional Includes
 *
 * You can include additional configuration files here.
 * You may also include executable files, which will be executed and
 * the output from it will be included into your configuration.
 *
 * NOTE: The example below includes example files that are commented out.
 * Uncomment and modify if you have external config fragments.
 */
#include
{
	type = "file"
	name = "some.conf"
}

/*
#include
{
	type = "executable"
	name = "/usr/bin/wget -q -O - https://some.misconfigured.network.com/anope.conf"
}
*/

/*
 * [REQUIRED] IRCd Config (Uplink)
 *
 * This section configures how Anope connects to the upstream IRC server.
 * This block can be included multiple times for failover.
 */
uplink
{
	/*
	 * uplink_host: The IP address, hostname, or UNIX socket path of the IRC server.
	 * Default: 127.0.0.1
	 */
	host = "{{ uplink_host | default('127.0.0.1') }}"

	/*
	 * uplink_protocol: The protocol Anope uses when connecting (ipv4, ipv6, unix).
	 * Default: ipv4
	 */
	protocol = "{{ uplink_protocol | default('ipv4') }}"

	/*
	 * uplink_ssl: Enable SSL connection to the uplink (true/false).
	 * Note: Jinja renders boolean 'true'/'false' as strings here.
	 * Default: no
	 */
	ssl = {{ uplink_ssl | default('no') }}

	/*
	 * uplink_port: The port to connect to on the IRCd.
	 * Default: 7000
	 */
	port = {{ uplink_port | default('7000') }}

	/*
	 * uplink_password: The password to send to the IRC server for authentication.
	 * Default: mypassword
	 */
	password = "{{ uplink_password | default('mypassword') }}"
}

/*
 * [REQUIRED] Server Information
 *
 * This section contains information about the services server itself.
 */
serverinfo
{
	/*
	 * services_host: The hostname that Anope will be seen as.
	 * Must not conflict with other server names on the network.
	 * Default: services.example.com
	 */
	name = "{{ services_host | default('services.example.com') }}"

	/*
	 * server_description: The text which appears as the server's information in /WHOIS.
	 * Default: Anope IRC Services
	 */
	description = "{{ server_description | default('Anope IRC Services') }}"

	/*
	 * localhost: The local address that Anope will bind to before connecting.
	 * Useful for multihomed hosts. Omitted by default.
	 */
	#localhost = "nowhere."

	/*
	 * id: What Server ID to use for this connection?
	 * Only used for TS6/P10 IRCds.
	 */
	#id = "00A"

	/*
	 * pid_file: The filename containing the Anope process ID.
	 * Default: /run/anope/anope.pid
	 */
	pid = "{{ pid_file | default('/run/anope/anope.pid') }}"

	/*
	 * motd: The filename containing the Message of the Day.
	 */
	motd = "motd"
}

/*
 * [REQUIRED] Protocol module
 *
 * Tells Anope which IRCd Protocol module to speak.
 * Supported: bahamut, hybrid, inspircd, ngircd, plexus, ratbox, solanum, unrealircd.
 */
module
{
	/*
	 * protocol_module: The IRCd Protocol module to speak when connecting.
	 * Default: inspircd
	 */
	name = "{{ protocol_module | default('inspircd') }}"

	/*
	 * protocol_use_server_side_mlock: Enforce mode locks server-side.
	 * Reduces spam caused by services reversing mode changes.
	 * Default: yes
	 */
	use_server_side_mlock = {{ protocol_use_server_side_mlock | default('yes') }}

	/*
	 * protocol_use_server_side_topiclock: Enforce topic locks server-side.
	 * Reduces spam caused by services reversing topic changes.
	 * Default: yes
	 */
	use_server_side_topiclock = {{ protocol_use_server_side_topiclock | default('yes') }}
}

/*
 * [REQUIRED] Network Information
 *
 * Information about the IRC network Anope is running on.
 */
networkinfo
{
	/*
	 * network_name: The name of the network Anope is running on.
	 * Default: LocalNet
	 */
	networkname = "{{ network_name | default('LocalNet') }}"

	/*
	 * nicklen: Maximum allowed nick length on your network.
	 * Default: 31
	 */
	#nicklen = 31

	/*
	 * userlen: Maximum allowed ident length on your network.
	 * Default: 10
	 */
	#userlen = 10

	/*
	 * hostlen: Maximum allowed hostname length on your network.
	 * Default: 64
	 */
	#hostlen = 64

	/*
	 * chanlen: Maximum allowed channel length.
	 * Default: 32
	 */
	#chanlen = 32

	/*
	 * modelistsize: Maximum number of list modes settable on a channel.
	 * Default: 100
	 */
	#modelistsize = 100

	/*
	 * nick_chars: Characters allowed in nicknames.
	 * Recommended: Do not change unless you know your IRCd supports it.
	 */
	#nick_chars = ""

	/*
	 * vhost_chars: Characters allowed in hostnames/vhosts.
	 */
	vhost_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-"

	/*
	 * allow_undotted_vhosts: Allows vHosts to not contain dots (.).
	 * Default: false
	 */
	allow_undotted_vhosts = false

	/*
	 * disallow_start_or_end: Characters not allowed at the start/end of a vHost.
	 * Default: ".-"
	 */
	disallow_start_or_end = ".-"
}

/*
 * [REQUIRED] Anope Options
 *
 * General operational options for Anope.
 */
options
{
	/*
	 * user/group: The user/group Anope runs as.
	 * Default: anope/anope (uncomment to enable)
	 */
	#user = "anope"
	#group = "anope"

	/*
	 * casemap: The case mapping used by services (e.g., ascii, rfc1459).
	 * Default: ascii
	 */
	casemap = "{{ casemap | default('ascii') }}"

	/*
	 * badpasslimit: Number of invalid password tries before a user is removed.
	 * Default: 5
	 */
	badpasslimit = {{ badpasslimit | default('5') }}

	/*
	 * badpasstimeout: Time after which invalid passwords are forgotten.
	 * Format: "1h", "30m", "3600s".
	 * Default: 1h
	 */
	badpasstimeout = "{{ badpasstimeout | default('1h') }}"

	/*
	 * updatetimeout: Delay between automatic database updates.
	 * Default: 5m
	 */
	updatetimeout = "{{ updatetimeout | default('5m') }}"

	/*
	 * expiretimeout: Delay between checks for expired nicknames and channels.
	 * Default: 30m
	 */
	expiretimeout = "{{ expiretimeout | default('30m') }}"

	/*
	 * readtimeout: Timeout period for reading from the uplink.
	 * Default: 5s
	 */
	readtimeout = "{{ readtimeout | default('5s') }}"

	/*
	 * warningtimeout: Interval between sending warning messages for program errors.
	 * Default: 4h
	 */
	warningtimeout = "{{ warningtimeout | default('4h') }}"

	/*
	 * timeoutcheck: Frequency at which the timeout list is checked.
	 * Default: 3s
	 */
	timeoutcheck = "{{ timeoutcheck | default('3s') }}"

	/*
	 * useprivmsg: Allow PRIVMSGs to users instead of NOTICEs.
	 * Against RFC, not recommended.
	 */
	#useprivmsg = yes

	/*
	 * usestrictprivmsg: Only respond to PRIVMSGs addressed to Nick@ServerName.
	 */
	#usestrictprivmsg = yes

	/*
	 * hidestatso: Only show /stats o to IRC Operators.
	 */
	#hidestatso = yes

	/*
	 * ulineservers: Space-separated list of U-lined servers trusted for mode changes.
	 */
	#ulineservers = "stats.your.network"

	/*
	 * retrywait: Time to wait between connection retries with the uplink(s).
	 * Default: 60s
	 */
	retrywait = "{{ retrywait | default('60s') }}"

	/*
	 * hideprivilegedcommands: Hide commands users don't have privilege to execute from HELP.
	 * Default: yes
	 */
	hideprivilegedcommands = {{ hideprivilegedcommands | default('yes') }}

	/*
	 * hideregisteredcommands: Hide commands users can't execute because not logged in from HELP.
	 * Default: yes
	 */
	hideregisteredcommands = {{ hideregisteredcommands | default('yes') }}

	/*
	 * didyoumeandifference: Maximum difference between invalid and valid command name for suggestions.
	 * Default: 4
	 */
	didyoumeandifference = {{ didyoumeandifference | default('4') }}

	/*
	 * regexengine: The regex engine to use. Leave commented to disable.
	 */
	#regexengine = "regex/stdlib"

	/*
	 * languages: Space-separated list of languages to load on startup.
	 * Default: ca_ES.UTF-8 de_DE.UTF-8 el_GR.UTF-8 es_ES.UTF-8 fr_FR.UTF-8 hu_HU.UTF-8 it_IT.UTF-8 nl_NL.UTF-8 pl_PL.UTF-8 pt_PT.UTF-8 ru_RU.UTF-8 tr_TR.UTF-8
	 */
	languages = "{{ languages | default('ca_ES.UTF-8 de_DE.UTF-8 el_GR.UTF-8 es_ES.UTF-8 fr_FR.UTF-8 hu_HU.UTF-8 it_IT.UTF-8 nl_NL.UTF-8 pl_PL.UTF-8 pt_PT.UTF-8 ru_RU.UTF-8 tr_TR.UTF-8') }}"

	/*
	 * defaultlanguage: Default language for non-registered nicks.
	 */
	#defaultlanguage = "es_ES.UTF-8"
}

/*
 * [OPTIONAL] BotServ
 */
include
{
	type = "file"
	name = "botserv.conf"
}

/*
 * [RECOMMENDED] ChanServ
