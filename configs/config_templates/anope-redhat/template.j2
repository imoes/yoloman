/*
 * [RECOMMENDED] Logging Configuration
 */
log
{
	/*
	 * log_target: Target(s) to log to (channel, filename, or globops).
	 * Default: services.log
	 */
	target = "{{ log_target | default('services.log') }}"

	/*
	 * source: The source(s) to only accept log messages from.
	 */
	#source = ""

	/*
	 * log_bot: The bot used to log generic messages.
	 * Default: Global
	 */
	bot = "{{ log_bot | default('Global') }}"

	/*
	 * log_logage: Number of days to keep log files. Set to 0 to never delete.
	 * Default: 7
	 */
	logage = {{ log_logage | default('7') }}

	/*
	 * Log categories. Use "*" for all, "~" to negate.
	 */
	admin = "*"
	override = "chanserv/* nickserv/* memoserv/set ~botserv/set botserv/*"
	commands = "~operserv/* *"
	servers = "*"
	users = "connect disconnect nick"
	other = "*"

	/*
	 * log_rawio: Log raw input and output from services.
	 * Default: no
	 */
	rawio = {{ log_rawio | default('no') }}

	/*
	 * log_debug: Log debug messages.
	 * Default: no
	 */
	debug = {{ log_debug | default('no') }}
}

/*
 * A log block to globops some useful things.
 */
log
{
	bot = "Global"
	target = "globops"
	admin = "global/* operserv/chankill operserv/mode operserv/kick operserv/akill operserv/s*line operserv/noop operserv/jupe operserv/set operserv/svsnick operserv/svsjoin operserv/svspart nickserv/getpass */drop"
	servers = "squit"
	users = "oper"
	other = "expire/* bados akill/*"
}

/*
 * [RECOMMENDED] Oper Access Config
 *
 * Defines operator types and their permissions.
 */

opertype
{
	name = "Helper"
	commands = "hostserv/*"
}

opertype
{
	name = "Services Operator"
	inherits = "Helper, Another Helper"
	commands = "chanserv/list chanserv/suspend chanserv/topic memoserv/staff nickserv/list nickserv/suspend operserv/mode operserv/chankill operserv/akill operserv/session operserv/modinfo operserv/sqline operserv/oper operserv/kick operserv/ignore operserv/snline"
	privs = "chanserv/auspex chanserv/no-register-limit memoserv/* nickserv/auspex nickserv/confirm"
}

opertype
{
	name = "Services Administrator"
	inherits = "Services Operator"
	commands = "botserv/* chanserv/access/list chanserv/drop chanserv/getkey chanserv/saset/noexpire memoserv/sendall nickserv/saset/* nickserv/getemail operserv/news operserv/jupe operserv/svs operserv/stats operserv/noop operserv/forbid global/*"
	privs = "*"
}

opertype
{
	name = "Services Root"
	commands = "*"
	privs = "*"
}

/*
 * Oper blocks define specific users and their opertype.
 * Commented out by default for security. Uncomment and configure as needed.
 */

#oper
{
	/*
	 * name: The nickname of this services oper.
	 */
	#name = "nick1"

	/*
	 * type: The opertype this person will have.
	 */
	type = "Services Root"

	/*
	 * oper_require_oper: If set, the user must be an oper on the IRCd to gain their oper privileges.
	 * Default: yes
	 */
	require_oper = {{ oper_require_oper | default('yes') }}

	#password = "secret"
	#certfp = "ed3383b3f7d74e89433ddaa4a6e5b2d7"
	#host = "*@*.anope.org ident@*"
	#vhost = "oper.mynet"
}

#oper
{
	name = "nick2"
	type = "Services Administrator"
}

#oper
{
	name = "nick3"
	type = "Helper"
}

/*
 * [OPTIONAL] Mail Config
 *
 * Settings related to email from services.
 */
mail
{
	/*
	 * mail_usemail: Enable mail commands in Anope.
	 * Default: yes
	 */
	usemail = {{ mail_usemail | default('yes') }}

	/*
	 * sendmailpath: Command-line to call the mailer.
	 */
	#sendmailpath = "/usr/sbin/sendmail -it"

	/*
	 * mail_sendfrom: The email address from which all emails are sent.
	 * Default: services@example.com
	 */
	sendfrom = "{{ mail_sendfrom | default('services@example.com') }}"

	/*
	 * mail_delay: Minimum time a user must wait before sending another email.
	 * Default: 5m
	 */
	delay = "{{ mail_delay | default('5m') }}"

	/*
	 * dontquoteaddresses: Do not put quotes around TO: fields.
	 */
	#dontquoteaddresses = yes

	/*
	 * content_type: Content type for emails.
	 */
	#content_type = "text/plain; charset=UTF-8"

	registration_subject = "Nickname registration for %n"
	registration_message = "Hi,

				You have requested to register the nickname %n on %N.
				Please type \" /msg NickServ CONFIRM %c \" to complete registration.

				If you don't know why this mail was sent to you, please ignore it silently.

				%N administrators."

	reset_subject = "Reset password request for %n"
	reset_message = "Hi,

			You have requested to have the password for %n reset.
			To reset your password, type \" /msg NickServ CONFIRM %n %c \"

			If you don't know why this mail was sent to you, please ignore it silently.

			%N administrators."

	emailchange_subject = "Email confirmation"
	emailchange_message = "Hi,

			You have requested to change your email address from %e to %E.
			Please type \" /msg NickServ CONFIRM %c \" to confirm this change.

			If you don't know why this mail was sent to you, please ignore it silently.

			%N administrators."

	memo_subject = "New memo"
	memo_message = "Hi %n,

			You've just received a new memo from %s. This is memo number %d.

			Memo text:

			%t"
}

/*
 * [REQUIRED] Database configuration.
 *
 * Configure the database backend Anope uses for persistence.
 */

/*
 * [DEPRECATED] db_old
 * Used only for upgrading old binary databases.
 */
#module
{
	name = "db_old"
	#hash = "md5"
}

/*
 * db_atheme
 * Import from Atheme databases.
 */
#module
{
	name = "db_atheme"
	database = "atheme.db"
}

/*
 * [RECOMMENDED] db_flatfile
 * Default flatfile database format.
 */
module
{
	/*
	 * db_module_name: The database module to load.
	 * Default: db_flatfile
	 */
	name = "{{ db_module_name | default('db_flatfile') }}"

	/*
	 * db_database: The database file name or engine identifier.
	 * Default: anope.db
	 */
	database = "{{ db_database | default('anope.db') }}"

	/*
	 * db_keepbackups: Number of days backups of databases are kept.
	 * Default: 3
	 */
	keepbackups = {{ db_keepbackups | default('3') }}

	/*
	 * nobackupokay: Allow continuing if backup fails. Discouraged.
	 */
	#nobackupokay = yes

	/*
	 * db_fork: Fork a child process to save databases.
	 * Default: no
	 */
	fork = {{ db_fork | default('no') }}
}

/*
 * db_sql and db_sql_live
 * SQL database backend.
 */
#module
{
	name = "db_sql"
	#name = "db_sql_live"

	/*
	 * db_engine: The SQL service or database engine to use (e.g., sqlite/main, mysql/main).
	 * Default: sqlite/main
	 */
	engine = "{{ db_engine | default('sqlite/main') }}"

	/*
	 * prefix: Optional prefix for table names.
	 */
	#prefix = "anope_db_"

	/*
	 * db_import: Import data from another database module on startup.
	 * Default: false
	 */
	import = {{ db_import | default('false') }}
}

/*
 * db_redis
 * Redis backend.
 */
#module
{
	name = "db_redis"
	engine = "redis/main"
}

/*
 * [RECOMMENDED] Encryption modules.
 */
module
{
	name = "enc_sha2"
	#algorithm = "sha256"
}

/*
 * [EXTRA] enc_argon2
 */
#module
{
	name = "enc_argon2"
	#algorithm = "argon2id"
	#memory_cost = 121072
	#time_cost = 3
	#parallelism = 1
	#hash_length = 32
	#salt_length = 32
}

/*
 * enc_bcrypt
 */
#module
{
	name = "enc_bcrypt"
	#rounds = 10
}

/*
 * enc_posix
 */
#module { name = "enc_posix" }

/*
 * [DEPRECATED] Older encryption methods.
 */
#module { name = "enc_md5" }
#module { name = "enc_none" }
#module { name = "enc_old" }
#module { name = "enc_sha1" }
#module { name = "enc_sha256" }

/*
 * Extra (optional) modules.
 */
include
{
	type = "file"
	name = "modules.conf"
}

/*
 * Chanstats module. Requires a MySQL Database.
 */
#include
{
	type = "file"
	name = "chanstats.conf"
}

/*
 * IRC2SQL Gateway. Requires MySQL 5.5+.
 */
#include
{
	type = "file"
	name = "irc2sql.conf"
}
