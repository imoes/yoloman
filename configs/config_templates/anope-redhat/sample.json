{
  "services_host": "services.example.com",
  "uplink_host": "127.0.0.1",
  "uplink_protocol": "ipv4",
  "uplink_ssl": false,
  "uplink_port": 7000,
  "uplink_password": "mypassword",
  "server_description": "Anope IRC Services",
  "pid_file": "/run/anope/anope.pid",
  "protocol_module": "inspircd",
  "protocol_use_server_side_mlock": true,
  "protocol_use_server_side_topiclock": true,
  "network_name": "LocalNet",
  "casemap": "ascii",
  "badpasslimit": 5,
  "badpasstimeout": "1h",
  "updatetimeout": "5m",
  "expiretimeout": "30m",
  "readtimeout": "5s",
  "warningtimeout": "4h",
  "timeoutcheck": "3s",
  "retrywait": "60s",
  "hideprivilegedcommands": true,
  "hideregisteredcommands": true,
  "didyoumeandifference": 4,
  "languages": "ca_ES.UTF-8 de_DE.UTF-8 el_GR.UTF-8 es_ES.UTF-8 fr_FR.UTF-8 hu_HU.UTF-8 it_IT.UTF-8 nl_NL.UTF-8 pl_PL.UTF-8 pt_PT.UTF-8 ru_RU.UTF-8 tr_TR.UTF-8",
  "log_target": "services.log",
  "log_bot": "Global",
  "log_logage": 7,
  "log_rawio": false,
  "log_debug": false,
  "oper_require_oper": true,
  "mail_usemail": true,
  "mail_sendfrom": "services@example.com",
  "mail_delay": "5m",
  "db_module_name": "db_flatfile",
  "db_database": "anope.db",
  "db_keepbackups": 3,
  "db_fork": false,
  "db_engine": "sqlite/main",
  "db_import": false
}
