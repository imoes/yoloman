{
  "timestamp": {
    "type": "string",
    "default": "",
    "description": "Log timestamp pattern (kept as regex component, not parametrizable as scalar)"
  },
  "pid": {
    "type": "string",
    "default": "",
    "description": "Process ID capture group (kept as regex component)"
  },
  "result": {
    "type": "string",
    "default": "Pass",
    "description": "SPF check result value",
    "enum": [
      "Pass",
      "Neutral",
      "None",
      "Softfail",
      "Fail",
      "Temperror",
      "Permerror"
    ]
  },
  "method": {
    "type": "string",
    "default": "helo",
    "description": "SPF check method (helo or mailfrom)",
    "enum": [
      "helo",
      "mailfrom"
    ]
  },
  "client_ip": {
    "type": "string",
    "default": "0.0.0.0",
    "description": "Client IP address pattern"
  }
}
