{#
  postfix-policyd-spf-python configuration template
  This configuration is passed to the `postfix-policyd-spf-python` daemon via stdin or a config file.
  It is structured as a JSON object.
#}
{
  # timestamp: Log timestamp pattern (kept as regex component, not parametrizable as scalar)
  "timestamp": "{{ timestamp | default('') }}",

  # pid: Process ID capture group (kept as regex component)
  "pid": "{{ pid | default('') }}",

  # result: SPF check result value
  # Enum: Pass, Neutral, None, Softfail, Fail, Temperror, Permerror
  "result": "{{ result | default('Pass') }}",

  # method: SPF check method (helo or mailfrom)
  # Enum: helo, mailfrom
  "method": "{{ method | default('helo') }}",

  # client_ip: Client IP address pattern
  "client_ip": "{{ client_ip | default('0.0.0.0') }}"
}
