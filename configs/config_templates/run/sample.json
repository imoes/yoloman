{
  "run_dir": "/run/dqcache",
  "bind": "0.0.0.0",
  "port": 8080,
  "user": "dqcache",
  "log_level": "warn",
  "cache_max_size": "512MiB",
  "worker_count": 2,
  "config_path": "/etc/dqcache/dqcache.yaml",
  "extra_flags": {
    "insecure": true,
    "tls-min-version": "TLS1.2",
    "metrics": "/metrics"
  }
}
