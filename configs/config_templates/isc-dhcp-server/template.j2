# ISC-DHCP-Server Configuration Template
#
# This template generates a valid dhcpd.conf for the ISC DHCP Server.
# It is self-documenting: every directive is commented with its schema description
# and uses variables with safe defaults to prevent rendering errors.

# Option: List of DNS servers to offer to DHCP clients.
# Schema Description: List of DNS servers to offer to DHCP clients.
# Default: ['8.8.8.8', '8.8.4.4']
option domain-name-servers {{ DOMAIN_NAME_SERVERS | default(['8.8.8.8', '8.8.4.4']) | join(', ') }};

# Option: Domain name to offer to DHCP clients.
# Schema Description: Domain name to offer to DHCP clients.
# Default: 'example.com'
option domain-name "{{ DOMAIN_NAME | default('example.com') }}";

# Option: Default router (gateway) to offer to DHCP clients.
# Schema Description: Default router (gateway) to offer to DHCP clients.
# Default: '192.168.1.1'
option routers {{ ROUTERS | default('192.168.1.1') }};

# Option: Subnet mask to offer to DHCP clients.
# Schema Description: Subnet mask to offer to DHCP clients.
# Default: '255.255.255.0'
option subnet-mask {{ SUBNET_MASK | default('255.255.255.0') }};

# Range of IP addresses for dynamic allocation to clients.
# Schema Description: Start of the IP address range for dynamic allocation.
# Schema Description: End of the IP address range for dynamic allocation.
# Defaults: '192.168.1.100', '192.168.1.200'
range {{ RANGE_START | default('192.168.1.100') }} {{ RANGE_END | default('192.168.1.200') }};

# Style of DNS update mechanism for DDNS.
# Schema Description: Style of DNS update (ad-hoc, interim, or none).
# Default: 'ad-hoc'
ddns-update-style {{ DDNS_UPDATE_STYLE | default('ad-hoc') }};

# Default lease time in seconds for IP addresses.
# Schema Description: Default lease time in seconds.
# Default: 600
default-lease-time {{ DEFAULT_LEASE_TIME | default(600) }};

# Maximum lease time in seconds for IP addresses.
# Schema Description: Maximum lease time in seconds.
# Default: 7200
max-lease-time {{ MAX_LEASE_TIME | default(7200) }};

# Authoritative mode: declare that the server is authoritative for the subnet.
# This prevents the server from complaining about unknown clients.
authoritative;