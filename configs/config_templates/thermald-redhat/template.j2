<?xml version="1.0" encoding="UTF-8"?>
<!--
  thermald CPU Cooling Device Order Configuration

  Specifies the order of compensation devices for cooling the CPU.
  thermald uses this list to determine which cooling device to query
  or control first, second, etc., when managing thermal throttling.

  The devices listed here must be valid cooling device names recognized
  by the Linux thermal subsystem (e.g., from sysfs or hwmon).
-->
<CoolingDeviceOrder>
  <!--
    The first cooling device in the compensation order.
    Default: rapl_controller
  -->
  <CoolingDevice>{{ cooling_device_1 | default('rapl_controller') }}</CoolingDevice>

  <!--
    The second cooling device in the compensation order.
    Default: intel_pstate
  -->
  <CoolingDevice>{{ cooling_device_2 | default('intel_pstate') }}</CoolingDevice>

  <!--
    The third cooling device in the compensation order.
    Default: intel_powerclamp
  -->
  <CoolingDevice>{{ cooling_device_3 | default('intel_powerclamp') }}</CoolingDevice>

  <!--
    The fourth cooling device in the compensation order.
    Default: cpufreq
  -->
  <CoolingDevice>{{ cooling_device_4 | default('cpufreq') }}</CoolingDevice>

  <!--
    The fifth cooling device in the compensation order.
    Default: Processor
  -->
  <CoolingDevice>{{ cooling_device_5 | default('Processor') }}</CoolingDevice>
</CoolingDeviceOrder>
