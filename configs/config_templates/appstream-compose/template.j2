[appstream-compose]
# prefix: Base installation prefix where appdata, metainfo, applications, and icons directories are located
prefix={{ prefix|default('/usr') }}

# output_dir: Output directory where generated AppStream XML files and icons will be placed
output_dir={{ output_dir|default('/usr/share/app-info') }}

# applications: List of application (desktop file) base names to process; if empty, all applications under prefix are included.
# This list is rendered as a space-separated string, which is the standard format for this configuration directive.
{% if applications is defined and applications|length > 0 %}
applications={{ applications|join(' ') }}
{% else %}
# applications not configured — will process all available apps in prefix
{% endif %}