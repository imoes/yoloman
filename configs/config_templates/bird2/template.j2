# BIRD (Berkeley Internet Name Daemon) configuration variables.
# This file is typically sourced by the systemd unit file or startup script
# to configure the BIRD daemon process.

# User under which BIRD daemon runs.
# Default: bird
BIRD_RUN_USER={{ run_user | default('bird') }}

# Group under which BIRD daemon runs.
# Default: bird
BIRD_RUN_GROUP={{ run_group | default('bird') }}

# Additional arguments passed to the BIRD daemon via BIRD_ARGS (uncommented).
# Default: ''
# These are injected directly into the command line arguments.
BIRD_EXTRA_ARGS={{ extra_args | default('') }}
