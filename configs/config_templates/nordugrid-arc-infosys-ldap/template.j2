# Log rotation configuration for NorduGrid ARC INFOSYS LDAP (BDII) update logs.
# This block controls how /var/log/arc/bdii/bdii-update.log is managed.

/var/log/arc/bdii/bdii-update.log
{
    # Keep the specified number of rotated log files.
    # Default: 14
    rotate {{ rotate_count | default('14') }}

    # Do not error if the log file is missing.
    missingok

    # Compress rotated log files to save disk space.
    compress

    # Rotate logs on a daily basis.
    daily

    # Create a new (empty) log file after rotating, copying the old one first.
    copytruncate
}
