# connman-gtk command-line options configuration
# This template generates command-line flags for the connman-gtk service.
# Each boolean option in `options` maps to a specific CLI flag.

{% if (options | default({})).tray | default(false) %}
# Launch connman-gtk minimized to the system tray.
# Corresponds to the --tray command-line option.
--tray
{% endif %}

{% if (options | default({})).no_icon | default(false) %}
# Disable the status icon entirely.
# Corresponds to the --no-icon command-line option.
--no-icon
{% endif %}

{% if (options | default({})).use_fsid | default(false) %}
# Use filesystem ID as passphrase for private keys when using openconnect.
# Corresponds to the --use-fsid command-line option.
--use-fsid
{% endif %}