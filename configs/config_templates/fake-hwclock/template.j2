# fake-hwclock configuration
# This file configures the fake-hwclock utility, which saves the system clock
# to a file (/var/lib/fake-hwclock/data) on shutdown and restores it on boot.
# This is useful for systems without a hardware clock (RTC) or persistent network time.

# Force setting the clock even if the saved value is in the past.
# Description: Set to 'true' to force setting the clock even if the saved value is in the past. Must be uncommented and set to a non-'false' value to take
# Effectively, if this is not 'false', the clock will be set regardless of time drift checks.
{% if (fake_hwc_force | default('') | lower) != 'false' %}FORCE={{ fake_hwc_force | default('') }}
{% else %}#FORCE=false
{% endif %}