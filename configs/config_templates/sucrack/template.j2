# sucrack configuration
# Path to the su executable.
SUCRACK_SU_PATH={{ sucrack_su_path | default('/bin/su') }}

# Message string indicating an authentication failure by the target 'su' process.
SUCRACK_AUTH_FAILURE="{{ sucrack_auth_failure | default('su: Authentication failure') }}"

# Message string indicating an authentication success (must not be in wordlist).
SUCRACK_AUTH_SUCCESS="{{ sucrack_auth_success | default('SUCRACK_SUCCESS') }}"

# User account to attempt to su to.
SUCRACK_USER="{{ sucrack_user | default('root') }}"

# Number of threads to run concurrently.
SUCRACK_THREADS={{ sucrack_threads | default(4) }}

# Statistics display interval in seconds.
SUCRACK_STATS_INTERVAL={{ sucrack_stats_interval | default(10) }}

# Rules for rewriting dictionary words (e.g., "ADF").
SUCRACK_RULES="{{ sucrack_rules | default('ADF') }}"