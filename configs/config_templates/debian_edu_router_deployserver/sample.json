{
  "tftp_bind_address": "0.0.0.0",
  "tftp_port": 69,
  "tftp_root": "/srv/tftp/debian-edu",
  "ipv6_enabled": false,
  "max_connections": 200,
  "secure_mode": true,
  "allowed_subnets": [
    "192.168.0.0/24",
    "10.10.10.0/24"
  ],
  "log_level": "info",
  "log_file": "/var/log/debian-edu-router/deployserver.log",
  "default_bootfile": "grubx64.efi",
  "bootfile_prefix": "/pxe/",
  "dhcp_assist_enabled": true,
  "dhcp_assist_server": "192.168.0.1",
  "https_enabled": true,
  "https_server": "https://mirror.debian-edu.org",
  "https_base_path": "/router/deploy/",
  "https_cert": "/etc/ssl/certs/debian-edu-router.crt",
  "pxe_proxy": false,
  "post_boot_script": "/usr/local/bin/notify-boot.sh",
  "transfer_timeout": 30,
  "tftp_blocksize": 1408
}
