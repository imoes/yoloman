# nicstat configuration template
# Nicstat does not use a persistent configuration file; it is a command-line utility.
# However, for automation or wrapper scripts, these parameters define the execution context.

# Interval in seconds between samples. If empty, defaults to boot-time average (1 sample).
interval = {{ nicstat.interval }}

# Number of times statistics are repeated. If 0 or empty, runs indefinitely.
count = {{ nicstat.count }}

# Comma-separated list of interfaces to monitor. Empty string monitors all.
interfaces = "{{ nicstat.interfaces | join(',') }}"

# Show statistics for non-local (non-loopback) interfaces only.
no_local = {{ nicstat.no_local }}

# Display extended output (rAvs, wAvs, Saturation, etc.).
extended = {{ nicstat.extended }}

# Show TCP statistics.
tcp_stats = {{ nicstat.tcp_stats }}

# Show UDP statistics.
udp_stats = {{ nicstat.udp_stats }}

# Display separate read and write utilization statistics.
separate_util = {{ nicstat.separate_util }}

# Display interface throughput statistics in Mbps instead of KB/s.
mbps = {{ nicstat.mbps }}

# Display output in parseable format (one line per interface, colon-separated).
parseable = {{ nicstat.parseable }}

# Skip interfaces for which there was zero traffic for the sample period.
skip_zero = {{ nicstat.skip_zero }}

# List interfaces only (no statistics). If true, interval and count are ignored.
list_only = {{ nicstat.list_only }}