<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lomiri Nextcloud CardDAV Plugin Configuration Profile
  
  This template generates an XML profile configuration for the Lomiri
  online accounts plugin to sync contacts with a Nextcloud CardDAV server.
  
  Variables expected in the Ansible inventory or vars:
  - enabled: Whether the profile is active.
  - hidden: Whether to hide this profile from the UI.
  - use_accounts: Whether to leverage system-level accounts for auth.
  - schedule_enabled: Whether background synchronization is active.
  - schedule_interval: Duration between syncs (e.g., '15m', '1h').
  - schedule_days: Days of the week for sync (1=Mon, 7=Sun).
  - schedule_time: Time of day to trigger the sync.
-->
<profile name="lomiri-nextcloud-carddav" type="sync">
    <!-- Category definition: identifies this as a contact sync service -->
    <key value="contacts" name="category"/>
    
    <!-- Unique identifier for this remote service profile -->
    <key value="lomiri-nextcloud-carddav" name="remote_service_name"/>
    
    <!-- Destination type: 'online' indicates network-synced data -->
    <key name="destinationtype" value="online"/>
    
    <!--
      Profile Activation Status
      desc: Whether the Lomiri nextcloud carddav plugin profile is enabled.
    -->
    <key name="enabled" value="{{ enabled | default('false') }}"/>
    
    <!--
      UI Visibility
      desc: Whether the profile is hidden from the user interface.
    -->
    <key name="hidden" value="{{ hidden | default('false') }}"/>
    
    <!--
      Account Strategy
      desc: Whether to use existing system accounts for authentication.
    -->
    <key name="use_accounts" value="{{ use_accounts | default('true') }}"/>

    <!-- CardDAV Client Configuration -->
    <profile type="client" name="carddav">
        <!-- Sync direction: bidirectional sync of contacts -->
        <key value="two-way" name="Sync Direction"/>
        
        <!-- Protocol standard: CardDAV -->
        <key value="carddav" name="Sync Protocol"/>
        
        <!-- Transport layer: HTTPS/HTTP -->
        <key value="HTTP" name="Sync Transport"/>
        
        <!-- Conflict resolution: prefer the remote version upon conflict -->
        <key value="prefer remote" name="conflictpolicy" />
    </profile>

    <!--
      Background Synchronization Schedule
      desc: Configuration for automatic background syncing of contacts.
    -->
    <schedule 
        enabled="{{ schedule_enabled | default('false') }}" 
        interval="{{ schedule_interval | default('') }}" 
        days="{{ schedule_days | default('1,2,3,4,5,6,7') }}" 
        syncconfiguredtime="" 
        time="{{ schedule_time | default('05:00:00') }}" 
    />
</profile>
