<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration for Globus GRAM SLURM Job Manager -->
<configuration xmlns="http://globus.org/2004/10/gram/config">
  <!-- SLURM-specific job manager backend -->
  <service name="gram" version="5.0">
    <jobmanager type="slurm">
      <!-- Absolute path to the SLURM `srun` executable used to launch jobs. -->
      <srun path="{{ srun_path | default('/usr/bin/srun') }}" />

      <!-- Absolute path to the SLURM `sbatch` executable used to submit batch jobs. -->
      <sbatch path="{{ sbatch_path | default('/usr/bin/sbatch') }}" />

      <!-- Absolute path to the SLURM `scancel` executable used to cancel jobs. -->
      <scancel path="{{ scancel_path | default('/usr/bin/scancel') }}" />

      <!-- Absolute path to the SLURM `squeue` executable used to query job status. -->
      <squeue path="{{ squeue_path | default('/usr/bin/squeue') }}" />

      <!-- Absolute path to the SLURM `sinfo` executable used to query cluster state. -->
      <sinfo path="{{ sinfo_path | default('/usr/bin/sinfo') }}" />

      <!-- Whether to enable submission of SLURM job arrays. Recommended for compatibility with HPC workflows. -->
      <enable-job-arrays>{{ enable_job_arrays | default(True) | lower }}</enable-job-arrays>

      <!-- Maximum number of concurrent jobs allowed per user. Set to 0 for no limit. -->
      <max-jobs-per-user>{{ max_jobs_per_user | default(500) }}</max-jobs-per-user>

      <!-- Default timeout (in seconds) for job operations (e.g., stage-in/out, startup). -->
      <default-timeout>{{ default_timeout | default(300) }}</default-timeout>

      <!-- Maximum allowed job runtime in seconds. Set to 0 for no enforced limit (SLURM partition limits still apply). -->
      <max-runtime>{{ max_runtime | default(0) }}</max-runtime>

      <!-- Optional path to a shell script that sets up environment variables (e.g., module loading) before job execution. -->
      <environment-setup-script path="{{ environment_setup_script | default('') }}" />

      <!-- Default SLURM request options applied to all jobs unless overridden.
           Supported keys: account, partition, qos, constraint, reservation.
           Iterate the mapping using dict2items to produce XML child elements. -->
      <defaults>
        {%- for entry in (slurm_defaults | default({})) | dict2items %}
        {%- if entry.value is defined and entry.value != '' %}
        <{{ entry.key }}>{{ entry.value }}</{{ entry.key }}>
        {%- endif %}
        {%- endfor %}
      </defaults>

      <!-- Additional command-line options to pass to `sbatch` (e.g., '--exclusive', '--mail-type=end'). -->
      <extra-sbatch-options>
        {%- for opt in extra_sbatch_options | default([]) %}
        <option>{{ opt }}</option>
        {%- endfor %}
      </extra-sbatch-options>

      <!-- List of SLURM partition names users are allowed to submit to. Empty list = all partitions allowed (unless denied). -->
      <allowed-partitions>
        {%- for part in allowed_partitions | default([]) %}
        <partition>{{ part }}</partition>
        {%- endfor %}
      </allowed-partitions>

      <!-- List of SLURM partition names explicitly denied to users. Takes precedence over allowed_partitions. -->
      <denied-partitions>
        {%- for part in denied_partitions | default([]) %}
        <partition>{{ part }}</partition>
        {%- endfor %}
      </denied-partitions>

      <!-- Whether to send job manager logs to the system syslog. -->
      <enable-syslog>{{ enable_syslog | default(False) | lower }}</enable-syslog>

      <!-- Verbosity level of job manager logging. -->
      <log-level>{{ log_level | default('info') }}</log-level>

      <!-- Path to the primary log file for the SLURM job manager. -->
      <log-file>{{ log_file | default('/var/log/globus/globus-gram-job-manager-slurm.log') }}</log-file>
    </jobmanager>
  </service>
</configuration>