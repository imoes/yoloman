{
 "allowed_partitions": [
  "standard",
  "highmem",
  "gpu"
 ],
 "default_timeout": 600,
 "denied_partitions": [],
 "enable_job_arrays": true,
 "enable_syslog": true,
 "environment_setup_script": "/etc/globus/slurm-env-setup.sh",
 "extra_sbatch_options": [
  "--ntasks-per-node=1",
  "--cpus-per-task=1",
  "--mem=0",
  "--export=NONE"
 ],
 "log_file": "/var/log/globus/globus-gram-job-manager-slurm.log",
 "log_level": "info",
 "max_jobs_per_user": 250,
 "max_runtime": 28800,
 "sbatch_path": "/usr/bin/sbatch",
 "scancel_path": "/usr/bin/scancel",
 "sinfo_path": "/usr/bin/sinfo",
 "slurm_defaults": {
  "account": "myproject",
  "partition": "standard",
  "qos": "normal"
 },
 "squeue_path": "/usr/bin/squeue",
 "srun_path": "/usr/bin/srun"
}
