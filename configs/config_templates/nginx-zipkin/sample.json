{
  "worker_processes": "auto",
  "error_log_path": "/var/log/nginx/error.log",
  "error_log_level": "warn",
  "pid_path": "/run/nginx.pid",
  "worker_connections": 1024,
  "nginx_conf_dir": "/etc/nginx",
  "access_log_path": "/var/log/nginx/access.log",
  "keepalive_timeout": 75,
  "keepalive_requests": 10000,
  "gzip_compression_level": 5,
  "gzip_types": [
    "text/plain",
    "text/css",
    "application/json",
    "application/javascript",
    "text/xml",
    "application/xml"
  ],
  "zipkin_service_name": "nginx-edge",
  "zipkin_collector_host": "zipkin-collector.monitoring.svc.cluster.local",
  "zipkin_collector_port": 9411,
  "zipkin_sampler_rate": 0.05,
  "zipkin_span_timeout": 5,
  "zipkin_local_address": "0.0.0.0",
  "server_listen_port": 80,
  "server_ssl_enabled": true,
  "server_name": "api.example.com",
  "ssl_certificate_path": "/etc/ssl/certs/api.example.com.crt",
  "ssl_certificate_key_path": "/etc/ssl/private/api.example.com.key",
  "ssl_ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384",
  "upstream_servers": [
    {
      "host": "backend-1.internal",
      "port": 8080,
      "weight": 2,
      "backup": false
    },
    {
      "host": "backend-2.internal",
      "port": 8080,
      "weight": 2,
      "backup": false
    },
    {
      "host": "backend-3.internal",
      "port": 8080,
      "weight": 1,
      "backup": true
    }
  ],
  "upstream_keepalive_connections": 64,
  "proxy_connect_timeout": 30,
  "proxy_send_timeout": 60,
  "proxy_read_timeout": 120
}
