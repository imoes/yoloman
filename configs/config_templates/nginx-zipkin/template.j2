# Global event handling configuration
worker_processes {{ worker_processes }};
error_log {{ error_log_path }} {{ error_log_level }};
pid {{ pid_path }};

# Event model — recommended for most production environments
events {
    worker_connections {{ worker_connections }};
    use epoll;
}

# HTTP block: core proxy and tracing configuration
http {
    # Include MIME types and default settings
    include {{ nginx_conf_dir }}/mime.types;
    default_type application/octet-stream;

    # Logging format for Zipkin compatibility (B3 headers + trace IDs)
    log_format zipkin '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" '
                      '"$http_x_b3_traceid" "$http_x_b3_spanid" "$http_x_b3_parentspanid" '
                      '$request_time $upstream_response_time';

    access_log {{ access_log_path }} zipkin;

    # Sendfile and TCP optimizations for high-throughput
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    # Connection keepalive tuning
    keepalive_timeout {{ keepalive_timeout }};
    keepalive_requests {{ keepalive_requests }};

    # Gzip compression for improved performance
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level {{ gzip_compression_level }};
    gzip_types {{ gzip_types | join(' ') }};

    # Zipkin tracing module initialization
    zipkin {
        # Service name as reported to Zipkin
        service_name {{ zipkin_service_name }};
        # Zipkin collector endpoint (e.g., http://zipkin-collector:9411/api/v2/spans)
        collector_host {{ zipkin_collector_host }};
        collector_port {{ zipkin_collector_port }};
        # Sampling rate (0.0–1.0); 1.0 = trace every request
        sampler_rate {{ zipkin_sampler_rate }};
        # Span timeout in seconds
        span_timeout {{ zipkin_span_timeout }}s;
        # Optional: enable binary annotation for local address
        local_address {{ zipkin_local_address }};
    }

    # Upstream definition for backend services
    upstream backend {
        # Dynamically configurable upstreams
        {% for upstream_server in upstream_servers %}
        server {{ upstream_server.host }}:{{ upstream_server.port }} weight={{ upstream_server.weight }}{% if upstream_server.backup %} backup{% endif %};
        {% endfor %}
        keepalive {{ upstream_keepalive_connections }};
    }

    # Server block: entrypoint for requests
    server {
        listen {{ server_listen_port }}{% if server_ssl_enabled %} ssl{% endif %};
        server_name {{ server_name }};

        # SSL configuration (only if enabled)
        {% if server_ssl_enabled %}
        ssl_certificate {{ ssl_certificate_path }};
        ssl_certificate_key {{ ssl_certificate_key_path }};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers {{ ssl_ciphers }};
        ssl_prefer_server_ciphers on;
        {% endif %}

        # Main location: proxy to backend with Zipkin header propagation
        location / {
            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Propagate Zipkin/B3 headers to backend
            proxy_set_header X-B3-TraceId $http_x_b3_traceid;
            proxy_set_header X-B3-SpanId $http_x_b3_spanid;
            proxy_set_header X-B3-ParentSpanId $http_x_b3_parentspanid;
            proxy_set_header X-B3-Sampled $http_x_b3_sampled;
            proxy_set_header X-B3-Flags $http_x_b3_flags;

            # Timeouts
            proxy_connect_timeout {{ proxy_connect_timeout }}s;
            proxy_send_timeout {{ proxy_send_timeout }}s;
            proxy_read_timeout {{ proxy_read_timeout }}s;
        }

        # Optional health check endpoint (e.g., for load balancers)
        location /health {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }
    }
}