{
  "general_threads": {
    "type": "number",
    "default": 25,
    "description": "Number of threads used for scanning"
  },
  "general_recursive": {
    "type": "bool",
    "default": false,
    "description": "Enable recursive scanning"
  },
  "general_deep_recursive": {
    "type": "bool",
    "default": false,
    "description": "Enable deep recursive scanning (scans all discovered directories recursively)"
  },
  "general_force_recursive": {
    "type": "bool",
    "default": false,
    "description": "Force recursive scanning regardless of robots.txt or config"
  },
  "general_recursion_status": {
    "type": "string",
    "default": "200-399,401,403",
    "description": "Status codes considered successful for recursion"
  },
  "general_max_recursion_depth": {
    "type": "number",
    "default": 0,
    "description": "Maximum recursion depth (0 = unlimited)"
  },
  "general_exclude_subdirs": {
    "type": "string",
    "default": "%%ff/,.;/,..;/,;/,./,../,%%2e/,%%2e%%2e/",
    "description": "Subdirectories to exclude from recursion"
  },
  "general_random_user_agents": {
    "type": "bool",
    "default": false,
    "description": "Use random user agents"
  },
  "general_max_time": {
    "type": "number",
    "default": 0,
    "description": "Maximum time in seconds for the scan (0 = unlimited)"
  },
  "general_exit_on_error": {
    "type": "bool",
    "default": false,
    "description": "Exit on connection errors"
  },
  "dictionary_default_extensions": {
    "type": "string",
    "default": "php,aspx,jsp,html,js",
    "description": "Default file extensions to append to wordlist entries"
  },
  "dictionary_force_extensions": {
    "type": "bool",
    "default": false,
    "description": "Force appending extensions even when directory"
  },
  "dictionary_overwrite_extensions": {
    "type": "bool",
    "default": false,
    "description": "Replace wordlist entries with extensions instead of appending"
  },
  "dictionary_lowercase": {
    "type": "bool",
    "default": false,
    "description": "Convert dictionary entries to lowercase"
  },
  "dictionary_uppercase": {
    "type": "bool",
    "default": false,
    "description": "Convert dictionary entries to uppercase"
  },
  "dictionary_capitalization": {
    "type": "bool",
    "default": false,
    "description": "Capitalize first letter of dictionary entries"
  },
  "request_http_method": {
    "type": "string",
    "default": "get",
    "description": "HTTP method to use for requests",
    "enum": [
      "get",
      "options"
    ]
  },
  "request_follow_redirects": {
    "type": "bool",
    "default": false,
    "description": "Follow HTTP redirects"
  },
  "connection_timeout": {
    "type": "number",
    "default": 7.5,
    "description": "Request timeout in seconds"
  },
  "connection_delay": {
    "type": "number",
    "default": 0,
    "description": "Delay between requests in seconds"
  },
  "connection_max_rate": {
    "type": "number",
    "default": 0,
    "description": "Maximum requests per second (0 = unlimited)"
  },
  "connection_max_retries": {
    "type": "number",
    "default": 1,
    "description": "Maximum number of request retries"
  },
  "advanced_crawl": {
    "type": "bool",
    "default": false,
    "description": "Crawl discovered URLs for more paths"
  },
  "view_full_url": {
    "type": "bool",
    "default": false,
    "description": "Show full URLs in output"
  },
  "view_quiet_mode": {
    "type": "bool",
    "default": false,
    "description": "Suppress banner and progress information"
  },
  "view_color": {
    "type": "bool",
    "default": true,
    "description": "Enable colored output"
  },
  "view_show_redirects_history": {
    "type": "bool",
    "default": false,
    "description": "Show redirect chain in output"
  },
  "output_report_format": {
    "type": "string",
    "default": "plain",
    "description": "Format for autosaved reports",
    "enum": [
      "plain",
      "simple",
      "json",
      "xml",
      "md",
      "csv",
      "html"
    ]
  },
  "output_autosave_report": {
    "type": "bool",
    "default": true,
    "description": "Automatically save reports"
  },
  "output_autosave_report_folder": {
    "type": "string",
    "default": "reports/",
    "description": "Folder where autosaved reports are stored"
  }
}
