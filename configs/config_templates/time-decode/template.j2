# ============================================================================
# time-decode configuration template
#
# This template generates command-line arguments for the `time-decode` utility.
# The utility converts timestamps between various formats and encodings.
# Each variable corresponds to a specific conversion mode.
# If a value is empty or false, the corresponding argument is omitted.
#
# All variables are expected to be passed as a mapping (e.g., via `values` dict).
# Every field uses a default value to ensure safe rendering even when undefined.
# ============================================================================

# --guess: Enable guessing the timestamp format.
# Requires the 'timestamp' value to be set for the guessing logic to apply.
{% if (values | default({})).guess | default(False) %}--guess {{ (values | default({})).timestamp | default('2023-01-01 12:00:00') }}
{% endif %}

# --convert-date: Convert a specific date/time string to all supported timestamp formats.
# Format expected: YYYY-MM-DD HH:MM:SS.f
# Empty string disables this option.
{% if (values | default({})).convert_date | default('') %}--convert-date {{ (values | default({})).convert_date | default('') }}
{% endif %}

