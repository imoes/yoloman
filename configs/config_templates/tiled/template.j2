# Tiled Configuration
# Generated by Ansible Jinja2 engine

[General]
# Whether to enable hardware-accelerated OpenGL rendering.
# If false, software rendering is used.
OpenGL={{ (values | default({})).opengl | default(true) | lower }}

[Editor]
# Whether Tiled should check for updates on startup.
CheckForUpdates={{ (values | default({})).check_for_updates | default(true) | lower }}

# The factor by which zoom changes with each mouse wheel notch.
# 1.25 represents a 25% increment per notch.
ZoomStep={{ (values | default({})).zoom_step | default('1.25') }}