# ==============================================================================
# LVM2 D-Bus Daemon Configuration Template
# ==============================================================================
# This file controls the behavior of the lvm2-dbusd service.
# It is generated by Ansible from the role's defaults or host/group variables.
# All directives use Jinja2 `default()` filters to ensure valid output even
# when a variable is undefined, preventing render failures and preserving
# the file's structure for downstream consumers or manual inspection.
# ==============================================================================

# ------------------------------------------------------------------------------
# Debug Mode
# ------------------------------------------------------------------------------
# Description: Enable verbose debug logging to stdout and/or log file.
# Type: boolean
# Default: false
Debug = {{ debug | default(false) | lower }}

# ------------------------------------------------------------------------------
# LVM Binary Search Path
# ------------------------------------------------------------------------------
# Description: Colon-separated PATH where LVM2 binaries (e.g., lvm, vgs, pvs)
#              are located. This overrides the system default path for the
#              daemon process.
# Type: string
# Default: /sbin:/usr/sbin
LvmPath = "{{ lvm_path | default('/sbin:/usr/sbin') }}"

# ------------------------------------------------------------------------------
# Maximum Concurrent D-Bus Clients
# ------------------------------------------------------------------------------
# Description: Maximum number of concurrent D-Bus client connections allowed.
#              Limits resource consumption by restricting parallel access.
# Type: integer
# Default: 10
MaxClients = {{ max_clients | default(10) }}

# ------------------------------------------------------------------------------
# LVM Command Execution Timeout
# ------------------------------------------------------------------------------
# Description: Maximum time (in seconds) to wait for LVM commands to complete
#              before timing out. Prevents the daemon from hanging indefinitely
#              on slow or dead storage devices.
# Type: integer
# Default: 60
CommandTimeout = {{ cmd_timeout | default(60) }}

# ------------------------------------------------------------------------------
# Auto-Activation Volume List
# ------------------------------------------------------------------------------
# Description: List of volume group names (or regex patterns) eligible for
#              automatic activation when the daemon starts or receives a
#              activation request. An empty list disables auto-activation.
# Type: list
# Default: []
AutoActivationVolumeList = [
{% for item in auto_activation_volume_list | default([]) %}
    "{{ item }}"{{ "," if not loop.last else "" }}
{% endfor %}
]

# ------------------------------------------------------------------------------
# D-Bus Service Name
# ------------------------------------------------------------------------------
# Description: D-Bus service name under which the daemon advertises its
#              interface. This is the well-known name clients connect to.
# Type: string
# Default: com.redhat.lvmdbus1
ServiceName = "{{ dbus_service_name | default('com.redhat.lvmdbus1') }}"

# ------------------------------------------------------------------------------
# PID File Path
# ------------------------------------------------------------------------------
# Description: Path to the PID file used to track the daemon's process ID.
#              Used by init systems or wrappers to manage the service lifecycle.
# Type: string
# Default: /run/lvm2-dbus.pid
PIDFile = "{{ pid_file | default('/run/lvm2-dbus.pid') }}"

# ------------------------------------------------------------------------------
# Excluded Volume Groups
# ------------------------------------------------------------------------------
# Description: List of volume groups to exclude from all D-Bus management
#              operations. These VGs are ignored by the daemon entirely.
# Type: list
# Default: []
ExcludedVG = [
{% for item in excluded_vg | default([]) %}
    "{{ item }}"{{ "," if not loop.last else "" }}
{% endfor %}
]

# ------------------------------------------------------------------------------
# Syslog Verbose Logging
# ------------------------------------------------------------------------------
# Description: Enable detailed logging to syslog in addition to standard
#              messages. When true, the daemon sends high-volume debug-like
#              entries to the system logger.
# Type: boolean
# Default: false
SyslogVerbose = {{ syslog_verbose | default(false) | lower }}

# ------------------------------------------------------------------------------
# Dedicated Log File
# ------------------------------------------------------------------------------
# Description: Optional absolute path to a dedicated log file. If empty or
#              unset, the daemon logs exclusively to syslog.
# Type: string
# Default: ""
LogFile = "{{ log_file | default('') }}"

# ------------------------------------------------------------------------------
# Log Level
# ------------------------------------------------------------------------------
# Description: Verbosity of logging.
#   0 = none
#   1 = error
#   2 = warning (default)
#   3 = info
#   4 = debug
# Type: integer
# Default: 2
LogLevel = {{ log_level | default(2) }}