{
  "debug": false,
  "lvm_path": "/sbin:/usr/sbin",
  "max_clients": 20,
  "cmd_timeout": 120,
  "auto_activation_volume_list": [
    "vg_data",
    "vg_archive"
  ],
  "dbus_service_name": "com.redhat.lvmdbus1",
  "pid_file": "/run/lvm2-dbus.pid",
  "dbus_conf_path": "",
  "monitor_vg_metadata": true,
  "excluded_vg": [
    "vg_system",
    "vg_backup"
  ],
  "syslog_verbose": false,
  "log_file": "/var/log/lvm2-dbus.log",
  "log_level": 3,
  "monitor_thin_pool_metadata": true
}
