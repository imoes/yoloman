{
  "sections": [
    {
      "image": "ubuntu:latest",
      "additional_packages": [
        "git",
        "vim",
        "tmux"
      ],
      "home": "/home/user/ubu-box",
      "init": false,
      "nvidia": false,
      "pull": true,
      "root": false,
      "replace": true,
      "start_now": false,
      "init_hooks": [
        "touch /init-normal"
      ],
      "volume": [
        "/tmp/test:/run/a",
        "/tmp/test:/run/b"
      ]
    },
    {
      "clone": "ubuntu",
      "pre_init_hooks": [
        "curl -fsSL https://deno.land/install.sh | sh"
      ],
      "init": false,
      "nvidia": false,
      "pull": true,
      "root": false,
      "replace": true,
      "start_now": true
    }
  ]
}
