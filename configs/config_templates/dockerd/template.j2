{
  # Filesystem path where Docker stores all persistent state: images, containers, volumes, and networks.
  # Ensure the partition has sufficient space.
  "data-root": "{{ data_root | default('/var/lib/docker') }}",
  # Union filesystem driver for image layer storage. overlay2 is the recommended driver on Linux kernels 4.0+
  # with ext4 or xfs.
  "storage-driver": "{{ storage_driver | default('overlay2') }}",
  # Additional options passed directly to the storage driver (e.g. overlay2.size=20G to cap container rootfs size).
  # Leave empty to use driver defaults.
{% if storage_opts | default([]) | length > 0 %}
  "storage-opts": [{% for opt in storage_opts | default([]) %}"{{ opt }}"{% if not loop.last %}, {% endif %}{% endfor %}],
{% endif %}
  # Minimum severity level written to the daemon log. Accepted values: debug, info, warn, error, fatal.
  # Use info in production; debug is very verbose.
  "log-level": "{{ log_level | default('info') }}",
  # Default logging driver for all containers. json-file and local support automatic rotation via log-opts.
  # Other options: journald, syslog, fluentd, etc.
  "log-driver": "{{ log_driver | default('json-file') }}",
  # Options for the active log driver (max-size and max-file apply to json-file and local)
  "log-opts": {
    # Maximum size of a single container log file before it is rotated. Suffix: k (kilobytes), m (megabytes), g (gigabytes).
    "max-size": "{{ log_max_size | default('10m') }}",
    # Number of rotated log files to retain per container. Total on-disk log space per container is roughly
    # max-size * max-file.
    "max-file": "{{ log_max_file | default('3') }}"
  },
  # Keep containers running when dockerd is stopped or upgraded. Enables zero-downtime daemon upgrades.
  # Disable only if your orchestrator handles container lifecycle strictly.
  "live-restore": {{ live_restore | default(true) | lower }},
  # Enable verbose debug-level output in the daemon log. Produces high log volume; use only when diagnosing
  # daemon issues, never in steady-state production.
  "debug": {{ debug | default(false) | lower }},
  # cgroup management driver passed to the OCI runtime. Use systemd on all systemd-based Linux hosts
  # (required for Kubernetes). Use cgroupfs only on non-systemd systems.
  "exec-opts": ["native.cgroupdriver={{ cgroup_driver | default('systemd') }}"],
  # Maximum number of image layers pulled from a registry in parallel during a single docker pull.
  # Increase on high-bandwidth networks; decrease to reduce CPU/IO pressure.
  "max-concurrent-downloads": {{ max_concurrent_downloads | default(3) }},
  # Maximum number of image layers pushed to a registry in parallel during a single docker push.
  # Increase on high-bandwidth networks.
  "max-concurrent-uploads": {{ max_concurrent_uploads | default(5) }},
  # DNS resolver addresses injected into /etc/resolv.conf of every container. Override with your internal
  # resolvers when containers need to resolve internal hostnames.
  "dns": [{% for s in dns_servers | default(['8.8.8.8', '8.8.4.4']) %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}],
  # DNS search domains appended in every container's resolv.conf. Useful for resolving short hostnames
  # within your internal domain without a FQDN.
  "dns-search": [{% for s in dns_search | default([]) %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}],
  # CIDR block assigned to the docker0 bridge interface. Change this when 172.17.0.0/16 conflicts with
  # existing host routes or VPN subnets.
  "bip": "{{ bridge_ip | default('172.17.0.1/16') }}",
  # Parent CIDR pools from which Docker allocates subnets for user-defined bridge networks. Each docker
  # network creation carves a /size subnet from the base.
  "default-address-pools": [
{% for pool in default_address_pools | default([{'base': '172.18.0.0/16', 'size': 24}]) %}    {"base": "{{ pool.base }}", "size": {{ pool.size }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  # Use a userland proxy process for loopback-bound container port mappings. Disable (false) to rely on
  # iptables DNAT, which has lower latency and CPU usage.
  "userland-proxy": {{ userland_proxy | default(false) | lower }},
  # Allow dockerd to manage iptables rules for container port publishing and network isolation.
  # Set to false only if you manage firewall rules externally.
  "iptables": {{ iptables | default(true) | lower }}{% if registry_mirrors | default([]) | length > 0 or insecure_registries | default([]) | length > 0 or metrics_enabled | default(false) %},{% endif %}
{% if registry_mirrors | default([]) | length > 0 %}
  # Pull-through cache registries consulted before the upstream registry (e.g. Docker Hub). Use an internal
  # mirror to reduce egress bandwidth and improve pull speeds.
  "registry-mirrors": [{% for m in registry_mirrors | default([]) %}"{{ m }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% if insecure_registries | default([]) | length > 0 or metrics_enabled | default(false) %},{% endif %}
{% endif %}{% if insecure_registries | default([]) | length > 0 %}
  # Registries that dockerd may contact over plain HTTP or with untrusted TLS certificates. Restrict to
  # internal private registries only; never expose to public internet.
  "insecure-registries": [{% for r in insecure_registries | default([]) %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% if metrics_enabled | default(false) %},{% endif %}
{% endif %}{% if metrics_enabled | default(false) %}
  # Address and port on which the daemon serves Prometheus-format engine metrics. Only used when metrics_enabled
  # is true. Bind to 127.0.0.1 and scrape locally for security.
  "metrics-addr": "{{ metrics_addr | default('127.0.0.1:9323') }}"
{% endif %}}