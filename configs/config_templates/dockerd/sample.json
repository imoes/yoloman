{
  "data_root": "/var/lib/docker",
  "storage_driver": "overlay2",
  "storage_opts": [
    "overlay2.size=20G"
  ],
  "log_level": "info",
  "log_driver": "json-file",
  "log_max_size": "10m",
  "log_max_file": "3",
  "live_restore": true,
  "debug": false,
  "cgroup_driver": "systemd",
  "max_concurrent_downloads": 5,
  "max_concurrent_uploads": 5,
  "dns_servers": [
    "192.0.2.1",
    "192.0.2.2"
  ],
  "dns_search": [
    "corp.example.com"
  ],
  "bridge_ip": "172.17.0.1/16",
  "default_address_pools": [
    {
      "base": "172.18.0.0/16",
      "size": 24
    },
    {
      "base": "172.19.0.0/16",
      "size": 24
    }
  ],
  "userland_proxy": false,
  "iptables": true,
  "ip_forward": true,
  "registry_mirrors": [
    "https://registry-mirror.corp.example.com"
  ],
  "insecure_registries": [
    "registry.corp.example.com:5000"
  ],
  "metrics_enabled": true,
  "metrics_addr": "127.0.0.1:9323"
}
