{
  "upload_dir": "/var/lib/lomiri/upload-manager/uploads",
  "completed_dir": "/var/lib/lomiri/upload-manager/completed",
  "max_upload_size": 1073741824,
  "max_concurrent_uploads": 3,
  "retry_delay": 60,
  "max_retries": 5,
  "background_upload": true,
  "allow_metered": false,
  "providers": [
    {
      "name": "owncloud",
      "enabled": true,
      "account_path": "/var/lib/lomiri/owncloud/accounts.json",
      "server_url": "https://cloud.example.com/remote.php/webdav/",
      "display_name": "OwnCloud"
    },
    {
      "name": "nextcloud",
      "enabled": true,
      "account_path": "/var/lib/lomiri/nextcloud/accounts.json",
      "server_url": "https://nextcloud.example.com/remote.php/webdav/",
      "display_name": "Nextcloud"
    }
  ],
  "log_level": "WARNING",
  "log_file": "/var/log/lomiri/upload-manager.log"
}
