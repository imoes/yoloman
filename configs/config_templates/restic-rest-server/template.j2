# ============================================================================
# restic-rest-server Configuration
# ============================================================================
# This template generates the configuration for the restic REST server.
# It controls the network binding, backup storage location, and authentication
# credentials file path.
#
# See also: /etc/default/restic-rest-server for CLI flags (e.g., --no-auth).
# ============================================================================

# --------------------------------------------------------------------------
# listen_address
# --------------------------------------------------------------------------
# TCP or UNIX listen address for the restic-rest-server.
# Examples:
#   ':8000'       - Listen on all interfaces on port 8000.
#   'unix:/run/restic-rest-server' - Listen on a Unix domain socket.
#
listen_address: {{ (listen_address | default(':8000')) | string }}

# --------------------------------------------------------------------------
# backup_dir
# --------------------------------------------------------------------------
# Directory to store backups. The server will not start unless this is defined.
# Ensure this directory exists and has appropriate permissions for the service user.
#
backup_dir: {{ (backup_dir | default('/srv/backups/')) | string }}

# --------------------------------------------------------------------------
# htpasswd_file
# --------------------------------------------------------------------------
# Path to the htpasswd file for basic authentication.
# This file must be created using the `htpasswd` utility (e.g., from apache2-utils).
# Only bcrypt (-B) and SHA (-s) encryption methods are supported by the server.
#
htpasswd_file: {{ (htpasswd_file | default('/etc/restic-rest-server/users.htpasswd')) | string }}
