# ==============================================================================
# restic-rest-server Configuration Template
# ==============================================================================
# This template configures the restic-rest-server instance.
# It generates a configuration file compatible with restic-rest-server >= 0.11.0.
#
# Self-documenting: every variable reference includes its default value from the
# schema to ensure the config renders correctly even if the variable is undefined
# in the Ansible play/role invocation.
# ==============================================================================

# --------------------------------------------------------------------------
# Listen Address
# --------------------------------------------------------------------------
# TCP or UNIX listen address for the restic-rest-server. Example: ':8000' for TCP or 'unix:/run/restic-rest-server' for Unix socket.
LISTEN = {{ listen_address | default(':8000') }}

# --------------------------------------------------------------------------
# Backup Directory
# --------------------------------------------------------------------------
# Directory to store backups. The server will not start unless this is defined.
BACKUP_DIR = {{ backup_dir | default('/srv/backups/') }}

# --------------------------------------------------------------------------
# Authentication
# --------------------------------------------------------------------------
# Path to the htpasswd file for basic authentication.
ARGS = "--htpasswd-file {{ htpasswd_file | default('/etc/restic-rest-server/users.htpasswd') }}"