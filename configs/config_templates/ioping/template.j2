#!/bin/sh
# ============================================================================
# ioping configuration wrapper script
# ============================================================================
# Generated by Ansible Jinja2 template.
# Self-documenting: every variable maps to a schema field.
# See ioping(1) man page for full details on ioping options.
# ============================================================================

# Path to the ioping binary.
# Schema: ioping_bin | default='/usr/bin/ioping'
IOPING_BIN="{{ ioping_bin | default('/usr/bin/ioping') }}"

# Target directory, file, or device to monitor.
# Schema: ioping_target | default='.'
IOPING_TARGET="{{ ioping_target | default('.') }}"

# Number of requests to send before stopping.
# 0 means infinite loop.
# Schema: ioping_count | default=0
IOPING_COUNT="{{ ioping_count | default(0) }}"

# Request size. Supports suffixes like k, m, g, sector, page.
# Default is 4k.
# Schema: ioping_size | default='4k'
IOPING_SIZE="{{ ioping_size | default('4k') }}"

# Working set size. Supports suffixes like k, m, g, sector, page.
# Empty string means default behavior (entire file/disk).
# Schema: ioping_work_size | default=''
IOPING_WORK_SIZE="{{ ioping_work_size | default('') }}"

# Time interval between requests. Supports suffixes s, ms, us, ns.
# Default is 1s.
# Schema: ioping_interval | default='1s'
IOPING_INTERVAL="{{ ioping_interval | default('1s') }}"

# Number of initial requests to ignore in statistics (warmup).
# Default is 1.
# Schema: ioping_warmup | default=1
IOPING_WARMUP="{{ ioping_warmup | default(1) }}"

# Use asynchronous I/O (flag: -A).
# Schema: ioping_async | default=False
{% if ioping_async | default(False) %}
IOPING_ASYNC="-A"
{% else %}
IOPING_ASYNC=""
{% endif %}

# Use direct I/O, bypassing page cache (flag: -D).
# Schema: ioping_direct | default=False
{% if ioping_direct | default(False) %}
IOPING_DIRECT="-D"
{% else %}
IOPING_DIRECT=""
{% endif %}

# Use cached I/O, relying on page cache (flag: -C).
# Schema: ioping_cached | default=False
{% if ioping_cached | default(False) %}
IOPING_CACHED="-C"
{% else %}
IOPING_CACHED=""
{% endif %}

# Use writes rather than reads (flag: -W).
# Schema: ioping_write | default=False
{% if ioping_write | default(False) %}
IOPING_WRITE="-W"
{% else %}
IOPING_WRITE=""
{% endif %}

# Print output in JSON format (flag: -J).
# Schema: ioping_json | default=False
{% if ioping_json | default(False) %}
IOPING_JSON="-J"
{% else %}
IOPING_JSON=""
{% endif %}

# Batch mode: be quiet and print final statistics only (flag: -B).
# Schema: ioping_batch | default=False
{% if ioping_batch | default(False) %}
IOPING_BATCH="-B"
{% else %}
IOPING_BATCH=""
{% endif %}

# Rate limit in count per second. Supports suffixes k, m, g, t.
# Empty string means no limit.
# Schema: ioping_rate_limit | default=''
IOPING_RATE_LIMIT="{{ ioping_rate_limit | default('') }}"

# Speed limit in size per second. Supports suffixes k, m, g.
# Empty string means no limit.
# Schema: ioping_speed_limit | default=''
IOPING_SPEED_LIMIT="{{ ioping_speed_limit | default('') }}"

# Minimal valid request time. Supports suffixes s, ms, us, ns.
# Default is 0us.
# Schema: ioping_min_time | default='0us'
IOPING_MIN_TIME="{{ ioping_min_time | default('0us') }}"

# Maximum valid request time. Supports suffixes s, ms, us, ns.
# Empty string means no upper limit.
# Schema: ioping_max_time | default=''
IOPING_MAX_TIME="{{ ioping_max_time | default('') }}"

# Print current time format string (strftime).
# Empty string uses default format.
# Schema: ioping_time_fmt | default=''
IOPING_TIME_FMT="{{ ioping_time_fmt | default('') }}"

# Print raw statistics for every N requests.
# Supports suffixes k, m, g, t. Empty means disabled.
# Schema: ioping_print_count | default=''
IOPING_PRINT_COUNT="{{ ioping_print_count | default('') }}"

# Print raw statistics for every T time interval.
# Supports suffixes s, ms, us, ns. Empty means disabled.
# Schema: ioping_print_interval | default=''
IOPING_PRINT_INTERVAL="{{ ioping_print_interval | default('') }}"

# Use sequential operations rather than random (flag: -L).
# Schema: ioping_linear | default=False
{% if ioping_linear | default(False) %}
IOPING_LINEAR="-L"
{% else %}
IOPING_LINEAR=""
{% endif %}

# Disk seek rate test (flag: -R).
# Schema: ioping_rapid | default=False
{% if ioping_rapid | default(False) %}
IOPING_RAPID="-R"
{% else %}
IOPING_RAPID=""
{% endif %}

# Keep and reuse temporary working file (flag: -k).
# Schema: ioping_keep | default=False
{% if ioping_keep | default(False) %}
IOPING_KEEP="-k"
{% else %}
IOPING_KEEP=""
{% endif %}

# Suppress periodical human-readable output (flag: -q).
# Schema: ioping_quiet | default=False
{% if ioping_quiet | default(False) %}
IOPING_QUIET="-q"
{% else %}
IOPING_QUIET=""
{% endif %}

# ============================================================================
# Construct the command line from the configured flags and values
# ============================================================================
CMD="${IOPING_BIN}"

# Append boolean flags only if they are non-empty
if [ -n "${IOPING_ASYNC}" ]; then CMD="${CMD} ${IOPING_ASYNC}"; fi
if [ -n "${IOPING_DIRECT}" ]; then CMD="${CMD} ${IOPING_DIRECT}"; fi
if [ -n "${IOPING_CACHED}" ]; then CMD="${CMD} ${IOPING_CACHED}"; fi
if [ -n "${IOPING_WRITE}" ]; then CMD="${CMD} ${IOPING_WRITE}"; fi
if [ -n "${IOPING_JSON}" ]; then CMD="${CMD} ${IOPING_JSON}"; fi
if [ -n "${IOPING_BATCH}" ]; then CMD="${CMD} ${IOPING_BATCH}"; fi
if [ -n "${IOPING_LINEAR}" ]; then CMD="${CMD} ${IOPING_LINEAR}"; fi
if [ -n "${IOPING_RAPID}" ]; then CMD="${CMD} ${IOPING_RAPID}"; fi
if [ -n "${IOPING_KEEP}" ]; then CMD="${CMD} ${IOPING_KEEP}"; fi
if [ -n "${IOPING_QUIET}" ]; then CMD="${CMD} ${IOPING_QUIET}"; fi

# Append time format flag if configured
if [ -n "${IOPING_TIME_FMT}" ]; then CMD="${CMD} -I ${IOPING_TIME_FMT}"; fi

# Append count flag if non-zero (0 means infinite/loop)
if [ -n "${IOPING_COUNT}" ] && [ "${IOPING_COUNT}" != "0" ]; then CMD="${CMD} -c ${IOPING_COUNT}"; fi

# Append size flag if configured (default 4k usually handled by ioping, but explicit is safer)
if [ -n "${IOPING_SIZE}" ]; then CMD="${CMD} -s ${IOPING_SIZE}"; fi

# Append working set size flag if configured
if [ -n "${IOPING_WORK_SIZE}" ]; then CMD="${CMD} -S ${IOPING_WORK_SIZE}"; fi

# Append interval flag if configured
if [ -n "${IOPING_INTERVAL}" ]; then CMD="${CMD} -i ${IOPING_INTERVAL}"; fi

# Append warmup flag if configured
if [ -n "${IOPING_WARMUP}" ]; then CMD="${CMD} -a ${IOPING_WARMUP}"; fi

# Append rate limit flag if configured
if [ -n "${IOPING_RATE_LIMIT}" ]; then CMD="${CMD} -r ${IOPING_RATE_LIMIT}"; fi

# Append speed limit flag if configured
if [ -n "${IOPING_SPEED_LIMIT}" ]; then CMD="${CMD} -l ${IOPING_SPEED_LIMIT}"; fi

# Append min time flag if configured
if [ -n "${IOPING_MIN_TIME}" ]; then CMD="${CMD} -t ${IOPING_MIN_TIME}"; fi

# Append max time flag if configured
if [ -n "${IOPING_MAX_TIME}" ]; then CMD="${CMD} -T ${IOPING_MAX_TIME}"; fi

# Append print count flag if configured
if [ -n "${IOPING_PRINT_COUNT}" ]; then CMD="${CMD} -p ${IOPING_PRINT_COUNT}"; fi

# Append print interval flag if configured
if [ -n "${IOPING_PRINT_INTERVAL}" ]; then CMD="${CMD} -P ${IOPING_PRINT_INTERVAL}"; fi

# Append the target as the final argument
CMD="${CMD} ${IOPING_TARGET}"

# Execute the constructed command
exec ${CMD}