# swayidle configuration file
#
# This template configures swayidle, a tool for running commands when the
# Wayland compositor (sway) detects idle states (screen lock, DPMS off, etc.).
#
# Global Options
# These settings apply to the entire swayidle process.

# debug: Enable debug output.
# Default: false
# If true, swayidle will print detailed logs to stderr, useful for troubleshooting event triggers.
set debug {{ debug | default(false) }}

# wait: Wait for command to finish executing before continuing (before-sleep, etc.).
# Default: false
# If true, swayidle will wait for the configured command to exit before processing further events.
# This prevents overlapping command executions.
set wait {{ wait | default(false) }}

# seat: Specify which seat to use. Empty string to pick arbitrarily.
# Default: ''
# Use this to target a specific Wayland seat (e.g., 'seat0').
# Leave empty for swayidle to automatically select the available seat.
set seat "{{ seat | default('') }}"

# Events
# List of idle events to monitor and execute commands on.
# See the EVENTS section of swayidle(1) for available event types
# such as 'before-sleep', 'lock', 'unlock', 'dpms-off', 'dpms-on', etc.
{% for event in events | default([]) %}
# ---------------------------------------------------------
# Event Type: {{ event.type | default('unknown') }}
# Timeout: {{ event.timeout | default(0) }} seconds
# Command: {{ event.command | default('') }}
# Resume Command: {{ event.resume_command | default('') }}
# Description: {{ event.description | default('No description provided') }}
# ---------------------------------------------------------
{{ event.type }} {{ event.timeout | default(0) }} "{{ event.command }}"
{% if event.resume_command is defined and event.resume_command %}
resume "{{ event.resume_command }}"
{% endif %}
{% endfor %}