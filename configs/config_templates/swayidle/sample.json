{
  "debug": false,
  "wait": true,
  "seat": "",
  "events": [
    {
      "type": "timeout",
      "timeout": 300,
      "command": "swaylock -f -c 000000",
      "description": "Lock screen after 5 minutes of inactivity"
    },
    {
      "type": "timeout",
      "timeout": 600,
      "command": "swaymsg 'output * dpms off'",
      "resume_command": "swaymsg 'output * dpms on'",
      "description": "Turn off displays after 10 minutes, turn on when resumed"
    },
    {
      "type": "before-sleep",
      "timeout": 0,
      "command": "swaylock -f -c 000000",
      "description": "Lock screen before system sleep"
    }
  ]
}
