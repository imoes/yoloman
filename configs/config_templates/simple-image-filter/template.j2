# /etc/simple-image-filter.conf
# Generated configuration for simple-image-filter
#
# This configuration file controls the behavior of the simple-image-filter service.
# It defines input/output paths, image processing quality, and logging verbosity.
# All settings have safe defaults provided via Jinja2 defaults to ensure
# the service starts even if the Ansible role does not explicitly set every value.

# The directory where input images are placed for processing.
# The service will scan this directory for new images to process.
# Default: /var/lib/simple-image-filter/in
input_dir = {{ input_dir | default('/var/lib/simple-image-filter/in') }}

# The directory where processed output images are saved.
# Ensure this directory exists and is writable by the service user.
# Default: /var/lib/simple-image-filter/out
output_dir = {{ output_dir | default('/var/lib/simple-image-filter/out') }}

# The compression quality level for output images, typically between 0 and 100.
# Higher values mean better quality but larger file sizes.
# Default: 85
quality = {{ quality | default(85) }}

# Whether to enable verbose logging mode.
# When true, the service will output detailed processing logs to standard error.
# Default: False
verbose = {{ verbose | default(False) | lower }}