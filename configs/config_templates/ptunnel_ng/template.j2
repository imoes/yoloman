# ptunnel-ng configuration file (next-gen)
# This config defines tunnel endpoints, ICMP behavior, and security.

# Daemon mode: run as background process (true/false)
{% if daemon %}
daemon = true
{% else %}
daemon = false
{% endif %}

# Log level: 0=error, 1=warn, 2=info, 3=debug
log_level = {{ log_level }}

# Log file path (leave empty to log to stderr)
{% if log_file %}
log_file = {{ log_file }}
{% endif %}

# ICMP ping timeout in milliseconds
ping_timeout = {{ ping_timeout }}

# ICMP echo reply timeout in milliseconds (max wait for reply)
reply_timeout = {{ reply_timeout }}

# Maximum number of concurrent ICMP echo requests
max_echo_requests = {{ max_echo_requests }}

# Maximum ICMP payload size (bytes)
max_icmp_payload = {{ max_icmp_payload }}

# Source interface for sending packets (e.g., 'eth0'); empty = auto-detect
{% if src_interface %}
src_interface = {{ src_interface }}
{% endif %}

# Local proxy address (bind address for listening TCP connections)
{% if listen_addr %}
listen_addr = {{ listen_addr }}
{% else %}
listen_addr = 127.0.0.1
{% endif %}

# Local proxy port (TCP port to listen on for inbound connections)
listen_port = {{ listen_port }}

# Destination host (remote server IP or hostname)
dst_host = {{ dst_host }}

# Destination ICMP echo handler (remote ptunnel-ng daemon IP)
dst_icmp = {{ dst_icmp }}

# Optional: Use authenticated ICMP (requires matching pre-shared key)
{% if auth_key %}
auth_key = {{ auth_key }}
{% endif %}

# Optional: Tunnel multiple TCP ports via a single ICMP stream (list of port mappings)
{% for mapping in port_mappings %}
# Map local port {{ mapping.local_port }} to remote host {{ mapping.remote_host }}:{{ mapping.remote_port }}
port_map = {{ mapping.local_port }} {{ mapping.remote_host }} {{ mapping.remote_port }}
{% endfor %}

# Optional: Restrict access to specific source IP(s) (CIDR or IP)
{% for allowed_source in allowed_sources %}
# Allow ICMP echo requests only from {{ allowed_source }}
allow_from = {{ allowed_source }}
{% endfor %}

# Optional: Disable strict ICMP ID checking (for broken NATs or firewalls)
{% if relax_icmp_id %}
relax_icmp_id = true
{% endif %}
