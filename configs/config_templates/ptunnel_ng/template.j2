# ptunnel-ng configuration file
# Self-documenting template: every directive includes its default value inline
# to prevent render failures if the variable is undefined.

# Run ptunnel-ng as a background daemon process.
# Default: False (run in foreground)
daemon = {{ daemon | default(False) | ternary('true', 'false') }}

# Logging verbosity: 0=errors only, 1=warnings, 2=info (default), 3=debug.
# Default: 2
log_level = {{ log_level | default(2) }}

# Path to log file. Leave blank to log to stderr.
# If the variable is undefined or empty, the directive is omitted.
{% if log_file | default('', true) %}
log_file = {{ log_file | default('', true) }}
{% endif %}

# Remote server IP or hostname to connect to.
# Default: localhost
dst_host = {{ dst_host | default('localhost') }}

# Remote server port to connect to.
# Default: 22
dst_port = {{ dst_port | default(22) }}

# Network interface to bind to (e.g., 'eth0'). Auto-detected if blank.
# If the variable is undefined or empty, the directive is omitted.
{% if src_interface | default('', true) %}
src_interface = {{ src_interface | default('', true) }}
{% endif %}

# Local address to bind the TCP proxy to.
# Default: 127.0.0.1
listen_addr = {{ listen_addr | default('127.0.0.1') }}

# Local TCP port where applications connect to use the tunnel.
# Default: 8080
listen_port = {{ listen_port | default(8080) }}

# IP address of the remote ptunnel-ng daemon (ICMP target).
# Default: 192.168.1.100
remote_ip = {{ remote_ip | default('192.168.1.100') }}

# Shared secret for authentication. Must match on client and server.
# If the variable is undefined or empty, the directive is omitted.
{% if shared_key | default('', true) %}
shared_key = {{ shared_key | default('', true) }}
{% endif %}

# Local port for the client side of the tunnel. If 0, auto-assigned.
# If the variable is 0 or undefined, the directive is omitted.
{% if local_port | default(0) != 0 %}
local_port = {{ local_port | default(0) }}
{% endif %}