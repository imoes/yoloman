{
  "daemon": true,
  "log_level": 2,
  "log_file": "/var/log/ptunnel-ng.log",
  "ping_timeout": 1500,
  "reply_timeout": 4000,
  "max_echo_requests": 8,
  "max_icmp_payload": 500,
  "src_interface": "eth0",
  "listen_addr": "127.0.0.1",
  "listen_port": 8080,
  "dst_host": "web.internal.example.com",
  "dst_icmp": "198.51.100.23",
  "auth_key": "mysecretkey123",
  "port_mappings": [
    {
      "local_port": 2222,
      "remote_host": "ssh.internal.example.com",
      "remote_port": 22
    },
    {
      "local_port": 8080,
      "remote_host": "web.internal.example.com",
      "remote_port": 80
    }
  ],
  "allowed_sources": [
    "10.0.0.0/24",
    "192.168.1.50"
  ],
  "relax_icmp_id": false
}
