# Groonga Munin Plugins Configuration
# This file configures the environment variables for Groonga monitoring plugins.
# It defines paths, hosts, and ports for various Groonga sub-services (HTTP, HTTPD, GQTP).

[groonga_*]
  # OS user under which the monitoring plugins run.
  user _groonga
  # OS group under which the monitoring plugins run.
  group _groonga
  # PATH environment variable for the plugins.
  env.PATH /usr/bin:/bin:/usr/local/bin

  # Path to the main Groonga database file.
  # Default: /var/lib/groonga/db/db
  env.database_path {{ env_database_path | default('/var/lib/groonga/db/db') }}

  # Host to bind Groonga services for monitoring.
  # Default: 127.0.0.1
  env.host {{ env_host | default('127.0.0.1') }}

  # --- HTTP Plugin Configuration ---

  # HTTP server host for Groonga HTTP plugin.
  # Default: 127.0.0.1
  env.http_host {{ env_http_host | default('127.0.0.1') }}

  # HTTP server port for Groonga HTTP plugin.
  # Default: 10041
  env.http_port {{ env_http_port | default(10041) }}

  # Path to the database used by Groonga HTTP server.
  # Default: /var/lib/groonga/db/db
  env.http_database_path {{ env_http_database_path | default('/var/lib/groonga/db/db') }}

  # Path to the PID file for Groonga HTTP server.
  # Default: /var/run/groonga/groonga-http.pid
  env.http_pid_path {{ env_http_pid_path | default('/var/run/groonga/groonga-http.pid') }}

  # Path to the query log file for Groonga HTTP server.
  # Default: /var/log/groonga/query-http.log
  env.http_query_log_path {{ env_http_query_log_path | default('/var/log/groonga/query-http.log') }}

  # --- HTTPD Plugin Configuration ---

  # HTTPD (Groonga HTTP Daemon) server host.
  # Default: 127.0.0.1
  env.httpd_host {{ env_httpd_host | default('127.0.0.1') }}

  # HTTPD (Groonga HTTP Daemon) server port.
  # Default: 10041
  env.httpd_port {{ env_httpd_port | default(10041) }}

  # Path to the database used by Groonga HTTPD server.
  # Default: /var/lib/groonga/db/db
  env.httpd_database_path {{ env_httpd_database_path | default('/var/lib/groonga/db/db') }}

  # Path to the PID file for Groonga HTTPD server.
  # Default: /var/run/groonga/groonga-httpd.pid
  env.httpd_pid_path {{ env_httpd_pid_path | default('/var/run/groonga/groonga-httpd.pid') }}

  # Path to the query log file for Groonga HTTPD server.
  # Default: /var/log/groonga/httpd/groonga-query.log
  env.httpd_query_log_path {{ env_httpd_query_log_path | default('/var/log/groonga/httpd/groonga-query.log') }}

  # --- GQTP Plugin Configuration ---

  # GQTP server host.
  # Default: 127.0.0.1
  env.gqtp_host {{ env_gqtp_host | default('127.0.0.1') }}

  # GQTP server port.
  # Default: 10043
  env.gqtp_port {{ env_gqtp_port | default(10043) }}

  # Path to the database used by Groonga GQTP server.
  # Default: /var/lib/groonga/db/db
  env.gqtp_database_path {{ env_gqtp_database_path | default('/var/lib/groonga/db/db') }}

  # Path to the PID file for Groonga GQTP server.
  # Default: /var/run/groonga/groonga-gqtp.pid
  env.gqtp_pid_path {{ env_gqtp_pid_path | default('/var/run/groonga/groonga-gqtp.pid') }}

  # Path to the query log file for Groonga GQTP server.
  # Default: /var/log/groonga/query-gqtp.log
  env.gqtp_query_log_path {{ env_gqtp_query_log_path | default('/var/log/groonga/query-gqtp.log') }}