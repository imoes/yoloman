# ==============================================================================
# grml-rescueboot configuration
# ==============================================================================
# This configuration file controls the behavior of the grml-rescueboot package.
# It defines where rescue ISO images are stored, how they are grouped in the
# GRUB boot menu, and any default kernel boot parameters to apply.
#
# Variables used:
#   ISO_LOCATION       (str) Path to the directory containing .iso files
#   GRUB_SUBMENU       (str) Name of the GRUB submenu, or "" to disable
#   CUSTOM_BOOTOPTIONS (str) Space-separated kernel parameters to append
# ==============================================================================

# ISO_LOCATION specifies the directory path where ISO files are stored and
# from which rescue entries are generated. The bootloader will look for
# valid ISO images in this location.
ISO_LOCATION="{{ ISO_LOCATION | default('/boot/grml/') }}"

# GRUB_SUBMENU defines the name of the GRUB submenu under which grml rescue
# entries will be grouped. If set to an empty string, entries will appear
# directly in the main GRUB menu without a submenu.
GRUB_SUBMENU="{{ GRUB_SUBMENU | default('Grml Rescue Boot menu') }}"

# CUSTOM_BOOTOPTIONS allows you to append space-separated boot options to all
# generated kernel command lines for rescue images. Common use cases include
# enabling ssh access or setting the language. Leave empty to use defaults.
CUSTOM_BOOTOPTIONS="{{ CUSTOM_BOOTOPTIONS | default('ssh=password lang=de') }}"