{
  "input_file": "/dev/sdb",
  "outputs": [
    {
      "path": "sdb.img",
      "split_bytes": "500M",
      "split_format": "annnn"
    }
  ],
  "input_block_size": 4096,
  "hash_algorithms": [
    "md5",
    "sha256"
  ],
  "md5_file": "sdb.md5",
  "sha256_file": "sdb.sha256",
  "hashconv_mode": "before",
  "status": true,
  "status_interval_blocks": 256,
  "sizeprobe_mode": "if"
}
