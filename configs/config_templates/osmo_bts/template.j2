# OsmoBTS Configuration Template
# This template generates a valid OsmoBTS configuration file.
# It is self-documenting: every directive is preceded by a comment explaining its purpose
# and source variable.

# --- Global BTS Configuration Block ---
bts 0
  # BTS hardware type (e.g., sysmo, lms, octal, none)
  type {{ bts_type | default('sysmo') }}

  # GSM band (e.g., GSM900, DCS1800, PCS1900, GSM850)
  band {{ band | default('DCS1800') }}

  # ARFCN configuration
  # Starting ARFCN for the cell
  arfcn {{ arfcn_start | default(512) }}
  # Number of ARFCNs (>1 enables frequency hopping range)
  # Output format: arfcn start stop
  {% if arfcn_range | default(1) > 1 %}
  arfcn range {{ arfcn_start | default(512) }} {{ arfcn_start | default(512) + arfcn_range | default(1) - 1 }}
  {% endif %}

  # Maximum mobile station transmit power in dBm
  ms power max {{ ms_power_max | default(22) }}

  # Power control step size in dB
  ms power step {{ ms_power_step | default(2) }}

  # Location Area Code (LAC) for the cell (0–65534)
  # Used for location updates and paging area identification
  location area code {{ location_area_code | default(1) }}

  # Cell Identity (CI) — unique per BSC (0–65535)
  cell identity {{ cell_identity | default(1) }}

  # --- TRX 0 Configuration ---
  trx 0
    # RF ARFCN for this TRX (typically matches arfcn_start)
    rf arfcn {{ arfcn_start | default(512) }}

    # RF power reduction (dB) applied to the TRX
    max_power_red {{ power_reduction | default(0) }}

    # TRX RF output power (dBm)
    tx power {{ tx_power | default(20) }}

  # --- E1 Line Configuration ---
  e1_line 0
    # E1 line ID (0 = default line)
    e1_line {{ e1_line_id | default(0) }}

    # E1 port ID (1-based, typically 1)
    e1_port {{ e1_port_id | default(1) }}

    # E1 timeslot for RSL (Radio Signalling Link) (0–31)
    # 0 is typically reserved for OML
    e1_timeslot {{ e1_timeslot | default(1) }}

    # E1 subslot (if applicable/sub-slotted)
    e1_subslot {{ e1_subslot | default(0) }}

  # --- IPA Identification ---
  # IPA Unit-ID (0–255)
  ipa unit-id {{ unit_id | default(1) }}

  # IPA Site-ID (0–255)
  ipa site-id {{ site_id | default(1) }}

  # IPA BTS-ID (0–255)
  ipa bts-id {{ bts_id | default(1) }}

  # --- E1 Link References ---
  # RSL connection string: line/port/timeslot
  rsl e1 {{ e1_line_id | default(0) }}/{{ e1_port_id | default(1) }}/{{ e1_timeslot | default(1) }}

  # OML connection string: line/port/timeslot
  oml e1 {{ e1_line_id | default(0) }}/{{ e1_port_id | default(1) }}/{{ e1_oml_timeslot | default(0) }}

  # --- Scheduler Configuration ---
  # Scheduler type: 'gsm' (default), 'gprs', 'egprs'
  scheduler {{ scheduler_type | default('gsm') }}

  # Enable scheduler support for TCH/H (full-rate + half-rate voice)
  {% if scheduler_tchh_enabled | default(true) %}
  scheduler tch/h enabled
  {% endif %}

  # --- Abis over IP Configuration (Optional) ---
  # If Abis is transported over IP instead of E1
  {% if abis_ip is defined %}
  ip
    # IP address to bind the Abis IP service
    bind {{ (abis_ip | default({})).bind_addr | default('0.0.0.0') }}
    # Remote BTS IP address
    remote {{ (abis_ip | default({})).remote_addr | default('127.0.0.1') }}
  {% endif %}

  # --- LAC/CI Overrides ---
  # Optional per-BTS LAC override (if different from location_area_code)
  lac {{ lac_override | default(location_area_code) | default(1) }}

  # Optional per-BTS CI override (if different from cell_identity)
  ci {{ ci_override | default(cell_identity) | default(1) }}

  # --- Timing Advance ---
  # Timing Advance offset (0–63), used for fine alignment
  ta {{ ta_offset | default(0) }}

  # --- Handover Parameters ---
  # Handover A3 offset (dB, scaled by 2 in Osmocom; 0–63 → actual offset in 0.5 dB steps)
  ho a3_offset {{ ho_a3_offset | default(0) }}

  # Handover hysteresis margin (0–15 dB)
  ho hysteresis {{ ho_hysteresis | default(2) }}

  # --- Power Control ---
  # Maximum downlink power control step (dB)
  pwrctl max_delta_dl {{ power_control_max_delta_dl | default(15) }}

  # Maximum uplink power control step (dB)
  pwrctl max_delta_ul {{ power_control_max_delta_ul | default(12) }}

  # --- SI2quater Support ---
  # Enable SI2quater (UTRAN neighbor info) for GSM-UMTS handover
  si2quater {{ si2quater_enabled | default(false) | lower }}

  # Additional SI2quater content (e.g., UARFCN list) — raw string
  {% if si2quater_extra is defined %}
  si2quater extra {{ si2quater_extra }}
  {% endif %}

  # --- CSG Configuration ---
  # Enable Closed Subscriber Group (CSG) mode
  csg {{ csg_enabled | default(false) | lower }}

  # CSG ID (0–268435455); only used if csg_enabled = true
  csg-id {{ csg_id | default(0) }}

  # --- TCH Mixed Mode ---
  # Mixed TCH/F and TCH/H mode: 'auto', 'f-only', 'h-only'
  {% if tch_mixed_mode is defined %}
  tch/f tch/h mixed-mode {{ tch_mixed_mode }}
  {% else %}
  tch/f tch/h mixed-mode {{ tch_mixed_mode | default('auto') }}
  {% endif %}

  # --- AMR Configuration ---
  # Enable Adaptive Multi-Rate (AMR) speech codec
  amr {{ amr_enabled | default(false) | lower }}

  # AMR threshold configuration for codec switching
  {% if amr_thresholds is defined %}
  amr threshold {{ (amr_thresholds | default({})).threshold1 | default(0) }}/{{ (amr_thresholds | default({})).threshold2 | default(0) }}
  {% endif %}

  # --- Keepalive Settings ---
  # OML keepalive interval (seconds)
  oml keepalive {{ oml_keepalive | default(30) }}

  # Abis keepalive interval (seconds)
  abis keepalive {{ abis_keepalive | default(30) }}

# --- BTS-Specific Logging Configuration ---
# These are global directives in OsmoBTS config format
# Global log level (DUMP, SYSTEM, NS, BSSGP, L1, L2, RSL, OML, DB, etc.)
log level all {{ log_level_all | default('DEBUG') }}

# Log level for L1 (physical layer)
log level l1 {{ log_level_l1 | default('DEBUG') }}

# Log level for L2 (data link layer)
log level l2 {{ log_level_l2 | default('DEBUG') }}

# Log level for APDU (application layer)
log level l apdu {{ log_level_apdu | default('DEBUG') }}

# Log level for RSL (Radio Signalling Link)
log level rsl {{ log_level_rsl | default('DEBUG') }}

# Log level for OML (Operations & Maintenance)
log level oml {{ log_level_oml | default('DEBUG') }}

# Log level for BSSGP (GPRS)
log level bssgp {{ log_level_bssgp | default('DEBUG') }}

# Log level for NS/NSVC (GPRS network service)
log level nsvc {{ log_level_nsvc | default('DEBUG') }}

# Log level for mgcp (media gateway control, if used)
log level mgcp {{ log_level_mgmt | default('DEBUG') }}

# Log level for database (channel allocation, etc.)
log level db {{ log_level_db | default('DEBUG') }}

# --- BTS 0 Specific Timing and Reselection ---
bts 0
  # Extra timing alignment offset (0–31, scaled)
  timing advance {{ timing_alignment | default(0) }}

  # Timing alignment value (if distinct from timing advance)
  timing alignment {{ timing_alignment | default(0) }}

  # Cell reselection hysteresis (dB)
  cell reselect hysteresis {{ cell_resel_hyst | default(2) }}

  # Cell reselection offset (CRO, dB)
  cell reselect offset {{ cell_resel_offset | default(0) }}

  # RACH configuration
  # RACH transmission interval (2–7, default 3)
  rach tx integer {{ rach_tx_int | default(3) }}

  # Maximum RACH bursts per access (1–3)
  rach max burst {{ rach_max_burst | default(2) }}

  # SDCCH configuration
  # Number of full-rate SDCCH channels (0–8)
  sdcch/full {{ sdcch_full | default(0) }}

  # Number of half-rate SDCCH channels (0–8)
  sdcch/half {{ sdcch_half | default(0) }}

  # TCH Configuration
  # Number of full-rate TCH channels (0–8)
  tch/f {{ tch_f | default(1) }}

  # Number of half-rate TCH channels (0–8)
  tch/h {{ tch_h | default(0) }}

  # PACCH Sharing
  # Enable PACCH (Packet Associated CH) sharing on TCH/F-H
  pacch sharing {{ pacch_sharing_enabled | default(true) | lower }}

  # --- MS Parameters ---
  # Mobile station multiclass support (1–15); 2 = dual-slot class 10
  ms multiclass {{ ms_multiclass | default(2) }}

  # Mobile station power class (1–4 for DCS1800)
  ms power class {{ ms_power_class | default(4) }}

  # Minimum required RxLev for access (0–63, scaled dBm)
  ms rxlev access min {{ ms_rxlev_access_min | default(0) }}

# --- Neighbor Cells ---
# List of manually configured neighbor cells (BCC/NCC/ARFCN)
{% if neighbor_cells is defined and neighbor_cells | length > 0 %}
bts 0
{% for nc in neighbor_cells %}
  neighbor {{ nc.bcc | default(0) }}/{{ nc.ncc | default(0) }}/{{ nc.arfcn | default(0) }}
{% endfor %}
{% endif %}

# --- CSG Cells ---
# List of CSG cells (for CSG-enabled cells)
{% if csg_cells is defined and csg_cells | length > 0 %}
bts 0
{% for csgc in csg_cells %}
  csg-cell {{ csgc.bcc | default(0) }}/{{ csgc.ncc | default(0) }}/{{ csgc.arfcn | default(0) }}/{{ csgc.csg_id | default(0) }}
{% endfor %}
{% endif %}

# --- GPRS/EDGE Support (Optional) ---
{% if gprs_enabled | default(false) %}
bts 0
  # GPRS coding scheme: 'cs1', 'cs2', 'cs3', 'cs4', 'auto'
  gprs mode {{ gprs_mode | default('cs1') }}

  # Enable EDGE/Egprs support (implies GPRS)
  egprs mode {{ egprs_enabled | default(false) | lower }}

  # BSSGP Configuration
  bssgp
    # NSE (Network Service Entity) ID (0–65535)
    nse {{ nse_id | default(1) }}

    # VBE (BSSGP Virtual BE) ID (0–65535)
    vbe {{ vbe_id | default(1) }}

    # BVI (BSSGP Virtual Interface) ID (0–65535)
    bvi {{ bvi_id | default(1) }}

    # NSVC (NS Virtual Connection) ID (0–65535)
    nsvc {{ nsvc_id | default(1) }}

  # Cell Configuration
  cell
    # CCCH configuration (0–3; 1 = 1 CCCH non-combined)
    ccch conf {{ ccch_conf | default(1) }}

    # Number of CCCH copies (0–3)
    ccch copies {{ ccch_copies | default(1) }}

    # BS PA MFRMS (paging channel frames, 2–9)
    bs pa mfrms {{ bs_pa_mfrms | default(2) }}

    # T3122 (seconds, 0–31) — pause before retry after channel rejection
    t3122 {{ t3122 | default(0) }}

    # Number of AGCH channels (0–2)
    bs ag chans {{ bs_ag_chans | default(0) }}

  # RLC Configuration
  rlc
    # RLC/MAC TDL (downlink) timeout (0–63)
    tdl {{ tdl | default(32) }}

    # RLC/MAC TDU (uplink) timeout (0–63)
    tdu {{ tdu | default(32) }}

    # BLER target for link adaptation (%) — scaled (e.g., 10 = 1.0%)
    bler target {{ bler_target | default(1) }}
{% endif %}