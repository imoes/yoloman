{
  "bts_type": {
    "type": "string",
    "default": "sysmo",
    "description": "BTS hardware type (e.g., sysmo, lms, octal, none)"
  },
  "band": {
    "type": "string",
    "default": "DCS1800",
    "description": "GSM band (e.g., GSM900, DCS1800, PCS1900, GSM850)"
  },
  "arfcn_start": {
    "type": "number",
    "default": 512,
    "description": "Starting ARFCN for the cell"
  },
  "arfcn_range": {
    "type": "number",
    "default": 1,
    "description": "Number of ARFCNs (1 = single frequency, >1 = frequency hopping)"
  },
  "ms_power_max": {
    "type": "number",
    "default": 22,
    "description": "Maximum mobile station transmit power (dBm)"
  },
  "ms_power_step": {
    "type": "number",
    "default": 2,
    "description": "Power control step size (dB)"
  },
  "location_area_code": {
    "type": "number",
    "default": 1,
    "description": "LAC for the cell (0\u201365534); used for location updates"
  },
  "cell_identity": {
    "type": "number",
    "default": 1,
    "description": "Cell Identity (CI) \u2014 unique per BSC (0\u201365535)"
  },
  "tx_power": {
    "type": "number",
    "default": 20,
    "description": "TRX RF output power (dBm)"
  },
  "power_reduction": {
    "type": "number",
    "default": 0,
    "description": "RF power reduction (dB) applied to the TRX"
  },
  "e1_line_id": {
    "type": "number",
    "default": 0,
    "description": "E1 line ID (0 = default line)"
  },
  "e1_port_id": {
    "type": "number",
    "default": 1,
    "description": "E1 port ID (1-based, typically 1)"
  },
  "e1_timeslot": {
    "type": "number",
    "default": 1,
    "description": "E1 timeslot for RSL (0\u201331); 0 reserved for OML"
  },
  "e1_oml_timeslot": {
    "type": "number",
    "default": 0,
    "description": "E1 timeslot for OML (typically 0)"
  },
  "unit_id": {
    "type": "number",
    "default": 1,
    "description": "IPA Unit-ID (0\u2013255)"
  },
  "site_id": {
    "type": "number",
    "default": 1,
    "description": "IPA Site-ID (0\u2013255)"
  },
  "bts_id": {
    "type": "number",
    "default": 1,
    "description": "IPA BTS-ID (0\u2013255)"
  },
  "scheduler_type": {
    "type": "string",
    "default": "gsm",
    "description": "Scheduler type: 'gsm' (default), 'gprs', 'egprs'"
  },
  "scheduler_tchh_enabled": {
    "type": "boolean",
    "default": true,
    "description": "Enable scheduler support for TCH/H (full-rate + half-rate voice)"
  },
  "abis_ip": {
    "type": "object",
    "default": null,
    "description": "Abis over IP configuration (optional)",
    "items": {
      "bind_addr": {
        "type": "string",
        "default": "0.0.0.0",
        "description": "Local IP to bind Abis/IP"
      },
      "remote_addr": {
        "type": "string",
        "default": "127.0.0.1",
        "description": "Remote IP (e.g., BSC or OML gateway)"
      }
    }
  },
  "lac_override": {
    "type": "number",
    "default": null,
    "description": "Optional per-BTS LAC override (if different from location_area_code)"
  },
  "ci_override": {
    "type": "number",
    "default": null,
    "description": "Optional per-BTS CI override (if different from cell_identity)"
  },
  "ta_offset": {
    "type": "number",
    "default": 0,
    "description": "Timing Advance offset (0\u201363), used for fine alignment"
  },
  "ho_a3_offset": {
    "type": "number",
    "default": 0,
    "description": "Handover A3 offset (dB, scaled by 2 in Osmocom; 0\u201363 \u2192 actual offset in 0.5 dB steps)"
  },
  "ho_hysteresis": {
    "type": "number",
    "default": 2,
    "description": "Handover hysteresis margin (0\u201315 dB)"
  },
  "power_control_max_delta_dl": {
    "type": "number",
    "default": 15,
    "description": "Maximum downlink power control step (dB)"
  },
  "power_control_max_delta_ul": {
    "type": "number",
    "default": 12,
    "description": "Maximum uplink power control step (dB)"
  },
  "si2quater_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Enable SI2quater (UTRAN neighbor info)"
  },
  "si2quater_extra": {
    "type": "string",
    "default": null,
    "description": "Additional SI2quater content (e.g., UARFCN list) \u2014 raw string"
  },
  "csg_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Enable Closed Subscriber Group (CSG) mode"
  },
  "csg_id": {
    "type": "number",
    "default": 0,
    "description": "CSG ID (0\u2013268435455); only used if csg_enabled = true"
  },
  "tch_mixed_mode": {
    "type": "string",
    "default": "auto",
    "description": "Mixed TCH/F and TCH/H mode: 'auto', 'f-only', 'h-only'"
  },
  "amr_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Enable Adaptive Multi-Rate (AMR) speech codec"
  },
  "amr_thresholds": {
    "type": "object",
    "default": null,
    "description": "AMR threshold configuration for codec switching",
    "items": {
      "threshold1": {
        "type": "number",
        "default": 3,
        "description": "Threshold 1 (RSSI level, 0\u201331, scaled)"
      },
      "threshold2": {
        "type": "number",
        "default": 5,
        "description": "Threshold 2 (RSSI level)"
      }
    }
  },
  "oml_keepalive": {
    "type": "number",
    "default": 30,
    "description": "OML keepalive interval (seconds)"
  },
  "abis_keepalive": {
    "type": "number",
    "default": 30,
    "description": "Abis keepalive interval (seconds)"
  },
  "log_level_all": {
    "type": "string",
    "default": "DEBUG",
    "description": "Global log level (DUMP, SYSTEM, NS, BSSGP, L1, L2, RSL, OML, DB, etc.)"
  },
  "log_level_l1": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for L1 (physical layer)"
  },
  "log_level_l2": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for L2 (data link layer)"
  },
  "log_level_apdu": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for APDU (application layer)"
  },
  "log_level_rsl": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for RSL (Radio Signalling Link)"
  },
  "log_level_oml": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for OML (Operations & Maintenance)"
  },
  "log_level_bssgp": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for BSSGP (GPRS)"
  },
  "log_level_nsvc": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for NS/NSVC (GPRS network service)"
  },
  "log_level_mgmt": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for mgcp (media gateway control, if used)"
  },
  "log_level_db": {
    "type": "string",
    "default": "DEBUG",
    "description": "Log level for database (channel allocation, etc.)"
  },
  "timing_alignment": {
    "type": "number",
    "default": 0,
    "description": "Extra timing alignment offset (0\u201331, scaled)"
  },
  "cell_resel_hyst": {
    "type": "number",
    "default": 2,
    "description": "Cell reselection hysteresis (dB)"
  },
  "cell_resel_offset": {
    "type": "number",
    "default": 0,
    "description": "Cell reselection offset (CRO, dB)"
  },
  "rach_tx_int": {
    "type": "number",
    "default": 3,
    "description": "RACH transmission interval (2\u20137, default 3)"
  },
  "rach_max_burst": {
    "type": "number",
    "default": 2,
    "description": "Maximum RACH bursts per access (1\u20133)"
  },
  "sdcch_full": {
    "type": "number",
    "default": 0,
    "description": "Number of full-rate SDCCH channels (0\u20138)"
  },
  "sdcch_half": {
    "type": "number",
    "default": 0,
    "description": "Number of half-rate SDCCH channels (0\u20138)"
  },
  "tch_f": {
    "type": "number",
    "default": 1,
    "description": "Number of full-rate TCH channels (0\u20138)"
  },
  "tch_h": {
    "type": "number",
    "default": 0,
    "description": "Number of half-rate TCH channels (0\u20138)"
  },
  "pacch_sharing_enabled": {
    "type": "boolean",
    "default": true,
    "description": "Enable PACCH (Packet Associated CH) sharing on TCH/F-H"
  },
  "gprs_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Enable GPRS support"
  },
  "gprs_mode": {
    "type": "string",
    "default": "cs1",
    "description": "GPRS coding scheme: 'cs1', 'cs2', 'cs3', 'cs4', 'auto'"
  },
  "egprs_enabled": {
    "type": "boolean",
    "default": false,
    "description": "Enable EDGE/Egprs support (implies GPRS)"
  },
  "nse_id": {
    "type": "number",
    "default": 1,
    "description": "NSE (Network Service Entity) ID (0\u201365535)"
  },
  "vbe_id": {
    "type": "number",
    "default": 1,
    "description": "VBE (BSSGP Virtual BE) ID (0\u201365535)"
  },
  "bvi_id": {
    "type": "number",
    "default": 1,
    "description": "BVI (BSSGP Virtual Interface) ID (0\u201365535)"
  },
  "nsvc_id": {
    "type": "number",
    "default": 1,
    "description": "NSVC (NS Virtual Connection) ID (0\u201365535)"
  },
  "ccch_conf": {
    "type": "number",
    "default": 1,
    "description": "CCCH configuration (0\u20133; 1 = 1 CCCH non-combined)"
  },
  "ccch_copies": {
    "type": "number",
    "default": 1,
    "description": "Number of CCCH copies (0\u20133)"
  },
  "bs_pa_mfrms": {
    "type": "number",
    "default": 2,
    "description": "BS PA MFRMS (paging channel frames, 2\u20139)"
  },
  "t3122": {
    "type": "number",
    "default": 0,
    "description": "T3122 (seconds, 0\u201331) \u2014 pause before retry after channel rejection"
  },
  "bs_ag_chans": {
    "type": "number",
    "default": 0,
    "description": "Number of AGCH channels (0\u20132)"
  },
  "tdl": {
    "type": "number",
    "default": 32,
    "description": "RLC/MAC TDL (downlink) timeout (0\u201363)"
  },
  "tdu": {
    "type": "number",
    "default": 32,
    "description": "RLC/MAC TDU (uplink) timeout (0\u201363)"
  },
  "bler_target": {
    "type": "number",
    "default": 1,
    "description": "BLER target for link adaptation (%) \u2014 scaled (e.g., 10 = 1.0%)"
  },
  "ms_multiclass": {
    "type": "number",
    "default": 2,
    "description": "Mobile station multiclass support (1\u201315); 2 = dual-slot class 10"
  },
  "ms_power_class": {
    "type": "number",
    "default": 4,
    "description": "Mobile station power class (1\u20134 for DCS1800)"
  },
  "ms_rxlev_access_min": {
    "type": "number",
    "default": 0,
    "description": "Minimum required RxLev for access (0\u201363, scaled dBm)"
  },
  "neighbor_cells": {
    "type": "list",
    "default": [],
    "description": "List of manually configured neighbor cells (BCC/NCC/ARFCN)",
    "items": {
      "bcc": {
        "type": "number",
        "default": 0,
        "description": "Base Station Color Code (0\u20137)"
      },
      "ncc": {
        "type": "number",
        "default": 0,
        "description": "Network Color Code (0\u20137)"
      },
      "arfcn": {
        "type": "number",
        "default": 0,
        "description": "ARFCN of neighbor cell"
      }
    }
  },
  "csg_cells": {
    "type": "list",
    "default": [],
    "description": "List of CSG cells (for CSG-enabled cells)",
    "items": {
      "bcc": {
        "type": "number",
        "default": 0,
        "description": "BCC"
      },
      "ncc": {
        "type": "number",
        "default": 0,
        "description": "NCC"
      },
      "arfcn": {
        "type": "number",
        "default": 0,
        "description": "ARFCN"
      },
      "csg_id": {
        "type": "number",
        "default": 0,
        "description": "CSG ID"
      }
    }
  }
}
