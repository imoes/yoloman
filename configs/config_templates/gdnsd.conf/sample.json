{
  "enabled": true,
  "listen_addrs": [
    {
      "address": "127.0.0.1",
      "port": 53
    },
    {
      "address": "192.0.2.10",
      "port": 53
    },
    {
      "address": "2001:db8::10",
      "port": 53
    }
  ],
  "log_file": "/var/log/gdnsd/gdnsd.log",
  "log_level": "info",
  "security": {
    "chroot": "/var/lib/gdnsd",
    "user": "gdnsd",
    "group": "gdnsd"
  },
  "server": {
    "workers": 0,
    "max_udp_size": 4096,
    "tcp_timeout": 30,
    "max_tcp_connections": 100
  },
  "zones": {
    "root": "/var/lib/gdnsd/zones",
    "auto_reload": true,
    "reload_interval": 60,
    "zones": [
      {
        "name": "example.com",
        "file": "example.com.zone"
      },
      {
        "name": "example.net",
        "file": "example.net.zone"
      }
    ]
  },
  "dnssec": {
    "enabled": false,
    "keys_dir": "/var/lib/gdnsd/dnssec-keys",
    "rrsig_ttl": 86400
  },
  "access_control": {
    "enabled": false,
    "default": "allow",
    "rules": []
  }
}
