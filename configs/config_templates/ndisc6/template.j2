# NDISC6(8) configuration file
# This file configures the ndisc6 ICMPv6 Neighbor Discovery tool.
# See man page ndisc6(8) for details on options.

# Target IPv6 address to perform Neighbor Discovery on
# Corresponds to the <IPv6 address> argument in SYNOPSIS
TARGET_ADDRESS: {{ target_address | default('::1') }}

# Network interface on which to perform the lookup
# Corresponds to the <iface> argument in SYNOPSIS
INTERFACE: {{ interface | default('eth0') }}

# Source IPv6 address for the neighbor solicitation packets
# Corresponds to -s/--source source_ip
SOURCE_ADDRESS: {{ source_address | default('') }}

# Number of attempts to send ICMPv6 ND packets
# Corresponds to -r/--retry attempts. Default is 3.
MAX_ATTEMPTS: {{ max_attempts | default(3) }}

# Wait time in milliseconds between retries
# Corresponds to -w/--wait wait_ms. Default is 1000 (1 second).
RETRY_WAIT_MS: {{ retry_wait_ms | default(1000) }}

# Use numeric output only; do not resolve DNS
# Corresponds to -n/--numeric
NUMERIC_ONLY: {{ numeric_only | default(false) }}

# Quiet mode: only display link-layer address
# Corresponds to -q/--quiet
QUIET_MODE: {{ quiet_mode | default(false) }}

# Single mode: exit on first advertisement
# Corresponds to -1/--single. Default behavior.
SINGLE_MODE: {{ single_mode | default(true) }}

# Verbose mode: display verbose information
# Corresponds to -v/--verbose. Overrides quiet if true.
VERBOSE: {{ verbose | default(true) }}