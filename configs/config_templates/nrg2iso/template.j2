# nrg2iso configuration template
# This configuration controls the behavior of the nrg2iso tool for converting Nero .nrg
# disc images into standard ISO9660 format.

# Path to the input Nero .nrg file to be converted.
# If unset, defaults to /tmp/input.nrg.
input_file: "{{ nrg_file | default('/tmp/input.nrg') }}"

# Path to the output ISO9660 file.
# If unset, defaults to /tmp/output.iso.
output_file: "{{ iso_file | default('/tmp/output.iso') }}"

# If true, displays the help screen instead of converting.
# This is useful for verifying the configuration before running a conversion.
# If unset, defaults to false.
display_help: "{{ display_help | default(False) }}"

# If true, displays the version instead of converting.
# This is useful for debugging or verifying the installed version.
# If unset, defaults to false.
display_version: "{{ display_version | default(False) }}"