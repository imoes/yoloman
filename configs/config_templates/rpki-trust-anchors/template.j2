# ==============================================================================
# RPKI Trust Anchor Configuration Template
# ==============================================================================
# This template generates the configuration for RPKI (Resource Public Key
# Infrastructure) trust anchors. It defines the source URLs from which the
# trust anchor certificates are retrieved and embeds the certificate content.
#
# Variables:
#   trust_anchor_name:       The short name of the RPKI trust anchor (e.g., afrinic, ripencc, arin).
#   trust_anchor_certificate: The base64-encoded content of the trust anchor certificate.
# ==============================================================================

# --- Source URLs ---
# These lines define the HTTP and RSYNC repositories for the specified trust anchor.
# Replace `rpki.afrinic.net` with the appropriate registry's RPKI repository base
# if using a different provider (e.g., ripencc, arin, apnic, lacnic).

# HTTP URL for the trust anchor certificate
https://rpki.afrinic.net/repository/{{ trust_anchor_name | default('AfriNIC') }}.cer

# RSYNC URL for the trust anchor certificate
rsync://rpki.afrinic.net/repository/{{ trust_anchor_name | default('AfriNIC') }}.cer

# --- Certificate Content ---
# The actual base64-encoded X.509 certificate content.
# This is required by validators (like Routinator) to initialize the trust anchor store.

