# OLPC XO Power Management Daemon configuration file
# Controls battery charging, LCD brightness, suspend behavior, and power policies
# Enable/disable LCD dimming on battery power
{% if lcd_dim_on_battery is defined %}lcd_dim_on_battery={{ 'yes' if lcd_dim_on_battery else 'no' }}{% endif %}
# Enable/disable automatic LCD brightness adjustment based on ambient light
{% if auto_brightness is defined %}auto_brightness={{ 'yes' if auto_brightness else 'no' }}{% endif %}
# Minimum LCD brightness level (0–15)
{% if min_brightness is defined %}min_brightness={{ min_brightness }}{% endif %}
# Maximum LCD brightness level (0–15)
{% if max_brightness is defined %}max_brightness={{ max_brightness }}{% endif %}
# Battery percentage at which to warn the user
{% if low_battery_warning is defined %}low_battery_warning={{ low_battery_warning }}{% endif %}
# Battery percentage at which to automatically suspend
{% if low_battery_suspend is defined %}low_battery_suspend={{ low_battery_suspend }}{% endif %}
# Timeout (in seconds) of inactivity before automatic suspend (0 = disabled)
{% if suspend_timeout is defined %}suspend_timeout={{ suspend_timeout }}{% endif %}
# Timeout (in seconds) of inactivity before LCD blanking (0 = disabled)
{% if blank_timeout is defined %}blank_timeout={{ blank_timeout }}{% endif %}
# Enable/disable automatic lid-close suspend
{% if suspend_on_lid_close is defined %}suspend_on_lid_close={{ 'yes' if suspend_on_lid_close else 'no' }}{% endif %}
# Enable/disable lid-close suspend only when on battery
{% if suspend_on_lid_close_battery_only is defined %}suspend_on_lid_close_battery_only={{ 'yes' if suspend_on_lid_close_battery_only else 'no' }}{% endif %}
# List of user-defined power policies (one per line)
{% for policy in power_policies %}policy={{ policy.name }}={{ policy.action }}{% endfor %}
# Enable/disable debugging output (verbose logging)
{% if debug is defined %}debug={{ 'yes' if debug else 'no' }}{% endif %}
# Path to custom backlight control script (optional)
{% if backlight_script is defined and backlight_script %}backlight_script={{ backlight_script }}{% endif %}
