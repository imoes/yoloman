{
  "lcd_dim_on_battery": true,
  "auto_brightness": true,
  "min_brightness": 3,
  "max_brightness": 14,
  "low_battery_warning": 10,
  "low_battery_suspend": 4,
  "suspend_timeout": 300,
  "blank_timeout": 45,
  "suspend_on_lid_close": true,
  "suspend_on_lid_close_battery_only": true,
  "power_policies": [
    {
      "name": "charger-plugged",
      "action": "resume"
    },
    {
      "name": "charger-unplugged",
      "action": "none"
    },
    {
      "name": "lid-opened",
      "action": "unblank"
    }
  ],
  "debug": false,
  "backlight_script": ""
}
