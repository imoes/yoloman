{
  "mkhomedir_helper_path": "/usr/lib/oddjob/oddjob-mkhomedir",
  "max_threads": 16,
  "service_timeout": 45,
  "services": [
    {
      "name": "org.freedesktop.realmd",
      "path": "/usr/lib/oddjob/org.freedesktop.realmd",
      "user": "root",
      "group": "root",
      "umask": "022",
      "allow_users": [
        "*"
      ]
    },
    {
      "name": "com.redhat.idm.ad enroll",
      "path": "/usr/lib/oddjob/com.redhat.idm.ad_enroll",
      "user": "root",
      "group": "root",
      "umask": "022",
      "deny_users": [
        "nobody",
        "nfsnobody"
      ]
    },
    {
      "name": "org.freedesktop.realmd.kerberos-ticket",
      "path": "/usr/lib/oddjob/org.freedesktop.realmd.kerberos-ticket",
      "user": "root",
      "group": "root",
      "umask": "077",
      "allow_users": [
        "admin",
        "idm-admin"
      ]
    }
  ]
}
