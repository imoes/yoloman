# Schedtool configuration for target processes
# This file defines which processes to manage and their scheduling parameters.
# Generated by Ansible Jinja2 template — self-documenting.

{% for process in processes | default([]) %}
# Target {{ loop.index }}: {{ process.name | default('unnamed-process') }}
# Command to execute or PID to modify. If this is a new process, specify the full command;
# if it is an existing process, specify its PID as a string or integer.
command: {{ process.command | default('') }}

# Scheduling Policy: NORMAL, FIFO, RR, BATCH, ISO, or IDLE
# Controls the kernel scheduling algorithm applied to the process.
# FIFO and RR require a static priority; ISO is for realtime bandwidth control.
policy: {{ process.policy | default('NORMAL') }}

# CPU Affinity: Hexadecimal bitmask (e.g., 0x1) or comma-separated list (e.g., 0,3)
# Default: run on all CPUs (0x0 usually implies auto/all in schedtool contexts,
# but explicitly setting 0xFFFFFFFF... or omitting is better for full affinity).
affinity: {{ process.affinity | default('0x0') }}

# Nice level (-20 to 19, where 19 is lowest priority)
# Only effective for NORMAL policy or when lowering realtime constraints.
nice_level: {{ process.nice_level | default(0) }}

# Static priority (1-99, required for FIFO/RR policies)
# Values 1-99: 1 is lowest realtime priority, 99 is highest.
# Ignored for NORMAL/BATCH/IDLE policies.
priority: {{ process.priority | default(20) }}
{% if not loop.last %}
---
{% endif %}
{% endfor %}