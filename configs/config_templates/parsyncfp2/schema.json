{
  "src": {
    "type": "string",
    "default": "/data/source",
    "description": "The local source directory to transfer from."
  },
  "dest": {
    "type": "string",
    "default": "remotehost:/data/dest",
    "description": "The remote destination in host:path format."
  },
  "np": {
    "type": "number",
    "default": 4,
    "description": "Number of parallel rsync processes."
  },
  "chunksize": {
    "type": "string",
    "default": "10G",
    "description": "Chunk size for splitting data."
  },
  "ro": {
    "type": "string",
    "default": "-asl",
    "description": "Rsync options string."
  },
  "startdir": {
    "type": "string",
    "default": "/data/source",
    "description": "The starting directory for the scan."
  },
  "loadavg_limit": {
    "type": "number",
    "default": 0,
    "description": "Max load average to allow transfers (0=disabled)."
  }
}
