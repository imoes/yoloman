# Parsyncfp2 configuration template
# ==============================================================================
# This file configures parsyncfp2, a tool for parallel, fault-tolerant file
# transfers using rsync under the hood. Each variable below corresponds to a
# configuration directive. Defaults are applied inline to ensure robustness
# when variables are undefined.
# ==============================================================================

# src: default='/data/source'
# desc='The local source directory to transfer from.'
SRC="{{ src | default('/data/source') }}"

# dest: default='remotehost:/data/dest'
# desc='The remote destination in host:path format.'
DEST="{{ dest | default('remotehost:/data/dest') }}"

# np: default=4
# desc='Number of parallel rsync processes.'
NP="{{ np | default(4) }}"

# chunksize: default='10G'
# desc='Chunk size for splitting data.'
CHUNKSIZE="{{ chunksize | default('10G') }}"

# ro: default='-asl'
# desc='Rsync options string.'
RO="{{ ro | default('-asl') }}"

# startdir: default='/data/source'
# desc='The starting directory for the scan.'
STARTDIR="{{ startdir | default('/data/source') }}"

# loadavg_limit: default=0
# desc='Max load average to allow transfers (0=disabled).'
LOADAVG_LIMIT="{{ loadavg_limit | default(0) }}"