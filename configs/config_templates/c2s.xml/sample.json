{
  "listen_port": 5222,
  "listen_host": "0.0.0.0",
  "tls_enabled": true,
  "tls_cert_file": "/etc/jabberd2/server.pem",
  "tls_key_file": "/etc/jabberd2/server.pem",
  "tls_ca_file": "/etc/jabberd2/ca-chain.pem",
  "tls_verify_mode": "optional",
  "max_connections": 2048,
  "idle_timeout": 180,
  "auth_timeout": 60,
  "auth_backend": "mysql",
  "mysql_host": "db.example.com",
  "mysql_port": 3306,
  "mysql_user": "jabberd",
  "mysql_pass": "secret123",
  "mysql_db": "jabber",
  "mysql_table": "users",
  "mysql_user_field": "username",
  "mysql_pass_field": "password_hash",
  "quota_sessions_per_user": 5,
  "quota_messages_per_minute": 120,
  "log_file": "/var/log/jabberd/c2s.log",
  "log_level": "warn",
  "rate_limit_rules": [
    {
      "type": "iq",
      "max": 10,
      "interval": 60
    },
    {
      "type": "message",
      "max": 30,
      "interval": 60
    }
  ],
  "acls": [
    {
      "action": "deny",
      "match": "spam@bot.example.com"
    },
    {
      "action": "deny",
      "match": "*@evil.com"
    }
  ]
}
