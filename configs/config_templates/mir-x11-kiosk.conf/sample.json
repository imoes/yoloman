{
  "server_host": "localhost",
  "server_port": 4713,
  "display": 0,
  "kiosk_user": "kiosk",
  "auto_start_x_server": true,
  "applications": [
    {
      "name": "Chromium Browser",
      "command": "/usr/bin/chromium-browser",
      "icon": "/usr/share/icons/chromium.png",
      "args": [
        "--kiosk",
        "--disable-gpu",
        "--no-sandbox",
        "--disable-dev-shm-usage"
      ],
      "working_dir": "/home/kiosk",
      "autostart": true
    },
    {
      "name": "System Monitor",
      "command": "/usr/bin/htop",
      "autostart": false
    }
  ],
  "x_server_args": [
    "-nolisten",
    "tcp",
    "-extension",
    "MIT-SHM"
  ],
  "wayland_socket_path": "/run/user/1000/mir_socket",
  "enable_touch": true
}
