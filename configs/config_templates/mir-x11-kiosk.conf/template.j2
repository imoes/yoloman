# Mir X11 Kiosk configuration
# Server endpoint for Mir display server
# X11 display number to use
# Kiosk user to run under
# Whether to auto-start X server
# List of applications to launch in kiosk mode
# X11 server arguments
# Optional Wayland socket path
# Whether to enable touch support

{% if server_host %}server-host: {{ server_host }}{% endif %}
{% if server_port %}server-port: {{ server_port }}{% endif %}
{% if display %}display: :{{ display }}{% endif %}
{% if kiosk_user %}kiosk-user: {{ kiosk_user }}{% endif %}
{% if auto_start_x_server %}auto-start-x-server: {{ auto_start_x_server }}{% endif %}

applications:
{% for app in applications %}  - name: {{ app.name }}
    command: {{ app.command }}
    {% if app.icon %}    icon: {{ app.icon }}{% endif %}
    {% if app.args %}    args:
{% for arg in app.args %}      - {{ arg }}{% endfor %}    {% endif %}
    {% if app.working_dir %}    working-dir: {{ app.working_dir }}{% endif %}
    {% if app.autostart is defined %}    autostart: {{ app.autostart }}{% else %}    autostart: true{% endif %}
{% endfor %}
{% if x_server_args %}x-server-args:
{% for arg in x_server_args %}  - {{ arg }}{% endfor %}{% endif %}

{% if wayland_socket_path %}wayland-socket-path: {{ wayland_socket_path }}{% endif %}
{% if enable_touch %}enable-touch: {{ enable_touch }}{% endif %}