# rdnssd main configuration file
# Enable or disable the daemon
ENABLED={{ enabled }}

# Log level: 0 (quiet) to 7 (debug)
LOG_LEVEL={{ log_level }}

# List of interfaces to monitor for Router Advertisements
INTERFACES={{ interfaces | join(' ') }}

# Maximum number of DNS servers to configure per interface
MAX_NS={{ max_ns }}

# List of DNS search domains to append to resolv.conf (if supported by resolver)
{% if search_domains %}
SEARCH_DOMAINS={{ search_domains | join(' ') }}
{% endif %}

# Path to resolv.conf (or alternative resolver config)
RESOLV_CONF={{ resolv_conf_path }}

# Path to PID file
PID_FILE={{ pid_file_path }}

# User to drop privileges to (must exist)
USER={{ user }}

# Enable or disable systemd socket activation (if supported)
SYSTEMD_SOCKET_ACTIVATION={{ systemd_socket_activation }}
