{
  "enabled": true,
  "log_level": 3,
  "interfaces": [
    "eth0",
    "wlan0"
  ],
  "max_ns": 3,
  "search_domains": [
    "home.lan",
    "internal.example.com"
  ],
  "resolv_conf_path": "/etc/resolv.conf",
  "pid_file_path": "/run/rdnssd.pid",
  "user": "nobody",
  "systemd_socket_activation": false
}
