{
  "interface": {
    "type": "string",
    "default": "auto",
    "description": "Wireless interface for capturing (e.g., 'wlan0', 'auto')"
  },
  "channel": {
    "type": "string",
    "default": "auto",
    "description": "Channel to scan for targets (e.g., '6', 'auto')",
    "enum": [
      "1",
      "2",
      "6",
      "7",
      "8",
      "10",
      "auto"
    ]
  },
  "essid": {
    "type": "string",
    "default": "ask",
    "description": "Target a specific access point by SSID (e.g., 'MyNetwork', 'ask')",
    "enum": [
      "ask",
      "any"
    ]
  },
  "bssid": {
    "type": "string",
    "default": "auto",
    "description": "Target a specific access point by BSSID (e.g., 'AA:BB:CC:DD:EE:FF', 'auto')",
    "enum": [
      "auto",
      "any"
    ]
  },
  "signal_threshold": {
    "type": "number",
    "default": 0,
    "description": "Minimum signal strength in dB to attack targets"
  },
  "show_bssids": {
    "type": "bool",
    "default": false,
    "description": "Display target BSSIDs after scan"
  },
  "quiet_mode": {
    "type": "bool",
    "default": false,
    "description": "Do not print list of APs during scan"
  },
  "mac_change": {
    "type": "bool",
    "default": false,
    "description": "Change MAC address of interface to a random MAC"
  },
  "attack_all": {
    "type": "bool",
    "default": false,
    "description": "Attack all targets found"
  },
  "target_wpa_only": {
    "type": "bool",
    "default": false,
    "description": "Only target WPA networks"
  },
  "wpa_timeout": {
    "type": "number",
    "default": 500,
    "description": "Time to wait for WPA attack to complete (seconds)"
  },
  "deauth_interval": {
    "type": "number",
    "default": 10,
    "description": "Time to wait between sending deauth packets (seconds)"
  },
  "strip_handshake": {
    "type": "bool",
    "default": false,
    "description": "Strip handshake using tshark or pyrit"
  },
  "crack_handshake": {
    "type": "bool",
    "default": false,
    "description": "Crack WPA handshakes using dictionary"
  },
  "dictionary_file": {
    "type": "string",
    "default": "phpbb.txt",
    "description": "Path to dictionary file for cracking WPA"
  },
  "verify_aircrack": {
    "type": "bool",
    "default": true,
    "description": "Verify handshake using aircrack"
  },
  "verify_pyrit": {
    "type": "bool",
    "default": false,
    "description": "Verify handshake using pyrit"
  },
  "verify_tshark": {
    "type": "bool",
    "default": true,
    "description": "Verify handshake using tshark"
  },
  "target_wep_only": {
    "type": "bool",
    "default": false,
    "description": "Only target WEP networks"
  },
  "packets_per_second": {
    "type": "number",
    "default": 600,
    "description": "Number of packets per second to inject"
  },
  "wep_timeout": {
    "type": "number",
    "default": 600,
    "description": "Seconds to wait for each WEP attack (0 for endless)"
  },
  "chopchop": {
    "type": "bool",
    "default": true,
    "description": "Use chopchop attack"
  },
  "arpreplay": {
    "type": "bool",
    "default": true,
    "description": "Use arpreplay attack"
  },
  "fragmentation": {
    "type": "bool",
    "default": true,
    "description": "Use fragmentation attack"
  },
  "caffelatte": {
    "type": "bool",
    "default": true,
    "description": "Use caffe-latte attack"
  },
  "p0841": {
    "type": "bool",
    "default": true,
    "description": "Use -p0841 attack"
  },
  "hirte": {
    "type": "bool",
    "default": true,
    "description": "Use hirte (cfrag) attack"
  },
  "stop_on_fakeauth_failure": {
    "type": "bool",
    "default": false,
    "description": "Stop attack if fake authentication fails"
  },
  "wep_ivs_threshold": {
    "type": "number",
    "default": 10000,
    "description": "Start cracking when number of IVs surpasses this number"
  },
  "cap_save_dir": {
    "type": "string",
    "default": "off",
    "description": "Directory to save .cap files (e.g., '/tmp/caps', 'off')",
    "enum": [
      "off",
      "manual"
    ]
  },
  "target_wps_only": {
    "type": "bool",
    "default": false,
    "description": "Only target WPS networks"
  },
  "wps_timeout": {
    "type": "number",
    "default": 660,
    "description": "Max wait for new retry before giving up (0: never)"
  },
  "wps_ratio": {
    "type": "number",
    "default": 0,
    "description": "Min ratio of successful PIN attempts/total tries"
  },
  "wps_max_retries": {
    "type": "number",
    "default": 0,
    "description": "Max number of retries for same PIN before giving up"
  },
  "check_capfile": {
    "type": "string",
    "default": "",
    "description": "Check capfile for handshakes (e.g., '/path/to/cap.pcap')"
  },
  "display_cracked": {
    "type": "bool",
    "default": false,
    "description": "Display previously-cracked access points"
  },
  "upgrade_check": {
    "type": "bool",
    "default": false,
    "description": "Checks for new version"
  },
  "update_check": {
    "type": "bool",
    "default": false,
    "description": "Checks for new version"
  }
}
