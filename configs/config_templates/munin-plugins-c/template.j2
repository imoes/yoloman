# /etc/munin/plugins.d/munin-plugins-c.conf
# Configuration for munin-plugins-c unified plugin binary
# This file is self-documenting: every directive is preceded by its
# schema description and source variable name for clarity.

# List of plugins to enable in the munin-plugins-c binary.
# The binary is symlinked into /etc/munin/plugins/ with the plugin name.
# This file controls which internal plugins are active when called.
# Variable: plugins (list of strings)
{% for plugin in (plugins | default(['cpu', 'memory', 'df', 'load', 'interfaces'])) %}
{{ plugin }}
{% endfor %}

# Optional: General runtime settings for the munin-plugins-c binary.
# These can be overridden by specific plugin configs if needed.

# Set the timeout for plugin execution in seconds.
# Variable: timeout (integer)
# munin_plugins_c_timeout={{ timeout | default(10) }}

# Set the user to run the plugins as (if not running as root).
# Variable: user (string)
# munin_plugins_c_user={{ user | default('munin') }}

# Set the group to run the plugins as.
# Variable: group (string)
# munin_plugins_c_group={{ group | default('munin') }}