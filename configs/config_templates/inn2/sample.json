{
  "organization": "Acme News Network",
  "server_fqdn": "news.acme.example.com",
  "domain": "acme.example.com",
  "from_host": "news.acme.example.com",
  "path_host": "news.acme.example.com!not-for-mail",
  "complaints_email": "newsmaster@acme.example.com",
  "moderator_mailer": "%s@moderators.example.com",
  "nntp_port": 119,
  "bind_address": "",
  "bind_address6": "",
  "spool_dir": "/var/spool/news",
  "log_dir": "/var/log/news",
  "storage_method": "tradSpool",
  "enable_overview": true,
  "overview_method": "tradindexed",
  "article_cutoff_days": 14,
  "max_article_size": 5000000,
  "local_max_article_size": 1000000,
  "max_to_post": 10,
  "check_included_text": false,
  "spool_first": false,
  "max_connections": 200,
  "client_timeout": 600,
  "peer_timeout": 3600,
  "reader_slave": false,
  "allow_newnews": false,
  "allow_ihave": true,
  "log_art_size": true,
  "log_ip_addr": true,
  "nntp_act_sync": 200,
  "want_trash": false,
  "extra_config": [
    {
      "key": "hiscachesize",
      "value": "256",
      "comment": "History cache size in KB; larger values reduce disk I/O on busy servers"
    },
    {
      "key": "nntplinklog",
      "value": "false",
      "comment": "Disable per-article peer link logging to keep news.notice concise"
    }
  ]
}
