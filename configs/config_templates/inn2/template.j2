# =============================================================================
# INN2 (InterNetNews) Configuration Template
# =============================================================================
# This file configures the INN news server daemon (innd) and related components.
# It is automatically generated by Ansible. Do not edit manually.
# =============================================================================

SHELL=/bin/sh
PATH=/usr/lib/news/bin:/sbin:/bin:/usr/sbin:/usr/bin

# =============================================================================
# Cron Jobs for News Management
# =============================================================================
# Expire old news and overview entries nightly, generate reports.
15 4	* * * 	news	test -x /usr/lib/news/bin/news.daily && news.daily expireover lowmark delayrm

# Refresh the cached IP addresses every day.
2 3	* * *	news	[ -x /usr/sbin/ctlinnd ] && ctlinnd -t 300 -s reload incoming.conf "flush cache"

# Every hour, run an rnews -U. This is not only for UUCP sites, but
# also to process queued up articles put there by nnrpd in case
# innd wasn't accepting any articles.
10 *	* * *	news	[ -x /usr/bin/rnews ] && rnews -U

# Enable this entry to send posted news back to your upstream provider.
# Also edit /etc/news/nntpsend.ctl !
# Not if you use innfeed, of course.
#*/15 *  	* * *	news	nntpsend

# Enable this if you want to send news by uucp to your provider.
# Also edit /etc/news/send-uucp.cf !
#22 *  	* * * 	news	send-uucp.pl

# =============================================================================
# NINPATHS Configuration
# =============================================================================
# To enable ninpaths please add this line to /etc/news/newsfeeds:
#   inpaths!:*:Tc,WP:/usr/lib/news/bin/ginpaths2
#
#6 6	* * *	news	ctlinnd -s -t 60 flush inpaths!
#8 6	1 * *	news	sendinpaths

# =============================================================================
# INN Server Global Settings
# =============================================================================

# Organization name shown in Newsgroups headers of locally posted articles
organization = {{ organization | default('Example News Organization') }}

# Fully qualified domain name of this news server, used in NNTP banners and Path headers
server_fqdn = {{ server_fqdn | default('news.example.com') }}

# DNS domain used to qualify bare hostnames appearing in article headers
domain = {{ domain | default('example.com') }}

# Hostname placed in the From header of articles posted through this server
from_host = {{ from_host | default('news.example.com') }}

# Token inserted into the Path header to identify this server in the article propagation chain
path_host = {{ path_host | default('news.example.com') }}

# E-mail address published for abuse and spam complaints; also serves as the postmaster contact
complaints_email = {{ complaints_email | default('newsmaster@example.com') }}

# E-mail address template for contacting newsgroup moderators; INN replaces %s with the group name (dots converted to hyphens)
moderator_mailer = {{ moderator_mailer | default('%s@moderators.example.com') }}

# =============================================================================
# Network Configuration (innd)
# =============================================================================

# TCP port innd listens on for NNTP connections; 119 is the standard plain-text port, 563 is used for NNTPS
nntp_port = {{ nntp_port | default(119) }}

# IPv4 address innd binds to; leave empty to accept connections on all network interfaces
bind_address = {{ bind_address | default('') }}

# IPv6 address innd binds to; leave empty to accept connections on all network interfaces
bind_address6 = {{ bind_address6 | default('') }}

# =============================================================================
# Storage and Logging Configuration
# =============================================================================

# Root directory of the news spool filesystem; all article storage subdirectories are created here — place on a dedicated partition for production
spool_dir = {{ spool_dir | default('/var/spool/news') }}

# Directory where INN writes news.notice, news.err, and other operational log files
log_dir = {{ log_dir | default('/var/log/news') }}

# Article storage back-end: tradSpool (one file per article in a hierarchy), CNFS (cyclic buffer, fixed size), timehash, or timecaf
storage_method = {{ storage_method | default('tradSpool') }}

# Build and maintain the overview (NOV) database; required for XOVER/OVER support used by virtually all news reader clients
enable_overview = {{ enable_overview | default(True) }}

# Overview storage driver: tradindexed (one index file per group, simple), buffindexed (shared buffer pool, faster), or ovdb (Berkeley DB, scalable)
overview_method = {{ overview_method | default('tradindexed') }}

# =============================================================================
# Article Processing Limits
# =============================================================================

# Reject articles whose Date header is older than this many days; set to 0 to disable age-based rejection
article_cutoff_days = {{ article_cutoff_days | default(10) }}

# Maximum accepted article size in bytes including all headers for incoming feed articles; 0 means unlimited
max_article_size = {{ max_article_size | default(1000000) }}

# Maximum article size in bytes for articles submitted by locally connected NNTP posting clients
local_max_article_size = {{ local_max_article_size | default(1000000) }}

# Maximum number of articles a single NNTP session may post before the connection is terminated
max_to_post = {{ max_to_post | default(5) }}

# Reject followup articles where the ratio of quoted text to new text is too high; reduces content-free quote-only posts
check_included_text = {{ check_included_text | default(False) }}