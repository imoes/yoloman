!
! OpenGGSN (osmo-ggsn) configuration
! Generated by Ansible.
!
! This template configures the GPRS Gateway Support Node (GGSN) for the
! Osmocom GSM/UMTS/LTE core network. It defines APNs for IPv4, IPv6,
! and dual-stack (IPv4/IPv6) traffic, along with tunnel device management
! and logging settings.
!

!
! Logging Configuration
! Controls verbosity and output formatting for system logs.
!
log stderr
logging color 1
logging print category-hex 0
logging print category 1
logging timestamp 0
logging print file basename last
logging print level 1
logging level ip info
logging level tun info
logging level ggsn info
logging level sgsn notice
logging level icmp6 notice
logging level lglobal notice
logging level llapd notice
logging level linp notice
logging level lmux notice
logging level lmi notice
logging level lmib notice
logging level lsms notice
logging level lctrl notice
logging level lgtp info
logging level lstats notice
logging level lgsup notice
logging level loap notice
logging level lss7 notice
logging level lsccp notice
logging level lsua notice
logging level lm3ua notice
logging level lmgcp notice

!
! Statistics Collection Interval
! Interval (in seconds) for collecting internal statistics counters.
!
stats interval {{ stats_interval | default(5) }}

!
! VTY Line Configuration
! Telnet/SSH interface for administrative access.
!
line vty
 no login

!
! GGSN Instance Configuration
! Main block for GGSN parameters, including GTP control plane binding
! and Access Point Name (APN) definitions.
!
ggsn ggsn0

    !
   ! GTP Control Plane Binding
    ! IP address to bind the GTP-C (GPRS Tunnelling Protocol Control) interface.
    !
    gtp state-dir /var/lib/osmocom/osmo-ggsn
    gtp bind-ip {{ bind_ip | default('127.0.0.2') }}

    !
    ! APN: internet (IPv4 Only)
    ! Default APN for standard IPv4 mobile data sessions.
    !
    apn internet
        gtpu-mode tun
        !
        ! Tunnel Device Name (IPv4)
        ! Name of the network tunnel device used for this APN.
        !
        tun-device {{ tun_device_v4 | default('tun4') }}
        type-support v4
        mtu default apply
        !
        ! IPv4 Dynamic IP Prefix
        ! CIDR prefix from which IP addresses are allocated to subscribers.
        !
        ip prefix dynamic {{ ipv4_prefix | default('172.16.222.0/24') }}
        !
        ! IPv4 DNS Servers
        ! Primary and secondary DNS resolvers provided to subscribers.
        !
        ip dns 0 {{ ipv4_dns_0 | default('8.8.8.8') }}
        ip dns 1 {{ ipv4_dns_1 | default('8.8.4.4') }}
        !
        ! IPv4 Ifconfig Address
        ! Local address/prefix for the tunnel interface.
        !
        ip ifconfig {{ ipv4_ifconfig | default('172.16.222.0/24') }}
        no shutdown

    !
    ! APN: inet6 (IPv6 Only)
    ! APN for IPv6-only mobile data sessions.
    !
    apn inet6
        gtpu-mode tun
        !
        ! Tunnel Device Name (IPv6)
        !
        tun-device {{ tun_device_v6 | default('tun6') }}
        type-support v6
        mtu default apply
        !
        ! IPv6 Dynamic Prefix
        !
        ipv6 prefix dynamic {{ ipv6_prefix | default('2001:780:44:2000:0:0:0:0/56') }}
        !
        ! IPv6 DNS Servers
        !
        ipv6 dns 0 {{ ipv6_dns_0 | default('2001:4860:4860::8888') }}
        ipv6 dns 1 {{ ipv6_dns_1 | default('2001:4860:4860::8844') }}
        !
        ! IPv6 Ifconfig Address
        !
        ipv6 ifconfig {{ ipv6_ifconfig | default('2001:780:44:2000:0:0:0:0/56') }}
        no shutdown

    !
    ! APN: inet46 (Dual-Stack IPv4/IPv6)
    ! APN for sessions requiring both IPv4 and IPv6 connectivity.
    !
    apn inet46
        gtpu-mode tun
        !
        ! Tunnel Device Name (Dual-Stack)
        !
        tun-device {{ tun_device_v4v6 | default('tun46') }}
        type-support v4v6
        mtu default apply

        !
        ! IPv4 Configuration for Dual-Stack
        !

        !
        ! IPv4 Dynamic Prefix
        !
        ip prefix dynamic {{ ipv4_prefix_46 | default('172.16.46.0/24') }}
        !
        ! IPv4 DNS Servers
        !
        ip dns 0 {{ ipv4_dns_0_46 | default('8.8.8.8') }}
        ip dns 1 {{ ipv4_dns_1_46 | default('8.8.4.4') }}
        !
        ! IPv4 Ifconfig Address
        !
        ip ifconfig {{ ipv4_ifconfig_46 | default('172.16.46.0/24') }}

        !
        ! IPv6 Configuration for Dual-Stack
        !

        !
        ! IPv6 Dynamic Prefix
        !
        ipv6 prefix dynamic {{ ipv6_prefix_46 | default('2001:780:44:2100:0:0:0:0/56') }}
        !
        ! IPv6 DNS Servers
        !
        ipv6 dns 0 {{ ipv6_dns_0_46 | default('2001:4860:4860::8888') }}
        ipv6 dns 1 {{ ipv6_dns_1_46 | default('2001:4860:4860::8844') }}
        !
        ! IPv6 Ifconfig Address
        !
        ipv6 ifconfig {{ ipv6_ifconfig_46 | default('2001:780:44:2100:0:0:0:0/56') }}
        no shutdown

    !
    ! Default APN
    ! Marks the 'internet' APN as the default for sessions without explicit APN selection.
    !
    default-apn internet
    no shutdown ggsn
