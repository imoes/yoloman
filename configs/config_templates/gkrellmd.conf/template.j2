[# Global settings]
port = {{ server_port }}
# Enable/disable server (1=enabled, 0=disabled)
enabled = {{ server_enabled }}
# Log file path (empty string for stderr)
log_file = {{ log_file }}
# Logging verbosity level (0=silent, 1=errors only, 2=warnings+errors, 3=info+, 4=debug)
log_level = {{ log_level }}

[# Authentication]
# Require authentication (1=enabled, 0=disabled)
auth_required = {{ auth_required }}
# Comma-separated list of usernames with full access
admins = {{ admins | join(', ') }}
# Comma-separated list of usernames with read-only access
viewers = {{ viewers | join(', ') }}

[# SSL/TLS (optional)]
# Enable SSL (1=enabled, 0=disabled)
ssl_enabled = {{ ssl_enabled }}
# SSL certificate chain file
ssl_cert = {{ ssl_cert }}
# SSL private key file
ssl_key = {{ ssl_key }}
# CA certificate for client verification (optional)
ssl_ca_cert = {{ ssl_ca_cert }}

[# Server binding]
# Bind to specific hostname/IP (empty = all interfaces)
bind_hostname = {{ bind_hostname }}

[# Client session timeout (seconds)]
timeout = {{ timeout }}

[# Plugins and monitoring]
# Comma-separated list of plugin modules to load (plugin names)
plugins = {{ plugins | join(', ') }}

[# Disk monitoring options]
# Comma-separated list of disk devices to monitor explicitly (leave empty for auto)
disks = {{ disks | join(', ') }}

[# SNMP monitoring (optional)]
# Enable SNMP (1=enabled, 0=disabled)
snmp_enabled = {{ snmp_enabled }}
# SNMP community string (use 'public' for default read-only)
snmp_community = {{ snmp_community }}

[# Mail alerts (optional)]
# Comma-separated list of recipient email addresses
mail_recipients = {{ mail_recipients | join(', ') }}
# SMTP server hostname
mail_server = {{ mail_server }}
# SMTP port (default 25)
mail_port = {{ mail_port }}
# Enable TLS for SMTP (1=enabled, 0=disabled)
mail_tls = {{ mail_tls }}
# Sender email address
mail_from = {{ mail_from }}
