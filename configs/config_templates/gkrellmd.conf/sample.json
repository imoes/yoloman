{
  "server_port": 19100,
  "server_enabled": true,
  "log_file": "/var/log/gkrellmd.log",
  "log_level": 2,
  "auth_required": true,
  "admins": [
    "admin",
    "sysadmin"
  ],
  "viewers": [
    "guest"
  ],
  "ssl_enabled": true,
  "ssl_cert": "/etc/ssl/certs/gkrellmd.crt",
  "ssl_key": "/etc/ssl/private/gkrellmd.key",
  "ssl_ca_cert": "",
  "bind_hostname": "127.0.0.1",
  "timeout": 300,
  "plugins": [
    "core",
    "hddtemp"
  ],
  "disks": [
    "nvme0n1"
  ],
  "snmp_enabled": false,
  "snmp_community": "public",
  "mail_recipients": [
    "ops@example.com",
    "admin@example.com"
  ],
  "mail_server": "smtp.example.com",
  "mail_port": 587,
  "mail_tls": true,
  "mail_from": "gkrellmd@example.com"
}
