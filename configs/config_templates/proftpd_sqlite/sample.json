{
 "access_rules": [
  {
   "allow_operations": [
    "ALL"
   ],
   "deny_operations": [],
   "description": "Admin full access",
   "user": "admin"
  },
  {
   "allow_operations": [
    "STOR",
    "NLST"
   ],
   "deny_operations": [
    "DELE",
    "MKD",
    "LIST"
   ],
   "description": "Upload-only users",
   "group": "uploaders"
  }
 ],
 "allow_groups": [
  "ftpusers"
 ],
 "daemon_group": "proftpd",
 "daemon_user": "proftpd",
 "include_dir": "/etc/proftpd/conf.d",
 "listen_address": "0.0.0.0",
 "log_dir": "/var/log/proftpd",
 "log_file": "/var/log/proftpd/access.log",
 "max_conn_per_ip": 2,
 "passive_ports_end": 50100,
 "passive_ports_start": 50000,
 "port": 21,
 "quotas_enabled": "",
 "require_valid_shell": false,
 "server_name": "MySecureFTP",
 "sqlite_path": "/etc/proftpd/ftpd.db",
 "timeout_idle": 900,
 "timeout_nolisten": 180,
 "tls_cert": "/etc/ssl/certs/proftpd.crt",
 "tls_enabled": true,
 "tls_key": "/etc/ssl/private/proftpd.key",
 "umask": "022"
}
