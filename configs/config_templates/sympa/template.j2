#
# Ansible-enriched rsyslog configuration for Sympa
# Self-documenting template: every directive is commented with its source description.
#

# Path to the sympa log file (default: /var/log/sympa.log)
:programname, contains, "sympa"         {{ log_file_path | default('/var/log/sympa.log') }}
# Path to the archived log file (default: /var/log/sympa.log)
:programname, contains, "archived"      {{ log_file_path | default('/var/log/sympa.log') }}
# Path to the bounced log file (default: /var/log/sympa.log)
:programname, contains, "bounced"       {{ log_file_path | default('/var/log/sympa.log') }}
# Path to the bulk log file (default: /var/log/sympa.log)
:programname, contains, "bulk"          {{ log_file_path | default('/var/log/sympa.log') }}
# Path to the task_manager log file (default: /var/log/sympa.log)
:programname, contains, "task_manager"  {{ log_file_path | default('/var/log/sympa.log') }}
