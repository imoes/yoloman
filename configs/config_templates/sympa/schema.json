{
  "static_content_path": {
    "type": "string",
    "default": "/usr/share/sympa/static_content",
    "description": "Document root path for static content"
  },
  "css_path": {
    "type": "string",
    "default": "/var/lib/sympa/css",
    "description": "Path to CSS assets"
  },
  "pictures_path": {
    "type": "string",
    "default": "/var/lib/sympa/pictures",
    "description": "Path to picture assets"
  },
  "wwsympa_hostname": {
    "type": "string",
    "default": "localhost",
    "description": "Hostname for the wwsympa FCGI socket"
  }
}
