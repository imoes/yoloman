# quvi configuration file
# Generated by Ansible/Template Engine
#
# This template configures the Quvi media downloader.
# Quvi uses a simple INI-style configuration file.
#
# Variables used:
#   - timeout: Network timeout in seconds (integer)
#   - verbose: Enable verbose logging (boolean)
#   - config_path: Path to this config file (string)
#   - script_dirs: List of directories for Lua scripts (list of strings)

[global]
# Global network timeout in seconds for fetching stream properties.
# Specifies how long quvi should wait for network responses.
# Default: 30 seconds.
timeout = {{ timeout | default(30) }}

# Enable verbose logging and configuration parsing output.
# When true, quvi prints detailed logs during operation.
# Default: false (boolean)
verbose = {{ verbose | default(false) }}

# The canonical path to the main configuration file.
# Note: This is typically controlled via env var QUVI_CONFIG, but can be referenced here for clarity in generation.
# This field is mostly informational in the context of the runtime config itself, but allows explicit path definition.
# Default: '/etc/quvi/quvirc'
config_path = {{ config_path | default('/etc/quvi/quvirc') }}

[scripts]
# Directories where quvi searches for media parsing scripts (lua scripts).
# Items is a flat list of strings representing paths.
# Default: ['/usr/lib/quvi/scripts', '/usr/local/lib/quvi/scripts']
# The output is formatted as a list of quoted strings.
script_dirs = [
{% for dir in script_dirs | default(['/usr/lib/quvi/scripts', '/usr/local/lib/quvi/scripts']) %}
    "{{ dir }}",
{% endfor %}
]