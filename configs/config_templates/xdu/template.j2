!
! XDu Resources - Enriched Configuration Template
!
! This file configures the appearance and behavior of XDu, an X11-based file manager.
! Variables are sourced from the Ansible role's variables. Every setting has a safe
! default as specified in the schema.
!
! I recommend the "-*-helvetica-bold-r-normal--14-*" font, but if
!   you don't have it, or want your server default, then change it
!   or comment it out respectively.
! Order choices: first, last, alpha, ralpha, size, rsize
! Color to taste.
!

! Foreground color for the main window.
!*foreground:		{{ foreground_color | default('yellow') }}

! Background color for the main window.
!*background:		{{ background_color | default('blue4') }}

! Foreground color for help text.
!*help*foreground:	{{ help_foreground_color | default('green') }}

! Background color for help text.
!*help*background:	{{ help_background_color | default('red4') }}

! Width of the XDu window in pixels.
*window.Width:		{{ window_width | default(600) }}

! Height of the XDu window in pixels.
*window.Height:		{{ window_height | default(480) }}

! X11 font family string for the application.
!*Font:			{{ font_family | default('-*-helvetica-bold-r-normal--14-*') }}

! Number of columns in the view.
!*Ncol:			{{ number_of_columns | default(5) }}

! Whether to show file sizes in the view.
!*ShowSize:		{{ show_size | default(True) }}

! Sorting order for files (first, last, alpha, ralpha, size, rsize).
!*Order:			{{ order_type | default('first') }}