# Default user directory names (UTF-8) for XDG User Dirs
# https://www.freedesktop.org/wiki/Software/xdg-user-dirs/

# These are the default names for user directories (e.g. Desktop, Documents)
# and their fallback locales. They may be overridden by ~/.config/user-dirs.dirs

# The XDG standard defines these directories:
# - DESKTOP: Desktop directory
# - DOWNLOAD: Downloads directory
# - TEMPLATES: Template files directory
# - PUBLICSHARE: Public share directory
# - DOCUMENTS: Documents directory
# - MUSIC: Music directory
# - PICTURES: Pictures directory
# - VIDEOS: Videos directory

DESKTOP=Desktop
DOWNLOAD=Downloads
TEMPLATES=Templates
PUBLICSHARE=Public
DOCUMENTS=Documents
MUSIC=Music
PICTURES=Pictures
VIDEOS=Videos

# Optional: enable or disable special handling for relative paths
# (usually left disabled for maximum portability)
XDG_ENABLE_RELATIVE_PATHS={{ xdg_enable_relative_paths | string | lower }}
