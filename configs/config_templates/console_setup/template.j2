# ============================================================================
# /etc/default/console-setup - System-wide console configuration
# ============================================================================
#
# This file configures the Linux console (TTY) properties, including fonts,
# keyboard layouts (keymaps), character encoding, and display behavior.
#
# Self-documenting: All variables are resolved with safe defaults derived from
# the schema to prevent rendering errors or unintended configuration drift.
# ============================================================================

# ---------------------------------------------------------------------------
# FONT CONFIGURATION
# ---------------------------------------------------------------------------

# Font to use for the console.
# Description: Console font face name (e.g., 'Lat2-Terminus16', 'VGA8x16', 'Fixed')
# Default: Lat2-Terminus16
FONTFACE="{{ fontface | default('Lat2-Terminus16') }}"

# Font size in points or 'WxH' format.
# Description: Font size in points or 'WxH' format (e.g., '16', '8x16'). Must match the selected font.
# Default: 16
FONTSIZE="{{ fontsize | default('16') }}"

# Character encoding used on the console.
# Description: Character encoding used on the console (e.g., 'UTF-8', 'ISO-8859-1', 'CP850')
# Default: UTF-8
CODEPAGE="{{ codepage | default('UTF-8') }}"

# ---------------------------------------------------------------------------
# KEYBOARD CONFIGURATION (KEYMAP)
# ---------------------------------------------------------------------------

# Keyboard layout identifier.
# Description: Keyboard layout identifier (e.g., 'us', 'de', 'fr', 'uk').
# Default: us
KEYMAP="{{ keymap | default('us') }}"

# Keyboard layout variant.
# Description: Keyboard layout variant (e.g., 'dvorak', 'colemak', 'intl'). Leave empty for default variant.
# Default: (empty)
# Note: An empty string means the default variant for the selected keymap is used.
VARIANT="{{ variant | default('') }}"

# Compose key.
# Description: Key to use as Compose (e.g., 'RightAlt', 'CapsLock'). Leave empty to disable.
# Default: (empty)
# Note: An empty string disables the compose key functionality.
COMPOSE_KEY="{{ compose_key | default('') }}"

# ---------------------------------------------------------------------------
# TERMINAL & DISPLAY BEHAVIOR
# ---------------------------------------------------------------------------

# Terminal type string (TERM).
# Description: Terminal type string (TERM) reported to applications (e.g., 'linux', 'xterm', 'vt220').
# Default: linux
TERMTYPE="{{ termtype | default('linux') }}"

# Keymap warning control.
# Description: Set to 'true' to enable warnings for missing keymap files, or 'false' to silence them.
# Default: false
# Note: Useful for debugging, but 'false' is preferred for production stability.
WARN_ABOUT_MISSING_KEYMAP="{{ warn_about_missing_keymap | default('false') }}"

# Additional font search paths.
# Description: Colon-separated list of additional font directories (e.g., '/usr/share/fonts/:/usr/local/share/fonts/').
# Default: (empty)
# Note: If empty, the system uses standard locations only.
FONTPATHS="{{ fontpaths | default('') }}"

# Unicode glyph fallback.
# Description: Set to 'true' to enable Unicode fallback rendering for missing glyphs, or 'false' to disable.
# Default: true
# Note: Improves display of mixed-script text when the primary font lacks glyphs.
UNICODE_FALLBACK="{{ unicode_fallback | default('true') }}"

# Screen blanking timeout.
# Description: Number of minutes of inactivity before the screen blanks (0 = never blank).
# Default: 0
# Note: Set to 0 to disable screen blanking entirely.
INACTIVE_MINUTES="{{ inactive_minutes | default('0') }}"

# Boot splash screen.
# Description: Set to 'true' to enable the boot splash logo, or 'false' to disable it.
# Default: true
SPLASH="{{ splash | default('true') }}"

# Hardware cursor.
# Description: Set to 'true' to enable the hardware cursor, or 'false' to use software cursor.
# Default: true
# Note: Hardware cursors are generally faster but may be unsupported on some virtual terminals.
HWCURSOR="{{ hwcursor | default('true') }}"