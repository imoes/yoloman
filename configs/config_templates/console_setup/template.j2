# /etc/default/console-setup - System-wide console configuration
# Sets the console font, character set, keymap, and other terminal behaviors

# Font to use for the console (e.g., 'Lat2-Terminus16', 'VGA8x16')
FONTFACE="{{ fontface }}"

# Font size (points); must match the font (e.g., '16', '14', '8x16')
FONTSIZE="{{ fontsize }}"

# Character encoding for the console (e.g., 'UTF-8', 'ISO-8859-1')
CODEPAGE="{{ codepage }}"

# Keyboard layout (e.g., 'us', 'de', 'fr-latin1')
KEYMAP="{{ keymap }}"

# Optional: Combine keymap with a variant (e.g., 'dvorak', 'colemak')
# Leave empty to use the default variant of the keymap
VARIANT="{{ variant | default('') }}"

# Optional: Compose key behavior (e.g., 'RightAlt' for Compose on Right Alt)
COMPOSE_KEY="{{ compose_key | default('') }}"

# Terminal type reported to applications
TERMTYPE="{{ termtype | default('linux') }}"

# Enable or disable spurious keymap warnings
# Set to 'false' to silence warnings about missing keymap files
WARN_ABOUT_MISSING_KEYMAP="{{ warn_about_missing_keymap | default('false') }}"

# Optional: Additional font paths (colon-separated)
# If empty, defaults to standard system font directories
FONTPATHS="{{ fontpaths | default('') }}"

# Optional: Enable Unicode fallback for missing glyphs (true/false)
UNICODE_FALLBACK="{{ unicode_fallback | default('true') }}"

# Optional: Enable screen blanking after INACTIVE_MINUTES of inactivity
# Set to 0 to disable blanking
INACTIVE_MINUTES="{{ inactive_minutes | default('0') }}"

# Optional: Enable or disable the boot splash (true/false)
SPLASH="{{ splash | default('true') }}"

# Optional: Enable or disable hardware cursor (true/false)
HWCURSOR="{{ hwcursor | default('true') }}"
