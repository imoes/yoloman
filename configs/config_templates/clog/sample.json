{
  "sections": [
    "default",
    "apache"
  ],
  "rules": [
    {
      "section": "default",
      "pattern": "warn|debug",
      "is_regex": true,
      "color": "yellow",
      "action": "line"
    },
    {
      "section": "default",
      "pattern": "error|severe",
      "is_regex": true,
      "color": "red",
      "action": "line"
    },
    {
      "section": "default",
      "pattern": "critical",
      "is_regex": true,
      "color": "bold red",
      "action": "line"
    },
    {
      "section": "default",
      "pattern": "critical",
      "is_regex": true,
      "color": "default",
      "action": "blank"
    },
    {
      "section": "default",
      "pattern": "ignore",
      "is_regex": true,
      "color": "default",
      "action": "suppress"
    },
    {
      "section": "apache",
      "pattern": " 2[0-9][0-9] ",
      "is_regex": true,
      "color": "green",
      "action": "match"
    },
    {
      "section": "apache",
      "pattern": " 3[0-9][0-9] ",
      "is_regex": true,
      "color": "yellow",
      "action": "match"
    },
    {
      "section": "apache",
      "pattern": " 4[0-9][0-9] ",
      "is_regex": true,
      "color": "red",
      "action": "match"
    },
    {
      "section": "apache",
      "pattern": " 5[0-9][0-9] ",
      "is_regex": true,
      "color": "bold red",
      "action": "match"
    }
  ]
}
