[server]
# Enable server mode to accept client connections
server = {{ server_enabled }}

# IP address the server listens on (e.g., '0.0.0.0' for all interfaces)
bind = {{ server_bind_address }}

# TCP port for EIBD-compatible client connections
client_port = {{ server_client_port }}

[server-tunnel]
# Enable tunneling server (allows KNXnet/IP tunneling)
tunnel = {{ tunnel_enabled }}

# IP address for tunneling (typically same as server bind address)
tunnel_bind = {{ tunnel_bind_address }}

# TCP port for KNXnet/IP tunneling (default 3671)
tunnel_port = {{ tunnel_port }}

[server-router]
# Enable router mode (for forwarding KNX multicast frames)
router = {{ router_enabled }}

[bus]
# Type of physical interface connected (e.g., 'usb', 'tpuarts', 'ip', 'knxip')
type = {{ bus_type }}

# Device path for local interfaces (e.g., '/dev/ttyUSB0', '/dev/ttyUSB1')
device = {{ bus_device }}

# Hostname or IP address for remote IP connections (used with 'ip' or 'knxip' types)
remote = {{ bus_remote }}

# Optional: local KNX individual address (in format 'a.b.c'; default auto-assigned)
# If omitted, the daemon assigns one automatically
# local = {{ bus_local }}

# Optional: baud rate for serial devices (e.g., 9600 for TP-UART)
baud = {{ bus_baud }}

[security]
# Enable password protection for server access (not recommended for local-only setups)
password = {{ security_password_enabled }}

# SHA-1 hashed password for server access (e.g., 'sha1$hexhash' — generated via knxd-passwd)
hash = {{ security_password_hash }}

[logging]
# Log level: 0=none, 1=fatal, 2=error, 3=warning, 4=info, 5=debug, 6=trace
level = {{ log_level }}

# Log destination: 'syslog', 'file', or 'stdout'
destination = {{ log_destination }}

# File path for log output (used only if destination='file')
file = {{ log_file_path }}

# Enable timestamping in logs
timestamp = {{ log_timestamp }}

[groups]
# Optional: group addresses to monitor (comma-separated list or range)
# monitor = {{ monitor_groups | join(', ') }}
