# osmo-mgw configuration — generated by template
# Enable logging to syslog
global
  log syslog
  level all debug
  color
  timestamp
  
# Bind control interface to specified host and port
mgcp
  bind-address {{ mgcp.bind_address }}
  
  # UDP port for MGCP endpoint
  port {{ mgcp.port }}
  
  # Reboot timeout (seconds)
  reboot-timeout {{ mgcp.reboot_timeout }}
  
  # RTP bridge mode
  rtp-bridge {{ 'enabled' if mgcp.rtp_bridge else 'disabled' }}
  
  # Media gateway endpoint address (for remote MGCP endpoints)
  endpoint-address {{ mgcp.endpoint_address }}
  
  # Local RTP port range for media
  rtp-port-range {{ mgcp.rtp_port_range.start }} {{ mgcp.rtp_port_range.end }}
  
  # Repeat blocks: configured endpoints (e.g., BTS or BSC connections)
{% for endpoint in mgcp.endpoints %}  endpoint {{ endpoint.name }} {{ endpoint.code }}
    rtp {{ 'bind' if endpoint.rtp_bind else 'no-bind' }}
    mode {{ endpoint.mode }}
    codec {{ endpoint.codec }}
    tone {{ 'on' if endpoint.tone else 'off' }}
{% endfor %}
  
  # Optional: custom SDP origin (default is 0 0 IN IP4 0.0.0.0)
{% if mgcp.sdp_origin %}  sdp-origin {{ mgcp.sdp_origin }}
{% endif %}
  
  # CRCX/TLCX/TFCX timeout (seconds)
  crcx-timeout {{ mgcp.crcx_timeout }}
  tlcx-timeout {{ mgcp.tlcx_timeout }}
  tfcx-timeout {{ mgcp.tfcx_timeout }}
  
  # Allow media transcoding?
  transcoding {{ 'enabled' if mgcp.transcoding else 'disabled' }}
  
  # Use legacy SDP format?
  legacy-sdp {{ 'enabled' if mgcp.legacy_sdp else 'disabled' }}
  
# Optional: custom loopback address for testing
{% if mgcp.loopback_address %}mgcp-loopback
  bind-address {{ mgcp.loopback_address }}
{% endif %}