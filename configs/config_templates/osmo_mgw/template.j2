# osmo-mgw configuration — generated by template
# This file configures the OpenBSC Media Gateway (MGCP) endpoint.
# It controls how the gateway binds to network interfaces, handles
# real-time protocol (RTP) media streams, and defines endpoint
# profiles for BTS/BSC connections.

# Global logging settings for the daemon.
global
  # Enable logging to the system syslog daemon.
  log syslog
  # Set the default log level (debug for verbose troubleshooting).
  level all debug
  # Enable colored output if the terminal supports it.
  color
  # Include timestamps in log entries.
  timestamp

# MGCP-specific configuration block.
# Controls the MGCP protocol listener and media handling parameters.
{% set _mgcp = mgcp | default({}) %}
mgcp
  # Bind control interface to specified host and port.
  # If bind_address is not specified or empty, the system defaults
  # to listening on all interfaces (0.0.0.0).
  bind-address {{ _mgcp.bind_address | default('0.0.0.0') }}

  # UDP port for MGCP endpoint.
  # Standard MGCP port is 2427.
  port {{ _mgcp.port | default(2427) }}

  # Reboot timeout (seconds).
  # Time to wait for a media gateway to reboot before timing out.
  reboot-timeout {{ _mgcp.reboot_timeout | default(10) }}

  # RTP bridge mode.
  # 'enabled' allows bridging of media streams within the gateway.
  rtp-bridge {{ 'enabled' if _mgcp.rtp_bridge | default(false) else 'disabled' }}

  # Media gateway endpoint address (for remote MGCP endpoints).
  # Used if the gateway acts as a proxy or needs to reach a specific
  # remote MGCP master controller.
  # If not specified, the default behavior is used by the daemon.
  {% if _mgcp.endpoint_address | default('') != '' %}
  endpoint-address {{ _mgcp.endpoint_address | default('') }}
  {% endif %}

  # Local RTP port range for media.
  # Defines the start and end of the UDP port range used for RTP
  # audio/video streams.
  rtp-port-range {{ (_mgcp.rtp_port_range | default({})).start | default(30000) }} {{ (_mgcp.rtp_port_range | default({})).end | default(31000) }}

  # Repeat blocks: configured endpoints (e.g., BTS or BSC connections).
  # Each endpoint represents a logical connection to a Base Transceiver
  # Station or Base Station Controller.
  {% for endpoint in (_mgcp.endpoints | default([])) %}
  endpoint {{ endpoint.name | default('') }} {{ endpoint.code | default('') }}
    # Bind RTP to the local interface for this endpoint.
    rtp {{ 'bind' if endpoint.rtp_bind | default(true) else 'no-bind' }}
    # Operation mode for this endpoint (e.g., 'local', 'remote').
    mode {{ endpoint.mode | default('local') }}
    # Preferred codec for media transmission (e.g., 'PCMU', 'PCMA', 'AMR').
    codec {{ endpoint.codec | default('PCMU') }}
    # Enable tone generation/detection for this endpoint.
    tone {{ 'on' if endpoint.tone | default(true) else 'off' }}
  {% endfor %}

  # Optional: custom SDP origin.
  # Overrides the default SDP origin string (0 0 IN IP4 0.0.0.0).
  {% if (_mgcp.sdp_origin | default('')) != '' %}
  sdp-origin {{ _mgcp.sdp_origin | default('') }}
  {% endif %}

  # CRCX/TLCX/TFCX timeout (seconds).
  # CRCX: Create Connection timeout.
  crcx-timeout {{ _mgcp.crcx_timeout | default(10) }}
  # TLCX: Modify Connection timeout.
  tlcx-timeout {{ _mgcp.tlcx_timeout | default(10) }}
  # TFCX: Delete Connection timeout.
  tfcx-timeout {{ _mgcp.tfcx_timeout | default(10) }}

  # Allow media transcoding?
  # If enabled, the gateway can convert between different codecs.
  transcoding {{ 'enabled' if _mgcp.transcoding | default(false) else 'disabled' }}

  # Use legacy SDP format?
  # Some older MGCP implementations require a specific SDP structure.
  legacy-sdp {{ 'enabled' if _mgcp.legacy_sdp | default(false) else 'disabled' }}

# Optional: custom loopback address for testing.
# Binds a separate loopback interface for internal management or testing.
{% if (_mgcp.loopback_address | default('')) != '' %}
mgcp-loopback
  bind-address {{ _mgcp.loopback_address | default('') }}
{% endif %}