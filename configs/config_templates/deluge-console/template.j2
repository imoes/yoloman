{# Config directory location #}
{% if config_dir %}-c {{ config_dir }}{% endif %}
{# Deluge daemon IP address to connect to #}
{% if daemon_ip %}-d {{ daemon_ip }}{% endif %}
{# Deluge daemon port to connect to #}
{% if daemon_port is number %}-p {{ daemon_port }}{% endif %}
{# Deluge daemon username to use when connecting #}
{% if username %}-U {{ username }}{% endif %}
{# Deluge daemon password to use when connecting #}
{% if password %}-P {{ password }}{% endif %}
{# Logfile path (instead of stdout) #}
{% if logfile %}-l {{ logfile }}{% endif %}
{# Log level: none|info|warning|error|debug #}
{% if loglevel %}-L {{ loglevel }}{% endif %}
{# Quiet mode (same as loglevel=none) #}
{% if quiet %}-q{% endif %}
{# Logfile rotation with optional max-size (e.g., 2M) #}
{% if logrotate %}{% if logrotate == true %}--logrotate{% else %}--logrotate={{ logrotate | lower }}{% endif %}{% endif %}
{# Profile with cProfile, optional output file #}
{% if profile %}{% if profile == true %}--profile{% else %}--profile={{ profile | lower }}{% endif %}{% endif %}