{# ============================================================================== #}
{# /etc/dpkg-cross/cross-compile: Default configuration for dpkg-cross          #}
{#                                                                                #}
{# This file configures the dpkg-cross tool, which allows building Debian packages  #}
{# for foreign architectures (e.g., building ARM packages on an x86 host).       #}
{#                                                                                #}
{# See 'man dpkg-cross' or the dpkg-cross documentation for further details.     #}
{# ============================================================================== #}

{# ---------------------------------------------------------------------------- #}
{# DEFAULT_ARCH: The default target architecture for cross-compilation.         #}
{# Must be a valid Debian architecture (e.g., armhf, arm64, i386).              #}
{# ---------------------------------------------------------------------------- #}
DEFAULT_ARCH={{ default_arch | default('armhf') }}