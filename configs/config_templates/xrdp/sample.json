{
  "listen_address": "0.0.0.0",
  "rdp_port": 3389,
  "tls_enabled": true,
  "tls_level": "high",
  "disable_local_auth": false,
  "use_pam": true,
  "max_sessions": 20,
  "session_timeout": 900,
  "log_level": 3,
  "log_path": "/var/log/xrdp.log",
  "modules": {
    "Xvnc": {
      "name": "Xvnc",
      "lib": "libvnc.so",
      "value": "port=5910,username=ask,password=ask",
      "description": "VNC backend session for legacy clients"
    },
    "Xorg": {
      "name": "Xorg",
      "lib": "libxorg.so",
      "value": "username=ask,password=ask",
      "description": "Modern Xorg backend for better performance"
    }
  },
  "group_rules": {
    "rdp-users": "Xvnc,Xorg",
    "admins": "Xvnc,Xorg"
  }
}
