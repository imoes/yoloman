# do we need to start sesman? (set to 'yes' to start, anything else to not)
# note this setting is not honoured by the systemd service files
SESMAN_START={{ sesman_start }}

# command line options for sesman (none by default)
SESMAN_OPTIONS={{ sesman_options }}

# command line options for xrdp (none by default)
XRDP_OPTIONS={{ xrdp_options }}
