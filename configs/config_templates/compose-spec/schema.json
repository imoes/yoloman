{
  "format": {
    "type": "string",
    "default": "yaml",
    "description": "Output format for validation results (yaml|json)",
    "enum": [
      "yaml",
      "json"
    ]
  },
  "no_consistency": {
    "type": "bool",
    "default": false,
    "description": "Disable model consistency checking"
  },
  "no_interpolation": {
    "type": "bool",
    "default": false,
    "description": "Disable environment variable interpolation"
  },
  "no_normalization": {
    "type": "bool",
    "default": false,
    "description": "Disable compose model normalization"
  },
  "no_path_resolution": {
    "type": "bool",
    "default": false,
    "description": "Disable file path resolution"
  }
}
