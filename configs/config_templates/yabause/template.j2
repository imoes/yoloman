# ==============================================================================
# Yabause Qt Configuration File
# Generated by Jinja2 for yabause-qt
#
# This file configures the Yabause Sega Saturn emulator. All fields listed here
# correspond to command-line options or internal settings. Variables must be
# provided via the Ansible play/role inventory. Missing variables fall back to
# the schema defaults defined below.
# ==============================================================================

# --autoframeskip
# Enable or disable auto frame skipping / limiting.
# Type: boolean
# Default: False
autoframeskip={{ (autoframeskip | default(False)) | lower }}

# --autostart
# Automatically start emulation.
# Type: boolean
# Default: False
autostart={{ (autostart | default(False)) | lower }}

# --bios
# Path to the Saturn BIOS image file.
# Type: string
# Default: /home/user/saturn/bios.bin
bios={{ bios | default('/home/user/saturn/bios.bin') }}

# --cdrom
# Path to the CDROM device file.
# Type: string
# Default: /dev/cdrom
cdrom={{ cdrom | default('/dev/cdrom') }}

# --fullscreen
# Start the emulator in fullscreen.
# Type: boolean
# Default: False
fullscreen={{ (fullscreen | default(False)) | lower }}

# --iso
# Path to a Saturn game dump file (ISO or bin/cue).
# Type: string
# Default: ''
iso={{ iso | default('') }}

# --no_bios
# Use the emulated bios instead of a file.
# Type: boolean
# Default: False
no_bios={{ (no_bios | default(False)) | lower }}

# --no_sound
# Turns sound off.
# Type: boolean
# Default: False
no_sound={{ (no_sound | default(False)) | lower }}

# --autoload_slot
# Savestate slot to autoload when starting.
# Type: integer
# Default: 0
autoload_slot={{ (autoload_slot | default(0)) | int }}

# --binary
# Path to a binary file for homebrew testing (optionally :address).
# Type: string
# Default: ''
binary={{ binary | default('') }}