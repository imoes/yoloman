# claws-mail-keyword-warner plugin configuration
# WARNING: This file is only used if the plugin is manually configured
# (e.g., via Claws Mail's plugin configuration UI).
# The plugin itself does NOT read this file — it stores its settings internally
# in the Claws Mail user configuration (e.g., ~/.claws-mail/keyword_warner.cfg).
# This template is provided for documentation and configuration management only.
# All settings below are OPTIONAL and have no effect unless the plugin is configured
# to load them from an external config (not default behavior).

{% if warn_keywords is defined and warn_keywords|length > 0 %}
# Keywords triggering warnings (case-insensitive regex)
{% for kw in warn_keywords %}keyword = {{ kw | replace('\', '\\') | replace('\n', '\\n') | replace('\r', '\\r') | replace('"', '\\"') }}
{% endfor %}
{% endif %}