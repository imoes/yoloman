{
  "warn_keywords": [
    "urgent",
    "confidential",
    "urgent.*reply",
    "payment"
  ],
  "warn_all_capitals": true,
  "exclude_addresses": [
    "noreply@example.com",
    "donotreply@domain.org"
  ],
  "match_whole_word": false,
  "match_case_sensitive": false,
  "warn_subject": true,
  "warn_quote_chars": true,
  "warn_links": true
}
