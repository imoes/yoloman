# Defaults for reboot-notifier initscript
# sourced by /etc/init.d/reboot-notifier
# installed at /etc/default/reboot-notifier by the maintainer scripts

#
# This is a POSIX shell fragment
#

# Email address to notify when a reboot is required
# Defaults to root if not specified in inventory.
NOTIFICATION_EMAIL="{{ notification_email | default('root') }}"

# Path to the file indicating if a reboot is required
# This file is typically created by the `needrestart` or `update-notifier` packages.
# Defaults to /var/run/reboot-required if not specified.
REBOOT_REQUIRED="{{ reboot_required | default('/var/run/reboot-required') }}"
