#!/bin/bash

# Self-documenting reboot notifier configuration.
# Reads the path to the reboot-required flag file from the schema default
# and uses it to determine if a system restart is needed.

# Path to the file indicating if a reboot is required.
# Default: /var/run/reboot-required
REBOOT_REQUIRED={{ reboot_required | default('/var/run/reboot-required') }}

# Ensure the variable is exported so sub-shells or sourced scripts can see it.
export REBOOT_REQUIRED

if [ -s "$REBOOT_REQUIRED" -a -n "$NOTIFICATION_EMAIL" ] ; then
    # Capture the content of the reboot-required flag file.
    BODY=$(<"$REBOOT_REQUIRED")

    # Append a header for the package list to distinguish it from the flag file content.
    BODY+=$'\\nPackages requiring reboot:\\n'

    # Append the list of packages that require a reboot.
    # Note: /var/run/reboot-required.pkgs is the standard location for this list in Debian/Ubuntu.
    if [ -f /var/run/reboot-required.pkgs ]; then
        BODY+=$(</var/run/reboot-required.pkgs)
    fi

    # Send an email notification if the recipient is configured.
    # The subject includes the hostname for easy identification in the mailbox.
    echo "$BODY" | mail -s "$HOSTNAME needs a reboot" "$NOTIFICATION_EMAIL"
fi