{
  "automount": true,
  "automount_internal_drives": false,
  "user": "alice",
  "mount_options": [
    "defaults",
    "noexec",
    "nosuid",
    "nodev",
    "uhexashift"
  ],
  "minimum_uid": 1000,
  "maximum_uid": 1000,
  "ignore_encrypted": true,
  "auto_unmount_timeout": 300,
  "polling_enabled": false,
  "filesystems_to_mount": [],
  "filesystems_to_ignore": [
    "swap",
    "zfs_member",
    "btrfs"
  ],
  "ntfs_mount_readonly": true,
  "enable_lvm2": true,
  "enable_mdraid": true,
  "state_dir": "/run/udisks2",
  "log_dir": "/var/log/udisks2",
  "log_level": 1
}
