{
  "unix_sock_group": {
    "type": "string",
    "default": null,
    "description": "UNIX domain socket group ownership"
  },
  "unix_sock_ro_perms": {
    "type": "string",
    "default": null,
    "description": "UNIX socket permissions for the R/O socket"
  },
  "unix_sock_rw_perms": {
    "type": "string",
    "default": null,
    "description": "UNIX socket permissions for the R/W socket"
  },
  "unix_sock_admin_perms": {
    "type": "string",
    "default": null,
    "description": "UNIX socket permissions for the admin interface socket"
  },
  "unix_sock_dir": {
    "type": "string",
    "default": null,
    "description": "Directory in which sockets will be found/created"
  },
  "auth_unix_ro": {
    "type": "string",
    "default": null,
    "description": "Authentication scheme for UNIX read-only sockets",
    "enum": [
      "none",
      "sasl",
      "polkit"
    ]
  },
  "auth_unix_rw": {
    "type": "string",
    "default": null,
    "description": "Authentication scheme for UNIX read-write sockets",
    "enum": [
      "none",
      "sasl",
      "polkit"
    ]
  },
  "access_drivers": {
    "type": "string",
    "default": null,
    "description": "API access control scheme",
    "enum": [
      "polkit",
      "nop"
    ]
  },
  "sasl_allowed_username_list_0": {
    "type": "string",
    "default": "joe@EXAMPLE.COM",
    "description": "First allowed SASL username"
  },
  "sasl_allowed_username_list_1": {
    "type": "string",
    "default": "",
    "description": "Second allowed SASL username"
  },
  "max_clients": {
    "type": "string",
    "default": null,
    "description": "Maximum number of concurrent client connections"
  },
  "max_queued_clients": {
    "type": "string",
    "default": null,
    "description": "Maximum length of queue of connections waiting to be accepted"
  },
  "max_anonymous_clients": {
    "type": "string",
    "default": null,
    "description": "Maximum length of queue of accepted but not yet authenticated clients"
  },
  "min_workers": {
    "type": "string",
    "default": null,
    "description": "Initial number of workers to start up"
  },
  "max_workers": {
    "type": "string",
    "default": null,
    "description": "Maximum number of workers"
  },
  "prio_workers": {
    "type": "string",
    "default": null,
    "description": "Number of priority workers"
  },
  "max_client_requests": {
    "type": "string",
    "default": null,
    "description": "Limit on concurrent requests from a single client connection"
  },
  "admin_min_workers": {
    "type": "string",
    "default": null,
    "description": "Admin interface minimum workers"
  },
  "admin_max_workers": {
    "type": "string",
    "default": null,
    "description": "Admin interface maximum workers"
  },
  "admin_max_clients": {
    "type": "string",
    "default": null,
    "description": "Admin interface maximum clients"
  },
  "admin_max_queued_clients": {
    "type": "string",
    "default": null,
    "description": "Admin interface maximum queued clients"
  },
  "admin_max_client_requests": {
    "type": "string",
    "default": null,
    "description": "Admin interface maximum client requests"
  },
  "log_level": {
    "type": "string",
    "default": null,
    "description": "Logging level: 4 errors, 3 warnings, 2 information, 1 debug"
  },
  "audit_level": {
    "type": "string",
    "default": "",
    "description": "Auditing level: 0 disable, 1 enable if host enabled, 2 enable and exit if disabled"
  },
  "audit_logging": {
    "type": "string",
    "default": null,
    "description": "Send audit messages via libvirt logging infrastructure"
  },
  "host_uuid": {
    "type": "string",
    "default": null,
    "description": "UUID of the host"
  },
  "host_uuid_source": {
    "type": "string",
    "default": null,
    "description": "Source for host UUID",
    "enum": [
      "smbios",
      "machine-id"
    ]
  },
  "keepalive_interval": {
    "type": "string",
    "default": null,
    "description": "Keepalive interval in seconds"
  },
  "keepalive_count": {
    "type": "string",
    "default": null,
    "description": "Maximum number of keepalive messages"
  },
  "keepalive_required": {
    "type": "string",
    "default": null,
    "description": "Keepalive required flag"
  },
  "admin_keepalive_required": {
    "type": "string",
    "default": null,
    "description": "Admin keepalive required flag"
  },
  "admin_keepalive_interval": {
    "type": "string",
    "default": null,
    "description": "Admin keepalive interval in seconds"
  },
  "admin_keepalive_count": {
    "type": "string",
    "default": null,
    "description": "Admin maximum number of keepalive messages"
  },
  "ovs_timeout": {
    "type": "string",
    "default": null,
    "description": "Timeout for openvswitch calls in seconds"
  }
}
