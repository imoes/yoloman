{
  "dav_cert_verification": true,
  "dav_ca_cert_file": "/etc/ssl/certs/ca-certificates.crt",
  "dav_client_cert": "",
  "dav_client_key": "",
  "dav_compression": false,
  "dav_cache_timeout": 300,
  "dav_max_conns": 4,
  "dav_cache_size_kb": 51200,
  "dav_cache_dir": "/var/cache/davfs2",
  "dav_use_mmap": true,
  "dav_use_locks": true,
  "dav_keep_alive": true,
  "dav_file_mode": "0640",
  "dav_dir_mode": "0750",
  "dav_cache_owner": "root",
  "dav_cache_group": "root",
  "dav_extra_headers": [
    {
      "name": "X-Request-ID",
      "value": "davfs2-{{ instance_id | default('default') }}"
    }
  ],
  "dav_proxy": "",
  "dav_debug": false
}
