[Resolve]
# Some examples of DNS servers which may be used for DNS= and FallbackDNS=:
# Cloudflare: 1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com
# Google:     8.8.8.8#dns.google 8.8.4.4#dns.google 2001:4860:4860::8888#dns.google 2001:4860:4860::8844#dns.google
# Quad9:      9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
DNS={{ dns_servers | join(',') | default('') | replace(',','
DNS=') if dns_servers | count > 0 else '' }}
FallbackDNS={{ fallback_dns_servers | join(',') | default('') | replace(',','
FallbackDNS=') if fallback_dns_servers | count > 0 else '' }}
Domains={{ domains | join(',') | default('') | replace(',','
Domains=') if domains | count > 0 else '' }}
DNSSEC={{ 'yes' if dnssec else 'no' }}
DNSOverTLS={{ dns_over_tls }}
MulticastDNS={{ 'yes' if use_mdns else 'no' }}
LLMNR={{ 'yes' if use_llmnr else 'no' }}
Cache={{ 'yes' if caching else 'no' }}
CacheFromLocalhost=no
DNSStubListener=yes
DNSStubListenerExtra={{ dns_stub_listener_addresses | join(',') | default('') | replace(',','
DNSStubListenerExtra=') if dns_stub_listener_addresses | count > 0 else '' }}
ReadEtcHosts={{ 'yes' if read_etc_hosts else 'no' }}
ResolveUnicastSingleLabel={{ 'yes' if resolve_unicast_reverse_lookups else 'no' }}
StaleRetentionSec=0
