[Resolve]
# DNS servers to use for resolution (list of IP addresses)
{% if dns_servers %}DNS={{ dns_servers | join(' ') }}{% else %}#DNS={% endif %}

# Fallback DNS servers when no DNS is configured via other means
{% if fallback_dns_servers %}FallbackDNS={{ fallback_dns_servers | join(' ') }}{% else %}#FallbackDNS={% endif %}

# Domain suffixes to append to unqualified hostnames
{% if domains %}Domains={{ domains | join(' ') }}{% else %}#Domains={% endif %}

# Whether to use LLMNR (Link-Local Multicast Name Resolution)
{% if use_llmnr is defined %}LLMNR={{ 'yes' if use_llmnr else 'no' }}{% else %}#LLMNR={% endif %}

# Whether to use mDNS (Multicast DNS, e.g., .local resolution)
{% if use_mdns is defined %}mDNS={{ 'yes' if use_mdns else 'no' }}{% else %}#mDNS={% endif %}

# Whether to perform DNSSEC validation
{% if dnssec is defined %}DNSSEC={{ 'yes' if dnssec else 'no' }}{% else %}#DNSSEC={% endif %}

# Whether to allow negative trust anchors for DNSSEC
{% if dnssec_negative_trust_anchors is defined %}DNSSECNegativeTrustAnchors={{ dnssec_negative_trust_anchors | join(' ') }}{% else %}#DNSSECNegativeTrustAnchors={% endif %}

# Default timeout for DNS queries in seconds
{% if dns_timeout is defined %}DNSTimeout={{ dns_timeout }}{% else %}#DNSTimeout={% endif %}

# Number of DNS queries to retry before giving up
{% if dns_max_retries is defined %}DNSMaxRetries={{ dns_max_retries }}{% else %}#DNSMaxRetries={% endif %}

# Whether to use TCP for DNS queries (bypasses UDP)
{% if tcp_dns_queries is defined %}TCPDNSQueries={{ 'yes' if tcp_dns_queries else 'no' }}{% else %}#TCPDNSQueries={% endif %}

# whether to preserve DNS stub listener socket after restart
{% if preserve_dns is defined %}PreserveDNS={{ 'yes' if preserve_dns else 'no' }}{% else %}#PreserveDNS={% endif %}

# DNS over TLS mode: off, allow, strict
{% if dns_over_tls is defined %}DNSOverTLS={{ dns_over_tls }}{% else %}#DNSOverTLS={% endif %}

# DNS stub listener port (use 0 to disable)
{% if dns_stub_listener_port is defined %}DNSStubListenerPort={{ dns_stub_listener_port }}{% else %}#DNSStubListenerPort={% endif %}

# Enable DNS caching (on/off)
{% if caching is defined %}Caching={{ 'yes' if caching else 'no' }}{% else %}#Caching={% endif %}

# Maximum number of cached entries
{% if cache_size is defined %}CacheSize={{ cache_size }}{% else %}#CacheSize={% endif %}

# Maximum number of DNSSEC validated RRs to cache
{% if dnssec_cache_max_size is defined %}DNSSECCacheMaxSize={{ dnssec_cache_max_size }}{% else %}#DNSSECCacheMaxSize={% endif %}

# Time-to-live (TTL) for negative responses in seconds
{% if negative_ttl is defined %}NegativeTTL={{ negative_ttl }}{% else %}#NegativeTTL={% endif %}

# Default DNSSEC trust anchor file(s)
{% if trust_anchor_file %}TrustAnchorFile={{ trust_anchor_file | join(' ') }}{% else %}#TrustAnchorFile={% endif %}

# Whether to read /etc/hosts before DNS
{% if read_etc_hosts is defined %}ReadEtcHosts={{ 'yes' if read_etc_hosts else 'no' }}{% else %}#ReadEtcHosts={% endif %}

# Whether to resolve .local via mDNS (conflicts with nss-mymachines)
{% if resolve_unicast_reverse_lookups is defined %}ResolveUnicastReverseLookups={{ 'yes' if resolve_unicast_reverse_lookups else 'no' }}{% else %}#ResolveUnicastReverseLookups={% endif %}

# List of stub listeners to bind to (default: loopback only)
{% if dns_stub_listener_addresses %}DNSStubListenerAddresses={{ dns_stub_listener_addresses | join(' ') }}{% else %}#DNSStubListenerAddresses={% endif %}
