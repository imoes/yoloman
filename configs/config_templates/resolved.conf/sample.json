{
  "dns_servers": [
    "8.8.8.8",
    "1.1.1.1"
  ],
  "fallback_dns_servers": [
    "127.0.0.53"
  ],
  "domains": [
    "example.com",
    "internal.lan"
  ],
  "use_llmnr": true,
  "use_mdns": false,
  "dnssec": true,
  "dnssec_negative_trust_anchors": [
    "insecure.example"
  ],
  "dns_timeout": 2,
  "dns_max_retries": 4,
  "tcp_dns_queries": false,
  "preserve_dns": true,
  "dns_over_tls": "strict",
  "dns_stub_listener_port": 53,
  "caching": true,
  "cache_size": 1024,
  "dnssec_cache_max_size": 2048,
  "negative_ttl": 120,
  "trust_anchor_file": [
    "/etc/trusted-key-dnssec.dnskey"
  ],
  "read_etc_hosts": true,
  "resolve_unicast_reverse_lookups": false,
  "dns_stub_listener_addresses": []
}
