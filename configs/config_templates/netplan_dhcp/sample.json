{
  "interfaces": [
    {
      "id": "eth0",
      "description": "Primary wired interface for office network",
      "dhcp4": true,
      "dhcp6": false,
      "dhcp4_overrides": {
        "use-dns": true,
        "use-hostname": true,
        "use-gateway": true
      },
      "nameservers": {
        "search": [
          "corp.example.com",
          "example.com"
        ],
        "addresses": [
          "10.0.0.53",
          "1.1.1.1"
        ]
      },
      "accept-ra": false
    },
    {
      "id": "enp3s0",
      "description": "Secondary interface for management VLAN",
      "match": {
        "macaddress": "00:11:22:33:44:55"
      },
      "set_name": "mgmt0",
      "dhcp4": false,
      "ipv4_addresses": [
        "192.168.99.10/24"
      ],
      "gateway4": "192.168.99.1",
      "nameservers": {
        "addresses": [
          "192.168.99.1"
        ]
      }
    },
    {
      "id": "wlan0",
      "description": "Wi-Fi interface (DHCP only, no static IPs)",
      "dhcp4": true,
      "dhcp6": true,
      "link_local": [
        "ipv4",
        "ipv6"
      ],
      "accept-ra": true,
      "routable_multicast": true
    }
  ]
}
