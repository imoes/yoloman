{
  "server": {
    "host": "127.0.0.1",
    "port": 13666,
    "pid_file": "/var/run/LCDd.pid",
    "user": "nobody",
    "group": "nogroup",
    "log_level": 2,
    "log_file": "/var/log/lcdproc/LCDd.log",
    "background": true,
    "idle_timeout": 60,
    "font": "5x8",
    "font_path": [
      "/usr/share/lcdproc/fonts"
    ]
  },
  "drivers": [
    {
      "name": "hd44780",
      "load": true,
      "path": "",
      "options": {
        "IOport": "0x378",
        "Direction": "0x00",
        "RS_pin": "0x01",
        "Enable_pin": "0x02",
        "Data_pins": "0x04,0x08,0x10,0x20"
      }
    },
    {
      "name": "I2C",
      "load": true,
      "path": "",
      "options": {
        "Device": "/dev/i2c-1",
        "Address": "0x27",
        "Columns": "20",
        "Rows": "4"
      }
    }
  ],
  "lcd_model": "generic",
  "lcd_size": "20x4",
  "lcd_backlight": true,
  "lcd_contrast": 70,
  "lcd_voltage": 5000,
  "lcd_delay": 10,
  "lcd_cursor": false,
  "client": {
    "max_clients": 10,
    "timeout": 300
  }
}
