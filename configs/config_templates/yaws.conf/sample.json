{
  "logdir": "/var/log/yaws",
  "docroot": "/var/www/yaws",
  "erl_lib_dir": "/usr/lib/yaws",
  "port": 8080,
  "listen": "127.0.0.1",
  "user": "yaws",
  "group": "yaws",
  "max_connections": 2048,
  "recv_timeout": 15000,
  "send_timeout": 30000,
  "directory_listing": true,
  "keepalive": true,
  "keepalive_timeout": 8000,
  "server_alias": "MyYaws",
  "ssl_vhosts": [
    {
      "name": "secure.example.com",
      "port": 8443,
      "listen": "0.0.0.0",
      "ssl_cert_file": "/etc/ssl/certs/example.crt",
      "ssl_key_file": "/etc/ssl/private/example.key",
      "ssl_cacert_file": "/etc/ssl/certs/ca-chain.crt",
      "docroot": "/var/www/secure"
    }
  ],
  "plain_vhosts": [
    {
      "name": "www.example.com",
      "port": 8080,
      "docroot": "/var/www/public"
    },
    {
      "name": "api.example.com",
      "port": 8081,
      "docroot": "/var/www/api"
    }
  ],
  "trace": "false",
  "erlang_flags": "-smp enable +K true",
  "extra_app_dirs": [
    "/usr/local/lib/myapp/ebin"
  ]
}
