# Hoogle configuration file
# Generated by Ansible. Do not edit manually.

# Host address to bind the Hoogle server to.
host: {{ host | default('localhost') }}

# Port number to listen on for HTTP requests.
port: {{ port | default(8080) }}

# API key for securing the server endpoints.
key: {{ key | default('') }}

# Path to the Hoogle database file (.hoo) to serve.
database: {{ database | default('/usr/share/hoogle/data.hoo') }}

# Whether to enable HTTPS/TLS for the server.
https: {{ https | default(false) }}

# Path to the CA certificate file for HTTPS.
ca: {{ ca | default('') }}

# Path to the server certificate file for HTTPS.
cert: {{ cert | default('') }}

# Path to the server private key file for HTTPS.
keypath: {{ keypath | default('') }}

# Whether to enable Gzip compression for responses.
compress: {{ compress | default(true) }}

# Number of worker threads to use for handling requests.
threads: {{ threads | default(4) }}

# Verbosity level (0=quiet, 1=normal, 2=verbose).
verbose: {{ verbose | default(1) }}

# The base URL path for the Hoogle server.
base: {{ base | default('/') }}

# List of package database files to include in the search index.
{% if (packages | default([])) | length > 0 %}
packages:
{% for pkg in packages | default([]) %}
    - {{ pkg }}
{% endfor %}
{% else %}
packages: []
{% endif %}