# icmptx configuration
# Run icmptx in {{ role | default('client') }} mode

# The operational mode of the icmptx instance.
# Valid values: 'server' or 'client'.
# - 'server': icmptx listens for ICMP echo requests and replies (acting as a server).
# - 'client': icmptx sends ICMP echo requests to a target (acting as a client).
ROLE={{ role | default('client') }}

# The host name or IP address of the peer.
# If ROLE is 'client', this is the IP address or hostname of the server to ping.
# If ROLE is 'server', this is the local interface IP or address to bind to.
# Note: icmptx binary arguments typically are: icmptx -s <bind_addr> for server,
# or icmptx -c <target_addr> for client. This field serves that purpose.
TARGET={{ target | default('192.0.2.1') }}