{
  "log_syslog": true,
  "log_file": "/var/log/dsniff.log",
  "arplog_file": "/var/log/dsniff-arp.log",
  "arp_poison": "off",
  "signatures": "on",
  "sniff_protocols": [
    "ftp",
    "http",
    "telnet",
    "smtp"
  ],
  "ignore_hosts": [
    "192.168.1.1",
    "10.0.0.1"
  ],
  "interfaces": [
    "eth1"
  ]
}
