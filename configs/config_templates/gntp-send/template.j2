# ==============================================================================
# GNTP (Groovy Notification Transport Protocol) Client Configuration
# ==============================================================================
# This template configures the gntp-send client to connect to a GNTP notification
# server. It defines connection parameters, default application/notification names,
# and optional authentication and metadata.
# ==============================================================================

# GNTP server hostname or IP address
# The host where the GNTP server is listening.
server = {{ server | default('localhost') }}

# GNTP server port (IANA-assigned default: 23053)
# The TCP port on which the GNTP server accepts connections.
port = {{ port | default(23053) }}

# Application name used in GNTP notification headers
# Identifies the source application in notifications sent to the server.
application = {{ application | default('GNTP-Send') }}

# Default notification name (used if not specified at send time)
# The default event type/name for notifications if the sender does not provide one.
notification = {{ notification | default('Message') }}

# Authentication password for GNTP server (empty = no authentication)
# If the GNTP server requires authentication, provide the password here.
# Leave empty if no password is configured on the server.
password = {{ password | default('') }}

# Default icon path or URL for notifications
# A file path or HTTP/HTTPS URL pointing to an icon displayed with notifications.
icon = {{ icon | default('') }}

# Default URL to open when notification is clicked
# A link associated with the notification, opened when the user clicks it.
url = {{ url | default('') }}