# fencing: IPMI/LAN over IPMIv2.0 (iLO2) fence device configuration
# IP address or hostname of the iLO2 management interface
ipaddr={{ ipaddr }}

# Login username for iLO2
login={{ login }}

# Password for iLO2 (use `passwd_file` for security in production)
passwd={{ passwd | default('') }}

# Alternative: path to a file containing the password (recommended for production)
passwd_file={{ passwd_file | default('') }}

# Optional: IPMI interface type (defaults to 'lanplus' for IPMI 2.0)
# Common values: 'lan', 'lanplus' (LAN+ with encryption/auth extensions)
interface={{ interface | default('lanplus') }}

# Optional: port for IPMI over LAN (typically not needed; defaults to 623)
port={{ port | default('623') }}

# Optional: IPMI privilege level (e.g., 'user', 'operator', 'admin')
privilege={{ privilege | default('operator') }}

# Optional: delay (seconds) to wait after power-on before checking status
delay={{ delay | default('5') }}

# Optional: SSL/TLS options
# Set to '1' to enforce TLS 1.0+ (if supported by iLO2 firmware)
ssl={{ ssl | default('0') }}
# Set to '1' to disable certificate verification (use only in trusted networks)
ssl_insecure={{ ssl_insecure | default('0') }}

# Optional: Power management timeout (seconds)
# Maximum time to wait for a power command (on/off/status) to complete
power_timeout={{ power_timeout | default('20') }}

# Optional: Test mode — if set, do not actually send commands (dry-run)
test={{ test | default('0') }}
