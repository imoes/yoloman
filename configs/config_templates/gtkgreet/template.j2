{# gtkgreet configuration template
#
# This file defines the login session options presented by gtkgreet.
# Each line in the output is a command line executed when the user selects that option.
#
# Schema variable: environments (list of strings)
# Default: [] (empty list, no options)
#}

{% for command in environments | default([]) -%}
{# Command line to execute for this login session option #}
{{ command }}
{%- endfor %}