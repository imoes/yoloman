{
  "service_path": {
    "type": "string",
    "default": "//localhost/share",
    "description": "The SMB/CIFS service path in the format //server/service"
  },
  "no_pass": {
    "type": "bool",
    "default": false,
    "description": "Suppress the password prompt (-N)"
  },
  "use_kerberos": {
    "type": "string",
    "default": "off",
    "description": "Kerberos authentication desired|required|off (--use-kerberos)",
    "enum": [
      "desired",
      "required",
      "off"
    ]
  },
  "workgroup": {
    "type": "string",
    "default": "WORKGROUP",
    "description": "The SMB domain/workgroup (-W)"
  },
  "username": {
    "type": "string",
    "default": "",
    "description": "The username for authentication (-U)"
  },
  "password": {
    "type": "string",
    "default": "",
    "description": "The password to append to username in -U flag. Prefer using -A authentication-file in production."
  },
  "max_protocol": {
    "type": "string",
    "default": "SMB3",
    "description": "The highest SMB protocol version to use (e.g., SMB3, SMB2, NT1) (-m)",
    "enum": [
      "SMB3",
      "SMB2",
      "NT1"
    ],
    "enum_open": true
  },
  "timeout": {
    "type": "number",
    "default": 20,
    "description": "Timeout in seconds for each SMB request (-t)"
  },
  "debug_level": {
    "type": "number",
    "default": 1,
    "description": "Debug level from 0 to 10 (-d)"
  },
  "log_basename": {
    "type": "string",
    "default": "/var/log/smbclient",
    "description": "Base name for log files (-l)"
  },
  "config_file": {
    "type": "string",
    "default": "/etc/samba/smb.conf",
    "description": "Path to the client configuration file (-s)"
  },
  "command": {
    "type": "string",
    "default": "",
    "description": "Semicolon-separated list of smbclient commands to execute instead of interactive shell (-c)"
  }
}
