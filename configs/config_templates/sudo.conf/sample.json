{
  "sudoers_dir": "/etc",
  "logfile": "syslog",
  "timestampdir": "/var/db/sudo",
  "tmpfile": "/etc/sudoers.tmp",
  "log_input": false,
  "log_output": false,
  "requiretty": true,
  "passwd_tries": 3,
  "timeout": 15,
  "plugins": [
    {
      "path": "/usr/libexec/sudo/sudoers.so",
      "options": "logging=syslog,log_input,log_output"
    }
  ],
  "env_keep": [
    "TERM",
    "LANG",
    "LC_ALL",
    "LC_MESSAGES",
    "SUDO_USER",
    "LOGNAME",
    "USER",
    "HOME",
    "PATH",
    "MAIL",
    "SHLVL",
    "XAUTHORITY"
  ],
  "lines": [
    "# This line is included to demonstrate that arbitrary sudo.conf directives",
    "# (like 'Defaults    !authenticate') may be added in this block.",
    "Defaults    !authenticate"
  ]
}
