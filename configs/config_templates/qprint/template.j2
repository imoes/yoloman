# =============================================================================
# qprint Configuration Template
# =============================================================================
# qprint is a command-line utility for MIME Quoted-Printable encoding/decoding.
# It does not have a persistent daemon or a traditional static configuration file.
# This template serves as a reference wrapper script or environment configuration
# for automated mail processing systems that invoke qprint.
#
# The generated 'cmd' variable contains the fully constructed qprint command line,
# ready to be passed to a shell module or executed by a wrapper script.
# =============================================================================

# -----------------------------------------------------------------------------
# Operation Mode
# -----------------------------------------------------------------------------
# The operation to perform: 'encode' for Quoted-Printable encoding, 'decode' for decoding.
# Corresponds to -e/--encode or -d/--decode
operation = {{ operation | default('encode') }}

# -----------------------------------------------------------------------------
# Input Source
# -----------------------------------------------------------------------------
# The input file path. Use '-' for standard input.
# Corresponds to the infile argument
input_file = {{ input_file | default('-') }}

# -----------------------------------------------------------------------------
# Output Destination
# -----------------------------------------------------------------------------
# The output file path. Use '-' for standard output.
# Corresponds to the outfile argument
output_file = {{ output_file | default('-') }}

# -----------------------------------------------------------------------------
# Binary Mode
# -----------------------------------------------------------------------------
# If true, treats input/output as pure binary (-b/--binary).
# Preserves exact byte sequence and skips EOL translation.
binary_mode = {{ binary_mode | default(false) | lower }}

# -----------------------------------------------------------------------------
# EBCDIC Compatibility
# -----------------------------------------------------------------------------
# If true, encodes ASCII characters for EBCDIC compatibility (-i/--ebdic).
# Useful when sending data to legacy systems expecting EBCDIC representations.
ebcdc_mode = {{ ebcdc_mode | default(false) | lower }}

# -----------------------------------------------------------------------------
# Error Checking Suppression
# -----------------------------------------------------------------------------
# If true, suppresses error checking on decode (-n/--noerrcheck).
# Ignores invalid characters and skips error messages during decoding.
no_error_check = {{ no_error_check | default(false) | lower }}

# -----------------------------------------------------------------------------
# Paranoid Mode
# -----------------------------------------------------------------------------
# If true, encodes every character as an escape sequence (-p/--paranoid).
# Note: Requires binary_mode to be true for EOL sequences to be escaped properly.
paranoid_mode = {{ paranoid_mode | default(false) | lower }}

# =============================================================================
# Command Line Construction
# =============================================================================
# The following block constructs the final shell command string based on the
# parameters defined above. This allows the template to act as a configuration
# generator for automation tools (e.g., Ansible command/shell modules).

{% set qprint_cmd_parts = ['qprint'] %}

{# Add operation flag: -e for encode, -d for decode #}
{% if operation | default('encode') == 'encode' %}
    {% set _ = qprint_cmd_parts.append('-e') %}
{% else %}
    {% set _ = qprint_cmd_parts.append('-d') %}
{% endif %}

{# Add binary mode flag if enabled #}
{% if binary_mode | default(false) %}
    {% set _ = qprint_cmd_parts.append('-b') %}
{% endif %}

{# Add EBCDIC mode flag if enabled #}
{% if ebcdc_mode | default(false) %}
    {% set _ = qprint_cmd_parts.append('-i') %}
{% endif %}

{# Add no error check flag if enabled #}
{% if no_error_check | default(false) %}
    {% set _ = qprint_cmd_parts.append('-n') %}
{% endif %}

{# Add paranoid mode flag if enabled #}
{% if paranoid_mode | default(false) %}
    {% set _ = qprint_cmd_parts.append('-p') %}
{% endif %}

{# Append input file if not stdin #}
{% if input_file | default('-') != '-' %}
    {% set _ = qprint_cmd_parts.append(input_file) %}
{% endif %}

{# Append output file if not stdout #}
{% if output_file | default('-') != '-' %}
    {% set _ = qprint_cmd_parts.append(output_file) %}
{% endif %}

# Final command to be executed or piped
# This variable holds the space-separated command string
cmd = {{ qprint_cmd_parts | join(' ') }}