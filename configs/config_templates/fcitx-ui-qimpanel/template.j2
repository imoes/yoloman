[Desktop Entry]
# Name of the desktop entry
Name=Fcitx Qt IMPanel
# GenericName for the application
GenericName=Fcitx Qt Input Method Panel
# Comment describing the desktop entry's purpose
Comment=Start Fcitx Qt IMPanel
# Exec command to launch the application
# exec_path: Path to the Fcitx Qt IMPanel autostart script
Exec={{ exec_path | default('/usr/share/fcitx-qimpanel/fcitx-qimpanel-autostart') }}
# Icon to use for the application
# icon_name: Name of the icon (should be present in the current icon theme)
Icon={{ icon_name | default('fcitx') }}
Terminal=false
Type=Application
Categories=System;Utility;
StartupNotify=false
X-GNOME-Autostart-Phase=Applications
X-GNOME-AutoRestart=false
X-GNOME-Autostart-Notify=false
X-KDE-autostart-after=panel
X-KDE-StartupNotify=false