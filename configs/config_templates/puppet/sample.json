{
  "hostname": "webnode01.example.com",
  "server": "puppetmaster.example.com",
  "server_port": 8140,
  "logdir": "/var/log/puppetlabs/puppet",
  "rundir": "/var/run/puppetlabs/puppet",
  "localfile": "/etc/puppetlabs/puppet/localfile.conf",
  "debug": false,
  "verbose": false,
  "runinterval": 900,
  "environment": "production",
  "factsource": "puppet://$servername/facts",
  "storeconfigs": true,
  "storeconfigs_backend": "puppetdb",
  "puppetdb_server": "http://puppetdb.example.com:8081",
  "timeout": 300,
  "pluginsync": true,
  "certname": "webnode01.example.com"
}
