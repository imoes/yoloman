{
  "passenger_root": "/usr/lib/passenger",
  "passenger_ruby": "/usr/bin/ruby",
  "passenger_enabled": true,
  "passenger_min_instances": 2,
  "passenger_max_instances": 8,
  "passenger_max_preloader_idle_time": 300,
  "passenger_pool_idle_time": 450,
  "passenger_status_display": true,
  "passenger_max_requests": 1000,
  "passenger_buffer_response": true,
  "startup_file": "",
  "passenger_log_level": 2,
  "env_vars": [
    {
      "name": "RAILS_ENV",
      "value": "production"
    },
    {
      "name": "NODE_ENV",
      "value": "production"
    }
  ],
  "apps": [
    {
      "name": "my-rails-app",
      "base_uri": "/",
      "document_root": "/var/www/myapp/public",
      "interpreter_type": "ruby",
      "interpreter": "/opt/rvm/rubies/ruby-3.0.0/bin/ruby",
      "environment": "production",
      "startup_file": "",
      "min_instances": 2,
      "max_instances": 4,
      "buffer_response": true,
      "env_vars": [
        {
          "name": "DATABASE_URL",
          "value": "postgres://user:pass@localhost/myapp_prod"
        }
      ]
    },
    {
      "name": "my-python-api",
      "base_uri": "/api",
      "document_root": "/var/www/api/public",
      "interpreter_type": "python",
      "interpreter": "/usr/bin/python3",
      "environment": "production",
      "startup_file": "wsgi.py",
      "min_instances": 1,
      "max_instances": 2,
      "buffer_response": false,
      "env_vars": [
        {
          "name": "FLASK_ENV",
          "value": "production"
        }
      ]
    },
    {
      "name": "my-node-app",
      "base_uri": "/node",
      "document_root": "/var/www/nodeapp",
      "interpreter_type": "node",
      "interpreter": "/usr/bin/node",
      "environment": "production",
      "startup_file": "server.js",
      "buffer_response": true
    }
  ]
}
