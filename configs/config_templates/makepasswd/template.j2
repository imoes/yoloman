# =============================================================================
# makepasswd - Configuration Template
#
# This file documents the configuration options for `makepasswd`, a tool to
# generate random passwords. Each option corresponds to a command-line flag.
# The template is self-documenting: comments explain the field's purpose,
# constraints, and default behavior.
# =============================================================================

# clearfrom: Path to file containing clear-text passwords to encrypt.
# If empty, defaults to /dev/null (no input file).
# Note: This option is typically used with --crypt or --crypt-md5.
# Value: String path or empty string.
# Default: '/dev/null'
# ---
clearfrom = {{ clearfrom | default('/dev/null') }}

# chars: Generate passwords with exactly N characters.
# Mutually exclusive with minchars and maxchars.
# Value: Integer.
# Default: 12
# ---
chars = {{ chars | default(12) }}

# count: Produce a total of N passwords.
# Value: Integer.
# Default: 1
# ---
count = {{ count | default(1) }}

# crypt: Produce encrypted passwords using crypt().
# Mutually exclusive with crypt_md5.
# Value: Boolean (true/false).
# Default: false
# ---
crypt = {{ crypt | default(false) }}

# crypt_md5: Produce encrypted passwords using MD5 digest.
# Mutually exclusive with crypt.
# Value: Boolean (true/false).
# Default: false
# ---
crypt_md5 = {{ crypt_md5 | default(false) }}

# crypt_salt: Use crypt() salt N (0-4096).
# 0 for random seed.
# Value: Integer.
# Default: 0
# ---
crypt_salt = {{ crypt_salt | default(0) }}

# maxchars: Maximum length of generated passwords.
# Mutually exclusive with chars.
# Value: Integer.
# Default: 10
# ---
maxchars = {{ maxchars | default(10) }}

# minchars: Minimum length of generated passwords.
# Mutually exclusive with chars.
# Value: Integer.
# Default: 8
# ---
minchars = {{ minchars | default(8) }}

# nocrypt: Do not encrypt generated passwords.
# If true, crypt and crypt_md5 should be false.
# Value: Boolean (true/false).
# Default: true
# ---
nocrypt = {{ nocrypt | default(true) }}

# novarbose: Display no labels on output.
# Value: Boolean (true/false).
# Default: true
# ---
novarbose = {{ novarbose | default(true) }}

# random_seed: Random number seed N (0-2^32).
# 0 for true random.
# Value: Integer.
# Default: 0
# ---
random_seed = {{ random_seed | default(0) }}

# rerandom: Set random seed every N values.
# 0 for single seed.
# Value: Integer.
# Default: 0
# ---
rerandom = {{ rerandom | default(0) }}

# repeat_pass: Use each password N times.
# Requires crypt=true.
# Value: Integer.
# Default: 1
# ---
repeat_pass = {{ repeat_pass | default(1) }}

# string: Character set STRING to use for password generation.
# Empty for default character set.
# Value: String.
# Default: ''
# ---
string = {{ string | default('') }}

# verbose: Display labelling information on output.
# Mutually exclusive with novarbose.
# Value: Boolean (true/false).
# Default: false
# ---
verbose = {{ verbose | default(false) }}