# smsd default file
# This file configures the smsd daemon for smstools.
# It sets the runtime user, group, and paths for state files.

# Defines under which user smsd is running. This may need to be changed
# if using devices other than /dev/ttyS0
USER="{{ user | default('smsd') }}"

# Defines under which group smsd is running
GROUP="{{ group | default('dialout') }}"

# Specifies pathes.
# Specifies the path to the PID file for the smsd daemon
PIDFILE="{{ pidfile | default('/var/run/smstools/smsd.pid') }}"

# Specifies the path to the working/info file for the smsd daemon
INFOFILE="{{ infofile | default('/var/run/smstools/smsd.working') }}"