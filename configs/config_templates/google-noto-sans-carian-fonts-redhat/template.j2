<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  Self-documenting Fontconfig configuration for Noto Sans Carian.
  Generated by Ansible Jinja2 template.
-->
<fontconfig>
  <!--
    Match rules for font substitution and hinting.
    Targets the 'sans-serif' family to prepend Noto Sans Carian.
  -->
  <match>
    <test name="family">
      <!-- Fallback family if Noto Sans Carian is not available or for general sans-serif requests -->
      <string>{{ fallback_family | default('sans-serif') }}</string>
    </test>
    <edit name="family" mode="prepend">
      <!--
        The font family name to use for Noto Sans Carian.
        Inserted at the beginning of the font search list for sans-serif.
      -->
      <string>{{ noto_sans_carian_family | default('Noto Sans Carian') }}</string>
    </edit>
    <edit name="fonthashint" mode="append">
      <!--
        Whether to append a boolean edit for font hinting.
        Controls hinting behavior for the Carian script.
      -->
      <bool>{{ noto_sans_cariain_hint_bool | default('false') }}</bool>
    </edit>
  </match>

  <!--
    Alias definition for Noto Sans Carian.
    Declares the family name and its default fallback.
  -->
  <alias>
    <!-- The official family name for Noto Sans Carian -->
    <family>{{ noto_sans_carian_family | default('Noto Sans Carian') }}</family>
    <default>
      <!--
        The default fallback family for Noto Sans Carian.
        Used when Noto Sans Carian glyphs are missing for a character.
      -->
      <family>{{ fallback_family | default('sans-serif') }}</family>
    </default>
  </alias>
</fontconfig>
