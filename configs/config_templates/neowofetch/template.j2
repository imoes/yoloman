# Neowofetch Configuration File
# Auto-generated for {{ service_name | default('neowofetch') }}

# --- INFO ---

# Specify the function name(s) to display. Default is 'all'.
# See man page for info names like uptime, memory, cpu, etc.
print_info=("{{ info_display | default(['all']) | join(' ') }}")

# Disable specific info lines from appearing. Space-separated list.
# Example: cpu memory
disable_info=("{{ disable_info | default([]) | join(' ') }}")

# Show/Hide Fully Qualified Domain Name in title.
title_fqdn={{ title_fqdn | default(True) | lower }}

# Hide/Show Package Manager names. Options: on, tiny, off.
package_managers="{{ package_managers | default('on') }}"

# Whether to separate system/user modes for supported package managers.
package_separate={{ package_separate | default(False) | lower }}

# Reduce output of packages list by not showing programming language package managers or Steam games.
package_minimal={{ package_minimal | default(False) | lower }}

# Hide/Show OS architecture.
os_arch={{ os_arch | default(True) | lower }}

# Change the type of cpu speed to display. Options: current, min, max, bios, scaling_current, scaling_min, scaling_max.
speed_type="{{ speed_type | default('current') }}"

# Whether or not to show decimals in CPU speed.
speed_shorthand={{ speed_shorthand | default(False) | lower }}

# Enable/Disable CPU brand in output.
cpu_brand={{ cpu_brand | default(True) | lower }}

# Whether or not to display the number of CPU cores. Options: logical, physical, off.
cpu_cores="{{ cpu_cores | default('logical') }}"

# Hide/Show cpu speed.
cpu_speed={{ cpu_speed | default(True) | lower }}

# Hide/Show cpu temperature. Options: C, F, off.
cpu_temp="{{ cpu_temp | default('off') }}"

# Shorten the output of distro. Options: on, tiny, off.
distro_shorthand="{{ distro_shorthand | default('off') }}"

# Shorten the output of kernel.
kernel_shorthand={{ kernel_shorthand | default(False) | lower }}

# Shorten the output of uptime. Options: on, tiny, off.
uptime_shorthand="{{ uptime_shorthand | default('off') }}"

# Whether to display the refresh rate of each monitor.
refresh_rate={{ refresh_rate | default(False) | lower }}

# Enable/Disable GPU brand in output. Options: AMD, NVIDIA, Intel.
gpu_brand="{{ gpu_brand | default('AMD') }}"

# Which GPU to display. Options: all, dedicated, integrated.
gpu_type="{{ gpu_type | default('all') }}"

# Show/Hide Desktop Environment version.
de_version={{ de_version | default(False) | lower }}

# Shorten output of gtk theme/icons.
gtk_shorthand={{ gtk_shorthand | default(False) | lower }}

# Enable/Disable gtk2 theme/font/icons output.
gtk2={{ gtk2 | default(False) | lower }}

# Enable/Disable gtk3 theme/font/icons output.
gtk3={{ gtk3 | default(False) | lower }}

# Enable/Disable showing $SHELL path.
shell_path={{ shell_path | default(False) | lower }}

# Enable/Disable showing $SHELL version.
shell_version={{ shell_version | default(False) | lower }}

# Enable/Disable showing $EDITOR path.
editor_path={{ editor_path | default(False) | lower }}

# Enable/Disable showing $EDITOR version.
editor_version={{ editor_version | default(False) | lower }}

# Which disks to display. Options: '/', '/dev/sdXX', '/path/to/mount point'.
disk_show=("{{ disk_show | default(['/']) | join(' ') }}")

# What information to append to the Disk subtitle. Options: name, mount, dir, none.
disk_subtitle="{{ disk_subtitle | default('none') }}"

# Hide/Show disk percent.
disk_percent={{ disk_percent | default(False) | lower }}

# URL to query for public IP.
ip_host="{{ ip_host | default('api.ipify.org') }}"

# Public IP timeout (in seconds).
ip_timeout={{ ip_timeout | default(3) }}

# Interface(s) to use for local IP.
ip_interface="{{ ip_interface | default('any') }}"

# Print the song data in a specific format.
# See config file for valid formats.
song_format="{{ song_format | default('%t - %a') }}"

# Print the Artist/Album/Title on separate lines.
song_shorthand={{ song_shorthand | default(False) | lower }}

# Display memory percentage.
memory_percent={{ memory_percent | default(False) | lower }}

# Memory output unit. Options: (k/m/g/t)ib.
memory_unit="{{ memory_unit | default('gib') }}"

# Change memory output precision.
memory_precision={{ memory_precision | default(2) }}

# --- TEXT FORMATTING ---

# Changes the text colors in this order: title, @, underline, subtitle, colon, info.
# Colors can be standard names or hex codes.
color=("{{ color | default(['2', '2', '2', '2', '2', '2']) | join(' ') }}")

# Enable/Disable the underline.
underline={{ underline | default(False) | lower }}

# Character to use when underlining title.
underline_char="{{ underline_char | default('=') }}"

# Enable/Disable bold text.
bold={{ bold | default(False) | lower }}

# Changes the default ':' separator to the specified string.
separator="{{ separator | default(':') }}"

# --- COLOR BLOCKS ---

# Enable/Disable the color blocks
color_blocks={{ color_blocks | default(False) | lower }}

# Left-padding of color blocks. Options: auto, num.
col_offset="{{ col_offset | default('auto') }}"

# Width of color blocks in spaces.
block_width={{ block_width | default(4) }}

# Height of color blocks in lines.
block_height={{ block_height | default(2) }}

# Range of colors to print as blocks.
# Example: 0 5 to print colors from index 0 to 5.
block_range=("{{ block_range | default([0, 5]) | join(' ') }}")

# --- BARS ---

# Characters to use when drawing bars. Format: 'elapsed char' 'total char'.
bar_char="{{ bar_char | default('█ ░') }}"

# Whether or not to surround the bar with '[]'.
bar_border={{ bar_border | default(True) | lower }}

# Length in spaces to make the bars.
bar_length={{ bar_length | default(10) }}

# Colors to make the bar. Set in this order: elapsed, total.
bar_colors=("{{ bar_colors | default(['2', '2']) | join(' ') }}")

# Bar mode for memory. Options: bar, infobar, barinfo, off.
memory_display="{{ memory_display | default('bar') }}"

# Bar mode for battery. Options: bar, infobar, barinfo, off.
battery_display="{{ battery_display | default('off') }}"

# Bar mode for disk. Options: bar, infobar, barinfo, off.
disk_display="{{ disk_display | default('bar') }}"

# --- IMAGE BACKEND ---

# Which image backend to use. Options: ascii, caca, catimg, chafa, jp2a, iterm2, off, sixel, tycat, w3m, kitty, viu.
backend="{{ backend | default('auto') }}"

# Which image or ascii file to use. Options: auto, ascii, wallpaper, /path/to/img, /path/to/ascii, /path/to/dir/, command output.
source="{{ source | default('auto') }}"

# --- ASCII ---

# Colors to print the ascii art. Up to 6 colors.
ascii_colors=("{{ ascii_colors | default(['2', '2', '2', '2', '2', '2']) | join(' ') }}")

# Which Distro's ascii art to print.
ascii_distro="{{ ascii_distro | default('auto') }}"

# Whether or not to bold the ascii logo.
ascii_bold={{ ascii_bold | default(False) | lower }}

# --- IMAGE ---

# Redraw the image constantly until Ctrl+C is used.
loop={{ loop | default(False) | lower }}

# How to size the image. Options: auto, 00px, 00%, none.
size="{{ size | default('auto') }}"

# Change the resolution of catimg. Options: 1, 2.
catimg_size="{{ catimg_size | default('1') }}"

# Which crop mode to use. Options: normal, fit, fill.
crop_mode="{{ crop_mode | default('normal') }}"

# Change the crop offset for normal mode. Options: northwest, north, northeast, west, center, east, southwest, south, southeast.
crop_offset="{{ crop_offset | default('center') }}"

# How close the image will be to the left edge of the window (w3m only).
xoffset={{ xoffset | default(0) }}

# How close the image will be to the top edge of the window (w3m only).
yoffset={{ yoffset | default(0) }}

# Background color to display behind transparent image (w3m only).
bg_color="{{ bg_color | default('black') }}"

# Gap between image and text.
gap={{ gap | default(0) }}

# Delete cached files and thumbnails.
clean={{ clean | default(False) | lower }}