{
  "service_name": {
    "type": "string",
    "default": "neowofetch",
    "description": "The name of the service or command being configured."
  },
  "info_display": {
    "type": "list",
    "default": [
      "all"
    ],
    "description": "List of info function names to display. Use 'all' for default."
  },
  "disable_info": {
    "type": "list",
    "default": [],
    "description": "List of info lines to disable (e.g., 'cpu', 'memory')."
  },
  "title_fqdn": {
    "type": "bool",
    "default": true,
    "description": "Show Fully Qualified Domain Name in title."
  },
  "package_managers": {
    "type": "string",
    "default": "on",
    "description": "Package manager display mode: on, tiny, off.",
    "enum": [
      "on",
      "tiny",
      "off"
    ]
  },
  "package_separate": {
    "type": "bool",
    "default": false,
    "description": "Separate system/user modes for package managers."
  },
  "package_minimal": {
    "type": "bool",
    "default": false,
    "description": "Reduce package list output."
  },
  "os_arch": {
    "type": "bool",
    "default": true,
    "description": "Show OS architecture."
  },
  "speed_type": {
    "type": "string",
    "default": "current",
    "description": "CPU speed display type: current, min, max, bios, scaling_current, scaling_min, scaling_max.",
    "enum": [
      "current",
      "min",
      "max",
      "bios",
      "scaling_current",
      "scaling_min",
      "scaling_max"
    ]
  },
  "speed_shorthand": {
    "type": "bool",
    "default": false,
    "description": "Show decimals in CPU speed."
  },
  "cpu_brand": {
    "type": "bool",
    "default": true,
    "description": "Show CPU brand."
  },
  "cpu_cores": {
    "type": "string",
    "default": "logical",
    "description": "CPU cores display type: logical, physical, off.",
    "enum": [
      "logical",
      "physical",
      "off"
    ]
  },
  "cpu_speed": {
    "type": "bool",
    "default": true,
    "description": "Show CPU speed."
  },
  "cpu_temp": {
    "type": "string",
    "default": "off",
    "description": "CPU temperature display: C, F, off.",
    "enum": [
      "C",
      "F",
      "off"
    ]
  },
  "distro_shorthand": {
    "type": "string",
    "default": "off",
    "description": "Distro name shorthand: on, tiny, off.",
    "enum": [
      "on",
      "tiny",
      "off"
    ]
  },
  "kernel_shorthand": {
    "type": "bool",
    "default": false,
    "description": "Shorten kernel output."
  },
  "uptime_shorthand": {
    "type": "string",
    "default": "off",
    "description": "Uptime shorthand: on, tiny, off.",
    "enum": [
      "on",
      "tiny",
      "off"
    ]
  },
  "refresh_rate": {
    "type": "bool",
    "default": false,
    "description": "Show monitor refresh rate."
  },
  "gpu_brand": {
    "type": "string",
    "default": "AMD",
    "description": "GPU brand to show: AMD, NVIDIA, Intel.",
    "enum": [
      "AMD",
      "NVIDIA",
      "Intel"
    ]
  },
  "gpu_type": {
    "type": "string",
    "default": "all",
    "description": "GPU type to show: all, dedicated, integrated.",
    "enum": [
      "all",
      "dedicated",
      "integrated"
    ]
  },
  "de_version": {
    "type": "bool",
    "default": false,
    "description": "Show Desktop Environment version."
  },
  "gtk_shorthand": {
    "type": "bool",
    "default": false,
    "description": "Shorten GTK theme/icons output."
  },
  "gtk2": {
    "type": "bool",
    "default": false,
    "description": "Show GTK2 theme/font/icons."
  },
  "gtk3": {
    "type": "bool",
    "default": false,
    "description": "Show GTK3 theme/font/icons."
  },
  "shell_path": {
    "type": "bool",
    "default": false,
    "description": "Show $SHELL path."
  },
  "shell_version": {
    "type": "bool",
    "default": false,
    "description": "Show $SHELL version."
  },
  "editor_path": {
    "type": "bool",
    "default": false,
    "description": "Show $EDITOR path."
  },
  "editor_version": {
    "type": "bool",
    "default": false,
    "description": "Show $EDITOR version."
  },
  "disk_show": {
    "type": "list",
    "default": [
      "/"
    ],
    "description": "List of disks to show: '/', '/dev/sdXX', or mount points."
  },
  "disk_subtitle": {
    "type": "string",
    "default": "none",
    "description": "Disk subtitle info: name, mount, dir, none.",
    "enum": [
      "name",
      "mount",
      "dir",
      "none"
    ]
  },
  "disk_percent": {
    "type": "bool",
    "default": false,
    "description": "Show disk usage percentage."
  },
  "ip_host": {
    "type": "string",
    "default": "api.ipify.org",
    "description": "URL to query for public IP."
  },
  "ip_timeout": {
    "type": "number",
    "default": 3,
    "description": "Public IP timeout in seconds."
  },
  "ip_interface": {
    "type": "string",
    "default": "any",
    "description": "Interface to use for local IP."
  },
  "song_format": {
    "type": "string",
    "default": "%t - %a",
    "description": "Format for song display. Common: '%t - %a' (title - artist)."
  },
  "song_shorthand": {
    "type": "bool",
    "default": false,
    "description": "Show Artist/Album/Title on separate lines."
  },
  "memory_percent": {
    "type": "bool",
    "default": false,
    "description": "Show memory usage percentage."
  },
  "memory_unit": {
    "type": "string",
    "default": "gib",
    "description": "Memory output unit: kib, mib, gib, tib."
  },
  "memory_precision": {
    "type": "number",
    "default": 2,
    "description": "Memory precision decimal places."
  },
  "color": {
    "type": "list",
    "default": [
      "2",
      "2",
      "2",
      "2",
      "2",
      "2"
    ],
    "description": "Text colors: title, @, underline, subtitle, colon, info."
  },
  "underline": {
    "type": "bool",
    "default": false,
    "description": "Enable underline."
  },
  "underline_char": {
    "type": "string",
    "default": "=",
    "description": "Character for underline."
  },
  "bold": {
    "type": "bool",
    "default": false,
    "description": "Enable bold text."
  },
  "separator": {
    "type": "string",
    "default": ":",
    "description": "Separator string between label and value."
  },
  "color_blocks": {
    "type": "bool",
    "default": false,
    "description": "Enable color blocks."
  },
  "col_offset": {
    "type": "string",
    "default": "auto",
    "description": "Color blocks left padding: auto or number.",
    "enum": [
      "auto",
      "0",
      "1",
      "2",
      "5",
      "6",
      "7",
      "8",
      "9"
    ]
  },
  "block_width": {
    "type": "number",
    "default": 4,
    "description": "Width of color blocks in spaces."
  },
  "block_height": {
    "type": "number",
    "default": 2,
    "description": "Height of color blocks in lines."
  },
  "block_range": {
    "type": "list",
    "default": [
      0,
      5
    ],
    "description": "Range of colors for blocks: start end."
  },
  "bar_char": {
    "type": "string",
    "default": "\u2588 \u2591",
    "description": "Bar characters: 'elapsed' 'total'."
  },
  "bar_border": {
    "type": "bool",
    "default": true,
    "description": "Surround bar with brackets."
  },
  "bar_length": {
    "type": "number",
    "default": 10,
    "description": "Length of bars in spaces."
  },
  "bar_colors": {
    "type": "list",
    "default": [
      "2",
      "2"
    ],
    "description": "Bar colors: elapsed, total."
  },
  "memory_display": {
    "type": "string",
    "default": "bar",
    "description": "Memory bar mode: bar, infobar, barinfo, off.",
    "enum": [
      "bar",
      "infobar",
      "barinfo",
      "off"
    ]
  },
  "battery_display": {
    "type": "string",
    "default": "off",
    "description": "Battery bar mode: bar, infobar, barinfo, off.",
    "enum": [
      "bar",
      "infobar",
      "barinfo",
      "off"
    ]
  },
  "disk_display": {
    "type": "string",
    "default": "bar",
    "description": "Disk bar mode: bar, infobar, barinfo, off.",
    "enum": [
      "bar",
      "infobar",
      "barinfo",
      "off"
    ]
  },
  "backend": {
    "type": "string",
    "default": "auto",
    "description": "Image backend: ascii, caca, catimg, chafa, jp2a, iterm2, off, sixel, tycat, w3m, kitty, viu."
  },
  "source": {
    "type": "string",
    "default": "auto",
    "description": "Image source: auto, ascii, wallpaper, path/to/img, etc.",
    "enum": [
      "auto",
      "ascii",
      "wallpaper"
    ]
  },
  "ascii_colors": {
    "type": "list",
    "default": [
      "2",
      "2",
      "2",
      "2",
      "2",
      "2"
    ],
    "description": "Colors for ASCII art (up to 6)."
  },
  "ascii_distro": {
    "type": "string",
    "default": "auto",
    "description": "Distro-specific ASCII logo."
  },
  "ascii_bold": {
    "type": "bool",
    "default": false,
    "description": "Bold ASCII logo."
  },
  "loop": {
    "type": "bool",
    "default": false,
    "description": "Redraw image constantly."
  },
  "size": {
    "type": "string",
    "default": "auto",
    "description": "Image size: auto, px, %, none.",
    "enum": [
      "auto",
      "px",
      "none"
    ]
  },
  "catimg_size": {
    "type": "string",
    "default": "1",
    "description": "Catimg resolution: 1 or 2.",
    "enum": [
      "1",
      "2"
    ]
  },
  "crop_mode": {
    "type": "string",
    "default": "normal",
    "description": "Crop mode: normal, fit, fill.",
    "enum": [
      "normal",
      "fit",
      "fill"
    ]
  },
  "crop_offset": {
    "type": "string",
    "default": "center",
    "description": "Crop offset: northwest, north, northeast, west, center, east, southwest, south, southeast.",
    "enum": [
      "northwest",
      "north",
      "northeast",
      "west",
      "center",
      "east",
      "southwest",
      "south",
      "southeast"
    ]
  },
  "xoffset": {
    "type": "number",
    "default": 0,
    "description": "Left offset for w3m backend."
  },
  "yoffset": {
    "type": "number",
    "default": 0,
    "description": "Top offset for w3m backend."
  },
  "bg_color": {
    "type": "string",
    "default": "black",
    "description": "Background color for w3m transparent images."
  },
  "gap": {
    "type": "number",
    "default": 0,
    "description": "Gap between image and text."
  },
  "clean": {
    "type": "bool",
    "default": false,
    "description": "Delete cached files and thumbnails."
  }
}
