{
  "service_name": "neowofetch",
  "info_display": [
    "all"
  ],
  "disable_info": [
    "battery",
    "local_ip"
  ],
  "title_fqdn": false,
  "package_managers": "tiny",
  "package_separate": true,
  "package_minimal": true,
  "os_arch": true,
  "speed_type": "current",
  "speed_shorthand": true,
  "cpu_brand": true,
  "cpu_cores": "logical",
  "cpu_speed": true,
  "cpu_temp": "C",
  "distro_shorthand": "tiny",
  "kernel_shorthand": true,
  "uptime_shorthand": "tiny",
  "refresh_rate": false,
  "gpu_brand": "NVIDIA",
  "gpu_type": "dedicated",
  "de_version": true,
  "gtk_shorthand": true,
  "gtk2": false,
  "gtk3": false,
  "shell_path": true,
  "shell_version": true,
  "editor_path": false,
  "editor_version": false,
  "disk_show": [
    "/",
    "/home"
  ],
  "disk_subtitle": "mount",
  "disk_percent": true,
  "ip_host": "api.ipify.org",
  "ip_timeout": 3,
  "ip_interface": "eth0",
  "song_format": "%t - %a (%l)",
  "song_shorthand": true,
  "memory_percent": true,
  "memory_unit": "gib",
  "memory_precision": 1,
  "color": [
    "1",
    "3",
    "4",
    "2",
    "6",
    "7"
  ],
  "underline": true,
  "underline_char": "-",
  "bold": false,
  "separator": " =",
  "color_blocks": true,
  "col_offset": "auto",
  "block_width": 6,
  "block_height": 2,
  "block_range": [
    0,
    5
  ],
  "bar_char": "\u2588 \u2591",
  "bar_border": true,
  "bar_length": 15,
  "bar_colors": [
    "2",
    "7"
  ],
  "memory_display": "infobar",
  "battery_display": "bar",
  "disk_display": "infobar",
  "backend": "chafa",
  "source": "wallpaper",
  "ascii_colors": [
    "1",
    "3",
    "4",
    "5",
    "6",
    "2"
  ],
  "ascii_distro": "auto",
  "ascii_bold": true,
  "loop": false,
  "size": "auto",
  "catimg_size": "1",
  "crop_mode": "fit",
  "crop_offset": "center",
  "xoffset": 0,
  "yoffset": 0,
  "bg_color": "black",
  "gap": 2,
  "clean": false
}
