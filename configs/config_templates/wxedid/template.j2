# wxedid configuration for offline EDID editing
# Specifies the path to the EDID source file to be edited.
# Can be a binary EDID blob or a DTD text file.
# Path to the EDID file (binary or DTD text)
edid_file: {{ edid_file | default('/etc/edid.bin') }}

# Treat the input file as DTD text instead of binary EDID data
# If true, assumes the edid_file is a DTD text file.
# Corresponds to the -t / --text option
text_mode: {{ text_mode | default(false) | lower }}

# Output directory for edited EDID files
# Directory where the edited/exported EDID data will be written.
output_dir: {{ output_dir | default('/tmp/edid_output') }}