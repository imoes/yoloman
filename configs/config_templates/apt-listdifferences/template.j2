# Configure the DPkg pre-install hook to run apt-listdifferences.
# This hook is executed before package installations via apt/dpkg.
# The default command checks if the utility exists and runs it non-fatally.
DPkg::Pre-Install-Pkgs { "{{ dpkg_pre_install_pkgs_command | default('test -x /usr/sbin/apt-listdifferences || exit 0; /usr/sbin/apt-listdifferences --apt || true') }}"; };