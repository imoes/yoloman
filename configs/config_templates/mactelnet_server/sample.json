{
  "listen_addr": "0.0.0.0",
  "listen_port": 23,
  "max_connections": 8,
  "timeout_seconds": 600,
  "debug": false,
  "loglevel": "warn",
  "logfile": "/var/log/mactelnetd.log",
  "auth_required": true,
  "auth_db": "/etc/mactelnet/users.db",
  "allowed_macs": [
    {
      "mac": "00:11:22:33:44:55",
      "username": "admin",
      "description": "Main admin workstation"
    },
    {
      "mac": "aa:bb:cc:dd:ee:ff",
      "username": "backup",
      "description": "Backup server console"
    }
  ],
  "denied_macs": [
    {
      "mac": "ff:ff:ff:00:00:00",
      "reason": "Known malicious host"
    }
  ],
  "tty_device": "",
  "banner_file": "/etc/mactelnet/banner.txt",
  "enable_web_interface": true,
  "web_addr": "127.0.0.1",
  "web_port": 8080,
  "web_ssl_cert": "/etc/mactelnet/web.crt",
  "web_ssl_key": "/etc/mactelnet/web.key",
  "web_ssl": true
}
