{
  "confver": {
    "type": "string",
    "default": "1.0",
    "description": "Configuration file version identifier."
  },
  "include_path": {
    "type": "string",
    "default": "/etc/ser2net/ser2net/*.yaml",
    "description": "Path to directory for including additional YAML configuration files."
  },
  "port_con00": {
    "type": "number",
    "default": 2012,
    "description": "TCP port for connection con00."
  },
  "device_con00": {
    "type": "string",
    "default": "/dev/ttyS0",
    "description": "Serial device path for connection con00."
  },
  "baud_con00": {
    "type": "string",
    "default": "9600n81",
    "description": "Baud rate and serial parameters for connection con00."
  },
  "port_con01": {
    "type": "number",
    "default": 2013,
    "description": "TCP port for connection con01."
  },
  "device_con01": {
    "type": "string",
    "default": "/dev/serial/by-path/platform-3f980000.usb-usb-0:1.2:1.0-port0",
    "description": "Serial device path for connection con01."
  },
  "baud_con01": {
    "type": "string",
    "default": "9600n81",
    "description": "Baud rate and serial parameters for connection con01."
  },
  "default_baud": {
    "type": "string",
    "default": "115200n81",
    "description": "Default baud rate setting."
  },
  "default_local": {
    "type": "bool",
    "default": true,
    "description": "Enable CLOCAL by default."
  },
  "port_admin": {
    "type": "number",
    "default": 2000,
    "description": "TCP port for the admin interface."
  },
  "mdns_admin": {
    "type": "bool",
    "default": true,
    "description": "Enable mDNS for the admin interface."
  },
  "led1_device": {
    "type": "string",
    "default": "tpacpi::standby",
    "description": "Sysfs device path for LED1 (activity flash)."
  },
  "led2_mode": {
    "type": "string",
    "default": "solid",
    "description": "Mode for LED2 (steady state).",
    "enum": [
      "transient",
      "solid"
    ]
  },
  "led2_device": {
    "type": "string",
    "default": "connled",
    "description": "Sysfs device path for LED2 (connection indicator)."
  },
  "serbase": {
    "type": "string",
    "default": "/dev/serial/by-path/pci-0000:00:1d.0",
    "description": "Base path for serial devices."
  },
  "port_con1": {
    "type": "number",
    "default": 2002,
    "description": "TCP port for connection con1."
  },
  "enable_con1": {
    "type": "string",
    "default": "off",
    "description": "Initial enable state for connection con1.",
    "enum": [
      "on",
      "off"
    ]
  },
  "port_con2": {
    "type": "number",
    "default": 2003,
    "description": "SCTP port for connection con2."
  },
  "baud_con2": {
    "type": "string",
    "default": "9600e71",
    "description": "Baud rate for connection con2."
  },
  "local_con2": {
    "type": "string",
    "default": "false",
    "description": "Local setting for connection con2.",
    "enum": [
      "true",
      "false",
      "on",
      "off"
    ]
  },
  "port_ipmicon1": {
    "type": "number",
    "default": 3022,
    "description": "TCP port for IPMI SOL connection."
  },
  "ipmi_user": {
    "type": "string",
    "default": "admin",
    "description": "Username for IPMI SOL connection."
  },
  "ipmi_host": {
    "type": "string",
    "default": "192.168.27.37",
    "description": "IP address for IPMI SOL connection."
  },
  "baud_ipmi": {
    "type": "string",
    "default": "115200",
    "description": "Baud rate for IPMI SOL connection."
  },
  "port_rot1": {
    "type": "number",
    "default": 2020,
    "description": "TCP port for rotator."
  },
  "addr_rot1": {
    "type": "string",
    "default": "192.168.27.3",
    "description": "Address to bind rotator to."
  },
  "ssl_cert_path": {
    "type": "string",
    "default": "/etc/ser2net/ser2net.crt",
    "description": "Path to SSL certificate file."
  },
  "ssl_key_path": {
    "type": "string",
    "default": "/etc/ser2net/ser2net.key",
    "description": "Path to SSL private key file."
  },
  "ssl_keydir": {
    "type": "string",
    "default": "/etc/ser2net",
    "description": "Directory for SSL key generation."
  },
