{
  "action": {
    "type": "string",
    "default": "list",
    "description": "Action to perform: calculate, change-mgmkey, delete, list, put, reset, retries, version, get-challenge, get-pubkey",
    "enum": [
      "calculate",
      "change-mgmkey",
      "delete",
      "list",
      "put",
      "reset",
      "retries",
      "version",
      "get-challenge",
      "get-pubkey"
    ]
  },
  "mgmkey": {
    "type": "string",
    "default": "00000000000000000000000000000000",
    "description": "Management key (Admin Access Code). Hex string or empty."
  },
  "new_mgmkey": {
    "type": "string",
    "default": "",
    "description": "New management key. Required for change-mgmkey action."
  },
  "credpwd": {
    "type": "string",
    "default": "",
    "description": "Credential password (User Access Code). Hex string or empty."
  },
  "label": {
    "type": "string",
    "default": "",
    "description": "Credential label."
  },
  "reader": {
    "type": "string",
    "default": "",
    "description": "Reader name to filter by."
  },
  "touch": {
    "type": "string",
    "default": "off",
    "description": "Touch required: off or on",
    "enum": [
      "off",
      "on"
    ]
  },
  "context": {
    "type": "string",
    "default": "",
    "description": "Session keys calculation context."
  },
  "verbose": {
    "type": "number",
    "default": 0,
    "description": "Verbosity level integer."
  },
  "derivation_password": {
    "type": "string",
    "default": "",
    "description": "Derivation password for PBKDF2 mode."
  },
  "enckey": {
    "type": "string",
    "default": "",
    "description": "Explicit encryption key hex string."
  },
  "mackey": {
    "type": "string",
    "default": "",
    "description": "Explicit MAC key hex string."
  },
  "privkey": {
    "type": "string",
    "default": "",
    "description": "Private key for asymmetric mode."
  }
}
