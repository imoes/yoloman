{
  "interface": "tun0",
  "gateway": "vpn.example.com",
  "psk": "mysecretpresharedkey123",
  "ike_dh_group": "modp1536",
  "ike_authmode": "psk",
  "ike_encryption": "aes",
  "ike_hash": "sha1",
  "ike_lifetime": 28800,
  "ipsec_encryption": "aes",
  "ipsec_hash": "sha1",
  "ipsec_pfs": "modp1024",
  "ipsec_lifetime": 3600,
  "local_ip": "",
  "local_port": 500,
  "ipsec_payload": "tunnel",
  "natt_mode": "on",
  "domain": [
    "example.com",
    "internal.example.com"
  ],
  "dns_servers": [
    "10.0.0.53",
    "10.0.0.54"
  ],
  "routes": [
    {
      "network": "10.10.0.0",
      "netmask": "255.255.0.0"
    },
    {
      "network": "172.16.10.0",
      "netmask": "255.255.255.0"
    }
  ],
  "no_nat": [
    {
      "network": "192.168.1.0",
      "netmask": "255.255.255.0"
    }
  ],
  "xauth_username": "jdoe",
  "xauth_password": "secret_password",
  "proxy_arp": "off",
  "debug": "off",
  "script": "/etc/vpnc/vpnc-script"
}
