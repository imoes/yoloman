{
  "key_table_path": "/etc/opendkim/KeyTable",
  "signing_table_path": "/etc/opendkim/SigningTable",
  "internal_hosts": [
    "127.0.0.1",
    "::1",
    "10.0.0.0/8"
  ],
  "external_ignore_list": [
    "127.0.0.0/8",
    "::1",
    "10.0.0.0/8",
    "192.168.0.0/16"
  ],
  "mode": "sv",
  "syslog": true,
  "syslog_success": false,
  "canonicalization": "relaxed/simple",
  "selector": "2024Q1",
  "domain": "",
  "socket": "local:/var/spool/postfix/opendkim/opendkim.sock",
  "pid_file": "/var/run/opendkim/opendkim.pid",
  "temp_file_directory": "/var/spool/opendkim",
  "trusted_keys_hosts": [],
  "signing_rules": [
    {
      "pattern": "@example.com",
      "key_path": "/etc/opendkim/keys/example.com/2024Q1.private"
    },
    {
      "pattern": "@example.org",
      "key_path": "/etc/opendkim/keys/example.org/2024Q1.private"
    }
  ]
}
