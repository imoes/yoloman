{
  "target_device": {
    "type": "string",
    "default": "124",
    "description": "Tegra SoC family: 20, 30, 114, 124, 132, or 210",
    "enum": [
      "20",
      "30",
      "114",
      "124",
      "132",
      "210"
    ]
  },
  "debug": {
    "type": "bool",
    "default": false,
    "description": "Enable debug output (adds '# Debug mode enabled' comment)"
  },
  "odm_data": {
    "type": "string",
    "default": "",
    "description": "ODM data value in hexadecimal (without '0x' prefix)"
  },
  "memory_init_code": {
    "type": "number",
    "default": 0,
    "description": "Offset/ID of memory initialization code in the BCT"
  },
  "memory_init_code_size": {
    "type": "number",
    "default": 0,
    "description": "Size in bytes of memory initialization code"
  },
  "bootloader_start": {
    "type": "string",
    "default": "0x0",
    "description": "Starting address of the bootloader image"
  },
  "bootloader_size": {
    "type": "string",
    "default": "0x0",
    "description": "Size in bytes of the bootloader image"
  },
  "memory_type": {
    "type": "string",
    "default": "DDR3",
    "description": "Memory type (e.g., DDR3, LPDDR4)"
  },
  "memory_clock_khz": {
    "type": "number",
    "default": 300000,
    "description": "Memory clock frequency in kHz"
  },
  "memory_technology": {
    "type": "string",
    "default": "DDR3",
    "description": "Memory technology variant"
  },
  "memory_addressing": {
    "type": "string",
    "default": "2R",
    "description": "Memory addressing mode (e.g., 1R, 2R)"
  },
  "cpu_clock_khz": {
    "type": "number",
    "default": 510000,
    "description": "CPU clock frequency in kHz"
  },
  "emc_clock_khz": {
    "type": "number",
    "default": 300000,
    "description": "EMC (external memory controller) clock frequency in kHz"
  },
  "boot_device": {
    "type": "string",
    "default": "emmc",
    "description": "Boot device type: 'emmc', 'sdmmc', 'spi', etc.",
    "enum": [
      "emmc",
      "sdmmc",
      "spi"
    ]
  },
  "emmc_boot_partition": {
    "type": "string",
    "default": "0",
    "description": "eMMC boot partition number",
    "enum": [
      "0",
      "1",
      "2"
    ]
  },
  "emmc_user_partition": {
    "type": "string",
    "default": "1",
    "description": "eMMC user partition number",
    "enum": [
      "1",
      "2",
      "3",
      "4"
    ]
  },
  "boot_parameters": {
    "type": "string",
    "default": "",
    "description": "Kernel command-line parameters for U-Boot or similar"
  },
  "secure_boot": {
    "type": "bool",
    "default": false,
    "description": "Enable secure boot"
  }
}
