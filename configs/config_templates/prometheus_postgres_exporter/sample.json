{
  "target_dsns": [
    "postgresql://repl_user:repl_pass@primary_host:5432/postgres?sslmode=require",
    "postgresql://repl_user:repl_pass@standby_host:5432/postgres?sslmode=require"
  ],
  "timeout": 10,
  "disabled_collectors": [
    "archive",
    "stat_activity"
  ],
  "enabled_collectors": [],
  "log_level": "warn",
  "web_listen_address": "127.0.0.1:9187",
  "tls_cert_file": "/etc/prometheus/tls/exporter.crt",
  "tls_key_file": "/etc/prometheus/tls/exporter.key",
  "basic_auth_user": "metrics_user",
  "basic_auth_pass": "s3cur3_p4ss",
  "query_path": "/etc/prometheus/postgres_exporter_queries.yml",
  "pg_version": "15.3",
  "export_database_size": true,
  "export_table_bloat": true,
  "wal_lag_warning": 50000000,
  "wal_lag_critical": 500000000
}
