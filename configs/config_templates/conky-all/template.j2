-- Conky, a system monitor https://github.com/brndnmtthws/conky
--
-- This configuration file is Lua code. You can write code in here, and it will
-- execute when Conky loads. You can use it to generate your own advanced
-- configurations.
--
-- For more on Lua, see: https://www.lua.org/pil/contents.html
-- Conky Lua API: https://conky.cc/lua

-- Configuration settings: https://conky.cc/config_settings
conky.config = {
    -- Alignment position of the conky window (e.g., top_left, top_right, bottom_left, etc.)
    alignment = '{{ alignment | default("top_left") }}',

    -- Whether to run conky in the background (detached from the terminal)
    background = {{ background | default(False) }},

    -- Width of the border around the conky window
    border_width = {{ border_width | default(1) }},

    -- Number of CPU samples used for averaging
    cpu_avg_samples = {{ cpu_avg_samples | default(2) }},

    -- Default text color
    default_color = '{{ default_color | default("white") }}',

    -- Default color for outlines
    default_outline_color = '{{ default_outline_color | default("white") }}',

    -- Default color for shading
    default_shade_color = '{{ default_shade_color | default("white") }}',

    -- Whether to use double buffering to reduce flicker
    double_buffer = {{ double_buffer | default(True) }},

    -- Whether to draw borders around text
    draw_borders = {{ draw_borders | default(False) }},

    -- Whether to draw borders around graphs
    draw_graph_borders = {{ draw_graph_borders | default(True) }},

    -- Whether to draw an outline
    draw_outline = {{ draw_outline | default(False) }},

    -- Whether to draw shades
    draw_shades = {{ draw_shades | default(False) }},

    -- Whether to print an extra newline at the end of output
    extra_newline = {{ extra_newline | default(False) }},

    -- Font to use for text
    font = '{{ font | default("DejaVu Sans Mono:size=12") }}',

    -- Horizontal gap (in pixels) between conky window and screen edge
    gap_x = {{ gap_x | default(60) }},

    -- Vertical gap (in pixels) between conky window and screen edge
    gap_y = {{ gap_y | default(60) }},

    -- Minimum height (in pixels) of the conky window
    minimum_height = {{ minimum_height | default(5) }},

    -- Minimum width (in pixels) of the conky window
    minimum_width = {{ minimum_width | default(5) }},

    -- Number of network samples used for averaging
    net_avg_samples = {{ net_avg_samples | default(2) }},

    -- Whether to avoid using buffers when reading /proc or /sys
    no_buffers = {{ no_buffers | default(True) }},

    -- Whether to output to stdout
    out_to_console = {{ out_to_console | default(False) }},

    -- Whether to output to ncurses (text mode)
    out_to_ncurses = {{ out_to_ncurses | default(False) }},

    -- Whether to output to stderr
    out_to_stderr = {{ out_to_stderr | default(False) }},

    -- Whether to output to Wayland compositor (if supported)
    out_to_wayland = {{ out_to_wayland | default(False) }},

    -- Whether to output to X11
    out_to_x = {{ out_to_x | default(True) }},

    -- Whether to create a separate window for conky
    own_window = {{ own_window | default(True) }},

    -- Window class name for the conky window
    own_window_class = '{{ own_window_class | default("Conky") }}',

    -- Window type (e.g., normal, desktop, dock, panel)
    own_window_type = '{{ own_window_type | default("normal") }}',

    -- Window hints for window manager behavior
    own_window_hints = '{{ own_window_hints | default("undecorated,sticky,below,skip_taskbar,skip_pager") }}',

    -- Whether to show graph range
    show_graph_range = {{ show_graph_range | default(False) }},

    -- Whether to show graph scale
    show_graph_scale = {{ show_graph_scale | default(False) }},

    -- Whether to use stippled borders
    stippled_borders = {{ stippled_borders | default(0) }},

    -- Update interval in seconds
    update_interval = {{ update_interval | default(1.0) }},

    -- Whether to uppercase all text
    uppercase = {{ uppercase | default(False) }},

    -- Where to place spacers (none, left, right)
    use_spacer = '{{ use_spacer | default("none") }}',

    -- Whether to use Xft fonts
    use_xft = {{ use_xft | default(True) }},
}

-- Variables: https://conky.cc/variables
conky.text = [[
${color grey}Info:$color ${scroll 32 Conky $conky_version - $sysname $nodename $kernel $machine}
$hr
${color grey}Uptime:$color $uptime
${color grey}Frequency (in MHz):$color $freq
${color grey}Frequency (in GHz):$color $freq_g
${color grey}RAM Usage:$color $mem/$memmax - $memperc% ${membar 4}
${color grey}Swap Usage:$color $swap/$swapmax - $swapperc% ${swapbar 4}
${color grey}CPU Usage:$color $cpu% ${cpubar 4}
${color grey}Processes:$color $processes  ${color grey}Running:$color $running_processes
$hr
${color grey}File systems:
 / $color${fs_used /}/${fs_size /} ${fs_bar 6 /}
${color grey}Networking:
Up:$color ${upspeed} ${color grey} - Down:$color ${downspeed}
$hr
${color grey}Name              PID     CPU%   MEM%
${color lightgrey} ${top name 1} ${top pid 1} ${top cpu 1} ${top mem 1}
${color lightgrey} ${top name 2} ${top pid 2} ${top cpu 2} ${top mem 2}
${color lightgrey} ${top name 3} ${top pid 3} ${top cpu 3} ${top mem 3}
${color lightgrey} ${top name 4} ${top pid 4} ${top cpu 4} ${top mem 4}
]]