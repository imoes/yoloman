# MariaDB LZO Compression Provider Plugin Configuration
# This template configures the provider_lzo plugin for MariaDB/MySQL.
# The plugin allows the storage engine to use LZO compression for data compression.

[server]
# Name of the LZO compression plugin to load for MariaDB.
# Default: provider_lzo
plugin_load_add={{ plugin_load_add | default('provider_lzo') }}

# Loading mode for the LZO plugin.
# Options typically include 'force', 'force_permanent', 'force_plus_permanent', etc.
# 'force_plus_permanent' ensures the plugin is loaded at startup and cannot be unloaded.
# Default: force_plus_permanent
provider_lzo={{ provider_lzo | default('force_plus_permanent') }}
