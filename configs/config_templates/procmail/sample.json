{
  "logpath": "/home/user/.procmaillog",
  "verbose": "no",
  "maildir": "/home/user/Maildir",
  "default_folder": "mbox",
  "orgmail": "/home/user/Maildir",
  "bounce_on_error": "yes",
  "safepath": "",
  "dropprivs": "yes",
  "recipes": [
    {
      "conditions": [
        "^From:.*spam"
      ],
      "action": "/dev/null"
    },
    {
      "conditions": [
        "^Subject:.*Flame"
      ],
      "action": "/dev/null"
    },
    {
      "conditions": [],
      "action": "inbox"
    }
  ]
}
