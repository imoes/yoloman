{
  "enabled": true,
  "mode": "block",
  "log_level": "info",
  "proxy": {
    "host": "squid.internal",
    "port": 3128,
    "timeout": 45
  },
  "api": {
    "url": "https://filter.school.local/api/v2",
    "key": "sk_live_abc123..."
  },
  "block_categories": [
    "malware",
    "phishing",
    "porn",
    "gaming"
  ],
  "exception_domains": [
    "school.local",
    "edu.example.org"
  ],
  "exception_hosts": [
    "intranet",
    "backup"
  ],
  "exception_urls": [
    {
      "url": "https://docs.school.local/guides/",
      "comment": "Internal documentation"
    },
    {
      "url": "https://learning-management.example.org/"
    }
  ],
  "rate_limiting": {
    "enabled": true,
    "requests_per_minute": 120,
    "burst_size": 25
  }
}
