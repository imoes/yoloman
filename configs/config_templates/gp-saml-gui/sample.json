{
  "server": "vpn.example.com",
  "gateway": true,
  "no_cookies": false,
  "cookies_file": "/run/user/1000/gp-saml-gui.cookies",
  "cert_file": "/etc/ssl/client/vpn-client.pem",
  "key_file": "",
  "clientos": "Linux",
  "extra_fields": [
    "department=IT",
    "project=secure-vpn"
  ],
  "pkexec_openconnect": true,
  "sudo_openconnect": false,
  "exec_openconnect": false,
  "no_verify": false,
  "external_browser": false,
  "uri_mode": false,
  "verbose": true,
  "quiet": false,
  "openconnect_extra": [
    "--no-dtls",
    "--user-agent=AnyConnect-VPN-Agent/1.0"
  ],
  "gp_saml_gui_bin": "/usr/bin/gp-saml-gui"
}
