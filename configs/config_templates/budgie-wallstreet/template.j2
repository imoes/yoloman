# Desktop Entry for Budgie WallStreet autostart
# Manages wallpaper changes via the wallstreet executable.
# This file is placed in a desktop autostart directory (e.g., ~/.config/autostart/).

[Desktop Entry]
# Entry type; must be Application for executable launchers.
Type=Application

# Display name used by the desktop environment.
Name=WallStreet

# Brief description of the application's function.
Comment=Kick starts the wallstreet process to manage wallpaper changes

# Full path to the executable that runs the application.
Exec={{ exec_path | default('/usr/lib/budgie-wallstreet/wallstreet') }}

# Hide from application menus; only show in session startup settings.
NoDisplay=true

# Autostart condition based on a GSettings boolean key.
# The DE will check if the key exists and is true before launching.
AutostartCondition=GSettings {{ gsettings_schema | default('org.ubuntubudgie.budgie-wallstreet') }} {{ gsettings_key | default('runwallstreet') }}

# Hint for MATE desktop to automatically restart the process if it crashes.
X-MATE-AutoRestart=true

# Hint for GNOME desktop to automatically restart the process if it crashes.
X-GNOME-AutoRestart=true