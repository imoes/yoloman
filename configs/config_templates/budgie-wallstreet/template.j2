# Desktop Entry for Budgie-Wallstreet Autostart
# This file configures the automatic launch of the WallStreet wallpaper manager
# within the Budgie desktop environment via the standard XDG autostart mechanism.

[Desktop Entry]

# Application type; must be Application for executable programs.
Type=Application

# Display name of the application as shown in session settings.
Name=WallStreet

# Brief description of the application's function.
Comment=Kick starts the wallstreet process to manage wallpaper changes

# Path to the WallStreet executable.
# Default: /usr/lib/budgie-wallstreet/wallstreet
Exec={{ exec_path | default('/usr/lib/budgie-wallstreet/wallstreet') }}

# Prevent the application from appearing in application menus or taskbars.
# It runs silently in the background.
NoDisplay=true

# Autostart condition: uses GSettings to control whether the application starts.
# The value of the specified key determines if the launch is permitted.
# Schema: {{ gsettings_schema | default('org.ubuntubudgie.budgie-wallstreet') }}
# Key: {{ gsettings_key | default('runwallstreet') }}
AutostartCondition=GSettings {{ gsettings_schema | default('org.ubuntubudgie.budgie-wallstreet') }} {{ gsettings_key | default('runwallstreet') }}

# Compatibility flags for other desktop environments.
# Ensures the process restarts if it crashes unexpectedly.
X-MATE-AutoRestart=true
X-GNOME-AutoRestart=true
