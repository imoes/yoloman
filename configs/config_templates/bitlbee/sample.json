{
  "port": 6667,
  "max_connections": 50,
  "max_accounts_per_user": 5,
  "max_message_length": 512,
  "log_level": 3,
  "log_file": "/var/log/bitlbee/bitlbee.log",
  "auth_mode": "password",
  "root_dir": "/var/lib/bitlbee",
  "idle_timeout": 600,
  "reconnect_delay": 10,
  "reconnect_max_tries": 3,
  "allow_nick_changes": true,
  "allow_register": false,
  "ssl_enabled": true,
  "ssl_cert_path": "/etc/bitlbee/ssl/cert.pem",
  "ssl_key_path": "/etc/bitlbee/ssl/key.pem",
  "hostname": "irc.example.com",
  "dns_timeout": 15,
  "ipv6_enabled": false,
  "proxy": {
    "type": "none"
  },
  "plugins": [
    "/usr/lib/bitlbee/yahoo2.so"
  ],
  "plugin_options": [
    {
      "key": "yahoo2_timeout",
      "value": "30",
      "description": "Connection timeout for Yahoo plugin"
    }
  ],
  "allowed_protocols": [
    "jabber",
    "irc",
    "twitter"
  ],
  "default_account_settings": [
    {
      "name": "auto_connect",
      "value": "true",
      "description": "Auto-connect on startup"
    },
    {
      "name": "auto_login",
      "value": "true",
      "description": "Auto-login after connecting"
    }
  ],
  "unixsocket_path": "/var/run/bitlbee/bitlbee.sock",
  "unixsocket_perms": "0750",
  "jsonrpc_enabled": false
}
