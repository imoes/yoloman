# ==============================================================================
# PowerDNS Authoritative: LMDB Backend Configuration
# ==============================================================================
# This template configures the 'lmdb' backend for PowerDNS.
# LMDB (Lightning Memory-Mapped Database) provides high-performance,
# single-process storage for DNS zones.
# ==============================================================================

# --------------------------------------------------------------------------
# Backend Launch Directive
# --------------------------------------------------------------------------
# Specifies which backend modules PowerDNS should load and use for authoritative
# DNS operations. 'lmdb' enables the LMDB storage backend.
# Source: https://docs.powerdns.com/authoritative/backends/lmdb.html
# The launch directive is static in this context as we are configuring
# the specific lmdb backend parameters.
launch+=lmdb

# --------------------------------------------------------------------------
# LMDB Database Filename
# --------------------------------------------------------------------------
# Specifies the path to the LMDB database file.
# This file stores all authoritative zone data. Ensure the PowerDNS user
# has read/write permissions on this file and its parent directory.
#
# Schema Field: lmdb_filename
# Default: /var/lib/powerdns/pdns.lmdb
lmdb-filename={{ lmdb_filename | default('/var/lib/powerdns/pdns.lmdb') }}
