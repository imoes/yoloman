# Configuration file for m17n-db (M17N Database)
# This template configures the behavior of the m17n-db command-line tool
# used for selecting and querying multilingual character sets, scripts,
# and input methods.
#
# See `man m17n-db` for full documentation on available tags and modes.

{# -------------------------------------------------------------------------- #}
{# SECTION: Database Tags Filtering                                          #}
{# -------------------------------------------------------------------------- #}
{# The 'tags' variable is a list of strings. It corresponds to the --tags   #}
{# command-line argument of m17n-db. It filters the database query results  #}
{# to only include entries matching the specified tags (e.g., language codes #}
{# like 'en', 'fr' or scripts like 'utf-8').                               #}
{# If undefined, defaults to ['en', 'utf-8'].                              #}
# Comma-separated list of database tags to query.
# Valid tags include: language, script, keyboard, font, etc.
# See m17n-db(1) for available tags.
db_tags = {{ tags | default(['en', 'utf-8']) | join(", ") }}

{# -------------------------------------------------------------------------- #}
{# SECTION: Output Mode                                                       #}
{# -------------------------------------------------------------------------- #}
{# The 'output_mode' variable controls how m17n-db returns information.     #}
# 'path' returns absolute pathnames of matching database files (default).
# 'info' returns descriptive information about the database entries.
# 'locate' is typically handled by the --locate flag, but this setting
# defaults to 'path' for script usage.
output_mode = {{ output_mode | default('path') }}