{
  "var_path": "/var/lib/opencryptoki",
  "debug": false,
  "max_threads": 4,
  "modules": [
    {
      "name": "ctapi",
      "path": "/usr/lib/opencryptoki/libpkcs11-ctapi.so",
      "description": "CT-API-based hardware token interface",
      "enabled": true,
      "parameters": {
        "device": "/dev/ctapi0",
        "timeout": 5000
      }
    },
    {
      "name": "sw",
      "path": "/usr/lib/opencryptoki/libpkcs11-sw.so",
      "description": "Software-based soft token (for testing)",
      "enabled": true,
      "parameters": {
        "keydir": "/var/lib/opencryptoki/keys",
        "maxkeys": 256
      }
    }
  ],
  "slot_defaults": {
    "slot_id": 0,
    "user_pin": "",
    "manual_token_init": true
  }
}
