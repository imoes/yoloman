# OpenCryptoki PKCS#11 configuration template.
# This file defines hardware and software crypto tokens (slots) for the
# OpenCryptoki framework. Each slot maps a slot number to a shared library
# (driver) and optional configuration.
#
# See `man 5 opencryptoki.conf` for full syntax details.
# Generated by Ansible Jinja2.

version opencryptoki-3.23

# Global defaults (informational only, not parsed as directives):
#	hwversion = "0.0"
#	firmwareversion = "0.0"
#	description = Linux
#	manufacturer = IBM

# ---------------------------------------------------------------------------
# Slot 0: TPM PKCS#11 module
# Slot number for the TPM PKCS#11 module.
# ---------------------------------------------------------------------------
slot {{ slot_0_index | default(0) }}
{
    # Shared library for the TPM token module.
    stdll = {{ slot_0_stdll | default('libpkcs11_tpm.so') }}

    # Token version for the TPM module.
    tokversion = {{ slot_0_tokversion | default('3.12') }}
}

# ---------------------------------------------------------------------------
# Slot 1: ICA PKCS#11 module
# Slot number for the ICA PKCS#11 module.
# ---------------------------------------------------------------------------
slot {{ slot_1_index | default(1) }}
{
    # Shared library for the ICA token module.
    stdll = {{ slot_1_stdll | default('libpkcs11_ica.so') }}

    # Token version for the ICA module.
    tokversion = {{ slot_1_tokversion | default('3.12') }}
}

# ---------------------------------------------------------------------------
# Slot 2: CCA PKCS#11 module
# Slot number for the CCA PKCS#11 module.
# ---------------------------------------------------------------------------
slot {{ slot_2_index | default(2) }}
{
    # Shared library for the CCA token module.
    stdll = {{ slot_2_stdll | default('libpkcs11_cca.so') }}

    # Configuration filename for the CCA token module.
    confname = {{ slot_2_confname | default('ccatok.conf') }}

    # Token version for the CCA module.
    tokversion = {{ slot_2_tokversion | default('3.12') }}
}

# ---------------------------------------------------------------------------
# Slot 3: Software PKCS#11 module
# Slot number for the Software PKCS#11 module.
# ---------------------------------------------------------------------------
slot {{ slot_3_index | default(3) }}
{
    # Shared library for the software token module.
    stdll = {{ slot_3_stdll | default('libpkcs11_sw.so') }}

    # Token version for the software module.
    tokversion = {{ slot_3_tokversion | default('3.12') }}
}

# ---------------------------------------------------------------------------
# Slot 4: EP11 PKCS#11 module
# Slot number for the EP11 PKCS#11 module.
# ---------------------------------------------------------------------------
slot {{ slot_4_index | default(4) }}
{
    # Shared library for the EP11 token module.
    stdll = {{ slot_4_stdll | default('libpkcs11_ep11.so') }}

    # Configuration filename for the EP11 token module.
    confname = {{ slot_4_confname | default('ep11tok.conf') }}

    # Token version for the EP11 module.
    tokversion = {{ slot_4_tokversion | default('3.12') }}
}