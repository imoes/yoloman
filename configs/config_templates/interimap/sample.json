{
  "log_file": "/var/log/interimap.log",
  "log_level": "INFO",
  "max_concurrent_accounts": 5,
  "max_connections_per_account": 4,
  "retry_delay": 10,
  "dry_run": false,
  "verbose": false,
  "qresync": true,
  "validate_uidvalidity": true,
  "temp_state_ttl": 600,
  "state_dir": "/var/lib/interimap",
  "tls_ca_bundle": "/etc/ssl/certs/ca-certificates.crt",
  "accounts": [
    {
      "name": "work-to-personal",
      "source_host": "imap.work.example.com",
      "source_port": 993,
      "source_user": "user@work.example.com",
      "source_use_ssl": true,
      "source_tls": false,
      "source_skip_tls_verify": false,
      "dest_host": "imap.gmail.com",
      "dest_port": 993,
      "dest_user": "user.personal@gmail.com",
      "dest_use_ssl": true,
      "dest_tls": false,
      "dest_skip_tls_verify": false,
      "direction": "both",
      "folder_prefix": "Work/",
      "folder_patterns": [
        "+INBOX",
        "+Sent",
        "+Drafts",
        "-*Junk*",
        "-*Spam*"
      ],
      "folder_mapping": {
        "INBOX": "Inbox",
        "Sent": "Sent Mail",
        "Drafts": "Drafts"
      },
      "batch_size": 500,
      "concurrent_folder_sync": 3,
      "flag_sync": "both",
      "ignore_flags": [
        "\\Recent"
      ]
    }
  ]
}
