# Gfarm gfsd Daemon Configuration
# Generated by Ansible Jinja2 Template.
# See schema for field descriptions and defaults.

[global]
# Enable verbose debugging output to log for diagnostics.
# Default: False
debug = {{ (debug | default(False)) | lower }}

# Absolute path to the main log file.
# Default: /var/log/gfarm2/gfsd.log
log_file = {{ log_file | default('/var/log/gfarm2/gfsd.log') }}

# Maximum size (in MB) of the log file before rotation.
# Default: 100
log_max_size = {{ log_max_size | default(100) }}

# Number of rotated log files to keep.
# Default: 5
log_retention = {{ log_retention | default(5) }}

# Number of worker threads to handle client requests.
# Default: 8
num_threads = {{ num_threads | default(8) }}

# IP address or hostname to bind metadata services to.
# Default: 0.0.0.0
bind_address = {{ bind_address | default('0.0.0.0') }}

# Port number for metadata protocol communication.
# Default: 15001
metadata_port = {{ metadata_port | default(15001) }}

# Enable asynchronous replication of metadata between gfsd instances.
# Default: True
enable_replication = {{ (enable_replication | default(True)) | lower }}

# Timeout (in seconds) for metadata replication operations.
# Default: 30
replication_timeout = {{ replication_timeout | default(30) }}

# List of GFM master servers for metadata coordination.
# Default: ['gfm-master.example.com']
{% for host in (master_hosts | default(['gfm-master.example.com'])) %}
master_host = {{ host }}
{% endfor %}

# List of GFM servers to contact for metadata operations.
# Default: ['gfm-1.example.com', 'gfm-2.example.com']
{% for host in (gfm_hosts | default(['gfm-1.example.com', 'gfm-2.example.com'])) %}
gfm_host = {{ host }}
{% endfor %}

[pool]
# Connection pool settings for backend storage.
# Default: {'max_connections': 10, 'connect_timeout': 5, 'idle_timeout': 300}
{% set pool = pool | default({'max_connections': 10, 'connect_timeout': 5, 'idle_timeout': 300}) %}
# Maximum number of connections in the pool.
# Default: 10
max_connections = {{ pool.max_connections | default(10) }}

# Timeout (in seconds) to establish a new connection.
# Default: 5
connect_timeout = {{ pool.connect_timeout | default(5) }}

# Idle timeout (in seconds) before closing unused connections.
# Default: 300
idle_timeout = {{ pool.idle_timeout | default(300) }}

[storage]
# Metadata storage configuration (database backend and credentials).
# Default: {'backend': 'postgresql', 'postgresql_host': 'localhost', 'postgresql_port': 5432, 'postgresql_user': 'gfarm', 'postgresql_password': '', 'postgresql_database': 'gfarm2', 'postgresql_sslmode': 'prefer', 'sqlite_db': '/var/lib/gfarm2/gfarm2.db'}
{% set storage = storage | default({'backend': 'postgresql', 'postgresql_host': 'localhost', 'postgresql_port': 5432, 'postgresql_user': 'gfarm', 'postgresql_password': '', 'postgresql_database': 'gfarm2', 'postgresql_sslmode': 'prefer', 'sqlite_db': '/var/lib/gfarm2/gfarm2.db'}) %}
# Default metadata backend type (e.g., mysql, postgresql, sqlite).
# Default: postgresql
backend = {{ storage.backend | default('postgresql') }}

# Path to SQLite database file (only used if backend=sqlite).
# Default: /var/lib/gfarm2/gfarm2.db
{% if storage.backend | default('postgresql') == 'sqlite' %}
sqlite_db = {{ storage.sqlite_db | default('/var/lib/gfarm2/gfarm2.db') }}
{% endif %}

# MySQL connection parameters (only used if backend=mysql).
{% if storage.backend | default('postgresql') == 'mysql' %}
# MySQL Host
# Default: localhost
mysql_host = {{ (storage | default({})).mysql_host | default('localhost') }}
# MySQL Port
# Default: 3306
mysql_port = {{ (storage | default({})).mysql_port | default(3306) }}
# MySQL User
# Default: gfarm
mysql_user = {{ (storage | default({})).mysql_user | default('gfarm') }}
# MySQL Password
# Default: (empty)
mysql_password = {{ (storage | default({})).mysql_password | default('') }}
# MySQL Database
# Default: gfarm2
mysql_database = {{ (storage | default({})).mysql_database | default('gfarm2') }}
# MySQL Charset (not in schema, defaulting to utf8mb4)
mysql_charset = utf8mb4
{% endif %}

# PostgreSQL connection parameters (only used if backend=postgresql).
{% if storage.backend | default('postgresql') == 'postgresql' %}
# PostgreSQL Host
# Default: localhost
postgresql_host = {{ (storage | default({})).postgresql_host | default('localhost') }}
# PostgreSQL Port
# Default: 5432
postgresql_port = {{ (storage | default({})).postgresql_port | default(5432) }}
# PostgreSQL User
# Default: gfarm
postgresql_user = {{ (storage | default({})).postgresql_user | default('gfarm') }}
# PostgreSQL Password
# Default: (empty)
postgresql_password = {{ (storage | default({})).postgresql_password | default('') }}
# PostgreSQL Database
# Default: gfarm2
postgresql_database = {{ (storage | default({})).postgresql_database | default('gfarm2') }}
# PostgreSQL SSL Mode
# Default: prefer
postgresql_sslmode = {{ (storage | default({})).postgresql_sslmode | default('prefer') }}
{% endif %}

[security]
# Authentication and security settings.
# Default: {'auth_method': 'KERBEROS', 'kerberos_keytab': '/etc/gfarm2/gfarm2.keytab', 'gsi_proxy_cert': '/tmp/x509up_u0', 'ca_cert_dir': '/etc/grid-security/certificates', 'enable_client_cert_verify': True}
{% set security = security | default({'auth_method': 'KERBEROS', 'kerberos_keytab': '/etc/gfarm2/gfarm2.keytab', 'gsi_proxy_cert': '/tmp/x509up_u0', 'ca_cert_dir': '/etc/grid-security/certificates', 'enable_client_cert_verify': True}) %}
# Enable secure authentication (e.g., GSI, KERBEROS, PASSWORD).
# Default: KERBEROS
auth_method = {{ security.auth_method | default('KERBEROS') }}

# Path to the Kerberos keytab file (only if auth_method=KERBEROS).
# Default: /etc/gfarm2/gfarm2.keytab
{% if security.auth_method | default('KERBEROS') == 'KERBEROS' %}
kerberos_keytab = {{ security.kerberos_keytab | default('/etc/gfarm2/gfarm2.keytab') }}
{% endif %}

# Path to the GSI proxy certificate (only if auth_method=GSI).
# Default: /tmp/x509up_u0
{% if security.auth_method | default('KERBEROS') == 'GSI' %}
gsi_proxy_cert = {{ security.gsi_proxy_cert | default('/tmp/x509up_u0') }}
{% endif %}

# Path to the trusted CA certificate directory (used by GSI/Kerberos).
# Default: /etc/grid-security/certificates
ca_cert_dir = {{ security.ca_cert_dir | default('/etc/grid-security/certificates') }}

# Enable client certificate verification (only for GSI).
# Default: True
enable_client_cert_verify = {{ (security.enable_client_cert_verify | default(True)) | lower }}

[limits]
# Resource and behavior limits for client sessions.
# Default: {'max_connections_per_client': 100, 'max_upload_size': 10240, 'max_open_files': 1024, 'max_memory_per_request': 512, 'idle_timeout': 600}
{% set limits = limits | default({'max_connections_per_client': 100, 'max_upload_size': 10240, 'max_open_files': 1024, 'max_memory_per_request': 512, 'idle_timeout': 600}) %}
# Maximum number of concurrent connections per client.
# Default: 100
max_connections_per_client = {{ limits.max_connections_per_client | default(100) }}

# Maximum file upload size (in MB).
# Default: 10240
max_upload_size = {{ limits.max_upload_size | default(10240) }}

# Maximum number of files a user can have open at once.
# Default: 1024
max_open_files = {{ limits.max_open_files | default(1024) }}

# Maximum memory (in MB) a single request may use.
# Default: 512
max_memory_per_request = {{ limits.max_memory_per_request | default(512) }}

# Time (in seconds) before idle client connections are closed.
# Default: 600
idle_timeout = {{ limits.idle_timeout | default(600) }}

[replica]
# File replication policy configuration.
# Default: {'default_replication_factor': 3, 'enable_lazy_replication': False, 'lazy_replication_delay': 300, 'policies': ['leastloaded', 'roundrobin']}
{% set replica = replica | default({'default_replication_factor': 3, 'enable_lazy_replication': False, 'lazy_replication_delay': 300, 'policies': ['leastloaded', 'roundrobin']}) %}
# Default replication factor (number of copies of each file).
# Default: 3
default_replication_factor = {{ replica.default_replication_factor | default(3) }}

# Enable or disable lazy replication (writes only to one replica, syncs later).
# Default: False
enable_lazy_replication = {{ (replica.enable_lazy_replication | default(False)) | lower }}

# Delay (in seconds) before lazy replication kicks in.
# Default: 300
lazy_replication_delay = {{ replica.lazy_replication_delay | default(300) }}

# List of replica allocation policies (e.g., random, roundrobin, leastloaded).
# Default: ['leastloaded', 'roundrobin']
{% for policy in (replica.policies | default(['leastloaded', 'roundrobin'])) %}
policy = {{ policy }}
{% endfor %}

[quota]
# User and project quota enforcement settings.
# Default: {'enable_quotas': False, 'backend': 'sqlite', 'sqlite_db': '/var/lib/gfarm2/quota.db', 'mysql_host': 'localhost', 'mysql_port': 3306, 'mysql_user': 'gfarm', 'mysql_password': '', 'mysql_database': 'gfarm2_quota', 'postgresql_host': 'localhost', 'postgresql_port': 5432, 'postgresql_user': 'gfarm', 'postgresql_password': '', 'postgresql_database': 'gfarm2_quota'}
{% set quota = quota | default({'enable_quotas': False, 'backend': 'sqlite', 'sqlite_db': '/var/lib/gfarm2/quota.db', 'mysql_host': 'localhost', 'mysql_port': 3306, 'mysql_user': 'gfarm', 'mysql_password': '', 'mysql_database': 'gfarm2_quota', 'postgresql_host': 'localhost', 'postgresql_port': 5432, 'postgresql_user': 'gfarm', 'postgresql_password': '', 'postgresql_database': 'gfarm2_quota'}) %}
# Enable per-user or per-project quota enforcement.
# Default: False
enable_quotas = {{ (quota.enable_quotas | default(False)) | lower }}

# Quota enforcement backend (e.g., mysql, sqlite, none).
# Default: sqlite
backend = {{ quota.backend | default('sqlite') }}

# SQLite path (only if backend=sqlite).
# Default: /var/lib/gfarm2/quota.db
{% if quota.backend | default('sqlite') == 'sqlite' %}
sqlite_db = {{ quota.sqlite_db | default('/var/lib/gfarm2/quota.db') }}
{% endif %}

# MySQL parameters (only if backend=mysql).
{% if quota.backend | default('sqlite') == 'mysql' %}
# MySQL Host
# Default: localhost
mysql_host = {{ (quota | default({})).mysql_host | default('localhost') }}
# MySQL Port
# Default: 3306
mysql_port = {{ (quota | default({})).mysql_port | default(3306) }}
# MySQL User
# Default: gfarm
mysql_user = {{ (quota | default({})).mysql_user | default('gfarm') }}
# MySQL Password
# Default: (empty)
mysql_password = {{ (quota | default({})).mysql_password | default('') }}
# MySQL Database
# Default: gfarm2_quota
mysql_database = {{ (quota | default({})).mysql_database | default('gfarm2_quota') }}
{% endif %}

# PostgreSQL parameters (only if backend=postgresql).
{% if quota.backend | default('sqlite') == 'postgresql' %}
# PostgreSQL Host
# Default: localhost
postgresql_host = {{ (quota | default({})).postgresql_host | default('localhost') }}
# PostgreSQL Port
# Default: 5432
postgresql_port = {{ (quota | default({})).postgresql_port | default(5432) }}
# PostgreSQL User
# Default: gfarm
postgresql_user = {{ (quota | default({})).postgresql_user | default('gfarm') }}
# PostgreSQL Password
# Default: (empty)
postgresql_password = {{ (quota | default({})).postgresql_password | default('') }}
# PostgreSQL Database
# Default: gfarm2_quota
postgresql_database = {{ (quota | default({})).postgresql_database | default('gfarm2_quota') }}
{% endif %}