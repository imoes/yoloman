{
  "enable_dbserver": true,
  "threads": 8,
  "maxentries": 200000,
  "workdir": "/var/lib/openafs/dbserver",
  "logpath": "/var/log/openafs/dbserver.log",
  "peers": [
    {
      "host": "db1.example.com",
      "port": 7007
    },
    {
      "host": "db2.example.com",
      "port": 7007
    }
  ],
  "cells": [
    {
      "name": "example.com",
      "dbpath": "/usr/afs/db"
    }
  ],
  "verbose": false,
  "backup_mode": false,
  "maxdumpsize": 2048,
  "dumppath": "/var/lib/openafs/dump",
  "use_tls": true,
  "tls_cert_path": "/etc/openafs/servercert.pem",
  "tls_key_path": "/etc/openafs/serverkey.pem"
}
