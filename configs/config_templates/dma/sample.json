{
  "bind_address": "0.0.0.0",
  "smtp_port": 25,
  "max_connections": 100,
  "connect_timeout": 300,
  "relay_nets": [
    "127.0.0.0/8",
    "10.0.0.0/8"
  ],
  "local_domains": [
    "localhost",
    "example.com",
    "mail.example.com"
  ],
  "tls_enabled": true,
  "tls_cert": "/etc/dma/tls/fullchain.pem",
  "tls_key": "/etc/dma/tls/privkey.pem",
  "tls_ciphers": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256",
  "require_starttls": false,
  "opportunistic_tls": true,
  "smtp_auth_method": "plain",
  "smtp_auth_file": "/etc/dma/passwd",
  "max_message_size": 26214400,
  "default_sender": "postmaster@example.com",
  "queue_dir": "/var/spool/dma",
  "delivery_workers": 8,
  "retry_interval": 300,
  "max_retries": 7,
  "verbose_logging": false,
  "use_syslog": true,
  "log_file": "/var/log/dma.log",
  "max_log_size": 10485760,
  "log_rotate_count": 10,
  "rewrite_sender": "",
  "alias_file": "/etc/aliases",
  "delivery_mode": "relay",
  "relay_host": "smtp.gmail.com:587",
  "relay_user": "user@example.com",
  "relay_pass": "app-password-here",
  "relay_tls": true
}
