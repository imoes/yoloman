[General]
# Interval between interface updates, in tenths of seconds.
# Delay between updates in tenths of seconds (e.g., 10 for 1 second).
interval = {{ update_interval | default(10) }}

# Enable color support in the interface.
# Enable color output in the interface.
color = {{ color_enabled | default(True) }}

[Devices]
# Temperature scale: Celsius or Fahrenheit.
# Temperature scale, either 'celsius' or 'fahrenheit'.
temperature_unit = {{ temperature_unit | default('celsius') }}

# Auto-hide timer for encoder/decoder meters in seconds. -1 for always visible.
# Seconds of inactivity before encoder/decoder meters hide. Use -1 to always show.
encode_hide_timer = {{ encode_hide_timer | default(30) }}

[Chart]
# Reverse the plot data order (recent to old vs old to recent).
# Reverse the plot data order to show recent data first.
reverse_abs = {{ reverse_abs | default(False) }}

# Metric to display in the GPU utilization plot.
# Metric to display in the chart plot (e.g., 'utilization', 'memory').
chart_metric = {{ chart_metric | default('utilization') }}

[Processes]
# Field by which to sort the process list.
# Field to use for sorting the process list (e.g., 'pid', 'name', 'memory').
sort_field = {{ sort_field | default('pid') }}

# Sort order: increasing or decreasing.
# Sort order, either 'increasing' or 'decreasing'.
sort_order = {{ sort_order | default('decreasing') }}

# Metric to display for processes in the list.
# Metric to display in the process list (e.g., 'memory', 'name').
process_metric = {{ process_metric | default('memory') }}