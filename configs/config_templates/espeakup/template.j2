{#
  espeakup configuration template
  ------------------------------
  This template generates the configuration file for espeakup, a screen reader daemon
  that works in conjunction with espeak to provide speech synthesis for the visually impaired.

  It configures the default voice language and optionally binds audio output to a specific
  ALSA sound card.
#}

{#
  default_voice: The default voice for the espeakup daemon (e.g., 'en', 'en-us', 'de', etc.). Leave empty for system default.
#}
default_voice={{ default_voice | default('en') }}

{#
  alsa_card: ALSA sound card identifier (card number or name). Leave empty to use default card.
  Note: This variable is commented out by default. Uncomment and set to override the default sound card.
#}
# ALSA_CARD={{ alsa_card | default('') | string }}