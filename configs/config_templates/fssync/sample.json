{
  "db": "/var/lib/fssync/laptop-backup.db",
  "root": "/home/user",
  "host": "backup@nas.local",
  "exclude_list": [
    ".cache/*",
    "*.tmp",
    "tmp/",
    "node_modules/"
  ],
  "cipher": "none",
  "parallel_jobs": 8,
  "log_level": 2,
  "use_hardlinks": true,
  "compress": true,
  "remote_cmd": "/usr/bin/fssync",
  "ssh_key": "/home/user/.ssh/id_ed25519",
  "dry_run": false,
  "force_resync": false,
  "ssh_timeout": 120,
  "block_size": 131072,
  "max_files_per_dir": 10000
}
