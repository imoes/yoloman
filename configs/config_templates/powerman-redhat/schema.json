{
  "apc_snmp_specification": {
    "type": "string",
    "default": "apc-snmp",
    "description": "Name of the specification block"
  },
  "apc_snmp_timeout": {
    "type": "number",
    "default": "10   # about 5 sec for cycle command",
    "description": "Timeout for SNMP commands in seconds"
  },
  "apc_snmp_plug_names": {
    "type": "string",
    "default": "\"1\" \"2\" \"3\" \"4\" \"5\" \"6\" \"7\" \"8\"",
    "description": "List of plug names/IDs"
  },
  "apc_snmp_login_expect": {
    "type": "string",
    "default": "snmppower> ",
    "description": "Expected prompt before login"
  },
  "apc_snmp_login_send": {
    "type": "string",
    "default": "start_v1 private\\n",
    "description": "Login command string"
  },
  "apc_snmp_login_expect2": {
    "type": "string",
    "default": "snmppower> ",
    "description": "Expected prompt after login"
  },
  "apc_snmp_logout_send": {
    "type": "string",
    "default": "finish\\n",
    "description": "Logout command string"
  },
  "apc_snmp_logout_expect": {
    "type": "string",
    "default": "snmppower> ",
    "description": "Expected prompt after logout"
  },
  "apc_snmp_status_all_send": {
    "type": "string",
    "default": "get enterprises.318.1.1.4.2.2.0\\n",
    "description": "SNMP command to get status of all plugs"
  },
  "apc_snmp_status_all_expect": {
    "type": "string",
    "default": "enterprises.318.1.1.4.2.2.0: (On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]+(On|Off)[[:space:]]*\\n",
    "description": "Expected output pattern for status_all"
  },
  "apc_snmp_on_send": {
    "type": "string",
    "default": "set enterprises.318.1.1.4.4.2.1.3.%s i 1\\n",
    "description": "SNMP command to turn a plug on"
  },
  "apc_snmp_on_expect": {
    "type": "string",
    "default": "enterprises.318.1.1.4.4.2.1.3.[1-8]: 1\\n",
    "description": "Expected output after turning on"
  },
  "apc_snmp_on_expect2": {
    "type": "string",
    "default": "snmppower> ",
    "description": "Expected prompt after turning on"
  },
  "apc_snmp_off_send": {
    "type": "string",
    "default": "set enterprises.318.1.1.4.4.2.1.3.%s i 2\\n",
    "description": "SNMP command to turn a plug off"
  },
  "apc_snmp_off_expect": {
    "type": "string",
    "default": "enterprises.318.1.1.4.4.2.1.3.[1-8]: 2\\n",
    "description": "Expected output after turning off"
  },
  "apc_snmp_off_expect2": {
    "type": "string",
    "default": "snmppower> ",
    "description": "Expected prompt after turning off"
  },
  "apc_snmp_cycle_send1": {
    "type": "string",
    "default": "set enterprises.318.1.1.4.4.2.1.3.%s i 2\\n",
    "description": "SNMP command to turn plug off (first part of cycle)"
  },
  "apc_snmp_cycle_expect1": {
    "type": "string",
    "default": "enterprises.318.1.1.4.4.2.1.3.[1-8]: 2\\n",
    "description": "Expected output after turning off (first part of cycle)"
  },
  "apc_snmp_cycle_expect2": {
    "type": "string",
    "default": "snmppower> ",
    "description": "Expected prompt after turning off (first part of cycle)"
  },
  "apc_snmp_cycle_delay": {
    "type": "number",
    "default": 5,
    "description": "Delay in seconds between turning off and on in cycle command"
  },
  "apc_snmp_cycle_send2": {
    "type": "string",
    "default": "set enterprises.318.1.1.4.4.2.1.3.%s i 1\\n",
    "description": "SNMP command to turn plug on (second part of cycle)"
  },
  "apc_snmp_cycle_expect3": {
    "type": "string",
    "default": "enterprises.318.1.1.4.4.2.1.3.[1-8]: 1\\n",
    "description": "Expected output after turning on (second part of cycle)"
  },
  "apc_snmp_cycle_expect4": {
    "type": "string",
    "default": "snmppower> ",
    "description": "Expected prompt after turning on (second part of cycle)"
  }
}
