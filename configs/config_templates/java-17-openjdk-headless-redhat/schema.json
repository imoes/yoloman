{
  "java_logging_handlers": {
    "type": "string",
    "default": " java.util.logging.ConsoleHandler",
    "description": "Comma-separated list of log Handler classes."
  },
  "java_logging_level": {
    "type": "string",
    "default": " INFO",
    "description": "Default global logging level."
  },
  "java_logging_file_handler_pattern": {
    "type": "string",
    "default": "%h/java%u.log",
    "description": "Pattern for the FileHandler output file."
  },
  "java_logging_file_handler_limit": {
    "type": "number",
    "default": 50000,
    "description": "Maximum size in bytes for a single log file."
  },
  "java_logging_file_handler_count": {
    "type": "number",
    "default": 1,
    "description": "Number of log files to use."
  },
  "java_logging_file_handler_max_locks": {
    "type": "number",
    "default": 100,
    "description": "Maximum number of attempts to obtain lock file by FileHandler."
  },
  "java_logging_file_handler_formatter": {
    "type": "string",
    "default": "java.util.logging.XMLFormatter",
    "description": "Formatter class for the FileHandler."
  },
  "java_logging_console_handler_level": {
    "type": "string",
    "default": "INFO",
    "description": "Logging level for the ConsoleHandler.",
    "enum": [
      "SEVERE",
      "INFO",
      "CONFIG",
      "ALL"
    ]
  },
  "java_logging_console_handler_formatter": {
    "type": "string",
    "default": "java.util.logging.SimpleFormatter",
    "description": "Formatter class for the ConsoleHandler."
  }
}
