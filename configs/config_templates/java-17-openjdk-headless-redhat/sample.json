{
  "java_logging_handlers": "java.util.logging.ConsoleHandler",
  "java_logging_level": "INFO",
  "java_logging_file_handler_pattern": "%h/java%u.log",
  "java_logging_file_handler_limit": 50000,
  "java_logging_file_handler_count": 1,
  "java_logging_file_handler_max_locks": 100,
  "java_logging_file_handler_formatter": "java.util.logging.XMLFormatter",
  "java_logging_console_handler_level": "INFO",
  "java_logging_console_handler_formatter": "java.util.logging.SimpleFormatter"
}
