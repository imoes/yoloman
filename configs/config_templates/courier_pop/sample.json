{
  "max_daemons": 25,
  "max_connections_per_ip": 10,
  "pop3_port": 110,
  "pop3s_port": 995,
  "ssl_cert_path": "/etc/ssl/certs/courier-pop.crt",
  "starttls": true,
  "allow_plaintext_auth": false,
  "tls_required": true,
  "auth_modules": [
    "authpam"
  ],
  "auth_modules_orig": [
    "authpam"
  ],
  "debug_log": false,
  "log_path": "/var/log/courier-pop3.log",
  "log_days": 14,
  "pop3_banner": "Courier POP3 server ready (secure)",
  "pop3_idle_timeout": 60,
  "max_message_size": 52428800,
  "pop3_log_commands": false,
  "lock_method": "fcntl",
  "maildir_path": "/var/mail",
  "quota_enabled": false,
  "pipelining_enabled": true,
  "capa_enabled": true,
  "uidl_utf8": true,
  "case_insensitive_login": true,
  "autologout_enabled": true,
  "ipv6_enabled": true,
  "bind_address": "",
  "tcpwrap_enabled": true,
  "tcpwrap_config": "pop3",
  "tls_min_version": "TLSv1.2",
  "tls_cipher_list": "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384",
  "tls_session_cache_enabled": true,
  "tls_cache_size": 20000,
  "tls_cache_timeout": 300,
  "proxy_enabled": false,
  "lmtp_enabled": false,
  "pop3_unix_socket_enabled": false,
  "auth_sasl": false,
  "cram_md5_enabled": true,
  "scram_enabled": false,
  "ntlm_enabled": false,
  "login_enabled": true,
  "digest_md5_enabled": false,
  "auth_anonymous": false,
  "smtputf8_enabled": false,
  "burl_enabled": false,
  "ocsp_stapling_enabled": false,
  "proxy_verify_enabled": false,
  "proxy_dns_srv": false,
  "proxy_auth_enabled": false,
  "proxy_auth_socket": "/var/lib/courier/courier-proxy-auth"
}
