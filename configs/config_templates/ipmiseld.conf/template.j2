{# Every option is written only when the operator sets it; otherwise it stays commented with the package's example,
   as in the shipped file (which has no active line). The earlier template activated the examples — hostname
   "myhost(s)", username "myusername", password "mypassword" — and ipmiseld refused the file. #}
##########################################################################################################
#
# IPMIseld configuration file.
#
# For more information on the fields below, please see the manpage
# ipmiseld.conf(5).
#
# P.S.  If you configure different values, remember to uncomment the line :-)
#
##########################################################################################################

#
# Specify the driver type to use (e.g., linux). Optional.
#
{% if driver_type is defined and driver_type is not none and driver_type != '' %}driver-type {{ driver_type }}{% else %}# driver-type {% endif %}

#
# Specify if IPMI devices should be probed for settings (ENABLE|DISABLE). Optional.
#
{% if disable_auto_probe is defined and disable_auto_probe is not none and disable_auto_probe != '' %}disable-auto-probe {{ disable_auto_probe }}{% else %}# disable-auto-probe DISABLE{% endif %}

#
# Specify the in-band driver address to use. Optional.
#
{% if driver_address is defined and driver_address is not none and driver_address != '' %}driver-address {{ driver_address }}{% else %}# driver-address 0xCA2{% endif %}

#
# Specify the in-band driver device path to use. Optional.
#
{% if driver_device is defined and driver_device is not none and driver_device != '' %}driver-device {{ driver_device }}{% else %}# driver-device /my/device/path{% endif %}

#
# register-spacing 1
#
# target-channel-number 0
#
# target-slave-address 0x20
#

#
# Specify the remote host(s) to communicate with. Multiple hostnames may be separated by comma or in range format.
#
{% if hostname is defined and hostname is not none and hostname != '' %}hostname {{ hostname }}{% else %}# hostname myhost(s){% endif %}

#
# Specify the username to use. Optional.
#
{% if username is defined and username is not none and username != '' %}username {{ username }}{% else %}# username myusername{% endif %}

#
# Specify the password to use. Optional.
#
{% if password is defined and password is not none and password != '' %}password {{ password }}{% else %}# password mypassword{% endif %}

#
# Specify the key (k_g) to use. Optional.
#
{% if k_g is defined and k_g is not none and k_g != '' %}k_g {{ k_g }}{% else %}# k_g mykey{% endif %}

#
## session-timeout specified in milliseconds
# Specify the session timeout in milliseconds. Optional.
#
{% if session_timeout is defined and session_timeout is not none and session_timeout != '' %}session-timeout {{ session_timeout }}{% else %}# session-timeout 20000{% endif %}

#
## retransmission-timeout specified in milliseconds
# Specify the retransmission timeout in milliseconds. Optional.
#
{% if retransmission_timeout is defined and retransmission_timeout is not none and retransmission_timeout != '' %}retransmission-timeout {{ retransmission_timeout }}{% else %}# retransmission-timeout 1000{% endif %}

#
# Specify the authentication type to use (NONE, STRAIGHT_PASSWORD_KEY, MD2, MD5). Optional.
#
{% if authentication_type is defined and authentication_type is not none and authentication_type != '' %}authentication-type {{ authentication_type }}{% else %}# authentication-type MD5{% endif %}

#
# Specify the cipher suite id to use. Optional.
#
{% if cipher_suite_id is defined and cipher_suite_id is not none and cipher_suite_id != '' %}cipher-suite-id {{ cipher_suite_id }}{% else %}# cipher-suite-id 3{% endif %}

#
# privilege-level ADMIN
#
# workaround-flags workaround1 workaround2 workaround3
#

#
# Specify the verbose count. Optional.
#
{% if verbose_count is defined and verbose_count is not none and verbose_count != '' %}verbose-count {{ verbose_count }}{% else %}# verbose-count 0{% endif %}

#
# sensor-types temperature fan
#

#
# Specify sensor types of SEL events to not log. Optional.
#
{% if exclude_sensor_types is defined and exclude_sensor_types is not none and exclude_sensor_types != '' %}exclude-sensor-types {{ exclude_sensor_types }}{% else %}# exclude-sensor-types {% endif %}

#
# system-event-only DISABLE
#
# oem-event-only DISABLE
#

#
# Specify the event state configuration file. Optional.
#
{% if event_state_config_file is defined and event_state_config_file is not none and event_state_config_file != '' %}event-state-config-file {{ event_state_config_file }}{% else %}# event-state-config-file {% endif %}

#
# interpret-oem-data DISABLE
#

#
# Specify if output of sensor names should include entity ids and instances or not (ENABLE|DISABLE). Optional.
#
{% if entity_sensor_names is defined and entity_sensor_names is not none and entity_sensor_names != '' %}entity-sensor-names {{ entity_sensor_names }}{% else %}# entity-sensor-names DISABLE{% endif %}

#
# non-abbreviated-units DISABLE
#

#
# Specify event states to be filtered out and not logged. Optional.
#
{% if event_state_filter is defined and event_state_filter is not none and event_state_filter != '' %}event-state-filter {{ event_state_filter }}{% else %}# event-state-filter {% endif %}

#
# Specify the warning threshold. Optional.
#
{% if warning_threshold is defined and warning_threshold is not none and warning_threshold != '' %}warning-threshold {{ warning_threshold }}{% else %}# warning-threshold 80{% endif %}

#
# Specify SEL fullness clear threshold as an integer percentage. Optional.
#
{% if clear_threshold is defined and clear_threshold is not none and clear_threshold != '' %}clear-threshold {{ clear_threshold }}{% else %}# clear-threshold 0{% endif %}

#
# system-event-format "SEL System Event: %s, %I, %E"
#
# oem-timestamped-event-format "SEL OEM Event: %I, %o"
#
# oem-non-timestamped-event-format "SEL OEM Event: %I, %o"
#

#
# Specify the polling interval in seconds. Optional.
#
{% if poll_interval is defined and poll_interval is not none and poll_interval != '' %}poll-interval {{ poll_interval }}{% else %}# poll-interval 300{% endif %}

#
# log-facility LOG_DAEMON
#

#
# Specify the log priority to use. Optional.
#
{% if log_priority is defined and log_priority is not none and log_priority != '' %}log-priority {{ log_priority }}{% else %}# log-priority LOG_ERR{% endif %}

#
# Specify the cache directory to use. Optional.
#
{% if cache_directory is defined and cache_directory is not none and cache_directory != '' %}cache-directory {{ cache_directory }}{% else %}# cache-directory {% endif %}

#
# ignore-sdr DISABLE
#
# re-download-sdr DISABLE
#

#
# Specify if the SEL should be cleared on start (ENABLE|DISABLE). Optional.
#
{% if clear_sel is defined and clear_sel is not none and clear_sel != '' %}clear-sel {{ clear_sel }}{% else %}# clear-sel DISABLE{% endif %}

#
# Specify the thread pool count. Optional.
#
{% if threadpool_count is defined and threadpool_count is not none and threadpool_count != '' %}threadpool-count {{ threadpool_count }}{% else %}# threadpool-count 8{% endif %}
