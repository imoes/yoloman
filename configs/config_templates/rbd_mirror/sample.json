{
  "cluster_name": "ceph",
  "keyring_path": "/etc/ceph/client.rbd-mirror.keyring",
  "log_to_syslog": true,
  "log_file_path": "",
  "log_level": "10",
  "log_to_stderr": false,
  "daemon_log_file_path": "/var/log/ceph/rbd-mirror-$name.log",
  "mon_hosts": [
    "10.0.0.10:6789",
    "10.0.0.11:6789",
    "10.0.0.12:6789"
  ],
  "worker_threads": 4,
  "max_concurrent_image_syncs": 3,
  "concurrent_mirroring_ops": 12,
  "client_mount_timeout": 45,
  "rados_osd_op_timeout": 30,
  "rados_mon_op_timeout": 30,
  "fast_diff_enabled": true,
  "journal_compression_enabled": false,
  "journal_compression_algorithm": "lz4",
  "auto_resync_on_failure": true,
  "delete_on_remote_snapshots_deleted": false,
  "image_sync_interval": 60,
  "journal_max_objects": 1000,
  "journal_max_entries": 10000,
  "instances": [
    {
      "name": "mirror1",
      "hostname": "ceph-node1",
      "priority": 100,
      "enabled": true,
      "pool_pattern": "mirror_*",
      "recovery_enabled": true,
      "replay_max_delay": 0,
      "pool_config_overrides": {
        "mirror_main": {
          "concurrent_image_snapshots": "4",
          "min_snapshots_for_parallel_sync": "2"
        }
      },
      "tls": {
        "enabled": true,
        "verify_mode": "peer",
        "cert_file": "/etc/ceph/tls/mirror1.crt",
        "key_file": "/etc/ceph/tls/mirror1.key",
        "ca_dir": "/etc/ceph/tls/ca"
      }
    },
    {
      "name": "mirror2",
      "hostname": "ceph-node2",
      "priority": 90,
      "enabled": false,
      "pool_pattern": "mirror_*",
      "recovery_enabled": true,
      "replay_max_delay": 0,
      "pool_config_overrides": {},
      "tls": {
        "enabled": true,
        "verify_mode": "peer",
        "cert_file": "/etc/ceph/tls/mirror2.crt",
        "key_file": "/etc/ceph/tls/mirror2.key",
        "ca_dir": "/etc/ceph/tls/ca"
      }
    }
  ]
}
