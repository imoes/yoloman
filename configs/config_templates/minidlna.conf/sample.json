{
  "interfaces": [
    "eth0"
  ],
  "port": 8200,
  "friendly_name": "Home Media Server",
  "media_dir": [
    "A,/home/user/music",
    "V,/home/user/videos",
    "P,/home/user/photos"
  ],
  "db_dir": "/var/cache/minidlna",
  "inotify": true,
  "strict_upnp": true,
  "thumbnail_enabled": true,
  "max_connections": 25,
  "log_level": 1,
  "model_name": "Raspberry Pi DLNA",
  "model_number": "1.0",
  "ssdp_bcast": true,
  "ssdp_setup": true,
  "ssdp_notify_interval": 30,
  "max_ssdp_ttl": 1800,
  "presentation_url": true,
  "album_art_names": [
    "Cover.jpg",
    "Folder.jpg"
  ],
  "sequential_scan": false
}
