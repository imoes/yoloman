# Interface(s) to bind to for UPnP services (comma-separated)
interface = {{ interfaces | join(', ') }}

# Network address of the server (optional; default: auto-discover)
{% if network_address %}
network_address = {{ network_address }}
{% endif %}

# Port for HTTP (control & media) traffic (default: 8200)
port = {{ port }}

# Friendly name (UPnP friendly name of the server)
friendly_name = {{ friendly_name }}

# Path to the root directory for media files
media_dir = {{ media_dir | join(', ') }}

# Path to the album art directory (optional; default: uses embedded art or media_dir/AudioArt)
{% if album_art_dir %}
album_art_dir = {{ album_art_dir }}
{% endif %}

# Path to the database/cache directory (optional; default: /var/cache/minidlna)
{% if db_dir %}
db_dir = {{ db_dir }}
{% endif %}

# Enable inotify to watch for changes in media directories (default: yes)
inotify = {{ inotify | lower }}

# Enable strict UPnP compliance (default: yes)
strict_upnp = {{ strict_upnp | lower }}

# Enable thumbnail generation (default: yes)
{% if thumbnail_enabled is defined %}
enable_thumbnail = {{ thumbnail_enabled | lower }}
{% endif %}

# Maximum number of simultaneous connections to the media server (default: 50)
max_connections = {{ max_connections }}

# Log level (0–7; 0 = no logs, 7 = verbose) (default: 0)
log_level = {{ log_level }}

# Model name and number (for UPnP device description)
model_name = {{ model_name }}
model_number = {{ model_number }}

# UUID (unique device identifier; auto-generated if missing)
{% if uuid %}
uuid = {{ uuid }}
{% endif %}

# Enable WMA/WMV/ASF transcoding support (default: no)
transcode_wma = {{ transcode_wma | lower }}
transcode_wmv = {{ transcode_wmv | lower }}
transcode_asf = {{ transcode_asf | lower }}

# Path to transcoding binary (required only if transcoding enabled)
{% if transcode_binary %}
transcode_binary = {{ transcode_binary }}
{% endif %}

# Path to transcoding temp directory
{% if temp_dir %}
temp_dir = {{ temp_dir }}
{% endif %}

# List of extended audio/video codecs to announce to clients
{% for codec in announce_codecs %}
announced_codec = {{ codec }}
{% endfor %}

# List of extra headers to add to HTTP responses (e.g., for transcoding)
{% for header in extra_headers %}
extra_http_header = {{ header }}
{% endfor %}

# Enable SSDP broadcast (default: yes)
ssdp_bcast = {{ ssdp_bcast | lower }}

# Enable SSDP setup broadcast (default: yes)
ssdp_setup = {{ ssdp_setup | lower }}

# Number of seconds between SSDP notify intervals (default: 30)
ssdp_notify_interval = {{ ssdp_notify_interval }}

# Maximum age of SSDP entries (default: 1800)
max_ssdp_ttl = {{ max_ssdp_ttl }}

# Enable presentation URL (default: yes)
presentation_url = {{ presentation_url | lower }}

# Album art name to look for (e.g., Cover.jpg, Folder.jpg) — comma-separated
album_art_names = {{ album_art_names | join(',') }}

# Enable sequential scan of media directories (default: no)
sequential_scan = {{ sequential_scan | lower }}
