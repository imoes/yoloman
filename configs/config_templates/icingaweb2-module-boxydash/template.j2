[settings]
# Refresh interval in seconds for the dashboard view.
setting_refresh = "{{ setting_refresh | default('10') }}"

# Grid box size for the dashboard layout.
setting_boxsize = "{{ setting_boxsize | default('10') }}"

# Include soft states (pending) in the dashboard. Set to '0' to exclude.
include_softstate = "{{ include_softstate | default('1') }}"

# Require authentication to access the dashboard. Set to '0' to allow anonymous access.
requires_authentication = "{{ requires_authentication | default('1') }}"

# Show the legend in the dashboard. Set to '0' to hide.
show_legend = "{{ show_legend | default('1') }}"

# The URL prefix where Icinga Web 2 is installed.
path_prefix = "{{ path_prefix | default('/icingaweb2') }}"