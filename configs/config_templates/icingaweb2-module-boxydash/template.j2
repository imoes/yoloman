; =============================================================================
; Boxydash Module Configuration for Icinga Web 2
; =============================================================================
; This configuration file controls the behavior and display of the Boxydash
; module. All settings are grouped under the [settings] section.

[settings]

; -----------------------------------------------------------------------------
; setting_refresh: Refresh interval in seconds for the dashboard view.
; -----------------------------------------------------------------------------
; Controls how often the dashboard AJAX calls refresh data.
; Default: 10
setting_refresh = {{ setting_refresh | default('"10"') }}

; -----------------------------------------------------------------------------
; setting_boxsize: Grid box size for the dashboard layout.
; -----------------------------------------------------------------------------
; Determines the size of the widgets/boxes on the dashboard grid.
; Default: 10
setting_boxsize = {{ setting_boxsize | default('"10"') }}

; -----------------------------------------------------------------------------
; include_softstate: Include soft states (pending) in the dashboard.
; -----------------------------------------------------------------------------
; Set to '1' to include pending services/hosts. Set to '0' to exclude them
; and only show hard states.
; Default: 1
include_softstate = {{ include_softstate | default('"1"') }}

; -----------------------------------------------------------------------------
; requires_authentication: Require authentication to access the dashboard.
; -----------------------------------------------------------------------------
; Set to '1' to require valid Icinga Web 2 user credentials.
; Set to '0' to allow anonymous access (if permitted by global config).
; Default: 1
requires_authentication = {{ requires_authentication | default('"1"') }}

; -----------------------------------------------------------------------------
; show_legend: Show the legend in the dashboard.
; -----------------------------------------------------------------------------
; Set to '1' to display the status legend. Set to '0' to hide it.
; Default: 1
show_legend = {{ show_legend | default('"1"') }}

; -----------------------------------------------------------------------------
; path_prefix: The URL prefix where Icinga Web 2 is installed.
; -----------------------------------------------------------------------------
; Used to generate correct links if Icinga Web 2 is not at the web root.
; Default: /icingaweb2
path_prefix = {{ path_prefix | default('"/icingaweb2"') }}
