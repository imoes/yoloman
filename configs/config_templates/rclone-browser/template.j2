# =============================================================================
# Rclone-Browser Configuration File
# =============================================================================
# This file configures the Rclone-Browser application.
# It is self-documenting: every directive is preceded by its description.
# Variables are sourced from Ansible variables with safe defaults.

[rclone]
# Path to the rclone executable binary. Can be absolute or relative to this config.
# If empty, the application searches the system PATH for 'rclone'.
# Variable: rclone_path (default: '')
path = "{{ rclone_path | default('') }}"

# Path to a custom rclone.conf file.
# If empty, rclone uses its default configuration location (e.g., ~/.config/rclone/rclone.conf).
# Variable: rclone_config_file (default: '')
config_file = "{{ rclone_config_file | default('') }}"

[ui]
# Whether to minimize the window to the system tray on startup.
# Variable: minimize_to_tray (default: false)
minimize_to_tray = {{ minimize_to_tray | default(false) }}

# Whether to show system notifications when background tasks (upload/download) complete.
# Variable: show_notifications (default: true)
show_notifications = {{ show_notifications | default(true) }}

# Interface language code (ISO 639-1 format, e.g., 'en', 'de', 'fr').
# Variable: language (default: 'en')
language = "{{ language | default('en') }}"

[media]
# Command to launch the external media player for streaming files.
# Arguments can be appended, e.g., 'mpv --no-terminal'.
# Variable: media_player (default: 'mpv')
player_command = "{{ media_player | default('mpv') }}"