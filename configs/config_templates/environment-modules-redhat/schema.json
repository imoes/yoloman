{
  "set_shell_startup": {
    "type": "number",
    "default": 1,
    "description": "Whether to define module command in sub-shells."
  },
  "quarantine_support": {
    "type": "number",
    "default": 1,
    "description": "Enable environment variable quarantine mechanism."
  },
  "silent_shell_debug": {
    "type": "number",
    "default": 1,
    "description": "Enable shell debugging properties silencing."
  },
  "default_modules": {
    "type": "string",
    "default": "<LIST MODULES TO LOAD HERE>",
    "description": "List of module names to load by default if no saved collection exists."
  }
}
