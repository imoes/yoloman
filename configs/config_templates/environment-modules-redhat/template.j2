#%Module5.0
# This file defines the initial module command configuration, the default
# modulefiles search path and modulefiles you want to load by default for all
# users. It should contains lines of module command like 'module config conf
# val', 'module use path' and 'module load mod'

# ==============================================================================
# Shell Startup Configuration
# ==============================================================================
# set_shell_startup: Whether to define module command in sub-shells.
# Default value is '1' (enabled).
# Format: module config set_shell_startup <1|0>
# When enabled, the 'module' command is automatically available in child
# shells spawned from the current session.
module config set_shell_startup {{ set_shell_startup | default('1') }}

# ==============================================================================
# Quarantine Support
# ==============================================================================
# quarantine_support: Enable environment variable quarantine mechanism.
# Default value is '1' (enabled).
# Format: module config quarantine_support <1|0>
# When enabled, environment variables modified by module commands are
# "quarantined", meaning they are tracked and can be safely unset when
# the module is unloaded, preventing pollution of the user's environment.
module config quarantine_support {{ quarantine_support | default('1') }}

# ==============================================================================
# Silent Shell Debug
# ==============================================================================
# silent_shell_debug: Enable shell debugging properties silencing.
# Default value is '1' (enabled).
# Format: module config silent_shell_debug <1|0>
# When enabled, internal shell debugging output (often generated by
# complex modulefiles) is silenced to keep the user's terminal clean.
module config silent_shell_debug {{ silent_shell_debug | default('1') }}

# ==============================================================================
# Default Module Loading
# ==============================================================================
# default_modules: List of module names to load by default if no saved collection exists.
# Default value is '<LIST MODULES TO LOAD HERE>'.
# This block checks if the user has a saved module collection (via `module save`).
# If a collection exists, it is restored. If not, the default modules are loaded.
# Note: The `module load` command with multiple arguments loads them all.
if {[is-saved default]} {
    module restore
} else {
    module load {{ default_modules | default('<LIST MODULES TO LOAD HERE>') }}
}
