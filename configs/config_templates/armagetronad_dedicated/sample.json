{
  "log_level": 2,
  "root_directory": "/var/lib/armagetronad",
  "save_directory": "/var/lib/armagetronad/save",
  "log_directory": "/var/log/armagetronad",
  "port": 4534,
  "bind_address": "0.0.0.0",
  "max_players": 12,
  "max_players_per_team": 6,
  "server_name": "Armagetron Community Arena",
  "server_description": "Friendly 2v2 and free-for-all matches. Wall destruction ON.",
  "public_server": true,
  "admin_email": "admin@armagetron.example.org",
  "password": "mysecretpass",
  "max_rounds": 5,
  "round_time": 600,
  "wall_destruction": true,
  "player_collisions": true,
  "trail_visibility": true,
  "lighting": true,
  "sound": false,
  "default_map": "grid",
  "map_rotation": [
    {
      "name": "Grid Arena",
      "path": "maps/grid.map"
    },
    {
      "name": "Maze Runner",
      "path": "maps/maze.map"
    },
    {
      "name": "Bouncing Box",
      "path": "maps/bounce.map"
    }
  ],
  "admin_ips": [
    "192.168.1.100",
    "10.0.0.5"
  ],
  "restart_on_crash": true,
  "cpu_limit": 75,
  "extra_config_file": "advanced.conf",
  "extra_lines": [
    "set g_max_trail_length 2500",
    "set g_trail_width 0.4",
    "set g_speed_multiplier 1.05"
  ]
}
