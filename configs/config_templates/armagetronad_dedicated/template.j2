# Armagetron Advanced Dedicated Server Configuration
# Generated from template

# Enable debugging output (0=none, 1=basic, 2=verbose)
logLevel {{ log_level }}

# Path to the main data directory
rootDirectory {{ root_directory }}

# Path to save player and game state data
saveDirectory {{ save_directory }}

# Path to store log files
logDirectory {{ log_directory }}

# Network settings
networkPort {{ port }}
networkBind {{ bind_address }}

# Maximum number of simultaneous players
maxPlayers {{ max_players }}

# Maximum number of players per team
maxPlayersPerTeam {{ max_players_per_team }}

# Server name shown in the public server list
serverName "{{ server_name }}"

# Server description shown in the public server list
serverDescription "{{ server_description }}"

# Enable public listing on the master server
publicServer {{ public_server | lower }}

# Email contact for the server admin (for public listings)
adminEmail "{{ admin_email }}"

# Server password (empty string = no password)
password "{{ password }}"

# Game settings
maxRounds {{ max_rounds }}
roundTime {{ round_time }}

# Enable/disable wall destruction
wallDestruction {{ wall_destruction | lower }}

# Enable/disable player collisions (trails vs direct)
playerCollisions {{ player_collisions | lower }}

# Enable/disable cycle trail visibility
trailVisibility {{ trail_visibility | lower }}

# Enable/disable dynamic lighting
lighting {{ lighting | lower }}

# Enable/disable sound effects
sound {{ sound | lower }}

# Default map used if none specified
defaultMap "{{ default_map }}"

# Map rotation list
{% for map in map_rotation %}
addMap {{ map.name }} {{ map.path }}
{% endfor %}

# Admin IP whitelist (comma-separated list of IPs)
adminIP "{{ admin_ips | join(', ') }}"

# Enable automatic server restart on crash
restartOnCrash {{ restart_on_crash | lower }}

# Maximum CPU usage percentage (0 = unlimited)
cpuLimit {{ cpu_limit }}

# Path to the custom configuration for advanced settings
configFile "{{ extra_config_file }}"

# Extra settings (appended as raw lines)
{% for line in extra_lines %}
{{ line }}
{% endfor %}