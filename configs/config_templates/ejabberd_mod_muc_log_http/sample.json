{
  "muc_http": {
    "http_path": "/muc_logs",
    "http_port": 0,
    "http_bind_address": "127.0.0.1",
    "gzip": true,
    "require_auth": true,
    "http_options": {
      "title": "My Org MUC Logs",
      "stylesheet": "/static/muc_logs.css",
      "header_html": "<h1><a href=\"/\">Organization Chat Archive</a></h1>",
      "footer_html": "<p>Questions? Contact admin@example.com</p>"
    },
    "rooms": [],
    "log_dir": "/var/log/ejabberd/muc",
    "preserve_room_jid": true,
    "room_access_filter": [
      ".*@conference.example.com"
    ],
    "max_age_days": 365,
    "localtime": false,
    "formats": {
      "html": true,
      "text": true,
      "json": true
    }
  }
}
