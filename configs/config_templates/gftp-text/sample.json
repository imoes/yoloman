{
  "default_protocol": "ftps",
  "default_username": "webadmin",
  "default_password": "",
  "default_server": "ftp.example.com",
  "default_port": 990,
  "default_directory": "/var/www",
  "timeout": 60,
  "passive_mode": true,
  "ssl_verify": true,
  "ssh_auth_type": 1,
  "ssh_known_hosts": "/etc/ssh/known_hosts",
  "bookmarks": "/home/user/.gftp/bookmarks",
  "extra_options": [
    {
      "key": "proxy_host",
      "value": "proxy.example.com"
    },
    {
      "key": "proxy_port",
      "value": "8080"
    },
    {
      "key": "max_retries",
      "value": "3"
    }
  ]
}
