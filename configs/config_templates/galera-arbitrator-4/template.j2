# This config file is to be sourced by garb service script.
#
# This template is self-documenting: every variable reference below includes
# its default value and description as a comment. It is safe to reuse in
# an Ansible role without external documentation.

# A comma-separated list of node addresses (address[:port]) in the cluster
# GALERA_NODES="{{ GALERA_NODES | default('') }}"

# Galera cluster name, should be the same as on the rest of the nodes.
# GALERA_GROUP="{{ GALERA_GROUP | default('') }}"

# Optional Galera internal options string (e.g. SSL settings)
# see https://galeracluster.com/library/documentation/galera-parameters.html
# GALERA_OPTIONS="{{ GALERA_OPTIONS | default('') }}"

# Log file for garbd. Optional, by default logs to syslog
# LOG_FILE="{{ LOG_FILE | default('') }}"

# Where to persist necessary data
# WORK_DIR="{{ WORK_DIR | default('') }}"