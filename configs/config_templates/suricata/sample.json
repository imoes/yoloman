{
  "rules_dir": "/etc/suricata/rules",
  "rule_files": [
    "local.rules",
    "suricata.rules",
    "emerging.rules"
  ],
  "classification_file": "/etc/suricata/classification.config",
  "reference_file": "/etc/suricata/reference.config",
  "log_dir": "/var/log/suricata",
  "enable_json_log": true,
  "networks": {
    "HOME_NET": [
      "10.1.0.0/16",
      "192.168.10.0/24"
    ],
    "EXTERNAL_NET": [
      "!10.1.0.0/16",
      "any"
    ],
    "DNS_SERVERS": [
      "10.1.0.53",
      "10.1.0.54"
    ]
  },
  "ports": {
    "HTTP_PORTS": [
      80,
      8080
    ],
    "SSH_PORTS": [
      22
    ]
  },
  "interfaces": [
    {
      "name": "eth0",
      "cluster_id": 42,
      "use_mmap": true,
      "tpacket_v3": true
    },
    {
      "name": "eth1",
      "cluster_id": 0,
      "use_mmap": false
    }
  ],
  "vlan": {
    "use_for_tracking": true
  },
  "flow": {
    "memcap": "2gb",
    "hash_size": 131072,
    "prealloc": 50000,
    "timeout": {
      "default": 60,
      "established": 7200
    }
  },
  "flow_memcap": "1gb",
  "app_layer": {
    "protocols": {
      "http": {
        "enabled": true,
        "libhtp": {
          "default-config": {
            "personality": "IDS",
            "request-body-limit": "250kb",
            "response-body-limit": "250kb"
          }
        }
      },
      "tls": {
        "enabled": true,
        "versions": [
          "1.2",
          "1.3"
        ]
      }
    }
  },
  "threading": {
    "set_cpu_affinity": false,
    "cpu_mode": "manual",
    "auto-cpu-threads": 4
  },
  "pcap": [
    {
      "interface": "eth1"
    }
  ],
  "lua_scripts": [
    "file.lua"
  ],
  "nfq": {
    "queue_id": 1,
    "max_size": 4096
  },
  "nflog": {
    "group": 2,
    "buffer_size": 131072
  },
  "bpf_filter": "host 10.1.0.1 and port 443",
  "extra_engines": [
    "ac-q"
  ],
  "advanced": {
    "checksum_validation": "drop"
  }
}
