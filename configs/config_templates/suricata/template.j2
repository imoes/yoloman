{# -------------------------------------------------------------------------- #}
{# Suricata Classification Configuration Template                             #}
{#                                                                              #}
{# This template generates the suricata classification.config file.           #}
{# It contains the mapping between classification IDs and human-readable      #}
{# descriptions with associated priority levels.                              #}
{#                                                                              #}
{# Schema Variables:                                                          #}
{#   - run: (default='no') Set to 'yes' to start Suricata via init.d script.  #}
{#   - suri_conf: (default='/etc/suricata/suricata.yaml') Path to main YAML   #}
{#   - listen_mode: (default='nfqueue') Listen mode (pcap|nfqueue|af-packet)  #}
{#   - listen_iface: (default='eth0') Interface for pcap mode                #}
{#   - nfqueue_id: (default=0) NFQUEUE number for nfqueue mode               #}
{#   - pid_file: (default='/var/run/suricata.pid') Path to PID file          #}
{# -------------------------------------------------------------------------- #}

{# Only generate classification config if the run variable is explicitly set #}
{# to 'yes'. Otherwise, this file is irrelevant for the current service state. #}
{% if (run | default('no')) == 'yes' %}

# Suricata Classification Configuration
# Generated by Ansible

# --------------------------------------------------------------------------
# Standard Classifications
# These are the default classifications provided by Suricata.
# --------------------------------------------------------------------------

{# Not Suspicious Traffic #}
config classification: not-suspicious,Not Suspicious Traffic,3

{# Unknown Traffic #}
config classification: unknown,Unknown Traffic,3

{# Potentially Bad Traffic #}
config classification: bad-unknown,Potentially Bad Traffic,2

{# Attempted Information Leak #}
config classification: attempted-recon,Attempted Information Leak,2

{# Information Leak #}
config classification: successful-recon-limited,Information Leak,2

{# Large Scale Information Leak #}
config classification: successful-recon-largescale,Large Scale Information Leak,2

{# Attempted Denial of Service #}
config classification: attempted-dos,Attempted Denial of Service,2

{# Denial of Service #}
config classification: successful-dos,Denial of Service,2

{# Attempted User Privilege Gain #}
config classification: attempted-user,Attempted User Privilege Gain,1

{# Unsuccessful User Privilege Gain #}
config classification: unsuccessful-user,Unsuccessful User Privilege Gain,1

{# Successful User Privilege Gain #}
config classification: successful-user,Successful User Privilege Gain,1

{# Attempted Administrator Privilege Gain #}
config classification: attempted-admin,Attempted Administrator Privilege Gain,1

{# Successful Administrator Privilege Gain #}
config classification: successful-admin,Successful Administrator Privilege Gain,1

# --------------------------------------------------------------------------
# NEW Classifications (Suricata 1.0+)
# --------------------------------------------------------------------------

{# Decode of an RPC Query #}
config classification: rpc-portmap-decode,Decode of an RPC Query,2

{# Executable code was detected #}
config classification: shellcode-detect,Executable code was detected,1

{# A suspicious string was detected #}
config classification: string-detect,A suspicious string was detected,3

{# A suspicious filename was detected #}
config classification: suspicious-filename-detect,A suspicious filename was detected,2

{# An attempted login using a suspicious username was detected #}
config classification: suspicious-login,An attempted login using a suspicious username was detected,2

{# A system call was detected #}
config classification: system-call-detect,A system call was detected,2

{# A TCP connection was detected #}
config classification: tcp-connection,A TCP connection was detected,4

{# A Network Trojan was detected #}
config classification: trojan-activity,A Network Trojan was detected,1

{# A client was using an unusual port #}
config classification: unusual-client-port-connection,A client was using an unusual port,2

{# Detection of a Network Scan #}
config classification: network-scan,Detection of a Network Scan,3

{# Detection of a Denial of Service Attack #}
config classification: denial-of-service,Detection of a Denial of Service Attack,2

{# Detection of a non-standard protocol or event #}
config classification: non-standard-protocol,Detection of a non-standard protocol or event,2

{# Generic Protocol Command Decode #}
config classification: protocol-command-decode,Generic Protocol Command Decode,3

{# access to a potentially vulnerable web application #}
config classification: web-application-activity,access to a potentially vulnerable web application,2

{# Web Application Attack #}
config classification: web-application-attack,Web Application Attack,1

{# Misc activity #}
config classification: misc-activity,Misc activity,3

{# Misc Attack #}
config classification: misc-attack,Misc Attack,2

{# Generic ICMP event #}
config classification: icmp-event,Generic ICMP event,3

{# Inappropriate Content was Detected #}
config classification: inappropriate-content,Inappropriate Content was Detected,1

{# Potential Corporate Privacy Violation #}
config classification: policy-violation,Potential Corporate Privacy Violation,1

{# Attempt to login by a default username and password #}
config classification: default-login-attempt,Attempt to login by a default username and password,2

# --------------------------------------------------------------------------
# Updated Classifications (Suricata 2.0+)
# --------------------------------------------------------------------------

{# Targeted Malicious Activity was Detected #}
config classification: targeted-activity,Targeted Malicious Activity was Detected,1

{# Exploit Kit Activity Detected #}
config classification: exploit-kit,Exploit Kit Activity Detected,1

{# Device Retrieving External IP Address Detected #}
config classification: external-ip-check,Device Retrieving External IP Address Detected,2

{# Domain Observed Used for C2 Detected #}
config classification: domain-c2,Domain Observed Used for C2 Detected,1

{# Possibly Unwanted Program Detected #}
config classification: pup-activity,Possibly Unwanted Program Detected,2

{# Successful Credential Theft Detected #}
config classification: credential-theft,Successful Credential Theft Detected,1

{# Possible Social Engineering Attempted #}
config classification: social-engineering,Possible Social Engineering Attempted,2

{# Crypto Currency Mining Activity Detected #}
config classification: coin-mining,Crypto Currency Mining Activity Detected,2

{# Malware Command and Control Activity Detected #}
config classification: command-and-control,Malware Command and Control Activity Detected,1

{% else %}
{# No action required: Suricata is not configured to run via this init.d script. #}
{# The classification config is only needed when 'run' is 'yes'. #}
{% endif %}