{
  "run": {
    "type": "string",
    "default": "no",
    "description": "Set to 'yes' to start Suricata via init.d script"
  },
  "suri_conf": {
    "type": "string",
    "default": "/etc/suricata/suricata.yaml",
    "description": "Path to main Suricata YAML configuration file"
  },
  "listen_mode": {
    "type": "string",
    "default": "nfqueue",
    "description": "Listen mode: 'pcap', 'nfqueue', or 'af-packet'",
    "enum": [
      "nfqueue",
      "af-packet",
      "pcap",
      "af-xdp",
      "netmap",
      "dag",
      "napatech",
      "ipfw"
    ]
  },
  "listen_iface": {
    "type": "string",
    "default": "eth0",
    "description": "Network interface for pcap mode"
  },
  "nfqueue_id": {
    "type": "number",
    "default": 0,
    "description": "NFQUEUE number for nfqueue mode"
  },
  "pid_file": {
    "type": "string",
    "default": "/var/run/suricata.pid",
    "description": "Path to Suricata PID file"
  }
}
