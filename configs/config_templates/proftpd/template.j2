# ProFTPD configuration — managed by agentic-mcp.
# Virtual FTP users are managed in the ProFTPD snap-in (Management →
# Package configuration → ProFTPD); this role owns the global daemon config.
ServerName "{{ server_name }}"
ServerType {{ server_type }}
DefaultServer {{ default_server }}
{% if port %}Port {{ port }}
{% endif %}UseIPv6 {{ use_ipv6 }}
Umask {{ umask }}
MaxInstances {{ max_instances }}
{% if max_clients %}MaxClients {{ max_clients }}
{% endif %}{% if max_clients_per_host %}MaxClientsPerHost {{ max_clients_per_host }}
{% endif %}User {{ run_user }}
Group {{ run_group }}
{% if default_root %}DefaultRoot {{ default_root }}
{% endif %}RequireValidShell {{ require_valid_shell }}
AllowOverwrite {{ allow_overwrite }}
TimeoutIdle {{ timeout_idle }}
{% if passive_ports %}PassivePorts {{ passive_ports }}
{% endif %}IdentLookups {{ ident_lookups }}
UseReverseDNS {{ use_reverse_dns }}
