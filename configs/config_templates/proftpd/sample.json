{
  "server_name": "ProFTPD Server",
  "server_type": "standalone",
  "default_server": "on",
  "port": 21,
  "use_ipv6": "off",
  "umask": "022",
  "max_instances": 30,
  "max_clients": 50,
  "max_clients_per_host": 5,
  "run_user": "proftpd",
  "run_group": "nogroup",
  "default_root": "~",
  "require_valid_shell": "off",
  "allow_overwrite": "on",
  "timeout_idle": 600,
  "passive_ports": "49152 65534",
  "ident_lookups": "off",
  "use_reverse_dns": "off"
}
