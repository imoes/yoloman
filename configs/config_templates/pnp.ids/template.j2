# ============================================================================
# Template for pnp.ids (Performance Now / PNP Monitoring)
# ============================================================================
# This template generates the identifier file used by PNP4Nagios/Performance
# Now to associate performance data with specific host/service definitions.
#
# Since the schema provided is empty and 'pnp.ids' is not a standard service
# package name, this is generated as a minimal, safe, self-documenting
# placeholder. It assumes the standard PNP id file format:
# host_name|service_description
#
# If this package corresponds to a specific monitoring extension (e.g.,
# check_mk, pnp4nagios), please update the schema and re-request.
# ============================================================================

{% set hostname = host_name | default('localhost') %}
{% set service_name = service_description | default('All') %}

{# The primary host identifier for PNP performance data #}
{{ hostname }}

{# The service description label to group performance metrics #}
{{ service_name }}