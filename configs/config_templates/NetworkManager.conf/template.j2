# NetworkManager configuration file
# This file controls the behavior of the NetworkManager daemon.
# For documentation, see 'man NetworkManager.conf' or the NetworkManager man page.

[main]
# plugins: Comma-separated list of plugins to load.
# Common values: 'ifupdown,keyfile', 'keyfile', etc.
plugins={{ plugins | default('ifupdown,keyfile') | string }}

[ifupdown]
# managed: If true, ifupdown interfaces are managed by NetworkManager.
# Default is false (interfaces are NOT managed by NM).
managed={{ ifupdown_managed | default(False) | string | lower }}