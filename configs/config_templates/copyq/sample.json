{
  "monitoring_enabled": true,
  "max_history_items": 200,
  "separator": "\n",
  "auto_save_interval": 120,
  "theme": "dark",
  "language": "en",
  "tray_icon_enabled": true,
  "show_notifications": true,
  "ignore_applications": true,
  "ignore_applications_list": [
    "firefox",
    "chromium"
  ],
  "ignore_text": true,
  "ignore_text_list": [
    "password",
    "secret"
  ],
  "tabs": [
    {
      "name": "Clipboard"
    },
    {
      "name": "Work"
    },
    {
      "name": "Personal"
    },
    {
      "name": "Code Snippets"
    }
  ]
}
