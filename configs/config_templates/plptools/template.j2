#
# plptools Service Configuration
# ================================
# This file configures the PLP Tools daemon suite, which provides
# printer management and network printing capabilities.
#

# Set to 'yes' to start the ncpd (Network Print Controller Daemon) during boot.
# Controls the main print spooling daemon.
# Default: yes
START_NCPD={{ start_ncpd | default('yes') }}

# Additional arguments passed to the ncpd daemon.
# Refer to ncpd(8) for available options.
# Default: (empty string)
NCPD_ARGS="{{ ncpd_args | default('') }}"

# Set to 'yes' to start the plpfuse daemon during boot.
# plpfuse provides FUSE-based printer filesystem access.
# Default: no
START_PLPFUSE={{ start_plpfuse | default('no') }}

# Additional arguments passed to the plpfuse daemon.
# Default: (empty string)
PLPFUSE_ARGS="{{ plpfuse_args | default('') }}"

# Set to 'yes' to start the plpprintd daemon during boot.
# plpprintd handles print job processing and forwarding.
# Note: A printer configuration must also be set up for this to function.
# Default: no
START_PLPPRINTD={{ start_plpprintd | default('no') }}

# Additional arguments passed to the plpprintd daemon.
# Default: (empty string)
PLPPRINTD_ARGS="{{ plpprintd_args | default('') }}"
