#
# plptools configuration file
# Manages the plptools suite: ncpd (NetConsole server), plpfuse (FUSE filesystem),
# and plpprintd (network printer daemon).
#

# Set to 'yes' to start ncpd during boot.
# ncpd provides a network console server for remote management.
START_NCPD={{ start_ncpd | default('yes') }}

# Arguments passed to ncpd.
# Refer to ncpd(8) for available options.
NCPD_ARGS="{{ ncpd_args | default('') }}"

# Set to 'yes' to start plpfuse during boot.
# plpfuse mounts a FUSE-based filesystem for the printer network.
START_PLPFUSE={{ start_plpfuse | default('no') }}

# Arguments passed to plpfuse.
# Refer to plpfuse(8) for available options.
PLPFUSE_ARGS="{{ plpfuse_args | default('') }}"

# Set to 'yes' to start plpprintd during boot.
# plpprintd handles network printing; requires a configured printer.
START_PLPPRINTD={{ start_plpprintd | default('no') }}

# Arguments passed to plpprintd.
# Refer to plpprintd(8) for available options.
PLPPRINTD_ARGS="{{ plpprintd_args | default('') }}"