{#
    html2wml Configuration Template
    ================================
    This template generates the configuration file for html2wml, a tool that converts HTML
    to Wireless Markup Language (WML). It is designed to be self-documenting, with every
    configuration directive preceded by a comment explaining its purpose and source.

    Variables should be provided via Ansible inventory or group_vars. All variables have
    sensible defaults derived from the html2wml(1) man page.
#}

{# --ascii: Convert named HTML entities and non-ASCII characters to US-ASCII characters using 7-bit approximations. #}
ascii={{ ascii | default(false) | lower }}

{# --collapse: Collapse redundant whitespaces, tabulations, carriage returns, line feeds, and empty paragraphs. #}
collapse={{ collapse | default(true) | lower }}

{# --ignore_images: Completely ignore all image links. #}
ignore_images={{ ignore_images | default(false) | lower }}

{# --img_alt_text: Replace image tags with their corresponding alternative text. #}
img_alt_text={{ img_alt_text | default(true) | lower }}

{# --linearize: Flatten HTML tables (linearize them) as Lynx does. #}
linearize={{ linearize | default(true) | lower }}

{# --numeric_non_ascii: Convert all non-ASCII characters to numeric entities. #}
numeric_non_ascii={{ numeric_non_ascii | default(false) | lower }}

{# --nopre: Do not use the <pre> tag. #}
nopre={{ nopre | default(false) | lower }}

{# --compile: Use the compiler from WML Tools to compile the WML deck. #}
compile={{ compile | default(false) | lower }}

{# --max_card_size: Limit the size (in bytes) of the generated cards. #}
max_card_size={{ max_card_size | default(1500) }}

{# --card_split_threshold: Threshold of the split event, occurring when card size is between max-card-size - card-split-threshold and max-card-size. #}
card_split_threshold={{ card_split_threshold | default(50) }}

{# --next_card_label: Label of the link that points to the next card. #}
next_card_label={{ next_card_label | default('[>>]') }}

{# --prev_card_label: Label of the link that points to the previous card. #}
prev_card_label={{ prev_card_label | default('[<<]') }}

{# --http_user: Username for HTTP authentication. #}
http_user={{ http_user | default('') }}

{# --http_passwd: Password for HTTP authentication. #}
http_passwd={{ http_passwd | default('') }}

{# --proxy: Activate proxy support using LWP built-in proxy support. #}
proxy={{ proxy | default(true) | lower }}

{# --debug: Activate debug mode to print output with line numbering and XML check results. #}
debug={{ debug | default(false) | lower }}

{# --xmlcheck: Send WML output to XML::Parser to check its well-formedness. #}
xmlcheck={{ xmlcheck | default(false) | lower }}