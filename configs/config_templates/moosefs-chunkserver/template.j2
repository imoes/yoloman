#!/bin/sh
# MooseFS ChunkServer Sleep/Resume Hook
# This script is called by the system suspend/resume cycle.
# It ensures the MooseFS chunkserver stops gracefully before suspend
# and restarts after resume, allowing the master to update its metadata
# about the chunkserver's availability.

case $1 in
    suspend|hibernate)
        # Stop the MooseFS chunkserver service before suspending.
        # The service name is derived from the package configuration.
        service {{ name | default('moosefs-chunkserver') }} stop

        # Wait briefly to allow the master to acknowledge the stop
        # and potentially switch the chunkserver to maintenance mode.
        /bin/sleep 2
        ;;
    resume|thaw)
        # Restart the MooseFS chunkserver service after resuming.
        service {{ name | default('moosefs-chunkserver') }} start
        ;;
esac
