# ~/.ftpwatchrc: list of files/directories to monitor on remote FTP servers.
# Each entry specifies a host and a path, optionally marked as recursive.
# Format: host[:R:path]
{% for entry in watch_entries | default([], true) %}
{{ entry.host | default('') }}:{% if entry.recursive | default(false) %}R:{% endif %}{{ entry.path | default('/') }}
{% endfor %}