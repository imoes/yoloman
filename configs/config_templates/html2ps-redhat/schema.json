{
  "djpeg": {
    "type": "number",
    "default": 1,
    "description": "Enable djpeg support"
  },
  "netpbm": {
    "type": "number",
    "default": 1,
    "description": "Enable netpbm support"
  },
  "imagemagick": {
    "type": "number",
    "default": 0,
    "description": "Enable ImageMagick support"
  },
  "perl_magick": {
    "type": "number",
    "default": 0,
    "description": "Enable PerlMagick support"
  },
  "tex": {
    "type": "number",
    "default": 0,
    "description": "Enable TeX support"
  },
  "dvips": {
    "type": "number",
    "default": 0,
    "description": "Enable dvips support"
  },
  "ghostscript": {
    "type": "number",
    "default": 1,
    "description": "Enable Ghostscript support"
  },
  "libwww_perl": {
    "type": "number",
    "default": 1,
    "description": "Enable libwww-perl support"
  },
  "path": {
    "type": "string",
    "default": "/usr/bin",
    "description": "Path to utilities directory"
  },
  "hyphen_file": {
    "type": "string",
    "default": "/usr/share/texmf/tex/generic/hyphen/hyphen.tex",
    "description": "Path to English hyphenation file"
  }
}
