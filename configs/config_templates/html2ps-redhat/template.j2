/* Global configuration file for html2ps */
/*
 * This template provides a self-documenting configuration for html2ps.
 * Each directive is preceded by its schema description and uses
 * default values to ensure safe rendering even if variables are undefined.
 */

@html2ps {
  package {
    # Enable djpeg support (default: 1)
    djpeg: {{ djpeg | default('1') }};

    # Enable netpbm support (default: 1)
    netpbm: {{ netpbm | default('1') }};

    # Enable ImageMagick support (default: 0)
    ImageMagick: {{ imagemagick | default('0') }};

    # Enable PerlMagick support (default: 0)
    PerlMagick: {{ perl_magick | default('0') }};

    # Enable TeX support (default: 0)
    TeX: {{ tex | default('0') }};

    # Enable dvips support (default: 0)
    dvips: {{ dvips | default('0') }};

    # Enable Ghostscript support (default: 1)
    Ghostscript: {{ ghostscript | default('1') }};

    # Enable libwww-perl support (default: 1)
    libwww-perl: {{ libwww_perl | default('1') }};

    # Path to utilities directory (default: /usr/bin)
    path: "{{ path | default('/usr/bin') }}";
  }

  hyphenation {
    en {
      # Path to English hyphenation file (default: /usr/share/texmf/tex/generic/hyphen/hyphen.tex)
      file: "{{ hyphen_file | default('/usr/share/texmf/tex/generic/hyphen/hyphen.tex') }}";
    }
  }
}
