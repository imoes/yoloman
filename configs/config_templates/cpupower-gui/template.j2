# Cpupower-gui configuration file
#
# This file configures the cpupower-gui application.
# Settings can be overridden by drop-in files in /etc/cpupower_gui.d/
# that are loaded after this file.
#
# For more info on drop-in files read /etc/cpupower_gui.d/README
#

[Profile]
# CPU performance profile to apply (e.g., 'Balanced', 'Performance', 'PowerSave')
profile = {{ profile | default('Balanced') }}

[GUI]
# If true, apply settings to all CPUs by default
allcpus_default = {{ allcpus_default | default(false) | lower }}

# If true, show tick marks on the CPU frequency slider
tick_marks_enabled = {{ tick_marks_enabled | default(true) | lower }}

# If true, display frequency tick labels
frequency_ticks = {{ frequency_ticks | default(true) | lower }}

# If true, allow per-CPU energy performance preference settings
energy_pref_per_cpu = {{ energy_pref_per_cpu | default(false) | lower }}