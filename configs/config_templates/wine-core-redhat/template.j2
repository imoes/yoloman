# ==============================================================================
# Wine Core Configuration (RedHat/CentOS/Fedora)
# ==============================================================================
# This template configures the Wine runtime environment for Linux.
# Wine is a compatibility layer capable of running Windows applications.
#
# Schema Fields:
# - prefix: The directory where Windows drives (C: drive) are stored.
#   Default: /root/.wine
# - prefix_type: The type of prefix to create or use ('win32' for 32-bit,
#   'win64' for 64-bit).
#   Default: win64
# ==============================================================================

# [Path Configuration]
# The base directory for Wine files.
/usr/lib64/wine/

# [Prefix Configuration]
# The file path to the Wine prefix (the virtual C: drive).
# If not set, Wine defaults to ~/.wine.
# {{ prefix | default('/root/.wine') }}

# [Prefix Type]
# The architecture of the prefix: win32 or win64.
# {{ prefix_type | default('win64') }}
