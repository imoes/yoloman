# Java Decompiler/Compiler Plugin: ASMTools 7 Wrapper
#
# This template generates a Java wrapper class that interfaces with the
# OpenJDK ASMTools 7 library (jasm/jdis) to decompile bytecode or
# compile Java source files.
#
# This is not a configuration file for a network service, but a
# component of a larger Java-based toolchain (likely a runtime
# decompiler or build system). It does not expose ports or listen
# for connections.
#
# Variables:
#   - None. This template is static boilerplate.
#   - If dynamic behavior is required, it is handled by the
#     Ansible task invoking this template or the runtime environment.

import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.IOException;
import java.io.PrintStream;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class Jasm7DecompilerWrapper {

    /**
     * Decompile bytecode to Java source code.
     *
     * @param bytecode The raw .class file bytes to decompile.
     * @param options  Additional options for the decompiler (e.g., verbose flags).
     * @return The decompiled Java source code as a string.
     */
    public String decompile(byte[] bytecode, String[] options) {
        final ByteArrayOutputStream baos = new ByteArrayOutputStream();
        final String utf8 = StandardCharsets.UTF_8.name();
        try {
            // Create a temporary file to hold the bytecode for jdis
            File file = File.createTempFile("jrd-jasm", "tmp.java");
            file.deleteOnExit();
            Files.write(file.toPath(), bytecode);
            
            // Run the decompiler (jdis)
            try (PrintStream ps = new PrintStream(baos, true, utf8)) {
                org.openjdk.asmtools.jdis.Main jdis = new org.openjdk.asmtools.jdis.Main(ps, "jdis");
                // Note: options from the argument are not explicitly passed to jdis constructor here,
                // relying on default behavior or internal state if extended.
                jdis.disasm(new String[]{file.getAbsolutePath()});
            }
            
            String data = baos.toString(utf8);
            if (data.isEmpty()) {
                return "No output, unpatched asmtools? See " +
                        "https://github.com/openjdk/asmtools/pull/13/commits/9104af81fef8c220be919a3e34912386a7b99a60";
            }
            return data;
        } catch (Exception e) {
            e.printStackTrace();
            return e.toString();
        }
    }

    /**
     * Simple logger for debugging compilation steps.
     */
    private void log(Object logger, String message) {
        System.err.println(message);
    }

    /**
     * Compile Java source files to bytecode (.class).
     *
     * @param src         A map of source file names to their Java source content.
     * @param options     Additional options for the compiler (e.g., -d, -g).
     * @param maybeLogger An optional logger object.
     * @return A map of fully qualified class names to their compiled bytecode.
     * @throws Exception If compilation fails.
     */
    public Map<String, byte[]> compile(Map<String, String> src, String[] options, Object maybeLogger) throws Exception {
        log(maybeLogger, "jasm compiler called with input of: " + src.size());
        
        // Create a temporary directory structure for compilation
        File parentDir = File.createTempFile("jrd-jasm", "tmp.dir");
        parentDir.delete(); // Ensure it's a directory, not a file
        parentDir.mkdir();
        parentDir.deleteOnExit();
        
        File srcs = new File(parentDir, "src");
        srcs.mkdir();
        File target = new File(parentDir, "bin");
        target.mkdir();
        
        log(maybeLogger, "entering into " + parentDir.getAbsolutePath());
        
        List<String> tmpSources = new ArrayList<>(src.size());
        
        // Write source files to the temporary directory
        for (Map.Entry<String, String> fileToCompile : src.entrySet()) {
            File nw = new File(srcs, fileToCompile.getKey() + ".java");
            log(maybeLogger, "writing tmp file into " + nw.getAbsolutePath());
            Files.write(nw.toPath(), fileToCompile.getValue().getBytes());
            tmpSources.add(nw.getAbsolutePath());
        }
        
        // Prepare compiler arguments
        tmpSources.add(0, target.getAbsolutePath()); // Output directory
        tmpSources.add(0, "-d");
        tmpSources.add(0, "-g"); // Add debug info
        
        String[] opts = tmpSources.toArray(new String[0]);
        log(maybeLogger, "jasm " + Arrays.toString(opts));

        // Run the compiler (jasm)
        org.openjdk.asmtools.jasm.Main jasm = new org.openjdk.asmtools.jasm.Main(System.err, "jdis");
        jasm.compile(opts);
        
        // Read back the compiled classes
        Map<String, byte[]> r = new HashMap();
        Files.walk(target.toPath()).filter(Files::isRegularFile).forEach(k -> {
            try {
                String futureFullyQualifiedNiceName = k.toString();
                futureFullyQualifiedNiceName = futureFullyQualifiedNiceName.replace(target + File.separator, "");
                futureFullyQualifiedNiceName = futureFullyQualifiedNiceName.replace(File.separator, ".");
                futureFullyQualifiedNiceName = futureFullyQualifiedNiceName.replaceAll("\\.class$", "");
                r.put(futureFullyQualifiedNiceName, Files.readAllBytes(k));
            } catch (IOException ex) {
                ex.printStackTrace();
            }
        });
        return r;
    }
}
