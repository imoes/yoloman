{
  "tcp_wrappers_enabled": true,
  "wrap_log_level": "moderate",
  "wrap_timeout": 3,
  "access_rules": [
    {
      "comment": "Allow internal LAN and deny all others for login attempts",
      "limits": [
        "LOGIN"
      ],
      "allow": [
        "10.0.0.0/8",
        "192.168.1.0/24",
        "172.16.0.0/12"
      ],
      "deny": [
        "ALL"
      ]
    },
    {
      "comment": "Restrict file writes to authenticated users only",
      "limits": [
        "WRITE",
        "DELE",
        "RNFR",
        "RNTO"
      ],
      "deny": [
        "ALL"
      ]
    },
    {
      "comment": "Block known bad IP ranges",
      "limits": [
        "ALL"
      ],
      "deny": [
        "203.0.113.0/24",
        "198.51.100.0/24"
      ]
    }
  ]
}
