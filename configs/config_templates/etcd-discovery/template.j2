[server]
# Domain/URL used as prefix when returning the cluster ID
prefix_url={{ prefix_url | default('http://example.com') }}

# Port on which the web service binds
# Note: The format is IP:PORT. Default IP is not specified, using empty or 0.0.0.0 implies all interfaces.
web_service_address=0.0.0.0:{{ web_service_port | default(8087) }}

[etcd]
# Host address of the etcd cluster
# Port of the etcd cluster
# The endpoint is constructed as http://host:port
endpoint_location=http://{{ etcd_host | default('127.0.0.1') }}:{{ etcd_port | default(2379) }}