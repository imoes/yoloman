[server]
# Domain/URL used as prefix when returning the cluster ID
prefix_url={{ prefix_url | default('http://example.com') }}

# Port on which the web service binds (format :<port> or IP:<port>)
web_service_address=:{% set port = web_service_port | default(8087) %}{{ port }}

[etcd]
# Host address of the etcd cluster
{% set host = etcd_host | default('127.0.0.1') %}
# Port of the etcd cluster
{% set port = etcd_port | default(2379) %}
# Full URL to the etcd cluster endpoint
endpoint_location=http://{{ host }}:{{ port }}
