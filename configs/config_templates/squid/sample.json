{
  "acls": [
    {
      "name": "localnet",
      "type": "src",
      "value": "192.168.1.0/24",
      "description": "Internal LAN subnet"
    },
    {
      "name": "localhost",
      "type": "src",
      "value": "127.0.0.1/32",
      "description": "Local machine"
    },
    {
      "name": "safe_ports",
      "type": "port",
      "value": "80 443 8080",
      "description": "Allowed destination ports"
    }
  ],
  "http_access_rules": [
    {
      "action": "deny",
      "acls": [
        "all"
      ]
    },
    {
      "action": "allow",
      "acls": [
        "localnet"
      ]
    },
    {
      "action": "allow",
      "acls": [
        "localhost"
      ]
    }
  ],
  "http_port": [
    "3128"
  ],
  "transparent": false,
  "transparent_port": "3128",
  "cache_dirs": [
    {
      "index": 1,
      "location": "/var/spool/squid",
      "size": 1024,
      "max_size": 2048,
      "l1": 16,
      "l2": 256
    }
  ],
  "memory_cache_size": 256,
  "dns_nameservers": [
    "8.8.8.8",
    "1.1.1.1"
  ],
  "enable_ipv6": false,
  "worker_processes": 2,
  "connect_timeout": 30,
  "request_timeout": 5,
  "read_timeout": 2,
  "minimum_object_size": 0,
  "maximum_object_size": 4096,
  "authentication_enabled": false,
  "refresh_patterns": [
    {
      "regex": "^[^?]*\\.(jpg|gif|png|js|css)$",
      "min": 60,
      "percent": 20,
      "max": 10080
    },
    {
      "regex": "^[^?]*\\.(html|htm|php)$",
      "min": 10,
      "percent": 20,
      "max": 1440
    },
    {
      "regex": ".",
      "min": 0,
      "percent": 20,
      "max": 1440
    }
  ],
  "visible_hostname": "proxy-server-1",
  "log_location": "/var/log/squid",
  "log_rotate_count": 5,
  "access_log": "/var/log/squid/access.log",
  "cache_log": "/var/log/squid/cache.log"
}
