{
  "nut_mode": "netserver",
  "ups_list": [
    {
      "name": "myups",
      "driver": "usbhid-ups",
      "port": "auto",
      "description": "Main server UPS \u2014 APC Back-UPS NX 1500",
      "poll_interval": 5,
      "master": true
    }
  ],
  "allowed_hosts": [
    {
      "name": "backup-server",
      "ip": "10.0.0.5",
      "actions": [
        "MASTER"
      ]
    },
    {
      "name": "monitoring-host",
      "ip": "10.0.0.10",
      "actions": [
        "MONITOR"
      ]
    }
  ],
  "users": [
    {
      "name": "upsadmin",
      "password": "secret_admin_pass",
      "actions": [
        "MASTER",
        "FSD",
        "SET",
        "INSTCMD"
      ]
    },
    {
      "name": "monuser",
      "password": "secret_mon_pass",
      "actions": [
        "MONITOR"
      ]
    }
  ],
  "listen_ip": "0.0.0.0",
  "listen_port": 3493,
  "enable_upsd_tcp": true,
  "enable_upsd_usb": true
}
