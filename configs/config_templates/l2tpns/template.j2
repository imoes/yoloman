# L2TP Network Server (l2tpns) Configuration
# See `man l2tpns.conf` for full syntax and options

# Global settings
[global]
# Logging level: 0=silent, 5=verbose
log_level = {{ log_level }}
# PID file path
pid_file = {{ pid_file }}
# Enable IP packet compression (if supported by kernel)
compress_ip = {{ compress_ip | lower }}

# Tunnel limits
# Maximum number of active tunnels
max_tunnels = {{ max_tunnels }}
# Maximum number of sessions per tunnel
max_sessions_per_tunnel = {{ max_sessions_per_tunnel }}

# IP pool configuration for dynamic assignment to LACs
[ip_pool]
# Base IP address for dynamic session assignment
start = {{ ip_pool.start }}
# Last IP address in the pool
end = {{ ip_pool.end }}
# Optional: specify subnet mask (default: /32 per session)
{% if ip_pool.subnet %}
subnet = {{ ip_pool.subnet }}
{% endif %}

# Local LNS settings (required)
[lns]
# LNS IP address (must be routable from LACs)
ip = {{ lns.ip }}
# Shared secret used for L2TP authentication (must match LAC config)
secret = {{ lns.secret }}
# Authentication method: `pap`, `chap`, or `mschap`
auth = {{ lns.auth }}
# Enable CHAP MD5 challenge (true/false)
chap_md5 = {{ lns.chap_md5 | lower }}
# Optional: disable authentication for specific hosts (space-separated IPs)
{% if lns.bypass_auth_hosts %}
bypass_auth_hosts = {{ lns.bypass_auth_hosts | join(' ') }}
{% endif %}

# Optional per-LAC configuration (repeatable blocks)
{% for lac in lac_configs %}
# LAC-specific override: {{ lac.name }}
[lac:{{ lac.name }}]
ip = {{ lac.ip }}
secret = {{ lac.secret }}
{% if lac.auth is defined %}auth = {{ lac.auth }}{% endif %}
{% if lac.chap_md5 is defined %}chap_md5 = {{ lac.chap_md5 | lower }}{% endif %}
{% if lac.local_ip is defined %}local_ip = {{ lac.local_ip }}{% endif %}
{% if lac.ip_pool_start is defined %}ip_pool_start = {{ lac.ip_pool_start }}{% endif %}
{% if lac.ip_pool_end is defined %}ip_pool_end = {{ lac.ip_pool_end }}{% endif %}
{% endfor %}

# Optional: advanced networking
[advanced]
# UDP port for L2TP control (default: 1701)
port = {{ advanced.port }}
# Enable NAT traversal (true/false)
nat_traversal = {{ advanced.nat_traversal | lower }}
# TTL for L2TP packets (default: 64)
ttl = {{ advanced.ttl }}
# Maximum segment size (MSS) adjustment
{% if advanced.mss is defined %}mss = {{ advanced.mss }}{% endif %}
