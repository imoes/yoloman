{
  "log_level": {
    "type": "number",
    "default": 3,
    "description": "Logging verbosity (0 = silent, 5 = very verbose)"
  },
  "pid_file": {
    "type": "string",
    "default": "/var/run/l2tpns.pid",
    "description": "Path to the PID file"
  },
  "compress_ip": {
    "type": "bool",
    "default": false,
    "description": "Enable IP packet compression (requires kernel support)"
  },
  "max_tunnels": {
    "type": "number",
    "default": 100,
    "description": "Maximum number of simultaneously active tunnels"
  },
  "max_sessions_per_tunnel": {
    "type": "number",
    "default": 10,
    "description": "Maximum number of sessions allowed per tunnel"
  },
  "ip_pool": {
    "type": "object",
    "default": {
      "start": "192.168.200.1",
      "end": "192.168.200.254",
      "subnet": "/24"
    },
    "description": "IP address pool for dynamic session assignment to clients (LACs)",
    "items": {
      "start": {
        "type": "string",
        "description": "First IP in the pool (e.g., '192.168.200.1')"
      },
      "end": {
        "type": "string",
        "description": "Last IP in the pool (e.g., '192.168.200.254')"
      },
      "subnet": {
        "type": "string",
        "optional": true,
        "description": "Optional subnet mask (e.g., '/24') \u2014 if omitted, /32 per session is assumed"
      }
    }
  },
  "lns": {
    "type": "object",
    "default": {
      "ip": "10.0.0.1",
      "secret": "secret",
      "auth": "chap",
      "chap_md5": true,
      "bypass_auth_hosts": []
    },
    "description": "Core LNS configuration: identity, security, and auth settings",
    "items": {
      "ip": {
        "type": "string",
        "description": "Local LNS IP address (must be reachable by LACs)"
      },
      "secret": {
        "type": "string",
        "description": "Shared secret for L2TP control channel authentication"
      },
      "auth": {
        "type": "string",
        "enum": [
          "pap",
          "chap",
          "mschap"
        ],
        "description": "Authentication protocol (PAP is insecure; prefer CHAP or MSCHAP)"
      },
      "chap_md5": {
        "type": "bool",
        "description": "Enable MD5-Challenge (CHAP) authentication (recommended over PAP)"
      },
      "bypass_auth_hosts": {
        "type": "list",
        "optional": true,
        "description": "List of LAC IP addresses (space-separated in config) to skip auth",
        "items": {
          "type": "string",
          "description": "IP address"
        }
      }
    }
  },
  "lac_configs": {
    "type": "list",
    "default": [],
    "description": "Per-LAC overrides (e.g., for multi-LAC deployments)",
    "items": {
      "type": "object",
      "items": {
        "name": {
          "type": "string",
          "description": "Unique identifier for this LAC"
        },
        "ip": {
          "type": "string",
          "description": "LAC's public IP address"
        },
        "secret": {
          "type": "string",
          "description": "LAC-specific shared secret (overrides global `lns.secret`)"
        },
        "auth": {
          "type": "string",
          "enum": [
            "pap",
            "chap",
            "mschap"
          ],
          "optional": true,
          "description": "Override auth method for this LAC"
        },
        "chap_md5": {
          "type": "bool",
          "optional": true,
          "description": "Override CHAP MD5 setting"
        },
        "local_ip": {
          "type": "string",
          "optional": true,
          "description": "Local source IP to use when connecting to this LAC"
        },
        "ip_pool_start": {
          "type": "string",
          "optional": true,
          "description": "Override start IP for session assignments to this LAC"
        },
        "ip_pool_end": {
          "type": "string",
          "optional": true,
          "description": "Override end IP for session assignments to this LAC"
        }
      }
    }
  },
  "advanced": {
    "type": "object",
    "default": {
      "port": 1701,
      "nat_traversal": false,
      "ttl": 64
    },
    "description": "Advanced network settings",
    "items": {
      "port": {
        "type": "number",
        "description": "UDP port for L2TP control (default 1701)"
      },
      "nat_traversal": {
        "type": "bool",
        "description": "Enable NAT traversal (STUN-like keepalives)"
      },
      "ttl": {
        "type": "number",
        "description": "TTL for L2TP control packets"
      },
      "mss": {
        "type": "number",
        "optional": true,
        "description": "Maximum Segment Size adjustment for L2TP-over-IPSec tunnels"
      }
    }
  }
}
