{
  "default_options": [
    "-ac 0.1",
    "-as -1",
    "-c-",
    "-d",
    "-gs-",
    "-ls-",
    "-m 0.25",
    "-om 0.02",
    "-rt auto",
    "-s",
    "-t",
    "-toc",
    "-ui-"
