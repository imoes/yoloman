{
  "debug": false,
  "runtime_dir": "/run/bamfdaemon",
  "state_file": "/var/lib/bamfdaemon/bamfstate.yaml",
  "worker_threads": 4,
  "match_timeout": 500,
  "x11_enabled": true,
  "wayland_enabled": true,
  "matching_rules": [
    {
      "name": "Firefox",
      "section": "Application",
      "exec": "/usr/bin/firefox",
      "icon": "firefox",
      "wmclass": "Firefox",
      "wmname": "Mozilla Firefox"
    },
    {
      "name": "VSCode",
      "section": "Application",
      "exec": "code",
      "icon": "visual-studio-code",
      "regex": ".*Code.*"
    }
  ],
  "log_to_file": true,
  "log_file": "/var/log/bamfdaemon.log",
  "log_level": "warning"
}
