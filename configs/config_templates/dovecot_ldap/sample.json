{
 "aliases_filter": "",
 "base_dn": "ou=Users,dc=example,dc=com",
 "bind_dn": "cn=mailauth,ou=System,dc=example,dc=com",
 "bind_password": "secret-bind-password",
 "ca_cert_path": "/etc/ssl/certs/example-ca.crt",
 "cert_requirement": "demand",
 "client_cert_path": "",
 "client_key_path": "",
 "enable_debug": false,
 "enable_referrals": false,
 "enable_starttls": false,
 "enable_tls": false,
 "extra_user_attrs": [
  {
   "ldap_attr": "mailAlternateAddress",
   "local_name": "maildrop"
  },
  {
   "ldap_attr": "employeeType",
   "local_name": "userClass"
  }
 ],
 "group_base_dn": "ou=Groups,dc=example,dc=com",
 "group_search_scope": "sub",
 "ldap_idle_timeout": 300,
 "ldap_reconnect_delay": 5,
 "ldap_timeout": 60,
 "max_pending_ops": 10,
 "password_scheme": "SSHA",
 "sasl_mech": "",
 "sasl_realm": "",
 "search_scope": "sub",
 "tls_cipher_list": "HIGH:MEDIUM:!aNULL:!MD5:!3DES",
 "uris": [
  "ldaps://ldap.example.com",
  "ldaps://ldap-backup.example.com"
 ],
 "user_filter": "(&(objectClass=posixAccount)(uid=%u))"
}
