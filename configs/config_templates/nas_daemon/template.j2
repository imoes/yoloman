# Network Audio System daemon configuration
# Listen address for incoming connections (IP or hostname)
host = {{ host }}

# TCP port for audio streaming
port = {{ port }}

# Audio sample format (e.g., 'float', 'int16', 'uint8')
sample_format = {{ sample_format }}

# Audio sample rate (Hz)
sample_rate = {{ sample_rate }}

# Number of channels (1 = mono, 2 = stereo)
channels = {{ channels }}

# Buffer size in milliseconds
buffer_ms = {{ buffer_ms }}

# Enable/Disable audio compression
compress = {{ compress | lower }}

# Maximum number of simultaneous clients
max_clients = {{ max_clients }}

# Path to PID file
pid_file = {{ pid_file }}

# Path to log file
log_file = {{ log_file }}

# Log level: 'debug', 'info', 'notice', 'warning', 'error', 'critical'
log_level = {{ log_level }}

# List of allowed source IPs (empty list = allow all)
{% for ip in allowed_ips %}
allowed_ip = {{ ip }}
{% endfor %}

# List of allowed hostnames (empty list = allow all)
{% for hostname in allowed_hosts %}
allowed_host = {{ hostname }}
{% endfor %}

# Enable/Disable multicast support
multicast = {{ multicast | lower }}

# Multicast group address (ignored if multicast = false)
mcast_group = {{ mcast_group }}

# Multicast TTL
mcast_ttl = {{ mcast_ttl }}

# Path to default audio output device (e.g., 'default', 'hw:0,0')
output_device = {{ output_device }}

# Enable/Disable automatic gain control
agc = {{ agc | lower }}

# Volume step (0.0–1.0); used for volume control increments
volume_step = {{ volume_step }}
