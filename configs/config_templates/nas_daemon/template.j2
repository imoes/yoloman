# Network Audio System (NAS) daemon configuration file
# Generated by Ansible Jinja2 template.
# This configuration controls the behavior of the nas_daemon,
# a network audio streaming server.

# ---------------------------------------------------------------------------
# Network Binding
# ---------------------------------------------------------------------------

# IP address or hostname the NAS daemon will bind to for incoming connections.
# Default: '0.0.0.0' (listen on all available interfaces).
# Use '127.0.0.1' to restrict access to the local machine only.
host = {{ host | default('0.0.0.0') }}

# TCP port number used for audio streaming (commonly 5000–5010).
# Default: 5000.
port = {{ port | default(5000) }}

# ---------------------------------------------------------------------------
# Audio Stream Parameters
# ---------------------------------------------------------------------------

# Data format of audio samples (e.g., 'float', 'int16', 'uint8').
# Choose based on client expectations and CPU efficiency.
# Default: 'float'.
sample_format = {{ sample_format | default('float') }}

# Audio sample rate in Hz (e.g., 44100, 48000, 96000).
# Match to your audio hardware or network constraints.
# Default: 48000.
sample_rate = {{ sample_rate | default(48000) }}

# Number of audio channels (1 = mono, 2 = stereo).
# Higher counts increase bandwidth use.
# Default: 2.
channels = {{ channels | default(2) }}

# Audio buffer size in milliseconds.
# Larger values reduce dropouts on slow networks but increase latency.
# Default: 100.
buffer_ms = {{ buffer_ms | default(100) }}

# Enable or disable on-the-fly audio compression (e.g., for reducing bandwidth
# over constrained links).
# Default: false.
compress = {{ compress | default(False) | lower }}

# ---------------------------------------------------------------------------
# Client Access Control
# ---------------------------------------------------------------------------

# Maximum number of simultaneous clients allowed to connect and stream audio.
# Default: 10.
max_clients = {{ max_clients | default(10) }}

# List of allowed client IP addresses.
# If empty (the default), all IPs are allowed (not recommended for production).
# Each entry in the list generates an 'allowed_ip' directive below.
{% for ip in (allowed_ips | default([])) %}
allowed_ip = {{ ip }}
{% endfor %}

# List of allowed client hostnames. Resolved at connection time.
# If empty, all hostnames are allowed.
# Each entry in the list generates an 'allowed_host' directive below.
{% for hostname in (allowed_hosts | default([])) %}
allowed_host = {{ hostname }}
{% endfor %}

# ---------------------------------------------------------------------------
# Multicast Configuration
# ---------------------------------------------------------------------------

# Enable or disable multicast streaming (requires compatible client and
# network infrastructure).
# Default: false.
multicast = {{ multicast | default(False) | lower }}

# Multicast IP group address (valid range: 224.0.0.0–239.255.255.255).
# Ignored if multicast is disabled.
# Default: '239.255.0.1'.
mcast_group = {{ mcast_group | default('239.255.0.1') }}

# Multicast Time-to-Live (TTL). Limits how many hops the packet can traverse
# (1 = local subnet, 64 = typical default).
# Default: 64.
mcast_ttl = {{ mcast_ttl | default(64) }}

# ---------------------------------------------------------------------------
# Audio Output & Gain
# ---------------------------------------------------------------------------

# Audio output device identifier (e.g., 'default', 'hw:0,0', 'plughw:1,0').
# Must match ALSA or system audio backend.
# Default: 'default'.
output_device = {{ output_device | default('default') }}

# Enable automatic gain control to normalize input volume (useful for
# inconsistent source levels).
# Default: false.
agc = {{ agc | default(False) | lower }}

# Volume control increment (0.0–1.0) per step (e.g., 0.05 = ±5% per button press).
# Default: 0.05.
volume_step = {{ volume_step | default(0.05) }}

# ---------------------------------------------------------------------------
# Daemon Management
# ---------------------------------------------------------------------------

# Absolute path where the daemon writes its process ID (PID) on startup.
# Ensure the directory exists and is writable by the daemon user.
# Default: '/run/nas/nas.pid'.
pid_file = {{ pid_file | default('/run/nas/nas.pid') }}

# Absolute path to the log file where the daemon writes runtime messages.
# Ensure the directory exists and is writable by the daemon user.
# Default: '/var/log/nas/nas.log'.
log_file = {{ log_file | default('/var/log/nas/nas.log') }}

# Verbosity level for logging: 'debug', 'info', 'notice', 'warning', 'error',
# or 'critical'.
# Default: 'info'.
log_level = {{ log_level | default('info') }}