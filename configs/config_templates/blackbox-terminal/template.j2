{# ============================================================================ #}
{# blackbox-terminal configuration template                                     #}
{# Self-documenting: every directive is preceded by a comment describing the    #}
{# corresponding schema field and its default value.                            #}
{# ============================================================================ #}

{# -------------------------------------------------------------------------- #}
{# [general] Section                                                          #}
{# -------------------------------------------------------------------------- #}

{# Working directory for new terminal instances                             #}
{# Default: '/home/user'                                                    #}
[general]
working_directory = {{ working_directory|default('/home/user') }}

{# Command to execute in the terminal (e.g., '/bin/bash')                   #}
{# Default: '' (empty string; if omitted, no explicit command is set)       #}
{% if command|default('') != '' %}
command = {{ command|default('') }}
{% endif %}

{# Font name and size, in Pango format                                      #}
{# Default: 'Monospace 10'                                                  #}
font = {{ font|default('Monospace 10') }}

{# Spacing between terminal cells in pixels                                 #}
{# Default: 0                                                               #}
cell_spacing = {{ cell_spacing|default(0) }}

{# Enable transparent background (if supported by compositor)               #}
{# Default: false                                                           #}
transparent_background = {{ transparent_background|default(false) }}

{# Show or hide the header bar with tabs and controls                       #}
{# Default: true                                                            #}
show_header_bar = {{ show_header_bar|default(true) }}

{# Terminal color scheme name (e.g., 'Tango', 'Dark', 'Solarized Dark')     #}
{# Default: 'Tango'                                                         #}
color_scheme = {{ color_scheme|default('Tango') }}

{# Use the terminal color scheme to theme the application                   #}
{# Default: true                                                            #}
theme_from_scheme = {{ theme_from_scheme|default(true) }}

{# -------------------------------------------------------------------------- #}
{# [shortcuts] Section                                                        #}
{# -------------------------------------------------------------------------- #}

{# List of custom keyboard shortcuts as key-value pairs (e.g.,               #}
{# 'copy = <Ctrl><Shift>C')                                                   #}
{# Each item is a map with 'key' and 'val' fields.                          #}
{# Default: [] (empty list; no custom shortcuts)                            #}
{% if shortcuts|default([])|length > 0 %}
[shortcuts]
{% for item in shortcuts|default([]) %}
# Key: {{ item.key }} — Value: {{ item.val }}
{{ item.key }} = {{ item.val }}
{% endfor %}
{% endif %}