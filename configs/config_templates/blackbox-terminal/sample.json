{
  "working_directory": "/home/user/projects",
  "command": "/bin/zsh -l",
  "font": "JetBrains Mono Nerd Font 11",
  "cell_spacing": 2,
  "transparent_background": true,
  "show_header_bar": false,
  "color_scheme": "Dracula",
  "theme_from_scheme": true,
  "shortcuts": [
    {
      "key": "copy",
      "val": "<Ctrl><Shift>C"
    },
    {
      "key": "paste",
      "val": "<Ctrl><Shift>V"
    },
    {
      "key": "close_tab",
      "val": "<Ctrl><Shift>W"
    }
  ]
}
