# OPA Address Resolution Configuration
# This template configures the Open Fabric Address Resolution daemon (dsap)
# for InfiniBand/RoCE fabrics on Red Hat-based systems.
# It manages Service ID (SID) mappings for PSM (Portable Socket Module)
# control and data paths, as well as debug logging levels.

# Debug logging controls. Uses syslog log levels, ranging from 1 (system panic)
# to 7 (trace level). Generally, only levels 4-6 are useful to normal users.
# See the man page for vsyslog for more information. Default: 5.
Dbg={{ Dbg | default('5') }}

# PSM MPI SID range: Control Service IDs.
# These SIDs identify virtual fabrics for PSM Control traffic.
# The full Service ID is constructed as 0x10001175 + <Suffix>.
# Range: 1 - 0xFFFFFFFFFFFFFFFF. Zero is not supported.

# Hex suffix for the first PSM Control Service ID (full value 0x1000117500000000).
SID=0x10001175{{ PsM_Control_SID_Suffix_1 | default('117500000000') }}

# Hex suffix for the second PSM Control Service ID (full value 0x1000117500000001).
SID=0x10001175{{ PsM_Control_SID_Suffix_2 | default('117500000001') }}

# Hex suffix for the third PSM Control Service ID (full value 0x1000117500000002).
SID=0x10001175{{ PsM_Control_SID_Suffix_3 | default('117500000002') }}

# Hex suffix for the fourth PSM Control Service ID (full value 0x1000117500000003).
SID=0x10001175{{ PsM_Control_SID_Suffix_4 | default('117500000003') }}

# Hex suffix for the fifth PSM Control Service ID (full value 0x1000117500000004).
SID=0x10001175{{ PsM_Control_SID_Suffix_5 | default('117500000004') }}

# Hex suffix for the sixth PSM Control Service ID (full value 0x1000117500000005).
SID=0x10001175{{ PsM_Control_SID_Suffix_6 | default('117500000005') }}

# Hex suffix for the seventh PSM Control Service ID (full value 0x1000117500000006).
SID=0x10001175{{ PsM_Control_SID_Suffix_7 | default('117500000006') }}

# Hex suffix for the eighth PSM Control Service ID (full value 0x1000117500000007).
SID=0x10001175{{ PsM_Control_SID_Suffix_8 | default('117500000007') }}

# PSM MPI SID range: Data Service IDs.
# These SIDs identify virtual fabrics for PSM Data traffic.
# The full Service ID is constructed as 0x10001175 + <Suffix>.

# Hex suffix for the first PSM Data Service ID (full value 0x1000117500000008).
SID=0x10001175{{ PsM_Data_SID_Suffix_1 | default('117500000008') }}

# Hex suffix for the second PSM Data Service ID (full value 0x1000117500000009).
SID=0x10001175{{ PsM_Data_SID_Suffix_2 | default('117500000009') }}

# Hex suffix for the third PSM Data Service ID (full value 0x100011750000000a).
SID=0x10001175{{ PsM_Data_SID_Suffix_3 | default('11750000000a') }}

# Hex suffix for the fourth PSM Data Service ID (full value 0x100011750000000b).
SID=0x10001175{{ PsM_Data_SID_Suffix_4 | default('11750000000b') }}

# Hex suffix for the fifth PSM Data Service ID (full value 0x100011750000000c).
SID=0x10001175{{ PsM_Data_SID_Suffix_5 | default('11750000000c') }}

# Hex suffix for the sixth PSM Data Service ID (full value 0x100011750000000d).
SID=0x10001175{{ PsM_Data_SID_Suffix_6 | default('11750000000d') }}

# Hex suffix for the seventh PSM Data Service ID (full value 0x100011750000000e).
SID=0x10001175{{ PsM_Data_SID_Suffix_7 | default('11750000000e') }}

# Hex suffix for the eighth PSM Data Service ID (full value 0x100011750000000f).
SID=0x10001175{{ PsM_Data_SID_Suffix_8 | default('11750000000f') }}

# PSM MPI SID range #2: Control Service IDs.
# Alternative control SIDs defined directly.

# First Service ID for PSM Control Range #2.
SID={{ PsM_Control2_SID_1 | default('0x1') }}

# Second Service ID for PSM Control Range #2.
SID={{ PsM_Control2_SID_2 | default('0x2') }}

# Third Service ID for PSM Control Range #2.
SID={{ PsM_Control2_SID_3 | default('0x3') }}

# Fourth Service ID for PSM Control Range #2.
SID={{ PsM_Control2_SID_4 | default('0x4') }}

# Fifth Service ID for PSM Control Range #2.
SID={{ PsM_Control2_SID_5 | default('0x5') }}

# Sixth Service ID for PSM Control Range #2.
SID={{ PsM_Control2_SID_6 | default('0x6') }}

# Seventh Service ID for PSM Control Range #2.
SID={{ PsM_Control2_SID_7 | default('0x7') }}

# PSM MPI SID range #2: Data Service IDs.
# Alternative data SIDs defined directly.

# First Service ID for PSM Data Range #2.
SID={{ PsM_Data2_SID_1 | default('0x9') }}

# Second Service ID for PSM Data Range #2.
SID={{ PsM_Data2_SID_2 | default('0xa') }}

# Third Service ID for PSM Data Range #2.
SID={{ PsM_Data2_SID_3 | default('0xb') }}

# Fourth Service ID for PSM Data Range #2.
SID={{ PsM_Data2_SID_4 | default('0xc') }}

# Fifth Service ID for PSM Data Range #2.
SID={{ PsM_Data2_SID_5 | default('0xd') }}

# Sixth Service ID for PSM Data Range #2.
SID={{ PsM_Data2_SID_6 | default('0xe') }}

# Seventh Service ID for PSM Data Range #2.
SID={{ PsM_Data2_SID_7 | default('0xf') }}
