{
  "srcpd_tcp_port": {
    "type": "number",
    "default": 4303,
    "description": "The TCP port for the MIDI server."
  },
  "srcpd_pid_file": {
    "type": "string",
    "default": "/var/run/srcpd.pid",
    "description": "Path to the PID file."
  },
  "srcpd_username": {
    "type": "string",
    "default": "nobody",
    "description": "User to run the server process as."
  },
  "srcpd_groupname": {
    "type": "string",
    "default": "nogroup",
    "description": "Group to run the server process as."
  },
  "srcpd_verbosity": {
    "type": "number",
    "default": 3,
    "description": "Verbosity level for logging."
  },
  "srcpd_loopback_devices": {
    "type": "number",
    "default": 3,
    "description": "Number of loopback MIDI devices."
  },
  "srcpd_use_watchdog": {
    "type": "string",
    "default": "no",
    "description": "Enable watchdog timer.",
    "enum": [
      "yes",
      "no"
    ]
  },
  "srcpd_auto_power_on": {
    "type": "string",
    "default": "yes",
    "description": "Automatically power on MIDI devices.",
    "enum": [
      "yes",
      "no"
    ]
  }
}
