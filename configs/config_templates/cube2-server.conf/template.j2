[server]
; Server hostname or IP to bind to (empty = all interfaces)
host = {{ host }}

; TCP port for game server connections
port = {{ port }}

; UDP port for game traffic (if different from TCP port, otherwise same as TCP)
udp_port = {{ udp_port | default(port) }}

; Maximum number of concurrent player slots
maxplayers = {{ maxplayers }}

; Name of the server as it appears in server lists
servername = "{{ servername }}"

; Game mode: 0=CTF, 1=TDM, 2=FFA, 3=CTF+, 4=TDM+, 5=FFA+
gamemode = {{ gamemode }}

; Map name (without .map extension)
mapname = "{{ mapname }}"

; Whether to require password to connect (0 = none, 1 = admin only, 2 = everyone)
password = {{ password }}

; RCON password for remote administration
rconpassword = "{{ rconpassword }}"

; Log level: 0=quiet, 1=normal, 2=verbose, 3=debug
loglevel = {{ loglevel }}

; Log file path (empty = no file logging)
logfile = "{{ logfile }}"

[admin]
; Comma-separated list of admin SteamIDs (empty = no admins)
admins = {{ admins | join(', ') }}

[filters]
; Comma-separated list of banned SteamIDs (empty = no bans)
bans = {{ bans | join(', ') }}

[features]
; Whether to enable voice chat (0 = disabled, 1 = enabled)
voice = {{ voice }}

; Whether to allow player registration (0 = no, 1 = yes)
register = {{ register }}

; Whether to show server in public lists
public = {{ public }}
