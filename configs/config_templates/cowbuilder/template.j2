# /etc/pbuilderrc — default configuration for cowbuilder
# Load default cowbuilder settings
. /etc/cowbell/cowbell.conf 2>/dev/null || true

# Distribution to use (e.g., stable, testing, unstable)
# Specify Debian/Ubuntu codename(s) for target build
DIST={{ dist }}

# Architecture to build for (e.g., amd64, i386, arm64)
# Leave empty to build for host architecture
ARCH={{ arch | default('') }}

# BaseTGZ path — location of the base image tarball
# cowbuilder uses this to store and reuse the chroot snapshot
BASETGZ={{ base_tgz_path }}

# Mirror URL — APT repository mirror used for debootstrap
# Must be a valid Debian/Ubuntu mirror, e.g., http://deb.debian.org/debian
MIRROR={{ mirror_url }}

# Additional APT sources for extra repositories (e.g., backports, security)
# Each entry is one line of /etc/apt/sources.list format
{% for source in extra_sources %}# {{ source.comment }}
{{ source.content }}
{% endfor %}

# Additional packages to install into the build environment
# Useful for build dependencies not in base system
{% if extra_packages %}EXTRAPACKAGES="{{ extra_packages | join(' ') }}"
{% else %}# EXTRAPACKAGES not set
{% endif %}

# APT options (e.g., to disable prompts, set cache dir)
APTOPTIONS="-o Acquire::Retries=3 -o APT::Get::AllowUnauthenticated=true"

# Cow-specific options — cowbuilder wrapper settings
# cow uses /var/cache/cow for chroot snapshots; adjust if needed
 cowcow_opts="{{ cowcow_opts | default('--no-copyonwrite') }}"

# Use cow's copy-on-write (COW) mode for speed (on supported filesystems)
# Set to false to disable COW and use full copies (e.g., for NFS)
{% if use_cow %}USECOW={{ use_cow }}
{% else %}# COW disabled; set USECOW=false explicitly if needed
{% endif %}

# Extra cowbuilder options (e.g., --no-cleanup-after, --auto-cleanup)
COWBUILDER_OPTS="{{ cowbuilder_opts | default('--auto-cleanup') }}"

# Custom hooks: pre-build, post-build, etc.
# Hook scripts run inside the chroot or on the host; paths are absolute
{% if hooks %}
# Custom hooks
{% for hook in hooks %}{{ hook.type | upper }}HOOK="{{ hook.script_path }}"
{% endfor %}
{% endif %}

# Environment variables passed into the chroot
{% for var, val in env_vars.items() %}export {{ var }}="{{ val }}"
{% endfor %}

# Build directory (inside chroot) — where source is unpacked & built
BUILD_DIR={{ build_dir }}

# Output directory — where .deb files are copied after build
OUTPUT_DIR={{ output_dir }}

# Use https for mirror (if supported by mirror and debootstrap)
{% if use_https_mirror %}# Mirror uses HTTPS
MIRROR="https://{{ mirror_url.split('://')[1] }}"
{% endif %}

# Disable dpkg-unsafe-locale to avoid locale warnings
DPKGUnsafeLocale="0"

# Default root command — sudo or doas, etc.
# cowbuilder uses cow, which internally uses sudo by default
ROOTCMD="sudo cow"
