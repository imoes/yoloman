{
  "dist": "noble",
  "arch": "amd64",
  "base_tgz_path": "/var/cache/cow/noble-amd64.cow",
  "mirror_url": "http://archive.ubuntu.com/ubuntu",
  "extra_sources": [
    {
      "comment": "Ubuntu security updates",
      "content": "deb http://security.ubuntu.com/ubuntu noble-security main universe"
    },
    {
      "comment": "Ubuntu backports",
      "content": "deb http://archive.ubuntu.com/ubuntu noble-backports main universe"
    }
  ],
  "extra_packages": [
    "devscripts",
    "build-essential",
    "lintian"
  ],
  "cowcow_opts": "",
  "use_cow": true,
  "cowbuilder_opts": "--auto-cleanup --buildplace /var/cache/cow/buildplace",
  "hooks": [
    {
      "type": "prebuild",
      "script_path": "/usr/local/bin/cow-prebuild.sh"
    }
  ],
  "env_vars": {
    "DEB_BUILD_OPTIONS": "parallel=4 nocheck",
    "LC_ALL": "C.UTF-8"
  },
  "build_dir": "/tmp/buildd",
  "output_dir": "/var/cache/cow/result"
}
