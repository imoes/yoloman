# qnetd configuration file — controls the Corosync QNetd service behavior
# Listen address and port for incoming client connections
bind_address: {{ bind_address }}
port: {{ port }}

# TLS configuration directory for certificates and keys
tls_dir: {{ tls_dir }}

# Log level: debug, info, notice, warning, error, critical
tls_log_level: {{ tls_log_level }}

# Algorithm used for cluster authentication (e.g., '3des-cbc', 'aes256-cbc')
tls_algorithm: {{ tls_algorithm }}

# Enable or disable client authentication via certificate
tls_client_auth: {{ tls_client_auth | lower }}

# List of allowed TLS cipher suites (if tls_client_auth is 'on', this may be restricted)
# Leave empty to use defaults (recommended unless compliance requires specific ciphers)
tls_ciphers: {{ tls_ciphers | default([]) | join(', ') }}

# Maximum number of simultaneous client connections
max_connections: {{ max_connections }}

# Timeout (in seconds) for client connection handshake
tls_handshake_timeout: {{ tls_handshake_timeout }}

# Optional: logging destination
# If empty, defaults to syslog
tls_log_file: {{ tls_log_file | default('') | replace('
', '') }}

# Optional: certificate verification depth
tls_verify_depth: {{ tls_verify_depth }}

# Optional: Enable or disable TLS session caching (improves reconnect performance)
tls_session_cache: {{ tls_session_cache | lower }}

# Optional: Log certificate errors (for debugging certificate issues)
tls_log_certificate_errors: {{ tls_log_certificate_errors | lower }}
