{
  "bind_address": "10.0.0.5",
  "port": 5403,
  "tls_dir": "/etc/corosync/qnetd",
  "tls_log_level": "warning",
  "tls_algorithm": "aes256-cbc",
  "tls_client_auth": true,
  "tls_ciphers": [
    "aes256-gcm@openssh.com",
    "chacha20-poly1305@openssh.com",
    "aes256-cbc"
  ],
  "max_connections": 32,
  "tls_handshake_timeout": 20,
  "tls_log_file": "/var/log/qnetd.log",
  "tls_verify_depth": 5,
  "tls_session_cache": true,
  "tls_log_certificate_errors": true
}
