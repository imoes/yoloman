# WebVTT Segmentation Configuration
# This file configures the WebVTT file segmentation tool.
# Command usage example: webvtt segment {{ source_path | default('/var/www/subtitles/captions.vtt') }}

# --source_path PATH
# Path to the input WebVTT file to be segmented.
# default: /var/www/subtitles/captions.vtt
source_path: {{ source_path | default('/var/www/subtitles/captions.vtt') }}

# --output_dir DIRECTORY
# Directory where the segmented WebVTT files will be written.
# default: /var/www/subtitles/segments
output_dir: {{ output_dir | default('/var/www/subtitles/segments') }}

# --target-duration NUMBER
# Target duration in seconds for each generated segment.
# default: 10
target_duration: {{ target_duration | default(10) }}

# --mpegts NUMBER
# Presentation timestamp value (timebase) used for segment timing.
# default: 900000
mpegts: {{ mpegts | default(900000) }}