# Configuration for lswm (Wiimote discovery utility)
# Note: lswm is a CLI tool with limited persistent configuration.
# These options control default behaviors when arguments are not explicitly passed.

# If true, lswm displays a summary of options and exits. Corresponds to the -h flag.
show_help: {{ show_help | default(false) }}

# If true, lswm lists all Bluetooth devices, not just Wiimotes. Corresponds to the -a flag.
list_all_bt: {{ list_all_bt | default(false) }}

# If true, lswm outputs device details in long format. Corresponds to the -l flag.
long_format: {{ long_format | default(false) }}

# If true, lswm runs in quiet mode, suppressing standard output. Corresponds to the -q flag.
quiet_mode: {{ quiet_mode | default(false) }}