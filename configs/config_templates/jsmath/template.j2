# ==============================================================================
# jsMath Configuration Template
# ==============================================================================
# This template configures Apache to serve jsMath source files.
# It sets up an alias for the URL path and defines directory access controls
# for the filesystem location of the jsMath files.

# --------------------------------------------------------------------------
# Alias Directive
# --------------------------------------------------------------------------
# Sets the URL path where jsMath files are served.
# Maps the URL prefix /jsMath to the filesystem path defined by jsmath_alias_path.
Alias /jsMath {{ jsmath_alias_path | default('/usr/share/jsmath') }}

# --------------------------------------------------------------------------
# Directory Directive
# --------------------------------------------------------------------------
# Configures access control and options for the jsMath source files directory.
# Ensures symbolic links are followed and directory indexing is disabled.
<Directory {{ jsmath_document_root | default('/usr/share/jsmath') }}>
    # Follow symbolic links within the directory, but do not list directory contents (-Indexes).
    Options +FollowSymLinks -Indexes

    # Allow .htaccess files to override specific security and file info settings,
    # but restrict which directives can be overridden for security.
    AllowOverride Limit Options FileInfo
</Directory>
