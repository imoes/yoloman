# yubihsm-connector-redhat Configuration Template
# This template generates the configuration file for the YubiHSM Connector service on Red Hat systems.
# All variables are derived from the Ansible role's inventory/variables with safe defaults.

# Certificate (X.509)
# Path to the X.509 certificate file used for client authentication.
# If empty, the connector may not support client certificate verification or will use defaults.
#cert: "{{ cert | default('') }}"
#
# Certificate key
# Path to the certificate private key file corresponding to the certificate above.
#key: "{{ key | default('') }}"
#
# Listening address. Defaults to "127.0.0.1:12345".
# Specifies the host and port the connector listens on for API requests.
listen: "{{ listen | default('127.0.0.1:12345') }}"
#
# Device serial in case of multiple devices
# Device serial number for selecting a specific device when multiple are present.
# If empty, the first available device is usually selected.
#serial: "{{ serial | default('') }}"
#
# Log to syslog/eventlog. Defaults to "false".
# Whether to log to syslog/eventlog instead of stderr/log files.
# Converts boolean-like strings ('true'/'false') to the expected format if necessary,
# though this config format typically accepts raw boolean or string values.
syslog: "{{ syslog | default(false) }}"
