# =============================================================================
# puppet-lint configuration template
#
# This template generates a configuration file for puppet-lint, a tool used to
# check Puppet code for style errors and warnings.
#
# Variables are drawn from the Ansible role variables matching the schema.
# All variables use Jinja2 'default' filters to ensure safe rendering even
# when undefined.
# =============================================================================

# List of paths to Puppet manifests or directories to lint.
# Default: ['/etc/puppetlabs/code/environments/production/manifests']
paths:
{% for p in paths | default(['/etc/puppetlabs/code/environments/production/manifests']) -%}
  - "{{ p }}"
{% endfor %}

# Comma-separated list of check names to run exclusively.
# If empty, runs all available checks.
# Default: ''
only_checks: "{{ only_checks | default('') }}"

# List of glob patterns for paths to ignore during linting.
# Default: []
ignore_paths:
{% for pattern in ignore_paths | default([]) -%}
  - "{{ pattern }}"
{% endfor %}

# List of variable names allowed at top scope (e.g., 'hiera', 'lookup').
# Default: []
top_scope_variables:
{% for var in top_scope_variables | default([]) -%}
  - "{{ var }}"
{% endfor %}

# Path to a Ruby file containing custom puppet-lint checks.
# Default: ''
custom_checks_file: "{{ custom_checks_file | default('') }}"

# Puppet module path to load custom checks/plugins from.
# Default: ''
load_from_puppet: "{{ load_from_puppet | default('') }}"

# Output format: 'plain', 'json', 'sarif', or 'codeclimate'.
# Default: 'plain'
output_format: "{{ output_format | default('plain') }}"

# File path to write Code Climate compatible JSON report.
# Used when output_format is 'codeclimate'.
# Default: ''
code_climate_report_file: "{{ code_climate_report_file | default('') }}"

# Return non-zero exit status if warnings are present.
# Default: false
fail_on_warnings: {{ fail_on_warnings | default(false) }}

# Threshold for errors: 'warning', 'error', or 'all'.
# Default: 'warning'
error_level: "{{ error_level | default('warning') }}"

# Custom log format string using placeholders like %{filename}, %{line}.
# Default: ''
log_format: "{{ log_format | default('') }}"

# Show the context (code snippet) where the problem occurs.
# Default: false
show_context: {{ show_context | default(false) }}

# Show linting problems that have been ignored via control comments.
# Default: false
show_ignored: {{ show_ignored | default(false) }}

# Display the filename before the warning message.
# Default: false
show_filename: {{ show_filename | default(false) }}

# Attempt to automatically fix detected errors.
# Default: false
auto_fix: {{ auto_fix | default(false) }}

# Compare module layout relative to the module root.
# Default: false
relative: {{ relative | default(false) }}

# List of check names to explicitly disable (e.g., 'trailing_whitespace').
# Default: []
skipped_checks:
{% for check in skipped_checks | default([]) -%}
  - "{{ check }}"
{% endfor %}