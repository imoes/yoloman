{
  "paths": [
    "/opt/puppet-code/manifests",
    "/opt/puppet-code/modules"
  ],
  "only_checks": "",
  "ignore_paths": [
    "test/**/*.pp",
    "spec/**/*.pp"
  ],
  "top_scope_variables": [
    "hiera",
    "lookup"
  ],
  "custom_checks_file": "",
  "load_from_puppet": "",
  "output_format": "sarif",
  "code_climate_report_file": "/tmp/lint_report.json",
  "fail_on_warnings": true,
  "error_level": "error",
  "log_format": "%{filename}:%{line} %{KIND} %{message}",
  "show_context": true,
  "show_ignored": false,
  "show_filename": true,
  "auto_fix": false,
  "relative": true,
  "skipped_checks": [
    "trailing_whitespace",
    "80chars"
  ]
}
