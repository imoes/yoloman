{
  "jxplorer_default_server": "ldap.example.com",
  "jxplorer_default_port": 636,
  "jxplorer_default_ssl": true,
  "jxplorer_default_bind_dn": "cn=admin,dc=example,dc=com",
  "jxplorer_default_bind_pw": "securepassword",
  "jxplorer_default_base_dn": "dc=example,dc=com",
  "jxplorer_default_search_scope": "sub",
  "jxplorer_connections": [
    {
      "name": "Production LDAP",
      "server": "ldap1.prod.example.com",
      "port": 389,
      "ssl": false,
      "base_dn": "dc=prod,dc=example,dc=com",
      "bind_dn": "cn=root,dc=prod,dc=example,dc=com"
    },
    {
      "name": "Development LDAP",
      "server": "localhost",
      "port": 1389,
      "ssl": false,
      "base_dn": "dc=dev,dc=example,dc=com",
      "bind_dn": ""
    }
  ]
}
