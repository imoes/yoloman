# =============================================================================
# ISAG Configuration Template
# ISAG is a tool for generating graphs from sysstat/sar data.
# This template produces an `isag.conf` style configuration file.
# =============================================================================

# --- General Settings ---

# [datafiles_path]
# The pathname where are located the daily data files.
# These files are typically generated by `sar` from the sysstat package.
# Ensure this directory exists and is readable by the user running isag.
# Default: /var/log/sysstat
datafiles_path = {{ datafiles_path | default('/var/log/sysstat') }}

# [gr_height]
# Specify the height of the chart area in pixels.
# Affects the resolution and layout of the generated PNG/SVG images.
# Default: 400
gr_height = {{ gr_height | default(400) }}

# [gr_width]
# Specify the width of the chart area in pixels.
# Affects the resolution and layout of the generated PNG/SVG images.
# Default: 720
gr_width = {{ gr_width | default(720) }}

# --- Y-Axis Limits ---

# [y_limits]
# Y-axis limits for each graph type.
# This section allows overriding the automatic scaling for specific graphs.
# Each entry defines the minimum and maximum values for a specific graph type.
# Format: <graph_type>_ylimits = <min> <max>
# If empty or omitted, isag auto-scales the Y-axis.
{% if y_limits is defined and y_limits | length > 0 %}
{% for item in y_limits %}
# Graph type: {{ item.type | default('unknown') }}
# Limits: {{ item.min | default('auto') }} to {{ item.max | default('auto') }}
{{ item.type }}_ylimits = {{ item.min }} {{ item.max }}
{% endfor %}
{% endif %}