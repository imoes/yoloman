# Slony1 Initialization Configuration
# This template configures the Slony1 cluster initialization script.
# It defines which nodes from the slon_tools.conf configuration file
# should be automatically started by the init script.

# SLON_TOOLS_START_NODES
# Space-separated list of node numbers or names configured in
# slon_tools.conf that should be handled in the init script.
# Example: "1 2 3" or "node1 node2 node3"
# Default: empty string (no nodes auto-started unless specified elsewhere)
SLON_TOOLS_START_NODES="{{ SLON_TOOLS_START_NODES | default('') }}"

# Arguments to pass to slon_start in the init script.
# Uncomment and modify as needed for your cluster requirements.
# Example: --nowatchdog, --verbose, etc.
#SLON_START_ARGS="--nowatchdog"
