# Space-separated list of node numbers or names configured in
# /etc/slony1/slon_tools.conf that should be handled by the init script.
# Example: "1 2 3" or "node1 node2". Leave empty to handle all nodes.
SLON_TOOLS_START_NODES="{{ SLON_TOOLS_START_NODES | default('') }}"

# Arguments to pass to slon_start in the init script.
# Uncomment and modify as needed.
# Example: disable watchdog checks.
#SLON_START_ARGS="--nowatchdog"