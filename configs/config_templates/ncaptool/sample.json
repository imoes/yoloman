{
  "interfaces": [
    {
      "name": "enp9s0",
      "promiscuous": true
    }
  ],
  "bpf_filter": "tcp",
  "output_file": "/var/log/capture.ncap",
  "count": 0,
  "interval": 3600,
  "post_process_cmd": "gzip",
  "hide_source": false,
  "hide_dest": false,
  "debug": false,
  "summary": true
}
