# ============================================================================
# DPDK Hugepages Configuration
# ============================================================================
# This template configures the number of hugepages to reserve at boot for
# DPDK (Data Plane Development Kit) workloads. It also controls pre-allocation
# behaviors such as dropping caches or freeing previously allocated pages.
#
# Schema Reference:
# - NR_2M_PAGES: Number of 2M hugepages to reserve on system boot; for NUMA
#   systems, space-separated per-node counts (e.g., "0 64")
# - NR_1G_PAGES: Number of 1G hugepages to reserve on system boot; for NUMA
#   systems, space-separated per-node counts (e.g., "0 2")
# - NR_16M_PAGES: Number of 16M hugepages to reserve on system boot; for NUMA
#   systems, space-separated per-node counts (e.g., "32 0")
# - DROPCACHE_BEFORE_HP_ALLOC: Set to 1 to drop slab/pagecache before
#   allocating hugepages (default 0)
# - FREE_PREVIOUS_ALLOCATIONS: Set to 0 to disable freeing of previously
#   allocated hugepages (default 1)
# ============================================================================

# ----------------------------------------------------------------------------
# 2M Hugepages Configuration
# ----------------------------------------------------------------------------
# The number of 2M hugepages to reserve on system boot.
# For NUMA systems, provide space-separated per-node counts (e.g., "0 64").
# Default is 0 (no reservation).
NR_2M_PAGES={{ (NR_2M_PAGES | default('0')) | string }}

# ----------------------------------------------------------------------------
# 1G Hugepages Configuration
# ----------------------------------------------------------------------------
# The number of 1G hugepages to reserve on system boot.
# For NUMA systems, provide space-separated per-node counts (e.g., "0 2").
# Default is 0 (no reservation).
NR_1G_PAGES={{ (NR_1G_PAGES | default('0')) | string }}

# ----------------------------------------------------------------------------
# 16M Hugepages Configuration
# ----------------------------------------------------------------------------
# The number of 16M hugepages to reserve.
# Supported on specific architectures like ppc64el.
# For NUMA systems, provide space-separated per-node counts (e.g., "32 0").
# Default is 0 (no reservation).
NR_16M_PAGES={{ (NR_16M_PAGES | default('0')) | string }}

# ----------------------------------------------------------------------------
# Pre-allocation Cache Dropping
# ----------------------------------------------------------------------------
# Dropping slab and pagecache can help to successfully allocate hugepages,
# especially later in the lifecycle of a system.
# This comes at the cost of losing all slab and pagecache on (re)start
# of the dpdk service - therefore the default is off (0).
# Set to 1 to enable it.
DROPCACHE_BEFORE_HP_ALLOC={{ (DROPCACHE_BEFORE_HP_ALLOC | default('0')) | string }}

# ----------------------------------------------------------------------------
# Previous Allocation Handling
# ----------------------------------------------------------------------------
# When using other hugepage allocation mechanisms (e.g. kernel commandline)
# this script might find pre-allocated pages. This can also happen when the
# script is run multiple times with configuration changing.
# In this case the script will free previously allocated pages by default,
# but that freeing can be disabled.
# Set to 0 to disable freeing.
FREE_PREVIOUS_ALLOCATIONS={{ (FREE_PREVIOUS_ALLOCATIONS | default('1')) | string }}