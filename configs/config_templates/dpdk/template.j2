# DPDK Hugepages Configuration
# This file configures the reservation and allocation of kernel hugepages for DPDK applications.
# It is typically sourced by init scripts or systemd units before starting DPDK services.

# Number of 2M hugepages to reserve on system boot.
# For NUMA systems, provide space-separated per-node counts (e.g., "0 64" reserves 0 on node 0, 64 on node 1).
# Default is 0 (none).
NR_2M_PAGES={{ NR_2M_PAGES | default('0') }}

# Number of 1G hugepages to reserve on system boot.
# For NUMA systems, provide space-separated per-node counts (e.g., "0 2").
# Default is 0 (none).
NR_1G_PAGES={{ NR_1G_PAGES | default('0') }}

# Number of 16M hugepages to reserve on system boot.
# Supported on specific architectures like ppc64el.
# For NUMA systems, provide space-separated per-node counts (e.g., "32 0").
# Default is 0 (none).
NR_16M_PAGES={{ NR_16M_PAGES | default('0') }}

# Set to 1 to drop slab/pagecache before allocating hugepages.
# This can help succeed in allocation during system runtime but causes loss of cache.
# Default is off (empty/commented out, interpreted as 0 by scripts).
{% if DROPCACHE_BEFORE_HP_ALLOC is defined and DROPCACHE_BEFORE_HP_ALLOC | default('') != '' %}
DROPCACHE_BEFORE_HP_ALLOC={{ DROPCACHE_BEFORE_HP_ALLOC | default('') }}
{% else %}
# DROPCACHE_BEFORE_HP_ALLOC=0
{% endif %}

# Set to 0 to disable freeing of previously allocated hugepages.
# By default (1), the script frees pages if they were allocated previously to prevent conflicts.
# Default is enabled (1).
{% if FREE_PREVIOUS_ALLOCATIONS is defined and FREE_PREVIOUS_ALLOCATIONS | default('') != '' %}
FREE_PREVIOUS_ALLOCATIONS={{ FREE_PREVIOUS_ALLOCATIONS | default('') }}
{% else %}
# FREE_PREVIOUS_ALLOCATIONS=1
{% endif %}

# Note: The DPDK library uses the first mounted hugetlbfs.
# Init scripts ensure at least one default mountpoint. For complex setups,
# admins should control specific mountpoints via parameters to the DPDK library.
# Be aware that multiple hugepage sizes and mountpoints may confuse other programs
# (e.g., libvirt/qemu). It is recommended to configure such applications explicitly
# to avoid "guessing" the correct hugepage path.
#
# Hardware may support other granularities (e.g., 4M). Larger hugepages should be
# allocated earlier. If allocation fails, consider reserving pages via kernel commandline
# in /etc/default/grub (e.g., GRUB_CMDLINE_LINUX_DEFAULT="... hugepages=16 hugepagesz=1G hugepages=2").
# Run "update-grub" after modifying GRUB config.
