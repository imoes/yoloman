# Configuration for mstflint (Mellanox Flash Interface)
# This file defines default parameters for firmware burn and query operations.

# Device flash is connected to. Commands affected: all
# The device path for the Mellanox HCA or switch flash interface.
mstflint.device = "{{ device | default('/dev/mst/mt4099_pci_cr0') }}"

# Binary image file. Commands affected: burn, verify
# Path to the firmware binary image file for burning or verification.
mstflint.image = "{{ image | default('/opt/firmware/mellanox_fw.bin') }}"

# Non interactive mode - assume answer "yes" to all questions.
# Commands affected: all
# Run in non-interactive mode, assuming 'yes' to all questions.
mstflint.yes = "{{ yes | default(true) }}"

# GUID base value. 4 GUIDs are automatically assigned to: node, port1, port2, system image.
# Only one of guid or guids should be used. If guids is provided, guid is ignored.
# Base GUID value. 4 GUIDs are automatically derived and assigned to node, port1, port2, and system image.
mstflint.guid = "{{ guid | default('0x0002c90300000000') }}"

# 4 GUIDs must be specified here. Assigned to node, port1, port2, system image respectively.
# List of 4 explicit GUIDs assigned to node, port1, port2, and system image. Overrides 'guid'.
# Note: The original template used `indent` on a list, which produces invalid YAML-like multiline
# syntax for this config format. We emit a JSON-style list representation to ensure validity.
mstflint.guids = {{ guids | default(['0x0002c90300000000', '0x0002c90300000001', '0x0002c90300000002', '0x0002c90300000003']) | tojson }}

# MAC address base value. 2 MACs are automatically assigned to port1, port2.
# Only one of mac or macs should be used. If macs is provided, mac is ignored.
# Base MAC address value. 2 MACs are automatically derived and assigned to port1 and port2.
mstflint.mac = "{{ mac | default('00:02:c9:03:00:00') }}"

# 2 MACs must be specified here. Assigned to port1, port2 respectively.
# List of 2 explicit MAC addresses assigned to port1 and port2. Overrides 'mac'. Applicable only for Ethernet products.
mstflint.macs = {{ macs | default(['00:02:c9:03:00:00', '00:02:c9:03:00:01']) | tojson }}

# Write this string, of up to 208 characters, to VSD when burn.
# Vendor Specific Data string to write to the device during burn (up to 208 chars).
mstflint.vsd = "{{ vsd | default('Production Image v1.0') }}"

# Do not verify each write on the flash.
# Do not verify each write on the flash.
mstflint.no_flash_verify = "{{ no_flash_verify | default(false) }}"

# Print the burning status to the specified log file
# Path to a log file to print burning status to.
mstflint.log = "{{ log | default('/var/log/mstflint.log') }}"

# Flash access will be done using FW (ConnectX-3/ConnectX-3Pro only).
# Flash access will be done using FW (ConnectX-3/ConnectX-3Pro only).
mstflint.use_fw = "{{ use_fw | default(false) }}"

# Allow burning/removing a ROM to/from FW image when product version is present.
# Allow burning/removing a ROM to/from FW image when product version is present.
mstflint.allow_rom_change = "{{ allow_rom_change | default(false) }}"

# Burn the image with blank GUIDs and MACs (where applicable).
# Burn the image with blank GUIDs and MACs.
mstflint.blank_guids = "{{ blank_guids | default(false) }}"

# Commands affected: burn, sg
# Set the number of attached flash devices (banks)
# Set the number of attached flash devices (banks).
mstflint.banks = "{{ banks | default(1) }}"

# Use this flag to indicate that the given image file is in a "striped image" format.
# Commands affected: query verify
# Indicate that the given image file is in a 'striped image' format.
mstflint.striped_image = "{{ striped_image | default(false) }}"

# On SwitchX/ConnectIB devices: Allow accessing the flash even if the cache replacement mode is enabled.
# Allow accessing the flash even if the cache replacement mode is enabled (SwitchX/ConnectIB).
mstflint.override_cache_replacement = "{{ override_cache_replacement | default(false) }}"

# Run a quick query. When specified, flint will not perform full image integrity checks during the query operation.
# Run a quick query without full image integrity checks.
mstflint.qq = "{{ qq | default(false) }}"

# When specified, cpu usage will be reduced. Run time might be increased
# Reduce CPU usage at the cost of increased run time.
mstflint.low_cpu = "{{ low_cpu | default(false) }}"

# When specified, only flashed fw version is fetched
# Only fetch the flashed firmware version.
mstflint.flashed_version = "{{ flashed_version | default(false) }}"

# Burn image in a non failsafe manner.
# Burn image in a non failsafe manner.
mstflint.nofs = "{{ nofs | default(false) }}"

# Do not attempt to work with the FW Ctrl update commands
# Do not attempt to work with the FW Ctrl update commands.
mstflint.no_fw_ctrl = "{{ no_fw_ctrl | default(false) }}"

# Make the burn process burn two images on flash (previously default algorithm).
# Burn two images on flash (previously default algorithm).
mstflint.dual_image = "{{ dual_image | default(false) }}"

# Commands affected: burn
# Burn vsd as appears in the given image - do not keep existing VSD on flash.
# Burn VSD as it appears in the given image.
mstflint.use_image_ps = "{{ use_image_ps | default(false) }}"

# Commands affected: burn
# Burn (guids/macs) as appears in the given image.
# Burn GUIDs/MACs as they appear in the given image.
mstflint.use_image_guids = "{{ use_image_guids | default(false) }}"

# Commands affected: burn
# Do not save the ROM which exists in the device.
# Do not save the ROM which exists in the device.
mstflint.use_image_rom = "{{ use_image_rom | default(false) }}"

# Commands affected: burn
# Save the ROM which exists in the device.
# Save the ROM which exists in the device.
mstflint.use_dev_rom = "{{ use_dev_rom | default(false) }}"

# Commands affected: burn
# Do not attempt to take device data sections from device(sections will be taken from the image. FS3 Only).
# Do not take device data sections from device (taken from image instead).
mstflint.ignore_dev_data = "{{ ignore_dev_data | default(false) }}"