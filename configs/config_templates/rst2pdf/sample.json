{
  "stylesheets": [
    "custom_theme"
  ],
  "stylesheet_path": [
    "/etc/rst2pdf/stylesheets"
  ],
  "font_path": [
    "/usr/share/fonts/custom"
  ],
  "baseurl": "https://example.com/docs",
  "language": "",
  "header": "Report",
  "footer": "Page {{ page_number }}",
  "section_header_depth": 3,
  "smart_quotes": 1,
  "fit_literal_mode": "shrink",
  "fit_background_mode": "center",
  "inline_links": false,
  "repeat_table_rows": true,
  "raw_html": false,
  "no_footnote_backlinks": false,
  "inline_footnotes": true,
  "default_dpi": 150,
  "show_frame_boundary": false,
  "disable_splittables": false,
  "break_level": 1,
  "first_page_on_right": true,
  "blank_first_page": false,
  "break_side": "even",
  "use_numbered_links": true,
  "strip_elements_with_class": [
    "hidden-class"
  ],
  "record_dependencies": "",
  "extension_module": [],
  "custom_cover": "",
  "use_floating_images": false
}
