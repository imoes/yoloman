[global]

# A comma-separated list of custom stylesheets to load.
# Schema default: []
stylesheets = {{ stylesheets | default([]) | join(",") }}

# A colon-separated list of folders to search for stylesheets.
# Schema default: []
stylesheet_path = {{ stylesheet_path | default([]) | join(":") }}

# A colon-separated list of folders to search for fonts.
# Schema default: []
font_path = {{ font_path | default([]) | join(":") }}

# The base URL for relative URLs in the document.
# Schema default: ''
baseurl = {{ baseurl | default('') }}

# Language to be used for hyphenation and docutils localization.
# Empty string or 'None' for default.
# Schema default: ''
language = {{ language | default('') }}

# Page header text if not specified in the document.
# Schema default: ''
header = {{ header | default('') }}

# Page footer text if not specified in the document.
# Schema default: ''
footer = {{ footer | default('') }}

# Sections up to this depth will be used in the header and footer's replacement of ###Section###.
# Schema default: 2
section_header_depth = {{ section_header_depth | default(2) }}

# Smart quotes mode: 0=Suppress, 1=Default, 2=Old-school, 3=Inverted shorthand.
# Schema default: 0
smart_quotes = {{ smart_quotes | default(0) }}

# What to do when a literal is too wide. One of error, overflow, shrink, truncate.
# Schema default: 'shrink'
fit_literal_mode = {{ fit_literal_mode | default('shrink') }}

# How to fit the background image to the page. One of scale, scale_width, center.
# Schema default: 'center'
fit_background_mode = {{ fit_background_mode | default('center') }}

# Shows target between parenthesis instead of active link.
# Schema default: False
inline_links = {{ inline_links | default(False) }}

# Repeats header row for each splitted table.
# Schema default: False
repeat_table_rows = {{ repeat_table_rows | default(False) }}

# Support embedding raw HTML.
# Schema default: False
raw_html = {{ raw_html | default(False) }}

# Disable footnote backlinks.
# Schema default: False
no_footnote_backlinks = {{ no_footnote_backlinks | default(False) }}

# Show footnotes inline.
# Schema default: True
inline_footnotes = {{ inline_footnotes | default(True) }}

# DPI for objects sized in pixels.
# Schema default: 300
default_dpi = {{ default_dpi | default(300) }}

# Show frame borders (only useful for debugging).
# Schema default: False
show_frame_boundary = {{ show_frame_boundary | default(False) }}

# Don't use splittable flowables in some elements.
# Schema default: False
disable_splittables = {{ disable_splittables | default(False) }}

# Maximum section level that starts in a new page.
# Schema default: 0
break_level = {{ break_level | default(0) }}

# When using double sided pages, the first page will start on the right hand side.
# Schema default: False
first_page_on_right = {{ first_page_on_right | default(False) }}

# Add a blank page at the beginning of the document.
# Schema default: False
blank_first_page = {{ blank_first_page | default(False) }}

# How section breaks work. Can be 'even', 'odd', or 'any'.
# Schema default: 'any'
break_side = {{ break_side | default('any') }}

# When using numbered sections, adds the numbers to all links referring to the section headers.
# Schema default: False
use_numbered_links = {{ use_numbered_links | default(False) }}

# Remove elements with these CLASSes from the output.
# Schema default: []
strip_elements_with_class = {{ strip_elements_with_class | default([]) | join(",") }}

# Write output file dependencies to FILE.
# Schema default: ''
record_dependencies = {{ record_dependencies | default('') }}

# Helper extension modules to load (must end in .py and be on python path).
# Schema default: []
extension_module = {{ extension_module | default([]) | join(",") }}

# Template file used for the cover page.
# Schema default: ''
custom_cover = {{ custom_cover | default('') }}

# Makes images with :align: attribute work more like in rst2html.
# Schema default: False
use_floating_images = {{ use_floating_images | default(False) }}