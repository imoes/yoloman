#
# This file controls the configuration of the file access policy daemon.
# See the fapolicyd.conf man page for explanation.
#

# Whether the daemon runs in permissive mode.
# 0=strict, 1=permissive.
permissive = {{ permisive | default(0) }}

# Nice value for the daemon process priority.
nice_val = {{ nice_val | default(14) }}

# Size of the internal event queue.
q_size = {{ q_size | default(800) }}

# User ID to drop privileges to.
uid = {{ uid | default('fapolicyd') }}

# Group ID to drop privileges to.
gid = {{ gid | default('fapolicyd') }}

# Whether to generate stat-based reports.
do_stat_report = {{ do_stat_report | default(1) }}

# Whether to generate detailed access reports.
detailed_report = {{ detailed_report | default(1) }}

# Maximum size (MB) of the database cache.
db_max_size = {{ db_max_size | default(50) }}

# Subject cache size.
subj_cache_size = {{ subj_cache_size | default(1549) }}

# Object cache size.
obj_cache_size = {{ obj_cache_size | default(8191) }}

# Comma-separated list of filesystems to watch.
watch_fs = {{ watch_fs | default('ext2,ext3,ext4,tmpfs,xfs,vfat,iso9660,btrfs') }}

# Trusted database or source name.
trust = {{ trust | default('debdb') }}

# Integrity checking method (e.g., none, sha256).
integrity = {{ integrity | default('none') }}

# Comma-separated fields for syslog format.
syslog_format = {{ syslog_format | default('rule,dec,perm,auid,pid,exe,:,path,ftype,trust') }}

# If 1, only use SHA256 checksums for RPM packages.
rpm_sha256_only = {{ rpm_sha256_only | default(0) }}

# Whether to allow marking files via filesystem operations.
allow_filesystem_mark = {{ allow_filesystem_mark | default(0) }}

# Interval in seconds between periodic reports (0 = disabled).
report_interval = {{ report_interval | default(0) }}