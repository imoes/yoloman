{
  "enabled": true,
  "log_level": 3,
  "log_file": "/var/log/fapolicyd.log",
  "trust_network": true,
  "network_trust": false,
  "event_buffer_size": 10000,
  "rules_dir": "/etc/fapolicyd/rules.d",
  "trust_paths": [
    "/bin",
    "/sbin",
    "/usr/bin",
    "/usr/sbin",
    "/lib",
    "/lib64",
    "/usr/lib",
    "/usr/lib64",
    "/etc",
    "/var/log",
    "/dev",
    "/usr/share"
  ],
  "format": "json",
  "integrity_check": false,
  "metadata_cache_ttl": 60,
  "security_label": true,
  "pid_file": "/run/fapolicyd/fapolicyd.pid",
  "workers": 4,
  "rule_cache": true,
  "rule_cache_file": "/var/cache/fapolicyd/rules.cache"
}
