# /etc/hosts entries for libnodeupdown cluster nodes.
# This file manages the cluster host resolution for the libnodeupdown service.
# The variable nodeupdown_cluster_hosts defines the list of hosts to be added.
# Default value is ['localhost'] as specified in the schema.

# Iterate over the list of cluster hosts defined in nodeupdown_cluster_hosts.
# The variable defaults to ['localhost'] if not provided.
{% for host in (nodeupdown_cluster_hosts | default(['localhost'])) %}
# Entry for cluster host: {{ host }}
127.0.0.1 {{ host }}
{% endfor %}