{
  "architecture": "amd64",
  "architectures": [
    "amd64",
    "i386"
  ],
  "default_release": "stable",
  "snapshot": "",
  "ignore_hold": false,
  "clean_installed": true,
  "immediate_configure": true,
  "force_loop_break": false,
  "cache_start": 20971520,
  "cache_grow": 1048576,
  "cache_limit": 0,
  "build_essential": [
    "build-essential"
  ],
  "never_auto_remove": [
    "linux-.*",
    "grub-.*"
  ],
  "protect_kernels": true,
  "versioned_kernel_packages": [
    "linux-image-[0-9]+\\.[0-9]+\\.[0-9]+(-[^\\s]+)?",
    "linux-headers-[0-9]+\\.[0-9]+\\.[0-9]+(-[^\\s]+)?",
    "linux-modules-[0-9]+\\.[0-9]+\\.[0-9]+(-[^\\s]+)?"
  ],
  "kernel_count": 2,
  "pre_install_pkgs": [
    "/usr/sbin/dpkg-preconfigure --apt"
  ],
  "pre_install_recommends": [],
  "dpkg_options": [
    "--force-confold"
  ],
  "acquire_retries": 2,
  "acquire_timeout": 30,
  "acquire_max_time": 600,
  "acquire_languages": [
    "en",
    "none"
  ],
  "acquire_check_valid_until": true,
  "acquire_check_date": true,
  "acquire_max_future_time": 10,
  "acquire_max_valid_time": 1209600,
  "acquire_min_valid_time": 0,
  "periodic_update_pkg_lists": 1,
  "periodic_download_upgradeable": 1,
  "periodic_autoclean": 7,
  "periodic_verbose": 1,
  "apt_get_assume_yes": false,
  "apt_get_fix_broken": false,
  "apt_get_show_upgraded": true,
  "apt_get_allow_remove": false,
  "apt_get_allow_downgrade": false
}