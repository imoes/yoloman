# Geary Configuration Template
# This template generates the configuration file for Geary, a GTK-based email client.
# It manages bug-tracking integration settings.
# Variables are sourced from Ansible variables with safe defaults defined in the schema.

geary = {
    # impl: The bug tracker implementation to use.
    'impl' : {{ impl | default('launchpad') }},

    # project: The project name for bug tracking.
    'project' : {{ project | default('geary') }},

    # bug_pattern_base: Optional base URL or pattern for bug reporting; None means default behavior.
    # Note: In Python config files, None is a literal keyword, not a string.
    'bug_pattern_base' : {{ bug_pattern_base | default('None') }},
}