{
  "devices": [
    {
      "vendor": "IBM",
      "product": "S/390",
      "path_grouping_policy": "group_by_prio",
      "prio": "alua",
      "hw_handler": "0",
      "no_path_retry": "30",
      "failback": "30"
    },
    {
      "vendor": "HP",
      "product": "HSV110",
      "path_grouping_policy": "group_by_serial",
      "prio": "hp_sw",
      "hw_handler": "0",
      "no_path_retry": "5",
      "failback": "immediate"
    }
  ],
  "defaults_": {
    "user_friendly_names": "yes",
    "max_fds": "2048",
    "queue_without_daemon": "yes",
    "io_timeout": "10",
    "checker_timeout": "15"
  },
  "blacklist_devices": [],
  "blacklist_devnodes": [
    "sd[a-z]",
    "ram",
    "loop",
    "fd"
  ],
  "blacklist_wwids": [],
  "blacklist_exceptions": {
    "devices": [
      "36005076300810c30d800000000000001"
    ],
    "devnodes": [],
    "wwids": []
  },
  "logging": {
    "verbosity": 3,
    "log_file": "/var/log/multipath",
    "log_priority": "info",
    "daemon_log_level": 4
  },
  "watchdog": {
    "timeout": 60,
    "interval": 30
  }
