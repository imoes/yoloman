# ==============================================================================
# slurm-client-emulator configuration file
#
# This template generates the configuration for the slurm-client-emulator package.
# It emulates a Slurm client that communicates with a Slurm controller daemon (slurmctld).
#
# Self-documenting: All variables are derived from the role schema with safe defaults.
# If a variable is not provided by the Ansible host, the schema default is used.
# ==============================================================================

# --------------------------------------------------------------------------
# [slurm_client_emulator]
# Main configuration section for the Slurm client emulator.
# --------------------------------------------------------------------------
[slurm_client_emulator]

# --------------------------------------------------------------------------
# LogDir
# Directory path where slurm-client-emulator stores its log files.
# Default: /var/log/slurm-client-emulator
# --------------------------------------------------------------------------
LogDir = {{ log_dir | default('/var/log/slurm-client-emulator') }}

# --------------------------------------------------------------------------
# DebugMode
# If true, enables verbose debugging output in the emulator logs.
# Default: false
# --------------------------------------------------------------------------
DebugMode = {{ debug_mode | default(false) | lower }}

# --------------------------------------------------------------------------
# SlurmctldHost
# Hostname or IP address of the Slurm controller daemon (slurmctld)
# to emulate interaction with.
# Default: localhost
# --------------------------------------------------------------------------
SlurmctldHost = {{ slurmctld_host | default('localhost') }}

# --------------------------------------------------------------------------
# SlurmctldPort
# TCP port number used to communicate with the Slurm controller daemon.
# Default: 6817
# --------------------------------------------------------------------------
SlurmctldPort = {{ slurmctld_port | default(6817) }}

# --------------------------------------------------------------------------
# ClientUser
# System user account used to run the slurm-client-emulator processes.
# Default: slurm
# --------------------------------------------------------------------------
ClientUser = {{ client_user | default('slurm') }}

# --------------------------------------------------------------------------
# ClientGroup
# System group account associated with the client user.
# Default: slurm
# --------------------------------------------------------------------------
ClientGroup = {{ client_group | default('slurm') }}