{
  "url": {
    "type": "string",
    "default": "https://totp.example.com",
    "description": "URI to fetch"
  },
  "returncode": {
    "type": "string",
    "default": "OK",
    "description": "The remote script/cgi should return a 200 http code and this string as its only results"
  },
  "userfield": {
    "type": "string",
    "default": "user",
    "description": "userfield name to send"
  },
  "passwdfield": {
    "type": "string",
    "default": "token",
    "description": "passwdfield name to send"
  },
  "extradata": {
    "type": "string",
    "default": "&do=login",
    "description": "extra data to send"
  },
  "prompt": {
    "type": "string",
    "default": "Token: ",
    "description": "password prompt"
  },
  "verify_peer": {
    "type": "string",
    "default": "true",
    "description": "Verify peer?"
  },
  "verify_host": {
    "type": "string",
    "default": "true",
    "description": "Make sure peer CN matches?"
  },
  "client_cert": {
    "type": "string",
    "default": "/etc/pki/tls/certs/totpcgi.crt",
    "description": "Client-side certificate"
  },
  "client_key": {
    "type": "string",
    "default": "/etc/pki/tls/private/totpcgi.pem",
    "description": "Client-side key"
  },
  "ca_cert": {
    "type": "string",
    "default": "/etc/pki/tls/certs/ca-bundle.crt",
    "description": "ca cert - defaults to ca-bundle.crt"
  }
}
