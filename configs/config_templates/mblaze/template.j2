# Configuration file for mblaze (mblaze-profile(5))
# This template generates a self-documenting mblaze configuration.
# Each directive is prefixed with a comment explaining its schema field, default value, and purpose.

# The root directory of the Maildir structure where mail folders are stored.
# Schema field: mail_path
# Default: /home/user/Maildir
# Corresponds to the $MAIL environment variable used by mblaze utilities.
Mail: {{ mail_path | default('/home/user/Maildir') }}

# The directory where mblaze stores user state, such as saved sequences and the current message symlink.
# Schema field: mblaze_dir
# Default: /home/user/.mblaze
# Corresponds to $MBLAZE, defaulting to $HOME/.mblaze if not set.
Mblaze: {{ mblaze_dir | default('/home/user/.mblaze') }}

# The text editor command used by mcom to compose messages.
# Schema field: editor
# Default: nano
# Corresponds to the $VISUAL or $EDITOR environment variable.
Editor: {{ editor | default('nano') }}

# The pager command used to display message content in interactive tools like mless.
# Schema field: pager
# Default: less
# Corresponds to the $PAGER environment variable.
Pager: {{ pager | default('less') }}

# The default field to sort messages by in mlist/msort (e.g., date, from, subject, size).
# Schema field: sort_key
# Default: date
# Corresponds to the -k option default in msort/mlintr.
SortKey: {{ sort_key | default('date') }}

# The default sort order direction (asc or desc) for mlist/msort.
# Schema field: sort_dir
# Default: desc
# Corresponds to the -d option default in msort.
SortDir: {{ sort_dir | default('desc') }}

# The external command used to send outgoing messages.
# Schema field: mailer
# Default: msmtp
# Must be compatible with standard mail sending protocols (e.g., msmtp, dma).
# Corresponds to the $MAILER environment variable.
Mailer: {{ mailer | default('msmtp') }}