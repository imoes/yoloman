{
  "debug_log": "",
  "session_cmd": "sway",
  "wayland_sessions_dir": "/usr/share/wayland-sessions",
  "wayland_session_wrapper": "",
  "x11_sessions_dir": "/usr/share/xsessions",
  "x11_session_wrapper": "startx /usr/bin/env",
  "no_x11_session_wrapper": false,
  "prompt_width": 80,
  "show_issue": false,
  "greeting_text": "Welcome to My Linux System",
  "show_time": true,
  "time_format": "%d/%m/%Y %H:%M",
  "enable_user_menu": true,
  "user_menu_min_uid": 1000,
  "user_menu_max_uid": 60000,
  "remember_username": true,
  "remember_session": true,
  "remember_user_session": false,
  "theme_spec": "",
  "show_asterisks": true,
  "asterisks_char": "\u2022",
  "window_padding": 2,
  "container_padding": 4,
  "prompt_padding": 2,
  "greet_align": "center",
  "power_shutdown_cmd": "systemctl poweroff",
  "power_reboot_cmd": "systemctl reboot",
  "power_no_setsid": false,
  "power_keybind": "1",
  "sessions_keybind": "2",
  "command_keybind": "3"
}
