# Set the shared_preload_libraries parameter for the PostgreSQL upgrade process.
# This ensures that the TimescaleDB extension is loaded during the upgrade so that
# extension-specific commands and tables are handled correctly.
# Schema field: timescaledb_shared_preload_libraries
# Default: 'timescaledb'
export PGSETUP_PGUPGRADE_OPTIONS="${PGSETUP_PGUPGRADE_OPTIONS} -O '-c shared_preload_libraries={{ timescaledb_shared_preload_libraries | default('timescaledb') }}'"
