# Defaults for g15daemon initscript

# SWITCH_KEY option was removed. Use DAEMON_OPTS="-s" instead.

# G15DEBUG: Set to 'on' to enable debugging of g15 init.d and udev scripts;
# otherwise leave empty.
# default=''
{{ G15DEBUG | default('') }}

# DAEMON_OPTS: Additional options that are passed to the Daemon.
# This can be used to specify runtime flags like '-s' for a switch key.
# default=''
DAEMON_OPTS="{{ DAEMON_OPTS | default('') }}"