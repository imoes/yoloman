{
  "default_copy_method": {
    "type": "string",
    "default": "scp",
    "description": "Default copy method for data cloning (scp, rdiff, ssh-gz)",
    "enum": [
      "scp",
      "rdiff",
      "ssh-gz"
    ]
  },
  "clone_dirs": {
    "type": "string",
    "default": "data, logs",
    "description": "Comma-separated list of directories to clone"
  },
  "ssh_user": {
    "type": "string",
    "default": "root",
    "description": "SSH user for remote operations"
  },
  "lvm_snapshot_size": {
    "type": "string",
    "default": "1G",
    "description": "Size of the LVM snapshot"
  },
  "lvm_logical_volume": {
    "type": "string",
    "default": "mysql",
    "description": "LVM logical volume name"
  },
  "lvm_volume_group": {
    "type": "string",
    "default": "storage",
    "description": "LVM volume group name"
  },
  "lvm_mount_dir": {
    "type": "string",
    "default": "/mmm_snapshot",
    "description": "Mount directory for LVM snapshots"
  },
  "lvm_mount_opts": {
    "type": "string",
    "default": "-orw,nouuid",
    "description": "Mount options for LVM snapshots"
  },
  "tools_user": {
    "type": "string",
    "default": "mmm_tools",
    "description": "User account for MMM tools"
  },
  "tools_password": {
    "type": "string",
    "default": "RepTools",
    "description": "Password for MMM tools user"
  },
  "backup_dir": {
    "type": "string",
    "default": "/mmm_backup",
    "description": "Directory for storing backups"
  },
  "restore_dir": {
    "type": "string",
    "default": "/mysql",
    "description": "Directory for restoring data"
  }
}
