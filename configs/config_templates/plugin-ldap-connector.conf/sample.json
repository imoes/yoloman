{
  "ldap_server": "ldap.school.local",
  "ldap_port": 636,
  "ldap_use_ssl": true,
  "ldap_bind_dn": "cn=debian-edu-ldap,ou=system,dc=school,dc=local",
  "ldap_bind_password": "secretpassword",
  "ldap_base_dn": "dc=school,dc=local",
  "user_base": "",
  "user_filter": "(objectClass=inetOrgPerson)",
  "user_attributes": [
    "uid",
    "cn",
    "mail",
    "givenName",
    "sn",
    "uidNumber"
  ],
  "group_base": "",
  "group_filter": "(objectClass=posixGroup)",
  "group_attributes": [
    "cn",
    "memberUid"
  ],
  "sync_enabled": true,
  "sync_interval": 1800,
  "group_mappings": [
    {
      "ldap_group": "teachers",
      "local_group": "sudo"
    },
    {
      "ldap_group": "students",
      "local_group": "students"
    },
    {
      "ldap_group": "admins",
      "local_group": "admin"
    }
  ],
  "ldap_ca_cert_path": "/etc/ssl/certs/school-ca.crt"
}
