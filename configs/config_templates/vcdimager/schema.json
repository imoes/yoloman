{
  "vcdimager": {
    "type": "object",
    "default": null,
    "description": "Main configuration object for vcdimager settings"
  },
  "vcdimager.type": {
    "type": "string",
    "default": "vcd2",
    "description": "VideoCD type ('vcd11', 'vcd2', 'svcd' or 'hqvcd')",
    "enum": [
      "vcd11",
      "vcd2",
      "svcd",
      "hqvcd"
    ]
  },
  "vcdimager.cue_file": {
    "type": "string",
    "default": "videocd.cue",
    "description": "Output cue file name"
  },
  "vcdimager.bin_file": {
    "type": "string",
    "default": "videocd.bin",
    "description": "Output bin file name"
  },
  "vcdimager.iso_volume_label": {
    "type": "string",
    "default": "VIDEOCD",
    "description": "ISO volume label"
  },
  "vcdimager.iso_application_id": {
    "type": "string",
    "default": "",
    "description": "ISO application id"
  },
  "vcdimager.info_album_id": {
    "type": "string",
    "default": "",
    "description": "Album id for video cd set"
  },
  "vcdimager.volume_count": {
    "type": "number",
    "default": 1,
    "description": "Number of volumes in album set"
  },
  "vcdimager.volume_number": {
    "type": "number",
    "default": 1,
    "description": "Album set sequence number"
  },
  "vcdimager.broken_svcd_mode": {
    "type": "bool",
    "default": false,
    "description": "Enable non-compliant compatibility mode for broken devices"
  },
  "vcdimager.update_scan_offsets": {
    "type": "bool",
    "default": false,
    "description": "Update scan data offsets in video mpeg2 stream"
  },
  "vcdimager.sector_2336": {
    "type": "bool",
    "default": false,
    "description": "Use 2336 byte sectors for output"
  },
  "vcdimager.create_time": {
    "type": "string",
    "default": null,
    "description": "Creation date on files in CD image"
  },
  "vcdimager.verbose": {
    "type": "bool",
    "default": false,
    "description": "Be verbose"
  },
  "vcdimager.quiet": {
    "type": "bool",
    "default": false,
    "description": "Show only critical messages"
  },
  "vcdimager.add_files": {
    "type": "list",
    "default": [],
    "description": "List of files to add to ISO filesystem with src and iso_name items"
  },
  "vcdimager.add_files.items": {
    "type": "object",
    "default": null,
    "description": "Item definition for add_files list"
  },
  "vcdimager.add_files.items.src": {
    "type": "string",
    "default": "",
    "description": "Source file path"
  },
  "vcdimager.add_files.items.iso_name": {
    "type": "string",
    "default": "",
    "description": "ISO filesystem filename"
  },
  "vcdimager.add_dirs": {
    "type": "list",
    "default": [],
    "description": "List of empty directories to add to ISO filesystem"
  },
  "vcdimager.add_dirs.items": {
    "type": "object",
    "default": null,
    "description": "Item definition for add_dirs list"
  },
  "vcdimager.add_dirs.items.path": {
    "type": "string",
    "default": "",
    "description": "Directory path"
  },
  "vcdimager.tracks": {
    "type": "list",
    "default": [],
    "description": "List of mpeg-tracks to process"
  },
  "vcdimager.tracks.items": {
    "type": "object",
    "default": null,
    "description": "Item definition for tracks list"
  },
  "vcdimager.tracks.items.path": {
    "type": "string",
    "default": "",
    "description": "Path to mpeg track file"
  }
}
