# VCDImager Configuration Template
# Generated by Ansible. Do not edit manually.
# This file contains command-line arguments for vcdimager based on the
# 'vcdimager' inventory variable. Each directive is documented below.

# -------------------------------------------------------
# Main configuration block: vcdimager
# -------------------------------------------------------

# Select VideoCD type ('vcd11', 'vcd2', 'svcd' or 'hqvcd')
# Default: vcd2
--type={{ (vcdimager | default({})).type | default('vcd2') }}

# Specify cue file for output
# Default: videocd.cue
--cue-file={{ (vcdimager | default({})).cue_file | default('videocd.cue') }}

# Specify bin file for output
# Default: videocd.bin
--bin-file={{ (vcdimager | default({})).bin_file | default('videocd.bin') }}

# Specify ISO volume label for video cd
# Default: VIDEOCD
--iso-volume-label={{ (vcdimager | default({})).iso_volume_label | default('VIDEOCD') }}

# Specify ISO application id for video cd
# Default: (empty)
# Note: vcdimager always emits this flag if provided, even if empty.
# To omit entirely, logic would need change. Using default() to ensure render safety.
--iso-application-id={{ (vcdimager | default({})).iso_application_id | default('') }}

# Specify album id for video cd set
# Default: (empty)
--info-album-id={{ (vcdimager | default({})).info_album_id | default('') }}

# Specify number of volumes in album set
# Default: 1
--volume-count={{ (vcdimager | default({})).volume_count | default(1) }}

# Specify album set sequence number (< volume-count)
# Default: 1
--volume-number={{ (vcdimager | default({})).volume_number | default(1) }}

# Enable non-compliant compatibility mode for broken devices
# Default: False
{% if (vcdimager | default({})).broken_svcd_mode | default(False) %}
--broken-svcd-mode
{% endif %}

# Update scan data offsets in video mpeg2 stream
# Default: False
{% if (vcdimager | default({})).update_scan_offsets | default(False) %}
--update-scan-offsets
{% endif %}

# Use 2336 byte sectors for output
# Default: False
{% if (vcdimager | default({})).sector_2336 | default(False) %}
--sector-2336
{% endif %}

# Specify creation date on files in CD image
# Default: (unset)
{% if (vcdimager | default({})).create_time is defined and (vcdimager | default({})).create_time is not none %}
--create-time={{ (vcdimager | default({})).create_time }}
{% endif %}

# Be verbose
# Default: False
{% if (vcdimager | default({})).verbose | default(False) %}
-v
{% endif %}

# Show only critical messages (overrides verbose if both present, though typically mutually exclusive in intent)
# Default: False
{% if (vcdimager | default({})).quiet | default(False) %}
-q
{% endif %}

# List of files to add to ISO filesystem with src and iso_name items
# Default: [] (empty list)
{% for file_entry in (vcdimager | default({})).add_files | default([]) %}
--add-file={{ file_entry.src | default('') }},{{ file_entry.iso_name | default('') }}
{% endfor %}

# List of empty directories to add to ISO filesystem
# Default: [] (empty list)
{% for dir_entry in (vcdimager | default({})).add_dirs | default([]) %}
--add-dir={{ dir_entry.path | default('') }}
{% endfor %}

# List of MPEG tracks to process
# Default: [] (empty list)
{% for track in (vcdimager | default({})).tracks | default([]) %}
{{ track.path | default('') }}
{% endfor %}