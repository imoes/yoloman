{
  "iface": "",
  "outdir": "/var/lib/tcpflow/captures",
  "inputs": [
    "/var/lib/tcpflow/packets.pcap"
  ],
  "bpf_filter": "tcp port 80 or tcp port 443",
  "max_bytes": "",
  "debug_level": 1,
  "max_fds": 0,
  "scanners": [
    "http"
  ],
  "plugin_params": [],
  "filename_format": "",
  "binning": "k",
  "dfxml_report": "/var/lib/tcpflow/report.xml",
  "relinquish_privileges": "tcpflow-user",
  "hex_console": false,
  "strip_nonprintables": true,
  "store_timestamps": false,
  "enable_all": false
}
