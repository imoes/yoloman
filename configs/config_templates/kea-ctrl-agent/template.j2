// Kea Control Agent Configuration
//
// This file configures the Kea Control Agent (CA), which provides a RESTful
// interface to manage Kea DHCP and DDNS servers.
//
// The CA listens for HTTP/HTTPS requests and forwards commands to the
// configured DHCP/DDNS daemons via Unix domain sockets.

{
    // The Kea Control Agent main configuration block
    "Control-agent": {
        // The IP address or hostname where the Kea Control Agent HTTP server listens.
        // Default: 127.0.0.1 (localhost)
        // Set to '0.0.0.0' to listen on all interfaces, but ensure firewall rules
        // and authentication are correctly configured for public exposure.
        "http-host": "{{ http_host | default('127.0.0.1') }}",

        // The TCP port where the Kea Control Agent HTTP server listens.
        // Default: 8000
        // When using HA hook library with multi-threading, ensure this port
        // is distinct from the dedicated HA listener port (e.g., 8001).
        "http-port": {{ http_port | default(8000) }},

        // Authentication configuration for the Control Agent.
        // By default, Kea CA uses Basic HTTP Authentication.
        // For production environments, consider enabling HTTPS (see below)
        // and restricting access to specific clients.
        "authentication": {
            "type": "basic",
            "realm": "Kea Control Agent",
            // Directory where client credentials and certificates are stored.
            "directory": "/etc/kea",
            "clients": [
                {
                    // Username for accessing the Control Agent.
                    "user": "kea-api",
                    // Path to the file containing the password for this user.
                    // Ensure this file has restrictive permissions (e.g., 600)
                    // and is readable only by the user running the Kea CA process.
                    "password-file": "kea-api-password"
                }
            ]
        },

        // Uncomment and configure the following lines to enable HTTPS/TLS.
        // This is recommended for any production deployment to encrypt
        // management traffic.
        //
        // "trust-anchor": "/etc/kea/kea-server-ca.crt",
        // "cert-file": "/etc/kea/kea-server-cert.crt",
        // "key-file": "/etc/kea/kea-server-key.key",
        // "cert-required": true  // Require client certificates for mutual TLS

        // Configuration for sockets used to communicate with Kea backend servers.
        // Kea Control Agent connects to DHCPv4, DHCPv6, and D2 (DDNS) servers
        // using Unix domain sockets by default.
        "control-sockets": {
            // Connection settings for the DHCPv4 server
            "dhcp4": {
                "socket-type": "unix",
                // Path to the Unix socket for DHCPv4 control
                "socket-name": "kea4-ctrl-socket"
            },
            // Connection settings for the DHCPv6 server
            "dhcp6": {
                "socket-type": "unix",
                // Path to the Unix socket for DHCPv6 control
                "socket-name": "kea6-ctrl-socket"
            },
            // Connection settings for the DHCP/DDNS (D2) server
            "d2": {
                "socket-type": "unix",
                // Path to the Unix socket for D2/DDNS control
                "socket-name": "kea-ddns-ctrl-socket"
            }
        },

        // Hooks libraries to load into the Control Agent.
        // These libraries extend CA functionality (e.g., handling custom commands).
        // Leave empty if no hooks are required. Ensure the library path exists
        // and matches the system architecture.
        "hooks-libraries": [
        ],

        // Logging configuration for the Control Agent.
        // Kea uses a hierarchical logger system.
        "loggers": [
            {
                // Logger name for the Control Agent daemon
                "name": "kea-ctrl-agent",
                
                // Output options: where logs are sent.
                // Supported outputs: "stdout", "stderr", "syslog", or a file path.
                "output-options": [
                    {
                        // Default output is standard output (stdout).
                        // Change to a file path (e.g., "/var/log/kea/ctrl-agent.log")
                        // for persistent logging.
                        "output": "stdout",

                        // Pattern for log messages.
                        // %p: Priority, %m: Message, %t: Timestamp, etc.
                        // This pattern is optimized for systemd journal readability.
                        "pattern": "%-5p %m\n"
                        
                        // Optional: Flush logs to disk after every write.
                        // "flush": false
                        
                        // Optional: Max file size before rotation (bytes).
                        // "maxsize": 1048576
                        
                        // Optional: Number of rotated files to keep.
                        // "maxver": 8
                    }
                ],

                // Severity level for logging.
                // Levels: FATAL, ERROR, WARN, INFO, DEBUG, DEBUG<n> (0-99)
                // INFO is suitable for production; DEBUG is for troubleshooting.
                "severity": "INFO",

                // Debug level (0-99). Used only if severity is set to DEBUG.
                // Higher numbers produce more verbose output.
                // 0 is minimal debug info.
                "debuglevel": 0
            }
        ]
    }
}
