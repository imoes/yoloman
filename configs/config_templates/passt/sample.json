{
  "mode": "tap",
  "pidfile": "/run/passt/passt.pid",
  "socket_dir": "/run/passt",
  "log_level": "notice",
  "log_file": "/var/log/passt.log",
  "tap_ifname": "tap0",
  "bridge": "br0",
  "bridge_mac": "",
  "ip6_prefix": "fd00:1234::/64",
  "ip4_prefix": "10.0.0.0/24",
  "ip4_gw": "10.0.0.1",
  "ip6_gw": "fd00:1234::1",
  "dns_server": [
    "1.1.1.1",
    "9.9.9.9"
  ],
  "dns_search": [
    "vm.local"
  ],
  "port_forward": [
    {
      "listen_port": 2222,
      "target": "10.0.0.10",
      "target_port": 22,
      "proto": "tcp"
    },
    {
      "listen_port": 8080,
      "target": "10.0.0.10",
      "target_port": 80,
      "proto": "tcp"
    }
  ],
  "nat": true,
  "nat_table": "nat",
  "user": "nobody",
  "group": "nogroup",
  "no_new_privs": true,
  "cleanup": true
}
