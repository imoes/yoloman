{
  "archive_dir": "/vol/backup/",
  "date_spec": "iso",
  "always_backup": "on",
  "skip": "on",
  "force": "no",
  "overwrite": "on",
  "ssh_proto_path": "/usr/bin/ssh",
  "ssh_proto_options": "-q -oProtocol=2",
  "archive_user": "operator",
  "default_compression": "bzip",
  "compression_level": "6",
  "nobackup_file": ".nobackup",
  "backup_host_name": "elektron",
  "backup_dir": "/home/",
  "backup_exclude": "lost\\+found/, /proc/, /dev/, /sys/",
  "chunk_size": "640m",
  "postrun_script": "/etc/hdup/postrun-warn-user %s",
  "remote_backup_host_name": "www-host",
  "remote_backup_dir": "/var/www",
  "log_to_syslog": "yes",
  "remote_backup_exclude": "/var/.*/docs/",
  "one_filesystem": "no",
  "remote_compression": "gzip",
  "encryption_key": "key2",
  "encryption_algorithm": "tripledes",
  "allow_remote": "no",
  "free_space": "20m",
  "remote_hdup_path": "/mnt/key/src/hdup2",
  "remote_hdup_options": "-c /mnt/key/hdup2.conf"
}
