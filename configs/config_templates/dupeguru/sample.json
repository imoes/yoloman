{
  "scan_mode": "standard",
  "scan_by": "content",
  "match_algorithm": "fuzzy",
  "match_threshold": 80,
  "picture_threshold": 60,
  "file_extensions": [
    "jpg",
    "jpeg",
    "png",
    "mp4",
    "mov"
  ],
  "reference_directories": [
    "/home/user/Pictures/Backup",
    "/mnt/nas/photos"
  ],
  "exclude_directories": [
    "/tmp",
    "/proc",
    "/sys"
  ],
  "move_to_trash": true,
  "export_format": "csv"
}
