{
  "mysql_basedir": "/usr",
  "mysql_dataadir": "/var/lib/mysql",
  "mysql_socket": "/var/run/mysqld/mysqld.sock",
  "mysql_port": 3306,
  "mysql_max_connections": 200,
  "mysql_max_allowed_packet": "64M",
  "mysql_character_set_server": "utf8mb4",
  "mysql_collation_server": "utf8mb4_unicode_ci",
  "mysql_skip_name_resolve": true,
  "mysql_bind_address": "0.0.0.0",
  "mysql_sql_mode": [
    "STRICT_TRANS_TABLES",
    "NO_ZERO_IN_DATE",
    "NO_ZERO_DATE",
    "ERROR_FOR_DIVISION_BY_ZERO",
    "NO_ENGINE_SUBSTITUTION"
  ],
  "mysql_timeout_connect": 10,
  "mysql_timeout_wait": 60,
  "mysql_timeout_read": 30,
  "mysql_timeout_write": 60,
  "mysql_lock_wait_timeout": 50,
  "mysql_innodb_lock_wait_timeout": 50,
  "mysql_interactive_timeout": 28800,
  "mysql_net_read_timeout": 30,
  "mysql_net_write_timeout": 60,
  "mysql_innodb_buffer_pool_size": "1G",
  "mysql_innodb_log_file_size": "256M",
  "mysql_innodb_log_buffer_size": "16M",
  "mysql_log_bin": true,
  "mysql_server_id": 101,
  "mysql_binlog_format": "ROW",
  "mysql_expire_logs_days": 7,
  "mysql_max_binlog_size": "100M",
  "mysql_log_error": "/var/log/mysql/error.log",
  "mysql_slow_query_log": true,
  "mysql_long_query_time": 1.0,
  "mysql_slow_query_log_file": "/var/log/mysql/slow-query.log",
  "mysql_custom_ini": {
    "innodb_file_per_table": "1",
    "innodb_flush_log_at_trx_commit": "1"
  }
}
