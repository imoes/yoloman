# This file configures the "foolsm" monitoring service.
# It defines default values for connection probes and includes local overrides.
#

#
# Debug level: 0 .. 8 are normal, 9 gives lots of stuff
# Setting this higher than 8 is generally for development/troubleshooting.
#
#debug=10
#debug=9
#debug=8

#
# Defaults for the connection entries
# These are set in the code. You may override any values here.
# This block defines the global behavior for probes if not specified per-connection.
#
defaults {
  # Name identifier for this defaults block
  name=defaults

  # IP address used for monitoring (default in code)
  # The service will typically ping or probe this IP.
{% if defaults_checkip is defined and defaults_checkip is not none and (defaults_checkip is number or defaults_checkip is boolean or defaults_checkip | length > 0) %}  checkip={{ defaults_checkip | default('127.0.0.1') }}{% else %}#  checkip=127.0.0.1{% endif %}

  # Path to event script (empty = none)
  # If provided, this script is executed on state changes.
{% if defaults_eventscript is defined and defaults_eventscript is not none and (defaults_eventscript is number or defaults_eventscript is boolean or defaults_eventscript | length > 0) %}  eventscript={{ defaults_eventscript | default('') }}{% else %}#  eventscript={% endif %}

  # Path to notification script
  # Called when alerts are generated.
{% if defaults_notifyscript is defined and defaults_notifyscript is not none and (defaults_notifyscript is number or defaults_notifyscript is boolean or defaults_notifyscript | length > 0) %}  notifyscript={{ defaults_notifyscript | default('/usr/libexec/foolsm/default_script') }}{% else %}#  notifyscript=/usr/libexec/foolsm/default_script{% endif %}

  # Maximum allowed packet loss percentage
  # Alert if loss exceeds this threshold.
{% if defaults_max_packet_loss is defined and defaults_max_packet_loss is not none and (defaults_max_packet_loss is number or defaults_max_packet_loss is boolean or defaults_max_packet_loss | length > 0) %}  max_packet_loss={{ defaults_max_packet_loss | default(15) }}{% else %}#  max_packet_loss=15{% endif %}

  # Maximum successive packets lost before alarm
  # Triggers alert after this many consecutive losses.
{% if defaults_max_successive_pkts_lost is defined and defaults_max_successive_pkts_lost is not none and (defaults_max_successive_pkts_lost is number or defaults_max_successive_pkts_lost is boolean or defaults_max_successive_pkts_lost | length > 0) %}  max_successive_pkts_lost={{ defaults_max_successive_pkts_lost | default(7) }}{% else %}#  max_successive_pkts_lost=7{% endif %}

  # Minimum packet loss percentage to trigger alert
  # Ignores minor fluctuations below this value.
{% if defaults_min_packet_loss is defined and defaults_min_packet_loss is not none and (defaults_min_packet_loss is number or defaults_min_packet_loss is boolean or defaults_min_packet_loss | length > 0) %}  min_packet_loss={{ defaults_min_packet_loss | default(5) }}{% else %}#  min_packet_loss=5{% endif %}

  # Minimum successive packets received before declaring up
  # Requires this many successful responses to mark a connection as 'up'.
{% if defaults_min_successive_pkts_rcvd is defined and defaults_min_successive_pkts_rcvd is not none and (defaults_min_successive_pkts_rcvd is number or defaults_min_successive_pkts_rcvd is boolean or defaults_min_successive_pkts_rcvd | length > 0) %}  min_successive_pkts_rcvd={{ defaults_min_successive_pkts_rcvd | default(10) }}{% else %}#  min_successive_pkts_rcvd=10{% endif %}

  # Interval between probes in milliseconds
  # Controls the frequency of monitoring.
{% if defaults_interval_ms is defined and defaults_interval_ms is not none and (defaults_interval_ms is number or defaults_interval_ms is boolean or defaults_interval_ms | length > 0) %}  interval_ms={{ defaults_interval_ms | default(1000) }}{% else %}#  interval_ms=1000{% endif %}

  # Per-probe timeout in milliseconds
  # If a probe takes longer than this, it is considered failed.
{% if defaults_timeout_ms is defined and defaults_timeout_ms is not none and (defaults_timeout_ms is number or defaults_timeout_ms is boolean or defaults_timeout_ms | length > 0) %}  timeout_ms={{ defaults_timeout_ms | default(1000) }}{% else %}#  timeout_ms=1000{% endif %}

  # Email address for warnings
  # Notifications are sent to this address.
{% if defaults_warn_email is defined and defaults_warn_email is not none and (defaults_warn_email is number or defaults_warn_email is boolean or defaults_warn_email | length > 0) %}  warn_email={{ defaults_warn_email | default('root') }}{% else %}#  warn_email=root{% endif %}

  # Whether to check ARP (0 = no, 1 = yes)
  # 1 enables ARP resolution checks during probing.
{% if defaults_check_arp is defined and defaults_check_arp is not none and (defaults_check_arp is number or defaults_check_arp is boolean or defaults_check_arp | length > 0) %}  check_arp={{ defaults_check_arp | default(0) }}{% else %}#  check_arp=0{% endif %}

  # Source IP for probes (empty = system default)
  # Forces probes to originate from this specific IP address.
{% if defaults_sourceip is defined and defaults_sourceip is not none and (defaults_sourceip is number or defaults_sourceip is boolean or defaults_sourceip | length > 0) %}  sourceip={{ defaults_sourceip | default('') }}{% else %}#  sourceip={% endif %}

  # Network device for probes (if needed)
  # e.g., eth0, ens33. Leave empty for auto-discovery.
{% if defaults_device is defined and defaults_device is not none and (defaults_device is number or defaults_device is boolean or defaults_device | length > 0) %}  device={{ defaults_device | default('eth0') }}{% else %}#  device=eth0{% endif %}

  # TTL for probes (0 = use system default)
  # Sets the Time-To-Live value in probe packets.
{% if defaults_ttl is defined and defaults_ttl is not none and (defaults_ttl is number or defaults_ttl is boolean or defaults_ttl | length > 0) %}  ttl={{ defaults_ttl | default(0) }}{% else %}#  ttl=0{% endif %}

  # Initial status (1 = up, 0 = down, 2 = unknown)
  # Sets the starting state of connections at service launch.
{% if defaults_status is defined and defaults_status is not none and (defaults_status is number or defaults_status is boolean or defaults_status | length > 0) %}  status={{ defaults_status | default(1) }}{% else %}#  status=1{% endif %}

  # How many packets have to go through before a connection is declared up
  # (0 = disabled)
  # Accelerates the 'up' declaration after restarts.
{% if defaults_startup_acceleration is defined and defaults_startup_acceleration is not none and (defaults_startup_acceleration is number or defaults_startup_acceleration is boolean or defaults_startup_acceleration | length > 0) %}  startup_acceleration={{ defaults_startup_acceleration | default(0) }}{% else %}#  startup_acceleration=0{% endif %}

  # Send first 10 packets in a burst (0 = disabled) with interval 200ms
  # Used in conjunction with startup_acceleration for rapid convergence.
{% if defaults_startup_burst_pkts is defined and defaults_startup_burst_pkts is not none and (defaults_startup_burst_pkts is number or defaults_startup_burst_pkts is boolean or defaults_startup_burst_pkts | length > 0) %}  startup_burst_pkts={{ defaults_startup_burst_pkts | default(10) }}{% else %}#  startup_burst_pkts=10{% endif %}

  # Interval between burst packets in ms
  # Time gap between packets in the initial startup burst.
{% if defaults_startup_burst_interval is defined and defaults_startup_burst_interval is not none and (defaults_startup_burst_interval is number or defaults_startup_burst_interval is boolean or defaults_startup_burst_interval | length > 0) %}  startup_burst_interval={{ defaults_startup_burst_interval | default(200) }}{% else %}#  startup_burst_interval=200{% endif %}
}

#
# Some example connections are found in foolsm.conf.sample
# You can include additional configuration files here.
#

-include /etc/foolsm/local*.conf
