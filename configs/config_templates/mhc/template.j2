;;; 50mhc.el --- Debian mhc startup file  -*-mode: emacs-lisp;-*-
;;; Self-documenting Jinja2 template for the 'mhc' (Message Harmonized Calendar) package.
;;; This file is generated by Ansible to configure Emacs autoloading and paths for mhc.

(let* (
       ;; pkg_name: The package name string used in paths and autoloads.
       ;; Default: 'mhc'
       (pkg "{{ pkg_name | default('mhc') }}")

       ;; default_emacs_flavor: The default Emacs flavor name if debian-emacs-flavor is not bound.
       ;; Default: 'emacs'
       (flavor-name (if (boundp 'debian-emacs-flavor)
                        (symbol-name debian-emacs-flavor)
                      "{{ default_emacs_flavor | default('emacs') }}"))

       ;; Computed path: Location of the emacsen-common installation script for this package.
       (pkg-inst (concat "/usr/lib/emacsen-common/packages/install/" pkg))

       ;; Computed path: Directory containing the compiled Lisp files (elc) for this package.
       (elc-dir (concat "/usr/share/" flavor-name "/site-lisp/" pkg)))

  ;; Check if the expected directories/scripts exist before configuring.
  (when (and (file-exists-p elc-dir)
             (file-exists-p pkg-inst))

    ;; Add the package's lisp directory to Emacs load path.
    ;; If 'debian-pkg-add-load-path-item' is available, use it; otherwise, prepend to load-path.
    (if (fboundp 'debian-pkg-add-load-path-item)
        (debian-pkg-add-load-path-item elc-dir)
      (setq load-path (cons elc-dir load-path)))

    ;; Autoload the main mhc command to load the library on first use.
    (autoload 'mhc "mhc" "Message Harmonized Calendar system." t)

    ;; Autoload helper to show the current month's schedule.
    (autoload 'mhc-goto-this-month "mhc" "Show schedules of this month." t)

    ;; Autoload helper to import a schedule from the current message/article.
    (autoload 'mhc-import "mhc" "Import a schedule from the current article." t)

    ;; Set the default path for mhc icons.
    (setq mhc-icon-path "/usr/share/pixmaps/mhc")
    ))

;;; 50mhc.el ends here