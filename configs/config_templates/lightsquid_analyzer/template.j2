# lightsquid.cfg — Main configuration for Lightsquid log analyzer
# Base directory for Lightsquid installation
BaseDir = {{ base_dir }}

# Directory where Squid access.log files are stored
LogDir = {{ log_dir }}

# Directory for generated reports and cache files
ReportDir = {{ report_dir }}

# URL prefix for web interface (e.g., '/lightsquid' or 'http://localhost/lightsquid')
BaseUrl = {{ base_url }}

# Language file prefix (e.g., 'lang' — no path, just filename prefix)
LangFile = {{ lang_file }}

# Enable/disable graph generation (1 = yes, 0 = no)
GraphEnable = {{ graph_enable }}

# Enable/disable real-time log monitoring (1 = yes, 0 = no)
RealTimeEnable = {{ real_time_enable }}

# Maximum number of days to retain in reports (0 = unlimited)
MaxDay = {{ max_day }}

# Minimum number of hits per entry to appear in report (0 = no minimum)
MinHit = {{ min_hit }}

# Time zone offset in hours (e.g., +2 for Europe/Berlin without DST, -5 for EST)
TimeOffset = {{ time_offset }}

# Date format used in reports (strftime format string)
DateTemplate = {{ date_template }}

# Time format used in reports (strftime format string)
TimeTemplate = {{ time_template }}

# Enable/disable HTML title in reports (1 = yes, 0 = no)
TitleEnable = {{ title_enable }}

# HTML title for generated reports
TitleName = {{ title_name }}

# Enable/disable top users table (1 = yes, 0 = no)
UserGraphEnable = {{ user_graph_enable }}

# Enable/disable top sites table (1 = yes, 0 = no)
SiteGraphEnable = {{ site_graph_enable }}

# Enable/disable top URLs table (1 = yes, 0 = no)
UrlGraphEnable = {{ url_graph_enable }}

# Enable/disable top days table (1 = yes, 0 = no)
DayGraphEnable = {{ day_graph_enable }}

# Enable/disable top hours table (1 = yes, 0 = no)
HourGraphEnable = {{ hour_graph_enable }}

# Enable/disable top hours per user table (1 = yes, 0 = no)
UserHourGraphEnable = {{ user_hour_graph_enable }}

# Enable/disable top bytes table (1 = yes, 0 = no)
ByteGraphEnable = {{ byte_graph_enable }}

# Enable/disable top bytes per user table (1 = yes, 0 = no)
UserByteGraphEnable = {{ user_byte_graph_enable }}

# Enable/disable top MIME types table (1 = yes, 0 = no)
MimeGraphEnable = {{ mime_graph_enable }}

# Enable/disable top HTTP codes table (1 = yes, 0 = no)
CodeGraphEnable = {{ code_graph_enable }}

# List of users to exclude from reports (space-separated list)
{% for user in excluded_users %}# Excluded user: {{ user }}
{% endfor %}
ExcludedUser = {{ excluded_users | join(' ') }}

# List of IPs to exclude from reports (CIDR or IP; space-separated)
{% for ip in excluded_ips %}# Excluded IP: {{ ip }}
{% endfor %}
ExcludedIP = {{ excluded_ips | join(' ') }}

# List of hosts to exclude (exact match or regex, space-separated)
{% for host in excluded_hosts %}# Excluded host: {{ host }}
{% endfor %}
ExcludedHost = {{ excluded_hosts | join(' ') }}

# Enable/disable detailed log parsing (1 = yes, 0 = no)
# If enabled, parses extended log fields (e.g., RFC 3134 transparent proxy logs)
DetailLogEnable = {{ detail_log_enable }}

# Log format: 'squid' (standard), 'transparent', or 'custom'
LogFormat = {{ log_format }}

# Custom log format string (for LogFormat = custom)
# Fields: %timestamp %client %method %url %size %rcode %user %ident %hier %type
CustomLogFormat = {{ custom_log_format }}

# Path to Squid log file (if single log file used)
LogPath = {{ log_path }}

# Enable/disable gzip log compression detection (1 = yes, 0 = no)
GzipEnable = {{ gzip_enable }}

# Path to perl binary (used for parser scripts)
PerlPath = {{ perl_path }}

# Enable/disable CGI mode (for web frontend usage; 1 = yes, 0 = no)
CGIEnable = {{ cgi_enable }}

# Enable/disable auth by HTTP Basic (1 = yes, 0 = no)
AuthEnable = {{ auth_enable }}

# List of allowed admin users (space-separated)
{% for user in admin_users %}# Admin user: {{ user }}
{% endfor %}
AdminUser = {{ admin_users | join(' ') }}

# Password file for admin authentication (if AuthEnable = 1)
AuthFile = {{ auth_file }}

# Enable/disable HTML cache (1 = yes, 0 = no)
CacheEnable = {{ cache_enable }}

# Cache directory for pre-rendered reports
CacheDir = {{ cache_dir }}

# Cache TTL in minutes
CacheTTL = {{ cache_ttl }}

# Enable/disable auto-report generation after log rotation (1 = yes, 0 = no)
AutoReportEnable = {{ auto_report_enable }}

# Interval in minutes for auto-report generation (if AutoReportEnable = 1)
AutoReportInterval = {{ auto_report_interval }}
