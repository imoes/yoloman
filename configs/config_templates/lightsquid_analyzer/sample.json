{
  "base_dir": "/usr/local/lightsquid",
  "log_dir": "/var/log/squid",
  "report_dir": "/var/www/lightsquid/report",
  "base_url": "/lightsquid",
  "lang_file": "lang",
  "graph_enable": true,
  "real_time_enable": false,
  "max_day": 30,
  "min_hit": 5,
  "time_offset": 1,
  "date_template": "%d/%m/%Y",
  "time_template": "%H:%M",
  "title_enable": true,
  "title_name": "Squid Proxy Usage Report",
  "user_graph_enable": true,
  "site_graph_enable": true,
  "url_graph_enable": false,
  "day_graph_enable": true,
  "hour_graph_enable": true,
  "user_hour_graph_enable": false,
  "byte_graph_enable": true,
  "user_byte_graph_enable": false,
  "mime_graph_enable": true,
  "code_graph_enable": true,
  "excluded_users": [
    "squid",
    "proxyadmin"
  ],
  "excluded_ips": [
    "127.0.0.1",
    "192.168.0.0/24"
  ],
  "excluded_hosts": [
    "localhost",
    "\\.internal\\.example\\.com$"
  ],
  "detail_log_enable": true,
  "log_format": "transparent",
  "custom_log_format": "%timestamp %client %method %url %size %rcode %user %ident %hier %type",
  "log_path": "/var/log/squid/access.log",
  "gzip_enable": true,
  "perl_path": "/usr/bin/perl",
  "cgi_enable": true,
  "auth_enable": true,
  "admin_users": [
    "admin",
    "analyst"
  ],
  "auth_file": "/etc/lightsquid/htpasswd",
  "cache_enable": true,
  "cache_dir": "/var/www/lightsquid/cache",
  "cache_ttl": 60,
  "auto_report_enable": true,
  "auto_report_interval": 10
}
