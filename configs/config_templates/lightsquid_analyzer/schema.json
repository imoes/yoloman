{
  "base_dir": {
    "type": "string",
    "default": "/usr/local/lightsquid",
    "description": "Base installation directory of Lightsquid"
  },
  "log_dir": {
    "type": "string",
    "default": "/var/log/squid",
    "description": "Directory containing Squid access.log files"
  },
  "report_dir": {
    "type": "string",
    "default": "/var/www/lightsquid/report",
    "description": "Directory to store generated HTML reports and cache"
  },
  "base_url": {
    "type": "string",
    "default": "/lightsquid",
    "description": "Web URL prefix where Lightsquid web interface is served"
  },
  "lang_file": {
    "type": "string",
    "default": "lang",
    "description": "Language file prefix (e.g., 'lang.en' \u2192 'lang' + '.en')"
  },
  "graph_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable generation of graphical charts in reports"
  },
  "real_time_enable": {
    "type": "boolean",
    "default": false,
    "description": "Enable real-time log monitoring (live updates)"
  },
  "max_day": {
    "type": "number",
    "default": 30,
    "description": "Maximum number of days of logs to include in reports (0 = unlimited)"
  },
  "min_hit": {
    "type": "number",
    "default": 10,
    "description": "Minimum number of requests for an entry to appear in top lists"
  },
  "time_offset": {
    "type": "number",
    "default": 0,
    "description": "Time zone offset in hours (e.g., +1 for CET, -5 for EST)"
  },
  "date_template": {
    "type": "string",
    "default": "%d/%m/%Y",
    "description": "Date format in reports (strftime format)"
  },
  "time_template": {
    "type": "string",
    "default": "%H:%M",
    "description": "Time format in reports (strftime format)"
  },
  "title_enable": {
    "type": "boolean",
    "default": true,
    "description": "Show site title in report headers"
  },
  "title_name": {
    "type": "string",
    "default": "Squid Usage Report",
    "description": "Custom HTML title for generated reports"
  },
  "user_graph_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable top users chart/table"
  },
  "site_graph_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable top sites (domains) chart/table"
  },
  "url_graph_enable": {
    "type": "boolean",
    "default": false,
    "description": "Enable top URLs chart/table"
  },
  "day_graph_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable daily traffic chart/table"
  },
  "hour_graph_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable hourly traffic chart/table"
  },
  "user_hour_graph_enable": {
    "type": "boolean",
    "default": false,
    "description": "Enable hourly per-user chart/table"
  },
  "byte_graph_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable top bytes transferred chart/table"
  },
  "user_byte_graph_enable": {
    "type": "boolean",
    "default": false,
    "description": "Enable top bytes per user chart/table"
  },
  "mime_graph_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable top MIME types chart/table"
  },
  "code_graph_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable top HTTP response codes chart/table"
  },
  "excluded_users": {
    "type": "list",
    "default": [],
    "description": "List of Squid usernames to exclude from reports (e.g., 'proxyadmin')",
    "items": {
      "type": "string",
      "description": "Username to exclude"
    }
  },
  "excluded_ips": {
    "type": "list",
    "default": [],
    "description": "List of IPs or CIDR ranges to exclude from reports",
    "items": {
      "type": "string",
      "description": "IP or CIDR range (e.g., '192.168.1.0/24')"
    }
  },
  "excluded_hosts": {
    "type": "list",
    "default": [],
    "description": "List of hosts (exact or regex) to exclude",
    "items": {
      "type": "string",
      "description": "Host pattern (e.g., 'localhost' or '\\.internal\\.com$')"
    }
  },
  "detail_log_enable": {
    "type": "boolean",
    "default": false,
    "description": "Enable parsing of extended Squid log fields (e.g., transparent proxy mode)"
  },
  "log_format": {
    "type": "string",
    "default": "squid",
    "description": "Log format type: 'squid' (standard), 'transparent', or 'custom'"
  },
  "custom_log_format": {
    "type": "string",
    "default": "%timestamp %client %method %url %size %rcode %user %ident %hier %type",
    "description": "Custom log format specifiers (used if log_format = custom)"
  },
  "log_path": {
    "type": "string",
    "default": "/var/log/squid/access.log",
    "description": "Single log file path (used if logs not in log_dir)"
  },
  "gzip_enable": {
    "type": "boolean",
    "default": true,
    "description": "Automatically detect and decompress .gz logs"
  },
  "perl_path": {
    "type": "string",
    "default": "/usr/bin/perl",
    "description": "Path to Perl interpreter (required for parser scripts)"
  },
  "cgi_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable CGI mode for web frontend"
  },
  "auth_enable": {
    "type": "boolean",
    "default": false,
    "description": "Enable HTTP Basic authentication for admin access"
  },
  "admin_users": {
    "type": "list",
    "default": [
      "admin"
    ],
    "description": "List of usernames allowed to log in as admin",
    "items": {
      "type": "string",
      "description": "Admin username"
    }
  },
  "auth_file": {
    "type": "string",
    "default": "/etc/lightsquid/htpasswd",
    "description": "Password file (HtPasswd format) for admin auth"
  },
  "cache_enable": {
    "type": "boolean",
    "default": true,
    "description": "Enable HTML report caching for performance"
  },
  "cache_dir": {
    "type": "string",
    "default": "/var/www/lightsquid/cache",
    "description": "Directory for cached reports"
  },
  "cache_ttl": {
    "type": "number",
    "default": 30,
    "description": "Cache TTL in minutes"
  },
  "auto_report_enable": {
    "type": "boolean",
    "default": true,
    "description": "Auto-generate reports after log rotation"
  },
  "auto_report_interval": {
    "type": "number",
    "default": 15,
    "description": "Minutes between auto-report runs (if enabled)"
  }
}
