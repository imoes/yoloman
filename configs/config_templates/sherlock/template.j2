# Sherlock Configuration
#
# This template configures the `sherlock` tool, a username and social network
# account checker. It uses a key-value format (INI-like).
#
# All variables use | default() to ensure the rendered configuration is
# complete and valid, even if optional variables are not provided by Ansible.
#

# Time in seconds to wait for response to requests.
timeout = {{ timeout | default(60) }}

# Proxy URL (e.g. socks5://127.0.0.1:1080).
proxy_url = {{ proxy_url | default('') | string }}

# Make requests over Tor.
use_tor = {{ use_tor | default(false) }}

# Make requests over Tor with new Tor circuit after each request.
use_unique_tor = {{ use_unique_tor | default(false) }}

# Folder to save output if using multiple usernames.
folder_output = {{ folder_output | default('.') | string }}

# File to save output if using single username.
output_file = {{ output_file | default('') | string }}

# Create Comma-Separated Values (CSV) File.
output_csv = {{ output_csv | default(false) }}

# Create Excel spreadsheet (xlsx).
output_xlsx = {{ output_xlsx | default(false) }}

# List of site names to limit analysis to. If empty, check all sites.
# Joined with commas as expected by the application.
sites = {{ sites | default([]) | join(',') | string }}

# Force the use of the local data.json file.
local_only = {{ local_only | default(false) }}

# Output sites where the username was not found.
print_all = {{ print_all | default(false) }}

# Output sites where the username was found.
print_found = {{ print_found | default(false) }}

# Don't color terminal output.
no_color = {{ no_color | default(false) }}

# Browse to all results on default browser.
browse = {{ browse | default(false) }}

# Display extra debugging information and metrics.
verbose = {{ verbose | default(false) }}

# One or more usernames to check with social networks.
# Joined with spaces as expected by the application.
usernames = {{ usernames | default([]) | join(' ') | string }}