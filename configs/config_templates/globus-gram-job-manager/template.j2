# Globus Toolkit GRAM Job Manager Configuration
# Auto-generated by Ansible Jinja2 Template
#
# This configuration file controls the behavior of the Globus Toolkit
# Grid Resource and Access Management (GRAM) Job Manager.
# It defines the Toolkit version, logging paths, and audit storage.

# Globus Toolkit version string
# Specifies the version of the Globus Toolkit components to initialize.
-globus-toolkit-version {{ globus_toolkit_version | default('6.2') }}

# Log file path pattern; supports $(LOGNAME) substitution
# Determines where the GRAM job manager logs are written.
# The $(LOGNAME) placeholder is typically expanded to the username of the submitting user.
-log-pattern {{ log_pattern | default('/var/log/globus/gram_$(LOGNAME).log') }}

# Directory for storing GLOBUS Gram job audit logs
# Path to the directory where long-term audit trails for job submissions are kept.
-audit-directory {{ audit_directory | default('/var/lib/globus/gram-audit') }}