# Configuration file for salt-pepper
# Generated by Jinja2 template

[salt-pepper]

# The base URL of the salt-api instance. Defaults to https://localhost:8080. Corresponds to -u/--saltapi-url.
url = {{ salt_pepper_url | default('https://localhost:8080') }}

# Wait time in seconds before returning control to the shell. Corresponds to --timeout.
timeout = {{ salt_pepper_timeout | default(10) }}

# File location for caching authentication tokens. Defaults to ~/.peppercache. Corresponds to -x.
cache = {{ salt_pepper_cache | default('~/.peppercache') }}

# Set to 'yes' or 'true' to ignore SSL certificate errors. Corresponds to --ignore-ssl-errors.
ignore_ssl_errors = {{ salt_pepper_ignore_ssl_errors | default('no') }}

# Set to 'yes' or 'true' to enable verbose output. Corresponds to -v.
verbose = {{ salt_pepper_verbose | default('no') }}