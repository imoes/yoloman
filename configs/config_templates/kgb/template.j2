#!/bin/bash
# Wrapper script for kgb archiver.
# This template generates a wrapper script to invoke `kgb` with the specified default options.
# The kgb command-line tool is stateless and does not have a persistent configuration file.

# Compression level for kgb archiver. Valid values: 0 (fastest, 2MB) to 9 (best compression, 1616MB).
# Default is 3 (18MB).
# Man page: -<m> Set compression level (memory usage)
KGBCOMPRESS_LEVEL={{ compression_level | default(3) }}

# The filename for the resulting KGB archive. Must not exist before execution.
# Man page: archive.kgb Filename of the new KGB archive
KGBOUTPUT_FILE="{{ output_file | default('archive.kgb') }}"

# List of files or file listing references to be compressed.
# File listing references should start with @.
# Man page: [filename ...] or [@files_listing @...]
{% if (input_files | default([])) | length > 0 %}
KGBCONSOLE_INPUT_FILES={{ input_files | default([]) | join(' ') }}
{% else %}
KGBCONSOLE_INPUT_FILES=""
{% endif %}

# Execute kgb with configured defaults
# -{{ compression_level | default(3) }} is the compression flag
# "{{ output_file | default('archive.kgb') }}" is the target archive
# {{ (input_files | default([])) | join(' ') }} are the sources
exec kgb -{{ compression_level | default(3) }} "{{ output_file | default('archive.kgb') }}" {{ (input_files | default([])) | join(' ') }}