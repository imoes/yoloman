# Configuration file for the color grep utility
# This file controls the default colorization behavior of GNU grep.

# 'none' shuts colorization off.
# Valid values: 'auto', 'always', 'never'
# Default: auto
{% if grep_color_default is defined and grep_color_default is not none and (grep_color_default is number or grep_color_default is boolean or grep_color_default | length > 0) %}COLOR {{ grep_color_default | default('auto') }}{% else %}#COLOR none{% endif %}
