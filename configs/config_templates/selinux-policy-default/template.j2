# SELinux file contexts for Debian default policy
# This file defines the security context mapping for filesystem paths.
# Each line: <path_spec> <context>
# <path_spec> may include wildcards: * (any chars), [] (character classes), etc.
# <context> has format: user:role:type:level (mls) or user:role:type (non-mls)

{% for rule in file_contexts %}
# {{ rule.comment if rule.comment else 'Context for ' + rule.path_spec }}
{{ rule.path_spec }} {{ rule.context }}
{% endfor %}