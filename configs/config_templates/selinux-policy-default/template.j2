#
# Multi-Category Security translation table for SELinux
#
# This file defines how SELinux maps internal MLS (Multi-Level Security)
# category labels to human-readable descriptions. It is consumed by the
# SELinux policy libraries to present meaningful labels to administrators.
#
# Format: one entry per line: <mls_label>=<human_readable_label>
#
# Example entries:
# s0:c0=CompanyConfidential
# s0:c1=PatientRecord
# s0:c2=Unclassified
# s0:c3=TopSecret
# s0:c1,c3=CompanyConfidentialRedHat
#

{% for translation in mls_translations | default(['s0=SystemLow', 's0-s0:c0.c1023=SystemLow-SystemHigh', 's0:c0.c1023=SystemHigh']) %}
{{ translation }}
{% endfor %}