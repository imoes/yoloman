{
  "file_contexts": [
    {
      "path_spec": "/",
      "context": "system_u:object_r:file_t:s0",
      "comment": "Root directory"
    },
    {
      "path_spec": "/etc(/.*)?",
      "context": "system_u:object_r:etc_t:s0",
      "comment": "Standard configuration files"
    },
    {
      "path_spec": "/etc/passwd",
      "context": "system_u:object_r:passwd_file_t:s0",
      "comment": "System password file"
    },
    {
      "path_spec": "/home/[^/]+(/.*)?",
      "context": "user_u:object_r:user_home_dir_t:s0",
      "comment": "User home directories"
    },
    {
      "path_spec": "/var/www(/.*)?",
      "context": "system_u:object_r:httpd_sys_content_t:s0",
      "comment": "Web content directories"
    },
    {
      "path_spec": "/srv/[^/]+(/.*)?",
      "context": "system_u:object_r:public_content_t:s0",
      "comment": "Service data directories"
    },
    {
      "path_spec": "/dev/.*",
      "context": "system_u:object_r:device_t:s0",
      "comment": "Device nodes"
    },
    {
      "path_spec": "/tmp(/.*)?",
      "context": "system_u:object_r:tmp_t:s0",
      "comment": "Temporary files"
    }
  ]
}
