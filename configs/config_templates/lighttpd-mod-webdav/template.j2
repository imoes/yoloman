## WebDAV stands for Web-based Distributed Authoring and Versioning.
## The term also refers to the set of extensions to the HTTP protocol that
## the group defined which allows users to collaboratively edit and manage
## files on remote web servers.
##
# /usr/share/doc/lighttpd/webdav.txt
# http://trac.lighttpd.net/trac/wiki/Docs%3AModWebDAV

# Enable the WebDAV module in Lighttpd.
# This is a prerequisite for configuring WebDAV properties and locks.
server.modules += ( "mod_webdav" )

## The full path to the SQLite database file used for WebDAV properties and locks.
## This setting is required by mod_webdav to store DAV props and lock state.
## Default: /var/cache/lighttpd/lighttpd.webdav.db
## Note: /var/cache/lighttpd/ is persistent across reboots, but it is recommended
## to use a location such as /var/db/lighttpd/ if the data is important.
webdav.sqlite-db-name = "{{ webdav_sqlite_db_name | default('/var/cache/lighttpd/lighttpd.webdav.db') }}"