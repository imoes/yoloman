<?php

#
# /etc/ganglia/conf.php
#
# Self-documenting configuration template for Ganglia Web Frontend.
# This file overrides default settings found in /usr/share/ganglia/conf_default.php.
# All variables are populated from the Ansible role's schema with safe defaults.
#

?>
<?php

# ==============================================================================
# Global / Meta Configuration
# ==============================================================================

#
# [meta_name]
# Description: The name of the cluster to display.
# Schema Default: 'default'
#
$conf['meta_name'] = '{{ ganglia_web_meta_name | default("default") }}';


#
# [webdir]
# Description: The web server directory where Ganglia files are installed.
# This is used for internal path resolution within the web app.
# Schema Default: '/usr/share/ganglia'
#
$conf['webdir'] = '{{ ganglia_web_webdir | default("/usr/share/ganglia") }}';


#
# [url_prefix]
# Description: The URL prefix under which Ganglia is served.
# If Ganglia is installed at http://localhost/ganglia/, this should be '/ganglia'.
# Schema Default: ''
#
$conf['url_prefix'] = '{{ ganglia_web_url_prefix | default("") }}';


#
# [enable_auth]
# Description: Enable authentication for the web interface.
# Schema Default: false
#
$conf['enable_auth'] = {{ ganglia_web_enable_auth | default(false) | lower }};


#
# [auth_type]
# Description: The type of authentication to use (e.g., 'basic', 'form').
# Only used if enable_auth is true.
# Schema Default: 'basic'
#
$conf['auth_type'] = '{{ ganglia_web_auth_type | default("basic") }}';


#
# [auth_realm]
# Description: The authentication realm displayed in the login prompt.
# Schema Default: 'Ganglia Authentication'
#
$conf['auth_realm'] = '{{ ganglia_web_auth_realm | default("Ganglia Authentication") }}';


#
# [username]
# Description: The username to use if not using a standard auth file.
# Schema Default: 'admin'
#
$conf['username'] = '{{ ganglia_web_username | default("admin") }}';


#
# [password]
# Description: The password hash or plain text password (depending on auth_type).
# Note: For basic auth with files, this might not be used directly here if htpasswd is used.
# Schema Default: 'changeme'
#
$conf['password'] = '{{ ganglia_web_password | default("changeme") }}';


# ==============================================================================
# Gmond / Gmetad Connectivity Configuration
# ==============================================================================

#
# [gmetad_root]
# Description: The root directory for the data source definitions.
# Typically points to the directory where xml files are generated by gmetad.
# Schema Default: '/var/lib/ganglia'
#
$conf['gmetad_root'] = '{{ ganglia_web_gmetad_root | default("/var/lib/ganglia") }}';


#
# [dsroot]
# Description: The directory containing the XML data sources for gmond.
# Schema Default: '/var/lib/ganglia/ds'
#
$conf['dsroot'] = '{{ ganglia_web_dsroot | default("/var/lib/ganglia/ds") }}';


#
# [gridname]
# Description: The name of the grid (cluster) this web front end belongs to.
# Schema Default: 'default'
#
$conf['gridname'] = '{{ ganglia_web_gridname | default("default") }}';


#
# [ds_names]
# Description: An array of data source names (XML files) to include.
# If empty, includes all available XML files in dsroot.
# Schema Default: []
#
$conf['ds_names'] = {{ ganglia_web_ds_names | default([]) | tojson }};


#
# [xml_port]
# Description: The port on which gmond sends XML data.
# Schema Default: 8649
#
$conf['xml_port'] = {{ ganglia_web_xml_port | default(8649) }};


#
# [xml_hostname]
# Description: The hostname of the gmetad server providing XML data.
# Used if the web server is separated from the data collection backend.
# Schema Default: 'localhost'
#
$conf['xml_hostname'] = '{{ ganglia_web_xml_hostname | default("localhost") }}';


# ==============================================================================
# Visualization and Display Settings
# ==============================================================================

#
# [num_columns]
# Description: The number of columns in the cluster view grid.
# Schema Default: 4
#
$conf['num_columns'] = {{ ganglia_web_num_columns | default(4) }};


#
# [num_rows]
# Description: The number of rows in the cluster view grid.
# Schema Default: 5
#
$conf['num_rows'] = {{ ganglia_web_num_rows | default(5) }};


#
# [time_range]
# Description: The default time range for graphs (in seconds).
# Common values: 300 (5min), 900 (15min), 3600 (1hr).
# Schema Default: 3600
#
$conf['time_range'] = {{ ganglia_web_time_range | default(3600) }};


#
# [refresh_rate]
# Description: The rate in seconds at which the web page auto-refreshes.
# Set to 0 to disable auto-refresh.
# Schema Default: 60
#
$conf['refresh_rate'] = {{ ganglia_web_refresh_rate | default(60) }};


#
# [graph_font_path]
# Description: Path to a TrueType font file for graph labels.
# If empty, uses the default system font.
# Schema Default: ''
#
$conf['graph_font_path'] = '{{ ganglia_web_graph_font_path | default("") }}';


#
# [graph_theme]
# Description: The color theme to use for graphs.
# Options: 'default', 'old', 'white', 'black', 'gray', etc.
# Schema Default: 'default'
#
$conf['graph_theme'] = '{{ ganglia_web_graph_theme | default("default") }}';


# ==============================================================================
# Advanced / Performance Settings
# ==============================================================================

#
# [cache_dir]
# Description: Directory for caching generated images/data.
# Schema Default: '/var/cache/ganglia-web'
#
$conf['cache_dir'] = '{{ ganglia_web_cache_dir | default("/var/cache/ganglia-web") }}';


#
# [max_data_age]
# Description: Maximum age (in seconds) of data before it is considered stale.
# Schema Default: 86400
#
$conf['max_data_age'] = {{ ganglia_web_max_data_age | default(86400) }};


#
# [sort_type]
# Description: Default sort type for cluster host lists ('name', 'metric').
# Schema Default: 'name'
#
$conf['sort_type'] = '{{ ganglia_web_sort_type | default("name") }}';


#
# [default_metric]
# Description: The default metric displayed on the cluster summary page.
# Schema Default: 'load_one'
#
$conf['default_metric'] = '{{ ganglia_web_default_metric | default("load_one") }}';


#
# [enable_graphs]
# Description: Enable/disable graph generation.
# Schema Default: true
#
$conf['enable_graphs'] = {{ ganglia_web_enable_graphs | default(true) | lower }};


#
# [enable_cluster_view]
# Description: Enable/disable the cluster overview grid view.
# Schema Default: true
#
$conf['enable_cluster_view'] = {{ ganglia_web_enable_cluster_view | default(true) | lower }};


#
# [enable_host_view]
# Description: Enable/disable the individual host detail view.
# Schema Default: true
#
$conf['enable_host_view'] = {{ ganglia_web_enable_host_view | default(true) | lower }};


#
# [enable_metric_view]
# Description: Enable/disable the metric history view.
# Schema Default: true
#
$conf['enable_metric_view'] = {{ ganglia_web_enable_metric_view | default(true) | lower }};


#
# [enable_user_management]
# Description: Enable user management features (if backed by an external auth source).
# Schema Default: false
#
$conf['enable_user_management'] = {{ ganglia_web_enable_user_management | default(false) | lower }};


#
# [ldap_server]
# Description: LDAP server URI for authentication if enabled.
# Schema Default: 'ldap://localhost'
#
$conf['ldap_server'] = '{{ ganglia_web_ldap_server | default("ldap://localhost") }}';


#
# [ldap_base_dn]
# Description: LDAP Base DN for searching users.
# Schema Default: 'dc=example,dc=com'
#
$conf['ldap_base_dn'] = '{{ ganglia_web_ldap_base_dn | default("dc=example,dc=com") }}';


#
# [ldap_bind_dn]
# Description: DN for binding to the LDAP server.
# Schema Default: ''
#
$conf['ldap_bind_dn'] = '{{ ganglia_web_ldap_bind_dn | default("") }}';


#
# [ldap_bind_password]
# Description: Password for binding to the LDAP server.
# Schema Default: ''
#
$conf['ldap_bind_password'] = '{{ ganglia_web_ldap_bind_password | default("") }}';


#
# [ldap_user_attribute]
# Description: LDAP attribute used for the username.
# Schema Default: 'uid'
#
$conf['ldap_user_attribute'] = '{{ ganglia_web_ldap_user_attribute | default("uid") }}';


#
# [ldap_search_filter]
# Description: LDAP search filter for users.
# Schema Default: ''
#
$conf['ldap_search_filter'] = '{{ ganglia_web_ldap_search_filter | default("") }}';


# ==============================================================================
# Logging and Debugging
# ==============================================================================

#
# [log_level]
# Description: Logging level (0=off, 1=error, 2=warn, 3=info, 4=debug).
# Schema Default: 0
#
$conf['log_level'] = {{ ganglia_web_log_level | default(0) }};


#
# [log_file]
# Description: Path to the log file for Ganglia web frontend.
# Schema Default: '/var/log/ganglia-web.log'
#
$conf['log_file'] = '{{ ganglia_web_log_file | default("/var/log/ganglia-web.log") }}';


#
# [debug]
# Description: Enable debug mode (disables caching, increases log verbosity).
# Schema Default: false
#
$conf['debug'] = {{ ganglia_web_debug | default(false) | lower }};

?>
