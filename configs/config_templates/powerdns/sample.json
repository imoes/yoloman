{
  "local_address": "0.0.0.0",
  "local_port": 53,
  "allow_axfr_ips": [
    "192.168.1.10",
    "10.0.0.5"
  ],
  "enable_axfr": true,
  "tcp_outgoing_socket": 0,
  "disable_dnssec": true,
  "disable_dns64": true,
  "backends": [
    {
      "name": "gsqlite3",
      "connection_string": "/var/lib/powerdns/pdns.sqlite3"
    }
  ],
  "default_soa_name": "ns1.example.com",
  "default_soa_mail": "hostmaster.example.com",
  "default_soa_serial": 2025040101,
  "default_soa_refresh": 10800,
  "default_soa_retry": 3600,
  "default_soa_expire": 604800,
  "default_soa_ttl": 604800,
  "chroot_dir": "",
  "setuid_user": "pdns",
  "setgid_group": "pdns",
  "log_level": "6",
  "log_dns_queries": false,
  "log_dns_outgoing": false,
  "max_udp_packet_size": 4096,
  "worker_threads": 4,
  "max_cache_entries": 1000000,
  "max_cache_ttl": 86400,
  "api_enabled": true,
  "api_key": "secret-key-abc123xyz",
  "api_readonly": false,
  "api_logfile": "/var/log/pdns-api.log",
  "include_dir": "/etc/powerdns/conf.d"
}
