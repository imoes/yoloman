[general]
# Path to the directory where signing keys and metadata are stored
data_dir = {{ data_dir | default('/var/lib/debusine-signing') }}

# Logging verbosity: debug, info, warn, error, critical
log_level = {{ log_level | default('info') | lower }}

# Maximum number of concurrent signing requests to handle
max_concurrent_signing_requests = {{ max_concurrent_signing_requests | default(10) | int }}

[api]
# Network address the API server binds to
api_bind_address = {{ api_bind_address | default('127.0.0.1') }}

# Port the API server listens on
api_port = {{ api_port | default(8080) | int }}

# Timeout for API requests, in seconds
api_timeout_seconds = {{ api_timeout_seconds | default(30) | int }}

# CORS allowed origins (list of URIs)
# Renders as a comma-separated string if api_allowed_origins is a list.
api_allowed_origins = {{ (api_allowed_origins | default([])) | join(', ') }}