{
  "service_name": "keystone",
  "keystone_uwsgi_port": 5000,
  "debug": false,
  "log_format": "%(asctime)s %(levelname)s %(name)s [%(process)d:%(threadName)s] %(message)s",
  "log_file": "",
  "database": "",
  "database.connection": "mysql+pymysql://keystone:password@localhost/keystone",
  "database.max_retries": 10,
  "database.retry_interval": 10,
  "database.pool_size": 10,
  "database.pool_recycle": 600,
  "database.pool_timeout": 30,
  "token": "",
  "token.provider": "fernet",
  "token.total_expiration": 3600,
  "token.fernet_max_active_keys": 3,
  "token.key_repository": "/etc/keystone/fernet-keys/",
  "token.uuid_cache_time": 600,
  "fernet_tokens": "",
  "fernet_tokens.key_repository": "/etc/keystone/fernet-keys/",
  "revoke": "",
  "revoke.driver": "sql",
  "revoke.expiration": 60,
  "cache": "",
  "cache.backend": "keystone.cache.memcached",
  "cache.memcache_servers": []
}
