[DEFAULT]
# The name of the service (used for logging and notifications)
{% if service_name %}name = {{ service_name }}{% endif %}

# Logging configuration
# Debug mode (enabled by default in dev, typically disabled in prod)
{% if debug is defined %}debug = {{ debug | lower }}{% endif %}

# Default log format
{% if log_format %}log_format = {{ log_format }}{% endif %}

# Log file path (empty string means log to stderr)
{% if log_file %}log_file = {{ log_file }}{% endif %}

[database]
# Database connection string
connection = {{ database.connection }}

# Maximum number of database connections in the pool
max_retries = {{ database.max_retries }}

# Idle timeout (in seconds) for database connections
retry_interval = {{ database.retry_interval }}

# Connection pool size
pool_size = {{ database.pool_size }}

# Connection pool recycle interval (in seconds)
pool_recycle = {{ database.pool_recycle }}

# Connection pool timeout (in seconds)
pool_timeout = {{ database.pool_timeout }}

[token]
# Token provider: Fernet, PKI, PKIZ, or UUID
provider = {{ token.provider }}

# Token expiration time (in seconds)
total_expiration = {{ token.total_expiration }}

# Number of Fernet keys to rotate (used only with Fernet provider)
{% if token.provider == 'fernet' %}fernet_max_active_keys = {{ token.fernet_max_active_keys }}{% endif %}

# Fernet key directory (used only with Fernet provider)
{% if token.provider == 'fernet' %}key_repository = {{ token.key_repository }}{% endif %}

# UUID token cache time-to-live (seconds)
{% if token.provider == 'uuid' %}cache_time = {{ token.uuid_cache_time }}{% endif %}

[fernet_tokens]
# Fernet token key directory (deprecated; use [token].key_repository)
{% if fernet_tokens.key_repository is defined %}key_repository = {{ fernet_tokens.key_repository }}{% endif %}

[revoke]
# Revoke driver: SQL (default), Kafka, or custom
{% if revoke.driver %}driver = {{ revoke.driver }}{% endif %}

# Revocation event expiration (in seconds)
{% if revoke.expiration %}expiration = {{ revoke.expiration }}{% endif %}

[cache]
# Cache backend (e.g., keystone.cache.memcached, keystone.cache.sql)
{% if cache.backend %}backend = {{ cache.backend }}{% endif %}

# Memcached servers list (comma-separated)
{% if cache.memcache_servers %}memcache_servers = {{ cache.memcache_servers }}{% endif %}

# Cache TTL (in seconds)
{% if cache.expiration_time %}expiration_time = {{ cache.expiration_time }}{% endif %}

[assignment]
# Default domain ID for projects and users (if no domain is specified)
{% if assignment.default_domain_id %}default_domain_id = {{ assignment.default_domain_id }}{% endif %}

[auth]
# List of auth methods to support
methods = {{ auth.methods | join(', ') }}

{% for method in auth.methods %}# Configuration for {{ method }} auth plugin
[{{ method }}]
# Plugin name (e.g., password, token, oauth1, etc.)
{% if auth.plugins.get(method) %}{% set plugin = auth.plugins[method] %}{% if plugin.enabled is defined %}enabled = {{ plugin.enabled | lower }}{% endif %}
# Plugin class path (e.g., keystone.auth.plugins.password.Password)
{% if plugin.method %}method = {{ plugin.method }}{% endif %}
{% endif %}
{% endfor %}

[endpoint_filter]
# Enable endpoint filter by project (for multi-region deployments)
{% if endpoint_filter.enabled is defined %}enabled = {{ endpoint_filter.enabled | lower }}{% endif %}

[endpoint_policy]
# Enable endpoint policy (deprecated; use endpoint_filter)
{% if endpoint_policy.enabled is defined %}enabled = {{ endpoint_policy.enabled | lower }}{% endif %}

[identity]
# Driver for identity backend (e.g., sql, ldap)
driver = {{ identity.driver }}

# Domain-specific config directories (for domain-specific backends)
{% if identity.domain_config_dir %}domain_config_dir = {{ identity.domain_config_dir }}{% endif %}

{% if identity.extra_attributes %}# Additional attributes to return in user/project responses
extra_attributes = {{ identity.extra_attributes | join(', ') }}{% endif %}

[ldap]
# LDAP URL (e.g., ldap://ldap.example.com)
url = {{ ldap.url }}

# LDAP user and password (bind DN and credential)
user = {{ ldap.user }}
password = {{ ldap.password }}

# LDAP suffix for users and groups
suffix = {{ ldap.suffix }}

# User filter
user_filter = {{ ldap.user_filter }}

# User object class
user_objectclass = {{ ldap.user_objectclass }}

# User ID attribute
user_id_attribute = {{ ldap.user_id_attribute }}

# User name attribute
user_name_attribute = {{ ldap.user_name_attribute }}

# User enabled attribute
user_enabled_attribute = {{ ldap.user_enabled_attribute }}

# User enabled mask (if applicable)
user_enabled_mask = {{ ldap.user_enabled_mask }}

# User default project ID attribute
user_default_project_id_attribute = {{ ldap.user_default_project_id_attribute }}

# Group filter
group_filter = {{ ldap.group_filter }}

# Group object class
group_objectclass = {{ ldap.group_objectclass }}

# Group ID attribute
group_id_attribute = {{ ldap.group_id_attribute }}

# Group name attribute
group_name_attribute = {{ ldap.group_name_attribute }}

# Group member attribute
group_member_attribute = {{ ldap.group_member_attribute }}

# Group description attribute
group_description_attribute = {{ ldap.group_description_attribute }}

# Use pool for LDAP connections
use_pool = {{ ldap.use_pool }}

# LDAP connection pool size
pool_size = {{ ldap.pool_size }}

# LDAP connection pool timeout (in seconds)
pool_timeout = {{ ldap.pool_timeout }}

# LDAP connection pool retry interval (in seconds)
pool_retry_max = {{ ldap.pool_retry_max }}

# LDAP connection pool retry delay (in seconds)
pool_connection_retry_interval = {{ ldap.pool_connection_retry_interval }}

{% if ldap.use_tls %}[ldap_tls]
# Enable start_tls
start_tls = {{ ldap.use_tls }}

# CA cert bundle path
ca_cert = {{ ldap.ca_cert }}

# Client cert and key (optional)
client_cert = {{ ldap.client_cert }}
client_key = {{ ldap.client_key }}

# TLS cipher suite (optional)
tls_ciphers = {{ ldap.tls_ciphers }}
{% endif %}

[oslo_middleware]
# Maximum request body size (in bytes)
max_request_body_size = {{ oslo_middleware.max_request_body_size }}

# Enable CORS
{% if oslo_middleware.enable_cors is defined %}enable_cors = {{ oslo_middleware.enable_cors | lower }}{% endif %}

{% if oslo_middleware.cors_origins %}# Allowed CORS origins (comma-separated)
cors_origins = {{ oslo_middleware.cors_origins | join(', ') }}{% endif %}

{% if oslo_middleware.cors_headers %}# Allowed CORS headers
cors_headers = {{ oslo_middleware.cors_headers | join(', ') }}{% endif %}

{% if oslo_middleware.cors_expose_headers %}# Exposed CORS headers
cors_expose_headers = {{ oslo_middleware.cors_expose_headers | join(', ') }}{% endif %}

[oslo_policy]
# Policy file path
policy_file = {{ oslo_policy.policy_file }}

# Policy default rule
{% if oslo_policy.policy_default_rule %}policy_default_rule = {{ oslo_policy.policy_default_rule }}{% endif %}

{% if oslo_policy.enforce_scope is defined %}# Enforce scope-based policy rules
enforce_scope = {{ oslo_policy.enforce_scope | lower }}{% endif %}

{% if oslo_policy.enforce_new_defaults is defined %}# Enforce new default policy rules
enforce_new_defaults = {{ oslo_policy.enforce_new_defaults | lower }}{% endif %}

[signing]
# Token signing directory (for PKI/PKIZ providers)
{% if signing.token_dir %}token_dir = {{ signing.token_dir }}{% endif %}

# Certificate authority cert path
{% if signing.ca_cert %}ca_certs = {{ signing.ca_cert }}{% endif %}

# Signing certificate key path
{% if signing.certkey %}certfile = {{ signing.certfile }}
keyfile = {{ signing.certkey }}{% endif %}

[security_compliance]
# Enable password complexity checks
{% if security_compliance.password_length is defined %}password_length = {{ security_compliance.password_length }}{% endif %}

{% if security_compliance.password_minimum_age is defined %}password_minimum_age = {{ security_compliance.password_minimum_age }}{% endif %}

{% if security_compliance.password_minimum_character_classes is defined %}password_minimum_character_classes = {{ security_compliance.password_minimum_character_classes }}{% endif %}

{% if security_compliance.password_regex is defined %}password_regex = {{ security_compliance.password_regex }}{% endif %}

{% if security_compliance.password_regex_description is defined %}password_regex_description = {{ security_compliance.password_regex_description }}{% endif %}

{% if security_compliance.password_history_count is defined %}password_history_count = {{ security_compliance.password_history_count }}{% endif %}

{% if security_compliance.lockout_failure_attempts is defined %}lockout_failure_attempts = {{ security_compliance.lockout_failure_attempts }}{% endif %}

{% if security_compliance.lockout_duration is defined %}lockout_duration = {{ security_compliance.lockout_duration }}{% endif %}

[oslo_concurrency]
# Lock path for process coordination
lock_path = {{ oslo_concurrency.lock_path }}

[oslo_messaging_notifications]
# Notification driver (e.g., messaging, messagingv2, log)
{% if oslo_messaging_notifications.driver %}driver = {{ oslo_messaging_notifications.driver }}{% endif %}

{% if oslo_messaging_notifications.transport_url %}# Messaging transport URL
transport_url = {{ oslo_messaging_notifications.transport_url }}{% endif %}

# Notification topics
{% if oslo_messaging_notifications.topics %}topics = {{ oslo_messaging_notifications.topics | join(', ') }}{% endif %}

# Retry policy
{% if oslo_messaging_notifications.retry %}retry = {{ oslo_messaging_notifications.retry | lower }}{% endif %}
