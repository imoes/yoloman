{
  "server_serial_device": "/dev/ttyS1",
  "server_baud_rate": 19200,
  "server_flow_control": true,
  "server_lock_device": true,
  "server_socket_path": "/var/sympathy/ttyS1",
  "server_history_lines": 200,
  "server_log_file": "/var/sympathy/ttyS1.log",
  "server_rotate_logs": true,
  "server_log_syslog": false,
  "server_pid_file": "/var/run/sympathy/ttyS1.pid",
  "terminal_width": 80,
  "terminal_height": 24,
  "terminal_unicode": false,
  "display_html_dump": false
}
