{
  "mesh_interface": {
    "type": "string",
    "default": "bat0",
    "description": "Name of the batman-adv mesh interface (e.g., bat0)"
  },
  "routing_algo": {
    "type": "string",
    "default": "BATMAN_IV",
    "description": "Routing algorithm: BATMAN_IV or BATMAN_V"
  },
  "aggregation": {
    "type": "bool",
    "default": false,
    "description": "Enable/disable OGM aggregation (0/1)"
  },
  "ap_isolation": {
    "type": "bool",
    "default": false,
    "description": "Enable/disable AP isolation on mesh interface (0/1)"
  },
  "ap_isolation_by_vlan": {
    "type": "list",
    "default": [],
    "description": "Per-VLAN AP isolation settings; items define vid and ap_isolation (bool)"
  },
  "bonding": {
    "type": "bool",
    "default": false,
    "description": "Enable/disable bonding mode (0/1)"
  },
  "bridge_loop_avoidance": {
    "type": "bool",
    "default": false,
    "description": "Enable/disable bridge loop avoidance (0/1); requires compile-time support"
  },
  "distributed_arp_table": {
    "type": "bool",
    "default": false,
    "description": "Enable/disable distributed ARP table (0/1)"
  },
  "fragmentation": {
    "type": "bool",
    "default": false,
    "description": "Enable/disable fragmentation (0/1)"
  },
  "gateway_mode": {
    "type": "string",
    "default": "off",
    "description": "Gateway mode: 'off', 'client', or 'server'",
    "enum": [
      "off",
      "client",
      "server"
    ]
  },
  "gateway_param": {
    "type": "string",
    "default": "off",
    "description": "For gateway_mode='client': selection class (e.g., '20'); for 'server': bandwidth (e.g., '10000', '5mbit/2mbit')",
    "enum": [
      "off",
      "client",
      "server"
    ]
  },
  "hop_penalty": {
    "type": "number",
    "default": 0,
    "description": "Hop penalty (0-255)"
  },
  "isolation_mark": {
    "type": "string",
    "default": "",
    "description": "Isolation mark in format 'value[/mask]' (e.g., '0x00000001/0xffffffff' or '16')"
  },
  "loglevel": {
    "type": "list",
    "default": [],
    "description": "List of log levels (e.g., ['batman', 'routes', 'tt', 'bla', 'dat'])"
  },
  "multicast_fanout": {
    "type": "number",
    "default": 0,
    "description": "Maximum number of multicast-to-unicast copies (integer)"
  },
  "multicast_forceflood": {
    "type": "bool",
    "default": false,
    "description": "Enable/disable multicast force-flood (0/1)"
  },
  "network_coding": {
    "type": "bool",
    "default": false,
    "description": "Enable/disable network coding (0/1)"
  },
  "orig_interval": {
    "type": "number",
    "default": 1000,
    "description": "Originator interval in milliseconds"
  },
  "elp_interval": {
    "type": "number",
    "default": 0,
    "description": "ELP interval in milliseconds for mesh interface (0 leaves it default)"
  },
  "hardif_settings": {
    "type": "list",
    "default": [],
    "description": "Hard interface settings: hop_penalty per interface; each item has 'hardif' and 'hop_penalty'"
  },
  "hardif_throughput": {
    "type": "list",
    "default": [],
    "description": "Hard interface throughput overrides: throughput_override per interface"
  },
  "hardif_elp_interval": {
    "type": "list",
    "default": [],
    "description": "Hard interface ELP intervals: elp_interval per interface"
  }
}
