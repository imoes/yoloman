[Desktop Entry]
# Type of this desktop entry (must be Application for system services/indicators)
Type=Application

# Human-readable name of the indicator
Name=Ayatana Indicator Accessibility

# Path to the executable that implements the accessibility indicator service.
# This binary runs in the background and provides accessibility controls.
Exec={{ exec_path | default('/usr/libexec/ayatana-indicator-a11y/ayatana-indicator-a11y-service') }}

# Semicolon-separated list of desktop environments where this indicator is valid/shown.
# The indicator will only appear on systems identified with one of these desktop sessions.
OnlyShowIn={{ only_show_in | default('Unity;MATE;XFCE;') }}

# Do not show this entry in menus or application launchers (it is a background service)
NoDisplay=true

# Disable startup notification dialogs (this is a system daemon, not a user-initiated app)
StartupNotify=false

# Do not open a terminal window for this entry
Terminal=false
