# Ayatana Indicator Accessibility Desktop Entry Configuration
# This file defines a desktop entry for the accessibility indicator service.
# It specifies the executable path and the desktop environments in which the indicator is visible.

[Desktop Entry]
# Standard desktop entry type for an application
Type=Application

# Display name for the desktop entry
Name=Ayatana Indicator Accessibility

# Path to the ayatana-indicator-a11y service executable.
# Default: /usr/libexec/ayatana-indicator-a11y/ayatana-indicator-a11y-service
Exec={{ exec_path | default('/usr/libexec/ayatana-indicator-a11y/ayatana-indicator-a11y-service') }}

# Semicolon-separated list of desktop environments where this indicator should appear.
# Default: Unity;MATE;XFCE;
OnlyShowIn={{ only_show_in | default('Unity;MATE;XFCE;') }}

# Do not display this entry in standard application menus
NoDisplay=true

# Do not show a startup notification dialog
StartupNotify=false

# Do not open a terminal window
Terminal=false