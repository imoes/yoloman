{
  "sssd_domains": [
    "example.com",
    "internal.example.com"
  ],
  "sssd_debug_level": 0,
  "sssd_default_domain_suffix": "example.com",
  "sssd_reconnection_retries": 3,
  "sssd_services": [
    "nss",
    "pam"
  ],
  "domains": [
    {
      "name": "example.com",
      "ipa_servers": [
        "idm1.example.com",
        "idm2.example.com"
      ],
      "fallback_homedir": "/home/%u",
      "cache_credentials": true,
      "ipa_dyndns_update": false,
      "ldap_search_base": "cn=accounts,dc=example,dc=com",
      "enumerate": true
    },
    {
      "name": "internal.example.com",
      "ipa_servers": [
        "idm-int.example.com"
      ],
      "fallback_homedir": "/home/%u",
      "cache_credentials": false,
      "ipa_dyndns_update": true,
      "ldap_search_base": "cn=accounts,dc=internal,dc=example,dc=com",
      "allow_groups": [
        "developers",
        "admins"
      ],
      "enumerate": false
    }
  ]
}
