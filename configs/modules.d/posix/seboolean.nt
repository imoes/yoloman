name: seboolean
fqcn: posix.seboolean
collection: posix
short_description: Toggles SELinux booleans
description: Toggles SELinux booleans.
options:
    ignore_selinux_state:
        type: bool
        default: false
        description: Useful for scenarios (chrooted environment) that you can't get the real SELinux state.
    name:
        type: str
        required: true
        description: Name of the boolean to configure.
    persistent:
        type: bool
        default: false
        description: Set to C(true) if the boolean setting should survive a reboot.
    state:
        type: bool
        required: true
        description: Desired boolean value
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Set httpd_can_network_connect flag on and keep it persistent across reboots
    >   posix.seboolean:
    >     name: httpd_can_network_connect
    >     state: true
    >     persistent: true
    >
