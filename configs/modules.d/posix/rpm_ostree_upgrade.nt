name: rpm_ostree_upgrade
fqcn: posix.rpm_ostree_upgrade
collection: posix
short_description: Manage rpm-ostree upgrade transactions
description: Manage an rpm-ostree upgrade transactions.
options:
    allow_downgrade:
        type: bool
        default: false
        description: Allow for the upgrade to be a chronologically older tree.
    cache_only:
        type: bool
        default: false
        description: Perform the transaction using only pre-cached data, do not download.
    os:
        type: str
        default:
        description: The OSNAME upon which to operate.
    peer:
        type: bool
        default: false
        description: Force peer-to-peer connection instead of using a system message bus.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Upgrade the rpm-ostree image without options, accept all defaults
    >   posix.rpm_ostree_upgrade:
    >
    > - name: Upgrade the rpm-ostree image allowing downgrades
    >   posix.rpm_ostree_upgrade:
    >     allow_downgrade: true
    >
