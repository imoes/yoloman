name: selinux
fqcn: posix.selinux
collection: posix
short_description: Change policy and state of SELinux
description: Configures the SELinux mode and policy. A reboot may be required after usage. Ansible will not issue this reboot but will let you know when it is required.
options:
    configfile:
        type: str
        default: /etc/selinux/config
        aliases:
            - conf
            - file
        description: The path to the SELinux configuration file, if non-standard.
    policy:
        type: str
        description: The name of the SELinux policy to use (e.g. C(targeted)) will be required if I(state) is not C(disabled).
    state:
        type: str
        required: true
        choices:
            - disabled
            - enforcing
            - permissive
        description: The SELinux mode.
    update_kernel_param:
        type: bool
        default: false
        description: If set to I(true), will update also the kernel boot parameters when disabling/enabling SELinux. The C(grubby) tool must be present on the target system for this to work.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Enable SELinux
    >   posix.selinux:
    >     policy: targeted
    >     state: enforcing
    >
    > - name: Put SELinux in permissive mode, logging actions that would be blocked.
    >   posix.selinux:
    >     policy: targeted
    >     state: permissive
    >
    > - name: Disable SELinux
    >   posix.selinux:
    >     state: disabled
    >
