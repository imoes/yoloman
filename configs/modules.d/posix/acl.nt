name: acl
fqcn: posix.acl
collection: posix
short_description: Set and retrieve file ACL information.
description: Set and retrieve file ACL information.
options:
    default:
        type: bool
        default: false
        description: If the target is a directory, setting this to C(true) will make it the default ACL for entities created inside the directory. Setting C(default) to C(true) causes an error if the path is a file.
    entity:
        type: str
        default:
        description: The actual user or group that the ACL applies to when matching entity types user or group are selected.
    entry:
        type: str
        description: DEPRECATED. The ACL to set or remove. This must always be quoted in the form of C(<etype>:<qualifier>:<perms>). The qualifier may be empty for some types, but the type and perms are always required. C(-) can be used as placeholder when you do not care about permissions. This is now superseded by entity, type and permissions fields.
    etype:
        type: str
        choices:
            - group
            - mask
            - other
            - user
        description: The entity type of the ACL to apply, see C(setfacl) documentation for more info.
    follow:
        type: bool
        default: true
        description: Whether to follow symlinks on the path if a symlink is encountered.
    path:
        type: path
        required: true
        aliases:
            - name
        description: The full path of the file or object.
    permissions:
        type: str
        description: The permissions to apply/remove can be any combination of C(r), C(w), C(x) (read, write and execute respectively), and C(X) (execute permission if the file is a directory or already has execute permission for some user)
    recalculate_mask:
        type: str
        default: default
        choices:
            - default
            - mask
            - no_mask
        description: Select if and when to recalculate the effective right masks of the files. See C(setfacl) documentation for more info. Incompatible with C(state=query).
    recursive:
        type: bool
        default: false
        aliases:
            - recurse
        description: Recursively sets the specified ACL. Incompatible with C(state=query). Alias C(recurse) added in version 1.3.0.
    state:
        type: str
        default: query
        choices:
            - absent
            - present
            - query
        description: Define whether the ACL should be present or not. The C(query) state gets the current ACL without changing it, for use in C(register) operations.
    use_nfsv4_acls:
        type: bool
        default: false
        description: Use NFSv4 ACLs instead of POSIX ACLs.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Grant user Joe read access to a file
    >   posix.acl:
    >     path: /etc/foo.conf
    >     entity: joe
    >     etype: user
    >     permissions: r
    >     state: present
    >
    > - name: Removes the ACL for Joe on a specific file
    >   posix.acl:
    >     path: /etc/foo.conf
    >     entity: joe
    >     etype: user
    >     state: absent
    >
    > - name: Sets default ACL for joe on /etc/foo.d/
    >   posix.acl:
    >     path: /etc/foo.d/
    >     entity: joe
    >     etype: user
    >     permissions: rw
    >     default: true
    >     state: present
    >
    > - name: Same as previous but using entry shorthand
    >   posix.acl:
    >     path: /etc/foo.d/
    >     entry: default:user:joe:rw-
    >     state: present
    >
    > - name: Obtain the ACL for a specific file
    >   posix.acl:
    >     path: /etc/foo.conf
    >   register: acl_info
    >
