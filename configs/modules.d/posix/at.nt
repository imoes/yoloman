name: at
fqcn: posix.at
collection: posix
short_description: Schedule the execution of a command or script file via the at command
description: Use this module to schedule a command or script file to run once in the future. All jobs are executed in the 'a' queue.
options:
    command:
        type: str
        description: A command to be executed in the future.
    count:
        type: int
        description: The count of units in the future to execute the command or script file.
    script_file:
        type: str
        description: An existing script file to be executed in the future.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: The state dictates if the command or script file should be evaluated as present(added) or absent(deleted).
    unique:
        type: bool
        default: false
        description: If a matching job is present a new job will not be added.
    units:
        type: str
        choices:
            - minutes
            - hours
            - days
            - weeks
        description: The type of units in the future to execute the command or script file.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Schedule a command to execute in 20 minutes as root
    >   posix.at:
    >     command: ls -d / >/dev/null
    >     count: 20
    >     units: minutes
    >
    > - name: Match a command to an existing job and delete the job
    >   posix.at:
    >     command: ls -d / >/dev/null
    >     state: absent
    >
    > - name: Schedule a command to execute in 20 minutes making sure it is unique in the queue
    >   posix.at:
    >     command: ls -d / >/dev/null
    >     count: 20
    >     units: minutes
    >     unique: true
    >
