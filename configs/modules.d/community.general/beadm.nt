name: beadm
fqcn: community.general.beadm
collection: community.general
short_description: Manage ZFS boot environments on FreeBSD/Solaris/illumos systems
description: Create, delete or activate ZFS boot environments. Mount and unmount ZFS boot environments.
options:
    description:
        type: str
        description: Associate a description with a new boot environment. This option is available only on Solarish platforms.
    force:
        type: bool
        default: false
        description: Specifies if the unmount should be forced.
    mountpoint:
        type: path
        description: Path where to mount the ZFS boot environment.
    name:
        type: str
        required: true
        aliases:
            - be
        description: ZFS boot environment name.
    options:
        type: str
        description: Create the datasets for new BE with specific ZFS properties. Multiple options can be specified. This option is available only on Solarish platforms.
    snapshot:
        type: str
        description: If specified, the new boot environment will be cloned from the given snapshot or inactive boot environment.
    state:
        type: str
        default: present
        choices:
            - absent
            - activated
            - mounted
            - present
            - unmounted
        description: Create or delete ZFS boot environment.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create ZFS boot environment
    >   community.general.beadm:
    >     name: upgrade-be
    >     state: present
    >
    > - name: Create ZFS boot environment from existing inactive boot environment
    >   community.general.beadm:
    >     name: upgrade-be
    >     snapshot: be@old
    >     state: present
    >
    > - name: Create ZFS boot environment with compression enabled and description "upgrade"
    >   community.general.beadm:
    >     name: upgrade-be
    >     options: "compression=on"
    >     description: upgrade
    >     state: present
    >
    > - name: Delete ZFS boot environment
    >   community.general.beadm:
    >     name: old-be
    >     state: absent
    >
    > - name: Mount ZFS boot environment on /tmp/be
    >   community.general.beadm:
    >     name: BE
    >     mountpoint: /tmp/be
    >     state: mounted
    >
    > - name: Unmount ZFS boot environment
    >   community.general.beadm:
    >     name: BE
    >     state: unmounted
    >
    > - name: Activate ZFS boot environment
    >   community.general.beadm:
    >     name: upgrade-be
    >     state: activated
    >
