name: keycloak_component_info
fqcn: community.general.keycloak_component_info
collection: community.general
short_description: Retrive component info in Keycloak
description: This module retrive information on component from Keycloak.
options:
    auth_client_id:
        type: str
        default: admin-cli
        description: OpenID Connect C(client_id) to authenticate to the API with.
    auth_client_secret:
        type: str
        description: Client Secret to use in conjunction with O(auth_client_id) (if required).
    auth_keycloak_url:
        type: str
        required: true
        aliases:
            - url
        description: URL to the Keycloak instance.
    auth_password:
        type: str
        aliases:
            - password
        description: Password to authenticate for API access with.
    auth_realm:
        type: str
        description: Keycloak realm name to authenticate to for API access.
    auth_username:
        type: str
        aliases:
            - username
        description: Username to authenticate for API access with.
    connection_timeout:
        type: int
        default: 10
        description: Controls the HTTP connections timeout period (in seconds) to Keycloak API.
    http_agent:
        type: str
        default: Ansible
        description: Configures the HTTP User-Agent header.
    name:
        type: str
        description: Name of the Component.
    parent_id:
        type: str
        description: Container ID of the components.
    provider_type:
        type: str
        description: Provider type of components. Example: V(org.keycloak.storage.UserStorageProvider), V(org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy), V(org.keycloak.keys.KeyProvider), V(org.keycloak.userprofile.UserProfileProvider), V(org.keycloak.storage.ldap.mappers.LDAPStorageMapper).
    realm:
        type: str
        required: true
        description: The name of the realm.
    token:
        type: str
        description: Authentication token for Keycloak API.
    validate_certs:
        type: bool
        default: true
        description: Verify TLS certificates (do not disable this in production).
writes: false
runtime: starlark
source: translated
examples:
    >
    >     - name: Retrive info of a UserStorageProvider named myldap
    >       community.general.keycloak_component_info:
    >         auth_keycloak_url: http://localhost:8080/auth
    >         auth_sername: admin
    >         auth_password: password
    >         auth_realm: master
    >         realm: myrealm
    >         name: myldap
    >         provider_type: org.keycloak.storage.UserStorageProvider
    >
    >     - name: Retrive key info component
    >       community.general.keycloak_component_info:
    >         auth_keycloak_url: http://localhost:8080/auth
    >         auth_sername: admin
    >         auth_password: password
    >         auth_realm: master
    >         realm: myrealm
    >         name: rsa-enc-generated
    >         provider_type: org.keycloak.keys.KeyProvider
    >
    >     - name: Retrive all component from realm master
    >       community.general.keycloak_component_info:
    >         auth_keycloak_url: http://localhost:8080/auth
    >         auth_sername: admin
    >         auth_password: password
    >         auth_realm: master
    >         realm: myrealm
    >
    >     - name: Retrive all sub components of parent component filter by type
    >       community.general.keycloak_component_info:
    >         auth_keycloak_url: http://localhost:8080/auth
    >         auth_sername: admin
    >         auth_password: password
    >         auth_realm: master
    >         realm: myrealm
    >         parent_id: "075ef2fa-19fc-4a6d-bf4c-249f57365fd2"
    >         provider_type: "org.keycloak.storage.ldap.mappers.LDAPStorageMapper"
    >
    >
    >
