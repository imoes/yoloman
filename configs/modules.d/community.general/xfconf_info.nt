name: xfconf_info
fqcn: community.general.xfconf_info
collection: community.general
short_description: Retrieve XFCE4 configurations
description: This module allows retrieving Xfce 4 configurations with the help of C(xfconf-query).
options:
    channel:
        type: str
        description:
            > A Xfconf preference channel is a top-level tree key, inside of the Xfconf repository that corresponds to the location for which all application properties/keys are stored.
            >  If not provided, the module will list all available channels.
    property:
        type: str
        description:
            > A Xfce preference key is an element in the Xfconf repository that corresponds to an application preference.
            >  If provided, then O(channel) is required. If not provided and a O(channel) is provided, then the module will list all available properties in that O(channel).
writes: false
runtime: starlark
source: translated
examples:
    >
    > - name: Get list of all available channels
    >   community.general.xfconf_info: {}
    >   register: result
    >
    > - name: Get list of all properties in a specific channel
    >   community.general.xfconf_info:
    >     channel: xsettings
    >   register: result
    >
    > - name: Retrieve the DPI value
    >   community.general.xfconf_info:
    >     channel: xsettings
    >     property: /Xft/DPI
    >   register: result
    >
    > - name: Get workspace names (4)
    >   community.general.xfconf_info:
    >     channel: xfwm4
    >     property: /general/workspace_names
    >   register: result
    >
