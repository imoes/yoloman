name: locale_gen
fqcn: community.general.locale_gen
collection: community.general
short_description: Creates or removes locales
description: Manages locales by editing /etc/locale.gen and invoking locale-gen.
options:
    name:
        type: str
        required: true
        description: Name and encoding of the locale, such as "en_GB.UTF-8".
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: Whether the locale shall be present.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Ensure a locale exists
    >   community.general.locale_gen:
    >     name: de_CH.UTF-8
    >     state: present
    >
