name: gitlab_protected_branch
fqcn: community.general.gitlab_protected_branch
collection: community.general
short_description: Manage protection of existing branches
description: (un)Marking existing branches for protection.
options:
    api_job_token:
        type: str
        description: GitLab CI job token for logging in.
    api_oauth_token:
        type: str
        description: GitLab OAuth token for logging in.
    api_password:
        type: str
        description: The password to use for authentication against the API.
    api_token:
        type: str
        description: GitLab access token with API permissions.
    api_url:
        type: str
        description: The resolvable endpoint for the API.
    api_username:
        type: str
        description: The username to use for authentication against the API.
    ca_path:
        type: str
        description: The CA certificates bundle to use to verify GitLab server certificate.
    merge_access_levels:
        type: str
        default: maintainer
        choices:
            - maintainer
            - developer
            - nobody
        description: Access levels allowed to merge.
    name:
        type: str
        required: true
        description: The name of the branch that needs to be protected. Can make use a wildcard character for like V(production/*) or just have V(main) or V(develop) as value.
    project:
        type: str
        required: true
        description: The path and name of the project.
    push_access_level:
        type: str
        default: maintainer
        choices:
            - maintainer
            - developer
            - nobody
        description: Access levels allowed to push.
    state:
        type: str
        default: present
        choices:
            - present
            - absent
        description: Create or delete protected branch.
    validate_certs:
        type: bool
        default: true
        description: Whether or not to validate SSL certs when supplying a HTTPS endpoint.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create protected branch on main
    >   community.general.gitlab_protected_branch:
    >     api_url: https://gitlab.com
    >     api_token: secret_access_token
    >     project: "dj-wasabi/collection.general"
    >     name: main
    >     merge_access_levels: maintainer
    >     push_access_level: nobody
    >
    >
