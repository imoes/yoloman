name: memset_memstore_info
fqcn: community.general.memset_memstore_info
collection: community.general
short_description: Retrieve Memstore product usage information
description: Retrieve Memstore product usage information.
options:
    api_key:
        type: str
        required: true
        description: The API key obtained from the Memset control panel.
    name:
        type: str
        required: true
        description: The Memstore product name (that is, C(mstestyaa1)).
writes: false
runtime: starlark
source: translated
examples:
    >
    > - name: Get usage for mstestyaa1
    >   community.general.memset_memstore_info:
    >     name: mstestyaa1
    >     api_key: 5eb86c9896ab03919abcf03857163741
    >   delegate_to: localhost
    >
