name: ldap_passwd
fqcn: community.general.ldap_passwd
collection: community.general
short_description: Set passwords in LDAP
description: Set a password for an LDAP entry.  This module only asserts that a given password is valid for a given entry.  To assert the existence of an entry, see M(community.general.ldap_entry).
options:
    bind_dn:
        type: str
        description: A DN to bind with. If this is omitted, we'll try a SASL bind with the EXTERNAL mechanism as default. If this is blank, we'll use an anonymous bind.
    bind_pw:
        type: str
        default:
        description: The password to use with O(bind_dn).
    ca_path:
        type: path
        description: Set the path to PEM file with CA certs.
    client_cert:
        type: path
        description: PEM formatted certificate chain file to be used for SSL client authentication. Required if O(client_key) is defined.
    client_key:
        type: path
        description: PEM formatted file that contains your private key to be used for SSL client authentication. Required if O(client_cert) is defined.
    dn:
        type: str
        required: true
        description: The DN of the entry to add or remove.
    passwd:
        type: str
        description: The (plaintext) password to be set for O(dn).
    referrals_chasing:
        type: str
        default: anonymous
        choices:
            - disabled
            - anonymous
        description: Set the referrals chasing behavior. V(anonymous) follow referrals anonymously. This is the default behavior. V(disabled) disable referrals chasing. This sets C(OPT_REFERRALS) to off.
    sasl_class:
        type: str
        default: external
        choices:
            - external
            - gssapi
        description: The class to use for SASL authentication.
    server_uri:
        type: str
        default: ldapi:///
        description: The O(server_uri) parameter may be a comma- or whitespace-separated list of URIs containing only the schema, the host, and the port fields. The default value lets the underlying LDAP client library look for a UNIX domain socket in its default location. Note that when using multiple URIs you cannot determine to which URI your client gets connected. For URIs containing additional fields, particularly when using commas, behavior is undefined.
    start_tls:
        type: bool
        default: false
        description: If true, we'll use the START_TLS LDAP extension.
    validate_certs:
        type: bool
        default: true
        description: If set to V(false), SSL certificates will not be validated. This should only be used on sites using self-signed certificates.
    xorder_discovery:
        type: str
        default: auto
        choices:
            - enable
            - auto
            - disable
        description: Set the behavior on how to process Xordered DNs. V(enable) will perform a C(ONELEVEL) search below the superior RDN to find the matching DN. V(disable) will always use the DN unmodified (as passed by the O(dn) parameter). V(auto) will only perform a search if the first RDN does not contain an index number (C({x})).
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Set a password for the admin user
    >   community.general.ldap_passwd:
    >     dn: cn=admin,dc=example,dc=com
    >     passwd: "{{ vault_secret }}"
    >
    > - name: Setting passwords in bulk
    >   community.general.ldap_passwd:
    >     dn: "{{ item.key }}"
    >     passwd: "{{ item.value }}"
    >   with_dict:
    >     alice: alice123123
    >     bob:   "|30b!"
    >     admin: "{{ vault_secret }}"
    >
