name: vertica_info
fqcn: community.general.vertica_info
collection: community.general
short_description: Gathers Vertica database facts
description: Gathers Vertica database information.
options:
    cluster:
        type: str
        default: localhost
        description: Name of the cluster running the schema.
    db:
        type: str
        description: Name of the database running the schema.
    login_password:
        type: str
        description: The password used to authenticate with.
    login_user:
        type: str
        default: dbadmin
        description: The username used to authenticate with.
    port:
        type: str
        default: 5433
        description: Database port to connect to.
writes: false
runtime: starlark
source: translated
examples:
    >
    > - name: Gathering vertica facts
    >   community.general.vertica_info: db=db_name
    >   register: result
    >
    > - name: Print schemas
    >   ansible.builtin.debug:
    >     msg: "{{ result.vertica_schemas }}"
    >
