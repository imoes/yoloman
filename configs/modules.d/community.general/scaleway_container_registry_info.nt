name: scaleway_container_registry_info
fqcn: community.general.scaleway_container_registry_info
collection: community.general
short_description: Scaleway Container registry info module
description: This module return information about a container registry on Scaleway account.
options:
    api_timeout:
        type: int
        default: 30
        aliases:
            - timeout
        description: HTTP timeout to Scaleway API in seconds.
    api_token:
        type: str
        required: true
        aliases:
            - oauth_token
        description: Scaleway OAuth token.
    api_url:
        type: str
        default: https://api.scaleway.com
        aliases:
            - base_url
        description: Scaleway API URL.
    name:
        type: str
        required: true
        description: Name of the container registry.
    project_id:
        type: str
        required: true
        description: Project identifier.
    query_parameters:
        type: dict
        default:
            {}
        description: List of parameters passed to the query string.
    region:
        type: str
        required: true
        choices:
            - fr-par
            - nl-ams
            - pl-waw
        description: Scaleway region to use (for example C(fr-par)).
    validate_certs:
        type: bool
        default: true
        description: Validate SSL certs of the Scaleway API.
writes: false
runtime: starlark
source: translated
examples:
    >
    > - name: Get a container registry info
    >   community.general.scaleway_container_registry_info:
    >     project_id: '{{ scw_project }}'
    >     region: fr-par
    >     name: my-awesome-container-registry
    >   register: container_registry_info_task
    >
