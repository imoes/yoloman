name: github_webhook_info
fqcn: community.general.github_webhook_info
collection: community.general
short_description: Query information about GitHub webhooks
description: Query information about GitHub webhooks
options:
    github_url:
        type: str
        default: https://api.github.com
        description: Base URL of the github api
    password:
        type: str
        description: Password to authenticate to GitHub with
    repository:
        type: str
        required: true
        aliases:
            - repo
        description: Full name of the repository to configure a hook for
    token:
        type: str
        description: Token to authenticate to GitHub with
    user:
        type: str
        required: true
        description: User to authenticate to GitHub as
writes: false
runtime: starlark
source: translated
examples:
    >
    > - name: List hooks for a repository (password auth)
    >   community.general.github_webhook_info:
    >     repository: ansible/ansible
    >     user: "{{ github_user }}"
    >     password: "{{ github_password }}"
    >   register: ansible_webhooks
    >
    > - name: List hooks for a repository on GitHub Enterprise (token auth)
    >   community.general.github_webhook_info:
    >     repository: myorg/myrepo
    >     user: "{{ github_user }}"
    >     token: "{{ github_user_api_token }}"
    >     github_url: https://github.example.com/api/v3/
    >   register: myrepo_webhooks
    >
