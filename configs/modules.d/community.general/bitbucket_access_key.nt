name: bitbucket_access_key
fqcn: community.general.bitbucket_access_key
collection: community.general
short_description: Manages Bitbucket repository access keys
description: Manages Bitbucket repository access keys (also called deploy keys).
options:
    client_id:
        type: str
        description: The OAuth consumer key. If not set the environment variable E(BITBUCKET_CLIENT_ID) will be used.
    client_secret:
        type: str
        description: The OAuth consumer secret. If not set the environment variable E(BITBUCKET_CLIENT_SECRET) will be used.
    key:
        type: str
        description: The SSH public key.
    label:
        type: str
        required: true
        description: The key label.
    password:
        type: str
        description: The App password. If not set the environment variable E(BITBUCKET_PASSWORD) will be used.
    repository:
        type: str
        required: true
        description: The repository name.
    state:
        type: str
        required: true
        choices:
            - absent
            - present
        description: Indicates desired state of the access key.
    user:
        type: str
        aliases:
            - username
        description: The username. If not set the environment variable E(BITBUCKET_USERNAME) will be used. O(ignore:username) is an alias of O(user) since community.general 6.0.0. It was an alias of O(workspace) before.
    workspace:
        type: str
        required: true
        description: The repository owner. B(Note:) O(ignore:username) used to be an alias of this option. Since community.general 6.0.0 it is an alias of O(user).
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create access key
    >   community.general.bitbucket_access_key:
    >     repository: 'bitbucket-repo'
    >     workspace: bitbucket_workspace
    >     key: '{{lookup("file", "bitbucket.pub") }}'
    >     label: 'Bitbucket'
    >     state: present
    >
    > - name: Delete access key
    >   community.general.bitbucket_access_key:
    >     repository: bitbucket-repo
    >     workspace: bitbucket_workspace
    >     label: Bitbucket
    >     state: absent
    >
