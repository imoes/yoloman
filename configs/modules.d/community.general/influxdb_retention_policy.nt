name: influxdb_retention_policy
fqcn: community.general.influxdb_retention_policy
collection: community.general
short_description: Manage InfluxDB retention policies
description: Manage InfluxDB retention policies.
options:
    database_name:
        type: str
        required: true
        description: Name of the database.
    default:
        type: bool
        default: false
        description: Sets the retention policy as default retention policy.
    duration:
        type: str
        description: Determines how long InfluxDB should keep the data. If specified, it should be V(INF) or at least one hour. If not specified, V(INF) is assumed. Supports complex duration expressions with multiple units. Required only if O(state) is set to V(present).
    hostname:
        type: str
        default: localhost
        description: The hostname or IP address on which InfluxDB server is listening.
    password:
        type: str
        default: root
        aliases:
            - login_password
        description: Password that will be used to authenticate against InfluxDB server.
    path:
        type: str
        default:
        description: The path on which InfluxDB server is accessible. Only available when using python-influxdb >= 5.1.0.
    policy_name:
        type: str
        required: true
        description: Name of the retention policy.
    port:
        type: int
        default: 8086
        description: The port on which InfluxDB server is listening.
    proxies:
        type: dict
        default:
            {}
        description: HTTP(S) proxy to use for Requests to connect to InfluxDB server.
    replication:
        type: int
        description: Determines how many independent copies of each point are stored in the cluster. Required only if O(state) is set to V(present).
    retries:
        type: int
        default: 3
        description: Number of retries client will try before aborting. V(0) indicates try until success. Only available when using python-influxdb >= 4.1.0.
    shard_group_duration:
        type: str
        description: Determines the time range covered by a shard group. If specified it must be at least one hour. If none, it's determined by InfluxDB by the rentention policy's duration. Supports complex duration expressions with multiple units.
    ssl:
        type: bool
        default: false
        description: Use https instead of http to connect to InfluxDB server.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: State of the retention policy.
    timeout:
        type: int
        description: Number of seconds Requests will wait for client to establish a connection.
    udp_port:
        type: int
        default: 4444
        description: UDP port to connect to InfluxDB server.
    use_udp:
        type: bool
        default: false
        description: Use UDP to connect to InfluxDB server.
    username:
        type: str
        default: root
        aliases:
            - login_username
        description: Username that will be used to authenticate against InfluxDB server.
    validate_certs:
        type: bool
        default: true
        description: If set to V(false), the SSL certificates will not be validated. This should only set to V(false) used on personally controlled sites using self-signed certificates.
writes: true
runtime: starlark
source: translated
examples:
    >
    > # Example influxdb_retention_policy command from Ansible Playbooks
    > - name: Create 1 hour retention policy
    >   community.general.influxdb_retention_policy:
    >       hostname: "{{ influxdb_ip_address }}"
    >       database_name: "{{ influxdb_database_name }}"
    >       policy_name: test
    >       duration: 1h
    >       replication: 1
    >       ssl: true
    >       validate_certs: true
    >       state: present
    >
    > - name: Create 1 day retention policy with 1 hour shard group duration
    >   community.general.influxdb_retention_policy:
    >       hostname: "{{ influxdb_ip_address }}"
    >       database_name: "{{ influxdb_database_name }}"
    >       policy_name: test
    >       duration: 1d
    >       replication: 1
    >       shard_group_duration: 1h
    >       state: present
    >
    > - name: Create 1 week retention policy with 1 day shard group duration
    >   community.general.influxdb_retention_policy:
    >       hostname: "{{ influxdb_ip_address }}"
    >       database_name: "{{ influxdb_database_name }}"
    >       policy_name: test
    >       duration: 1w
    >       replication: 1
    >       shard_group_duration: 1d
    >       state: present
    >
    > - name: Create infinite retention policy with 1 week of shard group duration
    >   community.general.influxdb_retention_policy:
    >       hostname: "{{ influxdb_ip_address }}"
    >       database_name: "{{ influxdb_database_name }}"
    >       policy_name: test
    >       duration: INF
    >       replication: 1
    >       ssl: false
    >       shard_group_duration: 1w
    >       state: present
    >
    > - name: Create retention policy with complex durations
    >   community.general.influxdb_retention_policy:
    >       hostname: "{{ influxdb_ip_address }}"
    >       database_name: "{{ influxdb_database_name }}"
    >       policy_name: test
    >       duration: 5d1h30m
    >       replication: 1
    >       ssl: false
    >       shard_group_duration: 1d10h30m
    >       state: present
    >
    > - name: Drop retention policy
    >   community.general.influxdb_retention_policy:
    >       hostname: "{{ influxdb_ip_address }}"
    >       database_name: "{{ influxdb_database_name }}"
    >       policy_name: test
    >       state: absent
    >
