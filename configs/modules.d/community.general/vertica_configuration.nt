name: vertica_configuration
fqcn: community.general.vertica_configuration
collection: community.general
short_description: Updates Vertica configuration parameters
description: Updates Vertica configuration parameters.
options:
    cluster:
        type: str
        default: localhost
        description: Name of the Vertica cluster.
    db:
        type: str
        description: Name of the Vertica database.
    login_password:
        type: str
        description: The password used to authenticate with.
    login_user:
        type: str
        default: dbadmin
        description: The username used to authenticate with.
    parameter:
        type: str
        required: true
        aliases:
            - name
        description: Name of the parameter to update.
    port:
        type: str
        default: 5433
        description: Vertica cluster port to connect to.
    value:
        type: str
        description: Value of the parameter to be set.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Updating load_balance_policy
    >   community.general.vertica_configuration: name=failovertostandbyafter value='8 hours'
    >
