name: atomic_host
fqcn: community.general.atomic_host
collection: community.general
short_description: Manage the atomic host platform
description: Manage the atomic host platform. Rebooting of Atomic host platform should be done outside this module.
options:
    revision:
        type: str
        default: latest
        aliases:
            - version
        description: The version number of the atomic host to be deployed. Providing V(latest) will upgrade to the latest available version.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Upgrade the atomic host platform to the latest version (atomic host upgrade)
    >   community.general.atomic_host:
    >     revision: latest
    >
    > - name: Deploy a specific revision as the atomic host (atomic host deploy 23.130)
    >   community.general.atomic_host:
    >     revision: 23.130
    >
