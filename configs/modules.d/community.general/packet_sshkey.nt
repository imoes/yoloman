name: packet_sshkey
fqcn: community.general.packet_sshkey
collection: community.general
short_description: Create/delete an SSH key in Packet host
description: Create/delete an SSH key in Packet host. API is documented at U(https://www.packet.net/help/api/#page:ssh-keys,header:ssh-keys-ssh-keys-post).
options:
    auth_token:
        type: str
        description: Packet API token. You can also supply it in environment variable E(PACKET_API_TOKEN).
    fingerprint:
        type: str
        description: Fingerprint of the key which you want to remove.
    id:
        type: str
        description: UUID of the key which you want to remove.
    key:
        type: str
        description: Public Key string ({type} {base64 encoded key} {description}).
    key_file:
        type: path
        description: File with the public key.
    label:
        type: str
        aliases:
            - name
        description: Label for the key. If you keep it empty, it will be read from key string.
    state:
        type: str
        default: present
        choices:
            - present
            - absent
        description: Indicate desired state of the target.
writes: true
runtime: starlark
source: translated
examples:
    >
    > # All the examples assume that you have your Packet API token in env var PACKET_API_TOKEN.
    > # You can also pass the api token in module param auth_token.
    >
    > - name: Create sshkey from string
    >   hosts: localhost
    >   tasks:
    >     community.general.packet_sshkey:
    >       key: "{{ lookup('file', 'my_packet_sshkey.pub') }}"
    >
    > - name: Create sshkey from file
    >   hosts: localhost
    >   tasks:
    >     community.general.packet_sshkey:
    >       label: key from file
    >       key_file: ~/ff.pub
    >
    > - name: Remove sshkey by id
    >   hosts: localhost
    >   tasks:
    >     community.general.packet_sshkey:
    >       state: absent
    >       id: eef49903-7a09-4ca1-af67-4087c29ab5b6
    >
