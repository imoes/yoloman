name: utm_aaa_group
fqcn: community.general.utm_aaa_group
collection: community.general
short_description: Create, update or destroy an aaa group object in Sophos UTM
description: Create, update or destroy an aaa group object in Sophos UTM. This module needs to have the REST Ability of the UTM to be activated.
options:
    adirectory_groups:
        type: list
        default:
            []
        description: List of adirectory group strings.
    adirectory_groups_sids:
        type: dict
        default:
            {}
        description: Dictionary of group sids.
    backend_match:
        type: str
        default: none
        choices:
            - none
            - adirectory
            - edirectory
            - radius
            - tacacs
            - ldap
        description: The backend for the group.
    comment:
        type: str
        default:
        description: Comment that describes the AAA group.
    dynamic:
        type: str
        default: none
        choices:
            - none
            - ipsec_dn
            - directory_groups
        description: Group type. Is static if none is selected.
    edirectory_groups:
        type: list
        default:
            []
        description: List of edirectory group strings.
    headers:
        type: dict
        default:
            {}
        description: A dictionary of additional headers to be sent to POST and PUT requests. Is needed for some modules.
    ipsec_dn:
        type: str
        default:
        description: The ipsec dn string.
    ldap_attribute:
        type: str
        default:
        description: The ldap attribute to check against.
    ldap_attribute_value:
        type: str
        default:
        description: The ldap attribute value to check against.
    members:
        type: list
        default:
            []
        description: A list of user ref names (aaa/user).
    name:
        type: str
        required: true
        description: The name of the object. Will be used to identify the entry.
    network:
        type: str
        default:
        description: The network reference name. The objects contains the known ip addresses for the authentication object (network/aaa).
    radius_groups:
        type: list
        default:
            []
        description: A list of radius group strings.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: The desired state of the object. V(present) will create or update an object. V(absent) will delete an object if it was present.
    tacacs_groups:
        type: list
        default:
            []
        description: A list of tacacs group strings.
    utm_host:
        type: str
        required: true
        description: The REST Endpoint of the Sophos UTM.
    utm_port:
        type: int
        default: 4444
        description: The port of the REST interface.
    utm_protocol:
        type: str
        default: https
        choices:
            - http
            - https
        description: The protocol of the REST Endpoint.
    utm_token:
        type: str
        required: true
        description: The token used to identify at the REST-API. See U(https://www.sophos.com/en-us/medialibrary/PDFs/documentation/UTMonAWS/Sophos-UTM-RESTful-API.pdf?la=en), Chapter 2.4.2.
    validate_certs:
        type: bool
        default: true
        description: Whether the REST interface's ssl certificate should be verified or not.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create UTM aaa_group
    >   community.general.utm_aaa_group:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestAAAGroupEntry
    >     backend_match: ldap
    >     dynamic: directory_groups
    >     ldap_attributes: memberof
    >     ldap_attributes_value: "cn=groupname,ou=Groups,dc=mydomain,dc=com"
    >     network: REF_OBJECT_STRING
    >     state: present
    >
    > - name: Remove UTM aaa_group
    >   community.general.utm_aaa_group:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestAAAGroupEntry
    >     state: absent
    >
