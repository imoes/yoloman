name: bzr
fqcn: community.general.bzr
collection: community.general
short_description: Deploy software (or files) from bzr branches
description: Manage C(bzr) branches to deploy files or software.
options:
    dest:
        type: path
        required: true
        description: Absolute path of where the branch should be cloned to.
    executable:
        type: str
        description: Path to bzr executable to use. If not supplied, the normal mechanism for resolving binary paths will be used.
    force:
        type: bool
        default: false
        description: If V(true), any modified files in the working tree will be discarded.
    name:
        type: str
        required: true
        aliases:
            - parent
        description: SSH or HTTP protocol address of the parent branch.
    version:
        type: str
        default: head
        description: What version of the branch to clone.  This can be the bzr revno or revid.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Checkout
    >   community.general.bzr:
    >     name: bzr+ssh://foosball.example.org/path/to/branch
    >     dest: /srv/checkout
    >     version: 22
    >
