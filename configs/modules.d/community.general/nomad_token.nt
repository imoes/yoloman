name: nomad_token
fqcn: community.general.nomad_token
collection: community.general
short_description: Manage Nomad ACL tokens
description: This module allows to create Bootstrap tokens, create ACL tokens, update ACL tokens, and delete ACL tokens.
options:
    client_cert:
        type: path
        description: Path of certificate for TLS/SSL.
    client_key:
        type: path
        description: Path of certificate's private key for TLS/SSL.
    global_replicated:
        type: bool
        default: false
        description: Indicates whether or not the token was created with the C(--global).
    host:
        type: str
        required: true
        description: FQDN of Nomad server.
    name:
        type: str
        description: Name of ACL token to create.
    namespace:
        type: str
        description: Namespace for Nomad.
    policies:
        type: list
        default:
            []
        description: A list of the policies assigned to the token.
    port:
        type: int
        default: 4646
        description: Port of Nomad server.
    state:
        type: str
        required: true
        choices:
            - present
            - absent
        description: Create or remove ACL token.
    timeout:
        type: int
        default: 5
        description: Timeout (in seconds) for the request to Nomad.
    token:
        type: str
        description: ACL token for authentication.
    token_type:
        type: str
        default: client
        choices:
            - client
            - management
            - bootstrap
        description: The type of the token can be V(client), V(management), or V(bootstrap).
    use_ssl:
        type: bool
        default: true
        description: Use TLS/SSL connection.
    validate_certs:
        type: bool
        default: true
        description: Enable TLS/SSL certificate validation.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create boostrap token
    >   community.general.nomad_token:
    >     host: localhost
    >     token_type: bootstrap
    >     state: present
    >
    > - name: Create ACL token
    >   community.general.nomad_token:
    >     host: localhost
    >     name: "Dev token"
    >     token_type: client
    >     policies:
    >         - readonly
    >     global_replicated: false
    >     state: absent
    >
    > - name: Update ACL token Dev token
    >   community.general.nomad_token:
    >     host: localhost
    >     name: "Dev token"
    >     token_type: client
    >     policies:
    >         - readonly
    >         - devpolicy
    >     global_replicated: false
    >     state: absent
    >
    > - name: Delete ACL token
    >   community.general.nomad_token:
    >     host: localhost
    >     name: "Dev token"
    >     state: absent
    >
