name: scaleway_security_group_rule
fqcn: community.general.scaleway_security_group_rule
collection: community.general
short_description: Scaleway Security Group Rule management module
description: This module manages Security Group Rule on Scaleway account U(https://developer.scaleway.com).
options:
    action:
        type: str
        required: true
        choices:
            - accept
            - drop
        description: Rule action.
    api_timeout:
        type: int
        default: 30
        aliases:
            - timeout
        description: HTTP timeout to Scaleway API in seconds.
    api_token:
        type: str
        required: true
        aliases:
            - oauth_token
        description: Scaleway OAuth token.
    api_url:
        type: str
        default: https://api.scaleway.com
        aliases:
            - base_url
        description: Scaleway API URL.
    direction:
        type: str
        required: true
        choices:
            - inbound
            - outbound
        description: Rule direction.
    ip_range:
        type: str
        default: 0.0.0.0/0
        description: IPV4 CIDR notation to apply to the rule.
    port:
        type: int
        required: true
        description: Port related to the rule, null value for all the ports.
    protocol:
        type: str
        required: true
        choices:
            - TCP
            - UDP
            - ICMP
        description: Network protocol to use.
    query_parameters:
        type: dict
        default:
            {}
        description: List of parameters passed to the query string.
    region:
        type: str
        required: true
        choices:
            - ams1
            - EMEA-NL-EVS
            - par1
            - EMEA-FR-PAR1
            - par2
            - EMEA-FR-PAR2
            - waw1
            - EMEA-PL-WAW1
        description: Scaleway region to use (for example V(par1)).
    security_group:
        type: str
        required: true
        description: Security Group unique identifier.
    state:
        type: str
        default: present
        choices:
            - present
            - absent
        description: Indicate desired state of the Security Group Rule.
    validate_certs:
        type: bool
        default: true
        description: Validate SSL certs of the Scaleway API.
writes: true
runtime: starlark
source: translated
examples:
    >
    >   - name: Create a Security Group Rule
    >     community.general.scaleway_security_group_rule:
    >       state: present
    >       region: par1
    >       protocol: TCP
    >       port: 80
    >       ip_range: 0.0.0.0/0
    >       direction: inbound
    >       action: accept
    >       security_group: b57210ee-1281-4820-a6db-329f78596ecb
    >     register: security_group_rule_creation_task
    >
