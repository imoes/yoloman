name: telegram
fqcn: community.general.telegram
collection: community.general
short_description: Send notifications via telegram
description: Send notifications via telegram bot, to a verified group or user. Also, the user may try to use any other telegram bot API method, if you specify O(api_method) argument.
options:
    api_args:
        type: dict
        description: Any parameters for the method. For reference to default method, V(SendMessage), see U(https://core.telegram.org/bots/api#sendmessage).
    api_method:
        type: str
        default: SendMessage
        description: Bot API method. For reference, see U(https://core.telegram.org/bots/api).
    token:
        type: str
        required: true
        description: Token identifying your telegram bot.
writes: true
runtime: starlark
source: translated
examples:
    >
    >
    > - name: Send notify to Telegram
    >   community.general.telegram:
    >     token: '9999999:XXXXXXXXXXXXXXXXXXXXXXX'
    >     api_args:
    >       chat_id: 000000
    >       parse_mode: "markdown"
    >       text: "Your precious application has been deployed: https://example.com"
    >       disable_web_page_preview: true
    >       disable_notification: true
    >
    > - name: Forward message to someone
    >   community.general.telegram:
    >     token: '9999999:XXXXXXXXXXXXXXXXXXXXXXX'
    >     api_method: forwardMessage
    >     api_args:
    >       chat_id: 000000
    >       from_chat_id: 111111
    >       disable_notification: true
    >       message_id: '{{ saved_msg_id }}'
    >
