name: homectl
fqcn: community.general.homectl
collection: community.general
short_description: Manage user accounts with systemd-homed
description: Manages a user's home directory managed by systemd-homed.
options:
    disksize:
        type: str
        description: The intended home directory disk space. Human readable value such as V(10G), V(10M), or V(10B).
    email:
        type: str
        description: The email address of the user.
    environment:
        type: str
        aliases:
            - setenv
        description: String separated by comma each containing an environment variable and its value to set for the user's login session, in a format compatible with ``putenv()``. Any environment variable listed here is automatically set by pam_systemd for all login sessions of the user.
    gid:
        type: int
        description: Sets the gid of the user. If using O(uid) homed requires the value to be the same. Only used when a user is first created.
    homedir:
        type: path
        description: Path to use as home directory for the user. This is the directory the user's home directory is mounted to while the user is logged in. This is not where the user's data is actually stored, see O(imagepath) for that. Only used when a user is first created.
    iconname:
        type: str
        description: The name of an icon picked by the user, for example for the purpose of an avatar. Should follow the semantics defined in the Icon Naming Specification. See U(https://specifications.freedesktop.org/icon-naming-spec/icon-naming-spec-latest.html) for specifics.
    imagepath:
        type: path
        description: Path to place the user's home directory. See U(https://www.freedesktop.org/software/systemd/man/homectl.html#--image-path=PATH) for more information. Only used when a user is first created.
    language:
        type: str
        description: The preferred language/locale for the user. This should be in a format compatible with the E(LANG) environment variable.
    location:
        type: str
        description: A free-form location string describing the location of the user.
    locked:
        type: bool
        description: Whether the user account should be locked or not.
    memberof:
        type: str
        aliases:
            - groups
        description: String separated by comma each indicating a UNIX group this user shall be a member of. Groups the user should be a member of should be supplied as comma separated list.
    mountopts:
        type: str
        description: String separated by comma each indicating mount options for a users home directory. Valid options are V(nosuid), V(nodev) or V(noexec). Homed by default uses V(nodev) and V(nosuid) while V(noexec) is off.
    name:
        type: str
        required: true
        aliases:
            - user
            - username
        description: The user name to create, remove, or update.
    notafter:
        type: int
        description: A time since the UNIX epoch after which the record should be considered invalid for the purpose of logging in.
    notbefore:
        type: int
        description: A time since the UNIX epoch before which the record should be considered invalid for the purpose of logging in.
    password:
        type: str
        description: Set the user's password to this. Homed requires this value to be in cleartext on user creation and updating a user. The module takes the password and generates a password hash in SHA-512 with 10000 rounds of salt generation using crypt. See U(https://systemd.io/USER_RECORD/). This is required for O(state=present). When an existing user is updated this is checked against the stored hash in homed.
    passwordhint:
        type: str
        description: Password hint for the given user.
    realm:
        type: str
        description: The 'realm' a user is defined in.
    realname:
        type: str
        aliases:
            - comment
        description: The user's real ('human') name. This can also be used to add a comment to maintain compatibility with C(useradd).
    resize:
        type: bool
        default: false
        description: When used with O(disksize) this will attempt to resize the home directory immediately.
    shell:
        type: str
        description: Shell binary to use for terminal logins of given user. If not specified homed by default uses V(/bin/bash).
    skeleton:
        type: path
        aliases:
            - skel
        description: The absolute path to the skeleton directory to populate a new home directory from. This is only used when a home directory is first created. If not specified homed by default uses V(/etc/skel).
    sshkeys:
        type: str
        description: String separated by comma each listing a SSH public key that is authorized to access the account. The keys should follow the same format as the lines in a traditional C(~/.ssh/authorized_key) file.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: The operation to take on the user.
    storage:
        type: str
        choices:
            - classic
            - luks
            - directory
            - subvolume
            - fscrypt
            - cifs
        description: Indicates the storage mechanism for the user's home directory. If the storage type is not specified, ``homed.conf(5)`` defines which default storage to use. Only used when a user is first created.
    timezone:
        type: str
        description: Preferred timezone to use for the user. Should be a tzdata compatible location string such as V(America/New_York).
    uid:
        type: int
        description: Sets the UID of the user. If using O(gid) homed requires the value to be the same. Only used when a user is first created.
    umask:
        type: int
        description: Sets the umask for the user's login sessions Value from V(0000) to V(0777).
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Add the user 'james'
    >   community.general.homectl:
    >     name: johnd
    >     password: myreallysecurepassword1!
    >     state: present
    >
    > - name: Add the user 'alice' with a zsh shell, uid of 1000, and gid of 2000
    >   community.general.homectl:
    >     name: alice
    >     password: myreallysecurepassword1!
    >     state: present
    >     shell: /bin/zsh
    >     uid: 1000
    >     gid: 1000
    >
    > - name: Modify an existing user 'frank' to have 10G of diskspace and resize usage now
    >   community.general.homectl:
    >     name: frank
    >     password: myreallysecurepassword1!
    >     state: present
    >     disksize: 10G
    >     resize: true
    >
    > - name: Remove an existing user 'janet'
    >   community.general.homectl:
    >     name: janet
    >     state: absent
    >
