name: newrelic_deployment
fqcn: community.general.newrelic_deployment
collection: community.general
short_description: Notify New Relic about app deployments
description: Notify New Relic about app deployments (see https://docs.newrelic.com/docs/apm/new-relic-apm/maintenance/record-monitor-deployments/)
options:
    app_name:
        type: str
        description: The value of C(app_name) in the C(newrelic.yml) file used by the application. One of O(app_name) or O(application_id) is required.
    app_name_exact_match:
        type: bool
        default: false
        description: If this flag is set to V(true) then the application ID lookup by name would only work for an exact match. If set to V(false) it returns the first result.
    application_id:
        type: str
        description: The application ID found in the metadata of the application in APM. One of O(app_name) or O(application_id) is required.
    changelog:
        type: str
        description: A list of changes for this deployment
    description:
        type: str
        description: Text annotation for the deployment - notes for you
    revision:
        type: str
        required: true
        description: A revision number (e.g., git commit SHA)
    token:
        type: str
        required: true
        description: API token to place in the Api-Key header.
    user:
        type: str
        description: The name of the user/process that triggered this deployment
    validate_certs:
        type: bool
        default: true
        description: If V(false), SSL certificates will not be validated. This should only be used on personally controlled sites using self-signed certificates.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name:  Notify New Relic about an app deployment
    >   community.general.newrelic_deployment:
    >     token: AAAAAA
    >     app_name: myapp
    >     user: ansible deployment
    >     revision: '1.0'
    >
