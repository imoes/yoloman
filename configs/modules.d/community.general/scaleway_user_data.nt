name: scaleway_user_data
fqcn: community.general.scaleway_user_data
collection: community.general
short_description: Scaleway user_data management module
description: This module manages user_data on compute instances on Scaleway. It can be used to configure cloud-init for instance.
options:
    api_timeout:
        type: int
        default: 30
        aliases:
            - timeout
        description: HTTP timeout to Scaleway API in seconds.
    api_token:
        type: str
        required: true
        aliases:
            - oauth_token
        description: Scaleway OAuth token.
    api_url:
        type: str
        default: https://api.scaleway.com
        aliases:
            - base_url
        description: Scaleway API URL.
    query_parameters:
        type: dict
        default:
            {}
        description: List of parameters passed to the query string.
    region:
        type: str
        required: true
        choices:
            - ams1
            - EMEA-NL-EVS
            - par1
            - EMEA-FR-PAR1
            - par2
            - EMEA-FR-PAR2
            - waw1
            - EMEA-PL-WAW1
        description: Scaleway compute zone.
    server_id:
        type: str
        required: true
        description: Scaleway Compute instance ID of the server.
    user_data:
        type: dict
        description: User defined data. Typically used with C(cloud-init). Pass your C(cloud-init) script here as a string.
    validate_certs:
        type: bool
        default: true
        description: Validate SSL certs of the Scaleway API.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Update the cloud-init
    >   community.general.scaleway_user_data:
    >     server_id: '5a33b4ab-57dd-4eb6-8b0a-d95eb63492ce'
    >     region: ams1
    >     user_data:
    >       cloud-init: 'final_message: "Hello World!"'
    >
