name: apt_repo
fqcn: community.general.apt_repo
collection: community.general
short_description: Manage APT repositories via apt-repo
description: Manages APT repositories using apt-repo tool. See U(https://www.altlinux.org/Apt-repo) for details about apt-repo
options:
    remove_others:
        type: bool
        default: false
        description: Remove other then added repositories Used if O(state=present)
    repo:
        type: str
        required: true
        description: Name of the repository to add or remove.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: Indicates the desired repository state.
    update:
        type: bool
        default: false
        description: Update the package database after changing repositories.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Remove all repositories
    >   community.general.apt_repo:
    >     repo: all
    >     state: absent
    >
    > - name: Add repository `Sisysphus` and remove other repositories
    >   community.general.apt_repo:
    >     repo: Sisysphus
    >     state: present
    >     remove_others: true
    >
    > - name: Add local repository `/space/ALT/Sisyphus` and update package cache
    >   community.general.apt_repo:
    >     repo: copy:///space/ALT/Sisyphus
    >     state: present
    >     update: true
    >
