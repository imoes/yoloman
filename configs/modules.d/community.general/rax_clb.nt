name: rax_clb
fqcn: community.general.rax_clb
collection: community.general
short_description: Create / delete a load balancer in Rackspace Public Cloud
description: creates / deletes a Rackspace Public Cloud load balancer.
options:
    algorithm:
        type: str
        default: LEAST_CONNECTIONS
        choices:
            - RANDOM
            - LEAST_CONNECTIONS
            - ROUND_ROBIN
            - WEIGHTED_LEAST_CONNECTIONS
            - WEIGHTED_ROUND_ROBIN
        description: algorithm for the balancer being created
    api_key:
        type: str
        aliases:
            - password
        description: Rackspace API key, overrides O(credentials).
    auth_endpoint:
        type: str
        description: The URI of the authentication service. If not specified will be set to U(https://identity.api.rackspacecloud.com/v2.0/).
    credentials:
        type: path
        aliases:
            - creds_file
        description: File to find the Rackspace credentials in. Ignored if O(api_key) and O(username) are provided.
    env:
        type: str
        description: Environment as configured in C(~/.pyrax.cfg), see U(https://github.com/rackspace/pyrax/blob/master/docs/getting_started.md#pyrax-configuration).
    identity_type:
        type: str
        default: rackspace
        description: Authentication mechanism to use, such as rackspace or keystone.
    meta:
        type: dict
        default:
            {}
        description: A hash of metadata to associate with the instance
    name:
        type: str
        required: true
        description: Name to give the load balancer
    port:
        type: int
        default: 80
        description: Port for the balancer being created
    protocol:
        type: str
        default: HTTP
        choices:
            - DNS_TCP
            - DNS_UDP
            - FTP
            - HTTP
            - HTTPS
            - IMAPS
            - IMAPv4
            - LDAP
            - LDAPS
            - MYSQL
            - POP3
            - POP3S
            - SMTP
            - TCP
            - TCP_CLIENT_FIRST
            - UDP
            - UDP_STREAM
            - SFTP
        description: Protocol for the balancer being created
    region:
        type: str
        description: Region to create an instance in.
    state:
        type: str
        default: present
        choices:
            - present
            - absent
        description: Indicate desired state of the resource
    tenant_id:
        type: str
        description: The tenant ID used for authentication.
    tenant_name:
        type: str
        description: The tenant name used for authentication.
    timeout:
        type: int
        default: 30
        description: timeout for communication between the balancer and the node
    type:
        type: str
        default: PUBLIC
        choices:
            - PUBLIC
            - SERVICENET
        description: type of interface for the balancer being created
    username:
        type: str
        description: Rackspace username, overrides O(credentials).
    validate_certs:
        type: bool
        aliases:
            - verify_ssl
        description: Whether or not to require SSL validation of API endpoints.
    vip_id:
        type: str
        description: Virtual IP ID to use when creating the load balancer for purposes of sharing an IP with another load balancer of another protocol
    wait:
        type: bool
        default: false
        description: wait for the balancer to be in state 'running' before returning
    wait_timeout:
        type: int
        default: 300
        description: how long before wait gives up, in seconds
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Build a Load Balancer
    >   gather_facts: false
    >   hosts: local
    >   connection: local
    >   tasks:
    >     - name: Load Balancer create request
    >       local_action:
    >         module: rax_clb
    >         credentials: ~/.raxpub
    >         name: my-lb
    >         port: 8080
    >         protocol: HTTP
    >         type: SERVICENET
    >         timeout: 30
    >         region: DFW
    >         wait: true
    >         state: present
    >         meta:
    >           app: my-cool-app
    >       register: my_lb
    >
