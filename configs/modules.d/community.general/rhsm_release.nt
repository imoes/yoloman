name: rhsm_release
fqcn: community.general.rhsm_release
collection: community.general
short_description: Set or Unset RHSM Release version
description: Sets or unsets the release version used by RHSM repositories.
options:
    release:
        type: str
        description: RHSM release version to use. To unset either pass V(null) for this option, or omit this option.
writes: true
runtime: starlark
source: translated
examples:
    >
    > # Set release version to 7.1
    > - name: Set RHSM release version
    >   community.general.rhsm_release:
    >     release: "7.1"
    >
    > # Set release version to 6Server
    > - name: Set RHSM release version
    >   community.general.rhsm_release:
    >     release: "6Server"
    >
    > # Unset release version
    > - name: Unset RHSM release release
    >   community.general.rhsm_release:
    >     release: null
    >
