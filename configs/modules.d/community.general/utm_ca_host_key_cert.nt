name: utm_ca_host_key_cert
fqcn: community.general.utm_ca_host_key_cert
collection: community.general
short_description: Create, update or destroy ca host_key_cert entry in Sophos UTM
description: Create, update or destroy a ca host_key_cert entry in SOPHOS UTM. This module needs to have the REST Ability of the UTM to be activated.
options:
    ca:
        type: str
        required: true
        description: A reference to an existing utm_ca_signing_ca or utm_ca_verification_ca object.
    certificate:
        type: str
        required: true
        description: The certificate in PEM format.
    comment:
        type: str
        description: Optional comment string.
    encrypted:
        type: bool
        default: false
        description: Optionally enable encryption.
    headers:
        type: dict
        default:
            {}
        description: A dictionary of additional headers to be sent to POST and PUT requests. Is needed for some modules.
    key:
        type: str
        description: Optional private key in PEM format.
    meta:
        type: str
        required: true
        description: A reference to an existing utm_ca_meta_x509 object.
    name:
        type: str
        required: true
        description: The name of the object. Will be used to identify the entry.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: The desired state of the object. V(present) will create or update an object. V(absent) will delete an object if it was present.
    utm_host:
        type: str
        required: true
        description: The REST Endpoint of the Sophos UTM.
    utm_port:
        type: int
        default: 4444
        description: The port of the REST interface.
    utm_protocol:
        type: str
        default: https
        choices:
            - http
            - https
        description: The protocol of the REST Endpoint.
    utm_token:
        type: str
        required: true
        description: The token used to identify at the REST-API. See U(https://www.sophos.com/en-us/medialibrary/PDFs/documentation/UTMonAWS/Sophos-UTM-RESTful-API.pdf?la=en), Chapter 2.4.2.
    validate_certs:
        type: bool
        default: true
        description: Whether the REST interface's ssl certificate should be verified or not.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create a ca_host_key_cert entry
    >   community.general.utm_ca_host_key_cert:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestHostKeyCertEntry
    >     ca: REF_ca/signing_ca_OBJECT_STRING
    >     meta: REF_ca/meta_x509_OBJECT_STRING
    >     certificate: |
    >       --- BEGIN CERTIFICATE ---
    >       . . .
    >        . . .
    >       . . .
    >       --- END CERTIFICATE ---
    >     state: present
    >
    > - name: Remove a ca_host_key_cert entry
    >   community.general.utm_ca_host_key_cert:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestHostKeyCertEntry
    >     state: absent
    >
    > - name: Read a ca_host_key_cert entry
    >   community.general.utm_ca_host_key_cert:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestHostKeyCertEntry
    >     state: info
    >
    >
