name: lbu
fqcn: community.general.lbu
collection: community.general
short_description: Local Backup Utility for Alpine Linux
description: Manage Local Backup Utility of Alpine Linux in run-from-RAM mode
options:
    commit:
        type: bool
        description: Control whether to commit changed files.
    exclude:
        type: list
        description: List of paths to exclude.
    include:
        type: list
        description: List of paths to include.
writes: true
runtime: starlark
source: translated
examples:
    >
    > # Commit changed files (if any)
    > - name: Commit
    >   community.general.lbu:
    >     commit: true
    >
    > # Exclude path and commit
    > - name: Exclude directory
    >   community.general.lbu:
    >     commit: true
    >     exclude:
    >     - /etc/opt
    >
    > # Include paths without committing
    > - name: Include file and directory
    >   community.general.lbu:
    >     include:
    >     - /root/.ssh/authorized_keys
    >     - /var/lib/misc
    >
