name: github_webhook
fqcn: community.general.github_webhook
collection: community.general
short_description: Manage GitHub webhooks
description: Create and delete GitHub webhooks
options:
    active:
        type: bool
        default: true
        description: Whether or not the hook is active
    content_type:
        type: str
        default: form
        choices:
            - form
            - json
        description: The media type used to serialize the payloads
    events:
        type: list
        description:
            > A list of GitHub events the hook is triggered for. Events are listed at U(https://developer.github.com/v3/activity/events/types/). Required unless O(state=absent)
            >
    github_url:
        type: str
        default: https://api.github.com
        description: Base URL of the GitHub API
    insecure_ssl:
        type: bool
        default: false
        description:
            > Flag to indicate that GitHub should skip SSL verification when calling the hook.
            >
    password:
        type: str
        description: Password to authenticate to GitHub with
    repository:
        type: str
        required: true
        aliases:
            - repo
        description: Full name of the repository to configure a hook for
    secret:
        type: str
        description: The shared secret between GitHub and the payload URL.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: Whether the hook should be present or absent
    token:
        type: str
        description: Token to authenticate to GitHub with
    url:
        type: str
        required: true
        description: URL to which payloads will be delivered
    user:
        type: str
        required: true
        description: User to authenticate to GitHub as
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create a new webhook that triggers on push (password auth)
    >   community.general.github_webhook:
    >     repository: ansible/ansible
    >     url: https://www.example.com/hooks/
    >     events:
    >       - push
    >     user: "{{ github_user }}"
    >     password: "{{ github_password }}"
    >
    > - name: Create a new webhook in a github enterprise installation with multiple event triggers (token auth)
    >   community.general.github_webhook:
    >     repository: myorg/myrepo
    >     url: https://jenkins.example.com/ghprbhook/
    >     content_type: json
    >     secret: "{{ github_shared_secret }}"
    >     insecure_ssl: true
    >     events:
    >       - issue_comment
    >       - pull_request
    >     user: "{{ github_user }}"
    >     token: "{{ github_user_api_token }}"
    >     github_url: https://github.example.com
    >
    > - name: Delete a webhook (password auth)
    >   community.general.github_webhook:
    >     repository: ansible/ansible
    >     url: https://www.example.com/hooks/
    >     state: absent
    >     user: "{{ github_user }}"
    >     password: "{{ github_password }}"
    >
