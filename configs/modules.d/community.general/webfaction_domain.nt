name: webfaction_domain
fqcn: community.general.webfaction_domain
collection: community.general
short_description: Add or remove domains and subdomains on Webfaction
description: Add or remove domains or subdomains on a Webfaction host. Further documentation at https://github.com/quentinsf/ansible-webfaction.
options:
    login_name:
        type: str
        required: true
        description: The webfaction account to use
    login_password:
        type: str
        required: true
        description: The webfaction password to use
    name:
        type: str
        required: true
        description: The name of the domain
    state:
        type: str
        default: present
        choices:
            - present
            - absent
        description: Whether the domain should exist
    subdomains:
        type: list
        default:
            []
        description: Any subdomains to create.
writes: true
runtime: starlark
source: translated
examples:
    >
    >   - name: Create a test domain
    >     community.general.webfaction_domain:
    >       name: mydomain.com
    >       state: present
    >       subdomains:
    >        - www
    >        - blog
    >       login_name: "{{webfaction_user}}"
    >       login_password: "{{webfaction_passwd}}"
    >
    >   - name: Delete test domain and any subdomains
    >     community.general.webfaction_domain:
    >       name: mydomain.com
    >       state: absent
    >       login_name: "{{webfaction_user}}"
    >       login_password: "{{webfaction_passwd}}"
    >
    >
