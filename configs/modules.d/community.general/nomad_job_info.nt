name: nomad_job_info
fqcn: community.general.nomad_job_info
collection: community.general
short_description: Get Nomad Jobs info
description: Get info for one Nomad job. List Nomad jobs.
options:
    client_cert:
        type: path
        description: Path of certificate for TLS/SSL.
    client_key:
        type: path
        description: Path of certificate's private key for TLS/SSL.
    host:
        type: str
        required: true
        description: FQDN of Nomad server.
    name:
        type: str
        description: Name of job for Get info. If not specified, lists all jobs.
    namespace:
        type: str
        description: Namespace for Nomad.
    port:
        type: int
        default: 4646
        description: Port of Nomad server.
    timeout:
        type: int
        default: 5
        description: Timeout (in seconds) for the request to Nomad.
    token:
        type: str
        description: ACL token for authentication.
    use_ssl:
        type: bool
        default: true
        description: Use TLS/SSL connection.
    validate_certs:
        type: bool
        default: true
        description: Enable TLS/SSL certificate validation.
writes: false
runtime: starlark
source: translated
examples:
    >
    > - name: Get info for job awx
    >   community.general.nomad_job_info:
    >     host: localhost
    >     name: awx
    >   register: result
    >
    > - name: List Nomad jobs
    >   community.general.nomad_job_info:
    >     host: localhost
    >   register: result
    >
    >
