name: ipify_facts
fqcn: community.general.ipify_facts
collection: community.general
short_description: Retrieve the public IP of your internet gateway
description: If behind NAT and need to know the public IP of your internet gateway.
options:
    api_url:
        type: str
        default: https://api.ipify.org/
        description: URL of the ipify.org API service. C(?format=json) will be appended per default.
    timeout:
        type: int
        default: 10
        description: HTTP connection timeout in seconds.
    validate_certs:
        type: bool
        default: true
        description: When set to V(false), SSL certificates will not be validated.
writes: false
runtime: starlark
source: translated
examples:
    >
    > # Gather IP facts from ipify.org
    > - name: Get my public IP
    >   community.general.ipify_facts:
    >
    > # Gather IP facts from your own ipify service endpoint with a custom timeout
    > - name: Get my public IP
    >   community.general.ipify_facts:
    >     api_url: http://api.example.com/ipify
    >     timeout: 20
    >
