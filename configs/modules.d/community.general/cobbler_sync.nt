name: cobbler_sync
fqcn: community.general.cobbler_sync
collection: community.general
short_description: Sync Cobbler
description: Sync Cobbler to commit changes.
options:
    host:
        type: str
        default: 127.0.0.1
        description: The name or IP address of the Cobbler system.
    password:
        type: str
        description: The password to log in to Cobbler.
    port:
        type: int
        description: Port number to be used for REST connection. The default value depends on parameter O(use_ssl).
    use_ssl:
        type: bool
        default: true
        description: If V(false), an HTTP connection will be used instead of the default HTTPS connection.
    username:
        type: str
        default: cobbler
        description: The username to log in to Cobbler.
    validate_certs:
        type: bool
        default: true
        description: If V(false), SSL certificates will not be validated. This should only set to V(false) when used on personally controlled sites using self-signed certificates.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Commit Cobbler changes
    >   community.general.cobbler_sync:
    >     host: cobbler01
    >     username: cobbler
    >     password: MySuperSecureP4sswOrd
    >   run_once: true
    >   delegate_to: localhost
    >
