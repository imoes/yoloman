name: github_release
fqcn: community.general.github_release
collection: community.general
short_description: Interact with GitHub Releases
description: Fetch metadata about GitHub Releases
options:
    action:
        type: str
        required: true
        choices:
            - latest_release
            - create_release
        description: Action to perform
    body:
        type: str
        description: Description of the release when creating a release
    draft:
        type: bool
        default: false
        description: Sets if the release is a draft or not. (boolean)
    name:
        type: str
        description: Name of release when creating a release
    password:
        type: str
        description: The GitHub account password for the user. Mutually exclusive with O(token).
    prerelease:
        type: bool
        default: false
        description: Sets if the release is a prerelease or not. (boolean)
    repo:
        type: str
        required: true
        description: Repository name
    tag:
        type: str
        description: Tag name when creating a release. Required when using O(action=create_release).
    target:
        type: str
        description: Target of release when creating a release
    token:
        type: str
        description: GitHub Personal Access Token for authenticating. Mutually exclusive with O(password).
    user:
        type: str
        required: true
        description: The GitHub account that owns the repository
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Get latest release of a public repository
    >   community.general.github_release:
    >     user: ansible
    >     repo: ansible
    >     action: latest_release
    >
    > - name: Get latest release of testuseer/testrepo
    >   community.general.github_release:
    >     token: tokenabc1234567890
    >     user: testuser
    >     repo: testrepo
    >     action: latest_release
    >
    > - name: Get latest release of test repo using username and password
    >   community.general.github_release:
    >     user: testuser
    >     password: secret123
    >     repo: testrepo
    >     action: latest_release
    >
    > - name: Create a new release
    >   community.general.github_release:
    >     token: tokenabc1234567890
    >     user: testuser
    >     repo: testrepo
    >     action: create_release
    >     tag: test
    >     target: master
    >     name: My Release
    >     body: Some description
    >
    >
