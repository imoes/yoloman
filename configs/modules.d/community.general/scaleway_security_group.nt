name: scaleway_security_group
fqcn: community.general.scaleway_security_group
collection: community.general
short_description: Scaleway Security Group management module
description: This module manages Security Group on Scaleway account U(https://developer.scaleway.com).
options:
    api_timeout:
        type: int
        default: 30
        aliases:
            - timeout
        description: HTTP timeout to Scaleway API in seconds.
    api_token:
        type: str
        required: true
        aliases:
            - oauth_token
        description: Scaleway OAuth token.
    api_url:
        type: str
        default: https://api.scaleway.com
        aliases:
            - base_url
        description: Scaleway API URL.
    description:
        type: str
        description: Description of the Security Group.
    inbound_default_policy:
        type: str
        choices:
            - accept
            - drop
        description: Default policy for incoming traffic.
    name:
        type: str
        required: true
        description: Name of the Security Group.
    organization:
        type: str
        required: true
        description: Organization identifier.
    organization_default:
        type: bool
        description: Create security group to be the default one.
    outbound_default_policy:
        type: str
        choices:
            - accept
            - drop
        description: Default policy for outcoming traffic.
    query_parameters:
        type: dict
        default:
            {}
        description: List of parameters passed to the query string.
    region:
        type: str
        required: true
        choices:
            - ams1
            - EMEA-NL-EVS
            - par1
            - EMEA-FR-PAR1
            - par2
            - EMEA-FR-PAR2
            - waw1
            - EMEA-PL-WAW1
        description: Scaleway region to use (for example V(par1)).
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: Indicate desired state of the Security Group.
    stateful:
        type: bool
        required: true
        description: Create a stateful security group which allows established connections in and out.
    validate_certs:
        type: bool
        default: true
        description: Validate SSL certs of the Scaleway API.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create a Security Group
    >   community.general.scaleway_security_group:
    >     state: present
    >     region: par1
    >     name: security_group
    >     description: "my security group description"
    >     organization: "43a3b6c8-916f-477b-b7ec-ff1898f5fdd9"
    >     stateful: false
    >     inbound_default_policy: accept
    >     outbound_default_policy: accept
    >     organization_default: false
    >   register: security_group_creation_task
    >
