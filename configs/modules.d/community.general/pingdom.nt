name: pingdom
fqcn: community.general.pingdom
collection: community.general
short_description: Pause/unpause Pingdom alerts
description: This module will let you pause/unpause Pingdom alerts
options:
    checkid:
        type: str
        required: true
        description: Pingdom ID of the check.
    key:
        type: str
        required: true
        description: Pingdom API key.
    passwd:
        type: str
        required: true
        description: Pingdom user password.
    state:
        type: str
        required: true
        choices:
            - running
            - paused
            - started
            - stopped
        description: Define whether or not the check should be running or paused.
    uid:
        type: str
        required: true
        description: Pingdom user ID.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Pause the check with the ID of 12345
    >   community.general.pingdom:
    >     uid: example@example.com
    >     passwd: password123
    >     key: apipassword123
    >     checkid: 12345
    >     state: paused
    >
    > - name: Unpause the check with the ID of 12345
    >   community.general.pingdom:
    >     uid: example@example.com
    >     passwd: password123
    >     key: apipassword123
    >     checkid: 12345
    >     state: running
    >
