name: clc_aa_policy
fqcn: community.general.clc_aa_policy
collection: community.general
short_description: Create or Delete Anti Affinity Policies at CenturyLink Cloud
description: An Ansible module to Create or Delete Anti Affinity Policies at CenturyLink Cloud.
options:
    location:
        type: str
        required: true
        description: Datacenter in which the policy lives/should live.
    name:
        type: str
        required: true
        description: The name of the Anti Affinity Policy.
    state:
        type: str
        default: present
        choices:
            - present
            - absent
        description: Whether to create or delete the policy.
writes: true
runtime: starlark
source: translated
examples:
    >
    > # Note - You must set the CLC_V2_API_USERNAME And CLC_V2_API_PASSWD Environment variables before running these examples
    >
    > ---
    > - name: Create AA Policy
    >   hosts: localhost
    >   gather_facts: false
    >   connection: local
    >   tasks:
    >     - name: Create an Anti Affinity Policy
    >       community.general.clc_aa_policy:
    >         name: Hammer Time
    >         location: UK3
    >         state: present
    >       register: policy
    >
    >     - name: Debug
    >       ansible.builtin.debug:
    >         var: policy
    >
    > - name: Delete AA Policy
    >   hosts: localhost
    >   gather_facts: false
    >   connection: local
    >   tasks:
    >     - name: Delete an Anti Affinity Policy
    >       community.general.clc_aa_policy:
    >         name: Hammer Time
    >         location: UK3
    >         state: absent
    >       register: policy
    >
    >     - name: Debug
    >       ansible.builtin.debug:
    >         var: policy
    >
