name: gio_mime
fqcn: community.general.gio_mime
collection: community.general
short_description: Set default handler for MIME type, for applications using Gnome GIO
description: This module allows configuring the default handler for a specific MIME type, to be used by applications built with th Gnome GIO API.
options:
    handler:
        type: str
        required: true
        description: Default handler will be set for the MIME type.
    mime_type:
        type: str
        required: true
        description: MIME type for which a default handler will be set.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Set chrome as the default handler for https
    >   community.general.gio_mime:
    >     mime_type: x-scheme-handler/https
    >     handler: google-chrome.desktop
    >   register: result
    >
