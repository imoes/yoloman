name: gandi_livedns
fqcn: community.general.gandi_livedns
collection: community.general
short_description: Manage Gandi LiveDNS records
description: Manages DNS records by the Gandi LiveDNS API, see the docs: U(https://doc.livedns.gandi.net/).
options:
    api_key:
        type: str
        required: true
        description: Account API token.
    domain:
        type: str
        required: true
        description: The name of the Domain to work with (for example, "example.com").
    record:
        type: str
        required: true
        description: Record to add.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: Whether the record(s) should exist or not.
    ttl:
        type: int
        description: The TTL to give the new record. Required when O(state=present).
    type:
        type: str
        required: true
        description: The type of DNS record to create.
    values:
        type: list
        description: The record values. Required when O(state=present).
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create a test A record to point to 127.0.0.1 in the my.com domain
    >   community.general.gandi_livedns:
    >     domain: my.com
    >     record: test
    >     type: A
    >     values:
    >     - 127.0.0.1
    >     ttl: 7200
    >     api_key: dummyapitoken
    >   register: record
    >
    > - name: Create a mail CNAME record to www.my.com domain
    >   community.general.gandi_livedns:
    >     domain: my.com
    >     type: CNAME
    >     record: mail
    >     values:
    >     - www
    >     ttl: 7200
    >     api_key: dummyapitoken
    >     state: present
    >
    > - name: Change its TTL
    >   community.general.gandi_livedns:
    >     domain: my.com
    >     type: CNAME
    >     record: mail
    >     values:
    >     - www
    >     ttl: 10800
    >     api_key: dummyapitoken
    >     state: present
    >
    > - name: Delete the record
    >   community.general.gandi_livedns:
    >     domain: my.com
    >     type: CNAME
    >     record: mail
    >     api_key: dummyapitoken
    >     state: absent
    >
