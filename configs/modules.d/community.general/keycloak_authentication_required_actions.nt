name: keycloak_authentication_required_actions
fqcn: community.general.keycloak_authentication_required_actions
collection: community.general
short_description: Allows administration of Keycloak authentication required actions
description: This module can register, update and delete required actions. It also filters out any duplicate required actions by their alias. The first occurrence is preserved.
options:
    auth_client_id:
        type: str
        default: admin-cli
        description: OpenID Connect C(client_id) to authenticate to the API with.
    auth_client_secret:
        type: str
        description: Client Secret to use in conjunction with O(auth_client_id) (if required).
    auth_keycloak_url:
        type: str
        required: true
        aliases:
            - url
        description: URL to the Keycloak instance.
    auth_password:
        type: str
        aliases:
            - password
        description: Password to authenticate for API access with.
    auth_realm:
        type: str
        description: Keycloak realm name to authenticate to for API access.
    auth_username:
        type: str
        aliases:
            - username
        description: Username to authenticate for API access with.
    connection_timeout:
        type: int
        default: 10
        description: Controls the HTTP connections timeout period (in seconds) to Keycloak API.
    http_agent:
        type: str
        default: Ansible
        description: Configures the HTTP User-Agent header.
    realm:
        type: str
        required: true
        description: The name of the realm in which are the authentication required actions.
    required_actions:
        type: list
        description: Authentication required action.
    state:
        type: str
        required: true
        choices:
            - absent
            - present
        description: Control if the realm authentication required actions are going to be registered/updated (V(present)) or deleted (V(absent)).
    token:
        type: str
        description: Authentication token for Keycloak API.
    validate_certs:
        type: bool
        default: true
        description: Verify TLS certificates (do not disable this in production).
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Register a new required action.
    >   community.general.keycloak_authentication_required_actions:
    >     auth_client_id: "admin-cli"
    >     auth_keycloak_url: "http://localhost:8080"
    >     auth_password: "password"
    >     auth_realm: "master"
    >     auth_username: "admin"
    >     realm: "master"
    >     required_action:
    >       - alias: "TERMS_AND_CONDITIONS"
    >         name: "Terms and conditions"
    >         providerId: "TERMS_AND_CONDITIONS"
    >         enabled: true
    >     state: "present"
    >
    > - name: Update the newly registered required action.
    >   community.general.keycloak_authentication_required_actions:
    >     auth_client_id: "admin-cli"
    >     auth_keycloak_url: "http://localhost:8080"
    >     auth_password: "password"
    >     auth_realm: "master"
    >     auth_username: "admin"
    >     realm: "master"
    >     required_action:
    >       - alias: "TERMS_AND_CONDITIONS"
    >         enabled: false
    >     state: "present"
    >
    > - name: Delete the updated registered required action.
    >   community.general.keycloak_authentication_required_actions:
    >     auth_client_id: "admin-cli"
    >     auth_keycloak_url: "http://localhost:8080"
    >     auth_password: "password"
    >     auth_realm: "master"
    >     auth_username: "admin"
    >     realm: "master"
    >     required_action:
    >       - alias: "TERMS_AND_CONDITIONS"
    >     state: "absent"
    >
