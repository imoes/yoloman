name: xattr
fqcn: community.general.xattr
collection: community.general
short_description: Manage user defined extended attributes
description: Manages filesystem user defined extended attributes. Requires that extended attributes are enabled on the target filesystem and that the setfattr/getfattr utilities are present.
options:
    follow:
        type: bool
        default: true
        description: If V(true), dereferences symlinks and sets/gets attributes on symlink target, otherwise acts on symlink itself.
    key:
        type: str
        description: The name of a specific Extended attribute key to set/retrieve.
    namespace:
        type: str
        default: user
        description: Namespace of the named name/key.
    path:
        type: path
        required: true
        aliases:
            - name
        description: The full path of the file/object to get the facts of.
    state:
        type: str
        default: read
        choices:
            - absent
            - all
            - keys
            - present
            - read
        description: defines which state you want to do. V(read) retrieves the current value for a O(key) (default) V(present) sets O(path) to O(value), default if value is set V(all) dumps all data V(keys) retrieves all keys V(absent) deletes the key
    value:
        type: str
        description: The value to set the named name/key to, it automatically sets the O(state) to V(present).
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Obtain the extended attributes  of /etc/foo.conf
    >   community.general.xattr:
    >     path: /etc/foo.conf
    >
    > - name: Set the key 'user.foo' to value 'bar'
    >   community.general.xattr:
    >     path: /etc/foo.conf
    >     key: foo
    >     value: bar
    >
    > - name: Set the key 'trusted.glusterfs.volume-id' to value '0x817b94343f164f199e5b573b4ea1f914'
    >   community.general.xattr:
    >     path: /mnt/bricks/brick1
    >     namespace: trusted
    >     key: glusterfs.volume-id
    >     value: "0x817b94343f164f199e5b573b4ea1f914"
    >
    > - name: Remove the key 'user.foo'
    >   community.general.xattr:
    >     path: /etc/foo.conf
    >     key: foo
    >     state: absent
    >
    > - name: Remove the key 'trusted.glusterfs.volume-id'
    >   community.general.xattr:
    >     path: /mnt/bricks/brick1
    >     namespace: trusted
    >     key: glusterfs.volume-id
    >     state: absent
    >
