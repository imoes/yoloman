name: aix_lvol
fqcn: community.general.aix_lvol
collection: community.general
short_description: Configure AIX LVM logical volumes
description: This module creates, removes or resizes AIX logical volumes. Inspired by lvol module.
options:
    copies:
        type: int
        default: 1
        description: The number of copies of the logical volume. Maximum copies are 3.
    lv:
        type: str
        required: true
        description: The name of the logical volume.
    lv_type:
        type: str
        default: jfs2
        description: The type of the logical volume.
    opts:
        type: str
        default:
        description: Free-form options to be passed to the mklv command.
    policy:
        type: str
        default: maximum
        choices:
            - maximum
            - minimum
        description: Sets the interphysical volume allocation policy. V(maximum) allocates logical partitions across the maximum number of physical volumes. V(minimum) allocates logical partitions across the minimum number of physical volumes.
    pvs:
        type: list
        default:
            []
        description: A list of physical volumes, for example V(hdisk1,hdisk2).
    size:
        type: str
        description: The size of the logical volume with one of the [MGT] units.
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: Control if the logical volume exists. If V(present) and the volume does not already exist then the O(size) option is required.
    vg:
        type: str
        required: true
        description: The volume group this logical volume is part of.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create a logical volume of 512M
    >   community.general.aix_lvol:
    >     vg: testvg
    >     lv: testlv
    >     size: 512M
    >
    > - name: Create a logical volume of 512M with disks hdisk1 and hdisk2
    >   community.general.aix_lvol:
    >     vg: testvg
    >     lv: test2lv
    >     size: 512M
    >     pvs: [ hdisk1, hdisk2 ]
    >
    > - name: Create a logical volume of 512M mirrored
    >   community.general.aix_lvol:
    >     vg: testvg
    >     lv: test3lv
    >     size: 512M
    >     copies: 2
    >
    > - name: Create a logical volume of 1G with a minimum placement policy
    >   community.general.aix_lvol:
    >     vg: rootvg
    >     lv: test4lv
    >     size: 1G
    >     policy: minimum
    >
    > - name: Create a logical volume with special options like mirror pool
    >   community.general.aix_lvol:
    >     vg: testvg
    >     lv: testlv
    >     size: 512M
    >     opts: -p copy1=poolA -p copy2=poolB
    >
    > - name: Extend the logical volume to 1200M
    >   community.general.aix_lvol:
    >     vg: testvg
    >     lv: test4lv
    >     size: 1200M
    >
    > - name: Remove the logical volume
    >   community.general.aix_lvol:
    >     vg: testvg
    >     lv: testlv
    >     state: absent
    >
