name: gitlab_merge_request
fqcn: community.general.gitlab_merge_request
collection: community.general
short_description: Create, update, or delete GitLab merge requests
description: Creates a merge request if it does not exist. When a single merge request does exist, it will be updated if the provided parameters are different. When a single merge request does exist and O(state=absent), the merge request will be deleted. When multiple merge requests are detected, the task fails. Existing merge requests are matched based on O(title), O(source_branch), O(target_branch), and O(state_filter) filters.
options:
    api_job_token:
        type: str
        description: GitLab CI job token for logging in.
    api_oauth_token:
        type: str
        description: GitLab OAuth token for logging in.
    api_password:
        type: str
        description: The password to use for authentication against the API.
    api_token:
        type: str
        description: GitLab access token with API permissions.
    api_url:
        type: str
        description: The resolvable endpoint for the API.
    api_username:
        type: str
        description: The username to use for authentication against the API.
    assignee_ids:
        type: str
        description: Comma separated list of assignees usernames omitting V(@) character. Set to empty string to unassign all assignees.
    ca_path:
        type: str
        description: The CA certificates bundle to use to verify GitLab server certificate.
    description:
        type: str
        description: A description for the merge request. Gets overridden by a content of file specified at O(description_path), if found.
    description_path:
        type: path
        description: A path of file containing merge request's description. Accepts MarkDown formatted files.
    labels:
        type: str
        default:
        description: Comma separated list of label names.
    project:
        type: str
        required: true
        description: The path or name of the project.
    remove_source_branch:
        type: bool
        default: false
        description: Flag indicating if a merge request should remove the source branch when merging.
    reviewer_ids:
        type: str
        description: Comma separated list of reviewers usernames omitting V(@) character. Set to empty string to unassign all reviewers.
    source_branch:
        type: str
        required: true
        description: Merge request's source branch. Ignored while updating existing merge request.
    state:
        type: str
        default: present
        choices:
            - present
            - absent
        description: Create or delete merge request.
    state_filter:
        type: str
        default: opened
        choices:
            - opened
            - closed
            - locked
            - merged
        description: Filter specifying state of merge requests while searching.
    target_branch:
        type: str
        required: true
        description: Merge request's target branch.
    title:
        type: str
        required: true
        description: A title for the merge request.
    validate_certs:
        type: bool
        default: true
        description: Whether or not to validate SSL certs when supplying a HTTPS endpoint.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create Merge Request from branch1 to branch2
    >   community.general.gitlab_merge_request:
    >     api_url: https://gitlab.com
    >     api_token: secret_access_token
    >     project: "group1/project1"
    >     source_branch: branch1
    >     target_branch: branch2
    >     title: "Ansible demo MR"
    >     description: "Demo MR description"
    >     labels: "Ansible,Demo"
    >     state_filter: "opened"
    >     remove_source_branch: True
    >     state: present
    >
    > - name: Delete Merge Request from branch1 to branch2
    >   community.general.gitlab_merge_request:
    >     api_url: https://gitlab.com
    >     api_token: secret_access_token
    >     project: "group1/project1"
    >     source_branch: branch1
    >     target_branch: branch2
    >     title: "Ansible demo MR"
    >     state_filter: "opened"
    >     state: absent
    >
