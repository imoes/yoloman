name: ocapi_info
fqcn: community.general.ocapi_info
collection: community.general
short_description: Manages Out-Of-Band controllers using Open Composable API (OCAPI)
description: Builds OCAPI URIs locally and sends them to remote OOB controllers to get information back.
options:
    baseuri:
        type: str
        required: true
        description: Base URI of OOB controller.
    category:
        type: str
        required: true
        description: Category to execute on OOB controller.
    command:
        type: str
        required: true
        description: Command to execute on OOB controller.
    job_name:
        type: str
        description: Name of job for fetching status.
    password:
        type: str
        required: true
        description: Password for authenticating to OOB controller.
    proxy_slot_number:
        type: int
        description: For proxied inband requests, the slot number of the IOM.  Only applies if O(baseuri) is a proxy server.
    timeout:
        type: int
        default: 10
        description: Timeout in seconds for URL requests to OOB controller.
    username:
        type: str
        required: true
        description: Username for authenticating to OOB controller.
writes: false
runtime: starlark
source: translated
examples:
    >
    >   - name: Get job status
    >     community.general.ocapi_info:
    >       category: Status
    >       command: JobStatus
    >       baseuri: "http://iom1.wdc.com"
    >       jobName: FirmwareUpdate
    >       username: "{{ username }}"
    >       password: "{{ password }}"
    >
