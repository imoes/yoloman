name: utm_proxy_location
fqcn: community.general.utm_proxy_location
collection: community.general
short_description: Create, update or destroy reverse_proxy location entry in Sophos UTM
description: Create, update or destroy a reverse_proxy location entry in SOPHOS UTM. This module needs to have the REST Ability of the UTM to be activated.
options:
    access_control:
        type: str
        default: 0
        choices:
            - 0
            - 1
        description: whether to activate the access control for the location
    allowed_networks:
        type: list
        default:
            - REF_NetworkAny
        description: A list of allowed networks
    auth_profile:
        type: str
        default:
        description: The reference name of the auth profile
    backend:
        type: list
        default:
            []
        description: A list of backends that are connected with this location declaration
    be_path:
        type: str
        default:
        description: The path of the backend
    comment:
        type: str
        default:
        description: The optional comment string
    denied_networks:
        type: list
        default:
            []
        description: A list of denied network references
    headers:
        type: dict
        default:
            {}
        description: A dictionary of additional headers to be sent to POST and PUT requests. Is needed for some modules.
    hot_standby:
        type: bool
        default: false
        description: Activate hot standby mode
    name:
        type: str
        required: true
        description: The name of the object. Will be used to identify the entry
    path:
        type: str
        default: /
        description: The path of the location
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: The desired state of the object. V(present) will create or update an object. V(absent) will delete an object if it was present.
    status:
        type: bool
        default: true
        description: Whether the location is active or not
    stickysession_id:
        type: str
        default: ROUTEID
        description: The stickysession id
    stickysession_status:
        type: bool
        default: false
        description: Enable the stickysession
    utm_host:
        type: str
        required: true
        description: The REST Endpoint of the Sophos UTM.
    utm_port:
        type: int
        default: 4444
        description: The port of the REST interface.
    utm_protocol:
        type: str
        default: https
        choices:
            - http
            - https
        description: The protocol of the REST Endpoint.
    utm_token:
        type: str
        required: true
        description: The token used to identify at the REST-API. See U(https://www.sophos.com/en-us/medialibrary/PDFs/documentation/UTMonAWS/Sophos-UTM-RESTful-API.pdf?la=en), Chapter 2.4.2.
    validate_certs:
        type: bool
        default: true
        description: Whether the REST interface's ssl certificate should be verified or not.
    websocket_passthrough:
        type: bool
        default: false
        description: Enable the websocket passthrough
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create UTM proxy_location
    >   utm_proxy_backend:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestLocationEntry
    >     backend: REF_OBJECT_STRING
    >     state: present
    >
    > - name: Remove UTM proxy_location
    >   utm_proxy_backend:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestLocationEntry
    >     state: absent
    >
