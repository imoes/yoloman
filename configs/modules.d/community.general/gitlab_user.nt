name: gitlab_user
fqcn: community.general.gitlab_user
collection: community.general
short_description: Creates/updates/deletes/blocks/unblocks GitLab Users
description: When the user does not exist in GitLab, it will be created. When the user exists and state=absent, the user will be deleted. When the user exists and state=blocked, the user will be blocked. When changes are made to user, the user will be updated.
options:
    access_level:
        type: str
        default: guest
        choices:
            - guest
            - reporter
            - developer
            - master
            - maintainer
            - owner
        description: The access level to the group. One of the following can be used. guest reporter developer master (alias for maintainer) maintainer owner
    api_job_token:
        type: str
        description: GitLab CI job token for logging in.
    api_oauth_token:
        type: str
        description: GitLab OAuth token for logging in.
    api_password:
        type: str
        description: The password to use for authentication against the API.
    api_token:
        type: str
        description: GitLab access token with API permissions.
    api_url:
        type: str
        description: The resolvable endpoint for the API.
    api_username:
        type: str
        description: The username to use for authentication against the API.
    ca_path:
        type: str
        description: The CA certificates bundle to use to verify GitLab server certificate.
    confirm:
        type: bool
        default: true
        description: Require confirmation.
    email:
        type: str
        description: The email that belongs to the user. Required only if O(state=present).
    external:
        type: bool
        default: false
        description: Define external parameter for this user.
    group:
        type: str
        description: Id or Full path of parent group in the form of group/name. Add user as a member to this group.
    identities:
        type: list
        description: List of identities to be added/updated for this user. To remove all other identities from this user, set O(overwrite_identities=true).
    isadmin:
        type: bool
        default: false
        description: Grant admin privileges to the user.
    name:
        type: str
        description: Name of the user you want to create. Required only if O(state=present).
    overwrite_identities:
        type: bool
        default: false
        description: Overwrite identities with identities added in this module. This means that all identities that the user has and that are not listed in O(identities) are removed from the user. This is only done if a list is provided for O(identities). To remove all identities, provide an empty list.
    password:
        type: str
        description: The password of the user. GitLab server enforces minimum password length to 8, set this value with 8 or more characters.
    reset_password:
        type: bool
        default: false
        description: Whether the user can change its password or not.
    sshkey_expires_at:
        type: str
        description: The expiration date of the SSH public key in ISO 8601 format C(YYYY-MM-DDTHH:MM:SSZ). This is only used when adding new SSH public keys.
    sshkey_file:
        type: str
        description: The SSH public key itself.
    sshkey_name:
        type: str
        description: The name of the SSH public key.
    state:
        type: str
        default: present
        choices:
            - present
            - absent
            - blocked
            - unblocked
        description: Create, delete or block a user.
    username:
        type: str
        required: true
        description: The username of the user.
    validate_certs:
        type: bool
        default: true
        description: Whether or not to validate SSL certs when supplying a HTTPS endpoint.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: "Delete GitLab User"
    >   community.general.gitlab_user:
    >     api_url: https://gitlab.example.com/
    >     api_token: "{{ access_token }}"
    >     username: myusername
    >     state: absent
    >
    > - name: "Create GitLab User"
    >   community.general.gitlab_user:
    >     api_url: https://gitlab.example.com/
    >     validate_certs: true
    >     api_username: dj-wasabi
    >     api_password: "MySecretPassword"
    >     name: My Name
    >     username: myusername
    >     password: mysecretpassword
    >     email: me@example.com
    >     sshkey_name: MySSH
    >     sshkey_file: ssh-rsa AAAAB3NzaC1yc...
    >     state: present
    >     group: super_group/mon_group
    >     access_level: owner
    >
    > - name: "Create GitLab User using external identity provider"
    >   community.general.gitlab_user:
    >     api_url: https://gitlab.example.com/
    >     validate_certs: true
    >     api_token: "{{ access_token }}"
    >     name: My Name
    >     username: myusername
    >     password: mysecretpassword
    >     email: me@example.com
    >     identities:
    >     - provider: Keycloak
    >       extern_uid: f278f95c-12c7-4d51-996f-758cc2eb11bc
    >     state: present
    >     group: super_group/mon_group
    >     access_level: owner
    >
    > - name: "Block GitLab User"
    >   community.general.gitlab_user:
    >     api_url: https://gitlab.example.com/
    >     api_token: "{{ access_token }}"
    >     username: myusername
    >     state: blocked
    >
    > - name: "Unblock GitLab User"
    >   community.general.gitlab_user:
    >     api_url: https://gitlab.example.com/
    >     api_token: "{{ access_token }}"
    >     username: myusername
    >     state: unblocked
    >
