name: logentries
fqcn: community.general.logentries
collection: community.general
short_description: Module for tracking logs via logentries.com
description: Sends logs to LogEntries in realtime
options:
    logtype:
        type: str
        aliases:
            - type
        description: type of the log
    name:
        type: str
        description: name of the log
    path:
        type: str
        required: true
        description: path to a log file
    state:
        type: str
        default: present
        choices:
            - present
            - absent
            - followed
            - unfollowed
        description: following state of the log
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Track nginx logs
    >   community.general.logentries:
    >     path: /var/log/nginx/access.log
    >     state: present
    >     name: nginx-access-log
    >
    > - name: Stop tracking nginx logs
    >   community.general.logentries:
    >     path: /var/log/nginx/error.log
    >     state: absent
    >
