name: say
fqcn: community.general.say
collection: community.general
short_description: Makes a computer to speak
description: makes a computer speak! Amuse your friends, annoy your coworkers!
options:
    msg:
        type: str
        required: true
        description: What to say.
    voice:
        type: str
        description: What voice to use.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Makes a computer to speak
    >   community.general.say:
    >     msg: '{{ inventory_hostname }} is all done'
    >     voice: Zarvox
    >   delegate_to: localhost
    >
