name: utm_proxy_exception
fqcn: community.general.utm_proxy_exception
collection: community.general
short_description: Create, update or destroy reverse_proxy exception entry in Sophos UTM
description: Create, update or destroy a reverse_proxy exception entry in SOPHOS UTM. This module needs to have the REST Ability of the UTM to be activated.
options:
    headers:
        type: dict
        default:
            {}
        description: A dictionary of additional headers to be sent to POST and PUT requests. Is needed for some modules.
    name:
        type: str
        required: true
        description: The name of the object. Will be used to identify the entry
    op:
        type: str
        default: AND
        choices:
            - AND
            - OR
        description: The operand to be used with the entries of the path parameter
    path:
        type: list
        default:
            []
        description: The paths the exception in the reverse proxy is defined for
    skip_custom_threats_filters:
        type: list
        default:
            []
        description: A list of threats to be skipped
    skip_threats_filter_categories:
        type: list
        default:
            []
        description: Define which categories of threats are skipped
    skipav:
        type: bool
        default: false
        description: Skip the Antivirus Scanning
    skipbadclients:
        type: bool
        default: false
        description: Block clients with bad reputation
    skipcookie:
        type: bool
        default: false
        description: Skip the Cookie Signing check
    skipform:
        type: bool
        default: false
        description: Enable form hardening
    skipform_missingtoken:
        type: bool
        default: false
        description: Enable form hardening with missing tokens
    skiphtmlrewrite:
        type: bool
        default: false
        description: Protection against SQL
    skiptft:
        type: bool
        default: false
        description: Enable true file type control
    skipurl:
        type: bool
        default: false
        description: Enable static URL hardening
    source:
        type: list
        default:
            []
        description: Define which categories of threats are skipped
    state:
        type: str
        default: present
        choices:
            - absent
            - present
        description: The desired state of the object. V(present) will create or update an object. V(absent) will delete an object if it was present.
    status:
        type: bool
        default: true
        description: Status of the exception rule set
    utm_host:
        type: str
        required: true
        description: The REST Endpoint of the Sophos UTM.
    utm_port:
        type: int
        default: 4444
        description: The port of the REST interface.
    utm_protocol:
        type: str
        default: https
        choices:
            - http
            - https
        description: The protocol of the REST Endpoint.
    utm_token:
        type: str
        required: true
        description: The token used to identify at the REST-API. See U(https://www.sophos.com/en-us/medialibrary/PDFs/documentation/UTMonAWS/Sophos-UTM-RESTful-API.pdf?la=en), Chapter 2.4.2.
    validate_certs:
        type: bool
        default: true
        description: Whether the REST interface's ssl certificate should be verified or not.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create UTM proxy_exception
    >   community.general.utm_proxy_exception:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestExceptionEntry
    >     backend: REF_OBJECT_STRING
    >     state: present
    >
    > - name: Remove UTM proxy_exception
    >   community.general.utm_proxy_exception:
    >     utm_host: sophos.host.name
    >     utm_token: abcdefghijklmno1234
    >     name: TestExceptionEntry
    >     state: absent
    >
