name: sendgrid
fqcn: community.general.sendgrid
collection: community.general
short_description: Sends an email with the SendGrid API
description: Sends an email with a SendGrid account through their API, not through the SMTP service.
options:
    api_key:
        type: str
        description: Sendgrid API key to use instead of username/password.
    attachments:
        type: list
        description: A list of relative or explicit paths of files you want to attach (7MB limit as per SendGrid docs).
    bcc:
        type: list
        description: A list of email addresses to bcc.
    body:
        type: str
        required: true
        description: The e-mail body content.
    cc:
        type: list
        description: A list of email addresses to cc.
    from_address:
        type: str
        required: true
        description: The address in the "from" field for the email.
    from_name:
        type: str
        description: The name you want to appear in the from field, i.e 'John Doe'.
    headers:
        type: dict
        description: A dict to pass on as headers.
    html_body:
        type: bool
        default: false
        description: Whether the body is html content that should be rendered.
    password:
        type: str
        description: Password that corresponds to the username. It is only required if O(api_key) is not supplied.
    subject:
        type: str
        required: true
        description: The desired subject for the email.
    to_addresses:
        type: list
        required: true
        description: A list with one or more recipient email addresses.
    username:
        type: str
        description: Username for logging into the SendGrid account. It is only required if O(api_key) is not supplied.
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Send an email to a single recipient that the deployment was successful
    >   community.general.sendgrid:
    >     username: "{{ sendgrid_username }}"
    >     password: "{{ sendgrid_password }}"
    >     from_address: "ansible@mycompany.com"
    >     to_addresses:
    >       - "ops@mycompany.com"
    >     subject: "Deployment success."
    >     body: "The most recent Ansible deployment was successful."
    >   delegate_to: localhost
    >
    > - name: Send an email to more than one recipient that the build failed
    >   community.general.sendgrid:
    >       username: "{{ sendgrid_username }}"
    >       password: "{{ sendgrid_password }}"
    >       from_address: "build@mycompany.com"
    >       to_addresses:
    >         - "ops@mycompany.com"
    >         - "devteam@mycompany.com"
    >       subject: "Build failure!."
    >       body: "Unable to pull source repository from Git server."
    >   delegate_to: localhost
    >
