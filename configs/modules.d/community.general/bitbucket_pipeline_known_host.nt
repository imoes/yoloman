name: bitbucket_pipeline_known_host
fqcn: community.general.bitbucket_pipeline_known_host
collection: community.general
short_description: Manages Bitbucket pipeline known hosts
description: Manages Bitbucket pipeline known hosts under the "SSH Keys" menu. The host fingerprint will be retrieved automatically, but in case of an error, one can use O(key) field to specify it manually.
options:
    client_id:
        type: str
        description: The OAuth consumer key. If not set the environment variable E(BITBUCKET_CLIENT_ID) will be used.
    client_secret:
        type: str
        description: The OAuth consumer secret. If not set the environment variable E(BITBUCKET_CLIENT_SECRET) will be used.
    key:
        type: str
        description: The public key.
    name:
        type: str
        required: true
        description: The FQDN of the known host.
    password:
        type: str
        description: The App password. If not set the environment variable E(BITBUCKET_PASSWORD) will be used.
    repository:
        type: str
        required: true
        description: The repository name.
    state:
        type: str
        required: true
        choices:
            - absent
            - present
        description: Indicates desired state of the record.
    user:
        type: str
        aliases:
            - username
        description: The username. If not set the environment variable E(BITBUCKET_USERNAME) will be used. O(ignore:username) is an alias of O(user) since community.general 6.0.0. It was an alias of O(workspace) before.
    workspace:
        type: str
        required: true
        description: The repository owner. B(Note:) O(ignore:username) used to be an alias of this option. Since community.general 6.0.0 it is an alias of O(user).
writes: true
runtime: starlark
source: translated
examples:
    >
    > - name: Create known hosts from the list
    >   community.general.bitbucket_pipeline_known_host:
    >     repository: 'bitbucket-repo'
    >     workspace: bitbucket_workspace
    >     name: '{{ item }}'
    >     state: present
    >   with_items:
    >     - bitbucket.org
    >     - example.com
    >
    > - name: Remove known host
    >   community.general.bitbucket_pipeline_known_host:
    >     repository: bitbucket-repo
    >     workspace: bitbucket_workspace
    >     name: bitbucket.org
    >     state: absent
    >
    > - name: Specify public key file
    >   community.general.bitbucket_pipeline_known_host:
    >     repository: bitbucket-repo
    >     workspace: bitbucket_workspace
    >     name: bitbucket.org
    >     key: '{{lookup("file", "bitbucket.pub") }}'
    >     state: absent
    >
