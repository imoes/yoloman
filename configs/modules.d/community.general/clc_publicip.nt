name: clc_publicip
fqcn: community.general.clc_publicip
collection: community.general
short_description: Add and Delete public ips on servers in CenturyLink Cloud
description: An Ansible module to add or delete public ip addresses on an existing server or servers in CenturyLink Cloud.
options:
    ports:
        type: list
        description: A list of ports to expose. This is required when state is 'present'
    protocol:
        type: str
        default: TCP
        choices:
            - TCP
            - UDP
            - ICMP
        description: The protocol that the public IP will listen for.
    server_ids:
        type: list
        required: true
        description: A list of servers to create public ips on.
    state:
        type: str
        default: present
        choices:
            - present
            - absent
        description: Determine whether to create or delete public IPs. If present module will not create a second public ip if one already exists.
    wait:
        type: bool
        default: true
        description: Whether to wait for the tasks to finish before returning.
writes: true
runtime: starlark
source: translated
examples:
    >
    > # Note - You must set the CLC_V2_API_USERNAME And CLC_V2_API_PASSWD Environment variables before running these examples
    >
    > - name: Add Public IP to Server
    >   hosts: localhost
    >   gather_facts: false
    >   connection: local
    >   tasks:
    >     - name: Create Public IP For Servers
    >       community.general.clc_publicip:
    >         protocol: TCP
    >         ports:
    >           - 80
    >         server_ids:
    >           - UC1TEST-SVR01
    >           - UC1TEST-SVR02
    >         state: present
    >       register: clc
    >
    >     - name: Debug
    >       ansible.builtin.debug:
    >         var: clc
    >
    > - name: Delete Public IP from Server
    >   hosts: localhost
    >   gather_facts: false
    >   connection: local
    >   tasks:
    >     - name: Create Public IP For Servers
    >       community.general.clc_publicip:
    >         server_ids:
    >           - UC1TEST-SVR01
    >           - UC1TEST-SVR02
    >         state: absent
    >       register: clc
    >
    >     - name: Debug
    >       ansible.builtin.debug:
    >         var: clc
    >
