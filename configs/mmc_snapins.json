          "actions": [
            {
              "id": "disable",
              "title": "Disable",
              "icon": "block",
              "tool": "scheduled_task",
              "params": {
                "name": "{row.full_name}",
                "enabled": false
              },
              "confirm": true,
              "hide_when": {
                "field": "state",
                "equals": "disabled"
              }
            },
            {
              "id": "enable",
              "title": "Enable",
              "icon": "check_circle",
              "tool": "scheduled_task",
              "params": {
                "name": "{row.full_name}",
                "enabled": true
              },
              "confirm": true,
              "hide_when": {
                "field": "state",
                "equals": "ready"
