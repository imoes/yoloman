/bin/
# generated translation templates (scripts/dump_module_sources.py), ~15MB
/configs/module_sources/
*.db
*.db-journal
/dist/
.playwright-mcp/
/agentic-mcpd
/packaging/*.rpm
/packaging/*.deb
/packaging/agentic-mcpd

# Local agent .deb staged for the Bossman container's SSH-deploy (Block N-enroll)
/deploy-artifacts/

# The grounded package universe and its batch progress markers are TRACKED, not ignored:
# package_universe_real.json is the EVIDENCE curate_catalog.py reads to tell a real RedHat package
# name from an invented one, and the markers are the same kind of file as the already-tracked
# .qualify_*_state.json. Two treatments for one kind of file was the inconsistency; this is the fix.
.sonnet-failmop.done

# Local secrets for docker-compose interpolation (OpenRouter token, etc.)
.env

# Stray empty dirs docker creates if compose is ever run from bossman-ui/ (wrong PWD)
/bossman-ui/configs/

# The per-installation layer: LLM endpoint, proxy, hosts, addresses. It was TRACKED, which is how this
# repository came to carry 190 references to one company's internal infrastructure. The committed file is
# docker-compose.override.yml.example; this one is yours.
/docker-compose.override.yml

# The batch and mining tooling: qualify, translate, mine, and the systemd units that run them. Local
# OPERATING equipment, not the product — it is where the LLM endpoints, the proxy and the model names live,
# which is how 35 files came to carry one installation's infrastructure. Kept on disk, out of the repository.
/bossman/scripts/

# .NET build output (windows-agent). A `git add -A` on that tree once committed 2958 artifacts including
# two self-contained 100-150 MB single-file exes — twice. The publish output is a build product; it belongs
# in a release, never in history.
windows-agent/**/bin/
windows-agent/**/obj/

# Generated by windows-agent/packaging/build-msi.py from the publish output. Regenerated on every build, and
# the point of generating it is that it cannot drift from the build — a committed copy would.
windows-agent/packaging/payload.generated.wxs

# A 0-byte artefact that a root-run build left in a root-owned directory and a broad `git add`
# swept into c2cca269. Nothing in this repository references bossman/deploy/agent.deb — and because
# the directory is root-owned, its presence in the index made `git checkout` of another branch fail
# with a permission error that looked like a git problem. Untracked and ignored: the deb is built,
# not committed.
bossman/deploy/agent.deb
