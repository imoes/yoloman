/configs/module_sources/
*.db
*.db-journal
/dist/
.playwright-mcp/
/agentic-mcpd
/packaging/*.rpm
/packaging/*.deb
/packaging/agentic-mcpd

# Local agent .deb staged for the Bossman container's SSH-deploy (Block N-enroll)
/deploy-artifacts/

# The grounded package universe and its batch progress markers are TRACKED, not ignored:
# package_universe_real.json is the EVIDENCE curate_catalog.py reads to tell a real RedHat package
# name from an invented one, and the markers are the same kind of file as the already-tracked
# .qualify_*_state.json. Two treatments for one kind of file was the inconsistency; this is the fix.
.sonnet-failmop.done

# Local secrets for docker-compose interpolation (OpenRouter token, etc.)
.env

# Stray empty dirs docker creates if compose is ever run from bossman-ui/ (wrong PWD)
/bossman-ui/configs/
