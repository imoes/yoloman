# YOLO-MANager Bossman configuration. Read by systemd as an EnvironmentFile, so:
#   KEY=value      no export, no shell quoting, no variable expansion.
#
# EVERY value below is also a Settings field (bossman/bossman/config.py); the prefix is BOSSMAN_.
# Change what you need and `systemctl restart yoloman-bossman`.

# Where to listen. 127.0.0.1 by default ON PURPOSE: this console manages your fleet, and a fresh install
# with a seeded admin password should not be reachable from the network before you have changed it.
# Put it behind a TLS reverse proxy, or set 0.0.0.0 once you have.
BOSSMAN_BIND=127.0.0.1
BOSSMAN_PORT=8000

# The database. Postgres with the timescaledb AND pgvector extensions is REQUIRED and is not part of this
# package: the schema uses hypertables plus continuous aggregates for the metric store and vectors for
# search. The migration enables both extensions; it cannot install them. See the README's Quick start.
BOSSMAN_DATABASE_URL=postgresql+asyncpg://bossman:CHANGE_ME@127.0.0.1:5432/bossman

# Signing key for the API's session tokens. The postinst generates one on first install; anything you set
# here wins. Changing it invalidates every logged-in session, which is the point after a leak.
# BOSSMAN_JWT_SECRET=

# State this process writes: its own mTLS client keypair (used to reach the agents), the vault key that
# encrypts stored credentials, and the runbook/plan directory. Under /var/lib because they must survive an
# upgrade — LOSING the vault key makes every stored ciphertext undecryptable.
BOSSMAN_CLIENT_KEY_PATH=/var/lib/yoloman-bossman/tls/bossman-client.key
BOSSMAN_CLIENT_CERT_PATH=/var/lib/yoloman-bossman/tls/bossman-client.crt
BOSSMAN_VAULT_KEY_PATH=/var/lib/yoloman-bossman/tls/vault.key
BOSSMAN_PLANS_DIR=/var/lib/yoloman-bossman/plans

# The web console, served by this process (the Docker deployment lets nginx do it instead).
BOSSMAN_UI_DIR=/opt/yoloman-bossman/ui

# The config catalog: codecs, per-directive values, templates, and the recorded projections the field
# editor serves. Shipped with the package and refreshable in place.
BOSSMAN_CONFIG_CODECS_PATH=/opt/yoloman-bossman/configs/config_codecs.json
BOSSMAN_CONFIG_DIRECTIVES_PATH=/opt/yoloman-bossman/configs/config_directives.json
BOSSMAN_CONFIG_TEMPLATES_DIR=/opt/yoloman-bossman/configs/config_templates
BOSSMAN_CONFIG_GENERATED_PATH=/opt/yoloman-bossman/configs/config_generated.json
BOSSMAN_CONFIG_PATH_VERDICTS_PATH=/opt/yoloman-bossman/configs/config_path_verdicts.json
BOSSMAN_CODEC_PROBE_VERDICTS_PATH=/opt/yoloman-bossman/configs/codec_probe_verdicts.json
