#%PAM-1.0
# PAM service for agentic-mcpd's standalone-console login (/api/v1/auth/login).
# Without this file PAM uses /etc/pam.d/other, which denies by default, so
# every login fails. pam_unix validates the username/password against the
# local account database (/etc/shadow) — the daemon runs as root, so it can
# read shadow. pam_unix ships on both Debian and RHEL, keeping this portable.
auth     required   pam_unix.so
account  required   pam_unix.so
