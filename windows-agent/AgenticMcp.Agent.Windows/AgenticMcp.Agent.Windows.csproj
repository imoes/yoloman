<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows-ONLY half: WMI lives here and nowhere else, so everything in Core stays buildable and
       testable on the dev host. `net10.0-windows` compiles on Linux (the SDK ships the reference
       assemblies); it just cannot RUN a WMI query anywhere but on Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgenticMcp.Agent.Core\AgenticMcp.Agent.Core.csproj" />
    <ProjectReference Include="..\AgenticMcp.Agent.Modules\AgenticMcp.Agent.Modules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Management.Infrastructure is the supported CIM API over the same WMI repository
         Get-CimInstance uses. NOT System.Management (the legacy WMI .NET wrapper) and NOT wmic.exe, which
         has been removed from current Windows. -->
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <!-- The service control manager. Not in the base library for net*-windows since .NET Core; the package
         is the supported way, and it is Windows-only by construction — which is why these modules live here
         and not in AgenticMcp.Agent.Modules. -->
    <!-- 9.0.10, not 9.0.0: the PowerShell SDK pulls it at >= 9.0.10 through the Modules project, and a
         DOWNGRADE is an error here rather than a warning (TreatWarningsAsErrors) — which is how it should be.
         Two references to one package at two versions is the identity rule in a package graph. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.10" />
  </ItemGroup>

</Project>
