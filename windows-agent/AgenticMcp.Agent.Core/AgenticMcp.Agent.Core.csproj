<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform ON PURPOSE. Everything that has to agree with Bossman lives here, so it can be built,
       tested and RUN against the live server on the Linux dev host — before a Windows VM exists. The
       Windows-only half (WMI) is AgenticMcp.Agent.Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
