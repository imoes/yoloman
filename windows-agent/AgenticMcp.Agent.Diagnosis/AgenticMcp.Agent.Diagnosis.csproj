<Project Sdk="Microsoft.NET.Sdk">

  <!-- The explainable diagnosis (docs/diagnosis.md): the contract, the rule catalogue, the builder that refuses a
       forbidden finding and the rules over a collected snapshot. Cross-platform ON PURPOSE (net10.0, no Win32), so
       the rules are tested on the Linux dev host against recorded snapshots; the Win32 collectors that fill a
       snapshot live in AgenticMcp.Agent.Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- A copy of configs/diagnosis_rules.json; DiagnosisContractTests keeps the two identical. -->
    <EmbeddedResource Include="rules.json" LogicalName="diagnosis_rules.json" />
  </ItemGroup>

</Project>
