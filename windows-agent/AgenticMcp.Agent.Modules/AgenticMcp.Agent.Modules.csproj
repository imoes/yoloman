<Project Sdk="Microsoft.NET.Sdk">

  <!-- The action plane. Cross-platform, because Microsoft.PowerShell.SDK is: PowerShell runs in-process on
       Linux too, so the `powershell` module is PROVABLE on this dev host and not only on the VM. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgenticMcp.Agent.Core\AgenticMcp.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.4" />
    <!-- PINNED OVER A TRANSITIVE CVE, not suppressed. Microsoft.PowerShell.SDK 7.5.4 pulls
         System.Security.Cryptography.Xml 9.0.10, which carries two HIGH-severity advisories
         (GHSA-mmjf-rqrv-855v, GHSA-w3x6-4m5h-cxqf). A direct reference wins over a transitive one, so this
         line replaces the vulnerable version instead of adding NoWarn to hide the report. Remove it when
         the SDK itself moves past the fixed version — and let the build tell you, since NU1903 is an error
         here, not a warning. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

</Project>
