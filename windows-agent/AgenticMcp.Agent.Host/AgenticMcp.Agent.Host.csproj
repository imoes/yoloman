<Project Sdk="Microsoft.NET.Sdk">

  <!-- The agent process. Cross-platform: it runs on the Linux dev host with the runtime collector, which is
       how milestone 1 was proven against the live Bossman before a Windows VM existed. On Windows it also
       loads AgenticMcp.Agent.Windows' WMI collector. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TWO targets: net10.0 so the agent builds and runs on this dev host (that is how the contract with
         Bossman was proven before a Windows VM existed), and net10.0-windows so the same process can load
         the WMI collector where WMI exists. One codebase, one behaviour, one extra collector. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The WINDOWS AGENT's own version, deliberately not the repo's VERSION file: this is a separate
         artefact with its own release cadence, and pretending it ships in lockstep with the Go agent would
         make the fleet's version column unable to answer "which build is on that host".
         0.2.0 = the build that runs as a service and keeps a result log.
         0.2.1 = an installer fetch that reads a CIDR entry in NO_PROXY (0.2.0 sent every fleet-internal
                 source URL through the corporate proxy, which answered 503), and an internal error that
                 carries its reason to the caller instead of only into the log.
         0.2.2 = install and uninstall arguments are separate (a recipe's /S was being appended to the
                 product's own UninstallString, which Windows refuses as invalid syntax).
         0.3.0 = service_diagnose — why a service does not start (the explainable diagnosis, docs/diagnosis.md).
         0.3.1 = its rules read the last start attempt from event 7000 (the status resets to 0) and 7041 as the
                 missing logon right — both measured on this host.
         0.3.2 = the account behind a service (SAM, LSA user rights) and its access to the image (AuthzAccessCheck).
         0.3.3 = the precedent: what changed before the failure (service key, image, 7040/7045, installs, updates).
         0.3.4 = a logon right granted since the failed start is no longer reported as the cause (LSA beats history).
         0.3.5 = windows_update_facts — pending updates, history, server, pending reboot (read-only).
         0.3.6 = windows_update — search, download, install (selection as in win_updates), verified by a new read.
         0.3.7 = Windows' own names for the HRESULTs an update run ends with (0x8024200D = WU_E_UH_NEEDANOTHERDOWNLOAD).
         0.3.8 = a start that hangs (start-pending past the SCM's timeout, no progress) is svc.timeout, not "starting".
         0.3.9 = the hang finding carries its precedent too (0.3.8 returned before the precedent was read).
         0.3.10 = windows_update state=removed: the rollback through wusa, verified by a fresh read.
         0.3.11 = an update only Windows Update lists as installed (the .NET rollup) is refused with the reason, not "not installed".
         0.3.12 = the rollback goes through DISM by the KB's package (wusa /quiet is deprecated on Server 2016+, it answered 87).
         0.3.13 = an umbrella update (the .NET rollup) is found through the KBs it bundles; installed per Windows Update is never "not installed".
         0.3.14 = Windows' own reason for a failed service logon (Security 4625 Status/SubStatus) as evidence — a wrong stored
                  password is provable; the wait chains of a pending start/stop (Wait Chain Traversal) — a cycle is svc.deadlock.
         0.3.15 = the 4625 status is read as Windows hands it over (signed — 0.3.14 parsed only unsigned and never matched).
         0.3.16 = where it crashed: the faulting function from public symbols (dbghelp + Microsoft symbol server) and the .NET
                  exception with its first managed frame; Application events filtered by provider.
         0.3.17 = the module version is compared by build+revision from the numeric version (the FileVersion string is stale).
         0.3.18 = another application's crash is no evidence of this service (40-92 evidences per diagnosis were mostly unrelated).
         0.3.19 = a hang whose threads block with no lock owner in a .NET process is named as WCT's blind spot (a managed wait);
                  .NET is detected by the dotnet-diagnostic pipe (a single-file app loads coreclr from memory, not as a module).
         0.3.21 = svc.blocked_by_policy: AppLocker 8004 / Code Integrity 3077 block of the image; WinVerifyTrust signature as evidence
                  (catalog-signed Windows files verified via the security catalog, not only an embedded signature).
         0.3.23 = native signature check with catalog support (SHA256 then SHA1), fixed hash size — catalog-signed OS files
                  are now recognised; Get-AuthenticodeSignature via the bridge threw in the synchronous collector.
         0.3.25 = an image with no embedded signature whose catalog could not be confirmed is reported honestly as such,
                  not as "not signed"; the signature clause in the policy-block finding is limited to clearly untrusted.
         0.3.26 = only a genuine "valid" from the catalog is claimed; any other catalog result is inconclusive, not untrusted.
         0.3.20 = the .NET detection fix above actually built in (0.3.19 shipped the module-list version, which finds nothing).
         ONE number: the SDK derives AssemblyVersion (what /healthz reports) from <Version>. A separate
         <AssemblyVersion> kept /healthz at 0.3.1 while the binary was 0.3.2 (measured 2026-10-17). -->
    <Version>0.3.30</Version>
    <RootNamespace>AgenticMcp.Agent.Host</RootNamespace>
    <!-- Self-contained: the target needs no runtime install. NOT single-file, and that is measured rather
         than preferred — the PowerShell SDK ships its module tree twice (runtimes/unix and runtimes/win) and
         the bundler fails on the duplicate with "It is forbidden to change Manifest state after it was
         written", leaving a truncated 28 MB exe that looks like a successful build. A folder publish is
         self-contained just the same, and the MSI (milestone 6) packages a folder anyway. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgenticMcp.Agent.Core\AgenticMcp.Agent.Core.csproj" />
    <ProjectReference Include="..\AgenticMcp.Agent.Modules\AgenticMcp.Agent.Modules.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\AgenticMcp.Agent.Windows\AgenticMcp.Agent.Windows.csproj" />
    <!-- Lets the same exe run under the Service Control Manager. Without it SCM starts the process, waits for
         a status it never gets, and fails with error 1053 ("the service did not respond in a timely
         fashion") — which reads like a hung agent rather than a missing four lines of hosting. Windows-only
         by construction: there is no SCM to talk to on the dev host. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>


  <!-- SHIP POWERSHELL'S OWN MODULES, which a RID-specific publish otherwise drops.
       Measured on the first real install: `dotnet publish -r win-x64` FLATTENS `runtimes/`, so
       runtimes/win/lib/net9.0/Modules — Utility, Management, Security, CimCmdlets, Host, Diagnostics — never
       reaches the target. The agent then starts, logs "listening", and its `powershell` module has the
       LANGUAGE and almost no cmdlets: Get-Date answers "not recognized". The non-RID build copies them, so
       this bites only the artefact that actually gets installed — which is why it took a real Windows host to
       find, twice in one day for two different reasons.
       A post-publish Copy, not a Content item: Content with a LinkBase does NOT survive a RID publish across
       a project reference (measured — the publish came out with no runtimes/ directory at all). 316 kB into
       the exact layout PowerShellModule.ResolveModuleDirectory already looks in, both platform trees, since
       the resolver picks the one for the running OS. -->
  <Target Name="CopyPowerShellModules" AfterTargets="Publish">
    <ItemGroup>
      <_PsWinModules Include="$(NuGetPackageRoot)microsoft.powershell.sdk/7.5.4/contentFiles/any/any/runtimes/win/lib/net9.0/Modules/**/*" />
      <_PsUnixModules Include="$(NuGetPackageRoot)microsoft.powershell.sdk/7.5.4/contentFiles/any/any/runtimes/unix/lib/net9.0/Modules/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PsWinModules)" DestinationFiles="@(_PsWinModules->'$(PublishDir)runtimes/win/lib/net9.0/Modules/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PsUnixModules)" DestinationFiles="@(_PsUnixModules->'$(PublishDir)runtimes/unix/lib/net9.0/Modules/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)runtimes/win/lib/net9.0/Modules/Microsoft.PowerShell.Utility/Microsoft.PowerShell.Utility.psd1')" Text="PowerShell's module tree did not reach the publish output. Shipping this artefact would produce an agent whose `powershell` module has no cmdlets — fail the build instead." />
  </Target>

</Project>
